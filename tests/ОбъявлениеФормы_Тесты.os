// Слой объявления форм: одно объявление питает отрисовку, разбор, проверку значений,
// отказ по полю и возврат набранного, а показать его можно и в потоке, и модальным окном.
// Живой хаб не нужен — граф кита собирает фикстура СборкаUI.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;      // СборкаUI — граф компонентов и рендереров
Перем Фабрика; // Формы (кит)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьКит() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(
		ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули"), "интерфейс", "Классы"));
	Фабрика = UI.Формы;

КонецПроцедуры

#Область СоставЭкрана

// Экран объявляется одним объявлением, и оно СУЩЕСТВУЕТ КАК ОБЪЕКТ: список полей
// и блоков печатается, а не вычисляется по префиксам ключей.
&Тест
Процедура СоставЭкранаПечатаетсяСпискомВПорядкеОбъявления() Экспорт

	Состав = Почта().Состав();

	Роды = Новый Массив();
	Ключи = Новый Массив();
	Для Каждого Элемент Из Состав Цикл
		Роды.Добавить(Элемент.Род);
		Ключи.Добавить(?(Элемент.Род = "блок", "—", Элемент.Ключ));
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Роды, " "), "состав читается сверху вниз")
		.Равно("поле поле поле блок поле");
	Ожидаем.Что(СтрСоединить(Ключи, " "), "и называет свои поля")
		.Равно("oshub.mail.host oshub.mail.port oshub.mail.password — oshub.mail.from");

	Ожидаем.Что(Состав[1].Обязательное, "ограничение поля видно в составе").ЭтоЛожь();
	Ожидаем.Что(Состав[4].ТолькоЧтение, "и «только чтение» тоже").ЭтоИстина();

КонецПроцедуры

// Имя поля ВЫВОДИТСЯ из ключа, а не объявляется рукописной функцией.
&Тест
Процедура ИмяПоляВыводитсяИзКлюча() Экспорт

	Ф = Фабрика.Новая();

	Ожидаем.Что(Ф.ИмяПоля("oshub.mail.smtp.host"), "точка ключа не годится для name")
		.Равно("oshub_mail_smtp_host");
	Ожидаем.Что(Ф.ИмяПоля("тип_субъекта"), "родное имя остаётся собой").Равно("тип_субъекта");
	Ожидаем.Что(Ф.ИмяПоля(" a b/c:d "), "пробел, слэш и двоеточие в name не едут")
		.Равно("a_b_c_d");

	Ф.Поле("oshub.mail.smtp.host", "Сервер", "строка");
	Ожидаем.Что(СтрНайти(Ф.Тело(), "name=""oshub_mail_smtp_host""") > 0,
		"и это же имя печатается в разметке").ЭтоИстина();

КонецПроцедуры

// ГЛАВНЫЙ инвариант слоя: имя поля считает ОДИН код, поэтому отрисовка и разбор
// разойтись не могут. Проверяется не текстом имени, а кругом: что напечатано —
// то и разбирается.
&Тест
Процедура ОтрисовкаИРазборНеРасходятся() Экспорт

	Ф = Почта();
	Имена = ИменаИзРазметки(Ф.Тело());

	Ожидаем.Что(Имена.Количество(), "форма напечатала все свои поля").Равно(4);

	Присланное = Новый Соответствие();
	Для Каждого Имя Из Имена Цикл
		Присланное.Вставить(Имя, "1");
	КонецЦикла;

	Разбор = Ф.Разобрать(Присланное);

	Потерянные = Новый Массив();
	Для Каждого Элемент Из Ф.Состав() Цикл
		Если Элемент.Род <> "поле" ИЛИ Элемент.ТолькоЧтение Тогда
			Продолжить;
		КонецЕсли;
		Если Разбор.Значения.Получить(Элемент.Ключ) = Неопределено Тогда
			Потерянные.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"поля, которые форма напечатала, но не разобрала: имя разошлось").Равно("");

КонецПроцедуры

&Тест
Процедура ДубльКлючаОбъявитьНельзя() Экспорт

	Ф = Фабрика.Новая().Поле("имя", "Имя", "строка");

	Упало = Ложь;
	Попытка
		Ф.Поле("имя", "Второе имя", "строка");
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "два поля с одним ключом печатались бы одним name").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолеБезКлючаОбъявитьНельзя() Экспорт

	Упало = Ложь;
	Попытка
		Фабрика.Новая().Поле("", "Без ключа", "строка");
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "ключ — контракт отрисовки и разбора").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ГотовыеБлоки

// Условие владельца: готовый блок, собранный в другом месте, подключается КАК ЕСТЬ.
// Объявление не знает, как он устроен: не разбирает его, не экранирует и не трогает.
&Тест
Процедура ГотовыйБлокВстаётНаСвоёМестоКакЕсть() Экспорт

	Меню = "<nav class=""menu""><a href=""/main"">Пулы</a><b>&laquo;</b></nav>";

	Ф = Фабрика.Новая()
		.Поле("до", "До", "строка")
		.Блок(Меню)
		.Поле("после", "После", "строка");

	Разметка = Ф.Тело();

	Ожидаем.Что(СтрНайти(Разметка, Меню) > 0, "блок напечатан дословно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "&lt;nav"), "и не экранирован").Равно(0);

	Ожидаем.Что(СтрНайти(Разметка, "name=""до""") < СтрНайти(Разметка, Меню),
		"блок стоит после первого поля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, Меню) < СтрНайти(Разметка, "name=""после"""),
		"и перед вторым — то есть на своём месте в порядке объявления").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГотовыйБлокВРазборНеВходит() Экспорт

	Ф = Фабрика.Новая()
		.Блок("<input type=""hidden"" name=""операция"" value=""создать"">")
		.Поле("имя", "Имя", "строка");

	Присланное = Новый Соответствие();
	Присланное.Вставить("операция", "создать");
	Присланное.Вставить("имя", "main");

	Разбор = Ф.Разобрать(Присланное);

	Ожидаем.Что(Разбор.Значения.Количество(), "разбор видит только объявленные поля").Равно(1);
	Ожидаем.Что(Разбор.Значения.Получить("имя")).Равно("main");

	Состав = Ф.Состав();
	Ожидаем.Что(Состав[0].Род, "блок остаётся блоком в составе").Равно("блок");

КонецПроцедуры

&Тест
Процедура ПодрядИдущиеЭлементыГруппируютсяОбъявленнойОбёрткой() Экспорт

	Ф = Фабрика.Новая()
		.Поле("первое", "Первое", "строка")
		.Поле("в_рамке", "В рамке", "строка", Новый Структура("Рамка", "вставка"))
		.Блок("<i>рядом</i>", Новый Структура("Рамка", "вставка"))
		.Поле("под_катом", "Под катом", "строка", Новый Структура("Кат", "Дополнительно"))
		.Поле("и_соседнее", "И соседнее", "строка", Новый Структура("Кат", "Дополнительно"));

	Разметка = Ф.Тело();

	Ожидаем.Что(СтрНайти(Разметка, "<div class=""inset"">") > 0, "рамка напечатана").ЭтоИстина();
	Ожидаем.Что(ВхожденийПодстроки(Разметка, "class=""inset"""),
		"два подряд идущих элемента попали в ОДНУ рамку").Равно(1);
	Ожидаем.Что(СтрНайти(Разметка, "<details class=""panel"">") > 0, "кат напечатан").ЭтоИстина();
	Ожидаем.Что(ВхожденийПодстроки(Разметка, "<details class=""panel"""),
		"два подряд идущих поля попали под ОДНУ раскрывашку").Равно(1);
	Ожидаем.Что(СтрНайти(Разметка, ">Дополнительно</summary>") > 0,
		"подпись раскрывашки — на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "name=""первое""") < СтрНайти(Разметка, "<div class=""inset"""),
		"поле без обёртки осталось снаружи").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОтказИВозвратНабранного

// Отказ формы — это просто отрисовать её ещё раз: набранное старше действующего,
// поле помечено, и метку с сообщением связывает слой, а не память автора.
&Тест
Процедура ОтказПомечаетПолеИВозвращаетНабранное() Экспорт

	Ф = Почта();

	Присланное = Новый Соответствие();
	Присланное.Вставить("oshub_mail_host", "smtp.example.org");
	Присланное.Вставить("oshub_mail_port", "99999");

	Разбор = Ф.Разобрать(Присланное);
	Ожидаем.Что(Разбор.Принято, "порт вне границ формой не принят").ЭтоЛожь();
	Ожидаем.Что(Разбор.Отказ, "и назван словами").Равно("Не больше 65535");

	Действующие = Новый Соответствие();
	Действующие.Вставить("oshub.mail.port", "587");

	Разметка = Ф.Тело(Действующие);

	Ожидаем.Что(СтрНайти(Разметка, "value=""99999""") > 0,
		"набранное вернулось в поле, а не стёрлось действующим").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "value=""587"""),
		"действующее значение набранное не перебивает").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "aria-invalid=""true""") > 0,
		"поле называет себя отбитым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "aria-describedby=""oshub_mail_port-err""") > 0,
		"и показывает, где объяснение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "id=""oshub_mail_port-err"">Не больше 65535<") > 0,
		"объяснение лежит по этому идентификатору").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<label class=""field field--error"" for=""oshub_mail_port"">") > 0,
		"а подпись связана с полем явно").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтказДоменаПриходитВПолеТемЖеПутём() Экспорт

	Ф = Фабрика.Новая().Поле("имя", "Имя пула", "строка");
	Ф.Отбить("имя", "Такое имя уже занято");

	Разметка = Ф.Тело();
	Ожидаем.Что(СтрНайти(Разметка, ">Такое имя уже занято<") > 0, "текст отказа у поля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "aria-invalid=""true""") > 0, "и поле помечено").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбязательноеПолеПустымНеПринимается() Экспорт

	Ф = Фабрика.Новая().Поле("имя", "Имя", "строка", Новый Структура("Обязательное", Истина));

	Разбор = Ф.Разобрать(Новый Соответствие());
	Ожидаем.Что(Разбор.Принято).ЭтоЛожь();
	Ожидаем.Что(Разбор.Отказы.Получить("имя")).Равно("Заполните это поле");

	Ожидаем.Что(СтрНайти(Ф.Тело(), "required") > 0,
		"и браузеру сказано то же — но защита не в нём").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧислоПроверяетсяПоГраницамИТипу() Экспорт

	Ф = Фабрика.Новая().Поле("порт", "Порт", "число", Новый Структура("Мин, Макс", 1, 65535));

	Ожидаем.Что(Отказ(Ф, "порт", "abc"), "не число").Равно("Введите целое число");
	Ожидаем.Что(Отказ(Ф, "порт", "0"), "ниже минимума").Равно("Не меньше 1");
	Ожидаем.Что(Отказ(Ф, "порт", "65536"), "выше максимума").Равно("Не больше 65535");
	Ожидаем.Что(Отказ(Ф, "порт", "65535"), "граница включительно").Равно("");

	Присланное = Новый Соответствие();
	Присланное.Вставить("порт", "587");
	Возвращённое = Ф.Разобрать(Присланное).Значения.Получить("порт");
	Ожидаем.Что(ТипЗнч(Возвращённое) = Тип("Число"), "разбор отдаёт ЧИСЛО, а не строку").ЭтоИстина();
	Ожидаем.Что(Возвращённое).Равно(587);

КонецПроцедуры

&Тест
Процедура ЗначениеВнеСпискаВариантовНеПринимается() Экспорт

	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("Значение, Подпись", "ветка", "ветка"));
	Варианты.Добавить(Новый Структура("Значение, Подпись", "тег", "тег"));

	Ф = Фабрика.Новая().Поле("вид", "Вид", "выбор", Новый Структура("Варианты", Варианты));

	Ожидаем.Что(Отказ(Ф, "вид", "коммит"), "чужое значение").Равно("Выберите значение из списка");
	Ожидаем.Что(Отказ(Ф, "вид", "тег"), "своё значение").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЧегоНельзяЗабыть

// Значение «только на чтение» не подделывается: пришедшее из формы не попадает
// ни в разбор, ни на экран.
&Тест
Процедура ЗначениеТолькоНаЧтениеНеПодделывается() Экспорт

	Ф = Почта();

	Присланное = Новый Соответствие();
	Присланное.Вставить("oshub_mail_from", "подделка@example.org");

	Разбор = Ф.Разобрать(Присланное);
	Ожидаем.Что(Разбор.Значения.Получить("oshub.mail.from"),
		"подделанное значение в разбор не попало").Равно(Неопределено);

	Действующие = Новый Соответствие();
	Действующие.Вставить("oshub.mail.from", "hub@example.org");

	Разметка = Ф.Тело(Действующие);
	Ожидаем.Что(СтрНайти(Разметка, "подделка@example.org"),
		"и на экран не вернулось").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "value=""hub@example.org""") > 0,
		"показано ДЕЙСТВУЮЩЕЕ значение").ЭтоИстина();

КонецПроцедуры

// Секрет на страницу не возвращается никогда — ни действующий, ни набранный.
&Тест
Процедура СекретНаСтраницуНеВозвращается() Экспорт

	Действующие = Новый Соответствие();
	Действующие.Вставить("oshub.mail.password", "действующий-секрет");

	// первый заход на страницу: разбора не было, показывать нечего, кроме действующего —
	// и его показывать тоже нельзя
	Чистая = Почта().Тело(Действующие);
	Ожидаем.Что(СтрНайти(Чистая, "действующий-секрет"),
		"действующий секрет на страницу не выходит").Равно(0);
	Ожидаем.Что(СтрНайти(Чистая, "type=""password""") > 0, "поле осталось полем пароля").ЭтоИстина();

	// возврат отбитой формы: набранный секрет тоже не возвращается
	Ф = Почта();
	Присланное = Новый Соответствие();
	Присланное.Вставить("oshub_mail_password", "набранный-секрет");
	Разбор = Ф.Разобрать(Присланное);

	Ожидаем.Что(Разбор.Значения.Получить("oshub.mail.password"),
		"сохранить набранный секрет можно").Равно("набранный-секрет");
	Ожидаем.Что(Разбор.Показ.Получить("oshub.mail.password"),
		"а в «что вернуть на экран» он не попадает вовсе").Равно("");

	Разметка = Ф.Тело(Действующие);
	Ожидаем.Что(СтрНайти(Разметка, "набранный-секрет"), "набранный секрет не возвращён").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "действующий-секрет"), "действующий тоже").Равно(0);

КонецПроцедуры

// Секрет не обрезается по краям: пробел в пароле значим.
&Тест
Процедура СекретНеОбрезаетсяПоКраям() Экспорт

	Ф = Фабрика.Новая().Поле("пароль", "Пароль", "секрет");

	Присланное = Новый Соответствие();
	Присланное.Вставить("пароль", " про бел ");

	Ожидаем.Что(Ф.Разобрать(Присланное).Значения.Получить("пароль")).Равно(" про бел ");

КонецПроцедуры

// Чужой текст не становится разметкой: экранирует СЛОЙ, и вызывающий не может забыть.
&Тест
Процедура ЧужойТекстНеСтановитсяРазметкой() Экспорт

	Яд = "<script>alert(1)</script>";

	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("Значение, Подпись", Яд, Яд));

	Ф = Фабрика.Новая()
		.Поле("поле", Яд, "строка", Новый Структура("Подсказка, Плейсхолдер", Яд, Яд))
		.Поле("выбор", "Выбор", "выбор", Новый Структура("Варианты", Варианты));
	Ф.Отбить("поле", Яд);

	Действующие = Новый Соответствие();
	Действующие.Вставить("поле", Яд);

	Разметка = Ф.Тело(Действующие);

	Ожидаем.Что(СтрНайти(НРег(Разметка), "<script"),
		"ни значение, ни метка, ни подсказка, ни отказ, ни вариант не стали тегом").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "&lt;script&gt;") > 0, "всё это напечатано текстом").ЭтоИстина();

КонецПроцедуры

// Токен CSRF забыть нельзя: печать формы без него отказывается работать.
&Тест
Процедура ТокенCSRFЗабытьНельзя() Экспорт

	Упало = Ложь;
	Попытка
		Фабрика.Новая().Поле("имя", "Имя", "строка").Отрисовать(Неопределено, "/settings", "");
	Исключение
		Упало = Истина;
	КонецПопытки;
	Ожидаем.Что(Упало, "форма без токена гарантированно получила бы 403").ЭтоИстина();

	СТокеном = Фабрика.Новая().Поле("имя", "Имя", "строка")
		.Отрисовать(Неопределено, "/settings", "тк-1");
	Ожидаем.Что(СтрНайти(СТокеном, "name=""_csrf"" value=""тк-1""") > 0,
		"а с токеном скрытое поле печатает сама форма").ЭтоИстина();

КонецПроцедуры

// Отказаться от токена можно только НАЗВАВ причину: у анонимной формы сессии нет.
&Тест
Процедура ФормаБезТокенаТребуетНазваннойПричины() Экспорт

	Упало = Ложь;
	Попытка
		Фабрика.Новая().БезТокена("");
	Исключение
		Упало = Истина;
	КонецПопытки;
	Ожидаем.Что(Упало, "молча отказаться от токена нельзя").ЭтоИстина();

	Анонимная = Фабрика.Новая().Поле("логин", "Логин", "строка")
		.БезТокена("у анонимной формы регистрации нет сессии")
		.Отрисовать(Неопределено, "/register", "");
	Ожидаем.Что(СтрНайти(Анонимная, "name=""_csrf"""), "скрытого поля нет").Равно(0);
	Ожидаем.Что(СтрНайти(Анонимная, "<form method=""post"" action=""/register"">") > 0,
		"а форма печатается").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПечатьФормыБезДействияНеРаботает() Экспорт

	Упало = Ложь;
	Попытка
		Фабрика.Новая().Поле("имя", "Имя", "строка").Отрисовать(Неопределено, "", "тк");
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "форме некуда отправлять POST").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область МодальноеОкно

// Форма создания места на экране не занимает, пока не открыта, и открывает её
// движок браузера — без единой строки JS.
&Тест
Процедура ОкноНеЗанимаетМестаИОткрываетсяКомандойДвижка() Экспорт

	Разметка = Окно(Ложь);

	Ожидаем.Что(СтрНайти(Разметка, "<dialog class=""modal""") > 0, "форма живёт в <dialog>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<dialog class=""modal"" id="""), "закрытое окно без open")
		.Равно(СтрНайти(Разметка, "<dialog"));
	Ожидаем.Что(СтрНайти(Разметка, "open>"), "атрибута open у закрытого окна нет").Равно(0);

	Ид = ИдентификаторОкна(Разметка);
	Ожидаем.Что(СтрНайти(Разметка, "command=""show-modal"" commandfor=""" + Ид + """") > 0,
		"кнопка открывает окно командой движка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "command=""close"" commandfor=""" + Ид + """") > 0,
		"и закрывает ею же").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Разметка), "<script"), "скрипта здесь нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Разметка), "onclick"), "и обработчика в атрибуте тоже").Равно(0);

	Ожидаем.Что(СтрНайти(Разметка, "aria-label=""Создать пул""") > 0,
		"окно называет себя скринридеру").ЭтоИстина();

КонецПроцедуры

// Отбитая форма возвращается ТЕМ ЖЕ окном: открытым, с набранным и помеченным полем.
&Тест
Процедура ОтбитаяФормаВозвращаетсяТемЖеОкном() Экспорт

	Разметка = Окно(Истина);

	Ид = ИдентификаторОкна(Разметка);
	Ожидаем.Что(СтрНайти(Разметка, "id=""" + Ид + """ aria-label=""Создать пул"" open>") > 0,
		"окно печатается открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "value=""занятое-имя""") > 0, "с набранным").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "aria-invalid=""true""") > 0, "и помеченным полем").ЭтоИстина();

КонецПроцедуры

// Идентификатор связи кнопки с окном генерирует КИТ порядковым номером: возьми он
// значение из данных, два похожих имени дали бы один идентификатор, и кнопка открыла бы
// чужое окно.
&Тест
Процедура ИдентификаторОкнаВыдаётКитАНеДанные() Экспорт

	Первое = Фабрика.Новая();
	Второе = Фабрика.Новая();

	Ожидаем.Что(Первое.ИдентификаторОкна() = Второе.ИдентификаторОкна(),
		"два окна одной страницы не делят идентификатор").ЭтоЛожь();

	Оформление = Новый Структура("Заголовок, Открывашка", "<b>main</b>", "<b>main</b>");
	Разметка = Первое.Поле("имя", "Имя", "строка")
		.ОтрисоватьВОкне(Неопределено, "/settings", "тк", Оформление);

	Ожидаем.Что(СтрНайти(Первое.ИдентификаторОкна(), "main"),
		"значение из данных в идентификатор не попадает вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "id=""" + Первое.ИдентификаторОкна() + """") > 0,
		"а печатается именно выданный китом").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОкноБезЗаголовкаНеПечатается() Экспорт

	Упало = Ложь;
	Попытка
		Фабрика.Новая().Поле("имя", "Имя", "строка").ОтрисоватьВОкне(
			Неопределено, "/settings", "тк", Новый Структура("Открывашка", "Создать"));
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "без заголовка окно не назовёт себя скринридеру").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОкноНесётТокенТойЖеФормыИСерверныйАдресДействия() Экспорт

	Разметка = Окно(Ложь);

	Ожидаем.Что(СтрНайти(Разметка, "name=""_csrf"" value=""тк-9""") > 0,
		"токен печатает то же объявление").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<form method=""post"" class=""form-stack"" action=""/hub/settings/pools"">") > 0,
		"отправка — обычный POST на обычный адрес").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Объявление секции «Почта» дома «Хаб» — тот самый экран, ради которого требование
// заведено: одиннадцать файлов, из которых нельзя было прочитать список полей.
Функция Почта()

	Возврат Фабрика.Новая()
		.Поле("oshub.mail.host", "Сервер SMTP", "строка", Новый Структура("Обязательное", Истина))
		.Поле("oshub.mail.port", "Порт", "число", Новый Структура("Мин, Макс", 1, 65535))
		.Поле("oshub.mail.password", "Пароль", "секрет")
		.Блок("<p class=""muted"">Письма уходят от имени хаба</p>")
		.Поле("oshub.mail.from", "Отправитель", "строка", Новый Структура("ТолькоЧтение", Истина));

КонецФункции

Функция Окно(Знач Открыта)

	Ф = Фабрика.Новая().Поле("имя", "Имя пула", "строка",
		Новый Структура("Обязательное", Истина));

	Действующие = Неопределено;
	Если Открыта Тогда
		Присланное = Новый Соответствие();
		Присланное.Вставить("имя", "занятое-имя");
		Ф.Разобрать(Присланное);
		Ф.Отбить("имя", "Такое имя уже занято");
	КонецЕсли;

	Оформление = Новый Структура();
	Оформление.Вставить("Заголовок", "Создать пул");
	Оформление.Вставить("Открывашка", "Создать пул");
	Оформление.Вставить("Отмена", "Отмена");
	Оформление.Вставить("Отправка", "Создать");
	Оформление.Вставить("Открыта", Открыта);

	Возврат Ф.ОтрисоватьВОкне(Действующие, "/hub/settings/pools", "тк-9", Оформление);

КонецФункции

Функция ИдентификаторОкна(Знач Разметка)

	Маркер = "commandfor=""";
	Поз = СтрНайти(Разметка, Маркер);
	Ожидаем.Что(Поз > 0, "кнопка окна в разметке есть").ЭтоИстина();

	Хвост = Сред(Разметка, Поз + СтрДлина(Маркер));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция Отказ(Знач Ф, Знач Ключ, Знач Значение)

	Присланное = Новый Соответствие();
	Присланное.Вставить(Ф.ИмяПоля(Ключ), Значение);

	Найденный = Ф.Разобрать(Присланное).Отказы.Получить(Ключ);
	Возврат ?(Найденный = Неопределено, "", Найденный);

КонецФункции

// Имена управлений из напечатанной разметки: сторож круга «что напечатано — то
// и разбирается» обязан брать их из HTML, а не из объявления.
Функция ИменаИзРазметки(Знач Разметка)

	Результат = Новый Массив();
	Маркер = "name=""";
	Хвост = Разметка;
	Поз = СтрНайти(Хвост, Маркер);

	Пока Поз > 0 Цикл
		Хвост = Сред(Хвост, Поз + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Имя = Лев(Хвост, Конец - 1);
			Если Результат.Найти(Имя) = Неопределено Тогда
				Результат.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
		Поз = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВхожденийПодстроки(Знач Текст, Знач Подстрока)

	Результат = 0;
	Хвост = Текст;
	Поз = СтрНайти(Хвост, Подстрока);

	Пока Поз > 0 Цикл
		Результат = Результат + 1;
		Хвост = Сред(Хвост, Поз + СтрДлина(Подстрока));
		Поз = СтрНайти(Хвост, Подстрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
