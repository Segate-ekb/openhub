// Прокси Telegram: сборка прокси из настроек хаба, поход в Bot API через него и доказательство,
// что чужой трафик того же http-клиента oint мимо прокси идёт напрямую. Живой хаб не поднимается,
// в сеть набор не ходит: и прокси, и сосед — локальные TCP-слушатели на выданных портах.

#Использовать asserts
#Использовать autumn-logos
#Использовать oint
#Использовать "фикстуры"

Перем Выдача;           // фикстура ВыдачаПортов — свободный порт спрашивается у ОС

Перем Транспорт;        // чем отправляет фоновое задание, пока слушатель держит главный поток
Перем ИтогОтправки;     // вердикт фоновой отправки
Перем АдресСоседа;      // адрес запроса-соседа тем же клиентом oint, которым ходит S3
Перем СоседОтвечен;     // Булево — сосед дошёл до конца (самотест теста утечки)
Перем Доставка;         // ДоставкаTelegram — журнальный сторож секрета
Перем ЗаданиеДоставки;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	КаталогПодписок = ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "подписки"), "Классы");
	КаталогТелеграм = ОбъединитьПути(ОбъединитьПути(КаталогПодписок, "обработчики"), "telegram");
	КаталогДоставки = ОбъединитьПути(КаталогПодписок, "доставка");
	КаталогСобытийПуть = ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "события"), "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ВыдачаПортов");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ПроксиTelegramСМеткой");

	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.Подключить(КаталогТелеграм, "ПроксиTelegram");
	ПоискКлассов.Подключить(КаталогТелеграм, "ТелоСообщенияTelegram");
	ПоискКлассов.Подключить(КаталогТелеграм, "ТранспортTelegramOint");
	ПоискКлассов.Подключить(КаталогТелеграм, "ДоставкаTelegram");
	ПоискКлассов.Подключить(КаталогПодписок, "ШаблонУведомления");
	ПоискКлассов.Подключить(КаталогДоставки, "ЧислаДоставки");
	ПоискКлассов.Подключить(КаталогСобытийПуть, "ИздательСобытий");
	ПоискКлассов.Подключить(КаталогСобытийПуть, "КаталогСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "реестр"), "Классы"),
		"ЗаполнениеПула");

	Выдача = Новый ВыдачаПортов();

КонецПроцедуры

&ПослеВсех
Процедура ВернутьПорты() Экспорт
	Выдача.ВернутьВсе();
КонецПроцедуры

#Область ПроксиИзНастроек

// Пустой сервер — это «ходить в Bot API напрямую»: ровно так хаб вёл себя до появления
// этих четырёх ключей, и ровно так он обязан вести себя у того, кто прокси не заводил.
&Тест
Процедура ПустойСерверНеДаётПроксиДляЗапроса() Экспорт

	Прокси = НовыйПрокси(НастройкиПрокси("", 0, "", ""));

	Ожидаем.Что(Прокси.Задан(), "прокси без сервера не задан").ЭтоЛожь();
	Ожидаем.Что(Прокси.Соединение() = Неопределено,
		"запросу нечего ставить прокси — он пойдёт напрямую").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПроксиСобираетсяИзЧетырёхКлючейДоставки() Экспорт

	Прокси = НовыйПрокси(
		НастройкиПрокси("proxy.example.ru", 8080, "оператор", "Пароль-Прокси-9f31"));

	Ожидаем.Что(Прокси.Задан(), "заполненный сервер включает прокси").ЭтоИстина();

	Соединение = Прокси.Соединение();
	// «https» — схема ЦЕЛЕВОГО адреса: через прокси хаб ходит именно в https://api.telegram.org
	Ожидаем.Что(СтрНайти(Соединение.Сервер("https"), "proxy.example.ru") > 0,
		"сервер прокси взят из настройки: " + Соединение.Сервер("https")).ЭтоИстина();
	Ожидаем.Что(Соединение.Порт("https"), "порт прокси взят из настройки").Равно(8080);
	Ожидаем.Что(Соединение.Пользователь("https"), "пользователь прокси взят из настройки")
		.Равно("оператор");
	Ожидаем.Что(Соединение.Пароль("https"), "пароль прокси доезжает до самого запроса")
		.Равно("Пароль-Прокси-9f31");

КонецПроцедуры

// Правка настройки обязана действовать сразу: значение спрашивается на каждой отправке,
// а не запоминается конструктором — иначе администратор чинил бы доставку перезапуском хаба.
&Тест
Процедура ПравкаНастройкиВиднаБезПересозданияПрокси() Экспорт

	Настройки = НастройкиПрокси("первый.example.ru", 8080, "", "");
	Прокси = НовыйПрокси(Настройки);

	Ожидаем.Что(СтрНайти(Прокси.Соединение().Сервер("https"), "первый.example.ru") > 0,
		"самотест: первый прокси собран").ЭтоИстина();

	Настройки.Задать("oshub.webhooks.telegram.proxy.host", "второй.example.ru");
	Настройки.Задать("oshub.webhooks.telegram.proxy.port", 3128);

	Ожидаем.Что(СтрНайти(Прокси.Соединение().Сервер("https"), "второй.example.ru") > 0,
		"тот же объект отдаёт уже новый сервер").ЭтоИстина();
	Ожидаем.Что(Прокси.Соединение().Порт("https"), "и новый порт").Равно(3128);

	Настройки.Задать("oshub.webhooks.telegram.proxy.host", "");
	Ожидаем.Что(Прокси.Соединение() = Неопределено,
		"стёртый сервер возвращает прямой поход тем же объектом").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ВычёркиваниеСекретовПрокси

// Диагностику похода в Bot API собирает чужая библиотека, и пароль прокси в ней окажется
// ровно тогда, когда его напечатает сам прокси. Вычеркнуть свой секрет обязан владелец.
&Тест
Процедура ПарольПроксиВычёркиваетсяИзДиагностики() Экспорт

	Прокси = НовыйПрокси(НастройкиПрокси("proxy.example.ru", 8080, "оператор", "Пароль-Прокси-9f31"));

	Очищенный = Прокси.БезСвоихСекретов(
		"прокси отказал: учётка оператор/Пароль-Прокси-9f31 не подошла");

	Ожидаем.Что(СтрНайти(Очищенный, "Пароль-Прокси-9f31"),
		"пароля в диагностике не осталось: " + Очищенный).Равно(0);
	Ожидаем.Что(СтрНайти(Очищенный, "•••") > 0, "на его месте маска: " + Очищенный).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Очищенный, "прокси отказал") > 0,
		"остальная диагностика цела: " + Очищенный).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НезаданныйПарольДиагностикуНеПортит() Экспорт

	Прокси = НовыйПрокси(НастройкиПрокси("proxy.example.ru", 8080, "оператор", ""));
	Текст = "прокси отказал: соединение закрыто";

	Ожидаем.Что(Прокси.БезСвоихСекретов(Текст),
		"без пароля вычёркивать нечего — текст уходит как есть").Равно(Текст);

КонецПроцедуры

// Зазор, принятый вместе с основа/ТекстОшибки: секрет короче шести знаков не вычёркивается
// вовсе — его «вхождения» были бы случайными совпадениями. Сторож фиксирует это как факт,
// чтобы смена порога не прошла молча.
&Тест
Процедура КороткийПарольПроксиИзДиагностикиНеВычёркивается() Экспорт

	Прокси = НовыйПрокси(НастройкиПрокси("proxy.example.ru", 8080, "оператор", "аб123"));

	Ожидаем.Что(Прокси.БезСвоихСекретов("прокси отказал: пароль аб123 не подошёл"),
		"пятизначный пароль остаётся в диагностике как есть")
		.Равно("прокси отказал: пароль аб123 не подошёл");

КонецПроцедуры

// Обратная сторона того же порога: пароль длиной от шести знаков вычёркивается ВЕЗДЕ,
// включая середину обычного слова. Диагностика при этом читается хуже — цена секретности.
&Тест
Процедура ПарольПодстрокойОбычногоСловаВычёркиваетсяВместеСНим() Экспорт

	Прокси = НовыйПрокси(НастройкиПрокси("proxy.example.ru", 8080, "оператор", "секрет"));

	Ожидаем.Что(Прокси.БезСвоихСекретов("сверхсекретный прокси отказал"),
		"вхождение внутри слова тоже заменяется маской")
		.Равно("сверх•••ный прокси отказал");

КонецПроцедуры

#КонецОбласти

#Область ПоходВBotAPI

// Наблюдаемый факт «уведомление пошло через прокси»: на слушателе, названном прокси,
// появляется CONNECT к Bot API. Прокси в роли сторожа не притворяется — он и есть прокси.
&Тест
Процедура ОтправкаВBotAPIПриходитНаЗаданныйПрокси() Экспорт

	Порт = Выдача.Выдать();
	СобратьТранспорт(НастройкиПрокси("127.0.0.1", Порт, "оператор", "Пароль-Прокси-9f31"));

	Сервер = ПоднятьСлушатель(Порт);
	Попытка
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОтправитьВФоне");
		Пришло = ПринятьЗапрос(Сервер, 20000, 28, ОтказПрокси());
		Дождаться(Задание);
	Исключение
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Остановить(Сервер, Порт);

	Ожидаем.Что(Пришло, "на прокси пришёл туннель к Bot API").Равно("CONNECT api.telegram.org:443");

КонецПроцедуры

// Прокси Telegram — не прокси хаба: тем же http-клиентом oint хаб ходит в объектное
// хранилище, и его запрос, сделанный в окне телеграмной отправки, обязан идти напрямую.
// Прежний путь (настройки расширенного вызова oint) увёл бы его на этот же слушатель:
// настройки там — переменная модуля, общая на весь процесс.
&Тест
Процедура ЧужойЗапросТогоЖеКлиентаOintМимоПроксиНеИдёт() Экспорт

	ПортПрокси = Выдача.Выдать();
	ПортСоседа = Выдача.Выдать();
	СобратьТранспорт(НастройкиПрокси("127.0.0.1", ПортПрокси, "", ""));
	// схема названа явно: адрес без неё http-клиент oint считает защищённым и уходит в TLS
	АдресСоседа = "http://127.0.0.1:" + Формат(ПортСоседа, "ЧГ=0") + "/health";
	СоседОтвечен = Ложь;

	Прокси = ПоднятьСлушатель(ПортПрокси);
	Сосед = ПоднятьСлушатель(ПортСоседа);

	Попытка

		ЗаданиеОтправки = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОтправитьВФоне");
		// туннель принят, но НЕ отвечен: соседний запрос делается, пока телеграмный в полёте
		Туннель = ПринятьСоединение(Прокси, 20000);
		Ожидаем.Что(НачалоЗапроса(Туннель, 28), "самотест: телеграмная отправка дошла до прокси")
			.Равно("CONNECT api.telegram.org:443");

		ЗаданиеСоседа = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗапроситьСоседаВФоне");
		ПришлоСоседу = ПринятьЗапрос(Сосед, 20000, 3, ОтветСоседа());

		// туннелю отвечаем отказом, а не обрывом: оборванное соединение клиент переоткрывает,
		// и на слушателе появился бы второй телеграмный CONNECT
		Закрыть(Туннель, ОтказПрокси());
		Дождаться(ЗаданиеСоседа);
		Дождаться(ЗаданиеОтправки);

		Лишнее = ПринятьЗапрос(Прокси, 1500, 28, "");

	Исключение
		Остановить(Прокси, ПортПрокси);
		Остановить(Сосед, ПортСоседа);
		ВызватьИсключение;
	КонецПопытки;

	Остановить(Прокси, ПортПрокси);
	Остановить(Сосед, ПортСоседа);

	Ожидаем.Что(ПришлоСоседу, "самотест: соседний запрос состоялся и пришёл ПРЯМО к соседу")
		.Равно("GET");
	Ожидаем.Что(СоседОтвечен, "самотест: сосед ответил вызывающему, а не оборвался").ЭтоИстина();
	Ожидаем.Что(Лишнее, "на прокси Telegram больше не пришло ни одного запроса").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОтказДоставки

// Прокси, который глотает пакеты молча, обязан кончиться отказом по таймауту доставки,
// а не зависанием: http-клиент oint без своего таймаута ждёт ответа час, и всё это время
// фоновый цикл доставки стоял бы на одном задании.
&Тест
Процедура МолчащийПроксиДаётОтказПоТаймаутуАНеЗависание() Экспорт

	Порт = Выдача.Выдать();
	Настройки = НастройкиПрокси("127.0.0.1", Порт, "", "");
	Настройки.Задать("oshub.webhooks.delivery_timeout_sec", 3);
	СобратьТранспорт(Настройки);

	Сервер = ПоднятьСлушатель(Порт);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОтправитьВФоне");
		// соединение принимается и не отвечается вовсе — так выглядит прокси за файрволом
		Туннель = ПринятьСоединение(Сервер, 20000);
		Пришло = ?(Туннель = Неопределено, "", НачалоЗапроса(Туннель, 28));
		Дождаться(Задание);
		Закрыть(Туннель, "");
	Исключение
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Остановить(Сервер, Порт);
	Потрачено = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем.Что(Пришло, "самотест: отправка дошла до прокси, а не ушла в сеть мимо него")
		.Равно("CONNECT api.telegram.org:443");
	Ожидаем.Что(ИтогОтправки.Успех, "молчащий прокси — отказ доставки").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(ИтогОтправки.Сообщение),
		"у отказа названа причина: её увидит и журнал, и карточка подписки").ЭтоИстина();
	Ожидаем.Что(Потрачено < 30000,
		"отправка сдалась по таймауту доставки, а не по часовому умолчанию библиотеки:"
			+ " потрачено " + Формат(Потрачено, "ЧГ=0") + " мс").ЭтоИстина();

КонецПроцедуры

// Оборванный прокси — обычный отказ, а не исключение наружу: задание доставки обязано
// вернуться в очередь по общим правилам повтора, а не уронить разбор партии.
&Тест
Процедура ОборванныйПроксиДаётОтказСПричинойАНеИсключение() Экспорт

	Порт = Выдача.Выдать();
	СобратьТранспорт(НастройкиПрокси("127.0.0.1", Порт, "", ""));

	Сервер = ПоднятьСлушатель(Порт);
	Попытка
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОтправитьВФоне");
		Пришло = ПринятьЗапрос(Сервер, 20000, 28, ОтказПрокси());
		Дождаться(Задание);
	Исключение
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Остановить(Сервер, Порт);

	Ожидаем.Что(Пришло, "самотест: отправка дошла до прокси, а не ушла в сеть мимо него")
		.Равно("CONNECT api.telegram.org:443");
	Ожидаем.Что(СтрНайти(ИтогОтправки.Сообщение, "ИСКЛЮЧЕНИЕ"),
		"транспорт не бросает наружу: " + ИтогОтправки.Сообщение).Равно(0);
	Ожидаем.Что(ИтогОтправки.Успех, "недоступный прокси — отказ доставки").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(ИтогОтправки.Сообщение), "и у отказа названа причина").ЭтоИстина();

КонецПроцедуры

// Вычеркнуть свой секрет прокси может только тогда, когда его об этом просят: сторож
// стережёт сам ВЫЗОВ, подставляя вместо вычёркивания метку. Убери вызов из транспорта —
// метки в тексте отказа не станет, и тест покраснеет, не сходив при этом в сеть.
&Тест
Процедура ОтказПроситПроксиВычеркнутьЕгоСекреты() Экспорт

	Порт = Выдача.Выдать();
	Прокси = Новый ПроксиTelegramСМеткой("127.0.0.1", Порт);
	СобратьТранспортНаПрокси(НастройкиПрокси("127.0.0.1", Порт, "", ""), Прокси);

	Сервер = ПоднятьСлушатель(Порт);
	Попытка
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОтправитьВФоне");
		Пришло = ПринятьЗапрос(Сервер, 20000, 28, ОтказПрокси());
		Дождаться(Задание);
	Исключение
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Остановить(Сервер, Порт);

	Ожидаем.Что(Пришло, "самотест: отправка дошла до прокси, а не ушла в сеть мимо него")
		.Равно("CONNECT api.telegram.org:443");
	Ожидаем.Что(ИтогОтправки.Успех, "самотест: отказ, иначе вычёркивать было бы нечего").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ИтогОтправки.Сообщение, Прокси.МеткаВычёркивания()) > 0,
		"текст отказа прошёл через вычёркивание секретов прокси: " + ИтогОтправки.Сообщение)
		.ЭтоИстина();

КонецПроцедуры

// НФТ-ПОДП-003 на пароле прокси: он вводится с экрана и с тех пор не выходит ни текстом
// отказа, который печатает карточка подписки, ни строкой журнала доставки.
&Тест
Процедура ПарольПроксиНеВыходитНиВОтказНиВЖурналДоставки() Экспорт

	Секрет = "Proxy-Pass-4f2a9d7b";
	Токен = "424242:tokeN-kotorogo-v-loge-byt-ne-dolzhno";
	Порт = Выдача.Выдать();

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.телеграм.прокси");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	СобратьДоставку(НастройкиПрокси("127.0.0.1", Порт, "оператор", Секрет), Лог, Токен);

	Сервер = ПоднятьСлушатель(Порт);
	Попытка
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДоставитьВФоне");
		// прокси отвечает отказом, печатая учётку в причине: так секрет попадает
		// в диагностику чужой библиотеки — ровно там его и надо перехватить
		ПришлоОтДоставки = ПринятьЗапрос(Сервер, 20000, 28, ОтказПрокси(Секрет));
		ПришлоОтПробы = ПринятьЗапрос(Сервер, 20000, 28, ОтказПрокси(Секрет));
		Дождаться(Задание);
	Исключение
		Лог.УдалитьСпособВывода(Ловушка);
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);
	Остановить(Сервер, Порт);

	// без этой пары сторож зеленел бы на отправке, ушедшей в настоящий api.telegram.org
	Ожидаем.Что(ПришлоОтДоставки, "боевая доставка пошла через прокси")
		.Равно("CONNECT api.telegram.org:443");
	Ожидаем.Что(ПришлоОтПробы, "и пробная отправка — через него же")
		.Равно("CONNECT api.telegram.org:443");

	Ожидаем.Что(ИтогОтправки.Успех, "самотест: доставка через мёртвый прокси не удалась").ЭтоЛожь();
	Ожидаем.Что(Ловушка.Количество() > 0, "самотест: ядро доставки что-то записало в журнал").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ИтогОтправки.Сообщение, Секрет),
		"пароля прокси нет в тексте отказа: " + ИтогОтправки.Сообщение).Равно(0);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), Секрет),
		"пароля прокси нет ни в одной строке журнала: " + Ловушка.Всё()).Равно(0);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), Токен),
		"и токен бота по-прежнему не печатается: " + Ловушка.Всё()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ФоновыеОтправки

// Слушатель держит ГЛАВНЫЙ поток набора, поэтому отправка уходит в фоновое задание:
// TCPСервер, поднятый в фоне, входящих соединений не принимает.
Процедура ОтправитьВФоне() Экспорт

	Попытка
		ИтогОтправки = Транспорт.ОтправитьСообщение("123456:AAHfakeTokenValue",
			"-1001234567890", "хаб проверяет прокси");
	Исключение
		ИтогОтправки = Новый Структура("Успех, Сообщение", Ложь, "ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Обе поверхности, на которых человек видит отказ: журнал (боевая доставка) и текст
// на карточке подписки (пробная отправка).
Процедура ДоставитьВФоне() Экспорт

	Попытка
		Доставка.Доставить(ЗаданиеДоставки);
		Проба = Доставка.Проба(ЗаданиеДоставки);
		ИтогОтправки = Новый Структура("Успех, Сообщение", Проба.Успех, Проба.Сообщение);
	Исключение
		ИтогОтправки = Новый Структура("Успех, Сообщение", Ложь, "ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Тот самый http-клиент oint, которым хаб ходит в объектное хранилище (OPI_S3).
Процедура ЗапроситьСоседаВФоне() Экспорт

	Попытка
		OPI_ЗапросыHTTP.Get(АдресСоседа);
		СоседОтвечен = Истина;
	Исключение
		СоседОтвечен = Ложь;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Слушатели

Функция ПоднятьСлушатель(Знач Порт)
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	Возврат Сервер;
КонецФункции

// ⚠ ОжидатьСоединения выжидает свой таймаут ЦЕЛИКОМ и только потом отдаёт накопленное
// соединение — поэтому ждём короткими ломтями, а не одним куском на всё терпение теста.
Функция ПринятьСоединение(Знач Сервер, Знач ТаймаутМс)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутМс;
	Пока Истина Цикл
		Соединение = Сервер.ОжидатьСоединения(ЛомотьОжиданияМс());
		Если Соединение <> Неопределено Тогда
			Возврат Соединение;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

КонецФункции

Функция ЛомотьОжиданияМс()
	Возврат 200;
КонецФункции

// Начало запроса: столько первых байт, сколько нужно, чтобы узнать запрос в лицо.
Функция НачалоЗапроса(Знач Соединение, Знач СколькоБайт)
	Соединение.ТаймаутЧтения = 5000;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(
		Соединение.ПрочитатьДвоичныеДанные(СколькоБайт), "UTF-8");
КонецФункции

// Принимает одно соединение целиком: читает начало запроса, отвечает и закрывается.
// Пустая строка — за отведённое время не пришло ничего.
Функция ПринятьЗапрос(Знач Сервер, Знач ТаймаутМс, Знач СколькоБайт, Знач Ответ)

	Соединение = ПринятьСоединение(Сервер, ТаймаутМс);
	Если Соединение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Начало = НачалоЗапроса(Соединение, СколькоБайт);
	Закрыть(Соединение, Ответ);
	Возврат Начало;

КонецФункции

Процедура Закрыть(Знач Соединение, Знач Ответ)

	Попытка
		Если ЗначениеЗаполнено(Ответ) Тогда
			Соединение.ОтправитьСтроку(Ответ);
			Приостановить(100);
		КонецЕсли;
		Соединение.Закрыть();
	Исключение
		// вызывающая сторона могла уже сдаться по таймауту — писать в её сокет некуда
	КонецПопытки;

КонецПроцедуры

Процедура Остановить(Знач Сервер, Знач Порт)

	Попытка
		Сервер.Остановить();
	Исключение
		// слушатель мог не подняться — порт всё равно надо вернуть в оборот
	КонецПопытки;
	Выдача.Вернуть(Порт);

КонецПроцедуры

Функция ОтказПрокси(Знач Хвост = "")
	Возврат "HTTP/1.1 502 Bad Gateway " + Хвост + КонецСтроки() + КонецСтроки();
КонецФункции

Функция ОтветСоседа()
	Возврат "HTTP/1.1 200 OK" + КонецСтроки() + "Content-Length: 0" + КонецСтроки() + КонецСтроки();
КонецФункции

Функция КонецСтроки()
	Возврат Символы.ВК + Символы.ПС;
КонецФункции

Процедура Дождаться(Знач Задание)
	Задания = Новый Массив();
	Задания.Добавить(Задание);
	ФоновыеЗадания.ОжидатьВсе(Задания, 60000);
КонецПроцедуры

#КонецОбласти

#Область Сборка

Функция НастройкиПрокси(Знач Сервер, Знач Порт, Знач Пользователь, Знач Пароль)

	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Настройки.Задать("oshub.webhooks.telegram.proxy.host", Сервер);
	Настройки.Задать("oshub.webhooks.telegram.proxy.port", Порт);
	Настройки.Задать("oshub.webhooks.telegram.proxy.user", Пользователь);
	Настройки.Задать("oshub.webhooks.telegram.proxy.password", Пароль);
	Возврат Настройки;

КонецФункции

Функция НовыйПрокси(Знач Настройки)
	Возврат Новый ПроксиTelegram(Настройки, Новый ТекстОшибки());
КонецФункции

Процедура СобратьТранспорт(Знач Настройки)
	СобратьТранспортНаПрокси(Настройки, НовыйПрокси(Настройки));
КонецПроцедуры

Процедура СобратьТранспортНаПрокси(Знач Настройки, Знач Прокси)

	// заготовка намеренно «успешна и без слов»: не дойди отправка до конца, сторожа отказа
	// зазеленели бы на ней, ни разу не заглянув в транспорт
	ИтогОтправки = Новый Структура("Успех, Сообщение", Истина, "");
	Транспорт = Новый ТранспортTelegramOint(Прокси,
		Новый ТелоСообщенияTelegram(), Новый ЧислаДоставки(Настройки), Новый ТекстОшибки());

КонецПроцедуры

Процедура СобратьДоставку(Знач Настройки, Знач Лог, Знач Токен)

	СобратьТранспорт(Настройки);
	Каталог = Новый КаталогСобытий(Новый ИздательСобытий(), Новый ЗаполнениеПула());
	Доставка = Новый ДоставкаTelegram(Транспорт, Новый ШаблонУведомления(Каталог),
		Лог, Новый ТекстОшибки());
	ЗаданиеДоставки = Новый Структура("ИдДоставки, ТипСобытия, Тело, НомерПопытки, Действие",
		"д-1", "версия.опубликована", "{}", 1,
		Новый Структура("ЧатИд, Токен", "-1001234567890", Токен));

КонецПроцедуры

#КонецОбласти
