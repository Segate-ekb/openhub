// Живая приёмка выбора протокола: на одном настоящем хабе зеркало заводится на адрес выдачи
// его же пула — один адрес, без указания протокола, — и привозит в пул назначения все версии
// источника. Так администратор переносит пакеты между пулами разных хабов, и так же выглядел
// дефект: угаданный человеком протокол решал, приедут пакеты или прогон закроется нулём.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;            // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;         // фикстура КлиентХаба — запросы к подопытному хабу
Перем КореньДанных;
Перем ТокенRoot;      // PAT администратора хаба: он и публикует источник, и заводит зеркало
Перем ПулНазначения;
Перем ИмяПакета;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабИЗасеятьИсточник() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);
	КореньДанных = Хаб.ФайловаяБаза("openhub-зеркало-своего-хаба");
	Сидер = ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os");

	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);
	Хаб.Запустить();

	ТокенRoot = ВыпуститьPAT(Клиент.Войти("root", "RootPassw0rd"));

	ИмяПакета = УникальныеИмена.Имя("self-mirror");
	Для Каждого Версия Из СтрРазделить("1.0.0,1.1.0,2.0.0", ",") Цикл
		Опубликовать("public", ИмяПакета, Версия);
	КонецЦикла;

	ПулНазначения = УникальныеИмена.Имя("self-dest");
	Ожидаем.Что(ЗавестиПул(ПулНазначения).КодСостояния, "пул назначения заведён").Равно(201);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Весь путь целиком: адрес выдачи пула — единственное, что сказали хабу. Протокол он
// выбирает сам, привозит все версии источника и называет в карточке, чем прочитал.
&Тест
Процедура ЗеркалоНаПулСвоегоХабаПривозитВсеВерсииБезУказанияПротокола() Экспорт

	Заведение = ЗавестиЗеркало(ПулНазначения, АдресВыдачиПула("public"));
	Ожидаем.Что(Заведение.КодСостояния, "зеркало заведено одним адресом: " + Клиент.Тело(Заведение))
		.Равно(201);
	Карточка = Клиент.ТелоJSON(Заведение).Получить("mirror");
	Ожидаем.Что(Карточка.Получить("protocol"), "до первого обхода протокол неизвестен").Равно("");

	Ид = Формат(Карточка.Получить("id"), "ЧН=0; ЧГ=0");
	Ожидаем.Что(ЗапроситьСинк(ПулНазначения, Ид).КодСостояния, "заявка на синк принята").Равно(202);

	Прогон = ДождатьсяЗакрытогоПрогона(ПулНазначения, Ид);
	Ожидаем.Что(Прогон.Получить("state"), "прогон закрыт завершением, а не ошибкой: "
		+ Строка(Прогон.Получить("status"))).Равно("завершён");
	Ожидаем.Что(Прогон.Получить("downloaded"), "привезены все три версии источника").Равно(3);
	Ожидаем.Что(Прогон.Получить("unavailable"), "ни одна версия не осталась недоступной").Равно(0);
	Ожидаем.Что(Прогон.Получить("crawl"), "первый обход полон").Равно("полный");

	Ожидаем.Что(ПротоколЗеркала(ПулНазначения, Ид),
		"хаб прочитал свой же пул срезом изменений и сказал это в карточке").Равно("openhub");
	Ожидаем.Что(ВерсииПулаНазначения(), "все версии легли в пул назначения")
		.Равно("1.0.0,1.1.0,2.0.0");
	Ожидаем.Что(СтрНайти(СписокВыдачи(ПулНазначения), ИмяПакета) > 0,
		"и пул назначения раздаёт привезённый пакет").ЭтоИстина();

КонецПроцедуры

#Область Помощники

// Адрес выдачи пула этого же хаба — ровно то, что администратор копирует из браузера.
Функция АдресВыдачиПула(Знач ИмяПула)
	Возврат СтрШаблон("http://127.0.0.1:%1/pools/%2/download/",
		Формат(Хаб.Порт(), "ЧГ=0; ЧН=0"), ИмяПула);
КонецФункции

Функция ЗавестиПул(Знач Имя)
	Возврат Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя), ТокенRoot);
КонецФункции

// Тело заведения без протокола: поле режима хаб отвергает, и это часть требования. Фильтр
// имён оставляет обходу ОДИН пакет — наш: в засеянном пуле источника живут и пакеты сидера,
// и их судьба к протоколу отношения не имеет.
Функция ЗавестиЗеркало(Знач ИмяПула, Знач Адрес)
	Возврат Клиент.ЗапросJSONСТокеном("POST",
		СтрШаблон("/api/v1/pools/%1/mirrors", ИмяПула),
		СтрШаблон("{""url"":""%1"",""фильтр"":""[\""%2\""]"",""интервал"":3600}",
			Адрес, ИмяПакета), ТокенRoot);
КонецФункции

Функция ЗапроситьСинк(Знач ИмяПула, Знач Ид)
	Возврат Клиент.ЗапросJSONСТокеном("POST",
		СтрШаблон("/api/v1/pools/%1/mirrors/%2/sync", ИмяПула, Ид), "", ТокенRoot);
КонецФункции

Функция КарточкаЗеркала(Знач ИмяПула, Знач Ид)
	Возврат Клиент.ТелоJSON(Клиент.GETСТокеном(
		СтрШаблон("/api/v1/pools/%1/mirrors/%2", ИмяПула, Ид), ТокенRoot)).Получить("mirror");
КонецФункции

Функция ПротоколЗеркала(Знач ИмяПула, Знач Ид)
	Возврат Строка(КарточкаЗеркала(ИмяПула, Ид).Получить("protocol"));
КонецФункции

// Репликацию ведёт фоновый рабочий, поэтому прогон ждём по состоянию, а не по таймеру:
// «поставлено» и «идёт» — ещё не итог.
Функция ДождатьсяЗакрытогоПрогона(Знач ИмяПула, Знач Ид)

	Последний = Неопределено;
	Для Попытка_ = 1 По 120 Цикл
		Последний = КарточкаЗеркала(ИмяПула, Ид).Получить("run");
		Состояние = Строка(Последний.Получить("state"));
		Если Состояние = "завершён" ИЛИ Состояние = "ошибка" Тогда
			Возврат Последний;
		КонецЕсли;
		Приостановить(1000);
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Прогон зеркала не закрылся за 120 с, последнее состояние: %1",
		?(Последний = Неопределено, "нет карточки", Строка(Последний.Получить("state"))));

КонецФункции

Функция ВерсииПулаНазначения()

	Ответ = Клиент.GETСТокеном(СтрШаблон("/api/v1/pools/%1/packages/%2/versions",
		ПулНазначения, ИмяПакета), ТокенRoot);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат "пакета в пуле нет: " + Формат(Ответ.КодСостояния, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Найденные = Новый Массив();
	Для Каждого Версия Из Клиент.ТелоJSON(Ответ).Получить("versions") Цикл
		Найденные.Добавить(Строка(Версия.Получить("version")));
	КонецЦикла;
	Возврат СтрСоединить(Найденные, ",");

КонецФункции

Функция СписокВыдачи(Знач ИмяПула)
	Возврат Клиент.Тело(Клиент.GET(СтрШаблон("/pools/%1/download/list.txt", ИмяПула)));
КонецФункции

Процедура Опубликовать(Знач ИмяПула, Знач Пакет, Знач Версия)

	Ответ = Публикация(СтрШаблон("/api/v1/pools/%1/packages/%2/versions", ИмяПула, Пакет),
		OspxДанные(Пакет, Версия), Пакет + "-" + Версия + ".ospx", ТокенRoot);
	Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Публикация ""%1"" %2 не удалась: %3 %4",
			Пакет, Версия, Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

КонецПроцедуры

Функция OspxДанные(Знач Пакет, Знач Версия)

	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Возврат Новый ДвоичныеДанные(
		Новый ФикстураПакета().ПостроитьOspx(Каталог, Пакет, Версия, "# " + Пакет));

КонецФункции

Функция Публикация(Знач Путь, Знач Данные, Знач ИмяФайла, Знач Токен)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ВыпуститьPAT(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;
	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

КонецФункции

#КонецОбласти
