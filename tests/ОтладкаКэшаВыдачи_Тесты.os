// Отладка кэша выдачи на живом хабе: корневой OSHUB_LOG_LEVEL=DEBUG открывает и строки хаба
// о решении кэша, и строки библиотеки кэша — разбор по одной консоли, без точечных уровней.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — запросы к подопытному хабу

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабНаОтладке() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 15);
	КаталогПроекта = Хаб.КаталогПроекта();

	Хаб.ФайловаяБаза("openhub-отладка-кэша");
	Хаб.Среда("OSHUB_LOG_LEVEL", "DEBUG");
	Хаб.Среда("OSHUB_SEED_FIXTURE",
		ОбъединитьПути(КаталогПроекта, "tests", "фикстуры", "spike0c-testpkg-0.1.0.ospx"));
	Хаб.Среда("OSHUB_SEED_VERSIONS", "1.0.0");
	Хаб.ЗапуститьСидер(ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьПакет.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

КонецПроцедуры

// Файловое хранилище кэшу не отдаётся, поэтому решение «мимо кэша» звучит на каждом скачивании:
// хаб называет причину, библиотека — свой промах. Корневой уровень доезжает до лога библиотеки.
&Тест
Процедура КорневаяОтладкаОткрываетСледКэшаХабаИБиблиотеки() Экспорт

	Скачиваний = 2;
	Для Номер = 1 По Скачиваний Цикл
		Ответ = Клиент.GET("/api/v1/pools/public/download/spike0c-testpkg/spike0c-testpkg-1.0.0.ospx");
		Ожидаем.Что(Ответ.КодСостояния, "выдача отдаёт файл").Равно(200);
	КонецЦикла;

	Журнал = Хаб.Дамп();

	Ожидаем.Что(СтрЧислоВхождений(Журнал,
		"Мимо кэша артефактов: public/spike0c-testpkg/spike0c-testpkg-1.0.0.ospx — хранилище не удалённое (бэкенд fs)"),
		"хаб называет решение кэша и его причину на каждом скачивании").Равно(Скачиваний);
	Ожидаем.Что(СтрЧислоВхождений(Журнал, "Выдача: тело spike0c-testpkg-1.0.0.ospx — мимо кэша, из хранилища,"),
		"резолвер называет, откуда тело и сколько его, на каждом скачивании").Равно(Скачиваний);
	Ожидаем.Что(Журнал, "библиотека кэша слышит корневой уровень: её промах в консоли")
		.Содержит("Кэш ""артефакты"": промах, ключ");

КонецПроцедуры
