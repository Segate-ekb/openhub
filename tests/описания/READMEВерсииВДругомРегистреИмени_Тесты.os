// README версии, присланной с именем пакета в другом регистре, на регистрозависимом хранилище: S3 над
// фейком корзины различает ключи по регистру, как S3 и диск Linux. Контейнер ОСени на КоннекторInMemory;
// отдельный процесс.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать oscript-md
#Использовать ospx-tools
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Засев;         // фикстура ЗасевРеестра — пул и пакет службами хаба

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогМодулей = КаталогиПроекта.Модули();

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(КаталогМодулей, "вход, права");
	ПоискКлассов.ПодключитьРеализации(КаталогМодулей, "ПоследствияУдаленияПакета");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"));
	РеестрНастроекХаба.ПодключитьКлассы(ПоискКлассов, КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"));

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	// хранилище контейнера — S3 над фейком корзины: своя фабрика модуля и боевой клиент не нужны
	Для Каждого Файл Из ПоискКлассов.ФайлыКлассов(ОбъединитьПути(КаталогМодулей, "хранилище", "Классы")) Цикл
		Если Файл.ИмяБезРасширения <> "КонфигурацияХранилища" И Файл.ИмяБезРасширения <> "КлиентS3Oint" Тогда
			ПоискКлассов.ПодключитьФайл(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	РеестрФикстур.Подключить("ФейкКлиентS3");
	РеестрФикстур.Подключить("ХранилищеНаФейкеS3");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "статистика", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"), "ГотовностьХаба");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "поиск", "Классы"));

	ПоискКлассов.Подключить(КаталогМодулей, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогМодулей, "СобытиеАудита");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "УчёткаПринципала");
	ПоискКлассов.Подключить(КаталогМодулей, "ВердиктГварда");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");

	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	РеестрФикстур.Подключить("ФейкСодержимогоGitHub");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "описания", "Классы"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.backend", "s3");
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "readme-регистр-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);

КонецПроцедуры

// Ради чего всё: пакет заведён как MyPkg, следующую версию прислали с mypkg в манифесте —
// вкладка «Описание» этой версии показывает её README, а не «У этой версии нет README».
&Тест
Процедура READMEВерсииСИменемВДругомРегистреВидноНаСтранице() Экспорт

	Пакет = НовыйПакет();

	Первая = Опубликовать(Пакет, Пакет.Пакет.Имя, "1.0.0", "# МаркерПервой");
	Вторая = Опубликовать(Пакет, НРег(Пакет.Пакет.Имя), "1.1.0", "# МаркерВторой");

	Ожидаем.Что(Вторая.Пакет.Имя, "самотест: имя в реестре осталось с первой публикации")
		.Равно(Пакет.Пакет.Имя);

	Показ = Представление(Вторая);
	Ожидаем.Что(Показ.ЕстьREADME, "README версии, присланной в другом регистре, найден").ЭтоИстина();
	Ожидаем.Что(Показ.HTML, "и показан свой").Содержит("МаркерВторой");
	Ожидаем.Что(Представление(Первая).HTML, "первая версия при этом своя").Содержит("МаркерПервой");

КонецПроцедуры

// Уборка пакета снимает описание версии, присланной в другом регистре: в корзине не остаётся
// ничьих описаний.
&Тест
Процедура УборкаСнимаетREADMEВерсииСИменемВДругомРегистре() Экспорт

	Пакет = НовыйПакет();
	Принятое = Опубликовать(Пакет, ВРег(Пакет.Пакет.Имя), "1.0.0", "# Уйдёт с пакетом");
	Префикс = СтрШаблон("pools/%1/", Пакет.Пул.Имя);
	Ожидаем.Что(ОписанийВКорзине(Префикс), "самотест: описание легло").Равно(1);

	Поделка.НайтиЖелудь("УборкаПакета").УдалитьПакет(Принятое.Пакет);

	Ожидаем.Что(ОписанийВКорзине(Префикс), "описание снято вместе с пакетом").Равно(0);

КонецПроцедуры

#Область Помощники

// Имя в смешанном регистре: нижний и верхний регистр дают другую строку.
Функция НовыйПакет()

	Ключ = УникальныеИмена.Хвост();
	Пул = Засев.ПулСервисом("readme-case-" + Ключ);
	Пакет = Засев.ПакетСервисом(Пул.Идентификатор, "MyPkg-" + Ключ,
		Новый Структура("Описание, АдресРепозитория", "Пакет с именем в смешанном регистре",
			"https://example.org/acme/mypkg"));
	Возврат Новый Структура("Пул, Пакет", Пул, Пакет);

КонецФункции

// Публикация — то ядро, через которое проходит opm push; имя — как в манифесте присланного пакета.
Функция Опубликовать(Знач Пакет, Знач ИмяИзМанифеста, Знач Версия, Знач ТекстREADME)

	Артефакт = Новый Структура("Размер, Sha256", 0, "");
	Принятое = Поделка.НайтиЖелудь("ПриёмВерсии").ПринятьПубликацию(Пакет.Пул, ИмяИзМанифеста, Версия,
		Неопределено, Артефакт, 0, Ложь, Ложь, ТекстREADME);
	Принятое.Вставить("Пул", Пакет.Пул);
	Возврат Принятое;

КонецФункции

// Страница пакета зовёт службу с пакетом и версией из реестра.
Функция Представление(Знач Принятое)
	Возврат Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(Принятое.Пул, Принятое.Пакет,
		Принятое.Версия);
КонецФункции

Функция ОписанийВКорзине(Знач Префикс)

	Счёт = 0;
	Для Каждого Объект Из Поделка.НайтиЖелудь("КлиентS3Набора").Перечислить(Префикс) Цикл
		Если СтрЗаканчиваетсяНа(Объект.Ключ, ".readme.md") Тогда
			Счёт = Счёт + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счёт;

КонецФункции

#КонецОбласти
