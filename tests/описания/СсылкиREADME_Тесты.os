// Относительные адреса README — в файлы репозитория пакета: адрес репозитория из карточки
// (GitHub, GitLab, Gitea, Bitbucket, похожие на GitHub), страница файла и сам файл, разрешение
// ссылок и картинок отрисованного README и его безопасность; отдельный процесс.

#Использовать asserts
#Использовать "../фикстуры"

Перем Адреса;     // АдресаРепозитория
Перем Ссылки;     // СсылкиREADME
Перем Рендерер;   // РендерерREADME

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();
	КаталогМодулей = КаталогиПроекта.Модули();
	Для Каждого Имя Из СтрРазделить("КонтрольСимволов,РазборАдреса,РендерерREADME,АдресаРепозитория,СсылкиREADME", ",") Цикл
		Поиск.Подключить(КаталогМодулей, Имя);
	КонецЦикла;

	Рендерер = Новый РендерерREADME();
	Адреса = Новый АдресаРепозитория(Новый РазборАдреса());
	Ссылки = Новый СсылкиREADME(Адреса, Рендерер);

КонецПроцедуры

#Область АдресРепозитория

// Адрес из карточки и адрес клона приводятся к одной базе: так пишут репозиторий в packagedef.
&Тест
Процедура АдресРепозиторияGitHubВЛюбойЗаписиДаётОднуБазу() Экспорт

	Для Каждого Адрес Из СтрРазделить("https://github.com/acme/lib|https://github.com/acme/lib.git|"
		+ "https://github.com/acme/lib/|http://github.com/acme/lib|https://www.github.com/acme/lib|"
		+ "git@github.com:acme/lib.git|ssh://git@github.com/acme/lib.git|git://github.com/acme/lib.git|"
		+ "git+https://github.com/acme/lib.git|https://github.com/acme/lib/issues?q=1#x", "|") Цикл

		Репозиторий = Адреса.Разобрать(Адрес);
		Ожидаем.Что(Репозиторий <> Неопределено, Адрес + " — репозиторий").ЭтоИстина();
		Ожидаем.Что(Репозиторий.Вид, Адрес).Равно("github");
		Ожидаем.Что(Репозиторий.База, Адрес).Равно("https://github.com/acme/lib");
		Ожидаем.Что(Репозиторий.Реф.Имя, Адрес + " — ветка по умолчанию").Равно("HEAD");
		Ожидаем.Что(Репозиторий.Каталог, Адрес + " — корень").Равно("");

	КонецЦикла;

КонецПроцедуры

// Адрес внутри дерева называет реф и каталог пакета в репозитории; адрес файла — каталог, где он лежит.
&Тест
Процедура АдресВнутриДереваНазываетРефИКаталог() Экспорт

	ПроверитьРазбор("https://github.com/acme/mono/tree/develop/packages/lib", "github",
		"https://github.com/acme/mono", "develop", "branch", "packages/lib");
	ПроверитьРазбор("https://github.com/acme/mono/blob/main/packages/lib/README.md", "github",
		"https://github.com/acme/mono", "main", "branch", "packages/lib");
	ПроверитьРазбор("https://gitlab.example.ru/team/mono/-/tree/main/lib", "gitlab",
		"https://gitlab.example.ru/team/mono", "main", "branch", "lib");
	ПроверитьРазбор("https://git.example.ru/acme/mono/src/tag/v1.0/%D0%BF%D0%B0%D0%BA%D0%B5%D1%82", "gitea",
		"https://git.example.ru/acme/mono", "v1.0", "tag", "пакет");

КонецПроцедуры

// Каталог из адреса раскодируется до разбора точек: «%2F..» поднимается внутри репозитория, а выше
// его корня адрес — не репозиторий (см. НеАдресРепозиторияНеРазбирается).
&Тест
Процедура ТочкиВКаталогеАдресаРазбираютсяПослеРаскодирования() Экспорт

	ПроверитьРазбор("https://github.com/acme/mono/tree/main/a%2Fb%2F..%2Fc/./d", "github",
		"https://github.com/acme/mono", "main", "branch", "a/c/d");

	HTML = Разрешённый("![к](img/a.png)", "https://github.com/acme/lib/tree/main/x%2F..%2F..%2Fevil");
	Ожидаем.Что(Картинка(HTML, "к"), "картинка не уходит в чужой репозиторий").Равно(Неопределено);

КонецПроцедуры

// Свой GitLab и Gitea часто живут без TLS — схема адреса сохраняется; публичным хостингам — https.
&Тест
Процедура СхемаСвоегоДоменаСохраняется() Экспорт

	ПроверитьРазбор("http://gitea.local:3000/acme/lib", "gitea", "http://gitea.local:3000/acme/lib", "HEAD", "branch", "");
	ПроверитьРазбор("http://gitlab.example.ru/team/lib", "gitlab", "http://gitlab.example.ru/team/lib", "HEAD", "branch", "");
	ПроверитьРазбор("http://gitlab.example.ru:80/team/lib", "gitlab", "http://gitlab.example.ru/team/lib", "HEAD", "branch", "");
	ПроверитьРазбор("http://codeberg.org/acme/lib", "gitea", "https://codeberg.org/acme/lib", "HEAD", "branch", "");
	ПроверитьРазбор("http://gitlab.com/team/lib", "gitlab", "https://gitlab.com/team/lib", "HEAD", "branch", "");
	ПроверитьРазбор("ssh://git@gitea.local:2222/acme/lib.git", "gitea", "https://gitea.local/acme/lib", "HEAD", "branch", "");

	Ожидаем.Что(Картинка(Разрешённый("![к](a.png)", "http://gitea.local:3000/acme/lib"), "к"))
		.Равно("http://gitea.local:3000/acme/lib/raw/branch/HEAD/a.png");

КонецПроцедуры

// GitLab: подгруппы делают путь репозитория длинным, свой домен узнаётся по имени хоста и по «/-/».
&Тест
Процедура GitLabСПодгруппамиИНаСвоёмДомене() Экспорт

	ПроверитьРазбор("https://gitlab.com/group/sub/project.git", "gitlab", "https://gitlab.com/group/sub/project",
		"HEAD", "branch", "");
	ПроверитьРазбор("ssh://git@gitlab.example.ru:2222/team/lib.git", "gitlab", "https://gitlab.example.ru/team/lib",
		"HEAD", "branch", "");
	ПроверитьРазбор("https://code.example.ru/team/sub/lib/-/blob/v2/README.md", "gitlab",
		"https://code.example.ru/team/sub/lib", "v2", "branch", "");

КонецПроцедуры

&Тест
Процедура GiteaForgejoИBitbucketУзнаютсяПоХосту() Экспорт

	ПроверитьРазбор("https://codeberg.org/acme/lib", "gitea", "https://codeberg.org/acme/lib", "HEAD", "branch", "");
	ПроверитьРазбор("https://gitea.example.ru:3000/acme/lib.git", "gitea", "https://gitea.example.ru:3000/acme/lib",
		"HEAD", "branch", "");
	ПроверитьРазбор("https://forgejo.example.ru/acme/lib", "gitea", "https://forgejo.example.ru/acme/lib",
		"HEAD", "branch", "");
	ПроверитьРазбор("https://bitbucket.org/acme/lib", "bitbucket", "https://bitbucket.org/acme/lib", "HEAD", "branch", "");

КонецПроцедуры

// Незнакомый хостинг — как GitHub, но только по https и только «владелец/имя»: в длинном пути
// не угадать, где кончается репозиторий.
&Тест
Процедура НезнакомыйХостингБерётсяТолькоКогдаЭтоОднозначно() Экспорт

	ПроверитьРазбор("https://git.example.ru/acme/lib", "github-like", "https://git.example.ru/acme/lib",
		"HEAD", "branch", "");
	ПроверитьРазбор("https://git.example.ru/acme/lib/tree/main/pkg", "github-like", "https://git.example.ru/acme/lib",
		"main", "branch", "pkg");

	Ожидаем.Что(Адреса.Разобрать("http://git.example.ru/acme/lib"), "без https").Равно(Неопределено);
	Ожидаем.Что(Адреса.Разобрать("https://git.example.ru/a/b/c"), "путь неоднозначен").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НеАдресРепозиторияНеРазбирается() Экспорт

	Для Каждого Адрес Из СтрРазделить("|   |javascript:alert(1)|data:text/html,x|ftp://github.com/acme/lib|"
		+ "https://github.com|https://github.com/acme|https://user:secret@github.com/acme/lib|"
		+ "https://github.com/acme/li%22b|https://github.com/../lib|https://exa_mple.ru/acme/lib|"
		+ "просто текст|https://gitlab.com/-/tree/main|"
		+ "https://github.com/acme/lib/tree/main/x%2F..%2F..%2F..%2F..%2Fevil%2Frepo", "|") Цикл
		Ожидаем.Что(Адреса.Разобрать(Адрес), "«" + Адрес + "» — не репозиторий").Равно(Неопределено);
	КонецЦикла;
	Ожидаем.Что(Адреса.Разобрать(Неопределено), "пустое поле карточки").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область АдресФайла

// Страница файла — то, что открывает ссылка; сам файл — то, что грузит картинка: у github.com он
// лежит на raw.githubusercontent.com, куда github.com/…/raw/… всё равно переадресует.
&Тест
Процедура СтраницаИСамФайлНаКаждомХостинге() Экспорт

	Путь = "docs/руководство пользователя.md";
	Закодированный = "docs/" + КодироватьСтроку("руководство пользователя", СпособКодированияСтроки.КодировкаURL) + ".md";

	ПроверитьФайл("https://github.com/acme/lib", Путь,
		"https://github.com/acme/lib/blob/HEAD/" + Закодированный,
		"https://raw.githubusercontent.com/acme/lib/HEAD/" + Закодированный);
	ПроверитьФайл("https://gitlab.com/group/sub/lib", Путь,
		"https://gitlab.com/group/sub/lib/-/blob/HEAD/" + Закодированный,
		"https://gitlab.com/group/sub/lib/-/raw/HEAD/" + Закодированный);
	ПроверитьФайл("https://codeberg.org/acme/lib", Путь,
		"https://codeberg.org/acme/lib/src/branch/HEAD/" + Закодированный,
		"https://codeberg.org/acme/lib/raw/branch/HEAD/" + Закодированный);
	ПроверитьФайл("https://bitbucket.org/acme/lib", Путь,
		"https://bitbucket.org/acme/lib/src/HEAD/" + Закодированный,
		"https://bitbucket.org/acme/lib/raw/HEAD/" + Закодированный);
	ПроверитьФайл("https://git.example.ru/acme/lib", Путь,
		"https://git.example.ru/acme/lib/blob/HEAD/" + Закодированный,
		"https://git.example.ru/acme/lib/raw/HEAD/" + Закодированный);

КонецПроцедуры

// Тег с метаданными сборки — один сегмент адреса; у Gitea тег отличается от ветки в самом пути.
&Тест
Процедура РефКодируетсяОднимСегментом() Экспорт

	GitHub = Адреса.Разобрать("https://github.com/acme/lib");
	Тег = Адреса.Реф("v1.0.0+build", "tag");
	Ожидаем.Что(Адреса.СтраницаФайла(GitHub, Тег, "a.md")).Равно("https://github.com/acme/lib/blob/v1.0.0%2Bbuild/a.md");

	Gitea = Адреса.Разобрать("https://codeberg.org/acme/lib");
	Ожидаем.Что(Адреса.СыройФайл(Gitea, Тег, "a.png")).Равно("https://codeberg.org/acme/lib/raw/tag/v1.0.0%2Bbuild/a.png");

КонецПроцедуры

#КонецОбласти

#Область Разрешение

// Ради чего всё: ссылка на документ рядом с README и картинка из репозитория открываются там, где
// они лежат, — в репозитории, а не на хабе.
&Тест
Процедура СсылкаИКартинкаВедутВРепозиторий() Экспорт

	HTML = Разрешённый("[Руководство](docs/test.md) ![Схема](img/scheme.png)", "https://github.com/acme/lib");

	Ожидаем.Что(Адрес(HTML, "Руководство")).Равно("https://github.com/acme/lib/blob/HEAD/docs/test.md");
	Ожидаем.Что(Картинка(HTML, "Схема")).Равно("https://raw.githubusercontent.com/acme/lib/HEAD/img/scheme.png");
	Ожидаем.Что(HTML, "ссылка в репозиторий — внешняя").Содержит("rel=""nofollow noopener""");

КонецПроцедуры

// Таблица случаев пути: «./», «..» внутри репозитория, «/» от корня, якорь и запрос у файла,
// пробел и кириллица в имени.
&Тест
Процедура ПутиСчитаютсяОтКаталогаREADME() Экспорт

	База = "https://github.com/acme/mono/blob/main/";
	Случаи = Новый Соответствие();
	Случаи.Вставить("docs/test.md", База + "pkg/docs/test.md");
	Случаи.Вставить("./docs/test.md", База + "pkg/docs/test.md");
	Случаи.Вставить("../shared/a.md", База + "shared/a.md");
	Случаи.Вставить("/LICENSE", База + "LICENSE");
	Случаи.Вставить("docs/test.md#раздел", База + "pkg/docs/test.md#" + Закодировать("раздел"));
	Случаи.Вставить("docs/a.md?plain=1", База + "pkg/docs/a.md?plain=1");
	Случаи.Вставить("<docs/my file.md>", База + "pkg/docs/my%20file.md");
	Случаи.Вставить("docs/руководство.md", База + "pkg/docs/" + Закодировать("руководство") + ".md");
	Случаи.Вставить("docs/a%2Bb.md", База + "pkg/docs/a%2Bb.md");

	Для Каждого Случай Из Случаи Цикл
		HTML = Разрешённый("[т](" + Случай.Ключ + ")", "https://github.com/acme/mono/tree/main/pkg");
		Ожидаем.Что(Адрес(HTML, "т"), Случай.Ключ).Равно(Случай.Значение);
	КонецЦикла;

КонецПроцедуры

// «..» выше корня репозитория не уводит ни за репозиторий, ни на хаб: ссылка остаётся текстом.
&Тест
Процедура ПутьВышеКорняНеВыводитЗаРепозиторий() Экспорт

	HTML = Разрешённый("[выше](../../etc/passwd) [ещё](pkg/../../x.md) ![к](../logo.png)", "https://github.com/acme/lib");

	Ожидаем.Что(ЕстьСсылка(HTML, "выше"), "ссылки нет").ЭтоЛожь();
	Ожидаем.Что(ЕстьСсылка(HTML, "ещё"), "ссылки нет").ЭтоЛожь();
	Ожидаем.Что(HTML, "текст ссылки на месте").Содержит("<p>выше ещё");
	Ожидаем.Что(Картинка(HTML, "к"), "картинке грузить нечего").Равно(Неопределено);
	Ожидаем.Что(HTML, "подпись картинки на месте").Содержит("alt=""к""");

КонецПроцедуры

// Ссылка без места в репозитории снимается, а картинка внутри неё разрешается как обычно.
&Тест
Процедура КартинкаВнутриСнятойСсылкиОстаётся() Экспорт

	HTML = Разрешённый("[![Значок](img/badge.svg)](../../out.md) [дальше](docs/a.md)", "https://github.com/acme/lib");

	Ожидаем.Что(СтрНайти(HTML, "out.md"), "ссылки за репозиторий нет").Равно(0);
	Ожидаем.Что(Картинка(HTML, "Значок")).Равно("https://raw.githubusercontent.com/acme/lib/HEAD/img/badge.svg");
	Ожидаем.Что(Адрес(HTML, "дальше"), "соседняя ссылка цела").Равно("https://github.com/acme/lib/blob/HEAD/docs/a.md");

КонецПроцедуры

// Не путь в репозитории — не трогается: абсолютные адреса, «//хост», почта, якорь и запрос страницы.
&Тест
Процедура АбсолютныеАдресаИЯкорьОстаютсяКакБыли() Экспорт

	Текст = "[абс](https://example.ru/x.md) [хост](//cdn.example.ru/a.png) [почта](mailto:a@example.ru) "
		+ "[якорь](#установка) [запрос](?tab=deps) ![карт](https://example.ru/a.png)";
	Исходный = Рендерер.ВБезопасныйHTML(Текст);

	Ожидаем.Что(Ссылки.ВРепозиторий(Исходный, "https://github.com/acme/lib", Неопределено),
		"разметка та же байт в байт").Равно(Исходный);
	Ожидаем.Что(Ссылки.ВРепозиторий(Исходный, "", Неопределено), "и без репозитория").Равно(Исходный);

КонецПроцедуры

// README из репозитория лежит в его корне на рефе, где найден: ссылки — на тот же тег, каталог из
// адреса карточки здесь не в счёт.
&Тест
Процедура READMEИзРепозиторияСсылаетсяНаСвойТег() Экспорт

	Источник = Новый Структура("Вид, Реф", "tag", "v1.2.0");
	HTML = Ссылки.ВРепозиторий(Рендерер.ВБезопасныйHTML("[д](docs/a.md) ![к](img/a.png)"),
		"https://github.com/acme/mono/tree/main/pkg", Источник);

	Ожидаем.Что(Адрес(HTML, "д")).Равно("https://github.com/acme/mono/blob/v1.2.0/docs/a.md");
	Ожидаем.Что(Картинка(HTML, "к")).Равно("https://raw.githubusercontent.com/acme/mono/v1.2.0/img/a.png");

	ИзВетки = Ссылки.ВРепозиторий(Рендерер.ВБезопасныйHTML("[д](docs/a.md)"), "https://github.com/acme/lib",
		Новый Структура("Вид, Реф", "default_branch", "HEAD"));
	Ожидаем.Что(Адрес(ИзВетки, "д")).Равно("https://github.com/acme/lib/blob/HEAD/docs/a.md");

КонецПроцедуры

// Без репозитория файлов README нигде нет: ссылка не ведёт на несуществующую страницу хаба,
// картинка не стучится в хаб — остаются текст и подпись.
&Тест
Процедура БезРепозиторияОтносительныйАдресСнимается() Экспорт

	Для Каждого Репозиторий Из СтрРазделить("|http://git.example.ru/acme/lib|https://example.ru", "|") Цикл

		HTML = Разрешённый("[Руководство](docs/test.md) ![Схема](img/scheme.png) [Сайт](https://example.ru)", Репозиторий);

		Ожидаем.Что(ЕстьСсылка(HTML, "Руководство"), Репозиторий + ": ссылки нет").ЭтоЛожь();
		Ожидаем.Что(HTML, Репозиторий + ": текст ссылки остался").Содержит("<p>Руководство <img");
		Ожидаем.Что(Картинка(HTML, "Схема"), Репозиторий + ": картинке грузить нечего").Равно(Неопределено);
		Ожидаем.Что(HTML, Репозиторий + ": подпись картинки осталась").Содержит("alt=""Схема""");
		Ожидаем.Что(Адрес(HTML, "Сайт"), Репозиторий + ": абсолютная на месте").Равно("https://example.ru");

	КонецЦикла;

КонецПроцедуры

// Второй проход санитайзера ничего, кроме переписанного адреса, не меняет: блок кода с кавычками и
// амперсандом, таблица с выравниванием, задачи, зачёркивание и автоссылка — байт в байт.
&Тест
Процедура ВторойПроходСанитайзераМеняетТолькоАдрес() Экспорт

	ПС = Символы.ПС;
	Исходный = Рендерер.ВБезопасныйHTML("# Пакет" + ПС + ПС
		+ "| Ключ | Число |" + ПС + "| --- | ---: |" + ПС + "| `a & b` | 1 |" + ПС + ПС
		+ "- [x] сделано" + ПС + "- [ ] в работе" + ПС + ПС
		+ "~~было~~ https://example.ru/x?a=1&b=2 [док](docs/a.md ""Заголовок 'в' кавычках"")" + ПС + ПС
		+ "```bsl" + ПС + "А = ""<b>"" + '&amp;' + Символ(39);" + ПС + "```");

	Ожидаем.Что(Исходный, "самотест: адрес относительный").Содержит(" href=""docs/a.md""");
	// ссылка стала внешней — санитайзер дописывает ей rel последним атрибутом
	Ожидаемое = СтрЗаменить(Исходный, " href=""docs/a.md""", " href=""https://github.com/acme/lib/blob/HEAD/docs/a.md""");
	Ожидаемое = СтрЗаменить(Ожидаемое, "кавычках"">док", "кавычках"" rel=""nofollow noopener"">док");
	Ожидаем.Что(Ссылки.ВРепозиторий(Исходный, "https://github.com/acme/lib", Неопределено)).Равно(Ожидаемое);

КонецПроцедуры

// Разметка без относительных адресов второй раз санитайзер не проходит и не меняется.
&Тест
Процедура БезОтносительныхАдресовРазметкаНеМеняется() Экспорт

	Исходный = Рендерер.ВБезопасныйHTML("# Пакет" + Символы.ПС + Символы.ПС + "```bsl" + Символы.ПС
		+ "А = ""<b>"" + '&';" + Символы.ПС + "```");
	Ожидаем.Что(Ссылки.ВРепозиторий(Исходный, "https://github.com/acme/lib", Неопределено)).Равно(Исходный);
	Ожидаем.Что(Ссылки.ВРепозиторий("", "https://github.com/acme/lib", Неопределено)).Равно("");

КонецПроцедуры

#КонецОбласти

#Область Безопасность

// Схема-скрипт санитайзер снял до разрешения; закодированная или спрятанная за «./» — всего лишь
// имя файла в репозитории и уходит туда же, а не в браузер скриптом.
&Тест
Процедура СкриптВАдресеНеОживает() Экспорт

	HTML = НРег(Разрешённый("[а](javascript:alert(1)) [б](javascript%3Aalert(1)) [в](./javascript:alert(1)) "
		+ "![г](data:image/svg+xml;base64,PHN2Zz4=) [д](java&#09;script:alert(1))", "https://github.com/acme/lib"));

	Ожидаем.Что(СтрНайти(HTML, "href=""javascript"), "ни одной ссылки со схемой-скриптом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "src=""data:"), "ни одной картинки data:").Равно(0);
	Ожидаем.Что(HTML, "закодированное — файл в репозитории")
		.Содержит("href=""https://github.com/acme/lib/blob/head/javascript%3aalert%281%29""");

КонецПроцедуры

// Кавычка в хвосте адреса не закрывает атрибут: новый адрес печатается экранированным, и разметка
// после разрешения ещё раз проходит санитайзер — на случай, если до него дошло лишнее.
&Тест
Процедура РазрешённыйАдресПроходитСанитайзер() Экспорт

	Вписанное = "<p><a href=""docs/a.md#&quot; onclick=&quot;alert(1)"">т</a><script>alert(2)</script></p>";
	HTML = НРег(Ссылки.ВРепозиторий(Вписанное, "https://github.com/acme/lib", Неопределено));

	Ожидаем.Что(СтрНайти(HTML, " onclick="""), "обработчик не стал атрибутом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<script"), "второй проход санитайзера снял скрипт").Равно(0);
	Ожидаем.Что(HTML, "адрес в репозиторий на месте").Содержит("href=""https://github.com/acme/lib/blob/head/docs/a.md#");

КонецПроцедуры

#КонецОбласти

#Область Помощники

Процедура ПроверитьРазбор(Знач Адрес, Знач Вид, Знач База, Знач Реф, Знач ВидРефа, Знач Каталог)

	Репозиторий = Адреса.Разобрать(Адрес);
	Ожидаем.Что(Репозиторий <> Неопределено, Адрес + " — репозиторий").ЭтоИстина();
	Ожидаем.Что(Репозиторий.Вид, Адрес).Равно(Вид);
	Ожидаем.Что(Репозиторий.База, Адрес).Равно(База);
	Ожидаем.Что(Репозиторий.Реф.Имя, Адрес + " — реф").Равно(Реф);
	Ожидаем.Что(Репозиторий.Реф.Вид, Адрес + " — вид рефа").Равно(ВидРефа);
	Ожидаем.Что(Репозиторий.Каталог, Адрес + " — каталог").Равно(Каталог);

КонецПроцедуры

Процедура ПроверитьФайл(Знач Адрес, Знач Путь, Знач Страница, Знач Сырой)

	Репозиторий = Адреса.Разобрать(Адрес);
	Ожидаем.Что(Адреса.СтраницаФайла(Репозиторий, Репозиторий.Реф, Путь), Адрес + " — страница").Равно(Страница);
	Ожидаем.Что(Адреса.СыройФайл(Репозиторий, Репозиторий.Реф, Путь), Адрес + " — файл").Равно(Сырой);

КонецПроцедуры

Функция Разрешённый(Знач Markdown, Знач Репозиторий)
	Возврат Ссылки.ВРепозиторий(Рендерер.ВБезопасныйHTML(Markdown), Репозиторий, Неопределено);
КонецФункции

Функция ЕстьСсылка(Знач HTML, Знач Текст)
	Возврат СтрНайти(HTML, ">" + Текст + "</a>") > 0;
КонецФункции

// href ссылки с этим текстом; Неопределено — ссылка есть, а адреса у неё нет.
Функция Адрес(Знач HTML, Знач Текст)

	Найденное = Новый РегулярноеВыражение("<a( href=""([^""]*)"")?[^>]*>" + Текст + "</a>").НайтиСовпадения(HTML);
	Ожидаем.Что(Найденное.Количество(), "ссылка «" + Текст + "» в разметке: " + HTML).Равно(1);
	Значение = Найденное[0].Группы[2].Значение;
	Возврат ?(ЗначениеЗаполнено(Значение), СтрЗаменить(Значение, "&amp;", "&"), Неопределено);

КонецФункции

// src картинки с этой подписью; Неопределено — картинка есть, а грузить ей нечего.
Функция Картинка(Знач HTML, Знач Подпись)

	Найденное = Новый РегулярноеВыражение("<img( src=""([^""]*)"")? alt=""" + Подпись + """").НайтиСовпадения(HTML);
	Ожидаем.Что(Найденное.Количество(), "картинка «" + Подпись + "» в разметке: " + HTML).Равно(1);
	Значение = Найденное[0].Группы[2].Значение;
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Неопределено);

КонецФункции

Функция Закодировать(Знач Сегмент)
	Возврат КодироватьСтроку(Сегмент, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
