// Событие «описание версии изменено»: его даёт справка, с которой README из репозитория появился
// или пропал; справка «не найдено» вместо «не спрашивали», запись описания из пакета и снятие его не дают.

#Использовать asserts
#Использовать autumn-logos
#Использовать tempfiles
#Использовать "../фикстуры"

Перем Хранилище;   // ФайловоеХранилище во временном каталоге
Перем Издатель;    // ИздательСобытий
Перем Слушатель;   // ЗаписывающийПодписчик
Перем Описания;    // ХранилищеREADME

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	Классы = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Классы.ПодключитьОснову(Модули);
	Классы.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы", "квота"));
	Для Каждого Имя Из СтрРазделить("ФайловоеХранилище,РаскладкаФайловХранилища,"
		+ "ПомощникАртефакта,КоординатыАртефакта,ТипСодержимогоАртефакта", ",") Цикл
		Классы.Подключить(ОбъединитьПути(Модули, "хранилище", "Классы"), Имя);
	КонецЦикла;
	Классы.Подключить(ОбъединитьПути(Модули, "описания", "Классы"), "ХранилищеREADME");
	Классы.Подключить(ОбъединитьПути(Модули, "описания", "Классы"), "КоординатыREADME");
	Классы.Подключить(ОбъединитьПути(Модули, "события", "Классы"), "ИздательСобытий");

	Хранилище = Новый ФайловоеХранилище(ВременныеФайлы.СоздатьКаталог());

КонецПроцедуры

&ПередКаждым
Процедура СобратьДверь() Экспорт

	Издатель = Новый ИздательСобытий();
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипОписаниеВерсииИзменено(), Слушатель);
	Описания = Новый ХранилищеREADME(Хранилище, Логирование.ПолучитьЛог("тест.oshub.описания.событие"),
		, , Издатель);

КонецПроцедуры

&Тест
Процедура НайденныйREADMEИзРепозиторияДаётСобытиеСВерсией() Экспорт

	Версия = НоваяВерсия();
	Описания.Записать(Версия.Пул, Версия.Пакет, Версия.Версия, "");

	Описания.ЗаписатьСправку(Версия.Пул, Версия.Пакет, Версия.Версия, Справка(Истина));

	Ожидаем.Что(Слушатель.Количество(), "README появился — событие одно").Равно(1);
	Данные = Слушатель.Первое(Издатель.ТипОписаниеВерсииИзменено()).Данные;
	Ожидаем.Что(Данные.Пул, "пул").Равно(Версия.Пул);
	Ожидаем.Что(Данные.Пакет, "пакет").Равно(Версия.Пакет);
	Ожидаем.Что(Данные.Версия, "версия").Равно(Версия.Версия);

КонецПроцедуры

&Тест
Процедура НенайденныйПослеНеспрошенногоСобытияНеДаёт() Экспорт

	Версия = НоваяВерсия();
	Описания.Записать(Версия.Пул, Версия.Пакет, Версия.Версия, "");

	Описания.ЗаписатьСправку(Версия.Пул, Версия.Пакет, Версия.Версия, Справка(Ложь));
	Описания.ЗаписатьСправку(Версия.Пул, Версия.Пакет, Версия.Версия, Справка(Ложь));

	Ожидаем.Что(Слушатель.Количество(), "страница как была без README — событий нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПропавшийREADMEИзРепозиторияДаётСобытие() Экспорт

	Версия = НоваяВерсия();
	Описания.ЗаписатьСправку(Версия.Пул, Версия.Пакет, Версия.Версия, Справка(Истина));

	Описания.ЗаписатьСправку(Версия.Пул, Версия.Пакет, Версия.Версия, Справка(Ложь));

	Ожидаем.Что(Слушатель.Количество(), "появился и пропал — два события").Равно(2);

КонецПроцедуры

&Тест
Процедура ЗаписьИСнятиеОписанияСобытияНеДают() Экспорт

	Версия = НоваяВерсия();
	Описания.Записать(Версия.Пул, Версия.Пакет, Версия.Версия, "# Из пакета");
	Описания.Снять(Версия.Пул, Версия.Пакет, Версия.Версия);

	Ожидаем.Что(Слушатель.Количество(), "за ними идут события публикации, синка и удаления").Равно(0);

КонецПроцедуры

Функция НоваяВерсия()
	Хвост = Строка(Новый УникальныйИдентификатор());
	Возврат Новый Структура("Пул, Пакет, Версия", "pool-" + Лев(Хвост, 8), "pkg-" + Прав(Хвост, 8), "1.0.0");
КонецФункции

Функция Справка(Знач Найдено)
	Справка = Новый Структура("Репозиторий, Спрошено, Найдено, Вид, Реф, Ссылка, Текст");
	Справка.Репозиторий = "https://github.com/acme/lib";
	Справка.Спрошено = ТекущаяУниверсальнаяДата();
	Справка.Найдено = Найдено;
	Справка.Вид = ?(Найдено, "tag", "");
	Справка.Реф = ?(Найдено, "v1.0.0", "");
	Справка.Ссылка = ?(Найдено, "https://github.com/acme/lib/blob/v1.0.0/README.md", "");
	Справка.Текст = ?(Найдено, "# Из репозитория", "");
	Возврат Справка;
КонецФункции
