// README версии из репозитория пакета на GitHub, когда в пакете его нет: фоном после публикации
// и ночным обходом, с тега либо из ветки по умолчанию, не чаще раза в сутки; GitHub — фейк
// сырого содержимого, контейнер ОСени на КоннекторInMemory; отдельный процесс.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать oscript-md
#Использовать ospx-tools
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Засев;         // фикстура ЗасевРеестра — пул и пакет службами хаба
Перем GitHub;        // фикстура ФейкСодержимогоGitHub — сырое содержимое репозиториев
Перем Фикстура;      // фикстура ФикстураПакета — опасный README
Перем КореньХранилища;
Перем Переопубликовать; // Структура: Пакет, Версия, Текст — что публикует вклинившийся автор

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогМодулей = КаталогиПроекта.Модули();

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(КаталогМодулей, "вход, права");
	ПоискКлассов.ПодключитьРеализации(КаталогМодулей, "ПоследствияУдаленияПакета");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"));
	РеестрНастроекХаба.ПодключитьКлассы(ПоискКлассов, КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"));

	РеестрФикстур.Подключить("СоседиРеестра");
	РеестрФикстур.Подключить("ФейкКлиентS3");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "статистика", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"), "ГотовностьХаба");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "поиск", "Классы"));

	ПоискКлассов.Подключить(КаталогМодулей, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогМодулей, "СобытиеАудита");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "УчёткаПринципала");
	ПоискКлассов.Подключить(КаталогМодулей, "ВердиктГварда");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");

	// фон публикации — в потоке теста: README из репозитория виден сразу после приёма версии
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	// GitHub — фейк сырого содержимого; ожидание служебного запроса — как у хаба
	РеестрФикстур.Подключить("ФейкСодержимогоGitHub");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "описания", "Классы"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	РеестрФикстур.Подключить("ФикстураПакета");
	Фикстура = Новый ФикстураПакета();

	КореньХранилища = УникальныеИмена.ВременныйКаталог("openhub-readme-repo");

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "readme-repo-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	GitHub = Поделка.НайтиЖелудь("ФейкСодержимогоGitHub");

КонецПроцедуры

&ПослеВсех
Процедура УбратьКорень() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

&ПередКаждым
Процедура СброситьGitHub() Экспорт
	GitHub.Сбросить();
КонецПроцедуры

#Область Найден

// Ради чего всё: пакет без README, у пакета репозиторий на GitHub, на теге версии README есть —
// страница показывает его тем же безопасным путём и называет тег ссылкой на файл.
&Тест
Процедура READMEБезПакетаБерётсяСТегаВерсии() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.2.0/README.md", "# С тега" + Символы.ПС + Символы.ПС + "Текст.");
	Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib"), "1.2.0", "");

	Показ = Представление(Принятое);

	Ожидаем.Что(Показ.ЕстьREADME, "README из репозитория показан").ЭтоИстина();
	Ожидаем.Что(НРег(Показ.HTML), "и отрендерен").Содержит("<h1");
	Ожидаем.Что(Показ.HTML).Содержит("С тега");
	Ожидаем.Что(Показ.Источник <> Неопределено, "источник назван").ЭтоИстина();
	Ожидаем.Что(Показ.Источник.Вид, "с тега").Равно("tag");
	Ожидаем.Что(Показ.Источник.Реф).Равно("v1.2.0");
	Ожидаем.Что(Показ.Источник.Ссылка, "ссылка на сам файл на GitHub")
		.Равно("https://github.com/" + Владелец + "/lib/blob/v1.2.0/README.md");
	Ожидаем.Что(ОбращенийК(Владелец), "найдено первым же адресом").Равно(1);

КонецПроцедуры

// Тег без «v» — вторая запись номера; имя файла пробуется в трёх записях регистра.
&Тест
Процедура ТегБезПрефиксаИФайлВНижнемРегистреНаходятся() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/2.0.0/readme.md", "# Без префикса");
	Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib"), "2.0.0", "");

	Показ = Представление(Принятое);

	Ожидаем.Что(Показ.ЕстьREADME).ЭтоИстина();
	Ожидаем.Что(Показ.Источник.Вид).Равно("tag");
	Ожидаем.Что(Показ.Источник.Реф).Равно("2.0.0");
	Ожидаем.Что(Показ.Источник.Ссылка).Равно("https://github.com/" + Владелец + "/lib/blob/2.0.0/readme.md");

КонецПроцедуры

// Тега нет — README берётся из ветки по умолчанию, и страница так и говорит.
&Тест
Процедура БезТегаREADMEБерётсяИзВеткиПоУмолчанию() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/HEAD/Readme.md", "# Из ветки");
	Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib.git"), "0.3.0", "");

	Показ = Представление(Принятое);

	Ожидаем.Что(Показ.ЕстьREADME).ЭтоИстина();
	Ожидаем.Что(Показ.Источник.Вид).Равно("default_branch");
	Ожидаем.Что(Показ.Источник.Реф).Равно("HEAD");
	Ожидаем.Что(Показ.Источник.Ссылка).Равно("https://github.com/" + Владелец + "/lib/blob/HEAD/Readme.md");
	Ожидаем.Что(ОбращенийК(Владелец), "два тега по три записи имени, затем ветка").Равно(9);

КонецПроцедуры

// Чужой README — недоверенный документ: из репозитория он идёт той же санитизацией.
&Тест
Процедура ОпасныйHTMLИзРепозиторияВычищается() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", Фикстура.ВредоносныйREADME());
	Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib"), "1.0.0", "");

	HTML = НРег(Представление(Принятое).HTML);

	Ожидаем.Что(HTML, "легитимный текст на месте").Содержит("демо-пакет winow");
	Ожидаем.Что(СтрНайти(HTML, "<script"), "script вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "javascript:"), "javascript-URL вырезаны").Равно(0);

КонецПроцедуры

// Байты README из репозитория лежат в области пула и счётчик пула о них знает.
&Тест
Процедура READMEИзРепозиторияВходитВОбъёмПула() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", "# В объём пула");
	Пакет = ПакетНаGitHub(Владелец, "lib");
	Принятое = Опубликовать(Пакет, "1.0.0", "");

	Хранилище = Поделка.НайтиЖелудь("ХранилищеАртефактов");
	Ожидаемое = Хранилище.Размер(Файл(Принятое, "readme.md")) + Хранилище.Размер(Файл(Принятое, "readme.json"));
	Ожидаем.Что(Ожидаемое > 0, "самотест: файлы описания и справки на диске").ЭтоИстина();
	Ожидаем.Что(Поделка.НайтиЖелудь("УчётОбъёмаПула").ЗанятоБайт(ОбновлённыйПул(Пакет.Пул)),
		"занятое пула — описание и справка").Равно(Ожидаемое);

КонецПроцедуры

// Уборка пакета уносит и справку: файл лежит в области пула и место занимает.
&Тест
Процедура УборкаПакетаУноситСправку() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", "# Уйдёт с пакетом");
	Пакет = ПакетНаGitHub(Владелец, "lib");
	Принятое = Опубликовать(Пакет, "1.0.0", "");
	Хранилище = Поделка.НайтиЖелудь("ХранилищеАртефактов");
	Ожидаем.Что(Хранилище.Существует(Файл(Принятое, "readme.json")), "самотест: справка легла").ЭтоИстина();

	Поделка.НайтиЖелудь("УборкаПакета").УдалитьПакет(Принятое.Пакет);

	Ожидаем.Что(Хранилище.Существует(Файл(Принятое, "readme.json")), "справка снята").ЭтоЛожь();
	Ожидаем.Что(Хранилище.Существует(Файл(Принятое, "readme.md")), "описание снято").ЭтоЛожь();
	Ожидаем.Что(Поделка.НайтиЖелудь("УчётОбъёмаПула").ЗанятоБайт(ОбновлённыйПул(Пакет.Пул)),
		"занятое пула вернулось к нулю").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область READMEИзПакетаГлавнее

// README в пакете есть — в репозиторий не ходят ни после публикации, ни ночью.
&Тест
Процедура READMEИзПакетаВРепозиторийНеВедёт() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", "# Из репозитория");
	Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib"), "1.0.0", "# Из пакета");
	Поделка.НайтиЖелудь("АктуализаторОписаний").Актуализировать();

	Показ = Представление(Принятое);

	Ожидаем.Что(Показ.HTML, "показан README пакета").Содержит("Из пакета");
	Ожидаем.Что(Показ.Источник, "источник — пакет").Равно(Неопределено);
	Ожидаем.Что(ОбращенийК(Владелец), "в репозиторий не ходили").Равно(0);

КонецПроцедуры

// Перезапись версии с README в пакете снимает справку: описание снова из пакета.
&Тест
Процедура ПерезаписьСREADMEВозвращаетИсточникПакету() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", "# Из репозитория");
	Пакет = ПакетНаGitHub(Владелец, "lib");
	Опубликовать(Пакет, "1.0.0", "");
	Ожидаем.Что(Представление(Опубликовать(Пакет, "1.0.0", "# Из пакета", Истина)).Источник,
		"после перезаписи источник — пакет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область НеНайден

// Нигде не нашлось — страница как без README; повтор того же дня в репозиторий не ходит,
// через сутки ночной обход спрашивает снова.
&Тест
Процедура НенайденныйREADMEПереспрашиваетсяНеЧащеРазаВСутки() Экспорт

	Владелец = НовыйВладелец();
	Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib"), "1.0.0", "");

	Ожидаем.Что(Представление(Принятое).ЕстьREADME, "страница без README").ЭтоЛожь();
	Ожидаем.Что(ОбращенийК(Владелец), "спросили все рефы и записи имени").Равно(9);

	Поделка.НайтиЖелудь("АктуализаторОписаний").Актуализировать();
	Ожидаем.Что(ОбращенийК(Владелец), "ночь того же дня в репозиторий не идёт").Равно(9);

	СостаритьСправку(Принятое, 25);
	GitHub.Положить(Владелец + "/lib/HEAD/README.md", "# Появился");
	Поделка.НайтиЖелудь("АктуализаторОписаний").Актуализировать();

	Ожидаем.Что(ОбращенийК(Владелец) > 9, "через сутки спросили снова").ЭтоИстина();
	Ожидаем.Что(Представление(Принятое).HTML, "и README показан").Содержит("Появился");

КонецПроцедуры

// Сутки считаются по часам: ночь, пришедшая на секунды раньше вчерашней, не пропускается.
&Тест
Процедура СуткиСчитаютсяПоЧасам() Экспорт

	Владелец = НовыйВладелец();
	Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib"), "1.0.0", "");
	СостаритьСправку(Принятое, 24);
	ДополнитьНочью();
	Ожидаем.Что(ОбращенийК(Владелец), "ровно сутки назад по часам — пора").Равно(18);

	СостаритьСправку(Принятое, 23);
	ДополнитьНочью();
	Ожидаем.Что(ОбращенийК(Владелец), "23 часа — ещё рано").Равно(18);

КонецПроцедуры

// Адрес репозитория у пакета сменился — это новый вопрос, суток он не ждёт.
&Тест
Процедура СменаАдресаРепозиторияДаётНовуюПопытку() Экспорт

	Владелец = НовыйВладелец();
	Пакет = ПакетНаGitHub(Владелец, "old");
	Принятое = Опубликовать(Пакет, "1.0.0", "");
	Ожидаем.Что(Представление(Принятое).ЕстьREADME, "КОНТРОЛЬ: по старому адресу README нет").ЭтоЛожь();

	GitHub.Положить(Владелец + "/new/v1.0.0/README.md", "# По новому адресу");
	Поделка.НайтиЖелудь("СервисПакетов").ОбновитьМетаданные(Пакет.Пакет.Идентификатор,
		Новый Структура("АдресРепозитория", "https://github.com/" + Владелец + "/new"));
	Поделка.НайтиЖелудь("АктуализаторОписаний").Актуализировать();

	Показ = Представление(Принятое);
	Ожидаем.Что(Показ.HTML, "README по новому адресу показан в ту же ночь").Содержит("По новому адресу");

КонецПроцедуры

#КонецОбласти

#Область GitHubОтказал

// GitHub отказал по частоте — поиск обрывается на первом адресе, страница без README,
// журнал пишет одну строку о версии.
&Тест
Процедура ОтказПоЧастотеПишетОднуСтрокуИНеПереспрашивает() Экспорт

	GitHub.ОтвечатьКодом(429);
	ПроверитьОтказ(НовыйВладелец(), "429");

КонецПроцедуры

&Тест
Процедура ОшибкаGitHubПишетОднуСтрокуИНеПереспрашивает() Экспорт

	GitHub.ОтвечатьКодом(503);
	ПроверитьОтказ(НовыйВладелец(), "503");

КонецПроцедуры

// Сеть до GitHub пропала или ответ не пришёл в срок — то же самое.
&Тест
Процедура НедоступныйGitHubПишетОднуСтрокуИНеПереспрашивает() Экспорт

	GitHub.ПотерятьСеть("The operation has timed out");
	ПроверитьОтказ(НовыйВладелец(), "timed out");

КонецПроцедуры

// README больше мегабайта — уже не описание: отказ, как у сбоя GitHub.
&Тест
Процедура READMEБольшеМегабайтаЭтоОтказ() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", ТекстВБайтах(1048577));
	ПроверитьОтказ(Владелец, "больше 1048576 байт");

КонецПроцедуры

#КонецОбласти

#Область Границы

// Переадресация — «файла тут нет»: по Location поиск не идёт и переходов у транспорта не просит.
&Тест
Процедура ПереадресацияНеВедётПоLocation() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Переадресовать(Владелец + "/lib/v1.0.0/README.md", "https://evil.example/" + Владелец + "/README.md");
	GitHub.Положить(Владелец + "/lib/HEAD/README.md", "# Из ветки");

	Найденное = НайтиНаGitHub(Владелец, "1.0.0");

	Ожидаем.Что(Найденное.Исход, "переадресация — не сбой, поиск идёт дальше").Равно("найден");
	Ожидаем.Что(Найденное.Вид, "и находит ветку по умолчанию").Равно("default_branch");
	Для Каждого Адрес Из GitHub.Адреса() Цикл
		Ожидаем.Что(СтрНайти(Адрес, "evil.example"), "по Location не ходили: " + Адрес).Равно(0);
	КонецЦикла;
	Для Каждого Просили Из GitHub.Перенаправления() Цикл
		Ожидаем.Что(Просили, "переходов по Location у транспорта не просят").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// Ровно мегабайт — ещё описание.
&Тест
Процедура READMEРовноВМегабайтНаходится() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", ТекстВБайтах(1048576));

	Найденное = НайтиНаGitHub(Владелец, "1.0.0");

	Ожидаем.Что(Найденное.Исход, "README ровно в предел найден").Равно("найден");
	Ожидаем.Что(СтрДлина(Найденное.Текст), "и прочитан целиком").Равно(1048576);

КонецПроцедуры

// Метаданные сборки — часть номера: «+» кодируется в сегменте адреса, и ссылка на файл тоже.
&Тест
Процедура ПлюсВНомереВерсииКодируетсяВАдресе() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0+build.7/README.md", "# Сборка 7");

	Найденное = НайтиНаGitHub(Владелец, "1.0.0+build.7");

	Ожидаем.Что(Найденное.Исход, "README на теге с метаданными сборки найден").Равно("найден");
	Ожидаем.Что(GitHub.Адреса()[0], "«+» закодирован в адресе")
		.Равно("https://raw.githubusercontent.com/" + Владелец + "/lib/v1.0.0%2Bbuild.7/README.md");
	Ожидаем.Что(Найденное.Ссылка, "и в ссылке на файл")
		.Равно("https://github.com/" + Владелец + "/lib/blob/v1.0.0%2Bbuild.7/README.md");

КонецПроцедуры

// Автор переопубликовал версию с README, пока хаб ходил на GitHub: README пакета главнее,
// найденное в репозитории поверх не ложится.
&Тест
Процедура ПерезаписьВоВремяПоходаОставляетREADMEПакета() Экспорт

	Владелец = НовыйВладелец();
	GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", "# Из репозитория");
	Пакет = ПакетНаGitHub(Владелец, "lib");
	Переопубликовать = Новый Структура("Пакет, Версия, Текст", Пакет, "1.0.0", "# Из пакета");
	GitHub.НаОчередномОбращении(ЭтотОбъект, "ПереопубликоватьСREADME");

	Принятое = Опубликовать(Пакет, "1.0.0", "");
	Показ = Представление(Принятое);

	Ожидаем.Что(GitHub.Обращений(), "КОНТРОЛЬ: поход был и вклинились в него").Равно(1);
	Ожидаем.Что(Показ.HTML, "показан README пакета").Содержит("Из пакета");
	Ожидаем.Что(Показ.Источник, "источник — пакет").Равно(Неопределено);
	Ожидаем.Что(Поделка.НайтиЖелудь("ХранилищеАртефактов").Существует(Файл(Принятое, "readme.json")),
		"справка с README репозитория не легла").ЭтоЛожь();

КонецПроцедуры

// Вклинившийся автор: та же версия, теперь с README в пакете.
Процедура ПереопубликоватьСREADME() Экспорт
	Опубликовать(Переопубликовать.Пакет, Переопубликовать.Версия, Переопубликовать.Текст, Истина);
КонецПроцедуры

#КонецОбласти

#Область ВРепозиторийНеХодим

// Адрес не ведёт в репозиторий на github.com — в сеть не ходят вовсе.
&Тест
Процедура НеGitHubАдресВСетьНеВедёт() Экспорт

	Адреса = Новый Массив();
	Адреса.Добавить("");
	Адреса.Добавить("https://gitlab.com/acme/lib");
	Адреса.Добавить("https://example.org/acme/lib");
	Адреса.Добавить("https://github.com/acme");
	Адреса.Добавить("https://user@github.com/acme/lib");
	Адреса.Добавить("https://github.com/acme/..");
	Адреса.Добавить("https://github.com.evil.example/acme/lib");

	Для Каждого Адрес Из Адреса Цикл
		Пакет = ПакетПоАдресу(Адрес);
		Опубликовать(Пакет, "1.0.0", "");
	КонецЦикла;

	Ожидаем.Что(GitHub.Обращений(), "ни одного запроса: " + СтрСоединить(GitHub.Адреса(), ", ")).Равно(0);

КонецПроцедуры

// Оператор выключил поход — инсталляция наружу не ходит ни после публикации, ни ночью.
&Тест
Процедура ВыключеннаяНастройкаВСетьНеВедёт() Экспорт

	Настройки = Поделка.НайтиЖелудь("СервисНастроек");
	Настройки.Установить("oshub.readme.repository.enabled", Ложь, "тест");
	Попытка
		Владелец = НовыйВладелец();
		GitHub.Положить(Владелец + "/lib/v1.0.0/README.md", "# Не дойдёт");
		Принятое = Опубликовать(ПакетНаGitHub(Владелец, "lib"), "1.0.0", "");
		Поделка.НайтиЖелудь("АктуализаторОписаний").Актуализировать();
		Показ = Представление(Принятое);
	Исключение
		Настройки.Сбросить("oshub.readme.repository.enabled", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.readme.repository.enabled", "тест");

	Ожидаем.Что(GitHub.Обращений(), "ни одного запроса").Равно(0);
	Ожидаем.Что(Показ.ЕстьREADME, "страница как без README").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПустоеОписание

// Пустое описание на S3 узнаётся по размеру: корзину не просят его отдать, .ospx не
// распаковывается, предупреждения «с диска не прочиталось» нет. Корзина повторяет повадку
// OneScript — ответ без тела файла не создаёт.
&Тест
Процедура ПустоеОписаниеНаS3НеСкачиваетсяИАртефактНеРаспаковывается() Экспорт

	Стенд = СтендS3("");
	Показ = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Стенд.Ловушка.Снять();

	Ожидаем.Что(Показ.ЕстьREADME, "страница без README: пакет сказал, что его нет").ЭтоЛожь();
	Ожидаем.Что(Стенд.Корзина.Обращений(), "размер описания и справка — и только").Равно(2);
	Ожидаем.Что(Стенд.Ловушка.Всё(), "предупреждений нет").Равно("");

КонецПроцедуры

// Показ README из пакета на S3 стоит двух вопросов корзине: размер и содержимое.
&Тест
Процедура ПоказREADMEНаS3СтоитДвухЗапросов() Экспорт

	Стенд = СтендS3("# С корзины");
	Показ = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Стенд.Ловушка.Снять();

	Ожидаем.Что(Показ.HTML, "README показан").Содержит("С корзины");
	Ожидаем.Что(Стенд.Корзина.Обращений(), "размер и содержимое").Равно(2);

КонецПроцедуры

// Ночному обходу о лежащем описании хватает его размера: содержимое не скачивается.
&Тест
Процедура ОбходЛежащегоОписанияНаS3СтоитОдногоЗапроса() Экспорт

	Стенд = СтендS3("# С корзины");
	Обеспечено = Стенд.Служба.ОбеспечитьОписаниеНаДиске(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Стенд.Ловушка.Снять();

	Ожидаем.Что(Обеспечено, "описание на диске").ЭтоИстина();
	Ожидаем.Что(Стенд.Корзина.Обращений(), "только размер").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Помощники

Процедура ПроверитьОтказ(Знач Владелец, Знач ЧтоВЖурнале)

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.описания.отказ");
	Ловушка.Поставить(Лог, УровниЛога.Предупреждение);
	Служба = Новый СлужбаREADMEРепозитория(Поделка.НайтиЖелудь("ХранилищеREADME"),
		Поделка.НайтиЖелудь("ИсточникREADMEGitHub"), Новый РепозиторийGitHub(Новый РазборАдреса()),
		Поделка.НайтиЖелудь("СервисНастроек"), Лог);

	Пакет = ПакетНаGitHub(Владелец, "lib");
	Принятое = Опубликовать(Пакет, "1.0.0", "");
	ДоСлужбы = ОбращенийК(Владелец);
	СостаритьСправку(Принятое, 25);

	Служба.Дополнить(Пакет.Пул, Принятое.Пакет, Принятое.Версия);
	Служба.Дополнить(Пакет.Пул, Принятое.Пакет, Принятое.Версия);
	Ловушка.Снять();

	Ожидаем.Что(ДоСлужбы, "фон публикации тоже оборвался на первом адресе").Равно(1);
	Ожидаем.Что(ОбращенийК(Владелец) - ДоСлужбы, "первый отказ обрывает поиск, повтор того же дня не идёт")
		.Равно(1);
	Ожидаем.Что(Представление(Принятое).ЕстьREADME, "страница как без README").ЭтоЛожь();
	Ожидаем.Что(Ловушка.Количество(), "одна строка журнала на версию: " + Ловушка.Всё()).Равно(1);
	Ожидаем.Что(Ловушка.Всё(), "строка называет версию").Содержит("1.0.0");
	Ожидаем.Что(Ловушка.Всё(), "и причину").Содержит(ЧтоВЖурнале);

КонецПроцедуры

Функция НайтиНаGitHub(Знач Владелец, Знач Версия)
	Возврат Поделка.НайтиЖелудь("ИсточникREADMEGitHub").НайтиВРепозитории(
		Новый Структура("Владелец, Имя", Владелец, "lib"), Версия);
КонецФункции

// ASCII-текст ровно названной длины в байтах.
Функция ТекстВБайтах(Знач Байт)
	Кусок = "x";
	Пока СтрДлина(Кусок) < Байт Цикл
		Кусок = Кусок + Кусок;
	КонецЦикла;
	Возврат Лев(Кусок, Байт);
КонецФункции

// Описание версии на S3 поверх фейка корзины с повадкой OneScript; счёт обращений обнулён.
Функция СтендS3(Знач ТекстОписания)

	Корзина = Новый ФейкКлиентS3();
	Корзина.ПустоеНеСкачивается();
	Хранилище = Новый S3Хранилище(Корзина);

	Пул = Новый Структура("Имя", "s3-pool");
	Пакет = Новый Структура("Имя, АдресРепозитория", "s3-pkg", "");
	Версия = Новый Структура("Версия", "1.0.0");
	Хранилище.Сохранить(Новый КоординатыАртефакта(Пул.Имя, Пакет.Имя, Версия.Версия),
		Фикстура.ПостроитьOspx(УникальныеИмена.ВременныйКаталог("ospx"), Пакет.Имя, Версия.Версия, "# В .ospx"));

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.описания.s3");
	Ловушка.Поставить(Лог, УровниЛога.Предупреждение);

	Описания = Новый ХранилищеREADME(Хранилище, Лог);
	Описания.Записать(Пул.Имя, Пакет.Имя, Версия.Версия, ТекстОписания);
	Служба = Новый СлужбаREADME(Описания, Новый ИсточникREADME(Хранилище, Лог), Новый РендерерREADME());
	Корзина.ОбнулитьОбращения();

	Возврат Новый Структура("Корзина, Ловушка, Служба, Пул, Пакет, Версия",
		Корзина, Ловушка, Служба, Пул, Пакет, Версия);

КонецФункции

Процедура ДополнитьНочью()
	Поделка.НайтиЖелудь("АктуализаторОписаний").Актуализировать();
КонецПроцедуры

// Владелец репозитория свой у каждого теста: ночной обход идёт по всем пакетам набора.
Функция НовыйВладелец()
	Возврат "acme-" + УникальныеИмена.Хвост();
КонецФункции

Функция ПакетНаGitHub(Знач Владелец, Знач Репозиторий)
	Возврат ПакетПоАдресу("https://github.com/" + Владелец + "/" + Репозиторий);
КонецФункции

Функция ПакетПоАдресу(Знач Адрес)

	Ключ = УникальныеИмена.Хвост();
	Пул = Засев.ПулСервисом("repo-readme-" + Ключ);
	Пакет = Засев.ПакетСервисом(Пул.Идентификатор, "pkg-" + Ключ,
		Новый Структура("Описание, АдресРепозитория", "Пакет для README из репозитория", Адрес));
	Возврат Новый Структура("Пул, Пакет", Пул, Пакет);

КонецФункции

// Публикация — то ядро, через которое проходит opm push; README "" — в пакете его нет.
Функция Опубликовать(Знач Пакет, Знач Версия, Знач ТекстREADME, Знач Перезаписать = Ложь)

	Артефакт = Новый Структура("Размер, Sha256", 0, "");
	Принятое = Поделка.НайтиЖелудь("ПриёмВерсии").ПринятьПубликацию(Пакет.Пул, Пакет.Пакет.Имя, Версия,
		Неопределено, Артефакт, 0, Перезаписать, Ложь, ТекстREADME);
	Принятое.Вставить("Пул", Пакет.Пул);
	Возврат Принятое;

КонецФункции

Функция Представление(Знач Принятое)
	Возврат Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(Принятое.Пул, Принятое.Пакет,
		Принятое.Версия);
КонецФункции

Функция ОбращенийК(Знач Владелец)

	Счёт = 0;
	Для Каждого Адрес Из GitHub.Адреса() Цикл
		Если СтрНайти(Адрес, "/" + Владелец + "/") > 0 Тогда
			Счёт = Счёт + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счёт;

КонецФункции

// Справка, отодвинутая в прошлое на названное число часов.
Процедура СостаритьСправку(Знач Принятое, Знач Часов)

	Описания = Поделка.НайтиЖелудь("ХранилищеREADME");
	Справка = Описания.ПрочитатьСправку(Принятое.Пул.Имя, Принятое.Пакет.Имя, Принятое.Версия.Версия);
	Ожидаем.Что(Справка <> Неопределено, "самотест: справка о версии есть").ЭтоИстина();
	Справка.Спрошено = ТекущаяУниверсальнаяДата() - Часов * 3600;
	Описания.ЗаписатьСправку(Принятое.Пул.Имя, Принятое.Пакет.Имя, Принятое.Версия.Версия, Справка);

КонецПроцедуры

// Имена файлов написаны руками: сторож обязан ловить и переименование.
Функция Файл(Знач Принятое, Знач Расширение)
	Возврат Новый КоординатыАртефакта(Принятое.Пул.Имя, Принятое.Пакет.Имя, Принятое.Версия.Версия,
		Принятое.Пакет.Имя + "-" + Принятое.Версия.Версия + "." + Расширение);
КонецФункции

Функция ОбновлённыйПул(Знач Пул)
	Возврат Поделка.НайтиЖелудь("СервисПулов").ПулПоИдентификатору(Цел(Пул.Идентификатор));
КонецФункции

#КонецОбласти
