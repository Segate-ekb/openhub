// Готовое представление README версии на собранном контейнере с autumn-cache: повторный показ
// Markdown не разбирает, а запись описания или справки на диск (в том числе во время сборки и под
// именем в другом регистре), снятие описания и смена адреса репозитория дают следующему показу
// новое представление.

#Использовать asserts
#Использовать autumn
#Использовать autumn-cache
#Использовать autumn-logos
#Использовать tempfiles
#Использовать "../фикстуры"

Перем Поделка;
Перем Хранилище;   // ФайловоеХранилище во временном каталоге

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СчитающийРендерерREADME");
	Классы = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Классы.ПодключитьОснову(Модули);
	Классы.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы", "квота"));
	Для Каждого Имя Из СтрРазделить("ФайловоеХранилище,РаскладкаФайловХранилища,"
		+ "ПомощникАртефакта,КоординатыАртефакта,ТипСодержимогоАртефакта", ",") Цикл
		Классы.Подключить(ОбъединитьПути(Модули, "хранилище", "Классы"), Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ПамятьПредставленийREADME,СлужбаREADME,ХранилищеREADME,ИсточникREADME,"
		+ "РендерерREADME,СсылкиREADME,АдресаРепозитория,КоординатыREADME", ",") Цикл
		Классы.Подключить(ОбъединитьПути(Модули, "описания", "Классы"), Имя);
	КонецЦикла;

	Детальки = Новый Соответствие();
	Детальки.Вставить("cache.ПределПамяти", 4194304);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Хранилище = Новый ФайловоеХранилище(ВременныеФайлы.СоздатьКаталог());

КонецПроцедуры

// Второй показ той же версии отдаёт готовое: Markdown разобран один раз, HTML тот же.
&Тест
Процедура ПовторныйПоказНеРазбираетREADME() Экспорт

	Стенд = Стенд("# Заголовок" + Символы.ПС + Символы.ПС + "Текст описания.");

	Первое = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Второе = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Ожидаем.Что(Первое.ЕстьREADME, "описание показано").ЭтоИстина();
	Ожидаем.Что(Второе.HTML, "второй показ отдаёт тот же HTML").Равно(Первое.HTML);
	Ожидаем.Что(Стенд.Рендерер.Разборов(), "Markdown разобран один раз").Равно(1);

КонецПроцедуры

// Представление отдаётся копией: показ, поправивший полученное, следующему показу не вредит.
&Тест
Процедура ПравкаПолученногоНеПортитЗапомненное() Экспорт

	Стенд = Стенд("# Своё");

	Первое = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Исходный = Первое.HTML;
	Первое.Вставить("HTML", "испорчено");

	Ожидаем.Что(Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия).HTML,
		"следующий показ видит исходный HTML").Равно(Исходный);

КонецПроцедуры

// Перезапись версии кладёт новое описание — следующий показ отдаёт его, а не запомненное.
&Тест
Процедура ЗаписьОписанияСбрасываетПредставление() Экспорт

	Стенд = Стенд("# Было");
	Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Стенд.Описания.Записать(Стенд.Пул.Имя, Стенд.Пакет.Имя, Стенд.Версия.Версия, "# Стало");
	После = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Ожидаем.Что(После.HTML, "показано новое описание").Содержит("Стало");
	Ожидаем.Что(Стенд.Рендерер.Разборов(), "и разобрано заново").Равно(2);

КонецПроцедуры

// README из репозитория приходит справкой: она тоже меняет представление, и новое запоминается.
&Тест
Процедура СправкаИзРепозиторияСбрасываетПредставление() Экспорт

	Стенд = Стенд("");
	До = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Ожидаем.Что(До.ЕстьREADME, "самотест: в пакете README нет").ЭтоЛожь();

	Справка = Новый Структура("Репозиторий, Спрошено, Найдено, Вид, Реф, Ссылка, Текст",
		"https://github.com/acme/lib", ТекущаяУниверсальнаяДата(), Истина, "default_branch", "HEAD",
		"https://github.com/acme/lib/blob/HEAD/README.md", "# Из репозитория");
	Стенд.Описания.ЗаписатьСправку(Стенд.Пул.Имя, Стенд.Пакет.Имя, Стенд.Версия.Версия, Справка);

	После = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Ещё = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Ожидаем.Что(После.HTML, "показан README из репозитория").Содержит("Из репозитория");
	Ожидаем.Что(После.Источник.Вид, "и названо, откуда он").Равно("default_branch");
	Ожидаем.Что(Ещё.Источник.Ссылка, "запомненное знает источник").Равно(Справка.Ссылка);
	Ожидаем.Что(Стенд.Рендерер.Разборов(), "разобран один раз").Равно(1);

КонецПроцедуры

// Уборка снимает описание с диска — запомненное представление уходит вместе с ним.
&Тест
Процедура СнятиеОписанияСбрасываетПредставление() Экспорт

	Стенд = Стенд("# Уберут");
	Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Стенд.Описания.Снять(Стенд.Пул.Имя, Стенд.Пакет.Имя, Стенд.Версия.Версия);

	Ожидаем.Что(Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия).ЕстьREADME,
		"описания больше нет").ЭтоЛожь();

КонецПроцедуры

// Относительные ссылки README собраны от адреса репозитория: новый адрес карточки — новое представление.
&Тест
Процедура СменаАдресаРепозиторияДаётНовоеПредставление() Экспорт

	Стенд = Стенд("[Руководство](docs/guide.md)", "https://github.com/acme/old");
	Было = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Стенд.Пакет.АдресРепозитория = "https://github.com/acme/new";
	Стало = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Ожидаем.Что(Было.HTML, "самотест: ссылка вела в старый репозиторий").Содержит("acme/old/blob");
	Ожидаем.Что(Стало.HTML, "ссылка ведёт в новый репозиторий").Содержит("acme/new/blob");

КонецПроцедуры

// Перезалили версию, назвав пакет в другом регистре: запомненное сбрасывается, и показ отдаёт то же,
// что отдал бы без памяти.
&Тест
Процедура ЗаписьВДругомРегистреСбрасываетПредставление() Экспорт

	Стенд = Стенд("# Было", , "Pool-", "Pkg-");
	Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Стенд.Описания.Записать(ВРег(Стенд.Пул.Имя), ВРег(Стенд.Пакет.Имя), Стенд.Версия.Версия, "# Стало");
	После = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	БезПамяти = Новый СлужбаREADME(Стенд.Описания, Новый ИсточникREADME(Хранилище, Стенд.Лог),
		Новый РендерерREADME(), Поделка.НайтиЖелудь("СсылкиREADME"));
	Ожидаем.Что(Стенд.Рендерер.Разборов(), "запомненное сброшено, описание разобрано заново").Равно(2);
	Ожидаем.Что(После.HTML, "показ совпадает с показом без памяти")
		.Равно(БезПамяти.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия).HTML);

КонецПроцедуры

// Описание записали, пока собиралось представление по прежнему: собранное не запоминается,
// следующий показ отдаёт новое описание.
&Тест
Процедура ЗаписьВоВремяСборкиНеЗапоминаетСобранное() Экспорт

	Стенд = Стенд("# Было");
	Стенд.Рендерер.ЗаписатьПриРазборе(Стенд.Описания, Стенд.Пул.Имя, Стенд.Пакет.Имя, Стенд.Версия.Версия,
		"# Стало");

	Первое = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);
	Второе = Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Ожидаем.Что(Первое.HTML, "самотест: первый показ собран из прежнего описания").Содержит("Было");
	Ожидаем.Что(Второе.HTML, "второй показ видит записанное во время сборки").Содержит("Стало");

КонецПроцедуры

// Справки нет — ответ «README нет» не окончателен: справка могла не прочитаться, показ спросит снова.
&Тест
Процедура ОтветБезСправкиНеЗапоминается() Экспорт

	Стенд = Стенд("");
	Кэш = Поделка.НайтиЖелудь("МенеджерКэшей").Кэш("представленияREADME");
	Было = Кэш.Статистика().Занято;

	Стенд.Служба.ПредставлениеREADME(Стенд.Пул, Стенд.Пакет, Стенд.Версия);

	Ожидаем.Что(Кэш.Статистика().Занято, "в кэш ничего не легло").Равно(Было);

КонецПроцедуры

#Область Стенд

// Версия с описанием на диске и служба над настоящими хранилищем описаний и памятью из контейнера.
Функция Стенд(Знач ТекстОписания, Знач АдресРепозитория = "", Знач НачалоПула = "pool-",
	Знач НачалоПакета = "pkg-")

	Хвост = Строка(Новый УникальныйИдентификатор());
	Пул = Новый Структура("Имя", НачалоПула + Лев(Хвост, 8));
	Пакет = Новый Структура("Имя, АдресРепозитория", НачалоПакета + Прав(Хвост, 8), АдресРепозитория);
	Версия = Новый Структура("Версия", "1.0.0");

	Лог = Логирование.ПолучитьЛог("тест.oshub.описания.память");
	Память = Поделка.НайтиЖелудь("ПамятьПредставленийREADME");
	Описания = Новый ХранилищеREADME(Хранилище, Лог, , Память);
	Описания.Записать(Пул.Имя, Пакет.Имя, Версия.Версия, ТекстОписания);

	Рендерер = Новый СчитающийРендерерREADME(Новый РендерерREADME());
	Служба = Новый СлужбаREADME(Описания, Новый ИсточникREADME(Хранилище, Лог), Рендерер,
		Поделка.НайтиЖелудь("СсылкиREADME"), Память);

	Возврат Новый Структура("Пул, Пакет, Версия, Описания, Рендерер, Служба, Лог",
		Пул, Пакет, Версия, Описания, Рендерер, Служба, Лог);

КонецФункции

#КонецОбласти
