// Сырое содержимое GitHub на своём порту для живого хаба: файлы по пути «владелец/репо/реф/файл»,
// 404 на остальное. Набор однопоточный, поэтому стенд отвечает, только когда его просят обслужить.

Перем Выдача;
Перем Сервер;
Перем НомерПорта;
Перем Файлы;      // Соответствие: путь -> Строка
Перем Пути_;      // Массив из Строка — пути обслуженных запросов по порядку

#Область ЖизненныйЦикл

Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ВыдачаПортов");
	Выдача = Новый ВыдачаПортов();
	НомерПорта = 0;
	Файлы = Новый Соответствие();
	Пути_ = Новый Массив();

КонецПроцедуры

// Занимает свободный порт и начинает слушать: соединения хаба ждут обслуживания в очереди ОС.
//
// Возвращаемое значение:
//  Строка - корень сырого содержимого «http://127.0.0.1:<порт>».
//
Функция Слушать() Экспорт

	НомерПорта = Выдача.Выдать();
	Сервер = Новый TCPСервер(НомерПорта);
	Сервер.Запустить();

	Возврат СтрШаблон("http://127.0.0.1:%1", Формат(НомерПорта, "ЧГ=0"));

КонецФункции

// Закрывает порт и возвращает его в оборот. Идемпотентна.
//
Процедура Остановить() Экспорт

	Если Сервер <> Неопределено Тогда
		Попытка
			Сервер.Остановить();
		Исключение
			// порт всё равно освободится вместе с процессом прогона
		КонецПопытки;
		Сервер = Неопределено;
	КонецЕсли;

	Выдача.ВернутьВсе();
	НомерПорта = 0;

КонецПроцедуры

#КонецОбласти

#Область Содержимое

// Кладёт файл в репозиторий стенда.
//
// Параметры:
//  Путь  - Строка - «владелец/репо/реф/файл».
//  Текст - Строка - содержимое файла.
//
Процедура Положить(Знач Путь, Знач Текст) Экспорт
	Файлы.Вставить(Путь, Текст);
КонецПроцедуры

// Отвечает на запросы из очереди, пока не обслужит названное число либо не выйдет срок.
//
// Параметры:
//  Сколько    - Число - сколько запросов обслужить.
//  ТаймаутСек - Число - сколько ждать их всех.
//
// Возвращаемое значение:
//  Число - обслужено запросов.
//
Функция Обслужить(Знач Сколько, Знач ТаймаутСек) Экспорт

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Обслужено = 0;
	Пока Обслужено < Сколько И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Соединение = Сервер.ОжидатьСоединения(200);
		Если Соединение <> Неопределено Тогда
			Ответить(Соединение);
			Обслужено = Обслужено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Обслужено;

КонецФункции

// Пути обслуженных запросов по порядку.
//
// Возвращаемое значение:
//  Массив из Строка - «/владелец/репо/реф/файл».
//
Функция Пути() Экспорт
	Возврат Пути_;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Ответить(Знач Соединение)

	Соединение.ТаймаутЧтения = 2000;
	Путь = ПутьЗапроса(Прочитать(Соединение));
	Пути_.Добавить(Путь);

	Текст = Файлы.Получить(РаскодироватьСтроку(Сред(Путь, 2), СпособКодированияСтроки.КодировкаURL));
	Код = ?(Текст = Неопределено, "404 Not Found", "200 OK");
	Тело = ПолучитьДвоичныеДанныеИзСтроки(?(Текст = Неопределено, "404: Not Found", Текст), "UTF-8");

	Заголовок = СтрШаблон("HTTP/1.1 %1%2Content-Type: text/plain; charset=utf-8%2Content-Length: %3%2"
		+ "Connection: close%2%2", Код, Символы.ВК + Символы.ПС, Формат(Тело.Размер(), "ЧГ=0; ЧН=0"));

	Попытка
		Соединение.ОтправитьДвоичныеДанные(ПолучитьДвоичныеДанныеИзСтроки(Заголовок, "UTF-8"));
		Соединение.ОтправитьДвоичныеДанные(Тело);
		Соединение.Закрыть();
	Исключение
		// хаб мог бросить соединение по своему сроку
	КонецПопытки;

КонецПроцедуры

// Запрос GET без тела приходит одним куском: строка запроса и заголовки.
Функция Прочитать(Знач Соединение)
	Попытка
		Возврат Соединение.ПрочитатьСтроку();
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// «GET /acme/lib/v1.0.0/README.md HTTP/1.1» — «/acme/lib/v1.0.0/README.md».
Функция ПутьЗапроса(Знач Запрос)

	Строка_ = СтрПолучитьСтроку(Запрос, 1);
	Части = СтрРазделить(Строка_, " ", Ложь);
	Возврат ?(Части.Количество() >= 2, Части[1], "");

КонецФункции

#КонецОбласти
