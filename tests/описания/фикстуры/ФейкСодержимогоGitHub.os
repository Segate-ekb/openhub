// Фейковый ТранспортHTTP вместо сырого содержимого GitHub: файлы и переадресации по пути
// «владелец/репо/реф/файл», 404 на остальное, отказ кодом либо сетью на всё, счёт и адреса
// обращений, действие на очередном обращении.

Перем Файлы;          // Соответствие: путь -> Строка
Перем Переадресации;  // Соответствие: путь -> Строка (Location)
Перем КодОтказа;      // Число; 0 — отвечает по файлам
Перем ТекстСбоя;      // Строка; "" — сеть есть
Перем Адреса_;        // Массив из Строка — адреса обращений по порядку
Перем Перенаправления_; // Массив из Булево — просили ли идти по Location, по обращениям
Перем Действие;       // Структура: Объект, Метод — исполняется на очередном обращении один раз

#Область Стенд

// Кладёт файл в репозиторий стенда.
//
// Параметры:
//  Путь  - Строка - «владелец/репо/реф/файл», как в адресе сырого содержимого.
//  Текст - Строка - содержимое файла.
//
Процедура Положить(Знач Путь, Знач Текст) Экспорт
	Файлы.Вставить(Путь, Текст);
КонецПроцедуры

// Отвечает на путь переадресацией 301 с названным Location.
//
// Параметры:
//  Путь - Строка - «владелец/репо/реф/файл».
//  Куда - Строка - значение заголовка Location.
//
Процедура Переадресовать(Знач Путь, Знач Куда) Экспорт
	Переадресации.Вставить(Путь, Куда);
КонецПроцедуры

// Исполняет метод объекта на очередном обращении, до ответа, — один раз: так тест вклинивается
// в середину похода.
//
// Параметры:
//  Объект - Произвольный - чей метод.
//  Метод  - Строка - имя экспортного метода без параметров.
//
Процедура НаОчередномОбращении(Знач Объект, Знач Метод) Экспорт
	Действие = Новый Структура("Объект, Метод", Объект, Метод);
КонецПроцедуры

// Переводит стенд в режим отказа: на любой адрес — названный код.
//
// Параметры:
//  Код - Число - код ответа; 0 возвращает ответы по файлам.
//
Процедура ОтвечатьКодом(Знач Код) Экспорт
	КодОтказа = Код;
КонецПроцедуры

// Переводит стенд в режим сетевого сбоя: любой запрос бросает исключение, как таймаут транспорта.
//
// Параметры:
//  Текст - Строка - текст исключения; "" возвращает сеть.
//
Процедура ПотерятьСеть(Знач Текст) Экспорт
	ТекстСбоя = Текст;
КонецПроцедуры

// Возвращает стенд в исходное: файлов нет, отказов нет, счёт с нуля.
//
Процедура Сбросить() Экспорт
	Файлы = Новый Соответствие();
	Переадресации = Новый Соответствие();
	КодОтказа = 0;
	ТекстСбоя = "";
	Адреса_ = Новый Массив();
	Перенаправления_ = Новый Массив();
	Действие = Неопределено;
КонецПроцедуры

// Сколько раз к стенду обратились.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Адреса_.Количество();
КонецФункции

// Адреса обращений по порядку.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Адреса() Экспорт
	Возврат Адреса_;
КонецФункции

// Просили ли идти по Location — по обращениям, в порядке адресов.
//
// Возвращаемое значение:
//  Массив из Булево.
//
Функция Перенаправления() Экспорт
	Возврат Перенаправления_;
КонецФункции

#КонецОбласти

#Область КонтрактТранспорта

// Отдаёт файл стенда по адресу сырого содержимого (контракт ТранспортHTTP).
//
// Параметры:
//  URL          - Строка - адрес запроса.
//  Заголовки    - Соответствие - заголовки (необязательный).
//  ТаймаутСек   - Число - таймаут (необязательный).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный).
//  РазрешитьПеренаправление - Булево - идти ли по Location (необязательный).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20, Знач ПроверятьSSL = Истина,
	Знач РазрешитьПеренаправление = Ложь) Экспорт

	Адреса_.Добавить(Строка(URL));
	Перенаправления_.Добавить(РазрешитьПеренаправление = Истина);
	Если Действие <> Неопределено Тогда
		Очередное = Действие;
		Действие = Неопределено;
		Вызов = Новый Рефлектор();
		Вызов.ВызватьМетод(Очередное.Объект, Очередное.Метод, Новый Массив());
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстСбоя) Тогда
		ВызватьИсключение ТекстСбоя;
	КонецЕсли;
	Если КодОтказа <> 0 Тогда
		Возврат ОтветСтенда(КодОтказа, "rate limited");
	КонецЕсли;

	Путь = ПутьВРепозитории(URL);
	Куда = Переадресации.Получить(Путь);
	Если Куда <> Неопределено Тогда
		Ответ = ОтветСтенда(301, "");
		Ответ.Заголовки.Вставить("Location", Куда);
		Возврат Ответ;
	КонецЕсли;

	Текст = Файлы.Получить(Путь);
	Возврат ?(Текст = Неопределено, ОтветСтенда(404, "404: Not Found"), ОтветСтенда(200, Текст));

КонецФункции

// Отдаёт файл стенда, положив тело в файл (контракт ТранспортHTTP).
//
// Параметры:
//  URL          - Строка - адрес запроса.
//  ПутьФайла    - Строка - файл тела ответа.
//  Заголовки    - Соответствие - заголовки (необязательный).
//  ТаймаутСек   - Число - таймаут (необязательный).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный).
//  РазрешитьПеренаправление - Булево - идти ли по Location (необязательный).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки.
//
Функция Скачать(Знач URL, Знач ПутьФайла, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина, Знач РазрешитьПеренаправление = Ложь) Экспорт

	Ответ = Получить(URL, Заголовки, ТаймаутСек, ПроверятьSSL, РазрешитьПеренаправление);
	Ответ.Данные.Записать(ПутьФайла);
	Возврат Новый Структура("Код, Заголовки", Ответ.Код, Ответ.Заголовки);

КонецФункции

// POST стенду не нужен: сырое содержимое только читают (контракт ТранспортHTTP).
//
// Параметры:
//  URL          - Строка - адрес запроса.
//  Тело         - Строка - тело запроса.
//  Заголовки    - Соответствие - заголовки (необязательный).
//  ТаймаутСек   - Число - таймаут (необязательный).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Отправить(Знач URL, Знач Тело, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина) Экспорт
	Адреса_.Добавить(Строка(URL));
	Возврат ОтветСтенда(405, "");
КонецФункции

// Значение User-Agent (контракт ТранспортHTTP).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяАгента() Экспорт
	Возврат "OpenHub-test";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Путь после хоста: «https://raw.githubusercontent.com/acme/lib/v1.0.0/README.md» — «acme/lib/v1.0.0/README.md».
Функция ПутьВРепозитории(Знач URL)

	Адрес = Строка(URL);
	Схема = СтрНайти(Адрес, "://");
	Хвост = ?(Схема > 0, Сред(Адрес, Схема + 3), Адрес);
	Слеш = СтрНайти(Хвост, "/");
	Возврат ?(Слеш = 0, "", РаскодироватьСтроку(Сред(Хвост, Слеш + 1), СпособКодированияСтроки.КодировкаURL));

КонецФункции

Функция ОтветСтенда(Знач Код, Знач Текст)
	Возврат Новый Структура("Код, Заголовки, Данные", Код, Новый Соответствие(),
		ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"));
КонецФункции

#КонецОбласти

&Прозвище("ТранспортHTTP")
&Желудь
Процедура ПриСозданииОбъекта()
	Сбросить();
КонецПроцедуры
