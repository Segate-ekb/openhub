// Обёртка СервисаПулов, считающая обращения к нему: сами пулы отдаёт настоящая служба,
// счёт нужен там, где цена обхода росла числом пакетов.

Перем Служба;    // СервисПулов — настоящая служба пулов
Перем Счётчик;   // СчётчикОбращений — счёт обращений к службе

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Контракт СервисаПулов: пул по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Пул, Неопределено.
//
Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Служба.ПулПоИдентификатору(Идентификатор);
КонецФункции

// Контракт СервисаПулов: пулы перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Пул.
//
Функция ПулыПоИдентификаторам(Знач Идентификаторы) Экспорт
	Счётчик.Отметить();
	Возврат Служба.ПулыПоИдентификаторам(Идентификаторы);
КонецФункции

// Контракт СервисаПулов: пулы прочитанных пакетов; считает обращение.
//
// Параметры:
//  Пакеты - Массив - пакеты, у каждого читается ПулИдентификатор.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пула), значение Пул.
//
Функция ПулыПакетов(Знач Пакеты) Экспорт
	Счётчик.Отметить();
	Возврат Служба.ПулыПакетов(Пакеты);
КонецФункции

Процедура ПриСозданииОбъекта(Знач НастоящаяСлужба)
	Служба = НастоящаяСлужба;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
