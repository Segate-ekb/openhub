// Юнит-тесты асинхронного запуска синхронизации зеркал: очередь заявок в памяти и её
// отметка «поставлено» на записи, фоновый рабочий (порции по ЕстьЕщё, лимит циклов,
// изоляция сбоя) и плановая задача.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем КаталогМодулей_;
Перем КаталогФикстур_;
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени, а не строится из него

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур_ = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Зеркала = ОбъединитьПути(КаталогМодулей_, "зеркала", "Классы");
	ПоискКлассов.Подключить(Зеркала, "ОчередьСинхронизацииЗеркал");
	ПоискКлассов.Подключить(Зеркала, "РабочийСинхронизацииЗеркал");
	ПоискКлассов.Подключить(Зеркала, "ЧислаЗеркалирования");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы"), "ЗадачаСинхронизацииЗеркал");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы"), "ПриведениеЧисел");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы"), "ТекстОшибки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "наблюдаемость", "Классы"), "ГотовностьХаба");

	ПоискКлассов.Подключить(КаталогФикстур_, "НастройкиЗаглушка");
	ПоискКлассов.Подключить(КаталогФикстур_, "ФейкДвижкаСинхронизации");
	ПоискКлассов.Подключить(КаталогФикстур_, "ФейкСервисаЗеркал");
	ПоискКлассов.Подключить(КаталогФикстур_, "ФейкПадающегоЛога");
	ПоискКлассов.Подключить(КаталогФикстур_, "ЧасыРучные");

КонецПроцедуры

#Область Очередь

&Тест
Процедура ЗаявкаПринимаетсяИЖдётВОчереди() Экспорт

	Очередь = НоваяОчередь();

	Ожидаем.Что(Очередь.Состояние(7), "до заявки зеркало простаивает").Равно("простаивает");
	Ожидаем.Что(Очередь.Поставить(7, "owner1"), "заявка принята").ЭтоИстина();
	Ожидаем.Что(Очередь.Размер(), "заявка в очереди одна").Равно(1);
	Ожидаем.Что(Очередь.Состояние(7), "зеркало поставлено").Равно("поставлено");

	Заявка = Очередь.Забрать();
	Ожидаем.Что(Заявка.ЗеркалоИдентификатор, "забрана заявка того зеркала").Равно(7);
	// инициатор — ЛОГИН: субъект в хабе называется логином, число человека не называет
	Ожидаем.Что(Заявка.ЗапустилИдентификатор, "инициатор донесён до рабочего логином").Равно("owner1");
	Ожидаем.Что(Очередь.Размер(), "очередь опустела").Равно(0);
	Ожидаем.Что(Очередь.Состояние(7), "взятое зеркало идёт").Равно("идёт");

КонецПроцедуры

// Двойное нажатие не должно заводить второй прогон — ни пока заявка ждёт, ни пока идёт.
&Тест
Процедура ПовторнаяЗаявкаНеПлодитРаботу() Экспорт

	Очередь = НоваяОчередь();

	Ожидаем.Что(Очередь.Поставить(7, "owner1"), "первая заявка принята").ЭтоИстина();
	Ожидаем.Что(Очередь.Поставить(7, "alice"), "повтор по зеркалу в очереди отвергнут").ЭтоЛожь();
	Ожидаем.Что(Очередь.Размер(), "второй заявки не появилось").Равно(1);

	Очередь.Забрать();
	Ожидаем.Что(Очередь.Поставить(7, "alice"), "повтор по идущему прогону отвергнут").ЭтоЛожь();
	Ожидаем.Что(Очередь.Размер(), "очередь по-прежнему пуста").Равно(0);

	Очередь.Завершить(7);
	Ожидаем.Что(Очередь.Состояние(7), "после завершения зеркало простаивает").Равно("простаивает");
	Ожидаем.Что(Очередь.Поставить(7, "alice"), "после завершения заявка снова принимается").ЭтоИстина();

КонецПроцедуры

// Дефект владельца: рабочий взял зеркало и работать перестал — Завершить() не позвал никто.
// Признак «в работе» жил в памяти процесса без отвисания, поэтому кнопка «Синхронизировать
// сейчас» молча отбивала каждое нажатие, и лечился хаб только перезапуском. Порог тот же,
// что у записи прогона: молчит ровно порог — уже брошен.
&Тест
Процедура УмершийРабочийЗеркалоНеЗапирает() Экспорт

	Часы = Новый ЧасыРучные();
	Очередь = НоваяОчередь();
	Очередь.УстановитьЧасы(Часы);

	Очередь.Поставить(7, "owner1");
	Очередь.Забрать(); // рабочий взял заявку и умер: Завершить() не будет никогда

	Часы.Прибавить(899);
	Ожидаем.Что(Очередь.Состояние(7), "до порога зеркало занято живым прогоном").Равно("идёт");
	Ожидаем.Что(Очередь.Поставить(7, "alice"), "и второго прогона не заводит").ЭтоЛожь();

	Часы.Прибавить(1); // ровно порог
	Ожидаем.Что(Очередь.Поставить(7, "alice"), "по порогу заявка снова принимается").ЭтоИстина();
	Ожидаем.Что(Очередь.Размер(), "и встаёт в очередь").Равно(1);
	Ожидаем.Что(Очередь.Состояние(7), "зеркало больше не числится идущим").Равно("поставлено");

КонецПроцедуры

// Второй тихий тупик того же дефекта: хаб перезапустили посреди обхода. Память процесса
// пуста, поэтому заявка принималась — а захват у рабочего отказывал по ЗАПИСИ, и заявка
// пропадала без единой строки в журнале. Очередь обязана спросить запись до приёма.
&Тест
Процедура ПрогонПрошлогоЗапускаЗаявкуНеПринимает() Экспорт

	Сервис = Новый ФейкСервисаЗеркал();
	Сервис.Добавить(7);
	Сервис.ЗадатьИдущийПрогон(7); // запись помнит прогон, память процесса — нет
	Очередь = НоваяОчередьНад(Сервис);

	Ожидаем.Что(Очередь.Поставить(7, "owner1"), "заявка на ведущийся прогон не принимается").ЭтоЛожь();
	Ожидаем.Что(Очередь.Размер(), "и в очередь не встаёт").Равно(0);
	Ожидаем.Что(Очередь.Состояние(7), "кнопке есть что сказать: прогон идёт").Равно("идёт");
	Ожидаем.Что(Сервис.ЗаявкиПрогона().Количество(),
		"и состояние прогона не переписано").Равно(0);

	Сервис.ЗадатьИдущийПрогон(7, Ложь); // прогон отпущен по порогу зависания
	Ожидаем.Что(Очередь.Поставить(7, "owner1"), "после отпускания заявка принимается").ЭтоИстина();

КонецПроцедуры

// Отпускать зеркало по порогу обязана и справка о состоянии: иначе экран и API продолжают
// звать брошенный прогон идущим, пока никто не нажмёт кнопку.
&Тест
Процедура БрошенныйПрогонИдущимНеЧислится() Экспорт

	Часы = Новый ЧасыРучные();
	Очередь = НоваяОчередь();
	Очередь.УстановитьЧасы(Часы);

	Очередь.Поставить(7, "owner1");
	Очередь.Забрать();

	Часы.Прибавить(900);
	Ожидаем.Что(Очередь.Состояние(7), "молчащее дольше порога зеркало простаивает")
		.Равно("простаивает");

КонецПроцедуры

&Тест
Процедура РазныеЗеркалаЖивутВОчередиРядом() Экспорт

	Очередь = НоваяОчередь();

	Ожидаем.Что(Очередь.Поставить(1, ""), "первое зеркало").ЭтоИстина();
	Ожидаем.Что(Очередь.Поставить(2, ""), "второе зеркало").ЭтоИстина();
	Ожидаем.Что(Очередь.Размер(), "дедупликация — по зеркалу, а не по очереди целиком").Равно(2);

	// порядок FIFO: первым забирается первое поставленное
	Ожидаем.Что(Очередь.Забрать().ЗеркалоИдентификатор, "первым — старейшее").Равно(1);
	Ожидаем.Что(Очередь.Забрать().ЗеркалоИдентификатор, "затем следующее").Равно(2);
	Ожидаем.Что(Очередь.Забрать(), "пустая очередь ничего не отдаёт").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПотолокОчередиВытесняетСтарейшую() Экспорт

	Очередь = Новый ОчередьСинхронизацииЗеркал(Новый ПриведениеЧисел(),
		Новый ФейкСервисаЗеркал(), ЧислаЗеркал(Истина, 2), ЛогТестов());

	Очередь.Поставить(1, "");
	Очередь.Поставить(2, "");
	Очередь.Поставить(3, "");

	Ожидаем.Что(Очередь.Размер(), "размер очереди держится потолком").Равно(2);
	Ожидаем.Что(Очередь.Состояние(1), "старейшая заявка вытеснена").Равно("простаивает");
	Ожидаем.Что(Очередь.Забрать().ЗеркалоИдентификатор, "первой осталась вторая заявка").Равно(2);
	Ожидаем.Что(Очередь.Забрать().ЗеркалоИдентификатор, "затем третья").Равно(3);

КонецПроцедуры

&Тест
Процедура ВыключеннаяСинхронизацияЗаявокНеКопит() Экспорт

	Сервис = Новый ФейкСервисаЗеркал();
	Очередь = Новый ОчередьСинхронизацииЗеркал(Новый ПриведениеЧисел(), Сервис,
		ЧислаЗеркал(Ложь, 100), ЛогТестов());

	Ожидаем.Что(Очередь.Поставить(7, "owner1"), "с выключенным рабочим заявка не принимается").ЭтоЛожь();
	Ожидаем.Что(Очередь.Размер(), "очередь не растёт без консьюмера").Равно(0);
	Ожидаем.Что(Очередь.Состояние(7), "состояние называет причину").Равно("выключено");
	Ожидаем.Что(Сервис.ЗаявкиПрогона().Количество(),
		"и состояние прогона зеркала не переписано").Равно(0);

КонецПроцедуры

// Заявка обязана доехать до ЗАПИСИ зеркала: экран читает её, а не память процесса, и между
// нажатием и первым циклом движка обязан показывать очередь, а не «простаивает».
&Тест
Процедура ПринятаяЗаявкаПомечаетПрогонПоставленным() Экспорт

	Сервис = Новый ФейкСервисаЗеркал();
	Очередь = НоваяОчередьНад(Сервис);

	Ожидаем.Что(Очередь.Поставить(7, "owner1"), "заявка принята").ЭтоИстина();

	Заявки = Сервис.ЗаявкиПрогона();
	Ожидаем.Что(Заявки.Количество(), "прогон помечен поставленным").Равно(1);
	Ожидаем.Что(Заявки[0].Идентификатор, "то самое зеркало").Равно(7);
	Ожидаем.Что(Заявки[0].Запустил, "с инициатором заявки").Равно("owner1");

КонецПроцедуры

// Отвергнутая заявка ничего не пишет: иначе повторное нажатие затирало бы инициатора
// и момент уже идущего прогона.
&Тест
Процедура ОтвергнутаяЗаявкаСостоянияПрогонаНеТрогает() Экспорт

	Сервис = Новый ФейкСервисаЗеркал();
	Очередь = НоваяОчередьНад(Сервис);

	Очередь.Поставить(7, "owner1");
	Ожидаем.Что(Очередь.Поставить(7, "alice"), "повтор отвергнут").ЭтоЛожь();
	Ожидаем.Что(Сервис.ЗаявкиПрогона().Количество(), "записи о постановке ровно одна").Равно(1);

	Ожидаем.Что(Очередь.Поставить(0, "alice"), "пустой идентификатор отвергнут").ЭтоЛожь();
	Ожидаем.Что(Сервис.ЗаявкиПрогона().Количество(), "мусорная заявка до службы не дошла").Равно(1);

КонецПроцедуры

&Тест
Процедура ПустойИдентификаторЗаявкойНеСтановится() Экспорт

	Очередь = НоваяОчередь();

	Ожидаем.Что(Очередь.Поставить(0, "alice"), "нулевой идентификатор отвергнут").ЭтоЛожь();
	Ожидаем.Что(Очередь.Поставить("", "alice"), "пустой идентификатор отвергнут").ЭтоЛожь();
	Ожидаем.Что(Очередь.Размер(), "мусорных заявок в очереди нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Рабочий

&Тест
Процедура РабочийКрутитЦиклыПокаЕстьЕщё() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Движок.ОтдаватьЕстьЕщё(2); // два цикла с остатком, третий закрывает апстрим
	Сервис = НовыйСервис(5);
	Очередь = НоваяОчередь();
	Рабочий = НовыйРабочий(Очередь, Сервис, Движок, 10);

	Очередь.Поставить(5, "owner1");
	Итог = Рабочий.ОбработатьЗаявку();

	Ожидаем.Что(Итог.Взято, "заявка взята").ЭтоИстина();
	Ожидаем.Что(Итог.Циклов, "движок отработал три порции").Равно(3);
	Ожидаем.Что(Движок.Вызовов(), "и был вызван ровно столько раз").Равно(3);
	Ожидаем.Что(Итог.Возвращено, "дочитанное зеркало в очередь не возвращается").ЭтоЛожь();
	Ожидаем.Что(Очередь.Состояние(5), "зеркало отпущено").Равно("простаивает");

КонецПроцедуры

&Тест
Процедура ИтогБезПоляЕстьЕщёЗакрываетЗаявкуОднимЦиклом() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Движок.БезПоляЕстьЕщё();
	Очередь = НоваяОчередь();
	Рабочий = НовыйРабочий(Очередь, НовыйСервис(5), Движок, 10);

	Очередь.Поставить(5, "owner1");
	Итог = Рабочий.ОбработатьЗаявку();

	Ожидаем.Что(Итог.Циклов, "итог без ЕстьЕщё означает «апстрим пройден»").Равно(1);
	Ожидаем.Что(Итог.Возвращено, "и в очередь ничего не возвращается").ЭтоЛожь();

КонецПроцедуры

// Длинное зеркало не должно занимать рабочего навсегда: за заход — лимит циклов,
// остаток дочитывается следующей заявкой, соседи успевают пройти между ними.
&Тест
Процедура ЛимитЦикловЗаЗаходВозвращаетЗеркалоВХвост() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Движок.ОтдаватьЕстьЕщё(100); // апстрим «бесконечный»
	Очередь = НоваяОчередь();
	Сервис = НовыйСервис(5);
	Сервис.Добавить(6);
	Рабочий = НовыйРабочий(Очередь, Сервис, Движок, 2);

	Очередь.Поставить(5, "owner1");
	Очередь.Поставить(6, "owner1");
	Итог = Рабочий.ОбработатьЗаявку();

	Ожидаем.Что(Итог.Циклов, "за заход — не больше лимита циклов").Равно(2);
	Ожидаем.Что(Итог.Возвращено, "недочитанное зеркало возвращено в очередь").ЭтоИстина();
	Ожидаем.Что(Очередь.Состояние(5), "и снова ждёт своей очереди").Равно("поставлено");

	// КАКОЕ зеркало гонялось, а не только какое вернулось: без этого проверка «в хвост»
	// проходит и при LIFO — там оба конца очереди сходятся на одном и том же зеркале
	Ожидаем.Что(Итог.Зеркало, "разбиралась заявка старейшего зеркала").Равно(5);
	Ожидаем.Что(Движок.Зеркала()[0], "первый цикл движка — по нему же").Равно(5);
	Ожидаем.Что(Движок.Зеркала()[1], "и второй по нему же").Равно(5);
	Ожидаем.Что(Очередь.Забрать().ЗеркалоИдентификатор,
		"вернулось в ХВОСТ: сосед идёт раньше повторного захода").Равно(6);

КонецПроцедуры

&Тест
Процедура СбойЗеркалаИзолированИОчередьОтпущена() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Движок.Ронять();
	Очередь = НоваяОчередь();
	Рабочий = НовыйРабочий(Очередь, НовыйСервис(5), Движок, 10);

	Очередь.Поставить(5, "owner1");
	Итог = Рабочий.ОбработатьЗаявку(); // наружу не бросает

	Ожидаем.Что(Итог.Взято, "заявка всё равно считается разобранной").ЭтоИстина();
	Ожидаем.Что(Очередь.Состояние(5), "упавшее зеркало не остаётся вечно «идущим»").Равно("простаивает");
	Ожидаем.Что(Очередь.Поставить(5, "owner1"), "и принимает новую заявку").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИсчезнувшееЗеркалоСнимаетЗаявкуБезДвижка() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Очередь = НоваяОчередь();
	Сервис = НовыйСервис(5);
	Рабочий = НовыйРабочий(Очередь, Сервис, Движок, 10);

	Очередь.Поставить(5, "owner1");
	Сервис.Убрать(5); // зеркало удалили, пока заявка ждала
	Итог = Рабочий.ОбработатьЗаявку();

	Ожидаем.Что(Итог.Взято, "заявка взята").ЭтоИстина();
	Ожидаем.Что(Итог.Циклов, "движок не звался вовсе").Равно(0);
	Ожидаем.Что(Движок.Вызовов(), "и не получил ни одного вызова").Равно(0);
	Ожидаем.Что(Очередь.Состояние(5), "зеркало отпущено").Равно("простаивает");

КонецПроцедуры

// Журнал — не критичный путь: если он падает на записи о сбое, зеркало всё равно обязано
// быть отпущено, иначе оно заклинит в «идёт» до перезапуска процесса.
&Тест
Процедура УпавшийЖурналНеЗаклиниваетЗеркало() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Движок.Ронять();
	Очередь = НоваяОчередь();
	Рабочий = Новый РабочийСинхронизацииЗеркал(Очередь, НовыйСервис(5), Движок,
		Новый ГотовностьХаба(ЛогТестов()), ЧислаРабочего(1, 10), Новый ФейкПадающегоЛога());

	Очередь.Поставить(5, "owner1");
	Попытка
		Рабочий.ОбработатьЗаявку(); // журнал падает уже ПОСЛЕ отпускания зеркала
	Исключение
	КонецПопытки;

	Ожидаем.Что(Очередь.Состояние(5), "зеркало отпущено раньше записи в журнал").Равно("простаивает");
	Ожидаем.Что(Очередь.Поставить(5, "owner1"), "и принимает следующую заявку").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустаяОчередьРабочегоНеЗанимает() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Рабочий = НовыйРабочий(НоваяОчередь(), НовыйСервис(5), Движок, 10);

	Итог = Рабочий.ОбработатьЗаявку();

	Ожидаем.Что(Итог.Взято, "брать нечего").ЭтоЛожь();
	Ожидаем.Что(Движок.Вызовов(), "движок не тревожится на пустой очереди").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПлановаяЗадача

&Тест
Процедура ПлановаяЗадачаСтавитЗаявкиАНеСинкает() Экспорт

	Движок = Новый ФейкДвижкаСинхронизации();
	Сервис = НовыйСервис(1);
	Сервис.Добавить(2);
	Сервис.Добавить(3, Ложь); // выключенное зеркало плановой репликации не подлежит
	Очередь = НоваяОчередь();

	Задача = Новый ЗадачаСинхронизацииЗеркал(Очередь, Сервис);
	Задача.Исполнить();

	Ожидаем.Что(Очередь.Размер(), "поставлены только включённые зеркала").Равно(2);
	Ожидаем.Что(Очередь.Состояние(3), "выключенное зеркало не поставлено").Равно("простаивает");
	Ожидаем.Что(Движок.Вызовов(), "цикл планировщика синком не занят").Равно(0);

	// второй проход не плодит вторые заявки на те же зеркала
	Ожидаем.Что(Задача.ПоставитьВсе(), "повторный проход ничего не добавил").Равно(0);
	Ожидаем.Что(Очередь.Размер(), "очередь не выросла").Равно(2);

	// плановый запуск инициатора не имеет: по пустому логину экран печатает «по расписанию»
	Ожидаем.Что(Очередь.Забрать().ЗапустилИдентификатор, "плановая заявка без инициатора").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция НоваяОчередь()
	Возврат НоваяОчередьНад(Новый ФейкСервисаЗеркал());
КонецФункции

Функция НоваяОчередьНад(Знач Сервис)
	Возврат Новый ОчередьСинхронизацииЗеркал(Новый ПриведениеЧисел(), Сервис,
		ЧислаЗеркал(Истина, 100), ЛогТестов());
КонецФункции

Функция НовыйРабочий(Знач Очередь, Знач Сервис, Знач Движок, Знач МаксЦиклов)
	Возврат Новый РабочийСинхронизацииЗеркал(Очередь, Сервис, Движок, Новый ГотовностьХаба(ЛогТестов()),
		ЧислаРабочего(1, МаксЦиклов), ЛогТестов());
КонецФункции

// Рубильник и потолок очереди живут в настройках хаба и спрашиваются на каждый вызов.
Функция ЧислаЗеркал(Знач Включена, Знач Потолок)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.sync_enabled", Включена);
	Настройки.Задать("oshub.mirror.queue_max", Потолок);
	Возврат Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);
КонецФункции

Функция ЧислаРабочего(Знач ОпросСек, Знач ЦикловЗаЗаход)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.sync_enabled", Истина);
	Настройки.Задать("oshub.mirror.queue_poll_sec", ОпросСек);
	Настройки.Задать("oshub.mirror.cycles_per_turn", ЦикловЗаЗаход);
	Возврат Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);
КонецФункции

Функция НовыйСервис(Знач Идентификатор)
	Сервис = Новый ФейкСервисаЗеркал();
	Сервис.Добавить(Идентификатор);
	Возврат Сервис;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.зеркала");
КонецФункции


#КонецОбласти
