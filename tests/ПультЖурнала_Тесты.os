// Пульт журнала на настоящем контейнере: загрузка настроек связывает журнал, autumn-logos
// раздаёт логам выходы хаба, пульт правит логи на лету — и набор смотрит, куда после правки
// уходит строка: в консоль, в память и в коллектор (мост коллектора подменён ловушкой).

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать logos
#Использовать opentelemetry
#Использовать "фикстуры"

Перем Поделка;
Перем Пульт;           // ПультЖурнала
Перем ПечатьКонсоли;   // ЛовушкаЛога на месте печати консоли хаба
Перем Мост;            // МостКоллектораЛовушка — что уехало бы в коллектор
Перем Память;          // ПамятьЖурнала
Перем Проба;           // ПробаПультаЖурнала — логи набора
Перем Летопись;        // ЛетописьПультаЛовушка — что ушло бы в журнал аудита
Перем Раньше;          // Лог, созданный до связки журнала
Перем Напрямую;        // Лог, взятый у logos напрямую после связки

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = КаталогМодулей();
	ПоискКлассов.ПодключитьОснову(Модули);
	Журнал = ОбъединитьПути(Модули, "наблюдаемость", "Классы");
	Для Каждого Имя Из СтрРазделить("ВыводЛогаВКонсольХаба,ВыводЛогаВOTelХаба,ВыводЛогаВПамятьХаба,"
		+ "КольцоЖурнала,ПамятьЖурнала,УровниЖурнала,ЛогиПроцесса,СтартЖурнала,ЗаданноеСЭкрана,"
		+ "ГруппыЛогов,ПутиЖурнала,ЗакреплениеЖурнала,ШкалаЖурнала,ПультЖурнала", ",") Цикл
		ПоискКлассов.Подключить(Журнал, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ИменаПеременныхОкружения");
	Для Каждого Имя Из СтрРазделить("РасположениеДанных,ИсточникиНастроек,ЗагрузкаНастроек", ",") Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ПробаПультаЖурнала,ЛетописьПультаЛовушка,МостКоллектораЛовушка,"
		+ "ЛовушкаЛога,ЧтениеПультаПотоком,ПравкиПультаПотоком", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	// лог библиотеки, созданный раньше связки: настройки хаба до него не доходят
	Раньше = Логирование.ПолучитьЛог("пульт.раньше");

	Загрузка = Новый ЗагрузкаНастроек("", ВыходыСервера());
	Детальки = Загрузка.ДеталькиПоверх(ФайлОператора(), ОкружениеОператора());
	Детальки.Вставить("winow.КаталогСПриложениями", Модули);

	Совет = Новый СоветДругогоМастера();
	Совет.ИмяФайлаСоЗначениямиДеталек("пульт-журнала-без-файла");
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	ПечатьКонсоли = Новый ЛовушкаЛога();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Поделка.НайтиЖелудь("ВыводЛогаВКонсольХаба"), "Печать", ПечатьКонсоли);
	Мост = Поделка.НайтиЖелудь("ОтелАппендерLogos");
	Память = Поделка.НайтиЖелудь("ПамятьЖурнала");
	Проба = Поделка.НайтиЖелудь("ПробаПультаЖурнала");
	Летопись = Поделка.НайтиЖелудь("ЛетописьПультаЖурнала");
	Пульт = Поделка.НайтиЖелудь("ПультЖурнала");

	// лог, взятый у logos напрямую после связки: выходы ему logos создаёт сама, мимо контейнера
	Напрямую = Логирование.ПолучитьЛог("пульт.напрямую");

КонецПроцедуры

// Корень и каждый правимый лог — к старту одной правкой: следующий тест начинает с чистого.
&ПослеКаждого
Процедура ВернутьПравимоеКСтарту() Экспорт
	Правимые = Имена("rootLogger");
	Для Каждого Узел Из Пульт.Логи() Цикл
		Если НЕ Узел.ТолькоЧтение Тогда
			Правимые.Добавить(Узел.Имя);
		КонецЕсли;
	КонецЦикла;
	Пульт.ВернутьКСтарту(Правимые, "тест");
КонецПроцедуры

#Область Узлы

&Тест
Процедура КореньОписанКакОнСтартовал() Экспорт

	Корень = Пульт.Корень();

	Ожидаем.Что(Корень.Имя, "имя корня").Равно("rootLogger");
	Ожидаем.Что(Корень.Группа, "у корня нет ветки").Равно("");
	Ожидаем.Что(Корень.УровеньПриСтарте, "корень по умолчанию").Равно("INFO");
	Ожидаем.Что(Корень.ОткудаПриСтарте).Равно("умолчание");
	Ожидаем.Что(Корень.УровеньДействующий).Равно("INFO");
	Ожидаем.Что(Корень.ВКонсоль И Корень.ВПамять И Корень.ВOTel И Корень.МожноВOTel,
		"корень пишет во все выходы сервера").ЭтоИстина();
	Ожидаем.Что(Корень.УровеньСЭкрана, "с экрана ничего").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЛогПоднятыйНастройкойНазванСвоимИИсточником() Экспорт

	Поднят = Узел("пульт.поднят");
	Ожидаем.Что(Поднят.УровеньПриСтарте, "уровень старта").Равно("DEBUG");
	Ожидаем.Что(Поднят.СвойПриСтарте, "назван ему").ЭтоИстина();
	Ожидаем.Что(Поднят.ОткудаПриСтарте, "окружением").Равно("окружение");
	Ожидаем.Что(Поднят.ИмяНастройки, "переменной").Равно("OSHUB_LOG_LEVELS");
	Ожидаем.Что(Поднят.УровеньДействующий, "и пишет с ним").Равно("DEBUG");
	Ожидаем.Что(Поднят.Группа, "библиотечный лог — по имени").Равно("библиотеки/пульт");

	Сосед = Узел("пульт.сосед");
	Ожидаем.Что(Сосед.СвойПриСтарте, "сосед живёт на корне").ЭтоЛожь();
	Ожидаем.Что(Сосед.УровеньПриСтарте, "уровнем корня").Равно("INFO");

КонецПроцедуры

&Тест
Процедура ВыходыЛогаНазваныКакЕсть() Экспорт

	Порог = Узел("пульт.порог");
	Ожидаем.Что(Порог.ВOTel, "в коллектор").ЭтоИстина();
	Ожидаем.Что(Порог.ПорогOTel, "только с порога").Равно("WARN");

	БезКоллектора = Узел("пульт.безколлектора");
	Ожидаем.Что(БезКоллектора.ВКонсоль И БезКоллектора.ВПамять, "консоль и память").ЭтоИстина();
	Ожидаем.Что(БезКоллектора.ВOTel, "не в коллектор").ЭтоЛожь();
	Ожидаем.Что(БезКоллектора.МожноВOTel, "узел файла коллектор не назвал — выхода туда нет").ЭтоЛожь();

	Отключён = Узел("пульт.отключён");
	Ожидаем.Что(Отключён.ВOTel, "порог DISABLE — в коллектор не идёт").ЭтоЛожь();
	Ожидаем.Что(Отключён.МожноВOTel, "но выход на месте — отправку можно включить").ЭтоИстина();

	ПорогИнфо = Узел("пульт.порогинфо");
	Ожидаем.Что(ПорогИнфо.ПорогOTel, "заданный порог назван, хоть сейчас и не сужает").Равно("INFO");
	Ожидаем.Что(Узел("пульт.сосед").ПорогOTel, "без порога — Неопределено").Равно(Неопределено);

	Прямой = Узел("пульт.напрямую");
	Ожидаем.Что(Прямой.ВКонсоль, "лог мимо контейнера печатает в консоль").ЭтоИстина();
	Ожидаем.Что(Прямой.ВПамять, "но его выход памяти немой").ЭтоЛожь();
	Ожидаем.Что(Прямой.МожноВOTel, "и до коллектора он не доходит").ЭтоЛожь();
	Ожидаем.Что(Прямой.ТолькоЧтение, "уровень ему править можно").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЛогСЧужимВыходомИЛогДоНастроекТолькоДляЧтения() Экспорт

	Чужой = Узел("пульт.чужой");
	Ожидаем.Что(Чужой.ТолькоЧтение, "лог с выходом, повешенным кодом").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Чужой.ПрочиеВыходы, ","), "чужой выход назван").Равно("ЛовушкаЛога");

	Ожидаем.Что(Чужой.ПочемуТолькоЧтение, "причина — журнал аудита").Равно("audit");

	Ранний = Узел("пульт.раньше");
	Ожидаем.Что(Ранний.ТолькоЧтение, "лог, созданный раньше настроек").ЭтоИстина();
	Ожидаем.Что(Ранний.ПочемуТолькоЧтение, "причина — раньше настроек").Равно("before_wiring");
	Ожидаем.Что(Узел("пульт.сосед").ПочемуТолькоЧтение, "правимый лог причины не несёт").Равно("");
	Ожидаем.Что(Ранний.ВПамять ИЛИ Ранний.ВOTel ИЛИ Ранний.МожноВOTel, "мимо памяти и коллектора")
		.ЭтоЛожь();
	Ожидаем.Что(Ранний.ОткудаПриСтарте, "живёт умолчанием logos").Равно("умолчание");
	Ожидаем.Что(Ранний.СвойПриСтарте, "а не уровнем корня").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтрокиЗаМинутуСчитаютсяПоЛогу() Экспорт

	Для Номер = 1 По 3 Цикл
		Проба.Лог("пульт.другой").Информация("строка темпа " + Номер);
	КонецЦикла;

	Ожидаем.Что(Узел("пульт.другой").СтрокЗаМинуту >= 3, "три строки за минуту видны").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Уровень

&Тест
Процедура ПоднятыйДоDEBUGЛогПишетОтладкуВПамятьИКоллекторАСоседиНет() Экспорт

	Пульт.ЗадатьУровень(Имена("пульт.сосед"), "DEBUG", "root");
	Метка = Метка();
	Проба.Лог("пульт.сосед").Отладка("отладка соседа " + Метка);
	Проба.Лог("пульт.другой").Отладка("отладка другого " + Метка);

	Ожидаем.Что(СтрокПамяти("отладка соседа " + Метка), "отладка поднятого — в памяти").Равно(1);
	Ожидаем.Что(СтрокКоллектора("пульт.сосед", Метка), "и в коллекторе").Равно(1);
	Ожидаем.Что(СтрокКонсоли("отладка соседа " + Метка), "и в консоли").Равно(1);
	Ожидаем.Что(СтрокПамяти("отладка другого " + Метка), "отладки соседа по корню нет нигде").Равно(0);
	Ожидаем.Что(СтрокКоллектора("пульт.другой", Метка)).Равно(0);

	Сосед = Узел("пульт.сосед");
	Ожидаем.Что(Сосед.УровеньДействующий).Равно("DEBUG");
	Ожидаем.Что(Сосед.УровеньСЭкрана, "задан с экрана").Равно("DEBUG");
	Ожидаем.Что(Сосед.ЗаданоКем, "кем").Равно("root");
	Ожидаем.Что(ТипЗнч(Сосед.ЗаданоКогда), "когда").Равно(Тип("Дата"));

КонецПроцедуры

&Тест
Процедура ПравкуВидитФоновыйПоток() Экспорт

	Пульт.ЗадатьУровень(Имена("пульт.другой"), "DEBUG", "root");
	Метка = Метка();

	Параметры = Новый Массив();
	Параметры.Добавить("пульт.другой");
	Параметры.Добавить("отладка из фона " + Метка);
	Задание = ФоновыеЗадания.Выполнить(Проба, "ОтладкаИзФона", Параметры);
	Ожидаем.Что(Задание.ОжидатьЗавершения(30000), "фон дописал").ЭтоИстина();

	Ожидаем.Что(СтрокПамяти("отладка из фона " + Метка), "строку фонового потока видно в памяти").Равно(1);

КонецПроцедуры

&Тест
Процедура ПравкаКорняНеТрогаетЛогСоСвоимУровнем() Экспорт

	Пульт.ЗадатьУровень(Имена("пульт.другой"), "ERROR", "root");
	Пульт.ЗадатьУровеньКорню("DEBUG", "root");
	Метка = Метка();

	Проба.Лог("пульт.сосед").Отладка("сосед на корне " + Метка);
	Проба.Лог("пульт.свой").Информация("свой WARN из настроек " + Метка);
	Проба.Лог("пульт.другой").Предупреждение("другой ERROR с экрана " + Метка);
	Раньше.Отладка("ранний лог " + Метка);

	Ожидаем.Что(СтрокПамяти("сосед на корне " + Метка), "логу на корне правка корня дошла").Равно(1);
	Ожидаем.Что(СтрокПамяти("свой WARN из настроек " + Метка), "свой уровень настройки цел").Равно(0);
	Ожидаем.Что(СтрокПамяти("другой ERROR с экрана " + Метка), "свой уровень с экрана цел").Равно(0);
	Ожидаем.Что(Узел("пульт.раньше").УровеньДействующий, "ранний лог пульт не трогает").Равно("INFO");
	Ожидаем.Что(Узел("пульт.чужой").УровеньДействующий, "лог только для чтения — тоже").Равно("INFO");
	Ожидаем.Что(Пульт.Корень().УровеньДействующий, "корень").Равно("DEBUG");

	Ожидаем.Что(Пульт.ВернутьКСтарту(Имена("rootLogger"), "root").Применено.Количество(), "вернулся корень")
		.Равно(1);
	Ожидаем.Что(Узел("пульт.сосед").УровеньДействующий, "лог на корне — с ним").Равно("INFO");
	Ожидаем.Что(Узел("пульт.другой").УровеньДействующий, "а заданный с экрана — нет").Равно("ERROR");

КонецПроцедуры

#КонецОбласти

#Область Отправка

&Тест
Процедура ВыключеннаяОтправкаМолчитТолькоВКоллекторе() Экспорт

	Пульт.ОтправлятьВOTel(Имена("пульт.сосед"), Ложь, "root");
	Метка = Метка();
	Проба.Лог("пульт.сосед").Информация("без коллектора " + Метка);

	Ожидаем.Что(СтрокПамяти(Метка), "в память строка идёт").Равно(1);
	Ожидаем.Что(СтрокКоллектора("пульт.сосед", Метка), "в коллектор — нет").Равно(0);

	Сосед = Узел("пульт.сосед");
	Ожидаем.Что(Сосед.ВOTel, "узел это называет").ЭтоЛожь();
	Ожидаем.Что(Сосед.OTelСЭкрана, "с экрана").ЭтоИстина();
	Ожидаем.Что(Сосед.OTelЗаданКем).Равно("root");

КонецПроцедуры

&Тест
Процедура ПорогКоллектораТолькоСужает() Экспорт

	Пульт.ОтправлятьВOTel(Имена("пульт.сосед"), Истина, "root", "", "DEBUG");
	Метка = Метка();
	Проба.Лог("пульт.сосед").Отладка("порог ниже уровня " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.сосед", Метка), "порог ниже уровня лога отладку не открыл").Равно(0);
	Ожидаем.Что(СтрокПамяти(Метка), "и в память её нет").Равно(0);

	Пульт.ЗадатьУровень(Имена("пульт.сосед"), "DEBUG", "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.сосед"), Истина, "root", "", "WARN");
	Метка = Метка();
	Проба.Лог("пульт.сосед").Отладка("отладка под порогом " + Метка);
	Проба.Лог("пульт.сосед").Предупреждение("предупреждение над порогом " + Метка);
	Ожидаем.Что(СтрокПамяти(Метка), "в память обе").Равно(2);
	Ожидаем.Что(СтрокКоллектора("пульт.сосед", "отладка под порогом " + Метка), "отладка под порогом").Равно(0);
	Ожидаем.Что(СтрокКоллектора("пульт.сосед", "предупреждение над порогом " + Метка)).Равно(1);
	Ожидаем.Что(Узел("пульт.сосед").ПорогOTel).Равно("WARN");

КонецПроцедуры

// Уровень лога, поднятый выше порога коллектора, не делает порог шире уровня.
&Тест
Процедура УровеньВышеПорогаНеРасширяетКоллектор() Экспорт

	Пульт.ЗадатьУровень(Имена("пульт.порог"), "ERROR", "root");
	Метка = Метка();
	Проба.Лог("пульт.порог").Предупреждение("предупреждение ниже уровня " + Метка);

	Ожидаем.Что(СтрокКоллектора("пульт.порог", Метка), "в коллектор не ушло").Равно(0);
	Ожидаем.Что(СтрокПамяти(Метка), "и в память тоже").Равно(0);
	Ожидаем.Что(Узел("пульт.порог").ПорогOTel, "заданный порог назван и тогда, когда не сужает").Равно("WARN");

	Пульт.ВернутьКСтарту(Имена("пульт.порог"), "root");
	Метка = Метка();
	Проба.Лог("пульт.порог").Отладка("отладка после возврата " + Метка);
	Проба.Лог("пульт.порог").Предупреждение("предупреждение после возврата " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.порог", "отладка после возврата " + Метка), "возврат — снова порог WARN")
		.Равно(0);
	Ожидаем.Что(СтрокКоллектора("пульт.порог", "предупреждение после возврата " + Метка)).Равно(1);

КонецПроцедуры

// Порог INFO при уровне INFO ничего не сужает, но задан: лог, поднятый до DEBUG, отладку
// в коллектор не шлёт — в память и в консоль шлёт.
&Тест
Процедура ПорогINFOНеПускаетОтладкуПоднятогоЛогаВКоллектор() Экспорт

	Пульт.ЗадатьУровень(Имена("пульт.порогинфо"), "DEBUG", "root");
	Метка = Метка();
	Проба.Лог("пульт.порогинфо").Отладка("отладка при пороге INFO " + Метка);
	Проба.Лог("пульт.порогинфо").Информация("сведение при пороге INFO " + Метка);

	Ожидаем.Что(СтрокПамяти("отладка при пороге INFO " + Метка), "отладка в памяти").Равно(1);
	Ожидаем.Что(СтрокКоллектора("пульт.порогинфо", "отладка при пороге INFO " + Метка), "в коллекторе — нет")
		.Равно(0);
	Ожидаем.Что(СтрокКоллектора("пульт.порогинфо", "сведение при пороге INFO " + Метка), "сведение — есть")
		.Равно(1);

	Пульт.ЗадатьУровеньКорню("DEBUG", "root");
	Пульт.ЗадатьУровень(Имена("пульт.сосед"), "DEBUG", "root");
	Проба.Лог("пульт.порогинфо").Отладка("отладка при корне DEBUG " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.порогинфо", "отладка при корне DEBUG " + Метка), "и при любой правке")
		.Равно(0);

КонецПроцедуры

// Отправка, выключенная при старте порогом DISABLE, включается с экрана, возврат выключает снова.
&Тест
Процедура ОтправкаВыключеннаяПриСтартеВключаетсяСЭкрана() Экспорт

	Пульт.ОтправлятьВOTel(Имена("пульт.отключён"), Истина, "root");
	Метка = Метка();
	Проба.Лог("пульт.отключён").Информация("после включения " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.отключён", Метка), "строка ушла в коллектор").Равно(1);
	Ожидаем.Что(Узел("пульт.отключён").ВOTel).ЭтоИстина();

	Пульт.ВернутьКСтарту(Имена("пульт.отключён"), "root");
	Метка = Метка();
	Проба.Лог("пульт.отключён").Информация("после возврата " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.отключён", Метка), "возврат — снова DISABLE").Равно(0);
	Ожидаем.Что(СтрокПамяти(Метка), "а память пишет").Равно(1);

КонецПроцедуры

// Тумблер «выкл → вкл» возвращает лог к его порогу, а не открывает коллектору всю отладку.
&Тест
Процедура ВключённаяСноваОтправкаСохраняетПорог() Экспорт

	Пульт.ОтправлятьВOTel(Имена("пульт.порог"), Ложь, "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.порог"), Истина, "root");
	Метка = Метка();
	Проба.Лог("пульт.порог").Отладка("отладка после вкл " + Метка);
	Проба.Лог("пульт.порог").Предупреждение("предупреждение после вкл " + Метка);

	Ожидаем.Что(СтрокКоллектора("пульт.порог", "отладка после вкл " + Метка), "отладка не ушла").Равно(0);
	Ожидаем.Что(СтрокКоллектора("пульт.порог", "предупреждение после вкл " + Метка)).Равно(1);
	Ожидаем.Что(Узел("пульт.порог").ПорогOTel, "порог прежний").Равно("WARN");

КонецПроцедуры

#КонецОбласти

#Область Возврат

&Тест
Процедура ВозвратКСтартуВозвращаетУровеньИОтправку() Экспорт

	Пульт.ЗадатьУровень(Имена("пульт.поднят"), "INFO", "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.поднят", "пульт.порог"), Ложь, "root");

	Ожидаем.Что(Пульт.ВернутьКСтарту(Имена("пульт.поднят", "пульт.порог"), "root").Применено.Количество(),
		"вернулись оба").Равно(2);

	Поднят = Узел("пульт.поднят");
	Ожидаем.Что(Поднят.УровеньДействующий, "лог, поднятый настройкой, снова поднят").Равно("DEBUG");
	Ожидаем.Что(Поднят.ВOTel, "и снова уходит в коллектор").ЭтоИстина();
	Ожидаем.Что(Поднят.УровеньСЭкрана, "с экрана ничего не осталось").Равно(Неопределено);
	Ожидаем.Что(Поднят.OTelСЭкрана).ЭтоЛожь();
	Ожидаем.Что(Узел("пульт.порог").ПорогOTel, "порог старта на месте").Равно("WARN");

	Метка = Метка();
	Проба.Лог("пульт.поднят").Отладка("после возврата " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.поднят", Метка), "отладка уходит в коллектор, как при старте")
		.Равно(1);

КонецПроцедуры

// Возврат корня и логов одним списком называет каждого, у кого было что снимать.
&Тест
Процедура ВозвратКорняИЛоговОднимСпискомСчитаетКаждого() Экспорт

	Пульт.ЗадатьУровеньКорню("WARN", "root");
	Пульт.ЗадатьУровень(Имена("пульт.сосед", "пульт.другой"), "DEBUG", "root");
	Показанные = Имена("rootLogger", "пульт.сосед");
	Показанные.Добавить("пульт.другой");
	Показанные.Добавить("пульт.свой");

	Итог = Пульт.ВернутьКСтарту(Показанные, "root");
	Ожидаем.Что(Итог.Применено.Количество(), "корень и два лога; у лога без правок с экрана снимать нечего").Равно(3);
	Ожидаем.Что(Итог.Применено.Найти("rootLogger") <> Неопределено, "корень назван").ЭтоИстина();
	Ожидаем.Что(Пульт.ВернутьКСтарту(Показанные, "root").Применено.Количество(), "второй раз возвращать нечего")
		.Равно(0);
	Ожидаем.Что(Узел("пульт.сосед").УровеньДействующий).Равно("INFO");

КонецПроцедуры

#КонецОбласти

#Область ТолькоЧтениеИОтказы

&Тест
Процедура ЛогТолькоДляЧтенияНеПравитсяАГрупповаяПравкаЕгоПропускает() Экспорт

	Ожидаем.Что(Отказ("ЗадатьУровень", Имена("пульт.чужой"), "DEBUG"), "названный один — отказ")
		.Равно("log.read_only");

	Пульт.ЗадатьУровень(Имена("пульт.чужой", "пульт.сосед"), "WARN", "root");
	Ожидаем.Что(Узел("пульт.сосед").УровеньДействующий, "соседу задано").Равно("WARN");
	Ожидаем.Что(Узел("пульт.чужой").УровеньДействующий, "чужой пропущен").Равно("INFO");
	Ожидаем.Что(СтрСоединить(Летопись.Последняя().Правка.Пропущены, ","), "и назван пропущенным")
		.Равно("пульт.чужой");

	Пульт.ЗадатьУровеньКорню("CRITICALERROR", "root");
	Метка = Метка();
	Проба.Лог("пульт.чужой").Информация("строка чужого выхода " + Метка);
	Ожидаем.Что(СтрНайти(Проба.ЧужойВыход().Всё(), Метка) > 0, "чужой выход продолжает писать")
		.ЭтоИстина();

КонецПроцедуры

// Правка списком, в котором нечего править, отвергается целиком и в аудит не пишется; логи только
// для чтения вперемешку с правимыми пропускаются; пустой список — не правка. Так у всех правок списком.
&Тест
Процедура СписокБезПравимыхОтвергаетсяСмешанныйПропускаетПустойНеПравка() Экспорт

	Записей = Летопись.Записи.Количество();
	Для Каждого Метод Из ПравкиСписком() Цикл
		Ожидаем.Что(Отказ(Метод, Имена("пульт.чужой", "пульт.раньше"), ЗначениеПравки(Метод)),
			Метод + ": все только для чтения — отказ").Равно("log.read_only");
		Пустая = ПравкаСписком(Метод, Новый Массив(), ЗначениеПравки(Метод));
		Ожидаем.Что(Пустая.Применено.Количество() + Пустая.Пропущено.Количество(),
			Метод + ": пустой список — не правка").Равно(0);
	КонецЦикла;
	Ожидаем.Что(Летопись.Записи.Количество(), "ни отказ, ни пустой список в аудит не пишутся").Равно(Записей);

	// возврат идёт последним: ему есть что снять после уровня и отправки
	Для Каждого Метод Из ПравкиСписком() Цикл
		Смешанная = ПравкаСписком(Метод, Имена("пульт.чужой", "пульт.сосед"), ЗначениеПравки(Метод));
		Ожидаем.Что(СтрСоединить(Смешанная.Применено, ","), Метод + ": правимый правится").Равно("пульт.сосед");
		Ожидаем.Что(СтрСоединить(Смешанная.Пропущено, ","), Метод + ": только для чтения пропущен")
			.Равно("пульт.чужой");
		Ожидаем.Что(СтрСоединить(Летопись.Последняя().Правка.Пропущены, ","), Метод + ": и назван в аудите")
			.Равно("пульт.чужой");
	КонецЦикла;
	Ожидаем.Что(Летопись.Записи.Количество() - Записей, "по записи на смешанную правку").Равно(3);
	Ожидаем.Что(Узел("пульт.чужой").УровеньДействующий, "лог только для чтения не тронут").Равно("INFO");

КонецПроцедуры

&Тест
Процедура ОтказыНазваныКодомВНачалеТекста() Экспорт

	Записей = Летопись.Записи.Количество();
	Ожидаем.Что(Отказ("ЗадатьУровень", Имена("пульт.сосед"), "TRACE"), "уровня нет").Равно("log.unknown_level");
	Ожидаем.Что(Отказ("ЗадатьУровень", Имена("пульт.сосед", "нет.такого.лога"), "DEBUG"),
		"лога нет").Равно("log.unknown_logger");
	Ожидаем.Что(Узел("пульт.сосед").УровеньДействующий, "правка с незнакомым логом не применена целиком")
		.Равно("INFO");
	Ожидаем.Что(Отказ("ОтправлятьВOTel", Имена("пульт.безколлектора"), Истина), "выхода в коллектор нет")
		.Равно("log.otel_unreachable");
	Ожидаем.Что(Отказ("ОтправлятьВOTel", Имена("пульт.напрямую"), Ложь), "лог мимо контейнера — тоже")
		.Равно("log.otel_unreachable");
	Ожидаем.Что(Летопись.Записи.Количество(), "отказ в летопись не пишется").Равно(Записей);

КонецПроцедуры

#КонецОбласти

#Область Летопись

&Тест
Процедура КаждаяПравкаОднойЗаписьюКтоИСКакогоНаКакое() Экспорт

	Было = Летопись.Записи.Количество();

	Пульт.ЗадатьУровень(Имена("пульт.сосед", "пульт.другой"), "DEBUG", "admin1", "198.51.100.1");
	Уровень = Летопись.Последняя();
	Ожидаем.Что(Уровень.Правка.АдресIP, "адрес клиента").Равно("198.51.100.1");
	Ожидаем.Что(Уровень.Действие).Равно("уровень");
	Ожидаем.Что(Уровень.Правка.Кто).Равно("admin1");
	Ожидаем.Что(Уровень.Правка.Стало).Равно("DEBUG");
	Ожидаем.Что(Уровень.Правка.Было["пульт.сосед"], "с какого: своего не было — как у корня").Равно("DEFAULT");
	Ожидаем.Что(Уровень.Правка.Было["пульт.другой"], "групповая правка называет каждый лог").Равно("DEFAULT");

	Пульт.ОтправлятьВOTel(Имена("пульт.сосед"), Ложь, "admin1", "203.0.113.7");
	Отправка = Летопись.Последняя();
	Ожидаем.Что(Отправка.Действие).Равно("отправка");
	Ожидаем.Что(Отправка.Правка.АдресIP, "адрес клиента доходит до записи").Равно("203.0.113.7");
	Ожидаем.Что(Отправка.Правка.Было["пульт.сосед"], "своей отправки не было — как у корня").Равно("DEFAULT");
	Ожидаем.Что(Отправка.Правка.Стало["пульт.сосед"]).Равно("DISABLE");

	Пульт.ВернутьКСтарту(Имена("пульт.сосед"), "admin1");
	Возврат_ = Летопись.Последняя();
	Ожидаем.Что(Возврат_.Действие).Равно("возврат");
	Ожидаем.Что(Возврат_.Правка.Было["пульт.сосед"].Уровень).Равно("DEBUG");
	Ожидаем.Что(Возврат_.Правка.Было["пульт.сосед"].Отправка).Равно("DISABLE");
	Ожидаем.Что(Возврат_.Правка.Стало["пульт.сосед"].Уровень, "вернулся на корень").Равно("DEFAULT");
	Ожидаем.Что(Возврат_.Правка.Стало["пульт.сосед"].Отправка, "и отправка — как у корня").Равно("DEFAULT");

	Пульт.ОтправлятьВOTel(Имена("пульт.порог"), Истина, "admin1", "", "ERROR");
	Ожидаем.Что(Летопись.Последняя().Правка.Было["пульт.порог"], "свой порог настройки назван словом")
		.Равно("WARN");
	Пульт.ЗадатьУровень(Имена("пульт.свой"), "DEBUG", "admin1");
	Ожидаем.Что(Летопись.Последняя().Правка.Было["пульт.свой"], "свой уровень настройки назван словом")
		.Равно("WARN");
	Ожидаем.Что(Возврат_.Правка.Возвращено, "сняли и уровень, и отправку").Равно("всё");

	Ожидаем.Что(Летопись.Записи.Количество() - Было, "пять правок — пять записей").Равно(5);

КонецПроцедуры

// Повторная отправка той же формы: правка тем же значением в аудит не пишется.
&Тест
Процедура ПовторнаяПравкаТемЖеЗначениемНеПравка() Экспорт

	Пульт.ЗадатьУровень(Имена("пульт.сосед"), "DEBUG", "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.порог"), Истина, "root", "", "ERROR");
	Было = Летопись.Записи.Количество();

	Пульт.ЗадатьУровень(Имена("пульт.сосед"), "DEBUG", "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.порог"), Истина, "root", "", "ERROR");
	Пульт.ОтправлятьВOTel(Имена("пульт.порог"), Истина, "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.отключён"), Ложь, "root");
	Пульт.ЗадатьУровень(Имена("пульт.свой"), "WARN", "root");
	Пульт.ЗадатьУровеньКорню("INFO", "root");

	Ожидаем.Что(Летопись.Записи.Количество() - Было, "ни одной новой записи").Равно(0);
	Ожидаем.Что(Узел("пульт.свой").УровеньСЭкрана, "свой уровень настройки повтором не закрепляется")
		.Равно(Неопределено);

КонецПроцедуры

// Явная правка уровня, равного унаследованному от корня, — правка: она закрепляет уровень за логом,
// и после возврата корня лог пишет выбранным.
&Тест
Процедура ЯвныйУровеньРавныйКорневомуЗакрепляетсяЗаЛогом() Экспорт

	Пульт.ЗадатьУровеньКорню("DEBUG", "root");
	Было = Летопись.Записи.Количество();

	Итог = Пульт.ЗадатьУровень(Имена("пульт.сосед"), "DEBUG", "root");
	Ожидаем.Что(СтрСоединить(Итог.Применено, ","), "правка применена").Равно("пульт.сосед");
	Ожидаем.Что(Летопись.Записи.Количество() - Было, "и записана").Равно(1);
	Запись = Летопись.Последняя().Правка;
	Ожидаем.Что(Запись.Было["пульт.сосед"], "было — как у корня, а не DEBUG корня").Равно("DEFAULT");
	Ожидаем.Что(Запись.Стало, "стало — свой DEBUG").Равно("DEBUG");

	Пульт.ВернутьКСтарту(Имена("rootLogger"), "root");
	Ожидаем.Что(Узел("пульт.сосед").УровеньДействующий, "корень вернулся, лог пишет выбранным").Равно("DEBUG");

КонецПроцедуры

// То же для отправки: явное «отправлять» у лога, чья отправка от корня, — правка.
&Тест
Процедура ЯвнаяОтправкаРавнаяКорневойЗакрепляетсяЗаЛогом() Экспорт

	Пульт.ОтправлятьВOTel(Имена("rootLogger"), Ложь, "root");
	Ожидаем.Что(Узел("пульт.сосед").ВOTel, "лог на корне перестал отправлять").ЭтоЛожь();

	Итог = Пульт.ОтправлятьВOTel(Имена("пульт.сосед", "пульт.порог"), Истина, "root");
	Ожидаем.Что(СтрСоединить(Итог.Применено, ","), "лог на корне закрепил отправку; свой порог — повтор")
		.Равно("пульт.сосед");
	Запись = Летопись.Последняя().Правка;
	Ожидаем.Что(Запись.Было["пульт.сосед"], "было — как у корня").Равно("DEFAULT");
	Ожидаем.Что(Запись.Стало["пульт.сосед"], "стало — своя отправка без порога").Равно("DEBUG");

	Пульт.ВернутьКСтарту(Имена("rootLogger"), "root");
	Ожидаем.Что(Узел("пульт.сосед").ВOTel, "корень вернулся, лог отправляет по своей правке").ЭтоИстина();

КонецПроцедуры

// Результат правки называет применённое и пропущенное; повтор — ни там, ни там.
&Тест
Процедура ПравкаНазываетПримененноеИПропущенное() Экспорт

	Итог = Пульт.ЗадатьУровень(Имена("пульт.сосед", "пульт.чужой"), "WARN", "root");
	Ожидаем.Что(СтрСоединить(Итог.Применено, ","), "применено").Равно("пульт.сосед");
	Ожидаем.Что(СтрСоединить(Итог.Пропущено, ","), "пропущен только для чтения").Равно("пульт.чужой");

	Повтор = Пульт.ЗадатьУровень(Имена("пульт.сосед"), "WARN", "root");
	Ожидаем.Что(Повтор.Применено.Количество() + Повтор.Пропущено.Количество(), "повтор — нигде").Равно(0);

КонецПроцедуры

// Корень в одном списке с логами: одна запись о логах, корень доходит до логов на корне.
&Тест
Процедура КореньВСпискеСЛогамиОднойПравкой() Экспорт

	Было = Летопись.Записи.Количество();
	Итог = Пульт.ЗадатьУровень(Имена("rootLogger", "пульт.свой"), "ERROR", "root");

	Ожидаем.Что(Итог.Применено.Количество(), "корень и лог").Равно(2);
	Ожидаем.Что(Летопись.Записи.Количество() - Было, "одной записью").Равно(1);
	Ожидаем.Что(Пульт.Корень().УровеньДействующий).Равно("ERROR");
	Ожидаем.Что(Узел("пульт.свой").УровеньДействующий).Равно("ERROR");
	Ожидаем.Что(Узел("пульт.сосед").УровеньДействующий, "лог на корне — за корнем").Равно("ERROR");

КонецПроцедуры

// Отправка корня доходит до логов, которым порог настройка не называла, и видна у узла корня.
&Тест
Процедура ОтправкаКорняДоходитДоЛоговБезСвоегоПорога() Экспорт

	Пульт.ОтправлятьВOTel(Имена("rootLogger"), Истина, "root", "", "ERROR");
	Корень = Пульт.Корень();
	Ожидаем.Что(Корень.ВOTel И Корень.OTelСЭкрана, "корень отправляет, задано с экрана").ЭтоИстина();
	Ожидаем.Что(Корень.ПорогOTel, "порог корня").Равно("ERROR");

	Метка = Метка();
	Проба.Лог("пульт.сосед").Предупреждение("сосед под порогом корня " + Метка);
	Проба.Лог("пульт.порог").Предупреждение("свой порог WARN " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.сосед", Метка), "лог на корне — порог корня").Равно(0);
	Ожидаем.Что(СтрокКоллектора("пульт.порог", Метка), "свой порог лога сильнее корня").Равно(1);

	Пульт.ОтправлятьВOTel(Имена("rootLogger"), Ложь, "root");
	Ожидаем.Что(Пульт.Корень().ВOTel, "корень выключен").ЭтоЛожь();
	Ожидаем.Что(Узел("пульт.сосед").ВOTel, "и лог на корне").ЭтоЛожь();
	Ожидаем.Что(Узел("пульт.порог").ВOTel, "а лог со своим порогом — нет").ЭтоИстина();

КонецПроцедуры

// Лог, все выходы которого настройка поставила на DISABLE, настроен: правится, отправку можно включить.
&Тест
Процедура ЛогСоВсемиВыходамиНаDISABLEНеСчитаетсяДоНастроек() Экспорт

	Молчит = Узел("пульт.молчит");
	Ожидаем.Что(Молчит.ТолькоЧтение, "лог правится").ЭтоЛожь();
	Ожидаем.Что(Молчит.ПочемуТолькоЧтение).Равно("");
	Ожидаем.Что(Молчит.МожноВOTel, "выход коллектора на месте").ЭтоИстина();
	Ожидаем.Что(Молчит.ВOTel ИЛИ Молчит.ВКонсоль ИЛИ Молчит.ВПамять, "и никуда не пишет").ЭтоЛожь();

	Пульт.ОтправлятьВOTel(Имена("пульт.молчит"), Истина, "root");
	Метка = Метка();
	Проба.Лог("пульт.молчит").Информация("включили " + Метка);
	Ожидаем.Что(СтрокКоллектора("пульт.молчит", Метка), "включённая отправка пишет").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Закрепление

&Тест
Процедура СтрокиЗакрепленияКладутЗаданноеПоверхНастроек() Экспорт

	Ожидаем.Что(Пульт.СтрокиДляЗакрепления().Количество(), "с экрана ничего — закреплять нечего").Равно(0);

	Пульт.ЗадатьУровень(Имена("пульт.сосед", "пульт.свой"), "DEBUG", "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.сосед"), Ложь, "root");
	Пульт.ЗадатьУровеньКорню("WARN", "root");

	Строки = ПоПеременным(Пульт.СтрокиДляЗакрепления());
	Ожидаем.Что(Строки["OSHUB_LOG_LEVEL"], "корень").Равно("WARN");
	Уровни = Пары(Строки["OSHUB_LOG_LEVELS"]);
	Ожидаем.Что(Уровни["пульт.сосед"], "заданное с экрана").Равно("DEBUG");
	Ожидаем.Что(Уровни["пульт.свой"], "с экрана сильнее настройки").Равно("DEBUG");
	Ожидаем.Что(Уровни["пульт.поднят"], "названное настройкой при старте не теряется").Равно("DEBUG");
	Пороги = Пары(Строки["OSHUB_LOG_OTEL_LEVELS"]);
	Ожидаем.Что(Пороги["пульт.сосед"], "не в коллектор").Равно("DISABLE");
	Ожидаем.Что(Пороги["пульт.порог"], "порог старта не теряется").Равно("WARN");
	Ожидаем.Что(Пороги["пульт.отключён"], "и DISABLE старта тоже").Равно("DISABLE");

КонецПроцедуры

// Хаб, поднятый с прежними настройками и строками закрепления поверх, пишет так же, как пишет
// сейчас после правок с экрана: уровень каждого лога и что уходит в коллектор.
&Тест
Процедура СтрокиЗакрепленияПоднимаютХабВТомЖеСостоянии() Экспорт

	Пульт.ЗадатьУровеньКорню("WARN", "root");
	Пульт.ЗадатьУровень(Имена("пульт.сосед", "пульт.свой"), "DEBUG", "root");
	Пульт.ЗадатьУровень(Имена("пульт.поднят"), "ERROR", "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.сосед"), Ложь, "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.отключён"), Истина, "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.порог"), Истина, "root", "", "ERROR");
	Пульт.ОтправлятьВOTel(Имена("пульт.порогинфо"), Ложь, "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.порогинфо"), Истина, "root");
	Пульт.ОтправлятьВOTel(Имена("пульт.молчит"), Истина, "root", "", "WARN");
	Пульт.ОтправлятьВOTel(Имена("rootLogger"), Истина, "root", "", "ERROR");

	Окружение = ОкружениеОператора();
	Для Каждого Строка_ Из Пульт.СтрокиДляЗакрепления() Цикл
		Знак = СтрНайти(Строка_, "=");
		Окружение.Вставить(СтрЗаменить(Лев(Строка_, Знак - 1), "_", "."), Сред(Строка_, Знак + 1));
	КонецЦикла;
	Загрузка = Новый ЗагрузкаНастроек("", ВыходыСервера());
	Детальки = Загрузка.ДеталькиПоверх(ФайлОператора(), Окружение);
	ПослеПерезапуска = Новый СтартЖурнала(Детальки.Получить("oshub.log.startup"), Новый ШкалаЖурнала());

	Логи = Поделка.НайтиЖелудь("ЛогиПроцесса");
	Разница = Новый Массив();
	Для Каждого Имя Из СтрРазделить("пульт.сосед,пульт.другой,пульт.свой,пульт.поднят,пульт.порог,"
		+ "пульт.порогинфо,пульт.отключён,пульт.молчит,пульт.безколлектора", ",") Цикл
		Сейчас = Логи.Состояние(Имя);
		Будет = ПослеПерезапуска.Лога(Имя);
		Показано = Узел(Имя);
		Было_ = СтрШаблон("%1/%2/%3/%4", Сейчас.Уровень, КоллекторСейчас(Сейчас), Показано.ПорогOTel,
			Показано.МожноВOTel);
		ЕстьКоллектор = Будет.Выходы.Найти("otel") <> Неопределено;
		Будет_ = СтрШаблон("%1/%2/%3/%4", Будет.Уровень, ?(ЕстьКоллектор, КоллекторПоСтарту(Будет), "DISABLE"),
			?(ЕстьКоллектор, ПорогПоСтарту(Будет.Порог), Неопределено), ЕстьКоллектор);
		Если Было_ <> Будет_ Тогда
			Разница.Добавить(СтрШаблон("%1: сейчас %2, после перезапуска %3", Имя, Было_, Будет_));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ПослеПерезапуска.Корень().Уровень, "корень").Равно(Пульт.Корень().УровеньДействующий);
	Ожидаем.Что(СтрСоединить(Разница, Символы.ПС), "уровень и коллектор после перезапуска те же").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Строки

&Тест
Процедура ХвостОтбираетВеткуИИменаБезРегистра() Экспорт

	Метка = Метка();
	Проба.Лог("пульт.сосед").Информация("строка ветки " + Метка);
	Напрямую.Информация("строка мимо памяти " + Метка);

	ПоИмени = Пульт.Хвост(Новый Структура("Логи, Содержит", Имена("ПУЛЬТ.СОСЕД"), Метка));
	Ожидаем.Что(ПоИмени.Количество(), "имя лога без регистра").Равно(1);
	Ожидаем.Что(ПоИмени[0].Лог).Равно("пульт.сосед");

	ПоВетке = Пульт.Хвост(Новый Структура("Группа, Содержит", "библиотеки/пульт", Метка));
	Ожидаем.Что(ПоВетке.Количество(), "ветка — логи с этим началом пути").Равно(1);
	Ожидаем.Что(Пульт.Хвост(Новый Структура("Группа, Содержит", "библиотеки/пуль", Метка)).Количество(),
		"ветка — целыми сегментами").Равно(0);

КонецПроцедуры

// Уровень из адреса ленты приходит как есть: слово не из перечня отбор не сужает и не роняет.
&Тест
Процедура ХвостСНепонятнымУровнемНеПадает() Экспорт

	Метка = Метка();
	Проба.Лог("пульт.сосед").Информация("строка отбора " + Метка);

	Ожидаем.Что(Пульт.Хвост(Новый Структура("УровеньНеНиже, Содержит", "TRACE", Метка)).Количество(),
		"незнакомое слово не сужает").Равно(1);
	Ожидаем.Что(Пульт.Хвост(Новый Структура("УровеньНеНиже, Содержит", "warn", Метка)).Количество(),
		"знакомое в любом регистре сужает").Равно(0);
	Ожидаем.Что(Пульт.Хвост(Новый Структура("Количество, После, Содержит", "много", "x", Метка)).Количество(),
		"нечисловые количество и номер — умолчание").Равно(1);

КонецПроцедуры

// Лента показывает ту же строку, что ушла в консоль: после двери обезличивания.
&Тест
Процедура СтрокаЛентыТаЖеЧтоВКонсоли() Экспорт

	Метка = Метка();
	Проба.Лог("пульт.сосед").Предупреждение("письмо не ушло segate@inbox.ru " + Метка);

	Лента = Пульт.Хвост(Новый Структура("Содержит", Метка));
	Ожидаем.Что(Лента.Количество()).Равно(1);
	Ожидаем.Что(Лента[0].Текст, "ящик снят дверью").Содержит("s***@inbox.ru");
	Ожидаем.Что(СтрНайти(Лента[0].Текст, "segate@"), "сырого ящика нет").Равно(0);
	Ожидаем.Что(СтрокКонсоли(Лента[0].Текст), "в консоли — та же строка").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Сведения

&Тест
Процедура ЖурналУходитВКоллекторТолькоСТелеметриейИЭкспортёром() Экспорт

	Ожидаем.Что(ПультСТелеметрией("true", "otlp").ЖурналУходитВКоллектор(), "телеметрия и otlp").ЭтоИстина();
	Ожидаем.Что(ПультСТелеметрией("true", "none").ЖурналУходитВКоллектор(), "экспортёр none").ЭтоЛожь();
	Ожидаем.Что(ПультСТелеметрией("false", "otlp").ЖурналУходитВКоллектор(), "телеметрия выключена").ЭтоЛожь();
	Ожидаем.Что(Пульт.ЖурналУходитВКоллектор(), "у набора телеметрия не включена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СчётПамятиИКольцоВажного() Экспорт

	До = Пульт.СчётПамяти();
	Метка = Метка();
	Проба.Лог("пульт.сосед").Информация("сведение " + Метка);
	Проба.Лог("пульт.сосед").Предупреждение("предупреждение " + Метка);
	После = Пульт.СчётПамяти();

	Ожидаем.Что(После.Всего - До.Всего, "записано две строки").Равно(2);
	Ожидаем.Что(После.Ёмкость, "ёмкость по умолчанию").Равно(2000);
	Ожидаем.Что(После.ЁмкостьВажного, "важному — четверть").Равно(500);
	Важное = Пульт.Хвост(Новый Структура("ТолькоВажное, Содержит", Истина, Метка));
	Ожидаем.Что(Важное.Количество(), "в кольце важного только предупреждение").Равно(1);
	Ожидаем.Что(Важное[0].Уровень).Равно("WARN");

КонецПроцедуры

// Память выключена: лента пуста без сбоя, счёт нулевой.
&Тест
Процедура ВыключеннаяПамятьДаётПустуюЛенту() Экспорт

	БезПамяти = ПультСТелеметрией("false", "otlp", Новый ПамятьЖурнала(0));
	Проба.Лог("пульт.сосед").Предупреждение("строка без памяти " + Метка());

	Ожидаем.Что(БезПамяти.Хвост().Количество(), "лента пуста").Равно(0);
	Ожидаем.Что(БезПамяти.СчётПамяти().Ёмкость, "ёмкость ноль").Равно(0);
	Ожидаем.Что(БезПамяти.СчётПамяти().ЁмкостьВажного, "и у важного").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Потоки

&Тест
Процедура ЧтениеПультаПодПравкамиНеПадает() Экспорт

	Читатели = Новый Массив();
	Задания = Новый Массив();
	Для Номер = 1 По 3 Цикл
		Читатель = Новый ЧтениеПультаПотоком(Пульт, Проба.Лог("пульт.другой"), 40);
		Читатели.Добавить(Читатель);
		Задания.Добавить(ФоновыеЗадания.Выполнить(Читатель, "Исполнить"));
	КонецЦикла;

	Для Круг = 1 По 40 Цикл
		Пульт.ЗадатьУровень(Имена("пульт.другой", "пульт.сосед"), ?(Круг % 2 = 0, "DEBUG", "WARN"), "root");
		Пульт.ОтправлятьВOTel(Имена("пульт.сосед"), Круг % 2 = 0, "root");
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.ОжидатьЗавершения(60000), "поток дочитал").ЭтоИстина();
	КонецЦикла;
	Для Каждого Читатель Из Читатели Цикл
		Ожидаем.Что(Читатель.Жалоба(), "чтение под правками без сбоев").Равно("");
	КонецЦикла;

КонецПроцедуры


// Два администратора правят одни и те же логи одновременно, третий поток читает: ни сбоя,
// ни потерянной правки — возврат к старту после них возвращает логи ровно к старту.
&Тест
Процедура ДваПишущихПотокаНеЛомаютПульт() Экспорт

	Общие = Имена("пульт.сосед", "пульт.другой");
	Потоки = Новый Массив();
	Потоки.Добавить(Новый ПравкиПультаПотоком(Пульт, Общие, 30, "admin1"));
	Потоки.Добавить(Новый ПравкиПультаПотоком(Пульт, Общие, 30, "admin2"));
	Читатель = Новый ЧтениеПультаПотоком(Пульт, Проба.Лог("пульт.порог"), 30);

	Задания = Новый Массив();
	Для Каждого Поток Из Потоки Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(Поток, "Исполнить"));
	КонецЦикла;
	Задания.Добавить(ФоновыеЗадания.Выполнить(Читатель, "Исполнить"));
	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.ОжидатьЗавершения(120000), "поток дописал").ЭтоИстина();
	КонецЦикла;

	Для Каждого Поток Из Потоки Цикл
		Ожидаем.Что(Поток.Жалоба(), "правки без сбоев").Равно("");
	КонецЦикла;
	Ожидаем.Что(Читатель.Жалоба(), "чтение без сбоев").Равно("");

	Пульт.ВернутьКСтарту(Общие, "root");
	Для Каждого Имя Из Общие Цикл
		Ожидаем.Что(Узел(Имя).УровеньДействующий, "вернулся к старту: " + Имя).Равно("INFO");
		Ожидаем.Что(Узел(Имя).ВOTel, "отправка вернулась: " + Имя).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Обвязка

// Второй пульт над теми же логами и памятью набора, но с другой телеметрией (и памятью).
Функция ПультСТелеметрией(Знач Включено, Знач Экспортёр, Знач ДругаяПамять = Неопределено)
	Возврат Новый ПультЖурнала(Поделка.НайтиЖелудь("ШкалаЖурнала"), Поделка.НайтиЖелудь("ЛогиПроцесса"),
		Поделка.НайтиЖелудь("СтартЖурнала"), Поделка.НайтиЖелудь("ГруппыЛогов"), Поделка.НайтиЖелудь("ПутиЖурнала"),
		?(ДругаяПамять = Неопределено, Память, ДругаяПамять), Поделка.НайтиЖелудь("ЗакреплениеЖурнала"),
		Летопись, Поделка.НайтиЖелудь("ПриведениеФлагов"), Включено, Экспортёр, Логирование.ПолучитьЛог("пульт.проба"));
КонецФункции

Функция ВыходыСервера()
	Выходы = Новый Соответствие();
	Выходы.Вставить("console", "ВыводЛогаВКонсольХаба");
	Выходы.Вставить("memory", "ВыводЛогаВПамятьХаба");
	Выходы.Вставить("otel", "ВыводЛогаВOTelХаба");
	Возврат Выходы;
КонецФункции

// Так переменные отдаёт провайдер окружения configor: ключ через точку.
Функция ОкружениеОператора()
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB.LOG.LEVELS", "пульт.свой=WARN,пульт.поднят=DEBUG,пульт.порог=DEBUG,"
		+ "пульт.безколлектора=DEBUG");
	Окружение.Вставить("OSHUB.LOG.OTEL.LEVELS", "пульт.порог=WARN,пульт.порогинфо=INFO,пульт.отключён=DISABLE,"
		+ "пульт.молчит=DISABLE");
	Возврат Окружение;
КонецФункции

// Узел logos.logger файла оператора: логу без коллектора — только консоль и память.
Функция ФайлОператора()

	Выходы = Новый Массив();
	Выходы.Добавить("console");
	Выходы.Добавить("memory");
	БезКоллектора = Новый Соответствие();
	БезКоллектора.Вставить("appenders", Выходы);
	БезКоллектора.Вставить("additivity", Ложь);

	Логгеры = Новый Соответствие();
	ТолькоКоллектор = Новый Соответствие();
	ТолькоКоллектор.Вставить("appenders", "otel");
	ТолькоКоллектор.Вставить("additivity", Ложь);

	Логгеры.Вставить("пульт.безколлектора", БезКоллектора);
	Логгеры.Вставить("пульт.молчит", ТолькоКоллектор);
	Узел = Новый Соответствие();
	Узел.Вставить("logger", Логгеры);
	Файл = Новый Соответствие();
	Файл.Вставить("logos", Узел);
	Возврат Файл;

КонецФункции

// С какого уровня лог шлёт в коллектор прямо сейчас; DISABLE — не шлёт.
Функция КоллекторСейчас(Знач Состояние)
	Если НЕ Состояние.ВКоллектор Тогда
		Возврат "DISABLE";
	КонецЕсли;
	Возврат ?(Состояние.УровеньВыходаКоллектора = Неопределено, Состояние.Уровень, Состояние.УровеньВыходаКоллектора);
КонецФункции

// Порог, который показал бы пульт у лога, стартовавшего с этим порогом: DEBUG и DISABLE порогом
// не показываются — первый ничего не сужает, второй выключает отправку.
Функция ПорогПоСтарту(Знач Порог)
	Возврат ?(ЗначениеЗаполнено(Порог) И Порог <> "DEBUG" И Порог <> "DISABLE", Порог, Неопределено);
КонецФункции

// С какого уровня лог слал бы в коллектор, стартовав так: порог только сужает.
Функция КоллекторПоСтарту(Знач Стартовал)
	Уровни = СтрРазделить("DEBUG,INFO,WARN,ERROR,CRITICALERROR,DISABLE", ",");
	Порог = Стартовал.Порог;
	Если Порог = "DISABLE" ИЛИ Стартовал.Уровень = "DISABLE" Тогда
		Возврат "DISABLE";
	ИначеЕсли ЗначениеЗаполнено(Порог) И Уровни.Найти(Порог) > Уровни.Найти(Стартовал.Уровень) Тогда
		Возврат Порог;
	КонецЕсли;
	Возврат Стартовал.Уровень;
КонецФункции

Функция Узел(Знач Имя)
	Для Каждого Узел_ Из Пульт.Логи() Цикл
		Если Узел_.Имя = Имя Тогда
			Возврат Узел_;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Пульт не знает лога " + Имя;
КонецФункции

// Код отказа — начало текста исключения до двоеточия; без отказа — пустая строка.
Функция Отказ(Знач Метод, Знач ИменаЛогов, Знач Значение)
	Попытка
		ПравкаСписком(Метод, ИменаЛогов, Значение);
	Исключение
		Описание = ИнформацияОбОшибке().Описание;
		Возврат Лев(Описание, СтрНайти(Описание, ":") - 1);
	КонецПопытки;
	Возврат "";
КонецФункции

// Правка списком имён от имени root: уровень, отправка либо возврат к старту (значение не нужно).
Функция ПравкаСписком(Знач Метод, Знач ИменаЛогов, Знач Значение)
	Если Метод = "ЗадатьУровень" Тогда
		Возврат Пульт.ЗадатьУровень(ИменаЛогов, Значение, "root");
	ИначеЕсли Метод = "ОтправлятьВOTel" Тогда
		Возврат Пульт.ОтправлятьВOTel(ИменаЛогов, Значение, "root");
	КонецЕсли;
	Возврат Пульт.ВернутьКСтарту(ИменаЛогов, "root");
КонецФункции

Функция ПравкиСписком()
	Возврат СтрРазделить("ЗадатьУровень,ОтправлятьВOTel,ВернутьКСтарту", ",");
КонецФункции

Функция ЗначениеПравки(Знач Метод)
	Если Метод = "ЗадатьУровень" Тогда
		Возврат "WARN";
	ИначеЕсли Метод = "ОтправлятьВOTel" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Имена(Знач Имя1, Знач Имя2 = "")
	Итог = Новый Массив();
	Итог.Добавить(Имя1);
	Если ЗначениеЗаполнено(Имя2) Тогда
		Итог.Добавить(Имя2);
	КонецЕсли;
	Возврат Итог;
КонецФункции

Функция ПоПеременным(Знач Строки)
	Итог = Новый Соответствие();
	Для Каждого Строка_ Из Строки Цикл
		Знак = СтрНайти(Строка_, "=");
		Итог.Вставить(Лев(Строка_, Знак - 1), Сред(Строка_, Знак + 1));
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция Пары(Знач Значение)
	Итог = Новый Соответствие();
	Для Каждого Пара Из СтрРазделить(Значение, ",", Ложь) Цикл
		Знак = СтрНайти(Пара, "=");
		Итог.Вставить(Лев(Пара, Знак - 1), Сред(Пара, Знак + 1));
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция Метка()
	Возврат "метка-" + Строка(Новый УникальныйИдентификатор());
КонецФункции

Функция СтрокКонсоли(Знач Фрагмент)
	Сколько = 0;
	Для Номер = 0 По ПечатьКонсоли.Количество() - 1 Цикл
		Если СтрНайти(ПечатьКонсоли.Сообщение(Номер), Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;
КонецФункции

Функция СтрокПамяти(Знач Фрагмент)
	Возврат Память.Хвост(Новый Структура("Содержит, Количество", Фрагмент, 100000)).Количество();
КонецФункции

Функция СтрокКоллектора(Знач ИмяЛога, Знач Фрагмент)
	Сколько = 0;
	Для Каждого Событие Из Мост.СобытияЛога(ИмяЛога) Цикл
		Если СтрНайти(Событие.Текст, Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
