// Интеграционные тесты инкрементального обхода зеркала на реальных бинах и фейковом клиенте
// апстрима: первый прогон полный, второй — инкрементом с момента, цена второго прогона
// в исходящих запросах, жизнь момента (оборванный обход его не двигает, потерянный даёт
// полный обход) и способ обхода в состоянии прогона и в журнале.
// Легаси-протокол здесь же: он инкремента не умеет, и это свойство источника.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать "фикстуры"

Перем Поделка;
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КореньДанных;
Перем КаталогOspx;
Перем НомерПула;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "описания", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"));
	// готовность хаба подключается первой: остальные классы наблюдаемости на неё ссылаются
	Попытка
		ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"), "ГотовностьХаба");
	Исключение
	КонецПопытки;
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "РазборАдреса");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТихаяУборка");
	ПоискКлассов.Подключить(Фикстуры, "НастройкиЗаглушка");

	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить();

	Для Каждого Имя Из КлассыЗеркал() Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "СекретИсточника");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "публикация", "Классы"), "МестоВПуле");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"), "ВалидаторАдресаВебхука");

	ПоискКлассов.Подключить(Фикстуры, "ФейкКлиентАпстрима");
	ПоискКлассов.Подключить(Фикстуры, "ФейкСервисЗеркалСинк");
	ПоискКлассов.Подключить(Фикстуры, "ФейкСервисПрав");
	ПоискКлассов.Подключить(Фикстуры, "ФейкРазрешительImён");
	ПоискКлассов.Подключить(Фикстуры, "ФикстураПакета");

	КореньДанных = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-mirror-inc-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньДанных);
	КаталогOspx = ОбъединитьПути(КореньДанных, "ospx");
	СоздатьКаталог(КаталогOspx);
	НомерПула = 0;

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньДанных);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "зеркало-инкремент-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	// Служба зеркал и сами источники собираются ПОСЛЕ старта, руками: желудями в этот
	// контейнер они не заезжают — источнику нужен КлиентАпстрима модуля прокси, которого
	// здесь нет, а набору нужен фейковый клиент, а не живой.
	Для Каждого Имя Из КлассыВнеКонтейнера() Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), Имя);
	КонецЦикла;
	// разбор страницы версий — протокол источника, живёт в прокси
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "РазборВерсийПакета");

КонецПроцедуры

&ПослеВсех
Процедура УбратьКорень() Экспорт
	Если ЗначениеЗаполнено(КореньДанных) И Новый Файл(КореньДанных).Существует() Тогда
		УдалитьФайлы(КореньДанных);
	КонецЕсли;
КонецПроцедуры

// Первый обход отсчитывать не от чего: источник перечисляется целиком, и только успешно
// закрытый обход оставляет момент, до которого источник вычитан.
&Тест
Процедура ПервыйПрогонПолныйИОставляетМомент() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);

	Итог = Синхронизатор(Клиент).Синхронизировать(Зеркало_);

	Ожидаем.Что(Итог.Скачано, "первый прогон привёз версию").Равно(1);
	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[0], "since="), "срез спрошен без момента").Равно(0);
	Ожидаем.Что(Состояние(Зеркало_).Способ, "обход назван полным").Равно("полный");
	Ожидаем.Что(Состояние(Зеркало_).ВычитаноДо, "и оставил момент, до которого источник вычитан")
		.Равно('20260812100000');

КонецПроцедуры

// НФТ-ЗЕРК-005: второй прогон по НЕ изменившемуся источнику стоит В РАЗЫ меньше первого.
// Меряется счётчиком исходящих, а не секундомером: перечисление стоит ОДИН запрос, имена
// по отдельности не перечисляются, скачиваний нет вовсе.
&Тест
Процедура ВторойПрогонПоНеизменившемусяИсточникуСтоитОдногоЗапроса() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0|beta:2.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);
	Синх = Синхронизатор(Клиент);

	Синх.Синхронизировать(Зеркало_);
	ЗапросовЗаПервый = Клиент.ПутиЗапросов().Количество();
	СкачиванийЗаПервый = Клиент.КоличествоСкачиваний();

	// источник не изменился: срез с момента прошлого обхода пуст
	Клиент.УстановитьОтветТекст(200, ПустойСрез("2026-08-12T11:00:00Z"));
	Итог = Синх.Синхронизировать(Зеркало_);

	ЗапросовЗаВторой = Клиент.ПутиЗапросов().Количество() - ЗапросовЗаПервый;
	Ожидаем.Что(ЗапросовЗаПервый, "первый прогон: срез плюс скачивание каждой версии").Равно(3);
	Ожидаем.Что(ЗапросовЗаВторой, "второй прогон: один запрос среза и больше ничего").Равно(1);
	Ожидаем.Что(Клиент.КоличествоСкачиваний() - СкачиванийЗаПервый,
		"по неизменившемуся источнику не качается ничего").Равно(0);
	Ожидаем.Что(Итог.Всего, "перечислять по именам тоже нечего").Равно(0);

	Запрос = Клиент.ПутиЗапросов()[ЗапросовЗаПервый];
	Ожидаем.Что(СтрНайти(Запрос, "since=2026-08-12T10%3A00%3A00") > 0,
		"второй прогон спрашивает изменения с момента первого: " + Запрос).ЭтоИстина();
	Ожидаем.Что(Состояние(Зеркало_).Способ, "и назван инкрементом").Равно("инкремент");
	Ожидаем.Что(Состояние(Зеркало_).СрезС, "с моментом отсчёта на экране").Равно('20260812100000');

КонецПроцедуры

// Инкремент не теряет: изменившееся приезжает следующим прогоном, а момент отсчёта
// ВКЛЮЧИТЕЛЕН — версия, изменившаяся ровно в момент среза, приедет ещё раз, но не пропадёт.
&Тест
Процедура ИзменившеесяПослеПрогонаПриезжаетСледующим() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);
	Синх = Синхронизатор(Клиент);

	Синх.Синхронизировать(Зеркало_);
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.1.0", "2026-08-12T11:00:00Z"));
	Итог = Синх.Синхронизировать(Зеркало_);

	Ожидаем.Что(Итог.Скачано, "изменение приехало следующим прогоном").Равно(1);
	Ожидаем.Что(ВерсийПакета(Пул, "alfa"), "обе версии в пуле").Равно(2);
	Ожидаем.Что(Состояние(Зеркало_).ВычитаноДо, "момент сдвинулся на срез второго прогона")
		.Равно('20260812110000');

КонецПроцедуры

// Обход, оборвавшийся на скачивании, момента НЕ двигает: иначе следующий инкремент начался бы
// за недовезённой версией, и она не приехала бы уже никогда.
&Тест
Процедура ОборванныйОбходМоментНеДвигает() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(0, Неопределено); // источник отвалился на скачивании
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);

	Итог = Синхронизатор(Клиент).Синхронизировать(Зеркало_);

	Ожидаем.Что(Итог.Недоступно, "версия не забрана").Равно(1);
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо),
		"момент не сдвинулся: обход ничего не довёз").ЭтоЛожь();

КонецПроцедуры

// Отказ скачивания, который в другой раз пройдёт (503, 500, 404), момента НЕ двигает:
// версия старше нового среза, и сдвинутый момент оставил бы её позади навсегда.
&Тест
Процедура УстранимыйОтказСкачиванияМоментНеДвигает() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(503, Неопределено); // источник перегружен
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);

	Итог = Синхронизатор(Клиент).Синхронизировать(Зеркало_);

	Ожидаем.Что(Итог.Скачано, "версия не приехала").Равно(0);
	Ожидаем.Что(Итог.Недоступно, "и сосчитана невзятой").Равно(1);
	Ожидаем.Что(Итог.Offline, "но источник не объявлен лежащим: он ответил").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо),
		"момент вычитки не сдвинут — версия приедет следующим прогоном").ЭтоЛожь();

КонецПроцедуры

// Та же развилка на квоте: место в пуле расширят, и версия приедет — момент ждёт.
&Тест
Процедура ОтказПоКвотеМоментНеДвигает() Экспорт

	Пул = ПулСКвотойПодЗавязку();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);

	Итог = Синхронизатор(Клиент).Синхронизировать(Зеркало_);

	Ожидаем.Что(Итог.Скачано, "в пул версия не влезла").Равно(0);
	Ожидаем.Что(Итог.Недоступно, "и сосчитана невзятой").Равно(1);
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо),
		"момент вычитки не сдвинут").ЭтоЛожь();

КонецПроцедуры

// Обратная сторона: пропуск НЕУСТРАНИМЫЙ момента не держит. Битый артефакт повтором
// не чинится, и обход, споткнувшийся о него, обязан двигаться дальше — иначе инкремент
// не включится никогда.
&Тест
Процедура НеустранимыйПропускМоментуНеМешает() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(200, ПолучитьДвоичныеДанныеИзСтроки("это не ospx"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);

	Итог = Синхронизатор(Клиент).Синхронизировать(Зеркало_);

	Ожидаем.Что(Итог.Пропущено, "битый артефакт пропущен").Равно(1);
	Ожидаем.Что(Итог.Недоступно, "невзятым он не считается: повтор ничего не изменит").Равно(0);
	Ожидаем.Что(Состояние(Зеркало_).ВычитаноДо, "момент вычитки сдвинут")
		.Равно('20260812100000');

КонецПроцедуры

// Источник, не ответивший на перечисление, момента тоже не оставляет — и следующий обход
// снова полный, а не «инкремент ниоткуда».
&Тест
Процедура НедоступныйИсточникМоментаНеОставляет() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(0, "");
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);

	Итог = Синхронизатор(Клиент).Синхронизировать(Зеркало_);

	Ожидаем.Что(Итог.Offline, "источник недоступен").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо), "момента нет").ЭтоЛожь();

КонецПроцедуры

// Потерянный момент — это полный обход, а не молчаливый пропуск: зеркало перечисляет
// источник целиком и наполняет пул заново.
&Тест
Процедура ПотерянныйМоментДаётПолныйОбход() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);
	Синх = Синхронизатор(Клиент);

	Синх.Синхронизировать(Зеркало_);
	ЗабытьМомент(Зеркало_);
	ЗапросовДо = Клиент.ПутиЗапросов().Количество();
	Синх.Синхронизировать(Зеркало_);

	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[ЗапросовДо], "since="),
		"срез спрошен без момента — обход полный").Равно(0);
	Ожидаем.Что(Состояние(Зеркало_).Способ, "и назван полным").Равно("полный");

КонецПроцедуры

// Смена доступа меняет и то, что источник показывает: момент снимается, следующий обход
// идёт полным — иначе открывшееся вместе с токеном зеркало пропустило бы.
&Тест
Процедура СменаТокенаСбрасываетМомент() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, ПустойСрез("2026-08-12T10:00:00Z"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);

	Синхронизатор(Клиент).Синхронизировать(Зеркало_);
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо), "момент есть").ЭтоИстина();

	СервисЗеркал().ЗадатьТокен(Администратор(), Пул, Зеркало_.Идентификатор, "sekret-42");

	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо),
		"смена токена сняла момент: следующий обход полный").ЭтоЛожь();

КонецПроцедуры

// Токен меняют и посреди обхода. Память идущего обхода снимается вся: его срез снят старым
// доступом, а курсор указывает в старый состав — продолжение дочитало бы прежний срез
// и объявило его вычитанным, потеряв всё, что открылось вместе с новым доступом.
&Тест
Процедура СменаТокенаПосредиОбходаНеОставляетНиМоментаНиКурсора() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);
	Синх = Синхронизатор(Клиент, 1);

	// первый обход полный и закрытый: он оставляет момент, с которого пойдёт инкремент
	Клиент.УстановитьОтветТекст(200, Срез("alfa:1.0.0", "2026-08-12T10:00:00Z"));
	Синх.Синхронизировать(Зеркало_);

	// второй обход инкрементный и в две порции: он встаёт на курсоре, помня свой срез
	Клиент.УстановитьОтветТекст(200,
		СрезСоШкалой("beta:2.0.0", "2026-08-12T12:00:00Z", 2, 0, Истина, "gamma"));
	Синх.Синхронизировать(Зеркало_);

	Ожидаем.Что(Состояние(Зеркало_).Курсор, "обход встал на курсоре").Равно("gamma");
	Ожидаем.Что(Состояние(Зеркало_).СрезС, "и помнит свой срез").Равно('20260812100000');

	СервисЗеркал().ЗадатьТокен(Администратор(), Пул, Зеркало_.Идентификатор, "sekret-42");

	Состояние_ = Состояние(Зеркало_);
	Ожидаем.Что(Состояние_.Курсор, "курсор старого состава снят").Равно("");
	Ожидаем.Что(ЗначениеЗаполнено(Состояние_.СрезС), "срез старого доступа снят").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Состояние_.ВычитаноДо), "и момента вычитки не осталось").ЭтоЛожь();
	Ожидаем.Что(Состояние_.Способ, "следующий обход полный").Равно("полный");

КонецПроцедуры

// Обход в несколько порций держит ОДИН срез: продолжение спрашивает тот же момент,
// а момент вычитки сдвигается только когда обход дошёл до конца среза.
&Тест
Процедура ОбходПорциямиДержитОдинСрез() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200,
		СрезСоШкалой("alfa:1.0.0", "2026-08-12T10:00:00Z", 2, 0, Истина, "beta"));
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);
	Синх = Синхронизатор(Клиент, 1);

	Первый = Синх.Синхронизировать(Зеркало_);
	Ожидаем.Что(Первый.ЕстьЕщё, "за порцией остался хвост").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо),
		"недойденный обход момента не двигает").ЭтоЛожь();

	// хвост среза: тот же момент снятия, курсор пройден
	Клиент.УстановитьОтветТекст(200,
		СрезСоШкалой("beta:2.0.0", "2026-08-12T12:00:00Z", 2, 1, Ложь, ""));
	Синх.Синхронизировать(Зеркало_);

	Запрос = ПоследнийЗапросСреза(Клиент);
	Ожидаем.Что(СтрНайти(Запрос, "cursor=beta") > 0, "продолжение с курсора: " + Запрос).ЭтоИстина();
	Ожидаем.Что(Состояние(Зеркало_).ВычитаноДо,
		"момент вычитки — снятый ПЕРВОЙ порцией, а не последней").Равно('20260812100000');

КонецПроцедуры

// Легаси-протокол об изменениях сообщать не умеет — это свойство ИСТОЧНИКА, а не отказ
// зеркала: обход остаётся полным, момента у зеркала не появляется, и цена второго прогона
// та же, что у первого.
&Тест
Процедура ЛегасиИсточникОстаётсяНаПолномОбходе() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");
	Клиент.УстановитьОтветТекстПоПути("package/alfa", 200, СтраницаВерсий("alfa", "1.0.0"));
	Клиент.УстановитьОтветДанные(200, Ospx("alfa", "1.0.0"));
	Зеркало_ = ЗеркалоOpm(Пул.Идентификатор);
	Синх = СинхронизаторOpm(Клиент);

	Синх.Синхронизировать(Зеркало_);
	ЗапросовЗаПервый = Клиент.ПутиЗапросов().Количество();
	Синх.Синхронизировать(Зеркало_);

	Ожидаем.Что(Состояние(Зеркало_).Способ, "легаси-обход полный").Равно("полный");
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(Зеркало_).ВычитаноДо),
		"момента у легаси-источника не появляется").ЭтоЛожь();
	Ожидаем.Что(Клиент.ПутиЗапросов().Количество() - ЗапросовЗаПервый,
		"повторный обход снова платит за список и за страницу каждого имени").Равно(2);

КонецПроцедуры

// Журнал обязан объяснять цену обхода: способ и момент отсчёта — в деталях события.
&Тест
Процедура СобытиеОбходаНесётСпособИМомент() Экспорт

	Пул = НовыйLocalПул();
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, ПустойСрез("2026-08-12T10:00:00Z"));
	Зеркало_ = ЗеркалоApiV1(Пул.Идентификатор);
	Синх = Синхронизатор(Клиент);

	Синх.Синхронизировать(Зеркало_);
	Клиент.УстановитьОтветТекст(200, ПустойСрез("2026-08-12T11:00:00Z"));
	Синх.Синхронизировать(Зеркало_);

	Записи = ЗаписиСинкаПула(Пул);
	Ожидаем.Что(Записи.Количество() >= 2, "обходы объявлены").ЭтоИстина();
	Детали = ДеталиЗаписи(Записи[0]);
	Ожидаем.Что(Строка(Детали.Получить("способ")), "способ обхода в журнале").Равно("инкремент");
	// момент печатается XML-датой, и разбор ответа возвращает её датой же
	Ожидаем.Что(Детали.Получить("срезС"), "и момент, с которого спрошены изменения")
		.Равно('20260812100000');

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция КлассыЗеркал()
	Возврат СтрРазделить(
		"ДроссельПрогресса,ЧислаЗеркалирования,СчётчикиОбхода,СрезОбхода,РазборНастроекЗеркала,"
		+ "СледЦиклаЗеркала,ОтметкаПеречисления,ПределыПриёмаПакета,ПрогонЗеркала,"
		+ "ПереносЭлементаСинка,СинхронизаторЗеркал,РазборПакетовЗеркала,ВалидаторАдресаАпстрима",
		",");
КонецФункции

Функция КлассыВнеКонтейнера()
	Возврат СтрРазделить(
		"СервисЗеркал,КореньАпстрима,ФильтрИмёнЗеркала,РазборСрезаИзменений,"
		+ "ИсточникАпстримаOpenHub,ИсточникАпстримаOpm", ",");
КонецФункции

Функция Синхронизатор(Знач Клиент, Знач РазмерПорции = 25)
	Возврат СинхронизаторНад(
		Новый ИсточникАпстримаOpenHub(Клиент, Неопределено, Неопределено, Новый КореньАпстрима(Новый РазборАдреса())), РазмерПорции);
КонецФункции

Функция СинхронизаторOpm(Знач Клиент)
	Возврат СинхронизаторНад(
		Новый ИсточникАпстримаOpm(Клиент, Новый РазборВерсийПакета(Сравнитель()),
			Неопределено, Новый КореньАпстрима(Новый РазборАдреса())), 25);
КонецФункции

Функция СинхронизаторНад(Знач Источник, Знач РазмерПорции)
	Возврат Новый СинхронизаторЗеркал(
		Новый ФейкСервисЗеркалСинк(), СервисПулов(), Перенос(), Прогон(), След(), Валидатор(),
		Новый Массив(), Массив(Источник), Числа(), ЧислаЗеркал(РазмерПорции), ЛогТестов());
КонецФункции

Функция Перенос()
	Возврат Новый ПереносЭлементаСинка(
		Поделка.НайтиЖелудь("СервисПакетов"), СервисВерсий(), Поделка.НайтиЖелудь("ПриёмВерсии"),
		Поделка.НайтиЖелудь("ПравилаИменования"), Хранилище(),
		Поделка.НайтиЖелудь("РазборПакетовЗеркала"), Поделка.НайтиЖелудь("ЗаписьЗанятогоМеста"),
		Валидатор(), ПределыПриёма(), Массив(СервисПулов()), Массив(След()), ЛогТестов());
КонецФункции

Функция След()
	Возврат Новый СледЦиклаЗеркала(Поделка.НайтиЖелудь("ИмяОбъектаАудита"),
		Массив(Поделка.НайтиЖелудь("ИздательСобытий")));
КонецФункции

Функция Прогон()
	Возврат Поделка.НайтиЖелудь("ПрогонЗеркала");
КонецФункции

Функция СервисЗеркал()
	Возврат Новый СервисЗеркал(ХранилищеЗеркал(), Новый ФейкСервисПрав(), Валидатор(),
		Новый Массив(), Прогон(), ЧислаЗеркал(25),
		Новый РазборНастроекЗеркала(ЧислаЗеркал(25)));
КонецФункции

Функция Валидатор()
	Возврат Новый ВалидаторАдресаАпстрима(
		Новый ВалидаторАдресаВебхука(Новый ФейкРазрешительImён(), НастройкиПодписок()));
КонецФункции

Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.webhook.allow_private_targets", Ложь);
	Настройки.Задать("oshub.webhook.timeout.sec", 10);
	Возврат Настройки;
КонецФункции

Функция ПределыПриёма()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.publish.max_upload_bytes", 26214400);
	Настройки.Задать("oshub.publish.max_unpacked_bytes", 67108864);
	Настройки.Задать("oshub.publish.max_files", 5000);
	Настройки.Задать("oshub.publish.max_manifest_bytes", 524288);
	Возврат Новый ПределыПриёмаПакета(Новый ПриведениеЧисел(), Настройки);
КонецФункции

Функция ЧислаЗеркал(Знач РазмерПорции)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.max_packages_per_cycle", РазмерПорции);
	Настройки.Задать("oshub.mirror.max_cycles_per_run", 20);
	Настройки.Задать("oshub.mirror.default_interval_sec", 3600);
	Настройки.Задать("oshub.mirror.max_per_pool", 5);
	Настройки.Задать("oshub.mirror.min_interval_sec", 60);
	Настройки.Задать("oshub.mirror.run_stale_sec", 900);
	Настройки.Задать("oshub.mirror.sync_enabled", Истина);
	Настройки.Задать("oshub.mirror.queue_max", 100);
	Возврат Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);
КонецФункции

// Срез изменений источника из компактной записи "имя:версия;версия|имя:версия".
Функция Срез(Знач Состав, Знач Снят)
	Возврат ТелоСреза(Состав, Снят, СтрРазделить(Состав, "|", Ложь).Количество(), 0, Ложь, "");
КонецФункции

Функция ПустойСрез(Знач Снят)
	Возврат ТелоСреза("", Снят, 0, 0, Ложь, "");
КонецФункции

Функция СрезСоШкалой(Знач Состав, Знач Снят, Знач ИменВсего, Знач ИменДо, Знач ЕстьЕщё,
	Знач Курсор)
	Возврат ТелоСреза(Состав, Снят, ИменВсего, ИменДо, ЕстьЕщё, Курсор);
КонецФункции

Функция ТелоСреза(Знач Состав, Знач Снят, Знач ИменВсего, Знач ИменДо, Знач ЕстьЕщё, Знач Курсор)

	Данные = Новый Структура();
	Данные.Вставить("pool", "upstream");
	Данные.Вставить("as_of", Снят);
	Данные.Вставить("names_total", ИменВсего);
	Данные.Вставить("names_before", ИменДо);
	Данные.Вставить("has_more", ЕстьЕщё);
	Данные.Вставить("next_cursor", Курсор);
	Данные.Вставить("changes", Изменения(Состав));

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Функция Изменения(Знач Состав)

	Результат = Новый Массив();
	Для Каждого Пара Из СтрРазделить(Состав, "|", Ложь) Цикл
		Части = СтрРазделить(Пара, ":", Ложь);
		Для Каждого Версия Из СтрРазделить(Части[1], ";", Ложь) Цикл
			Результат.Добавить(Новый Структура("package, version",
				Части[0], Новый Структура("version, yanked", Версия, Ложь)));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Разметка страницы пакета легаси-хаба с перечисленными версиями.
Функция СтраницаВерсий(Знач ИмяПакета, Знач Версии_)

	Разметка = "<div class=""ui relaxed list"">";
	Для Каждого Версия Из СтрРазделить(Версии_, ",", Ложь) Цикл
		Разметка = Разметка + СтрШаблон(
			"<div class=""item""><a class=""header"" href=""/download/%1/%1-%2.ospx"">%2</a></div>",
			ИмяПакета, Версия);
	КонецЦикла;
	Возврат Разметка + "</div>";

КонецФункции

Функция ЗеркалоApiV1(Знач ПулИд)
	Возврат НовоеЗеркало(ПулИд, "api-v1");
КонецФункции

Функция ЗеркалоOpm(Знач ПулИд)
	Возврат НовоеЗеркало(ПулИд, "opm");
КонецФункции

// Зеркало — НАСТОЯЩАЯ запись сущности: моменты обхода движок читает и пишет через хранилище.
Функция НовоеЗеркало(Знач ПулИд, Знач Режим)

	Запись = ХранилищеЗеркал().СоздатьЭлемент();
	Запись.ПулНазначенияИдентификатор = Цел(ПулИд);
	Запись.АпстримURL = "http://upstream.invalid/download/";
	Запись.ТокенДоступа = "";
	Запись.Режим = Режим;
	Запись.ФильтрJSON = "";
	Запись.ИнтервалСинкаСек = 3600;
	Запись.Включено = Истина;
	Запись.РазрешитьПриватные = Ложь;
	Запись.ПоследнийСинк = '00010101000000';
	Запись.Статус = "создано, ещё не синхронизировано";
	Запись.СостояниеПрогона = "простаивает";
	Запись.ПрогонНачат = '00010101000000';
	Запись.ПрогонОбновлён = '00010101000000';
	Запись.ПрогонВсего = 0;
	Запись.ПрогонСкачано = 0;
	Запись.ПрогонПропущено = 0;
	Запись.ПрогонОшибок = 0;
	Запись.ПрогонНедоступно = 0;
	Запись.ПрогонИмёнВсего = 0;
	Запись.ПрогонИмёнПройдено = 0;
	Запись.ПрогонКурсор = "";
	Запись.ПрогонЗапустил = "";
	Запись.ВычитаноДо = '00010101000000';
	Запись.ПрогонСрезС = '00010101000000';
	Запись.ПрогонМоментСреза = '00010101000000';
	Запись.СозданКем = 0;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Обновлён = Запись.Создан;
	Запись.Сохранить();
	Возврат Запись;

КонецФункции

// Момент, потерянный не по нашей вине: так выглядит запись зеркала, которому его снесли.
Процедура ЗабытьМомент(Знач Зеркало_)
	Запись = ХранилищеЗеркал().ПолучитьОдноПоИдентификаторРавно(Цел(Зеркало_.Идентификатор));
	Запись.ВычитаноДо = '00010101000000';
	Запись.ПрогонСрезС = '00010101000000';
	Запись.ПрогонМоментСреза = '00010101000000';
	Запись.Сохранить();
КонецПроцедуры

Функция Состояние(Знач Зеркало_)
	Возврат Прогон().Состояние(Зеркало_.Идентификатор);
КонецФункции

// Права здесь не предмет: токен зеркала задаёт владелец пула, и фейк прав пускает админа.
Функция Администратор()
	Возврат Новый Структура("Идентификатор, Логин, Админ", 1, "admin", Истина);
КонецФункции

// Последний запрос среза изменений: скачивания идут тем же клиентом и в общий журнал.
Функция ПоследнийЗапросСреза(Знач Клиент)

	Результат = "";
	Для Каждого Путь Из Клиент.ПутиЗапросов() Цикл
		Если СтрНачинаетсяС(Путь, "changes?") Тогда
			Результат = Путь;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗаписиСинкаПула(Знач Пул)

	Адрес = Поделка.НайтиЖелудь("ИмяОбъектаАудита").ПулПоИмени(Пул.Имя);
	Отбор = Новый Структура("Действие", "зеркало.синхронизировано");
	Найденные = Новый Массив();
	Для Каждого Запись Из Поделка.НайтиЖелудь("СлужбаАудита").ЗаписиСтраницей(Отбор, 1, 200).Записи Цикл
		Если Строка(Запись.Объект) = Адрес Тогда
			Найденные.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция ДеталиЗаписи(Знач Запись)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Строка(Запись.Детали));
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция ВерсийПакета(Знач Пул, Знач Имя)
	Пакет = Поделка.НайтиЖелудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя);
	Возврат ?(Пакет = Неопределено, 0, СервисВерсий().ВерсииПакета(Пакет.Идентификатор).Количество());
КонецФункции

Функция НовыйLocalПул()
	НомерПула = НомерПула + 1;
	Возврат СервисПулов().СоздатьПул("mir-inc-" + Формат(НомерПула, "ЧГ=0"), "custom");
КонецФункции

// Пул с квотой, забитой под завязку: следующий артефакт в неё уже не влезет.
Функция ПулСКвотойПодЗавязку()

	Пул = СервисПулов().УстановитьКвоту(НовыйLocalПул().Идентификатор, 1);
	Поделка.НайтиЖелудь("ЗаписьЗанятогоМеста").Учесть(Пул, 1024 * 1024, "подготовка теста");
	Возврат Пул;

КонецФункции

Функция Ospx(Знач Имя, Знач Версия)
	Кат = ОбъединитьПути(КаталогOspx, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Кат);
	Путь = Новый ФикстураПакета().ПостроитьOspx(Кат, Имя, Версия, "# " + Имя + " " + Версия);
	Возврат Новый ДвоичныеДанные(Путь);
КонецФункции

