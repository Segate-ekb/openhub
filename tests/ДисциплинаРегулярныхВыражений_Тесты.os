// Скан-тест дисциплины регулярных выражений: литеральный шаблон якорится "\A…\z", шаблон
// извне выставляет оба флага класса явно, каждое место числится в описи с группой
// последствия. Детекторы закрыты самотестами.

#Использовать asserts

Перем КаталогПроекта;

// Ниже этого числа скан считается ослепшим: регулярки живут в разборе версий, правилах
// тегов и масках имён — меньше восьми мест означает переехавший каталог.
Перем МинимумМест;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	МинимумМест = 8;

КонецПроцедуры

#Область СканыПродуктовогоКода

&Тест
Процедура КаждаяРегуляркаИсходниковЧислитсяВОписи() Экспорт

	Опись = ОписьРегулярных();
	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Путь = ОтносительныйПуть(Файл);
		Если АргументыРегулярных(ПрочитатьФайл(Файл)).Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Опись[Путь] = Неопределено Тогда
			Нарушители.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"файлы src/ с регулярным выражением вне описи ОписьРегулярных(): каждое сопоставление"
		+ " обязано быть отнесено к группе «доверие» (решает пустить/не пустить, чей это пакет,"
		+ " какому апстриму верим) либо «разбор» (извлечение и валидация данных) — иначе"
		+ " дефолты класса возвращаются незамеченными").Равно("");

КонецПроцедуры

&Тест
Процедура ЛитеральныеШаблоныЗаякореныВсейСтрокой() Экспорт

	Нарушители = Новый Массив();
	Мест = 0;

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Путь = ОтносительныйПуть(Файл);
		Для Каждого Аргумент Из АргументыРегулярных(ПрочитатьФайл(Файл)) Цикл
			Мест = Мест + 1;
			Если НЕ ЭтоЛитеральныйШаблон(Аргумент) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗаякоренВсейСтрокой(Аргумент) Тогда
				Нарушители.Добавить(Путь + ": " + Аргумент);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Мест >= МинимумМест,
		СтрШаблон("найдено мест с регулярным выражением: %1 при минимуме %2 — скан ослеп",
			Мест, МинимумМест)).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"литеральные шаблоны с ""^…$"" вместо ""\A…\z"": многострочный режим включён"
		+ " по умолчанию, и такие якоря совпадают на любой границе строк — ""^имя$"" ловит"
		+ " ""мусор<ПС>имя""").Равно("");

КонецПроцедуры

&Тест
Процедура ШаблоныИзвнеВыставляютФлагиЯвно() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыИсходников() Цикл

		Текст = ПрочитатьФайл(Файл);
		Мест = ЧислоМестСоШаблономИзвне(Текст);
		Если Мест = 0 Тогда
			Продолжить;
		КонецЕсли;

		Путь = ОтносительныйПуть(Файл);
		Для Каждого Флаг Из ОбязательныеФлаги() Цикл
			Присваиваний = ЧислоПрисваиваний(Текст, Флаг);
			Если Присваиваний < Мест Тогда
				Нарушители.Добавить(СтрШаблон("%1: мест с шаблоном извне %2, присваиваний «%3» %4",
					Путь, Мест, Флаг, Присваиваний));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"выражение собрано из значения снаружи, а флаги класса оставлены по умолчанию:"
		+ " сопоставление молча становится регистронезависимым и построчным").Равно("");

КонецПроцедуры

&Тест
Процедура РегуляркиДоверияВыставляютОбаФлага() Экспорт

	Нарушители = Новый Массив();
	Проверено = 0;

	Для Каждого КиЗ Из ОписьРегулярных() Цикл

		Если КиЗ.Значение <> ГруппаДоверия() Тогда
			Продолжить;
		КонецЕсли;

		Полный = ПолныйПуть(КиЗ.Ключ);
		Если НЕ Новый Файл(Полный).Существует() Тогда
			Продолжить; // опись переживает файл: класс мог ещё не приехать или уже уехать
		КонецЕсли;

		Текст = ПрочитатьФайл(Полный);
		Мест = АргументыРегулярных(Текст).Количество();
		Если Мест = 0 Тогда
			Продолжить;
		КонецЕсли;

		Проверено = Проверено + 1;
		Для Каждого Флаг Из ОбязательныеФлаги() Цикл
			Присваиваний = ЧислоПрисваиваний(Текст, Флаг);
			Если Присваиваний < Мест Тогда
				Нарушители.Добавить(СтрШаблон("%1: мест %2, присваиваний «%3» %4",
					КиЗ.Ключ, Мест, Флаг, Присваиваний));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(Проверено > 0,
		"ни одного живого файла группы «доверие» — опись разошлась с деревом").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"регулярка, решающая вопрос доверия, без явных ИгнорироватьРегистр = Ложь и"
		+ " Многострочный = Ложь: выражение из ""refs/heads/main"" совпало бы"
		+ " с ""refs/heads/MAIN""").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СамотестыДетекторов

&Тест
Процедура ДетекторНаходитМестаСоздания() Экспорт

	Найдено = АргументыРегулярных(
		"Шаблон = Новый РегулярноеВыражение(""\Aabc\z"");" + Символы.ПС
		+ "// Новый РегулярноеВыражение(""^закомментировано$"")" + Символы.ПС
		+ "Другое = Новый РегулярноеВыражение(Выражение);");

	Ожидаем.Что(Найдено.Количество(), "два живых места, комментарий не считается").Равно(2);
	Ожидаем.Что(Найдено[0], "аргумент вырезан целиком").Равно("""\Aabc\z""");
	Ожидаем.Что(Найдено[1], "переменная как аргумент").Равно("Выражение");

	Ожидаем.Что(АргументыРегулярных("Перем Матчер; // РегулярноеВыражение | РазобранныйДиапазон").Количество(),
		"упоминание типа в комментарии — не создание").Равно(0);

КонецПроцедуры

&Тест
Процедура ДетекторОтличаетЛитералОтЗначенияИзвне() Экспорт

	Ожидаем.Что(ЭтоЛитеральныйШаблон("""\Aabc\z"""), "литерал").ЭтоИстина();
	Ожидаем.Что(ЭтоЛитеральныйШаблон("""\A"" + Шаблон + ""\z"""), "склейка с литералами").ЭтоИстина();
	Ожидаем.Что(ЭтоЛитеральныйШаблон("Выражение"), "значение снаружи").ЭтоЛожь();
	Ожидаем.Что(ЭтоЛитеральныйШаблон("ТекстНорм"), "значение снаружи").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторЯкорейТребуетГраницСтроки() Экспорт

	Ожидаем.Что(ЗаякоренВсейСтрокой("""\Aabc\z"""), "оба якоря строки").ЭтоИстина();
	Ожидаем.Что(ЗаякоренВсейСтрокой("""\A"" + Шаблон + ""\z"""), "якоря по краям склейки").ЭтоИстина();
	Ожидаем.Что(ЗаякоренВсейСтрокой("""^abc$"""), "якоря строчки — не якоря строки").ЭтоЛожь();
	Ожидаем.Что(ЗаякоренВсейСтрокой("""^"" + Шаблон + ""$"""), "склейка со строчными якорями").ЭтоЛожь();
	Ожидаем.Что(ЗаякоренВсейСтрокой("""\Aabc"""), "только левый якорь").ЭтоЛожь();
	Ожидаем.Что(ЗаякоренВсейСтрокой("""abc\z"""), "только правый якорь").ЭтоЛожь();
	Ожидаем.Что(ЗаякоренВсейСтрокой("""\A[^0-9]+\z"""), "каретка внутри класса символов допустима").ЭтоИстина();
	Ожидаем.Что(ЗаякоренВсейСтрокой("""^\Aabc\z$"""), "строчные якоря поверх строковых").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторФлаговСчитаетПрисваивания() Экспорт

	Флаг = "ИгнорироватьРегистр = Ложь";

	Ожидаем.Что(ЧислоПрисваиваний("Выражение.ИгнорироватьРегистр = Ложь;", Флаг),
		"присваивание найдено").Равно(1);
	Ожидаем.Что(ЧислоПрисваиваний(
		"А.ИгнорироватьРегистр = Ложь;" + Символы.ПС + "Б.ИгнорироватьРегистр = Ложь;", Флаг),
		"два присваивания сосчитаны по отдельности").Равно(2);
	Ожидаем.Что(ЧислоПрисваиваний("// ИгнорироватьРегистр = Ложь; тут не выставлен", Флаг),
		"обещание в комментарии не считается").Равно(0);
	Ожидаем.Что(ЧислоПрисваиваний("Выражение.ИгнорироватьРегистр = Истина;", Флаг),
		"обратное присваивание не считается").Равно(0);

КонецПроцедуры

// Файл с двумя местами создания и одним комплектом флагов — нарушитель: именно так
// дефолты класса возвращаются незамеченными.
&Тест
Процедура ДетекторСчитаетМестаАНеФайлы() Экспорт

	Текст = "Первое = Новый РегулярноеВыражение(Выражение);" + Символы.ПС
		+ "Первое.ИгнорироватьРегистр = Ложь;" + Символы.ПС
		+ "Первое.Многострочный = Ложь;" + Символы.ПС
		+ "Второе = Новый РегулярноеВыражение(ДругоеВыражение);";

	Ожидаем.Что(ЧислоМестСоШаблономИзвне(Текст), "оба места сосчитаны").Равно(2);
	Ожидаем.Что(ЧислоПрисваиваний(Текст, "ИгнорироватьРегистр = Ложь") < ЧислоМестСоШаблономИзвне(Текст),
		"флагов меньше, чем мест — нарушение").ЭтоИстина();

	Ожидаем.Что(ЧислоМестСоШаблономИзвне("Проба = Новый РегулярноеВыражение(""\Aabc\z"");"),
		"литерал шаблоном извне не считается").Равно(0);

КонецПроцедуры

&Тест
Процедура КорпусСканаНеПуст() Экспорт

	Ожидаем.Что(ФайлыИсходников().Количество() > 100,
		"корпус исходников src/ подозрительно мал — проверьте пути").ЭтоИстина();

	Ожидаем.Что(ОписьРегулярных().Количество() >= 5,
		"опись регулярок подозрительно коротка — проверьте, не потерялись ли записи").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Детекторы

Функция ГруппаДоверия()
	Возврат "доверие";
КонецФункции

// Опись мест сопоставления по шаблону: путь файла — группа последствия. "доверие" —
// результат решает «пустить/не пустить», «чей это пакет», «какому источнику верим»;
// "разбор" — извлечение и валидация данных.
Функция ОписьРегулярных()

	Опись = Новый Соответствие();

	Опись.Вставить("src/модули/реестр/Классы/МаскаИмениПакета.os", ГруппаДоверия());

	Опись.Вставить("src/модули/реестр/Классы/ПравилоТега.os", "разбор");
	Опись.Вставить("src/модули/реестр/Классы/РезолверВерсий.os", "разбор");
	Опись.Вставить("src/модули/реестр/Классы/РазобраннаяВерсия.os", "разбор");
	Опись.Вставить("src/модули/реестр/Классы/РазобранныйДиапазон.os", "разбор");

	Возврат Опись;

КонецФункции

// Аргументы всех живых "Новый РегулярноеВыражение(...)" текста: по одному на место создания.
Функция АргументыРегулярных(Знач Текст)

	Результат = Новый Массив();
	Образец = "Новый РегулярноеВыражение(";

	Для Каждого Строка_ Из СтрРазделить(БезКомментариев(Текст), Символы.ПС) Цикл
		Позиция = СтрНайти(Строка_, Образец);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Строка_, Позиция + СтрДлина(Образец));
		Результат.Добавить(СокрЛП(ДоЗакрывающейСкобки(Хвост)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДоЗакрывающейСкобки(Знач Текст)

	Глубина = 0;
	ВЛитерале = Ложь;

	Для Позиция = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
		ИначеЕсли НЕ ВЛитерале И Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли НЕ ВЛитерале И Символ = ")" Тогда
			Если Глубина = 0 Тогда
				Возврат Лев(Текст, Позиция - 1);
			КонецЕсли;
			Глубина = Глубина - 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Текст;

КонецФункции

Функция ЭтоЛитеральныйШаблон(Знач Аргумент)
	Возврат СтрНайти(Аргумент, """") > 0;
КонецФункции

// Границы всей строки — только "\A" и "\z".
Функция ЗаякоренВсейСтрокой(Знач Аргумент)

	Если СтрНайти(Аргумент, "\A") = 0 ИЛИ СтрНайти(Аргумент, "\z") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(Аргумент, """^") = 0 И СтрНайти(Аргумент, "$""") = 0;

КонецФункции

Функция ОбязательныеФлаги()
	Возврат СтрРазделить("ИгнорироватьРегистр = Ложь,Многострочный = Ложь", ",");
КонецФункции

Функция ЧислоМестСоШаблономИзвне(Знач Текст)

	Найдено = 0;

	Для Каждого Аргумент Из АргументыРегулярных(Текст) Цикл
		Если НЕ ЭтоЛитеральныйШаблон(Аргумент) Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Найдено;

КонецФункции

// Считаем присваивания, а не факт упоминания: файл с двумя местами создания и одним
// флагом обязан считаться нарушителем.
Функция ЧислоПрисваиваний(Знач Текст, Знач Флаг)

	Чистый = БезКомментариев(Текст);
	Образец = Флаг + ";";
	Найдено = 0;
	Позиция = 1;

	Пока Истина Цикл
		Вхождение = СтрНайти(Чистый, Образец, , Позиция);
		Если Вхождение = 0 Тогда
			Возврат Найдено;
		КонецЕсли;
		Найдено = Найдено + 1;
		Позиция = Вхождение + 1;
	КонецЦикла;

КонецФункции

Функция БезКомментариев(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		Результат.Добавить(ОбрезатьКомментарий(Строка_));
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

Функция ОбрезатьКомментарий(Знач Строка_)

	ВЛитерале = Ложь;

	Для Позиция = 1 По СтрДлина(Строка_) Цикл

		Символ = Сред(Строка_, Позиция, 1);

		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
		ИначеЕсли НЕ ВЛитерале И Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
			Возврат Лев(Строка_, Позиция - 1);
		КонецЕсли;

	КонецЦикла;

	Возврат Строка_;

КонецФункции

#КонецОбласти

#Область Корпус

Функция ФайлыИсходников()

	Файлы = Новый Массив();
	Каталог = ОбъединитьПути(КаталогПроекта, "src");

	Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Файлы.Количество() < 100 Тогда
		ВызватьИсключение СтрШаблон(
			"Корпус скана регулярок подозрительно мал (%1 файлов) — проверьте пути",
			Файлы.Количество());
	КонецЕсли;

	Возврат Файлы;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция ПолныйПуть(Знач ОтносительныйПуть)

	Полный = КаталогПроекта;
	Для Каждого Часть Из СтрРазделить(ОтносительныйПуть, "/", Ложь) Цикл
		Полный = ОбъединитьПути(Полный, Часть);
	КонецЦикла;

	Возврат Полный;

КонецФункции

Функция ОтносительныйПуть(Знач Путь)

	Относительный = СтрЗаменить(СтрЗаменить(Путь, КаталогПроекта, ""), "\", "/");
	Если СтрНачинаетсяС(Относительный, "/") Тогда
		Относительный = Сред(Относительный, 2);
	КонецЕсли;

	Возврат Относительный;

КонецФункции

#КонецОбласти
