// Юнит-тесты интеграции OIDC на контейнере ОСени с КоннекторInMemory.
// Сеть не дёргается: discovery/token/userinfo отвечает ФейкСессииOIDC — прозвище
// СессияИсходящегоHTTP занимает он, и библиотека ходит через него.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;
Перем КаталогМодулей;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогМодулей = Модули;

	ПодключитьСервисы(ОбъединитьПути(Модули, "данные", "Классы"));
	// core-registry: СервисПользователей проверяет логин по резерву системных сегментов
	// URL (ПравилаИменования, шаг 5.B) — тот же список, что и для имён пулов
	ПодключитьСервисы(ОбъединитьПути(Модули, "реестр", "Классы"));

	// events: core-registry содержит подписчика доменных событий (НаблюдательКаналов)
	// и ЛетописьТегов — контейнер с core-registry обязан грузить издатель,
	// иначе рогатка-подписчик не создаётся
	ПодключитьСервисы(ОбъединитьПути(Модули, "события", "Классы"));

	// SSRF-гейт апстримов (5.B): СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО
	// (fail-closed). Модули webhooks/mirror целиком не тянем — в webhooks рогатки,
	// которым нужен весь хаб; фикстура подключает ровно три класса гейта.
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();
	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"),
			"СобытиеАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "основа", "Классы", "ТекстJSON.os"),
			"ТекстJSON");
	Исключение
	КонецПопытки;
	// примитивы основы: заголовки запроса, канон записи адреса, таблица отказов учётки
	ПоискКлассов.ПодключитьОснову(Модули);
	ПодключитьСервисы(ОбъединитьПути(Модули, "вход", "Классы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "права", "Классы"));
	// settings (7.E): СлужбаСессий (а через неё ХранительТранзакцийOIDC) читает TTL
	// у резолвера СервисНастроек — без его желудей auth-бины не собираются
	ПодключитьСервисы(ОбъединитьПути(Модули, "настройки", "Классы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "интерфейс", "Классы", "настройки"));
	// сеть/СессияИсходящегоHTTP НЕ подключаем: прозвище занимает фейк, и весь исходящий
	// HTTP входа виден набору
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкОтветаHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкСессииOIDC.os"));
	// автовыдача прав по GitHub живёт в publish, а её каталог репозиториев ходит через
	// ТранспортHTTP — прозвище занимает фейк, и поход в GitHub виден набору
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкТранспортHTTP.os"));
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "АвтовыдачаПравПоGitHub");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "ЗаданиеРаздачиПравGitHub");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "КаталогРепозиториевGitHub");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "КаталогРепозиториевGitHubHTTP");
	// раздача уходит в фон, но исход входа этот набор проверяет сразу за вызовом —
	// прозвище запуска занимает синхронный фейк, иначе каждая проверка станет гонкой
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ЗапускВФонеСинхронный.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "КодировкаТестов.os"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "вход", "Классы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "права", "Классы"));
	// common: отбор адреса возврата — общий желудь входа, его зовёт и старт, и callback
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "вход", "Классы", "ВозвратПослеВхода.os"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "oidc-unit-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

#Область СборкаКонтейнера

&Тест
Процедура ЖелудиOIDCЗарегистрированы() Экспорт
	Для Каждого Имя Из СтрРазделить("КонфигурацияOIDC,СервисВходаOIDC,"
		+ "СервисЛичностей,СервисАвтопривязки,СервисСопоставленийГрупп,ХранительТранзакцийOIDC,"
		+ "ХранилищеВнешнихЛичностей,ХранилищеСопоставленийГруппOIDC,ПровижинингГруппOIDC,"
		+ "ХранилищеСвязокГруппOIDC", ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ВходИПровижининг

&Тест
Процедура AutoProvisioningСоздаётПользователяИПривязываетЛичность() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	Субъект = "sub-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "state1", "nonce1",
		Профиль(Субъект, "alice_" + УникальныйСуффикс(), "a@ex.com", Истина, Новый Массив()));

	Исход = ЗавершитьВход(Фейк, Пр, "state1", "state1", "nonce1", "verifier1", 0);

	Ожидаем.Что(Исход.Успех, Исход.Причина).ЭтоИстина();
	Ожидаем.Что(Исход.Новая).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Исход.Пользователь.Логин, "alice_")).ЭтоИстина();
	// личность привязана к созданному пользователю
	СЛ = Желудь("СервисЛичностей");
	Ожидаем.Что(СЛ.НайтиПользователяПоЛичности(Пр.Издатель, Субъект).Идентификатор).Равно(Исход.Пользователь.Идентификатор);

КонецПроцедуры

&Тест
Процедура ПовторныйВходВходитВТогоЖеПользователя() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	Субъект = "sub-" + УникальныйСуффикс();
	Логин = "bob_" + УникальныйСуффикс();

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n", Профиль(Субъект, Логин, "", Ложь, Новый Массив()));
	Первый = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(Первый.Успех).ЭтоИстина();

	// второй вход той же личности (новые state/nonce) — тот же пользователь, не создаётся новый
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2", Профиль(Субъект, Логин, "", Ложь, Новый Массив()));
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);
	Ожидаем.Что(Второй.Успех).ЭтоИстина();
	Ожидаем.Что(Второй.Новая).ЭтоЛожь();
	Ожидаем.Что(Второй.Пользователь.Идентификатор).Равно(Первый.Пользователь.Идентификатор);

КонецПроцедуры

&Тест
Процедура КоллизияЛогинаПолучаетСуффикс() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	ОбщийЛогин = "carol_" + УникальныйСуффикс();

	Суб1 = "sub-a-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Пр, Суб1, "s", "n", Профиль(Суб1, ОбщийЛогин, "", Ложь, Новый Массив()));
	Один = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Суб2 = "sub-b-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Пр, Суб2, "s", "n", Профиль(Суб2, ОбщийЛогин, "", Ложь, Новый Массив()));
	Два = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Один.Пользователь.Логин).Равно(НРег(ОбщийЛогин));
	Ожидаем.Что(Два.Пользователь.Логин = Один.Пользователь.Логин).ЭтоЛожь(); // суффикс
	Ожидаем.Что(СтрНачинаетсяС(Два.Пользователь.Логин, НРег(ОбщийЛогин))).ЭтоИстина();

КонецПроцедуры

// Привязки к существующей учётке по email нет вовсе — ни по подтверждённому, ни по какому.
// Вектор, ради которого её убрали: саморегистрация пишет ЛЮБОЙ адрес неподтверждённым, то
// есть поиск учётки по адресу отдаёт её тому, кто зарегистрировался на чужой адрес первым.
// Провайдер здесь с ВКЛЮЧЁННЫМ auto-provisioning: и при нём захвата не происходит.
// Второй учётки на тот же адрес при этом тоже не заводится — адрес принадлежит одной
// учётной записи, и вход отвергается названной причиной.
&Тест
Процедура ЛичностьНеЗахватываетУчёткуСТемЖеПодтверждённымEmail() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");
	Email = "dave_" + УникальныйСуффикс() + "@ex.com";
	Логин = "dave" + УникальныйСуффикс();
	Локальный = СП.СоздатьПользователя(Логин, Email, "password123", "user");

	Субъект = "sub-" + УникальныйСуффикс();
	// тот же адрес, ПОДТВЕРЖДЁННЫЙ провайдером, и тот же предпочтительный логин
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, Логин, Email, Истина, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, "вход не выдал ни чужой учётки, ни новой").ЭтоЛожь();
	Ожидаем.Что(Исход.Пользователь, "учётка с тем же адресом НЕ захвачена").Равно(Неопределено);
	Ожидаем.Что(СЛ.ЛичностиПользователя(Локальный.Идентификатор).Количество(),
		"чужая учётка не получила личность IdP").Равно(0);
	Ожидаем.Что(СЛ.НайтиПользователяПоЛичности(Пр.Издатель, Субъект),
		"личность не привязана ни к кому").Равно(Неопределено);
	// адрес учётки не тронут: клейм провайдера не отменяет её собственного состояния
	Прежний = СП.ПоИдентификатору(Локальный.Идентификатор);
	Ожидаем.Что(Строка(Прежний.Email), "адрес прежней учётки на месте").Равно(НРег(Email));
	Ожидаем.Что(Прежний.EmailПодтверждён = Истина,
		"и чужой вход его не подтвердил").ЭтоЛожь();

КонецПроцедуры

// Живой случай (GitHub App без разрешения Account permissions → Email addresses): профиль
// приезжает БЕЗ адреса. Пустое не затирает заполненное — ни в учётной записи, ни в записи
// внешней личности, которую показывает кабинет.
&Тест
Процедура ПустойПрофильНеЗатираетАдресУчёткиИЛичности() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");

	Логин = "empty" + УникальныйСуффикс();
	Email = Логин + "@ex.com";
	Субъект = "sub-" + УникальныйСуффикс();

	// первый вход: профиль с адресом — учётка и личность его получают
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, Логин, Email, Истина, Новый Массив()));
	Первый = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(Первый.Успех, Первый.Причина).ЭтоИстина();
	Ожидаем.Что(Строка(СЛ.НайтиЛичность(Пр.Издатель, Субъект).Email),
		"личность получила адрес").Равно(НРег(Email));

	// второй вход того же человека: у приложения отобрали разрешение на адрес
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2",
		Профиль(Субъект, Логин, "", Ложь, Новый Массив()));
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Второй.Успех, "вход не сломался: " + Второй.Причина).ЭтоИстина();
	Ожидаем.Что(Строка(СП.ПоИдентификатору(Второй.Пользователь.Идентификатор).Email),
		"адрес учётной записи на месте").Равно(НРег(Email));
	Ожидаем.Что(Строка(СЛ.НайтиЛичность(Пр.Издатель, Субъект).Email),
		"и адрес в записи личности тоже").Равно(НРег(Email));

КонецПроцедуры

// Флаг подтверждения — это утверждение IdP, а не фильтр записи: неподтверждённый адрес
// обязан оказаться в учётке, иначе человек живёт на хабе вовсе без адреса.
&Тест
Процедура НеподтверждённыйEmailВсёРавноПопадаетВУчётку() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	Email = "erin_" + УникальныйСуффикс() + "@ex.com";
	Субъект = "sub-" + УникальныйСуффикс();

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "erin" + УникальныйСуффикс(), Email, Ложь, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, Исход.Причина).ЭтоИстина();
	Учётка = СП.НайтиПоЛогину(Исход.Пользователь.Логин); // читаем из базы, а не объект в руках
	Ожидаем.Что(Строка(Учётка.Email), "адрес провайдера записан в учётку").Равно(НРег(Email));
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина,
		"флаг повторяет то, что заявил IdP: подтверждения не было").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПодтверждённыйEmailПоднимаетФлагНовойУчётки() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	Email = "fred_" + УникальныйСуффикс() + "@ex.com";
	Субъект = "sub-" + УникальныйСуффикс();

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "fred" + УникальныйСуффикс(), Email, Истина, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, Исход.Причина).ЭтоИстина();
	Учётка = СП.НайтиПоЛогину(Исход.Пользователь.Логин);
	Ожидаем.Что(Строка(Учётка.Email)).Равно(НРег(Email));
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина,
		"IdP поручился за адрес — флаг поднят").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПрофильБезEmailСоздаётУчёткуБезАдреса() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	Субъект = "sub-" + УникальныйСуффикс();

	// профиль вовсе без клейма email — IdP не обязан его отдавать
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "gwen" + УникальныйСуффикс(), "", Ложь, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, "вход без адреса проходит: " + Исход.Причина).ЭтоИстина();
	Учётка = СП.НайтиПоЛогину(Исход.Пользователь.Логин);
	Ожидаем.Что(Строка(Учётка.Email), "адреса нет — и учётка без адреса").Равно("");
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина).ЭтоЛожь();

КонецПроцедуры

// Граница: за содержимое клейма отвечает провайдер, а человек в этот момент просто входит.
// Мусор вместо адреса обязан стоить адреса, а не входа.
&Тест
Процедура НепригодныйАдресПровайдераВходНеРонит() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	Субъект = "sub-" + УникальныйСуффикс();

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "hank" + УникальныйСуффикс(), "совсем-не-адрес", Истина, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, "битый клейм email вход не роняет: " + Исход.Причина).ЭтоИстина();
	Учётка = СП.НайтиПоЛогину(Исход.Пользователь.Логин);
	Ожидаем.Что(Строка(Учётка.Email), "непригодный адрес в учётку не записан").Равно("");
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина,
		"подтверждать нечего — флага нет").ЭтоЛожь();

КонецПроцедуры

// Вход уже привязанной личности — не «ничего не делать»: учётка, заведённая когда-то без
// адреса, обязана получить его, как только IdP начал его отдавать.
&Тест
Процедура ПовторныйВходЗаполняетПустойАдресУчётки() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");
	Субъект = "sub-" + УникальныйСуффикс();
	Логин = "ivy" + УникальныйСуффикс();

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n", Профиль(Субъект, Логин, "", Ложь, Новый Массив()));
	Первый = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(Строка(СП.НайтиПоЛогину(Логин).Email), "КОНТРОЛЬ: адреса ещё нет").Равно("");

	Email = "ivy_" + УникальныйСуффикс() + "@ex.com";
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2",
		Профиль(Субъект, Логин, Email, Истина, Новый Массив()));
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Второй.Успех, Второй.Причина).ЭтоИстина();
	Ожидаем.Что(Второй.Новая, "учётка та же, новой не завели").ЭтоЛожь();
	Учётка = СП.НайтиПоЛогину(Логин);
	Ожидаем.Что(Строка(Учётка.Email), "пустой адрес заполнен из профиля").Равно(НРег(Email));
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина, "IdP поручился — флаг поднят").ЭтоИстина();
	Ожидаем.Что(Строка(СЛ.ЛичностиПользователя(Первый.Пользователь.Идентификатор)[0].Email),
		"адрес личности тоже актуален").Равно(НРег(Email));

КонецПроцедуры

// Другая сторона той же монеты: адрес, который человек завёл себе САМ, провайдер не
// перетирает и не «переподтверждает». Актуализируется только адрес самой личности.
&Тест
Процедура ПовторныйВходНеПеретираетСвойАдресПользователя() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");
	Субъект = "sub-" + УникальныйСуффикс();
	Логин = "jane" + УникальныйСуффикс();
	ПервыйАдрес = "jane_" + УникальныйСуффикс() + "@idp.example";

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, Логин, ПервыйАдрес, Истина, Новый Массив()));
	Первый = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(Первый.Успех, Первый.Причина).ЭтоИстина();

	// человек сменил адрес в кабинете на свой — подтверждение при смене снимается
	Свой = "jane_" + УникальныйСуффикс() + "@own.example";
	Адреса().Сменить(СП.НайтиПоЛогину(Логин), Свой);

	// следующий вход той же личности: IdP заявляет ДРУГОЙ подтверждённый адрес
	ДругойАдрес = "jane_" + УникальныйСуффикс() + "@idp.example";
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2",
		Профиль(Субъект, Логин, ДругойАдрес, Истина, Новый Массив()));
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Второй.Успех, Второй.Причина).ЭтоИстина();
	Учётка = СП.НайтиПоЛогину(Логин);
	Ожидаем.Что(Строка(Учётка.Email), "свой адрес человека остался нетронутым").Равно(НРег(Свой));
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина,
		"чужой адрес не подтверждает свой").ЭтоЛожь();
	Ожидаем.Что(Строка(СЛ.ЛичностиПользователя(Первый.Пользователь.Идентификатор)[0].Email),
		"адрес самой личности актуализирован адресом из профиля").Равно(НРег(ДругойАдрес));

КонецПроцедуры

// Флаг только ПОДНИМАЕТСЯ. Провайдер, переставший подтверждать адрес (администратор снял
// галку в IdP, сменился клейм), не снимает подтверждение с учётки: `email_verified` —
// заявление IdP, а поднятый флаг хаба переживает и отвязку личности, и снос провайдера.
// Через HTTP-стенд не проверяется: фейковый IdP всегда отдаёт email_verified = true.
&Тест
Процедура ПровайдерБезПодтвержденияНеСнимаетПоднятыйФлаг() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	Субъект = "sub-" + УникальныйСуффикс();
	Логин = "liam" + УникальныйСуффикс();
	Email = "liam_" + УникальныйСуффикс() + "@ex.com";

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, Логин, Email, Истина, Новый Массив()));
	Первый = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(Первый.Успех, Первый.Причина).ЭтоИстина();
	Ожидаем.Что(СП.НайтиПоЛогину(Логин).EmailПодтверждён = Истина,
		"КОНТРОЛЬ: флаг поднят первым входом").ЭтоИстина();

	// тот же адрес, но IdP больше за него не ручается
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2",
		Профиль(Субъект, Логин, Email, Ложь, Новый Массив()));
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Второй.Успех, Второй.Причина).ЭтоИстина();
	Учётка = СП.НайтиПоЛогину(Логин);
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина,
		"подтверждение не снимается: флаг только поднимается").ЭтоИстина();
	Ожидаем.Что(Строка(Учётка.Email), "адрес тот же").Равно(НРег(Email));

КонецПроцедуры

// Осознанное поведение, а не недосмотр: адрес, стёртый в кабинете, следующий вход через
// провайдера возвращает. Отличать «не было никогда» от «сняли намеренно» значило бы
// завести ещё одно состояние учётки ради редкого случая.
&Тест
Процедура ОчищенныйВКабинетеАдресВозвращаетсяПровайдером() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	Субъект = "sub-" + УникальныйСуффикс();
	Логин = "mia" + УникальныйСуффикс();
	Email = "mia_" + УникальныйСуффикс() + "@ex.com";

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, Логин, Email, Истина, Новый Массив()));
	ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	// человек очистил адрес формой кабинета — пустой адрес нормализатор разрешает
	Адреса().Сменить(СП.НайтиПоЛогину(Логин), "");
	Ожидаем.Что(Строка(СП.НайтиПоЛогину(Логин).Email), "КОНТРОЛЬ: адрес снят").Равно("");

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2",
		Профиль(Субъект, Логин, Email, Истина, Новый Массив()));
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Второй.Успех, Второй.Причина).ЭтоИстина();
	Ожидаем.Что(Строка(СП.НайтиПоЛогину(Логин).Email),
		"пустой адрес заполняется профилем — в том числе очищенный намеренно").Равно(НРег(Email));

КонецПроцедуры

// Единственный путь склеить существующую учётку с провайдером — ручная привязка из
// кабинета (/me/settings/oidc). Проверяется на провайдере с ВЫКЛЮЧЕННЫМ auto-provisioning:
// именно так выглядит инсталляция по умолчанию.
&Тест
Процедура РучнаяПривязкаИзКабинетаСклеиваетУчёткуСПровайдером() Экспорт

	Пр = НастроитьПровайдера(Ложь);
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");
	Суффикс = УникальныйСуффикс();
	Email = "kate_" + Суффикс + "@ex.com";
	Хозяин = СП.СоздатьПользователя("kate" + Суффикс, Email, "password123", "user");
	Субъект = "sub-" + Суффикс;

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "kate", Email, Истина, Новый Массив()));
	Привязка = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", Хозяин.Идентификатор);

	Ожидаем.Что(Привязка.Успех, Привязка.Причина).ЭтоИстина();
	Ожидаем.Что(СЛ.НайтиПользователяПоЛичности(Пр.Издатель, Субъект).Идентификатор,
		"личность привязана к учётке инициатора").Равно(Хозяин.Идентификатор);
	// спрашиваем ДО следующего входа: после него логин дописала бы актуализация профиля
	Ожидаем.Что(Строка(СЛ.НайтиЛичность(Пр.Издатель, Субъект).ПредпочтительныйЛогин),
		"ручная привязка запомнила логин у провайдера").Равно("kate");

	// и обычный вход этой личности пускает в ту же учётку — при выключенном провижининге
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2",
		Профиль(Субъект, "kate", Email, Истина, Новый Массив()));
	Вход = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Вход.Успех, Вход.Причина).ЭтоИстина();
	Ожидаем.Что(Вход.Новая, "учётка прежняя").ЭтоЛожь();
	Ожидаем.Что(Вход.Пользователь.Идентификатор).Равно(Хозяин.Идентификатор);
	Ожидаем.Что(СП.НайтиПоЛогину(Хозяин.Логин).EmailПодтверждён = Истина,
		"адрес совпал и IdP за него поручился — флаг поднят").ЭтоИстина();

КонецПроцедуры

// Кабинет показывает привязку логином у провайдера, а не машинным sub — значит логин
// обязан лечь в саму запись личности при её заведении.
&Тест
Процедура ВходЗапоминаетЛогинУПровайдераВЛичности() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СЛ = Желудь("СервисЛичностей");
	Суффикс = УникальныйСуффикс();
	Субъект = "sub-" + Суффикс;
	ЛогинУПровайдера = "Ola" + Суффикс;

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, ЛогинУПровайдера, "ola_" + Суффикс + "@ex.com", Истина, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, Исход.Причина).ЭтоИстина();
	Личность = СЛ.НайтиЛичность(Пр.Издатель, Субъект);
	Ожидаем.Что(Строка(Личность.ПредпочтительныйЛогин),
		"логин у провайдера записан как есть, регистр не тронут").Равно(ЛогинУПровайдера);

КонецПроцедуры

// Логин у провайдера человек меняет — привязка обязана догонять его на входе, иначе
// кабинет годами показывает имя, которого у провайдера уже нет. Пропавший клейм при этом
// ничего не затирает: это деградация ответа IdP, а не переименование.
&Тест
Процедура ПовторныйВходОбновляетЛогинУПровайдера() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СЛ = Желудь("СервисЛичностей");
	Суффикс = УникальныйСуффикс();
	Субъект = "sub-" + Суффикс;
	Email = "pit_" + Суффикс + "@ex.com";

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "pit" + Суффикс, Email, Истина, Новый Массив()));
	ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Новый_ = "pit-new" + Суффикс;
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2",
		Профиль(Субъект, Новый_, Email, Истина, Новый Массив()));
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Второй.Успех, Второй.Причина).ЭтоИстина();
	Ожидаем.Что(Строка(СЛ.НайтиЛичность(Пр.Издатель, Субъект).ПредпочтительныйЛогин),
		"новый логин у провайдера доехал до записи").Равно(Новый_);

	// третий вход БЕЗ клейма логина — прежнее значение остаётся
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s3", "n3",
		Профиль(Субъект, "", Email, Истина, Новый Массив()));
	Третий = ЗавершитьВход(Фейк, Пр, "s3", "s3", "n3", "v3", 0);

	Ожидаем.Что(Третий.Успех, Третий.Причина).ЭтоИстина();
	Ожидаем.Что(Строка(СЛ.НайтиЛичность(Пр.Издатель, Субъект).ПредпочтительныйЛогин),
		"пропавший клейм логин не затирает").Равно(Новый_);

КонецПроцедуры

// Провайдер не обязан отдавать preferred_username. Вход при этом проходит, личность
// заводится, а логин остаётся пустым — кабинету это штатный случай отката к субъекту.
&Тест
Процедура ВходБезКлеймаЛогинаОставляетЛичностьБезЛогина() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	СЛ = Желудь("СервисЛичностей");
	Суффикс = УникальныйСуффикс();
	Субъект = "sub-" + Суффикс;

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "", "nick_" + Суффикс + "@ex.com", Истина, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, "клейма логина нет — вход всё равно проходит: " + Исход.Причина).ЭтоИстина();
	Ожидаем.Что(Строка(СЛ.НайтиЛичность(Пр.Издатель, Субъект).ПредпочтительныйЛогин),
		"логина у провайдера нет — поле пустое, а не «Неопределено»").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Безопасность

&Тест
Процедура StateMismatchОтклоняетВход() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	Субъект = "sub-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "expected", "n", Профиль(Субъект, "grace", "", Ложь, Новый Массив()));

	// полученный state НЕ совпадает с ожидаемым (из сессии) → отказ до любого обмена
	Исход = ЗавершитьВход(Фейк, Пр, "expected", "attacker-state", "n", "v", 0);

	Ожидаем.Что(Исход.Успех).ЭтоЛожь();
	Ожидаем.Что(Исход.Причина).Равно("state_mismatch");
	Ожидаем.Что(Исход.Пользователь).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура NonceMismatchОтклоняетВход() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	Субъект = "sub-" + УникальныйСуффикс();
	// в id_token зашит nonce="wrong", а сессия ожидает "expected-nonce"
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "wrong", Профиль(Субъект, "heidi", "", Ложь, Новый Массив()));

	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "expected-nonce", "v", 0);

	Ожидаем.Что(Исход.Успех).ЭтоЛожь();
	Ожидаем.Что(Исход.Причина).Равно("id_token_invalid");

КонецПроцедуры

&Тест
Процедура ПодделкаIdTokenЧужойAudНеПринимается() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	Субъект = "sub-" + УникальныйСуффикс();

	// злоумышленник подсовывает id_token с ЧУЖИМ aud (выписан другому клиенту). Даже придя
	// через token endpoint, он отклоняется проверкой aud — прямого пути принять id_token нет.
	Клеймы = БазовыеКлеймы(Пр, Субъект, "n");
	Клеймы.Вставить("aud", "another-client");
	Фейк.УстановитьОтветТокена(ОтветТокена(JWT(Клеймы)));
	Фейк.УстановитьОтветПрофиля(ВJSON(Профиль(Субъект, "mallory", "", Ложь, Новый Массив())));

	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(Исход.Успех).ЭтоЛожь();
	Ожидаем.Что(Исход.Причина).Равно("id_token_invalid");

КонецПроцедуры

&Тест
Процедура ОшибкаTokenEndpointОтклоняетВход() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	// token endpoint возвращает ошибку OAuth (например invalid_grant) → обмен не удался
	Фейк.УстановитьОтветТокена("{""error"":""invalid_grant""}", 400);

	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(Исход.Успех).ЭтоЛожь();
	Ожидаем.Что(Исход.Причина).Равно("exchange_failed");

КонецПроцедуры

&Тест
Процедура ОтключённыйAutoProvisioningНеСоздаётПользователя() Экспорт

	Пр = НастроитьПровайдера(Ложь); // auto-provisioning выключен
	Фейк = НовыйФейк(Пр);
	Субъект = "sub-" + УникальныйСуффикс();
	СП = Желудь("СервисПользователей");
	ДоВхода = СП.ВсегоПользователей();

	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n", Профиль(Субъект, "nobody", "", Ложь, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех).ЭтоЛожь();
	Ожидаем.Что(Исход.Причина).Равно("provisioning_disabled");
	Ожидаем.Что(СП.ВсегоПользователей()).Равно(ДоВхода); // ни одного нового пользователя
	Ожидаем.Что(Желудь("СервисЛичностей").НайтиПользователяПоЛичности(Пр.Издатель, Субъект)).Равно(Неопределено);

КонецПроцедуры

// Адрес почты принадлежит одной учётке (ИСТ-ДОСТ-029). Провайдер, приславший чужой
// адрес, второй учётки не заводит: иначе письма хаба разъехались бы по двум адресатам,
// а восстановление пароля — по двум учёткам. Отказ назван, вход не падает исключением.
&Тест
Процедура АвтозаведениеНаЗанятыйАдресОтвергаетсяСНазваннойПричиной() Экспорт

	Пр = НастроитьПровайдера(Истина); // auto-provisioning включён
	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");

	Занятый = "taken_" + УникальныйСуффикс() + "@ex.com";
	Хозяин = СП.СоздатьПользователя("owner" + УникальныйСуффикс(), Занятый, "password123", "user");
	ДоВхода = СП.ВсегоПользователей();

	Субъект = "sub-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "newcomer" + УникальныйСуффикс(), Занятый, Истина, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, "автозаведение на занятый адрес отклонено").ЭтоЛожь();
	Ожидаем.Что(Исход.Причина, "причина названа").Равно("email_taken");
	Ожидаем.Что(СП.ВсегоПользователей(), "второй учётки не появилось").Равно(ДоВхода);
	Ожидаем.Что(Желудь("СервисЛичностей").НайтиПользователяПоЛичности(Пр.Издатель, Субъект),
		"и личность к чужой учётке не привязана").Равно(Неопределено);
	Ожидаем.Что(Желудь("СервисЛичностей").ЛичностиПользователя(Хозяин.Идентификатор).Количество(),
		"учётка владельца адреса личности не получила").Равно(0);

	// текст отказа на странице входа отличим от общего
	Сообщение = НовыеТекстыОтказов().ОтказПровайдера("email_taken");
	Ожидаем.Что(СтрНайти(НРег(Сообщение), "почт") > 0, "страница объясняет, что дело в адресе: "
		+ Сообщение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПоУмолчаниюЛичностьНеПривязываетсяКУчёткеПоПодтверждённомуEmail() Экспорт

	// Гарантия долга Р-7: с умолчанием через провайдера входят только уже привязанные
	// личности. Неизвестная личность не получает ни новой учётки, ни — тем более — чужой
	// существующей: привязки по email в хабе нет вовсе (см.
	// ЛичностьНеЗахватываетУчёткуСТемЖеПодтверждённымEmail). Тест обязан краснеть,
	// если вернуть дефолт AUTOPROVISION в Истина.
	Пр = ПровайдерСДефолтами(); // AUTOPROVISION не задан вовсе — работает умолчание
	Ожидаем.Что(Пр.АвтоСоздание, "AUTOPROVISION выключен по умолчанию").ЭтоЛожь();

	Фейк = НовыйФейк(Пр);
	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");
	Email = "root_" + УникальныйСуффикс() + "@ex.com";
	Админ = СП.СоздатьПользователя("root" + УникальныйСуффикс(), Email, "password123", "admin");
	ДоВхода = СП.ВсегоПользователей();

	Субъект = "sub-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "chuck_" + УникальныйСуффикс(), Email, Истина, Новый Массив()));
	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, "вход непривязанной личности отклонён").ЭтоЛожь();
	Ожидаем.Что(Исход.Причина, "причина различима (а не пустая и не исключение)").Равно("provisioning_disabled");
	Ожидаем.Что(Исход.Пользователь, "чужая учётка не выдана").Равно(Неопределено);
	// привязки не случилось — иначе следующий вход прошёл бы уже по шагу 1 (личность известна)
	Ожидаем.Что(СЛ.ЛичностиПользователя(Админ.Идентификатор).Количество(),
		"учётка администратора не получила личность IdP").Равно(0);
	Ожидаем.Что(СЛ.НайтиПользователяПоЛичности(Пр.Издатель, Субъект),
		"личность вообще не зарегистрирована").Равно(Неопределено);
	Ожидаем.Что(СП.ВсегоПользователей(), "и нового пользователя не завели").Равно(ДоВхода);

КонецПроцедуры

// Уникальность пары «издатель + субъект» держит ТОЛЬКО СервисЛичностей: индексов проект не заводит, а вторая
// строка на ту же личность означала бы угон — НайтиПоЛичности вернула бы одну из двух учёток недетерминированно.
&Тест
Процедура ЛичностьЗанятаяДругимПользователемНеПривязываетсяПовторно() Экспорт

	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");
	Суффикс = УникальныйСуффикс();

	Издатель = "https://idp-" + Суффикс + ".example";
	Субъект = "sub-" + Суффикс;
	Владелец = СП.СоздатьПользователя("own_" + Суффикс, "", "password123", "user");
	Чужой = СП.СоздатьПользователя("alien_" + Суффикс, "", "password123", "user");

	СЛ.Привязать(Владелец.Идентификатор, Издатель, Субъект);

	// повтор тому же пользователю — идемпотентен, второй строки не появляется
	СЛ.Привязать(Владелец.Идентификатор, Издатель, Субъект);
	Ожидаем.Что(СЛ.ЛичностиПользователя(Владелец.Идентификатор).Количество(),
		"повторная привязка той же личности не плодит строк").Равно(1);

	// а вот чужому — отказ с внятной ошибкой
	БылоИсключение = Ложь;
	Текст = "";
	Попытка
		СЛ.Привязать(Чужой.Идентификатор, Издатель, Субъект);
	Исключение
		БылоИсключение = Истина;
		Текст = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(БылоИсключение, "привязка занятой личности обязана отвергаться").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "уже привязана к другому пользователю") > 0,
		"ошибка называет причину: " + Текст).ЭтоИстина();
	Ожидаем.Что(СЛ.ЛичностиПользователя(Чужой.Идентификатор).Количество(),
		"чужой не получил личность").Равно(0);
	Ожидаем.Что(СЛ.НайтиПользователяПоЛичности(Издатель, Субъект).Идентификатор,
		"личность осталась за первым владельцем").Равно(Владелец.Идентификатор);

КонецПроцедуры

#КонецОбласти

#Область МаппингГрупп

// Связка группы — одна строка на группу, и держит это только ОбеспечитьСвязку: обе точки записи (синхронизация
// членства на каждом входе и форма политики выпавших) зовут её, а дубль сделал бы политику нечитаемой.
&Тест
Процедура СвязкаГруппыOIDCОстаётсяОднойНаГруппу() Экспорт

	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");
	Хранилище = Желудь("ХранилищеСвязокГруппOIDC");

	Пр = ПровайдерГрупп(Истина, Ложь, "");
	Суффикс = УникальныйСуффикс();
	Имя = "bind-" + Суффикс;
	Юзер = СП.СоздатьПользователя("bu_" + Суффикс, "", "password123", "user");

	// два входа подряд плюс правка политики — три обращения к ОбеспечитьСвязку на одну группу
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);
	Группа = СГ.НайтиГруппу(Имя);
	ССГ.УстановитьПолитикуВыпавших(Группа.Идентификатор, "оставлять");

	Свои = 0;
	Для Каждого Связка Из Хранилище.Все() Цикл
		Если Цел(Связка.ГруппаИдентификатор) = Цел(Группа.Идентификатор) Тогда
			Свои = Свои + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Свои, "на группу заведена ровно одна связка").Равно(1);
	Ожидаем.Что(ССГ.ПолитикаВыпавших(Группа.Идентификатор),
		"политика читается из той самой строки").Равно("оставлять");

КонецПроцедуры

&Тест
Процедура СинхронизацияДобавляетИУбираетOIDCЧленства() Экспорт

	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Издатель = "https://idp-grp-" + УникальныйСуффикс();
	Юзер = СП.СоздатьПользователя("gu_" + УникальныйСуффикс(), "", "password123", "user");
	Г1 = СГ.СоздатьГруппу("g1_" + УникальныйСуффикс(), "");
	Г2 = СГ.СоздатьГруппу("g2_" + УникальныйСуффикс(), "");
	ССГ.ДобавитьСопоставление(Г1.Идентификатор, Издатель, "team-a");
	ССГ.ДобавитьСопоставление(Г2.Идентификатор, Издатель, "team-b");

	// клеймы содержат team-a → пользователь в Г1, не в Г2
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Издатель, КлеймыСГруппами("team-a"), Неопределено);
	Ожидаем.Что(ВГруппе(СГ, Г1, Юзер)).ЭтоИстина();
	Ожидаем.Что(ВГруппе(СГ, Г2, Юзер)).ЭтоЛожь();

	// теперь клеймы содержат team-b → из Г1 убран (OIDC), в Г2 добавлен
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Издатель, КлеймыСГруппами("team-b"), Неопределено);
	Ожидаем.Что(ВГруппе(СГ, Г1, Юзер), "team-a ушёл — членство Г1 снято").ЭтоЛожь();
	Ожидаем.Что(ВГруппе(СГ, Г2, Юзер)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СинхронизацияНеТрогаетЛокальноеЧленство() Экспорт

	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");
	ХУ = Желудь("ХранилищеУчастниковГрупп");

	Издатель = "https://idp-loc-" + УникальныйСуффикс();
	Юзер = СП.СоздатьПользователя("lu_" + УникальныйСуффикс(), "", "password123", "user");
	Г = СГ.СоздатьГруппу("lg_" + УникальныйСуффикс(), "");

	// ЛОКАЛЬНОЕ членство (из кабинета)
	СГ.ДобавитьУчастника(Г.Идентификатор, Юзер.Идентификатор, "local");
	// маппинг на ту же группу существует
	ССГ.ДобавитьСопоставление(Г.Идентификатор, Издатель, "team-x");

	// синхронизация БЕЗ team-x в клеймах — локальное членство обязано остаться
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Издатель, КлеймыСГруппами("team-none"), Неопределено);
	Членство = ХУ.НайтиЧленство(Г.Идентификатор, Юзер.Идентификатор);
	Ожидаем.Что(Членство, "локальное членство не удалено").Существует();
	Ожидаем.Что(Строка(Членство.Источник)).Равно("local");

	// синхронизация С team-x — членство остаётся локальным (не дублируется, не понижается)
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Издатель, КлеймыСГруппами("team-x"), Неопределено);
	Ожидаем.Что(ХУ.ПолучитьПоГруппаИдентификаторРавно(Г.Идентификатор).Количество()).Равно(1);
	Ожидаем.Что(Строка(ХУ.НайтиЧленство(Г.Идентификатор, Юзер.Идентификатор).Источник)).Равно("local");

КонецПроцедуры

&Тест
Процедура ЭффективныеПраваЧерезOIDCГруппу() Экспорт

	// интеграция с 3.B: маппинг клеймов даёт права ЧЕРЕЗ группу-субъекта прав
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");
	СПрав = Желудь("СервисПрав");
	ХУП = Желудь("ХранилищеУчастниковПула");

	Издатель = "https://idp-perm-" + УникальныйСуффикс();
	Юзер = СП.СоздатьПользователя("pu_" + УникальныйСуффикс(), "", "password123", "user");
	Группа = СГ.СоздатьГруппу("ops_" + УникальныйСуффикс(), "");
	ССГ.ДобавитьСопоставление(Группа.Идентификатор, Издатель, "team-ops");

	ПулИд = 4200 + Счётчик;
	// группе выдана роль publisher на пуле (3.B)
	Запись = ХУП.СоздатьЭлемент();
	Запись.ПулИдентификатор = ПулИд;
	Запись.ТипСубъекта = "группа";
	Запись.СубъектИдентификатор = Группа.Идентификатор;
	Запись.Роль = "publisher";
	Запись.Сохранить();

	// до входа прав нет
	Ожидаем.Что(СПрав.РольНаПул(Юзер, ПулИд)).Равно("");

	// OIDC-клеймы team-ops → членство в группе → эффективная роль publisher
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Издатель, КлеймыСГруппами("team-ops"), Неопределено);
	// наружу отдаётся имя роли В-1: легаси-строка participant «publisher» свёрнута в райтера
	Ожидаем.Что(СПрав.РольНаПул(Юзер, ПулИд)).Равно("райтер");
	Ожидаем.Что(СПрав.МожетПисать(Юзер, ПоддельныйПул(ПулИд, "private"))).ЭтоИстина();

	// потеря клейма team-ops снимает членство → права уходят
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Издатель, КлеймыСГруппами("team-none"), Неопределено);
	Ожидаем.Что(СПрав.РольНаПул(Юзер, ПулИд)).Равно("");

КонецПроцедуры

#КонецОбласти

#Область ДеградацияПрофиля

&Тест
Процедура ДеградацияUserinfoНеСноситГруппыOIDC() Экспорт

	Пр = ПровайдерВходаСГруппами();
	Фейк = НовыйФейк(Пр);
	СГ = Желудь("СервисГрупп");
	Субъект = "sub-deg-" + УникальныйСуффикс();
	ИмяГруппы = "deg-" + УникальныйСуффикс();
	Логин = "deg_" + УникальныйСуффикс();

	// 1) полноценный профиль с группой
	Группы = Новый Массив();
	Группы.Добавить(ИмяГруппы);
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s1", "n1",
		Профиль(Субъект, Логин, "", Ложь, Группы));
	Первый = ЗавершитьВход(Фейк, Пр, "s1", "s1", "n1", "v1", 0);
	Ожидаем.Что(Первый.Успех, Первый.Причина).ЭтоИстина();

	Группа = СГ.НайтиГруппу(ИмяГруппы);
	Ожидаем.Что(Группа, "КОНТРОЛЬ: профиль с группой завёл группу").Существует();
	Ожидаем.Что(ВГруппе(СГ, Группа, Первый.Пользователь),
		"КОНТРОЛЬ: членство по клейму создано").ЭтоИстина();

	// 2) тот же вход, отличается РОВНО тем, что userinfo лёг (500)
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s2", "n2", Профиль(Субъект, Логин, "", Ложь, Новый Массив()));
	Фейк.УстановитьОтветПрофиля("{}", 500);
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);
	Ожидаем.Что(Второй.Успех, "деградация userinfo вход НЕ рушит: " + Второй.Причина).ЭтоИстина();
	Ожидаем.Что(ВГруппе(СГ, Группа, Первый.Пользователь),
		"один 500-й ответ провайдера НЕ отбирает у пользователя группы OIDC").ЭтоИстина();

	// 3) userinfo жив, но группы в профиле больше нет — членство обязано сняться
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s3", "n3", Профиль(Субъект, Логин, "", Ложь, Новый Массив()));
	Третий = ЗавершитьВход(Фейк, Пр, "s3", "s3", "n3", "v3", 0);
	Ожидаем.Что(Третий.Успех, Третий.Причина).ЭтоИстина();
	Ожидаем.Что(ВГруппе(СГ, Группа, Первый.Пользователь),
		"КОНТРОЛЬ: при ЖИВОМ профиле выпавшая группа снимается — синхронизация работает").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПредикатСинхронизацииГруппDefaultClosed() Экспорт

	Сервис = Желудь("СервисВходаOIDC");

	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(
		Новый Структура("ПрофильПолучен", Истина)), "профиль получен — синхронизируем").ЭтоИстина();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(
		Новый Структура("ПрофильПолучен", Ложь)), "профиль не получен — пропуск").ЭтоЛожь();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(
		Новый Структура("ПрофильПолучен", Неопределено)), "Неопределено — пропуск").ЭтоЛожь();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(
		Новый Структура("Успех", Истина)), "поля вовсе нет — пропуск (default-closed)").ЭтоЛожь();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(Неопределено),
		"не структура — пропуск").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПровижинингГруппИПолитикаВыпавших

&Тест
Процедура JITПровижинингСоздаётГруппуИзКлеймаИДобавляетУчастника() Экспорт

	// Ветка 1: «всё управляется в IdP» — группы в хабе руками не заводят.
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Пр = ПровайдерГрупп(Истина, Ложь, "");
	Имя = "jit-" + УникальныйСуффикс();
	Юзер = СП.СоздатьПользователя("ju_" + УникальныйСуффикс(), "", "password123", "user");

	Ожидаем.Что(СГ.НайтиГруппу(Имя), "до входа такой группы нет").Равно(Неопределено);

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);

	Группа = СГ.НайтиГруппу(Имя);
	Ожидаем.Что(Группа, "группа создана JIT-провижинингом").Существует();
	Ожидаем.Что(ВГруппе(СГ, Группа, Юзер), "участник добавлен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СвязкаПоИмениНеСоздаётГруппуНоПривязываетСуществующую() Экспорт

	// Ветка 2: права раздаёт админ хаба — группа заводится вручную, из IdP только состав.
	// Ключевое отличие от JIT: НЕСУЩЕСТВУЮЩАЯ группа не появляется.
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Пр = ПровайдерГрупп(Ложь, Истина, "");
	ИмяСозданной = "link-" + УникальныйСуффикс();
	ИмяНесозданной = "ghost-" + УникальныйСуффикс();
	Группа = СГ.СоздатьГруппу(ИмяСозданной, "заведена админом хаба");
	Юзер = СП.СоздатьПользователя("lu2_" + УникальныйСуффикс(), "", "password123", "user");

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(ИмяСозданной), Пр);
	Ожидаем.Что(ВГруппе(СГ, Группа, Юзер), "существующая группа связана по имени").ЭтоИстина();

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(ИмяНесозданной), Пр);
	Ожидаем.Что(СГ.НайтиГруппу(ИмяНесозданной),
		"связка по имени НЕ создаёт групп — иначе она неотличима от JIT").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОбаМеханизмаВыключеныПоУмолчанию() Экспорт

	// Включение отдаёт управление составом групп хаба стороне IdP: это решение
	// инсталляции, а не поведение из коробки.
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Пр = НастроитьПровайдера(Истина); // без флагов групп вовсе
	Ожидаем.Что(Пр.ПровижинингГрупп, "JIT выключен по умолчанию").ЭтоЛожь();
	Ожидаем.Что(Пр.СвязкаГруппПоИмени, "связка по имени выключена по умолчанию").ЭтоЛожь();

	Имя = "off-" + УникальныйСуффикс();
	Существующая = СГ.СоздатьГруппу(Имя, "");
	Юзер = СП.СоздатьПользователя("ou_" + УникальныйСуффикс(), "", "password123", "user");

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);

	Ожидаем.Что(ВГруппе(СГ, Существующая, Юзер),
		"без флагов имя клейма не означает членство").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПрефиксОтделяетГруппыIdPОтЛокальных() Экспорт

	// Без префикса клейм «admins» связался бы с локальной группой «admins», которой
	// админ мог выдать гранты. Префикс делает пространство имён IdP отдельным.
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Суффикс = УникальныйСуффикс();
	ЛокальноеИмя = "priv-" + Суффикс;
	Локальная = СГ.СоздатьГруппу(ЛокальноеИмя, "локальная группа с грантами");
	Пр = ПровайдерГрупп(Истина, Ложь, "sso-");
	Юзер = СП.СоздатьПользователя("pu2_" + Суффикс, "", "password123", "user");

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(ЛокальноеИмя), Пр);

	Ожидаем.Что(ВГруппе(СГ, Локальная, Юзер),
		"клейм не дотянулся до локальной группы того же имени").ЭтоЛожь();
	Ожидаем.Что(СГ.НайтиГруппу("sso-" + ЛокальноеИмя), "создана группа с префиксом").Существует();

КонецПроцедуры

&Тест
Процедура НепригодноеЗначениеКлеймаНеСтановитсяГруппой() Экспорт

	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Пр = ПровайдерГрупп(Истина, Ложь, "");
	Юзер = СП.СоздатьПользователя("bu_" + УникальныйСуффикс(), "", "password123", "user");

	Мусор = Новый Массив();
	Мусор.Добавить("");                       // пустое
	Мусор.Добавить("   ");                    // только пробелы
	Мусор.Добавить("group with spaces");      // пробелы внутри
	Мусор.Добавить("../../etc");              // ход по каталогам в адресе /groups/{g}
	Мусор.Добавить("группа");                 // кириллица
	Мусор.Добавить(Лев("aaaaaaaaaa", 10) + Лев("bbbbbbbbbb", 10) + Лев("cccccccccc", 10)
		+ Лев("dddddddddd", 10) + Лев("eeeeeeeeee", 10) + Лев("ffffffffff", 10) + "gggggg"); // 66 символов

	Клеймы = Новый Соответствие();
	Клеймы.Вставить("groups", Мусор);

	Итог = ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, Клеймы, Пр);

	Ожидаем.Что(Итог.Добавлено, "ни одно мусорное значение не стало группой").Равно(0);
	Ожидаем.Что(СГ.НайтиГруппу("group with spaces")).Равно(Неопределено);
	Ожидаем.Что(СГ.НайтиГруппу("../../etc")).Равно(Неопределено);
	Ожидаем.Что(СГ.НайтиГруппу("группа")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПолитикаИсключатьПоУмолчаниюСнимаетВыпавшего() Экспорт

	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Пр = ПровайдерГрупп(Истина, Ложь, "");
	Имя = "pol-out-" + УникальныйСуффикс();
	Юзер = СП.СоздатьПользователя("po_" + УникальныйСуффикс(), "", "password123", "user");

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);
	Группа = СГ.НайтиГруппу(Имя);
	Ожидаем.Что(ССГ.ПолитикаВыпавших(Группа.Идентификатор), "умолчание").Равно("исключать");
	Ожидаем.Что(ВГруппе(СГ, Группа, Юзер)).ЭтоИстина();

	Итог = ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель,
		КлеймыСГруппами("other-" + УникальныйСуффикс()), Пр);

	Ожидаем.Что(ВГруппе(СГ, Группа, Юзер), "выпал из клейма — членство снято").ЭтоЛожь();
	Ожидаем.Что(Итог.Удалено >= 1, "удаление посчитано").ЭтоИстина();
	Ожидаем.Что(Итог.Оставлено, "по умолчанию никого не оставляем").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолитикаОставлятьСохраняетВыпавшегоНоТолькоВСвоейГруппе() Экспорт

	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Пр = ПровайдерГрупп(Истина, Ложь, "");
	Суффикс = УникальныйСуффикс();
	ИмяОставлять = "keep-" + Суффикс;
	ИмяИсключать = "drop-" + Суффикс;
	Юзер = СП.СоздатьПользователя("ko_" + Суффикс, "", "password123", "user");

	// один вход даёт обе группы
	Клеймы = Новый Соответствие();
	Обе = Новый Массив();
	Обе.Добавить(ИмяОставлять);
	Обе.Добавить(ИмяИсключать);
	Клеймы.Вставить("groups", Обе);
	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, Клеймы, Пр);

	ГруппаОставлять = СГ.НайтиГруппу(ИмяОставлять);
	ГруппаИсключать = СГ.НайтиГруппу(ИмяИсключать);
	Ожидаем.Что(ССГ.УстановитьПолитикуВыпавших(ГруппаОставлять.Идентификатор, "оставлять")).Равно("оставлять");

	// следующий вход не приносит ни одной из групп
	Итог = ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель,
		КлеймыСГруппами("nothing-" + Суффикс), Пр);

	Ожидаем.Что(ВГруппе(СГ, ГруппаОставлять, Юзер), "политика «оставлять» удержала членство").ЭтоИстина();
	Ожидаем.Что(ВГруппе(СГ, ГруппаИсключать, Юзер),
		"политика группы НЕ распространяется на соседнюю группу").ЭтоЛожь();
	Ожидаем.Что(Итог.Оставлено).Равно(1);
	Ожидаем.Что(Итог.Удалено).Равно(1);

КонецПроцедуры

&Тест
Процедура НеизвестноеЗначениеПолитикиПриводитсяКИсключать() Экспорт

	// Политика приходит из формы: опечатка не должна становиться третьим режимом,
	// в котором членства не снимаются вовсе.
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");

	Группа = СГ.СоздатьГруппу("badpol-" + УникальныйСуффикс(), "");
	Ожидаем.Что(ССГ.УстановитьПолитикуВыпавших(Группа.Идентификатор, "оставлятьь")).Равно("исключать");
	Ожидаем.Что(ССГ.ПолитикаВыпавших(Группа.Идентификатор)).Равно("исключать");

КонецПроцедуры

&Тест
Процедура ВремяСинхронизацииПишетсяНаКаждойСверке() Экспорт

	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");

	Пр = ПровайдерГрупп(Истина, Ложь, "");
	Имя = "sync-" + УникальныйСуффикс();
	Юзер = СП.СоздатьПользователя("su_" + УникальныйСуффикс(), "", "password123", "user");

	Свежая = СГ.СоздатьГруппу("never-" + УникальныйСуффикс(), "");
	Ожидаем.Что(ССГ.СинхронизированаВ(Свежая.Идентификатор),
		"группа, которую не сверяли, отметки не имеет").Равно(Неопределено);

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);
	Группа = СГ.НайтиГруппу(Имя);

	Ожидаем.Что(ССГ.СинхронизированаВ(Группа.Идентификатор), "отметка проставлена").Существует();

КонецПроцедуры

&Тест
Процедура УдалениеГруппыУноситСоставПраваРолиИСвязкиOIDC() Экспорт

	// Сирота опаснее пропажи: снятая группа, чьи права остались в базе, отдаёт их
	// следующей группе с тем же идентификатором. Проверяем, что не остаётся НИЧЕГО.
	Служба = Желудь("СлужбаГрупп");
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");
	Права = Желудь("СервисПравДоступа");
	СервисПравТест = Желудь("СервисПрав");
	Участники = Желудь("ХранилищеУчастниковГрупп");
	УчастникиПула = Желудь("ХранилищеУчастниковПула");
	Сопоставления = Желудь("ХранилищеСопоставленийГруппOIDC");
	Связки = Желудь("ХранилищеСвязокГруппOIDC");

	Имя = "cascade-" + УникальныйСуффикс();
	Группа = Служба.Создать(Имя, "");
	Ид = Группа.Идентификатор;
	Юзер = СП.СоздатьПользователя("cu_" + УникальныйСуффикс(), "", "password123", "user");

	СГ.ДобавитьУчастника(Ид, Юзер.Идентификатор, "local");
	Права.ЗафиксироватьГрант("группа", Ид, СервисПравТест.ОписаниеОбъекта("хаб", 0, 0),
		Новый Структура("чтение", Истина));
	ССГ.ДобавитьСопоставление(Ид, "https://idp-cascade.test", Имя, "groups");
	ССГ.УстановитьПолитикуВыпавших(Ид, ССГ.ПолитикаОставлять());
	Роль = УчастникиПула.СоздатьЭлемент();
	Роль.ПулИдентификатор = 4242;
	Роль.ТипСубъекта = "группа";
	Роль.СубъектИдентификатор = Ид;
	Роль.Роль = СервисПравТест.РольЧитатель();
	Роль.Сохранить();

	Итог = Служба.Удалить(Ид, "root");

	Ожидаем.Что(Итог.Удалена, "группа удалена").ЭтоИстина();
	Ожидаем.Что(СГ.ПоИдентификатору(Ид), "самой группы нет").Равно(Неопределено);
	Ожидаем.Что(Участники.ПолучитьПоГруппаИдентификаторРавно(Ид).Количество(),
		"состав ушёл вместе с группой").Равно(0);
	Ожидаем.Что(Права.ГрантыСубъекта("группа", Ид).Количество(),
		"права группы сняты — иначе они достанутся следующей группе с тем же идентификатором")
		.Равно(0);
	Ожидаем.Что(УчастникиПула.РолиСубъекта("группа", Ид).Количество(),
		"роли группы на пулах сняты").Равно(0);
	Ожидаем.Что(Сопоставления.ПолучитьПоГруппаИдентификаторРавно(Ид).Количество(),
		"правила маппинга клеймов сняты").Равно(0);
	Ожидаем.Что(Связки.НайтиПоГруппе(Ид), "строка связки с политикой снята").Равно(Неопределено);
	Ожидаем.Что(Итог.Грантов = 1 И Итог.Ролей = 1 И Итог.Сопоставлений = 1,
		СтрШаблон("итог уборки называет числа: права %1, роли %2, сопоставления %3",
			Итог.Грантов, Итог.Ролей, Итог.Сопоставлений)).ЭтоИстина();

	Ожидаем.Что(Служба.Удалить(Ид, "root").Удалена,
		"повторное удаление — не ошибка, а «нечего удалять»").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УдалённуюГруппуПровижинингЗаводитЗановоИНеПадает() Экспорт

	// Решение владельца: OIDC-группа удаляется как любая другая. Приедет снова — так и
	// задумано, но приехать она обязана ЧИСТОЙ, без прав снесённой тёзки.
	Служба = Желудь("СлужбаГрупп");
	ССГ = Желудь("СервисСопоставленийГрупп");
	СГ = Желудь("СервисГрупп");
	СП = Желудь("СервисПользователей");
	Права = Желудь("СервисПравДоступа");
	СервисПравТест = Желудь("СервисПрав");

	Пр = ПровайдерГрупп(Истина, Ложь, "");
	Имя = "revive-" + УникальныйСуффикс();
	Юзер = СП.СоздатьПользователя("ru_" + УникальныйСуффикс(), "", "password123", "user");

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);
	Заведённая = СГ.НайтиГруппу(Имя);
	Ожидаем.Что(Заведённая, "группа заведена провижинингом").Существует();

	Права.ЗафиксироватьГрант("группа", Заведённая.Идентификатор,
		СервисПравТест.ОписаниеОбъекта("хаб", 0, 0), Новый Структура("чтение", Истина));

	Ожидаем.Что(Служба.Удалить(Заведённая.Идентификатор, "root").Удалена,
		"группа из OIDC удаляется тем же способом, что и заведённая руками").ЭтоИстина();
	Ожидаем.Что(СГ.НайтиГруппу(Имя), "после удаления её нет").Равно(Неопределено);

	ССГ.СинхронизироватьЧленство(Юзер.Идентификатор, Пр.Издатель, КлеймыСГруппами(Имя), Пр);

	Возрождённая = СГ.НайтиГруппу(Имя);
	Ожидаем.Что(Возрождённая, "следующий вход заводит её заново").Существует();
	Ожидаем.Что(ВГруппе(СГ, Возрождённая, Юзер), "и возвращает участника").ЭтоИстина();
	Ожидаем.Что(Права.ГрантыСубъекта("группа", Возрождённая.Идентификатор).Количество(),
		"прав снесённой тёзки новая группа не наследует").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустойПрефиксПриВключённыхМеханизмахТребуетПредупреждения() Экспорт

	// Решение владельца 2026-07-28: префикс НЕ обязателен (сценарий «наши группы и есть
	// группы IdP» законный), но конфигурация обязана о себе заявить. Проверяем условие
	// предупреждения предикатом — вылавливание строки из журнала проверяло бы формат
	// сообщения, а не правило.
	Конфиг = Желудь("КонфигурацияOIDC");

	// связка по имени без префикса — предупреждаем
	Ожидаем.Что(Конфиг.ПрефиксГруппНуженНоНеЗадан(ПровайдерГрупп(Ложь, Истина, "")),
		"связка по имени без префикса").ЭтоИстина();

	// JIT без префикса — ТОЖЕ предупреждаем: провижининг сперва ищет группу по имени и,
	// найдя локальную, добавляет в неё участника — экспозиция та же, что у связки
	Ожидаем.Что(Конфиг.ПрефиксГруппНуженНоНеЗадан(ПровайдерГрупп(Истина, Ложь, "")),
		"JIT без префикса даёт ту же экспозицию").ЭтоИстина();

	// префикс задан — пространство имён отделено, предупреждать не о чем
	Ожидаем.Что(Конфиг.ПрефиксГруппНуженНоНеЗадан(ПровайдерГрупп(Истина, Истина, "sso-")),
		"с префиксом молчим").ЭтоЛожь();

	// оба механизма выключены — имя клейма ничего не значит, предупреждать не о чем
	Ожидаем.Что(Конфиг.ПрефиксГруппНуженНоНеЗадан(ПровайдерГрупп(Ложь, Ложь, "")),
		"без механизмов молчим").ЭтоЛожь();

	Ожидаем.Что(Конфиг.ПрефиксГруппНуженНоНеЗадан(Неопределено),
		"отсутствующий провайдер не роняет проверку").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Конфигурация

&Тест
Процедура КонфигурацияЧитаетПровайдераИДефолты() Экспорт

	Конфиг = Новый КонфигурацияOIDC(ЛогТестов(), Неопределено, Неопределено, Новый ПровайдерыИзОкружения());
	Данные = Новый Структура();
	Данные.Вставить("Имя", "Keycloak");
	Данные.Вставить("Издатель", "https://kc.example/realms/main");
	Данные.Вставить("ИдентификаторКлиента", "openhub");
	Данные.Вставить("АдресВозврата", "https://hub/oidc/callback");
	Конфиг.ДобавитьПровайдер(Данные);

	Пр = Конфиг.Провайдер("keycloak"); // регистр не значим
	Ожидаем.Что(Пр).Существует();
	Ожидаем.Что(Пр.Область).Равно("openid profile email groups");
	Ожидаем.Что(Пр.ИмяКлеймаГрупп).Равно("groups");
	Ожидаем.Что(Пр.АвтоСоздание, "AUTOPROVISION выключен по умолчанию (долг Р-7)").ЭтоЛожь();
	Ожидаем.Что(Конфиг.ЕстьПровайдеры()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура AUTOPROVISIONИзОкруженияВыключенПоУмолчанию() Экспорт

	// Дефолт живёт в ДВУХ местах (ДобавитьПровайдер и ПрочитатьПровайдераИзОкружения), и
	// разъехаться они могут молча: программный путь проверен тестом выше, здесь — env,
	// то есть ровно то, чем пользуется инсталляция. Заодно это исполняемое доказательство,
	// что ключ читается ПолучитьПеременнуюСреды напрямую: пройди он через configor,
	// «_» превратилось бы в «.» и OSHUB_OIDC_<ID>_AUTOPROVISION до кода бы не доехал.
	Ид = "envprov";

	Попытка
		ЗадатьОкружениеПровайдера(Ид, ""); // переменной AUTOPROVISION нет
		Ожидаем.Что(Новый КонфигурацияOIDC(ЛогТестов(), Неопределено, Неопределено, Новый ПровайдерыИзОкружения()).Провайдер(Ид).АвтоСоздание,
			"без переменной вход непривязанной личности запрещён").ЭтоЛожь();

		ЗадатьОкружениеПровайдера(Ид, "true");
		Ожидаем.Что(Новый КонфигурацияOIDC(ЛогТестов(), Неопределено, Неопределено, Новый ПровайдерыИзОкружения()).Провайдер(Ид).АвтоСоздание,
			"явное true включает прежнее поведение").ЭтоИстина();

		ЗадатьОкружениеПровайдера(Ид, "false");
		Ожидаем.Что(Новый КонфигурацияOIDC(ЛогТестов(), Неопределено, Неопределено, Новый ПровайдерыИзОкружения()).Провайдер(Ид).АвтоСоздание,
			"явное false остаётся выключенным").ЭтоЛожь();
	Исключение
		ОчиститьОкружениеПровайдера(Ид);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьОкружениеПровайдера(Ид);

КонецПроцедуры

&Тест
Процедура ДефолтНеПротекаетМеждуПровайдерами() Экспорт

	Попытка
		УстановитьПеременнуюСреды("OSHUB_OIDC_PROVIDERS", "alpha,be-ta");
		ЗадатьПеременныеПровайдера("alpha", "true");   // включён явно
		ЗадатьПеременныеПровайдера("be-ta", "");       // переменной нет — дефолт

		Конфиг = Новый КонфигурацияOIDC(ЛогТестов(), Неопределено, Неопределено, Новый ПровайдерыИзОкружения());
		Ожидаем.Что(Конфиг.Провайдер("alpha").АвтоСоздание,
			"явное true у своего провайдера сохраняется").ЭтоИстина();
		Ожидаем.Что(Конфиг.Провайдер("be-ta").АвтоСоздание,
			"соседний провайдер не наследует включённый флаг").ЭтоЛожь();
	Исключение
		ОчиститьОкружениеПровайдера("alpha");
		ОчиститьОкружениеПровайдера("be-ta");
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьОкружениеПровайдера("alpha");
	ОчиститьОкружениеПровайдера("be-ta");

КонецПроцедуры

&Тест
Процедура ОтказПриВыключенномПровижинингеОбъясняетЧтоДелать() Экспорт

	// С выключенным по умолчанию AUTOPROVISION `provisioning_disabled` — самый частый
	// исход на свежей инсталляции с OIDC: в него упирается первый же вход нового человека.
	// Текст обязан называть оба выхода (привязать самому / попросить включить флаг), иначе
	// штатный отказ читается как поломка хаба. Проверяем функцию напрямую — вылавливание
	// строки из HTML живого хаба проверяло бы вёрстку, а не правило.
	Отказы = НовыеТекстыОтказов();

	Сообщение = Отказы.ОтказПровайдера("provisioning_disabled");
	Ожидаем.Что(СтрНайти(НРег(Сообщение), "не привязана") > 0, "названа причина отказа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "/me/settings/oidc") > 0,
		"назван путь самостоятельной привязки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "AUTOPROVISION") > 0,
		"названа переменная, которую включает администратор").ЭтоИстина();

	// объяснение не должно расползтись на прочие исходы — иначе оно перестанет что-то значить
	Ожидаем.Что(Отказы.ОтказПровайдера("exchange_failed") = Сообщение,
		"общий отказ не выдаёт себя за provisioning_disabled").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НачатьАвторизациюДаётURLState() Экспорт

	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	Старт = ПостроитьСервисВхода(Фейк).Начать(Пр.Имя);

	Ожидаем.Что(СтрНачинаетсяС(Старт.URL, Пр.Издатель + "/authorize")).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Старт.Транзакция.Получить("Состояние"))).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Старт.Транзакция.Получить("Одноразовость"))).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Старт.Транзакция.Получить("ПроверочныйКод"))).ЭтоИстина();
	Ожидаем.Что(Старт.Транзакция.Получить("Провайдер")).Равно(Пр.Имя);
	Ожидаем.Что(СтрНайти(Старт.URL, "code_challenge=")).Больше(0);

КонецПроцедуры

#КонецОбласти

#Область ХранительТранзакций

// ЗАЧЕМ ЭТИ ТЕСТЫ. Круг «сохранить → прочитать» проходит через JSON-сериализацию
// СессияХаба.ВСтрокуJSON — то есть ровно то место, где решается «привязка личности или
// обычный вход»: транзакция едет Соответствием библиотеки, а контекст привязки лежит
// рядом с ней записью хаба.

&Тест
Процедура ТранзакцияПереживаетКругСохраненияИЧтения() Экспорт

	Хранитель = Желудь("ХранительТранзакцийOIDC");

	// Контекст > 0 — это ПРИВЯЗКА ЛИЧНОСТИ к пользователю, а не обычный вход: самая
	// дорогая ветка callback (не тот контекст = чужая учётка получает чужую личность)
	Ключ = Хранитель.Сохранить(ДанныеТранзакции("prov-круг"), "", 777);

	Ожидаем.Что(ЗначениеЗаполнено(Ключ), "ключ транзакции выдан").ЭтоИстина();

	Прочитанная = Хранитель.Прочитать(Ключ);

	Ожидаем.Что(Прочитанная, "транзакция читается по ключу").Существует();
	Ожидаем.Что(Прочитанная.Получить("Провайдер")).Равно("prov-круг");
	Ожидаем.Что(Прочитанная.Получить("Состояние")).Равно("state-круг");
	Ожидаем.Что(Прочитанная.Получить("Одноразовость")).Равно("nonce-круг");
	Ожидаем.Что(Прочитанная.Получить("ПроверочныйКод")).Равно("verifier-круг");
	Ожидаем.Что(Хранитель.Контекст(Ключ), "контекст привязки дожил до чтения").Равно(777);

	// одноразовость: контроллер гасит транзакцию в любом исходе callback
	Хранитель.Удалить(Ключ);
	Ожидаем.Что(Хранитель.Прочитать(Ключ), "погашенная транзакция не читается").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТранзакцияОбычногоВходаЧитаетсяСНулевымКонтекстом() Экспорт

	// Обычный вход контекста не задаёт вовсе; контроллер сравнивает его с нулём, поэтому
	// хранитель обязан отдать 0, а не Неопределено и не пустую строку.
	Хранитель = Желудь("ХранительТранзакцийOIDC");

	Ключ = Хранитель.Сохранить(ДанныеТранзакции("prov-обычный"));

	Ожидаем.Что(Хранитель.Контекст(Ключ), "обычный вход = контекст 0").Равно(0);

КонецПроцедуры

&Тест
Процедура АдресВозвратаПереживаетКругСохраненияИЧтения() Экспорт

	// Адрес возврата едет РЯДОМ с транзакцией и проходит ту же JSON-сериализацию сессии:
	// потеряв его здесь, callback увёл бы человека в кабинет вместо страницы, с которой
	// он начал вход через провайдера.
	Хранитель = Желудь("ХранительТранзакцийOIDC");

	Ключ = Хранитель.Сохранить(ДанныеТранзакции("prov-возврат"),
		"/cli/login?user_code=ABCD-EFGH");

	Ожидаем.Что(Хранитель.ПутьВозврата(Ключ), "адрес возврата дожил до чтения")
		.Равно("/cli/login?user_code=ABCD-EFGH");

	// транзакция без адреса возврата — штатный случай (вход не с особой страницы)
	БезВозврата = Хранитель.Сохранить(ДанныеТранзакции("prov-без"));
	Ожидаем.Что(Хранитель.ПутьВозврата(БезВозврата), "не заданный адрес читается пустым").Равно("");

	Ожидаем.Что(Хранитель.ПутьВозврата("нет-такого-ключа"), "неизвестный ключ").Равно("");
	Ожидаем.Что(Хранитель.ПутьВозврата(""), "пустой ключ").Равно("");

	Хранитель.Удалить(Ключ);
	Ожидаем.Что(Хранитель.ПутьВозврата(Ключ), "погашенная транзакция адреса не отдаёт").Равно("");

КонецПроцедуры

&Тест
Процедура CallbackНеДоверяетАдресуВозвратаИзХранилища() Экспорт

	// Классическая дыра: адрес проверили на старте, а из хранилища вернули как есть.
	// Враждебный адрес кладём В ХРАНИЛИЩЕ НАПРЯМУЮ, мимо старта, — так его увидел бы
	// callback, если бы транзакцию завёл другой писатель (например привязка личности
	// из кабинета). Проверяем КОНТРОЛЛЕР, а не класс отбора: иначе сторож стоит не
	// на том слое и снятие отбора в callback остаётся незамеченным.
	Провайдер = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Провайдер);
	Состояние = "state-" + УникальныйСуффикс();
	Одноразовость = "nonce-" + УникальныйСуффикс();
	Субъект = "sub-возврат-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Провайдер, Субъект, Состояние, Одноразовость,
		Профиль(Субъект, "возвращенец", "", Ложь, Новый Массив()));

	// КОНТРОЛЬ: свой путь из хранилища доезжает до редиректа целиком, вместе с запросом
	Свой = ВызватьCallback(Фейк, Провайдер, Состояние, Одноразовость,
		"/cli/login?user_code=ABCD-EFGH");
	Ожидаем.Что(Свой.БылРедирект, "КОНТРОЛЬ: вход состоялся").ЭтоИстина();
	Ожидаем.Что(Свой.ПутьРедиректа, "КОНТРОЛЬ: свой путь из хранилища принимается")
		.Равно("/cli/login?user_code=ABCD-EFGH");

	Чужой = ВызватьCallback(Фейк, Провайдер, Состояние, Одноразовость,
		"https://evil.example/steal");
	Ожидаем.Что(Чужой.ПутьРедиректа,
		"адрес из хранилища проверяется заново — чужой заменяется путём по умолчанию")
		.Равно("/me");

КонецПроцедуры

&Тест
Процедура ПровайдеруПодтверждениеАдресаНеНужно() Экспорт

	// Вход через провайдера живёт по своим доказательствам: за человека ручается IdP,
	// и письмо хаба тут ни при чём. Гейт подтверждения адреса закрывает ПАРОЛЬНЫЙ вход
	// (ИСТ-ДОСТ-010) и в эту дверь не ставится — смотрим КОНТРОЛЛЕР, потому что сессию
	// открывает он, и появись гейт в нём, отсюда это было бы видно.
	Провайдер = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Провайдер);
	СП = Желудь("СервисПользователей");
	Состояние = "state-" + УникальныйСуффикс();
	Одноразовость = "nonce-" + УникальныйСуффикс();
	Субъект = "sub-неподтверждённый-" + УникальныйСуффикс();
	Логин = "unconfirmed" + УникальныйСуффикс();

	// IdP адрес отдал, но за него не поручился: у учётки он останется неподтверждённым
	НастроитьУспешныйТокен(Фейк, Провайдер, Субъект, Состояние, Одноразовость,
		Профиль(Субъект, Логин, Логин + "@ex.com", Ложь, Новый Массив()));

	Ответ = ВызватьCallback(Фейк, Провайдер, Состояние, Одноразовость, "/me");

	Ожидаем.Что(Ответ.БылРедирект, "вход состоялся").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Ответ.Куки.Значение(
			Желудь("ПерехватчикАутентификации").ИмяКукиСессии())),
		"и сессия открыта").ЭтоИстина();

	Учётка = СП.НайтиПоЛогину(Логин);
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина,
		"при этом адрес учётки так и не подтверждён — вход дала личность, а не письмо")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СтартНеКладётВХранилищеЧужойАдресВозврата() Экспорт

	// Симметричный сторож: до хранилища чужой адрес не доходит вовсе. Смотрим не редирект,
	// а то, ЧТО ЛЕЖИТ в транзакции, — иначе отбор на входе и отбор на выходе подменяют
	// друг друга, и снятие любого поодиночке остаётся зелёным.
	Провайдер = НастроитьПровайдера(Ложь);
	Фейк = НовыйФейк(Провайдер);
	Хранитель = Желудь("ХранительТранзакцийOIDC");

	// КОНТРОЛЬ
	Ожидаем.Что(Хранитель.ПутьВозврата(ЗапуститьСтартИВзятьКлюч(Фейк, Провайдер,
			"/cli/login?user_code=ABCD-EFGH")),
		"КОНТРОЛЬ: свой путь старт кладёт в транзакцию").Равно("/cli/login?user_code=ABCD-EFGH");

	Ожидаем.Что(Хранитель.ПутьВозврата(ЗапуститьСтартИВзятьКлюч(Фейк, Провайдер,
			"https://evil.example/steal")),
		"чужой адрес в транзакцию не попадает").Равно("/me");

КонецПроцедуры

&Тест
Процедура НеизвестныйИПустойКлючЧитаютсяКакОтсутствиеТранзакции() Экспорт

	// Возврат по устаревшей ссылке и возврат без cookie — штатные случаи, а не авария.
	Хранитель = Желудь("ХранительТранзакцийOIDC");

	Ожидаем.Что(Хранитель.Прочитать("нет-такого-ключа"), "неизвестный ключ").Равно(Неопределено);
	Ожидаем.Что(Хранитель.Прочитать(""), "пустой ключ").Равно(Неопределено);
	Хранитель.Удалить(""); // гасить нечего — не должно бросать

	Ожидаем.Что(Хранитель.ИмяКуки(), "имя cookie ключа транзакции").Равно("oshub_oidc_txn");

КонецПроцедуры

// Ключ серверной транзакции живёт в куке, и защищают его не значение, а атрибуты выдачи:
// скрипту она недоступна, действует на весь хаб и не уезжает по межсайтовому переходу.
&Тест
Процедура КукаТранзакцииВыдаётсяЗакрытойОтСкриптаИЧужогоСайта() Экспорт

	Куки = НовыеКукиОтвета();
	Желудь("КукаТранзакцииOIDC").Установить(ОтветСКуками(Куки), "ключ-транзакции");

	Имя = Желудь("КукаТранзакцииOIDC").Имя();
	Кука = Куки.Кука(Имя);

	Ожидаем.Что(Кука <> Неопределено, "кука транзакции выдана под именем " + Имя).ЭтоИстина();
	Ожидаем.Что(Кука.Значение, "и несёт ключ транзакции").Равно("ключ-транзакции");
	Ожидаем.Что(Кука.ТолькоХттп, "скрипту страницы она недоступна").ЭтоИстина();
	Ожидаем.Что(Кука.Путь, "действует на весь хаб, а не на одну дорогу").Равно("/");
	Ожидаем.Что(Кука.ТотжеСайт,
		"по межсайтовому переходу не уезжает, но возврат от провайдера переживает").Равно("Lax");

КонецПроцедуры

// Гашение обязано повторить те же атрибуты: браузер сопоставляет куку по имени, пути
// и домену, и кука, погашенная другим путём, останется у него жить.
&Тест
Процедура КукаТранзакцииГаситсяТемиЖеАтрибутамиИСрокомВПрошлом() Экспорт

	Куки = НовыеКукиОтвета();
	Желудь("КукаТранзакцииOIDC").Сбросить(ОтветСКуками(Куки));

	Кука = Куки.Кука(Желудь("КукаТранзакцииOIDC").Имя());

	Ожидаем.Что(Кука <> Неопределено, "гашение выдаёт куку с тем же именем").ЭтоИстина();
	Ожидаем.Что(Кука.Значение, "с пустым значением").Равно("");
	Ожидаем.Что(Кука.ТолькоХттп, "с тем же ТолькоХттп").ЭтоИстина();
	Ожидаем.Что(Кука.Путь, "с тем же путём").Равно("/");
	Ожидаем.Что(Кука.ТотжеСайт, "с тем же ТотжеСайт").Равно("Lax");
	// «пусто» у заглушки — тоже дата в прошлом, поэтому мало сказать «раньше сейчас»:
	// срок обязан быть ВЫСТАВЛЕН, иначе браузер оставит куку жить
	Ожидаем.Что(Кука.ДатаИстечения > '00010101', "срок гашения выставлен").ЭтоИстина();
	Ожидаем.Что(Кука.ДатаИстечения < ТекущаяУниверсальнаяДата(),
		"и он в прошлом").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗащитныеВеткиСборки

// Три защитных ветки, введённые шагом 6.E вместо молчаливых заглушек: несобранный шов
// обязан говорить об этом сразу, а не падать NPE посреди discovery.

&Тест
Процедура ХранительТранзакцийОтвергаетПустуюТранзакцию() Экспорт

	Сообщение = "";
	Попытка
		Желудь("ХранительТранзакцийOIDC").Сохранить(Неопределено);
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Сообщение, "нечего сохранять") > 0,
		"сохранение пустой транзакции названо по имени: " + Сообщение).ЭтоИстина();

КонецПроцедуры

// Лог у сервиса объявлен со значением по умолчанию, то есть прямая сборка разрешена, —
// и объяснение о непригодном адресе не вправе уронить тот самый вход, ради которого
// написана терпимая ветка.
&Тест
Процедура НепригодныйАдресБезИнъекцииЛогаВходНеРонит() Экспорт

	СП = Желудь("СервисПользователей");
	БезЛога = Новый СервисАвтопривязки(Желудь("СервисЛичностей"), СП, Адреса(),
		Желудь("НормализаторУчётки"));

	Суффикс = УникальныйСуффикс();
	Профиль_ = Новый Структура("Email, EmailПодтверждён, ПредпочтительныйЛогин",
		"совсем-не-адрес", Истина, "nolog" + Суффикс);

	Исход = БезЛога.РазрешитьВход("https://idp-nolog-" + Суффикс + ".test", "sub-" + Суффикс,
		Профиль_, Истина);

	Ожидаем.Что(Исход.Успех, "вход прошёл без желудя лога: " + Исход.Причина).ЭтоИстина();
	Ожидаем.Что(Строка(СП.НайтиПоЛогину(Исход.Пользователь.Логин).Email),
		"непригодный адрес не записан").Равно("");

КонецПроцедуры

// Возврат метода — контракт «запись изменилась», и он проверяется значением: иначе
// вызывающему нечем отличить актуализацию от промаха по неизвестной личности.
&Тест
Процедура АктуализацияПрофиляЛичностиСообщаетОбИзменении() Экспорт

	СП = Желудь("СервисПользователей");
	СЛ = Желудь("СервисЛичностей");
	Суффикс = УникальныйСуффикс();
	Издатель = "https://idp-акт-" + Суффикс + ".test";
	Субъект = "sub-" + Суффикс;
	Хозяин = СП.СоздатьПользователя("noel" + Суффикс, "", "password123", "user");
	СЛ.Привязать(Хозяин.Идентификатор, Издатель, Субъект, "старый_" + Суффикс + "@ex.com", "noel-старый");

	Новый_ = "новый_" + Суффикс + "@ex.com";
	Ожидаем.Что(СЛ.АктуализироватьПрофиль(Издатель, Субъект, Новый_),
		"адрес сменился — запись изменена").ЭтоИстина();
	Ожидаем.Что(СЛ.АктуализироватьПрофиль(Издатель, Субъект, Новый_),
		"тот же адрес второй раз — записи не было").ЭтоЛожь();
	Ожидаем.Что(СЛ.АктуализироватьПрофиль(Издатель, Субъект, ""),
		"пустой адрес ничего не затирает").ЭтоЛожь();
	Ожидаем.Что(СЛ.АктуализироватьПрофиль(Издатель, "sub-неизвестный-" + Суффикс, Новый_),
		"неизвестная личность — промах, а не создание").ЭтоЛожь();

	Ожидаем.Что(СЛ.АктуализироватьПрофиль(Издатель, Субъект, Новый_, "noel-новый"),
		"сменился только логин — запись всё равно изменена").ЭтоИстина();
	Ожидаем.Что(СЛ.АктуализироватьПрофиль(Издатель, Субъект, Новый_, "noel-новый"),
		"тот же логин второй раз — записи не было").ЭтоЛожь();
	Ожидаем.Что(СЛ.АктуализироватьПрофиль(Издатель, Субъект, Новый_, ""),
		"пустой логин ничего не затирает").ЭтоЛожь();

	Личность = СЛ.ЛичностиПользователя(Хозяин.Идентификатор)[0];
	Ожидаем.Что(Строка(Личность.Email), "в записи остался актуальный адрес").Равно(Новый_);
	Ожидаем.Что(Строка(Личность.ПредпочтительныйЛогин),
		"в записи остался актуальный логин у провайдера").Равно("noel-новый");

КонецПроцедуры

#КонецОбласти

#Область АвтовыдачаПравПоGitHub

// Сквозной сценарий миграции с hub.oscript.io: человек с push в oscript-library/<пакет>
// входит через GitHub и сразу получает мейнтейнера на одноимённом пакете основного пула.
&Тест
Процедура ВходЧерезGitHubРаздаётПраваПоРепозиториям() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	ИмяПакета = "ghlogin" + УникальныйСуффикс();
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, ИмяПакета);
	ВключитьЛегасиGitHub();
	ОтдатьРепозитории(ИмяПакета);

	Пр = НастроитьПровайдераGitHub();
	Фейк = НовыйФейк(Пр);
	Субъект = "gh-sub-" + УникальныйСуффикс();
	НастроитьВходGitHub(Фейк, Субъект, "octocat" + УникальныйСуффикс());

	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, Исход.Причина).ЭтоИстина();
	Ожидаем.Что(РольНаПакете(Исход.Пользователь, Пакет),
		"push в репозиторий зеркала даёт мейнтейнера на пакете основного пула").Равно("мейнтейнер");

КонецПроцедуры

// Ручная привязка GitHub-личности из кабинета — тот же результат для уже заведённой учётки.
&Тест
Процедура РучнаяПривязкаGitHubРаздаётПраваПоРепозиториям() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	ИмяПакета = "ghbind" + УникальныйСуффикс();
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, ИмяПакета);
	ВключитьЛегасиGitHub();
	ОтдатьРепозитории(ИмяПакета);

	СП = Желудь("СервисПользователей");
	Хозяин = СП.СоздатьПользователя("ghown" + УникальныйСуффикс(), "", "password123", "user");
	Ожидаем.Что(РольНаПакете(Хозяин, Пакет), "КОНТРОЛЬ: до привязки прав нет").Равно("");

	Пр = НастроитьПровайдераGitHub();
	Фейк = НовыйФейк(Пр);
	Субъект = "gh-bind-" + УникальныйСуффикс();
	НастроитьВходGitHub(Фейк, Субъект, "octobind" + УникальныйСуффикс());

	Привязка = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", Хозяин.Идентификатор);

	Ожидаем.Что(Привязка.Успех, Привязка.Причина).ЭтоИстина();
	Ожидаем.Что(РольНаПакете(СП.НайтиПоЛогину(Хозяин.Логин), Пакет),
		"ручная привязка GitHub раздаёт права так же, как вход").Равно("мейнтейнер");

КонецПроцедуры

// Обратная сторона того же правила на ветке кабинета: привязка УЖЕ привязанной личности
// новой не считается и раздачу не повторяет. Отвязка с последующей привязкой заводит
// личность заново — и раздача пройдёт снова; адресного отзыва у механизма нет вовсе
// адресного отзыва у механизма нет, и этот тест на него не претендует.
&Тест
Процедура ПовторнаяПривязкаБезОтвязкиРаздачуНеПовторяет() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	ИмяПакета = "ghrebind" + УникальныйСуффикс();
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, ИмяПакета);
	ВключитьЛегасиGitHub();
	ОтдатьРепозитории(ИмяПакета);

	СП = Желудь("СервисПользователей");
	Хозяин = СП.СоздатьПользователя("ghrb" + УникальныйСуффикс(), "", "password123", "user");
	Пр = НастроитьПровайдераGitHub();
	Фейк = НовыйФейк(Пр);
	Субъект = "gh-rb-" + УникальныйСуффикс();
	НастроитьВходGitHub(Фейк, Субъект, "octorb" + УникальныйСуффикс());
	ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", Хозяин.Идентификатор);
	Ожидаем.Что(РольНаПакете(СП.НайтиПоЛогину(Хозяин.Логин), Пакет),
		"КОНТРОЛЬ: первая привязка роль выдала").Равно("мейнтейнер");

	Права = Желудь("СервисПрав");
	Желудь("СервисПравДоступа").ЗафиксироватьГрант("пользователь", Хозяин.Идентификатор,
		Права.ОбъектПакет(Пакет), Новый Структура(), 0, "тест");
	Ожидаем.Что(РольНаПакете(СП.НайтиПоЛогину(Хозяин.Логин), Пакет),
		"КОНТРОЛЬ: грант убран — повторная выдача теперь была бы видна").Равно("");

	ДоВызовов = Желудь("ТранспортHTTP").КоличествоВызовов();
	НастроитьВходGitHub(Фейк, Субъект, "octorb" + УникальныйСуффикс());
	Повтор = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", Хозяин.Идентификатор);

	Ожидаем.Что(Повтор.Успех, Повтор.Причина).ЭтоИстина();
	Ожидаем.Что(РольНаПакете(СП.НайтиПоЛогину(Хозяин.Логин), Пакет),
		"привязка уже привязанной личности раздачу не повторяет — гранта заново нет").Равно("");
	Ожидаем.Что(Желудь("ТранспортHTTP").КоличествоВызовов() - ДоВызовов,
		"и в GitHub повторно не ходит").Равно(0);

КонецПроцедуры

// Токен чужого провайдера в api.github.com не уезжает. Проверяется на ВРУЧНУЮ заведённом
// OAuth2-провайдере: у него издатель тоже синтетический («oauth2:<хост>»), и проверка
// «издатель из пространства OAuth2» пропустила бы его access-token в GitHub заголовком
// Authorization. Обычный OIDC-провайдер с https-издателем отсекается любой проверкой
// и потому границу не стережёт — он здесь вторым случаем, для полноты.
&Тест
Процедура ВходНеЧерезGitHubВGitHubНеХодит() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	ИмяПакета = "ghalien" + УникальныйСуффикс();
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, ИмяПакета);
	ВключитьЛегасиGitHub();
	ОтдатьРепозитории(ИмяПакета);

	// 1. свой OAuth2-провайдер: издатель синтетический, но НЕ github
	ДоВызовов = Желудь("ТранспортHTTP").КоличествоВызовов();
	Чужой = НастроитьСвойПровайдераOAuth2();
	Ожидаем.Что(Новый ИздателиOAuth2().ЭтоСинтетический(Чужой.Издатель),
		"КОНТРОЛЬ: у ручного OAuth2-провайдера издатель синтетический — как у GitHub").ЭтоИстина();
	ФейкЧужого = НовыйФейк(Чужой);
	СубъектЧужого = "alien-sub-" + УникальныйСуффикс();
	НастроитьВходGitHub(ФейкЧужого, СубъектЧужого, "alien" + УникальныйСуффикс());

	ИсходЧужого = ЗавершитьВход(ФейкЧужого, Чужой, "s", "s", "n", "v", 0);

	Ожидаем.Что(ИсходЧужого.Успех, ИсходЧужого.Причина).ЭтоИстина();
	Ожидаем.Что(Желудь("ТранспортHTTP").КоличествоВызовов() - ДоВызовов,
		"токен ЧУЖОГО OAuth2-провайдера в api.github.com не уезжает").Равно(0);
	Ожидаем.Что(РольНаПакете(ИсходЧужого.Пользователь, Пакет), "и прав не раздаёт").Равно("");

	// 2. обычный OIDC-провайдер с настоящим issuer
	Пр = НастроитьПровайдера(Истина);
	Фейк = НовыйФейк(Пр);
	Субъект = "sub-" + УникальныйСуффикс();
	НастроитьУспешныйТокен(Фейк, Пр, Субъект, "s", "n",
		Профиль(Субъект, "oidc" + УникальныйСуффикс(), "", Ложь, Новый Массив()));

	Исход = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);

	Ожидаем.Что(Исход.Успех, Исход.Причина).ЭтоИстина();
	Ожидаем.Что(Желудь("ТранспортHTTP").КоличествоВызовов() - ДоВызовов,
		"вход через OIDC-провайдера в GitHub тоже не ходит").Равно(0);
	Ожидаем.Что(РольНаПакете(Исход.Пользователь, Пакет), "и прав не раздаёт").Равно("");

КонецПроцедуры

// Права раздаются на КАЖДОМ входе (решение владельца 2026-08-06): у человека в организации
// могло прибавиться репозиториев, и хаб их добирает, не дожидаясь заведения личности.
// Обратная сторона того же решения: снятый администратором грант возвращается следующим
// входом — адресного отзыва у механизма нет и не было, а пока опция включена,
// право в GitHub и так даёт публикацию легаси-путём вовсе без учётки.
&Тест
Процедура ПовторныйВходДобираетПраваЗаново() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	ИмяПакета = "ghrevoke" + УникальныйСуффикс();
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, ИмяПакета);
	ВключитьЛегасиGitHub();
	ОтдатьРепозитории(ИмяПакета);

	Пр = НастроитьПровайдераGitHub();
	Фейк = НовыйФейк(Пр);
	Субъект = "gh-rev-" + УникальныйСуффикс();
	Логин = "octorev" + УникальныйСуффикс();
	НастроитьВходGitHub(Фейк, Субъект, Логин);
	Первый = ЗавершитьВход(Фейк, Пр, "s", "s", "n", "v", 0);
	Ожидаем.Что(РольНаПакете(Первый.Пользователь, Пакет),
		"КОНТРОЛЬ: первый вход роль выдал").Равно("мейнтейнер");

	// администратор снял грант
	Доступ = Желудь("СервисПравДоступа");
	Права = Желудь("СервисПрав");
	Доступ.ЗафиксироватьГрант("пользователь", Первый.Пользователь.Идентификатор,
		Права.ОбъектПакет(Пакет), Новый Структура(), 0, "тест");
	Ожидаем.Что(РольНаПакете(Первый.Пользователь, Пакет), "КОНТРОЛЬ: право снято").Равно("");

	ДоВызовов = Желудь("ТранспортHTTP").КоличествоВызовов();
	НастроитьВходGitHub(Фейк, Субъект, Логин);
	Второй = ЗавершитьВход(Фейк, Пр, "s2", "s2", "n2", "v2", 0);

	Ожидаем.Что(Второй.Успех, Второй.Причина).ЭтоИстина();
	Ожидаем.Что(Второй.Новая, "учётка та же").ЭтоЛожь();
	Ожидаем.Что(Желудь("ТранспортHTTP").КоличествоВызовов() - ДоВызовов > 0,
		"повторный вход снова спрашивает GitHub — иначе прибавившиеся права не доедут").ЭтоИстина();
	Ожидаем.Что(РольНаПакете(Первый.Пользователь, Пакет),
		"и права по репозиториям набираются заново").Равно("мейнтейнер");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поля транзакции авторизации для круга «сохранить → прочитать».
Функция ДанныеТранзакции(Знач ИмяПровайдера)
	Возврат Транзакция(ИмяПровайдера, "state-круг", "nonce-круг", "verifier-круг");
КонецФункции

Функция Адреса()
	Возврат Желудь("АдресУчётки");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция УникальныйСуффикс()
	Счётчик = Счётчик + 1;
	Возврат Формат(Счётчик, "ЧГ=0") + "x";
КонецФункции

// Регистрирует провайдера с уникальным issuer в общем бине КонфигурацияOIDC.
Функция НастроитьПровайдера(Знач АвтоСоздание)
	Суффикс = УникальныйСуффикс();
	Данные = Новый Структура();
	Данные.Вставить("Имя", "prov" + Суффикс);
	Данные.Вставить("Издатель", "https://idp-" + Суффикс + ".test");
	Данные.Вставить("ИдентификаторКлиента", "openhub");
	Данные.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Данные.Вставить("АвтоСоздание", АвтоСоздание);
	Возврат Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Данные);
КонецФункции

// Провайдер-пресет GitHub: издатель синтетический («oauth2:github»), discovery у OAuth2
// нет — конечные точки задаются руками и ведут на фейковую сессию.
Функция НастроитьПровайдераGitHub()

	Точки = Новый Соответствие();
	Точки.Вставить("authorization_endpoint", АдресGitHub() + "/authorize");
	Точки.Вставить("token_endpoint", АдресGitHub() + "/token");
	Точки.Вставить("userinfo_endpoint", АдресGitHub() + "/userinfo");

	Данные = Новый Структура();
	Данные.Вставить("Имя", "gh" + УникальныйСуффикс());
	Данные.Вставить("Тип", "oauth2");
	Данные.Вставить("Издатель", Новый ИздателиOAuth2().ИздательGitHub());
	Данные.Вставить("ИдентификаторКлиента", "openhub");
	Данные.Вставить("СекретКлиента", "secret");
	Данные.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Данные.Вставить("КонечныеТочки", Точки);
	Данные.Вставить("АвтоСоздание", Истина);
	Возврат Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Данные);

КонецФункции

Функция АдресGitHub()
	Возврат "https://gh.test";
КонецФункции

// Провайдер, заведённый администратором ВРУЧНУЮ: издателя такому назначает хаб по хосту
// точки авторизации, то есть он тоже из пространства «oauth2:».
Функция НастроитьСвойПровайдераOAuth2()

	Точки = Новый Соответствие();
	Точки.Вставить("authorization_endpoint", АдресGitHub() + "/authorize");
	Точки.Вставить("token_endpoint", АдресGitHub() + "/token");
	Точки.Вставить("userinfo_endpoint", АдресGitHub() + "/userinfo");

	Издатели = Новый ИздателиOAuth2();
	Данные = Новый Структура();
	Данные.Вставить("Имя", "alien" + УникальныйСуффикс());
	Данные.Вставить("Тип", "oauth2");
	Данные.Вставить("Издатель", Издатели.ИздательПоАдресуАвторизации(
		"https://idp.alien.test/oauth/authorize", СтрРазделить("github,gitlab,google", ",")));
	Данные.Вставить("ИдентификаторКлиента", "openhub");
	Данные.Вставить("СекретКлиента", "secret");
	Данные.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Данные.Вставить("КонечныеТочки", Точки);
	Данные.Вставить("АвтоСоздание", Истина);
	Возврат Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Данные);

КонецФункции

// Ответ token endpoint без id_token (OAuth2) плюс профиль GitHub.
Процедура НастроитьВходGitHub(Фейк, Знач Субъект, Знач Логин)

	Фейк.УстановитьИздателя(АдресGitHub());
	Токены = Новый Соответствие();
	Токены.Вставить("access_token", "gho_" + Субъект);
	Токены.Вставить("token_type", "bearer");
	Фейк.УстановитьОтветТокена(ВJSON(Токены));
	Фейк.УстановитьОтветПрофиля(ВJSON(Профиль(Субъект, Логин, "", Ложь, Новый Массив())));

КонецПроцедуры

// Ответ GitHub на запрос репозиториев: один репозиторий организации с правом записи.
Процедура ОтдатьРепозитории(Знач ИмяРепозитория)

	Права = Новый Соответствие();
	Права.Вставить("push", Истина);
	Владелец = Новый Соответствие();
	// организация умолчания: детальку oshub.publish.github.org этот контейнер не задаёт
	Владелец.Вставить("login", "oscript-library");
	Элемент = Новый Соответствие();
	Элемент.Вставить("name", ИмяРепозитория);
	Элемент.Вставить("owner", Владелец);
	Элемент.Вставить("permissions", Права);

	Список = Новый Массив();
	Список.Добавить(Элемент);
	Желудь("ТранспортHTTP").УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки(ВJSON(Список)));

КонецПроцедуры

// Опция пишется прямо в хранилище: доменный API настроек публикует событие аудита,
// а издателя в этом контейнере нет.
Процедура ВключитьЛегасиGitHub()
	Желудь("ХранилищеПрикладныхНастроек").Установить("oshub.publish.github_legacy",
		"Истина", "тест", ТекущаяУниверсальнаяДата());
КонецПроцедуры

Функция ОбеспечитьОсновнойПул()
	Пулы = Желудь("СервисПулов");
	Существующий = Пулы.ДефолтныйПул();
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Новый_ = Пулы.СоздатьПул("ghdefault" + УникальныйСуффикс(), "custom", "public");
	Возврат Пулы.НазначитьПулПоУмолчанию(Новый_.Идентификатор, "тест");
КонецФункции

Функция РольНаПакете(Знач Пользователь, Знач Пакет)
	Права = Желудь("СервисПрав");
	Возврат Права.РольНаОбъекте(Пользователь, Права.ОбъектПакет(Пакет));
КонецФункции

// Провайдер БЕЗ ключа АвтоСоздание вовсе: так его видит инсталляция, не задавшая
// AUTOPROVISION, — работают умолчания КонфигурацияOIDC.
Функция ПровайдерСДефолтами()
	Суффикс = УникальныйСуффикс();
	Данные = Новый Структура();
	Данные.Вставить("Имя", "def" + Суффикс);
	Данные.Вставить("Издатель", "https://idp-def-" + Суффикс + ".test");
	Данные.Вставить("ИдентификаторКлиента", "openhub");
	Данные.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Возврат Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Данные);
КонецФункции

// Переменные окружения одного OIDC-провайдера; пустое ЗначениеФлага = переменной нет.
Процедура ЗадатьОкружениеПровайдера(Знач Ид, Знач ЗначениеФлага)
	УстановитьПеременнуюСреды("OSHUB_OIDC_PROVIDERS", Ид);
	ЗадатьПеременныеПровайдера(Ид, ЗначениеФлага);
КонецПроцедуры

// То же, но без списка провайдеров — для сценариев с несколькими IdP сразу.
Процедура ЗадатьПеременныеПровайдера(Знач Ид, Знач ЗначениеФлага)
	Префикс = ПрефиксПровайдера(Ид);
	УстановитьПеременнуюСреды(Префикс + "ISSUER", "https://idp-env.test/realms/main");
	УстановитьПеременнуюСреды(Префикс + "CLIENT_ID", "openhub");
	УстановитьПеременнуюСреды(Префикс + "REDIRECT_URI", "https://hub.test/oidc/callback");
	УстановитьПеременнуюСреды(Префикс + "AUTOPROVISION", ЗначениеФлага);
КонецПроцедуры

// Симметричная уборка. Гасить один AUTOPROVISION мало: ISSUER/CLIENT_ID/REDIRECT_URI
// остаются в окружении ПРОЦЕССА до конца набора, и следующий env-тест унаследует чужого
// провайдера. Сегодня безвредно (набор изолирован по процессу, а PROVIDERS очищается),
// но это ровно та мина, на которую наступает следующий автор.
Процедура ОчиститьОкружениеПровайдера(Знач Ид)
	Префикс = ПрефиксПровайдера(Ид);
	УстановитьПеременнуюСреды("OSHUB_OIDC_PROVIDERS", "");
	УстановитьПеременнуюСреды(Префикс + "ISSUER", "");
	УстановитьПеременнуюСреды(Префикс + "CLIENT_ID", "");
	УстановитьПеременнуюСреды(Префикс + "REDIRECT_URI", "");
	УстановитьПеременнуюСреды(Префикс + "AUTOPROVISION", "");
КонецПроцедуры

// Идентификатор провайдера в имени переменной: верхний регистр, дефис → подчёркивание
// (та же нормализация, что в КонфигурацияOIDC).
Функция ПрефиксПровайдера(Знач Ид)
	Возврат "OSHUB_OIDC_" + ВРег(СтрЗаменить(Ид, "-", "_")) + "_";
КонецФункции

// Объяснение отказа провайдера спрашивает код «адрес занят» у таблицы отказов, поэтому
// она приезжает настоящим желудём; СервисАутентификации и гейт адреса нужны только ветке
// пароля, а проверяется ветка провайдера.
// Тип подключается ЛЕНИВО: контейнер уже собран &ПередВсеми, а winow в юните нет.
Функция НовыеТекстыОтказов()
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "вход"),
		"ТекстыОтказовВхода.os"));
	Возврат Новый ТекстыОтказовВхода(Неопределено, Неопределено, Желудь("ОтказыУчётки"));
КонецФункции

// Контроллер входа, собранный ДЛЯ ВЕТКИ ПРОВАЙДЕРА: реальные хранитель транзакций,
// служба сессий и кука сессии, поток входа — на фейковом транспорте. Каркас экрана,
// кит, разбор формы и активы этой ветке не нужны (они работают на странице входа
// и на POST /login).
Функция НовыйКонтроллерПровайдера(Знач Фейк)

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "вход"),
		"КонтроллерВходаOIDC.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей, "вход", "Классы", "ВозвратПослеВхода.os"));

	Возврат Новый КонтроллерВходаOIDC(
		Неопределено, Неопределено, Неопределено,
		Желудь("КонфигурацияOIDC"), ПостроитьСервисВхода(Фейк),
		Желудь("СлужбаСессий"), Желудь("ХранительТранзакцийOIDC"), Неопределено,
		Желудь("ПолитикаПарольногоВхода"), Желудь("КукиСессии"),
		Желудь("КукаТранзакцииOIDC"),
		Неопределено, Неопределено, Неопределено, Неопределено, Новый МетодыHTTP(),
		Новый ВозвратПослеВхода());

КонецФункции

// Кладёт транзакцию с заданным адресом возврата прямо в хранилище и зовёт callback.
// Возвращает заглушку ответа: интересен её ПутьРедиректа.
Функция ВызватьCallback(Знач Фейк, Знач Провайдер, Знач Состояние, Знач Одноразовость,
	Знач АдресВозврата)

	Хранитель = Желудь("ХранительТранзакцийOIDC");

	Ключ = Хранитель.Сохранить(
		Транзакция(Провайдер.Имя, Состояние, Одноразовость, "verifier-callback"), АдресВозврата);

	КукиЗапроса = НовыеКукиЗапроса();
	КукиЗапроса.Добавить(Хранитель.ИмяКуки(), Ключ);

	Ответ = НовыйОтвет();
	НовыйКонтроллерПровайдера(Фейк).Обратно(Ответ, КукиЗапроса, "GET", "auth-code", Состояние);
	Возврат Ответ;

КонецФункции

// Зовёт старт входа через провайдера и отдаёт ключ транзакции, уехавший в куку.
Функция ЗапуститьСтартИВзятьКлюч(Знач Фейк, Знач Провайдер, Знач АдресВозврата)

	Ответ = НовыйОтвет();
	НовыйКонтроллерПровайдера(Фейк).СтартOIDC(Ответ, Провайдер.Имя, НовыеКукиЗапроса(), "GET",
		АдресВозврата);

	Возврат Ответ.Куки.Значение(Желудь("ХранительТранзакцийOIDC").ИмяКуки());

КонецФункции

Функция НовыйОтвет()
	КаталогФикстур = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "фикстуры");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "КукиОтветаЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ОтветВходаЗаглушка.os"));
	Возврат Новый ОтветВходаЗаглушка(Новый КукиОтветаЗаглушка());
КонецФункции

// Коллекция кук отдельно от ответа: в неё тест смотрит атрибуты выдачи, а не только значение.
Функция НовыеКукиОтвета()
	КаталогФикстур = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "фикстуры");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "КукиОтветаЗаглушка.os"));
	Возврат Новый КукиОтветаЗаглушка();
КонецФункции

Функция ОтветСКуками(Знач Куки)
	КаталогФикстур = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "фикстуры");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ОтветВходаЗаглушка.os"));
	Возврат Новый ОтветВходаЗаглушка(Куки);
КонецФункции

Функция НовыеКукиЗапроса()
	КаталогФикстур = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "фикстуры");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "КукиЗаглушка.os"));
	Возврат Новый КукиЗаглушка();
КонецФункции

// Сессия в контейнере одна: набор настраивает её ответы на каждый сценарий.
Функция НовыйФейк(Знач Провайдер)
	Фейк = Желудь("СессияИсходящегоHTTP");
	Фейк.УстановитьИздателя(Провайдер.Издатель);
	Возврат Фейк;
КонецФункции

Функция ПостроитьСервисВхода(Знач Фейк)
	Фейк = Фейк; // сессия уже в контейнере: сервис берётся оттуда же, что и в бою
	Возврат Желудь("СервисВходаOIDC");
КонецФункции

// Транзакция — то же Соответствие, что кладёт библиотека на старте входа.
Функция Транзакция(Знач ИмяПровайдера, Знач Состояние, Знач Одноразовость, Знач Verifier)
	Данные = Новый Соответствие();
	Данные.Вставить("Провайдер", ИмяПровайдера);
	Данные.Вставить("Состояние", Состояние);
	Данные.Вставить("Одноразовость", Одноразовость);
	Данные.Вставить("ПроверочныйКод", Verifier);
	Возврат Данные;
КонецФункции

Функция ЗавершитьВход(Знач Фейк, Знач Провайдер, Знач ОжидСостояние, Знач ПолучСостояние,
	Знач ОжидNonce, Знач Verifier, Знач Привязка)
	Возврат ПостроитьСервисВхода(Фейк).Завершить(
		Транзакция(Провайдер.Имя, ОжидСостояние, ОжидNonce, Verifier),
		"auth-code", ПолучСостояние, Привязка);
КонецФункции

// Настраивает фейк на успешный обмен: id_token с корректными iss/aud/exp/nonce/sub + userinfo.
Процедура НастроитьУспешныйТокен(Фейк, Знач Провайдер, Знач Субъект, Знач Состояние, Знач Nonce, Знач ПрофильДанные)
	Клеймы = БазовыеКлеймы(Провайдер, Субъект, Nonce);
	Фейк.УстановитьОтветТокена(ОтветТокена(JWT(Клеймы)));
	Фейк.УстановитьОтветПрофиля(ВJSON(ПрофильДанные));
КонецПроцедуры

// Клеймы валидного id_token: iss = issuer провайдера, aud = client_id, exp в будущем.
Функция БазовыеКлеймы(Знач Провайдер, Знач Субъект, Знач Nonce)
	Клеймы = Новый Соответствие();
	Клеймы.Вставить("iss", Провайдер.Издатель);
	Клеймы.Вставить("aud", Провайдер.ИдентификаторКлиента);
	Клеймы.Вставить("sub", Субъект);
	Клеймы.Вставить("nonce", Nonce);
	Клеймы.Вставить("exp", ТекущийUnix() + 3600);
	Клеймы.Вставить("iat", ТекущийUnix());
	Возврат Клеймы;
КонецФункции

// userinfo-профиль как Соответствие. Пустой логин означает провайдера, который клейм
// preferred_username не отдаёт вовсе, — такого клейма в профиле не будет.
Функция Профиль(Знач Субъект, Знач Логин, Знач Email, Знач EmailVerified, Знач Группы)
	П = Новый Соответствие();
	П.Вставить("sub", Субъект);
	Если ЗначениеЗаполнено(Логин) Тогда
		П.Вставить("preferred_username", Логин);
	КонецЕсли;
	Если ЗначениеЗаполнено(Email) Тогда
		П.Вставить("email", Email);
		П.Вставить("email_verified", EmailVerified);
	КонецЕсли;
	Если Группы.Количество() > 0 Тогда
		П.Вставить("groups", Группы);
	КонецЕсли;
	Возврат П;
КонецФункции

Функция ОтветТокена(Знач IdToken)
	Данные = Новый Соответствие();
	Данные.Вставить("access_token", "access-token-value");
	Данные.Вставить("token_type", "Bearer");
	Данные.Вставить("expires_in", 3600);
	Данные.Вставить("id_token", IdToken);
	Возврат ВJSON(Данные);
КонецФункции

// Собирает компактный JWT (подпись фиктивная — библиотека её не проверяет по модели доверия).
Функция JWT(Знач Клеймы)
	Кодировка = Новый КодировкаТестов();
	Заголовок = Кодировка.Закодировать("{""alg"":""none"",""typ"":""JWT""}");
	Нагрузка = Кодировка.Закодировать(ВJSON(Клеймы));
	Возврат Заголовок + "." + Нагрузка + ".sig";
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ТекущийUnix()
	Возврат ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1, 0, 0, 0);
КонецФункции

// Провайдер с настроенными механизмами OIDC-групп (шаг 5.F).
Функция ПровайдерГрупп(Знач Провижининг, Знач СвязкаПоИмени, Знач Префикс)
	Суффикс = УникальныйСуффикс();
	Данные = Новый Структура();
	Данные.Вставить("Имя", "grp" + Суффикс);
	Данные.Вставить("Издатель", "https://idp-grp-" + Суффикс + ".test");
	Данные.Вставить("ИдентификаторКлиента", "openhub");
	Данные.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Данные.Вставить("ПровижинингГрупп", Провижининг);
	Данные.Вставить("СвязкаГруппПоИмени", СвязкаПоИмени);
	Данные.Вставить("ПрефиксГрупп", Префикс);
	Возврат Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Данные);
КонецФункции

// Провайдер, который и заводит учётку, и провижинит группы из клейма — то есть весь
// состав групп пользователя определяется клеймами ЭТОГО входа (сценарий деградации 7.D).
Функция ПровайдерВходаСГруппами()
	Суффикс = УникальныйСуффикс();
	Данные = Новый Структура();
	Данные.Вставить("Имя", "deg" + Суффикс);
	Данные.Вставить("Издатель", "https://idp-deg-" + Суффикс + ".test");
	Данные.Вставить("ИдентификаторКлиента", "openhub");
	Данные.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Данные.Вставить("АвтоСоздание", Истина);
	Данные.Вставить("ПровижинингГрупп", Истина);
	Возврат Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Данные);
КонецФункции

Функция КлеймыСГруппами(Знач ИмяГруппы)
	Клеймы = Новый Соответствие();
	Массив = Новый Массив();
	Массив.Добавить(ИмяГруппы);
	Клеймы.Вставить("groups", Массив);
	Возврат Клеймы;
КонецФункции

Функция ВГруппе(Знач СГ, Знач Группа, Знач Юзер)
	Для Каждого Ид Из СГ.УчастникиГруппы(Группа.Идентификатор) Цикл
		Если Ид = Юзер.Идентификатор Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПоддельныйПул(Знач Ид, Знач Видимость)
	Возврат Новый Структура("Идентификатор, Видимость", Ид, Видимость);
КонецФункции

// Лог для классов, созданных НАПРЯМУЮ (минуя контейнер ОСени). С шага 6.D продуктовый
// класс получает лог инъекцией, поэтому при прямом создании его передаёт тест — иначе
// конструктор отказывает громко, а не собирает объект с журналом-Неопределено
// (см. tests/ДисциплинаЛогирования_Тесты.os).
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.oidc");
КонецФункции

Процедура ПодключитьСервисы(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить; // контроллерам нужен winow, в юнит-контейнере не подключаем
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
