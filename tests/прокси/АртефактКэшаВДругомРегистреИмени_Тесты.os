// Кэширующий пул, который знает пакет в другом регистре, чем адрес запроса, на регистрозависимом
// хранилище: S3 над фейком корзины различает ключи по регистру, как S3 и диск Linux. Источник —
// фейковый клиент апстрима; контейнер ОСени на КоннекторInMemory; отдельный процесс.

#Использовать asserts
#Использовать autumn-cache
#Использовать "../фикстуры"

Перем Выдача;         // фикстура СтендВыдачи — контейнер, хранилище на фейке S3, маршрут выдачи
Перем КореньСборки;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("СтендВыдачи");
	РеестрФикстур.Подключить("ФейкКлиентАпстрима");
	РеестрФикстур.Подключить("ФикстураПакета");

	КореньСборки = УникальныеИмена.ВременныйКаталог("oshub-proxy-case");
	Выдача = Новый СтендВыдачи(Новый Соответствие(), "кэш-регистр-тесты",
		"почта, уведомления, вход, права, публикация, статистика");

КонецПроцедуры

&ПослеВсех
Процедура УбратьСборку() Экспорт
	УникальныеИмена.УбратьВременное(КореньСборки);
КонецПроцедуры

// Ради чего всё: пакет заведён как MyPkg, `opm install` спрашивает /download/mypkg/… — привезённый
// .ospx ложится под именем из реестра и отдаётся из кэша по любому регистру адреса.
&Тест
Процедура ПривезённоеЛожитсяПоИмениРеестраИОтдаётсяИзКэша() Экспорт

	Сцена = Сцена();
	Адрес = НРег(Сцена.Имя);

	Ожидаем.Что(Скачать(Сцена, Адрес, Адрес + "-1.0.0.ospx").Код, "первый запрос привёз версию").Равно(200);
	Ожидаем.Что(Сцена.Клиент.КоличествоСкачиваний(), "самотест: к источнику сходили один раз").Равно(1);
	Ожидаем.Что(ЛежащиеOspx(Сцена), "файл лёг под именем из реестра")
		.Равно(СтрШаблон("%1/%1-1.0.0.ospx", Сцена.Имя));

	Ожидаем.Что(Скачать(Сцена, Адрес, Адрес + "-1.0.0.ospx").Код, "повтор отдан").Равно(200);
	Ожидаем.Что(Скачать(Сцена, Сцена.Имя, Сцена.Имя + "-1.0.0.ospx").Код, "и по имени из реестра")
		.Равно(200);
	Ожидаем.Что(Сцена.Клиент.КоличествоСкачиваний(), "повторы отданы из кэша, источник не спрошен")
		.Равно(1);
	Ожидаем.Что(ЛежащиеOspx(Сцена), "второй копии нет").Равно(СтрШаблон("%1/%1-1.0.0.ospx", Сцена.Имя));

	Пакет = Выдача.Желудь("СервисПакетов").НайтиПакет(Сцена.Пул.Идентификатор, Сцена.Имя);
	Версия = Выдача.Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0");
	Ожидаем.Что(Версия.ПутьВХранилище, "запись версии называет тот же ключ")
		.Равно(СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", Сцена.Пул.Имя, Сцена.Имя));

КонецПроцедуры

// Уборка пакета снимает привезённый файл: в корзине не остаётся .ospx.
&Тест
Процедура УборкаСнимаетПривезённое() Экспорт

	Сцена = Сцена();
	Адрес = НРег(Сцена.Имя);
	Ожидаем.Что(Скачать(Сцена, Адрес, Адрес + "-1.0.0.ospx").Код, "самотест: версия привезена").Равно(200);
	Ожидаем.Что(ЛежащиеOspx(Сцена), "самотест: файл лёг").Заполнено();

	Выдача.Желудь("УборкаПакета").УдалитьПакет(
		Выдача.Желудь("СервисПакетов").НайтиПакет(Сцена.Пул.Идентификатор, Сцена.Имя));

	Ожидаем.Что(ЛежащиеOspx(Сцена), "привезённый файл снят вместе с пакетом").Равно("");

КонецПроцедуры

#Область Помощники

// Пул с источником знает пакет в смешанном регистре; источник отдаёт .ospx с именем, как в адресе.
Функция Сцена()

	Пул = Выдача.Засев.ПулСервисом();
	Имя = "MyPkg-" + УникальныеИмена.Хвост();
	Выдача.Засев.ПакетСервисом(Пул, Имя);
	Выдача.Апстримы.Апстрим(Пул, "http://upstream.invalid/download/");

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветДанные(200, Новый ФикстураПакета().ДанныеOspx(КореньСборки, НРег(Имя), "1.0.0"));

	Возврат Новый Структура("Пул, Имя, Клиент, Резолвер", Пул, Имя, Клиент, РезолверС(Клиент));

КонецФункции

// Резолвер и прокси контейнера, но с фейковым клиентом апстрима: сети в наборе нет.
Функция РезолверС(Знач Клиент)

	Прокси = Новый СервисПрокси(Выдача.Желудь("СервисПакетов"), Выдача.Желудь("СервисВерсий"),
		Выдача.Желудь("ПриёмВерсии"), Выдача.Желудь("СверкаETag"), Выдача.Желудь("ПравилаИменования"),
		Выдача.Желудь("ХранилищеАртефактов"), Клиент, Выдача.Желудь("СтражАпстримов"),
		Выдача.Желудь("КэшИзменяемыхРесурсов"), Выдача.Желудь("ЗаписьЗанятогоМеста"),
		Выдача.Желудь("СервисНастроек"), Выдача.Желудь("АллоулистИмён"),
		Логирование.ПолучитьЛог("тест.oshub.кэш-регистр"));

	Возврат Новый РезолверВыдачи(Выдача.Желудь("СервисПулов"), Выдача.Желудь("СервисАпстримовПула"),
		Выдача.Желудь("СервисПакетов"), Выдача.Желудь("СервисВерсий"), Выдача.Желудь("РезолверСпецификации"),
		Выдача.Желудь("СервисТегов"), Выдача.Желудь("ХранилищеАртефактов"), Прокси,
		Выдача.Желудь("СервисПроисхождения"), Выдача.Желудь("ОбъединённыйНаборВерсий"),
		Логирование.ПолучитьЛог("тест.oshub.кэш-регистр"), Выдача.Желудь("КэшАртефактов"));

КонецФункции

// Маршрут выдачи — тот, к которому ходит opm install: пул, имя пакета и имя файла — как в адресе.
Функция Скачать(Знач Сцена, Знач ИмяВАдресе, Знач ИмяФайла)
	Возврат Выдача.Выдать(Новый Структура("Пул, Пакет", Сцена.Пул, Новый Структура("Имя", ИмяВАдресе)),
		"GET", "", ИмяФайла, Сцена.Резолвер);
КонецФункции

// Ключи .ospx пула в корзине относительно области пула, по порядку, через запятую.
Функция ЛежащиеOspx(Знач Сцена)

	Префикс = СтрШаблон("pools/%1/", Сцена.Пул.Имя);
	Ключи = Новый СписокЗначений();
	Для Каждого Объект Из Выдача.КлиентS3().Перечислить(Префикс) Цикл
		Если СтрЗаканчиваетсяНа(Объект.Ключ, ".ospx") Тогда
			Ключи.Добавить(Сред(Объект.Ключ, СтрДлина(Префикс) + 1));
		КонецЕсли;
	КонецЦикла;
	Ключи.СортироватьПоЗначению();
	Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");

КонецФункции

#КонецОбласти
