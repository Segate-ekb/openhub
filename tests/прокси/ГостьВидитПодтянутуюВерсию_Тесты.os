// Гость кэширующего пула видит версию, которую прокси только что подтянул с апстрима, без ожидания
// срока страницы; отдача уже лежащей версии страницы гостя не сбрасывает. Источник — фейковый
// клиент апстрима; контейнер ОСени на КоннекторInMemory; отдельный процесс.

#Использовать asserts
#Использовать autumn-cache
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем Выдача;         // фикстура СтендВыдачи — контейнер, хранилище на фейке S3, маршрут выдачи
Перем КореньСборки;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("СтендВыдачи");
	РеестрФикстур.Подключить("ФейкКлиентАпстрима");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("ОтветСтраницыКэшаЗаглушка");
	РеестрФикстур.Подключить("СтендКэшаСтраниц");

	КореньСборки = УникальныеИмена.ВременныйКаталог("oshub-proxy-guest");
	Выдача = Новый СтендВыдачи(Новый Соответствие(), "гость-подтянутой-тесты",
		"почта, уведомления, вход, права, публикация, статистика");

	// кэш страниц гостя — вне контейнера: его подписывает на события издатель контейнера
	Поиск = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Каталог = ОбъединитьПути(ОбъединитьПути(Модули, "интерфейс", "Классы"), "общее", "кэш-страниц");
	Поиск.Подключить(Каталог, "КэшСтраницАнонима");
	Поиск.Подключить(Каталог, "ПересборкаСтраницыГостя");
	Поиск.Подключить(ОбъединитьПути(ОбъединитьПути(Модули, "интерфейс", "Классы"), "панели", "пакет"), "КомандыOpm");

КонецПроцедуры

&ПослеВсех
Процедура УбратьСборку() Экспорт
	УникальныеИмена.УбратьВременное(КореньСборки);
КонецПроцедуры

// opm install в кэширующем пуле привёз версию — следующий гость получает свежую страницу пула.
&Тест
Процедура ПодтянутаяВерсияСбрасываетСтраницыГостя() Экспорт

	Сцена = Сцена();
	Гость(Сцена);

	Ожидаем.Что(Скачать(Сцена).Код, "самотест: версия привезена с апстрима").Равно(200);
	Ожидаем.Что(Сцена.Клиент.КоличествоСкачиваний(), "самотест: к источнику сходили").Равно(1);
	Свежая = Гость(Сцена);

	Ожидаем.Что(Сцена.Стенд.Сборок, "после приёма версии страница собрана заново").Равно(2);
	Ожидаем.Что(Свежая.ТелоТекст, "гость видит новую").Содержит("#2");

КонецПроцедуры

// Повторное скачивание отдаётся из кэша пула: страницы гостя остаются в памяти.
&Тест
Процедура ОтдачаЛежащейВерсииСтраницНеСбрасывает() Экспорт

	Сцена = Сцена();
	Ожидаем.Что(Скачать(Сцена).Код, "самотест: версия привезена с апстрима").Равно(200);
	Гость(Сцена);

	Ожидаем.Что(Скачать(Сцена).Код, "повтор отдан").Равно(200);
	Ожидаем.Что(Скачать(Сцена).Код, "и ещё раз").Равно(200);
	Ожидаем.Что(Сцена.Клиент.КоличествоСкачиваний(), "самотест: повторы отданы из кэша пула").Равно(1);
	Прежняя = Гость(Сцена);

	Ожидаем.Что(Сцена.Стенд.Сборок, "страница гостя не пересобиралась").Равно(1);
	Ожидаем.Что(Прежняя.ТелоТекст, "гость получил ту же").Содержит("#1");

КонецПроцедуры

#Область Помощники

// Пул с источником, источник отдаёт .ospx; кэш гостя подписан издателем контейнера.
Функция Сцена()

	Пул = Выдача.Засев.ПулСервисом();
	Имя = "lib-" + УникальныеИмена.Хвост();
	Выдача.Апстримы.Апстрим(Пул, "http://upstream.invalid/download/");

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветДанные(200, Новый ФикстураПакета().ДанныеOspx(КореньСборки, Имя, "1.0.0"));

	Стенд = Новый СтендКэшаСтраниц();
	Кэш = НовыйКэш(Стенд, Выдача.Желудь("ИздательСобытий"));

	Возврат Новый Структура("Пул, Имя, Клиент, Резолвер, Стенд, Кэш",
		Пул, Имя, Клиент, РезолверС(Клиент), Стенд, Кэш);

КонецФункции

Функция НовыйКэш(Знач Стенд, Знач Издатель)
	ЗаголовкиHTTP = Новый ЗаголовкиHTTP();
	Команды = Новый КомандыOpm(Новый АдресИнстанса(Стенд), ЗаголовкиHTTP, , , Стенд);
	Возврат Новый КэшСтраницАнонима(Стенд, ЗаголовкиHTTP, Новый ЗаголовкиКэша(ЗаголовкиHTTP), Стенд,
		Новый ТокеныТемы(), Команды, Стенд, Стенд, Логирование.ПолучитьЛог("тест.oshub.гость-подтянутой"),
		Стенд, Издатель, Стенд);
КонецФункции

// Прокси контейнера с его издателем, но с фейковым клиентом апстрима: сети в наборе нет.
Функция РезолверС(Знач Клиент)

	Прокси = Новый СервисПрокси(Выдача.Желудь("СервисПакетов"), Выдача.Желудь("СервисВерсий"),
		Выдача.Желудь("ПриёмВерсии"), Выдача.Желудь("СверкаETag"), Выдача.Желудь("ПравилаИменования"),
		Выдача.Желудь("ХранилищеАртефактов"), Клиент, Выдача.Желудь("СтражАпстримов"),
		Выдача.Желудь("КэшИзменяемыхРесурсов"), Выдача.Желудь("ЗаписьЗанятогоМеста"),
		Выдача.Желудь("СервисНастроек"), Выдача.Желудь("АллоулистИмён"),
		Логирование.ПолучитьЛог("тест.oshub.гость-подтянутой"), , , , , ,
		Выдача.Желудь("ИздательСобытий"));

	Возврат Новый РезолверВыдачи(Выдача.Желудь("СервисПулов"), Выдача.Желудь("СервисАпстримовПула"),
		Выдача.Желудь("СервисПакетов"), Выдача.Желудь("СервисВерсий"), Выдача.Желудь("РезолверСпецификации"),
		Выдача.Желудь("СервисТегов"), Выдача.Желудь("ХранилищеАртефактов"), Прокси,
		Выдача.Желудь("СервисПроисхождения"), Выдача.Желудь("ОбъединённыйНаборВерсий"),
		Логирование.ПолучитьЛог("тест.oshub.гость-подтянутой"), Выдача.Желудь("КэшАртефактов"));

КонецФункции

// Маршрут выдачи — тот, к которому ходит opm install.
Функция Скачать(Знач Сцена)
	Возврат Выдача.Выдать(Новый Структура("Пул, Пакет", Сцена.Пул, Новый Структура("Имя", Сцена.Имя)),
		"GET", "", Сцена.Имя + "-1.0.0.ospx", Сцена.Резолвер);
КонецФункции

// Страница пула глазами гостя: без куки и ключа доступа.
Функция Гость(Знач Сцена)
	Возврат Сцена.Кэш.СформироватьОтвет(Сцена.Стенд.Запрос("GET", "/pools/" + Сцена.Пул.Имя), Сцена.Стенд);
КонецФункции

#КонецОбласти
