// Сервис пакетов, у которого поиск пакета всегда падает: так выглядит отказ базы или кэша.

Перем ТекстСбоя;

// Всегда бросает исключение с заданным текстом.
//
// Параметры:
//  ПулИдентификатор - Число - пул.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Пакет - не возвращает никогда.
//
Функция ПакетДляЧтения(Знач ПулИдентификатор, Знач ИмяПакета) Экспорт
	ВызватьИсключение ТекстСбоя;
КонецФункции

// Всегда бросает исключение с заданным текстом.
//
// Параметры:
//  ПулИдентификатор - Число - пул.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Пакет - не возвращает никогда.
//
Функция НайтиПакет(Знач ПулИдентификатор, Знач ИмяПакета) Экспорт
	ВызватьИсключение ТекстСбоя;
КонецФункции

Процедура ПриСозданииОбъекта(Знач _ТекстСбоя)
	ТекстСбоя = _ТекстСбоя;
КонецПроцедуры
