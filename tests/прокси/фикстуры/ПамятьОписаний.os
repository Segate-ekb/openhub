// Служба описаний для обхода актуализатора: запоминает, описание какой версии пакета
// обход положил бы на диск.

Перем Версии; // Соответствие: имя пакета -> номер версии

// Запоминает версию, описание которой обход обеспечивает (контракт СлужбаREADME).
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет.
//  Версия - ВерсияПакета, Неопределено - версия по умолчанию.
//
// Возвращаемое значение:
//  Булево - Истина, если версия есть.
//
Функция ОбеспечитьОписаниеНаДиске(Знач Пул, Знач Пакет, Знач Версия) Экспорт
	Пул = Пул;
	Если Версия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Версии.Вставить(Пакет.Имя, Строка(Версия.Версия));
	Возврат Истина;
КонецФункции

// Версия, описание которой обход положил для пакета.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - номер версии; "<нет>", если пакет не обходили.
//
Функция ВерсияОписания(Знач ИмяПакета) Экспорт
	Версия = Версии.Получить(ИмяПакета);
	Возврат ?(Версия = Неопределено, "<нет>", Версия);
КонецФункции

Процедура ПриСозданииОбъекта()
	Версии = Новый Соответствие();
КонецПроцедуры
