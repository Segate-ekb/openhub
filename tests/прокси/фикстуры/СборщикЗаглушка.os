// Заглушка сборщика кэша прокси: считает вызовы Собрать(). Не входит в состав приложения.

Перем ПроходовВызвано_;

// Контракт сборщика кэша прокси: считает вызов и возвращает пустой итог.
//
// Возвращаемое значение:
//  Структура (ПуловОбработано, УдаленоФайлов, ОсвобожденоБайт) - всегда нули.
//
Функция Собрать() Экспорт
	ПроходовВызвано_ = ПроходовВызвано_ + 1;
	Возврат Новый Структура("ПуловОбработано, УдаленоФайлов, ОсвобожденоБайт", 0, 0, 0);
КонецФункции

// Сколько раз планировщик позвал Собрать().
//
// Возвращаемое значение:
//  Число.
//
Функция ПроходовВызвано() Экспорт
	Возврат ПроходовВызвано_;
КонецФункции

Процедура ПриСозданииОбъекта()
	ПроходовВызвано_ = 0;
КонецПроцедуры
