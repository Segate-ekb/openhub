// Задача планировщика «gc-кэша-прокси» на ручных часах: планировщик приложения зовёт сборщик
// кэша прокси с интервалом из настройки.

#Использовать asserts
#Использовать "../фикстуры"

Перем Стенд;   // фикстура ПланировщикНаЧасах — планировщик приложения на ручных часах

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("ПланировщикНаЧасах");
	Стенд = Новый ПланировщикНаЧасах();

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "прокси", "Классы"),
		"ЗадачаСбораКэшаПрокси");
	РеестрФикстур.Подключить("СборщикЗаглушка");

КонецПроцедуры

&Тест
Процедура СборИдётСИнтерваломИзНастройки() Экспорт

	Сборщик = Новый СборщикЗаглушка();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Задачи = Новый Массив();
	Задачи.Добавить(Новый ЗадачаСбораКэшаПрокси(Сборщик, 120));

	Пл = Стенд.Планировщик(Задачи, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(119);
	Планировщик.Тик();
	Ожидаем.Что(Сборщик.ПроходовВызвано(), "до интервала сборки нет").Равно(0);

	Часы.Прибавить(1);
	Планировщик.Тик();
	Ожидаем.Что(Сборщик.ПроходовВызвано(), "планировщик вызвал сборщик кэша прокси").Равно(1);

КонецПроцедуры
