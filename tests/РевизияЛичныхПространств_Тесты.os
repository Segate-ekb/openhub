// РЕВЬЮ-СТОРОЖА (временный набор ревью-агента): границы массового сноса личных пространств.
// Проверяется исполнением, что снос не выходит за границу типа пула, не задевает соседей
// с общим префиксом имени и не трогает проектные пулы вместе с их файлами.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "аудит", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "основа", "Классы"));

	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить();

	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHub");
	ПоискКлассов.Подключить(Модули, "НормализаторУчётки");
	ПоискКлассов.Подключить(Модули, "ПолитикаПароля");
	// СервисПользователей пишет события безопасности учётки через летопись
	ПоискКлассов.Подключить(Модули, "ЛетописьУчёток");
	ПоискКлассов.Подключить(Модули, "АдресУчётки");
	ПоискКлассов.Подключить(Модули, "СервисПользователей");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "кабинет", "Классы", "СлужбаЛичныхПространств.os"));

	КаталогSettings = ОбъединитьПути(Модули, "настройки", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	КаталогNet = ОбъединитьПути(Модули, "сеть", "Классы");
	КаталогТелеметрии = ОбъединитьПути(Модули, "наблюдаемость", "Классы", "телеметрия");
	КаталогПроб = ОбъединитьПути(Модули, "наблюдаемость", "Классы", "пробы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.Подключить(КаталогТелеметрии, "СпанХаба");
	ПоискКлассов.Подключить(КаталогТелеметрии, "Телеметрия");
	ПоискКлассов.Подключить(КаталогПроб, "ГотовностьХаба");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийGitHub.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-ревизия-личных-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "ревизия-личных-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область ГраницыСноса

// Область пула чистится по описи хранилища, а опись адресуется ИМЕНЕМ пула. Имя-префикс
// соседа («abc» и «abcd») — классическое место, где сравнение без разделителя уносит чужое.
&Тест
Процедура ПулСПрефиксомИмениСоседаНеТеряетФайлы() Экспорт

	Короткий = ПулСПакетом("abc", "abc-lib");
	Длинный = ПулСПакетом("abcd", "abcd-lib");

	Желудь("СервисПулов").УдалитьПул(Короткий.ПулИд);

	Ожидаем.Что(Новый Файл(Короткий.ПутьАртефакта).Существует(),
		"файл пула abc снят").ЭтоЛожь();
	Ожидаем.Что(Новый Файл(Длинный.ПутьАртефакта).Существует(),
		"файл пула abcd НЕ снят удалением пула abc").ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Опись("abcd").Количество(),
		"опись соседа с общим префиксом имени цела").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеПакетов").ПолучитьПоПулИдентификаторРавно(Длинный.ПулИд).Количество(),
		"и его пакет тоже").Равно(1);

КонецПроцедуры

// Сторож проектных пулов: снос личных пространств не смеет тронуть ни строку, ни файл
// общих пулов хаба — включая основной пул, который вообще неудаляем.
&Тест
Процедура ПроектныеПулыИИхФайлыПереживаютСносЛичных() Экспорт

	Публичный = ПулСПакетом("public", "public-lib");
	Корп = ПулСПакетом("corp", "corp-lib");
	Команда = ПулСПакетом("team", "team-lib");

	ЛичныйСПакетом();
	ЛичныйСПакетом();

	Служба = Желудь("СлужбаЛичныхПространств");
	Сводка = Служба.СводкаУдаления();
	Ожидаем.Что(Сводка.Пулов >= 2, "к сносу есть личные пространства").ЭтоИстина();
	Ожидаем.Что(Сводка.ПуловСПакетами >= 2, "и среди них непустые").ЭтоИстина();

	Служба.УдалитьВсе("root");

	Ожидаем.Что(Желудь("СервисПулов").ПулыПоТипу(Желудь("СервисПулов").ТипЛичный()).Количество(),
		"личных пулов не осталось").Равно(0);

	Для Каждого Стенд Из Проектные(Публичный, Корп, Команда) Цикл
		Ожидаем.Что(Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Стенд.ПулИд) <> Неопределено,
			"проектный пул " + Стенд.ИмяПула + " на месте").ЭтоИстина();
		Ожидаем.Что(Желудь("ХранилищеПакетов").ПолучитьПоПулИдентификаторРавно(Стенд.ПулИд).Количество(),
			"пакет пула " + Стенд.ИмяПула + " на месте").Равно(1);
		Ожидаем.Что(Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(Стенд.ПакетИд).Количество(),
			"версия пула " + Стенд.ИмяПула + " на месте").Равно(1);
		Ожидаем.Что(Новый Файл(Стенд.ПутьАртефакта).Существует(),
			"файл артефакта пула " + Стенд.ИмяПула + " на месте").ЭтоИстина();
		Ожидаем.Что(Желудь("ХранилищеПравДоступа").ГрантыНаОбъект("пул", Стенд.ПулИд).Количество(),
			"грант на пуле " + Стенд.ИмяПула + " на месте").Равно(1);
	КонецЦикла;

КонецПроцедуры

// Личное пространство уходит вместе с ЧУЖИМИ грантами на нём — но гранты того же чужака
// на других объектах не задеваются.
&Тест
Процедура ЧужойГрантНаЛичномУходитАЕгоЖеГрантНаПроектномОстаётся() Экспорт

	Проектный = ПулСПакетом("shared" + Хвост(), "shared-lib" + Хвост());
	Личный = ЛичныйСПакетом();
	Чужак = СоздатьПользователя();

	ВыдатьГрант(Чужак.Идентификатор, "пул", Личный.ПулИд);
	ВыдатьГрант(Чужак.Идентификатор, "пул", Проектный.ПулИд);

	Желудь("СлужбаЛичныхПространств").УдалитьВсе("root");

	Ожидаем.Что(Желудь("ХранилищеПравДоступа").ГрантыНаОбъект("пул", Личный.ПулИд).Количество(),
		"чужой грант на снесённом личном пуле не остался сиротой").Равно(0);
	Ожидаем.Что(Желудь("ХранилищеПравДоступа").НайтиГрант("пользователь", Чужак.Идентификатор,
		"пул", Проектный.ПулИд) <> Неопределено,
		"а его же грант на проектном пуле цел").ЭтоИстина();

КонецПроцедуры

// Учётки снос не трогает: пространство раздаётся заново, а пользователь остаётся.
&Тест
Процедура СносПространствНеТрогаетУчётки() Экспорт

	Хозяин = СоздатьПользователя();
	Ожидаем.Что(Желудь("СервисПулов").НайтиПул(Хозяин.Логин) <> Неопределено,
		"регистрация завела личное пространство").ЭтоИстина();
	БылоУчёток = Желудь("ХранилищеПользователей").Все().Количество();

	Желудь("СлужбаЛичныхПространств").УдалитьВсе("root");

	Ожидаем.Что(Желудь("ХранилищеПользователей").Все().Количество(),
		"ни одна учётка не снесена вместе с пространством").Равно(БылоУчёток);
	Ожидаем.Что(Желудь("ХранилищеПользователей").НайтиПоЛогину(Хозяин.Логин) <> Неопределено,
		"владелец снесённого пространства на месте").ЭтоИстина();

КонецПроцедуры

// Сбой на ОДНОМ пространстве не обрывает снос: неудачное пространство считается в Ошибок,
// остальные уходят, а вызывающий получает числа, а не исключение — иначе операция
// оставалась бы наполовину выполненной, и доделать её из интерфейса было бы нечем.
// Неудача берётся с продуктового пути: признак основного пула на строке (защита в глубину
// СервисПулов отказывает удалять носителя коротких адресов).
&Тест
Процедура СбойНаОдномПространствеНеОбрываетСнос() Экспорт

	Неудачное = ЛичныйСПакетом();
	СделатьОсновным(Неудачное.ПулИд);

	Целое = ЛичныйСПакетом();
	Ожидаем.Что(Желудь("СлужбаЛичныхПространств").СводкаУдаления().Пулов >= 2,
		"к сносу минимум два пространства").ЭтоИстина();

	Упало = "";
	Итог = Неопределено;
	Попытка
		Итог = Желудь("СлужбаЛичныхПространств").УдалитьВсе("root");
	Исключение
		Упало = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Упало, "сбой одного пространства до вызывающего не доходит").Равно("");
	Ожидаем.Что(Итог.Ошибок, "неудачное пространство посчитано ошибкой").Равно(1);
	Ожидаем.Что(Итог.Пулов >= 1, "остальные пространства снесены, а не брошены").ЭтоИстина();

	Ожидаем.Что(Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Целое.ПулИд) = Неопределено,
		"исправное пространство снесено, несмотря на соседний сбой").ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Неудачное.ПулИд) <> Неопределено,
		"а неудачное осталось — его и называет число ошибок").ЭтоИстина();

	// уборка стенда: снимаем признак, иначе следующий тест снова упрётся в него
	СнятьОсновной(Неудачное.ПулИд);

КонецПроцедуры

// Путь версии сервис публикации пишет ВЕРБАТИМ, не проверяя: путь, уходящий за корень
// хранилища, когда-то ронял уборку целиком. Координаты собираются из сущностей, поэтому
// битая строка больше не участвует в адресации и снос проходит как обычно.
&Тест
Процедура БитыйПутьВерсииСносНеРоняет() Экспорт

	// независимость от соседа: признак основного пула мог остаться от предыдущего теста
	Для Каждого Пул Из Желудь("СервисПулов").ПулыПоТипу(Желудь("СервисПулов").ТипЛичный()) Цикл
		СнятьОсновной(Цел(Пул.Идентификатор));
	КонецЦикла;

	Битый = ЛичныйСПакетом();
	ИспортитьПутьВерсии(Битый.ПакетИд);

	Упало = "";
	Итог = Неопределено;
	Попытка
		Итог = Желудь("СлужбаЛичныхПространств").УдалитьВсе("root");
	Исключение
		Упало = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Упало, "битый путь версии исключения не порождает").Равно("");
	Ожидаем.Что(Итог.Ошибок, "и ошибкой не считается").Равно(0);
	Ожидаем.Что(Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Битый.ПулИд) = Неопределено,
		"пространство с битым путём снесено").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Стенд

Процедура ИспортитьПутьВерсии(Знач ПакетИд)
	Для Каждого Версия Из Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(ПакетИд) Цикл
		Версия.ПутьВХранилище = "pools/../../снаружи/чужое.ospx";
		Версия.Сохранить();
	КонецЦикла;
КонецПроцедуры

// Признак основного пула ставится СТРОКОЙ, мимо сервиса: сервис личный пул основным
// не назначает, а защита в глубину внутри УдалитьПул отказывает удалять носителя
// коротких адресов — это и есть продуктовый сбой одного пространства.
Процедура СделатьОсновным(Знач ПулИд)
	Пул = Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(ПулИд);
	Пул.ПоУмолчанию = Истина;
	Пул.Сохранить();
КонецПроцедуры

Процедура СнятьОсновной(Знач ПулИд)
	Пул = Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(ПулИд);
	Если Пул <> Неопределено Тогда
		Пул.ПоУмолчанию = Ложь;
		Пул.Сохранить();
	КонецЕсли;
КонецПроцедуры

Функция Проектные(Знач А, Знач Б, Знач В)
	Список = Новый Массив();
	Список.Добавить(А);
	Список.Добавить(Б);
	Список.Добавить(В);
	Возврат Список;
КонецФункции

Функция ПулСПакетом(Знач ИмяПула, Знач ИмяПакета)

	Владелец = СоздатьПользователя();
	Пул = Желудь("СервисПулов").СоздатьПул(ИмяПула, "custom", "public", Владелец.Идентификатор, 0);
	ПулИд = Цел(Пул.Идентификатор);

	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(ПулИд, ИмяПакета,
		Новый Структура("Описание, Лицензия", "Пакет проектного пула", "MIT"));
	ПакетИд = Цел(Пакет.Идентификатор);

	Желудь("ХранилищеАртефактов").Сохранить(
		Новый КоординатыАртефакта(ИмяПула, ИмяПакета, "1.0.0"), ФайлИсточник("артефакт"));

	Заявка = Новый ЗаявкаНаПубликацию(ПакетИд, "1.0.0");
	Заявка.Размер = 1;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", ИмяПула, ИмяПакета);
	Желудь("СервисВерсий").Опубликовать(Заявка);

	ВыдатьГрант(Владелец.Идентификатор, "пул", ПулИд);

	Возврат Новый Структура("ПулИд, ИмяПула, ПакетИд, ПутьАртефакта", ПулИд, ИмяПула, ПакетИд,
		ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", ИмяПула), ИмяПакета,
			ИмяПакета + "-1.0.0.ospx"));

КонецФункции

Функция ЛичныйСПакетом()

	Владелец = СоздатьПользователя();
	Личный = Желудь("СервисПулов").НайтиПул(Владелец.Логин);
	Если Личный = Неопределено Тогда
		Личный = Желудь("СервисПулов").СоздатьЛичныйПул(Владелец.Логин, Владелец.Идентификатор);
	КонецЕсли;
	ПулИд = Цел(Личный.Идентификатор);

	ИмяПакета = УникальноеИмя("own");
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(ПулИд, ИмяПакета,
		Новый Структура("Описание, Лицензия", "Пакет личного пространства", "MIT"));

	Желудь("ХранилищеАртефактов").Сохранить(
		Новый КоординатыАртефакта(Строка(Личный.Имя), ИмяПакета, "1.0.0"), ФайлИсточник("своё"));

	Заявка = Новый ЗаявкаНаПубликацию(Цел(Пакет.Идентификатор), "1.0.0");
	Заявка.Размер = 1;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", Личный.Имя, ИмяПакета);
	Желудь("СервисВерсий").Опубликовать(Заявка);

	Возврат Новый Структура("ПулИд, ИмяПула, ПакетИд", ПулИд, Строка(Личный.Имя),
		Цел(Пакет.Идентификатор));

КонецФункции

Процедура ВыдатьГрант(Знач СубъектИд, Знач ТипОбъекта, Знач ОбъектИд)
	Грант = Желудь("ХранилищеПравДоступа").СоздатьЭлемент();
	Грант.ТипСубъекта = "пользователь";
	Грант.СубъектИдентификатор = СубъектИд;
	Грант.ТипОбъекта = ТипОбъекта;
	Грант.ОбъектИдентификатор = ОбъектИд;
	Грант.Создание = Истина;
	Грант.Изменение = Истина;
	Грант.Удаление = Ложь;
	Грант.Чтение = Истина;
	Грант.КемВыдано = 0;
	Грант.Выдано = ТекущаяУниверсальнаяДата();
	Грант.Сохранить();
КонецПроцедуры

Функция СоздатьПользователя()
	Логин = УникальноеИмя("u");
	Возврат Желудь("СервисПользователей").СоздатьПользователя(
		Логин, Логин + "@example.test", "TestPassw0rd", "user");
КонецФункции

Функция ФайлИсточник(Знач Текст)
	Путь = ПолучитьИмяВременногоФайла("ospx");
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
	Возврат Путь;
КонецФункции

Функция Хвост()
	Возврат Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 6);
КонецФункции

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0") + "-" + Хвост();
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

#КонецОбласти
