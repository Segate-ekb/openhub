// Смоук матрицы бэкендов entity: один сквозной сценарий (авто-DDL + CRUD через репозитории) на
// InMemory, JSON, SQLite (нужна нативная SQLite.Interop) и PostgreSQL (нужен OSHUB_TEST_PG_DSN).

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity

Перем КаталогКлассовDb;
Перем СозданныеКаталоги;   // Массив - временные каталоги для удаления в конце

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("внешние")
Процедура ПриСозданииОбъекта() Экспорт
	СозданныеКаталоги = Новый Массив();
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассыМодуляDb() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), ОбъединитьПути("данные", "Классы"));

	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассовDb, "*.os", Истина) Цикл
		Если НЕ ТипЗарегистрирован(ФайлКласса.ИмяБезРасширения) Тогда
			ПодключитьСценарий(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&ПослеВсех
Процедура УдалитьВременныеКаталоги() Экспорт

	Для Каждого Каталог Из СозданныеКаталоги Цикл
		Попытка
			УдалитьФайлы(Каталог);
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СмокInMemory() Экспорт
	ПрогнатьСценарий("КоннекторInMemory", "смок-бэкендов");
КонецПроцедуры

&Тест
Процедура СмокJSON() Экспорт
	ПрогнатьСценарий("КоннекторJSON", НовыйВременныйКаталог());
КонецПроцедуры

&Тест
&ВключенЕсли("() -> SQLiteДоступен()",
	Причина = "нет нативной библиотеки SQLite.Interop для этой платформы (в sql нет сборки, напр., для macOS arm64)")
Процедура СмокSQLite() Экспорт
	ФайлБазы = ОбъединитьПути(НовыйВременныйКаталог(), "openhub-smoke.db");
	ПрогнатьСценарий("КоннекторSQLite", "Data Source=" + ФайлБазы);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_TEST_PG_DSN""))",
	Причина = "не задана переменная окружения OSHUB_TEST_PG_DSN со строкой соединения PostgreSQL")
Процедура СмокPostgreSQL() Экспорт
	ПрогнатьСценарий("КоннекторPostgreSQL", ПолучитьПеременнуюСреды("OSHUB_TEST_PG_DSN"));
КонецПроцедуры

// Доступен ли бэкенд SQLite: без нативной SQLite.Interop создание менеджера сущностей
// бросает DllNotFoundException.
//
// Возвращаемое значение:
//  Булево - Истина, если менеджер на КоннекторSQLite инициализировался.
//
Функция SQLiteДоступен() Экспорт

	Попытка
		МенеджерСущностей = Новый МенеджерСущностей(Тип("КоннекторSQLite"), "FullUri=file::memory:?cache=shared");
		МенеджерСущностей.Инициализировать();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ПрогнатьСценарий(Знач ТипКоннектора, Знач СтрокаСоединения)

	Поделка = ПостроитьПоделку(ТипКоннектора, СтрокаСоединения);
	Суффикс = Лев(Строка(Новый УникальныйИдентификатор()), 8);

	МенеджерСущностей = Поделка.НайтиЖелудь("МенеджерСущностей");
	Ожидаем.Что(МенеджерСущностей, "менеджер сущностей " + ТипКоннектора).Существует();

	ПрогнатьДвоичныйАктив(Поделка, ТипКоннектора, Суффикс);

	ХранилищеПулов = Поделка.НайтиЖелудь("ХранилищеПулов");
	ХранилищеПакетов = Поделка.НайтиЖелудь("ХранилищеПакетов");
	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");
	ХранилищеТегов = Поделка.НайтиЖелудь("ХранилищеТегов");

	Пул = ХранилищеПулов.СоздатьЭлемент();
	Пул.Имя = "смок-" + Суффикс;
	Пул.Тип = "custom";
	Пул.Видимость = "public";
	Пул.КвотаМб = 0;
	Пул.Создан = ТекущаяУниверсальнаяДата();
	Пул.Сохранить();
	Ожидаем.Что(Пул.Идентификатор, "идентификатор пула, " + ТипКоннектора).Существует();

	Пакет = ХранилищеПакетов.СоздатьЭлемент();
	Пакет.ПулИдентификатор = Пул.Идентификатор;
	Пакет.Имя = "СмокПакет-" + Суффикс;
	Пакет.ИмяНижнийРегистр = НРег(Пакет.Имя);
	Пакет.Описание = "смоук-тест";
	Пакет.Устарел = Ложь;
	Пакет.Скрыт = Ложь;
	Пакет.Создан = ТекущаяУниверсальнаяДата();
	Пакет.Сохранить();

	ДобавитьВерсию(ХранилищеВерсий, Пакет.Идентификатор, "1.0.0", Ложь);
	ДобавитьВерсию(ХранилищеВерсий, Пакет.Идентификатор, "1.1.0", Истина);

	Тег = ХранилищеТегов.СоздатьЭлемент();
	Тег.ПакетИдентификатор = Пакет.Идентификатор;
	Тег.Имя = "latest";
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить();

	НайденныйПул = ХранилищеПулов.ПолучитьОдноПоИмяРавно("смок-" + Суффикс);
	Ожидаем.Что(НайденныйПул, "пул по имени, " + ТипКоннектора).Существует();

	НайденныйПакет = ХранилищеПакетов.НайтиПоИмени(Пул.Идентификатор, ВРег(Пакет.Имя));
	Ожидаем.Что(НайденныйПакет, "пакет по имени, " + ТипКоннектора).Существует();
	Ожидаем.Что(НайденныйПакет.Идентификатор).Равно(Пакет.Идентификатор);

	Действующие = ХранилищеВерсий.ДействующиеВерсии(Пакет.Идентификатор);
	Ожидаем.Что(Действующие.Количество(), "действующие версии, " + ТипКоннектора).Равно(1);
	Ожидаем.Что(Действующие[0].Версия).Равно("1.0.0");

	НайденныйПакет.Описание = "обновлённое описание";
	НайденныйПакет.Сохранить();
	Перечитанный = ХранилищеПакетов.НайтиПоИмени(Пул.Идентификатор, Пакет.Имя);
	Ожидаем.Что(Перечитанный.Описание, "обновление, " + ТипКоннектора).Равно("обновлённое описание");

	ВсеВерсии = ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор);
	Для Каждого Версия Из ВсеВерсии Цикл
		Версия.Удалить();
	КонецЦикла;
	Ожидаем.Что(ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор).Количество(),
		"версии после удаления, " + ТипКоннектора).Равно(0);

	НайденныйТег = ХранилищеТегов.ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(Пакет.Идентификатор, "latest");
	НайденныйТег.Удалить();
	Перечитанный.Удалить();
	НайденныйПул.Удалить();

	Ожидаем.Что(ХранилищеПакетов.НайтиПоИмени(Пул.Идентификатор, Пакет.Имя),
		"пакет после удаления, " + ТипКоннектора).ЭтоНеопределено();
	Ожидаем.Что(ХранилищеПулов.ПолучитьОдноПоИмяРавно("смок-" + Суффикс),
		"пул после удаления, " + ТипКоннектора).ЭтоНеопределено();

КонецПроцедуры

// Логотип хаба лежит в базе двоичной колонкой. Байты, не переживающие сериализацию
// бэкенда, — это картинка, которая на одном хабе рисуется, а на другом бьётся; поэтому
// round-trip проверяется на КАЖДОМ бэкенде матрицы, а не на одном удобном.
Процедура ПрогнатьДвоичныйАктив(Знач Поделка, Знач ТипКоннектора, Знач Суффикс)

	Хранилище = Поделка.НайтиЖелудь("ХранилищеБрендовыхАктивов");
	Ожидаем.Что(Хранилище, "хранилище брендовых активов, " + ТипКоннектора).Существует();

	Исходные = НеТекстовыеБайты();
	Хранилище.Установить("logo", Исходные, "image/png", "отпечаток-" + Суффикс,
		"root", ТекущаяУниверсальнаяДата());

	Актив = Хранилище.Актив("logo");
	Ожидаем.Что(Актив, "актив найден, " + ТипКоннектора).Существует();
	Ожидаем.Что(ТипЗнч(Актив.Содержимое) = Тип("ДвоичныеДанные"),
		"колонка отдала двоичные данные, " + ТипКоннектора).ЭтоИстина();
	Ожидаем.Что(Актив.Содержимое.Размер(), "размер сохранён, " + ТипКоннектора)
		.Равно(Исходные.Размер());
	Ожидаем.Что(ПолучитьBase64СтрокуИзДвоичныхДанных(Актив.Содержимое),
		"байты совпали до единого, " + ТипКоннектора)
		.Равно(ПолучитьBase64СтрокуИзДвоичныхДанных(Исходные));

	Хранилище.Удалить("logo");
	Ожидаем.Что(Хранилище.Актив("logo"), "актив снят, " + ТипКоннектора).ЭтоНеопределено();

КонецПроцедуры

// Заголовок PNG и все 256 значений байта: последовательность заведомо не UTF-8, поэтому
// бэкенд, роняющий двоичное в текст, обязан на ней сломаться.
Функция НеТекстовыеБайты()

	Поток = Новый ПотокВПамяти();
	Запись = Новый ЗаписьДанных(Поток);
	Запись.ЗаписатьБайт(137);
	Запись.ЗаписатьБайт(80);
	Запись.ЗаписатьБайт(78);
	Запись.ЗаписатьБайт(71);
	Для Байт = 0 По 255 Цикл
		Запись.ЗаписатьБайт(Байт);
	КонецЦикла;
	Запись.Закрыть();

	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

Функция НовыйВременныйКаталог()

	Каталог = ОбъединитьПути(КаталогВременныхФайлов(),
		"openhub-1c-смок-" + Лев(Строка(Новый УникальныйИдентификатор()), 8));
	СоздатьКаталог(Каталог);
	СозданныеКаталоги.Добавить(Каталог);

	Возврат Каталог;

КонецФункции

Функция ПостроитьПоделку(Знач ТипКоннектора, Знач СтрокаСоединения)

	Детальки = Новый Соответствие();

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", ТипКоннектора);
	ИсточникДанных.Вставить("СтрокаСоединения", СтрокаСоединения);
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

Процедура ДобавитьВерсию(ХранилищеВерсий, Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Отозвана)

	ЧастиВерсии = СтрРазделить(СтрокаВерсии, ".");

	Версия = ХранилищеВерсий.СоздатьЭлемент();
	Версия.ПакетИдентификатор = ПакетИдентификатор;
	Версия.Версия = СтрокаВерсии;
	Версия.SemverМажор = Число(ЧастиВерсии[0]);
	Версия.SemverМинор = Число(ЧастиВерсии[1]);
	Версия.SemverПатч = Число(ЧастиВерсии[2]);
	Версия.ПризнакLegacyВерсии = Ложь;
	Версия.Размер = 1024;
	Версия.Sha256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
	Версия.Отозвана = Отозвана;
	Версия.Опубликована = ТекущаяУниверсальнаяДата();
	Версия.ПутьВХранилище = "pools/смок/пакет.ospx";
	Версия.Сохранить();

КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)

	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба; // функция не может вызываться как процедура
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции
