// Своих правил наследования у связки нет: узел, который она собрала из узла logos.logger
// файла оператора, настраивает журналы в настоящей logos так же, как родной узел оператора, —
// уровень и выходы каждого журнала, названного и не названного; порог коллектора поверх
// меняет у журнала один коллектор.

#Использовать asserts
#Использовать logos
#Использовать autumn-logos
#Использовать "фикстуры"

Перем Сценарий;   // Число — номер применения узла: имена журналов у каждого свои

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Сценарий = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей(), "наблюдаемость", "Классы"), "ШкалаЖурнала");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей(), "наблюдаемость", "Классы"), "УровниЖурнала");
	РеестрФикстур.Подключить("ЛовушкаЛога");

КонецПроцедуры

// Выходы журнала добавляются к выходам корня, с additivity: false — заменяют их.
&Тест
Процедура ВыходыИAdditivityКакВLogos() Экспорт

	Узел = Новый Соответствие();
	Узел.Вставить("rootLogger", Опции("INFO", "console,memory"));
	Узел.Вставить("Добавочный", Опции("DEBUG", "otel"));
	Узел.Вставить("Заменяющий", Опции("WARN", "otel", Ложь));
	Узел.Вставить("ТолькоУровень", "ERROR");

	СверитьСLogos(Узел, "Добавочный,Заменяющий,ТолькоУровень,Заменяющий.дитя,Неназванный");

КонецПроцедуры

// Журнал берёт свою запись либо запись ближайшего предка — и только её, а незаданное — у корня:
// промежуточные предки не складываются.
&Тест
Процедура ПредкиКакВLogos() Экспорт

	Узел = Новый Соответствие();
	Узел.Вставить("rootLogger", Опции("INFO", "console"));
	Узел.Вставить("a", Опции("WARN", "otel", Ложь));
	Узел.Вставить("a.b.c", Опции("", "memory"));
	Узел.Вставить("x", Опции("DEBUG", "memory"));

	СверитьСLogos(Узел, "a,a.b,a.b.c,a.b.c.d,x,x.y,z");

КонецПроцедуры

// Корень без выходов в узле пишет во все выходы процесса, без уровня — на INFO.
&Тест
Процедура КореньБезНастроекКакВLogos() Экспорт

	Узел = Новый Соответствие();
	Узел.Вставить("Один", "WARN");
	Узел.Вставить("Два", Опции("", "console", Ложь));

	СверитьСLogos(Узел, "Один,Два,Три");

КонецПроцедуры

// Порог коллектора — слой поверх: у настоящей logos уровень журнала и его выходы в консоль
// и память с порогом те же, что без него, — у названных журналов и у их потомков; коллектора
// порог не добавляет и не снимает, а пишет коллектор не подробнее ни уровня журнала, ни порога.
&Тест
Процедура ПорогНеМеняетЖурналВLogos() Экспорт

	Узел = Новый Соответствие();
	Узел.Вставить("rootLogger", Опции("INFO", "console,memory,otel"));
	Узел.Вставить("oscript.lib", Опции("WARN", "console", Ложь));
	Узел.Вставить("oscript.lib.winow", Опции("", "otel"));
	Узел.Вставить("Тихий", "DISABLE");
	Узел.Вставить("Подробный", "DEBUG");
	Проверяемые = СтрРазделить("oscript.lib,oscript.lib.autumn-cache,oscript.lib.winow,oscript.lib.winow.Фабрика,"
		+ "Тихий,Тихий.дитя,Подробный,Подробный.дитя,Новый,Новый.дитя,Прочий", ",");

	СверитьСLogos(Узел, СтрСоединить(Проверяемые, ","));

	Заданное = ЗаданноеФайлом(Узел);
	Заданное.Окружение.Вставить("Порог", ИзОкружения("WARN"));
	Заданное.Окружение.Вставить("Пороги", ИзОкружения("oscript.lib.autumn-cache=ERROR,oscript.lib.winow=ERROR,"
		+ "Тихий.дитя=DISABLE,Подробный=DISABLE,Новый=WARN"));

	БезПорога = ЖурналыСКоллектором(ПрименитьСвязку(ЗаданноеФайлом(Узел)), Проверяемые);
	СПорогом = ЖурналыСКоллектором(ПрименитьСвязку(Заданное), Проверяемые);

	Для Каждого Имя Из Проверяемые Цикл
		Без = БезПорога[Имя];
		Суженный = СПорогом[Имя];
		Ожидаем.Что(Суженный.Уровень, "журнал " + Имя + ": уровень порог не меняет").Равно(Без.Уровень);
		Ожидаем.Что(Суженный.Выходы, "журнал " + Имя + ": консоль и память порог не меняет").Равно(Без.Выходы);
		Ожидаем.Что(Суженный.Коллектор = Неопределено, "журнал " + Имя + ": коллектор порог не добавляет и не снимает")
			.Равно(Без.Коллектор = Неопределено);
		Если Суженный.Коллектор <> Неопределено Тогда
			Ожидаем.Что(Суженный.Коллектор >= Суженный.Уровень, "журнал " + Имя + ": в коллектор не подробнее уровня журнала")
				.ЭтоИстина();
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СПорогом["oscript.lib.winow.Фабрика"].Коллектор, "порог предка сужает потомку")
		.Равно(УровниЛога.Ошибка);
	Ожидаем.Что(СПорогом["Подробный.дитя"].Коллектор, "DISABLE — коллектор молчит").Равно(УровниЛога.Отключить);
	Ожидаем.Что(СПорогом["Новый.дитя"].Коллектор, "порог журналу, которого назвал только порог")
		.Равно(УровниЛога.Предупреждение);
	Ожидаем.Что(СПорогом["Прочий"].Коллектор, "общий порог остальным").Равно(УровниЛога.Предупреждение);

КонецПроцедуры

#Область Обвязка

// Один и тот же узел оператора — родным и собранным связкой — в настоящую logos; у каждого
// проверяемого журнала уровень и выходы обязаны совпасть. Родному узлу корень, которого
// оператор не назвал, достаётся умолчанием хаба: INFO и все выходы.
Процедура СверитьСLogos(Знач УзелОператора, Знач ПроверяемыеЧерезЗапятую)

	Проверяемые = СтрРазделить(ПроверяемыеЧерезЗапятую, ",");

	Родной = ПрименитьУзел(СКорнемПоУмолчанию(УзелОператора), ОбъявленияОператора());
	ЖурналыРодного = Журналы(Родной, Проверяемые);

	Связка = Новый УровниЖурнала(ТипыЛовушек()).Связка(ЗаданноеФайлом(УзелОператора));
	Собранный = ПрименитьУзел(Связка.Логи, ЛовушкиВместоКлассов(Связка.СпособыВывода));
	ЖурналыСобранного = Журналы(Собранный, Проверяемые);

	Для Каждого Имя Из Проверяемые Цикл
		Ожидаем.Что(ЖурналыСобранного[Имя], "журнал " + Имя + ": уровень и выходы как у родного узла")
			.Равно(ЖурналыРодного[Имя]);
	КонецЦикла;

КонецПроцедуры

Функция ПрименитьСвязку(Знач Заданное)
	Связка = Новый УровниЖурнала(ТипыЛовушек()).Связка(Заданное);
	Возврат ПрименитьУзел(Связка.Логи, ЛовушкиВместоКлассов(Связка.СпособыВывода));
КонецФункции

// Имя журнала → уровень, выходы кроме коллектора и уровень, с которого пишет коллектор
// (Неопределено — коллектора у журнала нет), — по способам вывода в logos.
Функция ЖурналыСКоллектором(Знач Префикс, Знач Проверяемые)

	Итог = Новый Соответствие();
	Для Каждого Имя Из Проверяемые Цикл
		Лог = Логирование.ПолучитьЛог(Префикс + Имя);
		Выходы = Новый Массив();
		Коллектор = Неопределено;
		Для Каждого Способ Из Лог.СпособыВывода() Цикл
			Выход = ЛогическоеИмя(Способ.СпособВывода);
			Если Выход = "otel" Тогда
				Коллектор = ?(Способ.ЗаданЯвно, Способ.Уровень, Лог.Уровень());
			ИначеЕсли Выходы.Найти(Выход) = Неопределено Тогда
				Выходы.Добавить(Выход);
			КонецЕсли;
		КонецЦикла;
		Итог.Вставить(Имя, Новый Структура("Уровень, Выходы, Коллектор", Лог.Уровень(),
			СтрСоединить(Упорядоченные(Выходы), ","), Коллектор));
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция ИзОкружения(Знач Значение)
	Возврат Новый Структура("Значение, Откуда, ИмяНастройки, Название", Значение, "окружение", "ПРОБА", "ПРОБА");
КонецФункции

// Применяет узел так же, как его применяет заготовка autumn-logos, и возвращает префикс имён,
// под которым журналы этого применения создаются впервые.
Функция ПрименитьУзел(Знач Логгеры, Знач Аппендеры)
	Префикс = СледующийПрефикс();
	Заготовка = Новый ИнициализацияФабрикиЛогов(С_Префиксом(Логгеры, Префикс), Аппендеры);
	Заготовка.ПриИнициализацииПоделки(Неопределено);
	Возврат Префикс;
КонецФункции

// Имя журнала → "УРОВЕНЬ: выходы" по его способам вывода в logos.
Функция Журналы(Знач Префикс, Знач Проверяемые)

	Итог = Новый Соответствие();
	Для Каждого Имя Из Проверяемые Цикл
		Лог = Логирование.ПолучитьЛог(Префикс + Имя);
		Выходы = Новый Массив();
		Для Каждого Способ Из Лог.СпособыВывода() Цикл
			Выход = ЛогическоеИмя(Способ.СпособВывода);
			Если Выходы.Найти(Выход) = Неопределено Тогда
				Выходы.Добавить(Выход);
			КонецЕсли;
		КонецЦикла;
		Итог.Вставить(Имя, СтрШаблон("%1: %2", Лог.Уровень(), СтрСоединить(Упорядоченные(Выходы), ",")));
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Способы вывода logos держит по имени на весь процесс: имя найденного и есть выход.
Функция ЛогическоеИмя(Знач СпособВывода)
	Для Каждого Выход Из СтрРазделить("console,memory,otel,otel-info,otel-warn,otel-error,otel-criticalerror,"
		+ "otel-disable", ",") Цикл
		Если Логирование.НайтиСпособВыводаПоИмени(Выход) = СпособВывода Тогда
			Возврат Лев(Выход, ?(СтрНайти(Выход, "-") > 0, СтрНайти(Выход, "-") - 1, СтрДлина(Выход)));
		КонецЕсли;
	КонецЦикла;
	Возврат Строка(ТипЗнч(СпособВывода));
КонецФункции

Функция Упорядоченные(Знач Выходы)
	Итог = Новый Массив();
	Для Каждого Имя Из СтрРазделить("console,memory,otel", ",") Цикл
		Если Выходы.Найти(Имя) <> Неопределено Тогда
			Итог.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Хаб объявляет свои выходы с level DEFAULT; оператор их не объявляет, а только называет.
Функция ОбъявленияОператора()
	Узел = Новый Соответствие();
	Для Каждого Выход Из ТипыЛовушек() Цикл
		Описание = Новый Соответствие();
		Описание.Вставить("type", Выход.Значение);
		Описание.Вставить("level", "DEFAULT");
		Узел.Вставить(Выход.Ключ, Описание);
	КонецЦикла;
	Возврат Узел;
КонецФункции

Функция ТипыЛовушек()
	Типы = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить("console,memory,otel", ",") Цикл
		Типы.Вставить(Имя, "ЛовушкаЛога");
	КонецЦикла;
	Возврат Типы;
КонецФункции

Функция ЛовушкиВместоКлассов(Знач СпособыВывода)
	Итог = Новый Соответствие();
	Для Каждого Способ Из СпособыВывода Цикл
		Описание = Новый Соответствие();
		Для Каждого Опция Из Способ.Значение Цикл
			Описание.Вставить(Опция.Ключ, ?(Опция.Ключ = "type", "ЛовушкаЛога", Опция.Значение));
		КонецЦикла;
		Итог.Вставить(Способ.Ключ, Описание);
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция ЗаданноеФайлом(Знач Узел)
	Файл = Новый Структура("Узел", Новый Структура("Значение, Откуда, ИмяНастройки, Название",
		Узел, "файл", "logos.logger", "logos.logger файла настроек"));
	Возврат Новый Структура("Программно, Окружение, Файл", Новый Структура(), Новый Структура(), Файл);
КонецФункции

Функция Опции(Знач Уровень, Знач Выходы, Знач Добавочно = Неопределено)
	Настройка = Новый Соответствие();
	Если ЗначениеЗаполнено(Уровень) Тогда
		Настройка.Вставить("level", Уровень);
	КонецЕсли;
	Настройка.Вставить("appenders", Выходы);
	Если Добавочно <> Неопределено Тогда
		Настройка.Вставить("additivity", Добавочно);
	КонецЕсли;
	Возврат Настройка;
КонецФункции

// Префикс у каждого имени, кроме корня: logos настраивает журнал один раз, при создании.
Функция С_Префиксом(Знач Узел, Знач Префикс)
	Итог = Новый Соответствие();
	Для Каждого Элемент Из Узел Цикл
		Итог.Вставить(?(Элемент.Ключ = "rootLogger", Элемент.Ключ, Префикс + Элемент.Ключ), Элемент.Значение);
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция СКорнемПоУмолчанию(Знач Узел)

	Итог = Новый Соответствие();
	Для Каждого Элемент Из Узел Цикл
		Итог.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Корень = Итог.Получить("rootLogger");
	Если Корень = Неопределено Тогда
		Корень = Опции("INFO", "console,memory,otel");
	ИначеЕсли ТипЗнч(Корень) = Тип("Строка") Тогда
		Корень = Опции(Корень, "console,memory,otel");
	КонецЕсли;
	Итог.Вставить("rootLogger", Корень);
	Возврат Итог;

КонецФункции

Функция СледующийПрефикс()
	Сценарий = Сценарий + 1;
	Возврат "сверка" + Формат(Сценарий, "ЧГ=0") + ".";
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
