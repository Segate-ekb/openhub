// Юнит-тесты конфигурации хаба: значения по умолчанию, приведение строк из окружения,
// деградация некорректных значений.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	ПутьККлассу = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("запуск", "Классы", "КонфигурацияХаба.os"));

	ПоискКлассов.ПодключитьФайл(ПутьККлассу);

КонецПроцедуры

&Тест
Процедура ЗначенияПоУмолчанию() Экспорт

	Конфигурация = Новый КонфигурацияХаба(, , ЛогТестов());

	Ожидаем.Что(Конфигурация.Порт()).Равно(3333);
	Ожидаем.Что(Конфигурация.Порт()).Равно(Конфигурация.ПортПоУмолчанию());

КонецПроцедуры

&Тест
Процедура КаталогДанныхПоУмолчаниюАбсолютныйИУказываетНаData() Экспорт

	Конфигурация = Новый КонфигурацияХаба(, , ЛогТестов());
	КаталогДанных = Конфигурация.КаталогДанных();

	Ожидаем.Что(Новый Файл(КаталогДанных).ПолноеИмя).Равно(КаталогДанных);
	Ожидаем.Что(Новый Файл(КаталогДанных).Имя).Равно("data");

КонецПроцедуры

&Тест
Процедура СтроковыеЗначенияИзОкруженияПриводятсяКТипам() Экспорт

	КаталогДанных = ОбъединитьПути(КаталогВременныхФайлов(), "openhub-data");

	Конфигурация = Новый КонфигурацияХаба("8080", КаталогДанных, ЛогТестов());

	Ожидаем.Что(Конфигурация.Порт()).Равно(8080);
	Ожидаем.Что(Конфигурация.Порт()).ИмеетТип("Число");
	Ожидаем.Что(Конфигурация.КаталогДанных()).Равно(Новый Файл(КаталогДанных).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ЧисловойПортОстаётсяЧислом() Экспорт

	Конфигурация = Новый КонфигурацияХаба(8081, , ЛогТестов());

	Ожидаем.Что(Конфигурация.Порт()).Равно(8081);

КонецПроцедуры

&Тест
Процедура НеЧисловойПортДеградируетКДефолту() Экспорт

	Конфигурация = Новый КонфигурацияХаба("не-число", , ЛогТестов());

	Ожидаем.Что(Конфигурация.Порт()).Равно(Конфигурация.ПортПоУмолчанию());

КонецПроцедуры

&Тест
Процедура НулевойПортСентинелДаётДефолт() Экспорт

	Конфигурация = Новый КонфигурацияХаба(0, , ЛогТестов());

	Ожидаем.Что(Конфигурация.Порт()).Равно(Конфигурация.ПортПоУмолчанию());

КонецПроцедуры

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.app");
КонецФункции
