// Правило сверки ETag у хаба одно на всех потребителей: страницу, статику, картинки
// бренда, выдачу артефактов и приём байтов от апстрима. Здесь проверяется само правило —
// слабый валидатор, список через запятую, «*», кавычки и регистр.

#Использовать asserts
#Использовать "фикстуры"

Перем Кэш;     // ЗаголовкиКэша — правило сверки
Перем Сверка;  // СверкаETag — тот же разбор метки на скачанных байтах

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Модули = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя, "src", "модули");

	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ЗаголовкиHTTP");
	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ЗаголовкиКэша");
	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ТекстОшибки");
	Поиск.Подключить(ОбъединитьПути(Модули, "прокси", "Классы"), "СверкаETag");

КонецПроцедуры

&ПередКаждым
Процедура ПересоздатьКлассы() Экспорт
	Кэш = Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP());
	Сверка = Новый СверкаETag(Кэш);
КонецПроцедуры

#Область СверкаIfNoneMatch

// Клиент, кэшировавший ответ прокси, переспрашивает его слабым валидатором. Отказ
// признать W/"x" за "x" стоит посетителю полной перекачки тела на каждом заходе.
&Тест
Процедура СлабыйВалидаторКлиентаСовпадаетССильнойМеткойОтвета() Экспорт

	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("W/""abc"""), """abc"""),
		"W/""abc"" совпадает с ""abc""").ЭтоИстина();
	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("w/""abc"""), """abc"""),
		"строчное w/ тоже: отказ из-за регистра стоил бы лишней перекачки").ЭтоИстина();
	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("W/""другая"""), """abc"""),
		"КОНТРОЛЬ: чужая слабая метка не совпадает").ЭтоЛожь();

КонецПроцедуры

// Кэш держит несколько представлений одного адреса и присылает их списком.
&Тест
Процедура МеткаНаходитсяВСпискеЧерезЗапятую() Экспорт

	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("""чужая"", W/""abc"", ""ещё"""), """abc"""),
		"метка найдена посреди списка").ЭтоИстина();
	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("""чужая"", ""ещё"""), """abc"""),
		"КОНТРОЛЬ: списка без нашей метки мало для 304").ЭтоЛожь();

КонецПроцедуры

// «*» означает «любое представление, какое у тебя есть».
&Тест
Процедура ЗвёздочкаСовпадаетСЛюбойМеткой() Экспорт

	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("*"), """abc"""),
		"одинокая звёздочка совпадает").ЭтоИстина();
	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("""чужая"", *"), """abc"""),
		"и звёздочка в списке — тоже").ЭтоИстина();

КонецПроцедуры

// Тело метки непрозрачно: кавычки — запись, а не часть значения; регистр — часть.
&Тест
Процедура ТелоМеткиСличаетсяБезКавычекНоСУчётомРегистра() Экспорт

	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("abc"), """abc"""),
		"метка без кавычек сличается по телу").ЭтоИстина();
	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("""ABC"""), """abc"""),
		"а регистр тела значим: это разные представления").ЭтоЛожь();

КонецПроцедуры

// Ответу без метки сверять нечего: он всегда отдаётся целиком, даже на «*».
&Тест
Процедура ОтветБезМеткиОтдаётсяЦеликом() Экспорт

	Ожидаем.Что(Кэш.СовпадаетETag(ЕслиНеСовпадает("*"), ""),
		"пустая метка ответа не совпадает даже со звёздочкой").ЭтоЛожь();
	Ожидаем.Что(Кэш.СовпадаетETag(Новый Соответствие(), """abc"""),
		"без заголовка If-None-Match сверки нет").ЭтоЛожь();
	Ожидаем.Что(Кэш.СовпадаетETag(Неопределено, """abc"""),
		"и на пустой коллекции заголовков тоже").ЭтоЛожь();

КонецПроцедуры

// Заголовок ищется без учёта регистра имени: клиенты пишут его как угодно.
&Тест
Процедура ИмяЗаголовкаЧитаетсяБезУчётаРегистра() Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("if-none-match", """abc""");

	Ожидаем.Что(Кэш.СовпадаетETag(Заголовки, """abc"""), "if-none-match строчными — тот же заголовок")
		.ЭтоИстина();

КонецПроцедуры

// Метка ответа собирается той же парой: Метка() тело оборачивает, ТелоМетки() снимает.
&Тест
Процедура МеткаСобираетсяИРазбираетсяОднойПарой() Экспорт

	Ожидаем.Что(Кэш.Метка("abc"), "сильный валидатор — тело в кавычках").Равно("""abc""");
	Ожидаем.Что(Кэш.ТелоМетки(Кэш.Метка("abc")), "разбор возвращает исходное тело").Равно("abc");
	Ожидаем.Что(Кэш.ТелоМетки("W/""abc"""), "и снимает признак слабого валидатора").Равно("abc");
	Ожидаем.Что(Кэш.Метка(""), "пустого отпечатка метки нет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СверкаСкачанныхБайтов

// Апстрим отдаёт sha256 меткой — в том числе слабой и заглавными буквами. Разбор у неё
// тот же: иначе хаб принял бы подменённые байты, посчитав метку «несверяемой».
&Тест
Процедура СуммаАпстримаУзнаётсяВЛюбойЗаписиМетки() Экспорт

	Данные = ПолучитьДвоичныеДанныеИзСтроки("тело артефакта");
	Сумма = Sha256(Данные);
	Чужая = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";

	Ожидаем.Что(Сверка.Совпадает(Данные, """" + Сумма + """"), "сильная метка сверяется").ЭтоИстина();
	Ожидаем.Что(Сверка.Совпадает(Данные, "W/""" + Сумма + """"), "слабая — тоже").ЭтоИстина();
	Ожидаем.Что(Сверка.Совпадает(Данные, """" + ВРег(Сумма) + """"), "и записанная заглавными")
		.ЭтоИстина();

	Ожидаем.Что(Сверка.Совпадает(Данные, "W/""" + Чужая + """"),
		"чужая сумма в слабой метке отвергается, а не принимается как несверяемая").ЭтоЛожь();

КонецПроцедуры

// Не всякий апстрим считает ETag от содержимого: произвольную метку сверить нечем,
// и загрузка принимается — усечённый архив всё равно не разберётся манифестом.
&Тест
Процедура ПроизвольнаяМеткаСверкеНеПоддаётся() Экспорт

	Данные = ПолучитьДвоичныеДанныеИзСтроки("тело артефакта");

	Ожидаем.Что(Сверка.Совпадает(Данные, """5f8-1a2b3c"""), "метка веб-сервера сверке не поддаётся")
		.ЭтоИстина();
	Ожидаем.Что(Сверка.Совпадает(Данные, ""), "и пустая метка тоже").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕслиНеСовпадает(Знач Значение)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("If-None-Match", Значение);
	Возврат Заголовки;
КонецФункции

Функция Sha256(Знач Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

#КонецОбласти
