// Живой хаб против фейкового коллектора: точечный DEBUG одному компоненту не роняет его
// запросы, не печатает строки дважды и не уезжает в коллектор от чужих логов, лог
// с выключенной отправкой в коллектор молчит только там — консоль его печатает, а порог,
// названный потомку приглушённого журнала, не возвращает потомку консоль.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент;
Перем Коллектор;
Перем Разбор;     // РазборOTLP — записи журнала значениями
Перем КукаRoot;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");
	РеестрФикстур.Подключить("РазборOTLP");

	Разбор = Новый РазборOTLP();
	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);
	Хаб.ФайловаяБаза("openhub-журнал-точечный");
	Хаб.Среда("OTEL_ENABLED", "true");
	Хаб.Среда("OTEL_SERVICE_NAME", Служба());
	Хаб.Среда("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Хаб.Среда("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	// контроллер настроек внедряет лог один раз — на этой форме точечный уровень ронял запросы;
	// готовность — дважды, на ней строки печатались два раза; веб-сервер winow приглушён
	// предком, а порог назван его потомку
	Хаб.Среда("OSHUB_LOG_LEVELS", ОтлаживаемыйКонтроллер() + "=DEBUG," + БезКоллектора() + "=DEBUG,"
		+ ПредокФабрики() + "=WARN");
	Хаб.Среда("OSHUB_LOG_OTEL_LEVELS", БезКоллектора() + "=DISABLE," + ФабрикаВебСерверов() + "=ERROR");
	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));

	Хаб.Запустить();

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;

КонецПроцедуры

// Точечный DEBUG классу с одним внедрением лога давал HTTP 500 на каждый его запрос,
// а классу с двумя — каждую строку дважды.
&Тест
Процедура ТочечныйУровеньНеРоняетЗапросИНеПечатаетДважды() Экспорт

	Было = СтрокКонсоли("Настройки хаба API: раздел");
	Для Счёт = 1 По 3 Цикл
		Ответ = Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
		Ожидаем.Что(Ответ.КодСостояния, "настройки отвечают при поднятой отладке контроллера").Равно(200);
	КонецЦикла;

	Ожидаем.Что(СтрокКонсоли("Настройки хаба API: раздел") - Было,
		"по строке отладки контроллера на запрос, без дублей").Равно(3);

	Заявки = СтрокиКонсоли("Готовность: заявлен гейт");
	Ожидаем.Что(Заявки.Количество() > 0, "отладка готовности напечатана").ЭтоИстина();
	Для Каждого Заявка Из Заявки Цикл
		Ожидаем.Что(СтрокКонсоли(Заявка), "строка не задвоена: " + Заявка).Равно(1);
	КонецЦикла;

КонецПроцедуры

// Отладка, поднятая одному контроллеру, уезжает в коллектор только от него: чужие логи
// своей отладки не открывают.
&Тест
Процедура ТочечнаяОтладкаНеУезжаетВКоллекторОтЧужихЛогов() Экспорт

	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Коллектор.ДождатьсяПартии("logs", "Настройки хаба API: раздел");

	ОтладкаКонтроллера = 0;
	Чужие = Новый Массив();
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Уровень > УровеньDEBUG() Тогда
			Продолжить;
		ИначеЕсли Запись.Лог = ОтлаживаемыйКонтроллер() Тогда
			ОтладкаКонтроллера = ОтладкаКонтроллера + 1;
		Иначе
			Чужие.Добавить(Запись.Лог + ": " + Запись.Текст);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(ОтладкаКонтроллера > 0, "отладка контроллера уехала").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Чужие, Символы.ПС), "чужой отладки в коллекторе нет").Равно("");

КонецПроцедуры

// Лог с выключенной отправкой в коллектор молчит только там: его строки есть в консоли,
// а коллектор получает строки остальных логов.
&Тест
Процедура ЛогБезОтправкиВКоллекторМолчитАКонсольПишет() Экспорт

	Коллектор.ДождатьсяПартии("logs", Хаб.МаркерЗавершенияСтарта());

	Ожидаем.Что(СтрокКонсоли("Стартовая задача") > 0, "консоль печатает строки лога").ЭтоИстина();

	ОтЛога = 0;
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Лог = БезКоллектора() Тогда
			ОтЛога = ОтЛога + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ОтЛога, "в коллектор от лога не уехало ничего").Равно(0);
	Ожидаем.Что(ЗаписиСлужбы().Количество() > 0, "а от остальных логов — уезжает").ЭтоИстина();

КонецПроцедуры

// Порог коллектора, названный потомку приглушённого журнала, не возвращает потомку консоль:
// фабрика веб-серверов winow живёт на уровне предка, и её строка сведений не печатается —
// ни в консоль, ни в коллектор.
&Тест
Процедура ПорогПотомкуНеВозвращаетЕмуКонсоль() Экспорт

	Коллектор.ДождатьсяПартии("logs", Хаб.МаркерЗавершенияСтарта());

	Ожидаем.Что(СтрокКонсоли("Используется нативный веб-сервер"), "сведения фабрики в консоли").Равно(0);

	ОтФабрики = 0;
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Лог = ФабрикаВебСерверов() Тогда
			ОтФабрики = ОтФабрики + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ОтФабрики, "и в коллекторе").Равно(0);

КонецПроцедуры

#Область Обвязка

Функция Служба()
	Возврат "openhub-журнал-точечный";
КонецФункции

Функция ОтлаживаемыйКонтроллер()
	Возврат "КонтроллерНастроекХабаAPI";
КонецФункции

Функция БезКоллектора()
	Возврат "ГотовностьХаба";
КонецФункции

Функция ПредокФабрики()
	Возврат "oscript.lib.winow";
КонецФункции

// Без настроек печатает при старте «Используется нативный веб-сервер» уровнем сведений.
Функция ФабрикаВебСерверов()
	Возврат "oscript.lib.winow.ФабрикаВебСерверов";
КонецФункции

// severityNumber OTel для DEBUG — от 5 до 8.
Функция УровеньDEBUG()
	Возврат 8;
КонецФункции

Функция ЗаписиСлужбы()
	Результат = Новый Массив();
	Для Каждого Запись Из Разбор.ЗаписиЖурнала(Коллектор.Принятое("logs")) Цикл
		Если Запись.Служба = Служба() Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Строки консоли хаба с фрагментом — каждая целиком.
Функция СтрокиКонсоли(Знач Фрагмент)
	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Хаб.Дамп(), Символы.ПС, Ложь) Цикл
		Если СтрНайти(Строка_, Фрагмент) > 0 Тогда
			Результат.Добавить(СокрЛП(Строка_));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтрокКонсоли(Знач Фрагмент)
	Возврат СтрокиКонсоли(Фрагмент).Количество();
КонецФункции

#КонецОбласти
