// Самотест фикстуры СчётчикОбращений: на ней стоят сторожа N+1 двух десятков наборов,
// и счётчик, который считает не то, делает их зелёными на выпотрошенном продукте.

#Использовать asserts
#Использовать "фикстуры"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("СчётчикОбращений");
КонецПроцедуры

&Тест
Процедура НовыйСчётчикПуст() Экспорт

	Счётчик = Новый СчётчикОбращений();

	Ожидаем.Что(Счётчик.Обращений(), "обращений").Равно(0);
	Ожидаем.Что(Счётчик.Строк(), "строк").Равно(0);
	Ожидаем.Что(Счётчик.ОбращенийВ("любая"), "дверь, в которую не заходили").Равно(0);

КонецПроцедуры

&Тест
Процедура КаждаяОтметкаВидна() Экспорт

	Счётчик = Новый СчётчикОбращений();

	Счётчик.Отметить();
	Счётчик.Отметить();
	Счётчик.Отметить();

	Ожидаем.Что(Счётчик.Обращений(), "три отметки").Равно(3);

КонецПроцедуры

// Общий счёт и счёт по двери — не одно и то же число: набор смотрит то на «сколько
// всего спросили», то на «через какую дверь пошли».
&Тест
Процедура ОтметкаСДверьюСчитаетсяИВОбщийСчёт() Экспорт

	Счётчик = Новый СчётчикОбращений();

	Счётчик.Отметить("НаОдинПакет");
	Счётчик.Отметить("НаОдинПакет");
	Счётчик.Отметить("Разрезом");
	Счётчик.Отметить();

	Ожидаем.Что(Счётчик.Обращений(), "всего обращений").Равно(4);
	Ожидаем.Что(Счётчик.ОбращенийВ("НаОдинПакет"), "дверь на один пакет").Равно(2);
	Ожидаем.Что(Счётчик.ОбращенийВ("Разрезом"), "дверь разрезом").Равно(1);
	Ожидаем.Что(Счётчик.ОбращенийВ("Безымянная"), "безымянная отметка двери не завела")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ВыдачаСчитаетИЗапросИСтроки() Экспорт

	Счётчик = Новый СчётчикОбращений();

	Отданное = Счётчик.Отдать(ТриСтроки());

	Ожидаем.Что(Счётчик.Обращений(), "один запрос").Равно(1);
	Ожидаем.Что(Счётчик.Строк(), "три строки").Равно(3);
	Ожидаем.Что(Отданное.Количество(), "выдача возвращается вызывающему как есть").Равно(3);

КонецПроцедуры

// Пустая выдача — это состоявшийся запрос: сторож N+1 считает походы в базу,
// а не удачи. Счёт запросов обязан вырасти, счёт строк — нет.
&Тест
Процедура ПустаяВыдачаОстаётсяЗапросом() Экспорт

	Счётчик = Новый СчётчикОбращений();

	Счётчик.Отдать(Новый Массив());

	Ожидаем.Что(Счётчик.Обращений(), "запрос состоялся").Равно(1);
	Ожидаем.Что(Счётчик.Строк(), "строк не прочитано").Равно(0);

КонецПроцедуры

&Тест
Процедура ПоискБезНаходкиСчитаетсяЗапросомБезСтрок() Экспорт

	Счётчик = Новый СчётчикОбращений();

	Найденное = Счётчик.ОтдатьОдну(Неопределено);
	Счётчик.ОтдатьОдну(Новый Структура("Идентификатор", 1));

	Ожидаем.Что(Найденное, "ненайденное возвращается как есть").ЭтоНеопределено();
	Ожидаем.Что(Счётчик.Обращений(), "два запроса").Равно(2);
	Ожидаем.Что(Счётчик.Строк(), "прочитана одна строка").Равно(1);

КонецПроцедуры

&Тест
Процедура СчётПоДверямЧитаетсяСтруктурой() Экспорт

	Счётчик = Новый СчётчикОбращений();
	Счётчик.Отметить("КаналыПакета");
	Счётчик.Отметить("КаналыПакета");
	Счётчик.Отдать(ТриСтроки(), "ТегиПакета");

	Двери = Счётчик.ПоДверям("КаналыПакета, ТегиПакета, ВерсияТега");

	Ожидаем.Что(Двери.КаналыПакета, "каналы пакета").Равно(2);
	Ожидаем.Что(Двери.ТегиПакета, "теги пакета").Равно(1);
	Ожидаем.Что(Двери.ВерсияТега, "дверь без обращений — ноль, а не отсутствие поля")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ОбнулениеСноситВесьСчётВключаяДвери() Экспорт

	Счётчик = Новый СчётчикОбращений();
	Счётчик.Отдать(ТриСтроки(), "Разрезом");

	Счётчик.Обнулить();

	Ожидаем.Что(Счётчик.Обращений(), "обращений после обнуления").Равно(0);
	Ожидаем.Что(Счётчик.Строк(), "строк после обнуления").Равно(0);
	Ожидаем.Что(Счётчик.ОбращенийВ("Разрезом"), "дверь после обнуления").Равно(0);

КонецПроцедуры

// Два счётчика в одном наборе — обычное дело: два хранилища, два сторожа. Общего
// состояния у них быть не должно, иначе замер одного считает обращения другого.
&Тест
Процедура ДваСчётчикаНеВидятДругДруга() Экспорт

	Первый = Новый СчётчикОбращений();
	Второй = Новый СчётчикОбращений();

	Первый.Отметить("Дверь");

	Ожидаем.Что(Второй.Обращений(), "соседний счётчик не тронут").Равно(0);
	Ожидаем.Что(Второй.ОбращенийВ("Дверь"), "и его дверь тоже").Равно(0);

КонецПроцедуры

Функция ТриСтроки()

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Идентификатор", 1));
	Строки.Добавить(Новый Структура("Идентификатор", 2));
	Строки.Добавить(Новый Структура("Идентификатор", 3));

	Возврат Строки;

КонецФункции
