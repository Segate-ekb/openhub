// Издатель событий, который никому ничего не рассылает, а только считает публикации:
// им проверяется, ушёл ли след зеркала наружу.

Перем События; // Массив из Структура(Тип, Данные)

// Контракт ИздателяСобытий: тип события о законченном обходе зеркала.
//
// Возвращаемое значение:
//  Строка - "зеркало.синхронизировано".
//
Функция ТипЗеркалоСинхронизировано() Экспорт
	Возврат "зеркало.синхронизировано";
КонецФункции

// Контракт ИздателяСобытий: запоминает событие, никому его не рассылая.
//
// Параметры:
//  ТипСобытия - Строка - тип события.
//  Данные - Структура - полезная нагрузка (необязательный, по умолчанию Неопределено).
//  Момент - Дата - момент события; шпиону не нужен (необязательный, по умолчанию Неопределено).
//
Процедура Опубликовать(Знач ТипСобытия, Знач Данные = Неопределено, Знач Момент = Неопределено) Экспорт
	События.Добавить(Новый Структура("Тип, Данные", ТипСобытия, Данные));
КонецПроцедуры

// Сколько событий опубликовано.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат События.Количество();
КонецФункции

Процедура ПриСозданииОбъекта()
	События = Новый Массив();
КонецПроцедуры
