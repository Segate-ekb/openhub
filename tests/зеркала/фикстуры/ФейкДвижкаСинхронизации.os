// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:InvalidCharacterInFile-off
// BSLLS:YoLetterUsage-off
// Фейк движка синхронизации зеркал: считает вызовы, отдаёт ЕстьЕще заданное число раз,
// умеет падать и умеет вернуть итог вовсе без поля ЕстьЕще.

Перем Счетчик;   // СчётчикОбращений — счёт вызовов движка
Перем ОсталосьЕщё;
Перем Падать;
Перем СПолемЕстьЕщё;
Перем ЗеркалаВызовов;

// Итог одного цикла синхронизации — контракт СинхронизатораЗеркал.
//
// Параметры:
//  Зеркало - Структура - запись зеркала.
//
// Возвращаемое значение:
//  Структура - Всего, Скачано, Пропущено, Ошибок, Offline, Статус и (если не отключено)
//  ЕстьЕще.
//
Функция Синхронизировать(Знач Зеркало) Экспорт

	Счетчик.Отметить();
	ЗеркалаВызовов.Добавить(Цел(Зеркало.Идентификатор));

	Если Падать Тогда
		ВызватьИсключение "фейк движка: сбой синхронизации зеркала";
	КонецЕсли;

	Итог = Новый Структура("Всего, Скачано, Пропущено, Ошибок, Offline, Статус",
		1, 1, 0, 0, Ложь, "синк ок");
	Если СПолемЕстьЕщё Тогда
		Итог.Вставить("ЕстьЕще", ОсталосьЕщё > 0);
	КонецЕсли;
	ОсталосьЕщё = ОсталосьЕщё - 1;
	Возврат Итог;

КонецФункции

// Сколько раз подряд итог скажет «в апстриме осталось непройденное».
//
// Параметры:
//  Сколько - Число - число циклов с ЕстьЕще = Истина.
//
Процедура ОтдаватьЕстьЕщё(Знач Сколько) Экспорт
	ОсталосьЕщё = Сколько;
КонецПроцедуры

// Дальше каждый вызов Синхронизировать бросает исключение.
//
Процедура Ронять() Экспорт
	Падать = Истина;
КонецПроцедуры

// Итог возвращается без поля ЕстьЕще — движок, который о порциях не знает.
//
Процедура БезПоляЕстьЕщё() Экспорт
	СПолемЕстьЕщё = Ложь;
КонецПроцедуры

// Сколько раз движок был вызван.
//
// Возвращаемое значение:
//  Число - вызовов.
//
Функция Вызовов() Экспорт
	Возврат Счетчик.Обращений();
КонецФункции

// Идентификаторы зеркал в порядке вызовов.
//
// Возвращаемое значение:
//  Массив из Число
//
Функция Зеркала() Экспорт
	Возврат ЗеркалаВызовов;
КонецФункции

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счетчик = Новый СчётчикОбращений();
	ОсталосьЕщё = 0;
	Падать = Ложь;
	СПолемЕстьЕщё = Истина;
	ЗеркалаВызовов = Новый Массив();
КонецПроцедуры
