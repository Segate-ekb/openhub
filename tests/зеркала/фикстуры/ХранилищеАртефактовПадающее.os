// Хранилище артефактов, отказывающее машинным кодом errors, как лежащий S3: падает сохранение,
// чтение размера либо вопрос о наличии; иначе «существует» отвечает тем, что велел набор.

#Использовать errors

Перем ПадаетСохранение_;
Перем ПадаетРазмер_;
Перем Существует_;
Перем ПадаетНаличие_;

#Область КонтрактХранилищаАртефактов

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Булево.
//
Функция Существует(Знач Координаты) Экспорт

	Если ПадаетНаличие_ Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна("s3://проба",
			"Хранилище артефактов не ответило о наличии объекта");
	КонецЕсли;
	Возврат Существует_;

КонецФункции

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//  Путь - Строка - путь к файлу.
//
// Возвращаемое значение:
//  Структура - Размер, Sha256.
//
Функция Сохранить(Знач Координаты, Знач Путь) Экспорт

	Если ПадаетСохранение_ Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна("s3://проба",
			"Хранилище артефактов не приняло объект: соединение отклонено");
	КонецЕсли;
	Возврат Новый Структура("Размер, Sha256", 1, "");

КонецФункции

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Число.
//
Функция Размер(Знач Координаты) Экспорт

	Если ПадаетРазмер_ Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна("s3://проба",
			"Хранилище артефактов не ответило о размере объекта");
	КонецЕсли;
	Возврат 1;

КонецФункции

// Контракт ХранилищаАртефактов: чтение лежащего артефакта.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Строка - путь к файлу.
//
Функция Получить(Знач Координаты) Экспорт
	ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна("s3://проба",
		"Хранилище артефактов не отдало объект");
КонецФункции

// Контракт ХранилищаАртефактов: удаление; фикстуре удалять нечего.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
Процедура Удалить(Знач Координаты) Экспорт
КонецПроцедуры

#КонецОбласти

#Область ЧтоЗадаётНабор

// Хранилище не принимает: так выглядит лежащий S3 на записи.
//
Процедура ЛоматьСохранение() Экспорт
	ПадаетСохранение_ = Истина;
КонецПроцедуры

// Хранилище не отвечает на вопрос о наличии: так выглядит лежащий S3 при укладке.
//
Процедура ЛоматьНаличие() Экспорт
	ПадаетНаличие_ = Истина;
КонецПроцедуры

// Артефакт числится лежащим, а размер его прочитать нечем: так срывается индексация
// уже сохранённого артефакта.
//
Процедура ЛоматьРазмерЛежащего() Экспорт
	Существует_ = Истина;
	ПадаетРазмер_ = Истина;
КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта()
	ПадаетСохранение_ = Ложь;
	ПадаетРазмер_ = Ложь;
	Существует_ = Ложь;
	ПадаетНаличие_ = Ложь;
КонецПроцедуры
