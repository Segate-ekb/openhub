// Снимки пула в объёме рабочего очереди: считает, сколько раз опись забывали.

Перем Забыто_;

#Область КонтрактСнимковПула

// Контракт СнимкиПула: забыть опись обхода.
//
Процедура ЗабытьОпись() Экспорт
	Забыто_ = Забыто_ + 1;
КонецПроцедуры

#КонецОбласти

#Область Счётчики

// Сколько раз опись забывали.
//
// Возвращаемое значение:
//  Число.
//
Функция Забыто() Экспорт
	Возврат Забыто_;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Забыто_ = 0;
КонецПроцедуры
