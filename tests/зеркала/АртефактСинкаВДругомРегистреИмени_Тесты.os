// Синк зеркала в пул, который знает пакет в другом регистре, на регистрозависимом хранилище: S3 над
// фейком корзины различает ключи по регистру, как S3 и диск Linux. Источник — фейковый клиент апстрима;
// контейнер ОСени на КоннекторInMemory; отдельный процесс.

#Использовать asserts
#Использовать autumn-cache
#Использовать "../фикстуры"

Перем Выдача;         // фикстура СтендВыдачи — контейнер, хранилище на фейке S3, маршрут выдачи
Перем Зеркала;        // фикстура СтендЗеркал — строка зеркала пула
Перем КореньСборки;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("СтендВыдачи");
	РеестрФикстур.Подключить("СтендЗеркал");
	РеестрФикстур.Подключить("ФейкКлиентАпстрима");
	РеестрФикстур.Подключить("ФейкСервисаЗеркал");
	РеестрФикстур.Подключить("ФикстураПакета");

	КореньСборки = УникальныеИмена.ВременныйКаталог("oshub-sync-case");

	Выдача = Новый СтендВыдачи(Новый Соответствие(), "синк-регистр-тесты",
		"почта, уведомления, вход, права, публикация, статистика, зеркала");
	Зеркала = Новый СтендЗеркал(Выдача.Поделка());

КонецПроцедуры

&ПослеВсех
Процедура УбратьСборку() Экспорт
	УникальныеИмена.УбратьВременное(КореньСборки);
КонецПроцедуры

// Ради чего всё: пакет в пуле назван MyPkg, источник называет его mypkg — привезённую синком версию
// `opm install` скачивает по номеру и как последнюю, а файл лежит под именем из реестра.
&Тест
Процедура ПривезённаяВерсияСкачивается() Экспорт

	Сцена = Сцена();

	Итог = Синхронизатор(Сцена.Клиент).Синхронизировать(Сцена.Зеркало);
	Ожидаем.Что(Итог.Скачано, "самотест: синк привёз версию").Равно(1);
	Ожидаем.Что(Пакет(Сцена).Имя, "самотест: имя в реестре осталось прежним").Равно(Сцена.Имя);

	Ожидаем.Что(Скачать(Сцена, Сцена.Имя + "-1.0.0.ospx").Код,
		"привезённая версия скачивается по номеру").Равно(200);
	Ожидаем.Что(Скачать(Сцена, Сцена.Имя + ".ospx").Код, "и как последняя").Равно(200);
	Ожидаем.Что(ЛежащиеOspx(Сцена), "в корзине — файл под именем из реестра")
		.Равно(СтрШаблон("%1/%1-1.0.0.ospx", Сцена.Имя));

КонецПроцедуры

// Следующий обход видит привезённое и источник заново не качает.
&Тест
Процедура ПовторныйОбходНеКачаетПривезённое() Экспорт

	Сцена = Сцена();
	Синх = Синхронизатор(Сцена.Клиент);
	Синх.Синхронизировать(Сцена.Зеркало);
	СкачиванийЗаПервый = Сцена.Клиент.КоличествоСкачиваний();

	Синх.Синхронизировать(Сцена.Зеркало);

	Ожидаем.Что(СкачиванийЗаПервый, "самотест: первый обход качал").Равно(1);
	Ожидаем.Что(Сцена.Клиент.КоличествоСкачиваний() - СкачиванийЗаПервый,
		"второй обход привезённое не качает").Равно(0);
	Ожидаем.Что(ЛежащиеOspx(Сцена), "и второй копии не кладёт").Равно(СтрШаблон("%1/%1-1.0.0.ospx", Сцена.Имя));

КонецПроцедуры

// Уборка пакета снимает файл привезённой версии: в корзине не остаётся .ospx.
&Тест
Процедура УборкаСнимаетПривезённое() Экспорт

	Сцена = Сцена();
	Синхронизатор(Сцена.Клиент).Синхронизировать(Сцена.Зеркало);
	Ожидаем.Что(ЛежащиеOspx(Сцена), "самотест: файл лёг").Заполнено();

	Выдача.Желудь("УборкаПакета").УдалитьПакет(Пакет(Сцена));

	Ожидаем.Что(ЛежащиеOspx(Сцена), "файл привезённой версии снят вместе с пакетом").Равно("");

КонецПроцедуры

#Область Помощники

// Пул знает пакет в смешанном регистре; источник перечисляет его в нижнем и отдаёт .ospx с тем же
// именем в манифесте.
Функция Сцена()

	Пул = Выдача.Засев.ПулСервисом();
	Имя = "MyPkg-" + УникальныеИмена.Хвост();
	Выдача.Засев.ПакетСервисом(Пул, Имя);
	ИмяУИсточника = НРег(Имя);

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Срез(ИмяУИсточника, "1.0.0"));
	Клиент.УстановитьОтветДанные(200,
		Новый ФикстураПакета().ДанныеOspx(КореньСборки, ИмяУИсточника, "1.0.0"));

	Сцена = Новый Структура("Пул, Имя, Клиент", Пул, Имя, Клиент);
	Сцена.Вставить("Зеркало", Зеркала.Зеркало(Пул, "http://upstream.invalid/download/"));
	Возврат Сцена;

КонецФункции

// Синхронизатор контейнера, но с источником на фейковом клиенте: сети в наборе нет.
Функция Синхронизатор(Знач Клиент)

	Источник = Новый ИсточникАпстримаOpenHub(Клиент, Неопределено, Неопределено,
		Выдача.Желудь("КореньАпстрима"), Выдача.Желудь("АллоулистИмён"));

	Возврат Новый СинхронизаторЗеркал(Новый ФейкСервисаЗеркал(), Выдача.Желудь("СервисПулов"),
		Выдача.Желудь("ПереносЭлементаСинка"), Выдача.Желудь("ПрогонЗеркала"),
		Выдача.Желудь("СледЦиклаЗеркала"), Выдача.Желудь("ВалидаторАдресаАпстрима"), Новый Массив(),
		Массив(Источник), Выдача.Желудь("ПриведениеЧисел"), Выдача.Желудь("ЧислаЗеркалирования"),
		Выдача.Желудь("РазборНастроекЗеркала"), Выдача.Желудь("ПроисшествияЗеркала"),
		Выдача.Желудь("КодыПроисшествийЗеркала"), Массив(Выдача.Желудь("СнимкиПула")),
		Логирование.ПолучитьЛог("тест.oshub.синк-регистр"));

КонецФункции

// Срез изменений источника протокола openhub: одна версия одного имени.
Функция Срез(Знач ИмяПакета, Знач Версия)

	Изменения = Новый Массив();
	Изменения.Добавить(Новый Структура("package, version", ИмяПакета,
		Новый Структура("version, yanked", Версия, Ложь)));

	Данные = Новый Структура();
	Данные.Вставить("pool", "upstream");
	Данные.Вставить("as_of", "2026-08-12T10:00:00Z");
	Данные.Вставить("names_total", 1);
	Данные.Вставить("names_before", 0);
	Данные.Вставить("has_more", Ложь);
	Данные.Вставить("next_cursor", "");
	Данные.Вставить("changes", Изменения);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Функция Пакет(Знач Сцена)
	Возврат Выдача.Желудь("СервисПакетов").НайтиПакет(Сцена.Пул.Идентификатор, Сцена.Имя);
КонецФункции

// Маршрут выдачи — тот, к которому ходит opm install: пул, имя из реестра, имя файла в адресе.
Функция Скачать(Знач Сцена, Знач ИмяФайла)
	Возврат Выдача.Выдать(Новый Структура("Пул, Пакет", Сцена.Пул, Пакет(Сцена)), "GET", "", ИмяФайла);
КонецФункции

// Ключи .ospx пула в корзине относительно области пула, по порядку, через запятую.
Функция ЛежащиеOspx(Знач Сцена)

	Префикс = СтрШаблон("pools/%1/", Сцена.Пул.Имя);
	Ключи = Новый СписокЗначений();
	Для Каждого Объект Из Выдача.КлиентS3().Перечислить(Префикс) Цикл
		Если СтрЗаканчиваетсяНа(Объект.Ключ, ".ospx") Тогда
			Ключи.Добавить(Сред(Объект.Ключ, СтрДлина(Префикс) + 1));
		КонецЕсли;
	КонецЦикла;
	Ключи.СортироватьПоЗначению();
	Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");

КонецФункции

Функция Массив(Знач Элемент)
	Результат = Новый Массив();
	Результат.Добавить(Элемент);
	Возврат Результат;
КонецФункции

#КонецОбласти
