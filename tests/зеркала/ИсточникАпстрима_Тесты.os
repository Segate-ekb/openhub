// Общий контракт источника зеркала одним набором на оба протокола: срез изменений OpenHub и легаси-
// список opm. Параметр теста — имя протокола, как его называет Протокол(); клиент апстрима — фейк.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	Модули = КаталогиПроекта.Модули();
	ПоискКлассов.ПодключитьОснову(Модули);
	Подключить(Модули, "прокси", "СекретИсточника,ЗаведениеИсточникаСПробой,РазборВерсийПакета");
	Подключить(Модули, "реестр", "АллоулистИмён,МаскаИмениПакета,СравнительВерсий,РазобраннаяВерсия,"
		+ "РазобранныйДиапазон");
	Подключить(Модули, "зеркала", "КореньАпстрима,РазборСрезаИзменений,ИсточникАпстримаOpenHub,"
		+ "ИсточникАпстримаOpm");
	РеестрФикстур.Подключить("ФейкКлиентАпстрима");
	РеестрФикстур.Подключить("СчётчикОтметок");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("openhub")
&ИсточникЗначение("legacy")
Процедура ИсточникНазываетСвойПротокол(Знач Протокол) Экспорт
	Ожидаем.Что(Источник(Протокол, Новый ФейкКлиентАпстрима()).Протокол()).Равно(Протокол);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("openhub")
&ИсточникЗначение("legacy")
Процедура СкачиваниеИдётПоВерсионномуПути(Знач Протокол) Экспорт

	Клиент = КлиентСПакетами(Протокол, "alfa:1.2.0");
	Клиент.УстановитьОтветДанные(200, ПолучитьДвоичныеДанныеИзСтроки("ospx"));
	Источник_ = Источник(Протокол, Клиент);

	Перечень = Источник_.Перечислить(Зеркало(), 10);
	Источник_.Скачать(Зеркало(), Перечень.Элементы[0]);

	Последний = Клиент.ПутиЗапросов().ВГраница();
	Ожидаем.Что(Клиент.ПутиЗапросов()[Последний], "качается именно версионный артефакт")
		.Равно("alfa/alfa-1.2.0.ospx");
	Ожидаем.Что(Клиент.БазыЗапросов()[Последний], "артефакт берётся у самой выдачи")
		.Равно("http://upstream.invalid/download/");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("openhub")
&ИсточникЗначение("legacy")
Процедура БитыйФильтрFailClosed(Знач Протокол) Экспорт

	Клиент = КлиентСПакетами(Протокол, "alfa:1.0.0|beta:1.0.0");

	Перечень = Источник(Протокол, Клиент).Перечислить(ЗеркалоСФильтром("{битый"), 10);

	Ожидаем.Что(Перечень.Элементы.Количество(), "битый фильтр — пустой набор").Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("openhub")
&ИсточникЗначение("legacy")
Процедура OfflineПеречислениеОтдаётКодНоль(Знач Протокол) Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(0, "");

	Перечень = Источник(Протокол, Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Перечень.Код, "offline — код 0").Равно(0);
	Ожидаем.Что(Перечень.Элементы.Количество(), "offline — пустой набор").Равно(0);
	Ожидаем.Что(Клиент.ПутиЗапросов().Количество(), "после молчания источника запросов больше нет")
		.Равно(1);

КонецПроцедуры

// Токен едет с каждым запросом протокола: и за перечнем, и за самим .ospx.
&ПараметризованныйТест
&ИсточникЗначение("openhub")
&ИсточникЗначение("legacy")
Процедура ТокенЗеркалаЕдетСКаждымЗапросомПротокола(Знач Протокол) Экспорт

	Клиент = КлиентСПакетами(Протокол, "alfa:1.0.0");
	Клиент.УстановитьОтветДанные(200, ПолучитьДвоичныеДанныеИзСтроки("ospx"));
	Приватное = ЗеркалоСТокеном("sekret-42");

	Перечень = Источник(Протокол, Клиент).Перечислить(Приватное, 10);
	Источник(Протокол, Клиент).Скачать(Приватное, Перечень.Элементы[0]);

	Токены = Клиент.ТокеныЗапросов();
	Ожидаем.Что(Токены.Количество(), "перечень и скачивание")
		.Равно(ЗапросовПеречня(Протокол, 1) + 1);
	Для Каждого Токен Из Токены Цикл
		Ожидаем.Что(Токен, "каждый запрос к приватному источнику несёт токен").Равно("sekret-42");
	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("openhub")
&ИсточникЗначение("legacy")
Процедура ЗеркалоБезТокенаЧитаетИсточникАнонимно(Знач Протокол) Экспорт

	Клиент = КлиентСПакетами(Протокол, "alfa:1.0.0");

	Источник(Протокол, Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Клиент.ТокеныЗапросов()[0], "анонимное зеркало токена не несёт").Равно("");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("openhub")
&ИсточникЗначение("legacy")
Процедура ПеречислениеОтмечаетсяНаКаждомИмениПорции(Знач Протокол) Экспорт

	Клиент = КлиентСПакетами(Протокол, "alfa:1.0.0|beta:2.0.0|gamma:3.0.0");
	Отметка = Новый СчётчикОтметок();

	Перечень = Источник(Протокол, Клиент).Перечислить(Зеркало(), 10, "", Отметка);

	Ожидаем.Что(Перечень.Элементы.Количество(), "порция перечислена").Равно(3);
	Ожидаем.Что(Отметка.Шагов(), "отметка на каждом имени порции").Равно(3);
	Ожидаем.Что(СтрСоединить(Отметка.Имена(), ","), "и названы сами имена")
		.Равно("alfa,beta,gamma");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура Подключить(Знач Модули, Знач Модуль, Знач ИменаКлассов)
	Для Каждого ИмяКласса Из СтрРазделить(ИменаКлассов, ",") Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(Модули, Модуль, "Классы"), ИмяКласса);
	КонецЦикла;
КонецПроцедуры

Функция Источник(Знач Протокол, Знач Клиент)

	Корень = Новый КореньАпстрима(Новый РазборАдреса());
	Если Протокол = "openhub" Тогда
		Возврат Новый ИсточникАпстримаOpenHub(Клиент, Неопределено, Неопределено, Корень, Новый АллоулистИмён());
	КонецЕсли;

	Возврат Новый ИсточникАпстримаOpm(Клиент, Новый РазборВерсийПакета(Новый СравнительВерсий()),
		Неопределено, Корень, Новый АллоулистИмён(), Логирование.ПолучитьЛог("тест.oshub.источник-апстрима"));

КонецФункции

// Источник знает пакеты из записи «имя:версия|имя:версия»: у OpenHub это срез изменений,
// у легаси — list.txt и страница каждого пакета.
Функция КлиентСПакетами(Знач Протокол, Знач Состав)

	Клиент = Новый ФейкКлиентАпстрима();

	Если Протокол = "openhub" Тогда
		Клиент.УстановитьОтветТекст(200, СрезИзменений(Состав));
		Возврат Клиент;
	КонецЕсли;

	Имена = Новый Массив();
	Для Каждого Пара Из СтрРазделить(Состав, "|", Ложь) Цикл
		Части = СтрРазделить(Пара, ":", Ложь);
		Имена.Добавить(Части[0]);
		Клиент.УстановитьОтветТекстПоПути("package/" + Части[0], 200, СтраницаПакета(Части[0], Части[1]));
	КонецЦикла;
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, СтрСоединить(Имена, Символы.ПС));
	Возврат Клиент;

КонецФункции

// Сколько запросов стоит перечень порции: срез — один на порцию, легаси — список и страница на имя.
Функция ЗапросовПеречня(Знач Протокол, Знач Имён)
	Возврат ?(Протокол = "openhub", 1, 1 + Имён);
КонецФункции

Функция СрезИзменений(Знач Состав)

	Изменения = Новый Массив();
	Для Каждого Пара Из СтрРазделить(Состав, "|", Ложь) Цикл
		Части = СтрРазделить(Пара, ":", Ложь);
		Изменения.Добавить(Новый Структура("package, version",
			Части[0], Новый Структура("version, yanked", Части[1], Ложь)));
	КонецЦикла;

	Данные = Новый Структура("pool, as_of, names_total, names_before, has_more, next_cursor, changes",
		"main", "2026-08-13T00:00:00Z", СтрРазделить(Состав, "|", Ложь).Количество(), 0, Ложь, "",
		Изменения);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Функция СтраницаПакета(Знач ИмяПакета, Знач Версия)
	Возврат СтрШаблон("<div class=""item""><a class=""header"" href=""/download/%1/%1-%2.ospx"">%2</a></div>",
		ИмяПакета, Версия);
КонецФункции

Функция Зеркало()
	Возврат Новый Структура(
		"АпстримURL, ФильтрJSON, ТокенДоступа, ВычитаноДо, ПрогонСрезС, ПрогонМоментСреза",
		"http://upstream.invalid/download/", "", "", '00010101000000', '00010101000000', '00010101000000');
КонецФункции

Функция ЗеркалоСФильтром(Знач ФильтрJSON)
	Запись = Зеркало();
	Запись.ФильтрJSON = ФильтрJSON;
	Возврат Запись;
КонецФункции

Функция ЗеркалоСТокеном(Знач Токен)
	Запись = Зеркало();
	Запись.ТокенДоступа = Токен;
	Возврат Запись;
КонецФункции

#КонецОбласти
