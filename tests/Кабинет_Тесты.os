// Юнит-тесты кабинета (/office): CSRF-защита, разбор формы, доменные мутации (yank/unyank версий,
// метаданные, видимость и квоты пула) и авторизация управления пакетом. Набор в отдельном процессе.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;     // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;             // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;
Перем Счётчик;
Перем Засев;            // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба
Перем КореньХранилища;  // временный корень файлового хранилища артефактов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();
	Счётчик = 0;

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);
	Слои.ПропускатьТакже("Рендерер");

	Слои.Подключить("данные, реестр");

	// storage: занятое пулом меряется по хранилищу (УчётОбъёмаПула), поэтому реестру
	// нужен бэкенд артефактов — файловый, во временном каталоге набора
	Слои.Подключить("хранилище");
	// файловое хранилище убирает временные файлы желудём основы
	Слои.Подключить("основа");

	// events: core-registry содержит подписчиков доменных событий — контейнеру нужен издатель
	Слои.Подключить("события");

	// SSRF-гейт апстримов: СервисПулов требует валидатор адреса обязательно (fail-closed)
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();
	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"),
			"СобытиеАудита");
	Исключение
	КонецПопытки;
	Слои.Подключить("вход, права");
	// settings: СлужбаСессий и СервисРегистрации читают прикладные настройки у резолвера СервисНастроек
	Слои.Подключить("настройки, интерфейс/настройки, кабинет");
	// машинерия HTML-форм (CSRF, разбор) переехала в интерфейс хаба вместе с экранами
	Слои.Подключить("интерфейс/общее, интерфейс/кабинет");

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-office-unit-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "office-unit-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область CSRF

&Тест
Процедура CSRFТокенСоздаётсяИдемпотентноИПерсистится() Экспорт

	Защита = Желудь("ЗащитаCSRF");
	Сессия = Желудь("СлужбаСессий").Создать(1);

	Токен1 = Защита.ТокенСессии(Сессия);
	Ожидаем.Что(СтрДлина(Токен1)).Равно(64);
	Ожидаем.Что(Защита.ТокенСессии(Сессия)).Равно(Токен1);
	Ожидаем.Что(Сессия.Значение("csrf")).Равно(Токен1);

КонецПроцедуры

&Тест
Процедура CSRFПроверкаОтклоняетНеверныйИОтсутствующий() Экспорт

	Защита = Желудь("ЗащитаCSRF");
	Сессия = Желудь("СлужбаСессий").Создать(2);
	Токен = Защита.ТокенСессии(Сессия);

	Ожидаем.Что(Защита.Проверить(Сессия, Токен), "верный токен принят").ЭтоИстина();
	Ожидаем.Что(Защита.Проверить(Сессия, Токен + "x"), "подделанный токен отклонён").ЭтоЛожь();
	Ожидаем.Что(Защита.Проверить(Сессия, ""), "пустой токен отклонён").ЭтоЛожь();
	Ожидаем.Что(Защита.Проверить(Неопределено, Токен), "без сессии отклонён").ЭтоЛожь();

	Чистая = Желудь("СлужбаСессий").Создать(3);
	Ожидаем.Что(Защита.Проверить(Чистая, "что-угодно"), "нет сохранённого токена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область РазборФормы

&Тест
Процедура РазборФормыДекодируетПоля() Экспорт

	РФ = Желудь("РазборФормы");
	Форма = РФ.Разобрать("a=1&b=hello%20world&c=%D0%9F&_csrf=abc123&plus=x%2By");

	Ожидаем.Что(РФ.Поле(Форма, "a")).Равно("1");
	Ожидаем.Что(РФ.Поле(Форма, "b")).Равно("hello world");
	Ожидаем.Что(РФ.Поле(Форма, "c")).Равно("П");
	Ожидаем.Что(РФ.Поле(Форма, "_csrf")).Равно("abc123");
	Ожидаем.Что(РФ.Поле(Форма, "plus")).Равно("x+y"); // %2B — литеральный плюс
	Ожидаем.Что(РФ.Поле(Форма, "нет", "деф")).Равно("деф");

	// "+" трактуется как пробел (form-urlencoded)
	Форма2 = РФ.Разобрать("x=a+b+c");
	Ожидаем.Что(РФ.Поле(Форма2, "x")).Равно("a b c");

	Ожидаем.Что(РФ.Разобрать("").Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область YankВерсий

&Тест
Процедура YankИсключаетИзВыдачиНоОставляетДоступнойПоТочнойКоординате() Экспорт

	Ключ = УникальныйКлюч();
	Пул = Засев.ПулСервисом("pool-" + Ключ);
	Пакет = Засев.ПакетСервисом(Пул, "pkg-" + Ключ);
	СВ = Желудь("СервисВерсий");
	СВ.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"));
	СВ.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.1.0"));

	Ожидаем.Что(СВ.ПоследняяВерсия(Пакет.Идентификатор).Версия).Равно("1.1.0");

	Ожидаем.Что(СВ.ОтозватьВерсию(Пакет.Идентификатор, "1.1.0", Истина)).ЭтоИстина();

	Ожидаем.Что(СВ.ПоследняяВерсия(Пакет.Идентификатор).Версия).Равно("1.0.0");
	Ожидаем.Что(СодержитВерсию(СВ.ДействующиеВерсии(Пакет.Идентификатор), "1.1.0"),
		"1.1.0 нет среди действующих").ЭтоЛожь();

	Точная = СВ.НайтиВерсию(Пакет.Идентификатор, "1.1.0");
	Ожидаем.Что(Точная <> Неопределено, "точная версия доступна").ЭтоИстина();
	Ожидаем.Что(Точная.Отозвана).ЭтоИстина();

	Ожидаем.Что(СВ.ОтозватьВерсию(Пакет.Идентификатор, "1.1.0", Ложь)).ЭтоИстина();
	Ожидаем.Что(СВ.ПоследняяВерсия(Пакет.Идентификатор).Версия).Равно("1.1.0");

	Ожидаем.Что(СВ.ОтозватьВерсию(Пакет.Идентификатор, "9.9.9", Истина)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область МетаданныеПакета

&Тест
Процедура ОбновлениеМетаданныхЧастичноеИСанитизируетURL() Экспорт

	Ключ = УникальныйКлюч();
	Пул = Засев.ПулСервисом("pool-" + Ключ);
	СПак = Желудь("СервисПакетов");
	Пакет = Засев.ПакетСервисом(Пул, "pkg-" + Ключ,
		Новый Структура("Описание, Лицензия", "исходное", "MIT"));

	СПак.ОбновитьМетаданные(Пакет.Идентификатор, Новый Структура("Описание", "новое описание"));
	Обн = СПак.ПакетПоИдентификатору(Пакет.Идентификатор);
	Ожидаем.Что(Обн.Описание).Равно("новое описание");
	Ожидаем.Что(Обн.Лицензия).Равно("MIT"); // не передавали — не тронуто

	// опасная схема адреса репозитория обнуляется на приёме (вторая линия к выводу)
	СПак.ОбновитьМетаданные(Пакет.Идентификатор, Новый Структура("АдресРепозитория", "javascript:alert(1)"));
	Ожидаем.Что(СПак.ПакетПоИдентификатору(Пакет.Идентификатор).АдресРепозитория).Равно("");

	СПак.ОбновитьМетаданные(Пакет.Идентификатор, Новый Структура("АдресРепозитория", "https://ex.com/repo"));
	Ожидаем.Что(СПак.ПакетПоИдентификатору(Пакет.Идентификатор).АдресРепозитория).Равно("https://ex.com/repo");

	СПак.ОбновитьМетаданные(Пакет.Идентификатор, Новый Структура("Устарел, Скрыт", Истина, Истина));
	Финал = СПак.ПакетПоИдентификатору(Пакет.Идентификатор);
	Ожидаем.Что(Финал.Устарел).ЭтоИстина();
	Ожидаем.Что(Финал.Скрыт).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область АвторизацияУправления

&Тест
Процедура УправлятьМожетАвторИАдминНоНеЧужой() Экспорт

	Ключ = УникальныйКлюч();
	СП = Желудь("СервисПользователей");
	Alice = СП.СоздатьПользователя("alice-" + Ключ, "", "password123", "user");
	Bob = СП.СоздатьПользователя("bob-" + Ключ, "", "password123", "user");
	Admin = СП.СоздатьПользователя("admin-" + Ключ, "", "password123", "admin");

	Пул = Засев.ПулСервисом("pool-" + Ключ);
	Пакет = Засев.ПакетСервисом(Пул, "pkg-" + Ключ);
	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0");
	Заявка.ОпубликовалИдентификатор = Alice.Идентификатор;
	Желудь("СервисВерсий").Опубликовать(Заявка);

	СК = Желудь("СлужбаКабинета");
	Ожидаем.Что(СК.МожетУправлять(Alice, Пул, Пакет), "автор управляет").ЭтоИстина();
	Ожидаем.Что(СК.МожетУправлять(Admin, Пул, Пакет), "админ управляет").ЭтоИстина();
	Ожидаем.Что(СК.МожетУправлять(Bob, Пул, Пакет), "чужой не управляет").ЭтоЛожь();

	Ожидаем.Что(СписокСодержит(СК.ПакетыВУправлении(Alice), Пакет.Идентификатор), "у alice в списке").ЭтоИстина();
	Ожидаем.Что(СписокСодержит(СК.ПакетыВУправлении(Bob), Пакет.Идентификатор), "у bob нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура МейнтейнерУправляетПакетомПоГранулярномуГрантуНаПакет() Экспорт

	// МожетУправлять складывала признак из «админ ИЛИ право на ПУЛ ИЛИ автор версии» и не спрашивала
	// грант на объект «пакет»: мейнтейнер с грантом на ПАКЕТ не видел кнопок настроек и не проходил в дом пакета.
	Ключ = УникальныйКлюч();
	СП = Желудь("СервисПользователей");
	Автор = СП.СоздатьПользователя("owner-" + Ключ, "", "password123", "user");
	Мейнтейнер = СП.СоздатьПользователя("maint-" + Ключ, "", "password123", "user");
	Посторонний = СП.СоздатьПользователя("other-" + Ключ, "", "password123", "user");

	Пул = Засев.ПулСервисом("pool-" + Ключ);
	Пакет = Засев.ПакетСервисом(Пул, "pkg-" + Ключ);
	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0");
	Заявка.ОпубликовалИдентификатор = Автор.Идентификатор;
	Желудь("СервисВерсий").Опубликовать(Заявка);

	СК = Желудь("СлужбаКабинета");
	Ожидаем.Что(СК.МожетУправлять(Мейнтейнер, Пул, Пакет),
		"до выдачи гранта мейнтейнер ничем не отличается от постороннего").ЭтоЛожь();

	Желудь("СервисПравДоступа").ЗафиксироватьГрант("пользователь", Мейнтейнер.Идентификатор,
		Желудь("СервисПрав").ОбъектПакет(Пакет), Новый Структура("изменение", Истина));

	Ожидаем.Что(СК.МожетУправлять(Мейнтейнер, Пул, Пакет),
		"мейнтейнер с грантом на пакет управляет им").ЭтоИстина();
	Ожидаем.Что(СК.МожетУправлять(Посторонний, Пул, Пакет),
		"посторонний по-прежнему нет").ЭтоЛожь();

	Ожидаем.Что(СписокСодержит(СК.ПакетыВУправлении(Мейнтейнер), Пакет.Идентификатор),
		"пакет виден мейнтейнеру в отборе").ЭтоИстина();
	Ожидаем.Что(СписокСодержит(СК.ПакетыВУправлении(Посторонний), Пакет.Идентификатор),
		"и не виден постороннему").ЭтоЛожь();

КонецПроцедуры

// Выборка «мои пулы» строится по правам, а не обходом реестра: посторонний не видит
// чужого пула, а админ хаба видит всё. Свойство наблюдаемо на пуле, заведённом ПОСЛЕ
// выдачи прав: полный обход отдал бы его обоим.
&Тест
Процедура ПулыВУправленииОтбираютсяПоПравамАНеОбходомРеестра() Экспорт

	Ключ = УникальныйКлюч();
	СП = Желудь("СервисПользователей");
	Владелец = СП.СоздатьПользователя("pools-owner-" + Ключ, "", "password123", "user");
	Посторонний = СП.СоздатьПользователя("pools-other-" + Ключ, "", "password123", "user");
	Админ = СП.СоздатьПользователя("pools-admin-" + Ключ, "", "password123", "admin");

	Мой = Засев.ПулСервисом("mine-" + Ключ);
	Чужой = Засев.ПулСервисом("alien-" + Ключ);

	Желудь("СервисПравДоступа").ЗафиксироватьГрант("пользователь", Владелец.Идентификатор,
		Желудь("СервисПрав").ОбъектПул(Мой), Новый Структура("изменение", Истина));

	СК = Желудь("СлужбаКабинета");

	Ожидаем.Что(СредиПулов(СК.ПулыВУправлении(Владелец), Мой.Идентификатор),
		"свой пул у владельца в списке").ЭтоИстина();
	Ожидаем.Что(СредиПулов(СК.ПулыВУправлении(Владелец), Чужой.Идентификатор),
		"чужого пула у него нет").ЭтоЛожь();
	Ожидаем.Что(СредиПулов(СК.ПулыВУправлении(Посторонний), Мой.Идентификатор),
		"постороннему не видно ничего").ЭтоЛожь();
	Ожидаем.Что(СредиПулов(СК.ПулыВУправлении(Админ), Чужой.Идентификатор),
		"админу хаба принадлежат все пулы").ЭтоИстина();
	Ожидаем.Что(СК.ПулыВУправлении(Неопределено).Количество(),
		"анониму — пустой список").Равно(0);

КонецПроцедуры

// «Распоряжение» строже «управления» ровно на одну ступень: райтер в пул публикует,
// но зеркала, права и опасную зону настраивает мейнтейнер и выше. Обоих потребителей
// (кабинет и обзор зеркал) обслуживает один метод, поэтому порог доказывается здесь.
&Тест
Процедура ПулыВРаспоряженииОтсекаютРайтераНоПускаютМейнтейнера() Экспорт

	Ключ = УникальныйКлюч();
	СП = Желудь("СервисПользователей");
	Райтер = СП.СоздатьПользователя("disp-writer-" + Ключ, "", "password123", "user");
	Мейнтейнер = СП.СоздатьПользователя("disp-maint-" + Ключ, "", "password123", "user");

	Пул = Засев.ПулСервисом("disp-" + Ключ);
	СервисПрав = Желудь("СервисПрав");
	СервисПравДоступа = Желудь("СервисПравДоступа");

	СервисПравДоступа.ЗафиксироватьГрант("пользователь", Райтер.Идентификатор,
		СервисПрав.ОбъектПул(Пул), СервисПрав.НаборРоли(СервисПрав.РольРайтер()));
	СервисПравДоступа.ЗафиксироватьГрант("пользователь", Мейнтейнер.Идентификатор,
		СервисПрав.ОбъектПул(Пул), СервисПрав.НаборРоли(СервисПрав.РольМейнтейнер()));

	СК = Желудь("СлужбаКабинета");

	Ожидаем.Что(СредиПулов(СК.ПулыВУправлении(Райтер), Пул.Идентификатор),
		"КОНТРОЛЬ: райтеру пул в управление входит").ЭтоИстина();
	Ожидаем.Что(СредиПулов(СК.ПулыВРаспоряжении(Райтер), Пул.Идентификатор),
		"но распоряжаться им райтер не вправе").ЭтоЛожь();
	Ожидаем.Что(СредиПулов(СК.ПулыВРаспоряжении(Мейнтейнер), Пул.Идентификатор),
		"мейнтейнер распоряжается").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПулыВидимостьКвоты

&Тест
Процедура ВидимостьИКвотаПулаМеняютсяИВалидируются() Экспорт

	Ключ = УникальныйКлюч();
	СПул = Желудь("СервисПулов");
	Пул = Засев.ПулСервисом("pool-" + Ключ);

	СПул.УстановитьВидимость(Пул.Идентификатор, "private");
	Ожидаем.Что(СПул.ПулПоИдентификатору(Пул.Идентификатор).Видимость).Равно("private");

	СПул.УстановитьКвоту(Пул.Идентификатор, 500);
	Ожидаем.Что(СПул.ПулПоИдентификатору(Пул.Идентификатор).КвотаМб).Равно(500);

	Ожидаем.Что(ВызвалоИсключение("видимость", Пул.Идентификатор, "bogus"), "плохая видимость").ЭтоИстина();
	Ожидаем.Что(ВызвалоИсключение("квота", Пул.Идентификатор, -5), "отрицательная квота").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция УникальныйКлюч()
	Счётчик = Счётчик + 1;
	Возврат Формат(Счётчик, "ЧГ=0") + "-" + Лев(Строка(Новый УникальныйИдентификатор()), 8);
КонецФункции

Функция СодержитВерсию(Знач Версии, Знач Строка_)
	Для Каждого В Из Версии Цикл
		Если В.Версия = Строка_ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СредиПулов(Знач Список, Знач ПулИд)
	Для Каждого Пул Из Список Цикл
		Если Пул.Идентификатор = ПулИд Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СписокСодержит(Знач Список, Знач ПакетИд)
	Для Каждого Элемент Из Список Цикл
		Если Элемент.Пакет.Идентификатор = ПакетИд Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Возвращает Истина, если соответствующая мутация пула бросила исключение.
Функция ВызвалоИсключение(Знач Что, Знач ПулИд, Знач Значение)
	СПул = Желудь("СервисПулов");
	Попытка
		Если Что = "видимость" Тогда
			СПул.УстановитьВидимость(ПулИд, Значение);
		Иначе
			СПул.УстановитьКвоту(ПулИд, Значение);
		КонецЕсли;
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

#КонецОбласти
