	Ожидания.Вставить("вход/КонфигурацияOIDC.os", "вход через внешнего провайдера");
	// причина вердикта гейта — диагностика для журнала и отладки, она НЕ показывается
	// посетителю: его слова живут ключами login.geo.* и печатает их экран отказа
	Ожидания.Вставить("вход/ГейтВходаПоСтране.os", "причина вердикта — диагностика, а не строка экрана");

	Возврат Ожидания;

КонецФункции

Функция ЧислоОбъявленийСловаря()

	Результат = 0;
	Маркер = "Добавить(""";

	Для Каждого КиЗ Из ФайлыСловаряТекстов() Цикл
		Хвост = ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(ФайлыКорпуса[КиЗ.Ключ]));
		Позиция = СтрНайти(Хвост, Маркер);
		Пока Позиция > 0 Цикл
			Результат = Результат + 1;
			Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
			Позиция = СтрНайти(Хвост, Маркер);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
