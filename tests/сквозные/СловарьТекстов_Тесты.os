// Строки для человека во всём слое представления живут в словаре текстов: ключи кода
// и словаря совпадают, форма ключей соблюдена; корпус — модули с экранами и кит.

#Использовать asserts
#Использовать "../фикстуры"

Перем Исходники;     // ИсходникиПроекта — чтение файлов репозитория
Перем ПоискКлассов;  // КлассыСлоя — классы проекта и детекторы аннотаций
Перем Корпус;        // КорпусСлояПредставления — файлы корпуса и сборщик ключей
Перем ФайлыКорпуса;  // Соответствие — "модуль/Файл.os" -> полное имя
Перем Тексты;        // СловарьТекстов — словарь инсталляции со всеми частями

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьКорпусИСловарь() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	РеестрФикстур.Подключить("КорпусСлояПредставления");
	Корпус = Новый КорпусСлояПредставления("интерфейс, кабинет, настройки, вход, права, аудит", 400);
	ФайлыКорпуса = Корпус.Файлы();

	ПоискКлассов.ПодключитьСловарьТекстов(КаталогиПроекта.Модули());
	Тексты = Новый СловарьТекстов(ПоискКлассов.ЧастиСловаряТекстов(КаталогиПроекта.Модули()));

КонецПроцедуры

#Область Тесты

&Тест
Процедура ПользовательскиеСтрокиЖивутВСловареАНеВЭкранах() Экспорт

	Ожидания = ФайлыБезКлючейСтрок();
	ФайлыСловаря = ФайлыСловаряТекстов();

	Нарушители = Новый Массив();
	Неиспользованные = Новый Массив();
	ПотерянныеКлючи = Корпус.НетВКорпусе(Ожидания, ФайлыКорпуса);

	Для Каждого Файл Из ФайлыКорпуса Цикл

		Если ФайлыСловаря.Получить(Файл.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// таблица модели данных экрана не печатает: в её литералах имена колонок, таблиц
		// и полей отбора, а не текст для человека
		Если ПоискКлассов.ОбъявляетТаблицу(Исходники.Текст(Файл.Значение)) Тогда
			Продолжить;
		КонецЕсли;

		Разрешён = (Ожидания.Получить(Файл.Ключ) <> Неопределено);
		Проза = ПрозаическиеЛитералы(Исходники.Текст(Файл.Значение), ?(Разрешён, 1, 3));

		Если Проза.Количество() > 0 И НЕ Разрешён Тогда
			Нарушители.Добавить(Файл.Ключ + ": «" + СтрСоединить(Проза, "» «") + "»");
		КонецЕсли;
		Если Проза.Количество() = 0 И Разрешён Тогда
			Неиспользованные.Добавить(Файл.Ключ);
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, "; "),
		"пользовательские строки в исходнике (заведите ключ в СловарьТекстов)").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: файл переведён на ключи, удалите строку"
		+ " из ФайлыБезКлючейСтрок()").Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКлючи, ", "),
		"исключения для несуществующих файлов: файл переименован или удалён").Равно("");

КонецПроцедуры

&Тест
Процедура КлючиКодаИСловаряСовпадаютРовно() Экспорт

	Использованные = КлючиИзКода();
	Объявленные = Тексты.Ключи();

	Известные = Новый Соответствие();
	Для Каждого Ключ Из Объявленные Цикл
		Известные.Вставить(Ключ, Истина);
	КонецЦикла;

	Отсутствующие = Новый Массив();
	Для Каждого КиЗ Из Использованные Цикл
		Если Известные.Получить(КиЗ.Ключ) = Неопределено Тогда
			Отсутствующие.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Косвенные = КлючиСпрашиваемыеПеременной();

	Мёртвые = Новый Массив();
	Для Каждого Ключ Из Объявленные Цикл
		Если Использованные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Ключ, 13) = "settings.key." Тогда
			Продолжить;
		КонецЕсли;
		Если Косвенные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Мёртвые.Добавить(Ключ);
	КонецЦикла;

	Ожидаем.Что(Использованные.Количество() > 50,
		"сборщик ключей вообще находит ключи в коде слоя").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Отсутствующие, ", "),
		"ключи, которых нет в словаре: на экране будет маркер вместо текста").Равно("");
	Ожидаем.Что(СтрСоединить(Мёртвые, ", "),
		"мёртвые ключи словаря: их не запрашивает ни один экран").Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКосвенныеКлючи(Косвенные), ", "),
		"исключение для ключа, которого в исходниках слоя больше нет: снимите его"
		+ " из КлючиСпрашиваемыеПеременной()").Равно("");

	Ожидаем.Что(Объявленные.Количество(), "каждый ключ словаря объявлен ровно один раз")
		.Равно(ЧислоОбъявленийСловаря());

КонецПроцедуры

&Тест
Процедура ХвостовойКомментарийНеГлушитСканПрозы() Экспорт

	Хвост = "	x1 = 1; // раньше здесь было ВызватьИсключение" + Символы.ПС
		+ "	x2 = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(Хвост).Количество(),
		"хвостовой комментарий со словом ВызватьИсключение не прикрывает следующий оператор")
		.Равно(1);

	Диагностика = "	ВызватьИсключение СтрШаблон(""Секция «%1» не несёт токен"", Имя);";

	Ожидаем.Что(ПрозаическиеЛитералы(Диагностика).Количество(),
		"текст ВызватьИсключение — техническая диагностика, а не строка интерфейса").Равно(0);

	Полная = "	// когда-то тут было ВызватьИсключение" + Символы.ПС
		+ "	y = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(Полная).Количество(),
		"комментарная строка со словом ВызватьИсключение не прикрывает следующий оператор")
		.Равно(1);

	Кавычка = "	z = 1; // кавычка "" в комментарии" + Символы.ПС
		+ "	w = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(Кавычка).Количество(),
		"нечётная кавычка в комментарии не сбивает разбор литералов").Равно(1);

КонецПроцедуры

// Самотест исключения: вторым аргументом ПравитМеханизм стоит ИМЯ КЛАССА-владельца правки,
// а не текст для человека. Исключение привязано к позиции аргумента, а не к слову: то же
// имя в любом другом месте остаётся прозой, иначе исключение глушило бы целое слово везде.
&Тест
Процедура ИмяКлассаВладельцаМеханизмаНеПользовательскаяСтрока() Экспорт

	НастоящиеВызовы = "	ПравитМеханизм(""oshub.auth.password.enabled"", ""СтражПарольногоВхода"");"
		+ Символы.ПС
		+ "	ПравитМеханизм(""oshub.pools.personal_enabled"", ""ПультЛичныхПространств"");";

	Ожидаем.Что(ПрозаическиеЛитералы(НастоящиеВызовы).Количество(),
		"имя класса-владельца правки — тип, а не строка интерфейса").Равно(0);

	ЧужаяПозиция = "	ПравитМеханизм(""Кто может читать пакеты пула"", ""СтражПарольногоВхода"");";

	Ожидаем.Что(ПрозаическиеЛитералы(ЧужаяПозиция).Количество(),
		"исключение живёт во втором аргументе: проза в первом по-прежнему видна").Равно(1);

	ГолоеИмя = "	Механизм = ""СтражПарольногоВхода"";";

	Ожидаем.Что(ПрозаическиеЛитералы(ГолоеИмя).Количество(),
		"то же имя вне вызова — обычный литерал: исключение не глушит слово везде").Равно(1);

	СтрокаЭкрана = "	Подпись = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(СтрокаЭкрана).Количество(),
		"основной сторож жив: пользовательская строка в исходнике видна").Равно(1);

КонецПроцедуры

&Тест
Процедура ФорматКлючейСоблюдён() Экспорт

	Кривые = Новый Массив();

	Для Каждого Ключ Из Тексты.Ключи() Цикл
		Если НЕ КлючПравильнойФормы(Ключ) Тогда
			Кривые.Добавить("словарь: " + Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КиЗ Из КлючиИзКода() Цикл
		Если НЕ КлючПравильнойФормы(КиЗ.Ключ) Тогда
			Кривые.Добавить(КиЗ.Значение + ": " + КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Кривые, ", "),
		"ключи не той формы (нужно «область.экран.узел[.узел…]», строчная латиница)")
		.Равно("");

КонецПроцедуры

// Самотест сборщика: узел кита — не ключ. Кит.Текст и Кит.Шаблон зовутся так же, как
// резолвер словаря, и без разбора получателя сборщик собирал бы текст экрана как ключ —
// оба теста ключей краснели бы на каждом переведённом экране, а виноватым выглядел словарь.
&Тест
Процедура СборщикКлючейНеПутаетУзелКитаСВызовомСловаря() Экспорт

	Образец = "Тексты.Текст(""settings.проба.живой"");" + Символы.ПС
		+ "Отметка.Добавить(Кит.Текст(""—""));" + Символы.ПС
		+ "Рамка.Добавить(_Кит.Текст(""Ещё не ключ""));" + Символы.ПС;

	Собранные = Новый Соответствие();
	Корпус.ДобавитьКлючиВызова(Собранные, Образец, ".Текст(""", "образец");

	Ожидаем.Что(Собранные.Получить("settings.проба.живой"),
		"ключ словаря собран: сборщик не ослеп").Заполнено();
	Ожидаем.Что(Собранные.Количество(),
		"и он единственный — оба текстовых узла кита ключами не стали").Равно(1);

КонецПроцедуры

// Части словаря в корпусе реальны: словарь без частей был бы пуст на три четверти.
&Тест
Процедура ЧастиСловаряНайденыВКорпусе() Экспорт

	Части = ФайлыСловаряТекстов();
	Ожидаем.Что(Части.Количество() > 5, "словарь и его части: " + Части.Количество()).ЭтоИстина();

КонецПроцедуры

// Контейнер, не нашедший ни одной части, собрал бы словарь из одного каркаса: экраны вышли бы маркерами.
&Тест
Процедура СловарьБезЧастейОтказываетГромко() Экспорт

	Для Каждого Части Из ПустыеНаборыЧастей() Цикл
		Отказ = "";
		Попытка
			Пустой = Новый СловарьТекстов(Части);
			Пустой = Пустой;
		Исключение
			Отказ = ОписаниеОшибки();
		КонецПопытки;
		Ожидаем.Что(Отказ, "словарь без частей не создаётся").Содержит("ЧастьСловаряТекстов");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция КлючПравильнойФормы(Знач Ключ)

	Сегменты = СтрРазделить(Строка(Ключ), ".", Истина);
	Если Сегменты.Количество() < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789-";

	Для Каждого Сегмент Из Сегменты Цикл
		Если НЕ ЗначениеЗаполнено(Сегмент) Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Поз = 1 По СтрДлина(Сегмент) Цикл
			Символ = Сред(Сегмент, Поз, 1);
			Если СтрНайти(Допустимые, Символ) = 0 ИЛИ Символ <> НРег(Символ) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Словарь инсталляции — класс корпуса, перебивающий контракт резолвера кита &Верховным.
Функция ФайлСловаряТекстов()

	Контракт = ИмяКонтрактаСловаря();
	Маркер = "&Прозвище(""" + Контракт + """)";

	Найденные = Новый Массив();
	Для Каждого Файл Из ФайлыКорпуса Цикл
		Исходник = ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(Файл.Значение));
		// прозвище носят и пустой словарь кита, и словарь хаба: второй отличает &Верховный
		Если СтрНайти(Исходник, Маркер) > 0 И СтрНайти(Исходник, "&Верховный") > 0 Тогда
			Найденные.Добавить(Файл.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Контракт %1 перебивают &Верховным %2 классов (%3):"
			+ " словарь инсталляции обязан быть ровно один",
			Контракт, Найденные.Количество(), СтрСоединить(Найденные, ", "));
	КонецЕсли;

	Возврат Найденные[0];

КонецФункции

// Файлы словаря инсталляции ("модуль/Файл.os" -> Истина): сам словарь и реализации контракта его частей.
Функция ФайлыСловаряТекстов()

	Результат = Новый Соответствие();
	Результат.Вставить(ФайлСловаряТекстов(), Истина);
	Для Каждого Файл Из ФайлыКорпуса Цикл
		Если ПоискКлассов.РеализуетКонтракт(Исходники.Текст(Файл.Значение), "ЧастьСловаряТекстов") Тогда
			Результат.Вставить(Файл.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПустыеНаборыЧастей()

	Результат = Новый Массив();
	Результат.Добавить(Неопределено);
	Результат.Добавить(Новый Массив());
	Возврат Результат;

КонецФункции

// Имя контракта словаря — из пластилина резолвера ТекстыИнтерфейса.
Функция ИмяКонтрактаСловаря()

	Текст = ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(Корпус.ФайлКласса("ТекстыИнтерфейса")));

	Маркер = "&Пластилин(Значение = """;
	Позиция = СтрНайти(Текст, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "ТекстыИнтерфейса не объявляет пластилин словаря — скан 5.G потерял опору";
	КонецЕсли;

	Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция ПрозаическиеЛитералы(Знач Исходник, Знач Предел = 3)

	Текст = ИсходникБезКомментариев.БезКомментариев(Исходник);
	Результат = Новый Массив();

	Длина = СтрДлина(Текст);
	НачалоОператора = 1;   // позиция за последней «;» — граница текущего оператора
	Имена = Новый Массив();   // имена незакрытых вызовов
	Запятые = Новый Массив(); // сколько запятых встречено в каждом из них

	Позиция = 1;
	Пока Позиция <= Длина Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Символ = """" Тогда

			Литерал = "";
			Индекс = Позиция + 1;

			Пока Индекс <= Длина Цикл
				Текущий = Сред(Текст, Индекс, 1);
				Если Текущий = """" Тогда
					Если Сред(Текст, Индекс + 1, 1) = """" Тогда
						Литерал = Литерал + """";
						Индекс = Индекс + 2;
						Продолжить;
					КонецЕсли;
					Прервать;
				КонецЕсли;
				Литерал = Литерал + Текущий;
				Индекс = Индекс + 1;
			КонецЦикла;

			Если ЭтоПрозаическийЛитерал(Литерал)
				И НЕ ЭтоСлужебнаяПозиция(Имена, Запятые)
				И СтрНайти(Сред(Текст, НачалоОператора, Позиция - НачалоОператора),
					"ВызватьИсключение") = 0 Тогда

				Результат.Добавить(Литерал);
				Если Результат.Количество() >= Предел Тогда
					Возврат Результат;
				КонецЕсли;

			КонецЕсли;

			Позиция = Индекс + 1;
			Продолжить;

		КонецЕсли;

		Если Символ = "(" Тогда
			Имена.Добавить(ИмяВызоваПеред(Текст, Позиция));
			Запятые.Добавить(0);
		ИначеЕсли Символ = ")" Тогда
			Если Имена.Количество() > 0 Тогда
				Имена.Удалить(Имена.ВГраница());
				Запятые.Удалить(Запятые.ВГраница());
			КонецЕсли;
		ИначеЕсли Символ = "," Тогда
			Если Запятые.Количество() > 0 Тогда
				Запятые[Запятые.ВГраница()] = Запятые[Запятые.ВГраница()] + 1;
			КонецЕсли;
		ИначеЕсли Символ = ";" Тогда
			НачалоОператора = Позиция + 1;
			Имена = Новый Массив();
			Запятые = Новый Массив();
		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоПрозаическийЛитерал(Знач Литерал)

	Если НЕ ЗначениеЗаполнено(Литерал) ИЛИ НЕ СодержитКириллицу(Литерал) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНайти(Литерал, " ") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Первый = Лев(Литерал, 1);
	Возврат СодержитКириллицу(Первый) И Первый <> НРег(Первый);

КонецФункции

Функция СодержитКириллицу(Знач Текст)

	Алфавит = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Алфавит, НРег(Сред(Текст, Поз, 1))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоСлужебнаяПозиция(Знач Имена, Знач Запятые)

	Если Имена.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Номер = НомерСлужебногоАргумента(Имена[Имена.ВГраница()]);
	Если Номер < 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Номер = 0 ИЛИ Номер = Запятые[Запятые.ВГраница()] + 1;

КонецФункции

Функция НомерСлужебногоАргумента(Знач ИмяВызова)

	Если ИмяВызова = "Структура" ИЛИ ИмяВызова = "ФиксированнаяСтруктура"
		ИЛИ ИмяВызова = "Вставить" ИЛИ ИмяВызова = "Свойство"
		ИЛИ ИмяВызова = "ОписаниеТипов" ИЛИ ИмяВызова = "Сортировать"
		ИЛИ ИмяВызова = "Тип" ИЛИ ИмяВызова = "Получить" Тогда
		Возврат 1;
	КонецЕсли;

	Если ИмяВызова = "Ошибка" ИЛИ ИмяВызова = "Предупреждение"
		ИЛИ ИмяВызова = "Информация" ИЛИ ИмяВызова = "Отладка" Тогда
		Возврат 1;
	КонецЕсли;

	Если ИмяВызова = "Текст" ИЛИ ИмяВызова = "Список" ИЛИ ИмяВызова = "Флаг"
		ИЛИ ИмяВызова = "Значение" ИЛИ ИмяВызова = "Формат"
		ИЛИ ИмяВызова = "ПолеСтруктуры"
		// имя ДОМЕННОГО поля аргументом (ПресетыВхода): не текст экрана, а ключ структуры
		ИЛИ ИмяВызова = "ПолеРазрешено" ИЛИ ИмяВызова = "ПолеОбязательно"
		ИЛИ ИмяВызова = "УмолчаниеПоля" ИЛИ ИмяВызова = "ПолеПресетаИзВвода"
		// имя параметра части составной формы (РазборФормы): его задаёт winow, а не экран
		ИЛИ ИмяВызова = "ПараметрЧасти"
		// имя класса-владельца правки настройки (РеестрНастроек): тип, а не текст экрана
		ИЛИ ИмяВызова = "ПравитМеханизм" Тогда
		Возврат 2;
	КонецЕсли;

	// имя поля модели, в которое кит кладёт содержимое слота: ключ структуры, а не текст
	Если ИмяВызова = "КомпонентСоСлотом" ИЛИ ИмяВызова = "КомпонентСоСписком" Тогда
		Возврат 4;
	КонецЕсли;

	// имя желудя первым аргументом (Поделка.НайтиЖелудь): идентификатор в контейнере,
	// а не текст экрана
	Если ИмяВызова = "НайтиЖелудь" Тогда
		Возврат 1;
	КонецЕсли;

	// аннотации ОСени: и прилепляемый желудь, и прозвище, и цель напильника — имена
	// в контейнере, а не проза
	Если ИмяВызова = "Пластилин" ИЛИ ИмяВызова = "Прозвище" ИЛИ ИмяВызова = "Напильник" Тогда
		Возврат 0;
	КонецЕсли;

	Возврат -1;

КонецФункции

Функция ИмяВызоваПеред(Знач Текст, Знач ПозицияСкобки)

	Имя = "";
	Индекс = ПозицияСкобки - 1;

	Пока Индекс >= 1 Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если НЕ СимволИмени(Символ) Тогда
			Прервать;
		КонецЕсли;
		Имя = Символ + Имя;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Имя;

КонецФункции

Функция СимволИмени(Знач Символ)
	Возврат ЗначениеЗаполнено(Символ)
		И СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789_абвгдеёжзийклмнопрстуфхцчшщъыьэюя",
			НРег(Символ)) > 0;
КонецФункции

Функция КлючиИзКода()

	Результат = Новый Соответствие();

	Для Каждого Файл Из ФайлыКорпуса Цикл
		Если СвойСловарьДомена(Файл.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Текст = ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(Файл.Значение));
		Корпус.ДобавитьКлючиВызова(Результат, Текст, ".Текст(""", Файл.Ключ);
		Корпус.ДобавитьКлючиВызова(Результат, Текст, ".Шаблон(""", Файл.Ключ);
	КонецЦикла;

	Для Каждого Файл Из ФайлыДекларацийПодписок() Цикл
		ДобавитьКлючиДекларации(Результат,
			ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(Файл.Значение)), Файл.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// У входа свой словарь домена: его ключи сверяет набор СловарьВхода, а не словарь экранов.
Функция СвойСловарьДомена(Знач КлючФайла)
	Возврат СтрНачинаетсяС(КлючФайла, "вход/");
КонецФункции

// Ключи, которые кит спрашивает переменной, а не литералом в вызове: сборщик их не видит.
Функция КлючиСпрашиваемыеПеременной()

	Результат = Новый Соответствие();
	Результат.Вставить("chrome.menu.section.deeds", "рубрика «мои дела» в панели меню");
	Результат.Вставить("chrome.menu.section.nav", "рубрика дорог хаба");
	Результат.Вставить("chrome.menu.section.screen", "рубрика разделов текущего экрана");
	Возврат Результат;

КонецФункции

// Исключение живёт, пока литерал ключа стоит в исходниках корпуса.
Функция ПотерянныеКосвенныеКлючи(Знач Косвенные)

	ТекстКорпуса = "";
	Для Каждого Файл Из ФайлыКорпуса Цикл
		ТекстКорпуса = ТекстКорпуса + ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(Файл.Значение));
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого КиЗ Из Косвенные Цикл
		Если СтрНайти(ТекстКорпуса, """" + КиЗ.Ключ + """") = 0 Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ФайлыДекларацийПодписок()

	Результат = Новый Соответствие();
	Корень = ОбъединитьПути(КаталогиПроекта.Модули(), "подписки", "Классы", "обработчики");
	Если НЕ Новый Файл(Корень).Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(Корень, "РендерНастроек*.os", Истина) Цикл
		Результат.Вставить("webhooks/" + Файл.Имя, Файл.ПолноеИмя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьКлючиДекларации(Результат, Знач Текст, Знач ИмяФайла)

	Хвост = Текст;
	Позиция = СтрНайти(Хвост, """");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + 1);
		Конец = СтрНайти(Хвост, """");
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Литерал = Лев(Хвост, Конец - 1);
		Если КлючПравильнойФормы(Литерал) И Результат.Получить(Литерал) = Неопределено Тогда
			Результат.Вставить(Литерал, ИмяФайла);
		КонецЕсли;
		Хвост = Сред(Хвост, Конец + 1);
		Позиция = СтрНайти(Хвост, """");
	КонецЦикла;

КонецПроцедуры

