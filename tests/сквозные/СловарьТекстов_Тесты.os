	Ожидания.Вставить("настройки/ОписанияСобытийНастроек.os", "описания событий предмета для перечня событий хаба");
	Ожидания.Вставить("аудит/ЧитательЖурналаАудита.os", "чтение файла: имена полей отбора источника, а не строки экрана");
	Ожидания.Вставить("интерфейс/КонтроллерВходаOIDC.os", "вход через внешнего провайдера");
