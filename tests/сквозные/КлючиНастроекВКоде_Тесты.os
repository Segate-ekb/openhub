// Ключи настроек в коде всех модулей против реестра: детальки прикладных ключей живут только
// в объявлениях, каждый ключ, читаемый деталькой или службой настроек, объявлен.

#Использовать asserts
#Использовать "../фикстуры"

Перем ДвериНастроек;   // Массив из Строка — методы СервисНастроек, первым параметром берущие ключ

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьРеестр() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();

	РеестрНастроекХаба.ПодключитьКлассы(ПоискКлассов, Модули);
	ПоискКлассов.Подключить(Модули, "СервисНастроек");
	ДвериНастроек = ДвериСлужбыНастроек();

КонецПроцедуры

&Тест
Процедура ПрикладныеКлючиНеОбъявляютсяВнеРеестра() Экспорт

	// деталька прикладного ключа вне объявлений — второй источник значения с своим умолчанием
	Реестр = РеестрНастроекХаба.Реестр();

	Прикладные = Новый Соответствие();
	Для Каждого Ключ Из Реестр.Ключи() Цикл
		Если Реестр.ЭтоПрикладная(Ключ) Тогда
			Прикладные.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Прикладные.Количество() > 0, "прикладные ключи в реестре найдены").ЭтоИстина();

	Нарушители = Новый Массив();
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогиПроекта.Модули(), "*.os", Истина) Цикл
		Текст = ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя);
		Если ЭтоТаблицаОбъявлений(Текст) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ключ Из КлючиДеталек(Текст) Цикл
			Если Прикладные.Получить(НРег(Ключ)) <> Неопределено Тогда
				Нарушители.Добавить(СтрШаблон("%1 (%2)", Ключ, ФайлКласса.Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"прикладной ключ объявлен деталькой вне таблиц реестра: у настройки завёлся второй"
		+ " источник значения, и правка из формы до него не доедет").Равно("");

КонецПроцедуры

&Тест
Процедура ЧитаемыеУРезолвераКлючиСуществуютВРеестре() Экспорт

	// каждый ключ-литерал, переданный любой двери службы настроек, объявлен: незнакомый ключ
	// служба молча читает умолчанием
	Реестр = РеестрНастроекХаба.Реестр();

	Найдено = 0;
	Нарушители = Новый Массив();
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогиПроекта.Модули(), "*.os", Истина) Цикл
		Для Каждого Ключ Из КлючиОбращенийКНастройкам(ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя)) Цикл
			Найдено = Найдено + 1;
			Если НЕ Реестр.Есть(Ключ) Тогда
				Нарушители.Добавить(СтрШаблон("%1 (%2)", Ключ, ФайлКласса.Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"ключ спрашивают у службы настроек, а в реестре его нет").Равно("");
	Ожидаем.Что(Найдено >= 50,
		СтрШаблон("обращений к службе настроек найдено %1 при минимуме 50 — скан ослеп", Найдено))
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаждыйКлючХабаЧитаемыйДеталькойОбъявленВРеестре() Экспорт

	// ключ, читаемый деталькой, есть в реестре — иначе его нет ни на экране, ни в API
	Реестр = РеестрНастроекХаба.Реестр();
	Известные = ЗнаемоеВнеРеестра();

	Нарушители = Новый Массив();
	Найдено = 0;
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогиПроекта.Модули(), "*.os", Истина) Цикл
		Для Каждого Ключ Из КлючиДеталек(ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя)) Цикл
			Если НЕ ЭтоКлючХаба(Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Найдено = Найдено + 1;
			Если Реестр.Есть(Ключ) ИЛИ Известные.Получить(НРег(Ключ)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Нарушители.Добавить(СтрШаблон("%1 (%2)", Ключ, ФайлКласса.Имя));
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"код читает значение деталькой, а в реестре его нет: на экране настроек такого"
		+ " значения не будет ни в поле, ни карточкой. Объявите ключ в реестре либо"
		+ " (если он снимается) впишите его в ЗнаемоеВнеРеестра с причиной").Равно("");
	Ожидаем.Что(Найдено >= 100,
		СтрШаблон("деталечных ключей хаба найдено %1 при минимуме 100 — скан ослеп", Найдено))
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СписокЗнаемогоВнеРеестраНеПротух() Экспорт

	// снятый или объявленный ключ уходит из списка исключений
	Реестр = РеестрНастроекХаба.Реестр();

	Читаемые = Новый Соответствие();
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогиПроекта.Модули(), "*.os", Истина) Цикл
		Для Каждого Ключ Из КлючиДеталек(ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя)) Цикл
			Читаемые.Вставить(НРег(Ключ), Истина);
		КонецЦикла;
	КонецЦикла;

	Нарушители = Новый Массив();
	Для Каждого КиЗ Из ЗнаемоеВнеРеестра() Цикл
		Если Читаемые.Получить(КиЗ.Ключ) = Неопределено Тогда
			Нарушители.Добавить(КиЗ.Ключ + " — деталькой больше не читается: уберите из списка");
		ИначеЕсли Реестр.Есть(КиЗ.Ключ) Тогда
			Нарушители.Добавить(КиЗ.Ключ + " — уже объявлен в реестре: уберите из списка");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС), "список знаемого вне реестра протух")
		.Равно("");

КонецПроцедуры

&Тест
Процедура СканДеталекЧитаетКодАНеКомментарииИЛитералы() Экспорт

	// самотест сканера: аннотация в комментарии и в литерале — текст, а не директива
	Образец = "// &Деталька(Значение = ""oshub.из.комментария"") — так писать нельзя" + Символы.ПС
		+ "	Текст = ""&Деталька(Значение = """"oshub.из.литерала"""")"";" + Символы.ПС
		+ "	&Деталька(Значение = ""oshub.настоящий.ключ"") _Знач = """"," + Символы.ПС
		+ "	Хвост = 1; // &Деталька(Значение = ""oshub.из.хвостового.комментария"")";

	Ключи = КлючиДеталек(Образец);

	Ожидаем.Что(СтрСоединить(Ключи, ","), "из образца прочитан ровно один ключ — настоящий")
		.Равно("oshub.настоящий.ключ");

КонецПроцедуры

&Тест
Процедура СканОбращенийКНастройкамЧитаетКодАНеКомментарииИЛитералы() Экспорт

	// самотест сканера: обращение в комментарии и в литерале — текст; чужой получатель и не-дверь — не ключ
	Образец = "Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""СервисНастроек"") _Настройки,"
		+ Символы.ПС + "	&Пластилин(Значение = ""СервисПулов"") _Пулы)" + Символы.ПС
		+ "	Настройки = ?(_Настройки = Неопределено, Новый Заглушка(), _Настройки);" + Символы.ПС
		+ "	Пулы = _Пулы;" + Символы.ПС
		+ "// Настройки.Целое(""oshub.из.комментария"", 1)" + Символы.ПС
		+ "	Текст = ""Настройки.Флаг(""""oshub.из.литерала"""", Ложь)"";" + Символы.ПС
		+ "	Хвост = 1; // Настройки.Текстом(""oshub.из.хвостового.комментария"")" + Символы.ПС
		+ "	Порог = Настройки.Целое( ""oshub.настоящий.ключ"", 1);" + Символы.ПС
		+ "	Размер = Пулы.Целое(""oshub.чужой.получатель"", 1);" + Символы.ПС
		+ "	Прочее = Настройки.ПоИмени(""oshub.не.дверь"");" + Символы.ПС
		+ "	Имя = МоиНастройки.Флаг(""oshub.чужое.имя"", Ложь);";

	Ожидаем.Что(СтрСоединить(КлючиОбращенийКНастройкам(Образец), ","),
		"из образца прочитан ровно один ключ — настоящий").Равно("oshub.настоящий.ключ");

КонецПроцедуры

&Тест
Процедура СканОбращенийКНастройкамВидитКаждуюДверьСлужбы() Экспорт

	// двери берутся у самой службы: у каждой первым параметром идёт ключ
	Ожидаем.Что(ДвериНастроек.Количество() >= 10, "двери службы настроек найдены").ЭтоИстина();
	Для Каждого Дверь Из СтрРазделить("Значение,Целое,Флаг,Текстом,Установить,Сбросить", ",") Цикл
		Ожидаем.Что(ДвериНастроек.Найти(Дверь), "дверь " + Дверь).Не_().Равно(Неопределено);
	КонецЦикла;

	Образец = "Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""СервисНастроек"") _Настройки)"
		+ Символы.ПС + "	Настройки = _Настройки;" + Символы.ПС;
	Ожидаемые = Новый Массив();
	Для Каждого Дверь Из ДвериНастроек Цикл
		Ключ = "oshub.дверь." + НРег(Дверь);
		Ожидаемые.Добавить(Ключ);
		Образец = Образец + СтрШаблон("	Настройки.%1(""%2"", 1);", Дверь, Ключ) + Символы.ПС;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(КлючиОбращенийКНастройкам(Образец), ","),
		"ключ читается у каждой двери").Равно(СтрСоединить(Ожидаемые, ","));

КонецПроцедуры

&Тест
Процедура ТаблицаОбъявленийУзнаётсяПоПрозвищуВКодеАНеПоТексту() Экспорт

	// от сторожа освобождает только класс, объявленный реализацией КлючиНастроек в коде
	Ложные = "// &Прозвище(""КлючиНастроек"") — было когда-то" + Символы.ПС
		+ "	Текст = ""&Прозвище(КлючиНастроек)"";" + Символы.ПС
		+ "&Прозвище(""КлючиНастроекПочты"")" + Символы.ПС
		+ "&Желудь";
	Настоящая = "&Прозвище(""КлючиНастроек"")" + Символы.ПС
		+ "&Порядок(90)" + Символы.ПС
		+ "&Желудь";

	Ожидаем.Что(ЭтоТаблицаОбъявлений(Ложные), "прозвище в комментарии и литерале — не объявление")
		.ЭтоЛожь();
	Ожидаем.Что(ЭтоТаблицаОбъявлений(Настоящая), "прозвище в коде — объявление").ЭтоИстина();

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Объявление ключей предмета: его детальки — сам реестр.
Функция ЭтоТаблицаОбъявлений(Знач Текст)
	Возврат ЗначенияАннотации(Текст, "&Прозвище").Найти("КлючиНастроек") <> Неопределено;
КонецФункции

Функция ЭтоКлючХаба(Знач Ключ)
	Возврат Лев(НРег(СокрЛП(Строка(Ключ))), 6) = "oshub.";
КонецФункции

// Ключи, которые код читает деталькой, а реестр намеренно не объявляет, — с причиной.
Функция ЗнаемоеВнеРеестра()

	Результат = Новый Соответствие();

	// прочее к сносу: у величины либо один источник правды на объекте, либо место в коде
	Результат.Вставить("oshub.jobs.stats_flush_interval_sec",
		"дубль oshub.stats.flush_interval_sec, остаётся тот");
	Результат.Вставить("oshub.pools.default", "основной пул назначается признаком на пуле");
	Результат.Вставить("oshub.publish.github.api", "адрес API GitHub зашивается в код");

	// узел, а не значение: реестр держит значения, а провайдеры входа — список и ветка
	// полей на каждого; правит их экран провайдеров, а конфигурация перекрывает целиком
	Результат.Вставить("oshub.oidc", "провайдеры входа из конфигурации инсталляции");

	Возврат Результат;

КонецФункции

// Ключи деталек из кода, без комментариев и литералов.
Функция КлючиДеталек(Знач Текст)
	Возврат ЗначенияАннотации(Текст, "&Деталька");
КонецФункции

// Первый литерал после маркера аннотации в коде; маркер внутри литерала директивой не считается.
Функция ЗначенияАннотации(Знач Текст, Знач Маркер)

	Код = ИсходникБезКомментариев.БезКомментариев(Текст);
	Результат = Новый Массив();
	ВЛитерале = Ложь;
	Ждём = Ложь;
	Накоплено = "";
	Поз = 1;

	Пока Поз <= СтрДлина(Код) Цикл
		Симв = Сред(Код, Поз, 1);
		Если ВЛитерале Тогда
			Если Симв = """" И Сред(Код, Поз, 2) = """""" Тогда
				Накоплено = Накоплено + """";
				Поз = Поз + 1;
			ИначеЕсли Симв = """" Тогда
				ВЛитерале = Ложь;
				Если Ждём Тогда
					Результат.Добавить(Накоплено);
					Ждём = Ложь;
				КонецЕсли;
				Накоплено = "";
			Иначе
				Накоплено = Накоплено + Симв;
			КонецЕсли;
		ИначеЕсли Симв = """" Тогда
			ВЛитерале = Истина;
			Накоплено = "";
		ИначеЕсли Сред(Код, Поз, СтрДлина(Маркер)) = Маркер Тогда
			Ждём = Истина;
			Поз = Поз + СтрДлина(Маркер) - 1;
		КонецЕсли;
		Поз = Поз + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Двери службы настроек — её экспортные методы, чей первый параметр — ключ.
Функция ДвериСлужбыНастроек()

	Результат = Новый Массив();
	Для Каждого Метод Из Новый Рефлектор().ПолучитьТаблицуМетодов(Тип("СервисНастроек")) Цикл
		Если Метод.Экспорт И Метод.КоличествоПараметров > 0 И Метод.Параметры[0].Имя = "Ключ" Тогда
			Результат.Добавить(Метод.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключи-литералы в обращениях «Получатель.Дверь("ключ"» кода без комментариев: код и литералы
// чередуются, и ключ — литерал, перед которым в коде стоит обращение к двери.
Функция КлючиОбращенийКНастройкам(Знач Текст)

	Результат = Новый Массив();
	Код = ИсходникБезКомментариев.БезКомментариев(Текст);
	Получатели = ПолучателиСлужбыНастроек(Код);
	Если Получатели.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Позиция = 1;
	Длина = СтрДлина(Код);
	Пока Позиция <= Длина Цикл
		Открытие = СтрНайти(Код, """", , Позиция);
		Закрытие = ?(Открытие > 0 И Открытие < Длина, СтрНайти(Код, """", , Открытие + 1), 0);
		Если Закрытие = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ЭтоОбращениеКДвери(Сред(Код, Позиция, Открытие - Позиция), Получатели) Тогда
			Результат.Добавить(Сред(Код, Открытие + 1, Закрытие - Открытие - 1));
		КонецЕсли;
		Позиция = Закрытие + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена, под которыми класс держит внедрённую службу настроек: параметр конструктора
// с &Пластилин("СервисНастроек") и поля, которым он присвоен.
Функция ПолучателиСлужбыНастроек(Знач Код)

	Получатели = Новый Массив();
	Внедрение = Новый РегулярноеВыражение(
		"&Пластилин\(\s*(?:Значение\s*=\s*)?""СервисНастроек""[^)]*\)\s*(?:Знач\s+)?(\w+)");
	Для Каждого Совпадение Из Внедрение.НайтиСовпадения(Код) Цикл
		Параметр = Совпадение.Группы[1].Значение;
		Получатели.Добавить(Параметр);
		Присвоение = Новый РегулярноеВыражение(
			"(?m)^[ \t]*(\w+)[ \t]*=[^=\n][^\n]*(?<!\w)" + Параметр + "(?!\w)");
		Для Каждого Поле Из Присвоение.НайтиСовпадения(Код) Цикл
			Если Получатели.Найти(Поле.Группы[1].Значение) = Неопределено Тогда
				Получатели.Добавить(Поле.Группы[1].Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Получатели;

КонецФункции

// Код перед литералом кончается на «Получатель.Дверь(» — литерал идёт ключом.
Функция ЭтоОбращениеКДвери(Знач КодПеред, Знач Получатели)

	Хвост = СокрП(КодПеред);
	Если Прав(Хвост, 1) <> "(" Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = СокрП(Лев(Хвост, СтрДлина(Хвост) - 1));
	Дверь = ПоследнееИмя(Хвост);
	Если НЕ ЗначениеЗаполнено(Дверь) ИЛИ ДвериНастроек.Найти(Дверь) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Лев(Хвост, СтрДлина(Хвост) - СтрДлина(Дверь));
	Если Прав(Хвост, 1) <> "." Тогда
		Возврат Ложь;
	КонецЕсли;

	Получатель = ПоследнееИмя(Лев(Хвост, СтрДлина(Хвост) - 1));
	Возврат ЗначениеЗаполнено(Получатель) И Получатели.Найти(Получатель) <> Неопределено;

КонецФункции

// Идентификатор, которым кончается текст; "" — текст кончается не именем.
Функция ПоследнееИмя(Знач Текст)

	Начало = СтрДлина(Текст) + 1;
	Пока Начало > 1 И ЭтоЗнакИмени(Сред(Текст, Начало - 1, 1)) Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Возврат Сред(Текст, Начало);

КонецФункции

Функция ЭтоЗнакИмени(Знач Знак)
	Возврат Знак = "_" ИЛИ ВРег(Знак) <> НРег(Знак) ИЛИ СтрНайти("0123456789", Знак) > 0;
КонецФункции

Функция ПрочитатьТекстФайла(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

#КонецОбласти
