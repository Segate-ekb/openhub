// Состав фоновых задач хаба глазами контейнера: задачи модулей собираются по прозвищу так же,
// как их собирает планировщик, и при умолчаниях настроек дают прежние регистрации.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем Поделка;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

// Контейнер из одних задач модулей и заглушки их зависимостей: планировщика в нём нет,
// он стартовая рогатка и в контейнере пустился бы в цикл опроса.
&ПередВсеми
Процедура ПоднятьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();

	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "фоновыеЗадания", "Классы"), "РегистрацииЗадачи");
	Для Каждого Имя Из ЗадачиХаба() Цикл
		Поиск.Подключить(Модули, Имя);
	КонецЦикла;
	РеестрФикстур.Подключить("ЗависимостиЗадачЗаглушка");

	Поделка = Новый Поделка(Новый СоветДругогоМастера());
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

// Задачу, которая не собралась или потеряла &Прозвище либо &Желудь, контейнер из массива
// выбрасывает молча: хаб стартует, а задачи нет. Состав сверяется с тем, что собрал
// контейнер, — поэтому краснеет и потеря аннотации, и сменённое умолчание детальки.
&Тест
Процедура ЗадачиХабаСобираютсяКонтейнеромПрежнимСоставом() Экспорт

	Состав = Новый Массив();
	Для Каждого Задача Из Поделка.НайтиЖелуди("ЗадачаПланировщика") Цикл
		Регистрации = Новый РегистрацииЗадачи();
		Задача.Зарегистрировать(Регистрации);
		Для Каждого Регистрация Из Регистрации.Состав() Цикл
			Состав.Добавить(Регистрация.Имя + " — " + Регистрация.Описание);
		КонецЦикла;
	КонецЦикла;

	// четырнадцать регистраций на тринадцать работ: у обновления базы стран их две —
	// стартовый заход и суточный интервал
	Ожидаемый = Новый Массив();
	Ожидаемый.Добавить("gc-кэша-прокси — каждые 3600 с");
	Ожидаемый.Добавить("здоровье-источников — каждые 60 с");
	Ожидаемый.Добавить("здоровье-хранилища — каждые 60 с");
	Ожидаемый.Добавить("обновление-базы-стран — каждые 86400 с");
	Ожидаемый.Добавить("обновление-базы-стран-при-старте — однократно, через 120 с после старта");
	Ожидаемый.Добавить("переиндексация-readme — ежедневно в 3:00");
	Ожидаемый.Добавить("сброс-статистики — каждые 60 с");
	Ожидаемый.Добавить("сверка-объёмов-пулов — каждые 3600 с");
	Ожидаемый.Добавить("синхронизация-зеркал — каждые 3600 с");
	Ожидаемый.Добавить("уборка-загрузок-артефактов — каждые 60 с");
	Ожидаемый.Добавить("уборка-реестра-заданий — каждые 60 с");
	Ожидаемый.Добавить("чистка-заявок-cli — каждые 300 с");
	Ожидаемый.Добавить("чистка-приглашений — каждые 3600 с");
	Ожидаемый.Добавить("чистка-происшествий — каждые 3600 с");

	Ожидаем.Что(СтрСоединить(ПоПорядку(Состав), Символы.ПС),
		"регистрации задач, собранных контейнером, при умолчаниях настроек")
		.Равно(СтрСоединить(ПоПорядку(Ожидаемый), Символы.ПС));

КонецПроцедуры

#Область Обвязка

// Классы задач модулей хаба; файл каждого ищется по имени во всём дереве модулей.
Функция ЗадачиХаба()
	Возврат СтрРазделить("ЗадачаСбросаСтатистики,ЗадачаСбораКэшаПрокси,ЗадачаПереиндексацииREADME,"
		+ "ЗадачаСверкиОбъёмовПулов,ЗадачаСинхронизацииЗеркал,ЗадачаЗдоровьяИсточников,"
		+ "ЗадачаЧисткиЗаявокCLI,ЗадачаЧисткиПриглашений,ЗадачаЧисткиПроисшествий,"
		+ "ЗадачаЗдоровьяХранилища,ЗадачаОбновленияБазыСтран,ЗадачаУборкиРеестраЗаданий,"
		+ "ЗадачаУборкиЗагрузокАртефактов", ",");
КонецФункции

Функция ПоПорядку(Знач Строки)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Строка");
	Для Каждого Запись Из Строки Цикл
		Таблица.Добавить().Строка = Запись;
	КонецЦикла;
	Таблица.Сортировать("Строка");
	Возврат Таблица.ВыгрузитьКолонку("Строка");

КонецФункции

#КонецОбласти
