// Каждый путь записи внешнего источника пула — апстрима или зеркала — в src/модули судит адрес SSRF-гейтом
// и спрашивает тип пула. Скан читает код без комментариев и литералов: новый писатель краснит набор, только если пишет мимо гейта.

#Использовать asserts
#Использовать "../фикстуры"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура КаждыйПисательИсточниковСудитАдресВалидатором() Экспорт

	МимоГейта = Новый Массив();
	Для Каждого Писатель Из ПисателиПолейИсточника() Цикл
		Если НЕ ЗнаетИмя(Писатель.Исходник, "ВалидаторАдресаАпстрима") Тогда
			МимоГейта.Добавить(Писатель.Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(МимоГейта, ", "),
		"писатели адреса внешнего источника без SSRF-валидатора").Равно("");

КонецПроцедуры

// Гейт адреса — «куда можно ходить», тип пула — «какому пулу положен внешний источник».
&Тест
Процедура КаждыйПисательИсточниковСпрашиваетТипПула() Экспорт

	БезПроверкиТипа = Новый Массив();
	Для Каждого Писатель Из ПисателиПолейИсточника() Цикл
		Если СтрНайти(Писатель.Исходник.Код, "АпстримыДопустимы") = 0 Тогда
			БезПроверкиТипа.Добавить(Писатель.Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(БезПроверкиТипа, ", "),
		"писатели внешних источников, не спрашивающие тип пула").Равно("");

КонецПроцедуры

// Форма «переписать поле существующей строки и сохранить» — ей открывают гейт: строка уже есть,
// менять надо адрес.
&Тест
Процедура ДетекторВидитПеренацеливаниеАдреса() Экспорт

	Перенацеливание = "Перем Хранилище;" + Символы.ПС
		+ "Процедура Перенацелить(Знач Ид, Знач Адрес) Экспорт" + Символы.ПС
		+ "	Зеркало = Хранилище.ПолучитьОдноПоИдентификаторРавно(Ид);" + Символы.ПС
		+ "	Зеркало.АпстримURL = Адрес;" + Символы.ПС
		+ "	Зеркало.Сохранить();" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ХранилищеЗеркалХабов"") _Х)" + Символы.ПС
		+ "	Хранилище = _Х;" + Символы.ПС
		+ "КонецПроцедуры";

	Ожидаем.Что(ЭтоПисательИсточников(Разобрать(Перенацеливание)),
		"перенацеливание существующего зеркала — путь записи внешнего источника").ЭтоИстина();
	Ожидаем.Что(ПоляИсточника(Разобрать(Перенацеливание)).Количество() > 0,
		"и оно присваивает поле источника").ЭтоИстина();

	// файл, который зеркала только читает, писателем не объявляется
	Чтение = "Функция Зеркало(Знач Ид) Экспорт" + Символы.ПС
		+ "	Возврат Хранилище.ПолучитьОдноПоИдентификаторРавно(Ид);" + Символы.ПС
		+ "КонецФункции" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ХранилищеЗеркалХабов"") _Х)" + Символы.ПС
		+ "	Хранилище = _Х;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(ЭтоПисательИсточников(Разобрать(Чтение)), "чтение зеркал писателем не делает").ЭтоЛожь();

КонецПроцедуры

// Писатель своих полей строки источника (состояние прогона зеркала) гейту не подлежит: адреса,
// пула и токена он не касается.
&Тест
Процедура ДетекторПолейИсточникаВидитАдресАНеПоляПрогона() Экспорт

	Ожидаем.Что(ПоляИсточника(Разобрать("	Зеркало.АпстримURL = Адрес;")).Количество() > 0,
		"детектор полей видит присвоение адреса").ЭтоИстина();
	Ожидаем.Что(ПоляИсточника(Разобрать("	Апстрим.ПулИдентификатор  =  42;")).Количество() > 0,
		"и перевешивание на другой пул при любых пробелах").ЭтоИстина();
	Ожидаем.Что(ПоляИсточника(Разобрать("	Зеркало.ПрогонКурсор = Курсор;")).Количество(),
		"запись прогона полем источника не считается").Равно(0);

КонецПроцедуры

&Тест
Процедура ДетекторПисателейЛовитЗаведомоПлохойОбразец() Экспорт

	Образец =
	"Перем Хранилище;
	|Процедура Записать()
	|	Апстрим = Хранилище.СоздатьЭлемент();
	|	Апстрим.Url = ""http://evil/"";
	|	Апстрим.Сохранить();
	|КонецПроцедуры
	|Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ХранилищеАпстримовПула"") _Х)
	|	Хранилище = _Х;
	|КонецПроцедуры";

	Исходник = Разобрать(Образец);
	Ожидаем.Что(ЭтоПисательИсточников(Исходник), "детектор видит запись апстрима").ЭтоИстина();
	Ожидаем.Что(ЗнаетИмя(Исходник, "ВалидаторАдресаАпстрима"), "и видит, что гейта у неё нет").ЭтоЛожь();

	Читатель =
	"Процедура Прочитать(&Пластилин(Значение = ""ХранилищеАпстримовПула"") _Х)
	|	Для Каждого А Из _Х.АпстримыУпорядоченно(1) Цикл
	|	КонецЦикла;
	|КонецПроцедуры";
	Ожидаем.Что(ЭтоПисательИсточников(Разобрать(Читатель)), "читатель писателем не считается").ЭтоЛожь();

	Комментарий =
	"// Апстрим = Хранилище.СоздатьЭлемент(); Апстрим.Сохранить();
	|Процедура Ничего(&Пластилин(Значение = ""ХранилищеАпстримовПула"") _Х)
	|КонецПроцедуры";
	Ожидаем.Что(ЭтоПисательИсточников(Разобрать(Комментарий)),
		"закомментированный пример — не запись").ЭтоЛожь();

	Зеркало =
	"Процедура Завести(&Пластилин(Значение = ""ХранилищеЗеркалХабов"") _Х)
	|	Зеркало = _Х.СоздатьЭлемент();
	|	Зеркало.Сохранить();
	|КонецПроцедуры";
	Ожидаем.Что(ЭтоПисательИсточников(Разобрать(Зеркало)), "детектор видит запись зеркала").ЭтоИстина();

КонецПроцедуры

// Литерал — данные, а не директива: гейт, названный строкой, гейтом не считается, а пример
// записи внутри строки писателя не делает.
&Тест
Процедура ЛитералНеДиректива() Экспорт

	ГейтСтрокой =
	"Процедура Записать(Знач Адрес)
	|	Подсказка = ""ВалидаторАдресаАпстрима и АпстримыДопустимы названы только строкой"";
	|	Пример = ""&Пластилин(Значение = """"ВалидаторАдресаАпстрима"""")"";
	|	Апстрим = Хранилище.СоздатьЭлемент();
	|	Апстрим.Url = Адрес;
	|	Апстрим.Сохранить();
	|КонецПроцедуры
	|Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ХранилищеАпстримовПула"") _Х)
	|	Хранилище = _Х;
	|КонецПроцедуры";

	Исходник = Разобрать(ГейтСтрокой);
	Ожидаем.Что(ЭтоПисательИсточников(Исходник), "запись кодом видна").ЭтоИстина();
	Ожидаем.Что(ЗнаетИмя(Исходник, "ВалидаторАдресаАпстрима"),
		"валидатор, названный строкой, гейтом не считается").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Исходник.Код, "АпстримыДопустимы"),
		"тип пула, названный строкой, не спрошен").Равно(0);

	ЗаписьСтрокой =
	"Процедура Показать(&Пластилин(Значение = ""ХранилищеАпстримовПула"") _Х)
	|	Пример = ""Апстрим = Хранилище.СоздатьЭлемент(); Апстрим.Url = Адрес; Апстрим.Сохранить();"";
	|КонецПроцедуры";
	Ожидаем.Что(ЭтоПисательИсточников(Разобрать(ЗаписьСтрокой)),
		"пример записи в строке писателя не делает").ЭтоЛожь();

	МногострочныйЛитерал =
	"Пример = ""Процедура Перенацелить()
	||	Зеркало.АпстримURL = Адрес;
	||КонецПроцедуры"";";
	Ожидаем.Что(ПоляИсточника(Разобрать(МногострочныйЛитерал)).Количество(),
		"присвоение внутри многострочного литерала — не присвоение").Равно(0);

	ХранилищеСтрокой =
	"Процедура Записать()
	|	Имя = ""ХранилищеАпстримовПула"";
	|	Апстрим.Сохранить();
	|КонецПроцедуры";
	Ожидаем.Что(ЭтоПисательИсточников(Разобрать(ХранилищеСтрокой)),
		"хранилище, названное строкой вне внедрения, доступа не даёт").ЭтоЛожь();

КонецПроцедуры

#Область СканПисателейИсточников

// Писатели src/модули, которые присваивают поля внешнего источника: Имя (файл) и Исходник.
// Скан обязан что-то найти: иначе проверки выше зеленели бы на слепом детекторе.
Функция ПисателиПолейИсточника()

	Найденные = Новый Массив();
	Просканировано = 0;

	Для Каждого Модуль Из НайтиФайлы(КаталогиПроекта.Модули(), "*", Ложь) Цикл
		Каталог = ОбъединитьПути(Модуль.ПолноеИмя, "Классы");
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Файл Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			// сами сущность и хранилище — не пути записи, а её реализация
			Если Файл.Имя = "АпстримПула.os" ИЛИ Файл.Имя = "ХранилищеАпстримовПула.os" Тогда
				Продолжить;
			КонецЕсли;
			Просканировано = Просканировано + 1;
			Исходник = Разобрать(ПрочитатьТекстФайла(Файл.ПолноеИмя));
			Если ЭтоПисательИсточников(Исходник) И ПоляИсточника(Исходник).Количество() > 0 Тогда
				Найденные.Добавить(Новый Структура("Имя, Исходник", Файл.Имя, Исходник));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Просканировано > 100, СтрШаблон("просканировано файлов: %1", Просканировано)).ЭтоИстина();
	Ожидаем.Что(Найденные.Количество() >= 2,
		"детектор видит писателей апстримов пула и зеркал в продукте").ЭтоИстина();
	Возврат Найденные;

КонецФункции

// Исходник для скана: Код — текст без комментариев и литералов; Внедрения — имена желудей из
// аннотаций &Пластилин: это директивы, хотя имя в них записано строкой.
Функция Разобрать(Знач Текст)

	Код = ИсходникБезКомментариев.БезКомментариевИЛитералов(Текст);
	СЛитералами = СтрРазделить(ИсходникБезКомментариев.БезКомментариев(Текст), Символы.ПС, Истина);
	СтрокиКода = СтрРазделить(Код, Символы.ПС, Истина);

	Внедрения = Новый Массив();
	Для Индекс = 0 По СтрокиКода.ВГраница() Цикл
		Если СтрНайти(СтрокиКода[Индекс], "&Пластилин(") > 0 Тогда
			ДобавитьВнедрения(Внедрения, СЛитералами[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Код, Внедрения", Код, Внедрения);

КонецФункции

// Имена из аннотаций строки: первый литерал после каждого «&Пластилин(».
Процедура ДобавитьВнедрения(Внедрения, Знач Строка_)

	Остаток = Строка_;
	Позиция = СтрНайти(Остаток, "&Пластилин(");
	Пока Позиция > 0 Цикл
		Остаток = Сред(Остаток, Позиция + СтрДлина("&Пластилин("));
		Открытие = СтрНайти(Остаток, """");
		Если Открытие = 0 Тогда
			Возврат;
		КонецЕсли;
		Остаток = Сред(Остаток, Открытие + 1);
		Закрытие = СтрНайти(Остаток, """");
		Если Закрытие = 0 Тогда
			Возврат;
		КонецЕсли;
		Внедрения.Добавить(Лев(Остаток, Закрытие - 1));
		Остаток = Сред(Остаток, Закрытие + 1);
		Позиция = СтрНайти(Остаток, "&Пластилин(");
	КонецЦикла;

КонецПроцедуры

// Знает ли исходник класс: называет его в коде либо получает желудём.
Функция ЗнаетИмя(Знач Исходник, Знач Имя)
	Возврат СтрНайти(Исходник.Код, Имя) > 0 ИЛИ Исходник.Внедрения.Найти(Имя) <> Неопределено;
КонецФункции

// Пишет ли исходник строки внешнего источника: знает хранилище апстримов либо зеркал
// И создаёт, перевешивает или сохраняет строку, в которой фигурирует источник.
Функция ЭтоПисательИсточников(Знач Исходник)

	ЕстьДоступ = ЗнаетИмя(Исходник, "ХранилищеАпстримовПула")
		ИЛИ ЗнаетИмя(Исходник, "АпстримПула")
		ИЛИ ЗнаетИмя(Исходник, "ХранилищеЗеркалХабов");
	Если НЕ ЕстьДоступ Тогда
		Возврат Ложь;
	КонецЕсли;

	// «.Сохранить()» — триггер намеренно: формой «переписать поле и сохранить» открывают гейт
	Для Каждого Строка_ Из СтрРазделить(Исходник.Код, Символы.ПС, Ложь) Цикл
		Нижняя = НРег(Строка_);
		ЭтоЗапись = СтрНайти(Нижняя, "создатьэлемент") > 0
			ИЛИ СтрНайти(Нижняя, ".сохранить()") > 0
			ИЛИ СтрНайти(Нижняя, "url =") > 0
			ИЛИ СтрНайти(Нижняя, "пулидентификатор =") > 0;
		Если ЭтоЗапись И (СтрНайти(Нижняя, "апстрим") > 0 ИЛИ СтрНайти(Нижняя, "зеркал") > 0) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Поля, которыми пулу даётся либо расширяется внешний источник: адрес, привязка к пулу и токен.
// Пробелы снимаются: «Поле=Значение» и «Поле  =  Значение» ловятся одинаково.
Функция ПоляИсточника(Знач Исходник)

	Поля = СтрРазделить("апстримurl,url,пулидентификатор,пулназначенияидентификатор,токендоступа", ",");

	Найденные = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Исходник.Код, Символы.ПС, Ложь) Цикл
		Плотная = СтрЗаменить(СтрЗаменить(НРег(Строка_), " ", ""), Символы.Таб, "");
		Для Каждого Поле Из Поля Цикл
			Если СтрНайти(Плотная, "." + Поле + "=") > 0 И Найденные.Найти(Поле) = Неопределено Тогда
				Найденные.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция ПрочитатьТекстФайла(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

#КонецОбласти
