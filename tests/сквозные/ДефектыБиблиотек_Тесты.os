// Дефекты чужих библиотек — список к разбору, а не сторожа: каждый тест пропущен безусловно, пишется
// против библиотеки напрямую и позеленеет, когда апстрим починит дефект.

#Использовать asserts
#Использовать entity
#Использовать semver
#Использовать "../фикстуры"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьПробу() Экспорт

	ФайлПробы = РеестрФикстур.Путь("СтрокаПробыДефекта");
	// без ОСени нет ТипЗарегистрирован: повторное подключение в том же процессе гасит Попытка
	Попытка
		ПодключитьСценарий(ФайлПробы, "СтрокаПробыДефекта");
	Исключение
		// уже подключено этим процессом — допустимо
	КонецПопытки;

КонецПроцедуры

#Область Entity

// Авто-DDL строит только PRIMARY KEY: объявить уникальность бизнес-ключа нечем.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 5.4.0.0: авто-DDL строит только PRIMARY KEY по идентификатору, UNIQUE бизнес-ключа не объявить; пользователь хаба видит два одновременных opm push одной версии как две строки версии и недетерминированный latest")
Процедура EntityОтвергаетДубльПоОбъявленномуБизнесКлючу() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	ВставитьПробу(Хранилище, "дубль");

	Ошибка = "";
	Попытка
		ВставитьПробу(Хранилище, "дубль");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"вторая строка с тем же бизнес-ключом обязана быть отвергнута БАЗОЙ, а не сервисом").ЭтоИстина();

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Упавший INSERT оставляет соединение Npgsql рассинхронизированным; снятие пропуска подвешивает прогон.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 5.4.0.0 + sql 1.3.3/Npgsql: после упавшего INSERT следующая операция на соединении виснет навсегда вместо ошибки; пользователь хаба видит зависший запрос, хаб теряет рабочий поток и соединение пула")
Процедура PostgreSQLНеВисаетПослеНарушенияПервичногоКлюча() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	Первый = Хранилище.СоздатьЭлемент();
	Первый.Идентификатор = 777;
	Первый.Метка = "первый";
	Первый.Сохранить();

	Дубль = Хранилище.СоздатьЭлемент();
	Дубль.Идентификатор = 777;
	Дубль.Метка = "дубль";
	Ошибка = "";
	Попытка
		Дубль.Сохранить();
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"нарушение первичного ключа обязано дать ошибку").ЭтоИстина();

	// вот здесь соединение и виснет — операция обязана ВЕРНУТЬСЯ, любым результатом
	ВставитьПробу(Хранилище, "после дубля");
	Ожидаем.Что(МеткаПробы(Хранилище, 777),
		"соединение живо после упавшего INSERT").Равно("первый");

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Чтение и запись КоннектораJSON разведены только внутри процесса, запись усекает целевой файл.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 5.4.0.0: второй процесс на каталоге КоннектораJSON читает таблицу, усечённую записью первого; пользователь хаба видит случайные 502, когда рядом с живым хабом работают сидеры или admin-cli")
Процедура КоннекторJSONВыдерживаетОдновременноеЧтениеИЗапись() Экспорт

	ВоспроизводитсяВне(
		"второй процесс на каталоге работающего хаба: scripts/сидеры при поднятом хабе на "
		+ "КоннектореJSON — читатель одного процесса видит файл, усечённый записью другого.");

КонецПроцедуры

// КоннекторJSON на каждую вставку ищет максимум идентификатора проходом по всей таблице.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 5.4.0.0: вставка в КоннекторJSON линейна по размеру таблицы, массовая вставка квадратична; пользователь хаба видит публикацию и сидеры, дорожающие по мере наполнения файлового бэкенда")
Процедура КоннекторJSONНеПеребираетТаблицуНаКаждуюВставку() Экспорт

	ВоспроизводитсяВне(
		"вставка N строк в таблицу из M на КоннектореJSON: с генерируемым идентификатором время "
		+ "растёт с M, с заданным — нет; разница и есть цена прохода.");

КонецПроцедуры

#КонецОбласти

#Область Semaphore

// Освободить меняет счётчик семафора без блокировки и теряет инкремент.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semaphore 1.1.0: Освободить теряет инкремент без БлокировкаРесурса, и Захватить виснет навсегда; семафор держат autumn (Поделка), winow (Маршрутизатор) и resilience; пользователь хаба видит старт, вставший насмерть: процесс жив, порт не открыт")
Процедура SemaphoreНеТеряетИнкрементВОсвободить() Экспорт

	ВоспроизводитсяВне(
		"8 потоков × 20 000 пар Захватить/Освободить одного семафора — зависание в каждом запуске; "
		+ "тот же объём в одном потоке проходит за доли секунды.");

КонецПроцедуры

#КонецОбласти

#Область Semver

// Составной диапазон одной строкой теряет верхнюю границу; хаб разбирает диапазоны сам.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: «>=1.2.0 <2.0.0» молча теряет верхнюю границу; пользователь хаба видел бы opm install, поставивший запрещённый автором мажор")
Процедура SemverНеТеряетВерхнююГраницуСоставногоДиапазона() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("1.5.0", ">=1.2.0 <2.0.0"),
		"версия внутри составного диапазона принимается").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("2.0.0", ">=1.2.0 <2.0.0"),
		"верхняя граница составного диапазона обязана действовать").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("3.0.0", ">=1.2.0 <2.0.0"),
		"мажор выше верхней границы обязан отсекаться").ЭтоЛожь();

КонецПроцедуры

// Каретка над нулевым мажором фиксирует не первую ненулевую компоненту; хаб разбирает диапазоны сам.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: ^0.0.3 раскрывается в <0.1.0 вместо <0.0.4; пользователь хаба видел бы на нулевых мажорах экосистемы версию со сменившимся API")
Процедура SemverРаскрываетКареткуНадНулевымМажоромПоNpm() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.0.3", "^0.0.3"),
		"сама версия входит в диапазон").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.0.4", "^0.0.3"),
		"^0.0.3 обязана фиксировать ПАТЧ: 0.0.4 вне диапазона").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.2.5", "^0.2.3"),
		"^0.2.3 фиксирует минор: 0.2.5 внутри").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.3.0", "^0.2.3"),
		"^0.2.3 фиксирует минор: 0.3.0 снаружи").ЭтоЛожь();

КонецПроцедуры

// Неразобранный диапазон сводится к «пропустить всё»; хаб разбирает диапазоны сам и отказывает.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: мусорный диапазон из чужого packagedef сводится к >=0.0.0; пользователь хаба видел бы опечатку в диапазоне, которую не отвергли ни публикация, ни резолв")
Процедура SemverОтвергаетМусорныйДиапазон() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", ">=1,2"),
		"диапазон с запятой вместо точки не имеет права пропускать всё").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", "^1.x || ~2.0"),
		"неподдерживаемый оператор || не имеет права пропускать всё").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", "как-нибудь"),
		"мусор не имеет права пропускать всё").ЭтоЛожь();

КонецПроцедуры

// Четырёхкомпонентная легаси-версия не разбирается; хаб держит для неё свою ветку разбора.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: версия 1.2.3.4 не разбирается — ВерсияИзСтроки бросает исключение; пользователь хаба видел бы отказ публикации и сортировки легаси-версий экосистемы")
Процедура SemverРазбираетЛегасиВерсиюИзЧетырёхКомпонент() Экспорт

	Ошибка = "";
	Попытка
		Версии.ВерсияИзСтроки("1.2.3.4");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "легаси-версия 1.2.3.4 обязана разбираться без исключения").Равно("");
	Ожидаем.Что(Версии.ВерсияБольше("1.2.3.10", "1.2.3.4"),
		"четвёртая компонента сравнивается численно, а не лексикографически").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

