#КонецОбласти

#Область OneScript

// Ответ с пустым телом HTTPСоединение в названный выходной файл не пишет: файла нет вовсе.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "OneScript 2.1.0: GET с выходным файлом на ответ 200 с Content-Length: 0 файла не создаёт, а oint отдаёт его путь как скачанный; пользователь хаба на S3 у версии без README получает каждый показ страницы ценой скачивания и распаковки всего .ospx, а журнал — предупреждение «с диска не прочиталось»")
Процедура HTTPСоединениеПишетПустоеТелоВВыходнойФайл() Экспорт

	Выдача = Новый ВыдачаПортов();
	Порт = Выдача.Выдать();
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();

	ВыходнойФайл = ПолучитьИмяВременногоФайла("ospx");
	Параметры = Новый Массив();
	Параметры.Добавить(Порт);
	Параметры.Добавить(ВыходнойФайл);
	Задания = Новый Массив();

	Попытка
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СкачатьВФайл", Параметры));
		Соединение = ПервоеСоединение(Сервер);
		Соединение.ТаймаутЧтения = 5000;
		Соединение.ПрочитатьДвоичныеДанные();
		Соединение.ОтправитьСтроку("HTTP/1.1 200 OK" + Символы.ВК + Символы.ПС
			+ "Content-Length: 0" + Символы.ВК + Символы.ПС
			+ "Connection: close" + Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС);
		ФоновыеЗадания.ОжидатьВсе(Задания, 30000);
		Соединение.Закрыть();
	Исключение
		Сервер.Остановить();
		Выдача.ВернутьВсе();
		ВызватьИсключение;
	КонецПопытки;
	Сервер.Остановить();
	Выдача.ВернутьВсе();

	Ожидаем.Что(Новый Файл(ВыходнойФайл).Существует(),
		"пустое тело ответа обязано лечь в выходной файл пустым файлом").ЭтоИстина();
	Ожидаем.Что(Новый Файл(ВыходнойФайл).Размер()).Равно(0);
	УдалитьФайлы(ВыходнойФайл);

КонецПроцедуры

// Задание пробы: клиентская сторона держит поток, пока слушатель набора не ответит.
Процедура СкачатьВФайл(Знач Порт, Знач ВыходнойФайл) Экспорт
	Соединение = Новый HTTPСоединение("127.0.0.1", Порт, , , , 10);
	Соединение.ВызватьHTTPМетод("GET", Новый HTTPЗапрос("/empty"), ВыходнойФайл);
КонецПроцедуры

// ОжидатьСоединения выжидает свой таймаут целиком, даже когда клиент уже пришёл: ждём ломтями.
Функция ПервоеСоединение(Знач Сервер)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 20000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Соединение = Сервер.ОжидатьСоединения(200);
		Если Соединение <> Неопределено Тогда
			Возврат Соединение;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "клиент пробы не пришёл к слушателю за 20 с";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дефект достижим только вне процесса OneUnit: тело падает громко и называет команду воспроизведения.
Процедура ВоспроизводитсяВне(Знач Команда)
	ВызватьИсключение "воспроизведение вне процесса OneUnit: " + Команда;
КонецПроцедуры

Функция ХранилищеПробыPostgreSQL(Знач ТипПробы)

	DSN = ПолучитьПеременнуюСреды("OSHUB_TEST_PG_DSN");
	Если НЕ ЗначениеЗаполнено(DSN) Тогда
		ВызватьИсключение "нужна переменная окружения OSHUB_TEST_PG_DSN со строкой соединения PostgreSQL";
	КонецЕсли;

	Менеджер = Новый МенеджерСущностей(Новый ИсточникДанных("проба-дефекта", Тип("КоннекторPostgreSQL"), DSN));
	Менеджер.ДобавитьКлассВМодель(ТипПробы);
	Менеджер.Инициализировать();

	Возврат Менеджер.ПолучитьХранилищеСущностей(ТипПробы);

КонецФункции

Функция ВставитьПробу(Хранилище, Знач Метка)
	Элемент = Хранилище.СоздатьЭлемент();
	Элемент.Метка = Метка;
	Элемент.Сохранить();
	Возврат Элемент;
КонецФункции

Функция МеткаПробы(Хранилище, Знач Идентификатор)
	Опции = Новый ОпцииПоиска();
	Опции.Отбор("Идентификатор", ВидСравнения.Равно, Идентификатор);
	Найденное = Хранилище.ПолучитьОдно(Опции);
	Возврат ?(Найденное = Неопределено, "<строки нет>", Строка(Найденное.Метка));
КонецФункции

Функция ЧислоПробы(Хранилище, Знач Идентификатор)
	Опции = Новый ОпцииПоиска();
	Опции.Отбор("Идентификатор", ВидСравнения.Равно, Идентификатор);
	Найденное = Хранилище.ПолучитьОдно(Опции);
	Возврат ?(Найденное = Неопределено, Неопределено, Найденное.Число);
КонецФункции

Процедура ОчиститьПробы(Хранилище)
	Для Каждого Элемент Из Хранилище.Получить() Цикл
		Хранилище.Удалить(Элемент);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
