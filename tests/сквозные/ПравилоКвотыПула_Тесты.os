// Правило квоты пула по всему дереву: тексты и статьи утверждают действующее правило, каждый вход
// к записи квоты спрашивает право, апстримная версия заводится одним швом реестра.

#Использовать asserts
#Использовать "../фикстуры"

Перем КодКлассов;   // Соответствие: имя файла класса → код без комментариев и литералов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура НиОдинТекстНеОбещаетЧтоКэшМимоКвоты() Экспорт

	// снятое правило «кэш прокси в квоту не входит»; сравнение — в нижнем регистре обеих сторон
	Запреты = СтрРазделить("в квоту пула не входят|только собственные публикации"
		+ "|по суммарному размеру собственных версий|квота меряет только"
		+ "|в квоту не входит|в квоту не входят", "|", Ложь);

	Нарушители = Новый Массив();
	Для Каждого Файл Из ФайлыПравилаКвоты() Цикл
		Текст = НРег(ПрочитатьТекст(Файл.ПолноеИмя));
		Для Каждого Запрет Из Запреты Цикл
			Если СтрНайти(Текст, НРег(Запрет)) > 0 Тогда
				Нарушители.Добавить(Файл.Имя + ": " + Запрет);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"тексты и документация обещают правило квоты, которого больше нет").Равно("");

КонецПроцедуры

// Места, где хаб объясняет правило заранее, — экранные тексты и статья — утверждают действующее
// правило. Текст самого отказа стережёт КвотаПула_Тесты по сообщению отказа.
&Тест
Процедура ТекстыИСтатьяУтверждаютЧтоКэшВКвоте() Экспорт

	Обязательные = Новый Соответствие();
	Обязательные.Вставить("src/модули/интерфейс/Классы/кабинет/СловарьКабинета.os",
		"кэш прокси|уборка кэша прокси");
	Обязательные.Вставить("docs/кэширующий-прокси.md", "квота меряет|кэш прокси");

	Пропажи = Новый Массив();
	Для Каждого КлючЗначение Из Обязательные Цикл
		Путь = ОбъединитьПути(КореньПроекта(), СтрЗаменить(КлючЗначение.Ключ, "/", ПолучитьРазделительПути()));
		Если НЕ Новый Файл(Путь).Существует() Тогда
			Пропажи.Добавить(КлючЗначение.Ключ + ": файла нет");
			Продолжить;
		КонецЕсли;
		Текст = НРег(ПрочитатьТекст(Путь));
		Для Каждого Утверждение Из СтрРазделить(КлючЗначение.Значение, "|", Ложь) Цикл
			Если СтрНайти(Текст, НРег(Утверждение)) = 0 Тогда
				Пропажи.Добавить(КлючЗначение.Ключ + ": нет «" + Утверждение + "»");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропажи, ", "),
		"место, где правило квоты объясняется человеку, перестало его утверждать").Равно("");

КонецПроцедуры

&Тест
Процедура ВнешнююВерсиюЗаводитТолькоОдинМетодРеестра() Экспорт

	// прокси и зеркала заводят апстримную версию одним швом — ИндексироватьВнешнюю
	Нарушители = Новый Массив();
	Для Каждого КлючЗначение Из КодКлассовПродукта() Цикл
		Если КлючЗначение.Ключ = "СервисВерсий.os" ИЛИ КлючЗначение.Ключ = "СервисПроисхождения.os" Тогда
			Продолжить; // сам шов и хозяин словаря источников
		КонецЕсли;
		Если СтавитПровенансАпстрима(КлючЗначение.Значение) Тогда
			Нарушители.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"провенанс «апстрим» ставится мимо СервисВерсий.ИндексироватьВнешнюю").Равно("");

КонецПроцедуры

&Тест
Процедура КаждыйВходККвотеСпрашиваетСвойГвард() Экспорт

	// входа списком нет: вход узнаётся по тому, что он делает
	Входы = Новый Массив();
	Безгвардейные = Новый Массив();

	Для Каждого КлючЗначение Из КодКлассовПродукта() Цикл
		Если НЕ ПишетКвотуПула(КлючЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Входы.Добавить(КлючЗначение.Ключ);
		Если НЕ СпрашиваетГвардКвоты(КлючЗначение.Значение) Тогда
			Безгвардейные.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Безгвардейные, ", "),
		"вход к квоте пула, не спрашивающий ГвардКвотыПула").Равно("");

	// сканер не вхолостую: входы найдены, и среди них оба экранных
	Ожидаем.Что(Входы.Количество() >= 4,
		СтрШаблон("сканер нашёл входы к записи квоты (найдено: %1)",
			СтрСоединить(Входы, ", "))).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Входы, ", "), "среди входов — пульт раздела «Пулы»")
		.Содержит("ПультПулов.os");
	Ожидаем.Что(СтрСоединить(Входы, ", "), "и дом настроек пула")
		.Содержит("КонтроллерДомаПула.os");

КонецПроцедуры

&Тест
Процедура СканерыЧитаютКодАНеЛитералИКомментарий() Экспорт

	Кавычка = """";
	ВходВЛитерале = "Процедура Подсказка()" + Символы.ПС
		+ "	Текст = " + Кавычка + "Пулы.УстановитьКвоту(Пул, 10)" + Кавычка + ";" + Символы.ПС
		+ "	// Пулы.СоздатьПул(Имя)" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(ПишетКвотуПула(Код(ВходВЛитерале)),
		"запись квоты в литерале и комментарии — не вход к квоте").ЭтоЛожь();

	ГвардВЛитерале = "Процедура Сохранить()" + Символы.ПС
		+ "	Пулы.УстановитьКвоту(Пул, 10);" + Символы.ПС
		+ "	Совет = " + Кавычка + "ГвардКвоты.МожетМенятьКвоту(Кто)" + Кавычка + ";" + Символы.ПС
		+ "	// Квоты.ТребоватьПраво(Кто)" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(ПишетКвотуПула(Код(ГвардВЛитерале)), "вход в коде виден").ЭтоИстина();
	Ожидаем.Что(СпрашиваетГвардКвоты(Код(ГвардВЛитерале)),
		"вопрос к гварду в литерале и комментарии не защищает вход").ЭтоЛожь();

	ПровенансВЛитерале = "Процедура Пометить()" + Символы.ПС
		+ "	Текст = " + Кавычка + "Происхождение.Зафиксировать(Версия, ИсточникАпстрим())" + Кавычка + ";" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(СтавитПровенансАпстрима(Код(ПровенансВЛитерале)),
		"провенанс в литерале — не запись провенанса").ЭтоЛожь();

	ПровенансВКоде = "Процедура Пометить()" + Символы.ПС
		+ "	Происхождение.Зафиксировать(Версия, Источники.ИсточникАпстрим());" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(СтавитПровенансАпстрима(Код(ПровенансВКоде)),
		"провенанс в коде виден").ЭтоИстина();

КонецПроцедуры

// Вход к квоте — вызов через точку; создание пула — тоже вход: квота его параметр.
Функция ПишетКвотуПула(Знач Код)
	Возврат СтрНайти(Код, ".УстановитьКвоту(") > 0
		ИЛИ СтрНайти(Код, ".СоздатьПул(") > 0;
КонецФункции

// Засчитывается только вопрос о праве, а не суд значения квоты.
Функция СпрашиваетГвардКвоты(Знач Код)
	Возврат СтрНайти(Код, "ГвардКвоты.МожетМенятьКвоту(") > 0
		ИЛИ СтрНайти(Код, "Квоты.ТребоватьПраво(") > 0;
КонецФункции

Функция СтавитПровенансАпстрима(Знач Код)
	Возврат СтрНайти(Код, "ИсточникАпстрим()") > 0 И СтрНайти(Код, "Зафиксировать(") > 0;
КонецФункции

Функция Код(Знач Исходник)
	Возврат ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходник);
КонецФункции

// Корпус, где правило квоты объясняется словами: продуктовый код, статьи docs и корневой README.
Функция КореньПроекта()
	Возврат КаталогиПроекта.Корень();
КонецФункции

Функция ФайлыПравилаКвоты()

	Корень = КореньПроекта();
	Файлы = Новый Массив();
	Для Каждого Найденный Из НайтиФайлы(ОбъединитьПути(Корень, "src"), "*.os", Истина) Цикл
		Файлы.Добавить(Найденный);
	КонецЦикла;
	Для Каждого Найденный Из НайтиФайлы(ОбъединитьПути(Корень, "docs"), "*.md", Истина) Цикл
		Файлы.Добавить(Найденный);
	КонецЦикла;
	Для Каждого Найденный Из НайтиФайлы(Корень, "README.md", Ложь) Цикл
		Файлы.Добавить(Найденный);
	КонецЦикла;

	Ожидаем.Что(Файлы.Количество() > 300,
		СтрШаблон("корпус скана правила квоты выродился: файлов %1", Файлы.Количество())).ЭтоИстина();
	Возврат Файлы;

КонецФункции

// Код классов читается один раз на набор: оба сканера идут по одному корпусу.
Функция КодКлассовПродукта()

	Если КодКлассов = Неопределено Тогда
		КодКлассов = Новый Соответствие();
		Для Каждого Файл Из НайтиФайлы(КаталогиПроекта.Модули(), "*.os", Истина) Цикл
			КодКлассов.Вставить(Файл.Имя, Код(ПрочитатьТекст(Файл.ПолноеИмя)));
		КонецЦикла;
	КонецЕсли;
	Возврат КодКлассов;

КонецФункции

Функция ПрочитатьТекст(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "utf-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции
