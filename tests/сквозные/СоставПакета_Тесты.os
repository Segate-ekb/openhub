// Пакет .ospx несёт рантайм-закрытие зависимостей хаба и не несёт того, чего рантайм не грузит:
// состав — по архиву, который собирает хук ПриСборке из packagedef, закрытие — по коду.

#Использовать asserts
#Использовать packageinfo
#Использовать tempfiles
#Использовать "../фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогПроекта;
Перем КаталогМодулей;
Перем ТекстМанифеста;   // Строка - packagedef без комментариев
Перем Поставка;         // сценарий tools/ПоставкаЗависимостей.os
Перем СобранныеЗаписи;  // Соответствие - путь записи в архиве пакета -> Истина; собирается один раз

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "oscript_modules");
	ТекстМанифеста = ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(ОбъединитьПути(КаталогПроекта, "packagedef")));
	Поставка = ЗагрузитьСценарий(ОбъединитьПути(КаталогПроекта, "tools", "ПоставкаЗависимостей.os"));

КонецПроцедуры

#Область СамотестыДетекторов

&Тест
Процедура ДетекторыСоставаНеПусты() Экспорт

	// Самотест: разбор, дающий пустоту, делает остальные тесты набора вечнозелёными —
	// тогда любая потеря библиотеки проходит незамеченной.
	Ожидаем.Что(ПакетыПоставки().Количество(), "библиотек в поставке пакета").Больше(20);
	Ожидаем.Что(КорниЗависимостей().Количество(), "корней зависимостей хаба").Больше(10);
	Ожидаем.Что(ЗакрытиеЗависимостей().Количество(), "закрытие зависимостей хаба").Больше(20);

КонецПроцедуры

&Тест
Процедура РазборМанифестаНеВидитЗакомментированныхВключений() Экспорт

	// Закомментировать строку — самый обычный способ выключить включение файла, и по
	// сырому тексту сторож считал бы её действующей. Тот же промах в обратную сторону —
	// комментарий, ПОКАЗЫВАЮЩИЙ пример вызова, сторож засчитывал за настоящий путь.
	// Имена в образце ВЫМЫШЛЕННЫЕ: настоящие в литерале ловятся скан-тестами соседних
	// наборов как настоящие директивы.
	Образец = ".ВключитьФайл(""src"")" + Символы.ПС
		+ "	// .ВключитьФайл(""сказка"")" + Символы.ПС
		+ "	// Пример вызова в тексте комментария: .ВключитьФайл(""присказка"")" + Символы.ПС
		+ "	.ВключитьФайл(""быль"") // .ВключитьФайл(""небылица"")";

	Ожидаем.Что(СтрСоединить(ПутиИзТекстаМанифеста(ИсходникБезКомментариев.БезКомментариев(Образец)), ", "),
		"пути, увиденные разбором в образце с комментариями")
		.Равно("src, быль");

КонецПроцедуры

&Тест
Процедура РазборИсходниковНеВидитЗакомментированныхИмпортов() Экспорт

	// Имена вымышленные — по той же причине, что и в образце выше.
	Образец = "#Использовать сказка" + Символы.ПС
		+ "// #Использовать небылица" + Символы.ПС
		+ "	#Использовать быль-небыль";

	Ожидаем.Что(СтрСоединить(ИменаИзТекстаИсходника(Образец), ", "),
		"импорты, увиденные разбором в образце с комментариями")
		.Равно("сказка, быль-небыль");

КонецПроцедуры

&Тест
Процедура КаждаяНеТестоваяЗависимостьЗакрытияУстановлена() Экспорт

	// Закрытие строится по объявлениям dev="false". Если такая зависимость не
	// установлена, закрытие молча сузится, и тест про полноту поставки её не хватится —
	// падать об этом надо здесь, с именем пакета.
	Ожидаем.Что(СтрСоединить(Отсортированный(НеустановленныеЗависимости()), ", "),
		"рантайм-зависимости закрытия, которых нет в oscript_modules").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СоставПакета

&Тест
Процедура ПакетНесётВсёЗакрытиеЗависимостей() Экспорт

	ВПоставке = ПакетыПоставки();
	Недостающие = Новый Массив();

	Для Каждого КлючЗначение Из ЗакрытиеЗависимостей() Цикл
		Если ВПоставке.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Недостающие.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отсортированный(Недостающие), ", "),
		"библиотеки из закрытия зависимостей, не попавшие в поставку"
		+ " (образ ставится без hub.oscript.io — чего нет в пакете, того нет в рантайме)")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ПакетНеНесётБиблиотекВнеЗакрытия() Экспорт

	Закрытие = ЗакрытиеЗависимостей();
	Лишние = Новый Массив();

	Для Каждого КлючЗначение Из ПакетыПоставки() Цикл
		Если Закрытие.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Лишние.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отсортированный(Лишние), ", "),
		"библиотеки в поставке, которых рантайм хаба не требует: dev-зависимости и посторонние"
		+ " библиотеки oscript_modules разработчика").Равно("");

КонецПроцедуры

&Тест
Процедура ФайлыИзОписанийБиблиотекЕдутВПакете() Экспорт

	// lib.config называет файлы, которые OneScript компилирует при #Использовать: потерянный
	// вырезом файл роняет старт хаба на загрузке библиотеки.
	Объявлено = 0;
	Потерянные = Новый Массив();

	Для Каждого Запись Из ЗаписиПакета() Цикл

		Если НЕ СтрЗаканчиваетсяНа(Запись.Ключ, "/lib.config") Тогда
			Продолжить;
		КонецЕсли;

		КаталогОписания = Лев(Запись.Ключ, СтрДлина(Запись.Ключ) - СтрДлина("/lib.config"));
		Для Каждого Путь Из ФайлыОписанияБиблиотеки(ОбъединитьПути(КаталогПроекта, Запись.Ключ)) Цикл
			Объявлено = Объявлено + 1;
			Файл = НормализованныйПуть(КаталогОписания + "/" + Путь);
			Если ЗаписиПакета().Получить(Файл) = Неопределено Тогда
				Потерянные.Добавить(Файл);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(Объявлено, "файлов, объявленных в lib.config библиотек поставки").Больше(100);
	Ожидаем.Что(СтрСоединить(Потерянные, ", "), "объявленные в lib.config файлы, которых нет в пакете")
		.Равно("");

КонецПроцедуры

&Тест
Процедура КомпонентыДляOneScript2ЕдутВПакете() Экспорт

	// Загрузчик библиотеки на OneScript 2 подключает всё из Components/dotnet; без этих
	// сборок entity не откроет базу, а хаб не отправит письма.
	Проверено = 0;
	Потерянные = Новый Массив();

	Для Каждого КлючЗначение Из ПакетыПоставки() Цикл
		КаталогСборок = ОбъединитьПути(Новый Файл(КаталогМодулей).ПолноеИмя, КлючЗначение.Ключ, "Components", "dotnet");
		Для Каждого Файл Из НайтиФайлы(КаталогСборок, ПолучитьМаскуВсеФайлы(), Истина) Цикл
			Если НЕ Файл.ЭтоФайл() Тогда
				Продолжить;
			КонецЕсли;
			Проверено = Проверено + 1;
			Запись = ЗаписьПоФайлу(Файл.ПолноеИмя);
			Если ЗаписиПакета().Получить(Запись) = Неопределено Тогда
				Потерянные.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено, "файлов Components/dotnet у библиотек поставки").Больше(10);
	Ожидаем.Что(СтрСоединить(Потерянные, ", "), "сборки для OneScript 2, которых нет в пакете").Равно("");

КонецПроцедуры

&Тест
Процедура ИсходникиБиблиотекЕдутВПакете() Экспорт

	// Библиотеки без lib.config OneScript грузит по соглашению (Классы, Модули, src/…) или своим
	// package-loader.os; потерянный вырезом исходник роняет старт хаба так же, как файл из lib.config.
	Проверено = 0;
	Потерянные = Новый Массив();

	Для Каждого КлючЗначение Из ПакетыПоставки() Цикл
		Для Каждого Файл Из ИсходникиБиблиотеки(ОбъединитьПути(Новый Файл(КаталогМодулей).ПолноеИмя, КлючЗначение.Ключ)) Цикл
			Проверено = Проверено + 1;
			Запись = ЗаписьПоФайлу(Файл);
			Если ЗаписиПакета().Получить(Запись) = Неопределено Тогда
				Потерянные.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено, "исходников библиотек поставки в каталогах соглашения и корне").Больше(500);
	Ожидаем.Что(СтрСоединить(Потерянные, ", "), "исходники библиотек, которых нет в пакете").Равно("");

КонецПроцедуры

&Тест
Процедура ВходыХабаВOintИзвестны() Экспорт

	// Вырез компонент oint в tools/ПоставкаЗависимостей.os доказан для этих входов. Новый вход —
	// новый путь к компонентам: красный здесь значит «перепроверь список выреза».
	Известные = Новый Массив();
	Для Каждого Имя Из СтрРазделить("OPI_GRPC,OPI_S3,OPI_ЗапросыHTTP,OPI_РасширенныйВызов", ",") Цикл
		Известные.Добавить(Имя);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отсортированный(КлючиСоответствия(ВходыВOint())), ", "),
		"модули oint, которые зовут src и библиотеки поставки; новый вход — перепроверь вырез компонент"
		+ " oint в tools/ПоставкаЗависимостей.os").Равно(СтрСоединить(Отсортированный(Известные), ", "));

КонецПроцедуры

&Тест
Процедура КомпонентыOintНаПутяхХабаЕдутВПакете() Экспорт

	// oint подключает компоненту только через OPI_Компоненты.ПолучитьКомпоненту("<Имя>") — файл
	// addins/OPI_<Имя>.zip. Компонента, которую зовёт модуль oint, достижимый от входов хаба, и
	// которой нет в пакете, роняет хаб на первом обращении.
	Достижимые = ДостижимыеМодулиOint(ВходыВOint());
	Компоненты = Новый Соответствие();
	ПоИмениИзПеременной = Новый Массив();

	Для Каждого КлючЗначение Из Достижимые Цикл
		Если Новый Файл(КлючЗначение.Значение).Имя = "OPI_Компоненты.os" Тогда
			Продолжить;
		КонецЕсли;
		Текст = ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(КлючЗначение.Значение));
		ВызовыКомпонентOint(Текст, Компоненты, ПоИмениИзПеременной, КлючЗначение.Ключ);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(ПоИмениИзПеременной, ", "),
		"модули oint на путях хаба, подключающие компоненту по имени из переменной: вырез не доказать").Равно("");
	Ожидаем.Что(Компоненты.Количество(), "компонент oint на путях хаба (S3, HTTP, gRPC телеметрии)").Больше(1);

	Потерянные = Новый Массив();
	Для Каждого КлючЗначение Из Компоненты Цикл
		Запись = СтрШаблон("oscript_modules/oint/addins/%1.zip", КлючЗначение.Ключ);
		Если ЗаписиПакета().Получить(Запись) = Неопределено Тогда
			Потерянные.Добавить(Запись + " (зовёт " + КлючЗначение.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Потерянные, ", "), "компоненты oint на путях хаба, которых нет в пакете").Равно("");

КонецПроцедуры

&Тест
Процедура РазборВходовВOintНеВидитКомментариевИЛитералов() Экспорт

	// Имена вымышленные: разбор видит любой идентификатор OPI_*, отбор по модулям oint — позже.
	Образец = "Ответ = OPI_Сказка.Метод();" + Символы.ПС
		+ "// OPI_Небылица.Метод()" + Символы.ПС
		+ "Текст = ""OPI_Присказка.Метод()"";";

	Ожидаем.Что(СтрСоединить(КлючиСоответствия(ИменаOPIВКоде(ИсходникБезКомментариев.БезКомментариевИЛитералов(Образец))), ", "),
		"входы, увиденные разбором в образце с комментарием и литералом").Равно("OPI_Сказка");

КонецПроцедуры

&Тест
Процедура РазборВызововКомпонентOintВидитИмяИзПеременной() Экспорт

	Компоненты = Новый Соответствие();
	ПоИмениИзПеременной = Новый Массив();
	Образец = "К = OPI_Компоненты.ПолучитьКомпоненту(""Сказка"");" + Символы.ПС
		+ "К = OPI_Компоненты.ПолучитьКомпоненту(""OPI_Быль"", ""Main"");" + Символы.ПС
		+ "К = OPI_Компоненты.ПолучитьКомпоненту(Вид);";

	ВызовыКомпонентOint(Образец, Компоненты, ПоИмениИзПеременной, "образец");

	Ожидаем.Что(СтрСоединить(Отсортированный(КлючиСоответствия(Компоненты)), ", "), "компоненты по литералу")
		.Равно("OPI_Быль, OPI_Сказка");
	Ожидаем.Что(СтрСоединить(ПоИмениИзПеременной, ", "), "вызов по имени из переменной").Равно("образец: Вид");

КонецПроцедуры

&Тест
Процедура ВключённыеПутиСуществуют() Экспорт

	Пропавшие = Новый Массив();

	Для Каждого ОтносительныйПуть Из ВключённыеПути() Цикл
		Файл = Новый Файл(ОбъединитьПути(КаталогПроекта, ОтносительныйПуть));
		Если НЕ Файл.Существует() Тогда
			Пропавшие.Добавить(ОтносительныйПуть);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропавшие, ", "),
		"пути из .ВключитьФайл, которых нет на диске — opm build упадёт на них").Равно("");

КонецПроцедуры

&Тест
Процедура ПакетНесётИсходникиИКонфигурациюПоУмолчанию() Экспорт

	Включённые = Новый Соответствие();
	Для Каждого Путь Из ВключённыеПути() Цикл
		Включённые.Вставить(Путь, Истина);
	КонецЦикла;

	Обязательные = СтрРазделить("src,README.md,autumn-properties.json", ",");
	Пропущенные = Новый Массив();
	Для Каждого Имя Из Обязательные Цикл
		Если Включённые.Получить(Имя) = Неопределено Тогда
			Пропущенные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "),
		"обязательное содержимое пакета: без autumn-properties.json образ поднимается"
		+ " на значениях по умолчанию из аннотаций, а не на конфигурации поставки").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОтборПоставки

&Тест
Процедура ПоставкаБерётРантаймЗакрытиеБезПостороннихИDevЗависимостей() Экспорт

	// «общая» — dev-зависимость корня, но рантайм-зависимость «нужной»: рантайму она нужна и едет.
	Песочница = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьБиблиотеку(Песочница, "корень", "нужная", "общая,для-тестов");
	ЗаписатьБиблиотеку(Песочница, "нужная", "общая", "");
	ЗаписатьБиблиотеку(Песочница, "общая", "", "");
	ЗаписатьБиблиотеку(Песочница, "для-тестов", "", "");
	ЗаписатьБиблиотеку(Песочница, "посторонняя", "", "");

	Ожидаем.Что(СтрСоединить(Отсортированный(Поставка.Библиотеки(Песочница, Корень("корень"))), ", "),
		"библиотеки поставки").Равно("корень, нужная, общая");

КонецПроцедуры

&Тест
Процедура ПоставкаБезУстановленнойЗависимостиОстанавливаетСборку() Экспорт

	Песочница = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьБиблиотеку(Песочница, "корень", "пропавшая", "");

	Попытка
		Поставка.Библиотеки(Песочница, Корень("корень"));
		Ошибка = "";
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "отказ называет неустановленную зависимость").Содержит("пропавшая");
	Ожидаем.Что(Ошибка, "и ведёт к установке").Содержит("opm install -l");

КонецПроцедуры

&Тест
Процедура ПоставкаНесётФайлыБиблиотекИЗагрузчикКаталога() Экспорт

	Песочница = ВременныеФайлы.СоздатьКаталог();
	ЗаписатьБиблиотеку(Песочница, "корень", "", "");
	ЗаписатьФайл(ОбъединитьПути(Песочница, "package-loader.os"));
	ЗаписатьФайл(ОбъединитьПути(Песочница, "корень", "src", "Класс.os"));
	ЗаписатьФайл(ОбъединитьПути(Песочница, "корень", "tests", "Класс_Тесты.os"));

	Файлы = Новый Массив();
	Для Каждого Файл Из Поставка.Файлы(Песочница, Корень("корень")) Цикл
		Файлы.Добавить(СтрЗаменить(Сред(Файл, СтрДлина(Новый Файл(Песочница).ПолноеИмя) + 2), "\", "/"));
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отсортированный(Файлы), ", "), "файлы поставки песочницы")
		.Равно("package-loader.os, корень/opm-metadata.xml, корень/src/Класс.os");

КонецПроцедуры

&Тест
Процедура ТестыДокументацияИПримерыБиблиотекНеЕдут() Экспорт

	Для Каждого Каталог Из СтрРазделить("tests,docs,examples,features,.github", ",") Цикл
		Ожидаем.Что(Поставка.НуженРантайму("библиотека", Каталог + "/файл.os"), Каталог + "/ в корне библиотеки")
			.ЭтоЛожь();
	КонецЦикла;

	// Каталог с тем же именем глубже корня — часть исходников, его читает lib.config.
	Ожидаем.Что(Поставка.НуженРантайму("библиотека", "src/docs/Модуль.os"), "src/docs/ внутри исходников")
		.ЭтоИстина();
	Ожидаем.Что(Поставка.НуженРантайму("библиотека", "lib.config"), "lib.config").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СборкиКомпонентДляOneScript1НеЕдут() Экспорт

	Ожидаем.Что(Поставка.НуженРантайму("sql", "Components/net4/1script_sql.dll"), "Components/net4")
		.ЭтоЛожь();
	Ожидаем.Что(Поставка.НуженРантайму("sql", "Components/dotnet/1script_sql.dll"), "Components/dotnet")
		.ЭтоИстина();
	Ожидаем.Что(Поставка.НуженРантайму("sql", "Components/dotnet/runtimes/linux-x64/native/SQLite.Interop.dll"),
		"родные библиотеки сборок для OneScript 2").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КомпонентыOintВырезаютсяТолькоНеподключаемыеХабом() Экспорт

	Ожидаем.Что(Поставка.НуженРантайму("oint", "addins/OPI_SQLite.zip"), "SQLite oint").ЭтоЛожь();
	Ожидаем.Что(Поставка.НуженРантайму("oint", "addins/OPI_GRPC.zip"), "GRPC oint").ЭтоИстина();
	Ожидаем.Что(Поставка.НуженРантайму("oint", "addins/OPI_Cryptography.zip"), "Cryptography oint").ЭтоИстина();

	// Компоненту, о которой ничего не доказано, вырез не трогает.
	Ожидаем.Что(Поставка.НуженРантайму("oint", "addins/OPI_Новая.zip"), "незнакомая компонента oint").ЭтоИстина();
	Ожидаем.Что(Поставка.НуженРантайму("другая", "addins/OPI_SQLite.zip"), "одноимённый файл другой библиотеки")
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВключённыеПути()
	Возврат ПутиИзТекстаМанифеста(ТекстМанифеста);
КонецФункции

// Пути из .ВключитьФайл("…"), в порядке объявления. Текст обязан прийти без комментариев.
Функция ПутиИзТекстаМанифеста(Знач Текст)

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("\.ВключитьФайл\(""([^""]+)""\)");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Текст) Цикл
		Результат.Добавить(Совпадение.Группы[1].Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записи oscript_modules в архиве, который собирает хук ПриСборке из packagedef — так же, как
// его зовёт opm build: с текущим каталогом в корне проекта и описанием пакета из манифеста.
Функция ЗаписиПакета()

	Если СобранныеЗаписи <> Неопределено Тогда
		Возврат СобранныеЗаписи;
	КонецЕсли;

	ФайлАрхива = ВременныеФайлы.НовоеИмяФайла("zip");
	Манифест = ЗагрузитьСценарий(ОбъединитьПути(КаталогПроекта, "packagedef"),
		Новый Структура("Описание", Новый ОписаниеПакета()));

	Прежний = ТекущийКаталог();
	УстановитьТекущийКаталог(КаталогПроекта);
	Попытка
		Архив = Новый ЗаписьZIPФайла(ФайлАрхива, , , МетодСжатияZIP.Копирование);
		Манифест.ПриСборке(КаталогПроекта, Архив);
		Архив.Записать();
	Исключение
		УстановитьТекущийКаталог(Прежний);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьТекущийКаталог(Прежний);

	СобранныеЗаписи = Новый Соответствие();
	Чтение = Новый ЧтениеZipФайла(ФайлАрхива);
	Для Каждого Элемент Из Чтение.Элементы Цикл
		СобранныеЗаписи.Вставить(СтрЗаменить(Элемент.ПолноеИмя, "\", "/"), Истина);
	КонецЦикла;
	Чтение.Закрыть();

	Возврат СобранныеЗаписи;

КонецФункции

// Имена библиотек, чьи файлы едут в пакете.
Функция ПакетыПоставки()

	Результат = Новый Соответствие();

	Для Каждого Запись Из ЗаписиПакета() Цикл
		Сегменты = СтрРазделить(Запись.Ключ, "/");
		Если Сегменты.Количество() > 2 И Сегменты[0] = "oscript_modules" Тогда
			Результат.Вставить(Сегменты[1], Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Путь записи архива для файла oscript_modules, найденного от Новый Файл(КаталогМодулей).ПолноеИмя.
Функция ЗаписьПоФайлу(Знач ПолныйПуть)
	Возврат "oscript_modules/" + СтрЗаменить(Сред(ПолныйПуть, СтрДлина(Новый Файл(КаталогМодулей).ПолноеИмя) + 2), "\", "/");
КонецФункции

// Исходники, которые грузит загрузчик библиотеки: *.os в корне (там же свой package-loader.os)
// и во всём дереве каталогов соглашения.
Функция ИсходникиБиблиотеки(Знач КаталогБиблиотеки)

	Результат = Новый Массив();

	Для Каждого Файл Из НайтиФайлы(КаталогБиблиотеки, "*.os", Ложь) Цикл
		Результат.Добавить(Файл.ПолноеИмя);
	КонецЦикла;

	Для Каждого Каталог Из СтрРазделить("Классы,Classes,Модули,Modules,src", ",") Цикл
		Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КаталогБиблиотеки, Каталог), "*.os", Истина) Цикл
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Модули oint, которые зовут src и библиотеки поставки, кроме самой oint: имя -> Истина.
Функция ВходыВOint()

	МодулиOint = МодулиOint();
	Результат = Новый Соответствие();

	Файлы = Новый Массив();
	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Истина) Цикл
		Файлы.Добавить(Файл.ПолноеИмя);
	КонецЦикла;
	Для Каждого Запись Из ЗаписиПакета() Цикл
		Если СтрЗаканчиваетсяНа(Запись.Ключ, ".os") И НЕ СтрНачинаетсяС(Запись.Ключ, "oscript_modules/oint/") Тогда
			Файлы.Добавить(ОбъединитьПути(КаталогПроекта, Запись.Ключ));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Файл Из Файлы Цикл
		Текст = ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходники.Текст(Файл));
		Для Каждого Имя Из ИменаOPIВКоде(Текст) Цикл
			Если МодулиOint.Получить(Имя.Ключ) <> Неопределено Тогда
				Результат.Вставить(Имя.Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Модули и классы oint, транзитивно достижимые от входов: имя -> файл. Литералы в обходе
// остаются: oint создаёт свои типы по имени строкой (Новый(ИмяТипа)).
Функция ДостижимыеМодулиOint(Знач Входы)

	МодулиOint = МодулиOint();
	Результат = Новый Соответствие();

	Очередь = Новый Массив();
	Для Каждого Вход Из Входы Цикл
		Очередь.Добавить(Вход.Ключ);
	КонецЦикла;

	Пока Очередь.Количество() > 0 Цикл

		Имя = Очередь[Очередь.ВГраница()];
		Очередь.Удалить(Очередь.ВГраница());
		Файл = МодулиOint.Получить(Имя);
		Если Файл = Неопределено ИЛИ Результат.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Имя, Файл);
		Для Каждого Ссылка Из ИменаOPIВКоде(ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(Файл))) Цикл
			Очередь.Добавить(Ссылка.Ключ);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Модули и классы всех lib.config oint (без её тестов): имя -> полный путь файла.
Функция МодулиOint()

	КаталогOint = ОбъединитьПути(Новый Файл(КаталогМодулей).ПолноеИмя, "oint");
	Результат = Новый Соответствие();

	Для Каждого Описание Из НайтиФайлы(КаталогOint, "lib.config", Истина) Цикл

		Если СтрНачинаетсяС(СтрЗаменить(Сред(Описание.ПолноеИмя, СтрДлина(КаталогOint) + 2), "\", "/"), "tests/") Тогда
			Продолжить;
		КонецЕсли;

		Чтение = Новый ЧтениеXML();
		Чтение.ОткрытьФайл(Описание.ПолноеИмя);
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента
				И (Чтение.ЛокальноеИмя = "class" ИЛИ Чтение.ЛокальноеИмя = "module") Тогда
				Результат.Вставить(Чтение.ЗначениеАтрибута("name"),
					Новый Файл(ОбъединитьПути(Описание.Путь, Чтение.ЗначениеАтрибута("file"))).ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Идентификаторы OPI_* текста: имя -> Истина.
Функция ИменаOPIВКоде(Знач Текст)

	Результат = Новый Соответствие();
	Отбор = Новый РегулярноеВыражение("(?<![\w])OPI_\w+");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Текст) Цикл
		Результат.Вставить(Совпадение.Значение, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вызовы ПолучитьКомпоненту: имена из литерала — в Компоненты (OPI_<Имя> -> модуль), вызовы
// с именем из выражения — в ПоИмениИзПеременной строкой «<модуль>: <выражение>».
Процедура ВызовыКомпонентOint(Знач Текст, Компоненты, ПоИмениИзПеременной, Знач Модуль)

	Отбор = Новый РегулярноеВыражение("ПолучитьКомпоненту\(\s*([^,)]*)");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Текст) Цикл
		Аргумент = СокрЛП(Совпадение.Группы[1].Значение);
		Если СтрНачинаетсяС(Аргумент, """") И СтрЗаканчиваетсяНа(Аргумент, """") Тогда
			Имя = Сред(Аргумент, 2, СтрДлина(Аргумент) - 2);
			Имя = ?(СтрНачинаетсяС(Имя, "OPI_"), Имя, "OPI_" + Имя);
			Компоненты.Вставить(Имя, Модуль);
		Иначе
			ПоИмениИзПеременной.Добавить(Модуль + ": " + Аргумент);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КлючиСоответствия(Знач Соответствие)

	Результат = Новый Массив();
	Для Каждого КлючЗначение Из Соответствие Цикл
		Результат.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пути файлов (атрибут file) классов и модулей из lib.config.
Функция ФайлыОписанияБиблиотеки(Знач ФайлОписания)

	Результат = Новый Массив();

	Чтение = Новый ЧтениеXML();
	Чтение.ОткрытьФайл(ФайлОписания);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И (Чтение.ЛокальноеИмя = "class" ИЛИ Чтение.ЛокальноеИмя = "module") Тогда
			Результат.Добавить(Чтение.ЗначениеАтрибута("file"));
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

// Путь через «/» без «.» и «..».
Функция НормализованныйПуть(Знач Путь)

	Результат = Новый Массив();
	Для Каждого Сегмент Из СтрРазделить(СтрЗаменить(Путь, "\", "/"), "/", Ложь) Цикл
		Если Сегмент = "." Тогда
			Продолжить;
		ИначеЕсли Сегмент = ".." И Результат.Количество() > 0 Тогда
			Результат.Удалить(Результат.ВГраница());
		Иначе
			Результат.Добавить(Сегмент);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Результат, "/");

КонецФункции

// Корни: объявленные зависимости плюс библиотеки, которые src/ импортирует напрямую —
// импорт без объявления тоже обязан приехать в пакете.
Функция КорниЗависимостей()

	Результат = Новый Соответствие();

	ОтборЗависимостей = Новый РегулярноеВыражение("\.ЗависитОт\(""([^""]+)""");
	Для Каждого Совпадение Из ОтборЗависимостей.НайтиСовпадения(ТекстМанифеста) Цикл
		Результат.Вставить(Совпадение.Группы[1].Значение, Истина);
	КонецЦикла;

	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Истина) Цикл
		Для Каждого Имя Из ИменаИзТекстаИсходника(Исходники.Текст(Файл.ПолноеИмя)) Цикл
			Результат.Вставить(Имя, Истина);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Библиотеки из директив #Использовать. Директива значима только в начале строки, поэтому
// закомментированная ("// #Использовать …") сюда не попадает — это закрыто самотестом.
Функция ИменаИзТекстаИсходника(Знач Текст)

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("(?m)^[ \t]*#Использовать\s+([\w\-\.]+)");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Текст) Цикл
		Результат.Добавить(Совпадение.Группы[1].Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Транзитивное закрытие корней по РАНТАЙМ-объявлениям opm-metadata.xml: dev-зависимости
// (oneunit, coverage, 1bdd) в рантайме хаба не участвуют.
Функция ЗакрытиеЗависимостей()
	Возврат ОбойтиЗакрытие(Новый Массив());
КонецФункции

// Рантайм-зависимости закрытия, которых нет в oscript_modules: закрытие на них обрывается.
Функция НеустановленныеЗависимости()

	Пропавшие = Новый Массив();
	ОбойтиЗакрытие(Пропавшие);

	Возврат Пропавшие;

КонецФункции

// Обход закрытия от корней; неразрешённые имена складываются в Пропавшие.
Функция ОбойтиЗакрытие(Пропавшие)

	Установленные = ЗависимостиУстановленных();
	Результат = Новый Соответствие();

	Очередь = Новый Массив();
	Для Каждого КлючЗначение Из КорниЗависимостей() Цикл
		Очередь.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Пока Очередь.Количество() > 0 Цикл

		Имя = Очередь[Очередь.ВГраница()];
		Очередь.Удалить(Очередь.ВГраница());

		Если Результат.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Объявленные = Установленные.Получить(Имя);
		Если Объявленные = Неопределено Тогда
			Пропавшие.Добавить(Имя);
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Имя, Истина);
		Для Каждого Зависимость Из Объявленные Цикл
			Очередь.Добавить(Зависимость);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Соответствие "имя установленной библиотеки" -> Массив имён её РАНТАЙМ-зависимостей
// (объявления с dev="true" отброшены).
Функция ЗависимостиУстановленных()

	Результат = Новый Соответствие();
	Отбор = Новый РегулярноеВыражение("<depends-on\s+([^>]*)/?>");
	ОтборИмени = Новый РегулярноеВыражение("name=""([^""]+)""");

	Для Каждого Каталог Из НайтиФайлы(КаталогМодулей, "*", Ложь) Цикл

		Если НЕ Каталог.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;

		Метаданные = Новый Файл(ОбъединитьПути(Каталог.ПолноеИмя, "opm-metadata.xml"));
		Если НЕ Метаданные.Существует() Тогда
			Продолжить;
		КонецЕсли;

		Зависимости = Новый Массив();
		Для Каждого Совпадение Из Отбор.НайтиСовпадения(Исходники.Текст(Метаданные.ПолноеИмя)) Цикл
			Атрибуты = Совпадение.Группы[1].Значение;
			Если СтрНайти(Атрибуты, "dev=""true""") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Имена = ОтборИмени.НайтиСовпадения(Атрибуты);
			Если Имена.Количество() > 0 Тогда
				Зависимости.Добавить(Имена[0].Группы[1].Значение);
			КонецЕсли;
		КонецЦикла;

		Результат.Вставить(Каталог.Имя, Зависимости);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Корень(Знач Имя)

	Результат = Новый Массив();
	Результат.Добавить(Имя);

	Возврат Результат;

КонецФункции

// Библиотека песочницы: каталог и opm-metadata.xml с рантайм- и dev-зависимостями через запятую.
Процедура ЗаписатьБиблиотеку(Знач Песочница, Знач Имя, Знач Рантайм, Знач ДляРазработки)

	Объявления = Новый Массив();
	Для Каждого Зависимость Из СтрРазделить(Рантайм, ",", Ложь) Цикл
		Объявления.Добавить(СтрШаблон("    <depends-on name=""%1"" dev=""false""/>", Зависимость));
	КонецЦикла;
	Для Каждого Зависимость Из СтрРазделить(ДляРазработки, ",", Ложь) Цикл
		Объявления.Добавить(СтрШаблон("    <depends-on name=""%1"" dev=""true""/>", Зависимость));
	КонецЦикла;

	Каталог = ОбъединитьПути(Песочница, Имя);
	СоздатьКаталог(Каталог);
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "opm-metadata.xml"), КодировкаТекста.UTF8NoBOM, , , Символы.ПС);
	Запись.ЗаписатьСтроку(СтрШаблон(
		"<?xml version=""1.0"" encoding=""utf-8""?>
		|<opm-metadata xmlns=""http://oscript.io/schemas/opm-metadata/1.0"">
		|    <name>%1</name>
		|    <version>1.0.0</version>
		|%2
		|</opm-metadata>", Имя, СтрСоединить(Объявления, Символы.ПС)));
	Запись.Закрыть();

КонецПроцедуры

Процедура ЗаписатьФайл(Знач Путь)

	СоздатьКаталог(Новый Файл(Путь).Путь);
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	Запись.ЗаписатьСтроку("// песочница");
	Запись.Закрыть();

КонецПроцедуры

Функция Отсортированный(Знач Имена)

	Список = Новый СписокЗначений();
	Список.ЗагрузитьЗначения(Имена);
	Список.СортироватьПоЗначению();

	Результат = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
