// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:InvalidCharacterInFile-off
// BSLLS:YoLetterUsage-off
// Описания экспортных методов src/: над объявлением - комментарий по стандарту 1С, у метода
// с параметрами - «Параметры:» и строка на каждый параметр, у функции - «Возвращаемое значение:».

#Использовать asserts
#Использовать "../фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта - чтение файлов репозитория
Перем КаталогПроекта;

// Ниже этого числа скан считается ослепшим: экспортных методов в src/ - тысячи.
Перем МинимумМетодов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	КаталогПроекта = КаталогиПроекта.Корень();
	МинимумМетодов = 1000;

КонецПроцедуры

#Область СканПродуктовогоКода

&Тест
Процедура КаждыйЭкспортныйМетодОписан() Экспорт

	Нарушения = Новый Массив();
	Методов = 0;

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Путь = Исходники.ОтносительныйПуть(Файл);
		Скан = СканОписаний(Исходники.Текст(Файл));
		Методов = Методов + Скан.Методов;
		Для Каждого Нарушение Из Скан.Нарушения Цикл
			Нарушения.Добавить(Путь + ":" + Нарушение);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Методов >= МинимумМетодов,
		СтрШаблон("найдено экспортных методов: %1 при минимуме %2 - скан ослеп",
			Методов, МинимумМетодов)).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС),
		"экспортный метод без полного описания по стандарту 1С: над объявлением - назначение,"
		+ " «Параметры:» со строкой «Имя - Тип - что это» на каждый параметр, у функции -"
		+ " «Возвращаемое значение:»").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СамотестыСканера

&Тест
Процедура ОписанныйМетодПроходит() Экспорт

	Текст = СтрокиИсходника(
		"// Складывает два числа.",
		"//",
		"// Параметры:",
		"//  А - Число - первое слагаемое.",
		"//  Б - Число - второе слагаемое (необязательный, по умолчанию 0).",
		"//",
		"// Возвращаемое значение:",
		"//  Число - сумма",
		"//",
		"Функция Сумма(Знач А, Знач Б = 0) Экспорт",
		"	Возврат А + Б;",
		"КонецФункции");

	Скан = СканОписаний(Текст);

	Ожидаем.Что(Скан.Методов, "описанная функция найдена").Равно(1);
	Ожидаем.Что(СтрСоединить(Скан.Нарушения, Символы.ПС), "описанная функция проходит").Равно("");

КонецПроцедуры

&Тест
Процедура МногострочныеСигнатураИАннотацияПонятны() Экспорт

	Текст = СтрокиИсходника(
		"// Отдаёт страницу.",
		"//",
		"// Параметры:",
		"//  Ответ - ОтветСервера - ответ winow.",
		"//  Имя - Строка - сегмент адреса.",
		"//",
		"&ТочкаМаршрута(",
		"	""{name}"")",
		"&Наблюдаемый",
		"Процедура Страница(Ответ,",
		"	Знач Имя = ""("") Экспорт",
		"КонецПроцедуры",
		"",
		"// Без параметров в описании.",
		"&ТочкаМаршрута(",
		"	""x"")",
		"Процедура Голая(",
		"	Ответ,",
		"	Знач Имя)",
		"	Экспорт",
		"КонецПроцедуры");

	Скан = СканОписаний(Текст);

	Ожидаем.Что(Скан.Методов, "обе многострочные сигнатуры найдены").Равно(2);
	Ожидаем.Что(СтрСоединить(Скан.Нарушения, Символы.ПС),
		"описание над многострочной аннотацией читается; экспорт на отдельной строке виден")
		.Равно("17 Голая - нет «Параметры:»");

КонецПроцедуры

&Тест
Процедура МетодБезОписанияЛовится() Экспорт

	Текст = СтрокиИсходника(
		"Процедура Первая() Экспорт",
		"КонецПроцедуры",
		"&Наблюдаемый",
		"Процедура Вторая() Экспорт",
		"КонецПроцедуры",
		"",
		"// BSLLS:MissingParameterDescription-off",
		"Процедура Третья() Экспорт",
		"КонецПроцедуры");

	Скан = СканОписаний(Текст);

	Ожидаем.Что(СтрСоединить(Скан.Нарушения, Символы.ПС),
		"без описания, аннотация вплотную к концу метода, маркер BSL LS вместо описания")
		.Равно("1 Первая - нет описания" + Символы.ПС
			+ "4 Вторая - нет описания" + Символы.ПС
			+ "8 Третья - нет описания");

КонецПроцедуры

&Тест
Процедура НеописанныйПараметрЛовится() Экспорт

	Текст = СтрокиИсходника(
		"// Пишет.",
		"//",
		"// Параметры:",
		"//  Ответ - ОтветСервера - ответ, а Имя и Код упомянуты лишь в тексте.",
		"//  П1..П2 - Строка - подстановки.",
		"//",
		"&Наблюдаемый",
		"Процедура Писать(Ответ, Знач Имя, Код = 0, П1 = Неопределено, П2 = Неопределено) Экспорт",
		"КонецПроцедуры");

	Скан = СканОписаний(Текст);

	Ожидаем.Что(СтрСоединить(Скан.Нарушения, Символы.ПС),
		"параметр без своей строки «Имя - Тип - что это» ловится")
		.Равно("8 Писать - не описаны параметры: Имя, Код, П1, П2");

КонецПроцедуры

&Тест
Процедура ФункцияБезВозвратаЛовится() Экспорт

	Текст = СтрокиИсходника(
		"// Считает.",
		"//",
		"Функция Посчитать() Экспорт",
		"	Возврат 1;",
		"КонецФункции");

	Скан = СканОписаний(Текст);

	Ожидаем.Что(СтрСоединить(Скан.Нарушения, Символы.ПС), "функция без возврата ловится")
		.Равно("3 Посчитать - нет «Возвращаемое значение:»");

КонецПроцедуры

&Тест
Процедура ЛитералИКомментарийНеОбъявление() Экспорт

	Текст = СтрокиИсходника(
		"// Процедура ИзКомментария() Экспорт",
		"Перем Шаблон;",
		"",
		"Процедура Внутренняя()",
		"	Шаблон = ""Процедура ИзЛитерала() Экспорт"";",
		"	Шаблон = ""многострочный",
		"	|Функция ИзПродолжения() Экспорт"";",
		"КонецПроцедуры",
		"",
		"Процедура ПриСозданииОбъекта() Экспорт",
		"КонецПроцедуры");

	Скан = СканОписаний(Текст);

	Ожидаем.Что(Скан.Методов, "литерал, комментарий, внутренний метод и конструктор - не экспортные методы")
		.Равно(0);
	Ожидаем.Что(СтрСоединить(Скан.Нарушения, Символы.ПС), "литерал - не директива").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Сканер

// Экспортные методы текста и нарушения их описаний: Структура - Методов (Число), Нарушения
// (Массив строк «строка Метод - чего не хватает»).
Функция СканОписаний(Знач Текст)

	Результат = Новый Структура("Методов, Нарушения", 0, Новый Массив());

	Сырые = СтрокиТекста(Текст);
	Код = СтрокиТекста(ИсходникБезКомментариев.БезКомментариевИЛитералов(Текст));

	Номер = 0;
	Пока Номер < Код.Количество() Цикл

		Объявление = ОбъявлениеМетода(Код, Номер);
		Если Объявление = Неопределено Тогда
			Номер = Номер + 1;
			Продолжить;
		КонецЕсли;

		Если Объявление.Экспорт И НРег(Объявление.Имя) <> НРег("ПриСозданииОбъекта") Тогда
			Результат.Методов = Результат.Методов + 1;
			Недостачи = НедостачиОписания(Описание(Сырые, Номер), Объявление);
			Если Недостачи.Количество() > 0 Тогда
				Результат.Нарушения.Добавить(СтрШаблон("%1 %2 - %3",
					Формат(Номер + 1, "ЧГ=0"), Объявление.Имя, СтрСоединить(Недостачи, "; ")));
			КонецЕсли;
		КонецЕсли;

		Номер = Объявление.Конец + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объявление метода с этой строки кода: Неопределено, если строка его не начинает; иначе
// Структура - Имя, Функция, Параметры (Массив имён), Экспорт, Конец (последняя строка сигнатуры).
Функция ОбъявлениеМетода(Знач Код, Знач Номер)

	Строка_ = СокрЛП(СтрЗаменить(Код[Номер], Символы.Таб, " "));
	ЭтоФункция = НачинаетсяСоСлова(Строка_, "Функция");
	Если НЕ ЭтоФункция И НЕ НачинаетсяСоСлова(Строка_, "Процедура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хвост = СокрЛП(Сред(Строка_, СтрНайти(Строка_, " ")));
	Скобка = СтрНайти(Хвост, "(");
	Если Скобка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Объявление = Новый Структура("Имя, Функция, Параметры, Экспорт, Конец",
		СокрЛП(Лев(Хвост, Скобка - 1)), ЭтоФункция, Новый Массив(), Ложь, Номер);

	// сигнатура до закрывающей скобки - возможно, на следующих строках
	Сигнатура = Сред(Хвост, Скобка);
	Закрытие = ПозицияПарнойСкобки(Сигнатура, 1);
	Пока Закрытие = 0 Цикл
		Если Объявление.Конец + 1 >= Код.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Объявление.Конец = Объявление.Конец + 1;
		Сигнатура = Сигнатура + " " + Код[Объявление.Конец];
		Закрытие = ПозицияПарнойСкобки(Сигнатура, 1);
	КонецЦикла;

	Для Каждого Часть Из ЧастиНаВерхнемУровне(Сред(Сигнатура, 2, Закрытие - 2)) Цикл
		Имя = ИмяПараметра(Часть);
		Если ЗначениеЗаполнено(Имя) Тогда
			Объявление.Параметры.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	ОтметитьЭкспорт(Объявление, Код, Сред(Сигнатура, Закрытие + 1));

	Возврат Объявление;

КонецФункции

// Позиция скобки, парной открывающей в позиции Начало; 0 - текст кончился раньше.
Функция ПозицияПарнойСкобки(Знач Текст, Знач Начало)

	Глубина = 0;
	Для Позиция = Начало По СтрДлина(Текст) Цикл
		Символ_ = Сред(Текст, Позиция, 1);
		Если Символ_ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ_ = ")" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		Если Глубина = 0 Тогда
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// «Экспорт» после закрывающей скобки сигнатуры или первым словом следующей строки.
Процедура ОтметитьЭкспорт(Объявление, Знач Код, Знач ПослеСкобки)

	ПослеСкобки = СокрЛП(СтрЗаменить(ПослеСкобки, Символы.Таб, " "));
	Если ПослеСкобки = "" И Объявление.Конец + 1 < Код.Количество() Тогда
		ПослеСкобки = СокрЛП(СтрЗаменить(Код[Объявление.Конец + 1], Символы.Таб, " "));
		Если НачинаетсяСоСлова(ПослеСкобки, "Экспорт") Тогда
			Объявление.Конец = Объявление.Конец + 1;
		КонецЕсли;
	КонецЕсли;
	Объявление.Экспорт = НачинаетсяСоСлова(ПослеСкобки, "Экспорт");

КонецПроцедуры

// Имя параметра из куска сигнатуры: без аннотаций, «Знач» и значения по умолчанию.
Функция ИмяПараметра(Знач Часть)

	Часть = СокрЛП(СтрЗаменить(СтрЗаменить(Часть, Символы.Таб, " "), Символы.ПС, " "));

	Пока СтрНачинаетсяС(Часть, "&") Цикл
		Часть = БезПервойАннотации(Часть);
	КонецЦикла;

	Равно = СтрНайти(Часть, "=");
	Если Равно > 0 Тогда
		Часть = СокрЛП(Лев(Часть, Равно - 1));
	КонецЕсли;

	Слова = СтрРазделить(Часть, " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Слова[Слова.Количество() - 1];

КонецФункции

// Кусок сигнатуры без ведущей аннотации «&Имя» или «&Имя(...)».
Функция БезПервойАннотации(Знач Часть)

	Позиция = 2;
	Пока Позиция <= СтрДлина(Часть) И СтрНайти(" (", Сред(Часть, Позиция, 1)) = 0 Цикл
		Позиция = Позиция + 1;
	КонецЦикла;

	Если Сред(Часть, Позиция, 1) = "(" Тогда
		Закрытие = ПозицияПарнойСкобки(Часть, Позиция);
		Позиция = ?(Закрытие = 0, СтрДлина(Часть), Закрытие) + 1;
	КонецЕсли;

	Возврат СокрЛП(Сред(Часть, Позиция));

КонецФункции

Функция ЧастиНаВерхнемУровне(Знач Текст)

	Части = Новый Массив();
	Глубина = 0;
	Начало = 1;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ_ = Сред(Текст, Позиция, 1);
		Если Символ_ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ_ = ")" Тогда
			Глубина = Глубина - 1;
		ИначеЕсли Символ_ = "," И Глубина = 0 Тогда
			Части.Добавить(Сред(Текст, Начало, Позиция - Начало));
			Начало = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Начало));

	Возврат Части;

КонецФункции

// Строки описания над объявлением (без «//» и ведущих пробелов): сплошной блок комментариев
// над аннотациями, если они есть. Маркеры BSL LS описанием не считаются.
Функция Описание(Знач Сырые, Знач Номер)

	Строки = Новый Массив();

	Позиция = Номер - 1;
	ВерхАннотаций = Неопределено;
	Пока Позиция >= 0 Цикл
		Строка_ = СокрЛП(Сырые[Позиция]);
		Если Строка_ = "" ИЛИ СтрНачинаетсяС(Строка_, "//") Тогда
			Прервать;
		КонецЕсли;
		ВерхАннотаций = Строка_;
		Позиция = Позиция - 1;
	КонецЦикла;
	Если ВерхАннотаций <> Неопределено И НЕ СтрНачинаетсяС(ВерхАннотаций, "&") Тогда
		Возврат Строки;
	КонецЕсли;

	Пока Позиция >= 0 Цикл
		Строка_ = СокрЛП(Сырые[Позиция]);
		Если НЕ СтрНачинаетсяС(Строка_, "//") Тогда
			Прервать;
		КонецЕсли;
		Тело = СокрЛП(Сред(Строка_, 3));
		Если НЕ СтрНачинаетсяС(Тело, "BSLLS:") Тогда
			Строки.Вставить(0, Тело);
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат Строки;

КонецФункции

Функция НедостачиОписания(Знач Строки, Знач Объявление)

	Недостачи = Новый Массив();

	Если СтрСоединить(Строки, "") = "" Тогда
		Недостачи.Добавить("нет описания");
		Возврат Недостачи;
	КонецЕсли;

	Разделы = РазделыОписания(Строки);

	Если Объявление.Параметры.Количество() > 0 И НЕ Разделы.ЕстьПараметры Тогда
		Недостачи.Добавить("нет «Параметры:»");
	ИначеЕсли Объявление.Параметры.Количество() > 0 Тогда
		Неописанные = НеописанныеПараметры(Объявление.Параметры, Разделы.Описанные);
		Если Неописанные.Количество() > 0 Тогда
			Недостачи.Добавить("не описаны параметры: " + СтрСоединить(Неописанные, ", "));
		КонецЕсли;
	КонецЕсли;

	Если Объявление.Функция И НЕ Разделы.ЕстьВозврат Тогда
		Недостачи.Добавить("нет «Возвращаемое значение:»");
	КонецЕсли;

	Возврат Недостачи;

КонецФункции

// Разделы описания: Структура - ЕстьПараметры, ЕстьВозврат (Булево), Описанные (Соответствие
// имён параметров в нижнем регистре, у которых в разделе «Параметры:» есть своя строка).
Функция РазделыОписания(Знач Строки)

	Разделы = Новый Структура("ЕстьПараметры, ЕстьВозврат, Описанные", Ложь, Ложь, Новый Соответствие());

	Раздел = "";
	Для Каждого Строка_ Из Строки Цикл
		Если Строка_ = "Параметры:" Тогда
			Раздел = "Параметры";
			Разделы.ЕстьПараметры = Истина;
		ИначеЕсли Строка_ = "Возвращаемое значение:" Тогда
			Раздел = "Возврат";
			Разделы.ЕстьВозврат = Истина;
		ИначеЕсли Раздел = "Параметры" Тогда
			Разделы.Описанные.Вставить(НРег(ОписанноеИмя(Строка_)), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Разделы;

КонецФункции

Функция НеописанныеПараметры(Знач Параметры, Знач Описанные)

	Неописанные = Новый Массив();
	Для Каждого Имя Из Параметры Цикл
		Если Описанные[НРег(Имя)] = Неопределено Тогда
			Неописанные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Неописанные;

КонецФункции

// Имя из строки «Имя - Тип - что это»; у строки другого вида - "".
Функция ОписанноеИмя(Знач Строка_)

	Строка_ = СтрЗаменить(Строка_, Символы.Таб, " ");
	Пробел = СтрНайти(Строка_, " ");
	Если Пробел = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ СтрНачинаетсяС(СокрЛ(Сред(Строка_, Пробел)), "-") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Строка_, Пробел - 1);

КонецФункции

Функция НачинаетсяСоСлова(Знач Строка_, Знач Слово)

	Если НРег(Лев(Строка_, СтрДлина(Слово))) <> НРег(Слово) Тогда
		Возврат Ложь;
	КонецЕсли;

	Следующий = Сред(Строка_, СтрДлина(Слово) + 1, 1);
	Возврат Следующий = "" ИЛИ Следующий = " " ИЛИ Следующий = "(" ИЛИ Следующий = ";";

КонецФункции

Функция СтрокиТекста(Знач Текст)
	Возврат СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
КонецФункции

// Текст исходника из строк; список строк кончается на первом пропущенном параметре.
Функция СтрокиИсходника(С1 = Неопределено, С2 = Неопределено, С3 = Неопределено,
	С4 = Неопределено, С5 = Неопределено, С6 = Неопределено, С7 = Неопределено,
	С8 = Неопределено, С9 = Неопределено, С10 = Неопределено, С11 = Неопределено,
	С12 = Неопределено, С13 = Неопределено, С14 = Неопределено, С15 = Неопределено,
	С16 = Неопределено, С17 = Неопределено, С18 = Неопределено, С19 = Неопределено,
	С20 = Неопределено, С21 = Неопределено)

	Все = Новый Массив();
	Все.Добавить(С1);
	Все.Добавить(С2);
	Все.Добавить(С3);
	Все.Добавить(С4);
	Все.Добавить(С5);
	Все.Добавить(С6);
	Все.Добавить(С7);
	Все.Добавить(С8);
	Все.Добавить(С9);
	Все.Добавить(С10);
	Все.Добавить(С11);
	Все.Добавить(С12);
	Все.Добавить(С13);
	Все.Добавить(С14);
	Все.Добавить(С15);
	Все.Добавить(С16);
	Все.Добавить(С17);
	Все.Добавить(С18);
	Все.Добавить(С19);
	Все.Добавить(С20);
	Все.Добавить(С21);

	Строки = Новый Массив();
	Для Каждого Строка_ Из Все Цикл
		Если Строка_ = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Строки.Добавить(Строка_);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Корпус

Функция ФайлыИсходников()

	Файлы = Новый Массив();
	Каталог = ОбъединитьПути(КаталогПроекта, "src");

	Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Файлы.Количество() < 100 Тогда
		ВызватьИсключение СтрШаблон(
			"Корпус скана описаний подозрительно мал (%1 файлов) - проверьте пути",
			Файлы.Количество());
	КонецЕсли;

	Возврат Файлы;

КонецФункции

#КонецОбласти
