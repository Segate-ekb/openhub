&Тест
Процедура СвёрнутаяВеткаНазываетИтоги() Экспорт

	Пульт.ПодготовитьУровень("ИндексВерсийИсточника", "DEBUG", "anna");
	Страница = СтраницаУровней();

	Итоги = ШапкаВетки(Страница, "хаб/прокси");
	Ожидаем.Что(СтрНайти(Итоги, "логов: 4") > 0, "сколько логов в ветке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итоги, "строк/мин: 8") > 0, "сколько строк в минуту пишет ветка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итоги, "DEBUG: 1") > 0, "сколько пишут отладку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итоги, "с экрана: 1") > 0, "сколько задано с экрана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ШапкаВетки(Страница, "библиотеки/entity"), "не в коллектор: 2") > 0,
		"сколько логов не идёт в коллектор").ЭтоИстина();

