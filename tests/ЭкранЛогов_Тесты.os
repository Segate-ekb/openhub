		"дерево — обычная POST-форма на адрес раздела").Равно("post /hub/settings/logs#logs-tree");
	Поиск = Браузер.Тег(Страница, "name=""q""");
	Ожидаем.Что(Браузер.Атрибут(Поиск, "method") + " " + Браузер.Атрибут(Поиск, "action"),
		"поиск — GET-форма, отбор живёт в адресе").Равно("get /hub/settings/logs");
