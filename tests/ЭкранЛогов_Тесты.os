&Тест
Процедура ВозвратВсегоПоказываетЧтоСнимется() Экспорт

	Пульт.ПодготовитьУровень("СлужбаПочты", "DEBUG", "anna");
	Пульт.ПодготовитьОтправку("РезолверВыдачи", Ложь, "root");

	// первое нажатие ничего не снимает: сервер показывает, что снимется и кем задано
	Вопрос = Отправить(Браузер.Поля(СтраницаУровней("path=delivery"), "операция"" value=""к-старту"));
	Ожидаем.Что(Пульт.Вызовы.Количество(), "одно нажатие ничего не снимает").Равно(0);
	Ожидаем.Что(Вопрос.Код, "вопрос — обычная страница").Равно(200);
	Ожидаем.Что(СтрокаСнимаемого(Вопрос.ТелоТекст, "СлужбаПочты"), "что задано у лога и кем")
		.Равно("Служба Почты уровень DEBUG anna, 28.09.2026 11:00 UTC");
	Ожидаем.Что(СтрокаСнимаемого(Вопрос.ТелоТекст, "РезолверВыдачи"), "отправка — тоже")
		.Равно("Резолвер Выдачи в коллектор: нет root, 28.09.2026 12:30 UTC");
	Ожидаем.Что(СтрНайти(Вопрос.ТелоТекст, "Снимутся и правки других администраторов: anna") > 0,
		"чужие правки названы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вопрос.ТелоТекст, "section--danger") > 0, "и вопрос выделен предупреждением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вопрос.ТелоТекст, "name=""подтверждение"""), "ничего вводить не нужно").Равно(0);

	Возврат_ = Отправить(Браузер.Поля(Вопрос.ТелоТекст, "операция"" value=""вернуть-всё"));
	Ожидаем.Что(Пульт.ВызовыМетода("ВернутьКСтарту").Количество(), "кнопка вопроса — один вызов").Равно(1);
	Ожидаем.Что(Отсортированные(Пульт.Вызовы[0].Имена), "возвращается ровно показанное")
		.Равно(Отсортированные(СтрРазделить("СлужбаПочты,РезолверВыдачи", ",")));
	Ожидаем.Что(ПараметрАдреса(Возврат_, "back"), "сколько вернулось — как сказал пульт").Равно("2");
	Ожидаем.Что(ПараметрАдреса(Возврат_, "path"), "отбор пути остался").Равно("delivery");

КонецПроцедуры

&Тест
Процедура ВозвратВсегоСнимаетТолькоПоказанное() Экспорт

	Пульт.ПодготовитьУровень("СлужбаПочты", "DEBUG", "anna");
