// Экран «Логи» без живого хаба: настоящие контроллер, правка, витрины и дерево над фейком
// пульта журнала. Форма отправляется так, как её отправил бы браузер без скрипта: поля
// берутся из выданной разметки, придуманных тестом полей нет.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;            // СборкаUI — компоненты кита, тексты, рендереры
Перем Пульт;         // ФейкПультаЖурнала
Перем Гвард;         // ГвардДопускаЗаглушка
Перем Защита;        // ЗащитаCSRFЗаглушка
Перем Контроллер;    // КонтроллерЛогов
Перем Дороги;        // НавигацияЛогов
Перем Переносимый;   // ПереносимыйКод
Перем Браузер;       // ФормаСоСтраницы — форма страницы так, как её отправил бы браузер

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогМодулей = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя, "src", "модули");
	КлассыИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкПультаЖурнала");
	РеестрФикстур.Подключить("ГвардДопускаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ФормаСоСтраницы");

	UI = Новый СборкаUI().Собрать(КлассыИнтерфейса);
	Браузер = Новый ФормаСоСтраницы();

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Для Каждого Имя Из СтрРазделить("КаталогРазделов,ДомХаба,ОтветыНастроек,РазборФормы,ГейтФормы,"
		+ "ОтборЛогов,НавигацияЛогов,ФормаДереваЛогов,ДеревоЛогов,ОтказыПультаЖурнала,ПравкаЛогов,"
		+ "ПодписиПутей,ПереносимыйКод,ЛентаЗаписей,ЧерновикДереваЛогов,ВитринаДереваЛогов,ВитринаВозвратаЛогов,"
		+ "ВитринаУровнейЛогов,ВитринаСтрокЛогов,КонтроллерЛогов", ",") Цикл
		Поиск.Подключить(КлассыИнтерфейса, Имя);
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура СобратьЭкран() Экспорт

	Пульт = Новый ФейкПультаЖурнала();
	Гвард = Новый ГвардДопускаЗаглушка();
	Гвард.Впустить("root");
	Защита = Новый ЗащитаCSRFЗаглушка();
	СобратьКонтроллер();

КонецПроцедуры

#Область Доступ

&Тест
Процедура ЭкранЗакрытНеАдминистратору() Экспорт

	// настоящий гвард сам отвечает 403; здесь проверяется, что без его допуска экран
	// не печатается и до пульта не доходит ни чтение, ни правка
	Гвард = Новый ГвардДопускаЗаглушка();
	СобратьКонтроллер();

	Уровни = Новый ОтветСтраницыЗаглушка();
	Контроллер.Уровни(Уровни, Новый Соответствие(), Неопределено, "GET", "", АдресКлиента());
	Строки = Новый ОтветСтраницыЗаглушка();
	Контроллер.Строки(Строки, Новый Соответствие(), Неопределено, "GET");
	Правка = Новый ОтветСтраницыЗаглушка();
	Контроллер.Уровни(Правка, Новый Соответствие(), Неопределено, "POST", "операция=вернуть-всё",
		АдресКлиента());

	Ожидаем.Что(Уровни.ТелоТекст + Строки.ТелоТекст + Правка.ТелоТекст, "страница не напечатана").Равно("");
	Ожидаем.Что(Пульт.Вызовы.Количество(), "правок до пульта не дошло").Равно(0);
	Ожидаем.Что(Пульт.ПоследнийОтбор, "строк у пульта не спрашивали").Равно(Неопределено);

	// КОНТРОЛЬ: тот же запрос администратора печатает дерево
	Гвард.Впустить("root");
	Ожидаем.Что(СтрНайти(СтраницаУровней(), "Дерево логов") > 0, "администратору экран открыт").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаБезТокенаФормыОтвергается() Экспорт

	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Защита.ЗадатьИсход(Ложь);

	Ответ = Отправить(Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG"));

	Ожидаем.Что(Ответ.Код, "форма без токена сессии — 403").Равно(403);
	Ожидаем.Что(Пульт.Вызовы.Количество(), "и до пульта ничего не дошло").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Правка

&Тест
Процедура ПрименитьШлётПультуТолькоИзменённое() Экспорт

	Поля = ПоляДерева(СтраницаУровней(Прокси()));

	Ответ = Отправить(Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG"));

	Ожидаем.Что(Ответ.Код, "после правки — перенаправление").Равно(302);
	Ожидаем.Что(Пульт.Вызовы.Количество(), "в форме тронут один лог — один вызов").Равно(1);
	Вызов = Пульт.Вызовы[0];
	Ожидаем.Что(Вызов.Метод, "уровень задаётся").Равно("ЗадатьУровень");
	Ожидаем.Что(СтрСоединить(Вызов.Имена, ","), "ровно тому логу, что поменяли").Равно("РезолверВыдачи");
	Ожидаем.Что(Вызов.Значение, "выбранный уровень").Равно("DEBUG");
	Ожидаем.Что(Вызов.Кто, "автор — вошедший администратор").Равно("root");
	Ожидаем.Что(СтрНайти(Ответ.ПутьРедиректа, "open=") > 0, "раскрытые ветки остаются раскрытыми").ЭтоИстина();

	// КОНТРОЛЬ: та же форма без правок пульт не зовёт вовсе
	Пульт.Вызовы.Очистить();
	Ответ = Отправить(ПоляДерева(СтраницаУровней(Прокси())));
	Ожидаем.Что(Пульт.Вызовы.Количество(), "форма без правок пульт не зовёт").Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ПутьРедиректа, "done=0") > 0, "и честно говорит «ничего не изменилось»").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПовторнаяОтправкаТойЖеПравкиНичегоНеМеняет() Экспорт

	// двойное нажатие «Применить»: вторая отправка несёт то же «было», а пульт повтор своего правкой не считает
	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Поля = Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG");
	Поля = Браузер.БезФлажка(Поля, "otel|СервисПрокси");

	Первый = Отправить(Поля);
	Второй = Отправить(Поля);

	Ожидаем.Что(ПараметрАдреса(Первый, "done"), "первая отправка изменила два лога").Равно("2");
	Ожидаем.Что(ПараметрАдреса(Второй, "done"), "повтор — «ничего не изменилось», как сказал пульт").Равно("0");
	Ожидаем.Что(Пульт.Аудит.Количество(), "и в аудите по одной записи на правку").Равно(2);

КонецПроцедуры

&Тест
Процедура ЭкранГоворитОПравкеТоЖеЧтоПульт() Экспорт

	// INFO от корня своим уровнем лога не считается: выбрать его явно — правка;
	// DEBUG, названный логу окружением, — его собственный: выбрать его ещё раз — не правка
	Поля = ПоляДерева(СтраницаУровней("open=" + Закодировать("хаб")));
	Ответ = Отправить(Браузер.СЗаменой(Поля, "уровень|СлужбаПочты", "INFO"));
	Ожидаем.Что(ПараметрАдреса(Ответ, "done"), "уровень от корня, выбранный явно, — применён").Равно("1");
	Ожидаем.Что(ПараметрАдреса(Ответ, "saved"), "и назван").Равно("СлужбаПочты");

	Поля = ПоляДерева(СтраницаУровней("open=" + Закодировать("хаб")));
	Ответ = Отправить(Браузер.СЗаменой(Поля, "уровень|ГотовностьХаба", "DEBUG"));
	Ожидаем.Что(Пульт.ВызовыМетода("ЗадатьУровень").Количество(), "пульт спрошен").Равно(2);
	Ожидаем.Что(ПараметрАдреса(Ответ, "done"), "а свой уровень ещё раз — «ничего не изменилось»").Равно("0");
	Ожидаем.Что(СтрНайти(ПоРедиректу(Ответ), "Ничего не изменилось") > 0, "и сказано это словами").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОдинПриёмСначалаСужаетПотомРасширяет() Экспорт

	Пульт.ПодготовитьОтправку("ИндексВерсийИсточника", Ложь, "anna");
	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Поля = Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG");
	Поля = Браузер.СЗаменой(Поля, "уровень|КлиентАпстрима", "WARN");
	Поля = Браузер.БезФлажка(Поля, "otel|СервисПрокси");
	Поля = Браузер.СФлажком(Поля, "otel|ИндексВерсийИсточника");

	Отправить(Поля);

	Порядок = Новый Массив();
	Для Каждого Вызов Из Пульт.Вызовы Цикл
		Порядок.Добавить(Вызов.Метод + "(" + СтрСоединить(Вызов.Имена, ",") + "=" + ЗначениеВызова(Вызов) + ")");
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Порядок, " → "), "выключение отправки и понижение — до подъёма и включения")
		.Равно("ОтправлятьВOTel(СервисПрокси=выкл) → ЗадатьУровень(КлиентАпстрима=WARN)"
			+ " → ЗадатьУровень(РезолверВыдачи=DEBUG) → ОтправлятьВOTel(ИндексВерсийИсточника=вкл)");

КонецПроцедуры

&Тест
Процедура ОтправкаВыключеннаяНастройкойВключаетсяСЭкрана() Экспорт

	Пульт.ВыключитьОтправкуНастройкой("КэшАртефактов");
	Страница = СтраницаУровней("open=" + Закодировать("хаб/хранилище"));
	Тумблер = ТегТумблера(Страница, "Отправлять строки лога КэшАртефактов в коллектор");
	Ожидаем.Что(СтрНайти(Тумблер, " disabled"), "выключенная настройкой отправка не заперта").Равно(0);
	Ожидаем.Что(СтрНайти(Тумблер, " checked"), "и показана выключенной").Равно(0);

	Отправить(Браузер.СФлажком(ПоляДерева(Страница), "otel|КэшАртефактов"));

	Ожидаем.Что(Пульт.Вызовы[0].Метод + "=" + ЗначениеВызова(Пульт.Вызовы[0]), "тумблер включает отправку")
		.Равно("ОтправлятьВOTel=вкл");
	Ожидаем.Что(УзелЛога("КэшАртефактов").ВOTel, "и лог уходит в коллектор").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаВСоседнейВкладкеНеЗатирается() Экспорт

	// страницу открыли, потом уровень поменял другой администратор, потом на старой странице
	// поменяли соседний лог: чужая правка остаётся, потому что её поле пришло таким, каким показано
	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Пульт.ПодготовитьУровень("КлиентАпстрима", "WARN", "anna");

	Отправить(Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG"));

	Ожидаем.Что(Пульт.Вызовы.Количество(), "один вызов — для тронутого лога").Равно(1);
	Ожидаем.Что(СтрСоединить(Пульт.Вызовы[0].Имена, ","), "имя тронутого лога").Равно("РезолверВыдачи");
	Ожидаем.Что(УзелЛога("КлиентАпстрима").УровеньСЭкрана, "чужая правка на месте").Равно("WARN");

КонецПроцедуры

&Тест
Процедура ВеткаЗадаётУровеньВсемЕёЛогамОднимВызовом() Экспорт

	Поля = ПоляДерева(СтраницаУровней(Прокси()));

	Ответ = Отправить(Браузер.СЗаменой(Поля, "ветка|хаб/прокси", "WARN"));

	Ожидаем.Что(Пульт.Вызовы.Количество(), "ветка — один вызов со списком").Равно(1);
	Ожидаем.Что(Пульт.Вызовы[0].Значение, "уровень ветки").Равно("WARN");
	Ожидаем.Что(Отсортированные(Пульт.Вызовы[0].Имена),
		"ровно логи ветки").Равно("ИндексВерсийИсточника,КлиентАпстрима,РезолверВыдачи,СервисПрокси");
	Ожидаем.Что(Якорь(Ответ), "страница откроется у правленой ветки").Равно(Дороги.ЯкорьВетки("хаб/прокси"));

КонецПроцедуры

&Тест
Процедура ЛогВнутриПравленойВеткиПолучаетСвоё() Экспорт

	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Поля = Браузер.СЗаменой(Поля, "ветка|хаб/прокси", "WARN");
	Поля = Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG");

	Отправить(Поля);

	Уровни = Новый Соответствие();
	Для Каждого Вызов Из Пульт.ВызовыМетода("ЗадатьУровень") Цикл
		Уровни.Вставить(Вызов.Значение, Отсортированные(Вызов.Имена));
	КонецЦикла;
	Ожидаем.Что(Уровни.Получить("WARN"), "остальным логам ветки — уровень ветки")
		.Равно("ИндексВерсийИсточника,КлиентАпстрима,СервисПрокси");
	Ожидаем.Что(Уровни.Получить("DEBUG"), "названному отдельно — своё").Равно("РезолверВыдачи");

КонецПроцедуры

&Тест
Процедура КакПриСтартеВозвращаетЛогКСтарту() Экспорт

	Пульт.ПодготовитьУровень("СлужбаПочты", "DEBUG", "anna");
	Поля = ПоляДерева(СтраницаУровней());

	Отправить(Браузер.СЗаменой(Поля, "уровень|СлужбаПочты", "start"));

	Ожидаем.Что(Пульт.Вызовы.Количество(), "один вызов").Равно(1);
	Ожидаем.Что(Пульт.Вызовы[0].Метод, "возврат к старту").Равно("ВернутьКСтарту");
	Ожидаем.Что(СтрСоединить(Пульт.Вызовы[0].Имена, ","), "только этого лога").Равно("СлужбаПочты");

КонецПроцедуры

&Тест
Процедура ПереключательОтправкиДоходитДоПульта() Экспорт

	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Ожидаем.Что(Браузер.Значение(Поля, "otel|СервисПрокси"), "лог хаба уходит в коллектор").Равно("1");

	// снятый флажок браузер не отправляет вовсе — уходит парное скрытое «0»
	Отправить(Браузер.БезФлажка(Поля, "otel|СервисПрокси"));

	Ожидаем.Что(Пульт.Вызовы.Количество(), "один вызов").Равно(1);
	Ожидаем.Что(Пульт.Вызовы[0].Метод, "отправка").Равно("ОтправлятьВOTel");
	Ожидаем.Что(Пульт.Вызовы[0].Значение, "выключена").Равно(Ложь);
	Ожидаем.Что(СтрСоединить(Пульт.Вызовы[0].Имена, ","), "этому логу").Равно("СервисПрокси");

КонецПроцедуры

&Тест
Процедура КореньПравитсяКакЛог() Экспорт

	ИмяКорня = Пульт.Корень().Имя;

	Отправить(Браузер.СЗаменой(ПоляДерева(СтраницаУровней()), "уровень-корня", "DEBUG"));
	Ожидаем.Что(Пульт.Вызовы.Количество(), "уровень корня — один вызов").Равно(1);
	Ожидаем.Что(Пульт.Вызовы[0].Метод, "уровень корню").Равно("ЗадатьУровеньКорню");
	Ожидаем.Что(Пульт.Вызовы[0].Значение, "выбранный уровень").Равно("DEBUG");

	Пульт.Вызовы.Очистить();
	Поля = ПоляДерева(СтраницаУровней());
	Ожидаем.Что(Браузер.Значение(Поля, "уровень-корня"), "экран показывает заданное корню").Равно("DEBUG");
	Отправить(Браузер.СЗаменой(Поля, "уровень-корня", "start"));
	Ожидаем.Что(Пульт.Вызовы[0].Метод, "«как при старте» у корня — возврат").Равно("ВернутьКСтарту");
	Ожидаем.Что(СтрСоединить(Пульт.Вызовы[0].Имена, ","), "корня его именем").Равно(ИмяКорня);

	Пульт.Вызовы.Очистить();
	Поля = ПоляДерева(СтраницаУровней());
	Отправить(Браузер.БезФлажка(Поля, "otel|" + ИмяКорня));
	Ожидаем.Что(Пульт.Вызовы[0].Метод, "у корня виден и правится коллектор").Равно("ОтправлятьВOTel");
	Ожидаем.Что(СтрСоединить(Пульт.Вызовы[0].Имена, ","), "корню").Равно(ИмяКорня);
	Ожидаем.Что(Пульт.Вызовы[0].Значение, "выключено").Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ГрупповаяПравкаПутиШлётРовноЛогиПути() Экспорт

	Страница = СтраницаУровней("path=delivery");

	Отправить(Браузер.Поля(Страница, "уровень-найденным"));

	Ожидаем.Что(Пульт.Вызовы.Количество(), "один вызов на весь путь").Равно(1);
	Ожидаем.Что(Пульт.Вызовы[0].Значение, "по умолчанию поднимается отладка").Равно("DEBUG");
	Ожидаем.Что(Отсортированные(Пульт.Вызовы[0].Имена), "ровно логи пути, ни одного лишнего")
		.Равно(Отсортированные(ЛогиПути("delivery")));

КонецПроцедуры

&Тест
Процедура ЛогТолькоДляЧтенияНеПравитсяИОбЭтомСказано() Экспорт

	Страница = СтраницаУровней("path=audit-trail");
	Ожидаем.Что(СтрНайти(Страница, "name=""уровень|аудит"""), "у лога аудита выбора уровня нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "name=""otel|аудит"""), "и тумблер у него без имени").Равно(0);
	Ожидаем.Что(ТекстЯчейки(Страница, "аудит", "logs-name"), "и сказано почему — и куда он пишет")
		.Равно("аудит " + UI.Тексты.Текст("settings.hub.logs.row.readonly.audit")
			+ " · не в консоль · не в память · ещё пишет: файл аудита");
	Ожидаем.Что(ТекстЯчейки(Страница, "аудит", "logs-otel"), "в коллектор журнал аудита не идёт")
		.Равно("Отправлять строки лога аудит в коллектор нет " + UI.Тексты.Текст("settings.hub.logs.row.otel.unreachable"));

	Ответ = Отправить(Браузер.Поля(Страница, "уровень-найденным"));

	Ожидаем.Что(Отсортированные(Пульт.Вызовы[0].Имена), "групповая правка зовёт пульт со всеми логами под отбором")
		.Равно(Отсортированные(ЛогиПути("audit-trail")));
	Ожидаем.Что(ПараметрАдреса(Ответ, "kept"), "пропущенное — то, что назвал пульт").Равно("аудит");
	Ожидаем.Что(ПараметрАдреса(Ответ, "saved"), "применённое — тоже").Равно("СлужбаАудита");
	После = ПоРедиректу(Ответ);
	Ожидаем.Что(СтрНайти(После, "Групповая правка пропустила аудит") > 0, "экран назвал пропущенный лог")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПричинаТолькоЧтенияНазванаСвоимиСловами() Экспорт

	Пульт.ЗапретитьПравку("СлужбаПочты", "unknown_reason");
	Страница = СтраницаУровней("open=" + Закодировать("хаб,библиотеки"));

	Аудит = ТекстЯчейки(Страница, "аудит", "logs-name");
	ДоНастроек = ТекстЯчейки(Страница, "winow.router.СборщикМаршрутов", "logs-name");
	Незнакомая = ТекстЯчейки(Страница, "СлужбаПочты", "logs-name");

	Ожидаем.Что(СтрНайти(Аудит, UI.Тексты.Текст("settings.hub.logs.row.readonly.audit")) > 0,
		"журнал аудита — своими словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ДоНастроек, UI.Тексты.Текст("settings.hub.logs.row.readonly.early")) > 0,
		"лог, заведённый до чтения настроек, — своими").ЭтоИстина();
	Ожидаем.Что(Незнакомая, "незнакомая причина — общими словами")
		.Равно("Служба Почты " + UI.Тексты.Текст("settings.hub.logs.row.readonly"));
	Ожидаем.Что(UI.Тексты.Текст("settings.hub.logs.row.readonly.audit")
		<> UI.Тексты.Текст("settings.hub.logs.row.readonly.early"), "у двух причин разные слова").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Аудит + ДоНастроек + Незнакомая), "пульт"), "внутренних слов нет").Равно(0);

