&Тест
Процедура СбойПультаНеПрячетсяПодОтказ() Экспорт

	// не отказ пульта, а поломка: её увидит страница сбоя, а не оператор словами
	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Пульт.Отказывать("соединение потеряно");

	Упало = Ложь;
	Попытка
		Отправить(Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG"));
	Исключение
		Упало = СтрНайти(ИнформацияОбОшибке().Описание, "соединение потеряно") > 0;
	КонецПопытки;
	Ожидаем.Что(Упало, "сбой дошёл до страницы сбоя со своим текстом").ЭтоИстина();

