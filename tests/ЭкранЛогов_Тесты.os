&Тест
Процедура ПравкаДоходитДоПультаСАдресомКлиента() Экспорт

	Поля = ПоляДерева(СтраницаУровней(Прокси()));
	Поля = Браузер.СЗаменой(Поля, "уровень|РезолверВыдачи", "DEBUG");
	Поля = Браузер.БезФлажка(Поля, "otel|СервисПрокси");
	Поля = Браузер.СЗаменой(Поля, "уровень-корня", "WARN");
	Отправить(Поля);
	Отправить(Браузер.Поля(СтраницаУровней("path=storage"), "уровень-найденным"));
	Отправить(Браузер.Поля(СтраницаСтрок("log=РезолверВыдачи"), "вернуть-логи"));
	Вопрос = Отправить(Браузер.Поля(СтраницаУровней(), "операция"" value=""к-старту"));
	Отправить(Браузер.Поля(Вопрос.ТелоТекст, "операция"" value=""вернуть-всё"));

	Методы = Новый Соответствие();
	Для Каждого Вызов Из Пульт.Вызовы Цикл
		Методы.Вставить(Вызов.Метод, Истина);
		Ожидаем.Что(Вызов.АдресIP, "адрес клиента у вызова " + Вызов.Метод).Равно(АдресКлиента());
		Ожидаем.Что(Вызов.Кто, "и логин у вызова " + Вызов.Метод).Равно("root");
	КонецЦикла;
	Для Каждого Метод Из СтрРазделить("ЗадатьУровень,ЗадатьУровеньКорню,ОтправлятьВOTel,ВернутьКСтарту", ",") Цикл
		Ожидаем.Что(Методы.Получить(Метод), "прошёл вызов " + Метод).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

