		"у имени — куда лог не пишет").Равно("oscript. lib. entity. pool не в консоль");

	// КОНТРОЛЬ: у лога хаба тумблер живой
	Живой = ТегТумблера(СтраницаУровней("q=СервисПрокси"), "Отправлять строки лога СервисПрокси в коллектор");
