КонецПроцедуры

#КонецОбласти

#Область Помощники

Процедура СобратьКонтроллер()

	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, UI.РендерерНастроек, Новый ФейкСервисПрав(),
		UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Разбор = Новый РазборФормы();
	Дом = Новый ДомХаба(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты);
	Отборы = Новый ОтборЛогов();
	Дороги = Новый НавигацияЛогов(Дом, Отборы, UI.Кит, UI.Тексты);
	Форма = Новый ФормаДереваЛогов(Разбор, Отборы, UI.Кит);
	Дерево = Новый ДеревоЛогов(Пульт);
	Подписи = Новый ПодписиПутей(UI.Тексты);
	Переносимый = Новый ПереносимыйКод(UI.Кит);

	Правка = Новый ПравкаЛогов(Пульт, Дерево, Форма, Новый ОтказыПультаЖурнала(UI.Тексты));
	ВитринаДерева = Новый ВитринаДереваЛогов(UI.Кит, UI.РендерерНастроек, UI.Тексты, Дерево, Форма,
		Отборы, Дороги, Переносимый, UI.Примечания, UI.Даты);
	ВитринаВозврата = Новый ВитринаВозвратаЛогов(UI.Кит, UI.РендерерНастроек, UI.Тексты, Дерево, Форма, Дороги,
		Отборы, Переносимый, UI.Даты);
	ВитринаУровней = Новый ВитринаУровнейЛогов(UI.Кит, UI.РендерерНастроек, UI.Тексты, Пульт, Дерево,
		ВитринаДерева, ВитринаВозврата, Новый ЧерновикДереваЛогов(Форма, Дерево), Форма, Отборы, Дороги, Подписи);
	ВитринаСтрок = Новый ВитринаСтрокЛогов(UI.Кит, UI.РендерерНастроек, UI.Тексты, Пульт, Дерево, Отборы,
		Дороги, Новый ЛентаЗаписей(UI.Кит), Форма, Подписи, UI.Даты, UI.Примечания);

	Контроллер = Новый КонтроллерЛогов(Гвард, Ответы, Новый ГейтФормы(Ответы, Защита, Разбор), Разбор,
		Защита, Дом, Дороги, Отборы, Форма, Дерево, Правка, ВитринаУровней, ВитринаСтрок, UI.Тексты);

КонецПроцедуры

// Половина «Уровни»; параметры адреса — строкой «имя=значение&…».
Функция СтраницаУровней(Знач Адрес = "")

	П = ПараметрыАдреса(Адрес);
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Уровни(Ответ, Новый Соответствие(), Неопределено, "GET", "", АдресКлиента(), Параметр(П, "q"),
		Параметр(П, "only"), Параметр(П, "path"), Параметр(П, "open"),
		Параметр(П, "saved"), Параметр(П, "kept"), Параметр(П, "done"), Параметр(П, "back"));
	Ожидаем.Что(Ответ.Код, "половина «Уровни» открывается").Равно(200);
	Возврат Ответ.ТелоТекст;

КонецФункции

Функция СтраницаСтрок(Знач Адрес = "")

	П = ПараметрыАдреса(Адрес);
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Строки(Ответ, Новый Соответствие(), Неопределено, "GET", Параметр(П, "log"),
		Параметр(П, "branch"), Параметр(П, "level"), Параметр(П, "text"), Параметр(П, "path"),
		Параметр(П, "ring"), Параметр(П, "back"));
	Ожидаем.Что(Ответ.Код, "половина «Строки» открывается").Равно(200);
	Возврат Ответ.ТелоТекст;

КонецФункции

// Страница, на которую ведёт перенаправление: браузер открыл бы именно её.
Функция ПоРедиректу(Знач Ответ)
	Возврат ПоАдресу(Ответ.ПутьРедиректа);
КонецФункции

// Страница по адресу экрана — так, как её открыл бы браузер.
Функция ПоАдресу(Знач Адрес)

	Решётка = СтрНайти(Адрес, "#");
	Если Решётка > 0 Тогда
		Адрес = Лев(Адрес, Решётка - 1);
	КонецЕсли;
	Вопрос = СтрНайти(Адрес, "?");
	Путь = ?(Вопрос = 0, Адрес, Лев(Адрес, Вопрос - 1));
	Запрос = ?(Вопрос = 0, "", Сред(Адрес, Вопрос + 1));
	Возврат ?(Путь = Дороги.Строки(), СтраницаСтрок(Запрос), СтраницаУровней(Запрос));

КонецФункции

// Значение параметра адреса перенаправления; "" — параметра нет.
Функция ПараметрАдреса(Знач Ответ, Знач Имя)
	Адрес = Ответ.ПутьРедиректа;
	Решётка = СтрНайти(Адрес, "#");
	Если Решётка > 0 Тогда
		Адрес = Лев(Адрес, Решётка - 1);
	КонецЕсли;
	Вопрос = СтрНайти(Адрес, "?");
	Возврат Параметр(ПараметрыАдреса(?(Вопрос = 0, "", Сред(Адрес, Вопрос + 1))), Имя);
КонецФункции

// Адрес кнопки «Отменить» панели формы дерева.
Функция АдресОтмены(Знач Страница)
	Хвост = Сред(Страница, СтрНайти(Страница, "data-savebar"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, "href=""") + 6);
	Возврат СтрЗаменить(Лев(Хвост, СтрНайти(Хвост, """") - 1), "&amp;", "&");
КонецФункции

// Сколько полей помечено «не применено».
Функция ПометкиНеПрименено(Знач Страница)
	Возврат СтрЧислоВхождений(Страница, ">" + UI.Тексты.Текст("settings.hub.logs.draft.mark") + "<");
КонецФункции

// Имена из заметки «…: имя, имя — пояснение» по алфавиту через запятую.
Функция ИменаЗаметки(Знач Страница, Знач Начало)
	Позиция = СтрНайти(Страница, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Страница, Позиция + СтрДлина(Начало));
	Хвост = Лев(Хвост, СтрНайти(Хвост, "<") - 1);
	Если СтрНайти(Хвост, " — ") > 0 Тогда
		Хвост = Лев(Хвост, СтрНайти(Хвост, " — ") - 1);
	ИначеЕсли СтрЗаканчиваетсяНа(Хвост, ".") Тогда
		Хвост = Лев(Хвост, СтрДлина(Хвост) - 1);
	КонецЕсли;
	Имена = Новый Массив();
	Для Каждого Имя Из СтрРазделить(Хвост, ",", Ложь) Цикл
		Имена.Добавить(СокрЛП(Имя));
	КонецЦикла;
	Возврат Отсортированные(Имена);
КонецФункции

// Строка таблицы вопроса «Вернуть всё» о логе — теги сняты.
Функция СтрокаСнимаемого(Знач Страница, Знач ИмяЛога)
	Возврат БезТегов(СтрокаЛога(Страница, ИмяЛога));
КонецФункции

Функция ПараметрыАдреса(Знач Адрес)
	Результат = Новый Соответствие();
	Для Каждого Пара Из СтрРазделить(Адрес, "&", Ложь) Цикл
		Равно = СтрНайти(Пара, "=");
		Результат.Вставить(Лев(Пара, Равно - 1),
			РаскодироватьСтроку(Сред(Пара, Равно + 1), СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Параметр(Знач Параметры, Знач Имя)
	Значение = Параметры.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция Закодировать(Знач Значение)
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Отправить(Знач Поля)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Уровни(Ответ, Новый Соответствие(), Неопределено, "POST", Браузер.Тело(Поля), АдресКлиента());
	Возврат Ответ;
КонецФункции

// Адрес клиента, с которого отправляет браузер: служба должна получить именно его.
Функция АдресКлиента()
	Возврат "203.0.113.7";
КонецФункции

Функция ПоляДерева(Знач Страница)
	Возврат Браузер.Поля(Страница, "операция"" value=""дерево");
КонецФункции

Функция Якорь(Знач Ответ)
	Возврат ЯкорьАдреса(Ответ.ПутьРедиректа);
КонецФункции

Функция ЯкорьАдреса(Знач Адрес)
	Решётка = СтрНайти(Адрес, "#");
	Возврат ?(Решётка = 0, "", РаскодироватьСтроку(Сред(Адрес, Решётка + 1), СпособКодированияСтроки.КодировкаURL));
КонецФункции

// Пути раскрытых веток из параметра адреса по алфавиту через запятую.
Функция РаскрытыеВАдресе(Знач Адрес)
	Решётка = СтрНайти(Адрес, "#");
	Если Решётка > 0 Тогда
		Адрес = Лев(Адрес, Решётка - 1);
	КонецЕсли;
	Вопрос = СтрНайти(Адрес, "?");
	Раскрытые = Параметр(ПараметрыАдреса(?(Вопрос = 0, "", Сред(Адрес, Вопрос + 1))), "open");
	Возврат Отсортированные(СтрРазделить(Раскрытые, ",", Ложь));
КонецФункции

// Выборы уровня, которые напечатала форма дерева: по ним видно, какие ветки раскрыты.
Функция ПоляУровней(Знач Страница)
	Имена = Новый Массив();
	Для Каждого Поле Из ПоляДерева(Страница) Цикл
		Если СтрНачинаетсяС(Поле.Имя, "уровень|") ИЛИ СтрНачинаетсяС(Поле.Имя, "ветка|") Тогда
			Имена.Добавить(Поле.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Отсортированные(Имена);
КонецФункции

Функция СвёрнутыеВетки(Знач Страница)
	Пути = Новый Массив();
	Примета = "data-logs-closed=""";
	Позиция = СтрНайти(Страница, Примета);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Страница, Позиция + СтрДлина(Примета));
		Пути.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
		Позиция = СтрНайти(Страница, Примета, , Позиция + 1);
	КонецЦикла;
	Возврат Пути;
КонецФункции

Функция Прокси()
	Возврат "open=" + Закодировать("хаб/прокси");
КонецФункции

// Текст ячейки с признаком в строке таблицы лога — теги сняты, пробелы свёрнуты.
Функция ТекстЯчейки(Знач Страница, Знач ИмяЛога, Знач Признак)

	СтрокаТаблицы = СтрокаЛога(Страница, ИмяЛога);
	Начало = СтрНайти(СтрокаТаблицы, "data-" + Признак + "=");
	Если Начало = 0 Тогда
		ВызватьИсключение СтрШаблон("В строке лога %1 нет ячейки %2", ИмяЛога, Признак);
	КонецЕсли;
	Хвост = Сред(СтрокаТаблицы, Начало);
	Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
	Возврат БезТегов(Лев(Хвост, СтрНайти(Хвост, "</td>") - 1));

КонецФункции

// Строка таблицы лога: от <tr до </tr> вокруг ячейки с его именем, разрезанным на куски.
Функция СтрокаЛога(Знач Страница, Знач ИмяЛога)

	Имя = "<code data-wrap="""">";
	Для Каждого Кусок Из Переносимый.Куски(ИмяЛога) Цикл
		Имя = Имя + "<span data-wrap-part="""">" + Кусок + "</span>";
	КонецЦикла;
	Позиция = СтрНайти(Страница, Имя + "</code>");
	Если Позиция = 0 Тогда
		ВызватьИсключение "Нет строки лога " + ИмяЛога;
	КонецЕсли;
	Начало = СтрНайти(Лев(Страница, Позиция), "<tr", НаправлениеПоиска.СКонца);
	Хвост = Сред(Страница, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</tr>") + 4);

КонецФункции

// Шапка узла корня: заголовок и откуда его уровень — до пояснения под ними.
Функция ШапкаКорня(Знач Страница)
	Выбор = СтрНайти(Страница, "name=""уровень-корня""");
	Открытие = "class=""inset"">";
	Начало = СтрНайти(Лев(Страница, Выбор), Открытие, НаправлениеПоиска.СКонца) + СтрДлина(Открытие);
	Хвост = Сред(Страница, Начало);
	Возврат БезТегов(Лев(Хвост, СтрНайти(Хвост, "class=""inset__lead""") - 1) + ">");
КонецФункции

// Значение пары <dt>/<dd> обзора; Неопределено — такого свойства на странице нет.
Функция ЗначениеСвойства(Знач Страница, Знач Имя)
	Начало = СтрНайти(Страница, "<dt>" + Имя + "</dt>");
	Если Начало = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хвост = Сред(Страница, Начало);
	Хвост = Сред(Хвост, СтрНайти(Хвост, "<dd"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
	Возврат БезТегов(Лев(Хвост, СтрНайти(Хвост, "</dd>") - 1));
КонецФункции

Функция ТекстЗакрепления(Знач Страница)
	Хвост = Сред(Страница, СтрНайти(Страница, "data-logs-pin="));
	Хвост = Сред(Хвост, СтрНайти(Хвост, "<code"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</code>") - 1);
КонецФункции

// Текст без тегов: на месте тега пробел, пробелы свёрнуты.
Функция БезТегов(Знач Разметка)
	Текст = Новый РегулярноеВыражение("<[^>]*>").Заменить(Разметка, " ");
	Текст = Новый РегулярноеВыражение("\s+").Заменить(Текст, " ");
	Возврат СокрЛП(Текст);
КонецФункции

Функция ТегТумблера(Знач Страница, Знач Метка)
	Поз = СтрНайти(Страница, ">" + Метка + "<");
	Если Поз = 0 Тогда
		ВызватьИсключение "Нет тумблера с меткой " + Метка;
	КонецЕсли;
	Начало = СтрНайти(Лев(Страница, Поз), "<input", НаправлениеПоиска.СКонца);
	Хвост = Сред(Страница, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

Функция ТегВетки(Знач Страница, Знач Путь)
	Поз = СтрНайти(Страница, "data-logs-branch=""" + Путь + """");
	Если Поз = 0 Тогда
		ВызватьИсключение "Нет раскрытой ветки " + Путь;
	КонецЕсли;
	Начало = СтрНайти(Лев(Страница, Поз), "<details", НаправлениеПоиска.СКонца);
	Хвост = Сред(Страница, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

// Строка ветки: шапка раскрытой либо ряд свёрнутой — кнопка раскрытия и итоги до их </div>.
Функция ШапкаВетки(Знач Страница, Знач Путь)
	Свёрнутая = СтрНайти(Страница, "data-logs-closed=""" + Путь + """");
	Если Свёрнутая > 0 Тогда
		Хвост = Сред(Страница, Свёрнутая);
		Возврат Лев(Хвост, СтрНайти(Хвост, "</div>"));
	КонецЕсли;
	ТегНачала = ТегВетки(Страница, Путь);
	Хвост = Сред(Страница, СтрНайти(Страница, ТегНачала));
	Возврат Лев(Хвост, СтрНайти(Хвост, "</summary>"));
КонецФункции

// Содержимое раздела — от панелей настроек до конца <main>: скрипт каркаса стоит за ним.
Функция ПанелиНастроек(Знач Страница)
	Хвост = Сред(Страница, СтрНайти(Страница, "settings__panes"));
	Возврат Лев(Хвост, СтрНайти(Хвост, "</main>"));
КонецФункции

Функция ЛогиПути(Знач Ключ)
	Для Каждого Путь Из Пульт.Пути() Цикл
		Если Путь.Ключ = Ключ Тогда
			Возврат Путь.Логи;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Массив();
КонецФункции

Функция УзелЛога(Знач Имя)
	Для Каждого Узел Из Пульт.Логи() Цикл
		Если Узел.Имя = Имя Тогда
			Возврат Узел;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Значение вызова пульта словом: у отправки — «вкл»/«выкл».
Функция ЗначениеВызова(Знач Вызов)
	Если ТипЗнч(Вызов.Значение) = Тип("Булево") Тогда
		Возврат ?(Вызов.Значение, "вкл", "выкл");
	КонецЕсли;
	Возврат Строка(Вызов.Значение);
КонецФункции

Функция ОдноИмя(Знач Имя)
	Результат = Новый Массив();
	Результат.Добавить(Имя);
	Возврат Результат;
КонецФункции

Функция Отсортированные(Знач Имена)
	Список = Новый СписокЗначений();
	Список.ЗагрузитьЗначения(Имена);
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), ",");
КонецФункции

#КонецОбласти
