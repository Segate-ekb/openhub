&Тест
Процедура СвёрнутаяВеткаНеПечатаетЛоговИРаскрываетсяКнопкойФормы() Экспорт

	Страница = СтраницаУровней();
	Ожидаем.Что(СтрНайти(Страница, "name=""уровень|РезолверВыдачи"""),
		"логи свёрнутой ветки страница не печатает").Равно(0);

	Ответ = Отправить(Браузер.Нажатием(ПоляДерева(Страница), Страница, "операция"" value=""дерево",
		"раскрыть", "хаб/прокси"));

	Ожидаем.Что(Пульт.Вызовы.Количество(), "раскрытие ничего не применяет").Равно(0);
	Ожидаем.Что(Ответ.Код, "раскрытая страница приходит сразу, без перенаправления").Равно(200);
	Раскрытая = Ответ.ТелоТекст;
	Ожидаем.Что(СтрНайти(Раскрытая, "name=""уровень|РезолверВыдачи""") > 0,
		"ветка раскрыта, её логи правятся").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раскрытая, "data-logs-closed=""хаб/хранилище""") > 0,
		"соседние остаются свёрнутыми").ЭтоИстина();
	Ожидаем.Что(Браузер.Атрибут(Браузер.Тег(Раскрытая, "операция"" value=""дерево"), "action"),
		"адрес формы открывает страницу у дерева").Равно(Дороги.УровниУДерева());
	Ожидаем.Что(СтрНайти(Раскрытая, "id=""" + Дороги.ЯкорьДерева() + """") > 0, "и якорь дерева на ней есть")
		.ЭтоИстина();

