&Тест
Процедура ЛогБезДорогиВКоллекторПоказываетЗапертыйТумблерСПричиной() Экспорт

	Страница = СтраницаУровней("q=entity");
	Тумблер = ТегТумблера(Страница, "Отправлять строки лога oscript.lib.entity.pool в коллектор");

	Ожидаем.Что(СтрНайти(Тумблер, " disabled") > 0, "тумблер заперт").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тумблер, "name="), "и формой не отправляется").Равно(0);
	Ожидаем.Что(СтрНайти(ТекстЯчейки(Страница, "oscript.lib.entity.pool", "logs-otel"), "не доходит до коллектора") > 0,
		"причина названа словами в ячейке лога").ЭтоИстина();
