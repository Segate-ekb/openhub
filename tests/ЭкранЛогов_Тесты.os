	Страница = СтраницаУровней("open=" + Закодировать("хаб"));

	Ожидаем.Что(ТекстЯчейки(Страница, "ГотовностьХаба", "logs-origin"), "из окружения — переменной")
		.Равно("окружение OSHUB_LOG_LEVELS");
	Ожидаем.Что(ТекстЯчейки(Страница, "КонфигурацияOIDC", "logs-origin"), "из файла — ключом")
		.Равно("файл настроек oshub.log.levels");
	Ожидаем.Что(ТекстЯчейки(Страница, "СлужбаПочты", "logs-origin"), "без своего уровня — корнем")
		.Равно("корень");
	Ожидаем.Что(ТекстЯчейки(Страница, "РезолверВыдачи", "logs-origin"), "с экрана — кем и когда")
		.Равно("с экрана anna, 28.09.2026 11:00 UTC");
	Ожидаем.Что(ШапкаКорня(Страница), "корень — умолчанием").Равно("Корень умолчание");

	Пульт.ПодготовитьУровень(Пульт.Корень().Имя, "WARN", "anna");
	Ожидаем.Что(ШапкаКорня(СтраницаУровней()), "корень с экрана — кем и когда")
		.Равно("Корень с экрана anna, 28.09.2026 11:00 UTC");

