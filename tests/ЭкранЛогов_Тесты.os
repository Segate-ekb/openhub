&Тест
Процедура РаскрытаяВеткаОстаётсяВАдресеИОткрываетсяУСебя() Экспорт

	Страница = СтраницаУровней(Прокси());
	Поля = Браузер.СЗаменой(ПоляДерева(Страница), "уровень|РезолверВыдачи", "DEBUG");
	Адрес = Браузер.АдресНажатия(Страница, "операция"" value=""дерево", "раскрыть", "хаб/хранилище");

	Ожидаем.Что(РаскрытыеВАдресе(Адрес), "в адресе — раскрытые ветки вместе с этой")
		.Равно("хаб/прокси,хаб/хранилище");
	Ожидаем.Что(ЯкорьАдреса(Адрес), "страница открывается у раскрытой ветки")
		.Равно(Дороги.ЯкорьВетки("хаб/хранилище"));
	Ожидаем.Что(СтрНайти(Адрес, "DEBUG"), "выбранное в адрес не попадает").Равно(0);

	Раскрытая = Отправить(Браузер.Нажатием(Поля, Страница, "операция"" value=""дерево", "раскрыть",
		"хаб/хранилище")).ТелоТекст;
	ПоСсылке = ПоАдресу(Адрес);

	Ожидаем.Что(ПоляУровней(ПоСсылке), "ссылка из адресной строки показывает то же дерево")
		.Равно(ПоляУровней(Раскрытая));
	Ожидаем.Что(ПометкиНеПрименено(Раскрытая), "выбранное едет телом формы").Равно(1);
	Ожидаем.Что(ПометкиНеПрименено(ПоСсылке), "и по ссылке не передаётся").Равно(0);

КонецПроцедуры

&Тест
Процедура КаждаяКнопкаРаскрытияВедётКТомуЧтоЕстьНаСтранице() Экспорт

	// ветка из одних логов только для чтения выбора уровня не печатает — её кнопка ведёт к дереву
	Пульт.ЗапретитьПравку("oshub.запуск", "before_wiring");
	Страница = СтраницаУровней();
	Ветки = СвёрнутыеВетки(Страница);
	Ожидаем.Что(Ветки.Количество() > 5, "свёрнутых веток на странице много").ЭтоИстина();

	Для Каждого Путь Из Ветки Цикл
		Адрес = Браузер.АдресНажатия(Страница, "операция"" value=""дерево", "раскрыть", Путь);
		Раскрытая = Отправить(Браузер.Нажатием(ПоляДерева(Страница), Страница, "операция"" value=""дерево",
			"раскрыть", Путь)).ТелоТекст;
		Ожидаем.Что(СтрНайти(Раскрытая, "id=""" + ЯкорьАдреса(Адрес) + """") > 0,
			"якорь кнопки " + Путь + " есть на раскрытой странице").ЭтоИстина();
		Ожидаем.Что(ПоляУровней(ПоАдресу(Адрес)), "ссылка кнопки " + Путь + " показывает то же дерево")
			.Равно(ПоляУровней(Раскрытая));
	КонецЦикла;
	Ожидаем.Что(ЯкорьАдреса(Браузер.АдресНажатия(Страница, "операция"" value=""дерево", "раскрыть", "хаб/oshub")),
		"ветка без выбора уровня открывается у дерева").Равно(Дороги.ЯкорьДерева());

КонецПроцедуры

&Тест
Процедура РаскрытиеВеткиНеТеряетВыбранного() Экспорт

	Страница = СтраницаУровней(Прокси());
	Поля = Браузер.СЗаменой(ПоляДерева(Страница), "уровень|РезолверВыдачи", "DEBUG");

	Ответ = Отправить(Браузер.Нажатием(Поля, Страница, "операция"" value=""дерево", "раскрыть", "хаб/хранилище"));
	Ожидаем.Что(Пульт.Вызовы.Количество(), "раскрытие выбранное не применяет").Равно(0);
	Ожидаем.Что(Ответ.Код, "страница с выбранным приходит сразу").Равно(200);

	После = Ответ.ТелоТекст;
	ПоляПосле = ПоляДерева(После);
	Ожидаем.Что(Браузер.Значение(ПоляПосле, "уровень|РезолверВыдачи"), "выбранное на месте").Равно("DEBUG");
	Ожидаем.Что(Браузер.Значение(ПоляПосле, "было|РезолверВыдачи"), "а показанное — как было").Равно("start");
	Ожидаем.Что(Браузер.Значение(ПоляПосле, "уровень|КэшАртефактов"), "новая ветка раскрыта").Равно("start");
	Ожидаем.Что(СтрНайти(ТекстЯчейки(После, "РезолверВыдачи", "logs-level"), "не применено") > 0,
		"выбранное помечено как ещё не применённое").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, "Выбрано и ещё не применено: 1") > 0, "и названо сверху").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, "data-logs-closed=""хаб/почта""") > 0, "соседние ветки остались свёрнутыми")
		.ЭтоИстина();

	Применено = Отправить(ПоляПосле);
	Ожидаем.Что(Пульт.Вызовы.Количество(), "«Применить» применяет перенесённое").Равно(1);
	Ожидаем.Что(СтрСоединить(Пульт.Вызовы[0].Имена, ",") + "=" + Пульт.Вызовы[0].Значение,
		"ровно выбранное до раскрытия").Равно("РезолверВыдачи=DEBUG");

	ПослеПрименения = ПоРедиректу(Применено);
	Ожидаем.Что(СтрНайти(ПослеПрименения, "name=""уровень|КэшАртефактов""") > 0,
		"раскрытая человеком ветка раскрыта и после «Применить»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеПрименения, "data-logs-closed=""хаб/почта""") > 0,
		"а соседние по-прежнему свёрнуты").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтменитьСбрасываетЧерновик() Экспорт

	Страница = СтраницаУровней(Прокси());
	Поля = Браузер.СЗаменой(ПоляДерева(Страница), "уровень|РезолверВыдачи", "DEBUG");
	Раскрытая = Отправить(Браузер.Нажатием(Поля, Страница, "операция"" value=""дерево", "раскрыть",
		"хаб/хранилище")).ТелоТекст;
	Ожидаем.Что(ПометкиНеПрименено(Раскрытая), "до «Отменить» выбранное помечено").Равно(1);

	Отменено = ПоАдресу(АдресОтмены(Раскрытая));

	Ожидаем.Что(ПометкиНеПрименено(Отменено), "после «Отменить» выбранного нет").Равно(0);
	Ожидаем.Что(Браузер.Значение(ПоляДерева(Отменено), "уровень|РезолверВыдачи"), "поле — как у пульта")
		.Равно("start");
	Ожидаем.Что(СтрНайти(Отменено, "name=""уровень|КэшАртефактов""") > 0, "раскрытые ветки остались раскрытыми")
		.ЭтоИстина();
	Ожидаем.Что(Пульт.Вызовы.Количество(), "и ничего не применено").Равно(0);

КонецПроцедуры

&Тест
Процедура РаскрытиеНеТеряетВыбораСотенЛогов() Экспорт

	Имена = Новый Массив();
	Для Номер = 1 По 200 Цикл
		Имена.Добавить("МногоЛог" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"));
		Пульт.ДобавитьЛог(Имена[Имена.ВГраница()], "хаб/много");
	КонецЦикла;
	Страница = СтраницаУровней("open=" + Закодировать("хаб/много"));
	Поля = ПоляДерева(Страница);
	Для Каждого Имя Из Имена Цикл
		Поля = Браузер.СЗаменой(Поля, "уровень|" + Имя, "DEBUG");
	КонецЦикла;

	Ответ = Отправить(Браузер.Нажатием(Поля, Страница, "операция"" value=""дерево", "раскрыть", "хаб/почта"));

	Ожидаем.Что(Ответ.Код, "раскрытие при двухстах выбранных — обычная страница").Равно(200);
	Ожидаем.Что(Пульт.Вызовы.Количество(), "раскрытие ничего не применило").Равно(0);
	ПоляПосле = ПоляДерева(Ответ.ТелоТекст);
	Выбрано = 0;
	Для Каждого Имя Из Имена Цикл
		Выбрано = Выбрано + ?(Браузер.Значение(ПоляПосле, "уровень|" + Имя) = "DEBUG", 1, 0);
	КонецЦикла;
	Ожидаем.Что(Выбрано, "выбор цел у всех двухсот").Равно(200);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "Выбрано и ещё не применено: 200") > 0, "и назван числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "name=""уровень|СлужбаПочты""") > 0, "соседняя ветка раскрыта")
		.ЭтоИстина();

	Отправить(ПоляПосле);
	Ожидаем.Что(Пульт.Вызовы[0].Имена.Количество(), "«Применить» уносит все двести").Равно(200);

КонецПроцедуры

&Тест
Процедура ЧерновикСчитаетТолькоТоЧтоНаСтранице() Экспорт

	// поддельная форма: лог только для чтения, незнакомый лог, слово не из уровней, отправка лога без
	// дороги в коллектор — отброшены; лог и ветка из свёрнутых веток раскрываются и показаны; выбор
	// у яруса, которого на странице нет вовсе, — назван без совета снять отбор: отбора нет
	Страница = СтраницаУровней(Прокси());
	Поля = Браузер.СЗаменой(ПоляДерева(Страница), "уровень|РезолверВыдачи", "FOO");
	Поля.Добавить(Новый Структура("Имя, Значение", "уровень|аудит", "DEBUG"));
	Поля.Добавить(Новый Структура("Имя, Значение", "уровень|НетТакогоЛога", "DEBUG"));
	Поля.Добавить(Новый Структура("Имя, Значение", "otel|oscript.lib.winow.ОбработчикЗапросов", "1"));
	Поля.Добавить(Новый Структура("Имя, Значение", "ветка|хаб/вход/паролем", "DISABLE"));
	Поля.Добавить(Новый Структура("Имя, Значение", "ветка|хаб", "DEBUG"));
	Поля.Добавить(Новый Структура("Имя, Значение", "уровень|СлужбаПочты", "DEBUG"));
	Поля.Добавить(Новый Структура("Имя, Значение", "было|СлужбаПочты", "start"));

	Раскрытая = Отправить(Браузер.Нажатием(Поля, Страница, "операция"" value=""дерево", "раскрыть",
		"хаб/хранилище")).ТелоТекст;

	Ожидаем.Что(ПометкиНеПрименено(Раскрытая), "помечено ровно показанное").Равно(2);
	Ожидаем.Что(СтрНайти(Раскрытая, "Выбрано и ещё не применено: 2") > 0, "и число сверху то же").ЭтоИстина();
	Ожидаем.Что(Браузер.Значение(ПоляДерева(Раскрытая), "уровень|СлужбаПочты"), "лог свёрнутой ветки показан")
		.Равно("DEBUG");
	Ожидаем.Что(Браузер.Значение(ПоляДерева(Раскрытая), "ветка|хаб/вход/паролем"), "и выбор свёрнутой ветки")
		.Равно("DISABLE");
	Ожидаем.Что(ИменаЗаметки(Раскрытая, "Из выбранного отброшено: "), "отброшенное названо")
		.Равно(Отсортированные(СтрРазделить("РезолверВыдачи,аудит,НетТакогоЛога,oscript.lib.winow.ОбработчикЗапросов",
			",")));
	Ожидаем.Что(ИменаЗаметки(Раскрытая, "на этой странице не показано и не применится: "), "непоказанное — тоже")
		.Равно("хаб");
	Ожидаем.Что(СтрНайти(Раскрытая, "снимите отбор"), "совета снять отбор без отбора нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ВыбранноеВнеОтбораНазваноССоветомСнятьОтбор() Экспорт

	// под отбором свёрнутых веток нет, поэтому такой черновик приходит только поддельной формой
	Поля = ПоляДерева(СтраницаУровней("q=" + Закодировать("прокси")));
	Поля.Добавить(Новый Структура("Имя, Значение", "уровень|СлужбаПочты", "DEBUG"));
	Поля.Добавить(Новый Структура("Имя, Значение", "раскрыть", "хаб/прокси"));

	Раскрытая = Отправить(Поля).ТелоТекст;

	Ожидаем.Что(ИменаЗаметки(Раскрытая, "на этой странице не показано и не применится: "),
		"лог вне отбора назван").Равно("СлужбаПочты");
	Ожидаем.Что(СтрНайти(Раскрытая, "снимите отбор, чтобы увидеть") > 0, "и сказано, как его увидеть").ЭтоИстина();
	Ожидаем.Что(ПометкиНеПрименено(Раскрытая), "а пометок нет").Равно(0);

КонецПроцедуры

