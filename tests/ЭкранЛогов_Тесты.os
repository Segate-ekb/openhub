&Тест
Процедура ПослеПравкиВеткаОткрытаИЕёЯкорьЕстьНаСтранице() Экспорт

	Ответ = Отправить(Браузер.СЗаменой(ПоляДерева(СтраницаУровней(Прокси())), "уровень|РезолверВыдачи", "DEBUG"));

	Ожидаем.Что(Якорь(Ответ), "якорь — выбор ветки лога").Равно(Дороги.ЯкорьВетки("хаб/прокси"));

	// без «open» в адресе: ветку раскрывает то, что её лог только что правили
	После = СтраницаУровней("saved=" + Закодировать("РезолверВыдачи") + "&done=1");
	Ожидаем.Что(СтрНайти(После, "id=""" + Дороги.ЯкорьВетки("хаб/прокси") + """") > 0,
		"на странице есть то, к чему ведёт якорь").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТегВетки(После, "хаб/прокси"), " open") > 0, "правленая ветка раскрыта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, "data-logs-closed=""хаб/хранилище""") > 0, "соседняя свёрнута").ЭтоИстина();

