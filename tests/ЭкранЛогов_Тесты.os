		.Равно(Отсортированные(СтрРазделить("СлужбаПочты," + Пульт.Корень().Имя, ",")));
	Ожидаем.Что(УзелЛога("РезолверВыдачи").УровеньСЭкрана, "заданное после показа осталось").Равно("DEBUG");
	Ожидаем.Что(ПараметрАдреса(Ответ, "back"), "вернулось показанное").Равно("2");

