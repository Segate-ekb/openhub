КонецПроцедуры

#КонецОбласти


#Область АгрегатыСкачиваний

&Тест
Процедура НайтиЗаДеньСвязываетПакетВерсиюИСутки() Экспорт

	Ожидаем.Что(Агрегаты.НайтиЗаДень(900, 9001, ДеньПервый).Количество, "900/9001/день 1").Равно(3);
	Ожидаем.Что(Агрегаты.НайтиЗаДень(900, 9001, ДеньВторой).Количество, "отличаются только сутки").Равно(5);
	Ожидаем.Что(Агрегаты.НайтиЗаДень(900, 9002, ДеньПервый).Количество, "отличается только версия").Равно(7);
	Ожидаем.Что(Агрегаты.НайтиЗаДень(901, 9003, ДеньПервый).Количество, "отличается только пакет").Равно(11);

	Ожидаем.Что(Агрегаты.НайтиЗаДень(900, 9003, ДеньПервый), "несуществующая тройка").ЭтоНеопределено();
	Ожидаем.Что(Агрегаты.НайтиЗаДень(900, 9002, ДеньВторой), "версии 9002 за вторые сутки нет").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура СуммаПоПакетуНеСчитаетЧужиеПакеты() Экспорт

	// у пакета 900 три строки (3 + 5 + 7), у пакета 901 — одна на 11
	Ожидаем.Что(Агрегаты.СуммаПоПакету(900), "сумма пакета 900").Равно(15);
	Ожидаем.Что(Агрегаты.СуммаПоПакету(901), "сумма пакета 901").Равно(11);
	Ожидаем.Что(Агрегаты.СуммаПоПакету(999), "сумма несуществующего пакета").Равно(0);

КонецПроцедуры

&Тест
Процедура СуммаПоВерсииНеСчитаетЧужиеВерсии() Экспорт

	Ожидаем.Что(Агрегаты.СуммаПоВерсии(9001), "сумма версии 9001").Равно(8);
	Ожидаем.Что(Агрегаты.СуммаПоВерсии(9002), "сумма версии 9002").Равно(7);
	Ожидаем.Что(Агрегаты.СуммаПоВерсии(9003), "сумма версии 9003").Равно(11);
	Ожидаем.Что(Агрегаты.СуммаПоВерсии(9999), "сумма несуществующей версии").Равно(0);

КонецПроцедуры

&Тест
Процедура ВсеАгрегатыВозвращаютСтрокиРазныхПакетов() Экспорт

	Пакеты = Новый Соответствие();
	Для Каждого Строка Из Агрегаты.Все() Цикл
		Пакеты.Вставить(Строка.ПакетИдентификатор, Истина);
	КонецЦикла;

	// отбора нет — в выборке обязаны оказаться оба засеянных пакета
	Ожидаем.Что(Пакеты[900], "пакет 900 в полной выборке").Существует();
	Ожидаем.Что(Пакеты[901], "пакет 901 в полной выборке").Существует();
	Ожидаем.Что(Агрегаты.Все().Количество() >= 4, "в полной выборке не меньше засеянных строк").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НакопитьСоздаётСтрокуИДобавляетКНайденной() Экспорт

	// отдельный пакет: тест мутирует таблицу и не должен ломать суммы остальных
	Агрегаты.Накопить(902, 9004, ДеньПервый, 4);
	Ожидаем.Что(Агрегаты.НайтиЗаДень(902, 9004, ДеньПервый).Количество, "после первого накопления").Равно(4);

	Агрегаты.Накопить(902, 9004, ДеньПервый, 3);
	Ожидаем.Что(Агрегаты.НайтиЗаДень(902, 9004, ДеньПервый).Количество, "накопление в ту же строку").Равно(7);

	Агрегаты.Накопить(902, 9004, ДеньВторой, 1);
	Ожидаем.Что(Агрегаты.НайтиЗаДень(902, 9004, ДеньПервый).Количество, "первые сутки не тронуты").Равно(7);
	Ожидаем.Что(Агрегаты.СуммаПоПакету(902), "сумма пакета 902").Равно(8);

	Ожидаем.Что(Агрегаты.СуммаПоПакету(900), "чужой пакет не задет").Равно(15);

КонецПроцедуры

#КонецОбласти

#Область Засев

Процедура ЗасеятьЗаявки()

	ИдЗаявок = Новый Соответствие();
	ИдЗаявок.Вставить("альфа-1-ожидает", ДобавитьЗаявку(1, "альфа", "1.0.0", "ожидает", 10));
	ИдЗаявок.Вставить("альфа-2-ожидает", ДобавитьЗаявку(1, "альфа", "2.0.0", "ожидает", 11));
	ИдЗаявок.Вставить("альфа-1-отклонена", ДобавитьЗаявку(1, "альфа", "1.0.0", "отклонена", 12));
	ИдЗаявок.Вставить("бета-1-ожидает", ДобавитьЗаявку(1, "бета", "1.0.0", "ожидает", 10));
	ИдЗаявок.Вставить("альфа-1-пул2", ДобавитьЗаявку(2, "альфа", "1.0.0", "ожидает", 13));

КонецПроцедуры

Функция ДобавитьЗаявку(Знач Пул, Знач Имя, Знач Версия, Знач Состояние, Знач Заявитель)

	Заявка = Заявки.СоздатьЭлемент();
	Заявка.ПулИдентификатор = Пул;
	Заявка.ИмяПакета = Имя;
	Заявка.ИмяНижнийРегистр = Имя;
	Заявка.Версия = Версия;
	Заявка.Состояние = Состояние;
	Заявка.ЗаявительИдентификатор = Заявитель;
	Заявка.Создана = ТекущаяУниверсальнаяДата();
	Заявка.РассмотрелИдентификатор = 0;
	Заявка.Размер = 0;
	Заявка.КлючХранилища = СтрШаблон("%1-%2-%3-%4", Пул, Имя, Версия, Состояние);
	Заявка.Сохранить();

	Возврат Заявка.Идентификатор;

КонецФункции

Процедура ЗасеятьДоверие()

	ИдДоверия = Новый Соответствие();
	ИдДоверия.Вставить("пакет100-github", ДобавитьДоверие(100, "github", "org/repo1"));
	ИдДоверия.Вставить("пакет100-gitlab", ДобавитьДоверие(100, "gitlab", "grp/prj"));
	ИдДоверия.Вставить("пакет200-github", ДобавитьДоверие(200, "github", "org/repo2"));

КонецПроцедуры

Функция ДобавитьДоверие(Знач Пакет, Знач Провайдер, Знач Репозиторий)

	Запись = Доверие.СоздатьЭлемент();
	Запись.ПакетИдентификатор = Пакет;
	Запись.ПулИдентификатор = 1;
	Запись.Провайдер = Провайдер;
	Запись.Издатель = СтрШаблон("https://%1.example", Провайдер);
	Запись.Репозиторий = Репозиторий;
	Запись.Конвейер = "";
	Запись.Реф = "";
	Запись.Создано = ТекущаяУниверсальнаяДата();
	Запись.КемСоздано = 0;
	Запись.Сохранить();

	Возврат Запись.Идентификатор;

КонецФункции

Процедура ЗасеятьАгрегаты()

	ДеньПервый = Дата(2026, 7, 1);
	ДеньВторой = Дата(2026, 7, 2);

	ДобавитьАгрегат(900, 9001, ДеньПервый, 3);
	ДобавитьАгрегат(900, 9001, ДеньВторой, 5);
	ДобавитьАгрегат(900, 9002, ДеньПервый, 7);
	ДобавитьАгрегат(901, 9003, ДеньПервый, 11);

КонецПроцедуры

Процедура ДобавитьАгрегат(Знач Пакет, Знач Версия, Знач День, Знач Количество)

	Агрегат = Агрегаты.СоздатьЭлемент();
	Агрегат.ПакетИдентификатор = Пакет;
	Агрегат.ВерсияИдентификатор = Версия;
	Агрегат.ДатаДень = День;
	Агрегат.Количество = Количество;
	Агрегат.Сохранить();

КонецПроцедуры

#КонецОбласти
