// Отборы деривованных запросов (autumn-data) хранилищ входящих публикаций, доверия CI
// и агрегатов скачиваний: в таблицах лежат строки, которые каждый метод обязан отсеять —
// пропущенный вид сравнения и коллизия имён колонок молча вернули бы всё.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;

Перем Заявки;
Перем Доверие;
Перем Агрегаты;

Перем ИдЗаявок;      // Соответствие: метка строки -> идентификатор
Перем ИдДоверия;

Перем ДеньПервый;
Перем ДеньВторой;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнерИЗасеятьДанные() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), ОбъединитьПути("данные", "Классы"));

	ПоискКлассов.ПодключитьВсе(КаталогКлассовDb);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "деривация-заявок-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет 2, соответствие деталек — 3: файл настроек
	// переименовывается в несуществующий, иначе набор уедет на КоннекторJSON и общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("деривация-заявок-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Заявки = Поделка.НайтиЖелудь("ХранилищеВходящихПубликаций");
	Доверие = Поделка.НайтиЖелудь("ХранилищеДоверияCI");
	Агрегаты = Поделка.НайтиЖелудь("ХранилищеСкачиванийАгрегатов");

	ЗасеятьЗаявки();
	ЗасеятьДоверие();
	ЗасеятьАгрегаты();

КонецПроцедуры

&Тест
Процедура ЖелудиХранилищСобраныИНеПустые() Экспорт

	// ОСень глотает ошибку сборки желудя (лог + Неопределено) — проверяем явно
	Ожидаем.Что(Заявки, "желудь ХранилищеВходящихПубликаций").Существует();
	Ожидаем.Что(Доверие, "желудь ХранилищеДоверияCI").Существует();
	Ожидаем.Что(Агрегаты, "желудь ХранилищеСкачиванийАгрегатов").Существует();

	Ожидаем.Что(Поделка.НайтиЖелудь("ЗапросыВходящихПубликаций"), "желудь ЗапросыВходящихПубликаций").Существует();
	Ожидаем.Что(Поделка.НайтиЖелудь("ЗапросыСкачиванийАгрегатов"), "желудь ЗапросыСкачиванийАгрегатов").Существует();

КонецПроцедуры

#Область ВходящиеПубликации

&Тест
Процедура ЗаявкаИщетсяПоИдентификатору() Экспорт

	Найденная = Заявки.ПолучитьОдноПоИдентификаторРавно(ИдЗаявок["альфа-1-отклонена"]);

	Ожидаем.Что(Найденная, "заявка по идентификатору").Существует();
	Ожидаем.Что(Найденная.Состояние, "состояние найденной").Равно("отклонена");
	Ожидаем.Что(Найденная.Версия, "версия найденной").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ЗаявкиПулаНеЗахватываютЧужойПул() Экспорт

	Ожидаем.Что(Заявки.ПолучитьПоПулИдентификаторРавно(1).Количество(), "заявки пула 1").Равно(4);
	Ожидаем.Что(Заявки.ПолучитьПоПулИдентификаторРавно(2).Количество(), "заявки пула 2").Равно(1);

КонецПроцедуры

&Тест
Процедура ЗаявкиЗаявителяНеЗахватываютЧужие() Экспорт

	Ожидаем.Что(Заявки.ПолучитьПоЗаявительИдентификаторРавно(10).Количество(), "заявки заявителя 10").Равно(2);
	Ожидаем.Что(Заявки.ПолучитьПоЗаявительИдентификаторРавно(11).Количество(), "заявки заявителя 11").Равно(1);
	Ожидаем.Что(Заявки.ПолучитьПоЗаявительИдентификаторРавно(99).Количество(), "заявки несуществующего").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗаявкиПулаВСостоянииОтсеиваютЧужоеСостояниеИЧужойПул() Экспорт

	Ожидающие = Заявки.ЗаявкиПулаВСостоянии(1, "ожидает");

	// в пуле 1 всего 4 заявки, одна из них отклонена; в пуле 2 есть своя ожидающая
	Ожидаем.Что(Ожидающие.Количество(), "ожидающие заявки пула 1").Равно(3);
	Для Каждого Заявка Из Ожидающие Цикл
		Ожидаем.Что(Заявка.ПулИдентификатор, "пул отобранной заявки").Равно(1);
		Ожидаем.Что(Заявка.Состояние, "состояние отобранной заявки").Равно("ожидает");
	КонецЦикла;

	Ожидаем.Что(Заявки.ЗаявкиПулаВСостоянии(1, "отклонена").Количество(), "отклонённые пула 1").Равно(1);
	Ожидаем.Что(Заявки.ЗаявкиПулаВСостоянии(2, "ожидает").Количество(), "ожидающие пула 2").Равно(1);
	Ожидаем.Что(Заявки.ЗаявкиПулаВСостоянии(2, "отклонена").Количество(), "отклонённые пула 2").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗаявкиПулаВСостоянииПриводятАргументы() Экспорт

	// сервисный слой отдаёт идентификатор строкой из маршрута — каст живёт в фасаде
	Ожидаем.Что(Заявки.ЗаявкиПулаВСостоянии("1", "ожидает").Количество(), "пул строкой").Равно(3);

КонецПроцедуры

&Тест
Процедура ЗаявкиНаИмяОтсеиваютЧужоеИмяСостояниеИПул() Экспорт

	НаАльфу = Заявки.ЗаявкиНаИмя(1, "альфа", "ожидает");

	Ожидаем.Что(НаАльфу.Количество(), "ожидающие заявки на альфу в пуле 1").Равно(2);
	Для Каждого Заявка Из НаАльфу Цикл
		Ожидаем.Что(Заявка.ИмяНижнийРегистр, "имя отобранной заявки").Равно("альфа");
	КонецЦикла;

	Ожидаем.Что(Заявки.ЗаявкиНаИмя(1, "бета", "ожидает").Количество(), "ожидающие на бету").Равно(1);
	Ожидаем.Что(Заявки.ЗаявкиНаИмя(2, "бета", "ожидает").Количество(), "беты в пуле 2 нет").Равно(0);
	Ожидаем.Что(Заявки.ЗаявкиНаИмя(1, "альфа", "одобрена").Количество(), "одобренных на альфу нет").Равно(0);

КонецПроцедуры

&Тест
Процедура НайтиПоИмениИВерсииСвязываетВсеЧетыреОтбора() Экспорт

	// соседние строки отличаются ровно одним измерением: версией, состоянием, именем, пулом
	Ожидаем.Что(Заявки.НайтиПоИмениИВерсии(1, "альфа", "1.0.0", "ожидает").Идентификатор,
		"пул 1 / альфа / 1.0.0 / ожидает").Равно(ИдЗаявок["альфа-1-ожидает"]);
	Ожидаем.Что(Заявки.НайтиПоИмениИВерсии(1, "альфа", "2.0.0", "ожидает").Идентификатор,
		"отличается только версия").Равно(ИдЗаявок["альфа-2-ожидает"]);
	Ожидаем.Что(Заявки.НайтиПоИмениИВерсии(1, "альфа", "1.0.0", "отклонена").Идентификатор,
		"отличается только состояние").Равно(ИдЗаявок["альфа-1-отклонена"]);
	Ожидаем.Что(Заявки.НайтиПоИмениИВерсии(1, "бета", "1.0.0", "ожидает").Идентификатор,
		"отличается только имя").Равно(ИдЗаявок["бета-1-ожидает"]);
	Ожидаем.Что(Заявки.НайтиПоИмениИВерсии(2, "альфа", "1.0.0", "ожидает").Идентификатор,
		"отличается только пул").Равно(ИдЗаявок["альфа-1-пул2"]);

	Ожидаем.Что(Заявки.НайтиПоИмениИВерсии(1, "альфа", "3.0.0", "ожидает"),
		"несуществующая комбинация").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ВсеЗаявкиВозвращаютВсюТаблицу() Экспорт
	Ожидаем.Что(Заявки.Все().Количество(), "все заявки хаба").Равно(5);
КонецПроцедуры

#КонецОбласти

#Область ДовериеCI

&Тест
Процедура ДовериеИщетсяПоИдентификатору() Экспорт

	Запись = Доверие.ПолучитьОдноПоИдентификаторРавно(ИдДоверия["пакет100-gitlab"]);

	Ожидаем.Что(Запись, "запись доверия по идентификатору").Существует();
	Ожидаем.Что(Запись.Провайдер, "провайдер найденной записи").Равно("gitlab");

КонецПроцедуры

