// Занятый пулом объём, эффективная квота и гейт публикации по ней — на контейнере ОСени
// с КоннекторInMemory и файловым хранилищем во временном каталоге.
// Набор изолирован процессом: второй контейнер конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
// autumn-logos — единая точка входа логирования: классу, созданному НАПРЯМУЮ (минуя
// контейнер ОСени), лог передаёт тест параметром конструктора (дисциплина 6.D)
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем КаталогСборки;
Перем Счётчик;
Перем Засев;         // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
	ОбразецКлюча = "-----BEGIN PUBLIC KEY-----" + Символы.ПС
		+ "MCowBQYDK2VwAyEAGb9ECWmEzf6FQbrBZ9w7lshQhqowtrbLDFw4rXAxZuE" + Символы.ПС
		+ "-----END PUBLIC KEY-----";
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	// SSRF-гейт апстримов (5.B): СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО
	// (fail-closed). Модули webhooks/mirror целиком не тянем — в webhooks рогатки,
	// которым нужен весь хаб; фикстура подключает ровно три класса гейта.
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	// из auth берём только сервис прав и группы (без web/session/pwhash); контракт
	// ПроверяющийGitHub — интерфейс, реальную реализацию НЕ грузим (её место — фейк)
	КаталогВхода = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("вход", "Классы"));
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "УчёткаПринципала");
	ПоискКлассов.Подключить(КаталогМодулей, "ВердиктГварда");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПравДоступа");
	ПоискКлассов.Подключить(КаталогМодулей, "ПроверяющийGitHub");
	// гейт ключа (7.A п.3): СервисПубликации спрашивает у него скоуп и привязку PAT
	// ДО модели прав. Он тянет СервисТокенов (разбор строки скоупов — там, второго
	// разбора не заводим), тот — ХранилищеТокенов из db.
	ПоискКлассов.Подключить(КаталогМодулей, "СверкаСекретов");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисТокенов");
	ПоискКлассов.Подключить(КаталогМодулей, "ГейтТокена");
	// ГвардКлюча (7.B) — единая формулировка рамок ключа на доменных мутациях; его
	// спрашивает СервисДоверияCI
	ПоискКлассов.Подключить(КаталогМодулей, "ГвардКлюча");
	ПоискКлассов.Подключить(КаталогМодулей, "ДопускПринципала");
	// гвард квоты и служба доступа: создание пула — второй вход к квоте, и он закрыт здесь
	ПоискКлассов.Подключить(КаталогМодулей, "ГвардКвотыПула");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("кабинет", ОбъединитьПути("Классы", "СлужбаДоступа.os"))));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ЗаписывающийПодписчик.os"));

	// события + аудит (шаг 2.F): СервисПубликации публикует доменное событие, на него
	// подписана СлужбаАудита и пишет строку в файловый журнал аудита
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	// observability (этап 4): издатель событий инъектирует желудь «Телеметрия» (в этом
	// контейнере выключенный, пустышка). Ему нужен ТранспортHTTP (сеть) —
	// регистрируем минимально необходимое.
	КаталогNet = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("сеть", "Классы"));
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПроб = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	// ГотовностьХаба — гейт стартовых задач: рогатки модулей аудит /
	// stats / proxy / webhooks / jobs заявляют в ней свои задачи, поэтому желудь
	// обязан присутствовать в контейнере, иначе их бины не собираются.
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПроб, "ГотовностьХаба.os"));

	// общий модуль утилит (6.C п.8): классы реестра берут ПриведениеЧисел желудём
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	// settings (7.E): СервисПубликации читает лимиты у резолвера СервисНастроек —
	// контейнеру нужны его желуди (реестр + резолвер), дома/контроллеры не тянем
	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(
		Новый Файл(ОбъединитьПути(КаталогSettings, "..", "..")).ПолноеИмя,
		"основа", "Классы", "ПриведениеФлагов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	// proxy: сквозная проверка «пул выходит из-за квоты сам» гоняет НАСТОЯЩИЙ сборщик
	// кэша; остальной модуль прокси сюда не тянем — сборщику хватает реестра и хранилища
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("прокси",
		ОбъединитьПути("Классы", "СборщикКэшаПрокси.os"))));

	// publish (7.B): СервисПубликации зависит от очереди заявок и доверенных конвейеров.
	// ОБЕ зависимости объявлены со значением по умолчанию, но это НЕ делает их
	// необязательными: ФабрикаЖелудей ОСени бросает исключение ДО конструктора, если бина
	// нет в контейнере, и Поделка кладёт Неопределено вместо ВСЕГО класса-потребителя
	// (измерено на этом же наборе: 34 из 35 красных). Поэтому классы перечислены здесь.
	КаталогPublish = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("публикация", "Классы"));
	ПоискКлассов.Подключить(КаталогPublish, "СервисВходящих");
	ПоискКлассов.Подключить(КаталогPublish, "СтражИздателейCI");
	ПоискКлассов.Подключить(КаталогPublish, "АудиторияТокенаCI");
	ПоискКлассов.Подключить(КаталогPublish, "СервисДоверияCI");
	ПоискКлассов.Подключить(КаталогPublish, "МестоВПуле");
	ПоискКлассов.Подключить(КаталогPublish, "СервисПубликации");

	// фейки прозвищ, чьи боевые реализации сюда не тянем: GitHub-проверяющий и
	// проверяющий подписи CI (боевой ходит за ключами в сеть)
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФейкПроверяющийGitHub.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "КодировкаТестов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФейкПроверяющийПодписиCI.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФикстураПакета.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ЛовушкаЛога.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ХранилищеПадающееНаЗамере.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ЗаписывающийПодписчик.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-quota-unit-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	Детальки.Вставить("oshub.publish.public_selfservice", "Ложь");
	// сети в наборе нет: пробное подключение к источнику выключено
	Детальки.Вставить("oshub.upstream.probe.enabled", "false");

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "публикация-сервис-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

// --- проверки ---


#Область ЗанятыйОбъём

&Тест
Процедура ПубликацияУвеличиваетЗанятоеПула() Экспорт

	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);

	Ожидаем.Что(Занято(Пул), "новый пул пуст").Равно(0);

	Итог = Опубликовать(Пул, Польз, "vol", "1.0.0");
	Ожидаем.Что(Итог.Успех, "публикация прошла: " + Строка(Итог.Сообщение)).ЭтоИстина();

	РазмерАртефакта = РазмерВерсии(Пул, "vol", "1.0.0");
	Ожидаем.Что(РазмерАртефакта > 0, "у версии есть размер").ЭтоИстина();
	Ожидаем.Что(Занято(Пул), "занятое пула равно размеру артефакта").Равно(РазмерАртефакта);

КонецПроцедуры

&Тест
Процедура ОтзывВерсииЗанятоеНеОсвобождает() Экспорт

	// РЕШЕНИЕ ВЛАДЕЛЬЦА: квота меряет диск, а отзыв артефакт с диска не убирает —
	// он остаётся скачиваемым по точной координате. Освобождает только удаление.
	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	Опубликовать(Пул, Польз, "yankvol", "1.0.0");
	РазмерАртефакта = РазмерВерсии(Пул, "yankvol", "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "yankvol");

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.0.0", Истина, "тест");
	Ожидаем.Что(Занято(Пул), "отзыв объём не освободил").Равно(РазмерАртефакта);

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.0.0", Ложь, "тест");
	Ожидаем.Что(Занято(Пул), "и восстановление ничего не добавило").Равно(РазмерАртефакта);

	// повторные отзывы идемпотентны: счётчик не двоится и не уходит в минус
	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.0.0", Истина, "тест");
	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.0.0", Истина, "тест");
	Ожидаем.Что(Занято(Пул), "повторный отзыв ничего не меняет").Равно(РазмерАртефакта);

КонецПроцедуры

&Тест
Процедура УдалениеПакетаОсвобождаетЗанятоеПула() Экспорт

	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	Опубликовать(Пул, Польз, "delvol", "1.0.0");
	Опубликовать(Пул, Польз, "delvol", "1.0.1");
	Ожидаем.Что(Занято(Пул) > 0, "пул занят").ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "delvol");
	Желудь("УборкаПакета").УдалитьПакет(Пакет);

	Ожидаем.Что(Занято(Пул), "удаление пакета вернуло объём пулу").Равно(0);

КонецПроцедуры

&Тест
Процедура ПересчётЧинитРазъехавшийсяСчётчик() Экспорт

	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	Опубликовать(Пул, Польз, "fixvol", "1.0.0");
	Верный = Занято(Пул);
	Ожидаем.Что(Верный > 0, "пул занят").ЭтоИстина();

	ЗаписатьЗанятое(Пул, 123456789);
	Ожидаем.Что(Занято(Пул), "счётчик разъехался").Равно(123456789);

	Пересчитать(Пул);
	Ожидаем.Что(Занято(Пул), "пересчёт вернул верное значение").Равно(Верный);

КонецПроцедуры

&Тест
Процедура ОтозваннаяВерсияВходитВПересчёт() Экспорт

	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	Опубликовать(Пул, Польз, "recalc", "1.0.0");
	Опубликовать(Пул, Польз, "recalc", "1.0.1");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "recalc");
	Обе = РазмерВерсии(Пул, "recalc", "1.0.0") + РазмерВерсии(Пул, "recalc", "1.0.1");

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.0.1", Истина, "тест");
	ЗаписатьЗанятое(Пул, 0);

	Ожидаем.Что(Пересчитать(Пул),
		"отозванная версия остаётся на диске и в пересчёте").Равно(Обе);

КонецПроцедуры

#КонецОбласти

#Область КэшПроксиИЗеркала

&Тест
Процедура КэшПроксиВходитВЗанятоеПула() Экспорт

	// РЕШЕНИЕ ВЛАДЕЛЬЦА: занятое пулом — это место на диске под ним, чем бы оно ни было
	// занято. Кэш прокси считается наравне со своими публикациями.
	Пул = НовыйПулСКвотой(1);

	Внешние = ЗакэшироватьАпстримные(Пул, "upstreampkg", 6, 200000);
	Ожидаем.Что(Внешние > КвотаБайт(Пул), "апстрима закачано больше квоты пула").ЭтоИстина();

	Ожидаем.Что(Пересчитать(Пул),
		"замер хранилища видит кэш прокси").Равно(Внешние);
	Ожидаем.Что(Занято(Пул), "и счётчик после замера показывает его же").Равно(Внешние);

КонецПроцедуры

&Тест
Процедура ВыросшийКэшОтвергаетСобственнуюПубликацию() Экспорт

	// прямое следствие решения владельца, названное вслух: место кончилось из-за кэша —
	// публикация отвергается ровно так же, как из-за своих пакетов, кодом 507
	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);

	ЗакэшироватьАпстримные(Пул, "hoggy", 6, 200000);
	Пересчитать(Пул);

	Итог = Опубликовать(Пул, Польз, "ownpkg", "1.0.0");

	Ожидаем.Что(Итог.Успех, "квоту съел кэш — публиковать некуда").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "507: место кончилось у пула, а не у запроса").Равно(507);
	Ожидаем.Что(СтрНайти(Строка(Итог.Сообщение), "Квота пула") > 0,
		"отказ назван внятно, а не «внутренняя ошибка»: " + Строка(Итог.Сообщение)).ЭтоИстина();
	// издатель не может удалить чужой кэш: отказ обязан назвать причину, иначе совет
	// «удалите ненужные пакеты» отправляет его искать то, чего у него нет
	Ожидаем.Что(СтрНайти(Строка(Итог.Сообщение), "кэш прокси") > 0,
		"отказ называет кэш прокси среди занявшего место: " + Строка(Итог.Сообщение)).ЭтоИстина();
	Ожидаем.Что(ВерсияЕсть(Пул, "ownpkg", "1.0.0"), "отвергнутая версия в реестр не попала").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УборкаКэшаВозвращаетМестоПулуСквозным() Экспорт

	// обратный ход целиком на боевых классах: НАСТОЯЩИЙ СборщикКэшаПрокси вытесняет
	// апстримные артефакты до квоты и возвращает байты пулу, после чего своя публикация,
	// отвергнутая минуту назад, проходит. Без сквозного прохода «пул выйдет из-за границы
	// сам» оставалось бы обещанием.
	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);
	Источники().Записать(Пул, "http://upstream.invalid/download/", 900);

	ЗакэшироватьАпстримные(Пул, "evictme", 6, 200000);
	Пересчитать(Пул);
	Итог = Опубликовать(Пул, Польз, "aftergc", "1.0.0");
	Ожидаем.Что(Итог.Успех, "пул полон кэшем").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "и отказ — по квоте").Равно(507);

	Сводка = Желудь("СборщикКэшаПрокси").Собрать();

	Ожидаем.Что(Сводка.УдаленоФайлов > 0, "уборка вытеснила апстримные артефакты").ЭтоИстина();
	Ожидаем.Что(Занято(Пул) <= КвотаБайт(Пул),
		СтрШаблон("счётчик вернулся в квоту без сверки: занято %1 из %2",
			Занято(Пул), КвотаБайт(Пул))).ЭтоИстина();
	Ожидаем.Что(Пересчитать(Пул), "и замер хранилища с ним согласен").Равно(Занято(Пул));

	Ожидаем.Что(Опубликовать(Пул, Польз, "aftergc", "1.0.0").Успех,
		"освободившееся место снова принимает публикацию").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗаявкаВоВходящиеЗанимаетМестоПулаИУпираетсяВКвоту() Экспорт

	// «входящие» пишут байты в область пула: они обязаны и считаться, и упираться в квоту,
	// иначе очередь — дыра мимо предела (при дефолтах до 1,25 ГБ на пул)
	Пул = НовыйПулСКвотой(1);
	Чужак = СоздатьПользователя(); // прав на пул нет — push уходит во «входящие»

	Итог = Опубликовать(Пул, Чужак, "queued", "1.0.0");
	Ожидаем.Что(Итог.Код, "заявка принята во «входящие»").Равно(202);

	Занятое = Занято(Пул);
	Ожидаем.Что(Занятое > 0, "байты заявки заняли место пула").ЭтоИстина();
	Ожидаем.Что(Пересчитать(Пул), "замер хранилища видит артефакт заявки").Равно(Занятое);

	// пул забит под завязку — следующая заявка обязана упереться в квоту, а не лечь на диск
	ЗакэшироватьАпстримные(Пул, "filler", 6, 200000);
	Пересчитать(Пул);
	ИтогПолного = Опубликовать(Пул, Чужак, "queued2", "1.0.0");
	Ожидаем.Что(ИтогПолного.Код, "заявка в полный пул отвергнута по квоте").Равно(507);

КонецПроцедуры

&Тест
Процедура СменаКвотыВХранилищеНеХодитИСчётчикНеТрогает() Экспорт

	// На S3 замер области стоит листинга бакета и выше 250 объектов падает — админ обязан
	// уметь менять предел на любом бэкенде. Счётчик ведут дельты писателей и сверка.
	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	Опубликовать(Пул, Польз, "quotachange", "1.0.0");

	ЗаписатьЗанятое(Пул, 4242); // счётчик заведомо разошёлся с диском
	Желудь("СервисПулов").УстановитьКвоту(Пул.Идентификатор, 5);

	Ожидаем.Что(Занято(Пул), "смена квоты счётчик не пересчитывает").Равно(4242);
	Ожидаем.Что(Цел(Число(ЗаписьПула(Пул).КвотаМб)), "а квота записана").Равно(5);

КонецПроцедуры

&Тест
Процедура УдалениеПакетаПослеВытесненияКэшаСписываетТолькоЛежащееНаДиске() Экспорт

	// БЛОКЕР РЕВЬЮ: вытеснение кэша удаляет ФАЙЛ, но строку версии оставляет и байты пулу
	// уже вернуло. Списание по строкам версий вычитало те же байты второй раз, и пул
	// с живыми пакетами снова показывал ноль — тот самый симптом, ради которого всё затевалось.
	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	// СОСЕД ПО ПУЛУ обязателен: без него лишний вычет упирается в ноль, и двойное
	// списание выглядит правильным ответом — счётчик и так должен был обнулиться
	Опубликовать(Пул, Польз, "neighbour", "1.0.0");
	ОбъёмСоседа = Занято(Пул);
	Ожидаем.Что(ОбъёмСоседа > 0, "сосед занял место").ЭтоИстина();

	Опубликовать(Пул, Польз, "survivor", "1.0.0");
	Своё = Занято(Пул) - ОбъёмСоседа;
	Ожидаем.Что(Своё > 0, "своя публикация заняла место").ЭтоИстина();

	Апстримная = ЗакэшироватьВерсию(Пул, "survivor", "9.9.9", 400000);
	Пересчитать(Пул);
	Ожидаем.Что(Занято(Пул), "кэш добавил своё").Равно(ОбъёмСоседа + Своё + Апстримная);

	// вытеснение: файл снят, СТРОКА ВЕРСИИ ЖИВА, байты пулу возвращены
	Желудь("ХранилищеАртефактов").Удалить(Новый КоординатыАртефакта(Пул.Имя, "survivor", "9.9.9"));
	Желудь("УчётОбъёмаПула").Учесть(ЗаписьПула(Пул), -Апстримная);
	Ожидаем.Что(Занято(Пул), "после вытеснения осталось соседское и своё")
		.Равно(ОбъёмСоседа + Своё);

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "survivor");
	Желудь("УборкаПакета").УдалитьПакет(Пакет);

	Ожидаем.Что(Занято(Пул), "списано ровно то, что лежало на диске, а не сумма строк версий")
		.Равно(ОбъёмСоседа);
	Ожидаем.Что(Пересчитать(Пул), "замер хранилища согласен со счётчиком").Равно(ОбъёмСоседа);

КонецПроцедуры

&Тест
Процедура НесостоявшаясяПубликацияСчётчикНеРастит() Экспорт

	// Счётчик пула двигает только состоявшаяся публикация. Ведущие нули в версии проходят
	// валидацию .ospx, но отвергаются правилом реестра — раньше на этом пути артефакт УЖЕ
	// был записан и снимался откатом. С тех пор push спрашивает правило ДО записи, поэтому
	// путь стал короче: ни файла, ни байтов в счётчике не появляется вовсе.
	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);

	Итог = Опубликовать(Пул, Польз, "rolledback", "01.2.3");

	Ожидаем.Что(Итог.Успех, "публикация с неканонической версией отклонена").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Строка(Итог.Сообщение), "ведущие нули") > 0,
		"отказ по правилу называет причину: " + Строка(Итог.Сообщение)).ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Существует(
		Новый КоординатыАртефакта(Пул.Имя, "rolledback", "01.2.3")), "артефакта в пуле нет").ЭтоЛожь();
	Ожидаем.Что(Занято(Пул), "несостоявшаяся публикация не оставила байтов в счётчике").Равно(0);
	Ожидаем.Что(Пересчитать(Пул), "и на диске их тоже нет").Равно(0);

КонецПроцедуры

&Тест
Процедура УдалениеАпстримногоПакетаОсвобождаетМесто() Экспорт

	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	// сосед по пулу нужен, чтобы списание «в минус» было ВИДНО: без него лишний вычет
	// упирается в ноль и выглядит как правильный ответ
	Опубликовать(Пул, Польз, "neighbour", "1.0.0");
	ОбъёмСоседа = Занято(Пул);
	Ожидаем.Что(ОбъёмСоседа > 0, "сосед занял место").ЭтоИстина();

	Опубликовать(Пул, Польз, "mixed", "1.0.0");
	Своё = Занято(Пул) - ОбъёмСоседа;
	Ожидаем.Что(Своё > 0, "свой пакет добавил объём").ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "mixed");
	Апстримная = ЗакэшироватьВерсию(Пул, "mixed", "9.9.9", 500000);
	Пересчитать(Пул);
	Ожидаем.Что(Занято(Пул), "апстримная версия того же пакета тоже занимает место")
		.Равно(ОбъёмСоседа + Своё + Апстримная);

	Желудь("УборкаПакета").УдалитьПакет(Пакет);
	Ожидаем.Что(Занято(Пул), "уборка сняла с диска обе версии — и своя, и апстримная списаны")
		.Равно(ОбъёмСоседа);
	Ожидаем.Что(Пересчитать(Пул),
		"замер хранилища подтверждает списание").Равно(ОбъёмСоседа);

КонецПроцедуры

&Тест
Процедура ПубликацияПоверхАпстримнойВерсииЗасчитываетсяРазницей() Экспорт

	// артефакт ложится на место прежнего, поэтому в занятое идёт разница размеров,
	// а не весь новый размер: иначе счётчик учёл бы одни и те же байты дважды
	Пул = НовыйПулСКвотой(10);
	Польз = ИздательПула(Пул);
	Апстримная = ЗакэшироватьВерсию(Пул, "takeover", "1.0.0-SNAPSHOT", 700000);
	Пересчитать(Пул);
	Ожидаем.Что(Занято(Пул), "закэшированная версия занимает место").Равно(Апстримная);

	// номер в реестре уже есть (его привёз кэш), поэтому публикация поверх — та же замена
	// номера и просится форсом
	Данные = ПостроитьOspxДанные("takeover", "1.0.0-SNAPSHOT");
	Итог = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		"takeover-1.0.0-SNAPSHOT.ospx", "stable", Польз, "", Неопределено, Истина);
	Ожидаем.Что(Итог.Успех, "перезапись прошла: " + Строка(Итог.Сообщение)).ЭтоИстина();

	Ожидаем.Что(Занято(Пул), "счётчик показывает размер того, что реально лежит на диске")
		.Равно(РазмерВерсии(Пул, "takeover", "1.0.0-SNAPSHOT"));
	Ожидаем.Что(Пересчитать(Пул),
		"и замер хранилища с ним согласен").Равно(Занято(Пул));

КонецПроцедуры

&Тест
Процедура НиОдинТекстНеОбещаетЧтоКэшМимоКвоты() Экспорт

	// Правило квоты объясняется пользователю в интерфейсе и в docs. Старое правило
	// («квота меряет только свои версии, кэш прокси в неё не входит») пережило смену
	// поведения в трёх экранных текстах и в документации — интерфейс врал про то, по какому
	// правилу хаб отказывает в публикации.
	// Сравнение — В НИЖНЕМ РЕГИСТРЕ обеих сторон: ревьюер вернул ровно то же ложное
	// правило тремя заглавными буквами, и регистрозависимый чёрный список это пропустил.
	Запреты = СтрРазделить("в квоту пула не входят|только собственные публикации"
		+ "|по суммарному размеру собственных версий|квота меряет только"
		+ "|в квоту не входит|в квоту не входят", "|", Ложь);

	Нарушители = Новый Массив();
	Для Каждого Файл Из ФайлыПравилаКвоты() Цикл
		Текст = НРег(ПрочитатьТекст(Файл.ПолноеИмя));
		Для Каждого Запрет Из Запреты Цикл
			Если СтрНайти(Текст, НРег(Запрет)) > 0 Тогда
				Нарушители.Добавить(Файл.Имя + ": " + Запрет);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"тексты и документация обещают правило квоты, которого больше нет").Равно("");

КонецПроцедуры

// Чёрного списка мало: правило можно переписать любыми словами. Поэтому места, где хаб
// объясняет правило ЗАРАНЕЕ — экранные тексты и статья, — обязаны УТВЕРЖДАТЬ действующее:
// исчезновение утверждения красит сторож так же, как возвращение снятого. Текст самого
// отказа сюда не входит: его стережёт ВыросшийКэшОтвергаетСобственнуюПубликацию, читая
// сообщение отказа, а не файл.
&Тест
Процедура ТекстыИСтатьяУтверждаютЧтоКэшВКвоте() Экспорт

	Обязательные = Новый Соответствие();
	Обязательные.Вставить("src/модули/интерфейс/Классы/общее/СловарьТекстов.os",
		"кэш прокси|уборка кэша прокси");
	Обязательные.Вставить("docs/кэширующий-прокси.md", "квота меряет|кэш прокси");

	Пропажи = Новый Массив();
	Для Каждого КлючЗначение Из Обязательные Цикл
		Путь = ОбъединитьПути(КореньПроекта(), СтрЗаменить(КлючЗначение.Ключ, "/", ПолучитьРазделительПути()));
		Если НЕ Новый Файл(Путь).Существует() Тогда
			Пропажи.Добавить(КлючЗначение.Ключ + ": файла нет");
			Продолжить;
		КонецЕсли;
		Текст = НРег(ПрочитатьТекст(Путь));
		Для Каждого Утверждение Из СтрРазделить(КлючЗначение.Значение, "|", Ложь) Цикл
			Если СтрНайти(Текст, НРег(Утверждение)) = 0 Тогда
				Пропажи.Добавить(КлючЗначение.Ключ + ": нет «" + Утверждение + "»");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропажи, ", "),
		"место, где правило квоты объясняется человеку, перестало его утверждать").Равно("");

КонецПроцедуры

&Тест
Процедура ВнешнююВерсиюЗаводитТолькоОдинМетодРеестра() Экспорт

	// Прокси и зеркала обязаны ходить одним швом: заведись апстримная версия мимо
	// ИндексироватьВнешнюю — она снова начнёт попадать в квоту пула, и тихо.
	Нарушители = Новый Массив();
	Для Каждого Файл Из ФайлыКлассовПродукта() Цикл
		Если Файл.Имя = "СервисВерсий.os" ИЛИ Файл.Имя = "СервисПроисхождения.os" Тогда
			Продолжить; // сам шов и владелец словаря источников
		КонецЕсли;
		Текст = ПрочитатьТекст(Файл.ПолноеИмя);
		Если СтрНайти(Текст, "ИсточникАпстрим()") > 0 И СтрНайти(Текст, "Зафиксировать(") > 0 Тогда
			Нарушители.Добавить(Файл.Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"провенанс «апстрим» ставится мимо СервисВерсий.ИндексироватьВнешнюю").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЭффективнаяКвота

&Тест
Процедура ПулБезЯвнойКвотыБерётДефолтХаба() Экспорт

	Пул = Желудь("СервисПулов").СоздатьПул(УникальноеИмя("inherit"), "custom", "public");
	Ожидаем.Что(Цел(Число(Пул.КвотаМб)), "новый пул заведён со значением «как в хабе»")
		.Равно(Желудь("СервисПулов").КвотаКакВХабе());
	Ожидаем.Что(Желудь("СервисПулов").ЭффективнаяКвотаМб(Пул),
		"действует квота хаба по умолчанию").Равно(1024);

КонецПроцедуры

&Тест
Процедура ЯвнаяКвотаПулаПеребиваетДефолтХаба() Экспорт

	Пул = НовыйПулСКвотой(7);
	Ожидаем.Что(Желудь("СервисПулов").ЭффективнаяКвотаМб(Пул), "своя квота сильнее").Равно(7);
	Ожидаем.Что(Желудь("СервисПулов").ЭффективнаяКвотаБайт(Пул), "она же в байтах")
		.Равно(7 * 1024 * 1024);

