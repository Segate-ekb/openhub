#КонецОбласти

#Область СобытиеОсновногоПула

// Адрес объекта в журнале аудита — один формат на всех производителей: вид объекта,
// косая черта, имя. Голое имя пула неотличимо ни от логина, ни от имени пакета,
// и журнал по такому объекту не отфильтровать.
&Тест
Процедура НазначениеОсновногоПулаПишетВидОбъектаПередИменем() Экспорт

	Пул = Желудь("СервисПулов").СоздатьПул(УникальноеИмя("main"), "custom", "public");

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипОсновнойПулНазначен(), Слушатель);

	Желудь("СервисПулов").НазначитьПулПоУмолчанию(Пул.Идентификатор, "root");

	Событие = Слушатель.Первое(Издатель.ТипОсновнойПулНазначен());
	Ожидаем.Что(Событие <> Неопределено, "событие назначения опубликовано").ЭтоИстина();
	Ожидаем.Что(Событие.Данные.Объект, "объект аудита назван видом и именем")
		.Равно("пул/" + Строка(Пул.Имя));

КонецПроцедуры

#КонецОбласти

#Область СобытиеЗаполнения

&Тест
Процедура РостЗаполненияПубликуетСобытиеСПроцентами() Экспорт

	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);
	Данные = ПостроитьOspxДанные("fill", "1.0.0");

	// после публикации пул займёт ровно половину квоты
	ЗаписатьЗанятое(Пул, КвотаБайт(Пул) / 2 - Данные.Размер());

	Слушатель = Новый ЗаписывающийПодписчик();
	Желудь("ИздательСобытий").Подписать(Желудь("ИздательСобытий").ТипПулЗаполнен(), Слушатель);

	Итог = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		"fill-1.0.0.ospx", "stable", Польз, "");
	Ожидаем.Что(Итог.Успех, "публикация прошла: " + Строка(Итог.Сообщение)).ЭтоИстина();

	Событие = Слушатель.Первое(Желудь("ИздательСобытий").ТипПулЗаполнен());
	Ожидаем.Что(Событие <> Неопределено, "событие заполнения опубликовано").ЭтоИстина();
	Ожидаем.Что(Цел(Событие.Данные.ПулИдентификатор), "нагрузка несёт скоуп пула")
		.Равно(Цел(Пул.Идентификатор));
	Ожидаем.Что(Событие.Данные.Процент, "после операции — половина квоты").Равно(50);
	Ожидаем.Что(Событие.Данные.Процент > Событие.Данные.ПроцентДо,
		"нагрузка несёт и заполнение до операции").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УрезаниеКвотыПорождаетСобытиеЗаполнения() Экспорт

	// Занятое не меняется, но предел стал ближе — подписка обязана узнать об этом
	// ровно так же, как о росте пула. Раньше УстановитьКвоту молчала.
	Пул = НовыйПулСКвотой(10);
	ЗавестиСвоюВерсию(Пул, "shrink", "1.0.0", 900000); // ~8,6% от 10 МБ
	Пересчитать(Пул);

	Слушатель = Новый ЗаписывающийПодписчик();
	Желудь("ИздательСобытий").Подписать(Желудь("ИздательСобытий").ТипПулЗаполнен(), Слушатель);

	Желудь("СервисПулов").УстановитьКвоту(Пул.Идентификатор, 1); // те же байты — уже 85%

	Событие = Слушатель.Первое(Желудь("ИздательСобытий").ТипПулЗаполнен());
	Ожидаем.Что(Событие <> Неопределено, "урезание квоты дало событие").ЭтоИстина();
	Ожидаем.Что(Событие.Данные.Процент > Событие.Данные.ПроцентДо,
		"процент вырос без единого нового байта").ЭтоИстина();

КонецПроцедуры

