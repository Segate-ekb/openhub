КонецПроцедуры

// Чтение сырого значения и вердикт — одна дверь на форму раздела «Пулы», дом настроек
// пула, создание и PATCH API. Ведущий минус ОБЯЗАН читаться: -1 печатает сама форма.
&Тест
Процедура ЧтениеКвотыПринимаетЗнакНоНеМусор() Экспорт

	Сервис = Желудь("СервисПулов");

	Принято = Сервис.РассудитьКвоту("-1");
	Ожидаем.Что(Принято.Успех, "«как в хабе» строкой принимается").ЭтоИстина();
	Ожидаем.Что(Принято.Квота, "и разбирается в -1").Равно(-1);

	Ожидаем.Что(Сервис.РассудитьКвоту("0").Квота, "ноль — «без ограничения»").Равно(0);
	Ожидаем.Что(Сервис.РассудитьКвоту(" 256 ").Квота, "пробелы по краям не мешают").Равно(256);
	Ожидаем.Что(Сервис.РассудитьКвоту(-1).Квота, "число принимается наравне со строкой").Равно(-1);

	// -5 РАЗБИРАЕТСЯ, но отвергается вердиктом: чтение лексическое, диапазон судит правило
	Ожидаем.Что(Сервис.РассудитьКвоту("-5").Успех, "ниже «как в хабе» значений нет").ЭтоЛожь();

	// «12abc» на части платформ даёт 12 у платформенного Число() — здесь это мусор
	Для Каждого Мусор Из СтрРазделить("5oo|12abc|500abc|-|--1|-abc| |1 2|+7", "|") Цикл
		Ожидаем.Что(Сервис.РассудитьКвоту(Мусор).Успех,
			СтрШаблон("«%1» — не квота", Мусор)).ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Сервис.РассудитьКвоту("").Успех, "пустое значение квотой не становится").ЭтоЛожь();
	Ожидаем.Что(Сервис.РассудитьКвоту(Неопределено).Успех, "и Неопределено тоже").ЭтоЛожь();

	Ожидаем.Что(Сервис.РассудитьКвоту(Формат(Сервис.ПредельнаяКвотаМб(), "ЧГ=0")).Успех,
		"ровно потолок принимается").ЭтоИстина();
	Ожидаем.Что(Сервис.РассудитьКвоту(Формат(Сервис.ПредельнаяКвотаМб() + 1, "ЧГ=0")).Причина,
		"выше потолка — своя причина").Равно(Сервис.ПричинаКвотаПотолок());

КонецПроцедуры

#КонецОбласти

#Область ГейтПубликацииПоКвоте

&Тест
Процедура ПубликацияСверхКвотыОтвергаетсяИПулНеРастёт() Экспорт

	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);
	Данные = ПостроитьOspxДанные("overquota", "1.0.0");

	// пул забит так, что не хватает ровно одного байта
	ЗаписатьЗанятое(Пул, КвотаБайт(Пул) - Данные.Размер() + 1);
	ЗанятоДо = Занято(Пул);

	Итог = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		"overquota-1.0.0.ospx", "stable", Польз, "");

	Ожидаем.Что(Итог.Успех, "публикация сверх квоты отвергнута").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "код отказа — 507 Insufficient Storage").Равно(507);
	Ожидаем.Что(СтрНайти(НРег(Итог.Сообщение), "квота") > 0, "причина названа").ЭтоИстина();

	Ожидаем.Что(Занято(Пул), "пул не вырос").Равно(ЗанятоДо);
	Ожидаем.Что(ВерсияЕсть(Пул, "overquota", "1.0.0"), "версия не заведена").ЭтоЛожь();

	// скрипту конвейера те же числа нужны полями, а не разбором фразы: какой предел,
	// каким числом он задан и каким числом не пройден
	Ожидаем.Что(Итог.Подробности <> Неопределено, "отказ несёт подробности").ЭтоИстина();
	Ожидаем.Что(Итог.Подробности.pool, "названо имя пула").Равно(Пул.Имя);
	Ожидаем.Что(Итог.Подробности.limit, "названо, какой это предел").Равно("pool_quota_bytes");
	Ожидаем.Что(Итог.Подробности.limit_bytes, "предел числом").Равно(КвотаБайт(Пул));
	Ожидаем.Что(Итог.Подробности.used_bytes, "занятое числом").Равно(ЗанятоДо);
	Ожидаем.Что(Итог.Подробности.actual_bytes, "и размер, которым предел не пройден")
		.Равно(Данные.Размер());

КонецПроцедуры

// Пакет заводит приём версии, а не гейты перед ним. Прежний порядок регистрировал имя
// ДО проверки квоты: отбитая публикация оставляла в каталоге пакет без единой версии,
// повторная попытка видела имя занятым, TOFU на нём уже не срабатывал — и публикатор
// упирался в собственное имя, освободив место.
&Тест
Процедура ОтказПоКвотеНеЗанимаетНовоеИмяПакета() Экспорт

	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);
	Данные = ПостроитьOspxДанные("noname", "1.0.0");

	// не хватает ровно одного байта
	ЗаписатьЗанятое(Пул, КвотаБайт(Пул) - Данные.Размер() + 1);

	Отбитая = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		"noname-1.0.0.ospx", "stable", Польз, "");

	Ожидаем.Что(Отбитая.Код, "публикация отвергнута по квоте").Равно(507);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "noname"),
		"имя свободно: отбитая публикация пакета в каталоге не оставила").Равно(Неопределено);

	// место освободилось — то же имя публикуется как НОВОЕ, а не упирается в само себя
	ЗаписатьЗанятое(Пул, 0);
	Повтор = Желудь("СервисПубликации").Опубликовать(Пул.Имя,
		ПостроитьOspxДанные("noname", "1.0.0"), "noname-1.0.0.ospx", "stable", Польз, "");

	Ожидаем.Что(Повтор.Успех,
		"повтор после освобождения места проходит: " + Строка(Повтор.Сообщение)).ЭтоИстина();
	Ожидаем.Что(Повтор.Код, "201: это заведение нового имени, а не перезапись").Равно(201);
	Ожидаем.Что(ВерсияЕсть(Пул, "noname", "1.0.0"), "версия появилась").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПубликацияРовноВРазмерКвотыПроходит() Экспорт

	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);
	Данные = ПостроитьOspxДанные("exact", "1.0.0");

	// места ровно под артефакт: граница включительна
	ЗаписатьЗанятое(Пул, КвотаБайт(Пул) - Данные.Размер());

	Итог = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		"exact-1.0.0.ospx", "stable", Польз, "");

	Ожидаем.Что(Итог.Успех, "ровно в размер проходит: " + Строка(Итог.Сообщение)).ЭтоИстина();
	Ожидаем.Что(Занято(Пул), "пул заполнен ровно под квоту").Равно(КвотаБайт(Пул));

	Второй = Опубликовать(Пул, Польз, "exact2", "1.0.0");
	Ожидаем.Что(Второй.Успех, "следующий артефакт уже не помещается").ЭтоЛожь();
	Ожидаем.Что(Второй.Код, "и отвергается тем же кодом").Равно(507);

КонецПроцедуры

// Порядок гейтов приёма — сам инвариант: публикация, нарушающая СРАЗУ два правила (номер
// уже опубликован И места в пуле нет), обязана получить код правил приёма, а не квоты.
// Иначе клиенту советуют освободить место там, где номер закрыт навсегда, и совет уводит.
&Тест
Процедура ЗапретПовторнойПубликацииОтвечаетРаньшеКвоты() Экспорт

	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);

	Ожидаем.Что(Опубликовать(Пул, Польз, "twice", "1.0.0").Успех,
		"контроль: первая публикация проходит").ЭтоИстина();

	// пул забит вчетверо: одной квоты хватило бы на 507, если бы её спросили первой
	ЗаписатьЗанятое(Пул, КвотаБайт(Пул) * 4);
	Ожидаем.Что(Опубликовать(Пул, Польз, "roomless", "1.0.0").Код,
		"контроль: свободному номеру в забитом пуле отвечает квота").Равно(507);

	Повтор = Опубликовать(Пул, Польз, "twice", "1.0.0");

	Ожидаем.Что(Повтор.Успех).ЭтоЛожь();
	Ожидаем.Что(Повтор.Код,
		"правила приёма отвечают раньше квоты: 409 на занятый номер, а не 507 на место")
		.Равно(409);

КонецПроцедуры

&Тест
Процедура ПулБезОграниченияГейтомНеЗакрывается() Экспорт

	Пул = НовыйПулСКвотой(0);
	Польз = ИздательПула(Пул);
	ЗаписатьЗанятое(Пул, 999999999);

	Итог = Опубликовать(Пул, Польз, "nolimit", "1.0.0");
	Ожидаем.Что(Итог.Успех, "без квоты гейт молчит: " + Строка(Итог.Сообщение)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтзывМестаДляНовойПубликацииНеОсвобождает() Экспорт

	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);
	Первая = ПостроитьOspxДанные("free", "1.0.0");
	Вторая = ПостроитьOspxДанные("free", "1.0.1");

	// пул забит первой версией под завязку; запас — на возможную разницу размеров
	Запас = Макс(0, Вторая.Размер() - Первая.Размер());
	ЗаписатьЗанятое(Пул, КвотаБайт(Пул) - Первая.Размер() - Запас);
	Желудь("СервисПубликации").Опубликовать(Пул.Имя, Первая, "free-1.0.0.ospx", "stable", Польз, "");

	Отказ = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Вторая,
		"free-1.0.1.ospx", "stable", Польз, "");
	Ожидаем.Что(Отказ.Успех, "пул заполнен — вторая версия не проходит").ЭтоЛожь();
	Ожидаем.Что(Отказ.Код, "и отвергается по квоте").Равно(507);

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "free");
	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.0.0", Истина, "тест");

	ПослеОтзыва = Желудь("СервисПубликации").Опубликовать(Пул.Имя, ПостроитьOspxДанные("free", "1.0.1"),
		"free-1.0.1.ospx", "stable", Польз, "");
	Ожидаем.Что(ПослеОтзыва.Успех, "отзыв места не освободил — пул по-прежнему полон").ЭтоЛожь();
	Ожидаем.Что(ПослеОтзыва.Код, "и отказ тот же").Равно(507);
	Ожидаем.Что(СтрНайти(ПослеОтзыва.Сообщение, "отзыв версии места не освобождает") > 0,
		"текст отказа не советует отзывать версии").ЭтоИстина();

	// освобождает только удаление пакета
	Желудь("УборкаПакета").УдалитьПакет(Пакет);
	Успех = Желудь("СервисПубликации").Опубликовать(Пул.Имя, ПостроитьOspxДанные("free", "1.0.1"),
		"free-1.0.1.ospx", "stable", Польз, "");
	Ожидаем.Что(Успех.Успех, "после удаления место освободилось: " + Строка(Успех.Сообщение)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПерезаписьВерсииСчитаетТолькоПриращение() Экспорт

	// перезапись освобождает объём прежней версии: иначе publish SNAPSHOT упирался бы
	// в квоту после нескольких перезаписей, ничего в пул не добавив
	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);

	// Вторая сборка ЗАВЕДОМО крупнее первой: на одинаковых байтах «вычесть прежний объём»
	// и «вычесть новый» неразличимы, и вторая ошибка (перезапись любого размера бесплатна)
	// прошла бы мимо. Размеры не угадываются: разница обеспечена длинным README и проверена.
	Маленький = ПостроитьOspxДанные("rewrite", "1.0.0-SNAPSHOT", "# rewrite");
	Большой = ПостроитьOspxДанные("rewrite", "1.0.0-SNAPSHOT", ДлинныйReadme());
	Ожидаем.Что(Большой.Размер() > Маленький.Размер(),
		СтрШаблон("вторая сборка обязана быть крупнее первой: %1 против %2",
			Большой.Размер(), Маленький.Размер())).ЭтоИстина();

	Первый = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Маленький,
		"rewrite-1.0.0-SNAPSHOT.ospx", "stable", Польз, "");
	Ожидаем.Что(Первый.Успех, "первая публикация: " + Строка(Первый.Сообщение)).ЭтоИстина();
	Ожидаем.Что(Занято(Пул), "пул пустой, поэтому занято ровно первым артефактом")
		.Равно(Маленький.Размер());

	// номер уже опубликован, поэтому замена просится форсом — так её и делают снаружи
	Второй = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Большой,
		"rewrite-1.0.0-SNAPSHOT.ospx", "stable", Польз, "", Неопределено, Истина);
	Ожидаем.Что(Второй.Успех, "перезапись прошла: " + Строка(Второй.Сообщение)).ЭтоИстина();

	Ожидаем.Что(Занято(Пул),
		"после перезаписи занято РОВНО вторым артефактом: сумма означала бы двойной учёт,"
		+ " прежний размер — что перезапись любого размера бесплатна").Равно(Большой.Размер());

КонецПроцедуры

// README на несколько килобайт: разница в размере архива не должна зависеть от того,
// как сжались пара символов.
Функция ДлинныйReadme()

	Кусок = "# rewrite" + Символы.ПС + "Раздел с осмысленным текстом, который заведомо"
		+ " не ужимается в ноль: перечисление, ссылки, код." + Символы.ПС;
	Текст = "";
	Для Номер = 1 По 40 Цикл
		Текст = Текст + СтрШаблон("%1 %2 %3", Номер, Кусок, Строка(Новый УникальныйИдентификатор));
	КонецЦикла;

	Возврат Текст;

КонецФункции

#КонецОбласти

#Область КвотаПриСозданииПула

&Тест
Процедура КаждыйВходККвотеСпрашиваетСвойГвард() Экспорт

	// БЕЗ СПИСКА ВХОДОВ: вход ищется сам по тому, что он делает. Прежняя редакция
	// инспектировала только файлы из своего же перечня — новый вход не попадал под
	// проверку вовсе, и живой желудь, пишущий квоту без гварда, набор не замечал.
	// HTTP-тест экранного входа тоже ничего не доказывает: внешний гейт дома «Хаб»
	// отказывает раньше пульта. Инвариант стережётся здесь.
	Входы = Новый Массив();
	Безгвардейные = Новый Массив();

	Для Каждого Файл Из ФайлыКлассовПродукта() Цикл
		Текст = ПрочитатьТекст(Файл.ПолноеИмя);
		Если НЕ ПишетКвотуПула(Текст) Тогда
			Продолжить;
		КонецЕсли;
		Входы.Добавить(Файл.Имя);
		Если НЕ СпрашиваетГвардКвоты(Текст) Тогда
			Безгвардейные.Добавить(Файл.Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Безгвардейные, ", "),
		"вход к квоте пула, не спрашивающий ГвардКвотыПула").Равно("");

	// Антивакуумность: переименуйте УстановитьКвоту — и сканер перестанет находить что-либо,
	// оставаясь зелёным. Поэтому проверяется, что входы найдены и среди них оба экранных.
	Ожидаем.Что(Входы.Количество() >= 4,
		СтрШаблон("сканер нашёл входы к записи квоты (найдено: %1)",
			СтрСоединить(Входы, ", "))).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Входы, ", "), "среди входов — пульт раздела «Пулы»")
		.Содержит("ПультПулов.os");
	Ожидаем.Что(СтрСоединить(Входы, ", "), "и дом настроек пула")
		.Содержит("КонтроллерДомаПула.os");

КонецПроцедуры


&Тест
Процедура НеАдминКвотуПриСозданииПулаНеЗадаёт() Экспорт

	// второй вход к квоте: если бы её можно было выставить при создании, гейт правки
	// обходился бы заведением нового пула
	Служба = Желудь("СлужбаДоступа");
	НеАдмин = СоздатьСоздателяПулов();

	Попытка
		Служба.СоздатьПул(НеАдмин, УникальноеИмя("selfquota"), "custom", "public", 4096);
		Отказано = Ложь;
	Исключение
		Отказано = Истина;
		Причина = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказано, "не-админ квоту при создании не задаёт").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Причина), "квот") > 0, "причина названа квотой").ЭтоИстина();

КонецПроцедуры

