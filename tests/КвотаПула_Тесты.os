КонецПроцедуры

&Тест
Процедура ПлановаяСверкаЧинитСчётчикЛюбогоПула() Экспорт

	// пул без квоты сверяется наравне: его занятое рисуется в списке пулов, и именно
	// там владелец увидел «0 Б» у пула со 191 пакетом
	СКвотой = НовыйПулСКвотой(10);
	Польз = ИздательПула(СКвотой);
	Опубликовать(СКвотой, Польз, "auditme", "1.0.0");
	ВерныйСКвотой = Занято(СКвотой);

	БезКвоты = НовыйПулСКвотой(0);
	ПользБез = ИздательПула(БезКвоты);
	Опубликовать(БезКвоты, ПользБез, "noaudit", "1.0.0");
	ВерныйБезКвоты = Занято(БезКвоты);
	Ожидаем.Что(ВерныйБезКвоты > 0, "пул без квоты тоже занял место").ЭтоИстина();

	ЗаписатьЗанятое(СКвотой, 42);
	ЗаписатьЗанятое(БезКвоты, 42);

	Сводка = Желудь("СверкаОбъёмовПулов").Сверить();

	Ожидаем.Что(Занято(СКвотой), "пул с квотой сверен и починен").Равно(ВерныйСКвотой);
	Ожидаем.Что(Занято(БезКвоты), "пул без квоты сверен и починен").Равно(ВерныйБезКвоты);
	Ожидаем.Что(Сводка.ПуловИсправлено > 1, "сводка называет число починенных").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПадающийЗамерОставляетСтрокуВЖурнале() Экспорт

	// БЛОКЕР РЕВЬЮ: на S3 выше предела листинга замер падает, и молчали ВСЕ звенья —
	// ИсполнительСинхронный ловит исключение обработчика в дескриптор задачи по контракту,
	// планировщик задач не логирует, спан OTel по умолчанию выключен. Дрейф счётчиков
	// копился бы каждый час без единой строки в журнале хаба.
	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.сверка.объёмов");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Сверка = Новый СверкаОбъёмовПулов(Желудь("СервисПулов"), Желудь("УчётОбъёмаПула"),
		Новый ХранилищеПадающееНаЗамере(), Лог);

	БылоИсключение = Ложь;
	Попытка
		Сверка.Сверить();
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(БылоИсключение, "сбой замера по-прежнему уходит наверх, а не глотается").ЭтоИстина();
	Запись = Ловушка.Всё();
	Ожидаем.Что(Ловушка.Количество() > 0, "падающая сверка обязана оставить след в журнале").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запись, "замер хранилища не удался") > 0,
		"запись называет причину: " + Запись).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запись, "403") > 0,
		"и несёт исходную ошибку хранилища: " + Запись).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СверкаПоднимаетАлертЗаполненияБезДействийПользователя() Экспорт

	// пул может перейти границу сам: кэш прокси растёт от чужих скачиваний. Состояние
	// обязано доехать до подписки, а не выясняться при первой неудачной публикации
	Пул = НовыйПулСКвотой(1);
	ЗаписатьЗанятое(Пул, 0);

	Слушатель = Новый ЗаписывающийПодписчик();
	Желудь("ИздательСобытий").Подписать(Желудь("ИздательСобытий").ТипПулЗаполнен(), Слушатель);

	ЗакэшироватьАпстримные(Пул, "grewbyitself", 3, 300000); // ~86% от 1 МБ
	Желудь("СверкаОбъёмовПулов").Сверить();

	// событие ищется по скоупу пула: сверка проходит все пулы набора, и «первое пришедшее»
	// принадлежало бы соседу
	Событие = СобытиеПула(Слушатель, Пул);
	Ожидаем.Что(Событие <> Неопределено, "сверка заметила рост и опубликовала событие").ЭтоИстина();
	Ожидаем.Что(Событие.Данные.Процент > 80,
		"процент считается от реально занятого места: " + Строка(Событие.Данные.Процент)).ЭтоИстина();
	Ожидаем.Что(Цел(Событие.Данные.ЗанятоБайт), "нагрузка несёт замеренное занятое")
		.Равно(Занято(Пул));

КонецПроцедуры

&Тест
Процедура ПулБезКвотыСобытияЗаполненияНеПорождает() Экспорт

	Пул = НовыйПулСКвотой(0);
	Польз = ИздательПула(Пул);

	Слушатель = Новый ЗаписывающийПодписчик();
	Желудь("ИздательСобытий").Подписать(Желудь("ИздательСобытий").ТипПулЗаполнен(), Слушатель);

	Опубликовать(Пул, Польз, "nofill", "1.0.0");

	Ожидаем.Что(Слушатель.Количество(Желудь("ИздательСобытий").ТипПулЗаполнен()),
		"без квоты процента не существует — событию неоткуда взяться").Равно(0);

КонецПроцедуры

&Тест
Процедура ОтзывСобытияЗаполненияНеПорождает() Экспорт

	// событие говорит «пул заполняется»: падение заполнения — не повод для письма
	Пул = НовыйПулСКвотой(1);
	Польз = ИздательПула(Пул);
	Опубликовать(Пул, Польз, "drop", "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "drop");

	Слушатель = Новый ЗаписывающийПодписчик();
	Желудь("ИздательСобытий").Подписать(Желудь("ИздательСобытий").ТипПулЗаполнен(), Слушатель);

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.0.0", Истина, "тест");

	Ожидаем.Что(Слушатель.Количество(Желудь("ИздательСобытий").ТипПулЗаполнен()),
		"уменьшение занятого события не порождает").Равно(0);

КонецПроцедуры

#КонецОбласти

// --- служебные ---

// Пользователь с правом создания пула на хабе, но без роли администратора хаба.
Функция СоздатьСоздателяПулов()
	Польз = СоздатьПользователя();
	ВыдатьПравоСозданияПулов(Польз);
	Возврат Польз;
КонецФункции

Функция СоздатьАдминСоздателя()
	Польз = СоздатьАдмина();
	ВыдатьПравоСозданияПулов(Польз);
	Возврат Польз;
КонецФункции

Процедура ВыдатьПравоСозданияПулов(Знач Польз)
	Действия = Новый Структура("создание, изменение, удаление, чтение", Истина, Ложь, Ложь, Истина);
	Желудь("СервисПравДоступа").ЗафиксироватьГрант("пользователь", Польз.Идентификатор,
		Желудь("СервисПрав").ОбъектХаб(), Действия, 0);
КонецПроцедуры

// Кладёт в пул апстримные версии так же, как это делают СервисПрокси и СинхронизаторЗеркал:
// артефакт в хранилище плюс индекс с провенансом «апстрим». Возвращает объём закачанного.
Функция ЗакэшироватьАпстримные(Знач Пул, Знач ИмяПакета, Знач Сколько, Знач РазмерБайт)

	Итог = 0;
	Для Н = 1 По Сколько Цикл
		Итог = Итог + ЗакэшироватьВерсию(Пул, ИмяПакета, "1.0." + Формат(Н, "ЧГ=0; ЧН=0"), РазмерБайт);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Одна закэшированная версия: сначала байты в хранилище, затем индекс. Возвращает
// фактический размер записанного артефакта. Номер привезён фикстурой МИМО приёма версии,
// поэтому базовых тегов у пакета нет — боевой путь прокси завёл бы их, и запрет повторной
// публикации пришёл бы там с именем тега.
Функция ЗакэшироватьВерсию(Знач Пул, Знач ИмяПакета, Знач СтрокаВерсии, Знач РазмерБайт)

	Результат = Желудь("ХранилищеАртефактов").Сохранить(
		Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, СтрокаВерсии), ДанныеРазмером(РазмерБайт));

	Пакет = Желудь("СервисПакетов").НайтиИлиЗарегистрировать(Пул.Идентификатор, ИмяПакета);
	Заявка = Новый ЗаявкаНаПубликацию(Цел(Пакет.Идентификатор), СтрокаВерсии);
	Заявка.Размер = Результат.Размер;
	Заявка.Sha256 = Результат.Sha256;
	Желудь("СервисВерсий").ИндексироватьВнешнюю(Заявка, 1);

	Возврат Результат.Размер;

КонецФункции

// Ровно РазмерБайт однобайтовых символов: тесту важен вес артефакта, а не содержимое.
Функция ДанныеРазмером(Знач РазмерБайт)

	Текст = "x";
	Пока СтрДлина(Текст) < РазмерБайт Цикл
		Текст = Текст + Текст;
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Лев(Текст, РазмерБайт), "utf-8", Ложь);

КонецФункции

// Собственная версия заданного веса: то же состояние, что оставит push пакета такого
// размера — артефакт в хранилище и запись в реестре, — но без мегабайтной фикстуры.
Процедура ЗавестиСвоюВерсию(Знач Пул, Знач ИмяПакета, Знач СтрокаВерсии, Знач РазмерБайт)

	Результат = Желудь("ХранилищеАртефактов").Сохранить(
		Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, СтрокаВерсии), ДанныеРазмером(РазмерБайт));

	Пакет = Желудь("СервисПакетов").НайтиИлиЗарегистрировать(Пул.Идентификатор, ИмяПакета);
	Заявка = Новый ЗаявкаНаПубликацию(Цел(Пакет.Идентификатор), СтрокаВерсии);
	Заявка.Размер = Результат.Размер;
	Заявка.Sha256 = Результат.Sha256;
	Желудь("СервисВерсий").Опубликовать(Заявка);

КонецПроцедуры

// Запись квоты — это ВЫЗОВ через точку. Объявление самой функции в СервисеПулов входом
// не является, а «имя без получателя» скан уже однажды обмануло: подстрока встречалась
// в объявлении, и выпотрошенное тело оставалось незамеченным.
// Создание пула считается входом наравне с правкой: квота — его параметр, и не спроси
// создание право, гейт правки обходился бы заведением нового пула.
Функция ПишетКвотуПула(Знач Текст)
	Возврат СтрНайти(Текст, ".УстановитьКвоту(") > 0
		ИЛИ СтрНайти(Текст, ".СоздатьПул(") > 0;
КонецФункции

// Засчитывается только вопрос о ПРАВЕ: Квоты.Принять судит значение, а не право,
// и принимать её за гвард нельзя.
Функция СпрашиваетГвардКвоты(Знач Текст)
	Возврат СтрНайти(Текст, "ГвардКвоты.МожетМенятьКвоту(") > 0
		ИЛИ СтрНайти(Текст, "Квоты.ТребоватьПраво(") > 0;
КонецФункции

// Корпус, где правило квоты объясняется словами: продуктовый код (тексты интерфейса)
// и документация. Скан обязан краснеть, если корпус выродился.
Функция КореньПроекта()
	Возврат Новый Файл(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..")).ПолноеИмя;
КонецФункции

Функция ФайлыПравилаКвоты()

	Корень = КореньПроекта();
	Файлы = Новый Массив();
	Для Каждого Найденный Из НайтиФайлы(ОбъединитьПути(Корень, "src"), "*.os", Истина) Цикл
		Файлы.Добавить(Найденный);
	КонецЦикла;
	Для Каждого Найденный Из НайтиФайлы(ОбъединитьПути(Корень, "docs"), "*.md", Истина) Цикл
		Файлы.Добавить(Найденный);
	КонецЦикла;
	// README — витрина хаба и такой же носитель правила, как docs
	Для Каждого Найденный Из НайтиФайлы(Корень, "README.md", Ложь) Цикл
		Файлы.Добавить(Найденный);
	КонецЦикла;

	Ожидаем.Что(Файлы.Количество() > 300,
		СтрШаблон("корпус скана правила квоты выродился: файлов %1", Файлы.Количество())).ЭтоИстина();
	Возврат Файлы;

КонецФункции

Функция ФайлыКлассовПродукта()

	КаталогМодулей = ОбъединитьПути(
		Новый Файл(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..")).ПолноеИмя,
		"src", "модули");
	Возврат НайтиФайлы(КаталогМодулей, "*.os", Истина);

КонецФункции

Функция ПрочитатьТекст(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "utf-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

// Пул с квотой — фактура каждого теста набора, и квота у него своя в каждом.
Функция НовыйПулСКвотой(Знач КвотаМб)
	Возврат Засев.ПулСервисом(УникальноеИмя("quota"), "public", 0, КвотаМб);
КонецФункции

Функция ИздательПула(Знач Пул)
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");
	Возврат Польз;
КонецФункции

Функция ЗаписьПула(Знач Пул)
	Возврат Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Пул.Идентификатор);
КонецФункции

Функция Занято(Знач Пул)
	Возврат Желудь("СервисПулов").ЗанятоБайт(ЗаписьПула(Пул));
КонецФункции

// Замер области пула в хранилище с записью в счётчик — то же, что делает плановая сверка.
Функция Пересчитать(Знач Пул)
	Возврат Желудь("УчётОбъёмаПула").Пересчитать(ЗаписьПула(Пул));
КонецФункции

// Событие заполнения, адресованное именно этому пулу.
Функция СобытиеПула(Знач Слушатель, Знач Пул)

	Для Каждого Событие Из Слушатель.События Цикл
		Если Событие.Тип = Желудь("ИздательСобытий").ТипПулЗаполнен()
			И Цел(Событие.Данные.ПулИдентификатор) = Цел(Пул.Идентификатор) Тогда
			Возврат Событие;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция КвотаБайт(Знач Пул)
	Возврат Желудь("СервисПулов").ЭффективнаяКвотаБайт(ЗаписьПула(Пул));
КонецФункции

// Стартовая заполненность пула ставится прямо в счётчик: пределы измеряются в мегабайтах,
// а фикстурный артефакт весит килобайты — публиковать мегабайт по частям тест не станет.
Процедура ЗаписатьЗанятое(Знач Пул, Знач Байты)
	Запись = ЗаписьПула(Пул);
	Запись.ЗанятоБайт = Цел(Байты);
	Запись.Сохранить();
КонецПроцедуры

Функция РазмерВерсии(Знач Пул, Знач ИмяПакета, Знач СтрокаВерсии)
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Версия = Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, СтрокаВерсии);
	Возврат Цел(Версия.Размер);
КонецФункции

Функция ВерсияЕсть(Знач Пул, Знач ИмяПакета, Знач СтрокаВерсии)
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, СтрокаВерсии) <> Неопределено;
КонецФункции

Функция Опубликовать(Знач Пул, Знач Пользователь, Знач ИмяПакета, Знач СтрокаВерсии)
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя,
		ПостроитьOspxДанные(ИмяПакета, СтрокаВерсии),
		ИмяПакета + "-" + СтрокаВерсии + ".ospx", "stable", Пользователь, "");
КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия, Знач ТекстReadme = Неопределено)
	Возврат Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия, ТекстReadme);
КонецФункции

Функция СоздатьПользователя()
	Возврат СоздатьСРолью("user");
КонецФункции

Функция СоздатьАдмина()
	Возврат СоздатьСРолью("admin");
КонецФункции

Функция СоздатьСРолью(Знач РольХаба)
	Хранилище = Желудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("user");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

Процедура ВыдатьРоль(Знач Пул, Знач Польз, Знач Роль)
	Хранилище = Желудь("ХранилищеУчастниковПула");
	Участник = Хранилище.СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Польз.Идентификатор;
	Участник.Роль = Роль;
	Участник.Сохранить();
КонецПроцедуры

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

// Лог для классов, создаваемых НАПРЯМУЮ (минуя контейнер ОСени): инъекция `&Лог` в поле
// до них не доезжает, поэтому лог передаёт тест параметром конструктора (шаг 6.D).
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.публикация");
КонецФункции

// Список источников пула: с него спрашивают состав и порядок опроса. СервисПулов знает
// о нём лишь то, что у пула источники есть.
Функция Источники()
	Возврат Желудь("СервисАпстримовПула");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции
