&Тест
Процедура КвотаКакВХабеПринимаетсяСервисомАНижеНет() Экспорт

	Вердикт = Желудь("СервисПулов").ПроверитьКвоту(-1);
	Ожидаем.Что(Вердикт.Успех, "-1 — допустимое значение «как в хабе»").ЭтоИстина();
	Ожидаем.Что(Вердикт.Квота, "оно и сохраняется").Равно(-1);

	Ниже = Желудь("СервисПулов").ПроверитьКвоту(-2);
