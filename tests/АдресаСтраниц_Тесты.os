// Адреса страниц пула и пакета: одна дверь их строит, и маршруты хаба обслуживают именно её
// адреса — для имени любого вида, включая имена служебных адресов. Прежние адреса страниц не
// обслуживаются, короткая нотация opm остаётся за машинными ручками.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Маршруты;       // фикстура МаршрутыХаба — таблица маршрутов хаба в маршрутизаторе winow
Перем Страницы;       // АдресаСтраниц (основа)

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("МаршрутыХаба");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура СобратьМаршруты() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогМодулей = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя,
		"src", "модули");

	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	Страницы = Новый АдресаСтраниц();
	Маршруты = Новый МаршрутыХаба(КаталогМодулей);

КонецПроцедуры

#Область Дверь

&Тест
Процедура СтраницыПулаИПакетаЖивутПодPools() Экспорт

	Ожидаем.Что(Страницы.Пула("main"), "страница пула").Равно("/pools/main");
	Ожидаем.Что(Страницы.Пакета("main", "winow"), "страница пакета").Равно("/pools/main/packages/winow");
	Ожидаем.Что(Страницы.НастроекПула("main"), "настройки пула под его страницей")
		.Равно("/pools/main/settings");
	Ожидаем.Что(Страницы.НастроекПакета("main", "winow"), "настройки пакета под его страницей")
		.Равно("/pools/main/packages/winow/settings");

КонецПроцедуры

// Имя приходит и из адреса до резолва в сущность: слеш в нём не должен увести ссылку
// на другой экран.
&Тест
Процедура ИмяВАдресеКодируетсяСегментом() Экспорт

	Ожидаем.Что(Страницы.Пакета("a/b", "c d"), "слеш и пробел закодированы")
		.Равно("/pools/a%2Fb/packages/c%20d");
	Ожидаем.Что(Страницы.Пула("Mixed.Case-1_x"), "допустимые символы имени — как есть")
		.Равно("/pools/Mixed.Case-1_x");

КонецПроцедуры

#КонецОбласти

#Область МаршрутыЗаДверью

// Скан обязан видеть контроллеры: пустая таблица сделала бы проверки ниже вечнозелёными.
&Тест
Процедура ТаблицаМаршрутовСобранаЦеликом() Экспорт

	Ожидаем.Что(СтрСоединить(Маршруты.НеПрочитанные(), "; "),
		"контроллер не поддался разбору — на его маршрутах проверки ослепли бы").Равно("");
	Ожидаем.Что(Маршруты.Контроллеров() > 40,
		"контроллеров разобрано: " + Маршруты.Контроллеров()).ЭтоИстина();

КонецПроцедуры

// Ни один экран хаба не обслуживается адресом, первый сегмент которого — имя пула или логин:
// шаблона в корне дерева маршрутов нет вовсе.
&Тест
Процедура НиОдинАдресХабаНеНачинаетсяИменем() Экспорт

	НачинаютсяИменем = Новый Массив();
	Для Каждого Путь Из Маршруты.Пути() Цикл
		Сегменты = СтрРазделить(Путь, "/", Ложь);
		Если Сегменты.Количество() > 0 И Сегменты[0] = Маршруты.СимволПараметра() Тогда
			НачинаютсяИменем.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Маршруты.Пути().Количество() > 100, "маршруты прочитаны").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(НачинаютсяИменем, ", "), "адреса, первый сегмент которых — параметр")
		.Равно("");

КонецПроцедуры

// Имени нечего бояться: какой бы служебный адрес оно ни повторяло, страница пула, пакета
// и их настроек по адресу двери достаётся своему экрану.
&Тест
Процедура СтраницаПоАдресуДвериДостаётсяСвоемуЭкрануПриЛюбомИмени() Экспорт

	Для Каждого Имя Из ИменаСлужебныхАдресов() Цикл

		ПроверитьОбработчик(Страницы.Пула(Имя), "КонтроллерПула", "Показать");
		ПроверитьОбработчик(Страницы.НастроекПула(Имя), "КонтроллерДомаПула", "Обзор");
		ПроверитьОбработчик(Страницы.Пакета("main", Имя), "КонтроллерПакета", "Показать");
		ПроверитьОбработчик(Страницы.Пакета(Имя, Имя) + "/versions", "КонтроллерПакета", "Версии");
		ПроверитьОбработчик(Страницы.НастроекПакета(Имя, Имя), "КонтроллерДомаПакета", "Обзор");

	КонецЦикла;

КонецПроцедуры

// Прежние адреса страниц не обслуживает никто: ни шаблон, ни переадресация.
&Тест
Процедура ПрежниеАдресаСтраницНиктоНеОбслуживает() Экспорт

	Для Каждого Путь Из СтрРазделить("/public|/public/winow|/public/winow/versions|/public/settings"
		+ "|/public/winow/settings|/package/winow|/alice", "|") Цикл
		Обработчик = Маршруты.Обработчик(Путь);
		Ожидаем.Что(Обработчик, "прежний адрес никем не обслуживается: " + Путь
			+ ?(Обработчик = Неопределено, "", " (" + Обработчик.Контроллер + ")")).Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Короткая нотация opm: адреса выдачи и публикации, где пул не назван, и те же ручки под
// /pools/{пул} обслуживают машинные контроллеры, а не страницы.
&Тест
Процедура КороткаяНотацияOpmОстаётсяЗаМашиннымиРучками() Экспорт

	ПроверитьОбработчик("/download/list.txt", "КонтроллерВыдачиAPI");
	ПроверитьОбработчик("/download/winow/winow-1.0.0.ospx", "КонтроллерВыдачиAPI");
	ПроверитьОбработчик("/dev-channel/list.txt", "КонтроллерВыдачиAPI");
	ПроверитьОбработчик("/push", "КонтроллерПубликации");
	ПроверитьОбработчик("/changes", "КонтроллерИзмененийAPI");

	ПроверитьОбработчик("/pools/main/download/list.txt", "КонтроллерВыдачиAPI");
	ПроверитьОбработчик("/pools/main/download/winow/winow-1.0.0.ospx", "КонтроллерВыдачиAPI");
	ПроверитьОбработчик("/pools/main/channels/stable/download/list.txt", "КонтроллерВыдачиAPI");
	ПроверитьОбработчик("/pools/main/push", "КонтроллерПубликации");
	ПроверитьОбработчик("/pools/main/changes", "КонтроллерИзмененийAPI");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Процедура ПроверитьОбработчик(Знач Путь, Знач Контроллер, Знач Метод = "")

	Обработчик = Маршруты.Обработчик(Путь);
	Ожидаем.Что(Обработчик <> Неопределено, "адрес обслуживается: " + Путь).ЭтоИстина();
	Ожидаем.Что(Обработчик.Контроллер, "контроллер адреса " + Путь).Равно(Контроллер);
	Если ЗначениеЗаполнено(Метод) Тогда
		Ожидаем.Что(Обработчик.Метод, "точка маршрута адреса " + Путь).Равно(Метод);
	КонецЕсли;

КонецПроцедуры

// Имена, повторяющие служебные адреса хаба и описания API: прежде их держал список резерва.
Функция ИменаСлужебныхАдресов()
	Возврат СтрРазделить("api|login|settings|packages|pools|download|push|changes|me|hub|static|v3"
		+ "|swagger-ui.html|list.txt|versions|deps|channels", "|");
КонецФункции

#КонецОбласти
