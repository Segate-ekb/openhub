// Юнит-тесты полного цикла приглашения: админ заводит закрытую учётку и получает
// одноразовую ссылку, человек ставит по ней пароль, учётка открывается. Плюс инвариант
// «нет способа входа — нет активности», сроки, погашение, отказы и аудит.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать oscript-ui
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("данные", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("реестр", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("основа", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, "наблюдаемость", "Классы", "телеметрия"));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("события", "Классы")));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	// почта нужна не письмами, а сборкой: на ней стоит цикл подтверждения адреса, а на нём —
	// допуск ко входу (ИСТ-ДОСТ-010). Без модуля гейт не собирается, и вход падает
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("почта", "Классы")));
	// личный канал: письма подтверждения и восстановления ходят через него
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("связь", "Классы")));
	// ЗапускВФоне уехал из common в фоновыеЗадания; набор смотрит исход письма сразу,
	// поэтому прозвище занимает синхронный фейк, а не боевое задание
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	// словарь строк — поставщик китового ТекстыИнтерфейса, его просит ПисьмоПодтверждения
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "СловарьТекстов");
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("вход", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("права", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("настройки", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, "интерфейс", "Классы", "настройки"));

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "приглашения-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

#Область ПолныйЦикл

&Тест
Процедура АдминЗаводитЗакрытуюУчёткуИПолучаетСсылку() Экспорт

	Логин = УникальныйЛогин("inv");
	Исход = Служба().Пригласить(ПринципалСессии(Админ()), Логин, Логин + "@example.com", "user");

	Ожидаем.Что(Исход.Успех, "приглашение принято: " + Исход.Причина + " " + Исход.Сообщение)
		.ЭтоИстина();
	Ожидаем.Что(Исход.Логин, "ссылка выпущена именно этой учётке").Равно(Логин);
	Ожидаем.Что(СтрНайти(Исход.Ссылка, "oshub_inv_") > 0, "в ссылке значение приглашения")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Исход.Ссылка, "/invite?token=") > 0, "и адрес публичной страницы")
		.ЭтоИстина();

	Новая = Пользователи().НайтиПоЛогину(Логин);
	Ожидаем.Что(Новая, "учётка заведена").Существует();
	Ожидаем.Что(Новая.Активен = Истина, "учётка рождается закрытой").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Новая.ХешПароля), "пароля у неё нет").ЭтоЛожь();
	Ожидаем.Что(Новая.РольХаба, "роль записана").Равно("user");

КонецПроцедуры

&Тест
Процедура ПоСсылкеЧеловекСтавитПарольИУчёткаОткрывается() Экспорт

	Приглашённый = Пригласить();
	Логин = Приглашённый.Логин;

	ДоУстановки = Аутентификация().ВойтиПоПаролю(Логин, "Password123!", "203.0.113.10");
	Ожидаем.Что(ДоУстановки.Успех, "до установки пароля войти нельзя").ЭтоЛожь();

	Исход = Приглашения().Погасить(Приглашённый.Значение, "Password123!");
	Ожидаем.Что(Исход.Успех, "пароль установлен: " + Исход.Причина).ЭтоИстина();

	Учётка = Пользователи().НайтиПоЛогину(Логин);
	Ожидаем.Что(Учётка.Активен = Истина, "учётка стала активной").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Учётка.ХешПароля), "хеш пароля записан").ЭтоИстина();
	Ожидаем.Что(Учётка.ТребуетсяСменаПароля = Истина, "смены пароля не требуют").ЭтоЛожь();

	Вход = Аутентификация().ВойтиПоПаролю(Логин, "Password123!", "203.0.113.11");
	Ожидаем.Что(Вход.Успех, "после установки человек входит логином и паролем").ЭтоИстина();

	// закрытой учётке личное пространство не полагалось: оно заводится вместе с входом,
	// иначе приглашённый остался бы без своего пула навсегда
	Ожидаем.Что(Желудь("СервисПулов").НайтиПул(Логин),
		"личное пространство заведено по открытию учётки").Существует();

КонецПроцедуры

&Тест
Процедура СырогоЗначенияСсылкиВБазеНет() Экспорт

	Приглашённый = Пригласить();

	Ожидаем.Что(Приглашённый.Заявка.ХешТокена = Приглашённый.Значение,
		"в базе лежит хеш, а не сама ссылка").ЭтоЛожь();
	Ожидаем.Что(СтрДлина(Приглашённый.Заявка.ХешТокена), "sha256 в hex").Равно(64);
	Ожидаем.Что(Приглашённый.Заявка.Повод, "повод — приглашение")
		.Равно(Приглашения().ПоводПриглашение());

КонецПроцедуры

&Тест
Процедура СрокСсылкиБерётсяИзНастройкиХаба() Экспорт

	Момент = Дата(2026, 8, 4, 10, 0, 0);
	Приглашённый = Пригласить(Момент);

	Ожидаем.Что(Приглашения().СрокЖизниДней(), "дефолт срока ссылки — семь дней").Равно(7);
	Ожидаем.Что(Приглашённый.Заявка.Истекает,
		"срок отсчитан от момента выпуска").Равно(Момент + 7 * 86400);

КонецПроцедуры

#КонецОбласти

#Область ОтказыИГраницы

&Тест
Процедура ПросроченнаяСсылкаОтклоняетсяВключаяСамуГраницу() Экспорт

	Момент = Дата(2026, 8, 4, 11, 0, 0);
	Приглашённый = Пригласить(Момент);
	Истекает = Приглашённый.Заявка.Истекает;

	Ожидаем.Что(Приглашения().Проверить(Приглашённый.Значение, Истекает - 1).Годна,
		"за секунду до истечения ссылка ещё жива").ЭтоИстина();

	// сама граница: в секунду истечения ссылка уже мертва, лишнего интервала нет
	НаГранице = Приглашения().Проверить(Приглашённый.Значение, Истекает);
	Ожидаем.Что(НаГранице.Годна, "в момент истечения ссылка уже мертва").ЭтоЛожь();
	Ожидаем.Что(НаГранице.Причина, "и причина названа сроком")
		.Равно(Приглашения().ПричинаПросрочена());

	Погашение = Приглашения().Погасить(Приглашённый.Значение, "Password123!", Истекает);
	Ожидаем.Что(Погашение.Успех, "пароль по истёкшей ссылке не ставится").ЭтоЛожь();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Приглашённый.Логин).Активен = Истина,
		"и учётка осталась закрытой").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПовторноеИспользованиеСсылкиОтклоняется() Экспорт

	Приглашённый = Пригласить();

	Ожидаем.Что(Приглашения().Погасить(Приглашённый.Значение, "Password123!").Успех,
		"первый раз пароль ставится").ЭтоИстина();

	Повтор = Приглашения().Погасить(Приглашённый.Значение, "Другой456!");
	Ожидаем.Что(Повтор.Успех, "второй раз — отказ").ЭтоЛожь();
	Ожидаем.Что(Повтор.Причина).Равно(Приглашения().ПричинаПогашена());

	Вход = Аутентификация().ВойтиПоПаролю(Приглашённый.Логин, "Другой456!", "203.0.113.12");
	Ожидаем.Что(Вход.Успех, "второй пароль не записан").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВыпускНовойСсылкиГаситПрежнюю() Экспорт

	Приглашённый = Пригласить();
	Цель = Пользователи().НайтиПоЛогину(Приглашённый.Логин);

	Сброс = Служба().СброситьПароль(ПринципалСессии(Админ()), Цель.Идентификатор);
	Ожидаем.Что(Сброс.Успех, "новая ссылка выпущена: " + Сброс.Причина).ЭтоИстина();

	Старая = Приглашения().Проверить(Приглашённый.Значение);
	Ожидаем.Что(Старая.Годна, "прежняя ссылка перестала работать").ЭтоЛожь();
	Ожидаем.Что(Старая.Причина).Равно(Приглашения().ПричинаПогашена());

	Ожидаем.Что(Приглашения().Проверить(ЗначениеИзСсылки(Сброс.Ссылка)).Годна,
		"а новая работает").ЭтоИстина();
	Ожидаем.Что(Приглашения().Погасить(Приглашённый.Значение, "Password123!").Успех,
		"по погашенной ссылке пароль не ставится").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЧужойСекретИМусорнаяСсылкаОтклоняются() Экспорт

	Приглашённый = Пригласить();
	Идентификатор = Формат(Цел(Приглашённый.Заявка.Идентификатор), "ЧГ=0; ЧН=0");
	Чужая = СтрШаблон("oshub_inv_%1_%2", Идентификатор,
		"00000000000000000000000000000000000000000000000000");

	Ожидаем.Что(Приглашения().Проверить(Чужая).Причина,
		"существующий идентификатор с чужим секретом").Равно(Приглашения().ПричинаНетСсылки());
	Ожидаем.Что(Приглашения().Проверить("").Причина, "пустая строка")
		.Равно(Приглашения().ПричинаНетСсылки());
	Ожидаем.Что(Приглашения().Проверить("мусор").Причина, "мусор")
		.Равно(Приглашения().ПричинаНетСсылки());
	Ожидаем.Что(Приглашения().Проверить("oshub_inv_нечисло_abc").Причина, "нечисловой номер")
		.Равно(Приглашения().ПричинаНетСсылки());
	Ожидаем.Что(Приглашения().Проверить("oshub_inv_999999999_abc").Причина, "чужой номер")
		.Равно(Приглашения().ПричинаНетСсылки());
	Ожидаем.Что(Приглашения().Проверить(СтрШаблон("oshub_%1_abc", Идентификатор)).Причина,
		"форма PAT приглашением не является").Равно(Приглашения().ПричинаНетСсылки());

	Ожидаем.Что(Приглашения().Погасить(Чужая, "Password123!").Успех,
		"по чужому секрету пароль не ставится").ЭтоЛожь();
	Ожидаем.Что(Приглашения().Проверить(Приглашённый.Значение).Годна,
		"а настоящая ссылка перебором не сгорела").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СсылкаНаИсчезнувшуюУчёткуОтклоняется() Экспорт

	Приглашённый = Пригласить();

	// учётку снесли, пока ссылка шла к человеку
	Приглашённый.Заявка.ПользовательИдентификатор = 987654321;
	Приглашённый.Заявка.Сохранить();

	Проверка = Приглашения().Проверить(Приглашённый.Значение);
	Ожидаем.Что(Проверка.Годна, "ссылка без учётки негодна").ЭтоЛожь();
	Ожидаем.Что(Проверка.Причина).Равно(Приглашения().ПричинаНетУчётки());
	Ожидаем.Что(Приглашения().Погасить(Приглашённый.Значение, "Password123!").Успех,
		"и пароль ставить некому").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СлабыйПарольОтвергаетсяНоСсылкуНеГасит() Экспорт

	Приглашённый = Пригласить();

	Отказ = Приглашения().Погасить(Приглашённый.Значение, "123");
	Ожидаем.Что(Отказ.Успех, "слабый пароль отвергнут").ЭтоЛожь();
	Ожидаем.Что(Отказ.Причина).Равно(Приглашения().ПричинаПароль());
	Ожидаем.Что(ЗначениеЗаполнено(Отказ.Требования), "требования политики названы").ЭтоИстина();

	Учётка = Пользователи().НайтиПоЛогину(Приглашённый.Логин);
	Ожидаем.Что(Учётка.Активен = Истина, "учётка не открылась").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Учётка.ХешПароля), "и пароль не записан").ЭтоЛожь();

	Ожидаем.Что(Приглашения().Проверить(Приглашённый.Значение).Годна,
		"ссылка осталась годной: человеку дают попробовать ещё раз").ЭтоИстина();
	Ожидаем.Что(Приглашения().Погасить(Приглашённый.Значение, "Password123!").Успех,
		"и вторая попытка удаётся").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ИнвариантАктивности

&Тест
Процедура УчёткуБезСпособаВходаАктивироватьНельзя() Экспорт

	Приглашённый = Пригласить();
	Закрытая = Пользователи().НайтиПоЛогину(Приглашённый.Логин);
	Админ_ = Админ();

	Ожидаем.Что(Активность().ЕстьСпособВхода(Закрытая),
		"ни пароля, ни привязанной личности").ЭтоЛожь();

	Проверка = Активность().ПроверитьСменуАктивности(Админ_, Закрытая, Истина);
	Ожидаем.Что(Проверка.Можно, "разблокировка запрещена").ЭтоЛожь();
	Ожидаем.Что(Проверка.Причина).Равно(Активность().ПричинаНетСпособаВхода());

	Ожидаем.Что(АктивацияПадает(Админ_, Закрытая),
		"вызов мимо проверки отбивается исключением").ЭтоИстина();
	// системный путь прав не спрашивает, поэтому инвариант обязан стоять в самой точке
	// записи: иначе проверка держится только на предварительном вердикте
	Ожидаем.Что(СистемнаяАктивацияПадает(Закрытая),
		"и системный путь погашения ссылки тоже отбивается").ЭтоИстина();
	Ожидаем.Что(Пользователи().ПоИдентификатору(Закрытая.Идентификатор).Активен = Истина,
		"и в базе учётка осталась закрытой").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УчёткуСПривязаннойЛичностьюБезПароляАктивироватьМожно() Экспорт

	// регресс чисто-OIDC учёток: пароля у них нет by design, и буквальная проверка
	// «нет хеша» заперла бы их навсегда после блокировки
	Логин = УникальныйЛогин("oidc");
	Учётка = Пользователи().СоздатьПользователя(Логин, "", "", "user");
	Личности().Привязать(Учётка.Идентификатор, "https://issuer.example", Логин, "");

	Активность().УстановитьАктивность(Админ(), Учётка, Ложь);
	Ожидаем.Что(Пользователи().ПоИдентификатору(Учётка.Идентификатор).Активен = Истина,
		"учётка заблокирована").ЭтоЛожь();

	Ожидаем.Что(ЗначениеЗаполнено(Учётка.ХешПароля), "пароля у неё нет").ЭтоЛожь();
	Ожидаем.Что(Активность().ЕстьСпособВхода(Учётка), "но способ входа есть").ЭтоИстина();

	Ожидаем.Что(Активность().УстановитьАктивность(Админ(), Учётка, Истина),
		"разблокировка проходит").ЭтоИстина();
	Ожидаем.Что(Пользователи().ПоИдентификатору(Учётка.Идентификатор).Активен = Истина,
		"и учётка снова активна").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АктивностьМеняетТолькоАдминИНеСебе() Экспорт

	Админ_ = Админ();
	Обычный = Пользователи().СоздатьПользователя(УникальныйЛогин("plain"), "",
		"Password123!", "user");
	Жертва = Пользователи().СоздатьПользователя(УникальныйЛогин("victim"), "",
		"Password123!", "user");

	Ожидаем.Что(Активность().ПроверитьСменуАктивности(Обычный, Жертва, Ложь).Причина,
		"не админ активность не меняет").Равно(Активность().ПричинаНеАдмин());
	Ожидаем.Что(Активность().ПроверитьСменуАктивности(Админ_, Админ_, Ложь).Причина,
		"себя заблокировать нельзя").Равно(Активность().ПричинаСебе());
	Ожидаем.Что(Активность().ПроверитьСменуАктивности(Админ_, Неопределено, Ложь).Причина,
		"несуществующая учётка — отказ, а не сбой").Равно(Активность().ПричинаНетУчётки());

	Ожидаем.Что(Активность().ПроверитьСменуАктивности(Админ_, Жертва, Ложь).Можно,
		"а законная блокировка разрешена").ЭтоИстина();
	Ожидаем.Что(Активность().УстановитьАктивность(Админ_, Жертва, Ложь),
		"блокировка записана").ЭтоИстина();
	Ожидаем.Что(Активность().УстановитьАктивность(Админ_, Жертва, Ложь),
		"повтор ничего не меняет").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПорогОперации

&Тест
Процедура НеАдминНеЗаводитУчётокИНеВыпускаетСсылок() Экспорт

	Обычный = Пользователи().СоздатьПользователя(УникальныйЛогин("nonadmin"), "",
		"Password123!", "user");
	Приглашённый = Пригласить();
	Цель = Пользователи().НайтиПоЛогину(Приглашённый.Логин);
	Логин = УникальныйЛогин("ghost");

	Отказ = Служба().Пригласить(ПринципалСессии(Обычный), Логин, "", "user");
	Ожидаем.Что(Отказ.Успех, "обычный пользователь учёток не заводит").ЭтоЛожь();
	Ожидаем.Что(Отказ.Причина).Равно(Служба().ПричинаНеАдмин());
	Ожидаем.Что(Отказ.Код).Равно(403);
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин), "учётка не появилась").Равно(Неопределено);

	Ожидаем.Что(Служба().СброситьПароль(ПринципалСессии(Обычный), Цель.Идентификатор).Причина,
		"и ссылок не выпускает").Равно(Служба().ПричинаНеАдмин());
	Ожидаем.Что(Служба().Пригласить(Неопределено, Логин, "", "user").Причина,
		"аноним — тем более").Равно(Служба().ПричинаАноним());
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин), "и после анонима учётки нет")
		.Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура КлючомУчёткиНеЗаводят() Экспорт

	// ключ, заведя учётку с ролью admin и выпустив на неё ссылку, получил бы сессию
	// администратора вообще без рамок ключа
	Логин = УникальныйЛогин("bykey");
	Отказ = Служба().Пригласить(ПринципалКлюча(Админ()), Логин, "", "admin");

	Ожидаем.Что(Отказ.Успех, "ключом учётку не завести").ЭтоЛожь();
	Ожидаем.Что(Отказ.Причина).Равно(Служба().ПричинаКлючЗапрещён());
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин), "учётка не появилась").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗанятыйЛогинОтдаётДоменныйТекстОтказа() Экспорт

	Приглашённый = Пригласить();
	Отказ = Служба().Пригласить(ПринципалСессии(Админ()), Приглашённый.Логин, "", "user");

	Ожидаем.Что(Отказ.Успех, "занятый логин отвергнут").ЭтоЛожь();
	Ожидаем.Что(Отказ.Причина).Равно(Служба().ПричинаСоздание());
	Ожидаем.Что(СтрНайти(Отказ.Сообщение, Приглашённый.Логин) > 0,
		"текст отказа называет логин").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ГейтПарольногоВхода

// ПОРЯДОК ПРОВЕРОК — часть контракта отказа: он обязан называть БЛИЖАЙШУЮ причину.
// Конфигурация хаба (включён ли парольный вход) — не дело того, кто и права-то не имеет:
// анониму и не-админу отказ рассказывал бы, как устроен вход на этой инсталляции.
&Тест
Процедура ОтказНазываетСвоюПричинуАНеКонфигурациюХаба() Экспорт

	Чужой = Пользователи().СоздатьПользователя(УникальныйЛогин("outsider"),
		"", "OutsiderPassw0rd", "user");

	ВыключитьПарольныйВход();
	Попытка

		Аноним = Служба().ПроверитьПраво(Неопределено, "создание");
		Ожидаем.Что(Аноним.Причина, "анониму — «нет учётной записи»")
			.Равно(Служба().ПричинаАноним());
		Ожидаем.Что(Аноним.Код).Равно(401);

		НеАдмин = Служба().ПроверитьПраво(ПринципалСессии(Чужой), "создание");
		Ожидаем.Что(НеАдмин.Причина, "не-админу — «только администратор»")
			.Равно(Служба().ПричинаНеАдмин());

		// а вот администратору называется именно конфигурация: он её и может починить
		Админский = Служба().ПроверитьПраво(ПринципалСессии(Админ()), "создание");
		Ожидаем.Что(Админский.Причина, "администратору — выключенный парольный вход")
			.Равно(Служба().ПричинаПарольныйВходВыключен());

	Исключение
		ВернутьПарольныйВход();
		ВызватьИсключение;
	КонецПопытки;
	ВернутьПарольныйВход();

	// КОНТРОЛЬ: с включённым парольным входом тот же администратор проходит порог
	Ожидаем.Что(Служба().ПроверитьПраво(ПринципалСессии(Админ()), "создание").Успех,
		"КОНТРОЛЬ: порог не запирает администратора сам по себе").ЭтоИстина();

КонецПроцедуры

// Ссылка заводит пароль, а на хабе без парольного входа пароль не пускает никого:
// оба конца цикла — выпуск и погашение — обязаны отказать, иначе учётка выглядит
// активной, а войти в неё нечем.
&Тест
Процедура БезПарольногоВходаСсылкаНеВыпускаетсяИНеГасится() Экспорт

	Приглашённый = Пригласить();
	Цель = Пользователи().НайтиПоЛогину(Приглашённый.Логин);
	Логин = УникальныйЛогин("nopwd");

	ВыключитьПарольныйВход();
	Попытка

		Отказ = Служба().Пригласить(ПринципалСессии(Админ()), Логин, "", "user");
		Ожидаем.Что(Отказ.Успех, "учётка со ссылкой не заводится").ЭтоЛожь();
		Ожидаем.Что(Отказ.Причина).Равно(Приглашения().ПричинаПарольныйВходВыключен());
		Ожидаем.Что(Отказ.Код).Равно(403);
		Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин), "учётки не появилось").Равно(Неопределено);

		Ожидаем.Что(Служба().СброситьПароль(ПринципалСессии(Админ()), Цель.Идентификатор).Причина,
			"и сброс не выпускает ссылку").Равно(Приглашения().ПричинаПарольныйВходВыключен());

		// второй конец: доменный выпуск мимо службы отбивается исключением
		Ожидаем.Что(ВыпускПадает(Цель), "выпуск мимо порога — исключение").ЭтоИстина();

		Проверка = Приглашения().Проверить(Приглашённый.Значение);
		Ожидаем.Что(Проверка.Годна, "выпущенная до выключения ссылка негодна").ЭтоЛожь();
		Ожидаем.Что(Проверка.Причина).Равно(Приглашения().ПричинаПарольныйВходВыключен());

		Погашение = Приглашения().Погасить(Приглашённый.Значение, "Password123!");
		Ожидаем.Что(Погашение.Успех, "и погасить её нельзя").ЭтоЛожь();
		Ожидаем.Что(Погашение.Причина).Равно(Приглашения().ПричинаПарольныйВходВыключен());

		Учётка = Пользователи().НайтиПоЛогину(Приглашённый.Логин);
		Ожидаем.Что(Учётка.Активен = Истина, "учётка осталась закрытой").ЭтоЛожь();
		Ожидаем.Что(ЗначениеЗаполнено(Учётка.ХешПароля), "и пароля у неё нет").ЭтоЛожь();

	Исключение
		ВернутьПарольныйВход();
		ВызватьИсключение;
	КонецПопытки;
	ВернутьПарольныйВход();

	Ожидаем.Что(Приглашения().Проверить(Приглашённый.Значение).Годна,
		"с возвратом парольного входа ссылка снова годна").ЭтоИстина();

КонецПроцедуры

// Пароль — способ входа, только пока парольный вход включён: иначе «Разблокировать»
// обещало бы вход в учётку, войти в которую нечем.
&Тест
Процедура БезПарольногоВходаПарольСпособомВходаНеСчитается() Экспорт

	Парольная = Пользователи().СоздатьПользователя(УникальныйЛогин("onlypwd"), "",
		"Password123!", "user");
	ЛогинЛичности = УникальныйЛогин("withoidc");
	СЛичностью = Пользователи().СоздатьПользователя(ЛогинЛичности, "", "Password123!", "user");
	Личности().Привязать(СЛичностью.Идентификатор, "https://issuer.example", ЛогинЛичности, "");

	Активность().УстановитьАктивность(Админ(), Парольная, Ложь);
	Активность().УстановитьАктивность(Админ(), СЛичностью, Ложь);

	ВыключитьПарольныйВход();
	Попытка

		Ожидаем.Что(Активность().ЕстьСпособВхода(Парольная),
			"мёртвый пароль способом входа не считается").ЭтоЛожь();
		Ожидаем.Что(Активность().ПроверитьСменуАктивности(Админ(), Парольная, Истина).Причина,
			"и разблокировать такую учётку нельзя")
			.Равно(Активность().ПричинаНетСпособаВхода());

		Ожидаем.Что(Активность().ЕстьСпособВхода(СЛичностью),
			"привязанная личность способом входа остаётся").ЭтоИстина();
		Ожидаем.Что(Активность().УстановитьАктивность(Админ(), СЛичностью, Истина),
			"и её учётка разблокируется").ЭтоИстина();

	Исключение
		ВернутьПарольныйВход();
		ВызватьИсключение;
	КонецПопытки;
	ВернутьПарольныйВход();

	Ожидаем.Что(Активность().ЕстьСпособВхода(Парольная),
		"с возвратом парольного входа пароль снова годен").ЭтоИстина();

КонецПроцедуры

// Учётка с паролем на хабе без парольного входа и учётка без пароля вовсе выглядят
// одинаково, а лечатся по-разному: первой нужен включённый парольный вход, второй —
// ссылка установки пароля. Один текст на оба случая ведёт оператора не туда.
&Тест
Процедура ОтказАктивацииРазличаетМёртвыйПарольИОтсутствиеПароля() Экспорт

	Парольная = Пользователи().СоздатьПользователя(УникальныйЛогин("deadpwd"), "",
		"Password123!", "user", Ложь, Ложь);
	Пустая = Пользователи().СоздатьПользователя(УникальныйЛогин("nopwd"), "", "",
		"user", Ложь, Ложь);

	БезПароля = ТекстОтказаАктивации(Пустая);
	Ожидаем.Что(СтрНайти(БезПароля, "ни пароля") > 0,
		"пароля нет вовсе — так и сказано: " + БезПароля).ЭтоИстина();

	ВыключитьПарольныйВход();
	Попытка

		Мёртвый = ТекстОтказаАктивации(Парольная);
		Ожидаем.Что(СтрНайти(Мёртвый, "вход по логину и паролю на хабе выключен") > 0,
			"мёртвый пароль назван мёртвым, а не отсутствующим: " + Мёртвый).ЭтоИстина();

	Исключение
		ВернутьПарольныйВход();
		ВызватьИсключение;
	КонецПопытки;
	ВернутьПарольныйВход();

	// КОНТРОЛЬ: с включённым парольным входом та же учётка активируется
	Ожидаем.Что(ТекстОтказаАктивации(Парольная),
		"КОНТРОЛЬ: работающий пароль открывает вход").Равно("");

КонецПроцедуры

#КонецОбласти

#Область БлокировкаИСброс

// Блокировка гасит живые ссылки: иначе выпущенный перед ней сброс вернул бы человеку
// вход в обход «Заблокировать», и следа об этом не осталось бы.
&Тест
Процедура БлокировкаГаситЖивыеСсылкиУчётки() Экспорт

	Логин = УникальныйЛогин("blocked");
	Активная = Пользователи().СоздатьПользователя(Логин, "", "OldPassw0rd!", "user");

	Сброс = Служба().СброситьПароль(ПринципалСессии(Админ()), Активная.Идентификатор);
	Ожидаем.Что(Сброс.Успех, "ссылка сброса выпущена").ЭтоИстина();
	Значение = ЗначениеИзСсылки(Сброс.Ссылка);
	Ожидаем.Что(Приглашения().Проверить(Значение).Годна, "и она годна").ЭтоИстина();

	Активность().УстановитьАктивность(Админ(), Активная, Ложь);

	Ожидаем.Что(Приглашения().Проверить(Значение).Причина,
		"после блокировки ссылка погашена").Равно(Приглашения().ПричинаПогашена());
	Ожидаем.Что(Приглашения().Погасить(Значение, "NewPassw0rd!").Успех,
		"и вход по ней не вернуть").ЭтоЛожь();
	Ожидаем.Что(Пользователи().ПоИдентификатору(Активная.Идентификатор).Активен = Истина,
		"учётка осталась заблокированной").ЭтоЛожь();

КонецПроцедуры

// Повторное закрытие уже закрытой учётки признак не меняет, но ссылки гасит: инвариант
// «закрытая учётка не ждёт ссылок» не зависит от того, была ли она закрыта раньше.
&Тест
Процедура ПовторнаяБлокировкаВсёРавноГаситСсылки() Экспорт

	Приглашённый = Пригласить();
	Цель = Пользователи().НайтиПоЛогину(Приглашённый.Логин);

	Ожидаем.Что(Активность().УстановитьАктивность(Админ(), Цель, Ложь),
		"признак уже был закрыт — смены нет").ЭтоЛожь();
	Ожидаем.Что(Приглашения().Проверить(Приглашённый.Значение).Причина,
		"а ссылка всё равно погашена").Равно(Приглашения().ПричинаПогашена());

КонецПроцедуры

// Сброс активному пользователю: прежний пароль работает до погашения, после — только
// новый, и учётка всё это время остаётся активной.
&Тест
Процедура СбросАктивномуМеняетПарольНеЗакрываяУчётку() Экспорт

	Логин = УникальныйЛогин("reset");
	Пользователь = Пользователи().СоздатьПользователя(Логин, "", "OldPassw0rd!", "user");

	Сброс = Служба().СброситьПароль(ПринципалСессии(Админ()), Пользователь.Идентификатор);
	Значение = ЗначениеИзСсылки(Сброс.Ссылка);

	Ожидаем.Что(Аутентификация().ВойтиПоПаролю(Логин, "OldPassw0rd!", "203.0.113.20").Успех,
		"до погашения прежний пароль работает").ЭтоИстина();
	Ожидаем.Что(Пользователи().ПоИдентификатору(Пользователь.Идентификатор).Активен = Истина,
		"и учётка активна").ЭтоИстина();

	Ожидаем.Что(Приглашения().Погасить(Значение, "NewPassw0rd!").Успех, "пароль сменён").ЭтоИстина();

	Ожидаем.Что(Аутентификация().ВойтиПоПаролю(Логин, "OldPassw0rd!", "203.0.113.21").Успех,
		"прежний пароль больше не работает").ЭтоЛожь();
	Ожидаем.Что(Аутентификация().ВойтиПоПаролю(Логин, "NewPassw0rd!", "203.0.113.22").Успех,
		"новый работает").ЭтоИстина();
	Ожидаем.Что(Пользователи().ПоИдентификатору(Пользователь.Идентификатор).Активен = Истина,
		"учётка осталась активной").ЭтоИстина();

КонецПроцедуры

// Сброс чисто-OIDC учётке: пароля у неё не было, ссылка его заводит, вход провайдером
// при этом никуда не девается.
&Тест
Процедура СбросЧистоOIDCУчёткеЗаводитПарольНеТрогаяЛичность() Экспорт

	Логин = УникальныйЛогин("oidconly");
	Учётка = Пользователи().СоздатьПользователя(Логин, "", "", "user");
	Личности().Привязать(Учётка.Идентификатор, "https://issuer.example", Логин, "");

	Ожидаем.Что(ЗначениеЗаполнено(Учётка.ХешПароля), "предпосылка: пароля нет").ЭтоЛожь();

	Сброс = Служба().СброситьПароль(ПринципалСессии(Админ()), Учётка.Идентификатор);
	Ожидаем.Что(Сброс.Успех, "ссылка выпущена и чисто-OIDC учётке").ЭтоИстина();

	Ожидаем.Что(Приглашения().Погасить(ЗначениеИзСсылки(Сброс.Ссылка), "Password123!").Успех,
		"пароль задан").ЭтоИстина();

	После = Пользователи().ПоИдентификатору(Учётка.Идентификатор);
	Ожидаем.Что(После.Активен = Истина, "учётка активна").ЭтоИстина();
	Ожидаем.Что(Аутентификация().ВойтиПоПаролю(Логин, "Password123!", "203.0.113.23").Успех,
		"и теперь входит паролем").ЭтоИстина();
	Ожидаем.Что(Личности().ЛичностиПользователя(Учётка.Идентификатор).Количество(),
		"привязка провайдера на месте").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область АудитИЧистка

&Тест
Процедура ЦиклПриглашенияДоезжаетДоЖурналаАудита() Экспорт

	Издатель = Желудь("ИздательСобытий");
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПриглашениеУчётки(), Слушатель);

	Логин = УникальныйЛогин("audited");
	Исход = Служба().Пригласить(ПринципалСессии(Админ()), Логин, "", "user", "203.0.113.9");
	Приглашения().Погасить(ЗначениеИзСсылки(Исход.Ссылка), "Password123!");

	Действия = ДействияСобытий(Слушатель, Издатель.ТипПриглашениеУчётки(), Логин);
	Летопись_ = Желудь("ЛетописьУчёток");

	Ожидаем.Что(Действия.Найти(Летопись_.ДействиеУчёткаЗаведена()) <> Неопределено,
		"заведение учётки записано").ЭтоИстина();
	Ожидаем.Что(Действия.Найти(Летопись_.ДействиеСсылкаВыпущена()) <> Неопределено,
		"выпуск ссылки записан").ЭтоИстина();
	Ожидаем.Что(Действия.Найти(Летопись_.ДействиеПарольУстановлен()) <> Неопределено,
		"установка пароля записана").ЭтоИстина();

	Для Каждого Событие Из Слушатель.События Цикл
		Ожидаем.Что(СтрНайти(Событие.Данные.ДеталиJSON, "oshub_inv_"),
			"сырой ссылки в журнале нет никогда").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЧисткаУдаляетТолькоПросроченныеЗаявки() Экспорт

	Старт = Дата(2026, 8, 4, 12, 0, 0);
	Старая = Пригласить(Старт);
	Живая = Пригласить(Старт + 86400);

	Граница = Старая.Заявка.Истекает + 1;
	Ожидаем.Что(Приглашения().УдалитьПросроченные(Граница) >= 1,
		"просроченная заявка удалена").ЭтоИстина();

	Ожидаем.Что(Приглашения().Проверить(Старая.Значение, Граница).Причина,
		"удалённая ссылка неизвестна").Равно(Приглашения().ПричинаНетСсылки());
	Ожидаем.Что(Приглашения().Проверить(Живая.Значение, Граница).Годна,
		"живая ссылка чисткой не тронута").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Приглашения()
	Возврат Желудь("СервисПриглашений");
КонецФункции

Функция Служба()
	Возврат Желудь("СлужбаПриглашений");
КонецФункции

Функция Пользователи()
	Возврат Желудь("СервисПользователей");
КонецФункции

Функция Активность()
	Возврат Желудь("СервисАктивностиУчёток");
КонецФункции

Функция Личности()
	Возврат Желудь("СервисЛичностей");
КонецФункции

Функция Аутентификация()
	Возврат Желудь("СервисАутентификации");
КонецФункции

// Приглашённая учётка с живой ссылкой: Логин, Значение (сырая ссылка), Заявка.
Функция Пригласить(Знач Момент = Неопределено)

	Логин = УникальныйЛогин("guest");
	Учётка = Пользователи().СоздатьПользователя(Логин, Логин + "@example.com", "", "user",
		Ложь, Ложь);
	Выпуск = Приглашения().Выпустить(Учётка, Приглашения().ПоводПриглашение(), "root", Момент);

	Возврат Новый Структура("Логин, Значение, Заявка",
		Логин, Выпуск.Значение, Выпуск.Заявка);

КонецФункции

// Единственный администратор набора: смену активности и приглашения судят по нему.
Функция Админ()

	Найденный = Пользователи().НайтиПоЛогину("invadmin");
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;
	Возврат Пользователи().СоздатьПользователя("invadmin", "invadmin@example.com",
		"AdminPassw0rd", "admin");

КонецФункции

Функция ПринципалСессии(Знач Пользователь)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, "session", "", 0, Неопределено);
КонецФункции

Функция ПринципалКлюча(Знач Пользователь)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, "token", "read,write", 0, Неопределено);
КонецФункции

Функция ЗначениеИзСсылки(Знач Ссылка)
	Маркер = "token=";
	Позиция = СтрНайти(Ссылка, Маркер);
	Возврат ?(Позиция = 0, "", Сред(Ссылка, Позиция + СтрДлина(Маркер)));
КонецФункции

Функция ДействияСобытий(Знач Слушатель, Знач ТипСобытия, Знач Логин)

	Результат = Новый Массив();
	Для Каждого Событие Из Слушатель.События Цикл
		Если Событие.Тип = ТипСобытия И СтрНайти(Строка(Событие.Данные.Объект), Логин) > 0 Тогда
			Результат.Добавить(Строка(Событие.Данные.Действие));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ВыключитьПарольныйВход()
	Желудь("СервисНастроек").УстановитьМеханизмом("oshub.auth.password.enabled", Ложь, "тест",
		"СтражПарольногоВхода");
КонецПроцедуры

Процедура ВернутьПарольныйВход()
	Желудь("СервисНастроек").Сбросить("oshub.auth.password.enabled", "тест");
КонецПроцедуры

Функция ВыпускПадает(Знач Цель)
	Попытка
		Приглашения().Выпустить(Цель, Приглашения().ПоводСброс(), "root");
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция СистемнаяАктивацияПадает(Знач Цель)
	Возврат ЗначениеЗаполнено(ТекстОтказаАктивации(Цель));
КонецФункции

Функция ТекстОтказаАктивации(Знач Цель)
	Попытка
		Активность().Активировать(Цель);
		Возврат "";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция АктивацияПадает(Знач Инициатор, Знач Цель)
	Попытка
		Активность().УстановитьАктивность(Инициатор, Цель, Истина);
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция УникальныйЛогин(Знач Приставка)
	Счётчик = Счётчик + 1;
	Возврат Приставка + Формат(Счётчик, "ЧГ=0; ЧН=0")
		+ Прав(Строка(Новый УникальныйИдентификатор), 6);
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Процедура ПодключитьСервисы(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить; // контроллерам нужен winow, в юнит-контейнере не подключаем
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
