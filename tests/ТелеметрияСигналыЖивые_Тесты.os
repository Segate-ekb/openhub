// Живой хаб с включённой телеметрией против настоящего OTLP-приёмника: доказывается,
// что все три сигнала действительно уезжают по сети и что строка журнала несёт
// идентификатор трассы своего запроса. Офлайн этого не увидеть: конвейеры, партии
// и срез метрик по расписанию — дело SDK и фонового экспорта.
//
// Протокол выбран http/json, а не поставочный http/protobuf: сигналы одни и те же,
// а тело партии читается как текст, и приёмнику не нужен разбор protobuf.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем Коллектор;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");

	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	Хаб = Новый ЭкземплярХаба();
	Хаб.ФайловаяБаза("openhub-отел-сигналы");
	Хаб.Среда("OTEL_ENABLED", "true");
	Хаб.Среда("OTEL_SERVICE_NAME", "openhub-сигналы-тест");
	Хаб.Среда("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Хаб.Среда("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	// Партия спанов и срез метрик — по расписанию. Ждать штатных 5 и 60 секунд тесту
	// незачем: интервалы это настройки, и они же ускоряются.
	Хаб.Среда("OTEL_BSP_SCHEDULE_DELAY", "1000");
	Хаб.Среда("OTEL_METRIC_EXPORT_INTERVAL", "2000");
	// Строку журнала с идентификатором трассы пишет тот, кто работает ВНУТРИ спана.
	// На горячем пути запроса хаб молчит, а фоновые задачи идут под спанами и на уровне
	// отладки отчитываются о себе: частый обход здоровья источников такие строки и даёт.
	Хаб.Среда("OSHUB_LOG_LEVEL", "DEBUG");
	Хаб.Среда("OSHUB_JOBS_TICK__INTERVAL__MS", "500");
	Хаб.Среда("OSHUB_JOBS_UPSTREAM__HEALTH__INTERVAL__SEC", "2");
	// Ключей otel.entity.* здесь НЕТ намеренно. Оператор включает телеметрию ОДНОЙ
	// настройкой (ИСТ-ЭКСП-008), а сигналы базы наследуют её. Задай их тест явно —
	// и сломанное наследование он бы не заметил: спаны пришли бы от подсказки теста.

	// Пустой реестр дал бы приборам нули, и сверка с эндпоинтом стала бы сверкой нуля
	// с нулём: сеем пулы и пакеты.
	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьХаб.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;

КонецПроцедуры

// Журнал хаба уезжает OTLP-логами. До этого моста строки жили только в консоли
// инсталляции, и коллектор о них не знал ничего.
&Тест
Процедура ЖурналХабаУезжаетOTLPЛогами() Экспорт

	// Ждём сразу нужную строку, а не любую партию: дождавшись первой и утверждая про
	// конкретную, тест краснел бы через раз — партии уходят по расписанию.
	Тело = Коллектор.ДождатьсяПартии("logs", "Стартовые задачи завершены");

	Ожидаем.Что(СтрНайти(Тело, "resourceLogs") > 0, "это OTLP-тело логов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "openhub-сигналы-тест") > 0,
		"в партии логов имя службы этой инсталляции").ЭтоИстина();

КонецПроцедуры

// Ради этого мост и заводился: по идентификатору трассы, общему у спана и у строки
// журнала, в Grafana собирается дрилдаун «трасса ↔ логи». Идентификатор берётся
// из живой партии логов и обязан найтись в живой партии трасс.
&Тест
Процедура СтрокаЖурналаСшиваетсяСоСвоейТрассой() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	ИдТрассы = ДождатьсяСшитойСтроки(90);
	Ожидаем.Что(ЗначениеЗаполнено(ИдТрассы),
		"в уехавших логах нашлась строка с непустым traceId").ЭтоИстина();

	Трассы = Коллектор.ДождатьсяПартии("traces", ИдТрассы);
	Ожидаем.Что(СтрНайти(Трассы, ИдТрассы) > 0,
		СтрШаблон("трасса %1 из строки журнала нашлась среди уехавших спанов", ИдТрассы)).ЭтоИстина();

КонецПроцедуры

// Фоновая задача — единственная работа хаба, у которой нет своего запроса: серверный спан
// ей не от кого унаследовать, и заводит его аннотация на Исполнить(). Имя сверяется
// буквально: по нему сшиты панели наблюдаемости и разбор «трасса ↔ логи».
&Тест
Процедура ФоноваяЗадачаИдётПодСвоимСпаном() Экспорт

	Партия = Коллектор.ДождатьсяПартии("traces", ИмяСпанаЗдоровьяИсточников());
	Спаны = СпаныПартий(Партия);

	// Сверяется ИМЯ разобранного спана, а не подстрока в теле партии: подстрока нашлась бы
	// и в атрибуте, и в чужом спане, и тем же ожиданием партии, которое её и искало.
	Ожидаем.Что(СпанСИменем(Спаны, ИмяСпанаЗдоровьяИсточников()),
		СтрШаблон("среди уехавших спанов есть спан фоновой задачи ""%1""",
			ИмяСпанаЗдоровьяИсточников())).Заполнено();

КонецПроцедуры

// Шина доменных событий — вторая точка, ради которой телеметрию и включают: по спану
// публикации видно, что запрос не просто ответил, а ещё и дёрнул подписчиков. Скачивание
// артефакта публикует «скачивание.зафиксировано», и тип события обязан лежать атрибутом:
// без него спаны всех публикаций в трассе неразличимы.
&Тест
Процедура ПубликацияСобытияИдётПодСвоимСпаномСТипом() Экспорт

	Ожидаем.Что(ОтветНаФайлПакета().КодСостояния, "артефакт отдан — событие опубликовано").Равно(200);

	Партия = Коллектор.ДождатьсяПартии("traces", ИмяСпанаПубликацииСобытия());
	Спаны = СпаныПартий(Партия);

	Ожидаем.Что(СпанСАтрибутом(Спаны, "oshub.event.type", ТипСобытияСкачивания()),
		СтрШаблон("спан ""%1"" несёт тип события атрибутом", ИмяСпанаПубликацииСобытия())).Заполнено();

КонецПроцедуры

// Под включённой телеметрией обработчик доставки приезжает потребителю СГЕНЕРИРОВАННЫМ
// декоратором, а реестр действий подписок спрашивает у него методы рефлексией
// (РеестрДействийПодписок.СобратьВозможности). Потеряйся в зеркале декоратора метод
// «Проба» — и кнопка пробы в форме подписки пропала бы молча, вместе с признаком
// testable в справочнике API. Сверяется значение признака, а не текст ответа.
&Тест
Процедура ПробаВебхукаОстаётсяДоступнойПодДекоратором() Экспорт

	Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос("/api/v1/webhook-meta"));
	Ожидаем.Что(Ответ.КодСостояния, "справочник подписок отвечает").Равно(200);

	Вид = ВидДействияСправочника(Ответ.ПолучитьТелоКакСтроку(), ВидДействияВебхук());
	Ожидаем.Что(Вид, СтрШаблон("в справочнике есть вид действия «%1»", ВидДействияВебхук())).Заполнено();
	Ожидаем.Что(Вид["testable"], "проба вебхука доступна под декоратором").ЭтоИстина();

КонецПроцедуры

// Метрики точек маршрута — штатная работа winow и autumn-opentelemetry, но уезжают
// они только если провайдер метрик собран и читатель запущен. Проверяется на живом
// срезе: имя прибора выведено из имени желудя и метода, транслитерацией.
&Тест
Процедура МетрикиТочекМаршрутаУезжаютOTLP() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	Тело = Коллектор.ДождатьсяПартии("metrics", "kontroller_zdorovya.zdorove.duration");

	Ожидаем.Что(СтрНайти(Тело, "kontroller_zdorovya.zdorove.counted") > 0,
		"вместе с длительностью уехал и счётчик вызовов точки маршрута").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "openhub-сигналы-тест") > 0,
		"в партии метрик имя службы этой инсталляции").ЭтоИстина();

КонецПроцедуры

// Доменные приборы хаба: те же числа, что отдаёт /api/v1/metrics, снимаются метрикой
// по расписанию. Наблюдаемый датчик спрашивает значение сам — на горячем пути их нет.
&Тест
Процедура ЧислаРеестраУезжаютПриборамиХаба() Экспорт

	Тело = Коллектор.ДождатьсяПартии("metrics", "oshub.pools");

	Ожидаем.Что(СтрНайти(Тело, "oshub.packages") > 0,
		"вместе с пулами уехали и пакеты").ЭтоИстина();

	// Сверка со снимком эндпоинта: приборы обязаны считать то же самое, иначе график
	// и API рассказывали бы о хабе разное.
	ПулыПрибора = ЗначениеИзПрибора(Тело, "oshub.pools");
	Ожидаем.Что(ПулыПрибора > 0, "значение прибора прочиталось и оно не пустое").ЭтоИстина();
	Ожидаем.Что(ПулыПрибора,
		"публичных пулов у прибора столько же, сколько у /api/v1/metrics").Равно(
			ЧислоИзМетрикAPI("pools_total"));

КонецПроцедуры

// Работу с базой инструментируют библиотеки, без единой строки кода хаба: наблюдатель
// источника данных превращает операции менеджера сущностей и запросы коннектора в спаны
// и гистограммы. Проверяется на живом срезе: спан, который никуда не уехал, оператору
// не достался.
&Тест
Процедура ОбращенияКБазеУезжаютМетрикамиИСпанами() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	Тело = Коллектор.ДождатьсяПартии("metrics", "db.client.operation.duration");
	Ожидаем.Что(СтрНайти(Тело, "entity.operation.duration") > 0,
		"рядом с длительностью запроса уехала длительность операции менеджера").ЭтоИстина();

	Трассы = Коллектор.ДождатьсяПартии("traces", "entity.type");
	Ожидаем.Что(СтрНайти(Трассы, "db.system.name") > 0,
		"в трассах есть и спан запроса к СУБД, а не только спан операции").ЭтоИстина();

КонецПроцедуры

// Вызовы хранилищ сущностей меряет второй механизм — напильник слоя хранилищ, со своей
// ручкой otel.entity.repository.enabled. Без него в трассе видно, ЧТО хаб спросил
// у базы, но не видно, сколько стоил вызов самого хранилища.
&Тест
Процедура ВызовыХранилищМеряютсяГистограммой() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	Тело = Коллектор.ДождатьсяПартии("metrics", "entity.repository.invocation.duration");
	Ожидаем.Что(СтрНайти(Тело, "entity.repository") > 0,
		"гистограмма вызовов помечена именем хранилища").ЭтоИстина();

КонецПроцедуры

// Трасса запроса обязана быть связной сверху донизу: спан маршрута winow, спан службы,
// спан операции менеджера сущностей и спан запроса к СУБД — звенья одной цепи родителей,
// а не четыре спана, случайно оказавшиеся в одной партии. Сшивает их parentSpanId,
// и только он делает трассу читаемой: по ней видно, какой запрос чьей работой вызван.
&Тест
Процедура ТрассаЗапросаСшитаОтМаршрутаЧерезСлужбуДоБазы() Экспорт

	Ожидаем.Что(ОтветНаФайлПакета().КодСостояния, "файл пакета выдан").Равно(200);

	Цепочка = ДождатьсяЦепочкиВыдачи(90);
	Имена = ИменаЦепочки(Цепочка);

	ЗапросКСУБД = 0;
	ОперацияEntity = ИндексПоАтрибуту(Цепочка, "entity.type");
	СпанСлужбыПулов = ИндексПоИмени(Цепочка, ИмяСпанаПоискаПула());
	СпанРезолвера = ИндексПоИмени(Цепочка, ИмяСпанаРезолва());
	СпанМаршрута = ИндексПоАтрибуту(Цепочка, "http.route");

	Ожидаем.Что(ОперацияEntity > ЗапросКСУБД,
		СтрШаблон("над запросом к СУБД стоит спан операции entity; цепочка: %1", Имена)).ЭтоИстина();
	Ожидаем.Что(СпанСлужбыПулов > ОперацияEntity,
		СтрШаблон("над операцией entity стоит спан службы пулов; цепочка: %1", Имена)).ЭтоИстина();
	Ожидаем.Что(СпанРезолвера > СпанСлужбыПулов,
		СтрШаблон("над службой пулов стоит спан резолвера выдачи; цепочка: %1", Имена)).ЭтоИстина();
	Ожидаем.Что(СпанМаршрута > СпанРезолвера,
		СтрШаблон("над резолвером выдачи стоит серверный спан маршрута; цепочка: %1", Имена)).ЭтоИстина();

	Ожидаем.Что(Цепочка[СпанСлужбыПулов].Атрибуты["oshub.pool"],
		"спан службы назвал пул, в котором искал").Равно(ИмяПулаСида());
	Ожидаем.Что(Цепочка[СпанРезолвера].Атрибуты["oshub.package"],
		"спан резолва назвал пакет, который выдавал").Равно(ИмяПакетаСида());

КонецПроцедуры

// Контекст трассировки принадлежит запросу, а не процессу: конвейер winow идёт прямо
// в потоке Kestrel, и стек контекстов у каждого запроса свой. Перемешайся стеки — спан
// службы одного запроса уехал бы в трассу соседнего, и оператор читал бы в трассе чужую
// работу.
//
// Видно это ТОЛЬКО на перекрытии: разойдись запросы во времени, и всё, что ниже, было бы
// верно и на общем стеке. Поэтому первое утверждение — про саму волну: серверные спаны
// всех запросов обязаны иметь общий отрезок жизни, и меряется он их же границами.
//
// У каждого запроса свой traceparent и своё имя пакета: имя несуществующее намеренно —
// атрибутом спана оно ставится ещё до того, как выяснится, что пакета нет, и делает
// спан службы узнаваемым.
&Тест
Процедура ПараллельныеЗапросыВедутКаждыйСвоюТрассу() Экспорт

	Волна = ВолнаПроб();
	СпроситьВолнойПараллельно(Волна);

	Спаны = ДождатьсяСпановВолны(Волна, 90);
	Маршруты = СерверныеСпаныВолны(Спаны, Волна);

	ПозднийСтарт = Крайний(Маршруты, "Начало", Истина);
	РаннийКонец = Крайний(Маршруты, "Конец", Ложь);
	Ожидаем.Что(ПозднийСтарт < РаннийКонец,
		СтрШаблон("все %1 запросов волны были в обработке одновременно; общий отрезок %2 мс",
			Волна.Количество(), Миллисекунды(РаннийКонец - ПозднийСтарт))).ЭтоИстина();

	Для Индекс = 0 По Волна.ВГраница() Цикл
		Проба = Волна[Индекс];

		СпанСлужбы = СпанПробы(Спаны, Проба);
		Ожидаем.Что(СпанСлужбы.Трасса,
			СтрШаблон("спан службы пакетов для %1 остался в трассе своего запроса", Проба.Пакет))
			.Равно(Проба.Трасса);

		Ожидаем.Что(Маршруты[Индекс].Атрибуты["url.path"],
			СтрШаблон("над спаном службы для %1 стоит серверный спан его же запроса", Проба.Пакет))
			.Равно(АдресПробы(Проба.Пакет));
	КонецЦикла;

КонецПроцедуры

// Под включённой телеметрией каждый желудь службы приезжает к потребителю декоратором:
// аннотация на конструкторе подменяет объект сгенерированным типом. Остальные наборы
// гоняют хаб с выключенной телеметрией и подмены не видят вовсе, поэтому страховка,
// что декоратор не сломал ни одного желудя, живёт здесь — на живых путях хаба.
&Тест
Процедура ОсновныеПутиХабаЖивутПодДекораторами() Экспорт

	Для Каждого Путь Из ПутиПодДекораторами() Цикл
		Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос(Путь.Адрес));
		Ожидаем.Что(Ответ.КодСостояния,
			СтрШаблон("%1 отвечает под декораторами", Путь.Название)).Равно(200);
		Ожидаем.Что(СтрНайти(Ответ.ПолучитьТелоКакСтроку(), Путь.Примета) > 0,
			СтрШаблон("%1 отдал своё содержимое, а не пустой ответ", Путь.Название)).ЭтоИстина();
	КонецЦикла;

	Артефакт = ОтветНаФайлПакета();
	Ожидаем.Что(Артефакт.КодСостояния, "выдача файла пакета отвечает").Равно(200);
	Ожидаем.Что(Артефакт.ПолучитьТелоКакДвоичныеДанные().Размер() > 0,
		"выдача файла пакета отдала непустой артефакт").ЭтоИстина();

КонецПроцедуры

// Один вызов — один спан. Спан, вложенный НЕПОСРЕДСТВЕННО в спан того же имени, оператор
// читает как «метод позвал сам себя», а настоящую длительность вызова прячет вложение.
// Сверяется отношение «родитель — потомок» на разобранных спанах: имя родителя берётся
// по parentSpanId, а не ищется в тексте партии.
&Тест
Процедура НиОдинСпанНеВложенВОдноимённыйСпан() Экспорт

	Ожидаем.Что(ДождатьсяЦепочкиВыдачи(90).Количество() > 0,
		"цепочка выдачи уехала — спанов накопилось достаточно").ЭтоИстина();

	Спаны = СпаныПартий(Коллектор.Принятое("traces"));
	Ожидаем.Что(Спаны.Количество() > 0, "уехавшие спаны разобраны").ЭтоИстина();

	Ожидаем.Что(ВложениеВОдноимённого(Спаны),
		"ни один спан не вложен в спан того же имени").Равно("");

КонецПроцедуры

// Приметы реестра в трассе: спан службы обязан называть, ЧЕМ он занимался, иначе трасса
// выдачи состоит из одинаковых «нашёл версию» без единого имени и номера. Проверяется
// значение атрибута на разобранном спане, а не подстрока в теле партии.
&Тест
Процедура СпанПоискаВерсииНазываетВерсиюВыдачи() Экспорт

	Ожидаем.Что(ОтветНаФайлПакета().КодСостояния, "файл пакета выдан").Равно(200);

	Спан = ДождатьсяСпанаПоискаВерсии(90);
	Ожидаем.Что(Спан.Атрибуты["oshub.version"],
		СтрШаблон("спан ""%1"" назвал версию, которую искал", ИмяСпанаПоискаВерсии()))
		.Равно(ВерсияПакетаСида());

КонецПроцедуры

// Поток логов обязан жить, а не выдохнуться первой партией. Соседний стенд видел ровно
// это: одна выгрузка через полторы минуты после старта — и тишина навсегда, при живом хабе
// и работающих запросах. Партии считаются по числу принятых POST, и наблюдение идёт
// последним в наборе: к этому времени хаб работает уже несколько минут.
&Тест
Процедура ПотокЛоговНеВыдыхаетсяПослеПервойПартии() Экспорт

	Было = Коллектор.ЧислоПартий("logs");

	// Хаб под нагрузкой всё время наблюдения: тишина не спишется на «нечего слать».
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 60 * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает всё время наблюдения").Равно(200);
		Если Коллектор.ЧислоПартий("logs") >= Было + ПартийДляЖивогоПотока() Тогда
			Прервать;
		КонецЕсли;
		Приостановить(1000);
	КонецЦикла;

	Стало = Коллектор.ЧислоПартий("logs");
	Ожидаем.Что(Стало >= Было + ПартийДляЖивогоПотока(),
		СтрШаблон("за минуту работы партий логов стало %1 против %2 — поток жив",
			Стало, Было)).ЭтоИстина();

КонецПроцедуры

// Обратная сторона всего набора: инсталляция с выключенной телеметрией коллектора
// не трогает вовсе. Мост журнала — вторая дверь к SDK, и подключён он всегда;
// закрыт он только флагом, и проверить это можно лишь тем, что по сети ничего не ушло.
&Тест
Процедура ВыключеннаяТелеметрияКоллекторуНичегоНеШлёт() Экспорт

	Молчун = Новый ЭкземплярХаба();
	Молчун.ФайловаяБаза("openhub-отел-молчун");
	Молчун.Среда("OTEL_ENABLED", "false");
	Молчун.Среда("OTEL_SERVICE_NAME", ИмяМолчуна());
	Молчун.Среда("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Молчун.Среда("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	Молчун.Среда("OSHUB_LOG_LEVEL", "DEBUG");

	Попытка
		Молчун.Запустить();

		Для Счёт = 1 По 5 Цикл
			Запрос = Новый HTTPЗапрос("/health");
			Ожидаем.Что(Молчун.Соединение().Получить(Запрос).КодСостояния,
				"хаб без телеметрии обслуживает запросы").Равно(200);
		КонецЦикла;

		// Заведомо дольше партии логов (1 с) и среза метрик (2 с) соседнего хаба.
		Приостановить(10000);

		Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
			Ожидаем.Что(СтрНайти(Коллектор.Принятое(Сигнал), ИмяМолчуна()),
				СтрШаблон("выключенная телеметрия не прислала сигнал %1", Сигнал)).Равно(0);
		КонецЦикла;
	Исключение
		Молчун.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Молчун.Остановить();

КонецПроцедуры

#Область Служебное

Функция ИмяМолчуна()
	Возврат "openhub-выключенная-телеметрия";
КонецФункции

// Пул, пакет и версия засева: страницы, API и выдача спрашиваются об одном и том же.
Функция ИмяПулаСида()
	Возврат "main";
КонецФункции

Функция ИмяПакетаСида()
	Возврат "winow";
КонецФункции

Функция ВерсияПакетаСида()
	Возврат "1.1.0";
КонецФункции

Функция ИмяСпанаПоискаПула()
	Возврат "СервисПулов.НайтиПул";
КонецФункции

Функция ИмяСпанаРезолва()
	Возврат "РезолверВыдачи.РазрешитьФайл";
КонецФункции

Функция ИмяСпанаПоискаВерсии()
	Возврат "СервисВерсий.НайтиВерсию";
КонецФункции

// Обход здоровья источников ходит чаще всех: интервал ему задаёт окружение набора.
Функция ИмяСпанаЗдоровьяИсточников()
	Возврат "job.upstream_health";
КонецФункции

Функция ИмяСпанаПубликацииСобытия()
	Возврат "events.publish";
КонецФункции

// Скачивание артефакта — единственное событие, которое живой набор порождает сам.
Функция ТипСобытияСкачивания()
	Возврат "скачивание.зафиксировано";
КонецФункции

Функция ВидДействияВебхук()
	Возврат "вебхук";
КонецФункции

// Описание вида действия из справочника GET /api/v1/webhook-meta; Неопределено — вида нет.
Функция ВидДействияСправочника(Знач Тело, Знач Вид)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Справочник = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Для Каждого Описание Из Справочник["kinds"] Цикл
		Если Описание["kind"] = Вид Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ОтветНаФайлПакета()

	Адрес = СтрШаблон("/api/v1/pools/%1/download/%2/%2-%3.ospx",
		ИмяПулаСида(), ИмяПакетаСида(), ВерсияПакетаСида());

	Возврат Хаб.Соединение().Получить(Новый HTTPЗапрос(Адрес));

КонецФункции

// Живые пути хаба: что спрашиваем, как называем в отказе и по какой примете узнаём,
// что ответ содержательный.
Функция ПутиПодДекораторами()

	Пул = ИмяПулаСида();
	Пакет = ИмяПакетаСида();

	Результат = Новый Массив();
	Результат.Добавить(Путь("главная", "/", "</html>"));
	Результат.Добавить(Путь("страница пула", "/" + Пул, "</html>"));
	Результат.Добавить(Путь("страница пакета", "/" + Пул + "/" + Пакет, "</html>"));
	Результат.Добавить(Путь("страница входа", "/login", "</html>"));
	Результат.Добавить(Путь("список пакетов пула",
		СтрШаблон("/api/v1/pools/%1/packages", Пул), Пакет));
	Результат.Добавить(Путь("список версий пакета",
		СтрШаблон("/api/v1/pools/%1/packages/%2/versions", Пул, Пакет), ВерсияПакетаСида()));

	Возврат Результат;

КонецФункции

Функция Путь(Знач Название, Знач Адрес, Знач Примета)
	Возврат Новый Структура("Название, Адрес, Примета", Название, Адрес, Примета);
КонецФункции

// Волна параллельных запросов: у каждого своё имя несуществующего пакета и свой
// идентификатор трассы, который хаб обязан взять из входящего traceparent.
Функция ВолнаПроб()

	Метка = Лев(БезДефисов(Новый УникальныйИдентификатор()), 8);

	Результат = Новый Массив();
	Для Номер = 1 По ЗапросовВВолне() Цикл
		Результат.Добавить(Новый Структура("Пакет, Трасса",
			СтрШаблон("proba-%1-%2", Метка, Номер), БезДефисов(Новый УникальныйИдентификатор())));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько запросов уходит в хаб одновременно.
Функция ЗапросовВВолне()
	Возврат 8;
КонецФункции

// Идентификатор трассы — 32 шестнадцатеричных знака, ровно столько даёт УИД без дефисов.
Функция БезДефисов(Знач Идентификатор)
	Возврат НРег(СтрЗаменить(Строка(Идентификатор), "-", ""));
КонецФункции

Функция АдресПробы(Знач ИмяПакета)
	Возврат СтрШаблон("/api/v1/pools/%1/packages/%2/versions", ИмяПулаСида(), ИмяПакета);
КонецФункции

Процедура СпроситьВолнойПараллельно(Знач Волна)

	Задания = Новый Массив();

	Для Каждого Проба Из Волна Цикл
		Параметры = Новый Массив();
		Параметры.Добавить(Проба.Пакет);
		Параметры.Добавить(Проба.Трасса);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СпроситьПробу", Параметры));
	КонецЦикла;

	ФоновыеЗадания.ОжидатьВсе(Задания);

КонецПроцедуры

// Точка входа фонового задания волны: один запрос под своим traceparent.
//
// Параметры:
//  ИмяПакета - Строка - имя несуществующего пакета, узнаваемое в спане службы.
//  ИдТрассы - Строка - идентификатор трассы этого запроса.
//
Процедура СпроситьПробу(Знач ИмяПакета, Знач ИдТрассы) Экспорт

	Запрос = Новый HTTPЗапрос(АдресПробы(ИмяПакета));
	Запрос.Заголовки.Вставить("traceparent",
		СтрШаблон("00-%1-%2-01", ИдТрассы, Лев(ИдТрассы, 16)));

	Хаб.Соединение().Получить(Запрос);

КонецПроцедуры

// Ждёт, пока уедут спаны всех проб волны вместе со своими серверными предками. Ждётся
// только ПРИСУТСТВИЕ: перемешанный контекст спан не теряет, а уводит в чужую трассу,
// и такой отказ обязан быть красным утверждением, а не молчанием до таймаута.
Функция ДождатьсяСпановВолны(Знач Волна, Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл
		Спаны = СпаныПартий(Коллектор.Принятое("traces"));
		Если ВолнаСобралась(Спаны, Волна) Тогда
			Возврат Спаны;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			ВызватьИсключение СтрШаблон(
				"За %1 с в уехавших трассах собрались спаны не всех %2 запросов волны",
				Секунд, Волна.Количество());
		КонецЕсли;
		Приостановить(1000);
	КонецЦикла;

КонецФункции

Функция ВолнаСобралась(Знач Спаны, Знач Волна)

	Для Каждого Проба Из Волна Цикл
		Спан = СпанСАтрибутом(Спаны, "oshub.package", Проба.Пакет);
		Если Спан = Неопределено
			ИЛИ ПредокСАтрибутом(Спаны, Спан, "http.route") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Серверные спаны волны в порядке проб: над спаном службы каждой пробы поднимаемся
// до её же серверного спана.
Функция СерверныеСпаныВолны(Знач Спаны, Знач Волна)

	Результат = Новый Массив();
	Для Каждого Проба Из Волна Цикл
		Результат.Добавить(СерверныйПредок(Спаны, СпанПробы(Спаны, Проба)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Самое позднее либо самое раннее значение поля по набору спанов.
Функция Крайний(Знач Спаны, Знач Поле, Знач Наибольшее)

	Результат = Спаны[0][Поле];

	Для Каждого Спан Из Спаны Цикл
		Если ?(Наибольшее, Спан[Поле] > Результат, Спан[Поле] < Результат) Тогда
			Результат = Спан[Поле];
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Миллисекунды(Знач Наносекунд)
	Возврат Окр(Наносекунд / 1000000, 1);
КонецФункции

Функция СпанПробы(Знач Спаны, Знач Проба)

	Спан = СпанСАтрибутом(Спаны, "oshub.package", Проба.Пакет);
	Ожидаем.Что(Спан, СтрШаблон("спан службы пакетов для %1 уехал", Проба.Пакет)).Заполнено();

	Возврат Спан;

КонецФункции

Функция СерверныйПредок(Знач Спаны, Знач Спан)

	Предок = ПредокСАтрибутом(Спаны, Спан, "http.route");
	Ожидаем.Что(Предок, СтрШаблон("у спана %1 есть серверный предок", Спан.Имя)).Заполнено();

	Возврат Предок;

КонецФункции

// Спан партии по ИМЕНИ; Неопределено — такого спана среди уехавших нет.
Функция СпанСИменем(Знач Спаны, Знач Имя)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Имя = Имя Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция СпанСАтрибутом(Знач Спаны, Знач Ключ, Знач Значение)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Атрибуты[Ключ] = Значение Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ближайший предок спана, несущий указанный атрибут: подъём идёт по ссылкам на родителя.
Функция ПредокСАтрибутом(Знач Спаны, Знач Спан, Знач Ключ)

	Цепочка = ЦепочкаККорню(Спаны, Спан);
	Индекс = ИндексПоАтрибуту(Цепочка, Ключ);

	Возврат ?(Индекс < 0, Неопределено, Цепочка[Индекс]);

КонецФункции

// Первое найденное вложение спана в спан того же имени; "" — такого в партиях нет.
// Родитель ищется по ссылке: спан, чей родитель ещё не уехал, вложением не считается.
Функция ВложениеВОдноимённого(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл
		Родитель = Спаны[Пара.Значение.Родитель];
		Если Родитель <> Неопределено И Родитель.Имя = Пара.Значение.Имя Тогда
			Возврат СтрШаблон("%1 (спан %2 вложен в спан %3)",
				Пара.Значение.Имя, Пара.Ключ, Пара.Значение.Родитель);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Ждёт спан поиска версии, поднятый выдачей артефакта. Тот же спан бывает и на других
// путях хаба, поэтому берётся именно тот, над которым в цепочке родителей стоит резолвер
// выдачи, — иначе утверждение о версии спрашивалось бы с чужого вызова.
Функция ДождатьсяСпанаПоискаВерсии(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл
		Спан = СпанПоискаВерсииПодВыдачей(СпаныПартий(Коллектор.Принятое("traces")));
		Если Спан <> Неопределено Тогда
			Возврат Спан;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			ВызватьИсключение СтрШаблон(
				"За %1 с в уехавших трассах не нашёлся спан ""%2"" под ""%3""",
				Секунд, ИмяСпанаПоискаВерсии(), ИмяСпанаРезолва());
		КонецЕсли;
		ОтветНаФайлПакета();
		Приостановить(1000);
	КонецЦикла;

КонецФункции

Функция СпанПоискаВерсииПодВыдачей(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Имя <> ИмяСпанаПоискаВерсии() Тогда
			Продолжить;
		КонецЕсли;
		Если ИндексПоИмени(ЦепочкаККорню(Спаны, Пара.Значение), ИмяСпанаРезолва()) >= 0 Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ждёт, пока в уехавших трассах соберётся цепочка выдачи целиком. Спан родителя уезжает
// позже своих детей — он завершается последним, — поэтому одной партии мало: читается
// всё принятое, пока цепочка не сойдётся.
Функция ДождатьсяЦепочкиВыдачи(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл
		Цепочка = ЦепочкаВыдачи(СпаныПартий(Коллектор.Принятое("traces")));
		Если Цепочка.Количество() > 0 Тогда
			Возврат Цепочка;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			ВызватьИсключение СтрШаблон(
				"За %1 с в уехавших трассах не собралась цепочка от запроса к СУБД"
				+ " через %2 до %3", Секунд, ИмяСпанаПоискаПула(), ИмяСпанаРезолва());
		КонецЕсли;
		ОтветНаФайлПакета();
		Приостановить(1000);
	КонецЦикла;

КонецФункции

// Цепочка родителей от запроса к СУБД до корня трассы — та, в которой поиск пула поднят
// резолвером выдачи. Запросов к СУБД в трассе много, нужен именно этот.
Функция ЦепочкаВыдачи(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Атрибуты["db.system.name"] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Цепочка = ЦепочкаККорню(Спаны, Пара.Значение);
		Если ИндексПоИмени(Цепочка, ИмяСпанаПоискаПула()) >= 0
			И ИндексПоИмени(Цепочка, ИмяСпанаРезолва()) >= 0 Тогда
			Возврат Цепочка;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Массив();

КонецФункции

// Спан и все его родители, от него самого к корню трассы. Обрыв ссылки останавливает
// подъём: партия с родителем могла ещё не уехать.
Функция ЦепочкаККорню(Знач Спаны, Знач Спан)

	Цепочка = Новый Массив();
	Текущий = Спан;

	Пока Текущий <> Неопределено И Цепочка.Количество() < 32 Цикл
		Цепочка.Добавить(Текущий);
		Текущий = Спаны[Текущий.Родитель];
	КонецЦикла;

	Возврат Цепочка;

КонецФункции

// Все уехавшие спаны по их идентификаторам. Партии дописываются в файл одна за другой,
// поэтому текст делится по началу документа OTLP, а недописанный хвост отбрасывается.
Функция СпаныПартий(Знач Тело)

	Спаны = Новый Соответствие();

	Для Каждого Документ Из ДокументыПартий(Тело) Цикл
		Для Каждого РесурсныеСпаны Из Документ["resourceSpans"] Цикл
			Для Каждого ОбластныеСпаны Из РесурсныеСпаны["scopeSpans"] Цикл
				Для Каждого Спан Из ОбластныеСпаны["spans"] Цикл
					Спаны.Вставить(Спан["spanId"], ОписаниеСпана(Спан));
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Спаны;

КонецФункции

Функция ДокументыПартий(Знач Тело)

	// СтрРазделить режет по КАЖДОМУ символу разделителя, поэтому начало документа сперва
	// помечается служебным символом, которого в JSON быть не может, и режется уже по нему.
	Маркер = "{" + Символы.ПС + """resourceSpans""";
	Метка = Символ(1);
	Размеченное = СтрЗаменить(Тело, Маркер, Метка + Маркер);

	Результат = Новый Массив();

	Для Каждого Кусок Из СтрРазделить(Размеченное, Метка, Ложь) Цикл
		Попытка
			Чтение = Новый ЧтениеJSON();
			Чтение.УстановитьСтроку(Кусок);
			Результат.Добавить(ПрочитатьJSON(Чтение));
			Чтение.Закрыть();
		Исключение
			// голова файла до первой партии и недописанный хвост последней
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Спан OTLP/JSON в том виде, в каком его читает тест: имя, трасса, ссылка на родителя,
// границы в наносекундах и атрибуты значениями. В OTLP значение атрибута завёрнуто
// в объект вида {"stringValue": "main"}.
Функция ОписаниеСпана(Знач Спан)

	Атрибуты = Новый Соответствие();
	Для Каждого Атрибут Из Спан["attributes"] Цикл
		Для Каждого Обёртка Из Атрибут["value"] Цикл
			Атрибуты.Вставить(Атрибут["key"], Обёртка.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Имя, Трасса, Родитель, Начало, Конец, Атрибуты",
		Спан["name"], Спан["traceId"], Спан["parentSpanId"],
		МоментНаносекунд(Спан["startTimeUnixNano"]), МоментНаносекунд(Спан["endTimeUnixNano"]),
		Атрибуты);

КонецФункции

// Момент спана в наносекундах. 64-битные числа OTLP/JSON кодирует десятичной строкой,
// но экспортёр вправе отдать и число — принимаются обе формы. Через Строка() число
// прогонять нельзя: она вставляет разделители групп, и Число() потом падает.
Функция МоментНаносекунд(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Значение), Число(Значение), 0);

КонецФункции

// Место спана в цепочке; -1 — такого спана в ней нет.
Функция ИндексПоИмени(Знач Цепочка, Знач Имя)

	Для Индекс = 0 По Цепочка.ВГраница() Цикл
		Если Цепочка[Индекс].Имя = Имя Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

Функция ИндексПоАтрибуту(Знач Цепочка, Знач Ключ)

	Для Индекс = 0 По Цепочка.ВГраница() Цикл
		Если Цепочка[Индекс].Атрибуты[Ключ] <> Неопределено Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

// Цепочка одной строкой для сообщения отказа: от запроса к СУБД к корню трассы.
Функция ИменаЦепочки(Знач Цепочка)

	Имена = Новый Массив();
	Для Каждого Спан Из Цепочка Цикл
		Имена.Добавить(Спан.Имя);
	КонецЦикла;

	Возврат СтрСоединить(Имена, " ← ");

КонецФункции

// Сколько партий сверх уже принятых считаем доказательством живого потока. Партия
// уезжает раз в otel.bsp.schedule.delay (в этом наборе — секунда), так что за минуту
// наблюдения их набегает заметно больше; порог взят с большим запасом на медленную машину.
Функция ПартийДляЖивогоПотока()
	Возврат 5;
КонецФункции

Функция ОтветНаЗдоровье()
	Возврат Хаб.Соединение().Получить(Новый HTTPЗапрос("/health"));
КонецФункции

// Ждёт первую строку журнала, у которой traceId непустой. Большинство строк хаба пишутся
// вне всякого спана, и поле у них пустое — годится только строка изнутри операции.
Функция ДождатьсяСшитойСтроки(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		ИдТрассы = ПервыйИдТрассы(Коллектор.Принятое("logs"));
		Если ЗначениеЗаполнено(ИдТрассы) Тогда
			Возврат ИдТрассы;
		КонецЕсли;
		ОтветНаЗдоровье();
		Приостановить(1000);
	КонецЦикла;

	Возврат "";

КонецФункции

// Число из ответа /api/v1/metrics — источник правды для сверки с прибором.
Функция ЧислоИзМетрикAPI(Знач Ключ)

	Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос("/api/v1/metrics"));
	Ожидаем.Что(Ответ.КодСостояния, "эндпоинт метрик отвечает").Равно(200);

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Данные[Ключ];

КонецФункции

// Значение прибора из принятого коллектором, числом. Читается разбором, а не поиском
// числа за именем: первое число после имени принадлежит СОСЕДУ по партии не реже, чем
// самому прибору, — числа датчиков уезжают полем asDouble, а поехавший рядом целый
// счётчик подставлял под «пулы» своё asInt. -1 — прибора в партиях нет либо точек нет.
//
// Берётся ПОСЛЕДНИЙ срез: в принятом лежат все партии с начала прогона, а самый ранний
// срез снят на непрогретом хабе и о реестре рассказывает не то же, что эндпоинт сейчас.
Функция ЗначениеИзПрибора(Знач Тело, Знач ИмяПрибора)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);

	Найденное = -1;
	Пока Истина Цикл
		Партия = ОчереднаяПартия(Чтение);
		Если Партия = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Снятое = ЗначениеПрибораВПартии(Партия, ИмяПрибора);
		Если Снятое <> Неопределено Тогда
			Найденное = Снятое;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Найденное;

КонецФункции

// Очередная партия потока; Неопределено — партии кончились. Принятое коллектором это
// все партии подряд, одна за другой, и конец потока разбор сообщает исключением.
Функция ОчереднаяПартия(Знач Чтение)

	Попытка
		Возврат ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Число прибора в одной партии; Неопределено — прибора в ней нет.
Функция ЗначениеПрибораВПартии(Знач Партия, Знач ИмяПрибора)

	Для Каждого Ресурс Из Список(Партия, "resourceMetrics") Цикл
		Для Каждого Область Из Список(Ресурс, "scopeMetrics") Цикл
			Для Каждого Прибор Из Список(Область, "metrics") Цикл
				Если Прибор.Получить("name") = ИмяПрибора Тогда
					Возврат ЧислоТочкиДанных(Прибор);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Значение единственной точки данных прибора: экспортёр пишет его то строкой
// ("asInt": "3"), то числом ("asDouble": 3). Дробная часть отбрасывается — числа
// реестра целые по смыслу. -1 — точки данных нет.
Функция ЧислоТочкиДанных(Знач Прибор)

	Точки = ТочкиДанных(Прибор);
	Если Точки = Неопределено ИЛИ Точки.Количество() = 0 Тогда
		Возврат -1;
	КонецЕсли;

	Значение = Точки[0].Получить("asInt");
	Если Значение = Неопределено Тогда
		Значение = Точки[0].Получить("asDouble");
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат -1;
	КонецЕсли;

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Цел(Значение), Цел(Число(Значение)));

КонецФункции

// Точки данных лежат внутри агрегации, а вид её у датчика, счётчика и гистограммы свой.
Функция ТочкиДанных(Знач Прибор)

	Для Каждого Вид Из ВидыАгрегации() Цикл
		Агрегация = Прибор.Получить(Вид);
		Если Агрегация <> Неопределено Тогда
			Возврат Агрегация.Получить("dataPoints");
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ВидыАгрегации()
	Возврат СтрРазделить("gauge,sum,histogram", ",");
КонецФункции

// Массив по ключу разобранной партии; пустой массив — ключа нет.
Функция Список(Знач Поля, Знач Ключ)
	Значение = Поля.Получить(Ключ);
	Возврат ?(Значение = Неопределено, Новый Массив(), Значение);
КонецФункции

// Первый непустой traceId из партии логов OTLP/JSON.
Функция ПервыйИдТрассы(Знач Тело)

	Позиция = 1;
	Пока Истина Цикл
		Найдено = СтрНайти(Тело, """traceId"":", Направление(), Позиция);
		Если Найдено = 0 Тогда
			Возврат "";
		КонецЕсли;
		Значение = ЗначениеЗаКлючом(Сред(Тело, Найдено));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

Функция Направление()
	Возврат НаправлениеПоиска.СНачала;
КонецФункции

// Строковое значение первого ключа в куске OTLP/JSON: "ключ": "значение".
Функция ЗначениеЗаКлючом(Знач Кусок)

	Двоеточие = СтрНайти(Кусок, ":");
	Если Двоеточие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Кусок, Двоеточие + 1);
	Открывающая = СтрНайти(Хвост, """");
	Если Открывающая = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Хвост, Открывающая + 1);
	Закрывающая = СтрНайти(Хвост, """");

	Возврат ?(Закрывающая = 0, "", Лев(Хвост, Закрывающая - 1));

КонецФункции

#КонецОбласти
