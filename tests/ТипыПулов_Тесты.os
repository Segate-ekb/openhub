// Типы пулов и разделение прав на пул: структурный запрет апстрима у пула `user`, разные права на жизненный цикл и
// администрирование пула, неудаляемый дефолтный пул, каскад приватности, общий сегмент логинов и имён пулов.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьКаталог(ОбъединитьПути(Модули, "данные", "Классы"));
	ПодключитьКаталог(ОбъединитьПути(Модули, "настройки", "Классы"));
	ПодключитьКаталог(ОбъединитьПути(Модули, "реестр", "Классы"));

	// events: core-registry содержит подписчиков доменных событий — без издателя рогатка-подписчик не создаётся
	ПодключитьКаталог(ОбъединитьПути(Модули, "события", "Классы"));

	// storage: каскад удаления пула уносит и файлы артефактов
	ПодключитьКаталог(ОбъединитьПути(Модули, "хранилище", "Классы"));

	// SSRF-гейт апстримов: СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО (fail-closed)
	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить();

	// прогон зеркала: у СервисПулов он спрашивается перед сносом пула — не наполняет ли
	// пул прямо сейчас синхронизация
	ПоискКлассов.Подключить(Модули, "ДроссельПрогресса");
	ПоискКлассов.Подключить(Модули, "СчётчикиОбхода");
	ПоискКлассов.Подключить(Модули, "СрезОбхода");
	ПоискКлассов.Подключить(Модули, "ЧислаЗеркалирования");
	ПоискКлассов.Подключить(Модули, "ПрогонЗеркала");

	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHub");
	// СлужбаДоступа спрашивает у гварда право задать квоту при создании пула
	ПоискКлассов.Подключить(Модули, "ГвардКвотыПула");
	ПоискКлассов.Подключить(Модули, "НормализаторУчётки");
	ПоискКлассов.Подключить(Модули, "ПолитикаПароля");
	// СервисПользователей пишет события безопасности учётки через летопись
	ПоискКлассов.Подключить(Модули, "ЛетописьУчёток");
	ПоискКлассов.Подключить(Модули, "АдресУчётки");
	ПоискКлассов.Подключить(Модули, "СервисПользователей");
	ПодключитьФайл(ОбъединитьПути(Модули, "кабинет", "Классы", "СлужбаДоступа.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкПроверяющийGitHub.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-типы-пулов-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "типы-пулов-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

#Область СтруктурныйЗапретАпстримовУЛичногоПула

// Главная гарантия шага: «в user-пуле апстрим задать нельзя» — СТРУКТУРНО. Проверяются все известные подходы: запись
// через сервис, от администратора пула, от админа хаба, обход сменой типа и строка, легшая в таблицу мимо сервиса.
&Тест
Процедура ВЛичномПулеАпстримЗадатьНельзя() Экспорт

	Пулы = Желудь("СервисПулов");
	Владелец = СоздатьПользователя();
	Личный = Пулы.СоздатьЛичныйПул(Владелец.Логин, Владелец.Идентификатор);

	Ожидаем.Что(Личный.Тип, "пул личного пространства").Равно("user");
	Ожидаем.Что(Личный.АпстримыДопустимы(), "тип запрещает апстримы").ЭтоЛожь();

	// 1) обычная запись
	Ожидаем.Что(ОшибкаДобавленияАпстрима(Личный.Идентификатор, "http://hub.oscript.io/download/"),
		"сервис отказывает").Содержит("личное пространство");

	// 2) администратор пула: право апстримов у него есть, но структурный запрет от прав не зависит
	ВыдатьРоль(Личный, "пользователь", Владелец.Идентификатор, "owner");
	Ожидаем.Что(Желудь("СервисПрав").МожетНастраиватьАпстримы(Владелец, Личный),
		"право настраивать апстримы у администратора пула ЕСТЬ").ЭтоИстина();
	Ожидаем.Что(ОшибкаЗаданияАпстримаЧерезСлужбу(Владелец, Личный.Идентификатор),
		"но операция всё равно отклонена").Содержит("личное пространство");

	// 3) админ хаба (суперправо) — тоже нет
	Ожидаем.Что(ОшибкаЗаданияАпстримаЧерезСлужбу(СоздатьПользователя("admin"), Личный.Идентификатор),
		"суперправо запрет не открывает").Содержит("личное пространство");

	// 4) обход сменой типа: пул с апстримом не становится личным
	Обычный = Пулы.СоздатьПул(Уникальное("team"), "custom");
	Пулы.ДобавитьАпстрим(Обычный.Идентификатор, "http://hub.oscript.io/download/", 900);
	Поймано = "";
	Попытка
		Пулы.УстановитьТип(Обычный.Идентификатор, "user");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "пул с апстримами не становится личным").Содержит("структурно");

	Ожидаем.Что(Пулы.АпстримыПула(Личный.Идентификатор).Количество(),
		"у личного пула апстримов не появилось").Равно(0);

КонецПроцедуры

// Вторая опора запрета: строка апстрима, легшая в таблицу МИМО сервиса, в выдачу не попадает — она спрашивает тип пула.
&Тест
Процедура ПросочившийсяАпстримЛичногоПулаНеОпрашивается() Экспорт

	Пулы = Желудь("СервисПулов");
	Владелец = СоздатьПользователя();
	Личный = Пулы.СоздатьЛичныйПул(Владелец.Логин, Владелец.Идентификатор);

	Апстрим = Желудь("ХранилищеАпстримовПула").СоздатьЭлемент();
	Апстрим.ПулИдентификатор = Личный.Идентификатор;
	Апстрим.Порядок = 0;
	Апстрим.Url = "http://hub.oscript.io/download/";
	Апстрим.ВремяЖизниСек = 900;
	Апстрим.СписокРазрешенийJSON = "";
	Апстрим.РазрешитьПриватные = Ложь;
	Апстрим.ПоследняяСинхронизация = ТекущаяУниверсальнаяДата();
	Апстрим.Сохранить();

	Ожидаем.Что(Пулы.АпстримыПула(Личный.Идентификатор).Количество(),
		"строка в таблице действительно есть").Равно(1);
	Ожидаем.Что(Пулы.АпстримыДляОпроса(Личный).Количество(),
		"но выдача её не опрашивает").Равно(0);

	// у обычного пула та же функция апстримы возвращает — проверка не «всегда пусто»
	Обычный = Пулы.СоздатьПул(Уникальное("norm"), "custom");
	Пулы.ДобавитьАпстрим(Обычный.Идентификатор, "http://hub.oscript.io/download/", 900);
	Ожидаем.Что(Пулы.АпстримыДляОпроса(Обычный).Количество(),
		"обычному пулу апстримы возвращаются").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область РазделениеПравНаПул

// Носитель роли администратора пула новый пул не создаёт: роль на пуле — про содержимое, а не про жизненный цикл.
&Тест
Процедура АдминистраторПулаНеСоздаётНовыйПул() Экспорт

	Права = Желудь("СервисПрав");
	Пулы = Желудь("СервисПулов");
	Админ = СоздатьПользователя();
	Пул = Пулы.СоздатьПул(Уникальное("owned"), "custom");

	ВыдатьРоль(Пул, "пользователь", Админ.Идентификатор, "owner");

	Ожидаем.Что(Права.МожетАдминистрировать(Админ, Пул), "он администратор своего пула").ЭтоИстина();
	Ожидаем.Что(Права.МожетСоздаватьПул(Админ), "но пулы заводить не может").ЭтоЛожь();

	Поймано = "";
	Попытка
		Желудь("СлужбаДоступа").СоздатьПул(Админ, Уникальное("new"), "custom", "public", 0);
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "создание пула отклонено").Содержит("создания пула");

КонецПроцедуры

// Удаление пула — право уровня «хаб»: owner-пресет даёт удаление НА ПУЛЕ, а не право распоряжаться составом пулов хаба.
&Тест
Процедура УдалениеПулаТребуетПраваУровняХаб() Экспорт

	Права = Желудь("СервисПрав");
	Пулы = Желудь("СервисПулов");
	Служба = Желудь("СлужбаДоступа");
	Доступ = Желудь("СервисПравДоступа");

	Админ = СоздатьПользователя();
	Пул = Пулы.СоздатьПул(Уникальное("victim"), "custom");
	ВыдатьРоль(Пул, "пользователь", Админ.Идентификатор, "owner");

	Ожидаем.Что(Права.МожетУдалятьПул(Админ), "хаб-удаления у администратора пула нет").ЭтоЛожь();

	Поймано = "";
	Попытка
		Служба.УдалитьПул(Админ, Пул.Идентификатор);
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "администратор пула не сносит пул").Содержит("удаления пула");
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Пул.Идентификатор) <> Неопределено, "пул на месте").ЭтоИстина();

	// а носитель хаб-удаления — сносит
	Хабовый = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Хабовый.Идентификатор, Права.ОбъектХаб(),
		Набор(Ложь, Ложь, Истина, Ложь), 0);
	Ожидаем.Что(Права.МожетУдалятьПул(Хабовый), "хаб-удаление выдано явно").ЭтоИстина();

	Служба.УдалитьПул(Хабовый, Пул.Идентификатор);
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Пул.Идентификатор), "пул удалён").Равно(Неопределено);

КонецПроцедуры

// Администратор пула ВПРАВЕ настраивать апстримы своего пула — иначе право «администрировать пул» ничего не значит.
&Тест
Процедура АдминистраторПулаПравитЕгоАпстримы() Экспорт

	Пулы = Желудь("СервисПулов");
	Служба = Желудь("СлужбаДоступа");
	Админ = СоздатьПользователя();
	Чужак = СоздатьПользователя();
	Пул = Пулы.СоздатьПул(Уникальное("mirror"), "custom");
	ВыдатьРоль(Пул, "пользователь", Админ.Идентификатор, "owner");

	Служба.ЗадатьАпстрим(Админ, Пул.Идентификатор, "http://hub.oscript.io/download/", 900);
	Ожидаем.Что(Пулы.АпстримыПула(Пул.Идентификатор).Количество(),
		"администратор пула завёл апстрим").Равно(1);

	// посторонний — нет
	Поймано = "";
	Попытка
		Служба.ЗадатьАпстрим(Чужак, Пул.Идентификатор, "http://evil.example/", 900);
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "посторонний апстрим не заводит").Содержит("Недостаточно прав");
	Ожидаем.Что(Пулы.АпстримыПула(Пул.Идентификатор).Количество(), "второго апстрима нет").Равно(1);

	// РАЙТЕР апстрим НЕ заводит (порог — мейнтейнер): раньше спрашивалось голое «изменение», и публикатор пула
	// управлял исходящими запросами хаба (поверхность SSRF)
	Райтер = СоздатьПользователя();
	ВыдатьРоль(Пул, "пользователь", Райтер.Идентификатор, "publisher");
	ПойманоРайтер = "";
	Попытка
		Служба.ЗадатьАпстрим(Райтер, Пул.Идентификатор, "http://writer.example/", 900);
	Исключение
		ПойманоРайтер = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ПойманоРайтер, "райтер апстрим не заводит").Содержит("Недостаточно прав");
	Ожидаем.Что(Пулы.АпстримыПула(Пул.Идентификатор).Количество(),
		"апстрим райтера не записан").Равно(1);

КонецПроцедуры

// Удаление пула уносило только строку пула и его апстримы: пакеты, версии, зависимости,
// теги, метки, подписи, происхождение, статистика, гранты, роли, ключи, зеркала, заявки
// и подписки оставались в базе навсегда — сиротами с идентификатором несуществующего пула.
&Тест
Процедура УдалениеПулаУноситВсёЕгоСодержимое() Экспорт

	Пулы = Желудь("СервисПулов");
	Пул = Пулы.СоздатьПул(Уникальное("cascade"), "custom");
	ПулИд = Пул.Идентификатор;
	Сосед = Пулы.СоздатьПул(Уникальное("neighbour"), "custom");

	НабитьПул(ПулИд);
	НабитьПул(Сосед.Идентификатор);

	Ожидаем.Что(СиротДляПула(ПулИд) > 0, "содержимое пула действительно заведено").ЭтоИстина();
	СоседскихДо = СиротДляПула(Сосед.Идентификатор);

	Пулы.УдалитьПул(ПулИд);

	Ожидаем.Что(Пулы.ПулПоИдентификатору(ПулИд), "пул удалён").Равно(Неопределено);
	Ожидаем.Что(СиротДляПула(ПулИд), "ни в одном хранилище не осталось строк снесённого пула").Равно(0);
	Ожидаем.Что(СиротДляПула(Сосед.Идентификатор),
		"соседний пул не задет").Равно(СоседскихДо);

	// повторное удаление идемпотентно на уровне ответа: пула больше нет
	Поймано = "";
	Попытка
		Пулы.УдалитьПул(ПулИд);
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "повторное удаление говорит, что пула нет").Содержит("не найден");
	Ожидаем.Что(СиротДляПула(ПулИд), "и ничего не воскрешает").Равно(0);

КонецПроцедуры

// Имя снесённого пула занимается заново, и новый пул НЕ наследует прав тёзки: гранты и роли
// висели на идентификаторе, а идентификатор у нового пула свой.
&Тест
Процедура НовыйПулПодСтарымИменемНеНаследуетПрав() Экспорт

	Пулы = Желудь("СервисПулов");
	Права = Желудь("СервисПрав");
	Имя = Уникальное("reborn");

	Прежний = Пулы.СоздатьПул(Имя, "custom");
	Держатель = СоздатьПользователя();
	ВыдатьРоль(Прежний, "пользователь", Держатель.Идентификатор, "owner");
	Ожидаем.Что(Права.МожетАдминистрировать(Держатель, Прежний),
		"на прежнем пуле права были").ЭтоИстина();

	Пулы.УдалитьПул(Прежний.Идентификатор);

	Новый_ = Пулы.СоздатьПул(Имя, "custom");
	Ожидаем.Что(Новый_ <> Неопределено, "имя занимается заново").ЭтоИстина();
	Ожидаем.Что(Права.МожетАдминистрировать(Держатель, Новый_),
		"новый пул прав тёзки не наследует").ЭтоЛожь();
	Ожидаем.Что(Желудь("ХранилищеУчастниковПула").ПолучитьПоПулИдентификаторРавно(
		Прежний.Идентификатор).Количество(), "роли снесённого пула не остались").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОсновнойПул

// Основной пул — адрес /download, по которому хаб обслуживает opm: запрет удаления ДОМЕННЫЙ, от прав не зависит.
&Тест
Процедура ОсновнойПулНеудаляемДажеАдминомХаба() Экспорт

	Пулы = Желудь("СервисПулов");
	Основной = ОбеспечитьОсновнойПул();

	Поймано = "";
	Попытка
		Пулы.УдалитьПул(Основной.Идентификатор);
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "доменный запрет удаления").Содержит("основной пул");

	// и через фасад с полным правом уровня «хаб» — тоже нет
	Права = Желудь("СервисПрав");
	Админ = СоздатьПользователя("admin");
	Ожидаем.Что(Права.МожетУдалятьПул(Админ), "у админа хаба право есть").ЭтоИстина();

	Поймано = "";
	Попытка
		Желудь("СлужбаДоступа").УдалитьПул(Админ, Основной.Идентификатор);
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "право не отменяет доменный инвариант").Содержит("основной пул");
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Основной.Идентификатор) <> Неопределено,
		"основной пул на месте").ЭтоИстина();

КонецПроцедуры

// Основной пул всегда публичен и единственен: приватный /download означал бы «хаб не работает без токена».
&Тест
Процедура ОсновнойПулВсегдаПубличенИЕдинственен() Экспорт

	Пулы = Желудь("СервисПулов");
	Основной = ОбеспечитьОсновнойПул();

	Поймано = "";
	Попытка
		Пулы.УстановитьВидимость(Основной.Идентификатор, "private");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "приватный основной запрещён").Содержит("всегда публичен");

	// признак носит РОВНО один пул: назначение переносит его, а не добавляет второй
	Второй = Пулы.СоздатьПул(Уникальное("plain"), "custom");
	Пулы.НазначитьПулПоУмолчанию(Второй.Идентификатор, "тест");

	Сколько = 0;
	Для Каждого Пул Из Пулы.ВсеПулы() Цикл
		Сколько = Сколько + ?(Пул.ЭтоДефолтный(), 1, 0);
	КонецЦикла;
	Ожидаем.Что(Сколько, "основной пул на хабе один").Равно(1);
	Ожидаем.Что(Пулы.ДефолтныйПул().Имя, "признак переехал на новый пул").Равно(Второй.Имя);
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Основной.Идентификатор).ЭтоДефолтный(),
		"с прежнего признак снят").ЭтоЛожь();

	// инварианты уехали вместе с признаком: прежний основной теперь можно закрыть и удалить
	Пулы.УстановитьВидимость(Основной.Идентификатор, "private");
	Пулы.УдалитьПул(Основной.Идентификатор);
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Основной.Идентификатор), "прежний основной удалён").Равно(Неопределено);

	// вернуть признак назад, чтобы соседние тесты набора видели прежний основной пул
	Пулы.НазначитьПулПоУмолчанию(Второй.Идентификатор, "тест");

КонецПроцедуры

// Личное пространство основным пулом хаба не становится: /download и /push принадлежат хабу.
&Тест
Процедура ЛичныйПулОсновнымНеНазначается() Экспорт

	Пулы = Желудь("СервисПулов");
	Юзер = СоздатьПользователя(Уникальное("owner"));
	Личный = Пулы.СоздатьЛичныйПул(Юзер.Логин, Юзер.Идентификатор);

	Поймано = "";
	Попытка
		Пулы.НазначитьПулПоУмолчанию(Личный.Идентификатор, "тест");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "личный пул основным не назначается").Содержит("личное пространство");
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Личный.Идентификатор).ЭтоДефолтный(),
		"признак не проставлен").ЭтоЛожь();

КонецПроцедуры

// Приватный пул основным не назначается: назначение не раскрывает его содержимое молча.
&Тест
Процедура ПриватныйПулОсновнымНеНазначается() Экспорт

	Пулы = Желудь("СервисПулов");
	Закрытый = Пулы.СоздатьПул(Уникальное("closed"), "custom", "private");

	Поймано = "";
	Попытка
		Пулы.НазначитьПулПоУмолчанию(Закрытый.Идентификатор, "тест");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "приватный пул основным не назначается").Содержит("всегда публичен");
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Закрытый.Идентификатор).ЭтоДефолтный(),
		"признак не проставлен").ЭтоЛожь();
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Закрытый.Идентификатор).Видимость,
		"и видимость не изменилась").Равно("private");

КонецПроцедуры

// Несуществующий пул основным не назначается: отказ называет идентификатор.
&Тест
Процедура НесуществующийПулОсновнымНеНазначается() Экспорт

	Поймано = "";
	Попытка
		Желудь("СервисПулов").НазначитьПулПоУмолчанию(987654321, "тест");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "неизвестный пул — отказ").Содержит("не найден");

КонецПроцедуры

// Тип default упразднён: «чьё пространство имён» и «основной пул хаба» — разные вопросы.
&Тест
Процедура ТипаDefaultБольшеНет() Экспорт

	Пулы = Желудь("СервисПулов");
	Ожидаем.Что(Пулы.ДопустимыеТипы().Найти("default"), "типа default в словаре нет").Равно(Неопределено);
	Ожидаем.Что(ОшибкаСозданияПула(Уникальное("d2"), "default", "public"),
		"пул типа default не заводится").Содержит("Некорректный тип пула");

КонецПроцедуры

#КонецОбласти

#Область ЗеркалоДержитПулПокаНаполняетЕго

// Снос пула из-под идущего прогона зеркала — гонка с рабочим: он читает пул назначения
// раз на цикл и до конца порции продолжает укладывать в него пакеты и файлы, а отметить
// прогон ему уже негде. Файлы остаются в хранилище, и пул, заведённый под тем же именем,
// получает их в наследство. Дверь удаления отвечает отказом, а не уборкой.
&Тест
Процедура ПулПодПрогономЗеркалаНеУдаляется() Экспорт

	Пулы = Желудь("СервисПулов");
	Прогон = Желудь("ПрогонЗеркала");

	Пул = Пулы.СоздатьПул(Уникальное("mirrored"), "custom");
	Зеркало = ЗавестиЗеркало(Пул.Идентификатор);

	Ожидаем.Что(Пулы.ПричинаЗапретаУдаления(Пул),
		"простаивающее зеркало удалению не мешает").Равно("");

	// заявка на синхронизацию: рабочий подхватит её через секунды — сносить уже поздно
	Ожидаем.Что(Прогон.Поставить(Зеркало.Идентификатор), "прогон поставлен в очередь").ЭтоИстина();
	Ожидаем.Что(Пулы.ПричинаЗапретаУдаления(Пул),
		"пул с заявкой на синхронизацию не удаляется").Содержит("зеркало");

	Ожидаем.Что(Прогон.Занять(Зеркало.Идентификатор).Занят, "прогон захвачен рабочим").ЭтоИстина();

	Причина = Пулы.ПричинаЗапретаУдаления(Пул);
	Ожидаем.Что(Причина, "причина называет зеркало и его апстрим").Содержит(АдресАпстримаЗеркала());
	Ожидаем.Что(Причина, "и советует, что делать").Содержит("Дождитесь конца прогона");

	Поймано = "";
	Попытка
		Пулы.УдалитьПул(Пул.Идентификатор);
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "домен не сносит пул под прогоном").Содержит("Дождитесь конца прогона");
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Пул.Идентификатор) <> Неопределено,
		"пул на месте").ЭтоИстина();

	// прогон закончился — препятствие ушло вместе с ним
	Прогон.Завершить(Зеркало.Идентификатор, ИтогПрогона(), "", ТекущаяУниверсальнаяДата());
	Ожидаем.Что(Пулы.ПричинаЗапретаУдаления(Пул), "после прогона препятствий нет").Равно("");

	Пулы.УдалитьПул(Пул.Идентификатор);
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Пул.Идентификатор), "пул удалён").Равно(Неопределено);

КонецПроцедуры

// Брошенный прогон (рабочий умер и молчит дольше порога) пул не держит: иначе один
// упавший процесс запер бы пул навсегда, и «пересобрать начисто» стало бы недоступно.
&Тест
Процедура БрошенныйПрогонЗеркалаПулНеДержит() Экспорт

	Пулы = Желудь("СервисПулов");
	Прогон = Желудь("ПрогонЗеркала");

	Пул = Пулы.СоздатьПул(Уникальное("abandoned"), "custom");
	Зеркало = ЗавестиЗеркало(Пул.Идентификатор);
	Прогон.Занять(Зеркало.Идентификатор);

	Ожидаем.Что(Пулы.ПричинаЗапретаУдаления(Пул), "живой прогон держит").Содержит("зеркало");

	// отметки прогресса замолчали дольше порога зависания
	Запись = Желудь("ХранилищеЗеркалХабов").ПолучитьОдноПоИдентификаторРавно(Зеркало.Идентификатор);
	Запись.ПрогонОбновлён = ТекущаяУниверсальнаяДата() - (Прогон.ПорогЗависания() + 60);
	Запись.Сохранить();

	Ожидаем.Что(Пулы.ПричинаЗапретаУдаления(Пул), "брошенный прогон не держит").Равно("");
	Пулы.УдалитьПул(Пул.Идентификатор);
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Пул.Идентификатор), "пул удалён").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область КаскадПриватности

// Приватный пул ⇒ приватны ВСЕ его пакеты: каскад проверяется на решении о ЧТЕНИИ — своего признака у пакета нет.
&Тест
Процедура ПриватныйПулДелаетПриватнымиВсеПакеты() Экспорт

	Права = Желудь("СервисПрав");
	Пулы = Желудь("СервисПулов");
	Пакеты = Желудь("СервисПакетов");

	Приватный = Пулы.СоздатьПул(Уникальное("secret"), "custom", "private");
	Пакет = Пакеты.ЗарегистрироватьПакет(Приватный.Идентификатор, Уникальное("lib"));
	Чужак = СоздатьПользователя();

	Ожидаем.Что(Права.МожетЧитать(Неопределено, Приватный), "аноним не читает приватный пул").ЭтоЛожь();
	Ожидаем.Что(Права.МожетЧитать(Чужак, Приватный), "посторонний не читает").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Неопределено, "чтение", Права.ОбъектПакет(Пакет)),
		"пакет приватного пула анониму недоступен").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Чужак, "чтение", Права.ОбъектПакет(Пакет)),
		"пакет приватного пула постороннему недоступен").ЭтоЛожь();

	// грант ЧТЕНИЯ НА ПУЛ открывает все его пакеты — это и есть каскад, а не перечисление
	Желудь("СервисПравДоступа").ЗафиксироватьГрант("пользователь", Чужак.Идентификатор,
		Права.ОбъектПул(Приватный), Набор(Ложь, Ложь, Ложь, Истина), 0);
	Ожидаем.Что(Права.МожетЧитать(Чужак, Приватный), "с грантом читает пул").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Чужак, "чтение", Права.ОбъектПакет(Пакет)),
		"и все его пакеты").ЭтоИстина();

	// переключение видимости работает в обе стороны
	Пулы.УстановитьВидимость(Приватный.Идентификатор, "public");
	Ожидаем.Что(Права.МожетЧитать(Неопределено, Пулы.ПулПоИдентификатору(Приватный.Идентификатор)),
		"публичный пул читает и аноним").ЭтоИстина();

КонецПроцедуры

// Личное пространство приватным быть НЕ МОЖЕТ: оно раздаётся автоматически каждому, и приватность превратила бы хаб в
// закрытое хранилище произвольных артефактов. КОНТРОЛЬ рядом: тот же вызов на ОБЫЧНОМ пуле проходит.
&Тест
Процедура ЛичныйПулПриватнымБытьНеМожет() Экспорт

	Перем Ошибка;

	Пулы = Желудь("СервисПулов");
	Владелец = СоздатьПользователя();

	Личный = Пулы.СоздатьЛичныйПул(Владелец.Логин, Владелец.Идентификатор);
	Ожидаем.Что(Личный.Видимость, "личное пространство публично при создании").Равно("public");

	Ошибка = "";
	Попытка
		Пулы.УстановитьВидимость(Личный.Идентификатор, "private");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка, "личный пул нельзя сделать приватным").Содержит("приватным быть не может");
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Личный.Идентификатор).Видимость,
		"видимость личного пула не изменилась").Равно("public");

	// КОНТРОЛЬ: обычный пул той же операцией переключается
	Обычный = Пулы.СоздатьПул(Уникальное("custom"), "custom", "public", Владелец.Идентификатор);
	Пулы.УстановитьВидимость(Обычный.Идентификатор, "private");
	Ожидаем.Что(Пулы.ПулПоИдентификатору(Обычный.Идентификатор).Видимость,
		"контроль: обычный пул приватным стать может").Равно("private");

КонецПроцедуры

#КонецОбласти

#Область ОбщееПространствоИмён

// Логины и имена пулов делят ПЕРВЫЙ сегмент адреса (/{пул}/{pkg} и /{логин}/{pkg}) — проверка работает в ОБЕ стороны.
&Тест
Процедура ЛогинИИмяПулаДелятПространствоИмён() Экспорт

	Пулы = Желудь("СервисПулов");
	Пользователи = Желудь("СервисПользователей");

	// 1) пул не занимает чужой логин; учётка заводится прямо через репозиторий — то есть без личного пула
	Существующий = СоздатьПользователя();

	Поймано = "";
	Попытка
		Пулы.СоздатьПул(Существующий.Логин, "custom");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "имя пула, занятое логином, отклонено").Содержит("занято логином");

	// 1a) у пользователя, заведённого штатно, имя занято его личным пулом
	Логин = Уникальное("person");
	Пользователи.СоздатьПользователя(Логин, Логин + "@example.com", "");
	Поймано = "";
	Попытка
		Пулы.СоздатьПул(Логин, "custom");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "адрес занят личным пулом").Содержит("уже существует");

	// 2) логин не занимает существующее имя пула
	ИмяПула = Уникальное("teamspace");
	Пулы.СоздатьПул(ИмяПула, "custom");

	Поймано = "";
	Попытка
		Пользователи.СоздатьПользователя(ИмяПула, ИмяПула + "@example.com", "");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Поймано, "логин, занятый именем пула, отклонён").Содержит("занят именем пула");

КонецПроцедуры

// Личный пул заводится В МОМЕНТ СОЗДАНИЯ УЧЁТКИ — в единственной точке для регистрации, онбординга и OIDC.
&Тест
Процедура ЛичныйПулСоздаётсяВместеСУчёткой() Экспорт

	Логин = Уникальное("newbie");
	Пользователь = Желудь("СервисПользователей").СоздатьПользователя(Логин, Логин + "@example.com", "");

	Личный = Желудь("СервисПулов").НайтиПул(Логин);
	Ожидаем.Что(Личный <> Неопределено, "личный пул заведён").ЭтоИстина();
	Ожидаем.Что(Личный.Тип, "тип user").Равно("user");
	Ожидаем.Что(Личный.ВладелецИдентификатор, "владелец — сам пользователь").Равно(Пользователь.Идентификатор);
	Ожидаем.Что(Личный.АпстримыДопустимы(), "апстримы личному пулу недопустимы").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЛегасиСхемаСнятаПолностью

// Легаси-схема (композиция пулов, «проксирование как тип», группы пакетов) снята целиком: законных
// потребителей снимков не осталось, поэтому красным становится сам возврат легаси-класса в исходники.
&Тест
Процедура ЛегасиСущностиСнятыСМоделиПолностью() Экспорт

	Нарушители = Новый Массив();
	Просканировано = 0;

	Для Каждого Модуль Из НайтиФайлы(ОбъединитьПути(КаталогПроекта(), "src", "модули"), "*", Ложь) Цикл
		Каталог = ОбъединитьПути(Модуль.ПолноеИмя, "Классы");
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Продолжить;
		КонецЕсли;
		// исключений нет: ни белого списка снимков, ни поблажки какому-либо модулю; каталоги обходятся РЕКУРСИВНО
		Для Каждого Файл Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			Просканировано = Просканировано + 1;
			Если СодержитЛегасиСсылку(ПрочитатьТекст(Файл.ПолноеИмя)) Тогда
				Нарушители.Добавить(Модуль.Имя + "/" + Файл.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Просканировано > 100, СтрШаблон("просканировано файлов: %1", Просканировано)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"исходники, обращающиеся к снятым сущностям").Равно("");

	// сканер не вечнозелёный: образцы — КОД, а не комментарий (детектор комментарии отбрасывает)
	Ожидаем.Что(СодержитЛегасиСсылку("Хранилище = Желудь(""ХранилищеЭлементовГруппы"");"),
		"детектор видит ссылку на снятую сущность").ЭтоИстина();
	Ожидаем.Что(СодержитЛегасиСсылку("Хранилище = Желудь(""ХранилищеСоставаГруппПакетов"");"),
		"детектор видит и снимок группы пакетов (5.E)").ЭтоИстина();
	Ожидаем.Что(СодержитЛегасиСсылку("Хранилище = Желудь(""ХранилищеКаналов"");"),
		"детектор видит снятое хранилище каналов (5.C-2)").ЭтоИстина();
	Ожидаем.Что(СодержитЛегасиСсылку("Хранилище = Желудь(""ХранилищеАпстримПрокси"");"),
		"детектор видит снятое хранилище проксирования (О-7)").ЭтоИстина();
	// сама сущность, а не только её хранилище: класс без репозитория тоже приедет в модель entity и в схему БД
	Ожидаем.Что(СодержитЛегасиСсылку("Прокси = Новый АпстримПрокси();"),
		"детектор видит саму снятую сущность проксирования").ЭтоИстина();

	// живая схема апстримов нарушением не считается — подстроки «АпстримПрокси» в её именах нет
	Ожидаем.Что(СодержитЛегасиСсылку("Хранилище = Желудь(""ХранилищеАпстримовПула"");"),
		"актуальная сущность нарушением не считается").ЭтоЛожь();
	Ожидаем.Что(СодержитЛегасиСсылку("Апстрим = Новый АпстримПула();"),
		"актуальная сущность апстрима нарушением не считается").ЭтоЛожь();
	// историческая справка в комментарии законна — иначе детектор запрещал бы объяснять происхождение сущности
	Ожидаем.Что(СодержитЛегасиСсылку("// Обобщение прежнего ""АпстримПрокси"" до 0..N записей"),
		"упоминание истории в комментарии нарушением не считается").ЭтоЛожь();

КонецПроцедуры

// Проверка по ФАЙЛАМ, а не по тексту: так ловится и «класс вернули, но пока никто не зовёт», и «класс себя по имени не
// упоминает». Перебираются ВСЕ модули — место сущности в db соглашение, а не принуждение.
&Тест
Процедура ФайловЛегасиСхемыНеОсталось() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогПроекта(), "src", "модули");

	Уцелевшие = Новый Массив();
	ПросмотреноКаталогов = 0;
	Для Каждого Модуль Из НайтиФайлы(КаталогМодулей, "*", Ложь) Цикл
		КаталогКлассов = ОбъединитьПути(Модуль.ПолноеИмя, "Классы");
		Если НЕ Новый Файл(КаталогКлассов).Существует() Тогда
			Продолжить;
		КонецЕсли;
		ПросмотреноКаталогов = ПросмотреноКаталогов + 1;
		Для Каждого Имя Из СнятыеКлассыСхемы() Цикл
			// РЕКУРСИВНО: классы модуля могут лежать по подкаталогам (web-ui)
			Если НайтиФайлы(КаталогКлассов, Имя + ".os", Истина).Количество() > 0 Тогда
				Уцелевшие.Добавить(Модуль.Имя + "/" + Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// контроль охвата: перебор реально нашёл каталоги классов, а не отработал вхолостую
	Ожидаем.Что(ПросмотреноКаталогов > 1,
		СтрШаблон("каталогов Классы просмотрено: %1", ПросмотреноКаталогов)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Уцелевшие, ", "),
		"классы снятой схемы, вернувшиеся в исходники").Равно("");

КонецПроцедуры

// Классы, снятые вместе со своей схемой (Д-1). Сущность и её репозиторий — парами.
Функция СнятыеКлассыСхемы()
	Возврат СтрРазделить(
		"Канал,ХранилищеКаналов,"
		+ "АпстримПрокси,ХранилищеАпстримПрокси,"
		+ "ЭлементПулаГруппы,ХранилищеЭлементовГруппы,"
		+ "СоставГруппыПакетов,ХранилищеСоставаГруппПакетов", ",");
КонецФункции

// Имена, по которым узнаётся обращение к снятой схеме: ловим хранилища и сущности снимков. «АпстримПрокси» — подстрока,
// которой нет в живой схеме апстримов; «Канал» не берём: корень слова живёт в доменном языке тегов.
// Ищем в КОДЕ — комментарии отбрасываются, историческая справка в шапке файла законна.
Функция СодержитЛегасиСсылку(Знач Текст)
	Код = БезКомментариев(Текст);
	Возврат СтрНайти(Код, "ЭлементПулаГруппы") > 0
		ИЛИ СтрНайти(Код, "ХранилищеЭлементовГруппы") > 0
		ИЛИ СтрНайти(Код, "АпстримПрокси") > 0
		ИЛИ СтрНайти(Код, "ХранилищеКаналов") > 0
		ИЛИ СтрНайти(Код, "ХранилищеСоставаГруппПакетов") > 0;
КонецФункции

// Отбрасывает построчные комментарии OneScript; «//» внутри строкового литерала обрежет заодно — имени класса после
// «http://» не бывает.
Функция БезКомментариев(Знач Текст)

	Очищенные = Новый Массив();
	Для Каждого СтрокаКода Из СтрРазделить(Текст, Символы.ПС) Цикл
		Позиция = СтрНайти(СтрокаКода, "//");
		Если Позиция > 0 Тогда
			СтрокаКода = Лев(СтрокаКода, Позиция - 1);
		КонецЕсли;
		Очищенные.Добавить(СтрокаКода);
	КонецЦикла;
	Возврат СтрСоединить(Очищенные, Символы.ПС);

КонецФункции

Функция ПрочитатьТекст(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

Функция КаталогПроекта()
	Возврат Новый Файл(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..")).ПолноеИмя;
КонецФункции

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция АдресАпстримаЗеркала()
	Возврат "http://127.0.0.1:1/download/";
КонецФункции

// Строка зеркала пишется хранилищем напрямую: СервисЗеркал в этот контейнер не входит,
// а прогон живёт в самой записи.
Функция ЗавестиЗеркало(Знач ПулИд)

	Зеркало = Желудь("ХранилищеЗеркалХабов").СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = ПулИд;
	Зеркало.АпстримURL = АдресАпстримаЗеркала();
	Зеркало.Режим = "opm";
	Зеркало.ИнтервалСинкаСек = 3600;
	Зеркало.Включено = Истина;
	Зеркало.Сохранить();
	Возврат Зеркало;

КонецФункции

Функция ИтогПрогона()
	Возврат Новый Структура("Всего, Скачано, Пропущено, Ошибок, Недоступно, ЕстьЕщё, Статус",
		0, 0, 0, 0, 0, Ложь, "прогон закончен");
КонецФункции

// Заводит в пуле по строке каждого вида, который на него ссылается. Строки пишутся
// хранилищами напрямую: сервисы этих доменов в контейнер типов пулов не входят, а тест
// сторожит именно уборку хранилищ.
Процедура НабитьПул(Знач ПулИд)

	Автор = СоздатьПользователя();

	Пакет = Желудь("ХранилищеПакетов").СоздатьЭлемент();
	Пакет.ПулИдентификатор = ПулИд;
	Пакет.Имя = Уникальное("pkg");
	Пакет.ИмяНижнийРегистр = НРег(Пакет.Имя);
	Пакет.Создан = ТекущаяУниверсальнаяДата();
	Пакет.Сохранить();

	Версия = Желудь("ХранилищеВерсийПакета").СоздатьЭлемент();
	Версия.ПакетИдентификатор = Пакет.Идентификатор;
	Версия.Версия = "1.0.0";
	Версия.SemverМажор = 1;
	Версия.SemverМинор = 0;
	Версия.SemverПатч = 0;
	Версия.Размер = 1;
	Версия.Sha256 = "deadbeef";
	Версия.Отозвана = Ложь;
	Версия.ОпубликовалИдентификатор = Автор.Идентификатор;
	Версия.Опубликована = ТекущаяУниверсальнаяДата();
	Версия.ПутьВХранилище = "x/y.ospx";
	Версия.Сохранить();

	Желудь("ХранилищеЗависимостей").Записать(Версия.Идентификатор, "dep");

	МеткаВерсии = Желудь("ХранилищеМетокВерсий").СоздатьЭлемент();
	МеткаВерсии.ВерсияИдентификатор = Версия.Идентификатор;
	МеткаВерсии.Метка = "stable";
	МеткаВерсии.Сохранить();

	Происхождение = Желудь("ХранилищеПроисхожденияВерсий").СоздатьЭлемент();
	Происхождение.ПакетИдентификатор = Пакет.Идентификатор;
	Происхождение.ВерсияИдентификатор = Версия.Идентификатор;
	Происхождение.Источник = "локально";
	Происхождение.Зафиксировано = ТекущаяУниверсальнаяДата();
	Происхождение.Сохранить();

	Желудь("ХранилищеСкачиванийАгрегатов").Накопить(Пакет.Идентификатор, Версия.Идентификатор,
		Дата(2026, 7, 25, 0, 0, 0), 3);

	Тег = Желудь("ХранилищеТегов").СоздатьЭлемент();
	Тег.ПакетИдентификатор = Пакет.Идентификатор;
	Тег.Имя = "latest";
	Тег.Режим = "ручной";
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить();

	МеткаТега = Желудь("ХранилищеМетокТегов").СоздатьЭлемент();
	МеткаТега.ТегИдентификатор = Тег.Идентификатор;
	МеткаТега.ВерсияИдентификатор = Версия.Идентификатор;
	МеткаТега.Сохранить();

	Доверие = Желудь("ХранилищеДоверияCI").СоздатьЭлемент();
	Доверие.ПакетИдентификатор = Пакет.Идентификатор;
	Доверие.ПулИдентификатор = ПулИд;
	Доверие.Провайдер = "github";
	Доверие.Издатель = "https://token.actions.githubusercontent.com";
	Доверие.Репозиторий = "owner/repo";
	Доверие.Создано = ТекущаяУниверсальнаяДата();
	Доверие.Сохранить();

	ЗавестиПодписку(ПулИд, "пакет", Пакет.Идентификатор);
	ЗавестиПодписку(ПулИд, "пул", ПулИд);

	ЗавестиГрант("пакет", Пакет.Идентификатор, Автор.Идентификатор);
	ЗавестиГрант("пул", ПулИд, Автор.Идентификатор);

	Участник = Желудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = ПулИд;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Автор.Идентификатор;
	Участник.Роль = "publisher";
	Участник.Сохранить();

	Токен = Желудь("ХранилищеТокенов").СоздатьЭлемент();
	Токен.ПользовательИдентификатор = Автор.Идентификатор;
	Токен.Префикс = Уникальное("pfx");
	Токен.Хеш = "hash";
	Токен.Права = "read";
	Токен.ПулИдентификатор = ПулИд;
	Токен.Создан = ТекущаяУниверсальнаяДата();
	Токен.Сохранить();

	Зеркало = Желудь("ХранилищеЗеркалХабов").СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = ПулИд;
	Зеркало.АпстримURL = "https://hub.example/download/";
	Зеркало.Режим = "пакеты";
	Зеркало.ИнтервалСинкаСек = 3600;
	Зеркало.Включено = Истина;
	Зеркало.Создан = ТекущаяУниверсальнаяДата();
	Зеркало.Сохранить();

	Апстрим = Желудь("ХранилищеАпстримовПула").СоздатьЭлемент();
	Апстрим.ПулИдентификатор = ПулИд;
	Апстрим.Порядок = 0;
	Апстрим.Url = "https://upstream.example/download/";
	Апстрим.ВремяЖизниСек = 900;
	Апстрим.Сохранить();

	Заявка = Желудь("ХранилищеВходящихПубликаций").СоздатьЭлемент();
	Заявка.ПулИдентификатор = ПулИд;
	Заявка.ИмяПакета = Уникальное("inbox");
	Заявка.ИмяНижнийРегистр = НРег(Заявка.ИмяПакета);
	Заявка.Версия = "1.0.0";
	Заявка.ЗаявительИдентификатор = Автор.Идентификатор;
	Заявка.Состояние = "ожидает";
	Заявка.Создана = ТекущаяУниверсальнаяДата();
	Заявка.Сохранить();

КонецПроцедуры

Процедура ЗавестиПодписку(Знач ПулИд, Знач ТипОбъекта, Знач ОбъектИд)
	Подписка = Желудь("ХранилищеВебхуков").СоздатьЭлемент();
	Подписка.ТипОбъекта = ТипОбъекта;
	Подписка.ОбъектИдентификатор = ОбъектИд;
	Подписка.ПулИдентификатор = ПулИд;
	Подписка.ТипДействия = "вебхук";
	Подписка.URL = "https://hook.example/" + Уникальное("h");
	Подписка.ТипыСобытий = "версия.опубликована";
	Подписка.Активен = Истина;
	Подписка.Создан = ТекущаяУниверсальнаяДата();
	Подписка.Сохранить();
КонецПроцедуры

Процедура ЗавестиГрант(Знач ТипОбъекта, Знач ОбъектИд, Знач СубъектИд)
	Грант = Желудь("ХранилищеПравДоступа").СоздатьЭлемент();
	Грант.ТипСубъекта = "пользователь";
	Грант.СубъектИдентификатор = СубъектИд;
	Грант.ТипОбъекта = ТипОбъекта;
	Грант.ОбъектИдентификатор = ОбъектИд;
	Грант.Создание = Ложь;
	Грант.Изменение = Истина;
	Грант.Удаление = Ложь;
	Грант.Чтение = Истина;
	Грант.Выдано = ТекущаяУниверсальнаяДата();
	Грант.Сохранить();
КонецПроцедуры

// Сколько строк во ВСЕХ хранилищах всё ещё ссылается на этот пул — прямо или через
// его пакеты и версии.
Функция СиротДляПула(Знач ПулИд)

	Итого = Желудь("ХранилищеПравДоступа").ГрантыНаОбъект("пул", ПулИд).Количество()
		+ Желудь("ХранилищеУчастниковПула").ПолучитьПоПулИдентификаторРавно(ПулИд).Количество()
		+ Желудь("ХранилищеТокенов").ТокеныПула(ПулИд).Количество()
		+ Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пул", ПулИд).Количество()
		+ Желудь("ХранилищеЗеркалХабов").ПолучитьПоПулНазначенияИдентификаторРавно(ПулИд).Количество()
		+ Желудь("ХранилищеАпстримовПула").ПолучитьПоПулИдентификаторРавно(ПулИд).Количество()
		+ Желудь("ХранилищеВходящихПубликаций").ПолучитьПоПулИдентификаторРавно(ПулИд).Количество();

	Для Каждого Пакет Из Желудь("ХранилищеПакетов").ПолучитьПоПулИдентификаторРавно(ПулИд) Цикл
		Итого = Итого + 1 + СиротДляПакета(Пакет.Идентификатор);
	КонецЦикла;

	Возврат Итого;

КонецФункции

Функция СиротДляПакета(Знач ПакетИд)

	Итого = Желудь("ХранилищеПравДоступа").ГрантыНаОбъект("пакет", ПакетИд).Количество()
		+ Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пакет", ПакетИд).Количество()
		+ Желудь("ХранилищеДоверияCI").ПолучитьПоПакетИдентификаторРавно(ПакетИд).Количество()
		+ Желудь("ХранилищеПроисхожденияВерсий").ПолучитьПоПакетИдентификаторРавно(ПакетИд).Количество()
		+ Желудь("ХранилищеСкачиванийАгрегатов").АгрегатыПакета(ПакетИд).Количество();

	Для Каждого Тег Из Желудь("ХранилищеТегов").ПолучитьПоПакетИдентификаторРавно(ПакетИд) Цикл
		Итого = Итого + 1
			+ Желудь("ХранилищеМетокТегов").ПолучитьПоТегИдентификаторРавно(Тег.Идентификатор).Количество();
	КонецЦикла;

	Для Каждого Версия Из Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(ПакетИд) Цикл
		Итого = Итого + 1
			+ Желудь("ХранилищеЗависимостей").ПоВерсии(Версия.Идентификатор).Количество()
			+ Желудь("ХранилищеМетокВерсий").ПолучитьПоВерсияИдентификаторРавно(Версия.Идентификатор).Количество();
	КонецЦикла;

	Возврат Итого;

КонецФункции

Функция Уникальное(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

Функция Набор(Знач Создание, Знач Изменение, Знач Удаление, Знач Чтение)
	Возврат Новый Структура("создание, изменение, удаление, чтение", Создание, Изменение, Удаление, Чтение);
КонецФункции

Функция СоздатьПользователя(Знач РольХаба = "user")
	Хранилище = Желудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Польз.Логин = Уникальное("u");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

Процедура ВыдатьРоль(Знач Пул, Знач ТипСубъекта, Знач СубъектИд, Знач Роль)
	Участник = Желудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = ТипСубъекта;
	Участник.СубъектИдентификатор = СубъектИд;
	Участник.Роль = Роль;
	Участник.Сохранить();
КонецПроцедуры

Функция ОбеспечитьОсновнойПул()
	Пулы = Желудь("СервисПулов");
	Существующий = Пулы.ДефолтныйПул();
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Возврат Пулы.НазначитьПулПоУмолчанию(
		Пулы.СоздатьПул(Уникальное("hubmain"), "custom", "public").Идентификатор, "тест");
КонецФункции

Функция ОшибкаДобавленияАпстрима(Знач ПулИдентификатор, Знач Url)
	Попытка
		Желудь("СервисПулов").ДобавитьАпстрим(ПулИдентификатор, Url, 900);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ОшибкаЗаданияАпстримаЧерезСлужбу(Знач Пользователь, Знач ПулИдентификатор)
	Попытка
		Желудь("СлужбаДоступа").ЗадатьАпстрим(Пользователь, ПулИдентификатор,
			"http://hub.oscript.io/download/", 900);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ОшибкаСозданияПула(Знач Имя, Знач Тип, Знач Видимость)
	Попытка
		Желудь("СервисПулов").СоздатьПул(Имя, Тип, Видимость);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Процедура ПодключитьКаталог(Знач Каталог)
	Для Каждого ФайлКласса Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

Процедура ПодключитьФайл(Знач Путь)
	Имя = Новый Файл(Путь).ИмяБезРасширения;
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти
