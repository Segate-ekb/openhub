// HTTP-интеграционные тесты аутентификации: онбординг, регистрация, вход, сессии, PAT.
// Поднимается настоящий хаб на пустой БД, без ручных манипуляций с БД и без сидера.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;          // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	Хаб = НовыйХаб();
	Хаб.ФайловаяБаза("openhub-auth");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// Инсталляция без почты обязана выбрать одну из двух развилок, иначе регистрация
	// закрыта (ИСТ-ПОЧТ-007). Здесь выбрана вторая: подтверждение адреса выключено.
	// Саму заставу на живом хабе держит ПодтверждениеАдресаHTTP_Тесты.
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	Хаб.Запустить();
	Порт = Хаб.Порт();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// --- полный сценарий на общем хабе ---

&Тест
Процедура ПолныйСценарийОнбордингРегистрацияВходТокены() Экспорт

	// 1. онбординг нужен на свежей БД
	Состояние = ТелоJSON(GET("/setup"));
	Ожидаем.Что(Состояние.Получить("onboarding_needed")).ЭтоИстина();

	// 2. /setup создаёт первого админа
	ОтветАдмин = POST("/setup", "{""логин"":""root"",""пароль"":""SuperSecret1""}", "");
	Ожидаем.Что(ОтветАдмин.КодСостояния).Равно(201);

	// 3. онбординг завершён, повторный /setup → 409
	Ожидаем.Что(ТелоJSON(GET("/setup")).Получить("onboarding_needed")).ЭтоЛожь();
	Ожидаем.Что(POST("/setup", "{""логин"":""x"",""пароль"":""password123""}", "").КодСостояния).Равно(409);

	// 4. регистрация обычного пользователя
	ОтветРег = POST("/api/v1/register",
		"{""логин"":""alice"",""email"":""a@ex.com"",""пароль"":""password123""}", "");
	Ожидаем.Что(ОтветРег.КодСостояния).Равно(201);

	// 5. вход по паролю → сессионная cookie
	ОтветВход = POST("/api/v1/login", "{""логин"":""Alice"",""пароль"":""password123""}", "");
	Ожидаем.Что(ОтветВход.КодСостояния).Равно(200);
	КукаСессии = ИзвлечьКукуСессии(ОтветВход);
	Ожидаем.Что(ЗначениеЗаполнено(КукаСессии), "Set-Cookie oshub_session").ЭтоИстина();

	// 6. whoami по сессии
	ОтветЯ = GET_СКуки("/api/v1/whoami", КукаСессии);
	Ожидаем.Что(ОтветЯ.КодСостояния).Равно(200);
	Данные = ТелоJSON(ОтветЯ).Получить("user");
	Ожидаем.Что(Данные.Получить("login")).Равно("alice");
	Ожидаем.Что(Данные.Получить("auth_method")).Равно("session");

	// 7. whoami без аутентификации → 401
	Ожидаем.Что(GET("/api/v1/whoami").КодСостояния).Равно(401);

	// 8. неверный пароль → 401
	Ожидаем.Что(POST("/api/v1/login", "{""логин"":""alice"",""пароль"":""nope""}", "").КодСостояния).Равно(401);

	// 9. выпуск PAT (по сессии)
	ОтветТокен = POST_СКуки("/api/v1/tokens", "{""права"":""read,write""}", КукаСессии);
	Ожидаем.Что(ОтветТокен.КодСостояния).Равно(201);
	ИнфоТокена = ТелоJSON(ОтветТокен).Получить("token_info");
	СыройТокен = ИнфоТокена.Получить("token");
	ИдТокена = ИнфоТокена.Получить("id");
	Ожидаем.Что(СтрНачинаетсяС(Строка(СыройТокен), "oshub_")).ЭтоИстина();

	// 10. whoami по PAT — Authorization: Bearer
	ОтветBearer = GET_СЗаголовком("/api/v1/whoami", "Authorization", "Bearer " + СыройТокен);
	Ожидаем.Что(ОтветBearer.КодСостояния).Равно(200);
	Ожидаем.Что(ТелоJSON(ОтветBearer).Получить("user").Получить("auth_method")).Равно("token");

	// 11. whoami по PAT — заголовок OAUTH-TOKEN (push по контракту opm)
	ОтветOAuth = GET_СЗаголовком("/api/v1/whoami", "OAUTH-TOKEN", Строка(СыройТокен));
	Ожидаем.Что(ОтветOAuth.КодСостояния).Равно(200);

	// 12. неверный токен → 401
	Ожидаем.Что(GET_СЗаголовком("/api/v1/whoami", "Authorization", "Bearer oshub_1_bad").КодСостояния).Равно(401);

	// 13. список токенов не раскрывает секрет/хеш
	ТелоСписка = Тело(GET_СКуки("/api/v1/tokens", КукаСессии));
	Ожидаем.Что(СтрНайти(ТелоСписка, Строка(СыройТокен))).Равно(0);
	Ожидаем.Что(СтрНайти(ТелоСписка, "oshub_") > 0, "prefix присутствует").ЭтоИстина();

	// 14. отзыв токена → повторная проверка 401
	ОтветОтзыв = DELETE_СКуки("/api/v1/tokens/" + Формат(ИдТокена, "ЧГ=0"), КукаСессии);
	Ожидаем.Что(ОтветОтзыв.КодСостояния).Равно(200);
	Ожидаем.Что(GET_СЗаголовком("/api/v1/whoami", "Authorization", "Bearer " + СыройТокен).КодСостояния).Равно(401);

	// 15. rate-limit — ПОСЛЕДНИМ шагом: серия неудач по логину/IP блокирует IP
	// (127.0.0.1) на срок блокировки; после этого шага логины в этом тесте не нужны.
	// Брутфорсим несуществующий логин, чтобы не плодить пользователей.
	Заблокировано = Ложь;
	Для НомерПопытки = 1 По 10 Цикл
		Ответ = POST("/api/v1/login", "{""логин"":""ghost"",""пароль"":""неверный""}", "");
		Если Ответ.КодСостояния = 429 Тогда
			Заблокировано = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Заблокировано, "rate-limit вернул 429 после серии неудач").ЭтоИстина();

КонецПроцедуры

// --- отдельный хаб: онбординг через переменные окружения ---

&Тест
Процедура ОнбордингЧерезEnvАдмина() Экспорт

	// Второй экземпляр — со СВОИМ свободным портом от ОС (никакой арифметики
	// «Порт + 1»: соседний номер занят с той же вероятностью, что и любой другой).
	ХабДва = НовыйХаб();
	ХабДва.ФайловаяБаза("openhub-envadmin");
	ХабДва.Среда("OSHUB_ADMIN_LOGIN", "envadmin");
	ХабДва.Среда("OSHUB_ADMIN_PASSWORD", "EnvSecret123");

	Попытка
		ХабДва.Запустить();
		ПортДва = ХабДва.Порт();

		// env-админ создаётся рогаткой при старте; первый вызОв pwhash несёт JIT-прогрев
		// (~1 c), поэтому админ появляется вскоре после открытия порта — опрашиваем вход
		// с ретраем (реалистично: деплой ждёт готовности сервиса).
		ОтветВход = ДождатьсяВхода(ПортДва, "envadmin", "EnvSecret123");
		Ожидаем.Что(ОтветВход.КодСостояния).Равно(200);
		// онбординг завершён (админ есть)
		Ожидаем.Что(ТелоJSON(GET_Порт(ПортДва, "/setup")).Получить("onboarding_needed")).ЭтоЛожь();
		// админу выставлен флаг «сменить пароль при первом входе»
		Ожидаем.Что(ТелоJSON(ОтветВход).Получить("user").Получить("must_change_password")).ЭтоИстина();

	Исключение
		ХабДва.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабДва.Остановить();

КонецПроцедуры

// --- отдельный хаб: порог rate-limit задаётся переменной окружения ---

&Тест
Процедура ЛимитВходаИзEnvПрименяется() Экспорт

	// Проверяем сквозную цепочку env → configor → деталька → бин: заданный порог
	// РЕАЛЬНО меняет лимит. Порог 3: 429 обязан появиться уже к 4-й попытке
	// (дефолтные 5 не дали бы 429 в пределах 4 попыток).
	ХабТри = НовыйХаб();
	ХабТри.ФайловаяБаза("openhub-rl");
	ХабТри.Среда("OSHUB_ADMIN_LOGIN", "");
	ХабТри.Среда("OSHUB_ADMIN_PASSWORD", "");
	ХабТри.Среда("OSHUB_AUTH_LOGIN_MAXATTEMPTS", "3");

	Попытка
		ХабТри.Запустить();
		ПортТри = ХабТри.Порт();

		Заблокировано = Ложь;
		Для НомерПопытки = 1 По 4 Цикл
			Ответ = POST_Порт(ПортТри, "/api/v1/login", "{""логин"":""ghost"",""пароль"":""bad""}");
			Если Ответ.КодСостояния = 429 Тогда
				Заблокировано = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Ожидаем.Что(Заблокировано, "порог 3 из OSHUB_AUTH_LOGIN_MAXATTEMPTS: 429 к 4-й попытке").ЭтоИстина();

	Исключение
		ХабТри.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабТри.Остановить();

КонецПроцедуры

// --- отдельный хаб: один адрес почты — одна учётка ---

&Тест
Процедура ЗанятыйАдресПочтыНеПропускаетВторуюУчёткуНиОднойДверью() Экспорт

	// Письмо хаба обязано иметь единственного адресата, а восстановление пароля по адресу —
	// не гадать, чей это доступ. Дверей самостоятельной регистрации две, и закрытая одна
	// ничего не стоит: вторую учётку заводят через ту, что осталась открытой.
	ХабАдресов = НовыйХаб();
	ХабАдресов.ФайловаяБаза("openhub-занятый-адрес");
	ХабАдресов.Среда("OSHUB_ADMIN_LOGIN", "mailadmin");
	ХабАдресов.Среда("OSHUB_ADMIN_PASSWORD", "MailSecret123");
	ХабАдресов.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	Попытка

		ХабАдресов.Запустить();
		ХабАдресов.ДождатьсяОнбординга();
		ПортАдресов = ХабАдресов.Порт();
		Занятый = "zanyato@example.test";

		Ожидаем.Что(Зарегистрировать(ПортАдресов, "/api/v1/register", "pervyj", Занятый).КодСостояния,
			"первая учётка на свободный адрес заведена").Равно(201);

		// вторая дверь регистрации отвечает так же — и тем же кодом: клиент, который
		// разбирает ответ, не должен гадать, в какую из дверей он постучался
		ОтказВторой = Зарегистрировать(ПортАдресов, "/api/v1/users", "vtoroj", Занятый);
		Ожидаем.Что(ОтказВторой.КодСостояния,
			"вторая учётка на занятый адрес не заводится: " + Тело(ОтказВторой)).Равно(409);
		Ожидаем.Что(СтрНайти(Тело(ОтказВторой), "email_taken") > 0,
			"отказ назвал причину кодом: " + Тело(ОтказВторой)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(ОтказВторой), "pervyj"),
			"и отказ не рассказывает, чья это учётка").Равно(0);

		// регистр и краевые пробелы занятости не обходят
		ОтказРегистра = Зарегистрировать(ПортАдресов, "/api/v1/register", "tretij",
			" ZANYATO@Example.TEST ");
		Ожидаем.Что(ОтказРегистра.КодСостояния,
			"тот же адрес иначе набранный — тот же занятый адрес: " + Тело(ОтказРегистра)).Равно(409);
		Ожидаем.Что(СтрНайти(Тело(ОтказРегистра), "email_taken") > 0,
			"и вторая дверь называет ту же причину тем же кодом: " + Тело(ОтказРегистра)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(ОтказРегистра), "pervyj"),
			"не называя чужого логина").Равно(0);

		// самотест: отвергнут именно адрес, а не регистрация вообще
		Ожидаем.Что(Зарегистрировать(ПортАдресов, "/api/v1/register", "chetvertyj",
			"svobodno@example.test").КодСостояния, "свободный адрес принят").Равно(201);

		// пустой адрес занятым не считается: учёток без почты бывает сколько угодно
		Ожидаем.Что(Зарегистрировать(ПортАдресов, "/api/v1/register", "bezpochty", "").КодСостояния,
			"учётка без почты заводится").Равно(201);
		Ожидаем.Что(Зарегистрировать(ПортАдресов, "/api/v1/users", "bezpochtytoo", "").КодСостояния,
			"и вторая такая же — тоже").Равно(201);

		// учётки на занятый адрес не появилось: под её логином не войти
		Ожидаем.Что(POST_Порт(ПортАдресов, "/api/v1/login",
			"{""логин"":""vtoroj"",""пароль"":""ProbnyjPassw0rd""}").КодСостояния,
			"отвергнутая учётка не завелась молча").Равно(401);

	Исключение
		ХабАдресов.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабАдресов.Остановить();

КонецПроцедуры

// --- отдельный хаб: замок подбора пароля ---

&Тест
Процедура ЗамокПодбораНазванСловамиИОткрываетсяСамПоСрокуБлокировки() Экспорт

	// Порог и срок — числа инсталляции. Здесь они взяты такими, чтобы замок можно было
	// пережить в тесте: человеку обещано, что блокировка снимется САМА и что он узнает
	// о ней сообщением, а не молчаливым «неверный логин или пароль».
	ХабЗамка = НовыйХаб();
	ХабЗамка.ФайловаяБаза("openhub-замок-входа");
	ХабЗамка.Среда("OSHUB_ADMIN_LOGIN", "zamokadmin");
	ХабЗамка.Среда("OSHUB_ADMIN_PASSWORD", "ZamokSecret123");
	ХабЗамка.Среда("OSHUB_AUTH_LOGIN_MAXATTEMPTS", "3");
	ХабЗамка.Среда("OSHUB_AUTH_LOGIN_LOCKOUTSECONDS", "5");

	Попытка

		ХабЗамка.Запустить();
		ХабЗамка.ДождатьсяОнбординга();
		ПортЗамка = ХабЗамка.Порт();

		Ожидаем.Что(ВходФормой(ПортЗамка, "zamokadmin", "ZamokSecret123").КодСостояния < 400,
			"самотест: до замка пароль пускает").ЭтоИстина();

		Для НомерПопытки = 1 По 3 Цикл
			ВходФормой(ПортЗамка, "zamokadmin", "невернейший");
		КонецЦикла;

		// человек видит замок сообщением — и это ДРУГОЕ сообщение, чем «неверный пароль»
		Замок = ВходФормой(ПортЗамка, "zamokadmin", "ZamokSecret123");
		Ожидаем.Что(Замок.КодСостояния, "вход закрыт после порога неудач").Равно(429);
		Ожидаем.Что(СтрНайти(Тело(Замок), "Слишком много попыток входа") > 0,
			"и сказано, что произошло: " + Тело(Замок)).ЭтоИстина();

		// замок снимается сам по истечении срока: идти к администратору не надо
		Приостановить(7000);
		Ожидаем.Что(ВходФормой(ПортЗамка, "zamokadmin", "ZamokSecret123").КодСостояния < 400,
			"по истечении срока вход открылся сам").ЭтоИстина();

	Исключение
		ХабЗамка.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабЗамка.Остановить();

КонецПроцедуры

#Область Инфраструктура

// Регистрация дверью Путь: логин, адрес и заведомо годный пароль.
Функция Зарегистрировать(Знач НомерПорта, Знач Путь, Знач Логин, Знач Email)

	Тело_ = СтрШаблон("{""логин"":""%1"",""email"":""%2"",""пароль"":""ProbnyjPassw0rd""}",
		Логин, Email);
	Возврат POST_Порт(НомерПорта, Путь, Тело_);

КонецФункции

// Вход страницей входа — так, как его делает браузер: форма, а не JSON.
Функция ВходФормой(Знач НомерПорта, Знач Логин, Знач Пароль)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Запрос = Новый HTTPЗапрос("/login", Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		"логин=" + КодироватьСтроку(Логин, СпособКодированияСтроки.URLEncoding)
		+ "&пароль=" + КодироватьСтроку(Пароль, СпособКодированияСтроки.URLEncoding),
		КодировкаТекста.UTF8);
	Соединение = Новый HTTPСоединение("localhost", НомерПорта, , , , 15);
	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

// Новый подопытный хаб: свободный порт от ОС, гарантированная остановка.
// Порт, окружение, ожидание готовности и чистка — ответственность фикстуры.
// Реестр идемпотентен, а хаб поднимается за набор трижды.
Функция НовыйХаб()

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Возврат Новый ЭкземплярХаба(90);

КонецФункции

// Опрашивает вход env-админа, пока не создан рогаткой (первый pwhash несёт JIT-прогрев).
Функция ДождатьсяВхода(Знач НомерПорта, Знач Логин, Знач Пароль)
	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30 * 1000;
	Ответ = Неопределено;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Ответ = POST_Порт(НомерПорта, "/api/v1/login", Тело_);
		Если Ответ.КодСостояния = 200 Тогда
			Возврат Ответ;
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;
	Возврат Ответ;
КонецФункции

// Ожидание готовности хаба живёт в фикстуре ЭкземплярХаба (общая для всех HTTP-наборов).

// --- HTTP-помощники ---

Функция GET(Знач Путь)
	Возврат GET_Порт(Порт, Путь);
КонецФункции

Функция GET_Порт(Знач НомерПорта, Знач Путь)
	Соединение = Новый HTTPСоединение("localhost", НомерПорта, , , , 15);
	Возврат Соединение.Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция GET_СКуки(Знач Путь, Знач КукаСессии)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + КукаСессии);
	Соединение = Новый HTTPСоединение("localhost", Порт, , , , 15);
	Возврат Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция GET_СЗаголовком(Знач Путь, Знач ИмяЗаголовка, Знач ЗначениеЗаголовка)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить(ИмяЗаголовка, ЗначениеЗаголовка);
	Соединение = Новый HTTPСоединение("localhost", Порт, , , , 15);
	Возврат Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция POST(Знач Путь, Знач Тело, Знач КукаСессии)
	Возврат POST_Полный(Порт, Путь, Тело, КукаСессии);
КонецФункции

Функция POST_СКуки(Знач Путь, Знач Тело, Знач КукаСессии)
	Возврат POST_Полный(Порт, Путь, Тело, КукаСессии);
КонецФункции

Функция POST_Порт(Знач НомерПорта, Знач Путь, Знач Тело)
	Возврат POST_Полный(НомерПорта, Путь, Тело, "");
КонецФункции

Функция POST_Полный(Знач НомерПорта, Знач Путь, Знач Тело, Знач КукаСессии)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Если ЗначениеЗаполнено(КукаСессии) Тогда
		Заголовки.Вставить("Cookie", "oshub_session=" + КукаСессии);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Соединение = Новый HTTPСоединение("localhost", НомерПорта, , , , 15);
	Возврат Соединение.ОтправитьДляОбработки(Запрос);
КонецФункции

Функция DELETE_СКуки(Знач Путь, Знач КукаСессии)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + КукаСессии);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Соединение = Новый HTTPСоединение("localhost", Порт, , , , 15);
	Возврат Соединение.ВызватьHTTPМетод("DELETE", Запрос);
КонецФункции

Функция Тело(Знач Ответ)
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

Функция ТелоJSON(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

// Извлекает значение oshub_session из заголовка(ов) Set-Cookie ответа.
// .NET-клиент склеивает несколько Set-Cookie в одну строку через запятую
// ("SessionID=...; httponly, oshub_session=...; httponly"), поэтому ищем маркер
// "oshub_session=" напрямую и читаем hex-значение до ближайшего ";".
Функция ИзвлечьКукуСессии(Знач Ответ)
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "SET-COOKIE" Тогда
			Значение = ИзвлечьЗначениеКуки(Строка(КиЗ.Значение), "oshub_session");
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИзвлечьЗначениеКуки(Знач СтрокаКук, Знач ИмяКуки)
	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	// значение — hex (без ';' и ','), заканчивается на ближайшем разделителе атрибутов
	Конец = СтрДлина(Остаток) + 1;
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Если ТочкаЗпт > 0 И ТочкаЗпт < Конец Тогда
		Конец = ТочкаЗпт;
	КонецЕсли;
	Запятая = СтрНайти(Остаток, ",");
	Если Запятая > 0 И Запятая < Конец Тогда
		Конец = Запятая;
	КонецЕсли;
	Возврат СокрЛП(Лев(Остаток, Конец - 1));
КонецФункции

#КонецОбласти
