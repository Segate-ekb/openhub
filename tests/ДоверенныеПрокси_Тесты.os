// Определение адреса клиента за обратным прокси: без списка доверенных сетей заголовок
// пересылки не читается вовсе, с ним — только у соединения из доверенной сети, и клиентом
// считается первая справа запись цепочки, не принадлежащая своим прокси.

#Использовать asserts
#Использовать logos
#Использовать "фикстуры"

Перем Настройки;   // НастройкиЗаглушка
Перем Прокси;      // ДоверенныеПрокси (вход)
Перем Адреса;      // АдресКлиентаЗапроса (вход)

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	Поиск = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "КанонIP");
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ДоверенныеПрокси");
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ЗаписиПересылки");
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "АдресКлиентаЗапроса");

КонецПроцедуры

&ПередКаждым
Процедура СобратьОпределитель() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Канон = Новый КанонIP();
	Прокси = Новый ДоверенныеПрокси(Настройки, Канон, ЛогТеста());
	Адреса = Новый АдресКлиентаЗапроса(Прокси, Новый ЗаписиПересылки(Канон), Канон, ЛогТеста());
	Доверять("");

КонецПроцедуры

#Область БезСписка

&Тест
Процедура БезСпискаЗаголовокНеЧитаетсяВовсе() Экспорт

	// заголовок пишет кто угодно: без названных оператором сетей верить ему нельзя
	Ожидаем.Что(Адреса.Определить("203.0.113.7", Заголовки("X-Forwarded-For", "1.2.3.4")),
		"адресом клиента остаётся адрес соединения").Равно("203.0.113.7");
	Ожидаем.Что(Прокси.Снимок().Количество(), "список пуст").Равно(0);

КонецПроцедуры

&Тест
Процедура НегодныйСписокДовериеСнимаетЦеликом() Экспорт

	// опечатка в середине списка оставила бы часть прокси недоверенными молча —
	// хаб читал бы заголовок не у всех своих, и адрес клиента зависел бы от того,
	// через какой прокси пришёл запрос
	Доверять("10.0.0.0/8, 10.0.0/8");

	Ожидаем.Что(Прокси.Снимок().Количество(), "битый список доверия не даёт").Равно(0);
	Ожидаем.Что(Прокси.Доверенный(Прокси.Снимок(), "10.0.0.1"),
		"и записи до опечатки тоже").ЭтоЛожь();
	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "1.2.3.4")),
		"заголовок не читается").Равно("10.0.0.1");

КонецПроцедуры

&Тест
Процедура СнимокПересобираетсяНаНовомЗначенииНастройки() Экспорт

	// снимок живёт до смены текста настройки: без сверки хаб держал бы список,
	// прочитанный однажды, и правка конфигурации не доезжала бы вовсе
	Доверять("10.0.0.0/8");
	Первый = Прокси.Снимок();
	Ожидаем.Что(Первый.Количество(), "прочитана одна сеть").Равно(1);
	Ожидаем.Что(Прокси.Доверенный(Первый, "10.0.0.1"), "и она действует").ЭтоИстина();

	Доверять("192.168.0.0/16, 172.16.0.0/12");
	Второй = Прокси.Снимок();

	Ожидаем.Что(Второй.Количество(), "снимок пересобран по новому значению").Равно(2);
	Ожидаем.Что(Прокси.Доверенный(Второй, "192.168.0.7"), "новая сеть действует").ЭтоИстина();
	Ожидаем.Что(Прокси.Доверенный(Второй, "10.0.0.1"), "прежняя больше нет").ЭтоЛожь();

	Ожидаем.Что(Прокси.Снимок().Количество(),
		"неизменное значение второй раз не разбирается, а отдаётся снимком").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СоСписком

&Тест
Процедура ЗаголовокЧитаетсяТолькоСДоверенногоСоединения() Экспорт

	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "198.51.100.9")),
		"с доверенного прокси — адрес человека").Равно("198.51.100.9");
	Ожидаем.Что(Адреса.Определить("203.0.113.7", Заголовки("X-Forwarded-For", "198.51.100.9")),
		"с недоверенного адреса заголовок игнорируется").Равно("203.0.113.7");

КонецПроцедуры

&Тест
Процедура ДоверенныйАдресУзнаётсяВЛюбойЗаписи() Экспорт

	Доверять("10.0.0.0/8, 2001:db8::/32");
	Свои = Прокси.Снимок();

	Ожидаем.Что(Прокси.Доверенный(Свои, "10.0.0.1"), "IPv4 своей сети").ЭтоИстина();
	Ожидаем.Что(Прокси.Доверенный(Свои, "::ffff:10.0.0.1"), "он же отображённым").ЭтоИстина();
	Ожидаем.Что(Прокси.Доверенный(Свои, "2001:DB8:0:1::5"), "IPv6 в верхнем регистре").ЭтоИстина();
	Ожидаем.Что(Прокси.Доверенный(Свои, "203.0.113.7"), "чужой адрес").ЭтоЛожь();
	Ожидаем.Что(Прокси.Доверенный(Свои, "не-адрес"), "не адрес доверия не получает").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ИзЦепочкиБерётсяПерваяСправаЗаписьНеСвоегоПрокси() Экспорт

	// всё левее найденной записи пишет сам клиент: прочитай хаб левую часть — и адрес
	// в журнале и в ведре ограничителя выбирал бы перебирающий
	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1",
			Заголовки("X-Forwarded-For", "5.5.5.5, 198.51.100.9, 10.0.0.9, 10.0.0.1")),
		"хвост своих прокси пропущен, левее найденной не читается").Равно("198.51.100.9");

КонецПроцедуры

&Тест
Процедура ЦепочкаИзОднихСвоихПроксиОставляетАдресСоединения() Экспорт

	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "10.0.0.9, 10.0.0.1")),
		"клиента в цепочке нет").Равно("10.0.0.1");

КонецПроцедуры

&Тест
Процедура НечитаемаяЦепочкаИПустойЗаголовокОставляютАдресСоединения() Экспорт

	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "не-адрес")),
		"нечитаемая запись").Равно("10.0.0.1");
	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "198.51.100.9, мусор")),
		"нечитаемая запись справа").Равно("10.0.0.1");
	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "")),
		"пустой заголовок").Равно("10.0.0.1");
	Ожидаем.Что(Адреса.Определить("10.0.0.1", Новый Соответствие()),
		"заголовка нет вовсе").Равно("10.0.0.1");

КонецПроцедуры

&Тест
Процедура АдресКлиентаПриводитсяККанону() Экспорт

	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "::ffff:198.51.100.9")),
		"отображённый IPv4 из заголовка").Равно("198.51.100.9");
	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "2001:DB8:1::1")),
		"верхний регистр IPv6").Равно("2001:db8:1::1");

КонецПроцедуры

&Тест
Процедура ИмяЗаголовкаЧитаетсяВЛюбомРегистре() Экспорт

	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("x-forwarded-for", "198.51.100.9")),
		"строчное имя заголовка").Равно("198.51.100.9");

КонецПроцедуры

#КонецОбласти

#Область ЗаписьЦепочки

&Тест
Процедура ПортВЗаписиЦепочкиОтбрасывается() Экспорт

	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Forwarded-For", "198.51.100.9:51423")),
		"IPv4 с портом").Равно("198.51.100.9");
	Ожидаем.Что(Адреса.Определить("10.0.0.1",
			Заголовки("X-Forwarded-For", "[2001:db8:1::1]:4711")),
		"IPv6 в скобках с портом").Равно("2001:db8:1::1");

КонецПроцедуры

&Тест
Процедура ДругихЗаголовковПересылкиХабНеЧитает() Экспорт

	// прокси, заполнивший только `Forwarded`, клиентский `X-Forwarded-For` не трогает:
	// прочитай хаб второй заголовок — и выбор адреса достался бы самому клиенту
	Доверять("10.0.0.0/8");

	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("Forwarded", "for=198.51.100.9")),
		"`Forwarded` не читается вовсе").Равно("10.0.0.1");
	Ожидаем.Что(Адреса.Определить("10.0.0.1", Заголовки("X-Real-IP", "198.51.100.9")),
		"и `X-Real-IP` тоже").Равно("10.0.0.1");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Процедура Доверять(Знач Сети)
	Настройки.Задать(Прокси.КлючНастройки(), Сети);
КонецПроцедуры

Функция ЛогТеста()
	Возврат Логирование.ПолучитьЛог("тест.oshub.адрес-клиента");
КонецФункции

Функция Заголовки(Знач Имя, Знач Значение)
	Результат = Новый Соответствие();
	Результат.Вставить(Имя, Значение);
	Возврат Результат;
КонецФункции

#КонецОбласти
