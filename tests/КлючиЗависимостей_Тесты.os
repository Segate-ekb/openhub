// Юнит-тесты канонического ключа зависимостей: строки, записанные сборками до его
// появления, дописываются последним шагом старта хаба, а вкладка показывает имя даже
// тогда, когда починка не отработала. Контейнер — слой данных на КоннектореInMemory;
// набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером
// раннера OneUnit.

#Использовать asserts
#Использовать autumn
// autumn-logos — единая точка входа логирования: у починки поле помечено &Лог
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем Поделка;
Перем Хранилище;       // ХранилищеЗависимостей — прикладной вход
Перем Запросы;         // ЗапросыЗависимостей — засев строк в обход хранилища
Перем Восстановление;  // ВосстановлениеКлючейЗависимостей
Перем ЭкранПакета;     // КонтроллерПакета — только чистая функция ИмяЦели
Перем СледующаяВерсия;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	СледующаяВерсия = 7000;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ФейкЗависимостиНедоступны");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.Подключить(КаталогМодулей, "ВосстановлениеКлючейЗависимостей");

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "ключи-зависимостей-тесты");

	Детальки = Новый Соответствие();
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Хранилище = Поделка.НайтиЖелудь("ХранилищеЗависимостей");
	Запросы = Поделка.НайтиЖелудь("ЗапросыЗависимостей");
	Восстановление = Поделка.НайтиЖелудь("ВосстановлениеКлючейЗависимостей");

	// Контроллер подключается ПОСЛЕ старта контейнера намеренно: ОСень собирает желуди
	// по известным ей типам, и появившийся позже контроллер желудём не станет. Здесь он
	// нужен не экраном, а носителем чистой функции ИмяЦели — поднимать ради неё хаб не за что.
	ПоискКлассов.Подключить(КаталогМодулей, "КонтроллерПакета");
	ЭкранПакета = ЭкранПакетаБезЖелудей();

КонецПроцедуры

// --- проверки ---

&Тест
Процедура ПочинкаКлючейЗарегистрирована() Экспорт
	Ожидаем.Что(Восстановление, "желудь ВосстановлениеКлючейЗависимостей").Существует();
КонецПроцедуры

// Пустая строка в ключе — как её оставляет бэкенд, где колонка есть, но не заполнена.
&Тест
Процедура СтрокаСПустымКлючомПолучаетКанон() Экспорт

	Версия = НоваяВерсия();
	ЗасеятьСтроку(Версия, "Winow", "");

	Ожидаем.Что(Восстановление.Восстановить(), "дописана ровно одна строка").Равно(1);

	Ожидаем.Что(Строка(Хранилище.ПоВерсии(Версия)[0].ИмяПакетаНижнийРегистр),
		"ключ выведен из написания автора").Равно("winow");
	Ожидаем.Что(Строка(Хранилище.ПоВерсии(Версия)[0].ИмяПакета),
		"а само написание не тронуто").Равно("Winow");

КонецПроцедуры

// Отсутствующий ключ — как его читает JSON-коннектор: не пустая строка, а Неопределено.
&Тест
Процедура СтрокаБезКлючаПолучаетКанон() Экспорт

	Версия = НоваяВерсия();
	ЗасеятьСтроку(Версия, "  Autumn  ");

	Ожидаем.Что(Восстановление.Восстановить(), "дописана ровно одна строка").Равно(1);

	Ожидаем.Что(Строка(Хранилище.ПоВерсии(Версия)[0].ИмяПакетаНижнийРегистр),
		"ключ выведен из написания автора без пробелов").Равно("autumn");

КонецПроцедуры

// Ради восстановления строка и заводилась: без ключа обратный граф её не находит.
&Тест
Процедура ВосстановленнаяСтрокаНаходитсяОбратнымГрафом() Экспорт

	Версия = НоваяВерсия();
	ЗасеятьСтроку(Версия, "Fzy", "");

	Ожидаем.Что(Хранилище.КтоЗависитОт("fzy").Количество(),
		"предпосылка: до восстановления строка обратному графу не видна").Равно(0);

	Восстановление.Восстановить();

	Ожидаем.Что(Хранилище.КтоЗависитОт("fzy").Количество(),
		"после восстановления строка найдена").Равно(1);
	Ожидаем.Что(Хранилище.КтоЗависитОт("FZY").Количество(),
		"и найдена в любом регистре").Равно(1);

КонецПроцедуры

// Восстановление правит ровно пустой ключ: чужое значение не его дело — иначе точечная
// починка превратилась бы в переписывание всей таблицы на каждом старте.
&Тест
Процедура ЗаполненныйКлючНеТрогается() Экспорт

	Версия = НоваяВерсия();
	ЗасеятьСтроку(Версия, "Semver", "чужой-ключ");

	Ожидаем.Что(Восстановление.Восстановить(), "трогать нечего").Равно(0);

	Ожидаем.Что(Строка(Хранилище.ПоВерсии(Версия)[0].ИмяПакетаНижнийРегистр),
		"заполненный ключ остался как был").Равно("чужой-ключ");

КонецПроцедуры

// Восстановление идемпотентно: хаб перезапускается сколько угодно раз.
&Тест
Процедура ПовторноеВосстановлениеНичегоНеМеняет() Экспорт

	Версия = НоваяВерсия();
	ЗасеятьСтроку(Версия, "Oint", "");
	Восстановление.Восстановить();

	Ожидаем.Что(Восстановление.Восстановить(), "второй проход не находит работы").Равно(0);
	Ожидаем.Что(Строка(Хранилище.ПоВерсии(Версия)[0].ИмяПакетаНижнийРегистр),
		"и ключ остался прежним").Равно("oint");
	Ожидаем.Что(Хранилище.ПоВерсии(Версия).Количество(),
		"дублей второй проход не наплодил").Равно(1);

КонецПроцедуры

// Имени нет вовсе — выводить ключ не из чего; такая строка молча остаётся как есть.
&Тест
Процедура СтрокаБезИмениОстаётсяБезКлюча() Экспорт

	Версия = НоваяВерсия();
	ЗасеятьСтроку(Версия, "   ", "");

	Ожидаем.Что(Восстановление.Восстановить(), "выводить ключ не из чего").Равно(0);
	Ожидаем.Что(ЗначениеЗаполнено(Хранилище.ПоВерсии(Версия)[0].ИмяПакетаНижнийРегистр),
		"ключ так и остался пустым").ЭтоЛожь();

КонецПроцедуры

// Починка идёт последним шагом старта, поэтому её сбой обязан остаться её сбоем:
// хаб без ключей работает ровно так, как работал до починки, и падать ему не за что.
&Тест
Процедура УпавшаяПочинкаВозвращаетНольИНеРонитСтарт() Экспорт

	Починка = Новый ВосстановлениеКлючейЗависимостей(Новый ФейкЗависимостиНедоступны());

	Сбой = "";
	Дописано = -1;
	Попытка
		Дописано = Починка.Восстановить();
	Исключение
		Сбой = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Сбой, "сбой базы наружу не пробрасывается: на нём стоит открытие порта").Равно("");
	Ожидаем.Что(Дописано, "и починка честно отвечает «дописано ноль строк»").Равно(0);

КонецПроцедуры

// Вторая сеть показа: канон пуст — имя выводится из написания автора манифеста прямо
// в ячейке. В боевой выдаче до неё не доходит (данные чинит старт), поэтому стережём
// её здесь, вызовом функции экрана.
&Тест
Процедура ЯчейкаВыводитИмяКогдаКанонПуст() Экспорт

	Ожидаем.Что(ЭкранПакета.ИмяЦели(СтрокаЗависимости("", "  Winow  ")),
		"пустой канон — имя выводится из написания автора").Равно("winow");
	Ожидаем.Что(ЭкранПакета.ИмяЦели(СтрокаЗависимости(Неопределено, "Autumn")),
		"отсутствующий канон — то же самое").Равно("autumn");
	// канон намеренно НЕ равен НРег(ИмяПакета): на паре ("winow", "Winow") обе ветки дают
	// один ответ, и выкинутая ветка канона осталась бы незамеченной
	Ожидаем.Что(ЭкранПакета.ИмяЦели(СтрокаЗависимости("совсем-другое", "Winow")),
		"заполненный канон берётся как есть, а не пересчитывается из имени").Равно("совсем-другое");

КонецПроцедуры

// --- служебное ---

// Строка зависимости в том виде, в каком её читает вкладка: ячейке нужны только два поля.
Функция СтрокаЗависимости(Знач Канон, Знач ИмяПакета)
	Возврат Новый Структура("ИмяПакетаНижнийРегистр, ИмяПакета", Канон, ИмяПакета);
КонецФункции

// ИмяЦели — чистая функция над строкой зависимости: ни одного желудя контроллера она
// не трогает, поэтому экран собирается пустым. Позиционных Неопределено ровно столько,
// сколько у контроллера параметров конструктора.
Функция ЭкранПакетаБезЖелудей()

	Возврат Новый КонтроллерПакета(
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		Неопределено);

КонецФункции

// Строка зависимости пишется МИМО ХранилищаЗависимостей: через него ключ вывелся бы
// сам, и восстанавливать было бы нечего. Ключ Неопределено — колонка не заполняется вовсе.
Функция ЗасеятьСтроку(Знач ВерсияИдентификатор, Знач ИмяПакета, Знач Ключ = Неопределено)

	Запись = Запросы.СоздатьЭлемент();
	Запись.ВерсияИдентификатор = ВерсияИдентификатор;
	Запись.ИмяПакета = ИмяПакета;
	Если Ключ <> Неопределено Тогда
		Запись.ИмяПакетаНижнийРегистр = Ключ;
	КонецЕсли;
	Запись.ВерсияМин = "";
	Запись.ВерсияМакс = "";
	Запись.ДляРазработки = Ложь;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция НоваяВерсия()
	СледующаяВерсия = СледующаяВерсия + 1;
	Возврат СледующаяВерсия;
КонецФункции
