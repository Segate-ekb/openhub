// Самодостаточный разбор базы стран: справочник кодов, ключ адреса, двоичный поиск
// по диапазонам и сборка индекса по CSV. Хаба здесь нет — только библиотека ip
// и примитивы платформы, ровно как и в самом подкаталоге «страна».

#Использовать asserts
#Использовать ip
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя
Перем Проба;          // фикстура БазаСтранПробная
Перем Порядок;        // ПорядокАдресов (гео)
Перем Сборка;         // СборкаИндексаСтран (гео)
Перем Песочница;      // временный каталог набора

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("БазаСтранПробная");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "гео", "Классы", "страна"));

КонецПроцедуры

&ПередКаждым
Процедура СобратьРазбор() Экспорт

	Проба = Новый БазаСтранПробная();
	Порядок = Новый ПорядокАдресов();
	Сборка = Новый СборкаИндексаСтран(Порядок);
	Песочница = УникальныеИмена.ВременныйКаталог("гео-индекс");

КонецПроцедуры

&ПослеКаждого
Процедура УбратьПесочницу() Экспорт
	УникальныеИмена.УбратьВременное(Песочница);
КонецПроцедуры

#Область СправочникКодов

&Тест
Процедура КодСтраныУзнаётсяВЛюбойЗаписиАМеткиНеизвестностиНет() Экспорт

	Коды = Новый КодыСтран();

	Ожидаем.Что(Коды.Канон(" ru "), "запись приводится к канону").Равно("RU");
	Ожидаем.Что(Коды.Канон("Ru"), "смешанный регистр").Равно("RU");
	Ожидаем.Что(Коды.ЭтоКодСтраны("de"), "страна узнана").ЭтоИстина();

	Ожидаем.Что(Коды.Канон("ZZ"), "«неизвестно» базы страной не становится").Равно("");
	Ожидаем.Что(Коды.Канон("XX"), "пользовательский код").Равно("");
	Ожидаем.Что(Коды.Канон("T1"), "метка выходного узла Tor").Равно("");
	Ожидаем.Что(Коды.Канон(""), "пустая запись").Равно("");
	Ожидаем.Что(Коды.Канон(Неопределено), "ничего").Равно("");
	Ожидаем.Что(Коды.Канон("RUS"), "три буквы — это alpha-3").Равно("");
	Ожидаем.Что(Коды.Канон("РУ"), "кириллица кодом не является").Равно("");

	Ожидаем.Что(Коды.Количество() > 200,
		СтрШаблон("кодов %1 — справочник ослеп", Коды.Количество())).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КлючАдреса

&Тест
Процедура КлючIPv6РазличаетСоседейНаГраницеПоловин() Экспорт

	// одно число на 128 бит в десятичном Числе OneScript не помещается, и соседи слиплись
	// бы в один ключ; пара половин держит 2^64 точно
	Младше = Порядок.КлючЗаписи("ffff:ffff:ffff:fffe:ffff:ffff:ffff:ffff");
	Старше = Порядок.КлючЗаписи("ffff:ffff:ffff:ffff::");

	Ожидаем.Что(Порядок.Сравнить(Младше, Старше), "соседи через границу половин различимы").Равно(-1);
	Ожидаем.Что(Порядок.Сравнить(Старше, Младше), "и в обратную сторону").Равно(1);
	Ожидаем.Что(Порядок.Сравнить(Старше, Порядок.КлючЗаписи("ffff:ffff:ffff:ffff:0:0:0:0")),
		"та же запись — тот же ключ").Равно(0);

	Ожидаем.Что(Младше.Младшие - Порядок.КлючЗаписи("ffff:ffff:ffff:fffe:ffff:ffff:ffff:fffe").Младшие,
		"младшая половина различает соседние адреса").Равно(1);
	Ожидаем.Что(Старше.Старшие - Младше.Старшие, "старшая половина различает соседние").Равно(1);

КонецПроцедуры

&Тест
Процедура КлючСравниваетАдресаПоЗначениюАНеПоЗаписи() Экспорт

	// «1.9.0.0» лексикографически больше «1.10.0.0» — сравнение строк дало бы неверный порядок
	Меньший = Порядок.КлючЗаписи("1.9.0.0");
	Больший = Порядок.КлючЗаписи("1.10.0.0");

	Ожидаем.Что(Порядок.Сравнить(Меньший, Больший), "девятка меньше десятки").Равно(-1);
	Ожидаем.Что(Меньший.Семейство, "семейство IPv4").Равно(Порядок.IPv4());
	Ожидаем.Что(Порядок.КлючЗаписи("::1").Семейство, "семейство IPv6").Равно(Порядок.IPv6());
	Ожидаем.Что(Порядок.КлючЗаписи("не-адрес"), "не адрес ключа не даёт").Равно(Неопределено);
	Ожидаем.Что(Порядок.КлючЗаписи(""), "пустая запись").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОтображённыйIPv4ПолучаетКлючIPv4() Экспорт

	// на полке IPv6 отображённый адрес попал бы в диапазон «::/…», которым база зовёт
	// неизвестность, и «95.213.7.7» через двойной стек стал бы «страна неизвестна»
	Отображённый = Порядок.КлючЗаписи("::ffff:95.213.7.7");

	Ожидаем.Что(Отображённый.Семейство, "семейство — IPv4").Равно(Порядок.IPv4());
	Ожидаем.Что(Порядок.Сравнить(Отображённый, Порядок.КлючЗаписи("95.213.7.7")),
		"и ключ тот же, что у голого IPv4").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПоискПоДиапазонам

&Тест
Процедура ПоискБерётГраницыДиапазонаИНеБерётСоседей() Экспорт

	Индекс = ПоПробной("RU,DE");

	Ожидаем.Что(Страна(Индекс, "95.213.0.0"), "первый адрес диапазона").Равно("RU");
	Ожидаем.Что(Страна(Индекс, "95.213.255.255"), "последний адрес диапазона").Равно("RU");
	Ожидаем.Что(Страна(Индекс, "95.212.255.255"), "на единицу левее").Равно("");
	Ожидаем.Что(Страна(Индекс, "95.214.0.0"), "на единицу правее — уже соседняя страна").Равно("DE");
	Ожидаем.Что(Страна(Индекс, "95.215.0.0"), "за соседней страной").Равно("");

КонецПроцедуры

&Тест
Процедура ПоискРаботаетИПоIPv6() Экспорт

	Индекс = ПоПробной("RU");

	Ожидаем.Что(Страна(Индекс, "2001:470:180f::"), "первый адрес диапазона IPv6").Равно("RU");
	Ожидаем.Что(Страна(Индекс, "2001:470:180f:ffff:ffff:ffff:ffff:ffff"),
		"последний адрес диапазона IPv6").Равно("RU");
	Ожидаем.Что(Страна(Индекс, "2001:470:180e:ffff:ffff:ffff:ffff:ffff"),
		"на единицу левее").Равно("");
	Ожидаем.Что(Страна(Индекс, "2001:470:1810::"), "на единицу правее").Равно("");
	Ожидаем.Что(Страна(Индекс, "2a02:6b8::1"), "второй диапазон IPv6").Равно("RU");

КонецПроцедуры

&Тест
Процедура ОтображённыйIPv4НаходитсяНаПолкеIPv4() Экспорт

	Индекс = ПоПробной("RU");

	Ожидаем.Что(Страна(Индекс, "::ffff:95.213.7.7"),
		"клиент IPv4 через двойной стек — та же страна").Равно("RU");

КонецПроцедуры

&Тест
Процедура ФайлБезНаблюдаемыхСтранДаётПустойИндекс() Экспорт

	Итог = Сборка.ПоФайлу(Проба.Путь(), Страны("JP"));

	Ожидаем.Что(Итог.Строк, "файл прочитан весь").Равно(14);
	Ожидаем.Что(Итог.Принято, "но взято ничего").Равно(0);
	Ожидаем.Что(Итог.Индекс.Диапазонов(), "индекс пуст").Равно(0);
	Ожидаем.Что(Страна(Итог.Индекс, "95.213.7.7"), "и ничего не находит").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СборкаПоФайлу

&Тест
Процедура НаблюдатьНечегоФайлНеОткрываетсяВовсе() Экспорт

	// путь заведомо несуществующий: откройся файл — сборка упала бы, а она молча пуста
	Итог = Сборка.ПоФайлу(ОбъединитьПути(Песочница, "такого-файла-нет.csv"), Новый Массив());

	Ожидаем.Что(Итог.Строк, "ни одной строки не прочитано").Равно(0);
	Ожидаем.Что(Итог.Индекс.Диапазонов(), "индекс пуст").Равно(0);

КонецПроцедуры

&Тест
Процедура БитаяСтрокаНеРоняетСборкуАСчитается() Экспорт

	Строчки = Новый Массив();
	Строчки.Добавить("95.213.0.0,95.213.255.255,RU");
	Строчки.Добавить("не-адрес,95.220.255.255,RU");
	Строчки.Добавить("95.230.0.0,не-адрес,RU");
	Строчки.Добавить("95.240.0.0,RU");
	Строчки.Добавить("95.250.255.255,95.250.0.0,RU");
	Строчки.Добавить("2a02:6b8::,95.250.0.0,RU");
	Путь = Проба.Написать(ОбъединитьПути(Песочница, "битая.csv"), Строчки);

	Итог = Сборка.ПоФайлу(Путь, Страны("RU"));

	Ожидаем.Что(Итог.Строк, "прочитаны все строки").Равно(6);
	Ожидаем.Что(Итог.Принято, "легла только целая").Равно(1);
	Ожидаем.Что(Итог.Битых, "пять отобранных хвостом не разобрались").Равно(5);
	Ожидаем.Что(Страна(Итог.Индекс, "95.213.7.7"), "целая строка работает").Равно("RU");
	Ожидаем.Что(Страна(Итог.Индекс, "95.240.0.1"), "битые в индекс не попали").Равно("");

КонецПроцедуры

&Тест
Процедура НесортированныйФайлСортируетсяИИщется() Экспорт

	Перемешанные = Новый Массив();
	Для Каждого Строчка Из Проба.Строки() Цикл
		Перемешанные.Вставить(0, Строчка);
	КонецЦикла;
	Путь = Проба.Написать(ОбъединитьПути(Песочница, "вперемешку.csv"), Перемешанные);

	Итог = Сборка.ПоФайлу(Путь, Страны("RU,DE"));

	Ожидаем.Что(Итог.Сортировали, "нарушенный порядок замечен и исправлен").ЭтоИстина();
	Ожидаем.Что(Страна(Итог.Индекс, "95.213.7.7"), "поиск IPv4 работает").Равно("RU");
	Ожидаем.Что(Страна(Итог.Индекс, "95.214.0.5"), "поиск соседней страны работает").Равно("DE");
	Ожидаем.Что(Страна(Итог.Индекс, "2a02:6b8::1"), "поиск IPv6 работает").Равно("RU");

КонецПроцедуры

&Тест
Процедура ОтсортированныйФайлНеПересортировывается() Экспорт

	Итог = Сборка.ПоФайлу(Проба.Путь(), Страны("RU,DE"));

	Ожидаем.Что(Итог.Сортировали, "файл пришёл в своём порядке").ЭтоЛожь();
	Ожидаем.Что(Итог.Индекс.ДиапазоновСемейства(Порядок.IPv4()), "полка IPv4").Равно(2);
	Ожидаем.Что(Итог.Индекс.ДиапазоновСемейства(Порядок.IPv6()), "полка IPv6").Равно(2);
	Ожидаем.Что(СтрСоединить(Итог.Индекс.Страны(), ","), "страны индекса")
		.Равно(?(Итог.Индекс.Страны()[0] = "RU", "RU,DE", "DE,RU"));

КонецПроцедуры

#КонецОбласти

#Область ГодностьФайла

&Тест
Процедура ПроверкаОтвергаетТоЧтоБазойНеЯвляется() Экспорт

	Проверка = Новый ПроверкаБазыСтран();

	Ожидаем.Что(Проверка.Проверить(Проба.Путь()).Годен,
		"десять строк базой мира не бывают").ЭтоЛожь();
	Ожидаем.Что(Проверка.Проверить(Проба.Путь(), 5).Годен,
		"а с порогом по себе — годна").ЭтоИстина();

	ТолькоIPv4 = Новый Массив();
	ТолькоIPv4.Добавить("95.213.0.0,95.213.255.255,RU");
	ТолькоIPv4.Добавить("95.214.0.0,95.214.255.255,DE");
	Ответ = Проверка.Проверить(Проба.Написать(ОбъединитьПути(Песочница, "без-v6.csv"),
		ТолькоIPv4), 1);
	Ожидаем.Что(Ответ.Годен, "база без IPv6 базой не является").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Ответ.Причина, "IPv6") > 0, "и причина названа: " + Ответ.Причина).ЭтоИстина();

	Страница = Новый Массив();
	Для Счёт = 1 По 20 Цикл
		Страница.Добавить("<html><body>503 Service Unavailable</body></html>");
	КонецЦикла;
	Ответ = Проверка.Проверить(Проба.Написать(ОбъединитьПути(Песочница, "страница.csv"),
		Страница), 1);
	Ожидаем.Что(Ответ.Годен, "страница ошибки чужого сервера базой не является").ЭтоЛожь();

	Ожидаем.Что(Проверка.Проверить(ОбъединитьПути(Песочница, "нет.csv"), 1).Годен,
		"файла нет").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ПоПробной(Знач Через)
	Возврат Сборка.ПоФайлу(Проба.Путь(), Страны(Через)).Индекс;
КонецФункции

Функция Страны(Знач Через)

	Результат = Новый Массив();
	Для Каждого Код Из СтрРазделить(Через, ",", Ложь) Цикл
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Страна(Знач Индекс, Знач Запись)
	Возврат Индекс.Страна(Порядок.КлючЗаписи(Запись));
КонецФункции

#КонецОбласти
