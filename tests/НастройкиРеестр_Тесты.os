// Сценарные тесты домена настроек: реестр, резолвер «конфиг → база → дефолт из кода», аудит.
// «Рестарт» моделируется новой поделкой ОСени на той же файловой БД.
// Создание собственных поделок отравляет поделку OneUnit — набор в отдельном процессе.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;
Перем КаталогМодулей;
Перем КаталогБД;      // файловая БД, общая для «рестартов» внутри одного теста

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура Подготовить() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПодключитьКаталог(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПодключитьКаталог(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПодключитьКаталог(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	// минимум observability/net для издателя событий и рогатки аудита (как в
	// ПубликацияСервис_Тесты): Телеметрия (no-op) + ГотовностьХаба (гейт задач рогаток)
	КаталогNet = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("сеть", "Классы"));
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПробХаба = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "БуферСпанов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПробХаба, "ГотовностьХаба.os"));

	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	РеестрФикстур.Подключить("ЖурналАудитаФайлом");
	РеестрФикстур.Подключить("ХранилищеНастроекВПамяти");
	РеестрФикстур.Подключить("ИздательНастроекЗаглушка");
	РеестрФикстур.Подключить("ХранилищеНастроекСВторымПотоком");
	РеестрФикстур.Подключить("ЧтениеНастроекПотоком");
	РеестрФикстур.Подключить("СбросНастройкиПотоком");

КонецПроцедуры

&ПередКаждым
Процедура СвежаяБаза() Экспорт
	КаталогБД = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-настройки-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогБД);
КонецПроцедуры

&ПослеКаждого
Процедура УбратьБазу() Экспорт
	Попытка
		УдалитьФайлы(КаталогБД);
	Исключение
		// уборка не критична
	КонецПопытки;
КонецПроцедуры

// --- резолвер: приоритет источников ---

&Тест
Процедура БезКонфигаИБазыДействуетДефолтИзКода() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "дефолт режима").Равно("open");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("дефолт");
	Ожидаем.Что(Настройки.Значение("oshub.publish.max_upload_bytes"), "дефолт лимита — число").Равно(26214400);
	Ожидаем.Что(Настройки.ФорсированаКонфигом("oshub.auth.registration.mode")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УстановкаЧерезДоменныйAPIДействуетСразу() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Настройки.Установить("oshub.auth.registration.mode", "invite", "root", "10.0.0.1");

	// действует сразу, у того же экземпляра, без пересборки чего-либо
	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode")).Равно("invite");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("база");

	// типизированная установка строкой нормализуется к типу
	Настройки.Установить("oshub.auth.token.cli_days", "600", "root");
	Ожидаем.Что(Настройки.Значение("oshub.auth.token.cli_days"), "строка приведена к числу").Равно(600);

КонецПроцедуры

&Тест
Процедура МутацииПишутсяВАудит() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Журнал = Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"));

	Настройки.Установить("oshub.auth.registration.mode", "disabled", "root", "10.0.0.2");

	Записи = Журнал.ПоОбъекту("настройка/oshub.auth.registration.mode");
	Ожидаем.Что(Записи.Количество() > 0, "изменение попало в журнал аудита").ЭтоИстина();
	Ожидаем.Что(Записи[0].Действие).Равно("настройка.изменена");
	Ожидаем.Что(Записи[0].Кто).Равно("root");
	Ожидаем.Что(Записи[0].АдресIP).Равно("10.0.0.2");
	Ожидаем.Что(СтрНайти(Записи[0].Детали, "disabled") > 0, "детали содержат новое значение").ЭтоИстина();

	Настройки.Сбросить("oshub.auth.registration.mode", "root");
	// обе записи ложатся в одну СЕКУНДУ (точность Даты) — порядок сортировки по времени
	// не определён, поэтому ищем действие, а не позицию
	Действия = Новый Массив();
	Для Каждого Запись Из Журнал.ПоОбъекту("настройка/oshub.auth.registration.mode") Цикл
		Действия.Добавить(Запись.Действие);
	КонецЦикла;
	Ожидаем.Что(Действия.Найти("настройка.сброшена") <> Неопределено,
		"сброс — отдельное действие журнала").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлючВКонфигеПобеждаетИПомечаетсяФорсированным() Экспорт

	// администратор ввёл значение в базу...
	Хаб = ПостроитьХаб(Неопределено);
	Хаб.НайтиЖелудь("СервисНастроек").Установить("oshub.auth.registration.mode", "invite", "root");

	// ...а затем «рестарт» с тем же ключом в конфиге: конфиг побеждает
	ХабСКонфигом = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки = ХабСКонфигом.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "конфиг сильнее базы").Равно("disabled");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("конфиг");
	Ожидаем.Что(Настройки.ФорсированаКонфигом("oshub.auth.registration.mode"),
		"помечена «форсировано конфигом» — UI заблокирует поле").ЭтоИстина();
	Ожидаем.Что(Настройки.Карточка("oshub.auth.registration.mode").Редактируемая).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УходКлючаИзКонфигаВозвращаетБазуБезЗаписейПриСтарте() Экспорт

	// 1. значение введено руками через доменный API — единственная запись в таблице
	Хаб1 = ПостроитьХаб(Неопределено);
	Хаб1.НайтиЖелудь("СервисНастроек").Установить("oshub.auth.registration.mode", "invite", "root");

	СнимокПосле1 = СнимокТаблицы(Хаб1);

	// 2. «рестарт» с ключом в конфиге: действует конфиг, база НЕ тронута
	Хаб2 = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки2 = Хаб2.НайтиЖелудь("СервисНастроек");
	Ожидаем.Что(Настройки2.Значение("oshub.auth.registration.mode")).Равно("disabled");

	Ожидаем.Что(СнимкиСовпадают(СнимокПосле1, СнимокТаблицы(Хаб2)),
		"конфиг НЕ скопирован в базу при старте под конфигом").ЭтоИстина();

	// 3. «рестарт» уже БЕЗ ключа в конфиге: всплывает значение базы...
	Хаб3 = ПостроитьХаб(Неопределено);
	Настройки3 = Хаб3.НайтиЖелудь("СервисНастроек");
	Ожидаем.Что(Настройки3.Значение("oshub.auth.registration.mode"),
		"после ухода ключа из конфига действует значение базы").Равно("invite");
	Ожидаем.Что(Настройки3.Источник("oshub.auth.registration.mode")).Равно("база");

	// ...и таблица прикладных настроек НЕ изменилась ни на байт: «молчаливого отката»
	// (как и молчаливой синхронизации) при старте не существует
	Ожидаем.Что(СнимкиСовпадают(СнимокПосле1, СнимокТаблицы(Хаб3)),
		"старт без ключа не оставил НИКАКИХ записей").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбросУдаляетЗаписьИВозвращаетДефолт() Экспорт

	// Б-2 ревью: семантику Сбросить держит именно удаление строки — проверяем и
	// действующее значение, и ТАБЛИЦУ (мутация «Сбросить без Удалить» обязана краснеть)
	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Таблица = Хаб.НайтиЖелудь("ХранилищеПрикладныхНастроек");

	Настройки.Установить("oshub.auth.registration.mode", "invite", "root");
	Ожидаем.Что(Таблица.Значение("oshub.auth.registration.mode"), "запись легла").Равно("invite");

	Настройки.Сбросить("oshub.auth.registration.mode", "root");

	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "действует дефолт").Равно("open");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("дефолт");
	Ожидаем.Что(Таблица.Значение("oshub.auth.registration.mode"), "запись удалена").Равно(Неопределено);
	Ожидаем.Что(Таблица.Все().Количество(), "таблица пуста").Равно(0);

КонецПроцедуры

&Тест
Процедура СбросПодКонфигомУбираетОстатокИОставляетКонфиг() Экспорт

	// остаточная запись базы под форсирующим конфигом: сброс её убирает, действующим
	// остаётся конфиг; после ухода ключа из конфига всплывает уже дефолт (базы нет)
	Хаб1 = ПостроитьХаб(Неопределено);
	Хаб1.НайтиЖелудь("СервисНастроек").Установить("oshub.auth.registration.mode", "invite", "root");

	Хаб2 = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки2 = Хаб2.НайтиЖелудь("СервисНастроек");
	Настройки2.Сбросить("oshub.auth.registration.mode", "root");

	Ожидаем.Что(Хаб2.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все().Количество(),
		"остаток базы убран").Равно(0);
	Ожидаем.Что(Настройки2.Значение("oshub.auth.registration.mode"), "конфиг действует").Равно("disabled");
	Ожидаем.Что(Настройки2.Источник("oshub.auth.registration.mode")).Равно("конфиг");

	Хаб3 = ПостроитьХаб(Неопределено);
	Ожидаем.Что(Хаб3.НайтиЖелудь("СервисНастроек").Источник("oshub.auth.registration.mode"),
		"после ухода ключа — дефолт, базы больше нет").Равно("дефолт");

КонецПроцедуры

&Тест
Процедура ФорсированнаяКонфигомНеПравитсяЧерезAPI() Экспорт

	// В-2 ревью, глава 14: форсированная конфигом настройка read-only — запись в базу
	// лишь обещала бы в аудите то, что не действует
	Хаб = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.registration.mode", "invite"),
		"установка форсированной — исключение").ЭтоИстина();

	Ожидаем.Что(Хаб.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все().Количество(),
		"отказ не оставил записей в базе").Равно(0);
	Ожидаем.Что(Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"))
		.ПоОбъекту("настройка/oshub.auth.registration.mode").Количество(),
		"отказ не пишет аудит изменения").Равно(0);
	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "конфиг нетронут").Равно("disabled");

КонецПроцедуры

// У настройки, чья правка — переход (предохранитель парольного входа, снос личных
// пространств), обычная запись значения отказывает: она сделала бы половину работы.
&Тест
Процедура КлючСМеханизмомПишетТолькоЕгоВладелец() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Ключ = "oshub.auth.password.enabled";

	Ожидаем.Что(Хаб.НайтиЖелудь("РеестрНастроек").МеханизмПравки(Ключ),
		"реестр называет владельца правки").Равно("СтражПарольногоВхода");

	Ожидаем.Что(Падает(Настройки, "Установить", Ключ, Ложь),
		"обычная запись значения — исключение").ЭтоИстина();
	Ожидаем.Что(Хаб.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все().Количество(),
		"отказ не оставил записей в базе").Равно(0);
	Ожидаем.Что(Настройки.Значение(Ключ), "и значения не тронул").ЭтоИстина();

	Ожидаем.Что(ПадаетМеханизмом(Настройки, Ключ, Ложь, "ПультЛичныхПространств"),
		"чужой механизм ключ не пишет").ЭтоИстина();
	Ожидаем.Что(Настройки.Значение(Ключ), "и после чужой попытки значение прежнее").ЭтоИстина();

	Настройки.УстановитьМеханизмом(Ключ, Ложь, "root", "СтражПарольногоВхода");
	Ожидаем.Что(Настройки.Значение(Ключ), "владелец правки её выполняет").ЭтоЛожь();
	Ожидаем.Что(Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"))
		.ПоОбъекту("настройка/" + Ключ).Количество(),
		"и она попадает в аудит, как любая другая").Равно(1);

КонецПроцедуры

&Тест
Процедура ИмяПеременнойОкруженияЭкранируетПодчёркивания() Экспорт

	// В-1 ревью: конвенция configor — "." → "_", а "_" ВНУТРИ сегмента → "__";
	// плюс явные исключения точки сборки
	Реестр = ПостроитьХаб(Неопределено).НайтиЖелудь("РеестрНастроек");

	Ожидаем.Что(Реестр.ПеременнаяОкружения("oshub.publish.max_upload_bytes"),
		"подчёркивания в сегментах удвоены").Равно("OSHUB_PUBLISH_MAX__UPLOAD__BYTES");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("oshub.auth.session.ttlseconds"),
		"односложные сегменты — без удвоений").Равно("OSHUB_AUTH_SESSION_TTLSECONDS");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("winow.Порт"),
		"спец-случай точки сборки").Равно("OSHUB_PORT");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("oshub.admin.password_file"),
		"спец-случай: имя переменной без удвоения").Равно("OSHUB_ADMIN_PASSWORD_FILE");

КонецПроцедуры

// --- границы API ---

&Тест
Процедура БутстрапНастройкаНеПравитсяЧерезAPI() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.storage.root", "/tmp/другое"),
		"bootstrap нельзя установить").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Сбросить", "oshub.storage.root", Неопределено),
		"bootstrap нельзя сбросить").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.нет.такого.ключа", "x"),
		"неизвестный ключ — исключение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВалидаторыОтвергаютНекорректныеЗначения() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.registration.mode", "banana"),
		"вне перечисления").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.session.ttlseconds", 0),
		"ниже минимума").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.publish.max_files", "не число"),
		"не число").ЭтоИстина();

	// отвергнутое значение не оставило следов: действует дефолт
	Ожидаем.Что(Настройки.Значение("oshub.auth.session.ttlseconds")).Равно(86400);
	Ожидаем.Что(Настройки.Источник("oshub.auth.session.ttlseconds")).Равно("дефолт");

КонецПроцедуры

&Тест
Процедура НепарсибельныйКонфигНеРонитЧтениеАДаётСледующийИсточник() Экспорт

	// мусор в конфиге (опечатка админа) не валит каждый запрос — резолвер
	// предупреждает в лог и отдаёт следующий источник (дефолт)
	Хаб = ПостроитьХаб(Деталька("oshub.auth.session.ttlseconds", "сутки"));
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.session.ttlseconds")).Равно(86400);
	Ожидаем.Что(Настройки.Источник("oshub.auth.session.ttlseconds")).Равно("дефолт");

КонецПроцедуры

// --- секретность ---

&Тест
Процедура СекретПомеченИНеОтдаётсяВОткрытыхПредставлениях() Экспорт

	Хаб = ПостроитьХаб(Деталька("oshub.admin.password", "сверх-секрет-42"));
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Реестр = Хаб.НайтиЖелудь("РеестрНастроек");

	Ожидаем.Что(Реестр.Описание("oshub.admin.password").Секрет, "секрет помечен в реестре").ЭтоИстина();

	// домен видит настоящее значение (им пользуется онбординг)
	Ожидаем.Что(Настройки.Значение("oshub.admin.password")).Равно("сверх-секрет-42");

	// открытые представления — только маска, и нигде в карточках нет сырого значения
	Карточка = Настройки.Карточка("oshub.admin.password");
	Ожидаем.Что(Карточка.Секрет).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Карточка.Значение), "сверх-секрет-42") = 0,
		"карточка не раскрывает секрет").ЭтоИстина();

	Для Каждого Одна Из Настройки.Карточки() Цикл
		Ожидаем.Что(СтрНайти(Строка(Одна.Значение), "сверх-секрет-42") = 0,
			СтрШаблон("карточка %1 не содержит секрета", Одна.Ключ)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КарточекРовноСтолькоСколькоКлючейРеестра() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Ожидаем.Что(Хаб.НайтиЖелудь("СервисНастроек").Карточки().Количество(),
		"по карточке на ключ — из них круг B рендерит экраны")
		.Равно(Хаб.НайтиЖелудь("РеестрНастроек").Ключи().Количество());

КонецПроцедуры

// --- скан: список настроек нигде не дублируется вне реестра ---

&Тест
Процедура ПрикладныеКлючиНеОбъявляютсяВнеРеестра() Экспорт

	// объявление настройки = аннотация &Деталька(Значение = "<ключ>"). Прикладной ключ,
	// объявленный в другом классе, — это второй список настроек с собственным дефолтом:
	// ровно то дублирование, которое запрещено: реестр — единственный источник
	Реестр = ПостроитьХаб(Неопределено).НайтиЖелудь("РеестрНастроек");

	Прикладные = Новый Соответствие();
	Для Каждого Ключ Из Реестр.Ключи() Цикл
		Если Реестр.ЭтоПрикладная(Ключ) Тогда
			Прикладные.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Прикладные.Количество() > 0, "прикладные ключи в реестре найдены").ЭтоИстина();

	Нарушители = Новый Массив();
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогМодулей, "*.os", Истина) Цикл
		Если ЭтоТаблицаОбъявлений(ФайлКласса.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ключ Из КлючиДеталек(ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя)) Цикл
			Если Прикладные.Получить(НРег(Ключ)) <> Неопределено Тогда
				Нарушители.Добавить(СтрШаблон("%1 (%2)", Ключ, ФайлКласса.Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"прикладной ключ объявлен деталькой вне таблиц реестра: у настройки завёлся второй"
		+ " источник значения, и правка из формы до него не доедет").Равно("");

КонецПроцедуры

&Тест
Процедура ЧитаемыеУРезолвераКлючиСуществуютВРеестре() Экспорт

	// опечатка в ключе у потребителя (`Настройки.Значение("oshub.тыpo")`) не должна
	// доживать до рантайма: каждый литерал, передаваемый резолверу, обязан быть
	// объявлен в реестре. Судим ЖИВЫМ реестром, а не текстом его файла: подстрока
	// в комментарии или в соседнем литерале зеленила бы сторож ни о чём
	Реестр = ПостроитьХаб(Неопределено).НайтиЖелудь("РеестрНастроек");

	Найдено = 0;
	Нарушители = Новый Массив();
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогМодулей, "*.os", Истина) Цикл
		Для Каждого Ключ Из КлючиИзВызововРезолвера(ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя)) Цикл
			Найдено = Найдено + 1;
			Если НЕ Реестр.Есть(Ключ) Тогда
				Нарушители.Добавить(СтрШаблон("%1 (%2)", Ключ, ФайлКласса.Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"ключ спрашивают у резолвера, а в реестре его нет").Равно("");
	Ожидаем.Что(Найдено > 0, "вызовы резолвера в src найдены (сканер жив)").ЭтоИстина();

КонецПроцедуры

// --- политика пароля и секреты ---

&Тест
Процедура ГраницыДлиныПароляНеПускаютДругДругаЗаСебя() Экспорт

	// ИСТ-ДОСТ-032: «минимум больше максимума» не сужает требование, а делает вход
	// невозможным. Пара сверяется на вводе, а не после того, как никто не смог войти
	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.password.min_length", 300),
		"минимум выше максимума не сохраняется").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.password.max_length", 4),
		"максимум ниже минимума не сохраняется").ЭтоИстина();

	// отвергнутое не оставило следов: политика прежняя, вход работает
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.min_length")).Равно(8);
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.max_length")).Равно(256);

	// годная пара принимается — иначе проверка запрещала бы вообще всё
	Настройки.Установить("oshub.auth.password.min_length", 12, "root");
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.min_length"),
		"годное значение сохраняется").Равно(12);
	Ожидаем.Что(Настройки.Источник("oshub.auth.password.min_length")).Равно("база");

КонецПроцедуры

&Тест
Процедура ВзаимноНегодныеГраницыДлиныИзКонфигаНеРонятЧтение() Экспорт

	// НФТ-НАСТ-001: пара, запирающая вход, приехала конфигурацией — хаб обязан отдать
	// страницу и действующие значения, а не уйти в вечный круг проверок друг друга
	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.auth.password.min_length", 300);
	Детальки.Вставить("oshub.auth.password.max_length", 256);
	Настройки = ПостроитьХаб(Детальки).НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.password.max_length"),
		"максимум из конфигурации действует").Равно(256);
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.min_length"),
		"негодный минимум отброшен в пользу умолчания").Равно(8);
	Ожидаем.Что(Настройки.Источник("oshub.auth.password.min_length")).Равно("дефолт");

КонецПроцедуры

&Тест
Процедура РедактируемыйСекретВводитсяНоНеЧитаетсяНиКарточкойНиАудитом() Экспорт

	// ИСТ-НАСТ-007 плюс НФТ-НАСТ-003 на РЕДАКТИРУЕМОМ ключе: прежний сторож секретности
	// стоял на нередактируемом и эту ветку не проходил вовсе
	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Журнал = Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"));

	Ожидаем.Что(Настройки.Карточка("oshub.mail.smtp.password").Редактируемая,
		"секрет без конфигурации правится из интерфейса").ЭтоИстина();

	Настройки.Установить("oshub.mail.smtp.password", "сверх-секрет-42", "root", "10.0.0.7");

	// домен видит настоящее значение — им пользуется отправка письма
	Ожидаем.Что(Настройки.Значение("oshub.mail.smtp.password")).Равно("сверх-секрет-42");

	Карточка = Настройки.Карточка("oshub.mail.smtp.password");
	Ожидаем.Что(СтрНайти(Строка(Карточка.Значение), "сверх-секрет-42") = 0,
		"карточка редактируемого секрета не раскрывает значения").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Карточка.Значение),
		"но состояние «задано» видно").ЭтоИстина();

	Записи = Журнал.ПоОбъекту("настройка/oshub.mail.smtp.password");
	Ожидаем.Что(Записи.Количество() > 0, "правка секрета попала в аудит").ЭтоИстина();
	Для Каждого Запись Из Записи Цикл
		Ожидаем.Что(СтрНайти(Строка(Запись.Детали), "сверх-секрет-42") = 0,
			"детали аудита не содержат секрета: " + Строка(Запись.Детали)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СекретПодКонфигуромИзИнтерфейсаНеПравится() Экспорт

	// путь для тех, кто не хочет держать секрет в базе: задал переменной окружения —
	// поле стало нередактируемым для всех
	Настройки = ПостроитьХаб(Деталька("oshub.mail.smtp.password", "из-окружения"))
		.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Карточка("oshub.mail.smtp.password").Редактируемая,
		"секрет из конфигурации не правится").ЭтоЛожь();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.mail.smtp.password", "из-формы"),
		"правка форсированного секрета — отказ").ЭтоИстина();

КонецПроцедуры

// --- расхождение «код читает / реестр объявляет» ---

&Тест
Процедура КаждыйКлючХабаЧитаемыйДеталькойОбъявленВРеестре() Экспорт

	// Сторож самого разрыва: пока его не было, мимо реестра набралось 68 значений —
	// их не видел и не правил никто. Инвариант проверяется ЗНАЧЕНИЕМ: ключ обязан
	// найтись у живого реестра, а не в тексте его файла
	Реестр = ПостроитьХаб(Неопределено).НайтиЖелудь("РеестрНастроек");
	Известные = ЗнаемоеВнеРеестра();

	Нарушители = Новый Массив();
	Найдено = 0;
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогМодулей, "*.os", Истина) Цикл
		Для Каждого Ключ Из КлючиДеталек(ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя)) Цикл
			Если НЕ ЭтоКлючХаба(Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Найдено = Найдено + 1;
			Если Реестр.Есть(Ключ) ИЛИ Известные.Получить(НРег(Ключ)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Нарушители.Добавить(СтрШаблон("%1 (%2)", Ключ, ФайлКласса.Имя));
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"код читает значение деталькой, а в реестре его нет: на экране настроек такого"
		+ " значения не будет ни в поле, ни карточкой. Объявите ключ в реестре либо"
		+ " (если он снимается) впишите его в ЗнаемоеВнеРеестра с причиной").Равно("");
	Ожидаем.Что(Найдено >= 100,
		СтрШаблон("деталечных ключей хаба найдено %1 при минимуме 100 — скан ослеп", Найдено))
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СписокЗнаемогоВнеРеестраНеПротух() Экспорт

	// Исключение само под сторожем: ключ, который уже сняли или уже объявили, обязан
	// уйти из списка — иначе список превращается в дыру, через которую разрыв нарастёт
	Реестр = ПостроитьХаб(Неопределено).НайтиЖелудь("РеестрНастроек");

	Читаемые = Новый Соответствие();
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогМодулей, "*.os", Истина) Цикл
		Для Каждого Ключ Из КлючиДеталек(ПрочитатьТекстФайла(ФайлКласса.ПолноеИмя)) Цикл
			Читаемые.Вставить(НРег(Ключ), Истина);
		КонецЦикла;
	КонецЦикла;

	Нарушители = Новый Массив();
	Для Каждого КиЗ Из ЗнаемоеВнеРеестра() Цикл
		Если Читаемые.Получить(КиЗ.Ключ) = Неопределено Тогда
			Нарушители.Добавить(КиЗ.Ключ + " — деталькой больше не читается: уберите из списка");
		ИначеЕсли Реестр.Есть(КиЗ.Ключ) Тогда
			Нарушители.Добавить(КиЗ.Ключ + " — уже объявлен в реестре: уберите из списка");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС), "список знаемого вне реестра протух")
		.Равно("");

КонецПроцедуры

&Тест
Процедура СканДеталекЧитаетКодАНеКомментарииИЛитералы() Экспорт

	// Самотест сканера: аннотация в комментарии и аннотация ВНУТРИ строкового литерала —
	// это текст, а не директива. Без этой проверки сторож выше и зеленел бы на образце,
	// и краснел на честном коде
	Образец = "// &Деталька(Значение = ""oshub.из.комментария"") — так писать нельзя" + Символы.ПС
		+ "	Текст = ""&Деталька(Значение = """"oshub.из.литерала"""")"";" + Символы.ПС
		+ "	&Деталька(Значение = ""oshub.настоящий.ключ"") _Знач = """"," + Символы.ПС
		+ "	Хвост = 1; // &Деталька(Значение = ""oshub.из.хвостового.комментария"")";

	Ключи = КлючиДеталек(Образец);

	Ожидаем.Что(СтрСоединить(Ключи, ","), "из образца прочитан ровно один ключ — настоящий")
		.Равно("oshub.настоящий.ключ");

КонецПроцедуры

&Тест
Процедура ПарнаяПроверкаБезЗначенияСоседаОтказываетсяГромко() Экспорт

	// Пара границ проверяется только вместе с соседом. Молчаливый пропуск такой проверки
	// внешне неотличим от исправной работы, а значит «минимум выше максимума» снова начнёт
	// сохраняться и запрёт вход — поэтому недобытый сосед обязан быть слышен
	Реестр = Новый РеестрНастроек(Новый ВидыПроверок(), Новый НастройкиПодсистем(Новый ВидыПроверок()));
	Описание = Реестр.Описание("oshub.auth.password.min_length");
	Валидатор = Новый ВалидаторНастроек();

	Ожидаем.Что(Валидатор.КлючСоседа(Описание), "паре назван её сосед")
		.Равно("oshub.auth.password.max_length");

	Отказ = "";
	Попытка
		Валидатор.Проверить(300, Описание, Неопределено);
	Исключение
		Отказ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Отказ),
		"проверка без значения соседа отказалась, а не пропустила значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "oshub.auth.password.max_length") > 0,
		"отказ называет ключ, значения которого не хватило: " + Отказ).ЭтоИстина();

КонецПроцедуры

// --- одновременная работа потоков ---

&Тест
Процедура ЧужойПотокЧитаетНастройкуПокаЕёЖеЧитаемЗдесь() Экспорт

	// Защита от второго круга парных валидаторов — состояние ОДНОГО разрешения. Пока она
	// жила полем желудя (а он один на процесс), поток фоновой задачи, спросивший ключ ровно
	// в тот момент, когда его читает поток запроса, получал вместо значения умолчание
	Ключ = "oshub.auth.password.min_length";

	Хранилище = Новый ХранилищеНастроекСВторымПотоком(Новый ХранилищеНастроекВПамяти());
	Хранилище.Положить(Ключ, 12);
	Настройки = РезолверНад(Хранилище);
	Хранилище.ПуститьПотокНаКлюче(Настройки, Ключ);

	Ожидаем.Что(Настройки.Значение(Ключ), "поток, начавший чтение, видит значение базы").Равно(12);
	Ожидаем.Что(Хранилище.ВторойПотокУспел(),
		"второй поток ответил, а не заперся под чужим замком").ЭтоИстина();
	Ожидаем.Что(Хранилище.ОтветВторогоПотока(),
		"второй поток видит то же значение базы, а не умолчание 8").Равно(12);

КонецПроцедуры

&Тест
Процедура ВосемьЧитателейРеестраПодСбрасывающимСоседомВидятОдноИТоЖе() Экспорт

	// Нагрузочный смок под боевой сценарий: на старте хаба фоновые задачи и поток запроса
	// читают настройки одновременно, а кэш значений базы — один на процесс. Испорченный
	// параллельной записью словарь виден отсюда падением, зависанием либо чужим значением
	Хранилище = Новый ХранилищеНастроекВПамяти();
	Хранилище.Установить("oshub.auth.password.min_length", 12, "тест", ТекущаяУниверсальнаяДата());
	Хранилище.Установить("oshub.auth.password.max_length", 200, "тест", ТекущаяУниверсальнаяДата());

	// эталон снимается ОТДЕЛЬНЫМ резолвером: у читающих потоков кэш пустой, как на старте
	Ожидания = ДействующиеЗначения(РезолверНад(Хранилище));
	Настройки = РезолверНад(Хранилище);

	// девятый поток сбрасывает по кругу ключи, которых в базе нет: сброс значения не меняет,
	// но выбивает ключ из кэша, и читатели переписывают кэш всё время смока — так под
	// нагрузкой оказывается и правка кэша, а не только чтение
	Уборщик = Новый СбросНастройкиПотоком(Настройки, КлючиБезЗначенияВБазе(Настройки, Хранилище), 600);

	Кругов = 300;
	Читатели = Новый Массив();
	Задания = Новый Массив();
	Для Номер = 1 По 8 Цикл
		Читатель = Новый ЧтениеНастроекПотоком(Настройки, Ожидания, Кругов);
		Читатели.Добавить(Читатель);
		Задания.Добавить(ФоновыеЗадания.Выполнить(Читатель, "Исполнить"));
	КонецЦикла;
	Задания.Добавить(ФоновыеЗадания.Выполнить(Уборщик, "Исполнить"));

	Доработали = 0;
	Для Каждого Задание Из Задания Цикл
		Если Задание.ОжидатьЗавершения(60000) Тогда
			Доработали = Доработали + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Доработали, "все девять потоков доработали до конца, ни один не завис").Равно(9);
	Ожидаем.Что(ЖалобыПотоков(Читатели), "потоки читали ровно то же, что спокойный резолвер")
		.Равно("");
	Ожидаем.Что(Уборщик.Жалоба(), "сброс под читателями прошёл без сбоя").Равно("");
	Ожидаем.Что(ПрочитаноПотоками(Читатели), "нагрузка отработана целиком (смок жив)")
		.Равно(8 * Кругов * Ожидания.Количество());

КонецПроцедуры

// --- служебное ---

// Резолвер настроек поверх готового хранилища: реестр свой, издатель и журнал — заглушки.
//
// Параметры:
//   Хранилище - Произвольный - реализация контракта ХранилищеПрикладныхНастроек.
//
// Возвращаемое значение:
//   СервисНастроек - резолвер со своим кэшем.
//
Функция РезолверНад(Знач Хранилище)

	Реестр = Новый РеестрНастроек(Новый ВидыПроверок(), Новый НастройкиПодсистем(Новый ВидыПроверок()));

	Возврат Новый СервисНастроек(Реестр, Хранилище, Новый ИздательНастроекЗаглушка(),
		Новый ИмяОбъектаАудита(), Новый ВалидаторНастроек());

КонецФункции

// Действующее значение каждой карточки реестра: эталон, с которым потоки сверяют прочитанное.
Функция ДействующиеЗначения(Знач Настройки)

	Результат = Новый Соответствие();
	Для Каждого Карточка Из Настройки.Карточки() Цикл
		Результат.Вставить(Карточка.Ключ, Настройки.Значение(Карточка.Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Прикладные ключи, которых в базе нет: их сброс идемпотентен и действующего значения
// не меняет — читатели обязаны видеть одно и то же и под сбрасывающим потоком.
Функция КлючиБезЗначенияВБазе(Знач Настройки, Знач Хранилище)

	Результат = Новый Массив();
	Для Каждого Карточка Из Настройки.Карточки() Цикл
		Если Карточка.Класс = "прикладная" И Хранилище.Значение(Карточка.Ключ) = Неопределено Тогда
			Результат.Добавить(Карточка.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЖалобыПотоков(Знач Читатели)

	Жалобы = Новый Массив();
	Для Каждого Читатель Из Читатели Цикл
		Если ЗначениеЗаполнено(Читатель.Жалоба()) Тогда
			Жалобы.Добавить(Читатель.Жалоба());
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Жалобы, Символы.ПС);

КонецФункции

Функция ПрочитаноПотоками(Знач Читатели)

	Итог = 0;
	Для Каждого Читатель Из Читатели Цикл
		Итог = Итог + Читатель.Прочитано();
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Поделка с контейнером домена настроек на файловой БД текущего теста.
//
// Параметры:
//   ДеталькиКонфига - Соответствие, Неопределено - «файл конфигурации» этого запуска.
//
Функция ПостроитьХаб(Знач ДеталькиКонфига)

	Детальки = ?(ДеталькиКонфига = Неопределено, Новый Соответствие(), ДеталькиКонфига);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторJSON");
	ИсточникДанных.Вставить("СтрокаСоединения", КаталогБД);
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	// корень хранилища — свой на прогон: под ним лежит файл журнала аудита
	Детальки.Вставить("oshub.storage.root", КаталогБД);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;

КонецФункции

Функция Деталька(Знач Ключ, Знач Значение)
	Детальки = Новый Соответствие();
	Детальки.Вставить(Ключ, Значение);
	Возврат Детальки;
КонецФункции

// Снимок таблицы прикладных настроек: Ключ|Значение|Обновлена|КемОбновлена построчно.
Функция СнимокТаблицы(Знач Поделка)

	Строки = Новый Массив();
	Для Каждого Запись Из Поделка.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все() Цикл
		Строки.Добавить(СтрШаблон("%1|%2|%3|%4",
			Запись.Ключ, Запись.Значение, XMLСтрока(Запись.Обновлена), Запись.КемОбновлена));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СнимкиСовпадают(Знач Снимок1, Знач Снимок2)
	Возврат Снимок1 = Снимок2 И ЗначениеЗаполнено(Снимок1);
КонецФункции

Функция Падает(Знач Настройки, Знач Метод, Знач Ключ, Знач Значение)

	Попытка
		Если Метод = "Установить" Тогда
			Настройки.Установить(Ключ, Значение, "тест");
		Иначе
			Настройки.Сбросить(Ключ, "тест");
		КонецЕсли;
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция ПадаетМеханизмом(Знач Настройки, Знач Ключ, Знач Значение, Знач Механизм)

	Попытка
		Настройки.УстановитьМеханизмом(Ключ, Значение, "тест", Механизм);
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Файлы, где ключ ОБЪЯВЛЯЕТСЯ: их детальки — сам реестр, а не второй его список.
Функция ЭтоТаблицаОбъявлений(Знач ИмяФайла)
	Возврат ИмяФайла = "РеестрНастроек.os" ИЛИ ИмяФайла = "НастройкиПодсистем.os";
КонецФункции

Функция ЭтоКлючХаба(Знач Ключ)
	Возврат Лев(НРег(СокрЛП(Строка(Ключ))), 6) = "oshub.";
КонецФункции

// Ключи, которые код читает деталькой, а реестр не объявляет, — и это ЗНАЕМО.
// Каждая строка — обещание снять ключ вместе с механизмом; список стережёт
// СписокЗнаемогоВнеРеестраНеПротух: сняли ключ или объявили — строка обязана уйти.
Функция ЗнаемоеВнеРеестра()

	Результат = Новый Соответствие();

	// резолв имён: движок канонизации остаётся ради судейства адреса апстрима (ИСТ-АПСТ-004),
	// вместе с ним уйдут и эти два ключа
	Результат.Вставить("oshub.webhooks.resolve_enabled", "движок канонизации уходит с ИСТ-АПСТ-004");
	Результат.Вставить("oshub.webhooks.resolve_timeout_sec", "там же");

	// прочее к сносу: у величины либо один источник правды на объекте, либо место в коде
	Результат.Вставить("oshub.jobs.stats_flush_interval_sec",
		"дубль oshub.stats.flush_interval_sec, остаётся тот");
	Результат.Вставить("oshub.pools.default", "основной пул назначается признаком на пуле");
	Результат.Вставить("oshub.publish.github.api", "адрес API GitHub зашивается в код");

	Возврат Результат;

КонецФункции

// Ключи деталек ИЗ КОДА: аннотация в комментарии и аннотация внутри строкового литерала —
// это текст, а не директива. Разбор посимвольный, потому что и то и другое встречается
// в дереве, а «просто найти подстроку» дало бы и ложный отказ, и ложную защиту.
Функция КлючиДеталек(Знач Текст)

	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Для Каждого Ключ Из КлючиДеталекСтроки(Строка_) Цикл
			Результат.Добавить(Ключ);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлючиДеталекСтроки(Знач Строка_)

	Результат = Новый Массив();
	Маркер = "&Деталька";
	ВЛитерале = Ложь;
	Ждём = Ложь;
	Накоплено = "";
	Поз = 1;

	Пока Поз <= СтрДлина(Строка_) Цикл
		Симв = Сред(Строка_, Поз, 1);
		Если ВЛитерале Тогда
			Если Симв = """" И Сред(Строка_, Поз, 2) = """""" Тогда
				Накоплено = Накоплено + """";
				Поз = Поз + 1;
			ИначеЕсли Симв = """" Тогда
				ВЛитерале = Ложь;
				Если Ждём Тогда
					Результат.Добавить(Накоплено);
					Ждём = Ложь;
				КонецЕсли;
				Накоплено = "";
			Иначе
				Накоплено = Накоплено + Симв;
			КонецЕсли;
		ИначеЕсли Сред(Строка_, Поз, 2) = "//" Тогда
			Прервать;
		ИначеЕсли Симв = """" Тогда
			ВЛитерале = Истина;
			Накоплено = "";
		ИначеЕсли Сред(Строка_, Поз, СтрДлина(Маркер)) = Маркер Тогда
			Ждём = Истина;
			Поз = Поз + СтрДлина(Маркер) - 1;
		КонецЕсли;
		Поз = Поз + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ключи из вызовов резолвера: Настройки.Значение("<ключ>") / .Установить("<ключ>", ….
Функция КлючиИзВызововРезолвера(Знач Текст)

	Результат = Новый Массив();
	Маркеры = СтрРазделить("Настройки.Значение(""|Настройки.Установить(""|Настройки.Сбросить(""", "|");
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Для Каждого Маркер Из Маркеры Цикл
			Позиция = СтрНайти(Строка_, Маркер);
			Если Позиция = 0 Тогда
				Продолжить;
			КонецЕсли;
			Остаток = Сред(Строка_, Позиция + СтрДлина(Маркер));
			Конец = СтрНайти(Остаток, """");
			Если Конец > 1 Тогда
				Результат.Добавить(Лев(Остаток, Конец - 1));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПрочитатьТекстФайла(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

Процедура ПодключитьКаталог(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить;
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры
