// Юнит-тесты презентационного слоя web-ui: экранирование, каркас страницы, санитизация README
// (РендерерREADME). Классы создаются напрямую; набор изолирован процессом.

#Использовать asserts
#Использовать oscript-md
#Использовать html-sanitizer
#Использовать "фикстуры"

Перем Каркас;          // КаркасСтраницы — корень страницы
Перем Экран;           // ЭкранированиеHTML
Перем РендерерREADME;  // экземпляр РендерерREADME
Перем Поиск;           // КлассыСлоя — resolver файла класса по имени (подкаталоги 6.B)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогКлассов = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	КаталогREADME = ОбъединитьПути(КаталогМодулей, "описания", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();

	Подключить(КаталогREADME, "РендерерREADME");

	// рендерер собирается из компонентов — граф зависимостей строит общая фикстура
	РеестрФикстур.Подключить("СборкаUI");
	Слой = Новый СборкаUI().Собрать(КаталогКлассов);
	Каркас = Слой.Каркас;
	Экран = Слой.Экран;

	РендерерREADME = Новый РендерерREADME();

КонецПроцедуры

&Тест
Процедура ЭкранированиеВырезаетСпецсимволы() Экспорт

	Результат = Экран.Экранировать("<b>a & b</b> ""q"" 'x'");

	Ожидаем.Что(СтрНайти(Результат, "<b>"), "угловые скобки экранированы").Равно(0);
	Ожидаем.Что(СтрНайти(Результат, "&lt;b&gt;") > 0, "экранированный тег присутствует").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Результат, "&amp;") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЭкранированиеНеопределеноДаётПустуюСтроку() Экспорт
	Ожидаем.Что(Экран.Экранировать(Неопределено)).Равно("");
КонецПроцедуры

&Тест
Процедура СтраницаБезКонтекстаПадаетНаРендере() Экспорт

	// рантайм-гейт: проверяется не только факт исключения, но и причина — ошибка обязана называть
	// лекарство (КонтекстСтраницы), иначе скан «все вызовы Страницы передают куки» обходится приманкой
	Поймано = Ложь;
	Попытка
		Каркас.Страница("Заголовок", "<p>тело</p>", Неопределено);
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "КонтекстСтраницы") > 0,
			"ошибка называет лекарство — сборку контекста").ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Поймано, "страница без контекста запроса — падение, а не молчание").ЭтоИстина();

	// структура БЕЗ поля КукиЗапроса — та же дыра: оформление читателя молча пропало бы
	Поймано = Ложь;
	Попытка
		Каркас.Страница("Заголовок", "<p>тело</p>", Новый Структура("Пользователь", Неопределено));
	Исключение
		Поймано = Истина;
	КонецПопытки;
	Ожидаем.Что(Поймано, "контекст без поля КукиЗапроса — тоже падение").ЭтоИстина();

	HTML = Каркас.Страница("Заголовок", "<p>тело</p>",
		Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Ожидаем.Что(СтрНайти(HTML, "<p>тело</p>") > 0, "с контекстом страница собирается").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтраницаСобираетКорректныйМакет() Экспорт

	HTML = Каркас.Страница("Заголовок", "<p>тело страницы</p>",
		Каркас.КонтекстСтраницы(Неопределено, Неопределено));

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<!DOCTYPE html>"), "документ начинается с doctype").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<title>Заголовок — OpenHub</title>") > 0, "заголовок вкладки").ЭтоИстина();
	// CSS уехал в статику с версионированным именем, инлайн остались только токены темы
	Ожидаем.Что(СтрНайти(HTML, "<style id=""токены-темы"">") > 0, "токены темы инлайном в <head>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "/static/openhub-") > 0, "версионированный CSS из статики").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "src=""http"), "скрипты только свои, без CDN").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "href=""http"), "стили и ссылки шапки только свои").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<p>тело страницы</p>") > 0, "содержимое вставлено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/packages""") > 0, "навигация на каталог").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СсылкаЭкранируетАдресИТекст() Экспорт

	HTML = Экран.Ссылка("/pool/pkg", "имя <script>");

	Ожидаем.Что(СтрНайти(HTML, "<script>"), "текст ссылки не содержит сырой тег").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "href=""/pool/pkg""") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СсылкаФильтруетОпаснуюСхемуURL() Экспорт

	// stored XSS через недоверенный URL: экранирование href не нейтрализует опасную схему — ссылка не рендерится
	ТАБ = Символы.Таб;
	ПС = Символы.ПС;
	Опасные = Новый Массив();
	Опасные.Добавить("javascript:alert('REPO')");
	Опасные.Добавить("JavaScript:alert(1)");
	Опасные.Добавить("  javascript:alert(1)");
	Опасные.Добавить("java" + ТАБ + "script:alert(1)");
	Опасные.Добавить(ПС + "javascript:alert(1)");
	Опасные.Добавить("data:text/html,<script>alert(1)</script>");
	Опасные.Добавить("vbscript:msgbox(1)");
	Опасные.Добавить("java&#09;script:alert(1)");   // сущность внутри схемы
	Опасные.Добавить("javascript&colon;alert(1)");  // сущность-двоеточие

	Для Каждого URL Из Опасные Цикл
		HTML = НРег(Экран.Ссылка(URL, "клик"));
		Ожидаем.Что(СтрНайти(HTML, "href"), СтрШаблон("нет href для ""%1""", URL)).Равно(0);
		Ожидаем.Что(СтрНайти(HTML, "javascript"), СтрШаблон("схема не просочилась для ""%1""", URL)).Равно(0);
		Ожидаем.Что(СтрНайти(HTML, "клик") > 0, "текст ссылки сохранён").ЭтоИстина();
	КонецЦикла;

	Безопасные = Новый Массив();
	Безопасные.Добавить("https://github.com/autumn-library/winow");
	Безопасные.Добавить("http://example.org/x?a=1#top");
	Безопасные.Добавить("mailto:dev@example.org");
	Безопасные.Добавить("/main/winow");
	Безопасные.Добавить("#section");

	Для Каждого URL Из Безопасные Цикл
		HTML = Экран.Ссылка(URL, "клик");
		Ожидаем.Что(СтрНайти(HTML, "<a href=") > 0, СтрШаблон("ссылка для ""%1""", URL)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ШапкаАнонимаПоказываетВойти() Экспорт

	// вызов без 3-го параметра — обратная совместимость: аноним
	HTML = Каркас.Страница("Каталог", "<p>тело</p>",
		Каркас.КонтекстСтраницы(Неопределено, Неопределено));

	Ожидаем.Что(СтрНайти(HTML, "href=""/login""") > 0, "ссылка Войти").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Войти<") > 0, "текст Войти").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Выйти"), "у анонима нет Выйти").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "/logout"), "у анонима нет формы выхода").Равно(0);

КонецПроцедуры

&Тест
Процедура ШапкаАвторизованногоПоказываетЛогинКабинетВыход() Экспорт

	HTML = Каркас.Страница("Каталог", "<p>тело</p>",
		Каркас.КонтекстСтраницы(Новый Структура("Логин", "alice"), Неопределено));

	Ожидаем.Что(СтрНайти(HTML, "alice") > 0, "логин пользователя в шапке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/me""") > 0, "ссылка в кабинет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/logout""") > 0, "форма выхода").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Выйти<") > 0, "кнопка Выйти").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Войти<"), "у авторизованного нет Войти").Равно(0);

КонецПроцедуры

&Тест
Процедура ЛогинВШапкеЭкранируется() Экспорт

	HTML = Каркас.Страница("Каталог", "<p>тело</p>",
		Каркас.КонтекстСтраницы(Новый Структура("Логин", "ev<il>&"), Неопределено));

	Ожидаем.Что(СтрНайти(HTML, "<il>"), "сырые угловые скобки логина вырезаны").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;il&gt;") > 0, "логин выведен экранированным").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РендерREADMEВырезаетXSS() Экспорт

	ИсходныйMD = "# Заголовок пакета" + Символы.ПС + Символы.ПС
		+ "[зло](javascript:alert('L'))" + Символы.ПС + Символы.ПС
		+ "![img](javascript:alert('I'))" + Символы.ПС + Символы.ПС
		+ "[обфускация](javascript&colon;alert('O'))" + Символы.ПС + Символы.ПС
		+ "<script>alert('S')</script>" + Символы.ПС + Символы.ПС
		+ "<img src=x onerror=""alert('E')"">" + Символы.ПС + Символы.ПС
		+ "<div onclick=""evil()"">клик</div>" + Символы.ПС + Символы.ПС
		+ "Обычный абзац.";

	HTML = НРег(РендерерREADME.ВБезопасныйHTML(ИсходныйMD));

	Ожидаем.Что(СтрНайти(HTML, "<script"), "тег script вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "javascript:"), "javascript-URL вырезаны").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "onerror"), "обработчик onerror вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "onclick"), "обработчик on* вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "заголовок пакета") > 0, "легитимный текст сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "обычный абзац") > 0, "текст абзаца сохранён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РендерREADMEВырезаетСыройHTMLДажеБезЭкранированияРендерера() Экспорт

	// oscript-md по умолчанию сам экранирует сырой HTML, поэтому вектор «<script> в README»
	// перекрыт дважды. Здесь снимается первый слой (пресет commonmark пропускает сырой HTML) —
	// проверяется, что README чист именно за счёт САНИТИЗАЦИИ, а не за счёт экранирования.
	ИсходныйMD = "<script>alert('S')</script>" + Символы.ПС + Символы.ПС
		+ "<img src=x onerror=""alert('E')"">" + Символы.ПС + Символы.ПС
		+ "<a href=""javascript:alert('L')"">клик</a>" + Символы.ПС + Символы.ПС
		+ "Обычный абзац.";

	Сырой = НРег(Markdown.ВHTML(ИсходныйMD, Markdown.НастройкиCommonMark()));
	Ожидаем.Что(СтрНайти(Сырой, "<script") > 0, "без санитизации скрипт дошёл бы до страницы").ЭтоИстина();

	HTML = НРег(Markdown.ВБезопасныйHTML(ИсходныйMD, Markdown.НастройкиCommonMark()));

	Ожидаем.Что(СтрНайти(HTML, "<script"), "тег script вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "alert('s')"), "тело скрипта удалено вместе с тегом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "onerror"), "обработчик onerror вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "javascript:"), "javascript-URL вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "обычный абзац") > 0, "текст абзаца сохранён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РендерREADMEОтдаётТаблицуGFMРазметкой() Экспорт

	ИсходныйMD = "| Пакет | Версия |" + Символы.ПС
		+ "| --- | ---: |" + Символы.ПС
		+ "| opm | 1.4.1 |" + Символы.ПС;

	HTML = РендерерREADME.ВБезопасныйHTML(ИсходныйMD);

	Ожидаем.Что(СтрНайти(HTML, "<table>") > 0, "таблица отрисована разметкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<th>Пакет</th>") > 0, "шапка таблицы на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td>opm</td>") > 0, "ячейка тела на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "align=""right""") > 0, "выравнивание колонки сохранено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "| --- |"), "разделитель таблицы не вывалился текстом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "| opm |"), "строка таблицы не вывалилась текстом").Равно(0);

КонецПроцедуры

&Тест
Процедура РендерREADMEОтдаётЗадачиЗачёркиваниеИАвтоссылку() Экспорт

	ИсходныйMD = "- [x] выпущено" + Символы.ПС
		+ "- [ ] в работе" + Символы.ПС + Символы.ПС
		+ "~~устарело~~" + Символы.ПС + Символы.ПС
		+ "https://hub.oscript.io/package/opm" + Символы.ПС;

	HTML = РендерерREADME.ВБезопасныйHTML(ИсходныйMD);

	Ожидаем.Что(СтрНайти(HTML, "type=""checkbox""") > 0, "чекбокс задачи дошёл до страницы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "checked=""""") > 0, "выполненная задача отмечена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "disabled=""""") > 0, "чекбокс некликабельный").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "[x]"), "скобочная запись задачи не вывалилась текстом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<del>устарело</del>") > 0, "зачёркивание отрисовано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "~~"), "тильды зачёркивания не вывалились текстом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<a href=""https://hub.oscript.io/package/opm""") > 0,
		"голый адрес стал ссылкой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РендерREADMEЧиститВредноеВнутриТаблицыИЗадач() Экспорт

	// теги GFM разрешены санитайзером — проверяется, что вместе с ними не проехало
	// вредное содержимое ячеек и что чекбокс не превратился в поле ввода
	ИсходныйMD = "| безопасно | вредно |" + Символы.ПС
		+ "| --- | --- |" + Символы.ПС
		+ "| ячейка | <script>alert('XSS-CELL')</script> |" + Символы.ПС
		+ "| <td onclick=""evil()"">клик</td> | [зло](javascript:alert('L')) |" + Символы.ПС + Символы.ПС
		+ "- [x] <input type=""text"" name=""pwd"" onfocus=""evil()""> задача" + Символы.ПС;

	HTML = НРег(РендерерREADME.ВБезопасныйHTML(ИсходныйMD));

	Ожидаем.Что(СтрНайти(HTML, "<script"), "script в ячейке не выжил тегом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0, "script остался безобидным текстом ячейки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "onclick="""), "обработчик в ячейке не выжил атрибутом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "onfocus="""), "обработчик у поля не выжил атрибутом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "javascript:"), "javascript-URL в ячейке вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "type=""text"""), "поле ввода из README не рисуется").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "type=""checkbox""") > 0, "чекбокс самой задачи на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td>ячейка</td>") > 0, "соседняя ячейка не пострадала").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РендерREADMEПустогоТекстаДаётПустуюСтроку() Экспорт
	Ожидаем.Что(РендерерREADME.ВБезопасныйHTML("")).Равно("");
	Ожидаем.Что(РендерерREADME.ВБезопасныйHTML(Неопределено)).Равно("");
КонецПроцедуры

// Путь к файлу класса ищет resolver КлассыСлоя: классы web-ui разложены по подкаталогам.
Процедура Подключить(Знач Каталог, Знач ИмяКласса)
	Поиск.Подключить(Каталог, ИмяКласса);
КонецПроцедуры
