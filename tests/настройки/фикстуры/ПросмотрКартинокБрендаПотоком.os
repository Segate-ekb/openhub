// Обработчик фонового задания: спрашивает картинки оформления так же, как рамка страницы и отдача
// /brand/{файл}, — имя по ключу и ключ по имени, — пока не выйдет срок; первую жалобу запоминает,
// судит набор.

Перем Служба;     // СервисБрендовыхАктивов
Перем Срок;       // Число - до какого момента (мс UTC) спрашивать
Перем Прочитано;  // Число - ответов без жалоб
Перем Жалоба;     // Строка - первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя либо чужого ответа; пустая строка — всё прочитанное сходится.
//
// Возвращаемое значение:
//  Строка - жалоба потока.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Сколько ответов поток получил без жалоб.
//
// Возвращаемое значение:
//  Число - ответов без жалоб.
//
Функция Прочитано() Экспорт
	Возврат Прочитано;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок И НЕ ЗначениеЗаполнено(Жалоба) Цикл
			СпроситьКартинки();
		КонецЦикла;
	Исключение
		Жалоба = "картинка оформления не прочиталась: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура СпроситьКартинки()

	Для Каждого Ключ Из Служба.Ключи() Цикл
		Жалоба = ЖалобаНаОтвет(Ключ);
		Если ЗначениеЗаполнено(Жалоба) Тогда
			Возврат;
		КонецЕсли;
		Прочитано = Прочитано + 1;
	КонецЦикла;

КонецПроцедуры

// Имя принадлежит спрошенной картинке, и по нему находится она же либо уже ничего.
Функция ЖалобаНаОтвет(Знач Ключ)

	Имя = Служба.ПубличноеИмя(Ключ);
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ СтрНачинаетсяС(Имя, Ключ + "-") Тогда
		Возврат СтрШаблон("картинка %1 получила имя чужой картинки ""%2""", Ключ, Имя);
	КонецЕсли;

	// между двумя вопросами картинку вправе сменить администратор — тогда адреса уже нет
	Найденный = Служба.КлючПоПубличномуИмени(Имя);
	Если Найденный <> Ключ И Найденный <> "" Тогда
		Возврат СтрШаблон("адрес ""%1"" картинки %2 привёл к картинке ""%3""", Имя, Ключ, Найденный);
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ПриСозданииОбъекта(Знач СлужбаКартинок, Знач МоментКонца)
	Служба = СлужбаКартинок;
	Срок = МоментКонца;
	Прочитано = 0;
	Жалоба = "";
КонецПроцедуры
