// Обработчик фонового задания: посетитель живого хаба открывает главную и тянет знак из шапки
// её адресом, пока не выйдет срок; первую жалобу запоминает, судит набор.

Перем Клиент;    // КлиентХаба — каждый запрос идёт своим соединением
Перем Срок;      // Число - до какого момента (мс UTC) ходить
Перем Запросов;  // Число - запросов с допустимым ответом
Перем Жалоба;    // Строка - первый недопустимый ответ или сбой; "" — всё отдано

// Жалоба потока: недопустимый ответ или сбой; пустая строка — каждый запрос отдан.
//
// Возвращаемое значение:
//  Строка - жалоба потока.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Сколько запросов получили допустимый ответ.
//
// Возвращаемое значение:
//  Число - запросов без жалоб.
//
Функция Запросов() Экспорт
	Возврат Запросов;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок И НЕ ЗначениеЗаполнено(Жалоба) Цикл
			ОткрытьГлавнуюИЗнак();
		КонецЦикла;
	Исключение
		Жалоба = "запрос посетителя упал: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ОткрытьГлавнуюИЗнак()

	Главная = Клиент.GET("/");
	Если НЕ ОтветДопустим(Главная, "/", "200") Тогда
		Возврат;
	КонецЕсли;

	Адрес = Клиент.ПослеМаркера(Клиент.Тело(Главная), "class=""brand__mark"" src=""", """");
	Если СтрНачинаетсяС(Адрес, "/brand/") Тогда
		// между двумя запросами администратор вправе сменить картинку — тогда адреса уже нет
		ОтветДопустим(Клиент.GET(Адрес), Адрес, "200,404");
	КонецЕсли;

КонецПроцедуры

Функция ОтветДопустим(Знач Ответ, Знач Адрес, Знач Допустимые)

	Если СтрРазделить(Допустимые, ",").Найти(Строка(Ответ.КодСостояния)) = Неопределено Тогда
		Жалоба = СтрШаблон("%1 ответил %2: %3", Адрес, Ответ.КодСостояния, Лев(Клиент.Тело(Ответ), 300));
		Возврат Ложь;
	КонецЕсли;

	Запросов = Запросов + 1;
	Возврат Истина;

КонецФункции

Процедура ПриСозданииОбъекта(Знач КлиентХаба, Знач МоментКонца)
	Клиент = КлиентХаба;
	Срок = МоментКонца;
	Запросов = 0;
	Жалоба = "";
КонецПроцедуры
