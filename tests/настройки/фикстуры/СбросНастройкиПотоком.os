// Обработчик фонового задания: по кругу сбрасывает ключи без значения в базе — значение не меняется,
// а кэш значений переписывается всё время смока.

Перем Настройки;  // СервисНастроек
Перем Ключи;      // Массив из Строка - ключи прикладных настроек, сбрасываемые по кругу
Перем Кругов;     // Число - сколько раз пройти все ключи
Перем Жалоба;     // Строка - сбой сброса; "" — поток отработал чисто

// Жалоба потока: текст сбоя; пустая строка — все сбросы прошли.
//
// Возвращаемое значение:
//  Строка - жалоба потока.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		Для Круг = 1 По Кругов Цикл
			Для Каждого Ключ Из Ключи Цикл
				Настройки.Сбросить(Ключ, "нагрузочный смок");
			КонецЦикла;
		КонецЦикла;
	Исключение
		Жалоба = "сброс настройки упал: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач СервисНастроек, Знач КлючиНастроек, Знач ЧислоКругов)
	Настройки = СервисНастроек;
	Ключи = КлючиНастроек;
	Кругов = ЧислоКругов;
	Жалоба = "";
КонецПроцедуры
