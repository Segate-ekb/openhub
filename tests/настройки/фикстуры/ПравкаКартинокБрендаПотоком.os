// Обработчик фонового задания: администратор по кругу загружает каждой картинке оформления новый
// файл и возвращает фирменную, пока не выйдет срок; первую жалобу запоминает, судит набор.

Перем Служба;   // СервисБрендовыхАктивов
Перем Срок;     // Число - до какого момента (мс UTC) править картинки
Перем Правок;   // Число - принятых загрузок и возвратов
Перем Жалоба;   // Строка - сбой или отказ правки; "" — поток отработал чисто

// Жалоба потока: текст сбоя либо отказа; пустая строка — все правки приняты.
//
// Возвращаемое значение:
//  Строка - жалоба потока.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Сколько правок поток успел сделать.
//
// Возвращаемое значение:
//  Число - принятых загрузок и возвратов.
//
Функция Правок() Экспорт
	Возврат Правок;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок И НЕ ЗначениеЗаполнено(Жалоба) Цикл
			ПравитьКруг();
		КонецЦикла;
	Исключение
		Жалоба = "правка картинки упала: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПравитьКруг()

	Для Каждого Ключ Из Служба.Ключи() Цикл
		// у каждого круга своё содержимое: новая картинка — новый адрес
		Картинка = ПолучитьДвоичныеДанныеИзСтроки(СтрШаблон("картинка %1 №%2", Ключ, Правок));
		Итог = Служба.Загрузить(Ключ, Картинка, "image/png", Ключ + ".png", "нагрузочный смок");
		Если НЕ Итог.Успех Тогда
			Жалоба = СтрШаблон("загрузка картинки %1 отвергнута: %2", Ключ, Итог.Причина);
			Возврат;
		КонецЕсли;
		Правок = Правок + 1;
	КонецЦикла;

	Для Каждого Ключ Из Служба.Ключи() Цикл
		Служба.Сбросить(Ключ, "нагрузочный смок");
		Правок = Правок + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач СлужбаКартинок, Знач МоментКонца)
	Служба = СлужбаКартинок;
	Срок = МоментКонца;
	Правок = 0;
	Жалоба = "";
КонецПроцедуры
