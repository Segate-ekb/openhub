// Заглушка ХранилищеБрендовыхАктивов в памяти под своим замком: её делят потоки нагрузочного смока,
// и сбоить в нём вправе только проверяемая служба, а не хранилище.

Перем Записи; // Соответствие: ключ -> Структура(Ключ, Содержимое, ТипКонтента, Отпечаток, Размер)
Перем Замок;  // БлокировкаРесурса

// Строка картинки.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ключ, Содержимое, ТипКонтента, Отпечаток, Размер; Неопределено,
//                            если картинку не загружали.
//
Функция Актив(Знач Ключ) Экспорт

	Замок.Заблокировать();
	Запись = Записи.Получить(Ключ);
	Замок.Разблокировать();

	Возврат Запись;

КонецФункции

// Записывает картинку: одна строка на ключ, повтор её заменяет.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//  Данные - ДвоичныеДанные - байты картинки.
//  ТипКонтента - Строка - тип отдачи.
//  Отпечаток - Строка - отпечаток содержимого.
//  Кто - Строка - автор записи.
//  Когда - Дата - момент записи.
//
Процедура Установить(Знач Ключ, Знач Данные, Знач ТипКонтента, Знач Отпечаток,
	Знач Кто, Знач Когда) Экспорт

	Запись = Новый Структура("Ключ, Содержимое, ТипКонтента, Отпечаток, Размер",
		Ключ, Данные, ТипКонтента, Отпечаток, Данные.Размер());

	Замок.Заблокировать();
	Записи.Вставить(Ключ, Запись);
	Замок.Разблокировать();

КонецПроцедуры

// Удаляет картинку; отсутствие строки не ошибка.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
Процедура Удалить(Знач Ключ) Экспорт

	Замок.Заблокировать();
	Записи.Удалить(Ключ);
	Замок.Разблокировать();

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Записи = Новый Соответствие();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
