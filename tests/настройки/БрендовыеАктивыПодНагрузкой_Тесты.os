// Картинки оформления под параллельными запросами: рамка каждой страницы и отдача /brand/{файл}
// спрашивают одну службу из многих потоков, пока администратор меняет картинки. Хранилище —
// заглушка в памяти под своим замком: сбоить здесь вправе только сама служба.

#Использовать asserts
#Использовать "../фикстуры"

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СервисБрендовыхАктивов");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ТипыКартинок");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");

	РеестрФикстур.Подключить("ХранилищеКартинокБрендаВПамяти");
	РеестрФикстур.Подключить("ИздательНастроекЗаглушка");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ПросмотрКартинокБрендаПотоком");
	РеестрФикстур.Подключить("ПравкаКартинокБрендаПотоком");

КонецПроцедуры

// Администратор меняет картинки, пока восемь потоков страниц и /brand/{файл} их спрашивают: ни один
// запрос не падает и не получает чужую картинку, а после правок служба отвечает то же, что поднятая
// заново, — рестарт не нужен.
&Тест
Процедура ПравкаКартинокПодНагрузкойНеЛомаетИхОтдачу() Экспорт

	Хранилище = Новый ХранилищеКартинокБрендаВПамяти();
	Служба = НоваяСлужба(Хранилище);
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 3000;

	Правщик = Новый ПравкаКартинокБрендаПотоком(Служба, Срок);
	Зрители = Новый Массив();
	Для Номер = 1 По 8 Цикл
		Зрители.Добавить(Новый ПросмотрКартинокБрендаПотоком(Служба, Срок));
	КонецЦикла;
	ДождатьсяПотоков(Зрители, Правщик);

	Ожидаем.Что(ЖалобыЗрителей(Зрители), "ни один запрос картинки не упал и не получил чужую")
		.Равно("");
	Ожидаем.Что(Правщик.Жалоба(), "каждая правка администратора принята").Равно("");
	Ожидаем.Что(Правщик.Правок() > 0, "администратор успел поправить картинки").ЭтоИстина();
	Ожидаем.Что(ПрочитаноЗрителями(Зрители) > 0, "страницы успели спросить картинки").ЭтоИстина();

	Знак = ПолучитьДвоичныеДанныеИзСтроки("знак после правок");
	Служба.Загрузить("logo", Знак, "image/png", "logo.png", "ольга-админ");
	Служба.Сбросить("favicon", "ольга-админ");

	ИмяЗнака = НоваяСлужба(Хранилище).ПубличноеИмя("logo");
	Ожидаем.Что(Служба.ПубличноеИмя("logo"), "знак — тот, что загрузили последним").Равно(ИмяЗнака);
	Ожидаем.Что(Служба.ПубличноеИмя("favicon"), "иконка — фирменная, как после сброса").Равно("");
	Ожидаем.Что(Служба.КлючПоПубличномуИмени(ИмяЗнака), "адрес знака ведёт к знаку").Равно("logo");
	Ожидаем.Что(ПолучитьBase64СтрокуИзДвоичныхДанных(Служба.Содержимое("logo")), "байты знака")
		.Равно(ПолучитьBase64СтрокуИзДвоичныхДанных(Знак));

КонецПроцедуры

#Область Служебное

// Служба над хранилищем со своим, пока пустым, кэшем — так её видит хаб сразу после старта.
Функция НоваяСлужба(Знач Хранилище)

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.ui.asset.max_bytes", 1048576);

	ИменаЖурнала = Новый ИмяОбъектаАудита();
	Возврат Новый СервисБрендовыхАктивов(Хранилище, Настройки, Новый ТипыКартинок(),
		Новый ИздательНастроекЗаглушка(), ИменаЖурнала,
		Новый СобытиеАудита(ИменаЖурнала, Новый ТекстJSON()));

КонецФункции

// С таймаутом: запертый поток краснит набор, а не вешает его.
Процедура ДождатьсяПотоков(Знач Зрители, Знач Правщик)

	Задания = Новый Массив();
	Для Каждого Зритель Из Зрители Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(Зритель, "Исполнить"));
	КонецЦикла;
	Задания.Добавить(ФоновыеЗадания.Выполнить(Правщик, "Исполнить"));

	Доработали = 0;
	Для Каждого Задание Из Задания Цикл
		Если Задание.ОжидатьЗавершения(60000) Тогда
			Доработали = Доработали + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Доработали, "все потоки доработали до конца, ни один не завис")
		.Равно(Задания.Количество());

КонецПроцедуры

Функция ЖалобыЗрителей(Знач Зрители)

	Жалобы = Новый Массив();
	Для Каждого Зритель Из Зрители Цикл
		Если ЗначениеЗаполнено(Зритель.Жалоба()) Тогда
			Жалобы.Добавить(Зритель.Жалоба());
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Жалобы, Символы.ПС);

КонецФункции

Функция ПрочитаноЗрителями(Знач Зрители)

	Всего = 0;
	Для Каждого Зритель Из Зрители Цикл
		Всего = Всего + Зритель.Прочитано();
	КонецЦикла;
	Возврат Всего;

КонецФункции

#КонецОбласти
