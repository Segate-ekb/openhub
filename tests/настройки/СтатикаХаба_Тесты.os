// Статика инсталляции: свои файлы и файлы кита под одним плоским пространством публичных имён —
// файла нет, два файла делят адрес, картинка не отдаётся.

#Использовать asserts
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем КаталогСтатики;
Перем Поставка;
Перем Место;
Перем Активы;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьСтатику() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогиПроекта.Модули(), "СтатикаХаба");

	Поставка = Новый СтатикаХаба();
	Место = Новый РаскладкаСтатики(Поставка);
	Активы = Новый АктивыСтатики(Место, Новый ОтпечаткиСтатики(Место));
	КаталогСтатики = Поставка.Каталог();

КонецПроцедуры

// Всё, что раздаётся по /static, лежит внутри своего корня и существует на диске:
// объявленный, но потерянный файл отдаётся 404-м, а страница продолжает на него ссылаться.
&Тест
Процедура ФайлыБелогоСпискаЛежатВнутриСвоихКорнейИСуществуют() Экспорт

	Беглецы = Новый Массив();

	Для Каждого КиЗ Из Активы.Файлы() Цикл

		Путь = Активы.ПутьНаДиске(КиЗ.Ключ);
		Если Путь = Неопределено Тогда
			Беглецы.Добавить(КиЗ.Ключ + " — в белом списке есть, пути на диске нет");
			Продолжить;
		КонецЕсли;

		Файл = Новый Файл(Путь);
		Если НЕ Файл.Существует() Тогда
			Беглецы.Добавить(КиЗ.Ключ + " — файла нет: " + Путь);
			Продолжить;
		КонецЕсли;

		Если НЕ СтрНачинаетсяС(Файл.ПолноеИмя, КаталогСтатики)
			И НЕ СтрНачинаетсяС(Файл.ПолноеИмя, Место.КаталогКита()) Тогда
			Беглецы.Добавить(КиЗ.Ключ + " — вне обоих каталогов статики: " + Файл.ПолноеИмя);
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Беглецы, Символы.ПС), "адреса статики без файла или мимо каталога")
		.Равно("");
	Ожидаем.Что(Активы.Файлы().Количество() >= 7,
		СтрШаблон("файлов в белом списке: %1", Активы.Файлы().Количество())).ЭтоИстина();

КонецПроцедуры

// Подкаталоги и два корня завели одну дыру: на диске путей много, а публичных имён — одно
// плоское пространство, потому что адрес односегментный. Два файла с одинаковым базовым
// именем молча затёрли бы друг друга в белом списке, и один из них перестал бы отдаваться.
&Тест
Процедура ПубличныеИменаФайловСтатикиУникальны() Экспорт

	Имена = Новый Соответствие();
	Столкновения = Новый Массив();

	Для Каждого КиЗ Из Активы.Раскладка() Цикл
		Публичное = Активы.ПубличноеИмя(КиЗ.Ключ);
		Прежний = Имена.Получить(Публичное);
		Если Прежний <> Неопределено Тогда
			Столкновения.Добавить(СтрШаблон("%1 — одно публичное имя у «%2» и «%3»",
				Публичное, Прежний, Активы.ОтносительныйПуть(КиЗ.Ключ)));
		КонецЕсли;
		Имена.Вставить(Публичное, Активы.ОтносительныйПуть(КиЗ.Ключ));
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Столкновения, Символы.ПС),
		"файлы статики делят одно публичное имя: адрес односегментный, и один из них"
			+ " перестанет отдаваться").Равно("");
	Ожидаем.Что(Имена.Количество()).Равно(Активы.Раскладка().Количество());

КонецПроцедуры

// Глифы, значки чужих сервисов и базовый лист стилей везёт кит: по адресу они отдаются
// из каталога библиотеки, а в статике инсталляции остаётся только лицо хаба.
&Тест
Процедура ОбщаяСтатикаПриезжаетКитомАЛицоХабаОстаётсяЕму() Экспорт

	Для Каждого Имя Из ФайлыБиблиотеки() Цикл
		Ожидаем.Что(СтрНачинаетсяС(Активы.ПутьНаДиске(Активы.ПубличноеИмя(Имя)),
			Место.КаталогКита()), "«" + Имя + "» отдаётся из каталога библиотеки").ЭтоИстина();
		Ожидаем.Что(Активы.ТипКонтента(Активы.ПубличноеИмя(Имя)) <> Неопределено,
			"и хаб его отдаёт").ЭтоИстина();
	КонецЦикла;

	Для Каждого Имя Из ФайлыИнсталляции() Цикл
		Ожидаем.Что(СтрНачинаетсяС(Активы.ПутьНаДиске(Активы.ПубличноеИмя(Имя)), КаталогСтатики),
			"«" + Имя + "» — лицо этого хаба, из его статики").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Базовый лист библиотеки — такой же файл статики, как остальные: свой отпечаток, свой
// адрес. Без него страница приехала бы вовсе без оформления примитивов.
&Тест
Процедура БазовыйЛистКитаОтдаётсяХабомПодСвоимАдресом() Экспорт

	Имя = Место.ФайлБазовогоЛиста();

	Ожидаем.Что(Активы.АдресБазовогоЛиста(), "адрес базового листа — адрес его файла")
		.Равно(Активы.Адрес(Имя));
	Ожидаем.Что(Активы.АдресБазовогоЛиста() = Активы.Адрес(Поставка.ФайлСтилей()),
		"у листа библиотеки и листа инсталляции адреса РАЗНЫЕ").ЭтоЛожь();
	Ожидаем.Что(Активы.ТипКонтента(Активы.ПубличноеИмя(Имя)), "отдаётся таблицей стилей")
		.Равно("text/css; charset=utf-8");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Файлы кита — по раскладке самой библиотеки, а не по своему списку.
Функция ФайлыБиблиотеки()

	Результат = Новый Массив();
	Для Каждого КиЗ Из Место.СвояРаскладка() Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Файлы, которые везёт этот хаб: его лицо и его поведение.
Функция ФайлыИнсталляции()

	Результат = Новый Массив();
	Результат.Добавить(Поставка.ФайлЗнака());
	Результат.Добавить(Поставка.ФайлИконки());
	Результат.Добавить(Поставка.ФайлСтилей());
	Результат.Добавить(Поставка.ФайлСкрипта());
	Возврат Результат;

КонецФункции

#КонецОбласти
