// Описание приложения отдаёт версии библиотек, от которых хаб зависит в рантайме, ровно как их
// называет packagedef: ожидание разбирается из packagedef своим разбором, а не у проверяемого.

#Использовать asserts
#Использовать packageinfo
#Использовать "../фикстуры"

Перем ТекстМанифеста;
Перем Описание;       // ОписаниеПриложения — проверяемое

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	ТекстМанифеста = Новый ИсходникиПроекта().Текст(ОбъединитьПути(КаталогиПроекта.Корень(), "packagedef"));

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "настройки", "Классы"), "ОписаниеПриложения");
	Описание = Новый ОписаниеПриложения();

КонецПроцедуры

&Тест
Процедура ВерсияЗависимостиСовпадаетСМанифестом() Экспорт

	Для Каждого Пакет Из СтрРазделить("autumn,winow,oscript-ui", ",") Цикл
		Ожидаемая = ЗависимостьМанифеста(Пакет);
		Ожидаем.Что(Ожидаемая, "самотест: packagedef называет " + Пакет).Заполнено();
		Ожидаем.Что(Описание.ВерсияЗависимости(Пакет), "версия " + Пакет).Равно(Ожидаемая);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЗависимостьРазработкиИЧужаяНеНазываются() Экспорт

	Ожидаем.Что(СтрНайти(ТекстМанифеста, ".РазработкаЗависитОт(""asserts"""), "самотест: asserts — для разработки")
		.Больше(0);
	Ожидаем.Что(Описание.ВерсияЗависимости("asserts"), "зависимость разработки в рантайме не названа").Равно("");
	Ожидаем.Что(Описание.ВерсияЗависимости("нет-такого-пакета"), "чужой пакет — пусто").Равно("");

КонецПроцедуры

Функция ЗависимостьМанифеста(Знач Пакет)

	Отбор = Новый РегулярноеВыражение("(?m)^[ \t]*\.ЗависитОт\(""" + Пакет + """,\s*""([^""]+)""\)");
	Совпадения = Отбор.НайтиСовпадения(ТекстМанифеста);
	Возврат ?(Совпадения.Количество() = 0, "", Совпадения[0].Группы[1].Значение);

КонецФункции
