// Домен настроек: реестр, резолвер «конфиг → база → умолчание», аудит правок; «рестарт» — новая
// поделка ОСени на той же файловой базе, поэтому набор в отдельном процессе.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;
Перем КаталогМодулей;
Перем КаталогБД;      // файловая БД, общая для «рестартов» внутри одного теста

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура Подготовить() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПодключитьКаталог(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьТаблицы(КаталогМодулей, "вход, настройки");
	ПодключитьКаталог(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПодключитьКаталог(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	// ГотовностьХаба — гейт задач рогаток: без желудя их бины не собираются
	КаталогПробХаба = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПробХаба, "ГотовностьХаба.os"));

	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	РеестрНастроекХаба.ПодключитьКлючиВсехПредметов(ПоискКлассов, КаталогМодулей);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ИменаПеременныхОкружения.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));
	// внешний адрес инсталляции: у него молчание резолвера видно пользователю
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "АдресИнстанса.os"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	РеестрФикстур.Подключить("ЖурналАудитаФайлом");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ХранилищеНастроекВПамяти");
	РеестрФикстур.Подключить("ИздательНастроекЗаглушка");
	РеестрФикстур.Подключить("ХранилищеНастроекСВторымПотоком");
	РеестрФикстур.Подключить("ЧтениеНастроекПотоком");
	РеестрФикстур.Подключить("СбросНастройкиПотоком");

КонецПроцедуры

&ПередКаждым
Процедура СвежаяБаза() Экспорт
	КаталогБД = УникальныеИмена.ВременныйКаталог("oshub-settings");
КонецПроцедуры

&ПослеКаждого
Процедура УбратьБазу() Экспорт
	УникальныеИмена.УбратьВременное(КаталогБД);
КонецПроцедуры

// --- резолвер: приоритет источников ---

&Тест
Процедура БезКонфигаИБазыДействуетДефолтИзКода() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "дефолт режима").Равно("open");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("дефолт");
	Ожидаем.Что(Настройки.Значение("oshub.publish.max_upload_bytes"), "дефолт лимита — число").Равно(26214400);
	Ожидаем.Что(Настройки.ФорсированаКонфигом("oshub.auth.registration.mode")).ЭтоЛожь();

КонецПроцедуры

// Три типизированные двери чтения — одна политика: незнакомый ключ не роняет подсистему,
// а отдаёт запасное значение. Своих Попытка/Исключение вокруг Значение() у служб нет.
&Тест
Процедура ТипизированноеЧтениеНеРоняетНаНезнакомомКлюче() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Текстом("oshub.auth.registration.mode"), "строка читается").Равно("open");
	Ожидаем.Что(Настройки.Текстом("oshub.нет.такого.ключа", "запасное"),
		"незнакомый ключ отдаёт запасной текст").Равно("запасное");
	Ожидаем.Что(Настройки.Текстом("oshub.нет.такого.ключа"),
		"без запасного — пустая строка").Равно("");

	Ожидаем.Что(Настройки.Целое("oshub.нет.такого.ключа", 42), "число берёт дефолт").Равно(42);
	Ожидаем.Что(Настройки.Флаг("oshub.нет.такого.ключа", Истина), "флаг берёт дефолт").ЭтоИстина();

	// число, прочитанное как текст, приезжает строкой: у двери один тип ответа
	Ожидаем.Что(Настройки.Текстом("oshub.publish.max_files"),
		"нестроковая настройка читается текстом").Равно("5000");

КонецПроцедуры

// Строка отладки «Настройка … = …, источник: …» звучит одна на ответ: неизменившийся молчит,
// пока живёт кэш значения, изменившийся звучит сразу.
&Тест
Процедура СтрокаОбИсточникеЗвучитНаЧтениеАНеНаКаждоеПопаданиеВКэш() Экспорт

	Ключ = "oshub.auth.registration.mode";
	Настройки = ПостроитьХаб(Неопределено).НайтиЖелудь("СервисНастроек");
	Ловушка = ОтладкуНастроекВЛовушку();

	Для Номер = 1 По 20 Цикл
		Настройки.Значение(Ключ);
	КонецЦикла;

	Ожидаем.Что(СколькоРаз(Ловушка.Всё(), Ключ),
		"двадцать чтений подряд — одна строка об источнике: " + Ловушка.Всё()).Равно(1);

	// КОНТРОЛЬ: молчит не журнал целиком, а повтор одного ключа — у соседа своя строка
	Настройки.Значение("oshub.api.page_size");
	Ожидаем.Что(СколькоРаз(Ловушка.Всё(), "oshub.api.page_size"),
		"КОНТРОЛЬ: у соседнего ключа своя строка").Равно(1);

	Настройки.Установить(Ключ, "disabled", "root");
	Настройки.Значение(Ключ);

	Ожидаем.Что(Ловушка.Всё(), "новое значение названо сразу, а не по сроку кэша")
		.Содержит("= disabled");

	ВернутьУровеньНастроек();

КонецПроцедуры

// Вторая причина сказать — истёкший срок кэша; ждём настоящие пять секунд боевого срока.
&Тест
Процедура СтрокаОбИсточникеЗвучитСноваПоИстеченииСрокаКэша() Экспорт

	Ключ = "oshub.auth.registration.mode";
	Настройки = ПостроитьХаб(Неопределено).НайтиЖелудь("СервисНастроек");
	Ловушка = ОтладкуНастроекВЛовушку();

	Настройки.Значение(Ключ);
	Ожидаем.Что(СколькоРаз(Ловушка.Всё(), Ключ), "первое чтение прозвучало").Равно(1);

	Приостановить(5200); // срок кэша значения — 5 с

	// значение то же и источник тот же: сказать заставляет ИМЕННО истёкший срок
	Настройки.Значение(Ключ);
	Ожидаем.Что(СколькоРаз(Ловушка.Всё(), Ключ),
		"по истечении срока строка звучит снова: " + Ловушка.Всё()).Равно(2);

	ВернутьУровеньНастроек();

КонецПроцедуры

// Нижняя граница — забота вызывающего, а не реестра: ключ, которому реестр разрешает ноль,
// у потребителя с частотой в знаменателе превратился бы в холостой цикл.
&Тест
Процедура НижняяГраницаЧисловогоЧтенияСильнееНуляИзНастройки() Экспорт

	Ключ = "oshub.publish.inbox.max_pending_per_pool";
	Настройки = ПостроитьХаб(Деталька(Ключ, "0")).НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Целое(Ключ, 50), "без границы ноль настройки доезжает как есть")
		.Равно(0);
	Ожидаем.Что(Настройки.Целое(Ключ, 50, 1), "с границей единица сильнее нуля настройки")
		.Равно(1);

	// граница действует и на запасное число: дефолт ниже неё поднимается к ней
	Ожидаем.Что(Настройки.Целое("oshub.нет.такого.ключа", 0, 1),
		"граница поднимает и запасное число").Равно(1);

КонецПроцедуры

// Ключи частоты фонового цикла и размера страницы объявлены с минимумом: ноль из конфигурации
// до резолвера не доходит.
&Тест
Процедура РеестрОтвергаетНольВЧастотеИРазмереСтраницы() Экспорт

	Нули = Новый Соответствие();
	Нули.Вставить("oshub.webhooks.delivery_interval_sec", "0");
	Нули.Вставить("oshub.webhooks.max_queue", "0");
	Нули.Вставить("oshub.webhooks.test_max_per_hour", "0");
	Нули.Вставить("oshub.api.page_size", "0");
	Нули.Вставить("oshub.api.page_max", "0");
	Настройки = ПостроитьХаб(Нули).НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Целое("oshub.webhooks.delivery_interval_sec", 5, 1),
		"пауза между кругами доставки не обнуляется").Равно(5);
	Ожидаем.Что(Настройки.Целое("oshub.webhooks.max_queue", 10000, 1),
		"очередь доставки не схлопывается в ноль").Равно(10000);
	Ожидаем.Что(Настройки.Целое("oshub.webhooks.test_max_per_hour", 100, 1),
		"потолок проб не запрещает пробы вовсе").Равно(100);
	Ожидаем.Что(Настройки.Целое("oshub.api.page_size", 20, 1),
		"страница API не становится пустой").Равно(20);
	Ожидаем.Что(Настройки.Целое("oshub.api.page_max", 200, 1),
		"потолок страницы API тоже").Равно(200);

КонецПроцедуры

&Тест
Процедура УстановкаЧерезДоменныйAPIДействуетСразу() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Настройки.Установить("oshub.auth.registration.mode", "invite", "root", "10.0.0.1");

	// действует сразу, у того же экземпляра, без пересборки чего-либо
	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode")).Равно("invite");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("база");

	// типизированная установка строкой нормализуется к типу
	Настройки.Установить("oshub.auth.token.cli_days", "600", "root");
	Ожидаем.Что(Настройки.Значение("oshub.auth.token.cli_days"), "строка приведена к числу").Равно(600);

КонецПроцедуры

// Изменённая настройка — веха уровня хаба строкой службы: ключ, источник и кто; значение в строку
// не идёт — у секретной его нет и в деталях аудита.
&Тест
Процедура ИзменениеНастройкиВидноНаИнформацииБезЗначения() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(Логирование.ПолучитьЛог("СервисНастроек"), УровниЛога.Информация);
	Попытка
		Настройки.Установить("oshub.auth.registration.mode", "invite", "root-veha", "10.0.0.3");
	Исключение
		Ловушка.Снять();
		ВызватьИсключение;
	КонецПопытки;
	Ловушка.Снять();

	Ожидаем.Что(Ловушка.Всё(), "правка названа ключом и словом: " + Ловушка.Всё())
		.Содержит("Настройка ""oshub.auth.registration.mode"" изменена");
	Ожидаем.Что(Ловушка.Всё(), "и тем, кто правил").Содержит("root-veha");
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "invite"), "а значения нет").Равно(0);

КонецПроцедуры

&Тест
Процедура МутацииПишутсяВАудит() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Журнал = Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"));

	Настройки.Установить("oshub.auth.registration.mode", "disabled", "root", "10.0.0.2");

	Записи = Журнал.ПоОбъекту("настройка/oshub.auth.registration.mode");
	Ожидаем.Что(Записи.Количество() > 0, "изменение попало в журнал аудита").ЭтоИстина();
	Ожидаем.Что(Записи[0].Действие).Равно("настройка.изменена");
	Ожидаем.Что(Записи[0].Кто).Равно("root");
	Ожидаем.Что(Записи[0].АдресIP).Равно("10.0.0.2");
	Ожидаем.Что(ДеталиЗаписи(Хаб, Записи[0]).Получить("стало"),
		"детали называют новое значение: " + Строка(Записи[0].Детали)).Равно("disabled");

	Настройки.Сбросить("oshub.auth.registration.mode", "root");
	// обе записи ложатся в одну СЕКУНДУ (точность Даты) — порядок сортировки по времени
	// не определён, поэтому ищем действие, а не позицию
	Действия = Новый Массив();
	Для Каждого Запись Из Журнал.ПоОбъекту("настройка/oshub.auth.registration.mode") Цикл
		Действия.Добавить(Запись.Действие);
	КонецЦикла;
	Ожидаем.Что(Действия.Найти("настройка.сброшена") <> Неопределено,
		"сброс — отдельное действие журнала").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлючВКонфигеПобеждаетИПомечаетсяФорсированным() Экспорт

	// администратор ввёл значение в базу...
	Хаб = ПостроитьХаб(Неопределено);
	Хаб.НайтиЖелудь("СервисНастроек").Установить("oshub.auth.registration.mode", "invite", "root");

	// ...а затем «рестарт» с тем же ключом в конфиге: конфиг побеждает
	ХабСКонфигом = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки = ХабСКонфигом.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "конфиг сильнее базы").Равно("disabled");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("конфиг");
	Ожидаем.Что(Настройки.ФорсированаКонфигом("oshub.auth.registration.mode"),
		"помечена «форсировано конфигом» — UI заблокирует поле").ЭтоИстина();
	Ожидаем.Что(Настройки.Карточка("oshub.auth.registration.mode").Редактируемая).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УходКлючаИзКонфигаВозвращаетБазуБезЗаписейПриСтарте() Экспорт

	// 1. значение введено руками через доменный API — единственная запись в таблице
	Хаб1 = ПостроитьХаб(Неопределено);
	Хаб1.НайтиЖелудь("СервисНастроек").Установить("oshub.auth.registration.mode", "invite", "root");

	СнимокПосле1 = СнимокТаблицы(Хаб1);

	// 2. «рестарт» с ключом в конфиге: действует конфиг, база НЕ тронута
	Хаб2 = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки2 = Хаб2.НайтиЖелудь("СервисНастроек");
	Ожидаем.Что(Настройки2.Значение("oshub.auth.registration.mode")).Равно("disabled");

	Ожидаем.Что(СнимкиСовпадают(СнимокПосле1, СнимокТаблицы(Хаб2)),
		"конфиг НЕ скопирован в базу при старте под конфигом").ЭтоИстина();

	// 3. «рестарт» уже БЕЗ ключа в конфиге: всплывает значение базы...
	Хаб3 = ПостроитьХаб(Неопределено);
	Настройки3 = Хаб3.НайтиЖелудь("СервисНастроек");
	Ожидаем.Что(Настройки3.Значение("oshub.auth.registration.mode"),
		"после ухода ключа из конфига действует значение базы").Равно("invite");
	Ожидаем.Что(Настройки3.Источник("oshub.auth.registration.mode")).Равно("база");

	// ...и таблица прикладных настроек НЕ изменилась ни на байт: «молчаливого отката»
	// (как и молчаливой синхронизации) при старте не существует
	Ожидаем.Что(СнимкиСовпадают(СнимокПосле1, СнимокТаблицы(Хаб3)),
		"старт без ключа не оставил НИКАКИХ записей").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбросУдаляетЗаписьИВозвращаетДефолт() Экспорт

	// сброс удаляет строку: проверяется и действующее значение, и таблица
	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Таблица = Хаб.НайтиЖелудь("ХранилищеПрикладныхНастроек");

	Настройки.Установить("oshub.auth.registration.mode", "invite", "root");
	Ожидаем.Что(Таблица.Значение("oshub.auth.registration.mode"), "запись легла").Равно("invite");

	Настройки.Сбросить("oshub.auth.registration.mode", "root");

	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "действует дефолт").Равно("open");
	Ожидаем.Что(Настройки.Источник("oshub.auth.registration.mode")).Равно("дефолт");
	Ожидаем.Что(Таблица.Значение("oshub.auth.registration.mode"), "запись удалена").Равно(Неопределено);
	Ожидаем.Что(Таблица.Все().Количество(), "таблица пуста").Равно(0);

КонецПроцедуры

&Тест
Процедура СбросПодКонфигомУбираетОстатокИОставляетКонфиг() Экспорт

	// остаточная запись базы под форсирующим конфигом: сброс её убирает, действующим
	// остаётся конфиг; после ухода ключа из конфига всплывает уже дефолт (базы нет)
	Хаб1 = ПостроитьХаб(Неопределено);
	Хаб1.НайтиЖелудь("СервисНастроек").Установить("oshub.auth.registration.mode", "invite", "root");

	Хаб2 = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки2 = Хаб2.НайтиЖелудь("СервисНастроек");
	Настройки2.Сбросить("oshub.auth.registration.mode", "root");

	Ожидаем.Что(Хаб2.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все().Количество(),
		"остаток базы убран").Равно(0);
	Ожидаем.Что(Настройки2.Значение("oshub.auth.registration.mode"), "конфиг действует").Равно("disabled");
	Ожидаем.Что(Настройки2.Источник("oshub.auth.registration.mode")).Равно("конфиг");

	Хаб3 = ПостроитьХаб(Неопределено);
	Ожидаем.Что(Хаб3.НайтиЖелудь("СервисНастроек").Источник("oshub.auth.registration.mode"),
		"после ухода ключа — дефолт, базы больше нет").Равно("дефолт");

КонецПроцедуры

&Тест
Процедура ФорсированнаяКонфигомНеПравитсяЧерезAPI() Экспорт

	// форсированная конфигом настройка не правится: запись обещала бы в аудите недействующее
	Хаб = ПостроитьХаб(Деталька("oshub.auth.registration.mode", "disabled"));
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.registration.mode", "invite"),
		"установка форсированной — исключение").ЭтоИстина();

	Ожидаем.Что(Хаб.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все().Количество(),
		"отказ не оставил записей в базе").Равно(0);
	Ожидаем.Что(Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"))
		.ПоОбъекту("настройка/oshub.auth.registration.mode").Количество(),
		"отказ не пишет аудит изменения").Равно(0);
	Ожидаем.Что(Настройки.Значение("oshub.auth.registration.mode"), "конфиг нетронут").Равно("disabled");

КонецПроцедуры

// У настройки, чья правка — переход (предохранитель парольного входа, снос личных
// пространств), обычная запись значения отказывает: она сделала бы половину работы.
&Тест
Процедура КлючСМеханизмомПишетТолькоЕгоВладелец() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Ключ = "oshub.auth.password.enabled";

	Ожидаем.Что(Хаб.НайтиЖелудь("РеестрНастроек").МеханизмПравки(Ключ),
		"реестр называет владельца правки").Равно("СтражПарольногоВхода");

	Ожидаем.Что(Падает(Настройки, "Установить", Ключ, Ложь),
		"обычная запись значения — исключение").ЭтоИстина();
	Ожидаем.Что(Хаб.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все().Количество(),
		"отказ не оставил записей в базе").Равно(0);
	Ожидаем.Что(Настройки.Значение(Ключ), "и значения не тронул").ЭтоИстина();

	Ожидаем.Что(ПадаетМеханизмом(Настройки, Ключ, Ложь, "ПультЛичныхПространств"),
		"чужой механизм ключ не пишет").ЭтоИстина();
	Ожидаем.Что(Настройки.Значение(Ключ), "и после чужой попытки значение прежнее").ЭтоИстина();

	Настройки.УстановитьМеханизмом(Ключ, Ложь, "root", "СтражПарольногоВхода");
	Ожидаем.Что(Настройки.Значение(Ключ), "владелец правки её выполняет").ЭтоЛожь();
	Ожидаем.Что(Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"))
		.ПоОбъекту("настройка/" + Ключ).Количество(),
		"и она попадает в аудит, как любая другая").Равно(1);

КонецПроцедуры

&Тест
Процедура ИмяПеременнойОкруженияЭкранируетПодчёркивания() Экспорт

	// Конвенция configor — "." → "_", а "_" ВНУТРИ сегмента → "__"; у ключа, которого
	// из оболочки не набрать, карточка называет псевдоним из закрытого списка
	Реестр = ПостроитьХаб(Неопределено).НайтиЖелудь("РеестрНастроек");

	Ожидаем.Что(Реестр.ПеременнаяОкружения("oshub.publish.max_upload_bytes"),
		"подчёркивания в сегментах удвоены").Равно("OSHUB_PUBLISH_MAX__UPLOAD__BYTES");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("oshub.auth.session.ttlseconds"),
		"односложные сегменты — без удвоений").Равно("OSHUB_AUTH_SESSION_TTLSECONDS");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("oshub.admin.password_file"),
		"исторического имени больше нет: только конвенция").Равно("OSHUB_ADMIN_PASSWORD__FILE");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("winow.Порт"),
		"кириллица в ключе — псевдоним").Равно("OSHUB_PORT");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("otel.entity.query-text"),
		"дефис в ключе — псевдоним").Равно("OTEL_ENTITY_QUERY_TEXT");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("otel.entity.repository.enabled"),
		"соседние ключи идут конвенцией").Равно("OTEL_ENTITY_REPOSITORY_ENABLED");

КонецПроцедуры

// --- границы API ---

&Тест
Процедура БутстрапНастройкаНеПравитсяЧерезAPI() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.storage.root", "/tmp/другое"),
		"bootstrap нельзя установить").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Сбросить", "oshub.storage.root", Неопределено),
		"bootstrap нельзя сбросить").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.нет.такого.ключа", "x"),
		"неизвестный ключ — исключение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВалидаторыОтвергаютНекорректныеЗначения() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.registration.mode", "banana"),
		"вне перечисления").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.session.ttlseconds", 0),
		"ниже минимума").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.publish.max_files", "не число"),
		"не число").ЭтоИстина();

	// незнакомое слово в булевой настройке — ОТКАЗ, а не молчаливое «выключено»: иначе
	// опечатка админа гасила бы механизм, о котором он думал, что включил его
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.ui.show_name", "ага"),
		"незнакомое слово булевым не становится").ЭтоИстина();
	Ожидаем.Что(Настройки.Значение("oshub.ui.show_name"),
		"и прежнее значение не тронуто").ЭтоИстина();
	Настройки.Установить("oshub.ui.show_name", "нет", "root");
	Ожидаем.Что(Настройки.Значение("oshub.ui.show_name"),
		"КОНТРОЛЬ: знакомое слово лжи принимается").ЭтоЛожь();

	// отвергнутое значение не оставило следов: действует дефолт
	Ожидаем.Что(Настройки.Значение("oshub.auth.session.ttlseconds")).Равно(86400);
	Ожидаем.Что(Настройки.Источник("oshub.auth.session.ttlseconds")).Равно("дефолт");

КонецПроцедуры

// Отвергнутый адрес инсталляции громок и называет ключ: без него хаб собирает ссылки
// по заголовку Host клиента.
&Тест
Процедура НечитаемыйАдресИнсталляцииГромокИОставляетХабБезСвоегоАдреса() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	ЛогНастроек = Логирование.ПолучитьЛог("СервисНастроек");
	ЛогНастроек.УстановитьУровень(УровниЛога.Предупреждение);
	ЛогНастроек.ДобавитьСпособВывода(Ловушка);

	// разрыв строки в адресе валидатор не принимает — источник «конфиг» отвергнут
	Хаб = ПостроитьХаб(Деталька("oshub.instance.url",
		"https://хаб.example" + Символы.ВК + Символы.ПС + "X-Evil: 1"));
	Адрес = Хаб.НайтиЖелудь("АдресИнстанса");

	Ожидаем.Что(Адрес.Задан(),
		"адрес инсталляции не задан — ссылку соберут по заголовку Host").ЭтоЛожь();
	Ожидаем.Что(Адрес.Базовый(), "и он пуст").Равно("");
	Ожидаем.Что(Ловушка.Всё(), "в журнале названа сама настройка")
		.Содержит("oshub.instance.url");

	// КОНТРОЛЬ: годный адрес читается и хаб знает себя
	Годный = ПостроитьХаб(Деталька("oshub.instance.url", "https://хаб.example"))
		.НайтиЖелудь("АдресИнстанса");
	Ожидаем.Что(Годный.Базовый(), "КОНТРОЛЬ: годный адрес читается").Равно("https://хаб.example");

КонецПроцедуры

// Хвостовой слеш в адресе инсталляции админ пишет постоянно, и без снятия он уезжает
// в каждую производную ссылку: redirect_uri с «//» провайдер входа не узнаёт, и вход ломается.
&Тест
Процедура ХвостовойСлешАдресаИнстансаВПроизводныеСсылкиНеУезжает() Экспорт

	Адрес = ПостроитьХаб(Деталька("oshub.instance.url", "https://хаб.example/"))
		.НайтиЖелудь("АдресИнстанса");

	Ожидаем.Что(Адрес.Базовый(), "адрес хранится без хвостового слеша")
		.Равно("https://хаб.example");
	Ожидаем.Что(Адрес.АдресВозврата(), "redirect_uri собран одним слешем")
		.Равно("https://хаб.example/oidc/callback");
	Ожидаем.Что(СтрНайти(Адрес.АдресВозврата(), "example//"),
		"двойного слеша в производной ссылке нет").Равно(0);

	// сама нормализация снимает слеши все, сколько бы их ни было, и обрамляющие пробелы
	Ожидаем.Что(Адрес.Нормализовать("  https://хаб.example///  "),
		"слеши снимаются все, пробелы по краям тоже").Равно("https://хаб.example");

КонецПроцедуры

&Тест
Процедура НепарсибельныйКонфигНеРонитЧтениеАДаётСледующийИсточник() Экспорт

	// мусор в конфиге (опечатка админа) не валит каждый запрос — резолвер
	// предупреждает в лог и отдаёт следующий источник (дефолт)
	Хаб = ПостроитьХаб(Деталька("oshub.auth.session.ttlseconds", "сутки"));
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.session.ttlseconds")).Равно(86400);
	Ожидаем.Что(Настройки.Источник("oshub.auth.session.ttlseconds")).Равно("дефолт");

КонецПроцедуры

// --- секретность ---

&Тест
Процедура СекретПомеченИНеОтдаётсяВОткрытыхПредставлениях() Экспорт

	Хаб = ПостроитьХаб(Деталька("oshub.admin.password", "сверх-секрет-42"));
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Реестр = Хаб.НайтиЖелудь("РеестрНастроек");

	Ожидаем.Что(Реестр.Описание("oshub.admin.password").Секрет, "секрет помечен в реестре").ЭтоИстина();

	// домен видит настоящее значение (им пользуется онбординг)
	Ожидаем.Что(Настройки.Значение("oshub.admin.password")).Равно("сверх-секрет-42");

	// открытые представления — только маска, и нигде в карточках нет сырого значения
	Карточка = Настройки.Карточка("oshub.admin.password");
	Ожидаем.Что(Карточка.Секрет).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Карточка.Значение), "сверх-секрет-42") = 0,
		"карточка не раскрывает секрет").ЭтоИстина();

	Для Каждого Одна Из Настройки.Карточки() Цикл
		Ожидаем.Что(СтрНайти(Строка(Одна.Значение), "сверх-секрет-42") = 0,
			СтрШаблон("карточка %1 не содержит секрета", Одна.Ключ)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Ключи S3 — детальки реестра, то есть живут на экране настроек и в API: секретность
// объявляется по одной настройке, и сторож соседнего ключа её не подтверждает.
&Тест
Процедура КлючиS3ПомеченыСекретомИНеОтдаютсяВОткрытыхПредставлениях() Экспорт

	Секреты = Новый Соответствие();
	Секреты.Вставить("oshub.storage.s3.access_key", "ключ-доступа-s3-" + Строка(Новый УникальныйИдентификатор));
	Секреты.Вставить("oshub.storage.s3.secret_key", "секретный-ключ-s3-" + Строка(Новый УникальныйИдентификатор));
	Детальки = Новый Соответствие();
	Для Каждого Секрет Из Секреты Цикл
		Детальки.Вставить(Секрет.Ключ, Секрет.Значение);
	КонецЦикла;

	Хаб = ПостроитьХаб(Детальки);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Реестр = Хаб.НайтиЖелудь("РеестрНастроек");

	Для Каждого Секрет Из Секреты Цикл

		Ожидаем.Что(Реестр.Описание(Секрет.Ключ).Секрет, "секрет помечен в реестре: " + Секрет.Ключ)
			.ЭтоИстина();
		Ожидаем.Что(Настройки.Значение(Секрет.Ключ), "самотест: значение дошло до хаба — " + Секрет.Ключ)
			.Равно(Секрет.Значение);

		Карточка = Настройки.Карточка(Секрет.Ключ);
		Ожидаем.Что(Карточка.Секрет, "карточка названа секретной: " + Секрет.Ключ).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Строка(Карточка.Значение), Секрет.Значение) = 0,
			"карточка не раскрывает " + Секрет.Ключ).ЭтоИстина();

		Для Каждого Одна Из Настройки.Карточки() Цикл
			Ожидаем.Что(СтрНайти(Строка(Одна.Значение), Секрет.Значение) = 0,
				СтрШаблон("карточка %1 не содержит значения %2", Одна.Ключ, Секрет.Ключ)).ЭтоИстина();
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КарточекРовноСтолькоСколькоКлючейРеестра() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Ожидаем.Что(Хаб.НайтиЖелудь("СервисНастроек").Карточки().Количество(),
		"по карточке на ключ — из них круг B рендерит экраны")
		.Равно(Хаб.НайтиЖелудь("РеестрНастроек").Ключи().Количество());

КонецПроцедуры

// Экран настроек хаба и GET настроек API собирают карточки на КАЖДУЮ отрисовку,
// а прикладных ключей в реестре десятки: вопрос на ключ делал бы цену экрана их числом.
&Тест
Процедура СборкаКарточекСтоитОдногоЧтенияБазы() Экспорт

	Хранилище = Новый ХранилищеНастроекВПамяти();
	Хранилище.Установить("oshub.auth.registration.mode", "invite", "тест",
		ТекущаяУниверсальнаяДата());
	Настройки = РезолверНад(Хранилище);

	Карточки = Настройки.Карточки();

	Ожидаем.Что(Карточки.Количество() > 10,
		СтрШаблон("в реестре десятки ключей, а не %1", Формат(Карточки.Количество(), "ЧГ=0")))
		.ЭтоИстина();
	Ожидаем.Что(Хранилище.Чтений(), "вся сборка стоит одного чтения базы").Равно(1);

	// счётчик не должен мерить пустую работу: введённое руками доезжает до карточки
	// со своим источником, а нетронутый ключ по-прежнему отвечает дефолтом кода
	Введённая = НайтиКарточку(Карточки, "oshub.auth.registration.mode");
	Ожидаем.Что(Введённая.Значение, "введённое руками значение в карточке").Равно("invite");
	Ожидаем.Что(Введённая.Источник, "источник введённого — база").Равно("база");

	Нетронутая = НайтиКарточку(Карточки, "oshub.auth.token.cli_days");
	Ожидаем.Что(Нетронутая.Источник, "нетронутый ключ отвечает дефолтом кода").Равно("дефолт");

КонецПроцедуры

Функция НайтиКарточку(Знач Карточки, Знач Ключ)

	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Ключ = Ключ Тогда
			Возврат Карточка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В выдаче карточек нет ключа: " + Ключ;

КонецФункции

// --- политика пароля и секреты ---

&Тест
Процедура ГраницыДлиныПароляНеПускаютДругДругаЗаСебя() Экспорт

	// «минимум больше максимума» запер бы вход — пара сверяется на вводе
	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.password.min_length", 300),
		"минимум выше максимума не сохраняется").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.auth.password.max_length", 4),
		"максимум ниже минимума не сохраняется").ЭтоИстина();

	// отвергнутое не оставило следов: политика прежняя, вход работает
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.min_length")).Равно(8);
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.max_length")).Равно(256);

	// годная пара принимается — иначе проверка запрещала бы вообще всё
	Настройки.Установить("oshub.auth.password.min_length", 12, "root");
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.min_length"),
		"годное значение сохраняется").Равно(12);
	Ожидаем.Что(Настройки.Источник("oshub.auth.password.min_length")).Равно("база");

КонецПроцедуры

&Тест
Процедура ВзаимноНегодныеГраницыДлиныИзКонфигаНеРонятЧтение() Экспорт

	// пара, запирающая вход, приехала конфигурацией: чтение не уходит в круг проверок друг друга
	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.auth.password.min_length", 300);
	Детальки.Вставить("oshub.auth.password.max_length", 256);
	Настройки = ПостроитьХаб(Детальки).НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Значение("oshub.auth.password.max_length"),
		"максимум из конфигурации действует").Равно(256);
	Ожидаем.Что(Настройки.Значение("oshub.auth.password.min_length"),
		"негодный минимум отброшен в пользу умолчания").Равно(8);
	Ожидаем.Что(Настройки.Источник("oshub.auth.password.min_length")).Равно("дефолт");

КонецПроцедуры

&Тест
Процедура РедактируемыйСекретВводитсяНоНеЧитаетсяНиКарточкойНиАудитом() Экспорт

	// секрет на редактируемом ключе: вводится, но не читается ни карточкой, ни аудитом
	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");
	Журнал = Новый ЖурналАудитаФайлом(Хаб.НайтиЖелудь("ЧитательЖурналаАудита"));

	Ожидаем.Что(Настройки.Карточка("oshub.mail.smtp.password").Редактируемая,
		"секрет без конфигурации правится из интерфейса").ЭтоИстина();

	Настройки.Установить("oshub.mail.smtp.password", "сверх-секрет-42", "root", "10.0.0.7");

	// домен видит настоящее значение — им пользуется отправка письма
	Ожидаем.Что(Настройки.Значение("oshub.mail.smtp.password")).Равно("сверх-секрет-42");

	Карточка = Настройки.Карточка("oshub.mail.smtp.password");
	Ожидаем.Что(СтрНайти(Строка(Карточка.Значение), "сверх-секрет-42") = 0,
		"карточка редактируемого секрета не раскрывает значения").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Карточка.Значение),
		"но состояние «задано» видно").ЭтоИстина();

	Записи = Журнал.ПоОбъекту("настройка/oshub.mail.smtp.password");
	Ожидаем.Что(Записи.Количество() > 0, "правка секрета попала в аудит").ЭтоИстина();
	Для Каждого Запись Из Записи Цикл
		Ожидаем.Что(СтрНайти(Строка(Запись.Детали), "сверх-секрет-42") = 0,
			"детали аудита не содержат секрета: " + Строка(Запись.Детали)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Ключи прокси Telegram на настоящем реестре: порт в границах, пароль маской, названное
// конфигурацией из формы не правится.
&Тест
Процедура ПроксиTelegramЖивётПоОбщимПравиламНастроек() Экспорт

	Хаб = ПостроитьХаб(Неопределено);
	Настройки = Хаб.НайтиЖелудь("СервисНастроек");

	Настройки.Установить("oshub.webhooks.telegram.proxy.host", "proxy.example.ru", "root");
	Настройки.Установить("oshub.webhooks.telegram.proxy.port", 8080, "root");
	Настройки.Установить("oshub.webhooks.telegram.proxy.password", "Proxy-Pass-4f2a9d7b", "root");

	Ожидаем.Что(Настройки.Значение("oshub.webhooks.telegram.proxy.host"),
		"сервер прокси читается доменом как есть").Равно("proxy.example.ru");
	Ожидаем.Что(Настройки.Значение("oshub.webhooks.telegram.proxy.password"),
		"пароль прокси домен видит настоящим — им пользуется отправка")
		.Равно("Proxy-Pass-4f2a9d7b");

	Карточка = Настройки.Карточка("oshub.webhooks.telegram.proxy.password");
	Ожидаем.Что(Карточка.Секрет, "пароль прокси объявлен секретом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Карточка.Значение), "Proxy-Pass-4f2a9d7b") = 0,
		"и карточка его не раскрывает: " + Строка(Карточка.Значение)).ЭтоИстина();

	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.webhooks.telegram.proxy.port", 0),
		"порт ниже границы не сохраняется").ЭтоИстина();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.webhooks.telegram.proxy.port", 70000),
		"порт выше 65535 не сохраняется").ЭтоИстина();
	Ожидаем.Что(Настройки.Значение("oshub.webhooks.telegram.proxy.port"),
		"отбитая правка порт не тронула").Равно(8080);

КонецПроцедуры

&Тест
Процедура ПроксиTelegramИзКонфигурацииИзИнтерфейсаНеПравится() Экспорт

	Детальки = Деталька("oshub.webhooks.telegram.proxy.host", "proxy.из-окружения");
	Детальки.Вставить("oshub.webhooks.telegram.proxy.password", "из-окружения");
	Настройки = ПостроитьХаб(Детальки).НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Карточка("oshub.webhooks.telegram.proxy.host").Редактируемая,
		"сервер прокси из конфигурации на экране заперт").ЭтоЛожь();
	Ожидаем.Что(Настройки.Карточка("oshub.webhooks.telegram.proxy.password").Редактируемая,
		"и пароль прокси из конфигурации тоже").ЭтоЛожь();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.webhooks.telegram.proxy.host", "из-формы"),
		"правка форсированного сервера — отказ").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекретПодКонфигуромИзИнтерфейсаНеПравится() Экспорт

	// путь для тех, кто не хочет держать секрет в базе: задал переменной окружения —
	// поле стало нередактируемым для всех
	Настройки = ПостроитьХаб(Деталька("oshub.mail.smtp.password", "из-окружения"))
		.НайтиЖелудь("СервисНастроек");

	Ожидаем.Что(Настройки.Карточка("oshub.mail.smtp.password").Редактируемая,
		"секрет из конфигурации не правится").ЭтоЛожь();
	Ожидаем.Что(Падает(Настройки, "Установить", "oshub.mail.smtp.password", "из-формы"),
		"правка форсированного секрета — отказ").ЭтоИстина();

КонецПроцедуры

// --- расхождение «код читает / реестр объявляет» ---

// Значение конфигурации ключ получает деталькой своего объявления: на живом контейнере у каждого
// ключа своя метка, и реестр показывает именно её.
&Тест
Процедура КаждыйКлючРеестраЧитаетСобственнуюДетальку() Экспорт

	Ключи = Новый Массив();
	Конфиг = Новый Соответствие();
	Для Каждого Предмет Из ПостроитьХаб(Неопределено).НайтиЖелуди("КлючиНастроек") Цикл
		Для Каждого Объявление Из Предмет.Объявления().Ключи() Цикл
			Ключи.Добавить(Объявление.Ключ);
			Конфиг.Вставить(Объявление.Ключ, "метка:" + Объявление.Ключ);
		КонецЦикла;
	КонецЦикла;

	// корень хранилища ПостроитьХаб ставит поверх метки — сверяется то, что ушло в конфиг
	Реестр = ПостроитьХаб(Конфиг).НайтиЖелудь("РеестрНастроек");

	Расхождения = Новый Массив();
	Для Каждого Ключ Из Ключи Цикл
		Описание = Реестр.Описание(Ключ);
		Если НЕ Описание.КонфигЗадан ИЛИ Описание.ЗначениеКонфига <> Конфиг.Получить(Ключ) Тогда
			Расхождения.Добавить(СтрШаблон("%1 получил «%2»", Ключ, Описание.ЗначениеКонфига));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Ключи.Количество(), "метка есть у каждого ключа реестра")
		.Равно(Реестр.Ключи().Количество());
	Ожидаем.Что(Ключи.Количество() > 100,
		СтрШаблон("ключей с метками %1 при минимуме 100 — объявления не собрались",
			Формат(Ключи.Количество(), "ЧГ=0"))).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Расхождения, Символы.ПС),
		"ключ получил не свою детальку либо никакую").Равно("");

КонецПроцедуры

&Тест
Процедура ПарнаяПроверкаБезЗначенияСоседаОтказываетсяГромко() Экспорт

	// пара границ проверяется только с соседом: недобытый сосед — громкий отказ, а не пропуск
	Реестр = РеестрНастроекХаба.Реестр();
	Описание = Реестр.Описание("oshub.auth.password.min_length");
	Валидатор = Новый ВалидаторНастроек(Новый КанонIP());

	Ожидаем.Что(Валидатор.КлючСоседа(Описание), "паре назван её сосед")
		.Равно("oshub.auth.password.max_length");

	Отказ = "";
	Попытка
		Валидатор.Проверить(300, Описание, Неопределено);
	Исключение
		Отказ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Отказ),
		"проверка без значения соседа отказалась, а не пропустила значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "oshub.auth.password.max_length") > 0,
		"отказ называет ключ, значения которого не хватило: " + Отказ).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НегоднаяСетьВСпискеДоверенныхПроксиОтвергаетсяСНазваннойЗаписью() Экспорт

	// опечатка в списке не оставляет его молча пустым
	Реестр = РеестрНастроекХаба.Реестр();
	Описание = Реестр.Описание("oshub.instance.trusted_proxies");
	Валидатор = Новый ВалидаторНастроек(Новый КанонIP());

	Ожидаем.Что(Описание.Класс, "список сетей задаёт разворачивающий").Равно("bootstrap");
	Ожидаем.Что(Описание.Дефолт, "по умолчанию список пуст").Равно("");
	Ожидаем.Что(Реестр.ПеременнаяОкружения("oshub.instance.trusted_proxies"), "имя переменной")
		.Равно("OSHUB_INSTANCE_TRUSTED__PROXIES");

	Отказ = ОтказПроверки(Валидатор, "10.0.0.0/8, 10.0.0/8, 192.168.0.0/16", Описание);
	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "негодная запись отвергнута").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "10.0.0/8") > 0, "названа сама запись: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "CIDR") > 0, "и причина: " + Отказ).ЭтоИстина();

	Ожидаем.Что(ОтказПроверки(Валидатор, "10.0.0.0/33", Описание) <> "",
		"длина префикса вне семейства адреса").ЭтоИстина();
	Ожидаем.Что(ОтказПроверки(Валидатор, "", Описание), "пустой список — не опечатка").Равно("");
	Ожидаем.Что(ОтказПроверки(Валидатор, "10.0.0.0/8, 2001:db8::/32", Описание),
		"IPv4 и IPv6 вперемешку").Равно("");
	Ожидаем.Что(ОтказПроверки(Валидатор, "10.1.2.3/8", Описание),
		"сеть от знакомого оператору адреса").Равно("");

КонецПроцедуры

// Ключи инструментирования базы — перечисление: библиотека считает истиной только «true»,
// и «yes» не должно показываться действующим значением.
&Тест
Процедура СловоВнеПравилаOpenTelemetryВКлючахБазыОтвергается() Экспорт

	Реестр = РеестрНастроекХаба.Реестр();
	Валидатор = Новый ВалидаторНастроек(Новый КанонIP());

	Для Каждого Ключ Из СтрРазделить("otel.entity.enabled,otel.entity.repository.enabled", ",") Цикл

		Описание = Реестр.Описание(Ключ);
		Ожидаем.Что(Описание.Класс, Ключ + ": задаёт разворачивающий").Равно("bootstrap");
		Ожидаем.Что(Описание.Дефолт, Ключ + ": пусто значит «как otel.enabled»").Равно("");

		Отказ = ОтказПроверки(Валидатор, "yes", Описание);
		Ожидаем.Что(ЗначениеЗаполнено(Отказ), Ключ + ": ""yes"" отвергнуто").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, "yes") > 0, Ключ + ": названо само значение — " + Отказ).ЭтоИстина();

		Ожидаем.Что(ОтказПроверки(Валидатор, "true", Описание), Ключ + ": true принято").Равно("");
		Ожидаем.Что(ОтказПроверки(Валидатор, "false", Описание), Ключ + ": false принято").Равно("");
		Ожидаем.Что(ОтказПроверки(Валидатор, "", Описание),
			Ключ + ": пусто — законное «как телеметрия»").Равно("");

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура АдресИнсталляцииСРазрывомСтрокиОтвергаетсяСНазваннойПричиной() Экспорт

	// разрыв строки в адресе — чужие заголовки в письмах и ответах: отказ до записи
	Реестр = РеестрНастроекХаба.Реестр();
	Описание = Реестр.Описание("oshub.instance.url");
	Валидатор = Новый ВалидаторНастроек(Новый КанонIP());

	Отказ = ОтказПроверки(Валидатор, "https://хаб.example" + Символы.ВК + Символы.ПС + "X-Evil: 1",
		Описание);
	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "разрыв строки в адресе отвергнут").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "управляющий символ") > 0,
		"причина названа словами: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, Символы.ВК), "сам символ в текст отказа не подставлен")
		.Равно(0);

	Ожидаем.Что(ЗначениеЗаполнено(ОтказПроверки(Валидатор, "https://хаб example", Описание)),
		"пробел в адресе отвергнут").ЭтоИстина();
	Ожидаем.Что(ОтказПроверки(Валидатор, "https://хаб.example:8443", Описание),
		"основа со схемой, хостом и портом принята").Равно("");

КонецПроцедуры

Функция ОтказПроверки(Знач Валидатор, Знач Значение, Знач Описание)
	Попытка
		Валидатор.Проверить(Значение, Описание, Неопределено);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";
КонецФункции

// --- одновременная работа потоков ---

&Тест
Процедура ЧужойПотокЧитаетНастройкуПокаЕёЖеЧитаемЗдесь() Экспорт

	// защита от второго круга парных проверок — состояние одного разрешения, а не поле желудя
	Ключ = "oshub.auth.password.min_length";

	Хранилище = Новый ХранилищеНастроекСВторымПотоком(Новый ХранилищеНастроекВПамяти());
	Хранилище.Положить(Ключ, 12);
	Настройки = РезолверНад(Хранилище);
	Хранилище.ПуститьПотокНаКлюче(Настройки, Ключ);

	Ожидаем.Что(Настройки.Значение(Ключ), "поток, начавший чтение, видит значение базы").Равно(12);
	Ожидаем.Что(Хранилище.ВторойПотокУспел(),
		"второй поток ответил, а не заперся под чужим замком").ЭтоИстина();
	Ожидаем.Что(Хранилище.ОтветВторогоПотока(),
		"второй поток видит то же значение базы, а не умолчание 8").Равно(12);

КонецПроцедуры

&Тест
Процедура ВосемьЧитателейРеестраПодСбрасывающимСоседомВидятОдноИТоЖе() Экспорт

	// старт хаба: фоновые задачи и запрос читают настройки разом через общий кэш значений
	Хранилище = Новый ХранилищеНастроекВПамяти();
	Хранилище.Установить("oshub.auth.password.min_length", 12, "тест", ТекущаяУниверсальнаяДата());
	Хранилище.Установить("oshub.auth.password.max_length", 200, "тест", ТекущаяУниверсальнаяДата());

	// эталон снимается ОТДЕЛЬНЫМ резолвером: у читающих потоков кэш пустой, как на старте
	Ожидания = ДействующиеЗначения(РезолверНад(Хранилище));
	Настройки = РезолверНад(Хранилище);

	// девятый поток сбрасывает ключи без значения в базе: кэш переписывается всё время смока
	Уборщик = Новый СбросНастройкиПотоком(Настройки, КлючиБезЗначенияВБазе(Настройки, Хранилище), 600);

	Кругов = 300;
	Читатели = Новый Массив();
	Задания = Новый Массив();
	Для Номер = 1 По 8 Цикл
		Читатель = Новый ЧтениеНастроекПотоком(Настройки, Ожидания, Кругов);
		Читатели.Добавить(Читатель);
		Задания.Добавить(ФоновыеЗадания.Выполнить(Читатель, "Исполнить"));
	КонецЦикла;
	Задания.Добавить(ФоновыеЗадания.Выполнить(Уборщик, "Исполнить"));

	Доработали = 0;
	Для Каждого Задание Из Задания Цикл
		Если Задание.ОжидатьЗавершения(60000) Тогда
			Доработали = Доработали + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Доработали, "все девять потоков доработали до конца, ни один не завис").Равно(9);
	Ожидаем.Что(ЖалобыПотоков(Читатели), "потоки читали ровно то же, что спокойный резолвер")
		.Равно("");
	Ожидаем.Что(Уборщик.Жалоба(), "сброс под читателями прошёл без сбоя").Равно("");
	Ожидаем.Что(ПрочитаноПотоками(Читатели), "нагрузка отработана целиком (смок жив)")
		.Равно(8 * Кругов * Ожидания.Количество());

КонецПроцедуры

// --- служебное ---

// Резолвер со своим кэшем над готовым хранилищем; издатель и журнал — заглушки.
Функция РезолверНад(Знач Хранилище)

	Реестр = РеестрНастроекХаба.Реестр();

	ИменаЖурнала = Новый ИмяОбъектаАудита();
	Возврат Новый СервисНастроек(Реестр, Хранилище, Новый ИздательНастроекЗаглушка(),
		ИменаЖурнала, Новый СобытиеАудита(ИменаЖурнала, Новый ТекстJSON()),
		Новый ВалидаторНастроек(Новый КанонIP()));

КонецФункции

// Действующее значение каждой карточки реестра: эталон, с которым потоки сверяют прочитанное.
Функция ДействующиеЗначения(Знач Настройки)

	Результат = Новый Соответствие();
	Для Каждого Карточка Из Настройки.Карточки() Цикл
		Результат.Вставить(Карточка.Ключ, Настройки.Значение(Карточка.Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Прикладные ключи без значения в базе: их сброс действующего значения не меняет.
Функция КлючиБезЗначенияВБазе(Знач Настройки, Знач Хранилище)

	Результат = Новый Массив();
	Для Каждого Карточка Из Настройки.Карточки() Цикл
		Если Карточка.Класс = "прикладная" И Хранилище.Значение(Карточка.Ключ) = Неопределено Тогда
			Результат.Добавить(Карточка.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЖалобыПотоков(Знач Читатели)

	Жалобы = Новый Массив();
	Для Каждого Читатель Из Читатели Цикл
		Если ЗначениеЗаполнено(Читатель.Жалоба()) Тогда
			Жалобы.Добавить(Читатель.Жалоба());
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Жалобы, Символы.ПС);

КонецФункции

Функция ПрочитаноПотоками(Знач Читатели)

	Итог = 0;
	Для Каждого Читатель Из Читатели Цикл
		Итог = Итог + Читатель.Прочитано();
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Контейнер домена настроек на файловой базе теста с «файлом конфигурации» запуска.
Функция ПостроитьХаб(Знач ДеталькиКонфига)

	Детальки = ?(ДеталькиКонфига = Неопределено, Новый Соответствие(), ДеталькиКонфига);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторJSON");
	ИсточникДанных.Вставить("СтрокаСоединения", КаталогБД);
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	// корень хранилища — свой на прогон: под ним лежит файл журнала аудита
	Детальки.Вставить("oshub.storage.root", КаталогБД);

	Совет = СоветНабора.СДетальками(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;

КонецФункции

// Детали записи журнала полями, а не текстом.
Функция ДеталиЗаписи(Знач Хаб, Знач Запись)
	Возврат Хаб.НайтиЖелудь("ФорматЖурналаАудита").ДеталиПолями(Строка(Запись.Детали));
КонецФункции

// Отладка резолвера под ловушкой, поставленной после подъёма хаба.
Функция ОтладкуНастроекВЛовушку()

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("СервисНастроек");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка, УровниЛога.Отладка);

	Возврат Ловушка;

КонецФункции

// Отладка резолвера общая на процесс: оставленная включённой, она засоряет соседние тесты.
Процедура ВернутьУровеньНастроек()
	Логирование.ПолучитьЛог("СервисНастроек").УстановитьУровень(УровниЛога.Информация);
КонецПроцедуры

Функция СколькоРаз(Знач Текст, Знач Подстрока)

	Найдено = 0;
	Позиция = СтрНайти(Текст, Подстрока);
	Остаток = Текст;
	Пока Позиция > 0 Цикл
		Найдено = Найдено + 1;
		Остаток = Сред(Остаток, Позиция + СтрДлина(Подстрока));
		Позиция = СтрНайти(Остаток, Подстрока);
	КонецЦикла;

	Возврат Найдено;

КонецФункции

Функция Деталька(Знач Ключ, Знач Значение)
	Детальки = Новый Соответствие();
	Детальки.Вставить(Ключ, Значение);
	Возврат Детальки;
КонецФункции

// Снимок таблицы прикладных настроек: Ключ|Значение|Обновлена|КемОбновлена построчно.
Функция СнимокТаблицы(Знач Поделка)

	Строки = Новый Массив();
	Для Каждого Запись Из Поделка.НайтиЖелудь("ХранилищеПрикладныхНастроек").Все() Цикл
		Строки.Добавить(СтрШаблон("%1|%2|%3|%4",
			Запись.Ключ, Запись.Значение, XMLСтрока(Запись.Обновлена), Запись.КемОбновлена));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СнимкиСовпадают(Знач Снимок1, Знач Снимок2)
	Возврат Снимок1 = Снимок2 И ЗначениеЗаполнено(Снимок1);
КонецФункции

Функция Падает(Знач Настройки, Знач Метод, Знач Ключ, Знач Значение)

	Попытка
		Если Метод = "Установить" Тогда
			Настройки.Установить(Ключ, Значение, "тест");
		Иначе
			Настройки.Сбросить(Ключ, "тест");
		КонецЕсли;
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция ПадаетМеханизмом(Знач Настройки, Знач Ключ, Знач Значение, Знач Механизм)

	Попытка
		Настройки.УстановитьМеханизмом(Ключ, Значение, "тест", Механизм);
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

Процедура ПодключитьКаталог(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить;
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры
