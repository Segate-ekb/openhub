КонецПроцедуры

&Тест
Процедура Э11_МаскировкаНаЧетырёхКомбинациях() Экспорт

	Гвард = Желудь("ГвардДоступаКПулу");
	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Хозяин = СоздатьПользователя();
	СвойПул = СоздатьПул(УникальноеИмя("mymine"), "private");
	ЧужойПриватный = СоздатьПул(УникальноеИмя("alienpriv"), "private");
	Публичный = СоздатьПул(УникальноеИмя("openpool"), "public");

	Доступ.ЗафиксироватьГрант("пользователь", Хозяин.Идентификатор, Права.ОбъектПул(СвойПул),
		Права.НаборРоли("мейнтейнер"), 0);
	Доступ.ЗафиксироватьГрант("пользователь", Хозяин.Идентификатор, Права.ОбъектПул(ЧужойПриватный),
		Права.НаборРоли("читатель"), 0);

	Ключ = Новый Структура("Способ, Права, ПулИдентификатор, Пользователь, Сессия",
		"token", "read", СвойПул.Идентификатор, Хозяин, Неопределено);

	Свой = Гвард.ЧитаемыйПул(Хозяин, СвойПул.Имя, Ключ);
	Чужой = Гвард.ЧитаемыйПул(Хозяин, ЧужойПриватный.Имя, Ключ);
	Нет = Гвард.ЧитаемыйПул(Хозяин, "no-such-pool-at-all", Ключ);
	Публ = Гвард.ЧитаемыйПул(Хозяин, Публичный.Имя, Ключ);

	Ожидаем.Что(Свой <> Неопределено, "свой пул ключом читается").ЭтоИстина();
	Ожидаем.Что(Чужой, "чужой приватный вне привязки — тот же отказ, что «нет пула»").Равно(Неопределено);
	Ожидаем.Что(Нет, "несуществующий — отказ").Равно(Неопределено);
	Ожидаем.Что(Публ, "публичный вне привязки — тоже отказ (ключ уже человека)").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура Э12_СистемныйКонтурНеПишетПоПодделанномуОбъекту() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	ПулА = СоздатьПул(УникальноеИмя("sysa"), "public");
	ПулБ = СоздатьПул(УникальноеИмя("sysb"), "private");
	ПакетБ = СоздатьПакет(ПулБ, УникальноеИмя("syspkg"));
	Жертва = СоздатьПользователя();

	Подделка = Права.ОписаниеОбъекта("пакет", ПакетБ.Идентификатор, ПулА.Идентификатор);
	Доступ.ЗафиксироватьГрант("пользователь", Жертва.Идентификатор, Подделка,
		Права.НаборРоли("мейнтейнер"), 0);

	Записанный = Доступ.НайтиГрант("пользователь", Жертва.Идентификатор, Права.ОбъектПакет(ПакетБ));
	Ожидаем.Что(Записанный, "грант записан на сам пакет").Существует();
	Ожидаем.Что(Права.РольНаОбъекте(Жертва, Права.ОбъектПул(ПулА)),
		"и НИЧЕГО не открыл в подставленном пуле").Равно("");

	ОшибкаПризрака = "";
	Попытка
		Доступ.ЗафиксироватьГрант("пользователь", Жертва.Идентификатор,
			Права.ОписаниеОбъекта("пакет", 999999, ПулА.Идентификатор), Права.НаборРоли("читатель"), 0);
	Исключение
		ОшибкаПризрака = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаПризрака), "право на несуществующий объект не пишется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Э13_РольБезМаскиНеОткрываетЗахватИмён() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = СоздатьПул(УникальноеИмя("o4mask"), "public");
	Полный = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Полный.Идентификатор, Права.ОбъектХаб(),
		Права.НаборРоли("мейнтейнер"), 0);

	Ожидаем.Что(Права.РольНаОбъекте(Полный, Права.ОбъектПул(Пул)), "полный хаб-грант — владелец пула").Равно("владелец");
	Ожидаем.Что(Права.МожетАдминистрировать(Полный, Пул), "и администрирует").ЭтоИстина();

	Ожидаем.Что(Права.РазрешеноДействие(Полный, "создание", Права.ОбъектПул(Пул)),
		"хаб-создание не наследуется в пул (О-4)").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешёнPush(Полный, Пул, УникальноеИмя("newname")),
		"и push НОВОГО имени по хаб-праву не проходит").ЭтоЛожь();

	ТолькоСоздание = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", ТолькоСоздание.Идентификатор, Права.ОбъектХаб(),
		Новый Структура("создание, изменение, удаление, чтение", Истина, Ложь, Ложь, Ложь), 0);
	Ожидаем.Что(Права.РольНаОбъекте(ТолькоСоздание, Права.ОбъектПул(Пул)),
		"право заводить пулы роли в пуле не даёт").Равно("");
	Ожидаем.Что(Права.МожетАдминистрировать(ТолькоСоздание, Пул), "и не администрирует").ЭтоЛожь();

КонецПроцедуры

// Читаемые пулы — единственный ответ на вопрос «что этому запросу можно называть».
// Ключ, привязанный к пулу, ничего сверх своего пула не открывает — даже владельцу
// соседнего приватного пула.
&Тест
Процедура Э14_КлючПулаНеОткрываетСоседнийПриватныйПулВладельца() Экспорт

	ЧтениеПула = Желудь("ГвардДоступаКПулу");

	ПулX = СоздатьПул(УникальноеИмя("rdx"), "private");
	ПулY = СоздатьПул(УникальноеИмя("rdy"), "private");
	Публичный = СоздатьПул(УникальноеИмя("rdpub"), "public");

	Владелец = СоздатьПользователя();
	ВыдатьПресет(ПулX, "пользователь", Владелец.Идентификатор, "владелец");
	ВыдатьПресет(ПулY, "пользователь", Владелец.Идентификатор, "владелец");

	Ключом = ИменаПулов(ЧтениеПула.ЧитаемыеПулы(Принципал("token", "read,write", ПулX.Идентификатор, Владелец)));

	Ожидаем.Что(СтрНайти(Ключом, ПулX.Имя) > 0, "ключ читает свой пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, Публичный.Имя) > 0, "и публичный пул: ключ сужает только приватное").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, ПулY.Имя), "второй приватный пул того же владельца ключу закрыт").Равно(0);

	Сессией = ИменаПулов(ЧтениеПула.ЧитаемыеПулы(Принципал("session", "", 0, Владелец)));
	Ожидаем.Что(СтрНайти(Сессией, ПулY.Имя) > 0,
		"КОНТРОЛЬ: сессией владелец читает оба своих пула — рамки принадлежат ключу").ЭтоИстина();

КонецПроцедуры

// Суперправо админа хаба ключом тоже сужается: иначе привязанный к пулу ключ админа
// был бы ключом от всего хаба.
&Тест
Процедура Э15_КлючПулаСужаетЧитаемоеИАдминуХаба() Экспорт

	ЧтениеПула = Желудь("ГвардДоступаКПулу");

	ПулX = СоздатьПул(УникальноеИмя("admx"), "private");
	ПулY = СоздатьПул(УникальноеИмя("admy"), "private");
	Админ = СоздатьПользователя("admin");

	Ключом = ИменаПулов(ЧтениеПула.ЧитаемыеПулы(Принципал("token", "read", ПулX.Идентификатор, Админ)));

	Ожидаем.Что(СтрНайти(Ключом, ПулX.Имя) > 0, "ключ админа читает свой пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, ПулY.Имя), "и не читает приватный пул вне привязки").Равно(0);

	Сессией = ИменаПулов(ЧтениеПула.ЧитаемыеПулы(Принципал("session", "", 0, Админ)));
	Ожидаем.Что(СтрНайти(Сессией, ПулY.Имя) > 0,
		"КОНТРОЛЬ: сессией админ читает любой пул").ЭтоИстина();

КонецПроцедуры

// Ключ с НАБОРОМ пулов открывает РОВНО свой набор: ни соседний приватный пул владельца,
// ни весь хаб. Набор из двух — то место, где «первый элемент вместо множества» видно.
&Тест
Процедура Э16_КлючНабораОткрываетТолькоПулыСвоегоНабора() Экспорт

	ЧтениеПула = Желудь("ГвардДоступаКПулу");

	ПулA = СоздатьПул(УникальноеИмя("seta"), "private");
	ПулB = СоздатьПул(УникальноеИмя("setb"), "private");
	ПулC = СоздатьПул(УникальноеИмя("setc"), "private");

	Владелец = СоздатьПользователя();
	ВыдатьПресет(ПулA, "пользователь", Владелец.Идентификатор, "владелец");
	ВыдатьПресет(ПулB, "пользователь", Владелец.Идентификатор, "владелец");
	ВыдатьПресет(ПулC, "пользователь", Владелец.Идентификатор, "владелец");

	Набор = Новый Массив();
	Набор.Добавить(ПулA.Идентификатор);
	Набор.Добавить(ПулB.Идентификатор);
	Ключ = ПринципалНабора("read,write", Набор, Владелец);

	Ключом = ИменаПулов(ЧтениеПула.ЧитаемыеПулы(Ключ));
	Ожидаем.Что(СтрНайти(Ключом, ПулA.Имя) > 0, "первый пул набора ключом читается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, ПулB.Имя) > 0, "и второй — набор судится целиком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, ПулC.Имя), "третий приватный пул того же владельца закрыт").Равно(0);

	Ожидаем.Что(ЧтениеПула.ЧитаемыйПул(Владелец, ПулB.Имя, Ключ) <> Неопределено,
		"дверь во второй пул набора открыта").ЭтоИстина();
	Ожидаем.Что(ЧтениеПула.ЧитаемыйПул(Владелец, ПулC.Имя, Ключ),
		"а в пул вне набора — тот же отказ, что «нет пула»").Равно(Неопределено);

	Сессией = ИменаПулов(ЧтениеПула.ЧитаемыеПулы(Принципал("session", "", 0, Владелец)));
	Ожидаем.Что(СтрНайти(Сессией, ПулC.Имя) > 0,
		"КОНТРОЛЬ: сессией владелец читает все три — рамки принадлежат ключу").ЭтоИстина();

КонецПроцедуры

// Названный пул сверяется с видимыми: невидимый и несуществующий отвергаются одинаково,
// иначе перебор идентификаторов при выпуске ключа рассказывал бы о чужих пулах.
&Тест
Процедура Э17_НазванныйПулСверяетсяСВидимымиИНеРассказываетОЧужих() Экспорт

	ЧтениеПула = Желудь("ГвардДоступаКПулу");

	Свой = СоздатьПул(УникальноеИмя("named"), "private");
	Чужой = СоздатьПул(УникальноеИмя("alien"), "private");
	Смотрящий = СоздатьПользователя();
	ВыдатьПресет(Свой, "пользователь", Смотрящий.Идентификатор, "владелец");

	Сессия = Принципал("session", "", 0, Смотрящий);

	Сошлось = ЧтениеПула.НазванныеПулы(Сессия, ОдинЭлемент(Свой.Идентификатор));
	Ожидаем.Что(Сошлось.Отвергнутый, "свой пул назван законно").Равно("");
	Ожидаем.Что(Сошлось.Пулы.Количество()).Равно(1);
	Ожидаем.Что(Сошлось.Пулы[0]).Равно(Свой.Идентификатор);

	НаЧужом = ЧтениеПула.НазванныеПулы(Сессия, ОдинЭлемент(Чужой.Идентификатор));
	НаНебывалом = ЧтениеПула.НазванныеПулы(Сессия, ОдинЭлемент(99999999));
	Ожидаем.Что(ЗначениеЗаполнено(НаЧужом.Отвергнутый), "чужой пул отвергнут").ЭтоИстина();
	Ожидаем.Что(НаЧужом.Пулы.Количество(), "и ни один пул не принят").Равно(0);
	Ожидаем.Что(ЗначениеЗаполнено(НаНебывалом.Отвергнутый),
		"несуществующий отвергнут так же").ЭтоИстина();

	// строки от клиента: «12» и 12 — одно и то же, мусор — «нет такого пула»
	Строкой = ЧтениеПула.НазванныеПулы(Сессия,
		ОдинЭлемент(Формат(Свой.Идентификатор, "ЧГ=0")));
	Ожидаем.Что(Строкой.Отвергнутый, "идентификатор строкой читается как число").Равно("");
	Ожидаем.Что(ЗначениеЗаполнено(ЧтениеПула.НазванныеПулы(Сессия, ОдинЭлемент("мусор")).Отвергнутый),
		"нечисло — тот же отказ").ЭтоИстина();

	Пусто = ЧтениеПула.НазванныеПулы(Сессия, Новый Массив());
	Ожидаем.Что(Пусто.Отвергнутый, "пустой набор законен").Равно("");
	Ожидаем.Что(Пусто.Пулы.Количество(), "и означает «весь хаб»").Равно(0);

КонецПроцедуры

Функция Принципал(Знач Способ, Знач Права, Знач ПулИдентификатор, Знач Пользователь = Неопределено)
	Возврат Новый Структура("Способ, Права, ПулИдентификатор, Пользователь, Сессия",
		Способ, Права, ПулИдентификатор, Пользователь, Неопределено);
КонецФункции

// Принципал ключа с НАБОРОМ пулов — так его собирает перехватчик после выпуска.
Функция ПринципалНабора(Знач Права, Знач Пулы, Знач Пользователь)
	Возврат Новый Структура("Способ, Права, Пулы, ПулИдентификатор, Пользователь, Сессия",
		"token", Права, Пулы, 0, Пользователь, Неопределено);
КонецФункции

Функция ОдинЭлемент(Знач Значение)
	Список = Новый Массив();
	Список.Добавить(Значение);
	Возврат Список;
КонецФункции

// Имена читаемых пулов через запятую — выдача сравнивается по составу, а не по счёту:
// пулы копятся у всех тестов набора.
Функция ИменаПулов(Знач Пулы)
	Список = "";
	Для Каждого Пул Из Пулы Цикл
		Список = Список + ?(ЗначениеЗаполнено(Список), ",", "") + Пул.Имя;
	КонецЦикла;
	Возврат Список;
КонецФункции

Функция СоздатьПользователя(Знач РольХаба = "user")
	Хранилище = Желудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("user");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

Функция СоздатьПул(Знач Имя, Знач Видимость)
	Возврат Желудь("СервисПулов").СоздатьПул(Имя, "custom", Видимость);
КонецФункции

Функция СоздатьПакет(Знач Пул, Знач Имя)
	Возврат Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, Имя);
КонецФункции

Процедура ВыдатьПресет(Знач Пул, Знач ТипСубъекта, Знач СубъектИд, Знач Роль)
	Хранилище = Желудь("ХранилищеУчастниковПула");
	Участник = Хранилище.СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = ТипСубъекта;
	Участник.СубъектИдентификатор = СубъектИд;
	Участник.Роль = Роль;
	Участник.Сохранить();
КонецПроцедуры

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции
