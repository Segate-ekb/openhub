// Эксплойты прав доступа: кросс-пуловая выдача (IDOR), эскалация роли, обратный резолв,
// лакуны энфорсмента ключа, потеря прав при свёртке легаси-пресетов.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьКаталог(ОбъединитьПути(Модули, "данные", "Классы"));
	ПодключитьКаталог(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПодключитьКаталог(ОбъединитьПути(Модули, "события", "Классы"));

	КаталогNet = ОбъединитьПути(Модули, "сеть", "Классы");
	КаталогObs = ОбъединитьПути(Модули, "наблюдаемость", "Классы/телеметрия");
	КаталогПробХаба = ОбъединитьПути(Модули, "наблюдаемость", "Классы/пробы");
	ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогObs, "БуферСпанов.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтФикстура = Новый ГейтАпстримов();
	ГейтФикстура.Подключить();

	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHub");
	// СлужбаДоступа спрашивает у гварда право задать квоту при создании пула
	ПоискКлассов.Подключить(Модули, "ГвардКвотыПула");
	ПоискКлассов.Подключить(Модули, "СервисТокенов");
	ПоискКлассов.Подключить(Модули, "ГейтТокена");

	// сроки токенов — прикладные настройки хаба: без реестра и резолвера СервисТокенов
	// в контейнере не собирается
	КаталогSettings = ОбъединитьПути(Модули, "настройки", "Классы");
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	// СервисПользователей пишет события безопасности учётки через летопись
	ПоискКлассов.Подключить(Модули, "ЛетописьУчёток");
	ПоискКлассов.Подключить(Модули, "АдресУчётки");
	ПоискКлассов.Подключить(Модули, "СервисПользователей");
	ПоискКлассов.Подключить(Модули, "СлужбаСессий");
	ПоискКлассов.Подключить(Модули, "ХранилищеСессийБД");
	ПоискКлассов.Подключить(Модули, "СессияХаба");
	ПоискКлассов.Подключить(Модули, "НормализаторУчётки");
	ПоискКлассов.Подключить(Модули, "ПерехватчикАутентификации");
	ПоискКлассов.Подключить(Модули, "ГвардЧтенияПула");

	ПодключитьФайл(ОбъединитьПути(Модули, "кабинет", "Классы", "СлужбаДоступа.os"));

	ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкПроверяющийGitHub.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ЗаписывающийПодписчик.os"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "эксплойты-прав-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&Тест
Процедура Э1_КроссПуловыйIDORЧерезСлужбу() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Служба = Желудь("СлужбаДоступа");

	ПулА = СоздатьПул(УникальноеИмя("idora"), "public");
	ПулБ = СоздатьПул(УникальноеИмя("idorb"), "private");
	ПакетБ = СоздатьПакет(ПулБ, УникальноеИмя("secret"));

	Злодей = СоздатьПользователя();
	Жертва = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Злодей.Идентификатор, Права.ОбъектПул(ПулА),
		Права.НаборРоли("мейнтейнер"), 0);

	Ошибка = "";
	Попытка
		Служба.ВыдатьРоль(Злодей, "пользователь", Жертва.Идентификатор, "пакет", ПакетБ.Идентификатор, "мейнтейнер");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка), "служба обязана отказать: " + Ошибка).ЭтоИстина();
	Ожидаем.Что(Доступ.НайтиГрант("пользователь", Жертва.Идентификатор, Права.ОбъектПакет(ПакетБ)),
		"грант на чужой пакет не записан").Равно(Неопределено);
	Ожидаем.Что(Права.РазрешеноДействие(Жертва, "чтение", Права.ОбъектПакет(ПакетБ)),
		"жертва не получила чтения чужого пакета").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура Э2_КроссПуловыйIDORМимоСлужбы() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	ПулА = СоздатьПул(УникальноеИмя("idor2a"), "public");
	ПулБ = СоздатьПул(УникальноеИмя("idor2b"), "private");
	ПакетБ = СоздатьПакет(ПулБ, УникальноеИмя("secret2"));

	Злодей = СоздатьПользователя();
	Жертва = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Злодей.Идентификатор, Права.ОбъектПул(ПулА),
		Права.НаборРоли("мейнтейнер"), 0);

	Подделка = Права.ОписаниеОбъекта("пакет", ПакетБ.Идентификатор, ПулА.Идентификатор);

	Ошибка = "";
	Попытка
		Доступ.ВыдатьРоль(Злодей, "пользователь", Жертва.Идентификатор, Подделка, "мейнтейнер");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	ПолучилЗапись = Права.РазрешеноДействие(Жертва, "изменение", Права.ОбъектПакет(ПакетБ));
	ПолучилЧтение = Права.РазрешеноДействие(Жертва, "чтение", Права.ОбъектПакет(ПакетБ));
	ЗаписьЕсть = (Доступ.НайтиГрант("пользователь", Жертва.Идентификатор, Права.ОбъектПакет(ПакетБ)) <> Неопределено);

	Ожидаем.Что(ПолучилЗапись, "жертва не получила записи в чужой пакет").ЭтоЛожь();
	Ожидаем.Что(ПолучилЧтение, "жертва не получила чтения чужого приватного пакета").ЭтоЛожь();
	Ожидаем.Что(ЗаписьЕсть, "грант на чужой пакет не записан").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"СервисПравДоступа обязан отказать (защита в глубину)").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Э3_ПорогВыдачиИПотолокРоли() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = СоздатьПул(УникальноеИмя("porog"), "private");
	Райтер = СоздатьПользователя();
	Мейнт = СоздатьПользователя();
	Цель = СоздатьПользователя();

	Доступ.ЗафиксироватьГрант("пользователь", Райтер.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("райтер"), 0);
	Доступ.ЗафиксироватьГрант("пользователь", Мейнт.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("мейнтейнер"), 0);

	Ожидаем.Что(Доступ.МожетВыдаватьГрант(Райтер, Права.ОбъектПул(Пул)), "райтер прав не выдаёт").ЭтоЛожь();

	ОшибкаРайтера = "";
	Попытка
		Доступ.ВыдатьРоль(Райтер, "пользователь", Райтер.Идентификатор, Права.ОбъектПул(Пул), "мейнтейнер");
	Исключение
		ОшибкаРайтера = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаРайтера), "райтер не поднимает себя до мейнтейнера").ЭтоИстина();

	ОшибкаСырая = "";
	Попытка
		Доступ.ВыдатьГрант(Райтер, "пользователь", Райтер.Идентификатор, Права.ОбъектПул(Пул),
			Права.НаборРоли("мейнтейнер"));
	Исключение
		ОшибкаСырая = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаСырая), "сырая выдача райтером тоже отбита").ЭтоИстина();

	ОшибкаВладельца = "";
	Попытка
		Доступ.ВыдатьРоль(Мейнт, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "владелец");
	Исключение
		ОшибкаВладельца = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаВладельца), "владелец на объекте не выдаётся").ЭтоИстина();

	ОшибкаАдмина = "";
	Попытка
		Доступ.ВыдатьРоль(Мейнт, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "админ");
	Исключение
		ОшибкаАдмина = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаАдмина), "админ хаба на объекте не выдаётся").ЭтоИстина();

	ОшибкаЛегаси = "";
	Попытка
		Доступ.ВыдатьРоль(Райтер, "пользователь", Райтер.Идентификатор, Права.ОбъектПул(Пул), "owner");
	Исключение
		ОшибкаЛегаси = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаЛегаси), "легаси-имя роли не обходит порог выдачи").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Э4_ХабГрантПротивМожетАдминистрировать() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = СоздатьПул(УникальноеИмя("hubgrant"), "private");
	Хабовый = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Хабовый.Идентификатор, Права.ОбъектХаб(),
		Права.НаборРоли("мейнтейнер"), 0);

	СноситПул = Права.МожетУдалятьПул(Хабовый);
	УдаляетВнутри = Права.РазрешеноДействие(Хабовый, "удаление", Права.ОбъектПул(Пул));
	Роль = Права.РольНаОбъекте(Хабовый, Права.ОбъектПул(Пул));
	Админит = Права.МожетАдминистрировать(Хабовый, Пул);
	Выдаёт = Желудь("СервисПравДоступа").МожетВыдаватьГрант(Хабовый, Права.ОбъектПул(Пул));

	Ожидаем.Что(СноситПул, "хаб-грант даёт снос пула").ЭтоИстина();
	Ожидаем.Что(УдаляетВнутри, "и удаление внутри пула (наследование)").ЭтоИстина();
	Ожидаем.Что(Админит,
		"тот, кто вправе снести пул, обязан его администрировать (было так до 7.A)").ЭтоИстина();
	Ожидаем.Что(Выдаёт, "и управлять его правами").ЭтоИстина();
	Ожидаем.Что(Роль, "эффективная роль на пуле (не «читатель»!)").Равно("владелец");

КонецПроцедуры

&Тест
Процедура Э5_ОбратныйРезолвНеОкругляет() Экспорт

	Права = Желудь("СервисПрав");

	ЧастичныйВверх = Новый Структура("создание, изменение, удаление, чтение", Ложь, Ложь, Истина, Истина);
	Ожидаем.Что(Права.РольПоНабору(ЧастичныйВверх),
		"чтение+удаление — не роль (иначе витрина прячет удаление под «читателем»)").Равно("");

	Частичный2 = Новый Структура("создание, изменение, удаление, чтение", Истина, Ложь, Истина, Истина);
	Ожидаем.Что(Права.РольПоНабору(Частичный2),
		"чтение+создание+удаление — не роль").Равно("");

	ТолькоИзменение = Новый Структура("создание, изменение, удаление, чтение", Ложь, Истина, Ложь, Ложь);
	Ожидаем.Что(Права.РольПоНабору(ТолькоИзменение), "одно изменение ролью не является").Равно("");

	Полный = Права.НаборРоли("мейнтейнер");
	Ожидаем.Что(Права.РольПоНабору(Полный), "полный набор — мейнтейнер").Равно("мейнтейнер");

КонецПроцедуры

&Тест
Процедура Э6_ГейтТокенаСкоупыИПривязка() Экспорт

	Гейт = Желудь("ГейтТокена");
	Ожидаем.Что(Гейт, "желудь ГейтТокена собран").Существует();

	ТокенЧтения = Принципал("token", "read", 0);
	ТокенЗаписи = Принципал("token", "write", 0);
	ТокенПустой = Принципал("token", "", 0);
	ТокенПулА = Принципал("token", "read,write", 10);

	Ожидаем.Что(Гейт.Проверить(ТокенЧтения, "чтение", 1).Разрешено, "read читает").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(ТокенЧтения, "создание", 1).Разрешено, "read не пишет").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(ТокенЗаписи, "чтение", 1).Разрешено,
		"write БЕЗ read не читает (скоупы независимы)").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(ТокенПустой, "чтение", 1).Разрешено, "пустой скоуп — fail-closed").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(ТокенПулА, "чтение", 11).Разрешено, "привязка к чужому пулу").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(ТокенПулА, "чтение", 10).Разрешено, "свой пул").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(ТокенПулА, "создание", 0).Разрешено, "хаб-уровень привязанному закрыт").ЭтоЛожь();

	Сессия = Принципал("session", "", 0);
	Ожидаем.Что(Гейт.Проверить(Сессия, "удаление", 5).Разрешено, "сессия гейтом не сужается").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Неопределено, "чтение", 5).Разрешено, "аноним прозрачен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Э7_АудитОтказаИУтечки() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Издатель = Желудь("ИздательСобытий");

	Пул = СоздатьПул(УникальноеИмя("auditdeny"), "private");
	Райтер = СоздатьПользователя();
	Цель = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Райтер.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("райтер"), 0);

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПраваИзменены(), Слушатель);

	Попытка
		Доступ.ВыдатьРоль(Райтер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "мейнтейнер");
	Исключение
	КонецПопытки;

	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПраваИзменены()),
		"ОТКАЗ в выдаче прав тоже обязан попадать в журнал безопасности").Равно(1);

КонецПроцедуры

&Тест
Процедура Э8_ЛегасиOwnerНеПотерялПрав() Экспорт

	Права = Желудь("СервисПрав");
	Пул = СоздатьПул(УникальноеИмя("legacy"), "private");
	Стрый = СоздатьПользователя();
	ВыдатьПресет(Пул, "пользователь", Стрый.Идентификатор, "owner");

	Ожидаем.Что(Права.РольНаПул(Стрый, Пул.Идентификатор), "имя роли наружу").Равно("мейнтейнер");
	Ожидаем.Что(Права.МожетАдминистрировать(Стрый, Пул), "owner администрирует пул").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПравДоступа").МожетВыдаватьГрант(Стрый, Права.ОбъектПул(Пул)),
		"owner выдаёт права").ЭтоИстина();
	Ожидаем.Что(Права.МожетУдалятьПул(Стрый), "но пул не сносит (О-14)").ЭтоЛожь();

	Публикатор = СоздатьПользователя();
	ВыдатьПресет(Пул, "пользователь", Публикатор.Идентификатор, "publisher");
	Ожидаем.Что(Права.МожетАдминистрировать(Публикатор, Пул), "publisher не администрирует").ЭтоЛожь();
	Ожидаем.Что(Права.МожетПисать(Публикатор, Пул), "но пишет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Э9_СоздательПулаОстаётсяАдминистратором() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Служба = Желудь("СлужбаДоступа");

	Творец = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Творец.Идентификатор, Права.ОбъектХаб(),
		Новый Структура("создание, изменение, удаление, чтение", Истина, Ложь, Ложь, Ложь), 0);

	// квота при создании не задаётся: её назначает админ хаба, а творец им не является
	Пул = Служба.СоздатьПул(Творец, УникальноеИмя("own"), "custom", "private");
	Ожидаем.Что(Права.МожетАдминистрировать(Творец, Пул), "создатель администрирует свой пул").ЭтоИстина();
	Ожидаем.Что(Доступ.МожетВыдаватьГрант(Творец, Права.ОбъектПул(Пул)), "и выдаёт роли").ЭтоИстина();
	Ожидаем.Что(Права.РольНаОбъекте(Творец, Права.ОбъектПул(Пул)), "роль создателя").Равно("мейнтейнер");

КонецПроцедуры

&Тест
Процедура Э10_НаследованиеСозданияНеПротекает() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = СоздатьПул(УникальноеИмя("o4"), "public");
	Юзер = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектХаб(),
		Новый Структура("создание, изменение, удаление, чтение", Истина, Ложь, Ложь, Ложь), 0);

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "создание", Права.ОбъектПул(Пул)),
		"хаб-создание не даёт создания имён в пуле").ЭтоЛожь();
	Ожидаем.Что(Права.МожетСоздаватьПул(Юзер), "но пул создать можно").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Э11_МаскировкаНаЧетырёхКомбинациях() Экспорт

	Гвард = Желудь("ГвардЧтенияПула");
	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Хозяин = СоздатьПользователя();
	СвойПул = СоздатьПул(УникальноеИмя("mymine"), "private");
	ЧужойПриватный = СоздатьПул(УникальноеИмя("alienpriv"), "private");
	Публичный = СоздатьПул(УникальноеИмя("openpool"), "public");

	Доступ.ЗафиксироватьГрант("пользователь", Хозяин.Идентификатор, Права.ОбъектПул(СвойПул),
		Права.НаборРоли("мейнтейнер"), 0);
	Доступ.ЗафиксироватьГрант("пользователь", Хозяин.Идентификатор, Права.ОбъектПул(ЧужойПриватный),
		Права.НаборРоли("читатель"), 0);

	Ключ = Новый Структура("Способ, Права, ПулИдентификатор, Пользователь, Сессия",
		"token", "read", СвойПул.Идентификатор, Хозяин, Неопределено);

	Свой = Гвард.ЧитаемыйПул(Хозяин, СвойПул.Имя, Ключ);
	Чужой = Гвард.ЧитаемыйПул(Хозяин, ЧужойПриватный.Имя, Ключ);
	Нет = Гвард.ЧитаемыйПул(Хозяин, "no-such-pool-at-all", Ключ);
	Публ = Гвард.ЧитаемыйПул(Хозяин, Публичный.Имя, Ключ);

	Ожидаем.Что(Свой <> Неопределено, "свой пул ключом читается").ЭтоИстина();
	Ожидаем.Что(Чужой, "чужой приватный вне привязки — тот же отказ, что «нет пула»").Равно(Неопределено);
	Ожидаем.Что(Нет, "несуществующий — отказ").Равно(Неопределено);
	Ожидаем.Что(Публ, "публичный вне привязки — тоже отказ (ключ уже человека)").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура Э12_СистемныйКонтурНеПишетПоПодделанномуОбъекту() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	ПулА = СоздатьПул(УникальноеИмя("sysa"), "public");
	ПулБ = СоздатьПул(УникальноеИмя("sysb"), "private");
	ПакетБ = СоздатьПакет(ПулБ, УникальноеИмя("syspkg"));
	Жертва = СоздатьПользователя();

	Подделка = Права.ОписаниеОбъекта("пакет", ПакетБ.Идентификатор, ПулА.Идентификатор);
	Доступ.ЗафиксироватьГрант("пользователь", Жертва.Идентификатор, Подделка,
		Права.НаборРоли("мейнтейнер"), 0);

	Записанный = Доступ.НайтиГрант("пользователь", Жертва.Идентификатор, Права.ОбъектПакет(ПакетБ));
	Ожидаем.Что(Записанный, "грант записан на сам пакет").Существует();
	Ожидаем.Что(Права.РольНаОбъекте(Жертва, Права.ОбъектПул(ПулА)),
		"и НИЧЕГО не открыл в подставленном пуле").Равно("");

	ОшибкаПризрака = "";
	Попытка
		Доступ.ЗафиксироватьГрант("пользователь", Жертва.Идентификатор,
			Права.ОписаниеОбъекта("пакет", 999999, ПулА.Идентификатор), Права.НаборРоли("читатель"), 0);
	Исключение
		ОшибкаПризрака = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаПризрака), "право на несуществующий объект не пишется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Э13_РольБезМаскиНеОткрываетЗахватИмён() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = СоздатьПул(УникальноеИмя("o4mask"), "public");
	Полный = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Полный.Идентификатор, Права.ОбъектХаб(),
		Права.НаборРоли("мейнтейнер"), 0);

	Ожидаем.Что(Права.РольНаОбъекте(Полный, Права.ОбъектПул(Пул)), "полный хаб-грант — владелец пула").Равно("владелец");
	Ожидаем.Что(Права.МожетАдминистрировать(Полный, Пул), "и администрирует").ЭтоИстина();

	Ожидаем.Что(Права.РазрешеноДействие(Полный, "создание", Права.ОбъектПул(Пул)),
		"хаб-создание не наследуется в пул (О-4)").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешёнPush(Полный, Пул, УникальноеИмя("newname")),
		"и push НОВОГО имени по хаб-праву не проходит").ЭтоЛожь();

	ТолькоСоздание = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", ТолькоСоздание.Идентификатор, Права.ОбъектХаб(),
		Новый Структура("создание, изменение, удаление, чтение", Истина, Ложь, Ложь, Ложь), 0);
	Ожидаем.Что(Права.РольНаОбъекте(ТолькоСоздание, Права.ОбъектПул(Пул)),
		"право заводить пулы роли в пуле не даёт").Равно("");
	Ожидаем.Что(Права.МожетАдминистрировать(ТолькоСоздание, Пул), "и не администрирует").ЭтоЛожь();

КонецПроцедуры

Функция Принципал(Знач Способ, Знач Права, Знач ПулИдентификатор)
	Возврат Новый Структура("Способ, Права, ПулИдентификатор, Пользователь, Сессия",
		Способ, Права, ПулИдентификатор, Неопределено, Неопределено);
КонецФункции

Функция СоздатьПользователя(Знач РольХаба = "user")
	Хранилище = Желудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("user");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

Функция СоздатьПул(Знач Имя, Знач Видимость)
	Возврат Желудь("СервисПулов").СоздатьПул(Имя, "custom", Видимость);
КонецФункции

Функция СоздатьПакет(Знач Пул, Знач Имя)
	Возврат Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, Имя);
КонецФункции

Процедура ВыдатьПресет(Знач Пул, Знач ТипСубъекта, Знач СубъектИд, Знач Роль)
	Хранилище = Желудь("ХранилищеУчастниковПула");
	Участник = Хранилище.СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = ТипСубъекта;
	Участник.СубъектИдентификатор = СубъектИд;
	Участник.Роль = Роль;
	Участник.Сохранить();
КонецПроцедуры

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Процедура ПодключитьКаталог(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

Процедура ПодключитьФайл(Знач Путь)
	Имя = Новый Файл(Путь).ИмяБезРасширения;
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции
