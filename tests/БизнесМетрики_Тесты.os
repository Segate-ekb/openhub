// Живой хаб с включённой телеметрией против настоящего OTLP-приёмника: доказывается,
// что работа хаба видна оператору числами — скачивания и публикации счётчиками с именем
// пула, числа реестра и занятое место датчиками, — и что срез датчиков заводит ОДИН
// корень трассы с детьми, а не россыпь сирот.
//
// Офлайн этого не увидеть: срезы метрик снимает фоновый экспорт SDK, и сюда они попадают
// только по сети. Протокол http/json: тело партии читается как текст.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент;
Перем Коллектор;
Перем Разбор;         // фикстура РазборOTLP — партии спанов и срезы метрик значениями
Перем КаталогСборки;
Перем ТокенRoot;
Перем ИмяПула;        // пул этого набора: по нему разрезаны счётчики

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("РазборOTLP");

	Разбор = Новый РазборOTLP();
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-бизнес-метрики-ospx");

	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);

	Хаб.ФайловаяБаза("openhub-бизнес-метрики");
	Хаб.Среда("OTEL_ENABLED", "true");
	Хаб.Среда("OTEL_SERVICE_NAME", "openhub-бизнес-метрики-тест");
	Хаб.Среда("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Хаб.Среда("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	// Партия спанов и срез метрик — по расписанию. Ждать штатных 5 и 60 секунд тесту
	// незачем: интервалы это настройки, и они же ускоряются.
	Хаб.Среда("OTEL_BSP_SCHEDULE_DELAY", "1000");
	Хаб.Среда("OTEL_METRIC_EXPORT_INTERVAL", "2000");
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));
	Хаб.Запустить();

	ТокенRoot = ВыпуститьPAT(Клиент.Войти("root", "RootPassw0rd"));

	ИмяПула = ЗавестиПул();
	Опубликовать();
	Скачать(ИмяПула);
	// то же скачивание по адресу с пулом в ВЕРХНЕМ регистре: хаб такой адрес обслуживает,
	// и написание клиента не имеет права стать вторым рядом метрики
	Скачать(ВРег(ИмяПула));

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;

	УникальныеИмена.УбратьВременное(КаталогСборки);

КонецПроцедуры

// Скачивания считаются на шине событий, и точка данных несёт имя пула: без разреза
// график отвечает «скачали столько-то», но не отвечает «откуда». Сверяется ТОЧКА ДАННЫХ,
// а не подстрока в теле партии: имя прибора встречается в партии и без единого вызова.
&Тест
Процедура СкачиваниеУезжаетСчётчикомСИменемПула() Экспорт

	Сосчитано = ДождатьсяТочкиСПулом(ИмяСчётчикаСкачиваний(), ЖдатьСекунд());

	Ожидаем.Что(Сосчитано >= 1, СтрШаблон(
		"у счётчика %1 есть точка данных пула ""%2"" с непустым числом скачиваний, а её число %3",
		ИмяСчётчикаСкачиваний(), ИмяПула, Сосчитано)).ЭтоИстина();

КонецПроцедуры

// Хаб находит пул по канону и обслуживает адрес с любым написанием имени. В метрику
// имя обязано попасть КАНОНИЧЕСКИМ: иначе один пул рассыпается на ряд написаний, а любой
// аноним перебором регистра набивает измерение до лимита мощности SDK — и после лимита
// настоящие пулы схлопываются в overflow до перезапуска хаба.
&Тест
Процедура СкачиваниеЧужимРегистромНеЗаводитВторогоРяда() Экспорт

	Сосчитано = ДождатьсяТочкиСПулом(ИмяСчётчикаСкачиваний(), ЖдатьСекунд(), 2);

	Ожидаем.Что(Сосчитано >= 2, СтрШаблон(
		"оба скачивания — и каноном, и верхним регистром — сошлись в ОДНОЙ точке пула ""%1"","
		+ " а её число %2", ИмяПула, Сосчитано)).ЭтоИстина();

	Ряды = ПулыПрибора(ИмяСчётчикаСкачиваний());
	Ожидаем.Что(СтрСоединить(Ряды, ", "),
		"у счётчика скачиваний ровно один ряд — канонический пул").Равно(ИмяПула);

КонецПроцедуры

// Публикация — вторая работа хаба, которую оператор считает по пулам.
&Тест
Процедура ПубликацияУезжаетСчётчикомСИменемПула() Экспорт

	Сосчитано = ДождатьсяТочкиСПулом(ИмяСчётчикаПубликаций(), ЖдатьСекунд());

	Ожидаем.Что(Сосчитано >= 1, СтрШаблон(
		"у счётчика %1 есть точка данных пула ""%2"" с непустым числом публикаций, а её число %3",
		ИмяСчётчикаПубликаций(), ИмяПула, Сосчитано)).ЭтоИстина();

КонецПроцедуры

// Числа хаба уезжают датчиками: версии и учётки — по хабу, занятое место — по каждому
// пулу своей точкой данных.
&Тест
Процедура ЧислаХабаУезжаютДатчиками() Экспорт

	Тело = Коллектор.ДождатьсяПартии("metrics", ИмяДатчикаВерсий(), ЖдатьСекунд());

	Ожидаем.Что(Разбор.ЗначениеИзПрибора(Тело, ИмяДатчикаВерсий()) >= 1,
		"датчик версий реестра уехал с непустым числом").ЭтоИстина();
	Ожидаем.Что(Разбор.ЗначениеИзПрибора(Тело, ИмяДатчикаУчёток()) >= 1,
		"датчик учётных записей уехал с непустым числом").ЭтоИстина();

	Занято = ДождатьсяТочкиСПулом(ИмяДатчикаЗанятого(), ЖдатьСекунд());
	Ожидаем.Что(Занято > 0, СтрШаблон(
		"занятое место пула ""%1"" уехало точкой данных со своим именем, а её число %2",
		ИмяПула, Занято)).ЭтоИстина();

КонецПроцедуры

// Срез датчиков заводит ОДИН корень с детьми: до этого каждая служба, которую снимок
// спрашивает, приезжала в трассу отдельной сиротой, и по ней было не понять, чьей работой
// вызван поход в реестр. Родство проверяется ссылкой parentSpanId, а не соседством.
&Тест
Процедура СрезЧиселЗаводитОдинКореньСДетьми() Экспорт

	Родство = ДождатьсяКорняСреза(ЖдатьСекунд());

	Ожидаем.Что(Родство, СтрШаблон(
		"среди уехавших спанов есть корень ""%1"" с ребёнком ""%2""",
		ИмяКорняСреза(), ИмяСпанаРазмеров())).Заполнено();
	Ожидаем.Что(Разбор.ЭтоКорень(Родство.Корень),
		"снимок чисел — корень трассы, а не спан под чужим родителем").ЭтоИстина();
	Ожидаем.Что(Родство.Размеры.Трасса,
		"числа реестра ведут ТУ ЖЕ трассу, что и снимок").Равно(Родство.Корень.Трасса);
	Ожидаем.Что(Родство.Служба <> Неопределено, СтрШаблон(
		"служба ""%1"" пришла ребёнком чисел реестра, а не корнем",
		ИмяСпанаСлужбыПакетов())).ЭтоИстина();

КонецПроцедуры

// Примета публикации на спане службы: трасса приёма обязана называть, ЧТО именно хаб
// принял, иначе публикации в поиске по трассам неразличимы.
&Тест
Процедура СпанПубликацииНазываетПулИФайл() Экспорт

	Спан = ДождатьсяСпанаПубликации(ЖдатьСекунд());

	Ожидаем.Что(Спан, СтрШаблон("спан ""%1"" уехал", ИмяСпанаПубликации())).Заполнено();
	Ожидаем.Что(Спан.Атрибуты["oshub.pool"],
		"спан публикации назвал пул, в который принял версию").Равно(ИмяПула);
	Ожидаем.Что(Спан.Атрибуты["oshub.artifact.file"],
		"и файл, который принял").Равно(ИмяАртефакта());

КонецПроцедуры

// Адрес чисел хаба отдаёт скачивания и занятое место — те же числа, что уезжают
// приборами: график и API обязаны рассказывать о хабе одно и то же.
&Тест
Процедура АдресМетрикОтдаётСкачиванияИОбъём() Экспорт

	Числа = ЧислаИзМетрикAPI();

	Ожидаем.Что(Числа.Получить("downloads_total") >= 1,
		"скачивание, сделанное набором, сосчитано адресом метрик").ЭтоИстина();
	Ожидаем.Что(Числа.Получить("storage_used_bytes") > 0,
		"занятое публичными пулами место отдано адресом метрик").ЭтоИстина();

КонецПроцедуры

#Область Имена

Функция ИмяСчётчикаСкачиваний()
	Возврат "oshub.downloads";
КонецФункции

Функция ИмяСчётчикаПубликаций()
	Возврат "oshub.publications";
КонецФункции

Функция ИмяДатчикаВерсий()
	Возврат "oshub.versions";
КонецФункции

Функция ИмяДатчикаУчёток()
	Возврат "oshub.users";
КонецФункции

Функция ИмяДатчикаЗанятого()
	Возврат "oshub.storage.used_bytes";
КонецФункции

Функция КлючПула()
	Возврат "oshub.pool";
КонецФункции

// Корень трассы, который заводит срез датчиков, и его дети: числа публичного реестра
// и служба, которую те спрашивают.
Функция ИмяКорняСреза()
	Возврат "metrics.hub_numbers";
КонецФункции

Функция ИмяСпанаРазмеров()
	Возврат "metrics.registry_sizes";
КонецФункции

Функция ИмяСпанаСлужбыПакетов()
	Возврат "СервисПакетов.КоличествоВидимыхПакетовПулов";
КонецФункции

Функция ИмяСпанаПубликации()
	Возврат "СервисПубликации.Опубликовать";
КонецФункции

Функция ИмяПакета()
	Возврат "bizpkg";
КонецФункции

Функция ВерсияПакета()
	Возврат "1.0.0";
КонецФункции

Функция ИмяАртефакта()
	Возврат ИмяПакета() + "-" + ВерсияПакета() + ".ospx";
КонецФункции

// Срез метрик идёт раз в две секунды, партия спанов — раз в секунду; порог взят
// с запасом на медленную машину.
Функция ЖдатьСекунд()
	Возврат 120;
КонецФункции

#КонецОбласти

#Область РаботаХаба

Функция ЗавестиПул()

	Имя = УникальныеИмена.Имя("business");
	Ответ = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя), ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);

	Возврат Имя;

КонецФункции

Процедура Опубликовать()

	Данные = Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета(), ВерсияПакета());

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяАртефакта());
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("Authorization", "Bearer " + ТокенRoot);
	Запрос = Новый HTTPЗапрос(СтрШаблон("/api/v1/pools/%1/push", ИмяПула), Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Ожидаем.Что(Ответ.КодСостояния,
		"версия опубликована: " + Клиент.Тело(Ответ)).Равно(201);

КонецПроцедуры

Процедура Скачать(Знач ПулВАдресе)

	Адрес = СтрШаблон("/api/v1/pools/%1/download/%2/%3", ПулВАдресе, ИмяПакета(), ИмяАртефакта());
	Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос(Адрес));

	Ожидаем.Что(Ответ.КодСостояния,
		СтрШаблон("артефакт отдан по адресу с пулом ""%1"" — скачивание сосчитано", ПулВАдресе))
		.Равно(200);

КонецПроцедуры

// Числа адреса /api/v1/metrics — источник правды для сверки с приборами.
Функция ЧислаИзМетрикAPI()

	Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос("/api/v1/metrics"));
	Ожидаем.Что(Ответ.КодСостояния, "эндпоинт метрик отвечает").Равно(200);

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

Функция ВыпуститьPAT(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write"",""пул"":0}", КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;

	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

КонецФункции

#КонецОбласти

#Область ОжиданиеСигналов

// Ждёт точку данных прибора, помеченную ИМЕНЕМ ПУЛА этого набора; -1 — не дождались.
// Читается всё принятое, а не одна партия: точка появляется в том срезе, который снят
// после работы хаба, и это не обязательно первый срез с именем прибора.
Функция ДождатьсяТочкиСПулом(Знач ИмяПрибора, Знач Секунд, Знач Порог = 1)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл

		Найдено = Разбор.НаибольшееСАтрибутом(Коллектор.Принятое("metrics"), ИмяПрибора,
			КлючПула(), ИмяПула);
		Если Найдено >= Порог Тогда
			Возврат Найдено;
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Найдено;
		КонецЕсли;
		Приостановить(1000);

	КонецЦикла;

КонецФункции

// Имена пулов, которыми помечены точки данных прибора, без повторов и по порядку
// появления: ряд на каждое написание — это и есть цена неканонического имени.
Функция ПулыПрибора(Знач ИмяПрибора)

	Ряды = Новый Массив();
	Названные = Новый Соответствие();

	Для Каждого Точка Из Разбор.ТочкиПрибора(Коллектор.Принятое("metrics"), ИмяПрибора) Цикл
		Пул = Точка.Атрибуты[КлючПула()];
		Если Пул <> Неопределено И Названные.Получить(Пул) = Неопределено Тогда
			Названные.Вставить(Пул, Истина);
			Ряды.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;

	Возврат Ряды;

КонецФункции

// Ждёт корень среза чисел вместе с его детьми; Неопределено — не дождались. Спан корня
// уезжает ПОЗЖЕ своих детей — он завершается последним, — поэтому читается всё принятое.
Функция ДождатьсяКорняСреза(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл

		Родство = КореньСреза(Разбор.СпаныПартий(Коллектор.Принятое("traces")));
		Если Родство <> Неопределено Тогда
			Возврат Родство;
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
		Приостановить(1000);

	КонецЦикла;

КонецФункции

// Корень среза, числа реестра под ним и служба под числами; Неопределено — такой связки
// среди спанов нет. Родитель ищется по ссылке: parentSpanId ребёнка обязан совпасть
// с идентификатором спана родителя.
Функция КореньСреза(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл

		Размеры = Пара.Значение;
		Если Размеры.Имя <> ИмяСпанаРазмеров() Тогда
			Продолжить;
		КонецЕсли;

		Корень = Спаны.Получить(Размеры.Родитель);
		Если Корень = Неопределено ИЛИ Корень.Имя <> ИмяКорняСреза() Тогда
			Продолжить;
		КонецЕсли;

		Возврат Новый Структура("Корень, Размеры, Служба",
			Корень, Размеры, РебёнокСИменем(Спаны, Пара.Ключ, ИмяСпанаСлужбыПакетов()));

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ребёнок спана с таким именем; Неопределено — такого среди уехавших нет.
Функция РебёнокСИменем(Знач Спаны, Знач ИдРодителя, Знач Имя)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Родитель = ИдРодителя И Пара.Значение.Имя = Имя Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Спан приёма ИМЕННО этой публикации: имя спана называет службу, атрибут — артефакт.
// По одному имени брать нельзя: спанов публикации на живом хабе бывает несколько.
Функция СпанПубликации(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Имя = ИмяСпанаПубликации()
			И Пара.Значение.Атрибуты["oshub.artifact.file"] = ИмяАртефакта() Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ДождатьсяСпанаПубликации(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл

		Спан = СпанПубликации(Разбор.СпаныПартий(Коллектор.Принятое("traces")));
		Если Спан <> Неопределено Тогда
			Возврат Спан;
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
		Приостановить(1000);

	КонецЦикла;

КонецФункции

#КонецОбласти
