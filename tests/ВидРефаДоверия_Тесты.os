// Словарь видов рефа: синонимы формы и API, отказ на нераспознанном и вид, предлагаемый
// по значению, выведенному из ссылки. Класс чистый — ни контейнера, ни базы здесь нет.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Виды;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКласс() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогКлассов = ОбъединитьПути(КаталогКлассов, "публикация", "Классы");
	ПоискКлассов.Подключить(КаталогКлассов, "ВидРефаДоверия");

	Виды = Новый ВидРефаДоверия();

КонецПроцедуры

#Область Синонимы

// Ключи тела API английские, значения записи русские: «tag», понятый как ветка, давал бы
// запись refs/heads/v*, которая не совпадёт ни с одним запуском.
&Тест
Процедура АнглийскиеИРусскиеСинонимыЧитаютсяОдинаково() Экспорт

	Для Каждого Значение Из СтрРазделить("тег,теги,tag,tags,TAG,Tags, тег ", ",") Цикл
		Ожидаем.Что(Виды.Распознать(Значение), СтрШаблон("«%1» — тег", Значение))
			.Равно(Виды.Тег());
	КонецЦикла;

	Для Каждого Значение Из СтрРазделить("ветка,ветки,branch,branches,BRANCH,Ветка", ",") Цикл
		Ожидаем.Что(Виды.Распознать(Значение), СтрШаблон("«%1» — ветка", Значение))
			.Равно(Виды.Ветка());
	КонецЦикла;

	// пусто — ветка: так работает необязательный параметр домена и так написано в описании API
	Ожидаем.Что(Виды.Распознать(""), "пустое значение — ветка").Равно(Виды.Ветка());
	Ожидаем.Что(Виды.Распознать("   "), "пробелы — тоже").Равно(Виды.Ветка());
	Ожидаем.Что(Виды.Распознать(Неопределено), "и Неопределено").Равно(Виды.Ветка());

КонецПроцедуры

// Нераспознанное значение обязано отвергаться ГРОМКО: молча стать веткой — это ответ 201
// «конвейер вправе публиковать» и отказ на первом же пуше.
&Тест
Процедура НераспознанноеЗначениеНеСтановитсяНиТегомНиВеткой() Экспорт

	Мусор = "тэг,ветвь,tagged,branchy,refs/tags,1,0,Истина,-,тег ветка";

	Для Каждого Значение Из СтрРазделить(Мусор, ",") Цикл
		Ожидаем.Что(Виды.Распознать(Значение),
			СтрШаблон("«%1» не распознано", Значение)).Равно("");
		Ожидаем.Что(Виды.ПричинаОтказа(Значение), "и причина называет значение")
			.Содержит(Значение);
	КонецЦикла;

	Ожидаем.Что(Виды.ПричинаОтказа("тэг"), "в причине названы оба ожидаемых вида")
		.Содержит("branch");

КонецПроцедуры

// Значения печатает форма и читает домен — они обязаны быть теми же строками.
&Тест
Процедура КаноническиеЗначенияВидовНеМеняются() Экспорт

	Ожидаем.Что(Виды.Ветка(), "значение варианта «ветка»").Равно("ветка");
	Ожидаем.Что(Виды.Тег(), "значение варианта «тег»").Равно("тег");
	Ожидаем.Что(Виды.Распознать(Виды.Тег()), "своё же значение распознаётся").Равно(Виды.Тег());
	Ожидаем.Что(Виды.Распознать(Виды.Ветка()), "и второе тоже").Равно(Виды.Ветка());

КонецПроцедуры

#КонецОбласти

#Область ПредложениеПоЗначению

// Полный реф называет пространство имён сам — тут догадок нет вовсе.
&Тест
Процедура ПолныйРефЧитаетсяБезДогадок() Экспорт

	Ожидаем.Что(Виды.ПоЗначению("refs/tags/v1.2.3"), "refs/tags — тег").Равно(Виды.Тег());
	Ожидаем.Что(Виды.ПоЗначению("refs/tags/nightly"), "и без номера версии тоже")
		.Равно(Виды.Тег());
	Ожидаем.Что(Виды.ПоЗначению("refs/heads/v1.2.3"),
		"refs/heads — ветка, даже с номером версии в имени").Равно(Виды.Ветка());
	Ожидаем.Что(Виды.ПоЗначению("refs/pull/12/merge"), "прочие пространства — не тег")
		.Равно(Виды.Ветка());

КонецПроцедуры

// Имя с НОМЕРОМ ВЕРСИИ читается тегом, и суффикс через дефис этого не отменяет: именно
// на дефисе догадка ошибалась в сторону «ветка» — ровно тот дефект, который трек чинит.
&Тест
Процедура ИмяСНомеромВерсииПредлагаетсяТегом() Экспорт

	Имена = "v1.2.3,v1.2.3-rc1,v1.2.3+build.7,1.2.3,2026.08,2026.08.1-hotfix,"
		+ "release-1.2.3,v*,v1,v1.2";

	Для Каждого Значение Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Виды.ПоЗначению(Значение), СтрШаблон("«%1» — тег релиза", Значение))
			.Равно(Виды.Тег());
	КонецЦикла;

КонецПроцедуры

// Где номера версии нет — ветка; косая черта отменяет догадку целиком: «release/1.2» —
// это пространство веток, а не тег.
&Тест
Процедура ИмяБезНомераВерсииПредлагаетсяВеткой() Экспорт

	Имена = "main,master,develop,v2-migration,version-next,*,**,release/*,release/1.2,"
		+ "feature/v1.2.3,hotfix";

	Для Каждого Значение Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Виды.ПоЗначению(Значение), СтрШаблон("«%1» — ветка", Значение))
			.Равно(Виды.Ветка());
	КонецЦикла;

	Ожидаем.Что(Виды.ПоЗначению(""), "пустое значение — ветка").Равно(Виды.Ветка());
	Ожидаем.Что(Виды.ПоЗначению(Неопределено), "и Неопределено").Равно(Виды.Ветка());

КонецПроцедуры

// СЛЕД ИЗВЕСТНОГО РАЗМЕНА: догадка не исчезла, а поменяла сторону ошибки. Ветка с номером
// версии в имени и без пространства («v1.2-maintenance», «support-1.2») теперь предлагается
// ТЕГОМ. Размен принят осознанно: путь один — разбор ссылки, выбор остаётся на глазах
// у человека, а ссылку на тег релиза вставляют чаще, чем на ветку сопровождения.
// Пространство имён догадку отменяет, и это единственный надёжный способ её обойти.
&Тест
Процедура ВеткаСНомеромВерсииПредлагаетсяТегом() Экспорт

	Имена = "v1.2-maintenance,1.10-stable,support-1.2,legacy-0.9";

	Для Каждого Значение Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Виды.ПоЗначению(Значение),
			СтрШаблон("«%1» прочитано тегом — известная и принятая сторона ошибки", Значение))
			.Равно(Виды.Тег());
	КонецЦикла;

	// та же ветка, названная пространством имён, читается веткой — обход догадки есть
	Ожидаем.Что(Виды.ПоЗначению("support/1.2"), "«support/1.2» — ветка").Равно(Виды.Ветка());
	Ожидаем.Что(Виды.ПоЗначению("refs/heads/support-1.2"), "и полный реф ветки — тоже")
		.Равно(Виды.Ветка());

КонецПроцедуры

#КонецОбласти
