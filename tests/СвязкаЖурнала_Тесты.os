// Связка журнала на настоящем контейнере: загрузка настроек собирает узлы logos, ОСень
// и autumn-logos раздают логам способы вывода хаба, и набор смотрит, куда ушла каждая строка —
// в консоль, в память и в коллектор (мост коллектора подменён ловушкой).

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать logos
#Использовать opentelemetry
#Использовать "фикстуры"

Перем Поделка;
Перем ПечатьКонсоли;   // ЛовушкаЛога на месте печати консоли хаба
Перем Мост;            // МостКоллектораЛовушка — что уехало бы в коллектор
Перем Память;          // ПамятьЖурнала
Перем Названные;       // ПробаЖурналаНазванныхЛогов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = КаталогМодулей();
	ПоискКлассов.ПодключитьОснову(Модули);
	Журнал = ОбъединитьПути(Модули, "наблюдаемость", "Классы");
	Для Каждого Имя Из СтрРазделить("ОбезличиваниеЖурнала,ВыводЛогаВКонсольХаба,ВыводЛогаВOTelХаба,"
		+ "ВыводЛогаВПамятьХаба,КольцоЖурнала,ШкалаЖурнала,ПамятьЖурнала,УровниЖурнала", ",") Цикл
		ПоискКлассов.Подключить(Журнал, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ИменаПеременныхОкружения");
	Для Каждого Имя Из СтрРазделить("РасположениеДанных,ИсточникиНастроек,ЗагрузкаНастроек", ",") Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ПробаЖурналаОдинЛог,ПробаЖурналаДваЛога,ПробаЖурналаНазванныхЛогов,"
		+ "МостКоллектораЛовушка,ЛовушкаЛога", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	Загрузка = Новый ЗагрузкаНастроек("", ВыходыСервера());
	Детальки = Загрузка.ДеталькиПоверх(ФайлОператора(), ОкружениеОператора());

	Совет = Новый СоветДругогоМастера();
	// файл настроек проекта сильнее деталек — имя уводится на несуществующее
	Совет.ИмяФайлаСоЗначениямиДеталек("связка-журнала-без-файла");
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	ПечатьКонсоли = Новый ЛовушкаЛога();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Поделка.НайтиЖелудь("ВыводЛогаВКонсольХаба"), "Печать", ПечатьКонсоли);
	Мост = Поделка.НайтиЖелудь("ОтелАппендерLogos");
	Память = Поделка.НайтиЖелудь("ПамятьЖурнала");
	Названные = Поделка.НайтиЖелудь("ПробаЖурналаНазванныхЛогов");

КонецПроцедуры

#Область ТочечныйУровень

// Точечный DEBUG классу с одним внедрением лога ронял каждую его строку: logos снимала
// первый экземпляр способа вывода, а второй оставался без записи уровня.
&Тест
Процедура ТочечныйУровеньНеРоняетСтрокиКлассаСОднимЛогом() Экспорт

	Метка = Метка();
	Лог = Поделка.НайтиЖелудь("ПробаЖурналаОдинЛог").Лог();

	Лог.Отладка("отладка одного лога " + Метка);

	Ожидаем.Что(Лог.Уровень(), "класс получил свой уровень").Равно(УровниЛога.Отладка);
	Ожидаем.Что(СтрокКонсоли(Метка), "строка напечатана ровно один раз").Равно(1);
	Ожидаем.Что(СтрокПамяти(Метка), "и лежит в памяти один раз").Равно(1);
	Ожидаем.Что(СтрокКоллектора("ПробаЖурналаОдинЛог", Метка), "и уехала бы в коллектор").Равно(1);

КонецПроцедуры

// Класс, внедряющий лог дважды, печатал каждую строку два раза.
&Тест
Процедура ТочечныйУровеньНеПечатаетДважды() Экспорт

	Метка = Метка();
	Поделка.НайтиЖелудь("ПробаЖурналаДваЛога").Лог().Отладка("отладка двойного лога " + Метка);

	Ожидаем.Что(СтрокКонсоли(Метка), "строка напечатана один раз").Равно(1);
	Ожидаем.Что(СтрокПамяти(Метка), "и в памяти одна").Равно(1);
	Ожидаем.Что(СтрокКоллектора("ПробаЖурналаДваЛога", Метка), "и в коллекторе одна").Равно(1);

КонецПроцедуры

// Отладка, поднятая одному классу, соседям не открывается нигде — ни в консоли, ни в памяти,
// ни в коллекторе, — а их обычные строки идут как шли.
&Тест
Процедура ТочечнаяОтладкаНеОткрываетсяСоседям() Экспорт

	Метка = Метка();
	Сосед = Названные.Лог("проба.сосед");

	Сосед.Отладка("отладка соседа " + Метка);
	Сосед.Информация("сведение соседа " + Метка);

	Ожидаем.Что(СтрокКонсоли("отладка соседа " + Метка), "отладки соседа в консоли нет").Равно(0);
	Ожидаем.Что(СтрокПамяти("отладка соседа " + Метка), "в памяти нет").Равно(0);
	Ожидаем.Что(СтрокКоллектора("проба.сосед", "отладка соседа " + Метка), "в коллекторе нет").Равно(0);
	Ожидаем.Что(СтрокКонсоли("сведение соседа " + Метка), "его сведение напечатано").Равно(1);
	Ожидаем.Что(СтрокПамяти("сведение соседа " + Метка), "лежит в памяти").Равно(1);
	Ожидаем.Что(СтрокКоллектора("проба.сосед", "сведение соседа " + Метка), "и уехало бы").Равно(1);

КонецПроцедуры

// Выключенная подробность ничего не стоит: у соседа гейт logos закрыт, и строку отладки
// с лишним аргументом никто не собирает. У класса с поднятым уровнем тот же вызов собирается —
// и падает: так видно, что проба различает открытый и закрытый гейт.
&Тест
Процедура ГейтСоседаЗакрытПриТочечнойОтладке() Экспорт

	Сосед = Названные.Лог("проба.сосед");
	Попытка
		Сосед.Отладка("строка %1", "аргумент", "лишний аргумент");
		ГейтСоседаЗакрыт = Истина;
	Исключение
		ГейтСоседаЗакрыт = Ложь;
	КонецПопытки;

	Отлаживаемый = Поделка.НайтиЖелудь("ПробаЖурналаОдинЛог").Лог();
	Попытка
		Отлаживаемый.Отладка("строка %1", "аргумент", "лишний аргумент");
		ГейтОтлаживаемогоОткрыт = Ложь;
	Исключение
		ГейтОтлаживаемогоОткрыт = Истина;
	КонецПопытки;

	Ожидаем.Что(ГейтСоседаЗакрыт, "у соседа строка отладки не собирается").ЭтоИстина();
	Ожидаем.Что(ГейтОтлаживаемогоОткрыт, "у поднятого класса собирается").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Коллектор

// Лог с выключенной отправкой в коллектор молчит только там: консоль и память пишут.
&Тест
Процедура ЛогБезКоллектораПишетВКонсольИПамять() Экспорт

	Метка = Метка();
	Лог = Названные.Лог("проба.безколлектора");

	Лог.Отладка("отладка без коллектора " + Метка);
	Лог.Ошибка("ошибка без коллектора " + Метка);

	Ожидаем.Что(СтрокКонсоли(Метка), "консоль видит обе строки").Равно(2);
	Ожидаем.Что(СтрокПамяти(Метка), "память — тоже").Равно(2);
	Ожидаем.Что(СтрокКоллектора("проба.безколлектора", Метка), "коллектор — ни одной").Равно(0);

КонецПроцедуры

// Порог коллектора WARN у лога на DEBUG: в коллектор — только WARN и выше, в консоль — всё.
&Тест
Процедура ПорогКоллектораПропускаетWARNИНеПропускаетНиже() Экспорт

	Метка = Метка();
	Лог = Названные.Лог("проба.порог");

	Лог.Отладка("отладка " + Метка);
	Лог.Информация("сведение " + Метка);
	Лог.Предупреждение("предупреждение " + Метка);
	Лог.Ошибка("ошибка " + Метка);

	Уехавшие = СобытияКоллектора("проба.порог", Метка);
	Ожидаем.Что(СтрокКонсоли(Метка), "консоль печатает все четыре").Равно(4);
	Ожидаем.Что(Уехавшие.Количество(), "в коллектор — две").Равно(2);
	Для Каждого Событие Из Уехавшие Цикл
		Ожидаем.Что(Событие.Уровень >= УровниЛога.Предупреждение,
			"ниже порога в коллектор не уходит: " + Событие.Текст).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область УзелФайла

// Уровень, названный логу родным узлом logos.logger файла оператора, действует.
&Тест
Процедура УровеньИзУзлаФайлаДействует() Экспорт

	Метка = Метка();
	Названные.Лог("проба.изфайла").Отладка("отладка по файлу " + Метка);

	Ожидаем.Что(СтрокКонсоли(Метка), "отладка лога, поднятая файлом, напечатана").Равно(1);

КонецПроцедуры

// Выходы, названные логу в файле логическими именами, — единственные выходы лога.
&Тест
Процедура ВыходыИзУзлаФайлаДействуют() Экспорт

	Метка = Метка();
	Названные.Лог("проба.вконсоль").Информация("только в консоль " + Метка);

	Ожидаем.Что(СтрокКонсоли(Метка), "консоль — названный выход").Равно(1);
	Ожидаем.Что(СтрокПамяти(Метка), "в память не названа").Равно(0);
	Ожидаем.Что(СтрокКоллектора("проба.вконсоль", Метка), "в коллектор не назван").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Память

// Память получает ту же строку, что консоль и коллектор: после двери, без ящика почты.
&Тест
Процедура ПамятьХранитСтрокуПослеДвери() Экспорт

	Метка = Метка();
	Названные.Лог("проба.сосед").Предупреждение("письмо не ушло получателю segate@inbox.ru " + Метка);

	Отбор = Новый Структура("Содержит", Метка);
	Записи = Память.Хвост(Отбор);
	Ожидаем.Что(Записи.Количество(), "строка в памяти").Равно(1);
	Ожидаем.Что(Записи[0].Текст, "ящик снят дверью").Содержит("s***@inbox.ru");
	Ожидаем.Что(СтрНайти(Записи[0].Текст, "segate@"), "сырого ящика нет").Равно(0);
	Ожидаем.Что(Записи[0].Лог, "лог назван").Равно("проба.сосед");
	Ожидаем.Что(Записи[0].Уровень, "уровень словом").Равно("WARN");
	Ожидаем.Что(Память.Хвост(Новый Структура("Содержит, ТолькоВажное", Метка, Истина)).Количество(),
		"предупреждение лежит и в кольце важного").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ТаблицаСтарта

// Экран показывает, с каким уровнем лог живёт по настройкам и откуда он задан: деталька
// oshub.log.startup называет переменную либо ключ файла.
&Тест
Процедура ТаблицаСтартаНазываетУровеньИИсточник() Экспорт

	Таблица = Поделка.НайтиДетальку("oshub.log.startup");

	Порог = Таблица["проба.порог"];
	Ожидаем.Что(Порог["Уровень"], "уровень лога").Равно("DEBUG");
	Ожидаем.Что(Порог["Свой"], "назван именно ему").ЭтоИстина();
	Ожидаем.Что(Порог["Откуда"], "из окружения").Равно("окружение");
	Ожидаем.Что(Порог["ИмяНастройки"], "переменной").Равно("OSHUB_LOG_LEVELS");
	Ожидаем.Что(Порог["Порог"], "порог коллектора").Равно("WARN");
	Ожидаем.Что(Порог["ПорогИмяНастройки"], "его переменная").Равно("OSHUB_LOG_OTEL_LEVELS");

	ИзФайла = Таблица["проба.изфайла"];
	Ожидаем.Что(ИзФайла["Откуда"], "уровень из файла").Равно("файл");
	Ожидаем.Что(ИзФайла["ИмяНастройки"], "ключом узла").Равно("logos.logger.проба.изфайла");

	Корень = Таблица["rootLogger"];
	Ожидаем.Что(Корень["Уровень"], "корень — умолчание").Равно("INFO");
	Ожидаем.Что(Корень["Откуда"]).Равно("умолчание");
	Ожидаем.Что(СтрСоединить(Корень["Выходы"], ","), "все выходы сервера").Равно("console,memory,otel");

КонецПроцедуры

#КонецОбласти

#Область Обвязка

Функция ВыходыСервера()
	Выходы = Новый Соответствие();
	Выходы.Вставить("console", "ВыводЛогаВКонсольХаба");
	Выходы.Вставить("memory", "ВыводЛогаВПамятьХаба");
	Выходы.Вставить("otel", "ВыводЛогаВOTelХаба");
	Возврат Выходы;
КонецФункции

// Узел logos.logger файла оператора: уровень строкой одному логу, выходы вместо корневых — другому.
Функция ФайлОператора()

	Выходы = Новый Массив();
	Выходы.Добавить("console");
	ТолькоКонсоль = Новый Соответствие();
	ТолькоКонсоль.Вставить("level", "INFO");
	ТолькоКонсоль.Вставить("appenders", Выходы);
	ТолькоКонсоль.Вставить("additivity", Ложь);

	Логгеры = Новый Соответствие();
	Логгеры.Вставить("проба.изфайла", "DEBUG");
	Логгеры.Вставить("проба.вконсоль", ТолькоКонсоль);
	Узел = Новый Соответствие();
	Узел.Вставить("logger", Логгеры);
	Файл = Новый Соответствие();
	Файл.Вставить("logos", Узел);
	Возврат Файл;

КонецФункции

// Так переменные отдаёт провайдер окружения configor: ключ через точку.
Функция ОкружениеОператора()

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB.LOG.LEVELS", "ПробаЖурналаОдинЛог=DEBUG,ПробаЖурналаДваЛога=DEBUG,"
		+ "проба.безколлектора=DEBUG,проба.порог=DEBUG");
	Окружение.Вставить("OSHUB.LOG.OTEL.LEVELS", "проба.безколлектора=DISABLE,проба.порог=WARN");
	Возврат Окружение;

КонецФункции

Функция Метка()
	Возврат "метка-" + Строка(Новый УникальныйИдентификатор());
КонецФункции

Функция СтрокКонсоли(Знач Фрагмент)
	Сколько = 0;
	Для Номер = 0 По ПечатьКонсоли.Количество() - 1 Цикл
		Если СтрНайти(ПечатьКонсоли.Сообщение(Номер), Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;
КонецФункции

Функция СтрокПамяти(Знач Фрагмент)
	Возврат Память.Хвост(Новый Структура("Содержит, Количество", Фрагмент, 100000)).Количество();
КонецФункции

Функция СобытияКоллектора(Знач ИмяЛога, Знач Фрагмент)
	Результат = Новый Массив();
	Для Каждого Событие Из Мост.СобытияЛога(ИмяЛога) Цикл
		Если СтрНайти(Событие.Текст, Фрагмент) > 0 Тогда
			Результат.Добавить(Событие);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтрокКоллектора(Знач ИмяЛога, Знач Фрагмент)
	Возврат СобытияКоллектора(ИмяЛога, Фрагмент).Количество();
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
