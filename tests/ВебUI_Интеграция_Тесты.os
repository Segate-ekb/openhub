КонецПроцедуры

// Знак бренда объявлен картинкой в шапке КАЖДОЙ страницы: адрес берётся из самой
// разметки и запрашивается по HTTP — объявление без работающей отдачи оставляет
// пользователя с битой картинкой вместо логотипа.
&Тест
Процедура ЗнакБрендаОтдаётсяПоСсылкеИзШапки() Экспорт

	Главная = Тело(GET("/"));
	Адрес = АдресЗнака(Главная);

	// знак шапки и иконка вкладки — РАЗНЫЕ файлы: подмена одного другим не ловится
	// ни кодом ответа, ни типом, потому что оба — SVG из того же каталога
	Ожидаем.Что(Адрес = АдресИконки(Главная),
		"знак шапки не подменён иконкой сайта: " + Адрес).ЭтоЛожь();

	Знак = GET(Адрес);
	Ожидаем.Что(Знак.КодСостояния, "знак отдаётся").Равно(200);
	Ожидаем.Что(СтрНайти(НРег(ЗаголовокОтвета(Знак, "Content-Type")), "image/svg+xml") > 0,
		"знак отдаётся как SVG").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Знак), "<svg") > 0, "в теле действительно SVG").ЭтоИстина();

	// шапка внутренних страниц — та же самая
	Ожидаем.Что(АдресЗнака(Тело(GET("/packages"))), "знак в шапке каталога тот же").Равно(Адрес);

КонецПроцедуры

// Запасной .ico и иконка домашнего экрана: тип объявлен один раз в таблице активов,
// и клиент обязан получить именно его — .ico, отданный как SVG, значка не даёт.
&Тест
Процедура ЗапаснаяИконкаИИконкаЭкранаОтдаютсяСоСвоимиТипами() Экспорт

	HTML = Тело(GET("/"));

	Запасная = МеждуМаркеров(HTML, "<link rel=""icon"" sizes=""any"" href=""", """");
	Экранная = МеждуМаркеров(HTML, "<link rel=""apple-touch-icon"" href=""", """");

	Ожидаем.Что(СтрНачинаетсяС(Запасная, "/static/favicon-"),
		"запасная иконка объявлена с хешем: " + Запасная).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Экранная, "/static/apple-touch-icon-"),
		"иконка домашнего экрана объявлена с хешем: " + Экранная).ЭтоИстина();

	Ico = GET(Запасная);
	Ожидаем.Что(Ico.КодСостояния, "запасная иконка отдаётся").Равно(200);
	Ожидаем.Что(НРег(ЗаголовокОтвета(Ico, "Content-Type")), "и типом .ico")
		.Равно("image/vnd.microsoft.icon");

	Png = GET(Экранная);
	Ожидаем.Что(Png.КодСостояния, "иконка домашнего экрана отдаётся").Равно(200);
	Ожидаем.Что(НРег(ЗаголовокОтвета(Png, "Content-Type")), "и типом PNG").Равно("image/png");

КонецПроцедуры

