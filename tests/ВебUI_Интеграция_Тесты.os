Процедура СтраницаОсмысленнаБезJS() Экспорт

	// вырезаем все <script>…</script> — страница обязана остаться работоспособной
	БезСкриптов = БезТеговScript(Тело(GET("/main/winow/versions")));

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, КомандаУстановки("main", "winow")) > 0,
		"команда установки видна").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "1.1.0") > 0, "таблица версий на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "href=""/packages""") > 0, "навигация — обычные ссылки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);

	// вкладки без JS: активная помечена aria-current, соседние — href-ами; проверяем на странице без скриптов
	Ожидаем.Что(СтрНайти(БезСкриптов, "href=""/main/winow/deps""") > 0,
		"соседняя вкладка достижима ссылкой без JS").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "aria-current=""page""") > 0,
		"текущая вкладка помечена для скринридера").ЭтоИстина();

	// переключатель темы был кнопкой, которую СОЗДАВАЛ скрипт: теперь это POST-форма, и она обязана быть в разметке
	Ожидаем.Что(СтрНайти(БезСкриптов, "action=""/ui/theme""") > 0,
		"переключатель темы — серверная форма, а не создание скриптом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, ">Тема<"), "слова «Тема» в переключателе нет").Равно(0);

