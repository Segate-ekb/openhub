КонецПроцедуры

// Витрина ищет так же, как API: опечатка в один символ не оборачивается пустым экраном,
// а слово из описания находит пакет, в имени которого его нет. Рядом КОНТРОЛЬ на выдуманное
// слово — иначе «нашлось» доказывалось бы страницей, которая показывает всё подряд.
&Тест
Процедура ВитринаНаходитПакетПоОпечаткеИПоСловуИзОписания() Экспорт

	ПоОпечатке = Тело(GET("/packages?q=winov"));
	Ожидаем.Что(СтрНайти(ПоОпечатке, "href=""/main/winow""") > 0,
		"запрос с опечаткой в один символ приводит к пакету").ЭтоИстина();

	ПоОписанию = Тело(GET("/packages?q=" + Кодированное("фреймворк")));
	Ожидаем.Что(СтрНайти(ПоОписанию, "href=""/main/winow""") > 0,
		"слово из описания — тоже дорога к пакету, хотя в имени его нет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоОписанию, "href=""/main/autumn"""),
		"пакет, к слову не относящийся, в выдачу не попал").Равно(0);

	Ожидаем.Что(СтрНайти(Тело(GET("/packages?q=zzqqxx")), "href=""/main/winow"""),
		"КОНТРОЛЬ: на выдуманное слово витрина пакет не показывает").Равно(0);

КонецПроцедуры

&Тест
Процедура СтраницаПула() Экспорт

	Ответ = GET("/main");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Тело = Тело(Ответ);

	// печаталось техническое значение колонки («тип: custom»): регресс держит ЧЕЛОВЕЧЕСКУЮ подпись
	Ожидаем.Что(СтрНайти(Тело, "Публичный") > 0, "читаемая подпись видимости").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "Проектный"), "плашки проектного типа нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "тип: custom"), "техническое значение колонки не печатается").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "видимость: public"), "техническое значение видимости не печатается").Равно(0);

	Ожидаем.Что(СтрНайти(Тело, "winow") > 0, "пакет пула").ЭтоИстина();

КонецПроцедуры

&Тест
&Тег("смоук")
Процедура СтраницаПакетаСREADME() Экспорт

	Ответ = GET("/main/winow");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Тело = Тело(Ответ);

	// команда установки (главный CTA) — часть шапки, видна на КАЖДОЙ вкладке. Пакет лежит
	// в пуле main, а не в дефолтном: команда обязана нести адрес хаба и пул, иначе она ставит
	// одноимённый пакет из пула по умолчанию, настроенного у клиента.
	Ожидаем.Что(СтрНайти(Тело, КомандаУстановки("main", "winow")) > 0,
		"команда установки с адресом хаба и пулом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "opm install winow"),
		"короткой формы у пакета не дефолтного пула быть не должно").Равно(0);
	// README отрендерен (легитимный заголовок) — это вкладка «Описание»
	Ожидаем.Что(СтрНайти(Тело, "Демо-пакет winow") > 0, "заголовок README отрендерен").ЭтоИстина();

	// ВКЛАДКИ (З-8): у каждой СВОЙ URL и это обычные ссылки, а не JS-переключение
	Ожидаем.Что(СтрНайти(Тело, "href=""/main/winow/versions""") > 0,
		"вкладка версий — обычная ссылка со своим URL").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "href=""/main/winow/deps""") > 0,
		"вкладка зависимостей — обычная ссылка со своим URL").ЭтоИстина();

КонецПроцедуры

// ИСТ-ПУБЛ-020: значок доверенной публикации виден там, где человек видит версию —
// в шапке страницы (она говорит о версии, которая ставится без указания версии) и в
// списке версий. Засев: winow 1.1.0 приехала доверенной публикацией, 1.0.0 и autumn — нет.
&Тест
Процедура ЗначокДоверенногоКонвейераВиденНаСтраницеПакета() Экспорт

	Шапка = Тело(GET("/main/winow"));
	Ожидаем.Что(СтрНайти(НРег(Шапка), "доверенный конвейер") > 0,
		"значок доверенной публикации в шапке страницы пакета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "Опубликовано доверенным конвейером") > 0,
		"и подсказка называет механизм словами").ЭтоИстина();

	// шапка на вкладке версий та же, поэтому считаем ТОЛЬКО в таблице — от заголовка
	// колонки sha256 и ниже: там по строке на версию, и помеченной обязана быть одна
	Список = Тело(GET("/main/winow/versions?flat=1"));
	Таблица = Сред(НРег(Список), СтрНайти(НРег(Список), "sha256"));
	Ожидаем.Что(ВхожденийПодстроки(Таблица, "доверенный конвейер"),
		"в списке версий значок ровно у одной строки из двух").Равно(1);
	Ожидаем.Что(СтрНайти(Таблица, "1.0.0") > 0, "и вторая версия в таблице есть").ЭтоИстина();

	// КОНТРОЛЬ: пакет без доверенных публикаций значка не получает — и не помечается
	// «непроверенным»: доверенная публикация остаётся опцией
	Соседний = Тело(GET("/main/autumn"));
	Ожидаем.Что(СтрНайти(НРег(Соседний), "конвейер"),
		"у пакета без доверенных публикаций значка нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Соседний), "не проверен"),
		"и обратного клейма тоже").Равно(0);

КонецПроцедуры

// Вкладка версий по умолчанию сгруппирована по тегам: канал, его актуальная версия, готовая команда установки и
// разворачиваемая история — пришедший за установкой видит несколько каналов, а не сто строк истории.
&Тест
Процедура ВкладкаВерсийГруппируетВерсииПоТегам() Экспорт

	Ответ = GET("/main/winow/versions");
	Ожидаем.Что(Ответ.КодСостояния, "вкладка версий открывается своим адресом").Равно(200);

	Тело = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело, "Актуальная версия") > 0, "колонка актуальной версии канала").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "stable") > 0, "канал stable показан").ЭтоИстина();
	// главное, ради чего группировка и делалась: команда установки ПО КАНАЛУ
	Ожидаем.Что(СтрНайти(Тело, КомандаУстановки("main", "winow", "stable")) > 0,
		"команда установки по тегу — с адресом хаба и пулом").ЭтоИстина();
	// история канала — разворачиваемая, без JS
	Ожидаем.Что(СтрНайти(Тело, "<details><summary>версий:") > 0,
		"история канала свёрнута в <details>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "1.1.0") > 0, "версия из истории канала").ЭтоИстина();

	// README сюда не попадает: вкладка — отдельная страница, а не свёрнутый блок
	Ожидаем.Что(СтрНайти(Тело, "Демо-пакет winow"), "README живёт на своей вкладке").Равно(0);

КонецПроцедуры

// Группировка выключается: плоский список версий — второе представление, отвечающее на «что публиковалось и когда».
&Тест
Процедура ПлоскийСписокВерсийВключаетсяСсылкой() Экспорт

	Сгруппировано = Тело(GET("/main/winow/versions"));
	Ожидаем.Что(СтрНайти(Сгруппировано, "?flat=1") > 0,
		"со сгруппированной вкладки есть ссылка на плоский список").ЭтоИстина();

	Плоско = Тело(GET("/main/winow/versions?flat=1"));
	Ожидаем.Что(СтрНайти(Плоско, "sha256") > 0, "плоский список: колонка sha256").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Плоско, "Каналы") > 0, "плоский список: колонка каналов (З-4)").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Плоско, "1.1.0") > 0, "последняя версия в таблице").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Плоско, "1.0.0") > 0, "старая версия в таблице").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Плоско, КомандаУстановки("main", "winow", "1.1.0")) > 0,
		"плоский список: установка точной версии с адресом хаба и пулом").ЭтоИстина();
	// и обратная ссылка — переключатель работает в обе стороны
	Ожидаем.Что(СтрНайти(Плоско, "Сгруппировать версии по тегам") > 0,
		"с плоского списка есть возврат к группировке").ЭтоИстина();

	// колонки актуальной версии канала в плоском представлении нет
	Ожидаем.Что(СтрНайти(Плоско, "Актуальная версия"), "плоский список не группирует").Равно(0);

КонецПроцедуры

// Пакет БЕЗ ЕДИНОГО КАНАЛА печатается плоским списком: версии с апстрима событий публикации не порождают, базовых
// тегов у такого пакета нет — фикстура victim заведена без тегов ровно для этой ветки.
&Тест
Процедура ПакетБезКаналовПоказываетПлоскийСписок() Экспорт

	Тело = Тело(GET("/main/victim/versions"));
	Ожидаем.Что(СтрНайти(Тело, "sha256") > 0, "плоский список версий").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "Актуальная версия"),
		"группировки нет — группировать нечего").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "1.0.0") > 0, "версия пакета на месте").ЭтоИстина();

КонецПроцедуры

// Адресную форму понимает только доработанный клиент opm, поэтому рядом обязан стоять
// способ, работающий со штатным: пул сервером в opm.cfg плюс установка через -m.
&Тест
Процедура СтраницаПакетаПоказываетВторойСпособУстановки() Экспорт

	Тело = Тело(GET("/main/winow"));

	Ожидаем.Что(СтрНайти(Тело, "/api/v1/pools/main/download/") > 0,
		"путь пула для opm.cfg").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "opm install -m main winow") > 0,
		"установка через сервер из opm.cfg").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, СтрШаблон("http://localhost:%1", Формат(Порт, "ЧГ=0"))) > 0,
		"порт продублирован в адресе сервера").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "Авторизация"),
		"публичному пулу поле ключа в конфигурации не нужно").Равно(0);

КонецПроцедуры

// Подсказку установки проверяет не сверка букв, а то, ради чего она написана: тест берёт
// со страницы узел, пул и путь выдачи — и качает по ним пакет. Врущий адрес выглядит
// на странице ровно так же, как верный, и отличить их можно только запросом.
&Тест
Процедура ПоАдресуИзПодсказкиУстановкиПакетДействительноСкачивается() Экспорт

	Страница = Тело(GET("/main/winow"));

	Цель = ЦельАдреснойКоманды(Страница);
	Части = СтрРазделить(Цель, "/", Ложь);
	Ожидаем.Что(Части.Количество(), "команда называет узел, пул и пакет: " + Цель).Равно(3);

	Узел = Части[0];
	ПулКоманды = Части[1];
	ПакетКоманды = Части[2];

	ПутьВыдачи = ПутьВыдачиИзОбразцаКонфига(Страница);
	Ожидаем.Что(СтрНайти(ПутьВыдачи, "/" + ПулКоманды + "/") > 0,
		"обе подсказки страницы говорят об одном пуле: " + Цель + " и " + ПутьВыдачи).ЭтоИстина();

	Файл_ = СкачатьСУзла(Узел, ПутьВыдачи + ПакетКоманды + "/" + ПакетКоманды + ".ospx");

	Ожидаем.Что(Файл_.КодСостояния, "по адресу из подсказки хаб отдаёт пакет").Равно(200);
	Ожидаем.Что(Файл_.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "и это не пустышка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заголовок(Файл_, "Content-Disposition"), ПакетКоманды) > 0,
		"и файл именно того пакета, чью страницу открыли").ЭтоИстина();

КонецПроцедуры

// Пакет приватного пула без ключа не ставится ничем: об этом на странице сказано прямо,
// иначе человек получает «не найдено» и гадает почему.
&Тест
Процедура СтраницаПакетаПриватногоПулаГоворитПроКлюч() Экспорт

	Тело = Тело(GET("/vault9/hushlib", КукиСессии(Войти("seed-insider", "SeedPassw0rd"))));

	Ожидаем.Что(СтрНайти(Тело, КомандаУстановки("vault9", "hushlib")) > 0,
		"команда с адресом хаба и приватным пулом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "PAT") > 0, "названо, что нужен токен доступа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "Авторизация") > 0,
		"и поле, которым токен передаётся серверу пакетов").ЭтоИстина();

КонецПроцедуры

// НФТ-КАТ-003: страница README — самая дорогая на витрине, поэтому её ответ объявляет
// КОРОТКИЙ срок повторного использования и метку ресурса, а совпавший If-None-Match даёт
// 304 без тела. Срок короткий, чтобы новая публикация становилась видна сама.
&Тест
Процедура СтраницаПакетаПереиспользуетсяПоСрокуИМетке() Экспорт

	Ответ = GET("/main/winow");
	Кэш = Заголовок(Ответ, "Cache-Control");
	Метка = Заголовок(Ответ, "ETag");

	Ожидаем.Что(СтрНайти(Кэш, "public") > 0, "публичная страница годна общему кэшу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кэш, "max-age=") > 0, "срок повторного использования объявлен").ЭтоИстина();
	Ожидаем.Что(Секунды(Кэш) > 0 И Секунды(Кэш) <= 300,
		"срок КОРОТКИЙ: новая публикация становится видна без вмешательства (было "
		+ Кэш + ")").ЭтоИстина();
	Ожидаем.Что(СтрДлина(Метка), "метка ресурса — sha256 в кавычках: [" + Метка + "]").Равно(66);

	Повтор = GET("/main/winow", СЗаголовком("If-None-Match", Метка));
	Ожидаем.Что(Повтор.КодСостояния, "совпавшая метка → 304").Равно(304);
	Ожидаем.Что(Повтор.ПолучитьТелоКакСтроку(), "и без тела").Равно("");

	Чужая = GET("/main/winow", СЗаголовком("If-None-Match", """nosuchtag"""));
	Ожидаем.Что(Чужая.КодСостояния, "КОНТРОЛЬ: чужая метка отдаёт страницу целиком").Равно(200);

КонецПроцедуры

// Отбор по правам сроком не обходится: страница приватного пула не попадает в общий кэш
// ни на секунду, иначе следующий читатель получил бы её от прокси без проверки прав.
&Тест
Процедура СтраницаПриватногоПулаВОбщийКэшНеПопадает() Экспорт

	Ответ = GET("/vault9/hushlib", КукиСессии(Войти("seed-insider", "SeedPassw0rd")));
	Кэш = Заголовок(Ответ, "Cache-Control");

	Ожидаем.Что(СтрНайти(Кэш, "no-store") > 0,
		"приватная страница не хранится ни в каком кэше (было " + Кэш + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кэш, "public"),
		"и общему кэшу не предлагается").Равно(0);

	// КОНТРОЛЬ: публичная страница того же хаба общему кэшу предлагается
	Ожидаем.Что(СтрНайти(Заголовок(GET("/main/winow"), "Cache-Control"), "public") > 0,
		"КОНТРОЛЬ: публичная страница остаётся кэшируемой").ЭтоИстина();

КонецПроцедуры

// README конкретной версии неизменяем: его ответ по машинному адресу переиспользуется
// по метке и коротким сроком не ограничен, а безверсионный — ограничен.
&Тест
Процедура ReadmeВерсииПереиспользуетсяДольшеБезверсионного() Экспорт

	Версия = Заголовок(GET("/api/v1/pools/main/packages/winow/readme?version=1.1.0"), "Cache-Control");
	БезВерсии = Заголовок(GET("/api/v1/pools/main/packages/winow/readme"), "Cache-Control");

	Ожидаем.Что(Секунды(Версия) > Секунды(БезВерсии),
		СтрШаблон("README версии живёт дольше безверсионного (%1 против %2)",
			Версия, БезВерсии)).ЭтоИстина();
	Ожидаем.Что(Секунды(БезВерсии) > 0 И Секунды(БезВерсии) <= 300,
		"а безверсионный остаётся коротким: " + БезВерсии).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВкладкаЗависимостейПоказываетОбеСтороны() Экспорт

	Ответ = GET("/main/winow/deps");
	Ожидаем.Что(Ответ.КодСостояния, "вкладка зависимостей открывается своим адресом").Равно(200);

	Тело = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело, "Зависит от") > 0, "блок зависимостей").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "Кто зависит") > 0, "блок обратных зависимостей").ЭтоИстина();

	// хаб везде называет пакет каноническим именем: в засеве winow объявил зависимость
	// как "Autumn", а в блоке «Зависит от» обязано стоять "autumn"
	Блок = БлокЗависитОт(Тело);
	Ожидаем.Что(СтрНайти(Блок, "autumn") > 0, "зависимость названа канонически").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Блок, "Autumn"),
		"написания автора манифеста на вкладке нет").Равно(0);

КонецПроцедуры

// Имя зависимости — вход в её страницу, пока пакет лежит в том же пуле. Чужое имя
// приезжает из манифеста кем угодно, поэтому остаётся текстом и печатается экранированным.
&Тест
Процедура ИмяЗависимостиВедётНаПакетСвоегоПула() Экспорт

	Блок = БлокЗависитОт(Тело(GET("/main/winow/deps")));

	Ожидаем.Что(СтрНайти(Блок, "<a href=""/main/autumn"">autumn</a>") > 0,
		"пакет своего пула назван ссылкой на свою страницу").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Блок, "ghost&lt;b&gt;") > 0,
		"имя, которого в пуле нет, напечатано экранированным текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Блок, "ghost<b>"),
		"канон имени разметкой на страницу не попал").Равно(0);
	Ожидаем.Что(СтрНайти(Блок, "Ghost<b>"),
		"и написание автора манифеста тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Блок, "href=""/main/ghost"),
		"и ссылкой несуществующий пакет не стал").Равно(0);

КонецПроцедуры

&Тест
Процедура СтраницаПакетаПоказываетКтоЗависит() Экспорт

	// исходный сценарий дефекта: КонтроллерПакета.СписокКтоЗависит резолвит версию ПО ИДЕНТИФИКАТОРУ, метод не был
	// объявлен в репозитории, и страница отдавала 500. Засев: winow зависит от autumn, вкладка зависимостей — свой URL.
	Ответ = GET("/main/autumn/deps");
	Ожидаем.Что(Ответ.КодСостояния, "страница пакета с обратными зависимостями открывается").Равно(200);

	Тело = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело, "Кто зависит") > 0, "блок обратных зависимостей").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "winow") > 0, "зависящий пакет разрезолвлен по идентификатору версии").ЭтоИстина();

	// и он действительно РАЗРЕЗОЛВЛЕН: пустой блок означал бы, что версия по идентификатору снова Неопределено
	Начало = СтрНайти(Тело, "Кто зависит");
	Ожидаем.Что(СтрНайти(Сред(Тело, Начало), "winow") > 0,
		"winow именно в блоке «Кто зависит», а не только в шапке").ЭтоИстина();

КонецПроцедуры

// Обратный граф — часть ПУБЛИЧНОЙ страницы: пакет приватного пула, зависящий от публичного
// autumn, не имеет права называть ни себя, ни свой пул тому, кто пул не читает. Засев: пул
// vault9 (private) с пакетом hushlib, зависящим от autumn.
&Тест
Процедура ОбратныйГрафСкрываетПриватноеОтАнонима() Экспорт

	Страница = Тело(GET("/main/autumn/deps"));

	// предпосылка: блок собран из настоящих данных, а не пуст — публичный зависящий пакет в нём есть
	Ожидаем.Что(СтрНайти(Сред(Страница, СтрНайти(Страница, "Кто зависит")), "winow") > 0,
		"предпосылка: обратный граф наполнен").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница, "hushlib"), "аноним не видит имени приватного пакета").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "vault9"), "аноним не видит имени приватного пула").Равно(0);

КонецПроцедуры

&Тест
Процедура ОбратныйГрафСкрываетПриватноеОтПостороннего() Экспорт

	Сессия = Войти("seed-user", "SeedPassw0rd");
