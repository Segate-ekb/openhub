&Тест
Процедура ПереключательТемыВыставляетКукуОформления() Экспорт

	// удаление записи куки целиком оставляло наборы зелёными: соседний тест смотрел на адрес редиректа, а юнит — на
	// значение в изоляции. Смотрим сам ответ /ui/theme, поэтому переходы клиента запрещены
	Ответ = POSTБезРедиректа("/ui/theme", "http://localhost:" + Формат(Порт, "ЧН=0; ЧГ=0") + "/packages");

	Ожидаем.Что(Ответ.КодСостояния, "переключение темы отвечает редиректом").Равно(302);

	Кука = ЗаголовокКуки(Ответ);
	Ожидаем.Что(СтрНайти(Кука, "oshub_ui=") > 0, "кука оформления выставлена").ЭтоИстина();
	// значение url-кодировано РОВНО ОДИН раз: двойное кодирование дало бы браузеру мусор вместо пар «ключ=значение»
	Ожидаем.Что(СтрНайти(Кука, "%D1%82%D0%B5%D0%BC%D0%B0") > 0,
		"в куке действительно поле «тема»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Кука), "%25d1%2582"), "двойного кодирования нет (Р-7)").Равно(0);

	// Р-6: без Max-Age кука сессионная — выбор темы не переживал бы закрытие браузера
	Ожидаем.Что(СтрНайти(НРег(Кука), "max-age=31536000") > 0, "кука живёт год, а не сессию").ЭтоИстина();
	// и она НЕ HttpOnly: секрета в настройке вида нет, а winow ставит флаг по умолчанию
	Ожидаем.Что(СтрНайти(НРег(Кука), "httponly"), "кука оформления не httponly").Равно(0);

	// тема действительно переключилась относительно исходной (сервер печатал тёмную)
	Ожидаем.Что(СтрНайти(Кука, "%D1%81%D0%B2%D0%B5%D1%82%D0%BB%D0%B0%D1%8F") > 0,
		"значение темы — «светлая»").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПереключательТемыРаботаетБезJS() Экспорт

	// тема переключается СЕРВЕРОМ — обычный POST без скрипта. HTTP-клиент здесь ходит по редиректам сам, поэтому тест
	// разбирает оба исхода: либо 3xx с Location, либо уже отрисованную целевую страницу
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Referer", "http://localhost:" + Формат(Порт, "ЧН=0; ЧГ=0") + "/packages");

	Ответ = POST("/ui/theme", Заголовки);

	Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда
		Ожидаем.Что(СтрНайти(ЗаголовокLocation(Ответ), "/packages") > 0,
			"возврат на ту же страницу").ЭтоИстина();
	Иначе
		Ожидаем.Что(Ответ.КодСостояния, "после редиректа — целевая страница").Равно(200);
		Ожидаем.Что(СтрНайти(Тело(Ответ), "Каталог пакетов") > 0,
			"вернулись именно в каталог, откуда пришли").ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура ПереключательТемыНеУводитНаЧужойХост() Экспорт

	// Referer — недоверенный ввод: из него берётся ТОЛЬКО путь, иначе переключатель темы стал бы открытым редиректом.
	// Доказательство при клиенте, идущем по редиректам: мы остаёмся на СВОЁМ хабе и получаем от него 404 на «/phish»
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Referer", "https://evil.example/phish");

	Ответ = POST("/ui/theme", Заголовки);

	Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда
		Место = ЗаголовокLocation(Ответ);
		Ожидаем.Что(СтрНайти(Место, "evil.example"), "чужой хост не попадает в Location").Равно(0);
		Ожидаем.Что(СтрНайти(Место, "/phish") > 0, "использован только путь чужого Referer").ЭтоИстина();
	Иначе
		Ожидаем.Что(Ответ.КодСостояния, "остались на своём хабе: его 404 на чужой путь").Равно(404);
		Ожидаем.Что(СтрНайти(Тело(Ответ), "evil.example"), "чужой хост нигде не отражён").Равно(0);
	КонецЕсли;

КонецПроцедуры

// POST БЕЗ следования редиректу (1connector): выключаем именно РазрешитьПеренаправление — при нулевом лимите
// переходов коннектор бросает «СлишкомМногоПеренаправлений» вместо ответа.
Функция POSTБезРедиректа(Знач Путь, Знач Источник)

	Сессия = Новый Сессия();
	Сессия.Заголовки.Вставить("Referer", Источник);
	Параметры = Новый Структура("РазрешитьПеренаправление", Ложь);
	Возврат Сессия.ВызватьМетод("POST",
		СтрШаблон("http://localhost:%1%2", Формат(Порт, "ЧГ=0"), Путь), Параметры);

КонецФункции

// Set-Cookie ИМЕННО запрашиваемой куки (имя заголовка регистронезависимо): в том же ответе winow выставляет
// сессионную куку, и склейка двух кук ломала бы проверки флагов и кодирования.
// Тег <html> ровно в том виде, как его печатает каркас страницы. Подстрока
// «data-theme="light"» истинной бывает ВСЕГДА: тем же текстом ТокеныТемы печатают
// селектор светлой палитры в <head> каждой страницы, и сторож на ней тождествен.
Функция ТегHTML(Знач Тема)
	Возврат СтрШаблон("<html lang=""ru"" data-theme=""%1"">", Тема);
КонецФункции

Функция ЗаголовокКуки(Знач Ответ, Знач Имя = "oshub_ui")

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		// 1connector склеивает несколько заголовков Set-Cookie в ОДНО значение через ", ", а атрибуты внутри одной куки
		// разделены «;» — делим по запятой (запятая внутри куки бывает только в Expires, здесь его нет)
		Для Каждого Часть Из СтрРазделить(Строка(КиЗ.Значение), ",", Ложь) Цикл
			Если СтрНачинаетсяС(СокрЛП(Часть), Имя + "=") Тогда
				Возврат СокрЛП(Часть);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция POST(Знач Путь, Знач Заголовки = Неопределено)

	Соединение = Новый HTTPСоединение("localhost", Порт, , , , 15);

	Если Заголовки = Неопределено Тогда
		Запрос = Новый HTTPЗапрос(Путь);
	Иначе
		Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	КонецЕсли;
	Запрос.УстановитьТелоИзСтроки("");

	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

// GET БЕЗ следования редиректу (1connector): штатное HTTPСоединение переходы выполняет само,
// и Location легаси-адреса было бы не увидеть.
Функция GETБезРедиректа(Знач Путь, Знач Куки = "")

	Сессия = Новый Сессия();
	Если ЗначениеЗаполнено(Куки) Тогда
		Сессия.Заголовки.Вставить("Cookie", Куки);
	КонецЕсли;

	Параметры = Новый Структура("РазрешитьПеренаправление", Ложь);
	Возврат Сессия.ВызватьМетод("GET",
		СтрШаблон("http://localhost:%1%2", Формат(Порт, "ЧГ=0"), Путь), Параметры);

КонецФункции

// Заголовок ответа без учёта регистра имени.
Функция Заголовок(Знач Ответ, Знач Имя)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ВРег(Имя) Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция КукиСессии(Знач Сессия)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + Сессия);
	Возврат Заголовки;
КонецФункции

// Команда установки в том виде, в каком её обязана напечатать страница: адрес хаба берётся
// из заголовка Host, то есть равен тому, по которому тест и стучится.
Функция КомандаУстановки(Знач ИмяПула, Знач ИмяПакета, Знач Координата = "")

	Возврат СтрШаблон("opm install localhost:%1/%2/%3%4",
		Формат(Порт, "ЧГ=0"), ИмяПула, ИмяПакета,
		?(ЗначениеЗаполнено(Координата), "@" + Координата, ""));

КонецФункции

Функция Кодированное(Знач Значение)
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Цель адресной команды установки — «узел/пул/пакет» из строки «opm install …».
// Форма через сервер из opm.cfg («opm install -m …») пропускается: узла в ней нет.
Функция ЦельАдреснойКоманды(Знач Разметка)

	Маркер = "opm install ";
	Позиция = СтрНайти(Разметка, Маркер);
	Пока Позиция > 0 Цикл
		Значение = ТокенС(Разметка, Позиция + СтрДлина(Маркер));
		Если НЕ СтрНачинаетсяС(Значение, "-") Тогда
			Возврат Значение;
		КонецЕсли;
		Хвост = Сред(Разметка, Позиция + СтрДлина(Маркер));
		Следующая = СтрНайти(Хвост, Маркер);
		Позиция = ?(Следующая = 0, 0, Позиция + СтрДлина(Маркер) + Следующая - 1);
	КонецЦикла;

	ВызватьИсключение "На странице пакета нет адресной команды установки";

КонецФункции

// Путь выдачи пула из образца конфигурации клиента — тот, по которому пойдёт opm.
Функция ПутьВыдачиИзОбразцаКонфига(Знач Разметка)

	Маркер = "/api/v1/pools/";
	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "На странице пакета нет образца конфигурации клиента";
	КонецЕсли;

	Значение = ТокенС(Разметка, Позиция);
	Хвост = "/download/";
	Конец = СтрНайти(Значение, Хвост);
	Если Конец = 0 Тогда
		ВызватьИсключение "Образец конфигурации не называет путь выдачи: " + Значение;
	КонецЕсли;

	Возврат Лев(Значение, Конец + СтрДлина(Хвост) - 1);

КонецФункции

// Слово, начинающееся в указанной позиции, до ближайшего разделителя разметки.
Функция ТокенС(Знач Разметка, Знач Начало)

	Результат = "";
	Для Индекс = Начало По СтрДлина(Разметка) Цикл
		Символ = Сред(Разметка, Индекс, 1);
		Если СтрНайти(" <>&""'" + Символы.ПС + Символы.ВК + Символы.Таб, Символ) > 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запрос по узлу, как его прочитал человек со страницы: «хост:порт» либо просто «хост».
Функция СкачатьСУзла(Знач Узел, Знач Путь)

	Части = СтрРазделить(Узел, ":", Ложь);
	Хост = Части[0];
	НомерПорта = ?(Части.Количество() > 1, Число(Части[1]), 80);

	Возврат Новый HTTPСоединение(Хост, НомерПорта, , , , 15).Получить(Новый HTTPЗапрос(Путь));

КонецФункции

Функция GET(Знач Путь, Знач Заголовки = Неопределено)

	Соединение = Новый HTTPСоединение("localhost", Порт, , , , 15);

	// явный Неопределено вторым параметром HTTPЗапрос не принимает — конструктор вызывается без него
	Если Заголовки = Неопределено Тогда
		Возврат Соединение.Получить(Новый HTTPЗапрос(Путь));
	КонецЕсли;

	Возврат Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));

КонецФункции

// Вход по логину/паролю через API v2; возвращает значение сессионной куки.
Функция Войти(Знач Логин, Знач Пароль)

	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");

	Запрос = Новый HTTPЗапрос("/api/v1/login", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);

	Соединение = Новый HTTPСоединение("localhost", Порт, , , , 15);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеИзSetCookie(Строка(КиЗ.Значение), "oshub_session");
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеИзSetCookie(Знач СтрокаКук, Знач ИмяКуки)

	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	Конец = СтрДлина(Остаток) + 1;

	Разделители = Новый Массив();
	Разделители.Добавить(";");
	Разделители.Добавить(",");

	Для Каждого Разделитель Из Разделители Цикл
		Позиция = СтрНайти(Остаток, Разделитель);
		Если Позиция > 0 И Позиция < Конец Тогда
			Конец = Позиция;
		КонецЕсли;
	КонецЦикла;

	Возврат СокрЛП(Лев(Остаток, Конец - 1));

КонецФункции

Функция ЗаголовокОтвета(Знач Ответ, Знач Имя)
	Значение = Ответ.Заголовки.Получить(Имя);
	Если Значение = Неопределено Тогда
		Значение = Ответ.Заголовки.Получить(НРег(Имя));
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

// Все листы стилей страницы В ПОРЯДКЕ ПЕЧАТИ: порядок между ними и есть порядок каскада,
// поэтому брать один первый попавшийся нельзя.
Функция АдресаТаблицСтилей(Знач HTML)

	Маркер = "<link rel=""stylesheet"" href=""";
	Результат = Новый Массив();
	Хвост = HTML;

	Начало = СтрНайти(Хвост, Маркер);
	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало + СтрДлина(Маркер));
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
		Начало = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АдресСкрипта(Знач HTML)
	Возврат МеждуМаркеров(HTML, "<script src=""", """");
КонецФункции

Функция АдресИконки(Знач HTML)
	Возврат МеждуМаркеров(HTML, "<link rel=""icon"" type=""image/svg+xml"" href=""", """");
КонецФункции

Функция АдресЗнака(Знач HTML)
	Возврат МеждуМаркеров(HTML, "<img class=""brand__mark"" src=""", """");
КонецФункции

Функция ЗаголовокВкладки(Знач HTML)
	Возврат МеждуМаркеров(HTML, "<title>", "</title>");
КонецФункции

// Разметка одного блока главной: от сетки, помеченной его заголовком, до начала
// следующей секции страницы — карточки соседнего блока в отрезок не попадают.
Функция СеткаБлока(Знач HTML, Знач Заголовок)

	Метка = СтрНайти(HTML, СтрШаблон("aria-label=""%1""", Заголовок));
	Ожидаем.Что(Метка > 0, СтрШаблон("сетка блока «%1» есть на главной", Заголовок)).ЭтоИстина();

	// отрезок начинается с открывающего тега сетки: атрибуты внутри него тоже проверяются
	Открытие = СтрНайти(Лев(HTML, Метка), "<div", НаправлениеПоиска.СКонца);
	Хвост = Сред(HTML, ?(Открытие > 0, Открытие, Метка));
	Конец = СтрНайти(Хвост, "<section");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

КонецФункции

// Похожа ли строка на дату вида дд.ММ.гггг — тест не привязывается к конкретному дню,
// но и не принимает за дату что попало.
Функция ДатаЛиДДММГГГГ(Знач Значение)

	Если СтрДлина(Значение) <> 10 Тогда
		Возврат Ложь;
	КонецЕсли;

	Образец = "цц.цц.цццц";
	Для Индекс = 1 По 10 Цикл
		Символ = Сред(Значение, Индекс, 1);
		Ожидаемый = Сред(Образец, Индекс, 1);
		Если Ожидаемый = "." Тогда
			Если Символ <> "." Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Разметка первой карточки пакета в отрезке.
Функция ПерваяКарточка(Знач Разметка)

	Начало = СтрНайти(Разметка, "<article class=""objcard""");
	Ожидаем.Что(Начало > 0, "карточка пакета есть в отрезке").ЭтоИстина();

	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, "</article>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

КонецФункции

// Сколько раз фрагмент встречается в тексте.
Функция СколькоРаз(Знач Текст, Знач Фрагмент)

	Результат = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Фрагмент);

	Пока Позиция > 0 Цикл
		Результат = Результат + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Фрагмент));
		Позиция = СтрНайти(Хвост, Фрагмент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Начало каждого элемента ряда меты до ближайшего </span>: этого куска хватает, чтобы
// увидеть значок и его текстовую пару, и он же остаётся целым у элемента без значка.
Функция ЭлементыМетыКарточек(Знач Разметка)

	Маркер = "<span class=""objcard__meta-item""";
	Результат = Новый Массив();

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, "</span>");
		Если Конец > 0 Тогда
			Результат.Добавить(Лев(Хвост, Конец - 1));
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭлементыМетыШапки(Знач Разметка)

	Маркер = "<span class=""objhead__meta-item""";
	Результат = Новый Массив();

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, "</span>");
		Если Конец > 0 Тогда
			Результат.Добавить(Лев(Хвост, Конец - 1));
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение элемента метаданных карточки. Элемент устроен так: значок, визуально скрытая
// подпись со своим </span>, и только за ней — само значение до конца элемента.
Функция ЗначениеМетыКарточки(Знач Разметка, Знач Подпись)

	Начало = СтрНайти(Разметка, "title=""" + Подпись + """");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, "</span>");
	Если Конец = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Хвост, Конец + СтрДлина("</span>"));
	Конец = СтрНайти(Хвост, "</span>");
	Возврат ?(Конец = 0, "", СокрЛП(Лев(Хвост, Конец - 1)));

КонецФункции

// Подстрока между открывающим маркером и ближайшим за ним закрывающим ("" — не нашли).
Функция МеждуМаркеров(Знач Текст, Знач Открывающий, Знач Закрывающий)

	Начало = СтрНайти(Текст, Открывающий);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Начало + СтрДлина(Открывающий));
	Конец = СтрНайти(Хвост, Закрывающий);
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

// SHA-256 (hex, нижний регистр) строки в UTF-8 — тем же способом, что и АктивыСтатики, но НЕЗАВИСИМО от них.
Функция Sha256Строки(Знач Текст)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Функция БезТеговScript(Знач HTML)

	Результат = HTML;

	Пока Истина Цикл
		Начало = СтрНайти(Результат, "<script");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Результат, "</script>");
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + Сред(Результат, Конец + 9);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Число секунд из max-age значения Cache-Control; нет max-age — ноль.
Функция Секунды(Знач ЗначениеКэша)

	Позиция = СтрНайти(Строка(ЗначениеКэша), "max-age=");
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Хвост = Сред(Строка(ЗначениеКэша), Позиция + СтрДлина("max-age="));
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;

	Возврат ?(ЗначениеЗаполнено(Цифры), Число(Цифры), 0);

КонецФункции

Функция СЗаголовком(Знач Имя, Знач Значение)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить(Имя, Значение);
	Возврат Заголовки;
КонецФункции

Функция ВхожденийПодстроки(Знач Текст, Знач Подстрока)

	Сколько = 0;
	Позиция = СтрНайти(Текст, Подстрока);
	Пока Позиция > 0 Цикл
		Сколько = Сколько + 1;
		Текст = Сред(Текст, Позиция + СтрДлина(Подстрока));
		Позиция = СтрНайти(Текст, Подстрока);
	КонецЦикла;
	Возврат Сколько;

КонецФункции

// Сквозной гейт ритма форм: проверку проходит КАЖДОЕ тело страницы, которое читает любой тест набора.
Функция Тело(Знач Ответ)

	Текст = Ответ.ПолучитьТелоКакСтроку();
	ПроверитьРитмПолей(Текст);
	ПроверитьРядыИнлайнов(Текст);
	Возврат Текст;

КонецФункции

// Блок «Зависит от» вкладки зависимостей: он идёт первым, «Кто зависит» — вторым.
Функция БлокЗависитОт(Знач Страница)
	Начало = СтрНайти(Страница, "Зависит от");
	Возврат Сред(Страница, Начало, СтрНайти(Страница, "Кто зависит") - Начало);
КонецФункции

// Тем же сквозным способом: контейнеры ритма фикстура выводит из самого CSS, поэтому
// новый контейнер попадает под проверку без правки списка.
Процедура ПроверитьРядыИнлайнов(Знач HTML)

	Если РядыИнлайнов = Неопределено Тогда
		РядыИнлайнов = Новый РядИнлайнов();
	КонецЕсли;

	Нарушения = РядыИнлайнов.Нарушения(HTML, ТекстCSS());
	Если Нарушения.Количество() > 0 Тогда
		ВызватьИсключение "Соседние атомарные инлайны: " + СтрСоединить(Нарушения, "; ");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРитмПолей(Знач HTML)

	// гейт производительности: без слов «field»/«toggle» полей на странице нет и разбирать её незачем;
	// нарочно без привязки к виду атрибута — смена кавычек в ките молча отключила бы проверку
	Если СтрНайти(HTML, "field") = 0 И СтрНайти(HTML, "toggle") = 0 Тогда
		Возврат;
	КонецЕсли;

	Если РитмПолей = Неопределено Тогда
		РитмПолей = Новый РитмФорм();
	КонецЕсли;

	Нарушения = РитмПолей.Нарушения(HTML, ТекстCSS());
	Если Нарушения.Количество() > 0 Тогда
		ВызватьИсключение "Ритм форм: " + СтрСоединить(Нарушения, "; ");
	КонецЕсли;

КонецПроцедуры

// Браузер получает ДВА листа: базовый лист кита и лист инсталляции поверх него. Правила
// сверяются по их сумме — по одному листу половина правил объявилась бы пропавшей.
Функция ТекстCSS()

	Если СтилиХаба = Неопределено Тогда
		Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
		СтилиХаба = ПрочитатьЛист(Место.ПолныйПуть(Место.ФайлБазовогоЛиста()))
			+ Символы.ПС + ПрочитатьЛист(ФайлСтилейИнсталляции());
	КонецЕсли;

	Возврат СтилиХаба;

КонецФункции

// Имя файла стилей несёт контент-хеш (6.A-0) — берём его из каталога, не литералом.
Функция ФайлСтилейИнсталляции()

	Каталог = ОбъединитьПути(Хаб.КаталогПроекта(), "src", "статика");
	Найденные = НайтиФайлы(Каталог, "openhub*.css");
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон(
			"Ожидался ровно один файл стилей openhub*.css в src/статика, найдено %1",
			Найденные.Количество());
	КонецЕсли;

	Возврат Найденные[0].ПолноеИмя;

КонецФункции

Функция ПрочитатьЛист(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция СодержитБезРегистра(Знач Текст, Знач Подстрока)
	Возврат СтрНайти(НРег(Текст), НРег(Подстрока)) > 0;
КонецФункции

Процедура ЗапуститьСидер(Знач Сидер, Знач Каталог)

	Процесс_ = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), Каталог, Истина);
	Процесс_.Запустить();
	Процесс_.ОжидатьЗавершения();

	Если Процесс_.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Сидер завершился с кодом %1: %2", Процесс_.КодВозврата, ЛогСидера());
	КонецЕсли;

КонецПроцедуры

// Ожидание готовности хаба живёт в фикстуре ЭкземплярХаба (общая для всех HTTP-наборов).
