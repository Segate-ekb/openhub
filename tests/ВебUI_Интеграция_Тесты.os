КонецПроцедуры

// Тот же класс утечки на легаси-адресе: /package/{имя} искал пакет по всему хабу и уводил
// редиректом в его пул, называя приватный пул в Location.
&Тест
Процедура ЛегасиРедиректНеНазываетПриватныйПул() Экспорт

	Аноним = GETБезРедиректа("/package/hushlib");
	Ожидаем.Что(Аноним.КодСостояния, "приватный пакет по легаси-адресу не находится").Равно(404);
	Ожидаем.Что(СтрНайти(ЗаголовокLocation(Аноним), "vault9"),
		"имя приватного пула не уехало в Location").Равно(0);
	Ожидаем.Что(СтрНайти(Аноним.Текст(), "vault9"), "и не названо в теле 404").Равно(0);

	Участник = GETБезРедиректа("/package/hushlib",
		"oshub_session=" + Войти("seed-insider", "SeedPassw0rd"));
	Ожидаем.Что(Участник.КодСостояния, "участнику пула легаси-адрес работает").Равно(302);
	Ожидаем.Что(СтрНайти(ЗаголовокLocation(Участник), "/vault9/hushlib") > 0,
		"редирект ведёт на страницу пакета в его пуле").ЭтоИстина();

	// КОНТРОЛЬ: публичный пакет тем же адресом находится и анониму
	Ожидаем.Что(СтрНайти(ЗаголовокLocation(GETБезРедиректа("/package/winow")), "/main/winow") > 0,
		"публичный пакет по легаси-адресу находится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура READMEПрошёлСанитизацию() Экспорт

	// XSS-векторы из README не должны попасть в выдачу; служебные <style>/<script> макета этих маркеров не содержат
	Тело = НРег(Тело(GET("/main/winow")));

	Ожидаем.Что(СтрНайти(Тело, "javascript:"), "javascript-URL вырезаны").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "onclick"), "обработчик on* вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "evil("), "вызов из on-атрибута вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "xss-script"), "содержимое script-блока вырезано").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "xss-link"), "текст javascript-ссылки вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "xss-img"), "javascript-src картинки вырезан").Равно(0);

КонецПроцедуры

&Тест
Процедура ВредоносныйURLРепозиторияНеИсполним() Экспорт

	// у пакета victim АдресРепозитория="javascript:alert('REPO')" (записан в обход санитизации сервиса):
	// слой вывода обязан не отдать ни исполнимую ссылку, ни сам адрес текстом
	Ответ = GET("/main/victim");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Тело = НРег(Тело(Ответ));

	Ожидаем.Что(СтрНайти(Тело, "javascript"), "javascript-строки в теле нет вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "alert('repo')"), "и адрес не выведен текстом").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "href=""javascript"), "нет исполнимого href").Равно(0);

	// сам чип репозитория со страницы не исчезает — он вырождается в подпись без ссылки
	Чип = ЧипМеты(Тело, "репозиторий");
	Ожидаем.Что(ЗначениеЗаполнено(Чип), "чип репозитория на странице остался").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чип, "<a"), "у чипа репозитория нет href вовсе").Равно(0);

КонецПроцедуры

// Элемент ряда меты, внутри которого встретилась подпись: от ближайшего "<span" слева
// до первого "</span>" справа. Пустая строка — подписи в теле нет.
Функция ЧипМеты(Знач HTML, Знач Подпись)

	Позиция = СтрНайти(HTML, Подпись);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = СтрНайти(Лев(HTML, Позиция), "<span", НаправлениеПоиска.СКонца);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Хвост, "</span>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец + 6));

КонецФункции

&Тест
Процедура ЛегасиРедиректПакета() Экспорт

	Ответ = GET("/package/winow");

	Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда
		// клиент не пошёл по редиректу — проверяем сам редирект
		Ожидаем.Что(СтрНайти(ЗаголовокLocation(Ответ), "/main/winow") > 0,
			"редирект на страницу пакета в пуле").ЭтоИстина();
	Иначе
		// клиент последовал за редиректом — должны получить страницу пакета
		Ожидаем.Что(Ответ.КодСостояния).Равно(200);
		Ожидаем.Что(СтрНайти(Тело(Ответ), КомандаУстановки("main", "winow")) > 0,
			"после редиректа — страница пакета winow").ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

Функция ЛогСидера()
	Если ЗначениеЗаполнено(СидерЛог) И Новый Файл(СидерЛог).Существует() Тогда
		Чтение = Новый ЧтениеТекста(СидерЛог, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
		Возврат Содержимое;
	КонецЕсли;
	Возврат "лог недоступен";
КонецФункции

Функция ЗаголовокLocation(Знач Ответ)
	Значение = Ответ.Заголовки.Получить("Location");
	Если Значение = Неопределено Тогда
		Значение = Ответ.Заголовки.Получить("location");
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

&Тест
Процедура НеизвестныйПулИПакетДают404() Экспорт
	Ожидаем.Что(GET("/no-such-pool").КодСостояния).Равно(404);
	Ожидаем.Что(GET("/main/no-such-package").КодСостояния).Равно(404);
КонецПроцедуры

&Тест
Процедура Сообщение404ЭкранируетсяВБайтахОтвета() Экспорт

	// поведенческое доказательство «Сообщение экранирует ПОЛУЧАТЕЛЬ»: имя пакета приходит из URL сырым и попадает в
	// сообщение 404; текстовый скан не видит, доехало ли экранирование до байтов ответа
	Ответ = GET("/main/%3Cscript%3Exssproba%3C%2Fscript%3E");

	Ожидаем.Что(Ответ.КодСостояния, "несуществующий пакет — 404").Равно(404);

	ТелоОтвета = Тело(Ответ);
	Ожидаем.Что(СтрНайти(ТелоОтвета, "xssproba") > 0,
		"предпосылка: имя из URL действительно попадает в сообщение 404").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоОтвета, "<script>xssproba"),
		"сырой тег из URL в тело ответа не попал").Равно(0);
	Ожидаем.Что(СтрНайти(ТелоОтвета, "&lt;script&gt;xssproba") > 0,
		"payload доехал экранированным").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтатикаОтдаётсяПоАдресуСКонтентХешем() Экспорт

	// адреса берём из самой страницы — тест не знает отпечатков и не разъедется с ними
	Главная = Тело(GET("/"));
	Листы = АдресаТаблицСтилей(Главная);

	Ожидаем.Что(Листы.Количество(), "листов на странице два: библиотечный и свой").Равно(2);
	Ожидаем.Что(СтрНачинаетсяС(Листы[0], "/static/oscript-ui-"),
		"первым — базовый лист библиотеки: " + Листы[0]).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Листы[1], "/static/openhub-"),
		"вторым — лист инсталляции, он и перебивает: " + Листы[1]).ЭтоИстина();

	Базовый = ОтданныйЛист(Листы[0], "oscript-ui");
	Свой = ОтданныйЛист(Листы[1], "openhub");

	Ожидаем.Что(СтрНайти(Базовый, "var(--color-bg)") > 0,
		"стили опираются на токены темы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Базовый, "prefers-reduced-motion") > 0, "движение отключаемо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Свой, "[data-pwreq]") > 0,
		"лист инсталляции несёт своё — требования к паролю").ЭтоИстина();

	// адрес скрипта берём ИЗ СТРАНИЦЫ: с контент-хешем у каждого файла свой отпечаток, и «openhub-<хеш-CSS>.js» —
	// как раз тот запрос, который белый список обязан отбить
	АдресJS = АдресСкрипта(Главная);
	Ожидаем.Что(АдресJS = Листы[1], "у скрипта свой отпечаток, не отпечаток стилей").ЭтоЛожь();

	Скрипт = GET(АдресJS);
	Ожидаем.Что(Скрипт.КодСостояния, "скрипт отдаётся по своему адресу: " + АдресJS).Равно(200);
	Ожидаем.Что(GET(СтрЗаменить(Листы[1], ".css", ".js")).КодСостояния,
		"расширение подменили, а хеш чужой — 404").Равно(404);

КонецПроцедуры

// Лист по адресу со страницы: код, тип, кэш и главное — адрес есть функция ОТДАННОГО
// содержимого. Считаем хеш из того же тела, что пришло по HTTP, а не из файла на диске.
//
// Параметры:
//  Адрес - Строка - адрес листа, взятый со страницы.
//  Имя   - Строка - базовое имя файла без отпечатка и расширения.
//
// Возвращаемое значение:
//  Строка - отданный текст листа.
//
Функция ОтданныйЛист(Знач Адрес, Знач Имя)

	Ответ = GET(Адрес);
	Ожидаем.Что(Ответ.КодСостояния, "лист «" + Имя + "» отдаётся").Равно(200);
	Ожидаем.Что(СтрНайти(НРег(ЗаголовокОтвета(Ответ, "Content-Type")), "text/css") > 0,
		"CSS отдаётся как таблица стилей").ЭтоИстина();

	Текст = Тело(Ответ);
	Отпечаток = Sha256Строки(Текст);

	Ожидаем.Что(Адрес, "адрес несёт хеш отданного содержимого")
		.Равно("/static/" + Имя + "-" + Лев(Отпечаток, 16) + ".css");

	// сильный ETag и immutable-кэш: содержимое по адресу неизменно по построению
	Ожидаем.Что(ЗаголовокОтвета(Ответ, "ETag"), "ETag — полный отпечаток").Равно("""" + Отпечаток + """");
	Ожидаем.Что(СтрНайти(ЗаголовокОтвета(Ответ, "Cache-Control"), "immutable") > 0,
		"статика кэшируется навсегда").ЭтоИстина();

	Возврат Текст;

КонецФункции

&Тест
Процедура ОтдачаСтатикиНеПодпускаетКДискуНичегоКромеБелогоСписка() Экспорт

	// сегмент {файл} сравнивается ЦЕЛИКОМ с именами, вычисленными из содержимого: обход каталогов, верное имя без
	// хеша и верное имя с ЧУЖИМ хешем неотличимы — 404 до обращения к диску
	Чужие = Новый Массив();
	Чужие.Добавить("/static/openhub.css");                        // верное имя без хеша
	Чужие.Добавить("/static/openhub-0000000000000000.css");        // верное имя, чужой хеш
	Чужие.Добавить("/static/..%2F..%2Fpackagedef");
	Чужие.Добавить("/static/..%2F..%2F..%2F..%2Fetc%2Fpasswd");
	Чужие.Добавить("/static/%2E%2E%2Fpackagedef");

	Для Каждого Путь Из Чужие Цикл
		Ответ = GET(Путь);
		Ожидаем.Что(Ответ.КодСостояния = 200, "не 200 на «" + Путь + "» (пришло "
			+ Ответ.КодСостояния + ")").ЭтоЛожь();
		// на всякий случай: даже если бы код был 200, содержимого репозитория в теле нет
		Ожидаем.Что(СтрНайти(Тело(Ответ), "root:") = 0 И СтрНайти(Тело(Ответ), "ЗависитОт") = 0,
			"тело не содержит файлов с диска для «" + Путь + "»").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ИконкаСайтаОтдаётсяПоСсылкеИзКаркаса() Экспорт

	// <link rel="icon"> без работающей отдачи бесполезен — идём по ссылке из самой страницы
	Адрес = АдресИконки(Тело(GET("/")));
	Ожидаем.Что(СтрНачинаетсяС(Адрес, "/static/favicon-"), "иконка объявлена с хешем: " + Адрес).ЭтоИстина();

	Иконка = GET(Адрес);
	Ожидаем.Что(Иконка.КодСостояния, "иконка отдаётся").Равно(200);
	Ожидаем.Что(СтрНайти(НРег(ЗаголовокОтвета(Иконка, "Content-Type")), "image/svg+xml") > 0,
		"иконка отдаётся как SVG").ЭтоИстина();
