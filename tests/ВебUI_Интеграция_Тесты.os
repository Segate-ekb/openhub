// HTTP-интеграционные тесты публичной части web-ui: процесс-сидер наполняет файловую БД и хранилище, поднимается
// хаб, каждая страница запрашивается по HTTP — код ответа, ключевой контент и санитизация README (XSS вырезан).

#Использовать asserts
// 1connector — единственный способ УВИДЕТЬ 3xx: штатное HTTPСоединение переходы выполняет само.
#Использовать 1connector
// раскладка статики кита: по ней тест находит базовый лист библиотеки
#Использовать oscript-ui
#Использовать "фикстуры"

Перем Хаб;               // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем СидерЛог;
Перем РитмПолей;         // фикстура РитмФорм — сквозной гейт ритма форм (ревью 6.A Б-1)
Перем РядыИнлайнов;      // фикстура РядИнлайнов — сквозной гейт соседних атомарных инлайнов
Перем СтилиХаба;         // оба листа страницы (кит + инсталляция), прочитанные один раз

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Хаб = Новый ЭкземплярХаба(90);
	КаталогПроекта = Хаб.КаталогПроекта();
	РеестрФикстур.Подключить("РитмФорм");
	РеестрФикстур.Подключить("РядИнлайнов");
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьХаб.os");

	// общее окружение сидера и хаба: файловая БД + файловое хранилище
	Основа = Хаб.ФайловаяБаза("openhub-http");
	СидерЛог = ОбъединитьПути(Основа, "seed-error.log");
	Хаб.Среда("OSHUB_SEED_LOG", СидерЛог);

	ЗапуститьСидер(Сидер, КаталогПроекта);

	Хаб.Запустить();     // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ЛендингОтдаётся() Экспорт
	Ответ = GET("/");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Тело = Тело(Ответ);
	Ожидаем.Что(СодержитБезРегистра(Тело, "openhub"), "название хаба").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "Быстрый старт") > 0, "блок быстрого старта").ЭтоИстина();
КонецПроцедуры

// З-27: образец быстрого старта печатал выдуманные localhost, порт 3333 и пул public —
// не работало ни одно поле. Образец теперь собирается из настоящего адреса и основного
// пула, а на хабе БЕЗ основного пула (этот засев — как раз такой: пулы main и vault9,
// сид основного зовётся public) вместо образца стоит объяснение.
&Тест
Процедура БыстрыйСтартНеПечатаетВыдуманныйАдрес() Экспорт

	Тело = Тело(GET("/"));

	Ожидаем.Что(СтрНайти(Тело, "localhost"), "выдуманного узла на главной нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "3333"), "и выдуманного порта").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "/api/v1/pools/public/"), "и выдуманного пула").Равно(0);

	Ожидаем.Что(СтрНайти(Тело, "Образец настройки пока не собрать") > 0,
		"вместо образца — объяснение, почему его нет").ЭтоИстина();

КонецПроцедуры

// Главная — вход в хаб: с неё ищут и листают. Проверяем состав по разметке кита.
&Тест
Процедура ГлавнаяДаётПоискОбзорПуловИСписки() Экспорт

	Тело = Тело(GET("/"));

	Ожидаем.Что(СтрНайти(Тело, "action=""/packages""") > 0,
		"поиск с главной — GET-форма в существующий каталог").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "name=""q""") > 0, "и отправляет тот же параметр, что каталог").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Тело, "Пулы хаба") > 0, "обзор пулов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "href=""/main""") > 0, "из обзора можно перейти в пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "пакетов: 3") > 0, "у пула показано число доступных пакетов").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Тело, "Недавно опубликовано") > 0, "список свежих версий").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "href=""/main/winow""") > 0, "и из него открывается пакет").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Тело, "Проектный"), "плашки проектного типа на главной нет").Равно(0);

КонецПроцедуры

// Плашки карточки пула стоят РЯДОМ, а не соседними детьми тела карточки: вертикальный
// ритм тела уходил бы инлайновой плашке в высоту строчного бокса, и пул с двумя плашками
// выходил выше соседей по ряду.
&Тест
Процедура ПлашкиКарточкиПулаПечатаютсяОднимРядом() Экспорт

	Тело = Тело(GET("/"));

	Ожидаем.Что(СтрНайти(Тело, "<div class=""card__body""><div class=""tag-row"">") > 0,
		"плашки пула завёрнуты в ряд").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "<div class=""card__body""><span class=""tag"),
		"и не стоят голыми детьми тела карточки").Равно(0);

КонецПроцедуры

// Сторона «оставить»: плашка личного пространства содержательна и печатается в шапке
// личного пула, а в шапке проектного её нет. Обе шапки в одном тесте — отличает их ровно
// тип пула; идут они через агрегат ПлашкиПула.Плашки, а не через ПлашкаТипа напрямую.
&Тест
Процедура ШапкаЛичногоПулаНесётПлашкуПользовательскогоАПроектногоНет() Экспорт

	ОтветЛичного = GET("/seed-user");
	Ожидаем.Что(ОтветЛичного.КодСостояния, "личное пространство отдаётся").Равно(200);
	Личный = Тело(ОтветЛичного);

	Проектный = Тело(GET("/main"));

	Ожидаем.Что(СтрНайти(Личный, "Пользовательский") > 0,
		"у личного пространства плашка типа есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Проектный, "Пользовательский"),
		"у проектного пула её нет").Равно(0);
	Ожидаем.Что(СтрНайти(Проектный, "Проектный"),
		"и плашки проектного типа тоже нет").Равно(0);

КонецПроцедуры

// Витрина, а не лента: пакеты главной идут карточками кита в сетке кита, а не строками
// списка, и их не больше предела витрины (4–6 карточек в блоке).
&Тест
Процедура ГлавнаяПечатаетКарточкиСеткойАНеСписком() Экспорт

	Тело = Тело(GET("/"));

	Ожидаем.Что(СтрНайти(Тело, "class=""objcard-list"""), "строк списка на главной нет").Равно(0);

	// два признака проверяются ПО ОТДЕЛЬНОСТИ: точная строка привязала бы тест лендинга
	// к порядку атрибутов в компоненте «Сетка»
	Свежее = СеткаБлока(Тело, "Недавно опубликовано");
	Ожидаем.Что(СтрНайти(Свежее, "class=""grid grid--3""") > 0,
		"карточки свежего разложены сеткой кита в три колонки").ЭтоИстина();
	Карточек = СколькоРаз(Свежее, "<article class=""objcard""");
	Ожидаем.Что(Карточек > 0, "и карточки в блоке есть").ЭтоИстина();
	Ожидаем.Что(Карточек <= 6, "но не больше предела витрины (6)").ЭтоИстина();

КонецПроцедуры

// Карточка собрана из трёх частей в правильном порядке, и метаданные — последние: на них
// держится выравнивание ряда (они прижаты к низу карточки).
&Тест
Процедура КарточкаПакетаНесётТриЧастиИМетаданныеПоследними() Экспорт

	Карточка = ПерваяКарточка(СеткаБлока(Тело(GET("/")), "Недавно опубликовано"));

	Шапка = СтрНайти(Карточка, "class=""objcard__head""");
	Описание = СтрНайти(Карточка, "class=""objcard__desc""");
	Мета = СтрНайти(Карточка, "class=""objcard__meta""");

	Ожидаем.Что(Шапка > 0, "у карточки есть шапка с именем").ЭтоИстина();
	Ожидаем.Что(Описание > 0, "и описание").ЭтоИстина();
	Ожидаем.Что(Мета > 0, "и ряд метаданных").ЭтоИстина();

	Ожидаем.Что(Шапка < Описание, "порядок: шапка раньше описания").ЭтоИстина();
	Ожидаем.Что(Описание < Мета, "описание раньше метаданных").ЭтоИстина();
	Хвост = Сред(Карточка, Мета);
	Ожидаем.Что(СтрНайти(Хвост, "objcard__head"), "после метаданных шапки нет — они последние").Равно(0);
	Ожидаем.Что(СтрНайти(Хвост, "objcard__desc"), "и описания после них нет").Равно(0);

КонецПроцедуры

// Описание обрезает СТИЛЬ, а не сервер: в разметке лежит полный текст, а две строки
// с многоточием делает правило .objcard__desc (сторож правила — КомпонентыUI).
&Тест
Процедура ОписаниеКарточкиОтдаётсяЦеликомИОбрезаетсяСтилем() Экспорт

	Тело = Тело(GET("/"));
	Длинное = "Пакет приватного пула, зависящий от публичного autumn";

	// у winow описание короткое, поэтому берём заведомо длинное из каталога того же хаба
	Ожидаем.Что(СтрНайти(Тело(GET("/packages")), Длинное) >= 0, "предпосылка: каталог отвечает").ЭтоИстина();

	Свежее = СеткаБлока(Тело, "Недавно опубликовано");
	Ожидаем.Что(СтрНайти(Свежее, "class=""objcard__desc""") > 0,
		"описание печатается своим классом — обрезку делает правило, а не сервер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Свежее, "…"), "сервер многоточий не подставляет").Равно(0);

КонецПроцедуры

// Прочие места кита не поехали: каталог остался СПИСКОМ строк, страница пакета —
// раскладкой в две колонки.
&Тест
Процедура КаталогОсталсяСпискомАЗависимостиДвумяКолонками() Экспорт

	Каталог = Тело(GET("/packages"));
	Ожидаем.Что(СтрНайти(Каталог, "class=""objcard-list""") > 0, "каталог печатает список карточек").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Каталог, "class=""grid grid--3"""), "и не превращается в сетку главной").Равно(0);

	Зависимости = Тело(GET("/main/autumn/deps"));
	Ожидаем.Что(СтрНайти(Зависимости, "class=""grid grid--2""") > 0,
		"зависимости пакета остались двумя колонками").ЭтоИстина();

КонецПроцедуры

// Счётчики «пакетов» и «пулов» сняты с главной: число само по себе ничего не советует,
// а витрина отвечает на вопрос «что тут есть».
&Тест
Процедура СчётчиковПакетовИПуловНаГлавнойНет() Экспорт

	Для Каждого Логин Из СтрРазделить(",seed-user,seed-insider,seed-admin", ",") Цикл

		Кто = ?(ЗначениеЗаполнено(Логин), "«" + Логин + "»", "аноним");
		Тело = ?(ЗначениеЗаполнено(Логин),
			Тело(GET("/", КукиСессии(Войти(Логин, "SeedPassw0rd")))), Тело(GET("/")));

		Ожидаем.Что(СтрНайти(Тело, "class=""tile__label"""), Кто + ": плиток-счётчиков нет").Равно(0);
		Ожидаем.Что(СтрНайти(Тело, "Сводка хаба"), Кто + ": и блока сводки нет").Равно(0);

	КонецЦикла;

КонецПроцедуры

// Скачивания складываются из базы и несброшенного буфера: пять свежих скачиваний в
// популярное попасть обязаны, не дожидаясь сброса (порог сброса — 50).
&Тест
Процедура ГлавнаяПоказываетПопулярноеПоСвежимСкачиваниям() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(GET("/api/v1/pools/main/download/winow/winow-1.1.0.ospx").КодСостояния,
			"артефакт отдан").Равно(200);
	КонецЦикла;

	Популярное = СеткаБлока(Тело(GET("/")), "Популярное");

	Ожидаем.Что(СтрНайти(Популярное, "<article class=""objcard""") > 0,
		"популярное печатается карточками").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Популярное, "winow") > 0, "и в нём скачанный пакет").ЭтоИстина();
	// подпись метаданных в карточке заменена значком: слово уехало в title элемента
	Ожидаем.Что(ЗначениеМетыКарточки(Популярное, "скачиваний"),
		"счётчик виден до сброса буфера в базу").Равно("5");

	// вторая половина карточки популярного: когда пакет обновляли в последний раз
	Обновление = ЗначениеМетыКарточки(Популярное, "обновлён");
	Ожидаем.Что(ДатаЛиДДММГГГГ(Обновление),
		"в карточке есть дата последнего обновления (получено «" + Обновление + "»)").ЭтоИстина();

КонецПроцедуры

// Подписи меты лендинг берёт из словаря, а значок ищется по тексту подписи: разойдутся —
// ряд молча вернётся к виду «подпись: значение». Здесь это видно так же, как увидит
// пользователь: у КАЖДОГО элемента ряда на главной есть значок и скрытая подпись.
&Тест
Процедура МетаКарточекГлавнойПечатаетсяЗначкамиИНеТеряетПодпись() Экспорт

	Тело = Тело(GET("/"));

	Проверено = 0;
	Для Каждого Блок Из СтрРазделить("Недавно опубликовано,Популярное", ",") Цикл
		Для Каждого Элемент Из ЭлементыМетыКарточек(СеткаБлока(Тело, Блок)) Цикл

			Ожидаем.Что(СтрНайти(Элемент, "<svg") > 0,
				"«" + Блок + "»: элемент меты без значка — " + Элемент).ЭтоИстина();
			Ожидаем.Что(СтрНайти(Элемент, "class=""visually-hidden""") > 0,
				"«" + Блок + "»: значок без текстовой подписи — " + Элемент).ЭтоИстина();
			Ожидаем.Что(СтрНайти(Элемент, "aria-hidden=""true""") > 0,
				"«" + Блок + "»: значок не помечен декоративным — " + Элемент).ЭтоИстина();

			Проверено = Проверено + 1;

		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено > 0, "на главной нашлись элементы меты").ЭтоИстина();

КонецПроцедуры

// Мету печатает КИТ, а «подпись → значок» резолвит ХАБ, и резолв этот раздан вызывающим:
// витрине пакетов, карточке и контроллеру пула. Раздача — место молчаливой деградации:
// снятый вызов Оснастить() ничего не ломает, страница отдаётся, юнит-тесты зелены, и
// шапка просто теряет значки. Поэтому обе шапки проверяются НА ЖИВОЙ ВЫДАЧЕ.
&Тест
Процедура МетаШапокПакетаИПулаПечатаетсяЗначками() Экспорт

	Ожидания = Новый Соответствие();
	Ожидания.Вставить("/main/winow", "автор,скачиваний,лицензия");
	Ожидания.Вставить("/main", "пакетов");

	Потерянные = Новый Массив();
	Текстом = Новый Массив();

	Для Каждого КиЗ Из Ожидания Цикл

		Шапка = СтрСоединить(ЭлементыМетыШапки(Тело(GET(КиЗ.Ключ))), Символы.ПС);
		Ожидаем.Что(ЗначениеЗаполнено(Шапка),
			"на «" + КиЗ.Ключ + "» есть элементы меты шапки").ЭтоИстина();

		Для Каждого Подпись Из СтрРазделить(КиЗ.Значение, ",") Цикл
			Если СтрНайти(Шапка, "title=""" + Подпись + """") = 0 Тогда
				Потерянные.Добавить(КиЗ.Ключ + ": " + Подпись);
			КонецЕсли;
			// запасная ветка ряда «подпись: значение» — ровно то, что видно на экране,
			// когда значок не проставили
			Если СтрНайти(Шапка, Подпись + ": ") > 0
				И СтрНайти(Шапка, "<span class=""visually-hidden"">" + Подпись + ": ") = 0 Тогда
				Текстом.Добавить(КиЗ.Ключ + ": " + Подпись);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"подписи меты шапок, не получившие значка: реестр перестал оснащать элементы").Равно("");
	Ожидаем.Что(СтрСоединить(Текстом, ", "),
		"подписи меты шапок, отпечатанные запасной веткой «подпись: значение»").Равно("");

КонецПроцедуры

// Списки главной проходят тот же отбор, что и числа: имя приватного пула и его пакета
// не всплывает ни в обзоре пулов, ни в новинках.
&Тест
Процедура СпискиГлавнойНеНазываютПриватноеАнонимуИПостороннему() Экспорт

	Аноним = Тело(GET("/"));
	Ожидаем.Что(СтрНайти(Аноним, "vault9"), "аноним не видит имени приватного пула").Равно(0);
	Ожидаем.Что(СтрНайти(Аноним, "hushlib"), "и имени его пакета").Равно(0);

	Посторонний = Тело(GET("/", КукиСессии(Войти("seed-user", "SeedPassw0rd"))));
	Ожидаем.Что(СтрНайти(Посторонний, "vault9"), "посторонний — так же").Равно(0);
	Ожидаем.Что(СтрНайти(Посторонний, "hushlib"), "и по пакету").Равно(0);

	Участник = Тело(GET("/", КукиСессии(Войти("seed-insider", "SeedPassw0rd"))));
	Ожидаем.Что(СтрНайти(Участник, "href=""/vault9""") > 0,
		"участник видит свой приватный пул в обзоре").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Участник, "hushlib") > 0, "и его пакет в новинках").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГлавнаяРаботаетБезJS() Экспорт

	БезСкриптов = БезТеговScript(Тело(GET("/")));

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, "<form class=""filters"" method=""get"" action=""/packages""") > 0,
		"поиск — обычная GET-форма, а не обработчик").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "href=""/main/winow""") > 0, "списки — обычные ссылки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "href=""/packages""") > 0, "переход в каталог — ссылка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);

КонецПроцедуры

// Поиск с главной доходит до каталога тем же адресом, который печатает форма.
&Тест
Процедура ПоискСГлавнойДоходитДоКаталога() Экспорт

	Ожидаем.Что(СтрНайти(Тело(GET("/")), "action=""/packages""") > 0,
		"предпосылка: форма главной шлёт в /packages").ЭтоИстина();

	Найдено = Тело(GET("/packages?q=win"));
	Ожидаем.Что(СтрНайти(Найдено, "Каталог пакетов") > 0, "открылся каталог").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Найдено, "winow") > 0, "и он отобран запросом с главной").ЭтоИстина();

КонецПроцедуры

&Тест
&Тег("смоук")
Процедура КаталогПоказываетПакеты() Экспорт
	Тело = Тело(GET("/packages"));
	Ожидаем.Что(СтрНайти(Тело, "Каталог пакетов") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "winow") > 0, "пакет winow в каталоге").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "autumn") > 0, "пакет autumn в каталоге").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура КаталогФильтруетПоЗапросу() Экспорт
	Ответ = GET("/packages?q=win");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
