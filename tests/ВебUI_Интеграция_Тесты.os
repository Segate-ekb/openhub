&Тест
Процедура ТемаИзCookieМеняетОформлениеНаВсехСтраницах() Экспорт

	// оформление применялось только на лендинге, потому что его добывал контроллер; теперь тему из кук достаёт
	// сам рендерер — уважать её обязана любая страница
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie",
		"oshub_ui=%D1%82%D0%B5%D0%BC%D0%B0%3D%D1%81%D0%B2%D0%B5%D1%82%D0%BB%D0%B0%D1%8F");

	Страницы = Новый Массив();
	Страницы.Добавить("/");
	Страницы.Добавить("/packages");
	Страницы.Добавить("/main/winow");
	Страницы.Добавить("/login");
	Страницы.Добавить("/register");

	Для Каждого Путь Из Страницы Цикл
		Ответ = GET(Путь, Заголовки);
		Ожидаем.Что(Ответ.КодСостояния, "страница " + Путь).Равно(200);
		Тело = Тело(Ответ);
		Ожидаем.Что(СтрНайти(Тело, ТегHTML("light")) > 0,
			СтрШаблон("светлая тема из cookie на %1", Путь)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело, "html[data-theme=""light""]{") > 0,
			СтрШаблон("переменные светлой темы напечатаны на %1", Путь)).ЭтоИстина();
	КонецЦикла;

	// без cookie те же страницы остаются в теме инсталляции
	Ожидаем.Что(СтрНайти(Тело(GET("/packages")), ТегHTML("dark")) > 0,
		"без cookie — тема инсталляции").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТемаИзCookieРаботаетИВКабинете() Экспорт

	// приватная часть рисуется РендереромКабинета своей цепочкой — входим настоящим пользователем
	Сессия = Войти("seed-user", "SeedPassw0rd");
	Ожидаем.Что(ЗначениеЗаполнено(Сессия), "вход выполнен").ЭтоИстина();

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + Сессия
		+ "; oshub_ui=%D1%82%D0%B5%D0%BC%D0%B0%3D%D1%81%D0%B2%D0%B5%D1%82%D0%BB%D0%B0%D1%8F");

	Ответ = GET("/me", Заголовки);

	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Тело = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело, "Мои пакеты") > 0, "это страница кабинета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, ТегHTML("light")) > 0, "светлая тема из cookie в кабинете").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "html[data-theme=""light""]{") > 0, "переменные светлой темы").ЭтоИстина();

	// без cookie оформления кабинет остаётся в теме инсталляции
	ТолькоСессия = Новый Соответствие();
	ТолькоСессия.Вставить("Cookie", "oshub_session=" + Сессия);
	Ожидаем.Что(СтрНайти(Тело(GET("/me", ТолькоСессия)), ТегHTML("dark")) > 0,
		"без cookie — тема инсталляции").ЭтоИстина();

