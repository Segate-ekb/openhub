// HTTP-тесты среза изменений пула (/api/v1/pools/{pool}/changes): что появилось или
// изменилось после названного момента, порция имён с курсором, отказ на непонятный момент
// и видимость приватного пула. Отсюда зеркало чужого OpenHub берёт инкремент, поэтому хаб
// поднимается настоящий: проверяется его собственная выдача, а не заглушка.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;            // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем КаталогПроекта;
Перем КореньДанных;
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени

// PAT owner1 — владельца пула owned: публикация владельца ложится сразу, а не заявкой
// во «входящие», и срез изменений видит настоящие версии
Перем ТокенOwner;
Перем КукаOwner;      // сессия owner1 — формы дома пакета (флажок «скрыт»)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ФикстураПакета");
	// разбор среза — тот самый, которым ответ хаба читает зеркало: контракт проверяется
	// на живой паре «эмиттер — читатель», а не на двух копиях ключей
	РеестрФикстур.Подключить("КлассыСлоя");

	Хаб = Новый ЭкземплярХаба(90);
	КаталогПроекта = Хаб.КаталогПроекта();
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьКабинет.os");

	КореньДанных = Хаб.ФайловаяБаза("openhub-срез-изменений");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	ЗапуститьСидер(Сидер);

	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(
		ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "зеркала", "Классы"),
		"РазборСрезаИзменений");

	Хаб.Запустить();
	Порт = Хаб.Порт();

	КукаOwner = Войти("owner1", "Owner1Passw0rd");
	ТокенOwner = ВыпуститьPAT(КукаOwner);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Момент снятия — то, что зеркало запомнит и спросит в следующий раз. Без него инкремента
// нет: спрашивать было бы не от чего.
&Тест
Процедура СрезНазываетМоментСнятияИСоставПула() Экспорт

	Опубликовать("slice-a", "1.0.0");
	Ответ = GET_Токен("/api/v1/pools/owned/changes", ТокенOwner);

	Ожидаем.Что(Ответ.КодСостояния, "срез пула читается").Равно(200);
	Срез = ТелоJSON(Ответ);
	Ожидаем.Что(Срез.Получить("pool"), "пул назван").Равно("owned");
	Ожидаем.Что(ЗначениеЗаполнено(Срез.Получить("as_of")), "момент снятия назван").ЭтоИстина();
	Ожидаем.Что(Срез.Получить("since"), "полный срез спрошен без момента").Равно("");
	Ожидаем.Что(ВерсииПакета(Срез, "slice-a"), "состав пула виден целиком").Равно("1.0.0");

КонецПроцедуры

// Ядро требования: спросив изменения с момента прошлого обхода, зеркало получает то,
// что появилось ПОСЛЕ него, — и только это.
&Тест
Процедура ПоявившаясяВерсияПопадаетВСрезСПрошлогоМомента() Экспорт

	Момент = МоментСнятия(СрезПула(""));
	Опубликовать("changed-a", "1.0.0");

	Срез = ТелоJSON(СрезПула(Момент));

	Ожидаем.Что(Срез.Получить("since"), "момент отсчёта возвращён как спрошен").Равно(Момент);
	Ожидаем.Что(ВерсииПакета(Срез, "changed-a"), "появившаяся версия в срезе").Равно("1.0.0");

КонецПроцедуры

// Обратная сторона: то, что изменилось ДО момента, в срез не попадает — иначе инкремент
// возил бы весь каталог заново и не был бы дешевле полного обхода.
&Тест
Процедура ИзменившеесяДоМоментаВСрезНеПопадает() Экспорт

	Опубликовать("changed-b", "1.0.0");
	// момент среза посекундный, а граница его включительна: изменение той же секунды приедет
	// повторно намеренно (перекрытие). Здесь проверяется другое — что СТАРОЕ не возит совсем
	Приостановить(1200);
	Момент = МоментСнятия(СрезПула(""));

	Срез = ТелоJSON(СрезПула(Момент));

	Ожидаем.Что(ВерсииПакета(Срез, "changed-b"), "уже известная версия в срез не попала").Равно("");
	Ожидаем.Что(Срез.Получить("changes").Количество(), "и ничего другого тоже").Равно(0);

КонецПроцедуры

// Срез отдаёт ИЗМЕНИВШЕЕСЯ, а не только появившееся: отзыв версии меняет то, что зеркало
// обязано о ней знать, и обязан приезжать инкрементом.
&Тест
Процедура ОтозваннаяВерсияПопадаетВСрезКакИзменившаяся() Экспорт

	Опубликовать("changed-c", "1.0.0");
	// момент берётся ПОСЛЕ публикации и другой секундой: в срез эту версию обязан вернуть
	// сам отзыв, а не её появление
	Приостановить(1200);
	Момент = МоментСнятия(СрезПула(""));

	Отзыв = PATCH_Токен("/api/v1/pools/owned/packages/changed-c/versions/1.0.0",
		"{""yanked"":true}", ТокенOwner);
	Ожидаем.Что(Отзыв.КодСостояния, "версия отозвана").Равно(200);

	Срез = ТелоJSON(СрезПула(Момент));

	Ожидаем.Что(ВерсииПакета(Срез, "changed-c"), "отозванная версия в срезе").Равно("1.0.0");
	Ожидаем.Что(ВерсияИзСреза(Срез, "changed-c", "1.0.0").Получить("yanked"),
		"и названа отозванной").ЭтоИстина();

КонецПроцедуры

// Порция считает ИМЕНА: срез большого хаба зеркало берёт кусками и продолжает курсором.
&Тест
Процедура ПорцияСрезаОграниченаИменамиИПродолжаетсяКурсором() Экспорт

	Опубликовать("portion-a", "1.0.0");
	Опубликовать("portion-b", "1.0.0");

	Первая = ТелоJSON(GET_Токен("/api/v1/pools/owned/changes?limit=1", ТокенOwner));
	Ожидаем.Что(ИменаСреза(Первая), "порция считает имена, а не версии").Равно(1);
	Ожидаем.Что(Первая.Получить("has_more"), "за порцией остались имена").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Первая.Получить("next_cursor")), "курсор назван").ЭтоИстина();

	Вторая = ТелоJSON(GET_Токен("/api/v1/pools/owned/changes?limit=1&cursor="
		+ КодироватьСтроку(Строка(Первая.Получить("next_cursor")), СпособКодированияСтроки.КодировкаURL),
		ТокенOwner));

	Ожидаем.Что(Вторая.Получить("names_total"), "знаменатель между порциями не скачет")
		.Равно(Первая.Получить("names_total"));
	Ожидаем.Что(Вторая.Получить("names_before"), "имена до курсора сосчитаны").Равно(1);
	Ожидаем.Что(ИмяПервогоИзменения(Вторая), "порция начинается с курсора")
		.Равно(Строка(Первая.Получить("next_cursor")));

КонецПроцедуры

// Непонятный момент — отказ, а не молчаливый полный срез: спросивший «что нового с четверга»
// получил бы весь каталог и решил, что изменилось всё.
&Тест
Процедура НепонятныйМоментОтвергается() Экспорт

	Ответ = GET_Токен("/api/v1/pools/owned/changes?since=вчера", ТокенOwner);

	Ожидаем.Что(Ответ.КодСостояния, "мусорный момент отвергнут").Равно(400);
	Ожидаем.Что(Строка(ТелоJSON(Ответ).Получить("error").Получить("code")),
		"причина названа машинно").Равно("invalid_since");

КонецПроцедуры

// Скрытый пакет — не «не показывать в списке», а не показывать нигде: зеркало, увидев его
// в срезе, растащило бы скрытое по чужим пулам.
&Тест
Процедура СкрытыйПакетВСрезНеПопадает() Экспорт

	Опубликовать("hidden-a", "1.0.0");
	Ожидаем.Что(ВерсииПакета(ТелоJSON(СрезПула("")), "hidden-a"), "пока пакет виден").Равно("1.0.0");

	Скрыть("hidden-a");

	Ожидаем.Что(ВерсииПакета(ТелоJSON(СрезПула("")), "hidden-a"),
		"скрытый пакет из среза пропал").Равно("");

КонецПроцедуры

// Видимость у среза та же, что у чтений пакетов: недоступный пул неотличим от несуществующего.
&Тест
Процедура ПриватныйПулАнонимуНеОтвечает() Экспорт

	Ожидаем.Что(GET("/api/v1/pools/secret/changes").КодСостояния,
		"аноним приватного пула не видит").Равно(404);
	Ожидаем.Что(GET_Токен("/api/v1/pools/secret/changes", ТокенOwner).КодСостояния,
		"владелец видит").Равно(200);

КонецПроцедуры

// КОНТРАКТ среза: ответ хаба читает тот самый разбор, которым его читает зеркало. Проверка
// на живой паре — иначе эмиттер и читатель сверяются каждый со своей копией ключей,
// и переименование поля выглядит как «источник ничего не изменил»: зеркало вечно возит
// пустоту, а момент вычитки при этом двигается.
&Тест
Процедура ОтветХабаЧитаетсяРазборомЗеркалаБезПотерь() Экспорт

	// момент берётся ПОСЛЕ паузы: публикации соседних тестов той же секунды иначе попадут
	// в срез перекрытием, и знаменатель считал бы чужое
	Приостановить(1200);
	Момент = МоментСнятия(СрезПула(""));
	Опубликовать("contract-a", "1.0.0");
	Опубликовать("contract-b", "2.0.0");

	Ответ = GET_Токен(АдресСрезаСМоментом(Момент) + "&limit=1", ТокенOwner);
	Разбор = Новый РазборСрезаИзменений();
	Срез = Разбор.Разобрать(Ответ.ПолучитьТелоКакСтроку());

	Ожидаем.Что(Срез <> Неопределено, "разбор зеркала принял ответ хаба").ЭтоИстина();
	Ожидаем.Что(Срез.Пакеты.Количество(), "порция в одно имя прочитана").Равно(1);
	Ожидаем.Что(Срез.Пакеты[0].ИмяПакета, "имя пакета прочитано").Равно("contract-a");
	Ожидаем.Что(СтрСоединить(Срез.Пакеты[0].Версии, ","), "и версия под ним").Равно("1.0.0");
	Ожидаем.Что(ЗначениеЗаполнено(Срез.Снят), "момент снятия среза прочитан").ЭтоИстина();
	Ожидаем.Что(Срез.ИменВсего, "знаменатель прочитан").Равно(2);
	Ожидаем.Что(Срез.ЕстьЕщё, "признак хвоста прочитан").ЭтоИстина();
	Ожидаем.Что(Срез.Курсор, "и курсор продолжения").Равно("contract-b");

КонецПроцедуры

// Форма версии в срезе — та же, что у списка версий: зеркало разбирает ОДИН формат,
// а не два похожих.
&Тест
Процедура ФормаВерсииТаЖеЧтоУСпискаВерсий() Экспорт

	Опубликовать("shape-a", "1.0.0");

	Срез = ТелоJSON(СрезПула(""));
	Изменение = ВерсияИзСреза(Срез, "shape-a", "1.0.0");
	Список = ТелоJSON(GET_Токен("/api/v1/pools/owned/packages/shape-a/versions", ТокенOwner))
		.Получить("versions");

	Ожидаем.Что(Изменение <> Неопределено, "версия в срезе есть").ЭтоИстина();
	Ожидаем.Что(КлючиПоПорядку(Изменение), "состав полей версии совпадает")
		.Равно(КлючиПоПорядку(Список[0]));
	Ожидаем.Что(Изменение.Получить("sha256"), "и значения тоже")
		.Равно(Список[0].Получить("sha256"));

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Срез пула owned: его владелец — единственный, чья публикация ложится сразу.
// Пустой момент — полный срез.
Функция СрезПула(Знач Момент)

	Адрес = ?(ЗначениеЗаполнено(Момент), АдресСрезаСМоментом(Момент),
		"/api/v1/pools/owned/changes");
	Возврат GET_Токен(Адрес, ТокенOwner);

КонецФункции

Функция АдресСрезаСМоментом(Знач Момент)
	Возврат "/api/v1/pools/owned/changes?since="
		+ КодироватьСтроку(XMLСтрока(Момент), СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Момент снятия среза: разбор JSON возвращает его датой — строку вида ISO-8601
// платформа приводит сама.
Функция МоментСнятия(Знач Ответ)
	Возврат ТелоJSON(Ответ).Получить("as_of");
КонецФункции

// Версии пакета в срезе через запятую; пустая строка — пакета в срезе нет.
Функция ВерсииПакета(Знач Срез, Знач ИмяПакета)

	// Перем обязательна: имя «Версии» в процессе занято и на запись не отдаётся
	Перем Найденные;

	Найденные = Новый Массив();
	Для Каждого Изменение Из Срез.Получить("changes") Цикл
		Если Строка(Изменение.Получить("package")) = ИмяПакета Тогда
			Найденные.Добавить(Строка(Изменение.Получить("version").Получить("version")));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Найденные, ",");

КонецФункции

// Сколько РАЗНЫХ имён пакетов в срезе: порция считает имена, а версий у имени много.
Функция ИменаСреза(Знач Срез)

	Имена = Новый Массив();
	Для Каждого Изменение Из Срез.Получить("changes") Цикл
		Имя = Строка(Изменение.Получить("package"));
		Если Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена.Количество();

КонецФункции

Функция ВерсияИзСреза(Знач Срез, Знач ИмяПакета, Знач Версия)

	Для Каждого Изменение Из Срез.Получить("changes") Цикл
		Если Строка(Изменение.Получить("package")) = ИмяПакета
			И Строка(Изменение.Получить("version").Получить("version")) = Версия Тогда
			Возврат Изменение.Получить("version");
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ИмяПервогоИзменения(Знач Срез)
	Изменения = Срез.Получить("changes");
	Возврат ?(Изменения.Количество() = 0, "", Строка(Изменения[0].Получить("package")));
КонецФункции

// Поля версии в порядке их печати: обе выдачи строит один сборщик, поэтому и порядок
// у них обязан быть один — разошёлся он, значит формы уже две.
Функция КлючиПоПорядку(Знач Соответствие_)

	Ключи = Новый Массив();
	Для Каждого КиЗ Из Соответствие_ Цикл
		Ключи.Добавить(Строка(КиЗ.Ключ));
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ",");

КонецФункции

// Публикует версию в пул owned от имени его владельца: заявка во «входящие» здесь не годится —
// версии, которой нет, не будет и в срезе изменений.
Процедура Опубликовать(Знач ИмяПакета, Знач Версия)

	Ответ = Публикация(СтрШаблон("/api/v1/pools/owned/packages/%1/versions", ИмяПакета),
		OspxДанные(ИмяПакета, Версия), ИмяПакета + "-" + Версия + ".ospx", ТокенOwner);
	Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Публикация ""%1"" %2 не удалась: %3 %4",
			ИмяПакета, Версия, Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

КонецПроцедуры

// Прячет пакет тем же путём, что и мейнтейнер: флажок «скрыт» в разделе «Карточка»
// дома пакета. Другого входа к этому признаку в хабе нет.
Процедура Скрыть(Знач ИмяПакета)

	Адрес = СтрШаблон("/owned/%1/settings/card", ИмяПакета);
	CSRF = ИзвлечьCSRF(GET_Кука(Адрес, КукаOwner).ПолучитьТелоКакСтроку());

	Поля = Новый Соответствие();
	Поля.Вставить("описание", "");
	Поля.Вставить("ключевые_слова", "");
	Поля.Вставить("лицензия", "");
	Поля.Вставить("репозиторий", "");
	Поля.Вставить("скрыт", "1"); // тумблер: включено — «1» (РазборФормы.Флажок)
	Поля.Вставить("_csrf", CSRF);

	Ответ = POSTФормаКукой(Адрес, Поля, КукаOwner);
	Если Ответ.КодСостояния >= 400 Тогда
		ВызватьИсключение СтрШаблон("Не удалось скрыть пакет ""%1"": %2",
			ИмяПакета, Ответ.КодСостояния);
	КонецЕсли;

КонецПроцедуры

Функция OspxДанные(Знач ИмяПакета, Знач Версия)
	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Фикстура = Новый ФикстураПакета();
	Возврат Новый ДвоичныеДанные(
		Фикстура.ПостроитьOspx(Каталог, ИмяПакета, Версия, "# " + ИмяПакета));
КонецФункции

#КонецОбласти

#Область HTTPПомощники

Функция Соединение()
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 30);
КонецФункции

Функция GET(Знач Путь)
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция GET_Токен(Знач Путь, Знач Токен)
	Заголовки = Новый Соответствие();
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция GET_Кука(Знач Путь, Знач Кука)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

// POST формы по сессии: экраны настроек принимают urlencoded с полем _csrf.
Функция POSTФормаКукой(Знач Путь, Знач Поля, Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(КодироватьФорму(Поля), КодировкаТекста.UTF8);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция КодироватьФорму(Знач Поля)

	Части = Новый Массив();
	Для Каждого КиЗ Из Поля Цикл
		Части.Добавить(КодироватьСтроку(Строка(КиЗ.Ключ), СпособКодированияСтроки.КодировкаURL)
			+ "=" + КодироватьСтроку(Строка(КиЗ.Значение), СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");

КонецФункции

Функция ИзвлечьCSRF(Знач Тело_)

	Маркер = "name=""_csrf"" value=""";
	Поз = СтрНайти(Тело_, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тело_, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

Функция PATCH_Токен(Знач Путь, Знач Тело_, Знач Токен)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат Соединение().ВызватьHTTPМетод("PATCH", Запрос);

КонецФункции

// Публикация: сырое бинарное тело .ospx + FILE-NAME + Bearer PAT.
Функция Публикация(Знач Путь, Знач Данные, Знач ИмяФайла, Знач Токен)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Процедура ЗапуститьСидер(Знач Сидер)

	П = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), КаталогПроекта, Истина);
	П.Запустить();
	П.ОжидатьЗавершения();
	Если П.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер завершился с кодом %1: %2",
			П.КодВозврата, П.ПолучитьВыводПотокаОшибок());
	КонецЕсли;

КонецПроцедуры

Функция Войти(Знач Логин, Знач Пароль)

	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/api/v1/login", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат ИзвлечьКукуСессии(Соединение().ОтправитьДляОбработки(Запрос));

КонецФункции

Функция ВыпуститьPAT(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);
	Ответ = Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;
	Возврат ТелоJSON(Ответ).Получить("token_info").Получить("token");

КонецФункции

Функция ТелоJSON(Знач Ответ)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Разобранное = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Разобранное;

КонецФункции

Функция ИзвлечьКукуСессии(Знач Ответ)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "SET-COOKIE" Тогда
			Значение = ИзвлечьЗначениеКуки(Строка(КиЗ.Значение), "oshub_session");
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ИзвлечьЗначениеКуки(Знач СтрокаКук, Знач ИмяКуки)

	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Возврат ?(ТочкаЗпт = 0, Остаток, Лев(Остаток, ТочкаЗпт - 1));

КонецФункции

#КонецОбласти
