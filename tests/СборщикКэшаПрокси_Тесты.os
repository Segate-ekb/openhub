// Юнит-тесты сборщика кэша прокси по квоте: LRU-эвикция, отбор пулов с апстримами, провенанс
// (своя публикация не вытесняется никогда), опись и удаление файлов хранилища.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулей_;
Перем КаталогФикстур_;
Перем Корни_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур_ = ОбъединитьПути(КаталогТестов, "фикстуры");
	Корни_ = Новый Массив();

КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "хранилище", "Классы", "КоординатыАртефакта.os"));
	// КвотаХранилища и РаскладкаФайловХранилища создаются конструктором ФайловоеХранилище:
	// без них набор зелен только по соседству с тем, кто зарегистрировал эти типы раньше
	// в том же процессе
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "хранилище", "Классы", "КвотаХранилища.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "хранилище", "Классы", "ПомощникАртефакта.os"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей_);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "хранилище", "Классы", "ВместимостьКвоты.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "хранилище", "Классы", "РаскладкаФайловХранилища.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "хранилище", "Классы", "ФайловоеХранилище.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "прокси", "Классы", "СборщикКэшаПрокси.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "ПулЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "СервисПуловЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "РеестрПровенансаЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "УчётОбъёмаЗаглушка.os"));
КонецПроцедуры

&ПослеВсех
Процедура УбратьКаталоги() Экспорт
	Для Каждого Корень Из Корни_ Цикл
		УникальныеИмена.УбратьВременное(Корень);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура LRUЭвикцияДоКвотыПроксиПула() Экспорт

	Хранилище = НовоеХранилище();
	РазмерФайла = 512000; // ~0.49 МБ

	ПутьA = ПоложитьАртефакт(Хранилище, "px", "pkg-a", "1.0.0", РазмерФайла);
	ПутьB = ПоложитьАртефакт(Хранилище, "px", "pkg-b", "1.0.0", РазмерФайла);
	ПутьC = ПоложитьАртефакт(Хранилище, "px", "pkg-c", "1.0.0", РазмерФайла);
	СтарениеПоВозрастанию(ПутьA, ПутьB, ПутьC);

	Пулы = Новый СервисПуловЗаглушка();
	Пулы.ДобавитьПул(Новый ПулЗаглушка(1, "px", "proxy", 1));

	Реестр = Новый РеестрПровенансаЗаглушка();
	Реестр.Добавить("pkg-a", "1.0.0", "апстрим");
	Реестр.Добавить("pkg-b", "1.0.0", "апстрим");
	Реестр.Добавить("pkg-c", "1.0.0", "апстрим");

	Объёмы = Новый УчётОбъёмаЗаглушка();
	Сборщик = Новый СборщикКэшаПрокси(Пулы, Реестр, Реестр, Реестр, Объёмы, Хранилище, ЛогТестов());
	Сводка = Сборщик.Собрать();

	Ожидаем.Что(Сводка.УдаленоФайлов, "вытеснен ровно один (старейший) артефакт").Равно(1);
	Ожидаем.Что(Существует(Хранилище, "px", "pkg-a", "1.0.0"), "старейший (a) вытеснен").ЭтоЛожь();
	Ожидаем.Что(Существует(Хранилище, "px", "pkg-b", "1.0.0"), "b сохранён").ЭтоИстина();
	Ожидаем.Что(Существует(Хранилище, "px", "pkg-c", "1.0.0"), "новейший (c) сохранён").ЭтоИстина();

	// вытесненные байты обязаны вернуться пулу: кэш входит в занятое место, и пул,
	// упёршийся в квоту из-за кэша, выходит из-за границы сам, без вмешательства админа
	Ожидаем.Что(Объёмы.Дельта("px"), "уборка вернула пулу освобождённые байты")
		.Равно(-РазмерФайла);

КонецПроцедуры

&Тест
Процедура ПулБезКвотыНеТрогается() Экспорт

	Хранилище = НовоеХранилище();
	ПоложитьАртефакт(Хранилище, "px0", "pkg-a", "1.0.0", 512000);
	ПоложитьАртефакт(Хранилище, "px0", "pkg-b", "1.0.0", 512000);

	Пулы = Новый СервисПуловЗаглушка();
	Пулы.ДобавитьПул(Новый ПулЗаглушка(1, "px0", "proxy", 0)); // квота 0 = без лимита

	Сводка = Новый СборщикКэшаПрокси(Пулы, ПустойРеестр(), ПустойРеестр(), ПустойРеестр(), Новый УчётОбъёмаЗаглушка(), Хранилище, ЛогТестов()).Собрать();

	Ожидаем.Что(Сводка.ПуловОбработано, "пул без квоты не обрабатывается").Равно(0);
	Ожидаем.Что(Существует(Хранилище, "px0", "pkg-a", "1.0.0"), "артефакты целы").ЭтоИстина();
	Ожидаем.Что(Существует(Хранилище, "px0", "pkg-b", "1.0.0"), "артефакты целы").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПулыБезАпстримовИгнорируются() Экспорт

	Хранилище = НовоеХранилище();
	ПоложитьАртефакт(Хранилище, "loc", "pkg-a", "1.0.0", 512000);
	ПоложитьАртефакт(Хранилище, "loc", "pkg-b", "1.0.0", 512000);
	ПоложитьАртефакт(Хранилище, "loc", "pkg-c", "1.0.0", 512000);

	Пулы = Новый СервисПуловЗаглушка();
	Пулы.ДобавитьПул(Новый ПулЗаглушка(1, "loc", "local", 1), Ложь);

	Сводка = Новый СборщикКэшаПрокси(Пулы, ПустойРеестр(), ПустойРеестр(), ПустойРеестр(), Новый УчётОбъёмаЗаглушка(), Хранилище, ЛогТестов()).Собрать();

	Ожидаем.Что(Сводка.УдаленоФайлов, "из пула без апстримов ничего не вытеснено").Равно(0);
	Ожидаем.Что(Существует(Хранилище, "loc", "pkg-a", "1.0.0"), "собственный артефакт цел").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СобственныеПубликацииНеВытесняются() Экспорт

	Хранилище = НовоеХранилище();
	РазмерФайла = 512000;

	ПутьСвой = ПоложитьАртефакт(Хранилище, "mix", "mine", "1.0.0", РазмерФайла);
	ПутьЧужой1 = ПоложитьАртефакт(Хранилище, "mix", "cached-a", "1.0.0", РазмерФайла);
	ПутьЧужой2 = ПоложитьАртефакт(Хранилище, "mix", "cached-b", "1.0.0", РазмерФайла);
	СтарениеПоВозрастанию(ПутьСвой, ПутьЧужой1, ПутьЧужой2);

	Пулы = Новый СервисПуловЗаглушка();
	Пулы.ДобавитьПул(Новый ПулЗаглушка(1, "mix", "local", 1)); // квота 1 МБ, есть апстрим

	Реестр = Новый РеестрПровенансаЗаглушка();
	Реестр.Добавить("mine", "1.0.0", "свой");
	Реестр.Добавить("cached-a", "1.0.0", "апстрим");
	Реестр.Добавить("cached-b", "1.0.0", "апстрим");

	Объёмы = Новый УчётОбъёмаЗаглушка();
	Сводка = Новый СборщикКэшаПрокси(Пулы, Реестр, Реестр, Реестр, Объёмы, Хранилище, ЛогТестов()).Собрать();

	Ожидаем.Что(Объёмы.Дельта("mix"), "пулу вернулись байты ровно вытесненного артефакта")
		.Равно(-РазмерФайла);
	Ожидаем.Что(Сводка.УдаленоФайлов, "вытеснен один артефакт — апстримный").Равно(1);
	Ожидаем.Что(Существует(Хранилище, "mix", "mine", "1.0.0"),
		"своя публикация цела, хотя она старейшая").ЭтоИстина();
	Ожидаем.Что(Существует(Хранилище, "mix", "cached-a", "1.0.0"),
		"старейший АПСТРИМНЫЙ артефакт вытеснен").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеопознанныйАртефактНеВытесняется() Экспорт

	Хранилище = НовоеХранилище();
	ПоложитьАртефакт(Хранилище, "orph", "ghost-a", "1.0.0", 512000);
	ПоложитьАртефакт(Хранилище, "orph", "ghost-b", "1.0.0", 512000);
	ПоложитьАртефакт(Хранилище, "orph", "ghost-c", "1.0.0", 512000);

	Пулы = Новый СервисПуловЗаглушка();
	Пулы.ДобавитьПул(Новый ПулЗаглушка(1, "orph", "local", 1));

	Сводка = Новый СборщикКэшаПрокси(Пулы, ПустойРеестр(), ПустойРеестр(), ПустойРеестр(), Новый УчётОбъёмаЗаглушка(), Хранилище, ЛогТестов()).Собрать();

	Ожидаем.Что(Сводка.УдаленоФайлов, "неопознанные артефакты не вытесняются (fail-closed)").Равно(0);
	Ожидаем.Что(Существует(Хранилище, "orph", "ghost-a", "1.0.0"), "файл цел").ЭтоИстина();

КонецПроцедуры

// Уборка кэша перебирает опись пула по давности: вопрос о пакете и версии на КАЖДЫЙ
// файл делал бы её цену числом файлов в кэше, а их там тысячи.
&Тест
Процедура ЦенаУборкиКэшаНеРастётСЧисломФайлов() Экспорт

	НаТрёх = ЦенаУборкиКэша(3);
	НаДвадцати = ЦенаУборкиКэша(20);

	Ожидаем.Что(НаДвадцати.Выборок, СтрШаблон(
		"двадцать файлов стоят столько же выборок реестра, сколько три: %1 против %2",
		Формат(НаДвадцати.Выборок, "ЧН=0; ЧГ=0"), Формат(НаТрёх.Выборок, "ЧН=0; ЧГ=0")))
		.Равно(НаТрёх.Выборок);

	Ожидаем.Что(НаДвадцати.Выборок, "пакеты пула и их версии — по разрезу на пул").Равно(2);

	// счётчик не должен мерить пустую работу: вытеснено ровно столько, чтобы уложиться
	// в квоту, и вытеснено именно старейшее
	Ожидаем.Что(НаДвадцати.УдаленоФайлов, "вытеснено всё лишнее сверх квоты").Равно(18);
	Ожидаем.Что(НаДвадцати.СтарейшийВытеснен, "первым ушёл старейший артефакт").ЭтоИстина();
	Ожидаем.Что(НаДвадцати.НовейшийЦел, "новейший артефакт остался").ЭтоИстина();

КонецПроцедуры

// Квота — два файла: сколько бы файлов ни лежало в кэше, уборка обязана дойти до неё,
// перебирая опись, и спросить реестр ровно дважды.
Функция ЦенаУборкиКэша(Знач ЧислоФайлов)

	Хранилище = НовоеХранилище();
	РазмерФайла = 512000;
	Реестр = Новый РеестрПровенансаЗаглушка();

	Пути = Новый Массив();
	Для Номер = 1 По ЧислоФайлов Цикл
		ИмяПакета = СтрШаблон("cache-%1", Формат(Номер, "ЧН=0; ЧГ=0"));
		Пути.Добавить(ПоложитьАртефакт(Хранилище, "gc", ИмяПакета, "1.0.0", РазмерФайла));
		Реестр.Добавить(ИмяПакета, "1.0.0", "апстрим");
	КонецЦикла;
	Для Позиция = 0 По Пути.ВГраница() Цикл
		УстановитьВремя(Пути[Позиция], Дата(2026, 1, 1, 0, 0, 0) + Позиция * 3600);
	КонецЦикла;

	Пулы = Новый СервисПуловЗаглушка();
	Пулы.ДобавитьПул(Новый ПулЗаглушка(1, "gc", "proxy", 1)); // квота 1 МБ — два файла

	Сводка = Новый СборщикКэшаПрокси(Пулы, Реестр, Реестр, Реестр,
		Новый УчётОбъёмаЗаглушка(), Хранилище, ЛогТестов()).Собрать();

	Итог = Новый Структура();
	Итог.Вставить("Выборок", Реестр.Выборок());
	Итог.Вставить("УдаленоФайлов", Сводка.УдаленоФайлов);
	Итог.Вставить("СтарейшийВытеснен", НЕ Существует(Хранилище, "gc", "cache-1", "1.0.0"));
	Итог.Вставить("НовейшийЦел", Существует(Хранилище, "gc",
		СтрШаблон("cache-%1", Формат(ЧислоФайлов, "ЧН=0; ЧГ=0")), "1.0.0"));
	Возврат Итог;

КонецФункции

Функция ПустойРеестр()
	Возврат Новый РеестрПровенансаЗаглушка();
КонецФункции

Функция НовоеХранилище()
	Корень = УникальныеИмена.ВременныйКаталог("gc");
	Корни_.Добавить(Корень);
	Возврат Новый ФайловоеХранилище(Корень, 0);
КонецФункции

Функция ПоложитьАртефакт(Знач Хранилище, Знач Пул, Знач Пакет, Знач Версия, Знач РазмерБайт)
	Координаты = Новый КоординатыАртефакта(Пул, Пакет, Версия);
	Хранилище.Сохранить(Координаты, БуферБайт(РазмерБайт));
	Возврат Хранилище.Получить(Координаты);
КонецФункции

Функция Существует(Знач Хранилище, Знач Пул, Знач Пакет, Знач Версия)
	Возврат Хранилище.Существует(Новый КоординатыАртефакта(Пул, Пакет, Версия));
КонецФункции

Процедура СтарениеПоВозрастанию(Знач ПутьA, Знач ПутьB, Знач ПутьC)
	УстановитьВремя(ПутьA, Дата(2026, 1, 1, 0, 0, 0));
	УстановитьВремя(ПутьB, Дата(2026, 1, 1, 1, 0, 0));
	УстановитьВремя(ПутьC, Дата(2026, 1, 1, 2, 0, 0));
КонецПроцедуры

Процедура УстановитьВремя(Знач Путь, Знач Момент)
	Ф = Новый Файл(Путь);
	Ф.УстановитьВремяИзменения(Момент);
КонецПроцедуры

Функция БуферБайт(Знач РазмерБайт)
	КилоБлоки = Макс(1, Цел(РазмерБайт / 1024));
	Блок1К = "";
	Для Сч = 1 По 1024 Цикл
		Блок1К = Блок1К + "a";
	КонецЦикла;
	Куски = Новый Массив();
	Для Сч = 1 По КилоБлоки Цикл
		Куски.Добавить(Блок1К);
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Куски, ""), "UTF-8", Ложь);
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub");
КонецФункции
