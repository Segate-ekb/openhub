// Тесты разбора страницы пакета источника: версии берутся из ссылок на артефакты этого
// пакета, а чужие ссылки, latest-ссылка и произвольный текст страницы версий не дают.
// Разбором живут двое: зеркало при перечислении и выдача при сборе объединённого набора.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПрокси;
Перем КаталогРеестра;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогПрокси = ОбъединитьПути(КаталогМодулей, "прокси", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогПрокси, "РазборВерсийПакета");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогРеестра, "СравнительВерсий.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогРеестра, "РазобраннаяВерсия.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогРеестра, "РазобранныйДиапазон.os"));
КонецПроцедуры

&Тест
Процедура ВерсииБерутсяИзСсылокНаАртефактыПакета() Экспорт

	Разметка = ЭлементВерсии("alfa", "1.6.2") + ЭлементВерсии("alfa", "1.6.1")
		+ ЭлементВерсии("alfa", "1.6.0");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "перечислены все версии страницы")
		.Равно("1.6.2,1.6.1,1.6.0");

КонецПроцедуры

// README апстрима недоверенный: ссылка на артефакт ЧУЖОГО пакета не должна приезжать
// в перечень версий этого — иначе зеркало скачает чужой файл под чужим именем.
&Тест
Процедура ВерсииЧужогоПакетаНеПодхватываются() Экспорт

	Разметка = ЭлементВерсии("alfa", "1.0.0")
		+ ЭлементВерсии("beta", "9.9.9")
		+ Ссылка("/download/beta/alfa-8.8.8.ospx")  // имя нашего пакета в ЧУЖОМ каталоге
		+ Ссылка("/download/alfa/beta-7.7.7.ospx"); // чужое имя в каталоге нашего пакета

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "артефакт пакета опознаётся каталогом И именем файла")
		.Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ИмяПакетаСличаетсяЦеликомАНеПрефиксом() Экспорт

	Разметка = ЭлементВерсии("alfa-extra", "2.0.0") + ЭлементВерсии("alfa", "1.0.0");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "пакет с общим префиксом имени — чужой").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура СсылкаНаLatestВерсиейНеСчитается() Экспорт

	Разметка = Ссылка("/download/alfa/alfa.ospx") + ЭлементВерсии("alfa", "1.0.0");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "у latest-ссылки версии нет").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура НеразбираемыеВерсииОтбрасываются() Экспорт

	Разметка = Ссылка("/download/alfa/alfa-нетверсия.ospx")
		+ Ссылка("/download/alfa/alfa-.ospx")
		+ Ссылка("/download/alfa/alfa-1.2.3.4.5.ospx")
		+ ЭлементВерсии("alfa", "1.0.0");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "мусор вместо версии не берётся").Равно("1.0.0");

КонецПроцедуры

// Страница отдаёт README пакета как есть: путь артефакта, напечатанный в тексте или
// внутри примера кода, ссылкой не является и перечня версий не образует.
&Тест
Процедура ПутьВТекстеСтраницыВерсиейНеСтановится() Экспорт

	Разметка = "<pre><code>opm install alfa/alfa-7.7.7.ospx</code></pre>"
		+ "<p>alfa/alfa-8.8.8.ospx</p>"
		+ ЭлементВерсии("alfa", "1.0.0");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "версия читается только из ссылки").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ДублиСсылокСхлопываются() Экспорт

	// на странице хаба актуальная версия продублирована в боковой колонке
	Разметка = ЭлементВерсии("alfa", "1.0.0") + ЭлементВерсии("alfa", "0.9.0")
		+ ЭлементВерсии("alfa", "1.0.0");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "дубль ссылки не даёт дубля версии").Равно("1.0.0,0.9.0");

КонецПроцедуры

&Тест
Процедура ПорядокВерсийПоУбыванию() Экспорт

	Разметка = ЭлементВерсии("alfa", "0.9.9") + ЭлементВерсии("alfa", "10.0.0")
		+ ЭлементВерсии("alfa", "1.0.0-rc.1") + ЭлементВерсии("alfa", "1.0.0")
		+ ЭлементВерсии("alfa", "2.0.0.1");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "порядок semver, а не порядок ссылок")
		.Равно("10.0.0,2.0.0.1,1.0.0,1.0.0-rc.1,0.9.9");

КонецПроцедуры

&Тест
Процедура ОдинарныеКавычкиИЗапросВСсылке() Экспорт

	Разметка = "<a href='/download/alfa/alfa-1.0.0.ospx?token=x#top'>1.0.0</a>";

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "кавычки и хвост адреса разбору не мешают").Равно("1.0.0");

КонецПроцедуры

// "href" внутри чужого имени атрибута ссылкой не является: у страницы апстрима есть
// data-атрибуты, и их значения — не адреса артефактов.
&Тест
Процедура ХвостЧужогоИмениАтрибутаСсылкойНеСчитается() Экспорт

	Разметка = "<a data-xhref=""/download/alfa/alfa-9.9.9.ospx"" "
		+ "xhref=""/download/alfa/alfa-8.8.8.ospx"">чужие атрибуты</a>"
		+ ЭлементВерсии("alfa", "1.0.0");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "имя атрибута сличается целиком").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ПробелыВокругРавноИОборванныйАтрибут() Экспорт

	Разметка = "<a href = ""/download/alfa/alfa-1.0.0.ospx"">c пробелами</a>"
		+ "<a href=/download/alfa/alfa-2.0.0.ospx>без кавычек</a>"
		+ "<b href"; // атрибут оборван концом разметки

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "значение берётся только из кавычек").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура РегистрИмениВСсылкеНеЗначим() Экспорт

	Разметка = Ссылка("/download/Alfa/Alfa-1.0.0.ospx");

	Перечень = Разбор().Версии(Разметка, "alfa");

	Ожидаем.Что(СтрСоединить(Перечень, ","), "имя пакета сличается без учёта регистра").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ПустаяРазметкаИлиПустоеИмяДаютПустойПеречень() Экспорт

	Ожидаем.Что(Разбор().Версии("", "alfa").Количество(), "пустая страница — пустой перечень").Равно(0);
	Ожидаем.Что(Разбор().Версии(ЭлементВерсии("alfa", "1.0.0"), "").Количество(),
		"без имени пакета перечня нет").Равно(0);
	Ожидаем.Что(Разбор().Версии("<html><body>нет ссылок</body></html>", "alfa").Количество(),
		"страница без ссылок — пустой перечень").Равно(0);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Разбор()
	Возврат Новый РазборВерсийПакета(Новый СравнительВерсий());
КонецФункции

// Разметка элемента списка версий — как её отдаёт страница пакета хаба.
Функция ЭлементВерсии(Знач ИмяПакета, Знач Версия)
	Возврат СтрШаблон("<div class=""item""><div class=""content"">%1</div></div>",
		Ссылка(СтрШаблон("/download/%1/%1-%2.ospx", ИмяПакета, Версия)));
КонецФункции

Функция Ссылка(Знач Адрес)
	Возврат СтрШаблон("<a class=""header"" href=""%1"">ссылка</a>", Адрес);
КонецФункции

#КонецОбласти
