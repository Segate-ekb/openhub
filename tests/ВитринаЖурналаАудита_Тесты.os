// Юнит-тесты витрины журнала аудита: варианты отбора — действия прочитанного хвоста
// файла, честное объяснение границ хвоста, экранирование ячеек и деталей, выход со
// страницы за краем журнала.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;          // СборкаUI — компоненты кита, тексты, рендереры
Перем Рендерер;    // РендерерКабинета
Перем Отборы;      // ОтборЖурналаАудита

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСлужбаАудита");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

	КлассыИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");

	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(КлассыИнтерфейса, "РендерерКабинета");
	Поиск.Подключить(КлассыИнтерфейса, "ОтборЖурналаАудита");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"), "ОтборПоАдресу");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "КанонIP");
	Поиск.Подключить(КлассыИнтерфейса, "ВитринаЖурналаАудита");

	UI = Новый СборкаUI().Собрать(КлассыИнтерфейса);
	Рендерер = Новый РендерерКабинета(UI.Каркас, UI.Экран, Неопределено, UI.Набор, UI.Тексты);
	Отборы = Новый ОтборЖурналаАудита(Новый ОтборПоАдресу(Новый КанонIP()));

КонецПроцедуры

#Область ОтборПоАдресу

&Тест
Процедура ПолеАдресаЕстьВФормеИНесётВведённое() Экспорт

	Служба = Новый ФейкСлужбаАудита();
	Служба.Добавить("root", "настройка.изменена", "oshub.ui.theme", "{}", "");

	HTML = Разметка(Служба, Отборы.Разобрать("", "", "", "", "10.0.0.0/8"), 1);

	Ожидаем.Что(СтрНайти(HTML, "name=""" + Отборы.ИмяАдреса() + """") > 0,
		"поле адреса есть в форме отбора").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "10.0.0.0/8") > 0,
		"введённое возвращается в поле, а не теряется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НепрочитанныйАдресЭкранНазываетАЖурналПоказывает() Экспорт

	// пустой список под непрочитанным адресом читался бы как «таких операций не было»,
	// поэтому отбор по адресу не применяется вовсе, а экран называет причину
	Служба = Новый ФейкСлужбаАудита();
	Служба.Добавить("root", "настройка.изменена", "oshub.ui.theme", "{}", "10.0.0.1");

	Прочитанный = Разметка(Служба, Отборы.Разобрать("", "", "", "", "10.0.0.1"), 1);
	Непрочитанный = Разметка(Служба, Отборы.Разобрать("", "", "", "", "не-адрес-вовсе"), 1);

	Ожидаем.Что(СтрНайти(Непрочитанный, "не прочитан") > 0,
		"экран говорит, что адрес не прочитан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Непрочитанный, "не-адрес-вовсе") > 0,
		"и называет введённое значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Непрочитанный, "настройка.изменена") > 0,
		"а журнал показан без отбора по адресу, а не пустым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Прочитанный, "не прочитан"),
		"прочитанный адрес объяснения не требует").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ВариантыОтбора

&Тест
Процедура ВариантамиОтбораСлужатДействияПрочитанногоХвоста() Экспорт

	// Вариант, под которым в прочитанном хвосте нет ни одной записи, отвечал бы
	// «записей нет» и читался бы аудитором как «таких операций не было».
	Служба = Новый ФейкСлужбаАудита();
	Служба.Добавить("root", "настройка.изменена", "oshub.ui.theme", "{}", "");
	Служба.Добавить("root", "права.выданы", "пул/пакет", "{}", "");
	Служба.Добавить("anna", "настройка.изменена", "oshub.ui.accent", "{}", "");

	HTML = Разметка(Служба, Отборы.Пустой(), 1);

	Ожидаем.Что(СтрНайти(HTML, "value=""настройка.изменена""") > 0,
		"действие из хвоста предложено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""права.выданы""") > 0, "и соседнее действие").ЭтоИстина();
	Ожидаем.Что(ЧислоВхождений(HTML, "value=""настройка.изменена"""),
		"повтор действия не удваивает вариант").Равно(1);

	// каждый предложенный вариант обязан находиться в показанных записях
	Действия = ДействияЗаписей(Служба);
	Ненаходимые = Новый Массив();
	Для Каждого Вариант Из ВариантыОтбора(HTML) Цикл
		Если ЗначениеЗаполнено(Вариант) И Действия.Получить(Вариант) = Неопределено Тогда
			Ненаходимые.Добавить(Вариант);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Ненаходимые, ", "),
		"варианты отбора, под которыми в хвосте нет ни одной записи").Равно("");

КонецПроцедуры

&Тест
Процедура ДействующийОтборОстаётсяВСпискеДажеБезЗаписей() Экспорт

	// отбор по действию, которого на этой странице нет: экран обязан показывать его
	// выбранным, а не «Все события» при работающем отборе
	Служба = Новый ФейкСлужбаАудита();
	HTML = Разметка(Служба, Отборы.Разобрать("древнее.действие", "", "", ""), 1);

	Ожидаем.Что(СтрНайти(HTML, "value=""древнее.действие"" selected") > 0,
		"действующий отбор виден и помечен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЭкранНазываетГраницыПрочитанногоХвоста() Экспорт

	// пустой экран без объяснения — то же ложное «событий не было»
	Служба = Новый ФейкСлужбаАудита();
	HTML = Разметка(Служба, Отборы.Пустой(), 1);

	Ожидаем.Что(СтрНайти(HTML, "хвост файла журнала") > 0,
		"экран честно называет границы отбора").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "прочитанном хвосте") > 0,
		"и пустая выдача объяснена хвостом, а не «журнал пуст»").ЭтоИстина();
	// обе стороны: наличие честной строки и отсутствие ложной — иначе сторож переживёт
	// подмену текста на «источник недоступен» при живом источнике
	Ожидаем.Что(СтрНайти(HTML, "Источник журнала недоступен"),
		"живой источник недоступным не назван").Равно(0);

КонецПроцедуры

&Тест
Процедура НедоступныйИсточникНеВыдаётСебяЗаПустойЖурнал() Экспорт

	Служба = Новый ФейкСлужбаАудита();
	Служба.ИсточникДоступен = Ложь;

	HTML = Разметка(Служба, Отборы.Пустой(), 1);

	Ожидаем.Что(СтрНайти(HTML, "Источник журнала недоступен") > 0,
		"недоступный источник назван прямо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "хвост файла журнала"),
		"и обещания «отбор по хвосту» при этом нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "прочитанном хвосте"),
		"и пустая таблица не выдаёт себя за прочитанный хвост").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Экранирование

&Тест
Процедура ДеталиСобытияЭкранируютсяВПарах() Экспорт

	// ДеталиJSON несут поля, заполненные ПОЛЬЗОВАТЕЛЕМ (репозиторий доверенного конвейера,
	// имя провайдера): без экранирования журнал администратора исполняет чужую разметку.
	Служба = Новый ФейкСлужбаАудита();
	Служба.Добавить("root", "доверие.выдано", "пул/пакет",
		"{""репозиторий"":""</td><script>alert(1)</script>"",""<img src=x>"":""значение""}", "");
	// «Кто» приходит от провайдера входа, а у записи с ДЕТАЛЯМИ оно едет ещё и в атрибут
	// имени разворота: атака на атрибут закрывает кавычку, а не открывает тег
	Служба.Добавить(""" onmouseover=alert(1) x=""", "вход.выполнен", "учётка",
		"{""ключ"":""значение""}", "");

	HTML = Разметка(Служба, Отборы.Пустой(), 1);

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "разметка значения деталей не исполняется").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "и разметка имени поля тоже").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0, "значение показано текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "&lt;img") > 0, "имя поля показано текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "&lt;/td&gt;") > 0, "закрывающий тег не разорвал таблицу").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, """ onmouseover="),
		"имя записи не разорвало атрибут aria-label: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&quot; onmouseover=") > 0,
		"кавычка имени обезврежена, а не потеряна").ЭтоИстина();

КонецПроцедуры

// Детали живут ОТДЕЛЬНОЙ строкой таблицы, а не ячейкой своей записи: принадлежность
// больше не читается ни по колонке, ни по соседству в ряду. Без имени два десятка
// «Подробнее» на странице с экрана неразличимы — какую запись раскрыл, непонятно.
&Тест
Процедура РазворотДеталейНазываетСвоюЗапись() Экспорт

	Служба = Новый ФейкСлужбаАудита();
	Служба.Добавить("root", "доверие.выдано", "пул/пакет", "{""ключ"":""значение""}", "");
	Служба.Добавить("аудитор", "право.выдано", "пул", "{""ключ"":""значение""}", "");

	HTML = Разметка(Служба, Отборы.Пустой(), 1);

	// время берётся в том же формате, что печатает ячейка «Когда»: имя разворота обязано
	// совпадать с тем, что читатель видит в строке, а не жить своим форматом
	Когда = Формат(Дата(2026, 8, 3, 10, 0, 0), "ДЛФ=DT");

	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Подробнее: " + Когда + ", root""") > 0,
		"переключатель назвал свою запись — когда и кто: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Подробнее: " + Когда + ", аудитор""") > 0,
		"у соседней записи имя своё, а не общее").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Подробнее</summary>") > 0,
		"видимая подпись осталась короткой: доступное имя начинается с неё же").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЯчейкиСтрокиЭкранируютсяВключаяПустые() Экспорт

	Служба = Новый ФейкСлужбаАудита();
	Служба.Добавить("<script>alert(1)</script>", "провайдер.заведён",
		"</td><b>объект</b>", "", "<img src=x onerror=alert(2)>");

	HTML = Разметка(Служба, Отборы.Пустой(), 1);

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "субъект операции экранирован").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<b>объект"), "объект экранирован").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "адрес источника экранирован").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0, "субъект показан текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "&lt;b&gt;объект") > 0, "объект показан текстом").ЭтоИстина();

	// пустые детали печатаются прочерком, а не пустой ячейкой
	Ожидаем.Что(СтрНайти(HTML, "<td><span class=""muted"">—</span></td>") > 0,
		"пустое значение показано прочерком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td></td>"), "пустых ячеек на экране нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолеЗаписиКоторогоНетПечатаетсяПрочерком() Экспорт

	// «Кому» и «Детали» появились позже части строк файла: у старых полей нет вовсе,
	// и обращение к ним не должно ни падать, ни давать пустую ячейку
	Служба = Новый ФейкСлужбаАудита();
	Служба.ДобавитьСтаройФормы("root", "права.выданы", "пул#10");

	HTML = Разметка(Служба, Отборы.Пустой(), 1);

	Ожидаем.Что(СтрНайти(HTML, "<td>пул#10</td>") > 0, "строка старого формата показана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Кому") > 0, "колонка субъекта права на месте").ЭтоИстина();
	// время журнала хранится и печатается в UTC, а <input type="date"> админ заполняет
	// по местному: без пометки «сегодня» в 01:00 MSK означало бы вчерашние сутки
	Ожидаем.Что(СтрНайти(HTML, "Когда (UTC)") > 0, "колонка времени помечена как UTC").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "С даты (UTC)") > 0, "и границы периода тоже").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td></td>"), "отсутствующее поле не даёт пустой ячейки").Равно(0);

КонецПроцедуры

&Тест
Процедура УсечённыйХвостОтличимОтТрёхСоседнихСостояний() Экспорт

	// «Записей нет» на экране означает РАЗНОЕ: в прочитанном хвосте пусто; источник
	// не читается; журнал прочитан не целиком и старое осталось за прочитанным.
	// Последнее состояние читатель отдаёт признаком ХвостУсечён — до экрана он обязан
	// доехать, иначе пустая страница по старому периоду врёт про «событий не было».
	Полный = Тексты("settings.hub.audit.tail.note");
	Усечённый = Тексты("settings.hub.audit.tail.truncated");
	Недоступен = Тексты("settings.hub.audit.source.missing");

	Ожидаем.Что(Усечённый = Полный, "усечение и полное чтение — разные объяснения").ЭтоЛожь();
	Ожидаем.Что(Усечённый = Недоступен, "усечение и недоступный источник — тоже").ЭтоЛожь();
	Ожидаем.Что(НРег(Усечённый), "текст обязан сказать, что журнал прочитан не целиком")
		.Содержит("не целиком");

	СЗаписями = Новый ФейкСлужбаАудита();
	СЗаписями.Добавить("root", "настройка.изменена", "oshub.ui.theme", "{}", "");
	HTML = Разметка(СЗаписями, Отборы.Пустой(), 1);
	Ожидаем.Что(СтрНайти(HTML, Полный) > 0, "журнал прочитан весь: обычное примечание").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Усечённый), "и про усечение экран не выдумывает").Равно(0);

	Пустая = Новый ФейкСлужбаАудита();
	HTML = Разметка(Пустая, Отборы.Пустой(), 1);
	Ожидаем.Что(СтрНайти(HTML, Тексты("settings.hub.audit.empty")) > 0,
		"в прочитанном хвосте по отбору пусто").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Усечённый), "но прочитан он был целиком").Равно(0);

	Недоступный = Новый ФейкСлужбаАудита();
	Недоступный.ИсточникДоступен = Ложь;
	HTML = Разметка(Недоступный, Отборы.Пустой(), 1);
	Ожидаем.Что(СтрНайти(HTML, Недоступен) > 0, "источник не читается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Усечённый), "это не усечение").Равно(0);

	Усечённая = Новый ФейкСлужбаАудита();
	Усечённая.ХвостУсечён = Истина;
	HTML = Разметка(Усечённая, Отборы.Пустой(), 1);
	Ожидаем.Что(СтрНайти(HTML, Усечённый) > 0,
		"журнал прочитан не целиком — экран обязан сказать это прямо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Полный),
		"обычное примечание не имеет права заменять предупреждение об усечении").Равно(0);

	// Нечитаемый файл читатель отдаёт с ОБОИМИ признаками сразу (ЧитательЖурналаАудита:
	// Усечён = Истина и Доступен = Ложь). Порядок ветвей — часть ответа: «прочитано не всё»
	// обещает, что остальное в файле есть, а файл не прочитан вовсе.
	Оба = Новый ФейкСлужбаАудита();
	Оба.ИсточникДоступен = Ложь;
	Оба.ХвостУсечён = Истина;
	HTML = Разметка(Оба, Отборы.Пустой(), 1);
	Ожидаем.Что(СтрНайти(HTML, Недоступен) > 0,
		"нечитаемый источник объясняется недоступностью, а не длиной журнала").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Усечённый),
		"обещать «остальное в файле» про файл, который не прочитан, экран не вправе").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Страницы

&Тест
Процедура СтраницаЗаКраемЖурналаПредлагаетВыходВНачало() Экспорт

	// «Назад» со страницы 999 ведёт на 998 — из пустоты в пустоту; выход обязан быть в один клик
	Служба = Новый ФейкСлужбаАудита();
	HTML = Разметка(Служба, Отборы.Пустой(), 999);

	Ожидаем.Что(СтрНайти(HTML, "В начало журнала") > 0, "предложен выход к началу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "page=1") > 0, "и ведёт он на первую страницу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "rel=""prev"""), "тупиковой навигации на экране нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Страница 999"), "и номера страницы за краем тоже").Равно(0);

КонецПроцедуры

&Тест
Процедура НепустаяСтраницаПечатаетНавигацию() Экспорт

	Служба = Новый ФейкСлужбаАудита();
	Служба.Добавить("root", "настройка.изменена", "oshub.ui.theme", "{}", "");
	Служба.ЕстьСледующая = Истина;

	HTML = Разметка(Служба, Отборы.Пустой(), 2);

	Ожидаем.Что(СтрНайти(HTML, "Страница 2") > 0, "номер текущей страницы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "rel=""next""") > 0, "и дорога вперёд").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Разметка(Знач Служба, Знач Отбор, Знач Страница)

	Витрина = Новый ВитринаЖурналаАудита(UI.Кит, UI.РендерерНастроек, UI.Набор,
		Служба, Отборы, UI.Тексты, НастройкиЖурнала());

	Параметры = Новый Структура("Адрес, Отбор, Страница", "/hub/settings/audit", Отбор, Страница);

	Результат = "";
	Для Каждого Секция Из Витрина.Секции(Параметры) Цикл
		Результат = Результат + Секция.Тело;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Тексты(Знач Ключ)
	Возврат UI.Тексты.Текст(Ключ);
КонецФункции

// Значения вариантов <select name="type"> в порядке разметки.
Функция ВариантыОтбора(Знач HTML)

	Результат = Новый Массив();
	Начало = СтрНайти(HTML, "name=""type""");
	Если Начало = 0 Тогда
		ВызватьИсключение "В разметке нет поля отбора по типу события";
	КонецЕсли;

	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Хвост, "</select>");
	Выбор = ?(Конец = 0, Хвост, Лев(Хвост, Конец));

	Для Каждого Кусок Из СтрРазделить(Выбор, "<") Цикл
		Если НЕ СтрНачинаетсяС(НРег(Кусок), "option") Тогда
			Продолжить;
		КонецЕсли;
		Маркер = "value=""";
		Поз = СтрНайти(Кусок, Маркер);
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Сред(Кусок, Поз + СтрДлина(Маркер));
		КонецЗнач = СтрНайти(Остаток, """");
		Результат.Добавить(?(КонецЗнач = 0, "", Лев(Остаток, КонецЗнач - 1)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДействияЗаписей(Знач Служба)

	Результат = Новый Соответствие();
	Для Каждого Запись Из Служба.Записи Цикл
		Результат.Вставить(Строка(Запись.Действие), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЧислоВхождений(Знач Текст, Знач Фрагмент)

	Количество = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Фрагмент);
	Пока Позиция > 0 Цикл
		Количество = Количество + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Фрагмент));
		Позиция = СтрНайти(Хвост, Фрагмент);
	КонецЦикла;
	Возврат Количество;

КонецФункции

#КонецОбласти

// Настройки экрана журнала для прямой сборки вне контейнера.
Функция НастройкиЖурнала()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.ui.audit_page_size", 20);
	Возврат Настройки;
КонецФункции
