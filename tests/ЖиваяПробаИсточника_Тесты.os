// Живая приёмка пробного подключения: хаб поднят с ВКЛЮЧЁННОЙ пробой и заводит источник
// формой раздела «Апстримы». Источник — наш второй хаб на свободном порту; мёртвый адрес —
// порт, который заявлен выдачей портов и никем не слушается. Сети наружу нет.

#Использовать asserts
#Использовать "фикстуры"

Перем ХабИсточника;    // фикстура ЭкземплярХаба: живой источник по контракту opm
Перем ХабПотребителя;  // фикстура ЭкземплярХаба: хаб, который заводит источники с пробой
Перем ПортИсточника;
Перем Порт;
Перем МёртвыйПорт;     // заявлен, но не слушается: соединение к нему отбивается
Перем Порты;           // фикстура ВыдачаПортов — держит заявку на мёртвый порт
Перем КаталогПроекта;
Перем ТаймаутСек;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 90;
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабы() Экспорт

	ХабИсточника = НовыйХаб();
	КаталогПроекта = ХабИсточника.КаталогПроекта();

	ХабИсточника.ФайловаяБаза("openhub-проба-источник");
	ЗадатьОбщееОкружение(ХабИсточника);
	ЗапуститьСидер();
	ХабИсточника.Запустить();
	ПортИсточника = ХабИсточника.Порт();

	ХабПотребителя = НовыйХаб();
	ХабПотребителя.ФайловаяБаза("openhub-проба-потребитель");
	ЗадатьОбщееОкружение(ХабПотребителя);
	ЗапуститьСидер();
	// проба ставится ПОСЛЕ засева: сидер — отдельный процесс с тем же окружением,
	// и заводить источники ему не нужно
	ХабПотребителя.Среда("OSHUB_UPSTREAM_PROBE_ENABLED", "true");
	ХабПотребителя.Запустить();
	Порт = ХабПотребителя.Порт();

	МёртвыйПорт = ЗанятьМёртвыйПорт();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХабы() Экспорт

	Если ХабПотребителя <> Неопределено Тогда
		ХабПотребителя.Остановить();
	КонецЕсли;
	Если ХабИсточника <> Неопределено Тогда
		ХабИсточника.Остановить();
	КонецЕсли;
	Если Порты <> Неопределено Тогда
		Порты.ВернутьВсе();
	КонецЕсли;

КонецПроцедуры

// Порог НФТ-АПСТ-001 живьём: по адресу, куда хаб не достучался, источник НЕ появляется,
// а отказ называет причину; по адресу, который ответил списком пакетов, — появляется.
// Оба направления в одном тесте: они делят пару поднятых хабов.
&Тест
Процедура АдресНеСохраняетсяБезУдачногоПодключенияАЖивойЗаводится() Экспорт

	Кука = Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/upstreams";
	Страница = Тело(GET_Кука(Раздел, Кука));

	// самотест окружения: экран обещает пробу, значит хаб поднят именно с включённой
	Ожидаем.Что(СтрНайти(Страница, "источник не заводится") > 0,
		"предпосылка: на этом хабе проба включена и форма её обещает").ЭтоИстина();

	Попытка

		МёртвыйАдресОтбитПричиной(Раздел, ИзвлечьCSRF(Страница), Кука);
		ЖивойАдресЗаведён(Раздел, ИзвлечьCSRF(Тело(GET_Кука(Раздел, Кука))), Кука);

	Исключение
		ДампХабов();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#Область ШагиСценария

Процедура МёртвыйАдресОтбитПричиной(Знач Раздел, Знач Токен, Знач Кука)

	Ответ = POSTФорма(Раздел, ПоляИсточника(Токен, АдресВыдачи(МёртвыйПорт)), Кука);

	Ожидаем.Что(УспехМутации(Ответ), "неотвечающий адрес не сохранён").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "не удалось подключиться") > 0,
		"отказ назвал причину: " + Тело(Ответ)).ЭтоИстина();

	// код ответа без этого ничего не стоит: порог требует, чтобы адреса НЕ БЫЛО в списке
	Ожидаем.Что(СтрНайти(Тело(GET_Кука(Раздел, Кука)), АдресВыдачи(МёртвыйПорт)),
		"мёртвый адрес не лёг в список источников").Равно(0);

КонецПроцедуры

Процедура ЖивойАдресЗаведён(Знач Раздел, Знач Токен, Знач Кука)

	Живой = АдресВыдачи(ПортИсточника);

	// самотест: источник и правда отвечает списком пакетов по контракту opm
	Ожидаем.Что(GET_Порт(ПортИсточника, "/download/list.txt").КодСостояния,
		"предпосылка: хаб-источник отдаёт list.txt").Равно(200);

	Ожидаем.Что(УспехМутации(POSTФорма(Раздел, ПоляИсточника(Токен, Живой), Кука)),
		"ответивший адрес заведён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(GET_Кука(Раздел, Кука)), Живой) > 0,
		"и виден в списке источников пула").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ПоляИсточника(Знач Токен, Знач Url)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "добавить");
	Поля.Вставить("url", Url);
	Поля.Вставить("ttl", "900");
	Возврат Поля;

КонецФункции

Функция АдресВыдачи(Знач НомерПорта)
	Возврат СтрШаблон("http://localhost:%1/download/", Формат(НомерПорта, "ЧГ=0; ЧН=0"));
КонецФункции

// Порт, который заявлен выдачей и потому не достанется соседнему прогону, но никем
// не слушается: соединение к нему отбивается сразу, без ожидания таймаута.
Функция ЗанятьМёртвыйПорт()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	РеестрФикстур.Подключить("ВыдачаПортов");

	Порты = Новый ВыдачаПортов();
	Возврат Порты.Выдать();

КонецФункции

Функция НовыйХаб()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	РеестрФикстур.Подключить("ЭкземплярХаба");

	Возврат Новый ЭкземплярХаба(ТаймаутСек);

КонецФункции

// Фоновые задачи и доставщик вебхуков выключены: обработчик запроса и фоновая рогатка
// в одном процессе лезут в один JSON-файл файлового коннектора и ловят блокировку.
Процедура ЗадатьОбщееОкружение(Знач Хаб)

	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_JOBS_ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

КонецПроцедуры

Процедура ЗапуститьСидер()

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьКабинет.os");
	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), КаталогПроекта, Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();

	Если Процесс.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер завершился с кодом %1: %2",
			Процесс.КодВозврата, Процесс.ПолучитьВыводПотокаОшибок());
	КонецЕсли;

КонецПроцедуры


Процедура ДампХабов()
	Сообщить("=== ПОТРЕБИТЕЛЬ ===");
	Сообщить(?(ХабПотребителя = Неопределено, "не поднимался", ХабПотребителя.Дамп()));
	Сообщить("=== ИСТОЧНИК ===");
	Сообщить(?(ХабИсточника = Неопределено, "не поднимался", ХабИсточника.Дамп()));
КонецПроцедуры

#КонецОбласти

#Область HTTPПомощники

Функция Войти(Знач Логин, Знач Пароль)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/api/v1/login", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль),
		КодировкаТекста.UTF8);

	Возврат ЗначениеКукиОтвета(Соединение(Порт).ОтправитьДляОбработки(Запрос), "oshub_session");

КонецФункции

Функция GET_Кука(Знач Путь, Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Возврат Соединение(Порт).Получить(Новый HTTPЗапрос(Путь, Заголовки));

КонецФункции

Функция GET_Порт(Знач НомерПорта, Знач Путь)
	Возврат Соединение(НомерПорта).Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция POSTФорма(Знач Путь, Знач Поля, Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(КодироватьФорму(Поля), КодировкаТекста.UTF8);

	Возврат Соединение(Порт).ОтправитьДляОбработки(Запрос);

КонецФункции

Функция КодироватьФорму(Знач Поля)

	Части = Новый Массив();
	Для Каждого КиЗ Из Поля Цикл
		Части.Добавить(КодироватьСтроку(Строка(КиЗ.Ключ), СпособКодированияСтроки.URLEncoding)
			+ "=" + КодироватьСтроку(Строка(КиЗ.Значение), СпособКодированияСтроки.URLEncoding));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");

КонецФункции

// Проба идёт на localhost и отбивается сразу, но таймаут соединения держим щедрым:
// заведение источника — это ещё и запись, а хаб на файловой БД неспешен.
Функция Соединение(Знач НомерПорта)
	Возврат Новый HTTPСоединение("localhost", НомерПорта, , , , 60);
КонецФункции

Функция Тело(Знач Ответ)
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

Функция УспехМутации(Знач Ответ)
	Возврат Ответ.КодСостояния < 400;
КонецФункции

Функция ИзвлечьCSRF(Знач Разметка)

	Маркер = "name=""_csrf"" value=""";
	Поз = СтрНайти(Разметка, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Разметка, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

Функция ЗначениеКукиОтвета(Знач Ответ, Знач ИмяКуки)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеИзSetCookie(Строка(КиЗ.Значение), ИмяКуки);
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Ищем ИМЕНОВАННУЮ куку в заголовке: winow отдаёт все куки ОДНОЙ строкой через запятую,
// поэтому разбор по разделителям путает атрибуты соседней куки с именем нужной.
Функция ЗначениеИзSetCookie(Знач Заголовок, Знач ИмяКуки)

	Маркер = ИмяКуки + "=";
	Начало = СтрНайти(Заголовок, Маркер);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Заголовок, Начало + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, ";");
	Возврат СокрЛП(?(Конец = 0, Остаток, Лев(Остаток, Конец - 1)));

КонецФункции

#КонецОбласти
