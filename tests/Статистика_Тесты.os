// Юнит-тесты статистики скачиваний (модуль статистика): сброс агрегатов по порогу и по интервалу с инъектируемым
// временем, витрина до сброса, идемпотентность, суточная агрегация, доставка события подписчику.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик_;   // порядковый источник уникальных идентификаторов пакетов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Счётчик_ = 0;

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"));
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы", "ИмяОбъектаАудита.os"),
		"ИмяОбъектаАудита");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы", "СобытиеАудита.os"),
		"СобытиеАудита");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "основа", "Классы", "ТекстJSON.os"),
		"ТекстJSON");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "основа", "Классы", "ТекстОшибки.os"),
		"ТекстОшибки");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "статистика", "Классы"));

	// издатель событий инъектирует желудь «Телеметрия» (здесь пустышка): регистрируем
	// Телеметрию и ТранспортHTTP — полный каталог observability потребовал бы storage
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "сеть", "Классы", "КоннекторHTTPБиблиотеки.os"), "КоннекторHTTPБиблиотеки");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "сеть", "Классы", "КлиентHTTP.os"), "КлиентHTTP");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "телеметрия/СпанХаба.os"), "СпанХаба");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "телеметрия/Телеметрия.os"), "Телеметрия");
	// ГотовностьХаба — гейт стартовых задач: без желудя бин службы не собирается
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "пробы/ГотовностьХаба.os"), "ГотовностьХаба");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "статистика-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&Тест
Процедура ПорогФорсируетСбросВБД() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(3, 99999); // порог 3, интервал огромный (проверяем именно порог)
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "до достижения порога БД пуста").Равно(0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент); // третий → порог достигнут → сброс
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "по достижении порога агрегаты в БД").Равно(3);

КонецПроцедуры

&Тест
Процедура ИнтервалФорсируетСбросВБД() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 60); // порог недостижим, работает интервал 60 сек
	Т = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Т);          // первый — фиксирует ПоследнийСброс=Т
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "интервал не истёк — БД пуста").Равно(0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Т + 61);     // прошло 61с ≥ 60 → сброс
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "по истечении интервала сброс в БД").Равно(2);

КонецПроцедуры

&Тест
Процедура ДоСбросаВитринаБеретИзПамяти() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "в БД ещё ничего не слито").Равно(0);
	Ожидаем.Что(Служба.СкачиванийПакета(Пакет), "витрина учитывает ожидающие в памяти").Равно(1);

КонецПроцедуры

// Карточка версии до сброса показывала ноль: СкачиванийВерсии читала только БД, хотя буфер
// в памяти хранит счётчик ключом «пакет + версия» и нужное число уже лежит в нём.
&Тест
Процедура ДоСбросаКарточкаВерсииБерётИзПамяти() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 41, Момент);

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоВерсии(41), "в БД по версии ещё ничего нет").Равно(0);
	Ожидаем.Что(Служба.СкачиванийВерсии(41), "карточка версии учитывает ожидающие в памяти").Равно(1);
	Ожидаем.Что(Служба.СкачиванийВерсии(42), "чужая версия остаётся нулевой").Равно(0);

	// после сброса число не удваивается: буфер опустошён, БД уже содержит то же скачивание
	Служба.Сбросить(Момент);
	Ожидаем.Что(Служба.СкачиванийВерсии(41), "после сброса счёт версии не удвоился").Равно(1);

КонецПроцедуры

// Разрез по всем пакетам витрина берёт одним проходом: часть из базы пересчитывается
// на сбросе, свежесть даёт буфер. Регресс держит обе половины и то, что после сброса
// число не удваивается.
&Тест
Процедура РазрезПоПакетамСкладываетБазуИБуферБезУдвоения() Экспорт

	Первый = НовыйПакет();
	Второй = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс сам не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Первый, 2, Момент);
	Служба.ЗафиксироватьСкачивание(Второй, 3, Момент);

	ИзБуфера = Служба.СкачиванияПоПакетам();
	Ожидаем.Что(ИзБуфера.Получить(Первый), "разрез видит ожидающие в памяти").Равно(2);
	Ожидаем.Что(ИзБуфера.Получить(Второй), "и по второму пакету").Равно(1);

	Служба.Сбросить(Момент);

	ИзБазы = Служба.СкачиванияПоПакетам();
	Ожидаем.Что(ИзБазы.Получить(Первый), "после сброса счёт не удвоился").Равно(2);
	Ожидаем.Что(ИзБазы.Получить(Второй), "и по второму тоже").Равно(1);

	// новое скачивание после сброса обязано быть видно сразу, а не после следующего
	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Ожидаем.Что(Служба.СкачиванияПоПакетам().Получить(Первый),
		"свежее скачивание попадает в разрез немедленно").Равно(3);

	Ожидаем.Что(Служба.СкачиванияПоПакетам().Получить(НовыйПакет()),
		"пакет без скачиваний в разрезе отсутствует").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СбросИдемпотентен() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999);
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Служба.Сбросить(Момент);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "после сброса в БД 1").Равно(1);

	Служба.Сбросить(Момент); // повторный сброс без новых данных не должен удвоить
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "повторный сброс идемпотентен").Равно(1);

КонецПроцедуры

&Тест
Процедура СуточнаяАгрегацияНакапливаетВОднуСтроку() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999);
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент + 3600); // те же сутки, +час
	Служба.Сбросить(Момент + 3600);

	Ожидаем.Что(СтрокАгрегатов(Пакет), "скачивания одних суток агрегируются в одну строку").Равно(1);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "сумма за сутки").Равно(2);

КонецПроцедуры

&Тест
Процедура РазныеПакетыИзолированы() Экспорт

	ПакетA = НовыйПакет();
	ПакетB = НовыйПакет();
	Служба = НоваяСлужба(1, 99999); // порог 1 — сброс на каждом скачивании
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(ПакетA, 1, Момент);

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(ПакетA), "A учтён").Равно(1);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(ПакетB), "B не затронут").Равно(0);

КонецПроцедуры

// Хука остановки приложения взять негде, поэтому всё, что осталось в буфере, теряется
// вместе с процессом. Порог сброса 1 — режим без потерь: после каждого скачивания в БД
// уже лежит всё зафиксированное, и терять при остановке нечего.
&Тест
Процедура ПорогЕдиницаПишетСквозьБуфер() Экспорт

	Сквозной = НовыйПакет();
	Служба = НоваяСлужба(1, 99999);
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Для Счёт = 1 По 3 Цикл
		Служба.ЗафиксироватьСкачивание(Сквозной, 1, Момент);
		Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Сквозной),
			СтрШаблон("в БД всё зафиксированное сразу после скачивания %1", Счёт)).Равно(Счёт);
	КонецЦикла;

	// та же нагрузка на буферном режиме: остановка прямо сейчас унесла бы все три
	Буферный = НовыйПакет();
	Буферная = НоваяСлужба(50, 99999);
	Для Счёт = 1 По 3 Цикл
		Буферная.ЗафиксироватьСкачивание(Буферный, 1, Момент);
	КонецЦикла;

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Буферный),
		"буферный режим держит скачивания в памяти — они и теряются при остановке").Равно(0);

КонецПроцедуры

&Тест
Процедура СобытиеСкачиванияИнкрементитСлужбу() Экспорт

	Пакет = НовыйПакет();
	СлужбаБоевая = Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний");
	Издатель = Поделка.НайтиЖелудь("ИздательСобытий");

	Ожидаем.Что(Издатель.КоличествоПодписчиков(Издатель.ТипСкачиваниеЗафиксировано()) >= 1,
		"служба статистики подписана на скачивания").ЭтоИстина();

	Данные = Новый Структура("ПакетИдентификатор, ВерсияИдентификатор", Пакет, 7);
	Издатель.Опубликовать(Издатель.ТипСкачиваниеЗафиксировано(), Данные);

	Ожидаем.Что(СлужбаБоевая.СкачиванийПакета(Пакет), "событие увеличило счётчик службы").Равно(1);

КонецПроцедуры

&Тест
Процедура НеизвестныйТипСобытияИгнорируетсяСлужбой() Экспорт

	Пакет = НовыйПакет();
	СлужбаБоевая = Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний");
	Издатель = Поделка.НайтиЖелудь("ИздательСобытий");

	Издатель.Опубликовать("посторонний.тип", Новый Структура("ПакетИдентификатор, ВерсияИдентификатор", Пакет, 1));

	Ожидаем.Что(СлужбаБоевая.СкачиванийПакета(Пакет), "чужой тип события не учитывается статистикой").Равно(0);

КонецПроцедуры

Функция ХранилищеАгрегатов()
	Возврат Поделка.НайтиЖелудь("ХранилищеСкачиванийАгрегатов");
КонецФункции

// Свежий экземпляр службы с собственными счётчиком и издателем; репозиторий агрегатов общий (БД).
Функция НоваяСлужба(Знач Порог, Знач Интервал)
	Возврат Новый СлужбаСтатистикиСкачиваний(
		Новый СчётчикСкачиванийВПамяти(),
		ХранилищеАгрегатов(),
		Новый ИздательСобытий(),
		НастройкиСчётчиков(Интервал, Порог),
		НоваяГотовность());
КонецФункции

Функция НовыйПакет()
	Счётчик_ = Счётчик_ + 1;
	Возврат 1000 + Счётчик_;
КонецФункции

Функция СтрокАгрегатов(Знач Пакет)
	Количество = 0;
	Для Каждого Строка Из ХранилищеАгрегатов().Все() Цикл
		Если Строка.ПакетИдентификатор = Пакет Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

// Свежая ГотовностьХаба для конструкторов стартовых задач: в юнит-тестах гейт никого не держит.
Функция НоваяГотовность()

	Попытка
		КаталогНабора = Новый Файл(ТекущийСценарий().Источник).Путь;
		ПодключитьСценарий(ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогНабора, "..")).ПолноеИмя,
			"src/модули/наблюдаемость/Классы/пробы/ГотовностьХаба.os"), "ГотовностьХаба");
	Исключение
	КонецПопытки;

	Возврат Новый ГотовностьХаба(ЛогТестов());

КонецФункции

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции

// Настройки счётчиков для прямой сборки службы вне контейнера.
Функция НастройкиСчётчиков(Знач Интервал, Знач Порог)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.stats.flush_interval_sec", Интервал);
	Настройки.Задать("oshub.stats.flush_threshold", Порог);
	Возврат Настройки;
КонецФункции
