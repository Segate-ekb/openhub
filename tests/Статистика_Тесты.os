// Юнит-тесты статистики скачиваний (модуль статистика): сброс агрегатов по порогу и по интервалу с инъектируемым
// временем, витрина до сброса, идемпотентность, суточная агрегация, доставка события подписчику,
// параллельные скачивания и сбросы, сбой записи.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ХранилищеСкачиванийЗаглушка");
	РеестрФикстур.Подключить("СтрокаАгрегатаПодНаблюдением");
	РеестрФикстур.Подключить("РепозиторийАгрегатовПодНаблюдением");
	РеестрФикстур.Подключить("ТабакеркаНаблюдаемая");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"));
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы", "ИмяОбъектаАудита.os"),
		"ИмяОбъектаАудита");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы", "СобытиеАудита.os"),
		"СобытиеАудита");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "основа", "Классы", "ТекстJSON.os"),
		"ТекстJSON");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "основа", "Классы", "ТекстОшибки.os"),
		"ТекстОшибки");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "статистика", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей, "фоновыеЗадания", "Классы",
		"ЗапускВФонеЗаданием.os"));

	// ГотовностьХаба — гейт стартовых задач: без желудя бин службы не собирается
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "пробы/ГотовностьХаба.os"), "ГотовностьХаба");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "статистика-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&Тест
Процедура ПорогФорсируетСбросВБД() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(3, 99999); // порог 3, интервал огромный (проверяем именно порог)
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "до достижения порога БД пуста").Равно(0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент); // третий → порог достигнут → сброс
	Ожидаем.Что(ДождатьсяСуммы(Пакет, 3), "по достижении порога агрегаты в БД").Равно(3);

КонецПроцедуры

&Тест
Процедура ИнтервалФорсируетСбросВБД() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 60); // порог недостижим, работает интервал 60 сек
	Т = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Т);          // первый — фиксирует ПоследнийСброс=Т
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "интервал не истёк — БД пуста").Равно(0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Т + 61);     // прошло 61с ≥ 60 → сброс
	Ожидаем.Что(ДождатьсяСуммы(Пакет, 2), "по истечении интервала сброс в БД").Равно(2);

КонецПроцедуры

&Тест
Процедура ДоСбросаВитринаБеретИзПамяти() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "в БД ещё ничего не слито").Равно(0);
	Ожидаем.Что(Служба.СкачиванийПакета(Пакет), "витрина учитывает ожидающие в памяти").Равно(1);

КонецПроцедуры

// Карточка версии до сброса показывала ноль: СкачиванийВерсии читала только БД, хотя буфер
// в памяти хранит счётчик ключом «пакет + версия» и нужное число уже лежит в нём.
&Тест
Процедура ДоСбросаКарточкаВерсииБерётИзПамяти() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 41, Момент);

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоВерсии(41), "в БД по версии ещё ничего нет").Равно(0);
	Ожидаем.Что(Служба.СкачиванийВерсии(41), "карточка версии учитывает ожидающие в памяти").Равно(1);
	Ожидаем.Что(Служба.СкачиванийВерсии(42), "чужая версия остаётся нулевой").Равно(0);

	// после сброса число не удваивается: буфер опустошён, БД уже содержит то же скачивание
	Служба.Сбросить(Момент);
	Ожидаем.Что(Служба.СкачиванийВерсии(41), "после сброса счёт версии не удвоился").Равно(1);

КонецПроцедуры

// Скачивания версий пакета складывают базу и ещё не слитое из памяти по каждой версии:
// строка версии не ждёт сброса, после сброса число не удваивается, а версии чужого пакета
// в разрез не попадают.
&Тест
Процедура СкачиванияВерсийПакетаСкладываютБазуИПамятьБезУдвоения() Экспорт

	Пакет = НовыйПакет();
	Чужой = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс сам не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 51, Момент);
	Служба.ЗафиксироватьСкачивание(Пакет, 51, Момент);
	Служба.Сбросить(Момент);
	Служба.ЗафиксироватьСкачивание(Пакет, 51, Момент);
	Служба.ЗафиксироватьСкачивание(Пакет, 52, Момент);
	Служба.ЗафиксироватьСкачивание(Чужой, 53, Момент);

	Скачивания = Служба.СкачиванияВерсийПакета(Пакет);
	Ожидаем.Что(Скачивания.Получить(51), "у версии база и память вместе").Равно(3);
	Ожидаем.Что(Скачивания.Получить(52), "у версии без сброса — память").Равно(1);
	Ожидаем.Что(Скачивания.Получить(53), "версия чужого пакета в разрез не попала").Равно(Неопределено);

	Служба.Сбросить(Момент);
	Скачивания = Служба.СкачиванияВерсийПакета(Пакет);
	Ожидаем.Что(Скачивания.Получить(51), "после сброса число версии не удвоилось").Равно(3);
	Ожидаем.Что(Скачивания.Получить(52), "и у соседней версии тоже").Равно(1);

КонецПроцедуры

// Разрез по всем пакетам витрина берёт одним проходом: часть из базы пересчитывается
// на сбросе, свежесть даёт буфер. Регресс держит обе половины и то, что после сброса
// число не удваивается.
&Тест
Процедура РазрезПоПакетамСкладываетБазуИБуферБезУдвоения() Экспорт

	Первый = НовыйПакет();
	Второй = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс сам не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Первый, 2, Момент);
	Служба.ЗафиксироватьСкачивание(Второй, 3, Момент);

	ИзБуфера = Служба.СкачиванияПоПакетам();
	Ожидаем.Что(ИзБуфера.Получить(Первый), "разрез видит ожидающие в памяти").Равно(2);
	Ожидаем.Что(ИзБуфера.Получить(Второй), "и по второму пакету").Равно(1);

	Служба.Сбросить(Момент);

	ИзБазы = Служба.СкачиванияПоПакетам();
	Ожидаем.Что(ИзБазы.Получить(Первый), "после сброса счёт не удвоился").Равно(2);
	Ожидаем.Что(ИзБазы.Получить(Второй), "и по второму тоже").Равно(1);

	// новое скачивание после сброса обязано быть видно сразу, а не после следующего
	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Ожидаем.Что(Служба.СкачиванияПоПакетам().Получить(Первый),
		"свежее скачивание попадает в разрез немедленно").Равно(3);

	Ожидаем.Что(Служба.СкачиванияПоПакетам().Получить(НовыйПакет()),
		"пакет без скачиваний в разрезе отсутствует").Равно(Неопределено);

КонецПроцедуры

// Сумма по хабу — то же число, что и разрез, сложенный по пакетам, но считается одним
// агрегатом: её спрашивают анонимный адрес метрик и приборы телеметрии, и читать ради
// одного числа всю таблицу агрегатов незачем. Сброс числа не двигает: ОжидающихВсего
// обнуляется ровно там, где буфер сливается в базу.
&Тест
Процедура СуммаПоХабуРавнаРазрезуИНеПрыгаетНаСбросе() Экспорт

	Первый = НовыйПакет();
	Второй = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999); // сброс сам не наступит
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	// таблица агрегатов общая на набор, поэтому сверяются ДЕЛЬТЫ и равенство двух дверей,
	// а не абсолютные числа: соседний тест уже мог что-то в неё написать
	Было = Служба.СкачиванийВсего();
	Ожидаем.Что(Было, "обе двери согласны и до нашей работы").Равно(СуммаРазреза(Служба));

	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Первый, 2, Момент);
	Служба.ЗафиксироватьСкачивание(Второй, 3, Момент);

	ДоСброса = Служба.СкачиванийВсего();
	Ожидаем.Что(ДоСброса, "до сброса сумма видит ожидающие в памяти").Равно(Было + 3);
	Ожидаем.Что(ДоСброса, "и равна разрезу, сложенному по пакетам").Равно(
		СуммаРазреза(Служба));

	Служба.Сбросить(Момент);

	ПослеСброса = Служба.СкачиванийВсего();
	Ожидаем.Что(ПослеСброса, "слив число не двигает: ни удвоения, ни потери").Равно(ДоСброса);
	Ожидаем.Что(ПослеСброса, "и разрез после слива говорит то же").Равно(СуммаРазреза(Служба));

	// свежее скачивание видно сразу, а не после следующего слива
	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Ожидаем.Что(Служба.СкачиванийВсего(),
		"скачивание после сброса учтено немедленно").Равно(ДоСброса + 1);
	Ожидаем.Что(Служба.СкачиванийВсего(), "и разрез с ним согласен").Равно(СуммаРазреза(Служба));

КонецПроцедуры

&Тест
Процедура СбросИдемпотентен() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999);
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Служба.Сбросить(Момент);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "после сброса в БД 1").Равно(1);

	Служба.Сбросить(Момент); // повторный сброс без новых данных не должен удвоить
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "повторный сброс идемпотентен").Равно(1);

КонецПроцедуры

&Тест
Процедура СуточнаяАгрегацияНакапливаетВОднуСтроку() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(9999, 99999);
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент + 3600); // те же сутки, +час
	Служба.Сбросить(Момент + 3600);

	Ожидаем.Что(СтрокАгрегатов(Пакет), "скачивания одних суток агрегируются в одну строку").Равно(1);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет), "сумма за сутки").Равно(2);

КонецПроцедуры

&Тест
Процедура РазныеПакетыИзолированы() Экспорт

	ПакетA = НовыйПакет();
	ПакетB = НовыйПакет();
	Служба = НоваяСлужба(1, 99999); // порог 1 — сброс на каждом скачивании
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(ПакетA, 1, Момент);

	Ожидаем.Что(ДождатьсяСуммы(ПакетA, 1), "A учтён").Равно(1);
	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(ПакетB), "B не затронут").Равно(0);

КонецПроцедуры

// Хука остановки приложения взять негде, поэтому всё, что осталось в буфере, теряется
// вместе с процессом. Порог сброса 1 — режим почти без потерь: каждое скачивание сразу
// назначает сброс, и в памяти ничего не залёживается.
&Тест
Процедура ПорогЕдиницаУкладываетКаждоеСкачиваниеСразу() Экспорт

	Сквозной = НовыйПакет();
	Служба = НоваяСлужба(1, 99999);
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Для Счёт = 1 По 3 Цикл
		Служба.ЗафиксироватьСкачивание(Сквозной, 1, Момент);
		Ожидаем.Что(ДождатьсяСуммы(Сквозной, Счёт),
			СтрШаблон("в БД всё зафиксированное вслед за скачиванием %1", Счёт)).Равно(Счёт);
	КонецЦикла;

	// та же нагрузка на буферном режиме: остановка прямо сейчас унесла бы все три
	Буферный = НовыйПакет();
	Буферная = НоваяСлужба(50, 99999);
	Для Счёт = 1 По 3 Цикл
		Буферная.ЗафиксироватьСкачивание(Буферный, 1, Момент);
	КонецЦикла;

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Буферный),
		"буферный режим держит скачивания в памяти — они и теряются при остановке").Равно(0);

КонецПроцедуры

// Так потерю видел пользователь хаба: под параллельными скачиваниями счётчик пакета
// отставал от числа отданных тел. Каждое скачивание сбрасывало буфер само, и сбросы,
// дописывавшие одну строку агрегата, затирали друг друга.
&Тест
Процедура ПараллельныеСкачиванияДоходятДоБазыВсе() Экспорт

	Пакет = НовыйПакет();
	Служба = НоваяСлужба(1, 99999); // порог 1 — сброс на каждом скачивании, давка сбросов наибольшая
	Потоков = 8;
	НаПоток = 25;

	ФоновыеЗадания.ОжидатьВсе(ПараллельныеСкачивания(Служба, Пакет, Потоков, НаПоток), 60000);
	Служба.Сбросить();

	Ожидаем.Что(ХранилищеАгрегатов().СуммаПоПакету(Пакет),
		"в базе ровно столько скачиваний, сколько зафиксировано").Равно(Потоков * НаПоток);

КонецПроцедуры

// Запись в базу стоит десятков миллисекунд, а под нагрузкой — секунд, и скачивание
// платить её не должно: вернуться оно обязано раньше, чем база ответит.
&Тест
Процедура СкачиваниеНеЖдётЗаписиВБазу() Экспорт

	Пакет = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Хранилище.ЗакрытьВорота(10000);
	Служба = НоваяСлужбаНад(Хранилище, 1, 99999);

	Служба.ЗафиксироватьСкачивание(Пакет, 1);

	Ожидаем.Что(Хранилище.Завершено(),
		"скачивание вернулось, не дожидаясь записи в базу").Равно(0);

	// сброс уже стоит у закрытых ворот — следующее скачивание не ждёт и его
	ДождатьсяНачатых(Хранилище, 1);
	Служба.ЗафиксироватьСкачивание(Пакет, 1);
	Ожидаем.Что(Хранилище.Завершено(),
		"второе скачивание вернулось, пока идёт запись первого").Равно(0);

	Хранилище.ОткрытьВорота();
	Ожидаем.Что(ДождатьсяЗаписанных(Хранилище, Пакет, 2),
		"обе записи доехали до базы фоном").Равно(2);

КонецПроцедуры

// Сброс по порогу, назначенный скачиванием, и сброс задачи планировщика в базу
// одновременно не пишут: иначе два дописывания одной строки теряют приращение.
&Тест
Процедура СбросыНеИдутВнахлёст() Экспорт

	Пакет = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Хранилище.РастянутьДописывание(5);
	Служба = НоваяСлужбаНад(Хранилище, 1, 99999);
	Потоков = 6;
	НаПоток = 20;

	Задания = ПараллельныеСкачивания(Служба, Пакет, Потоков, НаПоток);
	Для Номер = 1 По 2 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СбрасыватьПоток",
			ПараметрыПотока(Служба, 10)));
	КонецЦикла;
	ФоновыеЗадания.ОжидатьВсе(Задания, 60000);
	Служба.Сбросить();

	Ожидаем.Что(Хранилище.НаибольшеРазом(), "в базу писал один сброс за раз").Равно(1);
	Ожидаем.Что(Хранилище.СуммаПоПакету(Пакет),
		"ни одно приращение не затёрто").Равно(Потоков * НаПоток);

КонецПроцедуры

// База отказала — скачивания не зовут её снова каждое: следующий сброс по порогу
// назначается не раньше, чем истечёт интервал.
&Тест
Процедура СорвавшийсяСбросЖдётИнтервала() Экспорт

	Пакет = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Хранилище.Отказывать(0, 1);
	Служба = НоваяСлужбаНад(Хранилище, 1, 60);
	Сейчас = ТекущаяУниверсальнаяДата();

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Сейчас);
	ДождатьсяНачатых(Хранилище, 1);
	Приостановить(200); // сорвавшийся сброс вернул накопленное и снял отметку

	Для Номер = 1 По 5 Цикл
		Служба.ЗафиксироватьСкачивание(Пакет, 1, Сейчас);
	КонецЦикла;
	Приостановить(300);
	Ожидаем.Что(Хранилище.Начато(), "до конца интервала база не спрошена снова").Равно(1);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Сейчас + 120);
	Ожидаем.Что(ДождатьсяЗаписанных(Хранилище, Пакет, 7),
		"по истечении интервала уложено всё накопленное").Равно(7);

КонецПроцедуры

// Поколение таблицы меняется, когда запись уже видна. Витрина, спросившая пакет посреди
// записи, иначе запомнила бы старую сумму под новым поколением и недосчитывала бы пачку
// до следующей записи — в тишине сколь угодно долго.
&Тест
Процедура ВитринаПосредиЗаписиНеЗапоминаетСтаруюСумму() Экспорт

	Пакет = НовыйПакет();
	Момент = Дата(2026, 7, 25, 10, 0, 0);
	ХранилищеАгрегатов().Накопить(Пакет, 1, Дата(2026, 7, 25), 5);

	// хранилище смотрит на свою таблицу через табакерку: подложенный в неё репозиторий
	// даёт спросить витрину между готовой строкой и её сохранением
	Репозиторий = Новый РепозиторийАгрегатовПодНаблюдением(Поделка.НайтиЖелудь("ХранилищеСкачиванийАгрегатов"));
	Хранилище = Новый ХранилищеСкачиванийАгрегатов(Новый ТабакеркаНаблюдаемая(Репозиторий),
		Поделка.НайтиЖелудь("АгрегатыБазы"));
	Служба = НоваяСлужбаНад(Хранилище, 9999, 99999);
	Репозиторий.СмотретьПосредиЗаписи(Служба, Пакет);

	Служба.ЗафиксироватьСкачивание(Пакет, 1, Момент);
	Служба.Сбросить(Момент);

	Ожидаем.Что(Репозиторий.Увидено().Количество(), "витрину спросили посреди записи").Равно(1);
	Ожидаем.Что(Репозиторий.Увидено()[0], "посреди записи витрина видит слитую пачку").Равно(6);
	Ожидаем.Что(Служба.СкачиванийПакета(Пакет), "после записи витрина видит и новую пачку").Равно(6);

КонецПроцедуры

// Так карточка теряла скачивание: сброс уже слил счёт из памяти и пишет его в базу,
// а витрину тем временем спрашивают из потока запроса. Слитое уже не в памяти и ещё
// не в базе — витрина обязана его видеть.
&Тест
Процедура ВитринаПосредиСбросаНеТеряетСлитое() Экспорт

	Пакет = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Хранилище.Накопить(Пакет, 1, Дата(2026, 7, 25), 5);
	Служба = НоваяСлужбаНад(Хранилище, 1, 99999);
	Ожидаем.Что(Служба.СкачиванийПакета(Пакет), "до скачивания витрина видит базу").Равно(5);

	Хранилище.ЗакрытьВорота(10000);
	Служба.ЗафиксироватьСкачивание(Пакет, 1);
	ДождатьсяНачатых(Хранилище, 2); // сброс слил память и стоит у ворот записи

	Ожидаем.Что(Служба.СкачиванийПакета(Пакет), "карточка видит слитое посреди записи").Равно(6);
	Ожидаем.Что(Служба.СкачиванияПакетов(ОдинПакет(Пакет)).Получить(Пакет),
		"горстка пакетов видит слитое посреди записи").Равно(6);

	Хранилище.ОткрытьВорота();
	Ожидаем.Что(ДождатьсяЗаписанных(Хранилище, Пакет, 6), "запись доехала до базы").Равно(6);
	Ожидаем.Что(Служба.СкачиванийПакета(Пакет), "после записи пачка не удвоилась").Равно(6);

КонецПроцедуры

// Строка сброса уже в базе, а поколение таблицы и счёт в памяти ещё прежние. Витрина,
// которой в этот миг понадобилась база, прочла бы пачку и там, и в памяти — поэтому
// базу она читает только между записями сброса.
&Тест
Процедура ВитринаПосредиСбросаНеВидитУложенноеДважды() Экспорт

	Пакет = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Хранилище.Накопить(Пакет, 1, Дата(2026, 7, 25), 5);
	Хранилище.ПридержатьЗавершение(1000);
	Служба = НоваяСлужбаНад(Хранилище, 1, 99999);

	Служба.ЗафиксироватьСкачивание(Пакет, 1);
	Ожидаем.Что(ДождатьсяЗаписанных(Хранилище, Пакет, 6), "строка сброса уже в базе").Равно(6);
	Ожидаем.Что(Служба.СкачиванийПакета(Пакет), "карточка посреди записи без удвоения").Равно(6);

	Служба.ЗафиксироватьСкачивание(Пакет, 1);
	Ожидаем.Что(ДождатьсяЗаписанных(Хранилище, Пакет, 7), "вторая строка уже в базе").Равно(7);
	Ожидаем.Что(Служба.СкачиванийВсего(), "сумма хаба посреди записи без удвоения").Равно(7);

КонецПроцедуры

// Строка сброса уже в базе, а с пути ещё не снята: срез изменений, прочитавший в этот миг
// базу мимо кэша, увидел бы пачку и там, и в памяти. Базу и память он читает под замком
// сброса — между его записями.
&Тест
Процедура СкачиванияВерсийПосредиСбросаНеВидятУложенноеДважды() Экспорт

	Пакет = НовыйПакет();
	Хранилище = ХранилищеСДвумяВерсиями(Пакет);
	Служба = НоваяСлужбаНад(Хранилище, 2, 99999); // второе скачивание ставит фоновый сброс

	Служба.ЗафиксироватьСкачивание(Пакет, 1);
	Служба.ЗафиксироватьСкачивание(Пакет, 2);
	Ожидаем.Что(ДождатьсяЗаписанных(Хранилище, Пакет, 10), "обе строки сброса уже в базе").Равно(10);

	Скачивания = Служба.СкачиванияВерсийПакетов(ОдинПакет(Пакет));
	Ожидаем.Что(Скачивания.Получить(1), "первая версия посреди записи без удвоения").Равно(6);
	Ожидаем.Что(Скачивания.Получить(2), "и вторая").Равно(4);
	Ожидаем.Что(Служба.СкачиванияВерсийПакета(Пакет).Получить(2),
		"таблица версий называет то же число").Равно(4);

КонецПроцедуры

// Суммы версий из кэша прочитаны до сброса, а сброс уже снял уложенную строку с пути, но кэш
// пакета ещё не забыл: таблица версий сложила бы старую базу с памятью без этой пачки.
&Тест
Процедура СкачиванияВерсийПосредиСбросаНеТеряютУложенное() Экспорт

	Пакет = НовыйПакет();
	Хранилище = ХранилищеСДвумяВерсиями(Пакет);
	Служба = НоваяСлужбаНад(Хранилище, 2, 99999); // второе скачивание ставит фоновый сброс
	Ожидаем.Что(Служба.СкачиванияВерсийПакета(Пакет).Получить(1), "кэш сумм версий разогрет")
		.Равно(5);

	Служба.ЗафиксироватьСкачивание(Пакет, 1);
	Служба.ЗафиксироватьСкачивание(Пакет, 2);
	Ожидаем.Что(ДождатьсяЗаписанных(Хранилище, Пакет, 10), "обе строки сброса уже в базе").Равно(10);

	Скачивания = Служба.СкачиванияВерсийПакета(Пакет);
	Ожидаем.Что(Скачивания.Получить(1), "первая версия посреди записи ничего не потеряла").Равно(6);
	Ожидаем.Что(Скачивания.Получить(2), "и вторая").Равно(4);
	Ожидаем.Что(Служба.СкачиванияВерсийПакетов(ОдинПакет(Пакет)).Получить(1),
		"срез изменений называет то же число").Равно(6);

КонецПроцедуры

// База отказала посреди сброса: уложенное остаётся уложенным, неуложенное возвращается
// в память и уходит следующим сбросом — без потерь и без двойного счёта.
&Тест
Процедура СбойЗаписиНеТеряетНакопленное() Экспорт

	Первый = НовыйПакет();
	Второй = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Служба = НоваяСлужбаНад(Хранилище, 9999, 99999); // сброс только руками
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Второй, 2, Момент);

	Хранилище.Отказывать(1, 1); // первая строка ляжет, вторая сорвётся
	Сорвался = Ложь;
	Попытка
		Служба.Сбросить(Момент);
	Исключение
		Сорвался = Истина;
	КонецПопытки;

	Ожидаем.Что(Сорвался, "сбой записи виден тому, кто звал сброс").ЭтоИстина();
	Ожидаем.Что(Служба.СкачиванийПакета(Первый) + Служба.СкачиванийПакета(Второй),
		"витрина не потеряла ни одного скачивания").Равно(3);

	Служба.Сбросить(Момент);

	Ожидаем.Что(Хранилище.СуммаПоПакету(Первый), "первый пакет в базе ровно один раз").Равно(2);
	Ожидаем.Что(Хранилище.СуммаПоПакету(Второй), "второй пакет доехал следующим сбросом").Равно(1);

КонецПроцедуры

// Кэш скачиваний версий сброс забывает раз на пакет, а не на каждую его строку: строк
// у пакета за сброс столько, сколько у него скачанных версий.
&Тест
Процедура СбросЗабываетСкачиванияВерсийРазНаПакет() Экспорт

	Первый = НовыйПакет();
	Второй = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Служба = НоваяСлужбаНад(Хранилище, 9999, 99999); // сброс только руками
	Момент = Дата(2026, 7, 25, 10, 0, 0);

	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Первый, 2, Момент);
	Служба.ЗафиксироватьСкачивание(Первый, 3, Момент);
	Служба.ЗафиксироватьСкачивание(Второй, 4, Момент);
	Служба.Сбросить(Момент);

	Ожидаем.Что(Хранилище.СуммаПоПакету(Первый), "самотест: три строки пакета легли").Равно(3);
	Ожидаем.Что(Хранилище.Забыто(Первый), "три строки пакета — одно забывание его сумм версий")
		.Равно(1);
	Ожидаем.Что(Хранилище.Забыто(Второй), "и у второго пакета — своё одно").Равно(1);

КонецПроцедуры

// Сорвавшийся сброс забывает суммы версий тех пакетов, чьи строки уже легли: иначе таблица
// версий показывала бы старое число до конца срока кэша.
&Тест
Процедура СорвавшийсяСбросЗабываетУложенныеПакеты() Экспорт

	Первый = НовыйПакет();
	Второй = НовыйПакет();
	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Служба = НоваяСлужбаНад(Хранилище, 9999, 99999); // сброс только руками
	Момент = Дата(2026, 7, 25, 10, 0, 0);
	Служба.СкачиванияВерсийПакета(Первый); // кэш сумм версий обоих пакетов разогрет
	Служба.СкачиванияВерсийПакета(Второй);

	Служба.ЗафиксироватьСкачивание(Первый, 1, Момент);
	Служба.ЗафиксироватьСкачивание(Второй, 2, Момент);

	Хранилище.Отказывать(1, 1); // одна строка ляжет, следующая сорвётся
	Попытка
		Служба.Сбросить(Момент);
	Исключение
		// сбой виден вызывающему — это стережёт СбойЗаписиНеТеряетНакопленное
	КонецПопытки;

	// порядок строк в сбросе не обещан: какая из двух легла, не важно
	Ожидаем.Что(Хранилище.СуммаПоПакету(Первый) + Хранилище.СуммаПоПакету(Второй),
		"самотест: до отказа легла ровно одна строка").Равно(1);
	Ожидаем.Что(Служба.СкачиванияВерсийПакета(Первый).Получить(1),
		"скачивание первого пакета видно после срыва, где бы оно ни лежало").Равно(1);
	Ожидаем.Что(Служба.СкачиванияВерсийПакета(Второй).Получить(2),
		"и второго тоже").Равно(1);

КонецПроцедуры

// Витрины спрашивают скачивания из многих потоков разом, а сбросы тем временем меняют
// поколение таблицы агрегатов. Общий на всех разрез не имеет права ни портиться,
// ни отвечать числом, которого в базе нет.
&Тест
Процедура ВитриныИзМногихПотоковВидятБазуЦеликом() Экспорт

	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Служба = НоваяСлужбаНад(Хранилище, 9999, 99999);
	День = Дата(2026, 7, 25);
	Пакеты = Новый Массив();
	Для Номер = 1 По 30 Цикл
		Пакет = НовыйПакет();
		Хранилище.Накопить(Пакет, 1, День, Номер);
		Пакеты.Добавить(Пакет);
	КонецЦикла;

	Задания = Новый Массив();
	Жалобы = Новый Массив();
	Для Номер = 1 По 10 Цикл
		Своя = Новый Массив();
		Жалобы.Добавить(Своя);
		Параметры = ПараметрыПотока(Служба, 500);
		Параметры.Добавить(Пакеты);
		Параметры.Добавить(Своя);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СмотретьВитрину", Параметры));
	КонецЦикла;
	Параметры = ПараметрыПотока(Хранилище, 2000);
	Параметры.Добавить(НовыйПакет());
	Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "МенятьПоколение", Параметры));
	ФоновыеЗадания.ОжидатьВсе(Задания, 60000);

	Для Каждого Своя Из Жалобы Цикл
		Ожидаем.Что(СтрСоединить(Своя, "; "), "витрина ответила тем, что лежит в базе").Равно("");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СобытиеСкачиванияИнкрементитСлужбу() Экспорт

	Пакет = НовыйПакет();
	СлужбаБоевая = Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний");
	Издатель = Поделка.НайтиЖелудь("ИздательСобытий");

	Ожидаем.Что(Издатель.КоличествоПодписчиков(Издатель.ТипСкачиваниеЗафиксировано()) >= 1,
		"служба статистики подписана на скачивания").ЭтоИстина();

	Данные = Новый Структура("ПакетИдентификатор, ВерсияИдентификатор", Пакет, 7);
	Издатель.Опубликовать(Издатель.ТипСкачиваниеЗафиксировано(), Данные);

	Ожидаем.Что(СлужбаБоевая.СкачиванийПакета(Пакет), "событие увеличило счётчик службы").Равно(1);

КонецПроцедуры

&Тест
Процедура НеизвестныйТипСобытияИгнорируетсяСлужбой() Экспорт

	Пакет = НовыйПакет();
	СлужбаБоевая = Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний");
	Издатель = Поделка.НайтиЖелудь("ИздательСобытий");

	Издатель.Опубликовать("посторонний.тип", Новый Структура("ПакетИдентификатор, ВерсияИдентификатор", Пакет, 1));

	Ожидаем.Что(СлужбаБоевая.СкачиванийПакета(Пакет), "чужой тип события не учитывается статистикой").Равно(0);

КонецПроцедуры

Функция ХранилищеАгрегатов()
	Возврат Поделка.НайтиЖелудь("ХранилищеСкачиванийАгрегатов");
КонецФункции

// Свежий экземпляр службы с собственными счётчиком и издателем; репозиторий агрегатов общий (БД).
Функция НоваяСлужба(Знач Порог, Знач Интервал)
	Возврат НоваяСлужбаНад(ХранилищеАгрегатов(), Порог, Интервал);
КонецФункции

// Служба над заданным хранилищем агрегатов; сброс по порогу — настоящим фоновым заданием.
Функция НоваяСлужбаНад(Знач Хранилище, Знач Порог, Знач Интервал)
	Возврат Новый СлужбаСтатистикиСкачиваний(
		Новый СчётчикСкачиванийВПамяти(),
		Хранилище,
		Новый ИздательСобытий(),
		НастройкиСчётчиков(Интервал, Порог),
		НоваяГотовность(),
		Новый ЗапускВФонеЗаданием(),
		ЛогТестов());
КонецФункции

// В базе у версий пакета 5 и 3 скачивания; каждая следующая запись придерживается
// записанной: строка уже в базе, а сброс ещё не снял её с пути.
Функция ХранилищеСДвумяВерсиями(Знач Пакет)

	Хранилище = Новый ХранилищеСкачиванийЗаглушка();
	Хранилище.Накопить(Пакет, 1, Дата(2026, 7, 25), 5);
	Хранилище.Накопить(Пакет, 2, Дата(2026, 7, 25), 3);
	Хранилище.ПридержатьЗавершение(1000);
	Возврат Хранилище;

КонецФункции

// Сброс по порогу уходит в фоновое задание — сумма в базе появляется не сразу.
Функция ДождатьсяСуммы(Знач Пакет, Знач Ожидаемое)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Сумма = ХранилищеАгрегатов().СуммаПоПакету(Пакет);
	Пока Сумма <> Ожидаемое И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(20);
		Сумма = ХранилищеАгрегатов().СуммаПоПакету(Пакет);
	КонецЦикла;
	Возврат Сумма;

КонецФункции

Процедура ДождатьсяНачатых(Знач Хранилище, Знач Ожидаемое)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока Хранилище.Начато() < Ожидаемое И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(10);
	КонецЦикла;

КонецПроцедуры

Функция ДождатьсяЗаписанных(Знач Хранилище, Знач Пакет, Знач Ожидаемое)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока Хранилище.СуммаПоПакету(Пакет) <> Ожидаемое
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(20);
	КонецЦикла;
	Возврат Хранилище.СуммаПоПакету(Пакет);

КонецФункции

Функция ПараллельныеСкачивания(Знач Служба, Знач Пакет, Знач Потоков, Знач НаПоток)

	Задания = Новый Массив();
	Для Номер = 1 По Потоков Цикл
		Параметры = ПараметрыПотока(Служба, НаПоток);
		Параметры.Добавить(Пакет);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СкачиватьПоток", Параметры));
	КонецЦикла;
	Возврат Задания;

КонецФункции

Функция ОдинПакет(Знач Пакет)
	Пакеты = Новый Массив();
	Пакеты.Добавить(Пакет);
	Возврат Пакеты;
КонецФункции

Функция ПараметрыПотока(Знач Служба, Знач Раз)
	Параметры = Новый Массив();
	Параметры.Добавить(Служба);
	Параметры.Добавить(Раз);
	Возврат Параметры;
КонецФункции

// Тело фонового задания: поток скачиваний одной версии пакета.
//
// Параметры:
//  Служба - СлужбаСтатистикиСкачиваний.
//  Раз - Число.
//  Пакет - Число.
//
Процедура СкачиватьПоток(Знач Служба, Знач Раз, Знач Пакет) Экспорт
	Для Номер = 1 По Раз Цикл
		Служба.ЗафиксироватьСкачивание(Пакет, 1);
	КонецЦикла;
КонецПроцедуры

// Тело фонового задания: поток витрины. У пакета с номером N в базе ровно N скачиваний;
// первые расхождения и исключения складываются в Жалобы — массив только этого потока.
//
// Параметры:
//  Служба - СлужбаСтатистикиСкачиваний.
//  Раз - Число.
//  Пакеты - Массив из Число.
//  Жалобы - Массив из Строка.
//
Процедура СмотретьВитрину(Знач Служба, Знач Раз, Знач Пакеты, Знач Жалобы) Экспорт

	Для Номер = 1 По Раз Цикл
		Если Жалобы.Количество() >= 3 Тогда
			Возврат;
		КонецЕсли;
		Индекс = Номер % Пакеты.Количество();
		Попытка
			Получено = ?(Номер % 5 = 0,
				Служба.СкачиванияПоПакетам().Получить(Пакеты[Индекс]),
				Служба.СкачиванийПакета(Пакеты[Индекс]));
			Если Получено <> Индекс + 1 Тогда
				Жалобы.Добавить(СтрШаблон("пакет %1: %2 вместо %3", Индекс + 1, Получено, Индекс + 1));
			КонецЕсли;
		Исключение
			Жалобы.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Тело фонового задания: записи в чужой пакет, каждая меняет поколение таблицы.
//
// Параметры:
//  Хранилище - ХранилищеСкачиванийЗаглушка.
//  Раз - Число.
//  Пакет - Число.
//
Процедура МенятьПоколение(Знач Хранилище, Знач Раз, Знач Пакет) Экспорт
	Для Номер = 1 По Раз Цикл
		Хранилище.Накопить(Пакет, 1, Дата(2026, 7, 25), 1);
	КонецЦикла;
КонецПроцедуры

// Тело фонового задания: поток сбросов, как их зовёт задача планировщика.
//
// Параметры:
//  Служба - СлужбаСтатистикиСкачиваний.
//  Раз - Число.
//
Процедура СбрасыватьПоток(Знач Служба, Знач Раз) Экспорт
	Для Номер = 1 По Раз Цикл
		Служба.Сбросить();
		Приостановить(3);
	КонецЦикла;
КонецПроцедуры

// Синтетический идентификатор пакета: внешних ключей в таблицах статистики нет, строка
// ссылается на кого угодно. Номер обязан быть свой у каждого теста — иначе подсчёт соседа
// вычитывает чужие строки.
Функция НовыйПакет()
	Возврат УникальныеИмена.Номер();
КонецФункции

// Разрез по пакетам, сложенный в одно число: второй способ спросить то же самое.
Функция СуммаРазреза(Знач Служба)

	Итог = 0;
	Для Каждого КиЗ Из Служба.СкачиванияПоПакетам() Цикл
		Итог = Итог + КиЗ.Значение;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция СтрокАгрегатов(Знач Пакет)
	Количество = 0;
	Для Каждого Строка Из ХранилищеАгрегатов().Все() Цикл
		Если Строка.ПакетИдентификатор = Пакет Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

// Свежая ГотовностьХаба для конструкторов стартовых задач: в юнит-тестах гейт никого не держит.
Функция НоваяГотовность()

	Попытка
		КаталогНабора = Новый Файл(ТекущийСценарий().Источник).Путь;
		ПодключитьСценарий(ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогНабора, "..")).ПолноеИмя,
			"src/модули/наблюдаемость/Классы/пробы/ГотовностьХаба.os"), "ГотовностьХаба");
	Исключение
	КонецПопытки;

	Возврат Новый ГотовностьХаба(ЛогТестов());

КонецФункции

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции

// Настройки счётчиков для прямой сборки службы вне контейнера.
Функция НастройкиСчётчиков(Знач Интервал, Знач Порог)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.stats.flush_interval_sec", Интервал);
	Настройки.Задать("oshub.stats.flush_threshold", Порог);
	Возврат Настройки;
КонецФункции
