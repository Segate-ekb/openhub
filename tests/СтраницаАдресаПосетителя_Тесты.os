// Страница /whoami на настоящих хабах: посетитель видит свой адрес и страну теми, какими
// их видит гейт входа. Два стенда: первый за «доверенным прокси» (петля названа доверенной
// сетью) с базой стран и правилом «закрыт в RU», второй — без списка доверенных и без правил.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем ЗаПрокси;         // ЭкземплярХаба — петля доверена, база лежит, правило стоит
Перем БезПравил;        // ЭкземплярХаба — ни доверенных сетей, ни правил
Перем КлиентЗаПрокси;   // КлиентХаба
Перем КлиентБезПравил;  // КлиентХаба
Перем Проба;            // фикстура БазаСтранПробная
Перем Закрытый;         // провайдер стенда с правилом «закрыт в RU»
Перем КукаАдмина;       // сессия администратора стенда за прокси
Перем ПутьБазы;         // где у стенда за прокси лежит база стран

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабы() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("БазаСтранПробная");

	Проба = Новый БазаСтранПробная();

	ПутьБазы = ПодложитьБазу();
	ЗаПрокси = ПоднятьХаб("openhub-whoami-прокси", "127.0.0.0/8, ::1/128", ПутьБазы);
	КлиентЗаПрокси = Новый КлиентХаба(ЗаПрокси);

	БезПравил = ПоднятьХаб("openhub-whoami-без-правил", "", "");
	КлиентБезПравил = Новый КлиентХаба(БезПравил);

	КукаАдмина = КлиентЗаПрокси.Войти("root", "RootPassw0rd");
	Закрытый = ЗавестиПровайдера(КукаАдмина);
	ПоставитьПравило(Закрытый, "RU", КукаАдмина);
	ДождатьсяИндекса();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХабы() Экспорт
	Если БезПравил <> Неопределено Тогда
		БезПравил.Остановить();
	КонецЕсли;
	Если ЗаПрокси <> Неопределено Тогда
		ЗаПрокси.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Доступ

&Тест
Процедура СтраницаОткрываетсяБезВходаИНеОстаётсяНиВКэшеНиУПоисковиков() Экспорт

	Ответ = КлиентБезПравил.GETБезПереходов("/whoami");

	Ожидаем.Что(Ответ.КодСостояния, "аноним получает страницу, а не переход ко входу")
		.Равно(200);
	Ожидаем.Что(СтрНайти(НРег(КлиентБезПравил.ЗаголовокОтвета(Ответ, "X-Robots-Tag")),
		"noindex") > 0, "поисковикам страница закрыта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(КлиентБезПравил.ЗаголовокОтвета(Ответ, "Cache-Control")),
		"no-store") > 0, "страница у каждого своя: ни браузер, ни прокси её не хранят")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СсылкиНаСтраницуНетНиНаВходеНиНаГлавной() Экспорт

	Для Каждого Путь Из СтраницыБезСсылки() Цикл
		Тело = КлиентЗаПрокси.Тело(КлиентЗаПрокси.GET(Путь));
		Ожидаем.Что(СтрНайти(Тело, "/whoami"), "на " + Путь + " страница не упомянута")
			.Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Адрес

&Тест
Процедура ЗаДовереннымПроксиПоказанАдресЧеловекаИЕгоСтрана() Экспорт

	Страница = Страница(КлиентЗаПрокси, Проба.РоссийскийIPv4());

	Ожидаем.Что(Адрес(Страница), "адрес человека из заголовка, а не адрес прокси")
		.Равно(Проба.РоссийскийIPv4());
	Ожидаем.Что(Страна(Страница), "страна названа кодом").Равно("RU");
	Ожидаем.Что(ЕстьСправка(Страница), "справка объясняет, что делать с результатом")
		.ЭтоИстина();
	Ожидаем.Что(ЕстьАтрибуция(Страница), "страна из базы — со ссылкой DB-IP").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СНедоверенногоСоединенияЗаголовокАдресаНеПринят() Экспорт

	Страница = Страница(КлиентБезПравил, Проба.РоссийскийIPv4());

	Ожидаем.Что(ПетлевойЛи(Адрес(Страница)),
		"показан адрес соединения, а не написанный в заголовке: " + Адрес(Страница))
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Страна

&Тест
Процедура ЧужаяСтранаНазванаНеРазличаемойИПереченьРазличаемыхДан() Экспорт

	Страница = Страница(КлиентЗаПрокси, Проба.НемецкийIPv4());
	Ячейка = Страна(Страница);

	Ожидаем.Что(Адрес(Страница), "КОНТРОЛЬ: адрес тот, что прислан").Равно(Проба.НемецкийIPv4());
	Ожидаем.Что(СтрНайти(Ячейка, "не из стран, которые хаб различает") > 0,
		"сказано, что хаб эту страну не различает: " + Ячейка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ячейка, "RU") > 0, "и названо, какие различает").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ячейка, "DE"), "кода чужой страны хаб не знает и не выдумывает")
		.Равно(0);
	Ожидаем.Что(ЕстьАтрибуция(Страница), "ответ дала база — со ссылкой DB-IP").ЭтоИстина();

КонецПроцедуры

// Причина «не определена» — диагностика администратора (путь к базе, текст сбоя): посетитель
// видит только исход. Настоящую причину в той же ситуации называет окно «Страны и доступ».
&Тест
Процедура НеопределённаяСтранаНеРаскрываетПричинуОпределителя() Экспорт

	Страница = Страница(КлиентЗаПрокси);
	Причина = ПричинаОпределителя();

	Ожидаем.Что(ПетлевойЛи(Адрес(Страница)), "КОНТРОЛЬ: без заголовка виден адрес соединения")
		.ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Причина),
		"КОНТРОЛЬ: администратору определитель причину называет").ЭтоИстина();

	Ожидаем.Что(Страна(Страница), "посетителю — только исход").Равно("не определена");
	Ожидаем.Что(СтрНайти(Страница, Причина), "причины определителя на странице нет: " + Причина)
		.Равно(0);
	Ожидаем.Что(СтрНайти(Страница, ПутьБазы), "и пути к базе стран тоже").Равно(0);
	Ожидаем.Что(ЕстьСправка(Страница), "справка на месте").ЭтоИстина();
	Ожидаем.Что(ЕстьАтрибуция(Страница), "страна не из базы — атрибуции нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БезПравилСтранаНеОпределяетсяАдресПоказан() Экспорт

	Страница = Страница(КлиентБезПравил);
	Ячейка = Страна(Страница);

	Ожидаем.Что(ПетлевойЛи(Адрес(Страница)), "адрес показан и без правил").ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Ячейка, "не определяется"),
		"сказано, что страну хаб не определяет: " + Ячейка).ЭтоИстина();
	Ожидаем.Что(ЕстьСправка(Страница), "про VPN говорить незачем — страна ничего не решает")
		.ЭтоЛожь();
	Ожидаем.Что(ЕстьАтрибуция(Страница), "базой хаб не пользовался").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ТолькоЧтение

// С петли страна не определена, и гейт отбил бы закрытого провайдера — но страница гейт
// не спрашивает: отказов не считает, а журнал хаба отказом не пугает.
&Тест
Процедура СтраницаОтказовГейтаНеСчитает() Экспорт

	Для Сч = 1 По 3 Цикл
		Страница(КлиентЗаПрокси);
	КонецЦикла;

	Ожидаем.Что(СтрНайти(ЗаПрокси.Дамп(), СтрокаОтказа()),
		"страница не записала в журнал ни одного отказа").Равно(0);

	КлиентЗаПрокси.GETБезПереходов("/login/oidc/" + Закрытый);
	Ожидаем.Что(СтрНайти(ЗаПрокси.Дамп(), СтрокаОтказа()) > 0,
		"КОНТРОЛЬ: настоящий отказ гейта в журнале виден").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ПоднятьХаб(Знач Префикс, Знач ДоверенныеСети, Знач ПутьБазы)

	Хаб = Новый ЭкземплярХаба(90);

	Хаб.ФайловаяБаза(Префикс);
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_INSTANCE_TRUSTED__PROXIES", ДоверенныеСети);
	Если ЗначениеЗаполнено(ПутьБазы) Тогда
		Хаб.Среда("OSHUB_GEO_DB__PATH", ПутьБазы);
	КонецЕсли;

	Сидер = ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры");
	Хаб.ЗапуститьСидер(ОбъединитьПути(Сидер, "ЗасеятьКабинет.os"));
	Хаб.Запустить();

	Возврат Хаб;

КонецФункции

Функция ПодложитьБазу()

	Куда = ОбъединитьПути(УникальныеИмена.ВременныйКаталог("гео-whoami"),
		"dbip-country-lite.csv");
	Возврат Проба.Положить(Куда);

КонецФункции

// Правило записано сразу, а индекс под него строится в фоне: ждём, пока хаб назовёт страну.
Процедура ДождатьсяИндекса()

	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 60000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
		Если Страна(Страница(КлиентЗаПрокси, Проба.РоссийскийIPv4())) = "RU" Тогда
			Возврат;
		КонецЕсли;
		Приостановить(250);
	КонецЦикла;

	ВызватьИсключение "Индекс стран стенда не построился за минуту";

КонецПроцедуры

// Страница /whoami; адрес человека, если назван, едет в X-Forwarded-For.
Функция Страница(Знач Клиент, Знач АдресЧеловека = "")

	Заголовки = Неопределено;
	Если ЗначениеЗаполнено(АдресЧеловека) Тогда
		Заголовки = Клиент.Заголовок("X-Forwarded-For", АдресЧеловека);
	КонецЕсли;

	Ответ = Клиент.GET("/whoami", Заголовки);
	Ожидаем.Что(Ответ.КодСостояния, "страница отвечает").Равно(200);
	Возврат Клиент.Тело(Ответ);

КонецФункции

Функция Адрес(Знач HTML)
	Возврат ЗначениеСвойства(HTML, "Ваш адрес");
КонецФункции

Функция Страна(Знач HTML)
	Возврат ЗначениеСвойства(HTML, "Страна");
КонецФункции

// Текст значения в паре «имя — значение» (<dt>/<dd>) без разметки внутри.
Функция ЗначениеСвойства(Знач HTML, Знач Имя)

	Позиция = СтрНайти(HTML, "<dt>" + Имя + "</dt>");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Позиция);
	Хвост = Сред(Хвост, СтрНайти(Хвост, "<dd"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
	Хвост = Лев(Хвост, СтрНайти(Хвост, "</dd>") - 1);

	Возврат СокрЛП(БезТегов(Хвост));

КонецФункции

Функция БезТегов(Знач Текст)

	Результат = "";
	ВнутриТега = Ложь;
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Поз, 1);
		Если Символ = "<" Тогда
			ВнутриТега = Истина;
		ИначеЕсли Символ = ">" Тогда
			ВнутриТега = Ложь;
		ИначеЕсли НЕ ВнутриТега Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Каким из петлевых адресов веб-сервер назовёт клиента, решает его стек.
Функция ПетлевойЛи(Знач Адрес)
	Возврат Адрес = "127.0.0.1" ИЛИ Адрес = "::1" ИЛИ Адрес = "::ffff:127.0.0.1";
КонецФункции

// Причина, которую определитель называет для запроса самого администратора, — с того же
// адреса, что и запрос посетителя в тесте.
Функция ПричинаОпределителя()

	Окно = КлиентЗаПрокси.Тело(КлиентЗаПрокси.GETСКукой(
		"/hub/settings/providers?countries=" + Закрытый, КукаАдмина));
	Возврат КлиентЗаПрокси.ПослеМаркера(Окно, "Страна вашего запроса не определена — ",
		". Если хаб стоит за обратным прокси");

КонецФункции

Функция СтрокаОтказа()
	Возврат "закрыт правилом по стране";
КонецФункции

Функция ЕстьСправка(Знач HTML)
	Возврат СтрНайти(HTML, "раздельном туннеле") > 0;
КонецФункции

Функция ЕстьАтрибуция(Знач HTML)
	Возврат СтрНайти(HTML, "IP Geolocation by DB-IP") > 0
		И СтрНайти(HTML, "https://db-ip.com") > 0;
КонецФункции

Функция СтраницыБезСсылки()

	Результат = Новый Массив();
	Результат.Добавить("/login");
	Результат.Добавить("/");
	Возврат Результат;

КонецФункции

Функция ЗавестиПровайдера(Знач Кука)

	Имя = УникальныеИмена.Имя("whoami");
	HTML = КлиентЗаПрокси.Тело(КлиентЗаПрокси.GETСКукой("/hub/settings/providers?preset=github", Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ТокенФормы(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("пресет", "github");
	Поля.Вставить("клиент", "Iv1.abcdef");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");

	Ответ = КлиентЗаПрокси.POSTФормы("/hub/settings/providers", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"провайдер стенда заведён: " + Лев(КлиентЗаПрокси.Тело(Ответ), 300)).ЭтоИстина();
	Возврат Имя;

КонецФункции

Процедура ПоставитьПравило(Знач Имя, Знач Страны, Знач Кука)

	HTML = КлиентЗаПрокси.Тело(
		КлиентЗаПрокси.GETСКукой("/hub/settings/providers?countries=" + Имя, Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ТокенФормы(HTML));
	Поля.Вставить("страны", Страны);

	Ответ = КлиентЗаПрокси.POSTФормы("/hub/settings/providers/" + Имя + "/countries", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400, "правило стенда поставлено").ЭтоИстина();

КонецПроцедуры

// Токен формы: имя и значение в разметке стоят не вплотную, между ними атрибут типа.
Функция ТокенФормы(Знач HTML)

	Позиция = СтрНайти(HTML, "name=""_csrf""");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Позиция);
	Хвост = Сред(Хвост, СтрНайти(Хвост, "value=""") + 7);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

#КонецОбласти
