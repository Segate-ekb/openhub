&Тест
Процедура ИздательВедётПодпискиПакета() Экспорт

	// pub — publisher на пуле public: «изменение» наследуется на пакет, значит подписками ПАКЕТА он распоряжается
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Адрес = "/public/alice-pkg/settings/webhooks";

	Стр = Тело(Клиент.GETСКукой(Адрес, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Подписки на события") > 0, "раздел подписок пакета открыт").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Новая подписка") > 0, "форма создания показана").ЭтоИстина();

	Ответ = СоздатьПодписку(Адрес, "https://hook.example.com/pkg", Кука);
	Ожидаем.Что(УспехМутации(Ответ), "подписка создана").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Адрес, Кука));
	Ожидаем.Что(СтрНайти(Список, "hook.example.com/pkg") > 0, "подписка в списке").ЭтоИстина();

	// секрет в списке не раскрыт — показывается ровно один раз при создании
	Ожидаем.Что(СтрНайти(Список, "Секрет подписи скрыт") > 0, "секрет маскирован").ЭтоИстина();

КонецПроцедуры

