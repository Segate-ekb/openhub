		"экран сам говорит, что адрес не проверяется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "oshub.upstream.probe.enabled") > 0,
		"и называет настройку, которой это включают").ЭтоИстина();

	// самотест: форма создания зеркала на странице есть
	Ожидаем.Что(СтрНайти(Страница, "name=""url""") > 0, "форма создания зеркала на месте")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВитриныДомовНеПринимаютPOST() Экспорт

	// разделы без мутаций отвечают 405, а не «сохранено без действия»
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	// токен берётся из раздела с формой: у «Квоты» её нет — владелец пула квоту не правит
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/visibility", КукаOwner)));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);

	// раздел «Теги» дома ПУЛА витриной быть перестал: в нём живёт настройка «заводить
	// каналы по умолчанию автоматически». Витрина осталась в доме ПАКЕТА — опасная зона
	// показывает удаление, а принимает его свой контроллер
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	ПоляПакета = Новый Соответствие();
	ПоляПакета.Вставить("_csrf",
		ИзвлечьCSRF(Тело(Клиент.GETСКукой("/public/alice-pkg/settings/card", КукаАдмина))));
	Ожидаем.Что(Клиент.POSTФормы("/public/alice-pkg/settings/danger", ПоляПакета, КукаАдмина).КодСостояния,
		"опасная зона пакета — витрина").Равно(405);

	// опасная зона мутацию принимает (удаление пула), но право на неё — уровня ХАБА:
	// владельцу собственного пула отвечает 403, а не 405 и не 400
	Ожидаем.Что(Клиент.POSTФормы("/owned/settings/danger", Поля, КукаOwner).КодСостояния,
		"владелец пула его не удаляет: право уровня хаба").Равно(403);

КонецПроцедуры

&Тест
Процедура ЭкзотическийМетодДаётМетодНеРазрешён() Экспорт

	// winow не различает метод — его разбирает контроллер; проверяем, что разбор есть
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ответ = ВызватьМетодом("DELETE", "/hub/settings/identity", КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "экзотический метод → 405").Равно(405);
	Ожидаем.Что(ЕстьЗаголовок(Ответ, "Allow"), "405 несёт заголовок Allow").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВитринаПравГруппыГоворитРолью() Экспорт

	// витрина дома ГРУППЫ откатывалась на набор действий, и ни один тест не краснел: одна и та же выдача обязана
	// читаться одинаково на всех экранах — в этом смысл единой ТаблицыПрав
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	ЭкранПрав = "/public/settings/access";
