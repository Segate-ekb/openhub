	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти("alice", "AlicePassw0rd")), "старый пароль всё ещё действует").ЭтоИстина();
КонецПроцедуры

#Область РезервИмёнВДомеПула

// Полный круг экрана: имя занимается формой из одного поля, попадает в список, из списка
// открывается выдача прав на него, снятие проходит через серверный шаг подтверждения.
&Тест
Процедура МейнтейнерПулаЗанимаетИмяИСнимаетРезерв() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/reserved";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Имя = "round-trip-name";

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", Имя, ""),
		КукаOwner)), "имя занято").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, "<code>" + Имя + "</code>") > 0,
		"занятое имя показано в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "/owned/" + Имя + "/settings/access") > 0,
		"из списка ведёт ссылка туда, где на имя выдаются права").ЭтоИстина();

	Ожидаем.Что(Клиент.GETСКукой("/owned/" + Имя + "/settings/access", КукаOwner).КодСостояния,
		"дом плейсхолдера открыт сразу: резерв создаёт строку пакета").Равно(200);

	// первый POST снятия только СПРАШИВАЕТ: страница отдаётся вместо редиректа
	Спрос = Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", Имя, ""), КукаOwner);
	Ожидаем.Что(Спрос.КодСостояния, "шаг подтверждения — обычная страница").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Спрос), "Снять резерв имени") > 0,
		"на ней секция подтверждения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "<code>" + Имя + "</code>") > 0,
		"без подтверждения имя на месте").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", Имя, Имя), КукаOwner)),
		"подтверждённое снятие принято").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "<code>" + Имя + "</code>"),
		"имя освободилось").Равно(0);
	Ожидаем.Что(Клиент.GETСКукой("/owned/" + Имя + "/settings/access", КукаOwner).КодСостояния,
		"дом снятого плейсхолдера исчез").Равно(404);

КонецПроцедуры

// В пуле с выключенной публикацией имя занимать нечем: опубликовать в него потом никто
// не сможет (push отбивается 409). Отказ живёт в домене, экран лишь объясняет — форма
// заведения не печатается, а раздел остаётся на месте вместе со списком уже занятых имён.
&Тест
Процедура БезПубликацииРазделРезервовОбъясняетАНеПредлагаетЗанять() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/reserved";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	// контроль на включённой публикации: форма заведения есть
	СВключённой = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(СВключённой, "name=""имя""") > 0,
		"КОНТРОЛЬ: с включённой публикацией форма заведения печатается").ЭтоИстина();

	ВыключитьПубликацию(Токен, КукаOwner, Ложь);
	Попытка
		Страница = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
		Ожидаем.Что(СтрНайти(Страница, "Занять имя") > 0, "раздел остаётся на месте").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "Публикация в пул выключена") > 0,
			"экран объясняет, почему занимать нельзя").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "name=""имя"""), "формы заведения нет").Равно(0);

		Отказ_ = Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", "nopub-name", ""), КукаOwner);
		Ожидаем.Что(Отказ_.КодСостояния, "подделанная форма тоже не занимает имя").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Отказ_), "не принимает публикации") > 0,
			"причина отказа названа").ЭтоИстина();
	Исключение
		ВыключитьПубликацию(Токен, КукаOwner, Истина);
		ВызватьИсключение;
	КонецПопытки;

	ВыключитьПубликацию(Токен, КукаOwner, Истина);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "name=""имя""") > 0,
		"после возврата публикации форма заведения вернулась").ЭтоИстина();

КонецПроцедуры

Процедура ВыключитьПубликацию(Знач Токен, Знач Кука, Знач Разрешить)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "флаги");
	Поля.Вставить("публикация", ?(Разрешить, "1", "0"));
	Клиент.POSTФормы("/owned/settings/upstreams", Поля, Кука);
КонецПроцедуры

// Кнопка снятия резерва объявляет вопрос данными, но подтверждения в разметке не несёт:
// без скрипта первый POST только СПРАШИВАЕТ. Серверная сверка подтверждения — с ИМЕНЕМ,
// а не с общей константой — не ослаблена: форма одного резерва не снимает соседний.
&Тест
Процедура СнятиеРезерваСпрашиваетДаннымиИРаботаетБезJS() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/reserved";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", "ask-js", ""),
		КукаOwner)), "КОНТРОЛЬ: имя занято").ЭтоИстина();
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", "ask-js-2", ""),
		КукаOwner)), "КОНТРОЛЬ: занято и соседнее имя").ЭтоИстина();

	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onsubmit="), "и обработчиков отправки тоже").Равно(0);

	Ожидаем.Что(СтрНайти(БезСкриптов, "data-confirm-field=""подтверждение""") > 0,
		"форма называет поле подтверждения данными").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "data-confirm-value=""ask-js""") > 0,
		"значением подтверждения служит само имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "Снять резерв имени «ask-js»?") > 0,
		"вопрос называет имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "name=""подтверждение"""),
		"САМОГО подтверждения в списке нет — иначе клик снимал бы резерв молча").Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, "type=""submit""") > 0,
		"снятие — обычная кнопка отправки формы").ЭтоИстина();

	// без скрипта: первый POST спрашивает, имя на месте
	Спрос = Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", "ask-js", ""), КукаOwner);
	Ожидаем.Что(Спрос.КодСостояния, "шаг подтверждения — обычная страница").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "<code>ask-js</code>") > 0,
		"без подтверждения имя не снято").ЭтоИстина();

	// подтверждение ЧУЖИМ именем снятия не даёт: сверка на сервере, а не в диалоге
	Чужое = Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", "ask-js", "ask-js-2"), КукаOwner);
	Ожидаем.Что(Чужое.КодСостояния,
		"чужое подтверждение не снимает, а снова спрашивает").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "<code>ask-js</code>") > 0,
		"и имя по-прежнему занято").ЭтоИстина();

	// со скриптом: он добавляет то же поле сам — снятие одним запросом
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", "ask-js", "ask-js"),
		КукаOwner)), "с подтверждением снятие проходит").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "<code>ask-js</code>"),
		"имя освободилось").Равно(0);

	Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", "ask-js-2", "ask-js-2"), КукаOwner);

КонецПроцедуры

// Порог держит сам СервисРезервированияИмён; райтеру пула экран недоступен целиком —
// ни на чтение, ни на мутацию.
&Тест
Процедура РайтерПулаНеЗанимаетИмя() Экспорт

	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	Раздел = "/public/settings/reserved";

	Ожидаем.Что(Клиент.GETСКукой(Раздел, КукаPub).КодСостояния,
		"райтер пула в раздел резервов не входит").Равно(403);

	Поля = ПоляРезерва("", "зарезервировать", "steal-name", "");
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, КукаPub).КодСостояния,
		"и мутацию раздела не выполняет").Равно(403);

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)), "<code>steal-name</code>"),
		"КОНТРОЛЬ: имя не занято ничем").Равно(0);

КонецПроцедуры

// Валидатор имени — тот же, что на публикации: своей копии правил экран не заводит.
&Тест
Процедура ЗанятоеИСистемноеИмяОтбиваютсяСВнятнымТекстом() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/reserved";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Имя = "dup-name";

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", Имя, ""),
		КукаOwner)), "первое занятие прошло").ЭтоИстина();

	Дубль = Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", Имя, ""), КукаOwner);
	Ожидаем.Что(Дубль.КодСостояния, "повтор того же имени — 400, а не молчаливый успех").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Дубль), "уже занято") > 0, "и объяснён").ЭтоИстина();

	Системное = Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", "settings", ""), КукаOwner);
	Ожидаем.Что(Системное.КодСостояния, "системное имя — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Системное), "системный адрес") > 0, "и объяснено").ЭтоИстина();

	Кривое = Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", "-плохое имя!", ""), КукаOwner);
	Ожидаем.Что(Кривое.КодСостояния, "недопустимое имя — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Кривое), "Недопустимое имя пакета") > 0, "и объяснено").ЭтоИстина();

	// уборка: снимаем занятое имя, чтобы набор не зависел от порядка тестов
	Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", Имя, Имя), КукаOwner);

КонецПроцедуры

// Инвариант СнятыйРезервНеОставляетПравНаИмя, пройденный ЭКРАНОМ: роль, выданная на
// плейсхолдер, обязана исчезнуть вместе с ним, иначе следующий держатель имени её унаследует.
&Тест
Процедура СнятиеРезерваЭкраномУноситПраваНаИмя() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/reserved";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Имя = "handover-name";
	ПраваИмени = "/owned/" + Имя + "/settings/access";

	Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", Имя, ""), КукаOwner);

	ТокенПрав = ИзвлечьCSRF(Тело(Клиент.GETСКукой(ПраваИмени, КукаOwner)));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(ПраваИмени,
			ПоляРоли(ТокенПрав, "выдать", "bob", "мейнтейнер"), КукаOwner)),
		"роль на занятое имя выдана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(ПраваИмени, КукаOwner)),
			"<td>пользователь</td><td>bob</td><td>мейнтейнер</td>") > 0,
		"и отражена в списке").ЭтоИстина();

	Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", Имя, Имя), КукаOwner);

	// имя занимает КТО-ТО ДРУГОЙ: bob не должен получить его вместе с прежней ролью
	Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "зарезервировать", Имя, ""), КукаOwner);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(ПраваИмени, КукаOwner)), "<td>bob</td>"),
		"прежняя роль на имя не пережила снятие резерва").Равно(0);

	Клиент.POSTФормы(Раздел, ПоляРезерва(Токен, "снять", Имя, Имя), КукаOwner);

КонецПроцедуры

Функция ПоляРезерва(Знач Токен, Знач Операция, Знач Имя, Знач Подтверждение)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("имя", Имя);
	Если ЗначениеЗаполнено(Подтверждение) Тогда
		Поля.Вставить("подтверждение", Подтверждение);
	КонецЕсли;
	Возврат Поля;
КонецФункции

Функция ПоляРоли(Знач Токен, Знач Операция, Знач Субъект, Знач Роль)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("тип_субъекта", "пользователь");
	Поля.Вставить("субъект", Субъект);
	Если ЗначениеЗаполнено(Роль) Тогда
		Поля.Вставить("роль", Роль);
	КонецЕсли;
	Возврат Поля;
КонецФункции

#КонецОбласти

#Область ДовереннаяПубликацияВДомеПакета

// Полный круг экрана: конвейер заводится формой, попадает в список вместе с автором,
// снятие проходит через серверный шаг подтверждения, а подтверждение сверяется
// с идентификатором записи.
&Тест
Процедура МейнтейнерПакетаЗаводитИСнимаетДоверенныйКонвейер() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/round-trip", "", "refs/heads/main"),
			КукаOwner)), "конвейер добавлен").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, ">acme/round-trip<") > 0,
		"репозиторий показан в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">refs/heads/main<") > 0,
		"и реф вместе с ним").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "owner1") > 0,
		"видно, кто завёл запись").ЭтоИстина();

	Ид = ИдентификаторДоверия(Список, "acme/round-trip");
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "идентификатор записи найден в разметке").ЭтоИстина();

	// первый POST только СПРАШИВАЕТ: страница отдаётся вместо редиректа
	Спрос = Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, Ид, ""), КукаOwner);
	Ожидаем.Что(Спрос.КодСостояния, "шаг подтверждения — обычная страница").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Спрос), "Отозвать доверие конвейеру") > 0,
		"на ней секция подтверждения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">acme/round-trip<") > 0,
		"без подтверждения запись на месте").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, Ид, Ид), КукаOwner)),
		"подтверждённый отзыв принят").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">acme/round-trip<"),
		"запись исчезла").Равно(0);

КонецПроцедуры

// Запрос собирается ИЗ ВЫДАННОЙ РАЗМЕТКИ: имена полей и значения берутся у самой формы
// (значение поля, иначе его плейсхолдер; у выбора — помеченный вариант), ни одно имя
// в тесте не названо. Форма, которая печатает поля не под теми именами, что читает пульт,
// оставит издателя и репозиторий пустыми — домен такую запись не создаёт, и тест краснеет.
// Здесь же проверяется, что подсказки формы дают РАБОТАЮЩУЮ запись, а не просто принятую.
&Тест
Процедура ЗапросИзВыданнойФормыЗаводитДоверие() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();

	Поля = ПоляИзФормыЗаведения(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Ожидаем.Что(Поля.Количество() > 4,
		"форма заведения напечатала поля: " + Поля.Количество()).ЭтоИстина();

	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(УспехМутации(Ответ),
		"собранный из разметки запрос принят: " + Ответ.КодСостояния).ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, ">acme/lib<") > 0,
		"репозиторий из плейсхолдера формы доехал до записи").ЭтоИстина();
	// издателя форма не спрашивает; выведенный из типа репозитория список не показывает
	// вовсе — уточнение появляется только у инсталляции из настройки хаба
	Ожидаем.Что(СтрНайти(Список, ">издатель "), "издатель выведен из типа репозитория").Равно(0);
	// короткие значения формы доехали до канонических клеймов
	Ожидаем.Что(ЕстьКонвейерAPI(КукаOwner, "acme/lib/.github/workflows/e2e.yml"),
		"имя файла достроено до значения клейма вместе с репозиторием").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">e2e.yml<") > 0,
		"а на экране стоит короткое имя").ЭтоИстина();

	// РАЗЛАД, из-за которого первый же релиз получал отказ: форма предлагала «develop»
	// веткой, а готовый конвейер этой же страницы запускается по тегам. Запись, собранная
	// из НАПЕЧАТАННЫХ подсказок, обязана лечь в пространство имён тегов
	Ожидаем.Что(СтрНайти(Список, ">refs/tags/" + Поля.Получить("реф") + "<") > 0,
		"предложенный формой реф достроен ТЕГОМ: " + Поля.Получить("реф")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">refs/heads/" + Поля.Получить("реф") + "<"),
		"а не веткой — она не совпала бы ни с одним запуском").Равно(0);

	СнятьДоверие(Раздел, КукаOwner, "acme/lib");

КонецПроцедуры

// Набор полей задаёт ТИП репозитория, а переключается он ссылкой: JS в проекте нет.
// У GitHub каталог workflow один, поэтому имя файла спрашивается прямо; у GitLab путь
// к конфигу задаётся настройкой проекта и почти всегда дефолтный — поле уезжает
// в «дополнительно» с готовым .gitlab-ci.yml.
&Тест
Процедура НаборПолейЗависитОтТипаРепозитория() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();

	ВкладкаGitHub = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	ВкладкаGitLab = Тело(Клиент.GETСКукой(Раздел + "?ci=gitlab", КукаOwner));

	Ожидаем.Что(СтрНайти(ВкладкаGitHub, Раздел + "?ci=gitlab") > 0,
		"переключатель типа — обычная ссылка").ЭтоИстина();

	Ожидаем.Что(ПолеВДополнительном(ВкладкаGitHub, "конвейер"),
		"у GitHub имя файла спрашивается прямо в форме").ЭтоЛожь();
	Ожидаем.Что(ПолеВДополнительном(ВкладкаGitLab, "конвейер"),
		"у GitLab путь к конфигу спрятан в «дополнительно»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВкладкаGitLab, "value="".gitlab-ci.yml""") > 0,
		"и предзаполнен дефолтом GitLab").ЭтоИстина();

	// издателя форма не спрашивает ни на одной вкладке: он выводится из типа
	Ожидаем.Что(ПолеВДополнительном(ВкладкаGitHub, "издатель"),
		"издатель у GitHub — в «дополнительно»").ЭтоИстина();
	Ожидаем.Что(ПолеВДополнительном(ВкладкаGitLab, "издатель"),
		"и у GitLab тоже").ЭтоИстина();

КонецПроцедуры

// Форма GitLab-вкладки, отправленная КАК НАПЕЧАТАНА: она печатает свой набор полей
// и свой дефолт пути конфига, и запись обязана получиться канонической для GitLab.
&Тест
Процедура ФормаGitLabИзВыданнойРазметкиЗаводитДоверие() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Разметка = Тело(Клиент.GETСКукой(Раздел + "?ci=gitlab", КукаOwner));

	Поля = ПоляИзФормыЗаведения(Разметка);
	Поля.Вставить("репозиторий", "acme/team/lib");
	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(УспехМутации(Ответ),
		"форма GitLab как напечатана принята: " + Ответ.КодСостояния).ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	// на экране стоит короткий путь внутри проекта, каноническое значение с хостом
	// и разделителем «//» — в машинном представлении записи
	Ожидаем.Что(ЕстьКонвейерAPI(КукаOwner, "gitlab.com/acme/team/lib//.gitlab-ci.yml"),
		"путь конфига собран с хостом издателя и разделителем «//»").ЭтоИстина();
	// форма предлагает маску тегов релиза, и за маской одного файла нет — но сам проект
	// на своей инсталляции открывается
	Ожидаем.Что(СтрНайти(Список, "href=""https://gitlab.com/acme/team/lib""") > 0,
		"а ссылка ведёт в веб-интерфейс инсталляции").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">refs/tags/" + Поля.Получить("реф") + "<") > 0,
		"реф записи — тег, как и запускается готовый конвейер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">издатель "),
		"издатель выведен из типа репозитория и на экране не повторяется").Равно(0);

	СнятьДоверие(Раздел, КукаOwner, "acme/team/lib");

КонецПроцедуры

// Разбор ссылки — ПЕРВЫЙ ШАГ формы заведения, а не отдельная карточка: одна <form>, две
// submit-кнопки с разными name/value. Проверяем ровно это, потому что вся развилка операции
// держится на них: скрытого поля «операция» в форме больше нет.
&Тест
Процедура РазборИЗаведениеЖивутВОднойФорме() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Страница = Тело(Клиент.GETСКукой(РазделДоверия(), КукаOwner));
	Форма = ФормаПоМаркеру(Страница, "value=""доверить""");

	Ожидаем.Что(СтрНайти(Форма, "name=""ссылка""") > 0,
		"поле ссылки живёт внутри формы заведения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "value=""разобрать""") > 0,
		"и кнопка разбора вместе с ним").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "name=""операция"" value=""разобрать"" hidden"),
		"операция едет КНОПКОЙ, а не скрытым полем").Равно(0);
	Ожидаем.Что(СтрНайти(Форма, "type=""hidden"" name=""операция"""),
		"скрытого поля операции в форме нет вовсе").Равно(0);

	// отдельной карточки «Заполнить по ссылке» больше нет: разбор не самостоятельное действие
	Ожидаем.Что(СколькоРаз(Страница, "name=""ссылка"""),
		"поле ссылки на странице одно").Равно(1);

	// кнопка разбора НЕ спотыкается о required: обязательные поля она как раз и заполняет
	Разбор = КнопкаПоЗначению(Форма, "разобрать");
	Ожидаем.Что(СтрНайти(Разбор, "formnovalidate") > 0,
		"кнопка разбора отправляет форму мимо валидации браузера").ЭтоИстина();

	// ENTER в поле ссылки = первая submit-кнопка формы. Она обязана быть разбором:
	// молча заведённое доверие — самый неприятный из возможных исходов
	Ожидаем.Что(СтрНайти(Форма, "value=""разобрать""") < СтрНайти(Форма, "value=""доверить"""),
		"кнопка разбора стоит ПЕРВОЙ в дереве формы").ЭтоИстина();

КонецПроцедуры

// Кнопка разбора, нажатая как в браузере (со своим name/value), заполняет форму
// и записи НЕ создаёт — даже когда все обязательные поля формы напечатаны.
&Тест
Процедура КнопкаРазбораЗаполняетФормуИНеСоздаётЗапись() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();

	Поля = ПоляИзФормыЗаведения(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "разобрать");
	Поля.Вставить("ссылка",
		"https://github.com/vanessa-opensource/vanessa-runner/blob/develop/.github/workflows/e2e.yml");

	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "разбор возвращает страницу, а не редирект").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "value=""vanessa-opensource/vanessa-runner""") > 0,
		"форма заполнена разобранным").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, "vanessa-opensource"),
		"записи при этом НЕ создано, хотя репозиторий и реф в форме были").Равно(0);
	// плейсхолдер репозитория той же формы тоже не завёлся записью
	Ожидаем.Что(СтрНайти(Список, ">acme/lib<"), "и по плейсхолдеру тоже").Равно(0);

	// КОНТРОЛЬ: та же форма ДРУГОЙ кнопкой запись создаёт
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляИзФормыЗаведения(Тело(Ответ), "доверить"), КукаOwner)),
		"КОНТРОЛЬ: кнопка «доверить» той же формы запись создаёт").ЭтоИстина();
	СнятьДоверие(Раздел, КукаOwner, "vanessa-opensource/vanessa-runner");

КонецПроцедуры

// Enter в поле ссылки на пустой форме — самый частый промах, и он обязан вести в разбор
// с понятным объяснением, а не заводить доверие и не говорить «ссылка не разобрана».
&Тест
Процедура ФормаБезОперацииИПустаяСсылкаОбъясняются() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = ПоляИзФормыЗаведения(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "разобрать");
	Поля.Вставить("ссылка", "");
	Пустая = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(Пустая.КодСостояния, "пустая ссылка — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Пустая), "Ссылка не введена") > 0,
		"и сказано именно это, а не «не разобрана»").ЭтоИстина();

	// форма без операции вовсе (обход мимо кнопок) — отказ, а не тихое заведение
	БезОперации = ПоляДоверия(Токен, "github", "", "acme/no-op", "release.yml", "main");
	БезОперации.Удалить("операция");
	Ответ = Клиент.POSTФормы(Раздел, БезОперации, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "форма без операции — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Неизвестная операция") > 0, "и названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">acme/no-op<"),
		"записи не появилось").Равно(0);

КонецПроцедуры

// Заведение открывается окном поверх экрана: пока не нажали кнопку, форма места
// не занимает. Дорога к ней есть и серверная — тот же адрес с form=1, — потому что
// кнопку команды старый движок не сработает. Отбитая форма приезжает в ТО ЖЕ окно.
&Тест
Процедура ФормаЗаведенияЖивётВОкнеИВозвращаетсяВНегоЖе() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();

	Закрытая = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Закрытая, "<dialog class=""modal""") > 0,
		"форма заведения — модальное окно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, "command=""show-modal""") > 0,
		"и открывает её кнопка командой движка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, " open>"), "по умолчанию окно закрыто").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(ОкноИзРазметки(Закрытая)), "<script"),
		"в самом окне скрипта нет: открывает и закрывает его движок").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(ОкноИзРазметки(Закрытая)), "onclick"),
		"и обработчика в атрибуте тоже").Равно(0);

	// серверная дорога: адрес открывает окно сам
	Открытая = Тело(Клиент.GETСКукой(Раздел + "?form=1", КукаOwner));
	Ожидаем.Что(СтрНайти(Открытая, " open>") > 0, "адрес с form=1 открывает окно").ЭтоИстина();

	// отбитая форма возвращается в то же окно — открытым, с набранным и помеченным полем
	Токен = ИзвлечьCSRF(Закрытая);
	Отбитая = Тело(Клиент.POSTФормы(Раздел,
		ПоляДоверия(Токен, "github", "", "", "release.yml", "main"), КукаOwner));
	Ожидаем.Что(СтрНайти(Отбитая, " open>") > 0, "окно вернулось открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "aria-invalid=""true""") > 0, "поле помечено отбитым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""release.yml""") > 0,
		"а набранное в соседних полях не съедено").ЭтоИстина();

КонецПроцедуры

// Иконку кнопки называет форма: «Доверить конвейеру» — действие, а не сохранение,
// и дискета на нём читается неверно. Соседняя секция настроек дискету сохраняет.
&Тест
Процедура КнопкаСекцииДоверияНесётКлючАНеДискету() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Доверие_ = ФормаПоМаркеру(Тело(Клиент.GETСКукой(РазделДоверия(), КукаOwner)), "value=""доверить""");
	Соседняя = Тело(Клиент.GETСКукой("/secret/secret-pkg/settings", КукаOwner));

	Ключ = КонтурИконки("ключ");
	Дискета = КонтурИконки("сохранить");

	Ожидаем.Что(СтрНайти(Доверие_, Ключ) > 0, "кнопка формы несёт «ключ»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПодвалОкна(Доверие_), Дискета),
		"дискеты на кнопке действия нет").Равно(0);
	Ожидаем.Что(СтрНайти(Соседняя, Дискета) > 0,
		"КОНТРОЛЬ: секция сохранения дискету по-прежнему печатает").ЭтоИстина();

КонецПроцедуры

// Вставка ссылки заполняет форму и НЕ создаёт записи: человек проверяет глазами.
&Тест
Процедура ВставкаСсылкиЗаполняетФормуНоНеСоздаётЗапись() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "разобрать");
	Поля.Вставить("ссылка",
		"https://github.com/vanessa-opensource/vanessa-runner/blob/develop/.github/workflows/e2e.yml");

	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "разбор возвращает страницу, а не редирект").Равно(200);

	Заполненная = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Заполненная, "value=""vanessa-opensource/vanessa-runner""") > 0,
		"репозиторий выведен из ссылки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заполненная, "value=""e2e.yml""") > 0,
		"имя файла выведено из ссылки, каталог .github/workflows отброшен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заполненная, "value=""develop""") > 0,
		"ветка выведена из ссылки").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "vanessa-opensource"),
		"запись при этом НЕ создана").Равно(0);

	// заполненную форму отправляем КАК НАПЕЧАТАНА — запись создаётся уже ею
	ИзРазметки = ПоляИзФормыЗаведения(Заполненная);
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ИзРазметки, КукаOwner)),
		"заполненная разбором форма создаёт запись").ЭтоИстина();
	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(ЕстьКонвейерAPI(КукаOwner,
			"vanessa-opensource/vanessa-runner/.github/workflows/e2e.yml"),
		"и в записи каноническое значение клейма").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список,
			"vanessa-opensource/vanessa-runner/blob/develop/.github/workflows/e2e.yml") > 0,
		"а ссылка ведёт на этот файл").ЭтоИстина();

	СнятьДоверие(Раздел, КукаOwner, "vanessa-opensource/vanessa-runner");

КонецПроцедуры

// Ссылка на self-hosted инсталляцию из списка хаба: издателем записи обязан стать ЕЁ хост,
// а не публичный gitlab.com — иначе доверие уедет на чужой репозиторий с тем же именем.
&Тест
Процедура СсылкаНаSelfHostedНесётСвоегоИздателя() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "разобрать");
	Поля.Вставить("ссылка", "https://git.example.test/team/self-hosted/-/blob/main/.gitlab-ci.yml");

	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "ссылка известной инсталляции разобрана").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "value=""https://git.example.test"" selected") > 0,
		"издатель ссылки выбран в форме, а не потерян").ЭтоИстина();

	// заполненную форму отправляем как напечатана: издатель обязан доехать до записи
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляИзФормыЗаведения(Тело(Ответ)), КукаOwner)),
		"запись создана").ЭтоИстина();
	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	// издатель ЭТОЙ записи из типа репозитория не выводится, поэтому список называет его
	// прямо: иначе она стала бы неотличима от записи публичного gitlab.com
	Ожидаем.Что(СтрНайти(Список, "издатель https://git.example.test") > 0,
		"издателем записи стал хост ссылки").ЭтоИстина();
	Ожидаем.Что(ЕстьКонвейерAPI(КукаOwner, "git.example.test/team/self-hosted//.gitlab-ci.yml"),
		"и путь конфига собран с ним же").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "https://git.example.test/team/self-hosted/-/blob/") > 0,
		"а ссылка ведёт на его инсталляцию, а не на публичный gitlab.com").ЭтоИстина();

	СнятьДоверие(Раздел, КукаOwner, "team/self-hosted");

КонецПроцедуры

// ЭКСПЛОЙТ: ссылка на инсталляцию, издателя которой хаб не знает. Догадка «раз не gitlab,
// значит github.com» перенацелила бы доверие на ПУБЛИЧНЫЙ github.com с тем же именем.
&Тест
Процедура СсылкаНаЧужуюИнсталляциюНеЗаполняетФорму() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "разобрать");
	Поля.Вставить("ссылка",
		"https://github.acme.corp/team/lib/blob/main/.github/workflows/release.yml");

	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "ссылка чужой инсталляции — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "value=""team/lib"""),
		"репозиторий в форму не подставлен").Равно(0);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "team/lib"),
		"и записи не появилось").Равно(0);

КонецПроцедуры

&Тест
Процедура МусорВместоСсылкиОбъясненИНичегоНеЗаполняет() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "разобрать");
	Поля.Вставить("ссылка", "не ссылка вовсе");

	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "мусор — 400, а не заполненная форма").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Ссылка не разобрана") > 0, "и объяснено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "value=""не ссылка вовсе"""),
		"мусор в поля формы не попал").Равно(0);

КонецПроцедуры

// Тег — законное значение клейма ref и типовой сценарий релиза, поэтому вид рефа
// выбирается явно: из ссылки ветку от тега не отличить.
&Тест
Процедура ВидРефаСтроитТегАНеВетку() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = ПоляДоверия(Токен, "github", "", "acme/tagged", "release.yml", "v1.2.3");
	Поля.Вставить("вид_рефа", "тег");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаOwner)), "запись создана").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, ">refs/tags/v1.2.3<") > 0,
		"короткое имя достроено ТЕГОМ").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">refs/heads/v1.2.3<"),
		"а не веткой").Равно(0);

	СнятьДоверие(Раздел, КукаOwner, "acme/tagged");

КонецПроцедуры

// Пустой реф означал бы публикацию с ЛЮБОЙ ветки — экран такую запись не заводит.
// Обязательность держит СЕРВИС: атрибут required формы обходится одним curl.
&Тест
Процедура ПустойРефЭкраномНеЗаводится() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Пустой = Клиент.POSTФормы(Раздел,
		ПоляДоверия(Токен, "github", "", "acme/anyref", "release.yml", ""), КукаOwner);
	Ожидаем.Что(Пустой.КодСостояния, "форма без рефа — 400").Равно(400);
	// отказ приходит НА ПОЛЕ: помеченный ввод и объяснение рядом с ним, а не один баннер
	// над формой. Причину пустого рефа («любая ветка») по-прежнему называет сервис —
	// её стережёт ДоверенныеКонвейерыCI_Тесты.ПустойРефЗаписьНеСоздаёт
	Ожидаем.Что(СтрНайти(Тело(Пустой), "aria-describedby=""реф-err""") > 0,
		"поле рефа помечено отбитым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Пустой), "id=""реф-err"">Заполните это поле<") > 0,
		"и объяснено у самого поля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Пустой), "value=""acme/anyref""") > 0,
		"а набранное вернулось в форму").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">acme/anyref<"),
		"записи не появилось").Равно(0);

	// само поле формы тоже объявлено обязательным: без скрипта это единственная защита
	// от отправки пустого значения по неосторожности
	Форма = ФормаПоМаркеру(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "value=""доверить""");
	Ожидаем.Что(СтрНайти(Форма, "name=""реф"" required") > 0,
		"поле рефа объявлено обязательным").ЭтоИстина();

	// КОНТРОЛЬ: та же форма с веткой запись создаёт
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", "", "acme/anyref", "release.yml", "main"), КукаOwner)),
		"КОНТРОЛЬ: с веткой запись создаётся").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">refs/heads/main<") > 0,
		"и ветка достроена до значения клейма").ЭтоИстина();

	СнятьДоверие(Раздел, КукаOwner, "acme/anyref");

КонецПроцедуры

// Маска рефа доезжает до записи целиком: «v*» тегом — это refs/tags/v*, а «**» остаётся
// «всем» и помечается в списке как «любая ветка».
&Тест
Процедура МаскаРефаЗаводитсяИШирокаяПомечаетсяВСписке() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = ПоляДоверия(Токен, "github", "", "acme/masked", "release.yml", "v*");
	Поля.Вставить("вид_рефа", "тег");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаOwner)), "маска тега принята").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", "", "acme/everything", "release.yml", "**"), КукаOwner)),
		"«всё» тоже принято: оно пишется осознанно").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, ">refs/tags/v*<") > 0,
		"маска достроена ТЕГОМ").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">refs/heads/v*<"), "а не веткой").Равно(0);
	Ожидаем.Что(СтрНайти(Список, ">**<") > 0,
		"«всё» приставкой не сужено").ЭтоИстина();

	// широкая маска помечена, узкая — нет: иначе плашка ничего не значила бы
	Ожидаем.Что(СколькоРаз(Список, "tag--warn"), "помечена ровно одна запись").Равно(1);
	Ожидаем.Что(СтрНайти(ЯчейкаРефа(Список, "acme/everything"), "tag--warn") > 0,
		"и это запись с «**»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЯчейкаРефа(Список, "acme/masked"), "tag--warn"),
		"маску с именем плашка не трогает").Равно(0);

	СнятьДоверие(Раздел, КукаOwner, "acme/masked");
	СнятьДоверие(Раздел, КукаOwner, "acme/everything");

КонецПроцедуры

// Порог раздела ВЫШЕ порога дома: райтер пула пакетом распоряжается, а доверенные
// конвейеры настраивают мейнтейнеры и выше. Контроля два: тот же адрес админом (меняется
// только роль смотрящего) и соседний раздел тем же райтером (меняется только раздел).
&Тест
Процедура РайтерПулаДоверенныеКонвейерыНеНастраивает() Экспорт

	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	Раздел = "/public/alice-pkg/settings/ci";

	Ожидаем.Что(Клиент.GETСКукой(Раздел, КукаPub).КодСостояния,
		"райтер пула в раздел доверия не входит").Равно(403);
	Ожидаем.Что(Клиент.GETСКукой("/public/alice-pkg/settings/webhooks", КукаPub).КодСостояния,
		"КОНТРОЛЬ: соседний раздел того же дома ему открыт").Равно(200);

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой(Раздел, КукаАдмина).КодСостояния,
		"КОНТРОЛЬ: тот же адрес админу отдаётся").Равно(200);

	// CSRF берём с соседнего раздела ЕГО ЖЕ сессии: чужой токен отбился бы сам,
	// и гейт ПОРОГА остался бы непроверенным
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/public/alice-pkg/settings/webhooks", КукаPub)));
	Ожидаем.Что(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", ИздательGitHubТест(), "steal/repo", "", "main"),
			КукаPub).КодСостояния,
		"и мутацию раздела он не выполняет").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)), ">steal/repo<"),
		"КОНТРОЛЬ: запись не создана").Равно(0);

КонецПроцедуры

// Отзыв собирается ИЗ ВЫДАННОЙ РАЗМЕТКИ на обоих шагах: сначала отправляется форма строки
// как она напечатана (без подтверждения — сервер обязан СПРОСИТЬ), потом форма секции
// подтверждения, тоже как напечатана. Ни одного имени поля тест не называет: переименуй
// поле или операцию в витрине — и кнопка «Отозвать» умрёт вместе с этим тестом.
&Тест
Процедура ОтзывСобранныйИзВыданнойРазметкиСнимаетДоверие() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Репозиторий = "acme/revoke-form";

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", ИздательGitHubТест(), Репозиторий, "", "main"), КукаOwner)),
		"КОНТРОЛЬ: запись заведена").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	ПоляСтроки = ПоляИзФормы(ФормаПослеМаркера(Список, ">" + Репозиторий + "<"));
	Ожидаем.Что(ПоляСтроки.Количество() > 2,
		"форма строки напечатала поля: " + ПоляСтроки.Количество()).ЭтоИстина();

	Спрос = Клиент.POSTФормы(Раздел, ПоляСтроки, КукаOwner);
	Ожидаем.Что(Спрос.КодСостояния,
		"форма строки как напечатана — сервер спрашивает, а не снимает").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">" + Репозиторий + "<") > 0,
		"без подтверждения запись на месте").ЭтоИстина();

	ПоляПодтверждения = ПоляИзФормы(
		ФормаПослеМаркера(Тело(Спрос), "Отозвать доверие конвейеру"));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляПодтверждения, КукаOwner)),
		"форма подтверждения как напечатана — отзыв принят").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">" + Репозиторий + "<"),
		"запись снята").Равно(0);

КонецПроцедуры

// Форма раздела выдаёт право публиковать пакет: без CSRF её принимала бы чужая страница.
&Тест
Процедура МутацияДоверияБезCSRFОтбивается() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();

	Поля = ПоляДоверия("", "github", ИздательGitHubТест(), "csrf/attack", "", "main");
	Поля.Удалить("_csrf");
	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "форма без CSRF-токена — 403").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">csrf/attack<"),
		"запись не создана").Равно(0);

	Чужой = ПоляДоверия("подделанный-токен", "github", ИздательGitHubТест(), "csrf/attack", "", "main");
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Чужой, КукаOwner).КодСостояния,
		"подделанный токен — тот же 403").Равно(403);

	// КОНТРОЛЬ: те же поля с настоящим токеном страницы принимаются
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", ИздательGitHubТест(), "csrf/attack", "", "main"), КукаOwner)),
		"КОНТРОЛЬ: с токеном страницы запись создаётся").ЭтоИстина();
	СнятьДоверие(Раздел, КукаOwner, "csrf/attack");

КонецПроцедуры

// Экран обещает то же, что API: запись СОСЕДНЕГО пакета по идентификатору не снимается,
// и отличить её от несуществующей нельзя. Оба пакета — свои, разница только в адресе.
&Тест
Процедура ДовериеСоседнегоПакетаЭкраномНеСнимается() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Сосед = ЗанятьИмяВOwned("ci-neighbor");
	РазделСоседа = "/owned/" + Сосед + "/settings/ci";
	Раздел = РазделДоверия();

	ТокенСоседа = ИзвлечьCSRF(Тело(Клиент.GETСКукой(РазделСоседа, КукаOwner)));
	Клиент.POSTФормы(РазделСоседа,
		ПоляДоверия(ТокенСоседа, "github", ИздательGitHubТест(), "neighbor/repo", "", "main"), КукаOwner);
	ИдСоседа = ИдентификаторДоверия(Тело(Клиент.GETСКукой(РазделСоседа, КукаOwner)), "neighbor/repo");
	Ожидаем.Что(ЗначениеЗаполнено(ИдСоседа), "запись соседнего пакета заведена").ЭтоИстина();

	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Клиент.POSTФормы(Раздел, ПоляДоверия(Токен, "github", ИздательGitHubТест(), "own/repo", "", "main"), КукаOwner);
	ИдСвой = ИдентификаторДоверия(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "own/repo");

	Атака = Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, ИдСоседа, ИдСоседа), КукаOwner);
	Ожидаем.Что(Атака.КодСостояния,
		"запись соседнего пакета по идентификатору — 404, а не отказ по правам").Равно(404);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(РазделСоседа, КукаOwner)), ">neighbor/repo<") > 0,
		"доверие соседнего пакета цело").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, ИдСвой, ИдСвой), КукаOwner)),
		"КОНТРОЛЬ: свою запись тот же экран снимает").ЭтоИстина();

	СнятьДоверие(РазделСоседа, КукаOwner, "neighbor/repo");
	ОсвободитьИмяВOwned(Сосед);

КонецПроцедуры

// Значения записи приходят от пользователя и печатаются в таблице: домен их не валидирует
// (только НРег и обрезка), поэтому снятое экранирование — готовый XSS.
&Тест
Процедура ЗначенияДоверияЭкранируютсяВРазметке() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	// носитель спецсимволов — РЕПОЗИТОРИЙ: издателя домен теперь судит закрытым списком
	// (по его адресу хаб сам идёт за ключами), а репозиторий по-прежнему приходит как есть
	Опасный = "acme/<b>&""d""";

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", ИздательGitHubТест(), Опасный, "", "main"), КукаOwner)),
		"значение со спецсимволами принято доменом").ЭтоИстина();

	Стр = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Стр, "acme/") > 0, "запись в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "&lt;b&gt;") > 0, "угловые скобки экранированы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "acme/<b>"), "сырой тег в разметку не попал").Равно(0);

	СнятьДоверие(Раздел, КукаOwner, "acme/&lt;b&gt;&amp;&quot;d&quot;");

КонецПроцедуры

// Идентификатор читается строго: «5.7» не должно молча превращаться в запись 5.
&Тест
Процедура ДробныйИдентификаторОтзываОтбивается() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Клиент.POSTФормы(Раздел, ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/strict", "", "main"), КукаOwner);
	Ид = ИдентификаторДоверия(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "acme/strict");

	Дробный = Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, Ид + ".7", Ид + ".7"), КукаOwner);
	Ожидаем.Что(Дробный.КодСостояния, "дробный идентификатор — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">acme/strict<") > 0,
		"запись не тронута").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, Ид, Ид), КукаOwner)),
		"КОНТРОЛЬ: целый идентификатор снимает").ЭтоИстина();

КонецПроцедуры

// Белый список операций: неизвестная операция не должна попадать в чужую ветку.
&Тест
Процедура НеизвестнаяОперацияРазделаДоверияОтбивается() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/unknown-op", "", "main");
	Поля.Вставить("операция", "выдать-всё");
	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаOwner);

	Ожидаем.Что(Ответ.КодСостояния, "неизвестная операция — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Неизвестная операция") > 0, "и названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">acme/unknown-op<"),
		"запись не создана").Равно(0);

КонецПроцедуры

// Порог раздела выше домового, поэтому пункт меню, ведущий в 403, был бы тупиком.
&Тест
Процедура ПунктМенюДоверияВиденТолькоТемКомуРазделОтвечает() Экспорт

	Раздел = "/public/alice-pkg/settings/webhooks";

	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаPub)), "/public/alice-pkg/settings/ci"),
		"райтеру пункт «Доверенная публикация» не показывается").Равно(0);

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)), "/public/alice-pkg/settings/ci") > 0,
		"КОНТРОЛЬ: тому, кому раздел отвечает, пункт виден").ЭтоИстина();

КонецПроцедуры

// Посторонний пул ВИДИТ (он публичный), но дом пакета ему закрыт целиком: этот отказ
// держит ГвардПакета, а не порог раздела — он же закрывает и соседние разделы.
&Тест
Процедура ПостороннийДоверенныеКонвейерыНеВидит() Экспорт

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	Раздел = "/public/alice-pkg/settings/ci";

	Ожидаем.Что(Клиент.GETСКукой("/public/alice-pkg", КукаBob).КодСостояния,
		"публичный пакет посторонний видит").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой(Раздел, КукаBob).КодСостояния,
		"а раздел доверия — 403").Равно(403);

	Ожидаем.Что(Клиент.GETСКукой(Раздел, Клиент.Войти("root", "RootPassw0rd")).КодСостояния,
		"КОНТРОЛЬ: тот же адрес админу отдаётся").Равно(200);

КонецПроцедуры

// Раздел чужого ПРИВАТНОГО пула отвечает так же, как несуществующий: иначе разница
// раскрывает существование пула и пакета.
&Тест
Процедура ДовериеЧужогоПриватногоПулаСкрыто404() Экспорт

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой(РазделДоверия(), КукаBob).КодСостояния,
		"чужой приватный пул — 404, а не 403").Равно(404);
	Ожидаем.Что(Клиент.GETСКукой("/нет-такого-пула/nopkg/settings/ci", КукаBob).КодСостояния,
		"несуществующий пул — тот же 404").Равно(404);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.GETСКукой(РазделДоверия(), КукаOwner).КодСостояния,
		"КОНТРОЛЬ: тот же адрес владельцу пула отдаётся").Равно(200);

КонецПроцедуры

&Тест
Процедура АнонимВРазделДоверияНеВходит() Экспорт

	Ожидаем.Что(НеДоступноАнониму(Клиент.GET(РазделДоверия()), "Доверенные конвейеры"),
		"аноним раздела доверия не видит").ЭтоИстина();

КонецПроцедуры

// Default-closed: запись без издателя или без репозитория означала бы «публиковать вправе
// любой конвейер любого репозитория», и экран её не заводит.
&Тест
Процедура ДовериеБезИздателяИлиРепозиторияЭкраномНеЗаводится() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	// издатель формой не спрашивается: пустой выводится из типа репозитория
	БезИздателя = Клиент.POSTФормы(Раздел,
		ПоляДоверия(Токен, "github", "", "acme/no-issuer", "", "main"), КукаOwner);
	Ожидаем.Что(УспехМутации(БезИздателя), "без издателя запись создаётся").ЭтоИстина();
	СписокБезИздателя = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(СписокБезИздателя, ">acme/no-issuer<") > 0,
		"запись в списке").ЭтоИстина();
	// выведенный из типа репозитория издатель на экране не повторяется, а ссылка ведёт
	// на github.com — то есть подставился именно издатель GitHub Actions
	Ожидаем.Что(СтрНайти(СписокБезИздателя, ">издатель "),
		"уточнения об издателе нет").Равно(0);
	Ожидаем.Что(СтрНайти(СписокБезИздателя, "https://github.com/acme/no-issuer") > 0,
		"и издатель выведен из типа репозитория").ЭтоИстина();
	СнятьДоверие(Раздел, КукаOwner, "acme/no-issuer");

	БезРепозитория = Клиент.POSTФормы(Раздел,
		ПоляДоверия(Токен, "github", ИздательGitHubТест(), "", "", "main"), КукаOwner);
	Ожидаем.Что(БезРепозитория.КодСостояния, "без репозитория — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(БезРепозитория), "обязательны") > 0, "и объяснено").ЭтоИстина();

	ЧужойПровайдер = Клиент.POSTФормы(Раздел,
		ПоляДоверия(Токен, "bitbucket", ИздательGitHubТест(), "acme/foreign", "", "main"), КукаOwner);
	Ожидаем.Что(ЧужойПровайдер.КодСостояния, "провайдер вне списка — 400").Равно(400);

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, "acme/foreign"), "запись с чужим провайдером не создана").Равно(0);

	// КОНТРОЛЬ: та же форма с полным набором полей запись создаёт
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/complete", "", "main"),
			КукаOwner)), "КОНТРОЛЬ: полная запись заводится").ЭтоИстина();
	СнятьДоверие(Раздел, КукаOwner, "acme/complete");

КонецПроцедуры

// Повтор той же записи идемпотентен: ретрай формы не размножает доверие.
&Тест
Процедура ПовторЗаведенияДоверияИдемпотентен() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Поля = ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/twice", "", "refs/heads/main");

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаOwner)), "первое заведение").ЭтоИстина();
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаOwner)), "повтор принят").ЭтоИстина();

	Ожидаем.Что(СколькоРаз(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), ">acme/twice<"),
		"строка в списке одна").Равно(1);

	СнятьДоверие(Раздел, КукаOwner, "acme/twice");

КонецПроцедуры

// Подтверждение сверяется с идентификатором ИМЕННО ЭТОЙ записи: форма одной строки
// не решает судьбу соседней.
&Тест
Процедура ПодтверждениеЧужимИдентификаторомНеСнимает() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Клиент.POSTФормы(Раздел, ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/first", "", "main"), КукаOwner);
	Клиент.POSTФормы(Раздел, ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/second", "", "main"), КукаOwner);

	Список = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Первая = ИдентификаторДоверия(Список, "acme/first");
	Вторая = ИдентификаторДоверия(Список, "acme/second");
	Ожидаем.Что(ЗначениеЗаполнено(Первая) И ЗначениеЗаполнено(Вторая) И Первая <> Вторая,
		"в списке две разные записи").ЭтоИстина();

	Чужое = Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, Первая, Вторая), КукаOwner);
	Ожидаем.Что(Чужое.КодСостояния,
		"чужое подтверждение не снимает, а снова спрашивает").Равно(200);
	ПослеАтаки = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(ПослеАтаки, ">acme/first<") > 0, "первая на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеАтаки, ">acme/second<") > 0, "и вторая тоже").ЭтоИстина();

	// КОНТРОЛЬ: со своим идентификатором снимается ровно одна запись
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, Первая, Первая), КукаOwner)),
		"КОНТРОЛЬ: своё подтверждение снимает").ЭтоИстина();
	Итог = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Итог, ">acme/first<"), "первая снята").Равно(0);
	Ожидаем.Что(СтрНайти(Итог, ">acme/second<") > 0, "соседняя цела").ЭтоИстина();

	СнятьДоверие(Раздел, КукаOwner, "acme/second");

КонецПроцедуры

// Сниппет конвейера обязан ссылаться на НАСТОЯЩИЙ адрес инсталляции: захардкоженный
// localhost:3333 не заработает ни у одного конвейера, кроме запущенного на самом сервере.
// Без разрешения id-token: write GitHub Actions токен не выдаёт вовсе.
&Тест
Процедура СниппетНесётАдресХабаИРазрешениеIdToken() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Узел = "localhost:" + Формат(Порт, "ЧГ=0; ЧН=0");

	// пока хаб не знает своей аудитории, доверенные конвейеры не публикуют вовсе —
	// и сниппета быть не должно: он всё равно получил бы отказ по aud
	БезАудитории = Тело(Клиент.GETСКукой(РазделДоверия(), КукаOwner));
	Ожидаем.Что(СтрНайти(БезАудитории, "permissions:"),
		"без аудитории сниппета нет").Равно(0);
	Ожидаем.Что(СтрНайти(БезАудитории, "не знает, для кого") > 0,
		"вместо него объяснение").ЭтоИстина();

	ЗадатьАудиториюХаба("openhub-стенд");
	Попытка

		Страница = Тело(Клиент.GETСКукой(РазделДоверия(), КукаOwner));

		Ожидаем.Что(СтрНайти(Страница, "permissions:") > 0,
			"сниппет GitHub объявляет разрешения").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "id-token: write") > 0,
			"и среди них разрешение на выдачу id-token").ЭтоИстина();
		// audience — то, что хаб СВЕРЯЕТ, а не его адрес: с заданной настройкой они разные,
		// и напечатанный адрес дал бы конвейер с гарантированным отказом
		Ожидаем.Что(СтрНайти(Страница, "audience: openhub-стенд") > 0,
			"audience — аудитория этого хаба").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "audience: http://" + Узел),
			"а не его адрес").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, "id_tokens:") > 0,
			"у GitLab свой способ заказать токен").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "aud: openhub-стенд") > 0,
			"и та же аудитория в его aud").ЭтоИстина();
		// адрес хаба при этом на месте: по нему идёт сам push
		Ожидаем.Что(СтрНайти(Страница, "hub: http://" + Узел) > 0,
			"адрес этого хаба, а не выдуманный").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "pool: secret") > 0, "пул назван").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "package: secret-pkg") > 0, "и пакет тоже").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "localhost:3333"),
			"захардкоженного адреса разработчика в сниппете нет").Равно(0);

	Исключение
		ЗадатьАудиториюХаба("");
		ВызватьИсключение;
	КонецПопытки;
	ЗадатьАудиториюХаба("");

КонецПроцедуры

// Слишком широкая маска — публикация с ЛЮБОЙ ветки доверенного репозитория, то есть
// готовая атака через форк или ветку с изменённым workflow. Форма обязана сказать это
// до заведения и объяснить сам язык масок: писать его человеку, а не хабу.
&Тест
Процедура ПолеРефаНесётПредупреждениеОШирокойМаске() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Форма = ФормаПоМаркеру(Тело(Клиент.GETСКукой(РазделДоверия(), КукаOwner)), "value=""доверить""");

	Ожидаем.Что(СтрНайти(Форма, "name=""реф""") > 0, "поле рефа в форме есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "с ЛЮБОЙ ветки доверенного репозитория") > 0,
		"широкая маска объяснена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "форк") > 0, "названа и сама атака").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "toast--warn") > 0,
		"и сказано это предупреждением, а не строкой подсказки").ЭтоИстина();

	// синтаксис маски объяснён примерами — иначе поле обязательно, а чем его заполнить
	// вместо прежней пустоты, человеку неоткуда узнать
	Ожидаем.Что(СтрНайти(Форма, "v*") > 0, "пример маски тега").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "release/*") > 0, "пример маски веток").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "кроме") > 0,
		"и сказано, что «*» не переходит через «/»").ЭтоИстина();

КонецПроцедуры

// Кнопка отзыва объявляет вопрос ДАННЫМИ, но самого подтверждения в разметку не кладёт:
// без скрипта первый POST только спрашивает, а сверку делает сервер.
&Тест
Процедура ОтзывДоверияСпрашиваетДаннымиИРаботаетБезJS() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = РазделДоверия();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Клиент.POSTФормы(Раздел, ПоляДоверия(Токен, "github", ИздательGitHubТест(), "acme/no-js", "", "main"), КукаOwner);

	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Ид = ИдентификаторДоверия(БезСкриптов, "acme/no-js");

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, "data-confirm-field=""подтверждение""") > 0,
		"форма называет поле подтверждения данными").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "data-confirm-value=""" + Ид + """") > 0,
		"значением подтверждения служит идентификатор записи").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "name=""подтверждение"""),
		"САМОГО подтверждения в списке нет — иначе клик снимал бы доверие молча").Равно(0);

	СнятьДоверие(Раздел, КукаOwner, "acme/no-js");

КонецПроцедуры

Функция РазделДоверия()
	Возврат "/secret/secret-pkg/settings/ci";
КонецФункции

// Канонические значения конвейеров, записанные хабом. Спрашиваются у МАШИННОГО
// представления: на экране запись названа коротким именем, и недостающий префикс
// репозитория витрина подставила бы из самой записи — по разметке достройка неотличима
// от её отсутствия.
Функция КонвейерыДоверияAPI(Знач Кука)

	Ответ = Клиент.GETСКукой("/api/v1/pools/secret/packages/secret-pkg/trusted-workflows", Кука);
	Ожидаем.Что(Ответ.КодСостояния, "список доверия по API отдан").Равно(200);

	// тело читается напрямую: ритм полей проверяют у РАЗМЕТКИ, а здесь JSON
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Разбор = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Результат = Новый Массив();
	Для Каждого Элемент Из Разбор["items"] Цикл
		Результат.Добавить(Строка(Элемент["workflow"]));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Есть ли среди записей пакета конвейер ровно с таким каноническим значением.
Функция ЕстьКонвейерAPI(Знач Кука, Знач Каноническое)
	Возврат КонвейерыДоверияAPI(Кука).Найти(Каноническое) <> Неопределено;
КонецФункции

Функция ИздательGitHubТест()
	Возврат "https://token.actions.githubusercontent.com";
КонецФункции

Функция ПоляДоверия(Знач Токен, Знач Провайдер, Знач Издатель, Знач Репозиторий,
	Знач Конвейер, Знач Реф)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "доверить");
	Поля.Вставить("провайдер", Провайдер);
	Поля.Вставить("издатель", Издатель);
	Поля.Вставить("репозиторий", Репозиторий);
	Поля.Вставить("конвейер", Конвейер);
	Поля.Вставить("реф", Реф);
	Возврат Поля;

КонецФункции

// Лежит ли поле внутри раскрывашки «Дополнительно»: она идёт последней в форме, поэтому
// достаточно сравнить позиции.
// Сначала УТВЕРЖДАЕМ наличие поля, потом судим о позиции: без первой проверки «поля нет
// вовсе» и «поле в дополнительном» неотличимы, и сторож зеленел бы на пропаже поля.
Функция ПолеВДополнительном(Знач Разметка, Знач ИмяПоля)

	Поле = СтрНайти(Разметка, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Поле > 0, СтрШаблон("поле «%1» в разметке есть", ИмяПоля)).ЭтоИстина();

	Раскрывашка = СтрНайти(Разметка, "<details class=""panel""");
	Возврат Раскрывашка > 0 И Поле > Раскрывашка;

КонецФункции

Функция ПоляОтзыва(Знач Токен, Знач Идентификатор, Знач Подтверждение)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "отозвать");
	Поля.Вставить("доверие", Идентификатор);
	Если ЗначениеЗаполнено(Подтверждение) Тогда
		Поля.Вставить("подтверждение", Подтверждение);
	КонецЕсли;
	Возврат Поля;

КонецФункции

// Аудитория хаба правится там же, где её видит администратор: раздел «хранилище»
// дома настроек — туда витрина кладёт ключи oshub.publish.*.
Процедура ЗадатьАудиториюХаба(Знач Значение)

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Поля = Новый Соответствие();
	// ключ живёт в разделе «Доверенная публикация», а не в «Хранилище» — раздел сменился
	// вместе с перегруппировкой настроек, и запись в прежний адрес молча ничего не меняла
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой("/hub/settings/trusted", КукаАдмина))));
	Поля.Вставить("oshub.publish.ci.audience", Значение);
	Клиент.POSTФормы("/hub/settings/trusted", Поля, КукаАдмина);

КонецПроцедуры

// Идентификатор записи берётся из её собственной формы отзыва: строку находим по
// репозиторию, а из неё — значение скрытого поля «доверие».
Функция ИдентификаторДоверия(Знач Разметка, Знач Репозиторий)

	Поз = СтрНайти(Разметка, ">" + Репозиторий + "<");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Клиент.ПослеМаркера(Сред(Разметка, Поз), "name=""доверие"" value=""", """");

КонецФункции

// Второй свой пакет для проверок «чужая запись»: имя занимается тем же экраном резервов,
// которым его занимает мейнтейнер пула.
Функция ЗанятьИмяВOwned(Знач Имя)

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Резервы = "/owned/settings/reserved";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Резервы, КукаOwner)));
	Клиент.POSTФормы(Резервы, ПоляРезерва(Токен, "зарезервировать", Имя, ""), КукаOwner);
	Возврат Имя;

КонецФункции

Процедура ОсвободитьИмяВOwned(Знач Имя)

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Резервы = "/owned/settings/reserved";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Резервы, КукаOwner)));
	Клиент.POSTФормы(Резервы, ПоляРезерва(Токен, "снять", Имя, Имя), КукаOwner);

КонецПроцедуры

Процедура СнятьДоверие(Знач Раздел, Знач Кука, Знач Репозиторий)

	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, Кука)));
	Ид = ИдентификаторДоверия(Тело(Клиент.GETСКукой(Раздел, Кука)), Репозиторий);
	Если ЗначениеЗаполнено(Ид) Тогда
		Клиент.POSTФормы(Раздел, ПоляОтзыва(Токен, Ид, Ид), Кука);
	КонецЕсли;

КонецПроцедуры

// Поля формы ЗАВЕДЕНИЯ, собранные из её собственной разметки; ЗначениеКнопки называет,
// какую из её submit-кнопок нажали («доверить» либо «разобрать»).
Функция ПоляИзФормыЗаведения(Знач Разметка, Знач ЗначениеКнопки = "доверить")
	Возврат ПоляИзФормы(ФормаПоМаркеру(Разметка, "value=""доверить"""), ЗначениеКнопки);
КонецФункции

// Поля формы, собранные из её собственной разметки: имя берётся у поля, значение —
// напечатанное, а если его нет, то плейсхолдер (у select — первый вариант). Ни одного имени
// поля тест не называет: их источник — только выданный HTML.
// Нажатая submit-кнопка едет вместе с полями — ровно так её шлёт браузер, и форма с двумя
// кнопками различает их ТОЛЬКО этим. Харнесс, кнопку не посылающий, проверял бы не то,
// что делает человек.
Функция ПоляИзФормы(Знач Форма, Знач ЗначениеКнопки = "")

	Результат = Новый Соответствие();

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл

		Ярлык = НРег(Кусок);
		Если НЕ СтрНачинаетсяС(Ярлык, "input") И НЕ СтрНачинаетсяС(Ярлык, "select") Тогда
			Продолжить;
		КонецЕсли;

		Имя = АтрибутТега(Кусок, "name");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Ярлык, "select") Тогда
			Результат.Вставить(Имя, ВыбранныйВариантПоля(Форма, Имя));
			Продолжить;
		КонецЕсли;

		Значение = АтрибутТега(Кусок, "value");
		Результат.Вставить(Имя, ?(ПустаяСтрока(Значение), АтрибутТега(Кусок, "placeholder"), Значение));

	КонецЦикла;

	Если ЗначениеЗаполнено(ЗначениеКнопки) Тогда
		ДобавитьНажатуюКнопку(Результат, Форма, ЗначениеКнопки);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Браузер отправляет name/value ТОЛЬКО той кнопки, которой нажали.
Процедура ДобавитьНажатуюКнопку(Поля, Знач Форма, Знач ЗначениеКнопки)

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл
		Если НЕ СтрНачинаетсяС(НРег(Кусок), "button") Тогда
			Продолжить;
		КонецЕсли;
		Имя = АтрибутТега(Кусок, "name");
		Если ЗначениеЗаполнено(Имя) И АтрибутТега(Кусок, "value") = ЗначениеКнопки Тогда
			Поля.Вставить(Имя, ЗначениеКнопки);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В форме нет submit-кнопки со значением " + ЗначениеКнопки;

КонецПроцедуры

Функция ФормаПоМаркеру(Знач Разметка, Знач Маркер)

	Поз = СтрНайти(Разметка, Маркер);
	Если Поз = 0 Тогда
		ВызватьИсключение "В разметке нет формы с маркером " + Маркер;
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Поз);
	Ищем = СтрНайти(Хвост, "<form");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<form");
	КонецЦикла;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</form>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец));

КонецФункции

// Что отправит БРАУЗЕР за этот <select>: значение ВЫБРАННОГО варианта, а при отсутствии
// у него атрибута value — его собственный текст (так велит спецификация HTML). Харнесс,
// берущий первый попавшийся value=, шлёт не то, что шлёт браузер, и «тест из выданной
// разметки» становится вакуумным.
Функция ВыбранныйВариантПоля(Знач Форма, Знач ИмяПоля)

	Поз = СтрНайти(Форма, "name=""" + ИмяПоля + """");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Форма, Поз);
	Конец = СтрНайти(Остаток, "</select>");
	Селектор = ?(Конец = 0, Остаток, Лев(Остаток, Конец));

	Варианты = Новый Массив();
	Для Каждого Кусок Из СтрРазделить(Селектор, "<") Цикл
		Если СтрНачинаетсяС(НРег(Кусок), "option") Тогда
			Варианты.Добавить(Кусок);
		КонецЕсли;
	КонецЦикла;
	Если Варианты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Выбранный = Варианты[0];
	Для Каждого Вариант Из Варианты Цикл
		Если СтрНайти(Вариант, " selected") > 0 Тогда
			Выбранный = Вариант;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрНайти(Выбранный, "value=""") = 0 Тогда
		// <option> без value отправляет СВОЙ ТЕКСТ
		Конец_ = СтрНайти(Выбранный, ">");
		Возврат ?(Конец_ = 0, "", СокрЛП(Сред(Выбранный, Конец_ + 1)));
	КонецЕсли;
	Возврат АтрибутТега(Выбранный, "value");

КонецФункции

// Первая форма ПОСЛЕ маркера — так берут форму строки таблицы (маркер — ячейка строки)
// и форму секции (маркер — её заголовок).
Функция ФормаПослеМаркера(Знач Разметка, Знач Маркер)

	Поз = СтрНайти(Разметка, Маркер);
	Если Поз = 0 Тогда
		ВызватьИсключение "В разметке нет маркера " + Маркер;
	КонецЕсли;

	Остаток = Сред(Разметка, Поз);
	Начало = СтрНайти(Остаток, "<form");
	Если Начало = 0 Тогда
		ВызватьИсключение "После маркера " + Маркер + " формы нет";
	КонецЕсли;

	Форма = Сред(Остаток, Начало);
	Конец = СтрНайти(Форма, "</form>");
	Возврат ?(Конец = 0, Форма, Лев(Форма, Конец));

КонецФункции

Функция АтрибутТега(Знач Тег, Знач Имя)
	Возврат Клиент.ПослеМаркера(Тег, Имя + "=""", """");
КонецФункции

// Разметка одной submit-кнопки формы, найденной по её value.
Функция КнопкаПоЗначению(Знач Форма, Знач Значение)

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл
		Если СтрНачинаетсяС(НРег(Кусок), "button") И АтрибутТега(Кусок, "value") = Значение Тогда
			Возврат Кусок;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В форме нет кнопки со значением " + Значение;

КонецФункции

// Модальное окно целиком: от <dialog> до его закрытия.
Функция ОкноИзРазметки(Знач Разметка)

	Поз = СтрНайти(Разметка, "<dialog");
	Если Поз = 0 Тогда
		ВызватьИсключение "В разметке нет модального окна";
	КонецЕсли;

	Хвост = Сред(Разметка, Поз);
	Конец = СтрНайти(Хвост, "</dialog>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

// Подвал модального окна: всё после последнего поля — там живут «Отмена» и кнопка действия.
Функция ПодвалОкна(Знач Форма)

	Поз = СтрНайти(Форма, "class=""modal__actions""");
	Если Поз = 0 Тогда
		ВызватьИсключение "В форме окна нет подвала с кнопками";
	КонецЕсли;
	Возврат Сред(Форма, Поз);

КонецФункции

// Хвост строки таблицы после её репозитория и до формы отзыва: в нём ячейки конвейера,
// рефа и автора. Плашка широкой маски печатается только в ячейке рефа.
Функция ЯчейкаРефа(Знач Разметка, Знач Репозиторий)

	Поз = СтрНайти(Разметка, ">" + Репозиторий + "<");
	Если Поз = 0 Тогда
		ВызватьИсключение "В списке нет записи " + Репозиторий;
	КонецЕсли;

	Хвост = Сред(Разметка, Поз);
	Конец = СтрНайти(Хвост, "<form");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

// Контур иконки берётся из ЕЁ ФАЙЛА, а не литералом: иначе тест сторожил бы копию.
// Глифы уехали с китом, поэтому файл ищется в установленной библиотеке.
Функция КонтурИконки(Знач Имя)

	Путь = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "oscript_modules", "oscript-ui", "src"),
		"статика", "иконки", Имя + ".svg");
	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение "В каталоге глифов нет " + Имя;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Контур = Клиент.ПослеМаркера(Текст, "<path d=""", """");
	Если НЕ ЗначениеЗаполнено(Контур) Тогда
		ВызватьИсключение "В глифе " + Имя + " нет контура";
	КонецЕсли;
	Возврат Контур;

КонецФункции

#КонецОбласти

#Область ОднаВкладкаПравВместоДвух

// Раздел мейнтейнеров убран целиком: адрес перестал существовать, а не стал витриной.
&Тест
Процедура РазделаМейнтейнеровБольшеНет() Экспорт

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/public/alice-pkg/settings/maintainers", КукаАлисы).КодСостояния,
		"удалённый раздел — 404").Равно(404);

	Дом = Тело(Клиент.GETСКукой("/public/alice-pkg/settings/access", КукаАлисы));
	Ожидаем.Что(СтрНайти(Дом, "settings/maintainers"),
		"в дереве разделов дома битой ссылки не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(Дом, ">Мейнтейнеры<"), "и подписи раздела тоже").Равно(0);

КонецПроцедуры

// Смысл убранного раздела переехал в «Права доступа» текстом: без него распорядитель
// пакета, которого нет в списке ролей, выглядит взявшимся ниоткуда.
&Тест
Процедура УнаследованныйДоступПоказанИНеРедактируется() Экспорт

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Раздел = Тело(Клиент.GETСКукой("/public/alice-pkg/settings/access", КукаАлисы));

	Ожидаем.Что(СтрНайти(Раздел, "Унаследованный доступ") > 0,
		"секция унаследованного доступа на вкладке прав").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "райтер пула и выше") > 0,
		"правило наследования названо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "администратор хаба") > 0,
		"и суперправо админа хаба тоже").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "/public/settings/access") > 0,
		"из секции ведёт ссылка туда, где выдаются роли на весь пул").ЭтоИстина();

	// секция справочная: наследование объясняется, но не правится — ни формы, ни поля,
	// ни кнопки внутри неё быть не должно
	Хвост = Сред(Раздел, СтрНайти(Раздел, "Унаследованный доступ"));
	Блок = Лев(Хвост, СтрНайти(Хвост, "</section>"));
	Ожидаем.Что(СтрНайти(Блок, "<form"), "унаследованный доступ не оборачивается в форму").Равно(0);
	Ожидаем.Что(СтрНайти(Блок, "<input"), "полей ввода в нём нет").Равно(0);
	Ожидаем.Что(СтрНайти(Блок, "<button"), "кнопок в нём нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Инфраструктура

Процедура ЗапуститьСидер(Знач Сидер)
	П = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), КаталогПроекта, Истина);
	П.Запустить();
	П.ОжидатьЗавершения();
	Если П.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер завершился с кодом %1: %2", П.КодВозврата, П.ПолучитьВыводПотокаОшибок());
	КонецЕсли;
КонецПроцедуры

// Окружение БД/хранилища, ожидание готовности и очистка — в фикстуре ЭкземплярХаба.

#КонецОбласти

#Область HTTPПомощники

// Старый адрес обязан отвечать НАСТОЯЩИМ редиректом на новый — не 404 и не 200.
// Переезд раздела — 301: адрес слитого раздела не вернётся, и браузеру это сказано навсегда.
Процедура ПроверитьПереезд(Знач Старый, Знач Назначение, Знач Кука = "")
	Ответ = БезПереходов(Старый, Кука);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("%1 переехал насовсем", Старый)).Равно(301);
	Ожидаем.Что(Локейшн1С(Ответ), СтрШаблон("%1 ведёт на %2", Старый, Назначение)).Равно(Назначение);
КонецПроцедуры

Процедура ПроверитьРедирект(Знач Старый, Знач Назначение, Знач Кука = "")
	Ответ = БезПереходов(Старый, Кука);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("%1 отвечает редиректом", Старый)).Равно(302);
	Ожидаем.Что(Локейшн1С(Ответ), СтрШаблон("%1 ведёт на %2", Старый, Назначение)).Равно(Назначение);
КонецПроцедуры

// Запрос БЕЗ следования редиректам (1connector): выключаем именно РазрешитьПеренаправление — при нулевом лимите
// переходов коннектор бросает «СлишкомМногоПеренаправлений» вместо ответа.
Функция БезПереходов(Знач Путь, Знач Кука = "")
	Сессия = Новый Сессия();
	Если ЗначениеЗаполнено(Кука) Тогда
		Сессия.Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	КонецЕсли;
	Параметры = Новый Структура("РазрешитьПеренаправление", Ложь);
	Возврат Сессия.ВызватьМетод("GET", СтрШаблон("http://localhost:%1%2", Формат(Порт, "ЧГ=0"), Путь),
		Параметры);
КонецФункции

// Значение Location из ответа 1connector (имя заголовка регистронезависимо).
Функция Локейшн1С(Знач Ответ)
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "LOCATION" Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Есть ли в ответе заголовок с таким именем (регистр не значим).
Функция ЕстьЗаголовок(Знач Ответ, Знач Имя)
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ВРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция Редирект(Знач Ответ)
	Возврат Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400;
КонецФункции

// Код ответа регистрации через POST /api/v1/users (JSON).
Функция РегистрацияКод(Знач Логин, Знач Пароль)
	Тело_ = СтрШаблон("{""логин"":""%1"",""email"":"""",""пароль"":""%2""}", Логин, Пароль);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/api/v1/users", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос).КодСостояния;
КонецФункции

// Страница глазами браузера с выключенным JS: содержимое <script> вырезано целиком.
Функция БезТеговScript(Знач HTML)

	Результат = HTML;
	Позиция = СтрНайти(Результат, "<script");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Результат, Позиция);
		Конец = СтрНайти(Хвост, "</script>");
		Если Конец = 0 Тогда
			Возврат Лев(Результат, Позиция - 1);
		КонецЕсли;
		Результат = Лев(Результат, Позиция - 1) + Сред(Хвост, Конец + СтрДлина("</script>"));
		Позиция = СтрНайти(Результат, "<script");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Адрес таблицы стилей берётся ИЗ АктивыСтатики, а не зашивается строкой: имя файла версионировано, и всякая
// правка CSS роняла бы эти тесты 404-м.
Функция АдресСтилей()

	Поставка = НоваяПоставкаСтатики();
	Место = Новый РаскладкаСтатики(Поставка);
	Возврат Новый АктивыСтатики(Место, Новый ОтпечаткиСтатики(Место)).Адрес(Поставка.ФайлСтилей());

КонецФункции

// Поставка статики инсталляции — класс проекта: кит его не везёт, а адрес без него
// выродится в имя без отпечатка.
Функция НоваяПоставкаСтатики()

	Попытка
		Проба = Тип("СтатикаХаба");
		Проба = Проба;
	Исключение
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули", "настройки"),
			"Классы", "СтатикаХаба.os"), "СтатикаХаба");
	КонецПопытки;

	Возврат Новый СтатикаХаба();

КонецФункции

// НФТ-ИНТФ-007, живая сторона: ссылку экрана собирает хаб, а читает её КАРКАС — и читает
// по-разному в зависимости от сервера (нативный Kestrel считает «+» пробелом, прикладной
// разбор winow — нет). Поэтому круг «хаб собрал → хаб прочитал» проверяется на живом
// экране, а не разбором той же библиотекой, которой ссылка собрана.
&Тест
Процедура ОтборДоезжаетДоЖивогоЭкранаСобраннойХабомСсылкой() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Ссылки = НовыеПараметрыСсылки();
	Расхождения = Новый Массив();

	Для Каждого Набранное Из ЗначенияОтбора() Цикл

		Адрес = Ссылки.Установить("/hub/settings/users", "q", Набранное);
		Прочитанное = ЗначениеПоляОтбора(Тело(Клиент.GETСКукой(Адрес, Кука)));
		Если Прочитанное <> Набранное Тогда
			Расхождения.Добавить(СтрШаблон("«%1» ссылкой «%2» доехало как «%3»",
				Набранное, Адрес, Прочитанное));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"набранное доехало до экрана без искажений").Равно("");

КонецПроцедуры

// Значения из порога НФТ-ИНТФ-007; пустое сюда не идёт — пустой отбор экран не ставит вовсе.
Функция ЗначенияОтбора()

	Значения = Новый Массив();
	Значения.Добавить("два слова");
	Значения.Добавить("a+b");
	Значения.Добавить("x=y=z");
	Значения.Добавить("50%");
	Значения.Добавить("%2F");
	Значения.Добавить("поиск по-русски");
	Возврат Значения;

КонецФункции

// Отбор, который экран получил: он печатается значением скрытого поля «q» окна заведения.
Функция ЗначениеПоляОтбора(Знач Разметка)

	Маркер = "name=""q"" value=""";
	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, """");
	Возврат ИзРазметки(?(Конец = 0, Хвост, Лев(Хвост, Конец - 1)));

КонецФункции

// Значение печатается экранированным; сравнивать надо с набранным, а не с разметкой.
Функция ИзРазметки(Знач Значение)

	Результат = СтрЗаменить(Значение, "&lt;", "<");
	Результат = СтрЗаменить(Результат, "&gt;", ">");
	Результат = СтрЗаменить(Результат, "&quot;", """");
	Результат = СтрЗаменить(Результат, "&#39;", "'");
	Возврат СтрЗаменить(Результат, "&amp;", "&");

КонецФункции

// Ссылку собирает класс проекта — тот же, которым её собирает сам хаб.
Функция НовыеПараметрыСсылки()

	Попытка
		Проба = Тип("ПараметрыСсылки");
		Проба = Проба;
	Исключение
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули", "основа"),
			"Классы", "ПараметрыСсылки.os"), "ПараметрыСсылки");
	КонецПопытки;

	Возврат Новый ПараметрыСсылки();

КонецФункции

// Запрос произвольным HTTP-методом (winow метод не различает — его разбирает контроллер).
Функция ВызватьМетодом(Знач Метод, Знач Путь, Знач Кука)
	Сессия = Новый Сессия();
	Если ЗначениеЗаполнено(Кука) Тогда
		Сессия.Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	КонецЕсли;
	Параметры = Новый Структура("РазрешитьПеренаправление", Ложь);
	Возврат Сессия.ВызватьМетод(Метод, СтрШаблон("http://localhost:%1%2", Формат(Порт, "ЧГ=0"), Путь),
		Параметры);
КонецФункции

// Сквозной гейт ритма форм: каждое тело страницы, прочитанное любым тестом набора, проходит фикстуру РитмФорм —
// она ищет .field/.toggle в реальной выдаче и требует у их непосредственного родителя интервал в листах страницы.

// Сколько раз подстрока встречается в тексте (счёт строк аудита).
Функция СколькоРаз(Знач Текст, Знач Подстрока)

	Результат = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Подстрока);

	Пока Позиция > 0 Цикл
		Результат = Результат + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Подстрока));
		Позиция = СтрНайти(Хвост, Подстрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Тело(Знач Ответ)

	Текст = Клиент.Тело(Ответ);
	ПроверитьРитмПолей(Текст);
	Возврат Текст;

КонецФункции

// Подписи дорог, помеченных текущими: aria-current стоит на самом пункте, а его текст —
// в первом безатрибутном <span> внутри (в спане с атрибутом живёт бейдж). Считается только
// панель: в рейке те же дороги стоят вторым экземпляром.
Функция ПодписиАктивныхДорог(Знач Разметка)

	Результат = Новый Массив();
	Маркер = "aria-current=""true""";

	Хвост = ДелаИДороги(Разметка);
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Результат.Добавить(МеждуДвумяМаркерами(Хвост, "<span>", "</span>"));
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат СтрСоединить(Результат, ", ");

КонецФункции

// Часть панели с делами и дорогами хаба: разделы ТЕКУЩЕГО экрана несут свою пометку
// от самого дома, и к подсветке дорог она отношения не имеет.
Функция ДелаИДороги(Знач Разметка)

	Панель = ПанельЕдиногоМеню(Разметка);
	Граница = СтрНайти(Панель, "aria-label=""Разделы экрана""");
	Возврат ?(Граница = 0, Панель, Лев(Панель, Граница - 1));

КонецФункции

Функция МеждуДвумяМаркерами(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

// Панель единого меню инсталляции: она стоит до содержимого страницы, поэтому кончается
// там, где начинается <main>. Дорога, найденная вне панели, дороги ИЗ МЕНЮ не доказывает.
Функция ПанельЕдиногоМеню(Знач Разметка)

	Начало = СтрНайти(Разметка, "<div class=""hubmenu""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, "<main");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Процедура ПроверитьРитмПолей(Знач HTML)

	// Гейт производительности, а не смысла: нет слов «field»/«toggle» — нет и полей.
	Если СтрНайти(HTML, "field") = 0 И СтрНайти(HTML, "toggle") = 0 Тогда
		Возврат;
	КонецЕсли;

	Нарушения = Ритм().Нарушения(HTML, ТекстCSS());
	Если Нарушения.Количество() > 0 Тогда
		ВызватьИсключение "Ритм форм: " + СтрСоединить(Нарушения, "; ");
	КонецЕсли;

КонецПроцедуры

Функция Ритм()
	Если РитмПолей = Неопределено Тогда
		РитмПолей = Новый РитмФорм();
	КонецЕсли;
	Возврат РитмПолей;
КонецФункции

// Браузер получает ДВА листа: базовый лист кита и лист инсталляции поверх него. Правила
// сверяются по их сумме — по одному листу половина правил объявилась бы пропавшей.
Функция ТекстCSS()

	Если СтилиХаба = Неопределено Тогда
		Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
		СтилиХаба = ПрочитатьЛист(Место.ПолныйПуть(Место.ФайлБазовогоЛиста()))
			+ Символы.ПС + ПрочитатьЛист(ОбъединитьПути(КаталогПроекта, "src", "статика",
				ИмяФайлаСтилей()));
	КонецЕсли;

	Возврат СтилиХаба;

КонецФункции

Функция ПрочитатьЛист(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Имя файла стилей содержит контент-хеш — берём его у каталога статики, а не литералом.
Функция ИмяФайлаСтилей()

	Найденные = НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src", "статика"), "openhub*.css");
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон(
			"Ожидался ровно один файл стилей openhub*.css в src/статика, найдено %1",
			Найденные.Количество());
	КонецЕсли;

	Возврат Найденные[0].Имя;

КонецФункции

// Аноним отбит: редирект на /login либо страница БЕЗ защищённого маркера настроек (клиент сам прошёл по редиректу).
Функция НеДоступноАнониму(Знач Ответ, Знач Маркер)
	Если Редирект(Ответ) Тогда
		Возврат СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "/login") > 0;
	КонецЕсли;
	Возврат СтрНайти(Тело(Ответ), Маркер) = 0;
КонецФункции

// Возвращает раздел «Брендирование» к значениям по умолчанию: хаб у набора один на все
// тесты, и оставленный знак инсталляции испортил бы соседей.
Процедура СброситьБрендирование(Знач Токен, Знач Кука)

	Для Каждого Ключ Из СтрРазделить(
		"oshub.ui.brand,oshub.ui.tagline,oshub.ui.theme,oshub.ui.accent", ",") Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Токен);
		Поля.Вставить("операция", "сбросить");
		Поля.Вставить("ключ", Ключ);
		Клиент.POSTФормы("/hub/settings/branding", Поля, Кука);
	КонецЦикла;

КонецПроцедуры

Функция УспехМутации(Знач Ответ)
	Возврат Ответ.КодСостояния < 400;
КонецФункции

// Создаёт подписку на объекте формой раздела: CSRF со страницы + URL + все флажки событий.
Функция СоздатьПодписку(Знач Адрес, Знач URL, Знач Кука, Знач АдресТокена = "")

	// токен по умолчанию берём со страницы самого раздела; отдельный АдресТокена нужен там, где формы нет вовсе
	// (витрина без права) — иначе мутация отбилась бы отсутствием CSRF, и гейт ПРАВ остался бы непроверенным
	Источник = ?(ЗначениеЗаполнено(АдресТокена), АдресТокена, Адрес);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Источник, Кука))));
	// тип действия присылает селектор формы (7.C круг B): раздел его не додумывает
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", URL);
	Поля.Вставить("секрет", "");
	// имена и значения — как их рисует ВитринаПодписок (событие_N со значением "1")
	Для Индекс = 0 По 4 Цикл
		Поля.Вставить("событие_" + Формат(Индекс, "ЧГ=0; ЧН=0"), "1");
	КонецЦикла;
	Возврат Клиент.POSTФормы(Адрес, Поля, Кука);

КонецФункции

// Создаёт зеркало пула формой раздела: CSRF со страницы + адрес апстрима, режим и интервал.
Функция СоздатьЗеркало(Знач Адрес, Знач URL, Знач Кука, Знач Интервал)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Адрес, Кука))));
	Поля.Вставить("url", URL);
	Поля.Вставить("режим", "opm");
	Поля.Вставить("фильтр", "");
	Поля.Вставить("интервал", Интервал);
	Возврат Клиент.POSTФормы(Адрес, Поля, Кука);

КонецФункции

// Действие над зеркалом строки: toggle («включить» = «1» либо «0»), sync, delete.
Функция ДействиеЗеркала(Знач Адрес, Знач Ид, Знач Операция, Знач Включить, Знач Кука)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Адрес, Кука))));
	Если ЗначениеЗаполнено(Включить) Тогда
		Поля.Вставить("включить", Включить);
	КонецЕсли;
	Возврат Клиент.POSTФормы(Адрес + "/" + Ид + "/" + Операция, Поля, Кука);

КонецФункции

// Убирает все зеркала пула: набор делит один пул между тестами.
Процедура УдалитьЗеркала(Знач Адрес, Знач Кука)

	Для Счётчик = 1 По 20 Цикл
		Ид = ИдентификаторПодписки(Тело(Клиент.GETСКукой(Адрес, Кука)), Адрес);
		Если НЕ ЗначениеЗаполнено(Ид) Тогда
			Возврат;
		КонецЕсли;
		ДействиеЗеркала(Адрес, Ид, "delete", "", Кука);
	КонецЦикла;

КонецПроцедуры

// Сколько подписок в списке: у каждой строки ровно одна форма удаления.
Функция ЧислоПодписок(Знач Разметка)
	Возврат СтрЧислоВхождений(Разметка, "/delete""");
КонецФункции

// Переключение подписки: «1» — включить, «0» — выключить (значение, а не присутствие).
Функция Переключить(Знач Адрес, Знач Ид, Знач Значение, Знач Кука)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Адрес, Кука))));
	Поля.Вставить("включить", Значение);
	Возврат Клиент.POSTФормы(Адрес + "/" + Ид + "/toggle", Поля, Кука);

КонецФункции

// Идентификатор первой подписки из разметки списка: берём его из адреса формы удаления.
Функция ИдентификаторПодписки(Знач Разметка, Знач Адрес)

	Маркер = "action=""" + Адрес + "/";
	Позиция = Найти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Разметка, Позиция + СтрДлина(Маркер));
	Конец = Найти(Остаток, "/");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

Функция ИзвлечьCSRF(Знач Тело_)
	Возврат Клиент.ПослеМаркера(Тело_, "name=""_csrf"" value=""", """");
КонецФункции

#КонецОбласти
