КонецПроцедуры

// Подбор кандидатов: серверный отбор остаётся единственной гарантией, а клиентский —
// сужением уже показанного, и экран честно говорит об этом ЗАРАНЕЕ напечатанной, но
// спрятанной оговоркой. Без скрипта работают форма отбора и кнопка «Добавить» у строки.
&Тест
Процедура ПодборКандидатовОтбираетсяСерверомИРаботаетБезJS() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/groups/platform/settings/members";
	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)));

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "oninput="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onsubmit="), "и обработчиков отправки тоже").Равно(0);

	// граница отбираемого списка объявлена ДАННЫМИ и называет то же поле, что у формы
	Ожидаем.Что(СтрНайти(БезСкриптов, "<div data-filter=""q"">") > 0,
		"область клиентского отбора объявлена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<form class=""filters"" method=""get"" action=""" + Раздел + """") > 0,
		"серверный отбор — обычная GET-форма").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "name=""q""") > 0, "с полем подстроки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "type=""submit""") > 0, "и кнопкой отправки").ЭтоИстина();

	// оговорки напечатаны сервером и СПРЯТАНЫ: без скрипта их не бывает
	Ожидаем.Что(СтрНайти(БезСкриптов, "<div role=""status"" data-filter-partial=""q"" hidden>") > 0,
		"оговорка «отбор по показанным» напечатана скрытой и объявляемой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<div role=""status"" data-filter-empty=""q"" hidden>") > 0,
		"и оговорка «совпадений нет» тоже").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "Чтобы искать по всем учётным записям хаба") > 0,
		"текст оговорки печатает сервер, а не скрипт").ЭтоИстина();

	// строки выдачи и их формы добавления — на месте
	Ожидаем.Что(СтрНайти(БезСкриптов, "<td>bob</td>") > 0, "кандидат bob в выдаче").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "value=""добавить""") > 0,
		"у строки своя POST-форма добавления").ЭтоИстина();

	// серверный отбор действительно сужает выдачу — он и нужен, когда строк больше выдачи
	Отобрано = БезТеговScript(Тело(Клиент.GETСКукой(Раздел + "?q=bob", КукаАдмина)));
	Ожидаем.Что(СтрНайти(Отобрано, "<td>bob</td>") > 0, "искомый кандидат остался").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отобрано, "<td>owner1</td>"), "прочие отсеяны сервером").Равно(0);

	Пусто = Тело(Клиент.GETСКукой(Раздел + "?q=нетакого", КукаАдмина));
	Ожидаем.Что(СтрНайти(Пусто, "ничего не найдено") > 0,
		"пустая серверная выдача объяснена").ЭтоИстина();

КонецПроцедуры

