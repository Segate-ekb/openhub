&Тест
Процедура АвторБезПраваВидитПодпискиТолькоЧитая() Экспорт

	// alice — АВТОР пакета, роли на пуле у неё нет: страницу дома видит, подписками не распоряжается
	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Адрес = "/public/alice-pkg/settings/webhooks";

	Стр = Тело(Клиент.GETСКукой(Адрес, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Подписки на события") > 0, "раздел открыт").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Новая подписка"), "формы создания нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "только для чтения") > 0, "сказано, почему нельзя").ЭтоИстина();

	// CSRF берём с соседнего раздела того же дома: у витрины формы нет, и мутация отбилась бы отсутствием токена
	Ответ = СоздатьПодписку(Адрес, "https://hook.example.com/author", Кука,
		"/public/alice-pkg/settings/card");
	Ожидаем.Что(Ответ.КодСостояния, "мутация автора отбита службой, а не CSRF").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, Кука)), "hook.example.com/author"),
		"подписка не сохранена").Равно(0);

