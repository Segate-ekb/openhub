	ПроверитьРедирект("/office/password", "/me/settings/security");
	ПроверитьРедирект("/office/tokens", "/me/settings/tokens");
	ПроверитьРедирект("/office/identities", "/me/settings/oidc");
	ПроверитьРедирект("/office/webhooks", "/me");
КонецПроцедуры

&Тест
Процедура УпразднённыеРазделыДомаХабаЗакрытыПереездом() Экспорт

	// пять разделов слились в два: сохранённая ссылка и закладка обязаны увести
	// в раздел-преемник насовсем (301), а не в 404
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	ПроверитьПереезд("/hub/settings/registration", "/hub/settings/login", КукаАдмина);
	ПроверитьПереезд("/hub/settings/auth", "/hub/settings/login", КукаАдмина);

КонецПроцедуры

&Тест
Процедура ЭкранНаПрежнемАдресеДостижимИзДереваИИмеетСвоёИмя() Экспорт

	// дверь в одну сторону: экран, выпавший из дерева, оставляет администратора без
	// возврата. Пока учётки, группы и провайдеры живут по своим адресам, раздел-преемник
	// обязан давать на них ссылку, а сами они — подсвечивать пункт преемника
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Люди = Тело(Клиент.GETСКукой("/hub/settings/people", КукаАдмина));
	Ожидаем.Что(СтрНайти(Люди, "href=""/hub/settings/users""") > 0,
		"из «Людей» есть ход на список пользователей").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Люди, "href=""/hub/settings/groups""") > 0,
		"и на группы").ЭтоИстина();

	// провайдеры входа — свой пункт дерева, а не ссылка внутри чужого раздела
	Ожидаем.Что(АктивныйПунктДерева(Тело(Клиент.GETСКукой("/hub/settings/providers", КукаАдмина))),
		"провайдеры стоят в своём пункте").Равно("/hub/settings/providers");

	// подсветка: страница прежнего адреса помечает активным пункт своего преемника
	Учётки = Тело(Клиент.GETСКукой("/hub/settings/users", КукаАдмина));
	Ожидаем.Что(АктивныйПунктДерева(Учётки), "список пользователей стоит в пункте «Люди»")
		.Равно("/hub/settings/people");
	Ожидаем.Что(АктивныйПунктДерева(Тело(Клиент.GETСКукой("/hub/settings/groups", КукаАдмина))),
		"группы стоят в том же пункте").Равно("/hub/settings/people");

	// и при этом два разных экрана различимы по заголовку вкладки
	Ожидаем.Что(СтрНайти(Учётки, "<title>Пользователи") > 0,
		"у списка пользователей своё имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/hub/settings/groups", КукаАдмина)), "<title>Группы") > 0,
		"у групп своё имя, а не общее с «Людьми»").ЭтоИстина();

КонецПроцедуры

// Адрес активного пункта дерева разделов: пункт помечен классом tree__link--active.
Функция АктивныйПунктДерева(Знач Разметка)

	Позиция = СтрНайти(Разметка, "tree__link--active");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Голова = Лев(Разметка, Позиция);
	Начало = СтрНайти(Голова, "href=""", НаправлениеПоиска.СКонца);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Голова, Начало + 6);
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

// Адреса пунктов дерева РАЗДЕЛОВ дома «Хаб» — из самой отданной страницы, а не списком
// в тесте. Каркас страницы печатает своим деревом и соседние дома, поэтому отбираем
// только разделы этого дома и без повторов.
// Пункты дерева разделов ДОМА: адрес и разметка самого пункта. Навигация кабинета собрана
// тем же компонентом и печатает те же классы, поэтому отбор идёт не по классу ссылки,
// а по границе дома: каркас печатает навигацию ДО корня дома (`data-house`).
Функция ПунктыДереваДома(Знач Разметка)

	Результат = Новый Массив();
	КореньДома = СтрНайти(Разметка, "data-house=");
	Если КореньДома = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Маркер = "<a href=""";
	Признак = """ class=""tree__link";
	Хвост = Сред(Разметка, КореньДома);
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 0 И СтрНачинаетсяС(Сред(Хвост, Конец), Признак) Тогда
			Закрытие = СтрНайти(Хвост, "</a>");
			Результат.Добавить(Новый Структура("Адрес, Разметка",
				Лев(Хвост, Конец - 1), ?(Закрытие > 0, Лев(Хвост, Закрытие), Хвост)));
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АдресаДереваХаба(Знач Разметка)

	Результат = Новый Массив();
	Встреченные = Новый Соответствие();
	Основа = "/hub/settings/";
	Маркер = "<a href=""";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 0 И СтрНачинаетсяС(Сред(Хвост, Конец), """ class=""tree__link") Тогда
			Адрес = Лев(Хвост, Конец - 1);
			Если СтрНачинаетсяС(Адрес, Основа) И Встреченные.Получить(Адрес) = Неопределено Тогда
				Встреченные.Вставить(Адрес, Истина);
				Результат.Добавить(Адрес);
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Тест
Процедура ПунктДереваНеВедётВПустоту() Экспорт

	// пункт дерева, открывающий страницу без единой секции, выглядит сломанным экраном.
	// Ключи разделов берутся ИЗ САМОГО дерева: раздел, которого в нём нет, недостижим
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Адреса = АдресаДереваХаба(Тело(Клиент.GETСКукой("/hub/settings", КукаАдмина)));

	Ожидаем.Что(Адреса.Количество(), "дерево дома «Хаб» отдало все свои пункты").Равно(16);

	Пустые = Новый Массив();
	Для Каждого Адрес Из Адреса Цикл
		Если Адрес = "/hub/settings/mail" Тогда
			// осознанное исключение: раздел заведён пустым под трек почты, он его и наполнит
			Продолжить;
		КонецЕсли;
		Страница = Тело(Клиент.GETСКукой(Адрес, КукаАдмина));
		Если СтрНайти(Страница, "<section class=""section") = 0 Тогда
			Пустые.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пустые, ", "),
		"пункты дерева, ведущие на страницу без единой секции").Равно("");

КонецПроцедуры

&Тест
Процедура МутацияНаУпразднённыйАдресОтвечаетОтказомАНеРедиректом() Экспорт

	// редирект POST «как будто применилось» хуже честного отказа: вкладка со старой
	// формой ушла бы в никуда, а администратор считал бы значение изменённым
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("oshub.auth.token.cli_days", "9999");
	Отказ = Клиент.POSTФормы("/hub/settings/auth", Поля, КукаАдмина);

	Ожидаем.Что(Отказ.КодСостояния, "мутация на упразднённый адрес отбита").Равно(405);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина)), "value=""9999"""),
		"и ничего не записала").Равно(0);

