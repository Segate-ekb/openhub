КонецПроцедуры

&Тест
Процедура ЗарезервированноеИмяПулаНеСоздаётся() Экспорт
	// имя пула из списка системных сегментов не должно приниматься self-service-созданием.
	// Форма БОЕВАЯ — раздел «Пулы» настроек хаба: по старому адресу отказ пришёл бы сам
	// собой (точки приёма там больше нет), и тест был бы вечнозелёным.
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/hub/settings/pools";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "пул-создать");
	Поля.Вставить("имя", "static");
	Поля.Вставить("тип", "custom");
	Поля.Вставить("видимость", "public");
	Ответ = Клиент.POSTФормы(Раздел, Поля, КукаАдмина);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)), ">static<"),
		"пул с системным именем не появился").Равно(0);
	Ожидаем.Что(Ответ.КодСостояния < 500, "отказ, а не падение").ЭтоИстина();

	// КОНТРОЛЬ: та же форма обычное имя принимает — иначе «не появился» ничего не значит
	Поля.Вставить("имя", "notreserved" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаАдмина)),
		"контроль: годное имя форма принимает").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ЛогинИзСистемногоСегментаОтклоняется() Экспорт
	// РЕЗЕРВ ЛОГИНОВ (найдено ревью 5.A): логины и имена пулов делят первый сегмент URL
	Ожидаем.Что(РегистрацияКод("static", "GoodPass1"), "логин static отклонён").Равно(400);
	Ожидаем.Что(РегистрацияКод("hub", "GoodPass1"), "логин hub отклонён").Равно(400);
	Ожидаем.Что(РегистрацияКод("api", "GoodPass1"), "логин api отклонён").Равно(400);
	Ожидаем.Что(РегистрацияКод("me", "GoodPass1"), "логин me отклонён").Равно(400);
	Ожидаем.Что(РегистрацияКод("regular-login", "GoodPass1"), "обычный логин принят").Равно(201);
КонецПроцедуры

// Приватный пул означает, что приватны ВСЕ его пакеты: прежде это соблюдала только JSON-часть API — страница пула,
// страница пакета и выдача .ospx отдавали приватное кому угодно.

&Тест
Процедура АнонимНеВидитПриватныйПул() Экспорт

	// secret — приватный пул owner1, которого не трогает ни один другой тест
	Ответ = Клиент.GET("/secret");
	Ожидаем.Что(Ответ.КодСостояния, "страница приватного пула — 404 для анонима").Равно(404);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "secret-pkg"), "список пакетов не раскрыт").Равно(0);

	// существование не раскрывается: несуществующий пул отвечает так же
	Ожидаем.Что(Клиент.GET("/нетакогопула").КодСостояния, "несуществующий пул — тот же 404").Равно(404);

КонецПроцедуры

&Тест
Процедура АнонимНеВидитПакетПриватногоПула() Экспорт
	Ожидаем.Что(Клиент.GET("/secret/secret-pkg").КодСостояния,
		"страница пакета приватного пула — 404 для анонима").Равно(404);
КонецПроцедуры

// Этим путём ходит opm — дыра здесь означала бы утечку артефактов. Канонический адрес и вечный алиас
// проверяются ОБА: гейт стоит в общей процедуре выдачи, но регресс мог бы завести маршрут мимо неё.
&Тест
Процедура АнонимНеКачаетИзПриватногоПулаНиАдресомНиАлиасом() Экспорт

	Пары = Новый Соответствие();
	Пары.Вставить("/api/v1/pools/secret/download/list.txt", "/pools/secret/download/list.txt");
	Пары.Вставить("/api/v1/pools/secret/download/secret-pkg/secret-pkg-1.0.0.ospx",
		"/pools/secret/download/secret-pkg/secret-pkg-1.0.0.ospx");
	Пары.Вставить("/api/v1/pools/secret/download/secret-pkg/secret-pkg.ospx",
		"/pools/secret/download/secret-pkg/secret-pkg.ospx");
	Пары.Вставить("/api/v1/pools/secret/channels/stable/download/list.txt",
		"/pools/secret/channels/stable/download/list.txt");
	Пары.Вставить("/api/v1/pools/secret/channels/stable/download/secret-pkg/secret-pkg.ospx",
		"/pools/secret/channels/stable/download/secret-pkg/secret-pkg.ospx");

	Для Каждого Пара Из Пары Цикл
		Канонический = Клиент.GET(Пара.Ключ);
		Алиас = Клиент.GET(Пара.Значение);
		Ожидаем.Что(Канонический.КодСостояния, "приватный пул закрыт: " + Пара.Ключ).Равно(404);
		Ожидаем.Что(Алиас.КодСостояния, "приватный пул закрыт алиасом: " + Пара.Значение).Равно(404);
		Ожидаем.Что(СтрНайти(Тело(Канонический), "secret-pkg"),
			"имена пакетов не раскрыты: " + Пара.Ключ).Равно(0);
		Ожидаем.Что(СтрНайти(Тело(Алиас), "secret-pkg"),
			"имена пакетов не раскрыты: " + Пара.Значение).Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ВладелецЧитаетСвойПриватныйПул() Экспорт

	// гейт не должен ломать законный доступ: владелец видит и страницу, и выдачу — на обоих адресах
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/secret", КукаOwner).КодСостояния, "владелец видит свой пул").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/api/v1/pools/secret/download/list.txt", КукаOwner).КодСостояния,
		"владелец получает list.txt своего пула").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/pools/secret/download/list.txt", КукаOwner).КодСостояния,
		"тот же list.txt по вечному алиасу").Равно(200);

КонецПроцедуры

&Тест
Процедура ПубличныйПулОстаётсяОткрытым() Экспорт
	// регресс-страховка: гейт приватности не должен закрыть публичную выдачу
	Ожидаем.Что(Клиент.GET("/public").КодСостояния, "публичный пул открыт").Равно(200);
	Ожидаем.Что(Клиент.GET("/public/alice-pkg").КодСостояния, "страница пакета открыта").Равно(200);
	Ожидаем.Что(Клиент.GET("/api/v1/pools/public/download/list.txt").КодСостояния, "list.txt открыт").Равно(200);
	Ожидаем.Что(Клиент.GET("/pools/public/download/list.txt").КодСостояния, "list.txt открыт алиасом").Равно(200);
КонецПроцедуры

&Тест
Процедура ПодсказкаКвотыГоворитТоЖе_ЧтоИОтказГейта() Экспорт

	// РЕГРЕССИЯ: подсказка под полем квоты пережила смену правила и продолжала советовать
	// «отозванные версии в квоту не входят» — ровно то, что из текста отказа гейта убрали.
	// Экран и отказ обязаны говорить одно и то же, иначе админ чинит переполнение отзывом.
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Страница = Тело(Клиент.GETСКукой("/owned/settings/quota", КукаАдмина));

	// снятое правило ищется целиком: подстрока «не входят» сама по себе ничего не значит
	Ожидаем.Что(СтрНайти(Страница, "отозванные версии в неё не входят"),
		"подсказка больше не выводит отозванные версии из квоты").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "ВКЛЮЧАЯ отозванные") > 0,
		"а прямо говорит обратное").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "отзыв места не освобождает") > 0,
		"подсказка называет действующее правило отзыва").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "удаление пакета") > 0,
		"и говорит, что место освобождает").ЭтоИстина();
	// правило сменилось: кэш прокси теперь В квоте, и подсказка обязана называть его
	// среди занявшего место — иначе владелец пула не поймёт, чем забит его пул
	Ожидаем.Что(СтрНайти(Страница, "кэш прокси") > 0,
		"а также что кэш прокси занимает место пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "уборка кэша прокси") > 0,
		"и что место кэша возвращает уборка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВладелецПулаКвотуНеМеняетДажеПодделаннойФормой() Экспорт

	// ДЕФЕКТ ПРАВ: владелец пула выставлял себе квоту сам, в том числе 0 («без лимита»).
	// Предел, который меняет подопечный, пределом не является. Скрытие поля защитой не
	// считается — форма подделывается, поэтому проверяется ОТКАЗ СЕРВЕРА и НЕИЗМЕННОСТЬ базы.
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/quota", КукаАдмина)));
	Исходные = Новый Соответствие();
	Исходные.Вставить("_csrf", Токен);
	Исходные.Вставить("квота_мб", "512");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/owned/settings/quota", Исходные, КукаАдмина)),
		"админ хаба квоту ставит").ЭтоИстина();

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	СтраницаВладельца = Тело(Клиент.GETСКукой("/owned/settings/quota", КукаOwner));
	Ожидаем.Что(Клиент.GETСКукой("/owned/settings/quota", КукаOwner).КодСостояния,
		"раздел владельцу виден").Равно(200);
	Ожидаем.Что(СтрНайти(СтраницаВладельца, "name=""квота_мб"""),
		"органа управления у владельца нет").Равно(0);
	Ожидаем.Что(СтрНайти(СтраницаВладельца, "role=""progressbar""") > 0,
		"а полоса заполнения показана").ЭтоИстина();

	// подделанная форма: владелец шлёт POST напрямую, взяв CSRF-токен своей сессии
	Подделка = Новый Соответствие();
	Подделка.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/visibility", КукаOwner))));
	Подделка.Вставить("квота_мб", "0");
	Ответ = Клиент.POSTФормы("/owned/settings/quota", Подделка, КукаOwner);

	Ожидаем.Что(Ответ.КодСостояния, "сервер отвечает 403").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/settings/quota", КукаАдмина)), "value=""512""") > 0,
		"квота в базе НЕ изменилась").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НечисловаяКвотаНеСнимаетЛимит() Экспорт

	// опечатка «5oo» приводилась к 0, а 0 означает «без лимита»: администратор снимал ограничение и видел «сохранено»
	КукаOwner = Клиент.Войти("root", "RootPassw0rd"); // квоту правит админ хаба
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/quota", КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("квота_мб", "128");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/owned/settings/quota", Поля, КукаOwner)),
		"исходная квота выставлена").ЭтоИстина();

	Плохие = Новый Соответствие();
	Плохие.Вставить("_csrf", Токен);
	Плохие.Вставить("квота_мб", "5oo");
	Ответ = Клиент.POSTФормы("/owned/settings/quota", Плохие, КукаOwner);

	Ожидаем.Что(Ответ.КодСостояния, "непринятый ввод → 400, а не «сохранено»").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "НЕ изменена") > 0, "сказано, что ничего не изменилось").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/settings/quota", КукаOwner)), "128") > 0,
		"квота осталась прежней").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НулеваяКвотаДоезжаетДоПоляНаЖивомХабе() Экспорт

	// Формат(0, "ЧГ=0") возвращает ПУСТУЮ строку, а ЭкранированиеHTML.Атрибут пустое значение не печатает — поле
	// «квота_мб» приезжало БЕЗ атрибута value, хотя нуль здесь значим («без лимита»). Проверяется выдача СЕРВЕРА.
	КукаOwner = Клиент.Войти("root", "RootPassw0rd"); // квоту правит админ хаба
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/quota", КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("квота_мб", "0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/owned/settings/quota", Поля, КукаOwner)),
		"нулевая квота сохранена").ЭтоИстина();

	ТелоСтраницы = Тело(Клиент.GETСКукой("/owned/settings/quota", КукаOwner));
	Позиция = СтрНайти(ТелоСтраницы, "name=""квота_мб""");

	Ожидаем.Что(Позиция > 0, "поле квоты на странице есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сред(ТелоСтраницы, Позиция, 120), "value=""0""") > 0,
		"нулевая квота доезжает до value, а не исчезает из поля").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеправдоподобноБольшаяКвотаОтклоняется() Экспорт

	// 10^21 МБ принималось и уезжало в арифметику сверки квот, где такая величина молча теряет точность
	КукаOwner = Клиент.Войти("root", "RootPassw0rd"); // квоту правит админ хаба
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/quota", КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("квота_мб", "999999999999999999999");
	Ответ = Клиент.POSTФормы("/owned/settings/quota", Поля, КукаOwner);

	Ожидаем.Что(Ответ.КодСостояния, "запредельная квота → 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "слишком велика") > 0, "причина названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/settings/quota", КукаOwner)), "999999999999999999999"),
		"значение не сохранилось").Равно(0);

	// правдоподобная квота по-прежнему принимается
	Норм = Новый Соответствие();
	Норм.Вставить("_csrf", Токен);
	Норм.Вставить("квота_мб", "1024");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/owned/settings/quota", Норм, КукаOwner)),
		"обычная квота принята").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестнаяОперацияАпстримовНеГаситПубликацию() Экспорт

	// ветка «иначе» трактовала любую операцию как «сохранить флаги», а отсутствие чекбокса — как «выключить публикацию»:
	// устаревшей вкладки или двойного сабмита хватало, чтобы пул перестал принимать opm push
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner)));

	Мусор = Новый Соответствие();
	Мусор.Вставить("_csrf", Токен);
	Мусор.Вставить("операция", "чепуха");
	Ответ = Клиент.POSTФормы("/owned/settings/upstreams", Мусор, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния, "неизвестная операция → 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Ничего не изменено") > 0, "состояние не тронуто").ЭтоИстина();

	// POST вообще без полей — тот же класс: раньше он выключал публикацию
	Пустой = Новый Соответствие();
	Пустой.Вставить("_csrf", Токен);
	Ожидаем.Что(Клиент.POSTФормы("/owned/settings/upstreams", Пустой, КукаOwner).КодСостояния,
		"форма без операции → 400").Равно(400);

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner)), "checked") > 0,
		"публикация осталась разрешённой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПубликацияВыключаетсяТолькоЯвнойОперацией() Экспорт

	// позитив к предыдущему тесту: законный путь по-прежнему работает
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "флаги");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/owned/settings/upstreams", Поля, КукаOwner)),
		"явная операция принята").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner)), "checked"),
		"публикация выключена явным действием").Равно(0);

	// и включается обратно
	Обратно = Новый Соответствие();
	Обратно.Вставить("_csrf", Токен);
	Обратно.Вставить("операция", "флаги");
	Обратно.Вставить("публикация", "1");
	Клиент.POSTФормы("/owned/settings/upstreams", Обратно, КукаOwner);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner)), "checked") > 0,
		"публикация включена обратно").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеАдресОтклонёнUIСВнятнойПричинойАСетьНеСудится() Экспорт

	// отвергается только то, что не является адресом выдачи; сеть назначения не судится
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner)));

	Векторы = Новый Массив();
	Векторы.Добавить("file:///etc/passwd");
	Векторы.Добавить("gopher://hub.local/");
	Векторы.Добавить("hub.local/download/");
	Векторы.Добавить("http://user:pw@127.0.0.1:34999/");

	Для Каждого Вектор Из Векторы Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Токен);
		Поля.Вставить("операция", "добавить");
		Поля.Вставить("url", Вектор);
		Поля.Вставить("ttl", "900");
		Ответ = Клиент.POSTФормы("/owned/settings/upstreams", Поля, КукаOwner);
		Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("апстрим ""%1"" отклонён", Вектор)).Равно(400);
		// причина должна быть ЧИТАЕМОЙ: раньше содержательный отказ доходил до владельца как «внутренняя ошибка»
		Ожидаем.Что(СтрНайти(Тело(Ответ), "отклонён") > 0,
			СтрШаблон("причина отказа показана (%1)", Вектор)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Ответ), "внутренняя ошибка"),
			"причина не подменена заглушкой").Равно(0);
	КонецЦикла;

	Страница = Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner));
	Ожидаем.Что(СтрНайти(Страница, "etc/passwd"), "не-адрес не создан").Равно(0);

	// а адрес во внутренней сети — законный источник: он заводится и виден в списке
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "добавить");
	Поля.Вставить("url", "http://169.254.169.254/latest/meta-data/");
	Поля.Вставить("ttl", "900");
	Ответ = Клиент.POSTФормы("/owned/settings/upstreams", Поля, КукаOwner);
	Ожидаем.Что(УспехМутации(Ответ), "адрес во внутренней сети принят").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner)), "169.254") > 0,
		"и виден в списке источников").ЭтоИстина();

	// убираем за собой: пул делится между тестами набора
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner))));
	Поля.Вставить("операция", "удалить");
	Поля.Вставить("url", "http://169.254.169.254/latest/meta-data/");
	Клиент.POSTФормы("/owned/settings/upstreams", Поля, КукаOwner);

КонецПроцедуры

// Аудит 2026-08-08: форма источников обещала пробное подключение безусловно, а хаб этого
// набора поднят с OSHUB_UPSTREAM_PROBE_ENABLED=false — мёртвый адрес сохранялся молча.
// Обещание НФТ-АПСТ-001 держится при включённой пробе; с выключенной экран обязан сказать
// это сам, а не притворяться проверяющим.
&Тест
Процедура ФормаИсточниковНеОбещаетПробуКоторойНаЭтомХабеНет() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Страница = Тело(Клиент.GETСКукой("/owned/settings/upstreams", КукаOwner));

	Ожидаем.Что(СтрНайти(Страница, "источник не заводится"),
		"обещания пробы, которой хаб не делает, на форме нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Пробное подключение на этом хабе выключено") > 0,
		"экран сам говорит, что адрес не проверяется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "oshub.upstream.probe.enabled") > 0,
		"и называет настройку, которой это включают").ЭтоИстина();

	// самотест: форма заведения на странице есть — иначе отсутствие обещания ничего не значит
	Ожидаем.Что(СтрНайти(Страница, "name=""url""") > 0, "форма заведения источника на месте")
		.ЭтоИстина();

КонецПроцедуры

// Та же неправда жила на форме зеркала: СервисЗеркал.ПроверитьПодключение ходит через
// тот же выключенный пробник, что и заведение источника пула.
