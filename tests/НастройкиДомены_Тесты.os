КонецПроцедуры

// Человек видит в меню, где он стоит. Путь текущей страницы доезжает до обрамления через
// живой конвейер (winow → контроллер → каркас), поэтому сторож и живой: на доме адрес
// берётся от активного раздела, на каталоге — от самого запроса.
&Тест
Процедура ТекущаяДорогаПодсвеченаНаЖивыхЭкранах() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/hub/settings/pools", КукаАдмина))),
		"в доме хаба горит «Настройки хаба» и только она").Равно("Настройки хаба");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/me/settings/profile", КукаАлисы))),
		"в доме аккаунта — «Настройки аккаунта»").Равно("Настройки аккаунта");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages", КукаАлисы))),
		"на каталоге — «Каталог»").Равно("Каталог");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages?mine=1", КукаАлисы))),
		"на каталоге с отбором «мои» — «Мои пакеты», а не «Каталог»").Равно("Мои пакеты");
	// winow 0.12.0 отдаёт строку параметров НЕДЕКОДИРОВАННОЙ и в исходном порядке:
	// подсветка обязана узнавать свой параметр среди соседей, а не по всей строке целиком
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages?mine=1&page=1", КукаАлисы))),
		"соседний параметр отбор «мои» не сбивает").Равно("Мои пакеты");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages?page=1&q=win", КукаАлисы))),
		"а без отбора горит «Каталог», сколько бы параметров ни пришло").Равно("Каталог");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/me/notifications", КукаАлисы))),
		"на ленте — «Уведомления», а не «Кабинет»").Равно("Уведомления");

КонецПроцедуры

// Разделы дома доезжают до единого меню отдельной секцией. Это не украшение: на узком
// экране колонка разделов не показывается вовсе, и другой дороги из раздела в раздел
// с телефона нет. Дом ЖИВОЙ — разделы собирает он сам, а не тест.
&Тест
Процедура РазделыДомаДоезжаютДоЕдиногоМеню() Экспорт

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Панель = ПанельЕдиногоМеню(Тело(Клиент.GETСКукой("/me/settings/profile", КукаАлисы)));

	Ожидаем.Что(Панель <> "", "единое меню на экране дома печатается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "Разделы экрана") > 0,
		"разделы дома названы своей секцией меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "href=""/me/settings/tokens""") > 0,
		"соседний раздел дома достижим прямо из меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "aria-current=""true""") > 0,
		"а текущий раздел в меню помечен").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы).КодСостояния,
		"дорога из меню ведёт на живой экран").Равно(200);

	// на экране без своих разделов секции нет: заголовок над пустотой обещает пункты,
	// которых там не будет
	Ожидаем.Что(СтрНайти(ПанельЕдиногоМеню(Тело(Клиент.GETСКукой("/packages", КукаАлисы))),
		"Разделы экрана"), "на публичном каталоге секции разделов нет").Равно(0);

КонецПроцедуры

