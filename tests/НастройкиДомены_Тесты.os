&Тест
Процедура РазделУведомленийСнятСКартыДомаАккаунта() Экспорт

	// подписка на события — настройка объекта, а не личного профиля. Проверяется ДЕРЕВО
	// разделов дома, а не вся страница: слово «Уведомления» законно живёт в навигации
	// кабинета — там оно ведёт в личную ленту (/me/notifications), а это другой экран
	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Пункты = ПунктыДереваДома(Тело(Клиент.GETСКукой("/me/settings/profile", Кука)));

	Ожидаем.Что(Пункты.Количество() > 0, "дерево дома «Аккаунт» прочитано, сканер не ослеп")
		.ЭтоИстина();

	Нарушители = Новый Массив();
	Для Каждого Пункт Из Пункты Цикл
		Если СтрНайти(Пункт.Адрес, "/me/settings/notifications") > 0
			ИЛИ СтрНайти(Пункт.Разметка, "Уведомления") > 0 Тогда
			Нарушители.Добавить(Пункт.Адрес);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"пункты дерева дома «Аккаунт», вернувшие раздел уведомлений").Равно("");

КонецПроцедуры

