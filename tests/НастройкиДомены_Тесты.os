	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Адрес, Поля, КукаАдмина)), "связка добавлена").ЭтоИстина();
	// проверяем именно СТРОКУ ТАБЛИЦЫ: то же значение стоит плейсхолдером в форме
	// добавления, и поиск по голой подстроке был бы всегда истинным
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаАдмина)), "<code>platform-team</code>") > 0,
		"связка видна в таблице").ЭтоИстина();

	ПоляУд = Новый Соответствие();
	ПоляУд.Вставить("_csrf", Токен);
	ПоляУд.Вставить("операция", "удалить");
	ПоляУд.Вставить("издатель", "https://idp.example.com");
	ПоляУд.Вставить("клейм", "groups");
	ПоляУд.Вставить("значение", "platform-team");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Адрес, ПоляУд, КукаАдмина)), "связка удалена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаАдмина)), "<code>platform-team</code>"),
		"связка исчезла из таблицы").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолитикаВыпавшихПравитсяТумблеромИВидноВремяСверки() Экспорт

	// поле из двух состояний — тумблер кита, а не select: проверяется весь стык — разметка → тело формы → РазборФормы
	// → сохранение, именно на нём ломается парное скрытое поле «выключено»
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Адрес = "/groups/platform/settings/oidc";
	Страница = Тело(Клиент.GETСКукой(Адрес, КукаАдмина));

	Ожидаем.Что(СтрНайти(Страница, "<div class=""toggle"">") > 0, "политика показана тумблером").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "name=""политика""") > 0, "тумблер отправляется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "value=""оставлять""") > 0, "значение включённого").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "value=""исключать""") > 0, "парное значение выключенного").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Состав сверялся с клеймами") > 0, "время сверки рядом с политикой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "ещё не сверялся") > 0, "не сверявшаяся группа говорит об этом").ЭтоИстина();
	// то же время — в разделе состава, где оно объясняет «почему участник вернулся»
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/groups/platform/settings/members", КукаАдмина)),
		"Сверено с клеймами") > 0, "время сверки в составе группы").ЭтоИстина();

	Токен = ИзвлечьCSRF(Страница);

	// включённый тумблер: браузер шлёт ОБА поля, флажок первым
	Включение = Новый Соответствие();
	Включение.Вставить("_csrf", Токен);
	Включение.Вставить("операция", "политика");
	Включение.Вставить("политика", "оставлять");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Адрес, Включение, КукаАдмина)), "политика сохранена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаАдмина)), "оставлять: участник остаётся") > 0,
		"состояние тумблера отражает сохранённую политику").ЭтоИстина();

	// выключенный тумблер: браузер шлёт ТОЛЬКО парное скрытое поле
	Выключение = Новый Соответствие();
	Выключение.Вставить("_csrf", Токен);
	Выключение.Вставить("операция", "политика");
	Выключение.Вставить("политика", "исключать");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Адрес, Выключение, КукаАдмина)), "политика возвращена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаАдмина)), "исключать: пропал клейм") > 0,
		"вернулось умолчание").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УчастникГруппыВидитПолитикуНоНеМожетЕёМенять() Экспорт

	// состав группы — рычаг прав по всему хабу: участник дом только читает, тумблер обязан быть ЗАБЛОКИРОВАН
	// и не нести парного скрытого поля
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = Тело(Клиент.GETСКукой("/groups/platform/settings/oidc", КукаАлисы));

	Ожидаем.Что(СтрНайти(Страница, "<div class=""toggle"">") > 0, "политика видна").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, " disabled") > 0, "тумблер заблокирован").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "name=""политика"""), "витрина не отправляется").Равно(0);

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "политика");
	Поля.Вставить("политика", "оставлять");
	Ожидаем.Что(Клиент.POSTФормы("/groups/platform/settings/oidc", Поля, КукаАлисы).КодСостояния,
		"мутация участника отбита").Равно(403);

КонецПроцедуры

// Политика пароля правится администратором с экрана — и это значит, что судить она
// начинает СЛЕДУЮЩИЙ ЖЕ пароль. Шесть значений, которые не доходят до ближайшей проверки,
// были бы просто числами в базе, а администратор считал бы политику организации введённой.
&Тест
Процедура ПравкаПолитикиПароляСудитСледующийЖеПароль() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/hub/settings/password";
	Ключ = "oshub.auth.password.min_length";

	Страница = Тело(Клиент.GETСКукой(Раздел, КукаАдмина));
	Для Каждого ЗначениеПолитики Из СтрРазделить(
		"min_length,max_length,require_lowercase,require_uppercase,require_digit,require_special", ",") Цикл
		Ожидаем.Что(СтрНайти(Страница, "name=""oshub.auth.password." + ЗначениеПолитики + """") > 0,
			СтрШаблон("%1 правится в разделе политики пароля", ЗначениеПолитики)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(РегистрацияКод("policy-before", "GoodPass1"),
		"самотест: девять символов годятся действующей политике").Равно(201);

	Попытка

		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", ИзвлечьCSRF(Страница));
		Поля.Вставить(Ключ, "14");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаАдмина)),
			"минимальная длина поднята до 14").ЭтоИстина();

		Ожидаем.Что(РегистрацияКод("policy-after", "GoodPass1"),
			"ближайшая же проверка судит по новой политике, без перезапуска").Равно(400);
		Ожидаем.Что(РегистрацияКод("policy-long", "GoodPassword12345"),
			"а пароль по новой политике проходит: отвергнута именно длина").Равно(201);

		// человек читает действующую политику там, где вводит пароль
		КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
		Ожидаем.Что(СтрНайти(БезТеговScript(Тело(Клиент.GETСКукой("/me/settings/security", КукаАлисы))),
			"длина от 14 до 256 символов") > 0,
			"страница смены пароля печатает новую политику словами").ЭтоИстина();

	Исключение
		СброситьКлюч(Раздел, Ключ, КукаАдмина);
		ВызватьИсключение;
	КонецПопытки;

	СброситьКлюч(Раздел, Ключ, КукаАдмина);
	Ожидаем.Что(РегистрацияКод("policy-reset", "GoodPass1"),
		"сброс вернул прежний минимум — и тоже на ближайшей проверке").Равно(201);

КонецПроцедуры

&Тест
Процедура РегистрацияКороткийПарольОтклонена() Экспорт
	Ожидаем.Что(РегистрацияКод("newbie1", "abc") = 400, "короткий пароль отклонён при регистрации").ЭтоИстина();
	Ожидаем.Что(РегистрацияКод("newbie2", "GoodPass1") = 201, "валидный пароль принят").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура СменаПароляКороткийОтклонена() Экспорт
	// та же политика в разделе «безопасность» дома «Аккаунт»
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
