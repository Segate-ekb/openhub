		Ответ = СоздатьЗеркало(Адрес,
			СтрШаблон("http://127.0.0.1:90%1/download/", Формат(Индекс, "ЧГ=0; ЧН=0")),
			КукаOwner, "600");
		Ожидаем.Что(УспехМутации(Ответ), СтрШаблон("зеркало %1 создано", Индекс)).ЭтоИстина();
	КонецЦикла;

