// Юнит-тесты компонента ТаблицаПрав: порядок действий текстом, резолв имени субъекта
// через СубъектыПрав, обе оси выдачи — «субъекты» и «объекты».

#Использовать asserts
#Использовать html-sanitizer
#Использовать "фикстуры"

Перем Таблица;   // экземпляр ТаблицаПрав
Перем UI;        // Структура компонентов (фикстура СборкаUI)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");

	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСубъектыПрав");
	ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогWebUI, "настройки", "общее"),
		"ТаблицаПрав.os"),
		"ТаблицаПрав");

	UI = Новый СборкаUI().Собрать(КаталогWebUI);
	Таблица = Новый ТаблицаПрав(UI.Кит, UI.Модели, Новый ФейкСубъектыПрав(), UI.Тексты);

КонецПроцедуры

&Тест
Процедура ДействияТекстомВЕдиномПорядкеЧтениеСозданиеИзменениеУдаление() Экспорт

	Ожидаем.Что(Таблица.ДействияТекстом(Грант("пользователь", 17, Истина, Истина, Истина, Истина)),
		"полный набор — единый порядок").Равно("чтение, создание, изменение, удаление");

	Ожидаем.Что(Таблица.ДействияТекстом(Грант("пользователь", 17, Истина, Ложь, Истина, Ложь)),
		"частичный набор сохраняет тот же порядок").Равно("чтение, изменение");

	Ожидаем.Что(Таблица.ДействияТекстом(Грант("пользователь", 17, Ложь, Истина, Ложь, Истина)),
		"набор без чтения начинается с создания").Равно("создание, удаление");

	Ожидаем.Что(Таблица.ДействияТекстом(Грант("пользователь", 17, Ложь, Ложь, Ложь, Ложь)),
		"пустой набор — прочерк").Равно("—");

КонецПроцедуры

&Тест
Процедура ОсьСубъектовРезолвитИмяИДержитЕдиныеКолонки() Экспорт

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Грант", Грант("пользователь", 17, Истина, Ложь, Ложь, Ложь)));
	Строки.Добавить(Новый Структура("Грант", Грант("группа", 5, Истина, Истина, Истина, Ложь)));

	HTML = Таблица.Таблица(Новый Структура("Строки, Пусто", Строки, "пусто")).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "alice") > 0, "пользователь резолвится в логин").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "team-autumn") > 0, "группа резолвится в имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">17<"), "сырой идентификатор не печатается").Равно(0);

	Ожидаем.Что(СтрНайти(HTML, ">Тип субъекта<") > 0, "колонка типа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Субъект<") > 0, "колонка субъекта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Действия<") > 0, "колонка действий").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, ">чтение, создание, изменение<") > 0,
		"действия группы единым порядком").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОсьОбъектовПечатаетОбъектИХвостПоФлагу() Экспорт

	HTML = Таблица.Таблица(Новый Структура("Строки, Ось, СХвостом, ХвостЗаголовок, Пусто",
		СтрокиОбъекта(), "объекты", Истина, "Где править", "пусто")).Рендер();

	Ожидаем.Что(СтрНайти(HTML, ">Объект<") > 0, "ось объектов — колонка объекта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Где править<") > 0, "заголовок хвоста из модели").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "пул-main") > 0, "объект в строке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/main/settings/visibility""") > 0,
		"хвост собран элементами вызывающего").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Субъект<"), "колонок субъекта на оси объектов нет").Равно(0);

	// элемент живёт в одном месте экрана, поэтому вторая таблица собирается своими строками
	БезХвоста = Таблица.Таблица(Новый Структура("Строки, Ось, Пусто",
		СтрокиОбъекта(), "объекты", "пусто")).Рендер();
	Ожидаем.Что(СтрНайти(БезХвоста, "href=""/main/settings/visibility"""),
		"хвост только по флагу СХвостом").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустаяВыдачаДаётТекстМоделиИДелегатИмениРаботает() Экспорт

	HTML = Таблица.Таблица(Новый Структура("Строки, Пусто",
		Новый Массив(), "Прав доступа нет.")).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "Прав доступа нет.") > 0, "текст пустой таблицы из модели").ЭтоИстина();

	Ожидаем.Что(Таблица.ИмяСубъекта("пользователь", 17), "делегат резолва").Равно("alice");

КонецПроцедуры

&Тест
Процедура ФлагСРольюМеняетКолонкуДействийНаРольИНеЛомаетСтарыеЭкраны() Экспорт

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Грант, Роль",
		Грант("пользователь", 17, Истина, Истина, Истина, Ложь), "райтер"));
	Строки.Добавить(Новый Структура("Грант, Роль",
		Грант("группа", 5, Истина, Ложь, Ложь, Ложь), ""));

	HTML = Таблица.Таблица(Новый Структура("Строки, СРолью, Пусто",
		Строки, Истина, "пусто")).Рендер();

	Ожидаем.Что(СтрНайти(HTML, ">Роль<") > 0, "колонка роли").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">Действия<"), "колонки действий больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, ">райтер<") > 0, "роль строки напечатана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">—<") > 0, "пустая роль — прочерк").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "чтение, создание, изменение"), "действия не печатаются").Равно(0);

КонецПроцедуры

&Тест
Процедура ПодписьРолиРазличаетВсеПятьРолей() Экспорт

	Ожидаем.Что(Таблица.ПодписьРоли("читатель"), "читатель").Равно("читатель");
	Ожидаем.Что(Таблица.ПодписьРоли("райтер"), "райтер").Равно("райтер");
	Ожидаем.Что(Таблица.ПодписьРоли("мейнтейнер"), "мейнтейнер").Равно("мейнтейнер");
	Ожидаем.Что(Таблица.ПодписьРоли("владелец"), "владелец").Равно("владелец");
	Ожидаем.Что(Таблица.ПодписьРоли("админ"), "админ хаба").Равно("админ хаба");

	Подписи = Новый Соответствие();
	Для Каждого ИмяРоли Из СтрРазделить("читатель,райтер,мейнтейнер,владелец,админ", ",") Цикл
		Подписи.Вставить(Таблица.ПодписьРоли(ИмяРоли), Истина);
	КонецЦикла;
	Ожидаем.Что(Подписи.Количество(), "пять ролей — пять разных подписей").Равно(5);

	Ожидаем.Что(Таблица.ПодписьРоли(""), "пустая роль — прочерк").Равно("—");
	Ожидаем.Что(Таблица.ПодписьРоли("кто-то"), "неизвестная роль — прочерк").Равно("—");

КонецПроцедуры

Функция Грант(Знач Тип, Знач Ид, Знач Чтение, Знач Создание, Знач Изменение, Знач Удаление)
	Возврат Новый Структура("ТипСубъекта, СубъектИдентификатор, Чтение, Создание, Изменение, Удаление",
		Тип, Ид, Чтение, Создание, Изменение, Удаление);
КонецФункции

Функция СтрокиОбъекта()
	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Грант, Объект, Хвост",
		Грант("группа", 5, Истина, Ложь, Ложь, Ложь),
		UI.Кит.Текст("пул-main"),
		Ссылка("/main/settings/visibility", "править")));
	Возврат Результат;
КонецФункции

Функция Ссылка(Знач Адрес, Знач Подпись)
	Результат = UI.Кит.Ссылка(Адрес);
	Результат.Добавить(UI.Кит.Текст(Подпись));
	Возврат Результат;
КонецФункции
