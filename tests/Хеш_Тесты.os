// Примитив основа/Хеш: единственное место, где содержимое становится sha256. Проверяется
// значение — эталонные векторы RFC 6234, совпадение трёх источников содержимого между
// собой и форма записи, на которую опираются ETag, манифест артефакта и хранение секретов.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Хеши;
Перем ВременныйКаталог;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);

КонецПроцедуры

&ПередКаждым
Процедура СобратьХеш() Экспорт
	Хеши = Новый Хеш();
	ВременныйКаталог = "";
КонецПроцедуры

&ПослеКаждого
Процедура УбратьВременное() Экспорт
	Если ЗначениеЗаполнено(ВременныйКаталог) И Новый Файл(ВременныйКаталог).Существует() Тогда
		УдалитьФайлы(ВременныйКаталог);
	КонецЕсли;
КонецПроцедуры

#Область ЭталонныеВекторы

&Тест
Процедура ПустоеСодержимоеДаётЭталонныйSha256() Экспорт

	Эталон = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";

	Ожидаем.Что(Хеши.ОтСтроки(""), "sha256 пустого входа — вектор из RFC 6234").Равно(Эталон);
	Ожидаем.Что(Хеши.ОтДанных(ПолучитьДвоичныеДанныеИзСтроки("")),
		"двоичный источник даёт тот же вектор").Равно(Эталон);

КонецПроцедуры

&Тест
Процедура ТриБуквыДаютЭталонныйSha256() Экспорт

	Ожидаем.Что(Хеши.ОтСтроки("abc"), "sha256 от «abc» — вектор из RFC 6234")
		.Равно("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");

КонецПроцедуры

&Тест
Процедура КириллицаХешируетсяВUTF8() Экспорт

	Ожидаем.Что(Хеши.ОтСтроки("привет"), "текст уходит в хеш байтами UTF-8")
		.Равно("e58f1e8c55fa105bdd3f40e5037eb0b039b5998d52c05e6cd98878dd2da5cab2");

КонецПроцедуры

#КонецОбласти

#Область ТриИсточникаОдноЗначение

&Тест
Процедура ТекстИЕгоБайтыДаютОдинХеш() Экспорт

	Образцы = Новый Массив();
	Образцы.Добавить("");
	Образцы.Добавить("abc");
	Образцы.Добавить("привет мир");
	Образцы.Добавить("тело" + Символы.ПС + "ответа");

	Для Каждого Образец Из Образцы Цикл
		Ожидаем.Что(Хеши.ОтСтроки(Образец),
			СтрШаблон("строка и её байты — один хеш: [%1]", Образец))
			.Равно(Хеши.ОтДанных(ПолучитьДвоичныеДанныеИзСтроки(Образец)));
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ФайлИЕгоСодержимоеДаютОдинХеш() Экспорт

	Содержимое = "содержимое артефакта" + Символы.ПС + "вторая строка";
	Путь = ЗаписатьВременныйФайл(Содержимое);

	Ожидаем.Что(Хеши.ОтФайла(Путь), "файл на диске и та же строка — один хеш")
		.Равно(Хеши.ОтСтроки(Содержимое));

КонецПроцедуры

#КонецОбласти

#Область ФормаЗаписи

&Тест
Процедура ЗаписьВсегдаШестьдесятЧетыреСтрочныхHexСимвола() Экспорт

	Значение = Хеши.ОтСтроки("Проверка Регистра ABCDEF");

	Ожидаем.Что(СтрДлина(Значение), "sha256 в hex — ровно 64 символа").Равно(64);
	Ожидаем.Что(Значение, "запись только строчными: на ней стоит сверка с ETag апстрима")
		.Равно(НРег(Значение));
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Ожидаем.Что(СтрНайти("0123456789abcdef", Сред(Значение, Позиция, 1)) > 0,
			СтрШаблон("символ %1 — hex", Позиция)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область КороткийОтпечаток

&Тест
Процедура ОтпечатокЭтоНачалоПолногоХеша() Экспорт

	Значение = "секретное значение токена";

	Ожидаем.Что(Хеши.Отпечаток(Значение), "отпечаток — префикс полного хеша")
		.Равно(Лев(Хеши.ОтСтроки(Значение), Хеши.ДлинаОтпечатка()));
	Ожидаем.Что(СтрДлина(Хеши.Отпечаток(Значение)), "длина отпечатка объявлена классом")
		.Равно(Хеши.ДлинаОтпечатка());

КонецПроцедуры

&Тест
Процедура РазныеЗначенияРазличимыОтпечатком() Экспорт

	Ожидаем.Что(Хеши.Отпечаток("токен-А") = Хеши.Отпечаток("токен-Б"),
		"два разных секрета отличаются отпечатком").ЭтоЛожь();
	Ожидаем.Что(Хеши.Отпечаток("токен-А"), "одинаковые секреты дают одинаковый отпечаток")
		.Равно(Хеши.Отпечаток("токен-А"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьВременныйФайл(Знач Содержимое)

	ВременныйКаталог = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-хеш-" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(ВременныйКаталог);

	Путь = ОбъединитьПути(ВременныйКаталог, "образец.bin");
	Байты = ПолучитьДвоичныеДанныеИзСтроки(Содержимое);
	Байты.Записать(Путь);

	Возврат Путь;

КонецФункции

#КонецОбласти
