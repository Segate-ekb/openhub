// Место лога в дереве экрана «Логи» и пути оператора: класс хаба — по месту своего файла,
// библиотека — по имени лога, ветка — целыми сегментами; путей ровно семь, по закрытым ключам.

#Использовать asserts
#Использовать "фикстуры"

&ТестовыйНабор
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Журнал = ОбъединитьПути(КаталогМодулей(), "наблюдаемость", "Классы");
	ПоискКлассов.Подключить(Журнал, "ГруппыЛогов");
	ПоискКлассов.Подключить(Журнал, "ПутиЖурнала");

КонецПроцедуры

#Область Группы

&Тест
Процедура КлассХабаВВеткеСвоегоМодуляИРаздела() Экспорт

	Ожидаем.Что(ГруппыХаба().Группа("СервисНастроек"), "модуль без раздела").Равно("хаб/настройки");
	Ожидаем.Что(ГруппыХаба().Группа("СервисАутентификации"), "модуль и раздел").Равно("хаб/вход/паролем");
	Ожидаем.Что(ГруппыХаба().Группа("ПультЖурнала"), "и сам пульт").Равно("хаб/наблюдаемость/журнал");

КонецПроцедуры

&Тест
Процедура ЛогиХабаМимоКлассовОсобняком() Экспорт
	Ожидаем.Что(ГруппыХаба().Группа("oshub.запуск")).Равно("хаб/oshub");
	Ожидаем.Что(ГруппыХаба().Группа("аудит")).Равно("хаб/oshub");
КонецПроцедуры

&Тест
Процедура БиблиотекаПоИмениЛога() Экспорт

	Ожидаем.Что(ГруппыХаба().Группа("oscript.lib.entity.pool"), "oscript.lib.<библиотека>").Равно("библиотеки/entity");
	Ожидаем.Что(ГруппыХаба().Группа("oscript.app.opm.Установка"), "oscript.app.<библиотека>").Равно("библиотеки/opm");
	Ожидаем.Что(ГруппыХаба().Группа("oscript.winow.x"), "oscript.<библиотека>").Равно("библиотеки/winow");
	Ожидаем.Что(ГруппыХаба().Группа("winow.router.СборщикМаршрутов"), "<библиотека>.*").Равно("библиотеки/winow");
	Ожидаем.Что(ГруппыХаба().Группа("logos-bridge"), "голое имя не классом хаба").Равно("библиотеки/?");

КонецПроцедуры

&Тест
Процедура ВеткаЦелымиСегментами() Экспорт

	Ожидаем.Что(ГруппыХаба().ВВетке("хаб/вход/паролем", "хаб/вход"), "раздел в модуле").ЭтоИстина();
	Ожидаем.Что(ГруппыХаба().ВВетке("хаб/вход", "хаб/вход"), "сама ветка").ЭтоИстина();
	Ожидаем.Что(ГруппыХаба().ВВетке("хаб/вход/паролем", "хаб/вхо"), "половина сегмента — не ветка").ЭтоЛожь();
	Ожидаем.Что(ГруппыХаба().ВВетке("хаб/вход", "хаб/вход/паролем"), "ветка шире лога").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БезКаталогаИсходниковКлассовХабаНет() Экспорт
	Ожидаем.Что(Новый ГруппыЛогов("").Группа("СервисНастроек"), "без дерева имя — библиотечное")
		.Равно("библиотеки/?");
КонецПроцедуры

#КонецОбласти

#Область Пути

&Тест
Процедура ПутейСемьПоЗакрытымКлючам() Экспорт

	Ключи = Новый Массив();
	Для Каждого Путь Из Новый ПутиЖурнала().Пути() Цикл
		Ключи.Добавить(Путь.Ключ);
		Ожидаем.Что(Путь.Логи.Количество() > 0, "путь " + Путь.Ключ + " называет логи").ЭтоИстина();
		Для Каждого Имя Из Путь.Логи Цикл
			Ожидаем.Что(ЗначениеЗаполнено(Имя) И СтрНайти(Имя, " ") = 0, "имя лога целое: «" + Имя + "»")
				.ЭтоИстина();
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Ключи, ","), "ключи экрана")
		.Равно("delivery,upstream,intake,publish,login,notifications,storage");

КонецПроцедуры

#КонецОбласти

// Группы над деревом исходников хаба.
Функция ГруппыХаба()
	Возврат Новый ГруппыЛогов(КаталогМодулей());
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции
