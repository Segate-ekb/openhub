// Живая приёмка адреса клиента за обратным прокси: два хаба на одной машине — один
// со списком доверенных сетей, другой без него. Наблюдаем снаружи: ведро ограничителя
// входа и запись «вход.заблокирован» в журнале аудита с объектом «адрес/…».

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем ЗаПрокси;        // ЭкземплярХаба — список доверенных сетей задан
Перем БезПрокси;       // ЭкземплярХаба — списка нет, заголовки не читаются
Перем КлиентЗаПрокси;  // КлиентХаба
Перем КлиентБезПрокси; // КлиентХаба
Перем КукаЗаПрокси;    // сессия администратора: экран журнала читается ею
Перем КукаБезПрокси;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабы() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	ЗаПрокси = ПоднятьХаб("openhub-за-прокси", "127.0.0.0/8, ::1/128");
	КлиентЗаПрокси = Новый КлиентХаба(ЗаПрокси);

	БезПрокси = ПоднятьХаб("openhub-без-прокси", "");
	КлиентБезПрокси = Новый КлиентХаба(БезПрокси);

	// сессия берётся ДО первых неудач: замок по адресу соединения иначе не дал бы войти
	// и прочитать журнал ровно там, где он и стал интересен
	КукаЗаПрокси = КлиентЗаПрокси.Войти("root", "RootPassw0rd");
	КукаБезПрокси = КлиентБезПрокси.Войти("root", "RootPassw0rd");

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХабы() Экспорт
	Если БезПрокси <> Неопределено Тогда
		БезПрокси.Остановить();
	КонецЕсли;
	Если ЗаПрокси <> Неопределено Тогда
		ЗаПрокси.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ЗаДовереннымПрокси

&Тест
Процедура ЗамокЛожитсяНаАдресЧеловекаАНеПрокси() Экспорт

	Перебрать(КлиентЗаПрокси, "198.51.100.9", 2);

	Журнал = ЖурналЗаПрокси("198.51.100.9");
	Ожидаем.Что(СтрНайти(Журнал, "адрес/198.51.100.9") > 0,
		"замок записан на адрес человека из заголовка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, "вход.заблокирован") > 0, "и это именно замок").ЭтоИстина();

	ПоСети = ЖурналЗаПрокси("198.51.100.0/24");
	Ожидаем.Что(СтрНайти(ПоСети, "адрес/198.51.100.9") > 0,
		"отбор по сети находит адреса сети").ЭтоИстина();

	Чужой = ЖурналЗаПрокси("203.0.113.7");
	Ожидаем.Что(СтрНайти(Чужой, "адрес/198.51.100.9"),
		"отбор по чужому адресу этой записи не показывает").Равно(0);

КонецПроцедуры

&Тест
Процедура ВёдраОграничителяРазведеныПоАдресуИзЗаголовка() Экспорт

	Перебрать(КлиентЗаПрокси, "198.51.100.30", 2);

	Ожидаем.Что(КодВхода(КлиентЗаПрокси, "198.51.100.30", "root", "RootPassw0rd"),
		"перебиравший адрес заперт даже с верным паролем").Равно(429);
	Ожидаем.Что(КодВхода(КлиентЗаПрокси, "203.0.113.31", "root", "RootPassw0rd"),
		"сосед по хабу входит: ведро у каждого адреса своё").Равно(200);

КонецПроцедуры

&Тест
Процедура ИзЦепочкиБерётсяПерваяСправаНеСвоегоПрокси() Экспорт

	// «5.5.5.5» пишет в заголовок сам клиент: прочитай хаб левую часть цепочки — и адрес
	// в ведре ограничителя выбирал бы перебирающий
	Перебрать(КлиентЗаПрокси, "5.5.5.5, 198.51.100.40, 127.0.0.1", 2);

	Ожидаем.Что(КодВхода(КлиентЗаПрокси, "198.51.100.40", "root", "RootPassw0rd"),
		"клиентом признана запись левее своих прокси").Равно(429);
	Ожидаем.Что(КодВхода(КлиентЗаПрокси, "5.5.5.5", "root", "RootPassw0rd"),
		"всё левее найденной записи не читается").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область БезСпискаДоверенных

&Тест
Процедура БезСпискаЗаголовокНеЧитаетсяВовсе() Экспорт

	Перебрать(КлиентБезПрокси, "198.51.100.50", 2);

	Ожидаем.Что(КодВхода(КлиентБезПрокси, "203.0.113.51", "root", "RootPassw0rd"),
		"заголовок не читается: заперт адрес соединения, а не адрес из заголовка").Равно(429);

	Журнал = Журнал(КлиентБезПрокси, КукаБезПрокси, "198.51.100.50");
	Ожидаем.Что(СтрНайти(Журнал, "адрес/198.51.100.50"),
		"адрес из заголовка в журнал не попал").Равно(0);

	// каким из двух петлевых адресов назовёт клиента веб-сервер, решает его стек:
	// на двойном стеке это «::1», на одиночном — «127.0.0.1». Важно, что это адрес
	// СОЕДИНЕНИЯ, а не присланный в заголовке
	Петлевой = Журнал(КлиентБезПрокси, КукаБезПрокси, "::1")
		+ Журнал(КлиентБезПрокси, КукаБезПрокси, "127.0.0.1");
	Ожидаем.Что(СтрНайти(Петлевой, "вход.заблокирован") > 0,
		"замок записан на петлевой адрес соединения").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ПоднятьХаб(Знач Префикс, Знач ДоверенныеСети)

	Хаб = Новый ЭкземплярХаба(90);

	Хаб.ФайловаяБаза(Префикс);
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");
	Хаб.Среда("OSHUB_AUTH_LOGIN_MAXATTEMPTS", "2");
	Хаб.Среда("OSHUB_INSTANCE_TRUSTED_PROXIES", ДоверенныеСети);

	Сидер = ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры");
	Хаб.ЗапуститьСидер(ОбъединитьПути(Сидер, "ЗасеятьКабинет.os"));
	Хаб.Запустить();

	Возврат Хаб;

КонецФункции

// Неудачные входы с одного адреса. Логин каждый раз новый: запирать нужно адрес,
// а не учётку, иначе замок учётки объяснял бы отказ вместо замка адреса.
Процедура Перебрать(Знач Клиент, Знач Цепочка, Знач Сколько)

	Для Сч = 1 По Сколько Цикл
		КодВхода(Клиент, Цепочка, "нет-такого-" + Строка(Новый УникальныйИдентификатор), "неверный");
	КонецЦикла;

КонецПроцедуры

Функция КодВхода(Знач Клиент, Знач Цепочка, Знач Логин, Знач Пароль)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("X-Forwarded-For", Цепочка);

	Запрос = Новый HTTPЗапрос("/api/v1/login", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль),
		КодировкаТекста.UTF8);

	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос).КодСостояния;

КонецФункции

Функция ЖурналЗаПрокси(Знач Отбор)
	Возврат Журнал(КлиентЗаПрокси, КукаЗаПрокси, Отбор);
КонецФункции

Функция Журнал(Знач Клиент, Знач Кука, Знач Отбор)
	Путь = "/hub/settings/audit?ip="
		+ КодироватьСтроку(Отбор, СпособКодированияСтроки.URLEncoding);
	Возврат Клиент.Тело(Клиент.GETСКукой(Путь, Кука));
КонецФункции

#КонецОбласти
