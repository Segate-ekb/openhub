// Юнит-тесты S3-хранилища артефактов на in-memory фейке шва КлиентS3 (без сети, без oint):
// раскладка ключей, sha256, квоты, перезапись, выход за корень, юникод, опись, префикс бакета.

#Использовать asserts
#Использовать tempfiles
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем ЭталонSha256; // Строка - sha256 строки "hello" (utf-8, без BOM)

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ЭталонSha256 = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824";

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"), "хранилище", "Классы");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "КоординатыАртефакта.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "РаскладкаКлючейS3.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "КвотаХранилища.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "ПомощникАртефакта.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "..", ".."),
		"основа", "Классы", "ТихаяУборка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "S3Хранилище.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкКлиентS3.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ПоддельныеКоординаты.os"));

КонецПроцедуры

#Область СохранениеИЧтение

&Тест
Процедура СохранениеИзДвоичныхДанныхКладетОбъектПоКаноническомуКлючу() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент);
	Координаты = Новый КоординатыАртефакта("main", "gitrunner", "1.9.3");

	Результат = Хранилище.Сохранить(Координаты, ДанныеHello());

	Ожидаем.Что(Результат.Sha256).Равно(ЭталонSha256);
	Ожидаем.Что(Результат.Размер).Равно(5);

	Опись = Клиент.Перечислить("");
	Ожидаем.Что(Опись.Количество()).Равно(1);
	Ожидаем.Что(Опись[0].Ключ).Равно("pools/main/gitrunner/gitrunner-1.9.3.ospx");

КонецПроцедуры

&Тест
Процедура СохранениеИзФайлаДаетТотЖеРезультат() Экспорт

	ФайлИсточника = ВременныеФайлы.НовоеИмяФайла("bin");
	ДанныеHello().Записать(ФайлИсточника);

	Хранилище = НовоеХранилище();
	Результат = Хранилище.Сохранить(Координаты111(), ФайлИсточника);

	Ожидаем.Что(Результат.Sha256).Равно(ЭталонSha256);
	Ожидаем.Что(Результат.Размер).Равно(5);
	Ожидаем.Что(Новый Файл(ФайлИсточника).Существует(), "файл-источник должен остаться на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолучитьВозвращаетВременныйФайлСИсходнымСодержимым() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Путь = Хранилище.Получить(Координаты111());

	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь))).Равно("hello");

КонецПроцедуры

&Тест
Процедура ПолучитьДанныеВозвращаетСодержимое() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Данные = Хранилище.ПолучитьДанные(Координаты111());

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Данные)).Равно("hello");

КонецПроцедуры

&Тест
Процедура СверкаВернойКонтрольнойСуммыПроходит() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Путь = Хранилище.Получить(Координаты111(), ВРег(ЭталонSha256));
	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоИстина();

	// та же сверка для ПолучитьДанные
	Данные = Хранилище.ПолучитьДанные(Координаты111(), ЭталонSha256);
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Данные)).Равно("hello");

КонецПроцедуры

&Тест
Процедура СверкаНевернойКонтрольнойСуммыПадает() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	НевернаяСумма = СтрЗаменить(ЭталонSha256, "2", "3");

	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "Получить", Координаты111(), НевернаяСумма))
		.Содержит("не совпадает");
	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "ПолучитьДанные", Координаты111(), НевернаяСумма))
		.Содержит("не совпадает");

КонецПроцедуры

&Тест
Процедура ПолучениеОтсутствующегоАртефактаПадает() Экспорт

	Хранилище = НовоеХранилище();

	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "Получить", Координаты111(), ""))
		.Содержит("не найден");
	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "ПолучитьДанные", Координаты111(), ""))
		.Содержит("не найден");

КонецПроцедуры

&Тест
Процедура ПустойАртефактНольБайтСохраняетсяКорректно() Экспорт

	Хранилище = НовоеХранилище();

	Результат = Хранилище.Сохранить(Координаты111(), Данные(""));

	Ожидаем.Что(Результат.Sha256)
		.Равно("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
	Ожидаем.Что(Результат.Размер).Равно(0);
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();
	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(0);
	Ожидаем.Что(Хранилище.ПолучитьДанные(Координаты111()).Размер()).Равно(0);

КонецПроцедуры

&Тест
Процедура ЮникодноеИмяПакетаСохраняетсяИЧитается() Экспорт

	Хранилище = НовоеХранилище();
	Координаты = Новый КоординатыАртефакта("пул-приватный", "пакет-тест", "1.0.0");

	Хранилище.Сохранить(Координаты, ДанныеHello());

	Ожидаем.Что(Хранилище.Существует(Координаты)).ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты))).Равно("hello");

КонецПроцедуры

#КонецОбласти

#Область СуществованиеУдалениеРазмер

&Тест
Процедура СуществуетОтражаетНаличиеИУдалениеИдемпотентно() Экспорт

	Хранилище = НовоеХранилище();

	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();

	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();

	// повторное удаление — не ошибка
	Хранилище.Удалить(Координаты111());

КонецПроцедуры

&Тест
Процедура РазмерОтсутствующегоАртефактаПадает() Экспорт

	Хранилище = НовоеХранилище();

	БылоИсключение = Ложь;
	Попытка
		Хранилище.Размер(Координаты111());
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение, "ожидали исключение на размере отсутствующего артефакта").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗанятыйОбъемСуммируетВсеАртефакты() Экспорт

	Хранилище = НовоеХранилище();

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                    // 5 байт
	Хранилище.Сохранить(Новый КоординатыАртефакта("другой", "пакет", "2.0.0"), Данные("abc")); // 3 байта

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(8);

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(3);

КонецПроцедуры

&Тест
Процедура ОбъёмПулаСчитаетВсёПодПрефиксомПулаИТолькоЕго() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент);

	Ожидаем.Что(Хранилище.ОбъёмПула("main"), "пула ещё нет — не ошибка, а ноль").Равно(0);

	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "lib", "1.0.0"), ДанныеHello()); // 5
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "app", "2.0.0"), Данные("abc")); // 3
	Хранилище.Сохранить(Новый КоординатыАртефакта("other", "lib", "1.0.0"), Данные("xy")); // 2
	// объект мимо раскладки координат: описи он не виден, а место занимает
	Клиент.Положить("pools/main/мимо-раскладки.bin", Данные("zzzz")); // 4

	Ожидаем.Что(Хранилище.ОбъёмПула("main"), "всё под префиксом пула, включая ключ мимо раскладки")
		.Равно(12);
	Ожидаем.Что(Хранилище.ОбъёмПула("other"), "соседний пул считается отдельно").Равно(2);
	Ожидаем.Что(Хранилище.ОбъёмПула("../.."), "небезопасное имя — ноль, а не обход префикса").Равно(0);

КонецПроцедуры

&Тест
Процедура ОбъёмПулаНеПутаетПулыСОбщимНачаломИмени() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "lib", "1.0.0"), ДанныеHello());  // 5
	Хранилище.Сохранить(Новый КоординатыАртефакта("main-2", "lib", "1.0.0"), Данные("abc")); // 3

	Ожидаем.Что(Хранилище.ОбъёмПула("main"), "префикс замера закрыт слешем: main-2 в main не входит")
		.Равно(5);

КонецПроцедуры

&Тест
Процедура ОбъёмыПуловСнимаютВсеПулыОднимЛистингом() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент, "инст1");

	Ожидаем.Что(Хранилище.ОбъёмыПулов().Количество(), "пустой бакет — пустой снимок").Равно(0);

	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "lib", "1.0.0"), ДанныеHello()); // 5
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "app", "2.0.0"), Данные("abc")); // 3
	Хранилище.Сохранить(Новый КоординатыАртефакта("cache", "lib", "9.9.9"), Данные("xy")); // 2
	// чужая инсталляция в том же бакете: её префикс замеру не принадлежит
	Клиент.Положить("инст2/pools/main/lib/lib-1.0.0.ospx", Данные("чужое"));

	Снимок = Хранилище.ОбъёмыПулов();

	Ожидаем.Что(Снимок.Количество(), "в снимке ровно два своих пула").Равно(2);
	Ожидаем.Что(Снимок.Получить("main"), "объём первого пула").Равно(8);
	Ожидаем.Что(Снимок.Получить("cache"), "объём второго пула").Равно(2);
	Ожидаем.Что(Снимок.Получить("main"), "снимок согласован с поштучным замером")
		.Равно(Хранилище.ОбъёмПула("main"));

КонецПроцедуры

#КонецОбласти

#Область Перезапись

&Тест
Процедура ПерезаписьЗаменяетСодержимоеЦеликом() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Результат = Хранилище.Сохранить(Координаты111(), Данные("новое содержимое"));

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты111())))
		.Равно("новое содержимое");
	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(Результат.Размер);
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(Результат.Размер);

КонецПроцедуры

&Тест
Процедура НеподдерживаемыйТипИсточникаПадаетБезСледов() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент);

	БылоИсключение = Ложь;
	Попытка
		Хранилище.Сохранить(Координаты111(), 12345);
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();
	Ожидаем.Что(Клиент.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Квоты

&Тест
Процедура ПревышениеКвотыПадаетПонятнойОшибкойИНеОставляетСледов() Экспорт

	Хранилище = НовоеХранилище(8);
	Хранилище.Сохранить(Координаты111(), ДанныеHello()); // 5 из 8

	Вторые = Новый КоординатыАртефакта("пул", "пакет", "2.0.0");

	ТекстОшибки = "";
	Попытка
		Хранилище.Сохранить(Вторые, Данные("1234")); // 5 + 4 > 8
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "квота") > 0,
		"ожидали понятную ошибку о квоте, получили: " + ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Вторые), "артефакт сверх квоты не должен появиться").ЭтоЛожь();
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СохранениеВПределахКвотыПроходит() Экспорт

	Хранилище = НовоеХранилище(8);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                    // 5 из 8
	Хранилище.Сохранить(Новый КоординатыАртефакта("пул", "пакет", "2.0.0"), Данные("123")); // ровно 8

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(8);

КонецПроцедуры

&Тест
Процедура ПерезаписьУчитываетОсвобождаемыйОбъем() Экспорт

	Хранилище = НовоеХранилище(10);
	Хранилище.Сохранить(Координаты111(), Данные("12345678")); // 8 из 10

	Хранилище.Сохранить(Координаты111(), Данные("123456789")); // 8 - 8 + 9 = 9 <= 10

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(9);

КонецПроцедуры

&Тест
Процедура НулеваяКвотаОзначаетБезЛимита() Экспорт

	Хранилище = НовоеХранилище(0);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтрицательнаяКвотаОтклоняетсяКакМиссконфигурация() Экспорт

	ТекстОшибки = "";
	Попытка
		Хранилище = НовоеХранилище(-1);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "квота") > 0,
		"ожидали исключение о некорректной квоте, получили: " + ТекстОшибки).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗащитаОтВыходаЗаКорень

&Тест
Процедура КоординатыСОбходомКорняОтклоняютсяХранилищем() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент);

	ОжидатьОтказТраверсал(Хранилище, Новый ПоддельныеКоординаты("..", "..", "1.0.0", "побег.ospx"));
	ОжидатьОтказТраверсал(Хранилище, Новый ПоддельныеКоординаты("пул", "..", "1.0.0", ".."));
	ОжидатьОтказТраверсал(Хранилище,
		Новый ПоддельныеКоординаты("../../../..", "пакет", "1.0.0", "побег.ospx"));
	// разделитель внутри компоненты также запрещён
	ОжидатьОтказТраверсал(Хранилище,
		Новый ПоддельныеКоординаты("пул", "па/кет", "1.0.0", "имя.ospx"));

	Ожидаем.Что(Клиент.Количество(), "в хранилище ничего не должно попасть").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПрефиксИОпись

&Тест
Процедура ПрефиксБакетаДобавляетсяККлючу() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент, "openhub/prod/");
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "пакет", "1.0.0"), ДанныеHello());

	Опись = Клиент.Перечислить("");
	Ожидаем.Что(Опись[0].Ключ).Равно("openhub/prod/pools/main/пакет/пакет-1.0.0.ospx");
	// и через прикладную опись пул виден корректно
	ОписьПула = Хранилище.Опись("main");
	Ожидаем.Что(ОписьПула.Количество()).Равно(1);
	Ожидаем.Что(ОписьПула[0].Пул).Равно("main");
	Ожидаем.Что(ОписьПула[0].Пакет).Равно("пакет");
	Ожидаем.Что(ОписьПула[0].ИмяФайла).Равно("пакет-1.0.0.ospx");
	Ожидаем.Что(ОписьПула[0].Размер).Равно(5);

КонецПроцедуры

&Тест
Процедура ОписьВозвращаетТолькоСвойПулИУдалитьФайлРаботает() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "a", "1.0.0"), ДанныеHello());
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "b", "2.0.0"), Данные("xy"));
	Хранилище.Сохранить(Новый КоординатыАртефакта("other", "c", "3.0.0"), Данные("z"));

	ОписьMain = Хранилище.Опись("main");
	Ожидаем.Что(ОписьMain.Количество(), "в пуле main два артефакта").Равно(2);

	// удаление одного файла по компонентам (для GC прокси-кэша)
	Хранилище.УдалитьФайл("main", "a", "a-1.0.0.ospx");
	Ожидаем.Что(Хранилище.Опись("main").Количество()).Равно(1);
	// повторное удаление — не ошибка
	Хранилище.УдалитьФайл("main", "a", "a-1.0.0.ospx");

	// опись отсутствующего/пустого пула — пусто, не ошибка
	Ожидаем.Что(Хранилище.Опись("").Количество()).Равно(0);
	Ожидаем.Что(Хранилище.Опись("нет-такого").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура БэкендСообщаетS3() Экспорт
	Ожидаем.Что(НовоеХранилище().Бэкенд()).Равно("s3");
КонецПроцедуры

#КонецОбласти

#Область ВременныеКопииВыдачи

&Тест
Процедура ПолучитьСоздаётВременнуюКопиюОсвободитьЕёУдаляет() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Путь = Хранилище.Получить(Координаты111());
	Ожидаем.Что(Новый Файл(Путь).Существует(), "временная копия создана").ЭтоИстина();
	Ожидаем.Что(Хранилище.ЧислоВыданныхКопий(), "копия числится невозвращённой").Равно(1);

	Хранилище.ОсвободитьВыдачу(Путь);
	Ожидаем.Что(Новый Файл(Путь).Существует(), "после освобождения временный файл удалён").ЭтоЛожь();
	Ожидаем.Что(Хранилище.ЧислоВыданныхКопий()).Равно(0);

КонецПроцедуры

&Тест
Процедура ПовторныеВыдачиСОсвобождениемНеНакапливаютВременныеФайлы() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Пути = Новый Массив();
	Для Н = 1 По 5 Цикл
		Путь = Хранилище.Получить(Координаты111());
		Пути.Добавить(Путь);
		Хранилище.ОсвободитьВыдачу(Путь);
		// на каждом шаге незакрытых копий не остаётся
		Ожидаем.Что(Хранилище.ЧислоВыданныхКопий(), "нет накопления временных копий").Равно(0);
	КонецЦикла;

	// ни один из выданных временных файлов не остался на диске
	Для Каждого Путь Из Пути Цикл
		Ожидаем.Что(Новый Файл(Путь).Существует(),
			СтрШаблон("временный файл %1 не должен оставаться", Путь)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОсвободитьВыдачуИдемпотентнаИБезопаснаКЧужомуПути() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	Путь = Хранилище.Получить(Координаты111());

	// повторное освобождение — не ошибка
	Хранилище.ОсвободитьВыдачу(Путь);
	Хранилище.ОсвободитьВыдачу(Путь);

	// пустой и неизвестный путь — не ошибка и ничего постороннего не трогают
	Хранилище.ОсвободитьВыдачу("");
	ЧужойФайл = ВременныеФайлы.НовоеИмяФайла("keep");
	ДанныеHello().Записать(ЧужойФайл);
	Хранилище.ОсвободитьВыдачу(ЧужойФайл);
	Ожидаем.Что(Новый Файл(ЧужойФайл).Существует(),
		"освобождение не должно удалять файл вне реестра выданных копий").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПределЛистинга

// ВАЖНО-2: из-за бага подписи query в oint 2.3.0 (?prefix= со слешем ломает SigV4)
// листинг идёт по ВЕДУЩЕМУ сегменту (pools) со свежими 250 на страницу; при
// превышении постраничный токен ловит тот же баг -> реальный клиент падает.
// Здесь фейк эмулирует этот предел. Тесты фиксируют: на масштабе сверх предела
// ЗанятыйОбъем/Опись ПАДАЮТ (fail-loud), а не тихо недосчитывают квоту.

&Тест
Процедура ЛистингСверхПределаПадаетFailLoudАНеНедосчитывает() Экспорт

	// предел 5, кладём 6 артефактов в разные пулы/пакеты — все под ведущим "pools"
	Клиент = Новый ФейкКлиентS3(5);
	Хранилище = Новый S3Хранилище(Клиент, "", 0);
	Для Н = 1 По 6 Цикл
		Хранилище.Сохранить(Новый КоординатыАртефакта("пул" + Н, "пакет", "1.0.0"), ДанныеHello());
	КонецЦикла;

	// ЗанятыйОбъем (квота-предпроверка на publish) — исключение, не частичная сумма
	Ожидаем.Что(ПадаетСИсключением(Хранилище, "ЗанятыйОбъем", ""),
		"ЗанятыйОбъем сверх предела листинга обязан падать, а не тихо недосчитывать").ЭтоИстина();

	// Опись (GC прокси-кэша) — тоже fail-loud
	Ожидаем.Что(ПадаетСИсключением(Хранилище, "Опись", "пул1"),
		"Опись сверх предела листинга обязана падать").ЭтоИстина();

	// ОбъёмПула и ОбъёмыПулов (замер занятого для счётчиков пулов) — тоже fail-loud:
	// тихий ноль на экране настроек хуже отказа, по нему принимают решения о квоте
	Ожидаем.Что(ПадаетСИсключением(Хранилище, "ОбъёмПула", "пул1"),
		"ОбъёмПула сверх предела листинга обязан падать, а не тихо недосчитывать").ЭтоИстина();
	Ожидаем.Что(ПадаетСИсключением(Хранилище, "ОбъёмыПулов", ""),
		"снимок объёмов сверх предела листинга обязан падать целиком").ЭтоИстина();

	// а следующее Сохранить (с квотой) не должно «пройти мимо» из-за упавшего ЗанятыйОбъем
	Хранилище2 = Новый S3Хранилище(Новый ФейкКлиентS3(5), "", 1000000);
	Для Н = 1 По 6 Цикл
		Хранилище2.Сохранить(Новый КоординатыАртефакта("p" + Н, "пакет", "1.0.0"), ДанныеHello());
	КонецЦикла;
	// 7-й сохраняемый с включённой квотой требует ЗанятыйОбъем -> падение (fail-loud),
	// т.е. публикация НЕ обходит квоту тихо
	БылоИсключение = Ложь;
	Попытка
		Хранилище2.Сохранить(Новый КоординатыАртефакта("p7", "пакет", "1.0.0"), ДанныеHello());
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, "publish с квотой сверх предела листинга обязан падать, а не обходить квоту").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЛистингВПределеРаботаетКорректно() Экспорт

	Клиент = Новый ФейкКлиентS3(10);
	Хранилище = Новый S3Хранилище(Клиент, "", 0);
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "a", "1.0.0"), ДанныеHello()); // 5
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "b", "2.0.0"), Данные("xy"));  // 2

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(7);
	Ожидаем.Что(Хранилище.Опись("main").Количество()).Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СносОбластиПула

// Область пула сносится ПЕРЕЧИСЛЕНИЕМ префикса, а не описью: опись отбрасывает ключи,
// не разобравшиеся в координаты, и такой объект остался бы в бакете навсегда — строки
// пула уже нет, позвать его некому, а квоту он занимать продолжит.
&Тест
Процедура СносОбластиУноситИКлючиНеРазобравшиесяВКоординаты() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент);

	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "lib", "1.0.0"), Данные("a"));
	// объект мимо раскладки: положен не хабом либо остался от прежнего формата ключей
	Клиент.Положить("pools/main/мимо-раскладки.bin", Данные("b"));

	Ожидаем.Что(Хранилище.Опись("main").Количество(),
		"опись видит только разобравшийся ключ").Равно(1);

	Снято = Хранилище.УдалитьОбластьПула("main");

	Ожидаем.Что(Снято, "снесены ОБА объекта области, а не только описанный").Равно(2);
	Ожидаем.Что(Клиент.Перечислить("pools/main/").Количество(),
		"под префиксом пула не осталось ни одного ключа").Равно(0);

КонецПроцедуры

// Имя пула входит в префикс ключей, поэтому снос области обязан отделяться разделителем:
// иначе пул «main» уносил бы объекты пула «main2».
&Тест
Процедура СносОбластиНеТрогаетПулСОбщимПрефиксомИмени() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент);

	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "lib", "1.0.0"), Данные("a"));
	Хранилище.Сохранить(Новый КоординатыАртефакта("main2", "lib", "1.0.0"), Данные("b"));

	Ожидаем.Что(Хранилище.УдалитьОбластьПула("main"), "снесён ровно один объект").Равно(1);

	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("main2", "lib", "1.0.0")),
		"объект пула main2 НЕ снят удалением области пула main").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("main", "lib", "1.0.0")),
		"а объект пула main снят").ЭтоЛожь();

КонецПроцедуры

// Префикс бакета учитывается: без него снос ушёл бы мимо чужой инсталляции в том же бакете.
// Пустое и небезопасное имя пула области не сносят вовсе.
&Тест
Процедура СносОбластиУважаетПрефиксБакетаИОтвергаетНебезопасноеИмя() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент, "openhub/prod/");

	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "lib", "1.0.0"), Данные("a"));
	Клиент.Положить("pools/main/чужая-инсталляция.ospx", Данные("b"));

	Ожидаем.Что(Хранилище.УдалитьОбластьПула("main"), "снесён только свой объект").Равно(1);
	Ожидаем.Что(Клиент.Существует("pools/main/чужая-инсталляция.ospx"),
		"объект вне префикса инсталляции не тронут").ЭтоИстина();

	Ожидаем.Что(Хранилище.УдалитьОбластьПула(""), "пустое имя пула области не сносит").Равно(0);
	Ожидаем.Что(Хранилище.УдалитьОбластьПула("../../побег"),
		"небезопасное имя пула области не сносит").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция НовоеХранилище(Знач Квота = 0)
	Возврат Новый S3Хранилище(Новый ФейкКлиентS3(), "", Квота);
КонецФункции

Функция ПадаетСИсключением(Знач Хранилище, Знач ИмяМетода, Знач Аргумент)
	Попытка
		Если ИмяМетода = "ЗанятыйОбъем" Тогда
			Хранилище.ЗанятыйОбъем();
		ИначеЕсли ИмяМетода = "ОбъёмПула" Тогда
			Хранилище.ОбъёмПула(Аргумент);
		ИначеЕсли ИмяМетода = "ОбъёмыПулов" Тогда
			Хранилище.ОбъёмыПулов();
		Иначе
			Хранилище.Опись(Аргумент);
		КонецЕсли;
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция Координаты111()
	Возврат Новый КоординатыАртефакта("пул", "пакет", "1.1.1");
КонецФункции

Функция Данные(Знач Текст)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст);
КонецФункции

Функция ДанныеHello()
	Возврат Данные("hello");
КонецФункции

Функция ТекстОшибкиЧтения(Знач Хранилище, Знач ИмяМетода, Знач Координаты, Знач Сумма)

	ТекстОшибки = "";
	Попытка
		Если ИмяМетода = "Получить" Тогда
			Хранилище.Получить(Координаты, Сумма);
		Иначе
			Хранилище.ПолучитьДанные(Координаты, Сумма);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат ТекстОшибки;

КонецФункции

Процедура ОжидатьОтказТраверсал(Знач Хранилище, Знач Координаты)

	ТекстОшибки = "";
	Попытка
		Хранилище.Сохранить(Координаты, ДанныеHello());
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "за пределы корня") > 0,
		СтрШаблон("ожидали отказ ""за пределы корня"" на координатах %1, получили: %2",
			Координаты.Представление(), ТекстОшибки))
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти
