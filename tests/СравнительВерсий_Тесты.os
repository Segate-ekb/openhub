// Юнит-тесты разбора и сравнения версий (РазобраннаяВерсия, СравнительВерсий):
// semver 2.0.0, legacy 4-компонентные и единый порядок сравнения смешанных списков.

#Использовать asserts

Перем КаталогКлассов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт
	ПодключитьКлассыРеестра();
КонецПроцедуры

// Разбор

&Тест
Процедура РазбираетSemverВерсиюВКомпоненты() Экспорт

	Версия = Сравнитель().Разобрать("1.2.3-rc.1+build.5");

	Ожидаем.Что(Версия.Мажор).Равно(1);
	Ожидаем.Что(Версия.Минор).Равно(2);
	Ожидаем.Что(Версия.Патч).Равно(3);
	Ожидаем.Что(Версия.Четвертая, "у semver-версии нет четвёртой компоненты").Равно(0);
	Ожидаем.Что(Версия.Пререлиз).Равно("rc.1");
	Ожидаем.Что(Версия.МетаданныеСборки).Равно("build.5");
	Ожидаем.Что(Версия.ПризнакLegacy).Равно(Ложь);
	Ожидаем.Что(Версия.ЕстьПререлиз()).Равно(Истина);
	Ожидаем.Что(Версия.ВСтроку(), "исходная строка - источник истины").Равно("1.2.3-rc.1+build.5");

КонецПроцедуры

&Тест
Процедура РазбираетLegacyВерсиюВКомпоненты() Экспорт

	Версия = Сравнитель().Разобрать("1.2.3.4");

	Ожидаем.Что(Версия.Мажор).Равно(1);
	Ожидаем.Что(Версия.Минор).Равно(2);
	Ожидаем.Что(Версия.Патч).Равно(3);
	Ожидаем.Что(Версия.Четвертая).Равно(4);
	Ожидаем.Что(Версия.Пререлиз, "legacy-хвост - не пререлиз").Равно("");
	Ожидаем.Что(Версия.ПризнакLegacy).Равно(Истина);
	Ожидаем.Что(Версия.ЕстьПререлиз()).Равно(Ложь);
	Ожидаем.Что(Версия.ВСтроку()).Равно("1.2.3.4");

КонецПроцедуры

&Тест
Процедура РазбираетНеполныеИПрефиксныеВерсии() Экспорт

	// префикс v отбрасывается (поведение библиотеки semver), исходная строка сохраняется
	Версия = Сравнитель().Разобрать("v1.2.3");
	Ожидаем.Что(Версия.Мажор).Равно(1);
	Ожидаем.Что(Версия.ВСтроку()).Равно("v1.2.3");

	// неполные версии достраиваются нулями
	Короткая = Сравнитель().Разобрать("1.2");
	Ожидаем.Что(Короткая.Патч).Равно(0);
	Ожидаем.Что(Короткая.Минор).Равно(2);

КонецПроцедуры

&Тест
Процедура ОтклоняетМусорныеВерсии() Экспорт

	Мусор = СтрРазделить(
		"abc|1.2.3.4.5|1.2.3-|1.2.3.4-rc.1|a.b.c|1.2.x|1..3|-1.2.3|1,2,3", "|");

	Для Каждого Строка Из Мусор Цикл
		Ожидаем.Что(Сравнитель().ВерсияКорректна(Строка),
			СтрШаблон("версия ""%1"" должна отклоняться", Строка)).ЭтоЛожь();
		Ожидаем.Что(Сравнитель().ПопытатьсяРазобрать(Строка),
			СтрШаблон("ПопытатьсяРазобрать(""%1"")", Строка)).Равно(Неопределено);
	КонецЦикла;

	// пустая строка и не-строка
	Ожидаем.Что(Сравнитель().ВерсияКорректна("")).ЭтоЛожь();
	Ожидаем.Что(Сравнитель().ВерсияКорректна("   ")).ЭтоЛожь();
	Ожидаем.Что(Сравнитель().ВерсияКорректна(Неопределено)).ЭтоЛожь();
	Ожидаем.Что(Сравнитель().ВерсияКорректна(123)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РазобратьМусорБросаетИсключение() Экспорт

	ОписаниеОшибки = "";
	Попытка
		Сравнитель().Разобрать("не-версия");
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(ОписаниеОшибки) > 0, "исключение с текстом про некорректную версию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОписаниеОшибки, "не-версия") > 0, "текст ошибки называет версию").ЭтоИстина();

КонецПроцедуры

// Порядок semver (спецификация 2.0.0, п.11)

&Тест
Процедура ПорядокПререлизовПоСпецификации() Экспорт

	// 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta < 1.0.0-beta
	//   < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0-rc.1 < 1.0.0
	Цепочка = СтрРазделить(
		"1.0.0-alpha|1.0.0-alpha.1|1.0.0-alpha.beta|1.0.0-beta|1.0.0-beta.2|1.0.0-beta.11|1.0.0-rc.1|1.0.0", "|");

	Для Индекс = 0 По Цепочка.ВГраница() - 1 Цикл
		Младшая = Цепочка[Индекс];
		Старшая = Цепочка[Индекс + 1];
		Ожидаем.Что(Сравнитель().Сравнить(Младшая, Старшая),
			СтрШаблон("%1 < %2", Младшая, Старшая)).Равно(-1);
		Ожидаем.Что(Сравнитель().Сравнить(Старшая, Младшая),
			СтрШаблон("%1 > %2", Старшая, Младшая)).Равно(1);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЧисловыеКомпонентыСравниваютсяЧислами() Экспорт

	Ожидаем.Что(Сравнитель().Сравнить("1.10.0", "1.9.0"), "минор 10 > 9").Равно(1);
	Ожидаем.Что(Сравнитель().Сравнить("1.2.10", "1.2.2"), "патч 10 > 2").Равно(1);
	Ожидаем.Что(Сравнитель().Сравнить("10.0.0", "9.0.0"), "мажор 10 > 9").Равно(1);

КонецПроцедуры

&Тест
Процедура МетаданныеСборкиНеВлияютНаПорядок() Экспорт

	Ожидаем.Что(Сравнитель().Сравнить("1.0.0+build.1", "1.0.0+build.999")).Равно(0);
	Ожидаем.Что(Сравнитель().Сравнить("1.0.0-rc.1+build.1", "1.0.0-rc.1")).Равно(0);
	Ожидаем.Что(Сравнитель().Сравнить("1.0.0+build", "1.0.0")).Равно(0);

КонецПроцедуры

// Порядок legacy и смешанный порядок

&Тест
Процедура LegacyСравниваютсяПокомпонентноЧислами() Экспорт

	Ожидаем.Что(Сравнитель().Сравнить("1.2.3.10", "1.2.3.4"), "10 > 4 числом, не строкой").Равно(1);
	Ожидаем.Что(Сравнитель().Сравнить("1.2.3.4", "1.2.3.4")).Равно(0);
	Ожидаем.Что(Сравнитель().Сравнить("1.2.3.4", "1.2.4.0")).Равно(-1);
	Ожидаем.Что(Сравнитель().Сравнить("2.0.0.1", "1.9.9.9")).Равно(1);

КонецПроцедуры

&Тест
Процедура LegacyСтаршеТрёхкомпонентнойВерсии() Экспорт

	// контракт LegacyВерсияЧетыреКомпонентыУкладываетсяВМодель: 1.2.3.4 СТАРШЕ 1.2.3
	Ожидаем.Что(Сравнитель().Сравнить("1.2.3.4", "1.2.3")).Равно(1);
	Ожидаем.Что(Сравнитель().Сравнить("1.2.3", "1.2.3.4")).Равно(-1);

	// зафиксированное решение: явный ноль четвёртой компоненты равен её отсутствию
	Ожидаем.Что(Сравнитель().Сравнить("1.2.3.0", "1.2.3")).Равно(0);

КонецПроцедуры

&Тест
Процедура СмешанныйПорядокSemverИLegacy() Экспорт

	// порядок из спайка 0.B (СортировкаСмешанногоСписка):
	// 1.2.3 < 1.2.3.4 < 1.2.4-rc.1 < 1.2.4
	Цепочка = СтрРазделить("1.2.3|1.2.3.4|1.2.4-rc.1|1.2.4", "|");

	Для Индекс = 0 По Цепочка.ВГраница() - 1 Цикл
		Ожидаем.Что(Сравнитель().Сравнить(Цепочка[Индекс], Цепочка[Индекс + 1]),
			СтрШаблон("%1 < %2", Цепочка[Индекс], Цепочка[Индекс + 1])).Равно(-1);
	КонецЦикла;

	// legacy-версия старше пререлиза той же тройки компонент
	Ожидаем.Что(Сравнитель().Сравнить("1.2.3.4", "1.2.3-rc.1"), "релизная legacy старше пререлиза").Равно(1);

КонецПроцедуры

// Ведущие нули: чтение снисходительно (проксирование старого хаба),
// но помечается некороничным (запрет — на публикации, СервисВерсий)

&Тест
Процедура ЧтениеВерсийСВедущимиНулямиОстаётсяСнисходительным() Экспорт

	// проксирование пакетов старого хаба обязано читать такие строки без ошибки
	Для Каждого Строка Из СтрРазделить("01.2.3;1.02.3;1.2.03;00.0.0;1.2.3-01;1.2.3.04", ";") Цикл
		Ожидаем.Что(Сравнитель().ВерсияКорректна(Строка),
			СтрШаблон("версия ""%1"" должна ЧИТАТЬСЯ (снисходительность для прокси)", Строка)).ЭтоИстина();
	КонецЦикла;

	// нормализация semver-библиотеки: 01.2.3 == 1.2.3 по порядку (в этом и риск)
	Ожидаем.Что(Сравнитель().Сравнить("01.2.3", "1.2.3")).Равно(0);
	Ожидаем.Что(Сравнитель().Сравнить("1.2.3-01", "1.2.3-1")).Равно(0);

КонецПроцедуры

&Тест
Процедура БезВедущихНулейОтличаетКаноническиеОтНеканонических() Экспорт

	// исходная строка - источник истины; проверка каноничности отдельная от чтения
	Канонические = СтрРазделить("1.2.3;0.0.0;1.2.3-rc.1;1.2.3.4;1.0.0-x-y-z.1;1.2.3+build.01;v1.2.3", ";");
	Для Каждого Строка Из Канонические Цикл
		Ожидаем.Что(Сравнитель().Разобрать(Строка).БезВедущихНулей(),
			СтрШаблон("""%1"" каноническая", Строка)).ЭтоИстина();
	КонецЦикла;

	Неканонические = СтрРазделить("01.2.3;1.02.3;1.2.03;00.0.0;1.2.3-01;1.2.3-rc.01;01.2.3.4;1.2.3.04", ";");
	Для Каждого Строка Из Неканонические Цикл
		Ожидаем.Что(Сравнитель().Разобрать(Строка).БезВедущихНулей(),
			СтрШаблон("""%1"" неканоническая (ведущий ноль)", Строка)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// --- служебные ---

Функция Сравнитель()
	Возврат Новый СравнительВерсий();
КонецФункции

Процедура ПодключитьКлассыРеестра()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("реестр", "Классы"));

	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		// без глушения ошибок: синтаксически сломанный класс должен уронить набор
		Если НЕ ТипЗарегистрирован(ФайлКласса.ИмяБезРасширения) Тогда
			ПодключитьСценарий(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)

	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба; // функция не может вызываться как процедура
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции
