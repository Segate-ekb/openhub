// Самотест фикстуры СтендАпстримов: на ней стоят наборы выдачи, уборки пула и отборов
// запросов. Источник, положенный не тем адресом или не в том порядке обхода, уводит
// набор мимо своей ветки: выдача опрашивает не тот хаб, а уборка не находит хвост.
// Проверяется то, ЧТО ВИДЯТ хранилище и служба источников после стенда, — обе двери,
// и строкой, и службами.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;       // общий контейнер на все тесты набора
Перем Засев;         // фикстура ЗасевРеестра — пул, которому принадлежит источник
Перем Стенд;         // фикстура СтендАпстримов — строка источника пула

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендАпстримов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	ПодключитьСлоиИсточников(Модули);

	Детальки = Новый Соответствие();
	// сети в наборе нет: пробное подключение к источнику выключено
	Детальки.Вставить("oshub.upstream.probe.enabled", "false");
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "стенд-апстримов-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("стенд-апстримов-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендАпстримов(Поделка);

КонецПроцедуры

// Хранилище источников живёт в слое данных, служба — в реестре, а её обязательные
// соседи (SSRF-гейт адреса и правило токена) собираются фикстурой ГейтАпстримов.
Процедура ПодключитьСлоиИсточников(Знач Модули)

	Слои.Подключить("данные");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));

	Слои.Подключить("хранилище, реестр, основа, наблюдаемость/телеметрия, события");

КонецПроцедуры

#Область ИсточникСтрокой

&Тест
Процедура ИсточникЛожитсяВБазуНаСвойПулИВиденСлужбе() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Запись = Стенд.Апстрим(Пул);

	Свои = Желудь("ХранилищеАпстримовПула").ПолучитьПоПулИдентификаторРавно(Пул.Идентификатор);
	Ожидаем.Что(Свои.Количество(), "источник виден хранилищу").Равно(1);
	Ожидаем.Что(Свои[0].Идентификатор, "тот самый источник").Равно(Запись.Идентификатор);
	Ожидаем.Что(Источники().Все(Пул.Идентификатор).Количество(),
		"и службе источников — тоже").Равно(1);
	Ожидаем.Что(Источники().ДляОпроса(Пул).Количество(),
		"источник по умолчанию включён и попадает в опрос").Равно(1);

КонецПроцедуры

// Что набор назвал двери, то и должно доехать до базы. Адрес, потерянный по дороге,
// увёл бы выдачу опрашивать чужой хаб.
&Тест
Процедура ДверьСтрокойДоноситАдрес() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.Апстрим(Пул, "http://selftest.example/download/");

	Ожидаем.Что(Источники().Первый(Пул.Идентификатор).Url, "названный адрес дошёл до базы")
		.Равно("http://selftest.example/download/");

КонецПроцедуры

// Порядок обхода — параметр двери: первый ответивший источник выигрывает, и набор,
// проверяющий очерёдность, обязан суметь разложить источники в нужном порядке.
&Тест
Процедура ДверьСтрокойДоноситПорядокОбхода() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.Апстрим(Пул, "http://третий/", 3);
	Стенд.Апстрим(Пул, "http://первый/", 1);
	Стенд.Апстрим(Пул, "http://второй/", 2);

	Ожидаем.Что(Адреса(Источники().Все(Пул.Идентификатор)), "порядок обхода по колонке Порядок")
		.Равно("http://первый/,http://второй/,http://третий/");
	Ожидаем.Что(Источники().Первый(Пул.Идентификатор).Url, "первым опрашивается названный первым")
		.Равно("http://первый/");

КонецПроцедуры

// TTL — параметр двери: на нём стоят наборы кэширующего прокси, и источник с чужим TTL
// сделал бы проверку протухания проверкой чего угодно.
&Тест
Процедура ДверьСтрокойДоноситВремяЖизни() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.Апстрим(Пул, "http://ttl.example/download/", 0, 60);

	Ожидаем.Что(Цел(Источники().Первый(Пул.Идентификатор).ВремяЖизниСек),
		"названный TTL дошёл до базы").Равно(60);
	Ожидаем.Что(Цел(Стенд.Апстрим(Пул, "http://ttl2.example/download/").ВремяЖизниСек),
		"TTL по умолчанию").Равно(900);

КонецПроцедуры

// Выключенный источник остаётся в списке со своим адресом и порядком, но выдача его
// не опрашивает: признак, потерянный по дороге, вернул бы выключенный источник в опрос.
&Тест
Процедура ДверьСтрокойДоноситПризнакВключения() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.Апстрим(Пул, "http://off.example/download/", 0, 900, Ложь);

	Ожидаем.Что(Источники().Все(Пул.Идентификатор).Количество(),
		"выключенный источник остаётся в списке").Равно(1);
	Ожидаем.Что(Источники().ДляОпроса(Пул).Количество(),
		"но выдача его не опрашивает").Равно(0);

КонецПроцедуры

// Пул называется набору то записью, то идентификатором — обе формы кладут источник
// на один и тот же пул. Наборам отборов и уборки пул как объект недоступен вовсе.
&Тест
Процедура ПулНазываетсяЗаписьюЛибоИдентификатором() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.Апстрим(Пул, "http://a.example/download/");
	Стенд.Апстрим(Пул.Идентификатор, "http://b.example/download/");

	Ожидаем.Что(Желудь("ХранилищеАпстримовПула").ПолучитьПоПулИдентификаторРавно(
		Пул.Идентификатор).Количество(), "оба источника на этом пуле").Равно(2);

КонецПроцедуры

// Свежий источник ещё ни разу не синхронизировался: непустой момент читался бы
// как «обход уже был», и инкремент ушёл бы не туда.
&Тест
Процедура НовыйИсточникЕщёНеСинхронизировался() Экспорт

	Запись = Стенд.Апстрим(Засев.ПулСервисом(УникальныеИмена.Имя("up")));

	Ожидаем.Что(Запись.ПоследняяСинхронизация, "момент последнего обхода пуст")
		.Равно('00010101000000');
	Ожидаем.Что(Запись.ТокенДоступа, "источник читается анонимно").Равно("");
	Ожидаем.Что(Запись.СписокРазрешенийJSON, "allowlist пуст — без ограничений").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ИсточникСлужбойХаба

// Дверь службой — настоящее заведение: один адрес даёт один источник, как бы он ни был
// набран, потому что сличение идёт по канону. Дверь строкой ничего этого не знает
// и кладёт вторую строку — набор, судящий на ней сличение адресов, оставался бы зелёным
// молча. Ради этой разницы дверей и две.
&Тест
Процедура ДверьСлужбойУзнаётИсточникПоКанонуАдресаАДверьСтрокойНет() Экспорт

	ЧерезСлужбу = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.АпстримСлужбой(ЧерезСлужбу, "https://Hub.Example:443/download/./");
	Стенд.АпстримСлужбой(ЧерезСлужбу, "https://hub.example/download/");

	Ожидаем.Что(Источники().Все(ЧерезСлужбу.Идентификатор).Количество(),
		"тот же адрес в другом написании — не второй источник").Равно(1);

	Строкой = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.Апстрим(Строкой, "https://Hub.Example:443/download/./");
	Стенд.Апстрим(Строкой, "https://hub.example/download/");

	Ожидаем.Что(Источники().Все(Строкой.Идентификатор).Количество(),
		"дверь строкой кладёт обе строки как есть").Равно(2);

КонецПроцедуры

// Адрес и TTL — параметры двери службой: правка TTL у заведённого источника обновляет
// его же запись, а не заводит вторую.
&Тест
Процедура ДверьСлужбойДоноситАдресИВремяЖизни() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("up"));

	Стенд.АпстримСлужбой(Пул, "https://svc.example/download/", 42);

	Ожидаем.Что(Цел(Источники().Первый(Пул.Идентификатор).ВремяЖизниСек),
		"названный TTL дошёл до базы").Равно(42);

	Стенд.АпстримСлужбой(Пул, "https://svc.example/download/", 7);

	Ожидаем.Что(Источники().Все(Пул.Идентификатор).Количество(),
		"тот же адрес не заводит вторую запись").Равно(1);
	Ожидаем.Что(Цел(Источники().Первый(Пул.Идентификатор).ВремяЖизниСек),
		"обновлена та же запись").Равно(7);
	Ожидаем.Что(Цел(Стенд.АпстримСлужбой(Пул, "https://svc2.example/download/").ВремяЖизниСек),
		"TTL по умолчанию").Равно(900);

КонецПроцедуры

// Пул судит источник по своему типу: личному пулу источник не заводится вовсе.
// Набор, взявший дверь строкой, этого запрета не увидит, и потому дверей две.
&Тест
Процедура ДверьСлужбойСудитПулПоТипуАДверьСтрокойНет() Экспорт

	Владелец = Засев.Пул(УникальныеИмена.Имя("ownr"));
	Личный = Желудь("СервисПулов").СоздатьЛичныйПул(УникальныеИмена.Имя("lich"),
		Владелец.Идентификатор);

	Отказ = "";
	Попытка
		Стенд.АпстримСлужбой(Личный, "https://svc.example/download/");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "личному пулу служба источник не заводит").ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеАпстримовПула").ПолучитьПоПулИдентификаторРавно(
		Личный.Идентификатор).Количество(), "и в базу ничего не легло").Равно(0);

	Стенд.Апстрим(Личный, "https://svc.example/download/");
	Ожидаем.Что(Желудь("ХранилищеАпстримовПула").ПолучитьПоПулИдентификаторРавно(
		Личный.Идентификатор).Количество(), "дверь строкой кладёт строку мимо запрета").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Источники()
	Возврат Желудь("СервисАпстримовПула");
КонецФункции

// Адреса выборки одной строкой в порядке выдачи: так порядок обхода виден целиком.
Функция Адреса(Знач Записи)

	Список = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Список.Добавить(Запись.Url);
	КонецЦикла;

	Возврат СтрСоединить(Список, ",");

КонецФункции

#КонецОбласти
