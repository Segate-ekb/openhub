// Живой смоук S3-бэкенда против реального S3-совместимого хранилища (MinIO):
// сквозной SigV4 round-trip и multipart на объекте >20 МБ. Включается OSHUB_S3_SMOKE;
// адрес, бакет, регион и ключи — из OSHUB_STORAGE_S3_*.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени

&ТестовыйНабор
&Тег("внешние")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"), "хранилище", "Классы");

	ПоискКлассов.ПодключитьВсе(КаталогКлассов);

	КлассыОсновы = ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "..", ".."), "основа", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КлассыОсновы, "ТихаяУборка.os"));

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_S3_SMOKE""))",
	Причина = "не задана переменная окружения OSHUB_S3_SMOKE (нет доступного MinIO/S3)")
Процедура СквозномойRoundTripМаленькийОбъект() Экспорт

	Хранилище = НовоеХранилище();
	Координаты = Новый КоординатыАртефакта(Пул(), "gitrunner", "1.9.3");

	// сохранение
	Результат = Хранилище.Сохранить(Координаты, ПолучитьДвоичныеДанныеИзСтроки("hello s3"));
	Ожидаем.Что(Результат.Размер).Равно(8);
	Ожидаем.Что(Результат.Sha256).Равно(Sha256Строки("hello s3"));

	// наличие и размер
	Ожидаем.Что(Хранилище.Существует(Координаты)).ЭтоИстина();
	Ожидаем.Что(Хранилище.Размер(Координаты)).Равно(8);

	// чтение файлом (потоково) и байтами, со сверкой sha256
	Путь = Хранилище.Получить(Координаты, Результат.Sha256);
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь))).Равно("hello s3");
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты))).Равно("hello s3");

	// опись пула видит объект
	Опись = Хранилище.Опись(Пул());
	Ожидаем.Что(НайтиВОписи(Опись, "gitrunner-1.9.3.ospx"), "объект должен быть в описи").ЭтоИстина();

	// удаление идемпотентно
	Хранилище.Удалить(Координаты);
	Ожидаем.Что(Хранилище.Существует(Координаты)).ЭтоЛожь();
	Хранилище.Удалить(Координаты); // повторно — не ошибка

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_S3_SMOKE""))",
	Причина = "не задана переменная окружения OSHUB_S3_SMOKE (нет доступного MinIO/S3)")
Процедура MultipartБольшойОбъектСохраняетсяИЧитаетсяЦелым() Экспорт

	Хранилище = НовоеХранилище();
	Координаты = Новый КоординатыАртефакта(Пул(), "big", "1.0.0");

	// объект >20 МБ: загрузка идёт частями (multipart), скачивание — диапазонами
	ФайлИсточника = ПостроитьБольшойФайл(21);
	Эталон = Sha256Файла(ФайлИсточника);

	Результат = Хранилище.Сохранить(Координаты, ФайлИсточника);
	Ожидаем.Что(Результат.Sha256, "sha256 источника считается локально").Равно(Эталон);
	Ожидаем.Что(Результат.Размер).Равно(Новый Файл(ФайлИсточника).Размер());

	// скачиваем целиком и сверяем sha256 — доказательство корректной сборки частей
	ПутьКопии = Хранилище.Получить(Координаты, Эталон);
	Ожидаем.Что(Sha256Файла(ПутьКопии), "скачанная копия побайтно совпадает").Равно(Эталон);
	Ожидаем.Что(Хранилище.Размер(Координаты)).Равно(Новый Файл(ФайлИсточника).Размер());

	Хранилище.Удалить(Координаты);
	УдалитьФайлыБезОшибок(ФайлИсточника);

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_S3_SMOKE""))",
	Причина = "не задана переменная окружения OSHUB_S3_SMOKE (нет доступного MinIO/S3)")
Процедура ЗамерЗанятогоМестаПулаЖивойБакет() Экспорт

	// занятое пулом на S3 считается листингом по префиксу пула: проверяем вживую,
	// что сумма сходится, соседний пул в неё не попадает, а снимок всех пулов
	// (им ходит плановая сверка) согласован с поштучным замером
	Хранилище = НовоеХранилище();
	Свой = Новый КоординатыАртефакта(Пул(), "sized", "1.0.0");
	Соседний = Новый КоординатыАртефакта("neighbour", "sized", "1.0.0");

	Ожидаем.Что(Хранилище.ОбъёмПула(Пул()), "пустая область пула — ноль").Равно(0);

	Хранилище.Сохранить(Свой, ПолучитьДвоичныеДанныеИзСтроки("hello s3"));   // 8 байт
	Хранилище.Сохранить(Соседний, ПолучитьДвоичныеДанныеИзСтроки("xyz"));    // 3 байта

	Попытка
		Ожидаем.Что(Хранилище.ОбъёмПула(Пул()), "замер видит только свой пул").Равно(8);
		Ожидаем.Что(Хранилище.ОбъёмПула("neighbour"), "соседний пул считается отдельно").Равно(3);

		Снимок = Хранилище.ОбъёмыПулов();
		Ожидаем.Что(Снимок.Получить(Пул()), "снимок согласован с поштучным замером").Равно(8);
		Ожидаем.Что(Снимок.Получить("neighbour"), "снимок видит оба пула").Равно(3);
		Ожидаем.Что(Хранилище.ЗанятыйОбъем(), "суммарный объём равен сумме областей").Равно(11);
	Исключение
		Хранилище.Удалить(Свой);
		Хранилище.Удалить(Соседний);
		ВызватьИсключение;
	КонецПопытки;

	Хранилище.Удалить(Свой);
	Хранилище.Удалить(Соседний);
	Ожидаем.Что(Хранилище.ОбъёмПула(Пул()), "удаление освободило место").Равно(0);

КонецПроцедуры

#Область Служебные

Функция НовоеХранилище()

	Клиент = Новый КлиентS3Oint(
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_ENDPOINT"),
		ИзОкружения("OSHUB_STORAGE_S3_REGION", "us-east-1"),
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_BUCKET"),
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_ACCESS_KEY"),
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_SECRET_KEY"),
		Истина, Логирование.ПолучитьЛог("тест.oshub.s3")); // MinIO — path-style

	// уникальный префикс на прогон (ASCII: oint 2.3.0 некорректно подписывает
	// не-ASCII значение ?prefix= в query-строке ListObjects)
	Возврат Новый S3Хранилище(Клиент, "smoke-" + Лев(Строка(Новый УникальныйИдентификатор), 8), 0);

КонецФункции

// Пул уникален на прогон, чтобы опись не пересекалась с параллельными смоуками.
Функция Пул()
	Возврат "main";
КонецФункции

Функция НайтиВОписи(Знач Опись, Знач ИмяФайла)
	Для Каждого Элемент Из Опись Цикл
		Если Элемент.ИмяФайла = ИмяФайла Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Строит временный файл размером примерно РазмерМБ мегабайт (детерминированный
// ASCII-контент), чтобы объект превысил порог multipart (20 МБ).
Функция ПостроитьБольшойФайл(Знач РазмерМБ)

	// 64 КБ базовый блок, наращиваем удвоением до нужного размера
	Блок = "0123456789abcdef"; // 16
	Для Н = 1 По 12 Цикл       // 16 * 2^12 = 65536 символов = 64 КБ
		Блок = Блок + Блок;
	КонецЦикла;

	Содержимое = "";
	Для Н = 1 По РазмерМБ * 16 Цикл // 16 блоков по 64 КБ = 1 МБ
		Содержимое = Содержимое + Блок;
	КонецЦикла;

	Путь = ПолучитьИмяВременногоФайла("bin");
	ПолучитьДвоичныеДанныеИзСтроки(Содержимое).Записать(Путь);

	Возврат Путь;

КонецФункции

Функция Sha256Строки(Знач Текст)
	Возврат Sha256Данных(ПолучитьДвоичныеДанныеИзСтроки(Текст));
КонецФункции

Функция Sha256Данных(Знач Данные)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Функция Sha256Файла(Знач Путь)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.ДобавитьФайл(Путь);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура УдалитьФайлыБезОшибок(Знач Путь)
	Попытка
		Если ЗначениеЗаполнено(Путь) И Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
