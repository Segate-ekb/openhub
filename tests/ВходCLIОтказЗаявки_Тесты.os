// Заведение заявки входа CLI сорвалось: клиент обязан получить конверт RFC 8628
// (error + error_description), а не пятисотку хаба.

#Использовать asserts
#Использовать "фикстуры"

Перем Поиск;   // фикстура КлассыСлоя

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ОтветJSONЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисаВходаCLI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "АдресИнстанса");
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "КонтроллерВходаCLI");

КонецПроцедуры

// Домен сорвался — контроллер отвечает конвертом потока: клиент opm читает поле error
// и по нему решает, что делать. Исключение из обработчика превратило бы ответ в HTML.
&Тест
Процедура СбойЗаведенияЗаявкиОтдаётсяКонвертомПотокаАНеПятисоткой() Экспорт

	Ответ = Новый ОтветJSONЗаглушка();

	Контроллер().НачалоВхода(Ответ, "{""client_name"":""opm"",""scopes"":""read""}",
		ЗаголовкиJSON(), "POST");

	Ожидаем.Что(Ответ.Код, "отказ ввода, а не поломка хаба").Равно(400);
	Ожидаем.Что(Ответ.ТелоТекст, "конверт потока называет код ошибки")
		.Содержит("""error"": ""invalid_request""");
	Ожидаем.Что(ЗначениеЗаполнено(Ответ.ТелоТекст) И СтрНайти(Ответ.ТелоТекст,
		"error_description") > 0, "и причину словами: " + Ответ.ТелоТекст).ЭтоИстина();

КонецПроцедуры

// КОНТРОЛЬ: удачное заведение отвечает 201 — тест не «краснеет всегда».
&Тест
Процедура УдачноеЗаведениеЗаявкиОтдаётПаруКодов() Экспорт

	Ответ = Новый ОтветJSONЗаглушка();

	Контроллер(Ложь).НачалоВхода(Ответ, "{""client_name"":""opm"",""scopes"":""read""}",
		ЗаголовкиJSON(), "POST");

	Ожидаем.Что(Ответ.Код, "заявка заведена").Равно(201);
	Ожидаем.Что(Ответ.ТелоТекст, "клиент получил код устройства").Содержит("device_code");

КонецПроцедуры

#Область Служебное

Функция Контроллер(Знач ПадатьНаЗаявке = Истина)

	Возврат Новый КонтроллерВходаCLI(
		Новый ФейкСервисаВходаCLI(ПадатьНаЗаявке),
		Новый ОтветыAPI(Новый ЗаголовкиHTTP()),
		Неопределено,
		Новый МетодыHTTP(),
		Новый АдресИнстанса(Новый НастройкиЗаглушка()),
		Новый ЗаголовкиHTTP());

КонецФункции

Функция ЗаголовкиJSON()

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Host", "hub.example.test");
	Возврат Заголовки;

КонецФункции

#КонецОбласти
