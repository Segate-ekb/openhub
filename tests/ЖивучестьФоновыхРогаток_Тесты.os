// ОСень запускает фоновую рогатку с ОжидатьЗавершения = Ложь и её исход не смотрит:
// упавшая подсистема молчит, а хаб продолжает отвечать 200. Каждая такая рогатка обязана
// ловить своё исключение сама — здесь проверяется, что сбой доходит до оператора.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем КаталогМодулей_;
Перем КаталогФикстур_;
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур_ = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ФоновыйЦикл.os"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "подписки", "Классы"),
		"ДоставщикПодписок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "подписки", "Классы"),
		"ЧислаДоставки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы"),
		"ПриведениеЧисел");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы"),
		"ВнедрённыеЖелуди");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы"),
		"ТекстОшибки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "зеркала", "Классы"),
		"РабочийСинхронизацииЗеркал");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "зеркала", "Классы"),
		"ЧислаЗеркалирования");

	ПоискКлассов.Подключить(КаталогФикстур_, "ЛовушкаЛога");
	ПоискКлассов.Подключить(КаталогФикстур_, "НастройкиЗаглушка");
	ПоискКлассов.Подключить(КаталогФикстур_, "ГотовностьПадающая");
	ПоискКлассов.Подключить(КаталогФикстур_, "ВладелецЦиклаЗаглушка");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "наблюдаемость",
		"Классы/пробы", "ГотовностьХаба.os"));

КонецПроцедуры

// Доставщик подписок сбоит по пути к циклу: тело цикла защищено своим ШагЦикла,
// а код до него — нет, и без перехвата вебхуки перестают уходить бесшумно.
&Тест
Процедура СбойДоставщикаПодписокВиденОператору() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Рогатка = Новый ДоставщикПодписок(Неопределено, Новый ЧислаДоставки(НастройкиПодписок()),
		Новый ГотовностьПадающая(), ЛогСЛовушкой("доставщик", Ловушка));

	Рогатка.ПриЗапускеПриложения();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "ГотовностьПадающая: намеренный сбой отметки") > 0,
		"причина смерти цикла доставщика названа: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Рабочий зеркал в этот список не попал, и его смерть была самой тихой из всех: зеркала
// переставали синхронизироваться, а в журнале не появлялось ни строки. Дефект владельца.
&Тест
Процедура СбойРабочегоЗеркалВиденОператору() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Рогатка = Новый РабочийСинхронизацииЗеркал(Неопределено, Неопределено, Неопределено,
		Новый ГотовностьПадающая(), Новый ЧислаЗеркалирования(),
		ЛогСЛовушкой("зеркала", Ловушка));

	Рогатка.ПриЗапускеПриложения();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "ГотовностьПадающая: намеренный сбой отметки") > 0,
		"причина смерти цикла синхронизации зеркал названа: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Гейт готовности закрывается ДО первого шага цикла: цикл вечен по построению, и хаб,
// ждущий его конца, не станет готовым никогда.
&Тест
Процедура ГейтГотовностиЗакрываетсяДоПервогоШагаЦикла() Экспорт

	Готовность = Новый ГотовностьХаба(Логирование.ПолучитьЛог("тест.oshub.цикл"));
	Готовность.ЗаявитьЗадачу("тест.цикл");
	Каркас = Новый ФоновыйЦикл(Готовность);
	Владелец = Новый ВладелецЦиклаЗаглушка(Готовность, "тест.цикл");
	Владелец.ПривязатьЦикл(Каркас);

	Каркас.Крутить(Владелец, "тест.цикл");

	Ожидаем.Что(Владелец.След(), "гейт закрыт между подготовкой и первым шагом")
		.Равно("перед:открыт;шаг:закрыт;после:закрыт");

КонецПроцедуры

// Выключенная подсистема — выбор оператора, а не незавершённый старт: цикла нет,
// а гейт всё равно закрыт, иначе /ready навсегда остаётся «starting».
&Тест
Процедура ГейтГотовностиЗакрываетсяИПриВыключенномРубильнике() Экспорт

	Готовность = Новый ГотовностьХаба(Логирование.ПолучитьЛог("тест.oshub.цикл"));
	Готовность.ЗаявитьЗадачу("тест.цикл");
	Каркас = Новый ФоновыйЦикл(Готовность);
	Владелец = Новый ВладелецЦиклаЗаглушка(Готовность, "тест.цикл", Ложь);
	Владелец.ПривязатьЦикл(Каркас);

	Каркас.Крутить(Владелец, "тест.цикл");

	Ожидаем.Что(Владелец.След(), "в цикл не входили").Равно("перед:открыт");
	Ожидаем.Что(Готовность.НезавершённыеЗадачи().Количество(),
		"незакрытых стартовых задач не осталось").Равно(0);

КонецПроцедуры

#Область Обвязка

// Уровень консоли хаба: то, чего тут нет, оператор в консоли не увидит.
Функция ЛогСЛовушкой(Знач Прозвище, Знач Ловушка)

	Лог = Логирование.ПолучитьЛог("тест.oshub.рогатки." + Прозвище);
	Лог.УстановитьУровень(УровниЛога.Информация);
	Лог.ДобавитьСпособВывода(Ловушка);
	Возврат Лог;

КонецФункции

#КонецОбласти

// Настройки подписок для прямой сборки вне контейнера — умолчания реестра.
Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Возврат Настройки;
КонецФункции
