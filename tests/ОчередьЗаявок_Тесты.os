// Очередь заявок, резервирование имён, доверенные конвейеры и личные пулы: три доменных входа мутаций со своей
// авторизацией и рамками ключа плюс эксплойт-сценарии. Набор изолирован в отдельный процесс.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем КаталогСборки;
Перем Засев;         // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба
Перем Стенд;         // фикстура СтендУчёток — учётка, роль на пуле, грант и ключ
Перем Принципалы;    // фикстура СтендПринципалов — принципал сессии и ключа

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	РеестрФикстур.Подключить("ЖурналАудитаФайлом");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	// SSRF-гейт апстримов (5.B): СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО.
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтФикстура = Новый ГейтАпстримов();
	ГейтФикстура.Подключить();

	// auth: ядро прав, выдача прав, гейт и гвард ключа, учётки (личный пул при регистрации)
	КаталогВхода = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("вход", "Классы"));
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "УчёткаПринципала");
	ПоискКлассов.Подключить(КаталогМодулей, "ВердиктГварда");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПравДоступа");
	ПоискКлассов.Подключить(КаталогМодулей, "ПроверяющийGitHub");
	ПоискКлассов.Подключить(КаталогМодулей, "СверкаСекретов");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисТокенов");
	ПоискКлассов.Подключить(КаталогМодулей, "ГейтТокена");
	ПоискКлассов.Подключить(КаталогМодулей, "ГвардКлюча");
	ПоискКлассов.Подключить(КаталогМодулей, "ДопускПринципала");
	ПоискКлассов.Подключить(КаталогМодулей, "НормализаторУчётки");
	ПоискКлассов.Подключить(КаталогМодулей, "ПолитикаПароля");
	// СервисПользователей пишет события безопасности учётки через летопись
	ПоискКлассов.Подключить(КаталогМодулей, "ЛетописьУчёток");
	// причина отказа «логин занят» / «адрес занят» приезжает машинным кодом из таблицы
	ПоискКлассов.Подключить(КаталогМодулей, "ОтказыУчётки");
	ПоискКлассов.Подключить(КаталогМодулей, "АдресУчётки");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПользователей");

	// события + аудит: выдача прав публикует событие шины
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	// observability: издатель событий инъектирует Телеметрию (здесь выключенную)
	КаталогNet = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("сеть", "Классы"));
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПробХаба = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПробХаба, "ГотовностьХаба.os"));

	// общий модуль утилит: классы реестра берут ПриведениеЧисел желудём
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	// settings: лимиты публикации и опция легаси-токена GitHub
	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(
		Новый Файл(ОбъединитьПути(КаталогSettings, "..", "..")).ПолноеИмя,
		"основа", "Классы", "ПриведениеФлагов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	// publish целиком, кроме контроллера (ему нужны перехватчик и куки winow) и боевого
	// ПроверяющийПодписиJWKS с его источником ключей — прозвище занимает фейк
	КаталогPublish = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("публикация", "Классы"));
	ПоискКлассов.Подключить(КаталогPublish, "СервисВходящих");
	ПоискКлассов.Подключить(КаталогPublish, "СтражИздателейCI");
	ПоискКлассов.Подключить(КаталогPublish, "МаскаРефа");
	ПоискКлассов.Подключить(КаталогPublish, "КороткаяФормаДоверия");
	ПоискКлассов.Подключить(КаталогPublish, "ИмяЗаписиДоверия");
	ПоискКлассов.Подключить(КаталогPublish, "ВидРефаДоверия");
	ПоискКлассов.Подключить(КаталогPublish, "СрокТокенаCI");
	ПоискКлассов.Подключить(КаталогPublish, "АудиторияТокенаCI");
	ПоискКлассов.Подключить(КаталогPublish, "СервисДоверияCI");
	ПоискКлассов.Подключить(КаталогPublish, "МестоВПуле");
	ПоискКлассов.Подключить(КаталогPublish, "СервисПубликации");
	ПоискКлассов.Подключить(КаталогPublish, "РассмотрениеВходящих");
	ПоискКлассов.Подключить(КаталогPublish, "СервисРезервированияИмён");

	// исход заявки заявителю уходит личным каналом; здесь проверяется домен, а не канал,
	// поэтому дверь подменена фейком — перечень поводов при этом настоящий
	ПоискКлассов.Подключить(КаталогМодулей, "ПоводыУведомлений");
	РеестрФикстур.Подключить("ФейкКаналаУведомлений");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийGitHub.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "НастройкиЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "КодировкаТестов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийПодписиCI.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФикстураПакета.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ЗаписывающийПодписчик.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-inbox-unit-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	// aud обязателен, и сверяется он с настройкой хаба: у этих токенов он "openhub"
	Детальки.Вставить("oshub.publish.ci.audience", "openhub");

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "очередь-заявок-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендУчёток(Поделка);
	Принципалы = Новый СтендПринципалов(Поделка);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область РассмотрениеЗаявок

&Тест
Процедура ЖелудиТрека7BЗарегистрированы() Экспорт
	Имена = "СервисВходящих,РассмотрениеВходящих,СервисРезервированияИмён,СервисДоверияCI,"
		+ "ГвардКлюча,ДопускПринципала";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ОдобрениеПубликуетВерсиюИДелаетЗаявителяМейнтейнером() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявитель = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("appr");

	Заявка = ПодатьЗаявку(Пул, Заявитель, ИмяПакета, "1.0.0");

	Итог = Рассмотрение().Одобрить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Итог.Успех, "мейнтейнер одобрил заявку: " + Итог.Сообщение).ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Ожидаем.Что(Пакет <> Неопределено, "пакет создан одобрением").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0") <> Неопределено,
		"версия опубликована").ЭтоИстина();

	Права = Желудь("СервисПрав");
	Ожидаем.Что(Права.РольНеНиже(Заявитель, Права.ОбъектПакет(Пакет), Права.РольМейнтейнер()),
		"заявитель стал мейнтейнером пакета").ЭтоИстина();

	Ожидаем.Что(Входящие().Заявка(Заявка.Идентификатор).Состояние,
		"заявка закрыта одобрением").Равно("одобрена");
	Ожидаем.Что(Входящие().ОжидающиеПула(Пул.Идентификатор).Количество(),
		"во «входящих» пусто").Равно(0);

КонецПроцедуры

&Тест
Процедура ОтклонениеНеСоздаётНиИмениНиПрав() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявитель = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("rej");

	Заявка = ПодатьЗаявку(Пул, Заявитель, ИмяПакета, "1.0.0");
	Итог = Рассмотрение().Отклонить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор, "не по теме");
	Ожидаем.Что(Итог.Успех, "мейнтейнер отклонил заявку").ЭтоИстина();

	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета) = Неопределено,
		"имя не занято").ЭтоИстина();
	Закрытая = Входящие().Заявка(Заявка.Идентификатор);
	Ожидаем.Что(Закрытая.Состояние, "состояние — отклонена").Равно("отклонена");
	Ожидаем.Что(Закрытая.Комментарий, "причина сохранена").Равно("не по теме");

	// после отклонения имя снова свободно, и автор вправе подать заявку заново — индекс «входящих» поэтому неуникален
	Повторная = Опубликовать(Пул, Заявитель, ИмяПакета, "1.0.0");
	Ожидаем.Что(Повторная.Код, "повторная заявка после отказа принимается").Равно(202);

КонецПроцедуры

// ЭКСПЛОЙТ: заявитель пробует одобрить себя сам. КОНТРОЛЬ: ту же заявку одобряет мейнтейнер.
&Тест
Процедура ЗаявительНеОдобряетСобственнуюЗаявку() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявитель = Стенд.Учётка();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальныеИмена.Имя("selfappr"), "1.0.0");

	Атака = Рассмотрение().Одобрить(Принципалы.Сессия(Заявитель), Заявка.Идентификатор);
	Ожидаем.Что(Атака.Успех, "заявитель себя не одобряет").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "не мейнтейнер → 403").Равно(403);
	Ожидаем.Что(Входящие().Заявка(Заявка.Идентификатор).Состояние,
		"заявка осталась ожидающей").Равно("ожидает");

	Контроль = Рассмотрение().Одобрить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: мейнтейнер ту же заявку одобряет").ЭтоИстина();

КонецПроцедуры

// ЭКСПЛОЙТ: заявка ОДНОГО пула, рассмотренная мейнтейнером ДРУГОГО: права наследуются вниз, а не вбок.
&Тест
Процедура МейнтейнерЧужогоПулаЗаявкуНеРассматривает() Экспорт

	Свой = Засев.ПулСервисом();
	Чужой = Засев.ПулСервисом();
	МейнтейнерСвоего = Стенд.УчёткаСРолью(Свой);
	МейнтейнерЧужого = Стенд.УчёткаСРолью(Чужой);
	Заявитель = Стенд.Учётка();

	Заявка = ПодатьЗаявку(Свой, Заявитель, УникальныеИмена.Имя("crosspool"), "1.0.0");

	Атака = Рассмотрение().Одобрить(Принципалы.Сессия(МейнтейнерЧужого), Заявка.Идентификатор);
	Ожидаем.Что(Атака.Успех, "мейнтейнер соседнего пула чужую заявку не одобряет").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "кросс-пуловая попытка → 403").Равно(403);

	Контроль = Рассмотрение().Одобрить(Принципалы.Сессия(МейнтейнерСвоего), Заявка.Идентификатор);
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: мейнтейнер СВОЕГО пула ту же заявку одобряет").ЭтоИстина();

КонецПроцедуры

// Рамки ключа на одобрении: права человека полные в обоих запросах, различает их РОВНО скоуп ключа.
&Тест
Процедура ReadOnlyКлючНеОдобряетЗаявку() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявитель = Стенд.Учётка();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальныеИмена.Имя("keyscope"), "1.0.0");

	Атака = Рассмотрение().Одобрить(Принципалы.Ключ(Мейнтейнер, "read", 0), Заявка.Идентификатор);
	Ожидаем.Что(Атака.Успех, "ключ без скоупа write заявку не одобряет").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "рамки ключа → 403").Равно(403);
	Ожидаем.Что(Атака.Сообщение, "причина названа как скоуп").Содержит("скоуп");

	Контроль = Рассмотрение().Одобрить(Принципалы.Ключ(Мейнтейнер, "read,write", 0), Заявка.Идентификатор);
	Ожидаем.Что(Контроль.Успех,
		"КОНТРОЛЬ: тот же человек полным ключом ту же заявку одобряет").ЭтоИстина();

КонецПроцедуры

// Привязка ключа к пулу на одобрении: тот же человек и тот же скоуп — различает только привязка.
&Тест
Процедура КлючЧужогоПулаНеОдобряетЗаявку() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявитель = Стенд.Учётка();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальныеИмена.Имя("keybind"), "1.0.0");

	Атака = Рассмотрение().Одобрить(
		Принципалы.Ключ(Мейнтейнер, "read,write", Пул.Идентификатор + 5000), Заявка.Идентификатор);
	Ожидаем.Что(Атака.Успех, "ключ, привязанный к другому пулу, заявку не одобряет").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "рамки ключа → 403").Равно(403);
	Ожидаем.Что(Атака.Сообщение, "причина названа как привязка").Содержит("привязан");

	Контроль = Рассмотрение().Одобрить(
		Принципалы.Ключ(Мейнтейнер, "read,write", Пул.Идентификатор), Заявка.Идентификатор);
	Ожидаем.Что(Контроль.Успех,
		"КОНТРОЛЬ: ключ, привязанный к ЭТОМУ пулу, ту же заявку одобряет").ЭтоИстина();

КонецПроцедуры

// ПОРЯДОК лесенки допуска значим и стережётся здесь: рамки ключа судятся ДО прав человека
// и до состояния заявки, а учётка — после рамок. Переставь шаги — и read-only ключ узнает
// по коду ответа, есть ли заявка и кто её вправе рассматривать.
&Тест
Процедура РамкиКлючаСудятсяРаньшеПравЧеловекаИУчётки() Экспорт

	Пул = Засев.ПулСервисом();
	Стенд.УчёткаСРолью(Пул);
	Посторонний = Стенд.Учётка();
	Заявитель = Стенд.Учётка();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальныеИмена.Имя("order"), "1.0.0");

	// человек за ключом заявок рассматривать НЕ вправе, и ключ ему тоже не даёт
	Ключом = Рассмотрение().Одобрить(Принципалы.Ключ(Посторонний, "read", 0), Заявка.Идентификатор);
	Ожидаем.Что(Ключом.Успех, "чужой read-only ключ заявку не одобряет").ЭтоЛожь();
	Ожидаем.Что(Ключом.Сообщение, "первым отвечает гейт ключа, а не модель прав")
		.Содержит("ключом доступа");
	Ожидаем.Что(СтрНайти(Ключом.Сообщение, "мейнтейнер"),
		"о правах человека предъявителю негодного ключа не рассказывают").Равно(0);

	// негодный ключ БЕЗ учётки: рамки судятся первыми, поэтому ответ про ключ, а не 401.
	// Переставь шаги — и здесь окажется 401: по нему предъявитель узнает, что дело
	// не в ключе, а в том, кем он назвался
	НегодныйБезУчётки = Рассмотрение().Одобрить(Принципалы.Ключ(Неопределено, "read", 0),
		Заявка.Идентификатор);
	Ожидаем.Что(НегодныйБезУчётки.Код, "рамки ключа судятся раньше учётки → 403").Равно(403);
	Ожидаем.Что(НегодныйБезУчётки.Сообщение, "и говорят про ключ").Содержит("ключом доступа");

	// рамки пройдены, а учётки за принципалом нет: ответ про аутентификацию, а не про роль
	БезУчётки = Рассмотрение().Одобрить(Принципалы.Ключ(Неопределено, "read,write", 0),
		Заявка.Идентификатор);
	Ожидаем.Что(БезУчётки.Код, "принципал без учётки → 401").Равно(401);
	Ожидаем.Что(СтрНайти(БезУчётки.Сообщение, "мейнтейнер"),
		"роль спрашивается ПОСЛЕ учётки").Равно(0);

	// КОНТРОЛЬ: тот же посторонний по сессии доходит до модели прав и слышит про роль
	Сессией = Рассмотрение().Одобрить(Принципалы.Сессия(Посторонний), Заявка.Идентификатор);
	Ожидаем.Что(Сессией.Успех, "посторонний заявку не одобряет и по сессии").ЭтоЛожь();
	Ожидаем.Что(Сессией.Сообщение, "КОНТРОЛЬ: без ключа отвечает модель прав")
		.Содержит("мейнтейнер");

КонецПроцедуры

&Тест
Процедура ВходящиеВидныТолькоМейнтейнерамПула() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Посторонний = Стенд.Учётка();
	Заявитель = Стенд.Учётка();
	ПодатьЗаявку(Пул, Заявитель, УникальныеИмена.Имя("visib"), "1.0.0");

	Ожидаем.Что(Рассмотрение().ВидимыеЗаявки(Принципалы.Сессия(Мейнтейнер), Пул).Количество(),
		"мейнтейнер видит заявку").Равно(1);
	Ожидаем.Что(Рассмотрение().ВидимыеЗаявки(Принципалы.Сессия(Посторонний), Пул).Количество(),
		"посторонний не видит ничего").Равно(0);
	Ожидаем.Что(Рассмотрение().ВидимыеЗаявки(Принципалы.Сессия(Заявитель), Пул).Количество(),
		"заявитель во «входящие» пула не заглядывает").Равно(0);
	Ожидаем.Что(Рассмотрение().ВидимыеЗаявки(Принципалы.Ключ(Мейнтейнер, "write", 0), Пул).Количество(),
		"ключ без скоупа read списка не получает").Равно(0);

КонецПроцедуры

&Тест
Процедура ПовторноеРассмотрениеОтклоняется() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявка = ПодатьЗаявку(Пул, Стенд.Учётка(), УникальныеИмена.Имя("twice"), "1.0.0");

	Ожидаем.Что(Рассмотрение().Отклонить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор, "").Успех,
		"первое решение принято").ЭтоИстина();
	Второе = Рассмотрение().Одобрить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Второе.Успех, "второе решение по той же заявке отклонено").ЭтоЛожь();
	Ожидаем.Что(Второе.Код, "заявка уже рассмотрена → 409").Равно(409);

КонецПроцедуры

&Тест
Процедура ОдобрениеНеОтбираетЗанятоеИмя() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявитель = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("taken");

	Заявка = ПодатьЗаявку(Пул, Заявитель, ИмяПакета, "1.0.0");
	// пока заявка ждала, мейнтейнер завёл это имя сам
	Ожидаем.Что(Опубликовать(Пул, Мейнтейнер, ИмяПакета, "0.9.0").Успех,
		"мейнтейнер занял имя сам").ЭтоИстина();

	Итог = Рассмотрение().Одобрить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Итог.Успех, "одобрение занятого имени отклонено").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "имя занято → 409").Равно(409);

	Права = Желудь("СервисПрав");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Ожидаем.Что(Права.РольНеНиже(Заявитель, Права.ОбъектПакет(Пакет), Права.РольЧитатель()),
		"и прав на чужой пакет заявитель не получил").ЭтоЛожь();

КонецПроцедуры

// Форс — свойство ЗАПРОСА, а не заявки: push с ним от бесправного заявителя уходит
// в очередь обычной заявкой, и одобрение существующий номер не заменяет. Иначе очередь
// стала бы способом переписать чужую версию чужими руками — рассматривающий нажал бы
// «одобрить», не зная, что заменяет уже установленное у людей.
&Тест
Процедура ОдобрениеЗаявкиНомерНеПерезаписываетИФорсНеПроносит() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявитель = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("noforce");

	Итог = ОпубликоватьФорсом(Пул, Заявитель, ИмяПакета, "1.0.0");
	Ожидаем.Что(Итог.Код, "push с форсом без прав — та же заявка во «входящие»").Равно(202);
	Заявка = Итог.Заявка;

	// пока заявка ждала решения, этот же номер опубликовал мейнтейнер
	Ожидаем.Что(Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0").Успех,
		"мейнтейнер опубликовал номер сам").ЭтоИстина();
	ИздательДо = Цел(Число(НайтиВерсию(Пул, ИмяПакета, "1.0.0").ОпубликовалИдентификатор));
	Ожидаем.Что(ИздательДо, "версия числится за мейнтейнером").Равно(Цел(Мейнтейнер.Идентификатор));

	Решение = Рассмотрение().Одобрить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Решение.Успех, "одобрение занятого номера не проходит").ЭтоЛожь();
	Ожидаем.Что(Решение.Код, "конфликт → 409").Равно(409);
	Ожидаем.Что(СтрНайти(Решение.Сообщение, ИмяПакета) > 0,
		"отказ понятен рассматривающему — назван пакет: " + Решение.Сообщение).ЭтоИстина();

	Ожидаем.Что(Цел(Число(НайтиВерсию(Пул, ИмяПакета, "1.0.0").ОпубликовалИдентификатор)),
		"опубликованный номер остался мейнтейнерским").Равно(ИздательДо);

КонецПроцедуры

#КонецОбласти

#Область РезервированиеИмён

// Резерв: имя есть, версий нет, роль выдана сразу — снимает ограничение «грант только на существующую сущность».
&Тест
Процедура МейнтейнерРезервируетИмяИВыдаётРольСразу() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Будущий = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("reserved");

	Итог = Резерв().Зарезервировать(Принципалы.Сессия(Мейнтейнер), Пул, ИмяПакета,
		"пользователь", Будущий.Идентификатор, "райтер");
	Ожидаем.Что(Итог.Успех, "имя зарезервировано: " + Итог.Сообщение).ЭтоИстина();
	Ожидаем.Что(Итог.Код, "резерв → 201").Равно(201);

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Ожидаем.Что(Пакет <> Неопределено, "пакет-плейсхолдер создан").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисВерсий").ВерсииПакета(Пакет.Идентификатор).Количество(),
		"версий у резерва нет").Равно(0);

	// и обладатель роли действительно публикует — это и есть смысл резерва
	Ожидаем.Что(Опубликовать(Пул, Будущий, ИмяПакета, "1.0.0").Успех,
		"получивший роль на резерв публикует версию").ЭтоИстина();

КонецПроцедуры

// ЭКСПЛОЙТ: райтер заводит имена публикацией, но раздавать роли не вправе — резерв ему недоступен.
// КОНТРОЛЬ: мейнтейнер того же пула то же имя резервирует.
&Тест
Процедура РайтерИменаНеРезервирует() Экспорт

	Пул = Засев.ПулСервисом();
	Райтер = Стенд.УчёткаСРолью(Пул, "publisher");
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("grab");

	Атака = Резерв().Зарезервировать(Принципалы.Сессия(Райтер), Пул, ИмяПакета, "", 0, "");
	Ожидаем.Что(Атака.Успех, "райтер имя не резервирует").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "не мейнтейнер → 403").Равно(403);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета) = Неопределено,
		"имя осталось свободным").ЭтоИстина();

	Контроль = Резерв().Зарезервировать(Принципалы.Сессия(Мейнтейнер), Пул, ИмяПакета, "", 0, "");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: мейнтейнер то же имя резервирует").ЭтоИстина();

КонецПроцедуры

// ЭКСПЛОЙТ: резерв в ЧУЖОМ пуле — роль считается на пуле резерва, а не на том, где проситель мейнтейнер.
&Тест
Процедура РезервВЧужомПулеОтбит() Экспорт

	Свой = Засев.ПулСервисом();
	Чужой = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Свой);
	ИмяПакета = УникальныеИмена.Имя("alien");

	Атака = Резерв().Зарезервировать(Принципалы.Сессия(Мейнтейнер), Чужой, ИмяПакета, "", 0, "");
	Ожидаем.Что(Атака.Успех, "мейнтейнер своего пула в чужом имя не резервирует").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "кросс-пуловая попытка → 403").Равно(403);

	Контроль = Резерв().Зарезервировать(Принципалы.Сессия(Мейнтейнер), Свой, ИмяПакета, "", 0, "");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: в СВОЁМ пуле то же имя резервируется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ReadOnlyКлючИмяНеРезервирует() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("keyres");

	Атака = Резерв().Зарезервировать(Принципалы.Ключ(Мейнтейнер, "read", 0), Пул, ИмяПакета, "", 0, "");
	Ожидаем.Что(Атака.Успех, "ключ без скоупа write имя не резервирует").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "рамки ключа → 403").Равно(403);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета) = Неопределено,
		"имя осталось свободным").ЭтоИстина();

	Контроль = Резерв().Зарезервировать(
		Принципалы.Ключ(Мейнтейнер, "read,write", 0), Пул, ИмяПакета, "", 0, "");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: полный ключ того же человека резервирует").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СнятьРезервМожноТолькоУПустогоИмени() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Пустое = УникальныеИмена.Имя("empty");
	СВерсией = УникальныеИмена.Имя("withver");

	Резерв().Зарезервировать(Принципалы.Сессия(Мейнтейнер), Пул, Пустое, "", 0, "");
	Ожидаем.Что(Резерв().СнятьРезерв(Принципалы.Сессия(Мейнтейнер), Пул, Пустое).Успех,
		"пустой резерв снимается").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Пустое) = Неопределено,
		"плейсхолдер удалён").ЭтоИстина();

	Ожидаем.Что(Опубликовать(Пул, Мейнтейнер, СВерсией, "1.0.0").Успех,
		"контроль: пакет с версией создан").ЭтоИстина();
	Отказ = Резерв().СнятьРезерв(Принципалы.Сессия(Мейнтейнер), Пул, СВерсией);
	Ожидаем.Что(Отказ.Успех, "пакет с версиями снятием резерва не удаляется").ЭтоЛожь();
	Ожидаем.Что(Отказ.Код, "есть версии → 409").Равно(409);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, СВерсией) <> Неопределено,
		"пакет на месте").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ДоверенныеКонвейеры

// Боевая реализация проверки подписи CI по умолчанию отказывает всегда: RSA-verify на чистом OneScript нет, а принять
// клеймы неподписанного JWT значит поверить документу, который атакующий печатает в блокноте.
&Тест
Процедура БезПроверкиПодписиКонвейерНеПубликуетНикогда() Экспорт

	// тип регистрируется ПОЗЖЕ сборки контейнера: у боевого класса то же прозвище, что у фейка, и ОСень нашла бы
	// два желудя с одним прозвищем; здесь нужен не желудь, а сам класс
	ПодключитьБоевойПроверяющий();
	Боевой = Новый ПроверяющийПодписиОтсутствует(ЛогТестов());
	Проверка = Боевой.ПроверитьТокен(СобратьТокенКонвейера(
		"https://token.actions.githubusercontent.com", "acme/lib", "", "", 3600),
		"https://token.actions.githubusercontent.com");
	Ожидаем.Что(Проверка.Успех,
		"заглушка не подтверждает НИ ОДИН токен").ЭтоЛожь();
	Ожидаем.Что(Проверка.Клеймы = Неопределено,
		"и непроверенных клеймов наружу не отдаёт").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Проверка.Сообщение),
		"и называет причину словами, а не молчит").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДоверенныйКонвейерПубликуетВерсию() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("cipkg");
	Ожидаем.Что(Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0").Успех, "имя заведено").ЭтоИстина();
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет, "github", ИздательGitHub(),
		"acme/lib", "", "refs/heads/main");
	ФейкПодписи().Разрешить(ИздательGitHub());

	Токен = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib",
		"acme/lib/.github/workflows/release.yml@refs/heads/main", "refs/heads/main", 3600);
	Итог = ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Токен);
	Ожидаем.Что(Итог.Успех, "доверенный конвейер опубликовал версию: " + Итог.Сообщение).ЭтоИстина();

КонецПроцедуры

// Trusted workflow с ЧУЖИМ repo-клеймом отклоняется; контроль рядом — тот же токен с правильным репозиторием публикует.
&Тест
Процедура КонвейерСЧужимРепозиториемОтклоняется() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("cirepo");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет, "github", ИздательGitHub(),
		"acme/lib", "", "refs/heads/main");
	ФейкПодписи().Разрешить(ИздательGitHub());

	Чужой = СобратьТокенКонвейера(ИздательGitHub(), "evil/fork", "", "refs/heads/main", 3600);
	Атака = ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Чужой);
	Ожидаем.Что(Атака.Успех, "чужой repo-клейм не публикует").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "отказ конвейера → 403").Равно(403);

	Свой = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", 3600);
	Ожидаем.Что(ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Свой).Успех,
		"КОНТРОЛЬ: тот же токен с доверенным репозиторием публикует").ЭтоИстина();

КонецПроцедуры

// Чужой издатель и истёкший срок — тоже отказ: разрешение выдаётся только полным совпадением.
&Тест
Процедура КонвейерСЧужимИздателемИлиИстёкшимТокеномОтклоняется() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("ciiss");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет, "github", ИздательGitHub(),
		"acme/lib", "", "refs/heads/main");
	ФейкПодписи().Разрешить(); // подпись достоверна для ЛЮБОГО издателя — иначе отказ был бы её

	Чужой = СобратьТокенКонвейера("https://gitlab.example.com", "acme/lib", "", "refs/heads/main", 3600);
	Ожидаем.Что(ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Чужой).Успех,
		"чужой издатель не публикует").ЭтоЛожь();

	Истёкший = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", -3600);
	Ожидаем.Что(ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Истёкший).Успех,
		"истёкший id-token не публикует").ЭтоЛожь();

	Свой = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", 3600);
	Ожидаем.Что(ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Свой).Успех,
		"КОНТРОЛЬ: свой издатель и живой срок публикуют").ЭтоИстина();

КонецПроцедуры

// Подпись — единственное, на чём держится весь путь: клеймы совпадают идеально, доверие настроено, срок жив — и всё
// равно отказ. Без этого теста снятие проверки подписи не краснит ничего: прочие тесты держат фейк «подпись достоверна».
&Тест
Процедура КонвейерБезДостовернойПодписиНеПубликует() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("cisig");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет, "github", ИздательGitHub(),
		"acme/lib", "", "refs/heads/main");

	Токен = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", 3600);

	ФейкПодписи().Запретить();
	Атака = ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Токен);
	Ожидаем.Что(Атака.Успех, "подпись не подтверждена → публикации нет").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "отказ конвейера → 403").Равно(403);
	Ожидаем.Что(Атака.Сообщение, "причина названа").Содержит("подпись");
	Ожидаем.Что(Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.1.0") = Неопределено,
		"версия не создана").ЭтоИстина();

	ФейкПодписи().Разрешить(ИздательGitHub());
	Ожидаем.Что(ОпубликоватьТокеном(Пул, ИмяПакета, "1.1.0", Токен).Успех,
		"КОНТРОЛЬ: с достоверной подписью тот же запрос публикует").ЭтоИстина();

КонецПроцедуры

// ЭКСПЛОЙТ: доверие настраивается на ПАКЕТЕ, значит конвейером новое имя не заводится.
&Тест
Процедура КонвейерНовоеИмяНеЗаводит() Экспорт

	Пул = Засев.ПулСервисом();
	ФейкПодписи().Разрешить();
	Свободное = УникальныеИмена.Имя("cinew");

	Токен = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", 3600);
	Атака = ОпубликоватьТокеном(Пул, Свободное, "1.0.0", Токен);
	Ожидаем.Что(Атака.Успех, "конвейер свободное имя не занимает").ЭтоЛожь();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Свободное) = Неопределено,
		"имя осталось свободным").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ReadOnlyКлючДовериеНеНастраивает() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("cikey");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	Атака = Доверие().Доверить(Принципалы.Ключ(Мейнтейнер, "read", 0), Пакет,
		"github", ИздательGitHub(), "acme/lib", "", "main");
	Ожидаем.Что(Атака.Успех, "ключ без write доверие не настраивает").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "рамки ключа → 403").Равно(403);
	Ожидаем.Что(Доверие().КонвейерыПакета(Пакет).Количество(), "запись не создана").Равно(0);

	Контроль = Доверие().Доверить(Принципалы.Ключ(Мейнтейнер, "read,write", 0), Пакет,
		"github", ИздательGitHub(), "acme/lib", "", "main");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: полный ключ того же человека настраивает").ЭтоИстина();

КонецПроцедуры

// ЭКСПЛОЙТ: снятие доверия с ЧУЖОГО пакета по идентификатору — принадлежность проверяется ПО СУЩНОСТИ.
&Тест
Процедура ДовериеЧужогоПакетаПоИдентификаторуНеСнимается() Экспорт

	Свой = Засев.ПулСервисом();
	Чужой = Засев.ПулСервисом();
	МойМейнтейнер = Стенд.УчёткаСРолью(Свой);
	ЧужойМейнтейнер = Стенд.УчёткаСРолью(Чужой);

	ИмяЧужого = УникальныеИмена.Имя("victim");
	Опубликовать(Чужой, ЧужойМейнтейнер, ИмяЧужого, "1.0.0");
	ПакетЧужой = Желудь("СервисПакетов").НайтиПакет(Чужой.Идентификатор, ИмяЧужого);
	ЗаписьЧужая = Доверие().Доверить(Принципалы.Сессия(ЧужойМейнтейнер), ПакетЧужой,
		"github", ИздательGitHub(), "victim/repo", "", "main").Доверие;

	ИмяСвоего = УникальныеИмена.Имя("mine");
	Опубликовать(Свой, МойМейнтейнер, ИмяСвоего, "1.0.0");
	ПакетСвой = Желудь("СервисПакетов").НайтиПакет(Свой.Идентификатор, ИмяСвоего);
	ЗаписьСвоя = Доверие().Доверить(Принципалы.Сессия(МойМейнтейнер), ПакетСвой,
		"github", ИздательGitHub(), "mine/repo", "", "main").Доверие;

	// подставляем СВОЙ пакет и ЧУЖОЙ идентификатор доверия
	Атака = Доверие().ОтозватьДоверие(Принципалы.Сессия(МойМейнтейнер), ПакетСвой,
		ЗаписьЧужая.Идентификатор);
	Ожидаем.Что(Атака.Успех, "чужая запись доверия по идентификатору не снимается").ЭтоЛожь();
	Ожидаем.Что(Доверие().КонвейерыПакета(ПакетЧужой).Количество(),
		"доверие чужого пакета на месте").Равно(1);

	Контроль = Доверие().ОтозватьДоверие(Принципалы.Сессия(МойМейнтейнер), ПакетСвой,
		ЗаписьСвоя.Идентификатор);
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: свою запись тот же человек снимает").ЭтоИстина();

КонецПроцедуры

// Запись доверия без издателя или репозитория не создаётся: она значила бы «публиковать вправе любой конвейер».
&Тест
Процедура ДовериеБезИздателяИлиРепозиторияНеСоздаётся() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("cireq");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	// издатель формой больше не спрашивается: пустой выводится из типа репозитория,
	// а вот репозиторий обязателен — без него доверие означало бы «любой репозиторий»
	ПоТипу = Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет, "github", "", "acme/lib",
		"", "main");
	Ожидаем.Что(ПоТипу.Успех, "без издателя запись создаётся: он выводится из типа").ЭтоИстина();
	Ожидаем.Что(Строка(ПоТипу.Доверие.Издатель), "и это издатель GitHub Actions")
		.Равно(ИздательGitHub());
	Доверие().ОтозватьДоверие(Принципалы.Сессия(Мейнтейнер), Пакет, ПоТипу.Доверие.Идентификатор);

	Ожидаем.Что(Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет,
			"github", ИздательGitHub(), "", "", "main").Успех, "без репозитория — отказ").ЭтоЛожь();
	Ожидаем.Что(Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет,
			"bitbucket", ИздательGitHub(), "acme/lib", "", "main").Успех, "чужой провайдер — отказ").ЭтоЛожь();
	Ожидаем.Что(Доверие().КонвейерыПакета(Пакет).Количество(), "ни одной записи").Равно(0);

	Ожидаем.Что(Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет,
			"github", ИздательGitHub(), "acme/lib", "", "main").Успех,
		"КОНТРОЛЬ: полная запись создаётся").ЭтоИстина();

КонецПроцедуры

// Порог живёт В ДОМЕНЕ, а не в контроллерах: обе двери спрашивают его до захода сюда,
// и без этого теста снятие проверки в сервисе не красит ничего. Райтер пула пакет меняет
// (публикует версии), но доверием не распоряжается.
&Тест
Процедура ДоверитьМожетТолькоМейнтейнерПакета() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Райтер = Стенд.УчёткаСРолью(Пул, "publisher");
	Посторонний = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("ciporog");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	ОтказРайтера = Доверие().Доверить(Принципалы.Сессия(Райтер), Пакет,
		"github", ИздательGitHub(), "writer/repo", "", "main");
	Ожидаем.Что(ОтказРайтера.Успех, "райтер пула доверие не настраивает").ЭтоЛожь();
	Ожидаем.Что(ОтказРайтера.Код, "порог домена → 403").Равно(403);

	Ожидаем.Что(Доверие().Доверить(Принципалы.Сессия(Посторонний), Пакет,
			"github", ИздательGitHub(), "stranger/repo", "", "main").Код,
		"посторонний — тот же 403").Равно(403);

	Ожидаем.Что(Доверие().Доверить(Неопределено, Пакет,
			"github", ИздательGitHub(), "anon/repo", "", "main").Успех,
		"без принципала доверия нет").ЭтоЛожь();

	Ожидаем.Что(Доверие().КонвейерыПакета(Пакет).Количество(), "ни одной записи").Равно(0);

	Ожидаем.Что(Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет,
			"github", ИздательGitHub(), "owner/repo", "", "main").Успех,
		"КОНТРОЛЬ: мейнтейнер того же пакета настраивает").ЭтоИстина();

КонецПроцедуры

// Тот же порог у отзыва: иначе райтер снимал бы доверие, которого не заводил.
&Тест
Процедура ОтозватьДовериеМожетТолькоМейнтейнерПакета() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Райтер = Стенд.УчёткаСРолью(Пул, "publisher");
	ИмяПакета = УникальныеИмена.Имя("ciotzyv");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	Запись = Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет,
		"github", ИздательGitHub(), "acme/revoke", "", "main").Доверие;

	Атака = Доверие().ОтозватьДоверие(Принципалы.Сессия(Райтер), Пакет, Запись.Идентификатор);
	Ожидаем.Что(Атака.Успех, "райтер пула доверие не отзывает").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "порог домена → 403").Равно(403);

	ReadOnly = Доверие().ОтозватьДоверие(Принципалы.Ключ(Мейнтейнер, "read", 0), Пакет,
		Запись.Идентификатор);
	Ожидаем.Что(ReadOnly.Успех, "ключ без write доверие не отзывает").ЭтоЛожь();
	Ожидаем.Что(ReadOnly.Код, "рамки ключа → 403").Равно(403);

	Ожидаем.Что(Доверие().КонвейерыПакета(Пакет).Количество(), "запись цела").Равно(1);

	Ожидаем.Что(Доверие().ОтозватьДоверие(Принципалы.Сессия(Мейнтейнер), Пакет,
			Запись.Идентификатор).Успех,
		"КОНТРОЛЬ: мейнтейнер свою запись снимает").ЭтоИстина();

КонецПроцедуры

// Имя записи попадает в журнал, в аудит и в диалог подтверждения на экране, поэтому оно
// обязано различать записи по КАЖДОЙ оси, по которой они бывают разными: конвейер и реф.
// Совпавшее имя означает, что человека спрашивают про одно и то же дважды, а снимает он
// неизвестно что — и это ровно те две оси, которыми доверие сужают.
&Тест
Процедура ИмяЗаписиРазличаетЗаписиПоКаждойОси() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("ciname");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	// ось «конвейер»: репозиторий и реф одни, конвейеры разные
	Релиз = ИмяДоверия(Мейнтейнер, Пакет, "acme/lib",
		"acme/lib/.github/workflows/release.yml", "refs/heads/main");
	Ночная = ИмяДоверия(Мейнтейнер, Пакет, "acme/lib",
		"acme/lib/.github/workflows/nightly.yml", "refs/heads/main");

	Ожидаем.Что(СтрНайти(Релиз, "release.yml") > 0,
		"имя записи называет конвейер: " + Релиз).ЭтоИстина();
	Ожидаем.Что(Релиз = Ночная, "разные конвейеры — разные имена").ЭтоЛожь();

	// ось «реф»: репозиторий и конвейер одни, рефы разные — это защита от публикации
	// с чужой ветки, и в вопросе она обязана быть видна
	Главная = ИмяДоверия(Мейнтейнер, Пакет, "acme/two-refs", "", "refs/heads/main");
	Стабильная = ИмяДоверия(Мейнтейнер, Пакет, "acme/two-refs", "", "refs/heads/stable");

	Ожидаем.Что(СтрНайти(Главная, "refs/heads/main") > 0,
		"имя записи называет реф: " + Главная).ЭтоИстина();
	Ожидаем.Что(Главная = Стабильная, "разные рефы — разные имена").ЭтоЛожь();

КонецПроцедуры

// То же имя человек читает целиком, а каноническое значение конвейера НАЧИНАЕТСЯ с самого
// репозитория: печать его дословно называла репозиторий дважды подряд. Спрашивается имя
// у сервиса — витрина берёт его там же, и своей копии правила у неё быть не должно.
&Тест
Процедура ИмяЗаписиНеПовторяетРепозиторийДважды() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("cishort");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	// так его и вводят в форме: имя файла, а каноническое значение достраивает хаб
	Имя = ИмяДоверия(Мейнтейнер, Пакет, "acme/lib", "release.yml", "refs/heads/main");

	Ожидаем.Что(СколькоРазВстречается(Имя, "acme/lib"),
		"репозиторий назван один раз: " + Имя).Равно(1);
	Ожидаем.Что(Имя, "конвейер назван коротким именем").Содержит("acme/lib/release.yml");
	Ожидаем.Что(СтрНайти(Имя, ".github/workflows"),
		"служебного каталога в имени нет: он один и ничего не сообщает").Равно(0);

КонецПроцедуры

Функция СколькоРазВстречается(Знач Текст, Знач Фрагмент)

	Сколько = 0;
	Смещение = 1;
	Позиция = СтрНайти(Текст, Фрагмент);
	Пока Позиция > 0 Цикл
		Сколько = Сколько + 1;
		Смещение = Смещение + Позиция + СтрДлина(Фрагмент) - 1;
		Позиция = СтрНайти(Сред(Текст, Смещение), Фрагмент);
	КонецЦикла;
	Возврат Сколько;

КонецФункции

Функция ИмяДоверия(Знач Мейнтейнер, Знач Пакет, Знач Репозиторий, Знач Конвейер, Знач Реф)

	Итог = Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет, "github", ИздательGitHub(),
		Репозиторий, Конвейер, Реф);
	Если НЕ Итог.Успех Тогда
		ВызватьИсключение "Запись доверия не создана: " + Итог.Сообщение;
	КонецЕсли;
	Возврат Доверие().ОписаниеЗаписи(Итог.Доверие);

КонецФункции

// Доверенный конвейер — это выданное право публиковать пакет, поэтому его заведение
// и отзыв обязаны оставлять след, как и выдача роли. Тест идёт СКВОЗЬ весь путь —
// сервис → шина → СлужбаАудита → журнал: подписка службы на этот тип события так же
// обязательна, как и сама публикация, а проверка «событие издано» её не видит.
&Тест
Процедура ЗаведениеИОтзывДоверияДоезжаютДоЖурналаАудита() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("ciaudit");
	Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Объект = СтрШаблон("%1/%2", Пул.Имя, Пакет.Имя);

	Запись = Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет,
		"github", ИздательGitHub(), "acme/audited", "", "refs/heads/main").Доверие;

	// повтор идемпотентен: второй записи о выданном праве быть не должно
	Доверие().Доверить(Принципалы.Сессия(Мейнтейнер), Пакет,
		"github", ИздательGitHub(), "acme/audited", "", "refs/heads/main");

	Доверие().ОтозватьДоверие(Принципалы.Сессия(Мейнтейнер), Пакет, Запись.Идентификатор);

	Выдачи = ЗаписиАудита(Объект, "доверие.выдано");
	Отзывы = ЗаписиАудита(Объект, "доверие.отозвано");

	Ожидаем.Что(Выдачи.Количество(),
		"выдача записана один раз: идемпотентный повтор ложного следа не оставил").Равно(1);
	Ожидаем.Что(Отзывы.Количество(), "отзыв записан своим действием").Равно(1);

	Ожидаем.Что(Строка(Выдачи[0].Кто), "инициатор выдачи").Равно(Строка(Мейнтейнер.Логин));
	Ожидаем.Что(Строка(Отзывы[0].Кто), "инициатор отзыва").Равно(Строка(Мейнтейнер.Логин));

	Ожидаем.Что(СтрНайти(Строка(Выдачи[0].Детали), "acme/audited") > 0,
		"детали выдачи называют репозиторий").ЭтоИстина();
	// след отзыва называет снятое, а не пустоту; порядок «след до Удалить» этим НЕ
	// закреплён — штатные коннекторы оставляют значения в удалённой сущности, и разницы
	// на них нет; в сервисе он стоит на случай бэкенда, который так не делает
	Ожидаем.Что(СтрНайти(Строка(Отзывы[0].Детали), "acme/audited") > 0,
		"детали отзыва называют снятый конвейер, а не пустоту").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Отзывы[0].Детали), "refs/heads/main") > 0,
		"и его реф").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЛичныеПулы

// Владелец личного пула получает роль мейнтейнера автоматически: раньше колонка владельца заполнялась, а прав не давала.
&Тест
Процедура ВладелецЛичногоПулаПолучаетРольАвтоматически() Экспорт

	Пользователь = Желудь("СервисПользователей").СоздатьПользователя(УникальныеИмена.Имя("lp"), "", "");
	Личный = Желудь("СервисПулов").НайтиПул(Пользователь.Логин);
	Ожидаем.Что(Личный <> Неопределено, "личное пространство создано").ЭтоИстина();
	Ожидаем.Что(Личный.Видимость, "и оно публично (В-5)").Равно("public");

	Права = Желудь("СервисПрав");
	Ожидаем.Что(Права.РольНеНиже(Пользователь, Права.ОбъектПул(Личный), Права.РольМейнтейнер()),
		"владелец — мейнтейнер своего пространства").ЭтоИстина();

	// и это не декларация: он публикует в него без единой дополнительной выдачи прав
	Ожидаем.Что(Опубликовать(Личный, Пользователь, УникальныеИмена.Имя("mypkg"), "1.0.0").Успех,
		"владелец публикует в своё пространство").ЭтоИстина();

	// КОНТРОЛЬ: посторонний в чужом личном пуле прав не имеет
	Посторонний = Стенд.Учётка();
	Ожидаем.Что(Права.РольНеНиже(Посторонний, Права.ОбъектПул(Личный), Права.РольЧитатель()),
		"КОНТРОЛЬ: чужому пространству посторонний не хозяин").ЭтоЛожь();

КонецПроцедуры

// ЭКСПЛОЙТ: выключенная опция личных пулов запрещает и ручное заведение пула типа `user`, и смену типа существующего.
// СервисПулов собирается напрямую с выключенной деталькой: опция читается в конструкторе.
&Тест
Процедура ФлагХабаЗакрываетВсеПутиКЛичномуПулу() Экспорт

	Перем Ошибка;

	Выключенный = СервисПуловСОпцией(Ложь);
	Включённый = СервисПуловСОпцией(Истина);

	Ошибка = "";
	Попытка
		Выключенный.СоздатьПул(УникальныеИмена.Имя("upool"), "user", "public", 0, 0);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка, "ручное создание пула типа user запрещено").Содержит("отключены настройкой хаба");

	Ошибка = "";
	Попытка
		Выключенный.СоздатьЛичныйПул(УникальныеИмена.Имя("uown"), 1);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка, "и авто-создание личного пространства тоже").Содержит("отключены настройкой хаба");

	// смена типа существующего пула на `user` — третий путь к тому же
	Обычный = Включённый.СоздатьПул(УникальныеИмена.Имя("plain"), "custom", "public", 0, 0);
	Ошибка = "";
	Попытка
		Выключенный.УстановитьТип(Обычный.Идентификатор, "user");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка, "и смена типа на user").Содержит("отключены настройкой хаба");

	// КОНТРОЛЬ: с включённой опцией тот же вызов проходит — отказ приходил ровно из-за опции
	Ожидаем.Что(Включённый.СоздатьПул(УникальныеИмена.Имя("upool"), "user", "public", 0, 0).Тип,
		"КОНТРОЛЬ: при включённой опции пул типа user создаётся").Равно("user");

КонецПроцедуры

#КонецОбласти

#Область ВитриныРассмотрения

// Сводка кабинета: экран берёт её напрямую, поэтому порог обязан держаться в домене.
&Тест
Процедура СводкаПринципалаНесётТолькоПулыГдеОнМейнтейнер() Экспорт

	Свой = Засев.ПулСервисом();
	Чужой = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Свой);
	Стенд.УчёткаСРолью(Чужой);

	ЗаявкаСвоя = ПодатьЗаявку(Свой, Стенд.Учётка(), УникальныеИмена.Имя("mine"), "1.0.0");
	ПодатьЗаявку(Чужой, Стенд.Учётка(), УникальныеИмена.Имя("alien"), "1.0.0");

	Сводка = Рассмотрение().ОжидающиеПринципала(Принципалы.Сессия(Мейнтейнер));

	Ожидаем.Что(Сводка.Количество(), "в сводке только заявка своего пула").Равно(1);
	Ожидаем.Что(Цел(Сводка[0].Заявка.Идентификатор), "именно та заявка")
		.Равно(Цел(ЗаявкаСвоя.Идентификатор));
	Ожидаем.Что(Строка(Сводка[0].Пул.Имя), "строка несёт пул").Равно(Строка(Свой.Имя));
	Ожидаем.Что(Строка(Сводка[0].Заявитель.Логин), "и заявителя")
		.Равно(Строка(Желудь("СервисПользователей").ПоИдентификатору(
			Цел(ЗаявкаСвоя.ЗаявительИдентификатор)).Логин));

	Ожидаем.Что(Рассмотрение().ОжидающиеПринципала(Принципалы.Сессия(Стенд.Учётка())).Количество(),
		"посторонний не видит ничего").Равно(0);
	Ожидаем.Что(Рассмотрение().ОжидающиеПринципала(Неопределено).Количество(),
		"аноним не видит ничего").Равно(0);

КонецПроцедуры

// Счётчик в шапке считает то же, что сводка кабинета, но без сборки строк. Разойдись эти
// два счёта — на кнопке учётки будет одно число, а за дверью «входящих» другое.
&Тест
Процедура СчётЖдущихРешенияСовпадаетСоСводкойИЧужогоНеСчитает() Экспорт

	Свой = Засев.ПулСервисом();
	Чужой = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Свой);
	Стенд.УчёткаСРолью(Чужой);

	ПодатьЗаявку(Свой, Стенд.Учётка(), УникальныеИмена.Имя("mine"), "1.0.0");
	ПодатьЗаявку(Свой, Стенд.Учётка(), УникальныеИмена.Имя("mine"), "1.0.0");
	ПодатьЗаявку(Чужой, Стенд.Учётка(), УникальныеИмена.Имя("alien"), "1.0.0");

	Ожидаем.Что(Рассмотрение().СколькоЖдётРешения(Мейнтейнер), "счёт равен числу строк сводки")
		.Равно(Рассмотрение().ОжидающиеПринципала(Принципалы.Сессия(Мейнтейнер)).Количество());
	Ожидаем.Что(Рассмотрение().СколькоЖдётРешения(Мейнтейнер),
		"и это ровно заявки своего пула").Равно(2);

	Ожидаем.Что(Рассмотрение().СколькоЖдётРешения(Стенд.Учётка()),
		"посторонний не считает ничего").Равно(0);
	Ожидаем.Что(Рассмотрение().СколькоЖдётРешения(Неопределено),
		"аноним — тем более").Равно(0);

КонецПроцедуры

// Счёт складывается ПО ПУЛАМ, и проверять это надо на тех, у кого пулов больше одного:
// мейнтейнер двух пулов обязан увидеть обе очереди, а админ хаба — очередь всего хаба.
// Его число самое большое, и разойтись со сводкой оно может первым.
&Тест
Процедура СчётЖдущихРешенияСкладываетсяПоВсемПулам() Экспорт

	Первый = Засев.ПулСервисом();
	Второй = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Первый);
	Стенд.РольВПуле(Второй, Мейнтейнер, "owner");
	Админ = СоздатьАдмина();

	ПодатьЗаявку(Первый, Стенд.Учётка(), УникальныеИмена.Имя("first"), "1.0.0");
	ПодатьЗаявку(Второй, Стенд.Учётка(), УникальныеИмена.Имя("second"), "1.0.0");

	Ожидаем.Что(Рассмотрение().СколькоЖдётРешения(Мейнтейнер),
		"мейнтейнер двух пулов считает обе очереди").Равно(2);

	ПоСводке = Рассмотрение().ОжидающиеПринципала(Принципалы.Сессия(Админ)).Количество();
	Ожидаем.Что(Рассмотрение().СколькоЖдётРешения(Админ),
		"у админа хаба счёт сходится со сводкой").Равно(ПоСводке);
	Ожидаем.Что(ПоСводке >= 2,
		"и это не ноль: очередь хаба админ видит целиком").ЭтоИстина();

КонецПроцедуры

// Карточка заявки для экрана: те же проверки и в том же порядке, что у решения.
&Тест
Процедура КарточкаЗаявкиЗакрытаОтЧужогоИНеизвестногоНомера() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	Заявка = ПодатьЗаявку(Пул, Стенд.Учётка(), УникальныеИмена.Имя("card"), "1.0.0");

	Своя = Рассмотрение().ЗаявкаКРассмотрению(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Своя.Успех, "мейнтейнер получает карточку").ЭтоИстина();
	Ожидаем.Что(Строка(Своя.Пул.Имя), "карточка несёт пул").Равно(Строка(Пул.Имя));
	Ожидаем.Что(Своя.Заявитель <> Неопределено, "и заявителя").ЭтоИстина();

	Чужая = Рассмотрение().ЗаявкаКРассмотрению(Принципалы.Сессия(Стенд.Учётка()),
		Заявка.Идентификатор);
	Ожидаем.Что(Чужая.Успех, "посторонний карточку не получает").ЭтоЛожь();
	Ожидаем.Что(Чужая.Код, "посторонний → 403").Равно(403);

	Небылица = Рассмотрение().ЗаявкаКРассмотрению(Принципалы.Сессия(Мейнтейнер), 99999999);
	Ожидаем.Что(Небылица.Успех, "несуществующий номер карточки не даёт").ЭтоЛожь();
	Ожидаем.Что(Небылица.Код, "чужой идентификатор заявки → 404").Равно(404);

КонецПроцедуры

// Артефакт заявки пропал из хранилища: одобрять нечего, и это 410, а не тихая публикация.
&Тест
Процедура ОдобрениеБезАртефактаОтвечает410() Экспорт

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Пул);
	ИмяПакета = УникальныеИмена.Имя("gone");
	Заявка = ПодатьЗаявку(Пул, Стенд.Учётка(), ИмяПакета, "1.0.0");

	// байты убираются тем же способом, что и при уборке очереди
	Входящие().УдалитьАртефакт(Заявка, Пул.Имя);

	Итог = Рассмотрение().Одобрить(Принципалы.Сессия(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Итог.Успех, "одобрение без артефакта не проходит").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "артефакт пропал → 410").Равно(410);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета) <> Неопределено,
		"пустой плейсхолдер после отказа не остался").ЭтоЛожь();

КонецПроцедуры

// Автор пакета и тот, кто его прислал, — разные люди; рассматривающему нужны оба.
&Тест
Процедура АвторМанифестаДоезжаетДоЗаявки() Экспорт

	Пул = Засев.ПулСервисом();
	Заявитель = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("author");

	КаталогПакета = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогПакета);
	Манифест = ПакетыOspx.НовыйМанифест(ИмяПакета, "1.0.0").УстановитьАвтора("dr-who");
	Путь = Новый ФикстураПакета().ПостроитьOspxПоМанифесту(КаталогПакета, Манифест, "# " + ИмяПакета);

	Результат = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Новый ДвоичныеДанные(Путь),
		СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Заявитель, "");
	Ожидаем.Что(Результат.Код, "заявка принята").Равно(202);

	Ожидаем.Что(Строка(Входящие().Заявка(Результат.Заявка.Идентификатор).АвторМанифеста),
		"автор из манифеста сохранён в заявке, а не потерян по дороге").Равно("dr-who");

КонецПроцедуры

#КонецОбласти

#Область ПричиныОтказаPush

// Отказ 403 обязан называть СВОЮ причину: общий текст про дефолтный пул уводил
// со следа — владелец искал права на дефолтном пуле, а пул был приватный и невидимый.
&Тест
Процедура ТриПричиныОтказаPushДаютТриРазныхСообщения() Экспорт

	Приватный = Засев.ПулСервисом(УникальныеИмена.Имя("hidden"), "private");
	Чужак = Стенд.Учётка();

	Невидим = Опубликовать(Приватный, Чужак, УникальныеИмена.Имя("blind"), "1.0.0");
	Ожидаем.Что(Невидим.Код, "невидимый пул → 403").Равно(403);
	Ожидаем.Что(Невидим.Сообщение, "названа настоящая причина: пул не виден").Содержит("не виден");

	Открытый = Засев.ПулСервисом();
	Мейнтейнер = Стенд.УчёткаСРолью(Открытый);
	ИмяЗанятое = УникальныеИмена.Имя("busy");
	Ожидаем.Что(Опубликовать(Открытый, Мейнтейнер, ИмяЗанятое, "1.0.0").Успех,
		"имя занято настоящей публикацией").ЭтоИстина();

	Занято = Опубликовать(Открытый, Стенд.Учётка(), ИмяЗанятое, "2.0.0");
	Ожидаем.Что(Занято.Код, "push в чужой существующий пакет → 403").Равно(403);
	Ожидаем.Что(Занято.Сообщение, "названа настоящая причина: имя занято").Содержит("уже занято");

	ИмяБезОчереди = УникальныеИмена.Имя("noq");
	БезОчереди = ПубликацияБезОчереди().Опубликовать(Открытый.Имя,
		ПостроитьOspxДанные(ИмяБезОчереди, "1.0.0"),
		СтрШаблон("%1-1.0.0.ospx", ИмяБезОчереди), "stable", Стенд.Учётка(), "");
	Ожидаем.Что(БезОчереди.Код, "очередь не собрана → 403").Равно(403);
	Ожидаем.Что(БезОчереди.Сообщение, "названа настоящая причина: очереди нет")
		.Содержит("очередь заявок на этом хабе не собрана");

	// три причины — три разных текста, и ни одна не сваливает вину на дефолтный пул
	Ожидаем.Что(Невидим.Сообщение = Занято.Сообщение, "причины различимы (1 и 2)").ЭтоЛожь();
	Ожидаем.Что(Занято.Сообщение = БезОчереди.Сообщение, "причины различимы (2 и 3)").ЭтоЛожь();
	Ожидаем.Что(Невидим.Сообщение = БезОчереди.Сообщение, "причины различимы (1 и 3)").ЭтоЛожь();

	Для Каждого Текст Из СтрРазделить(Невидим.Сообщение + "|" + Занято.Сообщение
		+ "|" + БезОчереди.Сообщение, "|") Цикл
		Ожидаем.Что(СтрНайти(НРег(Текст), "дефолтн"),
			"недефолтный пул не поминает дефолтный: " + Текст).Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Тот же сервис публикации, но БЕЗ очереди заявок: желудь опционален, и несобранный
// означает «пути в очередь нет», а не «путь открыт».
Функция ПубликацияБезОчереди()
	Возврат Новый СервисПубликации(
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Желудь("ПриёмВерсии"),
		Желудь("СервисМетокВерсий"),
		Желудь("ПравилаИменования"), Желудь("ХранилищеАртефактов"),
		Желудь("ЗаписьЗанятогоМеста"), Желудь("СервисПрав"),
		Желудь("ДопускПринципала"), Желудь("СервисПравДоступа"),
		Желудь("ИздательСобытий"), Желудь("СервисНастроек"), Желудь("ИмяОбъектаАудита"),
		Желудь("СобытиеАудита"), Неопределено, Неопределено, ЛогТестов());
КонецФункции

// Подключает заглушку ПроверяющийПодписиОтсутствует КАК ТИП после сборки контейнера: поздние типы ОСень не сканирует.
Процедура ПодключитьБоевойПроверяющий()
	РеестрФикстур.Подключить("ПроверяющийПодписиОтсутствует");
КонецПроцедуры

Функция Входящие()
	Возврат Желудь("СервисВходящих");
КонецФункции

Функция Рассмотрение()
	Возврат Желудь("РассмотрениеВходящих");
КонецФункции

Функция Резерв()
	Возврат Желудь("СервисРезервированияИмён");
КонецФункции

Функция Доверие()
	Возврат Желудь("СервисДоверияCI");
КонецФункции

Функция ФейкПодписи()
	Возврат Желудь("ПроверяющийПодписиCI");
КонецФункции

Функция ИздательGitHub()
	Возврат "https://token.actions.githubusercontent.com";
КонецФункции

// Записи журнала аудита по объекту и действию — читаем из ХРАНИЛИЩА, а не у шины:
// подписка службы на тип события — такая же часть пути, как и публикация.
Функция ЗаписиАудита(Знач Объект, Знач Действие)

	Результат = Новый Массив();
	Для Каждого Запись Из ЖурналАудита().Последние(200) Цикл
		Если Строка(Запись.Объект) = Объект И Строка(Запись.Действие) = Действие Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Опубликовать(Знач Пул, Знач Пользователь, Знач ИмяПакета, Знач Версия)
	Данные = ПостроитьOspxДанные(ИмяПакета, Версия);
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Пользователь, "");
КонецФункции

// Публикация, у которой в адресе стоял «?force=1».
Функция ОпубликоватьФорсом(Знач Пул, Знач Пользователь, Знач ИмяПакета, Знач Версия)
	Данные = ПостроитьOspxДанные(ИмяПакета, Версия);
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Пользователь, "",
		Неопределено, Истина);
КонецФункции

Функция НайтиВерсию(Знач Пул, Знач ИмяПакета, Знач СтрокаВерсии)
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Возврат Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, СтрокаВерсии);
КонецФункции

// Публикация с сырым токеном и БЕЗ пользователя — так приходит конвейер CI.
Функция ОпубликоватьТокеном(Знач Пул, Знач ИмяПакета, Знач Версия, Знач Токен)
	Данные = ПостроитьOspxДанные(ИмяПакета, Версия);
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Неопределено, Токен);
КонецФункции

// Кладёт заявку во «входящие» ШТАТНЫМ путём — через push без прав, а не записью в хранилище.
Функция ПодатьЗаявку(Знач Пул, Знач Заявитель, Знач ИмяПакета, Знач Версия)

	Результат = Опубликовать(Пул, Заявитель, ИмяПакета, Версия);
	Если Результат.Код <> 202 Тогда
		ВызватьИсключение СтрШаблон("Заявка не принята (%1): %2", Результат.Код, Результат.Сообщение);
	КонецЕсли;
	Возврат Результат.Заявка;

КонецФункции

// Собирает JWS compact с нужными клеймами; достоверность подписи решает ПроверяющийПодписиCI, а не содержимое сегмента.
Функция СобратьТокенКонвейера(Знач Издатель, Знач Репозиторий, Знач Конвейер, Знач Реф,
	Знач СекундДоИстечения)

	Заголовок = Новый Структура("alg, typ, kid", "RS256", "JWT", "test-key");

	Клеймы = Новый Структура();
	Клеймы.Вставить("iss", Издатель);
	Клеймы.Вставить("aud", "openhub");
	Клеймы.Вставить("exp", ЮниксСейчас() + СекундДоИстечения);
	Клеймы.Вставить("iat", ЮниксСейчас() - 10);
	Клеймы.Вставить("repository", Репозиторий);
	Если ЗначениеЗаполнено(Конвейер) Тогда
		Клеймы.Вставить("job_workflow_ref", Конвейер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Реф) Тогда
		Клеймы.Вставить("ref", Реф);
	КонецЕсли;

	Возврат Base64URL(ВJSON(Заголовок)) + "." + Base64URL(ВJSON(Клеймы)) + "." + Base64URL("подпись");

КонецФункции

Функция ЮниксСейчас()
	Возврат ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1);
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция Base64URL(Знач Текст)
	Значение = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"));
	Значение = СтрЗаменить(СтрЗаменить(Значение, Символы.ПС, ""), Символы.ВК, "");
	Значение = СтрЗаменить(СтрЗаменить(Значение, "+", "-"), "/", "_");
	Пока СтрЗаканчиваетсяНа(Значение, "=") Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	Возврат Значение;
КонецФункции

// СервисПулов, собранный НАПРЯМУЮ со своим резолвером настроек: опция гасится только
// в этом экземпляре, глобальное состояние набора не трогается.
Функция СервисПуловСОпцией(Знач ЛичныеРазрешены)

	Резолвер = Новый НастройкиЗаглушка();
	Резолвер.Задать("oshub.pools.personal_enabled", ЛичныеРазрешены);
	Настройки = Новый Массив();
	Настройки.Добавить(Резолвер);

	Возврат Новый СервисПулов(
		Желудь("ХранилищеПулов"), Желудь("УборкаПула"), Желудь("ПравилаИменования"),
		Желудь("ПространствоИмён"), Желудь("СервисАпстримовПула"),
		Желудь("КвотаПула"), Желудь("УчётОбъёмаПула"),
		Новый Массив(), Новый Массив(), Новый Массив(), Новый Массив(),
		Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Настройки);

КонецФункции

Функция СоздатьАдмина()
	Возврат Стенд.Учётка("admin");
КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия)
	Возврат Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия);
КонецФункции

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.очередь");
КонецФункции

#КонецОбласти

Функция ЖурналАудита()
	Возврат Новый ЖурналАудитаФайлом(Желудь("ЧитательЖурналаАудита"));
КонецФункции
