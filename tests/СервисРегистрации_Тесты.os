// Юнит-тесты СервисРегистрации: гейт первого запуска и режимы. На пустой БД самостоятельная
// регистрация запрещена в любом режиме — иначе аноним закрыл бы мастер /setup (first-run hijack).

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КлассыВхода;
Перем Фикстуры;

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подключить() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КлассыВхода = ОбъединитьПути(Модули, "вход", "Классы");
	Фикстуры = ОбъединитьПути(КаталогПроекта, "tests", "фикстуры");

	Подключить2(Фикстуры, "СервисПользователейЗаглушка");
	Подключить2(Фикстуры, "ПодтверждениеАдресаЗаглушка");
	Подключить2(Фикстуры, "НастройкиЗаглушка");
	Подключить2(КлассыВхода, "ПолитикаПарольногоВхода");
	Подключить2(КлассыВхода, "СервисРегистрации");
КонецПроцедуры

&Тест
Процедура НаПустойБДРегистрацияЗаблокированаОнбордингом() Экспорт

	Сервис = СервисСоСтабом(0, "open");

	Ожидаем.Что(Сервис.Регистрация.ЗаблокированаОнбордингом(), "флаг блокировки онбордингом").ЭтоИстина();

	Отклонено = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "eve", "eve@ex.com", "EveSecret1");

	Ожидаем.Что(Отклонено.Успех, "регистрация на пустой БД отклонена").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "registration_locked_onboarding") > 0,
		"код ошибки — гейт онбординга").ЭтоИстина();
	Ожидаем.Что(Сервис.Стаб.ПоследнийСозданный, "пользователь НЕ создан").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ГейтОнбордингаПеребиваетРежим() Экспорт

	// даже при disabled на пустой БД причина — гейт онбординга (проверяется ПЕРВЫМ)
	Сервис = СервисСоСтабом(0, "disabled");

	Отклонено = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "eve", "eve@ex.com", "EveSecret1");

	Ожидаем.Что(Отклонено.Успех).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "registration_locked_onboarding") > 0,
		"гейт онбординга приоритетнее режима").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПослеАдминаОткрытаяРегистрацияПроходит() Экспорт

	Сервис = СервисСоСтабом(1, "open"); // админ уже есть

	Ожидаем.Что(Сервис.Регистрация.ЗаблокированаОнбордингом(), "после админа гейт снят").ЭтоЛожь();

	Результат = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "bob", "bob@ex.com", "BobSecret1");

	Ожидаем.Что(Результат.Успех, "регистрация проходит").ЭтоИстина();
	Ожидаем.Что(Сервис.Стаб.ПоследнийСозданный <> Неопределено, "пользователь создан").ЭтоИстина();
	Ожидаем.Что(Сервис.Стаб.ПоследнийСозданный.Логин).Равно("bob");
	Ожидаем.Что(Сервис.Стаб.ПоследнийСозданный.Роль, "обычный пользователь").Равно("user");

КонецПроцедуры

&Тест
Процедура ПослеАдминаDisabledОтклоняет() Экспорт

	Сервис = СервисСоСтабом(1, "disabled");

	Отклонено = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "bob", "bob@ex.com", "BobSecret1");

	Ожидаем.Что(Отклонено.Успех).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "registration_disabled") > 0,
		"после админа disabled даёт свою причину").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СменаРежимаДействуетБезПересозданияСервиса() Экспорт

	// тот же ЭКЗЕМПЛЯР: режим меняют в настройках — сервис обязан увидеть новое значение без пересоздания
	Сервис = СервисСоСтабом(1, "open");

	Ожидаем.Что(Сервис.Регистрация.РегистрацияОткрыта(), "стартовый режим open").ЭтоИстина();

	Сервис.Настройки.Задать("oshub.auth.registration.mode", "disabled");

	Ожидаем.Что(Сервис.Регистрация.РегистрацияОткрыта(), "режим увиден без рестарта").ЭтоЛожь();
	Отклонено = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "carl", "c@ex.com", "CarlSecret1");
	Ожидаем.Что(Отклонено.Успех).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "registration_disabled") > 0,
		"после смены настройки причина — disabled").ЭтоИстина();

КонецПроцедуры

// Молча заведённая учётка, которой некуда выслать письмо, — это не «работает», а
// «сломано, и никто не заметил»: подтверждение обещано, а слать его нечем.
&Тест
Процедура ПриНенастроеннойПочтеРегистрацияОтказывает() Экспорт

	Сервис = СервисСоСтабом(1, "open");
	Сервис.Письма.ПодтверждениеСделатьНедостижимым(Истина);

	Ожидаем.Что(Сервис.Регистрация.ЗакрытаНенастроеннойПочтой(), "флаг заставы поднят")
		.ЭтоИстина();

	Отклонено = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "bob", "bob@ex.com", "BobSecret1");

	Ожидаем.Что(Отклонено.Успех, "регистрация отклонена").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "registration_mail_not_configured") > 0,
		"код причины назван: " + Отклонено.Сообщение).ЭтоИстина();
	Ожидаем.Что(Сервис.Стаб.ПоследнийСозданный, "учётная запись НЕ заведена").Равно(Неопределено);

	// отказ называет ОБЕ развилки — иначе администратор не знает, что ему делать
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "настроить почту") > 0,
		"развилка «настроить почту»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "выключить подтверждение") > 0,
		"развилка «выключить подтверждение»").ЭтоИстина();

КонецПроцедуры

// Выключенное подтверждение снимает условие: почты нет, регистрация работает,
// писем хаб не шлёт.
&Тест
Процедура ВыключенноеПодтверждениеСнимаетЗаставуПочты() Экспорт

	Сервис = СервисСоСтабом(1, "open");
	Сервис.Письма.ПодтверждениеСделатьНедостижимым(Ложь); // подтверждение выключено

	Ожидаем.Что(Сервис.Регистрация.ЗакрытаНенастроеннойПочтой(), "заставы нет").ЭтоЛожь();

	Результат = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "bob", "bob@ex.com", "BobSecret1");

	Ожидаем.Что(Результат.Успех, "регистрация проходит: " + Результат.Сообщение).ЭтоИстина();
	Ожидаем.Что(Сервис.Стаб.ПоследнийСозданный <> Неопределено, "учётка заведена").ЭтоИстина();

КонецПроцедуры

// Застава почты стоит ДО режима регистрации, но ПОСЛЕ гейта первого запуска: свежая
// инсталляция обязана сначала завести администратора, а он уже решит про почту.
&Тест
Процедура ГейтОнбордингаПеребиваетЗаставуПочты() Экспорт

	Сервис = СервисСоСтабом(0, "open");
	Сервис.Письма.ПодтверждениеСделатьНедостижимым(Истина);

	Отклонено = ПопытатьсяЗарегистрировать(Сервис.Регистрация, "eve", "eve@ex.com", "EveSecret1");

	Ожидаем.Что(Отклонено.Успех).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Отклонено.Сообщение, "registration_locked_onboarding") > 0,
		"на пустой БД причина — гейт онбординга, а не почта").ЭтоИстина();

КонецПроцедуры

// Возвращает {Регистрация, Стаб, Настройки, Письма}: Настройки.Задать(...) посреди теста
// моделирует правку режима через доменный API без пересоздания сервиса.
Функция СервисСоСтабом(Знач ЧислоПользователей, Знач Режим)
	Стаб = Новый СервисПользователейЗаглушка();
	Стаб.КоличествоПользователей = ЧислоПользователей;
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.registration.mode", Режим);
	// парольный вход в заглушке не задан — политика отвечает дефолтом реестра «включён»
	ПарольныйВход = Новый ПолитикаПарольногоВхода(Настройки);
	Письма = Новый ПодтверждениеАдресаЗаглушка();
	Возврат Новый Структура("Регистрация, Стаб, Настройки, Письма",
		Новый СервисРегистрации(Стаб, Настройки, ПарольныйВход, Письма, ЛогТеста()),
		Стаб, Настройки, Письма);
КонецФункции

Функция ПопытатьсяЗарегистрировать(Знач Регистрация, Знач Логин, Знач Email, Знач Пароль)
	Результат = Новый Структура("Успех, Сообщение", Истина, "");
	Попытка
		Регистрация.Зарегистрировать(Логин, Email, Пароль);
	Исключение
		Результат.Успех = Ложь;
		Результат.Сообщение = НРег(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Сервис создаётся напрямую, поэтому лог приезжает параметром: инъекция &Лог до объектов
// вне контейнера не доходит, а на отладочной записи такой сервис падает.
Функция ЛогТеста()
	Возврат Логирование.ПолучитьЛог("тест.oshub.регистрация");
КонецФункции

// Класс ищется по имени в каталоге и его подкаталогах: путь к файлу из имени не строится
// (docs/процесс/РАСКЛАДКА.md).
Процедура Подключить2(Знач КаталогКлассов, Знач ИмяКласса)
	ПоискКлассов.Подключить(КаталогКлассов, ИмяКласса);
КонецПроцедуры
