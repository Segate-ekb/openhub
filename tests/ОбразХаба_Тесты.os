// Сторож поставки в образе: версия хаба живёт ровно в packagedef, а состояние инсталляции
// (файл SQLite и журнал аудита) лежит на томах, а не в слое образа.

#Использовать asserts

Перем КаталогПроекта;
Перем ТекстМанифеста;
Перем ТекстDockerfile;
Перем ТекстСборщика;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	ТекстМанифеста = ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "packagedef"));
	ТекстDockerfile = ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "docker", "Dockerfile"));
	ТекстСборщика = ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "docker", "образ.sh"));

КонецПроцедуры

#Область ЕдинственнаяВерсия

&Тест
Процедура ВерсияПриложенияСовпадаетСМанифестом() Экспорт

	// Версию из ОписаниеПриложения отдаёт GET /health, версию из packagedef несёт имя .ospx
	// и метки образа. Разъехались — оператор видит в хабе не ту версию, что развернул.
	Ожидаем.Что(ВерсияПриложения(), "версия из src/модули/запуск/Классы/ОписаниеПриложения.os")
		.Равно(ВерсияМанифеста());

КонецПроцедуры

&Тест
Процедура ВерсияМанифестаЧитаемаяИЕдинственная() Экспорт

	// Самотест: пустая версия сделала бы сверку выше вечнозелёной, а вторая строка
	// `.Версия(...)` в манифесте развела бы этот разбор и sed из Dockerfile.
	Ожидаем.Что(ВерсияМанифеста(), "версия из packagedef").Заполнено();
	Ожидаем.Что(ВерсияПриложения(), "версия из ОписаниеПриложения").Заполнено();
	Ожидаем.Что(ОбъявленияВерсии(ТекстМанифеста).Количество(),
		"объявлений .Версия() с начала строки в packagedef").Равно(1);

КонецПроцедуры

&Тест
Процедура РазборВерсииНеВидитЗакомментированныхОбъявлений() Экспорт

	Образец = "	// .Версия(""9.9.9"") — так объявляется версия" + Символы.ПС
		+ "	.Версия(""1.2.3"")";

	Ожидаем.Что(СтрСоединить(ОбъявленияВерсии(Образец), ", "),
		"версии, увиденные разбором в образце с комментарием-примером").Равно("1.2.3");

КонецПроцедуры

&Тест
Процедура DockerfileНеПишетВерсиюРуками() Экспорт

	// Единственный законный номер версии в Dockerfile — тег базового образа.
	Ожидаем.Что(СтрСоединить(СтрокиСНомеромВерсии(ТекстDockerfile, "BASE_IMAGE"), " | "),
		"строки Dockerfile с захардкоженным номером версии: версия хаба берётся"
		+ " из packagedef на стадии сборки и вторым местом не пишется").Равно("");

КонецПроцедуры

&Тест
Процедура СборщикОбразаНеПишетВерсиюРуками() Экспорт

	Ожидаем.Что(СтрСоединить(СтрокиСНомеромВерсии(ТекстСборщика, ""), " | "),
		"строки docker/образ.sh с захардкоженным номером версии").Равно("");

КонецПроцедуры

&Тест
Процедура ВерсияБерётсяИзМанифестаОбоимиШагами() Экспорт

	Ожидаем.Что(СтрНайти(ТекстDockerfile, "packagedef") > 0,
		"Dockerfile вычитывает версию из packagedef").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстСборщика, "packagedef") > 0,
		"docker/образ.sh вычитывает версию из packagedef").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КонфигурацияОбраза

&Тест
Процедура ОбразСобираетсяПодЦелевуюПлатформу() Экспорт

	Ожидаем.Что(СтрНайти(ТекстСборщика, "--platform linux/amd64") > 0,
		"docker/образ.sh собирает под linux/amd64 (кластер такой, разработка — на arm64)")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбразСамодостаточенПоУмолчанию() Экспорт

	// `docker run` обязан поднимать работающий хаб без единой внешней системы: БД —
	// SQLite на томе, артефакты — файловый бэкенд там же. Прописанный в ENV s3
	// означал бы, что образ без внешнего хранилища не стартует вообще.
	Переменные = ПеременныеСредыОбраза();

	Ожидаем.Что(Переменные["OSHUB_DB_CONNECTOR"], "коннектор БД в образе").Равно("КоннекторSQLite");
	Ожидаем.Что(Переменные["OSHUB_STORAGE_BACKEND"],
		"бэкенд хранилища в ENV образа: не задан — работает файловый, S3 включает оператор")
		.Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОбразНеПеребиваетНастройкиСверхНеобходимого() Экспорт

	// Каждая переменная в ENV образа перебивает смонтированный autumn-properties.json
	// (мост окружения в src/main.os отдаёт им приоритет 3). Поэтому в образе живёт
	// только то, что является фактом контейнера, — расположение данных на томе.
	Разрешённые = "OSHUB_STORAGE_ROOT,OSHUB_DB_CONNECTOR,OSHUB_DB_CONNECTION";
	Лишние = Новый Массив();

	Для Каждого КлючЗначение Из ПеременныеСредыОбраза() Цикл
		Если СтрНайти("," + Разрешённые + ",", "," + КлючЗначение.Ключ + ",") = 0 Тогда
			Лишние.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"переменные в ENV образа сверх расположения данных на томе: они молча перебьют"
		+ " конфигурацию, которую оператор смонтировал файлом").Равно("");

КонецПроцедуры

&Тест
Процедура ОбразНеЗаводитАдминаПриСтарте() Экспорт

	Переменные = ПеременныеСредыОбраза();
	Заданные = Новый Массив();

	Для Каждого Имя Из СтрРазделить(
		"OSHUB_ADMIN_LOGIN,OSHUB_ADMIN_PASSWORD,OSHUB_ADMIN_PASSWORD_FILE", ",") Цикл
		Если Переменные[Имя] <> Неопределено Тогда
			Заданные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Заданные, ", "),
		"переменные безголового онбординга в ENV образа: хаб обязан подниматься чистым,"
		+ " первого администратора заводит мастер /setup").Равно("");

КонецПроцедуры

&Тест
Процедура ПоставкаНеНесётЗаполненныхДеталекАдмина() Экспорт

	// Второй канал безголового онбординга — детальки oshub.admin.*,
	// и autumn-properties.json теперь ЕДЕТ В ПАКЕТЕ. Заполненные логин/пароль в нём
	// заводят администратора при старте образа, минуя мастер, и уезжают в реестр
	// вместе с артефактом поставки. Раздела в файле нет вовсе — это сильнее пустых
	// сентинелов: ключ, лежащий в файле, отменяет свою переменную окружения ДАЖЕ пустым
	// (ЗНАНИЕ §3.0), то есть пустой сентинел ломал OSHUB_ADMIN_*. Появится раздел снова —
	// заполненным ему быть нельзя.
	Настройки = НастройкиАдминаИз(ПрочитатьФайл(ОбъединитьПути(КаталогПроекта,
		"autumn-properties.json")));
	Заполненные = Новый Массив();

	Для Каждого Ключ Из СтрРазделить("login,password,password_file", ",") Цикл
		Если Настройки.Свойство(Ключ) И ЗначениеЗаполнено(Настройки[Ключ]) Тогда
			Заполненные.Добавить("oshub.admin." + Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Заполненные, ", "),
		"заполненные детальки онбординга в autumn-properties.json, который едет в .ospx")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ДеталькиАдминаЧитаются() Экспорт

	// Самотест: сторож выше зелен потому, что раздела нет, — и обязан покраснеть,
	// если раздел вернётся заполненным. Проверяем это на синтетическом документе,
	// иначе «не нашёл ветку» и «ветка пуста» неразличимы и сторож вечнозелёный.
	Настройки = НастройкиАдминаИз("{""oshub"": {""admin"": {""login"": ""root"","
		+ " ""password"": ""p"", ""password_file"": ""/f""}}}");

	Для Каждого Ключ Из СтрРазделить("login,password,password_file", ",") Цикл
		Ожидаем.Что(Настройки.Свойство(Ключ),
			"разбор видит ключ oshub.admin." + Ключ + " там, где он есть").ЭтоИстина();
		Ожидаем.Что(ЗначениеЗаполнено(Настройки[Ключ]),
			"разбор видит ЗАПОЛНЕННЫЙ oshub.admin." + Ключ).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СостояниеИнсталляцииЛежитНаТомах() Экспорт

	Переменные = ПеременныеСредыОбраза();
	Тома = ТомаОбраза();

	Ожидаем.Что(Тома.Количество(), "объявленные тома образа").Больше(0);

	КореньХранилища = Переменные["OSHUB_STORAGE_ROOT"];
	Ожидаем.Что(КореньХранилища, "OSHUB_STORAGE_ROOT в образе").Заполнено();
	Ожидаем.Что(НаТоме(КореньХранилища, Тома),
		"корень хранилища (в нём журнал аудита <root>/аудит.log) на томе: в слое образа"
		+ " журнал безопасности не переживёт ни рестарт, ни обновление").ЭтоИстина();

	ФайлБазы = ПутьSQLiteИзСтрокиСоединения(Переменные["OSHUB_DB_CONNECTION"]);
	Ожидаем.Что(ФайлБазы, "путь к файлу SQLite из OSHUB_DB_CONNECTION").Заполнено();
	Ожидаем.Что(НаТоме(ФайлБазы, Тома), "файл SQLite на томе").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Версия из packagedef ПО ТОМУ ЖЕ ПРАВИЛУ, что и sed в Dockerfile: объявление считается
// только с начала строки. Разные правила извлечения «единственной версии» разошлись бы
// на первом же комментарии, показывающем пример вызова.
Функция ВерсияМанифеста()

	Объявления = ОбъявленияВерсии(ТекстМанифеста);

	Возврат ?(Объявления.Количество() = 0, "", Объявления[0]);

КонецФункции

Функция ОбъявленияВерсии(Знач Текст)

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("(?m)^[ \t]*\.Версия\(""([^""]+)""\)");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Текст) Цикл
		Результат.Добавить(Совпадение.Группы[1].Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВерсияПриложения()

	Путь = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули", "запуск"),
		"Классы", "ОписаниеПриложения.os");
	Отбор = Новый РегулярноеВыражение("(?s)Функция\s+Версия\(\)\s+Экспорт\s+Возврат\s+""([^""]+)""");
	Совпадения = Отбор.НайтиСовпадения(ПрочитатьФайл(Путь));

	Возврат ?(Совпадения.Количество() = 0, "", Совпадения[0].Группы[1].Значение);

КонецФункции

// Строки текста с номером вида X.Y.Z, кроме тех, где встречается разрешённая подстрока.
Функция СтрокиСНомеромВерсии(Знач Текст, Знач Разрешённое)

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("\d+\.\d+\.\d+");

	Для Каждого ТекущаяСтрока Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если НЕ Отбор.Совпадает(ТекущаяСтрока) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Разрешённое) И СтрНайти(ТекущаяСтрока, Разрешённое) > 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(СокрЛП(ТекущаяСтрока));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Переменные из директив ENV Dockerfile; комментарии отброшены, переносы строк склеены.
Функция ПеременныеСредыОбраза()

	Результат = Новый Соответствие();
	Отбор = Новый РегулярноеВыражение("([A-Z][A-Z0-9_]*)=(""[^""]*""|\S+)");

	Для Каждого Директива Из ДирективыDockerfile("ENV") Цикл
		Для Каждого Совпадение Из Отбор.НайтиСовпадения(Директива) Цикл
			Результат.Вставить(Совпадение.Группы[1].Значение,
				БезКавычек(Совпадение.Группы[2].Значение));
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТомаОбраза()

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("""([^""]+)""|(/\S+)");

	Для Каждого Директива Из ДирективыDockerfile("VOLUME") Цикл
		Для Каждого Совпадение Из Отбор.НайтиСовпадения(Директива) Цикл
			Значение = ?(ЗначениеЗаполнено(Совпадение.Группы[1].Значение),
				Совпадение.Группы[1].Значение, Совпадение.Группы[2].Значение);
			Если ЗначениеЗаполнено(Значение) Тогда
				Результат.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Аргументы директив с заданным именем: строки-комментарии выброшены, продолжения "\" склеены.
Функция ДирективыDockerfile(Знач ИмяДирективы)

	Значимые = Новый Массив();
	Для Каждого ТекущаяСтрока Из СтрРазделить(ТекстDockerfile, Символы.ПС) Цикл
		Если НЕ СтрНачинаетсяС(СокрЛП(ТекущаяСтрока), "#") Тогда
			Значимые.Добавить(ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;

	Склеенный = СтрЗаменить(СтрСоединить(Значимые, Символы.ПС), "\" + Символы.ПС, " ");

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("(?m)^\s*" + ИмяДирективы + "\s+(.*)$");
	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Склеенный) Цикл
		Результат.Добавить(Совпадение.Группы[1].Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПутьSQLiteИзСтрокиСоединения(Знач СтрокаСоединения)

	Если НЕ ЗначениеЗаполнено(СтрокаСоединения) Тогда
		Возврат "";
	КонецЕсли;

	Отбор = Новый РегулярноеВыражение("(?i)Data\s+Source\s*=\s*([^;]+)");
	Совпадения = Отбор.НайтиСовпадения(СтрокаСоединения);

	Возврат ?(Совпадения.Количество() = 0, "", СокрЛП(Совпадения[0].Группы[1].Значение));

КонецФункции

Функция НаТоме(Знач Путь, Знач Тома)

	Для Каждого Том Из Тома Цикл
		Если Путь = Том ИЛИ СтрНачинаетсяС(Путь, Том + "/") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Ветка oshub.admin из autumn-properties.json; отсутствующие ключи — пустая структура.
Функция НастройкиАдминаИз(Знач Документ)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Документ);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	// ПрочитатьJSON отдаёт Структуру, а обращение к отсутствующему свойству у неё —
	// исключение, а не Неопределено: раздела admin в файле нет, и это норма.
	Раздел = Данные["oshub"];
	Если Раздел = Неопределено ИЛИ НЕ Раздел.Свойство("admin") Тогда
		Возврат Новый Структура();
	КонецЕсли;

	Результат = Новый Структура();
	Для Каждого КлючЗначение Из Раздел["admin"] Цикл
		Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БезКавычек(Знач Значение)
	Возврат СтрЗаменить(Значение, """", "");
КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Содержимое = Неопределено, "", Содержимое);

КонецФункции

#КонецОбласти
