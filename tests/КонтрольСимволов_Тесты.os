// Примитив основа/КонтрольСимволов: что означает код символа и как обойти строку в его
// поисках. Проверяется значение — границы диапазонов (31/32, 126/127, разрывы Юникода),
// имя символа для текста отказа и очистка короткой метки.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Контроль;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);

КонецПроцедуры

&ПередКаждым
Процедура СобратьКонтроль() Экспорт
	Контроль = Новый КонтрольСимволов();
КонецПроцедуры

#Область ГраницыДиапазонов

&Тест
Процедура УправляющийC0КончаетсяНаПробеле() Экспорт

	Ожидаем.Что(Контроль.ЭтоУправляющийC0(0), "нулевой байт — управляющий").ЭтоИстина();
	Ожидаем.Что(Контроль.ЭтоУправляющийC0(31), "код 31 — последний управляющий C0").ЭтоИстина();
	Ожидаем.Что(Контроль.ЭтоУправляющийC0(32), "пробел управляющим C0 не считается").ЭтоЛожь();
	Ожидаем.Что(Контроль.ЭтоУправляющийC0(127), "DEL в C0 не входит: это отдельный вопрос")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура DELОтличёнОтОстальных() Экспорт

	Ожидаем.Что(Контроль.ЭтоDEL(127), "127 — DEL").ЭтоИстина();
	Ожидаем.Что(Контроль.ЭтоDEL(126), "126 — печатный «~»").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РазрывыЮникодаНазваныПоимённо() Экспорт

	Для Каждого Код Из СтрРазделить("133,160,8232,8233", ",") Цикл
		Ожидаем.Что(Контроль.ЭтоРазрывЮникода(Число(Код)),
			СтрШаблон("код %1 делит строку", Код)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Контроль.ЭтоРазрывЮникода(32), "пробел разрывом не считается").ЭтоЛожь();
	Ожидаем.Что(Контроль.ЭтоРазрывЮникода(1040), "кириллическая «А» разрывом не считается")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПечатнаяЛатиницаЭтоОтВосклицанияДоТильды() Экспорт

	Ожидаем.Что(Контроль.ЭтоПечатнаяЛатиница(32), "пробел в заголовок не годится").ЭтоЛожь();
	Ожидаем.Что(Контроль.ЭтоПечатнаяЛатиница(33), "«!» — первый печатный").ЭтоИстина();
	Ожидаем.Что(Контроль.ЭтоПечатнаяЛатиница(126), "«~» — последний печатный").ЭтоИстина();
	Ожидаем.Что(Контроль.ЭтоПечатнаяЛатиница(127), "DEL печатным не является").ЭтоЛожь();
	Ожидаем.Что(Контроль.ЭтоПечатнаяЛатиница(1040), "кириллица печатной латиницей не является")
		.ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ИмяДляТекстаОтказа

&Тест
Процедура ИмяКодаНеПодставляетСамСимвол() Экспорт

	Ожидаем.Что(Контроль.ИмяКода(32), "пробел назван словом").Равно("пробел");
	Ожидаем.Что(Контроль.ИмяКода(13), "перенос назван кодом, а не подставлен").Равно("код 13");
	Ожидаем.Что(Контроль.ИмяКода(10), "код печатается без разделителей групп").Равно("код 10");
	Ожидаем.Что(Контроль.ИмяКода(0), "нулевой код не превращается в пустую строку")
		.Равно("код 0");

КонецПроцедуры

#КонецОбласти

#Область ОбходСтроки

&Тест
Процедура ПервыйУправляющийИлиПробелНазываетИменноПервый() Экспорт

	Ожидаем.Что(Контроль.ПервыйУправляющийИлиПробел("https://хаб.example/путь"),
		"чистый адрес не даёт имени").Равно("");
	Ожидаем.Что(Контроль.ПервыйУправляющийИлиПробел("https://хаб example"),
		"пробел найден и назван").Равно("пробел");
	Ожидаем.Что(Контроль.ПервыйУправляющийИлиПробел("https://хаб" + Символы.ВК + " и пробел"),
		"первым назван возврат каретки, а не пробел за ним").Равно("код 13");
	Ожидаем.Что(Контроль.ПервыйУправляющийИлиПробел("хаб" + Символ(127)),
		"DEL тоже управляющий").Равно("код 127");

КонецПроцедуры

&Тест
Процедура ЕстьУправляющийПробеломНеСрабатывает() Экспорт

	Ожидаем.Что(Контроль.ЕстьУправляющий("refs/heads/main"), "обычный реф чист").ЭтоЛожь();
	Ожидаем.Что(Контроль.ЕстьУправляющий("refs/heads/ветка с пробелом"),
		"пробел управляющим не считается").ЭтоЛожь();
	Ожидаем.Что(Контроль.ЕстьУправляющий("refs" + Символы.ПС + "/heads"),
		"перевод строки найден").ЭтоИстина();
	Ожидаем.Что(Контроль.ЕстьУправляющий("refs" + Символ(127)), "DEL найден").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЕстьУправляющийПробелИлиРазрывЛовитИЮникодные() Экспорт

	Ожидаем.Что(Контроль.ЕстьУправляющийПробелИлиРазрыв("alice"), "логин чист").ЭтоЛожь();
	Ожидаем.Что(Контроль.ЕстьУправляющийПробелИлиРазрыв("ali ce"), "пробел найден").ЭтоИстина();
	Ожидаем.Что(Контроль.ЕстьУправляющийПробелИлиРазрыв("ali" + Символ(160) + "ce"),
		"неразрывный пробел найден").ЭтоИстина();
	Ожидаем.Что(Контроль.ЕстьУправляющийПробелИлиРазрыв("ali" + Символ(8232) + "ce"),
		"разделитель строк Юникода найден").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПервыйВнеПечатнойЛатиницыНазываетНарушителя() Экспорт

	Ожидаем.Что(Контроль.ПервыйВнеПечатнойЛатиницы("ghp_0123456789abcdef"),
		"токен из печатной латиницы принят").Равно("");
	Ожидаем.Что(Контроль.ПервыйВнеПечатнойЛатиницы("ghp 0123"),
		"пробел в заголовке авторизации недопустим").Равно("пробел");
	Ожидаем.Что(Контроль.ПервыйВнеПечатнойЛатиницы("ghp" + Символы.ПС + "0123"),
		"перевод строки назван кодом").Равно("код 10");
	Ожидаем.Что(Контроль.ПервыйВнеПечатнойЛатиницы("токен"),
		"кириллица в заголовок не едет").Равно("код 1090");

КонецПроцедуры

#КонецОбласти

#Область ОчисткаКороткойМетки

&Тест
Процедура ОчисткаСнимаетУправляющиеИОбрамляющиеПробелы() Экспорт

	Ожидаем.Что(Контроль.Очистить("  opm" + Символы.ПС + " CLI  ", 120),
		"перевод строки выброшен, обрамление снято").Равно("opm CLI");
	Ожидаем.Что(Контроль.Очистить(Неопределено, 120), "Неопределено — пустая метка").Равно("");

КонецПроцедуры

&Тест
Процедура ОчисткаОбрезаетПоПределу() Экспорт

	Длинное = "";
	Для Счётчик = 1 По 200 Цикл
		Длинное = Длинное + "x";
	КонецЦикла;

	Ожидаем.Что(СтрДлина(Контроль.Очистить(Длинное, 64)), "предел 64 соблюдён").Равно(64);
	Ожидаем.Что(СтрДлина(Контроль.Очистить(Длинное, 120)), "предел 120 соблюдён").Равно(120);
	Ожидаем.Что(Контроль.Очистить("короткое", 120), "короткое не трогается").Равно("короткое");

КонецПроцедуры

&Тест
Процедура ОчисткаDELНеТрогает() Экспорт

	Ожидаем.Что(Контроль.Очистить("имя" + Символ(127), 120),
		"DEL печатной меткой не мешает и остаётся: убирают только C0")
		.Равно("имя" + Символ(127));

КонецПроцедуры

#КонецОбласти
