// Таблица решений пульта личных пространств: что он делает с настройкой и когда зовёт
// домен. Домен подменён заглушкой — здесь проверяется РЕШЕНИЕ, а не работа службы.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров web-ui
Перем Кабинет;     // РендерерКабинета (кабинет)
Перем Разбор;      // РазборФормы (кабинет)
Перем Ошибки;      // ТекстОшибки (основа)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ХранилищеНастроекВПамяти");
	РеестрФикстур.Подключить("ИздательНастроекЗаглушка");
	РеестрФикстур.Подключить("СлужбаПространствЗаглушка");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Попытка
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"),
			"ИмяОбъектаАудита.os"), "ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КаталогОбщего = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "общее");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(КаталогОбщего, "РендерерКабинета");
	Поиск.Подключить(КаталогОбщего, "РазборФормы");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");

	КаталогSettings = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	Поиск.Подключить(КаталогSettings, "ВидыПроверок");
	Поиск.Подключить(КаталогSettings, "НастройкиПодсистем");
	Поиск.Подключить(КаталогSettings, "РеестрНастроек");
	Поиск.Подключить(КаталогSettings, "СервисНастроек");
	Поиск.Подключить(КаталогSettings, "ВалидаторНастроек");

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "настройки");
	Поиск.Подключить(КаталогНастроек, "РаскладкаНастроекХаба");
	Поиск.Подключить(КаталогНастроек, "ПоляНастроек");
	Поиск.Подключить(КаталогНастроек, "ВитринаНастроек");
	Поиск.Подключить(КаталогНастроек, "ВитринаЛичныхПространств");
	Поиск.Подключить(КаталогНастроек, "ИтогПульта");
	Поиск.Подключить(КаталогНастроек, "ПультЛичныхПространств");

	Кабинет = Новый РендерерКабинета(UI.Каркас, UI.Экран, Новый ЗащитаCSRF(Неопределено), UI.Набор, UI.Тексты);
	Разбор = Новый РазборФормы();
	Ошибки = Новый ТекстОшибки();

КонецПроцедуры

#Область ВыключениеТолькоКакПереход

// Форма подтверждения — не бессрочная кнопка сноса: при уже выключенной настройке
// операция отвергается и домен не зовётся вовсе.
&Тест
Процедура ПриВыключеннойНастройкеПодтверждениеНичегоНеСносит() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Служба.ЗадатьСводку(3);
	Стенд.Настройки.Установить("oshub.pools.personal_enabled", Ложь, "тест");

	Итог = Стенд.Пульт.Применить("pools", ФормаПодтверждения("3"), "root");

	Ожидаем.Что(Итог.Перехвачено, "пульт распорядился сам").ЭтоИстина();
	Ожидаем.Что(Итог.Ошибка, "и отказал: сносить нечего")
		.Содержит("уже выключены");
	Ожидаем.Что(Стенд.Служба.СносовВызвано, "домен не позван ни разу").Равно(0);

	// КОНТРОЛЬ: та же форма при ВКЛЮЧЁННОЙ настройке операцию выполняет
	Стенд.Настройки.Сбросить("oshub.pools.personal_enabled", "тест");
	Стенд.Служба.ЗадатьИтогСноса(3, 0);
	Ожидаем.Что(Стенд.Пульт.Применить("pools", ФормаПодтверждения("3"), "root").Ошибка,
		"КОНТРОЛЬ: при включённой настройке отказа нет").Равно("");
	Ожидаем.Что(Стенд.Служба.СносовВызвано, "и домен позван").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЧастичныйСбойСноса

// Частичный снос НЕ выключает настройку: иначе тумблер погас бы, перехода не осталось,
// а живые пространства доделать было бы нечем. Отказ называет оба числа.
&Тест
Процедура ЧастичныйСносОставляетНастройкуВключённой() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Служба.ЗадатьСводку(5);
	Стенд.Служба.ЗадатьИтогСноса(4, 1);

	Итог = Стенд.Пульт.Применить("pools", ФормаПодтверждения("5"), "root");

	Ожидаем.Что(Итог.Ошибка, "частичный снос отчитался отказом, а не «сохранено»")
		.Содержит("снести не удалось");
	Ожидаем.Что(Итог.Ошибка, "и назвал число снесённых").Содержит("4");
	Ожидаем.Что(Итог.Спросить <> Неопределено, "окно предупреждения показано снова").ЭтоИстина();
	Ожидаем.Что(Стенд.Настройки.Значение("oshub.pools.personal_enabled"),
		"настройка осталась включённой — операцию можно повторить").ЭтоИстина();

КонецПроцедуры

// Полный снос настройку выключает: перехода больше нет, тумблер погашен.
&Тест
Процедура ПолныйСносВыключаетНастройку() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Служба.ЗадатьСводку(2);
	Стенд.Служба.ЗадатьИтогСноса(2, 0);

	Итог = Стенд.Пульт.Применить("pools", ФормаПодтверждения("2"), "root");

	Ожидаем.Что(Итог.Ошибка, "отказа нет").Равно("");
	Ожидаем.Что(Итог.Уведомление, "итог назвал число снесённых").Содержит("2");
	Ожидаем.Что(Стенд.Настройки.Значение("oshub.pools.personal_enabled"),
		"настройка выключена").ЭтоЛожь();

КонецПроцедуры

// Упавший снос не оставляет настройку выключенной и не отдаёт голое исключение.
&Тест
Процедура УпавшийСносНеВыключаетНастройкуИНеРоняетЗапрос() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Служба.ЗадатьСводку(2);
	Стенд.Служба.РонятьСнос();

	Итог = Стенд.Пульт.Применить("pools", ФормаПодтверждения("2"), "root");

	Ожидаем.Что(Итог.Ошибка, "исключение превращено во внятный отказ")
		.Содержит("не выполнен");
	Ожидаем.Что(Стенд.Настройки.Значение("oshub.pools.personal_enabled"),
		"настройка осталась включённой").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Включение

// Число учёток, оставшихся без пространства, печатается в итоге: молчание про них
// означало бы «всё в порядке» при обратном.
&Тест
Процедура ИтогВключенияПечатаетЧислоОставшихсяБезПространства() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Настройки.Установить("oshub.pools.personal_enabled", Ложь, "тест");
	Стенд.Служба.ЗадатьИтогРаздачи(7, 1, 2, 3);

	Итог = Стенд.Пульт.Применить("pools", ФормаТумблера("1"), "root");

	Ожидаем.Что(Итог.Ошибка, "включение выполнено").Равно("");
	Ожидаем.Что(Итог.Уведомление, "создано названо").Содержит("создано — 7");
	Ожидаем.Что(Итог.Уведомление, "пропущенные отключённые названы").Содержит("отключённых учёток — 2");
	Ожидаем.Что(Итог.Уведомление, "и оставшиеся без пространства — тоже")
		.Содержит("без пространства — 3");

КонецПроцедуры

// Порядок «записать настройку → раздать»: домен спрашивает настройку, и к МОМЕНТУ
// вызова она обязана быть уже включена — иначе раздача пропустит всех до единого.
// Значение снимается заглушкой ВНУТРИ вызова, а не после него: проверяется порядок.
&Тест
Процедура КМоментуРаздачиНастройкаУжеВключена() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Настройки.Установить("oshub.pools.personal_enabled", Ложь, "тест");
	Стенд.Служба.НаблюдатьЗа(Стенд.Настройки);
	Стенд.Служба.ЗадатьИтогРаздачи(1, 0, 0, 0);

	Стенд.Пульт.Применить("pools", ФормаТумблера("1"), "root");

	Ожидаем.Что(Стенд.Служба.РаздачВызвано, "раздача позвана").Равно(1);
	Ожидаем.Что(Стенд.Служба.НастройкаПриРаздаче,
		"на входе в раздачу настройка уже включена").ЭтоИстина();

КонецПроцедуры

// Обратный порядок у сноса: настройка выключается ТОЛЬКО после него, поэтому к моменту
// вызова она ещё включена — иначе частичный сбой погасил бы тумблер вместе с переходом.
&Тест
Процедура КМоментуСносаНастройкаЕщёВключена() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Служба.НаблюдатьЗа(Стенд.Настройки);
	Стенд.Служба.ЗадатьСводку(2);
	Стенд.Служба.ЗадатьИтогСноса(2, 0);

	Стенд.Пульт.Применить("pools", ФормаПодтверждения("2"), "root");

	Ожидаем.Что(Стенд.Служба.СносовВызвано, "снос позван").Равно(1);
	Ожидаем.Что(Стенд.Служба.НастройкаПриСносе,
		"на входе в снос настройка ещё включена").ЭтоИстина();
	Ожидаем.Что(Стенд.Настройки.Значение("oshub.pools.personal_enabled"),
		"а после успешного сноса — выключена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Стенд

Функция ПостроитьСтенд()

	Реестр = Новый РеестрНастроек(Новый ВидыПроверок(),
		Новый НастройкиПодсистем(Новый ВидыПроверок()));
	Хранилище = Новый ХранилищеНастроекВПамяти();
	Настройки = Новый СервисНастроек(Реестр, Хранилище, Новый ИздательНастроекЗаглушка(),
		Новый ИмяОбъектаАудита(), Новый ВалидаторНастроек());
	Раскладка = Новый РаскладкаНастроекХаба();
	ПоляКарточек = Новый ПоляНастроек(Реестр, UI.Кит, UI.Тексты);
	Витрина = Новый ВитринаНастроек(Настройки, Раскладка, ПоляКарточек, UI.Кит,
		UI.РендерерНастроек, UI.Тексты);
	ВитринаОкна = Новый ВитринаЛичныхПространств(UI.Кит, UI.РендерерНастроек, UI.Тексты);
	Служба = Новый СлужбаПространствЗаглушка();

	Пульт = Новый ПультЛичныхПространств(Разбор, Настройки, Раскладка, ПоляКарточек,
		ВитринаОкна, Служба, Новый ИтогПульта(), Ошибки, UI.Тексты);

	Возврат Новый Структура("Настройки, Хранилище, Витрина, Служба, Пульт",
		Настройки, Хранилище, Витрина, Служба, Пульт);

КонецФункции

Функция ФормаПодтверждения(Знач Эхо)
	Форма = Новый Соответствие();
	Форма.Вставить("операция", "личные-пространства");
	Форма.Вставить("подтверждение", Эхо);
	Возврат Форма;
КонецФункции

Функция ФормаТумблера(Знач Значение)
	Форма = Новый Соответствие();
	Форма.Вставить("oshub.pools.personal_enabled", Значение);
	Возврат Форма;
КонецФункции

#КонецОбласти
