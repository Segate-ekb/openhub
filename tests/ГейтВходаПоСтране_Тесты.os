// Гейт «провайдер закрыт посетителю по стране» (ИСТ-ДОСТ-037, часть 2) на значении:
// настоящее правило над настоящим хранилищем, настоящий определитель над пробной базой.
// Отбит посетитель закрытой страны и посетитель с неизвестной страной, открытой стране
// вход не мешают вовсе, сбой чтения правил закрывает вход (НФТ-ДОСТ-009), а пока правил
// нет — определителя не спрашивают ни разу.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя
Перем Проба;          // фикстура БазаСтранПробная
Перем Настройки;      // НастройкиЗаглушка
Перем База;           // БазаСтран (гео)
Перем Определитель;   // ОпределительСтраны (гео)
Перем Хранилище;      // ХранилищеГеоправилСВмешательством — таблица правил под рукой
Перем Правило;        // ГеоправилоПровайдера над этим хранилищем
Перем Гейт;           // ГейтВходаПоСтране над правилом и определителем
Перем Ловушка;        // ЛовушкаЛога — что гейт написал в журнал приложения
Перем Песочница;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("БазаСтранПробная");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	РеестрФикстур.Подключить("ФейкПарольногоВхода");
	РеестрФикстур.Подключить("ХранилищеГеоправилСВмешательством");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ЧасыРучные");

	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "гео", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "СвояСеть");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей, "наблюдаемость",
		"Классы/журнал/ОбезличиваниеЖурнала.os"));

	КаталогПровайдеров = ОбъединитьПути(КаталогМодулей, "вход", "Классы/провайдером");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПровайдеров, "ГеоправилоПровайдера.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПровайдеров, "ГейтВходаПоСтране.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПровайдеров, "ЗаказНаблюдаемыхСтран.os"));

	КаталогЭкранов = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогЭкранов, "настройки/хаб"), "СостояниеБазыСтран");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогЭкранов, "общее"), "АтрибуцияБазыСтран");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "гео", "Классы"), "ПосетительЗапроса");

КонецПроцедуры

&ПередКаждым
Процедура СобратьСтенд() Экспорт

	Проба = Новый БазаСтранПробная();
	Песочница = УникальныеИмена.ВременныйКаталог("гео-гейт");
	Ловушка = Новый ЛовушкаЛога();

	Настройки = Новый НастройкиЗаглушка();
	Канон = Новый КанонIP();
	База = Новый БазаСтран(Настройки, Новый ЗапускВФонеСинхронный(), ЛогСЛовушкой());
	Определитель = Новый ОпределительСтраны(База, Новый СвояСеть(Канон), Канон, Настройки);

	Настройки.Задать(База.КлючПути(), ПутьБазы());
	Проба.Положить(ПутьБазы());

	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Правило = Новый ГеоправилоПровайдера(Хранилище, Новый СправочникСтран(),
		Новый СписокЧерезЗапятую(), Неопределено, Новый ФейкПарольногоВхода(Истина),
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Определитель);
	Гейт = Новый ГейтВходаПоСтране(Правило, Определитель, ЛогСЛовушкой(), Новый ТекстОшибки());

КонецПроцедуры

&ПослеКаждого
Процедура УбратьПесочницу() Экспорт
	УникальныеИмена.УбратьВременное(Песочница);
КонецПроцедуры

#Область БезПравил

// Запрос, которому страна не нужна, за неё не платит ничем: определителя не спрашивают
// ни разу, и файл базы не открывается вовсе.
&Тест
Процедура БезПравилОпределительНеЗовётсяВовсе() Экспорт

	Вердикт = Гейт.Закрыт("github", ПосетительИз(Проба.РоссийскийIPv4()));

	Ожидаем.Что(Вердикт.Закрыт, "правил нет — провайдер открыт").ЭтоЛожь();
	Ожидаем.Что(Гейт.ОбращенийКОпределителю(),
		"определителя не спрашивали ни разу").Равно(0);
	Ожидаем.Что(База.ПрочтенийФайла(), "и файл базы не читали").Равно(0);

КонецПроцедуры

// Список кнопок без правил остаётся ровно тем же и тоже ничего не спрашивает.
&Тест
Процедура БезПравилСписокПровайдеровНеФильтруется() Экспорт

	Открытые = Гейт.ПровайдерыДляПосетителя(Провайдеры("github, gitlab"),
		ПосетительИз(Проба.РоссийскийIPv4()));

	Ожидаем.Что(Открытые.Количество(), "оба провайдера предложены").Равно(2);
	Ожидаем.Что(Гейт.ОбращенийКОпределителю(), "страну не спрашивали").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СПравилом

&Тест
Процедура ПосетительИзЗакрытойСтраныОтбит() Экспорт

	Закрыть("github", "RU");

	Вердикт = Гейт.Закрыт("github", ПосетительИз(Проба.РоссийскийIPv4()));

	Ожидаем.Что(Вердикт.Закрыт, "посетитель из закрытой страны отбит").ЭтоИстина();
	Ожидаем.Что(Вердикт.Страна, "страна определена по встроенной базе").Равно("RU");
	Ожидаем.Что(Гейт.Отказов(), "отказ сосчитан").Равно(1);

КонецПроцедуры

// Страна известна и в списке правила её нет: такому посетителю провайдер открыт.
&Тест
Процедура ПосетительИзНазваннойНоОткрытойСтраныПроходит() Экспорт

	Закрыть("github", "RU");
	Закрыть("gitlab", "DE");

	Вердикт = Гейт.Закрыт("gitlab", ПосетительИз(Проба.РоссийскийIPv4()));

	Ожидаем.Что(Вердикт.Закрыт, "правило gitlab про Россию не говорит").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Страна, "КОНТРОЛЬ: страна всё-таки определена").Равно("RU");
	Ожидаем.Что(Гейт.Отказов(), "отказов не было").Равно(0);

КонецПроцедуры

// Адрес публичный, но ни в одну наблюдаемую страну не попал — закрывать нечего.
&Тест
Процедура ПосетительИзНеНаблюдаемойСтраныПроходит() Экспорт

	Закрыть("github", "RU");

	Вердикт = Гейт.Закрыт("github", ПосетительИз(Проба.НемецкийIPv4()));

	Ожидаем.Что(Вердикт.Закрыт, "не из наблюдаемых стран — провайдер открыт").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Исход, "и исход назван именно так")
		.Равно(Определитель.Исходы().НеНаблюдаемая);

КонецПроцедуры

// Не смог проверить — откажи: страна не определилась, и при живом правиле посетитель
// считается пришедшим из закрытой страны.
&Тест
Процедура НеизвестнаяСтранаПриЖивомПравилеОтбита() Экспорт

	Закрыть("github", "RU");

	Петля = Гейт.Закрыт("github", ПосетительИз("127.0.0.1"));
	Ожидаем.Что(Петля.Закрыт, "петлевой адрес — страна неизвестна, вход закрыт").ЭтоИстина();

	Никакой = Гейт.Закрыт("github", Неопределено);
	Ожидаем.Что(Никакой.Закрыт, "о посетителе не известно ничего — тоже закрыт").ЭтоИстина();

	Ожидаем.Что(Гейт.Отказов(), "оба отказа сосчитаны").Равно(2);

КонецПроцедуры

// Кнопка и отказ спрашивают одно правило: закрытый провайдер не предлагается вовсе.
&Тест
Процедура ЗакрытыйПровайдерВСпискеНеПредлагается() Экспорт

	Закрыть("github", "RU");

	Открытые = Гейт.ПровайдерыДляПосетителя(Провайдеры("github, gitlab"),
		ПосетительИз(Проба.РоссийскийIPv4()));

	Ожидаем.Что(Открытые.Количество(), "остался один провайдер").Равно(1);
	Ожидаем.Что(Открытые[0].Имя, "и это тот, у которого правила нет").Равно("gitlab");
	// список кнопок — не попытка входа: отказом он не считается и в счётчик не идёт
	Ожидаем.Что(Гейт.Отказов(), "список кнопок отказом не считается").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область НеПроверилОткажи

// Недоступная таблица правил — исключение, и гейт обязан превратить его в ОТКАЗ:
// ответ «открыт» здесь был бы fail-open одной строкой (НФТ-ДОСТ-009). Правило берётся
// холодное: прогретый снимок отвечает и при лежащей базе, а под ударом тут именно тот
// под, который поднялся, когда база уже не отвечала.
&Тест
Процедура СбойЧтенияПравилЗакрываетВход() Экспорт

	Слепой = ГейтНадЛежащейТаблицей();

	Вердикт = Слепой.Закрыт("github", ПосетительИз(Проба.НемецкийIPv4()));

	Ожидаем.Что(Вердикт.Закрыт,
		"таблица правил не читается — вход закрыт, а не открыт").ЭтоИстина();
	Ожидаем.Что(Слепой.Отказов(), "отказ сосчитан").Равно(1);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "не проверено") > 0,
		"причина названа в журнале: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Тот же сбой на списке кнопок: ни одной кнопки, а не все подряд.
&Тест
Процедура СбойЧтенияПравилУбираетВсеКнопки() Экспорт

	Открытые = ГейтНадЛежащейТаблицей().ПровайдерыДляПосетителя(Провайдеры("github, gitlab"),
		ПосетительИз(Проба.НемецкийIPv4()));

	Ожидаем.Что(Открытые.Количество(), "кнопок не осталось ни одной").Равно(0);

КонецПроцедуры

// Правила есть, а определителя у гейта нет: проверить правило нечем — значит, закрыто.
&Тест
Процедура ПравилоБезОпределителяЗакрываетВход() Экспорт

	Закрыть("github", "RU");
	Безглазый = Новый ГейтВходаПоСтране(Правило, Неопределено, ЛогСЛовушкой(), Новый ТекстОшибки());

	Ожидаем.Что(Безглазый.Закрыт("github", ПосетительИз(Проба.НемецкийIPv4())).Закрыт,
		"страну определить нечем — вход закрыт").ЭтоИстина();

КонецПроцедуры

// Несобранный механизм правил — это инсталляция БЕЗ геоправил, а не сломанная проверка:
// там вход работает как до этой истории.
&Тест
Процедура БезСобранногоМеханизмаВходРаботаетКакРаньше() Экспорт

	Пустой = Новый ГейтВходаПоСтране(Неопределено, Неопределено, ЛогСЛовушкой(), Новый ТекстОшибки());

	Ожидаем.Что(Пустой.Закрыт("github", ПосетительИз(Проба.РоссийскийIPv4())).Закрыт,
		"механизма правил нет — провайдер открыт").ЭтоЛожь();
	Ожидаем.Что(Пустой.ПровайдерыДляПосетителя(Провайдеры("github"), Неопределено).Количество(),
		"и кнопка остаётся на месте").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЖурналИОбезличивание

// Отказ виден в журнале приложения, но адрес посетителя целиком туда не уходит.
&Тест
Процедура ОтказНазванВЖурналеБезАдресаЦеликом() Экспорт

	Закрыть("github", "RU");
	Адрес = Проба.РоссийскийIPv4();

	Гейт.Закрыт("github", ПосетительИз(Адрес));

	Написанное = Ловушка.Всё();
	Ожидаем.Что(СтрНайти(Написанное, "github") > 0,
		"провайдер назван: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, Адрес),
		"адреса посетителя целиком в журнале нет").Равно(0);
	Ожидаем.Что(СтрНайти(Написанное, "95.213.7.x") > 0,
		"а сеть видна — адрес обезличен: " + Написанное).ЭтоИстина();

КонецПроцедуры

// Обезличивание адреса клиента — общая дверь журнала: хозяин адреса снят, сеть осталась.
// Запись сначала приводится к канону хаба, иначе штатная форма двойного стека
// («::ffff:a.b.c.d») уехала бы в журнал целиком, а сжатый IPv6 отдал бы третьей группой
// хвост чужого узла.
&Тест
Процедура АдресКлиентаТеряетХозяинаИОстаётсяСетью() Экспорт

	Обезличивание = Новый ОбезличиваниеЖурнала();

	Ожидаем.Что(Обезличивание.АдресКлиента("203.0.113.47"),
		"последний октет снят").Равно("203.0.113.x");
	Ожидаем.Что(Обезличивание.АдресКлиента("::ffff:203.0.113.7"),
		"отображённый IPv4 — это IPv4, а не шесть групп").Равно("203.0.113.x");
	Ожидаем.Что(Обезличивание.АдресКлиента("203.0.113.7:54321"),
		"порт отделён до обезличивания").Равно("203.0.113.x");
	Ожидаем.Что(Обезличивание.АдресКлиента("2a02:6b8:1:2:3:4:5:6"),
		"у IPv6 остаются первые группы").Равно("2a02:6b8:1:…");
	Ожидаем.Что(Обезличивание.АдресКлиента("2a02:6b8::1"),
		"сжатый IPv6 считается по развёрнутой записи").Равно("2a02:6b8:0:…");
	Ожидаем.Что(Обезличивание.АдресКлиента("[2a02:6b8::1]:443"),
		"скобки и порт сняты").Равно("2a02:6b8:0:…");
	Ожидаем.Что(Обезличивание.АдресКлиента("2a00:1450::8a2e:370:7334"),
		"третья группа — третья, а не хвост узла").Равно("2a00:1450:0:…");
	Ожидаем.Что(Обезличивание.АдресКлиента(""), "пустого адреса нет").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.АдресКлиента("вовсе не адрес"),
		"неразобранное в журнал не переписывается").Равно("«не адрес»");

КонецПроцедуры

#КонецОбласти

// Экранные предикаты живут здесь намеренно: они отвечают на тот же вопрос, что и дверь
// («что хаб может сказать о стране прямо сейчас»), и судить их можно только над настоящим
// определителем поверх пробной базы — обвязкой, которая собрана в этом наборе. Отдельный
// набор означал бы вторую копию той же сборки, а копия сборки расходится с оригиналом.
#Область ЭкранВидитТоЖеЧтоДверь

// Дверь судит по ОПУБЛИКОВАННОМУ индексу, и экран обязан судить по нему же: файл,
// унесённый из-под работающего хаба, индекс в памяти не отменяет — вход по нему работает,
// и «закрывает всем» было бы неправдой. Атрибуция держится за тот же индекс: пока хаб
// пользуется производным от базы, источник назван.
&Тест
Процедура УнесённыйФайлПриЖивомИндексеНеЗакрываетВсех() Экспорт

	Закрыть("github", "RU");
	Ожидаем.Что(Определитель.НаблюдаемыеСтраны().Количество(),
		"КОНТРОЛЬ: индекс построен").Равно(1);

	УдалитьФайлы(ПутьБазы());
	Ожидаем.Что(Определитель.СостояниеБазы().Есть, "КОНТРОЛЬ: файла больше нет").ЭтоЛожь();

	Ожидаем.Что(ВидБазы().ЗакрываетВсех(),
		"индекс жив — «закрывает всем» не печатаем").ЭтоЛожь();
	Ожидаем.Что(Атрибуция().Печатается(),
		"а источник базы назван: хаб пользуется производным от неё").ЭтоИстина();

КонецПроцедуры

// Индекса нет вовсе — вот когда правило и вправду закрывает всех; атрибуции тогда нет.
&Тест
Процедура БезИндексаПравилоЗакрываетВсехИАтрибуцииНет() Экспорт

	Закрыть("github", "RU");
	// определитель собран заново: правило в базе есть, а индекса у этого ещё нет
	ПересобратьОпределитель();

	Ожидаем.Что(Определитель.НаблюдаемыеСтраны().Количество(),
		"КОНТРОЛЬ: индекс ещё не построен").Равно(0);
	Ожидаем.Что(ВидБазы().ЗакрываетВсех(), "правило закрывает всех").ЭтоИстина();
	Ожидаем.Что(Атрибуция().Печатается(), "и атрибуции нет").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СводкаОтказовВЖурнале

// Отбитых посетителей бывает столько же, сколько запросов: предупреждением говорится
// первый отказ провайдера, дальше — отладка, и раз в окно — сводка с числами. Без сводки
// оператор с уровнем по умолчанию не узнал бы, что отсечение продолжается.
&Тест
Процедура СводкаОтказовПовторяетсяНеЧащеОкна() Экспорт

	Закрыть("github", "RU");

	Предупреждения = Новый ЛовушкаЛога();
	Часы = Новый ЧасыРучные();
	Свой = Новый ГейтВходаПоСтране(Правило, Определитель, ЛогПредупреждений(Предупреждения),
		Новый ТекстОшибки());
	Свой.УстановитьЧасы(Часы);

	Для Заход = 1 По 5 Цикл
		Свой.Закрыт("github", ПосетительИз(Проба.РоссийскийIPv4()));
	КонецЦикла;

	Ожидаем.Что(Предупреждения.Количество(),
		"пять отказов подряд — одно предупреждение: " + Предупреждения.Всё()).Равно(1);
	Ожидаем.Что(СтрНайти(Предупреждения.Всё(), "за последние"),
		"сводки внутри окна нет").Равно(0);

	Часы.Прибавить(600);
	Свой.Закрыт("github", ПосетительИз(Проба.РоссийскийIPv4()));

	Написанное = Предупреждения.Всё();
	Ожидаем.Что(Предупреждения.Количество(),
		"через окно добавилась ровно одна сводка: " + Написанное).Равно(2);
	Ожидаем.Что(СтрНайти(Написанное, "отбито 5 посетителей") > 0,
		"сводка считает отказы С ПРОШЛОГО предупреждения: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "всего за жизнь процесса 6") > 0,
		"и называет полный счёт провайдера: " + Написанное).ЭтоИстина();

	// окно прошло, а отказов не было — сводке неоткуда взяться: её пишет сам отказ
	Часы.Прибавить(600);
	Ожидаем.Что(Предупреждения.Количество(), "без отказов сводки нет").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ЗаказСтран

// Правило назвало страну — её и нужно уметь различать: заказ уходит базе на самой записи,
// без перезапуска хаба.
&Тест
Процедура ЗаписьПравилаЗаказываетСтраныБазе() Экспорт

	Закрыть("github", "RU");

	Ожидаем.Что(СтрСоединить(Определитель.ЗаказанныеСтраны(), ","),
		"страна правила заказана базе").Равно("RU");

	Правило.Снять(Неопределено, "github");
	Ожидаем.Что(Определитель.ЗаказанныеСтраны().Количество(),
		"правило снято — наблюдать больше нечего").Равно(0);

КонецПроцедуры

// Старт заказывает базе страны действующих правил и сборку не ждёт.
&Тест
Процедура СтартЗаказываетСтраныДействующихПравил() Экспорт

	Закрыть("github", "RU");
	// стенд собран заново: заказ старта — единственное, что скажет базе про страны
	ПересобратьОпределитель();

	Заказ = Новый ЗаказНаблюдаемыхСтран(Правило, Определитель, ЛогСЛовушкой(),
		Новый ТекстОшибки());
	Заказ.ПриЗапускеПриложения();

	Ожидаем.Что(СтрСоединить(Определитель.ЗаказанныеСтраны(), ","),
		"страны правил заказаны на старте").Равно("RU");

КонецПроцедуры

// Правил нет — старт файла базы не трогает: тридцать мегабайт читать незачем.
&Тест
Процедура СтартБезПравилФайлБазыНеЧитает() Экспорт

	Заказ = Новый ЗаказНаблюдаемыхСтран(Правило, Определитель, ЛогСЛовушкой(),
		Новый ТекстОшибки());
	Заказ.ПриЗапускеПриложения();

	Ожидаем.Что(Определитель.ЗаказанныеСтраны().Количество(), "заказывать нечего").Равно(0);
	Ожидаем.Что(База.ПрочтенийФайла(), "файл базы не открывали").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Процедура Закрыть(Знач ИмяПровайдера, Знач Страны)

	Исход = Правило.Сохранить(Неопределено, ИмяПровайдера, Страны);
	Ожидаем.Что(Исход.Успех, "правило стенда сохранено").ЭтоИстина();

КонецПроцедуры

// Определитель собирается заново поверх ТОГО ЖЕ хранилища правил: так проверяется старт
// хаба, которому правила уже лежат в базе, а индекса ещё нет.
Процедура ПересобратьОпределитель()

	База = Новый БазаСтран(Настройки, Новый ЗапускВФонеСинхронный(), ЛогСЛовушкой());
	Канон = Новый КанонIP();
	Определитель = Новый ОпределительСтраны(База, Новый СвояСеть(Канон), Канон, Настройки);

КонецПроцедуры

// Хаб, поднявшийся при лежащей базе: снимка правил у него нет, и первое же чтение падает.
Функция ГейтНадЛежащейТаблицей()

	Хранилище.Сломаться();
	Холодное = Новый ГеоправилоПровайдера(Хранилище, Новый СправочникСтран(),
		Новый СписокЧерезЗапятую(), Неопределено, Новый ФейкПарольногоВхода(Истина),
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Определитель);

	Возврат Новый ГейтВходаПоСтране(Холодное, Определитель, ЛогСЛовушкой(), Новый ТекстОшибки());

КонецФункции

// Экранные виды собираются без кита: обе проверки — предикаты, разметки им не нужно.
Функция ВидБазы()
	Возврат Новый СостояниеБазыСтран(Неопределено, Определитель, Неопределено, Неопределено);
КонецФункции

Функция Атрибуция()
	Возврат Новый АтрибуцияБазыСтран(Неопределено, Правило, Определитель, Неопределено);
КонецФункции

Функция ПосетительИз(Знач Адрес)
	Возврат Новый ПосетительЗапроса().Собрать(Адрес, Новый Соответствие());
КонецФункции

Функция Провайдеры(Знач Имена)

	Результат = Новый Массив();
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Результат.Добавить(Новый Структура("Имя, Метка", СокрЛП(Имя), СокрЛП(Имя)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПутьБазы()
	Возврат ОбъединитьПути(Песочница, "гео", "dbip-country-lite.csv");
КонецФункции

// Ловушка ТОЛЬКО на предупреждениях: сторож свёртки считает их, а отладочных строк
// у отказов столько же, сколько запросов.
Функция ЛогПредупреждений(Знач СвояЛовушка)

	Лог = Логирование.ПолучитьЛог("тест.oshub.гейт-сводка."
		+ Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(УровниЛога.Предупреждение);
	Лог.ДобавитьСпособВывода(СвояЛовушка, УровниЛога.Предупреждение);
	Возврат Лог;

КонецФункции

Функция ЛогСЛовушкой()

	Лог = Логирование.ПолучитьЛог("тест.oshub.гейт-страны."
		+ Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка, УровниЛога.Отладка);
	Возврат Лог;

КонецФункции

#КонецОбласти
