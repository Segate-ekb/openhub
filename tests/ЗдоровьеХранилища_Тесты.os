// Доступность хранилища артефактов: троичная проба обоих бэкендов со своим сроком, память
// стража, боевые отказы, происшествия на переходе и экран, который берёт вердикт у стража
// и в хранилище не ходит. Живой хаб не поднимается; единственный сетевой тест — локальный
// слушатель, который принимает соединение и молчит.

#Использовать asserts
#Использовать errors
#Использовать oint
#Использовать autumn-logos
#Использовать oscript-ui
#Использовать "фикстуры"

Перем UI;                // СборкаUI — граф компонентов и рендереров web-ui
Перем Выдача;            // фикстура ВыдачаПортов — свободный порт спрашивается у ОС
Перем КаталогМодулей;
Перем ПробаМолчащего;    // S3Хранилище на молчащем слушателе: его зовёт фоновое задание
Перем ИтогПробы;         // вердикт фоновой пробы
Перем ПробаЗанялаМс;     // сколько проба ждала молчащее хранилище

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ВыдачаПортов");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ФейкКлиентS3");
	РеестрФикстур.Подключить("ФейкЛетописьПроисшествий");
	РеестрФикстур.Подключить("ФейкПуловСОбъёмом");
	РеестрФикстур.Подключить("СчитающееХранилищеАртефактов");
	РеестрФикстур.Подключить("ЧасыРучные");
	РеестрФикстур.Подключить("УникальныеИмена");

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "хранилище", "Классы"));
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "происшествия", "Классы"), "КодыПроисшествий");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "происшествия", "Классы"), "ОбъектыПроисшествий");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"), "ИмяОбъектаАудита");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		"ОбезличиваниеЖурнала");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "УчётОбъёмаПула");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ЗаполнениеПула");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "фоновыеЗадания", "Классы"),
		"ЗадачаЗдоровьяХранилища");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "ВитринаХранилища");

	Выдача = Новый ВыдачаПортов();

КонецПроцедуры

&ПослеВсех
Процедура ВернутьПорты() Экспорт
	Выдача.ВернутьВсе();
КонецПроцедуры

#Область ПробаОбъектногоХранилища

// «Объекта нет» — это успех пробы: корзина ответила по существу. Проба спрашивает
// заведомо отсутствующий ключ, поэтому иначе и быть не может.
&Тест
Процедура ОтсутствиеОбъектаЭтоОтветПоСуществу() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Проба = Новый S3Хранилище(Клиент).Доступность(5);

	Ожидаем.Что(Проба.Успех, "пустая корзина отвечает").ЭтоИстина();
	Ожидаем.Что(Проба.ОтказДоступа, "отказа доступа не было").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "у успеха причины нет").Равно("");

КонецПроцедуры

// Проба ничего не кладёт: запись дала бы ложный отказ там, где ключи открыты на чтение,
// и мусор в корзине там, где всё в порядке.
&Тест
Процедура ПробаНичегоВХранилищеНеОставляет() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый S3Хранилище(Клиент);

	Хранилище.Доступность(5);
	Хранилище.Доступность(5);

	Ожидаем.Что(Клиент.Количество(), "проба не создала ни одного объекта").Равно(0);

КонецПроцедуры

&Тест
Процедура ЛежащееХранилищеПробаНазываетНеОтвечающим() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Клиент.СтатьНедоступным("MinIO не отвечает: connection refused");

	Проба = Новый S3Хранилище(Клиент).Доступность(5);

	Ожидаем.Что(Проба.Успех, "лежащее хранилище пробу не проходит").ЭтоЛожь();
	Ожидаем.Что(Проба.ОтказДоступа, "«лежит» — не «не пустило»").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Проба.Сообщение), "причина названа").ЭтоИстина();

КонецПроцедуры

// Закрытый доступ не выдаётся ни за «отвечает», ни за «лежит»: чинить надо доступ,
// а не адрес.
&Тест
Процедура ЗакрытыйДоступНеВыдаётсяЗаЛежащееХранилище() Экспорт

	Клиент = Новый ФейкКлиентS3();
	Клиент.НеПускать("ключ доступа не подошёл");

	Проба = Новый S3Хранилище(Клиент).Доступность(5);

	Ожидаем.Что(Проба.Успех, "не пустившее хранилище пробу не проходит").ЭтоЛожь();
	Ожидаем.Что(Проба.ОтказДоступа, "и отличается от лежащего").ЭтоИстина();
	Ожидаем.Что(Проба.Сообщение, "в причине назван машинный код хранилища")
		.Содержит("AccessDenied");
	Ожидаем.Что(Проба.Сообщение, "и статус ответа").Содержит("403");

КонецПроцедуры

// Приговор по ответу читается из его СТРУКТУРЫ: 403 с NoSuchKey — это закрытая листингом
// корзина, у которой объекта честно нет, а не отказ доступа.
&Тест
Процедура ОтказДоступаОтличаетсяОтОтсутствияИОтМолчания() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ожидаем.Что(Вердикт.ЭтоОтказДоступа(ОтветСКодом(403, "AccessDenied")),
		"403 AccessDenied — не пустило").ЭтоИстина();
	Ожидаем.Что(Вердикт.ЭтоОтказДоступа(Ответ(401)), "401 — тоже не пустило").ЭтоИстина();
	Ожидаем.Что(Вердикт.ЭтоОтказДоступа(ОтветСКодом(403, "NoSuchKey")),
		"403 NoSuchKey — объекта нет, доступ ни при чём").ЭтоЛожь();
	Ожидаем.Что(Вердикт.ЭтоОтказДоступа(Ответ(500)), "500 — молчание, а не отказ доступа").ЭтоЛожь();
	Ожидаем.Что(Вердикт.ЭтоОтказДоступа(Ответ(200)), "успех отказом доступа не является").ЭтоЛожь();

КонецПроцедуры

// Корзина, закрытая листингом, отвечает 403 с NoSuchKey — и это работающее хранилище.
&Тест
Процедура ЗакрытаяЛистингомКорзинаСчитаетсяОтвечающей() Экспорт

	Проба = Новый S3Хранилище(Новый ФейкКлиентS3()).Доступность(5);
	Ожидаем.Что(Проба.Успех, "отсутствие объекта — ответ по существу").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПробаФайловогоХранилища

&Тест
Процедура ФайловоеХранилищеОтвечаетПокаКореньНаМесте() Экспорт

	Корень = УникальныеИмена.ВременныйКаталог("oshub-health-fs");
	Попытка
		Проба = Новый ФайловоеХранилище(Корень).Доступность(5);
	Исключение
		УникальныеИмена.УбратьВременное(Корень);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Корень);

	Ожидаем.Что(Проба.Успех, "корень на месте — хранилище отвечает").ЭтоИстина();
	Ожидаем.Что(Проба.ОтказДоступа, "отказа доступа у файлового бэкенда нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СнесённыйКореньНазываетсяОтказомХранилища() Экспорт

	Корень = УникальныеИмена.ВременныйКаталог("oshub-health-gone");
	УникальныеИмена.УбратьВременное(Корень);

	Проба = Новый ФайловоеХранилище(Корень).Доступность(5);

	Ожидаем.Что(Проба.Успех, "снесённый корень — хранилище не отвечает").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "в причине назван корень").Содержит(Новый Файл(Корень).Имя);

КонецПроцедуры

// Путь, занятый файлом, — это не хранилище: каталога под артефакты нет, и молчать об этом
// нельзя, иначе экран покажет «занято 0 Б».
&Тест
Процедура КореньЗанятыйФайломХранилищемНеСчитается() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-health-file");
	Путь = ОбъединитьПути(Каталог, "не-каталог");
	ПоложитьФайл(Путь, "хранилищем не является");

	Попытка
		Проба = Новый ФайловоеХранилище(Путь).Доступность(5);
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Каталог);

	Ожидаем.Что(Проба.Успех, "файл вместо каталога — хранилище не отвечает").ЭтоЛожь();

КонецПроцедуры

// Корень, в который нельзя писать, — самый частый отказ файлового бэкенда (нет места,
// том смонтирован только на чтение). Честный тест на него ставится подменой корня ФАЙЛОМ:
// каталога с правами «только чтение» под root не бывает, и на CI такой тест зеленел бы
// вхолостую. Публикация в такой корень обязана назвать отказ ХРАНИЛИЩА, иначе экран
// скажет «Отвечает», пока каждая публикация падает.
&Тест
Процедура ЗаписьВНегодныйКореньЭтоОтказЗависимости() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-health-ro");
	Корень = ОбъединитьПути(Каталог, "корень-не-каталог");
	ПоложитьФайл(Корень, "писать сюда нельзя");

	Попытка
		Сбой = СбойЗаписи(Новый ФайловоеХранилище(Корень));
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Каталог);

	Ожидаем.Что(Сбой <> Неопределено, "запись в негодный корень обязана упасть").ЭтоИстина();
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ЗависимостьНедоступна()),
		"и назваться недоступностью хранилища: "
			+ ДиагностикаОшибок.КраткоеПредставление(Сбой)).ЭтоИстина();
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()),
		"отсутствием артефакта это не является").ЭтоЛожь();

КонецПроцедуры

// Тот же отказ, пройдя через обёртку, обязан погасить экран: ради этого код и заведён.
&Тест
Процедура НегодныйКореньДоводитОтказДоСтража() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-health-ro-страж");
	Корень = ОбъединитьПути(Каталог, "корень-не-каталог");
	ПоложитьФайл(Корень, "писать сюда нельзя");

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Хранилище = Новый ХранилищеПодСтражем(Новый ФайловоеХранилище(Корень), Стенд.Страж,
		ЛогТестов());

	Попытка
		СбойЗаписи(Хранилище);
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Каталог);

	Ожидаем.Что(Стенд.Страж.Состояние().Известно, "боевой отказ файлового бэкенда услышан")
		.ЭтоИстина();
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "и хранилище названо не отвечающим").ЭтоЛожь();

КонецПроцедуры

// Негодный источник — вина вызывающего, а не хранилища: гасить им экран нельзя.
&Тест
Процедура ОтсутствующийИсточникХранилищеНеРонит() Экспорт

	Корень = УникальныеИмена.ВременныйКаталог("oshub-health-источник");
	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Хранилище = Новый ХранилищеПодСтражем(Новый ФайловоеХранилище(Корень), Стенд.Страж,
		ЛогТестов());

	Попытка
		Хранилище.Сохранить(Новый КоординатыАртефакта("main", "pkg", "1.0.0"),
			ОбъединитьПути(Корень, "нет-такого-файла.ospx"));
	Исключение
		Сбой = ИнформацияОбОшибке();
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Корень);

	Ожидаем.Что(Сбой <> Неопределено, "публикация несуществующего файла падает").ЭтоИстина();
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ЗависимостьНедоступна()),
		"но хранилище в этом не виновато: "
			+ ДиагностикаОшибок.КраткоеПредставление(Сбой)).ЭтоЛожь();
	Ожидаем.Что(Стенд.Страж.Состояние().Известно,
		"и стражу объявлять нечего").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СвойСрокПробы

// Чёрная дыра: слушатель принимает соединение и молчит. Без своего срока клиент oint ждёт
// ответа ЧАС — и подвешивает того, кто его позвал. Проба уходит в фоновое задание,
// потому что TCPСервер, поднятый в фоне, входящих не принимает.
&Тест
Процедура МолчащееХранилищеОтвечаетПробеПоСвоемуСроку() Экспорт

	Порт = Выдача.Выдать();
	ПробаМолчащего = ХранилищеНаПорту(Порт);
	ИтогПробы = Неопределено;
	ПробаЗанялаМс = 0;

	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();

	Попытка
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПробоватьВФоне");
		Соединение = ПринятьСоединение(Сервер, 20000);
		Дождаться(Задание);
	Исключение
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Закрыть(Соединение);
	Остановить(Сервер, Порт);

	Ожидаем.Что(Соединение <> Неопределено,
		"слушатель принял соединение пробы: это молчание, а не отказ связи").ЭтоИстина();
	Ожидаем.Что(ИтогПробы <> Неопределено, "проба вернула вердикт").ЭтоИстина();
	Ожидаем.Что(ИтогПробы.Успех, "молчащее хранилище не отвечает: " + ИтогПробы.Сообщение).ЭтоЛожь();
	Ожидаем.Что(ИтогПробы.ОтказДоступа, "молчание отказом доступа не является").ЭтоЛожь();

	// нижняя граница — сторож ложной зелени: проба, упавшая мгновенно (негодный адрес,
	// неASCII в заголовках), доказывает не срок, а собственную поломку
	Ожидаем.Что(ПробаЗанялаМс >= МинимумОжиданияМс(),
		СтрШаблон("проба действительно ждала молчащее хранилище: заняла %1 мс при сроке %2 с",
			Формат(ПробаЗанялаМс, "ЧГ=0"), Формат(СрокМолчащейПробыСек(), "ЧГ=0"))).ЭтоИстина();
	Ожидаем.Что(ПробаЗанялаМс < ПотолокОжиданияМс(),
		СтрШаблон("и уложилась в свой срок, а не ждала час: заняла %1 мс",
			Формат(ПробаЗанялаМс, "ЧГ=0"))).ЭтоИстина();

КонецПроцедуры

// Задание фоновой пробы: слушатель держит главный поток набора.
Процедура ПробоватьВФоне() Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ИтогПробы = ПробаМолчащего.Доступность(СрокМолчащейПробыСек());
	Исключение
		ИтогПробы = Новый Структура("Успех, ОтказДоступа, Сообщение",
			Ложь, Ложь, "ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки());
	КонецПопытки;
	ПробаЗанялаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

КонецПроцедуры

#КонецОбласти

#Область ПамятьСтража

&Тест
Процедура ДоПервойПробыСтражуНичегоНеИзвестно() Экспорт

	Состояние = НовыйСтраж(Новый ФейкЛетописьПроисшествий()).Страж.Состояние();

	Ожидаем.Что(Состояние.Известно, "непроверенное хранилище — это «неизвестно»").ЭтоЛожь();
	Ожидаем.Что(Состояние.Причина, "и причины у неизвестности нет").Равно("");

КонецПроцедуры

&Тест
Процедура ОтметкаПротухаетПоСрокуПамяти() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Стенд.Настройки.Задать("oshub.storage.health.ttl.sec", 300);

	Стенд.Страж.ОтметитьБоевойОтказ("корня нет");
	Ожидаем.Что(Стенд.Страж.Состояние().Известно, "свежая отметка известна").ЭтоИстина();

	Стенд.Часы.Прибавить(299);
	Ожидаем.Что(Стенд.Страж.Состояние().Известно, "до срока отметка жива").ЭтоИстина();

	Стенд.Часы.Прибавить(1);
	Ожидаем.Что(Стенд.Страж.Состояние().Известно,
		"протухшая отметка — это «неизвестно», а не вчерашний вердикт").ЭтоЛожь();

КонецПроцедуры

// Момент, с которого хранилище молчит, двигать нельзя: человеку важно, сколько длится
// отказ, а не когда его подтвердили в последний раз.
&Тест
Процедура МоментСменыСтоитПокаСостояниеТоЖе() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Начало = Стенд.Часы.Сейчас();

	Стенд.Страж.ОтметитьБоевойОтказ("корня нет");
	Стенд.Часы.Прибавить(60);
	Стенд.Страж.ОтметитьБоевойОтказ("корня нет");

	Состояние = Стенд.Страж.Состояние();
	Ожидаем.Что(Состояние.Изменилось, "момент отказа остался прежним").Равно(Начало);
	Ожидаем.Что(Состояние.Проверено, "а момент последнего ответа сдвинулся").Равно(Начало + 60);

	Стенд.Часы.Прибавить(60);
	Стенд.Страж.ОтметитьБоевойУспех();
	Ожидаем.Что(Стенд.Страж.Состояние().Изменилось,
		"смена состояния переставила момент").Равно(Начало + 120);

КонецПроцедуры

&Тест
Процедура ТриСостоянияСтражаРазличимы() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());

	Стенд.Страж.ОтметитьБоевойУспех();
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "отвечает").ЭтоИстина();
	Ожидаем.Что(Стенд.Страж.Состояние().ОтказДоступа, "и это не отказ доступа").ЭтоЛожь();

	Стенд.Страж.ПринятьПробу(ПробаНеПустила("ключ доступа не подошёл"));
	Ожидаем.Что(Стенд.Страж.Состояние().ОтказДоступа, "не пустило").ЭтоИстина();
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает,
		"«не пустило» за «отвечает» не выдаётся").ЭтоЛожь();

	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "не отвечает").ЭтоЛожь();
	Ожидаем.Что(Стенд.Страж.Состояние().ОтказДоступа,
		"«лежит» за «не пустило» не выдаётся").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область БоевыеОтказы

// Отказ боевого запроса кладёт «не отвечает» СРАЗУ: ждать тика фоновой задачи значило бы
// показывать администратору работающее хранилище, пока клиенты получают 503.
&Тест
Процедура БоевойОтказЗависимостиКладётНеОтвечающимСразу() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Клиент = Новый ФейкКлиентS3();
	Клиент.СтатьНедоступным("MinIO не отвечает: connection refused");
	Хранилище = Новый ХранилищеПодСтражем(Новый S3Хранилище(Клиент), Стенд.Страж);

	Попытка
		Хранилище.Существует(Новый КоординатыАртефакта("main", "pkg", "1.0.0"));
	Исключение
		// отказ перебрасывается вызывающему: страж его слышит, но не съедает
	КонецПопытки;

	Состояние = Стенд.Страж.Состояние();
	Ожидаем.Что(Состояние.Известно, "боевой отказ дошёл до стража").ЭтоИстина();
	Ожидаем.Что(Состояние.Отвечает, "и назвал хранилище не отвечающим").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БоевойУспехВозвращаетХранилищеВОтвечающие() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Клиент = Новый ФейкКлиентS3();
	Хранилище = Новый ХранилищеПодСтражем(Новый S3Хранилище(Клиент), Стенд.Страж);

	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Хранилище.Существует(Новый КоординатыАртефакта("main", "pkg", "1.0.0"));

	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "ответивший бэкенд снова отвечает").ЭтоИстина();

КонецПроцедуры

// «Артефакта нет» — ответ по существу: выдавать его за отказ хранилища значило бы гасить
// экран на каждом запросе несуществующего пакета.
&Тест
Процедура ОтсутствиеАртефактаХранилищаНеРонит() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Хранилище = Новый ХранилищеПодСтражем(Новый S3Хранилище(Новый ФейкКлиентS3()), Стенд.Страж);

	Попытка
		Хранилище.ПолучитьДанные(Новый КоординатыАртефакта("main", "pkg", "1.0.0"));
	Исключение
		// resource.not_found — ровно то, что должно оставить стража равнодушным
	КонецПопытки;

	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает,
		"хранилище ответило «нет объекта» и осталось отвечающим").ЭтоИстина();

КонецПроцедуры

// Опечатка в имени корзины: HEAD отсутствующего объекта отвечает тем же 404, что и на
// исправной, а `Сохранить`, `Опись` и `ЗанятыйОбъем` падают `NoSuchBucket`. Час такой
// работы прежде давал зелёный экран с полосой при падающих публикациях — и мигающее
// происшествие: шестьдесят записей и шестьдесят снятий.
&Тест
Процедура УспехПробыНеСтираетСвежийБоевойОтказ() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);
	Стенд.Настройки.Задать("oshub.storage.health.ttl.sec", 300);

	Стенд.Страж.ОтметитьБоевойОтказ("хранилище ответило 404: код NoSuchBucket");

	// четыре тика фоновой задачи с успешной пробой внутри срока памяти
	Для Тик = 1 По 4 Цикл
		Стенд.Часы.Прибавить(60);
		Стенд.Страж.ПринятьПробу(ПробаОтветила());
	КонецЦикла;

	Состояние = Стенд.Страж.Состояние();
	Ожидаем.Что(Состояние.Отвечает, "экран остаётся некрасивым, пока боевые вызовы падают")
		.ЭтоЛожь();
	Ожидаем.Что(Состояние.Причина, "и причина всё та же, боевая").Содержит("NoSuchBucket");
	Ожидаем.Что(Состояние.Известно, "отметка не протухла: успех пробы её продлевает").ЭтоИстина();
	Ожидаем.Что(Летопись.Записи().Количество(), "происшествие не мигает: одна запись").Равно(1);
	Ожидаем.Что(Летопись.Снятые().Количество(), "и ни одного снятия").Равно(0);

КонецПроцедуры

// Но вечно держать вердикт по одному давнему отказу нельзя: на тихом хабе боевых вызовов
// может не быть часами. Через срок памяти после отказа успех пробы его отпускает.
&Тест
Процедура ЧерезСрокПамятиУспехПробыОтпускаетБоевойОтказ() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);
	Стенд.Настройки.Задать("oshub.storage.health.ttl.sec", 300);

	Стенд.Страж.ОтметитьБоевойОтказ("хранилище ответило 404: код NoSuchBucket");

	Стенд.Часы.Прибавить(299);
	Стенд.Страж.ПринятьПробу(ПробаОтветила());
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "до срока отказ держит").ЭтоЛожь();

	Стенд.Часы.Прибавить(1);
	Стенд.Страж.ПринятьПробу(ПробаОтветила());
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "после срока проба отпускает").ЭтоИстина();
	Ожидаем.Что(Летопись.Снятые().Количество(), "и снимает происшествие ровно один раз").Равно(1);

КонецПроцедуры

// Боевой успех сильнее всего: он и отвечает, и делает работу — значит держать нечего.
&Тест
Процедура БоевойУспехОтпускаетБоевойОтказСразу() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);

	Стенд.Страж.ОтметитьБоевойОтказ("хранилище ответило 404: код NoSuchBucket");
	Стенд.Часы.Прибавить(10);
	Стенд.Страж.ОтметитьБоевойУспех();

	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "боевой успех снял отказ немедленно").ЭтоИстина();
	Ожидаем.Что(Летопись.Снятые().Количество(), "и снял происшествие").Равно(1);

	Стенд.Часы.Прибавить(10);
	Стенд.Страж.ПринятьПробу(ПробаОтветила());
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает,
		"последующая проба ничего не ломает").ЭтоИстина();

КонецПроцедуры

// Отказ пробы по-прежнему кладётся сразу: она спросила и не получила ответа.
&Тест
Процедура ОтказПробыКладётсяБезВсякогоУдержания() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());

	Стенд.Страж.ОтметитьБоевойУспех();
	Стенд.Страж.ПринятьПробу(ПробаНеОтветила("хранилище не ответило (срок ожидания — 10 с)"));

	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "отказ пробы виден сразу").ЭтоЛожь();

КонецПроцедуры

// Проба через обёртку — единственный путь фоновой задачи: её вердикт обязан доехать
// до стража целиком, включая «не пустило».
&Тест
Процедура ПробаЧерезОбёрткуДоводитВердиктДоСтража() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Клиент = Новый ФейкКлиентS3();
	Клиент.НеПускать("ключ доступа не подошёл");
	Хранилище = Новый ХранилищеПодСтражем(Новый S3Хранилище(Клиент), Стенд.Страж);

	Хранилище.Доступность(5);

	Состояние = Стенд.Страж.Состояние();
	Ожидаем.Что(Состояние.ОтказДоступа, "вердикт «не пустило» доехал до стража").ЭтоИстина();
	Ожидаем.Что(Состояние.Причина, "вместе с причиной").Содержит("AccessDenied");

КонецПроцедуры

// Фабрика хранилища ставит стража на путь каждого вызова: иначе боевые отказы до экрана
// не доезжают и «не отвечает» появляется только с тиком фоновой задачи.
&Тест
Процедура ФабрикаСобираетХранилищеПодСтражем() Экспорт

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());
	Корень = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-нет-такого-корня-" +
		Строка(Новый УникальныйИдентификатор));

	Фабрика = Новый КонфигурацияХранилища("fs", Корень, , , , , , , ЛогТестов(), Стенд.Страж);
	Фабрика.ХранилищеАртефактов().Доступность(5);

	Ожидаем.Что(Стенд.Страж.Состояние().Известно, "собранное фабрикой хранилище слышит страж")
		.ЭтоИстина();
	Ожидаем.Что(Стенд.Страж.Состояние().Отвечает, "корня нет — хранилище не отвечает").ЭтоЛожь();

КонецПроцедуры

// Фоновая задача — единственный, кто заказывает пробу по расписанию, и срок она берёт
// из настроек инсталляции.
&Тест
Процедура ФоноваяЗадачаЗаказываетПробуСоСрокомИзНастроек() Экспорт

	Настройки = НовыеНастройки();
	Настройки.Задать("oshub.storage.health.timeout.sec", 7);
	Хранилище = Новый СчитающееХранилищеАртефактов();

	Задача = Новый ЗадачаЗдоровьяХранилища(Хранилище, Настройки);
	Задача.Исполнить();

	Ожидаем.Что(Хранилище.Обращений(), "задача спросила хранилище ровно один раз").Равно(1);
	Ожидаем.Что(Хранилище.СрокПоследнейПробы(),
		"и передала ему срок из настроек инсталляции").Равно(7);

КонецПроцедуры

#КонецОбласти

#Область ПроисшествияНаПереходе

// Происшествие пишется на ПЕРЕХОДЕ: страж слышит каждый ответ хранилища, и запись на каждый
// отказ стоила бы двух обращений к базе под процессным замком на каждый запрос.
&Тест
Процедура ПроисшествиеПишетсяНаПереходеАНеНаКаждомОтказе() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);
	Стенд.Настройки.Задать("oshub.storage.health.ttl.sec", 300);

	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Стенд.Часы.Прибавить(10);
	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Стенд.Часы.Прибавить(10);
	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");

	Ожидаем.Что(Летопись.Записи().Количество(),
		"три отказа подряд — одна запись происшествия").Равно(1);

КонецПроцедуры

// Но и молчать вечно нельзя: длящийся отказ подтверждается раз в срок памяти, иначе
// происшествие выглядело бы вчерашним.
&Тест
Процедура ДлящийсяОтказПодтверждаетсяРазВСрок() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);
	Стенд.Настройки.Задать("oshub.storage.health.ttl.sec", 300);

	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Стенд.Часы.Прибавить(299);
	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Ожидаем.Что(Летопись.Записи().Количество(), "до срока повтора нет").Равно(1);

	Стенд.Часы.Прибавить(1);
	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Ожидаем.Что(Летопись.Записи().Количество(), "после срока отказ подтверждён").Равно(2);

КонецПроцедуры

&Тест
Процедура КодПроисшествияРазличаетМолчаниеИОтказДоступа() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);

	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Стенд.Страж.ПринятьПробу(ПробаНеПустила("ключ доступа не подошёл"));

	Коды = Новый КодыПроисшествий();
	Ожидаем.Что(Летопись.ПоКоду(Коды.ХранилищеНеОтвечает()).Количество(),
		"молчание записано своим кодом").Равно(1);
	Ожидаем.Что(Летопись.ПоКоду(Коды.ХранилищеНеПустило()).Количество(),
		"отказ доступа — своим").Равно(1);

КонецПроцедуры

&Тест
Процедура ВозвратВОтвечаетСнимаетПроисшествие() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);

	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Стенд.Страж.ОтметитьБоевойУспех();

	Ожидаем.Что(Летопись.Снятые().Количество(), "поднявшееся хранилище сняло происшествие").Равно(1);
	Ожидаем.Что(Летопись.Снятые()[0].Подсистема, "снято происшествие своей подсистемы")
		.Равно(Новый КодыПроисшествий().ПодсистемаХранилище());

КонецПроцедуры

// Снимать снятое незачем: успешные ответы идут потоком, и каждый стоил бы обращения к базе.
&Тест
Процедура ОтвечающееХранилищеСнимаетПроисшествиеОдинРаз() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);

	Стенд.Страж.ОтметитьБоевойОтказ("connection refused");
	Стенд.Страж.ОтметитьБоевойУспех();
	Стенд.Часы.Прибавить(600);
	Стенд.Страж.ОтметитьБоевойУспех();
	Стенд.Страж.ОтметитьБоевойУспех();

	Ожидаем.Что(Летопись.Снятые().Количество(), "снятие одно на переход").Равно(1);

КонецПроцедуры

// Объект происшествия называет КОРЗИНУ: рядом с эндпоинтом лежат ключи доступа, и место им
// не на экране и не в базе.
&Тест
Процедура ОбъектПроисшествияНазываетКорзинуАНеЭндпоинтСКлючами() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);
	Стенд.Настройки.Задать("oshub.storage.backend", "s3");
	Стенд.Настройки.Задать("oshub.storage.s3.bucket", "openhub-artifacts");
	Стенд.Настройки.Задать("oshub.storage.s3.endpoint", "https://KEY:SECRET@minio.example:9000");

	Стенд.Страж.ОтметитьБоевойОтказ("хранилище не ответило (срок ожидания — 10 с)");

	Объект = Летопись.Записи()[0].Объект;
	Ожидаем.Что(Объект, "объект происшествия — корзина").Равно("хранилище/s3://openhub-artifacts");
	Ожидаем.Что(СтрНайти(Объект, "minio.example"), "эндпоинта в объекте нет: " + Объект).Равно(0);
	Ожидаем.Что(СтрНайти(Объект, "SECRET"), "и ключей доступа тоже").Равно(0);

КонецПроцедуры

&Тест
Процедура ОбъектПроисшествияФайловогоБэкендаНазываетКорень() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);
	Стенд.Настройки.Задать("oshub.storage.backend", "fs");
	Стенд.Настройки.Задать("oshub.storage.root", "./data");

	Стенд.Страж.ОтметитьБоевойОтказ("корня артефактов ""./data"" нет");

	Ожидаем.Что(Летопись.Записи()[0].Объект, "объект происшествия — корень артефактов")
		.Равно("хранилище/./data");

КонецПроцедуры

// Причина едет в летопись как есть: обезличивание — её работа, а не стража, и копии
// того правила здесь нет (его стережёт Происшествия_Тесты).
&Тест
Процедура ПричинаПроисшествияЭтоТоЧемОтветилоХранилище() Экспорт

	Летопись = Новый ФейкЛетописьПроисшествий();
	Стенд = НовыйСтраж(Летопись);

	Ответ = "хранилище ответило 403: код AccessDenied: ключ не подошёл";
	Стенд.Страж.ПринятьПробу(ПробаНеПустила(Ответ));

	Ожидаем.Что(Летопись.Записи()[0].Причина, "причина — ответ хранилища").Равно(Ответ);

КонецПроцедуры

#КонецОбласти

#Область ЭкранХранилища

// «Не отвечает» не выдаётся за «пусто»: полосы заполнения нет, занятое названо
// неизвестным, а причина и момент — на экране.
&Тест
Процедура ЛежащееХранилищеНаЭкранеНеВыглядитПустым() Экспорт

	Стенд = НовыйЭкран();
	Стенд.Пулы.Добавить("main", 7 * 1024 * 1024);
	Стенд.Настройки.Задать("oshub.storage.quota.bytes", 100 * 1024 * 1024);
	Стенд.Страж.ОтметитьБоевойОтказ("хранилище не ответило (срок ожидания — 10 с)");

	Разметка = Стенд.Витрина.Секция().Тело;

	Ожидаем.Что(Разметка, "состояние названо словами").Содержит("Не отвечает");
	Ожидаем.Что(Разметка, "и названа причина").Содержит("срок ожидания");
	Ожидаем.Что(Разметка, "и момент, с которого хранилище молчит").Содержит("UTC");
	Ожидаем.Что(Разметка, "занятое названо неизвестным").Содержит("неизвестно");
	Ожидаем.Что(СтрНайти(Разметка, "meter"),
		"полосы заполнения у лежащего хранилища нет: " + Разметка).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "7.0 МБ"),
		"и счётчики пулов за замер диска не выдаются").Равно(0);

КонецПроцедуры

&Тест
Процедура ОтвечающееХранилищеПоказываетЗанятоеИПолосу() Экспорт

	Стенд = НовыйЭкран();
	Стенд.Пулы.Добавить("main", 7 * 1024 * 1024);
	Стенд.Настройки.Задать("oshub.storage.quota.bytes", 100 * 1024 * 1024);
	Стенд.Страж.ОтметитьБоевойУспех();

	Разметка = Стенд.Витрина.Секция().Тело;

	Ожидаем.Что(Разметка, "состояние названо словами").Содержит("Отвечает");
	Ожидаем.Что(Разметка, "занятое место показано").Содержит("7.0 МБ");
	Ожидаем.Что(СтрНайти(Разметка, "meter") > 0, "и полоса заполнения нарисована").ЭтоИстина();
	// число учётное, а не замеренное: операторы сверяют его с `du` и задают вопросы
	Ожидаем.Что(Разметка, "сказано, что занятое — по учёту хаба").Содержит("по учёту самого хаба");

КонецПроцедуры

&Тест
Процедура ОтказДоступаНаЭкранеОтличимОтМолчанияИОтРаботы() Экспорт

	Стенд = НовыйЭкран();
	Стенд.Страж.ПринятьПробу(ПробаНеПустила("хранилище ответило 403: код AccessDenied"));

	Разметка = Стенд.Витрина.Секция().Тело;

	Ожидаем.Что(Разметка, "«не пустило» названо своими словами").Содержит("не пустило");
	Ожидаем.Что(Разметка, "и человеку сказано, что чинить").Содержит("доступ");
	Ожидаем.Что(СтрНайти(Разметка, "Не отвечает"),
		"за молчание отказ доступа не выдаётся: " + Разметка).Равно(0);

КонецПроцедуры

&Тест
Процедура НепроверенноеХранилищеТакИНазывается() Экспорт

	Разметка = НовыйЭкран().Витрина.Секция().Тело;

	Ожидаем.Что(Разметка, "до первой проверки так и сказано").Содержит("Ещё не проверялось");
	Ожидаем.Что(СтрНайти(Разметка, "Не отвечает"),
		"и это не «не отвечает»: " + Разметка).Равно(0);

КонецПроцедуры

// Период, с которым хаб сам снимает состояние, назван на экране: иначе «последний ответ»
// нечем измерить.
&Тест
Процедура ЭкранНазываетПериодСвоейПроверки() Экспорт

	Стенд = НовыйЭкран();
	Стенд.Настройки.Задать("oshub.jobs.storage_health_interval_sec", 45);

	Ожидаем.Что(Стенд.Витрина.Секция().Тело, "период проверки назван").Содержит("45");

КонецПроцедуры

// Экран в хранилище не ходит вовсе: ни за занятым объёмом, ни за пробой. Иначе открытие
// настроек стоило бы обхода каталога, а на молчащем S3 — часа ожидания.
&Тест
Процедура ЭкранХранилищеНеСпрашивает() Экспорт

	Стенд = НовыйЭкран();
	Стенд.Пулы.Добавить("main", 1024);
	Стенд.Страж.ОтметитьБоевойУспех();

	Стенд.Витрина.Секция();
	Стенд.Витрина.Секция();

	Ожидаем.Что(Стенд.Хранилище.Обращений(),
		"отрисовка экрана не стоила ни одного обращения к хранилищу").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ФайловыеМелочи

Процедура ПоложитьФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь);
	Запись.ЗаписатьСтроку(Текст);
	Запись.Закрыть();

КонецПроцедуры

// Сбой публикации как ИнформацияОбОшибке; Неопределено — публикация неожиданно удалась.
Функция СбойЗаписи(Знач Хранилище)

	Попытка
		Хранилище.Сохранить(Новый КоординатыАртефакта("main", "pkg", "1.0.0"),
			ПолучитьДвоичныеДанныеИзСтроки("артефакт"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ВердиктыПробы

// Исходы пробы такими, какими их отдаёт Доступность: страж разбирает их сам.

Функция ПробаОтветила()
	Возврат Новый Структура("Успех, ОтказДоступа, Сообщение", Истина, Ложь, "");
КонецФункции

Функция ПробаНеОтветила(Знач Сообщение)
	Возврат Новый Структура("Успех, ОтказДоступа, Сообщение", Ложь, Ложь, Сообщение);
КонецФункции

Функция ПробаНеПустила(Знач Сообщение)
	Возврат Новый Структура("Успех, ОтказДоступа, Сообщение", Ложь, Истина, Сообщение);
КонецФункции

#КонецОбласти

#Область Стенды

// Страж на ручных часах: срок памяти двигает тест, а не машина.
Функция НовыйСтраж(Знач Летопись)

	Настройки = НовыеНастройки();
	Страж = Новый СтражХранилища(Настройки, Летопись, Новый ОбъектыПроисшествий(Новый ИмяОбъектаАудита()),
		Новый КодыПроисшествий(), ЛогТестов());

	Часы = Новый ЧасыРучные(Дата(2026, 9, 21, 12, 0, 0));
	Страж.УстановитьЧасы(Часы);

	Возврат Новый Структура("Страж, Часы, Настройки, Летопись", Страж, Часы, Настройки, Летопись);

КонецФункции

// Экран, собранный руками на ките: между витриной и стражем не должно оказаться ничего
// лишнего, а хранилище в графе есть — им и меряется, ходил ли туда экран.
Функция НовыйЭкран()

	Стенд = НовыйСтраж(Новый ФейкЛетописьПроисшествий());

	Пулы = Новый ФейкПуловСОбъёмом();
	Хранилище = Новый СчитающееХранилищеАртефактов();
	Объёмы = Новый УчётОбъёмаПула(Пулы, Неопределено, Хранилище, Новый Массив());

	Витрина = Новый ВитринаХранилища(UI.Кит, UI.Ячейки, UI.РендерерНастроек, Стенд.Настройки,
		Новый ПотолокХранилища(Стенд.Настройки), Новый ОбъёмТекстом(), Новый ЗаполнениеПула(),
		UI.Тексты, Стенд.Страж, Объёмы, UI.Даты);

	Возврат Новый Структура("Витрина, Страж, Часы, Настройки, Пулы, Хранилище",
		Витрина, Стенд.Страж, Стенд.Часы, Стенд.Настройки, Пулы, Хранилище);

КонецФункции

Функция НовыеНастройки()

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.storage.backend", "fs");
	Настройки.Задать("oshub.storage.root", "./data");
	Настройки.Задать("oshub.storage.quota.bytes", 0);
	Настройки.Задать("oshub.storage.health.ttl.sec", 300);
	Настройки.Задать("oshub.storage.health.timeout.sec", 10);
	Настройки.Задать("oshub.jobs.storage_health_interval_sec", 60);
	Настройки.Задать("oshub.publish.max_upload_bytes", 26214400);
	Возврат Настройки;

КонецФункции

// Ключ доступа — латиницей: кириллица в нём роняет запрос до сети (ЗНАНИЕ, oint).
Функция ХранилищеНаПорту(Знач Порт)

	Клиент = Новый КлиентS3Oint("http://127.0.0.1:" + Формат(Порт, "ЧГ=0"), "us-east-1",
		"openhub", "AKIAPROBE", "probe-secret-key", Истина, ЛогТестов());
	Возврат Новый S3Хранилище(Клиент);

КонецФункции

Функция СрокМолчащейПробыСек()
	Возврат 3;
КонецФункции

// Ниже этого проба не ждала молчащее хранилище вовсе — значит упала не по сроку.
Функция МинимумОжиданияМс()
	Возврат 1500;
КонецФункции

// Потолок терпения теста: свой срок пробы — секунды, а без него клиент oint ждёт час.
Функция ПотолокОжиданияМс()
	Возврат 30000;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.здоровьехранилища");
КонецФункции

#КонецОбласти

#Область Слушатель

// ⚠ ОжидатьСоединения выжидает свой таймаут ЦЕЛИКОМ — ждём короткими ломтями.
Функция ПринятьСоединение(Знач Сервер, Знач ТаймаутМс)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутМс;
	Пока Истина Цикл
		Соединение = Сервер.ОжидатьСоединения(200);
		Если Соединение <> Неопределено Тогда
			Возврат Соединение;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

КонецФункции

Процедура Закрыть(Знач Соединение)

	Если Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Соединение.Закрыть();
	Исключение
		// проба уже сдалась по своему сроку — закрывать нечего
	КонецПопытки;

КонецПроцедуры

Процедура Остановить(Знач Сервер, Знач Порт)

	Попытка
		Сервер.Остановить();
	Исключение
		// слушатель мог не подняться — порт всё равно надо вернуть в оборот
	КонецПопытки;
	Выдача.Вернуть(Порт);

КонецПроцедуры

Процедура Дождаться(Знач Задание)

	Задания = Новый Массив();
	Задания.Добавить(Задание);
	ФоновыеЗадания.ОжидатьВсе(Задания, 60000);

КонецПроцедуры

#КонецОбласти

#Область ОтветыХранилища

Функция Ответ(Знач Статус)
	Возврат Новый Структура("status", Статус);
КонецФункции

Функция ОтветСКодом(Знач Статус, Знач КодОшибки)

	Ошибка = Новый Соответствие();
	Ошибка.Вставить("Code", КодОшибки);

	Тело = Новый Соответствие();
	Тело.Вставить("Error", Ошибка);

	Возврат Новый Структура("status, response", Статус, Тело);

КонецФункции

#КонецОбласти
