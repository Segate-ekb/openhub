// Правило «провайдер закрыт в странах» (ИСТ-ДОСТ-037) на значении: канон кодов, отказы
// по негодному коду, снятие правила, переживание перезапуска, уход правила вместе
// с провайдером, предохранитель последнего свободного провайдера, подсчёт учёток
// без другого входа и запись в журнал аудита. Контейнер на InMemory, резолвер имён —
// фейк без сети; парольный вход, восстановление и обстановка — фейки: набор судит
// правило, а не почту.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;           // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;
Перем Резолвер;       // ФейкРазрешительИмён — DNS без сети
Перем Принципалы;     // фикстура СтендПринципалов — принципал сессии и ключа
Перем Админ;          // Пользователь с ролью admin

Перем ПарольныйВход;  // ФейкПарольногоВхода — включён ли вход по логину и паролю
Перем Оценка;         // ФейкПоследствийЗакрытия — обстановка, которую видит администратор
Перем Правило_;       // ГеоправилоПровайдера над настоящим хранилищем
Перем Сервис_;        // СервисПровайдеровВхода, собранный поверх этого правила

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");

	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить();

	Слои.Подключить("основа");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));
	Слои.Подключить("вход, права, настройки, сеть");
	КаталогObs = ОбъединитьПути(Модули, "наблюдаемость", "Классы/телеметрия");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "СловарьТекстов");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	// справочник стран — общий на хаб; целиком «гео» не подключаем: его соседи тянут
	// compressor и ip, а правилу нужны только коды
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "гео", "Классы"), "КодыСтран");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "гео", "Классы"), "СправочникСтран");

	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкРазрешительИмён.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "НастройкиЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ЗаписывающийПодписчик.os"));
	РеестрФикстур.Подключить("ФейкПарольногоВхода");
	РеестрФикстур.Подключить("ФейкВосстановленияПароля");
	РеестрФикстур.Подключить("ФейкПоследствийЗакрытия");
	РеестрФикстур.Подключить("ФейкПровайдеровВБазе");
	РеестрФикстур.Подключить("ХранилищеГеоправилСВмешательством");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "геоправила-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Резолвер = Новый ФейкРазрешительИмён();
	Админ = Желудь("СервисПользователей").СоздатьПользователя(
		"root37", "", "password123", "admin");

КонецПроцедуры

&ПередКаждым
Процедура ОбновитьСтенд() Экспорт

	ПарольныйВход = Новый ФейкПарольногоВхода(Истина);
	Оценка = Новый ФейкПоследствийЗакрытия();
	Правило_ = СобратьПравило();
	Сервис_ = СобратьСервис(Правило_);

КонецПроцедуры

#Область КодыСтран

&Тест
Процедура РеестрЗнаетДействующиеКодыИНеЗнаетПользовательских() Экспорт

	Коды = Желудь("СправочникСтран");

	Ожидаем.Что(Коды.Количество(), "249 кодов ISO 3166-1 alpha-2 плюс XK").Равно(250);
	Ожидаем.Что(Коды.ЭтоКод("RU"), "RU — код").ЭтоИстина();
	Ожидаем.Что(Коды.ЭтоКод(" ru "), "регистр и пробелы не значимы").ЭтоИстина();
	Ожидаем.Что(Коды.ЭтоКод("XK"), "XK — так Косово зовут геобазы").ЭтоИстина();

	Для Каждого НеКод Из СтрРазделить("ZZ,XX,T1,AA,QM,UK,EU,R,RUS,", ",") Цикл
		Ожидаем.Что(Коды.ЭтоКод(НеКод),
			СтрШаблон("«%1» принят за код страны, а не должен", НеКод)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КодыПриводятсяККанонуПриСохранении() Экспорт

	Имя = ЗавестиПровайдера("canon");

	Исход = Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, " ru , BY,ru ,by , xk ");
	Ожидаем.Что(Исход.Успех, "канон принят: " + Исход.Сообщение).ЭтоИстина();

	Ожидаем.Что(Исход.Страны, "верхний регистр, по возрастанию, без дублей").Равно("BY,RU,XK");
	Ожидаем.Что(СтрСоединить(Правило_.Правило(ВРег(Имя)).Страны, "|"),
		"правило читается и по имени в другом регистре").Равно("BY|RU|XK");

КонецПроцедуры

&Тест
Процедура НеизвестныйКодОтвергаетсяИНазванСобой() Экспорт

	Имя = ЗавестиПровайдера("badcode");

	Исход = Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU, QQ, BY");

	Ожидаем.Что(Исход.Успех, "негодный код отбит").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, "QQ") > 0,
		"отказ называет сам код (текст: " + Исход.Сообщение + ")").ЭтоИстина();
	Ожидаем.Что(Правило_.Правило(Имя).Есть, "правило не записалось ни частично").ЭтоЛожь();

	// КОНТРОЛЬ: тот же ввод без негодного кода проходит
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU, BY").Успех,
		"КОНТРОЛЬ: отличие ровно в негодном коде").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПользовательскиеКодыСтранамиНеСчитаются() Экспорт

	Имя = ЗавестиПровайдера("private");

	Для Каждого НеКод Из СтрРазделить("ZZ,XX,T1", ",") Цикл
		Исход = Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, НеКод);
		Ожидаем.Что(Исход.Успех, СтрШаблон("«%1» принят за страну", НеКод)).ЭтоЛожь();
		Ожидаем.Что(СтрНайти(Исход.Сообщение, НеКод) > 0,
			СтрШаблон("отказ называет «%1»", НеКод)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЖизньПравила

&Тест
Процедура ПустойВводСнимаетПравило() Экспорт

	Имя = ЗавестиПровайдера("empty");
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех).ЭтоИстина();
	Ожидаем.Что(Правило_.Правило(Имя).Есть, "КОНТРОЛЬ: правило поставлено").ЭтоИстина();

	Исход = Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "   ");

	Ожидаем.Что(Исход.Успех, "пустой ввод принят").ЭтоИстина();
	Ожидаем.Что(Исход.Страны, "правила больше нет").Равно("");
	Ожидаем.Что(Правило_.Правило(Имя).Есть).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПравилоПереживаетПерезапуск() Экспорт

	Имя = ЗавестиПровайдера("restart");
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "KZ").Успех).ЭтоИстина();

	// новый экземпляр над той же базой: снимка в памяти у него ещё нет
	Свежее = СобратьПравило();

	Ожидаем.Что(Свежее.Правило(Имя).Текстом, "правило прочитано из базы").Равно("KZ");
	Ожидаем.Что(Свежее.ЕстьПравила(), "и хаб знает, что правила есть").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПовторноеСохранениеВторойСтрокиНеЗаводит() Экспорт

	Имя = ЗавестиПровайдера("dup");
	Хранилище = Желудь("ХранилищеГеоправил");

	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех).ЭтоИстина();
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "BY").Успех).ЭтоИстина();
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), ВРег(Имя), "KZ").Успех).ЭтоИстина();

	Ожидаем.Что(СтрокСКлючом(Хранилище, Имя),
		"на один ключ — одна строка, как бы ни писали имя").Равно(1);
	Ожидаем.Что(Правило_.Правило(Имя).Текстом, "последняя правка победила").Равно("KZ");

КонецПроцедуры

&Тест
Процедура УдалениеПровайдераУноситЕгоПравило() Экспорт

	Имя = ЗавестиПровайдера("gone");
	Сосед = ЗавестиПровайдера("stays");
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех).ЭтоИстина();
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Сосед, "BY").Успех).ЭтоИстина();

	Ожидаем.Что(Сервис_.Удалить(Принципалы.Сессия(Админ), Имя).Успех, "провайдер удалён")
		.ЭтоИстина();

	Ожидаем.Что(Правило_.Правило(Имя).Есть, "правило ушло вместе с провайдером").ЭтоЛожь();
	Ожидаем.Что(Правило_.Правило(Сосед).Текстом, "чужое правило цело").Равно("BY");

КонецПроцедуры

// Коды здесь нарочно экзотические: таблица правил живёт весь прогон, и сторож обязан
// говорить о СВОИХ странах, а не о том, что осталось от соседнего теста.
&Тест
Процедура ЗнаниеОПравилахОбновляетсяЗаписью() Экспорт

	Имя = ЗавестиПровайдера("cache");
	Второй = ЗавестиПровайдера("cache2");

	Ожидаем.Что(Правило_.Правило(Имя).Есть, "правила у этого провайдера ещё нет").ЭтоЛожь();
	Ожидаем.Что(ЧислоВхождений(Правило_.СтраныПравил(), "AQ"), "AQ ещё никем не названа")
		.Равно(0);

	Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "AQ, BV");
	Ожидаем.Что(Правило_.ЕстьПравила(), "после записи снимок пересобран").ЭтоИстина();
	Ожидаем.Что(ЧислоВхождений(Правило_.СтраныПравил(), "AQ"),
		"страна правила видна сразу").Равно(1);

	Правило_.Сохранить(Принципалы.Сессия(Админ), Второй, "HM, bv");
	Страны = Правило_.СтраныПравил();
	Ожидаем.Что(ЧислоВхождений(Страны, "HM"), "страна второго правила видна").Равно(1);
	Ожидаем.Что(ЧислоВхождений(Страны, "BV"), "общая страна названа один раз").Равно(1);

	Правило_.Снять(Принципалы.Сессия(Админ), Имя);
	Правило_.Снять(Принципалы.Сессия(Админ), Второй);
	Ожидаем.Что(ЧислоВхождений(Правило_.СтраныПравил(), "AQ"),
		"снятое правило унесло свою страну").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПровайдерИзОкружения

// Окружение описывает, КАК хаб говорит с провайдером, а правило — КОМУ он предлагается:
// перекрытие окружением правку правила не отменяет.
&Тест
Процедура ПровайдерИзОкруженияПравилоПринимаетАПравкуНет() Экспорт

	Имя = ЗавестиПровайдера("env");
	ПерекрытьОкружением(Имя);

	Правка = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, ВводПресета(Имя));
	Ожидаем.Что(Правка.Успех, "КОНТРОЛЬ: обычная правка перекрытой строки отбита").ЭтоЛожь();
	Ожидаем.Что(Правка.Код).Равно(409);

	Геоправка = Сервис_.ЗакрытьПоСтранам(Принципалы.Сессия(Админ), Имя, "RU");
	Ожидаем.Что(Геоправка.Успех, "правило принято: " + Геоправка.Сообщение).ЭтоИстина();
	Ожидаем.Что(Правило_.Правило(Имя).Текстом).Равно("RU");

КонецПроцедуры

&Тест
Процедура ПравилоНесуществующемуПровайдеруНеСтавится() Экспорт

	Исход = Сервис_.ЗакрытьПоСтранам(Принципалы.Сессия(Админ), "нет-такого", "RU");

	Ожидаем.Что(Исход.Успех, "провайдера нет").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(404);

КонецПроцедуры

#КонецОбласти

#Область ПраваИСборка

&Тест
Процедура ПравилоСтавитТолькоАдминХабаИТолькоСессией() Экспорт

	Имя = ЗавестиПровайдера("rights");
	Посторонний = Желудь("СервисПользователей").СоздатьПользователя(
		"alice37" + УникальныеИмена.Хвост(), "", "password123", "user");

	Аноним = Сервис_.ЗакрытьПоСтранам(Принципалы.Сессия(Неопределено), Имя, "RU");
	Ожидаем.Что(Аноним.Код, "аноним — 401").Равно(401);

	Чужой = Сервис_.ЗакрытьПоСтранам(Принципалы.Сессия(Посторонний), Имя, "RU");
	Ожидаем.Что(Чужой.Код, "не администратор — 403").Равно(403);

	Ключ = Сервис_.ЗакрытьПоСтранам(Принципалы.Ключ(Админ, "read,write", 0), Имя, "RU");
	Ожидаем.Что(Ключ.Код, "ключ доступа входом в хаб не управляет — 403").Равно(403);

	Ожидаем.Что(Правило_.Правило(Имя).Есть, "ни один отказ правила не поставил").ЭтоЛожь();
	Ожидаем.Что(Сервис_.ЗакрытьПоСтранам(Принципалы.Сессия(Админ), Имя, "RU").Успех,
		"КОНТРОЛЬ: администратор сессией правило ставит").ЭтоИстина();

КонецПроцедуры

// Fail-closed: несобранный механизм правил — отказ, а не молчаливое «сохранено».
&Тест
Процедура БезМеханизмаПравилСервисОтказывает() Экспорт

	Имя = ЗавестиПровайдера("nogeo");
	БезПравил = СобратьСервис(Неопределено);

	Исход = БезПравил.ЗакрытьПоСтранам(Принципалы.Сессия(Админ), Имя, "RU");

	Ожидаем.Что(Исход.Успех, "механизма нет — правило не ставится").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(403);
	Ожидаем.Что(Правило_.Правило(Имя).Есть).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Предохранитель

// Последний включённый провайдер без правила при выключенном пароле — это весь вход в хаб.
&Тест
Процедура ПоследнийСвободныйПровайдерПодПравилоНеУходит() Экспорт

	Имя = "solo" + УникальныеИмена.Хвост();
	Правило = ПравилоНадПровайдерами(Имя);
	ПарольныйВход.Установить(Ложь);

	Исход = Правило.Сохранить(Принципалы.Сессия(Админ), Имя, "RU");

	Ожидаем.Что(Исход.Успех, "правило заперло бы хаб целиком").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(409);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, Имя) > 0,
		"отказ называет провайдера (текст: " + Исход.Сообщение + ")").ЭтоИстина();
	Ожидаем.Что(Правило.Правило(Имя).Есть).ЭтоЛожь();

КонецПроцедуры

