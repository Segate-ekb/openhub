КонецПроцедуры

#КонецОбласти

#Область УчёткиБезДругогоВхода

&Тест
Процедура СчитаютсяТолькоАктивныеУчёткиБезПароляИСЛичностьюТолькоЭтогоИздателя() Экспорт

	Издатель = "https://idp.example/" + УникальныеИмена.Хвост();
	Чужой = "https://idp.other/" + УникальныеИмена.Хвост();
	Имя = ЗавестиПровайдераСИздателем("count", Издатель);

	Считается = ЗавестиУчётку("only", "");
	ПривязатьЛичность(Считается, Издатель);

	СПаролем = ЗавестиУчётку("pwd", "password123");
	ПривязатьЛичность(СПаролем, Издатель);

	СДвумя = ЗавестиУчётку("both", "");
	ПривязатьЛичность(СДвумя, Издатель);
	ПривязатьЛичность(СДвумя, Чужой);

	Закрытая = ЗавестиУчётку("blocked", "");
	ПривязатьЛичность(Закрытая, Издатель);
	Закрытая.Активен = Ложь;
	Закрытая.Сохранить();

	Обстановка = СобратьОценку(Истина, Истина).ДляПровайдера(Имя);

	Ожидаем.Что(Обстановка.Учёток,
		"считается только учётка без пароля и с личностями одного этого издателя").Равно(1);
	Ожидаем.Что(Обстановка.ПарольныйВход).ЭтоИстина();
	Ожидаем.Что(Обстановка.ВосстановлениеПароля).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВыключенныйПарольныйВходДелаетУчёткуСПаролемЗависимойОтПровайдера() Экспорт

	Издатель = "https://idp.example/" + УникальныеИмена.Хвост();
	Имя = ЗавестиПровайдераСИздателем("deadpwd", Издатель);

	СПаролем = ЗавестиУчётку("dead", "password123");
	ПривязатьЛичность(СПаролем, Издатель);

	СПаролем_ = СобратьОценку(Истина, Истина).ДляПровайдера(Имя);
	Ожидаем.Что(СПаролем_.Учёток, "КОНТРОЛЬ: с включённым паролём у неё есть другой вход")
		.Равно(0);

	БезПароля = СобратьОценку(Ложь, Ложь).ДляПровайдера(Имя);
	Ожидаем.Что(БезПароля.Учёток, "мёртвый пароль другим входом не является").Равно(1);
	Ожидаем.Что(БезПароля.ПарольныйВход).ЭтоЛожь();
	Ожидаем.Что(БезПароля.ВосстановлениеПароля).ЭтоЛожь();

КонецПроцедуры

// Идентификаторы уходят в базу порциями: «IN (…)» из всех активных учёток на большой
// инсталляции упирается в предел параметров запроса. Порция здесь маленькая нарочно —
// иначе для проверки пришлось бы заводить тысячи строк.
&Тест
Процедура ЛичностиЧитаютсяПорциямиИСчётОстаётсяВерным() Экспорт

	Издатель = "https://idp.example/" + УникальныеИмена.Хвост();
	Имя = ЗавестиПровайдераСИздателем("batch", Издатель);

	Зависимых = 5;
	Для Счётчик = 1 По Зависимых Цикл
		ПривязатьЛичность(ЗавестиУчётку("batch", ""), Издатель);
	КонецЦикла;

	Порциями = СобратьОценку(Истина, Истина);
	Порциями.УстановитьРазмерПорции(2);

	Ожидаем.Что(Порциями.ДляПровайдера(Имя).Учёток,
		"счёт верен, когда учёток больше одной порции").Равно(Зависимых);

	// КОНТРОЛЬ: одна порция на всех даёт тот же ответ — дело не в размере порции
	Целиком = СобратьОценку(Истина, Истина);
	Ожидаем.Что(Целиком.ДляПровайдера(Имя).Учёток, "КОНТРОЛЬ: ответ от порции не зависит")
		.Равно(Зависимых);

КонецПроцедуры

&Тест
Процедура УПровайдераБезИздателяЗависимыхУчётокНет() Экспорт

	Ожидаем.Что(СобратьОценку(Истина, Истина).ДляПровайдера("нет-такого").Учёток).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ЗакрытДляСтраны

&Тест
Процедура ЗакрытОтвечаетПоСпискуИРегистрКодаНеВажен() Экспорт

	Имя = ЗавестиПровайдера("shut");
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU, BY").Успех).ЭтоИстина();

	Ожидаем.Что(Правило_.Закрыт(Имя, "RU"), "страна из списка — закрыт").ЭтоИстина();
	Ожидаем.Что(Правило_.Закрыт(Имя, " by "), "регистр и пробелы не значимы").ЭтоИстина();
	Ожидаем.Что(Правило_.Закрыт(Имя, "KZ"), "страна вне списка — открыт").ЭтоЛожь();
	Ожидаем.Что(Правило_.Закрыт(ВРег(Имя), "RU"), "имя провайдера тоже без регистра")
		.ЭтоИстина();

КонецПроцедуры

// «Не проверил — отказал»: пустой код означает «страну определить не удалось», и при
// живом правиле такой посетитель считается закрытым.
&Тест
Процедура НеизвестнаяСтранаПриЖивомПравилеСчитаетсяЗакрытой() Экспорт

	Имя = ЗавестиПровайдера("unknown");
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех).ЭтоИстина();

	Для Каждого Негодный Из СтрРазделить(",  ,ZZ,XX,мусор", ",") Цикл
		Ожидаем.Что(Правило_.Закрыт(Имя, Негодный),
			СтрШаблон("«%1» — страна неизвестна, значит закрыт", Негодный)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура БезПравилаПровайдерОткрытЛюбойСтранеИНеизвестной() Экспорт

	Имя = ЗавестиПровайдера("nolimit");

	Ожидаем.Что(Правило_.Закрыт(Имя, "RU"), "правила нет — открыт").ЭтоЛожь();
	Ожидаем.Что(Правило_.Закрыт(Имя, ""), "и неизвестная страна тоже открыта").ЭтоЛожь();

КонецПроцедуры

// Колонку мог наполнить не сервис: строчная запись обязана читаться каноном, иначе
// «страны в списке нет» = ОТКРЫТ — отказ в небезопасную сторону.
&Тест
Процедура ЗаписьВКолонкеЧитаетсяКаноном() Экспорт

	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Правило = ПравилоНадХранилищем(Хранилище);

	// мимо сервиса, прямо в хранилище: строчными и с мусором рядом
	Хранилище.Установить("вход.провайдер:dirty", "ru, мусор", "тест", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Правило.Закрыт("dirty", "RU"),
		"строчная запись в колонке — та же страна").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Правило.Правило("dirty").Страны, "|"),
		"мусор из списка выброшен, страна осталась").Равно("RU");

КонецПроцедуры

// Одна испорченная запись не смеет молча открыть провайдера: правило остаётся живым
// и продолжает закрывать неизвестную страну.
&Тест
Процедура ПравилоИзОдногоМусораОстаётсяЖивым() Экспорт

	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Правило = ПравилоНадХранилищем(Хранилище);

	Хранилище.Установить("вход.провайдер:junk", "мусор", "тест", ТекущаяУниверсальнаяДата());

	Действующее = Правило.Правило("junk");
	Ожидаем.Что(Действующее.Есть, "правило живо — колонка не пуста").ЭтоИстина();
	Ожидаем.Что(Действующее.Страны.Количество(), "но стран в нём не осталось").Равно(0);
	Ожидаем.Что(Правило.Закрыт("junk", ""),
		"неизвестную страну такое правило закрывает").ЭтоИстина();
	Ожидаем.Что(Правило.Закрыт("junk", "RU"),
		"а названную мусором страну назвать некем — она открыта").ЭтоЛожь();

КонецПроцедуры

// Сбой чтения не смеет выглядеть как «правил нет»: упавшая база молча открывала бы
// закрытое, и снаружи это неотличимо от честного «открыт». Снятый снимок при этом
// продолжает отвечать без базы — он уже прочитан, и это не сбой, а кэш.
&Тест
Процедура ПадающаяТаблицаПравилБросаетАНеОтвечаетОткрыт() Экспорт

	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Прогретое = ПравилоНадХранилищем(Хранилище);
	Ожидаем.Что(Прогретое.Сохранить(Принципалы.Сессия(Админ), "boom", "RU").Успех).ЭтоИстина();
	Ожидаем.Что(Прогретое.Закрыт("boom", "KZ"), "КОНТРОЛЬ: исправная таблица отвечает")
		.ЭтоЛожь();

	Хранилище.Сломаться();

	Ожидаем.Что(Прогретое.Закрыт("boom", "RU"),
		"прочитанный снимок отвечает и без базы — это кэш, а не сбой").ЭтоИстина();

	// у свежего владельца снимка ещё нет: его вопросы пойдут в недоступную таблицу
	Холодное = ПравилоНадХранилищем(Хранилище);
	Для Каждого Вопрос Из СтрРазделить("Закрыт,Правило,ЕстьПравила,СтраныПравил", ",") Цикл
		Ожидаем.Что(ВопросПадает(Холодное, Вопрос),
			СтрШаблон("«%1» на недоступной таблице обязан бросить", Вопрос)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СнимокПравил

// Гонка «читатель начал до чужой записи, а опубликовал после неё»: устаревший снимок
// в кэш попасть не должен, иначе снятое правило живёт до следующей мутации.
&Тест
Процедура СнимокНачатыйДоЧужойЗаписиНеПубликуется() Экспорт

	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Правило = ПравилоНадХранилищем(Хранилище);
	Ожидаем.Что(Правило.Сохранить(Принципалы.Сессия(Админ), "race", "RU").Успех).ЭтоИстина();

	// следующее чтение начнётся до снятия правила и закончится после него
	Хранилище.СниматьПриПервомЧтении(Правило, "race");
	Правило.ЕстьПравила();

	Ожидаем.Что(Правило.Правило("race").Есть,
		"снимок, начатый до чужой записи, в кэш не попал").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БезЧужойЗаписиСнимокПубликуетсяИБазаБольшеНеЧитается() Экспорт

	// КОНТРОЛЬ соседнему тесту: без вмешательства снимок живёт, и повторные вопросы
	// в базу не ходят
	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Правило = ПравилоНадХранилищем(Хранилище);
	Ожидаем.Что(Правило.Сохранить(Принципалы.Сессия(Админ), "cached", "RU").Успех).ЭтоИстина();

	ДоЧтений = Хранилище.Чтений();
	Правило.ЕстьПравила();
	ПослеПервого = Хранилище.Чтений();

	Правило.Правило("cached");
	Правило.СтраныПравил();
	Правило.Закрыт("cached", "RU");

	Ожидаем.Что(ПослеПервого - ДоЧтений, "первый вопрос читает базу").Равно(1);
	Ожидаем.Что(Хранилище.Чтений(), "дальше отвечает снимок").Равно(ПослеПервого);

КонецПроцедуры

#КонецОбласти

#Область УходПровайдера

&Тест
Процедура ВыключениеПоследнейСвободнойДвериОтбивается() Экспорт

	Имя = ЗавестиПровайдера("offdoor");
	Стенд = ЧистоеПравилоНадПровайдерами(Имя);
	Сервис = СобратьСервис(Стенд);
	ПравилоПостороннему(Стенд);
	ПарольныйВход.Установить(Ложь);

	Исход = Сервис.Переключить(Принципалы.Сессия(Админ), Имя, Ложь);

	Ожидаем.Что(Исход.Успех, "выключение унесло бы последнюю свободную дверь").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(409);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Включён, "провайдер остался включённым")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УдалениеПоследнейСвободнойДвериОтбивается() Экспорт

	Имя = ЗавестиПровайдера("deldoor");
	Стенд = ЧистоеПравилоНадПровайдерами(Имя);
	Сервис = СобратьСервис(Стенд);
	ПравилоПостороннему(Стенд);
	ПарольныйВход.Установить(Ложь);

	Исход = Сервис.Удалить(Принципалы.Сессия(Админ), Имя);

	Ожидаем.Что(Исход.Успех, "удаление унесло бы последнюю свободную дверь").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(409);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя), "провайдер цел").Существует();

КонецПроцедуры

// Там, где геоправил нет вовсе, хаб обязан вести себя ровно как до этой истории:
// «выключить последнего провайдера при выключенном пароле» он разрешал и разрешает.
&Тест
Процедура БезЕдиногоПравилаВыключениеИУдалениеРаботаютКакРаньше() Экспорт

	Имя = ЗавестиПровайдера("asbefore");
	Стенд = ЧистоеПравилоНадПровайдерами(Имя);
	Сервис = СобратьСервис(Стенд);
	ПарольныйВход.Установить(Ложь);

	Ожидаем.Что(Стенд.Правило.ЕстьПравила(), "КОНТРОЛЬ: таблица правил пуста").ЭтоЛожь();
	Ожидаем.Что(Сервис.Переключить(Принципалы.Сессия(Админ), Имя, Ложь).Успех,
		"выключение последнего провайдера разрешено, как и раньше").ЭтоИстина();
	Ожидаем.Что(Сервис.Удалить(Принципалы.Сессия(Админ), Имя).Успех,
		"и удаление тоже").ЭтоИстина();

КонецПроцедуры

// Включение провайдера с правилом свободных дверей не убавляет, поэтому предохранителя
// не спрашивает вовсе — даже там, где выключение того же провайдера отбито.
&Тест
Процедура ВключениеПровайдераСПравиломРазрешеноТамГдеВыключениеОтбито() Экспорт

	Имя = ЗавестиПровайдера("onrule");
	Стенд = ЧистоеПравилоНадПровайдерами(Имя);
	Сервис = СобратьСервис(Стенд);
	ПравилоПостороннему(Стенд);
	ПарольныйВход.Установить(Ложь);

	Ожидаем.Что(Сервис.Переключить(Принципалы.Сессия(Админ), Имя, Ложь).Успех,
		"КОНТРОЛЬ: выключение на этом стенде отбито").ЭтоЛожь();
	Ожидаем.Что(Сервис.Переключить(Принципалы.Сессия(Админ), Имя, Истина).Успех,
		"включение дверей не отнимает").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Правило над НАСТОЯЩИМ хранилищем, но с фейковыми политикой и обстановкой: набор судит
// правило, а не почту и не учётки.
Функция СобратьПравило()

	Возврат Новый ГеоправилоПровайдера(
		Желудь("ХранилищеГеоправил"), Желудь("СправочникСтран"), Желудь("СписокЧерезЗапятую"),
		Желудь("КонфигурацияOIDC"), ПарольныйВход, Оценка, Желудь("ТекстыИнтерфейса"),
		Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Желудь("ИздательСобытий"));

КонецФункции

Функция СобратьСервис(Знач Геоправило)

	Правило = ?(ТипЗнч(Геоправило) = Тип("Структура"), Геоправило.Правило, Геоправило);

	Возврат Новый СервисПровайдеровВхода(
		Желудь("ХранилищеПровайдеровВхода"), Желудь("КонфигурацияOIDC"), СобратьРазбор(),
		Желудь("ПерехватчикАутентификации"), Желудь("СервисПрав"),
		Желудь("ТекстыИнтерфейса"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Желудь("ГейтТокена"), Желудь("ИздательСобытий"), Правило);

КонецФункции

// Настоящие последствия над настоящими учётками: фейковые здесь только политика
// парольного входа и доступность восстановления.
Функция СобратьОценку(Знач ПарольВключён, Знач ВосстановлениеДоступно)

	Возврат Новый ПоследствияЗакрытияПровайдера(
		Желудь("ХранилищеПользователей"), Желудь("ХранилищеВнешнихЛичностей"),
		Желудь("ХранилищеПровайдеровВхода"), Желудь("КонфигурацияOIDC"),
		Новый ФейкПарольногоВхода(ПарольВключён),
		Новый ФейкВосстановленияПароля(ВосстановлениеДоступно));

КонецФункции

Функция СобратьРазбор()
	Возврат Новый РазборПровайдераВхода(
		Новый ПресетыВхода(Желудь("ТекстыИнтерфейса"), Новый ИздателиOAuth2()),
		Новый ИздателиOAuth2(), СобратьВалидатор(),
		Желудь("РаскладкаСтатики"), Желудь("ТекстыИнтерфейса"), Желудь("ТекстОшибки"),
		Логирование.ПолучитьЛог("тест.oshub.геоправила"));
КонецФункции

Функция СобратьВалидатор()
	Возврат Новый ВалидаторАдресаПровайдера(Новый СвояСеть(Резолвер, Желудь("КанонIP")),
		Новый ИздателиOAuth2(), Желудь("ТекстыИнтерфейса"));
КонецФункции

Функция ЗавестиПровайдера(Знач Префикс)

	Имя = Префикс + УникальныеИмена.Хвост();
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя));
	Ожидаем.Что(Исход.Успех, "провайдер для стенда заведён: " + Исход.Сообщение).ЭтоИстина();
	Возврат Имя;

КонецФункции

// Издатель провайдера задаётся напрямую: подсчёт учёток идёт именно по нему.
Функция ЗавестиПровайдераСИздателем(Знач Префикс, Знач Издатель)

	Имя = Префикс + УникальныеИмена.Хвост();
	Хранилище = Желудь("ХранилищеПровайдеровВхода");

	Запись = Хранилище.СоздатьЗапись(Имя);
	Запись.Метка = Имя;
	Запись.ВидПротокола = "oidc";
	Запись.Издатель = Издатель;
	Запись.ИдентификаторКлиента = "cid";
	Запись.АдресВозврата = "https://hub.example.com/oidc/callback";
	Запись.Включён = Истина;
	Хранилище.Записать(Запись, "тест", ТекущаяУниверсальнаяДата());
	Желудь("КонфигурацияOIDC").Перечитать();

	Возврат Имя;

КонецФункции

Функция ЗавестиУчётку(Знач Префикс, Знач Пароль)

	Возврат Желудь("СервисПользователей").СоздатьПользователя(
		Префикс + УникальныеИмена.Хвост(), "", Пароль, "user");

КонецФункции

Процедура ПривязатьЛичность(Знач Пользователь, Знач Издатель)

	Личность = Желудь("ХранилищеВнешнихЛичностей").СоздатьЭлемент();
	Личность.ПользовательИдентификатор = Цел(Пользователь.Идентификатор);
	Личность.Издатель = Издатель;
	Личность.Субъект = "sub-" + УникальныеИмена.Хвост();
	Личность.Создана = ТекущаяУниверсальнаяДата();
	Личность.Сохранить();

КонецПроцедуры

Процедура ПерекрытьОкружением(Знач Имя)

	Оверрайд = Новый Структура();
	Оверрайд.Вставить("Имя", Имя);
	Оверрайд.Вставить("Издатель", "https://idp-env.test/realms/main");
	Оверрайд.Вставить("ИдентификаторКлиента", "из-окружения");
	Оверрайд.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Оверрайд);

КонецПроцедуры

Функция ВводПресета(Знач Имя)

	Данные = Новый Структура();
	Данные.Вставить("Имя", Имя);
	Данные.Вставить("Пресет", "google");
	Данные.Вставить("ИдентификаторКлиента", "client-id-значение");
	Данные.Вставить("СекретКлиента", "client-secret-значение");
	Данные.Вставить("АдресВозврата", "https://hub.example.com/oidc/callback");
	Данные.Вставить("Включён", Истина);
	Возврат Данные;

КонецФункции

// Правило над ЗАДАННЫМ хранилищем: и таблица правил, и её сбои принадлежат тесту.
Функция ПравилоНадХранилищем(Знач Хранилище)

	Возврат Новый ГеоправилоПровайдера(
		Хранилище, Желудь("СправочникСтран"), Желудь("СписокЧерезЗапятую"),
		Желудь("КонфигурацияOIDC"), ПарольныйВход, Оценка, Желудь("ТекстыИнтерфейса"),
		Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Неопределено);

КонецФункции

// Стенд ухода двери: ЧИСТАЯ таблица правил и ЗАДАННЫЙ набор включённых провайдеров —
// ни то, ни другое не должно зависеть от того, что оставили соседние тесты.
Функция ЧистоеПравилоНадПровайдерами(Знач ИменаЧерезЗапятую)

	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Провайдеры = Новый ФейкПровайдеровВБазе();
	Для Каждого Имя Из СтрРазделить(ИменаЧерезЗапятую, ",") Цикл
		Провайдеры.Добавить(СокрЛП(Имя), "https://idp.example/" + СокрЛП(Имя), Истина);
	КонецЦикла;

	Правило = Новый ГеоправилоПровайдера(
		Хранилище, Желудь("СправочникСтран"), Желудь("СписокЧерезЗапятую"),
		Новый КонфигурацияOIDC(Логирование.ПолучитьЛог("тест.oshub.геоправила"),
			Новый ПровайдерыИзБазы(Провайдеры)),
		ПарольныйВход, Оценка, Желудь("ТекстыИнтерфейса"),
		Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Неопределено);

	Возврат Новый Структура("Правило, Хранилище", Правило, Хранилище);

КонецФункции

// Правило постороннему провайдеру: на хабе появляются геоправила, и механизм перестаёт
// молчать, а множество дверей при этом не меняется.
Процедура ПравилоПостороннему(Знач Стенд)

	Исход = Стенд.Правило.Сохранить(Принципалы.Сессия(Админ),
		"посторонний" + УникальныеИмена.Хвост(), "RU");
	Ожидаем.Что(Исход.Успех, "правило постороннему поставлено: " + Исход.Сообщение).ЭтоИстина();

КонецПроцедуры

Функция ВопросПадает(Знач Правило, Знач Вопрос)

	Попытка
		Если Вопрос = "Закрыт" Тогда
			Правило.Закрыт("boom", "KZ");
		ИначеЕсли Вопрос = "Правило" Тогда
			Правило.Правило("boom");
		ИначеЕсли Вопрос = "ЕстьПравила" Тогда
			Правило.ЕстьПравила();
		Иначе
			Правило.СтраныПравил();
		КонецЕсли;
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Правило над ЗАДАННЫМ набором включённых провайдеров: предохранитель считает свободных
// от правил, и его ответ не должен зависеть от того, что оставили соседние тесты.
Функция ПравилоНадПровайдерами(Знач ИменаЧерезЗапятую)

	Провайдеры = Новый ФейкПровайдеровВБазе();
	Для Каждого Имя Из СтрРазделить(ИменаЧерезЗапятую, ",") Цикл
		Провайдеры.Добавить(СокрЛП(Имя), "https://idp.example/" + СокрЛП(Имя), Истина);
	КонецЦикла;

	Возврат Новый ГеоправилоПровайдера(
		Желудь("ХранилищеГеоправил"), Желудь("СправочникСтран"), Желудь("СписокЧерезЗапятую"),
		Новый КонфигурацияOIDC(Логирование.ПолучитьЛог("тест.oshub.геоправила"),
			Новый ПровайдерыИзБазы(Провайдеры)),
		ПарольныйВход, Оценка, Желудь("ТекстыИнтерфейса"),
		Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Желудь("ИздательСобытий"));

КонецФункции

Функция ЧислоВхождений(Знач Страны, Знач Код)

	Итог = 0;
	Для Каждого Страна Из Страны Цикл
		Если Страна = Код Тогда
			Итог = Итог + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция СтрокСКлючом(Знач Хранилище, Знач ИмяПровайдера)

	Искомый = "вход.провайдер:" + НРег(ИмяПровайдера);
	Итог = 0;
	Для Каждого Запись Из Хранилище.Все() Цикл
		Если НРег(Строка(Запись.Ключ)) = Искомый Тогда
			Итог = Итог + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти
