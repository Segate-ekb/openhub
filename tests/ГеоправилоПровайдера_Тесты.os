	Ожидаем.Что(Последний.Успех, "а вот второму правило уже не поставить").ЭтоЛожь();
	Ожидаем.Что(Последний.Код).Равно(409);

КонецПроцедуры

&Тест
Процедура ПравкаУжеЗакрытогоПровайдераПредохранителемНеОтбивается() Экспорт

	Имя = "already" + УникальныеИмена.Хвост();
	Правило = ПравилоНадПровайдерами(Имя);
	Ожидаем.Что(Правило.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех).ЭтоИстина();
	ПарольныйВход.Установить(Ложь);

	// свободных провайдеров и так нет: правка списка стран ничего не отнимает
	Ожидаем.Что(Правило.Сохранить(Принципалы.Сессия(Админ), Имя, "RU, BY").Успех,
		"список стран уже закрытого провайдера правится").ЭтоИстина();
	Ожидаем.Что(Правило.Снять(Принципалы.Сессия(Админ), Имя).Успех,
		"и снимается тоже").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Аудит

&Тест
Процедура ПравкаПравилаПишетсяВЖурналСТемЧтоАдминистраторВидел() Экспорт

	Имя = ЗавестиПровайдера("audit");
	Оценка.Установить(3, Ложь, Ложь);

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПровайдерВходаИзменён(), Слушатель);

	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех).ЭтоИстина();

	Событие = Слушатель.Первое(Издатель.ТипПровайдерВходаИзменён());
	Ожидаем.Что(Событие, "событие опубликовано").Существует();
	Ожидаем.Что(Строка(Событие.Данные.Действие)).Равно("провайдер.геоправило");
	Ожидаем.Что(СтрНайти(Строка(Событие.Данные.Объект), Имя) > 0,
		"объект журнала — этот провайдер").ЭтоИстина();

	Детали = Строка(Событие.Данные.ДеталиJSON);
	Ожидаем.Что(СтрНайти(Детали, "RU") > 0, "новое значение в деталях").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Детали, "УчётокБезДругогоВхода") > 0,
		"сколько учёток остаётся без другого входа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Детали, "ПарольныйВход") > 0, "включён ли парольный вход").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Детали, "ВосстановлениеПароля") > 0,
		"доступно ли восстановление пароля").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПовторноеСохранениеБезИзмененийВЖурналНеПишет() Экспорт

	Имя = ЗавестиПровайдера("nochange");
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "RU, BY").Успех).ЭтоИстина();

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПровайдерВходаИзменён(), Слушатель);

	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, " by , ru ").Успех,
		"тот же список в другой записи принят").ЭтоИстина();
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПровайдерВходаИзменён()),
		"журнал показывает изменения, а не нажатия кнопки").Равно(0);

	// КОНТРОЛЬ: изменение того же правила записью становится
	Ожидаем.Что(Правило_.Сохранить(Принципалы.Сессия(Админ), Имя, "KZ").Успех).ЭтоИстина();
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПровайдерВходаИзменён()) > 0,
		"КОНТРОЛЬ: отличие ровно в изменении").ЭтоИстина();

КонецПроцедуры

