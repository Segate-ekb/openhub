	// КОНТРОЛЬ соседнему тесту: стенд тот же, отличие ровно в парольном входе
	Имя = "withpwd" + УникальныеИмена.Хвост();
	Правило = ПравилоНадПровайдерами(Имя);
	ПарольныйВход.Установить(Истина);

	Ожидаем.Что(Правило.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех,
		"пароль остаётся дверью — правило допустимо").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПокаЕстьВторойСвободныйПровайдерПравилоСтавится() Экспорт

	Хвост = УникальныеИмена.Хвост();
	Первый = "free1" + Хвост;
	Второй = "free2" + Хвост;
