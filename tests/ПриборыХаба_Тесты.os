// Числа хаба и приборы, которые их снимают: сорванный подсчёт отдаёт -1, наблюдением
// не становится и называет причину в журнале; выключенная телеметрия приборов не заводит;
// работа хаба считается счётчиками на шине событий, и разрез у них один — имя пула.

#Использовать asserts
#Использовать autumn-logos
#Использовать opentelemetry
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	КаталогПроб = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	КаталогТелеметрии = ОбъединитьПути(КаталогМодулей,
		ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПроб, "РазмерыПубличногоРеестра.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПроб, "ЧислаХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТелеметрии, "ПриборыХаба.os"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей,
		"события", "Классы/ИздательСобытий.os"));
	КаталогПровайдеров = ОбъединитьПути(КаталогМодулей, "вход", "Классы/провайдером");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПровайдеров, "ГейтВходаПоСтране.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПровайдеров, "ГеоправилоПровайдера.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей,
		"наблюдаемость", "Классы/журнал/ОбезличиваниеЖурнала.os"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "гео", "Классы"), "КодыСтран");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "гео", "Классы"), "СправочникСтран");
	РеестрФикстур.Подключить("ХранилищеГеоправилСВмешательством");

	РеестрФикстур.Подключить("РеестрЗаданийЗаглушка");
	РеестрФикстур.Подключить("ТабакеркаНаблюдаемая");
	РеестрФикстур.Подключить("РеестрОбразцаДляЧисел");
	РеестрФикстур.Подключить("НаблюдениеЗаписью");
	РеестрФикстур.Подключить("ПриборЗаглушка");
	РеестрФикстур.Подключить("МетрЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");

КонецПроцедуры

#Область ЧислаРеестра

// Числа считаются в одном месте и одинаково для всех: адрес /api/v1/metrics и приборы
// OTel спрашивают этот желудь, а не каждый свой реестр.
&Тест
Процедура СнимокСчитаетТолькоПубличноеИВидимое() Экспорт

	Снимок = НовыеРазмеры(РеестрОбразца()).Снимок();

	Ожидаем.Что(Снимок.Пулы, "приватный пул в счёт не идёт").Равно(2);
	Ожидаем.Что(Снимок.Пакеты, "скрытый пакет и пакет приватного пула в счёт не идут").Равно(3);

КонецПроцедуры

// Анонимный адрес не имеет права падать из-за реестра, а фоновый срез метрик — тем более:
// сбой подсчёта отдаётся числом-признаком и строкой журнала, а не исключением.
&Тест
Процедура СбойПодсчётаОтдаётПризнакИНазываетПричину() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Размеры = НовыеРазмеры(СорванныйРеестр(), Ловушка);

	Снимок = Размеры.Снимок();

	Ожидаем.Что(Снимок.Пулы, "пулы отданы признаком «посчитать не вышло»").Равно(-1);
	Ожидаем.Что(Снимок.Пакеты, "пакеты отданы признаком «посчитать не вышло»").Равно(-1);
	Ожидаем.Что(Размеры.Посчитано(Снимок.Пулы), "признак посчитанным не считается").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "намеренный сбой") > 0,
		"причина сбоя названа в журнале, иначе -1 остаётся загадкой: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЧислаХаба

// Числа хаба снимаются ОДНИМ снимком: адрес и график обязаны рассказывать об одном
// мгновении, а не о девяти разных. Занятое место снимается и по пулам — оператору, —
// и суммой по публичным: анониму приватный пул не виден даже агрегатом.
&Тест
Процедура СнимокСобираетВсеЧислаХабаЗаРаз() Экспорт

	Снимок = НовыеЧисла(РеестрОбразца()).Снимок();

	Ожидаем.Что(Снимок.Пулы, "публичные пулы").Равно(2);
	Ожидаем.Что(Снимок.Пакеты, "видимые пакеты").Равно(3);
	Ожидаем.Что(Снимок.Версии, "версии реестра").Равно(17);
	Ожидаем.Что(Снимок.Пользователи, "пользователи хаба").Равно(4);
	Ожидаем.Что(Снимок.Скачивания, "скачивания сложены по всем пакетам").Равно(12);
	Ожидаем.Что(Снимок.ОчередьВебхуков, "очередь доставок").Равно(3);
	Ожидаем.Что(Снимок.ОчередьЗеркал, "очередь обходов зеркал").Равно(2);
	Ожидаем.Что(Снимок.ПропущенныеСобытия, "уроненные доставки событий").Равно(1);

	Ожидаем.Что(Снимок.МестоПоПулам.Количество(),
		"место снято по каждому пулу, включая приватный").Равно(3);
	Ожидаем.Что(Снимок.МестоПублично,
		"анониму сложено только публичное место: 1000 + 200, приватные 7000 в счёт не идут")
		.Равно(1200);

КонецПроцедуры

// Сбой одного источника не отнимает снимок у остальных: оператор теряет один ряд графика,
// а не все числа хаба разом.
&Тест
Процедура СбойОдногоЧислаОстальныхНеРоняет() Экспорт

	Реестр = РеестрОбразца();
	Реестр.СорватьПользователей();
	Ловушка = Новый ЛовушкаЛога();

	Числа = НовыеЧисла(Реестр, Ловушка);
	Снимок = Числа.Снимок();

	Ожидаем.Что(Снимок.Пользователи, "сорванное число отдано признаком").Равно(-1);
	Ожидаем.Что(Числа.Посчитано(Снимок.Пользователи), "признак посчитанным не считается").ЭтоЛожь();
	Ожидаем.Что(Снимок.Версии, "соседнее число посчитано как ни в чём не бывало").Равно(17);
	Ожидаем.Что(Снимок.Пулы, "и числа реестра тоже").Равно(2);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "намеренный сбой счёта пользователей") > 0,
		"причина названа в журнале: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПриборыСнимаютЧисла

// Выключенная телеметрия приборов не заводит и за SDK не ходит: приборы — такая же
// вторая дверь к SDK, как мост журнала. Шину событий она тоже не трогает.
&Тест
Процедура ВыключеннаяТелеметрияПриборовНеЗаводит() Экспорт

	ТабакеркаSdk = Новый ТабакеркаНаблюдаемая(Новый МетрЗаглушка());
	ТабакеркаЧисел = Новый ТабакеркаНаблюдаемая(НовыеЧисла(РеестрОбразца()));
	ТабакеркаИздателя = Новый ТабакеркаНаблюдаемая(Новый ИздательСобытий());

	Приборы = Новый ПриборыХаба(ТабакеркаSdk, ТабакеркаЧисел,
		Новый ТабакеркаНаблюдаемая(НовыйГейт()), Ложь, ЛогТестов(),
		Новый ТекстОшибки(), Новый ПриведениеФлагов(),
		Новый ТабакеркаНаблюдаемая(Новый РеестрЗаданийЗаглушка()), ТабакеркаИздателя);

	Приборы.ПриЗапускеПриложения();

	Ожидаем.Что(ТабакеркаSdk.ЧислоДоставаний(), "из табакерки SDK не доставали").Равно(0);
	Ожидаем.Что(ТабакеркаЧисел.ЧислоДоставаний(),
		"и числа хаба не спрашивали: выключенная телеметрия не тянет чужой модуль в контейнер")
		.Равно(0);
	Ожидаем.Что(ТабакеркаИздателя.ЧислоДоставаний(),
		"и на шину событий не подписывались").Равно(0);

КонецПроцедуры

// Включённая телеметрия заводит приборы через метр и подписывает счётчики на шину:
// прибор, не заведённый метром, не уедет никуда, а неподписанный счётчик не вырастет.
&Тест
Процедура ВключённаяТелеметрияЗаводитПриборыИПодписываетСчётчики() Экспорт

	Метр = Новый МетрЗаглушка();
	Издатель = Новый ИздательСобытий();

	ПриборыНадМетром(Метр, Издатель).ПриЗапускеПриложения();

	Ожидаем.Что(Метр.Прибор(ИмяПрибораПулов()) <> Неопределено,
		"датчик публичных пулов заведён").ЭтоИстина();
	Ожидаем.Что(Метр.Прибор(ИмяПрибораЗанятого()).ЕдиницаИзмерения(),
		"занятое место заведено в байтах").Равно("By");
	Ожидаем.Что(Метр.Прибор(ИмяСчётчикаСкачиваний()) <> Неопределено,
		"счётчик скачиваний заведён").ЭтоИстина();
	Ожидаем.Что(Издатель.КоличествоПодписчиков(Издатель.ТипСкачиваниеЗафиксировано()),
		"на скачивание подписан счётчик").Равно(1);
	Ожидаем.Что(Издатель.КоличествоПодписчиков(Издатель.ТипВерсияОпубликована()),
		"и на публикацию тоже").Равно(1);

КонецПроцедуры

// Посчитанное записывается приборами ровно тем, что отдал ОДИН снимок: иначе числа
// уезжали бы из разных мгновений.
&Тест
Процедура ПосчитанноеЗаписываетсяПриборамиИзОдногоСнимка() Экспорт

	Метр = Новый МетрЗаглушка();
	ПриборыНадМетром(Метр).ПриЗапускеПриложения();

	Наблюдения = Метр.Снять();

	Ожидаем.Что(Наблюдения[ИмяПрибораПулов()].Записанное(), "публичные пулы записаны").Равно(2);
	Ожидаем.Что(Наблюдения[ИмяПрибораПакетов()].Записанное(), "видимые пакеты записаны").Равно(3);
	Ожидаем.Что(Наблюдения["oshub.versions"].Записанное(), "версии записаны").Равно(17);
	Ожидаем.Что(Наблюдения["oshub.users"].Записанное(), "пользователи записаны").Равно(4);
	Ожидаем.Что(Наблюдения["oshub.downloads.all_time"].Записанное(),
		"скачивания за всё время записаны").Равно(12);
	Ожидаем.Что(Наблюдения["oshub.webhooks.queue"].Записанное(),
		"очередь доставок записана").Равно(3);
	Ожидаем.Что(Наблюдения["oshub.mirror.queue"].Записанное(),
		"очередь обходов записана").Равно(2);
	Ожидаем.Что(Наблюдения["oshub.events.dropped"].Записанное(),
		"уроненные доставки записаны").Равно(1);

КонецПроцедуры

// У занятого места своя точка данных на каждый пул: без имени пула график отвечает
// «занято столько-то», но не отвечает «кем».
&Тест
Процедура ЗанятоеМестоЗаписываетсяТочкойНаКаждыйПул() Экспорт

	Метр = Новый МетрЗаглушка();
	ПриборыНадМетром(Метр).ПриЗапускеПриложения();

	Занятое = Метр.Снять()[ИмяПрибораЗанятого()];

	Ожидаем.Что(Занятое.Количество(), "точка данных на каждый пул, приватный включая").Равно(3);
	Ожидаем.Что(Занятое.ЗаписанноеСАтрибутом(КлючПула(), "p1"),
		"место публичного пула помечено его именем").Равно(1000);
	Ожидаем.Что(Занятое.ЗаписанноеСАтрибутом(КлючПула(), "секрет"),
		"оператор видит и приватный пул: коллектор — его, а не гостя").Равно(7000);

КонецПроцедуры

// Сорванный подсчёт наблюдением не становится: -1 на графике «пулов в реестре» врал бы
// убедительнее, чем разрыв в ряду.
&Тест
Процедура СорванныйПодсчётНаблюдениемНеСтановится() Экспорт

	Метр = Новый МетрЗаглушка();
	Числа = НовыеЧисла(СорванныйРеестр(), Новый ЛовушкаЛога());

	ПриборыНад(Метр, Числа).ПриЗапускеПриложения();
	Наблюдения = Метр.Снять();

	Ожидаем.Что(Наблюдения[ИмяПрибораПулов()].Количество(),
		"сорванный подсчёт пулов не записан").Равно(0);
	Ожидаем.Что(Наблюдения[ИмяПрибораПакетов()].Количество(),
		"сорванный подсчёт пакетов не записан").Равно(0);
	Ожидаем.Что(Наблюдения[ИмяПрибораЗанятого()].Количество(),
		"и точек занятого места нет ни одной").Равно(0);
	Ожидаем.Что(Наблюдения["oshub.users"].Записанное(),
		"а соседнее число сорванным не стало").Равно(4);

КонецПроцедуры

// ИСТ-ДОСТ-037: каждый отказ по правилу о стране считается в телеметрии. Прибор снимает
// тот же счётчик, который растёт у гейта, а не своё независимое число.
&Тест
Процедура ОтказыПоСтранеСнимаютсяСоСчётчикаГейта() Экспорт

	Гейт = НовыйГейт();
	Наблюдения = Новый Соответствие();
	Наблюдения.Вставить(ИмяПрибораОтказов(), Новый НаблюдениеЗаписью());

	Приборы = НовыеПриборы(Новый ТабакеркаНаблюдаемая(Неопределено),
		НовыеЧисла(РеестрОбразца()), Истина, Гейт);

	Приборы.СнятьОтказыПоСтране(Наблюдения);
	Ожидаем.Что(Наблюдения[ИмяПрибораОтказов()].Записанное(),
		"отказов ещё не было — прибор пишет ноль").Равно(0);

	// гейт без правил и определителя не может проверить правило и потому закрывает вход:
	// это настоящий отказ, а не подкрученное поле
	Гейт.Закрыт("github", Неопределено);
	Гейт.Закрыт("github", Неопределено);

	Приборы.СнятьОтказыПоСтране(Наблюдения);
	Ожидаем.Что(Наблюдения[ИмяПрибораОтказов()].Записанное(),
		"оба отказа сосчитаны").Равно(2);

КонецПроцедуры

// Реестр фоновых заданий платформы отработавшие задания не отпускает, и его рост —
// то, за чем оператор следит графиком. Прибор спрашивает реестр на каждый срез,
// а не запоминает первое увиденное число.
&Тест
Процедура РазмерРеестраЗаданийСнимаетсяНаКаждыйСрез() Экспорт

	Реестр = Новый РеестрЗаданийЗаглушка(7);
	Наблюдения = Новый Соответствие();
	Наблюдения.Вставить(ИмяПрибораЗаданий(), Новый НаблюдениеЗаписью());

	Приборы = НовыеПриборыНадРеестромЗаданий(Реестр);

	Приборы.СнятьРазмерРеестраЗаданий(Наблюдения);
	Ожидаем.Что(Наблюдения[ИмяПрибораЗаданий()].Записанное(),
		"прибор записал текущий размер реестра").Равно(7);

	Реестр.Наполнить(19);
	Приборы.СнятьРазмерРеестраЗаданий(Наблюдения);
	Ожидаем.Что(Наблюдения[ИмяПрибораЗаданий()].Записанное(),
		"следующий срез снят с реестра заново, а не из памяти прибора").Равно(19);

	Реестр.Очистить();
	Приборы.СнятьРазмерРеестраЗаданий(Наблюдения);
	Ожидаем.Что(Наблюдения[ИмяПрибораЗаданий()].Записанное(),
		"после уборки прибор показывает пустой реестр").Равно(0);

КонецПроцедуры

// Срез без нашего прибора — не повод ни падать, ни будить реестр: SDK зовёт обратный
// вызов со СВОИМ набором наблюдений, и чужого в нём может не оказаться.
&Тест
Процедура СрезБезПрибораЗаданийРеестрНеБудит() Экспорт

	Реестр = Новый РеестрЗаданийЗаглушка(7);
	Табакерка = Новый ТабакеркаНаблюдаемая(Реестр);

	НовыеПриборыНадТабакеркойЗаданий(Табакерка).СнятьРазмерРеестраЗаданий(Новый Соответствие());

	Ожидаем.Что(Табакерка.ЧислоДоставаний(),
		"без своего наблюдения прибор реестр не спрашивает").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СчётчикиСобытий

// Скачивание считается там, где о нём объявляют, — на шине событий, и точка данных
// несёт имя пула: без него график отвечает «скачали», но не отвечает «откуда».
&Тест
Процедура СкачиваниеСчитаетсяСобытиемИНазываетПул() Экспорт

	Метр = Новый МетрЗаглушка();
	Издатель = Новый ИздательСобытий();
	ПриборыНадМетром(Метр, Издатель).ПриЗапускеПриложения();

	Издатель.Опубликовать(Издатель.ТипСкачиваниеЗафиксировано(), ДанныеСкачивания("p1"));
	Издатель.Опубликовать(Издатель.ТипСкачиваниеЗафиксировано(), ДанныеСкачивания("p1"));

	Счётчик = Метр.Прибор(ИмяСчётчикаСкачиваний());
	Ожидаем.Что(Счётчик.Количество(), "оба скачивания сосчитаны").Равно(2);
	Ожидаем.Что(Счётчик.ПоследнийАтрибут(КлючПула()),
		"точка данных помечена именем пула").Равно("p1");

КонецПроцедуры

// Отзыв и возврат — две стороны одного действия: прибор у них один, а различает их
// атрибут. Иначе на графике пришлось бы складывать два ряда, чтобы получить один.
&Тест
Процедура ОтзывИВозвратСчитаютсяОднимПриборомСРазнымДействием() Экспорт

	Метр = Новый МетрЗаглушка();
	Издатель = Новый ИздательСобытий();
	ПриборыНадМетром(Метр, Издатель).ПриЗапускеПриложения();

	Издатель.Опубликовать(Издатель.ТипВерсияОтозвана(), ДанныеСкачивания("p2"));
	Счётчик = Метр.Прибор("oshub.versions.state_changes");
	Ожидаем.Что(Счётчик.ПоследнийАтрибут("oshub.version.action"),
		"отзыв помечен своим действием").Равно("yanked");

	Издатель.Опубликовать(Издатель.ТипВерсияВосстановлена(), ДанныеСкачивания("p2"));
	Ожидаем.Что(Счётчик.Количество(), "оба события сосчитал ОДИН прибор").Равно(2);
	Ожидаем.Что(Счётчик.ПоследнийАтрибут("oshub.version.action"),
		"возврат помечен своим действием").Равно("restored");

КонецПроцедуры

// Событие, которого приборы не считают, их не касается: подписчик обязан молча пропускать
// чужие типы, иначе первый же новый тип события уронил бы доставку остальным.
&Тест
Процедура ЧужоеСобытиеПриборыНеСчитают() Экспорт

	Метр = Новый МетрЗаглушка();
	Приборы = ПриборыНадМетром(Метр);
	Приборы.ПриЗапускеПриложения();

	Приборы.ОбработатьСобытие(Новый Структура("Тип, Когда, Данные",
		"пул.удалён", ТекущаяУниверсальнаяДата(), ДанныеСкачивания("p1")));

	Ожидаем.Что(Метр.Прибор(ИмяСчётчикаСкачиваний()).Количество(),
		"чужой тип события счётчик скачиваний не трогает").Равно(0);

КонецПроцедуры

// Приезд версии зеркалом считается по пулу назначения: без имени пула график отвечает
// «зеркало что-то привезло», но не отвечает «куда».
&Тест
Процедура ПриездВерсииЗеркаломНазываетПулНазначения() Экспорт

	Метр = Новый МетрЗаглушка();
	Издатель = Новый ИздательСобытий();
	ПриборыНадМетром(Метр, Издатель).ПриЗапускеПриложения();

	Издатель.Опубликовать(Издатель.ТипВерсияЗеркалирована(),
		Новый Структура("ЗеркалоИдентификатор, ПулИдентификатор, ИмяПула", 7, 42, "зеркальный"));

	Счётчик = Метр.Прибор("oshub.mirror.versions");
	Ожидаем.Что(Счётчик.Количество(), "приезд версии зеркалом сосчитан").Равно(1);
	Ожидаем.Что(Счётчик.ПоследнийАтрибут(КлючПула()),
		"точка данных помечена пулом назначения").Равно("зеркальный");

КонецПроцедуры

// Сбой прибора остаётся внутри телеметрии: шина изолирует подписчиков сама, но
// уронившаяся доставка считается пропущенной — и хаб докладывал бы о потере события,
// которого не было. Наружу из подписчика не вылетает ничего, а в журнале сбой назван.
&Тест
Процедура СбойПрибораНеСтановитсяПропущеннойДоставкой() Экспорт

	Метр = Новый МетрЗаглушка();
	Издатель = Новый ИздательСобытий();
	Ловушка = Новый ЛовушкаЛога();
	ПриборыНадМетром(Метр, Издатель, Ловушка).ПриЗапускеПриложения();

	Метр.Прибор(ИмяСчётчикаСкачиваний()).Сорваться();
	Издатель.Опубликовать(Издатель.ТипСкачиваниеЗафиксировано(), ДанныеСкачивания("p1"));

	Ожидаем.Что(Издатель.ПропущенныхДоставок(),
		"сбой прибора наружу не вылетел: шина уроненных доставок не насчитала").Равно(0);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "прибором не сосчитано") > 0,
		"и сбой назван в журнале, иначе счётчик молча стоял бы: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Событие без имени пула считается без атрибута: пустое имя пула на графике выглядело бы
// отдельным пулом с пустым именем.
&Тест
Процедура СобытиеБезИмениПулаСчитаетсяБезАтрибута() Экспорт

	Метр = Новый МетрЗаглушка();
	Издатель = Новый ИздательСобытий();
	ПриборыНадМетром(Метр, Издатель).ПриЗапускеПриложения();

	Издатель.Опубликовать(Издатель.ТипВерсияЗеркалирована(),
		Новый Структура("ПулИдентификатор", 42));

	Счётчик = Метр.Прибор("oshub.mirror.versions");
	Ожидаем.Что(Счётчик.Количество(), "приезд версии зеркалом сосчитан").Равно(1);
	Ожидаем.Что(Счётчик.ПоследнийАтрибут(КлючПула()),
		"имени пула у события нет — и атрибута нет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Два публичных пула (три видимых пакета и один скрытый) и один приватный с пакетом;
// остальные числа хаба заданы явно, чтобы каждое было узнаваемо в снимке.
Функция РеестрОбразца()

	Реестр = Новый РеестрОбразцаДляЧисел();

	Реестр.ДобавитьПул("p1", Истина, 1000);
	Реестр.ДобавитьПакет("p1", Ложь);
	Реестр.ДобавитьПакет("p1", Ложь);
	Реестр.ДобавитьПакет("p1", Истина);

	Реестр.ДобавитьПул("p2", Истина, 200);
	Реестр.ДобавитьПакет("p2", Ложь);

	Реестр.ДобавитьПул("секрет", Ложь, 7000);
	Реестр.ДобавитьПакет("секрет", Ложь);

	Реестр.ЗадатьЧисла(17, 4, 3, 2, 1);
	Реестр.ДобавитьСкачивания(1, 5);
	Реестр.ДобавитьСкачивания(2, 7);

	Возврат Реестр;

КонецФункции

Функция СорванныйРеестр()

	Реестр = РеестрОбразца();
	Реестр.Сорваться();

	Возврат Реестр;

КонецФункции

// Реестр-образец играет за все службы разом: их спрашивают два желудя чисел.
Функция НовыеРазмеры(Знач Реестр, Знач Ловушка = Неопределено)
	Возврат Новый РазмерыПубличногоРеестра(Реестр, Реестр, Реестр, ЛогТестов(Ловушка),
		Новый ТекстОшибки());
КонецФункции

Функция НовыеЧисла(Знач Реестр, Знач Ловушка = Неопределено)
	Возврат Новый ЧислаХаба(НовыеРазмеры(Реестр, Ловушка), Реестр, Реестр, Реестр, Реестр,
		Реестр, Реестр, Реестр, Реестр, ЛогТестов(Ловушка), Новый ТекстОшибки());
КонецФункции

Функция НовыеПриборы(Знач ТабакеркаSdk, Знач Числа, Знач Включено, Знач Гейт = Неопределено,
	Знач Издатель = Неопределено, Знач Ловушка = Неопределено)

	Возврат Новый ПриборыХаба(ТабакеркаSdk, Новый ТабакеркаНаблюдаемая(Числа),
		Новый ТабакеркаНаблюдаемая(?(Гейт = Неопределено, НовыйГейт(), Гейт)), Включено,
		ЛогТестов(Ловушка), Новый ТекстОшибки(), Новый ПриведениеФлагов(),
		Новый ТабакеркаНаблюдаемая(Новый РеестрЗаданийЗаглушка()),
		Новый ТабакеркаНаблюдаемая(?(Издатель = Неопределено, Новый ИздательСобытий(), Издатель)));

КонецФункции

// Приборы над фейковым метром и числами образцового реестра — то, с чего начинается
// каждая проверка среза.
Функция ПриборыНадМетром(Знач Метр, Знач Издатель = Неопределено, Знач Ловушка = Неопределено)
	Возврат ПриборыНад(Метр, НовыеЧисла(РеестрОбразца()), Издатель, Ловушка);
КонецФункции

Функция ПриборыНад(Знач Метр, Знач Числа, Знач Издатель = Неопределено,
	Знач Ловушка = Неопределено)

	Возврат НовыеПриборы(Новый ТабакеркаНаблюдаемая(Метр), Числа, Истина, Неопределено,
		Издатель, Ловушка);

КонецФункции

// Настоящий гейт над настоящим правилом, чья таблица не читается: не смог проверить —
// отказал, и число прибора снимается с того же счётчика, который на этом отказе растёт.
Функция НовыйГейт()
	Возврат Новый ГейтВходаПоСтране(ПравилоНадЛежащейТаблицей(), Неопределено, ЛогТестов(),
		Новый ТекстОшибки());
КонецФункции

Функция ПравилоНадЛежащейТаблицей()

	Хранилище = Новый ХранилищеГеоправилСВмешательством();
	Хранилище.Сломаться();

	Возврат Новый ГеоправилоПровайдера(Хранилище, Новый СправочникСтран(),
		Новый СписокЧерезЗапятую(), Неопределено, Неопределено, Неопределено,
		Неопределено, Неопределено, Неопределено);

КонецФункции

// Данные события в том виде, в каком их кладёт продукт: имя пула для разреза и пара
// идентификаторов, до которых приборам дела нет.
Функция ДанныеСкачивания(Знач ИмяПула)
	Возврат Новый Структура("ПакетИдентификатор, ВерсияИдентификатор, ИмяПула", 1, 2, ИмяПула);
КонецФункции

Функция ИмяПрибораПулов()
	Возврат "oshub.pools";
КонецФункции

Функция ИмяПрибораПакетов()
	Возврат "oshub.packages";
КонецФункции

Функция ИмяПрибораЗанятого()
	Возврат "oshub.storage.used_bytes";
КонецФункции

Функция ИмяСчётчикаСкачиваний()
	Возврат "oshub.downloads";
КонецФункции

Функция КлючПула()
	Возврат "oshub.pool";
КонецФункции

Функция ИмяПрибораОтказов()
	Возврат "oshub.login.geo_denied";
КонецФункции

Функция ИмяПрибораЗаданий()
	Возврат "oshub.background_jobs";
КонецФункции

Функция НовыеПриборыНадРеестромЗаданий(Знач Реестр)
	Возврат НовыеПриборыНадТабакеркойЗаданий(Новый ТабакеркаНаблюдаемая(Реестр));
КонецФункции

Функция НовыеПриборыНадТабакеркойЗаданий(Знач ТабакеркаЗаданий)
	Возврат Новый ПриборыХаба(Новый ТабакеркаНаблюдаемая(Неопределено),
		Новый ТабакеркаНаблюдаемая(НовыеЧисла(РеестрОбразца())),
		Новый ТабакеркаНаблюдаемая(НовыйГейт()), Истина, ЛогТестов(),
		Новый ТекстОшибки(), Новый ПриведениеФлагов(), ТабакеркаЗаданий,
		Новый ТабакеркаНаблюдаемая(Новый ИздательСобытий()));
КонецФункции

// Лог с ловушкой, когда тест смотрит написанное, и обычный, когда не смотрит.
Функция ЛогТестов(Знач Ловушка = Неопределено)

	Если Ловушка = Неопределено Тогда
		Возврат Логирование.ПолучитьЛог("тест.oshub.приборы");
	КонецЕсли;

	Лог = Логирование.ПолучитьЛог("тест.oshub.числа." + Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка, УровниЛога.Отладка);

	Возврат Лог;

КонецФункции

#КонецОбласти
