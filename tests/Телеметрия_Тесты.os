// Наблюдаемость на штатной телеметрии winow/OpenTelemetry: выключенная не поднимает SDK
// и не стоит ничего, включённая заводит доменные спаны, сбой SDK операцию не роняет.
// Конвейер, фоновый экспорт и traceparent — дело SDK и веб-каркаса, здесь их нет.

#Использовать asserts
#Использовать autumn-logos
#Использовать opentelemetry
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	КаталогЖурнала = ОбъединитьПути(КаталогМодулей,
		ОбъединитьПути("наблюдаемость", "Классы/журнал"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогЖурнала, "УровниЖурнала.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогЖурнала, "ВыводЛогаВOTel.os"));
	КаталогCommon = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("основа", "Классы"));
	ПоискКлассов.Подключить(КаталогCommon, "ТекстОшибки");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ТабакеркаНаблюдаемая.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "СобытиеЛогаЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ЛовушкаЛога.os"));
	ПоискКлассов.Подключить(КаталогCommon, "ПриведениеФлагов");
	ПоискКлассов.Подключить(КаталогCommon, "ПриведениеЧисел");
	КаталогСобытий = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСобытий, "ИздательСобытий.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкПодписчик.os"));

	// продуктовая точка инструментирования доставки: секреты проверяем на ней, а не
	// на атрибутах, которые тест сам себе и сочинил
	КаталогВебхука = ОбъединитьПути(КаталогМодулей,
		ОбъединитьПути("подписки", "Классы/обработчики/вебхук"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогВебхука, "ДоставкаВебхуком.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкТранспортHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкВалидаторВебхука.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "НастройкиЗаглушка.os"));

КонецПроцедуры

#Область ВыключеннаяТрассировкаНеСтоитНичего

// Главный критерий ИСТ-ЭКСП-008: выключенная трассировка не стоит ничего. «Ничего» —
// это не «дешёвые спаны», а «SDK не поднят»: пока из табакерки не достали, нет ни
// провайдеров, ни фонового экспорта, ни сети.
&Тест
Процедура ВыключеннаяТрассировкаSdkНеПоднимает() Экспорт

	Табакерка = Новый ТабакеркаНаблюдаемая(СдкВПамять().Сдк);
	Телеметрия = НоваяТелеметрия(Табакерка, Ложь);

	Ожидаем.Что(Телеметрия.Включена(), "трассировка выключена").ЭтоЛожь();

	Спан = Телеметрия.НачатьСпан("операция", "server");
	Спан.УстановитьАтрибут("k", "v");
	Спан.Ошибка("что-то");
	Спан.Завершить();
	Телеметрия.ДополнитьТекущийСпан(Новый Соответствие());

	Ожидаем.Что(Спан.Активен(), "спан-пустышка при выключенной трассировке").ЭтоЛожь();
	Ожидаем.Что(Табакерка.ЧислоДоставаний(), "из табакерки не доставали — SDK не поднят").Равно(0);

КонецПроцедуры

// Умолчание живёт в поставочном autumn-properties.json, а не только в аннотации детальки:
// инсталляция, которую никто не настраивал, обязана стартовать без телеметрии.
&Тест
Процедура ПоставочнаяКонфигурацияТрассировкуНеВключает() Экспорт

	Настройки = ПрочитатьНастройкиПоставки();

	Ожидаем.Что(Настройки.Свойство("otel"), "в поставке объявлен раздел otel").ЭтоИстина();
	Ожидаем.Что(Настройки.otel.enabled, "трассировка в поставке выключена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ВключённаяТрассировка

&Тест
Процедура ВключённаяЗаводитСпанСДоменнымиАтрибутами() Экспорт

	Конвейер = СдкВПамять();
	Телеметрия = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Конвейер.Сдк), Истина);

	Ожидаем.Что(Телеметрия.Включена(), "трассировка включена").ЭтоИстина();

	Атрибуты = Новый Соответствие();
	Атрибуты.Вставить("oshub.package", "autumn");
	Спан = Телеметрия.НачатьСпан("mirror.sync", "internal", Атрибуты);
	Ожидаем.Что(Спан.Активен(), "спан реальный").ЭтоИстина();
	Спан.Завершить();

	Тело = ОтправленноеТело(Конвейер);
	Ожидаем.Что(СтрНайти(Тело, "resourceSpans") > 0, "экспортировано OTLP-тело").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "mirror.sync") > 0, "в теле имя спана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "autumn") > 0, "в теле доменный атрибут").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "openhub-test") > 0, "в теле service.name конвейера").ЭтоИстина();

КонецПроцедуры

// Спан домена не сам по себе: он обязан продолжать текущую трассу — тот самый серверный
// спан, который заводит напильник winow. Иначе события публикации и доставки вебхуков
// висели бы отдельными трассами и с запросом не сшивались.
&Тест
Процедура ДоменныйСпанПродолжаетТекущуюТрассу() Экспорт

	Конвейер = СдкВПамять();
	Телеметрия = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Конвейер.Сдк), Истина);

	Внешний = Конвейер.Сдк.ПолучитьТрассировщик("winow").НачатьСпан("GET /api/v1/pools/{Пул}");
	ИдТрассировки = Внешний.КонтекстСпана().ИдТрассировки();
	Область = Внешний.СделатьТекущим();

	Спан = Телеметрия.НачатьСпан("events.publish", "producer");
	Спан.Завершить();

	Область.Закрыть();
	Внешний.Завершить();

	// Сверяется тело именно доменного спана: тело серверного несёт свой traceId всегда,
	// и проверка «последней отправки» прошла бы и на корневом доменном спане.
	Ожидаем.Что(СтрНайти(ТелоСпана(Конвейер, "events.publish"), ИдТрассировки) > 0,
		"доменный спан уехал в той же трассе, что и серверный").ЭтоИстина();

КонецПроцедуры

// Доменный спан обязан стать ТЕКУЩИМ на время операции: у фоновой задачи своего запроса
// нет, и без этого строка её журнала уезжает без trace_id — дрилдаун «трасса ↔ логи»
// собирать не по чему. Проверяется на настоящем мосте журнала: строка, написанная внутри
// спана, обязана уехать с его идентификатором трассы.
&Тест
Процедура СтрокаЖурналаВнутриДоменногоСпанаНесётЕгоТрассу() Экспорт

	Конвейер = СдкВПамять();
	Телеметрия = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Конвейер.Сдк), Истина);
	Лог = ЛогЧерезМост(НовыйМостЖурнала(
		Новый ТабакеркаНаблюдаемая(МостБиблиотеки(Конвейер)), Истина));

	Спан = Телеметрия.НачатьСпан("job.proxy_gc", "internal");
	Лог.Информация("GC прокси-кэша: пул ""public"" осмотрен");
	Спан.Завершить();

	ИдТрассировки = ИдТрассыСпана(Конвейер, "job.proxy_gc");
	Ожидаем.Что(СтрНайти(ТелоЛога(Конвейер, "GC прокси-кэша"), ИдТрассировки) > 0,
		"строка журнала фоновой задачи уехала с трассой её спана").ЭтоИстина();

КонецПроцедуры

// Завершённый спан текущим быть перестаёт: иначе следующая операция — и её журнал —
// молча приписывались бы к чужой, давно закрытой трассе.
&Тест
Процедура ЗавершённыйСпанПерестаётБытьТекущим() Экспорт

	Конвейер = СдкВПамять();
	Телеметрия = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Конвейер.Сдк), Истина);
	Лог = ЛогЧерезМост(НовыйМостЖурнала(
		Новый ТабакеркаНаблюдаемая(МостБиблиотеки(Конвейер)), Истина));

	Телеметрия.НачатьСпан("mirror.sync", "internal").Завершить();
	Лог.Информация("после задачи: строка вне всякой трассы");

	ИдТрассировки = ИдТрассыСпана(Конвейер, "mirror.sync");
	Ожидаем.Что(СтрНайти(ТелоЛога(Конвейер, "после задачи"), ИдТрассировки),
		"строка после завершения спана не приписана к его трассе").Равно(0);

КонецПроцедуры

// Доменные приметы горячей выдачи вешаются на серверный спан winow — своего спана
// у выдачи больше нет.
&Тест
Процедура ДополнениеЛожитсяНаТекущийСпан() Экспорт

	Конвейер = СдкВПамять();
	Телеметрия = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Конвейер.Сдк), Истина);

	Серверный = Конвейер.Сдк.ПолучитьТрассировщик("winow").НачатьСпан("GET /download/{ИмяПакета}");
	Область = Серверный.СделатьТекущим();

	Атрибуты = Новый Соответствие();
	Атрибуты.Вставить("oshub.pool", "public");
	Атрибуты.Вставить("oshub.found", Истина);
	Телеметрия.ДополнитьТекущийСпан(Атрибуты);

	Область.Закрыть();
	Серверный.Завершить();

	Тело = ОтправленноеТело(Конвейер);
	Ожидаем.Что(СтрНайти(Тело, "oshub.pool") > 0, "имя пула на серверном спане").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "oshub.found") > 0, "признак находки на серверном спане").ЭтоИстина();

КонецПроцедуры

// Вне запроса текущего спана нет — дополнять нечего, и это не повод падать:
// та же выдача зовётся из admin-cli, где веб-сервера не поднимали вовсе.
&Тест
Процедура ДополнениеВнеЗапросаНеПадает() Экспорт

	Телеметрия = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(СдкВПамять().Сдк), Истина);

	Атрибуты = Новый Соответствие();
	Атрибуты.Вставить("oshub.pool", "public");

	Попытка
		Телеметрия.ДополнитьТекущийСпан(Атрибуты);
	Исключение
		Ожидаем.Что(Ложь, "дополнение вне запроса не должно выбрасывать").ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

// Б-блокер регрессии: доля выборки без имени сэмплера мертва. SDK при пустом
// otel.traces.sampler ставит ParentBased(AlwaysOn) и аргумент ИГНОРИРУЕТ — карточка
// «доля отбираемых трасс» показывала бы 0.1, а уезжали бы все трассы.
&Тест
Процедура ДоляВыборкиНеЖивётБезИмениСэмплера() Экспорт

	Объявленные = ОбъявленныеКлючиНастроек();
	Ожидаем.Что(Объявленные.Найти("otel.traces.sampler.arg") <> Неопределено,
		"доля выборки объявлена настройкой").ЭтоИстина();
	Ожидаем.Что(Объявленные.Найти("otel.traces.sampler") <> Неопределено,
		"вместе с долей объявлено и правило отбора — иначе доля не работает").ЭтоИстина();

	// Само умолчание сэмплера здесь не проверяется, и это осознанно: оно инъектируется
	// деталькой в main.os, а не лежит в файле, — иначе смонтированный поверх файл оператора
	// тихо уносил бы долю выборки. Что инъекция на месте, стережёт живой набор
	// (ТелеметрияЖивая_Тесты.ДоляНольОтсекаетТрассыБезИмениСэмплераВОкружении).

КонецПроцедуры

// С-1: включённость читают двое — фасад хаба и напильник winow. Из окружения деталька
// приходит строкой, и оба обязаны прочесть её ОДИНАКОВО: по правилу OpenTelemetry истина
// только на слове "true". Разойдись они — каркас слал бы спаны, а домен считал бы себя
// выключенным (или наоборот), и телеметрия выходила бы наполовину.
&Тест
Процедура СтроковаяВключённостьЧитаетсяКакУКаркаса() Экспорт

	Ожидаем.Что(НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(), "true").Включена(),
		"строковое ""true"" из окружения включает трассировку").ЭтоИстина();
	Ожидаем.Что(НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(), "TRUE").Включена(),
		"регистр слова не важен — так же читает каркас").ЭтоИстина();
	Ожидаем.Что(НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(), "false").Включена(),
		"строковое ""false"" оставляет выключенной").ЭтоЛожь();
	Ожидаем.Что(НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(), Истина).Включена(),
		"настоящее Булево работает по-прежнему").ЭтоИстина();

	// Слова, которые каркас истиной НЕ считает. Пока фасад читал их терпимо, OTEL_ENABLED=1
	// давал полтелеметрии: доменные спаны заводились, а серверных не было вовсе.
	Для Каждого Слово Из СтрРазделить("1,да,yes,истина,on", ",") Цикл
		Ожидаем.Что(НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(), Слово).Включена(),
			СтрШаблон("каркас не считает ""%1"" истиной — и фасад не должен", Слово)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЖурналУезжаетВOTel

// Мост журнала — вторая дверь к SDK, и она обязана быть закрыта тем же флагом.
// Библиотечный ОтелАппендерLogos поднимает SDK на своём создании: подключи его напрямую —
// и выключенная телеметрия начала бы стоить фоновый экспорт.
&Тест
Процедура ВыключенныйМостЖурналаSdkНеПоднимает() Экспорт

	Табакерка = Новый ТабакеркаНаблюдаемая(Новый ЛовушкаЛога());
	Мост = НовыйМостЖурнала(Табакерка, Ложь);

	Мост.ВывестиСобытие(Новый СобытиеЛогаЗаглушка("строка журнала"));

	Ожидаем.Что(Мост.Включён(), "мост журнала выключен").ЭтоЛожь();
	Ожидаем.Что(Табакерка.ЧислоДоставаний(), "из табакерки не доставали — SDK не поднят").Равно(0);
	Ожидаем.Что(Мост.ЧислоОтданных(), "в OTel ничего не ушло").Равно(0);

КонецПроцедуры

// Включённый мост отдаёт строку журнала OTLP-логом. Гоняется настоящая цепочка
// logos → ОтелАппендерLogos → SDK → экспорт: тело смотрим на выходе транспорта.
&Тест
Процедура ВключённыйМостОтдаётСтрокуЖурналаOTLP() Экспорт

	Конвейер = СдкВПамять();
	Мост = НовыйМостЖурнала(Новый ТабакеркаНаблюдаемая(МостБиблиотеки(Конвейер)), Истина);

	Лог = ЛогЧерезМост(Мост);
	Лог.Информация("зеркало ""public"" синхронизировано");

	Ожидаем.Что(Мост.ЧислоОтданных(), "событие ушло мосту").Равно(1);

	Тело = ТелоЛога(Конвейер, "зеркало");
	Ожидаем.Что(СтрНайти(Тело, "resourceLogs") > 0, "экспортировано OTLP-тело логов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "openhub-test") > 0, "в теле service.name конвейера").ЭтоИстина();

КонецПроцедуры

// Ради этого мост и заводился: строка журнала, написанная внутри запроса, обязана нести
// идентификатор его трассы. Без него дрилдаун «трасса ↔ логи» в Grafana не собирается.
&Тест
Процедура СтрокаЖурналаНесётИдентификаторТрассы() Экспорт

	Конвейер = СдкВПамять();
	Мост = НовыйМостЖурнала(Новый ТабакеркаНаблюдаемая(МостБиблиотеки(Конвейер)), Истина);
	Лог = ЛогЧерезМост(Мост);

	Серверный = Конвейер.Сдк.ПолучитьТрассировщик("winow").НачатьСпан("GET /health");
	ИдТрассировки = Серверный.КонтекстСпана().ИдТрассировки();
	Область = Серверный.СделатьТекущим();
	Лог.Информация("пакет ""autumn"" отдан из кэша");
	Область.Закрыть();
	Серверный.Завершить();

	Ожидаем.Что(СтрНайти(ТелоЛога(Конвейер, "отдан из кэша"), ИдТрассировки) > 0,
		"строка журнала уехала с идентификатором трассы запроса").ЭтоИстина();

КонецПроцедуры

// Вне запроса спана нет, и это не повод молчать: стартовые строки и работа фоновых
// задач обязаны доезжать до коллектора так же, как строки запроса.
&Тест
Процедура СтрокаЖурналаВнеЗапросаВсёРавноУезжает() Экспорт

	Конвейер = СдкВПамять();
	Мост = НовыйМостЖурнала(Новый ТабакеркаНаблюдаемая(МостБиблиотеки(Конвейер)), Истина);

	ЛогЧерезМост(Мост).Информация("стартовые задачи завершены");

	Ожидаем.Что(СтрНайти(ТелоЛога(Конвейер, "стартовые задачи"), "resourceLogs") > 0,
		"строка вне запроса уехала OTLP-логом").ЭтоИстина();

КонецПроцедуры

// Отказ моста не отменяет работу хаба и не повторяется на каждой строке: за SDK,
// который не поднялся, больше не ходят.
&Тест
Процедура СбойМостаЖурналаНеРоняетИНеПовторяется() Экспорт

	Табакерка = Новый ТабакеркаНаблюдаемая(Неопределено, Истина);
	Мост = НовыйМостЖурнала(Табакерка, Истина);

	Попытка
		Мост.ВывестиСобытие(Новый СобытиеЛогаЗаглушка("первая строка"));
		Мост.ВывестиСобытие(Новый СобытиеЛогаЗаглушка("вторая строка"));
	Исключение
		Ожидаем.Что(Ложь, "сбой моста не должен выбрасывать в цепочку logos").ЭтоИстина();
	КонецПопытки;

	Ожидаем.Что(Мост.Включён(), "после сбоя мост выключен").ЭтоЛожь();
	Ожидаем.Что(Табакерка.ЧислоДоставаний(), "за сорванным SDK больше не ходим").Равно(1);

КонецПроцедуры

// Мост читает флаг ровно как фасад и каркас: истина только на слове "true". Читай он
// терпимо — OTEL_ENABLED=1 поднимал бы SDK там, где каркас считает телеметрию выключенной.
&Тест
Процедура МостЖурналаЧитаетФлагКакКаркас() Экспорт

	Ожидаем.Что(НовыйМостЖурнала(Новый ТабакеркаНаблюдаемая(), "true").Включён(),
		"строковое ""true"" включает мост").ЭтоИстина();

	Для Каждого Слово Из СтрРазделить("1,да,yes,истина,on,false", ",") Цикл
		Табакерка = Новый ТабакеркаНаблюдаемая(Новый ЛовушкаЛога());
		Мост = НовыйМостЖурнала(Табакерка, Слово);
		Мост.ВывестиСобытие(Новый СобытиеЛогаЗаглушка("строка журнала"));

		Ожидаем.Что(Мост.Включён(),
			СтрШаблон("каркас не считает ""%1"" истиной — и мост не должен", Слово)).ЭтоЛожь();
		Ожидаем.Что(Табакерка.ЧислоДоставаний(),
			СтрШаблон("на слове ""%1"" за SDK не ходили", Слово)).Равно(0);
	КонецЦикла;

КонецПроцедуры

// Уровень отсекает мост, а не logos: способ вывода привязан самым подробным уровнем,
// иначе точечный DEBUG компонента не дошёл бы ни до консоли, ни до коллектора. Строка
// ниже уровня СВОЕГО лога в OTel уезжать не должна.
&Тест
Процедура МостОтдаётТолькоПропущенноеЕгоЛогом() Экспорт

	Конвейер = СдкВПамять();
	Мост = НовыйМостЖурнала(Новый ТабакеркаНаблюдаемая(МостБиблиотеки(Конвейер)), Истина);

	Спокойный = ЛогЧерезМост(Мост, УровниЛога.Информация);
	Спокойный.Отладка("подробность спокойного лога");
	Спокойный.Информация("сообщение спокойного лога");

	Подробный = ЛогЧерезМост(Мост, УровниЛога.Отладка);
	Подробный.Отладка("подробность включённого компонента");

	Ожидаем.Что(Мост.ЧислоОтданных(), "уехали две строки из трёх").Равно(2);
	Ожидаем.Что(СтрНайти(ТелоЛога(Конвейер, "включённого компонента"), "resourceLogs") > 0,
		"подробность компонента с поднятым уровнем уехала").ЭтоИстина();

КонецПроцедуры

// Способ вывода, созданный самой logos (по имени типа, до контейнера), молчит: без
// табакерки он не знает ни о каком SDK и поднять его не может.
&Тест
Процедура МостБезКонтейнераМолчит() Экспорт

	Мост = Новый ВыводЛогаВOTel();

	Мост.ВывестиСобытие(Новый СобытиеЛогаЗаглушка("строка журнала"));

	Ожидаем.Что(Мост.Включён(), "экземпляр без ОСени выключен").ЭтоЛожь();
	Ожидаем.Что(Мост.ЧислоОтданных(), "в OTel ничего не ушло").Равно(0);

КонецПроцедуры

// Включённая телеметрия шлёт три сигнала, и у каждого своя ручка выключения. Оператору
// нечем управлять тем, чего он не видит: без карточки экспортёра единственным способом
// «выключить только логи» осталось бы выключить телеметрию целиком.
&Тест
Процедура КаждыйСигналВыключаетсяСвоейКарточкой() Экспорт

	Объявленные = ОбъявленныеКлючиНастроек();

	Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
		Ключ = "otel." + Сигнал + ".exporter";
		Ожидаем.Что(Объявленные.Найти(Ключ) <> Неопределено,
			СтрШаблон("экспортёр сигнала объявлен настройкой: %1", Ключ)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Объявленные.Найти("otel.metric.export.interval") <> Неопределено,
		"интервал среза метрик объявлен: партиями метрики не уезжают").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СекретыИПерсональныеДанные

// НФТ-ЭКСП-008: в атрибутах трасс секретов нет. Гоняется НАСТОЯЩАЯ доставка вебхука —
// та самая точка, где рядом со спаном лежат секрет подписки, её подпись и адрес цели.
// Свои атрибуты тест не сочиняет: сочинённые доказывали бы аккуратность теста, а не хаба.
&Тест
Процедура АтрибутыДоставкиНеНесутСекретов() Экспорт

	Конвейер = СдкВПамять();
	Телеметрия = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Конвейер.Сдк), Истина);

	Секрет = "SEKRET-подписки-XYZ";
	ЦельСПаролем = "https://приёмник.example/hook?token=SEKRET-в-адресе";
	Доставка = НоваяДоставкаВебхуком(Телеметрия);

	Ожидаем.Что(Доставка.Доставить(ЗаданиеДоставки(ЦельСПаролем, Секрет)),
		"доставка состоялась (200 от фейка)").ЭтоИстина();

	Тело = ТелоСпана(Конвейер, "webhook.deliver");
	Ожидаем.Что(СтрНайти(Тело, "версия.опубликована") > 0,
		"тип события — безопасный атрибут — в теле есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, Секрет), "секрет подписки в теле трассы").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "SEKRET-в-адресе"), "секрет из адреса цели в теле трассы").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "sha256="), "подпись доставки в теле трассы").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Тело), "authorization"), "заголовок авторизации в теле трассы").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "приёмник.example"), "адрес цели в теле трассы").Равно(0);

КонецПроцедуры

// Секрет коллектора берётся только из окружения (OTEL_EXPORTER_OTLP_HEADERS). Файл
// поставки и реестр настроек про него не знают: настройка, попавшая в реестр, показывается
// в интерфейсе и уезжает в бэкап конфигурации.
&Тест
Процедура СекретКоллектораВФайлНастроекНеПопадает() Экспорт

	// Сверяется ровно заголовочный ключ: endpoint, протокол и таймаут в поставке законны
	// и секретом не являются — запрет на весь exporter краснел бы на честной настройке.
	Ожидаем.Что(СтрНайти(НРег(ТекстомJSON(ПрочитатьНастройкиПоставки())), "headers"),
		"ключ заголовков коллектора в поставочном autumn-properties.json").Равно(0);

	Объявленные = ОбъявленныеКлючиНастроек();
	Для Каждого Ключ Из Объявленные Цикл
		Ожидаем.Что(СтрНайти(Ключ, "headers") = 0,
			"ключ заголовков коллектора не объявлен настройкой: " + Ключ).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Объявленные.Количество() > 0, "ключи otel в реестре настроек нашлись").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СбойТелеметрииНеОтменяетОперацию

// НФТ-ЭКСП-009: отказ телеметрии — не отказ операции. SDK, который не поднимается,
// обязан оборачиваться пустышкой, а не исключением наружу.
&Тест
Процедура СбойПодъёмаSdkНеРоняетОперацию() Экспорт

	Табакерка = Новый ТабакеркаНаблюдаемая(Неопределено, Истина);
	Телеметрия = НоваяТелеметрия(Табакерка, Истина);

	Спан = Неопределено;
	Попытка
		Спан = Телеметрия.НачатьСпан("mirror.sync", "internal");
	Исключение
		Ожидаем.Что(Ложь, "сбой SDK не должен выбрасывать наружу").ЭтоИстина();
	КонецПопытки;

	Ожидаем.Что(Спан.Активен(), "после сбоя выдана пустышка").ЭтоЛожь();
	Ожидаем.Что(Телеметрия.Включена(), "после сбоя трассировка выключена").ЭтоЛожь();

	Телеметрия.НачатьСпан("events.publish", "producer");
	Ожидаем.Что(Табакерка.ЧислоДоставаний(),
		"причина названа один раз: за SDK больше не ходим").Равно(1);

КонецПроцедуры

// Публикация доменного события идёт своим чередом и когда телеметрии нет вовсе,
// и когда она сорвалась: подписчики обязаны получить событие.
&Тест
Процедура ПубликацияСобытияПереживаетЛюбуюТелеметрию() Экспорт

	БезТелеметрии = Новый ИздательСобытий(Неопределено);
	Ожидаем.Что(ДоставленоПодписчику(БезТелеметрии), "без телеметрии событие доставлено").Равно(1);

	Сорванная = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Неопределено, Истина), Истина);
	Ожидаем.Что(ДоставленоПодписчику(Новый ИздательСобытий(Сорванная)),
		"при сорванной телеметрии событие доставлено").Равно(1);

	// И обратная сторона: с живой телеметрией публикация обязана оставлять след.
	// Без этого утверждения снятый из ИздателяСобытий спан не покраснил бы ничего.
	Конвейер = СдкВПамять();
	Живая = НоваяТелеметрия(Новый ТабакеркаНаблюдаемая(Конвейер.Сдк), Истина);
	Издатель = Новый ИздательСобытий(Живая);
	Ожидаем.Что(ДоставленоПодписчику(Издатель), "с живой телеметрией событие доставлено").Равно(1);

	Тело = ТелоСпана(Конвейер, "events.publish");
	Ожидаем.Что(СтрНайти(Тело, Издатель.ТипВерсияОпубликована()) > 0,
		"тип события — атрибутом спана публикации").ЭтоИстина();

КонецПроцедуры

// Спан-пустышка обязана переживать любой вызов: ею работают все пять точек
// инструментирования, когда трассировка выключена.
&Тест
Процедура ПустышкаБезопаснаККаждомуВызову() Экспорт

	Спан = Новый СпанХаба();

	Ожидаем.Что(Спан.Активен(), "пустышка не активна").ЭтоЛожь();
	Попытка
		Спан.УстановитьАтрибут("k", "v");
		Спан.Ошибка("ошибка");
		Спан.Завершить();
		Спан.Завершить(); // повторно — безопасно
	Исключение
		Ожидаем.Что(Ложь, "пустышка не должна выбрасывать исключения").ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция НоваяТелеметрия(Знач Табакерка, Знач Включено)
	Возврат Новый Телеметрия(Табакерка, Включено, ЛогТестов(), Новый ТекстОшибки(),
		Новый ПриведениеФлагов());
КонецФункции

// Настоящий обработчик доставки вебхука на фейковом транспорте: спан заводит он сам.
Функция НоваяДоставкаВебхуком(Знач Телеметрия)

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200);

	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();

	Возврат Новый ДоставкаВебхуком(Транспорт, Новый ФейкВалидаторВебхука(), Настройки,
		Телеметрия, ЛогТестов(), Новый ПриведениеЧисел(), Новый ТекстОшибки());

КонецФункции

Функция ЗаданиеДоставки(Знач URL, Знач Секрет)

	Задание = Новый Структура();
	Задание.Вставить("ИдДоставки", "d-1");
	Задание.Вставить("Действие", Новый Структура("URL, Секрет", URL, Секрет));
	Задание.Вставить("ТипСобытия", "версия.опубликована");
	Задание.Вставить("Тело", "{""пакет"":""autumn""}");
	Задание.Вставить("НомерПопытки", 1);

	Возврат Задание;

КонецФункции

// SDK с транспортом в память и простыми процессорами: спан и запись лога уезжают
// сразу — без фонового цикла и без ожидания.
Функция СдкВПамять()

	Транспорт = Новый ОтелВПамятьТранспорт();
	Ресурс = Новый ОтелПостроительРесурса().Установить("service.name", "openhub-test").Построить();
	Трассы = Новый ОтелПостроительПровайдераТрассировки()
		.УстановитьРесурс(Ресурс)
		.ДобавитьПроцессор(Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(Транспорт)))
		.УстановитьСэмплер(ОтелСэмплер.ВсегдаВключен())
		.Построить();
	Логи = Новый ОтелПостроительПровайдераЛогирования()
		.УстановитьРесурс(Ресурс)
		.ДобавитьПроцессор(Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(Транспорт)))
		.Построить();
	Сдк = Новый ОтелПостроительSdk()
		.УстановитьПровайдерТрассировки(Трассы)
		.УстановитьПровайдерЛогирования(Логи)
		.Построить();

	Возврат Новый Структура("Сдк, Транспорт", Сдк, Транспорт);

КонецФункции

Функция НовыйМостЖурнала(Знач Табакерка, Знач Включено)
	Возврат Новый ВыводЛогаВOTel(Табакерка, Включено, Новый ПриведениеФлагов());
КонецФункции

// Настоящий мост библиотеки на конвейере в память: хабовый способ вывода только
// закрывает его флагом, а запись лога формирует именно он.
Функция МостБиблиотеки(Знач Конвейер)
	Возврат Новый ОтелАппендерLogos(Конвейер.Сдк.ПолучитьЛоггер("logos-bridge"));
КонецФункции

// Настоящий лог logos, у которого единственный способ вывода — проверяемый мост.
// Имя уникально на вызов: логи logos живут в процессе и накапливали бы способы вывода.
//
// Способ вывода привязывается самым подробным уровнем — ровно как в main.os: отсекать
// по уровню лога обязан сам мост, иначе точечная подробность компонента не работает.
Функция ЛогЧерезМост(Знач Мост, Знач УровеньЛога = Неопределено)

	Лог = Логирование.ПолучитьЛог("тест.oshub.мост." + Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(?(УровеньЛога = Неопределено, УровниЛога.Информация, УровеньЛога));
	Лог.ДобавитьСпособВывода(Мост, УровниЛога.Отладка);

	Возврат Лог;

КонецФункции

// Тело той отправки логов, в которой уехала названная строка журнала.
Функция ТелоЛога(Знач Конвейер, Знач ЧастьСтроки)

	Для Каждого Отправка Из Конвейер.Транспорт.ПолучитьОтправленные() Цикл
		Если СтрНайти(Строка(Отправка["Путь"]), "logs") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Тело = ТеломJSON(Отправка["Данные"]);
		Если СтрНайти(Тело, ЧастьСтроки) > 0 Тогда
			Возврат Тело;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Ложь, "строка журнала """ + ЧастьСтроки + """ не экспортирована вовсе").ЭтоИстина();
	Возврат "";

КонецФункции

Функция ОтправленноеТело(Знач Конвейер)

	Отправки = Конвейер.Транспорт.ПолучитьОтправленные();
	Ожидаем.Что(Отправки.Количество() > 0, "экспорт спана состоялся").ЭтоИстина();

	Возврат ТеломJSON(Отправки[Отправки.ВГраница()]["Данные"]);

КонецФункции

// Тело той отправки, в которой уехал названный спан. Простой процессор шлёт каждый спан
// отдельной отправкой, поэтому спан и его трасса сверяются по своему телу, а не по общему.
Функция ТелоСпана(Знач Конвейер, Знач ИмяСпана)

	Для Каждого Отправка Из Конвейер.Транспорт.ПолучитьОтправленные() Цикл
		Тело = ТеломJSON(Отправка["Данные"]);
		Если СтрНайти(Тело, ИмяСпана) > 0 Тогда
			Возврат Тело;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Ложь, "спан """ + ИмяСпана + """ не экспортирован вовсе").ЭтоИстина();
	Возврат "";

КонецФункции

// Идентификатор трассы названного спана — из тела, которым он уехал.
Функция ИдТрассыСпана(Знач Конвейер, Знач ИмяСпана)

	Тело = ТелоСпана(Конвейер, ИмяСпана);
	Ключ = """traceId"":""";
	Позиция = СтрНайти(Тело, Ключ);
	Ожидаем.Что(Позиция > 0, "в теле спана есть traceId").ЭтоИстина();

	Хвост = Сред(Тело, Позиция + СтрДлина(Ключ));

	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция ТеломJSON(Знач Данные)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

Функция ТекстомJSON(Знач Данные)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

Функция ПрочитатьНастройкиПоставки()

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(ОбъединитьПути(КаталогПроекта, "autumn-properties.json"));
	Настройки = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Настройки;

КонецФункции

// Ключи otel, объявленные реестром настроек: их видно в интерфейсе, и секрету там не место.
Функция ОбъявленныеКлючиНастроек()

	Результат = Новый Массив();
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	КаталогНастроек = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	Для Каждого Имя Из СтрРазделить("РеестрНастроек.os,НастройкиПодсистем.os", ",") Цикл
		Чтение = Новый ЧтениеТекста(ОбъединитьПути(КаталогНастроек, Имя), "utf-8");
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Для Каждого Ключ Из КлючиОбъявлений(Текст) Цикл
			Если СтрНачинаетсяС(Ключ, "otel.") Тогда
				Результат.Добавить(Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Первый строковый литерал каждого вызова Объявить(...) — сам ключ настройки.
Функция КлючиОбъявлений(Знач Текст)

	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Обрезанная = СокрЛП(Строка_);
		Если НЕ СтрНачинаетсяС(Обрезанная, "Объявить(""") Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Обрезанная, СтрДлина("Объявить(""") + 1);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДоставленоПодписчику(Знач Издатель)

	Подписчик = Новый ФейкПодписчик();
	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), Подписчик);
	Издатель.Опубликовать(Издатель.ТипВерсияОпубликована());

	Возврат Подписчик.Количество();

КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.otel");
КонецФункции

#КонецОбласти
