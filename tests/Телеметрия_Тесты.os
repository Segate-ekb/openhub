// Юнит-тесты наблюдаемости OpenTelemetry на фейковом HTTP: фасад Телеметрия, ТранспортOTLPХаба,
// БуферСпанов, СпанХаба — выключенный OTel не шлёт ничего, сбой экспорта изолирован.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогObs;
Перем КаталогФикстур;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПробХаба = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");

	ПодключитьКласс(ОбъединитьПути(КаталогObs, "СпанХаба.os"), "СпанХаба");
	ПодключитьКласс(ОбъединитьПути(КаталогObs, "БуферСпанов.os"), "БуферСпанов");
	ПодключитьКласс(ОбъединитьПути(КаталогObs, "ПроцессорСпановХаба.os"), "ПроцессорСпановХаба");
	ПодключитьКласс(ОбъединитьПути(КаталогObs, "ТранспортOTLPХаба.os"), "ТранспортOTLPХаба");
	ПодключитьКласс(ОбъединитьПути(КаталогObs, "Телеметрия.os"), "Телеметрия");
	КаталогCommon = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("основа", "Классы"));
	ПоискКлассов.Подключить(КаталогCommon, "ПриведениеЧисел");
	ПоискКлассов.Подключить(КаталогCommon, "ПриведениеФлагов");
	ПоискКлассов.Подключить(КаталогCommon, "ТекстОшибки");
	ПодключитьКласс(ОбъединитьПути(КаталогФикстур, "ФейкТранспортHTTP.os"), "ФейкТранспортHTTP");
	КаталогСобытий = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы"));
	ПодключитьКласс(ОбъединитьПути(КаталогСобытий, "ИздательСобытий.os"), "ИздательСобытий");
	ПодключитьКласс(ОбъединитьПути(КаталогФикстур, "ФейкПодписчик.os"), "ФейкПодписчик");

КонецПроцедуры

#Область ВыключенныйOTel

&Тест
Процедура ВыключенныйOTelНичегоНеШлёт() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Ложь);

	Ожидаем.Что(Телеметрия.Включена(), "OTel выключен").ЭтоЛожь();

	Спан = Телеметрия.НачатьСпан("операция", "server");
	Ожидаем.Что(Спан.Активен(), "спан-ноп при выключенном OTel").ЭтоЛожь();
	Спан.УстановитьАтрибут("k", "v");
	Спан.Завершить();

	Ожидаем.Что(Телеметрия.РазмерБуфера(), "буфер пуст").Равно(0);
	Ожидаем.Что(Телеметрия.ЭкспортироватьПартию(), "экспортировать нечего").Равно(0);
	Ожидаем.Что(Фейк.КоличествоВызовов(), "ни одного HTTP-вызова при выключенном OTel").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ВключенныйOTel

&Тест
Процедура ВключённыйСоздаётСпанИБуферизуетНаЗавершении() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	Ожидаем.Что(Телеметрия.Включена(), "OTel включён").ЭтоИстина();

	Спан = Телеметрия.НачатьСпан("операция", "server");
	Ожидаем.Что(Спан.Активен(), "реальный спан при включённом OTel").ЭтоИстина();
	Ожидаем.Что(Телеметрия.РазмерБуфера(), "до завершения буфер пуст").Равно(0);

	Спан.Завершить();
	Ожидаем.Что(Телеметрия.РазмерБуфера(), "завершённый спан в буфере").Равно(1);

КонецПроцедуры

&Тест
Процедура ЭкспортИдётЧерез1connectorСOTLPТелом() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	Спан = Телеметрия.НачатьСпан("выдача-ospx", "server");
	Спан.УстановитьАтрибут("oshub.package", "autumn");
	Спан.УстановитьАтрибут("http.response.status_code", 200);
	Спан.Завершить();

	Обработано = Телеметрия.ЭкспортироватьПартию();

	Ожидаем.Что(Обработано, "экспортирован один спан").Равно(1);
	Ожидаем.Что(Фейк.КоличествоВызовов() >= 1, "был HTTP-вызов экспорта").ЭтоИстина();
	Ожидаем.Что(Фейк.URLПоследний(), "URL = endpoint + /v1/traces").Равно("http://collector:4318/v1/traces");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("Content-Type"), "OTLP/JSON").Равно("application/json");

	Тело = Фейк.ТелоПоследнее();
	Ожидаем.Что(СтрНайти(Тело, "resourceSpans") > 0, "OTLP-тело содержит resourceSpans").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "выдача-ospx") > 0, "тело содержит имя спана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "openhub-test") > 0, "тело содержит service.name из конфигурации").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "autumn") > 0, "тело содержит установленный атрибут пакета").ЭтоИстина();

	Ожидаем.Что(Телеметрия.РазмерБуфера(), "после экспорта буфер пуст").Равно(0);

КонецПроцедуры

&Тест
Процедура АтрибутыНеСодержатСекретов() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	Спан = Телеметрия.НачатьСпан("webhook.deliver", "client");
	Спан.УстановитьАтрибут("oshub.event.type", "версия.опубликована");
	Спан.УстановитьАтрибут("http.response.status_code", 200);
	Спан.Завершить();
	Телеметрия.ЭкспортироватьПартию();

	Тело = Фейк.ТелоПоследнее();
	Ожидаем.Что(СтрНайти(Тело, "версия.опубликована") > 0, "безопасный атрибут в теле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Тело), "секрет") = 0, "секретов в теле нет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Тело), "authorization") = 0, "заголовков авторизации в теле нет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбойЭкспортаИзолированБуферВыведен() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.ЭмулироватьОффлайн();
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	Спан = Телеметрия.НачатьСпан("операция", "internal");
	Спан.Завершить();
	Ожидаем.Что(Телеметрия.РазмерБуфера(), "спан в буфере").Равно(1);

	Обработано = 0;
	Попытка
		Обработано = Телеметрия.ЭкспортироватьПартию();
	Исключение
		Ожидаем.Что(Ложь, "экспорт не должен выбрасывать исключение при сбое коллектора").ЭтоИстина();
	КонецПопытки;

	Ожидаем.Что(Обработано, "партия обработана несмотря на сбой").Равно(1);
	Ожидаем.Что(Телеметрия.РазмерБуфера(), "буфер выведен (нет неограниченного роста)").Равно(0);

КонецПроцедуры

&Тест
Процедура СерверныйСпанПродолжаетTraceparent() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	ИдТрассировки = "0af7651916cd43dd8448eb211c80319c";
	Traceparent = "00-" + ИдТрассировки + "-b7ad6b7169203331-01";
	Спан = Телеметрия.НачатьСпанСервера("api.serve_ospx", Traceparent, Неопределено, Ложь);
	Спан.Завершить();
	Телеметрия.ЭкспортироватьПартию();

	Тело = Фейк.ТелоПоследнее();
	Ожидаем.Что(СтрНайти(Тело, ИдТрассировки) > 0, "спан унаследовал traceId из traceparent").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НевалидныйTraceparentДаётКорневойСпан() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	Спан = Телеметрия.НачатьСпанСервера("api.serve_ospx", "не-traceparent", Неопределено, Ложь);
	Ожидаем.Что(Спан.Активен(), "серверный спан создан даже при мусорном traceparent").ЭтоИстина();
	Спан.Завершить();
	Ожидаем.Что(Телеметрия.РазмерБуфера(), "спан в буфере").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ТранспортOTLP

&Тест
Процедура ТранспортШлётJSONЧерезКлиентHTTP() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("X-Scope-OrgID", "42");
	Транспорт = Новый ТранспортOTLPХаба(Фейк, "http://collector:4318", Заголовки, 10, Истина, ЛогТестов(), Новый ТекстОшибки());

	Данные = Новый Соответствие();
	Данные.Вставить("resourceSpans", Новый Массив());

	Успех = Транспорт.Отправить("/v1/traces", Данные);

	Ожидаем.Что(Успех, "успех при 200").ЭтоИстина();
	Ожидаем.Что(Фейк.URLПоследний(), "склейка endpoint + путь").Равно("http://collector:4318/v1/traces");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("Content-Type"), "JSON").Равно("application/json");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("X-Scope-OrgID"), "доп. заголовок из конфигурации проброшен").Равно("42");
	Ожидаем.Что(СтрНайти(Фейк.ТелоПоследнее(), "resourceSpans") > 0, "тело — OTLP JSON").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТранспортFailSafeНа5xxИСбое() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(503);
	Транспорт = Новый ТранспортOTLPХаба(Фейк, "http://collector:4318", Неопределено, 10, Истина, ЛогТестов(), Новый ТекстОшибки());
	Ожидаем.Что(Транспорт.Отправить("/v1/traces", Новый Соответствие()), "не-2xx -> Ложь").ЭтоЛожь();

	Фейк2 = Новый ФейкТранспортHTTP();
	Фейк2.ЭмулироватьОффлайн();
	Транспорт2 = Новый ТранспортOTLPХаба(Фейк2, "http://collector:4318", Неопределено, 10, Истина, ЛогТестов(), Новый ТекстОшибки());
	Результат = Истина;
	Попытка
		Результат = Транспорт2.Отправить("/v1/traces", Новый Соответствие());
	Исключение
		Ожидаем.Что(Ложь, "транспорт не должен выбрасывать при сбое сети").ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Результат, "сбой сети -> Ложь").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область БуферИСпан

&Тест
Процедура БуферОграниченДропаетСтарейшее() Экспорт

	Буфер = Новый БуферСпанов(3, ЛогТестов()); // лимит 3
	Буфер.Добавить("s1");
	Буфер.Добавить("s2");
	Буфер.Добавить("s3");
	Буфер.Добавить("s4"); // вытесняет s1
	Буфер.Добавить("s5"); // вытесняет s2

	Ожидаем.Что(Буфер.Размер(), "размер ограничен лимитом").Равно(3);
	Партия = Буфер.ЗабратьВсе();
	Ожидаем.Что(Партия.Количество(), "забрали всю партию").Равно(3);
	Ожидаем.Что(Партия[0], "старейшие вытеснены — осталось s3").Равно("s3");
	Ожидаем.Что(Партия[2], "новейший s5").Равно("s5");
	Ожидаем.Что(Буфер.Размер(), "после ЗабратьВсе буфер пуст").Равно(0);

КонецПроцедуры

&Тест
Процедура НопСпанБезопасенКВызовам() Экспорт

	Спан = Новый СпанХаба(); // без реального спана — ноп
	Ожидаем.Что(Спан.Активен(), "ноп не активен").ЭтоЛожь();
	Попытка
		Спан.УстановитьАтрибут("k", "v");
		Спан.Ошибка("ошибка");
		Спан.Ок();
		Спан.Завершить();
		Спан.Завершить(); // повторно — безопасно
	Исключение
		Ожидаем.Что(Ложь, "ноп-спан не должен выбрасывать исключения").ЭтоИстина();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ИнструментацияШиныСобытий

&Тест
Процедура ПубликацияСобытияЭмитируетСпанСТипом() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	Издатель = Новый ИздательСобытий(Телеметрия); // Телеметрия — первый (и единственный) параметр
	Подписчик = Новый ФейкПодписчик();
	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), Подписчик);

	Издатель.Опубликовать(Издатель.ТипВерсияОпубликована());

	Ожидаем.Что(Подписчик.Количество(), "подписчик получил событие (публикация не сломана)").Равно(1);
	Ожидаем.Что(Телеметрия.РазмерБуфера() >= 1, "спан публикации в буфере").ЭтоИстина();

	Телеметрия.ЭкспортироватьПартию();
	Тело = Фейк.ТелоПоследнее();
	Ожидаем.Что(СтрНайти(Тело, "events.publish") > 0, "экспортирован спан events.publish").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, Издатель.ТипВерсияОпубликована()) > 0, "атрибут типа события в теле").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПубликацияБезТелеметрииНеЛомается() Экспорт

	Издатель = Новый ИздательСобытий(Неопределено);
	Подписчик = Новый ФейкПодписчик();
	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), Подписчик);

	Попытка
		Издатель.Опубликовать(Издатель.ТипВерсияОпубликована());
	Исключение
		Ожидаем.Что(Ложь, "публикация без телеметрии не должна выбрасывать").ЭтоИстина();
	КонецПопытки;

	Ожидаем.Что(Подписчик.Количество(), "событие доставлено без телеметрии").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область НегативныеСценарии

&Тест
Процедура СекретИзEnvИдётВЗаголовкиНеВТело() Экспорт

	Секрет = "Bearer SEKRET-TOKEN-XYZ";
	УстановитьПеременнуюСреды("OSHUB_OTEL_HEADERS", "Authorization=" + Секрет + ",X-Scope-OrgID=7");
	Попытка
		Фейк = Новый ФейкТранспортHTTP();
		Фейк.УстановитьОтвет(200);
		Телеметрия = НоваяТелеметрия(Фейк, Истина);

		Спан = Телеметрия.НачатьСпан("выдача-ospx", "server");
		Спан.УстановитьАтрибут("oshub.package", "autumn");
		Спан.Завершить();
		Телеметрия.ЭкспортироватьПартию();

		Ожидаем.Что(Фейк.ЗаголовокПоследний("Authorization"), "секрет ушёл в HTTP-заголовки OTLP").Равно(Секрет);
		Ожидаем.Что(Фейк.ЗаголовокПоследний("X-Scope-OrgID"), "доп. заголовок из env").Равно("7");
		Тело = Фейк.ТелоПоследнее();
		Ожидаем.Что(СтрНайти(Тело, "SEKRET-TOKEN-XYZ") = 0, "секрет НЕ в теле resourceSpans").ЭтоИстина();
		Ожидаем.Что(СтрНайти(НРег(Тело), "authorization") = 0, "заголовка авторизации нет в теле").ЭтоИстина();
	Исключение
		УстановитьПеременнуюСреды("OSHUB_OTEL_HEADERS", "");
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПеременнуюСреды("OSHUB_OTEL_HEADERS", ""); // очистка env для остальных тестов набора

КонецПроцедуры

&Тест
Процедура МусорныйTraceparentНеПадаетИНеТечёт() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	Телеметрия = НоваяТелеметрия(Фейк, Истина);

	МусорСПереносом = "00-injected" + Символы.ПС + "header: evil-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
	СверхДлинный = "00-";
	Для Н = 1 По 5000 Цикл
		СверхДлинный = СверхДлинный + "a";
	КонецЦикла;

	Спан1 = Телеметрия.НачатьСпанСервера("api.serve_ospx", МусорСПереносом, Неопределено, Ложь);
	Ожидаем.Что(Спан1.Активен(), "корневой серверный спан при traceparent с переносом строки").ЭтоИстина();
	Спан1.Завершить();

	Спан2 = Телеметрия.НачатьСпанСервера("api.serve_ospx", СверхДлинный, Неопределено, Ложь);
	Ожидаем.Что(Спан2.Активен(), "корневой серверный спан при сверхдлинном traceparent").ЭтоИстина();
	Спан2.Завершить();

	Телеметрия.ЭкспортироватьПартию();
	Тело = Фейк.ТелоПоследнее();
	Ожидаем.Что(СтрНайти(Тело, "injected") = 0, "мусор traceparent не протёк в тело").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "evil-") = 0, "инъекция заголовка не протекла").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КонвейерСМалымMaxQueueДропаетСтарейшее() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200);
	МалыйБуфер = Новый БуферСпанов(2, ЛогТестов()); // эквивалент oshub.otel.max_queue=2
	Телеметрия = Новый Телеметрия(Фейк, МалыйБуфер, Истина, "http://collector:4318",
		"http/json", "openhub-test", 1.0, 10, Ложь, ЛогТестов(),
		Новый ПриведениеЧисел(), Новый ТекстОшибки());

	Для Н = 1 По 5 Цикл
		Спан = Телеметрия.НачатьСпан("op-" + Н, "internal");
		Спан.Завершить();
	КонецЦикла;

	Ожидаем.Что(Телеметрия.РазмерБуфера(), "буфер ограничен лимитом 2 — старейшие спаны отброшены").Равно(2);
	Ожидаем.Что(Телеметрия.ЭкспортироватьПартию(), "экспортированы 2 спана из ограниченного буфера").Равно(2);
	Ожидаем.Что(Телеметрия.РазмерБуфера(), "после экспорта буфер пуст").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция НоваяТелеметрия(Знач Клиент, Знач Включено)
	Возврат Новый Телеметрия(Клиент, Новый БуферСпанов(Неопределено, ЛогТестов()),
		Включено, "http://collector:4318",
		"http/json", "openhub-test", 1.0, 10, Ложь, ЛогТестов(),
		Новый ПриведениеЧисел(), Новый ТекстОшибки());
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.otel");
КонецФункции

Процедура ПодключитьКласс(Знач Путь, Знач Имя)
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

#КонецОбласти
