// HTTP-интеграционные тесты административной части JSON API (/api/v1): группы, состав групп,
// сопоставления групп OIDC, гранты прав доступа, апстримы, квота, видимость и флаги пула, зеркала.
// Поднимает настоящий хаб на файловой БД, засеянной сидером ЗасеятьКабинет.os, и гоняет
// сценарии по реальному HTTP: позитив, аноним, посторонний, чужой приватный пул, роль ниже нужной.

#Использовать asserts
// 1connector — клиент, НЕ следующий редиректам: HTTPСоединение проходит переход сам,
// и адрес возврата (Location) штатным клиентом не наблюдаем вовсе
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;              // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;           // фикстура КлиентХаба — запросы к подопытному хабу
Перем Порт;
Перем КаталогПроекта;

Перем ТокенRoot;    // PAT root — админ хаба
Перем ТокенAlice;   // PAT alice — участник группы platform, не админ
Перем ТокенBob;     // PAT bob — посторонний: ни группы, ни пулов
Перем ТокенOwner;   // PAT owner1 — владелец приватных пулов owned и secret
Перем КукаRoot;     // сессия root — для проверки CSRF на мутации сессией
Перем CSRFRoot;

// адрес источника во внутренней сети: сеть хаб не судит, DNS не нужен,
// а соединение на порт 1 отбивается сразу — синхронизация не висит
Перем АдресАпстрима;

Перем КаталогСборки;   // временный каталог под .ospx очереди заявок
Перем СчётчикПулов;    // уникальные имена пулов: набор делит один хаб

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	АдресАпстрима = "http://127.0.0.1:1/download/";
	СчётчикПулов = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	// очередь заявок гоняется настоящим push, поэтому нужен настоящий .ospx
	РеестрФикстур.Подключить("ФикстураПакета");

	КаталогСборки = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-adminapi-ospx-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогСборки);

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);
	КаталогПроекта = Хаб.КаталогПроекта();
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-adminapi");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// инсталляция без почты выбирает одну из двух развилок (ИСТ-ПОЧТ-007); здесь —
	// выключенное подтверждение адреса, иначе регистрация закрыта
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();
	Порт = Хаб.Порт();

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	ТокенRoot = ВыпуститьPAT(КукаRoot);
	ТокенAlice = ВыпуститьPAT(Клиент.Войти("alice", "AlicePassw0rd"));
	ТокенBob = ВыпуститьPAT(Клиент.Войти("bob", "BobPassw0rd"));
	ТокенOwner = ВыпуститьPAT(Клиент.Войти("owner1", "Owner1Passw0rd"));

	CSRFRoot = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/tokens", КукаRoot)));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	Попытка
		Если ЗначениеЗаполнено(КаталогСборки) И Новый Файл(КаталогСборки).Существует() Тогда
			УдалитьФайлы(КаталогСборки);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область Группы

&Тест
Процедура СписокГруппВидитТолькоСвои() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/groups").КодСостояния, "аноним не видит групп → 401").Равно(401);

	Свои = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups", ТокенAlice));
	Ожидаем.Что(СодержитИмя(Свои.Получить("items"), "platform"),
		"alice видит свою группу").ЭтоИстина();

	Чужой = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups", ТокенBob));
	Ожидаем.Что(СодержитИмя(Чужой.Получить("items"), "platform"),
		"bob чужую группу не видит").ЭтоЛожь();

	Админ = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups?pageSize=100", ТокенRoot));
	Ожидаем.Что(СодержитИмя(Админ.Получить("items"), "platform"),
		"админ хаба видит все группы").ЭтоИстина();
	Ожидаем.Что(Админ.Получить("page"), "форма пагинации").Равно(1);

КонецПроцедуры

&Тест
Процедура СозданиеГруппыТолькоАдминХаба() Экспорт

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups", "{""имя"":""anon-team""}", "").КодСостояния,
		"аноним не создаёт группу → 401").Равно(401);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups", "{""имя"":""bob-team""}", ТокенBob).КодСостояния,
		"посторонний не создаёт группу → 403").Равно(403);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups", "{""имя"":""alice-team""}", ТокенAlice).КодСостояния,
		"участник группы — не админ хаба → 403").Равно(403);

	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups", "{""имя"":""release"",""описание"":""Релиз-инженеры""}", ТокенRoot);
	Ожидаем.Что(Созд.КодСостояния, "админ хаба создаёт группу → 201").Равно(201);
	Группа = Клиент.ТелоJSON(Созд).Получить("group");
	Ожидаем.Что(Группа.Получить("name")).Равно("release");
	Ожидаем.Что(Группа.Получить("description")).Равно("Релиз-инженеры");

	Дубль = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups", "{""имя"":""release""}", ТокенRoot);
	Ожидаем.Что(Дубль.КодСостояния, "дубликат группы → 409").Равно(409);
	ПроверитьФорматОшибки(Дубль, "group_exists");

	Пустая = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups", "{""имя"":""  ""}", ТокенRoot);
	Ожидаем.Что(Пустая.КодСостояния, "пустое имя → 400").Равно(400);
	ПроверитьФорматОшибки(Пустая, "invalid_group");

КонецПроцедуры

&Тест
Процедура КарточкаГруппыВиднаУчастникуИАдмину() Экспорт

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform", ТокенAlice).КодСостояния,
		"участник видит карточку").Равно(200);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform", ТокенRoot).КодСостояния,
		"админ хаба видит карточку").Равно(200);

	Чужой = Клиент.GETСТокеном("/api/v1/groups/platform", ТокенBob);
	Ожидаем.Что(Чужой.КодСостояния, "посторонний → 403").Равно(403);
	ПроверитьФорматОшибки(Чужой, "forbidden");

	НетТакой = Клиент.GETСТокеном("/api/v1/groups/no-such-group", ТокенRoot);
	Ожидаем.Что(НетТакой.КодСостояния, "неизвестная группа → 404").Равно(404);
	ПроверитьФорматОшибки(НетТакой, "group_not_found");

	// лишний хвост пути не исполняется коротким адресом
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform/junk/tail", ТокенRoot).КодСостояния,
		"лишние сегменты пути → 404").Равно(404);

КонецПроцедуры

&Тест
Процедура СоставГруппыЧитаетсяУчастникомПравитсяАдмином() Экспорт

	Состав = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups/platform/members", ТокенAlice));
	Ожидаем.Что(СодержитЛогин(Состав.Получить("items"), "alice"),
		"alice в составе своей группы").ЭтоИстина();
	Ожидаем.Что(ИсточникЧленства(Состав.Получить("items"), "alice"),
		"источник локального членства").Равно("local");

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform/members", ТокенBob).КодСостояния,
		"посторонний не читает состав → 403").Равно(403);
	Ожидаем.Что(Клиент.GET("/api/v1/groups/platform/members").КодСостояния,
		"аноним не читает состав → 401").Равно(401);

	// участник группы — ещё не редактор: правит только админ хаба
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/members", "{""логин"":""bob""}", ТокенAlice).КодСостояния,
		"участник не добавляет участников → 403").Равно(403);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/members", "{""логин"":""bob""}", ТокенBob).КодСостояния,
		"посторонний не добавляет участников → 403").Равно(403);

	Добавлен = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/members", "{""логин"":""bob""}", ТокенRoot);
	Ожидаем.Что(Добавлен.КодСостояния, "админ хаба добавляет участника → 201").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Добавлен).Получить("member").Получить("login")).Равно("bob");

	// теперь bob участник и состав ему виден
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform/members", ТокенBob).КодСостояния,
		"новый участник читает состав").Равно(200);

	Неизвестный = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/members", "{""логин"":""nobody""}", ТокенRoot);
	Ожидаем.Что(Неизвестный.КодСостояния, "неизвестный логин → 400").Равно(400);
	ПроверитьФорматОшибки(Неизвестный, "unknown_user");

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/groups/platform/members/bob", "", ТокенAlice).КодСостояния,
		"участник не снимает участников → 403").Равно(403);

	Снят = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/groups/platform/members/bob", "", ТокенRoot);
	Ожидаем.Что(Снят.КодСостояния, "админ хаба снимает участника → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Снят).Получить("removed"), "участник снят").ЭтоИстина();

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform/members", ТокенBob).КодСостояния,
		"снятый участник снова посторонний → 403").Равно(403);

КонецПроцедуры

&Тест
Процедура МутацияСессиейТребуетCSRF() Экспорт

	БезТокена = Клиент.ЗапросJSON("POST", "/api/v1/groups", "{""имя"":""csrf-team""}", Клиент.ЗаголовкиМутации(КукаRoot, ""));
	Ожидаем.Что(БезТокена.КодСостояния, "сессия без CSRF → 403").Равно(403);
	ПроверитьФорматОшибки(БезТокена, "csrf_failed");

	С_Токеном = Клиент.ЗапросJSON("POST", "/api/v1/groups", "{""имя"":""csrf-team""}", Клиент.ЗаголовкиМутации(КукаRoot, CSRFRoot));
	Ожидаем.Что(С_Токеном.КодСостояния, "сессия с CSRF → 201").Равно(201);

	// настройки пула — та же дверь: без CSRF сессия их не меняет
	БезCSRF = Клиент.ЗапросJSON("PATCH", "/api/v1/pools/public/settings", "{""квота_мб"":1}", Клиент.ЗаголовкиМутации(КукаRoot, ""));
	Ожидаем.Что(БезCSRF.КодСостояния, "настройки пула сессией без CSRF → 403").Равно(403);
	ПроверитьФорматОшибки(БезCSRF, "csrf_failed");

	СCSRF = Клиент.ЗапросJSON("PATCH", "/api/v1/pools/public/settings", "{""квота_мб"":1}", Клиент.ЗаголовкиМутации(КукаRoot, CSRFRoot));
	Ожидаем.Что(СCSRF.КодСостояния, "настройки пула сессией с CSRF → 200").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область СопоставленияOIDC

&Тест
Процедура СопоставленияГруппыЧитаютсяУчастникомПравятсяАдмином() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/groups/platform/oidc-mappings").КодСостояния,
		"аноним → 401").Равно(401);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform/oidc-mappings", ТокенBob).КодСостояния,
		"посторонний → 403").Равно(403);

	Тело_ = "{""издатель"":""https://idp.example.com"",""клейм"":""groups"",""значение"":""platform-team""}";
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/oidc-mappings", Тело_, ТокенAlice).КодСостояния,
		"участник не заводит правило → 403").Равно(403);

	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/oidc-mappings", Тело_, ТокенRoot);
	Ожидаем.Что(Созд.КодСостояния, "админ хаба заводит правило → 201").Равно(201);
	Правило = Клиент.ТелоJSON(Созд).Получить("mapping");
	Ожидаем.Что(Правило.Получить("issuer")).Равно("https://idp.example.com");
	Ожидаем.Что(Правило.Получить("value")).Равно("platform-team");
	Ожидаем.Что(Правило.Получить("group")).Равно("platform");

	Список = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups/platform/oidc-mappings", ТокенAlice));
	Ожидаем.Что(Список.Получить("total") >= 1, "участник видит правило группы").ЭтоИстина();
	Ожидаем.Что(Список.Получить("policy"), "политика выпавших по умолчанию").Равно("исключать");

	Плохое = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/oidc-mappings", "{""издатель"":""""}", ТокенRoot);
	Ожидаем.Что(Плохое.КодСостояния, "пустой issuer → 400").Равно(400);
	ПроверитьФорматОшибки(Плохое, "invalid_mapping");

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/groups/platform/oidc-mappings", Тело_, ТокенAlice).КодСостояния,
		"участник не снимает правило → 403").Равно(403);

	Снято = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/groups/platform/oidc-mappings", Тело_, ТокенRoot);
	Ожидаем.Что(Снято.КодСостояния, "админ хаба снимает правило → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Снято).Получить("removed"), "правило снято").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбзорСопоставленийХабаТолькоАдмину() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/oidc-mappings").КодСостояния, "аноним → 401").Равно(401);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/oidc-mappings", ТокенBob).КодСостояния,
		"не админ хаба → 403").Равно(403);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/oidc-mappings", ТокенAlice).КодСостояния,
		"участник группы — не админ хаба → 403").Равно(403);

	Тело_ = "{""издатель"":""https://idp.hub"",""значение"":""ops""}";
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups/platform/oidc-mappings", Тело_, ТокенRoot).КодСостояния,
		"правило заведено").Равно(201);

	Все = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/oidc-mappings", ТокенRoot));
	Ожидаем.Что(Все.Получить("total") >= 1, "админ видит правила хаба").ЭтоИстина();

	Отбор = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/oidc-mappings?issuer=https://idp.hub", ТокенRoot));
	Ожидаем.Что(Отбор.Получить("total") >= 1, "отбор по issuer находит правило").ЭтоИстина();

	Пусто = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/oidc-mappings?issuer=https://none.example", ТокенRoot));
	Ожидаем.Что(Пусто.Получить("total"), "отбор по чужому issuer пуст").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Гранты

&Тест
Процедура ГрантыПулаНеРаскрываютЧужойПриватныйПул() Экспорт

	// owned приватен и принадлежит owner1
	Ожидаем.Что(Клиент.GET("/api/v1/pools/owned/grants").КодСостояния,
		"аноним: приватный пул неотличим от несуществующего → 404").Равно(404);

	Посторонний = Клиент.GETСТокеном("/api/v1/pools/owned/grants", ТокенBob);
	Ожидаем.Что(Посторонний.КодСостояния, "посторонний: чужой приватный пул → 404").Равно(404);
	ПроверитьФорматОшибки(Посторонний, "pool_not_found");

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/grants", ТокенOwner).КодСостояния,
		"владелец пула читает гранты").Равно(200);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/grants", ТокенRoot).КодСостояния,
		"админ хаба читает гранты").Равно(200);

	// public виден всем, но администрирует его только админ хаба → 403, а не 404
	Видимый = Клиент.GETСТокеном("/api/v1/pools/public/grants", ТокенBob);
	Ожидаем.Что(Видимый.КодСостояния, "видимый пул без прав администрирования → 403").Равно(403);
	ПроверитьФорматОшибки(Видимый, "forbidden");

	// мутация по чужому приватному пулу — тоже 404, существование не раскрывается
	Мутация = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/grants",
		"{""тип_субъекта"":""пользователь"",""субъект"":""bob"",""роль"":""читатель""}", ТокенBob);
	Ожидаем.Что(Мутация.КодСостояния, "посторонний не выдаёт грант в чужом пуле → 404").Равно(404);

КонецПроцедуры

&Тест
Процедура ВыдачаИОтзывРолиНаПуле() Экспорт

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/grants", "{""субъект"":""bob""}", "").КодСостояния,
		"аноним → 401").Равно(401);

	Выдача = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/grants",
		"{""тип_субъекта"":""пользователь"",""субъект"":""bob"",""роль"":""читатель""}", ТокенOwner);
	Ожидаем.Что(Выдача.КодСостояния, "владелец выдаёт роль → 201").Равно(201);
	Грант = Клиент.ТелоJSON(Выдача).Получить("grant");
	Ожидаем.Что(Грант.Получить("subject")).Равно("bob");
	Ожидаем.Что(Грант.Получить("subject_type")).Равно("пользователь");
	Ожидаем.Что(Грант.Получить("object")).Равно("owned");
	Ожидаем.Что(Грант.Получить("role")).Равно("читатель");
	Ожидаем.Что(Грант.Получить("actions").Получить("read"), "роль читателя даёт чтение").ЭтоИстина();

	// грант виден в витрине по объекту
	Список = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned/grants", ТокенOwner));
	Ожидаем.Что(СодержитСубъект(Список.Получить("items"), "bob"), "грант в витрине объекта").ЭтоИстина();

	// и в витрине по субъекту
	ПоСубъекту = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/users/bob/grants", ТокенBob));
	Ожидаем.Что(СодержитОбъект(ПоСубъекту.Получить("items"), "owned"), "грант в витрине субъекта").ЭтоИстина();

	// чтение роль читателя даёт, администрирование — нет
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned", ТокенBob).КодСостояния,
		"читатель видит пул").Равно(200);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/grants", ТокенBob).КодСостояния,
		"читатель не администрирует пул → 403").Равно(403);

	Неизвестный = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/grants",
		"{""субъект"":""nobody"",""роль"":""читатель""}", ТокенOwner);
	Ожидаем.Что(Неизвестный.КодСостояния, "неизвестный субъект → 400").Равно(400);
	ПроверитьФорматОшибки(Неизвестный, "unknown_subject");

	ЧужойТип = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/grants",
		"{""тип_субъекта"":""робот"",""субъект"":""bob"",""роль"":""читатель""}", ТокенOwner);
	Ожидаем.Что(ЧужойТип.КодСостояния, "неизвестный тип субъекта → 400").Равно(400);
	ПроверитьФорматОшибки(ЧужойТип, "invalid_subject");

	// роли выше мейнтейнера на объекте не выдаются
	Эскалация = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/grants",
		"{""субъект"":""bob"",""роль"":""владелец""}", ТокенOwner);
	Ожидаем.Что(Эскалация.КодСостояния, "роль выше мейнтейнера → 422").Равно(422);
	ПроверитьФорматОшибки(Эскалация, "invalid_grant");

	Отзыв = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/owned/grants",
		"{""тип_субъекта"":""пользователь"",""субъект"":""bob""}", ТокенOwner);
	Ожидаем.Что(Отзыв.КодСостояния, "отзыв гранта → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Отзыв).Получить("revoked"), "грант отозван").ЭтоИстина();

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned", ТокенBob).КодСостояния,
		"после отзыва пул снова невидим → 404").Равно(404);

КонецПроцедуры

&Тест
Процедура ГрантНаПакетНеПереходитГраницуПула() Экспорт

	Выдача = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/grants",
		"{""тип_субъекта"":""группа"",""субъект"":""platform"",""роль"":""райтер"",""пакет"":""alice-pkg""}",
		ТокенRoot);
	Ожидаем.Что(Выдача.КодСостояния, "грант на пакет → 201").Равно(201);
	Грант = Клиент.ТелоJSON(Выдача).Получить("grant");
	Ожидаем.Что(Грант.Получить("object_type")).Равно("пакет");
	Ожидаем.Что(Грант.Получить("object")).Равно("alice-pkg");
	Ожидаем.Что(Грант.Получить("subject")).Равно("platform");

	Витрина = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/public/grants?package=alice-pkg", ТокенRoot));
	Ожидаем.Что(СодержитСубъект(Витрина.Получить("items"), "platform"),
		"грант виден в витрине пакета").ЭтоИстина();

	// пакет чужого пула через адрес своего пула не достаётся: объект ищется ТОЛЬКО в этом пуле
	Чужой = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/grants",
		"{""субъект"":""bob"",""роль"":""райтер"",""пакет"":""secret-pkg""}", ТокенRoot);
	Ожидаем.Что(Чужой.КодСостояния, "пакет другого пула → 404").Равно(404);
	ПроверитьФорматОшибки(Чужой, "package_not_found");

	// витрина группы показывает выданный грант её участнику
	ПоГруппе = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups/platform/grants", ТокенAlice));
	Ожидаем.Что(СодержитОбъект(ПоГруппе.Получить("items"), "alice-pkg"),
		"участник видит гранты своей группы").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups/platform/grants", ТокенBob).КодСостояния,
		"посторонний не видит гранты группы → 403").Равно(403);

	Отзыв = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/public/grants",
		"{""тип_субъекта"":""группа"",""субъект"":""platform"",""пакет"":""alice-pkg""}", ТокенRoot);
	Ожидаем.Что(Клиент.ТелоJSON(Отзыв).Получить("revoked"), "грант на пакет отозван").ЭтоИстина();

КонецПроцедуры

// Паритет с экраном пакета: правами НА ПАКЕТ распоряжается мейнтейнер этого пакета,
// администратором пула для этого быть не нужно. Порядок проверок сохранён: сначала
// видимость пула (чужой приватный неотличим от несуществующего), потом объект, потом право.
&Тест
Процедура ПраваНаПакетДоступныМейнтейнеруПакетаАНеТолькоАдминуПула() Экспорт

	Тело_ = "{""тип_субъекта"":""пользователь"",""субъект"":""bob"",""роль"":""мейнтейнер"","
		+ """пакет"":""alice-pkg""}";
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/grants", Тело_, ТокенRoot).КодСостояния,
		"админ хаба сделал bob мейнтейнером ПАКЕТА").Равно(201);

	Попытка

		// пулом bob по-прежнему не управляет
		Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/grants", ТокенBob).КодСостояния,
			"права на ПУЛ мейнтейнеру пакета закрыты → 403").Равно(403);
		Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/grants",
				"{""субъект"":""pub"",""роль"":""читатель""}", ТокенBob).КодСостояния,
			"и выдать право на пул он не может → 403").Равно(403);

		// а правами своего ПАКЕТА — распоряжается
		Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/grants?package=alice-pkg", ТокенBob).КодСостояния,
			"права своего пакета читает").Равно(200);

		Выдача = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/grants",
			"{""субъект"":""pub"",""роль"":""читатель"",""пакет"":""alice-pkg""}", ТокенBob);
		Ожидаем.Что(Выдача.КодСостояния, "и выдаёт право на свой пакет → 201").Равно(201);
		Ожидаем.Что(Клиент.ТелоJSON(Выдача).Получить("grant").Получить("object_type")).Равно("пакет");

		// потолок роли на месте: выше мейнтейнера не выдаётся
		Эскалация = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/grants",
			"{""субъект"":""pub"",""роль"":""владелец"",""пакет"":""alice-pkg""}", ТокенBob);
		Ожидаем.Что(Эскалация.КодСостояния, "роль выше мейнтейнера → 422").Равно(422);

		// чужой приватный пул остаётся неотличимым от несуществующего и с параметром package
		Скрытый = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/secret/grants",
			"{""субъект"":""bob"",""роль"":""читатель"",""пакет"":""secret-pkg""}", ТокенBob);
		Ожидаем.Что(Скрытый.КодСостояния,
			"чужой приватный пул → 404 раньше любого разговора о правах").Равно(404);
		ПроверитьФорматОшибки(Скрытый, "pool_not_found");

		Отзыв = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/public/grants",
			"{""субъект"":""pub"",""пакет"":""alice-pkg""}", ТокенBob);
		Ожидаем.Что(Клиент.ТелоJSON(Отзыв).Получить("revoked"), "и отзывает его сам").ЭтоИстина();

	Исключение
		СнятьПравоНаПакет("bob");
		СнятьПравоНаПакет("pub");
		ВызватьИсключение;
	КонецПопытки;

	СнятьПравоНаПакет("bob");
	СнятьПравоНаПакет("pub");

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/grants?package=alice-pkg", ТокенBob).КодСостояния,
		"без роли на пакете доступ закрыт → 403").Равно(403);

КонецПроцедуры

Процедура СнятьПравоНаПакет(Знач Субъект)
	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/public/grants",
		СтрШаблон("{""субъект"":""%1"",""пакет"":""alice-pkg""}", Субъект), ТокенRoot);
КонецПроцедуры

// Витрина прав группы отдаёт участнику только видимые ему объекты. Право на ПАКЕТ чтения
// его пула не даёт (приватный пул ⇒ приватны все его пакеты), поэтому строка с пакетом
// приватного пула иначе рассказала бы участнику имя пула, которого он не видит.
&Тест
Процедура ПраваГруппыНеРаскрываютУчастникуНевидимыеОбъекты() Экспорт

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/secret/grants",
			"{""тип_субъекта"":""группа"",""субъект"":""platform"",""роль"":""читатель"","
			+ """пакет"":""secret-pkg""}", ТокенRoot).КодСостояния,
		"группе выдано право на пакет приватного пула").Равно(201);

	Попытка

		Админ = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups/platform/grants", ТокенRoot));
		Ожидаем.Что(СодержитОбъект(Админ.Получить("items"), "secret-pkg"),
			"администратору хаба объект виден").ЭтоИстина();

		Участник = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/groups/platform/grants", ТокенAlice));
		Ожидаем.Что(СодержитОбъект(Участник.Получить("items"), "secret-pkg"),
			"участнику группы объект приватного пула не показывается").ЭтоЛожь();

		// alice действительно не может читать этот пакет — витрина не прячет доступное
		Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/secret/packages/secret-pkg", ТокенAlice).КодСостояния,
			"право на пакет чтения приватного пула не даёт → 404").Равно(404);

	Исключение
		Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/secret/grants",
			"{""тип_субъекта"":""группа"",""субъект"":""platform"",""пакет"":""secret-pkg""}", ТокенRoot);
		ВызватьИсключение;
	КонецПопытки;

	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/secret/grants",
		"{""тип_субъекта"":""группа"",""субъект"":""platform"",""пакет"":""secret-pkg""}", ТокенRoot);

КонецПроцедуры

&Тест
Процедура ПраваЧужогоАккаунтаВидитТолькоАдмин() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/users/alice/grants").КодСостояния, "аноним → 401").Равно(401);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/users/alice/grants", ТокенAlice).КодСостояния,
		"свои права видны").Равно(200);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/users/alice/grants", ТокенRoot).КодСостояния,
		"админ хаба видит чужие права").Равно(200);

	Чужие = Клиент.GETСТокеном("/api/v1/users/alice/grants", ТокенBob);
	Ожидаем.Что(Чужие.КодСостояния, "посторонний не видит чужие права → 403").Равно(403);
	ПроверитьФорматОшибки(Чужие, "forbidden");

	// несуществующий логин админу отвечает 404, а постороннему — всё тот же 403:
	// существование аккаунта перебором не выясняется
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/users/nobody/grants", ТокенRoot).КодСостояния,
		"неизвестный логин админу → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/users/nobody/grants", ТокенBob).КодСостояния,
		"неизвестный логин постороннему → 403").Равно(403);

КонецПроцедуры

#КонецОбласти

#Область АпстримыИНастройкиПула

&Тест
Процедура АпстримыПулаТолькоАдминистраторуПула() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/pools/owned/upstreams").КодСостояния,
		"аноним: чужой приватный пул → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/upstreams", ТокенBob).КодСостояния,
		"посторонний: чужой приватный пул → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/upstreams", ТокенBob).КодСостояния,
		"видимый пул без администрирования → 403").Равно(403);

	Пусто = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned/upstreams", ТокенOwner));
	Ожидаем.Что(Пусто.Получить("total"), "у пула ещё нет апстримов").Равно(0);

	Тело_ = СтрШаблон("{""url"":""%1"",""ttl"":300}", АдресАпстрима);

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams", Тело_, ТокенBob).КодСостояния,
		"посторонний не заводит апстрим → 404").Равно(404);

	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams", Тело_, ТокенOwner);
	Ожидаем.Что(Созд.КодСостояния, "владелец заводит апстрим → 201").Равно(201);
	Апстрим = Клиент.ТелоJSON(Созд).Получить("upstream");
	Ожидаем.Что(Апстрим.Получить("url")).Равно(АдресАпстрима);
	Ожидаем.Что(Апстрим.Получить("ttl")).Равно(300);
	Ожидаем.Что(Апстрим.Получить("allow_private") = Неопределено,
		"разрешающего флага в выдаче нет вовсе: сеть источника не судится").ЭтоИстина();

	Список = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned/upstreams", ТокенOwner));
	Ожидаем.Что(Список.Получить("total"), "апстрим в списке").Равно(1);

	// сеть источника не судится, а не-адрес — отвергается
	Плохой = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams",
		"{""url"":""gopher://hub.local/""}", ТокенOwner);
	Ожидаем.Что(Плохой.КодСостояния, "чужая схема → 422").Равно(422);
	ПроверитьФорматОшибки(Плохой, "invalid_upstream");

	ВоВнутреннююСеть = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams",
		"{""url"":""http://169.254.169.254/""}", ТокенOwner);
	Ожидаем.Что(ВоВнутреннююСеть.КодСостояния, "адрес во внутренней сети принят → 201").Равно(201);
	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/owned/upstreams",
		"{""url"":""http://169.254.169.254/""}", ТокенOwner);

	БезUrl = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams", "{""ttl"":300}", ТокенOwner);
	Ожидаем.Что(БезUrl.КодСостояния, "пустой url → 400").Равно(400);

	МусорTTL = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams",
		СтрШаблон("{""url"":""%1"",""ttl"":""быстро""}", АдресАпстрима), ТокенOwner);
	Ожидаем.Что(МусорTTL.КодСостояния, "нечисловой ttl → 400").Равно(400);

	Снятие = СтрШаблон("{""url"":""%1""}", АдресАпстрима);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/owned/upstreams", Снятие, ТокенBob).КодСостояния,
		"посторонний не снимает апстрим → 404").Равно(404);

	Снято = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/owned/upstreams", Снятие, ТокенOwner);
	Ожидаем.Что(Снято.КодСостояния, "владелец снимает апстрим → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Снято).Получить("removed"), "апстрим снят").ЭтоИстина();
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned/upstreams", ТокенOwner)).Получить("total"),
		"список опустел").Равно(0);

КонецПроцедуры

// ИСТ-АПСТ-007 вживую: пул-прокси обязан находить версию, которая лежит не у него,
// а у его источника, — иначе `opm update` на зеркалированном пакете топчется на месте.
// Источником служит другой пул этого же хаба: перечень версий выдачи OpenHub — тот самый
// адрес, которым хаб отвечает своим клиентам, так что протокол проверяется настоящий.
&Тест
Процедура ВерсияЛежащаяТолькоУИсточникаНаходитсяИСкачивается() Экспорт

	Источник = УникальноеИмяПула("union-src");
	Прокси = УникальноеИмяПула("union-proxy");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Источник)).КодСостояния,
		"пул-источник заведён").Равно(201);
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Прокси)).КодСостояния,
		"пул-прокси заведён").Равно(201);

	Первая = Публикация(СтрШаблон("/api/v1/pools/%1/push", Источник),
		ПостроитьOspxДанные("unionpkg", "1.0.0"), "unionpkg-1.0.0.ospx", ТокенRoot);
	Ожидаем.Что(Первая.КодСостояния, "1.0.0 опубликована в пуле-источнике: " + Клиент.Тело(Первая)).Равно(201);

	Адрес = СтрШаблон("http://localhost:%1/api/v1/pools/%2/download/",
		Формат(Порт, "ЧГ=0; ЧН=0"), Источник);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/upstreams", Прокси),
		СтрШаблон("{""url"":""%1"",""ttl"":300}", Адрес), ТокенRoot).КодСостояния,
		"источник добавлен пулу-прокси").Равно(201);

	// точной координатой пакет приезжает в прокси — ровно так он там и заводится
	Ожидаем.Что(Клиент.GET(СтрШаблон("/api/v1/pools/%1/download/unionpkg/unionpkg-1.0.0.ospx",
		Прокси)).КодСостояния, "1.0.0 привезена в пул-прокси").Равно(200);

	// источник выпустил 2.0.0; у прокси её нет ни в индексе, ни в кэше
	Вторая = Публикация(СтрШаблон("/api/v1/pools/%1/push", Источник),
		ПостроитьOspxДанные("unionpkg", "2.0.0"), "unionpkg-2.0.0.ospx", ТокенRoot);
	Ожидаем.Что(Вторая.КодСостояния, "2.0.0 опубликована в пуле-источнике: " + Клиент.Тело(Вторая)).Равно(201);

	Резолв = Клиент.ТелоJSON(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/unionpkg/resolve", Прокси)));
	Ожидаем.Что(Строка(Резолв.Получить("version")),
		"резолв прокси называет версию, которая есть только у источника").Равно("2.0.0");
	Ожидаем.Что(Резолв.Получить("all_sources_polled"),
		"и все источники были опрошены — «новее нет» было бы проверенным фактом").ЭтоИстина();

	Ожидаем.Что(Клиент.GET(СтрШаблон("/api/v1/pools/%1/download/unionpkg/unionpkg.ospx",
		Прокси)).КодСостояния, "безверсионная выдача прокси отдаёт её же").Равно(200);
	Ожидаем.Что(Строка(Клиент.ТелоJSON(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/unionpkg/resolve",
		Прокси))).Получить("version")), "после скачивания 2.0.0 лежит и в самом прокси").Равно("2.0.0");

КонецПроцедуры

// «Версии новее нет» — не проверенный факт, если спросить было некого. Признак виден
// клиенту и в удачном ответе, и в отказе: молчащий источник от отсутствия версии отличается.
&Тест
Процедура РезолвПризнаётсяЧтоНеВсеИсточникиОпрошены() Экспорт

	Пул = УникальноеИмяПула("silent-src");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Пул)).КодСостояния,
		"пул заведён").Равно(201);

	Опубликована = Публикация(СтрШаблон("/api/v1/pools/%1/push", Пул),
		ПостроитьOspxДанные("silentpkg", "1.0.0"), "silentpkg-1.0.0.ospx", ТокенRoot);
	Ожидаем.Что(Опубликована.КодСостояния, "1.0.0 опубликована: " + Клиент.Тело(Опубликована)).Равно(201);

	// пул без источников: спрашивать некого, и опрошены заведомо все
	Полный = Клиент.ТелоJSON(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/silentpkg/resolve", Пул)));
	Ожидаем.Что(Полный.Получить("all_sources_polled"),
		"у пула без источников набор полон").ЭтоИстина();

	// источник, который не отвечает: соединение на порт 1 отбивается сразу
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/upstreams", Пул),
		СтрШаблон("{""url"":""%1"",""ttl"":300}", АдресАпстрима), ТокенRoot).КодСостояния,
		"молчащий источник добавлен пулу").Равно(201);

	Неполный = Клиент.ТелоJSON(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/silentpkg/resolve", Пул)));
	Ожидаем.Что(Строка(Неполный.Получить("version")),
		"отвечаем известным: своя версия на месте").Равно("1.0.0");
	Ожидаем.Что(Неполный.Получить("all_sources_polled"),
		"но «новее нет» за проверенный факт не выдаём — источник молчал").ЭтоЛожь();

	// адрес собирается склейкой: «%» в шаблоне СтрШаблон — это подстановка, а не процент-кодирование
	Отказ = Клиент.GET("/api/v1/pools/" + Пул + "/packages/silentpkg/resolve?spec="
		+ КодироватьСтроку("^9.0", СпособКодированияСтроки.КодировкаURL));
	Ожидаем.Что(Отказ.КодСостояния, "подходящей версии нет → 404").Равно(404);
	ПроверитьФорматОшибки(Отказ, "version_not_found");
	Ожидаем.Что(Клиент.ТелоJSON(Отказ).Получить("all_sources_polled"),
		"и отказ тоже признаётся, что спросить было некого").ЭтоЛожь();

КонецПроцедуры

// Резолв версии и выдача файла отвечают ОДНИМ кругом кандидатов: на имени, куда привезли
// чужую версию постарше, «назови версию» и «дай файл» обязаны назвать одну и ту же.
&Тест
Процедура РезолвИВыдачаНеРасходятсяНаЗахваченномИмени() Экспорт

	Источник = УникальноеИмяПула("circle-src");
	Прокси = УникальноеИмяПула("circle-proxy");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Источник)).КодСостояния,
		"пул-источник заведён").Равно(201);
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Прокси)).КодСостояния,
		"пул-прокси заведён").Равно(201);

	Чужая = Публикация(СтрШаблон("/api/v1/pools/%1/push", Источник),
		ПостроитьOspxДанные("caplib", "9.0.0"), "caplib-9.0.0.ospx", ТокенRoot);
	Ожидаем.Что(Чужая.КодСостояния, "9.0.0 опубликована у источника: " + Клиент.Тело(Чужая)).Равно(201);

	Адрес = СтрШаблон("http://localhost:%1/api/v1/pools/%2/download/",
		Формат(Порт, "ЧГ=0; ЧН=0"), Источник);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/upstreams", Прокси),
		СтрШаблон("{""url"":""%1"",""ttl"":300}", Адрес), ТокенRoot).КодСостояния,
		"источник добавлен пулу-прокси").Равно(201);

	// чужая 9.0.0 оседает в индексе прокси, и лишь ПОТОМ имя становится своим
	Ожидаем.Что(Клиент.GET(СтрШаблон("/api/v1/pools/%1/download/caplib/caplib-9.0.0.ospx",
		Прокси)).КодСостояния, "9.0.0 привезена в прокси").Равно(200);
	Своя = Публикация(СтрШаблон("/api/v1/pools/%1/push", Прокси),
		ПостроитьOspxДанные("caplib", "1.0.0"), "caplib-1.0.0.ospx", ТокенRoot);
	Ожидаем.Что(Своя.КодСостояния, "имя захвачено своей публикацией: " + Клиент.Тело(Своя)).Равно(201);

	// источник снят: отвечает только индекс пула, где лежат обе версии
	Клиент.ЗапросJSONСТокеном("DELETE", СтрШаблон("/api/v1/pools/%1/upstreams", Прокси),
		СтрШаблон("{""url"":""%1""}", Адрес), ТокенRoot);

	Резолв = Строка(Клиент.ТелоJSON(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/caplib/resolve",
		Прокси))).Получить("version"));
	Выдача = ОтданнаяВерсия(СтрШаблон("/api/v1/pools/%1/download/caplib/caplib.ospx", Прокси));

	Ожидаем.Что(Резолв, "резолв выбирает среди своих версий, а не привезённых").Равно("1.0.0");
	Ожидаем.Что(Выдача, "и выдача отдаёт ту же самую").Равно(Резолв);

КонецПроцедуры

// ИСТ-АПСТ-006: токен приватного источника задаётся через API, но обратно не выдаётся —
// в карточке только признак. Пустое поле означает «оставить прежний», снимает token_remove.
&Тест
Процедура ТокенАпстримаЗадаётсяAPIНоОбратноНеВыдаётся() Экспорт

	Тело_ = СтрШаблон("{""url"":""%1"",""ttl"":300,""token"":""sekret-42""}", АдресАпстрима);
	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams", Тело_, ТокенOwner);

	Ожидаем.Что(Созд.КодСостояния, "апстрим с токеном заведён → 201").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Созд).Получить("upstream").Получить("token_set"),
		"признак «токен задан» виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Созд), "sekret-42"),
		"значения токена в ответе нет: " + Клиент.Тело(Созд)).Равно(0);

	Список = Клиент.GETСТокеном("/api/v1/pools/owned/upstreams", ТокенOwner);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Список), "sekret-42"),
		"и в списке его тоже нет").Равно(0);

	// правка TTL без поля токена секрет не стирает
	Правка = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams",
		СтрШаблон("{""url"":""%1"",""ttl"":600}", АдресАпстрима), ТокенOwner);
	Ожидаем.Что(Клиент.ТелоJSON(Правка).Получить("upstream").Получить("ttl"), "TTL изменён").Равно(600);
	Ожидаем.Что(Клиент.ТелоJSON(Правка).Получить("upstream").Получить("token_set"),
		"а токен остался").ЭтоИстина();

	Снятие = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams",
		СтрШаблон("{""url"":""%1"",""token_remove"":true}", АдресАпстрима), ТокенOwner);
	Ожидаем.Что(Клиент.ТелоJSON(Снятие).Получить("upstream").Получить("token_set"),
		"снятие возвращает анонимное чтение").ЭтоЛожь();

	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/owned/upstreams",
		СтрШаблон("{""url"":""%1""}", АдресАпстрима), ТокенOwner);

КонецПроцедуры

&Тест
Процедура ФлагПубликацииПулаПереключаетсяАдминистраторомПула() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/pools/owned/settings").КодСостояния, "аноним → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/settings", ТокенBob).КодСостояния,
		"видимый пул без администрирования → 403").Равно(403);

	Было = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned/settings", ТокенOwner)).Получить("settings");
	Ожидаем.Что(Было.Получить("publish_allowed"), "новый пул принимает публикации").ЭтоИстина();
	Ожидаем.Что(Было.Получить("visibility")).Равно("private");

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{""публикация"":false}", ТокенBob).КодСостояния,
		"посторонний не переключает флаг → 404").Равно(404);

	Выкл = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{""публикация"":false}", ТокенOwner);
	Ожидаем.Что(Выкл.КодСостояния, "владелец выключает публикацию → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Выкл).Получить("settings").Получить("publish_allowed"),
		"флаг снят").ЭтоЛожь();

	БезПоля = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{}", ТокенOwner);
	Ожидаем.Что(БезПоля.КодСостояния, "нечего менять → 400").Равно(400);
	ПроверитьФорматОшибки(БезПоля, "no_changes");

	Вкл = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{""publish_allowed"":true}", ТокенRoot);
	Ожидаем.Что(Клиент.ТелоJSON(Вкл).Получить("settings").Получить("publish_allowed"),
		"англоязычное имя поля работает так же").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УдалениеПула

// Удаление уносит ВСЁ, что висело на пуле, и освобождает имя: пул с тем же именем
// заводится заново и начинается пустым — «пересобрать начисто» это удалить и создать.
&Тест
Процедура УдалениеПулаAPIУноситСодержимоеИОсвобождаетИмя() Экспорт

	Имя = УникальноеИмяПула("wipe");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя)).КодСостояния,
		"пул под снос заведён").Равно(201);

	Ожидаем.Что(Публикация(СтрШаблон("/api/v1/pools/%1/push", Имя),
			ПостроитьOspxДанные("wipe-pkg", "1.0.0"), "wipe-pkg-1.0.0.ospx", ТокенRoot).КодСостояния,
		"в пул опубликована версия").Равно(201);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/grants", Имя),
			"{""тип_субъекта"":""пользователь"",""субъект"":""alice"",""роль"":""мейнтейнер""}",
			ТокенRoot).КодСостояния,
		"на пул выдана роль").Равно(201);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/upstreams", Имя),
			СтрШаблон("{""url"":""%1""}", АдресАпстрима),
			ТокенRoot).КодСостояния,
		"пулу задан апстрим").Равно(201);

	Снос = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", ТокенRoot);
	Ожидаем.Что(Снос.КодСостояния, "админ хаба сносит пул → 200: " + Клиент.Тело(Снос)).Равно(200);

	Итог = Клиент.ТелоJSON(Снос);
	Ожидаем.Что(Итог.Получить("deleted"), "ответ говорит, что пул удалён").ЭтоИстина();
	Ожидаем.Что(Строка(Итог.Получить("pool")), "и называет снесённый пул").Равно(Имя);

	Унесено = Итог.Получить("removed");
	Ожидаем.Что(Унесено.Получить("packages"), "унесён пакет").Равно(1);
	Ожидаем.Что(Унесено.Получить("artifacts") > 0, "и файлы артефактов").ЭтоИстина();
	Ожидаем.Что(Унесено.Получить("grants") > 0, "и выданные права").ЭтоИстина();
	Ожидаем.Что(Унесено.Получить("upstreams"), "и апстрим").Равно(1);

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"пула больше нет → 404").Равно(404);

	// имя свободно: тот же ввод, что и в начале, снова даёт 201
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя)).КодСостояния,
		"имя после удаления свободно").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном(СтрШаблон("/api/v1/pools/%1/packages", Имя), ТокенRoot))
			.Получить("items").Количество(),
		"новый пул того же имени начинается пустым").Равно(0);
	Ожидаем.Что(СтрНайти(ПраваПулаСтрокой(Имя), "alice"),
		"и прав снесённого пула в нём нет").Равно(0);
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном(СтрШаблон("/api/v1/pools/%1/upstreams", Имя), ТокенRoot))
			.Получить("total"),
		"и апстримов").Равно(0);

	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", ТокенRoot);

КонецПроцедуры

// Кто угодно пул не сносит, а основной пул хаба не сносит никто: адрес /download
// обслуживается по контракту opm, и отказ говорит, что делать.
&Тест
Процедура УдалениеПулаAPIОтбиваетАнонимаЧужогоИОсновной() Экспорт

	Имя = УникальноеИмяПула("guard");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя)).КодСостояния,
		"подопытный пул заведён").Равно(201);

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", "").КодСостояния,
		"аноним не сносит пул → 401").Равно(401);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", ТокенBob).КодСостояния,
		"посторонний видит пул, но права удаления уровня хаба не имеет → 403").Равно(403);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", ТокенOwner).КодСостояния,
		"владелец чужого пула — тоже → 403").Равно(403);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"после всех отказов пул на месте").Равно(200);

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя + "-нет-такого", "", ТокенRoot).КодСостояния,
		"несуществующий пул → 404").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/" + Имя, "{}", ТокенRoot).КодСостояния,
		"метод не из списка → 405").Равно(405);

	Основной = ИмяОсновногоПула();
	Отказ = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Основной, "", ТокенRoot);
	Ожидаем.Что(Отказ.КодСостояния, "основной пул хаба не удаляется → 422").Равно(422);
	ПроверитьФорматОшибки(Отказ, "pool_not_deletable");
	Ожидаем.Что(Клиент.Тело(Отказ), "отказ называет причину").Содержит("/download");
	Ожидаем.Что(Клиент.Тело(Отказ), "и советует, что делать").Содержит("Назначьте основным другой пул");
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Основной, ТокенRoot).КодСостояния,
		"основной пул на месте").Равно(200);

	// КОНТРОЛЬ: та же дверь тем же токеном на обычном пуле работает
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", ТокенRoot).КодСостояния,
		"обычный пул админ хаба сносит → 200").Равно(200);

КонецПроцедуры

// Удаление — жизненный цикл пула, а не работа внутри него: ключ, привязанный к пулу,
// им не распоряжается, как не распоряжается созданием пула и назначением основного.
&Тест
Процедура ПривязанныйКПулуКлючПулНеУдаляет() Экспорт

	Имя = УникальноеИмяПула("bound");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя)).КодСостояния,
		"пул заведён").Равно(201);
	ИдПула = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot)).Получить("pool").Получить("id");

	Привязанный = ВыпуститьPATСоСкоупом(КукаRoot, "read,write", ИдПула);
	Отказ = Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", Привязанный);
	Ожидаем.Что(Отказ.КодСостояния, "ключ своего же пула его не сносит → 403").Равно(403);
	ПроверитьФорматОшибки(Отказ, "token_pool_mismatch");
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"пул на месте").Равно(200);

	// КОНТРОЛЬ: непривязанный ключ того же человека сносит — дело в привязке, а не в правах
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", ТокенRoot).КодСостояния,
		"ключ уровня хаба сносит → 200").Равно(200);

КонецПроцедуры

// Вторая дверь — опасная зона дома «Пул». Удаление начинается только после эха имени,
// а увести с адреса, которого больше нет, обязан сам хаб.
&Тест
Процедура УдалениеПулаФормойТребуетЭхаИУводитВКабинет() Экспорт

	Имя = УникальноеИмяПула("zone");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя)).КодСостояния,
		"пул под форму заведён").Равно(201);

	Адрес = СтрШаблон("/%1/settings/danger", Имя);
	Экран = Клиент.Тело(Клиент.GETСКукой(Адрес, КукаRoot));
	Ожидаем.Что(СтрНайти(Экран, "name=""подтверждение""") > 0,
		"опасная зона просит подтверждение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Экран, "value=""пул-удалить""") > 0,
		"и объявляет операцию явно").ЭтоИстина();

	// форма без объявленной операции пул не сносит, даже когда эхо набрано верно:
	// раздел принимает POST, и «просто отправленная» страница удалением быть не должна
	БезОперации = Новый Соответствие();
	БезОперации.Вставить("_csrf", CSRFRoot);
	БезОперации.Вставить("подтверждение", Имя);
	Ожидаем.Что(Клиент.POSTФормы(Адрес, БезОперации, КукаRoot).КодСостояния,
		"POST без операции пул не удаляет → 400").Равно(400);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"пул после формы без операции жив").Равно(200);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", CSRFRoot);
	Поля.Вставить("операция", "пул-удалить");

	БезЭха = Клиент.POSTФормы(Адрес, Поля, КукаRoot);
	Ожидаем.Что(БезЭха.КодСостояния, "POST без эха пул не удаляет → 400").Равно(400);
	Ожидаем.Что(Клиент.Тело(БезЭха), "и говорит, чего ждали").Содержит("Повторите имя пула");
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"пул после отказа на месте").Равно(200);

	Поля.Вставить("подтверждение", Имя + "-не-он");
	Ожидаем.Что(Клиент.POSTФормы(Адрес, Поля, КукаRoot).КодСостояния,
		"чужое имя в подтверждении пул не удаляет → 400").Равно(400);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"и пул по-прежнему жив").Равно(200);

	Поля.Вставить("подтверждение", Имя);
	Удаление = Клиент.POSTФормыБезПереходов(Адрес, Поля, Клиент.СтрокаКукиСессии(КукаRoot));
	Ожидаем.Что(Удаление.КодСостояния >= 300 И Удаление.КодСостояния < 400,
		"эхо совпало — пул удалён, ответ уводит редиректом").ЭтоИстина();

	Куда = Клиент.ЗаголовокОтвета(Удаление, "Location");
	Ожидаем.Что(Куда, "уводит в личное пространство, а не в снесённый пул").Равно("/me");
	Ожидаем.Что(Клиент.GETСКукой(Куда, КукаRoot).КодСостояния, "дорога назад живая").Равно(200);

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"пула больше нет → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСКукой(Адрес, КукаRoot).КодСостояния,
		"и его раздел настроек тоже").Равно(404);

	// след в журнале аудита: кто снёс, что снёс и сколько унёс. Журнал отбирается по типу
	// события — иначе числа искались бы по всей странице и совпали бы с чужой записью
	Журнал = Клиент.Тело(Клиент.GETСКукой("/hub/settings/audit?type="
		+ КодироватьСтроку("пул.удалён", СпособКодированияСтроки.URLEncoding), КукаRoot));
	Ожидаем.Что(СтрНайти(Журнал, "<td>root</td><td>пул.удалён</td>") > 0,
		"журнал назвал автора и действие").ЭтоИстина();
	Ожидаем.Что(Журнал, "и сам пул").Содержит("пул/" + Имя);
	// числа уборки: запись отвечает на «сколько унесли», а не только на «унесли»
	Ожидаем.Что(Журнал, "в деталях записи есть число пакетов").Содержит("Пакетов");
	Ожидаем.Что(Журнал, "и всего снятых строк").Содержит("Строк");

КонецПроцедуры

// Форма опасной зоны показывается не всякому, кто открыл раздел: право удаления —
// уровня ХАБА, а основной пул не удаляется вовсе.
&Тест
Процедура ОпаснаяЗонаБезПраваИНаОсновномПулеФормыНеПечатает() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Свой = Клиент.Тело(Клиент.GETСКукой("/owned/settings/danger", КукаOwner));
	Ожидаем.Что(СтрНайти(Свой, "name=""подтверждение"""),
		"владельцу пула формы удаления не показывают").Равно(0);
	Ожидаем.Что(Свой, "и объясняют, почему").Содержит("право уровня хаба");

	Основной = Клиент.Тело(Клиент.GETСКукой(СтрШаблон("/%1/settings/danger", ИмяОсновногоПула()), КукаRoot));
	Ожидаем.Что(СтрНайти(Основной, "name=""подтверждение"""),
		"у основного пула формы удаления нет и у админа хаба").Равно(0);
	Ожидаем.Что(Основной, "экран называет причину").Содержит("/download");
	Ожидаем.Что(Основной, "и совет").Содержит("Назначьте основным другой пул");

КонецПроцедуры

// Пул, который прямо сейчас наполняет зеркало, формы удаления тоже не показывает —
// и объясняет это словами домена, теми же, какими отвечает API.
// Окно ловится честно: состояние прогона читается ПОСЛЕ страницы, и «занят после»
// означает «был занят и в момент отрисовки» — заново прогон в этом тесте никто не ставит.
&Тест
Процедура ОпаснаяЗонаПулаПодПрогономЗеркалаФормыНеПечатает() Экспорт

	Имя = УникальноеИмяПула("busy");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя)).КодСостояния,
		"пул под зеркало заведён").Равно(201);

	Созд = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/mirrors", Имя),
		СтрШаблон("{""url"":""%1"",""режим"":""opm"",""интервал"":900}", АдресАпстрима), ТокенRoot);
	Ожидаем.Что(Созд.КодСостояния, "зеркало заведено").Равно(201);
	Ид = Формат(Клиент.ТелоJSON(Созд).Получить("mirror").Получить("id"), "ЧН=0; ЧГ=0");

	Адрес = СтрШаблон("/%1/settings/danger", Имя);
	Поймано = Ложь;

	// прогон против недоступного апстрима заканчивается быстро, поэтому окно берётся
	// несколькими заходами; ни один заход не «пропускает» проверку молча
	Для Заход = 1 По 5 Цикл

		Синк = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/mirrors/%2/sync", Имя, Ид), "{}", ТокенRoot);
		Если Синк.КодСостояния <> 202 Тогда
			Продолжить;
		КонецЕсли;

		Экран = Клиент.Тело(Клиент.GETСКукой(Адрес, КукаRoot));
		Если НЕ ЗеркалоВРаботе(Имя, Ид) Тогда
			Продолжить; // прогон успел закончиться — страница уже не про занятый пул
		КонецЕсли;

		Ожидаем.Что(СтрНайти(Экран, "name=""подтверждение"""),
			"у пула под прогоном зеркала формы удаления нет").Равно(0);
		Ожидаем.Что(Экран, "экран называет причину").Содержит("наполняет зеркало");
		Ожидаем.Что(Экран, "и советует, что делать").Содержит("Дождитесь конца прогона");
		Поймано = Истина;
		Прервать;

	КонецЦикла;

	Ожидаем.Что(Поймано, "за пять заходов занятое зеркало ни разу не наблюдалось").ЭтоИстина();

	// прогон кончился — препятствие ушло вместе с ним, и та же дверь пул сносит
	ДождатьсяПокояЗеркала(Имя, Ид);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/" + Имя, "", ТокенRoot).КодСостояния,
		"после прогона пул удаляется → 200").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область КвотаИВидимостьПула

&Тест
Процедура ПулЗаводитсяСКвотойЧерезAPI() Экспорт

	Созд = ЗавестиПулRoot("{""имя"":""quota-lab"",""квота_мб"":128}");
	Ожидаем.Что(Созд.КодСостояния, "пул с квотой заведён → 201").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Созд).Получить("pool").Получить("name")).Равно("quota-lab");
	Ожидаем.Что(КвотаПула("quota-lab"), "квота доехала из тела создания").Равно(128);

	Ожидаем.Что(ЗавестиПулRoot("{""имя"":""quota-free""}").КодСостояния,
		"пул без поля квоты → 201").Равно(201);
	Ожидаем.Что(КвотаПула("quota-free"), "квота не указана — как в хабе").Равно(-1);

	Плохая = ЗавестиПулRoot("{""имя"":""quota-bad"",""квота_мб"":""5oo""}");
	Ожидаем.Что(Плохая.КодСостояния, "нечисловая квота при создании → 400").Равно(400);
	ПроверитьФорматОшибки(Плохая, "invalid_quota");
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/quota-bad", ТокенRoot).КодСостояния,
		"пул с непринятой квотой не заведён вовсе → 404").Равно(404);

	Сверх = ЗавестиПулRoot("{""имя"":""quota-huge"",""quota_mb"":1000000000001}");
	Ожидаем.Что(Сверх.КодСостояния, "квота выше потолка при создании → 400").Равно(400);
	ПроверитьФорматОшибки(Сверх, "invalid_quota");

КонецПроцедуры

&Тест
Процедура КвотаПулаМеняетсяНастройкамиAPI() Экспорт

	Ожидаем.Что(ЗавестиПулRoot("{""имя"":""quota-patch"",""квота_мб"":64}").КодСостояния,
		"пул для смены квоты заведён").Равно(201);

	Смена = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/quota-patch/settings", "{""квота_мб"":256}", ТокенRoot);
	Ожидаем.Что(Смена.КодСостояния, "квота изменена → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Смена).Получить("settings").Получить("quota_mb")).Равно(256);

	Ноль = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/quota-patch/settings", "{""quota_mb"":0}", ТокенRoot);
	Ожидаем.Что(Клиент.ТелоJSON(Ноль).Получить("settings").Получить("quota_mb"),
		"англоязычное имя поля и ноль как «без ограничения»").Равно(0);

	// чужой приватный пул неотличим от несуществующего
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{""квота_мб"":1}", ТокенBob).КодСостояния,
		"посторонний не меняет квоту чужого приватного пула → 404").Равно(404);

	// видимый чужой пул существование не скрывает: не хватает именно прав
	Видимый = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/quota-patch/settings", "{""квота_мб"":1}", ТокенBob);
	Ожидаем.Что(Видимый.КодСостояния, "видимый чужой пул без прав администрирования → 403").Равно(403);
	ПроверитьФорматОшибки(Видимый, "forbidden");

	Ожидаем.Что(КвотаПула("quota-patch"), "отказы квоту не тронули").Равно(0);

КонецПроцедуры

&Тест
Процедура ВладелецПулаКвотуЧерезAPIНеМеняетИНеЗадаётПриСоздании() Экспорт

	// ДЕФЕКТ ПРАВ: администрирование пула давало право менять его квоту, а создание пула
	// позволяло выставить её себе сразу. Квота — предел, назначаемый хабом.
	Ожидаем.Что(КвотаПула("owned"), "исходная квота пула владельца — как в хабе").Равно(-1);

	Смена = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{""квота_мб"":4096}", ТокенOwner);
	Ожидаем.Что(Смена.КодСостояния, "владелец пула квоту не меняет → 403").Равно(403);
	ПроверитьФорматОшибки(Смена, "quota_forbidden");
	Ожидаем.Что(КвотаПула("owned"), "и в базе квота не изменилась").Равно(-1);

	// прочие настройки пула владелец по-прежнему меняет: сужено ровно право на квоту
	Прочее = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{""публикация"":false}", ТокенOwner);
	Ожидаем.Что(Прочее.КодСостояния, "публикацию владелец переключает → 200").Равно(200);
	Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/owned/settings", "{""публикация"":true}", ТокенOwner);

	// второй вход — создание пула с квотой; на этом хабе пулы заводит только админ,
	// поэтому здесь виден внешний контур, а сам гейт квоты проверен в КвотаПула_Тесты
	СоЗначением = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools", "{""имя"":""quota-self"",""квота_мб"":9999}", ТокенOwner);
	Ожидаем.Что(СоЗначением.КодСостояния, "не-админ пул с квотой не заводит → 403").Равно(403);
	Ожидаем.Что(НастройкиПулаНеНайдены("quota-self"), "и пул не появился").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФормаИAPIСудятКвотуОдинаково() Экспорт

	// потолок квоты и её проверка живут в СервисПулов, поэтому дом настроек пула
	// и PATCH обязаны отвечать на один и тот же ввод одинаково
	Ожидаем.Что(ЗавестиПулRoot("{""имя"":""quota-same"",""квота_мб"":128}").КодСостояния,
		"пул для сверки заведён").Равно(201);

	Для Каждого Плохое Из СтрРазделить("5oo|-5|999999999999999999999|1000000000001| ", "|") Цикл

		ЧерезAPI = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/quota-same/settings",
			СтрШаблон("{""квота_мб"":""%1""}", Плохое), ТокенRoot);
		Ожидаем.Что(ЧерезAPI.КодСостояния,
			СтрШаблон("API отвергает квоту ""%1"" → 400", Плохое)).Равно(400);
		ПроверитьФорматОшибки(ЧерезAPI, "invalid_quota");

		ЧерезФорму = ПостФормыКвоты("quota-same", Плохое);
		Ожидаем.Что(ЧерезФорму.КодСостояния,
			СтрШаблон("форма отвергает квоту ""%1"" → 400", Плохое)).Равно(400);

	КонецЦикла;

	Ожидаем.Что(КвотаПула("quota-same"), "ни один отказ квоту не тронул").Равно(128);

	// ровно потолок принимают оба пути, и каждый действительно пишет своё значение
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/quota-same/settings",
		"{""квота_мб"":1000000000000}", ТокенRoot).КодСостояния,
		"API принимает ровно потолок → 200").Равно(200);
	Ожидаем.Что(КвотаПула("quota-same"), "API записал ровно потолок").Равно(1000000000000);

	Ожидаем.Что(ПостФормыКвоты("quota-same", "999999999999").КодСостояния < 400,
		"форма принимает квоту под потолком").ЭтоИстина();
	Ожидаем.Что(КвотаПула("quota-same"), "и форма записала своё значение").Равно(999999999999);

КонецПроцедуры

// «Как в хабе» пишется числом -1 — это ЗНАЧЕНИЕ ПО УМОЛЧАНИЮ колонки, и печатает его
// сама форма. Оба входа обязаны принимать собственное напечатанное значение: строгий
// разбор целого браковал ведущий минус, и пул, наследующий квоту хаба, нельзя было ни
// сохранить как есть, ни переключить ему видимость — тем же POST.
&Тест
Процедура МинусЕдиницуПринимаютИФормаИAPI() Экспорт

	Ожидаем.Что(ЗавестиПулRoot("{""имя"":""quota-inherit"",""квота_мб"":64}").КодСостояния,
		"пул для сверки «как в хабе» заведён").Равно(201);

	ЧерезФорму = ПостФормыКвоты("quota-inherit", "-1");
	Ожидаем.Что(ЧерезФорму.КодСостояния < 400,
		"форма принимает «как в хабе» (-1)").ЭтоИстина();
	Ожидаем.Что(КвотаПула("quota-inherit"), "и записывает именно -1").Равно(-1);

	Ожидаем.Что(ПостФормыКвоты("quota-inherit", "128").КодСостояния < 400,
		"КОНТРОЛЬ: своя квота записывается тем же путём").ЭтоИстина();

	ЧерезAPI = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/quota-inherit/settings", "{""квота_мб"":-1}", ТокенRoot);
	Ожидаем.Что(ЧерезAPI.КодСостояния, "PATCH принимает «как в хабе» → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(ЧерезAPI).Получить("settings").Получить("quota_mb"),
		"и отвечает документированным -1").Равно(-1);

	// строкой, как её присылает форма-клиент, — тот же ответ
	Строкой = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/quota-inherit/settings", "{""квота_мб"":""-1""}", ТокенRoot);
	Ожидаем.Что(Строкой.КодСостояния, "строковый -1 принимается так же").Равно(200);
	Ожидаем.Что(КвотаПула("quota-inherit"), "и в базе снова «как в хабе»").Равно(-1);

КонецПроцедуры

&Тест
Процедура ВидимостьПулаПереключаетсяЧерезAPI() Экспорт

	Ожидаем.Что(ЗавестиПулRoot("{""имя"":""vis-lab"",""видимость"":""public""}").КодСостояния,
		"публичный пул заведён").Равно(201);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/vis-lab", ТокенBob).КодСостояния,
		"публичный пул виден постороннему").Равно(200);

	Закрыт = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/vis-lab/settings", "{""видимость"":""private""}", ТокенRoot);
	Ожидаем.Что(Закрыт.КодСостояния, "видимость сменилась → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Закрыт).Получить("settings").Получить("visibility")).Равно("private");

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/vis-lab", ТокенBob).КодСостояния,
		"для постороннего пул исчез → 404").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/vis-lab/settings",
		"{""видимость"":""public""}", ТокенBob).КодСостояния,
		"и его настройки тоже → 404, а не 403").Равно(404);

	Открыт = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/vis-lab/settings", "{""visibility"":""public""}", ТокенRoot);
	Ожидаем.Что(Клиент.ТелоJSON(Открыт).Получить("settings").Получить("visibility"),
		"англоязычное имя поля работает так же").Равно("public");
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/vis-lab", ТокенBob).КодСостояния,
		"пул снова виден постороннему").Равно(200);

	Мусор = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/vis-lab/settings", "{""видимость"":""чепуха""}", ТокенRoot);
	Ожидаем.Что(Мусор.КодСостояния, "неизвестная видимость → 400").Равно(400);
	ПроверитьФорматОшибки(Мусор, "invalid_visibility");
	Ожидаем.Что(НастройкиПула("vis-lab").Получить("visibility"),
		"отказ видимость не тронул").Равно("public");

	// личное пространство приватным быть не может — это инвариант пула, а не ошибка ввода
	Ожидаем.Что(ЗавестиПулRoot("{""имя"":""vis-user"",""тип"":""user""}").КодСостояния,
		"личный пул заведён").Равно(201);
	Личный = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/vis-user/settings", "{""видимость"":""private""}", ТокенRoot);
	Ожидаем.Что(Личный.КодСостояния, "личный пул приватным не становится → 422").Равно(422);
	ПроверитьФорматОшибки(Личный, "invalid_visibility");

КонецПроцедуры

&Тест
Процедура НастройкиПулаПрименяютсяЦеликомЛибоНеПрименяютсяВовсе() Экспорт

	Ожидаем.Что(ЗавестиПулRoot("{""имя"":""set-lab"",""квота_мб"":10}").КодСостояния,
		"пул для настроек заведён").Равно(201);

	Всё = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/set-lab/settings",
		"{""квота_мб"":50,""видимость"":""private"",""публикация"":false}", ТокенRoot);
	Ожидаем.Что(Всё.КодСостояния, "три поля одним запросом → 200").Равно(200);
	Наст = Клиент.ТелоJSON(Всё).Получить("settings");
	Ожидаем.Что(Наст.Получить("quota_mb"), "квота применена").Равно(50);
	Ожидаем.Что(Наст.Получить("visibility"), "видимость применена").Равно("private");
	Ожидаем.Что(Наст.Получить("publish_allowed"), "публикация применена").ЭтоЛожь();

	// непринятая квота отменяет запрос целиком
	Отказ = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/set-lab/settings",
		"{""квота_мб"":""5oo"",""видимость"":""public"",""публикация"":true}", ТокенRoot);
	Ожидаем.Что(Отказ.КодСостояния, "непринятая квота → 400").Равно(400);

	После = НастройкиПула("set-lab");
	Ожидаем.Что(После.Получить("quota_mb"), "квота не изменена").Равно(50);
	Ожидаем.Что(После.Получить("visibility"), "видимость не изменена").Равно("private");
	Ожидаем.Что(После.Получить("publish_allowed"), "публикация не изменена").ЭтоЛожь();

	Пусто = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/set-lab/settings", "{}", ТокенRoot);
	Ожидаем.Что(Пусто.КодСостояния, "нечего менять → 400").Равно(400);
	ПроверитьФорматОшибки(Пусто, "no_changes");

КонецПроцедуры

#КонецОбласти

#Область ЕдиныйПутьИнтерфейсаИAPI

// Дверей две, механизм один. Пул, заведённый формой раздела «Пулы» дома «Хаб»,
// и пул, заведённый POST /api/v1/pools тем же человеком, обязаны получить ОДИНАКОВЫЕ
// права: заведёт API свой обход мимо службы — пул из API останется без мейнтейнера,
// и рассматривать заявки на публикацию в него станет некому, кроме админа хаба.
// Сверяется значение (кому и какая роль досталась), а не текст вызова: обойти
// сторожа переименованием метода нельзя.
&Тест
Процедура ФормаИAPIЗаводятПулСОдинаковымиПравами() Экспорт

	ИмяФормы = УникальноеИмяПула("unipath-form");
	ИмяAPI = УникальноеИмяПула("unipath-api");

	ЗавестиПулФормой(ИмяФормы);
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1""}", ИмяAPI)).КодСостояния,
		"API завёл пул").Равно(201);

	ПраваФормы = ПраваПулаСтрокой(ИмяФормы);
	Ожидаем.Что(ЗначениеЗаполнено(ПраваФормы),
		"КОНТРОЛЬ: пул из формы кому-то принадлежит").ЭтоИстина();

	Ожидаем.Что(ПраваПулаСтрокой(ИмяAPI),
		"права пула из API — те же, что у пула из формы").Равно(ПраваФормы);

КонецПроцедуры

// Тот же инвариант с другой стороны и без сравнения с формой: у пула, заведённого
// через API, есть кому им распоряжаться. Пустой список прав — это пул-сирота.
&Тест
Процедура ПулИзAPIНеОстаётсяБезМейнтейнера() Экспорт

	Имя = УникальноеИмяПула("unipath-owner");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1""}", Имя)).КодСостояния,
		"пул заведён через API").Равно(201);

	Гранты = ГрантыПула(Имя);
	Ожидаем.Что(Гранты.Количество() > 0, "у пула из API есть носитель прав").ЭтоИстина();

	Роль = "";
	Для Каждого Грант Из Гранты Цикл
		Если Строка(Грант.Получить("subject")) = "root" Тогда
			Роль = Строка(Грант.Получить("role"));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Роль, "создатель пула — его мейнтейнер").Равно("мейнтейнер");

КонецПроцедуры

// След в журнале от двери тоже не зависит: заведение пула — это ещё и выдача права,
// а право, выданное молча, восстановить по журналу нельзя (НФТ-ДОСТ-005). Оба пула
// обязаны быть названы записями «права.выданы».
&Тест
Процедура ЗаведениеПулаЛюбойДверьюВидноВЖурнале() Экспорт

	ИмяФормы = УникальноеИмяПула("unitrace-form");
	ИмяAPI = УникальноеИмяПула("unitrace-api");

	ЗавестиПулФормой(ИмяФормы);
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1""}", ИмяAPI)).КодСостояния,
		"пул через API заведён").Равно(201);

	Журнал = Клиент.Тело(Клиент.GETСКукой("/hub/settings/audit?type=" + КодироватьСтроку("права.выданы",
		СпособКодированияСтроки.URLEncoding), КукаRoot));

	Ожидаем.Что(СтрНайти(Журнал, ИмяФормы) > 0,
		"КОНТРОЛЬ: пул из формы назван в журнале выдачи прав").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, ИмяAPI) > 0,
		"пул из API назван в журнале ровно так же").ЭтоИстина();

КонецПроцедуры

// Назначение основного пула хаба — вторая операция, у которой две двери. Через API
// оно обязано и состояться, и назвать инициатора: пойдёт контроллер мимо службы —
// в журнале останется система вместо логина.
&Тест
Процедура НазначениеОсновногоПулаЧерезAPIНазываетИнициатора() Экспорт

	Прежний = ИмяОсновногоПула();
	Ожидаем.Что(ЗначениеЗаполнено(Прежний), "КОНТРОЛЬ: у хаба есть основной пул").ЭтоИстина();

	Имя = УникальноеИмяПула("unidefault");
	Ожидаем.Что(ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя)).КодСостояния,
		"пул под назначение заведён").Равно(201);

	Попытка

		Ответ = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/default", Имя), "{}", ТокенRoot);
		Ожидаем.Что(Ответ.КодСостояния, "API назначил основной пул → 200").Равно(200);
		Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("pool").Получить("default"),
			"и отвечает признаком основного").ЭтоИстина();
		Ожидаем.Что(ИмяОсновногоПула(), "основным стал именно он").Равно(Имя);

		Журнал = Клиент.Тело(Клиент.GETСКукой("/hub/settings/audit?type="
			+ КодироватьСтроку("пул.основной.назначен", СпособКодированияСтроки.URLEncoding)
			+ "&who=root", КукаRoot));
		Ожидаем.Что(СтрНайти(Журнал, Имя) > 0,
			"назначение через API записано на инициатора, а не на систему").ЭтоИстина();

	Исключение
		ВернутьОсновнойПул(Прежний);
		ВызватьИсключение;
	КонецПопытки;

	ВернутьОсновнойПул(Прежний);

КонецПроцедуры

#КонецОбласти

#Область ЗаголовкиЧувствительныхСтраниц

// Секрет из адреса не переживает страницу. Экран токенов кабинета показывает секрет
// ключа ровно один раз — ответ не имеет права осесть ни в браузере, ни в промежуточном
// кэше, а адрес не имеет права уехать во внешний сайт заголовком перехода.
&Тест
Процедура ПриватнаяСтраницаНеОстаётсяУЧужойСтороны() Экспорт

	Ответ = Клиент.GETСКукой("/me/settings/tokens", КукаRoot);
	Ожидаем.Что(Ответ.КодСостояния, "КОНТРОЛЬ: экран ключей открыт").Равно(200);

	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Ответ, "Cache-Control")),
		"страница с секретом не кэшируется").Содержит("no-store");
	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Ответ, "Referrer-Policy")),
		"адрес страницы наружу не уходит").Равно("no-referrer");

	// отказ той же двери закрыт так же: 403 печатает ровно то, чего не увидел проситель
	Отказ = Клиент.GETСКукой("/hub/settings/users", Клиент.Войти("alice", "AlicePassw0rd"));
	Ожидаем.Что(Отказ.КодСостояния, "КОНТРОЛЬ: не админу настройки хаба закрыты").Равно(403);
	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Отказ, "Cache-Control")),
		"страница отказа тоже не кэшируется").Содержит("no-store");

КонецПроцедуры

// Правило действует на ВСЕХ страницах, включая те, что отдаются анониму: одноразовая
// ссылка и код входа CLI живут в адресе, и заголовок перехода отдал бы их чужому сайту.
// Здесь стережётся то, что видит браузер, — объявление в самой странице.
&Тест
Процедура ЛюбаяСтраницаЗапрещаетОтдаватьСвойАдресНаружу() Экспорт

	Для Каждого Адрес Из СтрРазделить("/login|/|/hub/settings/pools", "|") Цикл
		Разметка = Клиент.Тело(?(Адрес = "/hub/settings/pools", Клиент.GETСКукой(Адрес, КукаRoot), Клиент.GET(Адрес)));
		Ожидаем.Что(СтрНайти(Разметка, "<meta name=""referrer"" content=""no-referrer"">") > 0,
			СтрШаблон("страница %1 запрещает отдавать свой адрес наружу", Адрес)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Зеркала

&Тест
Процедура ЗеркалаПулаЖивутПолнымЦикломУАдминистратораПула() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/pools/secret/mirrors").КодСостояния,
		"аноним: чужой приватный пул → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/secret/mirrors", ТокенBob).КодСостояния,
		"посторонний: чужой приватный пул → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/mirrors", ТокенBob).КодСостояния,
		"видимый пул без администрирования → 403").Равно(403);

	Тело_ = СтрШаблон("{""url"":""%1"",""режим"":""opm"",""интервал"":900}", АдресАпстрима);

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/secret/mirrors", Тело_, ТокенBob).КодСостояния,
		"посторонний не заводит зеркало → 404").Равно(404);

	// Выключенная публикация закрывает пул ДЛЯ ЛЮДЕЙ, а не для хаба: зеркало по API
	// заводится, а push тем же владельцем в тот же пул отбивается 409.
	Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/secret/settings", "{""публикация"":false}", ТокенOwner);
	Закрыт = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/secret/mirrors", Тело_, ТокенOwner);
	Ожидаем.Что(Закрыт.КодСостояния, "пул без публикации зеркало принимает → 201").Равно(201);
	PushВЗакрытый = Публикация("/api/v1/pools/secret/push",
		ПостроитьOspxДанные("closed-pkg", "1.0.0"), "closed-pkg-1.0.0.ospx", ТокенOwner);
	Ожидаем.Что(PushВЗакрытый.КодСостояния,
		"а человеку push в тот же пул по-прежнему закрыт → 409").Равно(409);
	ИдЗакрытого = Формат(Клиент.ТелоJSON(Закрыт).Получить("mirror").Получить("id"), "ЧН=0; ЧГ=0");
	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/secret/mirrors/" + ИдЗакрытого, "", ТокенOwner);
	Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/secret/settings", "{""публикация"":true}", ТокенOwner);

	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/secret/mirrors", Тело_, ТокенOwner);
	Ожидаем.Что(Созд.КодСостояния, "владелец заводит зеркало → 201").Равно(201);
	Зеркало = Клиент.ТелоJSON(Созд).Получить("mirror");
	Ид = Формат(Зеркало.Получить("id"), "ЧН=0; ЧГ=0");
	Ожидаем.Что(Зеркало.Получить("upstream_url")).Равно(АдресАпстрима);
	Ожидаем.Что(Зеркало.Получить("mode")).Равно("opm");
	Ожидаем.Что(Зеркало.Получить("enabled"), "новое зеркало включено").ЭтоИстина();

	Адрес = "/api/v1/pools/secret/mirrors/" + Ид;

	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТокенBob).КодСостояния, "посторонний → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТокенOwner).КодСостояния, "карточка зеркала").Равно(200);

	// зеркало чужого пула по своему адресу не достаётся
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/mirrors/" + Ид, ТокенOwner).КодСостояния,
		"зеркало другого пула → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/secret/mirrors/999999", ТокенOwner).КодСостояния,
		"несуществующее зеркало → 404").Равно(404);

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{""включено"":false}", ТокенBob).КодСостояния,
		"посторонний не переключает зеркало → 404").Равно(404);

	Выкл = Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{""включено"":false}", ТокенOwner);
	Ожидаем.Что(Выкл.КодСостояния, "владелец выключает зеркало → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Выкл).Получить("mirror").Получить("enabled"), "зеркало выключено").ЭтоЛожь();

	БезПоля = Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{}", ТокенOwner);
	Ожидаем.Что(БезПоля.КодСостояния, "нечего менять → 400").Равно(400);

	Вкл = Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{""enabled"":true}", ТокенOwner);
	Ожидаем.Что(Клиент.ТелоJSON(Вкл).Получить("mirror").Получить("enabled"), "зеркало включено").ЭтоИстина();

	// синхронизация по требованию: заявка ставится в очередь, ответ мгновенный, работу
	// ведёт фоновый рабочий — HTTP-поток цикл репликации не ждёт
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", Адрес + "/sync", "", ТокенBob).КодСостояния,
		"посторонний не синхронизирует → 404").Равно(404);
	Синк = Клиент.ЗапросJSONСТокеном("POST", Адрес + "/sync", "", ТокенOwner);
	Ожидаем.Что(Синк.КодСостояния, "заявка на синхронизацию принята → 202").Равно(202);
	Сводка = Клиент.ТелоJSON(Синк).Получить("sync");
	Ожидаем.Что(Сводка.Получить("accepted"), "заявка принята").ЭтоИстина();
	Состояние = Строка(Сводка.Получить("state"));
	Ожидаем.Что(Состояние = "поставлено" ИЛИ Состояние = "идёт",
		"зеркало ждёт рабочего либо уже им взято, а не «простаивает»: " + Состояние).ЭтоИстина();
	// Карточка в ответе на сам запрос обязана нести УЖЕ поставленный прогон: состояние
	// перечитывается службой, а не берётся с записи, прочитанной до заявки. Инициатор
	// пишется только этим путём — по нему и судим, что заявка доехала до записи
	Прогон = Клиент.ТелоJSON(Синк).Получить("mirror").Получить("run");
	СостояниеПрогона = Строка(Прогон.Получить("state"));
	Ожидаем.Что(СостояниеПрогона = "поставлено" ИЛИ СостояниеПрогона = "идёт"
			ИЛИ СостояниеПрогона = "завершён" ИЛИ СостояниеПрогона = "ошибка",
		"прогон в карточке уже не простаивает: " + СостояниеПрогона).ЭтоИстина();
	Ожидаем.Что(Прогон.Получить("started_by"), "инициатор прогона — логин нажавшего")
		.Равно("owner1");
	Ожидаем.Что(Прогон.Получить("downloaded") >= 0, "счётчики прогона видны по API").ЭтоИстина();

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", Адрес, "", ТокенBob).КодСостояния,
		"посторонний не удаляет зеркало → 404").Равно(404);

	Удалено = Клиент.ЗапросJSONСТокеном("DELETE", Адрес, "", ТокенOwner);
	Ожидаем.Что(Удалено.КодСостояния, "владелец удаляет зеркало → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Удалено).Получить("deleted"), "зеркало удалено").ЭтоИстина();
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/secret/mirrors", ТокенOwner)).Получить("total"),
		"список зеркал опустел").Равно(0);

КонецПроцедуры

// ИСТ-АПСТ-006: правило секрета одно для источника пула и для зеркала — API принимает
// токен, но обратно его не печатает ни в одном ответе.
&Тест
Процедура ТокенЗеркалаЗадаётсяAPIНоОбратноНеВыдаётся() Экспорт

	Тело_ = СтрШаблон("{""url"":""%1"",""режим"":""opm"",""интервал"":900,""token"":""sekret-42""}",
		АдресАпстрима);
	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/secret/mirrors", Тело_, ТокенOwner);

	Ожидаем.Что(Созд.КодСостояния, "зеркало с токеном заведено → 201").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Созд).Получить("mirror").Получить("token_set"),
		"признак «токен задан» виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Созд), "sekret-42"),
		"значения токена в ответе нет: " + Клиент.Тело(Созд)).Равно(0);

	Ид = Формат(Клиент.ТелоJSON(Созд).Получить("mirror").Получить("id"), "ЧН=0; ЧГ=0");
	Адрес = "/api/v1/pools/secret/mirrors/" + Ид;

	Карточка = Клиент.GETСТокеном(Адрес, ТокенOwner);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Карточка), "sekret-42"), "и в карточке его тоже нет").Равно(0);

	// правка прочих полей секрет не стирает
	Выкл = Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{""включено"":false}", ТокенOwner);
	Ожидаем.Что(Клиент.ТелоJSON(Выкл).Получить("mirror").Получить("token_set"),
		"переключение зеркала токен сохраняет").ЭтоИстина();

	Снятие = Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{""token_remove"":true}", ТокенOwner);
	Ожидаем.Что(Клиент.ТелоJSON(Снятие).Получить("mirror").Получить("token_set"),
		"снятие возвращает анонимное чтение").ЭтоЛожь();

	Негодный = Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{""token"":""плохой токен""}", ТокенOwner);
	Ожидаем.Что(Негодный.КодСостояния, "токен с пробелом заголовком не едет → 422").Равно(422);
	ПроверитьФорматОшибки(Негодный, "invalid_mirror");

	Клиент.ЗапросJSONСТокеном("DELETE", Адрес, "", ТокенOwner);

КонецПроцедуры

#КонецОбласти

#Область РамкиКлючаИОписание

&Тест
Процедура КлючБезСкоупаЗаписиНеАдминистрирует() Экспорт

	// PAT только на чтение: мутации администрирования ему недоступны
	ТолькоЧтение = ВыпуститьPATСоСкоупом(КукаRoot, "read");

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/groups", "{""имя"":""scope-team""}", ТолькоЧтение).КодСостояния,
		"ключ без write не создаёт группу → 403").Равно(403);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams",
		СтрШаблон("{""url"":""%1""}", АдресАпстрима),
		ТолькоЧтение).КодСостояния, "ключ без write не заводит апстрим → 403").Равно(403);

	БезЗаписи = Клиент.ЗапросJSONСТокеном("PATCH", "/api/v1/pools/public/settings",
		"{""квота_мб"":7,""видимость"":""private""}", ТолькоЧтение);
	Ожидаем.Что(БезЗаписи.КодСостояния, "ключ без write не меняет настройки пула → 403").Равно(403);
	ПроверитьФорматОшибки(БезЗаписи, "token_scope");
	Ожидаем.Что(НастройкиПула("public").Получить("visibility"),
		"отбитая мутация видимость не тронула").Равно("public");

	// чтение тем же ключом работает
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/groups", ТолькоЧтение).КодСостояния,
		"ключ на чтение читает список групп").Равно(200);

КонецПроцедуры

&Тест
Процедура ОписаниеAPIПеречисляетАдминистративныеАдреса() Экспорт

	Пути = Клиент.ТелоJSON(Клиент.GET("/api/v1/openapi.json")).Получить("paths");

	Ожидаемые = СтрРазделить("/groups,/groups/{group},/groups/{group}/members,"
		+ "/groups/{group}/members/{login},/groups/{group}/grants,/groups/{group}/oidc-mappings,"
		+ "/oidc-mappings,/users/{login}/grants,/hub/settings,/hub/settings/{key},"
		+ "/pools/{pool}/grants,/pools/{pool}/upstreams,"
		+ "/pools/{pool}/settings,/pools/{pool}/mirrors,/pools/{pool}/mirrors/{id},"
		+ "/pools/{pool}/mirrors/{id}/sync,/inbox,/pools/{pool}/inbox,"
		+ "/pools/{pool}/inbox/{id}/approve,/pools/{pool}/inbox/{id}/reject,"
		+ "/pools/{pool}/packages/{name}/trusted-workflows,"
		+ "/pools/{pool}/packages/{name}/trusted-workflows/{id},"
		+ "/pools/{pool}/packages/{name}/trusted-workflows/{id}/delete,"
		+ "/webhook-meta,/webhooks,/webhooks/{id},/pools/{pool}/webhooks,"
		+ "/pools/{pool}/webhooks/{id},/pools/{pool}/packages/{name}/webhooks,"
		+ "/pools/{pool}/packages/{name}/webhooks/{id}", ",");

	Для Каждого Путь Из Ожидаемые Цикл
		Ожидаем.Что(Пути.Получить(Путь) <> Неопределено,
			СтрШаблон("путь %1 описан", Путь)).ЭтоИстина();
	КонецЦикла;

	// глаголы, которых ПутьМетоды не знает, дописаны отдельно — проверяем именно их
	Ожидаем.Что(Пути.Получить("/pools/{pool}/upstreams").Получить("delete") <> Неопределено,
		"у апстримов описан DELETE").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/pools/{pool}/grants").Получить("delete") <> Неопределено,
		"у грантов описан DELETE").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/pools/{pool}").Получить("delete") <> Неопределено,
		"у пула описан DELETE").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/pools/{pool}/mirrors/{id}").Получить("patch") <> Неопределено,
		"у зеркала описан PATCH").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/pools/{pool}/packages/{name}/trusted-workflows/{id}")
			.Получить("delete") <> Неопределено,
		"у доверенного конвейера описан DELETE").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/pools/{pool}/webhooks/{id}").Получить("delete") <> Неопределено,
		"у подписки пула описан DELETE").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/webhooks/{id}").Получить("patch") <> Неопределено,
		"у подписки хаба описан PATCH").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/hub/settings/{key}").Получить("delete") <> Неопределено,
		"у настройки хаба описан DELETE").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/hub/settings/{key}").Получить("patch") <> Неопределено,
		"и PATCH").ЭтоИстина();

	// коды успеха описаны ЧЕСТНО: POST-действие ничего не создаёт и отвечает 200,
	// а заведение отвечает и 201, и 200 (идемпотентный повтор)
	ОтветыДействия = Пути.Получить("/pools/{pool}/packages/{name}/trusted-workflows/{id}/delete")
		.Получить("post").Получить("responses");
	ПроверитьОписаниеУспеха(ОтветыДействия, "200", "POST .../delete");
	Ожидаем.Что(ОтветыДействия.Получить("201"),
		"и не обещан 201, которого он не отдаёт").Равно(Неопределено);

	// синхронизация зеркала асинхронна: описание обязано обещать тот же 202, что отдаёт хаб,
	// и не обещать 200 — по нему клиент ждал бы готового итога синка
	ОтветыСинка = Пути.Получить("/pools/{pool}/mirrors/{id}/sync").Получить("post").Получить("responses");
	ПроверитьОписаниеУспеха(ОтветыСинка, "202", "POST .../mirrors/{id}/sync");
	Ожидаем.Что(ОтветыСинка.Получить("200"),
		"и не обещан 200: синхронного итога больше нет").Равно(Неопределено);

	ОтветыЗаведения = Пути.Получить("/pools/{pool}/packages/{name}/trusted-workflows")
		.Получить("post").Получить("responses");
	ПроверитьОписаниеУспеха(ОтветыЗаведения, "201", "заведение доверия");
	ПроверитьОписаниеУспеха(ОтветыЗаведения, "200", "идемпотентный повтор заведения");

	// поля мутаций названы в описании: иначе клиент их не найдёт
	Настройки = Строка(Пути.Получить("/pools/{pool}/settings").Получить("patch").Получить("summary"));
	Ожидаем.Что(СтрНайти(Настройки, "квота") > 0, "в PATCH настроек названа квота").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Настройки, "видимость") > 0, "в PATCH настроек названа видимость").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Пути.Получить("/pools").Получить("post").Получить("summary")), "квота") > 0,
		"в создании пула названа квота").ЭтоИстина();

	Отказ = Строка(Пути.Получить("/pools/{pool}/inbox/{id}/reject").Получить("post").Получить("summary"));
	Ожидаем.Что(СтрНайти(Отказ, "причина") > 0, "в отклонении заявки названо поле причины").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОчередьЗаявок

// Сквозной путь очереди по JSON API: push без прав → 202, мейнтейнер видит заявку,
// одобряет — версия опубликована, заявитель стал мейнтейнером пакета.
&Тест
Процедура ОдобрениеЗаявкиЧерезAPIПубликуетВерсиюИВыдаётГрант() Экспорт

	ИмяПула = ЗавестиПулДляЗаявок();
	ИмяПакета = "inbox-appr";

	Ответ = ЗаявкаОтBob(ИмяПула, ИмяПакета, "1.0.0");
	Ожидаем.Что(Ответ.КодСостояния, "push без прав в видимый пул → 202 (заявка)").Равно(202);

	Список = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + ИмяПула + "/inbox", ТокенRoot));
	Ожидаем.Что(Список.Получить("total"), "мейнтейнер видит одну заявку").Равно(1);

	Заявка = Список.Получить("items")[0];
	Ожидаем.Что(Заявка.Получить("package"), "имя пакета в карточке").Равно(ИмяПакета);
	Ожидаем.Что(Заявка.Получить("applicant"), "заявитель назван логином").Равно("bob");
	Ожидаем.Что(ЗначениеЗаполнено(Заявка.Получить("sha256")), "sha256 отдан").ЭтоИстина();
	Ожидаем.Что(Заявка.Получить("size") > 0, "размер артефакта отдан").ЭтоИстина();

	Номер = Строка(Формат(Заявка.Получить("id"), "ЧГ=0; ЧН=0"));
	Решение = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/inbox/%2/approve", ИмяПула, Номер), "", ТокенRoot);
	Ожидаем.Что(Решение.КодСостояния,
		"одобрение прошло: " + Клиент.Тело(Решение)).Равно(200);

	// имена локальных переменных нарочно длинные: «Версии» отбирает глобальное имя
	// у библиотеки и падает «Property is not writable» уже в рантайме
	СписокВерсий = Клиент.ТелоJSON(Клиент.GETСТокеном(
		СтрШаблон("/api/v1/pools/%1/packages/%2/versions", ИмяПула, ИмяПакета),
		ТокенRoot)).Получить("versions");
	Ожидаем.Что(СписокВерсий.Количество(), "версия опубликована одобрением").Равно(1);
	Ожидаем.Что(Строка(СписокВерсий[0].Получить("version")), "именно заявленная версия").Равно("1.0.0");

	СписокГрантов = Клиент.ТелоJSON(Клиент.GETСТокеном(
		СтрШаблон("/api/v1/pools/%1/grants?package=%2", ИмяПула, ИмяПакета), ТокенRoot)).Получить("items");
	Ожидаем.Что(ГрантЕстьУ(СписокГрантов, "bob"), "заявителю выдан грант на пакет").ЭтоИстина();

	// очередь опустела: решённая заявка в список ожидающих больше не попадает
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + ИмяПула + "/inbox", ТокенRoot)).Получить("total"),
		"решённая заявка ушла из очереди").Равно(0);

	// повторное решение по той же заявке — явный отказ, а не вторая публикация
	Второе = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/inbox/%2/approve", ИмяПула, Номер), "", ТокенRoot);
	Ожидаем.Что(Второе.КодСостояния, "повторное одобрение решённой заявки → 409").Равно(409);
	ПроверитьФорматОшибки(Второе, "request_conflict");

КонецПроцедуры

// Отклонение освобождает имя и не оставляет мусора: ни пакета, ни грантов.
&Тест
Процедура ОтклонениеЗаявкиЧерезAPIОсвобождаетИмя() Экспорт

	ИмяПула = ЗавестиПулДляЗаявок();
	ИмяПакета = "inbox-rej";

	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, ИмяПакета, "1.0.0").КодСостояния, "заявка принята").Равно(202);
	Номер = НомерПервойЗаявки(ИмяПула);

	Решение = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/inbox/%2/reject", ИмяПула, Номер),
		"{""причина"":""лицензия не указана""}", ТокенRoot);
	Ожидаем.Что(Решение.КодСостояния, "отклонение прошло: " + Клиент.Тело(Решение)).Равно(200);

	Ожидаем.Что(Клиент.GETСТокеном(СтрШаблон("/api/v1/pools/%1/packages/%2", ИмяПула, ИмяПакета),
		ТокенRoot).КодСостояния, "пакет отклонением не заведён").Равно(404);
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + ИмяПула + "/inbox", ТокенRoot)).Получить("total"),
		"очередь пуста").Равно(0);

	// имя свободно: та же заявка подаётся заново и снова принимается
	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, ИмяПакета, "1.0.0").КодСостояния,
		"после отклонения имя снова свободно").Равно(202);

КонецПроцедуры

// Правило видимости: невидимый пул неотличим от несуществующего, видимый без роли — 403.
&Тест
Процедура ЗаявкиЗакрытыПравиломВидимостиПула() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/pools/public/inbox").КодСостояния, "аноним → 401").Равно(401);

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/secret/inbox", ТокенBob).КодСостояния,
		"чужой приватный пул неотличим от несуществующего → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/no-such-pool-at-all/inbox", ТокенBob).КодСостояния,
		"несуществующий пул → 404").Равно(404);

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/inbox", ТокенBob).КодСостояния,
		"видимый пул без роли мейнтейнера → 403").Равно(403);

	// и на мутациях порядок тот же
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/secret/inbox/1/approve", "", ТокенBob).КодСостояния,
		"одобрение в невидимом пуле → 404").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/inbox/1/reject", "", ТокенBob).КодСостояния,
		"отклонение без роли → 403").Равно(403);

КонецПроцедуры

// Номер заявки не адрес в памяти: чужой и несуществующий одинаково дают 404.
&Тест
Процедура ЧужойНомерЗаявкиДаёт404() Экспорт

	ИмяПула = ЗавестиПулДляЗаявок();
	Соседний = ЗавестиПулДляЗаявок();

	Ожидаем.Что(ЗаявкаОтBob(Соседний, "inbox-alien", "1.0.0").КодСостояния, "заявка принята").Равно(202);
	Номер = НомерПервойЗаявки(Соседний);

	// номер настоящий, но пул в адресе другой — подстановка не проходит
	Чужая = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/inbox/%2/approve", ИмяПула, Номер), "", ТокенRoot);
	Ожидаем.Что(Чужая.КодСостояния, "заявка соседнего пула по этому адресу не решается").Равно(404);
	ПроверитьФорматОшибки(Чужая, "request_not_found");

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/inbox/99999999/approve", ИмяПула), "",
		ТокенRoot).КодСостояния, "несуществующий номер → 404").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/inbox/не-число/approve", ИмяПула), "",
		ТокенRoot).КодСостояния, "нечисловой номер → 404, а не исключение").Равно(404);

	// заявка соседнего пула осталась нетронутой
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + Соседний + "/inbox", ТокенRoot)).Получить("total"),
		"чужая попытка ничего не решила").Равно(1);

КонецПроцедуры

// Сводка /inbox — отбор «где я вправе решать», а не список всего хаба.
&Тест
Процедура СводкаЗаявокОтбираетПулыПоПраву() Экспорт

	ИмяПула = ЗавестиПулДляЗаявок();
	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, "inbox-digest", "1.0.0").КодСостояния, "заявка принята").Равно(202);

	Ожидаем.Что(Клиент.GET("/api/v1/inbox").КодСостояния, "аноним сводки не получает → 401").Равно(401);

	Свои = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/inbox", ТокенRoot));
	Ожидаем.Что(СодержитПакет(Свои.Получить("items"), "inbox-digest"),
		"админ хаба видит заявку в сводке").ЭтоИстина();

	Чужие = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/inbox", ТокенBob));
	Ожидаем.Что(СодержитПакет(Чужие.Получить("items"), "inbox-digest"),
		"посторонний в сводке её не видит").ЭтоЛожь();

	// заявитель — не рассматривающий: своя заявка в сводку решений не попадает
	Ожидаем.Что(Чужие.Получить("total"), "у постороннего сводка пуста").Равно(0);

КонецПроцедуры

// Мутация сессией без CSRF не проходит — тот же гейт, что у соседних админских адресов.
&Тест
Процедура РешениеПоЗаявкеТребуетCSRF() Экспорт

	ИмяПула = ЗавестиПулДляЗаявок();
	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, "inbox-csrf", "1.0.0").КодСостояния, "заявка принята").Равно(202);
	Номер = НомерПервойЗаявки(ИмяПула);
	Путь = СтрШаблон("/api/v1/pools/%1/inbox/%2/approve", ИмяПула, Номер);

	Без = Клиент.ЗапросJSON("POST", Путь, "", Клиент.ЗаголовкиМутации(КукаRoot, ""));
	Ожидаем.Что(Без.КодСостояния, "сессия без CSRF → 403").Равно(403);
	ПроверитьФорматОшибки(Без, "csrf_failed");

	Ожидаем.Что(Клиент.ЗапросJSON("POST", Путь, "", Клиент.ЗаголовкиМутации(КукаRoot, CSRFRoot)).КодСостояния,
		"КОНТРОЛЬ: та же мутация с CSRF проходит").Равно(200);

КонецПроцедуры

// GET-only адреса и метод не из списка — 405 с Allow, а не тихий 404.
&Тест
Процедура НеверныйМетодНаЗаявкахДаёт405() Экспорт

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/inbox", "", ТокенRoot).КодСостояния,
		"DELETE на сводке → 405").Равно(405);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/inbox/1/approve", ТокенRoot).КодСостояния,
		"GET на одобрении → 405").Равно(405);

КонецПроцедуры

#КонецОбласти

#Область ДоверенныеКонвейеры

// Полный цикл у мейнтейнера пакета: заведение, список, идемпотентный повтор, отзыв.
&Тест
Процедура ДоверенныеКонвейерыПакетаЖивутПолнымЦиклом() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");

	Заведение = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("acme/cycle", "refs/heads/main"), ТокенOwner);
	Ожидаем.Что(Заведение.КодСостояния, "мейнтейнер пакета завёл доверие → 201").Равно(201);
	Запись = Клиент.ТелоJSON(Заведение).Получить("trusted_workflow");
	Ожидаем.Что(Строка(Запись.Получить("repository")), "репозиторий записан").Равно("acme/cycle");
	Ожидаем.Что(Строка(Запись.Получить("created_by")), "автор записи назван").Равно("owner1");

	Повтор = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("acme/cycle", "refs/heads/main"), ТокенOwner);
	Ожидаем.Что(Повтор.КодСостояния, "повтор той же записи идемпотентен → 200").Равно(200);

	Список = Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items");
	Ожидаем.Что(Список.Количество(), "запись в списке одна").Равно(1);

	Ид = Формат(Список[0].Получить("id"), "ЧГ=0; ЧН=0");
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/" + Ид, "", ТокенOwner).КодСостояния, "отзыв → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items").Количество(),
		"после отзыва записей нет").Равно(0);

КонецПроцедуры

// Порог — мейнтейнер ПАКЕТА. Райтер пула пакет меняет (публикует версии), а доверие
// не настраивает; автор опубликованной версии — тоже. Контроль рядом: тот же адрес
// админом хаба.
&Тест
Процедура ДовериеНижеПорогаМейнтейнераОтбивается() Экспорт

	Адрес = АдресДоверия("public", "alice-pkg");
	ТокенPub = ВыпуститьPAT(Клиент.Войти("pub", "PubPassw0rd"));

	Райтер = Клиент.GETСТокеном(Адрес, ТокенPub);
	Ожидаем.Что(Райтер.КодСостояния, "райтер пула доверие не читает → 403").Равно(403);
	ПроверитьФорматОшибки(Райтер, "forbidden");
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("steal/repo", "refs/heads/main"), ТокенPub).КодСостояния,
		"и не заводит → 403").Равно(403);

	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТокенAlice).КодСостояния,
		"автор версии без роли — тоже 403").Равно(403);

	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТокенRoot).КодСостояния,
		"КОНТРОЛЬ: тот же адрес админу хаба → 200").Равно(200);
	Ожидаем.Что(СодержитПоле(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенRoot)).Получить("items"),
			"repository", "steal/repo"),
		"КОНТРОЛЬ: отбитая мутация записи не создала").ЭтоЛожь();

КонецПроцедуры

// Чужой приватный пул неотличим от несуществующего — раньше любого разговора о правах.
&Тест
Процедура ДовериеЧужогоПриватногоПулаНеРаскрывается() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");

	Скрытый = Клиент.GETСТокеном(Адрес, ТокенBob);
	Ожидаем.Что(Скрытый.КодСостояния, "чужой приватный пул → 404").Равно(404);
	ПроверитьФорматОшибки(Скрытый, "pool_not_found");

	Ожидаем.Что(Клиент.GETСТокеном(АдресДоверия("secret", "нет-такого-пакета"), ТокенOwner).КодСостояния,
		"несуществующий пакет своего пула → 404").Равно(404);

	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТокенOwner).КодСостояния,
		"КОНТРОЛЬ: тот же адрес владельцу пула → 200").Равно(200);

КонецПроцедуры

// Рамки ключа: read-only PAT доверие не настраивает, хотя его владелец — мейнтейнер.
// Контроль рядом: тем же ключом список читается, а полным ключом того же человека —
// заводится.
&Тест
Процедура ReadOnlyКлючДовериеЧерезAPIНеНастраивает() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");
	ТолькоЧтение = ВыпуститьPATСоСкоупом(Клиент.Войти("owner1", "Owner1Passw0rd"), "read");

	Атака = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("acme/read-only", "refs/heads/main"), ТолькоЧтение);
	Ожидаем.Что(Атака.КодСостояния, "ключ без write доверие не настраивает → 403").Равно(403);
	ПроверитьФорматОшибки(Атака, "token_scope");

	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТолькоЧтение).КодСостояния,
		"КОНТРОЛЬ: тот же ключ список читает").Равно(200);
	Ожидаем.Что(СодержитПоле(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items"),
			"repository", "acme/read-only"),
		"запись не создана").ЭтоЛожь();

	Контроль = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("acme/read-only", "refs/heads/main"), ТокенOwner);
	Ожидаем.Что(Контроль.КодСостояния,
		"КОНТРОЛЬ: полный ключ того же человека заводит → 201").Равно(201);
	Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/"
		+ Формат(Клиент.ТелоJSON(Контроль).Получить("trusted_workflow").Получить("id"), "ЧГ=0; ЧН=0"), "",
		ТокенOwner);

КонецПроцедуры

// ЭКСПЛОЙТ: идентификатор чужой записи, названный в адресе СВОЕГО пакета. Принадлежность
// сверяется по сущности, а не по присланному номеру.
&Тест
Процедура ДовериеЧужогоПакетаПоИдентификаторуЧерезAPIНеСнимается() Экспорт

	АдресЧужого = АдресДоверия("secret", "secret-pkg");
	АдресСвоего = АдресДоверия("public", "alice-pkg");

	Чужая = Клиент.ТелоJSON(Клиент.ЗапросJSONСТокеном("POST", АдресЧужого, ТелоДоверия("victim/repo", "refs/heads/main"), ТокенOwner))
		.Получить("trusted_workflow");
	ИдЧужой = Формат(Чужая.Получить("id"), "ЧГ=0; ЧН=0");

	Своя = Клиент.ТелоJSON(Клиент.ЗапросJSONСТокеном("POST", АдресСвоего, ТелоДоверия("mine/repo", "refs/heads/main"), ТокенRoot))
		.Получить("trusted_workflow");
	ИдСвой = Формат(Своя.Получить("id"), "ЧГ=0; ЧН=0");

	Попытка

		Атака = Клиент.ЗапросJSONСТокеном("DELETE", АдресСвоего + "/" + ИдЧужой, "", ТокенRoot);
		Ожидаем.Что(Атака.КодСостояния, "чужая запись по идентификатору → 404").Равно(404);
		ПроверитьФорматОшибки(Атака, "trusted_workflow_not_found");
		Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном(АдресЧужого, ТокенOwner)).Получить("items").Количество(),
			"доверие чужого пакета на месте").Равно(1);

		Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", АдресСвоего + "/" + ИдСвой, "", ТокенRoot).КодСостояния,
			"КОНТРОЛЬ: свою запись тот же ключ снимает").Равно(200);

	Исключение
		Клиент.ЗапросJSONСТокеном("DELETE", АдресСвоего + "/" + ИдСвой, "", ТокенRoot);
		Клиент.ЗапросJSONСТокеном("DELETE", АдресЧужого + "/" + ИдЧужой, "", ТокенOwner);
		ВызватьИсключение;
	КонецПопытки;

	Клиент.ЗапросJSONСТокеном("DELETE", АдресЧужого + "/" + ИдЧужой, "", ТокенOwner);

КонецПроцедуры

// Default-closed: запись без издателя либо репозитория означала бы «публиковать вправе
// любой конвейер любого репозитория».
&Тест
Процедура ДовериеБезИздателяИлиРепозиторияЧерезAPIНеСоздаётся() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");

	// издатель необязателен: без него он выводится из провайдера
	БезИздателя = Клиент.ЗапросJSONСТокеном("POST", Адрес,
		"{""провайдер"":""github"",""репозиторий"":""acme/no-issuer"",""реф"":""main""}", ТокенOwner);
	Ожидаем.Что(БезИздателя.КодСостояния, "без издателя запись создаётся → 201").Равно(201);
	Ожидаем.Что(Строка(Клиент.ТелоJSON(БезИздателя).Получить("trusted_workflow").Получить("issuer")),
		"издатель выведен из провайдера").Равно(ИздательCI());
	Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/"
		+ Формат(Клиент.ТелоJSON(БезИздателя).Получить("trusted_workflow").Получить("id"), "ЧГ=0; ЧН=0"), "",
		ТокенOwner);

	БезРепозитория = Клиент.ЗапросJSONСТокеном("POST", Адрес,
		СтрШаблон("{""провайдер"":""github"",""издатель"":""%1""}", ИздательCI()), ТокенOwner);
	Ожидаем.Что(БезРепозитория.КодСостояния, "без репозитория → 400").Равно(400);

	// реф обязателен и здесь: форму обойти можно, а домен — нет, и дверей у него две
	БезРефа = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("acme/no-ref", ""), ТокенOwner);
	Ожидаем.Что(БезРефа.КодСостояния, "без рефа → 400").Равно(400);
	ПроверитьФорматОшибки(БезРефа, "invalid_trusted_workflow");

	ЧужойПровайдер = Клиент.ЗапросJSONСТокеном("POST", Адрес,
		СтрШаблон("{""провайдер"":""bitbucket"",""издатель"":""%1"",""репозиторий"":""acme/x""}",
			ИздательCI()), ТокенOwner);
	Ожидаем.Что(ЧужойПровайдер.КодСостояния, "провайдер вне списка → 400").Равно(400);

	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items").Количество(),
		"ни одной записи не создано").Равно(0);

	Контроль = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("acme/complete", "refs/heads/main"), ТокенOwner);
	Ожидаем.Что(Контроль.КодСостояния, "КОНТРОЛЬ: полный набор полей → 201").Равно(201);
	Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/"
		+ Формат(Клиент.ТелоJSON(Контроль).Получить("trusted_workflow").Получить("id"), "ЧГ=0; ЧН=0"), "",
		ТокенOwner);

КонецПроцедуры

// Второй адрес отзыва — для клиентов, которым DELETE недоступен. Он описан в docs и
// в openapi, поэтому обязан существовать не только на бумаге.
&Тест
Процедура ОтзывДействиемPOSTСнимаетДоверие() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");

	Запись = Клиент.ТелоJSON(Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("acme/post-delete", "refs/heads/main"), ТокенOwner))
		.Получить("trusted_workflow");
	Ид = Формат(Запись.Получить("id"), "ЧГ=0; ЧН=0");

	Отзыв = Клиент.ЗапросJSONСТокеном("POST", Адрес + "/" + Ид + "/delete", "", ТокенOwner);
	Ожидаем.Что(Отзыв.КодСостояния, "POST .../delete снимает доверие → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Отзыв).Получить("deleted"), "и говорит об этом").ЭтоИстина();
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items").Количество(),
		"записи не осталось").Равно(0);

	Повтор = Клиент.ЗапросJSONСТокеном("POST", Адрес + "/" + Ид + "/delete", "", ТокенOwner);
	Ожидаем.Что(Повтор.КодСостояния, "снятой записи больше нет → 404").Равно(404);

КонецПроцедуры

// Привязка ключа к пулу: PAT, выписанный на другой пул, доверие не настраивает.
// Контроль рядом — непривязанный ключ того же человека.
&Тест
Процедура КлючЧужогоПулаДовериеНеНастраивает() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ИдЧужого = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned", ТокенOwner)).Получить("pool").Получить("id");
	ЧужойПул = ВыпуститьPATСоСкоупом(КукаOwner, "read,write", ИдЧужого);

	Отказ = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("bound/repo", "refs/heads/main"), ЧужойПул);
	Ожидаем.Что(Отказ.КодСостояния, "ключ чужого пула доверие не настраивает → 403").Равно(403);
	ПроверитьФорматОшибки(Отказ, "token_pool_mismatch");
	Ожидаем.Что(СодержитПоле(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items"),
			"repository", "bound/repo"),
		"запись не создана").ЭтоЛожь();

	// КОНТРОЛЬ, без которого «привязка не проверяется вовсе» неотличимо от «проверяется»:
	// ключ, привязанный к ЭТОМУ пулу, обязан работать
	ИдСвоего = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/secret", ТокенOwner)).Получить("pool").Получить("id");
	СвойПул = ВыпуститьPATСоСкоупом(КукаOwner, "read,write", ИдСвоего);
	Контроль = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("bound/repo", "refs/heads/main"), СвойПул);
	Ожидаем.Что(Контроль.КодСостояния,
		"КОНТРОЛЬ: ключ, привязанный к этому пулу, заводит → 201").Равно(201);
	Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/"
		+ Формат(Клиент.ТелоJSON(Контроль).Получить("trusted_workflow").Получить("id"), "ЧГ=0; ЧН=0"), "",
		СвойПул);

КонецПроцедуры

// Аноним не представился — это 401, а не 403: «кто ты» и «тебе нельзя» клиент разбирает
// по-разному. Пул публичный, поэтому видимость запрос не отбивает раньше.
&Тест
Процедура АнонимНаДоверенныхКонвейерахПолучает401() Экспорт

	Адрес = АдресДоверия("public", "alice-pkg");

	Аноним = Клиент.GET(Адрес);
	Ожидаем.Что(Аноним.КодСостояния, "аноним на списке → 401").Равно(401);
	ПроверитьФорматОшибки(Аноним, "unauthorized");

	АнонимПишет = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоДоверия("anon/repo", "refs/heads/main"), "");
	Ожидаем.Что(АнонимПишет.КодСостояния, "аноним на заведении → 401").Равно(401);

	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТокенRoot).КодСостояния,
		"КОНТРОЛЬ: тот же адрес с ключом админа → 200").Равно(200);

КонецПроцедуры

// winow исполняет короткий адрес вместо длинного, если хвост не отбить: без гварда
// «.../{id}/delete/что-угодно» доехал бы до отзыва.
&Тест
Процедура ЛишнийХвостПутиНаДоверенныхКонвейерахДаёт404() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");

	Ожидаем.Что(Клиент.GETСТокеном(Адрес + "/1/лишнее", ТокенOwner).КодСостояния,
		"лишний сегмент у элемента → 404").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном(Адрес + "/лишнее", ТокенOwner).КодСостояния,
		"лишний сегмент у коллекции — метод элемента, GET не разрешён").Равно(405);

	Ожидаем.Что(Клиент.GETСТокеном(Адрес, ТокенOwner).КодСостояния,
		"КОНТРОЛЬ: адрес без хвоста работает").Равно(200);

КонецПроцедуры

// Заявка «короткие значения принимает и API» должна ИСПОЛНЯТЬСЯ: достройка живёт
// в домене, поэтому одинаковый ввод обязан давать одинаковую запись обеими дверьми.
&Тест
Процедура APIПринимаетКороткиеЗначенияТакЖеКакЭкран() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");

	Тегом = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоКороткойФормы("acme/short", "e2e.yml", "v1.2.3", "тег"), ТокенOwner);
	Ожидаем.Что(Тегом.КодСостояния, "короткая форма принята → 201").Равно(201);
	Запись = Клиент.ТелоJSON(Тегом).Получить("trusted_workflow");
	Ожидаем.Что(Строка(Запись.Получить("workflow")), "имя файла достроено")
		.Равно("acme/short/.github/workflows/e2e.yml");
	Ожидаем.Что(Строка(Запись.Получить("ref")), "вид рефа прочитан: тег, а не ветка")
		.Равно("refs/tags/v1.2.3");
	Ожидаем.Что(Строка(Запись.Получить("issuer")), "издатель выведен из провайдера")
		.Равно(ИздательCI());

	Веткой = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоКороткойФормы("acme/short2", "e2e.yml", "develop", ""), ТокенOwner);
	Ожидаем.Что(Строка(Клиент.ТелоJSON(Веткой).Получить("trusted_workflow").Получить("ref")),
		"без вида рефа — ветка").Равно("refs/heads/develop");

	// глоб-маска — такое же значение поля, и достраивается она так же
	Маской = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоКороткойФормы("acme/short3", "e2e.yml", "v*", "тег"), ТокенOwner);
	Ожидаем.Что(Строка(Клиент.ТелоJSON(Маской).Получить("trusted_workflow").Получить("ref")),
		"маска тега достроена тегом").Равно("refs/tags/v*");

	// та же запись, заведённая КАНОНИЧЕСКИМИ значениями, идемпотентна короткой:
	// значит обе двери дали ровно одно и то же
	Полная = СтрШаблон("{""провайдер"":""github"",""репозиторий"":""acme/short"","
		+ """конвейер"":""acme/short/.github/workflows/e2e.yml"",""реф"":""refs/tags/v1.2.3""}");
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", Адрес, Полная, ТокенOwner).КодСостояния,
		"каноническая форма попала в ту же запись → 200").Равно(200);

	Для Каждого Ключ Из СтрРазделить("acme/short,acme/short2,acme/short3", ",") Цикл
		Для Каждого Элемент Из Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items") Цикл
			Если Строка(Элемент.Получить("repository")) = Ключ Тогда
				Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/" + Формат(Элемент.Получить("id"), "ЧГ=0; ЧН=0"), "", ТокенOwner);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Ключи тела API английские, а значения вида рефа — русские. «ref_kind»:«tag», молча
// понятый как ветка, давал бы запись refs/heads/v* и ответ 201 «конвейер вправе публиковать»,
// а отказ приходил бы только на первом пуше и без названной причины. Английские синонимы
// принимаются, нераспознанное значение отвергается ГРОМКО — противоположным оно не станет.
&Тест
Процедура АнглийскийВидРефаНеСтановитсяВеткойМолча() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");

	// уборка идёт и при падении в середине: оставленные записи достанутся соседним тестам
	Попытка

		Тегом = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоАнглийскойФормы("acme/en-tag", "v*", "tag"), ТокенOwner);
		Ожидаем.Что(Тегом.КодСостояния, "ref_kind=tag принят → 201").Равно(201);
		Ожидаем.Что(Строка(Клиент.ТелоJSON(Тегом).Получить("trusted_workflow").Получить("ref")),
			"и достроен ТЕГОМ, а не веткой").Равно("refs/tags/v*");

		Веткой = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоАнглийскойФормы("acme/en-branch", "v*", "branch"), ТокенOwner);
		Ожидаем.Что(Веткой.КодСостояния, "ref_kind=branch принят → 201").Равно(201);
		Ожидаем.Что(Строка(Клиент.ТелоJSON(Веткой).Получить("trusted_workflow").Получить("ref")),
			"branch — по-прежнему ветка").Равно("refs/heads/v*");

		Мусор = Клиент.ЗапросJSONСТокеном("POST", Адрес, ТелоАнглийскойФормы("acme/en-junk", "v*", "тэг"), ТокенOwner);
		Ожидаем.Что(Мусор.КодСостояния,
			"нераспознанный вид рефа → 400, а не молчаливая ветка").Равно(400);
		ПроверитьФорматОшибки(Мусор, "invalid_trusted_workflow");
		Ожидаем.Что(СтрНайти(Строка(Клиент.ТелоJSON(Мусор).Получить("error").Получить("message")),
			"вид рефа") > 0, "и причина названа словами").ЭтоИстина();
		Ожидаем.Что(СодержитПоле(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items"),
				"repository", "acme/en-junk"),
			"записи по нераспознанному виду не появилось").ЭтоЛожь();

	Исключение
		СнятьДовериеПоРепозиториям(Адрес, "acme/en-tag,acme/en-branch,acme/en-junk");
		ВызватьИсключение;
	КонецПопытки;

	СнятьДовериеПоРепозиториям(Адрес, "acme/en-tag,acme/en-branch,acme/en-junk");

КонецПроцедуры

// Снимает записи доверия перечисленных репозиториев: тест обязан оставить пакет таким же,
// каким его взял, — иначе соседний тест считает чужие строки своими.
Процедура СнятьДовериеПоРепозиториям(Знач Адрес, Знач Репозитории)

	Элементы = Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес, ТокенOwner)).Получить("items");
	Для Каждого Ключ Из СтрРазделить(Репозитории, ",") Цикл
		Для Каждого Элемент Из Элементы Цикл
			Если Строка(Элемент.Получить("repository")) = Ключ Тогда
				Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/" + Формат(Элемент.Получить("id"), "ЧГ=0; ЧН=0"), "", ТокенOwner);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НеверныйМетодНаДоверенныхКонвейерахДаёт405() Экспорт

	Адрес = АдресДоверия("secret", "secret-pkg");
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", Адрес, "{}", ТокенOwner).КодСостояния,
		"PATCH на коллекции → 405").Равно(405);
	Ожидаем.Что(Клиент.GETСТокеном(Адрес + "/1", ТокенOwner).КодСостояния,
		"GET на элементе → 405").Равно(405);

КонецПроцедуры

// Код 2xx обязан описывать УСПЕХ, а не ехать схемой Error: наличия ключа мало —
// клиент прочтёт «200 — это ошибка» и будет прав по описанию.
Процедура ПроверитьОписаниеУспеха(Знач Ответы_, Знач Код, Знач Чей)

	Ответ = Ответы_.Получить(Код);
	Ожидаем.Что(Ответ <> Неопределено, СтрШаблон("у %1 описан код %2", Чей, Код)).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Ответ.Получить("description")),
		СтрШаблон("код %1 у %2 описан словами", Код, Чей)).ЭтоИстина();
	Ожидаем.Что(Ответ.Получить("content"),
		СтрШаблон("код %1 у %2 не едет схемой Error", Код, Чей)).Равно(Неопределено);
	Ожидаем.Что(СтрНайти(НРег(Строка(Ответ.Получить("description"))), "ошибк"),
		СтрШаблон("описание кода %1 у %2 не говорит об ошибке", Код, Чей)).Равно(0);

КонецПроцедуры

// ===== подписки (ИСТ-ПОДП-011) =====

// Полный цикл кабинета через API: завести, прочитать, поправить, выключить, удалить.
// Секрет подписи вебхука отдаётся ровно один раз — в ответе на создание.
&Тест
Процедура ПодпискаПулаПроходитПолныйЦиклЧерезAPI() Экспорт

	Адрес = "/api/v1/pools/owned/webhooks";
	Тело_ = "{""тип"":""вебхук"",""url"":""https://hooks.example.com/a"",""события"":[""версия.опубликована""]}";
	Созд = Клиент.ЗапросJSONСТокеном("POST", Адрес, Тело_, ТокенOwner);
	Ожидаем.Что(Созд.КодСостояния, "подписка пула заведена ключом владельца").Равно(201);

	Разбор = Клиент.ТелоJSON(Созд);
	Секрет = Строка(Разбор.Получить("secret"));
	Подписка = Разбор.Получить("subscription");
	Ид = Формат(Число(Подписка.Получить("id")), "ЧГ=0; ЧН=0");
	Ожидаем.Что(ЗначениеЗаполнено(Секрет), "секрет подписи выдан при создании").ЭтоИстина();
	Ожидаем.Что(Подписка.Получить("address"), "адрес доставки сохранён").Равно("https://hooks.example.com/a");
	Ожидаем.Что(Подписка.Получить("enabled"), "новая подписка включена").ЭтоИстина();

	// сперва УТЕЧКА, потом признак: обратный порядок прятал бы утечку за падением типа
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСТокеном(Адрес + "/" + Ид, ТокенOwner)), Секрет),
		"второй раз секрет не отдаётся").Равно(0);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСТокеном(Адрес, ТокенOwner)), Секрет),
		"и в списке его тоже нет").Равно(0);
	Карточка = Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес + "/" + Ид, ТокенOwner)).Получить("subscription");
	Ожидаем.Что(Карточка.Получить("has_secret"), "но признак «секрет есть» виден").ЭтоИстина();

	Правка = Клиент.ЗапросJSONСТокеном("PATCH", Адрес + "/" + Ид,
		"{""url"":""https://hooks.example.com/b"",""включено"":false}", ТокенOwner);
	Ожидаем.Что(Правка.КодСостояния, "правка принята").Равно(200);
	Изменённая = Клиент.ТелоJSON(Правка).Получить("subscription");
	Ожидаем.Что(Изменённая.Получить("address"), "адрес изменён").Равно("https://hooks.example.com/b");
	Ожидаем.Что(Изменённая.Получить("enabled"), "подписка выключена").ЭтоЛожь();
	Ожидаем.Что(Изменённая.Получить("has_secret"), "секрет правкой не потерян").ЭтоИстина();

	Включение = Клиент.ЗапросJSONСТокеном("PATCH", Адрес + "/" + Ид, "{""включено"":true}", ТокенOwner);
	Ожидаем.Что(Клиент.ТелоJSON(Включение).Получить("subscription").Получить("enabled"),
		"подписка включена обратно одним полем").ЭтоИстина();
	Ожидаем.Что(Клиент.ТелоJSON(Включение).Получить("subscription").Получить("address"),
		"а адрес при этом не сброшен").Равно("https://hooks.example.com/b");

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/" + Ид, "", ТокенOwner).КодСостояния, "подписка удалена").Равно(200);
	Ожидаем.Что(Клиент.GETСТокеном(Адрес + "/" + Ид, ТокенOwner).КодСостояния,
		"удалённой подписки нет").Равно(404);

КонецПроцедуры

// Права те же, что у человека без роли: ключ без права управлять объектом не читает
// и не заводит подписки, а чужая подписка по идентификатору не находится вовсе.
&Тест
Процедура ПодпискиAPIДержатПраваОбъекта() Экспорт

	Тело_ = "{""тип"":""вебхук"",""url"":""https://hooks.example.com/idor"",""события"":[""версия.опубликована""]}";
	Своя = Клиент.ТелоJSON(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/webhooks", Тело_, ТокенOwner));
	Ид = Формат(Число(Своя.Получить("subscription").Получить("id")), "ЧГ=0; ЧН=0");

	Ожидаем.Что(Клиент.GET("/api/v1/pools/public/webhooks").КодСостояния,
		"аноним подписок не видит").Равно(401);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/webhooks", ТокенBob).КодСостояния,
		"посторонний подписок пула не видит").Равно(403);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/public/webhooks", Тело_, ТокенBob).КодСостояния,
		"и завести не может").Равно(403);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/secret/webhooks", ТокенBob).КодСостояния,
		"чужой приватный пул неотличим от несуществующего").Равно(404);

	// подписка пула owned по адресу пула secret: оба пула видит owner1, но подписка чужая
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/secret/webhooks/" + Ид, ТокенOwner).КодСостояния,
		"чужая подписка по идентификатору не находится").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/secret/webhooks/" + Ид, "", ТокенOwner).КодСостояния,
		"и удалить её через чужой объект нельзя").Равно(404);

	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/owned/webhooks/" + Ид, "", ТокенOwner);

КонецПроцедуры

// Подписки хаба — администратору хаба; пакета — тому, кто вправе менять пакет.
&Тест
Процедура ПодпискиХабаИПакетаЖивутСвоимиАдресами() Экспорт

	ТелоХаба = "{""тип"":""вебхук"",""url"":""https://hooks.example.com/hub"",""события"":[""версия.опубликована""]}";
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/webhooks", ТелоХаба, ТокенBob).КодСостояния,
		"подписку хаба посторонний не заводит").Равно(403);
	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/webhooks", ТелоХаба, ТокенRoot);
	Ожидаем.Что(Созд.КодСостояния, "подписку хаба заводит администратор").Равно(201);
	ИдХаба = Формат(Число(Клиент.ТелоJSON(Созд).Получить("subscription").Получить("id")), "ЧГ=0; ЧН=0");

	АдресПакета = "/api/v1/pools/secret/packages/secret-pkg/webhooks";
	ТелоПакета = "{""тип"":""вебхук"",""url"":""https://hooks.example.com/pkg"",""события"":[""версия.опубликована""]}";
	СоздПакета = Клиент.ЗапросJSONСТокеном("POST", АдресПакета, ТелоПакета, ТокенOwner);
	Ожидаем.Что(СоздПакета.КодСостояния, "подписка пакета заведена").Равно(201);
	Карточка = Клиент.ТелоJSON(СоздПакета).Получить("subscription");
	Ожидаем.Что(Карточка.Получить("object_type"), "объект подписки — пакет").Равно("пакет");
	ИдПакета = Формат(Число(Карточка.Получить("id")), "ЧГ=0; ЧН=0");

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСТокеном(АдресПакета, ТокенOwner)), "hooks.example.com/hub"),
		"подписка хаба в списке пакета не появляется").Равно(0);

	Клиент.ЗапросJSONСТокеном("DELETE", АдресПакета + "/" + ИдПакета, "", ТокенOwner);
	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/webhooks/" + ИдХаба, "", ТокенRoot);

КонецПроцедуры

// Конвейеру не надо зашивать у себя ни перечень событий, ни поля типов доставки.
&Тест
Процедура СправочникПодписокЧитаетсяИзAPI() Экспорт

	Ответ = Клиент.GETСТокеном("/api/v1/webhook-meta", ТокенOwner);
	Ожидаем.Что(Ответ.КодСостояния, "справочник читается").Равно(200);

	Разбор = Клиент.ТелоJSON(Ответ);
	События = Разбор.Получить("events");
	Ожидаем.Что(События.Количество() > 0, "перечень событий непуст").ЭтоИстина();
	Ожидаем.Что(События.Найти("версия.опубликована") <> Неопределено,
		"и содержит событие публикации версии").ЭтоИстина();

	Виды = Разбор.Получить("kinds");
	Имена = Новый Массив();
	ПоляВебхука = Неопределено;
	Для Каждого Вид Из Виды Цикл
		Имена.Добавить(Строка(Вид.Получить("kind")));
		Если Строка(Вид.Получить("kind")) = "вебхук" Тогда
			ПоляВебхука = Вид.Получить("fields");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Имена.Найти("вебхук") <> Неопределено, "тип «вебхук» назван").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("telegram") <> Неопределено, "тип «telegram» назван").ЭтоИстина();
	Ожидаем.Что(ПоляВебхука <> Неопределено И ПоляВебхука.Количество() > 0,
		"поля настроек вебхука перечислены").ЭтоИстина();
	Ожидаем.Что(СодержитПоле(ПоляВебхука, "name", "URL"),
		"и названы так же, как их принимает тело запроса").ЭтоИстина();
	Секретных = 0;
	Для Каждого Поле Из ПоляВебхука Цикл
		Если Поле.Получить("secret") = Истина Тогда
			Секретных = Секретных + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Секретных > 0,
		"секретное поле помечено, а значений в справочнике нет").ЭтоИстина();

КонецПроцедуры

// Отказ называет причину так же, как экран: неизвестное событие, дубль адреса, лимит.
&Тест
Процедура ОтказПодпискиAPIНазываетПричину() Экспорт

	Адрес = "/api/v1/pools/owned/webhooks";

	Неизвестное = Клиент.ЗапросJSONСТокеном("POST", Адрес,
		"{""тип"":""вебхук"",""url"":""https://hooks.example.com/x"",""события"":[""нет.такого""]}",
		ТокенOwner);
	ПроверитьФорматОшибки(Неизвестное, "invalid_subscription");
	Ожидаем.Что(СтрНайти(НРег(Клиент.Тело(Неизвестное)), "тип события") > 0,
		"названа причина «недоступный тип события»: " + Клиент.Тело(Неизвестное)).ЭтоИстина();

	Тело_ = "{""тип"":""вебхук"",""url"":""https://hooks.example.com/dup"",""события"":[""версия.опубликована""]}";
	Первая = Клиент.ЗапросJSONСТокеном("POST", Адрес, Тело_, ТокенOwner);
	Ид = Формат(Число(Клиент.ТелоJSON(Первая).Получить("subscription").Получить("id")), "ЧГ=0; ЧН=0");
	Дубль = Клиент.ЗапросJSONСТокеном("POST", Адрес, Тело_, ТокенOwner);
	ПроверитьФорматОшибки(Дубль, "invalid_subscription");
	Ожидаем.Что(СтрНайти(НРег(Клиент.Тело(Дубль)), "адрес") > 0,
		"названа причина «дубль адреса»: " + Клиент.Тело(Дубль)).ЭтоИстина();

	Неизвестный = Клиент.ЗапросJSONСТокеном("POST", Адрес,
		"{""тип"":""голубиная-почта"",""url"":""https://hooks.example.com/y"",""события"":[""версия.опубликована""]}",
		ТокенOwner);
	ПроверитьФорматОшибки(Неизвестный, "invalid_subscription");
	Ожидаем.Что(СтрНайти(НРег(Клиент.Тело(Неизвестный)), "голубиная-почта") > 0,
		"назван неизвестный тип действия: " + Клиент.Тело(Неизвестный)).ЭтоИстина();

	Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/" + Ид, "", ТокенOwner);

КонецПроцедуры

// НФТ-ПОДП-006 на ЖИВОМ хабе: фейки доказывают, что очередь читается из хранилища,
// но не то, что хранилище настоящее. Здесь задание доставки обязано оказаться СТРОКОЙ
// ТАБЛИЦЫ на диске и быть разобранным фоновой рогаткой — то есть пережить перезапуск.
&Тест
Процедура ЗаданиеДоставкиЛожитсяВБазуИРазбираетсяФоном() Экспорт

	Пул = ЗавестиПулДляЗаявок();
	Цель = "https://127.0.0.1:1/hook-" + Строка(Новый УникальныйИдентификатор());
	Тело_ = СтрШаблон("{""тип"":""вебхук"",""url"":""%1"",""события"":[""версия.опубликована""]}", Цель);
	Созд = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/webhooks", Пул), Тело_, ТокенRoot);
	Ожидаем.Что(Созд.КодСостояния, "подписка на мёртвую цель заведена: " + Клиент.Тело(Созд)).Равно(201);

	Публикация(СтрШаблон("/api/v1/pools/%1/push", Пул), ПостроитьOspxДанные("queue-pkg", "1.0.0"),
		"queue-pkg-1.0.0.ospx", ТокенRoot);

	// задание лежит в таблице, а не в памяти процесса
	Строки = ТаблицаЗаданийДоставки();
	Ожидаем.Что(СтрНайти(Строки, Цель) > 0,
		"задание доставки записано в таблицу ЗаданияДоставки: " + Лев(Строки, 400)).ЭтоИстина();

	// и разбирается фоновой рогаткой: она читает его из ТОЙ ЖЕ таблицы
	Хаб.ДождатьсяСтрокиЖурнала("сбой (попытка 1)", 60);
	Ожидаем.Что(СтрНайти(Хаб.Дамп(), "Сбой шага доставщика подписок"),
		"разбор очереди не падает на слое данных").Равно(0);

КонецПроцедуры

// Токен бота не возвращается никогда — ни при создании, ни в списке, ни в карточке.
&Тест
Процедура ТокенБотаAPIНеВозвращаетНикогда() Экспорт

	Адрес = "/api/v1/pools/owned/webhooks";
	Токен = "123456789:AAHkQwErTyUiOpAsDfGhJkLzXcVbNm12345";
	Тело_ = СтрШаблон("{""тип"":""telegram"",""ЧатИд"":""-100500"",""Токен"":""%1"","
		+ """события"":[""версия.опубликована""]}", Токен);

	Созд = Клиент.ЗапросJSONСТокеном("POST", Адрес, Тело_, ТокенOwner);
	Ожидаем.Что(Созд.КодСостояния, "подписка telegram заведена: " + Клиент.Тело(Созд)).Равно(201);
	Ид = Формат(Число(Клиент.ТелоJSON(Созд).Получить("subscription").Получить("id")), "ЧГ=0; ЧН=0");

	Ожидаем.Что(СтрНайти(Клиент.Тело(Созд), Токен), "токен не отдан в ответе на создание").Равно(0);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСТокеном(Адрес + "/" + Ид, ТокенOwner)), Токен),
		"токен не отдан в карточке").Равно(0);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСТокеном(Адрес, ТокенOwner)), Токен),
		"токен не отдан в списке").Равно(0);
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETСТокеном(Адрес + "/" + Ид, ТокенOwner)).Получить("subscription")
		.Получить("own_token"), "но признак «свой бот» виден").ЭтоИстина();

	Клиент.ЗапросJSONСТокеном("DELETE", Адрес + "/" + Ид, "", ТокенOwner);

КонецПроцедуры

// Содержимое файла таблицы заданий доставки: КоннекторJSON держит каждую таблицу
// отдельным файлом в каталоге БД, и его наличие — прямая улика «очередь на диске».
Функция ТаблицаЗаданийДоставки()

	Найденные = НайтиФайлы(Хаб.КаталогБазы(), "*ЗаданияДоставки*", Истина);
	Если Найденные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Найденные[0].ПолноеИмя, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Содержимое = Неопределено, "", Содержимое);

КонецФункции

Функция АдресДоверия(Знач ИмяПула, Знач ИмяПакета)
	Возврат СтрШаблон("/api/v1/pools/%1/packages/%2/trusted-workflows", ИмяПула, ИмяПакета);
КонецФункции

Функция ИздательCI()
	Возврат "https://token.actions.githubusercontent.com";
КонецФункции

Функция ТелоДоверия(Знач Репозиторий, Знач Реф)
	Возврат СтрШаблон(
		"{""провайдер"":""github"",""издатель"":""%1"",""репозиторий"":""%2"",""реф"":""%3""}",
		ИздательCI(), Репозиторий, Реф);
КонецФункции

// Тело на АНГЛИЙСКИХ ключах — так его пишет клиент API по описанию openapi.
Функция ТелоАнглийскойФормы(Знач Репозиторий, Знач Реф, Знач ВидРефа)
	Возврат СтрШаблон("{""provider"":""github"",""repository"":""%1"",""workflow"":""e2e.yml"","
		+ """ref"":""%2"",""ref_kind"":""%3""}", Репозиторий, Реф, ВидРефа);
КонецФункции

// Тело КОРОТКОЙ формы — ровно то, что вводит человек: имя файла и имя ветки, без издателя.
Функция ТелоКороткойФормы(Знач Репозиторий, Знач Файл, Знач Ветка, Знач ВидРефа)
	Возврат СтрШаблон("{""провайдер"":""github"",""репозиторий"":""%1"",""конвейер"":""%2"","
		+ """реф"":""%3"",""вид_рефа"":""%4""}", Репозиторий, Файл, Ветка, ВидРефа);
КонецФункции

#КонецОбласти

#Область HTTPПримитивы

#КонецОбласти

#Область ФикстурыИРазбор

Функция ВыпуститьPAT(Знач Кука)
	Возврат ВыпуститьPATСоСкоупом(Кука, "read,write");
КонецФункции

Функция ВыпуститьPATСоСкоупом(Знач Кука, Знач Права, Знач ПулИд = 0)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрШаблон("{""права"":""%1"",""пул"":%2}", Права,
		Формат(Цел(ПулИд), "ЧГ=0; ЧН=0")), КодировкаТекста.UTF8);
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;
	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");
КонецФункции

Функция ЗавестиПулRoot(Знач Тело_)
	Возврат Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools", Тело_, ТокенRoot);
КонецФункции

// Публичный пул под очередь заявок: bob его ВИДИТ (иначе push дал бы 403, а не 202),
// но прав в нём не имеет. Имя уникально — наборы делят один хаб.
Функция ЗавестиПулДляЗаявок()

	СчётчикПулов = СчётчикПулов + 1;
	Имя = "inbox-pool-" + Формат(СчётчикПулов, "ЧГ=0; ЧН=0");
	Ответ = ЗавестиПулRoot(СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя));
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Пул для заявок не заведён (%1): %2",
			Ответ.КодСостояния, Клиент.Тело(Ответ));
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Push от bob — он аутентифицирован, пул видит, прав не имеет: ровно случай очереди.
Функция ЗаявкаОтBob(Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	ИмяФайла = СтрШаблон("%1-%2.ospx", ИмяПакета, Версия);
	Возврат Публикация(СтрШаблон("/api/v1/pools/%1/push", ИмяПула),
		ПостроитьOspxДанные(ИмяПакета, Версия), ИмяФайла, ТокенBob);

КонецФункции

Функция НомерПервойЗаявки(Знач ИмяПула)

	Элементы = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + ИмяПула + "/inbox", ТокенRoot)).Получить("items");
	Если Элементы.Количество() = 0 Тогда
		ВызватьИсключение "Во «входящих» пула " + ИмяПула + " нет ни одной заявки";
	КонецЕсли;
	Возврат Строка(Формат(Элементы[0].Получить("id"), "ЧГ=0; ЧН=0"));

КонецФункции

// Публикация: сырое бинарное тело .ospx + FILE-NAME + Bearer PAT.
Функция Публикация(Знач Путь, Знач Данные, Знач ИмяФайла, Знач Токен)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("CHANNEL", "stable");
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия)

	Возврат Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия);

КонецФункции

Функция ГрантЕстьУ(Знач Гранты, Знач Логин)

	Для Каждого Грант Из Гранты Цикл
		Если Строка(Грант.Получить("subject")) = Логин Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция СодержитПакет(Знач Элементы, Знач Имя)

	Для Каждого Элемент Из Элементы Цикл
		Если Строка(Элемент.Получить("package")) = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция НастройкиПула(Знач ИмяПула)
	Возврат Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + ИмяПула + "/settings", ТокенRoot)).Получить("settings");
КонецФункции

Функция НастройкиПулаНеНайдены(Знач ИмяПула)
	Возврат Клиент.GETСТокеном("/api/v1/pools/" + ИмяПула + "/settings", ТокенRoot).КодСостояния = 404;
КонецФункции

Функция КвотаПула(Знач ИмяПула)
	Возврат НастройкиПула(ИмяПула).Получить("quota_mb");
КонецФункции

// Заголовок ответа без учёта регистра имени: сервер волен писать их как хочет.
// Версия, которую фактически отдала выдача: она названа в имени файла артефакта.
Функция ОтданнаяВерсия(Знач Путь)

	Ответ = Клиент.GET(Путь);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат СтрШаблон("<код %1>", Формат(Ответ.КодСостояния, "ЧГ=0; ЧН=0"));
	КонецЕсли;

	Расположение = Клиент.ЗаголовокОтвета(Ответ, "Content-Disposition");
	Начало = СтрНайти(Расположение, """");
	Конец = СтрНайти(Расположение, """", НаправлениеПоиска.СКонца);
	Если Начало = 0 ИЛИ Конец <= Начало Тогда
		Возврат "<без имени файла: " + Расположение + ">";
	КонецЕсли;

	ИмяФайла = Сред(Расположение, Начало + 1, Конец - Начало - 1);
	Основа = Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(".ospx"));
	Дефис = СтрНайти(Основа, "-", НаправлениеПоиска.СКонца);
	Возврат ?(Дефис = 0, Основа, Сред(Основа, Дефис + 1));

КонецФункции

// Уникальное имя пула: наборы делят один хаб, а повтор имени даёт 409.
// Занято ли зеркало прогоном ПО ЗАПИСИ хаба: состояние очереди плюс признак брошенного —
// ровно то, на что смотрит предикат домена.
Функция ЗеркалоВРаботе(Знач ИмяПула, Знач Ид)

	Ответ = Клиент.GETСТокеном(СтрШаблон("/api/v1/pools/%1/mirrors/%2", ИмяПула, Ид), ТокенRoot);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Ложь;
	КонецЕсли;

	Прогон = Клиент.ТелоJSON(Ответ).Получить("mirror").Получить("run");
	Состояние = Строка(Прогон.Получить("state"));
	Возврат (Состояние = "идёт" ИЛИ Состояние = "поставлено") И НЕ Прогон.Получить("stale") = Истина;

КонецФункции

// Ждёт конца прогона: против недоступного апстрима он заканчивается за миллисекунды,
// но ждать его окончания всё равно приходится явно — иначе уборка теста упрётся в отказ.
Процедура ДождатьсяПокояЗеркала(Знач ИмяПула, Знач Ид)

	Для Заход = 1 По 30 Цикл
		Если НЕ ЗеркалоВРаботе(ИмяПула, Ид) Тогда
			Возврат;
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;

КонецПроцедуры

Функция УникальноеИмяПула(Знач Префикс)
	СчётчикПулов = СчётчикПулов + 1;
	Возврат Префикс + "-" + Формат(СчётчикПулов, "ЧГ=0; ЧН=0");
КонецФункции

// Заведение пула ВТОРОЙ дверью — формой раздела «Пулы» дома «Хаб». Успех проверяется
// не кодом редиректа, а появлением пула: форма отвечает страницей, а не JSON.
Процедура ЗавестиПулФормой(Знач Имя)

	ПоляФормы = Новый Соответствие();
	ПоляФормы.Вставить("_csrf", CSRFRoot);
	ПоляФормы.Вставить("операция", "пул-создать");
	ПоляФормы.Вставить("имя", Имя);
	ПоляФормы.Вставить("тип", "custom");
	ПоляФормы.Вставить("видимость", "public");
	Клиент.POSTФормы("/hub/settings/pools", ПоляФормы, КукаRoot);

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot).КодСостояния,
		"форма дома «Хаб» завела пул").Равно(200);

КонецПроцедуры

Функция ГрантыПула(Знач ИмяПула)
	Ответ = Клиент.GETСТокеном("/api/v1/pools/" + ИмяПула + "/grants", ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "права пула читаются").Равно(200);
	Возврат Клиент.ТелоJSON(Ответ).Получить("items");
КонецФункции

// Права пула одной сравнимой строкой: субъект и его роль, по возрастанию. Сравнивается
// ЗНАЧЕНИЕ — кому и что досталось, — а не то, каким методом это записали.
Функция ПраваПулаСтрокой(Знач ИмяПула)

	Записи = Новый Массив();
	Для Каждого Грант Из ГрантыПула(ИмяПула) Цикл
		Записи.Добавить(СтрШаблон("%1:%2:%3", Строка(Грант.Получить("subject_type")),
			Строка(Грант.Получить("subject")), Строка(Грант.Получить("role"))));
	КонецЦикла;

	Список = Новый СписокЗначений();
	Список.ЗагрузитьЗначения(Записи);
	Список.СортироватьПоЗначению();

	Отсортированные = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Отсортированные.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Отсортированные, "|");

КонецФункции

Функция ИмяОсновногоПула()
	Для Каждого Пул Из Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools?pageSize=200", ТокенRoot)).Получить("items") Цикл
		Если Пул.Получить("default") = Истина Тогда
			Возврат Строка(Пул.Получить("name"));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Возврат хаба в исходное состояние: набор делит один живой хаб, и оставленный
// чужой основной пул увёл бы короткие адреса у соседних тестов.
Процедура ВернутьОсновнойПул(Знач Имя)
	Если ЗначениеЗаполнено(Имя) Тогда
		Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/default", Имя), "{}", ТокенRoot);
	КонецЕсли;
КонецПроцедуры

// Тот же ввод, что уходит в PATCH, но разделом «Квота» дома настроек пула.
Функция ПостФормыКвоты(Знач ИмяПула, Знач Значение)
	ПоляФормы = Новый Соответствие();
	ПоляФормы.Вставить("_csrf", CSRFRoot);
	ПоляФормы.Вставить("квота_мб", Значение);
	Возврат Клиент.POSTФормы("/" + ИмяПула + "/settings/quota", ПоляФормы, КукаRoot);
КонецФункции

// Единый формат ошибки {error:{code,message}} и ожидаемый машинный код.
Процедура ПроверитьФорматОшибки(Знач Ответ, Знач ОжидаемыйКод)
	Т = Клиент.ТелоJSON(Ответ);
	Ошибка = Т.Получить("error");
	Ожидаем.Что(Ошибка <> Неопределено, "есть объект error").ЭтоИстина();
	Ожидаем.Что(Ошибка.Получить("code"), "код ошибки").Равно(ОжидаемыйКод);
	Ожидаем.Что(ЗначениеЗаполнено(Ошибка.Получить("message")), "сообщение есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Строка(Ошибка.Получить("message"))), "модуль"), "нет утечки стектрейса").Равно(0);
КонецПроцедуры

Функция СодержитИмя(Знач Массив, Знач Имя)
	Возврат СодержитПоле(Массив, "name", Имя);
КонецФункции

Функция СодержитЛогин(Знач Массив, Знач Логин)
	Возврат СодержитПоле(Массив, "login", Логин);
КонецФункции

Функция СодержитСубъект(Знач Массив, Знач Субъект)
	Возврат СодержитПоле(Массив, "subject", Субъект);
КонецФункции

Функция СодержитОбъект(Знач Массив, Знач Объект)
	Возврат СодержитПоле(Массив, "object", Объект);
КонецФункции

Функция СодержитПоле(Знач Массив, Знач Поле, Знач Значение)
	Для Каждого Элемент Из Массив Цикл
		Если Строка(Элемент.Получить(Поле)) = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ИсточникЧленства(Знач Массив, Знач Логин)
	Для Каждого Элемент Из Массив Цикл
		Если Строка(Элемент.Получить("login")) = Логин Тогда
			Возврат Строка(Элемент.Получить("source"));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

#КонецОбласти
