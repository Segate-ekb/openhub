// Сквозные HTTP-проверки публичной страницы /confirm-email на настоящем хабе: маршрут
// отвечает, негодная ссылка получает свой код, кнопка повторной отправки закрыта CSRF,
// а ненастроенная почта отвечает «письмо выслать некуда», а не пятисоткой.
// Живого SMTP у стенда нет намеренно: настоящую ссылку из письма проверяет юнит-набор
// ПодтверждениеАдреса_Тесты на подменённом транспорте.
// Отдельные тесты поднимают СВОЙ стенд с другой настройкой почты: с настроенной почтой
// (путь восстановления пароля) и с настроенной почтой, но без внешнего адреса инсталляции.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;
Перем Порт;
Перем ЛогинАдмина;
Перем ПарольАдмина;
Перем КукаАдмина; // сессия администратора стенда: заводится один раз на набор
Перем Клиент;     // фикстура КлиентХаба — все запросы к подопытному хабу

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ЛогинАдмина = "root";
	ПарольАдмина = "RootPassw0rd1";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.ФайловаяБаза("openhub-подтверждение-адреса");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");
	// внешний адрес задан, чтобы единственным недостающим для письма оставалась ПОЧТА:
	// иначе «нечем слать» доказывалось бы отсутствием адреса хаба, а не отсутствием почты
	Хаб.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");
	Хаб.Запустить();
	Порт = Хаб.Порт();
	Клиент = Новый КлиентХаба(Хаб, 20);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область СтраницаБезСсылки

// Аноним здесь — это как раз тот, кого вход не пустил из-за неподтверждённого адреса.
// Отправлять его «войти в учётную запись» значит замкнуть круг, поэтому страница даёт
// форму: назови себя — вышлем письмо.
&Тест
Процедура АнонимуСтраницаДаётФормуЗапросаПисьма() Экспорт

	Ответ = Клиент.GET("/confirm-email");
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "страница публична").Равно(200);
	Ожидаем.Что(СтрНайти(Тело_, "name=""учётка""") > 0,
		"на странице поле для логина или адреса").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "Выслать письмо") > 0, "и кнопка запроса").ЭтоИстина();

КонецПроцедуры

// Учётка без адреса — обычное состояние: мастер первого запуска адреса не спрашивает.
// Страница обязана сказать, что подтверждать нечего, и не рисовать кнопку, которая
// заведомо ничего не вышлет. Тест стоит ДО того, что вписывает адрес администратору:
// другой безадресной учётки на стенде нет.
&Тест
Процедура УчёткеБезАдресаПодтверждатьНечегоИКнопкиПовтораЕйНеРисуют() Экспорт

	Кука = ЗавестиАдмина();

	Ответ = Клиент.GETСКукой("/confirm-email", Кука);
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "страница отдана").Равно(200);
	Ожидаем.Что(СтрНайти(Тело_, "не указан адрес") > 0,
		"названа причина, а не общее «что-то не так»: " + Лев(Тело_, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "Выслать письмо ещё раз"),
		"кнопки, которой нечего высылать, на странице нет").Равно(0);

	// форму собирают и без кнопки: отказ обязан быть на сервере, а не в разметке
	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));

	Повтор = Клиент.POSTФормы("/confirm-email", Поля, Кука);
	Ожидаем.Что(Повтор.КодСостояния, "письма учётке без адреса не выпускаются вовсе").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Повтор), "не указан адрес") > 0,
		"и отказ называет ту же причину, что страница").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВошедшемуСНеподтверждённымАдресомПоказываютКнопкуПовтора() Экспорт

	Кука = АдминСАдресом();

	Ответ = Клиент.GETСКукой("/confirm-email", Кука);
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "страница отдана").Равно(200);
	Ожидаем.Что(СтрНайти(Тело_, "Выслать письмо ещё раз") > 0, "кнопка повтора на месте")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "_csrf") > 0, "и форма несёт CSRF-поле").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область НегоднаяСсылка

&Тест
Процедура МусорВместоТокенаДаёт404АНеПятисотку() Экспорт

	Ответ = Клиент.GET("/confirm-email?token=oshub_cnf_1_нетакой");

	Ожидаем.Что(Ответ.КодСостояния, "такой ссылки нет").Равно(404);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Такой ссылки нет") > 0, "и страница это говорит")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура POSTСМусоромТожеНеРоняетСтраницу() Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить("token", "совсем не токен");

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, "");

	Ожидаем.Что(Ответ.КодСостояния, "подтверждать нечего").Равно(404);

КонецПроцедуры

&Тест
Процедура ЧужойМетодПолучаетAllow() Экспорт

	Запрос = Новый HTTPЗапрос("/confirm-email");
	Ответ = Клиент.Соединение().ВызватьHTTPМетод("PUT", Запрос);

	Ожидаем.Что(Ответ.КодСостояния, "метод не тот").Равно(405);
	Ожидаем.Что(Ответ.Заголовки.Получить("Allow"), "и хаб называет разрешённые")
		.Равно("GET, POST");

КонецПроцедуры

#КонецОбласти

#Область ПовторнаяОтправка

&Тест
Процедура ПовторБезCSRFНеПроходит() Экспорт

	Кука = ЗавестиАдмина();

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "форма без токена сессии отвергнута").Равно(403);

КонецПроцедуры

// Форму анонима хаб принимает, но на этом стенде почта не настроена — и он говорит
// об этом прямо, вместо того чтобы обещать письмо, которого не будет.
&Тест
Процедура ЗапросАнонимаБезПочтыНазываетСостояниеХаба() Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Поля.Вставить("учётка", "кто-угодно");

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, "");

	Ожидаем.Что(Ответ.КодСостояния, "почты на стенде нет — состояние хаба, а не отказ ему")
		.Равно(503);

КонецПроцедуры

// Ненастроенная почта — обычное состояние хаба, а не поломка: страница обязана внятно
// сказать «письмо выслать некуда», а не отдать пятисотку.
&Тест
Процедура ПриНенастроеннойПочтеПовторГоворитЧтоПисьмоНекуда() Экспорт

	Кука = АдминСАдресом();

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой("/confirm-email", Кука))));

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "почта на стенде не настроена").Равно(503);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "не настроена") > 0, "и страница это объясняет")
		.ЭтоИстина();

КонецПроцедуры

// Стенд стоит ровно на умолчаниях свежей инсталляции: подтверждение адреса включено,
// почта выключена. В таком состоянии регистрация не притворяется работающей.
&Тест
Процедура НаУмолчанияхИнсталляцииРегистрацияОтвечает503() Экспорт

	ЗавестиАдмина(); // до администратора регистрация закрыта гейтом онбординга

	Ответ = Клиент.POSTJSON("/api/v1/register",
		"{""логин"":""newbie"",""email"":""newbie@example.org"",""пароль"":""Password123!""}");

	Ожидаем.Что(Ответ.КодСостояния, "дело в настройке хаба, а не в данных человека")
		.Равно(503);
	Тело_ = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело_, "registration_mail_not_configured") > 0,
		"код причины назван: " + Тело_).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "настроить почту") > 0, "развилка «настроить почту»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "выключить подтверждение") > 0,
		"развилка «выключить подтверждение»").ЭтоИстина();

	// формы, которая гарантированно получит отказ, на странице нет вовсе
	Страница = Клиент.Тело(Клиент.GET("/register"));
	Ожидаем.Что(СтрНайти(Страница, "action=""/register""") > 0,
		"форма регистрации не рисуется").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Страница, "подтверждение адреса") > 0,
		"а страница объясняет, почему: " + Лев(Страница, 400)).ЭтоИстина();

КонецПроцедуры

// Хабу без почты слать письмо восстановления нечем: страница говорит это прямо
// и отсылает к администратору, а со страницы входа дороги туда нет вовсе.
&Тест
Процедура БезПочтыПутьВосстановленияНеПритворяетсяРабочим() Экспорт

	Ответ = Клиент.GET("/forgot-password");

	Ожидаем.Что(Ответ.КодСостояния, "путь честно закрыт").Равно(503);
	Страница = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Страница, "не настроена") > 0,
		"страница называет причину: " + Лев(Страница, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "администратору") > 0, "и отсылает к администратору")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "action=""/forgot-password""") > 0,
		"формы, которая ничего не даст, нет").ЭтоЛожь();

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/login")), "/forgot-password"),
		"со страницы входа дороги в неработающее восстановление нет").Равно(0);

КонецПроцедуры

// Тот же хаб, но с названными сервером и отправителем: путь открыт, со страницы входа
// туда ведёт ссылка, а ответ формы одинаков и на существующую учётку, и на выдуманную.
&Тест
Процедура СНастроеннойПочтойПутьВосстановленияОткрыт() Экспорт

	ХабВосстановления = Новый ЭкземплярХаба(90);
	ХабВосстановления.ФайловаяБаза("openhub-восстановление");
	ХабВосстановления.Среда("OSHUB_ADMIN_LOGIN", "recadmin");
	ХабВосстановления.Среда("OSHUB_ADMIN_PASSWORD", "RecAdminPass1");
	ХабВосстановления.Среда("OSHUB_MAIL_ENABLED", "true");
	ХабВосстановления.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
	ХабВосстановления.Среда("OSHUB_MAIL_FROM", "hub@example.com");
	ХабВосстановления.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");

	Попытка
		ХабВосстановления.Запустить();
		ПортВ = ХабВосстановления.Порт();
		ХабВосстановления.ДождатьсяОнбординга();

		Вход = Клиент.Тело(GETПорт(ПортВ, "/login"));
		Ожидаем.Что(СтрНайти(Вход, "/forgot-password") > 0,
			"со страницы входа есть путь «забыли пароль»").ЭтоИстина();

		Страница = GETПорт(ПортВ, "/forgot-password");
		Ожидаем.Что(Страница.КодСостояния, "страница отдана").Равно(200);
		Ожидаем.Что(СтрНайти(Клиент.Тело(Страница), "action=""/forgot-password""") > 0,
			"и на ней форма").ЭтоИстина();

		// ответ одинаков независимо от того, нашлась учётка: перебором логинов
		// существующие учётки не вычисляются
		Есть = POSTФормаПорт(ПортВ, "/forgot-password", "учётка=recadmin");
		Нет = POSTФормаПорт(ПортВ, "/forgot-password", "учётка=никого-такого-нет");
		Ожидаем.Что(Есть.КодСостояния, "исход существующей").Равно(200);
		Ожидаем.Что(Нет.КодСостояния, "исход несуществующей — тот же").Равно(200);
		Ожидаем.Что(Клиент.Тело(Нет), "и страница слово в слово та же").Равно(Клиент.Тело(Есть));

	Исключение
		ХабВосстановления.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабВосстановления.Остановить();

КонецПроцедуры

// Ссылка подтверждения обязана быть абсолютной и вести на адрес, по которому хаб доступен
// снаружи; угадывать его по заголовкам запроса хаб не берётся — значит, пока адрес
// инсталляции не задан, письма нет вовсе. Что почта при этом НАСТРОЕНА, доказывает сама
// регистрация: ненастроенную почту её застава отбивает 503-м, а здесь учётка заводится —
// и несостоявшееся письмо операцию не отменяет.
&Тест
Процедура БезАдресаИнсталляцииПисьмаНетДажеПриНастроеннойПочте() Экспорт

	ХабБезАдреса = Новый ЭкземплярХаба(90);
	ХабБезАдреса.ФайловаяБаза("openhub-без-адреса-инсталляции");
	ХабБезАдреса.Среда("OSHUB_ADMIN_LOGIN", "urladmin");
	ХабБезАдреса.Среда("OSHUB_ADMIN_PASSWORD", "UrlAdminPass1");
	ХабБезАдреса.Среда("OSHUB_MAIL_ENABLED", "true");
	ХабБезАдреса.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
	ХабБезАдреса.Среда("OSHUB_MAIL_FROM", "hub@example.com");
	ХабБезАдреса.Среда("OSHUB_INSTANCE_URL", "");

	Попытка
		ХабБезАдреса.Запустить();
		ПортБ = ХабБезАдреса.Порт();
		ХабБезАдреса.ДождатьсяОнбординга();

		Регистрация = POSTjsonПорт(ПортБ, "/api/v1/register",
			"{""логин"":""newbie"",""email"":""newbie@example.org"",""пароль"":""Password123!""}");
		Ожидаем.Что(Регистрация.КодСостояния,
			"почта настроена (иначе застава регистрации ответила бы 503), и учётка заведена: "
			+ Клиент.Тело(Регистрация)).Равно(201);

		// сессию открывает учётка БЕЗ адреса: подтверждать ей нечего, и вход ей не закрыт.
		// Новичок с адресом в неё не годится — неподтверждённому вход закрыт (ИСТ-ДОСТ-010)
		Кука = Клиент.КукаОтвета(POSTjsonПорт(ПортБ, "/api/v1/register",
			"{""логин"":""mailless"",""пароль"":""Password123!""}"), "oshub_session");

		// адрес появляется у уже вошедшего: сессия открыта, и цикл подтверждения ей доступен
		Профиль = Новый Соответствие();
		Профиль.Вставить("email", "mailless@example.org");
		Профиль.Вставить("_csrf",
			ИзвлечьCSRF(Клиент.Тело(GETКукаПорт(ПортБ, "/me/settings/profile", Кука))));
		Правка = POSTФормаКукойПорт(ПортБ, "/me/settings/profile", Профиль, Кука);
		Ожидаем.Что(Правка.КодСостояния = 200 ИЛИ Правка.КодСостояния = 302,
			"адрес учётки записан кабинетом: " + Правка.КодСостояния).ЭтоИстина();

		Поля = Новый Соответствие();
		Поля.Вставить("операция", "выслать");
		Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(GETКукаПорт(ПортБ, "/confirm-email", Кука))));

		Повтор = POSTФормаКукойПорт(ПортБ, "/confirm-email", Поля, Кука);
		Ожидаем.Что(Повтор.КодСостояния, "письма без внешнего адреса хаба нет").Равно(503);
		Ожидаем.Что(СтрНайти(Клиент.Тело(Повтор), "выслать некуда") > 0,
			"и человеку названа причина, а не «отправка сорвалась»: "
			+ Лев(Клиент.Тело(Повтор), 400)).ЭтоИстина();

	Исключение
		ХабБезАдреса.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабБезАдреса.Остановить();

КонецПроцедуры

#КонецОбласти

#Область ЗаголовкиПисьма

// Разрыв строки в адресе — попытка дописать в письмо чужой заголовок (Bcc и прочие).
// Барьер стоит на входе в учётку: такой адрес не доживает до записи, а значит и до письма.
// В подопытном адресе разрыв — ЕДИНСТВЕННЫЙ порок: собака одна, точка в домене есть,
// пробелов нет. Иначе его отбивала бы проверка формы адреса, и барьер разрывов остался бы
// непроверенным.
&Тест
Процедура АдресСРазрывомСтрокиВУчёткуНеПопадает() Экспорт

	Кука = АдминСАдресом();
	Хвост = "bcc-attacker.example.org";

	Поля = Новый Соответствие();
	Поля.Вставить("email", "root@example.org" + Символы.ВК + Символы.ПС + Хвост);
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));

	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "адрес с разрывом строки отвергнут, а не сохранён").Равно(400);

	Профиль = Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука));
	Ожидаем.Что(СтрНайти(Профиль, Хвост), "дописанного хвоста в учётке не появилось").Равно(0);
	Ожидаем.Что(СтрНайти(Профиль, "root@example.org") > 0,
		"а прежний адрес на месте — страница адреса печатает").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ВходДоПодтверждения

// Ради чего затевался весь цикл, глазами человека в браузере: регистрация внутрь не
// пускает, и вход той же парой логин-пароль отвечает отказом, пока адрес не подтверждён.
// Стенд свой: почта нужна настроенной, иначе застава закроет саму регистрацию.
&Тест
Процедура НовичокНеЛогинитсяПокаАдресНеПодтверждён() Экспорт

	ХабСПочтой = Новый ЭкземплярХаба(90);
	ХабСПочтой.ФайловаяБаза("openhub-вход-после-подтверждения");
	ХабСПочтой.Среда("OSHUB_ADMIN_LOGIN", "cnfadmin");
	ХабСПочтой.Среда("OSHUB_ADMIN_PASSWORD", "CnfAdminPass1");
	ХабСПочтой.Среда("OSHUB_MAIL_ENABLED", "true");
	ХабСПочтой.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
	ХабСПочтой.Среда("OSHUB_MAIL_FROM", "hub@example.com");
	ХабСПочтой.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");

	Попытка
		ХабСПочтой.Запустить();
		ПортХ = ХабСПочтой.Порт();
		ХабСПочтой.ДождатьсяОнбординга();

		Анкета = "логин=newcomer&email=newcomer%40example.org&пароль=Password123%21";
		Заведение = POSTФормаПорт(ПортХ, "/register", Анкета);

		Ожидаем.Что(Заведение.КодСостояния, "форма ответила страницей, а не входом в хаб")
			.Равно(200);
		Ожидаем.Что(Клиент.КукаОтвета(Заведение, "oshub_session"), "сессии не открылось").Равно("");
		Ожидаем.Что(СтрНайти(Клиент.Тело(Заведение), "Подтвердите адрес") > 0,
			"страница зовёт подтвердить адрес").ЭтоИстина();

		Вход = POSTФормаПорт(ПортХ, "/login", "логин=newcomer&пароль=Password123%21");

		Ожидаем.Что(Вход.КодСостояния, "и вход паролем закрыт").Равно(403);
		Ожидаем.Что(Клиент.КукаОтвета(Вход, "oshub_session"), "сессии не даёт и он").Равно("");
		Ожидаем.Что(СтрНайти(Клиент.Тело(Вход), "не подтверждён") > 0,
			"страница входа называет причину").ЭтоИстина();

	Исключение
		ХабСПочтой.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабСПочтой.Остановить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция GETПорт(Знач ПортХаба, Знач Путь)
	Возврат Новый HTTPСоединение("localhost", ПортХаба, , , , 20).Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция POSTФормаПорт(Знач ПортХаба, Знач Путь, Знач Тело_)

	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат Новый HTTPСоединение("localhost", ПортХаба, , , , 20).ОтправитьДляОбработки(Запрос);

КонецФункции

Функция GETКукаПорт(Знач ПортХаба, Знач Путь, Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Возврат Новый HTTPСоединение("localhost", ПортХаба, , , , 20).Получить(
		Новый HTTPЗапрос(Путь, Заголовки));

КонецФункции

Функция POSTjsonПорт(Знач ПортХаба, Знач Путь, Знач Тело_)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат Новый HTTPСоединение("localhost", ПортХаба, , , , 20).ОтправитьДляОбработки(Запрос);

КонецФункции

Функция POSTФормаКукойПорт(Знач ПортХаба, Знач Путь, Знач Поля, Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Клиент.КодированнаяФорма(Поля), КодировкаТекста.UTF8);
	Возврат Новый HTTPСоединение("localhost", ПортХаба, , , , 20).ОтправитьДляОбработки(Запрос);

КонецФункции

// Учётка администратора с адресом: мастер первого запуска адреса не спрашивает,
// поэтому его вписывает кабинет — ровно так же, как это делает человек.
Функция АдминСАдресом()

	Кука = ЗавестиАдмина();
	ЗадатьАдрес(Кука, "root@example.org");
	Возврат Кука;

КонецФункции

Процедура ЗадатьАдрес(Знач Кука, Знач Адрес)

	Поля = Новый Соответствие();
	Поля.Вставить("email", Адрес);
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));

	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 302,
		"адрес учётки записан кабинетом").ЭтоИстина();

КонецПроцедуры

// Сессия администратора живёт весь набор и войти заново не пытается: первый же тест,
// задавший админу адрес, закрывает парольный вход до подтверждения этого адреса, а почты
// у стенда нет. Человек в браузере в этом месте ровно так и сидит — в открытой сессии.
Функция ЗавестиАдмина()

	Если ЗначениеЗаполнено(КукаАдмина) Тогда
		Возврат КукаАдмина;
	КонецЕсли;

	Ответ = Клиент.POSTJSON("/setup",
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", ЛогинАдмина, ПарольАдмина));
	Если Ответ.КодСостояния = 201 Тогда
		КукаАдмина = Клиент.КукаОтвета(Ответ, "oshub_session");
	Иначе
		КукаАдмина = Клиент.КукаОтвета(Клиент.POSTJSON("/api/v1/login",
			СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", ЛогинАдмина, ПарольАдмина)),
			"oshub_session");
	КонецЕсли;

	Возврат КукаАдмина;

КонецФункции

Функция ИзвлечьCSRF(Знач ТелоСтраницы)

	Маркер = "name=""_csrf"" value=""";
	Позиция = СтрНайти(ТелоСтраницы, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(ТелоСтраницы, Позиция + СтрДлина(Маркер));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

#КонецОбласти
