// Сквозные HTTP-проверки публичной страницы /confirm-email на настоящем хабе: маршрут
// отвечает, негодная ссылка получает свой код, кнопка повторной отправки закрыта CSRF,
// а ненастроенная почта отвечает «письмо выслать некуда», а не пятисоткой.
// Отдельные тесты поднимают СВОЙ стенд с другой настройкой почты: с настроенной почтой
// (путь восстановления пароля), с настроенной почтой без внешнего адреса инсталляции
// и с подставным SMTP фикстуры ЛовушкаПисем — там письмо хаба читается целиком, а учётку
// заводит настоящий вход через фейкового провайдера. У каждого стенда свой КлиентХаба.
// Кабинет, высылающий письмо подтверждения, проверяется на общем для своих тестов стенде
// кабинета — с подставным SMTP и администратором, который правит настройки хаба.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;
Перем ЛогинАдмина;
Перем ПарольАдмина;
Перем КукаАдмина;     // сессия администратора стенда: заводится один раз на набор
Перем Клиент;         // фикстура КлиентХаба — все запросы к подопытному хабу
Перем ИмяПровайдера;  // идентификатор фейкового IdP в настройках стенда с провайдером

// стенд кабинета поднимается один раз на те тесты, которым нужно само письмо
Перем СтендКабинета;       // фикстура ЭкземплярХаба с почтой на подставном SMTP
Перем КлиентКабинета;      // фикстура КлиентХаба стенда кабинета
Перем ЛовушкаКабинета;     // фикстура ЛовушкаПисем стенда кабинета
Перем КукаКабинета;        // сессия человека: адрес ему вписывает кабинет
Перем КукаАдминаКабинета;  // сессия администратора стенда кабинета: правит настройки хаба

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ЛогинАдмина = "root";
	ПарольАдмина = "RootPassw0rd1";
	ИмяПровайдера = "fake";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ЛовушкаПисем");
	РеестрФикстур.Подключить("ЭкземплярФейковогоIdP");

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.ФайловаяБаза("openhub-подтверждение-адреса");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	// внешний адрес задан, чтобы единственным недостающим для письма оставалась ПОЧТА:
	// иначе «нечем слать» доказывалось бы отсутствием адреса хаба, а не отсутствием почты
	Хаб.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");
	Хаб.Запустить();
	Клиент = Новый КлиентХаба(Хаб, 20);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	ОстановитьСтендКабинета();
КонецПроцедуры

#Область СтраницаБезСсылки

// Аноним здесь — это как раз тот, кого вход не пустил из-за неподтверждённого адреса.
// Отправлять его «войти в учётную запись» значит замкнуть круг, поэтому страница даёт
// форму: назови себя — вышлем письмо.
&Тест
Процедура АнонимуСтраницаДаётФормуЗапросаПисьма() Экспорт

	Ответ = Клиент.GET("/confirm-email");
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "страница публична").Равно(200);
	Ожидаем.Что(СтрНайти(Тело_, "name=""учётка""") > 0,
		"на странице поле для логина или адреса").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "Выслать письмо") > 0, "и кнопка запроса").ЭтоИстина();

КонецПроцедуры

// Учётка без адреса — обычное состояние: мастер первого запуска адреса не спрашивает.
// Страница обязана сказать, что подтверждать нечего, и не рисовать кнопку, которая
// заведомо ничего не вышлет. Тест стоит ДО того, что вписывает адрес администратору:
// другой безадресной учётки на стенде нет.
&Тест
Процедура УчёткеБезАдресаПодтверждатьНечегоИКнопкиПовтораЕйНеРисуют() Экспорт

	Кука = ЗавестиАдмина();

	Ответ = Клиент.GETСКукой("/confirm-email", Кука);
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "страница отдана").Равно(200);
	Ожидаем.Что(СтрНайти(Тело_, "не указан адрес") > 0,
		"названа причина, а не общее «что-то не так»: " + Лев(Тело_, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "Выслать письмо ещё раз"),
		"кнопки, которой нечего высылать, на странице нет").Равно(0);

	// форму собирают и без кнопки: отказ обязан быть на сервере, а не в разметке
	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));

	Повтор = Клиент.POSTФормы("/confirm-email", Поля, Кука);
	Ожидаем.Что(Повтор.КодСостояния, "письма учётке без адреса не выпускаются вовсе").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Повтор), "не указан адрес") > 0,
		"и отказ называет ту же причину, что страница").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВошедшемуСНеподтверждённымАдресомПоказываютКнопкуПовтора() Экспорт

	Кука = АдминСАдресом();

	Ответ = Клиент.GETСКукой("/confirm-email", Кука);
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "страница отдана").Равно(200);
	Ожидаем.Что(СтрНайти(Тело_, "Выслать письмо ещё раз") > 0, "кнопка повтора на месте")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "_csrf") > 0, "и форма несёт CSRF-поле").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область НегоднаяСсылка

&Тест
Процедура МусорВместоТокенаДаёт404АНеПятисотку() Экспорт

	Ответ = Клиент.GET("/confirm-email?token=oshub_cnf_1_нетакой");

	Ожидаем.Что(Ответ.КодСостояния, "такой ссылки нет").Равно(404);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Такой ссылки нет") > 0, "и страница это говорит")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура POSTСМусоромТожеНеРоняетСтраницу() Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить("token", "совсем не токен");

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, "");

	Ожидаем.Что(Ответ.КодСостояния, "подтверждать нечего").Равно(404);

КонецПроцедуры

&Тест
Процедура ЧужойМетодПолучаетAllow() Экспорт

	Запрос = Новый HTTPЗапрос("/confirm-email");
	Ответ = Клиент.Соединение().ВызватьHTTPМетод("PUT", Запрос);

	Ожидаем.Что(Ответ.КодСостояния, "метод не тот").Равно(405);
	Ожидаем.Что(Ответ.Заголовки.Получить("Allow"), "и хаб называет разрешённые")
		.Равно("GET, POST");

КонецПроцедуры

#КонецОбласти

#Область ПовторнаяОтправка

&Тест
Процедура ПовторБезCSRFНеПроходит() Экспорт

	Кука = ЗавестиАдмина();

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "форма без токена сессии отвергнута").Равно(403);

КонецПроцедуры

// Форму анонима хаб принимает, но на этом стенде почта не настроена — и он говорит
// об этом прямо, вместо того чтобы обещать письмо, которого не будет.
&Тест
Процедура ЗапросАнонимаБезПочтыНазываетСостояниеХаба() Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Поля.Вставить("учётка", "кто-угодно");

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, "");

	Ожидаем.Что(Ответ.КодСостояния, "почты на стенде нет — состояние хаба, а не отказ ему")
		.Равно(503);

КонецПроцедуры

// Ненастроенная почта — обычное состояние хаба, а не поломка: страница обязана внятно
// сказать «письмо выслать некуда», а не отдать пятисотку.
&Тест
Процедура ПриНенастроеннойПочтеПовторГоворитЧтоПисьмоНекуда() Экспорт

	Кука = АдминСАдресом();

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/confirm-email", Кука))));

	Ответ = Клиент.POSTФормы("/confirm-email", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "почта на стенде не настроена").Равно(503);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "не настроена") > 0, "и страница это объясняет")
		.ЭтоИстина();

КонецПроцедуры

// Стенд стоит ровно на умолчаниях свежей инсталляции: подтверждение адреса включено,
// почта выключена. В таком состоянии регистрация не притворяется работающей.
&Тест
Процедура НаУмолчанияхИнсталляцииРегистрацияОтвечает503() Экспорт

	ЗавестиАдмина(); // до администратора регистрация закрыта гейтом онбординга

	Ответ = Клиент.POSTJSON("/api/v1/register",
		"{""логин"":""newbie"",""email"":""newbie@example.org"",""пароль"":""Password123!""}");

	Ожидаем.Что(Ответ.КодСостояния, "дело в настройке хаба, а не в данных человека")
		.Равно(503);
	Тело_ = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело_, "registration_mail_not_configured") > 0,
		"код причины назван: " + Тело_).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "настроить почту") > 0, "развилка «настроить почту»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "выключить подтверждение") > 0,
		"развилка «выключить подтверждение»").ЭтоИстина();

	// формы, которая гарантированно получит отказ, на странице нет вовсе
	Страница = Клиент.Тело(Клиент.GET("/register"));
	Ожидаем.Что(СтрНайти(Страница, "action=""/register""") > 0,
		"форма регистрации не рисуется").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Страница, "подтверждение адреса") > 0,
		"а страница объясняет, почему: " + Лев(Страница, 400)).ЭтоИстина();

КонецПроцедуры

// Хабу без почты слать письмо восстановления нечем: страница говорит это прямо
// и отсылает к администратору, а со страницы входа дороги туда нет вовсе.
&Тест
Процедура БезПочтыПутьВосстановленияНеПритворяетсяРабочим() Экспорт

	Ответ = Клиент.GET("/forgot-password");

	Ожидаем.Что(Ответ.КодСостояния, "путь честно закрыт").Равно(503);
	Страница = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Страница, "не настроена") > 0,
		"страница называет причину: " + Лев(Страница, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "администратору") > 0, "и отсылает к администратору")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "action=""/forgot-password""") > 0,
		"формы, которая ничего не даст, нет").ЭтоЛожь();

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/login")), "/forgot-password"),
		"со страницы входа дороги в неработающее восстановление нет").Равно(0);

КонецПроцедуры

// Тот же хаб, но с названными сервером и отправителем: путь открыт, со страницы входа
// туда ведёт ссылка, а ответ формы одинаков и на существующую учётку, и на выдуманную.
&Тест
Процедура СНастроеннойПочтойПутьВосстановленияОткрыт() Экспорт

	ХабВосстановления = Новый ЭкземплярХаба(90);
	ХабВосстановления.ФайловаяБаза("openhub-восстановление");
	ХабВосстановления.Среда("OSHUB_ADMIN_LOGIN", "recadmin");
	ХабВосстановления.Среда("OSHUB_ADMIN_PASSWORD", "RecAdminPass1");
	ХабВосстановления.Среда("OSHUB_MAIL_ENABLED", "true");
	ХабВосстановления.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
	ХабВосстановления.Среда("OSHUB_MAIL_FROM", "hub@example.com");
	ХабВосстановления.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");

	КлиентВосстановления = Новый КлиентХаба(ХабВосстановления, 20);

	Попытка
		ХабВосстановления.Запустить();
		ХабВосстановления.ДождатьсяОнбординга();

		Вход = КлиентВосстановления.Тело(КлиентВосстановления.GET("/login"));
		Ожидаем.Что(СтрНайти(Вход, "/forgot-password") > 0,
			"со страницы входа есть путь «забыли пароль»").ЭтоИстина();

		Страница = КлиентВосстановления.GET("/forgot-password");
		Ожидаем.Что(Страница.КодСостояния, "страница отдана").Равно(200);
		Ожидаем.Что(СтрНайти(КлиентВосстановления.Тело(Страница),
			"action=""/forgot-password""") > 0, "и на ней форма").ЭтоИстина();

		// ответ одинаков независимо от того, нашлась учётка: перебором логинов
		// существующие учётки не вычисляются
		Есть = КлиентВосстановления.POSTФормы("/forgot-password", "учётка=recadmin", "");
		Нет = КлиентВосстановления.POSTФормы("/forgot-password", "учётка=никого-такого-нет", "");
		Ожидаем.Что(Есть.КодСостояния, "исход существующей").Равно(200);
		Ожидаем.Что(Нет.КодСостояния, "исход несуществующей — тот же").Равно(200);
		Ожидаем.Что(КлиентВосстановления.Тело(Нет), "и страница слово в слово та же")
			.Равно(КлиентВосстановления.Тело(Есть));

	Исключение
		ХабВосстановления.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабВосстановления.Остановить();

КонецПроцедуры

// Сквозной сценарий целиком: человек входит через провайдера — хаб заводит ему учётку
// без пароля с адресом, за который поручился IdP. Потом человек возвращается анонимом,
// жмёт «Забыли пароль?» и доходит до входа: письмо, ссылка, новый пароль, вход этим
// паролем. Письмо принимает подставной SMTP на своём порту — настоящего почтового
// сервера у стендов нет.
&Тест
Процедура УчёткаИзПровайдераВосстанавливаетПарольПисьмом() Экспорт

	// адрес и логин РАЗНОГО корня: иначе «форма называет, чья это учётка» прошло бы
	// и при печати адреса вместо логина
	АдресЧеловека = "recovered@example.org";
	// логин заведённой учётке хаб берёт из preferred_username провайдера; разойдись это —
	// форма «забыли пароль» никого не найдёт, и письма не будет вовсе
	Логин = "idpuser";
	НовыйПароль = "RecoveredPass1!";

	Ловушка = Новый ЛовушкаПисем();
	IdP = Неопределено;
	ХабПровайдера = Неопределено;

	Попытка
		ПортПочты = Ловушка.Слушать();

		IdP = Новый ЭкземплярФейковогоIdP("хаб-клиент", "субъект-восстановления",
			АдресЧеловека, 60, Логин);
		IdP.Запустить();

		ХабПровайдера = Новый ЭкземплярХаба(90);
		НастроитьСтендПровайдера(ХабПровайдера, IdP, ПортПочты);
		ХабПровайдера.Запустить();
		ХабПровайдера.ДождатьсяОнбординга();
		КлиентПровайдера = Новый КлиентХаба(ХабПровайдера, 20);

		ВойтиПровайдером(КлиентПровайдера);

		// дальше человек аноним: сессии провайдера у него нет, как и пароля
		Просьба = КлиентПровайдера.POSTФормы("/forgot-password", "учётка=" + Логин, "");
		Ожидаем.Что(Просьба.КодСостояния, "форма «забыли пароль» приняла просьбу").Равно(200);

		Письмо = Ловушка.ДождатьсяПисьма(60);
		Ожидаем.Что(Ловушка.ПолучательКонверта(),
			"хаб велел доставить письмо на адрес учётки").Равно(АдресЧеловека);
		Ожидаем.Что(СтрНайти(Письмо, "To: " + АдресЧеловека) > 0,
			"и в самом письме назван тот же адресат: " + Лев(Письмо, 600)).ЭтоИстина();

		Токен = Ловушка.ТокенИзПисьма(Письмо);
		Ожидаем.Что(ЗначениеЗаполнено(Токен),
			"и несёт ссылку установки пароля: " + Лев(Письмо, 600)).ЭтоИстина();

		Форма = КлиентПровайдера.GET("/invite?token=" + Токен);
		Ожидаем.Что(Форма.КодСостояния, "ссылка из письма открывает форму пароля").Равно(200);
		Ожидаем.Что(СтрНайти(КлиентПровайдера.Тело(Форма), Логин) > 0,
			"и форма называет, чья это учётка").ЭтоИстина();

		Установка = КлиентПровайдера.POSTФормыБезПереходов("/invite",
			ПоляУстановкиПароля(Токен, НовыйПароль));
		Ожидаем.Что(Установка.КодСостояния,
			"пароль принят, человек уведён в кабинет: " + Лев(Установка.Текст(), 500))
			.Равно(302);

		Вход = КлиентПровайдера.POSTФормыБезПереходов("/login",
			ПоляВхода(Логин, НовыйПароль));
		Ожидаем.Что(ЗначениеЗаполнено(КлиентПровайдера.КукаОтвета(Вход, "oshub_session")),
			СтрШаблон("вход новым паролем открыл сессию (код %1): %2",
				Вход.КодСостояния, Лев(Вход.Текст(), 500))).ЭтоИстина();

		// журнал этого пути читают шире, чем почтовый ящик: ни консоль хаба, ни журнал
		// аудита ящика человека не называют, а домен, куда ушло письмо, — называют
		ХабПровайдера.ДождатьсяСтрокиЖурнала("принял письмо получателю", 60);
		Консоль_ = ХабПровайдера.Дамп();
		Ожидаем.Что(СтрНайти(Консоль_, "получателю r***@example.org") > 0,
			"консоль называет домен получателя: " + Прав(Консоль_, 2000)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Консоль_, АдресЧеловека),
			"ящика человека в консоли хаба нет: " + Прав(Консоль_, 2000)).Равно(0);

		Аудит = СтрокаАудитаСДействием(ХабПровайдера, "восстановление.письмо");
		Ожидаем.Что(СтрНайти(Аудит, """адрес"":""r***@example.org""") > 0,
			"запись аудита о письме называет домен: " + Аудит).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Аудит, АдресЧеловека),
			"ящика человека в журнале аудита нет: " + Аудит).Равно(0);

	Исключение
		ОстановитьСтендПровайдера(ХабПровайдера, IdP, Ловушка);
		ВызватьИсключение;
	КонецПопытки;

	ОстановитьСтендПровайдера(ХабПровайдера, IdP, Ловушка);

КонецПроцедуры

// Ссылка подтверждения обязана быть абсолютной и вести на адрес, по которому хаб доступен
// снаружи; угадывать его по заголовкам запроса хаб не берётся — значит, пока адрес
// инсталляции не задан, письма нет вовсе. Что почта при этом НАСТРОЕНА, доказывает сама
// регистрация: ненастроенную почту её застава отбивает 503-м, а здесь учётка заводится —
// и несостоявшееся письмо операцию не отменяет.
&Тест
Процедура БезАдресаИнсталляцииПисьмаНетДажеПриНастроеннойПочте() Экспорт

	ХабБезАдреса = Новый ЭкземплярХаба(90);
	ХабБезАдреса.ФайловаяБаза("openhub-без-адреса-инсталляции");
	ХабБезАдреса.Среда("OSHUB_ADMIN_LOGIN", "urladmin");
	ХабБезАдреса.Среда("OSHUB_ADMIN_PASSWORD", "UrlAdminPass1");
	ХабБезАдреса.Среда("OSHUB_MAIL_ENABLED", "true");
	ХабБезАдреса.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
	ХабБезАдреса.Среда("OSHUB_MAIL_FROM", "hub@example.com");
	ХабБезАдреса.Среда("OSHUB_INSTANCE_URL", "");

	КлиентБезАдреса = Новый КлиентХаба(ХабБезАдреса, 20);

	Попытка
		ХабБезАдреса.Запустить();
		ХабБезАдреса.ДождатьсяОнбординга();

		Регистрация = КлиентБезАдреса.POSTJSON("/api/v1/register",
			"{""логин"":""newbie"",""email"":""newbie@example.org"",""пароль"":""Password123!""}");
		Ожидаем.Что(Регистрация.КодСостояния,
			"почта настроена (иначе застава регистрации ответила бы 503), и учётка заведена: "
			+ КлиентБезАдреса.Тело(Регистрация)).Равно(201);

		// сессию открывает учётка БЕЗ адреса: подтверждать ей нечего, и вход ей не закрыт.
		// Новичок с адресом в неё не годится — неподтверждённому вход закрыт (ИСТ-ДОСТ-010)
		Кука = КлиентБезАдреса.КукаОтвета(КлиентБезАдреса.POSTJSON("/api/v1/register",
			"{""логин"":""mailless"",""пароль"":""Password123!""}"), "oshub_session");

		// адрес появляется у уже вошедшего: кабинет пишет его и тут же пытается выслать
		// письмо — и называет причину, по которой письма нет
		Профиль = Новый Соответствие();
		Профиль.Вставить("email", "mailless@example.org");
		Профиль.Вставить("_csrf", КлиентБезАдреса.ТокенCSRF(
			КлиентБезАдреса.Тело(КлиентБезАдреса.GETСКукой("/me/settings/profile", Кука))));
		Правка = КлиентБезАдреса.POSTФормы("/me/settings/profile", Профиль, Кука);
		Ожидаем.Что(Правка.КодСостояния, "адрес записан, и кабинет отвечает сам").Равно(200);
		Ожидаем.Что(СтрНайти(КлиентБезАдреса.Тело(Правка), "внешний адрес") > 0,
			"ответ на сохранение называет, почему письма нет: "
			+ Лев(КлиентБезАдреса.Тело(Правка), 400)).ЭтоИстина();

		Кабинет = КлиентБезАдреса.Тело(КлиентБезАдреса.GETСКукой("/me/settings/profile", Кука));
		Ожидаем.Что(ФормаПовтора(Кабинет), "кнопки, которая ничего не вышлет, в кабинете нет")
			.Равно(Неопределено);
		Ожидаем.Что(СтрНайти(Кабинет, "внешний адрес") > 0,
			"страница кабинета держит ту же причину").ЭтоИстина();

		// та же причина теми же словами и на странице /confirm-email
		Поля = Новый Соответствие();
		Поля.Вставить("операция", "выслать");
		Поля.Вставить("_csrf", КлиентБезАдреса.ТокенCSRF(
			КлиентБезАдреса.Тело(КлиентБезАдреса.GETСКукой("/confirm-email", Кука))));

		Повтор = КлиентБезАдреса.POSTФормы("/confirm-email", Поля, Кука);
		Ожидаем.Что(Повтор.КодСостояния, "письма без внешнего адреса хаба нет").Равно(503);
		Ожидаем.Что(СтрНайти(КлиентБезАдреса.Тело(Повтор), "внешний адрес") > 0,
			"и человеку названа причина, а не «отправка сорвалась»: "
			+ Лев(КлиентБезАдреса.Тело(Повтор), 400)).ЭтоИстина();

	Исключение
		ХабБезАдреса.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабБезАдреса.Остановить();

КонецПроцедуры

#КонецОбласти

#Область ЗаголовкиПисьма

// Разрыв строки в адресе — попытка дописать в письмо чужой заголовок (Bcc и прочие).
// Барьер стоит на входе в учётку: такой адрес не доживает до записи, а значит и до письма.
// В подопытном адресе разрыв — ЕДИНСТВЕННЫЙ порок: собака одна, точка в домене есть,
// пробелов нет. Иначе его отбивала бы проверка формы адреса, и барьер разрывов остался бы
// непроверенным.
&Тест
Процедура АдресСРазрывомСтрокиВУчёткуНеПопадает() Экспорт

	Кука = АдминСАдресом();
	Хвост = "bcc-attacker.example.org";

	Поля = Новый Соответствие();
	Поля.Вставить("email", "root@example.org" + Символы.ВК + Символы.ПС + Хвост);
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));

	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "адрес с разрывом строки отвергнут, а не сохранён").Равно(400);

	Профиль = Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука));
	Ожидаем.Что(СтрНайти(Профиль, Хвост), "дописанного хвоста в учётке не появилось").Равно(0);
	Ожидаем.Что(СтрНайти(Профиль, "root@example.org") > 0,
		"а прежний адрес на месте — страница адреса печатает").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ВходДоПодтверждения

// Ради чего затевался весь цикл, глазами человека в браузере: регистрация внутрь не
// пускает, и вход той же парой логин-пароль отвечает отказом, пока адрес не подтверждён.
// Стенд свой: почта нужна настроенной, иначе застава закроет саму регистрацию.
&Тест
Процедура НовичокНеЛогинитсяПокаАдресНеПодтверждён() Экспорт

	ХабСПочтой = Новый ЭкземплярХаба(90);
	ХабСПочтой.ФайловаяБаза("openhub-вход-после-подтверждения");
	ХабСПочтой.Среда("OSHUB_ADMIN_LOGIN", "cnfadmin");
	ХабСПочтой.Среда("OSHUB_ADMIN_PASSWORD", "CnfAdminPass1");
	ХабСПочтой.Среда("OSHUB_MAIL_ENABLED", "true");
	ХабСПочтой.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
	ХабСПочтой.Среда("OSHUB_MAIL_FROM", "hub@example.com");
	ХабСПочтой.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");

	КлиентСПочтой = Новый КлиентХаба(ХабСПочтой, 20);

	Попытка
		ХабСПочтой.Запустить();
		ХабСПочтой.ДождатьсяОнбординга();

		Анкета = "логин=newcomer&email=newcomer%40example.org&пароль=Password123%21";
		Заведение = КлиентСПочтой.POSTФормы("/register", Анкета, "");

		Ожидаем.Что(Заведение.КодСостояния, "форма ответила страницей, а не входом в хаб")
			.Равно(200);
		Ожидаем.Что(КлиентСПочтой.КукаОтвета(Заведение, "oshub_session"),
			"сессии не открылось").Равно("");
		Ожидаем.Что(СтрНайти(КлиентСПочтой.Тело(Заведение), "Подтвердите адрес") > 0,
			"страница зовёт подтвердить адрес").ЭтоИстина();

		Вход = КлиентСПочтой.POSTФормы("/login", "логин=newcomer&пароль=Password123%21", "");

		Ожидаем.Что(Вход.КодСостояния, "и вход паролем закрыт").Равно(403);
		Ожидаем.Что(КлиентСПочтой.КукаОтвета(Вход, "oshub_session"), "сессии не даёт и он")
			.Равно("");
		Ожидаем.Что(СтрНайти(КлиентСПочтой.Тело(Вход), "не подтверждён") > 0,
			"страница входа называет причину").ЭтоИстина();

	Исключение
		ХабСПочтой.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабСПочтой.Остановить();

КонецПроцедуры

#КонецОбласти

#Область ПисьмоИзКабинета

// Учётка, заведённая без адреса, вписывает его в кабинете — и письмо приходит сразу:
// отдельного похода на /confirm-email человеку не нужно, а кабинет говорит, куда оно ушло.
&Тест
Процедура КабинетВыпускаетПисьмоПодтвержденияНовомуАдресу() Экспорт

	ПоднятьСтендКабинета();
	Кука = НоваяСессияНаСтенде("noaddr");
	Адрес = "first@example.org";

	Профиль = КлиентКабинета.Тело(КлиентКабинета.GETСКукой("/me/settings/profile", Кука));
	Ожидаем.Что(ФормаСо(Профиль, "name=""email""").Поля.Получить("email"),
		"адреса у учётки не было").Равно("");

	Ответ = ВписатьАдресНаСтенде(Адрес, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "адрес записан, и кабинет отвечает сам").Равно(200);
	Ожидаем.Что(СтрНайти(КлиентКабинета.Тело(Ответ), "Письмо отправлено на " + Адрес) > 0,
		"кабинет говорит, куда ушло письмо: " + Лев(КлиентКабинета.Тело(Ответ), 400)).ЭтоИстина();

	Письмо = ЛовушкаКабинета.ДождатьсяПисьма(60);
	Ожидаем.Что(ЛовушкаКабинета.ПолучательКонверта(), "письмо ушло на новый адрес").Равно(Адрес);
	Ожидаем.Что(СтрНайти(ЛовушкаКабинета.ТокенИзПисьма(Письмо), "oshub_cnf_") = 1,
		"и несёт ссылку подтверждения: " + Лев(Письмо, 600)).ЭтоИстина();

КонецПроцедуры

// Письмо потерялось — человек просит новое прямо из кабинета, не зная адреса /confirm-email.
&Тест
Процедура КабинетПовторяетПисьмоПоКнопке() Экспорт

	ПоднятьСтендКабинета();
	Адрес = "resend@example.org";
	ВписатьАдресНаСтенде(Адрес);
	Первое = ЛовушкаКабинета.ДождатьсяПисьма(60);

	// нажатие собирается из отрисованной формы, а не руками: потеряй страница поле операции,
	// нажатие ушло бы сохранять профиль без адреса
	Кабинет = КлиентКабинета.Тело(КлиентКабинета.GETСКукой("/me/settings/profile", КукаКабинета));
	Кнопка = ФормаСо(Кабинет, КнопкаПовтора());
	Ожидаем.Что(Кнопка, "у неподтверждённого адреса есть действие повтора").Существует();
	Ожидаем.Что(Кнопка.Поля.Получить("операция"), "форма несёт операцию повтора")
		.Равно("выслать");
	Ожидаем.Что(Кнопка.Поля.Получить("email"), "и не несёт поля адреса").Равно(Неопределено);

	Ответ = КлиентКабинета.POSTФормы(Кнопка.Действие, Кнопка.Поля, КукаКабинета);

	Ожидаем.Что(Ответ.КодСостояния, "повтор принят").Равно(200);
	Ожидаем.Что(СтрНайти(КлиентКабинета.Тело(Ответ), "Письмо отправлено на " + Адрес) > 0,
		"кабинет говорит, что произошло: " + Лев(КлиентКабинета.Тело(Ответ), 400)).ЭтоИстина();

	Второе = ЛовушкаКабинета.ДождатьсяПисьма(60);
	Ожидаем.Что(ЛовушкаКабинета.ПолучательКонверта(), "письмо ушло на адрес учётки").Равно(Адрес);
	Ожидаем.Что(ЗначениеЗаполнено(ЛовушкаКабинета.ТокенИзПисьма(Второе)), "письмо несёт ссылку")
		.ЭтоИстина();
	Ожидаем.Что(ЛовушкаКабинета.ТокенИзПисьма(Второе), "и ссылка в нём новая")
		.Не_().Равно(ЛовушкаКабинета.ТокенИзПисьма(Первое));

КонецПроцедуры

// «Сохранить» без правки поля: подтверждённый адрес остаётся подтверждённым, письма нет.
&Тест
Процедура СохранениеТогоЖеАдресаПодтвержденияНеСнимаетИПисьмаНеШлёт() Экспорт

	ПоднятьСтендКабинета();
	Адрес = "same@example.org";
	ВписатьАдресНаСтенде(Адрес);
	Токен = ЛовушкаКабинета.ТокенИзПисьма(ЛовушкаКабинета.ДождатьсяПисьма(60));

	Ссылка = Новый Соответствие();
	Ссылка.Вставить("token", Токен);
	Подтверждение = КлиентКабинета.POSTФормы("/confirm-email", Ссылка, КукаКабинета);
	Ожидаем.Что(Подтверждение.КодСостояния, "адрес подтверждён ссылкой из письма").Равно(200);

	Ответ = ВписатьАдресНаСтенде("  " + ВРег(Адрес) + " ");
	Ожидаем.Что(Ответ.КодСостояния < 400, "сохранение принято: " + Ответ.КодСостояния)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(КлиентКабинета.Тело(Ответ), "Письмо отправлено"),
		"о письме кабинет не говорит").Равно(0);

	Кабинет = КлиентКабинета.Тело(КлиентКабинета.GETСКукой("/me/settings/profile", КукаКабинета));
	Ожидаем.Что(ФормаПовтора(Кабинет), "повторять нечего").Равно(Неопределено);
	Ожидаем.Что(ЛовушкаКабинета.ДождатьсяПисьма(5), "письма не было").Равно("");
	Ожидаем.Что(СтрНайти(Кабинет, "Email подтверждён") > 0, "подтверждение не снято: "
		+ Лев(Кабинет, 400)).ЭтоИстина();

КонецПроцедуры

// Подтверждение выключено настройкой хаба: адрес сохраняется, письма нет, а кабинет вместо
// кнопки повтора говорит, что подтверждение выключено. Почта на стенде настроена — без
// выключателя кнопка была бы на месте, так что пропадает она именно из-за него.
&Тест
Процедура ПриВыключенномПодтвержденииКабинетКнопкиНеРисует() Экспорт

	ПоднятьСтендКабинета();
	Кука = НоваяСессияНаСтенде("policyoff");

	ПодтверждениеНаСтенде(Ложь);
	Попытка
		Ответ = ВписатьАдресНаСтенде("policyoff@example.org", Кука);
		Кабинет = КлиентКабинета.Тело(КлиентКабинета.GETСКукой("/me/settings/profile", Кука));
		Повтор = КлиентКабинета.POSTФормы("/me/settings/profile",
			ПоляПовтора(КлиентКабинета.ТокенCSRF(Кабинет)), Кука);
	Исключение
		ПодтверждениеНаСтенде(Истина);
		ВызватьИсключение;
	КонецПопытки;
	ПодтверждениеНаСтенде(Истина);

	Ожидаем.Что(Ответ.КодСостояния, "адрес записан").Равно(200);
	Ожидаем.Что(ФормаПовтора(Кабинет), "действия повтора нет").Равно(Неопределено);
	Ожидаем.Что(Повтор.КодСостояния, "собранный руками повтор отвергнут состоянием хаба")
		.Равно(503);
	Ожидаем.Что(ЛовушкаКабинета.ДождатьсяПисьма(5), "письма не было").Равно("");
	Ожидаем.Что(СтрНайти(Кабинет, "выключено") > 0,
		"причина названа словами: " + Лев(Кабинет, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кабинет, "Email не подтверждён") > 0,
		"а подпись о неподтверждённом адресе осталась — это факт").ЭтоИстина();

КонецПроцедуры

// Стенд без почты: адрес сохраняется, а кабинет прямо говорит, почему письма не будет, —
// и в ответе на сохранение, и на странице вместо кнопки, которая ничего не вышлет.
&Тест
Процедура ПриНенастроеннойПочтеКабинетНазываетПричину() Экспорт

	Кука = ЗавестиАдмина();

	Поля = Новый Соответствие();
	Поля.Вставить("email", "nomail@example.org");
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));
	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "адрес записан").Равно(200);
	Тело_ = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело_, "Изменения сохранены") > 0, "сохранение удалось").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "не настроена") > 0,
		"и кабинет называет, почему письма нет: " + Лев(Тело_, 400)).ЭтоИстина();

	Кабинет = Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука));
	Ожидаем.Что(ФормаПовтора(Кабинет), "кнопки, которая ничего не вышлет, нет")
		.Равно(Неопределено);
	Ожидаем.Что(СтрНайти(Кабинет, "не настроена") > 0,
		"страница кабинета держит ту же причину").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ФормаПрофиля

// Форма без поля адреса — не сохранение профиля: потерянное поле не снимает с учётки почту.
&Тест
Процедура ФормаБезПоляАдресаАдресНеТрогаетИОтвечает400() Экспорт

	Кука = АдминСАдресом();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));
	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "форма без поля адреса отвергнута").Равно(400);
	Ожидаем.Что(АдресВКабинете(Кука), "адрес учётки на месте").Равно("root@example.org");

КонецПроцедуры

// Пустое поле адреса по-прежнему снимает почту с учётки — без письма и без отказа.
&Тест
Процедура ПустоеПолеАдресаОчищаетАдрес() Экспорт

	Кука = АдминСАдресом();

	Поля = Новый Соответствие();
	Поля.Вставить("email", "");
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));
	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния < 400, "очистка принята: " + Ответ.КодСостояния).ЭтоИстина();
	Ожидаем.Что(АдресВКабинете(Кука), "адреса у учётки больше нет").Равно("");
	Ожидаем.Что(ФормаПовтора(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))),
		"и подтверждать нечего").Равно(Неопределено);

КонецПроцедуры

// Повтор письма — мутация: без токена сессии форма отвергается.
&Тест
Процедура ПовторПисьмаИзКабинетаБезCSRFНеПроходит() Экспорт

	Кука = АдминСАдресом();

	Ответ = Клиент.POSTФормы("/me/settings/profile", ПоляПовтора(""), Кука);

	Ожидаем.Что(Ответ.КодСостояния, "форма без токена сессии отвергнута").Равно(403);

КонецПроцедуры

// Неизвестная операция — отказ, а не «сохранить»: адрес, приехавший с ней, не записан.
&Тест
Процедура НеизвестнаяОперацияПрофиляОтвечает400() Экспорт

	Кука = АдминСАдресом();

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "удалить");
	Поля.Вставить("email", "other@example.org");
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));
	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "неизвестная операция отвергнута").Равно(400);
	Ожидаем.Что(АдресВКабинете(Кука), "адрес учётки прежний").Равно("root@example.org");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Стенд с почтой на подставном SMTP: письма кабинета читаются целиком. Сессию открывает
// регистрация без адреса — вход такой учётке не закрыт, а адрес ей потом вписывает кабинет.
Процедура ПоднятьСтендКабинета()

	Если СтендКабинета <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЛовушкаКабинета = Новый ЛовушкаПисем();
		ПортПочты = ЛовушкаКабинета.Слушать();

		СтендКабинета = Новый ЭкземплярХаба(90);
		СтендКабинета.ФайловаяБаза("openhub-письмо-из-кабинета");
		СтендКабинета.Среда("OSHUB_ADMIN_LOGIN", "mailadmin");
		СтендКабинета.Среда("OSHUB_ADMIN_PASSWORD", "MailAdminPass1");
		СтендКабинета.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
		СтендКабинета.Среда("OSHUB_MAIL_ENABLED", "true");
		СтендКабинета.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
		СтендКабинета.Среда("OSHUB_MAIL_SMTP_PORT", Формат(ПортПочты, "ЧГ=0"));
		СтендКабинета.Среда("OSHUB_MAIL_FROM", "hub@example.com");
		СтендКабинета.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");
		СтендКабинета.Запустить();
		СтендКабинета.ДождатьсяОнбординга();

		КлиентКабинета = Новый КлиентХаба(СтендКабинета, 20);
		КукаКабинета = КлиентКабинета.КукаОтвета(КлиентКабинета.POSTJSON("/api/v1/register",
			"{""логин"":""cabinet"",""пароль"":""Password123!""}"), "oshub_session");
		Ожидаем.Что(ЗначениеЗаполнено(КукаКабинета), "сессия человека на стенде с почтой открыта")
			.ЭтоИстина();
	Исключение
		ОстановитьСтендКабинета();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ОстановитьСтендКабинета()

	Если СтендКабинета <> Неопределено Тогда
		СтендКабинета.Остановить();
		СтендКабинета = Неопределено;
	КонецЕсли;
	Если ЛовушкаКабинета <> Неопределено Тогда
		ЛовушкаКабинета.Остановить();
		ЛовушкаКабинета = Неопределено;
	КонецЕсли;
	КукаАдминаКабинета = Неопределено;

КонецПроцедуры

// Своя учётка теста на стенде кабинета: заведена без адреса, сессия открыта регистрацией.
Функция НоваяСессияНаСтенде(Знач Логин)

	Кука = КлиентКабинета.КукаОтвета(КлиентКабинета.POSTJSON("/api/v1/register",
		СтрШаблон("{""логин"":""%1"",""пароль"":""Password123!""}", Логин)), "oshub_session");
	Ожидаем.Что(ЗначениеЗаполнено(Кука), "сессия учётки " + Логин + " открыта").ЭтоИстина();
	Возврат Кука;

КонецФункции

// Форма профиля глазами человека на стенде с почтой: токен со страницы, адрес в поле.
Функция ВписатьАдресНаСтенде(Знач Адрес, Знач Кука = Неопределено)

	Сессия = ?(Кука = Неопределено, КукаКабинета, Кука);

	Поля = Новый Соответствие();
	Поля.Вставить("email", Адрес);
	Поля.Вставить("_csrf", КлиентКабинета.ТокенCSRF(
		КлиентКабинета.Тело(КлиентКабинета.GETСКукой("/me/settings/profile", Сессия))));
	Возврат КлиентКабинета.POSTФормы("/me/settings/profile", Поля, Сессия);

КонецФункции

// Выключатель подтверждения адреса на стенде кабинета правит администратор через API
// настроек; включение — сброс к умолчанию, а умолчание — «включено».
Процедура ПодтверждениеНаСтенде(Знач Включено)

	Кука = СессияАдминаКабинета();
	Заголовки = КлиентКабинета.ЗаголовкиМутации(Кука, КлиентКабинета.ТокенCSRF(
		КлиентКабинета.Тело(КлиентКабинета.GETСКукой("/me/settings/profile", Кука))));
	Путь = "/api/v1/hub/settings/oshub.auth.email.confirm.enabled";

	Если Включено Тогда
		Ответ = КлиентКабинета.ЗапросJSON("DELETE", Путь, "", Заголовки);
	Иначе
		Ответ = КлиентКабинета.ЗапросJSON("PATCH", Путь, "{""value"":false}", Заголовки);
	КонецЕсли;

	Ожидаем.Что(Ответ.КодСостояния, "настройка подтверждения принята: "
		+ КлиентКабинета.Тело(Ответ)).Равно(200);

КонецПроцедуры

// Администратор стенда кабинета заведён средой и без адреса — вход паролем ему открыт.
Функция СессияАдминаКабинета()

	Если НЕ ЗначениеЗаполнено(КукаАдминаКабинета) Тогда
		КукаАдминаКабинета = КлиентКабинета.КукаОтвета(КлиентКабинета.POSTJSON("/api/v1/login",
			"{""логин"":""mailadmin"",""пароль"":""MailAdminPass1""}"), "oshub_session");
	КонецЕсли;
	Возврат КукаАдминаКабинета;

КонецФункции

// Адрес, который кабинет показывает в поле профиля.
Функция АдресВКабинете(Знач Кука)
	Профиль = Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука));
	Возврат ФормаСо(Профиль, "name=""email""").Поля.Получить("email");
КонецФункции

// Поля нажатия «выслать письмо ещё раз», собранные руками: так приходит форма, которую
// страница не нарисовала. Пустой токен — поля CSRF нет вовсе.
Функция ПоляПовтора(Знач ТокенCSRF)

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Если ЗначениеЗаполнено(ТокенCSRF) Тогда
		Поля.Вставить("_csrf", ТокенCSRF);
	КонецЕсли;
	Возврат Поля;

КонецФункции

Функция КнопкаПовтора()
	Возврат "Выслать письмо ещё раз";
КонецФункции

// Форма повтора письма на странице — та, что несёт операцию «выслать»; Неопределено — её нет.
Функция ФормаПовтора(Знач Разметка)

	Для Каждого Форма Из ФормыСтраницы(Разметка) Цикл
		Если Форма.Поля.Получить("операция") = "выслать" Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Форма страницы, в разметке которой встречается маркер; Неопределено — такой нет.
Функция ФормаСо(Знач Разметка, Знач Маркер)

	Для Каждого Форма Из ФормыСтраницы(Разметка) Цикл
		Если СтрНайти(Форма.Разметка, Маркер) > 0 Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Формы страницы в порядке документа: адрес отправки, поля <input> так, как их отправит
// браузер (на повторяющееся имя — первое значение), и разметка формы целиком.
Функция ФормыСтраницы(Знач Разметка)

	Результат = Новый Массив();
	Хвост = Разметка;
	Начало = СтрНайти(Хвост, "<form");

	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало);
		Конец = СтрНайти(Хвост, "</form>");
		Форма = ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));
		Результат.Добавить(РазобраннаяФорма(Форма));
		Хвост = Сред(Хвост, СтрДлина(Форма) + 1);
		Начало = СтрНайти(Хвост, "<form");
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазобраннаяФорма(Знач Форма)

	Поля = Новый Соответствие();
	Хвост = Форма;
	Позиция = СтрНайти(Хвост, "<input");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Тег = Лев(Хвост, СтрНайти(Хвост, ">"));
		Имя = ЗначениеАтрибута(Тег, "name");
		Если ЗначениеЗаполнено(Имя) И Поля.Получить(Имя) = Неопределено Тогда
			Поля.Вставить(Имя, ЗначениеАтрибута(Тег, "value"));
		КонецЕсли;
		Хвост = Сред(Хвост, 2);
		Позиция = СтрНайти(Хвост, "<input");
	КонецЦикла;

	Заголовок = Лев(Форма, СтрНайти(Форма, ">"));
	Возврат Новый Структура("Действие, Поля, Разметка",
		ЗначениеАтрибута(Заголовок, "action"), Поля, Форма);

КонецФункции

// Значение атрибута тега; "" — атрибута нет.
Функция ЗначениеАтрибута(Знач Тег, Знач Атрибут)

	Маркер = " " + Атрибут + "=""";
	Позиция = СтрНайти(Тег, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

// Стенд с провайдером входа и подставной почтой: письма идут в ловушку, учётку заводит
// сам вход через IdP.
Процедура НастроитьСтендПровайдера(Знач Хаб_, Знач IdP_, Знач ПортПочты)

	Хаб_.ФайловаяБаза("openhub-восстановление-провайдер");
	Хаб_.Среда("OSHUB_ADMIN_LOGIN", "idpadmin");
	Хаб_.Среда("OSHUB_ADMIN_PASSWORD", "IdpAdminPass1");
	Хаб_.Среда("OSHUB_MAIL_ENABLED", "true");
	Хаб_.Среда("OSHUB_MAIL_SMTP_HOST", "127.0.0.1");
	Хаб_.Среда("OSHUB_MAIL_SMTP_PORT", Формат(ПортПочты, "ЧГ=0"));
	Хаб_.Среда("OSHUB_MAIL_FROM", "hub@example.com");
	Хаб_.Среда("OSHUB_INSTANCE_URL", "https://hub.example.com");
	Хаб_.Среда("OSHUB_OIDC_PROVIDERS", ИмяПровайдера);
	Хаб_.Среда("OSHUB_OIDC_FAKE_LABEL", "Фейковый IdP");
	Хаб_.Среда("OSHUB_OIDC_FAKE_ISSUER", IdP_.Издатель());
	Хаб_.Среда("OSHUB_OIDC_FAKE_CLIENT__ID", "хаб-клиент");
	Хаб_.Среда("OSHUB_OIDC_FAKE_CLIENT__SECRET", "секрет-хаб-клиента");
	// порт хаба выдаётся только в Запустить(), поэтому адрес возврата здесь условный:
	// браузер в тесте берёт из ответа IdP путь и запрос, а идёт на реальный порт хаба
	Хаб_.Среда("OSHUB_OIDC_FAKE_REDIRECT__URI", "http://localhost/oidc/callback");
	Хаб_.Среда("OSHUB_OIDC_FAKE_AUTOPROVISION", "true");

КонецПроцедуры

// Снимается всё, что успело подняться: упавший конструктор стенда не должен оставить
// висеть заявку ловушки на порт. Остановить у каждого участника идемпотентна.
Процедура ОстановитьСтендПровайдера(Знач Хаб_, Знач IdP_, Знач Ловушка)

	Если Хаб_ <> Неопределено Тогда
		Хаб_.Остановить();
	КонецЕсли;
	Если IdP_ <> Неопределено Тогда
		IdP_.Остановить();
	КонецЕсли;
	Ловушка.Остановить();

КонецПроцедуры

// Вход через провайдера глазами браузера: хаб уводит к IdP, IdP возвращает браузер
// с кодом, хаб заводит учётку и открывает ей сессию.
Процедура ВойтиПровайдером(Знач КлиентСтенда)

	Старт = КлиентСтенда.GETБезПереходов("/login/oidc/" + ИмяПровайдера);
	Ожидаем.Что(Старт.КодСостояния, "хаб уводит браузер к провайдеру").Равно(302);

	КукаТранзакции = КлиентСтенда.КукаОтвета(Старт, "oshub_oidc_txn");
	Согласие = КлиентСтенда.ПоАдресуБезПереходов(
		КлиентСтенда.ЗаголовокОтвета(Старт, "Location"));
	Ожидаем.Что(Согласие.КодСостояния, "провайдер вернул браузер на хаб").Равно(302);

	Возврат_ = КлиентСтенда.GETБезПереходов(
		ПутьСЗапросом(КлиентСтенда.ЗаголовокОтвета(Согласие, "Location")),
		"oshub_oidc_txn=" + КукаТранзакции);

	Ожидаем.Что(ЗначениеЗаполнено(КлиентСтенда.КукаОтвета(Возврат_, "oshub_session")),
		"вход через провайдера открыл сессию: " + Возврат_.КодСостояния).ЭтоИстина();

КонецПроцедуры

// Из абсолютного адреса возврата — путь со строкой параметров: браузер в тесте идёт
// на реальный порт стенда, а не на условный адрес из настройки провайдера.
// Строка файла журнала аудита стенда с заданным действием; пустая — такой строки нет.
Функция СтрокаАудитаСДействием(Знач Хаб_, Знач Действие)

	Файл = ОбъединитьПути(Хаб_.КореньХранилища(), "аудит.log");
	Если НЕ Новый Файл(Файл).Существует() Тогда
		Возврат "";
	КонецЕсли;

	// файл держит открытым аппендер живого хаба: читаем потоком, который запись не запирает
	Поток = ФайловыеПотоки.ОткрытьДляЧтения(Файл);
	Чтение = Новый ЧтениеДанных(Поток);
	Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(Чтение.ПрочитатьВБуферДвоичныхДанных(), "utf-8");
	Чтение.Закрыть();
	Поток.Закрыть();

	Для Каждого Строчка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Если СтрНайти(Строчка, """действие"":""" + Действие + """") > 0 Тогда
			Возврат Строчка;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ПутьСЗапросом(Знач Адрес)

	Позиция = СтрНайти(Адрес, "://");
	Если Позиция = 0 Тогда
		Возврат Адрес;
	КонецЕсли;

	Хвост = Сред(Адрес, Позиция + 3);
	Слеш = СтрНайти(Хвост, "/");
	Возврат ?(Слеш = 0, "/", Сред(Хвост, Слеш));

КонецФункции

Функция ПоляУстановкиПароля(Знач Токен, Знач Пароль)

	Поля = Новый Соответствие();
	Поля.Вставить("token", Токен);
	Поля.Вставить("пароль", Пароль);
	Поля.Вставить("повтор", Пароль);
	Возврат Поля;

КонецФункции

Функция ПоляВхода(Знач Логин, Знач Пароль)

	Поля = Новый Соответствие();
	Поля.Вставить("логин", Логин);
	Поля.Вставить("пароль", Пароль);
	Возврат Поля;

КонецФункции

// Учётка администратора с адресом: мастер первого запуска адреса не спрашивает,
// поэтому его вписывает кабинет — ровно так же, как это делает человек.
Функция АдминСАдресом()

	Кука = ЗавестиАдмина();
	ЗадатьАдрес(Кука, "root@example.org");
	Возврат Кука;

КонецФункции

Процедура ЗадатьАдрес(Знач Кука, Знач Адрес)

	Поля = Новый Соответствие();
	Поля.Вставить("email", Адрес);
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));

	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 302,
		"адрес учётки записан кабинетом").ЭтоИстина();

КонецПроцедуры

// Сессия администратора живёт весь набор и войти заново не пытается: первый же тест,
// задавший админу адрес, закрывает парольный вход до подтверждения этого адреса, а почты
// у стенда нет. Человек в браузере в этом месте ровно так и сидит — в открытой сессии.
Функция ЗавестиАдмина()

	Если ЗначениеЗаполнено(КукаАдмина) Тогда
		Возврат КукаАдмина;
	КонецЕсли;

	Ответ = Клиент.POSTJSON("/setup",
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", ЛогинАдмина, ПарольАдмина));
	Если Ответ.КодСостояния = 201 Тогда
		КукаАдмина = Клиент.КукаОтвета(Ответ, "oshub_session");
	Иначе
		КукаАдмина = Клиент.КукаОтвета(Клиент.POSTJSON("/api/v1/login",
			СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", ЛогинАдмина, ПарольАдмина)),
			"oshub_session");
	КонецЕсли;

	Возврат КукаАдмина;

КонецФункции
#КонецОбласти
