// HTTP-тесты настроек хаба через JSON API (/api/v1/hub/settings): чтение карточек с источником
// и признаком правки, правка, сброс, отказ на заданное конфигурацией, секрет «вводится, но не
// читается», порог администратора хаба и запись в журнал аудита. Хаб поднимается настоящий,
// один ключ ему форсирован переменной окружения — иначе отказ 409 проверять не на чем.
//
// «Одна дверь» проверяется кругом: правка через API видна форме дома «Хаб», правка формой —
// в API. Разъехались валидаторы или ключи — круг рвётся.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КаталогПроекта;

Перем ТокенRoot;       // PAT root — администратор хаба
Перем ТокенAlice;      // PAT alice — обычный пользователь
Перем КукаRoot;        // сессия root — форма дома «Хаб» и журнал аудита

// Настройка, занятая конфигурацией: её значение задаётся переменной окружения ниже
Перем КлючПодписи;
Перем ПодписьИзКонфига;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	КлючПодписи = "oshub.ui.tagline";
	ПодписьИзКонфига = "подпись из конфигурации";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);
	КаталогПроекта = Хаб.КаталогПроекта();
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-настройки-api");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");
	// подпись инсталляции занята конфигурацией: на ней проверяется отказ 409
	Хаб.Среда("OSHUB_UI_TAGLINE", ПодписьИзКонфига);

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	ТокенRoot = ВыпуститьPAT(КукаRoot);
	ТокенAlice = ВыпуститьPAT(Клиент.Войти("alice", "AlicePassw0rd"));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Чтение

&Тест
Процедура СписокНазываетЗначениеИсточникИПризнакПравки() Экспорт

	Ответ = GET_Токен("/api/v1/hub/settings", ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "администратор хаба читает настройки").Равно(200);

	Список = Клиент.ТелоJSON(Ответ);
	Элементы = Список.Получить("items");
	Ожидаем.Что(Элементы.Количество() > 20, "реестр отдан целиком, а не куском").ЭтоИстина();
	Ожидаем.Что(Список.Получить("total"), "число совпадает с составом").Равно(Элементы.Количество());

	// ключ намеренно из тех, которых не пишет ни один тест набора: «источник — умолчание»
	// на ключе, кем-то уже записанном, читал бы порядок тестов, а не выдачу
	Правимая = Карточка(Элементы, "oshub.proxy.timeout.sec");
	Ожидаем.Что(Правимая <> Неопределено, "таймаут похода в чужой хаб назван").ЭтоИстина();
	Ожидаем.Что(Правимая.Получить("editable"), "он правится").ЭтоИстина();
	Ожидаем.Что(Правимая.Получить("source"), "и берётся из умолчания").Равно("дефолт");
	Ожидаем.Что(Правимая.Получить("value"), "значением, а не строкой").Равно(20);
	Ожидаем.Что(Правимая.Получить("section"), "раздел назван").Равно("proxy");
	Ожидаем.Что(Правимая.Получить("env"), "и имя переменной окружения").Равно("OSHUB_PROXY_TIMEOUT_SEC");

	Занятая = Карточка(Элементы, КлючПодписи);
	Ожидаем.Что(Занятая.Получить("value"), "занятая конфигурацией показывает её значение")
		.Равно(ПодписьИзКонфига);
	Ожидаем.Что(Занятая.Получить("source"), "источник назван").Равно("конфиг");
	Ожидаем.Что(Занятая.Получить("forced_by_config"), "и признак «занята»").ЭтоИстина();
	Ожидаем.Что(Занятая.Получить("editable"), "поэтому она не правится").ЭтоЛожь();

	Развёртывания = Карточка(Элементы, "oshub.storage.root");
	Ожидаем.Что(Развёртывания.Получить("editable"),
		"настройка развёртывания администратору хаба не правится").ЭтоЛожь();
	Ожидаем.Что(Развёртывания.Получить("kind"), "и называет себя таковой").Равно("bootstrap");

КонецПроцедуры

&Тест
Процедура ОтборРазделаОтдаётТолькоЕгоКлючи() Экспорт

	Почта = Клиент.ТелоJSON(GET_Токен("/api/v1/hub/settings?section=mail", ТокенRoot)).Получить("items");
	Ожидаем.Что(Почта.Количество() > 0, "раздел почты не пуст").ЭтоИстина();
	Ожидаем.Что(Карточка(Почта, "oshub.mail.smtp.host") <> Неопределено,
		"хост SMTP в разделе почты").ЭтоИстина();
	Ожидаем.Что(Карточка(Почта, "oshub.pools.default_quota_mb"),
		"а квота пулов — нет").Равно(Неопределено);

	Чужие = Новый Массив();
	Для Каждого Элемент Из Почта Цикл
		Если Элемент.Получить("section") <> "mail" Тогда
			Чужие.Добавить(Строка(Элемент.Получить("key")));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Чужие, ", "), "ключи чужих разделов в выдаче").Равно("");

	Незнакомый = GET_Токен("/api/v1/hub/settings?section=nosuchsection", ТокенRoot);
	Ожидаем.Что(Незнакомый.КодСостояния, "незнакомый раздел — отказ, а не пустой список").Равно(404);
	ПроверитьФорматОтказа(Незнакомый, "unknown_section");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Незнакомый), "mail") > 0,
		"отказ называет разделы, которые есть").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестныйКлючНеПритворяетсяНастройкой() Экспорт

	Ответ = GET_Токен("/api/v1/hub/settings/oshub.no.such.key", ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "чтение неизвестного ключа → 404").Равно(404);
	ПроверитьФорматОтказа(Ответ, "unknown_setting");

	Правка = PATCH_Токен("/api/v1/hub/settings/oshub.no.such.key",
		"{""значение"":""1""}", ТокенRoot);
	Ожидаем.Что(Правка.КодСостояния, "правка неизвестного ключа → 404").Равно(404);
	ПроверитьФорматОтказа(Правка, "unknown_setting");

КонецПроцедуры

#КонецОбласти

#Область ОднаДверь

&Тест
Процедура ПравкаЧерезAPIВиднаФормеДомаХаба() Экспорт

	Новое = "Хаб, настроенный скриптом";

	Ответ = PATCH_Токен("/api/v1/hub/settings/oshub.ui.brand",
		ТелоЗначения(Новое), ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "правка принята").Равно(200);

	Стало = Клиент.ТелоJSON(Ответ).Получить("setting");
	Ожидаем.Что(Стало.Получить("value"), "ответ называет получившееся значение").Равно(Новое);
	Ожидаем.Что(Стало.Получить("source"), "и его источник").Равно("база");

	Ожидаем.Что(ЗначениеНастройки("oshub.ui.brand"), "чтение видит то же").Равно(Новое);

	Форма = Клиент.Тело(Клиент.GETСКукой("/hub/settings/branding", КукаRoot));
	Ожидаем.Что(СтрНайти(Форма, Новое) > 0,
		"форма дома «Хаб» показывает значение, заданное через API").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаФормойВиднаAPI() Экспорт

	Введённое = "Знак, набранный руками";

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/hub/settings/branding", КукаRoot))));
	Поля.Вставить("oshub.ui.brand", Введённое);

	Ответ = POSTФорма("/hub/settings/branding", Поля, КукаRoot);
	Ожидаем.Что(Ответ.КодСостояния, "форма приняла правку").Равно(200);

	Ожидаем.Что(ЗначениеНастройки("oshub.ui.brand"),
		"API видит значение, введённое формой").Равно(Введённое);

КонецПроцедуры

&Тест
Процедура СбросВозвращаетНастройкуКУмолчанию() Экспорт

	Ключ = "oshub.auth.token.cli_days";

	Правка = PATCH_Токен("/api/v1/hub/settings/" + Ключ, "{""значение"":9}", ТокенRoot);
	Ожидаем.Что(Правка.КодСостояния, "срок токена CLI задан").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Правка).Получить("setting").Получить("value"), "числом").Равно(9);
	Ожидаем.Что(Клиент.ТелоJSON(Правка).Получить("setting").Получить("source"), "из базы").Равно("база");

	Сброс = DELETE_Токен("/api/v1/hub/settings/" + Ключ, ТокенRoot);
	Ожидаем.Что(Сброс.КодСостояния, "сброс принят").Равно(200);

	Стало = Клиент.ТелоJSON(Сброс).Получить("setting");
	Ожидаем.Что(Стало.Получить("source"), "источником снова стало умолчание").Равно("дефолт");
	Ожидаем.Что(Стало.Получить("value"), "и значением — умолчание реестра").Равно(7);

КонецПроцедуры

#КонецОбласти

#Область Отказы

&Тест
Процедура ЗаданноеКонфигурациейЧерезAPIНеПравится() Экспорт

	Ответ = PATCH_Токен("/api/v1/hub/settings/" + КлючПодписи,
		ТелоЗначения("подпись из запроса"), ТокенRoot);

	Ожидаем.Что(Ответ.КодСостояния, "занятая конфигурацией правку не принимает → 409").Равно(409);
	ПроверитьФорматОтказа(Ответ, "forced_by_config");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "конфигурацией") > 0,
		"отказ объясняет себя, а не молчит").ЭтоИстина();

	Ожидаем.Что(ЗначениеНастройки(КлючПодписи),
		"отбитая правка значения не тронула").Равно(ПодписьИзКонфига);

КонецПроцедуры

&Тест
Процедура НастройкаРазвёртыванияПравкеНеПоддаётся() Экспорт

	Ответ = PATCH_Токен("/api/v1/hub/settings/oshub.storage.root",
		ТелоЗначения("/tmp/чужой-корень"), ТокенRoot);

	Ожидаем.Что(Ответ.КодСостояния, "bootstrap-настройка правится только конфигурацией → 409")
		.Равно(409);
	ПроверитьФорматОтказа(Ответ, "not_editable");
	Ожидаем.Что(ЗначениеНастройки("oshub.storage.root") = "/tmp/чужой-корень",
		"корень хранилища остался прежним").ЭтоЛожь();

КонецПроцедуры

// Выключение парольного входа — переход, а не запись значения: его ведёт предохранитель
// СтражПарольногоВхода, и значение, записанное в обход, заперло бы администраторов снаружи.
&Тест
Процедура ПарольныйВходЧерезAPIНеВыключается() Экспорт

	Ключ = "oshub.auth.password.enabled";

	Карточка = Клиент.ТелоJSON(GET_Токен("/api/v1/hub/settings/" + Ключ, ТокенRoot)).Получить("setting");
	Ожидаем.Что(Карточка.Получить("mechanism"), "карточка называет владельца правки")
		.Равно("СтражПарольногоВхода");
	Ожидаем.Что(Карточка.Получить("editable"), "и говорит, что этим адресом не правится").ЭтоЛожь();

	Ответ = PATCH_Токен("/api/v1/hub/settings/" + Ключ, "{""значение"":false}", ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "правка ключа с переходом → 409").Равно(409);
	ПроверитьФорматОтказа(Ответ, "mechanism_only");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "СтражПарольногоВхода") > 0,
		"отказ называет механизм, которым правка идёт").ЭтоИстина();

	// сперва то, что видит человек: логином и паролем по-прежнему входят
	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти("root", "RootPassw0rd")),
		"после отказа вход по паролю жив: предохранитель не обойдён").ЭтоИстина();
	Ожидаем.Что(ЗначениеНастройки(Ключ), "и настройка осталась включённой").ЭтоИстина();

КонецПроцедуры

// Личные пространства выключает пульт: сперва снос пулов и артефактов, только потом
// запись. Значение, записанное в обход, оставило бы выключенный тумблер и живые пулы.
&Тест
Процедура ЛичныеПространстваЧерезAPIНеПереключаются() Экспорт

	Ключ = "oshub.pools.personal_enabled";

	Ответ = PATCH_Токен("/api/v1/hub/settings/" + Ключ, "{""значение"":false}", ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "правка ключа с переходом → 409").Равно(409);
	ПроверитьФорматОтказа(Ответ, "mechanism_only");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "ПультЛичныхПространств") > 0,
		"отказ называет механизм, которым переход идёт").ЭтоИстина();
	Ожидаем.Что(ЗначениеНастройки(Ключ), "личные пространства остались включёнными").ЭтоИстина();

	// уборка введённого механизму не принадлежит: она возвращает ключ к конфигурации либо
	// умолчанию, а умолчание здесь — «включено», поэтому выключить настройку сбросом нельзя
	Сброс = DELETE_Токен("/api/v1/hub/settings/" + Ключ, ТокенRoot);
	Ожидаем.Что(Сброс.КодСостояния, "сброс принимается").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Сброс).Получить("setting").Получить("value"),
		"и настройку не выключает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НегодноеЗначениеНеПринимается() Экспорт

	НеЧисло = PATCH_Токен("/api/v1/hub/settings/oshub.mail.smtp.port",
		ТелоЗначения("не число"), ТокенRoot);
	Ожидаем.Что(НеЧисло.КодСостояния, "строка вместо числа → 422").Равно(422);
	ПроверитьФорматОтказа(НеЧисло, "invalid_value");
	Ожидаем.Что(ЗначениеНастройки("oshub.mail.smtp.port"), "порт остался умолчанием").Равно(587);

	ВнеПеречисления = PATCH_Токен("/api/v1/hub/settings/oshub.ui.theme",
		ТелоЗначения("фиолетовая"), ТокенRoot);
	Ожидаем.Что(ВнеПеречисления.КодСостояния, "значение вне перечисления → 422").Равно(422);
	ПроверитьФорматОтказа(ВнеПеречисления, "invalid_value");
	Ожидаем.Что(ЗначениеНастройки("oshub.ui.theme"), "тема осталась прежней").Равно("тёмная");

	БезПоля = PATCH_Токен("/api/v1/hub/settings/oshub.ui.theme", "{}", ТокенRoot);
	Ожидаем.Что(БезПоля.КодСостояния, "правка без значения → 400").Равно(400);
	ПроверитьФорматОтказа(БезПоля, "no_value");

	// Мусор вместо JSON: тело разбирает САМ winow до контроллера (ВходящийЗапрос
	// .ЗначенияПараметровДляТочкиМаршрута), поэтому код отказа выбирает не хаб — сюда
	// он доезжает пятисоткой. Стережём то, чем хаб распоряжается: успехом это не бывает
	// и значения не меняет. Пиши тест на 400 — он стерёг бы чужую библиотеку.
	Мусор = PATCH_Токен("/api/v1/hub/settings/oshub.ui.theme", "{это не json", ТокенRoot);
	Ожидаем.Что(Мусор.КодСостояния >= 400, "мусор вместо JSON правкой не становится").ЭтоИстина();
	Ожидаем.Что(ЗначениеНастройки("oshub.ui.theme"), "и тема осталась прежней").Равно("тёмная");

КонецПроцедуры

&Тест
Процедура НастройкиОтвечаютТолькоАдминуХаба() Экспорт

	Ожидаем.Что(Клиент.GET("/api/v1/hub/settings").КодСостояния, "аноним списка не видит → 401").Равно(401);
	Ожидаем.Что(Клиент.GET("/api/v1/hub/settings/oshub.ui.theme").КодСостояния,
		"и карточки тоже → 401").Равно(401);
	Ожидаем.Что(PATCH_Токен("/api/v1/hub/settings/oshub.ui.theme",
		ТелоЗначения("светлая"), "").КодСостояния, "аноним не правит → 401").Равно(401);

	Ожидаем.Что(GET_Токен("/api/v1/hub/settings", ТокенAlice).КодСостояния,
		"обычный пользователь списка не видит → 403").Равно(403);
	Ожидаем.Что(GET_Токен("/api/v1/hub/settings/oshub.ui.theme", ТокенAlice).КодСостояния,
		"и карточки тоже → 403").Равно(403);

	ЧужаяПравка = PATCH_Токен("/api/v1/hub/settings/oshub.ui.theme",
		ТелоЗначения("светлая"), ТокенAlice);
	Ожидаем.Что(ЧужаяПравка.КодСостояния, "и не правит → 403").Равно(403);
	ПроверитьФорматОтказа(ЧужаяПравка, "forbidden");

	Ожидаем.Что(ЗначениеНастройки("oshub.ui.theme"),
		"ни одна отбитая попытка значения не тронула").Равно("тёмная");

	Метод = POST_Токен("/api/v1/hub/settings", "{}", ТокенRoot);
	Ожидаем.Что(Метод.КодСостояния, "список только читают → 405").Равно(405);
	Ожидаем.Что(ЗаголовокОтвета(Метод, "Allow"), "и 405 называет разрешённый метод").Равно("GET");

	МетодКарточки = POST_Токен("/api/v1/hub/settings/oshub.ui.theme", "{}", ТокенRoot);
	Ожидаем.Что(МетодКарточки.КодСостояния, "карточка POST не принимает → 405").Равно(405);
	Ожидаем.Что(ЗаголовокОтвета(МетодКарточки, "Allow"), "и называет свои три метода")
		.Равно("GET, PATCH, DELETE");

КонецПроцедуры

#КонецОбласти

#Область СекретИЖурнал

&Тест
Процедура СекретВводитсяНоНеЧитается() Экспорт

	Секрет = "smtp-пароль-который-нельзя-показывать";

	Ответ = PATCH_Токен("/api/v1/hub/settings/oshub.mail.smtp.password",
		ТелоЗначения(Секрет), ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "секрет вводится через API").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), Секрет), "но в ответе его нет").Равно(0);

	Стало = Клиент.ТелоJSON(Ответ).Получить("setting");
	Ожидаем.Что(Стало.Получить("value"), "ответ показывает маску").Равно("•••");
	Ожидаем.Что(Стало.Получить("secret"), "и называет настройку секретной").ЭтоИстина();
	Ожидаем.Что(Стало.Получить("is_set"), "и говорит, что значение задано").ЭтоИстина();

	Карточка = GET_Токен("/api/v1/hub/settings/oshub.mail.smtp.password", ТокенRoot);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Карточка), Секрет), "чтение карточки секрета не отдаёт").Равно(0);
	Ожидаем.Что(Клиент.ТелоJSON(Карточка).Получить("setting").Получить("value"),
		"вместо него — маска").Равно("•••");

	Список = GET_Токен("/api/v1/hub/settings?section=mail", ТокенRoot);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Список), Секрет), "и список тоже").Равно(0);

	Запись = СтрокаЖурнала("root", "настройка.изменена", "oshub.mail.smtp.password");
	Журнал = ЖурналСоСтрокой(Запись);
	Ожидаем.Что(СтрНайти(Журнал, Запись) > 0, "ввод секрета записан в журнал аудита").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, Секрет), "но самого значения журнал не хранит").Равно(0);

КонецПроцедуры

&Тест
Процедура ПравкаЧерезAPIЛожитсяВЖурналСАвтором() Экспорт

	Ответ = PATCH_Токен("/api/v1/hub/settings/oshub.pools.default_quota_mb",
		"{""значение"":777}", ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "квота пулов по умолчанию задана").Равно(200);
	Ожидаем.Что(ЗначениеНастройки("oshub.pools.default_quota_mb"), "значением").Равно(777);

	Правка = СтрокаЖурнала("root", "настройка.изменена", "oshub.pools.default_quota_mb");
	Ожидаем.Что(СтрНайти(ЖурналСоСтрокой(Правка), Правка) > 0,
		"правка записана в журнал аудита, автор — владелец ключа доступа").ЭтоИстина();

	Сброс = DELETE_Токен("/api/v1/hub/settings/oshub.pools.default_quota_mb", ТокенRoot);
	Ожидаем.Что(Сброс.КодСостояния, "сброс принят").Равно(200);

	Уборка = СтрокаЖурнала("root", "настройка.сброшена", "oshub.pools.default_quota_mb");
	Ожидаем.Что(СтрНайти(ЖурналСоСтрокой(Уборка), Уборка) > 0,
		"и сброс тоже — с тем же автором").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Карточка настройки из выдачи списка; Неопределено — такого ключа в выдаче нет.
Функция Карточка(Знач Элементы, Знач Ключ)

	Для Каждого Элемент Из Элементы Цикл
		Если Строка(Элемент.Получить("key")) = Ключ Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЗначениеНастройки(Знач Ключ)
	Ответ = GET_Токен("/api/v1/hub/settings/" + Ключ, ТокенRoot);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("Карточка ""%1"" не прочиталась: %2", Ключ, Ответ.КодСостояния);
	КонецЕсли;
	Возврат Клиент.ТелоJSON(Ответ).Получить("setting").Получить("value");
КонецФункции

Функция ТелоЗначения(Знач Значение)
	Данные = Новый Структура("значение", Значение);
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

// Строка журнала аудита: автор, действие и объект подряд — так её печатает экран.
Функция СтрокаЖурнала(Знач Автор, Знач Действие, Знач Ключ)
	Возврат СтрШаблон("<td>%1</td><td>%2</td><td>настройка/%3</td>", Автор, Действие, Ключ);
КонецФункции

// Журнал аудита пишется подписчиком на событие правки: запись доезжает до страницы сама,
// но не мгновенно — ждём именно её появления, а не спим фиксированный срок.
Функция ЖурналСоСтрокой(Знач Фрагмент)

	Разметка = "";
	Для Заход = 1 По 20 Цикл
		Разметка = Клиент.Тело(Клиент.GETСКукой("/hub/settings/audit", КукаRoot));
		Если СтрНайти(Разметка, Фрагмент) > 0 Тогда
			Возврат Разметка;
		КонецЕсли;
		Приостановить(250);
	КонецЦикла;
	Возврат Разметка;

КонецФункции

Процедура ПроверитьФорматОтказа(Знач Ответ, Знач ОжидаемыйКод)

	Тело_ = Клиент.ТелоJSON(Ответ);
	Ошибка = Тело_.Получить("error");
	Ожидаем.Что(Ошибка <> Неопределено, "отказ в едином формате {error:{code,message}}").ЭтоИстина();
	Ожидаем.Что(Ошибка.Получить("code"), "машинный код отказа").Равно(ОжидаемыйКод);
	Ожидаем.Что(ЗначениеЗаполнено(Ошибка.Получить("message")),
		"и человеческая причина").ЭтоИстина();

КонецПроцедуры

Функция ЗаголовокОтвета(Знач Ответ, Знач Имя)
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ВРег(Имя) Тогда
			Возврат СокрЛП(Строка(КиЗ.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция GET_Токен(Знач Путь, Знач Токен)
	Заголовки = Новый Соответствие();
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	Возврат Клиент.Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция ЗапросJSONТокен(Знач Метод, Знач Путь, Знач Тело_, Знач Токен)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	Возврат ОтправитьМетод(Метод, Путь, Тело_, Заголовки);
КонецФункции

Функция POST_Токен(Знач Путь, Знач Тело_, Знач Токен)
	Возврат ЗапросJSONТокен("POST", Путь, Тело_, Токен);
КонецФункции

Функция PATCH_Токен(Знач Путь, Знач Тело_, Знач Токен)
	Возврат ЗапросJSONТокен("PATCH", Путь, Тело_, Токен);
КонецФункции

Функция DELETE_Токен(Знач Путь, Знач Токен)
	Возврат ЗапросJSONТокен("DELETE", Путь, "", Токен);
КонецФункции

Функция POSTФорма(Знач Путь, Знач ПоляФормы, Знач Кука)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(КодироватьФорму(ПоляФормы), КодировкаТекста.UTF8);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

Функция КодироватьФорму(Знач ПоляФормы)
	Части = Новый Массив();
	Для Каждого КиЗ Из ПоляФормы Цикл
		Части.Добавить(КодироватьСтроку(Строка(КиЗ.Ключ), СпособКодированияСтроки.URLEncoding)
			+ "=" + КодироватьСтроку(Строка(КиЗ.Значение), СпособКодированияСтроки.URLEncoding));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");
КонецФункции

Функция ОтправитьМетод(Знач Метод, Знач Путь, Знач Тело_, Знач Заголовки)
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если ЗначениеЗаполнено(Тело_) Тогда
		Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	КонецЕсли;
	Соед = Клиент.Соединение();
	Если ВРег(Метод) = "POST" Тогда
		Возврат Соед.ОтправитьДляОбработки(Запрос);
	КонецЕсли;
	Возврат Соед.ВызватьHTTPМетод(Метод, Запрос);
КонецФункции

Функция ВыпуститьPAT(Знач Кука)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;
	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");
КонецФункции

#КонецОбласти
