// «Выйти» вошедшего несёт токен его сессии на каждой странице, чей контекст собирает своя дверь:
// главная, каталог, страница пакета и её 404, пул и его 404, список пулов, неизвестный адрес,
// проводник. Настоящие контроллеры, страж, служба сессий, защита CSRF, каркас кита и обрамление
// хаба в контейнере (база — в памяти): дверь, не довёзшая сессию стража до контекста, печатает
// «Выйти» без токена — и выход с этой страницы отвечал бы 403.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КаталогКлассов; // Строка — src/модули/интерфейс/Классы: исходники контроллеров
Перем Вошедший;      // Пользователь — учётка со своей сессией
Перем Сессия_;       // СессияХаба — его сессия в службе сессий
Перем Засев;         // ЗасевРеестра — пул и пакет для страниц каталога

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогКлассов = ОбъединитьПути(Модули, "интерфейс", "Классы");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, хранилище, публикация, реестр, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("почта, уведомления, вход, права, настройки, гео, сеть, кабинет, зеркала, прокси,"
		+ " поиск, статистика, описания, подписки, интерфейс");
	// кнопка скачивания стоит на адресе выдачи (протоколAPI), служба статистики — на запуске в фоне
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "протоколAPI", "Классы"), "АдресаВыдачи");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "фоновыеЗадания", "Классы"), "ЗапускВФонеЗаданием");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ГотовностьХаба");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	Для Каждого Имя Из ИменаКонтроллеров() Цикл
		ПоискКлассов.Подключить(КаталогКлассов, Имя);
	КонецЦикла;

	Для Каждого Фикстура Из СтрРазделить("НастройкиЗаглушка,ЗаписывающийПодписчик,ФейкЖурналЗамка,ЛовушкаЛога,"
		+ "ОтветСтраницыЗаглушка,КукиЗаглушка,ЗасевРеестра", ",") Цикл
		РеестрФикстур.Подключить(Фикстура);
	КонецЦикла;

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "выход-на-страницах-вошедшего-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Вошедший = Желудь("СервисПользователей").СоздатьПользователя("vyhod7", "", "password123");
	Сессия_ = Желудь("СлужбаСессий").Создать(Вошедший.Идентификатор);
	Засев = Новый ЗасевРеестра(Поделка);

КонецПроцедуры

// Каждая страница вошедшего — своей дверью: в меню форма «Выйти» с токеном его сессии.
&Тест
Процедура ВошедшемуКаждаяСтраницаДаётВыйтиСТокеномСессии() Экспорт

	Засеяно = Засев.ПулПакетВерсия();
	Пул = Засеяно.Пул.Имя;
	Пакет = Засеяно.Пакет.Имя;
	Токен = Желудь("ЗащитаCSRF").ТокенСессии(Сессия_);
	Ожидаем.Что(Токен, "КОНТРОЛЬ: у сессии есть токен").Заполнено();

	Страницы = Новый Соответствие();
	Страницы.Вставить("главная", Главная());
	Страницы.Вставить("каталог", Каталог());
	Страницы.Вставить("пакет", СтраницаПакета(Пул, Пакет));
	Страницы.Вставить("пакет 404", СтраницаПакета("нет-такого-пула", Пакет));
	Страницы.Вставить("пул", СтраницаПула(Пул));
	Страницы.Вставить("пул 404", СтраницаПула("нет-такого-пула"));
	Страницы.Вставить("список пулов", СписокПулов());
	Страницы.Вставить("неизвестный адрес", Желудь("СтраницаНеизвестногоАдреса")
		.Страница(Новый Соответствие(), КукиСессии(), "/нет/такого/адреса"));
	Страницы.Вставить("проводник", Проводник());

	Для Каждого Страница Из Страницы Цикл
		Выход = ФормаВыхода(Страница.Значение);
		Ожидаем.Что(Выход, Страница.Ключ + ": «Выйти» в меню вошедшего").Заполнено();
		Ожидаем.Что(Выход, Страница.Ключ + ": с токеном его сессии").Содержит("value=""" + Токен + """");
	КонецЦикла;

КонецПроцедуры

// КОНТРОЛЬ: гостю (без куки сессии) «Выйти» не печатается — токен в наборе берётся у сессии, а не
// у любой страницы.
&Тест
Процедура ГостюВыйтиНеПечатается() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер("КонтроллерЛендинга").Показать(Ответ, Новый Соответствие(), Новый КукиЗаглушка());
	Ожидаем.Что(ФормаВыхода(Ответ.ТелоТекст), "гостю «Выйти» нет").Равно("");

КонецПроцедуры

#Область Страницы

Функция Главная()
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер("КонтроллерЛендинга").Показать(Ответ, Новый Соответствие(), КукиСессии());
	Возврат Ответ.ТелоТекст;
КонецФункции

Функция Каталог()
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер("КонтроллерКаталога").Список(Ответ, Новый Соответствие(), КукиСессии(), "/packages");
	Возврат Ответ.ТелоТекст;
КонецФункции

Функция СтраницаПакета(Знач Пул, Знач Пакет)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер("КонтроллерПакета").Показать(Ответ, Пул, Пакет, Новый Соответствие(), КукиСессии(), "",
		СтрШаблон("/pools/%1/packages/%2", Пул, Пакет));
	Возврат Ответ.ТелоТекст;
КонецФункции

Функция СтраницаПула(Знач Пул)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер("КонтроллерПула").Показать(Ответ, Пул, Новый Соответствие(), КукиСессии(), "/pools/" + Пул,
		Новый Соответствие());
	Возврат Ответ.ТелоТекст;
КонецФункции

Функция СписокПулов()
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер("КонтроллерСпискаПулов").Показать(Ответ, Новый Соответствие(), КукиСессии(), "/pools");
	Возврат Ответ.ТелоТекст;
КонецФункции

Функция Проводник()
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер("КонтроллерПроводника").Проводник(Ответ, Новый Соответствие(), КукиСессии(), "GET", "/tour");
	Возврат Ответ.ТелоТекст;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИменаКонтроллеров()
	Возврат СтрРазделить("КонтроллерЛендинга,КонтроллерКаталога,КонтроллерПакета,КонтроллерПула,"
		+ "КонтроллерСпискаПулов,КонтроллерПроводника", ",");
КонецФункции

// Контроллеры контейнер не собирает (им нужен winow): собираем по их конструктору — каждый
// пластилин — желудь того же имени из контейнера, необязательный без желудя — Неопределено.
Функция Контроллер(Знач Имя)

	Файлы = НайтиФайлы(КаталогКлассов, Имя + ".os", Истина);
	Ожидаем.Что(Файлы.Количество(), "КОНТРОЛЬ: файл контроллера " + Имя).Равно(1);
	Текст = Новый ЧтениеТекста(Файлы[0].ПолноеИмя, КодировкаТекста.UTF8).Прочитать();
	Конструктор = Сред(Текст, СтрНайти(Текст, "Процедура ПриСозданииОбъекта("));
	Конструктор = Лев(Конструктор, СтрНайти(Конструктор, ")" + Символы.ПС) );

	Аргументы = Новый Массив();
	Выражение = Новый РегулярноеВыражение("Пластилин\(Значение = ""([^""]+)""\)\s+_\w+(\s*=\s*Неопределено)?");
	Для Каждого Совпадение Из Выражение.НайтиСовпадения(Конструктор) Цикл
		ИмяЖелудя = Совпадение.Группы[1].Значение;
		Необязательный = ЗначениеЗаполнено(Совпадение.Группы[2].Значение);
		Аргументы.Добавить(ЖелудьИлиНичего(ИмяЖелудя, Необязательный));
	КонецЦикла;

	Возврат Новый(Имя, Аргументы);

КонецФункции

Функция ЖелудьИлиНичего(Знач Имя, Знач Необязательный)

	Найденный = Неопределено;
	Попытка
		Найденный = Желудь(Имя);
	Исключение
		Найденный = Неопределено;
	КонецПопытки;
	// желудь, которого контейнер собрать не смог, — пустой аргумент: контроллер упал бы позже и не там
	Ожидаем.Что(Найденный <> Неопределено ИЛИ Необязательный, "КОНТРОЛЬ: в контейнере есть желудь " + Имя)
		.ЭтоИстина();
	Возврат Найденный;

КонецФункции

Функция КукиСессии()
	Куки = Новый КукиЗаглушка();
	Куки.Добавить("oshub_session", Сессия_.Идентификатор());
	Возврат Куки;
КонецФункции

// Форма выхода страницы — от её открывающего тега до закрывающего; нет формы — пусто.
Функция ФормаВыхода(Знач HTML)

	Начало = СтрНайти(HTML, "action=""/logout""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</form>"));

КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

#КонецОбласти
