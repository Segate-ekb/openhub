	Для Каждого Логин Из СтрРазделить(Завести("m1") + "," + Завести("m2"), ",") Цикл
		Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, Учётка(Логин).Идентификатор);
