	Ожидаем.Что(Нет.ТелоТекст, "причина названа тостом").Содержит("toast--err");

КонецПроцедуры

&Тест
Процедура ЗаведениеГруппыОтбитоеИУдачное() Экспорт

	Имя = ЗавестиГруппу("dup");

	Занятое = ОтправитьГруппы("", "имя=" + Имя + "&описание=Второй раз");
	Ожидаем.Что(Занятое.Код, "занятое имя — 400").Равно(400);
	Открытые = ОткрытыеОкна(Занятое.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно новой группы открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""имя"""), "имя помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Открытые[0], "набранное описание на месте").Содержит("value=""Второй раз""");

	Новое = "new" + УникальныеИмена.Хвост();
	Ответ = ОтправитьГруппы("", "имя=" + Новое + "&описание=Команда");
	Ожидаем.Что(Ответ.Код, "удача — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой").Равно("/hub/settings/groups?saved=1");
	Ожидаем.Что(Желудь("СервисГрупп").НайтиГруппу(Новое).Описание, "группа заведена").Равно("Команда");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Учётка с паролем прямо через службу; логин — с уникальным хвостом.
Функция Завести(Знач Приставка)
	Логин = Приставка + УникальныеИмена.Хвост();
	Желудь("СервисПользователей").СоздатьПользователя(Логин, "", "password123", "user");
	Возврат Логин;
КонецФункции

Функция ЗавестиГруппу(Знач Приставка)
	Имя = Приставка + УникальныеИмена.Хвост();
	Желудь("СлужбаГрупп").Создать(Имя, "Группа " + Приставка);
	Возврат Имя;
КонецФункции

Функция Учётка(Знач Логин)
	Возврат Желудь("СервисПользователей").НайтиПоЛогину(Логин);
КонецФункции

// GET раздела «Пользователи» с параметрами адреса «имя=значение&…».
Функция Получить(Знач Запрос)

	П = Параметры(Запрос);
	Ответ = Новый ОтветСтраницыЗаглушка();
	Люди.Пользователи(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "127.0.0.1",
		П["q"], П["role"], П["status"], П["page"], "", П["окно"]);
	Возврат Ответ;

КонецФункции

// POST раздела: "" — заведение, «<логин>/<действие>» — форма строки.
Функция Отправить(Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Заголовки = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Люди.Пользователи(Ответ, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
		Возврат Ответ;
	КонецЕсли;

	Части = СтрРазделить(Хвост, "/");
	Логин = Части[0];
	Действие = Части[1];
	Если Действие = "role" Тогда
		Люди.СменаРоли(Ответ, Логин, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
	ИначеЕсли Действие = "toggle" Тогда
		Люди.Блокировка(Ответ, Логин, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы);
	ИначеЕсли Действие = "reset" Тогда
		Люди.СбросПароля(Ответ, Логин, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
	Иначе
		Люди.Удаление(Ответ, Логин, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция ПолучитьГруппы(Знач Запрос)

	П = Параметры(Запрос);
	Ответ = Новый ОтветСтраницыЗаглушка();
	Группы.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", П["q"], П["page"], "", П["окно"]);
	Возврат Ответ;

КонецФункции

Функция ОтправитьГруппы(Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Группы.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
	Иначе
		Группы.Удаление(Ответ, СтрРазделить(Хвост, "/")[0], Новый Соответствие(), Новый КукиЗаглушка(),
			"POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция Параметры(Знач Запрос)

	Результат = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить("q,role,status,page,окно", ",") Цикл
		Результат.Вставить(Имя, "");
	КонецЦикла;
	Для Каждого Пара Из СтрРазделить(Запрос, "&", Ложь) Цикл
		Равно = СтрНайти(Пара, "=");
		Результат.Вставить(Лев(Пара, Равно - 1), Сред(Пара, Равно + 1));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Логины строк таблицы, начинающиеся с приставки, через запятую в порядке показа.
Функция Логины(Знач Ответ, Знач Приставка)

	Результат = Новый Массив();
	Для Каждого Строка_ Из Куски(Ответ.ТелоТекст, "<tr") Цикл
		Позиция = СтрНайти(Строка_, ">" + Приставка);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Строка_, Позиция + 1);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, "<") - 1));
	КонецЦикла;
	Возврат СтрСоединить(Результат, ",");

КонецФункции

// Адрес пункта колонки разделов, помеченного текущим.
Функция АктивныйРаздел(Знач HTML)

	Позиция = СтрНайти(HTML, "tree__link--active");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Тег_ = Сред(HTML, СтрНайти(Лев(HTML, Позиция), "<a ", НаправлениеПоиска.СКонца));
	Тег_ = Лев(Тег_, СтрНайти(Тег_, ">"));
	Хвост = Сред(Тег_, СтрНайти(Тег_, "href=""") + 6);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

// Строка таблицы с логином в первой ячейке: от её <tr до следующей.
Функция СтрокаТаблицы(Знач HTML, Знач Логин)
	Для Каждого Строка_ Из Куски(HTML, "<tr") Цикл
		Если СтрНайти(Строка_, ">" + Логин + "<") > 0 Тогда
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Текст тостов страницы: причина отказа, названная над разделом.
Функция Тост(Знач Ответ)
	Результат = Новый Массив();
	Для Каждого Кусок Из Куски(Ответ.ТелоТекст, "toast__text"">") Цикл
		Хвост = Сред(Кусок, СтрДлина("toast__text"">") + 1);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, "<") - 1));
	КонецЦикла;
	Возврат СтрСоединить(Результат, " / ");
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Куски разметки, каждый — от начала образца до следующего такого же.
Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
