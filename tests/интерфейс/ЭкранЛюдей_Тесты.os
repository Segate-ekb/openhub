#КонецОбласти

#Область ОтборИСтраницы

&Тест
Процедура ОтборПоРолиИСтатусуСужаетСписок() Экспорт

	Приставка = "flt" + УникальныеИмена.Хвост();
	Желудь("СервисПользователей").СоздатьПользователя(Приставка + "-adm", "", "password123", "admin");
	Желудь("СервисПользователей").СоздатьПользователя(Приставка + "-usr", "", "password123", "user");
	Заблокированный = Желудь("СервисПользователей").СоздатьПользователя(Приставка + "-off", "", "password123", "user");
	Желудь("СервисАктивностиУчёток").УстановитьАктивность(Админ, Заблокированный, Ложь);
	Желудь("СервисПользователей").СоздатьПользователя(Приставка + "-inv", "", "", "user", Ложь, Ложь);

	Ожидаем.Что(Логины(Получить("q=" + Приставка + "&role=admin"), Приставка), "роль admin")
		.Равно(Приставка + "-adm");
	Ожидаем.Что(Логины(Получить("q=" + Приставка + "&status=blocked"), Приставка), "заблокированные")
		.Равно(Приставка + "-off");
	Ожидаем.Что(Логины(Получить("q=" + Приставка + "&status=nologin"), Приставка), "нечем войти")
		.Равно(Приставка + "-inv");
	Ожидаем.Что(Логины(Получить("q=" + Приставка + "&role=user&status=active"), Приставка),
		"роль и статус вместе").Равно(Приставка + "-usr");

	// незнакомое значение отбора отброшено, а не отбирает пустоту
	Ожидаем.Что(СтрРазделить(Логины(Получить("q=" + Приставка + "&role=superadmin&status=x"), Приставка),
		",").Количество(), "мусор в отборе не сужает список").Равно(4);

	Пусто = Получить("q=" + Приставка + "&role=admin&status=blocked").ТелоТекст;
	Ожидаем.Что(Пусто, "пустая выдача объяснена").Содержит("ничего не найдено");

КонецПроцедуры

&Тест
Процедура СтраницыДелятСписокИНесутОтбор() Экспорт

	Приставка = "pg" + УникальныеИмена.Хвост();
	Для Номер = 1 По 22 Цикл
		Желудь("СервисПользователей").СоздатьПользователя(
			Приставка + "-" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0"), "", "password123", "user");
	КонецЦикла;

	Первая = Получить("q=" + Приставка);
	Ожидаем.Что(СтрРазделить(Логины(Первая, Приставка), ",").Количество(), "на первой странице 20").Равно(20);
	Ожидаем.Что(Первая.ТелоТекст, "диапазон записей назван").Содержит("1–20 из 22");
	Ожидаем.Что(Первая.ТелоТекст, "шаг вперёд несёт отбор").Содержит("q=" + Приставка);

	Вторая = Получить("q=" + Приставка + "&page=2");
	Ожидаем.Что(СтрРазделить(Логины(Вторая, Приставка), ",").Количество(), "на второй — остаток").Равно(2);

	Дальняя = Получить("q=" + Приставка + "&page=40");
	Ожидаем.Что(Логины(Дальняя, Приставка), "номер за концом читается последней страницей")
		.Равно(Логины(Вторая, Приставка));

КонецПроцедуры

// Правка возвращает к тому же списку: отбор едет в форме скрытыми полями и уходит в адрес ответа.
&Тест
Процедура ОтборПереживаетПравку() Экспорт

	Логин = Завести("keep");

	Меню = Получить("q=" + Логин + "&role=user").ТелоТекст;
	Ожидаем.Что(Меню, "форма блокировки несёт отбор").Содержит("name=""q"" value=""" + Логин + """");
	Ожидаем.Что(Меню, "окна строки открываются с тем же отбором")
		.Содержит(Закодировать("окно") + "=" + Закодировать("удалить-" + Логин));

	Ответ = Отправить(Логин + "/toggle", "активна=0&q=" + Логин + "&role=user");
	Ожидаем.Что(Ответ.Код, "блокировка — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "ответ ведёт к тому же отбору")
		.Равно("/hub/settings/users?q=" + Логин + "&role=user&saved=1");

	Удаление = Отправить(Логин + "/delete", "логин=" + Логин + "&q=" + Логин);
	Ожидаем.Что(Раскодировать(Удаление.ПутьРедиректа), "подтверждение открывается над тем же отбором")
		.Равно("/hub/settings/users?q=" + Логин + "&окно=удалить-" + Логин);

КонецПроцедуры

#КонецОбласти

#Область Группы

