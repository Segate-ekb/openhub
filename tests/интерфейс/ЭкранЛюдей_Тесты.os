	Ожидаем.Что(Открытые.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "эхо ждёт имя группы").Содержит("pattern=""" + Имя + """");
	Ожидаем.Что(Открытые[0], "последствия называют остающихся").Содержит("2 участника останутся в хабе");

КонецПроцедуры

