// Экраны «Пользователи» и «Группы» дома «Хаб» — таблица с ⚙ в строке, отбор и страницы в адресе,
// окна и подтверждения по адресу: настоящими контроллерами поверх настоящих служб входа и прав.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Принципалы;    // фикстура СтендПринципалов
Перем Люди;          // КонтроллерАдминистрирования
Перем Группы;        // КонтроллерГруппХаба
Перем Админ;         // учётка, от имени которой открыт раздел
Перем Гвард;         // ГвардХабаЗаглушка — впускает админа либо никого

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	// хранилище и публикация — ради удаления учётки: уборка личного пространства сносит область
	// файлов и входящие заявки, без них удаление сорвётся на пустой ссылке
	Слои.Подключить("данные, хранилище, публикация, реестр, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	// уведомления — ради удаления учётки: её лента уходит вместе с ней
	Слои.Подключить("почта, уведомления, вход, права, настройки, гео, сеть, интерфейс/общее, интерфейс/хаб");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ДомГруппы,КонтроллерАдминистрирования,КонтроллерГруппХаба", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкЖурналЗамка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ГвардХабаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-людей-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Админ = Желудь("СервисПользователей").СоздатьПользователя("root8l", "", "password123", "admin");
	Гвард = Новый ГвардХабаЗаглушка();
	Гвард.Впустить(Админ, Принципалы.Сессия(Админ));

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка;
	// администратора в нём узнаёт настоящая модель прав — смотрящий здесь настоящая учётка
	UI = Новый СборкаUI().Собрать(Интерфейс);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Желудь("СервисПрав"), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));

	ПультЛюдей = Новый ПультУчёток(Гейт, Желудь("РазборФормы"), Желудь("ОкноУчётки"),
		Желудь("СервисПользователей"), Желудь("СервисАктивностиУчёток"), Желудь("УдалениеУчётки"),
		Желудь("СлужбаПриглашений"), Желудь("ОтказыУчёток"), Желудь("ТекстСбоя"), Желудь("ТекстыИнтерфейса"));
	Люди = Новый КонтроллерАдминистрирования(Гвард, Ответы, Желудь("ДомХаба"), Желудь("ВитринаУчёток"),
		ПультЛюдей, Защита, Желудь("ОкноРаздела"), Желудь("ОтборЛюдей"));

	ПультГрупп = Новый ПультГруппХаба(Гейт, Желудь("РазборФормы"), Желудь("ОкноГруппы"),
		Желудь("СлужбаГрупп"), Желудь("СервисГрупп"), Желудь("ТекстыИнтерфейса"));
	Группы = Новый КонтроллерГруппХаба(Гвард, Ответы, Желудь("ДомХаба"), Желудь("ВитринаГруппХаба"),
		ПультГрупп, Защита, Желудь("ОкноРаздела"), Желудь("ОтборЛюдей"));

КонецПроцедуры

#Область Вкладка

// Вкладку называет одна дверь дома: раздел, дом и его объект — как у остальных разделов хаба.
&Тест
Процедура ВкладкиПользователейИГруппНазываютСвойРазделИДом() Экспорт

	Тексты = Желудь("ТекстыИнтерфейса");
	Дом = Тексты.Текст("settings.hub.title");
	Для Каждого КиЗ Из Новый Структура("Пользователи, Группы", Получить(""), ПолучитьГруппы("")) Цикл
		Подпись = Тексты.Текст(?(КиЗ.Ключ = "Пользователи", "settings.hub.nav.people", "settings.hub.nav.groups"));
		Начало = СтрНайти(КиЗ.Значение.ТелоТекст, "<title>") + СтрДлина("<title>");
		Титул = Сред(КиЗ.Значение.ТелоТекст, Начало, СтрНайти(КиЗ.Значение.ТелоТекст, "</title>") - Начало);
		Титул = Лев(Титул, СтрНайти(Титул, " — ", НаправлениеПоиска.СКонца) - 1);
		// объект дома «Хаб» — инсталляция, у всех его разделов один
		Ожидаем.Что(Титул, "вкладка раздела").Равно(Подпись + " · " + Дом + " · " + Желудь("ОписаниеПриложения").Имя());
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Гвард

// Каждую дверь раздела стережёт гвард дома «Хаб»: кого он не впустил, тот не трогает ни учётку,
// ни группу. У удаления группы второй сети в домене нет — держит только гвард.
&Тест
Процедура ДвериНеТрогаютДоменТогоКогоГвардНеВпустил() Экспорт

	Логин = Завести("grd");
	Группа = ЗавестиГруппу("grd");
	НоваяУчётка = "grdnew" + УникальныеИмена.Хвост();
	НоваяГруппа = "grdnew" + УникальныеИмена.Хвост();

	Ответы = Новый Массив();
	Гвард.НеВпускать();
	Попытка
		Ответы.Добавить(Отправить(Логин + "/toggle", "активна=0"));
		Ответы.Добавить(Отправить(Логин + "/role", "confirmed=1&роль=admin"));
		Ответы.Добавить(Отправить(Логин + "/reset", "confirmed=1"));
		Ответы.Добавить(Отправить(Логин + "/delete", "confirmed=1&логин=" + Логин));
		Ответы.Добавить(Отправить("", "логин=" + НоваяУчётка + "&email=&роль=admin"));
		Ответы.Добавить(ОтправитьГруппы(Группа + "/delete", "confirmed=1&имя=" + Группа));
		Ответы.Добавить(ОтправитьГруппы("", "имя=" + НоваяГруппа + "&описание="));
	Исключение
		Гвард.НеВпускать(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Гвард.НеВпускать(Ложь);

	Ожидаем.Что(Учётка(Логин), "учётка цела").Существует();
	Ожидаем.Что(Учётка(Логин).Активен, "и не заблокирована").ЭтоИстина();
	Ожидаем.Что(Учётка(Логин).РольХаба, "роль прежняя").Равно("user");
	Ожидаем.Что(Учётка(НоваяУчётка), "новой учётки нет").Равно(Неопределено);
	Ожидаем.Что(Желудь("СервисГрупп").НайтиГруппу(Группа), "группа на месте").Существует();
	Ожидаем.Что(Желудь("СервисГрупп").НайтиГруппу(НоваяГруппа), "новой группы нет").Равно(Неопределено);
	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "oshub_inv_"), "ссылка установки пароля не выпущена").Равно(0);
	КонецЦикла;

	// КОНТРОЛЬ: впущенному та же блокировка доходит до домена
	Отправить(Логин + "/toggle", "активна=0");
	Ожидаем.Что(Учётка(Логин).Активен, "КОНТРОЛЬ: впущенный блокирует").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Пользователи

&Тест
Процедура ОкноУдаленияПоАдресуПечатаетсяОткрытымСЭхомЛогина() Экспорт

	Логин = Завести("del");

	Страница = Получить("окно=удалить-" + Логин);

	Ожидаем.Что(Страница.Код, "страница с окном отдана").Равно(200);
	Открытые = ОткрытыеОкна(Страница.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто ровно одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это подтверждение").Содержит("modal--confirm");
	Ожидаем.Что(Открытые[0], "эхо ждёт логин").Содержит("pattern=""" + Логин + """");
	Ожидаем.Что(Открытые[0], "форма уходит на удаление этой учётки")
		.Содержит("action=""/hub/settings/users/" + Логин + "/delete""");

	// КОНТРОЛЬ: без параметра окна на странице ни одного открытого окна
	Ожидаем.Что(ОткрытыеОкна(Получить("").ТелоТекст).Количество(), "без ?окно= окна закрыты").Равно(0);

КонецПроцедуры

// Своя строка без меню: ни блокировки, ни смены роли, ни удаления себя — и по адресу тоже.
&Тест
Процедура СвоейСтрокеНетНиМенюНиОкон() Экспорт

	Логин = Завести("own");
	Страница = Получить("q=" + Админ.Логин).ТелоТекст;
	Своя = СтрокаТаблицы(Страница, Админ.Логин);
	Ожидаем.Что(Своя, "КОНТРОЛЬ: своя строка в выдаче").Заполнено();
	Ожидаем.Что(СтрНайти(Своя, "popovertarget"), "у своей строки меню ⚙ нет").Равно(0);
	Ожидаем.Что(СтрокаТаблицы(Получить("q=" + Логин).ТелоТекст, Логин), "КОНТРОЛЬ: у чужой меню есть")
		.Содержит("popovertarget");

	Для Каждого Вид Из СтрРазделить("роль,сброс,удалить", ",") Цикл
		Ожидаем.Что(ОткрытыеОкна(Получить("окно=" + Вид + "-" + Админ.Логин).ТелоТекст).Количество(),
			"окна «" + Вид + "» для себя нет").Равно(0);
		Ожидаем.Что(ОткрытыеОкна(Получить("окно=" + Вид + "-" + Логин).ТелоТекст).Количество(),
			"КОНТРОЛЬ: окно «" + Вид + "» чужой учётки есть").Равно(1);
	КонецЦикла;

КонецПроцедуры

// Пустой ячейки в таблице нет: учётка без адреса почты печатает прочерк.
&Тест
Процедура УчёткаБезПочтыПечатаетПрочерк() Экспорт

	БезПочты = СтрокаТаблицы(Получить("q=" + Админ.Логин).ТелоТекст, Админ.Логин);
	Ожидаем.Что(БезПочты, "у учётки без почты прочерк").Содержит("—");

	Логин = "mail" + УникальныеИмена.Хвост();
	Желудь("СервисПользователей").СоздатьПользователя(Логин, Логин + "@ex.com", "password123", "user");
	СПочтой = СтрокаТаблицы(Получить("q=" + Логин).ТелоТекст, Логин);
	Ожидаем.Что(СПочтой, "КОНТРОЛЬ: адрес почты на месте").Содержит(Логин + "@ex.com");
	Ожидаем.Что(СтрНайти(СПочтой, "—"), "и прочерка у неё нет").Равно(0);

КонецПроцедуры

// Роль в строке таблицы — словом, тем же, что в окне заведения, а не кодом роли.
&Тест
Процедура РольВСтрокеНазванаСловом() Экспорт

	Тексты = Желудь("ТекстыИнтерфейса");
	Логин = "role" + УникальныеИмена.Хвост();
	Желудь("СервисПользователей").СоздатьПользователя(Логин, "", "password123", "user");

	Пользователь = СтрокаТаблицы(Получить("q=" + Логин).ТелоТекст, Логин);
	Администратор = СтрокаТаблицы(Получить("q=" + Админ.Логин).ТелоТекст, Админ.Логин);

	Ожидаем.Что(Пользователь, "пользователь назван словом").Содержит(">" + Тексты.Текст("settings.hub.users.role.user") + "<");
	Ожидаем.Что(Администратор, "администратор — тоже").Содержит(">" + Тексты.Текст("settings.hub.users.role.admin") + "<");
	Ожидаем.Что(СтрНайти(Пользователь, ">user<") + СтрНайти(Администратор, ">admin<"), "кода роли в строке нет")
		.Равно(0);
	Ожидаем.Что(Получить("").ТелоТекст, "отбор по роли называет её тем же словом")
		.Содержит(">" + Тексты.Текст("settings.hub.users.role.admin") + "</option>");

КонецПроцедуры

&Тест
Процедура НеизвестноеОкноДаётСтраницуБезОкна() Экспорт

	Логин = Завести("unk");

	Для Каждого Окно Из СтрРазделить("удалить-нет-такого,зачем-" + Логин + ",удалить,роль", ",") Цикл
		Страница = Получить("окно=" + Окно);
		Ожидаем.Что(Страница.Код, "?окно=" + Окно + " — страница раздела").Равно(200);
		Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;

КонецПроцедуры

// Окно нового пользователя на странице всегда, закрытым; кнопка «Добавить пользователя» без скрипта
// ведёт на адрес, где сервер печатает его открытым.
&Тест
Процедура ОкноЗаведенияОткрываетсяПоАдресу() Экспорт

	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Страница, "кнопка ведёт на окно по адресу")
		.Содержит("href=""/hub/settings/users?" + Закодировать("окно") + "=" + Закодировать("новый") + """");
	Ожидаем.Что(Страница, "окно заведения на странице").Содержит("id=""polzovatel-novyi""");
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "и закрыто").Равно(0);

	Открытые = ОткрытыеОкна(Получить("окно=новый").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по ?окно=новый открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно нового пользователя").Содержит("id=""polzovatel-novyi""");
	Ожидаем.Что(Открытые[0], "роль выбирается прямо в окне").Содержит("<select");

КонецПроцедуры

&Тест
Процедура ОтбитоеЗаведениеВозвращаетОткрытоеОкноСНабранным() Экспорт

	Пустой = Отправить("", "логин=&email=nobody@ex.com&роль=user");
	Ожидаем.Что(Пустой.Код, "без логина — 400").Равно(400);
	Открытые = ОткрытыеОкна(Пустой.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно нового пользователя открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""логин"""), "поле логина помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""email"""), "набранный адрес на месте")
		.Содержит("value=""nobody@ex.com""");

	// логин занят: отказ домена ложится под логин, набранный адрес не съеден
	Занятый = Отправить("", "логин=" + Админ.Логин + "&email=dubl@ex.com&роль=user");
	Ожидаем.Что(Занятый.Код, "занятый логин — 4xx").Больше(399);
	Открытые = ОткрытыеОкна(Занятый.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно снова открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""логин"""), "отказ — под логином")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Открытые[0], "набранный адрес на месте").Содержит("value=""dubl@ex.com""");

КонецПроцедуры

// Ссылка установки пароля в адрес не попадает: удача отвечает страницей, где ссылка — открытым
// окном, и второй раз её не показать.
&Тест
Процедура ЗаведениеПоказываетСсылкуОдинРаз() Экспорт

	Логин = "inv" + УникальныеИмена.Хвост();
	Ответ = Отправить("", "логин=" + Логин + "&email=&роль=user");

	Ожидаем.Что(Ответ.Код, "удача — страница, а не перенаправление").Равно(200);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто окно выпущенной ссылки").Равно(1);
	Ожидаем.Что(Открытые[0], "в нём ссылка установки пароля").Содержит("oshub_inv_");
	Ожидаем.Что(СтрНайти(Открытые[0], "data-closes"), "закрытия на месте нет — ссылка уходит только переходом")
		.Равно(0);
	Ожидаем.Что(Открытые[0], "крестик и «Закрыть» уводят на список").Содержит("href=""/hub/settings/users""");
	Ожидаем.Что(Открытые[0], "Esc со скриптом — туда же").Содержит("data-close-to=""/hub/settings/users""");
	Ожидаем.Что(Учётка(Логин), "учётка заведена").Существует();
	Ожидаем.Что(Учётка(Логин).Активен, "и закрыта до установки пароля").ЭтоЛожь();

	Ожидаем.Что(СтрНайти(Получить("q=" + Логин).ТелоТекст, "oshub_inv_"), "второй раз ссылки нет").Равно(0);

КонецПроцедуры

&Тест
Процедура УдалениеБезПодтвержденияВедётНаОкноИУчёткаЦела() Экспорт

	Логин = Завести("noc");

	Ответ = Отправить(Логин + "/delete", "логин=" + Логин);

	Ожидаем.Что(Ответ.Код, "первая отправка — 303").Равно(303);
	Ожидаем.Что(Раскодировать(Ответ.ПутьРедиректа), "на страницу с открытым подтверждением")
		.Равно("/hub/settings/users?окно=удалить-" + Логин);
	Ожидаем.Что(Учётка(Логин), "учётка цела").Существует();

КонецПроцедуры

&Тест
Процедура НеверноеЭхоДаёт400УчёткаЦелаВерноеУдаляет() Экспорт

	Логин = Завести("echo");

	Неверно = Отправить(Логин + "/delete", "confirmed=1&логин=" + Админ.Логин);
	Ожидаем.Что(Неверно.Код, "неверное эхо — 400").Равно(400);
	Открытые = ОткрытыеОкна(Неверно.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение осталось открытым").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""логин"""), "эхо-поле помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Учётка(Логин), "учётка цела").Существует();
	Ожидаем.Что(Учётка(Админ.Логин), "КОНТРОЛЬ: чужой логин в эхе своего не снимает").Существует();

	Верно = Отправить(Логин + "/delete", "confirmed=1&логин=" + Логин);
	Ожидаем.Что(Верно.Код, "верное эхо — 303: " + Тост(Верно)).Равно(303);
	Ожидаем.Что(Учётка(Логин), "учётки нет").Равно(Неопределено);

КонецПроцедуры

// Себя не удалить и роль себе не сменить: отказ домена назван на странице, окна для себя нет.
&Тест
Процедура ОтказДоменаПроСебяНазванНаСтранице() Экспорт

	Удаление = Отправить(Админ.Логин + "/delete", "confirmed=1&логин=" + Админ.Логин);
	Ожидаем.Что(Удаление.Код, "себя не удалить — 4xx").Больше(399);
	Ожидаем.Что(Удаление.ТелоТекст, "причина названа тостом раздела").Содержит("toast--err");
	Ожидаем.Что(Тост(Удаление), "и словами").Содержит("Учётная запись НЕ удалена");

	Роль = Отправить(Админ.Логин + "/role", "confirmed=1&роль=user");
	Ожидаем.Что(Роль.Код, "свою роль не сменить — 400").Равно(400);
	Ожидаем.Что(Роль.ТелоТекст, "причина названа").Содержит("свою роль изменить нельзя");
	Ожидаем.Что(Учётка(Админ.Логин).РольХаба, "роль осталась").Равно("admin");

КонецПроцедуры

&Тест
Процедура СменаРолиТолькоСПодтверждением() Экспорт

	Логин = Завести("role");

	БезВопроса = Отправить(Логин + "/role", "роль=admin");
	Ожидаем.Что(БезВопроса.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(БезВопроса.ПутьРедиректа), "на окно смены роли")
		.Равно("/hub/settings/users?окно=роль-" + Логин);
	Ожидаем.Что(Учётка(Логин).РольХаба, "роль не изменилась").Равно("user");

	Окно = ОткрытыеОкна(Получить("окно=роль-" + Логин).ТелоТекст);
	Ожидаем.Что(Окно.Количество(), "окно смены роли открыто").Равно(1);
	Ожидаем.Что(Тег(Окно[0], "input", "name=""роль"""), "окно несёт запрошенную роль")
		.Содержит("value=""admin""");

	Ожидаем.Что(Отправить(Логин + "/role", "confirmed=1&роль=admin").Код, "подтверждено — 303").Равно(303);
	Ожидаем.Что(Учётка(Логин).РольХаба, "роль выдана").Равно("admin");
	// повтор той же отправки роль обратно не переворачивает
	Отправить(Логин + "/role", "confirmed=1&роль=admin");
	Ожидаем.Что(Учётка(Логин).РольХаба, "повтор не снимает роль").Равно("admin");

	Окно = ОткрытыеОкна(Получить("окно=роль-" + Логин).ТелоТекст);
	Ожидаем.Что(Тег(Окно[0], "input", "name=""роль"""), "у администратора окно предлагает снятие")
		.Содержит("value=""user""");
	Отправить(Логин + "/role", "confirmed=1&роль=user");
	Ожидаем.Что(Учётка(Логин).РольХаба, "роль снята").Равно("user");

	Выдуманная = Отправить(Логин + "/role", "confirmed=1&роль=superadmin");
	Ожидаем.Что(Выдуманная.Код, "неизвестная роль — 400").Равно(400);
	Ожидаем.Что(Учётка(Логин).РольХаба, "выдуманная роль в базу не попала").Равно("user");

КонецПроцедуры

// Форма блокировки называет желаемое состояние: повтор отправки его не переворачивает.
&Тест
Процедура БлокировкаМеняетАктивностьВДомене() Экспорт

	Логин = Завести("blk");

	Ответ = Отправить(Логин + "/toggle", "активна=0");
	Ожидаем.Что(Ответ.Код, "блокировка — 303").Равно(303);
	Ожидаем.Что(Учётка(Логин).Активен, "учётка заблокирована").ЭтоЛожь();
	Отправить(Логин + "/toggle", "активна=0");
	Ожидаем.Что(Учётка(Логин).Активен, "повтор не разблокирует").ЭтоЛожь();

	Отправить(Логин + "/toggle", "активна=1");
	Ожидаем.Что(Учётка(Логин).Активен, "разблокирована").ЭтоИстина();

	Себя = Отправить(Админ.Логин + "/toggle", "активна=0");
	Ожидаем.Что(Себя.Код, "себя не заблокировать — 400").Равно(400);
	Ожидаем.Что(Себя.ТелоТекст, "причина названа").Содержит("себя заблокировать нельзя");

КонецПроцедуры

