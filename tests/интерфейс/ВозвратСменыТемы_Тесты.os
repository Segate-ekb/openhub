// Смена темы с экрана входа и регистрации возвращает на тот же экран с тем же возвратом:
// хаб отдаёт наружу no-referrer, и путь возврата несёт сама форма темы.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Окружение;   // ОкружениеЭкрановВхода — провайдеров нет, пароль и регистрация открыты
Перем Форма;       // ФормаТемыСтраницы — путь возврата формы темы, как его прочтёт сервер

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьЭкраны() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ОкружениеЭкрановВхода");
	РеестрФикстур.Подключить("ФормаТемыСтраницы");

	UI = Новый СборкаUI().Собрать(Интерфейс);

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ВозвратПослеВхода");
	Поиск.Подключить(Интерфейс, "РазборФормы");
	Поиск.Подключить(Интерфейс, "ПосетительЗапроса");
	Поиск.Подключить(Интерфейс, "СтраницаДоступа");
	Поиск.Подключить(Интерфейс, "КонтроллерВходаOIDC");
	Поиск.Подключить(Интерфейс, "КонтроллерРегистрации");

	Окружение = Новый ОкружениеЭкрановВхода(UI.Кит);
	Форма = Новый ФормаТемыСтраницы();

КонецПроцедуры

// Вход, на который пришли с возвратом, после смены темы остаётся тем же входом: иначе после
// входа человек попал бы в кабинет, а не туда, куда шёл.
&Тест
Процедура СменаТемыНаВходеСохраняетВозврат() Экспорт

	Страница = Вход("/pools/corp?page=2");

	Ожидаем.Что(Форма.ПутьВозврата(Страница), "вход с тем же возвратом")
		.Равно(Новый ВозвратПослеВхода().АдресВхода("/pools/corp?page=2"));
	Ожидаем.Что(Форма.ПутьВозврата(Вход("")), "вход без возврата — просто вход")
		.Равно(Новый ВозвратПослеВхода().ПутьВхода());

КонецПроцедуры

&Тест
Процедура СменаТемыНаРегистрацииСохраняетВозврат() Экспорт

	Ожидаем.Что(Форма.ПутьВозврата(Регистрация("/pools/corp")), "регистрация с тем же возвратом")
		.Равно(Новый ВозвратПослеВхода().СВозвратом("/register", "/pools/corp"));
	Ожидаем.Что(Форма.ПутьВозврата(Регистрация("")), "регистрация без возврата").Равно("/register");

КонецПроцедуры

// Чужой адрес возврата форма темы не повторяет: отвергнутый возврат не печатается и в ней.
&Тест
Процедура ЧужойВозвратВФормуТемыНеПопадает() Экспорт

	Страница = Вход("https://evil.example/phish");

	Ожидаем.Что(Форма.ПутьВозврата(Страница), "вход без чужого возврата")
		.Равно(Новый ВозвратПослеВхода().ПутьВхода());
	Ожидаем.Что(СтрНайти(Форма.Адрес(Страница), "evil"), "чужого узла в форме нет").Равно(0);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Вход(Знач Куда)

	Экран = Новый КонтроллерВходаOIDC(НоваяСтраницаДоступа(), UI.Кит, UI.Тексты, Окружение,
		Неопределено, Неопределено, Неопределено, Неопределено, Окружение, Неопределено,
		Неопределено, Новый РазборФормы(), Неопределено, Неопределено, Неопределено,
		Новый МетодыHTTP(), Новый ВозвратПослеВхода(), Окружение, Новый ПосетительЗапроса(),
		Неопределено, Окружение, Неопределено, Неопределено);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Логин(Ответ, "", Новый Соответствие(), Неопределено, "GET", "203.0.113.1", Куда);
	Возврат Ответ.ТелоТекст;

КонецФункции

Функция Регистрация(Знач Куда)

	Экран = Новый КонтроллерРегистрации(Окружение, Окружение, Неопределено, Неопределено,
		Неопределено, Неопределено, НоваяСтраницаДоступа(), UI.Кит, Окружение,
		Новый РазборФормы(), Новый МетодыHTTP(), Новый ВозвратПослеВхода());

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Регистрация(Ответ, "", Новый Соответствие(), Неопределено, "GET", "203.0.113.1", Куда);
	Возврат Ответ.ТелоТекст;

КонецФункции

// Каркас публичного экрана: тот же граф рендера, что у живого хаба.
Функция НоваяСтраницаДоступа()
	Возврат Новый СтраницаДоступа(UI.Кит, UI.Каркас, UI.Тексты, Новый ВозвратПослеВхода(),
		UI.Бренд, UI.Обрамление);
КонецФункции

#КонецОбласти
