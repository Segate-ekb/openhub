// Адреса разделов «Апстримы» и «Зеркала» дома пула в настоящем маршрутизаторе winow: литерал без
// своего действия перекрывает шаблон раздела на том же уровне без отката, поэтому куда уходит каждый
// адрес — стережёт таблица маршрутов, а не вызов метода контроллера.

#Использовать asserts
#Использовать "../фикстуры"

Перем Маршруты;   // фикстура МаршрутыХаба — таблица маршрутов хаба в маршрутизаторе winow

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("МаршрутыХаба");
КонецПроцедуры

&ПередВсеми
Процедура СобратьМаршруты() Экспорт
	Маршруты = Новый МаршрутыХаба(КаталогиПроекта.Модули());
КонецПроцедуры

&Тест
Процедура АдресаАпстримовУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик(Дом() + "/upstreams", "Раздел", "КонтроллерАпстримовПула");
	ПроверитьОбработчик(Дом() + "/upstreams/publication", "Публикация", "КонтроллерАпстримовПула");
	ПроверитьОбработчик(Дом() + "/upstreams/3/move", "Сдвиг", "КонтроллерАпстримовПула");
	ПроверитьОбработчик(Дом() + "/upstreams/3/toggle", "Переключение", "КонтроллерАпстримовПула");
	ПроверитьОбработчик(Дом() + "/upstreams/3/token-off", "СнятиеТокена", "КонтроллерАпстримовПула");
	ПроверитьОбработчик(Дом() + "/upstreams/3/delete", "Удаление", "КонтроллерАпстримовПула");

КонецПроцедуры

&Тест
Процедура АдресаЗеркалУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик(Дом() + "/mirrors", "Раздел", "КонтроллерЗеркалПула");
	ПроверитьОбработчик(Дом() + "/mirrors/3", "Состояние", "КонтроллерЗеркалПула");
	ПроверитьОбработчик(Дом() + "/mirrors/3/save", "Сохранение", "КонтроллерЗеркалПула");
	ПроверитьОбработчик(Дом() + "/mirrors/3/token-off", "СнятиеТокена", "КонтроллерЗеркалПула");
	ПроверитьОбработчик(Дом() + "/mirrors/3/delete", "Удаление", "КонтроллерЗеркалПула");

КонецПроцедуры

// КОНТРОЛЬ: литералы разделов источников не перехватили шаблон остальных разделов дома.
&Тест
Процедура ШаблонРазделаДомаНеЗадет() Экспорт

	ПроверитьОбработчик(Дом(), "Обзор", "КонтроллерДомаПула");
	ПроверитьОбработчик(Дом() + "/general", "Раздел", "КонтроллерДомаПула");
	ПроверитьОбработчик(Дом() + "/visibility", "Раздел", "КонтроллерДомаПула");

КонецПроцедуры

// Раздел «Теги» — свой контроллер: литерал tags побеждает шаблон раздела дома.
&Тест
Процедура АдресаТеговУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик(Дом() + "/tags", "Раздел", "КонтроллерТеговПула");
	ПроверитьОбработчик(Дом() + "/tags/stable/save", "Сохранение", "КонтроллерТеговПула");
	ПроверитьОбработчик(Дом() + "/tags/stable/delete", "Удаление", "КонтроллерТеговПула");

КонецПроцедуры

// Зеркала пула в кабинете — страница вне дома: обзор, страница пула (окна по адресу ?окно=…)
// и двери строки уходят своим точкам контроллера кабинета.
&Тест
Процедура АдресаЗеркалКабинетаУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик("/office/mirrors", "Индекс", "КонтроллерЗеркалКабинета");
	ПроверитьОбработчик("/office/mirrors/corp", "Пул", "КонтроллерЗеркалКабинета");
	ПроверитьОбработчик("/office/mirrors/corp/3/sync", "Синхронизация", "КонтроллерЗеркалКабинета");
	ПроверитьОбработчик("/office/mirrors/corp/3/toggle", "Переключение", "КонтроллерЗеркалКабинета");
	ПроверитьОбработчик("/office/mirrors/corp/3/delete", "Удаление", "КонтроллерЗеркалКабинета");

КонецПроцедуры

// Разделы «Видимость», «Квота» и «Опасная зона» — точка раздела дома.
&Тест
Процедура АдресаРазделовЗначенийУходятТочкеРаздела() Экспорт

	ПроверитьОбработчик(Дом() + "/quota", "Раздел", "КонтроллерДомаПула");
	ПроверитьОбработчик(Дом() + "/danger", "Раздел", "КонтроллерДомаПула");

КонецПроцедуры

Функция Дом()
	Возврат "/pools/corp/settings";
КонецФункции

Процедура ПроверитьОбработчик(Знач Путь, Знач Метод, Знач Контроллер)

	Обработчик = Маршруты.Обработчик(Путь);
	Ожидаем.Что(Обработчик <> Неопределено, "адрес обслуживается: " + Путь).ЭтоИстина();
	Ожидаем.Что(Обработчик.Контроллер, "контроллер адреса " + Путь).Равно(Контроллер);
	Ожидаем.Что(Обработчик.Метод, "точка маршрута адреса " + Путь).Равно(Метод);

КонецПроцедуры
