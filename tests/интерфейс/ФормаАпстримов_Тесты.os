// Раздел «Апстримы» дома «Пул»: примечание о пробном подключении совпадает с тем, делает ли хаб
// пробу, и заведённый токен не показывается; источники отдаёт заглушка, пробу — ПробникИсточника.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем UI;         // СборкаUI — граф компонентов и рендереров интерфейса
Перем Кабинет;    // РендерерКабинета
Перем Пулы;       // СервисПуловЗаглушка
Перем Пул;        // ПулЗаглушка
Перем Настройки;  // НастройкиЗаглушка — выключатель пробы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("СервисПуловЗаглушка");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	// пробник источника спрашивает ожидание похода наружу у сеть/ТаймаутыHTTP
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "СекретИсточника");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "ЗаведениеИсточникаСПробой");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "ПробникИсточника");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "ПричинаМолчания");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "журнал"),
		"ОбезличиваниеЖурнала");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "РендерерКабинета");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "ВитринаАпстримов");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "БланкРаздела");

	Кабинет = Новый РендерерКабинета(UI.Каркас);

	Пул = Новый ПулЗаглушка(7, "owned", "custom");
	Пулы = Новый СервисПуловЗаглушка();
	Пулы.ДобавитьПул(Пул);
	Пулы.ЗадатьАпстримы(Пул.Идентификатор, ЗаведённыеИсточники());

КонецПроцедуры

&ПередКаждым
Процедура ЗадатьНастройки() Экспорт
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси();
КонецПроцедуры

// Обещание пробы звучит только там, где хаб её делает: с выключенной пробой мёртвый адрес
// сохраняется молча.
&Тест
Процедура ФормаОбещаетПробуТолькоКогдаХабЕёДелает() Экспорт

	Настройки.Задать("oshub.upstream.probe.enabled", Истина);
	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, ОбещаниеПробы()) > 0,
		"с включённой пробой форма обещает подключение: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ЧестноеПредупреждение()),
		"и не говорит про выключенную пробу").Равно(0);

КонецПроцедуры

&Тест
Процедура СВыключеннойПробойФормаГоворитЧтоАдресНеПроверяется() Экспорт

	Настройки.Задать("oshub.upstream.probe.enabled", Ложь);
	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, ЧестноеПредупреждение()) > 0,
		"выключенная проба названа на самой форме: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ОбещаниеПробы()),
		"обещания, которого хаб не выполнит, на форме нет").Равно(0);

КонецПроцедуры

// Без модуля прокси пробника нет, и проба пропускается так же молча, как выключателем.
&Тест
Процедура БезМодуляProxyФормаПробуНеОбещает() Экспорт

	Разметка = РазметкаФормы(Неопределено);

	Ожидаем.Что(СтрНайти(Разметка, ЧестноеПредупреждение()) > 0,
		"без пробника форма обещает ровно столько же, сколько хаб делает").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ОбещаниеПробы()), "обещания пробы нет").Равно(0);

КонецПроцедуры

// Токен — секрет, и форма его обратно не показывает. Значение секрета в разметке — это
// утечка через «посмотреть исходный код страницы».
&Тест
Процедура ФормаНеПоказываетЗаведённыйТокен() Экспорт

	Пулы.ЗадатьАпстримы(Пул.Идентификатор, ИсточникиСТокеном("sekret-42"));

	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, "sekret-42"),
		"значения токена в разметке нет вовсе: " + Разметка).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "по токену") > 0,
		"но видно, что источник читается по токену").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ОперацияСнятия()) > 0,
		"и строка предлагает операцию снятия токена").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УАнонимногоИсточникаНечегоСнимать() Экспорт

	Пулы.ЗадатьАпстримы(Пул.Идентификатор, ЗаведённыеИсточники());

	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, "анонимно") > 0,
		"источник без токена назван анонимным: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ОперацияСнятия()),
		"операции снятия у него в строке нет").Равно(0);

КонецПроцедуры

#Область Помощники

// У пула уже есть источник: примечание судится на полном разделе, а не на пустом экране.
Функция ЗаведённыеИсточники()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Url, ВремяЖизниСек, Включён, ТокенДоступа",
		"http://hub.example.test/download/", 900, Истина, ""));
	Возврат Результат;

КонецФункции

// Значение скрытого поля операции: подпись кнопки есть и в подсказке формы, а операцию шлёт только строка.
Функция ОперацияСнятия()
	Возврат """снять-токен""";
КонецФункции

Функция ИсточникиСТокеном(Знач Токен)

	Результат = ЗаведённыеИсточники();
	Результат[0].ТокенДоступа = Токен;
	Возврат Результат;

КонецФункции

// Разметка раздела «Апстримы» дома «Пул» целиком — как её увидит браузер.
Функция РазметкаФормы(Знач Пробник)

	Витрина = Новый ВитринаАпстримов(UI.Кит, UI.Ячейки, UI.РендерерНастроек, Пулы, UI.Тексты,
		Новый БланкРаздела(UI.Кит), Новый Массив(), Желуди(Пробник), UI.Примечания);

	Результат = "";
	Секции = Витрина.Секции(Новый Структура("Пул, Адрес, Токен",
		Пул, "/pools/owned/settings/upstreams", "токен-сессии-42"));
	Для Каждого Секция Из Секции Цикл
		Результат = Результат + UI.РендерерНастроек.Отрисовать(МодельДома(Секция));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Настоящий пробник поверх заглушки настроек: выключатель читается кодом заведения источника.
Функция ПробникПоНастройкам()
	Возврат Новый ПробникИсточника(Неопределено, Настройки);
КонецФункции

// Массив-пластилин ОСени: пусто означает «желудя в контейнере нет».
Функция Желуди(Знач Желудь)
	Результат = Новый Массив();
	Если Желудь <> Неопределено Тогда
		Результат.Добавить(Желудь);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Текст из словаря: сторож стережёт, КАКОЕ примечание печатается, а не его редакцию.
Функция ОбещаниеПробы()
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст("settings.pool.upstream-new.probe.note"));
КонецФункции

Функция ЧестноеПредупреждение()
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст("settings.pool.upstream-new.probe.note.off"));
КонецФункции

Функция МодельДома(Знач Секция)

	Секции = Новый Массив();
	Секции.Добавить(Секция);

	Модель = Новый Структура();
	Модель.Вставить("Ключ", "pool");
	Модель.Вставить("Заголовок", "Настройки пула");
	Модель.Вставить("Объект", "owned");
	Модель.Вставить("Пояснение", "");
	Модель.Вставить("Разделы", Новый Массив());
	Модель.Вставить("Уведомления", Новый Массив());
	Модель.Вставить("Секции", Секции);
	Возврат Модель;

КонецФункции

#КонецОбласти
