// Раздел «Карточка» дома «Пакет»: поля карточки уходят одной формой и пометок не касаются,
// пометки «устарел» и «скрыт» — тумблерами секции «В каталоге», каждая своей формой на своём
// адресе. Настоящий контроллер, витрина, пульт и дверь правки карточки над пакетом в памяти.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Пакеты;      // ФейкПакетовКарточки — пакет, который правит экран
Перем Защита;      // ЗащитаCSRFЗаглушка
Перем Гвард;       // ГвардПакетаЗаглушка
Перем Контроллер;  // КонтроллерДомаПакета

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	РеестрФикстур.Подключить("ГвардПакетаЗаглушка");
	РеестрФикстур.Подключить("ПорогРазделаПакетаЗаглушка");
	РеестрФикстур.Подключить("ФейкПакетовКарточки");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "АдресаСтраниц");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ПравилаИменования");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ПравкаКарточкиПакета");
	КаталогWeb = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ОтветыНастроек,СборкаДомаНастроек,АдресаКаталога,ДомПула,ДомПакета,"
		+ "РазборФормы,ГейтФормы,ОтметкаСохранения,ИсходОкна,ТекстСбоя,ОкноРаздела,"
		+ "ПометкиКаталогаПакета,ВитринаКарточкиПакета,ВитринаДомаПакета,ПультКарточкиПакета,ПультПакета,"
		+ "КонтроллерДомаПакета", ",") Цикл
		Поиск.Подключить(КаталогWeb, Имя);
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура СобратьЭкран() Экспорт

	Пакеты = Новый ФейкПакетовКарточки("https://github.com/acme/cron-tasks");
	Пакеты.Пакет.Вставить("Имя", "cron-tasks");
	Пакеты.Пакет.Вставить("КлючевыеСлова", "cron, планировщик");

	Гвард = Новый ГвардПакетаЗаглушка();
	Гвард.Впустить("alice", Новый Структура("Идентификатор, Имя", 3, "corp"), Пакеты.Пакет);
	Защита = Новый ЗащитаCSRFЗаглушка();

	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Сборка, Новый ФейкСервисПрав(), UI.Тексты,
		Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	РазборФормы = Новый РазборФормы();
	Страницы = Новый АдресаСтраниц();
	ДомПула = Новый ДомПула(Сборка, UI.Тексты, Страницы, Новый АдресаКаталога());
	Дом = Новый ДомПакета(Сборка, ДомПула, Новый ПорогРазделаПакетаЗаглушка(Ложь),
		Новый ПорогРазделаПакетаЗаглушка(Ложь), UI.Тексты, Страницы);
	Пометки = Новый ПометкиКаталогаПакета();

	Карточка = Новый ВитринаКарточкиПакета(UI.Кит, UI.Тексты, Пометки);
	Витрина = Новый ВитринаДомаПакета(Дом, ДомПула, Карточка, Неопределено, Неопределено, Неопределено,
		Неопределено);
	Правка = Новый ПравкаКарточкиПакета(Пакеты, Новый ПравилаИменования(), Неопределено, Неопределено);
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), Неопределено);
	Пульт = Новый ПультПакета(Новый ПультКарточкиПакета(РазборФормы, Правка, Пометки), Неопределено,
		Неопределено, Новый ИсходОкна(Окна));

	Контроллер = Новый КонтроллерДомаПакета(Гвард, Ответы, Новый ТекстСбоя(Новый ТекстОшибки(), UI.Тексты),
		Дом, Витрина, Пульт, Неопределено, Новый ГейтФормы(Ответы, Защита, РазборФормы),
		Защита, Пакеты, UI.Тексты, Страницы, Окна);

КонецПроцедуры

#Область Тесты

&Тест
Процедура ПоляКарточкиОднойФормойАПометкиСвоимиФормами() Экспорт

	Страница = Получить();

	Ожидаем.Что(Страница.Код, "раздел отдан").Равно(200);
	ФормаКарточки = Форма(Страница.ТелоТекст, Адрес());
	Для Каждого Поле Из СтрРазделить("описание,ключевые_слова,лицензия,репозиторий", ",") Цикл
		Ожидаем.Что(ФормаКарточки, "в форме карточки поле " + Поле).Содержит("name=""" + Поле + """");
	КонецЦикла;
	Ожидаем.Что(ФормаКарточки, "ключевые слова на месте").Содержит("планировщик");
	Ожидаем.Что(ФормаКарточки, "в форме карточки нет пометки «устарел»").Не_().Содержит("name=""устарел""");
	Ожидаем.Что(ФормаКарточки, "в форме карточки нет пометки «скрыт»").Не_().Содержит("name=""скрыт""");

	Ожидаем.Что(Форма(Страница.ТелоТекст, Адрес() + "/deprecated"), "«устарел» — своя форма")
		.Содержит("name=""устарел""");
	Ожидаем.Что(Форма(Страница.ТелоТекст, Адрес() + "/hidden"), "«скрыт» — своя форма")
		.Содержит("name=""скрыт""");
	// без скрипта форму пометки отправляет одна кнопка — запасная кнопка кита у тумблера
	Для Каждого Хвост Из СтрРазделить("/deprecated,/hidden", ",") Цикл
		Ожидаем.Что(СтрЧислоВхождений(Форма(Страница.ТелоТекст, Адрес() + Хвост), "type=""submit"""),
			"форма " + Хвост + " отправляется без скрипта одной кнопкой").Равно(1);
	КонецЦикла;
	Ожидаем.Что(Страница.ТелоТекст, "без маркеров неизвестных ключей").Не_().Содержит("[?");

КонецПроцедуры

&Тест
Процедура ФормаКарточкиПометокНеКасается() Экспорт

	Пакеты.Пакет.Вставить("Устарел", Истина);
	Пакеты.Пакет.Вставить("Скрыт", Истина);

	// и поля пометок, пришедшие с формой карточки, не меняют ничего
	Ответ = Отправить("", "описание=Новое описание&ключевые_слова=cron, задачи&лицензия=MIT"
		+ "&репозиторий=https://github.com/acme/cron-tasks&устарел=0&скрыт=0");

	Ожидаем.Что(Ответ.Код, "карточка сохранена").Равно(303);
	Ожидаем.Что(Пакеты.Пакет.Описание, "описание записано").Равно("Новое описание");
	Ожидаем.Что(Пакеты.Пакет.КлючевыеСлова, "ключевые слова записаны").Равно("cron, задачи");
	Ожидаем.Что(Пакеты.Пакет.Устарел, "пометка «устарел» на месте").ЭтоИстина();
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "пометка «скрыт» на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТумблерСохраняетСвоюПометкуИВозвращаетВКарточку() Экспорт

	Ответ = Отправить("hidden", "скрыт=1");

	Ожидаем.Что(Ответ.Код, "пометка сохранена перенаправлением").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "обратно в раздел «Карточка» с отметкой")
		.Равно(Адрес() + "?saved=1");
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "пакет скрыт").ЭтоИстина();
	Ожидаем.Что(Пакеты.Пакет.Устарел, "соседняя пометка не тронута").ЭтоЛожь();
	Ожидаем.Что(Пакеты.Пакет.Описание, "поля карточки не тронуты").Равно("Описание");
	Ожидаем.Что(Форма(Получить().ТелоТекст, Адрес() + "/hidden"), "тумблер печатается включённым")
		.Содержит("checked");

	// выключенный тумблер присылает явный «0» — пометка снимается
	Ожидаем.Что(Отправить("hidden", "скрыт=0").Код, "снятие сохранено").Равно(303);
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "пакет снова виден").ЭтоЛожь();

	Ожидаем.Что(Отправить("deprecated", "устарел=1").Код, "«устарел» сохранён").Равно(303);
	Ожидаем.Что(Пакеты.Пакет.Устарел, "пакет помечен устаревшим").ЭтоИстина();
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "«скрыт» не тронут").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФормаПометкиБезЕёПоляНичегоНеМеняет() Экспорт

	Пакеты.Пакет.Вставить("Скрыт", Истина);

	Ожидаем.Что(Отправить("hidden", "устарел=1").Код, "ответ — возврат в раздел").Равно(303);
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "«скрыт» не снят чужим полем").ЭтоИстина();
	Ожидаем.Что(Пакеты.Пакет.Устарел, "и чужая пометка не поставлена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеизвестнаяПометкаОтвечаетНеНайдено() Экспорт

	Ответ = Отправить("deleted", "скрыт=1");
	Ожидаем.Что(Ответ.Код, "нет такой пометки — 404").Равно(404);

	// пометки живут только в «Карточке»: тот же хвост под другим разделом — не они
	Ожидаем.Что(Отправить("versions/hidden", "скрыт=1").Код, "пометка чужого раздела — 404").Равно(404);

	Ожидаем.Что(Пакеты.Записей, "карточку не записывали").Равно(0);
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "пакет не скрыт").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПометкаПринимаетТолькоPOSTСТокеном() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.ПометкаКаталога(Ответ, "corp", "cron-tasks", "card", "hidden", Новый Соответствие(),
		Новый КукиЗаглушка(), "GET", "");
	Ожидаем.Что(Ответ.Код, "GET на адрес пометки — 405").Равно(405);

	Защита.ЗадатьИсход(Ложь);
	Ожидаем.Что(Отправить("hidden", "скрыт=1").Код, "чужой токен — 403").Равно(403);
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "пакет не скрыт").ЭтоЛожь();
	Ожидаем.Что(Пакеты.Записей, "карточку не записывали").Равно(0);

КонецПроцедуры

// Право ставить пометку держит гвард пакета: кого он не впустил, тот пакет не скрывает и не помечает.
&Тест
Процедура ПометкуНеСтавитТотКогоГвардНеВпустил() Экспорт

	Гвард.Отказать();

	Отправить("hidden", "скрыт=1");
	Отправить("deprecated", "устарел=1");

	Ожидаем.Что(Пакеты.Записей, "карточку не записывали").Равно(0);
	Ожидаем.Что(Пакеты.Пакет.Скрыт, "пакет не скрыт").ЭтоЛожь();
	Ожидаем.Что(Пакеты.Пакет.Устарел, "пакет не помечен устаревшим").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Адрес()
	Возврат "/pools/corp/packages/cron-tasks/settings/card";
КонецФункции

Функция Получить()
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, "corp", "cron-tasks", "card", Новый Соответствие(), Новый КукиЗаглушка(), "GET", "");
	Возврат Ответ;
КонецФункции

// POST формы раздела «Карточка»: "" — форма карточки, иначе — форма пометки по её хвосту;
// «раздел/хвост» — та же форма, ушедшая на адрес другого раздела.
Функция Отправить(Знач Пометка, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Если ЗначениеЗаполнено(Пометка) Тогда
		Части = СтрРазделить(Пометка, "/");
		Раздел = ?(Части.Количество() > 1, Части[0], "card");
		Контроллер.ПометкаКаталога(Ответ, "corp", "cron-tasks", Раздел, Части[Части.ВГраница()],
			Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
	Иначе
		Контроллер.Раздел(Ответ, "corp", "cron-tasks", "card", Новый Соответствие(), Новый КукиЗаглушка(),
			"POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Форма страницы с этим адресом действия: от <form …action="адрес"> до своего </form>.
Функция Форма(Знач HTML, Знач АдресДействия)

	Признак = "action=""" + АдресДействия + """";
	Позиция = СтрНайти(HTML, Признак);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 5) <> "<form" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</form>") + 6);

КонецФункции

#КонецОбласти
