// Таблица решений пульта пулов: заведение пула окном — суд квоты и её право, отказ домена
// словами без служебной обёртки и полным отчётом в журнале; форма старой вкладки узнаётся по
// операции. Юнитом: снаружи гвард раздела отказывает раньше пульта, и эти ветки недостижимы.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем UI;            // СборкаUI — граф компонентов и рендереров интерфейса
Перем Ошибки;        // ТекстОшибки (основа)
Перем ПравилоКвоты;  // КвотаПула (реестр)
Перем Поля;          // ОкноПула — имена полей окон

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ТекстСбояЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ФейкСервисПулов");
	РеестрФикстур.Подключить("СлужбаДоступаЗаглушка");
	РеестрФикстур.Подключить("ВитринаНастроекЗаглушка");

	Интерфейс = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	UI = Новый СборкаUI().Собрать(Интерфейс);

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "КвотаПула");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "права", "Классы"), "ГвардКвотыПула");
	Для Каждого Имя Из СтрРазделить("РазборФормы,ТекстСбоя,ОкноПула,ВитринаЛичныхПространств,ПультПулов", ",") Цикл
		Поиск.Подключить(Интерфейс, Имя);
	КонецЦикла;

	Ошибки = Новый ТекстОшибки();
	ПравилоКвоты = Новый КвотаПула(Новый Массив());
	// пульту окно отдаёт только имена полей и значение операции
	Поля = Новый ОкноПула(UI.Кит, Неопределено, Неопределено, Неопределено, Неопределено, UI.Тексты);

КонецПроцедуры

#Область Квота

// Мусор в квоте судится тем же вердиктом, что правка квоты: терпимое чтение превратило бы «5oo»
// в наследование квоты хаба, и пул завёлся бы с чужим пределом.
&Тест
Процедура МусорВКвотеСозданияОтвергаетсяАПулНеЗаводится() Экспорт

	Стенд = ПостроитьСтенд();

	Исход = Стенд.Пульт.Создать(Админ(), ФормаСоздания("newpool", "5oo"));

	Ожидаем.Что(Исход.Успех, "мусор в квоте отвергнут").ЭтоЛожь();
	Ожидаем.Что(Исход.Отказы.Получить(Поля.ИмяПоляКвоты()), "отказ — под квотой").Заполнено();
	Ожидаем.Что(Стенд.Служба.Созданные().Количество(), "и пул не заведён").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустаяКвотаСозданияОзначаетКакВХабе() Экспорт

	Стенд = ПостроитьСтенд();

	Исход = Стенд.Пульт.Создать(Админ(), ФормаСоздания("newpool", ""));

	Ожидаем.Что(Исход.Успех, "форма без квоты принимается").ЭтоИстина();
	Ожидаем.Что(Стенд.Служба.Созданные()[0].КвотаМб, "пул наследует квоту хаба")
		.Равно(ПравилоКвоты.КакВХабе());

КонецПроцедуры

&Тест
Процедура ЗаданнаяКвотаСозданияДоезжаетДоСлужбы() Экспорт

	Стенд = ПостроитьСтенд();

	Стенд.Пульт.Создать(Админ(), ФормаСоздания("newpool", "256"));

	Ожидаем.Что(Стенд.Служба.Созданные()[0].КвотаМб, "квота доехала числом").Равно(256);
	Ожидаем.Что(Стенд.Служба.Созданные()[0].Тип, "руками заводится обычный пул").Равно("custom");

КонецПроцедуры

// Право на квоту спрашивается у СВОЕГО гварда: заводящий без права менять квоты получает пул
// с квотой хаба, а набранное число до службы не доезжает.
&Тест
Процедура БезПраваНаКвотуНовыйПулНаследуетКвотуХаба() Экспорт

	Стенд = ПостроитьСтенд();

	Исход = Стенд.Пульт.Создать(НеАдмин(), ФормаСоздания("newpool", "256"));

	Ожидаем.Что(Исход.Успех, "пул заведён").ЭтоИстина();
	Ожидаем.Что(Стенд.Служба.Созданные()[0].КвотаМб, "своей квоты у него нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗанятоеИмяОтбиваетсяПодИменемДоСлужбы() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Пулы.ДобавитьПул(1, "taken");

	Исход = Стенд.Пульт.Создать(Админ(), ФормаСоздания("taken", "-1"));

	Ожидаем.Что(Исход.Отказы.Получить(Поля.ИмяПоляИмени()), "отказ — под именем").Содержит("taken");
	Ожидаем.Что(Стенд.Служба.Созданные().Количество(), "служба не звана").Равно(0);
	Ожидаем.Что(Стенд.Пульт.ОтказИмени("taken"), "проверка до отправки говорит то же")
		.Равно(Исход.Отказы.Получить(Поля.ИмяПоляИмени()));

КонецПроцедуры

#КонецОбласти

#Область СтараяВкладка

// Операции прежней вкладки («пул-создать», «пул-основной», «пул-квота») новой странице неизвестны;
// адрес раздела принимает окно нового пула и формы значений раздела, формы строк операций не несут.
&Тест
Процедура ФормаСтаройВкладкиУзнаётсяПоОперации() Экспорт

	Пульт = ПостроитьСтенд().Пульт;

	Для Каждого Операция Из СтрРазделить("пул-создать,пул-основной,пул-квота,зачем", ",") Цикл
		Ожидаем.Что(Пульт.ФормаРазделаУстарела(ФормаОперации(Операция)), "раздел: " + Операция).ЭтоИстина();
	КонецЦикла;
	Для Каждого Операция Из СтрРазделить("новый-пул,сбросить,личные-пространства,", ",") Цикл
		Ожидаем.Что(Пульт.ФормаРазделаУстарела(ФормаОперации(Операция)), "КОНТРОЛЬ раздел: " + Операция)
			.ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Пульт.ФормаСтрокиУстарела(ФормаОперации("пул-удалить")), "строка: любая операция").ЭтоИстина();
	Ожидаем.Что(Пульт.ФормаСтрокиУстарела(ФормаОперации("")), "КОНТРОЛЬ строка: без операции").ЭтоЛожь();
	Ожидаем.Что(Пульт.ОтказУстаревшей().Код, "отказ старой вкладки — 400").Равно(400);

КонецПроцедуры

#КонецОбласти

#Область СбойДоменаНаЭкранеИВЖурнале

// Наружу человеку идёт причина словами — без служебной обёртки OneScript «{Модуль … /
// Error in line: N}»: пути файлов и номера строк на экране администратора не нужны.
&Тест
Процедура ОтказСозданияПулаНеПечатаетСлужебнуюОбёртку() Экспорт

	Стенд = ПостроитьСтенд(Неопределено);
	Стенд.Служба.ЗадатьОтказСоздания("имя ""public"" уже занято");

	Отказ = Стенд.Пульт.Создать(Админ(), ФормаСоздания("public", "10")).Отказы.Получить(Поля.ИмяПоляИмени());

	Ожидаем.Что(СтрНайти(Отказ, "уже занято") > 0, "причина домена доехала до человека: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "Call stack"), "стека вызовов на экране нет: " + Отказ).Равно(0);
	Ожидаем.Что(СтрНайти(Отказ, ".os"), "и путей файлов хаба тоже: " + Отказ).Равно(0);

КонецПроцедуры

// Обратная сторона: то, что не ушло на экран, обязано уйти в журнал — полным отчётом на уровне
// ОТЛАДКА.
&Тест
Процедура ОтказСозданияПулаДоезжаетДоЖурналаПолнымОтчётом() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = ПостроитьСтенд(Ловушка);
	Стенд.Служба.ЗадатьОтказСоздания("имя ""public"" уже занято");

	Стенд.Пульт.Создать(Админ(), ФормаСоздания("public", "10"));

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "уже занято") > 0, "причина доехала до журнала: " + Ловушка.Всё())
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "Call stack") > 0,
		"вместе со стеком, которого экран не видел: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Стенд

// Стенд с настоящим ТекстСбоя: заглушка обёртку не снимает и в журнал не пишет.
Функция ПостроитьСтенд(Знач Ловушка = Неопределено)

	Пулы = Новый ФейкСервисПулов(ПравилоКвоты);
	Служба = Новый СлужбаДоступаЗаглушка();
	Пульт = Новый ПультПулов(Неопределено, Новый РазборФормы(), Поля, Служба, Пулы,
		Новый ГвардКвотыПула(Новый ФейкСервисПрав()), Новый ВитринаНастроекЗаглушка(),
		Новый ВитринаЛичныхПространств(UI.Кит, UI.Тексты),
		Новый ТекстСбоя(Ошибки, UI.Тексты, ЛогСбоя(Ловушка)), UI.Тексты);
	Возврат Новый Структура("Пулы, Служба, Пульт", Пулы, Служба, Пульт);

КонецФункции

// Журнал уровня ОТЛАДКА с накопителем теста; без ловушки — журнала нет вовсе.
Функция ЛогСбоя(Знач Ловушка)

	Если Ловушка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Лог = Логирование.ПолучитьЛог("тест.oshub.пультпулов.сбой");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);
	Возврат Лог;

КонецФункции

Функция Админ()
	Возврат Новый Структура("Логин, Админ", "root", Истина);
КонецФункции

Функция НеАдмин()
	Возврат Новый Структура("Логин, Админ", "owner1", Ложь);
КонецФункции

Функция ФормаСоздания(Знач Имя, Знач Квота)

	Форма = ФормаОперации(Поля.ОперацияЗаведения());
	Форма.Вставить(Поля.ИмяПоляИмени(), Имя);
	Форма.Вставить(Поля.ИмяПоляВидимости(), "public");
	Форма.Вставить(Поля.ИмяПоляКвоты(), Квота);
	Возврат Форма;

КонецФункции

Функция ФормаОперации(Знач Операция)
	Форма = Новый Соответствие();
	Если ЗначениеЗаполнено(Операция) Тогда
		Форма.Вставить(Поля.ИмяПоляОперации(), Операция);
	КонецЕсли;
	Возврат Форма;
КонецФункции

#КонецОбласти
