// Разделы «Участники» и «Связка с OIDC» дома «Группа» на механизме «⚙ записи + окно по адресу +
// подтверждение»: состав таблицей со страницами, окно «Добавить участника» с подбором поиском,
// «Убрать из группы» подтверждением, сопоставления окном и подтверждением, политика тумблером —
// настоящим контроллером дома поверх настоящих служб групп, сопоставлений и учёток.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем UI;            // СборкаUI — каркас и экранирование текстов
Перем Админ;         // администратор хаба — правит группу
Перем Гвард;         // ГвардГруппыЗаглушка — впускает учётку в группу раздела либо никого
Перем Защита;        // ЗащитаCSRFЗаглушка — принимает токен формы либо отбивает
Перем Контроллер;    // КонтроллерДомаГруппы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, хранилище, публикация, реестр, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("почта, уведомления, вход, права, настройки, гео, сеть, кабинет,"
		+ " интерфейс/общее, интерфейс/кабинет, интерфейс/панели, интерфейс/аккаунт, интерфейс/хаб,"
		+ " интерфейс/каталог");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "КонтроллерДомаГруппы");

	Для Каждого Фикстура Из СтрРазделить("НастройкиЗаглушка,ЗаписывающийПодписчик,ФейкЖурналЗамка,ЛовушкаЛога,"
		+ "ГвардГруппыЗаглушка,ЗащитаCSRFЗаглушка,ОтветСтраницыЗаглушка,КукиЗаглушка,СборкаUI", ",") Цикл
		РеестрФикстур.Подключить(Фикстура);
	КонецЦикла;

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-дома-группы-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Админ = Желудь("СервисПользователей").СоздатьПользователя("root9g", "", "password123", "admin");
	Гвард = Новый ГвардГруппыЗаглушка();

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Желудь("СервисПрав"), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Пульт = Новый ПультДомаГруппы(Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы")), Желудь("РазборФормы"),
		Желудь("СервисГрупп"), Желудь("СервисСопоставленийГрупп"), Желудь("СервисПользователей"),
		Желудь("ТекстСбоя"), Желудь("ТекстыИнтерфейса"), Желудь("ИсходОкна"));

	Контроллер = Новый КонтроллерДомаГруппы(Гвард, Ответы, Желудь("ДомГруппы"), Желудь("ВитринаУчастниковГруппы"),
		Желудь("ВитринаСвязкиГруппы"), Желудь("ВитринаПравГруппы"), Пульт, Защита, Желудь("ОкноРаздела"),
		Желудь("ТекстыИнтерфейса"), Желудь("ПриведениеЧисел"));

КонецПроцедуры

#Область Участники

// Состав — таблица из данных: логин заглавием, откуда членство — словами, ⚙ строки — окно по адресу.
&Тест
Процедура СоставТаблицейСМенюИОткудаЧленствоСловами() Экспорт

	Группа = ЗавестиГруппу("tbl");
	Учётка = ЗавестиУчётку("mem");
	Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, Учётка.Идентификатор, "local");
	Провайдерный = ЗавестиУчётку("idp");
	Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, Провайдерный.Идентификатор, "oidc");
	Впустить(Группа, Истина);

	Страница = Получить(Группа, "members").ТелоТекст;
	Ожидаем.Что(СтрокаТаблицы(Страница, Учётка.Логин), "ручное членство названо словами")
		.Содержит(Экранировать("settings.group.members.source.local"));
	Ожидаем.Что(СтрокаТаблицы(Страница, Провайдерный.Логин), "членство от провайдера — тоже")
		.Содержит(Экранировать("settings.group.members.source.oidc"));
	Ожидаем.Что(СтрокаТаблицы(Страница, Учётка.Логин), "⚙ строки — окно «Убрать» по адресу")
		.Содержит(АдресОкна(Группа, "members", "убрать-" + Учётка.Логин));
	Ожидаем.Что(Страница, "«Добавить участника» ведёт на окно").Содержит(АдресОкна(Группа, "members", "новый"));
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "без адреса окон нет").Равно(0);

	// участнику (без права правки) — состав без меню и без кнопки добавления
	Впустить(Группа, Ложь);
	Участнику = Получить(Группа, "members").ТелоТекст;
	Ожидаем.Что(Участнику, "участнику нет окна «Убрать»").Не_().Содержит(АдресОкна(Группа, "members", "убрать-" + Учётка.Логин));
	Ожидаем.Что(Участнику, "и кнопки добавления").Не_().Содержит(АдресОкна(Группа, "members", "новый"));
	Ожидаем.Что(СтрокаТаблицы(Участнику, Учётка.Логин), "но состав виден").Содержит(Учётка.Логин);

КонецПроцедуры

// Окно «Добавить участника»: по адресу открыто, поиск сужает кандидатов и держит окно открытым,
// выбранная учётка становится участником.
&Тест
Процедура УчастникДобавляетсяОкномСПоиском() Экспорт

	Группа = ЗавестиГруппу("add");
	Учётка = ЗавестиУчётку("cand");
	Впустить(Группа, Истина);

	Открытые = ОткрытыеОкна(Получить(Группа, "members", "новый").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно по адресу открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "поиск — форма GET раздела").Содержит("method=""get""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""окно"""), "поиск держит окно открытым").Содержит("value=""новый""");

	Найдено = ОткрытыеОкна(Получить(Группа, "members", "", Учётка.Логин).ТелоТекст);
	Ожидаем.Что(Найдено.Количество(), "после поиска окно открыто").Равно(1);
	Ожидаем.Что(Найдено[0], "кандидат найден").Содержит("value=""" + Учётка.Логин + """");
	Ожидаем.Что(Найдено[0], "админа поиск отсёк").Не_().Содержит("value=""" + Админ.Логин + """");

	Ответ = Отправить(Группа, "members", "логин=" + Учётка.Логин);
	Ожидаем.Что(Ответ.Код, "удача — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой").Равно(АдресРаздела(Группа, "members") + "?saved=1");
	Ожидаем.Что(ВГруппе(Группа, Учётка), "учётка в группе").ЭтоИстина();

КонецПроцедуры

// Отказ — под полем окна, окно открыто, ничего не записано.
&Тест
Процедура ОтказДобавленияПодПолемОкна() Экспорт

	Группа = ЗавестиГруппу("addx");
	Учётка = ЗавестиУчётку("dup");
	Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, Учётка.Идентификатор, "local");
	ЗавестиУчётку("free");
	Впустить(Группа, Истина);

	Пусто = Отправить(Группа, "members", "логин=");
	Ожидаем.Что(Пусто.Код, "пустой выбор — 400").Равно(400);
	Открытые = ОткрытыеОкна(Пусто.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "select", "name=""логин"""), "поле помечено негодным").Содержит("aria-invalid=""true""");

	Повтор = Отправить(Группа, "members", "логин=" + Учётка.Логин);
	Ожидаем.Что(Повтор.Код, "уже участник — 400").Равно(400);
	Ожидаем.Что(ОткрытыеОкна(Повтор.ТелоТекст)[0], "отказ назван под полем")
		.Содержит(UI.Экран.Экранировать(UI.Тексты.Шаблон("settings.group.member-new.duplicate", Учётка.Логин)));

КонецПроцедуры

&Тест
Процедура УчастникУбираетсяТолькоПодтверждением() Экспорт

	Группа = ЗавестиГруппу("rem");
	Учётка = ЗавестиУчётку("gone");
	Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, Учётка.Идентификатор, "local");
	Впустить(Группа, Истина);

	Открытые = ОткрытыеОкна(Получить(Группа, "members", "убрать-" + Учётка.Логин).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение по адресу открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "форма — на дверь участника")
		.Содержит("action=""" + АдресРаздела(Группа, "members") + "/" + Учётка.Логин + "/delete""");
	Ожидаем.Что(ОткрытыеОкна(Получить(Группа, "members", "убрать-nobody").ТелоТекст).Количество(),
		"не участник — окна нет").Равно(0);

	БезВопроса = Убрать(Группа, Учётка.Логин, "");
	Ожидаем.Что(БезВопроса.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(БезВопроса.ПутьРедиректа), "на окно подтверждения")
		.Равно(АдресРаздела(Группа, "members") + "?окно=убрать-" + Учётка.Логин);
	Ожидаем.Что(ВГруппе(Группа, Учётка), "участник на месте").ЭтоИстина();

	Ответ = Убрать(Группа, Учётка.Логин, "confirmed=1");
	Ожидаем.Что(Ответ.Код, "подтверждено — 303").Равно(303);
	Ожидаем.Что(ВГруппе(Группа, Учётка), "участника нет").ЭтоЛожь();

	Снова = Убрать(Группа, Учётка.Логин, "confirmed=1");
	Ожидаем.Что(Снова.Код, "уже не участник — 404").Равно(404);
	Ожидаем.Что(Снова.ТелоТекст, "причина названа тостом").Содержит("toast--err");

КонецПроцедуры

// Участников больше страницы — страницы; номер за концом — последняя страница.
&Тест
Процедура СоставБольшеСтраницыИдётСтраницами() Экспорт

	Группа = ЗавестиГруппу("pg");
	Размер = Желудь("ВитринаУчастниковГруппы").РазмерСтраницы();
	Для Номер = 1 По Размер + 3 Цикл
		Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, ЗавестиУчётку("p").Идентификатор, "local");
	КонецЦикла;
	Впустить(Группа, Истина);

	Первая = Получить(Группа, "members").ТелоТекст;
	Вторая = Получить(Группа, "members", "", "", "2").ТелоТекст;
	ЗаКонцом = Получить(Группа, "members", "", "", "99").ТелоТекст;
	Ожидаем.Что(СтрЧислоВхождений(Первая, Экранировать("settings.group.members.source.local")), "первая — полная")
		.Равно(Размер);
	Ожидаем.Что(СтрЧислоВхождений(Вторая, Экранировать("settings.group.members.source.local")), "вторая — остаток")
		.Равно(3);
	Ожидаем.Что(СтрЧислоВхождений(ЗаКонцом, Экранировать("settings.group.members.source.local")),
		"за концом — последняя").Равно(3);
	Ожидаем.Что(Первая, "шаг на вторую страницу").Содержит("page=2");

КонецПроцедуры

#КонецОбласти

#Область Связка

&Тест
Процедура СопоставлениеЗаводитсяОкномИУдаляетсяПодтверждением() Экспорт

	Группа = ЗавестиГруппу("map");
	Впустить(Группа, Истина);

	Ожидаем.Что(ОткрытыеОкна(Получить(Группа, "oidc", "новый").ТелоТекст).Количество(), "окно нового открыто")
		.Равно(1);

	Пустое = Отправить(Группа, "oidc", "издатель=&клейм=groups&значение=");
	Ожидаем.Что(Пустое.Код, "пустые поля — 400").Равно(400);
	Окно = ОткрытыеОкна(Пустое.ТелоТекст)[0];
	Ожидаем.Что(Тег(Окно, "input", "name=""издатель"""), "издатель помечен").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Тег(Окно, "input", "name=""значение"""), "значение помечено").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Сопоставления(Группа).Количество(), "ничего не заведено").Равно(0);

	Ответ = Отправить(Группа, "oidc", "издатель=https://idp.example.com&клейм=groups&значение=team-a");
	Ожидаем.Что(Ответ.Код, "заведено — 303").Равно(303);
	Ожидаем.Что(Сопоставления(Группа).Количество(), "сопоставление есть").Равно(1);
	Номер = Формат(Сопоставления(Группа)[0].Идентификатор, "ЧГ=0; ЧН=0");

	Страница = Получить(Группа, "oidc").ТелоТекст;
	Ожидаем.Что(Страница, "⚙ строки — окно удаления по адресу").Содержит(АдресОкна(Группа, "oidc", "удалить-" + Номер));

	БезВопроса = УдалитьСопоставление(Группа, Номер, "");
	Ожидаем.Что(БезВопроса.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Сопоставления(Группа).Количество(), "сопоставление цело").Равно(1);
	Ожидаем.Что(ОткрытыеОкна(Получить(Группа, "oidc", "удалить-" + Номер).ТелоТекст).Количество(),
		"подтверждение по адресу открыто").Равно(1);

	УдалитьСопоставление(Группа, Номер, "confirmed=1");
	Ожидаем.Что(Сопоставления(Группа).Количество(), "сопоставления нет").Равно(0);

КонецПроцедуры

// Политика — тумблер «сохранять сразу» со своей формой; чужое значение — отказ без записи.
&Тест
Процедура ПолитикаВыпавшихТумблером() Экспорт

	Группа = ЗавестиГруппу("pol");
	Впустить(Группа, Истина);
	Сервис = Желудь("СервисСопоставленийГрупп");

	Страница = Получить(Группа, "oidc").ТелоТекст;
	Ожидаем.Что(Страница, "тумблер — своей формой").Содержит("action=""" + АдресРаздела(Группа, "oidc") + "/policy""");
	Ожидаем.Что(Страница, "без скрипта форму тумблера отправляет запасная кнопка кита").Содержит("toggle__save");

	Ответ = Политика(Группа, "политика=" + Сервис.ПолитикаОставлять());
	Ожидаем.Что(Ответ.Код, "сохранено — 303").Равно(303);
	Ожидаем.Что(Сервис.ПолитикаВыпавших(Группа.Идентификатор), "политика «оставлять»").Равно(Сервис.ПолитикаОставлять());

	Чужая = Политика(Группа, "политика=всё");
	Ожидаем.Что(Чужая.Код, "чужая политика — 400").Равно(400);
	Ожидаем.Что(Сервис.ПолитикаВыпавших(Группа.Идентификатор), "политика прежняя").Равно(Сервис.ПолитикаОставлять());

КонецПроцедуры

#КонецОбласти

#Область СтараяВкладка

// Формы старой вкладки несли операцию в теле — нынешние двери их отбивают «Страница устарела»
// и ничего не меняют; КОНТРОЛЬ — те же поля без операции работают.
&Тест
Процедура ФормаСтаройВкладкиОтбиваетсяБезМутации() Экспорт

	Группа = ЗавестиГруппу("old");
	Учётка = ЗавестиУчётку("oldc");
	Впустить(Группа, Истина);

	Состав = Отправить(Группа, "members", "операция=добавить&логин=" + Учётка.Логин);
	Ожидаем.Что(Состав.Код, "старая форма состава — 400").Равно(400);
	Ожидаем.Что(Состав.ТелоТекст, "причина названа").Содержит(Экранировать("settings.group.error.stale"));
	Ожидаем.Что(ВГруппе(Группа, Учётка), "участник не добавлен").ЭтоЛожь();

	Связка = Отправить(Группа, "oidc", "операция=добавить&издатель=https://idp.example.com&клейм=groups&значение=old");
	Ожидаем.Что(Связка.Код, "старая форма связки — 400").Равно(400);
	Ожидаем.Что(Сопоставления(Группа).Количество(), "сопоставление не заведено").Равно(0);

	Сервис = Желудь("СервисСопоставленийГрупп");
	Было = Сервис.ПолитикаВыпавших(Группа.Идентификатор);
	Иная = ?(Было = Сервис.ПолитикаОставлять(), Сервис.ПолитикаИсключать(), Сервис.ПолитикаОставлять());
	Политика_ = Политика(Группа, "операция=политика&политика=" + Иная);
	Ожидаем.Что(Политика_.Код, "старая форма политики — 400").Равно(400);
	Ожидаем.Что(Сервис.ПолитикаВыпавших(Группа.Идентификатор), "политика прежняя").Равно(Было);

	// КОНТРОЛЬ: те же поля без операции
	Отправить(Группа, "members", "логин=" + Учётка.Логин);
	Ожидаем.Что(ВГруппе(Группа, Учётка), "КОНТРОЛЬ: участник добавлен").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Гвард

// Каждую дверь разделов стережёт гвард дома: кого он не впустил (и участника без права правки),
// тому 403 без тела, а состав, сопоставления и политика прежние.
&Тест
Процедура ДвериНеТрогаютГруппуТогоКогоГвардНеВпустил() Экспорт

	Группа = ЗавестиГруппу("grd");
	Учётка = ЗавестиУчётку("grdu");
	Чужая = ЗавестиУчётку("grdm");
	Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, Чужая.Идентификатор, "local");
	Желудь("СервисСопоставленийГрупп").ДобавитьСопоставление(Группа.Идентификатор, "https://idp.example.com", "keep");
	Номер = Формат(Сопоставления(Группа)[0].Идентификатор, "ЧГ=0; ЧН=0");
	Сервис = Желудь("СервисСопоставленийГрупп");
	Было = Сервис.ПолитикаВыпавших(Группа.Идентификатор);
	Иная = ?(Было = Сервис.ПолитикаОставлять(), Сервис.ПолитикаИсключать(), Сервис.ПолитикаОставлять());

	Для Каждого Отказ_ Из СтрРазделить("гвард,участник", ",") Цикл
		Впустить(Группа, Отказ_ = "гвард");
		Если Отказ_ = "гвард" Тогда
			Гвард.НеВпускать();
		КонецЕсли;
		Ответы = Новый Массив();
		Ответы.Добавить(Отправить(Группа, "members", "логин=" + Учётка.Логин));
		Ответы.Добавить(Убрать(Группа, Чужая.Логин, "confirmed=1"));
		Ответы.Добавить(Отправить(Группа, "oidc", "издатель=https://idp.example.com&клейм=groups&значение=evil"));
		Ответы.Добавить(УдалитьСопоставление(Группа, Номер, "confirmed=1"));
		Ответы.Добавить(Политика(Группа, "политика=" + Иная));
		Для Каждого Ответ Из Ответы Цикл
			Ожидаем.Что(Ответ.Код, Отказ_ + ": 403").Равно(403);
			Ожидаем.Что(Строка(Ответ.ТелоТекст), Отказ_ + ": без тела").Равно("");
		КонецЦикла;
		Ожидаем.Что(ВГруппе(Группа, Учётка), Отказ_ + ": никого не добавили").ЭтоЛожь();
		Ожидаем.Что(ВГруппе(Группа, Чужая), Отказ_ + ": никого не убрали").ЭтоИстина();
		Ожидаем.Что(Сопоставления(Группа).Количество(), Отказ_ + ": сопоставления прежние").Равно(1);
		Ожидаем.Что(Сервис.ПолитикаВыпавших(Группа.Идентификатор), Отказ_ + ": политика прежняя").Равно(Было);
	КонецЦикла;

	// КОНТРОЛЬ: впущенный администратор той же формой участника добавляет
	Впустить(Группа, Истина);
	Отправить(Группа, "members", "логин=" + Учётка.Логин);
	Ожидаем.Что(ВГруппе(Группа, Учётка), "КОНТРОЛЬ: впущенный добавляет").ЭтоИстина();

КонецПроцедуры

// Законный администратор с неверным токеном формы (чужая страница, подделка) не меняет ничего
// ни на одной из пяти дверей: 403, состав, сопоставления и политика прежние. КОНТРОЛЬ: с верным
// токеном та же форма участника добавляет.
&Тест
Процедура НеверныйТокенАдминаНеМеняетГруппу() Экспорт

	Группа = ЗавестиГруппу("csrf");
	Учётка = ЗавестиУчётку("csrfu");
	Чужая = ЗавестиУчётку("csrfm");
	Желудь("СервисГрупп").ДобавитьУчастника(Группа.Идентификатор, Чужая.Идентификатор, "local");
	Сервис = Желудь("СервисСопоставленийГрупп");
	Сервис.ДобавитьСопоставление(Группа.Идентификатор, "https://idp.example.com", "keep");
	Номер = Формат(Сопоставления(Группа)[0].Идентификатор, "ЧГ=0; ЧН=0");
	Было = Сервис.ПолитикаВыпавших(Группа.Идентификатор);
	Иная = ?(Было = Сервис.ПолитикаОставлять(), Сервис.ПолитикаИсключать(), Сервис.ПолитикаОставлять());
	Впустить(Группа, Истина);

	Защита.ЗадатьИсход(Ложь);
	Ответы = Новый Массив();
	Ответы.Добавить(Отправить(Группа, "members", "логин=" + Учётка.Логин));
	Ответы.Добавить(Убрать(Группа, Чужая.Логин, "confirmed=1"));
	Ответы.Добавить(Отправить(Группа, "oidc", "издатель=https://idp.example.com&клейм=groups&значение=evil"));
	Ответы.Добавить(УдалитьСопоставление(Группа, Номер, "confirmed=1"));
	Ответы.Добавить(Политика(Группа, "политика=" + Иная));
	Защита.ЗадатьИсход(Истина);

	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(Ответ.Код, "неверный токен — 403").Равно(403);
	КонецЦикла;
	Ожидаем.Что(ВГруппе(Группа, Учётка), "никого не добавили").ЭтоЛожь();
	Ожидаем.Что(ВГруппе(Группа, Чужая), "никого не убрали").ЭтоИстина();
	Ожидаем.Что(Сопоставления(Группа).Количество(), "сопоставления прежние").Равно(1);
	Ожидаем.Что(Сервис.ПолитикаВыпавших(Группа.Идентификатор), "политика прежняя").Равно(Было);

	// КОНТРОЛЬ: с верным токеном та же форма участника добавляет
	Отправить(Группа, "members", "логин=" + Учётка.Логин);
	Ожидаем.Что(ВГруппе(Группа, Учётка), "КОНТРОЛЬ: верный токен добавляет").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция ЗавестиГруппу(Знач Приставка)
	Имя = Приставка + УникальныеИмена.Хвост();
	Желудь("СлужбаГрупп").Создать(Имя);
	Возврат Желудь("СервисГрупп").НайтиГруппу(Имя);
КонецФункции

Функция ЗавестиУчётку(Знач Приставка)
	Возврат Желудь("СервисПользователей").СоздатьПользователя(Приставка + УникальныеИмена.Хвост(), "",
		"password123");
КонецФункции

Процедура Впустить(Знач Группа, Знач МожетПравить)
	Гвард.Впустить(Админ, Группа, МожетПравить);
КонецПроцедуры

Функция ВГруппе(Знач Группа, Знач Учётка)
	Возврат Желудь("СервисГрупп").УчастникиГруппы(Группа.Идентификатор).Найти(Учётка.Идентификатор) <> Неопределено;
КонецФункции

Функция Сопоставления(Знач Группа)
	Результат = Новый Массив();
	Для Каждого Сопоставление Из Желудь("СервисСопоставленийГрупп").ВсеСопоставления() Цикл
		Если Сопоставление.ГруппаИдентификатор = Группа.Идентификатор Тогда
			Результат.Добавить(Сопоставление);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция АдресРаздела(Знач Группа, Знач Раздел)
	Возврат Желудь("ДомГруппы").АдресРаздела(Группа.Имя, Раздел);
КонецФункции

Функция АдресОкна(Знач Группа, Знач Раздел, Знач Значение)
	Возврат "href=""" + АдресРаздела(Группа, Раздел) + "?" + Закодировать("окно") + "=" + Закодировать(Значение) + """";
КонецФункции

// GET раздела: participants — с подбором и страницей, связка — с окном.
Функция Получить(Знач Группа, Знач Раздел, Знач Окно = "", Знач Подбор = "", Знач Страница = "")

	Ответ = Новый ОтветСтраницыЗаглушка();
	Если Раздел = "members" Тогда
		Контроллер.Участники(Ответ, Группа.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "",
			Подбор, Страница, Окно);
	Иначе
		Контроллер.Связка(Ответ, Группа.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// POST формы окна раздела.
Функция Отправить(Знач Группа, Знач Раздел, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Если Раздел = "members" Тогда
		Контроллер.Участники(Ответ, Группа.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
	Иначе
		Контроллер.Связка(Ответ, Группа.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция Убрать(Знач Группа, Знач Логин, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.УдалениеУчастника(Ответ, Группа.Имя, Логин, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

Функция УдалитьСопоставление(Знач Группа, Знач Номер, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.УдалениеСопоставления(Ответ, Группа.Имя, Номер, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

Функция Политика(Знач Группа, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Политика(Ответ, Группа.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

Функция Экранировать(Знач Ключ)
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст(Ключ));
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Строка таблицы с логином в первой ячейке: от её <tr до следующей.
Функция СтрокаТаблицы(Знач HTML, Знач Логин)
	Для Каждого Строка_ Из Куски(HTML, "<tr") Цикл
		Если СтрНайти(Строка_, ">" + Логин + "<") > 0 Тогда
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Если СтрНайти(Лев(Окно, СтрНайти(Окно, ">")), " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
