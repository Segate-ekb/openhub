// Раздел «Общие» дома «Пул»: свойства пула словами — видимость той же плашкой, что на странице пула,
// сырых кодов нет, ссылка в настройки хаба только администратору, владелец по номеру, команда opm
// с именем пула и узлом хаба; окружение витрины — в памяти.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Окружение;   // ОкружениеОбщихПула
Перем Плашки;      // ПлашкиПула
Перем Витрина;     // ВитринаОбщихПула
Перем ДомХаба_;    // ДомХаба — адрес раздела, где назначают основной пул

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ОкружениеОбщихПула");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	Поиск.Подключить(КаталогРеестра, "АдресаСтраниц");
	Поиск.Подключить(КаталогРеестра, "ЗаполнениеПула");
	КаталогWeb = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("АдресаКаталога,СборкаДомаНастроек,ДомПула,ДомХаба,КомандыOpm,ПлашкиПула,"
		+ "ВитринаОбщихПула", ",") Цикл
		Поиск.Подключить(КаталогWeb, Имя);
	КонецЦикла;

	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	ДомХаба_ = Новый ДомХаба(Сборка, UI.Тексты);
	Окружение = Новый ОкружениеОбщихПула();
	Плашки = Новый ПлашкиПула(Окружение, Неопределено, UI.Тексты, Неопределено);
	Витрина = Новый ВитринаОбщихПула(UI.Кит,
		Новый ДомПула(Сборка, UI.Тексты, Новый АдресаСтраниц(), Новый АдресаКаталога()),
		Окружение, Новый ЗаполнениеПула(), Новый ОбъёмТекстом(),
		Новый КомандыOpm(Окружение, Новый ЗаголовкиHTTP()), Плашки, Окружение, Окружение, Окружение,
		ДомХаба_, Новый АдресаСтраниц(), UI.Тексты);

КонецПроцедуры

// Видимость — той же плашкой, что на странице пула и в списке пулов; сырых кодов на экране нет.
&Тест
Процедура ВидимостьТойЖеПлашкойИСырыхКодовНет() Экспорт

	Для Каждого Видимость Из СтрРазделить("public,private", ",") Цикл
		Пул = Новый ПулЗаглушка(7, "corp", "custom", 0, Истина, Видимость);
		HTML = Общие(Пул, Неопределено);
		Ожидаем.Что(HTML, "плашка видимости " + Видимость + " — подпись страницы пула")
			.Содержит(">" + UI.Экран.Экранировать(Плашки.ПлашкаВидимости(Пул).Текст) + "<");
		Ожидаем.Что(HTML, "сырого кода видимости нет").Не_().Содержит(">" + Видимость + "<");
		Ожидаем.Что(HTML, "сырого типа пула нет").Не_().Содержит("custom");
	КонецЦикла;

КонецПроцедуры

// Основной пул назначают в настройках хаба: ссылку туда печатают тому, кто туда войдёт.
&Тест
Процедура СсылкаВНастройкиХабаТолькоАдминистратору() Экспорт

	Пул = Новый ПулЗаглушка(7, "corp", "custom");
	Ссылка = "href=""" + ДомХаба_.АдресРаздела("pools") + """";
	Подпись = UI.Экран.Экранировать(UI.Тексты.Текст("settings.pool.general.default.link"));

	Ожидаем.Что(Общие(Пул, Новый Структура("Админ", Истина)), "администратору — ссылкой").Содержит(Ссылка);
	НеАдмину = Общие(Пул, Новый Структура("Админ", Ложь));
	Ожидаем.Что(НеАдмину, "не-администратору ссылки нет").Не_().Содержит(Ссылка);
	Ожидаем.Что(НеАдмину, "КОНТРОЛЬ: но где назначают — сказано текстом").Содержит(Подпись);

КонецПроцедуры

&Тест
Процедура ВладелецПоНомеруАБезВладельцаНет() Экспорт

	Окружение.ДобавитьУчётку(42, "owner1");
	Пул = Новый ПулЗаглушка(7, "corp", "custom");

	Пул.ВладелецИдентификатор = 42;
	Ожидаем.Что(Общие(Пул, Неопределено), "владелец назван логином").Содержит("<dd>owner1");

	Пул.ВладелецИдентификатор = 0;
	HTML = Общие(Пул, Неопределено);
	Ожидаем.Что(HTML, "пул без владельца — «нет»")
		.Содержит(UI.Экран.Экранировать(UI.Тексты.Текст("settings.pool.general.owner.none")));
	Ожидаем.Что(HTML, "КОНТРОЛЬ: чужого логина нет").Не_().Содержит("<dd>owner1");

КонецПроцедуры

// Команда opm копируется целиком: узел хаба из заголовка Host и имя пула.
&Тест
Процедура КомандаOpmНесётИмяПулаИУзелХаба() Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "hub.example:3380");
	HTML = Общие(Новый ПулЗаглушка(7, "corp", "custom"), Неопределено, Заголовки);

	Ожидаем.Что(HTML, "команда установки с узлом и пулом").Содержит("opm install hub.example:3380/corp/");

КонецПроцедуры

&Тест
Процедура МестоПолосойОтКвотыАБезКвотыСловами() Экспорт

	Пул = Новый ПулЗаглушка(7, "corp", "custom");

	Окружение.ЗадатьМесто(10 * 1024 * 1024, 100 * 1024 * 1024);
	Ожидаем.Что(Общие(Пул, Неопределено), "с квотой — полоса заполнения").Содержит("role=""progressbar""");

	Окружение.ЗадатьМесто(10 * 1024 * 1024, 0);
	HTML = Общие(Пул, Неопределено);
	Ожидаем.Что(HTML, "без квоты полосы нет").Не_().Содержит("role=""progressbar""");
	Ожидаем.Что(HTML, "и ссылка на «Квоту» на месте").Содержит("href=""/pools/corp/settings/quota""");

КонецПроцедуры

Функция Общие(Знач Пул, Знач Пользователь, Знач Заголовки = Неопределено)
	Возврат Витрина.Секция(Пул, Пользователь, Заголовки).Рендер();
КонецФункции
