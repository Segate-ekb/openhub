// Сохранение раздела дома «Хаб»: автор изменения берётся из сессии, а повторный сабмит без правок
// доменную запись не зовёт. Проверяется на контроллере с поддельной службой настроек, считающей вызовы.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Контроллер;
Перем Гвард;
Перем Настройки;
Перем Витрина;
Перем Ответы;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	КлассыОсновы = ОбъединитьПути(КаталогМодулей, "основа", "Классы");
	КлассыИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	ПоискКлассов.Подключить(КлассыОсновы, "ЗаписьФормы");
	ПоискКлассов.Подключить(КлассыОсновы, "ПараметрыСсылки");
	ПоискКлассов.Подключить(КлассыИнтерфейса, "РазборФормы");
	ПоискКлассов.Подключить(КлассыИнтерфейса, "КонтроллерДомаХаба");
	ПоискКлассов.Подключить(КлассыИнтерфейса, "ПультЗначенийНастроек");
	ПоискКлассов.Подключить(КлассыИнтерфейса, "ГейтФормы");
	ПоискКлассов.Подключить(КлассыИнтерфейса, "ИтогПульта");
	ПоискКлассов.Подключить(КлассыИнтерфейса, "ОтметкаСохранения");

	РеестрФикстур.Подключить("ГвардКабинетаЗаглушка");
	РеестрФикстур.Подключить("ОтветыНастроекЗаглушка");
	РеестрФикстур.Подключить("ТекстСбояЗаглушка");
	РеестрФикстур.Подключить("ДомНастроекЗаглушка");
	РеестрФикстур.Подключить("ВитринаНастроекЗаглушка");
	РеестрФикстур.Подключить("ПультНейтральный");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ОтветЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");

КонецПроцедуры

&ПередКаждым
Процедура СобратьКонтроллер() Экспорт

	Гвард = Новый ГвардКабинетаЗаглушка();
	Ответы = Новый ОтветыНастроекЗаглушка();
	Настройки = Новый НастройкиЗаглушка();
	Витрина = Новый ВитринаНастроекЗаглушка();

	// рендерер, тексты и прочие соседи на пути сохранения не участвуют: страницу
	// контроллер рисует только на отказе, а отказы перехватывает заглушка ответов
	ПультЗначений = Новый ПультЗначенийНастроек(Настройки, Витрина, Новый РазборФормы(),
		Новый ТекстСбояЗаглушка(), Неопределено);

	Контроллер = Новый КонтроллерДомаХаба(Гвард, Ответы, Новый ДомНастроекЗаглушка(), Витрина,
		// ВитринаДомаХаба на пути сохранения не участвует: страницу контроллер рисует
		// только на отказе, а отказы перехватывает заглушка ответов
		Неопределено,
		ПультЗначений,
		Новый ПультНейтральный(), Новый ПультНейтральный(), Новый ПультНейтральный(),
		Новый ПультНейтральный(), Новый ПультНейтральный(),
		Новый ГейтФормы(Ответы, Новый ЗащитаCSRFЗаглушка(), Новый РазборФормы()),
		Новый ИтогПульта(),
		Новый ЗащитаCSRFЗаглушка(),
		Новый РазборФормы(), Неопределено, Неопределено,
		Новый ОтметкаСохранения(Новый ПараметрыСсылки()));

КонецПроцедуры

&Тест
Процедура АвторИзмененияБерётсяИзСессииАНеЛитерала() Экспорт

	// литеральный принципал в контроллере («system», «root») подписал бы чужой правкой
	// журнал аудита: автор обязан приезжать из сессии запроса
	Гвард.Впустить("клара-из-сессии");
	Витрина.ЗавестиКарточку("oshub.ui.theme", "светлая");

	Сохранить("oshub.ui.theme=тёмная");

	Ожидаем.Что(Настройки.Вызовы.Количество(), "домен позван ровно один раз").Равно(1);
	Ожидаем.Что(Настройки.Вызовы[0].Кто, "автор — логин вошедшего, а не литерал").Равно(
		"клара-из-сессии");
	Ожидаем.Что(Настройки.Вызовы[0].Ключ, "правится названная настройка").Равно("oshub.ui.theme");
	Ожидаем.Что(Настройки.Вызовы[0].Значение, "значение из формы").Равно("тёмная");

КонецПроцедуры

&Тест
Процедура ПовторныйСабмитБезПравокДоменНеЗовёт() Экспорт

	// каждое нажатие «Сохранить» писало бы в журнал аудита изменение, которого не было
	Гвард.Впустить("root");
	Витрина.ЗавестиКарточку("oshub.auth.login.lockoutseconds", "600");

	Сохранить("oshub.auth.login.lockoutseconds=600");
	Ожидаем.Что(Настройки.Вызовы.Количество(),
		"значение не изменилось — доменной записи нет").Равно(0);

	// КОНТРОЛЬ: та же форма с другим значением домен зовёт
	Сохранить("oshub.auth.login.lockoutseconds=900");
	Ожидаем.Что(Настройки.Вызовы.Количество(), "изменённое значение записано").Равно(1);
	Ожидаем.Что(Настройки.Вызовы[0].Значение, "записано новое значение").Равно("900");

КонецПроцедуры

&Тест
Процедура МутацияБезПринципалаСессииНеПишетсяВовсе() Экспорт

	// гвард пропустил запрос без пользователя — тихая анонимная строка в журнале хуже отказа
	Гвард.Впустить("");
	Витрина.ЗавестиКарточку("oshub.ui.theme", "светлая");

	Поймано = Ложь;
	Попытка
		Сохранить("oshub.ui.theme=тёмная");
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "принципал") > 0,
			"падение называет причину: мутация без принципала сессии").ЭтоИстина();
	КонецПопытки;

	Ожидаем.Что(Поймано, "мутация без принципала падает громко, а не пишется анонимно").ЭтоИстина();
	Ожидаем.Что(Настройки.Вызовы.Количество(), "домен не позван").Равно(0);

КонецПроцедуры

#Область Служебное

Процедура Сохранить(Знач ТелоФормы)

	Ответ = Новый ОтветЗаглушка();
	Контроллер.Раздел(Ответ, "branding", Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + ТелоФормы, Неопределено);

КонецПроцедуры

#КонецОбласти
