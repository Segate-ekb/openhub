// Адреса раздела «Пулы» дома «Хаб» в настоящем маршрутизаторе winow: литерал «pools» без отката
// перекрывает шаблон «settings/{раздел}» дома, поэтому куда уходит каждый адрес — стережёт таблица
// маршрутов, а не вызов метода контроллера.

#Использовать asserts
#Использовать "../фикстуры"

Перем Маршруты;   // фикстура МаршрутыХаба — таблица маршрутов хаба в маршрутизаторе winow

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("МаршрутыХаба");
КонецПроцедуры

&ПередВсеми
Процедура СобратьМаршруты() Экспорт
	Маршруты = Новый МаршрутыХаба(КаталогиПроекта.Модули());
КонецПроцедуры

&Тест
Процедура ДвериПуловУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик("/hub/settings/pools", "Раздел", "КонтроллерПуловХаба");
	ПроверитьОбработчик("/hub/settings/pools/corp/primary", "Основной", "КонтроллерПуловХаба");
	ПроверитьОбработчик("/hub/settings/pools/corp/delete", "Удаление", "КонтроллерПуловХаба");

КонецПроцедуры

// Пул по имени «new», «settings» или «delete» — обычный ключ записи: литерала на его месте нет.
&Тест
Процедура ИмяПулаНеСпоритСЛитералами() Экспорт

	Для Каждого Имя Из СтрРазделить("new,settings,delete,primary,pools", ",") Цикл
		ПроверитьОбработчик("/hub/settings/pools/" + Имя + "/delete", "Удаление", "КонтроллерПуловХаба");
		ПроверитьОбработчик("/hub/settings/pools/" + Имя + "/primary", "Основной", "КонтроллерПуловХаба");
	КонецЦикла;

КонецПроцедуры

// Литерал раздела не перехватывает соседние разделы дома: они уходят шаблону дома.
&Тест
Процедура СоседниеРазделыДомаНеПерехватываются() Экспорт

	ПроверитьОбработчик("/hub/settings/storage", "Раздел", "КонтроллерДомаХаба");
	ПроверитьОбработчик("/hub/settings/login", "Раздел", "КонтроллерДомаХаба");
	ПроверитьОбработчик("/hub/settings", "Обзор", "КонтроллерДомаХаба");
	ПроверитьОбработчик("/hub/settings/users", "Пользователи", "КонтроллерАдминистрирования");

КонецПроцедуры

Процедура ПроверитьОбработчик(Знач Путь, Знач Метод, Знач Контроллер)

	Обработчик = Маршруты.Обработчик(Путь);
	Ожидаем.Что(Обработчик <> Неопределено, "адрес обслуживается: " + Путь).ЭтоИстина();
	Ожидаем.Что(Обработчик.Контроллер, "контроллер адреса " + Путь).Равно(Контроллер);
	Ожидаем.Что(Обработчик.Метод, "точка маршрута адреса " + Путь).Равно(Метод);

КонецПроцедуры
