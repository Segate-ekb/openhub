// Кэш страниц гостя без живого хаба: кому страница отдаётся из памяти, что в неё не попадает,
// когда она сбрасывается и как устаревшая пересобирается в фоне.

#Использовать asserts
#Использовать logos
#Использовать oscript-ui
#Использовать tempfiles
#Использовать "../фикстуры"

Перем Стенд;  // СтендКэшаСтраниц — окружение и обёрнутый обработчик
Перем Кэш;    // КэшСтраницАнонима

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыКэшаЗаглушка");
	РеестрФикстур.Подключить("СтендКэшаСтраниц");
	Поиск = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Поиск.ПодключитьОснову(Модули);
	Каталог = ОбъединитьПути(ОбъединитьПути(Модули, "интерфейс", "Классы"), "общее", "кэш-страниц");
	Поиск.Подключить(Каталог, "КэшСтраницАнонима");
	Поиск.Подключить(Каталог, "ПересборкаСтраницыГостя");
	Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "АдресИнстанса");
	Поиск.Подключить(ОбъединитьПути(ОбъединитьПути(Модули, "интерфейс", "Классы"), "панели", "пакет"), "КомандыOpm");
	Поиск.Подключить(ОбъединитьПути(Модули, "события", "Классы"), "ИздательСобытий");
	Поиск.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы", "квота"));
	Для Каждого Имя Из СтрРазделить("ФайловоеХранилище,РаскладкаФайловХранилища,"
		+ "ПомощникАртефакта,КоординатыАртефакта,ТипСодержимогоАртефакта", ",") Цикл
		Поиск.Подключить(ОбъединитьПути(Модули, "хранилище", "Классы"), Имя);
	КонецЦикла;
	Поиск.Подключить(ОбъединитьПути(Модули, "описания", "Классы"), "ХранилищеREADME");
	Поиск.Подключить(ОбъединитьПути(Модули, "описания", "Классы"), "КоординатыREADME");

КонецПроцедуры

&ПередКаждым
Процедура СобратьКэш() Экспорт

	Стенд = Новый СтендКэшаСтраниц();
	Стенд.Пользователи.Вставить("сессия-ивана", "ivan");
	Кэш = НовыйКэш(Неопределено);

КонецПроцедуры

Функция НовыйКэш(Знач Издатель)
	ЗаголовкиHTTP = Новый ЗаголовкиHTTP();
	Команды = Новый КомандыOpm(Новый АдресИнстанса(Стенд), ЗаголовкиHTTP, , , Стенд);
	Возврат Новый КэшСтраницАнонима(Стенд, ЗаголовкиHTTP, Новый ЗаголовкиКэша(ЗаголовкиHTTP), Стенд,
		Новый ТокеныТемы(), Команды, Стенд, Стенд, Логирование.ПолучитьЛог("oscript.app.openhub.тесты.кэш-страниц"),
		Стенд, Издатель, Стенд);
КонецФункции

#Область КомуИзКэша

&Тест
Процедура ВтораяСтраницаГостяОтдаётсяИзПамяти() Экспорт

	Первая = Гость("/pools/main");
	Вторая = Гость("/pools/main");

	Ожидаем.Что(Стенд.Сборок, "страница собрана один раз").Равно(1);
	Ожидаем.Что(Стенд.ОпределенийПринципала, "без куки и ключа перехватчик не спрашивается").Равно(0);
	Ожидаем.Что(Вторая.ТелоТекст, "второй гость получил ту же страницу").Равно(Первая.ТелоТекст);
	Ожидаем.Что(Вторая.СостояниеКод, "с кодом 200").Равно(200);
	Ожидаем.Что(Вторая.Заголовки.Получить("Content-Type"), "и типом HTML").Равно("text/html; charset=utf-8");

КонецПроцедуры

&Тест
Процедура ВошедшийНикогдаНеПолучаетСтраницуГостяИНеОставляетСвою() Экспорт

	СтраницаГостя = Гость("/pools/main").ТелоТекст;
	Куки = Новый КукиЗаглушка();
	Куки.Добавить("oshub_session", "сессия-ивана");

	Своя = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main", Куки), Стенд);
	Ещё = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main", Куки), Стенд);

	Ожидаем.Что(Своя.ТелоТекст, "вошедшему собрана своя страница").Не_().Равно(СтраницаГостя);
	Ожидаем.Что(Ещё.ТелоТекст, "и каждый раз заново").Не_().Равно(Своя.ТелоТекст);
	Ожидаем.Что(Гость("/pools/main").ТелоТекст, "гость по-прежнему получает страницу гостя").Равно(СтраницаГостя);

КонецПроцедуры

&Тест
Процедура КукаСессииБезПользователяИКлючДоступаИдутМимоКэша() Экспорт

	Куки = Новый КукиЗаглушка();
	Куки.Добавить("oshub_session", "протухшая");
	Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main", Куки), Стенд);
	Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main", Куки), Стенд);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "Bearer ключ");
	Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main", , Заголовки), Стенд);

	Ожидаем.Что(Стенд.Сборок, "каждый такой запрос собран заново").Равно(3);
	Ожидаем.Что(Стенд.ЗаписейВКэше(), "и ни один не положен").Равно(0);

КонецПроцедуры

&Тест
Процедура РазнаяКукаОформленияДаётРазныеСтраницы() Экспорт

	Светлая = Новый КукиЗаглушка();
	Светлая.Добавить("ui", "тема=светлая");
	Тёмная = Новый КукиЗаглушка();
	Тёмная.Добавить("ui", "тема=тёмная");

	ПерваяСветлая = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", Светлая), Стенд).ТелоТекст;
	ПерваяТёмная = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", Тёмная), Стенд).ТелоТекст;
	БезКуки = Гость("/").ТелоТекст;

	Ожидаем.Что(ПерваяТёмная, "тёмная тема — своя страница").Не_().Равно(ПерваяСветлая);
	Ожидаем.Что(БезКуки, "гость без куки — своя").Не_().Равно(ПерваяСветлая);
	Ожидаем.Что(Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", Светлая), Стенд).ТелоТекст,
		"светлая повторно — из кэша").Равно(ПерваяСветлая);
	Ожидаем.Что(Стенд.Сборок, "три оформления — три сборки").Равно(3);

КонецПроцедуры

// Ключ — оформление так, как его прочтёт страница: мусор в куке не множит записи.
&Тест
Процедура МусорнаяКукаОформленияДаётТотЖеКлюч() Экспорт

	Тёмная = Новый КукиЗаглушка();
	Тёмная.Добавить("ui", "тема=тёмная");
	Мусорная = Новый КукиЗаглушка();
	Мусорная.Добавить("ui", "тема=мусор&плотность=9&радиус=abc&лишнее=1");
	Светлая = Новый КукиЗаглушка();
	Светлая.Добавить("ui", "тема=light");

	Своя = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", Тёмная), Стенд).ТелоТекст;
	Ожидаем.Что(Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", Мусорная), Стенд).ТелоТекст,
		"мусорная тема читается тёмной, множители вне диапазона — единицей").Равно(Своя);
	Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", Светлая), Стенд);
	Ожидаем.Что(Стенд.Сборок, "КОНТРОЛЬ: светлая — своя запись").Равно(2);

	НеизвестныйПресет = Новый КукиЗаглушка();
	НеизвестныйПресет.Добавить("ui", "тема=тёмная&пресет=нет");
	ПоУмолчанию = Новый КукиЗаглушка();
	ПоУмолчанию.Добавить("ui", "тема=тёмная&пресет=material");
	СПресетом = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", НеизвестныйПресет), Стенд).ТелоТекст;
	Ожидаем.Что(Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/", ПоУмолчанию), Стенд).ТелоТекст,
		"неизвестный пресет читается пресетом по умолчанию").Равно(СПресетом);

КонецПроцедуры

&Тест
Процедура ДругойУзелДаётДругуюСтраницу() Экспорт

	Своя = СУзлом("/", "hub.example.org").ТелоТекст;

	Ожидаем.Что(Гость("/").ТелоТекст, "команды opm называют узел из Host").Не_().Равно(Своя);
	Ожидаем.Что(СУзлом("/", "HUB.example.org/мусор").ТелоТекст, "Host очищен, как в командах opm: тот же ключ")
		.Равно(Своя);

КонецПроцедуры

// С заданным адресом инсталляции команды opm берут узел из него: подбор Host не множит записи.
&Тест
Процедура ПриЗаданномАдресеХабаУзелИзHostНеВходитВКлюч() Экспорт

	Стенд.АдресХаба = "https://hub.example.org";
	Первая = СУзлом("/", "a.example.org");
	СУзлом("/", "b.example.org");
	СУзлом("/", "c.example.org:8080");
	Гость("/");

	Ожидаем.Что(Стенд.Сборок, "четыре разных Host — одна сборка").Равно(1);
	Ожидаем.Что(Стенд.ЗаписейВКэше(), "и одна запись").Равно(1);
	Ожидаем.Что(Стенд.Запросы[0].Заголовки.Получить("Host"), "КОНТРОЛЬ: Host дошёл до обработчика")
		.Равно("a.example.org");
	Ожидаем.Что(Первая.СостояниеКод, "страница отдана").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область ЧтоНеКладётся

&Тест
Процедура ОтказНеКэшируется() Экспорт

	Для Каждого Код Из СтрРазделить("404,500,302", ",") Цикл
		Стенд.Код = Число(Код);
		Гость("/pools/main/packages/нет");
		Гость("/pools/main/packages/нет");
	КонецЦикла;

	Ожидаем.Что(Стенд.Сборок, "каждый отказ собран заново").Равно(6);
	Ожидаем.Что(Стенд.ЗаписейВКэше(), "в кэше ни одного").Равно(0);

КонецПроцедуры

&Тест
Процедура НеHTMLИОтветСоСвоейКукойНеКэшируются() Экспорт

	Стенд.ТипКонтента = "application/json";
	Гость("/pools/main");
	Стенд.ТипКонтента = "text/html; charset=utf-8";
	Стенд.КукаОтвета = "oshub_csrf";
	Гость("/pools/main");
	Стенд.КукаОтвета = "";
	Стенд.Шаблон = "/me";
	Гость("/me");

	Ожидаем.Что(Стенд.ЗаписейВКэше(), "JSON, ответ с кукой и страница кабинета не положены").Равно(0);

	Стенд.Шаблон = "/packages/";
	Гость("/packages");
	Ожидаем.Что(Стенд.ЗаписейВКэше(), "КОНТРОЛЬ: каталог кладётся, хвостовая косая шаблона не мешает").Равно(1);

КонецПроцедуры

// Перебор «?x=1..N» не множит записи: страница с незнакомым параметром собирается и не кладётся.
&Тест
Процедура НезнакомыйПараметрНеКладётся() Экспорт

	Гость("/pools/main?x=1");
	Гость("/pools/main?x=1");
	Гость("/pools/main?окно=участники&utm=письмо");
	Ожидаем.Что(Стенд.Сборок, "каждая собрана заново").Равно(3);
	Ожидаем.Что(Стенд.ЗаписейВКэше(), "и ни одна не положена").Равно(0);

	Гость("/pools/main?окно=участники");
	Гость("/pools/main?окно=участники");
	Ожидаем.Что(Стенд.Сборок, "КОНТРОЛЬ: параметр, который страница читает, кладётся").Равно(4);

КонецПроцедуры

&Тест
Процедура ПорядокПараметровНеМножитЗаписи() Экспорт

	Стенд.Шаблон = "/packages";
	Первая = Гость("/packages?q=winow&page=2").ТелоТекст;

	Ожидаем.Что(Гость("/packages?page=2&q=winow").ТелоТекст, "тот же отбор в другом порядке").Равно(Первая);
	Ожидаем.Что(Гость("/packages?q=winow&page=3").ТелоТекст, "КОНТРОЛЬ: другая страница отбора — своя")
		.Не_().Равно(Первая);

КонецПроцедуры

// API и скачивание гостя не платят за кэш: ни выключателя, ни ключа, ни записи.
&Тест
Процедура ЗапросГостяКAPIИдётМимоКэшаБезЧтенияНастроек() Экспорт

	Стенд.Шаблон = "/api/v1/pools/{pool}/packages/{name}";
	Гость("/api/v1/pools/main/packages/winow");
	Гость("/api/v1/pools/main/download/list.txt");
	Ожидаем.Что(Стенд.ЧтенийВыключателя, "выключатель не читался").Равно(0);
	Ожидаем.Что(Стенд.ЗаписейВКэше(), "в кэше ни одной записи").Равно(0);

	Стенд.Шаблон = "/pools/{pool}";
	Гость("/pools/main");
	Ожидаем.Что(Стенд.ЧтенийВыключателя, "КОНТРОЛЬ: страница каталога выключатель читает").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Сброс

&Тест
Процедура ИзменениеВошедшегоСбрасываетАОтказанноеНет() Экспорт

	Гость("/pools/main");
	Куки = Новый КукиЗаглушка();
	Куки.Добавить("oshub_session", "сессия-ивана");
	Стенд.Шаблон = "/pools/{pool}/settings";
	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/pools/main/settings", Куки), Стенд);
	Стенд.Шаблон = "/pools/{pool}";
	Гость("/pools/main");
	Ожидаем.Что(Стенд.Сборок, "изменение вошедшего сбросило страницу").Равно(3);

	Стенд.Шаблон = "/pools/{pool}/settings";
	Стенд.Код = 403;
	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/pools/main/settings", Куки), Стенд);
	Стенд.Код = 200;
	Стенд.Шаблон = "/pools/{pool}";
	Гость("/pools/main");
	Ожидаем.Что(Стенд.Сборок, "отказанное изменение не сбрасывает").Равно(4);

КонецПроцедуры

// Запрос гостя не на чтение кэш не трогает: winow ищет маршрут только по пути, и POST на страницу
// каталога или смена темы отвечают без отказа. Иначе любой гость держал бы кэш пустым.
&Тест
Процедура POSTГостяНаСтраницуИСменаТемыНеСбрасывают() Экспорт

	Стенд.Шаблон = "/pools";
	Гость("/pools");

	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/pools"), Стенд);
	Стенд.Шаблон = "/";
	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/"), Стенд);
	Стенд.Шаблон = "/ui/theme";
	Стенд.Код = 303;
	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/ui/theme"), Стенд);
	Поддельная = Новый КукиЗаглушка();
	Поддельная.Добавить("oshub_session", "x");
	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/ui/theme", Поддельная), Стенд);
	Стенд.Код = 200;
	Стенд.Шаблон = "/pools";
	Сборок = Стенд.Сборок;
	Гость("/pools");

	Ожидаем.Что(Стенд.Сборок, "список пулов отдан из памяти").Равно(Сборок);

КонецПроцедуры

// Регистрация — изменение от гостя: учётка заводит личный пул, который виден в списке пулов,
// а события у этого нет, и куки сессии при подтверждении адреса тоже нет.
&Тест
Процедура РегистрацияГостяСбрасывает() Экспорт

	Для Каждого Шаблон Из СтрРазделить("/api/v1/users,/api/v1/register,/register", ",") Цикл
		Стенд.Шаблон = "/pools";
		Гость("/pools");
		Сборок = Стенд.Сборок;
		Стенд.Шаблон = Шаблон;
		Стенд.Код = 201;
		Кэш.СформироватьОтвет(Стенд.Запрос("POST", Шаблон), Стенд);
		Стенд.Код = 200;
		Стенд.Шаблон = "/pools";
		Гость("/pools");
		Ожидаем.Что(Стенд.Сборок, Шаблон + " сбросил список пулов").Равно(Сборок + 2);
	КонецЦикла;

	Сборок = Стенд.Сборок;
	Стенд.Шаблон = "/api/v1/users";
	Стенд.Код = 422;
	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/api/v1/users"), Стенд);
	Стенд.Код = 200;
	Стенд.Шаблон = "/pools";
	Гость("/pools");
	Ожидаем.Что(Стенд.Сборок, "отказанная регистрация не сбрасывает").Равно(Сборок + 1);

КонецПроцедуры

// Возврат OIDC — GET, но заводит учётку и выдаёт куку сессии.
&Тест
Процедура ОтветСКукойСессииСбрасываетИНаЧтении() Экспорт

	Гость("/pools");
	Стенд.Код = 302;
	Стенд.КукаОтвета = "oshub_session";
	Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/oidc/callback?code=1"), Стенд);
	Стенд.КукаОтвета = "";
	Стенд.Код = 200;
	Гость("/pools");

	Ожидаем.Что(Стенд.Сборок, "вход через провайдера сбросил страницу").Равно(3);

КонецПроцедуры

// Выход гасит куку сессии пустым значением и гостю отвечает так же, как вошедшему: иначе любой гость
// держал бы кэш пустым, повторяя POST /logout.
&Тест
Процедура ГасящаяКукаСессииНеСбрасывает() Экспорт

	Гость("/pools");
	Стенд.КукаОтвета = "oshub_session";
	Стенд.ЗначениеКукиОтвета = "";
	Для Каждого Шаблон Из СтрРазделить("/logout,/api/v1/logout", ",") Цикл
		Стенд.Шаблон = Шаблон;
		Стенд.Код = ?(Шаблон = "/logout", 302, 200);
		Кэш.СформироватьОтвет(Стенд.Запрос("POST", Шаблон), Стенд);
	КонецЦикла;
	Стенд.КукаОтвета = "";
	Стенд.Код = 200;
	Стенд.Шаблон = "/pools/{pool}";
	Сборок = Стенд.Сборок;
	Гость("/pools");

	Ожидаем.Что(Стенд.Сборок, "выход гостя не сбросил страницу").Равно(Сборок);

КонецПроцедуры

// Запрос вошедшего не на чтение к странице каталога ничего не меняет: иначе любая учётка держала бы
// кэш пустой, повторяя POST на главную.
&Тест
Процедура POSTВошедшегоНаСтраницуКаталогаНеСбрасывает() Экспорт

	Гость("/pools/main");
	Куки = Новый КукиЗаглушка();
	Куки.Добавить("oshub_session", "сессия-ивана");
	Для Каждого Шаблон Из СтрРазделить("/,/pools,/pools/{pool}", ",") Цикл
		Стенд.Шаблон = Шаблон;
		Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/pools/main", Куки), Стенд);
	КонецЦикла;
	Стенд.Шаблон = "/pools/{pool}";
	Сборок = Стенд.Сборок;
	Гость("/pools/main");

	Ожидаем.Что(Стенд.Сборок, "страница пула отдана из памяти").Равно(Сборок);

КонецПроцедуры

#КонецОбласти

#Область Выключатель

&Тест
Процедура ВыключенныйКэшСобираетКаждуюСтраницуИНеКладёт() Экспорт

	Гость("/pools/main");
	Стенд.Включён = Ложь;
	Гость("/pools/main");
	Гость("/pools/main");
	Ожидаем.Что(Стенд.Сборок, "выключение действует со следующего запроса").Равно(3);

	Стенд.Включён = Истина;
	Гость("/pools/main");
	Ожидаем.Что(Стенд.Сборок, "КОНТРОЛЬ: включённый снова отдаёт из памяти").Равно(3);

КонецПроцедуры

&Тест
Процедура ВыключенныйКэшВсёРавноСбрасываетсяИзменением() Экспорт

	Гость("/pools/main");
	Стенд.Включён = Ложь;
	Стенд.Шаблон = "/api/v1/users";
	Кэш.СформироватьОтвет(Стенд.Запрос("POST", "/api/v1/users"), Стенд);
	Стенд.Шаблон = "/pools/{pool}";
	Стенд.Включён = Истина;
	Гость("/pools/main");

	Ожидаем.Что(Стенд.Сборок, "изменение при выключенном кэше не оставило прежней страницы").Равно(3);

КонецПроцедуры

&Тест
Процедура СобытиеСбрасываетСтраницы() Экспорт

	Гость("/pools/main");
	Кэш.ОбработатьСобытие(Новый Структура("Тип, Когда, Данные", "версия.опубликована", ТекущаяДата(), Новый Структура()));
	Свежая = Гость("/pools/main");

	Ожидаем.Что(Стенд.Сборок, "после события страница собрана заново").Равно(2);
	Ожидаем.Что(Свежая.ТелоТекст, "гость видит новую").Содержит("#2");

КонецПроцедуры

// README из репозитория пишет фон без запроса к хабу: гость, открывший страницу до него, иначе видит «нет README».
&Тест
Процедура READMEИзРепозиторияСбрасываетСтраницы() Экспорт

	Издатель = Новый ИздательСобытий();
	Кэш = НовыйКэш(Издатель);
	Описания = Новый ХранилищеREADME(Новый ФайловоеХранилище(ВременныеФайлы.СоздатьКаталог()),
		Логирование.ПолучитьЛог("oscript.app.openhub.тесты.кэш-страниц"), , , Издатель);
	Описания.Записать("main", "lib", "1.0.0", "");
	Стенд.Шаблон = "/pools/{pool}/packages/{name}";
	Гость("/pools/main/packages/lib");

	Справка = Новый Структура("Репозиторий, Спрошено, Найдено, Вид, Реф, Ссылка, Текст",
		"https://github.com/acme/lib", ТекущаяУниверсальнаяДата(), Истина, "tag", "v1.0.0",
		"https://github.com/acme/lib/blob/v1.0.0/README.md", "# Из репозитория");
	Описания.ЗаписатьСправку("main", "lib", "1.0.0", Справка);
	Свежая = Гость("/pools/main/packages/lib");

	Ожидаем.Что(Стенд.Сборок, "после README из репозитория страница собрана заново").Равно(2);
	Ожидаем.Что(Свежая.ТелоТекст, "гость видит новую").Содержит("#2");

КонецПроцедуры

#КонецОбласти

#Область Устаревшая

&Тест
Процедура УстаревшаяОтдаётсяСразуИПересобираетсяВФонеОдинРаз() Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("X-Forwarded-For", "203.0.113.7");
	Куки = Новый КукиЗаглушка();
	Куки.Добавить("метка", "посетителя");
	Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main?окно=участники", Куки, Заголовки), Стенд);
	Стенд.Состарить(45000);

	Первый = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main?окно=участники", Куки, Заголовки), Стенд);
	Второй = Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main?окно=участники", Куки, Заголовки), Стенд);

	Ожидаем.Что(Первый.ТелоТекст, "устаревшая отдана сразу").Содержит("#1");
	Ожидаем.Что(Второй.ТелоТекст, "и второму тоже").Содержит("#1");
	Ожидаем.Что(Стенд.ВыполнитьФон(), "пересборка запущена одна на ключ").Равно(1);
	Ожидаем.Что(Стенд.Сборок, "и собрала страницу").Равно(2);

	Фоновый = Стенд.Запросы[1];
	Ожидаем.Что(Фоновый.ПолныйПуть, "фон собирает тот же адрес").Равно("/pools/main?окно=участники");
	Ожидаем.Что(Фоновый.Заголовки.Получить("X-Forwarded-For"), "без заголовков посетителя").Равно(Неопределено);
	Ожидаем.Что(Фоновый.Куки.ПолучитьЗначениеПоИмени("метка"), "и без его кук").Равно(Неопределено);

	Ожидаем.Что(Кэш.СформироватьОтвет(Стенд.Запрос("GET", "/pools/main?окно=участники", Куки, Заголовки), Стенд).ТелоТекст,
		"следующий гость получает новую").Содержит("#2");
	Ожидаем.Что(Стенд.ВыполнитьФон(), "свежая пересборки не просит").Равно(0);

КонецПроцедуры

// Браузер и прокси вычитают Age из max-age: страница из памяти хаба не живёт у них сверх своего срока.
&Тест
Процедура ВозрастЗаписиУходитВЗаголовкеAge() Экспорт

	Гость("/pools/main");
	Ожидаем.Что(Гость("/pools/main").Заголовки.Получить("Age"), "свежая запись").Равно("0");
	Стенд.Состарить(45000);
	Ожидаем.Что(Гость("/pools/main").Заголовки.Получить("Age"), "запись возрастом 45 с").Равно("45");

КонецПроцедуры

// Всплеск устаревших адресов не становится всплеском потоков: сверх предела устаревшая отдаётся
// без пересборки, а старше 60 с соберётся в запросе.
&Тест
Процедура ПятаяПересборкаРазомНеЗапускается() Экспорт

	Пулы = СтрРазделить("a,b,c,d,e", ",");
	Для Каждого Пул Из Пулы Цикл
		Гость("/pools/" + Пул);
	КонецЦикла;
	Стенд.Состарить(45000);
	Для Каждого Пул Из Пулы Цикл
		Ожидаем.Что(Гость("/pools/" + Пул).ТелоТекст, "устаревшая отдана сразу").Не_().Содержит("#6");
	КонецЦикла;

	Ожидаем.Что(Стенд.ВыполнитьФон(), "в фон ушли четыре пересборки").Равно(4);
	Гость("/pools/e");
	Ожидаем.Что(Стенд.ВыполнитьФон(), "КОНТРОЛЬ: освободившееся место берёт пятая").Равно(1);

КонецПроцедуры

// Фоновая сборка спрашивает хаб как гость без куки; winow на каждый такой запрос заводил бы сессию навсегда.
&Тест
Процедура ФоновыеПересборкиЖивутВОднойСессииWinow() Экспорт

	Гость("/pools/a");
	Гость("/pools/b");
	Стенд.Состарить(45000);
	Гость("/pools/a");
	Гость("/pools/b");
	Стенд.ВыполнитьФон();

	Ожидаем.Что(Стенд.Сборок, "КОНТРОЛЬ: обе страницы пересобраны").Равно(4);
	Ожидаем.Что(Стенд.ВыданоСессийWinow, "одна сессия на все пересборки").Равно(1);

КонецПроцедуры

&Тест
Процедура СтаршеПределаНеОтдаётся() Экспорт

	Гость("/pools/main");
	Стенд.Состарить(61000);

	Ожидаем.Что(Гость("/pools/main").ТелоТекст, "минуту спустя гость получает собранную при нём").Содержит("#2");
	Ожидаем.Что(Стенд.ВыполнитьФон(), "без фоновой пересборки").Равно(0);

КонецПроцедуры

&Тест
Процедура СбросВоВремяФоновойСборкиНеКладётПрежнее() Экспорт

	Гость("/pools/main");
	Стенд.Состарить(45000);
	Гость("/pools/main");
	Кэш.Сбросить();
	ПослеСброса = Гость("/pools/main").ТелоТекст;
	Стенд.ВыполнитьФон();

	Ожидаем.Что(Стенд.Сборок, "фоновая сборка состоялась").Равно(3);
	Ожидаем.Что(Гость("/pools/main").ТелоТекст, "но начатая до сброса не легла поверх собранной после")
		.Равно(ПослеСброса);

КонецПроцедуры

#КонецОбласти

Функция СУзлом(Знач ПолныйПуть, Знач Узел)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", Узел);
	Возврат Кэш.СформироватьОтвет(Стенд.Запрос("GET", ПолныйПуть, , Заголовки), Стенд);
КонецФункции

Функция Гость(Знач ПолныйПуть)
	Возврат Кэш.СформироватьОтвет(Стенд.Запрос("GET", ПолныйПуть), Стенд);
КонецФункции
