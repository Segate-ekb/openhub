// Первая полоса главной: строка поиска в каталог без карточки и заголовка, лид под ней; имени
// хаба и второй дороги в каталог на странице нет — они в шапке. Состав главной: обзор пулов,
// свежее, популярное и быстрый старт; пустой хаб ведёт гостя на вход, вошедшего — к первым шагам.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // Структура компонентов (фикстура СборкаUI)
Перем Команды;     // КомандыOpm

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьГлавную() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогКлассов = ОбъединитьПути(Модули, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗамерОкруженияЛендинга");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ЗамерХранилищаПровенанса");
	РеестрФикстур.Подключить("ФейкОкруженияВитрины");

	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "АдресИнстанса");
	Поиск.Подключить(КаталогКлассов, "КомандыOpm");
	Поиск.Подключить(КаталогКлассов, "КонтроллерЛендинга");
	Поиск.Подключить(КаталогКлассов, "ВитринаПакетов");
	Поиск.Подключить(КаталогКлассов, "ПлашкиПула");
	КаталогРеестра = ОбъединитьПути(Модули, "реестр", "Классы");
	Для Каждого Имя Из СтрРазделить("СервисПроисхождения,СнимокПровенанса,АдресаСтраниц", ",") Цикл
		Поиск.Подключить(КаталогРеестра, Имя);
	КонецЦикла;

	UI = Новый СборкаUI().Собрать(КаталогКлассов);

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.instance.url", "");
	Настройки.Задать("oshub.instance.opm_default_hub", Ложь);
	Команды = Новый КомандыOpm(Новый АдресИнстанса(Настройки), Новый ЗаголовкиHTTP(),
		Неопределено, Неопределено, Настройки);


КонецПроцедуры

// Поиск с главной — та же GET-форма каталога: адрес /packages, параметр q. Отправляет её значок
// поиска в самой строке, как у поисковиков (замечание владельца к превью 2: кнопка «Найти»
// уезжала на соседнюю строку): отдельной кнопки с текстом нет, значок назван словарём.
// Работает без скрипта, и её адрес можно отправить ссылкой.
&Тест
Процедура ПоискСГлавнойВедётВКаталог() Экспорт

	Форма = ПерваяФорма(Главная());

	Ожидаем.Что(Форма, "форма отбора уходит GET").Содержит("method=""get""");
	Ожидаем.Что(Форма, "в каталог").Содержит("action=""/packages""");
	Ожидаем.Что(Форма, "тем же параметром, что читает каталог").Содержит("name=""q""");

	Кнопки = Куски(Форма, "<button");
	Ожидаем.Что(Кнопки.Количество(), "в строке одна кнопка — значок отправки").Равно(1);
	Значок = Лев(Кнопки[0], СтрНайти(Кнопки[0], "</button>"));
	Ожидаем.Что(Значок, "она отправляет форму").Содержит("type=""submit""");
	Ожидаем.Что(Значок, "названа словарём").Содержит("aria-label=""" + UI.Тексты.Текст("search.submit") + """");
	Ожидаем.Что(СтрНайти(Значок, ">" + UI.Тексты.Текст("search.submit") + "<"), "текста «Найти» на ней нет")
		.Равно(0);
	Ожидаем.Что(Форма, "и она внутри строки поиска").Содержит("search-bar");

КонецПроцедуры

// Строка поиска — первое на странице: над ней нет ни карточки, ни заголовка с именем хаба.
// Имя хаба печатает шапка; на самой странице его нет нигде.
&Тест
Процедура ПервоеНаСтраницеСтрокаПоискаБезИмениХаба() Экспорт

	Содержимое = Главная();

	ДоПоиска = Лев(Содержимое, СтрНайти(Содержимое, "<form") - 1);

	Ожидаем.Что(СтрНайти(Содержимое, "<form"), "КОНТРОЛЬ: форма есть").Больше(0);
	Ожидаем.Что(СтрНайти(ДоПоиска, "card"), "строка поиска не в карточке").Равно(0);
	Ожидаем.Что(СтрНайти(ДоПоиска, "<h"), "и над ней нет заголовка").Равно(0);
	Ожидаем.Что(СтрНайти(ДоПоиска, "<p"), "и абзаца").Равно(0);
	Ожидаем.Что(СтрНайти(Содержимое, UI.Бренд.Знак()), "имени хаба на странице нет").Равно(0);
	Ожидаем.Что(СтрНайти(Содержимое, "<h1"), "и заголовка первого уровня тоже").Равно(0);

КонецПроцедуры

// У поля поиска нет видимой подписи, и имя для скринридера ему даёт подсказка в самом поле:
// у ввода нет ни метки, ни aria-label, ни title, значит доступное имя — его placeholder. Пока
// у кита нет подписи только для скринридера, это единственное имя поля, и оно обязано быть.
&Тест
Процедура ПолеПоискаНазваноПодсказкой() Экспорт

	Ввод = ТегВвода(ПерваяФорма(Главная()), "q");

	Ожидаем.Что(Ввод, "подсказка называет поле")
		.Содержит("placeholder=""" + UI.Тексты.Текст("public.landing.search.placeholder") + """");
	Ожидаем.Что(СтрНайти(Ввод, "aria-label") + СтрНайти(Ввод, "aria-labelledby") + СтрНайти(Ввод, "title="),
		"КОНТРОЛЬ: других источников имени у ввода нет — имя даёт подсказка").Равно(0);
	Ожидаем.Что(СтрНайти(ПерваяФорма(Главная()), "field__label"), "видимой подписи нет").Равно(0);

КонецПроцедуры

// Лид — одной приглушённой строкой сразу под поиском: что тут есть, без второй карточки.
&Тест
Процедура ЛидСтоитПодСтрокойПоиска() Экспорт

	Содержимое = Главная();
	Лид = UI.Тексты.Текст("public.landing.lead");
	Хвост = Сред(Содержимое, СтрНайти(Содержимое, "</form>") + СтрДлина("</form>"));

	Ожидаем.Что(СтрНачинаетсяС(Хвост, "<p class=""muted"">" + Лид + "</p>"),
		"сразу за формой — приглушённый лид: " + Лев(Хвост, 200)).ЭтоИстина();

КонецПроцедуры

// Вторая дорога в каталог снята: «Каталог» есть в шапке, а поиск ведёт туда же.
&Тест
Процедура КнопкиОткрытьКаталогНаГлавнойНет() Экспорт

	Содержимое = Главная();

	Ожидаем.Что(СтрНайти(Содержимое, "href=""/packages"""), "ссылки на каталог на странице нет").Равно(0);

КонецПроцедуры


// Состав главной хаба с пакетами: обзор пулов, свежее, популярное и быстрый старт — в этом порядке,
// каждый блок со своими записями. Узлы кита печатают то же, что печатали компоненты прежним входом.
&Тест
Процедура ГлавнаяСобранаИзЧетырёхБлоковПоПорядку() Экспорт

	Содержимое = ГлавнаяВ(ХабСПакетами());

	Порядок = Новый Массив();
	Для Каждого Ключ Из СтрРазделить("public.landing.pools.title,public.landing.fresh.title,"
		+ "public.landing.popular.title,public.landing.start.title", ",") Цикл
		Позиция = СтрНайти(Содержимое, ">" + UI.Тексты.Текст(Ключ) + "</h2>");
		Ожидаем.Что(Позиция, "на главной есть блок «" + UI.Тексты.Текст(Ключ) + "»").Больше(0);
		Порядок.Добавить(Позиция);
	КонецЦикла;
	Для Номер = 1 По Порядок.ВГраница() Цикл
		Ожидаем.Что(Порядок[Номер], "блоки идут по порядку: пулы, свежее, популярное, старт")
			.Больше(Порядок[Номер - 1]);
	КонецЦикла;

	Для Номер = 1 По 3 Цикл
		Ожидаем.Что(Содержимое, "пул pool" + Номер + " в обзоре").Содержит(">pool" + Номер + "<");
	КонецЦикла;
	Свежее = Сред(Содержимое, Порядок[1], Порядок[2] - Порядок[1]);
	Популярное = Сред(Содержимое, Порядок[2], Порядок[3] - Порядок[2]);
	Для Номер = 1 По 8 Цикл
		Имя = ">winow-" + Номер + "<";
		Ожидаем.Что(Свежее, "пакет winow-" + Номер + " в свежем").Содержит(Имя);
		Ожидаем.Что(Популярное, "пакет winow-" + Номер + " в популярном").Содержит(Имя);
	КонецЦикла;
	Ожидаем.Что(Популярное, "у популярного число скачиваний").Содержит(UI.Тексты.Текст("public.landing.popular.downloads"));

КонецПроцедуры

// Обзор пулов упирается в предел витрины — главная говорит об этом прямо; все пулы на месте —
// оговорки нет.
&Тест
Процедура ОбзорПуловГоворитЧтоПоказаныНеВсе() Экспорт

	ПредельныйОбзор = ХабСПакетами();
	ПредельныйОбзор.ЗадатьПуловКоманд(5);
	Ожидаем.Что(ГлавнаяВ(ПредельныйОбзор), "три пула из пяти — оговорка под обзором")
		.Содержит(UI.Тексты.Шаблон("public.landing.pools.more", "3", "5"));

	Ожидаем.Что(ГлавнаяВ(ХабСПакетами()), "показаны все пулы — оговорки нет")
		.Не_().Содержит(UI.Тексты.Шаблон("public.landing.pools.more", "3", "3"));

КонецПроцедуры

// Пустой хаб не показывает пустых лент: пустое состояние ведёт гостя на вход, а вошедшего — к первым
// шагам публикации; лент и обзора пулов нет.
&Тест
Процедура ПустойХабВедётГостяНаВходАВошедшегоКПервымШагам() Экспорт

	Гостю = ГлавнаяВ(Новый ЗамерОкруженияЛендинга());
	Ожидаем.Что(Гостю, "заголовок пустого хаба").Содержит(UI.Тексты.Текст("public.landing.empty.title"));
	Ожидаем.Что(Гостю, "гостя — на вход").Содержит("href=""/login""");
	Ожидаем.Что(Гостю, "лент на пустом хабе нет").Не_().Содержит(UI.Тексты.Текст("public.landing.fresh.title"));

	Вошедший = Новый ЗамерОкруженияЛендинга();
	Вошедший.Войти(Новый Структура("Логин", "alice"));
	Вошедшему = ГлавнаяВ(Вошедший);
	Ожидаем.Что(Вошедшему, "вошедшего — к первым шагам")
		.Содержит("href=""" + UI.АдресаКабинета.Проводник() + """");
	Ожидаем.Что(Вошедшему, "вход вошедшему не предлагается").Не_().Содержит("href=""/login""");

КонецПроцедуры

// Быстрый старт с основным пулом печатает команду установки; без него — объяснение, а не localhost.
&Тест
Процедура БыстрыйСтартБезОсновногоПулаОбъясняет() Экспорт

	БезПула = ГлавнаяВ(ХабСПакетами());
	Ожидаем.Что(БезПула, "без основного пула — объяснение")
		.Содержит(UI.Тексты.Текст("public.landing.start.unknown"));

	СПулом = ХабСПакетами();
	СПулом.НазначитьОсновнойПул(Новый ПулЗаглушка(1, "main", "default"));
	Старт = ГлавнаяВ(СПулом);
	Ожидаем.Что(Старт, "с основным пулом — образец установки").Содержит("opm install");
	Ожидаем.Что(Старт, "объяснения нет").Не_().Содержит(UI.Тексты.Текст("public.landing.start.unknown"));

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Хаб с тремя пулами и восемью пакетами в свежем и популярном.
Функция ХабСПакетами()

	Результат = Новый ЗамерОкруженияЛендинга();
	Пул = Новый ПулЗаглушка(1, "main", "custom");
	Для Номер = 1 По 8 Цикл
		Имя = "winow-" + Номер;
		Пакет = Новый Структура("Идентификатор, ПулИдентификатор, Имя, ИмяНижнийРегистр,"
			+ " Описание, Устарел, Скрыт, ПоследняяПубликация",
			Номер, 1, Имя, Имя, "", Ложь, Ложь, '20260101120000');
		Результат.ДобавитьНовинку(Пакет, Пул, "1.0.0");
		Результат.ДобавитьПопулярный(Пакет, Пул, Номер * 10);
	КонецЦикла;
	Для Номер = 1 По 3 Цикл
		Результат.ДобавитьПул(Новый ПулЗаглушка(Номер, "pool" + Номер, "custom"), Номер);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Главная без обрамления настоящим контроллером над окружением хаба с витриной карточек:
// каркас окружения отдаёт тело как есть.
Функция ГлавнаяВ(Знач Хаб)

	Витрина = Новый ВитринаПакетов(Новый СервисПроисхождения(Новый ЗамерХранилищаПровенанса()), Неопределено,
		UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Новый ФейкОкруженияВитрины());
	Плашки = Новый ПлашкиПула(Неопределено, Неопределено, UI.Тексты, UI.ЗначкиМеты);

	Экран = Новый КонтроллерЛендинга(Хаб, Витрина, UI.КарточкаОбъекта, Плашки,
		UI.Кит, Хаб, UI.Тексты, UI.Бренд, Хаб, Хаб,
		Команды, Хаб, UI.АдресаКабинета, Новый АдресаСтраниц(), UI.АдресаКаталога, UI.Даты);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "localhost:3380");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Показать(Ответ, Заголовки, Неопределено);
	Возврат Ответ.ТелоТекст;

КонецФункции

// Главная пустого хаба гостю — первой полосе остальное безразлично.
Функция Главная()
	Возврат ГлавнаяВ(Новый ЗамерОкруженияЛендинга());
КонецФункции

// Тег ввода с данным именем.
Функция ТегВвода(Знач Разметка, Знач Имя)

	Позиция = СтрНайти(Разметка, "name=""" + Имя + """");
	Ожидаем.Что(Позиция, "в форме есть поле " + Имя).Больше(0);
	Начало = СтрНайти(Разметка, "<input", НаправлениеПоиска.СКонца, Позиция);
	Конец = СтрНайти(Разметка, ">", НаправлениеПоиска.СНачала, Позиция);
	Возврат Сред(Разметка, Начало, Конец - Начало + 1);

КонецФункции

// Куски разметки, каждый — от начала образца до следующего такого же.
Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПерваяФорма(Знач Содержимое)

	Начало = СтрНайти(Содержимое, "<form");
	Ожидаем.Что(Начало, "на главной есть форма").Больше(0);
	Возврат Сред(Содержимое, Начало, СтрНайти(Содержимое, "</form>") + СтрДлина("</form>") - Начало);

КонецФункции

#КонецОбласти
