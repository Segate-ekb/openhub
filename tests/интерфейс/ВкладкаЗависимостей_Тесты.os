// Вкладка «Зависимости» страницы пакета без базы: «Зависит от» называет пакет своего пула ссылкой, чужое имя
// — экранированным текстом, зависимость для разработки — плашкой; «Кто зависит» — только читаемые смотрящему
// пакеты, по имени, а не по порядку записей.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // Структура компонентов (фикстура СборкаUI)

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьВкладку() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогКлассов = ОбъединитьПути(Модули, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ГрафЗависимостейЗаглушка");

	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(КаталогКлассов, "ВкладкаЗависимостей");
	Поиск.Подключить(ОбъединитьПути(Модули, "реестр", "Классы"), "АдресаСтраниц");

	UI = Новый СборкаUI().Собрать(КаталогКлассов);

КонецПроцедуры

// Пакет своего пула — ссылкой на его страницу; имя, которого в пуле нет, — текстом, экранированным;
// зависимость для разработки помечена плашкой, остальные — нет.
&Тест
Процедура ЗависитОтНазываетПакетСвоегоПулаСсылкой() Экспорт

	Граф = ГрафСтраницы();
	Граф.ЗависитОт("Autumn", "1.0");
	Граф.ЗависитОт("ghost<b>", "", Истина);

	Блок = БлокЗависитОт(Вкладка(Граф));

	Ожидаем.Что(Блок, "пакет своего пула — ссылка с каноническим именем")
		.Содержит("<a href=""/pools/main/packages/autumn"">autumn</a>");
	Ожидаем.Что(Блок, "чужое имя — экранированным текстом").Содержит("ghost&lt;b&gt;");
	Ожидаем.Что(СтрНайти(Блок, "ghost<b>"), "разметкой имя не стало").Равно(0);
	Ожидаем.Что(Блок, "диапазон словами").Содержит("&gt;=1.0");
	Ожидаем.Что(Блок, "без границ — «любая»").Содержит(UI.Тексты.Текст("public.package.deps.any"));
	Ожидаем.Что(СтрЧислоВхождений(Блок, ">" + UI.Тексты.Текст("public.package.deps.dev") + "<"),
		"плашка «для разработки» — только у своей строки").Равно(1);

КонецПроцедуры

// «Кто зависит» — по имени пакета и только из пулов, которые смотрящий читает: приватный зависящий
// не называет ни себя, ни свой пул.
&Тест
Процедура КтоЗависитПоИмениИТолькоЧитаемые() Экспорт

	Граф = ГрафСтраницы();
	Закрытый = Новый ПулЗаглушка(3, "vault9", "custom");
	Граф.ДобавитьПул(Закрытый, Ложь);
	Граф.ДобавитьПакет(11, "zeta", Новый ПулЗаглушка(1, "main", "custom"));
	Граф.ДобавитьПакет(12, "alpha", Новый ПулЗаглушка(2, "contrib", "custom"));
	Граф.ДобавитьПакет(13, "hushlib", Закрытый);
	Для Каждого Номер Из СтрРазделить("11,13,12", ",") Цикл
		Граф.ЗависитОтСтраницы(Число(Номер));
	КонецЦикла;

	Блок = Сред(Вкладка(Граф), СтрНайти(Вкладка(Граф), UI.Тексты.Текст("public.package.deps.used-by")));

	Альфа = СтрНайти(Блок, "href=""/pools/contrib/packages/alpha""");
	Зета = СтрНайти(Блок, "href=""/pools/main/packages/zeta""");
	Ожидаем.Что(Альфа, "alpha в блоке").Больше(0);
	Ожидаем.Что(Зета, "zeta идёт после alpha — порядок по имени").Больше(Альфа);
	Ожидаем.Что(СтрНайти(Блок, "hushlib"), "приватный зависящий не назван").Равно(0);
	Ожидаем.Что(СтрНайти(Блок, "vault9"), "и его пул тоже").Равно(0);

КонецПроцедуры

// Пустые стороны говорят словами; у пакета без версии по умолчанию «ни от чего не зависит» было бы неправдой.
&Тест
Процедура ПустыеСтороныГоворятСловами() Экспорт

	Пустая = Вкладка(ГрафСтраницы());
	Ожидаем.Что(Пустая, "ни от чего не зависит").Содержит(UI.Тексты.Текст("public.package.deps.none"));
	Ожидаем.Что(Пустая, "никто не зависит").Содержит(UI.Тексты.Текст("public.package.deps.nobody"));

	БезВерсии = Вкладка(ГрафСтраницы(), Ложь);
	Ожидаем.Что(БезВерсии, "без версии по умолчанию").Содержит(UI.Тексты.Текст("public.package.deps.no-default"));
	Ожидаем.Что(БезВерсии, "не «ни от чего не зависит»").Не_().Содержит(UI.Тексты.Текст("public.package.deps.none"));

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Граф пакета winow пула main: в пуле есть autumn.
Функция ГрафСтраницы()

	Граф = Новый ГрафЗависимостейЗаглушка();
	Главный = Новый ПулЗаглушка(1, "main", "custom");
	Граф.ДобавитьПул(Главный);
	Граф.ДобавитьПул(Новый ПулЗаглушка(2, "contrib", "custom"));
	Граф.ДобавитьПакет(1, "winow", Главный);
	Граф.ДобавитьПакет(2, "autumn", Главный);
	Возврат Граф;

КонецФункции

Функция Вкладка(Знач Граф, Знач ЕстьВерсия = Истина)

	Вкладка = Новый ВкладкаЗависимостей(Граф, Граф, Граф, Граф, Граф, UI.Кит, UI.Тексты, Новый АдресаСтраниц());
	Пакет = Граф.ПакетДляЧтения(1, "winow");
	Версия = ?(ЕстьВерсия, Новый Структура("Идентификатор", 1), Неопределено);
	Возврат Вкладка.Вкладка(Граф.ПулПоИдентификатору(1), Пакет, Версия,
		Новый Структура("Пользователь, Сессия", Неопределено, Неопределено)).Рендер();

КонецФункции

Функция БлокЗависитОт(Знач Разметка)
	Начало = СтрНайти(Разметка, UI.Тексты.Текст("public.package.deps.uses"));
	Конец = СтрНайти(Разметка, UI.Тексты.Текст("public.package.deps.used-by"));
	Возврат Сред(Разметка, Начало, Конец - Начало);
КонецФункции

#КонецОбласти
