// Разметка блока «Получатели» в карточке подписки хаба и пула: свёрнутая сводка, открытое
// дерево с галками пулов и пакетов, предел пакетов на пул, поиск; разбор галок формы.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем UI;              // фикстура СборкаUI — кит компонентов, словарь, резолвер текстов
Перем Разбор;          // РазборФормы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Собрать() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	КаталогПодписок = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");

	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(КаталогWebUI);

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЗаписьФормы");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "СписокЧерезЗапятую");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Для Каждого Имя Из СтрРазделить("РазборФормы,ИменаПолейПодписки,КаталогДействийПодписки,ПоляПодписки,"
		+ "РазборФормыПодписки,БланкРаздела,ПоляСобытийПодписки,ПоляСвойствПодписки,ПоправкиНижестоящих,"
		+ "ДеревоПолучателей,ВитринаПодписок,ПультПодписок,СводкаПодписки,ПравилоДереваПолучателей,СчётСловами,"
		+ "ПроверкаПодпискиДоСохранения", ",") Цикл
		ПоискКлассов.Подключить(КаталогWebUI, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(КаталогПодписок, "РеестрДействийПодписок");
	ПоискКлассов.Подключить(КаталогПодписок, "ПараметрыПодписки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогПодписок, "обработчики", "вебхук"), "РендерНастроекВебхука");

	Для Каждого Имя Из СтрРазделить("ПробныйТипДействия,ФейкСервисПодписок,ФейкКаталогСобытий,"
		+ "ФейкХранилищеВебхуков,ФейкВебхукЗапись,ФейкСервисПоправок,ФейкСервисПулов,"
		+ "ФейкПакетыПоИдентификатору,ФейкСервисИсключений", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЧтениеПолей");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "КанонСтроки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"), "ОтборПоТегам");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "ОтборТеговПодписки");
	РеестрФикстур.Подключить("ФейкКаналыПакетов");
	РеестрФикстур.Подключить("ФейкПредпросмотрУведомления");

	Разбор = Новый РазборФормы();

КонецПроцедуры

#Область СвёрнутоеДерево

&Тест
Процедура СвёрнутоеДеревоПоказываетСводкуИСсылкуНаДерево() Экспорт

	Стенд = НовыйСтенд("хаб");
	Альфа = Стенд.Исключения.ДобавитьПул(3, "alpha");
	Стенд.Исключения.ДобавитьПакет(Альфа, 42, "web", Истина);
	Стенд.Исключения.ДобавитьПакет(Альфа, 43, "jlib", Истина);
	Стенд.Исключения.ДобавитьПул(4, "beta", Истина, Истина);

	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("хаб")));

	Ожидаем.Что(HTML, "сводка исключений").Содержит("Исключены из подписки: 1 пул и 2 пакета.");
	Ожидаем.Что(HTML, "ссылка открывает дерево этой подписки").Содержит("/hub/settings/webhooks?recipients=7");
	Ожидаем.Что(СтрНайти(HTML, "получатель_"), "галок в свёрнутом блоке нет").Равно(0);
	Ожидаем.Что(Открытых(HTML), "карточка подписки свёрнута").Равно(0);

КонецПроцедуры

&Тест
Процедура БезИсключенийСводкаГоворитЧтоПодпискаОбоВсех() Экспорт

	Стенд = НовыйСтенд("пул");
	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("пул")));
	Ожидаем.Что(HTML, "сводка").Содержит("Подписка сообщает обо всех пулах и пакетах");

КонецПроцедуры

&Тест
Процедура УПодпискиПакетаДереваНет() Экспорт

	Стенд = НовыйСтенд("пакет");
	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("пакет", "7")));
	Ожидаем.Что(СтрНайти(HTML, "Получатели"), "блока нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "recipients"), "ни ссылки, ни формы").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОткрытоеДерево

&Тест
Процедура ОткрытоеДеревоХабаНесётГалкиПуловИПакетовВСвёрнутыхВетках() Экспорт

	Стенд = НовыйСтенд("хаб");
	Альфа = Стенд.Исключения.ДобавитьПул(3, "alpha");
	Стенд.Исключения.ДобавитьПакет(Альфа, 43, "jlib");
	Стенд.Исключения.ДобавитьПакет(Альфа, 42, "web", Истина);
	Бета = Стенд.Исключения.ДобавитьПул(4, "beta", Истина, Истина);
	Стенд.Исключения.ДобавитьПакет(Бета, 50, "secret");

	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("хаб", "7")));

	Ожидаем.Что(HTML, "форма постит на адрес подписки").Содержит("action=""/hub/settings/webhooks/7/recipients""");
	Ожидаем.Что(Отмечен(HTML, "получатель_пакет_43"), "jlib включён").ЭтоИстина();
	Ожидаем.Что(Отмечен(HTML, "получатель_пакет_42"), "web снят").ЭтоЛожь();
	Ожидаем.Что(Отмечен(HTML, "получатель_пакет_50"), "пакет снятого пула снят вместе с ним").ЭтоЛожь();
	Ожидаем.Что(HTML, "приватный пул помечен").Содержит("приватный");
	Ожидаем.Что(HTML, "у пула счёт исключённых пакетов").Содержит("исключено: 1");
	Ожидаем.Что(HTML, "свёрнутый снятый пул говорит, что молчит со всеми пакетами").Содержит("исключён со всеми пакетами");
	Ожидаем.Что(СтрНайти(ШапкиВеток(HTML), "<input"), "в кнопке раскрытия ветки галок нет").Равно(0);
	Ожидаем.Что(ЗначениеПоля(HTML, "показанные_узлы"), "форма перечисляет показанные узлы")
		.Равно("пул_3,пакет_42,пакет_43,пул_4,пакет_50");
	Ожидаем.Что(Открытых(HTML), "раскрыта карточка подписки, пулы свёрнуты").Равно(1);

КонецПроцедуры

// Три состояния галки пула печатает сервер: страница без скрипта видит их так же.
&Тест
Процедура ГалкаПулаВключёнСнятИЧастичноБезСкрипта() Экспорт

	Стенд = НовыйСтенд("хаб");
	Альфа = Стенд.Исключения.ДобавитьПул(3, "alpha");
	Стенд.Исключения.ДобавитьПакет(Альфа, 42, "web", Истина);
	Стенд.Исключения.ДобавитьПакет(Альфа, 43, "jlib");
	Стенд.Исключения.ДобавитьПул(4, "beta", Ложь, Истина);
	Гамма = Стенд.Исключения.ДобавитьПул(5, "gamma");
	Стенд.Исключения.ДобавитьПакет(Гамма, 60, "core");

	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("хаб", "7")));

	Ожидаем.Что(Состояние(HTML, "получатель_пул_5"), "все пакеты включены — пул включён").Равно("on");
	Ожидаем.Что(Отмечен(HTML, "получатель_пул_5"), "и отмечен").ЭтоИстина();
	Ожидаем.Что(Состояние(HTML, "получатель_пул_4"), "снятый пул снят").Равно("off");
	Ожидаем.Что(Отмечен(HTML, "получатель_пул_4"), "и не отмечен").ЭтоЛожь();
	Ожидаем.Что(Состояние(HTML, "получатель_пул_3"), "часть пакетов снята — частично").Равно("mixed");
	Ожидаем.Что(Отмечен(HTML, "получатель_пул_3"), "«частично» уходит в форму отмеченным: пул включён").ЭтоИстина();
	Ожидаем.Что(ТегГалки(HTML, "получатель_пул_3"), "и называет себя скринридеру").Содержит("aria-checked=""mixed""");
	Ожидаем.Что(СтрНайти(ТегГалки(HTML, "получатель_пул_5"), "aria-checked"), "у включённого — нет").Равно(0);

КонецПроцедуры

&Тест
Процедура УПодпискиПулаГалкиПулаНетТолькоЕгоПакеты() Экспорт

	Стенд = НовыйСтенд("пул");
	Стенд.Исключения.БезГалкиПула();
	Пул = Стенд.Исключения.ДобавитьПул(3, "main");
	Стенд.Исключения.ДобавитьПакет(Пул, 42, "web");

	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("пул", "7")));
	Ожидаем.Что(СтрНайти(HTML, "получатель_пул_"), "свой пул не снимается").Равно(0);
	Ожидаем.Что(Отмечен(HTML, "получатель_пакет_42"), "пакет пула с галкой").ЭтоИстина();
	Ожидаем.Что(ЗначениеПоля(HTML, "показанные_узлы"), "в перечне только пакет").Равно("пакет_42");

КонецПроцедуры

&Тест
Процедура БольшойПулНеПревращаетсяВПростынюАИсключённыеВидныВсегда() Экспорт

	Стенд = НовыйСтенд("хаб");
	Пул = Стенд.Исключения.ДобавитьПул(3, "big");
	Для Номер = 1 По 250 Цикл
		Стенд.Исключения.ДобавитьПакет(Пул, 1000 + Номер, "pkg" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"));
	КонецЦикла;
	Стенд.Исключения.ДобавитьПакет(Пул, 9999, "zzz-last", Истина);

	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("хаб", "7")));

	Ожидаем.Что(ЧислоВхождений(HTML, "name=""получатель_пакет_"), "исключённый и сотня включённых")
		.Равно(101);
	Ожидаем.Что(Отмечен(HTML, "получатель_пакет_9999"), "исключённый показан, хоть и последний по имени")
		.ЭтоЛожь();
	Ожидаем.Что(HTML, "остальных предлагают найти поиском").Содержит("Показаны 101 из 251");
	Ожидаем.Что(СтрНайти(ЗначениеПоля(HTML, "показанные_узлы"), "пакет_1250"),
		"непоказанный пакет формой не затрагивается").Равно(0);
	Галка = ТегГалки(HTML, "получатель_пул_3");
	Ожидаем.Что(Галка, "скрипту — сколько пакетов пула не показано и включено").Содержит("data-tree-rest-on=""150""");
	Ожидаем.Что(Галка, "и сколько из них снято").Содержит("data-tree-rest-off=""0""");

КонецПроцедуры

&Тест
Процедура ПоискОставляетПулыСНайденнымиПакетамиИРаскрываетИх() Экспорт

	Стенд = НовыйСтенд("хаб");
	Альфа = Стенд.Исключения.ДобавитьПул(3, "alpha");
	Стенд.Исключения.ДобавитьПакет(Альфа, 42, "web-tools");
	Стенд.Исключения.ДобавитьПакет(Альфа, 43, "jlib");
	Бета = Стенд.Исключения.ДобавитьПул(4, "beta");
	Стенд.Исключения.ДобавитьПакет(Бета, 50, "secret");

	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("хаб", "7", "WEB")));

	Ожидаем.Что(HTML, "поиск сохраняет открытое дерево").Содержит("name=""recipients"" value=""7""");
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""find"" value=""WEB"""),
		"поиск едет и в строке поиска, и в форме галок").Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "получатель_пакет_42") > 0, "найденный пакет показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "получатель_пакет_43"), "ненайденный сосед скрыт").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "получатель_пул_4"), "пул без найденного скрыт").Равно(0);
	Ожидаем.Что(ЗначениеПоля(HTML, "показанные_узлы"), "форма касается только найденного").Равно("пул_3,пакет_42");
	Ожидаем.Что(Открытых(HTML), "карточка и пул с находкой раскрыты").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ГалкиФормы

&Тест
Процедура ГалкиКасаютсяТолькоПоказанныхУзлов() Экспорт

	Исключения = Новый ФейкСервисИсключений();
	Пул = Исключения.ДобавитьПул(7, "main");
	Исключения.ДобавитьПакет(Пул, 42, "web");
	Исключения.ДобавитьПакет(Пул, 43, "jlib", Истина);
	Исключения.ДобавитьПакет(Пул, 44, "hidden", Истина);

	Форма = Новый Соответствие();
	Форма.Вставить("показанные_узлы", "пул_7,пакет_42,пакет_43,мусор,пакет_x");
	Форма.Вставить("получатель_пул_7", "1");
	Форма.Вставить("получатель_пакет_43", "1");
	Форма.Вставить("получатель_пакет_99", "1");

	Исход = Пульт(Исключения).ПрименитьДерево(Новый Структура("Идентификатор", 1), Новый Структура("ТипОбъекта", "хаб"),
		"5", Форма);

	Ожидаем.Что(Исход.Успех, "галки легли").ЭтоИстина();
	Отметка = Исключения.Отметки()[0];
	Ожидаем.Что(Отметка.Идентификатор, "подписка из адреса").Равно(5);
	Ожидаем.Что(Узлы(Отметка.Исключаемые), "снята галка показанного пакета").Равно("пакет#42");
	Ожидаем.Что(Узлы(Отметка.Включаемые), "пул и отмеченный пакет; непоказанные 44 и 99 не тронуты")
		.Равно("пул#7,пакет#43");

КонецПроцедуры

// Снятая галка пула исключает его целиком — с будущими пакетами; строки его пакетов снимаются:
// их перекрывает пул, а включённый снова пул вернётся со всеми пакетами.
&Тест
Процедура СнятыйПулИсключаетсяЦеликомАСтрокиПакетовСнимаются() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пакет_42", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Ложь, Истина));
	Ожидаем.Что(Узлы(Галки.Исключаемые), "пул целиком").Равно("пул#7");
	Ожидаем.Что(Узлы(Галки.Включаемые), "строки исключённых пакетов, показанных и нет, снимаются")
		.Равно("пакет#43,пакет#44");

КонецПроцедуры

// (а) Сняты все пакеты пула, а непоказанных включённых нет: пул снят целиком, как его покажет
// скрипт, — хотя без скрипта галка пула осталась отмеченной.
&Тест
Процедура СнятыеВсеПакетыСнимаютПулЦеликомИБезСкрипта() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пул_7", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Ложь, Ложь));
	Ожидаем.Что(Узлы(Галки.Исключаемые), "пул целиком, с будущими пакетами").Равно("пул#7");
	Ожидаем.Что(Узлы(Галки.Включаемые), "строки пакетов перекрыты пулом").Равно("пакет#43,пакет#44");

КонецПроцедуры

// Сняты все показанные, но у пула есть непоказанные включённые: пул в подписке, «частично».
&Тест
Процедура СнятыеВсеПоказанныеПриВключённыхНепоказанныхОставляютПул() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пул_7", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Ложь, Истина));
	Ожидаем.Что(Узлы(Галки.Включаемые), "пул в подписке").Равно("пул#7");
	Ожидаем.Что(Узлы(Галки.Исключаемые), "снят показанный, непоказанные — как были").Равно("пакет#42");

КонецПроцедуры

// (б) Пул был снят, а теперь отмечен вместе со всеми показанными пакетами — включён целиком:
// непоказанные пакеты тоже, будущие попадут сами. Скрипт даёт тот же вид щелчком по пулу.
&Тест
Процедура СнятыйПулОтмеченныйСоВсемиПоказаннымиВключаетсяЦеликом() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пул_7", "1");
	Форма.Вставить("получатель_пакет_42", "1");
	Форма.Вставить("получатель_пакет_43", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Истина, Истина));
	Ожидаем.Что(Узлы(Галки.Исключаемые), "ничего не снято").Равно("");
	Ожидаем.Что(Узлы(Галки.Включаемые), "пул и строки исключённых пакетов, непоказанный 44 тоже")
		.Равно("пул#7,пакет#43,пакет#44");

КонецПроцедуры

// Без скрипта у снятого пула поставили только его галку — пул возвращается со всеми пакетами.
&Тест
Процедура БезСкриптаВозвращённыйПулВозвращаетВсеПакеты() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пул_7", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Истина, Истина));
	Ожидаем.Что(Узлы(Галки.Исключаемые), "ничего не снято").Равно("");
	Ожидаем.Что(Узлы(Галки.Включаемые), "пул и строки его пакетов").Равно("пул#7,пакет#43,пакет#44");

КонецПроцедуры

// У снятого пула отметили часть пакетов: пул в подписке, остальные пакеты сняты — и непоказанные.
&Тест
Процедура СнятыйПулСЧастьюПакетовСнимаетНепоказанные() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пул_7", "1");
	Форма.Вставить("получатель_пакет_43", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Истина, Истина));
	Ожидаем.Что(Узлы(Галки.Включаемые), "пул и отмеченный пакет").Равно("пул#7,пакет#43");
	Ожидаем.Что(Узлы(Галки.Исключаемые), "показанный без галки и непоказанный включённый")
		.Равно("пакет#42,пакет#45");

КонецПроцедуры

// Без скрипта под снятым пулом отметили пакет, галку пула не трогали — скрипт поднял бы её сам:
// пул в подписке, включён отмеченный, остальные сняты — и непоказанные.
&Тест
Процедура БезСкриптаОтмеченныйПакетСнятогоПулаВключаетТолькоЕго() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пакет_43", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Истина, Истина));
	Ожидаем.Что(Узлы(Галки.Включаемые), "пул и отмеченный пакет").Равно("пул#7,пакет#43");
	Ожидаем.Что(Узлы(Галки.Исключаемые), "показанный без галки и непоказанный включённый")
		.Равно("пакет#42,пакет#45");

КонецПроцедуры

// Все пакеты исключены поштучно — пул напечатан снятым; без скрипта отмечен один пакет: включён
// он, второй остаётся снятым, строки пула не появляется.
&Тест
Процедура БезСкриптаОтмеченныйПакетПулаСнятогоПоштучноВключаетТолькоЕго() Экспорт

	Исключения = Новый ФейкСервисИсключений();
	Пул = Исключения.ДобавитьПул(7, "main");
	Исключения.ДобавитьПакет(Пул, 42, "web", Истина);
	Исключения.ДобавитьПакет(Пул, 43, "jlib", Истина);
	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пакет_43", "1");

	Галки = Отметки(Форма, Исключения.ДеревоПолучателей(Неопределено, Неопределено, 5));
	Ожидаем.Что(Узлы(Галки.Включаемые), "пул в подписке и отмеченный пакет").Равно("пул#7,пакет#43");
	Ожидаем.Что(Узлы(Галки.Исключаемые), "ничего нового не снято, пула — тоже").Равно("");

КонецПроцедуры

// Включённый пул без снятых галок: непоказанных и будущих пакетов форма не касается.
&Тест
Процедура ВключённыйПулНеТрогаетНепоказанныхПакетов() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43");
	Форма.Вставить("получатель_пул_7", "1");
	Форма.Вставить("получатель_пакет_42", "1");
	Форма.Вставить("получатель_пакет_43", "1");

	Галки = Отметки(Форма, ДеревоОдногоПула(Ложь, Истина));
	Ожидаем.Что(Узлы(Галки.Исключаемые), "ничего не снято").Равно("");
	Ожидаем.Что(Узлы(Галки.Включаемые), "непоказанный исключённый 44 остаётся как был")
		.Равно("пул#7,пакет#43");

КонецПроцедуры

// Значение галки ничего не решает: подделанное значение сохраняется как простая отметка, а пул
// вне дерева и пул у подписки пула уходят в домен как есть — он их отвергает или пропускает.
&Тест
Процедура ПодделанноеЗначениеГалкиПулаНичегоНеРешает() Экспорт

	Форма = ФормаДерева("пул_7,пакет_42,пакет_43,пул_9");
	Форма.Вставить("получатель_пул_7", "все");
	Форма.Вставить("получатель_пакет_43", "1");
	Форма.Вставить("получатель_пул_9", "все");

	Галки = Отметки(Форма, ДеревоОдногоПула(Ложь, Истина));
	Ожидаем.Что(Узлы(Галки.Включаемые), "как простая отметка: непоказанный исключённый 44 не включён")
		.Равно("пул#7,пакет#43,пул#9");
	Ожидаем.Что(Узлы(Галки.Исключаемые), "снятый показанный — снят").Равно("пакет#42");

	Пула = ДеревоОдногоПула(Ложь, Истина);
	Пула.ПодпискаХаба = Ложь;
	Галки = Отметки(Форма, Пула);
	Ожидаем.Что(СтрНайти(Узлы(Галки.Включаемые), "пакет#44"), "у подписки пула пул ничего за пакеты не решает")
		.Равно(0);

КонецПроцедуры

// «Частично» печатается, только когда снята часть пакетов: сняты все — пул снят, как его
// покажет скрипт, и без скрипта его галка не отмечена.
&Тест
Процедура ПулСоВсемиСнятымиПакетамиПечатаетсяСнятым() Экспорт

	Стенд = НовыйСтенд("хаб");
	Альфа = Стенд.Исключения.ДобавитьПул(3, "alpha");
	Стенд.Исключения.ДобавитьПакет(Альфа, 42, "web", Истина);
	Стенд.Исключения.ДобавитьПакет(Альфа, 43, "jlib", Истина);

	HTML = ТелоСекций(Стенд.Витрина.Секции(Параметры("хаб", "7")));
	Ожидаем.Что(Состояние(HTML, "получатель_пул_3"), "сняты все пакеты — пул снят").Равно("off");
	Ожидаем.Что(Отмечен(HTML, "получатель_пул_3"), "и его галка не отмечена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция НовыйСтенд(Знач ТипОбъекта)

	События = Новый ФейкКаталогСобытий();
	Сервис = Новый ФейкСервисПодписок();
	Типы = Новый Массив();
	Типы.Добавить("package.version.published");
	Сервис.УстановитьТипыСобытий(Типы);

	Подписка = Новый ФейкВебхукЗапись(Новый ФейкХранилищеВебхуков());
	Подписка.Идентификатор = 7;
	Подписка.ТипОбъекта = ТипОбъекта;
	Подписка.ТипДействия = "вебхук";
	Подписка.URL = "https://hook.example.com/a";
	Подписка.ТипыСобытий = "package.version.published";
	Подписка.Активен = Истина;
	Сервис.ДобавитьПодписку(Подписка);

	Имена = Новый ИменаПолейПодписки(Новый ЗащитаCSRF(Неопределено));
	Каталог = Новый КаталогДействийПодписки(Реестр(), UI.Тексты, Имена);
	Сохранённые = Новый ПараметрыПодписки(События);
	ПоляСобытий = Новый ПоляСобытийПодписки(UI.Кит, Сервис, События, Сохранённые, Имена, Разбор, UI.Тексты);
	ПоляСвойств = Новый ПоляСвойствПодписки(UI.Кит, Сохранённые, Имена, Разбор, UI.Тексты);
	Каналы = Новый ФейкКаналыПакетов();
	ОтборТегов = ОтборТеговПодписки(Каналы, Имена);
	Поправки = Новый ФейкСервисПоправок();
	Сузившие = Новый ПоправкиНижестоящих(UI.Кит, Поправки, Сохранённые, Новый ФейкСервисПулов(),
		Новый ФейкПакетыПоИдентификатору(), ПоляСобытий, ОтборПоТегам(Каналы), UI.Тексты);
	Бланки = Новый БланкРаздела(UI.Кит);
	Исключения = Новый ФейкСервисИсключений();
	Счёт = Новый СчётСловами(UI.Тексты);
	Получатели = Новый ДеревоПолучателей(UI.Кит, Исключения, Имена, Бланки, UI.Тексты,
		Новый ПравилоДереваПолучателей(Разбор, Имена, Исключения), Счёт);
	Сводки = Новый СводкаПодписки(UI.Кит, UI.Тексты, Сервис, Сохранённые, Поправки, Каталог, ПоляСобытий, ОтборТегов,
		Получатели, Счёт);

	Витрина = Новый ВитринаПодписок(UI.Кит, UI.РендерерНастроек, Сервис, ПоляСобытий, ПоляСвойств, ОтборТегов, Сузившие,
		Получатели, Сохранённые, Каталог, Новый ПоляПодписки(UI.Кит, UI.Тексты, Разбор, Имена, Каталог), Имена,
		Бланки, UI.Тексты, Разбор, Новый ПроверкаПодпискиДоСохранения(UI.Кит, UI.РендерерНастроек, UI.Тексты, Бланки,
			Имена, Каталог, Новый ФейкПредпросмотрУведомления(), Реестр()), Сводки, Новый ФейкПредпросмотрУведомления());

	Возврат Новый Структура("Исключения, Витрина", Исключения, Витрина);

КонецФункции

// Отбор по тегам на настоящем домене подписок; теги пулов и пакетов — у фейка реестра.
Функция ОтборПоТегам(Знач Каналы)
	Возврат Новый ОтборПоТегам(Каналы, Каналы, Новый ИздательСобытий());
КонецФункции

Функция ОтборТеговПодписки(Знач Каналы, Знач Имена)
	Возврат Новый ОтборТеговПодписки(UI.Кит, ОтборПоТегам(Каналы), Имена, Разбор, UI.Тексты);
КонецФункции

Функция Реестр()

	Доставки = Новый Массив();
	Доставки.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-1"));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-2"));
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры);

КонецФункции

Функция Параметры(Знач ТипОбъекта, Знач ДеревоИд = "", Знач Поиск = "")

	Адреса = Новый Соответствие();
	Адреса.Вставить("хаб", "/hub/settings/webhooks");
	Адреса.Вставить("пул", "/pools/main/settings/webhooks");
	Адреса.Вставить("пакет", "/pools/main/packages/web/settings/webhooks");

	Параметры = Новый Структура();
	Параметры.Вставить("Объект", Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор", ТипОбъекта, 3, 3));
	Параметры.Вставить("Адрес", Адреса.Получить(ТипОбъекта));
	Параметры.Вставить("Токен", "csrf-токен");
	Параметры.Вставить("НовыйСекрет", "");
	Параметры.Вставить("Пояснение", "Пояснение раздела.");
	Параметры.Вставить("МожноМенять", Истина);
	Параметры.Вставить("Тип", "");
	Параметры.Вставить("Зритель", Новый Структура("Идентификатор", 1));
	Параметры.Вставить("ДеревоИд", ДеревоИд);
	Параметры.Вставить("Поиск", Поиск);
	Возврат Параметры;

КонецФункции

Функция ТелоСекций(Знач Секции)

	Результат = "";
	Для Каждого Секция Из Секции Цикл
		Результат = Результат + Строка(Секция.Тело);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отмечен ли флажок с этим именем: атрибут checked стоит в том же теге.
Функция Отмечен(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Позиция > 0, СтрШаблон("флажок %1 напечатан", ИмяПоля)).ЭтоИстина();
	Хвост = Сред(HTML, Позиция);
	Возврат СтрНайти(Лев(Хвост, СтрНайти(Хвост, ">")), "checked") > 0;

КонецФункции

Функция ЗначениеПоля(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Позиция > 0, СтрШаблон("поле %1 напечатано", ИмяПоля)).ЭтоИстина();
	Хвост = Сред(HTML, Позиция);
	Тег = Лев(Хвост, СтрНайти(Хвост, ">"));
	Начало = СтрНайти(Тег, "value=""") + СтрДлина("value=""");
	Возврат Сред(Тег, Начало, СтрНайти(Сред(Тег, Начало), """") - 1);

КонецФункции

// Все свёрнутые строки раскрывашек подряд.
Функция ШапкиВеток(Знач HTML)

	Шапки = "";
	Хвост = HTML;
	Позиция = СтрНайти(Хвост, "<summary");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Шапки = Шапки + Лев(Хвост, СтрНайти(Хвост, "</summary>"));
		Хвост = Сред(Хвост, 2);
		Позиция = СтрНайти(Хвост, "<summary");
	КонецЦикла;
	Возврат Шапки;

КонецФункции

// Сколько раскрывашек приезжают раскрытыми: атрибут open в открывающем теге details.
Функция Открытых(Знач HTML)

	Открыто = 0;
	Хвост = HTML;
	Позиция = СтрНайти(Хвост, "<details");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + 1);
		Тег = Лев(Хвост, СтрНайти(Хвост, ">"));
		Если СтрНайти(Тег, " open") > 0 Тогда
			Открыто = Открыто + 1;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, "<details");
	КонецЦикла;
	Возврат Открыто;

КонецФункции

// Пул 7 с пакетами: 42 — включён, 43 — исключён (оба показываются формой), 44 — исключён и,
// если ЕстьНепоказанныйВключённый, 45 — включён (не показаны). Исключён — снят ли пул целиком.
Функция ДеревоОдногоПула(Знач Исключён, Знач ЕстьНепоказанныйВключённый)

	Исключения = Новый ФейкСервисИсключений();
	Пул = Исключения.ДобавитьПул(7, "main", Ложь, Исключён);
	Исключения.ДобавитьПакет(Пул, 42, "web");
	Исключения.ДобавитьПакет(Пул, 43, "jlib", Истина);
	Исключения.ДобавитьПакет(Пул, 44, "hidden-off", Истина);
	Если ЕстьНепоказанныйВключённый Тогда
		Исключения.ДобавитьПакет(Пул, 45, "hidden-on");
	КонецЕсли;
	Возврат Исключения.ДеревоПолучателей(Неопределено, Неопределено, 5);

КонецФункции

Функция ФормаДерева(Знач Показанные)
	Форма = Новый Соответствие();
	Форма.Вставить("показанные_узлы", Показанные);
	Возврат Форма;
КонецФункции

Функция Отметки(Знач Форма, Знач Дерево)
	Имена = Новый ИменаПолейПодписки(Новый ЗащитаCSRF(Неопределено));
	Возврат Новый ПравилоДереваПолучателей(Разбор, Имена, Новый ФейкСервисИсключений()).Отметки(Форма, Дерево);
КонецФункции

Функция Пульт(Знач Исключения)
	Имена = Новый ИменаПолейПодписки(Новый ЗащитаCSRF(Неопределено));
	Возврат Новый ПультПодписок(Разбор, Неопределено, Неопределено, Неопределено, Имена, Новый ПриведениеЧисел(),
		Неопределено, Исключения, ОтборТеговПодписки(Новый ФейкКаналыПакетов(), Имена),
		Новый ФейкПредпросмотрУведомления(), Новый ПравилоДереваПолучателей(Разбор, Имена, Исключения));
КонецФункции

// Тег галки с этим именем целиком.
Функция ТегГалки(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Позиция > 0, СтрШаблон("галка %1 напечатана", ИмяПоля)).ЭтоИстина();
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Состояние галки дерева, напечатанное сервером: on | off | mixed.
Функция Состояние(Знач HTML, Знач ИмяПоля)

	Тег = ТегГалки(HTML, ИмяПоля);
	Метка = "data-checktree-state=""";
	Начало = СтрНайти(Тег, Метка) + СтрДлина(Метка);
	Возврат Сред(Тег, Начало, СтрНайти(Сред(Тег, Начало), """") - 1);

КонецФункции

Функция ЧислоВхождений(Знач HTML, Знач Подстрока)
	Возврат СтрЧислоВхождений(HTML, Подстрока);
КонецФункции

Функция Узлы(Знач Перечень)
	Ключи = Новый Массив();
	Для Каждого Узел Из Перечень Цикл
		Ключи.Добавить(Узел.ТипОбъекта + "#" + Формат(Узел.Идентификатор, "ЧГ=0"));
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ",");
КонецФункции

#КонецОбласти
