// Раздел доверенных конвейеров дома «Пакет»: ссылки, маски, издатель, имя записи и готовый
// конвейер — на настоящих КороткаяФормаДоверия и ВитринаДоверияCI; окно «Доверить конвейеру»,
// подтверждение отзыва по адресу и двери раздела — настоящим КонтроллерДоверияCI; записи
// и мутации домена — фейк сервиса.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Стража;      // СтражИздателейCI с настройкой издателей
Перем Сервис;      // ФейкДоверияCI — записи раздела и мутации домена
Перем Окна;        // ОкноРаздела
Перем Витрина;     // ВитринаДоверияCI
Перем Гвард;       // ГвардПакетаЗаглушка
Перем Защита;      // ЗащитаCSRFЗаглушка
Перем Контроллер;  // КонтроллерДоверияCI

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "АдресаСтраниц");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "АдресИнстанса");

	КаталогPublish = ОбъединитьПути(КаталогМодулей, "публикация", "Классы");
	Для Каждого Имя Из СтрРазделить("МаскаРефа,СтражИздателейCI,КороткаяФормаДоверия,ИмяЗаписиДоверия,"
		+ "ВидРефаДоверия", ",") Цикл
		Поиск.Подключить(КаталогPublish, Имя);
	КонецЦикла;

	Для Каждого Фикстура Из СтрРазделить("ОбразецДоверияCI,ФейкХранилищаДоверияCI,ФейкДоверияCI,"
		+ "НастройкиЗаглушкаCI,ГвардПакетаЗаглушка,ПорогРазделаПакетаЗаглушка,ЗащитаCSRFЗаглушка,"
		+ "ОтветСтраницыЗаглушка,КукиЗаглушка,ФейкСервисПрав,НастройкиЗаглушка", ",") Цикл
		РеестрФикстур.Подключить(Фикстура);
	КонецЦикла;

	КаталогWeb = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("КомандыOpm,СниппетыКонвейеров,ОкноРаздела,ОтметкаСохранения,"
		+ "ПредставлениеПровайдераCI,СписокДоверияCI,ФормаДоверияCI,ГотовыйКонвейерCI,ВитринаДоверияCI,"
		+ "ПультДоверияCI,КонтроллерДоверияCI,ОтветыНастроек,СборкаДомаНастроек,АдресаКаталога,ДомПула,"
		+ "ДомПакета,РазборФормы,ГейтФормы,ИсходОкна", ",") Цикл
		Поиск.Подключить(КаталогWeb, Имя);
	КонецЦикла;

	// self-hosted GitLab добавляется настройкой хаба — на нём и проверяется издатель
	Настройки = Новый НастройкиЗаглушкаCI();
	Настройки.Задать("oshub.publish.ci.issuers", "https://gitlab.acme.ru");
	Стража = Новый СтражИздателейCI(Неопределено, Неопределено, Настройки, Неопределено);

КонецПроцедуры

&ПередКаждым
Процедура СобратьВитрину() Экспорт

	Короткая = Новый КороткаяФормаДоверия(Новый ФейкХранилищаДоверияCI(), Новый МаскаРефа(), Стража);
	Сервис = Новый ФейкДоверияCI(Новый ИмяЗаписиДоверия(Короткая, Стража));
	Сниппеты = Новый СниппетыКонвейеров(Новый КомандыOpm(Новый АдресИнстанса(Новый НастройкиЗаглушка()),
		Новый ЗаголовкиHTTP()), Новый ВидРефаДоверия());
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), UI.Подтверждение);

	Провайдеры = Новый ПредставлениеПровайдераCI(Сервис, Стража, UI.Адреса, UI.Тексты);
	Форма = Новый ФормаДоверияCI(UI.Кит, Сервис, Стража, Провайдеры, Сниппеты, Новый ВидРефаДоверия(), Окна,
		UI.Тексты);
	Список = Новый СписокДоверияCI(UI.Кит, Сервис, Новый МаскаРефа(), Провайдеры, Короткая, Окна, UI.Тексты);
	Витрина = Новый ВитринаДоверияCI(Список,
		Форма,
		Новый ГотовыйКонвейерCI(UI.Кит, Сервис, Сниппеты, UI.Тексты),
		Окна);

	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Сборка, Новый ФейкСервисПрав(), UI.Тексты,
		Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Страницы = Новый АдресаСтраниц();
	ДомПула = Новый ДомПула(Сборка, UI.Тексты, Страницы, Новый АдресаКаталога());
	Открыто = Новый ПорогРазделаПакетаЗаглушка(Истина);
	Дом = Новый ДомПакета(Сборка, ДомПула, Открыто, Открыто, UI.Тексты, Страницы);
	Защита = Новый ЗащитаCSRFЗаглушка();
	РазборФормы = Новый РазборФормы();
	Пульт = Новый ПультДоверияCI(РазборФормы, Форма, Список, Новый ИсходОкна(Окна), Сервис, Провайдеры,
		Новый ПриведениеЧисел(), Короткая, Новый ВидРефаДоверия(), UI.Тексты);

	Гвард = Новый ГвардПакетаЗаглушка();
	Гвард.Впустить("alice", Новый Структура("Идентификатор, Имя", 3, "main"),
		Новый Структура("Идентификатор, Имя", 1, "lib"));
	Контроллер = Новый КонтроллерДоверияCI(Гвард, Ответы, Дом, Витрина, Пульт,
		Новый ГейтФормы(Ответы, Защита, РазборФормы), Защита, Окна, Сервис, Сниппеты, UI.Тексты);

КонецПроцедуры

#Область Ссылки

// Владелец пакета попадает из списка в свой репозиторий и в сам файл workflow; в ссылке —
// короткое имя файла, длинный путь не рвёт таблицу посреди слова.
&Тест
Процедура ЗаписьGitHubДаётСсылкиНаРепозиторийИФайлКонвейера() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com",
		"segate-ekb/oscript-yaml", "segate-ekb/oscript-yaml/.github/workflows/release.yaml",
		"refs/heads/main", "segate");

	Разметка = Список();

	Ожидаем.Что(Разметка, "репозиторий ведёт на github.com, а не на издателя токена")
		.Содержит("href=""https://github.com/segate-ekb/oscript-yaml""");
	Ожидаем.Что(Разметка, "конвейер ведёт на файл в вебе на указанной ветке").Содержит(
		"href=""https://github.com/segate-ekb/oscript-yaml/blob/main/.github/workflows/release.yaml""");
	Ожидаем.Что(Разметка, "в ссылке показано короткое имя файла, а не весь путь")
		.Содержит(">release.yaml<");

КонецПроцедуры

// Издатель GitHub Actions — не хост репозитория: подстановка его в адрес увела бы
// в никуда.
&Тест
Процедура ИздательТокенаВАдресРепозиторияНеПопадает() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"", "refs/heads/main", "segate");

	Ожидаем.Что(СтрНайти(Список(), "token.actions.githubusercontent.com"),
		"издателя в адресах нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗаписьGitLabДаётСсылкиСРазделителемПроекта() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.com", "acme/team/lib",
		"gitlab.com/acme/team/lib//.gitlab-ci.yml", "refs/heads/main", "maria");

	Разметка = Список();

	Ожидаем.Что(Разметка, "репозиторий GitLab").Содержит("href=""https://gitlab.com/acme/team/lib""");
	Ожидаем.Что(Разметка, "у GitLab путь к файлу идёт через «/-/blob/»")
		.Содержит("href=""https://gitlab.com/acme/team/lib/-/blob/main/.gitlab-ci.yml""");

КонецПроцедуры

// Хост self-hosted инсталляции берётся из издателя: там он и есть адрес GitLab.
&Тест
Процедура SelfHostedGitLabДаётСсылкиНаСвойХост() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.acme.ru", "infra/deploy",
		"gitlab.acme.ru/infra/deploy//.gitlab-ci.yml", "refs/heads/main", "ops");

	Разметка = Список();

	Ожидаем.Что(Разметка, "репозиторий на своей инсталляции")
		.Содержит("href=""https://gitlab.acme.ru/infra/deploy""");
	Ожидаем.Что(Разметка, "и файл конвейера там же")
		.Содержит("href=""https://gitlab.acme.ru/infra/deploy/-/blob/main/.gitlab-ci.yml""");

КонецПроцедуры

// Тег — такой же ref, как ветка: за ним стоит один файл.
&Тест
Процедура ТегДаётСсылкуНаФайлБезПриставкиRefs() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"acme/lib/.github/workflows/release.yml", "refs/tags/v1.2.3", "segate");

	Ожидаем.Что(Список(), "в адресе стоит имя тега, а не полный ref")
		.Содержит("href=""https://github.com/acme/lib/blob/v1.2.3/.github/workflows/release.yml""");

КонецПроцедуры

#КонецОбласти

#Область МаскаРефа

// Маска совпадает со многими рефами, и одного файла за ней нет: конвейер ведёт на файл
// в ветке по умолчанию. Строка с конвейером — всегда ссылка.
&Тест
Процедура МаскаРефаВедётНаФайлВВеткеПоУмолчанию() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"acme/lib/.github/workflows/release.yml", "refs/heads/release/*", "segate");

	Разметка = Список();

	Ожидаем.Что(Разметка, "конвейер — ссылка на файл в ветке по умолчанию")
		.Содержит("href=""https://github.com/acme/lib/blob/HEAD/.github/workflows/release.yml""");
	Ожидаем.Что(Разметка, "имя конвейера осталось видимым").Содержит(">release.yml<");
	Ожидаем.Что(Разметка, "репозиторий по-прежнему открывается")
		.Содержит("href=""https://github.com/acme/lib""");

КонецПроцедуры

// «**» — та же маска, только предельная; она ещё и помечается как «без ограничения».
&Тест
Процедура МаскаВсехРефовВедётНаФайлВВеткеПоУмолчанию() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"acme/lib/.github/workflows/release.yml", "**", "segate");

	Разметка = Список();

	Ожидаем.Что(Разметка, "конвейер — ссылка")
		.Содержит("href=""https://github.com/acme/lib/blob/HEAD/.github/workflows/release.yml""");
	Ожидаем.Что(Разметка, "маска помечена").Содержит("без ограничения");

КонецПроцедуры

// Тот же репозиторий и тот же файл на ветке и на маске тегов: обе строки — ссылки на файл,
// а не одна ссылкой и одна кодом. Число ссылок на файл равно числу строк с конвейером.
&Тест
Процедура КаждаяСтрокаСКонвейеромСсылкаНаФайл() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "sfaqer/lambdas",
		"sfaqer/lambdas/.github/workflows/release.yml", "refs/heads/master", "sfaqer");
	Сервис.Добавить(2, "github", "https://token.actions.githubusercontent.com", "sfaqer/lambdas",
		"sfaqer/lambdas/.github/workflows/release.yml", "refs/tags/v*", "sfaqer");

	Разметка = Список();

	Ожидаем.Что(Разметка, "строка ветки ведёт на файл в ветке").Содержит(
		"href=""https://github.com/sfaqer/lambdas/blob/master/.github/workflows/release.yml""");
	Ожидаем.Что(Разметка, "строка маски тегов ведёт на файл в ветке по умолчанию").Содержит(
		"href=""https://github.com/sfaqer/lambdas/blob/HEAD/.github/workflows/release.yml""");
	Ожидаем.Что(СколькоРаз(Разметка, "/.github/workflows/release.yml"">release.yml<"),
		"имя конвейера — текст ссылки в обеих строках").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область Издатель

// Издатель github.com и gitlab.com выводится из типа репозитория и на экране не сообщает
// ничего — колонка под него отняла бы ширину у самих данных.
&Тест
Процедура ОбычныйИздательНаЭкранеНеПоказан() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"", "refs/heads/main", "segate");
	Сервис.Добавить(2, "gitlab", "https://gitlab.com", "acme/lib", "", "refs/heads/main", "maria");

	Разметка = Список();

	Ожидаем.Что(СтрНайти(Разметка, "издатель"), "уточнения об издателе нет").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "gitlab.com/acme/lib") > 0, "но сама запись показана")
		.ЭтоИстина();

КонецПроцедуры

// На инсталляции из настройки хаба издатель — единственное, чем две записи различаются:
// репозитории у них называются одинаково.
&Тест
Процедура SelfHostedИздательПоказанИРазличаетОдноимённыеЗаписи() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.com", "infra/deploy", "", "refs/heads/main", "maria");
	Сервис.Добавить(2, "gitlab", "https://gitlab.acme.ru", "infra/deploy", "", "refs/heads/main", "ops");

	Разметка = Список();

	Ожидаем.Что(Разметка, "издатель своей инсталляции назван")
		.Содержит("издатель https://gitlab.acme.ru");
	Ожидаем.Что(СколькоРаз(Разметка, "издатель https://"),
		"уточнение стоит ровно у одной записи из двух").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Безопасность

// Адрес собирается из значений, которые ввёл мейнтейнер. Негодный издатель ссылки наружу не
// даёт вовсе, а значение остаётся читаемым текстом.
&Тест
Процедура НегодныйИздательНеПревращаетсяВСсылку() Экспорт

	Сервис.Добавить(1, "gitlab", "javascript:alert(1)", "acme/lib", "", "refs/heads/main", "mallory");

	Разметка = Список();

	Ожидаем.Что(СтрНайти(Разметка, "href=""http"), "внешней ссылки в записи нет вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Разметка), "=""javascript:"),
		"схема javascript не стала значением атрибута").Равно(0);
	Ожидаем.Что(Разметка, "репозиторий читается текстом").Содержит("acme/lib");
	// сам издатель при этом виден: значение записи не прячется, оно экранировано
	Ожидаем.Что(Разметка, "негодный издатель показан текстом").Содержит("издатель javascript");

КонецПроцедуры

// Ссылку печатает ЭкранированиеHTML, и схему судит оно: даже готовый негодный адрес
// href не получает. Проверяем на самом рендерере — витрина ходит ровно через него.
&Тест
Процедура НедопустимаяСхемаАдресаОстаётсяТекстом() Экспорт

	Разметка = UI.Экран.Ссылка("javascript:alert(1)", "acme/lib");

	Ожидаем.Что(СтрНайти(Разметка, "href"), "href не напечатан").Равно(0);
	Ожидаем.Что(Разметка, "текст остался").Содержит("acme/lib");

КонецПроцедуры

// Имя репозитория уезжает в адрес: значение не из имён репозиториев ссылки не даёт.
&Тест
Процедура РепозиторийСВыходомИзПутиСсылкиНеДаёт() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com",
		"acme/../../etc/passwd", "", "refs/heads/main", "mallory");

	Ожидаем.Что(СтрНайти(Список(), "href=""http"), "внешней ссылки нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СоставСписка

// Пустой конвейер значит «любой конвейер репозитория»: пустая ячейка читалась бы как
// «не настроено», то есть ровно наоборот.
&Тест
Процедура ЗаписьБезКонвейераЧитаетсяКакЛюбой() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"", "refs/heads/main", "segate");

	Разметка = Список();

	Ожидаем.Что(Разметка, "«любой» написано словом").Содержит("любой");
	Ожидаем.Что(Разметка, "репозиторий по-прежнему открывается")
		.Содержит("href=""https://github.com/acme/lib""");

КонецПроцедуры

// Свёрнутая запись называет, что это и главное: тип репозитория плашкой, конвейер и реф —
// фактами; подробности — в теле, а не колонками, которые увели бы список вбок.
&Тест
Процедура СвёрнутаяЗаписьНазываетТипКонвейерИРеф() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"acme/lib/.github/workflows/release.yml", "refs/heads/main", "segate");

	Разметка = Список();

	Ожидаем.Что(Разметка, "записи — реестр, а не таблица").Не_().Содержит("<th scope=");
	Ожидаем.Что(Разметка, "тип репозитория — плашкой").Содержит(">GitHub Actions<");
	Ожидаем.Что(Разметка, "конвейер — фактом свёрнутой записи").Содержит(">release.yml<");
	Ожидаем.Что(Разметка, "реф — фактом").Содержит(">refs/heads/main<");

КонецПроцедуры

// Значок у записи — картинка инсталляции по адресу из таблицы активов (сверка ПО ЗНАЧЕНИЮ),
// а тип репозитория назван словами плашки.
&Тест
Процедура ТипРепозиторияПоказанЗначкомИСловами() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"", "refs/heads/main", "segate");
	Сервис.Добавить(2, "gitlab", "https://gitlab.com", "acme/lib", "", "refs/heads/main", "maria");

	Разметка = Список();

	АдресGitHub = UI.Адреса.АдресЗначка("github");
	АдресGitLab = UI.Адреса.АдресЗначка("gitlab");

	Ожидаем.Что(ЗначениеЗаполнено(АдресGitHub) И ЗначениеЗаполнено(АдресGitLab),
		"таблица активов выдаёт адреса обоих значков").ЭтоИстина();
	Ожидаем.Что(АдресGitHub = АдресGitLab,
		"у двух типов репозитория адреса значков разные").ЭтоЛожь();

	Ожидаем.Что(Разметка, "значок GitHub — ровно адрес из таблицы активов")
		.Содержит(СтрШаблон("src=""%1""", АдресGitHub));
	Ожидаем.Что(Разметка, "значок GitLab — ровно адрес из таблицы активов")
		.Содержит(СтрШаблон("src=""%1""", АдресGitLab));
	Ожидаем.Что(Разметка, "тип GitHub назван словами").Содержит(">GitHub Actions<");
	Ожидаем.Что(Разметка, "и тип GitLab").Содержит(">GitLab CI<");

КонецПроцедуры

// Логин исчезнувшей учётки не выдумывается — остаётся дата.
&Тест
Процедура ЗаписьБезАвтораПоказываетТолькоДату() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"", "refs/heads/main", "", Дата(2026, 5, 6));

	Ожидаем.Что(Список(), "дата на месте").Содержит("06.05.2026");

КонецПроцедуры

// Отзыв доверия — пункт ⚙ записи окном по адресу: подтверждений на каждую запись заранее
// не печатают, прежних признаков confirm() нет.
&Тест
Процедура ОтзывВМенюЗаписиОкномПоАдресу() Экспорт

	Сервис.Добавить(7, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"", "refs/heads/main", "segate");

	Разметка = Список();

	Ожидаем.Что(Разметка, "пункт ведёт на подтверждение этой записи")
		.Содержит(СтрЗаменить(Новый ПараметрыСсылки().Установить(АдресРаздела(), "окно", "удалить-7"), "&", "&amp;"));
	Ожидаем.Что(Разметка, "прежних признаков confirm() нет").Не_().Содержит("data-confirm-value");

КонецПроцедуры

#КонецОбласти

#Область ИмяЗаписи

// Вопрос перед снятием доверия называет репозиторий один раз, хотя каноническое значение
// конвейера GitHub НАЧИНАЕТСЯ с самого репозитория.
&Тест
Процедура ВопросОСнятииНеПовторяетИмяРепозиторияДважды() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"acme/lib/.github/workflows/release.yml", "refs/heads/main", "segate");

	Вопрос = ВопросСнятия();

	Ожидаем.Что(СколькоРаз(Вопрос, "acme/lib"), "репозиторий назван один раз: " + Вопрос).Равно(1);
	Ожидаем.Что(Вопрос, "конвейер назван коротким именем").Содержит("acme/lib/release.yml");
	Ожидаем.Что(Вопрос, "реф записи виден").Содержит("@refs/heads/main");

КонецПроцедуры

// У GitLab каноническое значение начинается с ХОСТА и репозитория, а путь внутри проекта
// отделён «//» — в вопросе нет ни хоста, ни повтора репозитория, ни разделителя.
&Тест
Процедура ВопросОСнятииGitLabНеПовторяетНиХостаНиРепозитория() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.com", "acme/team/lib",
		"gitlab.com/acme/team/lib//.gitlab-ci.yml", "refs/heads/main", "maria");

	Вопрос = ВопросСнятия();

	Ожидаем.Что(СколькоРаз(Вопрос, "acme/team/lib"), "репозиторий назван один раз: " + Вопрос)
		.Равно(1);
	Ожидаем.Что(СтрНайти(Вопрос, "gitlab.com"), "хост издателя gitlab.com не сообщает ничего")
		.Равно(0);
	Ожидаем.Что(СтрНайти(Вопрос, "//"), "разделителя пути в имени не осталось").Равно(0);
	Ожидаем.Что(Вопрос, "конвейер назван").Содержит("acme/team/lib/.gitlab-ci.yml");

КонецПроцедуры

// На инсталляции из настройки хаба репозитории одноимённы, и различает записи ТОЛЬКО
// издатель: без него человека спрашивают про одно и то же дважды, а снимает он неизвестно что.
&Тест
Процедура ВопросОСнятииНаSelfHostedНазываетИздателя() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.com", "infra/deploy",
		"gitlab.com/infra/deploy//.gitlab-ci.yml", "refs/heads/main", "maria");
	Сервис.Добавить(2, "gitlab", "https://gitlab.acme.ru", "infra/deploy",
		"gitlab.acme.ru/infra/deploy//.gitlab-ci.yml", "refs/heads/main", "ops");

	Публичный = ВопросСнятия();
	Свой = ВопросСнятияПоНомеру(2);

	Ожидаем.Что(Свой, "имя записи своей инсталляции несёт её хост")
		.Содержит("gitlab.acme.ru/infra/deploy");
	Ожидаем.Что(Публичный = Свой, "две записи одного имени репозитория различимы").ЭтоЛожь();

КонецПроцедуры

// Вторая ось, по которой записи GitLab бывают разными: путь к конфигу задаёт настройка
// проекта, и конфиг может лежать в ЧУЖОМ проекте. Клейм называет его ДО «//», сверяется
// он отдельно от репозитория — значит и различать записи обязан.
&Тест
Процедура ВопросОСнятииНазываетЧужойПроектКонфигаGitLab() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.com", "acme/lib",
		"gitlab.com/acme/lib//.gitlab-ci.yml", "refs/heads/main", "maria");
	Сервис.Добавить(2, "gitlab", "https://gitlab.com", "acme/lib",
		"gitlab.com/other/compliance//.gitlab-ci.yml", "refs/heads/main", "ops");

	Свой = ВопросСнятия();
	Чужой = ВопросСнятияПоНомеру("2");

	Ожидаем.Что(Чужой, "конфиг чужого проекта назван вместе с проектом")
		.Содержит("other/compliance/.gitlab-ci.yml");
	Ожидаем.Что(Свой = Чужой,
		"две записи одного репозитория различимы: " + Свой + " / " + Чужой).ЭтоЛожь();
	// у своего проекта повторения нет
	Ожидаем.Что(СколькоРаз(Свой, "acme/lib"), "свой проект в имени не повторяется: " + Свой)
		.Равно(1);

КонецПроцедуры

// Ссылка ведёт туда, где файл ЛЕЖИТ, а не туда, где стоит запись: в репозитории записи
// конфига чужого проекта нет вовсе, и адрес на него открыл бы 404.
&Тест
Процедура СсылкаНаКонфигЧужогоПроектаВедётВЭтотПроект() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.com", "acme/lib",
		"gitlab.com/acme/lib//.gitlab-ci.yml", "refs/heads/main", "maria");
	Сервис.Добавить(2, "gitlab", "https://gitlab.com", "acme/lib",
		"gitlab.com/other/compliance//.gitlab-ci.yml", "refs/heads/main", "ops");

	Разметка = Список();

	Ожидаем.Что(Разметка, "конфиг чужого проекта открывается в этом проекте").Содержит(
		"href=""https://gitlab.com/other/compliance/-/blob/main/.gitlab-ci.yml""");
	// у своей записи адрес на свой проект, и он ровно один: подстановка репозитория записи
	// обеим строкам дала бы этот адрес дважды
	Ожидаем.Что(СколькоРаз(Разметка,
			"href=""https://gitlab.com/acme/lib/-/blob/main/.gitlab-ci.yml"""),
		"адрес своего конфига стоит ровно у своей записи").Равно(1);

КонецПроцедуры

// Хост клейма не совпал с издателем — разобрать проект нечем. Молча подставить свой
// репозиторий значит стереть разницу между записями и выдумать место файла.
&Тест
Процедура НеразобранныйКонвейерGitLabОстаётсяЦеликомИБезСсылкиНаФайл() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.com", "acme/lib",
		"other.example/acme/lib//.gitlab-ci.yml", "refs/heads/main", "maria");
	Сервис.Добавить(2, "gitlab", "https://gitlab.com", "acme/lib",
		"other.example/other/compliance//.gitlab-ci.yml", "refs/heads/main", "ops");

	Разметка = Список();
	Первый = ВопросСнятия();
	Второй = ВопросСнятияПоНомеру("2");

	Ожидаем.Что(Первый = Второй,
		"записи различимы: " + Первый + " / " + Второй).ЭтоЛожь();
	// имя целиком, без приставки из пустоты: место файла неизвестно, и «/» перед ним
	// читалось бы как проект с пустым именем
	Ожидаем.Что(Первый, "каноническое значение показано целиком")
		.Содержит("«gitlab:acme/lib/other.example/acme/lib//.gitlab-ci.yml@refs/heads/main»");
	Ожидаем.Что(СтрНайти(Разметка, "/-/blob/"),
		"ссылки на файл нет: где он лежит — неизвестно").Равно(0);

КонецПроцедуры

// На инсталляции из настройки хаба хост в клейме свой, и проект отбивается от него так же.
&Тест
Процедура ЧужойПроектКонфигаSelfHostedНазванБезХоста() Экспорт

	Сервис.Добавить(1, "gitlab", "https://gitlab.acme.ru", "infra/deploy",
		"gitlab.acme.ru/platform/ci-templates//.gitlab-ci.yml", "refs/heads/main", "ops");

	Вопрос = ВопросСнятия();

	Ожидаем.Что(Вопрос, "проект конфига назван").Содержит("platform/ci-templates/.gitlab-ci.yml");
	Ожидаем.Что(СколькоРаз(Вопрос, "gitlab.acme.ru"),
		"хост инсталляции назван один раз — уточнением издателя: " + Вопрос).Равно(1);

КонецПроцедуры

// Пустой конвейер означает «любой конвейер репозитория»: имени файла в записи нет,
// и выдумывать его нечем — хвост просто не печатается.
&Тест
Процедура ЗаписьБезКонвейераНазванаРепозиториемИРефом() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib",
		"", "refs/heads/main", "segate");

	Ожидаем.Что(ВопросСнятия(), "имя записи без конвейера")
		.Содержит("github:acme/lib@refs/heads/main");

КонецПроцедуры

#КонецОбласти

#Область ГотовыйКонвейер

// Хаб сверяет клейм aud с настройкой oshub.publish.ci.audience, а адрес хаба берёт только
// при пустой настройке. Сниппет обязан печатать ТО ЖЕ значение: адрес хаба вместо него дал бы
// пайплайн с гарантированным отказом.
&Тест
Процедура СниппетПечатаетЭффективнуюАудиториюАНеАдресХаба() Экспорт

	Сервис.ЗадатьАудиторию("openhub-prod");

	Разметка = Сниппеты("https://hub.example.org");

	Ожидаем.Что(Разметка, "GitHub Actions заказывает токен на аудиторию хаба")
		.Содержит("audience: openhub-prod");
	Ожидаем.Что(Разметка, "GitLab CI — на неё же").Содержит("aud: openhub-prod");
	Ожидаем.Что(СтрНайти(Разметка, "audience: https://hub.example.org"),
		"адрес хаба в audience не подставлен").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "aud: https://hub.example.org"),
		"и в aud тоже").Равно(0);
	// адрес хаба при этом на месте: он нужен самому push
	Ожидаем.Что(Разметка, "адрес хаба остался у публикации")
		.Содержит("hub: https://hub.example.org");

КонецПроцедуры

// Без аудитории доверенные конвейеры не публикуют вовсе — показывать нечего, и сниппет
// с пустой строкой обманул бы дважды.
&Тест
Процедура БезАудиторииВместоСниппетаОбъяснение() Экспорт

	Сервис.ЗадатьАудиторию("");

	Разметка = Сниппеты("https://hub.example.org");

	Ожидаем.Что(СтрНайти(Разметка, "audience:"), "пустого audience в разметке нет").Равно(0);
	Ожидаем.Что(Разметка, "названа причина").Содержит("не знает, для кого");

КонецПроцедуры

// Конвейер и форма заведения на ОДНОМ экране говорят одно: конвейер запускается по тегам —
// значит поле «реф» предлагает ту же маску, а вид рефа стоит на «тег». Значения берутся
// только из ВЫДАННОЙ разметки — ни маска, ни вид рефа в тесте не названы.
&Тест
Процедура ФормаПредлагаетТоЖеЧемЗапускаетсяГотовыйКонвейер() Экспорт

	Сервис.ЗадатьАудиторию("openhub-prod");

	Запуск = ЗапускКонвейера(Сниппеты("https://hub.example.org"));
	Форма = РазметкаФормы();

	Ожидаем.Что(Запуск.Вид, "готовый конвейер запускается по тегам").Равно("тег");
	Ожидаем.Что(Плейсхолдер(Форма, "реф"),
		"поле «реф» предлагает маску запуска конвейера").Равно(Запуск.Маска);
	Ожидаем.Что(ВыбранныйВариант(Форма, "вид_рефа"),
		"и вид рефа стоит на том, чем конвейер запускается").Равно(Запуск.Вид);

	// маска — не «любой тег»: посторонний тег дал бы запуск конвейера и отказ 403. Судим ТЕМ ЖЕ
	// языком масок, каким хаб судит клейм ref, а образец имени берём из САМОЙ маски
	Маски = Новый МаскаРефа();
	Ожидаем.Что(Маски.Совпадает(Запуск.Маска, ПримерИмени(Запуск.Маска)),
		"тег релиза под маску подходит").ЭтоИстина();
	Ожидаем.Что(Маски.Совпадает(Запуск.Маска, "test"),
		"а посторонний тег — нет").ЭтоЛожь();

КонецПроцедуры

// Публикуется ТА версия, которую пометили тегом. Выбор файла первым по алфавиту
// («changelog-reader-0.10.0.ospx» встаёт раньше «-0.9.0») публиковал бы соседнюю сборку,
// а хаб подмены не увидел бы: он сверяет FILE-NAME с манифестом ПРИСЛАННОГО файла.
&Тест
Процедура ГотовыйКонвейерБерётФайлПоТегуАНеПервыйПоАлфавиту() Экспорт

	Сервис.ЗадатьАудиторию("openhub-prod");

	Разметка = Сниппеты("https://hub.example.org");

	Ожидаем.Что(СтрНайти(Разметка, "head -n 1"),
		"файл не выбирается первым попавшимся из каталога").Равно(0);
	Ожидаем.Что(Разметка, "имя файла собрано из тега GitHub").Содержит("GITHUB_REF_NAME#v");
	Ожидаем.Что(Разметка, "и из тега GitLab").Содержит("CI_COMMIT_TAG#v");
	Ожидаем.Что(СколькоРаз(Разметка, "${package}-${version}.ospx"),
		"оба конвейера шлют файл ровно этой версии").Равно(2);
	// расхождение тега и версии в packagedef обязано падать в CI, а не публиковаться молча
	Ожидаем.Что(СколькоРаз(Разметка, "exit 1"), "и оба падают, если такой сборки нет").Равно(2);

КонецПроцедуры

// Версия opm — одна на оба конвейера: разъехавшись, они собирали бы пакет по-разному.
&Тест
Процедура ОбаКонвейераСтавятОднуВерсиюOpm() Экспорт

	Сервис.ЗадатьАудиторию("openhub-prod");
	Ожидаемая = "opm@" + Новый СниппетыКонвейеров(Неопределено, Новый ВидРефаДоверия()).ВерсияOpm();

	Разметка = Сниппеты("https://hub.example.org");

	Ожидаем.Что(СколькоРаз(Разметка, "opm install " + Ожидаемая),
		"шаг установки opm есть в обоих конвейерах").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область Двери

// Окно «Доверить конвейеру» — по адресу ?окно=новый: тип репозитория сегментами, поле конвейера
// в наборе своего типа. Без адреса окно закрыто; подтверждения несуществующей записи нет.
&Тест
Процедура ОкноЗаведенияОткрываетсяПоАдресу() Экспорт

	Окно = ОткрытоеОкно(Получить("новый").ТелоТекст);

	Ожидаем.Что(Окно, "окно заведения открыто").Заполнено();
	Ожидаем.Что(Окно, "тип репозитория — сегментами").Содержит("data-segment=""gitlab""");
	Ожидаем.Что(Окно, "конвейер GitHub — в своём наборе").Содержит("name=""конвейер""");
	Ожидаем.Что(Окно, "конвейер GitLab — своим именем").Содержит("name=""конвейер_gitlab""");
	Ожидаем.Что(Окно, "открытое окно закрывает ссылка на раздел").Содержит("href=""" + АдресРаздела() + """");
	Ожидаем.Что(ОткрытоеОкно(Получить("").ТелоТекст), "без адреса окно закрыто").Равно("");
	Ожидаем.Что(ОткрытоеОкно(Получить("удалить-99").ТелоТекст), "чужой записи окна нет").Равно("");

КонецПроцедуры

// Заведение берёт поле конвейера из набора пришедшего типа и уводит 303 в раздел.
&Тест
Процедура ЗаведениеЗаводитЗаписьИВедётВРаздел() Экспорт

	Ответ = Отправить(ФормаЗаведения("gitlab", "acme/team/lib", "v*") + "&конвейер=чужое.yml");

	Ожидаем.Что(Ответ.Код, "заведено — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "в раздел с отметкой").Равно(АдресРаздела() + "?saved=1");
	Ожидаем.Что(Сервис.Заведённые().Количество(), "запись заведена").Равно(1);
	Ожидаем.Что(Сервис.Заведённые()[0].Провайдер, "тип — из сегментов").Равно("gitlab");
	Ожидаем.Что(Сервис.Заведённые()[0].Конвейер, "конвейер — из набора GitLab, а не GitHub")
		.Равно(".gitlab-ci.yml");

КонецПроцедуры

// Пустое обязательное поле и отказ домена возвращают ТО ЖЕ окно открытым, с набранным
// и отказом у поля либо над полями; записи нет.
&Тест
Процедура ОтказЗаведенияОстаётсяВОкне() Экспорт

	Пустое = Отправить(ФормаЗаведения("github", "", "v*"));
	Ожидаем.Что(Пустое.Код, "без репозитория — 400").Равно(400);
	Ожидаем.Что(ОткрытоеОкно(Пустое.ТелоТекст), "окно открыто, поле помечено").Содержит("aria-invalid");

	Сервис.ОтбитьЗаведение("издатель не из списка хаба");
	Отбитое = Отправить(ФормаЗаведения("github", "acme/lib", "v*"));
	Окно = ОткрытоеОкно(Отбитое.ТелоТекст);
	Ожидаем.Что(Отбитое.Код, "отказ домена — 400").Равно(400);
	Ожидаем.Что(Окно, "причина в окне").Содержит("издатель не из списка хаба");
	Ожидаем.Что(Окно, "набранное на месте").Содержит("value=""acme/lib""");
	Ожидаем.Что(Сервис.Заведённые().Количество(), "записи нет").Равно(0);

КонецПроцедуры

// Разбор ссылки записи не заводит: разобранное встаёт в поля того же окна, ответ 422.
&Тест
Процедура РазборСсылкиЗаполняетОкноБезЗаписи() Экспорт

	Ответ = Отправить("операция=разобрать&конвейер_gitlab=&ссылка="
		+ Закодировать("https://github.com/acme/lib/blob/main/.github/workflows/release.yml"));
	Окно = ОткрытоеОкно(Ответ.ТелоТекст);

	Ожидаем.Что(Ответ.Код, "разбор — 422, окно остаётся").Равно(422);
	Ожидаем.Что(Окно, "репозиторий из ссылки").Содержит("value=""acme/lib""");
	Ожидаем.Что(Окно, "реф из ссылки").Содержит("value=""main""");
	Ожидаем.Что(Сервис.Заведённые().Количество(), "записи нет").Равно(0);

КонецПроцедуры

// Формы старой вкладки — отзыв операцией раздела и заведение без поля конвейера GitLab — ничего
// не меняют: 400 «Страница устарела».
&Тест
Процедура ФормаСтаройВкладкиОтбиваетсяБезМутации() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib", "", "v*", "segate");

	Отзыв = Отправить("операция=отозвать&доверие=1&подтверждение=1");
	Ожидаем.Что(Отзыв.Код, "старый отзыв — 400").Равно(400);
	Ожидаем.Что(Отзыв.ТелоТекст, "причина названа").Содержит("Страница устарела");
	Ожидаем.Что(ОткрытоеОкно(Отзыв.ТелоТекст), "форма не из окна — причина над разделом, окна нет")
		.Равно("");

	Заведение = Отправить("операция=доверить&провайдер=gitlab&репозиторий=acme/lib&конвейер=x.yml&реф=v*");
	Ожидаем.Что(Заведение.Код, "старое заведение — 400").Равно(400);

	Ожидаем.Что(Сервис.СтрокиПакета(Неопределено).Количество(), "запись цела").Равно(1);
	Ожидаем.Что(Сервис.Журнал().Количество(), "домен не тронут").Равно(0);

КонецПроцедуры

// Отзыв без поля подтверждения (без скрипта) — 303 на окно, запись цела; подтверждённый — записи
// нет; чужая запись — 404.
&Тест
Процедура ОтзывСпрашиваетПодтверждениеПоАдресу() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib", "", "v*", "segate");

	Без = Удалить("1", "");
	Ожидаем.Что(Без.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(Без.ПутьРедиректа), "на окно подтверждения записи")
		.Равно(АдресРаздела() + "?окно=удалить-1");
	Ожидаем.Что(Сервис.СтрокиПакета(Неопределено).Количество(), "запись цела").Равно(1);

	Окно = ОткрытоеОкно(Получить("удалить-1").ТелоТекст);
	Ожидаем.Что(Окно, "подтверждение называет запись").Содержит("acme/lib");
	Ожидаем.Что(Окно, "и шлёт подтверждение на адрес записи").Содержит("/settings/ci/1/delete");

	Ожидаем.Что(Удалить("99", "confirmed=1").Код, "чужая запись — 404").Равно(404);
	Ответ = Удалить("1", "confirmed=1");
	Ожидаем.Что(Ответ.Код, "отозвано — 303").Равно(303);
	Ожидаем.Что(Сервис.СтрокиПакета(Неопределено).Количество(), "записи нет").Равно(0);

КонецПроцедуры

// Кого гвард не впустил, тот не заводит и не отзывает: ни мутации, ни перенаправления, ни тела.
// КОНТРОЛЬ: впущенный той же формой заводит.
&Тест
Процедура ДвериНеТрогаютДоменТогоКогоГвардНеВпустил() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib", "", "v*", "segate");

	Гвард.Отказать();
	Ответы = Новый Массив();
	Ответы.Добавить(Отправить(ФормаЗаведения("github", "evil/lib", "**")));
	Ответы.Добавить(Отправить("операция=разобрать&конвейер_gitlab=&ссылка=x"));
	Ответы.Добавить(Удалить("1", "confirmed=1"));

	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(Ответ.ПутьРедиректа, "посторонний никуда не перенаправлен").Равно("");
		Ожидаем.Что(Строка(Ответ.ТелоТекст), "и тела ему не отдано").Равно("");
	КонецЦикла;
	Ожидаем.Что(Сервис.Журнал().Количество(), "домен не тронут").Равно(0);
	Ожидаем.Что(Сервис.СтрокиПакета(Неопределено).Количество(), "запись цела").Равно(1);

	// КОНТРОЛЬ: впущенный той же формой заводит
	Гвард.Впустить("alice", Новый Структура("Идентификатор, Имя", 3, "main"),
		Новый Структура("Идентификатор, Имя", 1, "lib"));
	Отправить(ФормаЗаведения("github", "evil/lib", "v*"));
	Ожидаем.Что(Сервис.Журнал().Количество(), "КОНТРОЛЬ: впущенный заводит").Равно(1);

КонецПроцедуры

// Гвард пакета впустил, а порог раздела («мейнтейнер пакета и выше») — нет: обе двери отвечают 403
// без мутации, журнал домена пуст. КОНТРОЛЬ: с открытым порогом тот же отзыв снимает запись.
&Тест
Процедура ПорогРазделаНеПустилДвериОтвечают403() Экспорт

	Сервис.Добавить(1, "github", "https://token.actions.githubusercontent.com", "acme/lib", "", "v*", "segate");

	Сервис.ЗакрытьПорог(Истина);
	Отзыв = Удалить("1", "confirmed=1");
	Заведение = Отправить(ФормаЗаведения("github", "evil/lib", "v*"));
	Страница = Получить("");
	Сервис.ЗакрытьПорог(Ложь);

	Ожидаем.Что(Отзыв.Код, "отзыв — 403").Равно(403);
	Ожидаем.Что(Заведение.Код, "заведение — 403").Равно(403);
	Ожидаем.Что(Страница.Код, "и страница раздела — 403").Равно(403);
	Ожидаем.Что(Отзыв.ПутьРедиректа, "никуда не перенаправлен").Равно("");
	Ожидаем.Что(Сервис.Журнал().Количество(), "домен не тронут").Равно(0);
	Ожидаем.Что(Сервис.СтрокиПакета(Неопределено).Количество(), "запись цела").Равно(1);

	// КОНТРОЛЬ: порог открыт — тот же отзыв запись снимает
	Ожидаем.Что(Удалить("1", "confirmed=1").Код, "КОНТРОЛЬ: отозвано — 303").Равно(303);
	Ожидаем.Что(Сервис.СтрокиПакета(Неопределено).Количество(), "КОНТРОЛЬ: записи нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Реестр записей без окна заведения — иначе поля окна читались бы как содержимое списка.
Функция Список()
	Возврат БезОкна(Отрисовать(0, "", Неопределено));
КонецФункции

Функция БезОкна(Знач Разметка)

	Начало = СтрНайти(Разметка, "<dialog");
	Если Начало = 0 Тогда
		Возврат Разметка;
	КонецЕсли;

	Конец = СтрНайти(Разметка, "</dialog>");
	Возврат Лев(Разметка, Начало - 1) + Сред(Разметка, Конец + СтрДлина("</dialog>"));

КонецФункции

// Окно «Доверить конвейеру» стоит в секции записей всегда — закрытым.
Функция РазметкаФормы()
	Возврат Отрисовать(0, "", Неопределено);
КонецФункции

// Чем запускается напечатанный конвейер: вид рефа и маска — из самого YAML, а не из класса сниппетов.
Функция ЗапускКонвейера(Знач Разметка)

	Текст = БезСущностей(Разметка);
	Позиция = СтрНайти(Текст, "on:");
	Ожидаем.Что(Позиция > 0, "в конвейере есть раздел запуска").ЭтоИстина();

	Вид = "";
	Если СтрНайти(Текст, "tags: [") > 0 Тогда
		Вид = "тег";
		Маска = МеждуМаркерами(Текст, "tags: ['", "']");
	Иначе
		Вид = "ветка";
		Маска = МеждуМаркерами(Текст, "branches: ['", "']");
	КонецЕсли;

	Ожидаем.Что(ЗначениеЗаполнено(Маска), "маска запуска прочитана: " + Вид).ЭтоИстина();
	Возврат Новый Структура("Вид, Маска", Вид, Маска);

КонецФункции

// Имя, которое маска обязана покрывать: звёзды маски заменены номером версии.
Функция ПримерИмени(Знач Маска)
	Возврат СтрЗаменить(Маска, "*", "1.2.3");
КонецФункции

Функция Плейсхолдер(Знач Разметка, Знач ИмяПоля)

	Позиция = СтрНайти(Разметка, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Позиция > 0, СтрШаблон("поле «%1» напечатано", ИмяПоля)).ЭтоИстина();
	Возврат МеждуМаркерами(Сред(Разметка, Позиция), "placeholder=""", """");

КонецФункции

// Что отправит браузер за <select>: значение варианта с пометкой selected.
Функция ВыбранныйВариант(Знач Разметка, Знач ИмяПоля)

	Позиция = СтрНайти(Разметка, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Позиция > 0, СтрШаблон("поле «%1» напечатано", ИмяПоля)).ЭтоИстина();

	Хвост = Сред(Разметка, Позиция);
	Конец = СтрНайти(Хвост, "</select>");
	Селектор = ?(Конец = 0, Хвост, Лев(Хвост, Конец));

	Для Каждого Кусок Из СтрРазделить(Селектор, "<") Цикл
		Если СтрНачинаетсяС(НРег(Кусок), "option") И СтрНайти(Кусок, " selected") > 0 Тогда
			Возврат МеждуМаркерами(Кусок, "value=""", """");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция МеждуМаркерами(Знач Текст, Знач Начало, Знач Конец)

	Позиция = СтрНайти(Текст, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Позиция + СтрДлина(Начало));
	Край = СтрНайти(Хвост, Конец);
	Возврат ?(Край = 0, "", Лев(Хвост, Край - 1));

КонецФункции

// YAML уезжает на страницу экранированным: кавычки конвейера — это &#39; и &quot;.
Функция БезСущностей(Знач Разметка)

	Текст = СтрЗаменить(Разметка, "&#39;", "'");
	Текст = СтрЗаменить(Текст, "&quot;", """");
	Текст = СтрЗаменить(Текст, "&lt;", "<");
	Текст = СтрЗаменить(Текст, "&gt;", ">");
	Возврат СтрЗаменить(Текст, "&amp;", "&");

КонецФункции

Функция Сниппеты(Знач АдресХаба)
	Возврат Отрисовать(1, АдресХаба, Неопределено);
КонецФункции

// Секции идут списком: 0 — записи доверия (в ней же окна), 1 — готовый конвейер. Секция печатается
// в доме пакета, открытом на разделе «ci»: формы окон берут адрес и токен у дома.
Функция Отрисовать(Знач Номер, Знач АдресХаба, Знач Окно)

	Параметры = Новый Структура();
	Параметры.Вставить("Пул", Новый Структура("Имя", "main"));
	Параметры.Вставить("Пакет", Новый Структура("Имя, Идентификатор", "lib", 1));
	Параметры.Вставить("Адрес", АдресРаздела());
	Параметры.Вставить("АдресХаба", АдресХаба);
	Параметры.Вставить("Окно", Окно);

	Дом = UI.Кит.ДомНастроек("Настройки пакета", "/pools/main/packages/lib/settings", "csrf",
		Витрина.Секции(Параметры)[Номер]);
	Дом.Раздел("Доверенная публикация", "ci").Текущий();
	Возврат Дом.Рендер();

КонецФункции

Функция АдресРаздела()
	Возврат "/pools/main/packages/lib/settings/ci";
КонецФункции

Функция ВопросСнятия()
	Возврат ВопросСнятияПоНомеру("1");
КонецФункции

// Заголовок подтверждения отзыва записи с этим номером, открытого по адресу.
Функция ВопросСнятияПоНомеру(Знач Идентификатор)

	Разметка = ОткрытоеОкно(Отрисовать(0, "", Окна.Открытое("удалить", Строка(Идентификатор))));
	Начало = СтрНайти(Разметка, "class=""modal__title""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Разметка, Начало);
	Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</h2>") - 1);

КонецФункции

// Первое окно страницы, напечатанное открытым: <dialog …open> до своего </dialog>.
Функция ОткрытоеОкно(Знач HTML)

	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Возврат "";
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Если СтрНайти(Лев(Окно, СтрНайти(Окно, ">")), " open") > 0 Тогда
			Возврат Окно;
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;

КонецФункции

Функция Получить(Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, "main", "lib", Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

Функция Отправить(Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, "main", "lib", Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

Функция Удалить(Знач Номер, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Удаление(Ответ, "main", "lib", Номер, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

// Форма окна «Доверить конвейеру», как её шлёт браузер: поля обоих наборов типа уходят вместе.
Функция ФормаЗаведения(Знач Провайдер, Знач Репозиторий, Знач Реф)
	Возврат СтрШаблон("операция=доверить&провайдер=%1&репозиторий=%2&конвейер_gitlab=.gitlab-ci.yml"
		+ "&реф=%3&вид_рефа=tag&издатель=&ссылка=", Провайдер, Закодировать(Репозиторий), Закодировать(Реф));
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция СколькоРаз(Знач Текст, Знач Фрагмент)

	Сколько = 0;
	Позиция = СтрНайти(Текст, Фрагмент);
	Смещение = 0;
	Пока Позиция > 0 Цикл
		Сколько = Сколько + 1;
		Смещение = Смещение + Позиция + СтрДлина(Фрагмент) - 1;
		Позиция = СтрНайти(Сред(Текст, Смещение + 1), Фрагмент);
	КонецЦикла;
	Возврат Сколько;

КонецФункции

#КонецОбласти
