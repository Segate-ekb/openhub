// Адреса дома пакета в настоящем маршрутизаторе winow: литерал без своего действия перекрывает
// шаблон на том же уровне без отката, поэтому куда уходит каждый адрес — стережёт таблица маршрутов,
// а не вызов метода контроллера.

#Использовать asserts
#Использовать "../фикстуры"

Перем Маршруты;   // фикстура МаршрутыХаба — таблица маршрутов хаба в маршрутизаторе winow

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("МаршрутыХаба");
КонецПроцедуры

&ПередВсеми
Процедура СобратьМаршруты() Экспорт
	Маршруты = Новый МаршрутыХаба(КаталогиПроекта.Модули());
КонецПроцедуры

&Тест
Процедура ФормаКарточкиИПометкиУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик(Дом(), "Обзор");
	ПроверитьОбработчик(Дом() + "/card", "Раздел");
	ПроверитьОбработчик(Дом() + "/card/hidden", "ПометкаКаталога");
	ПроверитьОбработчик(Дом() + "/card/deprecated", "ПометкаКаталога");

КонецПроцедуры

// Подадреса разделов со своими литералами шаблон пометки не перехватывает.
&Тест
Процедура ЛитеральныеРазделыДомаНеПерехватываются() Экспорт

	ПроверитьОбработчик(Дом() + "/ci", "", "КонтроллерДоверияCI");
	ПроверитьОбработчик(Дом() + "/webhooks", "", "КонтроллерПодписокПакета");
	ПроверитьОбработчик(Дом() + "/webhooks/test", "", "КонтроллерПодписокПакета");
	ПроверитьОбработчик(Дом() + "/webhooks/7/save", "", "КонтроллерПодписокПакета");

КонецПроцедуры

// Раздел «Теги» — свой контроллер: литерал tags побеждает шаблоны раздела и пометки дома.
&Тест
Процедура РазделТеговУходитСвоемуКонтроллеру() Экспорт

	ПроверитьОбработчик(Дом() + "/tags", "Раздел", "КонтроллерТеговПакета");
	ПроверитьОбработчик(Дом() + "/tags/stable/save", "Сохранение", "КонтроллерТеговПакета");
	ПроверитьОбработчик(Дом() + "/tags/stable/delete", "Удаление", "КонтроллерТеговПакета");
	ПроверитьОбработчик(Дом() + "/tags/stable/disable", "Выключение", "КонтроллерТеговПакета");
	ПроверитьОбработчик(Дом() + "/tags/stable/enable", "Включение", "КонтроллерТеговПакета");

	// КОНТРОЛЬ: соседние разделы домов остаются у своих контроллеров
	ПроверитьОбработчик(Дом() + "/versions", "Раздел");

КонецПроцедуры

// Раздел «Доверенная публикация» — свой литерал ci: страница и отзыв записи уходят его контроллеру,
// а не шаблонам раздела и пометки дома; версии и опасная зона остаются у дома.
&Тест
Процедура ДовериеCIУходитСвоемуКонтроллеру() Экспорт

	ПроверитьОбработчик(Дом() + "/ci", "Раздел", "КонтроллерДоверияCI");
	ПроверитьОбработчик(Дом() + "/ci/5/delete", "Удаление", "КонтроллерДоверияCI");

	// КОНТРОЛЬ: соседние разделы дома — у дома
	ПроверитьОбработчик(Дом() + "/versions", "Раздел");
	ПроверитьОбработчик(Дом() + "/danger", "Раздел");

КонецПроцедуры

Функция Дом()
	Возврат "/pools/corp/packages/cron-tasks/settings";
КонецФункции

Процедура ПроверитьОбработчик(Знач Путь, Знач Метод, Знач Контроллер = "КонтроллерДомаПакета")

	Обработчик = Маршруты.Обработчик(Путь);
	Ожидаем.Что(Обработчик <> Неопределено, "адрес обслуживается: " + Путь).ЭтоИстина();
	Ожидаем.Что(Обработчик.Контроллер, "контроллер адреса " + Путь).Равно(Контроллер);
	Если ЗначениеЗаполнено(Метод) Тогда
		Ожидаем.Что(Обработчик.Метод, "точка маршрута адреса " + Путь).Равно(Метод);
	КонецЕсли;

КонецПроцедуры
