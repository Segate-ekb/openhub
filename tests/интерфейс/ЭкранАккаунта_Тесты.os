// Дом «Аккаунт»: привязки OIDC — отвязка окном по адресу только с подтверждением, последний способ
// входа не отвязывается, чужая личность не трогается; профиль и пароль — отказ под полем; каждая
// дверь стережётся гвардом. Настоящими контроллерами поверх настоящих служб входа в контейнере.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Принципалы;     // фикстура СтендПринципалов
Перем Гвард;          // ГвардПринципалаЗаглушка — впускает учётку либо никого
Перем ПарольныйВход;  // ФейкПарольногоВхода — открыт ли вход паролем
Перем Привязки;       // КонтроллерЛичностейКабинета
Перем ДомАккаунта;    // КонтроллерДомаАккаунта

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	// транспорт письма подменяется до модуля почты: настоящий SMTP-отправитель носит то же прозвище,
	// а его библиотеки в наборе нет — смена адреса выпускает письмо подтверждения через фейк
	РеестрФикстур.Подключить("ФейкОтправителяПисем");
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	Для Каждого ФайлКласса Из НайтиФайлы(ОбъединитьПути(Модули, "почта", "Классы"), "*.os", Истина) Цикл
		Если ФайлКласса.ИмяБезРасширения <> "ОтправительПисемSMTP" Тогда
			ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Слои.Подключить("уведомления, вход, права, настройки, гео, сеть, интерфейс/общее,"
		+ " интерфейс/панели/страна");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ДомАккаунта,ВитринаЛичностейКабинета,ВитринаПодтвержденияАдреса,"
		+ "ТекстыОтказовПодтверждения,ПодсказкаПароля", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

	Для Каждого Фикстура Из СтрРазделить("НастройкиЗаглушка, ЗаписывающийПодписчик, ФейкЖурналЗамка,"
		+ " ЛовушкаЛога, ГвардПринципалаЗаглушка, ЗащитаCSRFЗаглушка, ОтветСтраницыЗаглушка, КукиЗаглушка,"
		+ " ФейкПарольногоВхода, СборкаUI", ",") Цикл
		РеестрФикстур.Подключить(СокрЛП(Фикстура));
	КонецЦикла;

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-аккаунта-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Гвард = Новый ГвардПринципалаЗаглушка();
	ПарольныйВход = Новый ФейкПарольногоВхода(Истина);

	// контроллеры — типом после сборки: ОСень не должна видеть их аннотации
	ПоискКлассов.Подключить(Интерфейс, "КонтроллерЛичностейКабинета");
	ПоискКлассов.Подключить(Интерфейс, "КонтроллерДомаАккаунта");

	UI = Новый СборкаUI().Собрать(Интерфейс);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Желудь("СервисПрав"), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));

	// старт привязки уходит к провайдеру — в этом наборе его нет, двери старта не открываются
	Привязки = Новый КонтроллерЛичностейКабинета(Гвард, Защита, Гейт, Желудь("РазборФормы"),
		Желудь("СервисЛичностей"), Неопределено, Желудь("СервисПользователей"), ПарольныйВход,
		Неопределено, Неопределено, Желудь("КонфигурацияOIDC"), Ответы, Желудь("ДомАккаунта"),
		Желудь("ВитринаЛичностейКабинета"), Желудь("ОкноРаздела"), Желудь("ГейтВходаПоСтране"),
		Желудь("ПосетительЗапроса"), Желудь("ОтказПоСтране"), Желудь("ТекстыИнтерфейса"));

	// права, вид и язык в этом наборе не открываются
	ДомАккаунта = Новый КонтроллерДомаАккаунта(Гвард, Ответы, Желудь("ТекстСбоя"), Желудь("ДомАккаунта"),
		Желудь("Кит"), Гейт, Защита, Желудь("РазборФормы"), Желудь("СервисПользователей"),
		Желудь("СменаАдресаУчётки"), Желудь("ВитринаПодтвержденияАдреса"), Желудь("ОтказыУчётки"),
		Желудь("ПолитикаПароля"), Желудь("ПодсказкаПароля"), ПарольныйВход, Неопределено, Неопределено,
		Неопределено, Желудь("ТекстыИнтерфейса"), Желудь("ОтметкаСохранения"), Желудь("ОкноРаздела"));

КонецПроцедуры

&ПослеКаждого
Процедура ВернутьСтенд() Экспорт
	ПарольныйВход.Установить(Истина);
КонецПроцедуры

#Область Отвязка

// Окно отвязки по адресу — подтверждение с номером личности и формой на дверь отвязки;
// ⚙ строки ведёт на этот адрес, без параметра окна открытых окон нет.
&Тест
Процедура ОкноОтвязкиПоАдресуПечатаетсяОткрытым() Экспорт

	Владелец = Учётка("lnk");
	Номер = Номер(Привязать(Владелец));

	Открытые = ОткрытыеОкна(ПолучитьПривязки("отвязать-" + Номер).ТелоТекст);

	Ожидаем.Что(Открытые.Количество(), "открыто ровно одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это подтверждение").Содержит("modal--confirm");
	Ожидаем.Что(Открытые[0], "форма — на дверь отвязки").Содержит("action=""/me/settings/oidc/unlink""");
	Ожидаем.Что(Открытые[0], "и несёт номер личности").Содержит("value=""" + Номер + """");

	Раздел = ПолучитьПривязки("").ТелоТекст;
	Ожидаем.Что(ОткрытыеОкна(Раздел).Количество(), "КОНТРОЛЬ: без ?окно= окна закрыты").Равно(0);
	Ожидаем.Что(Раздел, "⚙ строки ведёт на окно отвязки")
		.Содержит(Закодировать("окно") + "=" + Закодировать("отвязать-" + Номер));

КонецПроцедуры

// Строка личности несёт значок провайдера: бренд — по издателю, незнакомый издатель — глиф «ключ».
&Тест
Процедура ЛичностьПечатаетсяСоЗначкомИздателя() Экспорт

	Владелец = Учётка("ico");
	Желудь("СервисЛичностей").Привязать(Владелец.Идентификатор, "https://gitlab.com",
		"sub-" + УникальныеИмена.Хвост(), "", "gl" + УникальныеИмена.Хвост());
	Привязать(Владелец);

	Раздел = ПолучитьПривязки("").ТелоТекст;
	Ожидаем.Что(Раздел, "издатель GitLab — с логотипом GitLab")
		.Содержит(Желудь("Иконка").Отрисовать("бренд:gitlab") + " https://gitlab.com");
	Ожидаем.Что(Раздел, "незнакомый издатель — с глифом «ключ»")
		.Содержит(Желудь("Иконка").Отрисовать("ключ") + " https://idp.example.org");

КонецПроцедуры

// Личность настроенного провайдера несёт выбранный у него значок, а не угаданный по хосту; издатель
// провайдера с хвостовой косой чертой — тот же издатель. Кнопка привязки — с тем же значком.
&Тест
Процедура ЛичностьПровайдераНесётВыбранныйЗначок() Экспорт

	Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Новый Структура(
		"Имя, Издатель, ИдентификаторКлиента, АдресВозврата, Значок", "corp" + УникальныеИмена.Хвост(),
		"https://sso.corp.example/", "cid", "https://hub.example.com/cb", "бренд:okta"));
	Владелец = Учётка("okt");
	Желудь("СервисЛичностей").Привязать(Владелец.Идентификатор, "https://sso.corp.example",
		"sub-" + УникальныеИмена.Хвост(), "", "okt" + УникальныеИмена.Хвост());

	Окта = Желудь("Иконка").Отрисовать("бренд:okta");
	Раздел = ПолучитьПривязки("").ТелоТекст;
	Ожидаем.Что(Раздел, "издатель провайдера — с его выбранным значком").Содержит(Окта + " https://sso.corp.example");
	Ожидаем.Что(СтрЧислоВхождений(Раздел, Сред(Окта, СтрНайти(Окта, ">"))), "и кнопка привязки").Больше(1);

КонецПроцедуры

// Без скрипта форма уходит из меню без вопроса: личность цела, ответ ведёт на окно.
&Тест
Процедура ОтвязкаБезПодтвержденияВедётНаОкно() Экспорт

	Владелец = Учётка("ask");
	Номер = Номер(Привязать(Владелец));

	Ответ = Отвязать("личность=" + Номер);

	Ожидаем.Что(Ответ.Код, "перенаправление").Равно(303);
	Ожидаем.Что(Раскодировать(Ответ.ПутьРедиректа), "на окно отвязки")
		.Равно("/me/settings/oidc?окно=отвязать-" + Номер);
	Ожидаем.Что(Личностей(Владелец), "личность цела").Равно(1);

КонецПроцедуры

&Тест
Процедура ПодтверждённаяОтвязкаСнимаетЛичность() Экспорт

	Владелец = Учётка("del");
	Номер = Номер(Привязать(Владелец));

	Ответ = Отвязать("личность=" + Номер + "&confirmed=1");

	Ожидаем.Что(Ответ.Код, "удача — перенаправление").Равно(303);
	Ожидаем.Что(СтрНачинаетсяС(Ответ.ПутьРедиректа, "/me/settings/oidc?"), "на раздел: " + Ответ.ПутьРедиректа)
		.ЭтоИстина();
	Ожидаем.Что(Личностей(Владелец), "личности нет").Равно(0);

КонецПроцедуры

// Вход паролем выключен — единственная личность и есть способ входа: окно называет причину
// и формы отвязки не несёт, подтверждённая отправка — 409 без изменений. КОНТРОЛЬ — при открытом
// входе паролем та же личность отвязывается.
&Тест
Процедура ПоследнийСпособВходаНеОтвязывается() Экспорт

	Владелец = Учётка("last");
	Номер = Номер(Привязать(Владелец));
	ПарольныйВход.Установить(Ложь);

	Окно = ОткрытыеОкна(ПолучитьПривязки("отвязать-" + Номер).ТелоТекст);
	Ожидаем.Что(Окно.Количество(), "окно открыто").Равно(1);
	Ожидаем.Что(Окно[0], "причина названа").Содержит("последний способ входа");
	Ожидаем.Что(СтрНайти(Окно[0], "/oidc/unlink"), "формы отвязки в окне нет").Равно(0);

	Ответ = Отвязать("личность=" + Номер + "&confirmed=1");
	Ожидаем.Что(Ответ.Код, "отвязка последнего способа — 409").Равно(409);
	Ожидаем.Что(Ответ.ТелоТекст, "причина названа").Содержит("последний способ входа");
	Ожидаем.Что(Личностей(Владелец), "личность цела").Равно(1);

	ПарольныйВход.Установить(Истина);
	Отвязать("личность=" + Номер + "&confirmed=1");
	Ожидаем.Что(Личностей(Владелец), "КОНТРОЛЬ: при входе паролем отвязывается").Равно(0);

КонецПроцедуры

// Чужую личность форма не отвязывает и её существование не раскрывает: ответ — к своему списку.
&Тест
Процедура ЧужаяЛичностьНеОтвязывается() Экспорт

	Чужой = Учётка("alien");
	Номер = Номер(Привязать(Чужой));
	Учётка("me");

	Ответ = Отвязать("личность=" + Номер + "&confirmed=1");

	Ожидаем.Что(Ответ.ПутьРедиректа, "к своему списку").Равно("/me/settings/oidc");
	Ожидаем.Что(Личностей(Чужой), "чужая личность цела").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ПрофильИПароль

// Занятый адрес — отказ под полем адреса с набранным в нём; адрес учётки прежний.
&Тест
Процедура ЗанятыйАдресОтбиваетсяПодПолем() Экспорт

	Занятый = "taken" + УникальныеИмена.Хвост() + "@example.org";
	Желудь("СервисПользователей").СоздатьПользователя("own" + УникальныеИмена.Хвост(), Занятый,
		"password123", "user");
	Владелец = Учётка("prof");

	Ответ = ОтправитьАккаунт("profile", "email=" + Закодировать(Занятый));

	Ожидаем.Что(Ответ.Код >= 400, "отказ, код " + Ответ.Код).ЭтоИстина();
	Поле = Тег(Ответ.ТелоТекст, "input", "name=""email""");
	Ожидаем.Что(Поле, "поле адреса отбито").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Поле, "набранное на месте").Содержит(Занятый);
	// метку поле получает от узла кита, экран забыть её не может: поле стоит внутри своей <label>
	// вместе с подписью и отказом
	Позиция = СтрНайти(Ответ.ТелоТекст, Поле);
	До = Лев(Ответ.ТелоТекст, Позиция - 1);
	Метка = Сред(До, СтрНайти(До, "<label", НаправлениеПоиска.СКонца));
	Ожидаем.Что(СтрНайти(Метка, "</label>"), "поле внутри своей метки").Равно(0);
	Ожидаем.Что(Метка, "с подписью поля").Содержит(Желудь("ТекстыИнтерфейса").Текст("settings.account.profile.email.label"));
	Ожидаем.Что(Строка(Обновлённая(Владелец).Email), "адрес учётки прежний").Не_().Равно(Занятый);

КонецПроцедуры

// Отказ смены пароля — под тем полем, что его вызвало; пароли обратно не печатаются.
&Тест
Процедура ОтказСменыПароляПодСвоимПолем() Экспорт

	Учётка("pwd");

	Неверный = ОтправитьАккаунт("security", "старый=wrongpass1&новый=NewPassw0rd1&повтор=NewPassw0rd1");
	Ожидаем.Что(Неверный.Код, "неверный текущий — 400").Равно(400);
	Ожидаем.Что(Тег(Неверный.ТелоТекст, "input", "name=""старый"""), "отказ под текущим паролем")
		.Содержит("aria-invalid=""true""");

	Повтор = ОтправитьАккаунт("security", "старый=password123&новый=NewPassw0rd1&повтор=Other0000x");
	Ожидаем.Что(Повтор.Код, "несовпавший повтор — 400").Равно(400);
	Ожидаем.Что(Тег(Повтор.ТелоТекст, "input", "name=""повтор"""), "отказ под повтором")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Тег(Повтор.ТелоТекст, "input", "name=""старый"""), "текущий не отбит")
		.Не_().Содержит("aria-invalid=""true""");

	Для Каждого Ответ Из Новый Структура("Неверный, Повтор", Неверный, Повтор) Цикл
		Для Каждого Пароль Из СтрРазделить("wrongpass1,NewPassw0rd1,password123,Other0000x", ",") Цикл
			Ожидаем.Что(СтрНайти(Ответ.Значение.ТелоТекст, Пароль),
				Ответ.Ключ + ": пароль " + Пароль + " не печатается").Равно(0);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Логин в профиле — поле только для чтения: оно печатается заблокированным, а значение, присланное
// в обход формы, не попадает ни в учётку, ни на экран — показывается действующий логин.
&Тест
Процедура ЛогинТолькоДляЧтенияНеПодделывается() Экспорт

	Пользователь = УчёткаСАдресом("ro");
	Логин = Строка(Пользователь.Логин);
	Поддельный = "forged" + УникальныеИмена.Хвост();

	Поле = Тег(ПолучитьАккаунт("profile").ТелоТекст, "input", "name=""логин""");
	Ожидаем.Что(Поле, "логин печатается").Содержит("value=""" + Логин + """");
	Ожидаем.Что(Поле, "заблокированным: с формой он не уходит").Содержит("disabled");

	Ответ = ОтправитьАккаунт("profile", "логин=" + Поддельный + "&email=" + Закодировать(Логин + "@example.org"));
	Ожидаем.Что(Ответ.Код < 400, "КОНТРОЛЬ: форма профиля принята, код " + Ответ.Код).ЭтоИстина();
	Ожидаем.Что(Строка(Обновлённая(Пользователь).Логин), "логин учётки прежний").Равно(Логин);

	Страница = ПолучитьАккаунт("profile").ТелоТекст;
	Ожидаем.Что(СтрНайти(Страница, Поддельный), "присланное в поле только для чтения на экран не вернулось").Равно(0);
	Ожидаем.Что(Тег(Страница, "input", "name=""логин"""), "показан действующий логин")
		.Содержит("value=""" + Логин + """");

КонецПроцедуры

// Форма профиля старой вкладки (ни операции, ни поля адреса) — отказ словами, адрес учётки не
// трогается: пустой адрес из чужой формы не снимает почту.
&Тест
Процедура ФормаСтаройВкладкиПрофиляОтбиваетсяБезМутации() Экспорт

	Пользователь = УчёткаСАдресом("old");
	Адрес = Строка(Пользователь.Email);

	Ответ = ОтправитьАккаунт("profile", "имя=прежнее-поле");
	Ожидаем.Что(Ответ.Код, "форма старой вкладки — 400").Равно(400);
	Ожидаем.Что(Ответ.ТелоТекст, "причина словами").Содержит(Желудь("ТекстыИнтерфейса").Текст("settings.account.error.form"));
	Ожидаем.Что(Строка(Обновлённая(Пользователь).Email), "адрес учётки цел").Равно(Адрес);

КонецПроцедуры

// Секрет не выходит из формы ни в разметку, ни в адрес: удачная смена пароля уводит на раздел
// без набранного в адресе, отбитая — печатает раздел без паролей (ни в полях, ни где-либо).
&Тест
Процедура ПарольНеВозвращаетсяНиВФормуНиВАдрес() Экспорт

	Учётка("sec");
	Новый_ = "Fresh" + УникальныеИмена.Хвост() + "x9";

	Отбитая = ОтправитьАккаунт("security", "старый=password123&новый=" + Новый_ + "&повтор=" + Новый_ + "q");
	Ожидаем.Что(Отбитая.Код, "КОНТРОЛЬ: несовпавший повтор отбит").Равно(400);
	Ожидаем.Что(СтрНайти(Отбитая.ТелоТекст, Новый_), "набранный пароль на страницу не вернулся").Равно(0);
	Ожидаем.Что(СтрНайти(Отбитая.ТелоТекст, "password123"), "текущий тоже").Равно(0);
	Ожидаем.Что(Строка(Отбитая.ПутьРедиректа), "отказ — страница, а не переход").Равно("");

	Удача = ОтправитьАккаунт("security", "старый=password123&новый=" + Новый_ + "&повтор=" + Новый_);
	Ожидаем.Что(ЗначениеЗаполнено(Удача.ПутьРедиректа), "КОНТРОЛЬ: смена удалась — переход на раздел")
		.ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Удача.ПутьРедиректа, "/me/settings/security"), "на раздел безопасности: "
		+ Удача.ПутьРедиректа).ЭтоИстина();
	Для Каждого Секрет Из СтрРазделить(Новый_ + ",password123", ",") Цикл
		Ожидаем.Что(СтрНайти(Удача.ПутьРедиректа, Секрет) + СтрНайти(Удача.ПутьРедиректа,
			КодироватьСтроку(Секрет, СпособКодированияСтроки.КодировкаURL)), "пароля в адресе нет").Равно(0);
	КонецЦикла;

КонецПроцедуры

// Неподтверждённый адрес: повтор письма — форма из одной кнопки в шапке секции на адрес раздела;
// она несёт операцию повтора и не несёт поля адреса — нажатие не сохраняет профиль. КОНТРОЛЬ —
// у подтверждённого адреса секции и формы повтора нет.
&Тест
Процедура ПовторПисьмаФормойИзОднойКнопкиНаАдресРаздела() Экспорт

	НастроитьПочту();
	УчёткаСАдресом("cnf");

	Форма = ФормаСКнопкой(ПолучитьАккаунт("profile").ТелоТекст, "Выслать письмо ещё раз");
	Ожидаем.Что(Форма, "форма повтора на странице").Не_().Равно("");
	Ожидаем.Что(Форма, "уходит на адрес раздела").Содержит("action=""/me/settings/profile""");
	Ожидаем.Что(Форма, "несёт операцию повтора").Содержит("name=""операция"" value=""выслать""");
	Ожидаем.Что(СтрНайти(Форма, "name=""email"""), "и не несёт поля адреса").Равно(0);

	Желудь("АдресУчётки").Подтвердить(УчёткаСАдресом("cnfok"));
	Ожидаем.Что(ФормаСКнопкой(ПолучитьАккаунт("profile").ТелоТекст, "Выслать письмо ещё раз"),
		"КОНТРОЛЬ: у подтверждённого адреса повтора нет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Гвард

// Каждую дверь дома «Аккаунт», которую правит этот набор, стережёт гвард: кого он не впустил, тот
// ни личность не отвязывает, ни адрес, ни пароль не меняет — 403 без тела. КОНТРОЛЬ — впущенный
// той же формой меняет адрес и отвязывает.
&Тест
Процедура ДвериНеМеняютНичегоТомуКогоГвардНеВпустил() Экспорт

	Владелец = Учётка("grd");
	Номер = Номер(Привязать(Владелец));
	Адрес = "grd" + УникальныеИмена.Хвост() + "@example.org";

	Гвард.НеВпускать();
	Ответы = Новый Массив();
	Ответы.Добавить(Отвязать("личность=" + Номер + "&confirmed=1"));
	Ответы.Добавить(ОтправитьАккаунт("profile", "email=" + Закодировать(Адрес)));
	Ответы.Добавить(ОтправитьАккаунт("security", "старый=password123&новый=NewPassw0rd1&повтор=NewPassw0rd1"));
	Ответы.Добавить(ОтправитьАккаунт("profile", "операция=выслать"));
	Впустить(Владелец);

	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(Ответ.Код, "гвард не впустил — 403").Равно(403);
		Ожидаем.Что(Строка(Ответ.ТелоТекст), "гвард не впустил — без тела").Равно("");
	КонецЦикла;
	Ожидаем.Что(Личностей(Владелец), "личность цела").Равно(1);
	Ожидаем.Что(Строка(Обновлённая(Владелец).Email), "адрес прежний").Не_().Равно(Адрес);
	Ожидаем.Что(Желудь("СервисПользователей").ПроверитьПароль(Обновлённая(Владелец), "password123"),
		"пароль прежний").ЭтоИстина();

	// КОНТРОЛЬ: впущенный той же формой меняет адрес и отвязывает
	ОтправитьАккаунт("profile", "email=" + Закодировать(Адрес));
	Ожидаем.Что(Строка(Обновлённая(Владелец).Email), "КОНТРОЛЬ: впущенный меняет адрес").Равно(Адрес);
	Отвязать("личность=" + Номер + "&confirmed=1");
	Ожидаем.Что(Личностей(Владелец), "КОНТРОЛЬ: впущенный отвязывает").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Учётка с паролем; гвард впускает её.
Функция Учётка(Знач Приставка)
	Пользователь = Желудь("СервисПользователей").СоздатьПользователя(Приставка + УникальныеИмена.Хвост(), "",
		"password123", "user");
	Впустить(Пользователь);
	Возврат Пользователь;
КонецФункции

// Учётка с неподтверждённым адресом; гвард впускает её.
Функция УчёткаСАдресом(Знач Приставка)
	Логин = Приставка + УникальныеИмена.Хвост();
	Пользователь = Желудь("СервисПользователей").СоздатьПользователя(Логин, Логин + "@example.org",
		"password123", "user");
	Впустить(Пользователь);
	Возврат Пользователь;
КонецФункции

Процедура Впустить(Знач Пользователь)
	Гвард.Впустить(Пользователь, Принципалы.Сессия(Пользователь));
КонецПроцедуры

Функция Обновлённая(Знач Пользователь)
	Возврат Желудь("СервисПользователей").ПоИдентификатору(Пользователь.Идентификатор);
КонецФункции

Функция Привязать(Знач Пользователь)
	Возврат Желудь("СервисЛичностей").Привязать(Пользователь.Идентификатор, "https://idp.example.org",
		"sub-" + УникальныеИмена.Хвост(), "", "user" + УникальныеИмена.Хвост());
КонецФункции

Функция Личностей(Знач Пользователь)
	Возврат Желудь("СервисЛичностей").ЛичностиПользователя(Пользователь.Идентификатор).Количество();
КонецФункции

Функция Номер(Знач Личность)
	Возврат Формат(Личность.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция ПолучитьПривязки(Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Привязки.Личности(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "127.0.0.1", "", Окно);
	Возврат Ответ;
КонецФункции

Функция Отвязать(Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Привязки.Отвязать(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST", "_csrf=токен-теста&" + Тело,
		"127.0.0.1");
	Возврат Ответ;
КонецФункции

Функция ПолучитьАккаунт(Знач Раздел)
	Ответ = Новый ОтветСтраницыЗаглушка();
	ДомАккаунта.Раздел(Ответ, Раздел, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "127.0.0.1");
	Возврат Ответ;
КонецФункции

Процедура НастроитьПочту()
	Настройки = Желудь("СервисНастроек");
	Настройки.Установить("oshub.instance.url", "https://hub.example.com", "тест");
	Настройки.Установить("oshub.mail.enabled", Истина, "тест");
	Настройки.Установить("oshub.mail.smtp.host", "smtp.example.com", "тест");
	Настройки.Установить("oshub.mail.from", "hub@example.com", "тест");
	Настройки.Установить("oshub.auth.email.confirm.enabled", Истина, "тест");
КонецПроцедуры

// Разметка формы, в которой есть кнопка с подписью; "" — такой формы нет.
Функция ФормаСКнопкой(Знач HTML, Знач Подпись)

	Остаток = HTML;
	Начало = СтрНайти(Остаток, "<form");
	Пока Начало > 0 Цикл
		Остаток = Сред(Остаток, Начало);
		Форма = Лев(Остаток, СтрНайти(Остаток, "</form>") + 6);
		Если СтрНайти(Форма, Подпись) > 0 Тогда
			Возврат Форма;
		КонецЕсли;
		Остаток = Сред(Остаток, СтрДлина(Форма) + 1);
		Начало = СтрНайти(Остаток, "<form");
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ОтправитьАккаунт(Знач Раздел, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	ДомАккаунта.Раздел(Ответ, Раздел, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело, "127.0.0.1");
	Возврат Ответ;
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Остаток = HTML;
	Позиция = СтрНайти(Остаток, "<" + Имя + " ");
	Пока Позиция > 0 Цикл
		Остаток = Сред(Остаток, Позиция);
		Тег_ = Лев(Остаток, СтрНайти(Остаток, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
		Остаток = Сред(Остаток, 2);
		Позиция = СтрНайти(Остаток, "<" + Имя + " ");
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
