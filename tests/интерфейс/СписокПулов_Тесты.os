// Список пулов /pools глазами гостя и вошедшего: видимые пулы названы словами, невидимый не
// упомянут ни именем, ни числом, личное пространство перечислено тому, кто его настраивает,
// у настраиваемого пула — меню ⚙, пустота говорит, что делать дальше, длинный список
// листается, а цена страницы не растёт с числом строк.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;  // СборкаUI — граф компонентов и рендереров интерфейса

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПулСписка");
	РеестрФикстур.Подключить("ОкружениеСпискаПулов");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ВозвратПослеВхода");
	КаталогИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Поиск.Подключить(КаталогИнтерфейса, "ПлашкиПула");
	Поиск.Подключить(КаталогИнтерфейса, "СтраницаСпискаПулов");

КонецПроцедуры

#Область Видимость

// Гость видит пул, который ему открыт, ссылкой на его страницу; пул, который ему не виден,
// не назван ни именем, ни числом пакетов — о нём список даже не спрашивает.
&Тест
Процедура НевидимыйПулНеУпоминаетсяНиИменемНиЧислом() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Окружение.Завести(Новый ПулСписка(1, "corp"), Истина, 3);
	Окружение.Завести(Новый ПулСписка(2, "secret-team", "custom", "private"), Ложь, 5);

	Страница = Разметка(Окружение, Гость());

	Ожидаем.Что(Страница, "открытый пул — ссылкой на его страницу").Содержит("href=""/pools/corp""");
	Ожидаем.Что(СтрНайти(Страница, "secret-team"), "невидимый пул не назван").Равно(0);
	Ожидаем.Что(Окружение.СпрошенныеПулы().Найти(2), "его пакеты не считали").Равно(Неопределено);
	Ожидаем.Что(Окружение.СпрошенныеПулы().Найти(1), "КОНТРОЛЬ: пакеты видимого считали")
		.Не_().Равно(Неопределено);

КонецПроцедуры

// Тип, видимость и источники названы словами; у пула без источников — прочерк, а не пустота.
&Тест
Процедура ПулНазванСловами() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Окружение.Завести(Новый ПулСписка(1, "public", "default"), Истина, 7, 2);
	Окружение.Завести(Новый ПулСписка(2, "team", "custom", "private"), Истина, 4, 0, Истина);
	Окружение.Завести(Новый ПулСписка(3, "zeta"), Истина);

	Строки = СтрокиТаблицы(Разметка(Окружение, Вошедший()));

	Ожидаем.Что(Строки.Количество(), "по строке на пул").Равно(3);
	Ожидаем.Что(Строки[0], "основной пул").Содержит("Основной");
	Ожидаем.Что(Строки[0], "публичный").Содержит("Публичный");
	Ожидаем.Что(Строки[0], "прокси назван словом").Содержит("Прокси");
	Ожидаем.Что(Строки[0], "число пакетов").Содержит(">7<");
	Ячейка = Сред(Строки[0], СтрНайти(Строки[0], "<td", НаправлениеПоиска.СКонца, СтрНайти(Строки[0], ">7<")));
	Ожидаем.Что(Лев(Ячейка, СтрНайти(Ячейка, ">")), "число пакетов — колонкой чисел").Содержит("cell-num");
	Ожидаем.Что(Строки[1], "обычный пул — проектный").Содержит(UI.Тексты.Текст("public.pools.kind.project"));
	Ожидаем.Что(Строки[1], "приватный").Содержит("Приватный");
	Ожидаем.Что(Строки[1], "зеркало названо словом").Содержит("Зеркало");
	Ожидаем.Что(Строки[2], "без пакетов — ноль").Содержит(">0<");
	Ожидаем.Что(Строки[2], "без источников — прочерк").Содержит("—");
	Ожидаем.Что(СтрНайти(Строки[2], "Прокси") + СтрНайти(Строки[2], "Зеркало"),
		"источников ему не приписано").Равно(0);

КонецПроцедуры

// Основной пул первым, за ним пулы хаба по имени, личное пространство — последним.
&Тест
Процедура ОсновнойПервымПулыХабаПоИмениЛичныеПоследними() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Окружение.Завести(Новый ПулСписка(1, "alice", "user"), Истина);
	Окружение.Завести(Новый ПулСписка(2, "corp"), Истина);
	Окружение.Завести(Новый ПулСписка(3, "public", "default"), Истина);
	Окружение.Завести(Новый ПулСписка(4, "contrib"), Истина);
	Окружение.ДатьНастройку("alice", "alice");

	Строки = СтрокиТаблицы(Разметка(Окружение, Вошедший("alice")));

	Порядок = Новый Массив();
	Для Каждого Строка Из Строки Цикл
		Для Каждого Имя Из СтрРазделить("alice,corp,public,contrib", ",") Цикл
			Если СтрНайти(Строка, "href=""/pools/" + Имя + """") > 0 Тогда
				Порядок.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Порядок, ","), "порядок строк").Равно("public,contrib,corp,alice");

КонецПроцедуры

// Своё личное пространство владелец видит в списке, и тип его назван словами; гостю и
// постороннему чужое личное пространство не перечисляется — их столько же, сколько учёток,
// и пакеты чужого не считают.
&Тест
Процедура ЛичноеПространствоПеречисленоВладельцуИНазваноСловами() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Окружение.Завести(Новый ПулСписка(1, "corp"), Истина, 2);
	Окружение.Завести(Новый ПулСписка(2, "alice", "user"), Истина, 3);
	Окружение.ДатьНастройку("alice", "alice");

	Строки = СтрокиТаблицы(Разметка(Окружение, Вошедший("alice")));
	Ожидаем.Что(Строки.Количество(), "КОНТРОЛЬ: обе строки у владельца").Равно(2);
	Ожидаем.Что(Строки[1], "своё личное пространство перечислено").Содержит("href=""/pools/alice""");
	Ожидаем.Что(Строки[1], "и названо словами")
		.Содержит(UI.Тексты.Текст("public.pools.kind.personal"));

	Чужое = Новый ОкружениеСпискаПулов();
	Чужое.Завести(Новый ПулСписка(1, "corp"), Истина, 2);
	Чужое.Завести(Новый ПулСписка(2, "alice", "user"), Истина, 3);
	Чужое.ДатьНастройку("alice", "alice");
	Постороннему = Разметка(Чужое, Вошедший("bob"));
	Гостю = Разметка(Чужое, Гость());

	Ожидаем.Что(Постороннему, "КОНТРОЛЬ: пул хаба в списке").Содержит("href=""/pools/corp""");
	Ожидаем.Что(СтрНайти(Постороннему, "alice"), "чужое личное постороннему не перечислено").Равно(0);
	Ожидаем.Что(СтрНайти(Гостю, "alice"), "и гостю тоже").Равно(0);
	Ожидаем.Что(Чужое.СпрошенныеПулы().Найти(2), "его пакеты не считали").Равно(Неопределено);

	ТолькоЛичные = Новый ОкружениеСпискаПулов();
	ТолькоЛичные.Завести(Новый ПулСписка(2, "alice", "user"), Истина, 3);
	Ожидаем.Что(Разметка(ТолькоЛичные, Гость()), "гостю без пулов хаба — пустота")
		.Содержит(UI.Тексты.Текст("public.pools.empty.guest.title"));

КонецПроцедуры

// Шапка страницы личного пула называет вид тем же словом, что список пулов /pools: «Личное
// пространство», а не прежнее «Пользовательский». У пула хаба плашки вида нет.
&Тест
Процедура ПлашкаСтраницыЛичногоПулаНазываетЕгоЛичнымПространством() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Плашки = Новый ПлашкиПула(Окружение, Окружение, UI.Тексты, UI.ЗначкиМеты, Новый Массив());

	Слово = UI.Тексты.Текст("public.pools.kind.personal");
	Ожидаем.Что(Слово, "слово каталога").Равно("Личное пространство");

	Личного = Плашки.ПлашкаТипа(Новый ПулСписка(2, "alice", "user"));
	Ожидаем.Что(Личного, "у личного пула плашка вида есть").Существует();
	Ожидаем.Что(Личного.Текст, "и называет его личным пространством").Равно(Слово);

	Ожидаем.Что(Плашки.ПлашкаТипа(Новый ПулСписка(1, "corp")), "КОНТРОЛЬ: у пула хаба плашки вида нет")
		.Равно(Неопределено);

КонецПроцедуры

// Плашка «Прокси» в шапке пула называет, сколько у него апстримов; в списке пулов — без числа.
&Тест
Процедура ПлашкаПроксиШапкиНазываетЧислоАпстримов() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Пул = Новый ПулСписка(1, "public", "default");
	Окружение.Завести(Пул, Истина, 7, 3);
	Плашки = Новый ПлашкиПула(Окружение, Окружение, UI.Тексты, UI.ЗначкиМеты, Новый Массив());

	Прокси = Плашки.ПлашкаПрокси(Пул);
	Ожидаем.Что(Прокси, "у пула с апстримами плашка прокси есть").Существует();
	Ожидаем.Что(Прокси.Текст, "словом словаря").Равно(UI.Тексты.Текст("public.pool.badge.proxy"));
	Ожидаем.Что(Прокси.Подсказка, "подсказка называет число апстримов")
		.Равно(UI.Тексты.Шаблон("public.pool.badge.proxy.hint.count", "3"));

	БезАпстримов = Новый ПулСписка(2, "team");
	Окружение.Завести(БезАпстримов, Истина);
	Ожидаем.Что(Плашки.ПлашкаПрокси(БезАпстримов), "КОНТРОЛЬ: без апстримов плашки нет").Равно(Неопределено);

КонецПроцедуры

// Администратору хаба видны все личные пространства: настраивать он вправе каждое.
&Тест
Процедура АдминистраторуПеречисленыВсеЛичныеСМеню() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Окружение.Завести(Новый ПулСписка(1, "corp"), Истина);
	Окружение.Завести(Новый ПулСписка(2, "alice", "user"), Истина);
	Окружение.Завести(Новый ПулСписка(3, "bob", "user"), Истина);

	Строки = СтрокиТаблицы(Разметка(Окружение, Администратор()));

	Ожидаем.Что(Строки.Количество(), "пул хаба и оба личных").Равно(3);
	Ожидаем.Что(Строки[1], "личное alice").Содержит("href=""/pools/alice/settings""");
	Ожидаем.Что(Строки[2], "личное bob").Содержит("href=""/pools/bob/settings""");

КонецПроцедуры

// ⚙ стоит у пула, который посетитель вправе настраивать: «Настройки» ведут в дом пула,
// «Пакеты» — на страницу пула. У соседнего пула и у постороннего меню нет, гостю — тоже.
// Права спрашиваются одним снимком на страницу, а не запросом на строку.
&Тест
Процедура МенюНастроекУТогоКомуМожноНастраивать() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Окружение.Завести(Новый ПулСписка(1, "corp"), Истина);
	Окружение.Завести(Новый ПулСписка(2, "zeta"), Истина);
	Окружение.Завести(Новый ПулСписка(3, "team", "custom", "private"), Истина);
	Окружение.ДатьНастройку("carol", "corp");

	Строки = СтрокиТаблицы(Разметка(Окружение, Вошедший("carol")));

	Ожидаем.Что(Строки[0], "у своего пула — меню").Содержит("popovertarget");
	Ожидаем.Что(Строки[0], "«Настройки» — дом пула").Содержит("href=""/pools/corp/settings""");
	Ожидаем.Что(Строки[0], "подпись пункта").Содержит(UI.Тексты.Текст("public.pools.action.settings"));
	Ожидаем.Что(Строки[0], "«Пакеты» — страница пула")
		.Содержит(UI.Тексты.Текст("public.pools.action.packages"));
	Ожидаем.Что(СтрЧислоВхождений(Строки[0], "href=""/pools/corp"""), "имя и пункт «Пакеты»").Равно(2);
	Ожидаем.Что(СтрНайти(Строки[1] + Строки[2], "popovertarget"), "у соседних пулов меню нет").Равно(0);
	Ожидаем.Что(Строки[1], "ячейка меню соседа пуста, без прочерка в карточке").Содержит("cell-empty");
	Ожидаем.Что(Окружение.ЧислоСнимков(), "права — одним снимком на страницу").Равно(1);

	Постороннему = Разметка(Окружение, Вошедший("bob"));
	Гостю = Разметка(Окружение, Гость());
	Ожидаем.Что(СтрНайти(Постороннему, "popovertarget"), "постороннему меню нет").Равно(0);
	Ожидаем.Что(СтрНайти(Постороннему, "/settings"), "и хода в настройки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Гостю, "popovertarget") + СтрНайти(Гостю, "/settings"), "гостю — тоже").Равно(0);

	Ожидаем.Что(СтрЧислоВхождений(Разметка(Окружение, Вошедший("carol")), "</th>"),
		"КОНТРОЛЬ: у того, кто настраивает, колонка меню есть").Равно(6);
	Ожидаем.Что(СтрЧислоВхождений(Постороннему, "</th>"), "постороннему таблица прежняя: без колонки меню")
		.Равно(5);
	Ожидаем.Что(СтрЧислоВхождений(Гостю, "</th>"), "и гостю").Равно(5);

КонецПроцедуры

// Цена страницы не растёт с числом пулов: числа пакетов, апстримы и зеркала спрашиваются
// разом на всю страницу.
&Тест
Процедура ЦенаСпискаПуловНеРастётСЧисломПулов() Экспорт

	Малый = Новый ОкружениеСпискаПулов();
	Большой = Новый ОкружениеСпискаПулов();
	Для Номер = 1 По 20 Цикл
		Пул = Новый ПулСписка(Номер, "pool-" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0"));
		Большой.Завести(Пул, Истина, Номер, Номер % 2, Номер % 3 = 0);
		Если Номер <= 2 Тогда
			Малый.Завести(Пул, Истина, Номер, Номер % 2, Номер % 3 = 0);
		КонецЕсли;
	КонецЦикла;

	Разметка(Малый, Гость());
	Разметка(Большой, Гость());

	Ожидаем.Что(Малый.ЧислоОбращений() > 0, "КОНТРОЛЬ: окружение спрашивали").ЭтоИстина();
	Ожидаем.Что(Большой.ЧислоОбращений(), "двадцать строк стоят столько же, сколько две")
		.Равно(Малый.ЧислоОбращений());

КонецПроцедуры

#КонецОбласти

#Область Пустота

// Гостю, которому не видно ни одного пула, список говорит об этом и предлагает войти
// с возвратом сюда же.
&Тест
Процедура ГостюБезПуловПредлагаютВойти() Экспорт

	Страница = Разметка(Новый ОкружениеСпискаПулов(), Гость());

	Ожидаем.Что(Страница, "пустота названа").Содержит(UI.Тексты.Текст("public.pools.empty.guest.title"));
	Ожидаем.Что(Страница, "вход с возвратом в список").Содержит("href=""/login?");
	Ожидаем.Что(Страница, "возврат — на /pools").Содержит("%2Fpools");

КонецПроцедуры

// Вошедшему войти уже некуда: пустота названа без хода ко входу.
&Тест
Процедура ВошедшемуБезПуловВойтиНеПредлагают() Экспорт

	Страница = Разметка(Новый ОкружениеСпискаПулов(), Вошедший());

	Ожидаем.Что(Страница, "пустота названа").Содержит(UI.Тексты.Текст("public.pools.empty.title"));
	Ожидаем.Что(СтрНайти(Страница, "/login"), "входа нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Страницы

// Длинный список листается: вторая страница несёт остаток, номер за последней читается
// последней.
&Тест
Процедура ДлинныйСписокЛистается() Экспорт

	Окружение = Новый ОкружениеСпискаПулов();
	Для Номер = 1 По 25 Цикл
		Окружение.Завести(Новый ПулСписка(Номер, "pool-" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0")), Истина);
	КонецЦикла;

	Первая = Разметка(Окружение, Гость(), 1);
	Вторая = Разметка(Окружение, Гость(), 2);

	Ожидаем.Что(СтрокиТаблицы(Первая).Количество(), "первая страница полная").Равно(20);
	Ожидаем.Что(СтрокиТаблицы(Вторая).Количество(), "на второй — остаток").Равно(5);
	Ожидаем.Что(Вторая, "остаток — последние пулы").Содержит("href=""/pools/pool-25""");
	Ожидаем.Что(Первая, "ход на вторую страницу").Содержит("href=""/pools?page=2""");
	Ожидаем.Что(Вторая, "ход назад — на первую страницу").Содержит("href=""/pools?page=1""");
	Ожидаем.Что(СтрокиТаблицы(Разметка(Окружение, Гость(), 99)).Количество(),
		"номер за последней читается последней").Равно(5);

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Разметка(Знач Окружение, Знач Принципал, Знач Номер = 1)

	Зеркала = Новый Массив();
	Зеркала.Добавить(Окружение);
	Плашки = Новый ПлашкиПула(Окружение, Окружение, UI.Тексты, UI.ЗначкиМеты, Зеркала);
	Страница = Новый СтраницаСпискаПулов(Окружение, Окружение, Плашки, Новый АдресаСтраниц(),
		Новый ВозвратПослеВхода(), UI.Кит, UI.Тексты, Окружение);
	Возврат Страница.Содержимое(Принципал, Номер).Рендер();

КонецФункции

Функция Гость()
	Возврат Новый Структура("Пользователь, Сессия", Неопределено, Неопределено);
КонецФункции

Функция Вошедший(Знач Логин = "bob")
	Возврат Новый Структура("Пользователь, Сессия", Новый Структура("Логин", Логин), Неопределено);
КонецФункции

Функция Администратор()
	Возврат Новый Структура("Пользователь, Сессия",
		Новый Структура("Логин, Админ", "root", Истина), Неопределено);
КонецФункции

// Строки тела таблицы: от <tr> до </tr> внутри <tbody>.
Функция СтрокиТаблицы(Знач Страница)

	Результат = Новый Массив();
	Начало = СтрНайти(Страница, "<tbody");
	Если Начало = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Тело = Сред(Страница, Начало, СтрНайти(Страница, "</tbody>") - Начало);

	Позиция = СтрНайти(Тело, "<tr");
	Пока Позиция > 0 Цикл
		Конец = СтрНайти(Тело, "</tr>", НаправлениеПоиска.СНачала, Позиция);
		Результат.Добавить(Сред(Тело, Позиция, Конец - Позиция));
		Позиция = СтрНайти(Тело, "<tr", НаправлениеПоиска.СНачала, Конец);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
