// Экран «Токены доступа» дома «Аккаунт»: окно выпуска по адресу, секрет один раз в окне ответа
// (не в адресе), отбитая форма в открытом окне, пулы деревом с поиском через сервер, отзыв через
// подтверждение — настоящим контроллером поверх настоящей службы токенов в контейнере.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Принципалы;    // фикстура СтендПринципалов
Перем Гвард;         // ГвардХабаЗаглушка — впускает учётку с её принципалом
Перем Контроллер;    // КонтроллерТокеновКабинета
Перем Владелец;      // Пользователь — владелец токенов
Перем Корп;          // Пул «corp…»
Перем Команда;       // Пул «team…»
Перем Защита;        // ЗащитаCSRFЗаглушка — исход проверки токена формы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");
	Слои.ПодключитьТаблицы("уведомления");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("вход, права, настройки, гео, сеть, интерфейс/общее, интерфейс/аккаунт,"
		+ " интерфейс/панели/пакет");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "КонтроллерТокеновКабинета");

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкЖурналЗамка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ГвардХабаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-токенов-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Владелец = Желудь("СервисПользователей").СоздатьПользователя("tok" + УникальныеИмена.Хвост(), "",
		"password123", "admin");
	Гвард = Новый ГвардХабаЗаглушка();
	Гвард.Впустить(Владелец, Принципалы.Сессия(Владелец));

	Корп = Желудь("СервисПулов").СоздатьПул("corp" + УникальныеИмена.Хвост());
	Команда = Желудь("СервисПулов").СоздатьПул("team" + УникальныеИмена.Хвост(), "custom", "private");

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Желудь("СервисПрав"), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Пульт = Новый ПультТокеновКабинета(
		Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы")), Желудь("РазборФормы"),
		Желудь("СервисТокенов"), Желудь("ГвардДоступаКПулу"), Желудь("ГейтТокена"),
		Желудь("ПриведениеЧисел"), Желудь("ОкноВыпускаТокена"), Желудь("ТекстСбоя"),
		Желудь("ТекстыИнтерфейса"));
	Контроллер = Новый КонтроллерТокеновКабинета(Гвард, Ответы, Желудь("ДомАккаунта"),
		Желудь("ВитринаТокеновКабинета"), Пульт, Защита, Желудь("ОкноРаздела"),
		Желудь("ПерехватчикАутентификации"), Желудь("ГвардДоступаКПулу"), Желудь("СервисТокенов"),
		Желудь("ОкноВыпускаТокена"), Желудь("ТекстыИнтерфейса"));

КонецПроцедуры

&ПослеКаждого
Процедура ВернутьСессию() Экспорт
	Гвард.Впустить(Владелец, Принципалы.Сессия(Владелец));
	Защита.ЗадатьИсход(Истина);
КонецПроцедуры

#Область ОкноВыпуска

&Тест
Процедура ОкноВыпускаПоАдресуОткрытоШагамиСДеревомПулов() Экспорт

	Страница = Получить("новый");

	Ожидаем.Что(Страница.Код, "страница с окном отдана").Равно(200);
	Открытые = ОткрытыеОкна(Страница.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто ровно одно окно").Равно(1);
	Окно = Открытые[0];
	Ожидаем.Что(Окно, "форма окна уходит на выпуск").Содержит("action=""/me/settings/tokens""");
	Ожидаем.Что(Окно, "шаги окна").Содержит("data-steps");
	Для Каждого Имя Из СтрРазделить("имя,чтение,запись,где,срок_дней", ",") Цикл
		Ожидаем.Что(Окно, "поле «" + Имя + "» в окне").Содержит("name=""" + Имя + """");
	КонецЦикла;
	Ожидаем.Что(Окно, "пулы — деревом галок").Содержит("data-checktree");
	Ожидаем.Что(Окно, "в дереве видимый пул").Содержит(">" + Корп.Имя + "<");
	Ожидаем.Что(Окно, "поиск пулов спрашивает сервер")
		.Содержит("formaction=""/me/settings/tokens/pools""");

	// КОНТРОЛЬ: без параметра окна окно выпуска на странице закрыто, а кнопка к нему без скрипта
	// ведёт на адрес, где оно открыто
	Раздел = Получить("").ТелоТекст;
	Ожидаем.Что(ОткрытыеОкна(Раздел).Количество(), "без ?окно= окна закрыты").Равно(0);
	Ожидаем.Что(Тег(Раздел, "dialog", "id=""token-novyi"""), "окно выпуска на странице").Содержит("token-novyi");
	Ожидаем.Что(Тег(Раздел, "a", "data-opens=""token-novyi"""), "«Выпустить токен» ведёт на ?окно=новый")
		.Содержит("href=""/me/settings/tokens?" + Закодировать("окно") + "=" + Закодировать("новый") + """");

КонецПроцедуры

&Тест
Процедура ШапкаДомаНазываетУчётку() Экспорт

	Страница = Получить("").ТелоТекст;

	Ожидаем.Что(Между(Страница, "<h1 class=""settings__title"">", "</h1>"), "одно имя дома — «Аккаунт · логин»")
		.Равно("Аккаунт · " + Владелец.Логин);
	Ожидаем.Что(СтрНачинаетсяС(Между(Страница, "<title>", "</title>"),
		"Токены доступа · Аккаунт · " + Владелец.Логин + " — "),
		"вкладка — раздел и дом, логин один раз: " + Между(Страница, "<title>", "</title>")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УдачныйВыпускПоказываетСекретОдинРазВОкнеОтвета() Экспорт

	Было = Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество();

	Ответ = Отправить("", "имя=ноутбук&чтение=1&запись=1&где=хаб&срок_дней=30");

	Ожидаем.Что(Ответ.Код, "выпуск отвечает страницей").Равно(200);
	Ожидаем.Что(ЗначениеЗаполнено(Ответ.ПутьРедиректа), "секрет не уходит в адрес перенаправлением")
		.ЭтоЛожь();
	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество(),
		"токен выпущен").Равно(Было + 1);

	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто одно окно — окно секрета").Равно(1);
	Секрет = Секрет(Открытые[0]);
	Ожидаем.Что(СтрНачинаетсяС(Секрет, "oshub_"), "секрет в окне: " + Секрет).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Открытые[0], "data-copy=""" + Секрет + """"), "у секрета кнопка копирования")
		.Равно(1);
	// окно — ответ формы выпуска: закрывается только переходом на раздел без секрета, и со скриптом
	Ожидаем.Что(СтрНайти(Открытые[0], "href=""/me/settings/tokens"""), "крестик и «Закрыть» ведут на раздел")
		.Больше(0);
	Ожидаем.Что(Открытые[0], "Esc со скриптом — туда же").Содержит("data-close-to=""/me/settings/tokens""");
	Ожидаем.Что(СтрНайти(Открытые[0], "data-closes"), "закрытия на месте у окна секрета нет").Равно(0);

	// КОНТРОЛЬ: страница раздела и окно выпуска секрета не несут
	Ожидаем.Что(СтрНайти(Получить("").ТелоТекст, Секрет), "секрет на странице раздела").Равно(0);
	Ожидаем.Что(СтрНайти(Получить("новый").ТелоТекст, Секрет), "секрет в окне выпуска").Равно(0);

КонецПроцедуры

&Тест
Процедура ОтбитыйВыпускВозвращаетОкноСНабраннымИОтказомУПоля() Экспорт

	Было = Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество();

	Для Каждого Срок Из СтрРазделить("0,100000,неделя,", ",", Истина) Цикл
		Ответ = Отправить("", "имя=отбитый&чтение=1&где=хаб&срок_дней=" + Закодировать(Срок));
		Ожидаем.Что(Ответ.Код, "срок «" + Срок + "» — отказ формы").Равно(400);
		Окно = ОткрытоеОкно(Ответ.ТелоТекст);
		Ожидаем.Что(Тег(Окно, "input", "name=""срок_дней"""), "поле срока отбито")
			.Содержит("aria-invalid=""true""");
		Ожидаем.Что(Окно, "отказ называет потолок").Содержит("от 1 до");
		Ожидаем.Что(Тег(Окно, "input", "name=""имя"""), "набранное имя на месте")
			.Содержит("value=""отбитый""");
	КонецЦикла;

	БезПрав = Отправить("", "имя=безправ&где=хаб&срок_дней=7");
	Ожидаем.Что(БезПрав.Код, "без прав — отказ").Равно(400);
	Ожидаем.Что(Тег(ОткрытоеОкно(БезПрав.ТелоТекст), "input", "name=""чтение"""), "отказ у права чтения")
		.Содержит("aria-invalid=""true""");

	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество(),
		"ни один отбитый токен не выпущен").Равно(Было);

КонецПроцедуры

&Тест
Процедура ТокенВВыбранныхПуляхОграниченИмиОдними() Экспорт

	Ответ = Отправить("", "имя=только-корп&чтение=1&где=пулы&пулы=" + Ид(Корп) + "&пулы=" + Ид(Корп)
		+ "&срок_дней=5");
	Ожидаем.Что(Ответ.Код, "токен в пуле выпущен").Равно(200);

	Запись = ТокенПоИмени("только-корп");
	Пулы = Желудь("СервисТокенов").ПулыТокена(Запись);
	Ожидаем.Что(Пулы.Количество(), "один пул без повторов").Равно(1);
	Ожидаем.Что(Пулы[0], "это отмеченный пул").Равно(Корп.Идентификатор);

	// отмеченный пул при «весь хаб» не сужает токен: спрятанный набор не читается
	Отправить("", "имя=весь-хаб&чтение=1&где=хаб&пулы=" + Ид(Команда) + "&срок_дней=5");
	Ожидаем.Что(Желудь("СервисТокенов").ПулыТокена(ТокенПоИмени("весь-хаб")).Количество(),
		"«весь хаб» — без набора пулов").Равно(0);

КонецПроцедуры

&Тест
Процедура ВыбранныеПулыБезОтметокИНевидимыйПулОтбиваютсяВОкне() Экспорт

	Было = Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество();

	Пусто = Отправить("", "имя=пусто&чтение=1&где=пулы&срок_дней=5");
	Ожидаем.Что(Пусто.Код, "пулы без отметок — отказ").Равно(400);
	Ожидаем.Что(ОткрытоеОкно(Пусто.ТелоТекст), "причина в окне").Содержит("хотя бы один пул");

	Чужой = Отправить("", "имя=чужой&чтение=1&где=пулы&пулы=987654&срок_дней=5");
	Ожидаем.Что(Чужой.Код, "пул, которого нет, — отказ").Равно(400);
	Ожидаем.Что(ОткрытоеОкно(Чужой.ТелоТекст), "назван как несуществующий").Содержит("987654 не найден");

	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество(),
		"токены не выпущены").Равно(Было);

КонецПроцедуры

&Тест
Процедура ОкноПоказываетДвадцатьПуловИСтрокуУсечения() Экспорт

	Последний = Неопределено;
	Для Номер = 1 По 25 Цикл
		Последний = Желудь("СервисПулов").СоздатьПул("many" + УникальныеИмена.Хвост());
	КонецЦикла;
	Всего = Желудь("ГвардДоступаКПулу").ЧитаемыеПулы(Принципалы.Сессия(Владелец)).Количество();

	Окно = Между(Получить("").ТелоТекст, "id=""token-novyi""", "</dialog>");
	Ожидаем.Что(СтрЧислоВхождений(Окно, "data-checktree-box name=""пулы"""), "на окне двадцать пулов").Равно(20);
	Ожидаем.Что(Окно, "и честная строка усечения").Содержит("Показаны 20 пулов из " + Формат(Всего, "ЧГ=0"));
	Ожидаем.Что(СтрНайти(Окно, ">" + Последний.Имя + "<"), "пул за пределом показа не напечатан").Равно(0);

	// остальные находит поиск
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.ПоискПулов(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", Последний.Имя);
	Ожидаем.Что(Между(Ответ.ТелоТекст, "data-checktree-found", "</ul>"), "поиск находит пул за пределом")
		.Содержит(">" + Последний.Имя + "<");

	// отмеченный за пределом показа едет скрытым полем и назван словами; невидимый не печатается
	Отбитая = ОткрытоеОкно(Отправить("", "имя=за-пределом&где=пулы&пулы=" + Ид(Последний)
		+ "&пулы=987654&срок_дней=5").ТелоТекст);
	Ожидаем.Что(Тег(Отбитая, "input", "type=""hidden"" name=""пулы"" value=""" + Ид(Последний) + """"),
		"отметка за пределом показа — скрытым полем").Содержит("hidden");
	Ожидаем.Что(Отбитая, "и названа словами").Содержит("Уже отмечены: " + Последний.Имя);
	Ожидаем.Что(СтрНайти(Отбитая, "value=""987654"""), "невидимый пул обратно не печатается").Равно(0);

КонецПроцедуры

&Тест
Процедура ВыпускБезТокенаФормыОтвергнут() Экспорт

	Было = Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество();
	Защита.ЗадатьИсход(Ложь);

	Ответ = Отправить("", "имя=без-csrf&чтение=1&где=хаб&срок_дней=5");

	Ожидаем.Что(Ответ.Код, "форма без токена сессии — 403").Равно(403);
	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество(),
		"токен не выпущен").Равно(Было);

КонецПроцедуры

#КонецОбласти

#Область ПоискПулов

&Тест
Процедура ПоискПуловОтвечаетСовпадениямиИДержитОтметкиВнеОтвета() Экспорт

	// без скрипта «Найти» отправляет форму выпуска целиком на адрес поиска
	Ответ = Искать("имя=поиск&чтение=1&где=пулы&пулы=" + Ид(Команда) + "&найти=" + Закодировать(Корп.Имя)
		+ "&срок_дней=9");

	Ожидаем.Что(Ответ.Код, "ответ поиска — страница").Равно(200);
	Окно = ОткрытоеОкно(Ответ.ТелоТекст);
	Найдено = Между(Окно, "data-checktree-found", "</ul>");
	Ожидаем.Что(Найдено, "найден пул по имени").Содержит(">" + Корп.Имя + "<");
	Ожидаем.Что(СтрНайти(Найдено, ">" + Команда.Имя + "<"), "несовпавший пул не в ответе").Равно(0);
	Ожидаем.Что(Тег(Окно, "input", "type=""hidden"" name=""пулы"" value=""" + Ид(Команда) + """"),
		"отметка вне ответа едет скрытым полем").Содержит("hidden");
	Ожидаем.Что(Тег(Окно, "input", "name=""имя"""), "набранное имя на месте").Содержит("value=""поиск""");
	Ожидаем.Что(Тег(Окно, "input", "name=""срок_дней"""), "набранный срок на месте").Содержит("value=""9""");

	// со скриптом кит берёт совпадения из ответа GET
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.ПоискПулов(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "team");
	Ожидаем.Что(Между(Ответ.ТелоТекст, "data-checktree-found", "</ul>"), "GET ?найти= — совпадения")
		.Содержит(">" + Команда.Имя + "<");

КонецПроцедуры

&Тест
Процедура НайденныеВключаютсяБезСкриптаИТокенНеВыпускается() Экспорт

	Было = Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество();

	Ответ = Отправить("", "имя=найденные&чтение=1&где=хаб&найти=" + Закодировать(Корп.Имя)
		+ "&найденные=вкл&срок_дней=9");

	Ожидаем.Что(Ответ.Код, "кнопка под ответом поиска — шаг подбора").Равно(200);
	Окно = ОткрытоеОкно(Ответ.ТелоТекст);
	Ожидаем.Что(Тег(Окно, "input", "name=""пулы"" value=""" + Ид(Корп) + """"), "найденный пул отмечен")
		.Содержит("checked");
	Ожидаем.Что(Тег(Окно, "input", "value=""пулы"""), "окно перешло на выбранные пулы").Содержит("checked");
	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество(),
		"токен не выпущен").Равно(Было);

КонецПроцедуры

#КонецОбласти

#Область Реестр

&Тест
Процедура СрокТокенаЦветомПлашки() Экспорт

	Отправить("", "имя=скоро&чтение=1&где=хаб&срок_дней=3");
	Отправить("", "имя=нескоро&чтение=1&запись=1&где=хаб&срок_дней=200");
	Отправить("", "имя=истёкший&запись=1&где=хаб&срок_дней=200");
	Истёкший = ТокенПоИмени("истёкший");
	Истёкший.Истекает = ТекущаяУниверсальнаяДата() - 86400;
	Истёкший.Сохранить();

	Страница = Получить("").ТелоТекст;

	Ожидаем.Что(ЗаписьРеестра(Страница, "скоро"), "на исходе — жёлтая").Содержит("tag--warn");
	Ожидаем.Что(ЗаписьРеестра(Страница, "нескоро"), "впереди — зелёная").Содержит("tag--ok");
	Ожидаем.Что(ЗаписьРеестра(Страница, "истёкший"), "истёк — красная").Содержит("tag--err");
	Ожидаем.Что(ЗаписьРеестра(Страница, "истёкший"), "и названа словом").Содержит("истёк ");
	Ожидаем.Что(ЗаписьРеестра(Страница, "нескоро"), "права плашкой").Содержит("чтение, запись");
	Ожидаем.Что(ЗаписьРеестра(Страница, "нескоро"), "область плашкой").Содержит("весь хаб");
	Ожидаем.Что(ЗаписьРеестра(Страница, "нескоро"), "префикс копируется")
		.Содержит("data-copy=""" + ТокенПоИмени("нескоро").Префикс + """");

КонецПроцедуры

#КонецОбласти

#Область Отзыв

&Тест
Процедура ОтзывБезПодтвержденияВедётНаОкноАТокенЦел() Экспорт

	Отправить("", "имя=отзыв&чтение=1&где=хаб&срок_дней=3");
	Ид = Формат(ТокенПоИмени("отзыв").Идентификатор, "ЧГ=0");

	Ответ = Отозвать(Ид, "");

	Ожидаем.Что(Ответ.Код, "без подтверждения — перенаправление").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на окно подтверждения этого токена")
		.Содержит(Закодировать("отозвать-" + Ид));
	Ожидаем.Что(ТокенПоИмени("отзыв") <> Неопределено, "токен цел").ЭтоИстина();

	Окно = ОткрытоеОкно(Получить("отозвать-" + Ид).ТелоТекст);
	Ожидаем.Что(Окно, "подтверждение называет токен").Содержит("отзыв");
	Ожидаем.Что(Окно, "форма подтверждения уходит на отзыв")
		.Содержит("action=""/me/settings/tokens/" + Ид + "/revoke""");

КонецПроцедуры

&Тест
Процедура ПодтверждённыйОтзывСнимаетТокенЧужойИНесуществующий404() Экспорт

	Отправить("", "имя=снять&чтение=1&где=хаб&срок_дней=3");
	Ид = Формат(ТокенПоИмени("снять").Идентификатор, "ЧГ=0");

	Ответ = Отозвать(Ид, "confirmed=1");
	Ожидаем.Что(Ответ.Код, "отзыв — 303 на раздел").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел").Содержит("/me/settings/tokens");
	Ожидаем.Что(ТокенПоИмени("снять"), "токена больше нет").Равно(Неопределено);

	Повтор = Отозвать(Ид, "confirmed=1");
	Ожидаем.Что(Повтор.Код, "отозванный — 404").Равно(404);
	Ожидаем.Что(Повтор.ТелоТекст, "причина на странице").Содержит("Токен не найден");

	Ожидаем.Что(ОткрытыеОкна(Получить("отозвать-" + Ид).ТелоТекст).Количество(),
		"окна подтверждения для несуществующего нет").Равно(0);

	// чужой токен неотличим от несуществующего
	Чужак = Желудь("СервисПользователей").СоздатьПользователя("alien" + УникальныеИмена.Хвост(), "",
		"password123", "user");
	ЧужойИд = Формат(Желудь("СервисТокенов").ВыпуститьТокен(Чужак.Идентификатор, "read", 3).Запись.Идентификатор,
		"ЧГ=0");
	Ожидаем.Что(ОткрытыеОкна(Получить("отозвать-" + ЧужойИд).ТелоТекст).Количество(),
		"окна подтверждения для чужого токена нет").Равно(0);
	Ожидаем.Что(Отозвать(ЧужойИд, "confirmed=1").Код, "чужой — 404").Равно(404);
	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Чужак.Идентификатор).Количество(),
		"чужой токен цел").Равно(1);

КонецПроцедуры

&Тест
Процедура КлючНеУправляетКлючами() Экспорт

	Гвард.Впустить(Владелец, Принципалы.Ключ(Владелец));
	Было = Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество();

	Ожидаем.Что(Получить("").Код, "страница ключу закрыта").Равно(403);
	Ожидаем.Что(Отправить("", "имя=ключом&чтение=1&где=хаб&срок_дней=3").Код, "выпуск ключом").Равно(403);
	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор).Количество(),
		"ключ не выпустил ключ").Равно(Было);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Получить(Знач Окно)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Токены(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;

КонецФункции

Функция Отправить(Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Токены(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST", "_csrf=токен-теста&" + Тело);
	Возврат Ответ;

КонецФункции

Функция Искать(Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.ПоискПулов(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;

КонецФункции

Функция Отозвать(Знач Ид, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Отзыв(Ответ, Ид, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;

КонецФункции

Функция ТокенПоИмени(Знач Имя)

	Для Каждого Запись Из Желудь("СервисТокенов").ТокеныПользователя(Владелец.Идентификатор) Цикл
		Если Запись.Имя = Имя Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция Ид(Знач Пул)
	Возврат Формат(Пул.Идентификатор, "ЧГ=0");
КонецФункции

// Значение секрета в окне: код, который копирует кнопка.
Функция Секрет(Знач Окно)
	Возврат Между(Окно, "data-copy=""", """");
КонецФункции

Функция ОткрытоеОкно(Знач HTML)

	Открытые = ОткрытыеОкна(HTML);
	Ожидаем.Что(Открытые.Количество(), "КОНТРОЛЬ: открыто одно окно").Равно(1);
	Возврат Открытые[0];

КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пункт реестра: от <li class="entry"> с именем токена в сводке до следующего пункта.
Функция ЗаписьРеестра(Знач HTML, Знач Имя)

	Для Каждого Пункт Из Куски(HTML, "<li class=""entry""") Цикл
		Если СтрНайти(Пункт, ">" + Имя + "<") > 0 Тогда
			Возврат Пункт;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
