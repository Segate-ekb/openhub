// СервисГрупп в памяти, считающий обращения: групп у человека нет, а состав группы задаётся
// фикстурой — по нему видна цена раздела «Участники».

Перем Состав;    // Массив из Структура (ПользовательИдентификатор, Источник)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Группы пользователя; считает обращение.
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Массив - всегда пустой.
//
Функция ГруппыПользователя(Знач ПользовательИдентификатор) Экспорт
	ПользовательИдентификатор = ПользовательИдентификатор;
	Счётчик.Отметить();
	Возврат Новый Массив();
КонецФункции

// Заводит участника группы (за обращение не считается).
//
// Параметры:
//  ПользовательИдентификатор - Число - участник.
//  Источник - Строка - local либо oidc (необязательный, по умолчанию local).
//
Процедура ДобавитьУчастника(Знач ПользовательИдентификатор, Знач Источник = "local") Экспорт

	Состав.Добавить(Новый Структура("ПользовательИдентификатор, Источник",
		Цел(ПользовательИдентификатор), Источник));

КонецПроцедуры

// Состав группы с источником членства; считает обращение.
//
// Параметры:
//  ГруппаИдентификатор - Число - группа, фикстурой не различается.
//
// Возвращаемое значение:
//  Массив - записи членства в порядке заведения.
//
Функция СоставГруппы(Знач ГруппаИдентификатор) Экспорт
	ГруппаИдентификатор = ГруппаИдентификатор;
	Счётчик.Отметить();
	Возврат Состав;
КонецФункции

Процедура ПриСозданииОбъекта()
	Состав = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
