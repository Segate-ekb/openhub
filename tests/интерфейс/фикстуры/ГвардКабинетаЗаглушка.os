// Заглушка гварда приватной части (кабинета или дома настроек): допуск и вошедший
// пользователь задаются тестом.

Перем Разрешено_;
Перем Логин_;
Перем Админ_;

// Вердикт допуска.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
// Возвращаемое значение:
//  Структура - Разрешено, Пользователь (Логин, Админ), Сессия.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт

	Ответ = Ответ;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;

	Пользователь = ?(ЗначениеЗаполнено(Логин_),
		Новый Структура("Логин, Админ", Логин_, Админ_), Неопределено);

	Возврат Новый Структура("Разрешено, Пользователь, Сессия", Разрешено_, Пользователь, "сессия");

КонецФункции

// Впускает пользователя.
//
// Параметры:
//  Логин - Строка - логин пользователя сессии; пусто — сессия без пользователя.
//  Админ - Булево - администратор ли хаба (необязательный, по умолчанию Ложь).
//
Процедура Впустить(Знач Логин, Знач Админ = Ложь) Экспорт
	Разрешено_ = Истина;
	Логин_ = Логин;
	Админ_ = Админ;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Разрешено_ = Ложь;
	Логин_ = "";
	Админ_ = Ложь;
КонецПроцедуры
