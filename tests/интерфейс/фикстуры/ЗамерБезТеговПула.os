// Хранилища пула пакета замера в памяти: пакет замера ни в каком пуле с тегами не состоит —
// выключений у него нет, пул не находится, тегов пула нет. Считает обращения: снимок каналов
// пакета ходит сюда на каждом холодном чтении.

#Использовать entity

Перем Счётчик;  // СчётчикОбращений — счёт запросов

// Сколько запросов к хранилищам ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Выключения тегов пула у пакета — их нет.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - пустой.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт
	Возврат Счётчик.Отдать(Новый Массив());
КонецФункции

// Имена выключенных у пакета тегов пула — их нет.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - пустой.
//
Функция ИменаПакета(Знач ПакетИдентификатор) Экспорт
	Возврат Счётчик.Отдать(Новый Массив());
КонецФункции

// Теги пула — их нет.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив - пустой.
//
Функция ПолучитьПоПулИдентификаторРавно(Знач ПулИдентификатор) Экспорт
	Возврат Счётчик.Отдать(Новый Массив());
КонецФункции

// Пакет или пул по идентификатору — не находится.
//
// Параметры:
//  Идентификатор - Число - идентификатор строки.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Счётчик.ОтдатьОдну(Неопределено);
КонецФункции

// Модель сущности «ТегПула» — снимок тегов пула собирает строки по её колонкам.
//
// Возвращаемое значение:
//  ОбъектМодели.
//
Функция ПолучитьОбъектМодели() Экспорт
	Возврат Новый МодельДанных().СоздатьОбъектМодели(Тип("ТегПула"));
КонецФункции

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
