// Фейковое хранилище источников пула в памяти: контракт ХранилищаАпстримовПула без autumn-data
// и базы — для службы СервисАпстримовПула под экраном.

Перем Записи;
Перем СледИд;

// Контракт хранилища: новая, ещё не принятая запись источника.
//
// Возвращаемое значение:
//  ФейкАпстримЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкАпстримЗапись(ЭтотОбъект);
КонецФункции

// Принимает запись, выдавая номер при первом сохранении.
//
// Параметры:
//  Запись - ФейкАпстримЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт
	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Запись);
	КонецЕсли;
КонецПроцедуры

// Убирает запись; отсутствие записи — не ошибка.
//
// Параметры:
//  Запись - ФейкАпстримЗапись - удаляемая запись.
//
Процедура Убрать(Знач Запись) Экспорт
	Индекс = Записи.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		Записи.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

// Источники пула в порядке обхода.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкАпстримЗапись.
//
Функция АпстримыУпорядоченно(Знач ПулИдентификатор) Экспорт

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Порядок");
	Таблица.Колонки.Добавить("Запись");
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПулИдентификатор = Цел(ПулИдентификатор) Тогда
			Строка_ = Таблица.Добавить();
			Строка_.Порядок = Цел(Запись.Порядок);
			Строка_.Запись = Запись;
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Порядок");
	Возврат Таблица.ВыгрузитьКолонку("Запись");

КонецФункции

// Строки источников пула: у фейка кэша нет, снимки — те же записи.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкАпстримЗапись.
//
Функция СнимкиПула(Знач ПулИдентификатор) Экспорт
	Возврат АпстримыУпорядоченно(ПулИдентификатор);
КонецФункции

// Кэша у фейка нет — забывать нечего.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
Процедура ЗабытьСнимкиПула(Знач ПулИдентификатор) Экспорт
КонецПроцедуры

// Есть ли у пула хоть один источник.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьУПула(Знач ПулИдентификатор) Экспорт
	Возврат АпстримыУпорядоченно(ПулИдентификатор).Количество() > 0;
КонецФункции

// Пулы, у которых есть источники.
//
// Возвращаемое значение:
//  Массив из Число.
//
Функция ПулыСИсточниками() Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Результат.Найти(Запись.ПулИдентификатор) = Неопределено Тогда
			Результат.Добавить(Запись.ПулИдентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
КонецПроцедуры
