// ХранилищеГрупп в памяти, считающее обращения: точечная «группа по идентификатору» и разрез
// «группы по списку идентификаторов».

Перем Группы;   // Соответствие: идентификатор -> Структура (Идентификатор, Имя, Описание)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Заводит группу (за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор группы.
//  Имя - Строка - имя группы.
//  Описание - Строка - описание группы (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - заведённая группа.
//
Функция Добавить(Знач Идентификатор, Знач Имя, Знач Описание = "") Экспорт

	Группа = Новый Структура("Идентификатор, Имя, Описание", Цел(Идентификатор), Имя, Описание);
	Группы.Вставить(Цел(Идентификатор), Группа);
	Возврат Группа;

КонецФункции

// Группа по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  Структура, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Группы.Получить(Цел(Идентификатор));
КонецФункции

// Группы перечисленных идентификаторов; считает обращение, пустой список — пустая выдача без
// обращения. Порядок — по возрастанию идентификатора, как у базы, а не порядок аргумента:
// фикстура не делает за продукт его работу.
//
// Параметры:
//  Идентификаторы - Массив из Число.
//
// Возвращаемое значение:
//  Массив - найденные группы по возрастанию идентификатора; ненайденных в выдаче нет.
//
Функция ГруппыПоИдентификаторам(Знач Идентификаторы) Экспорт

	Результат = Новый Массив();
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Счётчик.Отметить();

	Для Каждого Идентификатор Из Идентификаторы Цикл
		Группа = Группы.Получить(Цел(Идентификатор));
		Если Группа <> Неопределено Тогда
			Результат.Вставить(МестоПоВозрастанию(Результат, Группа.Идентификатор), Группа);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МестоПоВозрастанию(Знач Найденные, Знач Идентификатор)

	Для Место = 0 По Найденные.ВГраница() Цикл
		Если Найденные[Место].Идентификатор > Идентификатор Тогда
			Возврат Место;
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные.Количество();

КонецФункции

Процедура ПриСозданииОбъекта()
	Группы = Новый Соответствие();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
