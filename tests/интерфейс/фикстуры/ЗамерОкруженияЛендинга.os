// Окружение главной страницы без базы: гвард онбординга, принципал, обзор хаба, каркас и реестр
// пулов — цену страницы они не двигают, считаются только хранилища.

Перем Новинки;   // Массив из Структура (Пакет, Пул, Версия, Опубликована)
Перем Популярные;// Массив из Структура (Пакет, Пул, Скачиваний, Обновлена)
Перем Основной;  // основной пул хаба; Неопределено, пока тест его не назначил
Перем Пулы;      // Массив из Структура (Пул, Пакетов) — обзор пулов хаба
Перем ПуловКоманд; // сколько пулов команд в срезе всего; Неопределено — столько, сколько в обзоре
Перем Читатель;  // вошедший пользователь; Неопределено — гость

#Область НаполнениеФикстуры

// Добавляет пакет в блок «свежее».
//
// Параметры:
//  ПакетЗамера - Структура - пакет с полями Идентификатор, ПулИдентификатор, Имя и прочими.
//  ПулЗамера - Структура - пул пакета.
//  Версия - Строка - последняя версия пакета.
//
Процедура ДобавитьНовинку(Знач ПакетЗамера, Знач ПулЗамера, Знач Версия) Экспорт

	Новинки.Добавить(Новый Структура("Пакет, Пул, Версия, Опубликована",
		ПакетЗамера, ПулЗамера, Версия, '20260101120000'));

КонецПроцедуры

// Добавляет пакет в блок «популярное».
//
// Параметры:
//  ПакетЗамера - Структура - пакет с полями Идентификатор, ПулИдентификатор, Имя и прочими.
//  ПулЗамера - Структура - пул пакета.
//  Скачиваний - Число - счётчик скачиваний.
//
Процедура ДобавитьПопулярный(Знач ПакетЗамера, Знач ПулЗамера, Знач Скачиваний) Экспорт

	Популярные.Добавить(Новый Структура("Пакет, Пул, Скачиваний, Версия, Обновлена",
		ПакетЗамера, ПулЗамера, Скачиваний, "1.0.0", '20260101120000'));

КонецПроцедуры

// Добавляет пул в обзор «Пулы хаба».
//
// Параметры:
//  ПулЗамера - Произвольный - пул.
//  Пакетов - Число - сколько пакетов показано у пула.
//
Процедура ДобавитьПул(Знач ПулЗамера, Знач Пакетов) Экспорт
	Пулы.Добавить(Новый Структура("Пул, Пакетов", ПулЗамера, Пакетов));
КонецПроцедуры

// Назначает основной пул хаба: с ним блок быстрого старта печатает образцы, а не объяснение.
//
// Параметры:
//  Пул - Произвольный - пул, который отдаст ДефолтныйПул.
//
Процедура НазначитьОсновнойПул(Знач Пул) Экспорт
	Основной = Пул;
КонецПроцедуры

// Задаёт, сколько пулов команд в срезе всего: больше, чем в обзоре, — обзор упёрся в предел.
//
// Параметры:
//  Число - Число - пулов команд в срезе.
//
Процедура ЗадатьПуловКоманд(Знач Число) Экспорт
	ПуловКоманд = Число;
КонецПроцедуры

// Главную смотрит вошедший, а не гость.
//
// Параметры:
//  Пользователь - Произвольный - вошедший пользователь.
//
Процедура Войти(Знач Пользователь) Экспорт
	Читатель = Пользователь;
КонецПроцедуры

#КонецОбласти

#Область ГвардИПринципал

// Онбординг пройден: главная открыта.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера, заглушкой не трогается.
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево).
//
Функция Проверить(Ответ) Экспорт
	Ответ = Ответ;
	Возврат Новый Структура("Разрешено", Истина);
КонецФункции

// Читатель — гость, пока тест не вошёл: страница собирается в самой дешёвой своей форме.
//
// Параметры:
//  ЗаголовкиЗапроса - Произвольный - заголовки, заглушкой не трогаются.
//  КукиЗапроса - Произвольный - куки, заглушкой не трогаются.
//
// Возвращаемое значение:
//  Структура - Пользователь, Принципал, Сессия (сессии у заглушки нет).
//
Функция ОпределитьПринципала(Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	Возврат Новый Структура("Пользователь, Принципал, Сессия", Читатель, Неопределено, Неопределено);
КонецФункции

#КонецОбласти

#Область ОбзорХабаИКаркас

// Обзор хаба готовым: срез, сводка и ранжирование считаются не здесь, и в цену карточек
// они не входят. Пулов в обзоре нет — блок пулов на цену провенанса не влияет.
//
// Параметры:
//  Принципал - Произвольный - субъект запроса, заглушкой не трогается.
//
// Возвращаемое значение:
//  Структура - Сводка, Пулы, Новинки, Популярные, Пусто.
//
Функция Обзор(Знач Принципал = Неопределено) Экспорт

	Принципал = Принципал;

	Результат = Новый Структура();
	Результат.Вставить("Сводка", Новый Структура("ПуловКоманд", ?(ПуловКоманд = Неопределено, Пулы.Количество(), ПуловКоманд)));
	Результат.Вставить("Пулы", Пулы);
	Результат.Вставить("Новинки", Новинки);
	Результат.Вставить("Популярные", Популярные);
	Результат.Вставить("Пусто", Новинки.Количество() + Популярные.Количество() = 0);
	Возврат Результат;

КонецФункции

// Каркас страницы в замере не участвует: считается цена данных, а не обрамления.
//
// Параметры:
//  Заголовок - Строка - заголовок страницы.
//  Содержимое - Строка, ЭлементЭкрана - тело страницы.
//  Контекст - Произвольный - контекст запроса.
//
// Возвращаемое значение:
//  Строка - тело как есть; узел — напечатанным.
//
Функция Страница(Знач Заголовок, Знач Содержимое, Знач Контекст) Экспорт
	Заголовок = Заголовок;
	Контекст = Контекст;
	Возврат ?(ТипЗнч(Содержимое) = Тип("Строка"), Содержимое, Содержимое.Рендер());
КонецФункции

// Контекст запроса; замеру он безразличен.
//
// Параметры:
//  Пользователь - Произвольный - читатель.
//  КукиЗапроса - Произвольный - куки читателя.
//  ПоказатьАдмин - Булево - показывать ли админские дороги.
//  Приватная - Булево - приватная ли страница.
//  Путь - Строка - адрес открытого экрана.
//  Сессия - Произвольный - сессия, прочитанная стражем (необязательный).
//
// Возвращаемое значение:
//  Неопределено.
//
Функция КонтекстСтраницы(Знач Пользователь, Знач КукиЗапроса, Знач ПоказатьАдмин = Ложь,
	Знач Приватная = Ложь, Знач Путь = "", Знач Сессия = Неопределено) Экспорт

	Пользователь = Пользователь;
	КукиЗапроса = КукиЗапроса;
	ПоказатьАдмин = ПоказатьАдмин;
	Приватная = Приватная;
	Путь = Путь;
	Сессия = Сессия;
	Возврат Неопределено;

КонецФункции

// Основной пул хаба. Пока тест его не назначил, пула нет: блок быстрого старта печатает
// объяснение и в базу не ходит.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - назначенный пул.
//
Функция ДефолтныйПул() Экспорт
	Возврат Основной;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Новинки = Новый Массив();
	Популярные = Новый Массив();
	Пулы = Новый Массив();
КонецПроцедуры
