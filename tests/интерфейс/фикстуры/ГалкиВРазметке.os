// Галки форм в разметке страницы: тег галки по имени поля — для сторожей дерева получателей
// и формы поправки, юнитов и живых.

// Открывающий тег галки с этим именем поля целиком.
//
// Параметры:
//  HTML - Строка - разметка страницы или секции.
//  ИмяПоля - Строка - имя галки в форме.
//
// Возвращаемое значение:
//  Строка - тег от «<» до «>»; галки нет — исключение с её именем.
//
Функция Тег(Знач HTML, Знач ИмяПоля) Экспорт

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон("Галка %1 не напечатана", ИмяПоля);
	КонецЕсли;
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Имена всех галок с этой приставкой имени, по порядку на странице.
//
// Параметры:
//  HTML - Строка - разметка страницы или секции.
//  Приставка - Строка - начало имени поля («получатель_пакет_»).
//
// Возвращаемое значение:
//  Массив из Строка - имена полей.
//
Функция Имена(Знач HTML, Знач Приставка) Экспорт

	Результат = Новый Массив();
	Метка = "name=""" + Приставка;
	Хвост = HTML;
	Позиция = СтрНайти(Хвост, Метка);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина("name="""));
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
		Позиция = СтрНайти(Хвост, Метка);
	КонецЦикла;
	Возврат Результат;

КонецФункции
