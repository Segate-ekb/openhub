// Галки дерева в разметке страницы: тег галки узла по её ключу (значению) и тело формы, которое
// отправит браузер без скрипта, — для сторожей окна «Получатели» и «Пакеты пула», юнитов и живых.
// Ключ узла — значение галки: «пакет_42», «пул_7».

// Открывающий тег галки узла целиком.
//
// Параметры:
//  HTML - Строка - разметка страницы или окна.
//  Ключ - Строка - значение галки (ключ узла).
//  ИмяПоля - Строка - имя галки в форме (необязательный, по умолчанию «галка» — галки дерева).
//
// Возвращаемое значение:
//  Строка - тег от «<» до «>»; галки нет — исключение с её ключом.
//
Функция Тег(Знач HTML, Знач Ключ, Знач ИмяПоля = "галка") Экспорт

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """ value=""" + Ключ + """");
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон("Галка %1 (%2) не напечатана", Ключ, ИмяПоля);
	КонецЕсли;
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Напечатана ли галка узла.
//
// Параметры:
//  HTML - Строка - разметка страницы или окна.
//  Ключ - Строка - значение галки.
//  ИмяПоля - Строка - имя галки (необязательный, по умолчанию «галка»).
//
// Возвращаемое значение:
//  Булево.
//
Функция Есть(Знач HTML, Знач Ключ, Знач ИмяПоля = "галка") Экспорт
	Возврат СтрНайти(HTML, "name=""" + ИмяПоля + """ value=""" + Ключ + """") > 0;
КонецФункции

// Ключи всех галок с этим именем и приставкой ключа, по порядку на странице.
//
// Параметры:
//  HTML - Строка - разметка страницы или окна.
//  Приставка - Строка - начало ключа («пакет_»).
//  ИмяПоля - Строка - имя галки (необязательный, по умолчанию «галка»).
//
// Возвращаемое значение:
//  Массив из Строка - ключи.
//
Функция Ключи(Знач HTML, Знач Приставка, Знач ИмяПоля = "галка") Экспорт

	Результат = Новый Массив();
	Метка = "name=""" + ИмяПоля + """ value=""" + Приставка;
	Хвост = HTML;
	Позиция = СтрНайти(Хвост, Метка);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина("name=""" + ИмяПоля + """ value="""));
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
		Позиция = СтрНайти(Хвост, Метка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Тело формы окна, которое отправит браузер без скрипта: поля в порядке разметки — скрытые
// и текстовые значением, отмеченные галки и радиокнопки, кроме закрытых, — после того как человек
// сделал названное. Так сторож шлёт ровно то, что напечатал сервер, а не тело, собранное руками.
//
// Параметры:
//  HTML - Строка - разметка окна (одной формы).
//  Действия - Строка - через «&», по порядку: «галка:<ключ>» — щёлкнуть галку дерева (снять
//             отмеченную, отметить снятую); «режим:<ветка>=<режим>» — выбрать сегмент режима;
//             «<имя>=<значение>» — щёлкнуть галку с этим именем и значением (крестик ряда
//             отмеченного: «снять=пакет_42»), а без такой галки — нажать кнопку с этим именем
//             и значением («найденные=выкл»). Необязательный, по умолчанию — ничего.
//
// Возвращаемое значение:
//  Строка - тело application/x-www-form-urlencoded.
//
Функция ФормаБезСкрипта(Знач HTML, Знач Действия = "") Экспорт

	Поля = ПоляФормы(HTML);
	Кнопки = Новый Массив();
	Для Каждого Действие Из СтрРазделить(Действия, "&", Ложь) Цикл
		Если СтрНачинаетсяС(Действие, "галка:") Тогда
			Щёлкнуть(Поля, "галка", Сред(Действие, СтрДлина("галка:") + 1));
			Продолжить;
		КонецЕсли;
		Равно = СтрНайти(Действие, "=", НаправлениеПоиска.СКонца);
		Имя = Лев(Действие, Равно - 1);
		Значение = Сред(Действие, Равно + 1);
		Если СтрНачинаетсяС(Имя, "режим:") Тогда
			ВыбратьРадио(Поля, Имя, Значение);
		ИначеЕсли НЕ Щёлкнуть(Поля, Имя, Значение, Истина) Тогда
			Кнопки.Добавить(Новый Структура("Имя, Значение", Имя, Значение));
		КонецЕсли;
	КонецЦикла;

	Пары = Новый Массив();
	Для Каждого Поле Из Поля Цикл
		Если Поле.Закрыто ИЛИ (Поле.Флажок И НЕ Поле.Отмечено) Тогда
			Продолжить;
		КонецЕсли;
		Пары.Добавить(Код(Поле.Имя) + "=" + Код(Поле.Значение));
	КонецЦикла;
	Для Каждого Кнопка Из Кнопки Цикл
		Пары.Добавить(Код(Кнопка.Имя) + "=" + Код(Кнопка.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Пары, "&");

КонецФункции

// Поля формы по порядку разметки: Имя, Значение, Флажок (галка или радиокнопка), Радио, Отмечено,
// Закрыто. Поля без имени и кнопки не отправляются.
Функция ПоляФормы(Знач HTML)

	Результат = Новый Массив();
	Хвост = HTML;
	Позиция = СтрНайти(Хвост, "<input");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Тег = Лев(Хвост, СтрНайти(Хвост, ">"));
		Хвост = Сред(Хвост, СтрДлина(Тег) + 1);
		Позиция = СтрНайти(Хвост, "<input");
		Имя = Атрибут(Тег, "name");
		Тип = НРег(Атрибут(Тег, "type"));
		Если Имя = Неопределено ИЛИ Тип = "submit" ИЛИ Тип = "button" Тогда
			Продолжить;
		КонецЕсли;
		Значение = Атрибут(Тег, "value");
		Флажок = Тип = "checkbox" ИЛИ Тип = "radio";
		Результат.Добавить(Новый Структура("Имя, Значение, Флажок, Радио, Отмечено, Закрыто", Имя,
			?(Значение = Неопределено, ?(Флажок, "on", ""), Значение), Флажок, Тип = "radio",
			ЕстьСлово(Тег, "checked"), ЕстьСлово(Тег, "disabled")));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Щёлкает галку с этим именем и значением; Отметить — только отмечает. Галки нет — Ложь.
Функция Щёлкнуть(Поля, Знач Имя, Знач Значение, Знач Отметить = Ложь)

	Нашлась = Ложь;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Флажок И НЕ Поле.Радио И Поле.Имя = Имя И Поле.Значение = Значение И НЕ Поле.Закрыто Тогда
			Поле.Отмечено = Отметить ИЛИ НЕ Поле.Отмечено;
			Нашлась = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Нашлась;

КонецФункции

Процедура ВыбратьРадио(Поля, Знач Имя, Знач Значение)

	Нашлась = Ложь;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Радио И Поле.Имя = Имя Тогда
			Поле.Отмечено = Поле.Значение = Значение;
			Нашлась = Нашлась ИЛИ Поле.Отмечено;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Нашлась Тогда
		ВызватьИсключение СтрШаблон("Сегмента %1=%2 в форме нет", Имя, Значение);
	КонецЕсли;

КонецПроцедуры

Функция Атрибут(Знач Тег, Знач Имя)
	Метка = " " + Имя + "=""";
	Позиция = СтрНайти(Тег, Метка);
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хвост = Сред(Тег, Позиция + СтрДлина(Метка));
	Возврат Раскрыть(Лев(Хвост, СтрНайти(Хвост, """") - 1));
КонецФункции

Функция ЕстьСлово(Знач Тег, Знач Слово)
	Возврат СтрНайти(Тег, " " + Слово + " ") > 0 ИЛИ СтрНайти(Тег, " " + Слово + ">") > 0
		ИЛИ СтрНайти(Тег, " " + Слово + "=") > 0 ИЛИ СтрНайти(Тег, " " + Слово + "/") > 0;
КонецФункции

Функция Раскрыть(Знач Текст)
	Для Каждого Пара Из СтрРазделить("&quot;="";&#34;="";&#39;=';&#x27;=';&lt;=<;&gt;=>", ";") Цикл
		Текст = СтрЗаменить(Текст, Лев(Пара, СтрНайти(Пара, "=") - 1), Сред(Пара, СтрНайти(Пара, "=") + 1));
	КонецЦикла;
	Возврат СтрЗаменить(Текст, "&amp;", "&");
КонецФункции

Функция Код(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции
