// Окружение таблицы пулов хаба для замера цены экрана: пулы, занятое место, число пакетов и владельцы
// отвечают из памяти и считают обращения по дверям — как служба пулов, служба пакетов и служба учёток.

Перем Пулы_;     // Массив из ПулХабаСписка
Перем Счётчик;   // СчётчикОбращений — обращения по дверям

// Заводит пул: личное пространство каждого третьего, владелец — учётка с тем же номером.
//
// Параметры:
//  Номер - Число - номер пула, он же идентификатор и владелец.
//
Процедура Завести(Знач Номер) Экспорт
	Тип = ?(Номер = 1, "default", ?(Номер % 3 = 0, "user", "custom"));
	Пулы_.Добавить(Новый ПулХабаСписка(Номер, "pool" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"), Тип, Номер));
КонецПроцедуры

// Обращения по двери.
//
// Параметры:
//  Дверь - Строка - имя двери.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений(Знач Дверь) Экспорт
	Возврат Счётчик.ОбращенийВ(Дверь);
КонецФункции

// Все обращения.
//
// Возвращаемое значение:
//  Число.
//
Функция Всего() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

#Область СервисПулов

// Все пулы хаба.
//
// Возвращаемое значение:
//  Массив из ПулХабаСписка.
//
Функция ВсеПулы() Экспорт
	Счётчик.Отметить("ВсеПулы");
	Возврат Пулы_;
КонецФункции

// Занятое место пулов одним чтением.
//
// Параметры:
//  Пулы - Массив - пулы страницы.
//
// Возвращаемое значение:
//  Соответствие - идентификатор -> байты.
//
Функция ЗанятоПулами(Знач Пулы) Экспорт
	Счётчик.Отметить("ЗанятоПулами");
	Результат = Новый Соответствие();
	Для Каждого Пул Из Пулы Цикл
		Результат.Вставить(Пул.Идентификатор, 1024 * Пул.Идентификатор);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Действующая квота: у каждого второго — без предела, у остальных — мегабайт.
//
// Параметры:
//  Пул - ПулХабаСписка - пул.
//
// Возвращаемое значение:
//  Число - байты.
//
Функция ЭффективнаяКвотаБайт(Знач Пул) Экспорт
	Возврат ?(Пул.Идентификатор % 2 = 0, 0, 1024 * 1024);
КонецФункции

// Квота «как в хабе».
//
// Возвращаемое значение:
//  Число.
//
Функция КвотаКакВХабе() Экспорт
	Возврат -1;
КонецФункции

#КонецОбласти

#Область СервисПакетов

// Число нескрытых пакетов по пулам одним разрезом.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число.
//
// Возвращаемое значение:
//  Соответствие - идентификатор -> число.
//
Функция КоличествоВидимыхПакетовПоПулам(Знач ПулИдентификаторы) Экспорт
	Счётчик.Отметить("Пакеты");
	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из ПулИдентификаторы Цикл
		Результат.Вставить(Идентификатор, Идентификатор % 4);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СервисПользователей

// Учётки владельцев одним разрезом.
//
// Параметры:
//  Идентификаторы - Массив из Число.
//
// Возвращаемое значение:
//  Соответствие - идентификатор -> Структура (Идентификатор, Логин).
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт
	Счётчик.Отметить("Учётки");
	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Результат.Вставить(Идентификатор, Новый Структура("Идентификатор, Логин", Идентификатор,
			"owner" + Формат(Идентификатор, "ЧГ=0")));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("ПулХабаСписка");
	РеестрФикстур.Подключить("СчётчикОбращений");
	Пулы_ = Новый Массив();
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
