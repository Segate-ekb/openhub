// Окружение каталога /packages без базы: выдача каталога готовой страницей, гвард онбординга,
// принципал и каркас. Экран спрашивает выдачу один раз; что он спросил, окружение запоминает.

Перем Пакеты;       // Массив из Структура (Пакет, Пул) — выдача, которую отдаст каталог
Перем Всего;        // Число — найдено до страниц; Неопределено — сколько пакетов в выдаче
Перем ВсегоСтраниц; // Число — страниц выдачи
Перем Читатель;     // вошедший пользователь; Неопределено — гость
Перем Спрошено Экспорт; // Структура (Запрос, Страница, Отбор) — с чем экран спросил каталог

#Область НаполнениеФикстуры

// Кладёт пакет в выдачу каталога.
//
// Параметры:
//  Номер - Число - идентификатор пакета.
//  Имя - Строка - имя пакета.
//  Пул - ПулЗаглушка - пул пакета.
//
Процедура ДобавитьПакет(Знач Номер, Знач Имя, Знач Пул) Экспорт

	Пакет = Новый Структура("Идентификатор, ПулИдентификатор, Имя, ИмяНижнийРегистр,"
		+ " Описание, Устарел, Скрыт, ПоследняяПубликация",
		Номер, Пул.Идентификатор, Имя, НРег(Имя), "", Ложь, Ложь, '20260101120000');
	Пакеты.Добавить(Новый Структура("Пакет, Пул", Пакет, Пул));

КонецПроцедуры

// Выдача — одна страница из многих.
//
// Параметры:
//  Найдено - Число - найдено пакетов до страниц.
//  Страниц - Число - страниц выдачи.
//
Процедура ЗадатьСтраницы(Знач Найдено, Знач Страниц) Экспорт
	Всего = Найдено;
	ВсегоСтраниц = Страниц;
КонецПроцедуры

// Каталог смотрит вошедший, а не гость.
//
// Параметры:
//  Пользователь - Произвольный - вошедший пользователь.
//
Процедура Войти(Знач Пользователь) Экспорт
	Читатель = Пользователь;
КонецПроцедуры

#КонецОбласти

#Область Каталог

// Выдача каталога: заданные пакеты как одна страница, запрос и отбор — как их нормализовал бы
// каталог (номер страницы больше последней читается последней).
//
// Параметры:
//  Запрос - Строка - подстрока имени.
//  Страница - Число - номер страницы.
//  РазмерСтраницы - Число - размер страницы.
//  Принципал - Произвольный - принципал запроса.
//  Отбор - Структура - Пул, ТолькоУправляемые.
//
// Возвращаемое значение:
//  Структура - Элементы, Всего, Страница, ВсегоСтраниц, РазмерСтраницы, Запрос, Отбор.
//
Функция НайтиПакеты(Знач Запрос = "", Знач Страница = 1, Знач РазмерСтраницы = 0,
	Знач Принципал = Неопределено, Знач Отбор = Неопределено) Экспорт

	Принципал = Принципал;
	Спрошено = Новый Структура("Запрос, Страница, Отбор", Запрос, Страница, Отбор);

	Результат = Новый Структура();
	Результат.Вставить("Элементы", Пакеты);
	Результат.Вставить("Всего", ?(Всего = Неопределено, Пакеты.Количество(), Всего));
	Результат.Вставить("Страница", Мин(Страница, ВсегоСтраниц));
	Результат.Вставить("ВсегоСтраниц", ВсегоСтраниц);
	Результат.Вставить("РазмерСтраницы", ?(РазмерСтраницы > 0, РазмерСтраницы, 20));
	Результат.Вставить("Запрос", СокрЛП(Запрос));
	Результат.Вставить("Отбор", Отбор);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ГвардПринципалИКаркас

// Онбординг пройден: каталог открыт.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера, заглушкой не трогается.
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево).
//
Функция Проверить(Ответ) Экспорт
	Ответ = Ответ;
	Возврат Новый Структура("Разрешено", Истина);
КонецФункции

// Читатель — гость, пока тест не вошёл.
//
// Параметры:
//  ЗаголовкиЗапроса - Произвольный - заголовки, заглушкой не трогаются.
//  КукиЗапроса - Произвольный - куки, заглушкой не трогаются.
//
// Возвращаемое значение:
//  Структура - Пользователь, Принципал, Сессия (сессии у заглушки нет).
//
Функция ОпределитьПринципала(Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	Возврат Новый Структура("Пользователь, Принципал, Сессия", Читатель, Неопределено, Неопределено);
КонецФункции

// Каркас отдаёт содержимое страницы без обрамления.
//
// Параметры:
//  Заголовок - Строка - заголовок вкладки.
//  Содержимое - ЭлементЭкрана, Строка - содержимое страницы.
//  Контекст - Произвольный - контекст запроса.
//
// Возвращаемое значение:
//  Строка - напечатанное содержимое.
//
Функция Страница(Знач Заголовок, Знач Содержимое, Знач Контекст) Экспорт
	Заголовок = Заголовок;
	Контекст = Контекст;
	Возврат ?(ТипЗнч(Содержимое) = Тип("Строка"), Содержимое, Содержимое.Рендер());
КонецФункции

// Контекст запроса; окружению он безразличен.
//
// Параметры:
//  Пользователь - Произвольный - смотрящий.
//  КукиЗапроса - Произвольный - куки.
//  ПоказатьАдмин - Булево - (необязательный).
//  Приватная - Булево - (необязательный).
//  Путь - Строка - (необязательный) путь страницы.
//  Сессия - Произвольный - (необязательный) сессия, прочитанная стражем.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция КонтекстСтраницы(Знач Пользователь, Знач КукиЗапроса, Знач ПоказатьАдмин = Ложь,
	Знач Приватная = Ложь, Знач Путь = "", Знач Сессия = Неопределено) Экспорт

	Пользователь = Пользователь;
	КукиЗапроса = КукиЗапроса;
	ПоказатьАдмин = ПоказатьАдмин;
	Приватная = Приватная;
	Путь = Путь;
	Сессия = Сессия;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Пакеты = Новый Массив();
	ВсегоСтраниц = 1;
КонецПроцедуры
