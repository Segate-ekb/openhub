// Заглушка гварда дома «Пул»: допуск и пул раздела задаются тестом.

Перем Разрешено_;
Перем Логин_;
Перем Пул_;
Перем Учётка_;   // учётка вердикта вместо учётки-структуры по логину: права судит настоящий сервис

// Вердикт допуска к разделу дома «Пул».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  ИмяПула - Строка - имя пула из адреса.
//
// Возвращаемое значение:
//  Структура - Разрешено, Принципал, Пользователь, Сессия, Пул.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула) Экспорт

	// настоящий гвард, не впустив, отвечает сам и тела не пишет
	Если НЕ Разрешено_ И ТипЗнч(Ответ) <> Тип("Неопределено") Тогда
		Ответ.Код = 403;
	КонецЕсли;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	ИмяПула = ИмяПула;

	Если Учётка_ <> Неопределено Тогда
		Пользователь = Учётка_;
	Иначе
		Пользователь = ?(ЗначениеЗаполнено(Логин_), Новый Структура("Логин, Админ, Идентификатор", Логин_, Истина, 1),
			Неопределено);
	КонецЕсли;

	Возврат Новый Структура("Разрешено, Принципал, Пользователь, Сессия, Пул",
		Разрешено_, Пользователь, Пользователь, "сессия", Пул_);

КонецФункции

// Впускает пользователя в раздел указанного пула.
//
// Параметры:
//  Логин - Строка - логин пользователя сессии.
//  Пул - Произвольный - пул раздела.
//
Процедура Впустить(Знач Логин, Знач Пул) Экспорт
	Разрешено_ = Истина;
	Логин_ = Логин;
	Пул_ = Пул;
	Учётка_ = Неопределено;
КонецПроцедуры

// Впускает настоящую учётку: право уровня хаба (квота, удаление пула) судит по ней сервис прав.
//
// Параметры:
//  Учётка - Пользователь - учётка сессии.
//  Пул - Произвольный - пул раздела.
//
Процедура ВпуститьУчётку(Знач Учётка, Знач Пул) Экспорт
	Разрешено_ = Истина;
	Логин_ = Учётка.Логин;
	Пул_ = Пул;
	Учётка_ = Учётка;
КонецПроцедуры

// Больше не впускает никого, но вердикт по-прежнему несёт пул и учётку.
//
Процедура НеВпускать() Экспорт
	Разрешено_ = Ложь;
КонецПроцедуры

// Отказывает посторонней учётке, но вердикт несёт пул: контроллер, забывший спросить
// «Разрешено», дошёл бы до записи — и сторож увидит мутацию, а не падение.
//
// Параметры:
//  Логин - Строка - логин постороннего.
//  Пул - Произвольный - пул раздела.
//
Процедура Отказать(Знач Логин, Знач Пул) Экспорт
	Разрешено_ = Ложь;
	Логин_ = Логин;
	Пул_ = Пул;
	Учётка_ = Неопределено;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Разрешено_ = Ложь;
	Логин_ = "";
	Пул_ = Неопределено;
КонецПроцедуры
