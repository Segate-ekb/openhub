// Стенд витрины раздела «Подписки»: граф панели подписок поверх фейков домена — сервиса подписок,
// поправок, исключений и предпросмотра — и настоящих рендеров настроек; разметка раздела — внутри
// дома настроек, как на странице: формы берут адрес и токен у дома. Классы панели подключает набор.

Перем Имена Экспорт;        // ИменаПолейПодписки
Перем Каталог Экспорт;      // КаталогДействийПодписки
Перем Окна Экспорт;         // ОкноРаздела
Перем Поля Экспорт;         // ПоляПодписки
Перем Разбор Экспорт;       // РазборФормыПодписки
Перем ПоляСобытий Экспорт;  // ПоляСобытийПодписки
Перем Проверка Экспорт;     // ПроверкаПодпискиДоСохранения
Перем Витрина Экспорт;      // ВитринаПодписок
Перем Сверху Экспорт;       // ВитринаПодписокСверху
Перем Получатели Экспорт;   // ПолучателиЗаписи
Перем ОкноПолучателей Экспорт; // ОкноПолучателей
Перем Правило Экспорт;      // ПравилоДереваПолучателей
Перем Исключения Экспорт;   // ФейкСервисИсключений
Перем Поправки Экспорт;     // ФейкСервисПоправок
Перем Предпросмотр Экспорт; // ФейкПредпросмотрУведомления
Перем Сервис Экспорт;       // фейк службы подписок
Перем Каналы Экспорт;       // ФейкКаналыПакетов — теги пулов и пакетов
Перем Пулы Экспорт;         // ФейкСервисПулов — имена пулов в «кто сузил»
Перем Пакеты Экспорт;       // ФейкПакетыПоИдентификатору — имена пакетов в «кто сузил»

Перем UI;

// Параметры витрины своих подписок: пул «main» по умолчанию, зритель вправе менять.
//
// Параметры:
//  ТипОбъекта - Строка - «хаб», «пул» либо «пакет» (необязательный, по умолчанию «пул»).
//  Окно - Структура, Неопределено - состояние окна раздела (необязательный, по умолчанию Неопределено).
//  Идентификатор - Число - объект раздела; пул объекта — всегда 3 (необязательный, по умолчанию 3).
//
// Возвращаемое значение:
//  Структура - параметры ВитриныПодписок и ВитриныПодписокСверху.
//
Функция Параметры(Знач ТипОбъекта = "пул", Знач Окно = Неопределено, Знач Идентификатор = 3) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Объект", Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор",
		ТипОбъекта, Идентификатор, 3));
	Результат.Вставить("Адрес", Адрес());
	Результат.Вставить("Токен", "csrf-токен");
	Результат.Вставить("Пояснение", "Пояснение раздела.");
	Результат.Вставить("МожноМенять", Истина);
	Результат.Вставить("Окно", Окно);
	Результат.Вставить("НовыйСекрет", "");
	Результат.Вставить("Проба", Неопределено);
	Результат.Вставить("Предпросмотр", Неопределено);
	Результат.Вставить("Зритель", Неопределено);
	Результат.Вставить("ВидДерева", Новый Структура("Найти, Ветка, Страница", "", "", 1));
	Результат.Вставить("АдресТегов", "/pools/main/settings/tags");
	Результат.Вставить("ПослеСписка", Неопределено);
	Результат.Вставить("ИмяПула", "main");
	Возврат Результат;

КонецФункции

// Адрес раздела стенда.
//
// Возвращаемое значение:
//  Строка.
//
Функция Адрес() Экспорт
	Возврат "/pools/main/settings/webhooks";
КонецФункции

// Разметка секций внутри дома настроек.
//
// Параметры:
//  Секции - Массив из ЭлементЭкрана - секции витрины.
//
// Возвращаемое значение:
//  Строка - HTML.
//
Функция Разметка(Знач Секции) Экспорт

	Дом = UI.Кит.ДомНастроек("Настройки", Адрес(), "csrf-токен");
	Для Каждого Секция Из Секции Цикл
		Дом.Добавить(Секция);
	КонецЦикла;
	Возврат Дом.Рендер();

КонецФункции

// Разметка раздела «Подписки сверху» стенда.
//
// Параметры:
//  Параметры - Структура - параметры витрины (см. Параметры).
//
// Возвращаемое значение:
//  Строка - HTML; "" — раздела нет.
//
Функция РазделСверху(Знач Параметры) Экспорт
	Секции = Сверху.Секции(Параметры);
	Возврат ?(Секции.Количество() = 0, "", Разметка(Секции));
КонецФункции

// Разметка своего раздела стенда — витрина с параметрами.
//
// Параметры:
//  Параметры - Структура - параметры витрины (см. Параметры).
//
// Возвращаемое значение:
//  Строка - HTML.
//
Функция Раздел(Знач Параметры) Экспорт
	Возврат Разметка(Витрина.Секции(Параметры));
КонецФункции

Процедура ПриСозданииОбъекта(Знач _UI, Знач _Сервис, Знач Реестр, Знач _Поправки = Неопределено,
	Знач _Исключения = Неопределено, Знач _Каналы = Неопределено, Знач _Пулы = Неопределено,
	Знач _Пакеты = Неопределено) Экспорт

	UI = _UI;
	Сервис = _Сервис;
	Каналы = ?(_Каналы = Неопределено, Новый ФейкКаналыПакетов(), _Каналы);
	Пулы = ?(_Пулы = Неопределено, Новый ФейкСервисПулов(), _Пулы);
	Пакеты = ?(_Пакеты = Неопределено, Новый ФейкПакетыПоИдентификатору(), _Пакеты);
	Поправки = ?(_Поправки = Неопределено, Новый ФейкСервисПоправок(), _Поправки);
	Исключения = ?(_Исключения = Неопределено, Новый ФейкСервисИсключений(), _Исключения);
	Предпросмотр = Новый ФейкПредпросмотрУведомления();
	ЧтениеФормы = Новый РазборФормы();
	Ссылки = Новый ПараметрыСсылки();

	Имена = Новый ИменаПолейПодписки(Новый ЗащитаCSRF(Неопределено), UI.Кит);
	Каталог = Новый КаталогДействийПодписки(Реестр, UI.Тексты, Имена);
	Окна = Новый ОкноРаздела(Ссылки, Новый ОтметкаСохранения(Ссылки),
		Новый Подтверждение(UI.Набор, UI.Тексты, Новый Окно(UI.Экран, UI.Набор, UI.Тексты)));
	Поля = Новый ПоляПодписки(UI.Кит, UI.Тексты, Окна, Имена, Каталог);
	Разбор = Новый РазборФормыПодписки(ЧтениеФормы, UI.Тексты, Имена, Каталог);

	События = Новый ФейкКаталогСобытий();
	Сохранённые = Новый ПараметрыПодписки(События);
	ПоляСобытий = Новый ПоляСобытийПодписки(UI.Кит, Сервис, События, Сохранённые, Имена, Окна, UI.Тексты);
	ПоляСвойств = Новый ПоляСвойствПодписки(UI.Кит, Сохранённые, Имена, Окна, UI.Тексты);
	Отбор = Новый ОтборПоТегам(Каналы, Каналы, Новый ИздательСобытий());
	ОтборТегов = Новый ОтборТеговПодписки(UI.Кит, Отбор, Имена, ЧтениеФормы, Окна, UI.Тексты);
	Счёт = Новый СчётСловами(UI.Тексты);
	ИменаПодписок = Новый ИменаПодписок(Сохранённые, UI.Тексты);
	Правило = Новый ПравилоДереваПолучателей(UI.Кит, ЧтениеФормы, Имена, Исключения);
	ОкноПолучателей = Новый ОкноПолучателей(UI.Кит, UI.Тексты, Исключения, Поправки, Правило, Окна,
		Имена, ИменаПодписок, Счёт);
	Получатели = Новый ПолучателиЗаписи(UI.Кит, UI.Тексты, Исключения, Имена, Счёт, ОкноПолучателей);
	Срезы = Новый СрезПодписок(Поправки, Исключения, Пулы, Пакеты, Получатели);
	Сузившие = Новый ПоправкиНижестоящих(UI.Кит, Срезы, Сохранённые, ПоляСобытий, Отбор, UI.Тексты, Счёт);
	Записи = Новый ЗаписьПодписки(UI.Кит, UI.Тексты, Сервис, Сохранённые, Поправки, Исключения, Каталог,
		ПоляСобытий, ОтборТегов, Получатели, Сузившие, Срезы, Окна, Имена, ИменаПодписок, Счёт);
	Проверка = Новый ПроверкаПодпискиДоСохранения(UI.Кит, UI.Тексты, Имена, Каталог, Предпросмотр, Реестр);
	ОкноПодписки = Новый ОкноПодписки(UI.Кит, Окна, Сервис, Поправки, Сохранённые, Поля, ПоляСобытий,
		ПоляСвойств, ОтборТегов, Проверка, Каталог, Имена, ИменаПодписок, UI.Тексты);
	Витрина = Новый ВитринаПодписок(UI.Кит, Сервис, Записи, Срезы, ОкноПодписки, ОкноПолучателей, Исключения, Окна,
		UI.Тексты);
	Сверху = Новый ВитринаПодписокСверху(UI.Кит, Поправки, Сервис, Записи, Срезы, ПоляСобытий, ОтборТегов, Окна,
		ОкноПолучателей, Имена, ИменаПодписок, UI.Тексты);

КонецПроцедуры
