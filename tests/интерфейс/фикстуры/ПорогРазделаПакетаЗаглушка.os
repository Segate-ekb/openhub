// Заглушка порога раздела дома пакета: доверие CI и удаление пакета отвечают заданным флагом.

Перем Открыт;

// Может ли смотрящий настраивать доверенную публикацию пакета.
//
// Параметры:
//  Пользователь - Произвольный - смотрящий.
//  Пакет - Произвольный - пакет.
//
// Возвращаемое значение:
//  Булево - заданный флаг.
//
Функция МожетНастраивать(Знач Пользователь, Знач Пакет) Экспорт
	Возврат Открыт;
КонецФункции

// Может ли смотрящий удалить пакет.
//
// Параметры:
//  Пользователь - Произвольный - смотрящий.
//  Пакет - Произвольный - пакет.
//
// Возвращаемое значение:
//  Булево - заданный флаг.
//
Функция МожетУдалять(Знач Пользователь, Знач Пакет) Экспорт
	Возврат Открыт;
КонецФункции

Процедура ПриСозданииОбъекта(Знач _Открыт)
	Открыт = _Открыт;
КонецПроцедуры
