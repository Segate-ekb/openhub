// Пул для списка пулов: имя, тип, видимость и признаки основного и личного пространства —
// то, по чему список пулов называет пул словами.

Перем Идентификатор Экспорт;
Перем Имя Экспорт;
Перем Тип Экспорт;
Перем Видимость Экспорт;

// Основной ли это пул хаба.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоДефолтный() Экспорт
	Возврат Тип = "default";
КонецФункции

// Личное ли это пространство пользователя.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоЛичный() Экспорт
	Возврат Тип = "user";
КонецФункции

Процедура ПриСозданииОбъекта(Знач ЗначениеИд, Знач ЗначениеИмя, Знач ЗначениеТип = "custom",
	Знач ЗначениеВидимость = "public")

	Идентификатор = Цел(ЗначениеИд);
	Имя = ЗначениеИмя;
	Тип = ЗначениеТип;
	Видимость = ЗначениеВидимость;

КонецПроцедуры
