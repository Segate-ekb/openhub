// СервисПулов в памяти для экранов: чтение считает обращения, записи квоты и видимости
// запоминаются, вердикт по квоте выносит настоящее правило КвотаПула, если его дали.

Перем Пулы;             // Массив — заведённые пулы в порядке заведения
Перем Счётчик;          // СчётчикОбращений — счёт обращений на чтение
Перем ПравилоКвоты;     // КвотаПула (реестр) либо Неопределено
Перем ЗаписиКвоты;      // Массив из Число — квоты в порядке записи
Перем ЗаписиВидимости;  // Массив из Строка — видимости в порядке записи
Перем ЗапретВидимости;  // Строка — причина, которой отвечает ПроблемаВидимости
Перем РонятьЗаписьКвоты;

#Область Наполнение

// Заводит пул; за обращение не считается.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//  Имя - Строка - имя пула.
//  Видимость - Строка - public либо private (необязательный, по умолчанию public).
//  Личный - Булево - личное ли это пространство (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  РазрезПул - заведённый пул.
//
Функция ДобавитьПул(Знач Идентификатор, Знач Имя, Знач Видимость = "public", Знач Личный = Ложь) Экспорт
	Пул = Новый РазрезПул(Идентификатор, Имя, Личный, Видимость);
	Пулы.Добавить(Пул);
	Возврат Пул;
КонецФункции

// Кладёт готовый пул: экранам зеркал нужны его поля Имя и ПубликацияРазрешена.
//
// Параметры:
//  Пул - Произвольный - пул.
//
Процедура ПоложитьПул(Знач Пул) Экспорт
	Пулы.Добавить(Пул);
КонецПроцедуры

// Заставляет фикстуру отвергать приватную видимость с заданной причиной.
//
// Параметры:
//  Причина - Строка - причина отказа.
//
Процедура ЗапретитьПриватность(Знач Причина) Экспорт
	ЗапретВидимости = Причина;
КонецПроцедуры

// Заставляет фикстуру ронять запись квоты.
Процедура РонятьКвоту() Экспорт
	РонятьЗаписьКвоты = Истина;
КонецПроцедуры

#КонецОбласти

#Область Наблюдение

// Сколько раз службу спросили на чтение с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Квоты в порядке записи.
//
// Возвращаемое значение:
//  Массив из Число.
//
Функция ЗаписанныеКвоты() Экспорт
	Возврат ЗаписиКвоты;
КонецФункции

// Видимости в порядке записи.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЗаписанныеВидимости() Экспорт
	Возврат ЗаписиВидимости;
КонецФункции

#КонецОбласти

#Область Чтение

// Пул по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - пул.
//
Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Найденный(Цел(Идентификатор));
КонецФункции

// Пул по имени; считает обращение.
//
// Параметры:
//  Имя - Строка - имя пула.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - пул.
//
Функция НайтиПул(Знач Имя) Экспорт

	Счётчик.Отметить();
	Для Каждого Пул Из Пулы Цикл
		Если Пул.Имя = Имя Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Все пулы хаба; считает обращение.
//
// Возвращаемое значение:
//  Массив - заведённые пулы.
//
Функция ВсеПулы() Экспорт
	Счётчик.Отметить();
	Возврат Пулы;
КонецФункции

// Все пулы для чтения: та же дверь, что ВсеПулы, и тот же счёт обращений.
//
// Возвращаемое значение:
//  Массив - заведённые пулы.
//
Функция ПулыДляЧтения() Экспорт
	Возврат ВсеПулы();
КонецФункции

// Пулы перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение пул; ненайденных ключей в нём нет.
//
Функция ПулыПоИдентификаторам(Знач Идентификаторы) Экспорт

	Счётчик.Отметить();

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Пул = Найденный(Цел(Идентификатор));
		Если Пул <> Неопределено Тогда
			Результат.Вставить(Цел(Идентификатор), Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пулы страницы по её пакетам; считает одно обращение.
//
// Параметры:
//  Пакеты - Массив - пакеты страницы; у каждого читается ПулИдентификатор.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение пул.
//
Функция ПулыПакетов(Знач Пакеты) Экспорт

	Идентификаторы = Новый Массив();
	Для Каждого Пакет Из Пакеты Цикл
		Идентификаторы.Добавить(Цел(Пакет.ПулИдентификатор));
	КонецЦикла;
	Возврат ПулыПоИдентификаторам(Идентификаторы);

КонецФункции

// Принимает ли пул публикации.
//
// Параметры:
//  Пул - Произвольный - пул с полем ПубликацияРазрешена.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПубликацияРазрешена(Знач Пул) Экспорт
	Возврат Пул.ПубликацияРазрешена = Истина;
КонецФункции

#КонецОбласти

#Область Квота

// Правило квоты — целиком из КвотаПула: и чтение сырого значения, и вердикт.
//
// Параметры:
//  Сырое - Произвольный - значение поля квоты.
//
// Возвращаемое значение:
//  Структура - Успех, Причина, Квота.
//
Функция РассудитьКвоту(Знач Сырое) Экспорт
	Возврат ПравилоКвоты.Рассудить(Сырое);
КонецФункции

// Вердикт по уже разобранному числу.
//
// Параметры:
//  КвотаМб - Число, Неопределено - квота в МБ.
//
// Возвращаемое значение:
//  Структура - Успех, Причина, Квота.
//
Функция ПроверитьКвоту(Знач КвотаМб) Экспорт
	Возврат ПравилоКвоты.Проверить(КвотаМб);
КонецФункции

// Значение квоты «как в хабе».
//
// Возвращаемое значение:
//  Число.
//
Функция КвотаКакВХабе() Экспорт
	Возврат ПравилоКвоты.КакВХабе();
КонецФункции

// Потолок квоты.
//
// Возвращаемое значение:
//  Число.
//
Функция ПредельнаяКвотаМб() Экспорт
	Возврат ПравилоКвоты.ПредельнаяМб();
КонецФункции

// Код причины «квота выше потолка».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаКвотаПотолок() Экспорт
	Возврат ПравилоКвоты.ПричинаПотолок();
КонецФункции

#КонецОбласти

#Область Записи

// Записывает квоту пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  КвотаМб - Число - квота в МБ.
//
Процедура УстановитьКвоту(Знач ПулИдентификатор, Знач КвотаМб) Экспорт

	Если РонятьЗаписьКвоты Тогда
		ВызватьИсключение "Запись квоты отвергнута фикстурой";
	КонецЕсли;
	ЗаписиКвоты.Добавить(Цел(Число(КвотаМб)));

КонецПроцедуры

// Записывает видимость пула; запрет, заданный фикстурой, — исключение, как у службы.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Видимость - Строка - public либо private.
//
Процедура УстановитьВидимость(Знач ПулИдентификатор, Знач Видимость) Экспорт

	Проблема = ПроблемаВидимости(ПулИдентификатор, Видимость);
	Если ЗначениеЗаполнено(Проблема) Тогда
		ВызватьИсключение Проблема;
	КонецЕсли;
	ЗаписиВидимости.Добавить(НРег(СокрЛП(Строка(Видимость))));

КонецПроцедуры

// Судит смену видимости, ничего не меняя.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Видимость - Строка - public либо private.
//
// Возвращаемое значение:
//  Строка - причина отказа; "" — смена допустима.
//
Функция ПроблемаВидимости(Знач ПулИдентификатор, Знач Видимость) Экспорт

	ПулИдентификатор = ПулИдентификатор;
	Если НРег(СокрЛП(Строка(Видимость))) = "private" Тогда
		Возврат ЗапретВидимости;
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

Функция Найденный(Знач Идентификатор)

	Для Каждого Пул Из Пулы Цикл
		Если Цел(Пул.Идентификатор) = Идентификатор Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура ПриСозданииОбъекта(Знач ПравилоКвоты_ = Неопределено)

	Пулы = Новый Массив();
	РеестрФикстур.Подключить("РазрезПул");
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();

	ПравилоКвоты = ПравилоКвоты_;
	ЗаписиКвоты = Новый Массив();
	ЗаписиВидимости = Новый Массив();
	ЗапретВидимости = "";
	РонятьЗаписьКвоты = Ложь;

КонецПроцедуры
