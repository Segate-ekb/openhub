// Фейк ПредпросмотрУведомления для экрана подписок: предпросмотр есть только у telegram, текст
// и адрес карточки — заданные, ввод последнего вызова запоминается.

Перем Текст_;         // Строка — текст, который вернёт Сообщение
Перем АдресПревью_;   // Строка — адрес карточки, который вернёт Сообщение
Перем ПоследнийВвод_; // Структура, Неопределено — ввод последнего вызова Сообщение

// Задаёт сообщение, которое вернёт предпросмотр.
//
// Параметры:
//  Текст - Строка - текст уведомления.
//  АдресПревью - Строка - адрес карточки ссылки (необязательный, по умолчанию "" — без карточки).
//
Процедура ЗадатьСообщение(Знач Текст, Знач АдресПревью = "") Экспорт
	Текст_ = Текст;
	АдресПревью_ = АдресПревью;
КонецПроцедуры

// Контракт ПредпросмотрУведомления: есть ли у типа текст до сохранения.
//
// Параметры:
//  ТипДействия - Строка - тип действия.
//
// Возвращаемое значение:
//  Булево - Истина только у telegram.
//
Функция Поддержан(Знач ТипДействия) Экспорт
	Возврат НРег(СокрЛП(ТипДействия)) = "telegram";
КонецФункции

// Контракт ПредпросмотрУведомления: сообщение по вводу формы.
//
// Параметры:
//  Пользователь - Произвольный - кто смотрит.
//  Объект - Структура - объект подписки.
//  ТипДействия - Строка - тип действия формы.
//  Ввод - Структура - ввод формы без секретов.
//  ТипыСобытий - Строка - отмеченные события.
//
// Возвращаемое значение:
//  Структура - Текст (заданный текст) и АдресПревью (заданный адрес карточки).
//
Функция Сообщение(Знач Пользователь, Знач Объект, Знач ТипДействия, Знач Ввод, Знач ТипыСобытий) Экспорт
	ПоследнийВвод_ = Ввод;
	Возврат Новый Структура("Текст, АдресПревью", Текст_, АдресПревью_);
КонецФункции

// Ввод последнего вызова Сообщение.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если Сообщение не звали.
//
Функция ПоследнийВвод() Экспорт
	Возврат ПоследнийВвод_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Текст_ = "";
	АдресПревью_ = "";
КонецПроцедуры
