// Фейк ПредпросмотрУведомления для экрана подписок: предпросмотр есть только у telegram, текст —
// заданный, ввод последнего вызова запоминается.

Перем Текст_;         // Строка — что вернёт Текст
Перем ПоследнийВвод_; // Структура, Неопределено — ввод последнего вызова Текст

// Задаёт текст, который вернёт предпросмотр.
//
// Параметры:
//  Текст - Строка - текст уведомления.
//
Процедура ЗадатьТекст(Знач Текст) Экспорт
	Текст_ = Текст;
КонецПроцедуры

// Контракт ПредпросмотрУведомления: есть ли у типа текст до сохранения.
//
// Параметры:
//  ТипДействия - Строка - тип действия.
//
// Возвращаемое значение:
//  Булево - Истина только у telegram.
//
Функция Поддержан(Знач ТипДействия) Экспорт
	Возврат НРег(СокрЛП(ТипДействия)) = "telegram";
КонецФункции

// Контракт ПредпросмотрУведомления: текст уведомления по вводу формы.
//
// Параметры:
//  Пользователь - Произвольный - кто смотрит.
//  Объект - Структура - объект подписки.
//  ТипДействия - Строка - тип действия формы.
//  Ввод - Структура - ввод формы без секретов.
//  ТипыСобытий - Строка - отмеченные события.
//
// Возвращаемое значение:
//  Строка - заданный текст.
//
Функция Текст(Знач Пользователь, Знач Объект, Знач ТипДействия, Знач Ввод, Знач ТипыСобытий) Экспорт
	ПоследнийВвод_ = Ввод;
	Возврат Текст_;
КонецФункции

// Ввод последнего вызова Текст.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если Текст не звали.
//
Функция ПоследнийВвод() Экспорт
	Возврат ПоследнийВвод_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Текст_ = "";
КонецПроцедуры
