// Заглушка ОтветыНастроек: запоминает, каким отказом ответил контроллер, и не рендерит.

Перем ПоследнийОтказ Экспорт;   // "" — отказа не было
Перем БылДом Экспорт;           // Булево — страница раздела отрисована

// Совпадает ли метод запроса с ожидаемым.
//
// Параметры:
//  МетодЗапроса - Строка - метод запроса.
//  Ожидаемый - Строка - ожидаемый метод.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоМетод(Знач МетодЗапроса, Знач Ожидаемый) Экспорт
	Возврат ВРег(СокрЛП(Строка(МетодЗапроса))) = ВРег(СокрЛП(Строка(Ожидаемый)));
КонецФункции

// Отдаёт страницу дома.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Модель - Структура - модель дома.
//  Принципал - Произвольный - принципал запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  Статус - Число - код ответа (необязательный, по умолчанию 200).
//  Путь - Строка - адрес подсветки (необязательный, по умолчанию "").
//  Дела - Произвольный - снимок дел (необязательный, по умолчанию Неопределено).
//
Процедура ОтдатьДом(Ответ, Знач Модель, Знач Принципал, Знач КукиЗапроса, Знач Статус = 200,
	Знач Путь = "", Знач Дела = Неопределено) Экспорт
	Ответ = Ответ;
	Модель = Модель;
	Принципал = Принципал;
	КукиЗапроса = КукиЗапроса;
	Статус = Статус;
	Путь = Путь;
	Дела = Дела;
	БылДом = Истина;
КонецПроцедуры

// Отказ «метод не разрешён».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Разрешённые - Строка - разрешённые методы.
//  Принципал - Произвольный - принципал запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
Процедура ОтдатьМетодНеРазрешён(Ответ, Знач Разрешённые, Знач Принципал, Знач КукиЗапроса) Экспорт
	Ответ = Ответ;
	Разрешённые = Разрешённые;
	Принципал = Принципал;
	КукиЗапроса = КукиЗапроса;
	ПоследнийОтказ = "метод";
КонецПроцедуры

// Отказ «не найдено».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Принципал - Произвольный - принципал запроса.
//  Сообщение - Строка - текст сообщения.
//  КукиЗапроса - Произвольный - куки запроса.
//
Процедура ОтдатьНеНайдено(Ответ, Знач Принципал, Знач Сообщение, Знач КукиЗапроса) Экспорт
	Ответ = Ответ;
	Принципал = Принципал;
	Сообщение = Сообщение;
	КукиЗапроса = КукиЗапроса;
	ПоследнийОтказ = "не найдено";
КонецПроцедуры

// Отказ «неверный CSRF».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Принципал - Произвольный - принципал запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  Сообщение - Строка - своя формулировка отказа (необязательный, по умолчанию "").
//
Процедура ОтдатьНеверныйCSRF(Ответ, Знач Принципал, Знач КукиЗапроса, Знач Сообщение = "") Экспорт
	Ответ = Ответ;
	Принципал = Принципал;
	КукиЗапроса = КукиЗапроса;
	Сообщение = Сообщение;
	ПоследнийОтказ = "csrf";
КонецПроцедуры

// Модель дома настроек.
//
// Параметры:
//  Дом - Произвольный - дом настроек.
//  Объект - Строка - имя настраиваемого объекта.
//  Разделы - Массив - дерево разделов.
//  Уведомления - Массив - тосты страницы.
//  Секции - Массив - секции раздела.
//  Токен - Строка - токен сессии дома (необязательный, по умолчанию "").
//  Хлебные - Массив - путь к разделу (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура.
//
Функция МодельДома(Знач Дом, Знач Объект, Знач Разделы, Знач Уведомления, Знач Секции,
	Знач Токен = "", Знач Хлебные = Неопределено) Экспорт
	Дом = Дом;
	Токен = Токен;
	Хлебные = Хлебные;
	Возврат Новый Структура("Объект, Разделы, Уведомления, Секции", Объект, Разделы,
		Уведомления, Секции);
КонецФункции

// Уведомления раздела.
//
// Параметры:
//  Сохранено - Булево - показать «сохранено».
//  Ошибка - Строка - текст ошибки.
//
// Возвращаемое значение:
//  Массив.
//
Функция УведомленияРаздела(Знач Сохранено, Знач Ошибка) Экспорт
	Сохранено = Сохранено;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ПоследнийОтказ = "ошибка: " + Ошибка;
	КонецЕсли;
	Возврат Новый Массив();
КонецФункции

// Уведомление для модели дома.
//
// Параметры:
//  Текст - Строка - текст уведомления.
//  Вид - Строка - вид уведомления (необязательный, по умолчанию "ok").
//
// Возвращаемое значение:
//  Структура.
//
Функция Уведомление(Знач Текст, Знач Вид = "ok") Экспорт
	Возврат Новый Структура("Текст, Вид", Текст, Вид);
КонецФункции

Процедура ПриСозданииОбъекта()
	ПоследнийОтказ = "";
	БылДом = Ложь;
КонецПроцедуры
