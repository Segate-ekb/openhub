// Заглушка гварда дома «Группа»: учётка, группа раздела и право правки задаются тестом; «не впускать» —
// гвард отказал и сам ответил 403 без тела, дальше запрос не идёт.

Перем Пользователь_;
Перем Группа_;
Перем МожетПравить_;
Перем Отказать_;

// Вердикт допуска к разделу дома «Группа».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  ИмяГруппы - Строка - имя группы из адреса.
//  ТребуетсяПравка - Булево - правка: участнику без права правки — отказ (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Разрешено, Принципал, Пользователь, Сессия, Группа, МожетПравить.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяГруппы, Знач ТребуетсяПравка = Ложь) Экспорт

	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	ИмяГруппы = ИмяГруппы;
	Разрешено = Отказать_ <> Истина И НЕ (ТребуетсяПравка = Истина И МожетПравить_ <> Истина);
	Если НЕ Разрешено Тогда
		Ответ.Код = 403;
	КонецЕсли;
	Возврат Новый Структура("Разрешено, Принципал, Пользователь, Сессия, Группа, МожетПравить",
		Разрешено, Пользователь_, Пользователь_, "сессия", Группа_, МожетПравить_ = Истина);

КонецФункции

// Впускает учётку в дом группы.
//
// Параметры:
//  Пользователь - Произвольный - учётка запроса.
//  Группа - Произвольный - группа раздела.
//  МожетПравить - Булево - администратор хаба (правит) или участник (только смотрит).
//
Процедура Впустить(Знач Пользователь, Знач Группа, Знач МожетПравить) Экспорт
	Пользователь_ = Пользователь;
	Группа_ = Группа;
	МожетПравить_ = МожетПравить;
	Отказать_ = Ложь;
КонецПроцедуры

// Больше не впускает никого: так тест видит, что дверь стережёт гвард, а не домен.
//
Процедура НеВпускать() Экспорт
	Отказать_ = Истина;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Отказать_ = Ложь;
	МожетПравить_ = Ложь;
КонецПроцедуры
