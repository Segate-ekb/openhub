// Фейковый СервисПодписок для тестов витрины и пульта: список подписок, типы событий, тип действия, пробы.

Перем Подписки_;
Перем ТипыСобытий_;
Перем ПоследняяПроба_;

#Область КонтрактСервисаПодписок

// Подписки объекта.
//
// Параметры:
//  Объект - Произвольный - описание объекта, не используется.
//
// Возвращаемое значение:
//  Массив - добавленные подписки.
//
Функция Список(Знач Объект) Экспорт
	Возврат Подписки_;
КонецФункции

// Подписка объекта по идентификатору — из добавленных.
//
// Параметры:
//  Объект - Произвольный - описание объекта, не используется.
//  Идентификатор - Число, Строка - идентификатор подписки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - добавленная подписка с этим идентификатором.
//
Функция ПодпискаОбъекта(Знач Объект, Знач Идентификатор) Экспорт
	Для Каждого Подписка Из Подписки_ Цикл
		Если Цел(Подписка.Идентификатор) = Цел(Идентификатор) Тогда
			Возврат Подписка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Типы событий, доступные для флажков витрины.
//
// Возвращаемое значение:
//  Массив из Строка - типы событий.
//
Функция ИзвестныеТипы() Экспорт
	Возврат ТипыСобытий_;
КонецФункции

// Нормализованный тип действия подписки; пустой читается как «вебхук».
//
// Параметры:
//  Подписка - Произвольный - запись подписки с полем ТипДействия.
//
// Возвращаемое значение:
//  Строка - тип действия в нижнем регистре.
//
Функция ТипДействияПодписки(Знач Подписка) Экспорт
	Тип = НРег(СокрЛП(Строка(Подписка.ТипДействия)));
	Возврат ?(ЗначениеЗаполнено(Тип), Тип, "вебхук");
КонецФункции

// Умеет ли тип подписки правку. Фикстура витрины правку показывает всегда.
//
// Параметры:
//  Подписка - Произвольный - запись подписки.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожноПравить(Знач Подписка) Экспорт
	Возврат Истина;
КонецФункции

// Умеет ли тип подписки пробную отправку. Фикстура витрины кнопку показывает всегда.
//
// Параметры:
//  Подписка - Произвольный - запись подписки.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожноПробовать(Знач Подписка) Экспорт
	Возврат Истина;
КонецФункции

// Значения полей подписки для формы правки; секретов среди них нет.
//
// Параметры:
//  Подписка - Произвольный - запись подписки.
//
// Возвращаемое значение:
//  Структура - значения по именам ввода полей.
//
Функция ЗначенияПравки(Знач Подписка) Экспорт
	Возврат Новый Структура("URL, ЧатИд", Строка(Подписка.URL), Строка(Подписка.URL));
КонецФункции

// Проба сохранённой подписки: запоминает вызов, отвечает успехом.
//
// Параметры:
//  Пользователь - Произвольный - инициатор.
//  Объект - Произвольный - описание объекта, не используется.
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Структура, Неопределено - вердикт пробы; Неопределено, если подписки нет.
//
Функция Проверить(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт
	Если ПодпискаОбъекта(Объект, Идентификатор) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПоследняяПроба_ = Новый Структура("Вид, Идентификатор, ТипДействия, Ввод, ТипыСобытий", "сохранённая",
		Идентификатор, "", Неопределено, "");
	Возврат Новый Структура("Успех, Код, Сообщение", Истина, 200, "HTTP 200");
КонецФункции

// Проба настройками формы: запоминает вызов, отвечает успехом.
//
// Параметры:
//  Пользователь - Произвольный - инициатор.
//  Объект - Произвольный - описание объекта, не используется.
//  Идентификатор - Число - подписка правки; 0 — заведение.
//  ТипДействия - Строка - тип действия формы.
//  Ввод - Структура - настройки из формы.
//  ТипыСобытий - Строка - события, отмеченные в форме (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура, Неопределено - вердикт пробы; Неопределено, если подписки правки нет.
//
Функция ПроверитьНастройки(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач ТипДействия,
	Знач Ввод, Знач ТипыСобытий = "") Экспорт
	Если Идентификатор <> 0 И ПодпискаОбъекта(Объект, Идентификатор) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПоследняяПроба_ = Новый Структура("Вид, Идентификатор, ТипДействия, Ввод, ТипыСобытий", "форма",
		Идентификатор, ТипДействия, Ввод, ТипыСобытий);
	Возврат Новый Структура("Успех, Код, Сообщение", Истина, 200, "HTTP 200");
КонецФункции

#КонецОбласти

#Область НастройкаФикстуры

// Последняя проба: Вид («сохранённая» | «форма»), Идентификатор, ТипДействия, Ввод и ТипыСобытий.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если проб не было.
//
Функция ПоследняяПроба() Экспорт
	Возврат ПоследняяПроба_;
КонецФункции

// Добавляет подписку в фикстуру.
//
// Параметры:
//  Подписка - Произвольный - запись подписки.
//
Процедура ДобавитьПодписку(Знач Подписка) Экспорт
	Подписки_.Добавить(Подписка);
КонецПроцедуры

// Задаёт перечень известных типов событий.
//
// Параметры:
//  Типы - Массив из Строка - типы событий.
//
Процедура УстановитьТипыСобытий(Знач Типы) Экспорт
	ТипыСобытий_ = Типы;
КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта()

	Подписки_ = Новый Массив();
	ТипыСобытий_ = Новый Массив();
	ТипыСобытий_.Добавить("package.version.published");

КонецПроцедуры
