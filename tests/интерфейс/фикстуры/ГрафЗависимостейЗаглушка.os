// Граф зависимостей одной страницы пакета без базы: служба зависимостей, пакеты, версии, пулы и гвард
// чтения пула одним объектом. Зависящий пакет заводится версией в своём пуле; пул читается, если тест
// не закрыл его.

Перем Зависимости;  // Массив из Структура — от чего зависит версия по умолчанию
Перем Зависящие;    // Массив из Структура (ВерсияИдентификатор) — строки обратного графа
Перем Пакеты;       // Соответствие: идентификатор пакета -> Структура пакета
Перем Версии;       // Соответствие: идентификатор версии -> Структура версии
Перем Пулы;         // Соответствие: идентификатор пула -> ПулЗаглушка
Перем Закрытые;     // Соответствие: имя пула -> Истина — смотрящий его не читает

#Область НаполнениеФикстуры

// Заводит пул.
//
// Параметры:
//  Пул - ПулЗаглушка - пул.
//  Читается - Булево - (необязательный, по умолчанию Истина) читает ли его смотрящий.
//
Процедура ДобавитьПул(Знач Пул, Знач Читается = Истина) Экспорт
	Пулы.Вставить(Пул.Идентификатор, Пул);
	Если НЕ Читается Тогда
		Закрытые.Вставить(Пул.Имя, Истина);
	КонецЕсли;
КонецПроцедуры

// Заводит пакет в пуле.
//
// Параметры:
//  Номер - Число - идентификатор пакета.
//  Имя - Строка - имя пакета.
//  Пул - ПулЗаглушка - пул пакета.
//
Процедура ДобавитьПакет(Знач Номер, Знач Имя, Знач Пул) Экспорт
	Пакеты.Вставить(Номер, Новый Структура("Идентификатор, Имя, ИмяНижнийРегистр, ПулИдентификатор",
		Номер, Имя, НРег(Имя), Пул.Идентификатор));
КонецПроцедуры

// Версия по умолчанию зависит от пакета.
//
// Параметры:
//  Имя - Строка - имя цели, как в манифесте.
//  Мин - Строка - нижняя граница диапазона.
//  ДляРазработки - Булево - зависимость только для разработки.
//
Процедура ЗависитОт(Знач Имя, Знач Мин, Знач ДляРазработки = Ложь) Экспорт
	Зависимости.Добавить(Новый Структура("ИмяПакета, ИмяПакетаНижнийРегистр, ВерсияМин, ВерсияМакс, ДляРазработки",
		Имя, НРег(Имя), Мин, "", ДляРазработки));
КонецПроцедуры

// Заведённый пакет зависит от пакета страницы своей версией.
//
// Параметры:
//  НомерПакета - Число - идентификатор зависящего пакета.
//
Процедура ЗависитОтСтраницы(Знач НомерПакета) Экспорт
	НомерВерсии = 1000 + НомерПакета;
	Версии.Вставить(НомерВерсии, Новый Структура("Идентификатор, ПакетИдентификатор", НомерВерсии, НомерПакета));
	Зависящие.Добавить(Новый Структура("ВерсияИдентификатор", НомерВерсии));
КонецПроцедуры

#КонецОбласти

#Область Службы

Функция ЗависимостиВерсии(Знач ВерсияИдентификатор) Экспорт
	ВерсияИдентификатор = ВерсияИдентификатор;
	Возврат Зависимости;
КонецФункции

Функция КтоЗависитОт(Знач ИмяПакета) Экспорт
	ИмяПакета = ИмяПакета;
	Возврат Зависящие;
КонецФункции

Функция ПакетДляЧтения(Знач ПулИдентификатор, Знач Имя) Экспорт
	Для Каждого Пара Из Пакеты Цикл
		Если Пара.Значение.ПулИдентификатор = ПулИдентификатор И Пара.Значение.ИмяНижнийРегистр = НРег(Имя) Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПакетыПоИдентификаторам(Знач Номера) Экспорт
	Возврат Отобранные(Пакеты, Номера);
КонецФункции

Функция ВерсииПоИдентификаторам(Знач Номера) Экспорт
	Возврат Отобранные(Версии, Номера);
КонецФункции

Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Пулы.Получить(Идентификатор);
КонецФункции

Функция ЧитаемыйПул(Знач Пользователь, Знач Имя, Знач Принципал = Неопределено) Экспорт
	Пользователь = Пользователь;
	Принципал = Принципал;
	Если Закрытые.Получить(Имя) = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Пара Из Пулы Цикл
		Если Пара.Значение.Имя = Имя Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

Функция Отобранные(Знач Записи, Знач Номера)
	Результат = Новый Массив();
	Для Каждого Номер Из Номера Цикл
		Запись = Записи.Получить(Номер);
		Если Запись <> Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПриСозданииОбъекта()
	Зависимости = Новый Массив();
	Зависящие = Новый Массив();
	Пакеты = Новый Соответствие();
	Версии = Новый Соответствие();
	Пулы = Новый Соответствие();
	Закрытые = Новый Соответствие();
КонецПроцедуры
