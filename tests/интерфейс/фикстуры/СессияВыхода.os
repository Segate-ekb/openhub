// Одна сессия браузера без базы — на месте службы сессий, куки сессии и защиты CSRF у формы
// и двери выхода: кука запроса называет сессию, у сессии свой токен, выход её гасит.

Перем ИдСессии;   // Строка — идентификатор сессии в куке запроса
Перем Токен_;     // Строка — токен формы этой сессии
Перем Жива_;      // Булево — сессию ещё не завершили
Перем Активна_;   // Булево — учётка сессии не выключена

#Область Состояние

// Сессия жива: выход её не погасил.
//
// Возвращаемое значение:
//  Булево
//
Функция Жива() Экспорт
	Возврат Жив_();
КонецФункции

// Токен формы этой сессии.
//
// Возвращаемое значение:
//  Строка
//
Функция Токен() Экспорт
	Возврат Токен_;
КонецФункции

// Сессия — то, что отдаёт служба сессий по идентификатору.
//
// Возвращаемое значение:
//  Структура - Идентификатор.
//
Функция Сессия() Экспорт
	Возврат Новый Структура("Идентификатор", ИдСессии);
КонецФункции

// Администратор выключил учётку: сессия жива, но страж запроса её больше не признаёт.
Процедура ВыключитьУчётку() Экспорт
	Активна_ = Ложь;
КонецПроцедуры

#КонецОбласти

#Область СлужбаСессий

// Живая сессия по идентификатору.
//
// Параметры:
//  Идентификатор - Строка - идентификатор из куки.
//  Момент - Дата - не различается (необязательный).
//
// Возвращаемое значение:
//  Структура, Неопределено - сессия; Неопределено — чужой идентификатор или сессия погашена.
//
Функция Получить(Знач Идентификатор, Знач Момент = Неопределено) Экспорт
	Момент = Момент;
	Возврат ?(Идентификатор = ИдСессии И Жив_(), Сессия(), Неопределено);
КонецФункции

// Гасит сессию.
//
// Параметры:
//  Идентификатор - Строка - идентификатор из куки.
//  Момент - Дата - не различается (необязательный).
//
// Возвращаемое значение:
//  Булево - сессия была и погашена.
//
Функция Завершить(Знач Идентификатор, Знач Момент = Неопределено) Экспорт
	Момент = Момент;
	Было = Идентификатор = ИдСессии И Жив_();
	Если Было Тогда
		Жива_ = Ложь;
	КонецЕсли;
	Возврат Было;
КонецФункции

#КонецОбласти

#Область ПерехватчикАутентификации

// Принципал запроса, как его видит страж: ключ в заголовке Authorization побеждает куку — bob
// ключом, без сессии; иначе bob с этой сессией, пока она жива и учётка не выключена; иначе гость.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки запроса: различается только Authorization.
//  Куки - Произвольный - не различаются.
//
// Возвращаемое значение:
//  Структура - Пользователь, Сессия.
//
Функция ОпределитьПринципала(Знач Заголовки, Знач Куки) Экспорт
	Куки = Куки;
	Если ТипЗнч(Заголовки) = Тип("Соответствие") И ЗначениеЗаполнено(Заголовки.Получить("Authorization")) Тогда
		Возврат Новый Структура("Пользователь, Сессия", Новый Структура("Идентификатор, Логин", 7, "bob"), Неопределено);
	КонецЕсли;
	Если НЕ Жив_() ИЛИ НЕ Активна_ Тогда
		Возврат Новый Структура("Пользователь, Сессия", Неопределено, Неопределено);
	КонецЕсли;
	Возврат Новый Структура("Пользователь, Сессия", Новый Структура("Идентификатор, Логин", 7, "bob"), Сессия());
КонецФункции

#КонецОбласти

#Область КукиСессии

// Идентификатор сессии из кук запроса.
//
// Параметры:
//  КукиЗапроса - КукиЗаглушка, Неопределено - куки запроса; Неопределено — запрос без кук.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение куки сессии.
//
Функция ИзЗапроса(Знач КукиЗапроса) Экспорт
	Возврат ?(КукиЗапроса = Неопределено, Неопределено, КукиЗапроса.ПолучитьЗначениеПоИмени(ИмяКуки()));
КонецФункции

// Куки браузера этой сессии.
//
// Возвращаемое значение:
//  КукиЗаглушка
//
Функция Куки() Экспорт
	Куки = Новый КукиЗаглушка();
	Куки.Добавить(ИмяКуки(), ИдСессии);
	Возврат Куки;
КонецФункции

Функция ИмяКуки()
	Возврат "oshub_session";
КонецФункции

// Стирает куку: в заглушке ответа стирать нечего.
//
// Параметры:
//  Ответ - Произвольный - не различается.
//
Процедура Сбросить(Ответ) Экспорт
	Ответ = Ответ;
КонецПроцедуры

#КонецОбласти

#Область ЗащитаCSRF

// Имя поля токена в форме.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоля() Экспорт
	Возврат "_csrf";
КонецФункции

// Токен сессии.
//
// Параметры:
//  Сессия - Структура, Неопределено - сессия.
//
// Возвращаемое значение:
//  Строка - "" без сессии.
//
Функция ТокенСессии(Знач Сессия) Экспорт
	Возврат ?(Сессия = Неопределено, "", Токен_);
КонецФункции

// Совпал ли присланный токен с токеном сессии.
//
// Параметры:
//  Сессия - Структура, Неопределено - сессия.
//  ПереданныйТокен - Строка, Неопределено - поле токена из формы.
//
// Возвращаемое значение:
//  Булево
//
Функция Проверить(Знач Сессия, Знач ПереданныйТокен) Экспорт
	Возврат Сессия <> Неопределено И Строка(ПереданныйТокен) = Токен_;
КонецФункции

#КонецОбласти

Функция Жив_()
	Возврат Жива_ = Истина;
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	ИдСессии = "сессия-выхода";
	Токен_ = "токен-выхода-7f3a";
	Жива_ = Истина;
	Активна_ = Истина;
КонецПроцедуры
