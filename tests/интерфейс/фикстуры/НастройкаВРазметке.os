// Поле настройки в разметке страницы: обёртка поля с плашкой источника по ключу настройки, форма,
// которую шлёт кнопка сброса у плашки, и тело её отправки — как его отправит браузер без скрипта.

// Обёртка настройки: от её признака data-setting до следующей настройки (у последней на странице —
// не дальше ХвостПоследней знаков).
//
// Параметры:
//  HTML - Строка - разметка страницы или секции.
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - фрагмент разметки; "" — настройки на странице нет.
//
Функция Поле(Знач HTML, Знач Ключ) Экспорт

	Позиция = СтрНайти(HTML, "data-setting=""" + Ключ + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Следующая = СтрНайти(Сред(Хвост, 2), "data-setting=""");
	Возврат ?(Следующая = 0, Лев(Хвост, ХвостПоследней()), Лев(Хвост, Следующая));

КонецФункции

// Форма, которую шлёт кнопка сброса у поля настройки (атрибут form кнопки), если браузер её
// увидит: форма лежит вне всякой другой — вложенную он выбрасывает, и кнопка ничего бы не сбросила.
//
// Параметры:
//  HTML - Строка - разметка страницы.
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - форма целиком; "" — кнопки сброса нет, её формы нет на странице или форма вложена.
//
Функция ФормаСброса(Знач HTML, Знач Ключ) Экспорт

	Найденные = Новый РегулярноеВыражение("<button[^>]* form=""([^""]+)""").НайтиСовпадения(Поле(HTML, Ключ));
	Если Найденные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(HTML, "id=""" + Найденные[0].Группы[1].Значение + """");
	Начало = ?(Позиция = 0, 0, СтрНайти(HTML, "<form", НаправлениеПоиска.СКонца, Позиция));
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	До = Лев(HTML, Начало - 1);
	Если СтрЧислоВхождений(До, "<form") <> СтрЧислоВхождений(До, "</form>") Тогда
		Возврат "";
	КонецЕсли;
	Тело = Сред(HTML, Начало);
	Возврат Лев(Тело, СтрНайти(Тело, "</form>") + СтрДлина("</form>") - 1);

КонецФункции

// Кнопки сброса страницы, которые браузер не отправит как надо: формы с их якорем нет, она вложена
// в другую форму или сбрасывает не ту настройку, у поля которой стоит кнопка.
//
// Параметры:
//  HTML - Строка - разметка страницы.
//
// Возвращаемое значение:
//  Структура - Кнопок (Число) — сколько кнопок сброса на странице; Сломанные (Массив из Строка) —
//              ключи настроек, чья кнопка сброса не работает.
//
Функция КнопкиСброса(Знач HTML) Экспорт

	Результат = Новый Структура("Кнопок, Сломанные", 0, Новый Массив());
	Выражение = Новый РегулярноеВыражение("data-setting=""([^""]+)""");
	Для Каждого Найденное Из Выражение.НайтиСовпадения(HTML) Цикл
		Ключ = Найденное.Группы[1].Значение;
		Если НЕ ЕстьКнопкаСброса(Поле(HTML, Ключ)) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Кнопок = Результат.Кнопок + 1;
		Если СтрНайти(ФормаСброса(HTML, Ключ), "value=""" + Ключ + """") = 0 Тогда
			Результат.Сломанные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Стоит ли у поля настройки кнопка, которая шлёт чужую форму (кнопка сброса).
//
// Параметры:
//  Поле - Строка - обёртка настройки (см. Поле).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьКнопкаСброса(Знач Поле) Экспорт
	Возврат Новый РегулярноеВыражение("<button[^>]* form=""[^""]+""").Совпадает(Поле);
КонецФункции

// Тело отправки формы: её скрытые поля, кроме токена, — токен кладёт тот, кто шлёт.
//
// Параметры:
//  Форма - Строка - форма целиком (см. ФормаСброса).
//
// Возвращаемое значение:
//  Строка - тело application/x-www-form-urlencoded.
//
Функция ТелоОтправки(Знач Форма) Экспорт

	Части = Новый Массив();
	Выражение = Новый РегулярноеВыражение("<input type=""hidden"" name=""([^""]+)"" value=""([^""]*)""");
	Для Каждого Найденное Из Выражение.НайтиСовпадения(Форма) Цикл
		Имя = Найденное.Группы[1].Значение;
		Если Имя <> "_csrf" Тогда
			Части.Добавить(Закодировать(Имя) + "=" + Закодировать(Найденное.Группы[2].Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");

КонецФункции

// Кнопки, которые отправляют саму форму: кнопка с атрибутом form шлёт чужую.
//
// Параметры:
//  Форма - Строка - форма целиком.
//
// Возвращаемое значение:
//  Число.
//
Функция СвоиКнопкиОтправки(Знач Форма) Экспорт

	Свои = 0;
	Для Каждого Кнопка Из Новый РегулярноеВыражение("<button[^>]*type=""submit""[^>]*>").НайтиСовпадения(Форма) Цикл
		Если СтрНайти(Кнопка.Значение, " form=""") = 0 Тогда
			Свои = Свои + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Свои;

КонецФункции

// Сколько разметки после признака последней настройки страницы считается её полем: поле с плашкой
// и подсказкой короче, а дальше идут уже чужие секции.
Функция ХвостПоследней()
	Возврат 3000;
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции
