// Фейк СервисДоверияCI для тестов раздела: записи задаёт вызывающий, база не нужна; заведение
// и отзыв меняют выдачу и пишутся в свой журнал. Имя записи считает настоящий ИмяЗаписиДоверия —
// своей копии этого правила у фейка нет.

Перем Строки;
Перем Аудитория;
Перем Имена;
Перем Мутации;     // Массив из Строка — «доверено …», «отозвано …»
Перем Заведения;   // Массив из Структура — аргументы Доверить
Перем ОтказДомена; // Строка — чем домен отобьёт следующее заведение; "" — примет
Перем ПорогОткрыт; // Булево — пускает ли порог раздела того, кого впустил гвард

// Задаёт аудиторию, которую фейк отдаёт как ожидаемую хабом.
//
// Параметры:
//  Значение - Строка - значение клейма aud.
//
Процедура ЗадатьАудиторию(Знач Значение) Экспорт
	Аудитория = Значение;
КонецПроцедуры

// Аудитория, которую хаб ждёт в клейме aud.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОжидаемаяАудитория() Экспорт
	Возврат Аудитория;
КонецФункции

// Добавляет запись доверия в выдачу фейка.
//
// Параметры:
//  Идентификатор - Число - номер записи.
//  Провайдер - Строка - github либо gitlab.
//  Издатель - Строка - клейм iss записи.
//  Репозиторий - Строка - owner/repo либо group/project.
//  Конвейер - Строка - каноническое значение конвейера, "" — любой.
//  Реф - Строка - маска рефа.
//  Логин - Строка - логин автора записи; "" — учётка исчезла (необязательный,
//          по умолчанию "").
//  Создано - Дата - когда заведена (необязательный, по умолчанию 01.03.2026).
//
Функция Добавить(Знач Идентификатор, Знач Провайдер, Знач Издатель, Знач Репозиторий,
	Знач Конвейер, Знач Реф, Знач Логин = "", Знач Создано = Неопределено) Экспорт

	Запись = Новый Структура("Идентификатор, Провайдер, Издатель, Репозиторий, Конвейер, Реф, Создано",
		Идентификатор, Провайдер, Издатель, Репозиторий, Конвейер, Реф,
		?(Создано = Неопределено, Дата(2026, 3, 1), Создано));

	Автор = ?(ЗначениеЗаполнено(Логин), Новый Структура("Логин", Логин), Неопределено);
	Строки.Добавить(Новый Структура("Доверие, Автор", Запись, Автор));
	Возврат Запись;

КонецФункции

// Очищает выдачу и журнал.
Процедура Очистить() Экспорт
	Строки = Новый Массив();
	Мутации = Новый Массив();
	Заведения = Новый Массив();
	ОтказДомена = "";
КонецПроцедуры

// Доверенные конвейеры пакета вместе с автором записи.
//
// Параметры:
//  Пакет - Произвольный - не используется фейком.
//
// Возвращаемое значение:
//  Массив из Структура - Доверие, Автор.
//
Функция СтрокиПакета(Знач Пакет) Экспорт
	Возврат Строки;
КонецФункции

// Доверенные конвейеры пакета.
//
// Параметры:
//  Пакет - Произвольный - не используется фейком.
//
// Возвращаемое значение:
//  Массив - записи доверия.
//
Функция КонвейерыПакета(Знач Пакет) Экспорт

	Результат = Новый Массив();
	Для Каждого Строка_ Из Строки Цикл
		Результат.Добавить(Строка_.Доверие);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Человекочитаемое имя записи доверия — та же форма, что у боевого сервиса.
//
// Параметры:
//  Запись - Структура - запись доверия.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОписаниеЗаписи(Знач Запись) Экспорт
	Возврат Имена.Составить(Запись.Провайдер, Запись.Издатель, Запись.Репозиторий,
		Запись.Конвейер, Запись.Реф);
КонецФункции

// Провайдеры, которым хаб умеет доверять.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ДопустимыеПровайдеры() Экспорт
	Результат = Новый Массив();
	Результат.Добавить("github");
	Результат.Добавить("gitlab");
	Возврат Результат;
КонецФункции

// Каноническое значение провайдера «GitLab CI».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПровайдерGitLab() Экспорт
	Возврат "gitlab";
КонецФункции

// Порог раздела: фейк впускает всех, кого впустил гвард, пока порог не закрыт (см. ЗакрытьПорог).
//
// Параметры:
//  Пользователь - Произвольный - смотрящий.
//  Пакет - Произвольный - пакет.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетНастраивать(Знач Пользователь, Знач Пакет) Экспорт
	Пакет = Пакет;
	Возврат ПорогОткрыт И Пользователь <> Неопределено;
КонецФункции

// Закрывает или открывает порог раздела: гвард пакета впускает, а права настраивать доверие нет.
//
// Параметры:
//  Закрыт - Булево - Истина — порог не пускает никого.
//
Процедура ЗакрытьПорог(Знач Закрыт) Экспорт
	ПорогОткрыт = НЕ Закрыт;
КонецПроцедуры

// Задаёт отказ домена следующему заведению.
//
// Параметры:
//  Текст - Строка - причина отказа; "" — заведение пройдёт.
//
Процедура ОтбитьЗаведение(Знач Текст) Экспорт
	ОтказДомена = Текст;
КонецПроцедуры

// Заводит запись доверия так, как её прислал экран.
//
// Параметры:
//  Принципал - Произвольный - принципал запроса.
//  Пакет - Произвольный - пакет.
//  Провайдер, Издатель, Репозиторий, Конвейер, Реф, ВидРефа - Строка - поля записи.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение.
//
Функция Доверить(Знач Принципал, Знач Пакет, Знач Провайдер, Знач Издатель,
	Знач Репозиторий, Знач Конвейер = "", Знач Реф, Знач ВидРефа = "") Экспорт

	Принципал = Принципал;
	Пакет = Пакет;
	Если ЗначениеЗаполнено(ОтказДомена) Тогда
		Возврат Новый Структура("Успех, Код, Сообщение", Ложь, 400, ОтказДомена);
	КонецЕсли;
	Заведения.Добавить(Новый Структура("Провайдер, Издатель, Репозиторий, Конвейер, Реф, ВидРефа",
		Провайдер, Издатель, Репозиторий, Конвейер, Реф, ВидРефа));
	Добавить(Строки.Количество() + 100, Провайдер, Издатель, Репозиторий, Конвейер, Реф);
	Мутации.Добавить("доверено " + Репозиторий);
	Возврат Новый Структура("Успех, Код, Сообщение", Истина, 201, "");

КонецФункции

// Отзывает запись пакета; чужая или несуществующая — 404.
//
// Параметры:
//  Принципал - Произвольный - принципал запроса.
//  Пакет - Произвольный - пакет.
//  ДовериеИдентификатор - Число - номер записи.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение.
//
Функция ОтозватьДоверие(Знач Принципал, Знач Пакет, Знач ДовериеИдентификатор) Экспорт

	Принципал = Принципал;
	Пакет = Пакет;
	Для Индекс = 0 По Строки.ВГраница() Цикл
		Если Цел(Строки[Индекс].Доверие.Идентификатор) = Цел(ДовериеИдентификатор) Тогда
			Мутации.Добавить("отозвано " + Строки[Индекс].Доверие.Репозиторий);
			Строки.Удалить(Индекс);
			Возврат Новый Структура("Успех, Код, Сообщение", Истина, 200, "");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Успех, Код, Сообщение", Ложь, 404, "Доверенный конвейер не найден у этого пакета");

КонецФункции

// Журнал мутаций фейка: что завёл и что отозвал экран.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Журнал() Экспорт
	Возврат Мутации;
КонецФункции

// Аргументы заведений по порядку.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция Заведённые() Экспорт
	Возврат Заведения;
КонецФункции

Процедура ПриСозданииОбъекта(Знач _Имена)
	Строки = Новый Массив();
	Аудитория = "";
	Имена = _Имена;
	Мутации = Новый Массив();
	Заведения = Новый Массив();
	ОтказДомена = "";
	ПорогОткрыт = Истина;
КонецПроцедуры
