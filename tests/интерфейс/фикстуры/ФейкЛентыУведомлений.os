// Фейк ЛентаУведомлений для двери ленты: записей нет, непрочитанное задаёт тест, отметка ленты
// прочитанной считается.

Перем Непрочитано_;
Перем Отметок_;

// Записи ленты пользователя: в фейке их нет.
//
// Параметры:
//  Пользователь - Произвольный - чья лента.
//
// Возвращаемое значение:
//  Массив.
//
Функция Мои(Знач Пользователь) Экспорт
	Пользователь = Пользователь;
	Возврат Новый Массив();
КонецФункции

// Сколько записей ленты не прочитано.
//
// Параметры:
//  Пользователь - Произвольный - чья лента.
//
// Возвращаемое значение:
//  Число.
//
Функция Непрочитано(Знач Пользователь) Экспорт
	Пользователь = Пользователь;
	Возврат Непрочитано_;
КонецФункции

// Отмечает всю ленту прочитанной.
//
// Параметры:
//  Пользователь - Произвольный - чья лента.
//
// Возвращаемое значение:
//  Число - сколько записей отмечено.
//
Функция ОтметитьВсеПрочитанными(Знач Пользователь) Экспорт
	Пользователь = Пользователь;
	Отмечено = Непрочитано_;
	Непрочитано_ = 0;
	Отметок_ = Отметок_ + 1;
	Возврат Отмечено;
КонецФункции

// Сколько раз ленту отмечали прочитанной.
//
// Возвращаемое значение:
//  Число.
//
Функция Отметок() Экспорт
	Возврат Отметок_;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Непрочитано = 3)
	Непрочитано_ = Непрочитано;
	Отметок_ = 0;
КонецПроцедуры
