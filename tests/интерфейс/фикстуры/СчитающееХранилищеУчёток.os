// BSLLS:MissingReturnedValueDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:InvalidCharacterInFile-off
// BSLLS:YoLetterUsage-off
// Хранилище учёток в памяти, считающее обращения: список раздела «Пользователи» обязан
// стоить одного обращения, сколько бы учёток ни было заведено.

Перем Учетки;
Перем Счетчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число
//
Функция Обращений() Экспорт
	Возврат Счетчик.Обращений();
КонецФункции

// Заводит учётную запись (наполнение фикстуры; за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор учётки.
//  Логин - Строка - логин.
//  ХешПароля - Строка - хеш пароля; пусто — пароля нет (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - заведённая учётка.
//
Функция Добавить(Знач Идентификатор, Знач Логин, Знач ХешПароля = "") Экспорт

	Учетка = Новый Структура();
	Учетка.Вставить("Идентификатор", Цел(Идентификатор));
	Учетка.Вставить("Логин", Логин);
	Учетка.Вставить("Email", Логин + "@example.test");
	Учетка.Вставить("РольХаба", "user");
	Учетка.Вставить("Админ", Ложь);
	Учетка.Вставить("Активен", Истина);
	Учетка.Вставить("ТребуетсяСменаПароля", Ложь);
	Учетка.Вставить("ХешПароля", ХешПароля);
	Учетки.Добавить(Учетка);
	Возврат Учетка;

КонецФункции

// Все учётки хаба; считает обращение.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция Все() Экспорт
	Счетчик.Отметить();
	Возврат Учетки;
КонецФункции

// Поля учётки, по которым идёт отбор списка.
//
// Возвращаемое значение:
//  Строка - имена полей через запятую.
//
Функция ПоляОтбора() Экспорт
	Возврат "Логин,Email";
КонецФункции

Процедура ПриСозданииОбъекта()
	Учетки = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счетчик = Новый СчётчикОбращений();
КонецПроцедуры
