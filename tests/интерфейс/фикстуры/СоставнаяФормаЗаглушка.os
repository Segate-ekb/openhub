// Составная форма (multipart), какой её разбирает winow: текстовые и файловые части с заголовками.

Перем Части; // Массив из Структура (Метаданные, Значение)

// Текстовое поле формы.
//
// Параметры:
//  Имя - Строка - имя поля.
//  Значение - Строка - значение.
//
// Возвращаемое значение:
//  СоставнаяФормаЗаглушка - эта же форма.
//
Функция Поле(Знач Имя, Знач Значение) Экспорт
	Добавить(Имя, "", "text/plain", ПолучитьДвоичныеДанныеИзСтроки(Значение));
	Возврат ЭтотОбъект;
КонецФункции

// Файловая часть формы.
//
// Параметры:
//  Имя - Строка - имя поля.
//  ИмяФайла - Строка - имя файла.
//  ТипКонтента - Строка - Content-Type части.
//  Данные - ДвоичныеДанные - байты файла.
//
// Возвращаемое значение:
//  СоставнаяФормаЗаглушка - эта же форма.
//
Функция Файл(Знач Имя, Знач ИмяФайла, Знач ТипКонтента, Знач Данные) Экспорт
	Добавить(Имя, ИмяФайла, ТипКонтента, Данные);
	Возврат ЭтотОбъект;
КонецФункции

// Число частей формы.
//
// Возвращаемое значение:
//  Число
//
Функция Количество() Экспорт
	Возврат Части.Количество();
КонецФункции

// Часть формы по номеру.
//
// Параметры:
//  Индекс - Число - номер части с нуля.
//
// Возвращаемое значение:
//  Структура - Метаданные (Соответствие заголовков), Значение (ДвоичныеДанные).
//
Функция ПолучитьПоИндексу(Знач Индекс) Экспорт
	Возврат Части[Индекс];
КонецФункции

Процедура Добавить(Знач Имя, Знач ИмяФайла, Знач ТипКонтента, Знач Данные)

	Раскладка = Новый Соответствие();
	Раскладка.Вставить("name", Имя);
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Раскладка.Вставить("filename", ИмяФайла);
	КонецЕсли;
	Тип = Новый Соответствие();
	Тип.Вставить("Content-Type", ТипКонтента);

	Метаданные = Новый Соответствие();
	Метаданные.Вставить("Content-Disposition", Раскладка);
	Метаданные.Вставить("Content-Type", Тип);
	Части.Добавить(Новый Структура("Метаданные, Значение", Метаданные, Данные));

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Части = Новый Массив();
КонецПроцедуры
