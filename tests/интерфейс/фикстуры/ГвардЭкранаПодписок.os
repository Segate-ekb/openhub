// Заглушка гвардов трёх домов подписок — хаба, кабинета и пакета: впускает учётку, которую задал
// тест, с пулом и пакетом раздела, так мутации доходят до настоящей службы подписок; «не впускать» —
// гвард отказал и сам ответил, дальше запрос не идёт.

Перем Пользователь_;
Перем Пул_;
Перем Пакет_;
Перем Отказать_;

// Вердикт допуска: у гварда хаба и кабинета три параметра, у гварда пакета — ещё пул и пакет адреса.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  ИмяПула - Строка - имя пула из адреса (необязательный, по умолчанию "").
//  ИмяПакета - Строка - имя пакета из адреса (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Разрешено, Принципал, Пользователь, Сессия, Пул, Пакет.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула = "", Знач ИмяПакета = "") Экспорт
	Если Отказать_ = Истина Тогда
		Ответ.Код = 403;
	КонецЕсли;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	ИмяПула = ИмяПула;
	ИмяПакета = ИмяПакета;
	Возврат Новый Структура("Разрешено, Принципал, Пользователь, Сессия, Пул, Пакет",
		Отказать_ <> Истина, Пользователь_, Пользователь_, "сессия", Пул_, Пакет_);
КонецФункции

// Впускает учётку в раздел.
//
// Параметры:
//  Пользователь - Произвольный - учётка запроса.
//  Пул - Произвольный - пул раздела (необязательный, по умолчанию Неопределено).
//  Пакет - Произвольный - пакет раздела (необязательный, по умолчанию Неопределено).
//
Процедура Впустить(Знач Пользователь, Знач Пул = Неопределено, Знач Пакет = Неопределено) Экспорт
	Пользователь_ = Пользователь;
	Пул_ = Пул;
	Пакет_ = Пакет;
	Отказать_ = Ложь;
КонецПроцедуры

// Больше не впускает никого: так тест видит, что дверь стережёт гвард, а не домен.
//
Процедура НеВпускать() Экспорт
	Отказать_ = Истина;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Отказать_ = Ложь;
КонецПроцедуры
