// Пул фейка СервисаПулов: имя, видимость и признак личного пространства — сводка лендинга
// считает личные пространства отдельно, право чтения спрашивают только у закрытого пула.

Перем Идентификатор Экспорт;
Перем Имя Экспорт;
Перем Видимость Экспорт;
Перем Личный;

// Личное ли это пространство пользователя (тип user).
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоЛичный() Экспорт
	Возврат Личный = Истина;
КонецФункции

Процедура ПриСозданииОбъекта(Знач ЗначениеИд, Знач ЗначениеИмя, Знач ЗначениеЛичный = Ложь,
	Знач ЗначениеВидимость = "public")

	Идентификатор = Цел(ЗначениеИд);
	Имя = ЗначениеИмя;
	Личный = (ЗначениеЛичный = Истина);
	Видимость = ЗначениеВидимость;

КонецПроцедуры
