// Флажок формы в готовой разметке: «отмечен ли он» судится по ЕГО тегу, а не по слову
// checked, найденному где-то на странице.

// Тег <input> флажка с таким именем поля.
//
// Параметры:
//  Разметка - Строка - разметка страницы либо секции.
//  ИмяПоля - Строка - значение атрибута name.
//
// Возвращаемое значение:
//  Строка - тег от «<input» до ближайшего «>»; "" — флажка с таким именем в разметке нет.
//
Функция Тег(Знач Разметка, Знач ИмяПоля) Экспорт

	Поз = СтрНайти(Разметка, "name=""" + ИмяПоля + """");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = СтрНайти(Лев(Разметка, Поз), "<input", НаправлениеПоиска.СКонца);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Отмечен ли флажок с таким именем поля.
//
// Параметры:
//  Разметка - Строка - разметка страницы либо секции.
//  ИмяПоля - Строка - значение атрибута name.
//
// Возвращаемое значение:
//  Булево - Истина, если тег флажка несёт checked.
//
Функция Отмечен(Знач Разметка, Знач ИмяПоля) Экспорт
	Возврат СтрНайти(Тег(Разметка, ИмяПоля), "checked") > 0;
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
