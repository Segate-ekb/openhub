// Фейк СтражаПарольногоВхода: разрешает ли предохранитель выключение, задаёт тест; переход
// пишет настоящую настройку через службу настроек от имени стража — реестр отдал правку
// этого ключа ему, обычная запись значения на нём отказывает.

Перем Настройки;   // СервисНастроек — куда пишется переход
Перем Разрешено;   // Булево — вердикт предохранителя

// Код причины «нет провайдеров».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетПровайдеров() Экспорт
	Возврат "нет-провайдеров";
КонецФункции

// Код причины «нет администраторов с личностью провайдера».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетАдминов() Экспорт
	Возврат "нет-админов";
КонецФункции

// Код причины «все провайдеры под правилом по стране».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаВсеПодГеоправилом() Экспорт
	Возврат "все-под-геоправилом";
КонецФункции

// Вердикт предохранителя по флагу теста.
//
// Возвращаемое значение:
//  Структура - Успех, Причина, Админов, Провайдеров.
//
Функция ПроверитьВыключение() Экспорт
	Возврат Новый Структура("Успех, Причина, Админов, Провайдеров", Разрешено,
		?(Разрешено, "", ПричинаНетПровайдеров()), ?(Разрешено, 2, 0), ?(Разрешено, 1, 0));
КонецФункции

// Выключает вход по паролю.
//
// Параметры:
//  Кто - Строка - принципал.
//  АдресIP - Строка - адрес (необязательный, по умолчанию "").
//
Процедура Выключить(Знач Кто, Знач АдресIP = "") Экспорт
	Записать(Ложь, Кто, АдресIP);
КонецПроцедуры

// Включает вход по паролю.
//
// Параметры:
//  Кто - Строка - принципал.
//  АдресIP - Строка - адрес (необязательный, по умолчанию "").
//
Процедура Включить(Знач Кто, Знач АдресIP = "") Экспорт
	Записать(Истина, Кто, АдресIP);
КонецПроцедуры

// Задаёт вердикт предохранителя.
//
// Параметры:
//  Флаг - Булево - разрешено ли выключение.
//
Процедура Разрешить(Знач Флаг) Экспорт
	Разрешено = Флаг;
КонецПроцедуры

Процедура Записать(Знач Значение, Знач Кто, Знач АдресIP)
	Настройки.УстановитьМеханизмом("oshub.auth.password.enabled", Значение, Кто, "СтражПарольногоВхода",
		АдресIP);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Настройки)
	Настройки = _Настройки;
	Разрешено = Истина;
КонецПроцедуры
