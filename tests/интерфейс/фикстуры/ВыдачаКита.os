	Пакеты.Добавить(Новый Структура("Имя, Подпись, Состояние", "пакет:альфа", "альфа", "вкл"));
	Пакеты.Добавить(Новый Структура("Имя, Подпись, Состояние", "пакет:дельта", "дельта", "выкл"));

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Имя, Подпись, Пояснение, Состояние, Дети, Открыт",
		"пул:corp", "corp", "2 пакета", "частично", Пакеты, Истина));
