// Каталог: главная, каталог пакетов и страница пакета — строка поиска с отбором скрытыми полями без
// перезагрузки, вкладки со счётчиком, плашка отбора, страницы с отбором, пустое состояние с действием
// и компактное, лента карточек объекта полными рядами, таблица зависимостей, быстрый старт.
Функция ОбразцыКаталога()

	Результат = Новый Массив();

	Добавить(Результат, "строка поиска каталога", Кит.СтрокаПоиска("/packages").Метка("Поиск").СкрытаяМетка()
		.Значение("veles").Пример("Имя пакета или его часть").СкрытоеПоле("pool", "corp").БезПерезагрузки());

	Добавить(Результат, "вкладки страницы пакета", Кит.Табы(
		Кит.Вкладка("Описание", "/pools/corp/packages/veles").Активна().Иконка("инфо"),
		Кит.Вкладка("Версии", "/pools/corp/packages/veles/versions").Иконка("тег").Счётчик(3),
		Кит.Вкладка("Зависимости", "/pools/corp/packages/veles/deps").Активна(Ложь).Иконка("ссылка"))
		.Заголовок("Разделы страницы пакета"));

	Добавить(Результат, "плашка отбора", Кит.Область(Кит.РядПлашек(
		Кит.Плашка("пул: corp").Вид("accent").Иконка("куб").Адрес("/pools/corp"))).Вид("отбор"));

	Добавить(Результат, "страницы каталога", Кит.Пагинация("/packages", 2, 3)
		.Параметры("q", "veles").Параметры("pool", "corp").БезПерезагрузки());

	Добавить(Результат, "пустое с действием", Кит.ПустоеСостояние("Проверьте написание имени.")
		.Заголовок("Ничего не найдено").Иконка("поиск")
		.Действие(Кит.Кнопка("Показать все пакеты").Вторичная().Адрес("/packages")));
	Добавить(Результат, "пустое компактное", Кит.ПустоеСостояние("Пакет ни от чего не зависит").Компактное());

	Зависимости = Кит.Таблица(Кит.Колонка("Пакет"), Кит.Колонка("Диапазон"), Кит.Колонка());
	Зависимости.Добавить(Кит.Запись(Кит.Ячейка(Кит.Ссылка("/pools/corp/packages/autumn", Кит.Текст("autumn"))),
		Кит.Ячейка(Кит.Текст(">=1.0")), Кит.Ячейка(Кит.Плашка("для разработки"))));
	Добавить(Результат, "зависимости двумя карточками", Кит.Сетка(
		Кит.Карточка("Зависит от", Зависимости).Иконка("ссылка"),
		Кит.Карточка("Кто зависит", Кит.ПустоеСостояние("От пакета никто не зависит").Компактное()).Иконка("ссылка"))
		.Колонки(2).Заголовок("Зависимости пакета"));

	Добавить(Результат, "лента главной", Кит.Карточка("Недавно опубликовано",
		Кит.Сетка(КарточкаОбъектаКаталога("veles", "/pools/corp/packages/veles")).Колонки(4).ПолныеРяды()
			.Заголовок("Недавно опубликовано"))
		.Описание("Свежие версии в доступных вам пулах.").Иконка("история"));

	Добавить(Результат, "быстрый старт", Кит.Карточка("Быстрый старт",
		Кит.БлокКоманды("{""СервераПакетов"": []}").Пояснение("Добавьте хаб в opm.cfg").БезКопирования(),
		Кит.БлокКоманды("opm install <имя-пакета>").Пояснение("И устанавливайте пакеты как обычно:"))
		.Иконка("скачать"));

	Возврат Результат;

КонецФункции

// Карточка объекта, как её печатает КарточкаОбъекта хаба: шапка с именем-ссылкой и плашками, описание,
// мета. Состав сверяет СлойПредставления_Тесты.ОбразецКарточкиВВыдачеКитаСовпадаетСНастоящей.
//
// Параметры:
//  Имя - Строка - имя объекта.
//  Адрес - Строка - адрес его страницы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - статья-карточка.
//
Функция КарточкаОбъектаКаталога(Знач Имя, Знач Адрес) Экспорт

	Возврат Кит.Статья(
		Кит.Область(
			Кит.Заголовок(3, Кит.Иконка("пакет"), Кит.Ссылка(Адрес, Кит.Текст(Имя))).Вид("имя"),
			Кит.Область(Кит.Плашка("устаревший")).Вид("плашки")).Вид("шапка"),
		Кит.Примечание(Кит.Текст("Ядро фреймворка")).Вид("описание"),
		Кит.РядМеты(ОдинЭлементМеты(), "карточка")).Вид("карточка");

КонецФункции

Функция ОдинЭлементМеты()
	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Значение, Значок", "версия", "1.0.0", "закладка"));
	Возврат Результат;
КонецФункции

// Вход: узкая страница-ворота со знаком и заголовком, форма столбиком с «Забыли пароль?» у поля
// пароля, разделитель «или», кнопки провайдеров столбиком со значками брендов, строка регистрации
// рамкой и атрибуция сноской.
Функция ОбразцыВхода()

	Результат = Новый Массив();

	Добавить(Результат, "страница входа узкой колонкой", Кит.УзкаяСтраница(
		Кит.Уведомление("Неверный логин или пароль").Вид("err"),
		Кит.ФормаБезСессии("/login",
			Кит.Поле("логин", "Логин").Автозаполнение("username"),
			Кит.Поле("пароль", "Пароль").Секрет().Автозаполнение("current-password")
				.СсылкаРядом("/forgot-password", "Забыли пароль?"),
			Кит.Кнопка("Войти").Основная().ВоВсюШирину()).Вид("столбик"),
		Кит.Разделитель("или"),
		Кит.Область(
			Кит.Кнопка("Войти через GitHub").Вторичная().Иконка("бренд:github").ВоВсюШирину()
				.Адрес("/login/oidc/github"),
			Кит.Кнопка("Войти через Корпоративный вход").Вторичная().Иконка("ключ").ВоВсюШирину()
				.Адрес("/login/oidc/corp")).Вид("столбик"),
		Кит.Примечание(Кит.Шаблон("Нет аккаунта? %1", Кит.Ссылка("/register", "Зарегистрироваться")))
			.Вид("рамка"),
		Кит.Примечание(Кит.Ссылка("https://db-ip.com", "IP Geolocation by DB-IP")).Вид("источник"))
		.Шапка("/static/mark.svg", "Вход в OpenHub"));

	Возврат Результат;

КонецФункции

Функция Пункты(Знач Адрес)

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Открыть", Адрес, "открыть"));
	Результат.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Настройки", Адрес + "/настройки",
		"шестерёнка"));
	Возврат Результат;

КонецФункции

Функция Раздел(Знач Ключ, Знач Образцы)
	Возврат Новый Структура("Ключ, Образцы", Ключ, Образцы);
КонецФункции

Процедура Добавить(Образцы, Знач Подпись, Знач Узел)
	Образцы.Добавить(Новый Структура("Подпись, Разметка", Подпись, Узел.Рендер()));
КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Кит)
	Кит = _Кит;
КонецПроцедуры
