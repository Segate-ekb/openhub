// Широкий образец выдачи кита: по образцу каждого узла и компонента, которыми хаб печатает
// экраны, — родов холста, форм всех четырёх родов, окон и компонентов.
// Сторожа статики и разметки сверяют с ним листы стилей, ритм форм, имена полей и меню
// на странице. Узел, который экран хаба начинает печатать, добавляется сюда тем же заходом.

Перем Кит;    // Кит — фабрика узлов экрана

// Разделы образца: у каждого раздела образцы с подписью и напечатанной разметкой.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Образцы; образец — Подпись, Разметка.
//
Функция Разделы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Раздел("ввод", ОбразцыВвода()));
	Результат.Добавить(Раздел("показ", ОбразцыПоказа()));
	Результат.Добавить(Раздел("навигация", ОбразцыНавигации()));
	Результат.Добавить(Раздел("окна и формы", ОбразцыОкон()));
	Результат.Добавить(Раздел("настройки", ОбразцыНастроек()));
	Результат.Добавить(Раздел("экран списка", ОбразцыЭкранаСписка()));
	Результат.Добавить(Раздел("аккаунт", ОбразцыАккаунта()));
	Результат.Добавить(Раздел("поля настроек", ОбразцыПолейНастроек()));
	Результат.Добавить(Раздел("брендирование", ОбразцыБрендирования()));
	Результат.Добавить(Раздел("пул, зеркала и группа", ОбразцыПулаИГруппы()));
	Результат.Добавить(Раздел("права", ОбразцыПрав()));
	Результат.Добавить(Раздел("получатели", ОбразцыПолучателей()));
	Результат.Добавить(Раздел("настройки пакета", ОбразцыНастроекПакета()));
	Результат.Добавить(Раздел("вход", ОбразцыВхода()));
	Результат.Добавить(Раздел("каталог", ОбразцыКаталога()));
	Возврат Результат;

КонецФункции

// Все образцы одним телом страницы; каркас добавляет вызывающий.
//
// Возвращаемое значение:
//  Строка - HTML.
//
Функция Отрисовать() Экспорт

	Части = Новый Массив();
	Части.Добавить(Кит.ЗаголовокСтраницы(Новый Структура("Заголовок, Пояснение",
		"UI-кит", "образцы узлов и компонентов, которыми хаб печатает экраны")).Рендер());

	Для Каждого Часть Из Разделы() Цикл
		Для Каждого Образец Из Часть.Образцы Цикл
			Части.Добавить(Образец.Разметка);
		КонецЦикла;
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

#Область Образцы

Функция ОбразцыВвода()

	Результат = Новый Массив();

	Добавить(Результат, "форма столбиком", Кит.ФормаБезТокена("/проекты",
		Кит.Поле("имя", "Имя проекта").Пример("альфа").Обязательное(),
		Кит.Поле("почта", "Почта").ТипЗначения("email"),
		Кит.Поле("описание", "Описание").Многострочное(),
		Кит.Поле("квота", "Квота, ГБ").ТипЗначения(Тип("Число")),
		Кит.Поле("вид", "Вид").Вариант("открытый", "Открытый").Вариант("закрытый", "Закрытый"),
		Кит.Поле("архив", "В архиве").ТипЗначения(Тип("Булево")),
		Кит.Тумблер("письма", "Письма о сбоях").Включено(),
		Кит.Кнопка("Создать").Основная()).Вид("столбик"));

	Добавить(Результат, "форма отбора строкой", Кит.ФормаОтбора("/документы",
		Кит.Поле("q", "Поиск"),
		Кит.Кнопка("Найти").Вторичная()).Вид("строкой"));

	Добавить(Результат, "строка поиска", Кит.СтрокаПоиска("/поиск").Имя("q").Метка("Поиск")
		.Кнопка("Найти", "поиск"));

	// первая полоса главной и каталог: поле без подписи, подсказка в самом поле, отправляет
	// значок поиска в самой строке
	Добавить(Результат, "строка поиска без подписи", Кит.СтрокаПоиска("/поиск")
		.Пример("Имя пакета или его часть"));

	Добавить(Результат, "группа полей", Кит.ФормаБезТокена("/срок",
		Кит.Группа("Срок действия",
			Кит.Поле("дней", "Дней").ТипЗначения(Тип("Число")).Значение(30),
			Кит.Примечание("От 1 до 90 дней.")),
		Кит.Кнопка("Сохранить").Основная()));

	Добавить(Результат, "кнопки", Кит.Ряд("действия",
		Кит.Кнопка("Сохранить").Основная().Иконка("сохранить"),
		Кит.Кнопка("Отмена").Вторичная().Адрес("/проекты"),
		Кит.Кнопка("Удалить").Опасная().Малая()));

	Добавить(Результат, "форма вошедшего с токеном", Кит.Форма("/проекты/альфа/ключи",
		Кит.Поле("ключ", "Имя ключа").Обязательное(),
		Кит.Кнопка("Выпустить ключ").Основная()).Токен("т0кен").Вид("столбик"));

	Добавить(Результат, "дерево галок", Кит.ДеревоГалок(Новый Структура("Подпись, Узлы",
		"Получатели", УзлыДерева())));

	Добавить(Результат, "поле из конфигурации", Кит.ПолеИзКонфига(
		Новый Структура("Метка, Значение, Деталька, Переменная, Подсказка, Секрет",
			"Каталог данных", "/var/lib/hub", "app.storage.root", "OSHUB_STORAGE", "задаётся при запуске", Ложь)));

	Возврат Результат;

КонецФункции

Функция ОбразцыПоказа()

	Результат = Новый Массив();

	Добавить(Результат, "плашки", Кит.Ряд("справа",
		Кит.Плашка("черновик"), Кит.Плашка("стабильный").Вид("ok"),
		Кит.Плашка("устаревший").Вид("warn")));

	Добавить(Результат, "карточка", Кит.Карточка(Новый Структура("Заголовок, Описание, Адрес",
		"альфа", "Отчёты команды аналитики", "/проекты/альфа")));

	Добавить(Результат, "шапка объекта", Кит.ШапкаОбъекта(Новый Структура("Имя, Описание",
		"альфа", "Отчёты команды аналитики")));

	Добавить(Результат, "сводка", Кит.Сводка("альфа").Подпись("1.2.0").Сведение("Скачиваний", "12"));

	Добавить(Результат, "свойства", Кит.Свойства(
		Кит.Свойство("Адрес", "https://hub.example.org").Копируемое("https://hub.example.org"),
		Кит.Свойство("Токен", "т0кен").Секрет()));

	Добавить(Результат, "таблица карточками", ТаблицаСМеню());

	Добавить(Результат, "таблица из данных с прочерком", ТаблицаСПрочерком());
	// список пулов: меню ⚙ узкой колонкой, у строки без меню ячейка пустая, а не с прочерком
	Добавить(Результат, "таблица из данных с меню и пустой ячейкой меню", ТаблицаСМенюИзДанных());

	Добавить(Результат, "пустое состояние", Кит.ПустоеСостояние(Новый Структура("Заголовок, Пояснение",
		"Пакетов нет", "Опубликуйте первый пакет командой opm push.")));

	Добавить(Результат, "блок команды", Кит.БлокКоманды(Новый Структура("Команда, Подпись",
		"opm install альфа", "Установка")));

	Добавить(Результат, "уведомление", Кит.Уведомление(Новый Структура("Текст, Вид",
		"Ключ отозван", "warn")));

	Добавить(Результат, "полоса заполнения", Кит.ПолосаЗаполнения(Новый Структура("Процент, Метка",
		40, "занято 40 МБ из 100")));

	Добавить(Результат, "сетка плиток", Кит.Сетка(
		Кит.Плитка(Новый Структура("Значение, Подпись", "12", "пакетов")),
		Кит.Плитка(Новый Структура("Значение, Подпись", "3", "пула"))));

	// списки главной: по четыре в ряд, неполный последний ряд прячет лист кита
	Добавить(Результат, "сетка полными рядами", Кит.Сетка(
		Кит.Плитка(Новый Структура("Значение, Подпись", "1", "пакет")),
		Кит.Плитка(Новый Структура("Значение, Подпись", "2", "пакет")),
		Кит.Плитка(Новый Структура("Значение, Подпись", "3", "пакет")),
		Кит.Плитка(Новый Структура("Значение, Подпись", "4", "пакет")),
		Кит.Плитка(Новый Структура("Значение, Подпись", "5", "пакет"))).Колонки(4).ПолныеРяды());

	Добавить(Результат, "ряд меты", Кит.РядМеты(ЭлементыМеты(), "карточка"));

	Добавить(Результат, "проводник", Кит.Проводник(Новый Структура("Шаги", ШагиПроводника())));

	Добавить(Результат, "страница ошибки", Кит.СтраницаОшибки(Новый Структура("Код, Сообщение",
		404, "Такого пакета в пуле нет")));

	Добавить(Результат, "раскрывашка", Кит.Раскрывашка(Кит.Примечание("Ключ создан вчера."))
		.Шапка("Подробности").Вид("врезка"));

	Добавить(Результат, "опасная зона", Кит.ОпаснаяЗона("Удалить проект")
		.Пояснение("Удаление необратимо.")
		.Подтверждение("имя", "альфа", "Имя проекта", "Введите имя проекта, чтобы удалить его")
		.Кнопка("Удалить"));

	Возврат Результат;

КонецФункции

Функция ОбразцыНавигации()

	Результат = Новый Массив();

	Добавить(Результат, "вкладки", Кит.Табы(
		Кит.Вкладка("Описание", "/проекты/альфа").Активна(),
		Кит.Вкладка("Версии", "/проекты/альфа/версии")));

	Добавить(Результат, "крошки", Кит.Крошки(
		Кит.Крошка("Проекты", "/проекты"), Кит.Крошка("альфа")));

	Добавить(Результат, "страницы", Кит.Пагинация(Новый Структура("Основа, Страница, ВсегоСтраниц",
		"/проекты", 2, 5)));

	Добавить(Результат, "страницы без перезагрузки", Кит.Пагинация("/проекты", 1, 3).БезПерезагрузки());

	Добавить(Результат, "меню", Кит.Меню(Новый Структура("Подпись, Пункты", "Действия над «альфа»",
		Пункты("/проекты/альфа"))));

	Возврат Результат;

КонецФункции

Функция ОбразцыОкон()

	Результат = Новый Массив();


	Добавить(Результат, "окно с проверкой поля", Кит.Окно("Новый проект",
			Кит.СкрытоеПоле("операция", "добавить"),
			Кит.Поле("имя", "Имя проекта").Ид("obrazec-imya").Обязательное().Длина(1, 100)
				.Шаблон("[A-Za-z0-9][A-Za-z0-9_.\-]*").ПроверкаНаСервере("/проекты")
				.Подсказка("латиница и цифры"))
		.Лид("Проект появится в списке сразу.").Якорь("obrazec-okno")
		.Форма("/проекты").БезПерезагрузки().Токен("т0кен").АдресЗакрытия("/проекты")
		.Действия(Кит.Кнопка("Создать").Основная().Иконка("плюс")));

	Добавить(Результат, "подтверждение своей формой", Кит.Подтверждение("Удалить «альфа»?",
			"Проект пропадёт вместе с ключами.", Кит.СкрытоеПоле("имя", "альфа"))
		.Кнопка("Удалить").Форма("/проекты/удалить").Якорь("obrazec-podtverzhdenie")
		.Токен("т0кен").Открыто().АдресЗакрытия("/проекты"));

	Добавить(Результат, "меню с окном по адресу", Кит.Меню("Действия над «альфа»",
		Кит.ОкноПоАдресу("/проекты?окно=удалить-альфа", "Удалить").Опасная().Иконка("закрыть"),
		Кит.ПунктМеню("Настройки", "/проекты/альфа/настройки").Иконка("шестерёнка")));

	Возврат Результат;

КонецФункции

Функция ОбразцыНастроек()

	Результат = Новый Массив();

	Дом = Кит.ДомНастроек("Настройки проекта", "/проекты/альфа/настройки", "т0кен",
		Кит.Секция("Описание",
			Кит.Поле("описание", "Описание").Многострочное().Значение("Отчёты команды"))
			.Лид("Короткий текст под именем проекта").Форма("описание"))
		.Ключ("project").Объект("альфа");
	Дом.Раздел("Общее", "", "шестерёнка").Текущий();
	Дом.Раздел("Ключи", "ключи", "ключ");

	Добавить(Результат, "дом настроек", Дом);

	// карточка одной формой с панелью и пометки тумблерами — каждая своей формой, сохраняется сразу
	Карточка = Кит.ДомНастроек("Настройки пакета", "/пакеты/альфа/настройки", "т0кен",
		Кит.Секция("Карточка",
			Кит.Поле("метки", "Ключевые слова").Список().Значение("отчёты, сводки")
				.Подсказка("По ним пакет находят"),
			Кит.Поле("репозиторий", "Репозиторий").ТипЗначения("url").Пример("https://example.org/альфа"))
			.Лид("Что видит потребитель").Иконка("пакет").Форма(),
		Кит.Секция("В каталоге",
			Кит.Форма("hidden",
				Кит.Тумблер("скрыт", "Скрыт из каталога").Подписи("да", "нет")
					.Подсказка("Не показывается в поиске").СохранятьСразу()).БезПерезагрузки())
			.Лид("Сохраняется сразу.").Иконка("поиск"))
		.Ключ("package").Объект("альфа");
	Карточка.Раздел("Карточка", "card", "пакет").Текущий();

	Добавить(Результат, "дом настроек: форма карточки и пометки сразу", Карточка);

	Возврат Результат;

КонецФункции

// поток «пакет» Х4а
// Настройки пакета: таблица версий с колонками чисел и меню строки (форма из одной кнопки, окно
// и подтверждение по адресу), реестр доверия с картинкой и фактами, окно с типом сегментами
// и кнопкой разбора без проверки полей, опасная секция — кнопка-ссылка на подтверждение с эхом.
Функция ОбразцыНастроекПакета()

	Результат = Новый Массив();

	СтрокиВерсий = Новый Массив();
	СтрокиВерсий.Добавить(Новый Структура("version, downloads, size, actions", Кит.Код("1.2.0"), 1204, "12 КБ",
		Кит.Меню("Действия с версией 1.2.0",
			Кит.Форма("", Кит.СкрытоеПоле("операция", "yank"), Кит.Кнопка("Отозвать").Иконка("вниз"))
				.Вид("меню").БезПерезагрузки(),
			Кит.ОкноПоАдресу("/пакеты/альфа/настройки/versions?окно=тег-1.2.0", "Поставить тег").Иконка("тег"),
			Кит.ОкноПоАдресу("/пакеты/альфа/настройки/versions?окно=снять-lts@1.2.0", "Снять тег «lts»")
				.Опасная().Иконка("закрыть"))));
	Таблица = Кит.Таблица(СтрокиВерсий).Вид("карточками").Пустое("—");
	Таблица.Колонка("version", "Версия").Заглавная();
	Таблица.Колонка("downloads", "Скачиваний").Вид("число");
	Таблица.Колонка("size", "Размер").Вид("число");
	Таблица.Колонка("actions", "").Вид("узкая").БезПодписиВЗаписи().Пустое("");

	ОкноДоверия = Кит.Окно("Доверить конвейеру",
			Кит.Холст(Кит.Поле("ссылка", "Ссылка на файл workflow").Справка("Адрес файла в браузере"),
				Кит.Ряд("справа", Кит.Кнопка("Разобрать ссылку").Вторичная().Малая().Иконка("палочка")
					.Имя("операция", "разобрать").БезВалидации())),
			Кит.Сегменты("провайдер",
				Кит.Сегмент("github", "GitHub Actions", Кит.Поле("конвейер", "Конвейер")),
				Кит.Сегмент("gitlab", "GitLab CI", Кит.Поле("конвейер_gitlab", "Конвейер").Значение(".gitlab-ci.yml")))
				.Подпись("Тип репозитория"),
			Кит.Поле("репозиторий", "Репозиторий").Обязательное(),
			Кит.Раскрывашка(Кит.Поле("издатель", "Издатель").Вариант("", "по типу репозитория"))
				.Шапка("Дополнительно"))
		.Форма("").Адрес("/пакеты/альфа/настройки/ci?окно=новый").БезПерезагрузки().Якорь("doverie-obrazec")
		.АдресЗакрытия("/пакеты/альфа/настройки/ci")
		.Действия(Кит.Кнопка("Доверить конвейеру").Основная().Иконка("ключ").Имя("операция", "доверить"));

	Удаление = Кит.Подтверждение("Удалить пакет «альфа»?", "Вернуть пакет нельзя.",
			Кит.СкрытоеПоле("операция", "пакет-удалить"))
		.Эхо("подтверждение", "альфа", "Имя пакета").Кнопка("Удалить пакет").Форма("").Якорь("paket-udalit-obrazec");

	Дом = Кит.ДомНастроек("Настройки пакета", "/пакеты/альфа/настройки", "т0кен",
		Кит.Секция("Версии и метки", Таблица).Лид("Отзыв, возврат и теги.").Иконка("история"),
		Кит.Секция("Доверенные конвейеры",
				Кит.Реестр(Кит.ЗаписьРеестра("acme/lib",
						Кит.Свойства(Кит.Свойство("Реф", Кит.Код("v*")).Копируемое("v*")))
					.Картинка("/static/icons/github.svg").Плашка("GitHub Actions")
					.Факт("Конвейер", "release.yml").Факт("Реф", "v*")
					.Кнопки(Кит.ОкноПоАдресу("/пакеты/альфа/настройки/ci?окно=удалить-1", "Отозвать")
						.Опасная().Иконка("корзина"))),
				ОкноДоверия)
			.Иконка("ключ").Действия(Кит.Кнопка("Доверить конвейеру").Основная().Иконка("плюс").Открывает(ОкноДоверия)),
		Кит.Секция("Опасная зона",
				Кит.Примечание("У пакета нет ни одной версии."),
				Кит.Кнопка("Удалить пакет").Опасная().Иконка("корзина")
					.Адрес("/пакеты/альфа/настройки/danger?окно=удалить").Открывает(Удаление),
				Удаление)
			.Иконка("предупреждение").Опасная())
		.Ключ("package").Объект("альфа");
	Дом.Раздел("Версии и метки", "versions", "закладка").Текущий();

	Добавить(Результат, "настройки пакета: версии, доверие, опасная зона", Дом);

	Возврат Результат;

КонецФункции

// Экран списка: реестр с тумблером и меню ⚙, окно шагами, окна по адресу и подтверждение.
Функция ОбразцыЭкранаСписка()

	Результат = Новый Массив();

	Новый_ = Кит.Окно("Новый ключ",
			Кит.Шаги(
				Кит.Шаг("Ключ",
					Кит.Сегменты("права",
						Кит.Сегмент("чтение", "Чтение"),
						Кит.Сегмент("запись", "Запись",
							Кит.Поле("пулы", "Пулы").Список().Значение("corp, public")))
						.Подпись("Права").Выбрано("чтение"),
					Кит.Поле("имя", "Имя").Обязательное().Шаблон("[a-z]+").Справка("Латиницей")),
				Кит.Шаг("Срок", Кит.Поле("дней", "Дней").ТипЗначения(Тип("Число"))))
				.Кнопка("Выпустить"))
		.Форма("/ключи").БезПерезагрузки().Якорь("obrazec-novyi-klyuch").АдресЗакрытия("/ключи");

	Удаление = Кит.Подтверждение("Удалить ключ «сборка»?", "Вход по ключу перестанет работать.")
		.Эхо("ключ", "сборка").Кнопка("Удалить").Форма("/ключи/сборка/delete")
		.Якорь("obrazec-udalit-klyuch").АдресЗакрытия("/ключи");

	Запись = Кит.ЗаписьРеестра("сборка",
			Кит.Свойства(Кит.Свойство("префикс", Кит.Код("ak_7f2c")).Копируемое()))
		.Значок("ключ").Плашка(Кит.Плашка("чтение").Вид("ok")).Подпись("ключ для сборки")
		.Действия(Кит.Форма("/ключи/сборка/toggle",
			Кит.Тумблер("вкл", "Ключ включён").Включено().СохранятьСразу()).БезПерезагрузки())
		.Кнопки(
			Кит.ОкноПоАдресу("/ключи?окно=изменить-сборка", "Изменить").Основная().Иконка("карандаш"),
			Кит.Кнопка("Удалить").Опасная().Иконка("корзина").Открывает(Удаление));

	Добавить(Результат, "реестр с меню, окнами и подтверждением", Кит.Холст(
		Кит.Кнопка("Новый ключ").Основная().Иконка("плюс").Открывает(Новый_),
		Кит.Реестр(Запись).Подпись("Ключи"),
		Новый_, Удаление).Токен("т0кен"));

	Добавить(Результат, "реестр провайдеров: значок записи брендом, поле значка только брендами", Кит.Холст(
		Кит.Реестр(Кит.ЗаписьРеестра("github", Кит.Свойства(Кит.Свойство("client_id", Кит.Код("Iv1.4f2a"))))
			.Значок("бренд:github").Подпись("Кнопка «GitHub»")).Подпись("Провайдеры"),
		Кит.Форма("/провайдеры/своё/save",
			Кит.Поле("значок", "Значок").ВыборЗначка().Разделы("бренды").Пусто("По издателю")
				.Значение("бренд:keycloak"),
			Кит.Кнопка("Сохранить").Основная())).Токен("т0кен"));

	Добавить(Результат, "таблица с меню форм и окном на странице по адресу", ТаблицаТегов());

	Добавить(Результат, "таблица с отбором, страницами и меню строки", ТаблицаЛюдей());

	Добавить(Результат, "таблица пулов: полоса в ячейке, меню с домом и окнами, окно с проверкой имени",
		ТаблицаПулов());

	Добавить(Результат, "нумерованный реестр со стрелками и окно по адресу кнопкой", ИсточникиПоПорядку());

	Добавить(Результат, "окно подписки: сегменты каналов, справка способа, проба и предпросмотр без скрипта",
		ОкноПодписки());

	Добавить(Результат, "спойлер настроек с плашками в шапке, вложенный спойлер и панель сохранения",
		СпойлерНастроек());

	Добавить(Результат, "свойства со ссылкой, полосой и копированием", Кит.Свойства(
		Кит.Свойство("имя", Кит.Код("альфа")).Копируемое("альфа").Примечание("не меняется"),
		Кит.Свойство("видимость", Кит.Плашка("Публичный").Вид("ok"), Кит.Текст(" · "),
			Кит.Ссылка("/проекты/альфа/видимость", "изменить")),
		Кит.Свойство("место", Кит.ПолосаЗаполнения(12, "Заполнение"), "12 МБ из 100 МБ")));

	Возврат Результат;

КонецФункции

// Поля реестра настроек в доме: поле с подсказкой, справкой и источником, тумблер с подписями
// состояния, свёрнутая форма тонких значений, свойства сборки, сброс введённого руками
// и окно выключения с операцией в теле.
Функция ОбразцыПолейНастроек()

	Результат = Новый Массив();

	Значения = Кит.Секция("Основное",
			Кит.Область(Кит.Поле("адрес", "Адрес").Значение("https://пример.рф").Подсказка("Схема, хост и порт")
				.Справка("Из адреса выводится адрес возврата провайдеров").Источник("по умолчанию · адрес"))
				.Признак("setting", "адрес").Признак("source", "default"),
			Кит.Область(Кит.Поле("режим", "Режим").Вариант("open").Вариант("invite").Значение("open")
				.Источник("из базы · режим")).Признак("setting", "режим").Признак("source", "database"),
			Кит.Область(Кит.Поле("лимит", "Лимит").ТипЗначения(Тип("Число")).Значение("10")),
			Кит.Область(Кит.Тумблер("знает", "Знает этот хаб").Подписи("включено", "выключено")
				.Подсказка("Для основного пула"), Кит.Надпись("по умолчанию · знает").Вид("приписка")))
		.Лид("Как хаб представляется").Иконка("куб").Форма("").ПояснениеПанели("Изменения в журнале");
	Тонкие = Кит.Секция("Тонкие настройки", Кит.Поле("сброс", "Сброс, секунд").ТипЗначения(Тип("Число")))
		.Форма("").Свёрнута("Показать тонкие настройки");
	Сборка = Кит.Секция("Сборка", Кит.Свойства(
		Кит.Свойство("версия", Кит.Код("1.2.3")).Копируемое(), Кит.Свойство("кит", "0.13")));
	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Настройка, Сброс", "Адрес",
		Кит.Форма("", Кит.СкрытоеПоле("операция", "сбросить"), Кит.Кнопка("Сбросить").Вторичная().Малая())));
	Таблица = Кит.Таблица(Строки).Вид("карточками");
	Таблица.Колонка("Настройка");
	Таблица.Колонка("Сброс").БезПодписиВЗаписи();
	Сброс = Кит.Секция("Введено вручную", Таблица);
	Выключение = Кит.Подтверждение("Выключить вход?", "Войти можно будет только через провайдера.",
			Кит.СкрытоеПоле("операция", "выключить"), Кит.Примечание("Администраторов — 2"))
		.Эхо("подтверждение", "выключить").Ошибка("Не то слово").Форма("").Якорь("obrazec-vyklyuchit")
		.Открыто();

	Дом = Кит.ДомНастроек("Настройки хаба", "/хаб/настройки", "т0кен", Значения, Тонкие, Сборка, Сброс,
		Кит.Секция("Вход по паролю", Кит.Форма("", Кит.Тумблер("пароль", "Вход по паролю").Включено()
			.СохранятьСразу()), Выключение))
		.Ключ("hub");
	Дом.Раздел("Основное", "", "куб").Текущий();

	Добавить(Результат, "поля реестра настроек", Дом);

	Возврат Результат;

КонецФункции

// Аккаунт: вид сегментами «сохранять сразу» и полем цвета с образцами; окно выпуска ключа
// с деревом пулов, поиском через сервер и ответом поиска; окно секрета с копированием.
Функция ОбразцыАккаунта()

	Результат = Новый Массив();

	Добавить(Результат, "вид: сегменты сразу и цвет образцами", Кит.Форма("/вид",
		Кит.Сегменты("тема", Кит.Сегмент("светлая", "светлая"), Кит.Сегмент("тёмная", "тёмная"))
			.Подпись("Тема").Выбрано("тёмная").СохранятьСразу(),
		Кит.Поле("акцент", "Акцент").ОбразцыТемы()
			.Значение("#4f86f7").Подсказка("Контраст текста хаб выводит сам"),
		Кит.Кнопка("Сохранить").Основная().Иконка("сохранить")).Вид("столбик").БезПерезагрузки()
		.Токен("т0кен"));

	Пулы = Новый Массив();
	Пулы.Добавить(Новый Структура("Имя, Значение, Подпись, Состояние", "пулы", "1", "corp", "вкл"));
	Пулы.Добавить(Новый Структура("Имя, Значение, Подпись, Состояние", "пулы", "2", "team", "выкл"));

	Добавить(Результат, "окно ключа: дерево пулов с поиском", Кит.Окно("Новый ключ",
			Кит.Шаги(
				Кит.Шаг("Где", Кит.Сегменты("где", Кит.Сегмент("хаб", "весь хаб"),
					Кит.Сегмент("пулы", "выбранные пулы",
						Кит.ДеревоГалок(Пулы).Подпись("Пулы").Поиск("/ключи/пулы")))
					.Подпись("Где действует").Выбрано("пулы")),
				Кит.Шаг("Найдено", Кит.ДеревоГалок(Пулы).Подпись("Пулы").Поиск("/ключи/пулы")
					.Найдено("co", 1)))
				.Кнопка("Выпустить"))
		.Форма("/ключи").Якорь("obrazec-klyuch-puly").Токен("т0кен"));

	Добавить(Результат, "окно секрета", Кит.Окно("Ключ выпущен",
			Кит.Свойства(Кит.Свойство("ключ", Кит.Код("ak_1_секрет")).Копируемое("ak_1_секрет")))
		.Лид("Скопируйте его сейчас").Действия(Кит.Кнопка("Готово").Основная().Адрес("/ключи"))
		.Якорь("obrazec-sekret"));

	Возврат Результат;

КонецФункции

// Брендирование: образец шапки с зеркалами полей формы значений (поле с источником и справкой,
// тумблер, сегменты без «сохранять сразу», цвет образцами) и слоты картинок сеткой — со сбросом
// и подтверждением, открытым по адресу.
Функция ОбразцыБрендирования()

	Результат = Новый Массив();

	Дом = Кит.ДомНастроек("Настройки сайта", "/сайт/настройки", "т0кен",
		Кит.Секция("Брендирование",
			Кит.Образец("Так увидят посетители",
				Кит.Область(Кит.Картинка("/static/знак.svg").Вид("значок"),
					Кит.Надпись(Кит.Текст("Метка")).Вид("название").Зеркало("brand").Признак("brand-preview", "name"),
					Кит.Надпись("Каталог")).Вид("полоса").Признак("brand-preview", "head"),
				Кит.Область(Кит.Кнопка("Кнопка акцента").Основная().Иконка("плюс").БезОтправки(),
					Кит.Ссылка("#obrazec-brenda", "ссылка"), Кит.Плашка("плашка").Вид("accent"))
					.Вид("полоса").Зеркало("accent", "#9184d9").Признак("brand-preview", "accent"),
				Кит.Примечание(Кит.Текст("Описание")).Зеркало("tagline").Признак("brand-preview", "foot"))
				.Пресет("oscript", "preset").Якорь("obrazec-brenda"),
			Кит.Поле("brand", "Название").Значение("").Пример("Ромашка").Подсказка("В шапке и во вкладке")
				.Справка("Пустое поле вернёт название по умолчанию").Источник("по умолчанию · site.brand"),
			Кит.Поле("tagline", "Подпись").Значение("Хаб пакетов").Источник("база · site.tagline"),
			Кит.Тумблер("show_name", "Название рядом с логотипом").Включено(Истина)
				.Значения("1", "0").Подписи("включено", "выключено").Подсказка("Выключите для логотипа с названием")
				.Справка("Название остаётся в описании картинки").Источник("по умолчанию · site.show_name"),
			Кит.Группа("Тема", Кит.Сегменты("theme", Кит.Сегмент("светлая", "светлая"),
				Кит.Сегмент("тёмная", "тёмная")).Подпись("Тема").Выбрано("тёмная")
				.Источник("по умолчанию · site.theme")).Вид("простая"),
			Кит.Группа("Пресет темы", Кит.Сегменты("preset", Кит.Сегмент("classic", "Как было"),
				Кит.Сегмент("material", "Новая"), Кит.Сегмент("oscript", "oscript")).Подпись("Пресет темы")
				.Выбрано("oscript").Источник("база · site.preset")).Вид("простая"),
			Кит.Поле("accent", "Акцент").ОбразцыТемы()
				.Значение("#9184d9").Источник("база · site.accent").Ошибка("нужна запись #rrggbb"))
			.Форма("").ПояснениеПанели("Изменения записываются в журнал аудита."),
		Кит.Секция("Логотип и иконка",
			Кит.Сетка(
				Кит.Область(Кит.СлотКартинки("logo", "Логотип").Адрес("/static/знак.svg").Форма("logo")
					.Якорь("obrazec-slot-logo")).Признак("brand-slot", "logo"),
				Кит.Область(Кит.СлотКартинки("favicon", "Иконка").Адрес("/static/знак.svg")
					.Состояние("favicon.svg · 1 КБ").Форма("favicon").Сброс("favicon/reset").Открыто()
					.Якорь("obrazec-slot-favicon").Ошибка("Иконка: файл весит 2 МБ при допустимых 1 МБ."))
					.Признак("brand-slot", "favicon")).Колонки(2),
			Кит.Примечание(Кит.Иконка("предупреждение"), " ", "SVG отдаётся как есть"))
			.Иконка("солнце").Лид("Загружаются сразу"))
		.Ключ("site");
	Дом.Раздел("Брендирование", "", "палочка").Текущий();

	Добавить(Результат, "брендирование: образец в пресете с зеркалами, поля значений и слоты картинок", Дом);
	Возврат Результат;

КонецФункции

// Окно «Получатели» подписки: дерево пулов с тремя режимами — массовыми галками (пакеты пула «все»
// и «никакие» заперты), страницами по адресу, поиском, правками со скриптом и без, сводкой правок и
// рядом выбранного вне показанного с пределом и хвостом «ещё N»; у подписки пула — её пул раскрытой
// веткой с режимами «все / выбранные»; ответ поиска (пакет пула «все» заперт) и страница ветки целиком
// с режимом; отметки в записи — плашки с крестиком, каждая своей тихой формой.
Функция ОбразцыПолучателей()

	Результат = Новый Массив();
	Окно = Кит.Окно("Получатели: релизы в чат",
			Кит.ДеревоГалок(ПулыПолучателей()).Подпись("Пулы и пакеты").Адрес("/подписки/7/recipients")
				.Поиск("/подписки/7/recipients").Режимы("все", "выбранные", "никакие").ТолькоПравки()
				.ПравкиБезСкрипта().СводкаПравок().Отмеченные(ОтмеченныеПолучатели(), "Выбрано")
				.ПределОтмеченных(1, 3))
		.Лид("Получают 2 пула · 3 пакета · новые пакеты в пулах «Все» попадают сами")
		.Действия(Кит.Кнопка("Сохранить").Основная().Иконка("сохранить"))
		.Форма("/подписки/7/recipients").БезПерезагрузки().ВоВесьЭкран().Широкое()
		.Якорь("obrazec-poluchateli").Адрес("/подписки?окно=получатели-7").АдресЗакрытия("/подписки");
	Добавить(Результат, "окно получателей", Кит.Холст(
		Кит.ОкноПоАдресу("/подписки?окно=получатели-7", "Получатели").Вторичная().Иконка("стопка"), Окно)
		.Токен("т0кен"));

	ОкноПула = Кит.Окно("Получатели: релизы пула",
			Кит.ДеревоГалок(ПулПодпискиПула()).Подпись("Пулы и пакеты").Адрес("/pools/corp/webhooks/9/recipients")
				.Поиск("/pools/corp/webhooks/9/recipients").Режимы("все", "выбранные").ТолькоПравки()
				.ПравкиБезСкрипта().СводкаПравок())
		.Лид("Получают 1 пакет из 2 · только выбранные, новые не попадают")
		.Действия(Кит.Кнопка("Сохранить").Основная().Иконка("сохранить"))
		.Форма("/pools/corp/webhooks/9/recipients").БезПерезагрузки().ВоВесьЭкран().Широкое()
		.Якорь("obrazec-poluchateli-pula").Адрес("/pools/corp/webhooks?окно=получатели-9")
		.АдресЗакрытия("/pools/corp/webhooks");
	Добавить(Результат, "окно получателей подписки пула", Кит.Холст(
		Кит.ОкноПоАдресу("/pools/corp/webhooks?окно=получатели-9", "Получатели").Вторичная().Иконка("стопка"),
		ОкноПула).Токен("т0кен"));

	Найдено = Новый Массив();
	Найдено.Добавить(Новый Структура("Имя, Значение, Подпись, Состояние", "галка", "пакет_42", "corp/veles-core", "вкл"));
	Найдено.Добавить(Новый Структура("Имя, Значение, Подпись, Состояние, Отключён, Пояснение", "галка", "пакет_50",
		"team/secret", "выкл", Истина, "пул «Никто» — правка в «Выбранных»"));
	Добавить(Результат, "найдено в получателях", Кит.Форма("/подписки/7/recipients",
		Кит.ДеревоГалок(Найдено).Подпись("Пулы и пакеты").Поиск("/подписки/7/recipients").Найдено("veles", 2)
			.ТолькоПравки().ПравкиБезСкрипта().СводкаПравок()).Токен("т0кен"));
	Добавить(Результат, "страница ветки получателей", Кит.Форма("/подписки/7/recipients",
		Кит.ДеревоГалок(ПакетыПолучателей()).Подпись("corp").Адрес("/подписки/7/recipients")
			.Режимы("все", "выбранные", "никакие").Ветка("пул_7", 2, 52, "выбранные").ТолькоПравки()
			.ПравкиБезСкрипта().СводкаПравок().Отмеченные(ОтмеченныеПолучатели(), "Выбрано")
			.ПределОтмеченных(1, 3, "/подписки/7/recipients?ветка=пул_7&страница=3")).Токен("т0кен"));
	Добавить(Результат, "страница ветки получателей «все»", Кит.Форма("/подписки/7/recipients",
		Кит.ДеревоГалок(ПакетыПолучателей()).Подпись("corp").Адрес("/подписки/7/recipients")
			.Режимы("все", "выбранные", "никакие").Ветка("пул_7", 1, 2, "все").ТолькоПравки()
			.ПравкиБезСкрипта().СводкаПравок()).Токен("т0кен"));

	Добавить(Результат, "отметки получателей в записи", Кит.Холст(Кит.РядПлашек(
		Кит.Плашка("− team").Снять("/подписки/7/recipients", Новый Структура("правки, режим", "1", "пул_8:все"), ,
			"Вернуть пул «team»"),
		Кит.Плашка("+ team/veles-cli").Вид("accent").Снять("/подписки/7/recipients",
			Новый Структура("правки, снять", "1", "пакет_77"), , "Убрать «team/veles-cli» из выбранных"),
		Кит.Плашка("ещё 3"))).Токен("т0кен"));
	Возврат Результат;

КонецФункции

#КонецОбласти

// поток «права»
// Права доступа: таблица карточками с меню отзыва по адресу, «Выдать роль» — ссылка окна, окно с типом
// субъекта сегментами в группе и ролью списком со справкой, подтверждение отзыва без эха со скрытыми
// полями, строка наследования со ссылкой и справкой «?».
Функция ОбразцыПрав()

	Образцы = Новый Массив();

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("subject, type, role, tail", "альфа", "пользователь", "райтер",
		Кит.Меню("Действия: альфа",
			Кит.ОкноПоАдресу("/проекты/альфа/права?окно=отозвать-пользователь-альфа", "Отозвать").Опасная()
				.Иконка("корзина"))));
	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—").Пусто("Ролей никому не выдано.");
	Таблица.Колонка("subject", "Кому").Заглавная();
	Таблица.Колонка("type", "Тип");
	Таблица.Колонка("role", "Роль");
	Таблица.Колонка("tail", "Действия").БезПодписиВЗаписи();

	Выдача = Кит.Окно("Выдать роль",
			Кит.Группа("Кому",
				Кит.Сегменты("тип_субъекта", Кит.Сегмент("пользователь", "пользователь"),
					Кит.Сегмент("группа", "группа")).Подпись("Кому").Выбрано("пользователь"))
				.Вид("простая"),
			Кит.Поле("субъект", "Логин или имя группы").Обязательное().Пример("alice")
				.Ошибка("Пользователь или группа с таким именем не найдены"),
			Кит.Поле("роль", "Роль").Вариант("читатель", "читатель").Вариант("райтер", "райтер")
				.Значение("читатель").Справка("Каждая роль включает предыдущую."),
			Кит.СкрытоеПоле("операция", "выдать"))
		.Лид("Роль на проекте не даёт прав на остальное.")
		.Форма("/проекты/альфа/права").БезПерезагрузки().Якорь("obrazec-vydat-rol")
		.Адрес("/проекты/альфа/права?окно=выдать").АдресЗакрытия("/проекты/альфа/права")
		.Действия(Кит.Кнопка("Выдать роль").Основная().Иконка("плюс"));

	Отзыв = Кит.Подтверждение("Отозвать роль «райтер» у альфа?", "Доступ пропадёт сразу.",
			Кит.СкрытоеПоле("операция", "отозвать"),
			Кит.СкрытоеПоле("тип_субъекта", "пользователь"),
			Кит.СкрытоеПоле("субъект", "альфа"))
		.Кнопка("Отозвать").Форма("/проекты/альфа/права").БезПерезагрузки().Якорь("obrazec-otozvat-rol")
		.АдресЗакрытия("/проекты/альфа/права")
		.Открыто();

	Добавить(Образцы, "права доступа", Кит.Холст(
		Кит.Кнопка("Выдать роль").Основная().Иконка("плюс").Открывает(Выдача),
		Таблица,
		Кит.Примечание(Кит.Шаблон("Роль на пуле действует и на этот проект: %1.",
				Кит.Ссылка("/проекты/права", "права доступа пула")),
			Кит.Подсказка("Таблица — только роли на самом проекте.").Подпись("Кто ещё распоряжается")),
		Выдача, Отзыв).Токен("т0кен"));

	Возврат Образцы;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Окно подписки: канал сегментами с набором полей и справкой «?» у строки, текст канала панелью
// его сегмента на другом шаге, кнопки предпросмотра и пробы, шлющие форму окна на свой адрес без
// проверки полей.
Функция ОкноПодписки()

	Окно = Кит.Окно("Новая подписка",
			Кит.Шаги(
				Кит.Шаг("Куда",
					Кит.Сегменты("тип_действия",
						Кит.Сегмент("telegram", "Telegram",
							Кит.Примечание("Как устроен этот способ", Кит.Подсказка("Сообщение вашим ботом.")
								.Подпись("Telegram")),
							Кит.Поле("chat-id", "Чат").Пример("-100").Справка("Числовой идентификатор чата"),
							Кит.Поле("бот-токен", "Токен").Секрет().Подсказка("После сохранения не показывается.")),
						Кит.Сегмент("вебхук", "Вебхук", Кит.Поле("url", "Адрес")))
						.Подпись("Способ доставки")),
				Кит.Шаг("Текст",
					Кит.ПанельСегмента("тип_действия", "telegram",
						Кит.Поле("шаблон-текста", "Свой текст").Многострочное(),
						Кит.Надпись(Кит.Кнопка("Показать, как придёт").Вторичная().Малая()
							.АдресОтправки("/подписки/preview").БезВалидации()).Признак("sub-preview-button", "")),
					Кит.Уведомление("Пробное дошло: HTTP 200").Вид("ok"),
					Кит.Надпись(Кит.Кнопка("Отправить пробное").Вторичная().Иконка("конверт")
						.АдресОтправки("/подписки/test"))))
				.Кнопка(Кит.Кнопка("Создать подписку").Основная().Иконка("плюс")))
		.Форма("/подписки").Якорь("obrazec-podpiska").Адрес("/подписки?окно=новая");
	Возврат Кит.Холст(Кит.Кнопка("Добавить подписку").Основная().Иконка("плюс").Открывает(Окно), Окно)
		.Токен("т0кен");

КонецФункции

// Спойлер настроек под списком: плашки состояния в шапке, тумблеры и вложенный спойлер полей
// одной формой с панелью сохранения.
Функция СпойлерНастроек()

	Возврат Кит.Раскрывашка(
			Кит.Форма("/подписки/delivery",
				Кит.Тумблер("доставка", "Доставка уведомлений").Включено().Подписи("включена", "выключена"),
				Кит.Раскрывашка(Кит.Поле("прокси", "Сервер").Источник("по умолчанию · прокси"))
					.Шапка("Прокси", Кит.Плашка("не задан")).Вид("врезка"),
				Кит.ПанельСохранения("Сохранить").Пояснение("Изменения записываются в журнал."))
				.БезПерезагрузки())
		.Шапка(Кит.Иконка("конверт"), "Настройки доставки", Кит.Плашка("включена").Вид("ok"),
			Кит.Плашка("прокси не задан"))
		.Вид("врезка").Токен("т0кен");

КонецФункции

// Порядок значим: записи нумеруются, стрелки — одна форма с двумя кнопками, крайняя стрелка
// недоступна; окно новой записи открывает кнопка-ссылка его адреса.
Функция ИсточникиПоПорядку()

	Новый_ = Кит.Окно("Новый источник", Кит.Поле("url", "Адрес").ТипЗначения("url").Обязательное())
		.Форма("/источники").БезПерезагрузки().Якорь("obrazec-novyi-istochnik").Адрес("/источники?окно=новый")
		.Действия(Кит.Кнопка("Добавить").Основная());

	Реестр = Кит.Реестр().Нумерованный().Подпись("Источники");
	Для Каждого Номер Из СтрРазделить("1,2", ",") Цикл
		Ниже = Кит.Кнопка("Ниже").Иконка("вниз").ТолькоИконка().Малая().Вторичная().Имя("сдвиг", "вниз");
		Выше = Кит.Кнопка("Выше").Иконка("вверх").ТолькоИконка().Малая().Вторичная().Имя("сдвиг", "вверх");
		Если Номер = "1" Тогда
			Выше.Заблокирована();
		Иначе
			Ниже.Заблокирована();
		КонецЕсли;
		Реестр.Добавить(Кит.ЗаписьРеестра("https://data" + Номер + ".example/",
				Кит.Свойства(Кит.Свойство("кэш", "900 с")))
			.Плашка(Кит.Плашка("жив").Вид("ok")).Факт("последний синк", "вчера, 18:40")
			.Действия(Кит.Форма("/источники/" + Номер + "/move", Ниже, Выше).БезПерезагрузки())
			.Кнопки(Кит.ОкноПоАдресу("/источники?окно=удалить-" + Номер, "Удалить").Опасная().Иконка("корзина")));
	КонецЦикла;

	Публикация = Кит.Форма("/источники/публикация",
		Кит.Тумблер("публикация", "Публикация разрешена").Включено().Подписи("принимает", "не принимает")
			.СохранятьСразу()).БезПерезагрузки();

	Возврат Кит.Холст(Кит.Кнопка("Добавить источник").Основная().Иконка("плюс").Открывает(Новый_),
		Реестр, Новый_, Публикация).Токен("т0кен");

КонецФункции

Функция ТаблицаСМеню()

	Строки = Новый ТаблицаЗначений();
	Строки.Колонки.Добавить("Имя");
	Строки.Колонки.Добавить("Состояние");
	Строки.Колонки.Добавить("Действия");

	Для Каждого Имя Из СтрРазделить("альфа,дельта", ",") Цикл
		Строка = Строки.Добавить();
		Строка.Имя = Кит.Ссылка("/проекты/" + Имя, Имя);
		Строка.Состояние = Кит.Плашка("активна").Вид("ok");
		Строка.Действия = Кит.Меню(Новый Структура("Подпись, Пункты", "Действия над «" + Имя + "»",
			Пункты("/проекты/" + Имя)));
	КонецЦикла;

	Возврат Кит.Таблица(Строки).Вид("карточками").Пусто("Проектов нет.");

КонецФункции

// Окно на странице с адресом (кнопка — ссылка data-opens) и кнопкой пробы без проверки полей,
// плашка-ссылка, меню строки с формой из одной кнопки, образец плашки со сменой темы, зеркалящий
// имя текстом, стиль и значок — признаками; значок выбирается сеткой кита.
Функция ТаблицаТегов()

	Образец = Кит.Плашка(Новый Структура("Вид", "ok"),
			Кит.Иконка(Новый Структура("Имя", "замок")),
			Кит.Надпись(Кит.Текст("stable")).Зеркало("имя"))
		.ЗеркалоПризнаком("стиль", "stable").ЗеркалоПризнаком("значок", "замок");

	Новый_ = Кит.Окно("Новый тег",
			Кит.Поле("имя", "Имя тега").Обязательное().ПроверкаНаСервере("/теги?проверка=имя"),
			Кит.Кнопка("Проверить состав").Вторичная().Малая().Имя("операция", "проверить").БезВалидации(),
			Кит.Сегменты("стиль", Кит.Сегмент("plain", "Обычный"), Кит.Сегмент("stable", "Стабильный"))
				.Подпись("Стиль").Выбрано("stable"),
			Кит.Поле("значок", "Значок").ВыборЗначка().Пусто("Без значка").Значение("замок"),
			Кит.Образец("Так будет выглядеть плашка", Образец))
		.Форма("/теги").БезПерезагрузки().Якорь("obrazec-novyi-teg").Адрес("/теги?окно=новый")
		.Действия(Кит.Кнопка("Создать тег").Основная());

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Тег, Откуда, Отдаёт, Действия", Кит.Плашка("stable").Вид("ok"),
		Кит.Плашка("из пула corp").Вид("accent").Адрес("/pools/corp/settings/tags"), Неопределено,
		Кит.Меню("Действия с каналом «stable»",
			Кит.ОкноПоАдресу("/теги?окно=изменить-stable", "Изменить").Иконка("карандаш"),
			Кит.Форма("/теги/stable/disable", Кит.Кнопка("Выключить у пакета").Вторичная().Иконка("стоп"))
				.Вид("меню"))));
	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—");
	Таблица.Колонка("Тег", "Тег").Заглавная();
	Таблица.Колонка("Откуда", "Откуда");
	Таблица.Колонка("Отдаёт", "Отдаёт");
	Таблица.Колонка("Действия", "").БезПодписиВЗаписи();

	Возврат Кит.Холст(Кит.Кнопка("Новый тег").Основная().Иконка("плюс").Открывает(Новый_), Таблица, Новый_)
		.Токен("т0кен");

КонецФункции

// Таблица людей: отбор строкой без перезагрузки, «1–20 из 37», меню строки — форма из одной кнопки
// и окна по адресу.
Функция ТаблицаЛюдей()

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Логин, Статус, Действия", "альфа", Кит.Плашка("активен").Вид("ok"),
		Кит.Меню("Действия над «альфа»",
			Кит.Форма("/люди/альфа/toggle", Кит.СкрытоеПоле("активна", "0"),
				Кит.Кнопка("Заблокировать").Иконка("замок")).Вид("меню").БезПерезагрузки(),
			Кит.ОкноПоАдресу("/люди?окно=удалить-альфа", "Удалить").Опасная().Иконка("корзина"))));

	Таблица = Кит.Таблица(Строки).Вид("карточками");
	Таблица.Колонка("Логин", "Логин").Заглавная();
	Таблица.Колонка("Статус", "Статус").БезПодписиВЗаписи();
	Таблица.Колонка("Действия", "Действия").БезПодписиВЗаписи();

	Возврат Кит.Холст(
		Кит.СтрокаПоиска("/люди")
			.Поле(Кит.Поле("q", "Поиск").Пример("Логин или email"))
			.Поле(Кит.Поле("status", "Статус").Вариант("", "любой").Вариант("active", "активен"))
			.Кнопка("Найти", "поиск").БезПерезагрузки(),
		Таблица,
		Кит.Пагинация("/люди", 1).Всего(37).НаСтранице(20).Параметры("status", "active").БезПерезагрузки())
		.Токен("т0кен");

КонецФункции

// Таблица пулов: место компактной полосой с припиской, меню строки — пункт-ссылка и окна по адресу;
// окно нового пула с проверкой имени на сервере и числом со справкой, подтверждение с предупреждением.
Функция ТаблицаПулов()

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Имя, Владелец, Место, Действия",
		Кит.Ссылка("/проекты/альфа/настройки", Кит.Текст("альфа")), Неопределено,
		Кит.Холст(Кит.ПолосаЗаполнения(12, "Место «альфа»").Подпись("12 МБ из 100 МБ").Компактная(),
			Кит.Надпись(Кит.Текст("12 МБ из 100 МБ")).Вид("приписка")),
		Кит.Меню("Действия с «альфа»",
			Кит.ПунктМеню("Настройки", "/проекты/альфа/настройки").Иконка("шестерёнка"),
			Кит.ОкноПоАдресу("/проекты?окно=основной-альфа", "Сделать основным").Иконка("закладка"),
			Кит.ОкноПоАдресу("/проекты?окно=удалить-альфа", "Удалить").Опасная().Иконка("корзина"))));

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—");
	Таблица.Колонка("Имя", "Проект").Заглавная();
	Таблица.Колонка("Владелец", "Владелец");
	Таблица.Колонка("Место", "Место").БезПодписиВЗаписи();
	Таблица.Колонка("Действия", "").Вид("узкая");

	Новый_ = Кит.Окно("Новый проект",
			Кит.СкрытоеПоле("операция", "новый"),
			Кит.Поле("имя", "Имя").Обязательное().Шаблон("[a-z]+").ПроверкаНаСервере("/проекты?проверка=1")
				.Пример("platform").Подсказка("латиница"),
			Кит.Поле("квота", "Квота").ТипЗначения(Тип("Число")).Значение("-1").Справка("−1 — как у всех"))
		.Форма("/проекты").БезПерезагрузки().Якорь("obrazec-novyi-proekt").Адрес("/проекты?окно=новый");

	Удаление = Кит.Подтверждение("Удалить «альфа»?", "Уйдут пакеты и права.",
			Кит.Уведомление("Идёт синхронизация зеркала").Вид("warn"))
		.Эхо("имя", "альфа").Кнопка("Удалить").Форма("/проекты/альфа/delete")
		.Якорь("obrazec-udalit-proekt").Открыто();

	Возврат Кит.Холст(
		Кит.Кнопка("Добавить").Основная().Иконка("плюс").Открывает(Новый_),
		Таблица, Новый_, Удаление).Токен("т0кен");

КонецФункции

// Поток «пул» Х4а: видимость сегментами в форме секции, квота полосой и полем со справкой,
// опасная секция с кнопкой окна по адресу и открытым подтверждением с эхом и скрытой операцией;
// счётчики колонкой чисел, зеркала страницей вне дома — таблица с меню форм и окно заведения.
Функция ОбразцыПулаИГруппы()

	Результат = Новый Массив();

	Дом = Кит.ДомНастроек("Настройки пула", "/пулы/альфа/настройки", "т0кен",
		Кит.Секция("Видимость",
			Кит.Группа("Видимость",
				Кит.Сегменты("видимость", Кит.Сегмент("public", "Публичный"), Кит.Сегмент("private", "Приватный"))
					.Подпись("Видимость").Выбрано("public")).Вид("простая"),
			Кит.Примечание("Приватный пул виден только по правам."))
			.Лид("Кто читает пакеты пула.").Иконка("замок").Форма(),
		Кит.Секция("Квота",
			Кит.ПолосаЗаполнения(12, "Заполнение пула").Подпись("12 МБ из 100 МБ"),
			Кит.Примечание("Собственная квота пула: 100 МБ."),
			Кит.Поле("квота_мб", "Квота пула, МБ").ТипЗначения(Тип("Число")).Значение("100")
				.Подсказка("−1 — как в хабе").Справка("Квота меряет всё место пула"))
			.Лид("Сколько места пул может занять.").Иконка("скачать").Форма("quota"),
		Кит.Секция("Квота только для чтения",
			Кит.Свойства(Кит.Свойство("Квота", "Собственная квота пула: 100 МБ.").Примечание("Назначает администратор")))
			.Иконка("скачать"),
		Кит.Секция("Опасная зона",
			Кит.Примечание("Мягче удаления — сделать пул приватным."),
			Кит.Подтверждение("Удалить пул «альфа»?", "Уйдут пакеты и права.",
					Кит.Примечание("Имя «альфа» освободится."),
					Кит.СкрытоеПоле("операция", "пул-удалить"))
				.Эхо("подтверждение", "альфа", "Имя пула", "Введите «альфа»").Кнопка("Удалить пул")
				.Форма("danger").Якорь("obrazec-pul-udalit").Открыто())
			.Лид("Необратимые операции.").Иконка("предупреждение").Опасная()
			.Действия(Кит.ОкноПоАдресу("/пулы/альфа/настройки/danger?окно=удалить", "Удалить пул")
				.Опасная().Иконка("корзина")))
		.Ключ("pool").Объект("альфа");
	Дом.Раздел("Видимость", "visibility", "замок").Текущий();
	Добавить(Результат, "дом пула: сегменты в форме, квота, опасная секция с подтверждением", Дом);

	Счётчики = Новый Массив();
	Счётчики.Добавить(Новый Структура("metric, value", "Скачано", "1 204"));
	Счётчики.Добавить(Новый Структура("metric, value", "Ошибок", "0"));
	Таблица = Кит.Таблица(Счётчики);
	Таблица.Колонка("metric", "Показатель");
	Таблица.Колонка("value", "Значение").Вид("число");
	Добавить(Результат, "счётчики колонкой чисел", Таблица);

	Добавить(Результат, "зеркала пула страницей вне дома: меню форм строки и окно заведения", ЗеркалаВнеДома());
	Добавить(Результат, "дом группы: состав со страницами и окном подбора, подтверждение «Убрать»", СоставГруппы());
	Добавить(Результат, "дом группы: сопоставления с окном, политика тумблером «сохранять сразу»", СвязкаГруппы());

	Возврат Результат;

КонецФункции

Функция ЗеркалаВнеДома()

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("upstream, state, actions", Кит.Код("http://hub.example/download/"),
		Кит.Плашка("включено").Вид("ok"),
		Кит.Меню("Действия с зеркалом",
			Кит.Форма("/кабинет/зеркала/альфа/1/sync", Кит.Кнопка("Синхронизировать").Иконка("стрелка")).Вид("меню"),
			Кит.Форма("/кабинет/зеркала/альфа/1/toggle", Кит.СкрытоеПоле("включить", "0"),
				Кит.Кнопка("Выключить").Иконка("закрыть")).Вид("меню"),
			Кит.ОкноПоАдресу("/кабинет/зеркала/альфа?окно=удалить-1", "Удалить").Опасная().Иконка("корзина"))));

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—");
	Таблица.Колонка("upstream", "Апстрим").Заглавная();
	Таблица.Колонка("state", "Состояние");
	Таблица.Колонка("actions", "Действия").БезПодписиВЗаписи();

	Новое = Кит.Окно("Новое зеркало",
			Кит.Поле("url", "Адрес").ТипЗначения("url").Обязательное(),
			Кит.Поле("токен", "Токен доступа").Секрет(),
			Кит.Поле("фильтр", "Фильтр имён").Список())
		.Форма("/кабинет/зеркала/альфа").БезПерезагрузки().Якорь("obrazec-zerkalo-novoe")
		.Адрес("/кабинет/зеркала/альфа?окно=новый")
		.Действия(Кит.Кнопка("Создать зеркало").Основная().Иконка("плюс"));

	Возврат Кит.Холст(
		Кит.ЗаголовокСтраницы("Зеркала пула альфа").Пояснение("Хаб скачивает пакеты апстрима."),
		Кит.Секция("Зеркала пула", Таблица, Новое).Иконка("копировать")
			.Действия(Кит.Кнопка("Добавить зеркало").Основная().Иконка("плюс").Открывает(Новое)))
		.Токен("т0кен");

КонецФункции

// Поток «пул» Х4а: участники группы — таблица карточками с ⚙ окна по адресу, страницы, окно
// «Добавить участника» со строкой поиска (своя GET-форма держит окно) и выбором формой окна,
// открытое подтверждение «Убрать из группы».
Функция СоставГруппы()

	Адрес = "/группы/альфа/настройки/members";
	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("login, source, actions", "алиса", Кит.Плашка("вручную"),
		Кит.Меню("Действия с участником алиса",
			Кит.ОкноПоАдресу(Адрес + "?окно=убрать-алиса", "Убрать из группы").Опасная().Иконка("выход"))));
	Строки.Добавить(Новый Структура("login, source, actions", "боб", Кит.Плашка("провайдер").Вид("accent"),
		Кит.Меню("Действия с участником боб",
			Кит.ОкноПоАдресу(Адрес + "?окно=убрать-боб", "Убрать из группы").Опасная().Иконка("выход"))));
	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—").Пусто("В группе нет участников.");
	Таблица.Колонка("login", "Логин").Заглавная();
	Таблица.Колонка("source", "Откуда");
	Таблица.Колонка("actions", "Действия").БезПодписиВЗаписи().Пустое("");

	Новый_ = Кит.Окно("Добавить участника",
			Кит.СтрокаПоиска(Адрес).Метка("Поиск").Значение("ка").Пример("Логин или email")
				.СкрытоеПоле("окно", "новый"),
			Кит.Форма("", Кит.Поле("логин", "Учётная запись").Обязательное()
					.Вариант("", "Выберите учётную запись").Вариант("карл", "карл · karl@example.com"))
				.Якорь("obrazec-uchastnik-forma").БезПерезагрузки())
		.Лид("Учётные записи хаба, которых в группе ещё нет.")
		.Адрес(Адрес + "?окно=новый").Якорь("obrazec-uchastnik-novyi").Открыто().АдресЗакрытия(Адрес)
		.Действия(Кит.Кнопка("Добавить").Основная().Иконка("плюс").ВФорме("obrazec-uchastnik-forma"));

	Убрать = Кит.Подтверждение("Убрать «алиса» из группы?",
			"Участник потеряет права, которые даёт группа.")
		.Кнопка("Убрать из группы").Форма("алиса/delete").БезПерезагрузки().Якорь("obrazec-uchastnik-ubrat")
		.АдресЗакрытия(Адрес);

	Дом = Кит.ДомНастроек("Группа", Адрес, "т0кен",
		Кит.Секция("Участники", Таблица,
				Кит.Пагинация(Адрес, 1).Всего(45).НаСтранице(20).БезПерезагрузки(),
				Кит.Примечание("Сверено с клеймами: ещё не сверялся"),
				Новый_, Убрать)
			.Лид("Состав группы и откуда каждое членство.").Иконка("аккаунт")
			.Действия(Кит.Кнопка("Добавить участника").Основная().Иконка("плюс").Открывает(Новый_)))
		.Ключ("group").Объект("альфа");
	Дом.Раздел("Участники", "members", "аккаунт").Текущий();
	Возврат Дом;

КонецФункции

// Сопоставления клеймов — таблица с ⚙, окно нового с отказом под полем; политика выпавших —
// тумблер «сохранять сразу» с кнопкой для работы без скрипта, последняя сверка — свойством.
Функция СвязкаГруппы()

	Адрес = "/группы/альфа/настройки/oidc";
	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("value, claim, issuer, actions", Кит.Код("platform-team"), "groups",
		Кит.Код("https://idp.example.com"),
		Кит.Меню("Действия с сопоставлением platform-team",
			Кит.ОкноПоАдресу(Адрес + "?окно=удалить-1", "Удалить").Опасная().Иконка("корзина"))));
	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—");
	Таблица.Колонка("value", "Значение клейма").Заглавная();
	Таблица.Колонка("claim", "Клейм");
	Таблица.Колонка("issuer", "Издатель (issuer)");
	Таблица.Колонка("actions", "Действия").БезПодписиВЗаписи().Пустое("");

	Новое = Кит.Окно("Добавить сопоставление",
			Кит.Поле("издатель", "Издатель (issuer)").ТипЗначения("url").Обязательное()
				.Ошибка("Укажите издателя."),
			Кит.Поле("клейм", "Имя клейма").Значение("groups"),
			Кит.Поле("значение", "Значение клейма").Обязательное())
		.Форма("").БезПерезагрузки().Якорь("obrazec-sopostavlenie").Адрес(Адрес + "?окно=новый")
		.Действия(Кит.Кнопка("Добавить").Основная().Иконка("плюс"));

	Политика = Кит.Форма("policy",
			Кит.Тумблер("политика", "Выпавших из клейма — оставлять в группе").Включено(Ложь)
				.Значения("оставлять", "исключать").Подписи("оставлять", "исключать").СохранятьСразу())
		.БезПерезагрузки();

	Дом = Кит.ДомНастроек("Группа", Адрес, "т0кен",
		Кит.Секция("Связка с OIDC", Таблица, Новое).Иконка("ссылка")
			.Действия(Кит.Кнопка("Добавить сопоставление").Основная().Иконка("плюс").Открывает(Новое)),
		Кит.Секция("Политика выпавших из клейма", Политика,
			Кит.Свойства(Кит.Свойство("Последняя сверка с клеймами", Кит.Текст("ещё не сверялся"))))
			.Иконка("история"))
		.Ключ("group").Объект("альфа");
	Дом.Раздел("Связка с OIDC", "oidc", "ссылка").Текущий();
	Возврат Дом;

КонецФункции

Функция ТаблицаСПрочерком()

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Имя, Источники", Кит.Ссылка("/проекты/альфа", "альфа"),
		Кит.Плашка("Прокси")));
	Строки.Добавить(Новый Структура("Имя, Источники", Кит.Ссылка("/проекты/дельта", "дельта"),
		Неопределено));

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—");
	Таблица.Колонка("Имя", "Проект").Заглавная();
	Таблица.Колонка("Источники", "Источники");
	Возврат Таблица;

КонецФункции

Функция ТаблицаСМенюИзДанных()

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Имя, Источники, Меню", Кит.Ссылка("/проекты/альфа", "альфа"),
		Неопределено, Кит.Меню("Действия над «альфа»",
			Кит.ПунктМеню("Настройки", "/проекты/альфа/настройки").Иконка("шестерёнка"),
			Кит.ПунктМеню("Пакеты", "/проекты/альфа").Иконка("пакет"))));
	Строки.Добавить(Новый Структура("Имя, Источники, Меню", Кит.Ссылка("/проекты/дельта", "дельта"),
		Неопределено, Кит.Ничего()));

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—");
	Таблица.Колонка("Имя", "Проект").Заглавная();
	Таблица.Колонка("Источники", "Источники");
	Таблица.Колонка("Меню", "").Вид("узкая");
	Возврат Таблица;

КонецФункции

Функция УзлыДерева()

