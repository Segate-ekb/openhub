// Фикстура: рендер настроек без половины контракта (нет КлючПодписи) — на нём сторож полноты
// обязан ронять сборку желудя. Неполон сознательно: дописать метод значит снять проверку.

// Контракт рендера настроек: тип действия подписки.
//
// Возвращаемое значение:
//  Строка - "ревью.тощий".
//
Функция ТипДействия() Экспорт
	Возврат "ревью.тощий";
КонецФункции

// Контракт рендера настроек: описание полей формы. Метод КлючПодписи фикстура
// не реализует намеренно.
//
// Возвращаемое значение:
//  Массив из Структура - описания полей формы.
//
Функция ОписаниеПолей() Экспорт
	Поля = Новый Массив();
	Поля.Добавить(Новый Структура(
		"Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера, Обязательное, Секретное",
		"Поле", "тощее-поле", "review.thin.label", "", "", Истина, Ложь));
	Возврат Поля;
КонецФункции
