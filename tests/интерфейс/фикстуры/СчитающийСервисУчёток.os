// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:InvalidCharacterInFile-off
// BSLLS:YoLetterUsage-off
// СервисПользователей в памяти, считающий обращения: «учётка по идентификатору» и разрез по списку.

Перем Учетки;   // Соответствие: идентификатор -> Структура (Идентификатор, Логин)
Перем Счетчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число
//
Функция Обращений() Экспорт
	Возврат Счетчик.Обращений();
КонецФункции

// Заводит учётку (за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор учётки.
//  Логин - Строка - логин.
//
// Возвращаемое значение:
//  Структура - заведённая учётка.
//
Функция Добавить(Знач Идентификатор, Знач Логин) Экспорт

	Учетка = Новый Структура("Идентификатор, Логин", Цел(Идентификатор), Логин);
	Учетки.Вставить(Цел(Идентификатор), Учетка);
	Возврат Учетка;

КонецФункции

// Учётка по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число - идентификатор учётки.
//
// Возвращаемое значение:
//  Структура, Неопределено
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Счетчик.Отметить();
	Возврат Учетки.Получить(Цел(Идентификатор));
КонецФункции

// Учётки перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы учёток.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Структура; ненайденных ключей в нём нет.
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт

	Счетчик.Отметить();

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Учетка = Учетки.Получить(Цел(Идентификатор));
		Если Учетка <> Неопределено Тогда
			Результат.Вставить(Цел(Идентификатор), Учетка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Учетки = Новый Соответствие();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счетчик = Новый СчётчикОбращений();
КонецПроцедуры
