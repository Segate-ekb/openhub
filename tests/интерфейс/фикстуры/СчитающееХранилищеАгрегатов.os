// ХранилищеСкачиванийАгрегатов в памяти, считающее прочитанные строки: разрезы «весь хаб» и «по списку
// пакетов» стоят одного запроса, а суммы отдаются готовыми, как их считает база, и строк не оставляют.

Перем Агрегаты;   // Массив из Структура (ПакетИдентификатор, ВерсияИдентификатор, Количество)
Перем Счётчик;   // СчётчикОбращений — счёт запросов и прочитанных строк
Перем НомерПоколения;
Перем ОтказатьНаСледующем;

// Заказывает разовый отказ базы: ближайшее чтение бросит исключение, дальнейшие пройдут.
// Так проверяется, что витрина не запоминает сбойное чтение как удавшееся.
Процедура ОтказатьОдинРаз() Экспорт
	ОтказатьНаСледующем = Истина;
КонецПроцедуры

// Поколение таблицы: витрина сверяет его, чтобы заметить чужую запись. Фикстура заводит
// строки методом Добавить — он и меняет поколение.
//
// Возвращаемое значение:
//  Число.
//
Функция Поколение() Экспорт
	Возврат НомерПоколения;
КонецФункции

#Область Счётчики

// Сколько строк агрегатов хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат Счётчик.Строк();
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

#КонецОбласти

// Заводит суточный агрегат (за обращение не считается).
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Количество - Число - сколько скачиваний в строке.
//  ВерсияИдентификатор - Число - идентификатор версии (необязательный, по умолчанию 0).
//
Процедура Добавить(Знач ПакетИдентификатор, Знач Количество, Знач ВерсияИдентификатор = 0) Экспорт

	НомерПоколения = НомерПоколения + 1;
	Агрегаты.Добавить(Новый Структура("ПакетИдентификатор, ВерсияИдентификатор, Количество",
		Цел(ПакетИдентификатор), Цел(ВерсияИдентификатор), Цел(Количество)));

КонецПроцедуры

// Все агрегаты хаба: объём выдачи растёт числом пакетов.
//
// Возвращаемое значение:
//  Массив - все строки агрегатов.
//
Функция Все() Экспорт
	Возврат Отдать(Агрегаты);
КонецФункции

// Агрегаты перечисленных пакетов.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив - строки агрегатов перечисленных пакетов.
//
Функция АгрегатыПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Отдать(Отобрать(ПакетИдентификаторы));
КонецФункции

// Суммы скачиваний по всем пакетам хаба; считает обращение, строк не отдаёт.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пакета), значение Число.
//
Функция СуммыПоПакетам() Экспорт
	Возврат Сумма(Агрегаты);
КонецФункции

// Суммы скачиваний названных пакетов; считает обращение, строк не отдаёт.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пакета), значение Число.
//
Функция СуммыПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Сумма(Отобрать(ПакетИдентификаторы));
КонецФункции

// Суммы скачиваний версий одного пакета; считает обращение, строк не отдаёт.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие - ключ Число (идентификатор версии), значение Число.
//
Функция СуммыВерсийПакета(Знач ПакетИдентификатор) Экспорт
	Возврат Новый ФиксированноеСоответствие(СуммыВерсийПакетов(Только(ПакетИдентификатор)));
КонецФункции

// Суммы скачиваний версий названных пакетов; считает обращение, строк не отдаёт.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор версии), значение Число.
//
Функция СуммыВерсийПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Сумма(Отобрать(ПакетИдентификаторы), "ВерсияИдентификатор");
КонецФункции

// Сумма скачиваний одной версии; считает обращение, строк не отдаёт.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Число - суммарное количество скачиваний версии.
//
Функция СуммаПоВерсии(Знач ВерсияИдентификатор) Экспорт

	Строки = Новый Массив();
	Для Каждого Агрегат Из Агрегаты Цикл
		Если Агрегат.ВерсияИдентификатор = Цел(ВерсияИдентификатор) Тогда
			Строки.Добавить(Агрегат);
		КонецЕсли;
	КонецЦикла;

	Накоплено = Сумма(Строки, "ВерсияИдентификатор").Получить(Цел(ВерсияИдентификатор));
	Возврат ?(Накоплено = Неопределено, 0, Накоплено);

КонецФункции

Функция Сумма(Знач Строки, Знач ИмяКлюча = "ПакетИдентификатор")

	Если ОтказатьНаСледующем Тогда
		ОтказатьНаСледующем = Ложь;
		ВызватьИсключение "СчитающееХранилищеАгрегатов: заказанный разовый отказ базы";
	КонецЕсли;

	Счётчик.Отметить();

	Итог = Новый Соответствие();
	Для Каждого Агрегат Из Строки Цикл
		Было = Итог.Получить(Агрегат[ИмяКлюча]);
		Итог.Вставить(Агрегат[ИмяКлюча], ?(Было = Неопределено, 0, Было) + Агрегат.Количество);
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция Отобрать(Знач ПакетИдентификаторы)

	Нужные = Новый Соответствие();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Нужные.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Агрегат Из Агрегаты Цикл
		Если Нужные.Получить(Агрегат.ПакетИдентификатор) <> Неопределено Тогда
			Отобранные.Добавить(Агрегат);
		КонецЕсли;
	КонецЦикла;

	Возврат Отобранные;

КонецФункции

Функция Только(Знач ПакетИдентификатор)
	Список = Новый Массив();
	Список.Добавить(ПакетИдентификатор);
	Возврат Список;
КонецФункции

Функция Отдать(Знач Строки)

	Если ОтказатьНаСледующем Тогда
		ОтказатьНаСледующем = Ложь;
		ВызватьИсключение "СчитающееХранилищеАгрегатов: заказанный разовый отказ базы";
	КонецЕсли;

	Возврат Счётчик.Отдать(Строки);

КонецФункции

Процедура ПриСозданииОбъекта()
	Агрегаты = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
	НомерПоколения = 0;
	ОтказатьНаСледующем = Ложь;
КонецПроцедуры
