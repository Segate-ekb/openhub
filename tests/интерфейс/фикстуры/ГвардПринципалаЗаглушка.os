// Заглушка гвардов с принципалом — кабинета и аккаунта (ГвардКабинета) и дома «Пул» (ГвардПула):
// впускает учётку с её принципалом и пулом раздела — запрос доходит до настоящего домена;
// «не впускать» — гвард отказал и ответил 403 сам, дальше запрос не идёт.

Перем Пользователь_;
Перем Принципал_;
Перем Пул_;
Перем Отказать_;

// Вердикт допуска. Четвёртый параметр у гвардов разный: имя пула адреса у гварда пула, признак
// страницы смены пароля у гварда кабинета, — заглушка его не читает.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  Уточнение - Произвольный - четвёртый параметр гварда (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Разрешено, Пользователь, Сессия, Принципал, Пул.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач Уточнение = Неопределено) Экспорт

	Если Отказать_ = Истина Тогда
		Ответ.Код = 403;
	КонецЕсли;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	Уточнение = Уточнение;
	Возврат Новый Структура("Разрешено, Пользователь, Сессия, Принципал, Пул",
		Отказать_ <> Истина, Пользователь_, "сессия", Принципал_, Пул_);

КонецФункции

// Впускает учётку с её принципалом.
//
// Параметры:
//  Пользователь - Пользователь - учётка запроса.
//  Принципал - Структура - принципал запроса.
//  Пул - Пул - пул раздела (необязательный, по умолчанию Неопределено).
//
Процедура Впустить(Знач Пользователь, Знач Принципал, Знач Пул = Неопределено) Экспорт
	Пользователь_ = Пользователь;
	Принципал_ = Принципал;
	Пул_ = Пул;
	Отказать_ = Ложь;
КонецПроцедуры

// Больше не впускает никого: так тест видит, что дверь стережёт гвард, а не домен.
//
Процедура НеВпускать() Экспорт
	Отказать_ = Истина;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Отказать_ = Ложь;
КонецПроцедуры
