// ХранилищеУчастниковГрупп в памяти, считающее обращения: членства пользователя —
// первый запрос КАЖДОГО вопроса о правах, и его цена множится на всю модель.

Перем Членства;   // Массив из Структура (ГруппаИдентификатор, ПользовательИдентификатор)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Заводит запись членства (за обращение не считается).
//
// Параметры:
//  ГруппаИдентификатор - Число - группа.
//  ПользовательИдентификатор - Число - участник.
//
Процедура Добавить(Знач ГруппаИдентификатор, Знач ПользовательИдентификатор) Экспорт

	Членства.Добавить(Новый Структура("ГруппаИдентификатор, ПользовательИдентификатор",
		Цел(ГруппаИдентификатор), Цел(ПользовательИдентификатор)));

КонецПроцедуры

// Членства пользователя во всех группах; считает обращение.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив - записи членства в порядке заведения.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт

	Счётчик.Отметить();

	Результат = Новый Массив();
	Для Каждого Членство Из Членства Цикл
		Если Членство.ПользовательИдентификатор = Цел(ПользовательИдентификатор) Тогда
			Результат.Добавить(Членство);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Членства = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
