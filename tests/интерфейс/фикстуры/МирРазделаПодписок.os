// Мир раздела подписок для цены экрана: настоящие службы подписок, поправок и исключений поверх
// хранилищ в памяти, которые считают обращения и прочитанные строки, и витрины раздела над ними
// (СтендВитриныПодписок). Пул 7 «alpha» с тегом «stable», в нём пакеты 42 и 43; пул 8 «beta».

Перем Сервис Экспорт;      // СервисПодписок
Перем Поправки Экспорт;    // СервисПоправокПодписок
Перем Исключения Экспорт;  // СервисИсключенийПодписок
Перем Стенд Экспорт;       // СтендВитриныПодписок над этими службами
Перем Пулы Экспорт;        // ФейкСервисПулов
Перем Пакеты Экспорт;      // РазрезСервисПакетов
Перем Обвязка;             // ОбвязкаПодписок — админ хаба
Перем Хранилища;           // Массив — фейки хранилищ со счётчиком: вебхуки, поправки, исключения, теги
Перем Сдвиг;               // Структура — показания пулов и пакетов на момент Обнулить

// Админ хаба — зритель раздела.
//
// Возвращаемое значение:
//  Структура.
//
Функция Админ() Экспорт
	Возврат Обвязка.АдминХаба();
КонецФункции

// Объект подписок «пул».
//
// Параметры:
//  Ид - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОбъектПула(Знач Ид) Экспорт
	Возврат Сервис.ОбъектПула(Новый Структура("Идентификатор, Имя", Ид, "пул-" + Формат(Ид, "ЧГ=0")));
КонецФункции

// Объект подписок «пакет».
//
// Параметры:
//  Ид - Число - идентификатор пакета.
//  ПулИд - Число - идентификатор его пула.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОбъектПакета(Знач Ид, Знач ПулИд) Экспорт
	Возврат Сервис.ОбъектПакета(Новый Структура("Идентификатор, ПулИдентификатор, Имя", Ид, ПулИд,
		"пакет-" + Формат(Ид, "ЧГ=0")));
КонецФункции

// Подписка-вебхук от имени админа хаба: свой адрес, отбор по тегу «stable», сужать разрешено.
//
// Параметры:
//  Объект - Структура - объект подписок.
//
// Возвращаемое значение:
//  Вебхук.
//
Функция Подписка(Знач Объект) Экспорт
	Теги = Новый Массив();
	Теги.Добавить("stable");
	Возврат Сервис.СоздатьПодписку(Админ(), Объект, "вебхук",
		Новый Структура("URL, Секрет", "https://hook.example.com/" + Строка(Новый УникальныйИдентификатор()), ""),
		"версия.опубликована,версия.отозвана", Неопределено,
		Новый Структура("СужениеРазрешено, ОтборТегов", Истина, Теги));
КонецФункции

// Подписка-вебхук без отбора по тегам — у подписки хаба его не бывает.
//
// Параметры:
//  Объект - Структура - объект подписок.
//
// Возвращаемое значение:
//  Вебхук.
//
Функция ПодпискаБезОтбора(Знач Объект) Экспорт
	Возврат Сервис.СоздатьПодписку(Админ(), Объект, "вебхук",
		Новый Структура("URL, Секрет", "https://hook.example.com/" + Строка(Новый УникальныйИдентификатор()), ""),
		"версия.опубликована", Неопределено, Новый Структура("СужениеРазрешено", Истина));
КонецФункции

// Обнуляет счётчики хранилищ: дальше считается только экран.
//
Процедура Обнулить() Экспорт
	Для Каждого Хранилище Из Хранилища Цикл
		Хранилище.Счётчик().Обнулить();
	КонецЦикла;
	Сдвиг = Новый Структура("Пулы, Пакеты, СтрокПакетов", Пулы.Обращений(), Пакеты.Запросов(), Пакеты.Строк());
КонецПроцедуры

// Обращения к хранилищам и реестру с последнего Обнулить.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Всего = 0;
	Для Каждого Хранилище Из Хранилища Цикл
		Всего = Всего + Хранилище.Счётчик().Обращений();
	КонецЦикла;
	Возврат Всего + (Пулы.Обращений() - Сдвиг.Пулы) + (Пакеты.Запросов() - Сдвиг.Пакеты);
КонецФункции

// Строки, прочитанные из хранилищ с последнего Обнулить.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Всего = 0;
	Для Каждого Хранилище Из Хранилища Цикл
		Всего = Всего + Хранилище.Счётчик().Строк();
	КонецЦикла;
	Возврат Всего + (Пакеты.Строк() - Сдвиг.СтрокПакетов);
КонецФункции

Процедура ПриСозданииОбъекта(Знач ПоискКлассов, Знач КаталогМодулей, Знач UI)

	КаталогПодписок = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");
	КаталогАудита = ОбъединитьПути(КаталогМодулей, "аудит", "Классы");
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	Для Каждого Имя Из СтрРазделить("СервисПодписок,СервисПоправокПодписок,СервисИсключенийПодписок,"
		+ "ВеткиДереваПолучателей,ОтметкиПолучателей,ОтборПоТегам,ПараметрыПодписки,РеестрДействийПодписок,ЧислаДоставки,"
		+ "ВалидаторАдресаВебхука,АудитПробыПодписки,ОграничительПроб,ДоставкаВебхуком,ХранениеПодпискиВебхука,"
		+ "ШаблонУведомления,КаталогСобытий", ",") Цикл
		ПоискКлассов.Подключить(КаталогПодписок, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогПодписок, "обработчики", "вебхук"), "РендерНастроекВебхука");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ИменаОбъектовРеестра");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "данные", "Классы"), "СнятиеСтрок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	ПоискКлассов.Подключить(КаталогАудита, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогАудита, "СобытиеАудита");
	Для Каждого Имя Из СтрРазделить("РазборФормы,ИменаПолейПодписки,КаталогДействийПодписки,ПоляПодписки,"
		+ "РазборФормыПодписки,ПоляСобытийПодписки,ПоляСвойствПодписки,ПоправкиНижестоящих,СрезПодписок,"
		+ "ПолучателиЗаписи,ВитринаПодписок,ВитринаПодписокСверху,ПравилоДереваПолучателей,ОкноПолучателей,"
		+ "СчётСловами,ПроверкаПодпискиДоСохранения,ОкноРаздела,ОтметкаСохранения,ИменаПодписок,ЗаписьПодписки,"
		+ "ОкноПодписки,ОтборТеговПодписки", ",") Цикл
		ПоискКлассов.Подключить(КаталогWebUI, Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ОбвязкаПодписок,ФейкХранилищеВебхуков,ФейкВебхукЗапись,ФейкХранилищеПоправок,"
		+ "ФейкПоправкаЗапись,ФейкХранилищеИсключений,ФейкИсключениеЗапись,ФейкХранилищеИсключенийВПоправках,"
		+ "ФейкИсключениеВПоправкеЗапись,ФейкКаналыПакетов,ПраваПоОбъектам,ФейкТранспортHTTP,ФейкВалидаторВебхука,"
		+ "НастройкиЗаглушка,СервисПользователейЗаглушка,КаталогСобытийХаба,ФейкСервисПулов,РазрезСервисПакетов,"
		+ "ФейкКаталогСобытий,ФейкПредпросмотрУведомления,СтендВитриныПодписок", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	Обвязка = Новый ОбвязкаПодписок(ПоискКлассов);
	Издатель = Новый ИздательСобытий();
	Каталог = Новый КаталогСобытийХаба(ПоискКлассов, КаталогМодулей).Каталог(Издатель);
	Параметры = Новый ПараметрыПодписки(Каталог);
	Вебхуки = Новый ФейкХранилищеВебхуков();
	ХранилищеПоправок = Новый ФейкХранилищеПоправок();
	ХранилищеИсключений = Новый ФейкХранилищеИсключений();
	ХранилищеВключений = Новый ФейкХранилищеИсключений();
	Получатели = Новый ОтметкиПолучателей(ХранилищеИсключений, ХранилищеВключений);
	ИсключенияВПоправках = Новый ФейкХранилищеИсключенийВПоправках();
	Каналы = Новый ФейкКаналыПакетов();
	Каналы.ЗавестиТегПула(7, "stable");
	ОтборТегов = Новый ОтборПоТегам(Каналы, Каналы, Издатель);

	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Лог = Логирование.ПолучитьЛог("тест.oshub.цена-подписок");
	Валидатор = Новый ФейкВалидаторВебхука();
	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(Новый ФейкТранспортHTTP(), Валидатор, Новый ЧислаДоставки(Настройки),
		Каталог, Лог));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());
	Реестр = Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры);

	Пулы = Новый ФейкСервисПулов();
	Пулы.ДобавитьПул(7, "alpha");
	Пулы.ДобавитьПул(8, "beta");
	Пакеты = Новый РазрезСервисПакетов();
	Пакеты.ДобавитьПакет(42, 7, "web");
	Пакеты.ДобавитьПакет(43, 7, "jlib");

	Сервис = Новый СервисПодписок(Вебхуки, Новый ПраваПоОбъектам(), Реестр, Каталог, Параметры,
		Новый АудитПробыПодписки(Обвязка.ИменаЖурнала(), Новый СобытиеАудита(Обвязка.ИменаЖурнала(), Новый ТекстJSON())),
		Новый ОграничительПроб(Настройки), Обвязка.УчёткиСАдминами("100"),
		ХранилищеПоправок, ХранилищеИсключений, ХранилищеВключений, ИсключенияВПоправках, ОтборТегов);
	Ветки = Новый ВеткиДереваПолучателей(Пулы, Пакеты, Получатели);
	Поправки = Новый СервисПоправокПодписок(ХранилищеПоправок, Получатели, Сервис, Параметры, ОтборТегов,
		ИсключенияВПоправках, Ветки, Пакеты);
	Исключения = Новый СервисИсключенийПодписок(ХранилищеИсключений, ХранилищеВключений, Получатели, Сервис, Пулы,
		Пакеты, Ветки);
	Стенд = Новый СтендВитриныПодписок(UI, Сервис, Реестр, Поправки, Исключения, Каналы, Пулы, Пакеты);

	Хранилища = Новый Массив();
	Хранилища.Добавить(Вебхуки);
	Хранилища.Добавить(ХранилищеПоправок);
	Хранилища.Добавить(ХранилищеИсключений);
	Хранилища.Добавить(ХранилищеВключений);
	Хранилища.Добавить(ИсключенияВПоправках);
	Хранилища.Добавить(Каналы);
	Сдвиг = Новый Структура("Пулы, Пакеты, СтрокПакетов", 0, 0, 0);

КонецПроцедуры
