// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:InvalidCharacterInFile-off
// BSLLS:YoLetterUsage-off
// ХранилищеОтметокВыпуска в памяти, считающее чтения: экран новой версии хаба читает отметку
// последней проверки, и сторож цены видит, сколько раз.

Перем Отметка_;  // Структура — Последняя, Проверено, Ошибка, Объявлена
Перем Счетчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз отметку прочли с момента создания.
//
// Возвращаемое значение:
//  Число
//
Функция Обращений() Экспорт
	Возврат Счетчик.Обращений();
КонецФункции

// Отметка хаба; считает обращение.
//
// Возвращаемое значение:
//  Структура - Последняя, Проверено, Ошибка, Объявлена.
//
Функция Прочитать() Экспорт
	Счетчик.Отметить();
	Возврат Новый Структура("Последняя, Проверено, Ошибка, Объявлена", Отметка_.Последняя, Отметка_.Проверено,
		Отметка_.Ошибка, Отметка_.Объявлена);
КонецФункции

// Записывает отметку целиком (за обращение не считается: экран не пишет).
//
// Параметры:
//  Отметка - Структура - поля как у Прочитать.
//
Процедура Записать(Знач Отметка) Экспорт
	Отметка_ = Отметка;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счетчик = Новый СчётчикОбращений();
	Отметка_ = Новый Структура("Последняя, Проверено, Ошибка, Объявлена", "", Неопределено, "", "");
КонецПроцедуры
