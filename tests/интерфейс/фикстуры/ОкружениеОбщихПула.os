// Окружение раздела «Общие» дома пула в памяти: занятое место и квота пула, учётки по номеру,
// число нескрытых пакетов, администратор хаба и адрес инсталляции — по одному ответу на вопрос.

Перем Занято_;      // Число — занято пулом, байт
Перем Квота_;       // Число — действующая квота, байт; 0 — без ограничения
Перем Учётки_;      // Соответствие — номер учётки -> Структура (Логин)
Перем Пакетов_;     // Число — нескрытых пакетов в пуле

// Контракт СервисПулов: сколько занято пулом.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Число - байт.
//
Функция ЗанятоБайт(Знач Пул) Экспорт
	Возврат Занято_;
КонецФункции

// Контракт СервисПулов: действующая квота пула.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Число - байт; 0 — без ограничения.
//
Функция ЭффективнаяКвотаБайт(Знач Пул) Экспорт
	Возврат Квота_;
КонецФункции

// Контракт СервисПользователей: учётка по номеру.
//
// Параметры:
//  Идентификатор - Число - номер учётки.
//
// Возвращаемое значение:
//  Структура, Неопределено.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Учётки_.Получить(Идентификатор);
КонецФункции

// Контракт СервисПакетов: нескрытые пакеты по пулам.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - пулы.
//
// Возвращаемое значение:
//  Соответствие - пул -> число; пула без пакетов в нём нет.
//
Функция КоличествоВидимыхПакетовПоПулам(Знач ПулИдентификаторы) Экспорт
	Результат = Новый Соответствие();
	Если Пакетов_ > 0 Тогда
		Для Каждого Идентификатор Из ПулИдентификаторы Цикл
			Результат.Вставить(Цел(Идентификатор), Пакетов_);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Контракт СервисПрав: администратор ли хаба.
//
// Параметры:
//  Пользователь - Структура, Неопределено - смотрящий (Админ).
//
// Возвращаемое значение:
//  Булево.
//
Функция ПользовательАдмин(Знач Пользователь) Экспорт
	Возврат Пользователь <> Неопределено И Пользователь.Админ = Истина;
КонецФункции

// Контракт АдресИнстанса: адрес инсталляции не задан — узел берётся из заголовка Host.
//
// Возвращаемое значение:
//  Строка.
//
Функция Базовый() Экспорт
	Возврат "";
КонецФункции

// Задаёт место пула.
//
// Параметры:
//  Занято - Число - байт.
//  Квота - Число - байт; 0 — без ограничения.
//
Процедура ЗадатьМесто(Знач Занято, Знач Квота) Экспорт
	Занято_ = Занято;
	Квота_ = Квота;
КонецПроцедуры

// Заводит учётку.
//
// Параметры:
//  Идентификатор - Число - номер.
//  Логин - Строка - логин.
//
Процедура ДобавитьУчётку(Знач Идентификатор, Знач Логин) Экспорт
	Учётки_.Вставить(Идентификатор, Новый Структура("Идентификатор, Логин", Идентификатор, Логин));
КонецПроцедуры

// Задаёт число нескрытых пакетов пула.
//
// Параметры:
//  Количество - Число.
//
Процедура ЗадатьПакеты(Знач Количество) Экспорт
	Пакетов_ = Количество;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Занято_ = 0;
	Квота_ = 0;
	Учётки_ = Новый Соответствие();
	Пакетов_ = 0;
КонецПроцедуры
