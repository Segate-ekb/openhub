// Окружение страниц-ворот без базы: оно одно стоит на месте конфигурации провайдеров, гейта
// страны, политики пароля, геоправила и определителя страны, служб входа (паролем, через
// провайдера и CLI), восстановления, приглашений, подтверждения адреса и мастера первого запуска.
// По умолчанию провайдеров нет, вход паролем, регистрация и восстановление открыты, правил по
// стране нет, посетитель — гость, мастер закрыт — страница строится настоящим каркасом.

Перем Кит;            // Кит (кит) — пустые узлы на месте атрибуции и подсказки
Перем Провайдеры_;    // Массив из Структура — провайдеры хаба, все открыты посетителю
Перем ПарольВыключен; // Булево
Перем БазаСтран;      // Булево — есть правило по стране и индекс по базе
Перем Вошедший_;      // Структура, Неопределено — пользователь принципала; Неопределено — гость
Перем МастерОткрыт;   // Булево — первый запуск не пройден
Перем ПопыткиЗаперты; // Булево — ограничитель попыток не пускает

#Область Настройка

// Провайдеры хаба: все открыты посетителю.
//
// Параметры:
//  Провайдеры - Массив из Структура - описания провайдеров (Имя, Метка, Значок, Издатель…).
//
Процедура ЗадатьПровайдеров(Знач Провайдеры) Экспорт
	Провайдеры_ = Провайдеры;
КонецПроцедуры

// Вход по паролю выключен.
Процедура ВыключитьПароль() Экспорт
	ПарольВыключен = Истина;
КонецПроцедуры

// На хабе есть правило по стране, и индекс по встроенной базе построен.
Процедура ПоставитьПравилоПоСтране() Экспорт
	БазаСтран = Истина;
КонецПроцедуры

// Посетитель вошёл: bob с неподтверждённым адресом.
Процедура Войти() Экспорт
	Вошедший_ = Новый Структура("Идентификатор, Логин, Email, EmailПодтверждён",
		7, "bob", "bob@example.org", Ложь);
КонецПроцедуры

// Первый запуск не пройден: мастер открыт.
Процедура ОткрытьМастер() Экспорт
	МастерОткрыт = Истина;
КонецПроцедуры

// Ограничитель попыток больше не пускает.
Процедура ЗаперетьПопытки() Экспорт
	ПопыткиЗаперты = Истина;
КонецПроцедуры

#КонецОбласти

#Область КонфигурацияOIDC

// Провайдеры входа хаба.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция Провайдеры() Экспорт
	Возврат Провайдеры_;
КонецФункции

// Провайдер по имени: любой из заданных.
//
// Параметры:
//  Имя - Строка - имя провайдера.
//
// Возвращаемое значение:
//  Структура, Неопределено
//
Функция Провайдер(Знач Имя) Экспорт
	Для Каждого Описание Из Провайдеры_ Цикл
		Если Описание.Имя = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Старт входа через провайдера: правило по стране отбивает всех.
//
// Параметры:
//  Имя - Строка - не различается.
//  Посетитель - Произвольный - не различается.
//
// Возвращаемое значение:
//  Структура - Успех (Ложь).
//
Функция Начать(Знач Имя, Знач Посетитель) Экспорт
	Имя = Имя;
	Посетитель = Посетитель;
	Возврат Новый Структура("Успех", Ложь);
КонецФункции

// Есть ли у хаба провайдеры входа.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПровайдеры() Экспорт
	Возврат Провайдеры_.Количество() > 0;
КонецФункции

#КонецОбласти

#Область ГейтВходаПоСтране

// Провайдеры, открытые посетителю: все.
//
// Параметры:
//  Провайдеры - Массив - провайдеры хаба.
//  Посетитель - Произвольный - не различается.
//
// Возвращаемое значение:
//  Массив - те же провайдеры.
//
Функция ПровайдерыДляПосетителя(Знач Провайдеры, Знач Посетитель) Экспорт
	Посетитель = Посетитель;
	Возврат Провайдеры;
КонецФункции

#КонецОбласти

#Область ПолитикаПарольногоВхода

// Выключен ли вход паролем.
//
// Возвращаемое значение:
//  Булево
//
Функция Выключен() Экспорт
	Возврат ПарольВыключен;
КонецФункции

#КонецОбласти

#Область ГеоправилоИОпределитель

// Есть ли на хабе правило по стране.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПравила() Экспорт
	Возврат БазаСтран;
КонецФункции

// Страну посетителя назвала встроенная база.
//
// Параметры:
//  Адрес - Строка - не различается.
//  Заголовки - Соответствие - не различаются.
//
// Возвращаемое значение:
//  Структура - Исход, Страна, Источник, Причина.
//
Функция ОпределитьПоЗапросу(Знач Адрес, Знач Заголовки) Экспорт
	Адрес = Адрес;
	Заголовки = Заголовки;
	Возврат Новый Структура("Исход, Страна, Источник, Причина", Исходы().Известна, "RU",
		ИсточникБазы(), "");
КонецФункции

// Исходы определителя.
//
// Возвращаемое значение:
//  Структура - Известна, НеНаблюдаемая, Неизвестна.
//
Функция Исходы() Экспорт
	Возврат Новый Структура("Известна, НеНаблюдаемая, Неизвестна",
		"известна", "не-наблюдаемая", "неизвестна");
КонецФункции

// Источник «встроенная база».
//
// Возвращаемое значение:
//  Строка
//
Функция ИсточникБазы() Экспорт
	Возврат "база";
КонецФункции

// Страны, под которые построен индекс базы.
//
// Возвращаемое значение:
//  Массив из Строка - одна страна при правиле, иначе пусто.
//
Функция НаблюдаемыеСтраны() Экспорт
	Результат = Новый Массив();
	Если БазаСтран Тогда
		Результат.Добавить("RU");
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область АтрибуцияИПодсказка

// Атрибуция базы стран: её нет.
//
// Возвращаемое значение:
//  ЭлементЭкрана - пустой узел.
//
Функция Сноска() Экспорт
	Возврат Кит.Ничего();
КонецФункции

// Требования к паролю под полем: их нет.
//
// Параметры:
//  ИмяПоля - Строка - не различается.
//
// Возвращаемое значение:
//  ЭлементЭкрана - пустой узел.
//
Функция Требования(Знач ИмяПоля) Экспорт
	ИмяПоля = ИмяПоля;
	Возврат Кит.Ничего();
КонецФункции

#КонецОбласти

#Область ВходПаролем

// Вход по паролю не удаётся никому.
//
// Параметры:
//  Логин - Строка - не различается.
//  Пароль - Строка - не различается.
//  Адрес - Строка - не различается.
//
// Возвращаемое значение:
//  Структура - Успех (Ложь), Причина.
//
Функция ВойтиПоПаролю(Знач Логин, Знач Пароль, Знач Адрес) Экспорт
	Логин = Логин;
	Пароль = Пароль;
	Адрес = Адрес;
	Возврат Новый Структура("Успех, Причина", Ложь, "invalid_credentials");
КонецФункции

// Объяснение отказа входа.
//
// Параметры:
//  Причина - Строка - не различается.
//  Письмо - Произвольный - не различается.
//
// Возвращаемое значение:
//  Строка
//
Функция ОтказПароля(Знач Причина, Знач Письмо) Экспорт
	Причина = Причина;
	Письмо = Письмо;
	Возврат "Неверный логин или пароль";
КонецФункции

// Код ответа отказа входа.
//
// Параметры:
//  Причина - Строка - не различается.
//
// Возвращаемое значение:
//  Число - 401.
//
Функция КодОтказаПароля(Знач Причина) Экспорт
	Причина = Причина;
	Возврат 401;
КонецФункции

#КонецОбласти

#Область Регистрация

// Первый запуск пройден.
//
// Возвращаемое значение:
//  Булево - Ложь.
//
Функция ЗаблокированаОнбордингом() Экспорт
	Возврат Ложь;
КонецФункции

// Регистрация открыта.
//
// Возвращаемое значение:
//  Строка - пустая: причины закрытия нет.
//
Функция ПричинаОтказа() Экспорт
	Возврат "";
КонецФункции

// Код причины «первый запуск не пройден».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОнбордингНеЗавершён() Экспорт
	Возврат "onboarding_required";
КонецФункции

#КонецОбласти

#Область ВосстановлениеИОграничитель

// Восстановление пароля доступно: хабу есть чем слать письмо.
//
// Возвращаемое значение:
//  Булево - Истина.
//
Функция Доступно() Экспорт
	Возврат Истина;
КонецФункции

// Ключ ведра ограничителя: адрес не различается.
//
// Параметры:
//  Назначение - Строка - не различается.
//  Источник - Строка - не различается.
//
// Возвращаемое значение:
//  Строка - пустая.
//
Функция Ключ(Знач Назначение, Знач Источник) Экспорт
	Назначение = Назначение;
	Источник = Источник;
	Возврат "";
КонецФункции

// Ограничитель пускает всех.
//
// Параметры:
//  Ключ - Строка - не различается.
//
// Возвращаемое значение:
//  Булево - Истина.
//
Функция РазрешёнЛи(Знач Ключ) Экспорт
	Ключ = Ключ;
	Возврат НЕ ПопыткиЗаперты;
КонецФункции

// Ведро ограничителя по адресу: адрес как есть.
//
// Параметры:
//  Адрес - Строка - адрес клиента.
//
// Возвращаемое значение:
//  Строка
//
Функция Ведро(Знач Адрес) Экспорт
	Возврат Строка(Адрес);
КонецФункции

#КонецОбласти

#Область Приглашения

// Ссылки-приглашения нет никакой.
//
// Параметры:
//  Значение - Строка - не различается.
//
// Возвращаемое значение:
//  Структура - Успех (Ложь), Причина.
//
Функция Проверить(Знач Значение) Экспорт
	Значение = Значение;
	Возврат Новый Структура("Успех, Причина", Ложь, ПричинаНетСсылки());
КонецФункции

// Причина «ссылки нет».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаНетСсылки() Экспорт
	Возврат "not_found";
КонецФункции

// Причина «срок вышел».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаПросрочена() Экспорт
	Возврат "expired";
КонецФункции

// Причина «ссылкой воспользовались».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаПогашена() Экспорт
	Возврат "used";
КонецФункции

// Причина «учётки нет».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаНетУчётки() Экспорт
	Возврат "no_user";
КонецФункции

// Причина «пароль не подходит».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаПароль() Экспорт
	Возврат "password";
КонецФункции

// Причина «вход паролем выключен».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаПарольныйВходВыключен() Экспорт
	Возврат "password_login_off";
КонецФункции

#КонецОбласти

#Область ПервыйЗапускИОтветы

// Первый запуск уже пройден.
//
// Возвращаемое значение:
//  Булево - Ложь.
//
Функция НуженОнбординг() Экспорт
	Возврат МастерОткрыт;
КонецФункции

// Сессионную куку мастер не трогает: ответ без неё.
//
// Параметры:
//  Ответ - Произвольный - не различается.
//  Куки - Произвольный - не различается.
//
Процедура БезСессионнойКуки(Ответ, Знач Куки) Экспорт
	Куки = Куки;
КонецПроцедуры

// Страница не кэшируется: в заглушке нечего закрывать.
//
// Параметры:
//  Ответ - Произвольный - не различается.
//
Процедура ЗакрытьСтраницу(Ответ) Экспорт
	Ответ = Ответ;
КонецПроцедуры

#КонецОбласти

#Область ПринципалИCLI

// Принципал запроса: вошедший с сессией либо гость.
//
// Параметры:
//  Заголовки - Соответствие - не различаются.
//  Куки - Произвольный - не различаются.
//
// Возвращаемое значение:
//  Структура - Пользователь, Сессия.
//
Функция ОпределитьПринципала(Знач Заголовки, Знач Куки) Экспорт
	Заголовки = Заголовки;
	Куки = Куки;
	Возврат Новый Структура("Пользователь, Сессия", Вошедший_, "сессия-теста");
КонецФункции

// Пользователь принципала.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//
// Возвращаемое значение:
//  Структура, Неопределено
//
Функция Пользователь(Знач Принципал) Экспорт
	Возврат Принципал.Пользователь;
КонецФункции

// Ключи выпускать можно: принципал пришёл сессией браузера.
//
// Параметры:
//  Принципал - Структура - не различается.
//
// Возвращаемое значение:
//  Булево - Истина.
//
Функция УправлениеКлючамиРазрешено(Знач Принципал) Экспорт
	Принципал = Принципал;
	Возврат Истина;
КонецФункции

// Токен формы сессии.
//
// Параметры:
//  Сессия - Строка - не различается.
//
// Возвращаемое значение:
//  Строка
//
Функция ТокенСессии(Знач Сессия) Экспорт
	Сессия = Сессия;
	Возврат "т0кен-теста";
КонецФункции

// Живая заявка CLI по коду: одна, ждёт решения.
//
// Параметры:
//  Код - Строка - код из терминала.
//
// Возвращаемое значение:
//  Структура - Статус, КодПользователя, ИмяКлиента, Права, Истекает.
//
Функция ЖиваяЗаявкаПоКоду(Знач Код) Экспорт
	Возврат Новый Структура("Статус, КодПользователя, ИмяКлиента, Права, Истекает",
		СтатусОжидание(), Код, "opm на ноутбуке", "packages:write", Дата(2026, 10, 13, 12, 0, 0));
КонецФункции

// Статус «ждёт решения».
//
// Возвращаемое значение:
//  Строка
//
Функция СтатусОжидание() Экспорт
	Возврат "ожидание";
КонецФункции

// Путь страницы подтверждения адреса.
//
// Возвращаемое значение:
//  Строка
//
Функция Путь() Экспорт
	Возврат "/confirm-email";
КонецФункции

// Имя параметра ссылки подтверждения.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПараметра() Экспорт
	Возврат "token";
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Кит)
	Кит = _Кит;
	Провайдеры_ = Новый Массив();
	ПарольВыключен = Ложь;
	БазаСтран = Ложь;
	Вошедший_ = Неопределено;
	МастерОткрыт = Ложь;
	ПопыткиЗаперты = Ложь;
КонецПроцедуры
