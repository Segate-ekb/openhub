// ХранилищеМетокТегов в памяти, считающее ОБРАЩЕНИЯ и ПРОЧИТАННЫЕ СТРОКИ: строки отдаёт замер,
// а состав и раскладку по тегам — настоящее хранилище, которому замер подложен табакеркой «Сам».

Перем Записи;      // Массив из Структура — метки тегов
Перем Счётчик;     // СчётчикОбращений — счёт запросов и прочитанных строк
Перем Настоящее;   // ХранилищеМетокТегов, читающее строки из этого замера

#Область Счётчики

// Сколько строк меток хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат Счётчик.Строк();
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Обнуляет счётчики, оставляя фактуру.
Процедура Обнулить() Экспорт
	Счётчик.Обнулить();
КонецПроцедуры

#КонецОбласти

#Область НаполнениеФикстуры

// Помечает версию тегом (за обращение не считается).
//
// Параметры:
//  ТегИдентификатор - Число - идентификатор тега.
//  ВерсияИдентификатор - Число - идентификатор версии.
//
Процедура Пометить(Знач ТегИдентификатор, Знач ВерсияИдентификатор) Экспорт

	Записи.Добавить(Новый Структура("Идентификатор, ТегИдентификатор, ВерсияИдентификатор",
		Записи.Количество() + 1, Цел(ТегИдентификатор), Цел(ВерсияИдентификатор)));

КонецПроцедуры

#КонецОбласти

#Область СтрокиТаблицы

// Состав одного тега: строки таблицы меток.
//
// Параметры:
//  ТегИдентификатор - Число - идентификатор тега.
//
// Возвращаемое значение:
//  Массив - метки тега.
//
Функция ПолучитьПоТегИдентификаторРавно(Знач ТегИдентификатор) Экспорт

	Список = Новый Массив();
	Список.Добавить(Цел(ТегИдентификатор));
	Возврат ПолучитьПоТегИдентификаторВ(Список);

КонецФункции

// Состав перечисленных тегов одним отбором: строки таблицы меток.
//
// Параметры:
//  ТегИдентификаторы - Массив из Число - идентификаторы тегов.
//
// Возвращаемое значение:
//  Массив - метки всех перечисленных тегов.
//
Функция ПолучитьПоТегИдентификаторВ(Знач ТегИдентификаторы) Экспорт

	Нужные = Новый Соответствие();
	Для Каждого Номер Из ТегИдентификаторы Цикл
		Нужные.Вставить(Цел(Номер), Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Метка Из Записи Цикл
		Если Нужные.Получить(Метка.ТегИдентификатор) = Истина Тогда
			Отобранные.Добавить(Метка);
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик.Отдать(Отобранные);

КонецФункции

#КонецОбласти

#Область ДоменныеМетоды

// Состав перечисленных тегов — как у настоящего хранилища.
//
// Параметры:
//  ТегИдентификаторы - Массив из Число - идентификаторы тегов.
//
// Возвращаемое значение:
//  Массив - метки всех перечисленных тегов.
//
Функция СоставТегов(Знач ТегИдентификаторы) Экспорт
	Возврат Настоящее.СоставТегов(ТегИдентификаторы);
КонецФункции

// Помеченные версии перечисленных тегов, разложенные по тегам, — как у настоящего хранилища.
//
// Параметры:
//  ТегИдентификаторы - Массив из Число - идентификаторы тегов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор тега → Соответствие: идентификатор версии → Истина.
//
Функция ПомеченныеПоТегам(Знач ТегИдентификаторы) Экспорт
	Возврат Настоящее.ПомеченныеПоТегам(ТегИдентификаторы);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()

	Записи = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ТабакеркаНаблюдаемая");
	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "реестр", "Классы"), "ХранилищеМетокТегов");
	Настоящее = Новый ХранилищеМетокТегов(Новый ТабакеркаНаблюдаемая(ЭтотОбъект));

КонецПроцедуры
