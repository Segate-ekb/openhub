// Заглушка пульта настройки с последствиями: ничего не перехватывает, но считает, сколько раз
// его спросили — так тест видит, что до пульта запрос не дошёл.

Перем Вызовов_;

// Применяет переход настройки.
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//  Форма - Соответствие - разобранная форма.
//  Кто - Строка - принципал сессии.
//  Ещё1 - Произвольный - хвост сигнатуры пультов, которым нужно больше контекста
//         (необязательный, по умолчанию Неопределено).
//  Ещё2 - Произвольный - там же (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Перехвачено (всегда Ложь).
//
Функция Применить(Знач Раздел, Знач Форма, Знач Кто, Знач Ещё1 = Неопределено,
	Знач Ещё2 = Неопределено) Экспорт
	Раздел = Раздел;
	Форма = Форма;
	Кто = Кто;
	Ещё1 = Ещё1;
	Ещё2 = Ещё2;
	Вызовов_ = ?(Вызовов_ = Неопределено, 0, Вызовов_) + 1;
	Возврат Новый Структура("Перехвачено", Ложь);
КонецФункции

// Сколько раз пульт спросили.
//
// Возвращаемое значение:
//  Число.
//
Функция Вызовов() Экспорт
	Возврат ?(Вызовов_ = Неопределено, 0, Вызовов_);
КонецФункции
