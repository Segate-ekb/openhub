// Окружение списка пулов в памяти: какие пулы видит запрос (гвард чтения), сколько в них
// пакетов, есть ли апстримы и включённое зеркало, кто какой пул вправе настраивать. Помнит,
// о каких пулах спрашивали число пакетов, считает обращения к каждой двери и снимки прав.

Перем Пулы;        // Массив из Структура — Пул, Видим, Пакетов, Апстримов, Зеркало
Перем Спрошенные;  // Массив из Число — идентификаторы пулов, о чьих пакетах спросили
Перем Обращения;   // Число — сколько раз спросили пакеты, апстримы и зеркала
Перем Настройщики; // Соответствие — "логин|пул" -> Истина: кто вправе настраивать пул
Перем Снимков;     // Число — сколько раз сняли снимок прав

#Область Наполнение

// Заводит пул окружения.
//
// Параметры:
//  Пул - ПулСписка - пул.
//  Видим - Булево - видит ли его запрос.
//  Пакетов - Число - сколько в нём нескрытых пакетов (необязательный, по умолчанию 0).
//  Апстримов - Число - сколько у него апстримов (необязательный, по умолчанию 0).
//  Зеркало - Булево - наполняет ли его включённое зеркало (необязательный, по умолчанию Ложь).
//
Процедура Завести(Знач Пул, Знач Видим, Знач Пакетов = 0, Знач Апстримов = 0, Знач Зеркало = Ложь) Экспорт
	Пулы.Добавить(Новый Структура("Пул, Видим, Пакетов, Апстримов, Зеркало",
		Пул, Видим, Пакетов, Апстримов, Зеркало));
КонецПроцедуры

// Даёт учётке право настраивать пул — роль мейнтейнера и выше.
//
// Параметры:
//  Логин - Строка - логин учётки.
//  ИмяПула - Строка - имя пула.
//
Процедура ДатьНастройку(Знач Логин, Знач ИмяПула) Экспорт
	Настройщики.Вставить(Логин + "|" + ИмяПула, Истина);
КонецПроцедуры

// Сколько раз сняли снимок прав.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоСнимков() Экспорт
	Возврат Снимков;
КонецФункции

// Сколько раз окружение спросили о пакетах, апстримах и зеркалах.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоОбращений() Экспорт
	Возврат Обращения;
КонецФункции

// Идентификаторы пулов, о чьих пакетах спросили, в порядке вопросов.
//
// Возвращаемое значение:
//  Массив из Число.
//
Функция СпрошенныеПулы() Экспорт
	Возврат Спрошенные;
КонецФункции

#КонецОбласти

#Область ГвардЧтенияПулов

// Пулы, которые видит запрос, — в порядке заведения.
//
// Параметры:
//  Принципал - Произвольный - не различается.
//
// Возвращаемое значение:
//  Массив из ПулСписка.
//
Функция ЧитаемыеПулы(Знач Принципал) Экспорт
	Принципал = Принципал;
	Результат = Новый Массив();
	Для Каждого Запись Из Пулы Цикл
		Если Запись.Видим Тогда
			Результат.Добавить(Запись.Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СервисПрав

// Снимок прав учётки: одна выборка на страницу.
//
// Параметры:
//  Пользователь - Структура, Неопределено - Логин, Админ (необязательное поле).
//
// Возвращаемое значение:
//  Структура, Неопределено - Логин; Неопределено для анонима.
//
Функция СнимокПрав(Знач Пользователь) Экспорт
	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Снимков = Снимков + 1;
	Возврат Новый Структура("Логин", Пользователь.Логин);
КонецФункции

// Вправе ли учётка настраивать пул: администратор хаба — любой, остальные — выданные.
// Вопрос без снимка — дорогой путь, его окружение не прощает.
//
// Параметры:
//  Пользователь - Структура, Неопределено - Логин, Админ (необязательное поле).
//  Пул - ПулСписка - пул.
//  Снимок - Структура, Неопределено - снимок прав из СнимокПрав.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетАдминистрировать(Знач Пользователь, Знач Пул, Знач Снимок = Неопределено) Экспорт
	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Снимок = Неопределено Тогда
		ВызватьИсключение "Окружение списка пулов: права спросили без снимка — по запросу на строку";
	КонецЕсли;
	Админ = Ложь;
	Пользователь.Свойство("Админ", Админ);
	Возврат Админ = Истина ИЛИ Настройщики.Получить(Пользователь.Логин + "|" + Пул.Имя) = Истина;
КонецФункции

#КонецОбласти

#Область СервисПакетов

// Число нескрытых пакетов по названным пулам.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пула в число пакетов; пулов без пакетов нет.
//
Функция КоличествоВидимыхПакетовПоПулам(Знач ПулИдентификаторы) Экспорт
	Обращения = Обращения + 1;
	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из ПулИдентификаторы Цикл
		Спрошенные.Добавить(Идентификатор);
		Если Запись(Идентификатор).Пакетов > 0 Тогда
			Результат.Вставить(Цел(Идентификатор), Запись(Идентификатор).Пакетов);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ИсточникиПула

// Источники пула в порядке обхода: по строке на заведённый апстрим.
//
// Параметры:
//  ПулИдентификатор - Число - пул.
//
// Возвращаемое значение:
//  Массив из Строка - адреса апстримов.
//
Функция Все(Знач ПулИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Пулы Цикл
		Если Запись.Пул.Идентификатор = ПулИдентификатор Тогда
			Для Номер = 1 По Запись.Апстримов Цикл
				Результат.Добавить("https://upstream" + Номер + ".example/");
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пулы, у которых есть апстримы.
//
// Возвращаемое значение:
//  Массив из Число.
//
Функция ПулыСИсточниками() Экспорт
	Обращения = Обращения + 1;
	Результат = Новый Массив();
	Для Каждого Запись Из Пулы Цикл
		Если Запись.Апстримов > 0 Тогда
			Результат.Добавить(Запись.Пул.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Включённые зеркала хаба.
//
// Возвращаемое значение:
//  Массив из Структура - ПулНазначенияИдентификатор, Включено.
//
Функция ВключённыеЗеркала() Экспорт
	Обращения = Обращения + 1;
	Результат = Новый Массив();
	Для Каждого Запись Из Пулы Цикл
		Если Запись.Зеркало Тогда
			Результат.Добавить(Новый Структура("ПулНазначенияИдентификатор, Включено",
				Запись.Пул.Идентификатор, Истина));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

Функция Запись(Знач Идентификатор)
	Для Каждого Запись Из Пулы Цикл
		Если Запись.Пул.Идентификатор = Цел(Идентификатор) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Окружение списка пулов: пула " + Идентификатор + " нет";
КонецФункции

Процедура ПриСозданииОбъекта()
	Пулы = Новый Массив();
	Спрошенные = Новый Массив();
	Обращения = 0;
	Настройщики = Новый Соответствие();
	Снимков = 0;
КонецПроцедуры
