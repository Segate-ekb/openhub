// Заглушка гварда дома «Хаб»: впускает с принципалом, которого задал тест, — так мутации
// раздела доходят до настоящей службы домена.

Перем Пользователь_;
Перем Принципал_;
Перем Отказать_;   // Булево — гвард не впускает: настоящий отвечает 403 сам и дальше не пускает

// Вердикт допуска.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
// Возвращаемое значение:
//  Структура - Разрешено, Пользователь, Сессия, Принципал.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт

	Ответ = Ответ;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	Возврат Новый Структура("Разрешено, Пользователь, Сессия, Принципал",
		Отказать_ <> Истина, Пользователь_, "сессия", Принципал_);

КонецФункции

// Впускает учётку с её принципалом.
//
// Параметры:
//  Пользователь - Произвольный - учётка запроса.
//  Принципал - Структура - принципал запроса.
//
Процедура Впустить(Знач Пользователь, Знач Принципал) Экспорт
	Пользователь_ = Пользователь;
	Принципал_ = Принципал;
	Отказать_ = Ложь;
КонецПроцедуры

// Больше не впускает никого: так тест видит, что дверь стережёт гвард, а не домен.
//
// Параметры:
//  Отказать - Булево - Истина — не впускать, Ложь — снова впускать заданного (необязательный,
//             по умолчанию Истина).
//
Процедура НеВпускать(Знач Отказать = Истина) Экспорт
	Отказать_ = Отказать;
КонецПроцедуры
