// Заглушка ГвардаДоступаКПулу для экранов кабинета: какие пулы смотрящему видны,
// задаёт тест.

Перем Видимые;

// Пулы, доступные смотрящему на чтение.
//
// Параметры:
//  Принципал - Произвольный - субъект запроса, заглушкой не различается.
//
// Возвращаемое значение:
//  Массив - заданные тестом пулы.
//
Функция ЧитаемыеПулы(Знач Принципал) Экспорт
	Принципал = Принципал;
	Возврат Видимые;
КонецФункции

// Добавляет пул в выдачу.
//
// Параметры:
//  Пул - Произвольный - пул с полями Идентификатор и Имя.
//
Процедура Добавить(Знач Пул) Экспорт
	Видимые.Добавить(Пул);
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Видимые = Новый Массив();
КонецПроцедуры
