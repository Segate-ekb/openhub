// Права и дом пула для витрины пустого пула: распоряжается ли смотрящий пулом и адрес раздела дома.

Перем Распоряжается; // Булево — смотрящий администрирует пул

// Смотрящий распоряжается пулом.
//
// Параметры:
//  Значение - Булево - распоряжается ли.
//
Процедура Распоряжаться(Знач Значение) Экспорт
	Распоряжается = Значение;
КонецПроцедуры

// Порог «администратор пула».
//
// Параметры:
//  Пользователь - Произвольный - смотрящий.
//  Пул - Произвольный - пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетАдминистрировать(Знач Пользователь, Знач Пул) Экспорт
	Пользователь = Пользователь;
	Пул = Пул;
	Возврат Распоряжается;
КонецФункции

// Адрес раздела дома пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресРаздела(Знач ИмяПула, Знач Ключ) Экспорт
	Возврат "/pools/" + ИмяПула + "/settings/" + Ключ;
КонецФункции

Процедура ПриСозданииОбъекта()
	Распоряжается = Ложь;
КонецПроцедуры
