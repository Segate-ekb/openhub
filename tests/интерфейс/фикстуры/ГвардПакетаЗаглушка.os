// Заглушка гварда дома «Пакет»: допуск, пул и пакет раздела задаются тестом; учётка — администратор
// (меню каркаса). Отказ — гвард ответил 403 сам, без тела (страницу отказа печатает настоящий гвард).

Перем Разрешено_;
Перем Логин_;
Перем Пул_;
Перем Пакет_;

// Вердикт допуска к разделу дома «Пакет».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  ИмяПула - Строка - имя пула из адреса.
//  ИмяПакета - Строка - имя пакета из адреса.
//
// Возвращаемое значение:
//  Структура - Разрешено, Принципал, Пользователь, Сессия, Пул, Пакет.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула, Знач ИмяПакета) Экспорт

	Если НЕ Разрешено_ Тогда
		Ответ.Код = 403;
	КонецЕсли;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	ИмяПула = ИмяПула;
	ИмяПакета = ИмяПакета;

	Пользователь = ?(ЗначениеЗаполнено(Логин_), Новый Структура("Логин, Админ", Логин_, Истина),
		Неопределено);

	Возврат Новый Структура("Разрешено, Принципал, Пользователь, Сессия, Пул, Пакет",
		Разрешено_, Пользователь, Пользователь, "сессия", Пул_, Пакет_);

КонецФункции

// Впускает пользователя в раздел пакета.
//
// Параметры:
//  Логин - Строка - логин пользователя сессии.
//  Пул - Произвольный - пул пакета (Имя, Идентификатор).
//  Пакет - Произвольный - пакет раздела (Имя, Идентификатор).
//
Процедура Впустить(Знач Логин, Знач Пул, Знач Пакет) Экспорт
	Разрешено_ = Истина;
	Логин_ = Логин;
	Пул_ = Пул;
	Пакет_ = Пакет;
КонецПроцедуры

// Отказывает в допуске: гвард не впустил смотрящего к пакету.
//
Процедура Отказать() Экспорт
	Разрешено_ = Ложь;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Разрешено_ = Ложь;
	Логин_ = "";
	Пул_ = Неопределено;
	Пакет_ = Неопределено;
КонецПроцедуры
