// Фейк двери СервисаПакетов, которой витрина называет пакет поправки: пакет по идентификатору.

Перем Пакеты;  // Соответствие: идентификатор -> Структура (Идентификатор, Имя)

// Добавляет пакет.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя пакета.
//
Процедура ДобавитьПакет(Знач Идентификатор, Знач Имя) Экспорт
	Пакеты.Вставить(Идентификатор, Новый Структура("Идентификатор, Имя", Идентификатор, Имя));
КонецПроцедуры

// Контракт СервисаПакетов: пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено.
//
Функция ПакетПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Пакеты.Получить(Идентификатор);
КонецФункции

Процедура ПриСозданииОбъекта()
	Пакеты = Новый Соответствие();
КонецПроцедуры
