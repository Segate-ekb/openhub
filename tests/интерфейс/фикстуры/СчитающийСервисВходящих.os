// СервисВходящих в памяти, считающий обращения: очередь пула, очередь всего хаба, разрез «сколько
// ждёт в каждом пуле» для счётчика шапки и снимки манифеста заявок — их счёт отдельный.

Перем Заявки;   // Массив из Структура (Идентификатор, ПулИдентификатор, ЗаявительИдентификатор)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к очереди
Перем СчётчикМанифестов; // СчётчикОбращений — счёт чтений снимков манифеста

// Сколько раз службу спросили об очереди с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Сколько раз службу спросили о снимках манифеста.
//
// Возвращаемое значение:
//  Число.
//
Функция ОбращенийКМанифестам() Экспорт
	Возврат СчётчикМанифестов.Обращений();
КонецФункции

// Заводит ожидающую заявку (за обращение не считается).
//
// Параметры:
//  ПулИдентификатор - Число - пул заявки.
//  ЗаявительИдентификатор - Число - учётка заявителя.
//
Процедура Добавить(Знач ПулИдентификатор, Знач ЗаявительИдентификатор) Экспорт

	Заявки.Добавить(Новый Структура("Идентификатор, ПулИдентификатор, ЗаявительИдентификатор",
		Заявки.Количество() + 1, Цел(ПулИдентификатор), Цел(ЗаявительИдентификатор)));

КонецПроцедуры

// Ожидающие заявки одного пула; считает обращение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив - ожидающие заявки пула.
//
Функция ОжидающиеПула(Знач ПулИдентификатор) Экспорт

	Счётчик.Отметить();

	Результат = Новый Массив();
	Для Каждого Заявка Из Заявки Цикл
		Если Заявка.ПулИдентификатор = Цел(ПулИдентификатор) Тогда
			Результат.Добавить(Заявка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ожидающие заявки всех пулов; считает обращение.
//
// Возвращаемое значение:
//  Массив - ожидающие заявки хаба.
//
Функция ОжидающиеВсехПулов() Экспорт
	Счётчик.Отметить();
	Возврат Заявки;
КонецФункции

// Сколько заявок ждёт решения в каждом пуле; считает обращение.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пула), значение Число.
//
Функция ОжидающихПоПулам() Экспорт

	Счётчик.Отметить();

	Результат = Новый Соответствие();
	Для Каждого Заявка Из Заявки Цикл
		Было = Результат.Получить(Заявка.ПулИдентификатор);
		Результат.Вставить(Заявка.ПулИдентификатор, ?(Было = Неопределено, 0, Было) + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Снимки манифеста списка заявок; считает обращение. У заявок фикстуры снимков нет.
//
// Параметры:
//  СписокЗаявок - Массив - заявки.
//
// Возвращаемое значение:
//  Соответствие - пустое.
//
Функция МанифестыЗаявок(Знач СписокЗаявок) Экспорт
	СчётчикМанифестов.Отметить();
	Возврат Новый Соответствие();
КонецФункции

// Снимок манифеста одной заявки; считает обращение.
//
// Параметры:
//  Заявка - Структура - заявка.
//
// Возвращаемое значение:
//  Неопределено - у заявок фикстуры снимков нет.
//
Функция МанифестЗаявки(Знач Заявка) Экспорт
	СчётчикМанифестов.Отметить();
	Возврат Неопределено;
КонецФункции

Процедура ПриСозданииОбъекта()
	Заявки = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
	СчётчикМанифестов = Новый СчётчикОбращений();
КонецПроцедуры
