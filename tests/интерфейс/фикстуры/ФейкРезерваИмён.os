// Фейк СервисРезервированияИмён для опасной зоны пакета: резерв — пакет без версий, который
// задаёт тест; снятие резерва записывается, а не уходит в домен.

Перем Резервы;   // Соответствие: имя пакета -> Истина
Перем Снято;     // Массив из Строка — имена снятых резервов

// Помечает пакет резервом — пакетом без единой версии.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//
Процедура Зарезервировать(Знач ИмяПакета) Экспорт
	Резервы.Вставить(Строка(ИмяПакета), Истина);
КонецПроцедуры

// Резерв имени в пуле.
//
// Параметры:
//  Пул - Произвольный - пул (не используется фейком).
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя; Неопределено — у пакета есть версии.
//
Функция НайтиРезерв(Знач Пул, Знач ИмяПакета) Экспорт
	Пул = Пул;
	Если Резервы.Получить(Строка(ИмяПакета)) <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Имя", ИмяПакета);
КонецФункции

// Вправе ли смотрящий снимать резервы пула: фейк впускает всех, кого впустил гвард.
//
// Параметры:
//  Пользователь - Произвольный - смотрящий.
//  Пул - Произвольный - пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция ВправеРезервировать(Знач Пользователь, Знач Пул) Экспорт
	Пул = Пул;
	Возврат Пользователь <> Неопределено;
КонецФункции

// Снимает резерв: пакет пропадает.
//
// Параметры:
//  Принципал - Произвольный - принципал запроса.
//  Пул - Произвольный - пул.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Структура - Успех, Сообщение.
//
Функция СнятьРезерв(Знач Принципал, Знач Пул, Знач ИмяПакета) Экспорт
	Принципал = Принципал;
	Пул = Пул;
	Если Резервы.Получить(Строка(ИмяПакета)) <> Истина Тогда
		Возврат Новый Структура("Успех, Сообщение", Ложь, "у пакета есть версии");
	КонецЕсли;
	Резервы.Удалить(Строка(ИмяПакета));
	Снято.Добавить(Строка(ИмяПакета));
	Возврат Новый Структура("Успех, Сообщение", Истина, "");
КонецФункции

// Имена снятых резервов по порядку.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Снятые() Экспорт
	Возврат Снято;
КонецФункции

Процедура ПриСозданииОбъекта()
	Резервы = Новый Соответствие();
	Снято = Новый Массив();
КонецПроцедуры
