// Одна сессия вошедшего на месте службы сессий и учёток под настоящим стражем запроса: считает
// чтения сессии — страница вошедшего читает её один раз, стражем, а не ещё раз в шапке.

Перем Сессия_;   // СессияХаба — сессия вошедшего
Перем Учётка_;   // Структура — вошедший
Перем Чтений_;   // Число — обращений к Получить

#Область Замер

// Сколько раз сессию прочитали с начала замера.
//
// Возвращаемое значение:
//  Число
//
Функция Чтений() Экспорт
	Возврат Чтений_;
КонецФункции

// Куки браузера вошедшего: в них — идентификатор его сессии.
//
// Возвращаемое значение:
//  КукиЗаглушка
//
Функция Куки() Экспорт
	Куки = Новый КукиЗаглушка();
	Куки.Добавить("oshub_session", Сессия_.Идентификатор());
	Возврат Куки;
КонецФункции

#КонецОбласти

#Область СлужбаСессий

// Сессия по идентификатору; каждое обращение считается — в бою это чтение и запись срока.
//
// Параметры:
//  Идентификатор - Строка - идентификатор из куки.
//  Момент - Дата - не различается (необязательный).
//
// Возвращаемое значение:
//  СессияХаба, Неопределено - сессия; Неопределено — чужой идентификатор.
//
Функция Получить(Знач Идентификатор, Знач Момент = Неопределено) Экспорт
	Момент = Момент;
	Чтений_ = Чтений_ + 1;
	Возврат ?(Идентификатор = Сессия_.Идентификатор(), Сессия_, Неопределено);
КонецФункции

// Сохраняет данные сессии (защита CSRF кладёт в неё токен): сессия одна, хранить её негде.
//
// Параметры:
//  Сессия - СессияХаба - изменённая сессия.
//
Процедура Сохранить(Знач Сессия) Экспорт
	Сессия = Сессия;
КонецПроцедуры

#КонецОбласти

#Область СервисПользователей

// Учётка по идентификатору: вошедший — свой, прочих нет.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Структура, Неопределено - Идентификатор, Логин, РольХаба, Активен, ТребуетсяСменаПароля.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат ?(Идентификатор = Учётка_.Идентификатор, Учётка_, Неопределено);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта() Экспорт

	Учётка_ = Новый Структура("Идентификатор, Логин, РольХаба, Активен, ТребуетсяСменаПароля",
		7, "смотрящий", "user", Истина, Ложь);
	Данные = Новый Соответствие();
	Данные.Вставить("пользователь", Учётка_.Идентификатор);
	Сессия_ = Новый СессияХаба("сессия-замера", Данные, ТекущаяУниверсальнаяДата(), 3600);
	Чтений_ = 0;

КонецПроцедуры
