// Версии, каналы, происхождение и скачивания для вкладки версий пакета — ровно то, чем вкладка
// пользуется; базы и доменных служб здесь нет, каналы заводит ДобавитьКанал.

Перем Каналы;       // каналы пакета в порядке показа
Перем Апстримные;   // Соответствие: идентификатор версии -> Истина
Перем Доверенные;   // Соответствие: идентификатор версии -> Истина
Перем Скачивания;   // Соответствие: идентификатор версии -> число скачиваний
Перем ЗаданоВопросов;   // сколько раз спросили скачивания версий

// Запись версии в том виде, в каком её читает вкладка.
//
// Параметры:
//  Номер - Строка - semver-версия («1.2.3»).
//  Размер - Число - объём артефакта в байтах.
//  Отпечаток - Строка - sha256 артефакта.
//  НомерМанифеста - Строка - номер версии, записанный в манифесте артефакта; пустой
//                   означает «тот же, что и координата» (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - запись версии.
//
Функция Версия(Знач Номер, Знач Размер, Знач Отпечаток, Знач НомерМанифеста = "") Экспорт

	// слот («SNAPSHOT») semver не разбирает вовсе: его колонки нулевые, как в реестре
	Части = СтрРазделить(?(СтрНайти(Номер, ".") > 0, Номер, "0.0.0"), ".");

	Результат = Новый Структура();
	Результат.Вставить("Идентификатор", СтрДлина(Номер) + Размер);
	Результат.Вставить("Версия", Номер);
	Результат.Вставить("SemverМажор", Число(Части[0]));
	Результат.Вставить("SemverМинор", Число(Части[1]));
	Результат.Вставить("SemverПатч", Число(Части[2]));
	Результат.Вставить("Опубликована", Дата(2026, 12, 31, 23, 59, 5));
	Результат.Вставить("Размер", Размер);
	Результат.Вставить("Sha256", Отпечаток);
	Результат.Вставить("ВерсияМанифеста", ?(ЗначениеЗаполнено(НомерМанифеста), НомерМанифеста, Номер));
	Результат.Вставить("Отозвана", Ложь);
	Возврат Результат;

КонецФункции

// Пакет в том виде, в каком его читает вкладка.
//
// Возвращаемое значение:
//  Структура - Идентификатор и Имя.
//
Функция Пакет() Экспорт
	Возврат Новый Структура("Идентификатор, Имя", 1, "mylib");
КонецФункции

// Заводит канал пакета: имя тега, версия, которую он отдаёт, и его состав.
//
// Параметры:
//  ИмяТега - Строка - имя канала.
//  Отдаваемая - Структура, Неопределено - версия, которую установка по тегу получает
//               сейчас; Неопределено — отдавать нечего.
//  Состав - Массив, Неопределено - версии канала (необязательный, по умолчанию — одна
//           отдаваемая либо пусто).
//
Процедура ДобавитьКанал(Знач ИмяТега, Знач Отдаваемая, Знач Состав = Неопределено) Экспорт

	Тег = Новый Структура("Идентификатор, Имя, Стиль, Значок, ПоУмолчанию",
		Каналы.Количество() + 1, ИмяТега, "stable", "", Ложь);

	СоставКанала = Состав;
	Если СоставКанала = Неопределено Тогда
		СоставКанала = Новый Массив();
		Если Отдаваемая <> Неопределено Тогда
			СоставКанала.Добавить(Отдаваемая);
		КонецЕсли;
	КонецЕсли;

	Каналы.Добавить(Новый Структура("Тег, Состав, Отдаваемая", Тег, СоставКанала, Отдаваемая));

КонецПроцедуры

// Каналы пакета в том виде, в каком их читает вкладка.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВерсииПакета - Массив, Неопределено - версии пакета.
//
// Возвращаемое значение:
//  Структура - Каналы (заведённые ДобавитьКанал) и ПоВерсиям (пустая раскладка).
//
Функция КаналыПакета(Знач ПакетИдентификатор, Знач ВерсииПакета = Неопределено) Экспорт

	ПакетИдентификатор = ПакетИдентификатор;
	ВерсииПакета = ВерсииПакета;
	Возврат Новый Структура("Каналы, ПоВерсиям", Каналы, Новый Соответствие());

КонецФункции

// Теги по версиям: у версий вкладки каналов нет, и колонка каналов печатает прочерк.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  СписокВерсий - Массив - версии пакета.
//
// Возвращаемое значение:
//  Соответствие - пустое.
//
Функция ТегиПоВерсиям(Знач ПакетИдентификатор, Знач СписокВерсий) Экспорт
	ПакетИдентификатор = ПакетИдентификатор;
	СписокВерсий = СписокВерсий;
	Возврат Новый Соответствие();
КонецФункции

// Отмечает версию пришедшей с апстрима: без отметки версия своя.
//
// Параметры:
//  Версия - Структура - запись версии.
//
Процедура ОтметитьАпстримной(Знач Версия) Экспорт
	Апстримные.Вставить(Версия.Идентификатор, Истина);
КонецПроцедуры

// Отмечает версию принятой доверенной публикацией: без отметки признака нет.
//
// Параметры:
//  Версия - Структура - запись версии.
//
Процедура ОтметитьДоверенной(Знач Версия) Экспорт
	Доверенные.Вставить(Версия.Идентификатор, Истина);
КонецПроцедуры

// Своя ли версия (контракт СнимокПровенанса).
//
// Параметры:
//  Версия - Структура - запись версии.
//
// Возвращаемое значение:
//  Булево - Ложь только у отмеченной ОтметитьАпстримной.
//
Функция ЭтоСвоя(Знач Версия) Экспорт
	Возврат Апстримные.Получить(Версия.Идентификатор) <> Истина;
КонецФункции

// Пришла ли версия доверенным конвейером (контракт СнимокПровенанса).
//
// Параметры:
//  Версия - Структура - запись версии.
//
// Возвращаемое значение:
//  Булево - Истина только у отмеченной ОтметитьДоверенной.
//
Функция ЭтоДоверенныйКонвейер(Знач Версия) Экспорт
	Возврат Доверенные.Получить(Версия.Идентификатор) = Истина;
КонецФункции

// Версии, принятые доверенной публикацией, множеством (контракт СнимокПровенанса).
//
// Возвращаемое значение:
//  Соответствие - идентификатор версии в Истина.
//
Функция ДоверенныеВерсии() Экспорт
	Возврат Доверенные;
КонецФункции

// Заводит скачивания версии; без этого у версии их нет вовсе.
//
// Параметры:
//  Версия - Структура - запись версии.
//  Количество - Число - сколько раз версию скачали.
//
Процедура Скачано(Знач Версия, Знач Количество) Экспорт
	Скачивания.Вставить(Версия.Идентификатор, Количество);
КонецПроцедуры

// Скачивания версий пакета одним вопросом (контракт СлужбаСтатистикиСкачиваний): версий
// без скачиваний в ответе нет, как и у службы.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Соответствие - идентификатор версии -> число скачиваний.
//
Функция СкачиванияВерсийПакета(Знач ПакетИдентификатор) Экспорт
	ПакетИдентификатор = ПакетИдентификатор;
	ЗаданоВопросов = ЗаданоВопросов + 1;

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из Скачивания Цикл
		Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Скачивания версии из прочитанных (контракт СлужбаСтатистикиСкачиваний).
//
// Параметры:
//  СкачиванияВерсий - Соответствие - идентификатор версии -> число скачиваний.
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Число - ноль, если версии среди прочитанных нет.
//
Функция СкачиванийВерсииИзРазреза(Знач СкачиванияВерсий, Знач ВерсияИдентификатор) Экспорт
	Накоплено = СкачиванияВерсий.Получить(ВерсияИдентификатор);
	Возврат ?(Накоплено = Неопределено, 0, Накоплено);
КонецФункции

// Сколько раз вкладка спросила скачивания версий.
//
// Возвращаемое значение:
//  Число.
//
Функция ВопросовОСкачиваниях() Экспорт
	Возврат ЗаданоВопросов;
КонецФункции

Процедура ПриСозданииОбъекта()
	Каналы = Новый Массив();
	Апстримные = Новый Соответствие();
	Доверенные = Новый Соответствие();
	Скачивания = Новый Соответствие();
	ЗаданоВопросов = 0;
КонецПроцедуры
