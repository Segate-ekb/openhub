// Окно «Получатели» подписки хаба и пула и получатели в её записи — на настоящих службах подписок
// поверх хранилищ в памяти (фикстура МирРазделаПодписок): пулы строками с настоящим режимом, три
// сегмента «Все / Выбранные / Никто» у строки пула (у подписки пула — её пул раскрытой веткой без
// «Никто»), режим — массовая отметка кита: в «все» и «никакие» пакеты заперты, «выбранные» начинаются
// с того, что было видно. Ленивые ветки и страница ветки целиком без скрипта, найденное, ряд выбранного
// вне показанного с пределом, сводка правок; форма окна — правками кита со скриптом и формой, какой её
// отправит браузер без скрипта, — ложится в домен одинаково, переходы режимов сегментом — таблицей.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;              // фикстура СборкаUI — кит компонентов, словарь, резолвер текстов
Перем КаталогМодулей;  // Строка — src/модули
Перем Галки;           // фикстура ГалкиВРазметке

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Собрать() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ГалкиВРазметке");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("МирРазделаПодписок");
	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));
	Галки = Новый ГалкиВРазметке();

КонецПроцедуры

#Область Окно

// Подписка хаба: пулы строками с тремя сегментами режима и плашкой — alpha «выбранные: 1», beta
// «никто»; сегмента и плашки «все, кроме» нет; пакеты не в разметке, приезжают по адресу двери;
// выбранное вне показанного — рядом над деревом с крестиком; итог сверху; правки уходят и без скрипта
// (поле показанного кита), их сводка — у кнопок; окно закрывает слово кита.
&Тест
Процедура ОкноПодпискиХабаНесётПулыСТремяРежимамиИЛенивыеВетки() Экспорт

	Мир = НовыйМир();
	Хаба = Мир.ПодпискаБезОтбора(Мир.Сервис.ОбъектХаба());
	Выбрать(Мир, Мир.Сервис.ОбъектХаба(), Хаба, 7, "пакет_42");
	Отметить(Мир, Мир.Сервис.ОбъектХаба(), Хаба, "пул", 8);

	Окно = ОкноХаба(Мир, Хаба);
	Ожидаем.Что(Окно, "окно открыто").Содержит(" open");
	Ожидаем.Что(Окно, "заголовок с именем подписки").Содержит("Получатели: ");
	Ожидаем.Что(Окно, "итог: кто получает").Содержит("Получают 1 пул · 1 пакет · новые пакеты в пулах «Все»");
	Ожидаем.Что(СегментыВетки(Окно, "пул_7"), "у пула подписки хаба три сегмента").Равно("все,выбранные,никакие");
	Ожидаем.Что(Окно, "подписи сегментов словами владельца").Содержит(">Никто<");
	Ожидаем.Что(Радио(Окно, "пул_7", "выбранные"), "alpha — «выбранные»").Содержит(" checked");
	Ожидаем.Что(Радио(Окно, "пул_8", "никакие"), "beta — «никакие»").Содержит(" checked");
	Ожидаем.Что(Окно, "плашка режима «выбранные»").Содержит(">выбранные: 1<");
	Ожидаем.Что(Окно, "у исключённого пула — «никто»").Содержит(">никто<");
	Ожидаем.Что(СтрНайти(НРег(Окно), "кроме"), "ни сегмента, ни плашки «все, кроме»").Равно(0);
	Ожидаем.Что(Галки.Есть(Окно, "пакет_43"), "пакеты подписки хаба — по раскрытию").ЭтоЛожь();
	Ожидаем.Что(Окно, "ветка приезжает по адресу двери")
		.Содержит(Дверь(Хаба) + "?" + Код("ветка") + "=" + Код("пул_7") + "&amp;" + Код("страница") + "=1");
	Ожидаем.Что(Окно, "поиск спрашивает ту же дверь").Содержит("formaction=""" + Дверь(Хаба) + """");
	Ожидаем.Что(Окно, "выбранное вне показанного — рядом над деревом").Содержит("data-checktree-picked");
	Ожидаем.Что(Галки.Есть(Окно, "пакет_42", "снять"), "выбранный web — плашкой с крестиком «снять»").ЭтоИстина();
	Ожидаем.Что(Окно, "плашка названа «пул/пакет»").Содержит(">alpha/web<");
	Ожидаем.Что(Окно, "ряд назван «Выбрано»").Содержит("Выбрано");
	Ожидаем.Что(ТегФормы(Окно, Дверь(Хаба)), "форма уходит тихо на дверь").Содержит("data-quiet");
	Ожидаем.Что(Окно, "со скриптом — только правки").Содержит("data-checktree-edits-only");
	Ожидаем.Что(Окно, "без скрипта — тоже правки: поле показанного").Содержит("=пул_7:выбранные");
	Ожидаем.Что(Окно, "сводка правок у кнопок").Содержит("data-checktree-changes");
	Отмена = Между(Окно, "<a href=""/pools/main/settings/webhooks""", "</a>");
	Ожидаем.Что(Отмена, "без скрипта окно закрывает ссылка на раздел без ?окно").Заполнено();
	Ожидаем.Что(Окно, "«Отмена» — словом кита АдресЗакрытия").Содержит(">Отмена<");
	Ожидаем.Что(Окно, "со скриптом закрывает на месте").Содержит("data-closes");

КонецПроцедуры

// Подписка пула: её пул — раскрытая ветка с сегментами «все / выбранные» (без «никакие») и пакетами
// в разметке. В «все» пакеты отмечены и заперты; в «выбранные» — правятся, отмечены выбранные, итог
// говорит, что новые не попадают.
&Тест
Процедура ОкноПодпискиПулаПечатаетСвойПулВеткойСДвумяРежимами() Экспорт

	Мир = НовыйМир();
	Пул = Мир.ОбъектПула(7);
	Пула = Мир.Подписка(Пул);

	Окно = ОкноПула(Мир, Пул, Пула);
	Ожидаем.Что(Окно, "итог подписки пула").Содержит("Получают 2 пакета из 2 · новые пакеты попадают сами");
	Ожидаем.Что(СегментыВетки(Окно, "пул_7"), "сегменты своего пула без «никакие»").Равно("все,выбранные");
	Ожидаем.Что(Радио(Окно, "пул_7", "все"), "сегмент «все» выбран").Содержит(" checked");
	Ожидаем.Что(СтрНайти(Окно, "value=""никакие"""), "«никакие» подписке пула не печатается").Равно(0);
	Ожидаем.Что(Галки.Тег(Окно, "пакет_42"), "в «все» пакет отмечен").Содержит(" checked");
	Ожидаем.Что(Галки.Тег(Окно, "пакет_42"), "и заперт режимом").Содержит("data-checktree-locked");
	Ожидаем.Что(Окно, "свой пул — раскрытая ветка").Содержит("<details class=""checktree__branch"" open");

	Применить(Мир, Пул, Пула, "правки=1&режим=" + Код("пул_7:выбранные") + "&основа=" + Код("пул_7:все")
		+ "&снять=" + Код("пакет_43"));
	Окно = ОкноПула(Мир, Пул, Пула);
	Ожидаем.Что(Окно, "итог «выбранных»").Содержит("Получают 1 пакет из 2 · только выбранные, новые не попадают");
	Ожидаем.Что(Радио(Окно, "пул_7", "выбранные"), "сегмент — настоящий режим").Содержит(" checked");
	Ожидаем.Что(Галки.Тег(Окно, "пакет_42"), "выбранный web отмечен").Содержит(" checked");
	Ожидаем.Что(Галки.Тег(Окно, "пакет_42"), "и правится").Не_().Содержит("disabled");
	Ожидаем.Что(Галки.Тег(Окно, "пакет_43"), "невыбранный jlib снят").Не_().Содержит(" checked");
	Ожидаем.Что(Окно, "показанное — полем кита").Содержит("name=""показано"" value=""-пакет_43,+пакет_42,=пул_7:выбранные""");

КонецПроцедуры

// Страница ветки без скрипта — целиком: строка пула с сегментами режима в той же форме, пакеты этой
// страницы (в «все» — запертые), «Показать ещё» до следующей; последняя страница ссылки дальше не
// несёт. Ссылка назад ко всем пулам.
&Тест
Процедура СтраницаВеткиПечатаетСтрокуПулаКусокИСсылкуДальше() Экспорт

	Мир = НовыйМир();
	Для Номер = 1 По 60 Цикл
		Мир.Пакеты.ДобавитьПакет(1000 + Номер, 7, "pkg-" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"));
	КонецЦикла;
	Хаба = Мир.ПодпискаБезОтбора(Мир.Сервис.ОбъектХаба());

	Первая = ОкноХаба(Мир, Хаба, Новый Структура("Найти, Ветка, Страница", "", "пул_7", 1));
	Ожидаем.Что(Первая, "кусок ветки").Содержит("data-checktree-page=""пул_7""");
	Ожидаем.Что(Первая, "строка пула над пакетами").Содержит("data-checktree-head");
	Ожидаем.Что(СегментыВетки(Первая, "пул_7"), "с сегментами режима").Равно("все,выбранные,никакие");
	Ожидаем.Что(Радио(Первая, "пул_7", "все"), "alpha — «все»").Содержит(" checked");
	Ожидаем.Что(Галки.Ключи(Первая, "").Количество(), "на странице 50 узлов").Равно(50);
	Ожидаем.Что(Галки.Тег(Первая, "пакет_1001"), "пакеты пула «все» заперты").Содержит("data-checktree-locked");
	Ожидаем.Что(Первая, "дальше — вторая страница")
		.Содержит(Код("ветка") + "=" + Код("пул_7") + "&amp;" + Код("страница") + "=2");
	Ожидаем.Что(Первая, "ссылка ко всем пулам").Содержит(">Все пулы<");
	Ожидаем.Что(Первая, "правки без скрипта — полем показанного").Содержит("=пул_7:все");

	Вторая = ОкноХаба(Мир, Хаба, Новый Структура("Найти, Ветка, Страница", "", "пул_7", 2));
	Ожидаем.Что(Галки.Ключи(Вторая, "").Количество(), "на второй — остаток: 62 пакета минус 50").Равно(12);
	Ожидаем.Что(СтрНайти(Вторая, Код("страница") + "=3"), "дальше ссылки нет").Равно(0);

КонецПроцедуры

// Найденное: пакеты, чьё имя или имя пула содержит строку, подписью «пул/пакет»; пакет пула «все»
// или «никакие» заперт с пояснением (сегментов у найденного нет), пакет пула «выбранные» правится.
// Строка короче двух знаков не ищет — окно показывает всё дерево.
&Тест
Процедура НайденноеСобираетПакетыИзВсехПулов() Экспорт

	Мир = НовыйМир();
	Мир.Пакеты.ДобавитьПакет(50, 8, "webkit");
	Хаба = Мир.ПодпискаБезОтбора(Мир.Сервис.ОбъектХаба());
	Выбрать(Мир, Мир.Сервис.ОбъектХаба(), Хаба, 8, "пакет_50");

	Окно = ОкноХаба(Мир, Хаба, Новый Структура("Найти, Ветка, Страница", "we", "", 1));
	Ожидаем.Что(Окно, "ответ поиска").Содержит("data-checktree-found");
	Ожидаем.Что(Окно, "совпадения из обоих пулов").Содержит("alpha/web");
	Ожидаем.Что(Окно, "и из beta").Содержит("beta/webkit");
	Ожидаем.Что(Окно, "число найденного").Содержит("найдено: 2");
	Ожидаем.Что(Галки.Есть(Окно, "пакет_43"), "jlib не подходит").ЭтоЛожь();
	Ожидаем.Что(Галки.Тег(Окно, "пакет_42"), "web пула «все» заперт").Содержит("disabled");
	Ожидаем.Что(Окно, "с пояснением").Содержит("пул «Все» — правка в «Выбранных»");
	Ожидаем.Что(Галки.Тег(Окно, "пакет_50"), "webkit пула «выбранные» правится").Не_().Содержит("disabled");

	Окно = ОкноХаба(Мир, Хаба, Новый Структура("Найти, Ветка, Страница", "w", "", 1));
	Ожидаем.Что(СтрНайти(Окно, "data-checktree-found"), "одна буква — не поиск").Равно(0);
	Ожидаем.Что(Окно, "а всё дерево").Содержит(Радио(Окно, "пул_7", "все"));

КонецПроцедуры

// Ряд выбранного вне показанного печатает первые 20 плашек и хвост «ещё N»: у подписки хаба — текстом
// (пакеты разных пулов), у подписки пула — ссылкой на вторую страницу её ветки.
&Тест
Процедура РядВыбранногоОграниченПределомСХвостом() Экспорт

	Мир = НовыйМир();
	Для Номер = 1 По 60 Цикл
		Мир.Пакеты.ДобавитьПакет(1000 + Номер, 7, "pkg-" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"));
	КонецЦикла;
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Мир.ПодпискаБезОтбора(Объект);
	Применить(Мир, Объект, Хаба, "правки=1&режим=" + Код("пул_7:выбранные"));

	Окно = ОкноХаба(Мир, Хаба);
	Ожидаем.Что(Галки.Ключи(Окно, "пакет_", "снять").Количество(), "в ряду — первые 20 из 62 выбранных").Равно(20);
	Ожидаем.Что(Окно, "хвост «ещё 42» текстом").Содержит("<span class=""checktree__picked-more"">ещё 42</span>");
	Вторая = ОкноХаба(Мир, Хаба, Новый Структура("Найти, Ветка, Страница", "", "пул_7", 2));
	Хвост = Между(Вторая, "<a class=""checktree__picked-more""", "</a>");
	Ожидаем.Что(Хвост, "на второй странице ветки — 50 выбранных вне её, хвост «ещё 30»").Содержит(">ещё 30</a>");
	Ожидаем.Что(Хвост, "ведёт на первую страницу, а не на себя").Содержит(Код("страница") + "=1");

	Пул = Мир.ОбъектПула(7);
	Пула = Мир.Подписка(Пул);
	Применить(Мир, Пул, Пула, "правки=1&режим=" + Код("пул_7:выбранные"));
	Окно = ОкноПула(Мир, Пул, Пула);
	Ожидаем.Что(Галки.Ключи(Окно, "пакет_", "снять").Количество(), "у подписки пула в ряду — дальше первой страницы")
		.Равно(12);
	Ожидаем.Что(Окно, "хвоста нет — все 12 в пределе").Не_().Содержит("checktree__picked-more");

	Для Номер = 61 По 90 Цикл
		Мир.Пакеты.ДобавитьПакет(1000 + Номер, 7, "pkg-" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"));
	КонецЦикла;
	Применить(Мир, Пул, Пула, "правки=1&режим=" + Код("пул_7:все"));
	Применить(Мир, Пул, Пула, "правки=1&режим=" + Код("пул_7:выбранные") + "&основа=" + Код("пул_7:все"));
	Окно = ОкноПула(Мир, Пул, Пула);
	Хвост = Между(Окно, "<a class=""checktree__picked-more""", "</a>");
	Ожидаем.Что(Хвост, "42 дальше первой страницы — хвост «ещё 22» ссылкой").Содержит(">ещё 22</a>");
	Ожидаем.Что(Хвост, "на вторую страницу ветки пула").Содержит(Код("ветка") + "=" + Код("пул_7") + "&amp;"
		+ Код("страница") + "=2");
	Ожидаем.Что(Хвост, "на двери окна").Содержит("/recipients?");

КонецПроцедуры

#КонецОбласти

#Область Правки

// Со скриптом: «выбранные» после «все» со снятым пакетом — весь пул без него; «никакие» — пул исключён.
&Тест
Процедура ПравкиКитаЛожатсяРежимамиОсновойИВыбором() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Мир.ПодпискаБезОтбора(Объект);

	Применить(Мир, Объект, Хаба, "правки=1&режим=" + Код("пул_7:выбранные") + "&основа=" + Код("пул_7:все")
		+ "&снять=" + Код("пакет_42") + "&режим=" + Код("пул_8:никакие"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "alpha — весь пул без web").Равно("выбранные:jlib");
	Сводка = Мир.Исключения.СводкаИсключений(Мир.Админ(), Объект, Хаба.Идентификатор);
	Ожидаем.Что(СтрШаблон("%1/%2/%3", Сводка.Пулов, Сводка.Пакетов, Сводка.Выбрано),
		"пул «никакие», исключённых пакетов нет, один выбранный").Равно("1/0/1");

	Применить(Мир, Объект, Хаба, "правки=1&включить=" + Код("пакет_42") + "&режим=" + Код("пул_8:все"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "web выбран снова").Равно("выбранные:jlib,web");
	Сводка = Мир.Исключения.СводкаИсключений(Мир.Админ(), Объект, Хаба.Идентификатор);
	Ожидаем.Что(Сводка.Пулов, "beta вернулась").Равно(0);

КонецПроцедуры

// Переходы режима пула сегментом — таблицей {все, выбранные, никакие} × {все, выбранные, никакие}, со
// скриптом (правка кита «режим=пул_7:<режим>», у «выбранных» из «все»/«никакие» — с основой, как её шлёт
// скрипт) и без (форма окна, как её отправит браузер, со сменённым сегментом — основу кит выводит сам).
// «Все» — весь пул; «выбранные» стартуют с того, что было видно: из «все» — все, из «никакие» —
// никого, из «выбранных» — как было; «никакие» — никого. Сегмент напечатанного ничего не меняет.
// Две последние строки — массовая отметка в пределах одной формы: «выбранные» → «все» → «выбранные»
// и «выбранные» → «никакие» → «выбранные» (режим тот же, основа — нажатый сегмент).
&Тест
Процедура ПереходыРежимаСегментомУПодпискиХаба() Экспорт

	Таблица = СтрРазделить(
		"все>все=все:jlib,web;"
		+ "все>выбранные=выбранные:jlib,web;"
		+ "все>никакие=никакие:;"
		+ "выбранные>все=все:jlib,web;"
		+ "выбранные>выбранные=выбранные:web;"
		+ "выбранные>никакие=никакие:;"
		+ "никакие>все=все:jlib,web;"
		+ "никакие>выбранные=выбранные:;"
		+ "никакие>никакие=никакие:", ";");

	Для Каждого Случай Из Таблица Цикл
		Переход = СтрРазделить(Случай, "=")[0];
		Ждём = СтрРазделить(Случай, "=")[1];
		Исход = СтрРазделить(Переход, ">")[0];
		Цель = СтрРазделить(Переход, ">")[1];
		Для Каждого СоСкриптом Из СтрРазделить("1,0", ",") Цикл
			Мир = НовыйМир();
			Объект = Мир.Сервис.ОбъектХаба();
			Хаба = Мир.ПодпискаБезОтбора(Объект);
			Исходно(Мир, Объект, Хаба, Исход);
			Если СоСкриптом = "1" Тогда
				Тело = ПравкаСегментом(Исход, Цель);
			Иначе
				Тело = Галки.ФормаБезСкрипта(ОкноХаба(Мир, Хаба), "режим:пул_7=" + Цель);
			КонецЕсли;
			Применить(Мир, Объект, Хаба, Тело);
			Ожидаем.Что(Итог(Мир, Объект, Хаба), Случай + ?(СоСкриптом = "1", " со скриптом", " без скрипта"))
				.Равно(Ждём);
		КонецЦикла;
	КонецЦикла;

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Мир.ПодпискаБезОтбора(Объект);
	Исходно(Мир, Объект, Хаба, "выбранные");
	Применить(Мир, Объект, Хаба, "правки=1&основа=" + Код("пул_7:все"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "выбранные → все → выбранные: весь пул").Равно("выбранные:jlib,web");
	Применить(Мир, Объект, Хаба, "правки=1&основа=" + Код("пул_7:никакие"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "выбранные → никто → выбранные: никого").Равно("выбранные:");

КонецПроцедуры

// Подписка пула — те же переходы между «все» и «выбранные» сегментами своей ветки; без скрипта форма
// несёт галки показанного списка (запертые в «все» не уходят) и поле показанного.
&Тест
Процедура ПереходыРежимаСегментомУПодпискиПула() Экспорт

	Таблица = СтрРазделить(
		"все>все=все:jlib,web;"
		+ "все>выбранные=выбранные:jlib,web;"
		+ "выбранные>все=все:jlib,web;"
		+ "выбранные>выбранные=выбранные:web", ";");

	Для Каждого Случай Из Таблица Цикл
		Переход = СтрРазделить(Случай, "=")[0];
		Ждём = СтрРазделить(Случай, "=")[1];
		Исход = СтрРазделить(Переход, ">")[0];
		Цель = СтрРазделить(Переход, ">")[1];
		Для Каждого СоСкриптом Из СтрРазделить("1,0", ",") Цикл
			Мир = НовыйМир();
			Пул = Мир.ОбъектПула(7);
			Пула = Мир.Подписка(Пул);
			Исходно(Мир, Пул, Пула, Исход);
			Если СоСкриптом = "1" Тогда
				Тело = ПравкаСегментом(Исход, Цель);
			Иначе
				Тело = Галки.ФормаБезСкрипта(ОкноПула(Мир, Пул, Пула), "режим:пул_7=" + Цель);
			КонецЕсли;
			Применить(Мир, Пул, Пула, Тело);
			Ожидаем.Что(Итог(Мир, Пул, Пула), Случай + ?(СоСкриптом = "1", " со скриптом", " без скрипта"))
				.Равно(Ждём);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Слово владельца: «нажал на „все“ — все выделились, переключил на выбранные — снял пару галок». В
// подписке пула на 62 пакета «все» → «выбранные» со снятыми двумя — весь пул минус эти два, со скриптом
// одной формой и без скрипта двумя (сегмент, затем галки отпертых пакетов).
&Тест
Процедура ВыбранныеПослеВсехСоСнятымиДаютВесьПулМинусСнятые() Экспорт

	Для Каждого СоСкриптом Из СтрРазделить("1,0", ",") Цикл
		Подпись = ?(СоСкриптом = "1", " со скриптом", " без скрипта");
		Мир = НовыйМир();
		Для Номер = 1 По 60 Цикл
			Мир.Пакеты.ДобавитьПакет(1000 + Номер, 7, "pkg-" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"));
		КонецЦикла;
		Пул = Мир.ОбъектПула(7);
		Пула = Мир.Подписка(Пул);
		Если СоСкриптом = "1" Тогда
			Применить(Мир, Пул, Пула, "правки=1&режим=" + Код("пул_7:выбранные") + "&основа=" + Код("пул_7:все")
				+ "&снять=" + Код("пакет_1001") + "&снять=" + Код("пакет_1002"));
		Иначе
			Применить(Мир, Пул, Пула, Галки.ФормаБезСкрипта(ОкноПула(Мир, Пул, Пула), "режим:пул_7=выбранные"));
			Ожидаем.Что(Получают(Ветка(Мир, Пул, Пула)), "КОНТРОЛЬ: после сегмента выбраны все")
				.Равно(ВесьПул(Мир, Пул, Пула));
			Применить(Мир, Пул, Пула, Галки.ФормаБезСкрипта(ОкноПула(Мир, Пул, Пула),
				"галка:пакет_1001&галка:пакет_1002"));
		КонецЕсли;
		Ветка = Ветка(Мир, Пул, Пула);
		Ожидаем.Что(Ветка.Режим, "режим «выбранные»" + Подпись).Равно("выбранные");
		Ожидаем.Что(Ветка.Пакеты.Количество() - Ветка.ИсключеноПакетов, "выбрано 60 из 62" + Подпись).Равно(60);
		Ожидаем.Что(СтрНайти("," + Получают(Ветка) + ",", ",pkg-001,") + СтрНайти("," + Получают(Ветка) + ",",
			",pkg-002,"), "pkg-001 и pkg-002 сняты" + Подпись).Равно(0);
	КонецЦикла;

КонецПроцедуры

// Галки пакетов пула, который остаётся «все» или «никакие», ничего не правят: дети решены режимом.
// Сменили режим в «никакие» — правки детей уступают ему.
&Тест
Процедура ГалкиПулаВсеИНикакиеНичегоНеПравят() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Мир.ПодпискаБезОтбора(Объект);

	Применить(Мир, Объект, Хаба, "правки=1&снять=" + Код("пакет_42"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "снятая галка в «все» не правит").Равно("все:jlib,web");
	Применить(Мир, Объект, Хаба, "правки=1&режим=" + Код("пул_7:никакие") + "&включить=" + Код("пакет_42"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "«никакие» сильнее галки ребёнка").Равно("никакие:");
	Применить(Мир, Объект, Хаба, "правки=1&включить=" + Код("пакет_42"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "поставленная галка в «никакие» не правит").Равно("никакие:");

КонецПроцедуры

// Без скрипта страница ветки печатается целиком и правится в той же форме: у пула «никакие» — сегменты
// и запертые снятые пакеты; сегмент «выбранные» начинает с пустого, дальше галки отперты и правятся.
// Отказа «пул исключён целиком» больше нет. Несменённая форма ничего не меняет.
&Тест
Процедура СтраницаВеткиПулаНикакиеПравитсяБезСкрипта() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Мир.Пакеты.ДобавитьПакет(50, 8, "webkit");
	Хаба = Мир.ПодпискаБезОтбора(Объект);
	Отметить(Мир, Объект, Хаба, "пул", 8);
	Ветка = Новый Структура("Найти, Ветка, Страница", "", "пул_8", 1);

	Страница = ОкноХаба(Мир, Хаба, Ветка);
	Ожидаем.Что(Радио(Страница, "пул_8", "никакие"), "строка пула beta — «никакие»").Содержит(" checked");
	Ожидаем.Что(Галки.Тег(Страница, "пакет_50"), "пакеты заперты").Содержит("data-checktree-locked");
	Ожидаем.Что(Галки.Тег(Страница, "пакет_50"), "и сняты").Не_().Содержит(" checked");

	Применить(Мир, Объект, Хаба, Галки.ФормаБезСкрипта(Страница));
	Ожидаем.Что(Итог(Мир, Объект, Хаба, 1), "КОНТРОЛЬ: несменённая страница ничего не меняет").Равно("никакие:");

	Применить(Мир, Объект, Хаба, Галки.ФормаБезСкрипта(Страница, "режим:пул_8=выбранные"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба, 1), "из «никакие» выбор начинается пустым").Равно("выбранные:");
	Страница = ОкноХаба(Мир, Хаба, Ветка);
	Ожидаем.Что(Галки.Тег(Страница, "пакет_50"), "галки отперты").Не_().Содержит("disabled");
	Применить(Мир, Объект, Хаба, Галки.ФормаБезСкрипта(Страница, "галка:пакет_50"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба, 1), "отмеченный webkit выбран").Равно("выбранные:webkit");

КонецПроцедуры

// Без скрипта форма отдаёт правки против поля показанного кита: на странице ветки «выбранных» снятая
// галка снимает выбор, отмеченная — выбирает. Крестик ряда выбранного над деревом — правка того узла,
// которого на странице нет.
&Тест
Процедура ГалкиБезСкриптаИКрестикВыбранногоСводятсяКПравкам() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Мир.ПодпискаБезОтбора(Объект);
	Выбрать(Мир, Объект, Хаба, 7, "пакет_43");
	Ветка = Новый Структура("Найти, Ветка, Страница", "", "пул_7", 1);

	Применить(Мир, Объект, Хаба, Галки.ФормаБезСкрипта(ОкноХаба(Мир, Хаба, Ветка), "галка:пакет_42&галка:пакет_43"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "web выбран, jlib снят").Равно("выбранные:web");

	Окно = ОкноХаба(Мир, Хаба);
	Ожидаем.Что(Галки.Есть(Окно, "пакет_42", "снять"), "выбранный web — в ряду над деревом").ЭтоИстина();
	Применить(Мир, Объект, Хаба, Галки.ФормаБезСкрипта(Окно, "снять=пакет_42"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "крестик ряда снял выбор web").Равно("выбранные:");

КонецПроцедуры

// «Снять найденные» без скрипта снимает все совпадения строки в пулах «выбранные», а пакеты пулов «все»
// и «никакие» не трогает — они заперты.
&Тест
Процедура НайденныеБезСкриптаСнимаютсяВсеКромеЗапертых() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Мир.Пакеты.ДобавитьПакет(50, 8, "webkit");
	Мир.Пакеты.ДобавитьПакет(51, 8, "webview");
	Хаба = Мир.ПодпискаБезОтбора(Объект);
	Применить(Мир, Объект, Хаба, "правки=1&режим=" + Код("пул_8:выбранные"));

	Окно = ОкноХаба(Мир, Хаба, Новый Структура("Найти, Ветка, Страница", "we", "", 1));
	Применить(Мир, Объект, Хаба, Галки.ФормаБезСкрипта(Окно, "найденные=выкл"));
	Ожидаем.Что(Итог(Мир, Объект, Хаба), "web пула «все» не тронут").Равно("все:jlib,web");
	Ожидаем.Что(Итог(Мир, Объект, Хаба, 1), "webkit и webview пула «выбранные» сняты").Равно("выбранные:");

КонецПроцедуры

// Форма старой вкладки — поле, которого окно не печатает, или режим «все, кроме» (окно четырёх
// сегментов): правок нет, пульт отвечает 400 «Страница устарела».
&Тест
Процедура СтараяФормаДелаетФормуУстаревшей() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Мир.ПодпискаБезОтбора(Объект);
	Дерево = Мир.Исключения.ДеревоПолучателей(Мир.Админ(), Объект, Хаба.Идентификатор);

	Для Каждого Тело Из СтрРазделить(Код("показанные_узлы") + "=" + Код("пакет_42") + ";"
		+ Код("получатель_пакет_42") + "=1;recipients=7;" + Код("показаны") + "=" + Код("пакет_42") + ";"
		+ Код("отмеченная") + "=" + Код("пакет_43") + ";"
		+ Код("режим:пул_7") + "=" + Код("кроме") + ";"
		+ "правки=1&режим=" + Код("пул_7:кроме"), ";") Цикл
		Правки = Мир.Стенд.Правило.Правки(Тело, Дерево);
		Ожидаем.Что(Правки.Устарела, "«" + Тело + "» — старая форма").ЭтоИстина();
	КонецЦикла;
	Правки = Мир.Стенд.Правило.Правки("_csrf=т&правки=1&режим=" + Код("пул_7:выбранные") + "&основа="
		+ Код("пул_7:все") + "&снять=" + Код("пакет_42"), Дерево);
	Ожидаем.Что(Правки.Устарела, "КОНТРОЛЬ: форма окна с основой — не устаревшая").ЭтоЛожь();
	Ожидаем.Что(Правки.Снимаемые.Количество(), "и правка в ней видна").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Запись

// В записи — кому подписка сообщает строкой и отметки рядом плашек кита с крестиком: каждая плашка —
// тихая форма двери окна с правкой кита (Плашка.Снять), своих признаков ряда нет.
&Тест
Процедура ЗаписьНазываетОтметкиПлашкамиСКрестиком() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Мир.ПодпискаБезОтбора(Объект);
	Выбрать(Мир, Объект, Хаба, 7, "пакет_42");
	Отметить(Мир, Объект, Хаба, "пул", 8);

	Параметры = Мир.Стенд.Параметры("хаб", , 0);
	Параметры.Объект = Объект;
	Параметры.Зритель = Мир.Админ();
	HTML = Мир.Стенд.Раздел(Параметры);
	Ожидаем.Что(HTML, "кому сообщает — счётом").Содержит("пулы: 1 из 2; выбранные: 1 пакет в 1 пуле");
	Ожидаем.Что(СтрНайти(HTML, "кроме"), "«все, кроме» в записи нет").Равно(0);
	Ожидаем.Что(HTML, "выбранный пакет плашкой").Содержит("+ alpha/web");
	Ожидаем.Что(HTML, "крестик говорит, что сделает").Содержит("aria-label=""Убрать «alpha/web» из выбранных""");
	Плашка = Между(HTML, "name=""снять"" value=""пакет_42""", "</form>");
	Ожидаем.Что(Плашка, "правка кита — «снять пакет»").Заполнено();
	Ожидаем.Что(ТегФормы(HTML, Дверь(Хаба)), "плашка — тихая форма двери окна").Содержит("data-quiet");
	Ожидаем.Что(ТегФормы(HTML, Дверь(Хаба)), "форма плашки кита").Содержит("class=""tag-form""");
	Ожидаем.Что(Между(HTML, "name=""правки"" value=""1""", "</form>"), "у плашки — правка кита целиком")
		.Заполнено();
	Ожидаем.Что(HTML, "исключённый пул плашкой").Содержит("− beta");
	Ожидаем.Что(СтрНайти(HTML, "data-sub-recipients"), "своего признака ряда нет").Равно(0);
	Ожидаем.Что(HTML, "«Получатели» — окно по адресу")
		.Содержит(Код("окно") + "=" + Код("получатели-" + Ключ(Хаба)));

КонецПроцедуры

&Тест
Процедура КомуСообщаетУПодпискиПулаВыбранные() Экспорт

	Мир = НовыйМир();
	Пул = Мир.ОбъектПула(7);
	Пула = Мир.Подписка(Пул);
	Мир.Исключения.Применить(Мир.Админ(), Пул, Пула.Идентификатор, Режим(7, "выбранные"), Новый Массив(),
		Новый Массив());

	Параметры = Мир.Стенд.Параметры("пул", , 7);
	Параметры.Объект = Пул;
	Параметры.Зритель = Мир.Админ();
	HTML = Мир.Стенд.Раздел(Параметры);
	Ожидаем.Что(HTML, "у подписки пула — сколько выбрано из скольких, словом режима").Содержит("выбранные: 2 из 2");
	Ожидаем.Что(СтрНайти(HTML, "кроме"), "«все, кроме» в записи нет").Равно(0);
	Ожидаем.Что(HTML, "выбранный пакет плашкой").Содержит("+ web");
	Ожидаем.Что(HTML, "крестик убирает из выбранных").Содержит("Убрать «web» из выбранных");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйМир()
	Возврат Новый МирРазделаПодписок(Новый КлассыСлоя(), КаталогМодулей, UI);
КонецФункции

// Снимает галку узла доменом от имени админа хаба.
Процедура Отметить(Знач Мир, Знач Объект, Знач Подписка, Знач ТипУзла, Знач Ид)
	Узлы = Новый Массив();
	Узлы.Добавить(Мир.Исключения.Узел(ТипУзла, Ид));
	Мир.Исключения.Отметить(Мир.Админ(), Объект, Подписка.Идентификатор, Узлы, Новый Массив());
КонецПроцедуры

// Форма окна «Получатели» — правилом в правки и в домен, как это делает пульт.
Процедура Применить(Знач Мир, Знач Объект, Знач Подписка, Знач Тело)
	Дерево = Мир.Исключения.ДеревоПолучателей(Мир.Админ(), Объект, Подписка.Идентификатор);
	Правки = Мир.Стенд.Правило.Правки("_csrf=т&" + Тело, Дерево);
	Ожидаем.Что(Правки.Устарела, "КОНТРОЛЬ: форма окна не устаревшая").ЭтоЛожь();
	Мир.Исключения.Применить(Мир.Админ(), Объект, Подписка.Идентификатор, Правки.Режимы, Правки.Включаемые,
		Правки.Снимаемые, Правки.Основы);
КонецПроцедуры

// Пул «выбранные» ровно с одним пакетом — формой окна со скриптом: «никто» → «выбранные» и галка.
Процедура Выбрать(Знач Мир, Знач Объект, Знач Подписка, Знач ПулИд, Знач КлючПакета)
	Пул = "пул_" + Формат(ПулИд, "ЧГ=0");
	Применить(Мир, Объект, Подписка, "правки=1&режим=" + Код(Пул + ":выбранные") + "&основа="
		+ Код(Пул + ":никакие") + "&включить=" + Код(КлючПакета));
КонецПроцедуры

// Исходное состояние пула 7 (alpha: jlib, web) для таблицы переходов: «все», «выбранные» (выбран web),
// «никакие».
Процедура Исходно(Знач Мир, Знач Объект, Знач Подписка, Знач Состояние)
	Если Состояние = "выбранные" Тогда
		Выбрать(Мир, Объект, Подписка, 7, "пакет_42");
	ИначеЕсли Состояние = "никакие" Тогда
		Отметить(Мир, Объект, Подписка, "пул", 7);
	КонецЕсли;
КонецПроцедуры

// Правка сегментом так, как её шлёт скрипт кита: режим, а у «выбранных» из «все» и «никакие» — основа.
Функция ПравкаСегментом(Знач Исход, Знач Цель)
	Тело = "правки=1&режим=" + Код("пул_7:" + Цель);
	Если Цель = "выбранные" И Исход <> Цель Тогда
		Тело = Тело + "&основа=" + Код("пул_7:" + Исход);
	КонецЕсли;
	Возврат Тело;
КонецФункции

// «режим:получают» пула дерева (по умолчанию первого, alpha) — как его видит домен.
Функция Итог(Знач Мир, Знач Объект, Знач Подписка, Знач Индекс = 0)
	Дерево = Мир.Исключения.ДеревоПолучателей(Мир.Админ(), Объект, Подписка.Идентификатор);
	Ветка = Дерево.Пулы[Индекс];
	Возврат Ветка.Режим + ":" + ?(Ветка.Режим = "никакие", "", Получают(Ветка));
КонецФункции

// Ветка единственного пула подписки пула.
Функция Ветка(Знач Мир, Знач Пул, Знач Подписка)
	Возврат Мир.Исключения.ДеревоПолучателей(Мир.Админ(), Пул, Подписка.Идентификатор).Пулы[0];
КонецФункции

// Все пакеты единственного пула подписки пула через запятую по имени.
Функция ВесьПул(Знач Мир, Знач Пул, Знач Подписка)
	Имена = Новый Массив();
	Для Каждого Пакет Из Ветка(Мир, Пул, Подписка).Пакеты Цикл
		Имена.Добавить(Пакет.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");
КонецФункции

Функция Режим(Знач ПулИд, Знач Режим)
	Результат = Новый Соответствие();
	Результат.Вставить(ПулИд, Режим);
	Возврат Результат;
КонецФункции

// Пакеты ветки, которым событие достаётся, через запятую по имени.
Функция Получают(Знач Ветка)
	Имена = Новый Массив();
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Если НЕ Пакет.Исключён Тогда
			Имена.Добавить(Пакет.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");
КонецФункции

Функция ОкноХаба(Знач Мир, Знач Подписка, Знач ВидДерева = Неопределено)
	Параметры = Мир.Стенд.Параметры("хаб", Мир.Стенд.Окна.Открытое("получатели", Ключ(Подписка)), 0);
	Параметры.Объект = Мир.Сервис.ОбъектХаба();
	Параметры.Зритель = Мир.Админ();
	Если ВидДерева <> Неопределено Тогда
		Параметры.ВидДерева = ВидДерева;
	КонецЕсли;
	Возврат ОкноПоЯкорю(Мир.Стенд.Раздел(Параметры), "podpiska-poluchateli");
КонецФункции

Функция ОкноПула(Знач Мир, Знач Пул, Знач Подписка)
	Параметры = Мир.Стенд.Параметры("пул", Мир.Стенд.Окна.Открытое("получатели", Ключ(Подписка)), 7);
	Параметры.Объект = Пул;
	Параметры.Зритель = Мир.Админ();
	Возврат ОкноПоЯкорю(Мир.Стенд.Раздел(Параметры), "podpiska-poluchateli");
КонецФункции

// Окно с этим идентификатором: от его <dialog до </dialog>; окна нет — пусто.
Функция ОкноПоЯкорю(Знач HTML, Знач Якорь)
	Позиция = СтрНайти(HTML, "id=""" + Якорь + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Лев(HTML, Позиция), "<dialog", НаправлениеПоиска.СКонца);
	Возврат Между(Сред(HTML, Начало), "<dialog", "</dialog>");
КонецФункции

// Значения сегментов режима ветки через запятую — в порядке печати.
Функция СегментыВетки(Знач HTML, Знач КлючВетки)
	Результат = Новый Массив();
	Метка = "name=""режим:" + КлючВетки + """ value=""";
	Хвост = HTML;
	Позиция = СтрНайти(Хвост, Метка);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Метка));
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
		Позиция = СтрНайти(Хвост, Метка);
	КонецЦикла;
	Возврат СтрСоединить(Результат, ",");
КонецФункции

// Радиокнопка режима ветки целиком.
Функция Радио(Знач HTML, Знач КлючВетки, Знач Режим)
	Метка = "name=""режим:" + КлючВетки + """ value=""" + Режим + """";
	Позиция = СтрНайти(HTML, Метка);
	Ожидаем.Что(Позиция > 0, "радиокнопка " + Метка + " напечатана").ЭтоИстина();
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

// Открывающий тег первой формы с этим адресом.
Функция ТегФормы(Знач HTML, Знач Адрес)
	Позиция = СтрНайти(HTML, "action=""" + Адрес + """");
	Ожидаем.Что(Позиция > 0, "форма " + Адрес + " напечатана").ЭтоИстина();
	Начало = СтрНайти(Лев(HTML, Позиция), "<form", НаправлениеПоиска.СКонца);
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

Функция Дверь(Знач Подписка)
	Возврат "/pools/main/settings/webhooks/" + Ключ(Подписка) + "/recipients";
КонецФункции

Функция Ключ(Знач Подписка)
	Возврат Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция Код(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Кусок разметки от первого «Начало» до ближайшего «Конец» включительно.
Функция Между(Знач HTML, Знач Начало, Знач Конец)
	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, Конец) + СтрДлина(Конец) - 1);
КонецФункции

#КонецОбласти
