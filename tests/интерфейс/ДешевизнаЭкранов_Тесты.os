// Дешевизна экранов интерфейса: цена экрана в обращениях к базе и прочитанных строках не растёт
// с числом строк. Экран собирается на малой и большой фактуре, обращения считают хранилища-фикстуры.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;              // СборкаUI — граф компонентов и рендереров интерфейса
Перем КаталогМодулей;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("СервисПользователейЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ЧтениеПуловЗаглушка");
	РеестрФикстур.Подключить("СчитающееХранилищеТокенов");
	РеестрФикстур.Подключить("СчитающееХранилищеПривязок");
	РеестрФикстур.Подключить("ФейкСервисПулов");
	РеестрФикстур.Подключить("СчитающееХранилищеУчёток");
	РеестрФикстур.Подключить("СчитающееХранилищеЛичностей");
	РеестрФикстур.Подключить("СчитающееХранилищеАгрегатов");
	РеестрФикстур.Подключить("СчитающееХранилищеГрантов");
	РеестрФикстур.Подключить("СчитающееХранилищеУчастников");
	РеестрФикстур.Подключить("СчитающееХранилищеЛенты");
	РеестрФикстур.Подключить("СчитающийСервисВходящих");
	РеестрФикстур.Подключить("СчитающийСервисГрупп");
	РеестрФикстур.Подключить("СчитающийСервисУчёток");
	РеестрФикстур.Подключить("СверкаГруппЗаглушка");
	РеестрФикстур.Подключить("ФейкСубъектыПрав");
	РеестрФикстур.Подключить("РольЗаписиЗаглушка");
	РеестрФикстур.Подключить("РазрезСервисПакетов");
	РеестрФикстур.Подключить("РазрезПул");
	РеестрФикстур.Подключить("СчитающееХранилищеГрупп");
	РеестрФикстур.Подключить("СчитающееХранилищеЧленств");
	РеестрФикстур.Подключить("ПерехватчикБезКлюча");
	РеестрФикстур.Подключить("ГвардКлючаПропускающий");
	РеестрФикстур.Подключить("ГотовностьЗаглушка");
	РеестрФикстур.Подключить("ПровенансВсёСвоё");
	РеестрФикстур.Подключить("ФейкОкруженияВитрины");
	РеестрФикстур.Подключить("ФейкПакетЗапись");
	РеестрФикстур.Подключить("ФейкПакетовДляЛетописи");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ЗамерОкруженияСтраницы");
	РеестрФикстур.Подключить("ЗамерОкруженияЛендинга");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ФормаТемыСтраницы");
	РеестрФикстур.Подключить("ЗамерХранилищаВерсий");
	РеестрФикстур.Подключить("ЗамерХранилищаПровенанса");
	РеестрФикстур.Подключить("ЗамерХранилищаТегов");
	РеестрФикстур.Подключить("ЗамерХранилищаМетокТегов");
	РеестрФикстур.Подключить("ЗамерХранилищаМетокВерсий");
	РеестрФикстур.Подключить("ЗамерБезТеговПула");
	РеестрФикстур.Подключить("КаркасЗамераШапки");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ОкружениеПуловХаба");
	РеестрФикстур.Подключить("МирРазделаПодписок");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	КаталогИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ПлашкиПула,"
		+ "ДомАккаунта,ДомХаба,ОкноВыпускаТокена,ОкноУчётки,ОтборЛюдей,ОкноРаздела,ОтметкаСохранения,РазборФормы,"
		+ "ВитринаТокеновКабинета,ВитринаУчёток,ВитринаПакетов,ВитринаМоихПакетов,"
		+ "ВитринаМоихПрав,КаталогПакетов,ВидимоеСодержимое,СтатистикаХаба,"
		+ "ВитринаПулов,ОкноПула,ОтборПулов,ДомПула,АдресаКаталога", ",") Цикл
		Поиск.Подключить(КаталогИнтерфейса, Имя);
	КонецЦикла;

	КаталогВхода = ОбъединитьПути(КаталогМодулей, "вход", "Классы");
	Для Каждого Имя Из СтрРазделить("СверкаСекретов,СервисТокенов,ГейтТокена,"
		+ "СервисАктивностиУчёток,СписокУчёток,ПолитикаПарольногоВхода", ",") Цикл
		Поиск.Подключить(КаталогВхода, Имя);
	КонецЦикла;

	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПоискПоКоллекции");
	КаталогПоиска = ОбъединитьПути(КаталогМодулей, "поиск", "Классы");
	Для Каждого Имя Из СтрРазделить("ВидимостьПулов,СлужбаПоиска", ",") Цикл
		Поиск.Подключить(КаталогПоиска, Имя);
	КонецЦикла;

	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	Для Каждого Имя Из СтрРазделить("СервисВерсий,СервисПроисхождения,СнимокПровенанса,"
		+ "СервисТегов,СоставКаналов,РезолверСпецификации,РезолверВерсий,СравнительВерсий,"
		+ "ОтборВерсийПоПравилу,РежимТега,ПравилоТега,СервисМетокВерсий,РазобраннаяВерсия,"
		+ "ЗаполнениеПула,ПравилаИменования,АдресаСтраниц", ",") Цикл
		Поиск.Подключить(КаталогРеестра, Имя);
	КонецЦикла;

	// чтения для страниц идут снимками: объекты из снимков и сам снимок каналов — таблицы реестра;
	// теги пакета сливаются с тегами пула, которых у пакета замера нет
	Для Каждого Имя Из СтрРазделить("СнимкиКаналов,Тег,ВерсияПакета,ТегПула,НаследованиеТегов,"
		+ "НастройкаТеговПула,ПроисхождениеТега", ",") Цикл
		Поиск.Подключить(КаталогРеестра, Имя);
	КонецЦикла;
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "данные", "Классы"), "ФормаСнимка");

	Для Каждого Имя Из СтрРазделить("КонтроллерПакета,КарточкаСсылкиПакета,ВкладкаВерсий,КомандыOpm,ПодсказкаУстановки,"
		+ "КонтроллерЛендинга,Брендирование,СводкаДелВошедшего,ВитринаУведомлений,"
		+ "ВитринаУчастниковГруппы,ОтветыНастроек,СборкаДомаНастроек", ",") Цикл
		Поиск.Подключить(КаталогИнтерфейса, Имя);
	КонецЦикла;
	// поток «пул» Х4а: окно «Добавить участника» берёт имена полей у пульта дома группы
	Поиск.Подключить(КаталогИнтерфейса, "ПультДомаГруппы");

	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "публикация", "Классы"), "СервисРезервированияИмён");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "АдресИнстанса");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "СборщикКарточкиПакета");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "СборщикСрезаИзменений");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "СборщикГрантов");

	Поиск.ПодключитьОснову(КаталогМодулей);
	КаталогПрав = ОбъединитьПути(КаталогМодулей, "права", "Классы");
	Для Каждого Имя Из СтрРазделить("СервисПрав,СервисГрупп,ГвардДоступаКПулу,УчёткаПринципала,"
		+ "ВердиктГварда,ВидимостьОбъектовПрав", ",") Цикл
		Поиск.Подключить(КаталогПрав, Имя);
	КонецЦикла;
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ДопускПринципала");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ДопускЗапросаКПулу");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "уведомления", "Классы"), "ЛентаУведомлений");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "публикация", "Классы"), "РассмотрениеВходящих");

	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "фоновыеЗадания", "Классы"), "ЗапускВФонеЗаданием");
	КаталогСтатистики = ОбъединитьПути(КаталогМодулей, "статистика", "Классы");
	Для Каждого Имя Из СтрРазделить("СчётчикСкачиванийВПамяти,НазначениеСброса,СлужбаСтатистикиСкачиваний",
		",") Цикл
		Поиск.Подключить(КаталогСтатистики, Имя);
	КонецЦикла;

	// поток «права»: таблица прав раздела пула и пакета на настоящих службах доступа
	Для Каждого Имя Из СтрРазделить("ТаблицаПрав,ФормаВыдачиРоли,ВитринаВыдачиРоли", ",") Цикл
		Поиск.Подключить(КаталогИнтерфейса, Имя);
	КонецЦикла;
	Поиск.Подключить(КаталогПрав, "СервисПравДоступа");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "СубъектыПрав");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "кабинет", "Классы"), "СлужбаДоступа");
	// поток «пакет» Х4а: раздел «Версии и метки» дома пакета
	Для Каждого Имя Из СтрРазделить("ВитринаВерсийПакета,ПультВерсийПакета", ",") Цикл
		Поиск.Подключить(КаталогИнтерфейса, Имя);
	КонецЦикла;

	// новая версия хаба: секция первого раздела дома «Хаб» на настоящей службе выпусков
	Поиск.Подключить(КаталогИнтерфейса, "ВитринаСведенийХаба");
	КаталогВыпусков = ОбъединитьПути(КаталогМодулей, "состояние", "Классы", "выпуски");
	Для Каждого Имя Из СтрРазделить("ВыпускиХаба,ИсточникВыпусков,НовизнаВыпуска", ",") Цикл
		Поиск.Подключить(КаталогВыпусков, Имя);
	КонецЦикла;
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	РеестрФикстур.Подключить("СчитающееХранилищеОтметокВыпуска");
	РеестрФикстур.Подключить("ФейкТранспортHTTP");
	РеестрФикстур.Подключить("ОписаниеПриложенияЗаглушка");

	// сессия на странице вошедшего: настоящий страж запроса, сессия и защита CSRF
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СчитающаяСлужбаСессий");
	Для Каждого Имя Из СтрРазделить("СессияХаба,ПерехватчикАутентификации,ЗащитаCSRF", ",") Цикл
		Поиск.Подключить(КаталогВхода, Имя);
	КонецЦикла;

КонецПроцедуры

#Область НоваяВерсияХаба

// Новая версия хаба на первом разделе дома «Хаб» стоит одно чтение отметки последней проверки
// и ни одного похода к источнику выпусков: экран говорит то, что узнала задача, а сам не спрашивает.
&Тест
Процедура ЦенаНовойВерсииХабаОдноЧтениеОтметкиБезСети() Экспорт

	Отметки = Новый СчитающееХранилищеОтметокВыпуска();
	Отметки.Записать(Новый Структура("Последняя, Проверено, Ошибка, Объявлена", "0.21.0",
		ТекущаяУниверсальнаяДата(), "", "0.21.0"));
	Транспорт = Новый ФейкТранспортHTTP();
	Приложение = Новый ОписаниеПриложенияЗаглушка("0.20.6");
	Выпуски = Новый ВыпускиХаба(Новый ИсточникВыпусков(Транспорт, Новый ТаймаутыHTTP()), Новый НовизнаВыпуска(),
		Отметки, Новый НастройкиЗаглушка(), Приложение, Новый ИздательСобытий());
	Сведения = Новый ВитринаСведенийХаба(UI.Кит, Приложение, Неопределено, Неопределено, Неопределено,
		Неопределено, UI.Тексты, Выпуски);

	Разметка = РазметкаСекции(Сведения.СекцияНовойВерсии());

	Ожидаем.Что(Отметки.Обращений(), "отметка прочитана один раз").Равно(1);
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "к источнику выпусков экран не ходит").Равно(0);
	// цена не мерит пустую работу: секция напечатана и называет обе версии
	Ожидаем.Что(Разметка, "вышедшая версия").Содержит(">0.21.0<");
	Ожидаем.Что(Разметка, "своя версия").Содержит(">0.20.6<");

КонецПроцедуры

#КонецОбласти

#Область РазделПодписок

// Раздел подписок пула и «Подписки сверху» пакета спрашивают домен разом на страницу: поправки,
// сводки исключений, пакеты, снятые поправками, имена сузивших и теги отбора — по чтению на дверь.
// Двадцать подписок стоят столько же обращений, сколько две, а прочитанных строк — на подписку
// поровну: строк растёт линейно, без квадрата «каждая запись перечитывает список».
&Тест
Процедура ЦенаРазделаПодписокНеРастётСЧисломПодписок() Экспорт

	НаДвух = ЦенаРазделаПодписок(2);
	НаОдиннадцати = ЦенаРазделаПодписок(11);
	НаДвадцати = ЦенаРазделаПодписок(20);

	Ожидаем.Что(НаДвадцати.Своих, СтрШаблон("свои: двадцать подписок стоят столько же обращений, сколько две: %1 против %2",
		НаДвадцати.Своих, НаДвух.Своих)).Равно(НаДвух.Своих);
	Ожидаем.Что(НаДвадцати.Сверху, СтрШаблон("сверху: двадцать подписок стоят столько же обращений, сколько две: %1 против %2",
		НаДвадцати.Сверху, НаДвух.Сверху)).Равно(НаДвух.Сверху);
	Ожидаем.Что(НаДвадцати.СтрокСвоих - НаОдиннадцати.СтрокСвоих, "свои: строк на подписку поровну")
		.Равно(НаОдиннадцати.СтрокСвоих - НаДвух.СтрокСвоих);
	Ожидаем.Что(НаДвадцати.СтрокСверху - НаОдиннадцати.СтрокСверху, "сверху: строк на подписку поровну")
		.Равно(НаОдиннадцати.СтрокСверху - НаДвух.СтрокСверху);

	// счётчик не мерит пустую работу: записи нарисованы, сужение и исключения названы
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Своя, "/toggle"""), "двадцать записей своих").Равно(20);
	Ожидаем.Что(НаДвадцати.Своя, "кто сузил — пакет по имени").Содержит("web");
	Ожидаем.Что(НаДвадцати.Своя, "кому сообщает — выбор без снятого пакета").Содержит("выбранные: 1 из 2");
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Сверху_, "inherited/"), "КОНТРОЛЬ: записи сверху с меню").Больше(19);

КонецПроцедуры

// «Подписки сверху» у пула — подписки хаба с поправками пула и исключёнными пакетами — тоже читаются
// разом: двадцать подписок хаба стоят столько же обращений, сколько две, строк — поровну на подписку.
&Тест
Процедура ЦенаПодписокСверхуУПулаНеРастётСЧисломПодписок() Экспорт

	НаДвух = ЦенаПодписокСверхуУПула(2);
	НаОдиннадцати = ЦенаПодписокСверхуУПула(11);
	НаДвадцати = ЦенаПодписокСверхуУПула(20);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"сверху у пула: двадцать подписок хаба стоят столько же обращений, сколько две: %1 против %2",
		НаДвадцати.Обращений, НаДвух.Обращений)).Равно(НаДвух.Обращений);
	Ожидаем.Что(НаДвадцати.Строк - НаОдиннадцати.Строк, "сверху у пула: строк на подписку поровну")
		.Равно(НаОдиннадцати.Строк - НаДвух.Строк);

	// счётчик не мерит пустую работу: записи сверху нарисованы с меню поправки
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "inherited/"), "КОНТРОЛЬ: записи сверху с меню").Больше(19);

КонецПроцедуры

Функция ЦенаПодписокСверхуУПула(Знач Число)

	Мир = Новый МирРазделаПодписок(Новый КлассыСлоя(), КаталогМодулей, UI);
	Хаб = Мир.Сервис.ОбъектХаба();
	Пул = Мир.ОбъектПула(7);
	Узлы = Новый Массив();
	Узлы.Добавить(Мир.Исключения.Узел("пакет", 43));
	Для Номер = 1 По Число Цикл
		// у подписки хаба отбора по тегам нет — её сужают снизу
		Подписка = Мир.Сервис.СоздатьПодписку(Мир.Админ(), Хаб, "вебхук",
			Новый Структура("URL, Секрет", "https://hook.example.com/hub-" + Формат(Номер, "ЧГ=0"), ""),
			"версия.опубликована,версия.отозвана", Неопределено,
			Новый Структура("СужениеРазрешено, ОтборТегов", Истина, Новый Массив()));
		Мир.Исключения.Отметить(Мир.Админ(), Хаб, Подписка.Идентификатор, Узлы, Новый Массив());
		Мир.Поправки.Поставить(Мир.Админ(), Пул, Подписка.Идентификатор,
			Новый Структура("ОставленныеСобытия", "версия.опубликована"));
	КонецЦикла;

	Сверху = Мир.Стенд.Параметры("пул");
	Сверху.Объект = Пул;
	Сверху.Зритель = Мир.Админ();
	Мир.Обнулить();
	Итог = Новый Структура();
	Итог.Вставить("Разметка", Мир.Стенд.РазделСверху(Сверху));
	Итог.Вставить("Обращений", Мир.Обращений());
	Итог.Вставить("Строк", Мир.Строк());
	Возврат Итог;

КонецФункции

Функция ЦенаРазделаПодписок(Знач Число)

	Мир = Новый МирРазделаПодписок(Новый КлассыСлоя(), КаталогМодулей, UI);
	Пул = Мир.ОбъектПула(7);
	Пакет = Мир.ОбъектПакета(42, 7);
	Узлы = Новый Массив();
	Узлы.Добавить(Мир.Исключения.Узел("пакет", 43));
	Для Номер = 1 По Число Цикл
		Подписка = Мир.Подписка(Пул);
		Мир.Исключения.Отметить(Мир.Админ(), Пул, Подписка.Идентификатор, Узлы, Новый Массив());
		Мир.Поправки.Поставить(Мир.Админ(), Пакет, Подписка.Идентификатор,
			Новый Структура("ОставленныеСобытия", "версия.опубликована"));
	КонецЦикла;

	Своих = Мир.Стенд.Параметры("пул");
	Своих.Объект = Пул;
	Своих.Зритель = Мир.Админ();
	Мир.Обнулить();
	Итог = Новый Структура();
	Итог.Вставить("Своя", Мир.Стенд.Раздел(Своих));
	Итог.Вставить("Своих", Мир.Обращений());
	Итог.Вставить("СтрокСвоих", Мир.Строк());

	Сверху = Мир.Стенд.Параметры("пакет");
	Сверху.Объект = Пакет;
	Сверху.Зритель = Мир.Админ();
	Мир.Обнулить();
	Итог.Вставить("Сверху_", Мир.Стенд.РазделСверху(Сверху));
	Итог.Вставить("Сверху", Мир.Обращений());
	Итог.Вставить("СтрокСверху", Мир.Строк());
	Возврат Итог;

КонецФункции

// Окно «Получатели» подписки хаба и запись с плашками отметок спрашивают домен разом: пулы, пакеты
// всех пулов, исключения и выбор — по чтению на дверь, сколько бы пулов и пакетов ни было на
// странице; прочитанных строк растёт линейно. Двенадцать пулов по двадцать пакетов стоят столько
// же обращений, сколько два пула по три.
&Тест
Процедура ЦенаОкнаПолучателейНеРастётСЧисломПуловИПакетов() Экспорт

	Малое = ЦенаОкнаПолучателей(2, 3);
	Среднее = ЦенаОкнаПолучателей(7, 10);
	Большое = ЦенаОкнаПолучателей(12, 20);

	Ожидаем.Что(Большое.Окна, СтрШаблон("окно: двенадцать пулов стоят столько же обращений, сколько два: %1 против %2",
		Большое.Окна, Малое.Окна)).Равно(Малое.Окна);
	Ожидаем.Что(Большое.Записи, СтрШаблон("запись: столько же обращений: %1 против %2", Большое.Записи, Малое.Записи))
		.Равно(Малое.Записи);
	Ожидаем.Что(Большое.Строк >= Среднее.Строк И Среднее.Строк >= Малое.Строк, "строк не меньше с ростом мира")
		.ЭтоИстина();
	Ожидаем.Что(Большое.Строк <= Малое.Строк * 40, СтрШаблон("строк растёт линейно, без квадрата: %1 против %2",
		Большое.Строк, Малое.Строк)).ЭтоИстина();

	// счётчик не мерит пустую работу: окно и плашки нарисованы
	Ожидаем.Что(СтрЧислоВхождений(Большое.Окно, "data-checktree-modes="), "двенадцать пулов строками и два пула мира")
		.Равно(14);
	Ожидаем.Что(Большое.Запись, "плашки отметок в записи — тихими формами кита").Содержит("class=""tag-form""");

КонецПроцедуры

Функция ЦенаОкнаПолучателей(Знач Пулов, Знач ПакетовВПуле)

	Мир = Новый МирРазделаПодписок(Новый КлассыСлоя(), КаталогМодулей, UI);
	Для НомерПула = 1 По Пулов Цикл
		ПулИд = 100 + НомерПула;
		Мир.Пулы.ДобавитьПул(ПулИд, "pool-" + Формат(НомерПула, "ЧГ=0"));
		Для НомерПакета = 1 По ПакетовВПуле Цикл
			Мир.Пакеты.ДобавитьПакет(ПулИд * 1000 + НомерПакета, ПулИд, "pkg-" + Формат(НомерПакета, "ЧГ=0"));
		КонецЦикла;
	КонецЦикла;
	Объект = Мир.Сервис.ОбъектХаба();
	Подписка = Мир.ПодпискаБезОтбора(Объект);
	Узлы = Новый Массив();
	Узлы.Добавить(Мир.Исключения.Узел("пакет", 101001));
	Узлы.Добавить(Мир.Исключения.Узел("пул", 102));
	Мир.Исключения.Отметить(Мир.Админ(), Объект, Подписка.Идентификатор, Узлы, Новый Массив());
	Режимы = Новый Соответствие();
	Режимы.Вставить(100 + Пулов, "выбранные");
	Мир.Исключения.Применить(Мир.Админ(), Объект, Подписка.Идентификатор, Режимы, Новый Массив(), Новый Массив());

	Ключ = Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
	Параметры = Мир.Стенд.Параметры("хаб", Мир.Стенд.Окна.Открытое("получатели", Ключ), 0);
	Параметры.Объект = Объект;
	Параметры.Зритель = Мир.Админ();
	Мир.Обнулить();
	Итог = Новый Структура();
	Итог.Вставить("Окно", Мир.Стенд.Раздел(Параметры));
	Итог.Вставить("Окна", Мир.Обращений());
	Итог.Вставить("Строк", Мир.Строк());

	Параметры.Окно = Неопределено;
	Мир.Обнулить();
	Итог.Вставить("Запись", Мир.Стенд.Раздел(Параметры));
	Итог.Вставить("Записи", Мир.Обращений());
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ТокеныКабинета

// Список ключей кабинета стоит трёх обращений к базе — список, наборы пулов, имена
// пулов — и столько же на двадцати ключах: «набор пулов ключа» и «имя пула привязки»
// спрашиваются разом на весь экран, а не на строку.
&Тест
Процедура ЦенаСпискаТокеновНеРастётСЧисломТокенов() Экспорт

	НаДвух = ЦенаЭкранаТокенов(2);
	НаДвадцати = ЦенаЭкранаТокенов(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать ключей стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Токены, "список ключей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Привязки, "наборы пулов всех ключей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Пулы, "имена пулов — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: записи нарисованы и имена пулов в них есть —
	// плашкой свёрнутой записи и свойством раскрытой
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "пулы альфа, бета"),
		"в каждой из двадцати записей названы оба пула ключа").Равно(40);

	// запись старого ключа приезжает тем же разрезом: рамку из колонки записи экран
	// называет пулом, а не «весь хаб»
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "пулы гамма"),
		"старый ключ с одиночной привязкой назван своим пулом").Равно(2);

КонецПроцедуры

// Окно «Новый токен» стоит на каждой странице раздела: его разметка не растёт с числом видимых
// пулов — на окне первые двадцать и строка усечения, остальное находит поиск.
&Тест
Процедура ОкноВыпускаНеРастётСЧисломПулов() Экспорт

	НаТридцати = РазметкаОкнаВыпуска(30);
	НаТрёхстах = РазметкаОкнаВыпуска(300);

	Ожидаем.Что(СтрЧислоВхождений(НаТрёхстах, "data-checktree-box"), "на трёхстах пулах галок столько же")
		.Равно(СтрЧислоВхождений(НаТридцати, "data-checktree-box"));
	Ожидаем.Что(СтрЧислоВхождений(НаТрёхстах, "data-checktree-box"), "двадцать галок").Равно(20);
	Ожидаем.Что(СтрНайти(НаТрёхстах, "Показаны 20 пулов из 300") > 0, "строка усечения названа числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НаТридцати, "Показаны 20 пулов из 30") > 0, "и на тридцати").ЭтоИстина();

КонецПроцедуры

Функция РазметкаОкнаВыпуска(Знач ЧислоПулов)

	Пулы = Новый ФейкСервисПулов();
	Видимые = Новый Массив();
	Для Номер = 1 По ЧислоПулов Цикл
		Видимые.Добавить(Новый Структура("Идентификатор, Имя, Видимость", Номер,
			"пул-" + Формат(Номер, "ЧЦ=4; ЧВН=; ЧГ=0"), "public"));
	КонецЦикла;

	Токены = Новый СервисТокенов(Новый СчитающееХранилищеТокенов(), НастройкиТокенов(),
		Новый СчитающееХранилищеПривязок(), Новый СверкаСекретов());
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), Неопределено);
	Витрина = Новый ВитринаТокеновКабинета(UI.Кит, Токены, Пулы, Новый ГейтТокена(Токены), Окна,
		ОкноВыпуска(Пулы, Окна), UI.Тексты);

	Дом = UI.Кит.ДомНастроек("Аккаунт", "/me/settings", "csrf-токен",
		Витрина.Секции(ПараметрыРаздела(Видимые))[0]);
	Дом.Раздел("Токены доступа", "tokens").Текущий();
	Разметка = Дом.Рендер();
	Возврат Сред(Разметка, СтрНайти(Разметка, "id=""token-novyi"""));

КонецФункции

Функция ЦенаЭкранаТокенов(Знач ЧислоТокенов)

	Хранилище = Новый СчитающееХранилищеТокенов();
	Привязки = Новый СчитающееХранилищеПривязок();

	Пулы = Новый ФейкСервисПулов();
	Пулы.ДобавитьПул(1, "альфа");
	Пулы.ДобавитьПул(2, "бета");
	Пулы.ДобавитьПул(3, "гамма");

	Для Номер = 1 По ЧислоТокенов Цикл
		Хранилище.Добавить(Номер, ВладелецКлючей(), СтрШаблон("ключ %1", Формат(Номер, "ЧГ=0")));
		Привязки.Записать(Номер, 1);
		Привязки.Записать(Номер, 2);
	КонецЦикла;

	// ключ, выпущенный до появления набора: рамка колонкой записи, строк привязок нет
	Хранилище.Добавить(НомерСтарогоКлюча(), ВладелецКлючей(), "старый ключ", 3);

	Токены = Новый СервисТокенов(Хранилище, НастройкиТокенов(), Привязки, Новый СверкаСекретов());
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), Неопределено);
	Витрина = Новый ВитринаТокеновКабинета(UI.Кит, Токены, Пулы, Новый ГейтТокена(Токены), Окна,
		ОкноВыпуска(Пулы, Окна), UI.Тексты);

	// формы окон берут адрес и токен у дома вокруг
	Дом = UI.Кит.ДомНастроек("Аккаунт", "/me/settings", "csrf-токен", Витрина.Секции(ПараметрыРаздела())[0]);
	Дом.Раздел("Токены доступа", "tokens").Текущий();
	Разметка = Дом.Рендер();

	Итог = Новый Структура();
	Итог.Вставить("Токены", Хранилище.Обращений());
	Итог.Вставить("Привязки", Привязки.Обращений());
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Всего", Хранилище.Обращений() + Привязки.Обращений() + Пулы.Обращений());
	Итог.Вставить("Разметка", Разметка);
	Возврат Итог;

КонецФункции

Функция НастройкиТокенов()

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.token.max_days", 90);
	Настройки.Задать("oshub.auth.token.cli_days", 30);
	Возврат Настройки;

КонецФункции

Функция ОкноВыпуска(Знач Пулы, Знач Окна)
	Возврат Новый ОкноВыпускаТокена(UI.Кит, Окна, Новый ПлашкиПула(Пулы, Пулы, UI.Тексты, UI.ЗначкиМеты),
		UI.Тексты);
КонецФункции

Функция ВладелецКлючей()
	Возврат 7;
КонецФункции

// Номер заведомо больше любого номера современных ключей набора: строки не пересекаются.
Функция НомерСтарогоКлюча()
	Возврат 100;
КонецФункции

// Раздел без открытого окна: реестр ключей владельца и закрытое окно выпуска.
Функция ПараметрыРаздела(Знач Видимые = Неопределено)

	Заявка = Новый Структура("Имя, Чтение, Запись, Где, Пулы, Срок, Поиск, Найденные",
		"", Истина, Истина, "хаб", Новый Массив(), "30", "", "");
	Выпуск = Новый Структура("Состояние, Открыто, Адрес, Заявка, Пулы, Найдено, АдресПоиска, Срок",
		Неопределено, Ложь, "/me/settings/tokens?окно=новый", Заявка,
		?(Видимые = Неопределено, Новый Массив(), Видимые), Неопределено,
		"/me/settings/tokens/pools", 90);

	Возврат Новый Структура("Адрес, Пользователь, Окно, Выпуск, Секрет", "/me/settings/tokens",
		Новый Структура("Идентификатор", ВладелецКлючей()), Неопределено, Выпуск, "");

КонецФункции

#КонецОбласти

#Область УчёткиХаба

// Список учёток дома «Хаб» стоит двух обращений — список и внешние личности всего
// списка — и столько же на двадцати учётках: «есть ли чем войти» спрашивается разом,
// а не на строку.
&Тест
Процедура ЦенаСпискаУчётокНеРастётСЧисломУчёток() Экспорт

	НаДвух = ЦенаЭкранаУчёток(2);
	НаДвадцати = ЦенаЭкранаУчёток(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать учёток стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Учётки, "список учёток — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Личности, "внешние личности всего списка — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: строки нарисованы, и ответ «чем войти»
	// в них РАЗНЫЙ — половина учёток без пароля и без личности
	// «нечем войти» — ещё и вариант отбора по статусу, поэтому считаются плашки её вида
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "tag--warn"),
		"плашка стоит ровно у учёток без пароля и без личности").Равно(10);

КонецПроцедуры

Функция ЦенаЭкранаУчёток(Знач ЧислоУчёток)

	Учётки = Новый СчитающееХранилищеУчёток();
	Личности = Новый СчитающееХранилищеЛичностей();

	Для Номер = 1 По ЧислоУчёток Цикл
		Учётки.Добавить(Номер, СтрШаблон("user%1", Формат(Номер, "ЧГ=0")));
		// личность у каждой второй: ответ «есть чем войти» обязан быть разным по строкам
		Если Номер % 2 = 0 Тогда
			Личности.Привязать(Номер);
		КонецЕсли;
	КонецЦикла;

	Активность = Новый СервисАктивностиУчёток(Личности, Новый ФейкСервисПрав(),
		Новый ПолитикаПарольногоВхода(НастройкиВхода()), Неопределено);
	Список = Новый СписокУчёток(Учётки, Активность, Новый ПоискПоКоллекции());

	Роли = Новый СервисПользователейЗаглушка();
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(Новый ПараметрыСсылки()),
		Новый Подтверждение(UI.Набор, UI.Тексты, Новый Окно(UI.Экран, UI.Набор, UI.Тексты)));
	Отборы = Новый ОтборЛюдей(UI.Кит, Новый ПараметрыСсылки(), Новый ПриведениеЧисел(), Новый РазборФормы(), Роли);
	Витрина = Новый ВитринаУчёток(UI.Кит, Список, Новый ФейкСервисПрав(), Роли, Окна,
		Новый ОкноУчётки(UI.Кит, Окна, Отборы, Роли, UI.Тексты), Отборы, UI.Тексты);

	Адрес = "/hub/settings/users";
	Секции = Витрина.Секции(Новый Структура("Адрес, Смотрящий, Отбор, Окно",
		Адрес, Смотрящий(), Отборы.ИзАдреса(""), Неопределено));
	// формы строк берут адрес и токен у дома, как на настоящей странице
	Дом = UI.Кит.ДомНастроек("Настройки хаба", Адрес, "csrf-токен", Секции[0]);

	Итог = Новый Структура();
	Итог.Вставить("Учётки", Учётки.Обращений());
	Итог.Вставить("Личности", Личности.Обращений());
	Итог.Вставить("Всего", Учётки.Обращений() + Личности.Обращений());
	Итог.Вставить("Разметка", Дом.Рендер());
	Возврат Итог;

КонецФункции

Функция НастройкиВхода()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.password.enabled", Истина);
	Возврат Настройки;
КонецФункции

// Смотрящий чужой всем учёткам: строки действий не получает ни одна, число строк от него не зависит.
Функция Смотрящий()
	Возврат Новый Структура("Идентификатор, Логин, Админ", 0, "root", Истина);
КонецФункции

#КонецОбласти

#Область ПулыХаба

// Таблица пулов хаба и группа личных пространств читают пулы, занятое место, число пакетов
// и владельцев по разу на обе страницы: двадцать строк стоят столько же, сколько две.
&Тест
Процедура ЦенаТаблицыПуловНеРастётСЧисломПулов() Экспорт

	НаДвух = ЦенаТаблицыПулов(2);
	НаДвадцати = ЦенаТаблицыПулов(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать пулов стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);
	Ожидаем.Что(НаДвадцати.Пулы, "пулы — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Занято, "занятое место — одно").Равно(1);
	Ожидаем.Что(НаДвадцати.Пакеты, "число пакетов — одно").Равно(1);
	Ожидаем.Что(НаДвадцати.Учётки, "владельцы — одно").Равно(1);

	// счётчик не мерит пустую работу: строки нарисованы, у каждой свой владелец
	Ожидаем.Что(НаДвадцати.Разметка, "последний владелец на странице").Содержит(">owner20<");
	Ожидаем.Что(НаДвадцати.Разметка, "группа личных пространств нарисована той же ценой")
		.Содержит("id=""lichnye-prostranstva""");
	Ожидаем.Что(ГруппаЛичныхПространств(НаДвадцати.Разметка), "и в ней личное пространство")
		.Содержит(">pool018<");
	Ожидаем.Что(НаДвадцати.Разметка, "унаследованный предел назван").Содержит("квота хаба");

КонецПроцедуры

// Строка поиска группы личных пространств появляется, только когда их больше страницы: шесть
// личных из двадцати пулов видны и так, двадцать три из семидесяти — уже нет.
&Тест
Процедура ПоискГруппыЛичныхТолькоКогдаИхБольшеСтраницы() Экспорт

	Мало = ЦенаТаблицыПулов(20).Разметка;
	Много = ЦенаТаблицыПулов(70).Разметка;

	Ожидаем.Что(Мало, "КОНТРОЛЬ: группа личных на странице").Содержит("id=""lichnye-prostranstva""");
	Ожидаем.Что(СтрНайти(Мало, "name=""pq"""), "шесть личных — поиска по группе нет").Равно(0);
	Ожидаем.Что(Много, "двадцать три личных — поиск по группе есть").Содержит("name=""pq""");

КонецПроцедуры

Функция ГруппаЛичныхПространств(Знач Разметка)
	Позиция = СтрНайти(Разметка, "id=""lichnye-prostranstva""");
	Возврат ?(Позиция = 0, "", Сред(Разметка, Позиция));
КонецФункции

Функция ЦенаТаблицыПулов(Знач ЧислоПулов)

	Окружение = Новый ОкружениеПуловХаба();
	Для Номер = 1 По ЧислоПулов Цикл
		Окружение.Завести(Номер);
	КонецЦикла;

	Ссылки = Новый ПараметрыСсылки();
	Окна = Новый ОкноРаздела(Ссылки, Новый ОтметкаСохранения(Ссылки),
		Новый Подтверждение(UI.Набор, UI.Тексты, Новый Окно(UI.Экран, UI.Набор, UI.Тексты)));
	Отборы = Новый ОтборПулов(UI.Кит, Ссылки, Новый ПриведениеЧисел(), Новый РазборФормы());
	Окно = Новый ОкноПула(UI.Кит, Окна, Отборы, Новый ПравилаИменования(), Окружение, UI.Тексты);
	ДомПула = Новый ДомПула(Новый СборкаДомаНастроек(UI.Кит, UI.Модели), UI.Тексты, Новый АдресаСтраниц(),
		Новый АдресаКаталога(Ссылки));
	Витрина = Новый ВитринаПулов(UI.Кит, Окружение, Окружение, Окружение, Неопределено,
		Новый ПлашкиПула(Окружение, Неопределено, UI.Тексты, UI.ЗначкиМеты), Новый ЗаполнениеПула(),
		Новый ОбъёмТекстом(), ДомПула, Окна, Окно, Отборы, Ссылки, UI.Тексты);

	Адрес = "/hub/settings/pools";
	Секции = Витрина.Секции(Новый Структура("Адрес, Отбор, Окно", Адрес, Отборы.ИзАдреса(""), Неопределено));
	Разметка = "";
	Для Каждого Секция Из Секции Цикл
		Разметка = Разметка + UI.Кит.ДомНастроек("Настройки хаба", Адрес, "csrf-токен", Секция).Рендер();
	КонецЦикла;

	Итог = Новый Структура();
	Итог.Вставить("Разметка", Разметка);
	Итог.Вставить("Пулы", Окружение.Обращений("ВсеПулы"));
	Итог.Вставить("Занято", Окружение.Обращений("ЗанятоПулами"));
	Итог.Вставить("Пакеты", Окружение.Обращений("Пакеты"));
	Итог.Вставить("Учётки", Окружение.Обращений("Учётки"));
	Итог.Вставить("Всего", Окружение.Всего());
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область МоиПакетыКабинета

// Блок «Мои пакеты» читает столько, сколько нужно шести карточкам: порядок — из отметки пакета,
// версии и счётчики — только у показанных, и восемь пакетов в управлении стоят столько же, сколько
// сорок. Числа — цена на SQL-бэкенде: двойники хранилищ отдают готовую сумму, как база.
&Тест
Процедура ЦенаБлокаМоихПакетовНеРастётСЧисломПакетов() Экспорт

	Малый = ЦенаБлокаМоихПакетов(8, 30);
	Большой = ЦенаБлокаМоихПакетов(40, 30);

	Ожидаем.Что(Большой.Всего, СтрШаблон(
		"сорок пакетов стоят столько же строк, сколько восемь: %1 против %2",
		Формат(Большой.Всего, "ЧГ=0"), Формат(Малый.Всего, "ЧГ=0"))).Равно(Малый.Всего);

	Ожидаем.Что(Большой.СтрокВерсий, "версии спрошены только у показанных пакетов")
		.Равно(6 * 30);
	Ожидаем.Что(Большой.СтрокАгрегатов,
		"суточных строк счётчиков не поднято ни одной: сумму отдала база")
		.Равно(0);

	// счётчик не должен мерить пустую работу: шесть карточек нарисованы, версии в них есть
	Ожидаем.Что(СтрЧислоВхождений(Большой.Разметка, "visually-hidden"">версия: "),
		"в блоке ровно шесть карточек, и у каждой есть версия").Равно(6);
	Ожидаем.Что(СтрНайти(Большой.Разметка, "пакет-40") > 0,
		"первым стоит пакет со свежайшей публикацией: " + Большой.Разметка).ЭтоИстина();

КонецПроцедуры

// Пакет без единой публикации версий не имеет и в горстку идёт последним — но только
// пока в ней есть место: пустая отметка последней публикации обязана уводить пакет вниз,
// а не наверх, и версия у него не печатается вовсе.
&Тест
Процедура НеизданныйПакетСтоитНижеИзданногоИБезВерсии() Экспорт

	Цена = ЦенаБлокаМоихПакетов(2, 3);

	Ожидаем.Что(СтрНайти(Цена.Разметка, "пакет-2") < СтрНайти(Цена.Разметка, "пакет-без-версий"),
		"изданное стоит выше неизданного: " + Цена.Разметка).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Цена.Разметка, "visually-hidden"">версия: "),
		"версия печатается только у изданных пакетов").Равно(2);

КонецПроцедуры

// Один пакет фактуры без публикаций: без него пропажа хвоста «неизданное по имени» не видна.
Функция ЦенаБлокаМоихПакетов(Знач ЧислоПакетов, Знач ВерсийНаПакет)

	Публикации = Новый ЗамерХранилищаВерсий();
	Агрегаты = Новый СчитающееХранилищеАгрегатов();

	Сейчас = ТекущаяУниверсальнаяДата();
	Пакеты = Новый Массив();

	Для Номер = 1 По ЧислоПакетов Цикл

		// чем больше номер, тем свежее последняя публикация: последний пакет встаёт первым
		Свежесть = Сейчас - (ЧислоПакетов - Номер) * 86400;
		Пакеты.Добавить(ЗаписьУправления(Номер, СтрШаблон("пакет-%1", Формат(Номер, "ЧГ=0")),
			Свежесть));
		Агрегаты.Добавить(Номер, Номер * 10);

		Для Выпуск = 1 По ВерсийНаПакет Цикл
			Публикации.ДобавитьПубликацию(Номер, СтрШаблон("1.%1.%2", Формат(Номер, "ЧГ=0"),
				Формат(Выпуск, "ЧГ=0")), Свежесть - ВерсийНаПакет + Выпуск);
		КонецЦикла;

	КонецЦикла;

	Пакеты.Добавить(ЗаписьУправления(ЧислоПакетов + 1, "пакет-без-версий", Неопределено));
	Агрегаты.Добавить(ЧислоПакетов + 1, 1);

	Разметка = РазметкаСекции(БлокМоихПакетов(Публикации, Агрегаты).СекцияСводки(Пакеты));

	Итог = Новый Структура();
	Итог.Вставить("СтрокВерсий", Публикации.Строк());
	Итог.Вставить("СтрокАгрегатов", Агрегаты.Строк());
	Итог.Вставить("Всего", Публикации.Строк() + Агрегаты.Строк());
	Итог.Вставить("Разметка", Разметка);
	Возврат Итог;

КонецФункции

Функция БлокМоихПакетов(Знач Публикации, Знач Агрегаты)

	// переменная не «Версии»: это глобальное имя библиотеки semver; хранилище пакетов фейковое —
	// пишущие пути сервиса правят отметку последней публикации
	РеестрВерсий = Новый СервисВерсий(Публикации, Новый ФейкПакетовДляЛетописи(),
		Неопределено, Неопределено, Неопределено);
	Скачивания = Новый СлужбаСтатистикиСкачиваний(Новый СчётчикСкачиванийВПамяти(), Агрегаты,
		Неопределено, Новый НастройкиЗаглушка(), Новый ГотовностьЗаглушка(), Новый ЗапускВФонеЗаданием());
	Витрина = Новый ВитринаПакетов(Новый ПровенансВсёСвоё(), Неопределено, UI.Тексты,
		UI.ЗначкиМеты, Новый АдресаСтраниц(), Новый ФейкОкруженияВитрины());

	Возврат Новый ВитринаМоихПакетов(UI.Кит, Витрина, UI.КарточкаОбъекта,
		РеестрВерсий, Скачивания, UI.АдресаКаталога, UI.Тексты);

КонецФункции

// Секция кабинета — разметкой, какой её печатает дом настроек.
Функция РазметкаСекции(Знач Секция)
	Возврат Секция.Рендер();
КонецФункции

Функция ЗаписьУправления(Знач Идентификатор, Знач Имя, Знач ПоследняяПубликация)

	Пакет = Новый Структура("Идентификатор, ПулИдентификатор, Имя, ИмяНижнийРегистр,"
		+ " Описание, Устарел, Скрыт, ПоследняяПубликация",
		Идентификатор, 1, Имя, НРег(Имя), "", Ложь, Ложь, ПоследняяПубликация);
	Возврат Новый Структура("Пул, Пакет", Новый Структура("Имя", "team"), Пакет);

КонецФункции

#КонецОбласти

#Область ВходящиеЗаявкиКабинета

// Сводка «входящих» ведёт все пулы принципала, и её цена держится числом пулов и заявок
// только до тех пор, пока очередь, пулы, заявители и права спрашиваются разрезами.
// Два пула с двумя заявками и двадцать с двадцатью стоят одинаково.
&Тест
Процедура ЦенаСводкиВходящихНеРастётСЧисломЗаявокИПулов() Экспорт

	НаДвух = ЦенаСводкиВходящих(2);
	НаДвадцати = ЦенаСводкиВходящих(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать заявок в двадцати пулах стоят столько же обращений, сколько две в двух:"
			+ " %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Заявки, "очередь всех пулов — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Манифесты, "манифесты всех строк — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Пулы, "пулы заявок — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Заявители, "заявители всех строк — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Группы, "группы субъекта спрошены один раз на весь обход").Равно(1);

	// счётчик не должен мерить пустую работу: строки собраны и заявители в них названы
	Ожидаем.Что(НаДвадцати.Строк, "показаны все двадцать заявок").Равно(20);
	Ожидаем.Что(НаДвадцати.Заявитель, "заявитель строки назван логином").Равно("заявитель-20");

КонецПроцедуры

Функция ЦенаСводкиВходящих(Знач ЧислоПулов)

	Заявки = Новый СчитающийСервисВходящих();
	Пулы = Новый ФейкСервисПулов();
	Учётки = Новый СчитающийСервисУчёток();
	Гранты = Новый СчитающееХранилищеГрантов();
	Участники = Новый СчитающееХранилищеУчастников();
	Группы = Новый СчитающийСервисГрупп();

	Для Номер = 1 По ЧислоПулов Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧГ=0")));
		Участники.Добавить(Номер, "пользователь", Мейнтейнер().Идентификатор, "мейнтейнер");
		Учётки.Добавить(ЧислоПулов + Номер, СтрШаблон("заявитель-%1", Формат(Номер, "ЧГ=0")));
		Заявки.Добавить(Номер, ЧислоПулов + Номер);
	КонецЦикла;

	Права = Новый СервисПрав(Группы, Участники, Гранты, Неопределено);
	Рассмотрение = Новый РассмотрениеВходящих(Заявки, Неопределено, Пулы, Неопределено,
		Неопределено, Права, Неопределено, Учётки, Неопределено,
		Новый УчёткаПринципала(), ПропускающийДопуск(), Новый АдресаСтраниц());

	Строки = Рассмотрение.ОжидающиеПринципала(
		Новый Структура("Пользователь", Мейнтейнер()));

	Итог = Новый Структура();
	Итог.Вставить("Заявки", Заявки.Обращений());
	Итог.Вставить("Манифесты", Заявки.ОбращенийКМанифестам());
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Заявители", Учётки.Обращений());
	Итог.Вставить("Группы", Группы.Обращений());
	Итог.Вставить("Всего", Заявки.Обращений() + Заявки.ОбращенийКМанифестам() + Пулы.Обращений()
		+ Учётки.Обращений() + Гранты.Обращений() + Участники.Обращений() + Группы.Обращений());
	Итог.Вставить("Строк", Строки.Количество());
	Итог.Вставить("Заявитель", ?(Строки.Количество() = 0, "", Строки[0].Заявитель.Логин));
	Возврат Итог;

КонецФункции

// Не админ хаба: суперправо отвечало бы на любой вопрос о правах, не спрашивая базу.
Функция Мейнтейнер()
	Возврат Новый Структура("Идентификатор, Логин, РольХаба", 7, "мейнтейнер", "user");
КонецФункции

#КонецОбласти

#Область ЛентаКабинета

// Секция ленты в кабинете читает столько строк, сколько покажет, а непрочитанное берёт счётчиком: ни обращения,
// ни прочитанные строки не растут с числом накопленных записей. Числа — цена на SQL-бэкенде:
// двойник ленты отвечает счётчиком, как база.
&Тест
Процедура ЦенаСекцииЛентыНеРастётСЧисломУведомлений() Экспорт

	НаДвух = ЦенаСекцииЛенты(2);
	НаДвадцати = ЦенаСекцииЛенты(20);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"двадцать уведомлений стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Обращений, "ЧГ=0"),
		Формат(НаДвух.Обращений, "ЧГ=0"))).Равно(НаДвух.Обращений);

	Ожидаем.Что(НаДвадцати.Обращений, "окно строк и счёт непрочитанного — два обращения"
		+ " на снимок и ни одного сверх него").Равно(2);
	Ожидаем.Что(НаДвадцати.Строк, СтрШаблон(
		"поднято строк ровно по пределу секции, а не вся лента: %1 против %2",
		Формат(НаДвадцати.Строк, "ЧГ=0"), Формат(НаДвух.Строк, "ЧГ=0"))).Равно(3);

	// счётчик не должен мерить пустую работу: счёт полон, а строк ровно столько, сколько
	// помещается в секцию
	Ожидаем.Что(НаДвадцати.Непрочитано, "счёт называет всё непрочитанное").Равно(20);
	Ожидаем.Что(НаДвадцати.Свежих, "строк ровно по пределу секции").Равно(3);

КонецПроцедуры

Функция ЦенаСекцииЛенты(Знач ЧислоУведомлений)

	Хранилище = Новый СчитающееХранилищеЛенты();
	Для Номер = 1 По ЧислоУведомлений Цикл
		Хранилище.Добавить(АдресатЛенты().Идентификатор);
	КонецЦикла;

	Сводка = Новый ЛентаУведомлений(Хранилище).СводкаНепрочитанного(АдресатЛенты(), 3);

	Итог = Новый Структура();
	Итог.Вставить("Обращений", Хранилище.Обращений());
	Итог.Вставить("Строк", Хранилище.Строк());
	Итог.Вставить("Непрочитано", Сводка.Непрочитано);
	Итог.Вставить("Свежих", Сводка.Свежие.Количество());
	Возврат Итог;

КонецФункции

Функция АдресатЛенты()
	Возврат Новый Структура("Идентификатор, Логин", 7, "адресат");
КонецФункции

#КонецОбласти

#Область ДелаВошедшегоНаСтранице

// Счётчик меню и секции кабинета говорят об одном и том же: непрочитанном ленты
// и очереди заявок. Экран снимает их ОДИН раз на запрос и отдаёт шапке снимком — иначе
// «/me» читал бы ленту дважды, а очередь заявок обходил бы два раза подряд.
&Тест
Процедура ЦенаГлавнойКабинетаОдноЧтениеЛентыИОчереди() Экспорт

	Цена = ЦенаДелВошедшего(Истина);

	Ожидаем.Что(Цена.ЧтенийЛенты, СтрШаблон(
		"страница снимает ленту один раз — окном строк и счётчиком, а не по разу"
			+ " на содержимое и на шапку: %1",
		Формат(Цена.ЧтенийЛенты, "ЧГ=0"))).Равно(2);
	Ожидаем.Что(Цена.ОбходовОчереди, СтрШаблон(
		"и очередь заявок обходит один раз: %1",
		Формат(Цена.ОбходовОчереди, "ЧГ=0"))).Равно(1);

	// счётчик не должен мерить пустую работу: шапка получила снятые числа, а не нули
	Ожидаем.Что(Цена.Счётчик, "в бургере — непрочитанное плюс ждущее решения")
		.Равно(НепрочитанныхВЗамере() + ЗаявокВЗамере());
	Ожидаем.Что(Цена.Непрочитано, "у дела «уведомления» стоит своё число")
		.Равно(НепрочитанныхВЗамере());
	Ожидаем.Что(Цена.НаРешение, "у дела «входящие» — своё").Равно(ЗаявокВЗамере());
	Ожидаем.Что(Цена.Свежих, "снимок принёс секции строки по пределу").Равно(3);
	Ожидаем.Что(Цена.Заявок, "и все строки очереди").Равно(ЗаявокВЗамере());

КонецПроцедуры

// Страница, которой эти числа в содержимом не нужны (каталог, пул, страница пакета),
// снимка не приносит — и шапка считает сама, ровно одним чтением на каждое число.
&Тест
Процедура ЦенаШапкиБезСнимкаОстаётсяОднимЧтением() Экспорт

	Цена = ЦенаДелВошедшего(Ложь);

	Ожидаем.Что(Цена.ЧтенийЛенты, "шапке без снимка нужно одно число — один счётчик").Равно(1);
	Ожидаем.Что(Цена.ОбходовОчереди, "и очередь обходит один раз").Равно(1);

	// счётчик не должен мерить пустую работу: числа те же, что и со снимком
	Ожидаем.Что(Цена.Счётчик, "число в бургере от способа счёта не зависит")
		.Равно(НепрочитанныхВЗамере() + ЗаявокВЗамере());

КонецПроцедуры

// Страница отдаётся настоящей дверью дома (ОтветыНастроек.ОтдатьДом), меню — настоящим
// обрамлением: сторож краснеет и тогда, когда дверь теряет снимок по дороге к шапке.
Функция ЦенаДелВошедшего(Знач СоСнимком)

	ЛентаЧеловека = Новый СчитающееХранилищеЛенты();
	Для Номер = 1 По НепрочитанныхВЗамере() Цикл
		ЛентаЧеловека.Добавить(ВладелецДел().Идентификатор);
	КонецЦикла;

	Очередь = ОчередьЗаявокЗамера();
	Лента = Новый ЛентаУведомлений(ЛентаЧеловека);
	Дела = ?(СоСнимком,
		СводкаДел(Лента, Очередь.Рассмотрение).Снять(ВладелецДел(), Принципал()), Неопределено);

	Меню = МенюДомаАккаунта(ОбрамлениеСДелами(Лента, Очередь), Очередь.Права, Дела);

	Итог = Новый Структура();
	Итог.Вставить("ЧтенийЛенты", ЛентаЧеловека.Обращений());
	Итог.Вставить("ОбходовОчереди", Очередь.Заявки.Обращений());
	Итог.Вставить("Счётчик", Меню.Счётчик);
	Итог.Вставить("Непрочитано", ЧислоДела(Меню, "конверт"));
	Итог.Вставить("НаРешение", ЧислоДела(Меню, "весы"));
	Итог.Вставить("Свежих", ?(Дела = Неопределено, 0, Дела.Свежие.Количество()));
	Итог.Вставить("Заявок", ?(Дела = Неопределено, 0, Дела.Заявки.Количество()));
	Возврат Итог;

КонецФункции

Функция СводкаДел(Знач Лента, Знач Рассмотрение)

	Возврат Новый СводкаДелВошедшего(Лента, Рассмотрение,
		Новый ВитринаУведомлений(UI.Кит, UI.Тексты));

КонецФункции

// Обрамление с лентой и рассмотрением, как в боевом контейнере: без них шапке считать нечем.
Функция ОбрамлениеСДелами(Знач Лента, Знач Очередь)

	Возврат Новый ОбрамлениеХаба(UI.Бренд, UI.Адреса,
		Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), UI.Тексты, UI.АдресаКаталога,
		Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит, UI.Подсветка,
		Лента, Очередь.Рассмотрение, Очередь.Права);

КонецФункции

// Очередь заявок замера: пулы, где смотрящий мейнтейнер, и по заявке в каждом.
Функция ОчередьЗаявокЗамера()

	Заявки = Новый СчитающийСервисВходящих();
	Пулы = Новый ФейкСервисПулов();
	Учётки = Новый СчитающийСервисУчёток();
	Участники = Новый СчитающееХранилищеУчастников();

	Для Номер = 1 По ЗаявокВЗамере() Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧГ=0")));
		Участники.Добавить(Номер, "пользователь", ВладелецДел().Идентификатор, "мейнтейнер");
		Учётки.Добавить(100 + Номер, СтрШаблон("заявитель-%1", Формат(Номер, "ЧГ=0")));
		Заявки.Добавить(Номер, 100 + Номер);
	КонецЦикла;

	Права = Новый СервисПрав(
		Новый СервисГрупп(Новый СчитающееХранилищеГрупп(), Новый СчитающееХранилищеЧленств()),
		Участники, Новый СчитающееХранилищеГрантов(), Неопределено);

	Итог = Новый Структура();
	Итог.Вставить("Заявки", Заявки);
	Итог.Вставить("Права", Права);
	Итог.Вставить("Рассмотрение", Новый РассмотрениеВходящих(Заявки, Неопределено, Пулы,
		Неопределено, Неопределено, Права, Неопределено, Учётки, Неопределено,
		Новый УчёткаПринципала(), ПропускающийДопуск(), Новый АдресаСтраниц()));
	Возврат Итог;

КонецФункции

// Меню страницы кабинета, отданной дверью дома с этим снимком дел.
Функция МенюДомаАккаунта(Знач Обрамление, Знач Права, Знач Дела)

	Каркас = Новый КаркасЗамераШапки(UI.Каркас, Обрамление);
	Ответы = Новый ОтветыНастроек(Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели), Права,
		UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));

	Модель = Новый Структура("Ключ, Заголовок, Разделы, Секции", "account", "Кабинет",
		Новый Массив(), Новый Массив());
	Ответы.ОтдатьДом(Новый ОтветСтраницыЗаглушка(), Модель, Принципал(), Неопределено, 200, "/me",
		Дела);

	Возврат Каркас.МенюХаба();

КонецФункции

Функция ЧислоДела(Знач Меню, Знач ИмяИконки)

	Для Каждого Дело Из Меню.Дела Цикл
		Если Дело.Иконка = ИмяИконки Тогда
			Возврат Дело.Счётчик;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

// Не админ хаба: суперправо открывало бы очередь любого пула, не спрашивая базу.
Функция ВладелецДел()
	Возврат Новый Структура("Идентификатор, Логин, РольХаба", 7, "смотрящий", "user");
КонецФункции

Функция Принципал()
	Возврат Новый Структура("Пользователь", ВладелецДел());
КонецФункции

// Непрочитанного заведомо больше предела секции: снимок обязан нести и счёт, и строки.
Функция НепрочитанныхВЗамере()
	Возврат 12;
КонецФункции

Функция ЗаявокВЗамере()
	Возврат 5;
КонецФункции

#КонецОбласти

#Область ВыдачаГрантовAPI

// GET грантов отдаёт список записей, и у каждой — имя субъекта и имя объекта. Две записи
// и двадцать стоят одного и того же: имена субъектов разрезом, пулы и пакеты — по разрезу
// на вид объекта.
&Тест
Процедура ЦенаВыдачиГрантовJSONНеРастётСЧисломЗаписей() Экспорт

	НаДвух = ЦенаВыдачиГрантовJSON(2);
	НаДвадцати = ЦенаВыдачиГрантовJSON(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать записей стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧН=0; ЧГ=0"), Формат(НаДвух.Всего, "ЧН=0; ЧГ=0")))
		.Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Субъекты, "имена субъектов — одно обращение на выдачу").Равно(1);
	Ожидаем.Что(НаДвадцати.Пулы, "пулы записей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Пакеты, "пакеты записей — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: имена в выдаче РАЗНЫЕ — и у субъектов
	// (человек против группы), и у объектов (свой пул либо свой пакет у каждой строки)
	Ожидаем.Что(НаДвадцати.Записей, "в JSON столько строк, сколько грантов").Равно(20);
	Ожидаем.Что(НаДвадцати.ИмёнСубъектов, "оба субъекта названы своими именами")
		.Равно("alice, team-autumn");
	Ожидаем.Что(НаДвадцати.ИмёнОбъектов, "имя объекта у каждой строки своё").Равно(20);
	Ожидаем.Что(НаДвадцати.ПервыйОбъект, "первая строка названа своим пулом").Равно("пул-1");
	Ожидаем.Что(НаДвадцати.ВторойОбъект, "вторая — своим пакетом").Равно("пакет-2");

КонецПроцедуры

// Записи чередуют пул и пакет, субъекта — человека и группу: потерю вида или типа видно по именам.
Функция ЦенаВыдачиГрантовJSON(Знач ЧислоЗаписей)

	Субъекты = Новый ФейкСубъектыПрав();
	Пулы = Новый ФейкСервисПулов();
	Пакеты = Новый РазрезСервисПакетов();

	Гранты = Новый Массив();
	Для Номер = 1 По ЧислоЗаписей Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧН=0; ЧГ=0")));
		Пакеты.ДобавитьПакет(Номер, Номер, СтрШаблон("пакет-%1", Формат(Номер, "ЧН=0; ЧГ=0")));
		Если Номер % 2 = 1 Тогда
			Гранты.Добавить(ГрантJSONОбразец("пользователь", 17, "пул", Номер));
		Иначе
			Гранты.Добавить(ГрантJSONОбразец("группа", 5, "пакет", Номер));
		КонецЕсли;
	КонецЦикла;

	Сборщик = Новый СборщикГрантов(Субъекты, Новый РольЗаписиЗаглушка(), Пулы, Пакеты);
	Записи = Сборщик.СписокJSON(Гранты);

	Имена = Новый Соответствие();
	Объекты = Новый Соответствие();
	Для Каждого Запись Из Записи Цикл
		Имена.Вставить(Запись["subject"], Истина);
		Объекты.Вставить(Запись["object"], Истина);
	КонецЦикла;

	Итог = Новый Структура();
	Итог.Вставить("Субъекты", Субъекты.Обращений());
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Пакеты", Пакеты.Запросов());
	Итог.Вставить("Всего", Субъекты.Обращений() + Пулы.Обращений() + Пакеты.Запросов());
	Итог.Вставить("Записей", Записи.Количество());
	Итог.Вставить("ИмёнСубъектов", КлючиСтрокой(Имена));
	Итог.Вставить("ИмёнОбъектов", Объекты.Количество());
	Итог.Вставить("ПервыйОбъект", ?(Записи.Количество() = 0, "", Записи[0]["object"]));
	Итог.Вставить("ВторойОбъект", ?(Записи.Количество() < 2, "", Записи[1]["object"]));
	Возврат Итог;

КонецФункции

Функция ГрантJSONОбразец(Знач ТипСубъекта, Знач СубъектИд, Знач ТипОбъекта, Знач ОбъектИд)

	Возврат Новый Структура(
		"ТипСубъекта, СубъектИдентификатор, ТипОбъекта, ОбъектИдентификатор,"
			+ " Создание, Изменение, Удаление, Чтение, КемВыдано, Выдано",
		ТипСубъекта, СубъектИд, ТипОбъекта, ОбъектИд,
		Ложь, Ложь, Ложь, Истина, 1, Дата(2026, 1, 1, 0, 0, 0));

КонецФункции

Функция КлючиСтрокой(Знач Набор)

	Имена = Новый Массив();
	Для Каждого КиЗ Из Набор Цикл
		Имена.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

#КонецОбласти


#Область УчастникиГруппы

// Раздел «Участники» дома группы называет логин КАЖДОГО участника. Два участника
// и двадцать стоят одного и того же: учётки берутся одним разрезом — и участнику, и
// администратору, которому строки несут меню ⚙, а окно «Добавить участника» — кандидатов.
&Тест
Процедура ЦенаСоставаГруппыНеРастётСЧисломУчастников() Экспорт

	Для Каждого МожетПравить Из СтрРазделить("Ложь,Истина", ",") Цикл
		Правка = (МожетПравить = "Истина");
		Кому = ?(Правка, "администратору", "участнику");
		НаДвух = ЦенаСоставаГруппы(2, Правка);
		НаДвадцати = ЦенаСоставаГруппы(20, Правка);

		Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
			"%1 двадцать участников стоят столько же обращений, сколько два: %2 против %3", Кому,
			Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);
		Ожидаем.Что(НаДвадцати.Состав, Кому + ": состав группы — одно обращение").Равно(1);
		Ожидаем.Что(НаДвадцати.Учётки, Кому + ": логины участников — одно обращение").Равно(1);
		Ожидаем.Что(НаДвадцати.Кандидаты, Кому + ": кандидаты окна — не больше одного обращения")
			.Равно(?(Правка, 1, 0));

		// счётчик не должен мерить пустую работу: строки нарисованы, и снесённая учётка
		// по-прежнему называется своим номером, а не пустым местом
		Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, ">участник-"),
			Кому + ": логин назван у каждого живого участника").Равно(19);
		Ожидаем.Что(СтрНайти(НаДвадцати.Разметка, "#404") > 0,
			Кому + ": участник без учётки назван номером").ЭтоИстина();
		Ожидаем.Что(СтрНайти(НаДвадцати.Разметка, "?" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL)
			+ "=" + КодироватьСтроку("убрать-", СпособКодированияСтроки.КодировкаURL)) > 0,
			Кому + ": меню ⚙ строк — только администратору").Равно(Правка);
	КонецЦикла;

КонецПроцедуры

// Последнее членство — снесённой учётки: пустота вместо номера видна разметкой.
Функция ЦенаСоставаГруппы(Знач ЧислоУчастников, Знач МожетПравить)

	Учётки = Новый СчитающийСервисУчёток();
	Хранилище = Новый СчитающееХранилищеУчёток();
	Группы = Новый СчитающийСервисГрупп();

	Для Номер = 1 По ЧислоУчастников - 1 Цикл
		Логин = СтрШаблон("участник-%1", Формат(Номер, "ЧГ=0"));
		Учётки.Добавить(Номер, Логин);
		Хранилище.Добавить(Номер, Логин);
		Группы.ДобавитьУчастника(Номер);
	КонецЦикла;
	Хранилище.Добавить(1000, "кандидат");
	Группы.ДобавитьУчастника(404);

	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(Новый ПараметрыСсылки()),
		Новый Подтверждение(UI.Набор, UI.Тексты, Новый Окно(UI.Экран, UI.Набор, UI.Тексты)));
	Список = Новый СписокУчёток(Хранилище, Неопределено, Новый ПоискПоКоллекции());
	Поля = Новый ПультДомаГруппы(Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		Неопределено, UI.Тексты, Неопределено);
	Витрина = Новый ВитринаУчастниковГруппы(UI.Кит, Группы, Учётки, Новый СверкаГруппЗаглушка(), Список,
		Окна, Поля, UI.Тексты);

	Адрес = "/groups/команда/settings/members";
	Секции = Витрина.Секции(Новый Структура("Группа, Адрес, МожетПравить, Запрос, Страница, Окно",
		Новый Структура("Идентификатор, Имя", 1, "команда"), Адрес, МожетПравить, "", 1, Неопределено));
	// формы строк и окон берут адрес и токен у дома, как на настоящей странице
	Дом = UI.Кит.ДомНастроек("Группа", Адрес, "csrf-токен", Секции[0]);

	Итог = Новый Структура();
	Итог.Вставить("Состав", Группы.Обращений());
	Итог.Вставить("Учётки", Учётки.Обращений());
	Итог.Вставить("Кандидаты", Хранилище.Обращений());
	Итог.Вставить("Всего", Группы.Обращений() + Учётки.Обращений() + Хранилище.Обращений());
	Итог.Вставить("Разметка", Дом.Рендер());
	Возврат Итог;

КонецФункции

#КонецОбласти


#Область ЦенаМоделиПрав

// Список групп человека — первый вопрос КАЖДОЙ проверки прав, поэтому его цена множится
// на всю модель. Две группы и двадцать стоят одного и того же: членства одним отбором,
// сами группы одним разрезом.
&Тест
Процедура ЦенаСпискаГруппНеРастётСЧисломГрупп() Экспорт

	НаДвух = ЦенаСпискаГрупп(2);
	НаДвадцати = ЦенаСпискаГрупп(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать групп стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Членства, "членства человека — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Группы, "сами группы — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: группы названы, и порядок членства сохранён
	Ожидаем.Что(НаДвадцати.Имена.Количество(), "вернулись все двадцать групп").Равно(20);
	Ожидаем.Что(НаДвадцати.Имена[0], "первой стоит группа первого членства").Равно("группа-20");
	Ожидаем.Что(НаДвадцати.Имена[19], "последней — группа последнего членства").Равно("группа-1");

КонецПроцедуры

// Разрез отдаёт группы порядком базы, а список человека идёт порядком его членств, и повторное
// членство называет группу дважды. Это видно в «Моих группах» кабинета и в выдаче групп API.
&Тест
Процедура СписокГруппИдётПорядкомЧленствСПовторами() Экспорт

	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();
	Группы.Добавить(1, "первая");
	Группы.Добавить(2, "вторая");

	// хранилище отдаст «первая, вторая» (по возрастанию), а членства идут иначе
	Членства.Добавить(2, ВладелецПрав().Идентификатор);
	Членства.Добавить(1, ВладелецПрав().Идентификатор);
	Членства.Добавить(2, ВладелецПрав().Идентификатор);

	Служба = Новый СервисГрупп(Группы, Членства);

	Ожидаем.Что(ИменаГрупп(Служба.ГруппыПользователя(ВладелецПрав().Идентификатор)),
		"порядок членств сохранён, повтор назван дважды").Равно("вторая, первая, вторая");
	Ожидаем.Что(Группы.Обращений(), "повтор членства не удваивает запрос").Равно(1);

КонецПроцедуры

// Членство, чья группа снесена, в выдаче не появляется — разрез не должен подменять
// пропажу пустышкой.
&Тест
Процедура ЧленствоБезГруппыИзСпискаВыпадает() Экспорт

	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();
	Группы.Добавить(1, "живая");
	Членства.Добавить(1, ВладелецПрав().Идентификатор);
	Членства.Добавить(2, ВладелецПрав().Идентификатор);

	Список = Новый СервисГрупп(Группы, Членства).ГруппыПользователя(ВладелецПрав().Идентификатор);

	Ожидаем.Что(Список.Количество(), "снесённая группа в список не попала").Равно(1);
	Ожидаем.Что(Список[0].Имя, "осталась живая группа").Равно("живая");

КонецПроцедуры

// Членства заведены от старшего номера к младшему: порядок выдачи не совпадает с порядком разреза.
Функция ЦенаСпискаГрупп(Знач ЧислоГрупп)

	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();

	Для Номер = 1 По ЧислоГрупп Цикл
		Обратный = ЧислоГрупп - Номер + 1;
		Группы.Добавить(Обратный, СтрШаблон("группа-%1", Формат(Обратный, "ЧГ=0")));
		Членства.Добавить(Обратный, ВладелецПрав().Идентификатор);
	КонецЦикла;

	Служба = Новый СервисГрупп(Группы, Членства);
	Список = Служба.ГруппыПользователя(ВладелецПрав().Идентификатор);

	Имена = Новый Массив();
	Для Каждого Группа Из Список Цикл
		Имена.Добавить(Группа.Имя);
	КонецЦикла;

	Итог = Новый Структура();
	Итог.Вставить("Членства", Членства.Обращений());
	Итог.Вставить("Группы", Группы.Обращений());
	Итог.Вставить("Всего", Членства.Обращений() + Группы.Обращений());
	Итог.Вставить("Имена", Имена);
	Возврат Итог;

КонецФункции

Функция ИменаГрупп(Знач Список)

	Имена = Новый Массив();
	Для Каждого Группа Из Список Цикл
		Имена.Добавить(Группа.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

// Снимок прав — первый вопрос кабинета, каталога и каждого гварда, а субъектов в нём
// столько же, сколько у человека групп. Две группы и двадцать стоят одного и того же:
// гранты и роли спрашиваются по одному разрезу на ТИП субъекта.
&Тест
Процедура ЦенаСнимкаПравНеРастётСЧисломГрупп() Экспорт

	НаДвух = ЦенаСнимкаПрав(2);
	НаДвадцати = ЦенаСнимкаПрав(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать групп стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Гранты, "гранты — разрез на людей и разрез на группы").Равно(2);
	Ожидаем.Что(НаДвадцати.Участия, "роли — разрез на людей и разрез на группы").Равно(2);

	// счётчик не должен мерить пустую работу: снимок собран целиком и знает о каждой группе
	Ожидаем.Что(НаДвадцати.Субъектов, "субъектов — сам человек и все его группы").Равно(21);
	Ожидаем.Что(НаДвадцати.ГрантовВСнимке, "гранты всех групп попали в снимок").Равно(20);
	Ожидаем.Что(НаДвадцати.РолейВСнимке, "роли всех групп попали в снимок").Равно(20);
	Ожидаем.Что(НаДвадцати.ПерваяРоль, "первой идёт роль первой группы членства")
		.Равно("роль-20");

КонецПроцедуры

// Каждая группа несёт свой грант и свою роль на своём пуле: потерянная строка видна числом.
Функция ЦенаСнимкаПрав(Знач ЧислоГрупп)

	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();
	Участия = Новый СчитающееХранилищеУчастников();
	Гранты = Новый СчитающееХранилищеГрантов();

	Для Номер = 1 По ЧислоГрупп Цикл
		Обратный = ЧислоГрупп - Номер + 1;
		Группы.Добавить(Обратный, СтрШаблон("группа-%1", Формат(Обратный, "ЧГ=0")));
		Членства.Добавить(Обратный, ВладелецПрав().Идентификатор);
		Гранты.Добавить("группа", Обратный, "пул", Обратный, "чтение");
		Участия.Добавить(Обратный, "группа", Обратный, СтрШаблон("роль-%1", Формат(Обратный, "ЧГ=0")));
	КонецЦикла;

	Права = Новый СервисПрав(Новый СервисГрупп(Группы, Членства), Участия, Гранты, Неопределено);
	Снимок = Права.СнимокПрав(ВладелецПрав());

	Итог = Новый Структура();
	Итог.Вставить("Гранты", Гранты.Обращений());
	Итог.Вставить("Участия", Участия.Обращений());
	Итог.Вставить("Всего", Гранты.Обращений() + Участия.Обращений()
		+ Группы.Обращений() + Членства.Обращений());
	Итог.Вставить("Субъектов", Снимок.Субъекты.Количество());
	Итог.Вставить("ГрантовВСнимке", Снимок.Гранты.Количество());
	Итог.Вставить("РолейВСнимке", Снимок.Роли.Количество());
	Итог.Вставить("ПерваяРоль", Снимок.Роли[0].Роль);
	Возврат Итог;

КонецФункции

// Раздел «Права доступа группы» и выдача грантов API называют объект КАЖДОЙ записи.
// Две записи и двадцать стоят одного и того же: пакеты одним разрезом, их пулы и пулы
// самих записей — вторым, право видеть — одним снимком.
&Тест
Процедура ЦенаОбъектовЗаписейПравНеРастётСЧисломЗаписей() Экспорт

	НаДвух = ЦенаОбъектовЗаписейПрав(2);
	НаДвадцати = ЦенаОбъектовЗаписейПрав(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать записей стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Пакеты, "пакеты записей — один разрез").Равно(1);
	Ожидаем.Что(НаДвадцати.Пулы, "пулы записей и пулы их пакетов — один разрез").Равно(1);
	Ожидаем.Что(НаДвадцати.Гранты, "права смотрящего — по разрезу на тип субъекта").Равно(2);
	Ожидаем.Что(НаДвадцати.Участия, "роли смотрящего — по разрезу на тип субъекта").Равно(2);

	// счётчик не должен мерить пустую работу: ответ у записей РАЗНЫЙ — свой пул открыт
	// грантом, чужой закрыт, пакет открытого пула назван вместе с именем своего пула
	Ожидаем.Что(НаДвадцати.Видимых, "видны хаб, пул с грантом и пакет пула с ролью").Равно(8);
	Ожидаем.Что(НаДвадцати.Скрытых, "остальные пулы и пакеты закрыты").Равно(12);
	Ожидаем.Что(НаДвадцати.ПулВидимогоПакета, "у видимого пакета назван его пул").Равно("пул-2");
	Ожидаем.Что(НаДвадцати.ВиденХаб, "объект «хаб» виден всем").ЭтоИстина();

КонецПроцедуры

// Записи чередуют пул, пакет и хаб; открыты только пул 1 (личный грант) и пул 2 (роль группы).
Функция ЦенаОбъектовЗаписейПрав(Знач ЧислоЗаписей)

	Пулы = Новый ФейкСервисПулов();
	Пакеты = Новый РазрезСервисПакетов();
	Участия = Новый СчитающееХранилищеУчастников();
	Гранты = Новый СчитающееХранилищеГрантов();
	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();

	Группы.Добавить(ГруппаСРолью(), "команда");
	Членства.Добавить(ГруппаСРолью(), ВладелецПрав().Идентификатор);

	Записи = Новый Массив();
	Для Номер = 1 По ЧислоЗаписей Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧГ=0")), "private");
		Пакеты.ДобавитьПакет(Номер, Номер, СтрШаблон("пакет-%1", Формат(Номер, "ЧГ=0")));
		Если Номер % 3 = 1 Тогда
			Записи.Добавить(ЗаписьПрава("пул", Номер));
		ИначеЕсли Номер % 3 = 2 Тогда
			Записи.Добавить(ЗаписьПрава("пакет", Номер));
		Иначе
			Записи.Добавить(ЗаписьПрава("хаб", 0));
		КонецЕсли;
	КонецЦикла;

	Гранты.Добавить("пользователь", ВладелецПрав().Идентификатор, "пул", 1, "чтение");
	Участия.Добавить(2, "группа", ГруппаСРолью(), "читатель");

	Видимость = Новый ВидимостьОбъектовПрав(Пулы, Пакеты,
		ГвардПулов(Пулы, Группы, Членства, Участия, Гранты));
	Снимок = Видимость.Описания(ВладелецПрав(), Записи);

	Итог = Новый Структура();
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Пакеты", Пакеты.Запросов());
	Итог.Вставить("Гранты", Гранты.Обращений());
	Итог.Вставить("Участия", Участия.Обращений());
	Итог.Вставить("Всего", Пулы.Обращений() + Пакеты.Запросов() + Гранты.Обращений()
		+ Участия.Обращений() + Группы.Обращений() + Членства.Обращений());

	Объекты = ОбъектыЗаписей(Видимость, Снимок, Записи);
	Итог.Вставить("Видимых", Объекты.Видимых);
	Итог.Вставить("Скрытых", Объекты.Скрытых);
	Итог.Вставить("ПулВидимогоПакета", Объекты.ПулВидимогоПакета);
	Итог.Вставить("ВиденХаб", Объекты.ВиденХаб);
	Возврат Итог;

КонецФункции

// Снимок читается тем же вопросом, что задаёт витрина, и бесплатно: счётчики уже сняты.
Функция ОбъектыЗаписей(Знач Видимость, Знач Снимок, Знач Записи)

	Итог = Новый Структура("Видимых, Скрытых, ПулВидимогоПакета, ВиденХаб", 0, 0, "", Ложь);

	Для Каждого Запись Из Записи Цикл
		Объект = Видимость.Описание(ВладелецПрав(), Запись.ТипОбъекта,
			Запись.ОбъектИдентификатор, Неопределено, Снимок);
		Если НЕ Объект.Виден Тогда
			Итог.Скрытых = Итог.Скрытых + 1;
			Продолжить;
		КонецЕсли;

		Итог.Видимых = Итог.Видимых + 1;
		Если Объект.Тип = "пакет" Тогда
			Итог.ПулВидимогоПакета = Объект.Пул.Имя;
		ИначеЕсли Объект.Тип = "хаб" Тогда
			Итог.ВиденХаб = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция ЗаписьПрава(Знач ТипОбъекта, Знач ОбъектИдентификатор)
	Возврат Новый Структура("ТипОбъекта, ОбъектИдентификатор", ТипОбъекта, ОбъектИдентификатор);
КонецФункции

// Витрина «Мои права» спрашивает права смотрящего один раз на всю таблицу: два пула
// и двадцать стоят одинаково, хотя строк рисуется двадцать. Без снимка каждая строка
// стоила бы пяти разрезов — чтение, роль дважды, запись и администрирование.
&Тест
Процедура ЦенаВитриныМоихПравНеРастётСЧисломПулов() Экспорт

	НаДвух = ЦенаВитриныМоихПрав(2);
	НаДвадцати = ЦенаВитриныМоихПрав(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать пулов стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Пулы, "реестр пулов — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Членства, "членства смотрящего — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Группы, "группы смотрящего — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Гранты, "гранты — по одному разрезу на тип субъекта").Равно(2);
	Ожидаем.Что(НаДвадцати.Участия, "роли — по одному разрезу на тип субъекта").Равно(2);

	// счётчик не должен мерить пустую работу: строки нарисованы, и ответ в них РАЗНЫЙ —
	// личная роль, роль через группу и право без роли вовсе
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "настройки пула"),
		"показаны все двадцать пулов").Равно(20);
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "мейнтейнер"),
		"личная роль названа у каждого своего пула").Равно(7);
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "райтер"),
		"роль через группу названа у каждого своего пула").Равно(7);
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "по праву доступа"),
		"право без роли названо грантом").Равно(6);

КонецПроцедуры

// Каждый третий пул отвечает по-своему: личная роль, роль группы, голый грант.
Функция ЦенаВитриныМоихПрав(Знач ЧислоПулов)

	Пулы = Новый ФейкСервисПулов();
	Участия = Новый СчитающееХранилищеУчастников();
	Гранты = Новый СчитающееХранилищеГрантов();
	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();

	Группы.Добавить(ГруппаСРолью(), "команда");
	Группы.Добавить(ГруппаБезРолей(), "почтальоны");
	Членства.Добавить(ГруппаСРолью(), ВладелецПрав().Идентификатор);
	Членства.Добавить(ГруппаБезРолей(), ВладелецПрав().Идентификатор);

	Для Номер = 1 По ЧислоПулов Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧГ=0")));
		Если Номер % 3 = 1 Тогда
			Участия.Добавить(Номер, "пользователь", ВладелецПрав().Идентификатор, "мейнтейнер");
		ИначеЕсли Номер % 3 = 2 Тогда
			Участия.Добавить(Номер, "группа", ГруппаСРолью(), "райтер");
		Иначе
			Гранты.Добавить("пользователь", ВладелецПрав().Идентификатор, "пул", Номер, "изменение");
		КонецЕсли;
	КонецЦикла;

	Права = Новый СервисПрав(Новый СервисГрупп(Группы, Членства), Участия, Гранты, Неопределено);
	Витрина = Новый ВитринаМоихПрав(UI.Кит, Новый ТаблицаПрав(UI.Кит, UI.Модели, Новый ФейкСубъектыПрав(), UI.Тексты),
		Права, Пулы, Новый СервисГрупп(Группы, Членства), UI.Тексты, Новый АдресаСтраниц());

	Секция = Витрина.СекцияПрав(ВладелецПрав());

	Итог = Новый Структура();
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Участия", Участия.Обращений());
	Итог.Вставить("Гранты", Гранты.Обращений());
	Итог.Вставить("Группы", Группы.Обращений());
	Итог.Вставить("Членства", Членства.Обращений());
	Итог.Вставить("Всего", Пулы.Обращений() + Участия.Обращений() + Гранты.Обращений()
		+ Группы.Обращений() + Членства.Обращений());
	Итог.Вставить("Разметка", Секция.Рендер());
	Возврат Итог;

КонецФункции

// поток «права»
// Раздел «Права доступа» пула и пакета называет субъекта и роль КАЖДОЙ записи. Две записи и двадцать
// стоят одного и того же: записи на объект — одно чтение, логины и имена групп — по разрезу на тип,
// роль — из самой записи, меню отзыва строки — без вопроса к базе.
&Тест
Процедура ЦенаТаблицыПравРазделаНеРастётСЧисломЗаписей() Экспорт

	НаДвух = ЦенаТаблицыПравРаздела(2);
	НаДвадцати = ЦенаТаблицыПравРаздела(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать записей стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Гранты, "записи прав на объект — одно чтение").Равно(1);
	Ожидаем.Что(НаДвадцати.Учётки, "логины людей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Группы, "имена групп — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: строки нарисованы, и у каждой своё имя, своя роль
	// словами и своё меню отзыва
	Ожидаем.Что(НаДвадцати.СтрокЛюдей, "логин назван у каждой строки человека").Равно(10);
	Ожидаем.Что(НаДвадцати.СтрокГрупп, "имя группы названо у каждой строки группы").Равно(10);
	Ожидаем.Что(НаДвадцати.Райтеров, "роль человека словом").Равно(10);
	Ожидаем.Что(НаДвадцати.Читателей, "роль группы словом").Равно(10);
	Ожидаем.Что(НаДвадцати.Меню, "у каждой строки меню отзыва").Равно(20);

КонецПроцедуры

// Записи чередуют человека-райтера и группу-читателя, у каждого субъекта своё имя.
Функция ЦенаТаблицыПравРаздела(Знач ЧислоЗаписей)

	Учётки = Новый СчитающийСервисУчёток();
	Группы = Новый СчитающееХранилищеГрупп();
	Гранты = Новый СчитающееХранилищеГрантов();
	Для Номер = 1 По ЧислоЗаписей Цикл
		Если Номер % 2 = 1 Тогда
			Учётки.Добавить(Номер, СтрШаблон("участник-%1", Формат(Номер, "ЧГ=0")));
			Гранты.Добавить("пользователь", Номер, "пул", 7, "чтение, создание, изменение");
		Иначе
			Группы.Добавить(Номер, СтрШаблон("команда-%1", Формат(Номер, "ЧГ=0")));
			Гранты.Добавить("группа", Номер, "пул", 7, "чтение");
		КонецЕсли;
	КонецЦикла;

	СервисГрупп_ = Новый СервисГрупп(Группы, Новый СчитающееХранилищеЧленств());
	Права = Новый СервисПрав(СервисГрупп_, Новый СчитающееХранилищеУчастников(), Гранты, Неопределено);
	Служба = Новый СлужбаДоступа(Неопределено, Неопределено, Права,
		Новый СервисПравДоступа(Права, Гранты, Неопределено, Неопределено, Неопределено, Неопределено),
		Неопределено, Новый Массив(), Неопределено, Неопределено);
	Таблицы = Новый ТаблицаПрав(UI.Кит, UI.Модели, Новый СубъектыПрав(Учётки, СервисГрупп_), UI.Тексты);
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), Неопределено);
	Витрина = Новый ВитринаВыдачиРоли(UI.Кит,
		Новый ФормаВыдачиРоли(UI.Кит, Таблицы, Права, Окна, UI.Тексты), Таблицы, Служба, Окна, UI.Тексты);

	Раздел = Новый Структура("Вид, Идентификатор, Адрес, Заголовок, Лид, Пусто, ТолькоЧтение,"
		+ " ЗаголовокОкна, ЛидОкна, Сноска", "пул", 7, "/pools/corp/settings/access",
		"Права доступа", "", "пусто", "", "Выдать роль", "", Неопределено);
	// формы окон берут адрес раздела и токен у дома
	Дом = UI.Кит.ДомНастроек("corp", "/pools/corp/settings", "токен", Витрина.Секция(Раздел, Истина, Неопределено));
	Дом.Раздел("Права доступа", "access").Текущий();
	Разметка = Дом.Рендер();
	Строки = СтрокиТаблицыПравРаздела(Разметка);

	Итог = Новый Структура();
	Итог.Вставить("Гранты", Гранты.Обращений());
	Итог.Вставить("Учётки", Учётки.Обращений());
	Итог.Вставить("Группы", Группы.Обращений());
	Итог.Вставить("Всего", Гранты.Обращений() + Учётки.Обращений() + Группы.Обращений());
	Итог.Вставить("СтрокЛюдей", ЧислоСтрокПравРаздела(Строки, ">участник-"));
	Итог.Вставить("СтрокГрупп", ЧислоСтрокПравРаздела(Строки, ">команда-"));
	Итог.Вставить("Райтеров", ЧислоСтрокПравРаздела(Строки, ">райтер<"));
	Итог.Вставить("Читателей", ЧислоСтрокПравРаздела(Строки, ">читатель<"));
	Итог.Вставить("Меню", ЧислоСтрокПравРаздела(Строки, КодироватьСтроку("отозвать-",
		СпособКодированияСтроки.КодировкаURL)));
	Возврат Итог;

КонецФункции

// Строки тела таблицы: от каждого <tr до следующего; окна раздела в счёт не идут.
Функция СтрокиТаблицыПравРаздела(Знач Разметка)

	Таблица = Сред(Разметка, СтрНайти(Разметка, "<tbody"));
	Таблица = Лев(Таблица, СтрНайти(Таблица, "</tbody>"));
	Результат = Новый Массив();
	Позиция = СтрНайти(Таблица, "<tr");
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(Таблица, "<tr", , Позиция + 1);
		Результат.Добавить(Сред(Таблица, Позиция, ?(Следующая = 0, СтрДлина(Таблица) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЧислоСтрокПравРаздела(Знач Строки, Знач Образец)

	Число = 0;
	Для Каждого Строка_ Из Строки Цикл
		Если СтрНайти(Строка_, Образец) > 0 Тогда
			Число = Число + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;

КонецФункции

// Перечисление читаемых пулов — цена КАЖДОЙ публичной страницы вошедшего: лендинга,
// каталога, поиска, списка пулов API. Права смотрящего снимаются один раз на выдачу,
// поэтому два закрытых пула и двадцать стоят одинаково.
&Тест
Процедура ЦенаЧитаемыхПуловНеРастётСЧисломПулов() Экспорт

	НаДвух = ЦенаЧитаемыхПулов(2);
	НаДвадцати = ЦенаЧитаемыхПулов(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать закрытых пулов стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Членства, "членства смотрящего — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Группы, "группы смотрящего — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Гранты, "гранты — по одному разрезу на тип субъекта").Равно(2);
	Ожидаем.Что(НаДвадцати.Участия, "роли — по одному разрезу на тип субъекта").Равно(2);

	// счётчик не должен мерить пустую работу: выдача разбирает пулы по одному, и открыты
	// в ней ровно два — свой по гранту и чужой по роли группы
	Ожидаем.Что(НаДвадцати.Имена, "открыты ровно два закрытых пула").Равно("пул-1, пул-2");

КонецПроцедуры

// Хаб из одних публичных пулов не спрашивает о правах вовсе: снимок снимается только
// тогда, когда в выдаче есть закрытый пул.
&Тест
Процедура ВыдачаИзПубличныхПуловНеСтоитНиОдногоВопросаОПравах() Экспорт

	Пулы = Новый ФейкСервисПулов();
	Участия = Новый СчитающееХранилищеУчастников();
	Гранты = Новый СчитающееХранилищеГрантов();
	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();

	Для Номер = 1 По 20 Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧГ=0")));
	КонецЦикла;

	Читаемые = ГвардПулов(Пулы, Группы, Членства, Участия, Гранты).ЧитаемыеПулы(
		Новый Структура("Пользователь", ВладелецПрав()));

	Ожидаем.Что(Читаемые.Количество(), "публичное видно всем").Равно(20);
	Ожидаем.Что(Членства.Обращений() + Группы.Обращений() + Гранты.Обращений()
		+ Участия.Обращений(), "о правах не спрошено ничего").Равно(0);

КонецПроцедуры

// Первый закрытый пул открыт грантом, второй — ролью группы, остальные закрыты: три разных ответа.
Функция ЦенаЧитаемыхПулов(Знач ЧислоПулов)

	Пулы = Новый ФейкСервисПулов();
	Участия = Новый СчитающееХранилищеУчастников();
	Гранты = Новый СчитающееХранилищеГрантов();
	Группы = Новый СчитающееХранилищеГрупп();
	Членства = Новый СчитающееХранилищеЧленств();

	Группы.Добавить(ГруппаСРолью(), "команда");
	Группы.Добавить(ГруппаБезРолей(), "почтальоны");
	Членства.Добавить(ГруппаСРолью(), ВладелецПрав().Идентификатор);
	Членства.Добавить(ГруппаБезРолей(), ВладелецПрав().Идентификатор);

	Для Номер = 1 По ЧислоПулов Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧГ=0")), "private");
	КонецЦикла;
	Гранты.Добавить("пользователь", ВладелецПрав().Идентификатор, "пул", 1, "чтение");
	Участия.Добавить(2, "группа", ГруппаСРолью(), "читатель");

	Читаемые = ГвардПулов(Пулы, Группы, Членства, Участия, Гранты).ЧитаемыеПулы(
		Новый Структура("Пользователь", ВладелецПрав()));

	Имена = Новый Массив();
	Для Каждого Пул Из Читаемые Цикл
		Имена.Добавить(Пул.Имя);
	КонецЦикла;

	Итог = Новый Структура();
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Участия", Участия.Обращений());
	Итог.Вставить("Гранты", Гранты.Обращений());
	Итог.Вставить("Группы", Группы.Обращений());
	Итог.Вставить("Членства", Членства.Обращений());
	Итог.Вставить("Всего", Пулы.Обращений() + Участия.Обращений() + Гранты.Обращений()
		+ Группы.Обращений() + Членства.Обращений());
	Итог.Вставить("Имена", СтрСоединить(Имена, ", "));
	Возврат Итог;

КонецФункции

// Гейта токена у гварда нет, а запрос идёт сессией: рамки ключа в замере не участвуют.
Функция ГвардПулов(Знач Пулы, Знач Группы, Знач Членства, Знач Участия, Знач Гранты)

	Права = Новый СервисПрав(Новый СервисГрупп(Группы, Членства), Участия, Гранты, Неопределено);
	Допуск = Новый ДопускЗапросаКПулу(Новый ПерехватчикБезКлюча(), Неопределено);
	Возврат Новый ГвардДоступаКПулу(Допуск, Права, Пулы, Новый УчёткаПринципала());

КонецФункции

// Допуск, чьи рамки ключа пускают всё: набор мерит цену экрана, а не энфорсмент.
Функция ПропускающийДопуск()
	Возврат Новый ДопускПринципала(Новый УчёткаПринципала(), Новый ГвардКлючаПропускающий());
КонецФункции

// Не админ хаба: суперправо отвечало бы на любой вопрос, не спрашивая базу.
Функция ВладелецПрав()
	Возврат Новый Структура("Идентификатор, Логин, РольХаба", 7, "смотрящий", "user");
КонецФункции

Функция ГруппаСРолью()
	Возврат 101;
КонецФункции

// Вторая группа ролей и грантов не носит: субъектов у снимка всё равно трое.
Функция ГруппаБезРолей()
	Возврат 102;
КонецФункции

#КонецОбласти


#Область КаталогПоискИЛендинг

// Страница каталога показывает двадцать строк и называет пул у каждой. Имена пулов
// страницы — один разрез, а не вопрос на строку: иначе каждая строка стоила бы обращения,
// и цена страницы росла бы её длиной.
&Тест
Процедура ЦенаСтраницыКаталогаНеРастётСЧисломСтрок() Экспорт

	НаДвух = ЦенаСтраницыКаталога(2);
	НаДвадцати = ЦенаСтраницыКаталога(20);

	Ожидаем.Что(НаДвадцати.Пулы, СтрШаблон(
		"двадцать строк каталога стоят столько же обращений к пулам, сколько две: %1 против %2",
		Формат(НаДвадцати.Пулы, "ЧГ=0"), Формат(НаДвух.Пулы, "ЧГ=0"))).Равно(НаДвух.Пулы);

	Ожидаем.Что(НаДвадцати.Пулы, "имена пулов всей страницы — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: строки собраны, и пул назван у каждой
	Ожидаем.Что(НаДвадцати.Строк, "на странице все двадцать пакетов").Равно(20);
	Ожидаем.Что(НаДвадцати.БезПула, "пул разыменован у каждой строки").Равно(0);

КонецПроцедуры

// Ранжирование спрашивает скачивания найденных одним разрезом — не вопросом на карточку и не
// разрезом по всей таблице агрегатов. Числа — цена на SQL-бэкенде: двойник отдаёт готовые суммы,
// как база.
&Тест
Процедура ЦенаРанжированияНеРастётСЧисломНайденных() Экспорт

	НаДвух = ЦенаРанжирования(2);
	НаДвадцати = ЦенаРанжирования(20);

	Ожидаем.Что(НаДвадцати.ЗапросовАгрегатов, СтрШаблон(
		"двадцать найденных стоят столько же обращений за скачиваниями, сколько два: %1 против %2",
		Формат(НаДвадцати.ЗапросовАгрегатов, "ЧГ=0"),
		Формат(НаДвух.ЗапросовАгрегатов, "ЧГ=0"))).Равно(НаДвух.ЗапросовАгрегатов);

	Ожидаем.Что(НаДвадцати.ЗапросовАгрегатов, "скачивания всех найденных — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.СтрокАгрегатов,
		"суточных строк не поднято ни одной: суммы найденных отдала база").Равно(0);

	// счётчик не должен мерить пустую работу: выдача собрана, и порядок в ней задан
	// популярностью — при равной оценке первым стоит самый скачиваемый
	Ожидаем.Что(НаДвадцати.Найдено, "найдены все двадцать одноимённых пакетов").Равно(20);
	Ожидаем.Что(НаДвадцати.Первый, "первым стоит самый скачиваемый").Равно("пакет-20");

КонецПроцедуры

// Поиск ограничен читаемыми пулами, поэтому и читать обязан только их пакеты. Приватная
// половина хаба не должна удорожать чужой запрос: разрез берётся по решению видимости,
// а не по всей таблице пакетов.
&Тест
Процедура ЦенаПоискаНеРастётСЧисломНедоступныхПакетов() Экспорт

	НаДвух = ЦенаПоискаПриЧужихПакетах(2);
	НаДвадцати = ЦенаПоискаПриЧужихПакетах(20);

	Ожидаем.Что(НаДвадцати.СтрокПакетов, СтрШаблон(
		"двадцать недоступных пакетов стоят столько же строк, сколько два: %1 против %2",
		Формат(НаДвадцати.СтрокПакетов, "ЧГ=0"),
		Формат(НаДвух.СтрокПакетов, "ЧГ=0"))).Равно(НаДвух.СтрокПакетов);

	Ожидаем.Что(НаДвадцати.СтрокПакетов, "прочитаны пакеты только читаемого пула").Равно(3);

	// счётчик не должен мерить пустую работу: доступное найдено, чужое в выдачу не попало
	Ожидаем.Что(НаДвадцати.Найдено, "в выдаче три доступных пакета").Равно(3);

КонецПроцедуры

// Числа лендинга считаются по доступному смотрящему срезу, поэтому и стоить обязаны
// размером среза. Приватные пулы растут вместе с числом учёток, и читать их пакеты
// ради четырёх чисел анонимной главной незачем.
&Тест
Процедура ЦенаСводкиЛендингаНеРастётСЧисломНедоступныхПакетов() Экспорт

	НаДвух = ЦенаСводкиЛендинга(2);
	НаДвадцати = ЦенаСводкиЛендинга(20);

	Ожидаем.Что(НаДвадцати.СтрокПакетов, СтрШаблон(
		"двадцать пакетов приватного пула стоят лендингу столько же строк, сколько два: %1 против %2",
		Формат(НаДвадцати.СтрокПакетов, "ЧГ=0"),
		Формат(НаДвух.СтрокПакетов, "ЧГ=0"))).Равно(НаДвух.СтрокПакетов);

	Ожидаем.Что(НаДвадцати.СтрокПакетов, "лендинг читает пакеты только видимых пулов").Равно(3);

	// счётчик не должен мерить пустую работу: сводка посчитана и называет видимую часть
	Ожидаем.Что(НаДвадцати.ВсегоПакетов, "в сводке три видимых пакета").Равно(3);
	Ожидаем.Что(НаДвадцати.ВсегоПулов, "и один видимый пул").Равно(1);

КонецПроцедуры

// Один пакет показывает одно число скачиваний на лендинге, в кабинете и на своей странице:
// все три двери отвечают из одного разреза.
&Тест
Процедура ЧислоСкачиванийОдногоПакетаОдинаковоНаВсехЭкранах() Экспорт

	Агрегаты = Новый СчитающееХранилищеАгрегатов();
	Служба = СлужбаСкачиваний(Агрегаты);
	Пакет = ПакетСоСкачиваниями();

	// лендинг посмотрели первым: он сложил разрез у себя
	Служба.СкачиванияПоПакетам();

	// запись в таблицу агрегатов мимо витрины, но через то же хранилище, как пишет уборка пакета;
	// запись соседней реплики витрина не заметит, и на неё сторож не претендует
	Агрегаты.Добавить(Пакет, 5);

	// и одно скачивание ещё висит в буфере: непустой буфер обязан лечь на ту же базу
	Служба.ЗафиксироватьСкачивание(Пакет, 1, Дата(2026, 7, 25, 10, 0, 0));

	Лендинг = Служба.СкачиванияПоПакетам().Получить(Пакет);
	ЗапросовПослеЛендинга = Агрегаты.Запросов();
	Кабинет = Служба.СкачиванияПакетов(Только(Пакет)).Получить(Пакет);
	Карточка = Служба.СкачиванийПакета(Пакет);

	Ожидаем.Что(Кабинет, СтрШаблон(
		"кабинет и лендинг называют одно число: %1 против %2",
		Формат(Кабинет, "ЧГ=0"), Формат(Лендинг, "ЧГ=0"))).Равно(Лендинг);
	Ожидаем.Что(Карточка, СтрШаблон(
		"страница пакета и лендинг называют одно число: %1 против %2",
		Формат(Карточка, "ЧГ=0"), Формат(Лендинг, "ЧГ=0"))).Равно(Лендинг);

	Ожидаем.Что(Лендинг, "и это число — база плюс буфер").Равно(6);

	// одно число — потому что разрез один: прочитанное лендингом соседние двери
	// не спрашивают заново
	Ожидаем.Что(Агрегаты.Запросов() - ЗапросовПослеЛендинга,
		"разрез у всех трёх дверей один и в базу второй раз не ходит").Равно(0);

КонецПроцедуры

// Разрез помнит только удавшееся чтение: после разового сбоя базы пакет не остаётся навсегда
// с нулём на карточке, в «Моих пакетах» и в ранжировании.
&Тест
Процедура РазовыйСбойБазыНеОставляетПакетСПустойСуммой() Экспорт

	Агрегаты = Новый СчитающееХранилищеАгрегатов();
	Агрегаты.Добавить(ПакетСоСкачиваниями(), 5);
	Служба = СлужбаСкачиваний(Агрегаты);

	// карточка пакета: разрез по одному идентификатору
	Агрегаты.ОтказатьОдинРаз();
	СбойКарточки = Ложь;
	Попытка
		Служба.СкачиванийПакета(ПакетСоСкачиваниями());
	Исключение
		СбойКарточки = Истина;
	КонецПопытки;

	Ожидаем.Что(СбойКарточки, "разовый сбой базы виден вызывающему, а не проглатывается")
		.ЭтоИстина();
	Ожидаем.Что(Служба.СкачиванийПакета(ПакетСоСкачиваниями()),
		"после сбоя карточка спрашивает базу заново, а не показывает ноль").Равно(5);

	// лендинг: полный разрез собирается тем же правилом
	Агрегаты.ОтказатьОдинРаз();
	СбойЛендинга = Ложь;
	Попытка
		Служба.СкачиванияПоПакетам();
	Исключение
		СбойЛендинга = Истина;
	КонецПопытки;

	Ожидаем.Что(СбойЛендинга, "и на полном разрезе сбой виден вызывающему").ЭтоИстина();
	Ожидаем.Что(Служба.СкачиванийПакета(ПакетСоСкачиваниями()),
		"сорвавшийся полный разрез не стирает уже сложенное соседней дверью").Равно(5);
	Ожидаем.Что(Служба.СкачиванияПоПакетам().Получить(ПакетСоСкачиваниями()),
		"после сбоя лендинг собирает разрез заново").Равно(5);

КонецПроцедуры

Функция ЦенаСтраницыКаталога(Знач ЧислоПакетов)

	Пулы = Новый ФейкСервисПулов();
	Пулы.ДобавитьПул(1, "альфа");
	Пулы.ДобавитьПул(2, "бета");

	Пакеты = Новый РазрезСервисПакетов();
	Для Номер = 1 По ЧислоПакетов Цикл
		Пакеты.ДобавитьПакет(Номер, ?(Номер % 2 = 0, 2, 1),
			СтрШаблон("пакет-%1", Формат(Номер, "ЧГ=0")));
	КонецЦикла;

	Видимость = ВидимостьНад(Пулы.ВсеПулы());
	Каталог = Новый КаталогПакетов(СлужбаПоискаНад(Пакеты, Видимость, Неопределено), Пулы,
		Пакеты, Видимость, Неопределено, Неопределено);

	// обращение, которым фикстура выдала пулы видимости, счётчику экрана не принадлежит
	ПулыДоЭкрана = Пулы.Обращений();
	Страница = Каталог.НайтиПакеты("", 1, 20, Неопределено, Неопределено);

	Итог = Новый Структура();
	Итог.Вставить("Пулы", Пулы.Обращений() - ПулыДоЭкрана);
	Итог.Вставить("Строк", Страница.Элементы.Количество());
	Итог.Вставить("БезПула", БезПула(Страница.Элементы));
	Возврат Итог;

КонецФункции

Функция ЦенаРанжирования(Знач ЧислоНайденных)

	Пулы = Новый ФейкСервисПулов();
	Пулы.ДобавитьПул(1, "альфа");

	Агрегаты = Новый СчитающееХранилищеАгрегатов();
	Пакеты = Новый РазрезСервисПакетов();

	Для Номер = 1 По ЧислоНайденных Цикл
		Пакеты.ДобавитьПакет(Номер, 1, СтрШаблон("пакет-%1", Формат(Номер, "ЧГ=0")));
		Агрегаты.Добавить(Номер, Номер * 10);
	КонецЦикла;

	// пакеты, которых в выдаче не будет: их счётчики читать незачем
	Для Номер = 1 По ЧислоЧужихВРанжировании() Цикл
		Чужой = ЧислоНайденных + Номер;
		Пакеты.ДобавитьПакет(Чужой, 1, СтрШаблон("чужой-%1", Формат(Номер, "ЧГ=0")));
		Агрегаты.Добавить(Чужой, 1000);
	КонецЦикла;

	Поиск = СлужбаПоискаНад(Пакеты, ВидимостьНад(Пулы.ВсеПулы()), СлужбаСкачиваний(Агрегаты));

	ЗапросовДоПоиска = Агрегаты.Запросов();
	СтрокДоПоиска = Агрегаты.Строк();
	Найдено = Поиск.НайтиПакеты("пакет", 1, 100, Неопределено);

	Итог = Новый Структура();
	Итог.Вставить("ЗапросовАгрегатов", Агрегаты.Запросов() - ЗапросовДоПоиска);
	Итог.Вставить("СтрокАгрегатов", Агрегаты.Строк() - СтрокДоПоиска);
	Итог.Вставить("Найдено", Найдено.Элементы.Количество());
	Итог.Вставить("Первый", ?(Найдено.Элементы.Количество() = 0, "", Найдено.Элементы[0].Имя));
	Возврат Итог;

КонецФункции

Функция ЦенаПоискаПриЧужихПакетах(Знач ЧислоЧужих)

	Читаемый = Новый ФейкСервисПулов().ДобавитьПул(ИдЧитаемогоПула(), "альфа");
	Пакеты = ХабСПриватнымПулом(ЧислоЧужих);
	Поиск = СлужбаПоискаНад(Пакеты, ВидимостьНад(Только(Читаемый)), Неопределено);

	СтрокДоПоиска = Пакеты.Строк();
	Найдено = Поиск.НайтиПакеты("", 1, 100, Неопределено);

	Итог = Новый Структура();
	Итог.Вставить("СтрокПакетов", Пакеты.Строк() - СтрокДоПоиска);
	Итог.Вставить("Найдено", Найдено.Элементы.Количество());
	Возврат Итог;

КонецФункции

Функция ЦенаСводкиЛендинга(Знач ЧислоЧужих)

	Пулы = Новый ФейкСервисПулов();
	Читаемый = Пулы.ДобавитьПул(ИдЧитаемогоПула(), "альфа");
	Пулы.ДобавитьПул(ИдЗакрытогоПула(), "закрытый");

	Пакеты = ХабСПриватнымПулом(ЧислоЧужих);
	Содержимое = Новый ВидимоеСодержимое(Пулы, Пакеты, ВидимостьНад(Только(Читаемый)));

	СтрокДоЭкрана = Пакеты.Строк();
	Сводка = Новый СтатистикаХаба(Содержимое).Сводка(Неопределено);

	Итог = Новый Структура();
	Итог.Вставить("СтрокПакетов", Пакеты.Строк() - СтрокДоЭкрана);
	Итог.Вставить("ВсегоПакетов", Сводка.ВсегоПакетов);
	Итог.Вставить("ВсегоПулов", Сводка.ВсегоПулов);
	Возврат Итог;

КонецФункции

// Читаемый пул с тремя пакетами и закрытый — с растущей горстью чужих.
Функция ХабСПриватнымПулом(Знач ЧислоЧужих)

	Пакеты = Новый РазрезСервисПакетов();

	Для Номер = 1 По 3 Цикл
		Пакеты.ДобавитьПакет(Номер, ИдЧитаемогоПула(),
			СтрШаблон("пакет-%1", Формат(Номер, "ЧГ=0")));
	КонецЦикла;

	Для Номер = 1 По ЧислоЧужих Цикл
		Пакеты.ДобавитьПакет(100 + Номер, ИдЗакрытогоПула(),
			СтрШаблон("чужой-%1", Формат(Номер, "ЧГ=0")));
	КонецЦикла;

	Возврат Пакеты;

КонецФункции

Функция СлужбаПоискаНад(Знач Пакеты, Знач Видимость, Знач Скачивания)

	Возврат Новый СлужбаПоиска(Пакеты, Скачивания, Видимость, Новый ПоискПоКоллекции(),
		Новый ПриведениеЧисел());

КонецФункции

Функция ВидимостьНад(Знач ВидимыеПулы)

	Чтение = Новый ЧтениеПуловЗаглушка();
	Для Каждого Пул Из ВидимыеПулы Цикл
		Чтение.Добавить(Пул);
	КонецЦикла;
	Возврат Новый ВидимостьПулов(Чтение);

КонецФункции

Функция СлужбаСкачиваний(Знач Агрегаты)

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.stats.flush_threshold", 9999);
	Настройки.Задать("oshub.stats.flush_interval_sec", 99999);

	Возврат Новый СлужбаСтатистикиСкачиваний(Новый СчётчикСкачиванийВПамяти(), Агрегаты,
		Неопределено, Настройки, Новый ГотовностьЗаглушка(), Новый ЗапускВФонеЗаданием());

КонецФункции

Функция ПакетСоСкачиваниями()
	Возврат 77;
КонецФункции

Функция ИдЧитаемогоПула()
	Возврат 1;
КонецФункции

Функция ИдЗакрытогоПула()
	Возврат 2;
КонецФункции

Функция Только(Знач Значение)
	Список = Новый Массив();
	Список.Добавить(Значение);
	Возврат Список;
КонецФункции

// Одноимённых пакетов меньше, чем чужих: разрез по всей таблице агрегатов выдал бы себя лишними строками.
Функция ЧислоЧужихВРанжировании()
	Возврат 5;
КонецФункции

Функция БезПула(Знач Элементы)

	Итог = 0;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Пул = Неопределено Тогда
			Итог = Итог + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ПровенансКарточек

// Каждая карточка носит плашку «с апстрима», и её ответ — провенанс имени. Главную
// открывают все, поэтому спрашивать провенанс на карточку нельзя: два свежих пакета
// и двадцать стоят лендингу одного и того же числа обращений.
&Тест
Процедура ЦенаКарточекЛендингаНеРастётСЧисломПакетов() Экспорт

	НаДвух = ЦенаКарточекЛендинга(2);
	НаДвадцати = ЦенаКарточекЛендинга(20);

	Ожидаем.Что(НаДвадцати.Запросов, СтрШаблон(
		"двадцать карточек стоят столько же обращений за провенансом, сколько две: %1 против %2",
		Формат(НаДвадцати.Запросов, "ЧГ=0"),
		Формат(НаДвух.Запросов, "ЧГ=0"))).Равно(НаДвух.Запросов);

	Ожидаем.Что(НаДвадцати.Запросов, "провенанс каждого блока — одно чтение").Равно(2);
	Ожидаем.Что(НаДвадцати.Строк,
		"прочитаны строки только показанных пакетов, а не всей таблицы провенанса")
		.Равно(2 * 20);

	// счётчик не должен мерить пустую работу: карточки нарисованы, и ответ в них РАЗНЫЙ —
	// половина имён своя, половина пришла с апстрима
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "visually-hidden"">версия: "),
		"в двух блоках нарисованы все сорок карточек").Равно(40);
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, ПлашкаЧужогоИмени()),
		"плашка стоит ровно у чужих имён").Равно(20);

КонецПроцедуры

// Ленты главной — по четыре в ряд и полными рядами (замечание владельца к превью 2: «плашки
// растянутые и сплюснутые… либо по 4»): сетка несёт признак полных рядов кита, и восемь карточек
// блока печатаются все — неполный ряд на узкой ширине прячет лист кита, а не сервер. Обзор пулов —
// перечень, а не лента: четыре колонки без полных рядов, видны все пулы до предела.
&Тест
Процедура СпискиГлавнойПолнымиРядамиПоЧетыре() Экспорт

	Окружение = Новый ЗамерОкруженияЛендинга();
	Пул = Новый ПулЗаглушка(1, "main", "custom");
	Для Номер = 1 По 8 Цикл
		Пакет = ПакетЛендинга(Номер);
		Окружение.ДобавитьНовинку(Пакет, Пул, "1.0.0");
		Окружение.ДобавитьПопулярный(Пакет, Пул, Номер * 10);
	КонецЦикла;
	Для Номер = 1 По 3 Цикл
		Окружение.ДобавитьПул(Новый ПулЗаглушка(Номер, "pool" + Номер, "custom"), Номер);
	КонецЦикла;

	Ответ = Новый ОтветСтраницыЗаглушка();
	ЭкранЛендинга(Окружение, Новый ЗамерХранилищаПровенанса(),
		Новый ПлашкиПула(Неопределено, Неопределено, UI.Тексты, UI.ЗначкиМеты))
		.Показать(Ответ, Новый Соответствие(), Неопределено);

	Сетки = КускиРазметки(Ответ.ТелоТекст, "<div class=""grid ");
	Ожидаем.Что(Сетки.Количество(), "КОНТРОЛЬ: сетки пулов, новинок и популярного на странице").Равно(3);

	ОбзорПулов = Сетки[0];
	Ожидаем.Что(Лев(ОбзорПулов, СтрНайти(ОбзорПулов, ">")), "обзор пулов — четыре колонки без полных рядов")
		.Содержит("class=""grid grid--4""");
	Для Номер = 1 По 3 Цикл
		Ожидаем.Что(ОбзорПулов, "пул pool" + Номер + " в обзоре").Содержит(">pool" + Номер + "<");
	КонецЦикла;
	// пул — карточкой объекта, как пакет: значок стоит в имени отдельно от ссылки (не прилипает к ней)
	Имя = Сред(ОбзорПулов, СтрНайти(ОбзорПулов, "objcard__name"));
	Имя = Лев(Имя, СтрНайти(Имя, "</h3>"));
	Ожидаем.Что(СтрЧислоВхождений(ОбзорПулов, "class=""objcard"""), "три пула — три карточки объекта").Равно(3);
	Ожидаем.Что(СтрНайти(Имя, "<svg") > 0 И СтрНайти(Имя, "<svg") < СтрНайти(Имя, "<a "),
		"значок пула — перед ссылкой, а не внутри неё").ЭтоИстина();

	Для Индекс = 1 По 2 Цикл
		Лента = Сетки[Индекс];
		Ожидаем.Что(Лев(Лента, СтрНайти(Лента, ">")), "лента — четыре колонки полными рядами")
			.Содержит("class=""grid grid--4 grid--full-rows""");
		Ожидаем.Что(СтрЧислоВхождений(Лента, "visually-hidden"">версия: "), "в ленте все восемь карточек")
			.Равно(8);
	КонецЦикла;

КонецПроцедуры

// Блок «Мои пакеты» показывает горстку карточек, и провенанс спрашивается по ней одним
// чтением: восемь пакетов в управлении и сорок стоят одного обращения, а строк читается
// столько, сколько карточек показано.
&Тест
Процедура ЦенаПровенансаМоихПакетовНеРастётСЧисломПакетов() Экспорт

	Малый = ЦенаПровенансаМоихПакетов(8);
	Большой = ЦенаПровенансаМоихПакетов(40);

	Ожидаем.Что(Большой.Запросов, СтрШаблон(
		"сорок пакетов стоят столько же обращений за провенансом, сколько восемь: %1 против %2",
		Формат(Большой.Запросов, "ЧГ=0"),
		Формат(Малый.Запросов, "ЧГ=0"))).Равно(Малый.Запросов);

	Ожидаем.Что(Большой.Запросов, "провенанс горстки — одно чтение").Равно(1);
	Ожидаем.Что(Большой.Строк, "прочитаны строки только показанных шести пакетов").Равно(6);

	// счётчик не должен мерить пустую работу: карточки нарисованы, и плашка чужого имени
	// в них есть
	Ожидаем.Что(СтрЧислоВхождений(Большой.Разметка, "visually-hidden"">версия: "),
		"в блоке ровно шесть карточек").Равно(6);
	Ожидаем.Что(СтрЧислоВхождений(Большой.Разметка, ПлашкаЧужогоИмени()),
		"плашка стоит у чужих имён горстки").Равно(3);
	// в этом блоке нет пакета, которым смотрящий не управлял бы: шестерёнка стоит у всех
	Ожидаем.Что(СтрЧислоВхождений(Большой.Разметка, "/settings"""),
		"шестерёнка настроек стоит у каждой из шести карточек").Равно(6);

КонецПроцедуры

// Резерв в списке — пакет без единой версии — спрашивается у базы одним агрегатом на весь
// список: строк версий витрина не читает, и сорок чужих имён стоят столько же, сколько восемь.
&Тест
Процедура ЦенаРезервовСпискаНеРастётСЧисломПакетов() Экспорт

	Малый = ЦенаРезервовСписка(8);
	Большой = ЦенаРезервовСписка(40);

	Ожидаем.Что(Большой.Запросов, "резервы сорока чужих имён — одно обращение").Равно(1);
	Ожидаем.Что(Малый.Запросов, "и восьми — тоже одно").Равно(1);
	Ожидаем.Что(Большой.Строк, "строк версий витрина не читает вовсе").Равно(0);
	Ожидаем.Что(Большой.Резервов, "плашка «резерв» стоит у каждого третьего — пакета без версий")
		.Равно(13);

КонецПроцедуры

// Своих имён нет, у каждого третьего пакета нет и версий: о резерве спрашивается весь список.
Функция ЦенаРезервовСписка(Знач ЧислоПакетов)

	Публикации = Новый ЗамерХранилищаВерсий();
	РеестрВерсий = Новый СервисВерсий(Публикации, Новый ФейкПакетовДляЛетописи(),
		Неопределено, Неопределено, Неопределено);
	Резервы = Новый СервисРезервированияИмён(Неопределено, Неопределено, РеестрВерсий, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);
	Витрина = Новый ВитринаПакетов(Новый СервисПроисхождения(Новый ЗамерХранилищаПровенанса()),
		Неопределено, UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Резервы);

	Строки = Новый Массив();
	Пул = Новый Структура("Имя, Идентификатор", "main", 1);
	Для Номер = 1 По ЧислоПакетов Цикл
		Строки.Добавить(Новый Структура("Пакет, Пул", ПакетЛендинга(Номер), Пул));
		Если Номер % 3 <> 0 Тогда
			Публикации.ДобавитьПубликацию(Номер, "1.0.0", '20260101120000');
		КонецЕсли;
	КонецЦикла;

	Публикации.Обнулить();
	Карточки = Витрина.Карточки(Строки);

	Резервов = 0;
	Для Каждого Карточка Из Карточки Цикл
		Для Каждого Плашка Из Карточка.Плашки Цикл
			Если Плашка.Текст = UI.Тексты.Текст("public.showcase.reserve.tag") Тогда
				Резервов = Резервов + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Запросов, Строк, Резервов", Публикации.Запросов(), Публикации.Строк(), Резервов);

КонецФункции

// Куски разметки, каждый — от начала образца до следующего такого же.
Функция КускиРазметки(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Каждое второе имя пришло с апстрима: ответы карточек разные, а не однородная сетка.
Функция ЦенаКарточекЛендинга(Знач ЧислоПакетов)

	Хранилище = Новый ЗамерХранилищаПровенанса();
	Окружение = Новый ЗамерОкруженияЛендинга();
	Пул = Новый ПулЗаглушка(1, "main", "custom");

	Для Номер = 1 По ЧислоПакетов Цикл
		Пакет = ПакетЛендинга(Номер);
		Окружение.ДобавитьНовинку(Пакет, Пул, "1.0.0");
		Окружение.ДобавитьПопулярный(Пакет, Пул, Номер * 10);
		// имя со своими версиями — только у каждого второго
		Если Номер % 2 = 1 Тогда
			Хранилище.Добавить(Номер, Номер, "свой");
		Иначе
			Хранилище.Добавить(Номер, Номер, "апстрим");
		КонецЕсли;
	КонецЦикла;

	// строки, которых на странице нет: разрез по всей таблице выдал бы себя лишними
	Для Номер = 1 По ЧужихВЗамере() Цикл
		Хранилище.Добавить(1000 + Номер, 1000 + Номер, "свой");
	КонецЦикла;

	Ответ = Новый ОтветСтраницыЗаглушка();
	Хранилище.Обнулить();
	ЭкранЛендинга(Окружение, Хранилище).Показать(Ответ, Новый Соответствие(), Неопределено);

	Итог = Новый Структура();
	Итог.Вставить("Запросов", Хранилище.Запросов());
	Итог.Вставить("Строк", Хранилище.Строк());
	Итог.Вставить("Разметка", Ответ.ТелоТекст);
	Возврат Итог;

КонецФункции

// Экран лендинга — настоящий контроллер: сторож краснеет и при вопросе о провенансе на карточку.
Функция ЭкранЛендинга(Знач Окружение, Знач Хранилище, Знач Плашки = Неопределено)

	Витрина = Новый ВитринаПакетов(Новый СервисПроисхождения(Хранилище), Неопределено,
		UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Новый ФейкОкруженияВитрины());
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.instance.url", "https://hub.example.test");
	Команды = Новый КомандыOpm(Новый АдресИнстанса(Настройки), Новый ЗаголовкиHTTP());

	Возврат Новый КонтроллерЛендинга(Окружение, Витрина, UI.КарточкаОбъекта, Плашки,
		UI.Кит, Окружение, UI.Тексты,
		Новый Брендирование(Новый НастройкиЗаглушка()), Окружение, Окружение, Команды,
		Окружение, UI.АдресаКабинета, Новый АдресаСтраниц(), UI.АдресаКаталога);

КонецФункции

// Каждое второе имя горстки пришло с апстрима: свежайшие шесть дают три плашки.
Функция ЦенаПровенансаМоихПакетов(Знач ЧислоПакетов)

	Хранилище = Новый ЗамерХранилищаПровенанса();
	Публикации = Новый ЗамерХранилищаВерсий();
	Агрегаты = Новый СчитающееХранилищеАгрегатов();

	Сейчас = ТекущаяУниверсальнаяДата();
	Пакеты = Новый Массив();

	Для Номер = 1 По ЧислоПакетов Цикл
		Свежесть = Сейчас - (ЧислоПакетов - Номер) * 86400;
		Пакеты.Добавить(ЗаписьУправления(Номер, СтрШаблон("пакет-%1", Формат(Номер, "ЧГ=0")),
			Свежесть));
		Агрегаты.Добавить(Номер, Номер * 10);
		Публикации.ДобавитьПубликацию(Номер, СтрШаблон("1.0.%1", Формат(Номер, "ЧГ=0")), Свежесть);
		Хранилище.Добавить(Номер, Номер, ?(Номер % 2 = 1, "свой", "апстрим"));
	КонецЦикла;

	Хранилище.Обнулить();
	Разметка = РазметкаСекции(БлокМоихПакетовНад(Публикации, Агрегаты, Хранилище).СекцияСводки(Пакеты));

	Итог = Новый Структура();
	Итог.Вставить("Запросов", Хранилище.Запросов());
	Итог.Вставить("Строк", Хранилище.Строк());
	Итог.Вставить("Разметка", Разметка);
	Возврат Итог;

КонецФункции

Функция БлокМоихПакетовНад(Знач Публикации, Знач Агрегаты, Знач Хранилище)

	РеестрВерсий = Новый СервисВерсий(Публикации, Новый ФейкПакетовДляЛетописи(),
		Неопределено, Неопределено, Неопределено);
	Скачивания = Новый СлужбаСтатистикиСкачиваний(Новый СчётчикСкачиванийВПамяти(), Агрегаты,
		Неопределено, Новый НастройкиЗаглушка(), Новый ГотовностьЗаглушка(), Новый ЗапускВФонеЗаданием());
	Витрина = Новый ВитринаПакетов(Новый СервисПроисхождения(Хранилище), Неопределено,
		UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Новый ФейкОкруженияВитрины());

	Возврат Новый ВитринаМоихПакетов(UI.Кит, Витрина, UI.КарточкаОбъекта,
		РеестрВерсий, Скачивания, UI.АдресаКаталога, UI.Тексты);

КонецФункции

Функция ПакетЛендинга(Знач Номер)

	Имя = СтрШаблон("winow-%1", Формат(Номер, "ЧГ=0"));
	Возврат Новый Структура("Идентификатор, ПулИдентификатор, Имя, ИмяНижнийРегистр,"
		+ " Описание, Устарел, Скрыт, ПоследняяПубликация",
		Номер, 1, Имя, НРег(Имя), "", Ложь, Ложь, '20260101120000');

КонецФункции

// Подсказка плашки, а не её текст: «с апстрима» стоит в разметке дважды, и счёт по нему удвоился бы.
Функция ПлашкаЧужогоИмени()
	Возврат "Ни одна версия этого имени";
КонецФункции

// Чужих строк заведомо больше, чем показанных: разрез по всей таблице выдал бы себя.
Функция ЧужихВЗамере()
	Возврат 30;
КонецФункции

#КонецОбласти

#Область СтраницаПакета

// Страница пакета спрашивает о пакете два разреза — версии и провенанс — по одному разу на запрос:
// двадцать версий стоят столько же, сколько две. Провенанс отвечает на все четыре вопроса страницы
// одним снимком, а состав каналов приезжает вместе с тегами.
&Тест
Процедура ЦенаСтраницыПакетаНеРастётСЧисломВерсий() Экспорт

	НаДвух = ЦенаСтраницыПакета(2, Ложь);
	НаДвадцати = ЦенаСтраницыПакета(20, Ложь);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"двадцать версий стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Обращений, "ЧГ=0"),
		Формат(НаДвух.Обращений, "ЧГ=0"))).Равно(НаДвух.Обращений);

	Ожидаем.Что(НаДвадцати.ЗапросовВерсий, "версии пакета — одно чтение на запрос").Равно(1);
	Ожидаем.Что(НаДвадцати.ЗапросовПровенанса, "провенанс пакета — одно чтение на запрос").Равно(1);

	// строки: список версий страница читает ровно один раз, а не по разу на потребителя
	Ожидаем.Что(НаДвадцати.СтрокВерсий, "прочитано ровно двадцать строк версий").Равно(20);
	Ожидаем.Что(НаДвадцати.СтрокПровенанса, "прочитано ровно двадцать строк провенанса").Равно(20);

	// счётчик не должен мерить пустую работу: страница нарисована, каналы на ней есть
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "<details><summary>"),
		"история показана у каждого из двух каналов: " + Лев(НаДвадцати.Разметка, 400)).Равно(2);
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "opm install") > 0,
		"команда установки в шапке напечатана").ЭтоИстина();

КонецПроцедуры

// Плоский список версий печатает у каждой строки значки «с апстрима» и «доверенный конвейер» —
// оба из снимка провенанса, одним чтением на список, а не вопросом на строку.
&Тест
Процедура ЦенаПлоскогоСпискаВерсийНеРастётСЧисломВерсий() Экспорт

	НаДвух = ЦенаСтраницыПакета(2, Истина);
	НаДвадцати = ЦенаСтраницыПакета(20, Истина);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"двадцать версий плоским списком стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Обращений, "ЧГ=0"),
		Формат(НаДвух.Обращений, "ЧГ=0"))).Равно(НаДвух.Обращений);

	Ожидаем.Что(НаДвадцати.ЗапросовПровенанса,
		"значки каждой строки — ответы одного снимка").Равно(1);
	Ожидаем.Что(НаДвадцати.ЗапросовВерсий, "версии пакета — одно чтение на запрос").Равно(1);

	// счётчик не должен мерить пустую работу: значок доверенного конвейера в таблице есть
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "доверенным конвейером") > 0,
		"значок доверенного конвейера напечатан").ЭтоИстина();

КонецПроцедуры

// Скачивания версий плоский список берёт одним разрезом на пакет, а не вопросом на строку:
// двадцать строк стоят столько же чтений агрегатов, сколько две, и каждая показывает своё.
&Тест
Процедура ЦенаСкачиванийВерсийНеРастётСЧисломВерсий() Экспорт

	НаДвух = ЦенаСтраницыПакета(2, Истина);
	НаДвадцати = ЦенаСтраницыПакета(20, Истина);

	Ожидаем.Что(НаДвадцати.ЗапросовСкачиваний, СтрШаблон(
		"двадцать версий стоят столько же чтений скачиваний, сколько две: %1 против %2",
		Формат(НаДвадцати.ЗапросовСкачиваний, "ЧГ=0"),
		Формат(НаДвух.ЗапросовСкачиваний, "ЧГ=0"))).Равно(НаДвух.ЗапросовСкачиваний);

	// счётчик не должен мерить пустую работу: число каждой версии стоит в таблице
	Показано = 0;
	Для Номер = 1 По 20 Цикл
		Число_ = СкачиванийВерсииЗамера(СтрШаблон("1.0.%1", Формат(Номер, "ЧГ=0")));
		Показано = Показано + ?(СтрНайти(НаДвадцати.Разметка,
			">" + Формат(Число_, "ЧГ=0") + "</td>") > 0, 1, 0);
	КонецЦикла;
	Ожидаем.Что(Показано, "у каждой из двадцати версий её число скачиваний").Равно(20);

КонецПроцедуры

// В меню страницы пакета горит дорога каталога, а смена темы возвращает на саму страницу
// пакета с её параметрами — не в каталог. Мир тот же, что у замеров, каркас — настоящий.
&Тест
Процедура СменаТемыСоСтраницыПакетаВозвращаетНаНеё() Экспорт

	Мир = МирПакета(3, 2);
	Экран = ЭкранПакета(Мир, UI.Каркас);
	Адрес = "/pools/main/packages/winow/versions?flat=1";

	Экран.Версии(Неопределено, "main", "winow", Новый Соответствие(), Неопределено, "1", Адрес);
	Страница = Мир.Окружение.ОтданнаяРазметка();

	Ожидаем.Что(СтрНайти(Страница, "<html") > 0, "КОНТРОЛЬ: страница собрана настоящим каркасом")
		.ЭтоИстина();
	Ожидаем.Что(Новый ФормаТемыСтраницы().ПутьВозврата(Страница), "смена темы — на ту же вкладку пакета")
		.Равно(Адрес);

КонецПроцедуры

// Сбой статистики не роняет таблицу версий: как и шапка, она показывает ноль. Разовый отказ
// базы достаётся таблице, потому что шапку разогревает первый показ: её сумма живёт в разрезе
// службы и в базу второй раз не ходит.
&Тест
Процедура СбойСтатистикиПоказываетВТаблицеВерсийНоль() Экспорт

	Мир = МирПакета(3, 2);
	Экран = ЭкранПакета(Мир);
	ПлоскийСписок(Экран, Мир);

	Мир.Агрегаты.ОтказатьОдинРаз();
	СоСбоем = ПлоскийСписок(Экран, Мир);

	Ожидаем.Что(СтрЧислоВхождений(СоСбоем, ">0</td>"),
		"каждая из трёх версий показывает ноль, а страница нарисована: " + СоСбоем).Равно(3);
	Для Номер = 1 По 3 Цикл
		Ожидаем.Что(СтрНайти(СоСбоем, СкачиванийВЯчейке(Номер)),
			"настоящего числа версии при сбое в таблице нет").Равно(0);
	КонецЦикла;

	// самотест: отказ достался таблице, и следующий показ снова спрашивает базу
	Ожидаем.Что(СтрНайти(ПлоскийСписок(Экран, Мир), СкачиванийВЯчейке(1)) > 0,
		"после сбоя таблица показывает настоящие числа").ЭтоИстина();

КонецПроцедуры

// Сбой статистики не роняет и ответ API: скачивания в нём нулевые, а не пятисотка, — в списке
// версий, в одной версии и в срезе изменений, по которому идёт зеркало.
&Тест
Процедура СбойСтатистикиПоказываетВAPIНоль() Экспорт

	Мир = МирПакета(3, 2);
	Сборщик = Новый СборщикКарточкиПакета(Мир.Версии, Неопределено, Мир.Метки, Неопределено,
		СлужбаСкачиваний(Мир.Агрегаты), Неопределено, Неопределено, Неопределено, Мир.Провенанс);
	Срез = Новый СборщикСрезаИзменений(Мир.Окружение, Мир.Версии, Мир.Метки, Мир.Провенанс, Сборщик);
	Версия = Мир.Версии.ВерсииПакетаДляЧтения(Мир.Пакет.Идентификатор)[0];

	Мир.Агрегаты.ОтказатьОдинРаз();
	Ожидаем.Что(СкачиванияВерсийОтвета(Сборщик.ВерсииJSON(Мир.Пакет)),
		"список версий при сбое — нули").Равно("0,0,0");

	Мир.Агрегаты.ОтказатьОдинРаз();
	ВерсииСреза = Новый Массив();
	Для Каждого Изменение Из Срез.Срез(Мир.Пул, Неопределено).Изменения Цикл
		ВерсииСреза.Добавить(Изменение.Версия);
	КонецЦикла;
	Ожидаем.Что(СкачиванияВерсийОтвета(ВерсииСреза), "срез изменений при сбое — нули").Равно("0,0,0");

	Мир.Агрегаты.ОтказатьОдинРаз();
	Ожидаем.Что(Сборщик.ВерсияJSON(Версия).downloads, "одна версия при сбое — ноль").Равно(0);

	// самотест: нули выше дал отказ, а не пустой засев
	Ожидаем.Что(Сборщик.ВерсияJSON(Версия).downloads, "без сбоя у версии её число")
		.Равно(СкачиванийВерсииЗамера(Версия.Версия));

КонецПроцедуры

// Состав ручных каналов приезжает одним запросом на пакет: три канала стоят столько же, сколько один.
&Тест
Процедура ЦенаВкладкиВерсийНеРастётСЧисломКаналов() Экспорт

	СОдним = ЦенаСтраницыПакета(6, Ложь, 1);
	СТремя = ЦенаСтраницыПакета(6, Ложь, 3);

	Ожидаем.Что(СТремя.ЗапросовМетокТегов, СтрШаблон(
		"три канала стоят столько же чтений состава, сколько один: %1 против %2",
		Формат(СТремя.ЗапросовМетокТегов, "ЧГ=0"),
		Формат(СОдним.ЗапросовМетокТегов, "ЧГ=0"))).Равно(СОдним.ЗапросовМетокТегов);

	// счётчик не должен мерить пустую работу: все три канала показаны
	Ожидаем.Что(СтрЧислоВхождений(СТремя.Разметка, "<details><summary>"),
		"история показана у каждого из трёх каналов").Равно(3);

КонецПроцедуры

// `/api/v1/.../versions` — горячий путь `opm`: его резолв диапазона спрашивает этот адрес
// на каждой установке. Метки и признак доверенного конвейера берутся двумя разрезами
// на весь список, а не по паре вопросов на версию.
&Тест
Процедура ЦенаВерсийJSONНеРастётСЧисломВерсий() Экспорт

	НаДвух = ЦенаВерсийJSON(2);
	НаДвадцати = ЦенаВерсийJSON(20);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"двадцать версий стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Обращений, "ЧГ=0"),
		Формат(НаДвух.Обращений, "ЧГ=0"))).Равно(НаДвух.Обращений);

	Ожидаем.Что(НаДвадцати.ЗапросовМеток, "метки всех версий — одно чтение").Равно(1);
	Ожидаем.Что(НаДвадцати.ЗапросовПровенанса, "доверенные версии — одно чтение").Равно(1);
	Ожидаем.Что(НаДвадцати.ЗапросовВерсий, "список версий — одно чтение").Равно(1);
	Ожидаем.Что(НаДвадцати.ЗапросовСкачиваний, "скачивания всех версий — одно чтение").Равно(1);

	// счётчик не должен мерить пустую работу: метки и признак доехали до JSON
	Ожидаем.Что(НаДвадцати.Версий, "в ответе все двадцать версий").Равно(20);
	Ожидаем.Что(НаДвадцати.СМетками, "метка версии в ответе есть").Равно(1);
	Ожидаем.Что(НаДвадцати.Доверенных, "признак доверенного конвейера в ответе есть").Равно(1);
	Ожидаем.Что(НаДвадцати.СоСвоимиСкачиваниями, "у каждой версии в ответе её скачивания")
		.Равно(20);

КонецПроцедуры

// Срез изменений зеркала спрашивается по кругу: границу момента ставит база, а метки
// и провенанс порции приезжают двумя разрезами, а не парой вопросов на версию.
&Тест
Процедура ЦенаСрезаИзмененийНеРастётСЧисломВерсий() Экспорт

	НаДвух = ЦенаСрезаИзменений(2);
	НаДвадцати = ЦенаСрезаИзменений(20);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"двадцать версий стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Обращений, "ЧГ=0"),
		Формат(НаДвух.Обращений, "ЧГ=0"))).Равно(НаДвух.Обращений);

	Ожидаем.Что(НаДвадцати.ЗапросовМеток, "метки всей порции — одно чтение").Равно(1);
	Ожидаем.Что(НаДвадцати.ЗапросовПровенанса, "провенанс всей порции — одно чтение").Равно(1);
	Ожидаем.Что(НаДвадцати.ЗапросовСкачиваний, "скачивания всей порции — одно чтение").Равно(1);

	// счётчик не должен мерить пустую работу: срез действительно перечислил версии
	Ожидаем.Что(НаДвадцати.Изменений, "в срезе все двадцать версий").Равно(20);
	Ожидаем.Что(НаДвадцати.СоСвоимиСкачиваниями, "у каждой версии среза её скачивания")
		.Равно(20);

КонецПроцедуры

// Момент отсекает база, а не BSL: срез «что нового с прошлого обхода» читает изменившиеся
// строки, а не весь состав пула. Иначе зеркало вычитывало бы пул целиком на каждом обходе.
&Тест
Процедура СрезПослеМоментаЧитаетТолькоИзменившиесяСтроки() Экспорт

	Замер = ЦенаСрезаИзменений(20, '20260601000000');

	Ожидаем.Что(Замер.Изменений, "после момента изменилась одна версия").Равно(1);
	Ожидаем.Что(Замер.СтрокВерсий, СтрШаблон(
		"прочитана одна строка версий, а не весь пул (%1)",
		Формат(Замер.СтрокВерсий, "ЧГ=0"))).Равно(1);

КонецПроцедуры

Функция ЦенаСтраницыПакета(Знач ЧислоВерсий, Знач Плоско, Знач ЧислоКаналов = 2)

	Мир = МирПакета(ЧислоВерсий, ЧислоКаналов);
	Экран = ЭкранПакета(Мир);
	Ответ = Неопределено; // ответ winow: страницу перехватывает окружение замера

	Обнулить(Мир);
	Экран.Версии(Ответ, "main", "winow", Новый Соответствие(), Неопределено,
		?(Плоско, "1", ""));

	Итог = Замер(Мир);
	Итог.Вставить("Разметка", Мир.Окружение.ОтданнаяРазметка());
	Возврат Итог;

КонецФункции

Функция ЦенаВерсийJSON(Знач ЧислоВерсий)

	Мир = МирПакета(ЧислоВерсий, 2);
	Сборщик = Новый СборщикКарточкиПакета(Мир.Версии, Неопределено, Мир.Метки, Неопределено,
		СлужбаСкачиваний(Мир.Агрегаты), Неопределено, Неопределено, Неопределено, Мир.Провенанс);

	Обнулить(Мир);
	Массив = Сборщик.ВерсииJSON(Мир.Пакет);

	СМетками = 0;
	Доверенных = 0;
	СоСвоимиСкачиваниями = 0;
	Для Каждого Версия Из Массив Цикл
		СМетками = СМетками + ?(Версия.labels.Количество() > 0, 1, 0);
		Доверенных = Доверенных + ?(Версия.trusted_workflow = Истина, 1, 0);
		СоСвоимиСкачиваниями = СоСвоимиСкачиваниями
			+ ?(Версия.downloads = СкачиванийВерсииЗамера(Версия.version), 1, 0);
	КонецЦикла;

	Итог = Замер(Мир);
	Итог.Вставить("Версий", Массив.Количество());
	Итог.Вставить("СМетками", СМетками);
	Итог.Вставить("Доверенных", Доверенных);
	Итог.Вставить("СоСвоимиСкачиваниями", СоСвоимиСкачиваниями);
	Возврат Итог;

КонецФункции

Функция ЦенаСрезаИзменений(Знач ЧислоВерсий, Знач Момент = Неопределено)

	Мир = МирПакета(ЧислоВерсий, 2);
	Сборщик = Новый СборщикКарточкиПакета(Мир.Версии, Неопределено, Мир.Метки, Неопределено,
		СлужбаСкачиваний(Мир.Агрегаты), Неопределено, Неопределено, Неопределено, Мир.Провенанс);
	Срез = Новый СборщикСрезаИзменений(Мир.Окружение, Мир.Версии, Мир.Метки, Мир.Провенанс, Сборщик);

	Обнулить(Мир);
	Результат = Срез.Срез(Мир.Пул, Момент);

	СоСвоимиСкачиваниями = 0;
	Для Каждого Изменение Из Результат.Изменения Цикл
		СоСвоимиСкачиваниями = СоСвоимиСкачиваниями + ?(Изменение.Версия.downloads
			= СкачиванийВерсииЗамера(Изменение.Версия.version), 1, 0);
	КонецЦикла;

	Итог = Замер(Мир);
	Итог.Вставить("Изменений", Результат.Изменения.Количество());
	Итог.Вставить("СоСвоимиСкачиваниями", СоСвоимиСкачиваниями);
	Возврат Итог;

КонецФункции

// Мир одного пакета: N версий, ручные каналы и провенанс; последняя версия изменена позже прочих.
Функция МирПакета(Знач ЧислоВерсий, Знач ЧислоКаналов)

	Хранилища = Новый Структура();
	Хранилища.Вставить("ХранилищеВерсий", Новый ЗамерХранилищаВерсий());
	Хранилища.Вставить("ХранилищеПровенанса", Новый ЗамерХранилищаПровенанса());
	Хранилища.Вставить("ХранилищеТегов", Новый ЗамерХранилищаТегов());
	Хранилища.Вставить("ХранилищеМетокТегов", Новый ЗамерХранилищаМетокТегов());
	Хранилища.Вставить("ХранилищеМетокВерсий", Новый ЗамерХранилищаМетокВерсий());
	Хранилища.Вставить("Агрегаты", Новый СчитающееХранилищеАгрегатов());
	Хранилища.Вставить("ЗапросовСкачиванийДоЗамера", 0);

	Для Номер = 1 По ЧислоВерсий Цикл
		// последняя версия тронута позже прочих: по ней видно, что границу момента
		// в срезе изменений ставит база, а не отбор в BSL
		Момент = ?(Номер = ЧислоВерсий, '20260801120000', '20260101120000');
		Хранилища.ХранилищеВерсий.Добавить(Номер, ПакетЗамера().Идентификатор,
			СтрШаблон("1.0.%1", Формат(Номер, "ЧГ=0")), 1, 0, Номер, Момент);
		Хранилища.ХранилищеПровенанса.Добавить(ПакетЗамера().Идентификатор, Номер, "свой",
			Номер = 1);
		Хранилища.Агрегаты.Добавить(ПакетЗамера().Идентификатор,
			СкачиванийВерсииЗамера(СтрШаблон("1.0.%1", Формат(Номер, "ЧГ=0"))), Номер);
	КонецЦикла;
	Хранилища.ХранилищеМетокВерсий.Присвоить(1, "dev");

	Для Номер = 1 По ЧислоКаналов Цикл
		Хранилища.ХранилищеТегов.ДобавитьРучной(Номер, ПакетЗамера().Идентификатор,
			СтрШаблон("канал%1", Формат(Номер, "ЧГ=0")), Номер = 1);
		Хранилища.ХранилищеМетокТегов.Пометить(Номер, Номер);
	КонецЦикла;

	Окружение = Новый ЗамерОкруженияСтраницы();
	Окружение.ЗадатьПул(ПулЗамера());
	Окружение.ДобавитьПакет(ПакетЗамера());

	Мир = Хранилища;
	Мир.Вставить("Окружение", Окружение);
	Мир.Вставить("Пул", ПулЗамера());
	Мир.Вставить("Пакет", ПакетЗамера());
	СобратьРеестр(Мир);
	Возврат Мир;

КонецФункции

// Доменные службы реестра поверх считающих хранилищ — те же классы, что в живом хабе.
Процедура СобратьРеестр(Мир)

	Сравнитель = Новый СравнительВерсий();
	Резолвер = Новый РезолверВерсий(Сравнитель);
	Провенанс = Новый СервисПроисхождения(Мир.ХранилищеПровенанса);
	// хранилище пакетов реестру версий на путях чтения не нужно: страница только читает
	РеестрВерсий = Новый СервисВерсий(Мир.ХранилищеВерсий, Неопределено, Сравнитель,
		Резолвер, Провенанс, Неопределено);
	// снимок каналов собран руками, без кэша: каждое чтение идёт в считающие хранилища
	БезТеговПула = Новый ЗамерБезТеговПула();
	Снимки = Новый СнимкиКаналов(Мир.ХранилищеТегов, Мир.ХранилищеМетокТегов, БезТеговПула,
		БезТеговПула, БезТеговПула, БезТеговПула, Новый НастройкаТеговПула());
	Наследование = Новый НаследованиеТегов(Снимки, Мир.ХранилищеТегов, БезТеговПула, БезТеговПула,
		БезТеговПула, БезТеговПула, Новый НастройкаТеговПула(), Новый РежимТега(), Новый ПроисхождениеТега());
	Состав = Новый СоставКаналов(Мир.ХранилищеМетокТегов, РеестрВерсий, Резолвер,
		Новый ОтборВерсийПоПравилу(Резолвер), Новый РежимТега(), Снимки);
	Каналы = Новый СервисТегов(Мир.ХранилищеТегов, РеестрВерсий,
		Новый ОтборВерсийПоПравилу(Резолвер), Новый РежимТега(), Неопределено, Состав,
		Новый СтильТега(), Новый ЗначокТега(), Снимки, Наследование, БезТеговПула,
		Новый ПроисхождениеТега());

	Мир.Вставить("Провенанс", Провенанс);
	Мир.Вставить("Версии", РеестрВерсий);
	Мир.Вставить("Теги", Каналы);
	Мир.Вставить("Метки", Новый СервисМетокВерсий(Мир.ХранилищеМетокВерсий));
	Мир.Вставить("Спеки", Новый РезолверСпецификации(РеестрВерсий, Каналы, Сравнитель,
		Резолвер, Провенанс));

КонецПроцедуры

// Экран пакета — настоящий контроллер: сторож краснеет и тогда, когда контекст не доходит до вкладок.
// Каркас по умолчанию — окружение замера: цена данных, а не обрамления.
Функция ЭкранПакета(Знач Мир, Знач Каркас = Неопределено)

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.instance.url", "https://hub.example.test");
	Команды = Новый КомандыOpm(Новый АдресИнстанса(Настройки), Новый ЗаголовкиHTTP());

	// служба статистики одна на процесс: шапка и таблица версий спрашивают одну и ту же
	Статистика = СлужбаСкачиваний(Мир.Агрегаты);
	Вкладка = Новый ВкладкаВерсий(UI.Кит, UI.Тексты, Мир.Теги, Статистика,
		Команды, UI.ПлашкаТега, UI.ЗначкиВерсии, UI.КнопкаСкачивания);
	Витрина = Новый ВитринаПакетов(Мир.Провенанс, Мир.Окружение, UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(),
		Новый ФейкОкруженияВитрины());
	Карточка = Новый КарточкаСсылкиПакета(Новый СервисПрав(Неопределено, Неопределено, Неопределено, Неопределено),
		Новый АдресИнстанса(Настройки), Новый АдресаСтраниц(), UI.Адреса, UI.Бренд, Новый РепозиторийGitHub(Новый РазборАдреса()));

	Возврат Новый КонтроллерПакета(
		Мир.Окружение, Мир.Версии, Мир.Спеки, Мир.Провенанс,
		Неопределено, Команды, Новый ПодсказкаУстановки(Команды, UI.Тексты, UI.Кит),
		UI.КнопкаСкачивания,
		UI.Кит, ?(Каркас = Неопределено, Мир.Окружение, Каркас), UI.Тексты, Витрина,
		UI.ЗначкиВерсии, Вкладка, Неопределено,
		Мир.Окружение, Статистика, Мир.Окружение, Мир.Окружение,
		Мир.Окружение, Мир.Окружение, UI.АдресаКаталога, Новый АдресаСтраниц(), Карточка, Неопределено);

КонецФункции

Процедура Обнулить(Мир)

	Мир.Вставить("ЗапросовСкачиванийДоЗамера", Мир.Агрегаты.Запросов());
	Мир.ХранилищеВерсий.Обнулить();
	Мир.ХранилищеПровенанса.Обнулить();
	Мир.ХранилищеТегов.Обнулить();
	Мир.ХранилищеМетокТегов.Обнулить();
	Мир.ХранилищеМетокВерсий.Обнулить();

КонецПроцедуры

Функция Замер(Знач Мир)

	Итог = Новый Структура();
	Итог.Вставить("ЗапросовВерсий", Мир.ХранилищеВерсий.Запросов());
	Итог.Вставить("ЗапросовПровенанса", Мир.ХранилищеПровенанса.Запросов());
	Итог.Вставить("ЗапросовТегов", Мир.ХранилищеТегов.Запросов());
	Итог.Вставить("ЗапросовМетокТегов", Мир.ХранилищеМетокТегов.Запросов());
	Итог.Вставить("ЗапросовМеток", Мир.ХранилищеМетокВерсий.Запросов());
	Итог.Вставить("ЗапросовСкачиваний", Мир.Агрегаты.Запросов() - Мир.ЗапросовСкачиванийДоЗамера);
	Итог.Вставить("СтрокВерсий", Мир.ХранилищеВерсий.Строк());
	Итог.Вставить("СтрокПровенанса", Мир.ХранилищеПровенанса.Строк());
	Итог.Вставить("Обращений", Итог.ЗапросовВерсий + Итог.ЗапросовПровенанса
		+ Итог.ЗапросовТегов + Итог.ЗапросовМетокТегов + Итог.ЗапросовМеток);
	Возврат Итог;

КонецФункции

// Плоский список версий тем же экраном: разрезы службы статистики живут между показами.
Функция ПлоскийСписок(Знач Экран, Знач Мир)

	Ответ = Неопределено; // ответ winow: страницу перехватывает окружение замера
	Экран.Версии(Ответ, "main", "winow", Новый Соответствие(), Неопределено, "1");
	Возврат Мир.Окружение.ОтданнаяРазметка();

КонецФункции

// Ячейка скачиваний версии 1.0.<Номер> так, как её печатает таблица.
Функция СкачиванийВЯчейке(Знач Номер)
	Возврат ">" + Формат(СкачиванийВерсииЗамера(СтрШаблон("1.0.%1", Формат(Номер, "ЧГ=0"))),
		"ЧГ=0") + "</td>";
КонецФункции

// Скачивания версий ответа API через запятую — в том порядке, в каком их отдал ответ.
Функция СкачиванияВерсийОтвета(Знач ВерсииОтвета)

	Числа = Новый Массив();
	Для Каждого Версия Из ВерсииОтвета Цикл
		Числа.Добавить(Формат(Версия.downloads, "ЧГ=0; ЧН=0"));
	КонецЦикла;
	Возврат СтрСоединить(Числа, ",");

КонецФункции

// Скачивания версии замера: у каждой своё число, по которому её строку видно в разметке.
Функция СкачиванийВерсииЗамера(Знач НомерВерсии)
	Возврат 1000 * Число(СтрЗаменить(НомерВерсии, "1.0.", "")) + 7;
КонецФункции

Функция ПулЗамера()
	Возврат Новый ПулЗаглушка(1, "main", "custom");
КонецФункции

Функция ПакетЗамера()

	Возврат Новый Структура("Идентификатор, ПулИдентификатор, Имя, ИмяНижнийРегистр,"
		+ " Описание, КлючевыеСлова, АдресРепозитория, Лицензия, Устарел, Скрыт,"
		+ " ПоследняяПубликация",
		7, 1, "winow", "winow", "фреймворк", "", "", "MIT", Ложь, Ложь, '20260101120000');

КонецФункции

#КонецОбласти

// поток «пакет» Х4а
#Область РазделВерсийПакета

// Таблица версий в настройках пакета спрашивает домен разом на страницу: версии, теги по версиям,
// ручные теги, доверенные версии и скачивания — по чтению на вопрос. Двадцать версий стоят столько
// же обращений, сколько две, и список версий читается ровно один раз.
&Тест
Процедура ЦенаРазделаВерсийНеРастётСЧисломВерсий() Экспорт

	НаДвух = ЦенаРазделаВерсий(2);
	НаДвадцати = ЦенаРазделаВерсий(20);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"двадцать версий стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Обращений, "ЧГ=0"), Формат(НаДвух.Обращений, "ЧГ=0"))).Равно(НаДвух.Обращений);
	Ожидаем.Что(НаДвадцати.ЗапросовСкачиваний, "скачивания — одно чтение на страницу")
		.Равно(НаДвух.ЗапросовСкачиваний);
	Ожидаем.Что(НаДвадцати.СтрокВерсий, "прочитано ровно двадцать строк версий").Равно(20);

	// счётчик не мерит пустую работу: таблица нарисована, у каждой строки своё меню
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "value=""yank"""),
		"у каждой из двадцати версий форма отзыва").Равно(20);

КонецПроцедуры

Функция ЦенаРазделаВерсий(Знач ЧислоВерсий)

	Мир = МирПакета(ЧислоВерсий, 2);
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), Неопределено);
	Пульт = Новый ПультВерсийПакета(Неопределено, Неопределено, Неопределено, Окна, Неопределено, Неопределено,
		UI.Тексты);
	Витрина = Новый ВитринаВерсийПакета(UI.Кит, Мир.Версии, Мир.Теги, Новый РежимТега(), UI.ПлашкаТега,
		Мир.Провенанс, СлужбаСкачиваний(Мир.Агрегаты), UI.ЗначкиВерсии, Новый ОбъёмТекстом(), Окна, Пульт,
		UI.Тексты);
	Адрес = "/pools/main/packages/winow/settings";

	Обнулить(Мир);
	Секция = Витрина.Секция(Новый Структура("Пакет, Адрес, АдресТегов, Окно", Мир.Пакет, Адрес + "/versions",
		Адрес + "/tags", Неопределено));
	Дом = UI.Кит.ДомНастроек("Настройки пакета", Адрес, "csrf", Секция);
	Дом.Раздел("Версии и метки", "versions").Текущий();
	Разметка = Дом.Рендер();

	Итог = Замер(Мир);
	Итог.Вставить("Разметка", Разметка);
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СессияНаСтранице

// Страница вошедшего читает его сессию один раз — стражем запроса: «Выйти» в меню берёт токен
// у сессии, которую дверь дома довезла контекстом страницы, а не читает её второй раз по куке
// (чтение сессии в бою — ещё и запись скользящего срока).
&Тест
Процедура ЦенаСтраницыВошедшегоОдноЧтениеСессии() Экспорт

	Сессии = Новый СчитающаяСлужбаСессий();
	Страж = Новый ПерехватчикАутентификации(Неопределено, Сессии, Сессии, Новый ЗаголовкиHTTP(),
		Новый УчёткаПринципала());
	Защита = Новый ЗащитаCSRF(Сессии);

	Принципал = Страж.ОпределитьПринципала(Новый Соответствие(), Сессии.Куки());
	Выход = ВыходМенюДома(Защита, Принципал, Сессии.Куки());

	Ожидаем.Что(Сессии.Чтений(), "страница вошедшего читает сессию один раз — стражем").Равно(1);
	Ожидаем.Что(Выход, "«Выйти» в меню — с токеном прочитанной сессии")
		.Содержит("value=""" + Защита.ТокенСессии(Принципал.Сессия) + """");

	// КОНТРОЛЬ: дверь, не довёзшая сессию, оставляет «Выйти» без токена — шапка по куке не читает
	Выход = ВыходМенюДома(Защита, Новый Структура("Пользователь", Принципал.Пользователь), Сессии.Куки());
	Ожидаем.Что(Выход, "без сессии в контексте — форма без токена").Не_().Содержит("name=""_csrf""");
	Ожидаем.Что(Сессии.Чтений(), "и второго чтения нет").Равно(1);

КонецПроцедуры

// «Выйти» меню страницы, отданной настоящей дверью дома на настоящем обрамлении с защитой CSRF.
Функция ВыходМенюДома(Знач Защита, Знач Вошедший, Знач Куки)

	Обрамление = Новый ОбрамлениеХаба(UI.Бренд, UI.Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()),
		UI.Тексты, UI.АдресаКаталога, Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит, UI.Подсветка,
		Неопределено, Неопределено, Неопределено, Неопределено, Защита);
	Каркас = Новый КаркасЗамераШапки(UI.Каркас, Обрамление);
	Ответы = Новый ОтветыНастроек(Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Новый ФейкСервисПрав(), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));

	Модель = Новый Структура("Ключ, Заголовок, Разделы, Секции", "account", "Кабинет",
		Новый Массив(), Новый Массив());
	Ответы.ОтдатьДом(Новый ОтветСтраницыЗаглушка(), Модель, Вошедший, Куки, 200, "/me");

	Возврат Каркас.МенюХаба().Выход.Рендер();

КонецФункции

#КонецОбласти
