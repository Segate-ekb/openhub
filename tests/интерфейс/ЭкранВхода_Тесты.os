// Страницы-ворота как у GitHub: одна узкая колонка со знаком и заголовком, шапка без дорог
// и «Войти», кнопки провайдеров со значками брендов под разделителем «или», строка
// регистрации рамкой, атрибуция базы стран — сноской и только при правиле по стране.
// Страницы строят настоящие контроллеры на настоящем каркасе и обрамлении хаба.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Модули;      // Строка — корень src/модули
Перем Сессия_;     // СессияВыхода — сессия вошедшего: кука, токен формы и дверь выхода
Перем Обрамление;  // ОбрамлениеХаба — обрамление с токеном выхода, как его собирает контейнер
Перем Каркас;      // КаркасСтраницы — каркас кита на этом обрамлении: ворота печатают меню вошедшего

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьЭкраны() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ОкружениеЭкрановВхода");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СессияВыхода");

	UI = Новый СборкаUI().Собрать(Интерфейс);

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ВозвратПослеВхода");
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "АдресПриглашения");
	Для Каждого Имя Из СтрРазделить("РазборФормы,ПосетительЗапроса,СтраницаДоступа,ЗначокПровайдера,"
		+ "АтрибуцияБазыСтран,КонтроллерВходаOIDC,КонтроллерРегистрации,КонтроллерВосстановленияПароля,"
		+ "КонтроллерУстановкиПароля,КонтроллерОнбординга,КонтроллерАдресаПосетителя,"
		+ "КонтроллерПодтвержденияCLI,КонтроллерПодтвержденияEmail,ОтказПоСтране,ГейтФормы", ",") Цикл
		Поиск.Подключить(Интерфейс, Имя);
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура НоваяСессия() Экспорт
	Сессия_ = Новый СессияВыхода();
	Обрамление = Новый ОбрамлениеХаба(UI.Бренд, UI.Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), UI.Тексты,
		UI.АдресаКаталога, Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит, UI.Подсветка,
		Неопределено, Неопределено, Неопределено, Неопределено, Сессия_);
	Каркас = Новый КаркасСтраницы(UI.Кит, UI.Токены, UI.Оформление, UI.Тексты, UI.Модели, UI.Активы,
		Обрамление, UI.МенюХаба);
КонецПроцедуры

#Область ОднаКолонка

// Вход — узкая колонка: знак хаба и «Вход в <название>» сверху, в шапке страницы — только
// знак и тема, без дорог, кнопки «Войти» и единого меню.
&Тест
Процедура ВходУзкойКолонкойСЗаголовкомХаба() Экспорт

	Страница = Вход(НовоеОкружение());

	ПроверитьВорота(Страница, "вход");
	Ожидаем.Что(Колонка(Страница), "заголовок называет хаб тем же именем, что шапка")
		.Содержит(">Вход в " + UI.Бренд.Знак() + "</h1>");
	Ожидаем.Что(Колонка(Страница), "знак хаба в шапке колонки — тот же, что в шапке страницы")
		.Содержит("src=""" + UI.Адреса.АдресЗнака() + """");

КонецПроцедуры

// Остальные ворота — той же колонкой: один заголовок, одна форма, без дорог.
&Тест
Процедура ОстальныеВоротаТойЖеКолонкой() Экспорт

	Окружение = НовоеОкружение();

	ПроверитьВорота(Регистрация(Окружение, "/pools/corp"), "регистрация");
	ПроверитьВорота(Восстановление(Окружение), "восстановление пароля");
	ПроверитьВорота(УстановкаПароля(Окружение), "установка пароля по негодной ссылке");
	ПроверитьВорота(ПервыйЗапуск(Окружение), "мастер первого запуска на готовом хабе");
	ПроверитьВорота(АдресПосетителя(Окружение), "как хаб видит запрос");
	ПроверитьВорота(ПодтверждениеАдреса(Окружение), "подтверждение адреса гостем");
	ПроверитьВорота(ОтказПоСтране(Окружение).ТелоТекст, "отказ по стране");

КонецПроцедуры

// Вводный абзац ворот — подписью шапки колонки, под заголовком и по центру, а не примечанием во всю
// ширину колонки над формой: и строкой словаря, и узлом с данными.
&Тест
Процедура ЛидВоротПодписьюШапкиКолонки() Экспорт

	Окружение = НовоеОкружение();
	Лид = UI.Тексты.Текст("recover.page.lead");
	Ожидаем.Что(ШапкаКолонки(Восстановление(Окружение)), "лид восстановления — в шапке колонки")
		.Содержит(Лид);
	Ожидаем.Что(СтрЧислоВхождений(Восстановление(Окружение), Лид), "и только там").Равно(1);

	Окружение.Войти();
	Ожидаем.Что(ШапкаКолонки(ПодтверждениеCLI(Окружение, "").ТелоТекст), "лид ввода кода CLI — в шапке")
		.Содержит("Введите код, который показал терминал.");
	Ожидаем.Что(ШапкаКолонки(Восстановление(Окружение)), "КОНТРОЛЬ: заголовок в шапке на месте")
		.Содержит("<h1");

КонецПроцедуры

// Мастер первого запуска с формой — та же колонка: поля администратора, требования к паролю
// под полем, одна основная кнопка; форма без сессии на свой адрес.
&Тест
Процедура ОткрытыйМастерТойЖеКолонкой() Экспорт

	Окружение = НовоеОкружение();
	Окружение.ОткрытьМастер();
	Страница = ПервыйЗапуск(Окружение);

	ПроверитьВорота(Страница, "открытый мастер первого запуска");
	Колонка = Колонка(Страница);
	Ожидаем.Что(Колонка, "форма мастера — на свой адрес").Содержит("action=""/setup""");
	Ожидаем.Что(Колонка, "поле логина администратора").Содержит("name=""логин""");
	Ожидаем.Что(Колонка, "поле пароля — новый пароль").Содержит("autocomplete=""new-password""");
	Ожидаем.Что(Колонка, "кнопка создания").Содержит("Создать администратора");
	Ожидаем.Что(СтрНайти(Колонка, "<section class=""card"""), "карточки вокруг мастера нет").Равно(0);

КонецПроцедуры

// Отказ по стране — страница входа той же колонкой: 403, причина уведомлением над формой,
// атрибуция базы — сноской, пока правило есть.
&Тест
Процедура ОтказПоСтранеВКолонкеСАтрибуцией() Экспорт

	Окружение = НовоеОкружение();
	Окружение.ПоставитьПравилоПоСтране();
	Ответ = ОтказПоСтране(Окружение, Атрибуция(Окружение));
	Колонка = Колонка(Ответ.ТелоТекст);

	Ожидаем.Что(Ответ.Код, "отказ по стране — 403").Равно(403);
	Ожидаем.Что(Колонка, "причина — в колонке").Содержит("недоступен из вашего региона");
	Ожидаем.Что(СтрНайти(Колонка, "toast--err"), "и над формой").Меньше(СтрНайти(Колонка, "<form"));
	Ожидаем.Что(Колонка, "атрибуция сноской").Содержит("<p class=""note-footnote"">");

КонецПроцедуры

// /whoami, страну которого назвала база, несёт атрибуцию сноской.
&Тест
Процедура АдресПосетителяСоСтранойИзБазыНесётСноску() Экспорт

	Окружение = НовоеОкружение();
	Окружение.ПоставитьПравилоПоСтране();

	Ожидаем.Что(Колонка(АдресПосетителя(Окружение)), "страна из базы — сноска DB-IP")
		.Содержит("<p class=""note-footnote""><a href=""https://db-ip.com"">");

КонецПроцедуры

#КонецОбласти

#Область ВоротаВошедшего

// Подтверждение входа CLI: та же колонка, а в шапке — учётка, под которой человек разрешает
// ключ, и её меню с «Выйти».
&Тест
Процедура ВходCLIТойЖеКолонкойПодУчёткой() Экспорт

	Окружение = НовоеОкружение();
	Окружение.Войти();

	ВводКода = ПодтверждениеCLI(Окружение, "");
	ПроверитьВорота(ВводКода.ТелоТекст, "ввод кода CLI", Истина);
	ПроверитьУчётку(ВводКода.ТелоТекст, "ввод кода CLI");
	Ожидаем.Что(Колонка(ВводКода.ТелоТекст), "форма кода — с токеном сессии")
		.Содержит("value=""т0кен-теста""");

	Заявка = ПодтверждениеCLI(Окружение, "ABCD-EFGH");
	ПроверитьВорота(Заявка.ТелоТекст, "заявка CLI", Истина);
	ПроверитьУчётку(Заявка.ТелоТекст, "заявка CLI");
	Ожидаем.Что(Колонка(Заявка.ТелоТекст), "заявка — свойствами").Содержит("<dl class=""props"">");
	Ожидаем.Что(Колонка(Заявка.ТелоТекст), "решение — двумя кнопками действия")
		.Содержит("value=""разрешить""");

КонецПроцедуры

// Отказ 429 — уведомлением в колонке, а не страницей ошибки.
&Тест
Процедура ОтказCLIПоПопыткамУведомлениемВКолонке() Экспорт

	Окружение = НовоеОкружение();
	Окружение.Войти();
	Окружение.ЗаперетьПопытки();

	Ответ = ПодтверждениеCLI(Окружение, "ABCD-EFGH");

	Ожидаем.Что(Ответ.Код, "подбор кода — 429").Равно(429);
	ПроверитьВорота(Ответ.ТелоТекст, "отказ CLI по попыткам", Истина);
	Ожидаем.Что(Колонка(Ответ.ТелоТекст), "отказ — уведомлением в колонке").Содержит("toast--err");
	Ожидаем.Что(Колонка(Ответ.ТелоТекст), "КОНТРОЛЬ: заявки отказ не показывает")
		.Не_().Содержит("<dl class=""props"">");

КонецПроцедуры

// Подтверждение адреса вошедшим — та же колонка под учёткой; гостю учётки и «Выйти» нет.
&Тест
Процедура ПодтверждениеАдресаВошедшимПодУчёткой() Экспорт

	Окружение = НовоеОкружение();
	Гостю = ПодтверждениеАдреса(Окружение);
	ПроверитьВорота(Гостю, "подтверждение адреса гостем");
	Ожидаем.Что(СтрНайти(Гостю, "action=""/logout"""), "гостю «Выйти» нет").Равно(0);

	Окружение.Войти();
	Вошедшему = ПодтверждениеАдреса(Окружение);
	ПроверитьВорота(Вошедшему, "подтверждение адреса вошедшим", Истина);
	ПроверитьУчётку(Вошедшему, "подтверждение адреса вошедшим");

КонецПроцедуры

// Регистрация зовёт на вход рамочной строкой, вход — на регистрацию; обе несут тот же возврат.
&Тест
Процедура ВходИРегистрацияЗовутДругДругаРамкойСВозвратом() Экспорт

	Окружение = НовоеОкружение();
	Возврат_ = Новый ВозвратПослеВхода();

	Рамка = Рамка(Вход(Окружение, "/pools/corp"));
	Ожидаем.Что(Рамка, "под формой входа — «Нет аккаунта?»").Содержит("Нет аккаунта?");
	Ожидаем.Что(Рамка, "ссылка регистрации с тем же возвратом")
		.Содержит("href=""" + Экранировать(Возврат_.СВозвратом("/register", "/pools/corp")) + """");

	Рамка = Рамка(Регистрация(Окружение, "/pools/corp"));
	Ожидаем.Что(Рамка, "под формой регистрации — «Уже есть аккаунт?»").Содержит("Уже есть аккаунт?");
	Ожидаем.Что(Рамка, "ссылка входа с тем же возвратом")
		.Содержит("href=""" + Экранировать(Возврат_.АдресВхода("/pools/corp")) + """");

КонецПроцедуры

// «Забыли пароль?» стоит у поля пароля, а не отдельной строкой под формой.
&Тест
Процедура ЗабылиПарольСсылкойУПоляПароля() Экспорт

	Форма = Между(Колонка(Вход(НовоеОкружение())), "<form", "</form>");
	Ссылка = СтрНайти(Форма, "href=""/forgot-password""");
	Поле = СтрНайти(Форма, "name=""пароль""");

	Ожидаем.Что(Ссылка, "ссылка восстановления — внутри формы входа").Больше(0);
	Ожидаем.Что(Ссылка, "и стоит над полем пароля").Меньше(Поле);
	Ожидаем.Что(Форма, "поле пароля — пароль с автозаполнением текущего").Содержит("autocomplete=""current-password""");

КонецПроцедуры

#КонецОбласти

#Область Выход

// «Выйти» в меню несёт токен сессии, которую прочитал страж запроса и довёз контекст страницы, —
// и на страницах хаба, и на воротах вошедшего: дверь выхода без него сессию не гасит. Второй раз
// по куке обрамление сессию не читает: без сессии в контексте токена нет и при куке живой сессии.
&Тест
Процедура ФормаВыходаНесётТокенСессииВМенюИНаВоротах() Экспорт

	Выход = ВыходМеню(Сессия_.Сессия());
	Ожидаем.Что(Выход, "в меню — форма выхода").Содержит("action=""/logout""");
	Ожидаем.Что(Выход, "с токеном сессии из контекста страницы").Содержит("value=""" + Сессия_.Токен() + """");
	Ожидаем.Что(ВыходМеню(Неопределено), "без сессии в контексте — форма без токена")
		.Не_().Содержит("name=""_csrf""");

	// ворота получают сессию от стража запроса, куки сессии у этого запроса нет вовсе
	Окружение = НовоеОкружение();
	Окружение.Войти();
	Выход = Между(ПодтверждениеCLI(Окружение, "").ТелоТекст, "action=""/logout""", "</form>");
	Ожидаем.Что(Выход, "на воротах вошедшего — та же форма в меню").Заполнено();
	Ожидаем.Что(Выход, "и тоже с токеном сессии стража").Содержит("value=""" + Сессия_.Токен() + """");

КонецПроцедуры

// Дверь выхода: без токена сессии или с чужим — 403, сессия цела; с токеном своей формы — сессия
// погашена и переход на главную. Без сессии гасить нечего — переход без вопросов.
&Тест
Процедура ВыходБезТокенаСессииНеГаситСессию() Экспорт

	Дверь = КонтроллерВыхода(НовоеОкружение());

	Для Каждого Тело Из СтрРазделить("|_csrf=чужой-токен", "|") Цикл
		Ответ = Выйти(Дверь, Тело);
		Ожидаем.Что(Ответ.Код, "«" + Тело + "»: отказ").Равно(403);
		Ожидаем.Что(Сессия_.Жива(), "«" + Тело + "»: сессия цела").ЭтоИстина();
		Ожидаем.Что(Строка(Ответ.ПутьРедиректа), "«" + Тело + "»: перехода нет").Равно("");
	КонецЦикла;

	// отказ — ворота вошедшего: причина, его учётка и свежая «Выйти» этой сессии, а не страница входа
	ПроверитьВорота(Ответ.ТелоТекст, "отказ выхода", Истина);
	ПроверитьУчётку(Ответ.ТелоТекст, "отказ выхода");
	Ожидаем.Что(Колонка(Ответ.ТелоТекст), "причина словами").Содержит(UI.Тексты.Текст("access.logout.stale"));
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "name=""пароль"""), "формы пароля нет").Равно(0);

	// КОНТРОЛЬ: форма своей сессии выводит
	Ответ = Выйти(Дверь, "_csrf=" + Сессия_.Токен());
	Ожидаем.Что(Сессия_.Жива(), "с токеном своей сессии — сессия погашена").ЭтоЛожь();
	Ожидаем.Что(Ответ.ПутьРедиректа, "и переход на главную").Равно("/");

	// погашенной сессии гасить нечего: стирается кука, токен не спрашивается
	Ожидаем.Что(Выйти(Дверь, "").ПутьРедиректа, "без живой сессии — переход без отказа").Равно("/");

КонецПроцедуры

// Выход — дело сессии браузера: ключ в заголовке Authorization рядом с кукой живой сессии не делает
// её «чужой» — без токена этой сессии дверь отказывает 403, сессия цела. Возьми дверь принципала по
// заголовкам — ключ без сессии погасил бы чужую сессию без токена.
&Тест
Процедура КлючВЗаголовкеНеГаситСессиюБезТокена() Экспорт

	Дверь = КонтроллерВыхода(НовоеОкружение());
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "Bearer чужой-ключ");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Дверь.Выход(Ответ, Заголовки, Сессия_.Куки(), "POST", "", "203.0.113.1");

	Ожидаем.Что(Ответ.Код, "ключ в заголовке без токена сессии — отказ").Равно(403);
	Ожидаем.Что(Сессия_.Жива(), "сессия цела").ЭтоИстина();
	// КОНТРОЛЬ: фейк стража различает заголовок — сам по себе ключ даёт принципала без сессии
	Ожидаем.Что(Сессия_.ОпределитьПринципала(Заголовки, Сессия_.Куки()).Сессия, "ключ — без сессии")
		.Равно(Неопределено);

КонецПроцедуры

// Учётку выключили, а её сессия в браузере жива: страж её не признаёт, меню с «Выйти» и токеном
// такой человек не увидит. Подделывать выход сессии, которая ничего не открывает, нечего —
// дверь гасит её без токена, а не отказывает 403 с советом нажать «Выйти», которой нет.
&Тест
Процедура СессияВыключеннойУчёткиГаснетБезТокена() Экспорт

	Дверь = КонтроллерВыхода(НовоеОкружение());
	Сессия_.ВыключитьУчётку();

	Ответ = Выйти(Дверь, "");

	Ожидаем.Что(Ответ.Код, "отказа нет").Не_().Равно(403);
	Ожидаем.Что(Сессия_.Жива(), "сессия выключенной учётки погашена").ЭтоЛожь();
	Ожидаем.Что(Ответ.ПутьРедиректа, "и переход на главную").Равно("/");

КонецПроцедуры

#КонецОбласти

#Область Провайдеры

// Кнопка провайдера несёт значок бренда кита; провайдер, бренд которого не угадан, — глиф «ключ».
&Тест
Процедура КнопкиПровайдеровСоЗначкамиБрендов() Экспорт

	Окружение = НовоеОкружение();
	Окружение.ЗадатьПровайдеров(Провайдеры());
	Столбик = Между(Вход(Окружение), "class=""stack""", "</div>");

	Ожидаем.Что(Кнопка(Столбик, "gh"), "у GitHub — логотип бренда")
		.Содержит(UI.Иконка.Отрисовать("бренд:github"));
	Ожидаем.Что(Кнопка(Столбик, "kc"), "у Keycloak бренд угадан по издателю")
		.Содержит(UI.Иконка.Отрисовать("бренд:keycloak"));
	Ожидаем.Что(Кнопка(Столбик, "corp"), "у неизвестного — глиф «ключ»")
		.Содержит(UI.Иконка.Отрисовать("ключ"));
	Ожидаем.Что(Кнопка(Столбик, "corp"), "КОНТРОЛЬ: у неизвестного логотипа бренда нет")
		.Не_().Содержит("icon--brand");
	Ожидаем.Что(Кнопка(Столбик, "gh"), "подпись кнопки — «Войти через <метка>»")
		.Содержит("Войти через GitHub");
	Ожидаем.Что(СтрНайти(Столбик, "button__pic"), "картинок статики на кнопках нет").Равно(0);
	Ожидаем.Что(ЧислоВхождений(Столбик, "button--block"), "все три — во всю ширину").Равно(3);

КонецПроцедуры

// «или» отделяет пароль от провайдеров — и только когда провайдеры есть; заголовка второго
// уровня «Или через провайдера» больше нет.
&Тест
Процедура РазделительТолькоПриПровайдерахИЗаголовкаНет() Экспорт

	Без = НовоеОкружение();
	С = НовоеОкружение();
	С.ЗадатьПровайдеров(Провайдеры());

	Ожидаем.Что(СтрНайти(Вход(Без), "class=""divider"""), "без провайдеров разделителя нет").Равно(0);
	СПровайдерами = Колонка(Вход(С));
	Ожидаем.Что(СПровайдерами, "с провайдерами — разделитель «или»")
		.Содержит("<div class=""divider""><span class=""divider__text"">или</span></div>");
	Ожидаем.Что(СтрНайти(СПровайдерами, "class=""divider"""), "разделитель — между формой и провайдерами")
		.Больше(СтрНайти(СПровайдерами, "</form>"));
	Ожидаем.Что(СтрНайти(СПровайдерами, "<h2"), "заголовка «Или через провайдера» нет").Равно(0);

КонецПроцедуры

// Пароль выключен: полей пароля нет вовсе, есть провайдеры; без провайдеров — предупреждение.
&Тест
Процедура ПарольВыключенПровайдерыИПредупреждение() Экспорт

	Окружение = НовоеОкружение();
	Окружение.ВыключитьПароль();

	Колонка = Колонка(Вход(Окружение));
	Ожидаем.Что(СтрНайти(Колонка, "name=""пароль"""), "полей пароля нет").Равно(0);
	Ожидаем.Что(Колонка, "без провайдеров — предупреждение в колонке").Содержит("toast--warn");
	Ожидаем.Что(СтрНайти(Колонка, "class=""divider"""), "разделять нечего").Равно(0);

	Окружение.ЗадатьПровайдеров(Провайдеры());
	Колонка = Колонка(Вход(Окружение));
	Ожидаем.Что(Колонка, "провайдеры на месте").Содержит("/login/oidc/gh");
	Ожидаем.Что(СтрНайти(Колонка, "name=""пароль"""), "КОНТРОЛЬ: и пароля по-прежнему нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОтказИАтрибуция

// Неудачный вход: отказ уведомлением внутри колонки над формой, возврат едет дальше.
&Тест
Процедура ОшибкаВходаВКолонкеНадФормойИВозвратЦел() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер(НовоеОкружение()).Логин(Ответ, "логин=bob&пароль=x&next=%2Fpools%2Fcorp",
		Новый Соответствие(), Неопределено, "POST", "203.0.113.1");

	Колонка = Колонка(Ответ.ТелоТекст);
	Ожидаем.Что(Ответ.Код, "отказ входа — 401").Равно(401);
	Ожидаем.Что(Колонка, "отказ — уведомлением в колонке").Содержит("toast--err");
	Ожидаем.Что(СтрНайти(Колонка, "toast--err"), "и стоит над формой").Меньше(СтрНайти(Колонка, "<form"));
	Ожидаем.Что(Колонка, "возврат сохранён в форме")
		.Содержит("name=""next"" value=""/pools/corp""");

КонецПроцедуры

// Условие лицензии DB-IP: сноска стоит, пока есть правило по стране и индекс по базе, — внизу
// колонки строкой самого малого кегля; без правила база не использована и сноски нет.
&Тест
Процедура АтрибуцияСноскойТолькоПриПравилеПоСтране() Экспорт

	Окружение = НовоеОкружение();
	Ожидаем.Что(СтрНайти(Вход(Окружение, "", Атрибуция(Окружение)), "IP Geolocation by DB-IP"),
		"правил по стране нет — атрибуции нет").Равно(0);

	Окружение.ПоставитьПравилоПоСтране();
	Колонка = Колонка(Вход(Окружение, "", Атрибуция(Окружение)));
	Ожидаем.Что(Колонка, "правило есть — атрибуция в колонке")
		.Содержит("<p class=""note-footnote""><a href=""https://db-ip.com"">IP Geolocation by DB-IP</a></p>");
	Ожидаем.Что(СтрНайти(Колонка, "note-footnote"), "и стоит последней — под строкой регистрации")
		.Больше(СтрНайти(Колонка, "note-frame"));

КонецПроцедуры

#КонецОбласти

#Область ЗначокПровайдера

// Заданный значок — бренд или глиф кита (прежний ключ приводит домен вход — ПровайдерыВхода_Тесты);
// не заданный — бренд угадывается по издателю.
&Тест
Процедура ЗначокЗаданныйИУгаданный() Экспорт

	Значки = Новый ЗначокПровайдера(UI.Иконка);

	Ожидаем.Что(Значки.Имя(Провайдер("бренд:gitlab", "")), "заданный бренд").Равно("бренд:gitlab");
	Ожидаем.Что(Значки.Имя(Провайдер("замок", "")), "заданный глиф").Равно("замок");
	// общий ключ у кита — служебный значок, не бренд: выбранный прежде, он печатается глифом
	Ожидаем.Что(Значки.Имя(Провайдер("бренд:key", "https://github.com")), "прежний «бренд:key» — глиф «ключ»")
		.Равно("ключ");
	Ожидаем.Что(Значки.Имя(Провайдер("", "https://authentik.example.org/application/o/hub/")),
		"не задан — бренд по хосту издателя").Равно("бренд:authentik");
	Ожидаем.Что(Значки.Имя(Провайдер("", "https://sso-keycloak.corp/realms/main")),
		"слово хоста через дефис").Равно("бренд:keycloak");
	Ожидаем.Что(Значки.Имя(Новый Структура("Пресет", "gitlab")), "точный пресет").Равно("бренд:gitlab");
	Ожидаем.Что(Значки.Имя(Провайдер("", "https://gitea.example.org")), "пусто — по издателю")
		.Равно("бренд:gitea");

КонецПроцедуры

&Тест
Процедура НеизвестныйЗначокДаётКлюч() Экспорт

	Значки = Новый ЗначокПровайдера(UI.Иконка);

	Ожидаем.Что(Значки.Имя(Провайдер("", "https://sso.example.com")), "издатель без бренда — «ключ»")
		.Равно("ключ");
	Ожидаем.Что(Значки.Имя(Провайдер("", "https://kc.example.org/realms/github-sso")),
		"путь адреса не в счёт: realm «github-sso» — не GitHub").Равно("ключ");
	Ожидаем.Что(Значки.Имя(Провайдер("", "https://mygitlab.corp")),
		"слово хоста целиком, не подстрока").Равно("ключ");
	Ожидаем.Что(Значки.Имя(Провайдер("бренд:нет-такого", "")), "незнакомый бренд кита — «ключ»")
		.Равно("ключ");
	Ожидаем.Что(Значки.Имя(Провайдер("нет-такого-глифа", "")), "незнакомое имя — «ключ»").Равно("ключ");
	Ожидаем.Что(Значки.Имя(Неопределено), "провайдер без описания — «ключ»").Равно("ключ");
	Для Каждого Ключ Из Значки.УгадываемыеБренды() Цикл
		Ожидаем.Что(UI.Иконка.НазваниеБренда("бренд:" + Ключ), "бренд «" + Ключ + "» в ките есть")
			.Заполнено();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вокруг колонки ворот — только знак и тема: дорог, «Войти» и разделов нет. Гостю нет и единого
// меню; вошедшему кит (дев-сборка 10) ставит учётку в шапку и единое меню без дорог, разделов
// экрана и действий шапки — видно, под кем он здесь, и есть «Выйти».
Процедура ПроверитьВорота(Знач Страница, Знач Что, Знач Вошедший = Ложь)

	Шапка = Между(Страница, "<header", "</header>");
	Ожидаем.Что(ЧислоВхождений(Страница, "class=""narrow"""), Что + ": одна узкая колонка").Равно(1);
	Ожидаем.Что(ЧислоВхождений(Страница, "<h1"), Что + ": один заголовок").Равно(1);
	Ожидаем.Что(Колонка(Страница), Что + ": заголовок — в шапке колонки").Содержит("class=""narrow__head""");
	Ожидаем.Что(СтрНайти(Шапка, "tree--top"), Что + ": дорог в шапке нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "<span>Войти</span></a>"), Что + ": кнопки «Войти» нет").Равно(0);
	Если Вошедший Тогда
		Ожидаем.Что(ЧислоВхождений(Страница, "id=""hubmenu"""), Что + ": единое меню вошедшего — одно").Равно(1);
		Ожидаем.Что(Шапка, Что + ": учётка вошедшего — в шапке").Содержит("bob");
		Ожидаем.Что(СтрНайти(Страница, "hubmenu__section--roads"), Что + ": дорог в меню нет").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, "hubmenu__section--screen"), Что + ": разделов экрана в меню нет").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, "hubmenu__actions"), Что + ": действий шапки в меню нет").Равно(0);
	Иначе
		Ожидаем.Что(СтрНайти(Страница, "id=""hubmenu"""), Что + ": единого меню нет").Равно(0);
	КонецЕсли;
	Ожидаем.Что(Шапка, Что + ": КОНТРОЛЬ: знак и тема в шапке остались").Содержит("role=""switch""");

КонецПроцедуры

// Учётка вошедшего — в шапке страницы, «Выйти» — в его едином меню с токеном сессии, которую
// прочитал страж запроса: куки сессии у запроса ворот в наборе нет, второго чтения тоже.
Процедура ПроверитьУчётку(Знач Страница, Знач Что)

	Выход = Между(Страница, "action=""/logout""", "</form>");
	Ожидаем.Что(Между(Страница, "<header", "</header>"), Что + ": учётка в шапке").Содержит("bob");
	Ожидаем.Что(Выход, Что + ": «Выйти» в меню вошедшего").Заполнено();
	Ожидаем.Что(Выход, Что + ": с токеном сессии стража").Содержит("value=""" + Сессия_.Токен() + """");
	Ожидаем.Что(СтрНайти(Колонка(Страница), "action=""/logout"""), Что + ": в колонке своей «Выйти» нет")
		.Равно(0);

КонецПроцедуры

Функция НовоеОкружение()
	Возврат Новый ОкружениеЭкрановВхода(UI.Кит);
КонецФункции

Функция НоваяСтраницаДоступа()
	Возврат Новый СтраницаДоступа(UI.Кит, Каркас, UI.Тексты, Новый ВозвратПослеВхода(),
		UI.Бренд, Обрамление);
КонецФункции

Функция Атрибуция(Знач Окружение)
	Возврат Новый АтрибуцияБазыСтран(UI.Кит, Окружение, Окружение, UI.Тексты);
КонецФункции

// Порядок аргументов — порядок параметров конструктора: страница, кит, тексты, конфигурация,
// …, восстановление, отказы, HTTP, возврат, гейт, посетитель, отказ страны, атрибуция.
Функция Контроллер(Знач Окружение, Знач Атрибуция_ = Неопределено)

	Возврат Новый КонтроллерВходаOIDC(НоваяСтраницаДоступа(), UI.Кит, UI.Тексты, Окружение,
		Неопределено, Неопределено, Неопределено, Окружение, Окружение, Неопределено,
		Неопределено, Новый РазборФормы(), Новый ЗначокПровайдера(UI.Иконка), Окружение, Окружение,
		Новый МетодыHTTP(), Новый ВозвратПослеВхода(), Окружение, Новый ПосетительЗапроса(),
		Неопределено, ?(Атрибуция_ = Неопределено, Окружение, Атрибуция_), Неопределено, Неопределено);

КонецФункции

// Контроллер ворот с настоящей дверью выхода: служба сессий, кука сессии и токен — одна сессия.
Функция КонтроллерВыхода(Знач Окружение)

	Возврат Новый КонтроллерВходаOIDC(НоваяСтраницаДоступа(), UI.Кит, UI.Тексты, Окружение,
		Неопределено, Сессия_, Неопределено, Окружение, Окружение, Сессия_,
		Неопределено, Новый РазборФормы(), Новый ЗначокПровайдера(UI.Иконка), Окружение, Окружение,
		Новый МетодыHTTP(), Новый ВозвратПослеВхода(), Окружение, Новый ПосетительЗапроса(),
		Неопределено, Окружение, Новый ГейтФормы(Неопределено, Сессия_, Новый РазборФормы()), Сессия_);

КонецФункции

Функция Выйти(Знач Дверь, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Дверь.Выход(Ответ, Новый Соответствие(), Сессия_.Куки(), "POST", Тело, "203.0.113.1");
	Возврат Ответ;
КонецФункции

// Форма «Выйти» единого меню вошедшему с кукой живой сессии и этой сессией в контексте страницы.
Функция ВыходМеню(Знач Сессия)
	Возврат Обрамление.Обрамление(Новый Структура("Пользователь, КукиЗапроса, Путь, Сессия",
		Новый Структура("Логин", "bob"), Сессия_.Куки(), "/", Сессия)).МенюХаба.Выход.Рендер();
КонецФункции

Функция Вход(Знач Окружение, Знач Куда = "", Знач Атрибуция_ = Неопределено)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер(Окружение, Атрибуция_).Логин(Ответ, "", Новый Соответствие(), Неопределено, "GET",
		"203.0.113.1", Куда);
	Возврат Ответ.ТелоТекст;

КонецФункции

Функция Регистрация(Знач Окружение, Знач Куда)

	Экран = Новый КонтроллерРегистрации(Окружение, Окружение, Неопределено, Неопределено,
		Неопределено, Неопределено, НоваяСтраницаДоступа(), UI.Кит, Окружение,
		Новый РазборФормы(), Новый МетодыHTTP(), Новый ВозвратПослеВхода());

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Регистрация(Ответ, "", Новый Соответствие(), Неопределено, "GET", "203.0.113.1", Куда);
	Возврат Ответ.ТелоТекст;

КонецФункции

Функция Восстановление(Знач Окружение)

	Экран = Новый КонтроллерВосстановленияПароля(Окружение, Окружение, Окружение,
		НоваяСтраницаДоступа(), UI.Кит, UI.Тексты, Новый РазборФормы(), Новый МетодыHTTP());

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.ЗабытыйПароль(Ответ, "", Неопределено, "GET", "203.0.113.1");
	Возврат Ответ.ТелоТекст;

КонецФункции

Функция УстановкаПароля(Знач Окружение)

	Экран = Новый КонтроллерУстановкиПароля(Окружение, Новый АдресПриглашения(Неопределено, Неопределено), Неопределено,
		Неопределено, Окружение, Окружение, НоваяСтраницаДоступа(), UI.Кит, Окружение,
		Новый РазборФормы(), Новый МетодыHTTP(), Новый ВозвратПослеВхода());

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.УстановкаПароля(Ответ, "", Неопределено, "GET", "203.0.113.1", "negodnaya");
	Возврат Ответ.ТелоТекст;

КонецФункции

Функция ПервыйЗапуск(Знач Окружение)

	Экран = Новый КонтроллерОнбординга(Окружение, Неопределено, Неопределено, Окружение,
		Неопределено, Новый ЗаголовкиHTTP(), НоваяСтраницаДоступа(), UI.Кит, Окружение,
		Новый ВозвратПослеВхода(), UI.АдресаКабинета);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept", "text/html");
	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Мастер(Ответ, "", Заголовки, Неопределено, "GET");
	Возврат Ответ.ТелоТекст;

КонецФункции

