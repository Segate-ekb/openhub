КонецФункции

// Старт входа через закрытого провайдера: отказ печатает сама страница входа.
Функция ОтказПоСтране(Знач Окружение, Знач Атрибуция_ = Неопределено)

	Окружение.ЗадатьПровайдеров(Провайдеры());
	Экран = Новый КонтроллерВходаOIDC(НоваяСтраницаДоступа(), UI.Кит, UI.Тексты, Окружение,
		Окружение, Неопределено, Неопределено, Окружение, Окружение, Неопределено,
		Неопределено, Новый РазборФормы(), Новый ЗначокПровайдера(UI.Иконка), Окружение, Окружение,
		Новый МетодыHTTP(), Новый ВозвратПослеВхода(), Окружение, Новый ПосетительЗапроса(),
		Новый ОтказПоСтране(Окружение, UI.Тексты, Окружение),
		?(Атрибуция_ = Неопределено, Окружение, Атрибуция_), Неопределено, Неопределено);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.СтартOIDC(Ответ, "gh", Новый Соответствие(), Неопределено, "GET", "203.0.113.1");
	Возврат Ответ;

КонецФункции

Функция АдресПосетителя(Знач Окружение)

	Экран = Новый КонтроллерАдресаПосетителя(НоваяСтраницаДоступа(), UI.Кит, UI.Тексты,
		Новый ПосетительЗапроса(), Окружение, Окружение, Атрибуция(Окружение), Окружение);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.КакХабВидитЗапрос(Ответ, Новый Соответствие(), Неопределено, "203.0.113.1");
	Возврат Ответ.ТелоТекст;

КонецФункции

// Провайдеры: пресет GitHub, свой Keycloak (бренд — по издателю) и свой без бренда.
Функция Провайдеры()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Имя, Метка, Значок, Издатель", "gh", "GitHub", "бренд:github", ""));
	Результат.Добавить(Новый Структура("Имя, Метка, Значок, Издатель", "kc", "Keycloak", "",
		"https://keycloak.example.org/realms/main"));
	Результат.Добавить(Новый Структура("Имя, Метка, Значок, Издатель", "corp", "Корпоративный вход",
		"", "https://sso.example.com"));
	Возврат Результат;

КонецФункции

Функция Провайдер(Знач Значок, Знач Издатель)
	Возврат Новый Структура("Имя, Значок, Издатель", "p", Значок, Издатель);
КонецФункции

// Кнопка провайдера в столбике: ссылка на старт его входа целиком.
Функция Кнопка(Знач Столбик, Знач Имя)

	Позиция = СтрНайти(Столбик, "href=""/login/oidc/" + Имя + """");
	Ожидаем.Что(Позиция, "КОНТРОЛЬ: кнопка провайдера «" + Имя + "» на странице").Больше(0);
	Начало = СтрНайти(Столбик, "<a ", НаправлениеПоиска.СКонца, Позиция);
	Хвост = Сред(Столбик, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</a>") + 3);

КонецФункции

Функция ШапкаКолонки(Знач Страница)
	Возврат Между(Страница, "class=""narrow__head"">", "</div>");
КонецФункции

Функция Колонка(Знач Страница)
	Возврат Между(Страница, "<div class=""narrow"">", "</main>");
КонецФункции

Функция Рамка(Знач Страница)
	Возврат Между(Страница, "<p class=""note-frame"">", "</p>");
КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);

КонецФункции

Функция ЧислоВхождений(Знач HTML, Знач Образец)
	Возврат СтрЧислоВхождений(HTML, Образец);
КонецФункции

Функция Экранировать(Знач Адрес)
	Возврат СтрЗаменить(Адрес, "&", "&amp;");
КонецФункции

#КонецОбласти
