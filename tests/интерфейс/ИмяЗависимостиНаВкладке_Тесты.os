// Имя зависимости на вкладке «Зависимости»: берётся из канонического поля строки, а если
// оно пусто — выводится на месте из написания автора манифеста.

#Использовать asserts
#Использовать "../фикстуры"

Перем Вкладка;  // ВкладкаЗависимостей — только чистая функция ИмяЦели

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьВкладку() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули"), "ВкладкаЗависимостей");
	Вкладка = ВкладкаБезЖелудей();

КонецПроцедуры

// --- проверки ---

// Вторая сеть показа: строку зависимости мог записать кто угодно и когда угодно, и если
// канонического имени в ней нет, ячейка обязана вывести его сама, а не остаться пустой.
&Тест
Процедура ЯчейкаВыводитИмяКогдаКанонПуст() Экспорт

	Ожидаем.Что(Вкладка.ИмяЦели(СтрокаЗависимости("", "  Winow  ")),
		"пустой канон — имя выводится из написания автора").Равно("winow");
	Ожидаем.Что(Вкладка.ИмяЦели(СтрокаЗависимости(Неопределено, "Autumn")),
		"отсутствующий канон — то же самое").Равно("autumn");
	// канон намеренно НЕ равен НРег(ИмяПакета): на паре ("winow", "Winow") обе ветки дают
	// один ответ, и выкинутая ветка канона осталась бы незамеченной
	Ожидаем.Что(Вкладка.ИмяЦели(СтрокаЗависимости("совсем-другое", "Winow")),
		"заполненный канон берётся как есть, а не пересчитывается из имени").Равно("совсем-другое");

КонецПроцедуры

// --- служебное ---

// Строка зависимости в том виде, в каком её читает вкладка: ячейке нужны только два поля.
Функция СтрокаЗависимости(Знач Канон, Знач ИмяПакета)
	Возврат Новый Структура("ИмяПакетаНижнийРегистр, ИмяПакета", Канон, ИмяПакета);
КонецФункции

// ИмяЦели ни одного желудя вкладки не трогает: позиционных Неопределено — по параметрам конструктора.
Функция ВкладкаБезЖелудей()

	Возврат Новый ВкладкаЗависимостей(
		Неопределено, Неопределено, Неопределено, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено);

КонецФункции
