// Пустой пул на странице пула: читателю — пустота словами, тому, кто пулом распоряжается, — карточка
// с путями из неё: первая публикация всегда, перенос из другого хаба — только пулу, которому внешние
// источники допустимы (не личному пространству).

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // Структура компонентов (фикстура СборкаUI)

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьВитрину() Экспорт

	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули"), "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ПраваПустогоПулаЗаглушка");
	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(КаталогКлассов, "ВитринаПустогоПула");

	UI = Новый СборкаUI().Собрать(КаталогКлассов);

КонецПроцедуры

&Тест
Процедура ЧитателюПустотаБезПутей() Экспорт

	Разметка = ПустойПул(Ложь, "custom");

	Ожидаем.Что(Разметка, "пустота словами").Содержит(UI.Тексты.Текст("public.pool.empty.title"));
	Ожидаем.Что(Разметка, "пути публикации читателю нет").Не_().Содержит(UI.Тексты.Текст("public.pool.start.publish"));
	Ожидаем.Что(Разметка, "пути переноса читателю нет").Не_().Содержит(UI.Тексты.Текст("public.pool.start.migrate"));

КонецПроцедуры

&Тест
Процедура РаспоряжающемусяПутиИзПустоты() Экспорт

	Проектный = ПустойПул(Истина, "custom");
	Ожидаем.Что(Проектный, "к первой публикации — проводник").Содержит("href=""" + UI.АдресаКабинета.Проводник() + """");
	Ожидаем.Что(Проектный, "перенос — зеркало в режиме переноса").Содержит("href=""/pools/team/settings/mirrors?migrate=1""");

	Личный = ПустойПул(Истина, "user");
	Ожидаем.Что(Личный, "личному пространству — публикация").Содержит(UI.Тексты.Текст("public.pool.start.publish"));
	Ожидаем.Что(Личный, "но не перенос: внешние источники ему недопустимы")
		.Не_().Содержит(UI.Тексты.Текст("public.pool.start.migrate"));

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ПустойПул(Знач Распоряжается, Знач ТипПула)

	Права = Новый ПраваПустогоПулаЗаглушка();
	Права.Распоряжаться(Распоряжается);
	Витрина = Новый ВитринаПустогоПула(UI.Кит, UI.Тексты, Права, UI.АдресаКабинета, Права, Новый ПараметрыСсылки());
	Возврат Витрина.Узел(Новый ПулЗаглушка(5, "team", ТипПула), Неопределено).Рендер();

КонецФункции

#КонецОбласти
