// Экран «Пулы» дома «Хаб» — таблица пулов хаба с ⚙ в строке и свёрнутая группа личных пространств,
// отбор и страницы в адресе,
// окно нового пула, «Сделать основным» и удаление по адресу: настоящим контроллером поверх настоящих
// служб пулов, доступа и прав.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Принципалы;    // фикстура СтендПринципалов
Перем Пулы;          // КонтроллерПуловХаба
Перем Админ;         // учётка, от имени которой открыт раздел
Перем Гвард;         // ГвардХабаЗаглушка — впускает админа либо никого
Перем Маршруты;      // МаршрутыХаба — настоящий маршрутизатор winow над контроллерами хаба

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	// хранилище и публикация — ради удаления пула: уборка сносит область файлов и входящие заявки,
	// резерв имени заводит пакеты пула
	Слои.Подключить("данные, хранилище, публикация, реестр, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("почта, уведомления, вход, права, настройки, гео, сеть, кабинет, интерфейс/общее,"
		+ " интерфейс/хаб, состояние/выпуски");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ДомПула,ПлашкиПула,ЗначкиМеты,КонтроллерДомаХаба,КонтроллерПуловХаба", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкЖурналЗамка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ГвардХабаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПультНейтральный");
	РеестрФикстур.Подключить("МаршрутыХаба");
	Маршруты = Новый МаршрутыХаба(КаталогиПроекта.Модули());

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-пулов-хаба-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Админ = Желудь("СервисПользователей").СоздатьПользователя("root9p", "", "password123", "admin");
	Гвард = Новый ГвардХабаЗаглушка();
	Гвард.Впустить(Админ, Принципалы.Сессия(Админ));

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(Интерфейс);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Желудь("СервисПрав"), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Защита.ЗадатьИсход(Истина);
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));

	// формы значений раздела принимает дом «Хаб»: его общая дверь — настоящая, с настоящей записью
	// значений реестра; картинки, проба почты и парольный вход раздела «Пулы» не касаются
	ДомНастроек = Новый КонтроллерДомаХаба(Гвард, Ответы, Желудь("ДомХаба"), Желудь("ВитринаНастроек"),
		Желудь("ВитринаДомаХаба"), Желудь("ПультЗначенийНастроек"), Желудь("ПультЛичныхПространств"),
		Новый ПультНейтральный(), Новый ПультНейтральный(), Гейт, Защита,
		Желудь("РазборФормы"), Желудь("ТекстыИнтерфейса"), Желудь("ОтметкаСохранения"), Желудь("ОкноРаздела"),
		Желудь("ВитринаПарольногоВхода"));

	Пульт = Новый ПультПулов(Гейт, Желудь("РазборФормы"), Желудь("ОкноПула"), Желудь("СлужбаДоступа"),
		Желудь("СервисПулов"), Желудь("ГвардКвотыПула"), Желудь("ВитринаНастроек"),
		Желудь("ВитринаЛичныхПространств"), Желудь("ТекстСбоя"), Желудь("ТекстыИнтерфейса"));
	Пулы = Новый КонтроллерПуловХаба(Гвард, Ответы, Желудь("ДомХаба"), ДомНастроек, Желудь("ВитринаДомаХаба"),
		Желудь("ВитринаПулов"), Пульт, Защита, Желудь("ОкноРаздела"), Желудь("ОтборПулов"));

КонецПроцедуры

&ПередКаждым
Процедура ВпуститьАдмина() Экспорт
	Гвард.НеВпускать(Ложь);
КонецПроцедуры

#Область Вкладка

// Вкладку называет одна дверь дома: раздел, дом и его объект — как у остальных разделов хаба.
&Тест
Процедура ВкладкаНазываетРазделИДом() Экспорт

	Тексты = Желудь("ТекстыИнтерфейса");
	Ответ = Получить("");
	Начало = СтрНайти(Ответ.ТелоТекст, "<title>") + СтрДлина("<title>");
	Титул = Сред(Ответ.ТелоТекст, Начало, СтрНайти(Ответ.ТелоТекст, "</title>") - Начало);
	Титул = Лев(Титул, СтрНайти(Титул, " — ", НаправлениеПоиска.СКонца) - 1);
	Ожидаем.Что(Титул, "вкладка раздела").Равно(Тексты.Текст("settings.hub.nav.pools") + " · "
		+ Тексты.Текст("settings.hub.title") + " · " + Желудь("ОписаниеПриложения").Имя());

КонецПроцедуры

#КонецОбласти

#Область Гвард

// Каждую дверь раздела стережёт гвард дома «Хаб»: кого он не впустил, тот не заводит пул, не
// назначает основной, не удаляет и не меняет значения раздела.
&Тест
Процедура ДвериНеТрогаютДоменТогоКогоГвардНеВпустил() Экспорт

	Имя = ЗавестиПул("grd");
	Новый_ = "grdnew" + УникальныеИмена.Хвост();
	Основной = СервисПулов().ИмяПулаПоУмолчанию();
	КвотаДо = Желудь("СервисНастроек").Значение("oshub.pools.default_quota_mb");

	Ответы = Новый Массив();
	Гвард.НеВпускать();
	Попытка
		Ответы.Добавить(Отправить("", ФормаНового(Новый_)));
		Ответы.Добавить(Отправить(Имя + "/primary", "confirmed=1"));
		Ответы.Добавить(Отправить(Имя + "/delete", "confirmed=1&имя=" + Имя));
		Ответы.Добавить(Отправить("", "oshub.pools.default_quota_mb=777"));
		Проверка = Проверить(Имя);
	Исключение
		Гвард.НеВпускать(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Гвард.НеВпускать(Ложь);

	Ожидаем.Что(Пул(Новый_), "нового пула нет").Равно(Неопределено);
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();
	Ожидаем.Что(СервисПулов().ИмяПулаПоУмолчанию(), "основной прежний").Равно(Основной);
	Ожидаем.Что(Желудь("СервисНастроек").Значение("oshub.pools.default_quota_mb"), "квота по умолчанию прежняя")
		.Равно(КвотаДо);
	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(Ответ.ПутьРедиректа, "посторонний никуда не перенаправлен").Равно("");
	КонецЦикла;
	// проверка имени до отправки постороннему не говорит, занято ли имя: на занятое она ответила бы 409
	Ожидаем.Что(Проверка.Код <> 200 И Проверка.Код <> 409, "проверка имени закрыта гвардом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Проверка.ТелоТекст, Имя), "и имени пула в ответе нет").Равно(0);

	// КОНТРОЛЬ: впущенному та же форма заводит пул
	Отправить("", ФормаНового(Новый_));
	Ожидаем.Что(Пул(Новый_), "КОНТРОЛЬ: впущенный заводит пул").Существует();

КонецПроцедуры

// Форма старой вкладки с операцией, которой новая страница не знает, отбивается без мутации.
&Тест
Процедура ФормаСтаройВкладкиОтбиваетсяБезМутации() Экспорт

	Имя = ЗавестиПул("old");
	Старый = "oldnew" + УникальныеИмена.Хвост();
	Основной = СервисПулов().ИмяПулаПоУмолчанию();

	Создание = Отправить("", "операция=пул-создать&имя=" + Старый + "&тип=custom&видимость=public&квота_мб=-1");
	Ожидаем.Что(Создание.Код, "старое заведение — 400").Равно(400);
	Ожидаем.Что(Тост(Создание), "причина названа").Содержит("Страница устарела");
	Ожидаем.Что(Пул(Старый), "пул не заведён").Равно(Неопределено);

	Назначение = Отправить("", "операция=пул-основной&pool=" + Формат(Пул(Имя).Идентификатор, "ЧГ=0"));
	Ожидаем.Что(Назначение.Код, "старое назначение основного — 400").Равно(400);
	Ожидаем.Что(СервисПулов().ИмяПулаПоУмолчанию(), "основной прежний").Равно(Основной);

	Квота = Отправить("", "операция=пул-квота&pool=" + Формат(Пул(Имя).Идентификатор, "ЧГ=0") + "&квота_мб=5");
	Ожидаем.Что(Квота.Код, "старая правка квоты — 400").Равно(400);
	Ожидаем.Что(Пул(Имя).КвотаМб, "квота пула прежняя").Равно(СервисПулов().КвотаКакВХабе());

	Удаление = Отправить(Имя + "/delete", "операция=пул-удалить&confirmed=1&имя=" + Имя);
	Ожидаем.Что(Удаление.Код, "удаление с чужой операцией — 400").Равно(400);
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();

	// КОНТРОЛЬ: те же поля с операцией окна нового пула заводят пул
	Ожидаем.Что(Отправить("", ФормаНового(Старый)).Код, "КОНТРОЛЬ: окно нового пула — 303").Равно(303);
	Ожидаем.Что(Пул(Старый), "КОНТРОЛЬ: пул заведён").Существует();

КонецПроцедуры

#КонецОбласти

#Область Заведение

// Окно нового пула на странице всегда, закрытым; кнопка «Добавить пул» без скрипта ведёт на адрес,
// где сервер печатает его открытым.
&Тест
Процедура ОкноЗаведенияОткрываетсяПоАдресу() Экспорт

	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Страница, "кнопка ведёт на окно по адресу")
		.Содержит("href=""/hub/settings/pools?" + Закодировать("окно") + "=" + Закодировать("новый") + """");
	Ожидаем.Что(Страница, "окно на странице").Содержит("id=""pul-novyi""");
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "и закрыто").Равно(0);

	Открытые = ОткрытыеОкна(Получить("окно=новый").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по ?окно=новый открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно нового пула").Содержит("id=""pul-novyi""");
	Поле = Тег(Открытые[0], "input", "name=""имя""");
	Ожидаем.Что(Поле, "имя проверяется правилом именования").Содержит("pattern=");
	Ожидаем.Что(Поле, "и занятостью на сервере").Содержит("data-check=""/hub/settings/pools?");

	// окно закрывают ссылки на список (крестик и «Отмена»): без скрипта — переходом, со скриптом —
	// на месте (data-closes); команд движка нет ни у открытого по адресу, ни у закрытого на странице
	Закрытое = Между(Страница, "id=""pul-novyi""", "</dialog>");
	Для Каждого Окно Из Новый Структура("Открытое, Закрытое", Открытые[0], Закрытое) Цикл
		Ожидаем.Что(СтрЧислоВхождений(Окно.Значение, "command=""close"""), Окно.Ключ + ": команд движка нет")
			.Равно(0);
		Ожидаем.Что(СтрЧислоВхождений(Окно.Значение, "data-closes=""pul-novyi"""),
			Окно.Ключ + ": крестик и «Отмена» закрывают окно").Равно(2);
		Ожидаем.Что(СтрЧислоВхождений(Окно.Значение, "href=""/hub/settings/pools"""),
			Окно.Ключ + ": обе ссылки ведут на список").Равно(2);
	КонецЦикла;

КонецПроцедуры

// Проверка до отправки судит теми же правилами, что заведение: занятое пулом или логином
// и негодное имя — 409 с причиной, свободное — 200.
&Тест
Процедура ПроверкаИмениОтвечаетКакЗаведение() Экспорт

	Занятое = ЗавестиПул("chk");
	Свободное = "free" + УникальныеИмена.Хвост();

	Ответ = Проверить(Занятое);
	Ожидаем.Что(Ответ.Код, "имя пула занято — 409").Равно(409);
	Ожидаем.Что(Ответ.ТелоТекст, "и причина словами").Содержит(Занятое);
	Ожидаем.Что(Проверить(Админ.Логин).Код, "имя чужого логина — 409").Равно(409);
	Ожидаем.Что(Проверить("-плохое").Код, "негодное имя — 409").Равно(409);
	Ожидаем.Что(Проверить(Свободное).Код, "свободное — 200").Равно(200);
	Ожидаем.Что(Пул(Свободное), "проверка ничего не заводит").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОтбитоеЗаведениеВозвращаетОткрытоеОкноСНабранным() Экспорт

	Занятое = ЗавестиПул("dup");

	Ответ = Отправить("", ФормаНового(Занятое, "private", "77"));
	Ожидаем.Что(Ответ.Код, "занятое имя — 400").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно нового пула открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""имя"""), "имя помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""квота_мб"""), "набранная квота на месте")
		.Содержит("value=""77""");

	Новое = "q" + УникальныеИмена.Хвост();
	Квота = Отправить("", ФормаНового(Новое, "public", "много"));
	Ожидаем.Что(Квота.Код, "квота не числом — 400").Равно(400);
	Ожидаем.Что(Тег(ОткрытыеОкна(Квота.ТелоТекст)[0], "input", "name=""квота_мб"""), "отказ — под квотой")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Пул(Новое), "пул не заведён").Равно(Неопределено);

КонецПроцедуры

// Владельцем нового пула становится заводящий; «−1» в квоте — квота хаба, а не своя.
&Тест
Процедура ЗаведениеСоздаётПулЗаводящегоСНабраннымиСвойствами() Экспорт

	Имя = "new" + УникальныеИмена.Хвост();

	Ответ = Отправить("", ФормаНового(Имя, "private", "-1") + "&q=new");
	Ожидаем.Что(Ответ.Код, "удача — 303: " + Тост(Ответ)).Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "к тому же отбору с отметкой").Равно("/hub/settings/pools?q=new&saved=1");

	Пул = Пул(Имя);
	Ожидаем.Что(Пул, "пул заведён").Существует();
	Ожидаем.Что(Пул.Видимость, "видимость из окна").Равно("private");
	Ожидаем.Что(Пул.ВладелецИдентификатор, "владелец — заводящий").Равно(Админ.Идентификатор);
	Ожидаем.Что(Пул.КвотаМб, "квота — как в хабе").Равно(СервисПулов().КвотаКакВХабе());

КонецПроцедуры

#КонецОбласти

#Область Таблица

// Тип словами, видимость плашкой, владелец логином; личное пространство — тем же словом, что в меню
// аккаунта и на /pools, и с одной «Настройкой» в ⚙: удаляется оно вместе с учёткой.
&Тест
Процедура СтрокиНазываютТипВладельцаИДействия() Экспорт

	Тексты = Желудь("ТекстыИнтерфейса");
	Имя = ЗавестиПул("row");
	Приватный = ЗавестиПул("prv", "private");
	Личный = "lich" + УникальныеИмена.Хвост();
	Учётка = Желудь("СервисПользователей").СоздатьПользователя(Личный, "", "password123", "user");
	Желудь("СервисПользователей").ОбеспечитьЛичныйПул(Учётка);
	Основной = СервисПулов().ИмяПулаПоУмолчанию();

	Строка_ = СтрокаТаблицы(Получить("q=" + Имя).ТелоТекст, Имя);
	Ожидаем.Что(Строка_, "имя — ссылка в дом пула").Содержит("href=""/pools/" + Имя + "/settings""");
	Ожидаем.Что(Строка_, "тип словом").Содержит(">" + Тексты.Текст("settings.hub.pools.kind.pool") + "<");
	Ожидаем.Что(Строка_, "владелец — заводящий").Содержит(">" + Админ.Логин + "<");
	Ожидаем.Что(ЯчейкаСТекстом(Строка_, "0"), "число пакетов — колонкой чисел").Содержит("cell-num");
	Ожидаем.Что(Строка_, "основным — окном по адресу").Содержит(Закодировать("основной-" + Имя));
	Ожидаем.Что(Строка_, "удаление — окном по адресу").Содержит(Закодировать("удалить-" + Имя));

	СтрокаЛичного = СтрокаТаблицы(ГруппаЛичных(Получить("pq=" + Личный).ТелоТекст), Личный);
	Ожидаем.Что(СтрокаЛичного, "личное пространство — в своей группе").Заполнено();
	Ожидаем.Что(СтрокаЛичного, "в ⚙ — настройки").Содержит("href=""/pools/" + Личный + "/settings""");
	Ожидаем.Что(ЯчейкаСТекстом(СтрокаЛичного, "0"), "число пакетов личного — колонкой чисел")
		.Содержит("cell-num");
	Ожидаем.Что(СтрНайти(ГруппаЛичных(Получить("pq=" + Личный).ТелоТекст),
		">" + Тексты.Текст("settings.hub.pools.col.owner") + "<"),
		"колонки владельца у личных нет: владелец — тот, чьим логином пространство названо").Равно(0);
	Ожидаем.Что(ТаблицаПулов(Получить("q=" + Имя).ТелоТекст),
		"КОНТРОЛЬ: у пулов хаба колонка владельца есть").Содержит(">" + Тексты.Текст("settings.hub.pools.col.owner") + "<");
	Ожидаем.Что(СтрНайти(СтрокаЛичного, Закодировать("окно")), "окон у личного нет").Равно(0);

	// и дверь удаления личное пространство не сносит, даже с верным эхом
	Удаление = Отправить(Личный + "/delete", "confirmed=1&имя=" + Личный);
	Ожидаем.Что(Удаление.Код, "личное пространство — 400").Равно(400);
	Ожидаем.Что(Тост(Удаление), "причина словами").Содержит("личное пространство");
	Ожидаем.Что(Пул(Личный), "личное пространство цело").Существует();

	Ожидаем.Что(СтрНайти(СтрокаТаблицы(Получить("q=" + Приватный).ТелоТекст, Приватный),
		Закодировать("основной-")), "приватный основным не становится").Равно(0);

	Если ЗначениеЗаполнено(Основной) Тогда
		СтрокаОсновного = СтрокаТаблицы(Получить("q=" + Основной).ТелоТекст, Основной);
		Ожидаем.Что(СтрокаОсновного, "основной назван").Содержит(">" + Тексты.Текст("settings.hub.pools.kind.primary") + "<");
		Ожидаем.Что(СтрНайти(СтрокаОсновного, Закодировать("удалить-")), "основной не удаляется").Равно(0);
	КонецЕсли;

	// окна по адресу у пулов без этого действия не открываются
	Для Каждого Окно Из СтрРазделить("удалить-" + Личный + ",основной-" + Личный + ",основной-" + Приватный
		+ ",удалить-нет-такого,зачем-" + Имя, ",") Цикл
		Страница = Получить("окно=" + Окно);
		Ожидаем.Что(Страница.Код, "?окно=" + Окно + " — страница раздела").Равно(200);
		Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОтборПоВидимостиСужаетСписок() Экспорт

	Приставка = "flt" + УникальныеИмена.Хвост();
	ЗавестиПул(Приставка + "a", "public", Ложь);
	ЗавестиПул(Приставка + "b", "private", Ложь);

	Ожидаем.Что(Имена(Получить("q=" + Приставка), Приставка), "оба").Равно(Приставка + "a," + Приставка + "b");
	Ожидаем.Что(Имена(Получить("q=" + Приставка + "&visibility=private"), Приставка),
		"приватные").Равно(Приставка + "b");

	// незнакомое значение отбора отброшено, а не отбирает пустоту; параметра kind точка раздела
	// не объявляет, и старая ссылка ?kind=user, доставленная по именам, показывает пулы хаба
	Ожидаем.Что(Имена(Получить("q=" + Приставка + "&visibility=x"), Приставка), "мусор в отборе не сужает список")
		.Равно(Приставка + "a," + Приставка + "b");
	Ожидаем.Что(ИменаПараметров(Пулы, "Раздел").Найти("kind"), "КОНТРОЛЬ: точка раздела kind не ждёт")
		.Равно(Неопределено);
	Ожидаем.Что(Имена(Получить("q=" + Приставка + "&kind=user"), Приставка), "старая ссылка kind=user — пулы хаба")
		.Равно(Приставка + "a," + Приставка + "b");

	Пусто = Получить("q=" + Приставка + "zzz").ТелоТекст;
	Ожидаем.Что(Пусто, "пустая выдача объяснена").Содержит("ничего не найдено");

КонецПроцедуры

// Личных пространств столько же, сколько учёток: в таблице пулов хаба их нет, они собраны ниже
// свёрнутой группой со счётчиком — по слову владельца (ИСТ-ПУЛ-012).
&Тест
Процедура ЛичныеПространстваСвёрнутойГруппойНеВТаблицеПулов() Экспорт

	Приставка = "grp" + УникальныеИмена.Хвост();
	ЗавестиПул(Приставка + "a", "public", Ложь);
	Учётка = Желудь("СервисПользователей").СоздатьПользователя(Приставка + "u", "", "password123", "user");
	Желудь("СервисПользователей").ОбеспечитьЛичныйПул(Учётка);
	Всего = СервисПулов().ПулыПоТипу(СервисПулов().ТипЛичный()).Количество();

	Страница = Получить("").ТелоТекст;
	Таблица = ТаблицаПулов(Страница);
	Группа = ГруппаЛичных(Страница);

	Ожидаем.Что(Таблица, "КОНТРОЛЬ: пул хаба в таблице").Содержит(">" + Приставка + "a<");
	Ожидаем.Что(СтрНайти(Таблица, ">" + Приставка + "u<"), "личного пространства в таблице пулов нет").Равно(0);
	Ожидаем.Что(СтрНайти(Таблица, "name=""kind"""), "отбора по типу нет").Равно(0);
	Ожидаем.Что(Группа, "группа названа со счётчиком")
		.Содержит("Личные пространства — " + Формат(Всего, "ЧН=0; ЧГ=0"));
	Ожидаем.Что(Группа, "личное пространство — в группе").Содержит(">" + Приставка + "u<");
	Ожидаем.Что(Кат(Группа), "группа под катом").Заполнено();
	Ожидаем.Что(СтрНайти(Кат(Группа), " open"), "и свёрнута").Равно(0);

	// поиск по группе раскрывает её и находит своё, таблице пулов хаба не мешая
	Найдено = Получить("pq=" + Приставка + "u").ТелоТекст;
	Ожидаем.Что(Кат(ГруппаЛичных(Найдено)), "искали в группе — она раскрыта").Содержит(" open");
	Ожидаем.Что(ГруппаЛичных(Найдено), "и нашли своё").Содержит(">" + Приставка + "u<");
	Ожидаем.Что(ТаблицаПулов(Найдено), "КОНТРОЛЬ: таблица пулов хаба на месте").Содержит(">" + Приставка + "a<");

КонецПроцедуры

// У группы свои страницы (ppage), они несут отбор таблицы пулов хаба, а её страницы — положение группы.
&Тест
Процедура СтраницыЛичныхПространствСвоиИНесутОтбор() Экспорт

	Приставка = "pp" + УникальныеИмена.Хвост();
	Для Номер = 1 По 22 Цикл
		Учётка = Желудь("СервисПользователей").СоздатьПользователя(Приставка + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0"),
			"", "password123", "user");
		Желудь("СервисПользователей").ОбеспечитьЛичныйПул(Учётка);
	КонецЦикла;

	Первая = ГруппаЛичных(Получить("pq=" + Приставка + "&visibility=public").ТелоТекст);
	Ожидаем.Что(СтрРазделить(ИменаВ(Первая, Приставка), ",").Количество(), "на первой странице группы 20")
		.Равно(20);
	Ожидаем.Что(Первая, "диапазон назван").Содержит("1–20 из 22");
	Ожидаем.Что(Первая, "шаг группы — своим параметром").Содержит("ppage=2");
	Ожидаем.Что(Первая, "и несёт отбор пулов хаба").Содержит("visibility=public");
	Ожидаем.Что(Первая, "строка поиска группы на месте").Содержит("name=""pq""");

	Вторая = ГруппаЛичных(Получить("pq=" + Приставка + "&ppage=2").ТелоТекст);
	Ожидаем.Что(СтрРазделить(ИменаВ(Вторая, Приставка), ",").Количество(), "на второй — остаток").Равно(2);

КонецПроцедуры

// Две таблицы одной страницы не сбрасывают друг друга: поиск и страницы пулов хаба несут
// положение группы личных (pq, ppage), поиск и страницы группы — отбор таблицы (q, visibility,
// page); формы строк и окон возвращают туда же; ppage за концом, отрицательный и мусорный —
// последняя или первая страница, без ошибки.
&Тест
Процедура ТаблицаИГруппаЛичныхНесутПоложениеДругДруга() Экспорт

	Приставка = "pos" + УникальныеИмена.Хвост();
	Для Номер = 1 По 22 Цикл
		ЗавестиПул(Приставка + "h" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0"), "public", Ложь);
		Учётка = Желудь("СервисПользователей").СоздатьПользователя(Приставка + "u" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0"),
			"", "password123", "user");
		Желудь("СервисПользователей").ОбеспечитьЛичныйПул(Учётка);
	КонецЦикла;
	Положение = "q=" + Приставка + "h&visibility=public&page=2&pq=" + Приставка + "u&ppage=2";

	Страница = Получить(Положение);
	Ожидаем.Что(Страница.Код, "страница отдана").Равно(200);
	Таблица = ТаблицаПулов(Страница.ТелоТекст);
	Группа = ГруппаЛичных(Страница.ТелоТекст);

	ПоискПулов = Между(Таблица, "<form class=""filters""", "</form>");
	Ожидаем.Что(Тег(ПоискПулов, "input", "name=""pq"""), "поиск пулов хаба несёт поиск группы")
		.Содержит("value=""" + Приставка + "u""");
	Ожидаем.Что(Тег(ПоискПулов, "input", "name=""ppage"""), "и её страницу").Содержит("value=""2""");
	Ожидаем.Что(Таблица, "страницы пулов хаба несут положение группы")
		.Содержит("pq=" + Приставка + "u&amp;ppage=2");

	ПоискГруппы = Между(Группа, "<form class=""filters""", "</form>");
	Ожидаем.Что(Тег(ПоискГруппы, "input", "name=""q"""), "поиск группы несёт поиск пулов хаба")
		.Содержит("value=""" + Приставка + "h""");
	Ожидаем.Что(Тег(ПоискГруппы, "input", "name=""visibility"""), "их видимость").Содержит("value=""public""");
	Ожидаем.Что(Тег(ПоискГруппы, "input", "name=""page"""), "и страницу").Содержит("value=""2""");
	Ожидаем.Что(Группа, "страницы группы несут отбор пулов хаба и их страницу")
		.Содержит("visibility=public&amp;page=2&amp;pq=" + Приставка + "u");

	// окно и форма строки возвращают к тому же положению обеих таблиц
	Имя = Приставка + "h21";
	Окно = ОткрытыеОкна(Получить(Положение + "&окно=удалить-" + Имя).ТелоТекст);
	Ожидаем.Что(Окно.Количество(), "окно удаления открыто").Равно(1);
	Ожидаем.Что(Тег(Окно[0], "input", "name=""pq"""), "окно несёт поиск группы").Содержит("value=""" + Приставка + "u""");
	Ожидаем.Что(Тег(Окно[0], "input", "name=""ppage"""), "и её страницу").Содержит("value=""2""");
	Удаление = Отправить(Имя + "/delete", "confirmed=1&имя=" + Имя + "&" + Положение);
	Ожидаем.Что(Удаление.Код, "удалено — 303: " + Тост(Удаление)).Равно(303);
	Ожидаем.Что(Раскодировать(Удаление.ПутьРедиректа), "возврат к тому же положению группы")
		.Содержит("pq=" + Приставка + "u&ppage=2");

	// границы ppage: за концом — последняя страница, мусор и отрицательное — первая
	Первая = ИменаВ(ГруппаЛичных(Получить("pq=" + Приставка + "u").ТелоТекст), Приставка + "u");
	Последняя = ИменаВ(ГруппаЛичных(Получить("pq=" + Приставка + "u&ppage=2").ТелоТекст), Приставка + "u");
	Для Каждого Номер Из СтрРазделить("abc,-3,0", ",") Цикл
		Ответ = Получить("pq=" + Приставка + "u&ppage=" + Номер);
		Ожидаем.Что(Ответ.Код, "ppage=" + Номер + " — без ошибки").Равно(200);
		Ожидаем.Что(ИменаВ(ГруппаЛичных(Ответ.ТелоТекст), Приставка + "u"), "ppage=" + Номер + " — первая страница")
			.Равно(Первая);
	КонецЦикла;
	ЗаКонцом = Получить("pq=" + Приставка + "u&ppage=999");
	Ожидаем.Что(ЗаКонцом.Код, "ppage за концом — без ошибки").Равно(200);
	Ожидаем.Что(ИменаВ(ГруппаЛичных(ЗаКонцом.ТелоТекст), Приставка + "u"), "ppage за концом — последняя страница")
		.Равно(Последняя);

	// группа раскрыта уже одной страницей группы, без поиска по ней
	Ожидаем.Что(Кат(ГруппаЛичных(Получить("ppage=2").ТелоТекст)), "листали группу — она раскрыта")
		.Содержит(" open");

КонецПроцедуры

&Тест
Процедура СтраницыДелятСписокИНесутОтбор() Экспорт

	Приставка = "pg" + УникальныеИмена.Хвост();
	Для Номер = 1 По 22 Цикл
		ЗавестиПул(Приставка + "-" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0"), "public", Ложь);
	КонецЦикла;

	Первая = Получить("q=" + Приставка);
	Ожидаем.Что(СтрРазделить(Имена(Первая, Приставка), ",").Количество(), "на первой странице 20").Равно(20);
	Ожидаем.Что(Первая.ТелоТекст, "диапазон записей назван").Содержит("1–20 из 22");
	Ожидаем.Что(Первая.ТелоТекст, "шаг вперёд несёт отбор").Содержит("q=" + Приставка);

	Вторая = Получить("q=" + Приставка + "&page=2");
	Ожидаем.Что(СтрРазделить(Имена(Вторая, Приставка), ",").Количество(), "на второй — остаток").Равно(2);
	Ожидаем.Что(Имена(Получить("q=" + Приставка + "&page=40"), Приставка),
		"номер за концом читается последней страницей").Равно(Имена(Вторая, Приставка));

КонецПроцедуры

#КонецОбласти

#Область Основной

&Тест
Процедура ОсновнойНазначаетсяТолькоСПодтверждением() Экспорт

	Имя = ЗавестиПул("prim");
	Прежний = СервисПулов().ИмяПулаПоУмолчанию();

	БезВопроса = Отправить(Имя + "/primary", "q=" + Имя);
	Ожидаем.Что(БезВопроса.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(БезВопроса.ПутьРедиректа), "на окно над тем же отбором")
		.Равно("/hub/settings/pools?q=" + Имя + "&окно=основной-" + Имя);
	Ожидаем.Что(СервисПулов().ИмяПулаПоУмолчанию(), "основной не изменился").Равно(Прежний);

	Окно = ОткрытыеОкна(Получить("окно=основной-" + Имя).ТелоТекст);
	Ожидаем.Что(Окно.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Окно[0], "уходит на назначение этого пула")
		.Содержит("action=""/hub/settings/pools/" + Имя + "/primary""");

	Ответ = Отправить(Имя + "/primary", "confirmed=1");
	Ожидаем.Что(Ответ.Код, "подтверждено — 303: " + Тост(Ответ)).Равно(303);
	Ожидаем.Что(СервисПулов().ИмяПулаПоУмолчанию(), "пул стал основным").Равно(Имя);

	// приватный пул домен основным не делает: причина названа, основной прежний
	Приватный = ЗавестиПул("prvp", "private");
	Отказ = Отправить(Приватный + "/primary", "confirmed=1");
	Ожидаем.Что(Отказ.Код, "приватный — 400").Равно(400);
	Ожидаем.Что(Тост(Отказ), "причина словами домена").Содержит("приватный");
	Ожидаем.Что(СервисПулов().ИмяПулаПоУмолчанию(), "основной прежний").Равно(Имя);

	Если ЗначениеЗаполнено(Прежний) Тогда
		Отправить(Прежний + "/primary", "confirmed=1");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Удаление

&Тест
Процедура ПодтверждениеУдаленияНазываетЧтоСнимается() Экспорт

	Имя = ЗавестиПул("cnt");
	Резервы = Желудь("СервисРезервированияИмён");
	Для Каждого Пакет Из СтрРазделить("alpha,beta", ",") Цикл
		Ожидаем.Что(Резервы.Зарезервировать(Принципалы.Сессия(Админ), Пул(Имя), Пакет).Успех,
			"пакет заведён").ЭтоИстина();
	КонецЦикла;
	Скрытый = Желудь("СервисПакетов").НайтиПакет(Пул(Имя).Идентификатор, "beta");
	Желудь("СервисПакетов").ОбновитьМетаданные(Скрытый.Идентификатор, Новый Структура("Скрыт", Истина));

	Открытые = ОткрытыеОкна(Получить("окно=удалить-" + Имя).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "эхо ждёт имя пула").Содержит("pattern=""" + Имя + """");
	Ожидаем.Что(Открытые[0], "последствия называют все пакеты и скрытые среди них")
		.Содержит("пакетов — 2, из них скрытых — 1");
	Ожидаем.Что(СтрокаТаблицы(Получить("q=" + Имя).ТелоТекст, Имя), "в строке таблицы — только видимые")
		.Содержит(">1<");
	Ожидаем.Что(Открытые[0], "и апстримы с зеркалами").Содержит("апстримов — 0, зеркал — 0");

КонецПроцедуры

&Тест
Процедура ПулУдаляетсяТолькоСВернымЭхом() Экспорт

	Имя = ЗавестиПул("del");
	Соседний = ЗавестиПул("near");

	БезВопроса = Отправить(Имя + "/delete", "имя=" + Имя);
	Ожидаем.Что(БезВопроса.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(БезВопроса.ПутьРедиректа), "на окно подтверждения")
		.Равно("/hub/settings/pools?окно=удалить-" + Имя);
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();

	Неверно = Отправить(Имя + "/delete", "confirmed=1&имя=" + Соседний);
	Ожидаем.Что(Неверно.Код, "чужое имя в эхе — 400").Равно(400);
	Открытые = ОткрытыеОкна(Неверно.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""имя"""), "эхо-поле помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();
	Ожидаем.Что(Пул(Соседний), "и соседний цел").Существует();

	Верно = Отправить(Имя + "/delete", "confirmed=1&имя=" + Имя);
	Ожидаем.Что(Верно.Код, "верное эхо — 303: " + Тост(Верно)).Равно(303);
	Ожидаем.Что(Пул(Имя), "пула нет").Равно(Неопределено);

	Нет = Отправить(Имя + "/delete", "confirmed=1&имя=" + Имя);
	Ожидаем.Что(Нет.Код, "удалённый — 404").Равно(404);
	Ожидаем.Что(Нет.ТелоТекст, "причина названа тостом").Содержит("toast--err");

КонецПроцедуры

// Основной пул домен не удаляет: окна для него нет, а прямая отправка отбивается словами домена.
&Тест
Процедура ОсновнойПулНеУдаляется() Экспорт

	Основной = СервисПулов().ИмяПулаПоУмолчанию();
	Если НЕ ЗначениеЗаполнено(Основной) Тогда
		Основной = ЗавестиПул("main");
		Отправить(Основной + "/primary", "confirmed=1");
	КонецЕсли;

	Ожидаем.Что(ОткрытыеОкна(Получить("окно=удалить-" + Основной).ТелоТекст).Количество(),
		"окна удаления основного нет").Равно(0);
	Ответ = Отправить(Основной + "/delete", "confirmed=1&имя=" + Основной);
	Ожидаем.Что(Ответ.Код, "отказ — 400").Равно(400);
	Ожидаем.Что(Тост(Ответ), "причина словами домена").Содержит("основной пул хаба");
	Ожидаем.Что(Пул(Основной), "основной цел").Существует();

КонецПроцедуры

#КонецОбласти

#Область ЗначенияРаздела

// Формы значений раздела уходят на адрес раздела вместе с окном нового пула; их принимает дом «Хаб».
&Тест
Процедура ФормаЗначенийРазделаСохраняетсяДомом() Экспорт

	Ключ = "oshub.pools.default_quota_mb";
	Было = Желудь("СервисНастроек").Значение(Ключ);

	Ответ = Отправить("", Ключ + "=777&oshub.pools.personal_enabled=1");
	Ожидаем.Что(Ответ.Код, "сохранено — перенаправление: " + Тост(Ответ)).Равно(302);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой").Равно("/hub/settings/pools?saved=1");
	Ожидаем.Что(Желудь("СервисНастроек").Значение(Ключ), "квота по умолчанию записана").Равно(777);

	Сброс = Отправить("", "операция=" + Желудь("ВитринаНастроек").ОперацияСброса() + "&ключ=" + Ключ);
	Ожидаем.Что(Сброс.Код, "сброс принят домом: " + Тост(Сброс)).Равно(302);
	Ожидаем.Что(Желудь("СервисНастроек").Значение(Ключ), "сброс вернул прежнее").Равно(Было);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция СервисПулов()
	Возврат Желудь("СервисПулов");
КонецФункции

Функция Пул(Знач Имя)
	Возврат СервисПулов().НайтиПул(Имя);
КонецФункции

// Пул заводится службой доступа от имени администратора; имя — с уникальным хвостом.
Функция ЗавестиПул(Знач Приставка, Знач Видимость = "public", Знач СХвостом = Истина)
	Имя = ?(СХвостом, Приставка + УникальныеИмена.Хвост(), Приставка);
	Желудь("СлужбаДоступа").СоздатьПул(Админ, Имя, "custom", Видимость);
	Возврат Имя;
КонецФункции

Функция ФормаНового(Знач Имя, Знач Видимость = "public", Знач Квота = "-1")
	Возврат "операция=новый-пул&имя=" + Имя + "&видимость=" + Видимость + "&квота_мб=" + Квота;
КонецФункции

// GET раздела с параметрами адреса «имя=значение&…» — как его доставил бы winow: обработчик
// находит настоящий маршрутизатор, параметры адреса ложатся в точку маршрута по именам, а не по
// местам; параметра, которого точка не объявляет, она не видит, неприсланный приходит Неопределено.
Функция Получить(Знач Запрос)

	Обработчик = Маршруты.Обработчик("/hub/settings/pools");
	Ожидаем.Что(Обработчик.Контроллер + "." + Обработчик.Метод, "КОНТРОЛЬ: адрес раздела — точка раздела")
		.Равно("КонтроллерПуловХаба.Раздел");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Значения = Параметры(Запрос);
	Значения.Вставить("Ответ", Ответ);
	Значения.Вставить("ЗаголовкиЗапроса", Новый Соответствие());
	Значения.Вставить("КукиЗапроса", Новый КукиЗаглушка());
	Значения.Вставить("МетодЗапроса", "GET");
	Значения.Вставить("ТелоЗапроса", "");

	Аргументы = Новый Массив();
	Для Каждого Имя Из ИменаПараметров(Пулы, Обработчик.Метод) Цикл
		Аргументы.Добавить(Значения.Получить(Имя));
	КонецЦикла;
	Рефлектор = Новый Рефлектор();
	Рефлектор.ВызватьМетод(Пулы, Обработчик.Метод, Аргументы);
	Возврат Ответ;

КонецФункции

Функция ИменаПараметров(Знач Объект, Знач ИмяМетода)

	Результат = Новый Массив();
	Рефлектор = Новый Рефлектор();
	Метод = Рефлектор.ПолучитьТаблицуМетодов(Объект).Найти(ИмяМетода, "Имя");
	Для Каждого Параметр Из Метод.Параметры Цикл
		Результат.Добавить(Параметр.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Проверить(Знач Имя)
	Возврат Получить("проверка=1&имя=" + Имя);
КонецФункции

// POST раздела: "" — адрес раздела, «<имя>/<действие>» — форма строки.
Функция Отправить(Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Пулы.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
		Возврат Ответ;
	КонецЕсли;

	Части = СтрРазделить(Хвост, "/");
	Если Части[1] = "primary" Тогда
		Пулы.Основной(Ответ, Части[0], Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
	Иначе
		Пулы.Удаление(Ответ, Части[0], Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция Параметры(Знач Запрос)

	Результат = Новый Соответствие();
	Для Каждого Пара Из СтрРазделить(Запрос, "&", Ложь) Цикл
		Равно = СтрНайти(Пара, "=");
		Результат.Вставить(Раскодировать(Лев(Пара, Равно - 1)), Раскодировать(Сред(Пара, Равно + 1)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена пулов строк таблицы, начинающиеся с приставки, через запятую в порядке показа.
Функция Имена(Знач Ответ, Знач Приставка)
	Возврат ИменаВ(Ответ.ТелоТекст, Приставка);
КонецФункции

Функция ИменаВ(Знач HTML, Знач Приставка)

	Результат = Новый Массив();
	Для Каждого Строка_ Из Куски(HTML, "<tr") Цикл
		Позиция = СтрНайти(Строка_, ">" + Приставка);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Строка_, Позиция + 1);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, "<") - 1));
	КонецЦикла;
	Возврат СтрСоединить(Результат, ",");

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)
	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);
КонецФункции

// Таблица пулов хаба — разметка до группы личных пространств.
Функция ТаблицаПулов(Знач HTML)
	Позиция = СтрНайти(HTML, "id=""lichnye-prostranstva""");
	Возврат ?(Позиция = 0, HTML, Лев(HTML, Позиция - 1));
КонецФункции

// Группа личных пространств — от её секции до конца страницы; группы нет — пусто.
Функция ГруппаЛичных(Знач HTML)
	Позиция = СтрНайти(HTML, "id=""lichnye-prostranstva""");
	Возврат ?(Позиция = 0, "", Сред(HTML, Позиция));
КонецФункции

// Открывающий тег ката группы: <details …>.
Функция Кат(Знач Группа)
	Позиция = СтрНайти(Группа, "<details");
	Возврат ?(Позиция = 0, "", Лев(Сред(Группа, Позиция), СтрНайти(Сред(Группа, Позиция), ">")));
КонецФункции

// Ячейка строки, чей текст — ровно Текст: от её <td до закрывающего тега; нет такой — пусто.
Функция ЯчейкаСТекстом(Знач Строка_, Знач Текст)
	Позиция = СтрНайти(Строка_, ">" + Текст + "<");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Строка_, "<td", НаправлениеПоиска.СКонца, Позиция);
	Возврат ?(Начало = 0, "", Сред(Строка_, Начало, Позиция - Начало + 1));
КонецФункции

// Строка таблицы с именем пула в первой ячейке: от её <tr до следующей.
Функция СтрокаТаблицы(Знач HTML, Знач Имя)
	Для Каждого Строка_ Из Куски(HTML, "<tr") Цикл
		Если СтрНайти(Строка_, ">" + Имя + "<") > 0 Тогда
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Текст тостов страницы: причина отказа, названная над разделом.
Функция Тост(Знач Ответ)
	Результат = Новый Массив();
	Для Каждого Кусок Из Куски(Ответ.ТелоТекст, "toast__text"">") Цикл
		Хвост = Сред(Кусок, СтрДлина("toast__text"">") + 1);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, "<") - 1));
	КонецЦикла;
	Возврат СтрСоединить(Результат, " / ");
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Куски разметки, каждый — от начала образца до следующего такого же.
Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
