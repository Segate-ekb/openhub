// Лента уведомлений /me/notifications: дверь «отметить всё прочитанным» стережёт гвард кабинета —
// на настоящем КонтроллерУведомлений; лента — фейк.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Лента;       // ФейкЛентыУведомлений
Перем Гвард;       // ГвардКабинетаЗаглушка
Перем Контроллер;  // КонтроллерУведомлений

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "АдресаСтраниц");

	Для Каждого Фикстура Из СтрРазделить("ФейкЛентыУведомлений,ГвардКабинетаЗаглушка,ЗащитаCSRFЗаглушка,"
		+ "ОтветСтраницыЗаглушка,КукиЗаглушка,ФейкСервисПрав", ",") Цикл
		РеестрФикстур.Подключить(Фикстура);
	КонецЦикла;

	КаталогWeb = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ОтветыНастроек,СборкаДомаНастроек,РазборФормы,ГейтФормы,ОтметкаСохранения,"
		+ "АдресаКабинета,КонтроллерУведомлений", ",") Цикл
		Поиск.Подключить(КаталогWeb, Имя);
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура СобратьКонтроллер() Экспорт

	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Новый ФейкСервисПрав(), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	РазборФормы = Новый РазборФормы();
	Лента = Новый ФейкЛентыУведомлений();
	Гвард = Новый ГвардКабинетаЗаглушка();
	Контроллер = Новый КонтроллерУведомлений(Гвард, Ответы, Защита, Новый ГейтФормы(Ответы, Защита, РазборФормы),
		РазборФормы, Лента, Неопределено, Новый АдресаКабинета(Новый АдресаСтраниц()), UI.Тексты,
		Новый ОтметкаСохранения());

КонецПроцедуры

// Кого гвард кабинета не впустил, тот ленту не отмечает: 403 без тела, никуда не уводит, лента
// непрочитанная. КОНТРОЛЬ: впущенный той же формой ленту отмечает и уходит на неё.
&Тест
Процедура ОтметкаЛентыНеДостаётсяТомуКогоГвардНеВпустил() Экспорт

	Ответ = Отправить("_csrf=токен-теста");

	Ожидаем.Что(Ответ.Код, "гвард не впустил — 403").Равно(403);
	Ожидаем.Что(Строка(Ответ.ТелоТекст), "и тела не отдано").Равно("");
	Ожидаем.Что(Ответ.ПутьРедиректа, "никуда не перенаправлен").Равно("");
	Ожидаем.Что(Лента.Отметок(), "лента не отмечена").Равно(0);
	Ожидаем.Что(Лента.Непрочитано(Неопределено), "непрочитанное на месте").Равно(3);

	// КОНТРОЛЬ: впущенный той же формой ленту отмечает
	Гвард.Впустить("alice");
	Впущенный = Отправить("_csrf=токен-теста");
	Ожидаем.Что(Лента.Отметок(), "КОНТРОЛЬ: впущенный отмечает").Равно(1);
	Ожидаем.Что(Лента.Непрочитано(Неопределено), "КОНТРОЛЬ: непрочитанного нет").Равно(0);
	Ожидаем.Что(Впущенный.ПутьРедиректа, "КОНТРОЛЬ: обратно на ленту").Содержит("/me/notifications");

КонецПроцедуры

Функция Отправить(Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Уведомления(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST", Тело);
	Возврат Ответ;
КонецФункции
