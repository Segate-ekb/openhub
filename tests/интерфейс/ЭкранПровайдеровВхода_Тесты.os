		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя), "провайдер цел").Существует();

	Верно = Отправить(Имя + "/delete", "confirmed=1&провайдер=" + Имя);
