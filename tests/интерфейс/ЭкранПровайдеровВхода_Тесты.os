Процедура УдачноеЗаведениеВедётНаРазделИЗаводитПровайдера() Экспорт

	Имя = "new" + УникальныеИмена.Хвост();
	Ответ = Отправить("", "пресет=github&имя=" + Имя + "&клиент=c1&секрет=s1"
		+ "&возврат=https://hub.example.com/oidc/callback&включить=1");

