// Экран «Провайдеры входа» — образец механизма «⚙ записи + окно по адресу + подтверждение»:
// окно по ?окно=…, отбитая форма в открытом окне, удаление через подтверждение и тумблер —
// настоящим контроллером поверх настоящей службы провайдеров в контейнере.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Принципалы;    // фикстура СтендПринципалов
Перем Гвард;         // ГвардХабаЗаглушка
Перем Сервис_;       // СервисПровайдеровВхода с фейковым резолвером имён
Перем Контроллер;    // КонтроллерПровайдеровВхода
Перем Админ;
Перем Геоправило;    // ГеоправилоПровайдера над настоящими правилами и фейковой обстановкой
Перем Оценка;        // ФейкПоследствийЗакрытия — сколько учёток останется без входа

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ФормаТемыСтраницы");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");
	Слои.ПодключитьТаблицы("уведомления");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("вход, права, настройки, гео, сеть, интерфейс/общее,"
		+ " интерфейс/хаб, интерфейс/панели/страна");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "КонтроллерПровайдеровВхода");

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкЖурналЗамка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ГвардХабаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ФейкПарольногоВхода");
	РеестрФикстур.Подключить("ФейкПоследствийЗакрытия");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-провайдеров-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Админ = Желудь("СервисПользователей").СоздатьПользователя("root7e", "", "password123", "admin");
	Гвард = Новый ГвардХабаЗаглушка();
	Гвард.Впустить(Новый Структура("Логин, Админ", "root7e", Истина), Принципалы.Сессия(Админ));

	Оценка = Новый ФейкПоследствийЗакрытия();
	Геоправило = Новый ГеоправилоПровайдера(
		Желудь("ХранилищеГеоправил"), Желудь("СправочникСтран"), Желудь("СписокЧерезЗапятую"),
		Желудь("КонфигурацияOIDC"), Новый ФейкПарольногоВхода(Истина), Оценка, Желудь("ТекстыВхода"),
		Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Желудь("ИздательСобытий"));
	Сервис_ = СобратьСервис();
	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Новый ФейкСервисПрав(), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Пульт = Новый ПультПровайдеровВхода(
		Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы")),
		Желудь("РазборФормы"), Сервис_, СобратьРазбор(), Желудь("ФормаПровайдераВхода"),
		Желудь("АдресИнстанса"), Желудь("ВалидаторАдресаПровайдера"), Желудь("ТекстыИнтерфейса"));
	Витрина = Новый ВитринаПровайдеровВхода(Желудь("Кит"), Сервис_, Геоправило,
		Желудь("АтрибуцияБазыСтран"), Желудь("СостояниеБазыСтран"), Желудь("ОкноРаздела"),
		Желудь("ОкноПровайдера"),
		Желудь("ОкноСтранПровайдера"), Желудь("ФормаПровайдераВхода"), Желудь("ЗначокПровайдера"),
		Желудь("ТекстыИнтерфейса"));
	Контроллер = Новый КонтроллерПровайдеровВхода(Гвард, Ответы, Желудь("ДомХаба"),
		Витрина, Пульт, Защита, Желудь("ОкноРаздела"),
		Желудь("ПосетительЗапроса"));

КонецПроцедуры

#Область ОкноПоАдресу

&Тест
Процедура ОкноПравкиПоАдресуПечатаетсяОткрытымСПолямиПровайдера() Экспорт

	Имя = Завести("edit");

	Страница = Получить("изменить-" + Имя);

	Ожидаем.Что(Страница.Код, "страница с окном отдана").Равно(200);
	Открытые = ОткрытыеОкна(Страница.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто ровно одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "окно правки называет провайдера").Содержит("Провайдер " + Имя);
	Ожидаем.Что(Открытые[0], "форма окна уходит на правку этого провайдера")
		.Содержит("action=""/hub/settings/providers/" + Имя + "/save""");
	Ожидаем.Что(Открытые[0], "client_id провайдера в поле окна").Содержит("value=""client-" + Имя + """");
	Шаги = ПанелиШагов(Открытые[0]);
	Ожидаем.Что(Шаги.Количество(), "две вкладки: «Провайдер» и «Учётки и группы»").Равно(2);
	Ожидаем.Что(Шаги[0], "адрес возврата — на первой вкладке").Содержит("name=""возврат""");
	Ожидаем.Что(Шаги[0], "области — там же").Содержит("name=""область""");

	Ожидаем.Что(СтрНачинаетсяС(Между(Страница.ТелоТекст, "<title>", "</title>"),
		"Провайдеры входа · Настройки хаба"), "вкладка называет раздел и дом").ЭтоИстина();

	// КОНТРОЛЬ: без параметра окна на странице ни одного открытого окна
	Ожидаем.Что(ОткрытыеОкна(Получить("").ТелоТекст).Количество(), "без ?окно= окна закрыты").Равно(0);

КонецПроцедуры

// Окно по адресу без скрипта стоит поверх страницы, и закрыть его можно в любом браузере: крестик
// и «Отмена» — ссылки на раздел без ?окно, а не команда движка «закрыть»; со скриптом они
// закрывают окно на месте (признак data-closes с якорем этого окна).
&Тест
Процедура ОкноПоАдресуЗакрываетсяСсылкойНаРаздел() Экспорт

	Имя = Завести("close");

	Открытые = ОткрытыеОкна(Получить("страны-" + Имя).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно «Страны и доступ» открыто").Равно(1);
	ПроверитьЗакрытиеСсылкой(Открытые[0], "provaider-strany", 2);

КонецПроцедуры

// Подтверждение по адресу закрывается так же: крестик и «Отмена» подтверждения — ссылки на раздел.
// Раньше «Отмена» подтверждения была командой движка и без скрипта не закрывала окно (кит-пробел П2).
&Тест
Процедура ПодтверждениеЗакрываетсяСсылкойНаРаздел() Экспорт

	Имя = Завести("closeconf");

	Открытые = ОткрытыеОкна(Получить("удалить-" + Имя).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение удаления открыто").Равно(1);
	ПроверитьЗакрытиеСсылкой(Открытые[0], "provaider-udalit", 2);
	Ожидаем.Что(Открытые[0], "КОНТРОЛЬ: кнопка подтверждения на месте").Содержит("name=""confirmed""");

КонецПроцедуры

// Окно шагами: «Отмена» встаёт первой в ряд кнопок шагов, тоже ссылкой на раздел; у закрытого на
// странице окна те же ссылки — со скриптом они закрывают его на месте, без перехода.
&Тест
Процедура ОкноШагамиОтменяетсяСсылкойВРядуШагов() Экспорт

	Открытые = ОткрытыеОкна(Получить("новый").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно «Новый провайдер» открыто").Равно(1);
	ПроверитьЗакрытиеСсылкой(Открытые[0], "provaider-novyi", 2);
	РядШагов = Между(Открытые[0], "steps__act--cancel", "</span>");
	Ожидаем.Что(РядШагов, "«Отмена» — в ряду кнопок шагов")
		.Содержит("data-closes=""provaider-novyi""");

	Закрытое = Между(Получить("").ТелоТекст, "id=""provaider-novyi""", "</dialog>");
	Ожидаем.Что(Закрытое, "КОНТРОЛЬ: закрытое окно на странице").Не_().Равно("");
	Ожидаем.Что(СтрЧислоВхождений(Закрытое, "command=""close"""), "и у закрытого команд движка нет").Равно(0);
	Ожидаем.Что(СтрЧислоВхождений(Закрытое, "data-closes=""provaider-novyi"""), "его закрывают ссылки")
		.Равно(2);

КонецПроцедуры

// Смена темы с раздела дома возвращает на этот раздел.
&Тест
Процедура СменаТемыСРазделаДомаВозвращаетНаНего() Экспорт

	Ожидаем.Что(Новый ФормаТемыСтраницы().ПутьВозврата(Получить("").ТелоТекст), "раздел «Провайдеры входа»")
		.Равно("/hub/settings/providers");

КонецПроцедуры

&Тест
Процедура НеизвестноеОкноДаётСтраницуБезОкна() Экспорт

	Имя = Завести("unk");

	Для Каждого Окно Из СтрРазделить("изменить-нет-такого,зачем-" + Имя + ",удалить,изменить", ",") Цикл
		Страница = Получить(Окно);
		Ожидаем.Что(Страница.Код, "?окно=" + Окно + " — страница раздела").Равно(200);
		Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОкноЗаведенияПоАдресуОткрыто() Экспорт

	Открытые = ОткрытыеОкна(Получить("новый").ТелоТекст);

	Ожидаем.Что(Открытые.Количество(), "по ?окно=новый открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно заведения").Содержит("Новый провайдер");

	// КОНТРОЛЬ: без адреса окно заведения на странице есть, но закрыто
	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Страница, "окно заведения на странице").Содержит("id=""provaider-novyi""");
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "и закрыто").Равно(0);

КонецПроцедуры

// Шага «Подключение» нет: адрес возврата нужен редко и ждёт под катом первого шага, под
// готовым адресом для копирования.
&Тест
Процедура ОкноЗаведенияДвумяШагамиАдресВозвратаПодКатом() Экспорт

	Окно = Между(Получить("").ТелоТекст, "id=""provaider-novyi""", "</dialog>");

	Шаги = ПанелиШагов(Окно);
	Ожидаем.Что(Шаги.Количество(), "два шага: «Провайдер» и «Учётки и группы»").Равно(2);
	Ожидаем.Что(Шаги[0], "первый шаг — «Провайдер»").Содержит(">Провайдер</span>");
	Ожидаем.Что(Шаги[1], "второй — «Учётки и группы»").Содержит(">Учётки и группы</span>");
	Ожидаем.Что(СтрНайти(Окно, "Подключение"), "шага «Подключение» нет").Равно(0);

	Кат = КатАдресаВозврата(Шаги[0]);
	Ожидаем.Что(Кат.Тело, "поле адреса возврата — под катом первого шага").Содержит("name=""возврат""");
	Ожидаем.Что(Кат.Открыт, "кат свёрнут").ЭтоЛожь();
	// у врезки кита свой треугольник раскрытия: строка не выглядит пустым полем в рамке
	Ожидаем.Что(Сред(Шаги[0], Кат.Позиция, 21), "кат — врезка кита с признаком раскрытия")
		.Равно("<details class=""fold""");
	Ожидаем.Что(Кат.Тело, "подсказка поля прежняя")
		.Содержит("Пусто — адрес из адреса хаба; свой — только если хаб стоит за прокси с другим адресом");
	// готовый адрес для копирования, а без адреса хаба — строка о том, почему его нет
	Готовый = Макс(СтрНайти(Шаги[0], "Адрес возврата — укажите"), СтрНайти(Шаги[0], "Адрес возврата не определён"));
	Ожидаем.Что(Готовый, "готовый адрес возврата — в первом шаге").Больше(0);
	Ожидаем.Что(Готовый < Кат.Позиция, "и над катом").ЭтоИстина();

КонецПроцедуры

// Набранный свой адрес не прячется: отбитая форма приезжает с раскрытым катом и адресом в поле.
&Тест
Процедура ОтбитоеЗаведениеСоСвоимАдресомВозвратаРаскрываетКат() Экспорт

	Ответ = Отправить("", "пресет=github&имя=Плохое имя&клиент=c1"
		+ "&возврат=https://outer.example.com/oidc/callback");

	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно заведения открыто").Равно(1);
	Кат = КатАдресаВозврата(Открытые[0]);
	Ожидаем.Что(Кат.Открыт, "кат раскрыт").ЭтоИстина();
	Ожидаем.Что(Тег(Кат.Тело, "input", "name=""возврат"""), "набранный адрес в поле")
		.Содержит("value=""https://outer.example.com/oidc/callback""");

	// КОНТРОЛЬ: отбитая форма без своего адреса — кат свёрнут
	Без = ОткрытыеОкна(Отправить("", "пресет=github&имя=Плохое имя&клиент=c1&возврат=").ТелоТекст);
	Ожидаем.Что(Без.Количество(), "КОНТРОЛЬ: окно открыто").Равно(1);
	Ожидаем.Что(КатАдресаВозврата(Без[0]).Открыт, "без своего адреса кат свёрнут").ЭтоЛожь();

КонецПроцедуры

// Негодный свой адрес возврата отбит у самого поля — тем же правилом, что домен: поле помечено,
// причина под ним, кат раскрыт; провайдер не заведён. То же — в окне правки.
&Тест
Процедура НегодныйАдресВозвратаОтбитУПоля() Экспорт

	Имя = "redir" + УникальныеИмена.Хвост();
	Ответ = Отправить("", "пресет=github&имя=" + Имя + "&клиент=c1&секрет=s1"
		+ "&возврат=" + Закодировать("ftp://user:pw@outer.example.com/cb"));

	Ожидаем.Что(Ответ.Код, "негодный адрес — отказ формы").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно заведения открыто").Равно(1);
	Кат = КатАдресаВозврата(Открытые[0]);
	Ожидаем.Что(Кат.Открыт, "кат раскрыт").ЭтоИстина();
	Ожидаем.Что(Тег(Кат.Тело, "input", "name=""возврат"""), "поле адреса помечено")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Кат.Тело, "причина — строкой под полем").Содержит("field__error");
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя), "провайдер не заведён").Равно(Неопределено);

	Правимый = Завести("redfix");
	Правка = Отправить(Правимый + "/save", "клиент=c2&возврат=" + Закодировать("ftp://outer.example.com/cb"));
	Ожидаем.Что(Правка.Код, "в правке — тоже отказ").Равно(400);
	Окно = ОткрытыеОкна(Правка.ТелоТекст);
	Ожидаем.Что(Окно.Количество(), "окно правки открыто").Равно(1);
	Ожидаем.Что(Тег(Окно[0], "input", "name=""возврат"""), "и поле адреса помечено")
		.Содержит("aria-invalid=""true""");

КонецПроцедуры

// Области — только у пресетов, которые их принимают: у GitHub поля нет, домен его отбил бы.
&Тест
Процедура ОбластиТолькоУПресетовКоторыеИхПринимают() Экспорт

	Окно = Между(Получить("").ТелоТекст, "id=""provaider-novyi""", "</dialog>");

	Ожидаем.Что(СтрНайти(НаборСегмента(Окно, "github"), "name=""область"), "у GitHub поля областей нет").Равно(0);
	Ожидаем.Что(НаборСегмента(Окно, "github"), "КОНТРОЛЬ: набор GitHub найден").Заполнено();
	Для Каждого Пресет Из СтрРазделить("gitlab,google,own", ",") Цикл
		Ожидаем.Что(НаборСегмента(Окно, Пресет), "у пресета «" + Пресет + "» поле областей в его наборе")
			.Содержит("name=""область-" + Пресет + """");
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Окно, "name=""область"""), "общего поля областей в окне заведения нет").Равно(0);

	// области своего провайдера доезжают до записи из поля его набора
	Имя = "own" + УникальныеИмена.Хвост();
	Ответ = Отправить("", "пресет=own&протокол=oidc&издатель=https://idp.example.com&имя=" + Имя
		+ "&клиент=c1&секрет=s1&возврат=https://hub.example.com/oidc/callback"
		+ "&область-gitlab=read_user&область-own=openid profile email teams&включить=1");
	Ожидаем.Что(Ответ.Код, "свой провайдер заведён").Равно(303);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Область, "области из набора «Свой», а не соседнего")
		.Равно("openid profile email teams");

КонецПроцедуры

&Тест
Процедура ЗаписьРеестраВедётМенюКОкнамПоАдресу() Экспорт

	Имя = Завести("menu");

	Запись = ЗаписьРеестра(Получить("").ТелоТекст, Имя);
	Ожидаем.Что(Запись, "запись провайдера в реестре").Заполнено();
	Для Каждого Вид Из СтрРазделить("изменить,страны,удалить", ",") Цикл
		Ожидаем.Что(Запись, "в наборе действий — окно «" + Вид + "» по адресу")
			.Содержит("href=""/hub/settings/providers?" + Закодировать("окно") + "="
				+ Закодировать(Вид + "-" + Имя) + """");
	КонецЦикла;
	Ожидаем.Что(Запись, "тумблер записи — форма на переключение")
		.Содержит("action=""/hub/settings/providers/" + Имя + "/toggle""");

	// без скрипта форму тумблера шлёт запасная кнопка кита — одна, своей у хаба нет
	Форма = Сред(Запись, СтрНайти(Запись, "action=""/hub/settings/providers/" + Имя + "/toggle"""));
	Форма = Лев(Форма, СтрНайти(Форма, "</form>"));
	Ожидаем.Что(СтрЧислоВхождений(Форма, "type=""submit"""), "кнопка отправки тумблера одна").Равно(1);
	Ожидаем.Что(Форма, "и это запасная кнопка кита").Содержит("toggle__save");

КонецПроцедуры

&Тест
Процедура АдресОкнаНесётВидИКлючСДефисами() Экспорт

	Окна = Желудь("ОкноРаздела");

	Состояние = Окна.ИзАдреса("Изменить-corp-sso", "новый,изменить");
	Ожидаем.Что(Состояние, "окно известного вида разобрано").Существует();
	Ожидаем.Что(Состояние.Вид, "вид — до первого дефиса, без регистра").Равно("изменить");
	Ожидаем.Что(Состояние.Ключ, "ключ — всё после него, с дефисами").Равно("corp-sso");
	Ожидаем.Что(Окна.ИзАдреса("новый", "новый,изменить").Ключ, "окно без записи").Равно("");
	Ожидаем.Что(Окна.ИзАдреса("стереть-x", "новый,изменить"), "чужой вид — окна нет").Равно(Неопределено);
	Ожидаем.Что(Окна.ИзАдреса("", "новый,изменить"), "пусто — окна нет").Равно(Неопределено);

	// адрес окна кодирован целиком: кириллица в заголовке Location роняет ответ
	Адрес = Окна.Адрес("/hub/settings/providers", "удалить", "corp-sso");
	Ожидаем.Что(Адрес, "адрес окна — раздел с параметром")
		.Равно("/hub/settings/providers?" + Закодировать("окно") + "=" + Закодировать("удалить-corp-sso"));

КонецПроцедуры

#КонецОбласти

#Область Значок

// Значок своего провайдера — сетка кита только с брендами; «По издателю» — пустая ячейка,
// у нового окна она отмечена. Без скрипта сетка видна целиком, строка поиска спрятана.
&Тест
Процедура ЗначокСвоегоПровайдераВыбираетсяСеткойБрендов() Экспорт

	Свой = НаборСегмента(ОткрытыеОкна(Получить("новый").ТелоТекст)[0], "own");
	Сетка = Тег(Свой, "fieldset", "data-iconpicker=");
	Ожидаем.Что(Сетка, "в наборе «Свой» — сетка значков кита").Заполнено();
	Ячейки = Между(Свой, Сетка, "</fieldset>");
	Ожидаем.Что(Тег(Ячейки, "div", "data-iconpicker-search"), "поиск без скрипта спрятан").Содержит("hidden");
	Ожидаем.Что(Тег(Ячейки, "input", "value="""""), "«По издателю» отмечено").Содержит("checked");
	Ожидаем.Что(Ячейки, "и подписано").Содержит("По издателю");
	Ключ = Желудь("Иконка").Отрисовать("ключ");
	Ожидаем.Что(Между(Ячейки, "value=""""", "</label>"), "нарисовано глифом «ключ», а не знаком «ничего»")
		.Содержит(Сред(Ключ, СтрНайти(Ключ, "<path")));

	Значений = 0;
	Для Каждого Кусок Из Куски(Ячейки, "<input type=""radio""") Цикл
		Значение = Между(Кусок, "value=""", """");
		Если ЗначениеЗаполнено(Значение) Тогда
			Значений = Значений + 1;
			Ожидаем.Что(СтрНачинаетсяС(Значение, "бренд:"), "в сетке только бренды: " + Значение).ЭтоИстина();
			Ожидаем.Что(Желудь("ЗначокПровайдераВхода").Нормализовать(Значение), "домен принимает " + Значение)
				.Равно(Значение);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Значений, "КОНТРОЛЬ: бренды в сетке есть").Больше(5);
	Ожидаем.Что(СтрНайти(НаборСегмента(ОткрытыеОкна(Получить("новый").ТелоТекст)[0], "github"), "data-iconpicker="),
		"у пресета поля значка нет").Равно(0);

КонецПроцедуры

// Выбранный бренд доезжает до записи и печатается логотипом в списке и отмеченным в окне правки;
// без значка — бренд по пресету или издателю, незнакомому издателю — глиф «ключ»; незнакомое имя
// значка — 400 без записи.
&Тест
Процедура ЗначокПровайдераПечатаетсяВСпискеИОкнеПравки() Экспорт

	Имя = "brand" + УникальныеИмена.Хвост();
	Ответ = Отправить("", "пресет=own&протокол=oidc&издатель=https://idp.example.com&имя=" + Имя
		+ "&клиент=c1&секрет=s1&возврат=https://hub.example.com/oidc/callback&значок="
		+ Закодировать("бренд:authentik"));
	Ожидаем.Что(Ответ.Код, "заведение со значком — 303").Равно(303);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Значок, "значок записан именем бренда").Равно("бренд:authentik");

	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Рисунок(ЗначокЗаписи(ЗаписьРеестра(Страница, Имя))), "в списке — логотип выбранного бренда")
		.Равно(РисунокКита("бренд:authentik"));
	Правка = ОткрытыеОкна(Получить("изменить-" + Имя).ТелоТекст)[0];
	Ожидаем.Что(Тег(Правка, "input", "value=""бренд:authentik"""), "в окне правки бренд отмечен")
		.Содержит("checked");
	Отбитая = Отправить(Имя + "/save", "клиент=c1&возврат=https://hub.example.com/oidc/callback&значок=замок");
	Ожидаем.Что(Отбитая.Код, "правка с незнакомым значком — 400").Равно(400);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Значок, "прежний значок цел").Равно("бренд:authentik");

	Пресетный = Завести("gh");
	Ожидаем.Что(Рисунок(ЗначокЗаписи(ЗаписьРеестра(Получить("").ТелоТекст, Пресетный))), "у GitHub — его логотип")
		.Равно(РисунокКита("бренд:github"));

	Безымянный = "plain" + УникальныеИмена.Хвост();
	Отправить("", "пресет=own&протокол=oidc&издатель=https://idp.example.com&имя=" + Безымянный
		+ "&клиент=c1&секрет=s1&возврат=https://hub.example.com/oidc/callback&значок=");
	Запись = ЗаписьРеестра(Получить("").ТелоТекст, Безымянный);
	Ожидаем.Что(Запись, "КОНТРОЛЬ: свой провайдер без значка заведён").Заполнено();
	Ожидаем.Что(Рисунок(ЗначокЗаписи(Запись)), "незнакомому издателю — глиф «ключ»").Равно(РисунокКита("ключ"));

	Чужой = "bad" + УникальныеИмена.Хвост();
	Отбитый = Отправить("", "пресет=own&протокол=oidc&издатель=https://idp.example.com&имя=" + Чужой
		+ "&клиент=c1&секрет=s1&возврат=https://hub.example.com/oidc/callback&значок=замок");
	Ожидаем.Что(Отбитый.Код, "глиф вместо бренда — 400").Равно(400);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Чужой), "провайдер не заведён").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОтбитаяФорма

&Тест
Процедура ОтбитоеЗаведениеВозвращаетОткрытоеОкноСНабраннымИОтказомУПоля() Экспорт

	Ответ = Отправить("", "пресет=github&имя=Плохое имя&клиент=набранный-клиент");

	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Больше(399);
	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Меньше(500);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно «Новый провайдер» открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно заведения").Содержит("Новый провайдер");
	ПолеИмени = Тег(Открытые[0], "input", "name=""имя""");
	Ожидаем.Что(ПолеИмени, "поле имени помечено негодным").Содержит("aria-invalid=""true""");
	Ожидаем.Что(ПолеИмени, "набранное имя на месте").Содержит("value=""Плохое имя""");
	Ожидаем.Что(Открытые[0], "набранный client_id на месте").Содержит("value=""набранный-клиент""");
	Ожидаем.Что(Сервис_.КарточкаПоИмени("Плохое имя"), "провайдер не заведён").Равно(Неопределено);

КонецПроцедуры

