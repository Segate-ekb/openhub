&Тест
Процедура ОтказДоменаВПравкеОставляетОкноОткрытымСПричиной() Экспорт

	Имя = Завести("bad");

	Ответ = Отправить(Имя + "/save", "клиент=c2&возврат=http://hub.example.com/cb&включить=1");

	Ожидаем.Что(Ответ.Код, "отказ домена — 4xx").Больше(399);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно правки открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "окно — правка этого провайдера").Содержит("Провайдер " + Имя);
	Ожидаем.Что(Открытые[0], "причина отказа в окне").Содержит("role=""alert""");
	Ожидаем.Что(Открытые[0], "набранный адрес на месте").Содержит("value=""http://hub.example.com/cb""");
	Ожидаем.Что(КатАдресаВозврата(Открытые[0]).Открыт, "кат с отбитым адресом раскрыт").ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).ИдентификаторКлиента, "провайдер не тронут")
		.Равно("client-" + Имя);

КонецПроцедуры

#КонецОбласти

#Область Удаление

&Тест
Процедура УдалениеБезПодтвержденияВедётНаОкноПодтвержденияИЗаписьЦела() Экспорт

	Имя = Завести("del");

	Ответ = Отправить(Имя + "/delete", "провайдер=" + Имя);

	Ожидаем.Что(Ответ.Код, "первая отправка — 303").Равно(303);
	Ожидаем.Что(РаскодироватьСтроку(Ответ.ПутьРедиректа, СпособКодированияСтроки.КодировкаURL),
		"на страницу с открытым подтверждением").Равно("/hub/settings/providers?окно=удалить-" + Имя);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя), "провайдер цел").Существует();

	// по этому адресу страница печатает подтверждение открытым, с эхо-полем имени
	Открытые = ОткрытыеОкна(Получить("удалить-" + Имя).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "подтверждение — опасное окно").Содержит("modal--confirm");
	Ожидаем.Что(Открытые[0], "эхо ждёт имя провайдера").Содержит("pattern=""" + Имя + """");

КонецПроцедуры

