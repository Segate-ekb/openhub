// Окна для отказа нет — записи уже нет: причина всё равно на странице, а не пустой ответ 4xx.
&Тест
Процедура ОтказБезОкнаНазванНаСтранице() Экспорт

	Имя = "gone" + УникальныеИмена.Хвост();

	Удаление = Отправить(Имя + "/delete", "confirmed=1&провайдер=" + Имя);
	Ожидаем.Что(Удаление.Код, "удаление несуществующего — 4xx").Больше(399);
	Ожидаем.Что(ОткрытыеОкна(Удаление.ТелоТекст).Количество(), "окна подтверждения нет").Равно(0);
	Ожидаем.Что(Удаление.ТелоТекст, "причина названа тостом раздела").Содержит("toast--err");
	Ожидаем.Что(Удаление.ТелоТекст, "и называет провайдера").Содержит(Имя);

	Тумблер = Отправить(Имя + "/toggle", "включить=0");
	Ожидаем.Что(Тумблер.Код, "тумблер несуществующего — 4xx").Больше(399);
	Ожидаем.Что(Тумблер.ТелоТекст, "причина названа тостом раздела").Содержит("toast--err");

КонецПроцедуры

#КонецОбласти

#Область ТумблерИСтраны

&Тест
Процедура ТумблерМеняетСостояниеПровайдераВДомене() Экспорт

	Имя = Завести("tgl");

	Выключить = Отправить(Имя + "/toggle", "включить=0");
	Ожидаем.Что(Выключить.Код, "тумблер — 303 на раздел").Равно(303);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Включён, "провайдер выключен").ЭтоЛожь();

	// включённый тумблер шлёт пару «1» и «0»: решает первое
	Отправить(Имя + "/toggle", "включить=1&включить=0");
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Включён, "провайдер включён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НегоднаяСтранаВозвращаетОкноСтранСОтказомУПоля() Экспорт

	Имя = Завести("geo");

	Ответ = Отправить(Имя + "/countries", "страны=RU, ZZ");

	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Больше(399);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно «Страны и доступ» открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно правила этого провайдера").Содержит("Страны и доступ: " + Имя);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""страны"""), "поле стран помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Открытые[0], "набранное на месте").Содержит("RU, ZZ");
	Ожидаем.Что(Геоправило.Правило(Имя).Есть, "правило не поставлено").ЭтоЛожь();

	// КОНТРОЛЬ: годные коды правило ставят
	Ожидаем.Что(Отправить(Имя + "/countries", "страны=RU, BY").Код, "годные коды — 303").Равно(303);
	Ожидаем.Что(Геоправило.Правило(Имя).Страны.Количество(), "закрыт в двух странах")
		.Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Провайдер пресета GitHub прямо через службу; имя — с уникальным хвостом.
Функция Завести(Знач Приставка)

	Имя = Приставка + УникальныеИмена.Хвост();
	Данные = Новый Структура();
	Данные.Вставить("Имя", Имя);
	Данные.Вставить("Пресет", "github");
	Данные.Вставить("ИдентификаторКлиента", "client-" + Имя);
	Данные.Вставить("СекретКлиента", "secret-" + Имя);
	Данные.Вставить("АдресВозврата", "https://hub.example.com/oidc/callback");
	Данные.Вставить("Включён", Истина);
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);
	Ожидаем.Что(Исход.Успех, "КОНТРОЛЬ: провайдер заведён: " + Исход.Сообщение).ЭтоИстина();
	Возврат Имя;

КонецФункции

Функция Получить(Знач Окно)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "127.0.0.1", "", Окно);
	Возврат Ответ;

КонецФункции

// POST формы раздела: "" — заведение, «<имя>/<действие>» — форма записи.
Функция Отправить(Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Заголовки = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Контроллер.Раздел(Ответ, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
		Возврат Ответ;
	КонецЕсли;

	Части = СтрРазделить(Хвост, "/");
	Имя = Части[0];
	Действие = Части[1];
	Если Действие = "save" Тогда
		Контроллер.Сохранение(Ответ, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
	ИначеЕсли Действие = "toggle" Тогда
		Контроллер.Переключение(Ответ, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
	ИначеЕсли Действие = "delete" Тогда
		Контроллер.Удаление(Ответ, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
	Иначе
		Контроллер.ЗакрытыеСтраны(Ответ, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы, "127.0.0.1");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пункт реестра провайдера: от <li class="entry"> с его именем в сводке до следующего пункта.
Функция ЗаписьРеестра(Знач HTML, Знач Имя)

	Для Каждого Пункт Из Куски(HTML, "<li class=""entry""") Цикл
		Если СтрНайти(Пункт, ">" + Имя + "<") > 0 Тогда
			Возврат Пункт;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Значок записи реестра — <svg> с классом значка записи.
Функция ЗначокЗаписи(Знач Запись)
	Для Каждого Кусок Из Куски(Запись, "<svg") Цикл
		Если СтрНайти(Лев(Кусок, СтрНайти(Кусок, ">")), "entry__icon") > 0 Тогда
			Возврат Лев(Кусок, СтрНайти(Кусок, "</svg>") + 5);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Рисунок значка без классов и подписи: всё после открывающего тега <svg>.
Функция Рисунок(Знач Svg)
	Возврат Сред(Svg, СтрНайти(Svg, ">") + 1);
КонецФункции

Функция РисунокКита(Знач ИмяЗначка)
	Возврат Рисунок(Желудь("Иконка").Отрисовать(ИмяЗначка));
КонецФункции

// Окно закрывается без скрипта ссылками на раздел: столько ссылок data-closes с якорем окна, сколько
// ждём (крестик и «Отмена»), каждая ведёт на раздел без ?окно; команд движка «закрыть» в окне нет.
Процедура ПроверитьЗакрытиеСсылкой(Знач Окно, Знач Якорь, Знач Ссылок)

	Ожидаем.Что(СтрЧислоВхождений(Окно, "command=""close"""), "команд движка «закрыть» в окне нет").Равно(0);
	Закрывающие = Новый Массив();
	Для Каждого Кусок Из Куски(Окно, "<a ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, "data-closes=""" + Якорь + """") > 0 Тогда
			Закрывающие.Добавить(Тег_);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Закрывающие.Количество(), "крестик и «Отмена» — ссылки, закрывающие окно").Равно(Ссылок);
	Для Каждого Ссылка Из Закрывающие Цикл
		Ожидаем.Что(Ссылка, "ссылка ведёт на раздел без окна").Содержит("href=""/hub/settings/providers""");
	КонецЦикла;

КонецПроцедуры

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Куски разметки, каждый — от начала образца до следующего такого же.
Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);

КонецФункции

// Панели шагов окна по порядку: каждая — от своего признака до следующей.
Функция ПанелиШагов(Знач HTML)
	Возврат Куски(HTML, "data-steps-panel");
КонецФункции

// Кат «Свой адрес возврата»: открыт ли он (атрибут open у его <details>), где он и что под ним.
Функция КатАдресаВозврата(Знач HTML)

	Шапка = СтрНайти(HTML, ">Свой адрес возврата</summary>");
	Ожидаем.Что(Шапка, "кат «Свой адрес возврата» на месте").Больше(0);
	Начало = СтрНайти(HTML, "<details", НаправлениеПоиска.СКонца, Шапка);
	Открывающий = Лев(Сред(HTML, Начало), СтрНайти(Сред(HTML, Начало), ">"));
	Хвост = Сред(HTML, Шапка);
	Возврат Новый Структура("Позиция, Открыт, Тело", Начало,
		СтрНайти(Открывающий, " open") > 0, Лев(Хвост, СтрНайти(Хвост, "</details>") - 1));

КонецФункции

// Набор сегмента пресета: от его панели до панели следующего пресета. Набор «Свой» — последний
// и несёт вложенные сегменты протокола, поэтому он идёт до конца окна.
Функция НаборСегмента(Знач HTML, Знач Значение)

	Набор = Между(HTML, "data-segment=""" + Значение + """", "</dialog>");
	Для Каждого Следующий Из СтрРазделить("github,gitlab,google,own", ",") Цикл
		Позиция = СтрНайти(Набор, "data-segment=""" + Следующий + """");
		Если Следующий <> Значение И Позиция > 0 Тогда
			Набор = Лев(Набор, Позиция - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Набор;

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Служба с фейковым резолвером имён: адреса пресетов проверяются офлайн.
Функция СобратьСервис()
	Возврат Новый СервисПровайдеровВхода(
		Желудь("ХранилищеПровайдеровВхода"), Желудь("КонфигурацияOIDC"), СобратьРазбор(),
		Желудь("ПерехватчикАутентификации"), Желудь("СервисПрав"),
		Желудь("ТекстыВхода"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Желудь("ЗначокПровайдераВхода"), Желудь("ГейтТокена"),
		Желудь("ИздательСобытий"), Геоправило, Неопределено);
КонецФункции

Функция СобратьРазбор()
	Возврат Новый РазборПровайдераВхода(
		Новый ПресетыВхода(Желудь("ТекстыВхода"), Новый ИздателиOAuth2()), Новый ИздателиOAuth2(),
		Новый ВалидаторАдресаПровайдера(Новый СвояСеть(Желудь("КанонIP")), Новый ИздателиOAuth2(),
			Желудь("ТекстыВхода")),
		Желудь("ЗначокПровайдераВхода"), Желудь("ТекстыВхода"), Желудь("ТекстОшибки"),
		Логирование.ПолучитьЛог("тест.oshub.экран-провайдеров"));
КонецФункции

#КонецОбласти
