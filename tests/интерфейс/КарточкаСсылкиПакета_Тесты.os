// Карточка ссылки на страницу пакета: что увидит мессенджер, получивший ссылку, — заглавие,
// описание, адрес и картинка; приватный пул карточки не отдаёт, относительных адресов нет.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // Структура компонентов (фикстура СборкаUI)
Перем Бренд;       // БрендКарточкиЗаглушка
Перем Настройки;   // НастройкиЗаглушка — внешний адрес хаба
Перем Открытый;    // ПулЗаглушка — публичный пул
Перем Закрытый;    // ПулЗаглушка — приватный пул

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогКлассов = ОбъединитьПути(Модули, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("БрендКарточкиЗаглушка");

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "АдресИнстанса");
	Поиск.Подключить(ОбъединитьПути(Модули, "права", "Классы"), "СервисПрав");
	Поиск.Подключить(КаталогКлассов, "КарточкаСсылкиПакета");

	UI = Новый СборкаUI().Собрать(КаталогКлассов);

	Открытый = Новый ПулЗаглушка(1, "team", "regular", 0, Истина, "public");
	Закрытый = Новый ПулЗаглушка(2, "inner", "regular", 0, Истина, "private");

КонецПроцедуры

&ПередКаждым
Процедура ЗадатьХаб() Экспорт
	Бренд = Новый БрендКарточкиЗаглушка();
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.instance.url", АдресХаба());
КонецПроцедуры

#Область Свойства

// Заглавие, описание и адрес — то, из чего мессенджер собирает карточку.
&Тест
Процедура ПубличныйПакетПолучаетКарточкуСАбсолютнымАдресом() Экспорт

	Карточка = Свойства(Открытый, Пакет("https://github.com/acme/lib"), Версия("1.2.3"));

	Ожидаем.Что(Карточка.Получить("og:title"), "заглавие — имя пакета").Равно("lib");
	Ожидаем.Что(Карточка.Получить("og:description"), "описание пакета").Равно("Библиотека проб");
	Ожидаем.Что(Карточка.Получить("og:site_name"), "название хаба").Равно("Ромашка");
	Ожидаем.Что(Карточка.Получить("og:url"), "адрес страницы — абсолютный")
		.Равно(АдресХаба() + "/pools/team/packages/lib");

КонецПроцедуры

// Страница версии — своя карточка: заглавие называет версию, адрес — её собственный,
// картинка GitHub снята с ключом этой версии, а не версии по умолчанию.
&Тест
Процедура СтраницаВерсииПолучаетКарточкуВерсии() Экспорт

	Карточка = Свойства(Открытый, Пакет("https://github.com/acme/lib"), Версия("2.0.0"), Версия("1.2.3"));

	Ожидаем.Что(Карточка.Получить("og:title"), "пакет и версия").Равно("lib 1.2.3");
	Ожидаем.Что(Карточка.Получить("og:url"), "адрес страницы версии")
		.Равно(АдресХаба() + "/pools/team/packages/lib?version=1.2.3");
	Ожидаем.Что(Карточка.Получить("og:image"), "картинка этой версии")
		.Равно("https://opengraph.githubassets.com/1.2.3/acme/lib");

КонецПроцедуры

// Приватную страницу краулер не получит, и разметки для него на ней нет.
&Тест
Процедура ПриватныйПулКарточкиНеПолучает() Экспорт

	Карточка = Новый КарточкаСсылкиПакета(Права(), АдресИнстанса(), Новый АдресаСтраниц(), UI.Адреса,
		Бренд, Новый РазборАдреса()).Свойства(Закрытый, Пакет("https://github.com/acme/lib"), Версия("1.2.3"));

	Ожидаем.Что(Карточка.Количество(), "свойств нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Картинка

// Репозиторий на GitHub — его социальная карточка; ключ кэша — версия страницы.
&Тест
Процедура РепозиторийGitHubДаётЕгоСоциальнуюКарточку() Экспорт

	Карточка = Свойства(Открытый, Пакет("https://github.com/acme/lib"), Версия("1.2.3"));

	Ожидаем.Что(Карточка.Получить("og:image"), "картинка GitHub")
		.Равно("https://opengraph.githubassets.com/1.2.3/acme/lib");

КонецПроцедуры

// Адрес репозитория пишут по-разному: адрес клона, www, хвостовой слеш, путь внутрь.
&Тест
Процедура ЗаписиАдресаGitHubДаютОднуКарточку() Экспорт

	Ожидаемая = "https://opengraph.githubassets.com/1.2.3/acme/lib";
	Для Каждого Адрес Из СтрРазделить("https://github.com/acme/lib.git|http://www.github.com/acme/lib/|"
		+ "https://github.com/acme/lib/tree/main?tab=readme#usage|https://GitHub.com/acme/lib", "|") Цикл
		Ожидаем.Что(Свойства(Открытый, Пакет(Адрес), Версия("1.2.3")).Получить("og:image"), Адрес)
			.Равно(Ожидаемая);
	КонецЦикла;

КонецПроцедуры

// Ключ кэша в адресе картинки — только безопасные символы: метка сборки semver адрес не ломает.
&Тест
Процедура КлючКэшаКартинкиБезСпецсимволов() Экспорт

	Карточка = Свойства(Открытый, Пакет("https://github.com/acme/lib"), Версия("2.0.0+build/7"));

	Ожидаем.Что(Карточка.Получить("og:image"), "ключ без «+» и «/»")
		.Равно("https://opengraph.githubassets.com/2.0.0-build-7/acme/lib");

КонецПроцедуры

// Не GitHub — растровый знак хаба абсолютным адресом: SVG мессенджер не показывает.
&Тест
Процедура НеGitHubДаётРастровыйЗнакХаба() Экспорт

	Для Каждого Адрес Из СтрРазделить("https://gitlab.com/acme/lib|https://github.com/acme|"
		+ "git@github.com:acme/lib.git|https://github.com.evil.example/acme/lib|"
		+ "https://github.com/acme/<lib>|", "|") Цикл
		Картинка = Свойства(Открытый, Пакет(Адрес), Версия("1.2.3")).Получить("og:image");
		Ожидаем.Что(Картинка, "знак хаба для «" + Адрес + "»")
			.Равно(АдресХаба() + UI.Адреса.АдресИконкиДомашнегоЭкрана());
		Ожидаем.Что(СтрЗаканчиваетсяНа(Картинка, ".png"), "и это PNG: " + Картинка).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Загруженная администратором иконка вытесняет знак поставки, если она растровая.
&Тест
Процедура ЗагруженнаяРастроваяИконкаИдётВКарточку() Экспорт

	Бренд.ЗагрузитьИконку("/brand/favicon-ab12.png", "image/png");

	Ожидаем.Что(Свойства(Открытый, Пакет(""), Версия("1.2.3")).Получить("og:image"), "загруженная иконка")
		.Равно(АдресХаба() + "/brand/favicon-ab12.png");

КонецПроцедуры

// Загруженная SVG картинкой карточки быть не может, а знак поставки был бы чужим брендом.
&Тест
Процедура ЗагруженнаяSVGОставляетКарточкуБезКартинки() Экспорт

	Бренд.ЗагрузитьИконку("/brand/favicon-ab12.svg", "image/svg+xml");

	Ожидаем.Что(Свойства(Открытый, Пакет(""), Версия("1.2.3")).Получить("og:image"), "картинки нет")
		.Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область БезВнешнегоАдреса

// Без внешнего адреса абсолютного адреса страницы и знака нет; заглавие и картинка GitHub —
// адресов хаба не требуют.
&Тест
Процедура БезВнешнегоАдресаНетОтносительныхАдресов() Экспорт

	Настройки.Задать("oshub.instance.url", "");

	СGitHub = Свойства(Открытый, Пакет("https://github.com/acme/lib"), Версия("1.2.3"));
	Ожидаем.Что(СGitHub.Получить("og:url"), "адреса страницы нет").Равно(Неопределено);
	Ожидаем.Что(СGitHub.Получить("og:title"), "заглавие есть").Равно("lib");
	Ожидаем.Что(СGitHub.Получить("og:image"), "картинка GitHub абсолютна сама по себе")
		.Равно("https://opengraph.githubassets.com/1.2.3/acme/lib");

	БезGitHub = Свойства(Открытый, Пакет("https://gitlab.com/acme/lib"), Версия("1.2.3"));
	Ожидаем.Что(БезGitHub.Получить("og:image"), "относительного знака хаба нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свойства карточки соответствием «свойство → содержание»; пустые пары каркас не печатает,
// поэтому и здесь их нет.
Функция Свойства(Знач Пул, Знач Пакет, Знач ВерсияПоУмолчанию, Знач НазваннаяВерсия = Неопределено)

	Карточка = Новый КарточкаСсылкиПакета(Права(), АдресИнстанса(), Новый АдресаСтраниц(), UI.Адреса,
		Бренд, Новый РазборАдреса());

	Результат = Новый Соответствие();
	Для Каждого Пара Из Карточка.Свойства(Пул, Пакет, ВерсияПоУмолчанию, НазваннаяВерсия) Цикл
		Если ЗначениеЗаполнено(Пара.Содержание) Тогда
			Результат.Вставить(Пара.Свойство, Пара.Содержание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Права()
	Возврат Новый СервисПрав(Неопределено, Неопределено, Неопределено, Неопределено);
КонецФункции

Функция АдресИнстанса()
	Возврат Новый АдресИнстанса(Настройки);
КонецФункции

Функция Пакет(Знач АдресРепозитория)
	Возврат Новый Структура("Имя, Описание, АдресРепозитория", "lib", "Библиотека проб", АдресРепозитория);
КонецФункции

Функция Версия(Знач Номер)
	Возврат Новый Структура("Версия", Номер);
КонецФункции

Функция АдресХаба()
	Возврат "https://hub.example.ru";
КонецФункции

#КонецОбласти
