// Разделы «Видимость», «Квота» и «Опасная зона» дома «Пул»: видимость сегментами одной формой,
// квота полем только администратору хаба, удаление пула подтверждением с эхом имени по адресу
// ?окно=удалить — настоящим контроллером дома поверх настоящих служб пулов, доступа и прав.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Админ;         // администратор хаба: меняет квоту и удаляет пулы
Перем Владелец;      // владелец пула без роли хаба
Перем Гвард;         // ГвардПулаЗаглушка — впускает учётку в пул раздела либо никого
Перем Контроллер;    // КонтроллерДомаПула
Перем UI;            // СборкаUI — каркас и экранирование текстов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	// хранилище и публикация — ради удаления пула: уборка сносит область файлов и входящие заявки
	Слои.Подключить("данные, хранилище, публикация, реестр, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("почта, уведомления, вход, права, настройки, гео, сеть, кабинет, зеркала, прокси,"
		+ " интерфейс/общее, интерфейс/кабинет, интерфейс/панели, интерфейс/аккаунт, интерфейс/хаб,"
		+ " интерфейс/каталог");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "КонтроллерДомаПула");

	Для Каждого Фикстура Из СтрРазделить("НастройкиЗаглушка,ЗаписывающийПодписчик,ФейкЖурналЗамка,ЛовушкаЛога,"
		+ "ГвардПулаЗаглушка,ЗащитаCSRFЗаглушка,ОтветСтраницыЗаглушка,КукиЗаглушка,СборкаUI",
		",") Цикл
		РеестрФикстур.Подключить(Фикстура);
	КонецЦикла;

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-дома-пула-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Админ = Желудь("СервисПользователей").СоздатьПользователя("root9d", "", "password123", "admin");
	Владелец = Желудь("СервисПользователей").СоздатьПользователя("owner9d", "", "password123");
	Гвард = Новый ГвардПулаЗаглушка();

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Желудь("СервисПрав"), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Защита.ЗадатьИсход(Истина);
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));

	Контроллер = Новый КонтроллерДомаПула(Гвард, Ответы, Желудь("ТекстСбоя"), Желудь("ДомПула"),
		Желудь("ВитринаДомаПула"), Гейт, Защита, Желудь("РазборФормы"), Желудь("СервисПулов"),
		Желудь("ГвардКвотыПула"), Желудь("ПультПравПула"), Желудь("ПультЗаявок"), Желудь("ПультУдаленияПула"),
		Желудь("ДомАккаунта"), Желудь("ИтогПульта"), Желудь("ТекстыИнтерфейса"), Желудь("ОтметкаСохранения"),
		Желудь("ОкноРаздела"));

КонецПроцедуры

#Область Видимость

// Видимость — сегментами одной формы раздела: выбранная отмечена, отправка меняет пул в домене.
&Тест
Процедура ВидимостьСегментамиОднойФормойРаздела() Экспорт

	Имя = ЗавестиПул("vis");
	Впустить(Админ, Имя);

	Страница = Получить(Имя, "visibility").ТелоТекст;
	Ожидаем.Что(Страница, "форма раздела на его адресе")
		.Содержит("action=""/pools/" + Имя + "/settings/visibility""");
	Ожидаем.Что(Тег(Страница, "input", "value=""public"""), "публичный отмечен").Содержит("checked");
	Ожидаем.Что(Тег(Страница, "input", "value=""public"""), "сегмент — радиокнопка поля видимости")
		.Содержит("name=""видимость""");
	Ожидаем.Что(Тег(Страница, "input", "value=""private"""), "приватный не отмечен").Не_().Содержит("checked");

	Ответ = Отправить(Имя, "visibility", "видимость=private");
	Ожидаем.Что(Ответ.Код, "сохранено — перенаправление").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой")
		.Равно("/pools/" + Имя + "/settings/visibility?saved=1");
	Ожидаем.Что(НРег(Строка(Пул(Имя).Видимость)), "пул приватный").Равно("private");
	Ожидаем.Что(Тег(Получить(Имя, "visibility").ТелоТекст, "input", "value=""private"""),
		"приватный отмечен после сохранения").Содержит("checked");

КонецПроцедуры

// Видимость чужого значения — отказ раздела без записи.
&Тест
Процедура ЧужаяВидимостьОтбиваетсяБезЗаписи() Экспорт

	Имя = ЗавестиПул("visx");
	Впустить(Админ, Имя);

	Ответ = Отправить(Имя, "visibility", "видимость=всем");
	Ожидаем.Что(Ответ.Код, "отказ — 400").Равно(400);
	Ожидаем.Что(НРег(Строка(Пул(Имя).Видимость)), "видимость прежняя").Равно("public");

КонецПроцедуры

#КонецОбласти

#Область Квота

// Квоту меняет администратор хаба: ему — поле числа в форме раздела, владельцу пула — свойство
// без формы; и чья квота действует, сказано строкой.
&Тест
Процедура КвотаПолемТолькоАдминистраторуХаба() Экспорт

	Имя = ЗавестиПул("quo");

	Впустить(Админ, Имя);
	Администратору = Получить(Имя, "quota").ТелоТекст;
	Ожидаем.Что(Тег(Администратору, "input", "name=""квота_мб"""), "администратору — поле квоты")
		.Содержит("type=""number""");
	Ожидаем.Что(Администратору, "в форме раздела").Содержит("action=""/pools/" + Имя + "/settings/quota""");
	Откуда = СтрНайти(Администратору, Экранировать("settings.pool.quota.none")) > 0
		ИЛИ СтрНайти(Администратору, СтрРазделить(Экранировать("settings.pool.quota.inherited"), "%")[0]) > 0;
	Ожидаем.Что(Откуда, "откуда квота — строкой").ЭтоИстина();

	Впустить(Владелец, Имя);
	Владельцу = Получить(Имя, "quota").ТелоТекст;
	Ожидаем.Что(Тег(Владельцу, "input", "name=""квота_мб"""), "владельцу поля нет").Равно("");
	Ожидаем.Что(Владельцу, "и формы раздела нет").Не_().Содержит("action=""/pools/" + Имя + "/settings/quota""");
	Ожидаем.Что(Владельцу, "квота свойством").Содержит("<dt>" + Экранировать("settings.pool.quota.property"));
	Ожидаем.Что(Владельцу, "кто её назначает — сказано").Содержит(Экранировать("settings.pool.quota.readonly"));

КонецПроцедуры

// Форма квоты, пришедшая от владельца пула, отбивается правом до записи.
&Тест
Процедура КвотаОтВладельцаНеЗаписывается() Экспорт

	Имя = ЗавестиПул("quox");
	Впустить(Владелец, Имя);

	Ответ = Отправить(Имя, "quota", "квота_мб=5");
	Ожидаем.Что(Ответ.Код, "право уровня хаба — 403").Равно(403);
	Ожидаем.Что(Пул(Имя).КвотаМб, "квота прежняя").Равно(Желудь("СервисПулов").КвотаКакВХабе());

	// КОНТРОЛЬ: администратор хаба той же формой квоту меняет
	Впустить(Админ, Имя);
	Ожидаем.Что(Отправить(Имя, "quota", "квота_мб=5").Код, "КОНТРОЛЬ: администратор — перенаправление")
		.Равно(303);
	Ожидаем.Что(Пул(Имя).КвотаМб, "КОНТРОЛЬ: квота записана").Равно(5);

КонецПроцедуры

#КонецОбласти

#Область ОпаснаяЗона

// Кнопка «Удалить пул» — окно по адресу; подтверждение печатается открытым только адресом,
// эхо ждёт имя пула.
&Тест
Процедура УдалениеПулаПодтверждениемПоАдресу() Экспорт

	Имя = ЗавестиПул("dng");
	Впустить(Админ, Имя);

	Страница = Получить(Имя, "danger").ТелоТекст;
	Ожидаем.Что(Страница, "кнопка ведёт на окно подтверждения").Содержит(АдресОкна(Имя));
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "без адреса окна нет").Равно(0);

	Открытые = ОткрытыеОкна(Получить(Имя, "danger", "удалить").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по адресу подтверждение открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "эхо ждёт имя пула").Содержит("pattern=""" + Имя + """");
	Ожидаем.Что(Открытые[0], "форма — на адрес раздела")
		.Содержит("action=""/pools/" + Имя + "/settings/danger""");

	Неизвестное = ОткрытыеОкна(Получить(Имя, "danger", "изменить").ТелоТекст);
	Ожидаем.Что(Неизвестное.Количество(), "неизвестное окно — страница без окна").Равно(0);

КонецПроцедуры

&Тест
Процедура ПулУдаляетсяТолькоПодтверждениемСВернымЭхом() Экспорт

	Имя = ЗавестиПул("dngd");
	Соседний = ЗавестиПул("dngn");
	Впустить(Админ, Имя);

	БезВопроса = Отправить(Имя, "danger", Операция() + "&подтверждение=" + Имя);
	Ожидаем.Что(БезВопроса.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(БезВопроса.ПутьРедиректа), "на окно подтверждения")
		.Равно("/pools/" + Имя + "/settings/danger?окно=удалить");
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();

	Неверно = Отправить(Имя, "danger", Операция() + "&confirmed=1&подтверждение=" + Соседний);
	Ожидаем.Что(Неверно.Код, "чужое имя в эхе — 400").Равно(400);
	Открытые = ОткрытыеОкна(Неверно.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""подтверждение"""), "эхо-поле помечено негодным")
		.Содержит("aria-invalid=""true""");
	Отказ = UI.Экран.Экранировать(UI.Тексты.Шаблон("settings.pool.danger.error.echo", Имя));
	Ожидаем.Что(Открытые[0], "отказ под эхо-полем").Содержит(Отказ);
	Ожидаем.Что(СтрЧислоВхождений(Неверно.ТелоТекст, Отказ), "и только там, не тостом").Равно(1);
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();
	Ожидаем.Что(Пул(Соседний), "и соседний цел").Существует();

	Верно = Отправить(Имя, "danger", Операция() + "&confirmed=1&подтверждение=" + Имя);
	Ожидаем.Что(Верно.Код, "верное эхо — перенаправление").Равно(303);
	Ожидаем.Что(Верно.ПутьРедиректа, "со страницы удалённого пула — в кабинет")
		.Равно(Желудь("ДомАккаунта").АдресКабинета());
	Ожидаем.Что(Пул(Имя), "пула нет").Равно(Неопределено);
	Ожидаем.Что(Пул(Соседний), "соседний цел").Существует();

КонецПроцедуры

// Кто пулы не удаляет, тот видит вместо кнопки причину; окна по адресу ему нет, форма — 403.
&Тест
Процедура БезПраваВместоКнопкиПричина() Экспорт

	Имя = ЗавестиПул("dngo");
	Впустить(Владелец, Имя);

	Страница = Получить(Имя, "danger").ТелоТекст;
	Ожидаем.Что(Страница, "причина строкой").Содержит(Экранировать("settings.pool.danger.readonly"));
	Ожидаем.Что(Страница, "кнопки удаления нет").Не_().Содержит(АдресОкна(Имя));
	Ожидаем.Что(ОткрытыеОкна(Получить(Имя, "danger", "удалить").ТелоТекст).Количество(),
		"окна по адресу нет").Равно(0);

	Ответ = Отправить(Имя, "danger", Операция() + "&confirmed=1&подтверждение=" + Имя);
	Ожидаем.Что(Ответ.Код, "право уровня хаба — 403").Равно(403);
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();

КонецПроцедуры

// Форма старой вкладки без объявленной операции пул не удаляет даже с верным эхом.
&Тест
Процедура ФормаБезОперацииПулНеУдаляет() Экспорт

	Имя = ЗавестиПул("dngs");
	Впустить(Админ, Имя);

	Ответ = Отправить(Имя, "danger", "операция=пул-передать&confirmed=1&подтверждение=" + Имя);
	Ожидаем.Что(Ответ.Код, "неизвестная операция — 400").Равно(400);
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();

	// КОНТРОЛЬ: объявленная операция той же формой пул удаляет
	Отправить(Имя, "danger", Операция() + "&confirmed=1&подтверждение=" + Имя);
	Ожидаем.Что(Пул(Имя), "КОНТРОЛЬ: пула нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Гвард

// Каждую дверь разделов стережёт гвард дома: кого он не впустил, тому 403 без тела, а пул
// прежний — видимость, квота, сам пул, и в журнал событий ничего не ушло.
&Тест
Процедура ДвериНеТрогаютПулТогоКогоГвардНеВпустил() Экспорт

	Имя = ЗавестиПул("grd");
	Впустить(Админ, Имя);
	Издатель = Желудь("ИздательСобытий");
	Журнал = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПулУдалён(), Журнал);
	Гвард.НеВпускать();

	Двери = Новый Структура("visibility, quota, danger", "видимость=private", "квота_мб=7",
		Операция() + "&confirmed=1&подтверждение=" + Имя);
	Для Каждого Дверь Из Двери Цикл
		Ответ = Отправить(Имя, Дверь.Ключ, Дверь.Значение);
		Ожидаем.Что(Ответ.Код, "гвард не впустил: «" + Дверь.Ключ + "» — 403").Равно(403);
		Ожидаем.Что(Строка(Ответ.ТелоТекст), "гвард не впустил: «" + Дверь.Ключ + "» — без тела").Равно("");
	КонецЦикла;

	Ожидаем.Что(НРег(Строка(Пул(Имя).Видимость)), "видимость прежняя").Равно("public");
	Ожидаем.Что(Пул(Имя).КвотаМб, "квота прежняя").Равно(Желудь("СервисПулов").КвотаКакВХабе());
	Ожидаем.Что(Пул(Имя), "пул цел").Существует();
	Ожидаем.Что(Журнал.События.Количество(), "событий в журнал не ушло").Равно(0);

	// КОНТРОЛЬ: впущенный той же формой видимость меняет
	Впустить(Админ, Имя);
	Отправить(Имя, "visibility", "видимость=private");
	Ожидаем.Что(НРег(Строка(Пул(Имя).Видимость)), "КОНТРОЛЬ: впущенный меняет").Равно("private");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Пул(Знач Имя)
	Возврат Желудь("СервисПулов").НайтиПул(Имя);
КонецФункции

// Пул заводится службой доступа от имени администратора; имя — с уникальным хвостом.
Функция ЗавестиПул(Знач Приставка)
	Имя = Приставка + УникальныеИмена.Хвост();
	Желудь("СлужбаДоступа").СоздатьПул(Админ, Имя, "custom", "public");
	Возврат Имя;
КонецФункции

Процедура Впустить(Знач Учётка, Знач ИмяПула)
	Гвард.ВпуститьУчётку(Учётка, Пул(ИмяПула));
КонецПроцедуры

Функция Операция()
	Возврат Желудь("ПультУдаленияПула").ИмяПоляОперации() + "=" + Желудь("ПультУдаленияПула").ЗначениеОперации();
КонецФункции

Функция Получить(Знач ИмяПула, Знач Раздел, Знач Окно = "")
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, ИмяПула, Раздел, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

Функция Отправить(Знач ИмяПула, Знач Раздел, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, ИмяПула, Раздел, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

Функция АдресОкна(Знач ИмяПула)
	Возврат "href=""/pools/" + ИмяПула + "/settings/danger?" + Закодировать("окно") + "=" + Закодировать("удалить") + """";
КонецФункции

Функция Экранировать(Знач Ключ)
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст(Ключ));
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Куски разметки, каждый — от начала образца до следующего такого же.
Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
