// Раздел «Апстримы» дома «Пул» на механизме «⚙ записи + окно по адресу + подтверждение»:
// окно нового источника по ?окно=…, отказ пробы у поля адреса, стрелки порядка, тумблер, снятие
// токена, удаление через подтверждение, тумблер публикации — настоящим контроллером поверх
// настоящей службы источников; хранилище источников — в памяти, транспорт пробы — фейк.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Ответы;      // ОтветыНастроек
Перем Дом;         // ДомПула
Перем Пул;         // ПулЗаглушка
Перем Пулы;        // ФейкСервисПулов — тумблер публикации
Перем Настройки;   // НастройкиЗаглушка — выключатель пробы
Перем Транспорт;   // ФейкТранспортИсточника — что отвечает адрес на пробе
Перем Сервис;      // СервисАпстримовПула над хранилищем в памяти
Перем Контроллер;  // КонтроллерАпстримовПула

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Для Каждого Фикстура Из СтрРазделить("ПулЗаглушка,ГвардПулаЗаглушка,ОтветСтраницыЗаглушка,ФейкСервисПрав,"
		+ "ЗащитаCSRFЗаглушка,НастройкиЗаглушка,ФейкТранспортИсточника,ФейкХранилищеАпстримов,"
		+ "ФейкАпстримЗапись,ФейкСервисПулов", ",") Цикл
		РеестрФикстур.Подключить(Фикстура);
	КонецЦикла;

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	Для Каждого Имя Из СтрРазделить("АдресаСтраниц,МаскаИмениПакета,АллоулистИмён,ВалидаторАдресаАпстрима,"
		+ "ПорядокАпстримов,СервисАпстримовПула", ",") Цикл
		Поиск.Подключить(КаталогРеестра, Имя);
	КонецЦикла;
	КаталогПрокси = ОбъединитьПути(КаталогМодулей, "прокси", "Классы");
	Для Каждого Имя Из СтрРазделить("СекретИсточника,ЗаведениеИсточникаСПробой,КлиентАпстрима,"
		+ "ПробникИсточника,ПричинаМолчания", ",") Цикл
		Поиск.Подключить(КаталогПрокси, Имя);
	КонецЦикла;
	КаталогWeb = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("АдресаКаталога,ДомПула,ОтветыНастроек,СборкаДомаНастроек,ОкноРаздела,"
		+ "ВитринаАпстримов,ПультАпстримовПула,КонтроллерАпстримовПула,ЗаписьФормы,РазборФормы,ГейтФормы,"
		+ "ОтметкаСохранения,ТекстСбоя", ",") Цикл
		Поиск.Подключить(КаталогWeb, Имя);
	КонецЦикла;

	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Новый ФейкСервисПрав(), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Дом = Новый ДомПула(Новый СборкаДомаНастроек(UI.Кит, UI.Модели), UI.Тексты, Новый АдресаСтраниц(),
		Новый АдресаКаталога());
	Пул = Новый ПулЗаглушка(7, "owned", "custom");

КонецПроцедуры

&ПередКаждым
Процедура СобратьЭкран() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси();
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://dead.example/download/list.txt", "Connection refused");
	Транспорт.ПриАдресе("http://alive.example/download/list.txt", 200, "alpha");
	Транспорт.ПриАдресе("http://second.example/download/list.txt", 200, "beta");
	Лог = Логирование.ПолучитьЛог("тест.oshub.экран-апстримов");
	Пробник = Новый ПробникИсточника(Новый КлиентАпстрима(Транспорт, Настройки, Лог), Настройки, Лог);

	Сервис = Новый СервисАпстримовПула(Новый ФейкХранилищеАпстримов(), Новый АллоулистИмён(),
		Новый ВалидаторАдресаАпстрима(), Новый ЗаведениеИсточникаСПробой(Неопределено, Желуди(Пробник)));
	Пулы = Новый ФейкСервисПулов();
	Пулы.ПоложитьПул(Пул);
	Пул.ПубликацияРазрешена = Истина;
	Контроллер = СобратьКонтроллер(Желуди(Пробник));

КонецПроцедуры

// Контроллер раздела над службой набора; пробники — массив-пластилин: пусто — модуля прокси нет;
// гвард без «впустить» отказывает постороннему, но несёт пул: забытая проверка дала бы мутацию.
Функция СобратьКонтроллер(Знач Пробники, Знач Впустить = Истина)

	Защита = Новый ЗащитаCSRFЗаглушка();
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), UI.Подтверждение);
	Пульт = Новый ПультАпстримовПула(Новый ГейтФормы(Ответы, Защита, Новый РазборФормы()),
		Новый РазборФормы(), Пулы, Сервис, Новый ПриведениеЧисел(), Новый РазборАдреса(),
		Новый ТекстСбоя(Новый ТекстОшибки(), UI.Тексты), UI.Тексты);
	Витрина = Новый ВитринаАпстримов(UI.Кит, Сервис, Окна, Пульт, UI.Тексты, Новый Массив(), Пробники);

	Гвард = Новый ГвардПулаЗаглушка();
	Если Впустить Тогда
		Гвард.Впустить("owner1", Пул);
	Иначе
		Гвард.Отказать("stranger", Пул);
	КонецЕсли;
	Возврат Новый КонтроллерАпстримовПула(Гвард, Ответы, Дом, Витрина, Пульт, Защита, Окна);

КонецФункции

#Область ОкноПоАдресу

&Тест
Процедура ОкноНовогоАпстримаПоАдресуОткрыто() Экспорт

	Открытые = ОткрытыеОкна(Получить("новый").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по ?окно=новый открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно заведения").Содержит(Текст("settings.pool.upstreams.window.new"));

	// КОНТРОЛЬ: без адреса окно заведения на странице есть, но закрыто
	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Страница, "окно заведения на странице").Содержит("id=""apstrim-novyi""");
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "и закрыто").Равно(0);

КонецПроцедуры

// Вкладка называет раздел, дом и пул — одной дверью дома: две вкладки разных разделов и пулов различимы.
&Тест
Процедура ВкладкаНазываетРазделДомИПул() Экспорт

	Титул = Между(Получить("").ТелоТекст, "<title>", "</title>");
	Ожидаем.Что(СтрНачинаетсяС(Титул, Текст("settings.pool.nav.upstreams") + " · " + Текст("settings.pool.title") + " · owned — "),
		"вкладка: " + Титул).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Титул, Текст("settings.pool.title")), "заголовок дома ровно один").Равно(1);

КонецПроцедуры

&Тест
Процедура НеизвестноеОкноДаётСтраницуБезОкна() Экспорт

	Номер = Завести("http://alive.example/download/");

	// у анонимного источника снимать нечего — окна токена нет
	Для Каждого Окно Из СтрРазделить("удалить-999,зачем-" + Номер + ",токен-" + Номер + ",удалить", ",") Цикл
		Страница = Получить(Окно);
		Ожидаем.Что(Страница.Код, "?окно=" + Окно + " — страница раздела").Равно(200);
		Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;

КонецПроцедуры

// Порядок обхода значим: список нумерованный, стрелка за край у крайних недоступна.
&Тест
Процедура РеестрНумерованныйИСтрелкиКрайнихЗаблокированы() Экспорт

	Первый = Завести("http://alive.example/download/");
	Второй = Завести("http://second.example/download/");

	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Страница, "реестр источников — нумерованный список").Содержит("<ol");
	Ожидаем.Что(Тег(ЗаписьРеестра(Страница, "alive.example"), "button", "value=""вверх"""),
		"у первого «Выше» недоступна").Содержит("disabled");
	Ожидаем.Что(Тег(ЗаписьРеестра(Страница, "second.example"), "button", "value=""вниз"""),
		"у последнего «Ниже» недоступна").Содержит("disabled");
	Ожидаем.Что(Тег(ЗаписьРеестра(Страница, "alive.example"), "button", "value=""вниз"""),
		"КОНТРОЛЬ: у первого «Ниже» доступна").Не_().Содержит("disabled");

	Ответ = Отправить(Первый + "/move", "сдвиг=вниз");
	Ожидаем.Что(Ответ.Код, "стрелка — 303 на раздел").Равно(303);
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор)[0].Url, "первым опрашивается второй")
		.Равно("http://second.example/download/");
	Ожидаем.Что(Второй, "КОНТРОЛЬ: номера источников разные").Не_().Равно(Первый);

КонецПроцедуры

#КонецОбласти

#Область Заведение

// Не подключился — источник не заводится, и причина стоит у поля адреса, к набранному.
&Тест
Процедура ОтказПробыЛожитсяПодПолеАдресаВОткрытомОкне() Экспорт

	Ответ = Отправить("", "url=http://dead.example/download/&ttl=600&токен=sekret-x");

	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Больше(399);
	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Меньше(500);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно «Новый апстрим» открыто").Равно(1);
	ПолеАдреса = Тег(Открытые[0], "input", "name=""url""");
	Ожидаем.Что(ПолеАдреса, "поле адреса помечено негодным").Содержит("aria-invalid=""true""");
	Ожидаем.Что(ПолеАдреса, "набранный адрес на месте").Содержит("value=""http://dead.example/download/""");
	Ожидаем.Что(Открытые[0], "причина названа").Содержит("не удалось подключиться");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""ttl"""), "набранный TTL на месте").Содержит("value=""600""");
	Ожидаем.Что(Ответ.ТелоТекст, "набранный токен обратно не печатается").Не_().Содержит("sekret-x");
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор).Количество(), "источник не заведён").Равно(0);

КонецПроцедуры

&Тест
Процедура НецелыйTTLОтбиваетсяУСвоегоПоля() Экспорт

	Ответ = Отправить("", "url=http://alive.example/download/&ttl=пять");

	Ожидаем.Что(Ответ.Код, "отказ — 400").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""ttl"""), "поле TTL помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор).Количество(), "источник не заведён").Равно(0);

КонецПроцедуры

&Тест
Процедура УдачноеЗаведениеВедётНаРазделИЗаводитИсточник() Экспорт

	Ответ = Отправить("", "url=http://alive.example/download/&ttl=600&токен=");

	Ожидаем.Что(Ответ.Код, "удача — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой сохранения")
		.Равно("/pools/owned/settings/upstreams?saved=1");
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор).Количество(), "источник заведён").Равно(1);
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор)[0].ВремяЖизниСек, "с набранным TTL").Равно(600);

КонецПроцедуры

// Обещать пробу вправе только экран, на котором она делается: выключатель снимает её целиком.
&Тест
Процедура ОкноОбещаетПробуТолькоКогдаХабЕёДелает() Экспорт

	Настройки.Задать("oshub.upstream.probe.enabled", Истина);
	Окно = ОкноЗаведения(Получить("").ТелоТекст);
	Ожидаем.Что(Окно, "с включённой пробой окно обещает подключение")
		.Содержит(Экранировать("settings.pool.upstream-new.probe.note"));
	Ожидаем.Что(Окно, "и не говорит про выключенную").Не_().Содержит(Экранировать("settings.pool.upstream-new.probe.note.off"));

	Настройки.Задать("oshub.upstream.probe.enabled", Ложь);
	Окно = ОкноЗаведения(Получить("").ТелоТекст);
	Ожидаем.Что(Окно, "выключенная проба названа в окне")
		.Содержит(Экранировать("settings.pool.upstream-new.probe.note.off"));

	// без модуля прокси пробника нет, и проба пропускается так же молча, как выключателем
	Настройки.Задать("oshub.upstream.probe.enabled", Истина);
	Контроллер = СобратьКонтроллер(Новый Массив());
	Окно = ОкноЗаведения(Получить("").ТелоТекст);
	Ожидаем.Что(Окно, "без пробника окно говорит, что адрес не проверяется")
		.Содержит(Экранировать("settings.pool.upstream-new.probe.note.off"));

КонецПроцедуры

#КонецОбласти

#Область ТумблерТокенУдаление

&Тест
Процедура ТумблерМеняетСостояниеИсточникаВДомене() Экспорт

	Номер = Завести("http://alive.example/download/");

	Выключить = Отправить(Номер + "/toggle", "включить=0");
	Ожидаем.Что(Выключить.Код, "тумблер — 303 на раздел").Равно(303);
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор)[0].Включён, "источник выключен").ЭтоЛожь();

	// включённый тумблер шлёт пару «1» и «0»: решает первое
	Отправить(Номер + "/toggle", "включить=1&включить=0");
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор)[0].Включён, "источник включён").ЭтоИстина();

КонецПроцедуры

// Токен — секрет: значения в разметке нет, есть только факт «по токену» и окно его снятия.
&Тест
Процедура ТокенВидёнФактомИСнимаетсяОкном() Экспорт

	Транспорт.ПриАдресе("http://private.example/download/list.txt", 200, "alpha");
	Номер = Завести("http://private.example/download/", "sekret-42");

	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Страница, "значения токена в разметке нет").Не_().Содержит("sekret-42");
	Запись = ЗаписьРеестра(Страница, "private.example");
	Ожидаем.Что(Запись, "запись говорит, что источник читается по токену")
		.Содержит(Экранировать("settings.pool.upstreams.access.token"));
	Ожидаем.Что(Запись, "в наборе действий — окно снятия токена по адресу")
		.Содержит(АдресОкна("токен-" + Номер));

	Открытые = ОткрытыеОкна(Получить("токен-" + Номер).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно «Снять токен» открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "его форма уходит на снятие токена этого источника")
		.Содержит("action=""/pools/owned/settings/upstreams/" + Номер + "/token-off""");

	Ответ = Отправить(Номер + "/token-off", "");
	Ожидаем.Что(Ответ.Код, "снятие — 303").Равно(303);
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор)[0].ТокенДоступа, "токен снят").Равно("");
	Ожидаем.Что(ЗаписьРеестра(Получить("").ТелоТекст, "private.example"), "и пункта снятия больше нет")
		.Не_().Содержит(АдресОкна("токен-" + Номер));

КонецПроцедуры

&Тест
Процедура УдалениеБезПодтвержденияВедётНаОкноИИсточникЦел() Экспорт

	Номер = Завести("http://alive.example/download/");

	Ответ = Отправить(Номер + "/delete", "");
	Ожидаем.Что(Ответ.Код, "первая отправка — 303").Равно(303);
	Ожидаем.Что(РаскодироватьСтроку(Ответ.ПутьРедиректа, СпособКодированияСтроки.КодировкаURL),
		"на страницу с открытым подтверждением")
		.Равно("/pools/owned/settings/upstreams?окно=удалить-" + Номер);
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор).Количество(), "источник цел").Равно(1);

	Открытые = ОткрытыеОкна(Получить("удалить-" + Номер).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "подтверждение — опасное окно").Содержит("modal--confirm");
	Ожидаем.Что(Открытые[0], "и называет источник").Содержит("alive.example");

	Верно = Отправить(Номер + "/delete", "confirmed=1");
	Ожидаем.Что(Верно.Код, "подтверждённое — 303").Равно(303);
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор).Количество(), "источника нет").Равно(0);

КонецПроцедуры

// Окна для отказа нет — источника уже нет: причина всё равно на странице, а не пустой ответ.
&Тест
Процедура ОтказБезОкнаНазванНаСтранице() Экспорт

	Удаление = Отправить("999/delete", "confirmed=1");
	Ожидаем.Что(Удаление.Код, "удаление несуществующего — 404").Равно(404);
	Ожидаем.Что(ОткрытыеОкна(Удаление.ТелоТекст).Количество(), "окна подтверждения нет").Равно(0);
	Ожидаем.Что(Удаление.ТелоТекст, "причина названа тостом раздела").Содержит("toast--err");

	Сдвиг = Отправить("999/move", "сдвиг=вверх");
	Ожидаем.Что(Сдвиг.Код, "стрелка несуществующего — 404").Равно(404);

КонецПроцедуры

&Тест
Процедура ТумблерПубликацииМеняетПул() Экспорт

	Ответ = Отправить("publication", "публикация=0");
	Ожидаем.Что(Ответ.Код, "тумблер публикации — 303").Равно(303);
	Ожидаем.Что(Пул.ПубликацияРазрешена, "публикация запрещена").ЭтоЛожь();

	Отправить("publication", "публикация=1&публикация=0");
	Ожидаем.Что(Пул.ПубликацияРазрешена, "публикация разрешена").ЭтоИстина();

	// форма без поля тумблера публикацию не гасит: это отказ, а не «выключить»
	Ожидаем.Что(Отправить("publication", "").Код, "без поля тумблера — 400").Равно(400);
	Ожидаем.Что(Пул.ПубликацияРазрешена, "публикация не тронута").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПравоИУстаревшиеФормы

// Право мейнтейнера пула держит гвард каждого адреса: посторонний ничего не меняет ни одной формой.
&Тест
Процедура ПостороннийНиОднойФормойИсточникиНеМеняет() Экспорт

	Номер = Завести("http://alive.example/download/");
	Контроллер = СобратьКонтроллер(Новый Массив(), Ложь);

	Отправить("", "url=http://second.example/download/&ttl=600");
	Отправить("publication", "публикация=0");
	Отправить(Номер + "/move", "сдвиг=вниз");
	Отправить(Номер + "/toggle", "включить=0");
	Отправить(Номер + "/token-off", "");
	Отправить(Номер + "/delete", "confirmed=1");

	Источники = Сервис.Все(Пул.Идентификатор);
	Ожидаем.Что(Источники.Количество(), "нового источника нет, прежний не удалён").Равно(1);
	Ожидаем.Что(Источники[0].Включён, "источник не выключен").ЭтоИстина();
	Ожидаем.Что(Пул.ПубликацияРазрешена, "публикация не тронута").ЭтоИстина();

	// КОНТРОЛЬ: впущенный той же формой источник удаляет
	Контроллер = СобратьКонтроллер(Новый Массив());
	Отправить(Номер + "/delete", "confirmed=1");
	Ожидаем.Что(Сервис.Все(Пул.Идентификатор).Количество(), "КОНТРОЛЬ: впущенный удаляет").Равно(0);

КонецПроцедуры

// Вкладка, открытая до перевода раздела на окна, шлёт на адрес раздела поле «операция» с адресом
// источника: это отказ без мутации, а не заведение, переписывающее TTL и набор разрешённых имён.
&Тест
Процедура ФормаУстаревшейВкладкиОтбиваетсяИИсточникЦел() Экспорт

	Апстрим = Сервис.Записать(Пул, "http://alive.example/download/", 600, "[""corp-*""]");

	Ответ = Отправить("", "операция=удалить&url=http://alive.example/download/");

	Ожидаем.Что(Ответ.Код, "устаревшая форма — 400").Равно(400);
	Ожидаем.Что(Ответ.ТелоТекст, "причина названа").Содержит(Экранировать("settings.pool.error.upstream.stale"));
	Источники = Сервис.Все(Пул.Идентификатор);
	Ожидаем.Что(Источники.Количество(), "источник на месте").Равно(1);
	Ожидаем.Что(Источники[0].ВремяЖизниСек, "TTL прежний").Равно(600);
	Ожидаем.Что(Источники[0].СписокРазрешенийJSON, "набор имён прежний").Равно("[""corp-*""]");
	Ожидаем.Что(Апстрим.Идентификатор, "КОНТРОЛЬ: источник заведён").Больше(0);

КонецПроцедуры

// Повтор того же адреса (иным регистром) правит заведённый источник: TTL новый, а набор
// разрешённых имён и токен, которых окно не задаёт, — прежние.
&Тест
Процедура ПовторТогоЖеАдресаОбновляетTTLАНаборИменИТокенПрежние() Экспорт

	Сервис.Записать(Пул, "http://alive.example/download/", 600, "[""corp-*""]", "sekret-42");
	// проба идёт по набранному адресу, а фейк транспорта сличает его буквально
	Транспорт.ПриАдресе("HTTP://ALIVE.example/download/list.txt", 200, "alpha");

	Ответ = Отправить("", "url=HTTP://ALIVE.example/download/&ttl=1200&токен=");

	Ожидаем.Что(Ответ.Код, "повтор принят — 303").Равно(303);
	Источники = Сервис.Все(Пул.Идентификатор);
	Ожидаем.Что(Источники.Количество(), "второго источника нет").Равно(1);
	Ожидаем.Что(Источники[0].ВремяЖизниСек, "TTL новый").Равно(1200);
	Ожидаем.Что(Источники[0].СписокРазрешенийJSON, "набор имён прежний").Равно("[""corp-*""]");
	Ожидаем.Что(Источники[0].ТокенДоступа, "пустое поле оставило прежний токен").Равно("sekret-42");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Источник прямо через службу; номер — строкой, как он стоит в адресе.
Функция Завести(Знач Url, Знач Токен = "")
	Апстрим = Сервис.Записать(Пул, Url, 900, "", Токен);
	Возврат Формат(Апстрим.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция Получить(Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, "owned", Новый Соответствие(), Неопределено, "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

// POST формы раздела: "" — заведение, «publication» — тумблер публикации, «<номер>/<действие>» —
// форма источника.
Функция Отправить(Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Заголовки = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Контроллер.Раздел(Ответ, "owned", Заголовки, Неопределено, "POST", ТелоФормы);
		Возврат Ответ;
	ИначеЕсли Хвост = "publication" Тогда
		Контроллер.Публикация(Ответ, "owned", Заголовки, Неопределено, "POST", ТелоФормы);
		Возврат Ответ;
	КонецЕсли;

	Части = СтрРазделить(Хвост, "/");
	Номер = Части[0];
	Действие = Части[1];
	Если Действие = "move" Тогда
		Контроллер.Сдвиг(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	ИначеЕсли Действие = "toggle" Тогда
		Контроллер.Переключение(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	ИначеЕсли Действие = "token-off" Тогда
		Контроллер.СнятиеТокена(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	Иначе
		Контроллер.Удаление(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция АдресОкна(Знач Значение)
	Возврат "href=""/pools/owned/settings/upstreams?" + Закодировать("окно") + "=" + Закодировать(Значение) + """";
КонецФункции

Функция ОкноЗаведения(Знач HTML)
	Возврат Между(HTML, "id=""apstrim-novyi""", "</dialog>");
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пункт реестра источника: от <li class="entry"> с его адресом в сводке до следующего пункта.
Функция ЗаписьРеестра(Знач HTML, Знач ЧастьАдреса)

	Для Каждого Пункт Из Куски(HTML, "<li class=""entry""") Цикл
		Если СтрНайти(Лев(Пункт, СтрНайти(Пункт + "</summary>", "</summary>")), ЧастьАдреса) > 0 Тогда
			Возврат Пункт;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Текст(Знач Ключ)
	Возврат UI.Тексты.Текст(Ключ);
КонецФункции

// Текст из словаря, как его печатает страница: сторож стережёт, КАКОЙ текст, а не его редакцию.
Функция Экранировать(Знач Ключ)
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст(Ключ));
КонецФункции

// Массив-пластилин ОСени: пусто означает «желудя в контейнере нет».
Функция Желуди(Знач Желудь)
	Результат = Новый Массив();
	Если Желудь <> Неопределено Тогда
		Результат.Добавить(Желудь);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
