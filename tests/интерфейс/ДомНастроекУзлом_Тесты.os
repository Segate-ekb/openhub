// Дом настроек печатается узлом кита Кит.ДомНастроек через настоящую дверь дома
// (ОтветыНастроек.ОтдатьДом): разделы по рубрикам с текущим и опасным — колонкой и группой
// единого меню, крошки и тосты модели, секции витрин — узлами и прежними структурами;
// вкладка браузера — «Раздел · Дом · Объект» одной дверью; разделы пяти домов хаба — в рубриках
// и порядке макета.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;        // СборкаUI — граф компонентов и рендереров интерфейса
Перем Ответы;    // ОтветыНастроек — дверь дома
Перем Сборка;    // СборкаДомаНастроек — дом узлом из модели

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ПорогРазделаПакетаЗаглушка");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	КаталогИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("СборкаДомаНастроек,ОтветыНастроек,АдресаКаталога,АдресаКабинета,"
		+ "ДомХаба,ДомПула,ДомПакета,ДомАккаунта,ДомГруппы", ",") Цикл
		Поиск.Подключить(КаталогИнтерфейса, Имя);
	КонецЦикла;
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "ОписаниеПриложения");

	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Сборка, Новый ФейкСервисПрав(), UI.Тексты,
		Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));

КонецПроцедуры

#Область ДомУзлом

&Тест
Процедура СтраницаДомаПечатаетКаркасНастроекКитаСРазделамиИТекущим() Экспорт

	Модель = МодельХаба(Разделы("login"), СекцииВитрины());
	Страница = Отдать(Модель);

	Ожидаем.Что(Страница.Код, "дом отдан").Равно(200);
	Ожидаем.Что(СтрНайти(Страница.ТелоТекст, "<div class=""settings"" data-house=""hub"">") > 0,
		"дом — каркас настроек кита со своим ключом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.ТелоТекст, "Настройки хаба<span class=""settings__object"">openhub")
		> 0, "заголовок дома и имя объекта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.ТелоТекст, "settings__nav") > 0, "колонка разделов").ЭтоИстина();

	Для Каждого Ключ Из СтрРазделить("identity,login,people,danger", ",") Цикл
		Ссылка = СсылкаРаздела(Страница.ТелоТекст, "/hub/settings/" + Ключ);
		Ожидаем.Что(ЗначениеЗаполнено(Ссылка), "раздел «" + Ключ + "» в колонке").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Ссылка, "aria-current") > 0,
			"текущим помечен только открытый раздел: " + Ссылка).Равно(Ключ = "login");
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Страница.ТелоТекст, "<p class=""settings__current"">") > 0,
		"под заголовком — имя текущего раздела").ЭтоИстина();

	// в едином меню разделы дома — своей группой под именем дома: каркас взял их у дома сам
	Группа = ТегСАтрибутом(Страница.ТелоТекст, "nav", "hubmenu__section--screen");
	Ожидаем.Что(Группа, "группа разделов в меню названа домом")
		.Содержит("aria-label=""Настройки хаба""");

КонецПроцедуры

&Тест
Процедура РубрикиИОпасныйРазделСтоятВКолонкеИВГруппеМенюОдинаково() Экспорт

	Страница = Отдать(МодельХаба(Разделы("login"), СекцииВитрины())).ТелоТекст;

	// опасный объявлен вторым, а стоит последним, без рубрики и цветом ошибки — в обоих местах
	Ожидаем.Что(СоставКолонки(Страница), "колонка: рубрики над своими разделами, опасный — последним")
		.Равно("[Основа] identity [Люди] login people danger!");
	Ожидаем.Что(СоставГруппыМеню(Страница), "группа меню — та же, что колонка")
		.Равно("[Основа] identity [Люди] login people danger!");

КонецПроцедуры

&Тест
Процедура КрошкиИТостМоделиПечатаютсяНадДомом() Экспорт

	Модель = МодельХаба(Разделы("login"), СекцииВитрины());
	Модель.Хлебные.Добавить(Новый Структура("Подпись, Адрес", "Пулы", "/pools"));
	Модель.Хлебные.Добавить(Новый Структура("Подпись, Адрес", "corp", "/pools/corp"));
	Модель.Хлебные.Добавить(Новый Структура("Подпись, Адрес", "настройки", ""));
	Модель.Уведомления.Добавить(Ответы.Уведомление("Изменения сохранены"));
	Страница = Отдать(Модель).ТелоТекст;

	Крошки = ТегСАтрибутом(Страница, "nav", "crumbs");
	Ожидаем.Что(ЗначениеЗаполнено(Крошки), "крошки напечатаны").ЭтоИстина();
	Хвост = Сред(Страница, СтрНайти(Страница, Крошки));
	Хвост = Лев(Хвост, СтрНайти(Хвост, "</nav>"));
	Ожидаем.Что(Хвост, "первая крошка ведёт к пулам").Содержит("href=""/pools""");
	Ожидаем.Что(Хвост, "вторая — к пулу").Содержит("href=""/pools/corp""");
	Ожидаем.Что(Хвост, "последняя — текстом").Содержит("настройки");
	Ожидаем.Что(СтрНайти(Страница, Крошки) < СтрНайти(Страница, "settings__title"), "крошки — над заголовком")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Изменения сохранены") > 0, "тост модели напечатан").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СекцииДома

&Тест
Процедура ТокенМоделиДоходитДоФормыВДомеИзОднихУзлов() Экспорт

	Модель = МодельХаба(Разделы("identity"), СекцияУзлом());
	Модель.Токен = "т0кен-модели";
	Страница = Отдать(Модель).ТелоТекст;

	ТелоФормы = ТелоФормы(Страница, "/hub/settings/identity/revoke");
	Ожидаем.Что(ЗначениеЗаполнено(ТелоФормы), "форма узла напечатана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоФормы, "value=""т0кен-модели""") > 0,
		"у формы узла — токен из модели дома: " + ТелоФормы).ЭтоИстина();

КонецПроцедуры

// Форма узла без токена модели не печатается молча рабочей.
&Тест
Процедура ФормаБезТокенаДомаОстанавливаетСборкуСПричиной() Экспорт

	Секции = СекцияУзлом();

	Ошибка = "";
	Попытка
		Сборка.Дом(МодельХаба(Разделы("identity"), Секции), "/hub/settings/identity").Рендер();
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "отказ называет недостающий токен").Содержит("CSRF-токен");

КонецПроцедуры

&Тест
Процедура ДомБезРазделовИСекцийОтдаётсяПустымКаркасом() Экспорт

	Модель = Новый Структура("Ключ, Заголовок", "notifications", "Уведомления");
	Страница = Отдать(Модель);

	Ожидаем.Что(Страница.Код, "дом без разделов и секций отдан").Равно(200);
	Ожидаем.Что(СтрНайти(Страница.ТелоТекст, "data-house=""notifications""") > 0,
		"каркас дома на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.ТелоТекст, "settings__nav"), "колонки разделов нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница.ТелоТекст, UI.Тексты.Текст("settings.frame.empty")) > 0,
		"пустой раздел сказан словами").ЭтоИстина();

КонецПроцедуры

// Секция-структура прежнего каркаса больше не печатается: она останавливает сборку с причиной,
// а не пропадает с экрана молча.
&Тест
Процедура СтруктураНаМестеСекцииОстанавливаетСборку() Экспорт

	Секции = Новый Массив();
	Секции.Добавить(Новый Структура("Заголовок, Пояснение, Тело", "Особая", "", "<p>тело</p>"));

	Ошибка = "";
	Попытка
		Сборка.Дом(МодельХаба(Разделы("identity"), Секции), "").Рендер();
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "структура вместо секции названа").Содержит("Кит.Секция");

КонецПроцедуры

&Тест
Процедура ЧужоеНаМестеСекцииОстанавливаетСборку() Экспорт

	Секции = Новый Массив();
	Секции.Добавить("<section>строкой</section>");

	Ошибка = "";
	Попытка
		Сборка.Дом(МодельХаба(Разделы("identity"), Секции), "").Рендер();
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "строка вместо секции названа").Содержит("Кит.Секция");

КонецПроцедуры

#КонецОбласти

#Область ПринципалДвери

// Дверь дома ждёт принципала (вердикт гварда: Пользователь и Сессия). Пользователь вместо него —
// ошибка сборки двери: страница не уходит молча гостю (без учётки, меню и «Выйти»), а падает с
// причиной.
&Тест
Процедура ПользовательВместоПринципалаОтказываетСразу() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Отказ = "";
	Попытка
		Ответы.ОтдатьДом(Ответ, МодельХаба(Разделы("login"), Новый Массив()), Вошедший(), Неопределено);
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "пользователь вместо принципала — отказ с причиной").Содержит("передайте вердикт целиком");

	// КОНТРОЛЬ: принципал той же учёткой дверь принимает, гость — тоже
	Ожидаем.Что(Отдать(МодельХаба(Разделы("login"), Новый Массив())).ТелоТекст, "принципал принят")
		.Содержит("смотрящий");
	Ответ = Новый ОтветСтраницыЗаглушка();
	Ответы.ОтдатьДом(Ответ, МодельХаба(Разделы("login"), Новый Массив()), Неопределено, Неопределено);
	Ожидаем.Что(Ответ.ТелоТекст, "гостю страница отдана").Заполнено();

КонецПроцедуры

#КонецОбласти

#Область ВкладкаДома

// Две вкладки браузера с разными разделами и объектами различимы по имени: его даёт
// одна дверь — ОтдатьДом по текущему разделу модели, а не каждый контроллер по-своему.
&Тест
Процедура ВкладкаНазываетТекущийРазделИДомСОбъектом() Экспорт

	Ожидаем.Что(Вкладка(Отдать(МодельХаба(Разделы("login"), Новый Массив()))), "раздел, дом и объект")
		.Равно("LOGIN · Настройки хаба · openhub");
	Ожидаем.Что(Вкладка(Отдать(МодельХаба(Разделы("people"), Новый Массив()))), "другой раздел — другое имя")
		.Равно("PEOPLE · Настройки хаба · openhub");

	БезОбъекта = МодельХаба(Разделы("login"), Новый Массив());
	БезОбъекта.Объект = "";
	Ожидаем.Что(Вкладка(Отдать(БезОбъекта)), "дом без объекта — без пустого звена").Равно("LOGIN · Настройки хаба");

КонецПроцедуры

&Тест
Процедура ДомБезТекущегоРазделаНазываетВкладкуСобой() Экспорт

	Ожидаем.Что(Вкладка(Отдать(Новый Структура("Ключ, Заголовок", "notifications", "Уведомления"))),
		"страница без разделов — имя дома").Равно("Уведомления");
	Ожидаем.Что(Вкладка(Отдать(МодельХаба(Разделы("нет-такого"), Новый Массив()))),
		"раздела нет в перечне — имя дома с объектом").Равно("Настройки хаба · openhub");

КонецПроцедуры

&Тест
Процедура ВкладкиДомовХабаПулаИАккаунтаСобраныОднимПравилом() Экспорт

	// объект дома «Хаб» — инсталляция: его называет сам дом, у всех разделов один, что бы ни передал контроллер
	Хаб = Новый ДомХаба(Сборка, UI.Тексты, Новый ОписаниеПриложения());
	Ожидаем.Что(Вкладка(Отдать(Ответы.МодельДома(Хаб, "", Хаб.Разделы("providers"), Новый Массив(),
		Новый Массив()))), "раздел хаба").Равно("Провайдеры входа · Настройки хаба · openhub");
	Ожидаем.Что(Вкладка(Отдать(Ответы.МодельДома(Хаб, "чужое", Хаб.Разделы("audit"), Новый Массив(),
		Новый Массив()))), "объект дома главнее переданного").Равно("Аудит · Настройки хаба · openhub");

	Пул = ДомПула();
	Ожидаем.Что(Вкладка(Отдать(Ответы.МодельДома(Пул, "corp", Пул.Разделы("corp", "mirrors"), Новый Массив(),
		Новый Массив()))), "раздел пула с именем пула").Равно("Зеркала · Настройки пула · corp");

	// у аккаунта логин — в заголовке дома («Аккаунт · root»), объекта у дома нет: так собирают его контроллеры
	Аккаунт = Новый ДомАккаунта(Сборка, UI.Тексты, Новый АдресаКабинета(Новый АдресаСтраниц()));
	Модель = Ответы.МодельДома(Аккаунт, "", Аккаунт.Разделы("tokens"), Новый Массив(), Новый Массив());
	Модель.Заголовок = Аккаунт.ЗаголовокУчётки("root");
	ВкладкаАккаунта = Вкладка(Отдать(Модель));
	Ожидаем.Что(ВкладкаАккаунта, "раздел аккаунта").Равно("Токены доступа · Аккаунт · root");
	Ожидаем.Что(СтрЧислоВхождений(ВкладкаАккаунта, "root"), "логин во вкладке ровно один").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область РазделыДомовХаба

&Тест
Процедура ДомХабаДелитРазделыНаПятьРубрикПослеРазделовОбъекта() Экспорт

	Дом = Новый ДомХаба(Сборка, UI.Тексты);
	Ожидаем.Что(СоставКолонки(Печать(Дом, Дом.Разделы("identity"))), "рубрики и порядок дома хаба").Равно(
		"identity branding [Вход] login providers password [Люди и пулы] users groups pools"
		+ " [Пакеты] storage trusted proxy mirrors legacy [Оповещения] mail webhooks [Служба] audit maintenance");

КонецПроцедуры

&Тест
Процедура ДомПулаДелитРазделыНаРубрикиИОпаснуюЗонуСтавитПоследней() Экспорт

	Дом = ДомПула();
	Ожидаем.Что(СоставКолонки(Печать(Дом, Дом.Разделы("corp", "general"))), "рубрики и порядок дома пула").Равно(
		"general visibility access quota [Пакеты] inbox tags [Источники] upstreams mirrors"
		+ " [Оповещения] webhooks danger!");

КонецПроцедуры

&Тест
Процедура ДомПакетаИдётБезРубрикВПорядкеМакета() Экспорт

	Дом = Новый ДомПакета(Сборка, ДомПула(), Неопределено, Неопределено, UI.Тексты, Новый АдресаСтраниц());
	Ожидаем.Что(СоставКолонки(Печать(Дом, Дом.Разделы("corp", "cron", "card"))), "порядок дома пакета").Равно(
		"card tags versions access ci webhooks danger!");

КонецПроцедуры

// Разделы с порогом выше домового не печатаются тому, кому ответят отказом; остальные
// стоят в прежнем порядке.
&Тест
Процедура ДомПакетаПрячетРазделыСПорогомВышеДомового() Экспорт

	Пакет = Новый Структура("Имя", "cron");
	Смотрящий = Вошедший();

	БезПорогов = ДомПакета(Ложь, Ложь);
	Ожидаем.Что(СоставКолонки(Печать(БезПорогов, БезПорогов.Разделы("corp", "cron", "card", Смотрящий, Пакет))),
		"без права на доверие и удаление — ни доверенной публикации, ни опасной зоны")
		.Равно("card tags versions access webhooks");
	Ожидаем.Что(БезПорогов.РазделОткрыт("ci", Смотрящий, Пакет), "раздел доверия ему закрыт").ЭтоЛожь();
	Ожидаем.Что(БезПорогов.ЕстьРаздел("ci"), "КОНТРОЛЬ: у дома раздел доверия есть").ЭтоИстина();

	ТолькоДоверие = ДомПакета(Истина, Ложь);
	Ожидаем.Что(СоставКолонки(Печать(ТолькоДоверие, ТолькоДоверие.Разделы("corp", "cron", "card", Смотрящий,
		Пакет))), "право на доверие открывает только его").Равно("card tags versions access ci webhooks");

КонецПроцедуры

&Тест
Процедура ДомАккаунтаДелитРазделыНаАккаунтИДоступ() Экспорт

	Дом = Новый ДомАккаунта(Сборка, UI.Тексты, Новый АдресаКабинета(Новый АдресаСтраниц()));
	Страница = Печать(Дом, Дом.Разделы("tokens"));

	// кабинет живёт на своём адресе, вне адреса дома
	Ожидаем.Что(СоставКолонки(Страница), "рубрики и порядок дома аккаунта (рубрики объекта нет)").Равно(
		"me profile appearance [Доступ] security tokens oidc permissions");
	Ожидаем.Что(ЗначениеЗаполнено(СсылкаРаздела(Страница, "/me")), "кабинет — по своему адресу").ЭтоИстина();

КонецПроцедуры

// Замечание владельца к ui.4 (шторка на телефоне, admin на экране аккаунта): логин стоял
// и в блоке учётки, и в имени группы разделов («Аккаунт · admin»), а под ним — рубрика
// «Аккаунт». Группа разделов дома в шторке подписана общим именем дома, без логина; рубрику
// своего объекта дом объявляет сам (РубрикаОбъекта), и её нет ни в шторке, ни в колонке.
&Тест
Процедура ШторкаДомаНеПовторяетИмяОбъекта() Экспорт

	Аккаунт = Новый ДомАккаунта(Сборка, UI.Тексты, Новый АдресаКабинета(Новый АдресаСтраниц()));
	Модель = Ответы.МодельДома(Аккаунт, "", Аккаунт.Разделы("tokens"), Новый Массив(), Новый Массив());
	Модель.Заголовок = Аккаунт.ЗаголовокУчётки("root");
	Страница = Отдать(Модель).ТелоТекст;

	Ожидаем.Что(Аккаунт.РубрикаОбъекта(), "дом аккаунта объявляет рубрику своего объекта").Равно("Аккаунт");
	Ожидаем.Что(ИмяГруппыМеню(Страница), "группа разделов аккаунта — без логина")
		.Равно("Настройки аккаунта");
	Ожидаем.Что(СоставГруппыМеню(Страница), "в шторке рубрики объекта нет, вторая — на месте")
		.Равно("me profile appearance [Доступ] security tokens oidc permissions");
	Ожидаем.Что(СоставКолонки(Страница), "и в колонке под «Аккаунт · root» — тоже")
		.Равно("me profile appearance [Доступ] security tokens oidc permissions");
	Ожидаем.Что(Страница, "на странице заголовок дома — с логином, как был")
		.Содержит("<h1 class=""settings__title"">Аккаунт · root</h1>");

	Хаб = Новый ДомХаба(Сборка, UI.Тексты, Новый ОписаниеПриложения());
	Страница = Отдать(Ответы.МодельДома(Хаб, "", Хаб.Разделы("identity"), Новый Массив(), Новый Массив()))
		.ТелоТекст;
	Ожидаем.Что(Хаб.РубрикаОбъекта(), "дом хаба объявляет рубрику своего объекта").Равно("Хаб");
	Ожидаем.Что(ИмяГруппыМеню(Страница), "группа дома хаба").Равно("Настройки хаба");
	Ожидаем.Что(СтрНачинаетсяС(СоставГруппыМеню(Страница), "identity branding [Вход] login"),
		"рубрики «Хаб» в шторке нет: " + СоставГруппыМеню(Страница)).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(СоставКолонки(Страница), "identity branding [Вход] login"),
		"и в колонке нет: " + СоставКолонки(Страница)).ЭтоИстина();

	Пул = ДомПула();
	Страница = Отдать(Ответы.МодельДома(Пул, "corp", Пул.Разделы("corp", "general"), Новый Массив(),
		Новый Массив())).ТелоТекст;
	Ожидаем.Что(Пул.РубрикаОбъекта(), "дом пула объявляет рубрику своего объекта").Равно("Пул");
	Ожидаем.Что(ИмяГруппыМеню(Страница), "группа дома пула — без имени пула").Равно("Настройки пула");
	Ожидаем.Что(СтрНачинаетсяС(СоставГруппыМеню(Страница), "general visibility access quota [Пакеты]"),
		"рубрики «Пул» в шторке нет: " + СоставГруппыМеню(Страница)).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(СоставКолонки(Страница), "general visibility access quota [Пакеты]"),
		"и в колонке нет: " + СоставКолонки(Страница)).ЭтоИстина();

	// КОНТРОЛЬ: модель без поля рубрики объекта — рубрики как есть, и в колонке, и в шторке
	Страница = Отдать(МодельХаба(Разделы("login"), Новый Массив())).ТелоТекст;
	Ожидаем.Что(СоставГруппыМеню(Страница), "шторка").Равно("[Основа] identity [Люди] login people danger!");
	Ожидаем.Что(СоставКолонки(Страница), "колонка").Равно("[Основа] identity [Люди] login people danger!");

КонецПроцедуры

&Тест
Процедура КрошкиДомовПулаИПакетаВедутСоСтраницыПулов() Экспорт

	Пул = ДомПула();
	Пакет = Новый ДомПакета(Сборка, Пул, Неопределено, Неопределено, UI.Тексты, Новый АдресаСтраниц());

	Ожидаем.Что(КрошкиСтрокой(Пул.Крошки("corp")), "крошки дома пула")
		.Равно("Пулы→/pools corp→/pools/corp настройки");
	Ожидаем.Что(КрошкиСтрокой(Пакет.Крошки("corp", "cron")), "крошки дома пакета")
		.Равно("Пулы→/pools corp→/pools/corp cron→/pools/corp/packages/cron настройки");

КонецПроцедуры

&Тест
Процедура ТокенМоделиДомаПриходитПараметромМоделиДома() Экспорт

	Дом = Новый ДомХаба(Сборка, UI.Тексты);
	Модель = Ответы.МодельДома(Дом, "openhub", Дом.Разделы("identity"), Новый Массив(), СекцияУзлом(),
		"т0кен-параметра");
	ТелоФормы = ТелоФормы(Отдать(Модель).ТелоТекст, "/hub/settings/identity/revoke");

	Ожидаем.Что(ТелоФормы, "форма в доме берёт токен из параметра модели")
		.Содержит("value=""т0кен-параметра""");

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ДомПула()
	Возврат Новый ДомПула(Сборка, UI.Тексты, Новый АдресаСтраниц(), Новый АдресаКаталога());
КонецФункции

Функция ДомПакета(Знач ДовериеОткрыто, Знач УдалениеОткрыто)
	Возврат Новый ДомПакета(Сборка, ДомПула(), Новый ПорогРазделаПакетаЗаглушка(ДовериеОткрыто),
		Новый ПорогРазделаПакетаЗаглушка(УдалениеОткрыто), UI.Тексты, Новый АдресаСтраниц());
КонецФункции

// Дом с разделами без секций — печатью узла, для чтения колонки.
Функция Печать(Знач Дом, Знач Разделы)
	Модель = Ответы.МодельДома(Дом, "", Разделы, Новый Массив(), Новый Массив());
	Возврат Сборка.Дом(Модель, "").Рендер();
КонецФункции

// Колонка разделов строкой: «[Рубрика]» над группой, последний сегмент адреса раздела,
// у опасного — «!» за ним.
Функция СоставКолонки(Знач Разметка)

	Колонка = Сред(Разметка, СтрНайти(Разметка, "settings__nav"));
	Колонка = Лев(Колонка, СтрНайти(Колонка, "</nav>"));

	Части = Новый Массив();
	Выражение = Новый РегулярноеВыражение(
		"tree__rubric"">([^<]*)<|href=""[^""]*/([^/""]*)"" class=""tree__link([^""]*)""");
	Для Каждого Совпадение Из Выражение.НайтиСовпадения(Колонка) Цикл
		Если ЗначениеЗаполнено(Совпадение.Группы[1].Значение) Тогда
			Части.Добавить("[" + Совпадение.Группы[1].Значение + "]");
		Иначе
			Части.Добавить(Совпадение.Группы[2].Значение
				+ ?(СтрНайти(Совпадение.Группы[3].Значение, "--danger") > 0, "!", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

// Имя группы разделов экрана в едином меню.
Функция ИмяГруппыМеню(Знач Разметка)

	Группа = Сред(Разметка, СтрНайти(Разметка, "hubmenu__section--screen"));
	Имя = Сред(Группа, СтрНайти(Группа, "hubmenu__title"">") + СтрДлина("hubmenu__title"">"));
	Возврат Лев(Имя, СтрНайти(Имя, "</p>") - 1);

КонецФункции

// Группа разделов экрана в едином меню строкой, как СоставКолонки.
Функция СоставГруппыМеню(Знач Разметка)

	Группа = Сред(Разметка, СтрНайти(Разметка, "hubmenu__section--screen"));
	Группа = Лев(Группа, СтрНайти(Группа, "</nav>"));

	Части = Новый Массив();
	Выражение = Новый РегулярноеВыражение(
		"hubmenu__rubric"">([^<]*)<|href=""[^""]*/([^/""]*)"" class=""([^""]*)""");
	Для Каждого Совпадение Из Выражение.НайтиСовпадения(Группа) Цикл
		Если ЗначениеЗаполнено(Совпадение.Группы[1].Значение) Тогда
			Части.Добавить("[" + Совпадение.Группы[1].Значение + "]");
		Иначе
			Части.Добавить(Совпадение.Группы[2].Значение
				+ ?(СтрНайти(Совпадение.Группы[3].Значение, "button--danger") > 0, "!", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция КрошкиСтрокой(Знач Крошки)

	Части = Новый Массив();
	Для Каждого Крошка Из Крошки Цикл
		Части.Добавить(Крошка.Подпись + ?(ЗначениеЗаполнено(Крошка.Адрес), "→" + Крошка.Адрес, ""));
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция Отдать(Знач Модель)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ответы.ОтдатьДом(Ответ, Модель, Новый Структура("Пользователь", Вошедший()), Неопределено);
	Возврат Ответ;

КонецФункции

// Имя вкладки браузера без знака хаба, который каркас дописывает через тире.
Функция Вкладка(Знач Ответ)

	Титул = Сред(Ответ.ТелоТекст, СтрНайти(Ответ.ТелоТекст, "<title>") + СтрДлина("<title>"));
	Титул = Лев(Титул, СтрНайти(Титул, "</title>") - 1);
	Тире = СтрНайти(Титул, " — ", НаправлениеПоиска.СКонца);
	Возврат ?(Тире = 0, Титул, Лев(Титул, Тире - 1));

КонецФункции

Функция Вошедший()
	Возврат Новый Структура("Идентификатор, Логин, РольХаба", 7, "смотрящий", "user");
КонецФункции

Функция МодельХаба(Знач Разделы, Знач Секции)

	Модель = Новый Структура();
	Модель.Вставить("Ключ", "hub");
	Модель.Вставить("Заголовок", "Настройки хаба");
	Модель.Вставить("Объект", "openhub");
	Модель.Вставить("Пояснение", "Как хаб выглядит и кого пускает");
	Модель.Вставить("Разделы", Разделы);
	Модель.Вставить("Уведомления", Новый Массив());
	Модель.Вставить("Хлебные", Новый Массив());
	Модель.Вставить("Секции", Секции);
	Модель.Вставить("Токен", "");
	Возврат Модель;

КонецФункции

// Разделы маленького дома: две рубрики и опасный, объявленный не последним.
Функция Разделы(Знач Текущий)

	Перечень = Сборка.ПереченьРазделов();
	Сборка.Раздел(Перечень, "identity", "IDENTITY", "куб", "Основа");
	Сборка.ОпасныйРаздел(Перечень, "danger", "DANGER", "предупреждение");
	Сборка.Раздел(Перечень, "login", "LOGIN", "замок", "Люди");
	Сборка.Раздел(Перечень, "people", "PEOPLE", "аккаунт", "Люди");
	Возврат Сборка.РазделыДома("/hub/settings", Перечень, Текущий);

КонецФункции

// Секции витрины узлами без форм: дому для них токен не нужен.
Функция СекцииВитрины()

	Результат = Новый Массив();
	Результат.Добавить(UI.Кит.Секция("Сведения", UI.Кит.Текст("Что знает хаб")).Иконка("куб"));
	Результат.Добавить(UI.Кит.Секция("Удаление", UI.Кит.Текст("Необратимо")).Опасная());
	Возврат Результат;

КонецФункции

// Секция витрины узлом: форма внутри неё берёт адрес раздела и токен у дома.
Функция СекцияУзлом()

	Результат = Новый Массив();
	Результат.Добавить(UI.Кит.Секция("Ключ доступа",
		UI.Кит.Форма("revoke", UI.Кит.Кнопка("Отозвать").Опасная())));
	Возврат Результат;

КонецФункции

// Открывающий тег ссылки раздела в колонке: по нему видно, помечен ли раздел текущим.
Функция СсылкаРаздела(Знач Разметка, Знач Адрес)

	Колонка = Сред(Разметка, СтрНайти(Разметка, "settings__nav"));
	Возврат ТегСАтрибутом(Колонка, "a", "href=""" + Адрес + """");

КонецФункции

// Форма с этим адресом целиком, до её закрывающего тега; "" — формы нет.
Функция ТелоФормы(Знач Разметка, Знач Адрес)

	Форма = ТегСАтрибутом(Разметка, "form", "action=""" + Адрес + """");
	Если НЕ ЗначениеЗаполнено(Форма) Тогда
		Возврат "";
	КонецЕсли;

	Тело = Сред(Разметка, СтрНайти(Разметка, Форма));
	Возврат Лев(Тело, СтрНайти(Тело, "</form>"));

КонецФункции

Функция ТегСАтрибутом(Знач Разметка, Знач Тег, Знач Атрибут)

	Позиция = СтрНайти(Разметка, Атрибут);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = СтрНайти(Разметка, "<" + Тег, НаправлениеПоиска.СКонца, Позиция);
	Конец = СтрНайти(Разметка, ">", , Позиция);
	Возврат Сред(Разметка, Начало, Конец - Начало + 1);

КонецФункции

#КонецОбласти
