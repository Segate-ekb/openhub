// Каталог пакетов /packages глазами посетителя: выдача карточками, строка поиска, вкладки отборов,
// плашка пула, пустая выдача и страницы. Отбор и страница живут в адресе: поиск внутри отбора его
// не сбрасывает, шаги страниц несут и запрос, и отбор; со скриптом поиск и страницы меняют список
// без перезагрузки (признак тихой формы и тихих ссылок кита), без скрипта — обычной навигацией.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;          // Структура компонентов (фикстура СборкаUI)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьКаталог() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогКлассов = ОбъединитьПути(Модули, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ЗамерХранилищаПровенанса");
	РеестрФикстур.Подключить("ФейкОкруженияВитрины");
	РеестрФикстур.Подключить("ОкружениеКаталога");

	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(КаталогКлассов, "КонтроллерКаталога");
	Поиск.Подключить(КаталогКлассов, "ВитринаПакетов");
	КаталогРеестра = ОбъединитьПути(Модули, "реестр", "Классы");
	Для Каждого Имя Из СтрРазделить("СервисПроисхождения,СнимокПровенанса,АдресаСтраниц", ",") Цикл
		Поиск.Подключить(КаталогРеестра, Имя);
	КонецЦикла;

	UI = Новый СборкаUI().Собрать(КаталогКлассов);

КонецПроцедуры

// Гость и вошедший видят одну и ту же выдачу карточками; вкладки «Все пакеты / В моём управлении»
// — только вошедшему: гость ничем не управляет.
&Тест
Процедура ВыдачаОднаГостюИВошедшемуВкладкиТолькоВошедшему() Экспорт

	Гостю = Каталог(ОкружениеСТремяПакетами());
	Вошедший = ОкружениеСТремяПакетами();
	Вошедший.Войти(Новый Структура("Логин", "alice"));
	Вошедшему = Каталог(Вошедший);

	Для Каждого Имя Из СтрРазделить("veles-core,veles-http,md-view", ",") Цикл
		Ожидаем.Что(Гостю, "гостю — карточка " + Имя).Содержит(">" + Имя + "<");
		Ожидаем.Что(Вошедшему, "вошедшему — карточка " + Имя).Содержит(">" + Имя + "<");
	КонецЦикла;
	Ожидаем.Что(СтрЧислоВхождений(Гостю, "class=""objcard"""), "три пакета — три карточки").Равно(3);
	Ожидаем.Что(Гостю, "итог выдачи").Содержит(UI.Тексты.Шаблон("public.catalog.found", "3"));

	Ожидаем.Что(Гостю, "гостю вкладок отборов нет").Не_().Содержит(UI.Тексты.Текст("public.catalog.tab.mine"));
	Вкладки = Кусок(Вошедшему, "<nav", "</nav>");
	Ожидаем.Что(Вкладки, "вошедшему — вкладка «В моём управлении»").Содержит("href=""/packages?mine=1""");
	Ожидаем.Что(Вкладки, "вкладка «Все пакеты» текущая").Содержит("aria-current=""page""");

КонецПроцедуры

// Строка поиска — GET-форма каталога со значком в строке, уходит без перезагрузки; отбор едет
// скрытыми полями, номер страницы — нет: новый поиск начинается с первой страницы.
&Тест
Процедура ПоискВнутриОтбораНесётОтборАНеСтраницу() Экспорт

	Форма = ПерваяФорма(Каталог(ОкружениеСТремяПакетами(), "veles", "2", "corp", "1"));

	Ожидаем.Что(Форма, "форма уходит в каталог").Содержит("action=""/packages""");
	Ожидаем.Что(Форма, "форма отбора — GET").Не_().Содержит("method=""post""");
	Ожидаем.Что(Форма, "со скриптом — без перезагрузки").Содержит("data-quiet");
	Ожидаем.Что(Форма, "набранное в поле").Содержит("value=""veles""");
	Ожидаем.Что(Форма, "пул едет скрытым полем").Содержит("name=""pool"" value=""corp""");
	Ожидаем.Что(Форма, "«в моём управлении» едет скрытым полем").Содержит("name=""mine"" value=""1""");
	Ожидаем.Что(Форма, "номер страницы в форму не попадает").Не_().Содержит("name=""page""");

КонецПроцедуры

// Адрес — это отбор: экран спрашивает каталог тем, что пришло в адресе; мусор вместо номера
// страницы читается первой страницей.
&Тест
Процедура АдресПереходитВЗапросКаталога() Экспорт

	Окружение = ОкружениеСТремяПакетами();
	Каталог(Окружение, " veles ", "мусор", "corp", "1");

	Ожидаем.Что(Окружение.Спрошено.Запрос, "подстрока из q").Равно(" veles ");
	Ожидаем.Что(Окружение.Спрошено.Страница, "мусор вместо номера — первая страница").Равно(1);
	Ожидаем.Что(Окружение.Спрошено.Отбор.Пул, "пул из pool").Равно("corp");
	Ожидаем.Что(Окружение.Спрошено.Отбор.ТолькоУправляемые, "mine=1 — только управляемые").ЭтоИстина();

КонецПроцедуры

// Шаги страниц несут запрос и отбор (иначе вторая страница поиска показала бы весь каталог)
// и уходят без перезагрузки.
&Тест
Процедура СтраницыНесутЗапросИОтбор() Экспорт

	Окружение = ОкружениеСТремяПакетами();
	Окружение.ЗадатьСтраницы(45, 3);
	Страницы = Кусок(Каталог(Окружение, "veles", "2", "corp"), "<nav class=""pagination", "</nav>");

	Ожидаем.Что(Страницы, "есть шаг на третью страницу").Содержит("page=3");
	Ожидаем.Что(Страницы, "шаг несёт запрос").Содержит("q=veles");
	Ожидаем.Что(Страницы, "шаг несёт пул").Содержит("pool=corp");
	Ожидаем.Что(Страницы, "шаги без перезагрузки").Содержит("data-quiet");

КонецПроцедуры

// Отбор по пулу пришёл из адреса — над выдачей плашка с именем пула, ведущая на его страницу,
// и заголовок называет пул.
&Тест
Процедура ОтборПоПулуНазванПлашкойИЗаголовком() Экспорт

	Разметка = Каталог(ОкружениеСТремяПакетами(), "", "", "corp");

	Ожидаем.Что(Разметка, "заголовок называет пул").Содержит(UI.Тексты.Шаблон("public.catalog.title.pool", "corp"));
	Ожидаем.Что(Разметка, "плашка пула ведёт на его страницу").Содержит("href=""/pools/corp""");
	Ожидаем.Что(Разметка, "в плашке имя пула").Содержит(UI.Тексты.Шаблон("public.catalog.filter.pool", "corp"));

	Ожидаем.Что(Каталог(ОкружениеСТремяПакетами()), "без отбора плашки пула нет")
		.Не_().Содержит(UI.Тексты.Шаблон("public.catalog.filter.pool", "corp"));

КонецПроцедуры

// Пустая выдача объясняет, почему пусто, и ведёт туда, где не пусто: по запросу — к каталогу
// без запроса, в «моём управлении» — к каталогу без этого отбора; итога «найдено 0» нет.
&Тест
Процедура ПустаяВыдачаОбъясняетПричину() Экспорт

	Пусто = Новый ОкружениеКаталога();

	ПоЗапросу = Каталог(Пусто, "zzz");
	Ожидаем.Что(ПоЗапросу, "по запросу").Содержит(UI.Тексты.Шаблон("public.catalog.empty.query.title", "zzz"));
	Ожидаем.Что(ПоЗапросу, "ведёт к каталогу без запроса").Содержит("href=""/packages""");
	Ожидаем.Что(ПоЗапросу, "итога «найдено 0» нет").Не_().Содержит(UI.Тексты.Шаблон("public.catalog.found", "0"));

	Мои = Каталог(Пусто, "", "", "corp", "1");
	Ожидаем.Что(Мои, "ничем не управляет").Содержит(UI.Тексты.Текст("public.catalog.empty.mine.title"));
	Ожидаем.Что(Мои, "ведёт к каталогу пула без отбора «моих»").Содержит("href=""/packages?pool=corp""");

	Ожидаем.Что(Каталог(Пусто, "", "", "corp"), "в пуле пусто")
		.Содержит(UI.Тексты.Текст("public.catalog.empty.pool.title"));
	Ожидаем.Что(Каталог(Пусто), "на хабе пусто").Содержит(UI.Тексты.Текст("public.catalog.empty.title"));

КонецПроцедуры

// Запрос и пул приходят из адреса кем угодно и печатаются на странице в шести местах — заголовок,
// плашка пула, значение строки поиска, скрытое поле, заголовок пустой выдачи, шаги страниц. Везде это
// текст: тега из адреса на странице нет, кавычка не закрывает атрибут.
&Тест
Процедура ЗапросИПулИзАдресаПечатаютсяТекстом() Экспорт

	Запрос = "q""><script>alert(1)</script>";
	Пул = "p""><script>alert(2)</script>";

	Пусто = Каталог(Новый ОкружениеКаталога(), Запрос, "", Пул);
	СоСтраницами = ОкружениеСТремяПакетами();
	СоСтраницами.ЗадатьСтраницы(45, 3);
	Шаги = Кусок(Каталог(СоСтраницами, Запрос, "2", Пул), "<nav class=""pagination", "</nav>");

	// КОНТРОЛЬ: значения на странице есть — экранированными и в адресе шагов
	Ожидаем.Что(Пусто, "заголовок пустой выдачи называет запрос").Содержит("&lt;script&gt;alert(1)");
	Ожидаем.Что(Пусто, "заголовок страницы и плашка называют пул").Содержит("&lt;script&gt;alert(2)");
	Ожидаем.Что(Шаги, "шаги несут запрос, закодированный для адреса").Содержит("q=q%22%3E%3Cscript%3E");

	Для Каждого Разметка Из СтрРазделить(Пусто + Символы.ПС + Шаги, Символы.ПС) Цикл
		Ожидаем.Что(СтрНайти(НРег(Разметка), "<script"), "тега из адреса на странице нет").Равно(0);
		Ожидаем.Что(СтрНайти(Разметка, "q""><"), "кавычка запроса не закрыла атрибут").Равно(0);
		Ожидаем.Что(СтрНайти(Разметка, "p""><"), "кавычка пула не закрыла атрибут").Равно(0);
	КонецЦикла;
	Ожидаем.Что(Пусто, "КОНТРОЛЬ: запрос стоит в поле поиска").Содержит("name=""q"" value=""q&");
	Ожидаем.Что(Пусто, "КОНТРОЛЬ: пул едет скрытым полем").Содержит("name=""pool"" value=""p&");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ОкружениеСТремяПакетами()

	Результат = Новый ОкружениеКаталога();
	Корп = Новый ПулЗаглушка(1, "corp", "custom");
	Результат.ДобавитьПакет(1, "veles-core", Корп);
	Результат.ДобавитьПакет(2, "veles-http", Корп);
	Результат.ДобавитьПакет(3, "md-view", Новый ПулЗаглушка(2, "public", "default"));
	Возврат Результат;

КонецФункции

// Каталог настоящим контроллером: окружение стоит за каталог, гвард, принципал и каркас.
Функция Каталог(Знач Окружение, Знач q = "", Знач page = "", Знач pool = "", Знач mine = "")

	Витрина = Новый ВитринаПакетов(Новый СервисПроисхождения(Новый ЗамерХранилищаПровенанса()),
		Новый ФейкОкруженияВитрины(), UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Новый ФейкОкруженияВитрины());

	Экран = Новый КонтроллерКаталога(Окружение, Витрина, UI.КарточкаОбъекта, UI.Кит, Окружение, UI.Тексты,
		Окружение, Окружение, UI.АдресаКаталога, Новый АдресаСтраниц());

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Список(Ответ, Новый Соответствие(), Неопределено, "/packages", q, page, pool, mine);
	Возврат Ответ.ТелоТекст;

КонецФункции

// Первая форма страницы целиком.
Функция ПерваяФорма(Знач Разметка)
	Возврат Кусок(Разметка, "<form", "</form>");
КонецФункции

// Кусок разметки от первого начала до первого конца после него, включительно.
Функция Кусок(Знач Разметка, Знач Начало, Знач Конец)

	Позиция = СтрНайти(Разметка, Начало);
	Ожидаем.Что(Позиция, "на странице есть " + Начало).Больше(0);
	Хвост = Сред(Разметка, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, Конец) + СтрДлина(Конец) - 1);

КонецФункции

#КонецОбласти
