// Дом «Хаб», разделы с полями реестра настроек: «Основное» одной формой со «Сборкой», парольный вход —
// тумблером и окном выключения по адресу, проба почты — кнопкой своей формы; настоящим контроллером
// дома поверх настоящей службы настроек в контейнере. Предохранитель парольного входа — фейком: его
// вердикт задаёт тест.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Контроллер;    // КонтроллерДомаХаба
Перем Страж;         // ФейкСтражаПарольногоВхода — вердикт предохранителя
Перем Настройки;     // СервисНастроек — настоящие значения реестра
Перем Гвард;         // ГвардХабаЗаглушка — впускает админа либо никого
Перем ПультПробы;    // ПультНейтральный на месте пробы почты — считает, дошёл ли до него запрос

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");
	Слои.ПодключитьТаблицы("уведомления");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("вход, права, настройки, гео, сеть, хранилище, почта, интерфейс/общее,"
		+ " интерфейс/хаб, интерфейс/панели/страна, состояние/выпуски");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "КонтроллерДомаХаба");

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкЖурналЗамка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ГвардХабаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ФейкСтражаПарольногоВхода");
	РеестрФикстур.Подключить("ПультНейтральный");
	РеестрФикстур.Подключить("ИсходникиПроекта");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-настроек-хаба-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Админ = Желудь("СервисПользователей").СоздатьПользователя("root7n", "root7n@example.org",
		"password123", "admin");
	Гвард = Новый ГвардХабаЗаглушка();
	ПультПробы = Новый ПультНейтральный();
	Гвард.Впустить(Новый Структура("Логин, Админ, Email, РольХаба", "root7n", Истина, "root7n@example.org",
		"admin"), Принципалы.Сессия(Админ));

	Настройки = Желудь("СервисНастроек");
	Страж = Новый ФейкСтражаПарольногоВхода(Настройки);

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Новый ФейкСервисПрав(), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Защита.ЗадатьИсход(Истина);

	Политика = Желудь("ПолитикаПарольногоВхода");
	ОкноПароля = Новый ВитринаПарольногоВхода(Желудь("Кит"), Желудь("ТекстыИнтерфейса"),
		Желудь("ПоляНастроек"), Настройки, Политика, Страж, Желудь("ОкноРаздела"));
	ПультПароля = Новый ПультПарольногоВхода(Желудь("РазборФормы"), Политика, Страж,
		Желудь("РазделыНастроекХаба"), Желудь("ПоляНастроек"), ОкноПароля, Желудь("ИтогПульта"),
		Желудь("ТекстСбоя"), Желудь("ТекстыИнтерфейса"));
	ВитринаДома = Новый ВитринаДомаХаба(Желудь("ДомХаба"), Желудь("ВитринаНастроек"),
		Желудь("ВитринаПулов"), Желудь("ВитринаБрендирования"), Желудь("ВитринаСведенийХаба"),
		Желудь("ВитринаХранилища"), Желудь("ВитринаПробыПочты"), ОкноПароля, Желудь("ОтборПулов"));

	Контроллер = Новый КонтроллерДомаХаба(Гвард, Ответы, Желудь("ДомХаба"), Желудь("ВитринаНастроек"),
		// личные пространства и отправку письма набор не трогает: их пульты молчат, а проба
		// почты стережётся набором почты
		ВитринаДома, Желудь("ПультЗначенийНастроек"), Новый ПультНейтральный(), ПультПароля, ПультПробы,
		Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы")), Защита,
		Желудь("РазборФормы"), Желудь("ТекстыИнтерфейса"),
		Желудь("ОтметкаСохранения"), Желудь("ОкноРаздела"), ОкноПароля);

КонецПроцедуры

&ПередКаждым
Процедура ВернутьВходПоПаролю() Экспорт
	Гвард.НеВпускать(Ложь);
	Страж.Разрешить(Истина);
	Страж.Включить("тест");
КонецПроцедуры

#Область Основное

&Тест
Процедура ОсновноеПравитсяОднойФормойСИсточникомУКаждогоЗначения() Экспорт

	Страница = Получить("identity");

	Ожидаем.Что(Страница.Код, "раздел отдан").Равно(200);
	Ожидаем.Что(Вкладка(Страница), "вкладка называет раздел и дом").Равно(
		"Основное · Настройки хаба · " + Желудь("ОписаниеПриложения").Имя());

	Форма = ФормаСПолем(Страница.ТелоТекст, "oshub.instance.url");
	Ожидаем.Что(Форма, "форма уходит на раздел").Содержит("action=""/hub/settings/identity""");
	Ожидаем.Что(Форма, "адрес хаба правится формой раздела").Содержит("name=""oshub.instance.url""");
	Ожидаем.Что(Форма, "и «opm знает этот хаб» — той же формой")
		.Содержит("name=""oshub.instance.opm_default_hub""");
	Ожидаем.Что(СтрЧислоВхождений(Форма, "type=""submit"""), "одна панель сохранения").Равно(1);
	Ожидаем.Что(Форма, "у адреса источник справа в строке подсказки")
		.Содержит(Текст("settings.source.default") + " · oshub.instance.url");

КонецПроцедуры

&Тест
Процедура СборкаНазываетВерсииИКопируетВерсиюХаба() Экспорт

	Разметка = Получить("identity").ТелоТекст;
	Манифест = Новый ИсходникиПроекта().Текст(ОбъединитьПути(КаталогиПроекта.Корень(), "packagedef"));

	// ожидания — из packagedef своим разбором, а не у проверяемой двери
	Версия = Совпадение(Манифест, "(?m)^[ \t]*\.Версия\(""([^""]+)""\)");
	Ожидаем.Что(Версия, "самотест: версия хаба в packagedef").Заполнено();
	Ожидаем.Что(Разметка, "версия хаба копируется").Содержит("data-copy=""" + Версия + """");
	Для Каждого Пакет Из СтрРазделить("autumn,winow,oscript-ui", ",") Цикл
		Ожидаемая = Совпадение(Манифест, "(?m)^[ \t]*\.ЗависитОт\(""" + Пакет + """,\s*""([^""]+)""\)");
		Ожидаем.Что(Ожидаемая, "самотест: packagedef называет " + Пакет).Заполнено();
		Ожидаем.Что(Разметка, "названа версия " + Пакет).Содержит(">" + Ожидаемая + "<");
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Разметка, "name=""oshub.version"""), "версия — не поле ввода").Равно(0);

КонецПроцедуры

Функция Совпадение(Знач Текст, Знач Выражение)
	Совпадения = Новый РегулярноеВыражение(Выражение).НайтиСовпадения(Текст);
	Возврат ?(Совпадения.Количество() = 0, "", Совпадения[0].Группы[1].Значение);
КонецФункции

&Тест
Процедура СохранениеОсновногоМеняетЗначениеВДомене() Экспорт

	Ответ = Отправить("identity", "oshub.instance.url=" + Закодировать("https://hub.example.org"));

	Ожидаем.Что(Ответ.ПутьРедиректа, "удача уводит на раздел с отметкой")
		.Содержит("/hub/settings/identity");
	Ожидаем.Что(Настройки.Значение("oshub.instance.url"), "значение записано в домен")
		.Равно("https://hub.example.org");

	Настройки.Сбросить("oshub.instance.url", "тест");

КонецПроцедуры

&Тест
Процедура НеизвестноеОкноДаётСтраницуБезОкна() Экспорт

	Страница = Получить("identity", "что-то-не-то");
	Ожидаем.Что(Страница.Код, "страница отдана").Равно(200);
	Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "окон нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПарольныйВход

&Тест
Процедура ТумблерПароляСвоейФормойВнеФормыРаздела() Экспорт

	Разметка = Получить("login").ТелоТекст;
	Общая = ФормаСПолем(Разметка, "oshub.auth.registration.mode");

	Ожидаем.Что(Общая, "КОНТРОЛЬ: форма раздела найдена").Содержит("action=""/hub/settings/login""");
	Ожидаем.Что(Общая, "тумблер пароля в общую форму не попал")
		.ЭтоНе().Содержит("name=""oshub.auth.password.enabled""");
	Ожидаем.Что(СтрЧислоВхождений(Разметка, "name=""oshub.auth.password.enabled"" value=""1"""),
		"тумблер пароля на странице один").Равно(1);
	Ожидаем.Что(Разметка, "и сохраняется сразу").Содержит("data-autosubmit");

	// без скрипта форму тумблера шлёт запасная кнопка кита — одна, своей у хаба нет
	Своя = ФормаСПолем(Разметка, "oshub.auth.password.enabled");
	Ожидаем.Что(СтрЧислоВхождений(Своя, "type=""submit"""), "кнопка отправки тумблера одна").Равно(1);
	Ожидаем.Что(Своя, "и это запасная кнопка кита").Содержит("toggle__save");

КонецПроцедуры

&Тест
Процедура ВыключениеБезПодтвержденияВедётНаОкноИВходЦел() Экспорт

	Ответ = Отправить("login", "oshub.auth.password.enabled=0");

	Ожидаем.Что(Ответ.Код, "ответ — перенаправление на окно подтверждения").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "окно названо адресом").Содержит(Закодировать("окно") + "="
		+ Закодировать("выключить"));
	Ожидаем.Что(Желудь("ПолитикаПарольногоВхода").Включён(), "вход по паролю не выключен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОкноВыключенияПоАдресуПечатаетсяОткрытымСЭхом() Экспорт

	Страница = Получить("login", "выключить");
	Окна = ОткрытыеОкна(Страница.ТелоТекст);

	Ожидаем.Что(Окна.Количество(), "открыто одно окно").Равно(1);
	Ожидаем.Что(Окна[0], "эхо-поле подтверждения").Содержит("name=""подтверждение""");
	Ожидаем.Что(Окна[0], "окно шлёт операцию выключения").Содержит("value=""парольный-вход""");
	Ожидаем.Что(Окна[0], "окно называет числа предохранителя").Содержит("— 2;");

КонецПроцедуры

&Тест
Процедура НеверноеЭхоДаёт400СОткрытымОкномИВходЦел() Экспорт

	Ответ = Отправить("login", "операция=" + Закодировать("парольный-вход") + "&"
		+ Закодировать("подтверждение") + "=" + Закодировать("выключай") + "&confirmed=1");

	Ожидаем.Что(Ответ.Код, "отказ по эху").Равно(400);
	Окна = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Окна.Количество(), "окно подтверждения открыто снова").Равно(1);
	Ожидаем.Что(Окна[0], "эхо-поле помечено").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Желудь("ПолитикаПарольногоВхода").Включён(), "вход по паролю не выключен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВерноеЭхоВыключаетВходПоПаролю() Экспорт

	Ответ = Отправить("login", "операция=" + Закодировать("парольный-вход") + "&"
		+ Закодировать("подтверждение") + "=" + Закодировать("выключить") + "&confirmed=1");

	Ожидаем.Что(Ответ.Код, "выключение прошло").Равно(200);
	Ожидаем.Что(Желудь("ПолитикаПарольногоВхода").Выключен(), "вход по паролю выключен").ЭтоИстина();
	Ожидаем.Что(ОткрытыеОкна(Ответ.ТелоТекст).Количество(), "окно закрыто").Равно(0);

КонецПроцедуры

&Тест
Процедура ПредохранительНеДаётОкнаИНазываетПричину() Экспорт

	Страж.Разрешить(Ложь);

	Страница = Получить("login", "выключить");
	Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "подтверждать нечего — окна нет").Равно(0);
	Ожидаем.Что(Страница.ТелоТекст, "причина названа на странице")
		.Содержит(Текст("settings.hub.passwordlogin.lockout.providers"));

	Ответ = Отправить("login", "oshub.auth.password.enabled=0");
	Ожидаем.Что(Ответ.Код, "выключение отбито").Равно(400);
	Ожидаем.Что(Желудь("ПолитикаПарольногоВхода").Включён(), "вход по паролю на месте").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Право

// Каждую дверь POST дома «Хаб» стережёт гвард: кого он не впустил, тот ни значения, ни входа,
// ни пробы почты не трогает. КОНТРОЛЬ — тот же POST впущенным меняет значение.
&Тест
Процедура ПостороннийНиОднойФормойДомХабаНеМеняет() Экспорт

	Было = Настройки.Значение("oshub.instance.url");
	Гвард.НеВпускать();

	Отправить("identity", "oshub.instance.url=" + Закодировать("https://чужой.example.org"));
	Ожидаем.Что(Настройки.Значение("oshub.instance.url"), "адрес хаба прежний").Равно(Было);

	Отправить("login", "операция=" + Закодировать("парольный-вход") + "&" + Закодировать("подтверждение") + "="
		+ Закодировать("выключить") + "&confirmed=1");
	Ожидаем.Что(Желудь("ПолитикаПарольногоВхода").Включён(), "вход по паролю не выключен").ЭтоИстина();
	Отправить("login", "oshub.auth.password.enabled=0");
	Ожидаем.Что(Желудь("ПолитикаПарольногоВхода").Включён(), "и тумблером тоже").ЭтоИстина();

	Вызовов = ПультПробы.Вызовов();
	Отправить("mail", "операция=" + Закодировать("проба-почты"));
	Ожидаем.Что(ПультПробы.Вызовов(), "до пульта пробы почты запрос не дошёл").Равно(Вызовов);

	Гвард.НеВпускать(Ложь);
	Отправить("identity", "oshub.instance.url=" + Закодировать("https://свой.example.org"));
	Ожидаем.Что(Настройки.Значение("oshub.instance.url"), "КОНТРОЛЬ: впущенный значение меняет")
		.Равно("https://свой.example.org");
	Настройки.Сбросить("oshub.instance.url", "тест");

КонецПроцедуры

#КонецОбласти

#Область Порядок

// Важное на виду, тонкое под катом: «Вход по паролю» — кто может войти — стоит выше тонких
// крутилок раздела, как его печатает настоящая страница, а не витрина в отрыве от неё.
&Тест
Процедура ВходПоПаролюВышеТонкихКрутилокНаСтраницеРаздела() Экспорт

	Страница = Получить("login").ТелоТекст;
	Режим = СтрНайти(Страница, "name=""oshub.auth.registration.mode""");
	Пароль = СтрНайти(Страница, "name=""oshub.auth.password.enabled""");
	Тонкие = СтрНайти(Страница, ">" + Текст("settings.hub.fine.title") + "<");
	Срок = СтрНайти(Страница, "name=""oshub.auth.token.cli_days""");

	Ожидаем.Что(Режим > 0 И Пароль > 0 И Тонкие > 0 И Срок > 0, "все четыре на странице").ЭтоИстина();
	Ожидаем.Что(Режим < Пароль, "значения раздела — первыми").ЭтоИстина();
	Ожидаем.Что(Пароль < Тонкие, "вход по паролю — выше тонких крутилок").ЭтоИстина();
	Ожидаем.Что(Тонкие < Срок, "срок токена CLI — внутри тонких").ЭтоИстина();

КонецПроцедуры

// Отбитая форма тонких крутилок приезжает в раскрытый кат: человек видит, что отказано, у поля.
&Тест
Процедура ОтбитаяФормаТонкихПриезжаетРаскрытой() Экспорт

	Свёрнуто = Получить("login").ТелоТекст;
	Ответ = Отправить("login", Закодировать("oshub.auth.token.cli_days") + "=" + Закодировать("не-число"));

	Ожидаем.Что(Ответ.Код, "негодное значение — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(КатТонких(Ответ.ТелоТекст), " open"), "кат тонких раскрыт").Больше(0);
	Ожидаем.Что(СтрНайти(КатТонких(Свёрнуто), " open"), "КОНТРОЛЬ: без отказа кат свёрнут").Равно(0);

КонецПроцедуры

// Отказ значения — под его полем, с набранным на месте: поле помечено, причина под ним; над
// разделом сказано, что из формы применено. Соседняя форма раздела набранным чужой формы не
// заполняется.
&Тест
Процедура ОтказЗначенияСтоитПодПолемСНабранным() Экспорт

	Ключ = "oshub.auth.token.cli_days";
	Ответ = Отправить("login", Закодировать(Ключ) + "=" + Закодировать("не-число"));

	Ожидаем.Что(Ответ.Код, "негодное значение — отказ").Равно(400);
	Поле = ПолеНастройки(Ответ.ТелоТекст, Ключ);
	Ожидаем.Что(Поле, "поле отбитой настройки помечено").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Поле, "набранное — на месте").Содержит("value=""не-число""");
	Ожидаем.Что(Поле, "причина — строкой отказа поля").Содержит("field__error");
	Ожидаем.Что(Ответ.ТелоТекст, "над разделом — что из формы применено")
		.Содержит(Текст("settings.hub.error.applied.none"));

	Режим = ПолеНастройки(Ответ.ТелоТекст, "oshub.auth.registration.mode");
	Ожидаем.Что(СтрНайти(Режим, "aria-invalid"), "соседняя форма отказа не получила").Равно(0);

	// КОНТРОЛЬ: без отказа поле не помечено и печатает действующее
	Чистое = ПолеНастройки(Получить("login").ТелоТекст, Ключ);
	Ожидаем.Что(СтрНайти(Чистое, "aria-invalid"), "КОНТРОЛЬ: без отказа поле чистое").Равно(0);
	Ожидаем.Что(СтрНайти(Чистое, "не-число"), "КОНТРОЛЬ: и набранного нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПробаПочты

&Тест
Процедура ПробаПочтыКнопкойСвоейФормыНаРазделПочты() Экспорт

	Разметка = Получить("mail").ТелоТекст;
	Проба = ФормаСПолем(Разметка, "операция");

	Ожидаем.Что(Проба, "проба — своя форма с операцией").Содержит("value=""проба-почты""");
	Ожидаем.Что(Проба, "форма уходит на раздел почты").Содержит("action=""/hub/settings/mail""");
	Ожидаем.Что(Проба, "получатель — учётка нажавшего").ЭтоНе().Содержит("name=""кому""");
	Ожидаем.Что(Разметка, "куда уйдёт письмо, сказано до нажатия").Содержит("root7n@example.org");

КонецПроцедуры

#КонецОбласти

#Область НоваяВерсия

// Вышла версия новее своей — первой секцией «Основного»: какая вышла, какая у этого хаба и куда
// идти читать; в остальных разделах дома её нет.
&Тест
Процедура НоваяВерсияХабаПервойСекциейОсновного() Экспорт

	Своя = Желудь("ОписаниеПриложения").Версия();
	ЗаписатьОтметку("99.0.0", "");

	Разметка = Получить("identity").ТелоТекст;

	Ожидаем.Что(Разметка, "секция новой версии на месте").Содержит(Текст("settings.hub.release.title"));
	Ожидаем.Что(Разметка, "называет вышедшую версию").Содержит(">99.0.0<");
	Ожидаем.Что(Разметка, "и свою").Содержит(">" + Своя + "<");
	Ожидаем.Что(Разметка, "ведёт на страницу выпуска у источника")
		.Содержит("href=""https://hub.oscript.io/pools/default/packages/openhub""");
	Ожидаем.Что(СтрНайти(Разметка, Текст("settings.hub.release.title")) < СтрНайти(Разметка, "name=""oshub.instance.url"""),
		"новая версия стоит выше формы раздела").ЭтоИстина();
	Ожидаем.Что(Получить("mail").ТелоТекст, "в других разделах дома её нет")
		.Не_().Содержит(Текст("settings.hub.release.title"));

КонецПроцедуры

// Нечего сказать — нечего и печатать: своя не младше, последняя проверка не удалась, проверка
// выключена. КОНТРОЛЬ — та же отметка при включённой проверке секцию даёт.
&Тест
Процедура БезНовойВерсииСекцииНет() Экспорт

	Своя = Желудь("ОписаниеПриложения").Версия();
	Заголовок = Текст("settings.hub.release.title");

	ЗаписатьОтметку(Своя, "");
	Ожидаем.Что(Получить("identity").ТелоТекст, "своя версия — не новая").Не_().Содержит(Заголовок);

	ЗаписатьОтметку("99.0.0", "https://hub.oscript.io/… не ответил: timeout");
	Ожидаем.Что(Получить("identity").ТелоТекст, "последняя проверка не удалась").Не_().Содержит(Заголовок);

	ЗаписатьОтметку("99.0.0", "");
	Настройки.Установить("oshub.updates.check", Ложь, "тест");
	Попытка
		Разметка = Получить("identity").ТелоТекст;
	Исключение
		Настройки.Сбросить("oshub.updates.check", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.updates.check", "тест");
	Ожидаем.Что(Разметка, "проверка выключена").Не_().Содержит(Заголовок);

	Ожидаем.Что(Получить("identity").ТелоТекст, "КОНТРОЛЬ: включённая проверка ту же отметку показывает")
		.Содержит(Заголовок);

КонецПроцедуры

// Дом «Хаб» открыт только администратору хаба: посторонний получает отказ гварда, а не страницу
// с новой версией.
&Тест
Процедура ПостороннемуНовойВерсииНеВидно() Экспорт

	ЗаписатьОтметку("99.0.0", "");
	Гвард.НеВпускать();

	Ответ = Получить("identity");

	Ожидаем.Что(Ответ.ТелоТекст, "посторонний новой версии не видит").Не_().Содержит("99.0.0");
	Гвард.НеВпускать(Ложь);
	Ожидаем.Что(Получить("identity").ТелоТекст, "КОНТРОЛЬ: администратор видит").Содержит("99.0.0");

КонецПроцедуры

Процедура ЗаписатьОтметку(Знач Последняя, Знач Ошибка)
	Желудь("ХранилищеОтметокВыпуска").Записать(Новый Структура("Последняя, Проверено, Ошибка, Объявлена",
		Последняя, ТекущаяУниверсальнаяДата(), Ошибка, Последняя));
КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Текст(Знач Ключ)
	Возврат Желудь("ТекстыИнтерфейса").Текст(Ключ);
КонецФункции

Функция Получить(Знач Раздел, Знач Окно = "")

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, Раздел, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;

КонецФункции

// Отбитая форма возвращает набранное в поля, но не секрет: раздел «Почта» с паролем SMTP и негодным
// портом — 400, отказ под портом, набранного пароля на странице нет ни в поле, ни где-либо ещё.
&Тест
Процедура СекретНеВозвращаетсяВОтбитуюФорму() Экспорт

	Пароль = "Smtp-Pass-7c1e9a";
	Попытка
		Ответ = Отправить("mail", Закодировать("oshub.mail.smtp.password") + "=" + Закодировать(Пароль)
			+ "&" + Закодировать("oshub.mail.smtp.port") + "=0");

		Ожидаем.Что(Ответ.Код, "негодный порт — отказ").Равно(400);
		Ожидаем.Что(ПолеНастройки(Ответ.ТелоТекст, "oshub.mail.smtp.port"), "отказ — под портом")
			.Содержит("aria-invalid=""true""");
		Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, Пароль), "набранного пароля в ответе нет — ни в поле, ни где-либо").Равно(0);
		Ожидаем.Что(ПолеНастройки(Ответ.ТелоТекст, "oshub.mail.smtp.password"), "КОНТРОЛЬ: поле пароля на странице")
			.Содержит("name=""oshub.mail.smtp.password""");
	Исключение
		Настройки.Сбросить("oshub.mail.smtp.password", "тест", "");
		Настройки.Сбросить("oshub.mail.smtp.port", "тест", "");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.mail.smtp.password", "тест", "");
	Настройки.Сбросить("oshub.mail.smtp.port", "тест", "");

КонецПроцедуры

// Обёртка настройки на странице: от её признака data-setting до следующей настройки.
Функция ПолеНастройки(Знач HTML, Знач Ключ)

	Позиция = СтрНайти(HTML, "data-setting=""" + Ключ + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Следующая = СтрНайти(Сред(Хвост, 2), "data-setting=""");
	Возврат ?(Следующая = 0, Лев(Хвост, 3000), Лев(Хвост, Следующая));

КонецФункции

Функция Отправить(Знач Раздел, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, Раздел, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Имя вкладки браузера без знака хаба, который каркас дописывает через тире.
Функция Вкладка(Знач Ответ)

	Титул = Сред(Ответ.ТелоТекст, СтрНайти(Ответ.ТелоТекст, "<title>") + СтрДлина("<title>"));
	Титул = Лев(Титул, СтрНайти(Титул, "</title>") - 1);
	Тире = СтрНайти(Титул, " — ", НаправлениеПоиска.СКонца);
	Возврат ?(Тире = 0, Титул, Лев(Титул, Тире - 1));

КонецФункции

// Открывающий тег раскрывашки, внутри которой стоит поле тонкой крутилки.
Функция КатТонких(Знач HTML)

	Позиция = СтрНайти(HTML, "name=""oshub.auth.token.cli_days""");
	Начало = СтрНайти(HTML, "<details", НаправлениеПоиска.СКонца, Позиция);
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Форма, в которой стоит поле, целиком: от её открывающего тега до закрывающего.
Функция ФормаСПолем(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Тело = Сред(HTML, СтрНайти(HTML, "<form", НаправлениеПоиска.СКонца, Позиция));
	Возврат Лев(Тело, СтрНайти(Тело, "</form>"));

КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
