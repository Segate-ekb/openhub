// Раздел «Зеркала» дома «Пул» на механизме «⚙ записи + окно по адресу + подтверждение»:
// окно нового зеркала и окно правки по ?окно=…, отказ пробы у поля адреса, маски списком,
// перенос, правка токена, снятие токена, удаление с эхом, тумблер и заявка на синхронизацию —
// настоящим контроллером поверх настоящей службы зеркал; хранилище — в памяти, транспорт пробы — фейк.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров интерфейса
Перем Ответы;      // ОтветыНастроек
Перем Дом;         // ДомПула
Перем Пул;         // ПулЗаглушка
Перем Настройки;   // НастройкиЗаглушка — выключатель пробы
Перем Транспорт;   // ФейкТранспортИсточника — что отвечает адрес на пробе
Перем Хранилище;   // ФейкХранилищеЗеркал
Перем Сервис;      // СервисЗеркал над хранилищем в памяти
Перем Контроллер;  // КонтроллерЗеркалПула

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Для Каждого Фикстура Из СтрРазделить("ПулЗаглушка,ГвардПулаЗаглушка,ОтветСтраницыЗаглушка,ФейкСервисПрав,"
		+ "ЗащитаCSRFЗаглушка,НастройкиЗаглушка,ФейкТранспортИсточника,ФейкХранилищеЗеркал,ФейкЗеркалоЗапись,"
		+ "ФлажокВРазметке", ",") Цикл
		РеестрФикстур.Подключить(Фикстура);
	КонецЦикла;

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей);
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	Поиск.Подключить(КаталогРеестра, "АдресаСтраниц");
	Поиск.Подключить(КаталогРеестра, "ВалидаторАдресаАпстрима");
	КаталогЗеркал = ОбъединитьПути(КаталогМодулей, "зеркала", "Классы");
	Для Каждого Имя Из СтрРазделить("СервисЗеркал,ПрогонЗеркала,ДроссельПрогресса,ЧислаЗеркалирования,"
		+ "СчётчикиОбхода,СрезОбхода,РазборНастроекЗеркала,ОчередьСинхронизацииЗеркал", ",") Цикл
		Поиск.Подключить(КаталогЗеркал, Имя);
	КонецЦикла;
	КаталогПрокси = ОбъединитьПути(КаталогМодулей, "прокси", "Классы");
	Для Каждого Имя Из СтрРазделить("СекретИсточника,ЗаведениеИсточникаСПробой,КлиентАпстрима,"
		+ "ПробникИсточника,ПричинаМолчания", ",") Цикл
		Поиск.Подключить(КаталогПрокси, Имя);
	КонецЦикла;
	КаталогWeb = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("АдресаКаталога,ДомПула,ОтветыНастроек,СборкаДомаНастроек,ОкноРаздела,"
		+ "ПредставлениеПрогонаЗеркала,ВитринаЗеркал,ПультЗеркал,ПультЗеркалПула,КонтроллерЗеркалПула,"
		+ "ЗаписьФормы,РазборФормы,ГейтФормы,ОтметкаСохранения,ИтогПульта,ТекстСбоя", ",") Цикл
		Поиск.Подключить(КаталогWeb, Имя);
	КонецЦикла;

	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Новый ФейкСервисПрав(), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Дом = Новый ДомПула(Новый СборкаДомаНастроек(UI.Кит, UI.Модели), UI.Тексты, Новый АдресаСтраниц(),
		Новый АдресаКаталога());
	Пул = Новый ПулЗаглушка(7, "owned", "custom");

КонецПроцедуры

&ПередКаждым
Процедура СобратьЭкран() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси();
	Настройки.Задать("oshub.mirror.max_per_pool", 5);
	Настройки.Задать("oshub.mirror.default_interval_sec", 3600);
	Настройки.Задать("oshub.mirror.min_interval_sec", 60);
	Настройки.Задать("oshub.mirror.run_stale_sec", 900);
	Настройки.Задать("oshub.mirror.sync_enabled", Истина);
	Настройки.Задать("oshub.mirror.queue_max", 100);
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://dead.example/download/list.txt", "Connection refused");
	Транспорт.ПриАдресе("http://alive.example/download/list.txt", 200, "alpha");
	Лог = Логирование.ПолучитьЛог("тест.oshub.экран-зеркал");
	Пробник = Новый ПробникИсточника(Новый КлиентАпстрима(Транспорт, Настройки, Лог), Настройки, Лог);

	Числа = Новый ПриведениеЧисел();
	ЧислаЗеркал = Новый ЧислаЗеркалирования(Настройки);
	Хранилище = Новый ФейкХранилищеЗеркал();
	Сервис = Новый СервисЗеркал(Хранилище, Новый ФейкСервисПрав(), Новый ВалидаторАдресаАпстрима(),
		Новый ЗаведениеИсточникаСПробой(Неопределено, Желуди(Пробник)),
		Новый ПрогонЗеркала(Хранилище, Числа, Новый ДроссельПрогресса(Числа), ЧислаЗеркал,
			Новый СчётчикиОбхода(Числа)),
		ЧислаЗеркал, Новый РазборНастроекЗеркала(ЧислаЗеркал));

	Контроллер = СобратьКонтроллер(Желуди(Пробник), Лог);

КонецПроцедуры

// Контроллер раздела над службой набора; пробники — массив-пластилин: пусто — модуля прокси нет;
// гвард без «впустить» отказывает постороннему, но несёт пул: забытая проверка дала бы мутацию.
Функция СобратьКонтроллер(Знач Пробники, Знач Лог, Знач Впустить = Истина)

	Числа = Новый ПриведениеЧисел();
	ЧислаЗеркал = Новый ЧислаЗеркалирования(Настройки);
	Защита = Новый ЗащитаCSRFЗаглушка();
	Окна = Новый ОкноРаздела(Новый ПараметрыСсылки(), Новый ОтметкаСохранения(), UI.Подтверждение);
	Общий = Новый ПультЗеркал(Новый РазборФормы(), Сервис,
		Новый ОчередьСинхронизацииЗеркал(Числа, Сервис, ЧислаЗеркал, Лог),
		Новый РазборНастроекЗеркала(ЧислаЗеркал), UI.Тексты, Новый ТекстСбоя(Новый ТекстОшибки(), UI.Тексты),
		Новый ИтогПульта());
	Пульт = Новый ПультЗеркалПула(Новый ГейтФормы(Ответы, Защита, Новый РазборФормы()),
		Новый РазборФормы(), Сервис, Общий, Числа, Новый РазборАдреса(),
		Новый ТекстСбоя(Новый ТекстОшибки(), UI.Тексты), UI.Тексты);
	Витрина = Новый ВитринаЗеркал(UI.Кит, Сервис,
		Новый ПредставлениеПрогонаЗеркала(UI.Тексты, Новый СчётчикиОбхода(Числа)), Окна, Общий,
		UI.ПоляЗеркала, Пульт, UI.Тексты, Пробники);

	Гвард = Новый ГвардПулаЗаглушка();
	Если Впустить Тогда
		Гвард.Впустить("owner1", Пул);
	Иначе
		Гвард.Отказать("stranger", Пул);
	КонецЕсли;
	Возврат Новый КонтроллерЗеркалПула(Гвард, Защита, Ответы, Дом, Витрина, Неопределено, Пульт,
		Окна, Новый ПараметрыСсылки());

КонецФункции

#Область ОкноПоАдресу

// Вкладка называет раздел, дом и пул — одной дверью дома: две вкладки разных разделов и пулов различимы.
&Тест
Процедура ВкладкаНазываетРазделДомИПул() Экспорт

	Титул = Между(Получить("").ТелоТекст, "<title>", "</title>");
	Ожидаем.Что(СтрНачинаетсяС(Титул, Текст("settings.pool.nav.mirrors") + " · " + Текст("settings.pool.title") + " · owned — "),
		"вкладка: " + Титул).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Титул, Текст("settings.pool.title")), "заголовок дома ровно один").Равно(1);

КонецПроцедуры

&Тест
Процедура ОкноНовогоЗеркалаПоАдресуОткрытоИПереносСнят() Экспорт

	Открытые = ОткрытыеОкна(Получить("новый").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по ?окно=новый открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно заведения").Содержит(Текст("settings.pool.mirrors.window.new"));
	Ожидаем.Что(Новый ФлажокВРазметке().Тег(Открытые[0], "перенос"), "флажок переноса — флажок")
		.Содержит("type=""checkbox""");
	Ожидаем.Что(Новый ФлажокВРазметке().Отмечен(Открытые[0], "перенос"),
		"по умолчанию флажок снят: обычное зеркало не переносит").ЭтоЛожь();
	Ожидаем.Что(Открытые[0], "протокол человек не выбирает").Не_().Содержит("name=""режим""");

	// КОНТРОЛЬ: без адреса окно на странице есть, но закрыто
	Страница = Получить("").ТелоТекст;
	Ожидаем.Что(Страница, "окно заведения на странице").Содержит("id=""zerkalo-novoe""");
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "и закрыто").Равно(0);

КонецПроцедуры

// Со страницы пустого пула человек приходит с решением перевезти: окно открыто, флажок отмечен.
&Тест
Процедура ПараметрMigrateОткрываетОкноСОтмеченнымПереносом() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, "owned", Новый Соответствие(), Неопределено, "GET", "", "", "1");

	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно заведения открыто").Равно(1);
	Ожидаем.Что(Новый ФлажокВРазметке().Отмечен(Открытые[0], "перенос"), "флажок переноса отмечен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОкноПравкиПоАдресуНазываетЗеркалоИУходитНаSave() Экспорт

	Номер = Завести("http://alive.example/download/");

	Открытые = ОткрытыеОкна(Получить("изменить-" + Номер).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто ровно одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "окно называет адрес зеркала").Содержит("http://alive.example/download/");
	Ожидаем.Что(Открытые[0], "форма окна уходит на правку этого зеркала")
		.Содержит("action=""/pools/owned/settings/mirrors/" + Номер + "/save""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""токен"""), "в окне поле токена").Заполнено();

	Для Каждого Окно Из СтрРазделить("изменить-999,токен-" + Номер + ",зачем-" + Номер, ",") Цикл
		Ожидаем.Что(ОткрытыеОкна(Получить(Окно).ТелоТекст).Количество(), "?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЗаписьВедётМенюКОкнамПоАдресуИСинхронизацииФормой() Экспорт

	Номер = Завести("http://alive.example/download/");

	Запись = ЗаписьРеестра(Получить("").ТелоТекст, "alive.example");
	Ожидаем.Что(Запись, "запись зеркала в реестре").Заполнено();
	Для Каждого Вид Из СтрРазделить("изменить,удалить", ",") Цикл
		Ожидаем.Что(Запись, "в наборе действий — окно «" + Вид + "» по адресу").Содержит(АдресОкна(Вид + "-" + Номер));
	КонецЦикла;
	Ожидаем.Что(Запись, "у анонимного зеркала снимать токен нечего").Не_().Содержит(АдресОкна("токен-" + Номер));
	Ожидаем.Что(Запись, "синхронизация — форма заявки")
		.Содержит("action=""/pools/owned/settings/mirrors/" + Номер + "/sync""");
	Ожидаем.Что(Запись, "тумблер — форма переключения")
		.Содержит("action=""/pools/owned/settings/mirrors/" + Номер + "/toggle""");
	Форма = Сред(Запись, СтрНайти(Запись, "action=""/pools/owned/settings/mirrors/" + Номер + "/toggle"""));
	Форма = Лев(Форма, СтрНайти(Форма, "</form>"));
	Ожидаем.Что(СтрЧислоВхождений(Форма, "type=""submit"""), "без скрипта тумблер шлёт одна кнопка").Равно(1);
	Ожидаем.Что(Форма, "запасная кнопка кита").Содержит("toggle__save");
	Ожидаем.Что(Запись, "протокол назван словом")
		.Содержит(Экранировать("settings.pool.mirrors.protocol.unknown"));

КонецПроцедуры

#КонецОбласти

#Область Заведение

&Тест
Процедура ОтказПробыЛожитсяПодПолеАдресаИМаскиНаМесте() Экспорт

	Ответ = Отправить("", "url=http://dead.example/download/&фильтр=corp-*, mylib&интервал=600&токен=sekret-x");

	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Больше(399);
	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Меньше(500);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно «Новое зеркало» открыто").Равно(1);
	ПолеАдреса = Тег(Открытые[0], "input", "name=""url""");
	Ожидаем.Что(ПолеАдреса, "поле адреса помечено негодным").Содержит("aria-invalid=""true""");
	Ожидаем.Что(ПолеАдреса, "набранный адрес на месте").Содержит("value=""http://dead.example/download/""");
	Ожидаем.Что(Открытые[0], "набранные маски на месте").Содержит("mylib");
	Ожидаем.Что(Ответ.ТелоТекст, "набранный токен обратно не печатается").Не_().Содержит("sekret-x");
	Ожидаем.Что(Сервис.СписокПула(Пул.Идентификатор).Количество(), "зеркало не заведено").Равно(0);

КонецПроцедуры

&Тест
Процедура НецелыйИнтервалОтбиваетсяУСвоегоПоля() Экспорт

	Ответ = Отправить("", "url=http://alive.example/download/&интервал=час");

	Ожидаем.Что(Ответ.Код, "отказ — 400").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""интервал"""), "поле интервала помечено негодным")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Сервис.СписокПула(Пул.Идентификатор).Количество(), "зеркало не заведено").Равно(0);

КонецПроцедуры

// Маски окно шлёт списком через запятую, домен хранит JSON-массив: доезжают те же маски.
&Тест
Процедура МаскиСпискомИПереносДоезжаютДоДомена() Экспорт

	Ответ = Отправить("", "url=http://alive.example/download/&фильтр=corp-*, mylib, corp-*&интервал=&перенос=1");

	Ожидаем.Что(Ответ.Код, "удача — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой сохранения")
		.Равно("/pools/owned/settings/mirrors?saved=1");
	Зеркала = Сервис.СписокПула(Пул.Идентификатор);
	Ожидаем.Что(Зеркала.Количество(), "зеркало заведено").Равно(1);
	Ожидаем.Что(Зеркала[0].ФильтрJSON, "маски без повторов JSON-массивом").Равно("[""corp-*"",""mylib""]");
	Ожидаем.Что(Зеркала[0].Перенос, "перенос отмечен").ЭтоИстина();

	Запись = ЗаписьРеестра(Получить("").ТелоТекст, "alive.example");
	Ожидаем.Что(Запись, "переносящее зеркало названо в записи")
		.Содержит(Экранировать("settings.pool.mirrors.protocol.migrate"));
	Ожидаем.Что(Запись, "маски показаны кодом").Содержит("<code>mylib</code>");

КонецПроцедуры

&Тест
Процедура ОкноОбещаетПробуТолькоКогдаХабЕёДелает() Экспорт

	Настройки.Задать("oshub.upstream.probe.enabled", Истина);
	Окно = Между(Получить("").ТелоТекст, "id=""zerkalo-novoe""", "</dialog>");
	Ожидаем.Что(Окно, "с включённой пробой окно обещает подключение")
		.Содержит(Экранировать("settings.pool.mirror-new.probe.note"));

	Настройки.Задать("oshub.upstream.probe.enabled", Ложь);
	Окно = Между(Получить("").ТелоТекст, "id=""zerkalo-novoe""", "</dialog>");
	Ожидаем.Что(Окно, "выключенная проба названа в окне")
		.Содержит(Экранировать("settings.pool.mirror-new.probe.note.off"));

	// без модуля прокси пробника нет, и проба пропускается так же молча, как выключателем
	Настройки.Задать("oshub.upstream.probe.enabled", Истина);
	Контроллер = СобратьКонтроллер(Новый Массив(), Логирование.ПолучитьЛог("тест.oshub.экран-зеркал"));
	Окно = Между(Получить("").ТелоТекст, "id=""zerkalo-novoe""", "</dialog>");
	Ожидаем.Что(Окно, "без пробника окно говорит, что адрес не проверяется")
		.Содержит(Экранировать("settings.pool.mirror-new.probe.note.off"));

КонецПроцедуры

#КонецОбласти

#Область ТокенТумблерУдаление

// Токен — секрет: в разметке его нет, правка задаёт новый, пустое поле оставляет прежний.
&Тест
Процедура ПравкаТокенаЗадаётНовыйАПустоеПолеОставляет() Экспорт

	Номер = Завести("http://alive.example/download/");

	Отправить(Номер + "/save", "токен=sekret-42");
	Ожидаем.Что(Зеркало(Номер).ТокенДоступа, "новый токен задан").Равно("sekret-42");
	Ожидаем.Что(Получить("изменить-" + Номер).ТелоТекст, "значения токена в разметке нет").Не_().Содержит("sekret-42");

	Ответ = Отправить(Номер + "/save", "токен=");
	Ожидаем.Что(Ответ.Код, "пустая правка — 303").Равно(303);
	Ожидаем.Что(Зеркало(Номер).ТокенДоступа, "прежний токен остался").Равно("sekret-42");

	Запись = ЗаписьРеестра(Получить("").ТелоТекст, "alive.example");
	Ожидаем.Что(Запись, "запись говорит, что зеркало читает по токену")
		.Содержит(Экранировать("settings.pool.mirrors.access.token"));
	Ожидаем.Что(Запись, "и предлагает снять токен окном").Содержит(АдресОкна("токен-" + Номер));

	Ожидаем.Что(Отправить(Номер + "/token-off", "").Код, "снятие — 303").Равно(303);
	Ожидаем.Что(Зеркало(Номер).ТокенДоступа, "токен снят").Равно("");

КонецПроцедуры

&Тест
Процедура ТумблерМеняетСостояниеЗеркалаВДомене() Экспорт

	Номер = Завести("http://alive.example/download/");

	Ожидаем.Что(Отправить(Номер + "/toggle", "включить=0").Код, "тумблер — 303").Равно(303);
	Ожидаем.Что(Зеркало(Номер).Включено, "зеркало выключено").ЭтоЛожь();

	Отправить(Номер + "/toggle", "включить=1&включить=0");
	Ожидаем.Что(Зеркало(Номер).Включено, "зеркало включено").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УдалениеСпрашиваетЭхоИБезНегоЗеркалоЦело() Экспорт

	Номер = Завести("http://alive.example/download/");

	Ответ = Отправить(Номер + "/delete", "");
	Ожидаем.Что(Ответ.Код, "первая отправка — 303").Равно(303);
	Ожидаем.Что(РаскодироватьСтроку(Ответ.ПутьРедиректа, СпособКодированияСтроки.КодировкаURL),
		"на страницу с открытым подтверждением")
		.Равно("/pools/owned/settings/mirrors?окно=удалить-" + Номер);

	Открытые = ОткрытыеОкна(Получить("удалить-" + Номер).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "эхо ждёт узел адреса").Содержит("placeholder=""alive.example""");

	Неверно = Отправить(Номер + "/delete", "confirmed=1&зеркало=чужое");
	Ожидаем.Что(Неверно.Код, "неверное эхо — 400").Равно(400);
	Ожидаем.Что(Тег(ОткрытыеОкна(Неверно.ТелоТекст)[0], "input", "name=""зеркало"""),
		"эхо-поле помечено негодным").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Зеркало(Номер), "зеркало цело").Существует();

	Верно = Отправить(Номер + "/delete", "confirmed=1&зеркало=alive.example");
	Ожидаем.Что(Верно.Код, "верное эхо — 303").Равно(303);
	Ожидаем.Что(Зеркало(Номер), "зеркала нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗаявкаНаСинхронизациюВедётНаЭкранСостояния() Экспорт

	Номер = Завести("http://alive.example/download/");

	Ответ = Отправить(Номер + "/sync", "");
	Ожидаем.Что(Ответ.Код, "заявка — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на экран состояния с итогом заявки")
		.Равно("/pools/owned/settings/mirrors/" + Номер + "?sync=1");

	Пропавшее = Отправить("999/sync", "");
	Ожидаем.Что(Пропавшее.Код, "заявка на несуществующее — 404").Равно(404);
	Ожидаем.Что(Пропавшее.ТелоТекст, "причина названа тостом").Содержит("toast--err");

КонецПроцедуры

#КонецОбласти

#Область Право

// Право мейнтейнера пула держит гвард каждого адреса: посторонний ничего не меняет ни одной формой.
&Тест
Процедура ПостороннийНиОднойФормойЗеркалаНеМеняет() Экспорт

	Номер = Завести("http://alive.example/download/");
	Лог = Логирование.ПолучитьЛог("тест.oshub.экран-зеркал");
	Контроллер = СобратьКонтроллер(Новый Массив(), Лог, Ложь);

	Отправить("", "url=http://second.example/download/&интервал=600");
	Отправить(Номер + "/save", "токен=чужой");
	Отправить(Номер + "/toggle", "включить=0");
	Отправить(Номер + "/delete", "confirmed=1&зеркало=alive.example");

	Ожидаем.Что(Сервис.СписокПула(Пул.Идентификатор).Количество(), "нового зеркала нет").Равно(1);
	Ожидаем.Что(Зеркало(Номер), "зеркало не удалено").Существует();
	Ожидаем.Что(Зеркало(Номер).Включено, "зеркало не выключено").ЭтоИстина();
	Ожидаем.Что(Зеркало(Номер).ТокенДоступа, "токен не задан").Равно("");

	// КОНТРОЛЬ: впущенный той же формой зеркало удаляет
	Контроллер = СобратьКонтроллер(Новый Массив(), Лог);
	Отправить(Номер + "/delete", "confirmed=1&зеркало=alive.example");
	Ожидаем.Что(Зеркало(Номер), "КОНТРОЛЬ: впущенный удаляет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Зеркало прямо через службу; номер — строкой, как он стоит в адресе.
Функция Завести(Знач Url)
	Возврат Формат(Сервис.Создать(Владелец(), Пул, Url).Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция Зеркало(Знач Номер)
	Возврат Сервис.ЗеркалоПула(Пул, Число(Номер));
КонецФункции

Функция Владелец()
	Возврат Новый Структура("Логин, Идентификатор, Админ", "owner1", 1, Истина);
КонецФункции

Функция Получить(Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, "owned", Новый Соответствие(), Неопределено, "GET", "", "", "", Окно);
	Возврат Ответ;
КонецФункции

// POST формы раздела: "" — заведение, «<номер>/<действие>» — форма зеркала.
Функция Отправить(Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Заголовки = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Контроллер.Раздел(Ответ, "owned", Заголовки, Неопределено, "POST", ТелоФормы);
		Возврат Ответ;
	КонецЕсли;

	Части = СтрРазделить(Хвост, "/");
	Номер = Части[0];
	Действие = Части[1];
	Если Действие = "save" Тогда
		Контроллер.Сохранение(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	ИначеЕсли Действие = "toggle" Тогда
		Контроллер.Переключение(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	ИначеЕсли Действие = "token-off" Тогда
		Контроллер.СнятиеТокена(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	ИначеЕсли Действие = "sync" Тогда
		Контроллер.Синхронизация(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	Иначе
		Контроллер.Удаление(Ответ, "owned", Номер, Заголовки, Неопределено, "POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция АдресОкна(Знач Значение)
	Возврат "href=""/pools/owned/settings/mirrors?" + Закодировать("окно") + "=" + Закодировать(Значение) + """";
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пункт реестра зеркала: от <li class="entry"> с его адресом в сводке до следующего пункта.
Функция ЗаписьРеестра(Знач HTML, Знач ЧастьАдреса)

	Для Каждого Пункт Из Куски(HTML, "<li class=""entry""") Цикл
		Если СтрНайти(Лев(Пункт, СтрНайти(Пункт + "</summary>", "</summary>")), ЧастьАдреса) > 0 Тогда
			Возврат Пункт;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Текст(Знач Ключ)
	Возврат UI.Тексты.Текст(Ключ);
КонецФункции

// Текст из словаря, как его печатает страница: сторож стережёт, КАКОЙ текст, а не его редакцию.
Функция Экранировать(Знач Ключ)
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст(Ключ));
КонецФункции

// Массив-пластилин ОСени: пусто означает «желудя в контейнере нет».
Функция Желуди(Знач Желудь)
	Результат = Новый Массив();
	Если Желудь <> Неопределено Тогда
		Результат.Добавить(Желудь);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
