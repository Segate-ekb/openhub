// Адреса разделов «Участники» и «Связка с OIDC» дома «Группа» в настоящем маршрутизаторе winow:
// литералы members и oidc перекрывают шаблон раздела дома на том же уровне, поэтому куда уходит
// каждый адрес — стережёт таблица маршрутов, а не вызов метода контроллера.

#Использовать asserts
#Использовать "../фикстуры"

Перем Маршруты;   // фикстура МаршрутыХаба — таблица маршрутов хаба в маршрутизаторе winow

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("МаршрутыХаба");
КонецПроцедуры

&ПередВсеми
Процедура СобратьМаршруты() Экспорт
	Маршруты = Новый МаршрутыХаба(КаталогиПроекта.Модули());
КонецПроцедуры

// Состав: страница раздела (окна по адресу ?окно=…) и дверь «Убрать из группы».
&Тест
Процедура АдресаУчастниковУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик(Дом() + "/members", "Участники", "КонтроллерДомаГруппы");
	ПроверитьОбработчик(Дом() + "/members/alice/delete", "УдалениеУчастника", "КонтроллерДомаГруппы");
	ПроверитьОбработчик(Дом() + "/members/a.li-ce/delete", "УдалениеУчастника", "КонтроллерДомаГруппы");

КонецПроцедуры

// Связка: страница раздела, дверь удаления сопоставления и тумблер политики.
&Тест
Процедура АдресаСвязкиУходятСвоимТочкам() Экспорт

	ПроверитьОбработчик(Дом() + "/oidc", "Связка", "КонтроллерДомаГруппы");
	ПроверитьОбработчик(Дом() + "/oidc/3/delete", "УдалениеСопоставления", "КонтроллерДомаГруппы");
	ПроверитьОбработчик(Дом() + "/oidc/policy", "Политика", "КонтроллерДомаГруппы");

КонецПроцедуры

// КОНТРОЛЬ: литералы members и oidc не перехватили шаблон остальных разделов дома.
&Тест
Процедура ШаблонРазделаДомаНеЗадет() Экспорт

	ПроверитьОбработчик(Дом(), "Обзор", "КонтроллерДомаГруппы");
	ПроверитьОбработчик(Дом() + "/grants", "Раздел", "КонтроллерДомаГруппы");
	ПроверитьОбработчик(Дом() + "/nope", "Раздел", "КонтроллерДомаГруппы");

КонецПроцедуры

Функция Дом()
	Возврат "/groups/platform/settings";
КонецФункции

Процедура ПроверитьОбработчик(Знач Путь, Знач Метод, Знач Контроллер)

	Обработчик = Маршруты.Обработчик(Путь);
	Ожидаем.Что(Обработчик <> Неопределено, "адрес обслуживается: " + Путь).ЭтоИстина();
	Ожидаем.Что(Обработчик.Контроллер, "контроллер адреса " + Путь).Равно(Контроллер);
	Ожидаем.Что(Обработчик.Метод, "точка маршрута адреса " + Путь).Равно(Метод);

КонецПроцедуры
