// Раздел «Вид и язык» дома «Аккаунт»: выбор печатается по cookie оформления, сегменты уходят
// сразу, а значение cookie из формы пропускает только то, что кит готов напечатать.

#Использовать asserts
#Использовать "../фикстуры"

Перем UI;       // СборкаUI — граф компонентов интерфейса
Перем Витрина;  // ВитринаВидаИЯзыка

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Собрать() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("КукиЗаглушка");
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули"), "интерфейс", "Классы");
	UI = Новый СборкаUI().Собрать(КаталогКлассов);
	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(КаталогКлассов, "ВитринаВидаИЯзыка");
	Поиск.Подключить(КаталогКлассов, "РазборФормы");
	Витрина = Новый ВитринаВидаИЯзыка(UI.Кит, UI.Оформление, UI.Токены, UI.Тексты);

КонецПроцедуры

&Тест
Процедура ВыборПечатаетсяПоCookieОформления() Экспорт

	Страница = Раздел("тема=светлая&акцент=%234f86f7&плотность=0.6&радиус=1.9");

	Ожидаем.Что(Отмечено(Страница, "тема"), "тема из cookie").Равно("светлая");
	Ожидаем.Что(Отмечено(Страница, "плотность"), "плотность ниже обычной — компактно").Равно("0.75");
	Ожидаем.Что(Отмечено(Страница, "радиус"), "радиус выше обычного — больше").Равно("1.5");
	Ожидаем.Что(Тег(Страница, "input", "swatches__code"), "акцент — код в поле цвета")
		.Содержит("value=""#4f86f7""");
	Ожидаем.Что(Страница, "акцент — образцами").Содержит("data-swatches");
	Для Каждого Образец Из UI.Токены.ОбразцыАкцента() Цикл
		Ожидаем.Что(Страница, "образец " + Образец.Цвет + " — палитра кита").Содержит("value=""" + Образец.Цвет + """");
		Ожидаем.Что(Страница, "и назван словом словаря").Содержит(UI.Тексты.Текст(Образец.Ключ));
	КонецЦикла;
	Ожидаем.Что(Страница, "имена образцов — не маркеры ключей").ЭтоНе().Содержит("[?");

	// КОНТРОЛЬ: без cookie — тема по умолчанию и обычные шаги
	БезКуки = Раздел("");
	Ожидаем.Что(Отмечено(БезКуки, "тема"), "без cookie — тёмная").Равно("тёмная");
	Ожидаем.Что(Отмечено(БезКуки, "плотность"), "без cookie — обычно").Равно("1");
	Ожидаем.Что(Отмечено(БезКуки, "радиус"), "без cookie — обычно").Равно("1");

КонецПроцедуры

&Тест
Процедура СегментыСохраняютсяСразуАЯзыкаНет() Экспорт

	Страница = Раздел("");

	Для Каждого Имя Из СтрРазделить("тема,плотность,радиус", ",") Цикл
		Ожидаем.Что(Тег(Страница, "input", "name=""" + Имя + """"), "«" + Имя + "» уходит сразу")
			.Содержит("data-autosubmit");
	КонецЦикла;
	Ожидаем.Что(Тег(Страница, "form", "action=""/me/settings/appearance"""), "форма уходит в фоне")
		.Содержит("data-quiet");
	Ожидаем.Что(Тег(Страница, "button", "type=""submit"""), "кнопка — для акцента и для страницы без скрипта")
		.Содержит("type=""submit""");
	// язык один — выбирать нечего, и пункта без содержимого нет
	Ожидаем.Что(СтрНайти(Страница, "name=""язык"""), "сегмента языка нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗначениеCookieПропускаетТолькоДопустимое() Экспорт

	Ожидаем.Что(Значение("тема=светлая&акцент=%23e5484d&плотность=1.25&радиус=0.5"), "годное — как есть")
		.Равно("тема=светлая&акцент=#e5484d&плотность=1.25&радиус=0.5");
	Ожидаем.Что(Значение("тема=" + Закодировать("<x>") + "&акцент=" + Закодировать("red;}")
		+ "&плотность=9&радиус=" + Закодировать("1;x")), "чужое не проходит")
		.Равно("тема=тёмная&акцент=&плотность=1&радиус=1");
	Ожидаем.Что(Значение(""), "пустая форма — умолчания").Равно("тема=тёмная&акцент=&плотность=1&радиус=1");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Раздел(Знач Cookie)

	Куки = Новый КукиЗаглушка();
	Если ЗначениеЗаполнено(Cookie) Тогда
		Куки.Добавить(UI.Оформление.ИмяCookie(), Cookie);
	КонецЕсли;
	Дом = UI.Кит.ДомНастроек("Аккаунт", "/me/settings", "т0кен", Витрина.Секция(Куки));
	Дом.Раздел("Вид и язык", "appearance").Текущий();
	Возврат Дом.Рендер();

КонецФункции

Функция Значение(Знач Тело)
	Разбор = Новый РазборФормы();
	Возврат Витрина.ЗначениеCookie(Разбор.Разобрать(Тело), Разбор);
КонецФункции

// Значение отмеченной радиокнопки группы.
Функция Отмечено(Знач HTML, Знач Имя)

	Для Каждого Кусок Из Куски(HTML, "<input ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, "name=""" + Имя + """") > 0 И СтрНайти(Тег_, " checked") > 0 Тогда
			Возврат Между(Тег_, "value=""", """");
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
