// Разделы «Теги» домов пула и пакета на механизме «⚙ записи + окно по адресу + подтверждение»:
// окно по ?окно=…, отбитая форма в открытом окне, проба правила, удаление через подтверждение,
// тумблер наследования, унаследованный тег, визард каналов — настоящими контроллерами поверх
// настоящих служб тегов в контейнере.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Засев;         // ЗасевРеестра — пул, пакет и версии службами хаба
Перем КореньХранилища;
Перем ГвардПула;     // ГвардПулаЗаглушка
Перем ГвардПакета;   // ГвардПакетаЗаглушка
Перем КонтроллерПула;   // КонтроллерТеговПула
Перем КонтроллерПакета; // КонтроллерТеговПакета
Перем Права_;           // ФейкСервисПрав — кто администрирует пул (ссылки «изменить в пуле»)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(Модули, "вход, зеркала, права, подписки, публикация, статистика");
	ПоискКлассов.ПодключитьРеализации(Модули, "ПоследствияУдаленияПакета, ПоследствияУдаленияПула");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "настройки", "Классы"));
	РеестрНастроекХаба.ПодключитьКлассы(ПоискКлассов, Модули);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "аудит", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ГотовностьХаба");

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	Для Каждого Имя Из СтрРазделить("ОкноРаздела,ОтметкаСохранения,ПоляТега,ОкноТега,КонструкторТега,"
		+ "ВыборОформленияТега,ПлашкаТега,ОформлениеТега,ВитринаТеговПула,ПультТеговПула,КонтроллерТеговПула,"
		+ "ВитринаТеговПакета,ПультТеговПакета,КонтроллерТеговПакета,ОкноКаналовПоУмолчанию,СоставКаналаТега,"
		+ "ОтветыНастроек,СборкаДомаНастроек,ДомПула,ДомПакета,АдресаКаталога,ГейтФормы,РазборФормы,ТекстСбоя",
		",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

	РеестрФикстур.Подключить("ЖурналАудитаФайлом");
	РеестрФикстур.Подключить("ГвардПулаЗаглушка");
	РеестрФикстур.Подключить("ГвардПакетаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ПорогРазделаПакетаЗаглушка");

	Детальки = Новый Соответствие();
	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-screen-tags");
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-тегов-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();
	Засев = Новый ЗасевРеестра(Поделка);

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(Интерфейс);
	Права = Новый ФейкСервисПрав();
	Права_ = Права;
	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Сборка, Права, UI.Тексты, Новый МетодыHTTP(),
		Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	ДомПула = Новый ДомПула(Сборка, UI.Тексты, Новый АдресаСтраниц(), Новый АдресаКаталога());
	Порог = Новый ПорогРазделаПакетаЗаглушка(Ложь);
	ДомПакета = Новый ДомПакета(Сборка, ДомПула, Порог, Порог, UI.Тексты, Новый АдресаСтраниц());

	ГвардПула = Новый ГвардПулаЗаглушка();
	ГвардПакета = Новый ГвардПакетаЗаглушка();
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));

	ПультПула = Новый ПультТеговПула(Гейт, Желудь("РазборФормы"), Желудь("СервисТеговПула"),
		Желудь("СервисТегов"), Желудь("КонструкторТега"), Желудь("ПоляТега"), Желудь("ТекстСбоя"),
		Желудь("ТекстыИнтерфейса"));
	ВитринаПула = Новый ВитринаТеговПула(Желудь("Кит"), Желудь("СервисТеговПула"), Желудь("КонструкторТега"),
		Желудь("ОкноРаздела"), Желудь("ОкноТега"), Желудь("ПоляТега"), Желудь("ПлашкаТега"),
		Желудь("ТекстыИнтерфейса"), Желудь("ПараметрыСсылки"));
	КонтроллерПула = Новый КонтроллерТеговПула(ГвардПула, Ответы, ДомПула, ВитринаПула, ПультПула, Защита,
		Желудь("ОкноРаздела"), Желудь("СервисПулов"));

	ПультПакета = Новый ПультТеговПакета(Гейт, Желудь("РазборФормы"), Желудь("СервисТегов"),
		Желудь("ПроисхождениеТега"), Желудь("КаналыПоУмолчанию"), Желудь("ОкноКаналовПоУмолчанию"),
		Желудь("КонструкторТега"), Желудь("ПоляТега"), Желудь("ТекстСбоя"), Желудь("ТекстыИнтерфейса"));
	ВитринаПакета = Новый ВитринаТеговПакета(Желудь("Кит"), Желудь("СервисТегов"), Желудь("ПроисхождениеТега"),
		Права, ДомПула, Желудь("КонструкторТега"), Желудь("ОкноРаздела"), Желудь("ОкноТега"),
		Желудь("ОкноКаналовПоУмолчанию"), Желудь("ПоляТега"), Желудь("ПлашкаТега"), Желудь("ПараметрыСсылки"),
		Желудь("ТекстыИнтерфейса"));
	КонтроллерПакета = Новый КонтроллерТеговПакета(ГвардПакета, Ответы, ДомПакета, ВитринаПакета, ПультПакета,
		Желудь("СоставКаналаТега"), Защита, Желудь("ОкноРаздела"), Желудь("СервисПакетов"),
		Желудь("ТекстыИнтерфейса"), Желудь("ПоляТега"));

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

#Область ТегиПула

// Галка выключена — набора нет и окон тегов пула тоже: тумблер меняет домен в обе стороны.
&Тест
Процедура ТумблерПулаМеняетНаследованиеВДомене() Экспорт

	Пул = Засев.ПулСервисом();
	ВпуститьВПул(Пул);
	Ожидаем.Что(ОткрытыеОкна(ПолучитьПул(Пул, "новый").ТелоТекст).Количество(),
		"без галки окна тега пула нет").Равно(0);
	Ожидаем.Что(ПолучитьПул(Пул, "").ТелоТекст, "без скрипта форму галки отправляет запасная кнопка кита")
		.Содержит("toggle__save");

	Ответ = ОтправитьПул(Пул, "", "операция=теги_пула&теги_пула=1&теги_пула=0");
	Ожидаем.Что(Ответ.Код, "тумблер — 303 на раздел").Равно(303);
	Ожидаем.Что(ТегиПула().НаследованиеВключено(ПулПоИд(Пул)), "галка включена").ЭтоИстина();
	Ожидаем.Что(ТегиПула().ТегиПула(Пул.Идентификатор).Количество(), "набор заполнен каналами визарда").Равно(3);

	Страница = ПолучитьПул(Пул, "").ТелоТекст;
	Ожидаем.Что(Страница, "запись тега пула ведёт к окну правки по адресу")
		.Содержит(АдресОкна("/pools/" + Пул.Имя + "/settings/tags", "изменить-stable"));

	ОтправитьПул(Пул, "", "операция=теги_пула&теги_пула=0");
	Ожидаем.Что(ТегиПула().НаследованиеВключено(ПулПоИд(Пул)), "галка снята").ЭтоЛожь();
	Ожидаем.Что(ТегиПула().ТегиПула(Пул.Идентификатор).Количество(), "набор хранится").Равно(3);

КонецПроцедуры

&Тест
Процедура ОкноПравкиТегаПулаПоАдресуПечатаетсяОткрытымСПолями() Экспорт

	Пул = ПулСГалкой();
	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "lts", "semver", "^1.0", "owner");

	Открытые = ОткрытыеОкна(ПолучитьПул(Пул, "изменить-lts").ТелоТекст);

	Ожидаем.Что(Открытые.Количество(), "открыто ровно одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "форма окна уходит на правку этого тега")
		.Содержит("action=""/pools/" + Пул.Имя + "/settings/tags/lts/save""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""правило_semver"""), "выражение тега в поле своего вида")
		.Содержит("value=""^1.0""");
	Ожидаем.Что(СтрНайти(Открытые[0], "name=""manual"""), "у тега пула нет ручного вида").Равно(0);
	Ожидаем.Что(СтрНайти(Открытые[0], "value=""manual"""), "у тега пула нет ручного вида").Равно(0);

	// КОНТРОЛЬ: окно нового тега стоит на странице закрытым, кнопка к нему — ссылка на ?окно=новый
	Страница = ПолучитьПул(Пул, "").ТелоТекст;
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "без ?окно= окна закрыты").Равно(0);
	Ожидаем.Что(Страница, "окно нового тега на странице").Содержит("id=""teg-pula-novyi""");
	Ожидаем.Что(Страница, "кнопка «Новый тег» ведёт на окно без скрипта")
		.Содержит("data-opens=""teg-pula-novyi""");

КонецПроцедуры

&Тест
Процедура ОтбитыйТегПулаВозвращаетОткрытоеОкноСНабранным() Экспорт

	Пул = ПулСГалкой();

	Ответ = ОтправитьПул(Пул, "", "имя=Плохое имя&вид=semver&правило_semver=^2.0&стиль=plain&значок=");
	Ожидаем.Что(Ответ.Код, "отказ — 4xx").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно нового тега открыто").Равно(1);
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""имя"""), "имя помечено негодным").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""имя"""), "набранное на месте").Содержит("value=""Плохое имя""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""правило_semver"""), "выражение на месте").Содержит("value=""^2.0""");

	Негодное = ОтправитьПул(Пул, "", "имя=rx&вид=regex&правило_regex=(&стиль=plain&значок=");
	Ожидаем.Что(Негодное.Код, "негодное выражение — 4xx").Равно(400);
	Ожидаем.Что(Тег(ОткрытыеОкна(Негодное.ТелоТекст)[0], "input", "name=""правило_regex"""),
		"отказ под полем выражения").Содержит("aria-invalid=""true""");
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "rx"), "тег не заведён").Равно(Неопределено);

	Ручной = ОтправитьПул(Пул, "", "имя=hand&вид=manual&стиль=plain&значок=");
	Ожидаем.Что(Ручной.Код, "ручной вид у пула отбит").Равно(400);
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "hand"), "ручной тег пула не заведён").Равно(Неопределено);

	// КОНТРОЛЬ: годный тег заводится и ведёт на раздел
	Годный = ОтправитьПул(Пул, "", "имя=lts&вид=semver&правило_semver=^1.0&стиль=stable&значок=lock"
		+ "&по_умолчанию=0&запрет_перезаписи=1&запрет_перезаписи=0");
	Ожидаем.Что(Годный.Код, "удача — 303").Равно(303);
	ТегПула = ТегиПула().НайтиТегПула(Пул.Идентификатор, "lts");
	Ожидаем.Что(ТегПула.Правило, "правило записано").Равно("^1.0");
	Ожидаем.Что(ТегПула.Стиль, "стиль записан").Равно("stable");

КонецПроцедуры

&Тест
Процедура УдалениеТегаПулаСпрашиваетЭхоИмени() Экспорт

	Пул = ПулСГалкой();

	Без = ОтправитьПул(Пул, "stable/delete", "тег=stable");
	Ожидаем.Что(Без.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(Без.ПутьРедиректа), "на окно подтверждения")
		.Равно("/pools/" + Пул.Имя + "/settings/tags?окно=удалить-stable");
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable"), "тег цел").Существует();
	Ожидаем.Что(ОткрытыеОкна(ПолучитьПул(Пул, "удалить-stable").ТелоТекст)[0], "эхо ждёт имя тега")
		.Содержит("pattern=""stable""");

	Неверно = ОтправитьПул(Пул, "stable/delete", "confirmed=1&тег=чужое");
	Ожидаем.Что(Неверно.Код, "неверное эхо — 400").Равно(400);
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable"), "тег цел").Существует();

	Верно = ОтправитьПул(Пул, "stable/delete", "confirmed=1&тег=stable");
	Ожидаем.Что(Верно.Код, "верное эхо — 303").Равно(303);
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable"), "тега нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НеизвестноеОкноДаётСтраницуБезОкна() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");

	Для Каждого Окно Из СтрРазделить("изменить-нет,зачем-stable,удалить,вернуть-stable", ",") Цикл
		Ожидаем.Что(ОткрытыеОкна(ПолучитьПул(Пул, Окно).ТелоТекст).Количество(),
			"пул, ?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;
	// у тега пула без копии у пакета нечего удалять и нечего возвращать
	Для Каждого Окно Из СтрРазделить("удалить-stable,вернуть-stable,каналы,изменить-нет", ",") Цикл
		Страница = ПолучитьПакет(Пакет, Окно);
		Ожидаем.Что(Страница.Код, "пакет, ?окно=" + Окно + " — страница раздела").Равно(200);
		Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "пакет, ?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПроверкаИмениДоОтправкиСудитКакСервер() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.4.0");
	ВпуститьВПакет(Пул, Пакет);

	Занято = Новый ОтветСтраницыЗаглушка();
	КонтроллерПакета.Раздел(Занято, Пул.Имя, Пакет.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "",
		"", "", "", "", "имя", "1.4.0");
	Ожидаем.Что(Занято.Код, "имя, занятое версией, — 409").Равно(409);
	Ожидаем.Что(Занято.ТелоТекст, "с причиной словами").Содержит("версией");

	Есть = Новый ОтветСтраницыЗаглушка();
	КонтроллерПакета.Раздел(Есть, Пул.Имя, Пакет.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "",
		"", "", "", "", "имя", "stable");
	Ожидаем.Что(Есть.Код, "имя заведённого тега — 409").Равно(409);

	Правило = Новый ОтветСтраницыЗаглушка();
	КонтроллерПакета.Раздел(Правило, Пул.Имя, Пакет.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "",
		"", "", "", "", "правило", "", "", "(");
	Ожидаем.Что(Правило.Код, "негодное выражение — 409").Равно(409);

	Свободно = Новый ОтветСтраницыЗаглушка();
	КонтроллерПакета.Раздел(Свободно, Пул.Имя, Пакет.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "",
		"", "", "", "", "имя", "nightly");
	Ожидаем.Что(Свободно.Код, "свободное имя — 200").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Вкладка

// Вкладку раздела тегов называет одна дверь дома: раздел, дом и объект — у пула и у пакета.
&Тест
Процедура ВкладкиТеговПулаИПакетаНазываютРазделДомИОбъект() Экспорт

	Тексты = Желудь("ТекстыИнтерфейса");
	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0");

	Ожидаем.Что(Титул(ПолучитьПул(Пул, "")), "вкладка тегов пула").Равно(Тексты.Текст("settings.pool.nav.tags")
		+ " · " + Тексты.Текст("settings.pool.title") + " · " + Пул.Имя);
	Ожидаем.Что(Титул(ПолучитьПакет(Пакет, "")), "вкладка тегов пакета").Равно(
		Тексты.Текст("settings.package.nav.tags") + " · " + Тексты.Текст("settings.package.title") + " · " + Пакет.Имя);

КонецПроцедуры

// Имя вкладки без знака хаба, который каркас дописывает через тире.
Функция Титул(Знач Ответ)

	Начало = СтрНайти(Ответ.ТелоТекст, "<title>") + СтрДлина("<title>");
	Титул = Сред(Ответ.ТелоТекст, Начало, СтрНайти(Ответ.ТелоТекст, "</title>") - Начало);
	Тире = СтрНайти(Титул, " — ", НаправлениеПоиска.СКонца);
	Возврат ?(Тире = 0, Титул, Лев(Титул, Тире - 1));

КонецФункции

#КонецОбласти

#Область ТегиПакета

&Тест
Процедура ОкноПравкиТегаПакетаПоказываетСоставКанала() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0,1.1.0,2.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "one", "semver", "^1.0", "alice");

	Открытые = ОткрытыеОкна(ПолучитьПакет(Пакет, "изменить-one").ТелоТекст);

	Ожидаем.Что(Открытые.Количество(), "открыто окно правки").Равно(1);
	Ожидаем.Что(Открытые[0], "форма уходит на правку тега").Содержит("/settings/tags/one/save""");
	Ожидаем.Что(Открытые[0], "состав называет отдаваемую версию").Содержит("<code>1.1.0</code>");
	Ожидаем.Что(СтрНайти(Открытые[0], "<code>2.0.0</code>"), "чужая версия в составе не названа").Равно(0);

КонецПроцедуры

&Тест
Процедура ПробаПоказываетСоставИНичегоНеПишет() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0,1.1.0,2.0.0");

	Ответ = ОтправитьПакет(Пакет, "", "операция=проверить&имя=two&вид=semver&правило_semver=^2.0"
		+ "&стиль=plain&значок=");

	Ожидаем.Что(Ответ.Код, "проба — не запись: 422").Равно(422);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно нового тега открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "состав пробы в окне").Содержит("<code>2.0.0</code>");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""имя"""), "набранное имя на месте").Содержит("value=""two""");
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "two"), "тег не заведён").Равно(Неопределено);

	Запись = ОтправитьПакет(Пакет, "", "имя=two&вид=semver&правило_semver=^2.0&стиль=plain&значок=");
	Ожидаем.Что(Запись.Код, "КОНТРОЛЬ: запись — 303").Равно(303);
	Ожидаем.Что(Раскодировать(Запись.ПутьРедиректа), "раздел скажет о составе записанного тега")
		.Содержит("saved_tag=two");
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "two"), "тег заведён").Существует();

КонецПроцедуры

// Состав пробы — в наборе вида, для которого её делали: сменил сегмент — кит прячет набор вместе
// с составом; без скрипта проба уходит с полем вида и всегда делается для выбранного.
&Тест
Процедура СоставПробыПринадлежитВидуПробы() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0,1.1.0,2.0.0");

	Semver = ОткрытыеОкна(ОтправитьПакет(Пакет, "", "операция=проверить&имя=kind&вид=semver"
		+ "&правило_semver=^2.0&стиль=plain&значок=").ТелоТекст);
	Ожидаем.Что(Semver.Количество(), "окно с пробой semver открыто").Равно(1);
	Ожидаем.Что(НаборВида(Semver[0], "semver"), "состав пробы — в наборе semver").Содержит("<code>2.0.0</code>");
	Для Каждого Чужой Из СтрРазделить("regex,manual", ",") Цикл
		Ожидаем.Что(НаборВида(Semver[0], Чужой), "КОНТРОЛЬ: набор «" + Чужой + "» на месте").Заполнено();
		Ожидаем.Что(СтрНайти(НаборВида(Semver[0], Чужой), "Отдаёт"), "в наборе «" + Чужой + "» состава нет")
			.Равно(0);
	КонецЦикла;
	Ожидаем.Что(СтрЧислоВхождений(Semver[0], "Отдаёт"), "состав в окне один — в наборе semver").Равно(1);

	// без скрипта переключение уходит с пробой: проба regex кладёт свой состав в свой набор
	Regex = ОткрытыеОкна(ОтправитьПакет(Пакет, "", "операция=проверить&имя=kind&вид=regex"
		+ "&правило_semver=^2.0&правило_regex=^1\.0\..*$&стиль=plain&значок=").ТелоТекст);
	Ожидаем.Что(НаборВида(Regex[0], "regex"), "состав пробы — в наборе regex").Содержит("<code>1.0.0</code>");
	Ожидаем.Что(СтрНайти(НаборВида(Regex[0], "semver"), "Отдаёт"), "у semver состава нет").Равно(0);

	// у ручного тега состава нет вовсе: проба «вручную» окно без состава
	Ручной = ОткрытыеОкна(ОтправитьПакет(Пакет, "", "операция=проверить&имя=kind&вид=manual"
		+ "&правило_semver=^2.0&стиль=plain&значок=").ТелоТекст);
	Ожидаем.Что(Ручной.Количество(), "окно с пробой «вручную» открыто").Равно(1);
	Ожидаем.Что(СтрНайти(Ручной[0], "Отдаёт"), "ни «Отдаёт» —").Равно(0);
	Ожидаем.Что(СтрНайти(Ручной[0], "Под тегом"), "ни «Под тегом»").Равно(0);
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "kind"), "проба ничего не завела").Равно(Неопределено);

КонецПроцедуры

// Состав действующего правила печатается, только пока выбран его вид: отбитая правка с другим
// видом приезжает без чужого состава, а у ручного тега его нет никогда.
&Тест
Процедура СоставДействующегоПравилаТолькоУВыбранногоВида() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0,1.1.0,2.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "one", "semver", "^1.0", "alice");
	Теги().ОпределитьРучнойТег(Пакет.Идентификатор, "hand", "alice", Новый Структура("Стиль, Значок", "plain", ""));

	Правка = ОткрытыеОкна(ПолучитьПакет(Пакет, "изменить-one").ТелоТекст);
	Ожидаем.Что(НаборВида(Правка[0], "semver"), "КОНТРОЛЬ: состав действующего правила — в наборе semver")
		.Содержит("<code>1.1.0</code>");

	Отбитая = ОтправитьПакет(Пакет, "one/save", "вид=regex&правило_semver=^1.0&правило_regex=&стиль=plain&значок=");
	Ожидаем.Что(Отбитая.Код, "пустое выражение regex отбито").Равно(400);
	Окна_ = ОткрытыеОкна(Отбитая.ТелоТекст);
	Ожидаем.Что(Окна_.Количество(), "окно правки открыто").Равно(1);
	Ожидаем.Что(СтрНайти(Окна_[0], "Отдаёт"), "состав semver при выбранном regex не печатается").Равно(0);

	Ручного = ОткрытыеОкна(ПолучитьПакет(Пакет, "изменить-hand").ТелоТекст);
	Ожидаем.Что(Ручного.Количество(), "окно правки ручного тега открыто").Равно(1);
	Ожидаем.Что(СтрНайти(Ручного[0], "Отдаёт"), "у ручного тега состава нет").Равно(0);

КонецПроцедуры

// Образец плашки зеркалит два поля окна — стиль (сегменты) и значок (сетка кита) — признаками
// (слово кита, без своего скрипта): плашка называет оба поля, печатает их сохранённые значения
// и сам сохранённый значок, оба поля стоят в той же форме. Окно правки, которое кит приносит
// из меню ⚙, — та же разметка, что по адресу.
&Тест
Процедура ОбразецПлашкиНазываетПоляСтиляИЗначка() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "look", "semver", "^1.0", "alice",
		Новый Структура("Стиль, Значок", "deprecated", "бренд:telegram"));

	Открытые = ОткрытыеОкна(ПолучитьПакет(Пакет, "изменить-look").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно правки открыто").Равно(1);
	Окно = Открытые[0];
	Плашка = Тег(Окно, "span", "data-mirrors=");
	Ожидаем.Что(Плашка, "образец плашки зеркалит поля окна").Заполнено();

	Зеркала = СтрРазделить(ЗначениеПризнака(Плашка, "data-mirrors"), " ");
	Ожидаем.Что(Зеркала.Количество(), "плашка зеркалит два поля").Равно(2);
	ПолеСтиля = Зеркала[0];
	ПолеЗначка = Зеркала[1];
	Ожидаем.Что(Тег(Окно, "input", "name=""" + ПолеСтиля + """"), "стиль — сегменты этой формы")
		.Содержит("type=""radio""");
	Ожидаем.Что(Сетка(Окно), "значок — сетка кита").Заполнено();
	Ожидаем.Что(Тег(Сетка(Окно), "input", "name=""" + ПолеЗначка + """"), "значок — радиокнопки сетки этой формы")
		.Содержит("type=""radio""");
	Ожидаем.Что(ЗначениеПризнака(Плашка, "data-mirror-" + ПолеСтиля), "напечатан сохранённый стиль")
		.Равно("deprecated");
	Ожидаем.Что(ЗначениеПризнака(Плашка, "data-mirror-" + ПолеЗначка), "напечатан сохранённый значок")
		.Равно("бренд:telegram");
	Ожидаем.Что(Между(Окно, Плашка, "</span>"), "сохранённый значок стоит в плашке образца")
		.Содержит("icon--brand");

КонецПроцедуры

// Без скрипта значок выбирается радио-сеткой кита: сохранённый отмечен, строка поиска спрятана
// (искать без скрипта нечем), «Без значка» — первой ячейкой. Каждое имя сетки домен принимает,
// и других имён у домена нет, кроме служебных значков кита (дев-сборка 10: стрелки, меню, тема,
// «бренд:key» — сетка их не предлагает, сохранённый печатается своей ячейкой): значок,
// добавленный китом, краснит этот набор, а не форму.
&Тест
Процедура СеткаЗначковОтмечаетСохранённыйИСовпадаетСоСловаремДомена() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "grid", "semver", "^1.0", "alice",
		Новый Структура("Стиль, Значок", "stable", "замок"));

	Окно = ОткрытыеОкна(ПолучитьПакет(Пакет, "изменить-grid").ТелоТекст)[0];
	Сетка_ = Сетка(Окно);
	Ожидаем.Что(Тег(Сетка_, "div", "data-iconpicker-search"), "строка поиска без скрипта спрятана")
		.Содержит("hidden");
	Ожидаем.Что(Тег(Сетка_, "input", "value=""замок"""), "сохранённый значок отмечен").Содержит("checked");
	Ожидаем.Что(Тег(Сетка_, "input", "value="""""), "«Без значка» — ячейкой сетки").Заполнено();
	Ожидаем.Что(СтрНайти(Тег(Сетка_, "input", "value="""""), "checked"), "и не отмечена").Равно(0);

	Словарь = Желудь("ЗначокТега");
	Значения = Новый Массив();
	Для Каждого Кусок Из Куски(Сетка_, "<input type=""radio""") Цикл
		Значение = ЗначениеПризнака(Лев(Кусок, СтрНайти(Кусок, ">")), "value");
		Если ЗначениеЗаполнено(Значение) Тогда
			Значения.Добавить(Значение);
			Ожидаем.Что(Словарь.Нормализовать(Значение), "домен принимает «" + Значение + "»").Равно(Значение);
		КонецЕсли;
	КонецЦикла;
	Служебные = Новый СписокЗначений();
	Для Каждого Имя Из Желудь("Иконка").СлужебныеГлифы() Цикл
		Служебные.Добавить(Имя);
	КонецЦикла;
	Для Каждого Ключ Из Желудь("РаскладкаСтатики").СлужебныеЗначки() Цикл
		Служебные.Добавить("бренд:" + Ключ);
	КонецЦикла;
	НеВСетке = Новый СписокЗначений();
	Для Каждого Имя Из Словарь.Все() Цикл
		Если Значения.Найти(Имя) = Неопределено Тогда
			НеВСетке.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Служебные.СортироватьПоЗначению();
	НеВСетке.СортироватьПоЗначению();
	Ожидаем.Что(Служебные.Количество() > 0, "КОНТРОЛЬ: у кита есть служебные значки").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(НеВСетке.ВыгрузитьЗначения(), ","), "домен сверх сетки — только служебные значки кита")
		.Равно(СтрСоединить(Служебные.ВыгрузитьЗначения(), ","));
	Ожидаем.Что(Значения.Количество(), "в сетке ровно имена домена без служебных")
		.Равно(Словарь.Все().Количество() - Служебные.Количество());
	Ожидаем.Что(Значения.Найти("бренд:telegram") <> Неопределено, "КОНТРОЛЬ: бренды в сетке есть").ЭтоИстина();

КонецПроцедуры

// Прежний ключ тега (lock, check …) в строке БД читается: в сетке отмечен значок кита по таблице
// соответствия, плашка тега печатается так же, как у тега с именем кита; сохранение окна пишет имя кита.
&Тест
Процедура ПрежнийКлючЗначкаЧитаетсяИменемКита() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "old", "semver", "^1.0", "alice",
		Новый Структура("Стиль, Значок", "stable", "lock"));
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "old").Значок, "КОНТРОЛЬ: в базе прежний ключ")
		.Равно("lock");

	Страница = ПолучитьПакет(Пакет, "изменить-old").ТелоТекст;
	Окно = ОткрытыеОкна(Страница)[0];
	Ожидаем.Что(Тег(Сетка(Окно), "input", "value=""замок"""), "в сетке отмечен «замок»").Содержит("checked");
	Ожидаем.Что(ЗначениеПризнака(Тег(Окно, "span", "data-mirrors="), "data-mirror-значок"),
		"образец зеркалит имя кита").Равно("замок");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "new", "semver", "^1.0", "alice",
		Новый Структура("Стиль, Значок", "stable", "замок"));
	Страница = ПолучитьПакет(Пакет, "").ТелоТекст;
	Замок = Желудь("Иконка").Отрисовать("замок");
	Ожидаем.Что(СтрокаТаблицы(Страница, "old"), "плашка тега с прежним ключом — глиф «замок» перед именем")
		.Содержит(Замок + "old<");
	Ожидаем.Что(СтрокаТаблицы(Страница, "new"), "и тега с именем кита — тот же глиф").Содержит(Замок + "new<");

	Ответ = ОтправитьПакет(Пакет, "old/save", "вид=semver&правило_semver=^1.0&стиль=stable&значок=замок");
	Ожидаем.Что(Ответ.Код, "сохранение — 303").Равно(303);
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "old").Значок, "окно пишет имя кита").Равно("замок");

КонецПроцедуры

// Значок — имя из закрытого списка: незнакомое имя (глифа или бренда, которого у кита нет)
// отбивается 400 над полями и ничего не пишет; знакомый бренд записывается и печатается в плашке.
&Тест
Процедура НеизвестныйЗначокОтбиваетсяБезМутации() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "own", "semver", "^1.0", "alice");
	До = СнимокТегов(Пакет);

	Для Каждого Значок Из СтрРазделить("череп;бренд:нет;../../etc/passwd", ";") Цикл
		Ответ = ОтправитьПакет(Пакет, "own/save",
			"вид=semver&правило_semver=^1.0&стиль=plain&значок=" + Закодировать(Значок));
		Ожидаем.Что(Ответ.Код, "значок «" + Значок + "» — 400").Равно(400);
		Ожидаем.Что(ОткрытыеОкна(Ответ.ТелоТекст).Количество(), "окно правки открыто с отказом").Равно(1);
		Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "own").Значок, "значок не записан").Равно("");
	КонецЦикла;
	Ожидаем.Что(ОтправитьПакет(Пакет, "", "имя=fresh&вид=manual&стиль=plain&значок=череп").Код,
		"и у нового тега — 400").Равно(400);
	Ожидаем.Что(СнимокТегов(Пакет), "теги пакета прежние").Равно(До);
	Ожидаем.Что(ОтправитьПул(Пул, "", "имя=pl&вид=semver&правило_semver=^1.0&стиль=plain&значок=бренд:нет").Код,
		"у тега пула — тоже 400").Равно(400);
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "pl"), "тег пула не заведён").Равно(Неопределено);

	// КОНТРОЛЬ: знакомый бренд пишется и печатается в плашке тега
	Годный = ОтправитьПакет(Пакет, "own/save", "вид=semver&правило_semver=^1.0&стиль=plain&значок="
		+ Закодировать("бренд:telegram"));
	Ожидаем.Что(Годный.Код, "бренд — 303").Равно(303);
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "own").Значок, "бренд записан").Равно("бренд:telegram");
	Ожидаем.Что(СтрокаТаблицы(ПолучитьПакет(Пакет, "").ТелоТекст, "own"), "логотип бренда в плашке тега")
		.Содержит(Желудь("Иконка").Отрисовать("бренд:telegram") + "own<");

КонецПроцедуры

&Тест
Процедура ИмяЗанятоеВерсиейОтбиваетсяУПоля() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0");

	Ответ = ОтправитьПакет(Пакет, "", "имя=1.0.0&вид=manual&стиль=plain&значок=");

	Ожидаем.Что(Ответ.Код, "отказ — 400").Равно(400);
	Окно = ОткрытыеОкна(Ответ.ТелоТекст)[0];
	Ожидаем.Что(Тег(Окно, "input", "name=""имя"""), "имя помечено").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Окно, "причина словами").Содержит("занято версией");
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "1.0.0"), "тег не заведён").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура УдалениеСвоегоТегаСпрашиваетЭхоИВерсииЦелы() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0,1.1.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "one", "semver", "^1.0", "alice");

	Без = ОтправитьПакет(Пакет, "one/delete", "тег=one");
	Ожидаем.Что(Без.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(Без.ПутьРедиректа), "на окно подтверждения").Содержит("?окно=удалить-one");
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "one"), "тег цел").Существует();

	Неверно = ОтправитьПакет(Пакет, "one/delete", "confirmed=1&тег=два");
	Ожидаем.Что(Неверно.Код, "неверное эхо — 400").Равно(400);
	Ожидаем.Что(Тег(ОткрытыеОкна(Неверно.ТелоТекст)[0], "input", "name=""тег"""), "эхо помечено")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "one"), "тег цел").Существует();

	Верно = ОтправитьПакет(Пакет, "one/delete", "confirmed=1&тег=one");
	Ожидаем.Что(Верно.Код, "верное эхо — 303").Равно(303);
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "one"), "тега нет").Равно(Неопределено);
	Ожидаем.Что(Желудь("СервисВерсий").ВерсииПакетаДляЧтения(Пакет.Идентификатор).Количество(),
		"версии целы").Равно(2);

КонецПроцедуры

// Тег пула у пакета не удаляется своим адресом: его правят копией, выключают и возвращают.
&Тест
Процедура УнаследованныйТегНеУдаляетсяАПравитсяКопией() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0");
	ВпуститьВПакет(Пул, Пакет);

	Строка_ = СтрокаТаблицы(ПолучитьПакет(Пакет, "").ТелоТекст, "stable");
	Ожидаем.Что(Строка_, "строка тега пула").Заполнено();
	Ожидаем.Что(СтрНайти(Строка_, Закодировать("удалить-stable")), "удаления у тега пула нет").Равно(0);
	Ожидаем.Что(Строка_, "выключение у пакета — форма").Содержит("/settings/tags/stable/disable""");

	Удаление = ОтправитьПакет(Пакет, "stable/delete", "confirmed=1&тег=stable");
	Ожидаем.Что(Удаление.Код, "удаление тега пула своим адресом — отказ").Равно(422);
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "тег пула на месте").Равно("пул");

	Копия = ОтправитьПакет(Пакет, "stable/save", "вид=semver&правило_semver=^1.0.0&стиль=plain&значок=");
	Ожидаем.Что(Копия.Код, "правка — 303").Равно(303);
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "у пакета копия").Равно("перекрывает");
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable").Правило, "тег пула не изменён")
		.Не_().Равно("^1.0.0");

	Вернуть = ОтправитьПакет(Пакет, "stable/delete", "");
	Ожидаем.Что(Раскодировать(Вернуть.ПутьРедиректа), "возврат спрашивает подтверждение")
		.Содержит("?окно=вернуть-stable");
	ОтправитьПакет(Пакет, "stable/delete", "confirmed=1");
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "снова тег пула").Равно("пул");

	ОтправитьПакет(Пакет, "stable/disable", "");
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "выключен").Равно("выключен");
	ОтправитьПакет(Пакет, "stable/enable", "");
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "включён снова").Равно("пул");

КонецПроцедуры

&Тест
Процедура ВизардЗаводитКаналыОдинРазИБольшеНеПредлагается() Экспорт

	Пакет = ПакетСВерсиями(Засев.ПулСервисом(), "1.0.0,1.1.0-rc.1");

	Страница = ПолучитьПакет(Пакет, "").ТелоТекст;
	Ожидаем.Что(Страница, "пакету без тегов визард на странице").Содержит("id=""kanaly-po-umolchaniyu""");
	Ожидаем.Что(Страница, "и кнопка к нему").Содержит("data-opens=""kanaly-po-umolchaniyu""");
	Открытые = ОткрытыеОкна(ПолучитьПакет(Пакет, "каналы").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по ?окно=каналы визард открыт").Равно(1);
	Ожидаем.Что(Открытые[0], "визард называет правила").Содержит("prerelease");

	Ответ = ОтправитьПакет(Пакет, "", "операция=каналы_по_умолчанию");
	Ожидаем.Что(Ответ.Код, "визард — 303").Равно(303);
	Ожидаем.Что(Теги().СвоиТегиПакета(Пакет.Идентификатор).Количество(), "три канала").Равно(3);

	После = ПолучитьПакет(Пакет, "каналы").ТелоТекст;
	Ожидаем.Что(СтрНайти(После, "kanaly-po-umolchaniyu"), "визард больше не предлагается").Равно(0);
	Повтор = ОтправитьПакет(Пакет, "", "операция=каналы_по_умолчанию");
	Ожидаем.Что(Повтор.Код, "повтор — не запись").Равно(409);
	Ожидаем.Что(Теги().СвоиТегиПакета(Пакет.Идентификатор).Количество(), "каналов по-прежнему три").Равно(3);

КонецПроцедуры

#КонецОбласти

#Область Права

// Гвард не впустил — ни одна форма раздела пула не доходит до домена: галка, набор и правило прежние.
&Тест
Процедура ПостороннийНиОднойФормойНеМеняетТегиПула() Экспорт

	Пул = ПулСГалкой();
	Правило = ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable").Правило;

	ГвардПула.Отказать("bob", Пул);
	ПослатьПул(Пул, "", "операция=теги_пула&теги_пула=0");
	ПослатьПул(Пул, "", "имя=evil&вид=semver&правило_semver=*&стиль=plain&значок=");
	ПослатьПул(Пул, "stable/save", "вид=semver&правило_semver=*&стиль=plain&значок=");
	ПослатьПул(Пул, "stable/delete", "confirmed=1&тег=stable");

	Ожидаем.Что(ТегиПула().НаследованиеВключено(ПулПоИд(Пул)), "галка прежняя").ЭтоИстина();
	Ожидаем.Что(ТегиПула().ТегиПула(Пул.Идентификатор).Количество(), "набор прежний").Равно(3);
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "evil"), "чужой тег не заведён").Равно(Неопределено);
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable").Правило, "правило прежнее").Равно(Правило);

	// КОНТРОЛЬ: владелец той же формой правит
	ОтправитьПул(Пул, "stable/save", "вид=semver&правило_semver=*&стиль=plain&значок=");
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable").Правило, "владелец правит").Равно("*");

КонецПроцедуры

// Гвард не впустил к пакету — ни одна форма раздела не меняет его теги.
&Тест
Процедура ПостороннийНиОднойФормойНеМеняетТегиПакета() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "own", "semver", "^1.0", "alice");
	До = СнимокТегов(Пакет);

	ГвардПакета.Отказать();
	ПослатьПакет(Пакет, "", "имя=evil&вид=manual&стиль=plain&значок=");
	ПослатьПакет(Пакет, "", "операция=проверить&имя=evil&вид=semver&правило_semver=*&стиль=plain&значок=");
	ПослатьПакет(Пакет, "", "операция=каналы_по_умолчанию");
	ПослатьПакет(Пакет, "own/save", "вид=semver&правило_semver=*&стиль=plain&значок=");
	ПослатьПакет(Пакет, "own/delete", "confirmed=1&тег=own");
	ПослатьПакет(Пакет, "stable/disable", "");
	ПослатьПакет(Пакет, "stable/enable", "");

	Ожидаем.Что(СнимокТегов(Пакет), "теги пакета прежние").Равно(До);

	// КОНТРОЛЬ: впущенный той же формой выключает тег пула
	ОтправитьПакет(Пакет, "stable/disable", "");
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "впущенный выключает").Равно("выключен");

КонецПроцедуры

// «Изменить в пуле» и плашка-ссылка на теги пула — только тому, кто администрирует пул: остальным
// ссылка вела бы на 403.
&Тест
Процедура ПутьКТегамПулаВидитТолькоАдминистраторПула() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	АдресПула = "/pools/" + Пул.Имя + "/settings/tags";

	Права_.РазрешитьРаспоряжаться(-1);
	Строка_ = СтрокаТаблицы(ПолучитьПакет(Пакет, "").ТелоТекст, "stable");
	Ожидаем.Что(Строка_, "КОНТРОЛЬ: строка тега пула").Заполнено();
	Ожидаем.Что(СтрНайти(Строка_, "href=""" + АдресПула), "мейнтейнеру пакета пути к тегам пула нет").Равно(0);

	Права_.РазрешитьРаспоряжаться(Пул.Идентификатор);
	Строка_ = СтрокаТаблицы(ПолучитьПакет(Пакет, "").ТелоТекст, "stable");
	Ожидаем.Что(Строка_, "администратору пула плашка ведёт к тегам пула").Содержит("href=""" + АдресПула + """");
	Ожидаем.Что(Строка_, "и пункт «Изменить в пуле» — к окну тега пула")
		.Содержит("href=""" + АдресОкна(АдресПула, "изменить-stable") + """");

КонецПроцедуры

// Форма старой вкладки (операция, которой новый экран не знает) отбивается, ничего не меняя.
&Тест
Процедура ФормаСтаройВкладкиОтбиваетсяБезМутации() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "own", "semver", "^1.0", "alice");
	До = СнимокТегов(Пакет);

	Для Каждого Тело Из СтрРазделить("операция=удалить&имя=own;операция=выключить&имя=stable;"
		+ "операция=сохранить&имя=fresh&вид=manual&стиль=plain&значок=", ";") Цикл
		Ответ = ОтправитьПакет(Пакет, "", Тело);
		Ожидаем.Что(Ответ.Код, "старая форма пакета (" + Тело + ") — 400").Равно(400);
		Ожидаем.Что(Ответ.ТелоТекст, "и слова «страница устарела»").Содержит("Страница устарела");
	КонецЦикла;
	Ожидаем.Что(ОтправитьПакет(Пакет, "own/save", "операция=по_умолчанию&вид=semver&правило_semver=*").Код,
		"старая операция в форме правки — 400").Равно(400);
	Ожидаем.Что(СнимокТегов(Пакет), "теги пакета прежние").Равно(До);

	Ожидаем.Что(ОтправитьПул(Пул, "", "операция=удалить&имя=stable").Код, "старая форма пула — 400").Равно(400);
	Ожидаем.Что(ТегиПула().ТегиПула(Пул.Идентификатор).Количество(), "набор пула прежний").Равно(3);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Теги()
	Возврат Желудь("СервисТегов");
КонецФункции

Функция ТегиПула()
	Возврат Желудь("СервисТеговПула");
КонецФункции

// Теги пакета одной строкой: имя, происхождение, правило — по ней видно любую правку.
Функция СнимокТегов(Знач Пакет)

	Части = Новый Массив();
	Раскладка = Теги().КаналыПакета(Пакет.Идентификатор);
	Для Каждого Канал Из Раскладка.Каналы Цикл
		Части.Добавить(СтрШаблон("%1:%2:%3", Канал.Тег.Имя,
			Раскладка.Происхождение.Получить(Строка(Канал.Тег.Имя)), Канал.Тег.Правило));
	КонецЦикла;
	Для Каждого Тег Из Раскладка.Выключенные Цикл
		Части.Добавить(Тег.Имя + ":выключен");
	КонецЦикла;
	Возврат СтрСоединить(Части, ";");

КонецФункции

Функция ПулПоИд(Знач Пул)
	Возврат Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор);
КонецФункции

Функция ПулСГалкой()
	Пул = Засев.ПулСервисом();
	ТегиПула().УстановитьНаследование(Пул.Идентификатор, Истина, "owner");
	Пул = ПулПоИд(Пул);
	ВпуститьВПул(Пул);
	Возврат Пул;
КонецФункции

Функция ПакетСВерсиями(Знач Пул, Знач СписокВерсий)

	Пакет = Засев.ПакетСервисом(Пул);
	Для Каждого Номер Из СтрРазделить(СписокВерсий, ",", Ложь) Цикл
		Засев.ВерсияСервисом(Пакет, СокрЛП(Номер));
	КонецЦикла;
	ВпуститьВПакет(ПулПоИд(Новый Структура("Идентификатор", Пакет.ПулИдентификатор)), Пакет);
	Возврат Пакет;

КонецФункции

Процедура ВпуститьВПул(Знач Пул)
	ГвардПула.Впустить("owner", Пул);
КонецПроцедуры

Процедура ВпуститьВПакет(Знач Пул, Знач Пакет)
	ГвардПакета.Впустить("alice", Пул, Пакет);
КонецПроцедуры

Функция ПолучитьПул(Знач Пул, Знач Окно)
	ВпуститьВПул(Пул);
	Ответ = Новый ОтветСтраницыЗаглушка();
	КонтроллерПула.Раздел(Ответ, Пул.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

// POST формы раздела владельцем пула: "" — раздел, «<тег>/<действие>» — форма тега.
Функция ОтправитьПул(Знач Пул, Знач Хвост, Знач Тело)
	ВпуститьВПул(Пул);
	Возврат ПослатьПул(Пул, Хвост, Тело);
КонецФункции

// POST формы раздела тем, кого гвард пустил или нет, — как решил тест.
Функция ПослатьПул(Знач Пул, Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		КонтроллерПула.Раздел(Ответ, Пул.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "POST", ТелоФормы);
		Возврат Ответ;
	КонецЕсли;

	Части = СтрРазделить(Хвост, "/");
	Если Части[1] = "save" Тогда
		КонтроллерПула.Сохранение(Ответ, Пул.Имя, Части[0], Новый Соответствие(), Новый КукиЗаглушка(),
			"POST", ТелоФормы);
	Иначе
		КонтроллерПула.Удаление(Ответ, Пул.Имя, Части[0], Новый Соответствие(), Новый КукиЗаглушка(),
			"POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция ПолучитьПакет(Знач Пакет, Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	КонтроллерПакета.Раздел(Ответ, "", Пакет.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "",
		"", Окно);
	Возврат Ответ;
КонецФункции

Функция ОтправитьПакет(Знач Пакет, Знач Хвост, Знач Тело)
	ВпуститьВПакет(ПулПоИд(Новый Структура("Идентификатор", Пакет.ПулИдентификатор)), Пакет);
	Возврат ПослатьПакет(Пакет, Хвост, Тело);
КонецФункции

// POST формы раздела пакета тем, кого гвард пустил или нет, — как решил тест.
Функция ПослатьПакет(Знач Пакет, Знач Хвост, Знач Тело)

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	Заголовки = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		КонтроллерПакета.Раздел(Ответ, "", Пакет.Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы);
		Возврат Ответ;
	КонецЕсли;

	Части = СтрРазделить(Хвост, "/");
	Имя = Части[0];
	Если Части[1] = "save" Тогда
		КонтроллерПакета.Сохранение(Ответ, "", Пакет.Имя, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы);
	ИначеЕсли Части[1] = "delete" Тогда
		КонтроллерПакета.Удаление(Ответ, "", Пакет.Имя, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы);
	ИначеЕсли Части[1] = "disable" Тогда
		КонтроллерПакета.Выключение(Ответ, "", Пакет.Имя, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы);
	Иначе
		КонтроллерПакета.Включение(Ответ, "", Пакет.Имя, Имя, Заголовки, Новый КукиЗаглушка(), "POST", ТелоФормы);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Поле выбора значка: от <fieldset … data-iconpicker> до его </fieldset>.
Функция Сетка(Знач HTML)
	Начало = Тег(HTML, "fieldset", "data-iconpicker=");
	Возврат ?(ЗначениеЗаполнено(Начало), Начало + Между(HTML, Начало, "</fieldset>"), "");
КонецФункции

// Набор сегмента вида тега: от его панели до панели следующего сегмента.
Функция НаборВида(Знач HTML, Знач Вид)

	Признак = "data-segment=""" + Вид + """";
	Позиция = СтрНайти(HTML, Признак);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Признак));
	Следующий = СтрНайти(Хвост, "data-segment=""");
	Возврат ?(Следующий = 0, Хвост, Лев(Хвост, Следующий - 1));

КонецФункции

Функция ЗначениеПризнака(Знач Тег_, Знач Имя)

	Маркер = Имя + "=""";
	Позиция = СтрНайти(Тег_, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Тег_, Позиция + СтрДлина(Маркер));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост + Конец, Конец) - 1);

КонецФункции

// Строка таблицы каналов: от <tr> с плашкой тега до конца строки.
Функция СтрокаТаблицы(Знач HTML, Знач ИмяТега)

	Для Каждого Кусок Из Куски(HTML, "<tr") Цикл
		Строка_ = Лев(Кусок, СтрНайти(Кусок + "</tr>", "</tr>"));
		Если СтрНайти(Строка_, ">" + ИмяТега + "<") > 0 Тогда
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция АдресОкна(Знач Раздел, Знач Окно)
	Возврат Раздел + "?" + Закодировать("окно") + "=" + Закодировать(Окно);
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
