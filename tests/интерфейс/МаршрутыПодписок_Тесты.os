// Адреса раздела «Подписки на события» трёх домов в настоящем маршрутизаторе winow: литерал webhooks
// побеждает шаблон раздела дома, двери записи и раздела уходят своим точкам, соседний раздел дома
// остаётся у своего контроллера.

#Использовать asserts
#Использовать "../фикстуры"

Перем Маршруты;   // фикстура МаршрутыХаба — таблица маршрутов хаба в маршрутизаторе winow

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("МаршрутыХаба");
КонецПроцедуры

&ПередВсеми
Процедура СобратьМаршруты() Экспорт
	Маршруты = Новый МаршрутыХаба(КаталогиПроекта.Модули());
КонецПроцедуры

&Тест
Процедура АдресаПодписокХабаУходятСвоимТочкам() Экспорт

	Дом = "/hub/settings/webhooks";
	Контроллер = "КонтроллерПодписокХаба";
	ПроверитьДвери(Дом, Контроллер);
	ПроверитьОбработчик(Дом + "/7/recipients", "Получатели", Контроллер);
	ПроверитьОбработчик(Дом + "/delivery", "НастройкиДоставки", Контроллер);

	// КОНТРОЛЬ: соседний раздел и прежний адрес блока доставки — у дома хаба
	ПроверитьОбработчик("/hub/settings/providers", "", "КонтроллерПровайдеровВхода");
	ПроверитьОбработчик("/hub/settings/delivery", "Раздел", "КонтроллерДомаХаба");

КонецПроцедуры

&Тест
Процедура АдресаПодписокПулаУходятСвоимТочкам() Экспорт

	Дом = "/pools/corp/settings/webhooks";
	Контроллер = "КонтроллерПодписокПула";
	ПроверитьДвери(Дом, Контроллер);
	ПроверитьОбработчик(Дом + "/7/recipients", "Получатели", Контроллер);
	ПроверитьОбработчик(Дом + "/inherited/7/narrow", "Сужение", Контроллер);
	ПроверитьОбработчик(Дом + "/inherited/7/reset", "СнятиеПоправки", Контроллер);
	ПроверитьОбработчик(Дом + "/inherited/7/recipients", "ПолучателиПоправки", Контроллер);

	// КОНТРОЛЬ: литерал webhooks побеждает шаблон раздела дома пула, а соседний раздел — у дома
	ПроверитьОбработчик("/pools/corp/settings/general", "", "КонтроллерДомаПула");

КонецПроцедуры

&Тест
Процедура АдресаПодписокПакетаУходятСвоимТочкам() Экспорт

	Дом = "/pools/corp/packages/cron-tasks/settings/webhooks";
	Контроллер = "КонтроллерПодписокПакета";
	ПроверитьДвери(Дом, Контроллер);
	ПроверитьОбработчик(Дом + "/inherited/7/narrow", "Сужение", Контроллер);
	ПроверитьОбработчик(Дом + "/inherited/7/reset", "СнятиеПоправки", Контроллер);

	// КОНТРОЛЬ: литерал webhooks побеждает шаблон раздела дома пакета, а соседний раздел — у дома
	ПроверитьОбработчик("/pools/corp/packages/cron-tasks/settings/card", "", "КонтроллерДомаПакета");

КонецПроцедуры

// Двери, общие трём домам: раздел, окно правки, тумблер, удаление, проба и предпросмотр.
Процедура ПроверитьДвери(Знач Дом, Знач Контроллер)

	ПроверитьОбработчик(Дом, "Раздел", Контроллер);
	ПроверитьОбработчик(Дом + "/7/save", "Сохранение", Контроллер);
	ПроверитьОбработчик(Дом + "/7/toggle", "Переключение", Контроллер);
	ПроверитьОбработчик(Дом + "/7/delete", "Удаление", Контроллер);
	ПроверитьОбработчик(Дом + "/7/test", "ПробнаяОтправка", Контроллер);
	ПроверитьОбработчик(Дом + "/7/preview", "ПредпросмотрПравки", Контроллер);
	ПроверитьОбработчик(Дом + "/test", "ПробаЗаведения", Контроллер);
	ПроверитьОбработчик(Дом + "/preview", "ПредпросмотрЗаведения", Контроллер);

КонецПроцедуры

Процедура ПроверитьОбработчик(Знач Путь, Знач Метод, Знач Контроллер)

	Обработчик = Маршруты.Обработчик(Путь);
	Ожидаем.Что(Обработчик <> Неопределено, "адрес обслуживается: " + Путь).ЭтоИстина();
	Ожидаем.Что(Обработчик.Контроллер, "контроллер адреса " + Путь).Равно(Контроллер);
	Если ЗначениеЗаполнено(Метод) Тогда
		Ожидаем.Что(Обработчик.Метод, "точка маршрута адреса " + Путь).Равно(Метод);
	КонецЕсли;

КонецПроцедуры
