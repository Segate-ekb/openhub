// Раздел «Брендирование» дома «Хаб»: образец шапки в пресете с зеркалами полей, значения одной формой,
// логотип и иконка — слотами со своими адресами загрузки и возврата; настоящим контроллером раздела
// поверх настоящих служб настроек, картинок оформления и журнала аудита в контейнере (база — в памяти).

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Контроллер;    // КонтроллерБрендирования
Перем Настройки;     // СервисНастроек — настоящие значения реестра
Перем Активы;        // СервисБрендовыхАктивов — настоящие картинки оформления
Перем Гвард;         // ГвардХабаЗаглушка — впускает админа либо никого
Перем Защита;        // ЗащитаCSRFЗаглушка — принимает токен формы либо отказывает
Перем Админ;         // Структура — учётка, которую гвард впускает
Перем СессияАдмина;
Перем Журнал;        // ЖурналАудитаФайлом — что хаб записал в журнал аудита
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");
	Слои.ПодключитьТаблицы("уведомления");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "аудит", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ГотовностьХаба");
	Слои.Подключить("вход, права, настройки, гео, сеть, хранилище, почта, интерфейс/общее,"
		+ " интерфейс/хаб, интерфейс/панели/страна, состояние/выпуски");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "КонтроллерБрендирования");

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкЖурналЗамка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ГвардХабаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ФейкСтражаПарольногоВхода");
	РеестрФикстур.Подключить("СоставнаяФормаЗаглушка");
	РеестрФикстур.Подключить("ЖурналАудитаФайлом");

	Детальки = Новый Соответствие();
	// под корнем хранилища лежит файл журнала аудита
	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-screen-branding");
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-брендирования-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);
	Учётка = Желудь("СервисПользователей").СоздатьПользователя("root8b", "root8b@example.org",
		"password123", "admin");
	Админ = Новый Структура("Логин, Админ, Email, РольХаба", "root8b", Истина, "root8b@example.org", "admin");
	СессияАдмина = Принципалы.Сессия(Учётка);
	Гвард = Новый ГвардХабаЗаглушка();

	Настройки = Желудь("СервисНастроек");
	Активы = Желудь("СервисБрендовыхАктивов");
	Журнал = Новый ЖурналАудитаФайлом(Желудь("ЧитательЖурналаАудита"));

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Новый ФейкСервисПрав(), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();

	// парольный вход — соседняя секция дома, её предохранитель здесь не судится
	ОкноПароля = Новый ВитринаПарольногоВхода(Желудь("Кит"), Желудь("ТекстыИнтерфейса"),
		Желудь("ПоляНастроек"), Настройки, Желудь("ПолитикаПарольногоВхода"),
		Новый ФейкСтражаПарольногоВхода(Настройки), Желудь("ОкноРаздела"));
	ВитринаДома = Новый ВитринаДомаХаба(Желудь("ДомХаба"), Желудь("ВитринаНастроек"),
		Желудь("ВитринаПулов"), Желудь("ВитринаБрендирования"), Желудь("ВитринаСведенийХаба"),
		Желудь("ВитринаХранилища"), Желудь("ВитринаПробыПочты"), ОкноПароля, Желудь("ОтборПулов"));

	Контроллер = Новый КонтроллерБрендирования(Гвард, Ответы, Желудь("ДомХаба"), ВитринаДома,
		Желудь("ВитринаБрендирования"), Желудь("ПультБрендирования"),
		Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы")), Защита, Желудь("РазборФормы"),
		Желудь("ОкноРаздела"), Желудь("ТекстыИнтерфейса"));

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

&ПередКаждым
Процедура ВернутьУмолчания() Экспорт

	Гвард.Впустить(Админ, СессияАдмина);
	Защита.ЗадатьИсход(Истина);
	Для Каждого Ключ Из СтрРазделить("oshub.ui.brand,oshub.ui.tagline,oshub.ui.theme,oshub.ui.preset,"
		+ "oshub.ui.accent,oshub.ui.show_name", ",") Цикл
		Настройки.Сбросить(Ключ, "тест");
	КонецЦикла;
	Активы.Сбросить("logo", "тест");
	Активы.Сбросить("favicon", "тест");

КонецПроцедуры

#Область Страница

&Тест
Процедура РазделПечатаетОбразецФормуЗначенийИДваСлота() Экспорт

	Страница = Получить();

	Ожидаем.Что(Страница.Код, "раздел отдан").Равно(200);
	Ожидаем.Что(Вкладка(Страница), "вкладка называет раздел и дом").Равно(
		"Брендирование · Настройки хаба · " + Желудь("ОписаниеПриложения").Имя());

	Разметка = Страница.ТелоТекст;
	Форма = ФормаСПолем(Разметка, "brand");
	Ожидаем.Что(Форма, "форма значений уходит на раздел").Содержит("action=""/hub/settings/branding""");
	Для Каждого Имя Из СтрРазделить("tagline,show_name,theme,preset,accent", ",") Цикл
		Ожидаем.Что(Форма, "той же формой — " + Имя).Содержит("name=""" + Имя + """");
	КонецЦикла;
	Ожидаем.Что(СтрЧислоВхождений(Форма, "type=""submit"""), "одна панель сохранения").Равно(1);
	Ожидаем.Что(Разметка, "имён полей реестра на странице нет").ЭтоНе().Содержит("name=""oshub.ui.");
	Ожидаем.Что(Форма, "у названия источник справа в строке подсказки")
		.Содержит(Текст("settings.source.default") + " · oshub.ui.brand");

	Образец = Фрагмент(Разметка, "<figure", "</figure>");
	Для Каждого Имя Из СтрРазделить("brand,tagline,accent", ",") Цикл
		Ожидаем.Что(Образец, "образец зеркалит поле " + Имя).Содержит("data-mirror=""" + Имя + """");
	КонецЦикла;
	Ожидаем.Что(Образец, "в образце действующее название").Содержит(">OpenHub<");

	Для Каждого Образец_ Из Желудь("ТокеныТемы").ОбразцыАкцента() Цикл
		Ожидаем.Что(Форма, "образец акцента " + Образец_.Цвет + " — палитра кита, та же, что у аккаунта")
			.Содержит("value=""" + Образец_.Цвет + """");
		Ожидаем.Что(Форма, "образец " + Образец_.Цвет + " назван словом словаря")
			.Содержит(Текст(Образец_.Ключ));
	КонецЦикла;
	Ожидаем.Что(Разметка, "имена образцов — не маркеры ключей").ЭтоНе().Содержит("[?field.color");

	Для Каждого Слот Из СтрРазделить("logo,favicon", ",") Цикл
		Загрузка = ФормаСПолем(Разметка, Слот);
		Ожидаем.Что(Загрузка, "слот «" + Слот + "» — своя форма своего адреса")
			.Содержит("action=""/hub/settings/branding/" + Слот + """");
		Ожидаем.Что(Загрузка, "и уходит составной").Содержит("multipart/form-data");
	КонецЦикла;
	Ожидаем.Что(Разметка, "стандартную картинку возвращать нечем: сброса у слотов нет")
		.ЭтоНе().Содержит("/reset""");

КонецПроцедуры

// Источник темы — словом кита у сегментов: на строке подписи группы, группа на него ссылается;
// своей строки под пилюлей (она ложилась на пилюлю) нет.
&Тест
Процедура ИсточникТемыСтоитНаСтрокеПодписиСегментов() Экспорт

	Разметка = Получить().ТелоТекст;
	Источник = Текст("settings.source.default") + " · oshub.ui.theme";
	Строка = Фрагмент(Разметка, "class=""segments__origin""", "</span>");

	Ожидаем.Что(Строка, "источник темы печатает кит у сегментов").Содержит(Источник);
	Ожидаем.Что(ФрагментСПолем(Разметка, "theme"), "группа сегментов темы описана источником")
		.Содержит("aria-describedby=");
	Ожидаем.Что(СтрЧислоВхождений(Разметка, Источник), "источник темы напечатан один раз").Равно(1);
	Ожидаем.Что(Разметка, "своего примечания-источника у хаба нет").ЭтоНе().Содержит("note-origin");

КонецПроцедуры

// Кнопка образца — пример вида, а не действие: нажатая, она не отправляет форму значений.
&Тест
Процедура КнопкаОбразцаНеОтправляетФормуЗначений() Экспорт

	Образец = Фрагмент(Получить().ТелоТекст, "<figure", "</figure>");
	Подпись = СтрНайти(Образец, Текст("settings.hub.branding.preview.button"));
	Ожидаем.Что(Подпись > 0, "в образце — кнопка образца").ЭтоИстина();
	Начало = СтрНайти(Образец, "<button", НаправлениеПоиска.СКонца, Подпись);
	ДоПодписи = Сред(Образец, Начало, Подпись - Начало);

	Ожидаем.Что(Начало > 0 И СтрНайти(ДоПодписи, "</button>") = 0, "подпись стоит в кнопке, а не в ссылке")
		.ЭтоИстина();
	Ожидаем.Что(Лев(ДоПодписи, СтрНайти(ДоПодписи, ">")), "и формы кнопка не отправляет")
		.Содержит("type=""button""");

КонецПроцедуры

// Пресет — сегментами над акцентом: пресеты кита в его порядке, имена из словаря, выбран действующий,
// источник — словом кита. Образец несёт палитры всех пресетов и показывает действующий: выбор
// сегмента перекрашивает его без сервера, без скрипта он верен после «Сохранить».
&Тест
Процедура ПресетВыбираетсяСегментамиНадАкцентомИКраситОбразец() Экспорт

	Настройки.Установить("oshub.ui.preset", "oscript", "тест");
	Разметка = Получить().ТелоТекст;

	Форма = ФормаСПолем(Разметка, "brand");
	Пресет = СтрНайти(Форма, "name=""preset""");
	Ожидаем.Что(Пресет > 0 И Пресет < СтрНайти(Форма, "name=""accent"""), "пресет — той же формой, над акцентом")
		.ЭтоИстина();
	Группа = ГруппаСегментов(Форма, "preset");
	Предыдущий = 0;
	Для Каждого Описание Из Желудь("ТокеныТемы").Пресеты() Цикл
		Место = СтрНайти(Группа, "value=""" + Описание.Ключ + """");
		Ожидаем.Что(Место > Предыдущий, "сегмент «" + Описание.Ключ + "» — в порядке кита").ЭтоИстина();
		Ожидаем.Что(Группа, "и назван словарём").Содержит(">" + Текст(Описание.КлючСловаряИмени) + "<");
		Предыдущий = Место;
	КонецЦикла;
	Ожидаем.Что(Разметка, "имена пресетов — не маркеры ключей").ЭтоНе().Содержит("[?theme.preset");
	Ожидаем.Что(ТегВвода(Группа, "oscript"), "выбран действующий пресет").Содержит(" checked");
	Ожидаем.Что(ТегВвода(Группа, "material"), "КОНТРОЛЬ: умолчание не отмечено").ЭтоНе().Содержит(" checked");
	Набор = Фрагмент(Форма, "<legend>" + Текст("settings.key.oshub-ui-preset.label") + "<", "</fieldset>");
	Ожидаем.Что(Набор, "источник пресета — словом кита у сегментов")
		.Содержит(Текст("settings.source.db") + " · oshub.ui.preset");
	Ожидаем.Что(Набор, "пояснение настройки — под сегментами, как у соседних полей")
		.Содержит(Текст("settings.key.oshub-ui-preset.hint"));

	Образец = Фрагмент(Разметка, "<figure", "</figure>");
	Ожидаем.Что(Фрагмент(Образец, "<figure", ">"), "образец зеркалит выбор пресета и показывает действующий")
		.Содержит("data-mirror-preset=""oscript""");
	Для Каждого Описание Из Желудь("ТокеныТемы").Пресеты() Цикл
		Ожидаем.Что(Образец, "в образце палитра пресета «" + Описание.Ключ + "» светлой темы")
			.Содержит(Желудь("ТокеныТемы").ЦветаПресета(Описание.Ключ, Ложь));
		Ожидаем.Что(Образец, "и тёмной").Содержит(Желудь("ТокеныТемы").ЦветаПресета(Описание.Ключ, Истина));
	КонецЦикла;
	Ожидаем.Что(Образец, "без своего акцента подпись образца — без оговорки")
		.Содержит(">" + Текст("settings.hub.branding.preview.title") + "<");

КонецПроцедуры

// «Своя» — не пресет, а любой пресет со своим акцентом: пометка «+ свой акцент» стоит у сегментов
// пресета той же формой, что и поле акцента, — лист прячет её по пустому полю, поэтому она видна
// вживую по мере выбора цвета; образец красит ряд акцента своим цветом поверх пресета.
&Тест
Процедура СвойАкцентПоверхПресетаПомеченУСегментов() Экспорт

	Настройки.Установить("oshub.ui.preset", "classic", "тест");
	Настройки.Установить("oshub.ui.accent", "#2bb673", "тест");

	Разметка = Получить().ТелоТекст;
	Форма = ФормаСПолем(Разметка, "brand");
	Набор = Фрагмент(Форма, "<legend>" + Текст("settings.key.oshub-ui-preset.label") + "<", "</fieldset>");
	Ожидаем.Что(Набор, "пометка своего акцента — у сегментов пресета")
		.Содержит(">" + Текст("settings.hub.branding.preset.accent") + "<");
	Ожидаем.Что(Набор, "и найдётся листу").Содержит("data-brand-preview=""own-accent""");
	Ожидаем.Что(Форма, "КОНТРОЛЬ: поле акцента, по которому её прячет лист, — в той же форме")
		.Содержит("value=""#2bb673""");
	Образец = Фрагмент(Разметка, "<figure", "</figure>");
	Ожидаем.Что(Образец, "пресет образца — действующий").Содержит("data-mirror-preset=""classic""");
	Ожидаем.Что(Образец, "ряд акцента — своим цветом поверх пресета").Содержит("--mirror-accent:#2bb673");

КонецПроцедуры

// Название и подпись — данные администратора: слово, совпавшее с видом узла кита («Метка»,
// «Описание»), печатается текстом и не роняет страницу — ни сохранённое, ни набранное в отбитой форме.
&Тест
Процедура НазваниеИПодписьСловомВидаПечатаютсяТекстом() Экспорт

	Настройки.Установить("oshub.ui.brand", "Метка", "тест");
	Настройки.Установить("oshub.ui.tagline", "Описание", "тест");

	Страница = Получить();
	Ожидаем.Что(Страница.Код, "раздел отдан").Равно(200);
	Образец = Фрагмент(Страница.ТелоТекст, "<figure", "</figure>");
	Ожидаем.Что(Образец, "название в образце").Содержит(">Метка<");
	Ожидаем.Что(Образец, "подпись в образце").Содержит(">Описание<");

	Ответ = Отправить("brand=" + Закодировать("Пусто") + "&accent=" + Закодировать("не-цвет"));
	Ожидаем.Что(Ответ.Код, "отбитая форма — отказ, а не пятисотка").Равно(400);
	Ожидаем.Что(Фрагмент(Ответ.ТелоТекст, "<figure", "</figure>"), "набранное название в образце")
		.Содержит(">Пусто<");

КонецПроцедуры

#КонецОбласти

#Область Значения

&Тест
Процедура СохранениеЗначенийМеняетДоменИВедётНаРаздел() Экспорт

	Ответ = Отправить("brand=" + Закодировать("Хаб Ромашка") + "&tagline=" + Закодировать("Внутренний хаб")
		+ "&show_name=0&theme=" + Закодировать("светлая") + "&preset=oscript&accent=" + Закодировать("#2bb673"));

	Ожидаем.Что(Ответ.Код, "удача — перенаправление").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой").Содержит("/hub/settings/branding?saved=");
	Ожидаем.Что(Настройки.Значение("oshub.ui.brand"), "название записано").Равно("Хаб Ромашка");
	Ожидаем.Что(Настройки.Значение("oshub.ui.tagline"), "подпись записана").Равно("Внутренний хаб");
	Ожидаем.Что(Настройки.Значение("oshub.ui.show_name"), "название рядом с логотипом выключено").ЭтоЛожь();
	Ожидаем.Что(Настройки.Значение("oshub.ui.theme"), "тема записана").Равно("светлая");
	Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "пресет записан").Равно("oscript");
	Ожидаем.Что(Настройки.Значение("oshub.ui.accent"), "акцент записан").Равно("#2bb673");

КонецПроцедуры

// Правка пресета формой раздела — строка журнала аудита: кто и что стало.
&Тест
Процедура ПресетИзФормыЛожитсяВЖурналАудитаСАвтором() Экспорт

	Ответ = Отправить("preset=classic");

	Ожидаем.Что(Ответ.Код, "удача — перенаправление").Равно(303);
	Записи = Журнал.ПоОбъекту("настройка/oshub.ui.preset");
	Ожидаем.Что(Записи.Количество() > 0, "правка пресета в журнале аудита").ЭтоИстина();
	Ожидаем.Что(Записи[0].Действие, "действие журнала").Равно("настройка.изменена");
	Ожидаем.Что(Записи[0].Кто, "автор — логин сессии").Равно(Админ.Логин);
	Ожидаем.Что(Желудь("ФорматЖурналаАудита").ДеталиПолями(Строка(Записи[0].Детали)).Получить("стало"),
		"детали называют новый пресет").Равно("classic");

КонецПроцедуры

// Пресета, которого нет у кита, форма не пишет: 400 «чужой пресет», и ни пресет, ни соседние поля
// формы не тронуты — пресет судится первым. Причина — строкой отказа под сегментами, как у поля,
// набранное возвращается в форму.
&Тест
Процедура ЧужойПресетОтбитИНичегоНеЗаписано() Экспорт

	Ответ = Отправить("brand=" + Закодировать("Хаб Лютик") + "&preset=" + Закодировать("neon"));

	Ожидаем.Что(Ответ.Код, "отказ формы, а не пятисотка").Равно(400);
	Ожидаем.Что(Настройки.Источник("oshub.ui.preset"), "пресет не записан").Равно("дефолт");
	Ожидаем.Что(Настройки.Источник("oshub.ui.brand"), "и название не записано: пресет пишется первым")
		.Равно("дефолт");
	Форма = ФормаСПолем(Ответ.ТелоТекст, "brand");
	Ожидаем.Что(ГруппаСегментов(Форма, "preset"), "сегменты пресета помечены отбитыми")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(ОтказСегментов(Форма, "preset"), "причина — строкой отказа под ними").Содержит("oshub.ui.preset");
	Тост = Фрагмент(Ответ.ТелоТекст, "class=""toast__text""", "</span>");
	Ожидаем.Что(Тост, "над разделом — что из формы применено").Содержит(Текст("settings.hub.error.applied.none"));
	Ожидаем.Что(Тост, "причину тост второй раз не повторяет").Не_().Содержит("oshub.ui.preset");
	Ожидаем.Что(ФормаСПолем(Ответ.ТелоТекст, "brand"), "набранное название на месте")
		.Содержит("value=""Хаб Лютик""");
	Ожидаем.Что(Фрагмент(Ответ.ТелоТекст, "<figure", ">"), "образец — в действующем пресете")
		.Содержит("data-mirror-preset=""material""");

	// КОНТРОЛЬ: пресет кита той же формой проходит
	Ожидаем.Что(Отправить("brand=" + Закодировать("Хаб Лютик") + "&preset=oscript").Код, "свой пресет принят")
		.Равно(303);
	Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "и записан").Равно("oscript");

КонецПроцедуры

// Тема — тоже сегментами: её отказ строкой под ними, а не молчаливой четырёхсоткой.
&Тест
Процедура ЧужаяТемаОтбитаПодСегментами() Экспорт

	Ответ = Отправить("preset=oscript&theme=" + Закодировать("неоновая"));

	Ожидаем.Что(Ответ.Код, "отказ формы").Равно(400);
	Ожидаем.Что(ОтказСегментов(ФормаСПолем(Ответ.ТелоТекст, "brand"), "theme"),
		"причина — строкой отказа под сегментами темы").Содержит("oshub.ui.theme");
	// пресет пишется раньше темы: раздел говорит, что он уже действует
	Тост = Фрагмент(Ответ.ТелоТекст, "class=""toast__text""", "</span>");
	Ожидаем.Что(Тост, "что из формы уже применено — названо").Содержит("Остальная форма уже применена:");
	Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "КОНТРОЛЬ: пресет и правда записан").Равно("oscript");
	Ожидаем.Что(Настройки.Источник("oshub.ui.theme"), "тема не записана").Равно("дефолт");

КонецПроцедуры

&Тест
Процедура НеизменённоеНеЗаписываетсяРукамиВведённым() Экспорт

	// пустое поле — умолчание: повторная отправка нетронутой формы не делает его «введённым руками»
	Отправить("brand=&tagline=&show_name=1&theme=" + Закодировать("тёмная") + "&preset=material&accent=");

	Для Каждого Ключ Из СтрРазделить("oshub.ui.brand,oshub.ui.tagline,oshub.ui.show_name,oshub.ui.theme,"
		+ "oshub.ui.preset,oshub.ui.accent", ",") Цикл
		Ожидаем.Что(Настройки.Источник(Ключ), "значение осталось умолчанием: " + Ключ).Равно("дефолт");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НегодныйАкцентОтбитУПоляИНичегоНеЗаписано() Экспорт

	Ответ = Отправить("brand=" + Закодировать("Хаб Лютик") + "&accent=" + Закодировать("red;}html{display:none"));

	Ожидаем.Что(Ответ.Код, "отказ формы").Равно(400);
	Поле = ФрагментСПолем(Ответ.ТелоТекст, "accent");
	Ожидаем.Что(Поле, "поле акцента помечено").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Поле, "отказ называет нужную запись цвета").Содержит("#rrggbb");
	Ожидаем.Что(ФормаСПолем(Ответ.ТелоТекст, "brand"), "набранное название на месте")
		.Содержит("value=""Хаб Лютик""");
	Ожидаем.Что(Настройки.Источник("oshub.ui.brand"), "название не записано: акцент пишется первым")
		.Равно("дефолт");
	Ожидаем.Что(Настройки.Значение("oshub.ui.accent"), "акцент прежний").Равно("");

КонецПроцедуры

// Форма до перевода раздела на образец слала значения под ключами реестра, картинки — сюда же
// составной формой с операцией: такая отправка отбивается целиком.
&Тест
Процедура ФормаСтаройВкладкиОтбитаИНичегоНеМеняет() Экспорт

	Ответ = Отправить(Закодировать("oshub.ui.brand") + "=" + Закодировать("Хаб Старый"));
	Ожидаем.Что(Ответ.Код, "старая форма значений — 400").Равно(400);
	Ожидаем.Что(Ответ.ТелоТекст, "сказано, что страница устарела").Содержит(Текст("settings.hub.branding.error.stale"));
	Ожидаем.Что(Настройки.Источник("oshub.ui.brand"), "название не тронуто").Равно("дефолт");

	Части = Новый СоставнаяФормаЗаглушка().Поле("_csrf", "токен-теста").Поле("операция", "актив-загрузка")
		.Файл("актив-logo", "лого.png", "image/png", КартинкаPNG());
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST", "", Части);
	Ожидаем.Что(Ответ.Код, "старая форма картинок — 400").Равно(400);
	Ожидаем.Что(Активы.Сведения("logo").Есть, "логотип не загружен").ЭтоЛожь();

	// КОНТРОЛЬ: та же правка полем новой формы проходит
	Ожидаем.Что(Отправить("brand=" + Закодировать("Хаб Новый")).Код, "новая форма принята").Равно(303);
	Ожидаем.Что(Настройки.Значение("oshub.ui.brand"), "и пишет значение").Равно("Хаб Новый");

КонецПроцедуры

&Тест
Процедура ВведённоеРукамиСбрасываетсяФормойРаздела() Экспорт

	Настройки.Установить("oshub.ui.tagline", "Своя подпись", "тест");
	Разметка = Получить().ТелоТекст;
	Ожидаем.Что(Разметка, "введённое руками — списком со сбросом").Содержит(Текст("settings.values.reset.title"));

	Ответ = Отправить("операция=" + Закодировать("сбросить") + "&" + Закодировать("ключ") + "="
		+ Закодировать("oshub.ui.tagline"));
	Ожидаем.Что(Ответ.Код, "сброс принят").Равно(303);
	Ожидаем.Что(Настройки.Источник("oshub.ui.tagline"), "подпись снова по умолчанию").Равно("дефолт");

КонецПроцедуры

// Пресет сбрасывается к умолчанию той же формой «Введено вручную», что прочие значения раздела.
&Тест
Процедура ПресетСбрасываетсяКУмолчаниюФормойРаздела() Экспорт

	Настройки.Установить("oshub.ui.preset", "oscript", "тест");

	Ответ = Отправить("операция=" + Закодировать("сбросить") + "&" + Закодировать("ключ") + "="
		+ Закодировать("oshub.ui.preset"));
	Ожидаем.Что(Ответ.Код, "сброс принят").Равно(303);
	Ожидаем.Что(Настройки.Источник("oshub.ui.preset"), "пресет снова по умолчанию").Равно("дефолт");
	Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "умолчание — пресет кита по умолчанию")
		.Равно(Желудь("ТокеныТемы").ПресетПоУмолчанию());

КонецПроцедуры

#КонецОбласти

#Область Картинки

&Тест
Процедура ЛоготипЗагружаетсяСвоимАдресомИСлотПолучаетСброс() Экспорт

	Ответ = Загрузить("logo", "лого.png", "image/png", КартинкаPNG());

	Ожидаем.Что(Ответ.Код, "удача — перенаправление").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой").Содержит("/hub/settings/branding?saved=");
	Ожидаем.Что(Активы.Сведения("logo").Есть, "логотип в хранилище").ЭтоИстина();
	Ожидаем.Что(Активы.Сведения("favicon").Есть, "иконка не тронута").ЭтоЛожь();

	Слот = СлотКартинки(Получить().ТелоТекст, "logo");
	Ожидаем.Что(Слот, "слот называет файл").Содержит("logo.png · ");
	Ожидаем.Что(Слот, "у своей картинки — «Вернуть стандартную»")
		.Содержит("action=""/hub/settings/branding/logo/reset""");

КонецПроцедуры

&Тест
Процедура НеКартинкаОтбитаПодСлотомНеПятисоткой() Экспорт

	Ответ = Загрузить("logo", "документ.txt", "text/plain", ПолучитьДвоичныеДанныеИзСтроки("это не картинка"));

	Ожидаем.Что(Ответ.Код, "отказ формы").Равно(400);
	Ожидаем.Что(СлотКартинки(Ответ.ТелоТекст, "logo"), "отказ — под слотом логотипа")
		.Содержит("не картинка известного хабу формата");
	Ожидаем.Что(Фрагмент(СлотКартинки(Ответ.ТелоТекст, "logo"), "imgslot__error", "</p>"),
		"отказ — строкой отказа слота кита").Содержит("не картинка известного хабу формата");
	Ожидаем.Что(СлотКартинки(Ответ.ТелоТекст, "logo"), "файловое поле помечено отбитым")
		.Содержит("aria-invalid=""true""");
	Ожидаем.Что(СлотКартинки(Ответ.ТелоТекст, "favicon"), "под иконкой отказа нет")
		.ЭтоНе().Содержит("не картинка известного хабу формата");
	Ожидаем.Что(Активы.Сведения("logo").Есть, "логотип не загружен").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФайлСверхПотолкаОтбит413СВесомИПотолком() Экспорт

	Ответ = Загрузить("favicon", "огромный.png", "image/png", Байты(Активы.ПотолокБайт() + 1));

	Ожидаем.Что(Ответ.Код, "отказ по размеру — своим кодом").Равно(413);
	Ожидаем.Что(СлотКартинки(Ответ.ТелоТекст, "favicon"), "под слотом — вес и потолок").Содержит("при допустимых");
	Ожидаем.Что(Активы.Сведения("favicon").Есть, "иконка не загружена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФормаБезФайлаОтказАНеСохранено() Экспорт

	Части = Новый СоставнаяФормаЗаглушка().Поле("_csrf", "токен-теста");
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Загрузка(Ответ, "logo", Новый Соответствие(), Новый КукиЗаглушка(), "POST", Части);

	Ожидаем.Что(Ответ.Код, "пустая форма — отказ").Равно(400);
	Ожидаем.Что(СлотКартинки(Ответ.ТелоТекст, "logo"), "под слотом сказано, чего не хватает")
		.Содержит(Текст("settings.hub.branding.error.empty"));

КонецПроцедуры

&Тест
Процедура НеизвестнаяКартинка404() Экспорт

	Ответ = Загрузить("banner", "лого.png", "image/png", КартинкаPNG());
	Ожидаем.Что(Ответ.Код, "такой картинки у раздела нет").Равно(404);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.ВозвратСтандартной(Ответ, "banner", Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&confirmed=1");
	Ожидаем.Что(Ответ.Код, "и вернуть её нельзя").Равно(404);

КонецПроцедуры

&Тест
Процедура ВозвратБезПодтвержденияВедётНаОкноКартинкаЦела() Экспорт

	Загрузить("favicon", "значок.svg", "image/svg+xml", КартинкаSVG());

	Ответ = Вернуть("favicon", "");
	Ожидаем.Что(Ответ.Код, "ответ — перенаправление на подтверждение").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "окно названо адресом").Содержит(Закодировать("окно") + "="
		+ Закодировать("вернуть-favicon"));
	Ожидаем.Что(Активы.Сведения("favicon").Есть, "иконка на месте").ЭтоИстина();

	Окна = ОткрытыеОкна(Получить("вернуть-favicon").ТелоТекст);
	Ожидаем.Что(Окна.Количество(), "по адресу открыто одно окно").Равно(1);
	Ожидаем.Что(Окна[0], "окно шлёт форму сброса иконки").Содержит("form=""brendirovanie-favicon-reset-form""");
	// без скрипта окно закрывает переход: крестик и «Отмена» — ссылки на раздел без окна
	Ожидаем.Что(Окна[0], "«Отмена» окна сброса — ссылкой на раздел").Содержит("href=""/hub/settings/branding""");
	Ожидаем.Что(ОткрытыеОкна(Получить().ТелоТекст).Количество(), "КОНТРОЛЬ: без адреса окон нет").Равно(0);

	Ответ = Вернуть("favicon", "&confirmed=1");
	Ожидаем.Что(Ответ.Код, "подтверждённый возврат — перенаправление").Равно(303);
	Ожидаем.Что(Активы.Сведения("favicon").Есть, "иконка снова стандартная").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Право

// Каждую дверь раздела стережёт гвард: кого он не впустил, тот ни значений, ни картинок не трогает.
// КОНТРОЛЬ — те же запросы впущенным меняют домен.
&Тест
Процедура ПостороннийНиОднойДверьюРазделНеМеняет() Экспорт

	Загрузить("favicon", "значок.svg", "image/svg+xml", КартинкаSVG());
	Гвард.НеВпускать();

	Отправить("brand=" + Закодировать("Чужой хаб") + "&preset=oscript");
	Ожидаем.Что(Настройки.Источник("oshub.ui.brand"), "название не тронуто").Равно("дефолт");
	Ожидаем.Что(Настройки.Источник("oshub.ui.preset"), "пресет не тронут").Равно("дефолт");
	Загрузить("logo", "лого.png", "image/png", КартинкаPNG());
	Ожидаем.Что(Активы.Сведения("logo").Есть, "логотип не загружен").ЭтоЛожь();
	Вернуть("favicon", "&confirmed=1");
	Ожидаем.Что(Активы.Сведения("favicon").Есть, "иконка не возвращена к стандартной").ЭтоИстина();

	Гвард.НеВпускать(Ложь);
	Отправить("brand=" + Закодировать("Свой хаб") + "&preset=oscript");
	Ожидаем.Что(Настройки.Значение("oshub.ui.brand"), "КОНТРОЛЬ: впущенный название меняет").Равно("Свой хаб");
	Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "КОНТРОЛЬ: и пресет").Равно("oscript");
	Загрузить("logo", "лого.png", "image/png", КартинкаPNG());
	Ожидаем.Что(Активы.Сведения("logo").Есть, "КОНТРОЛЬ: и логотип загружает").ЭтоИстина();
	Вернуть("favicon", "&confirmed=1");
	Ожидаем.Что(Активы.Сведения("favicon").Есть, "КОНТРОЛЬ: и иконку возвращает").ЭтоЛожь();

КонецПроцедуры

// Форма с непринятым токеном ни одной дверью раздела ничего не меняет. КОНТРОЛЬ — с принятым меняет.
&Тест
Процедура ЧужойТокенНиОднойДверьюРазделНеМеняет() Экспорт

	Загрузить("favicon", "значок.svg", "image/svg+xml", КартинкаSVG());
	Защита.ЗадатьИсход(Ложь);

	Отправить("brand=" + Закодировать("Хаб по чужому токену"));
	Ожидаем.Что(Настройки.Источник("oshub.ui.brand"), "название не тронуто").Равно("дефолт");
	Загрузить("logo", "лого.png", "image/png", КартинкаPNG());
	Ожидаем.Что(Активы.Сведения("logo").Есть, "логотип не загружен").ЭтоЛожь();
	Вернуть("favicon", "&confirmed=1");
	Ожидаем.Что(Активы.Сведения("favicon").Есть, "иконка не возвращена к стандартной").ЭтоИстина();

	Защита.ЗадатьИсход(Истина);
	Отправить("brand=" + Закодировать("Хаб по своему токену"));
	Ожидаем.Что(Настройки.Значение("oshub.ui.brand"), "КОНТРОЛЬ: принятый токен название меняет")
		.Равно("Хаб по своему токену");

КонецПроцедуры

// Правку подписывает логин сессии: гвард, пропустивший запрос без пользователя, роняет его громко,
// а не пишет анонимную строку в журнал аудита.
&Тест
Процедура ПравкаБезПринципалаСессииПадаетИНеПишет() Экспорт

	Гвард.Впустить(Новый Структура("Логин, Админ, Email, РольХаба", "", Истина, "", "admin"), СессияАдмина);

	Поймано = "";
	Попытка
		Отправить("brand=" + Закодировать("Анонимный хаб"));
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Поймано, "падение называет причину").Содержит("принципал");
	Ожидаем.Что(Настройки.Источник("oshub.ui.brand"), "название не записано").Равно("дефолт");

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Текст(Знач Ключ)
	Возврат Желудь("ТекстыИнтерфейса").Текст(Ключ);
КонецФункции

Функция Получить(Знач Окно = "")
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", Неопределено, "", Окно);
	Возврат Ответ;
КонецФункции

Функция Отправить(Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST", "_csrf=токен-теста&" + Тело,
		Неопределено);
	Возврат Ответ;
КонецФункции

Функция Загрузить(Знач Слот, Знач ИмяФайла, Знач ТипКонтента, Знач Данные)
	Части = Новый СоставнаяФормаЗаглушка().Поле("_csrf", "токен-теста").Файл(Слот, ИмяФайла, ТипКонтента, Данные);
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Загрузка(Ответ, Слот, Новый Соответствие(), Новый КукиЗаглушка(), "POST", Части);
	Возврат Ответ;
КонецФункции

Функция Вернуть(Знач Слот, Знач Хвост)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.ВозвратСтандартной(Ответ, Слот, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста" + Хвост);
	Возврат Ответ;
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Имя вкладки браузера без знака хаба, который каркас дописывает через тире.
Функция Вкладка(Знач Ответ)

	Титул = Фрагмент(Ответ.ТелоТекст, "<title>", "</title>");
	Титул = Сред(Титул, СтрДлина("<title>") + 1, СтрДлина(Титул) - СтрДлина("<title></title>"));
	Тире = СтрНайти(Титул, " — ", НаправлениеПоиска.СКонца);
	Возврат ?(Тире = 0, Титул, Лев(Титул, Тире - 1));

КонецФункции

// Кусок разметки от первого вхождения начала до ближайшего за ним конца включительно.
Функция Фрагмент(Знач HTML, Знач Начало, Знач Конец)

	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, Конец) + СтрДлина(Конец) - 1);

КонецФункции

// Форма, в которой стоит поле, целиком: от её открывающего тега до закрывающего.
Функция ФормаСПолем(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Тело = Сред(HTML, СтрНайти(HTML, "<form", НаправлениеПоиска.СКонца, Позиция));
	Возврат Лев(Тело, СтрНайти(Тело, "</form>"));

КонецФункции

// Строка отказа, на которую ссылается группа сегментов (aria-describedby «error-…»): её текст.
Функция ОтказСегментов(Знач HTML, Знач Имя)

	Совпадения = Новый РегулярноеВыражение("aria-describedby=""[^""]*\b(error-[0-9a-f]+)")
		.НайтиСовпадения(ГруппаСегментов(HTML, Имя));
	Если Совпадения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Фрагмент(HTML, "id=""" + Совпадения[0].Группы[1].Значение + """", "</");

КонецФункции

// Группа сегментов с этим именем целиком: от её <div class="segments"> до закрывающего тега.
Функция ГруппаСегментов(Знач HTML, Знач Имя)

	Позиция = СтрНайти(HTML, "name=""" + Имя + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(HTML, "<div class=""segments""", НаправлениеПоиска.СКонца, Позиция);
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</div>") + 5);

КонецФункции

// Тег радиокнопки группы с этим значением целиком.
Функция ТегВвода(Знач Группа, Знач Значение)

	Позиция = СтрНайти(Группа, "value=""" + Значение + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Группа, "<input", НаправлениеПоиска.СКонца, Позиция);
	Хвост = Сред(Группа, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Поле с подписью и строкой отказа: от его обёртки до следующего поля формы.
Функция ФрагментСПолем(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(HTML, "<fieldset", НаправлениеПоиска.СКонца, Позиция);
	Если Начало = 0 Тогда
		Начало = Позиция;
	КонецЕсли;
	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Хвост, "</fieldset>");
	Возврат ?(Конец = 0, Лев(Хвост, 2000), Лев(Хвост, Конец + 2000));

КонецФункции

// Слот картинки с его отказом: обёртка data-brand-slot целиком, до следующей.
Функция СлотКартинки(Знач HTML, Знач Слот)

	Позиция = СтрНайти(HTML, "data-brand-slot=""" + Слот + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Следующий = СтрНайти(Сред(Хвост, 2), "data-brand-slot=""");
	Возврат ?(Следующий = 0, Лев(Хвост, СтрНайти(Хвост, "</section>")), Лев(Хвост, Следующий));

КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Если СтрНайти(Лев(Окно, СтрНайти(Окно, ">")), " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КартинкаPNG()
	// однопиксельный прозрачный PNG
	Возврат ПолучитьДвоичныеДанныеИзBase64Строки(
		"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk"
		+ "+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==");
КонецФункции

Функция КартинкаSVG()
	Возврат ПолучитьДвоичныеДанныеИзСтроки(
		"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 8 8""><rect width=""8"" height=""8""/></svg>");
КонецФункции

Функция Байты(Знач Сколько)
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(Сколько));
КонецФункции

#КонецОбласти
