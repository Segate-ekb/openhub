// Раздел «Права доступа» домов пула и пакета на механизме «⚙ записи + окно по адресу + подтверждение»:
// «Выдать роль» в шапке секции и окно выдачи по адресу, отбитая форма в открытом окне, отзыв из меню
// строки только подтверждённым, дверь раздела под гвардом дома и под правом выдавать, форма старой
// вкладки — настоящими контроллерами домов поверх настоящих служб доступа и прав в контейнере.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;     // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Засев;            // фикстура ЗасевРеестра — пулы и пакеты
Перем Учётки;           // фикстура СтендУчёток — админ хаба и посторонние
Перем Гвард;            // ГвардЭкранаПодписок — гвард домов пула и пакета: впускает учётку теста
Перем КонтроллерПула;   // КонтроллерДомаПула
Перем КонтроллерПакета; // КонтроллерДомаПакета
Перем Маршруты;         // МаршрутыХаба — настоящий маршрутизатор winow над контроллерами хаба
Перем Админ;            // учётка администратора хаба: выдаёт роли на любом объекте
Перем Пул;              // пул набора
Перем Пакет;            // пакет пула набора

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = КаталогиПроекта.Модули();
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, хранилище, публикация, реестр, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("почта, уведомления, вход, права, настройки, гео, сеть, кабинет, интерфейс/общее,"
		+ " интерфейс/панели/права");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ДомПула,ДомПакета,АдресаКаталога,ВитринаПравПула,ПультПравПула,"
		+ "ВитринаПравПакета,ПультПравПакета,ВитринаДомаПула,ВитринаДомаПакета,ПультПакета,"
		+ "КонтроллерДомаПула,КонтроллерДомаПакета", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

	РеестрФикстур.Подключить("ГвардЭкранаПодписок");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПорогРазделаПакетаЗаглушка");
	РеестрФикстур.Подключить("МаршрутыХаба");
	Маршруты = Новый МаршрутыХаба(Модули);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-прав-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Учётки = Новый СтендУчёток(Поделка);
	Админ = Учётки.Учётка("admin");
	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);
	Гвард = Новый ГвардЭкранаПодписок();

	СобратьКонтроллеры(Интерфейс);

КонецПроцедуры

// Дома собраны руками: витрины и пульты чужих разделов не нужны — их места пусты.
Процедура СобратьКонтроллеры(Знач Интерфейс)

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(Интерфейс);
	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Сборка, Желудь("СервисПрав"), UI.Тексты,
		Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));
	Страницы = Новый АдресаСтраниц();

	ДомПула = Новый ДомПула(Сборка, UI.Тексты, Страницы, Новый АдресаКаталога());
	ВитринаПула = Новый ВитринаДомаПула(UI.Кит, ДомПула, Желудь("СервисПулов"),
		Неопределено, Неопределено, Неопределено, Желудь("ВитринаПравПула"), Желудь("ПультПравПула"),
		Неопределено, Неопределено, Неопределено, UI.Тексты, Неопределено, Желудь("ОкноРаздела"));
	КонтроллерПула = Новый КонтроллерДомаПула(Гвард, Ответы, Желудь("ТекстСбоя"), ДомПула, ВитринаПула, Гейт,
		Защита, Желудь("РазборФормы"), Желудь("СервисПулов"), Неопределено, Желудь("ПультПравПула"),
		Неопределено, Неопределено, Неопределено, Новый ИтогПульта(), UI.Тексты, Желудь("ОтметкаСохранения"),
		Желудь("ОкноРаздела"));

	Порог = Новый ПорогРазделаПакетаЗаглушка(Ложь);
	ДомПакета = Новый ДомПакета(Сборка, ДомПула, Порог, Порог, UI.Тексты, Страницы);
	ВитринаПакета = Новый ВитринаДомаПакета(ДомПакета, ДомПула, Неопределено, Неопределено,
		Желудь("ВитринаПравПакета"), Желудь("ПультПравПакета"), Неопределено);
	КонтроллерПакета = Новый КонтроллерДомаПакета(Гвард, Ответы, Желудь("ТекстСбоя"), ДомПакета, ВитринаПакета,
		Новый ПультПакета(Неопределено, Неопределено, Желудь("ПультПравПакета"), Желудь("ИсходОкна")),
		Неопределено, Гейт, Защита, Желудь("СервисПакетов"), UI.Тексты, Страницы, Желудь("ОкноРаздела"));

КонецПроцедуры

&ПередКаждым
Процедура ВпуститьАдмина() Экспорт
	Гвард.Впустить(Админ, Пул, Пакет);
КонецПроцедуры

#Область Маршруты

// Адрес раздела прав обоих домов — дверь раздела дома в настоящем маршрутизаторе, окно — параметр
// адреса этой двери; серверной дороги «form» к окну выдачи больше нет.
&Тест
Процедура АдресРазделаПравУходитДвериРазделаДома() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл
		Обработчик = Маршруты.Обработчик(АдресРаздела(Дом));
		Ожидаем.Что(Обработчик <> Неопределено, "адрес обслуживается: " + Дом).ЭтоИстина();
		Ожидаем.Что(Обработчик.Контроллер + "." + Обработчик.Метод, "дверь раздела дома: " + Дом)
			.Равно(?(Дом = "пул", "КонтроллерДомаПула", "КонтроллерДомаПакета") + ".Раздел");

		Имена = ИменаПараметров(Контроллер(Дом), "Раздел");
		Ожидаем.Что(Имена.Найти("окно") <> Неопределено, "окно — параметр адреса раздела: " + Дом).ЭтоИстина();
		Ожидаем.Что(Имена.Найти("form"), "параметра form нет: " + Дом).Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОкноВыдачи

// Окно «Выдать роль» стоит на странице закрытым, кнопка в шапке секции — ссылка на ?окно=выдать;
// по этому адресу то же окно приходит открытым, незнакомое окно — страница без окна.
&Тест
Процедура ОкноВыдачиНаСтраницеИОткрытоПоАдресу() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Страница = Получить(Дом);
		Ожидаем.Что(Страница.Код, "раздел отдан: " + Дом).Равно(200);
		Ожидаем.Что(Страница.ТелоТекст, "окно выдачи на странице: " + Дом).Содержит("name=""субъект""");
		Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "на странице окно закрыто: " + Дом).Равно(0);
		Ожидаем.Что(Страница.ТелоТекст, "кнопка «Выдать роль» ведёт на адрес окна: " + Дом)
			.Содержит("href=""" + АдресРаздела(Дом) + "?" + Закодировать("окно") + "=" + Закодировать("выдать"));
		Ожидаем.Что(Страница.ТелоТекст, "без маркеров неизвестных ключей: " + Дом).Не_().Содержит("[?");

		Открытая = Получить(Дом, "окно=выдать");
		Окна = ОткрытыеОкна(Открытая.ТелоТекст);
		Ожидаем.Что(Окна.Количество(), "по адресу окно открыто: " + Дом).Равно(1);
		Ожидаем.Что(Окна[0], "в окне поле субъекта: " + Дом).Содержит("name=""субъект""");
		Ожидаем.Что(Окна[0], "в окне роль: " + Дом).Содержит("name=""роль""");
		Ожидаем.Что(Окна[0], "в окне тип субъекта сегментами: " + Дом).Содержит("name=""тип_субъекта""");
		// без скрипта окно по адресу не модальное: закрывает его ссылка на раздел без ?окно
		Ожидаем.Что(Окна[0], "открытое окно закрывает ссылка на раздел: " + Дом)
			.Содержит("href=""" + АдресРаздела(Дом) + """");

		Ожидаем.Что(ОткрытыеОкна(Получить(Дом, "окно=чужое").ТелоТекст).Количество(),
			"незнакомое окно — страница без окна: " + Дом).Равно(0);
		// старая серверная дорога к окну больше окна не открывает
		Ожидаем.Что(ОткрытыеОкна(Получить(Дом, "form=1").ТелоТекст).Количество(),
			"form=1 окна не открывает: " + Дом).Равно(0);

	КонецЦикла;

КонецПроцедуры

// Удача — 303 на раздел с отметкой; роль словами в строке таблицы, у строки — меню с отзывом по адресу.
&Тест
Процедура ВыдачаРолиУходит303ВРазделИВстаётВТаблицу() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Субъект = Учётки.Учётка();
		Ответ = Отправить(Дом, ФормаВыдачи(Субъект.Логин, "райтер"));

		Ожидаем.Что(Ответ.Код, "выдача — 303: " + Дом).Равно(303);
		Ожидаем.Что(Ответ.ПутьРедиректа, "обратно в раздел с отметкой: " + Дом)
			.Равно(АдресРаздела(Дом) + "?saved=1");
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "роль выдана: " + Дом).Равно("райтер");

		Строка_ = СтрокаТаблицы(Получить(Дом).ТелоТекст, Субъект.Логин);
		Ожидаем.Что(Строка_, "строка субъекта в таблице: " + Дом).Заполнено();
		Ожидаем.Что(Строка_, "роль словом: " + Дом).Содержит(">райтер<");
		Ожидаем.Что(Строка_, "тип словом: " + Дом).Содержит(">пользователь<");
		Ожидаем.Что(Строка_, "меню строки ведёт на подтверждение отзыва: " + Дом)
			.Содержит(Закодировать("отозвать-пользователь-" + Субъект.Логин));

	КонецЦикла;

КонецПроцедуры

// Неизвестный субъект — 400, окно выдачи открыто, поле помечено и набранное на месте; роли нет.
&Тест
Процедура ОтказВыдачиВОткрытомОкнеСНабранным() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Чужой = "nobody" + УникальныеИмена.Хвост();
		ГрантовДо = Желудь("СлужбаДоступа").ГрантыНаОбъект(ВидОбъекта(Дом), Объект(Дом).Идентификатор).Количество();

		Ответ = Отправить(Дом, ФормаВыдачи(Чужой, "мейнтейнер"));

		Ожидаем.Что(Ответ.Код, "отказ — 400: " + Дом).Равно(400);
		Окна = ОткрытыеОкна(Ответ.ТелоТекст);
		Ожидаем.Что(Окна.Количество(), "окно выдачи открыто: " + Дом).Равно(1);
		Ожидаем.Что(Тег(Окна[0], "input", "name=""субъект"""), "поле помечено: " + Дом).Содержит("aria-invalid");
		Ожидаем.Что(Тег(Окна[0], "input", "name=""субъект"""), "набранное на месте: " + Дом).Содержит(Чужой);
		Отказ = Экранировать(Желудь("ТекстыИнтерфейса").Текст(?(Дом = "пул", "settings.pool.access.error.subject",
			"settings.package.access.error.subject")));
		Ожидаем.Что(Окна[0], "отказ назван в окне: " + Дом).Содержит(Отказ);
		Ожидаем.Что(Тост(Ответ), "отказ под полем, а не тостом: " + Дом).Не_().Содержит(Отказ);
		Ожидаем.Что(Желудь("СлужбаДоступа").ГрантыНаОбъект(ВидОбъекта(Дом), Объект(Дом).Идентификатор).Количество(),
			"роли не выдано: " + Дом).Равно(ГрантовДо);

	КонецЦикла;

КонецПроцедуры

// Тип субъекта и роль — из белых списков окна: значение вне списка отбивается под своим полем
// в открытом окне выдачи, роли нет; КОНТРОЛЬ — та же форма с ролью из списка роль выдаёт.
&Тест
Процедура ТипИРольВнеСпискаОтбиваютсяПодПолем() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Субъект = Учётки.Учётка();
		Выбор = Экранировать(Желудь("ТекстыИнтерфейса").Текст("form.error.choice"));

		ЧужаяРоль = Отправить(Дом, "операция=" + Закодировать("выдать") + "&тип_субъекта="
			+ Закодировать("пользователь") + "&субъект=" + Субъект.Логин + "&роль=" + Закодировать("владелец"));
		Ожидаем.Что(ЧужаяРоль.Код, "роль вне списка — 400: " + Дом).Равно(400);
		Окна = ОткрытыеОкна(ЧужаяРоль.ТелоТекст);
		Ожидаем.Что(Окна.Количество(), "окно выдачи открыто: " + Дом).Равно(1);
		Ожидаем.Что(Тег(Окна[0], "select", "name=""роль"""), "поле роли помечено: " + Дом).Содержит("aria-invalid");
		Ожидаем.Что(Окна[0], "отказ под полем роли: " + Дом).Содержит(Выбор);
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "роли нет: " + Дом).Равно("");

		ЧужойТип = Отправить(Дом, "операция=" + Закодировать("выдать") + "&тип_субъекта=" + Закодировать("робот")
			+ "&субъект=" + Субъект.Логин + "&роль=" + Закодировать("райтер"));
		Ожидаем.Что(ЧужойТип.Код, "тип вне списка — 400: " + Дом).Равно(400);
		Ожидаем.Что(ОткрытыеОкна(ЧужойТип.ТелоТекст)[0], "отказ под типом: " + Дом).Содержит(Выбор);
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "и так роли нет: " + Дом).Равно("");

		// КОНТРОЛЬ: роль из списка, тип по умолчанию (поле не прислано) — пользователь
		Ответ = Отправить(Дом, "операция=" + Закодировать("выдать") + "&субъект=" + Субъект.Логин
			+ "&роль=" + Закодировать("райтер"));
		Ожидаем.Что(Ответ.Код, "КОНТРОЛЬ: выдано: " + Дом).Равно(303);
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "КОНТРОЛЬ: роль выдана: " + Дом).Равно("райтер");

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Отзыв

// Отзыв без подтверждения (без скрипта форма уходит сразу) — 303 на окно подтверждения, роль цела;
// окно по адресу называет субъекта и роль; подтверждённый отзыв снимает роль и ведёт в раздел.
&Тест
Процедура ОтзывТолькоПодтверждённый() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Субъект = Учётки.Учётка();
		Отправить(Дом, ФормаВыдачи(Субъект.Логин, "читатель"));
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "КОНТРОЛЬ: роль выдана: " + Дом).Равно("читатель");
		Отзыв = "операция=отозвать&тип_субъекта=" + Закодировать("пользователь") + "&субъект=" + Субъект.Логин;

		Вопрос = Отправить(Дом, Отзыв);
		Ожидаем.Что(Вопрос.Код, "без подтверждения — 303: " + Дом).Равно(303);
		Ожидаем.Что(Вопрос.ПутьРедиректа, "на окно подтверждения: " + Дом).Равно(АдресРаздела(Дом) + "?"
			+ Закодировать("окно") + "=" + Закодировать("отозвать-пользователь-" + Субъект.Логин));
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "роль цела: " + Дом).Равно("читатель");

		Окна = ОткрытыеОкна(Получить(Дом, "окно=" + Закодировать("отозвать-пользователь-" + Субъект.Логин)).ТелоТекст);
		Ожидаем.Что(Окна.Количество(), "подтверждение открыто по адресу: " + Дом).Равно(1);
		Ожидаем.Что(Окна[0], "названо, у кого: " + Дом).Содержит(Субъект.Логин);
		Ожидаем.Что(Окна[0], "названо, какую роль: " + Дом).Содержит("читатель");
		Ожидаем.Что(Окна[0], "кнопка шлёт подтверждение: " + Дом).Содержит("name=""confirmed""");

		Ответ = Отправить(Дом, Отзыв + "&confirmed=1");
		Ожидаем.Что(Ответ.Код, "подтверждённый отзыв — 303: " + Дом).Равно(303);
		Ожидаем.Что(Ответ.ПутьРедиректа, "обратно в раздел: " + Дом).Равно(АдресРаздела(Дом) + "?saved=1");
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "роль снята: " + Дом).Равно("");

		// окно отзыва субъекта без роли не печатается
		Ожидаем.Что(ОткрытыеОкна(Получить(Дом, "окно=" + Закодировать("отозвать-пользователь-" + Субъект.Логин))
			.ТелоТекст).Количество(), "у субъекта без роли окна нет: " + Дом).Равно(0);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Право

// Гвард дома не впустил — ни выдача, ни отзыв не отвечают и не меняют права, в журнал ничего
// не пишется; КОНТРОЛЬ — впущенный той же формой роль выдаёт.
&Тест
Процедура ПостороннийНиОднойФормойПраваНеМеняет() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Свой = Учётки.Учётка();
		Отправить(Дом, ФормаВыдачи(Свой.Логин, "райтер"));
		Новый_ = Учётки.Учётка();
		Журнал = Слушатель();

		Ответы = Новый Массив();
		Гвард.НеВпускать();
		Попытка
			Ответы.Добавить(Отправить(Дом, ФормаВыдачи(Новый_.Логин, "мейнтейнер")));
			Ответы.Добавить(Отправить(Дом, "операция=отозвать&тип_субъекта=" + Закодировать("пользователь")
				+ "&субъект=" + Свой.Логин + "&confirmed=1"));
		Исключение
			Гвард.Впустить(Админ, Пул, Пакет);
			ВызватьИсключение;
		КонецПопытки;
		Гвард.Впустить(Админ, Пул, Пакет);

		Для Каждого Ответ Из Ответы Цикл
			Ожидаем.Что(Ответ.Код, "гвард не впустил — 403: " + Дом).Равно(403);
			Ожидаем.Что(Строка(Ответ.ТелоТекст), "гвард не впустил — без тела: " + Дом).Равно("");
		КонецЦикла;
		Ожидаем.Что(РольСубъекта(Дом, Новый_), "новой роли нет: " + Дом).Равно("");
		Ожидаем.Что(РольСубъекта(Дом, Свой), "прежняя роль цела: " + Дом).Равно("райтер");
		Ожидаем.Что(Журнал.Количество(), "журнал прав пуст: " + Дом).Равно(0);

		// КОНТРОЛЬ: впущенный той же формой роль выдаёт, и выдача попадает в журнал
		Отправить(Дом, ФормаВыдачи(Новый_.Логин, "мейнтейнер"));
		Ожидаем.Что(РольСубъекта(Дом, Новый_), "КОНТРОЛЬ: впущенный выдаёт: " + Дом).Равно("мейнтейнер");
		Ожидаем.Что(Журнал.Количество(), "КОНТРОЛЬ: выдача в журнале: " + Дом).Равно(1);

	КонецЦикла;

КонецПроцедуры

// Кто вошёл в дом, но роли не раздаёт, видит таблицу без меню и строку «почему»; его форма — 403
// до домена: ни роли, ни попытки в журнале безопасности.
&Тест
Процедура БезПраваВыдаватьТаблицаБезМенюИФорма403ДоДомена() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Свой = Учётки.Учётка();
		Отправить(Дом, ФормаВыдачи(Свой.Логин, "читатель"));
		Посторонний = Учётки.Учётка();
		Новый_ = Учётки.Учётка();
		Журнал = Слушатель();

		Гвард.Впустить(Посторонний, Пул, Пакет);
		Попытка
			Страница = Получить(Дом);
			Ответ = Отправить(Дом, ФормаВыдачи(Новый_.Логин, "мейнтейнер"));
			// право выдавать судится раньше белого списка операций: форма старой вкладки — тоже 403
			Старая = Отправить(Дом, "операция=" + Закодировать("назначить") + "&субъект=" + Новый_.Логин);
		Исключение
			Гвард.Впустить(Админ, Пул, Пакет);
			ВызватьИсключение;
		КонецПопытки;
		Гвард.Впустить(Админ, Пул, Пакет);

		Ожидаем.Что(Страница.Код, "раздел виден: " + Дом).Равно(200);
		Ожидаем.Что(СтрокаТаблицы(Страница.ТелоТекст, Свой.Логин), "таблица на месте: " + Дом).Заполнено();
		Ожидаем.Что(Страница.ТелоТекст, "окна выдачи нет: " + Дом).Не_().Содержит("name=""субъект""");
		Ожидаем.Что(Страница.ТелоТекст, "меню отзыва нет: " + Дом).Не_().Содержит(Закодировать("отозвать-"));
		Ожидаем.Что(Страница.ТелоТекст, "строка «почему»: " + Дом).Содержит(Экранировать(Желудь("ТекстыИнтерфейса")
			.Текст(?(Дом = "пул", "settings.pool.access.readonly", "settings.package.access.readonly"))));

		Ожидаем.Что(Ответ.Код, "форма — 403: " + Дом).Равно(403);
		Ожидаем.Что(Старая.Код, "форма старой вкладки без права — 403, а не 400: " + Дом).Равно(403);
		Ожидаем.Что(РольСубъекта(Дом, Новый_), "роли нет: " + Дом).Равно("");
		Ожидаем.Что(Журнал.Количество(), "попытки в журнале нет: домен не звали: " + Дом).Равно(0);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СтараяВкладка

// Форма старой вкладки с операцией, которой страница не знает, — 400 «Страница устарела» без
// мутации; КОНТРОЛЬ — те же поля с операцией окна выдачи роль выдают.
&Тест
Процедура ФормаСтаройВкладкиОтбиваетсяБезМутации() Экспорт

	Для Каждого Дом Из СтрРазделить("пул,пакет", ",") Цикл

		Субъект = Учётки.Учётка();
		Поля = "тип_субъекта=" + Закодировать("пользователь") + "&субъект=" + Субъект.Логин
			+ "&роль=" + Закодировать("райтер");

		Старая = Отправить(Дом, "операция=" + Закодировать("назначить") + "&" + Поля);
		Ожидаем.Что(Старая.Код, "операция старой вкладки — 400: " + Дом).Равно(400);
		Ожидаем.Что(Тост(Старая), "причина названа: " + Дом).Содержит("Страница устарела");
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "роли нет: " + Дом).Равно("");

		БезОперации = Отправить(Дом, Поля);
		Ожидаем.Что(БезОперации.Код, "без операции — 400: " + Дом).Равно(400);
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "и так роли нет: " + Дом).Равно("");

		// КОНТРОЛЬ: те же поля с операцией окна выдачи роль выдают
		Отправить(Дом, "операция=" + Закодировать("выдать") + "&" + Поля);
		Ожидаем.Что(РольСубъекта(Дом, Субъект), "КОНТРОЛЬ: роль выдана: " + Дом).Равно("райтер");

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Пакет

// Роль на пуле наследуется пакетом: раздел пакета говорит это одной строкой со ссылкой на права пула.
&Тест
Процедура РазделПакетаСсылаетсяНаПраваПула() Экспорт

	Страница = Получить("пакет");
	Ожидаем.Что(Страница.ТелоТекст, "ссылка на права пула").Содержит("href=""" + АдресРаздела("пул") + """");

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Контроллер(Знач Дом)
	Возврат ?(Дом = "пул", КонтроллерПула, КонтроллерПакета);
КонецФункции

Функция ВидОбъекта(Знач Дом)
	Возврат Дом;
КонецФункции

Функция Объект(Знач Дом)
	Возврат ?(Дом = "пул", Пул, Пакет);
КонецФункции

Функция АдресРаздела(Знач Дом)
	Если Дом = "пул" Тогда
		Возврат "/pools/" + Пул.Имя + "/settings/access";
	КонецЕсли;
	Возврат "/pools/" + Пул.Имя + "/packages/" + Пакет.Имя + "/settings/access";
КонецФункции

Функция ФормаВыдачи(Знач Субъект, Знач Роль)
	Возврат "операция=" + Закодировать("выдать") + "&тип_субъекта=" + Закодировать("пользователь")
		+ "&субъект=" + Субъект + "&роль=" + Закодировать(Роль);
КонецФункции

// Роль субъекта на объекте дома по записям прав; "" — записи нет.
Функция РольСубъекта(Знач Дом, Знач Субъект)

	Служба = Желудь("СлужбаДоступа");
	Для Каждого Право Из Служба.ГрантыНаОбъект(ВидОбъекта(Дом), Объект(Дом).Идентификатор) Цикл
		Если Право.ТипСубъекта = "пользователь" И Цел(Право.СубъектИдентификатор) = Цел(Субъект.Идентификатор) Тогда
			Возврат Служба.РольЗаписи(Право);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Слушатель журнала прав: выдача, отзыв и отказ в управлении правами.
Функция Слушатель()
	Издатель = Желудь("ИздательСобытий");
	Результат = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПраваИзменены(), Результат);
	Возврат Результат;
КонецФункции

// GET раздела прав: параметры адреса — строкой запроса.
Функция Получить(Знач Дом, Знач Запрос = "")
	Возврат Вызвать(Дом, "GET", "", Запрос);
КонецФункции

// POST формы на адрес раздела прав.
Функция Отправить(Знач Дом, Знач Тело)
	Возврат Вызвать(Дом, "POST", "_csrf=токен-теста&" + Тело, "");
КонецФункции

// Дверь раздела дома зовётся по именам параметров: так набор не зависит от их порядка.
Функция Вызвать(Знач Дом, Знач Метод, Знач Тело, Знач Запрос)

	Ответ = Новый ОтветСтраницыЗаглушка();
	Значения = Параметры(Запрос);
	Значения.Вставить("Ответ", Ответ);
	Значения.Вставить("pool", Пул.Имя);
	Значения.Вставить("name", Пакет.Имя);
	Значения.Вставить("раздел", "access");
	Значения.Вставить("ЗаголовкиЗапроса", Новый Соответствие());
	Значения.Вставить("КукиЗапроса", Новый КукиЗаглушка());
	Значения.Вставить("МетодЗапроса", Метод);
	Значения.Вставить("ТелоЗапроса", Тело);

	Аргументы = Новый Массив();
	Для Каждого Имя Из ИменаПараметров(Контроллер(Дом), "Раздел") Цикл
		Аргументы.Добавить(Значения.Получить(Имя));
	КонецЦикла;
	Рефлектор = Новый Рефлектор();
	Рефлектор.ВызватьМетод(Контроллер(Дом), "Раздел", Аргументы);
	Возврат Ответ;

КонецФункции

Функция ИменаПараметров(Знач Объект, Знач ИмяМетода)

	Результат = Новый Массив();
	Рефлектор = Новый Рефлектор();
	Метод = Рефлектор.ПолучитьТаблицуМетодов(Объект).Найти(ИмяМетода, "Имя");
	Для Каждого Параметр Из Метод.Параметры Цикл
		Результат.Добавить(Параметр.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Параметры(Знач Запрос)

	Результат = Новый Соответствие();
	Для Каждого Пара Из СтрРазделить(Запрос, "&", Ложь) Цикл
		Равно = СтрНайти(Пара, "=");
		Результат.Вставить(Раскодировать(Лев(Пара, Равно - 1)), Раскодировать(Сред(Пара, Равно + 1)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Тост(Знач Ответ)
	Результат = Новый Массив();
	Для Каждого Кусок Из Куски(Ответ.ТелоТекст, "toast__text"">") Цикл
		Хвост = Сред(Кусок, СтрДлина("toast__text"">") + 1);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, "<") - 1));
	КонецЦикла;
	Возврат СтрСоединить(Результат, " / ");
КонецФункции

// Строка таблицы, где субъект назван целиком: от её <tr до следующей.
Функция СтрокаТаблицы(Знач HTML, Знач Имя)
	Для Каждого Строка_ Из Куски(HTML, "<tr") Цикл
		Если СтрНайти(Строка_, ">" + Имя + "<") > 0 Тогда
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Куски разметки, каждый — от начала образца до следующего такого же.
Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Экранировать(Знач Текст)
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "&", "&amp;"), "<", "&lt;"), ">", "&gt;");
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
