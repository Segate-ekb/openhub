// Пресет темы — решение инсталляции: настройка oshub.ui.preset (умолчание, пресеты кита, чужое значение)
// и страница посетителя в этом пресете — каркасом кита поверх настоящего оформления хаба и настоящих
// настроек в контейнере (база — в памяти). Личные тема и акцент ложатся поверх; «Вид и язык» пресета
// не даёт.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Настройки;     // СервисНастроек — настоящие значения реестра
Перем Токены;        // ТокеныТемы (кит) — пресеты и их цвета

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");
	Слои.ПодключитьТаблицы("уведомления");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	Слои.Подключить("основа");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("вход, права, настройки, гео, сеть, хранилище, почта, интерфейс/общее");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "ВитринаВидаИЯзыка");

	РеестрФикстур.Подключить("КукиЗаглушка");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "пресет-темы-инсталляции-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();

	Настройки = Желудь("СервисНастроек");
	Токены = Желудь("ТокеныТемы");

КонецПроцедуры

&ПередКаждым
Процедура ВернутьУмолчания() Экспорт
	Для Каждого Ключ Из СтрРазделить("oshub.ui.preset,oshub.ui.theme,oshub.ui.accent", ",") Цикл
		Настройки.Сбросить(Ключ, "тест");
	КонецЦикла;
КонецПроцедуры

#Область Настройка

// Без правки инсталляция — в пресете кита по умолчанию; так печатается и страница, какой она была
// до пресетов.
&Тест
Процедура ПоУмолчаниюПресетКитаПоУмолчанию() Экспорт

	Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "умолчание настройки").Равно(Токены.ПресетПоУмолчанию());
	Ожидаем.Что(Настройки.Источник("oshub.ui.preset"), "и оно не введено руками").Равно("дефолт");
	Ожидаем.Что(Желудь("ОформлениеИнсталляции").Оформление().Пресет, "оформление инсталляции отдаёт его киту")
		.Равно(Токены.ПресетПоУмолчанию());

КонецПроцедуры

// Допустимое — ровно пресеты кита: каждый записывается, а чужой ключ отказывает и ничего не меняет.
&Тест
Процедура ПринимаютсяРовноПресетыКита() Экспорт

	Ключи = Новый Массив();
	Для Каждого Описание Из Токены.Пресеты() Цикл
		Ключи.Добавить(Описание.Ключ);
		Настройки.Установить("oshub.ui.preset", Описание.Ключ, "тест");
		Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "пресет кита записан: " + Описание.Ключ)
			.Равно(Описание.Ключ);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Желудь("РеестрНастроек").Описание("oshub.ui.preset").Валидатор.Значения, ","),
		"перечень настройки — перечень кита, без лишних").Равно(СтрСоединить(Ключи, ","));

	Отказ = "";
	Попытка
		Настройки.Установить("oshub.ui.preset", "neon", "тест");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "чужой пресет отказан и назван").Содержит("neon");
	Ожидаем.Что(Настройки.Значение("oshub.ui.preset"), "действующий не тронут").Равно(Ключи[Ключи.ВГраница()]);

КонецПроцедуры

#КонецОбласти

#Область Страница

// Гость без своей куки видит страницу в пресете инсталляции — в обеих темах: роли схемы — цвета
// пресета, как их считает кит. КОНТРОЛЬ — до правки на странице схема по умолчанию.
&Тест
Процедура ГостьВидитСтраницуВПресетеИнсталляции() Экспорт

	До = СтраницаГостя(Неопределено);
	Ожидаем.Что(До, "КОНТРОЛЬ: до правки — не oscript").ЭтоНе()
		.Содержит(Роль(Токены.ЦветаПресета("oscript", Ложь), "primary"));

	Настройки.Установить("oshub.ui.preset", "oscript", "тест");
	Страница = СтраницаГостя(Неопределено);

	Светлая = Блок(Страница, "html[data-theme=""light""]{");
	Тёмная = Блок(Страница, ":root{");
	Ожидаем.Что(Светлая, "светлая тема — акцент oscript")
		.Содержит(Роль(Токены.ЦветаПресета("oscript", Ложь), "primary"));
	Ожидаем.Что(Тёмная, "тёмная — акцент oscript тёмной")
		.Содержит(Роль(Токены.ЦветаПресета("oscript", Истина), "primary"));
	Ожидаем.Что(Светлая, "и поверхности пресета").Содержит(Роль(Токены.ЦветаПресета("oscript", Ложь), "surface"));
	Ожидаем.Что(Тёмная, "в тёмной тоже").Содержит(Роль(Токены.ЦветаПресета("oscript", Истина), "surface"));

КонецПроцедуры

// Личный акцент посетителя ложится на затравку пресета инсталляции, нейтраль остаётся пресета;
// личная тема выбирает тему страницы, пресет не трогает.
&Тест
Процедура ЛичныеТемаИАкцентЛожатсяПоверхПресета() Экспорт

	Настройки.Установить("oshub.ui.preset", "classic", "тест");
	Страница = СтраницаГостя("тема=светлая&акцент=#2bb673");

	Ожидаем.Что(Страница, "тема страницы — личная").Содержит("data-theme=""light""");
	Светлая = Блок(Страница, "html[data-theme=""light""]{");
	Ожидаем.Что(Светлая, "акцент — личный поверх пресета")
		.Содержит(Роль(Токены.ЦветаПресета("classic", Ложь, "#2bb673"), "primary"));
	Ожидаем.Что(Светлая, "поверхности — пресета инсталляции")
		.Содержит(Роль(Токены.ЦветаПресета("classic", Ложь, "#2bb673"), "surface"));
	Ожидаем.Что(Светлая, "КОНТРОЛЬ: не поверхности схемы по умолчанию").ЭтоНе()
		.Содержит(Роль(Токены.ЦветаПресета(Токены.ПресетПоУмолчанию(), Ложь, "#2bb673"), "surface"));

КонецПроцедуры

#КонецОбласти

#Область ВидИЯзык

// Пресет — решение инсталляции: в «Виде и языке» его не выбирают, и кука оформления, которую пишет
// раздел, пресета не несёт — после сохранения посетитель снова в пресете инсталляции.
&Тест
Процедура ВидИЯзыкПресетаНеДаёт() Экспорт

	Витрина = Желудь("ВитринаВидаИЯзыка");
	// форма раздела берёт адрес у дома вокруг
	Разметка = Желудь("Кит").ДомНастроек("Аккаунт", "/me/settings", "т0кен", Витрина.Секция(Неопределено))
		.Рендер();

	Ожидаем.Что(Разметка, "КОНТРОЛЬ: тема в разделе есть").Содержит("name=""тема""");
	Ожидаем.Что(Разметка, "и акцент").Содержит("name=""акцент""");
	Для Каждого Описание Из Токены.Пресеты() Цикл
		Ожидаем.Что(Разметка, "пресета «" + Описание.Ключ + "» на выбор нет").ЭтоНе()
			.Содержит("value=""" + Описание.Ключ + """");
	КонецЦикла;

	Форма = Новый Соответствие();
	Форма.Вставить("тема", "светлая");
	Форма.Вставить("акцент", "#2bb673");
	Форма.Вставить("пресет", "classic");
	Значение = Витрина.ЗначениеCookie(Форма, Желудь("РазборФормы"));
	Ожидаем.Что(Значение, "КОНТРОЛЬ: тема и акцент записаны").Содержит("акцент=#2bb673");
	Ожидаем.Что(Значение, "пресета в куке нет, даже присланного").ЭтоНе().Содержит("пресет");

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Страница посетителя без входа: каркас кита с оформлением хаба из контейнера; кука — значение cookie
// оформления. Цветов обрамление не задаёт, поэтому оно здесь кита по умолчанию: обрамлению хаба
// нужны лента уведомлений и входящие, которых в этом контейнере нет.
Функция СтраницаГостя(Знач Кука)

	Куки = Новый КукиЗаглушка();
	Если Кука <> Неопределено Тогда
		Куки.Добавить(Желудь("ОформлениеИнсталляции").ИмяCookieОформления(), Кука);
	КонецЕсли;
	Каркас = Новый КаркасСтраницы(Желудь("Кит"), Токены, Желудь("ВыборОформления"), Желудь("ТекстыИнтерфейса"),
		Желудь("ЧтениеМодели"), Желудь("АктивыСтатики"), Новый ОбрамлениеИнсталляцииПоУмолчанию(),
		Желудь("МенюХаба"));
	Возврат Каркас.Страница("Главная", "<p>тело</p>", Каркас.КонтекстСтраницы(Неопределено, Куки));

КонецФункции

// Объявление роли схемы из CSS кита: «--md-sys-color-<роль>:<значение>;».
Функция Роль(Знач Цвета, Знач Имя)

	Начало = СтрНайти(Цвета, "--md-sys-color-" + Имя + ":");
	Ожидаем.Что(Начало > 0, "у пресета есть роль " + Имя).ЭтоИстина();
	Хвост = Сред(Цвета, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ";"));

КонецФункции

// Блок переменных одной темы в голове страницы: от селектора до закрывающей скобки.
Функция Блок(Знач HTML, Знач Селектор)

	Начало = СтрНайти(HTML, Селектор);
	Ожидаем.Что(Начало > 0, "на странице есть блок " + Селектор).ЭтоИстина();
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "}"));

КонецФункции

#КонецОбласти
