#КонецОбласти

#Область Брендирование

&Тест
Процедура БрендированиеМеняетВидБезПравкиШаблонов() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.ui.brand", "Хаб Ромашка");
	Настройки.Задать("oshub.ui.tagline", "Внутренний хаб пакетов компании");
	Настройки.Задать("oshub.ui.theme", "светлая");
	Настройки.Задать("oshub.ui.accent", "#ff8800");

	Свой = Новый Брендирование(Настройки);
	ОбрамлениеСвоё = Новый ОбрамлениеХаба(Свой, UI.Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), UI.Тексты,
		UI.АдресаКаталога, Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит, UI.Подсветка);
	РендерерСвой = Новый КаркасСтраницы(UI.Кит, UI.Токены,
		Новый ВыборОформления(Новый ОформлениеХаба(Настройки)), UI.Тексты, UI.Модели,
		UI.Активы, ОбрамлениеСвоё, UI.МенюХаба);

	Наш = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Чужой = РендерерСвой.Страница("Каталог", "<p>тело</p>",
		РендерерСвой.КонтекстСтраницы(Неопределено, Неопределено));

	Ожидаем.Что(СтрНайти(Чужой, "Хаб Ромашка") > 0, "знак инсталляции в разметке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, "<title>Каталог — Хаб Ромашка</title>") > 0, "знак в заголовке вкладки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, "Внутренний хаб пакетов компании") > 0, "подпись подвала").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, UI.Токены.Переменные(Новый Структура("Акцент", "#ff8800"))) > 0,
		"акцент инсталляции: схема цветов выведена из него").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Наш, UI.Токены.Переменные(Новый Структура("Акцент", "#ff8800"))),
		"КОНТРОЛЬ: у инсталляции по умолчанию схема своя").Равно(0);
	Ожидаем.Что(СтрНайти(Чужой, ТегHTML("light")) > 0, "тема инсталляции").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Наш, "Хаб Ромашка"), "чужой знак не протёк в инсталляцию по умолчанию").Равно(0);
	Ожидаем.Что(СтрНайти(Наш, UI.Бренд.ЗнакПоУмолчанию()) > 0, "знак по умолчанию на месте").ЭтоИстина();

	Настройки.Задать("oshub.ui.brand", "   ");
	Настройки.Задать("oshub.ui.tagline", "");
	Ожидаем.Что(Свой.Знак()).Равно(UI.Бренд.ЗнакПоУмолчанию());
	Ожидаем.Что(Свой.Подпись()).Равно(UI.Бренд.ПодписьПоУмолчанию());

КонецПроцедуры

&Тест
Процедура ЗнакИнсталляцииНеЗашитВШаблоныСлояКаркаса() Экспорт

	Литералы = Новый Массив();
	Литералы.Добавить(UI.Бренд.ЗнакПоУмолчанию());
	Литералы.Добавить(UI.Бренд.ПодписьПоУмолчанию());

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыКорпуса Цикл
		Если ИмяФайлаБезПути(Файл.Ключ) = "Брендирование.os" Тогда
			Продолжить;
		КонецЕсли;
		Текст = Исходники.Текст(Файл.Значение);
		Если НЕ ПечатаетРазметку(Файл.Ключ, Текст) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Литерал Из Литералы Цикл
			Если СодержитОтдельноеСлово(Текст, Литерал) Тогда
				Нарушители.Добавить(Файл.Ключ + ": «" + Литерал + "»");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"брендирование зашито в шаблон — оно перестанет меняться деталькой").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СканыСлояПредставления

&Тест
Процедура ВСтатическомCSSНетМёртвыхПравил() Экспорт

	Живые = ЛитералыСлояПредставления();
	Мёртвые = Новый Массив();

	// pre.shiki печатает не слой, а сама shiki в браузере: её ставит на страницу тег подсветки
	// oscript-md (MarkdownПодсветка.ТегСкрипта у README пакета), правило кита для неё живо, пока
	// хаб этот тег ставит
	Если ПечатаетсяВКорпусе("MarkdownПодсветка.ТегСкрипта(") Тогда
		Живые.Вставить("shiki", Истина);
	КонецЕсли;

	Для Каждого Класс Из КлассыИзCSS(ТекстCSS()) Цикл
		Если НЕ КлассЖивой(Класс, Живые) Тогда
			Мёртвые.Добавить(Класс);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Мёртвые, ", "),
		"правила CSS, которых не печатает ни один .os слоя представления").Равно("");

КонецПроцедуры

// var(--имя) без объявления браузер отбрасывает вместе со всем объявлением: правило
// молча перестаёт работать, а глазами это не видно — в тексте таблицы стилей всё на месте.
&Тест
Процедура КаждаяПеременнаяСтатикиОбъявленаВТокенахТемы() Экспорт

	Разбор = РазборСтилей();
	ТокеныCSS = UI.Токены.Переменные();

	// объявления берутся ПО ПРАВИЛАМ: токен, объявленный внутри чужого правила, глобальным
	// не становится, а склейка обеих палитр прячет тему, из которой цвет пропал
	Тёмная = ОбъявленияТемы(ТокеныCSS, ":root");
	Светлая = ОбъявленияТемы(ТокеныCSS, "html[data-theme=""light""]");
	Объявленные = Объединение(Тёмная, Светлая);

	// приватную переменную компонента («--_bg») объявляет правило самого компонента в листе
	// кита: токеном темы она не бывает, но и без объявления в листах страницы не живёт
	ИзЛистов = Разбор.ИспользованныеПеременные(ТекстCSS());
	ИзСтатики = Новый Массив();
	Приватные = Новый Массив();
	Для Каждого Имя Из ИзЛистов Цикл
		Если СтрНачинаетсяС(Имя, "--_") Тогда
			Приватные.Добавить(Имя);
		ИначеЕсли Имя = "--mirror-accent" Тогда
			// свойство зеркала поля «accent» объявляет узел кита атрибутом style (Зеркало(Имя, Цвет)
			// и скрипт), а правило листа кита с ним выбирает только узлы, у которых оно есть
			Продолжить;
		Иначе
			ИзСтатики.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	ИзТокенов = Разбор.ИспользованныеПеременные(ТокеныCSS);

	Ожидаем.Что(ИзСтатики.Количество() > 20,
		СтрШаблон("var(--…) в листах страницы найдено: %1 — сканер не ослеп",
			ИзСтатики.Количество())).ЭтоИстина();
	Ожидаем.Что(Тёмная.Количество() > 40,
		СтрШаблон("токенов тёмной темы разобрано: %1 — разбор источника не ослеп",
			Тёмная.Количество())).ЭтоИстина();
	Ожидаем.Что(Светлая.Количество() > 20,
		СтрШаблон("токенов светлой темы разобрано: %1 — разбор источника не ослеп",
			Светлая.Количество())).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(ИзСтатики, Объявленные), ", "),
		"var(--…) в листах страницы, которых не объявляет ТокеныТемы: браузер отбрасывает"
			+ " такое объявление целиком, правило не работает").Равно("");

	НеобъявленныеПриватные = Новый Массив();
	Для Каждого Имя Из Приватные Цикл
		Если СтрНайти(ТекстCSS(), Имя + ":") = 0 Тогда
			НеобъявленныеПриватные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(НеобъявленныеПриватные, ", "),
		"приватные var(--_…), которых не объявляет ни одно правило листов страницы").Равно("");

	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(ИзТокенов, Объявленные), ", "),
		"токен темы ссылается на переменную, которой сам не объявляет (тени и рампы"
			+ " собираются из цветов палитры)").Равно("");

	// Тема по умолчанию тёмная: цвет только в светлой палитре убил бы правило у большинства,
	// обратный перекос делает светлую тему копией тёмной — наборы цветов обязаны совпадать.
	// Цвет, выведенный из роли («--color-bg: var(--md-sys-color-surface)», «color-mix(…var(…))»),
	// объявлен один раз в :root: своего значения у него нет, он берёт роль той темы,
	// в которой стоит страница
	Тёмная = БезПсевдонимов(Тёмная, ТокеныCSS);
	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(Цвета(Светлая), Тёмная), ", "),
		"цвета, объявленные ТОЛЬКО в светлой палитре: в тёмной теме (она по умолчанию)"
			+ " правила с ними не работают").Равно("");
	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(Цвета(Тёмная), Светлая), ", "),
		"цвета, объявленные ТОЛЬКО в тёмной палитре: светлая тема наследует тёмное"
			+ " значение").Равно("");

КонецПроцедуры

// Разбор переменных ловит формы записи, на которых сканер молча слепнет: запасное
// значение, произвольные пробелы, несколько var() в объявлении, собственный комментарий.
&Тест
Процедура СканПеременныхНеПитаетсяКомментариямиИВидитЗапасныеЗначения() Экспорт

	Разбор = РазборСтилей();

	Приманка = "/* var(--из-комментария) — только текст */" + Символы.ПС
		+ ".a { color: var( --с-пробелом , #fff); border: 1px solid var(--первый) var(--второй); }"
		+ Символы.ПС
		+ ".b { box-shadow: 0 0 0 1px var(--внешний, var(--вложенный)); }" + Символы.ПС
		+ ".c { border: 1px solid/*пояснение*/var(--за-комментарием); }" + Символы.ПС
		+ ".d::before { content: ""var(--из-литерала)""; }" + Символы.ПС
		+ ".button--link:hover { text-decoration: underline; }";

	Имена = Разбор.ИспользованныеПеременные(Приманка);

	Ожидаем.Что(Имена.Найти("--с-пробелом") <> Неопределено,
		"пробелы внутри var() и запасное значение").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--первый") <> Неопределено И Имена.Найти("--второй") <> Неопределено,
		"два var() в одном объявлении").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--вложенный") <> Неопределено,
		"var() внутри запасного значения").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--за-комментарием") <> Неопределено,
		"комментарий вплотную к var(): склейка соседей теряла бы использование молча")
		.ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--из-комментария") = Неопределено,
		"имя из комментария CSS использованием не считается").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--из-литерала") = Неопределено,
		"имя внутри строкового литерала (content) переменной не использует").ЭтоИстина();
	Ожидаем.Что(Имена.Количество(), "лишнего в выборке нет").Равно(6);

	Объявления = Разбор.ОбъявленныеПеременные(
		"--объявленный:#fff;--через-пробел : 4px;--тень:0 0 0 1px var(--объявленный);");

	Ожидаем.Что(Объявления.Найти("--объявленный") <> Неопределено, "простое объявление").ЭтоИстина();
	Ожидаем.Что(Объявления.Найти("--через-пробел") <> Неопределено,
		"пробел перед двоеточием").ЭтоИстина();
	Ожидаем.Что(Объявления.Найти("--тень") <> Неопределено, "объявление со ссылкой внутри").ЭтоИстина();
	Ожидаем.Что(Объявления.Количество(),
		"var(--x) в значении объявлением не считается").Равно(3);

	// область видимости: объявление живёт в своём правиле, а не во всей таблице
	Внутри = ОбъявленияТемы(":root{--свой:1px;}.чужой{--чужой:2px;}", ":root");
	Ожидаем.Что(Внутри.Найти("--свой") <> Неопределено, "объявление своего правила видно").ЭтоИстина();
	Ожидаем.Что(Внутри.Найти("--чужой") = Неопределено,
		"объявление ЧУЖОГО правила глобальным не становится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаждыйКлассРазметкиИмеетПравилоВCSS() Экспорт

	Правила = КлассыИзCSS(ТекстCSS());
	Исключения = ИсключенияКлассовБезПравила();
	Сироты = Новый Массив();
	Использованные = Новый Соответствие();

	Для Каждого КиЗ Из КлассыРазметкиСлоя() Цикл
		Если Правила.Найти(КиЗ.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Исключения.Получить(КиЗ.Ключ) <> Неопределено Тогда
			Использованные.Вставить(КиЗ.Ключ, Истина);
			Продолжить;
		КонецЕсли;
		Сироты.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
	КонецЦикла;

	Неиспользованные = Новый Массив();
	Для Каждого КиЗ Из Исключения Цикл
		Если Использованные.Получить(КиЗ.Ключ) = Неопределено Тогда
			Неиспользованные.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Сироты, ", "),
		"классы разметки, для которых нет правила в статике").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: класс получил правило или исчез из разметки")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ЛегасиКлассыДержатсяТолькоПоЯвномуСписку() Экспорт

	Нарушители = Новый Массив();
	Неиспользованные = Новый Массив();
	Ожидания = ЛегасиИсключения();
	Файлы = ФайлыКорпуса;

	ПотерянныеКлючи = Корпус.НетВКорпусе(Ожидания, Файлы);

	Для Каждого Файл Из Файлы Цикл

		Разрешённые = Ожидания.Получить(Файл.Ключ);
		Найденные = ЛегасиКлассыФайла(Исходники.Текст(Файл.Значение));

		Для Каждого Класс Из Найденные Цикл
			Если Разрешённые = Неопределено ИЛИ СтрНайти(" " + Разрешённые + " ", " " + Класс + " ") = 0 Тогда
				Нарушители.Добавить(Файл.Ключ + ": " + Класс);
			КонецЕсли;
		КонецЦикла;

		Если Разрешённые <> Неопределено Тогда
			Для Каждого Класс Из СтрРазделить(Разрешённые, " ", Ложь) Цикл
				Если Найденные.Найти(Класс) = Неопределено Тогда
					Неиспользованные.Добавить(Файл.Ключ + ": " + Класс);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"новые легаси-классы в разметке (кит их заменяет — см. НаборКомпонентов)").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: экран переведён, удалите строку из ЛегасиИсключения()")
		.Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКлючи, ", "),
		"исключения для несуществующих файлов: файл переименован или удалён").Равно("");

КонецПроцедуры

&Тест
Процедура КонтроллерыНеРисуютРазметкуМимоКита() Экспорт

	Нарушители = Новый Массив();
	Неиспользованные = Новый Массив();
	Ожидания = ИсключенияСыройРазметки();
	Файлы = ФайлыКорпуса;

	ПотерянныеКлючи = Корпус.НетВКорпусе(Ожидания, Файлы);

	Для Каждого Файл Из Файлы Цикл

		Текст = Исходники.Текст(Файл.Значение);
		Если НЕ СобирающийРазметкуФайл(ИмяФайлаБезПути(Файл.Ключ), Текст) Тогда
			Продолжить;
		КонецЕсли;

		Найденные = Новый Массив();
		Для Каждого Тег Из ТегиКита() Цикл
			Если СтрНайти(Текст, Тег) > 0 Тогда
				Найденные.Добавить(Тег);
			КонецЕсли;
		КонецЦикла;

		Разрешённые = Ожидания.Получить(Файл.Ключ);

		Для Каждого Тег Из Найденные Цикл
			Если Разрешённые = Неопределено ИЛИ СтрНайти(" " + Разрешённые + " ", " " + Тег + " ") = 0 Тогда
				Нарушители.Добавить(Файл.Ключ + ": " + Тег);
			КонецЕсли;
		КонецЦикла;

		Если Разрешённые <> Неопределено Тогда
			Для Каждого Тег Из СтрРазделить(Разрешённые, " ", Ложь) Цикл
				Если Найденные.Найти(Тег) = Неопределено Тогда
					Неиспользованные.Добавить(Файл.Ключ + ": " + Тег);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"разметка мимо кита (возьмите Кнопку/Таблицу из набора)").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: экран переведён на кит").Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКлючи, ", "),
		"исключения для несуществующих файлов: файл переименован или удалён").Равно("");

КонецПроцедуры

#КонецОбласти

#Область КлючиСтрок

&Тест
Процедура СловарьНеГоворитПользователюСловоГрант() Экспорт

	Найденные = Новый Массив();

	Для Каждого Ключ Из UI.СловарьТекстов.Ключи() Цикл
		Текст = UI.СловарьТекстов.НайтиТекст(Ключ);
		Если Текст <> Неопределено И СтрНайти(НРег(Строка(Текст)), "грант") > 0 Тогда
			Найденные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Найденные, ", "),
		"тексты со словом «грант»: переименуйте на «право доступа» (В-1)").Равно("");

КонецПроцедуры

// Граница сторожа — ТЕКСТ, который читают глазами: через словарь проходит вся выдача
// интерфейса. Имена ключей словаря, поля форм, операции, типы событий, колонки сущностей
// и поля API остаются английскими: они внешние.
&Тест
Процедура ПользовательскиеТекстыНеГоворятYank() Экспорт

	Найденные = Новый Массив();

	Для Каждого Ключ Из UI.СловарьТекстов.Ключи() Цикл
		Текст = UI.СловарьТекстов.НайтиТекст(Ключ);
		Если Текст <> Неопределено И СтрНайти(НРег(Строка(Текст)), "yank") > 0 Тогда
			Найденные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Найденные, ", "),
		"тексты со словом «yank»: пользователю пишем «отзыв» и «отозвать»").Равно("");

	// самотест: сканируем наполненный словарь, а не пустой список
	Ожидаем.Что(UI.СловарьТекстов.Ключи().Количество() > 50, "словарь прочитан").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтдающиеHTMLОтветчикиЭкранируютСообщениеСами() Экспорт

	Итог = НовыйИтогОтветчиков();
	ФайлыКлассов = ФайлыМодуля();

	Для Каждого Файл Из ФайлыКлассов Цикл
		РазложитьОтветчиков(Исходники.Текст(Файл.Значение), ИмяФайлаБезПути(Файл.Ключ), Итог);
	КонецЦикла;

	Двойные = Новый Массив();
	Для Каждого Файл Из ФайлыКлассов Цикл
		Текст = Исходники.Текст(Файл.Значение);
		Для Каждого Вызов Из ВызовыОтветчиков(Текст) Цикл
			Если Итог.Сырые.Найти(Вызов.Имя) <> Неопределено
				И СтрНайти(Вызов.Аргументы, "Экранировать(") > 0 Тогда
				Двойные.Добавить(ИмяФайлаБезПути(Файл.Ключ) + ":" + Вызов.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Итог.Сырые.Количество() >= 3,
		"скан вообще находит ответчиков на сыром входе (нашёл "
		+ Итог.Сырые.Количество() + ")").ЭтоИстина();
	// ответчиков НА ДОВЕРЕННОЙ РАЗМЕТКЕ может не остаться вовсе: экран, собранный деревом, отдаёт
	// элемент; умение скана отличать такой контракт от сырого доказывает образец ниже
	Ожидаем.Что(СтрСоединить(Итог.БезЭкранирования, ", "),
		"ответчики, не экранирующие Сообщение: контракт слоя — экранирует ПОЛУЧАТЕЛЬ").Равно("");
	Ожидаем.Что(СтрСоединить(Итог.ЛишнееЭкранирование, ", "),
		"СообщениеHTML экранировать нельзя: разметка вызывающего станет «&lt;a»").Равно("");
	Ожидаем.Что(СтрСоединить(Двойные, ", "),
		"вызовы, экранирующие аргумент: получатель экранирует сам, будет «&amp;lt;»").Равно("");

	Проба = НовыйИтогОтветчиков();
	РазложитьОтветчиков(ОбразецОтветчиков(), "образец", Проба);

	Ожидаем.Что(Проба.Сырые.Количество(),
		"в образце два ответчика на сыром входе (забывший и компонентный)").Равно(2);
	Ожидаем.Что(Проба.Доверенные.Количество(), "и один на доверенной разметке").Равно(1);
	Ожидаем.Что(СтрСоединить(Проба.БезЭкранирования, ", "),
		"скан видит ответчика, забывшего экранировать Сообщение, но НЕ компонентную форму")
		.Равно("образец:ОтдатьПробуНеНайдено");
	Ожидаем.Что(СтрСоединить(Проба.ЛишнееЭкранирование, ", "),
		"и ответчика, экранирующего доверенную разметку").Равно("образец:ОтдатьПробуДоверенное");

КонецПроцедуры

