Функция ТегиКита()
	Результат = Новый Массив();
	Результат.Добавить("<button"); // → компонент Кнопка
	Результат.Добавить("<table");  // → компонент Таблица
	Результат.Добавить("<input");  // → компоненты СкрытоеПоле / Поле / Тумблер
	Результат.Добавить("<h1");     // → компонент ЗаголовокСтраницы
	Результат.Добавить("<h2");     // → компонент ЗаголовокСтраницы, Уровень = 2
	Возврат Результат;
КонецФункции

Функция ИсключенияСыройРазметки()

	Результат = Новый Соответствие();

	Результат.Вставить("кит/РендерерНастроек.os", "<h1");
	// <table> печатает слой элементов кита раскладочным родом, а не компонент Таблица
	Результат.Вставить("кит/РазметкаЭлементов.os", "<table");
	// рисователи узлов кита печатают свои элементы сами: они и есть кит
	Результат.Вставить("кит/Окно.os", "<h2");
	Результат.Вставить("кит/Шаги.os", "<button");
	Результат.Вставить("кит/Подсказка.os", "<button");
	Результат.Вставить("кит/Образец.os", "<button");
	Результат.Вставить("кит/Свойства.os", "<button <input");
	Результат.Вставить("кит/Сегменты.os", "<input");
	Результат.Вставить("кит/СлотКартинки.os", "<input");
	// пилюлю темы печатает сам каркас кита: кнопка с ролью переключателя, дорожкой и бегунком
	Результат.Вставить("кит/КаркасСтраницы.os", "<button");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебное

// Тег <html> ровно в том виде, как его печатает каркас: «data-theme="light"» в <head> есть всегда.
Функция ТегHTML(Знач Тема)
	Возврат СтрШаблон("<html lang=""ru"" data-theme=""%1"">", Тема);
