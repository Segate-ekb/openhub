	Ожидаем.Что(СтрНайти(Тёмная, ТегHTML("dark")) > 0, "тёмная тема из куки").ЭтоИстина();

	БезСкриптов = БезТегаScript(Светлая);
	Ожидаем.Что(СтрНайти(БезСкриптов, "UI-кит") > 0, "кит виден без JS").ЭтоИстина();
