	Ожидаем.Что(СтрНайти(БезСкриптов, "список пакетов") > 0, "содержимое на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "href=""/packages""") > 0, "навигация — обычные ссылки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "action=""/logout""") > 0, "выход — обычная POST-форма").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<link rel=""stylesheet""") > 0, "оформление не зависит от JS").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПередачаКукВРендерер

&Тест
Процедура ВсеВызовыСтраницыПередаютКукиЗапроса() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыМодуля() Цикл
		Текст = Исходники.Текст(Файл.Значение);
		Для Каждого Вызов Из ВызовыСтраницы(Текст) Цикл
			Если СтрНайти(Вызов, "Контекст") = 0 И СтрНайти(Вызов, "Куки") = 0 Тогда
				Нарушители.Добавить(Файл.Ключ + " (вызов Страница без контекста)");
			КонецЕсли;
		КонецЦикла;
		Для Каждого Вызов Из ВызовыКонтекста(Текст) Цикл
			Если СтрНайти(Вызов, "Куки") = 0 Тогда
				Нарушители.Добавить(Файл.Ключ + " (контекст без кук запроса)");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"вызовы Страница()/КонтекстСтраницы() без кук запроса").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЛистСтилей

&Тест
Процедура ВКомпонентахНетХардкодаЦвета() Экспорт

	Нарушители = Новый Массив();

	// цвет — предмет этих классов кита: палитра темы и её вывод из акцента; у поля выбора
	// цвета — значение браузерного <input type="color"> по умолчанию (#000000), а не оформление
	ПредметЦвет = СтрРазделить("ТокеныТемы.os,ЦветоваяСхема.os,ПолеФормы.os", ",");
	// образец акцента, который посетитель выбирает себе, — данные поля цвета словом поля;
	// любой другой цвет в том же файле сторож видит
	ОбразецАкцента = Новый РегулярноеВыражение("\.Образец\(""#[0-9a-fA-F]{6}"",");

	Для Каждого Файл Из ФайлыКорпуса Цикл
		Если ПредметЦвет.Найти(ИмяФайлаБезПути(Файл.Ключ)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Исходник = ОбразецАкцента.Заменить(Исходники.Текст(Файл.Значение), ".Образец(");
		Если СодержитЦвет(Исходник) Тогда
			Нарушители.Добавить(Файл.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "), "файлы с хардкодом цвета").Равно("");

КонецПроцедуры

&Тест
Процедура ВСтатическомCSSНетХардкодаЦвета() Экспорт

	// цвет в комментарии листа — рассказ (кит 0.13.0-dev.8 объясняет притемнение подсветки кода
	// контрастом токена #e36209), а не оформление: сторож смотрит объявления
	Ожидаем.Что(СодержитЦвет(БезКомментариевCSS(ТекстCSS())), "CSS пользуется только var(--…)").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВСтатическомCSSЕстьОтключениеАнимацийИДвижение() Экспорт

	Текст = ТекстCSS();

	Ожидаем.Что(СтрНайти(Текст, "prefers-reduced-motion") > 0, "анимации отключаются по настройке системы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "var(--motion-fast)") > 0, "движение берётся из токенов").ЭтоИстина();

КонецПроцедуры

// Кэш отпечатков статики заполняется НА СТАРТЕ и дальше только читается: запись в общее
// Соответствие из потоков сервера рвёт его состояние под параллельными запросами страницы,
// и /static отвечает 500 до перезапуска процесса.
&Тест
Процедура КэшОтпечатковСтатикиНеПишетсяНаЗапросе() Экспорт

	Исходник = ИсходникБезКомментариев.БезКомментариев(Исходники.Текст(Корпус.ФайлКласса("ОтпечаткиСтатики")));

	Начало = СтрНайти(Исходник, "Функция Отпечаток(");
	Ожидаем.Что(Начало > 0, "метод чтения отпечатка на месте").ЭтоИстина();

	Хвост = Сред(Исходник, Начало);
	Тело_ = Лев(Хвост, СтрНайти(Хвост, "КонецФункции"));
	Ожидаем.Что(СтрНайти(Тело_, "Отпечатки.Вставить"),
		"на пути чтения записи в общий кэш нет (гонка потоков сервера)").Равно(0);

	Для Каждого Ключ Из UI.Место.КлючиЗначков() Цикл
		Ожидаем.Что(ЗначениеЗаполнено(UI.Активы.Отпечаток(UI.Место.ФайлЗначка(Ключ))),
			"отпечаток значка «" + Ключ + "» посчитан").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(ЗначениеЗаполнено(UI.Активы.Отпечаток(UI.Место.ФайлБазовогоЛиста())),
		"и отпечаток базового листа библиотеки").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(UI.Активы.Отпечаток(UI.Поставка.ФайлСтилей())),
		"и отпечаток листа инсталляции").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(UI.Активы.Отпечаток(UI.Поставка.ФайлСкрипта())),
		"и отпечаток скрипта").ЭтоИстина();

КонецПроцедуры

// Сетка колонок — НАСТОЯЩАЯ сетка, а не flex-grow: на flex ширину ячейки решает остаток
// строки, и последний неполный ряд раздувается. У сеток карточек (.grid--3/.grid--4) число
// в имени — ПОТОЛОК колонок: базовое правило ставит ровно 3 (4) трека minmax(0, 1fr), а @media
// по убывающей max-width только сужают их до одной колонки. auto-fill/auto-fit запрещены:
// на широком мониторе они ставили в ряд больше колонок, чем обещано, и шесть карточек
// в «трёх колонках» ложились 4 + 2 (замечание владельца «6 карточек не заполняют ряды»).
// Ширина колонки при этом одна и та же, даже когда карточек меньше, чем колонок.
&Тест
Процедура СеткаКолонокЗадаётТрекиАНеРастягиваетЯчейки() Экспорт

	Текст = ТекстCSS();

	Для Каждого Селектор Из СтрРазделить(".grid--1,.grid--2,.grid--3,.grid--4", ",") Цикл

		Правила = БезусловныеПравилаCSS(Текст, Селектор);
		Ожидаем.Что(Правила.Количество(), "на «" + Селектор + "» ровно одно базовое правило").Равно(1);

		Ожидаем.Что(СтрНайти(Правила[0], "display: grid") > 0,
			"«" + Селектор + "» раскладывается сеткой: " + Правила[0]).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Правила[0], "grid-template-columns") > 0,
			"и объявляет колонки: " + Правила[0]).ЭтоИстина();

		// и в условных правилах ячейки не растягиваются
		Для Каждого Объявления Из ОбъявленияПравилаCSS(Текст, Селектор) Цикл
			Ожидаем.Что(СтрНайти(Объявления, "flex"),
				"растягивающихся ячеек в колоночной раскладке нет: " + Объявления).Равно(0);
		КонецЦикла;

	КонецЦикла;

	// двухколоночные раскладки содержимого условных правил не имеют
	Для Каждого Селектор Из СтрРазделить(".grid--1,.grid--2", ",") Цикл
		Ожидаем.Что(ОбъявленияПравилаCSS(Текст, Селектор).Количество(),
			"на «" + Селектор + "» ровно одно правило").Равно(1);
	КонецЦикла;

	// у сеток карточек число колонок — потолок, ширина колонки одна и та же
	Для Каждого Колонки Из СтрРазделить("3,4", ",") Цикл

		Селектор = ".grid--" + Колонки;
		Потолок = Число(Колонки);

		Для Каждого Объявления Из ОбъявленияПравилаCSS(Текст, Селектор) Цикл
			Ожидаем.Что(СтрНайти(Объявления, "auto-fill") + СтрНайти(Объявления, "auto-fit"),
				"«" + Селектор + "» не ставит колонок «сколько влезет»: " + Объявления).Равно(0);
		КонецЦикла;

		Базовое = БезусловныеПравилаCSS(Текст, Селектор)[0];
		Ожидаем.Что(СтрНайти(Базовое, "repeat(" + Потолок + ", minmax(0, 1fr))") > 0,
			"«" + Селектор + "» на широком экране — ровно " + Потолок
				+ " колонки одной ширины: " + Базовое).ЭтоИстина();

		Сужения = УсловныеПравилаCSS(Текст, Селектор, "grid-template-columns");
		Ожидаем.Что(Сужения.Количество() > 0,
			"«" + Селектор + "» на узком экране сужается точками перелома").ЭтоИстина();

		Колонок = Потолок;
		Ширина = 0;
		Для Каждого Сужение Из Сужения Цикл

			Ожидаем.Что(СтрНайти(Сужение.Условие, "max-width") > 0
				И СтрНайти(Сужение.Условие, "min-width") = 0,
				"«" + Селектор + "» сужается только по max-width: " + Сужение.Условие).ЭтоИстина();

			Порог = ПорогMaxWidth(Сужение.Условие);
			Ожидаем.Что(Ширина = 0 ИЛИ Порог < Ширина,
				"точки перелома «" + Селектор + "» идут по убыванию ширины: " + Сужение.Условие).ЭтоИстина();
			Ширина = Порог;

			Сужено = ЧислоКолонок(Сужение.Объявления);
			Ожидаем.Что(Сужено > 0 И Сужено < Колонок,
				"на " + Порог + " px «" + Селектор + "» только сужается (было " + Колонок + "): "
					+ Сужение.Объявления).ЭтоИстина();
			Ожидаем.Что(СтрНайти(Сужение.Объявления, "minmax(0, 1fr)") > 0,
				"и колонки остаются одной ширины: " + Сужение.Объявления).ЭтоИстина();
			Колонок = Сужено;

		КонецЦикла;

		Ожидаем.Что(Колонок, "на самом узком экране «" + Селектор + "» — одна колонка").Равно(1);

	КонецЦикла;

	// «авто» — поток по содержимому: ею печатаются ряды кнопок и плиток
	Ожидаем.Что(СтрНайти(ОбъявленияПравилаCSS(Текст, ".grid")[0], "display: flex") > 0,
		"базовая раскладка «авто» осталась flex").ЭтоИстина();

КонецПроцедуры

// Панель меню строки лежит в ВЕРХНЕМ СЛОЕ браузера (popover): строка не растёт в высоту,
// соседние не сдвигаются, обёртка прокрутки таблицы её не обрезает. Сторож смотрит ВСЕ
// правила, чей селектор упоминает панель: составной селектор вернул бы её в поток так же.
&Тест
Процедура ПанельМенюУходитВВерхнийСлойАНеРаздвигаетСтроку() Экспорт

	Текст = ТекстCSS();

	// самотест сторожа: обёртка таблицы действительно обрезает — иначе сторожить нечего
	Обёртка = ОбъявленияПравилаCSS(Текст, ".table-scroll");
	Ожидаем.Что(Обёртка.Количество() > 0, "правило обёртки прокрутки таблицы найдено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Обёртка[0], "overflow") > 0,
		"обёртка таблицы прокручивает содержимое: " + Обёртка[0]).ЭтоИстина();

	ПравилаПанели = ПравилаССелекторомПро(Текст, "menu__panel");
	Ожидаем.Что(ПравилаПанели.Количество() > 0, "правила панели меню найдены").ЭтоИстина();

	ВнеПотока = Ложь;
	ВидимаВсегда = Новый Массив();
	Для Каждого Описание Из ПравилаПанели Цикл
		Если СтрНайти(Описание.Объявления, "position: absolute") > 0
			ИЛИ СтрНайти(Описание.Объявления, "position: fixed") > 0 Тогда
			ВнеПотока = Истина;
		КонецЕсли;
		Если СтрНайти(Описание.Объявления, "display:") > 0
			И СтрНайти(Описание.Селектор, ":popover-open") = 0 Тогда
			ВидимаВсегда.Добавить(Описание.Селектор);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(ВнеПотока,
		"панель меню осталась в потоке: раскрытая, она раздвинет строку таблицы"
		+ " и сдвинет соседние — ровно то, из-за чего меню переехало в верхний слой").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(ВидимаВсегда, ", "),
		"display у панели меню задан безусловно: авторское правило сильнее UA-стиля"
		+ " «[popover]:not(:popover-open) { display: none }», и панель останется"
		+ " раскрытой навсегда — у каждой строки таблицы").Равно("");

	// и контейнеру меню не нужен собственный контекст позиционирования: якорь панели —
	// сама кнопка, названная в popovertarget
	Для Каждого Объявления Из ОбъявленияПравилаCSS(Текст, ".menu") Цикл
		Ожидаем.Что(СтрНайти(Объявления, "position: relative"),
			"контекст позиционирования меню — след абсолютной панели: " + Объявления).Равно(0);
	КонецЦикла;

КонецПроцедуры

// Карточка пакета — три части в колонку, метаданные прижаты к низу и потому стоят на
// одной линии у всех карточек ряда, а описание обрезается СТИЛЕМ (сервер отдаёт текст
// целиком) и не даёт карточке расти под текст.
&Тест
Процедура КарточкаОбъектаТянетсяНаЯчейкуИПрижимаетМетаданныеКНизу() Экспорт

	Текст = ТекстCSS();

	Карточка = ОбъявленияПравилаCSS(Текст, ".objcard");
	Ожидаем.Что(Карточка.Количество(), "на «.objcard» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Карточка[0], "display: flex") > 0, "карточка — колонка: " + Карточка[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Карточка[0], "flex-direction: column") > 0, "именно колонка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Карточка[0], "height: 100%") > 0,
		"и занимает ячейку сетки целиком — иначе ряд не выровнять").ЭтоИстина();

	Мета = ОбъявленияПравилаCSS(Текст, ".objcard__meta");
	Ожидаем.Что(Мета.Количество(), "на «.objcard__meta» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Мета[0], "margin-top: auto") > 0,
		"метаданные прижаты к низу: " + Мета[0]).ЭтоИстина();

	Описание = ОбъявленияПравилаCSS(Текст, ".objcard__desc");
	Ожидаем.Что(Описание.Количество(), "на «.objcard__desc» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Описание[0], "line-clamp: 2") > 0,
		"описание обрезается двумя строками: " + Описание[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание[0], "overflow: hidden") > 0, "и хвост не вылезает").ЭтоИстина();

	// шапка вправе переноситься (плашки и действия уходят под имя), но само имя — одна
	// строка: длинное имя усекается многоточием, а не ломает строку и не раздвигает карточку
	Имя = БезусловныеПравилаCSS(Текст, ".objcard__name");
	Ожидаем.Что(Имя.Количество(), "на «.objcard__name» ровно одно безусловное правило").Равно(1);
	Для Каждого Признак Из СтрРазделить("white-space: nowrap|overflow: hidden|text-overflow: ellipsis", "|") Цикл
		Ожидаем.Что(СтрНайти(Имя[0], Признак) > 0,
			"длинное имя — одна строка с многоточием (" + Признак + "): " + Имя[0]).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Имя[0], "display: flex") = 0 И СтрНайти(Имя[0], "display: inline-flex") = 0,
		"имя не флекс — многоточие умеет только блочный контейнер: " + Имя[0]).ЭтоИстина();
	Для Каждого Селектор Из СтрРазделить(".objcard__name|.objcard__name a", "|") Цикл
		Для Каждого Объявления Из ОбъявленияПравилаCSS(Текст, Селектор) Цикл
			Ожидаем.Что(СтрНайти(Объявления, "white-space:") = 0 ИЛИ СтрНайти(Объявления, "white-space: nowrap") > 0,
				"ни на какой ширине имя не переносится: " + Селектор + " { " + Объявления + " }").ЭтоИстина();
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ИнтервалыФормДаютКонтейнерыАНеПоля() Экспорт

	Текст = ТекстCSS();

	Селекторы = Новый Массив();
	Селекторы.Добавить(".field");
	Селекторы.Добавить(".toggle");
	Селекторы.Добавить(".from-config .field");

	Для Каждого Селектор Из Селекторы Цикл
		Для Каждого Объявления Из ОбъявленияПравилаCSS(Текст, Селектор) Цикл
			Ожидаем.Что(СтрНайти(Объявления, "margin-bottom"),
				"«" + Селектор + "» не назначает собственный нижний отступ: " + Объявления).Равно(0);
			Ожидаем.Что(СтрНайти(Объявления, "margin:"),
				"«" + Селектор + "» не назначает собственных внешних отступов: " + Объявления).Равно(0);
		КонецЦикла;
	КонецЦикла;

	// поле отбора несёт подпись над контролом, поэтому кнопка встаёт вровень с контролом
	// отступом сверху, а не по низу поля: под полем бывает подсказка
	Ряд = ОбъявленияПравилаCSS(Текст, ".filters")[0];
	Ожидаем.Что(СтрНайти(Ряд, "align-items: flex-start") > 0,
		"ряд отбора выравнивает по верху: " + Ряд).ЭтоИстина();
	Кнопка = ОбъявленияПравилаCSS(Текст, ".filters > .button");
	Ожидаем.Что(Кнопка.Количество() > 0 И СтрНайти(Кнопка[0], "margin-top") > 0,
		"кнопка отбора опущена к контролу поля").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИзвестныеКонтейнерыПолейОстаютсяFlexСGap() Экспорт

	Текст = ТекстCSS();
	Ритм = Новый РитмФорм();

	Контейнеры = Новый Массив();
	Контейнеры.Добавить(".form-stack");
	Контейнеры.Добавить(".filters");
	Контейнеры.Добавить(".from-config");

	Для Каждого Селектор Из Контейнеры Цикл

		// узкий экран правит контейнер своим @media (перенос строк) — безусловное правило одно
		Правила = БезусловныеПравилаCSS(Текст, Селектор);
		Ожидаем.Что(Правила.Количество(),
			"на «" + Селектор + "» должно быть РОВНО одно безусловное правило").Равно(1);

		Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(Текст, Селектор),
			"контейнер «" + Селектор + "» задаёт интервал сам: " + Правила[0]).ЭтоИстина();

		Ожидаем.Что(СтрНайти(Правила[0], "display: flex") > 0,
			"интервал через gap требует flex у «" + Селектор + "»: " + Правила[0]).ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

// Стиль тега хранится КЛЮЧОМ, а цвет ему даёт токен темы — значит цвет обязан быть
// читаемым в ОБЕИХ темах. 4.5:1 сразу к обеим недостижим (окно яркости пусто: нижняя
// граница 0.239 выше верхней 0.148), поэтому порог — 3:1, как для нетекстовых элементов.
&Тест
Процедура ЦветаСтилейПлашкиЧитаютсяВОбеихТемах() Экспорт

	Токены = UI.Токены;
	Порог = 3;

	// значения вычитаны из самих палитр, а не продублированы в тесте. Переменные() печатает
	// ОБЕ темы сразу: тёмную в :root, светлую в html[data-theme="light"] — разбираем по частям.
	// Светлый блок переопределяет только роли схемы, псевдонимы ролей (`--color-*`) наследуются
	// из :root и ссылаются на роли той темы, в которой стоит страница — как в браузере
	Весь = Токены.Переменные();
	Граница = СтрНайти(Весь, "html[data-theme=""light""]");
	Ожидаем.Что(Граница > 0, "в выдаче есть блок светлой темы").ЭтоИстина();
	Тёмная = ЗначенияПеременных(Лев(Весь, Граница - 1));
	Светлая = ЗначенияПеременных(Лев(Весь, Граница - 1));
	Для Каждого КиЗ Из ЗначенияПеременных(Сред(Весь, Граница)) Цикл
		Светлая.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;

	Токен = Новый Массив();
	Токен.Добавить("--color-text-muted");  // стиль «обычный»
	Токен.Добавить("--color-success");     // «стабильный»
	Токен.Добавить("--color-warning");     // «предварительный»
	Токен.Добавить("--color-danger");      // «устаревший»
	Токен.Добавить("--color-accent");      // «особый»

	Плохие = Новый Массив();
	Для Каждого Имя Из Токен Цикл

		ЦветТёмной = ЗначениеБезСсылок(Тёмная, Имя);
		ЦветСветлой = ЗначениеБезСсылок(Светлая, Имя);
		Ожидаем.Что(ЗначениеЗаполнено(ЦветТёмной) И ЗначениеЗаполнено(ЦветСветлой),
			"токен " + Имя + " объявлен в обеих палитрах").ЭтоИстина();

		КТёмной = Токены.КоэффициентКонтраста(ЦветТёмной, Токены.ПоверхностьПлашки(Ложь));
		КСветлой = Токены.КоэффициентКонтраста(ЦветСветлой, Токены.ПоверхностьПлашки(Истина));

		Если КТёмной < Порог ИЛИ КСветлой < Порог Тогда
			Плохие.Добавить(СтрШаблон("%1 (тёмная %2, светлая %3)", Имя,
				Формат(КТёмной, "ЧДЦ=2"), Формат(КСветлой, "ЧДЦ=2")));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Плохие, ", "),
		"стили, чей цвет сливается с плашкой хотя бы в одной теме").Равно("");

	// самотест арифметики: чёрным по тёмной плашке читать нельзя, и проверка это видит
	Ожидаем.Что(Токены.КоэффициентКонтраста("#000000", Токены.ПоверхностьПлашки(Ложь)) < Порог,
		"чёрное на тёмной — заведомо ниже порога").ЭтоИстина();
	Ожидаем.Что(Токены.КоэффициентКонтраста("#ffffff", Токены.ПоверхностьПлашки(Истина)) < Порог,
		"белое на светлой — тоже").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КонтейнерыПолейВВыдачеКитаВладеютИнтервалом() Экспорт

	ПотребоватьРитм(Выдача.Отрисовать(), "выдача кита");

КонецПроцедуры

// Структурный гейт: контейнер вертикального ритма раздаёт маргин детям как блокам, а
// атомарному инлайну (плашка, кнопка, значок) он уходит в высоту строчного бокса и роняет
// всю строку. Двух таких детей подряд быть не должно — ряд печатается одним элементом.
&Тест
Процедура ВыдачаКитаНеДержитДвухСоседнихАтомарныхИнлайнов() Экспорт

	ПотребоватьРядИнлайнов(Выдача.Отрисовать(), "выдача кита");

КонецПроцедуры

// Контейнеры сторож берёт ИЗ CSS, а не списком: заведут новый — попадёт под проверку сам.
&Тест
Процедура СторожРядаИнлайновЗнаетКонтейнерыИзСамогоCSS() Экспорт

	Основы = Новый РядИнлайнов().КонтейнерыРитма(ТекстCSS());

	Ожидаем.Что(Основы.Количество() > 0, "контейнеры ритма вычитаны из таблицы стилей").ЭтоИстина();
	Для Каждого Ожидаемая Из СтрРазделить(".card__body,.section__body,.panel__body,.inset,fieldset",
		",", Ложь) Цикл
		Ожидаем.Что(Основы.Найти(Ожидаемая) <> Неопределено,
			"«" + Ожидаемая + "» опознан контейнером ритма; найдено: "
			+ СтрСоединить(Основы, ", ")).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СторожРядаИнлайновВидитПлашкиСоседнимиДетьми() Экспорт

	Сторож = Новый РядИнлайнов();
	Голые = UI.Кит.Карточка("Пул", UI.Кит.Плашка("Основной").Вид("accent"),
		UI.Кит.Плашка("Публичный").Вид("ok")).Рендер();
	Нарушения = Сторож.Нарушения(Голые, ТекстCSS());

	Ожидаем.Что(Нарушения.Количество() > 0,
		"две плашки соседними детьми тела карточки обязаны краснеть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Нарушения[0], "card__body") > 0,
		"нарушение называет виновный контейнер: " + Нарушения[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Нарушения[0], "tag") > 0,
		"и виновных детей: " + Нарушения[0]).ЭтоИстина();

	Рядом = UI.Кит.Карточка("Пул", UI.Кит.РядПлашек(UI.Кит.Плашка("Основной").Вид("accent"),
		UI.Кит.Плашка("Публичный").Вид("ok"))).Рендер();
	Ожидаем.Что(Сторож.Нарушения(Рядом, ТекстCSS()).Количество(),
		"те же плашки одним рядом — не нарушение").Равно(0);

	Одна = UI.Кит.Карточка("Пул", UI.Кит.Плашка("Публичный")).Рендер();
	Ожидаем.Что(Сторож.Нарушения(Одна, ТекстCSS()).Количество(),
		"одинокая плашка в теле — не нарушение").Равно(0);

КонецПроцедуры

Процедура ПотребоватьРядИнлайнов(Знач HTML, Знач Где)

	Нарушения = Новый РядИнлайнов().Нарушения(HTML, ТекстCSS());

	Ожидаем.Что(Нарушения.Количество(),
		Где + ": соседние атомарные инлайны в контейнере ритма — "
		+ СтрСоединить(Нарушения, "; ")).Равно(0);

КонецПроцедуры

&Тест
Процедура СторожРитмаВидитКонтейнерБезИнтервала() Экспорт

	Ритм = Новый РитмФорм();
	Испорченный = СтрЗаменить(ТекстCSS(),
		".section__body > * + * { margin-top: var(--space-4); }", "");

	Нарушения = Ритм.Нарушения(Выдача.Отрисовать(), Испорченный);

	Ожидаем.Что(Нарушения.Количество() > 0, "снятый интервал должен краснеть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Нарушения[0], "section__body") > 0,
		"нарушение называет виновный контейнер: " + Нарушения[0]).ЭтоИстина();

	Одинокое = "<div class=""cell"">" + UI.Кит.Поле("q", "Поиск").Рендер() + "</div>";
	Ожидаем.Что(Ритм.Нарушения(Одинокое, ТекстCSS()).Количество(),
		"одинокое поле в контейнере без gap — не нарушение").Равно(0);

КонецПроцедуры

&Тест
Процедура СторожРитмаНеПринимаетНольУсловноеИЧужойАтрибут() Экспорт

	Ритм = Новый РитмФорм();

	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a { display: flex; gap: 16px; }", ".a"),
		"ненулевой gap у flex — владелец").ЭтоИстина();

	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a { display: flex; gap: 0rem; }", ".a"),
		"«gap: 0rem» интервала не даёт").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a { display: flex; gap: 0 16px; }", ".a"),
		"«gap: 0 16px» разводит по горизонтали, а не по вертикали").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a { display: block; margin-top: 0; }"
		+ " .a > * + * { margin-top: 0px; }", ".a"),
		"нулевой margin-top в правиле потока — тоже не интервал").ЭтоЛожь();

	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a { gap: 16px; }", ".a"),
		"gap без display: flex/grid владельцем не считается").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a { display: grid; gap: 16px; }", ".a"),
		"grid — такой же законный контекст gap, как flex").ЭтоИстина();

	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(
		"@media (max-width: 640px) { .a { display: flex; gap: 16px; } }", ".a"),
		"правило из @media — не безусловный владелец").ЭтоЛожь();

	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a > p + p { margin-top: 8px; }", ".a"),
		"«> p + p» разводит абзацы, а не любых детей — не владелец интервала").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a > h3 + p { margin-top: 8px; }", ".a"),
		"«> h3 + p» — сужение до конкретной пары, поля им не разведены").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a > * + p { margin-top: 8px; }", ".a"),
		"второй операнд тоже обязан быть универсальным").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a .field + .field { margin-top: 8px; }", ".a"),
		"пара полей на любой глубине — не интервал между НЕПОСРЕДСТВЕННЫМИ детьми").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a > * + * { margin-top: 8px; }", ".a"),
		"«> * + *» — владелец интервала").ЭтоИстина();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(".a > :not(:first-child) { margin-top: 8px; }", ".a"),
		"«> :not(:first-child)» — эквивалентная форма того же требования").ЭтоИстина();

	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(
		".a { display: flex; gap: 16px; } .a { display: block; }", ".a"),
		"flex, перебитый block ниже — gap мёртв, владельца нет").ЭтоЛожь();
	Ожидаем.Что(Ритм.СелекторЗадаётИнтервал(
		".a { display: block; gap: 16px; } .a { display: flex; }", ".a"),
		"и наоборот: flex ниже по файлу оживляет gap").ЭтоИстина();

	Разбор = Ритм.Родители("<div data-toggle-class=""field"" class=""box"">"
		+ "<div class=""field"">a</div><div class=""field"">b</div></div>");
	Ожидаем.Что(Разбор.Количество(), "родитель полей ровно один").Равно(1);
	Ожидаем.Что(СтрСоединить(Разбор[0].Классы, " "),
		"классы прочитаны из атрибута class, а не из data-toggle-class").Равно("box");
	Ожидаем.Что(Разбор[0].Полей, "оба поля учтены").Равно(2);

КонецПроцедуры

&Тест
Процедура СторожРитмаПоднимаетсяКФактическомуРодителюПоля() Экспорт

	Ритм = Новый РитмФорм();

	Неявное = Ритм.Родители(
		"<div class=box><p>подпись<div class=field>a</div><div class=field>b</div></div>");
	Ожидаем.Что(Неявное.Количество(), "родитель полей ровно один").Равно(1);
	Ожидаем.Что(Неявное[0].Классы.Найти("box") <> Неопределено,
		"поля приписаны .box, а не незакрытому <p>: <" + Неявное[0].Тег + " class="""
		+ СтрСоединить(Неявное[0].Классы, " ") + """>").ЭтоИстина();
	Ожидаем.Что(Неявное[0].Полей, "оба поля учтены").Равно(2);

	Классы = КлассыРодителейПолей(Ритм.Родители(
		"<div class=stack><div class=broken><span><div class=field>a</div></div>"
		+ "<div class=field>b</div></div>"));
	Ожидаем.Что(Классы.Найти("stack") <> Неопределено,
		"поле после незакрытого <span> принадлежит .stack: " + СтрСоединить(Классы, ", ")).ЭтоИстина();
	Ожидаем.Что(Классы.Найти("broken") = Неопределено,
		"закрытый контейнер полей больше не получает: " + СтрСоединить(Классы, ", ")).ЭтоИстина();

	Корень = Ритм.Нарушения("<div class=field>a</div><div class=field>b</div>", ТекстCSS());
	Ожидаем.Что(Корень.Количество(), "поля без контейнера — нарушение").Равно(1);
	Ожидаем.Что(СтрНайти(Корень[0], "корне") > 0,
		"нарушение называет причину: " + Корень[0]).ЭтоИстина();

	Ожидаем.Что(Ритм.Нарушения("<div class=field>a</div>", ТекстCSS()).Количество(),
		"одинокое поле в корне — не нарушение").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область МетаШапкиИКарточки

// Шапка и карточка печатают мету одним желудём: расходиться им нельзя — они стоят
// на одной странице пакета друг под другом.
&Тест
Процедура ШапкаИКарточкаПоказываютМетуОдинаково() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "лицензия", "MIT"));

	Шапка = UI.Кит.ШапкаОбъекта(Новый Структура("Имя, Мета", "winow", UI.ЗначкиМеты.Оснастить(Мета))).Рендер();
	Карточка = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Контур = UI.НаборИконок.Контур("весы");
	Ожидаем.Что(СтрНайти(Шапка, Контур) > 0, "значок лицензии в шапке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Карточка, Контур) > 0, "и он же в карточке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<span class=""visually-hidden"">лицензия: </span>MIT") > 0,
		"текстовая пара в шапке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Карточка, "<span class=""visually-hidden"">лицензия: </span>MIT") > 0,
		"и в карточке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "лицензия: MIT"), "видимого «лицензия: MIT» в шапке больше нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область КарточкаОбъекта

// Образец карточки в выдаче кита (лента главной) — ручная копия состава КарточкаОбъекта: по выдаче
// сторожа статики сверяют листы стилей. Классы разметки образца и настоящей карточки совпадают — иначе
// сторожа сверяли бы стили с карточкой, которой экран не печатает.
&Тест
Процедура ОбразецКарточкиВВыдачеКитаСовпадаетСНастоящей() Экспорт

	Плашки = Новый Массив();
	Плашки.Добавить(Новый Структура("Текст", "устаревший"));
	Настоящая = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Адрес, Описание, Версия, Плашки",
		"veles", "/pools/corp/packages/veles", "Ядро фреймворка", "1.0.0", Плашки)).Рендер();
	Образец = Выдача.КарточкаОбъектаКаталога("veles", "/pools/corp/packages/veles").Рендер();

	Ожидаем.Что(НаборКлассов(Образец), "образец собран теми же частями: " + Образец).Равно(НаборКлассов(Настоящая));

КонецПроцедуры

Функция НаборКлассов(Знач HTML)
	Классы = Новый СписокЗначений();
	Для Каждого Значение Из КлассыИзHTML(HTML) Цикл
		Для Каждого Класс Из СтрРазделить(Значение, " ", Ложь) Цикл
			Если Классы.НайтиПоЗначению(Класс) = Неопределено Тогда
				Классы.Добавить(Класс);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Классы.СортироватьПоЗначению();
	Возврат СтрСоединить(Классы.ВыгрузитьЗначения(), " ");
КонецФункции

&Тест
Процедура КарточкаОбъектаСобираетИмяОписаниеПулИПлашки() Экспорт

	HTML = UI.КарточкаОбъекта.Карточка(МодельКарточкиПакета()).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<article class=""objcard"">") > 0, "контейнер карточки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/pools/main/packages/winow""") > 0, "имя ведёт на страницу пакета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "objcard__desc") > 0, "описание").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""пул""") > 0, "пул в метаданных").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/pools/main""") > 0, "пул кликабелен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""версия""") > 0, "версия").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "0.11.3") > 0, "и её значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "tag--warn") > 0, "плашка устаревания").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "objcard__actions") > 0, "блок действий (шестерёнка)").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "class=""name"""), "легаси-класс name не вернулся").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "class=""desc"""), "легаси-класс desc не вернулся").Равно(0);

КонецПроцедуры

&Тест
Процедура СписокКарточекСобираетсяКомпонентомАПустойНеРисуется() Экспорт

	Карточки = Новый Массив();
	Карточки.Добавить(МодельКарточкиПакета());
	Карточки.Добавить(Новый Структура("Имя", "oscript-md"));

	HTML = UI.КарточкаОбъекта.Список(Карточки).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "class=""objcard-list""") > 0, "контейнер списка — тоже часть кита").ЭтоИстина();
	Ожидаем.Что(ЧислоВхождений(HTML, "<article class=""objcard"">"), "обе карточки").Равно(2);

	Ожидаем.Что(UI.КарточкаОбъекта.Список(Новый Массив()).Рендер(),
		"пустой список — пустая строка").Равно("");
	Ожидаем.Что(UI.КарточкаОбъекта.Список(Неопределено).Рендер(),
		"не массив — пустая строка").Равно("");

КонецПроцедуры

&Тест
Процедура КарточкаОбъектаБезИмениПадаетИЭкранируетОстальное() Экспорт

	Поймано = Ложь;
	Попытка
		UI.КарточкаОбъекта.Карточка(Новый Структура("Описание", "без имени"));
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Карточка пакета") > 0, "ошибка называет компонент").ЭтоИстина();
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Имя") > 0, "и причину").ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Поймано, "безымянная строка списка не рендерится").ЭтоИстина();

	HTML = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Описание, Адрес, Пул",
		"<script>alert(1)</script>", "<img src=x onerror=alert(2)>", "javascript:alert(3)",
		"<b>пул</b>")).Рендер();

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "имя экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "описание экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасный адрес отброшен").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<b>"), "имя пула экранировано").Равно(0);

КонецПроцедуры

&Тест
Процедура КарточкаОбъектаЭкранируетИмяБезАдресаВерсиюИМета() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "<b>лицензия</b>", "<i>MIT</i>"));

	БезАдреса = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Версия, Мета",
		"""><script>alert(1)</script>", "<img src=x onerror=alert(2)>", Мета)).Рендер();

	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<script"), "имя БЕЗ адреса экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(БезАдреса, "&lt;script&gt;") > 0, "и выведено как текст").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<img"), "версия экранирована").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<b>"), "подпись метаданных экранирована").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<i>"), "значение метаданных экранировано").Равно(0);

	САдресом = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Адрес",
		"""><script>alert(1)</script>", "/pools/main/packages/x")).Рендер();
	Ожидаем.Что(СтрНайти(НРег(САдресом), "<script"), "имя СО ссылкой экранировано").Равно(0);

КонецПроцедуры

// Ветка со значком печатает значение отдельно от подписи — на ней своя проверка вывода:
// «известная подпись» ведёт мимо текстового пути.
&Тест
Процедура КарточкаОбъектаЭкранируетЗначениеНаВеткеСоЗначком() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "лицензия", "<img src=x onerror=alert(1)>"));
	Мета.Добавить(Новый Структура("Подпись, Значение, Адрес",
		"автор", "<b>alice</b>", "javascript:alert(2)"));

	HTML = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Пул, АдресПула, Мета",
		"winow", """><script>alert(3)</script>", "javascript:alert(4)", Мета)).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "title=""лицензия""") > 0, "ветка со значком действительно взята").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "значение со значком экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<b>"), "и значение-ссылка тоже").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "имя пула в ряду экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасные адреса ряда отброшены").Равно(0);

КонецПроцедуры

// Ряд метаданных читается значками, как в каталогах пакетов. Слово-подпись из разметки
// не исчезает: значок декоративен, подпись несёт визуально скрытая текстовая пара —
// её озвучивает скринридер, её же находит поиск по странице и берёт копирование.
&Тест
Процедура КарточкаОбъектаМеняетИзвестныеПодписиНаЗначки() Экспорт

	Мета = Новый Массив();
	Для Каждого Подпись Из UI.ЗначкиМеты.Подписи() Цикл
		Мета.Добавить(Новый Структура("Подпись, Значение", Подпись, "знач-" + Подпись));
	КонецЦикла;

	HTML = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Для Каждого Подпись Из UI.ЗначкиМеты.Подписи() Цикл

		Контур = UI.НаборИконок.Контур(UI.ЗначкиМеты.Значок(Подпись));
		Ожидаем.Что(СтрНайти(HTML, Контур) > 0, "«" + Подпись + "»: значок нарисован").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "title=""" + Подпись + """") > 0,
			"«" + Подпись + "»: подсказка на элементе ряда").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML,
			"<span class=""visually-hidden"">" + Подпись + ": </span>знач-" + Подпись) > 0,
			"«" + Подпись + "»: подпись читается скринридером и не пропала из текста").ЭтоИстина();

	КонецЦикла;

	Ожидаем.Что(СтрНайти(HTML, "aria-hidden=""true""") > 0,
		"значок при текстовой паре — декорация").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "role=""img"""),
		"и второго носителя подписи внутри <svg> нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<title>"), "как нет и <title> в значке").Равно(0);

КонецПроцедуры

// Пул и версия — собственные поля модели, а не элементы Меты, но в ряду они такие же.
&Тест
Процедура ПулИВерсияКарточкиТожеПоказаныЗначками() Экспорт

	HTML = UI.КарточкаОбъекта.Карточка(МодельКарточкиПакета()).Рендер();

	Ожидаем.Что(СтрНайти(HTML, UI.НаборИконок.Контур("стопка")) > 0, "у пула — стопка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, UI.НаборИконок.Контур("закладка")) > 0, "у версии — закладка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""visually-hidden"">пул: </span>") > 0,
		"подпись пула озвучивается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""visually-hidden"">версия: </span>0.11.3") > 0,
		"и подпись версии — вплотную к значению").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/pools/main""") > 0, "пул остался ссылкой").ЭтоИстина();

КонецПроцедуры

// Незнакомая подпись — не повод потерять строку метаданных: значка для неё нет,
// а данные пользователь видит в виде «подпись: значение».
&Тест
Процедура НезнакомаяПодписьМетыОстаётсяТекстом() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "зеркал", "3"));
	Мета.Добавить(Новый Структура("Значение", "только-значение"));
	Мета.Добавить(Новый Структура("Подпись", "только-подпись"));

	HTML = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "зеркал: 3") > 0, "прежний текстовый вид").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""зеркал"""), "подсказки без значка не бывает").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "только-значение") > 0, "элемент без подписи").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "только-подпись") > 0, "элемент без значения").ЭтоИстина();
	Ожидаем.Что(ЧислоВхождений(HTML, "objcard__meta-item"), "все три строки на месте").Равно(3);

КонецПроцедуры

&Тест
Процедура КарточкаБезМетыНеРисуетРяд() Экспорт

	Ожидаем.Что(СтрНайти(UI.КарточкаОбъекта.Карточка(
		Новый Структура("Имя", "winow")).Рендер(), "objcard__meta"),
		"метаданных нет — контейнера тоже").Равно(0);

	Пустая = Новый Массив();
	Пустая.Добавить(Новый Структура("Подпись, Значение", "", ""));

	Ожидаем.Что(СтрНайти(UI.КарточкаОбъекта.Карточка(
		Новый Структура("Имя, Мета", "winow", Пустая)).Рендер(), "objcard__meta"),
		"пустые элементы ряда не создают").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ЗначкиВерсии

// Значок называет МЕХАНИЗМ приёма, а не выдаёт версии оценку. Слова оценки
// ищутся по КОРНЮ: «безопасн», «надёжн», «проверен» одинаково запрещены в любой форме.
&Тест
Процедура ЗначокДоверенногоКонвейераНазываетМеханизмАНеОценку() Экспорт

	HTML = ЗначкиHTML(Новый Структура("ДоверенныйКонвейер", Истина));

	// значок — иконка, а не плашка с текстом: механизм называет её доступная подпись,
	// она же подсказка курсору, а видимого текста у значка нет вовсе
	Ожидаем.Что(СтрНайти(HTML, "role=""img""") > 0, "значок — иконка с доступным именем: " + HTML)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<title>Опубликовано доверенным конвейером") > 0,
		"подпись иконки называет механизм").ЭтоИстина();
	Ожидаем.Что(ВидимыйТекст(HTML), "видимого текста у значка нет").Равно("");
	Ожидаем.Что(СтрНайти(HTML, "class=""tag"), "значок не плашка").Равно(0);

	Ожидаем.Что(СтрНайти(НРег(HTML), "доверенн") > 0,
		"значок называет доверенную публикацию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "конвейер") > 0,
		"и называет конвейер — механизм, а не свойство артефакта").ЭтоИстина();

	Для Каждого Оценка Из СтрРазделить("безопасн,надёжн,надежн,проверен,гарантир,подлинн", ",") Цикл
		Ожидаем.Что(СтрНайти(НРег(HTML), Оценка),
			СтрШаблон("значок не выдаёт оценку «%1»", Оценка)).Равно(0);
	КонецЦикла;

	// вид значка нейтрален: ok/warn/err — это светофор, а доверенная публикация опция
	Ожидаем.Что(СтрНайти(HTML, "tag--"), "вид значка нейтральный").Равно(0);

КонецПроцедуры

// Версия без доверенной публикации значка НЕ получает — и никакого «противоположного»
// значка тоже: обычная публикация не помечается ни плохой, ни непроверенной.
&Тест
Процедура ОбычнаяВерсияНеПолучаетНиЗначкаНиКлейма() Экспорт

	Ожидаем.Что(ЗначкиHTML(Новый Структура("ДоверенныйКонвейер", Ложь)),
		"у обычной версии значка нет").Равно("");
	Ожидаем.Что(ЗначкиHTML(Новый Структура()),
		"и у версии, про которую ничего не сказано").Равно("");
	Ожидаем.Что(UI.ЗначкиВерсии.Ключ(Ложь).Рендер(), "ключа у обычной версии нет").Равно("");
	Ожидаем.Что(UI.ЗначкиВерсии.Плашки(Новый Структура("ДоверенныйКонвейер", Истина)).Рендер(),
		"и среди текстовых признаков доверенная публикация не появляется").Равно("");

КонецПроцедуры

// Шапка пакета говорит о версии, которую получит установка без указания
// версии. Принята она доверенной публикацией — ключ стоит сразу за именем, значком
// с подписью, которая называет механизм, а не выдаёт оценку; не принята — ключа у имени нет.
&Тест
Процедура КлючСтоитУИмениПакетаСДовереннойВерсией() Экспорт

	Признаки = UI.ЗначкиВерсии.ПризнакиШапки(Истина);
	Заголовок = ЗаголовокШапки(UI.Кит.ШапкаОбъекта(
		Новый Структура("Имя, Признаки", "winow", Признаки)).Рендер());

	Ожидаем.Что(СтрНайти(Заголовок, "<title>" + UI.Тексты.Текст("public.package.version.trusted")
		+ "</title>") > 0, "ключ стоит в строке имени и называет себя: " + Заголовок).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВидимыйТекст(Заголовок), "winow") > 0, "имя пакета на месте").ЭтоИстина();

	Подпись = НРег(Признаки[0].Подпись);
	Ожидаем.Что(СтрНайти(Подпись, "конвейер") > 0, "подпись называет механизм").ЭтоИстина();
	Для Каждого Оценка Из СтрРазделить("безопасн,надёжн,надежн,проверен,гарантир,подлинн", ",") Цикл
		Ожидаем.Что(СтрНайти(Подпись, Оценка), СтрШаблон("подпись не выдаёт оценку «%1»", Оценка))
			.Равно(0);
	КонецЦикла;

	БезКлюча = UI.ЗначкиВерсии.ПризнакиШапки(Ложь);
	Ожидаем.Что(БезКлюча.Количество(), "у версии без доверенной публикации признака нет").Равно(0);
	Ожидаем.Что(СтрНайти(ЗаголовокШапки(UI.Кит.ШапкаОбъекта(
			Новый Структура("Имя, Признаки", "winow", БезКлюча)).Рендер()), "<svg"),
		"и значка у имени тоже").Равно(0);

КонецПроцедуры

// Текстовые признаки идут в порядке «откуда — в каком состоянии» и независимы: ни один
// не вытесняет соседа. Ключа среди них нет — он стоит в строке номера.
&Тест
Процедура ЗначкиВерсииНезависимыИСохраняютПорядок() Экспорт

	Оба = UI.ЗначкиВерсии.Плашки(Новый Структура("САпстрима, Отозвана", Истина, Истина)).Рендер();

	Апстрим = СтрНайти(НРег(Оба), "апстрим");
	Отзыв = СтрНайти(НРег(Оба), "отозвана");

	Ожидаем.Что(Апстрим > 0 И Отзыв > 0, "оба признака напечатаны: " + Оба).ЭтоИстина();
	Ожидаем.Что(Апстрим < Отзыв, "происхождение печатается раньше состояния").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Оба, "<svg"), "ключа среди текстовых признаков нет").Равно(0);

	ТолькоОтзыв = UI.ЗначкиВерсии.Плашки(Новый Структура("Отозвана", Истина)).Рендер();
	Ожидаем.Что(СтрНайти(НРег(ТолькоОтзыв), "отозвана") > 0, "отзыв печатается сам по себе")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(ТолькоОтзыв), "апстрим"), "и не тянет за собой происхождение")
		.Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПлашкаТега

// Образец плашки в окне тега зеркалит выбор полей окна словом кита: стиль и значок — признаками
// плашки (data-mirrors, data-mirror-<поле> с напечатанным значением), имя — текстом подписи;
// сохранённый значок плашка печатает сама — прежний ключ тега именем кита. Своего скрипта
// у образца нет.
&Тест
Процедура ОбразецПлашкиЗеркалитСтильИЗначокПризнаками() Экспорт

	Поля = Новый ПоляТега();
	Имена = Новый Структура("Имя, Стиль, Значок", Поля.ИмяПоляИмени(), Поля.ИмяПоляСтиля(), Поля.ИмяПоляЗначка());
	HTML = UI.ПлашкаТега.Предпросмотр(Новый Структура("Имя, Стиль, Значок", "lts", "deprecated", "lock"),
		Имена).Рендер();
	Плашка = Сред(HTML, СтрНайти(HTML, "<span data-mirrors="));
	Плашка = Лев(Плашка, СтрНайти(Плашка, ">"));

	Ожидаем.Что(Плашка, "плашка образца — в виде выбранного стиля").Содержит("class=""tag tag--err""");
	Ожидаем.Что(Плашка, "плашка зеркалит поля стиля и значка")
		.Содержит("data-mirrors=""" + Имена.Стиль + " " + Имена.Значок + """");
	Ожидаем.Что(Плашка, "напечатан выбранный стиль").Содержит("data-mirror-" + Имена.Стиль + "=""deprecated""");
	Ожидаем.Что(Плашка, "и выбранный значок — именем кита").Содержит("data-mirror-" + Имена.Значок + "=""замок""");
	Ожидаем.Что(Сред(HTML, СтрНайти(HTML, Плашка) + СтрДлина(Плашка), 4), "сохранённый значок — в плашке")
		.Равно("<svg");
	Ожидаем.Что(HTML, "подпись зеркалит поле имени").Содержит("data-mirror=""" + Имена.Имя + """");
	Ожидаем.Что(HTML, "в подписи — имя тега").Содержит(">lts<");
	Ожидаем.Что(СтрНайти(ТекстJS(), "data-chip"), "своего скрипта плашки у хаба нет").Равно(0);

КонецПроцедуры

// Вид образца по признаку стиля задаёт лист хаба, и для каждого стиля он тот же, что у плашки
// заведённого тега (.tag--<вид> кита), — иначе образец обещал бы один цвет, а список тегов показал
// бы другой.
&Тест
Процедура ВидОбразцаКаждогоСтиляКакУЗаведённогоТега() Экспорт

	// имена признаков — имена полей окна тега у их владельца: переименованное поле без листа красно
	Текст = ТекстCSS();
	Поля = Новый ПоляТега();
	ПризнакСтиля = "data-mirror-" + Поля.ИмяПоляСтиля();
	Стили = Новый СтильТега();
	Для Каждого Ключ Из Стили.Все() Цикл
		Вид = UI.ОформлениеТега.ВидПлашки(Ключ);
		Образцовое = ОбъявленияПравилаCSS(Текст, ?(ЗначениеЗаполнено(Вид), ".tag--" + Вид, ".tag"));
		Селектор = ?(ЗначениеЗаполнено(Вид), ".tag[" + ПризнакСтиля + "=""" + Ключ + """]", ".tag[" + ПризнакСтиля + "]");
		Своё = ОбъявленияПравилаCSS(Текст, Селектор);
		Ожидаем.Что(Своё.Количество(), "у стиля «" + Ключ + "» есть правило образца " + Селектор).Равно(1);
		Ожидаем.Что(Образцовое.Количество() > 0, "КОНТРОЛЬ: правило вида «" + Вид + "» в листе кита").ЭтоИстина();
		Для Каждого Свойство Из СтрРазделить("--_bg,color", ",") Цикл
			Ожидаем.Что(ЗначениеВОбъявлениях(Своё[0], Свойство),
				"стиль «" + Ключ + "»: " + Свойство + " образца — как у плашки тега")
				.Равно(ЗначениеВОбъявлениях(Образцовое[0], Свойство));
		КонецЦикла;
	КонецЦикла;
	Ожидаем.Что(Стили.Все().Количество(), "КОНТРОЛЬ: стили перечислены").Равно(5);

КонецПроцедуры

// Значение свойства в тексте объявлений правила; нет свойства — пусто.
Функция ЗначениеВОбъявлениях(Знач Объявления, Знач Свойство)
	Для Каждого Объявление Из СтрРазделить(Объявления, ";", Ложь) Цикл
		Двоеточие = СтрНайти(Объявление, ":");
		Если Двоеточие > 0 И СокрЛП(Лев(Объявление, Двоеточие - 1)) = Свойство Тогда
			Возврат СокрЛП(Сред(Объявление, Двоеточие + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

&Тест
Процедура РядКаналовСтавитОсновнойПервымИПрячетХвост() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(Тег("lts"));
	Теги.Добавить(Тег("qa"));
	Теги.Добавить(Тег("demo"));
	Теги.Добавить(Тег("rc"));
	Теги.Добавить(ОсновнойТег("stable"));

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "stable") > 0, "основной тег виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "stable") < СтрНайти(HTML, "lts"),
		"основной тег идёт ПЕРВЫМ, а не в порядке прихода").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "ещё 1") > 0, "счётчик скрытых").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<details class=""tag-row__more"">") > 0,
		"раскрытие — <details>, то есть работает без JS").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "rc") > СтрНайти(HTML, "tag-row__rest"),
		"скрытый тег лежит внутри раскрываемой части").ЭтоИстина();

КонецПроцедуры

// Ряд каналов не считает вид сам: он собирает те же плашки, что и экран настроек, —
// иначе один и тот же тег выглядит на разных страницах по-разному.
&Тест
Процедура РядКаналовНесётОформлениеКаждогоТега() Экспорт

	Устаревший = Тег("nightly");
	Устаревший.Стиль = "deprecated";
	Устаревший.Значок = "stop";

	Особый = Тег("enterprise");
	Особый.Стиль = "special";
	Особый.Значок = "key";

	Теги = Новый Массив();
	Теги.Добавить(Устаревший);
	Теги.Добавить(Особый);

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();

	Ожидаем.Что(ПлашкаРяда(HTML, "nightly"), "устаревший канал — красная плашка")
		.Равно(UI.ПлашкаТега.ПоТегу(Устаревший).Рендер());
	Ожидаем.Что(ПлашкаРяда(HTML, "enterprise"), "особый канал — сиреневая плашка")
		.Равно(UI.ПлашкаТега.ПоТегу(Особый).Рендер());

	Ожидаем.Что(СтрНайти(ПлашкаРяда(HTML, "nightly"), "class=""tag tag--err""") > 0,
		"вид взят из стиля тега, а не из места печати").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПлашкаРяда(HTML, "nightly"), "<svg") > 0,
		"значок тега в ряду напечатан").ЭтоИстина();

КонецПроцедуры

// Пометка основного канала — не часть плашки: она стоит рядом с ней и ровно у того тега,
// которым отвечает установка без версии.
&Тест
Процедура ПометкаОсновногоСтоитУОсновногоТегаИТолькоУНего() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(Тег("prerelease"));
	Теги.Добавить(ОсновнойТег("stable"));

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, ПодписьОсновногоКанала()),
		"пометка на ряду ровно одна").Равно(1);
	Ожидаем.Что(СтрНайти(HTML, ">stable</span> <span class=""muted""><svg") > 0,
		"и стоит она за основным тегом: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пометка основного канала рисуется ЗНАЧКОМ, а не словами: слова растягивали бы строку
// таблицы тегов и ряд каналов. Немым значок не остаётся — подпись даёт ему имя, его читает
// скринридер и печатает подсказкой браузер.
&Тест
Процедура ПометкаОсновногоКаналаЗвучитСловамиПриЗначке() Экспорт

	HTML = UI.ПлашкаТега.Канал(ОсновнойТег("stable")).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "(по умолчанию)"),
		"словами пометка на экране не печатается").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<svg") > 0, "пометка нарисована значком: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "role=""img""") > 0,
		"значок объявлен рисунком, а не украшением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<title>" + ПодписьОсновногоКанала() + "</title>") > 0,
		"и назван словами: " + HTML).ЭтоИстина();

	// у неосновного канала пометки нет вовсе — ни значка, ни подписи
	Обычный = UI.ПлашкаТега.Канал(Тег("prerelease")).Рендер();
	Ожидаем.Что(СтрНайти(Обычный, ПодписьОсновногоКанала()),
		"неосновной канал пометки не получает").Равно(0);

КонецПроцедуры

// Таблица тегов ставит пометку своим столбцом, список версий — рядом с плашкой. Пометка
// при этом ОДНА: её вид считается в одном месте, иначе один и тот же канал выглядел бы
// на двух экранах по-разному.
&Тест
Процедура ПометкаОсновногоОтдельноВыглядитТакЖеКакИРядомСПлашкой() Экспорт

	Основной = ОсновнойТег("stable");
	Отдельная = UI.ПлашкаТега.ПометкаОсновного(Основной).Рендер();

	Ожидаем.Что(Отдельная, "пометка сама по себе не пуста").Заполнено();
	Ожидаем.Что(СтрНайти(UI.ПлашкаТега.Канал(Основной).Рендер(), Отдельная) > 0,
		"и ровно она же стоит рядом с плашкой: " + Отдельная).ЭтоИстина();

	Ожидаем.Что(UI.ПлашкаТега.ПометкаОсновного(Тег("prerelease")).Рендер(),
		"неосновной канал пометки не получает и отдельно").Равно("");

КонецПроцедуры

// Что пометка основного канала говорит человеку и скринридеру.
Функция ПодписьОсновногоКанала()
	Возврат "Канал по умолчанию";
КонецФункции

&Тест
Процедура РядКаналовЭкранируетИмяИТребуетЕго() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(Тег("<img src=x onerror=alert(1)>"));

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<img"), "имя тега экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;img") > 0, "и осталось видимым текстом").ЭтоИстина();

	Пустые = Новый Массив();
	Пустые.Добавить(Тег(""));

	Упало = Ложь;
	Попытка
		UI.ПлашкаТега.Ряд(Пустые);
	Исключение
		Упало = Истина;
	КонецПопытки;
	Ожидаем.Что(Упало, "безымянный тег — исключение, а не пустая плашка").ЭтоИстина();

	Ожидаем.Что(UI.ПлашкаТега.Ряд(Новый Массив()).Рендер(), "пустой набор — пусто").Равно("");

КонецПроцедуры

// Подсказка приходит из вызывающего экрана: команду установки знает страница пакета,
// а не плашка.
&Тест
Процедура ПодсказкаКаналаДоезжаетДоКаждойПлашкиРяда() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(ОсновнойТег("stable"));
	Теги.Добавить(Тег("lts"));

	Подсказки = Новый Соответствие();
	Подсказки.Вставить("stable", "Канал обновления: opm install pkg@stable");
	Подсказки.Вставить("lts", "Канал обновления: opm install pkg@lts");

	HTML = UI.ПлашкаТега.Ряд(Теги, Новый Структура("Подсказки", Подсказки)).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "title=""Канал обновления: opm install pkg@stable""") > 0,
		"подсказка основного канала").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""Канал обновления: opm install pkg@lts""") > 0,
		"подсказка небазового канала — такая же, а не пустая").ЭтоИстина();

КонецПроцедуры

Функция Тег(Знач Имя)
	Возврат Новый Структура("Имя, Стиль, Значок, ПоУмолчанию", Имя, "", "", Ложь);
КонецФункции

Функция ОсновнойТег(Знач Имя)
	Возврат Новый Структура("Имя, Стиль, Значок, ПоУмолчанию", Имя, "", "", Истина);
КонецФункции

// Плашка ряда по подписи: действий в ней нет, поэтому первый </span> закрывает именно её.
Функция ПлашкаРяда(Знач Разметка, Знач Имя)

	Хвост = Разметка;
	Начало = СтрНайти(Хвост, "<span class=""tag");

	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало);
		Конец = СтрНайти(Хвост, "</span>");
		Фрагмент = ?(Конец = 0, Хвост, Лев(Хвост, Конец + 6));
		Если СтрЗаканчиваетсяНа(Фрагмент, ">" + Имя + "</span>") Тогда
			Возврат Фрагмент;
		КонецЕсли;
		Хвост = Сред(Хвост, 2);
		Начало = СтрНайти(Хвост, "<span class=""tag");
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ТемаИВкладкаВерсий

// Тему в шапке переключает пилюля кита: серверная форма (без скрипта — POST и возврат),
// кнопка с ролью переключателя, состояние которой — тёмная ли тема, имя для скринридера —
// состояние словами, подсказка — куда переключит. Слова «Тема» глазом в шапке не видно.
&Тест
Процедура ПереключательТемыЖивётВРазметкеСтраницы() Экспорт

	Тёмная = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("тёмная")));
	Светлая = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("светлая")));

	Ожидаем.Что(СтрНайти(Тёмная, "action=""/ui/theme""") > 0,
		"переключатель — серверная форма").ЭтоИстина();

	ПилюляТёмной = ПилюляТемы(Тёмная);
	Ожидаем.Что(ПилюляТёмной, "в шапке есть пилюля темы: " + Тёмная).Не_().Равно("");
	Ожидаем.Что(СтрНайти(ПилюляТёмной, "role=""switch""") > 0, "у пилюли роль переключателя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПилюляТёмной, "theme-switch__thumb") > 0, "у пилюли бегунок").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПилюляТёмной, ">Тема"), "слова «Тема» на пилюле глазом не видно").Равно(0);
	Ожидаем.Что(СтрНайти(ПилюляТёмной, "aria-checked=""true""") > 0,
		"в тёмной теме переключатель включён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПилюляТёмной, "aria-label=""Тема: тёмная""") > 0,
		"скринридер слышит состояние: " + ПилюляТёмной).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПилюляТёмной, "title=""Включить светлую тему""") > 0,
		"в тёмной теме предлагаем светлую").ЭтоИстина();

	ПилюляСветлой = ПилюляТемы(Светлая);
	Ожидаем.Что(СтрНайти(ПилюляСветлой, "aria-checked=""false""") > 0,
		"в светлой теме переключатель выключен: " + ПилюляСветлой).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПилюляСветлой, "aria-label=""Тема: светлая""") > 0,
		"скринридер слышит состояние: " + ПилюляСветлой).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПилюляСветлой, "title=""Включить тёмную тему""") > 0,
		"в светлой теме предлагаем тёмную").ЭтоИстина();

КонецПроцедуры

// Кнопка пилюли темы шапки целиком — от открывающего тега до </button>; нет пилюли — пустая строка.
Функция ПилюляТемы(Знач Разметка)

	Начало = СтрНайти(Разметка, "<button type=""submit"" class=""theme-switch""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Разметка, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</button>") + СтрДлина("</button>") - 1);

КонецФункции

// У версии виден размер в тех единицах, в каких его читает человек, а обрезанный отпечаток
// несёт многоточие — без него обрезанный sha256 читается как полный.
&Тест
Процедура ТаблицаВерсийПечатаетОбъёмЧеловеческимиЕдиницамиИОбрезанныйОтпечатокСМноготочием() Экспорт

	Разметка = ПлоскаяТаблицаВерсий();

	// разделитель дробной части даёт локаль машины, поэтому сверяются ЕДИНИЦА и порядок
	Ожидаем.Что(СтрНайти(Разметка, "МБ</td>") > 0,
		"мегабайтный артефакт назван мегабайтами: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<td>500") > 0, "и числом 500, а не 512000").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "512000"),
		"полмиллиона килобайт вместо мегабайтов человеку не показывают").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "КБ</td>") > 0,
		"килобайтный артефакт — килобайтами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<td>2") > 0, "и числом 2").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<td>—</td>") > 0,
		"у версии без размера — прочерк, а не «0 Б»").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Разметка, "abcdef012345…") > 0,
		"обрезанный отпечаток кончается многоточием").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "abcdef0123456"),
		"и дальше двенадцати знаков не показан").Равно(0);

КонецПроцедуры

// Слот источника адресуется одной координатой, а лежит в нём каждый раз другая сборка:
// её номер называет только манифест, и человеку он виден рядом со строкой версии.
// Совпал номер с координатой — приписки нет, иначе таблица шумела бы на каждой строке.
&Тест
Процедура ТаблицаВерсийПоказываетНомерИзМанифестаТолькоКогдаОнОтличается() Экспорт

	Разметка = ПлоскаяТаблицаВерсий();

	Ожидаем.Что(СтрНайти(Разметка, "в манифесте 1.2.043.42") > 0,
		"у слота видно, какая сборка в нём лежит: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Разметка, "в манифесте"),
		"и только у него: у версий, чей манифест называет ту же строку, приписки нет").Равно(1);

КонецПроцедуры

// В плоском списке кнопка отдаёт РОВНО свою версию: адрес называет её сам, и что бы
// ни случилось с каналами, по нему лежит один и тот же файл. Отозванная — не исключение.
&Тест
Процедура КнопкаСкачиванияСтрокиВерсийВедётНаТочнуюВерсию() Экспорт

	Разметка = ПлоскаяТаблицаВерсий();

	Ожидаем.Что(СтрНайти(Разметка, "href=""/api/v1/pools/main/download/mylib/mylib-2.0.0.ospx"""),
		"у старшей версии свой адрес: " + Разметка).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "href=""/api/v1/pools/main/download/mylib/mylib-SNAPSHOT.ospx"""),
		"и у слота — его собственная координата").Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "href=""/api/v1/pools/main/download/mylib/mylib-0.9.0.ospx"""),
		"и у отозванной версии кнопка такая же").Больше(0);

	Ожидаем.Что(СтрЧислоВхождений(Разметка, "/download/"),
		"кнопка ровно одна на строку — пять строк, пять адресов").Равно(5);

КонецПроцедуры

// Кнопка — значок: видимой надписи у неё нет, а имя файла со всей его версией читает
// скринридер и показывает подсказка курсору.
&Тест
Процедура КнопкаСкачиванияЭтоЗначокСИменемФайлаВДоступномИмени() Экспорт

	Разметка = ПлоскаяТаблицаВерсий();

	Ожидаем.Что(СтрНайти(Разметка, "aria-label=""Скачать mylib-1.1.0.ospx"""),
		"доступное имя называет файл и версию: " + Разметка).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "title=""Скачать mylib-1.1.0.ospx"""),
		"и подсказка курсору говорит то же").Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "<span>Скачать"),
		"видимой надписи у значка нет вовсе").Равно(0);

КонецПроцедуры

// В таблице каналов кнопка отдаёт версию ПО ТЕГУ: адрес называет канал, а не версию,
// поэтому переведённый канал меняет файл, не меняя адреса. Канал без отдаваемой версии
// кнопки не получает — отдавать нечего.
&Тест
Процедура КнопкаСкачиванияКаналаВедётНаТеговыйАдрес() Экспорт

	Разметка = ТаблицаКаналовВерсий();

	Ожидаем.Что(СтрНайти(Разметка, "href=""/api/v1/pools/main/download/mylib/mylib-stable.ospx"""),
		"адрес канала называет тег: " + Разметка).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "aria-label=""Скачать mylib-2.0.0.ospx"""),
		"а обещанное имя файла — ту версию, которую канал отдаёт сейчас").Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "download/mylib/mylib-2.0.0.ospx"),
		"точной версии в адресе канала нет: её выбирает хаб в момент клика").Равно(0);

	Ожидаем.Что(СтрЧислоВхождений(Разметка, "/download/"),
		"у пустого канала кнопки нет: адрес один на два канала").Равно(1);

КонецПроцедуры

// Скачивания версии стоят в строке этой версии — у каждой свои, у версии без
// скачиваний ноль. Каналам колонки нет: тег меняет состав, и сумма по нему ничего не значит.
&Тест
Процедура СкачиванияВерсииСтоятВСтрокеСвоейВерсии() Экспорт

	Разметка = ПлоскаяТаблицаВерсий();

	Ожидаем.Что(СтрНайти(Разметка, ">Скачано</th>") > 0, "колонка скачиваний: " + Разметка)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаВерсии(Разметка, "2.0.0"), ">1234</td>") > 0,
		"у старшей версии её число").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаВерсии(Разметка, "1.1.0"), ">7</td>") > 0,
		"у соседней — своё").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаВерсии(Разметка, "1.0.0"), ">0</td>") > 0,
		"у версии без скачиваний — ноль").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаВерсии(Разметка, "2.0.0"), ">7</td>"),
		"чужое число в строку версии не попадает").Равно(0);

	Каналы = ТаблицаКаналовВерсий();
	Ожидаем.Что(СтрНайти(Каналы, "Скачано"), "у таблицы каналов колонки скачиваний нет")
		.Равно(0);
	Ожидаем.Что(СтрНайти(Каналы, "1234"), "и число версии канала по тегу не показано").Равно(0);

КонецПроцедуры

// Скачивания версий нужны только плоскому списку: группировка по каналам их не показывает,
// а у пакета без версий показывать нечего, — вопрос к статистике там был бы пустой работой.
&Тест
Процедура СкачиванияВерсийСпрашиваетТолькоПлоскийСписок() Экспорт

	Мир = МирВкладкиВерсий();
	ВерсииПакета = ВерсииВкладки(Мир);

	ВкладкаМира(Мир, Новый Массив(), Истина);
	Ожидаем.Что(Мир.ВопросовОСкачиваниях(), "у пакета без версий скачивания не спрашиваются")
		.Равно(0);

	Мир.ДобавитьКанал("stable", ВерсииПакета[0]);
	ВкладкаМира(Мир, ВерсииПакета, Ложь);
	Ожидаем.Что(Мир.ВопросовОСкачиваниях(), "группировке по каналам скачивания версий не нужны")
		.Равно(0);

	ВкладкаМира(Мир, ВерсииПакета, Истина);
	Ожидаем.Что(Мир.ВопросовОСкачиваниях(), "плоский список спрашивает их одним вопросом")
		.Равно(1);

КонецПроцедуры

// У ключа нет текста на экране, и смысл его не держится на наведении —
// под таблицей, где ключ нарисован, его называет легенда. Одна на таблицу, а не в каждой
// строке: подпись самой иконки — короткая фраза, длинное пояснение живёт в легенде.
&Тест
Процедура ЛегендаКлючаСтоитПодТаблицейСКлючом() Экспорт

	Мир = МирВкладкиВерсий();
	ВерсииПакета = ВерсииВкладки(Мир);

	БезКлюча = ВкладкаМира(Мир, ВерсииПакета, Истина);
	Ожидаем.Что(СтрНайти(ВидимыйТекст(БезКлюча), ПояснениеЛегенды()),
		"ключа в таблице нет — нет и легенды: " + БезКлюча).Равно(0);

	Мир.ОтметитьДоверенной(ВерсииПакета[1]);
	СКлючом = ВкладкаМира(Мир, ВерсииПакета, Истина);
	Подпись = UI.Тексты.Текст("public.package.version.trusted");

	Ожидаем.Что(СтрЧислоВхождений(ВидимыйТекст(СКлючом), ПояснениеЛегенды()),
		"легенда стоит под таблицей один раз: " + СКлючом).Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(СКлючом, "<title>" + Подпись + "</title>"),
		"ключ — у одной строки, и иконка легенды его не повторяет скринридеру").Равно(1);
	Ожидаем.Что(СтрНайти(СтрокаВерсии(СКлючом, "1.1.0"), "<title>" + Подпись + "</title>") > 0,
		"ключ у той версии, что принята доверенной публикацией").ЭтоИстина();
	Ожидаем.Что(СтрДлина(Подпись) < СтрДлина(ПояснениеЛегенды()),
		"подпись иконки короче пояснения легенды: " + Подпись).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаВерсии(СКлючом, "1.1.0"), ПояснениеЛегенды()),
		"длинное пояснение в строку версии не попадает").Равно(0);

КонецПроцедуры

// Значок стоит везде, где видна версия, — и в группировке по каналам: у
// актуальной версии канала и в его истории. Отозванная в истории помечена той же плашкой,
// что всюду, — с подсказкой, а не своей надписью.
&Тест
Процедура ТаблицаКаналовПоказываетЗначкиВерсий() Экспорт

	Мир = МирВкладкиВерсий();
	ВерсииПакета = ВерсииВкладки(Мир);
	Отдаваемая = ВерсииПакета[0];
	САпстрима = ВерсииПакета[1];
	Отозванная = ВерсииПакета[4];

	Мир.ОтметитьДоверенной(Отдаваемая);
	Мир.ОтметитьАпстримной(САпстрима);
	Состав = Новый Массив();
	Состав.Добавить(Отдаваемая);
	Состав.Добавить(САпстрима);
	Состав.Добавить(Отозванная);
	Мир.ДобавитьКанал("stable", Отдаваемая, Состав);

	Разметка = ВкладкаМира(Мир, ВерсииПакета, Ложь);
	Подпись = UI.Тексты.Текст("public.package.version.trusted");

	Ожидаем.Что(СтрЧислоВхождений(Разметка, "<title>" + Подпись + "</title>"),
		"ключ у актуальной версии канала и у неё же в истории: " + Разметка).Равно(2);
	Ожидаем.Что(СтрНайти(Разметка, UI.Тексты.Текст("public.package.version.upstream.hint")) > 0,
		"версия с апстрима в истории помечена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, UI.Тексты.Текст("public.package.version.yanked.hint")) > 0,
		"отозванная в истории помечена общей плашкой — с подсказкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВидимыйТекст(Разметка), ПояснениеЛегенды()) > 0,
		"под таблицей каналов с ключом стоит легенда").ЭтоИстина();

	Ожидаем.Что(СтрНайти(ВидимыйТекст(ТаблицаКаналовВерсий()), ПояснениеЛегенды()),
		"а без ключа — нет").Равно(0);

КонецПроцедуры

// Версии по умолчанию у пакета может не быть вовсе — её уносят отзыв и смена канала.
// Безверсионному адресу тогда отдавать нечего, и кнопки быть не должно: ссылка на 404
// хуже отсутствия кнопки.
&Тест
Процедура БезВерсииПоУмолчаниюКнопкиСкачиванияНет() Экспорт

	РеестрФикстур.Подключить("ПулЗаглушка");
	Пул = Новый ПулЗаглушка(1, "main", "custom");

	Ожидаем.Что(UI.КнопкаСкачивания.ВерсииПоУмолчанию(Пул, "mylib", Неопределено).Рендер(),
		"нет версии по умолчанию — нет и кнопки").Равно("");
	Ожидаем.Что(UI.КнопкаСкачивания.ВерсииКанала(Пул, "mylib", "stable", Неопределено).Рендер(),
		"пустой канал кнопки тоже не получает").Равно("");

КонецПроцедуры

// Плоский список версий: мегабайтная, килобайтная, без размера, слот со сборкой из манифеста, отозванная.
Функция ПлоскаяТаблицаВерсий()

	Мир = МирВкладкиВерсий();
	ВерсииПакета = ВерсииВкладки(Мир);
	ЗасеятьСкачивания(Мир, ВерсииПакета);

	Возврат ВкладкаМира(Мир, ВерсииПакета, Истина);

КонецФункции

// Та же вкладка в группировке по каналам: канал с отдаваемой версией и канал пустой.
Функция ТаблицаКаналовВерсий()

	Мир = МирВкладкиВерсий();
	// имя «Версии» занято глобальным именем библиотеки semver — локальная его не перебьёт
	ВерсииПакета = ВерсииВкладки(Мир);
	ЗасеятьСкачивания(Мир, ВерсииПакета);

	Мир.ДобавитьКанал("stable", ВерсииПакета[0]);
	Мир.ДобавитьКанал("develop", Неопределено);

	Возврат ВкладкаМира(Мир, ВерсииПакета, Ложь);

КонецФункции

// Вкладка над миром фикстуры: Плоско — плоский список, иначе группировка по каналам.
Функция ВкладкаМира(Знач Мир, Знач ВерсииПакета, Знач Плоско)

	Возврат ВкладкаВерсийФикстуры(Мир).Вкладка(ПулВкладкиВерсий(), Мир.Пакет(),
		ВерсииПакета, Плоско, УзелВкладкиВерсий(), "/pools/main/packages/mylib/versions", Мир).Рендер();

КонецФункции

Функция МирВкладкиВерсий()

	РеестрФикстур.Подключить("ВерсииДляВкладки");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	Поиск.Подключить(КаталогКлассов, "ВкладкаВерсий");
	Поиск.Подключить(КаталогКлассов, "КомандыOpm");
	Поиск.Подключить(ОбъединитьПути(КаталогКлассов, "..", ".."), "АдресИнстанса");

	Возврат Новый ВерсииДляВкладки();

КонецФункции

Функция ВкладкаВерсийФикстуры(Знач Мир)

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.instance.url", "https://hub.example.test");
	Команды = Новый КомандыOpm(Новый АдресИнстанса(Настройки), Новый ЗаголовкиHTTP());

	// мир фикстуры стоит и за службу тегов, и за статистику скачиваний
	Возврат Новый ВкладкаВерсий(UI.Кит, UI.Тексты, Мир, Мир,
		Команды, UI.ПлашкаТега, UI.ЗначкиВерсии, UI.КнопкаСкачивания);

КонецФункции

Функция ВерсииВкладки(Знач Мир)

	Отозванная = Мир.Версия("0.9.0", 1024, "9876543210fedcba");
	Отозванная.Отозвана = Истина;

	Результат = Новый Массив();
	Результат.Добавить(Мир.Версия("2.0.0", 524288000, "abcdef0123456789abcdef"));
	Результат.Добавить(Мир.Версия("1.1.0", 2048, "0123456789abcdef"));
	Результат.Добавить(Мир.Версия("1.0.0", 0, ""));
	Результат.Добавить(Мир.Версия("SNAPSHOT", 4096, "fedcba9876543210", "1.2.043.42"));
	Результат.Добавить(Отозванная);
	Возврат Результат;

КонецФункции

// Скачивания версий вкладки; у 1.0.0 и отозванной их нет вовсе.
Процедура ЗасеятьСкачивания(Знач Мир, Знач ВерсииПакета)

	Мир.Скачано(ВерсииПакета[0], 1234);
	Мир.Скачано(ВерсииПакета[1], 7);
	Мир.Скачано(ВерсииПакета[3], 3);

КонецПроцедуры

// Пояснение легенды ключа словами — то, что человек читает под таблицей, без самого значка.
Функция ПояснениеЛегенды()
	Возврат СокрЛП(СтрЗаменить(UI.Тексты.Текст("public.package.version.trusted.legend"), "%1", ""));
КонецФункции

// Строка имени шапки объекта: от <h1 до </h1>.
Функция ЗаголовокШапки(Знач HTML)
	Хвост = Сред(HTML, СтрНайти(HTML, "<h1"));
	Возврат Лев(Хвост, СтрНайти(Хвост, "</h1>") + 4);
КонецФункции

// Значки версии напечатанными подряд: ключ, затем текстовые признаки.
Функция ЗначкиHTML(Знач Модель)

	Доверенная = Модель.Свойство("ДоверенныйКонвейер") И Модель.ДоверенныйКонвейер = Истина;
	Возврат UI.ЗначкиВерсии.Ключ(Доверенная).Рендер() + UI.ЗначкиВерсии.Плашки(Модель).Рендер();

КонецФункции

// Текст, видимый глазами: без тегов и без подписей иконок, которых на экране нет.
Функция ВидимыйТекст(Знач HTML)

	Результат = "";
	Хвост = HTML;
	Пока ЗначениеЗаполнено(Хвост) Цикл
		Позиция = СтрНайти(Хвост, "<");
		Если Позиция = 0 Тогда
			Результат = Результат + Хвост;
			Прервать;
		КонецЕсли;
		Результат = Результат + Лев(Хвост, Позиция - 1);
		Хвост = Сред(Хвост, Позиция);
		Если СтрНачинаетсяС(Хвост, "<title>") Тогда
			Хвост = Сред(Хвост, СтрНайти(Хвост, "</title>") + СтрДлина("</title>"));
		Иначе
			Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции

// Строка таблицы, в которой стоит версия: от открывающего <tr> до закрывающего.
Функция СтрокаВерсии(Знач Разметка, Знач Номер)

	Позиция = СтрНайти(Разметка, "<code>" + Номер + "</code>");
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон("версии %1 в разметке нет: %2", Номер, Разметка);
	КонецЕсли;

	Начало = СтрНайти(Лев(Разметка, Позиция), "<tr", НаправлениеПоиска.СКонца);
	Хвост = Сред(Разметка, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</tr>") + 4);

КонецФункции

Функция ПулВкладкиВерсий()
	Возврат Новый ПулЗаглушка(1, "main", "custom");
КонецФункции

Функция УзелВкладкиВерсий()
	Возврат "hub.example.test";
КонецФункции

// Хаб хранит моменты в UTC, и экран обязан их так и подписывать. Ожидания — ЛИТЕРАЛЫ:
// спросить формат у того же класса, который его печатает, значит не проверить ничего.
&Тест
Процедура МоментНаЭкранеНаписанОдинаковоИПодписанЗоной() Экспорт

	Момент = Дата(2026, 12, 31, 23, 59, 5);

	Ожидаем.Что(UI.Даты.ТолькоДата(Момент), "дата без времени").Равно("31.12.2026");
	Ожидаем.Что(UI.Даты.ДатаВремя(Момент), "дата со временем подписана зоной")
		.Равно("31.12.2026 23:59 UTC");
	Ожидаем.Что(UI.Даты.Метка(Момент), "метка до секунды сортируема и тоже подписана")
		.Равно("2026-12-31 23:59:05 UTC");
	Ожидаем.Что(UI.Даты.Зона(), "зона названа одна на весь интерфейс").Равно("UTC");

	Ожидаем.Что(UI.Даты.ТолькоДата(Неопределено), "незаполненная дата — пустая строка").Равно("");
	Ожидаем.Что(UI.Даты.ДатаВремя(Неопределено), "и незаполненный момент тоже").Равно("");
	Ожидаем.Что(UI.Даты.Метка('00010101'), "и пустая дата платформы").Равно("");

КонецПроцедуры

&Тест
Процедура ВозвратПослеСменыТемыБерётТолькоПутьЭтогоХаба() Экспорт

	// принимает путь ОДНО правило на весь хаб — ВозвратПослеВхода.Путь; контроллер
	// оформления добавляет к нему единственный свой вопрос: «чей это адрес»
	Оформление = НовоеОформление();

	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("http://hub/packages?q=a", "hub")),
		"путь и query СВОЕГО адреса сохраняются").Равно("/packages?q=a");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("http://HUB:3333/packages", "hub")),
		"свой узел узнаётся без учёта регистра и порта").Равно("/packages");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("/packages?q=a", "hub")),
		"относительный путь принимается как есть").Равно("/packages?q=a");

	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("https://evil.example/phish", "hub")),
		"адрес ЧУЖОГО узла возврата не даёт вовсе").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("http://hub/packages", "")),
		"без заголовка Host свой узел неизвестен — возврата нет").Равно("/");

	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("//evil.example/phish", "hub")),
		"protocol-relative — не путь, уходим на корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("http://hub/\evil.example", "hub")),
		"«/\host» со своего узла — всё равно не путь").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("\\evil.example/phish", "hub")),
		"«\\host» — тоже").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("http://hub\packages", "hub")),
		"обратный слэш вместо разделителя пути возврата не даёт").Равно("/");

	Ожидаем.Что(Оформление.ПутьВозврата(
			Откуда("/ok" + Символы.ВК + Символы.ПС + "X-Injected: 1", "hub")),
		"CR/LF в Referer — возврат на корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("/" + СтрокаИз("a", 3000), "hub")),
		"адрес длиннее предела — возврат на корень").Равно("/");

	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("", "hub")),
		"без Referer — корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Неопределено),
		"без заголовков — корень").Равно("/");

КонецПроцедуры

// Форма темы на странице несёт путь этой страницы с её параметрами: Referer хаб наружу не
// отдаёт, и вернуть посетителя иначе некуда. Путь, напечатанный в форме, контроллер
// разбирает обратно в тот же путь — смена темы оставляет человека там, где он был.
&Тест
Процедура ФормаТемыВозвращаетНаТуЖеСтраницу() Экспорт

	Путь = "/packages?q=веб сервер&page=2";
	Страница = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено, Ложь, Ложь, Путь));

	Адрес = АдресФормыТемы(Страница);
	Ожидаем.Что(СтрНачинаетсяС(Адрес, "/ui/theme?"), "форма темы с параметром: " + Адрес).ЭтоИстина();
	Ожидаем.Что(НовоеОформление().ПутьВозврата(Откуда("", "hub"), ПараметрыАдреса(Адрес)),
		"контроллер возвращает на ту же страницу с её параметрами").Равно(Путь);

	// так путь отдаёт winow: параметры уже закодированы, и раскодировать их второй раз некому —
	// в Location уходит тот же ASCII, что был в адресе страницы
	Закодированный = "/packages?q=%D0%B2%D0%B5%D0%B1&page=2";
	СЗакодированным = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено, Ложь, Ложь, Закодированный));
	Ожидаем.Что(НовоеОформление().ПутьВозврата(Откуда("", "hub"), ПараметрыАдреса(АдресФормыТемы(СЗакодированным))),
		"закодированный путь возвращается как был, без второго раскодирования").Равно(Закодированный);

	БезПути = UI.Каркас.Страница("Каталог", "<p>тело</p>", UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Ожидаем.Что(АдресФормыТемы(БезПути), "страница без пути — форма без возврата").Равно("/ui/theme");

КонецПроцедуры

// Путь из формы главнее Referer; не путь этого хаба — корень, а не Referer: форма, которой
// подсунули чужой адрес, никуда наружу не уводит.
&Тест
Процедура ВозвратСменыТемыБерётПутьФормыПервым() Экспорт

	Оформление = НовоеОформление();
	СвойИсточник = Откуда("http://hub/packages", "hub");

	Ожидаем.Что(Оформление.ПутьВозврата(СвойИсточник, Назад("/pools?page=2")),
		"путь формы главнее Referer").Равно("/pools?page=2");
	Ожидаем.Что(Оформление.ПутьВозврата(Откуда("https://evil.example/phish", "hub"), Назад("/pools")),
		"и чужой Referer ему не мешает").Равно("/pools");

	Ожидаем.Что(Оформление.ПутьВозврата(СвойИсточник, Назад("https://evil.example/phish")),
		"адрес чужого узла в форме — корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(СвойИсточник, Назад("//evil.example/phish")),
		"protocol-relative в форме — корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(СвойИсточник, Назад("/\evil.example")),
		"обратный слэш в форме — корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(СвойИсточник, Назад("javascript:alert(1)")),
		"чужая схема в форме — корень").Равно("/");

	Ожидаем.Что(Оформление.ПутьВозврата(СвойИсточник, Назад("")),
		"пустой путь формы — прежний возврат по Referer").Равно("/packages");
	Ожидаем.Что(Оформление.ПутьВозврата(СвойИсточник, Новый Соответствие()),
		"без параметра — прежний возврат по Referer").Равно("/packages");

КонецПроцедуры

// Адрес формы темы со страницы — атрибут action как его прочтёт браузер.
Функция АдресФормыТемы(Знач Страница)

	Начало = СтрНайти(Страница, "action=""/ui/theme");
	Ожидаем.Что(Начало, "на странице есть форма темы").Больше(0);
	Хвост = Сред(Страница, Начало + СтрДлина("action="""));
	Возврат СтрЗаменить(Лев(Хвост, СтрНайти(Хвост, """") - 1), "&amp;", "&");

КонецФункции

// Параметры адреса так, как их разбирает сервер: пары через «&», имя и значение URL-кодированы.
Функция ПараметрыАдреса(Знач Адрес)

	Результат = Новый Соответствие();
	Запрос = Сред(Адрес, СтрНайти(Адрес, "?") + 1);
	Для Каждого Пара Из СтрРазделить(Запрос, "&", Ложь) Цикл
		Разделитель = СтрНайти(Пара, "=");
		Результат.Вставить(РаскодироватьСтроку(Лев(Пара, Разделитель - 1), СпособКодированияСтроки.КодировкаURL),
			РаскодироватьСтроку(Сред(Пара, Разделитель + 1), СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Назад(Знач Путь)
	Результат = Новый Соответствие();
	Результат.Вставить(Новый АдресСменыТемы().ИмяПараметра(), Путь);
	Возврат Результат;
КонецФункции

Функция НовоеОформление()
	Возврат Новый КонтроллерОформления(UI.Оформление, UI.Токены, Новый ВозвратПослеВхода(),
		Новый РазборАдреса(), Новый ЗаголовкиHTTP(), Новый АдресСменыТемы());
КонецФункции

// Заголовки запроса на смену темы: откуда человек пришёл и каким узлом он сюда стучится.
Функция Откуда(Знач Источник, Знач СвойУзел)
	Результат = Новый Соответствие();
	Результат.Вставить("Referer", Источник);
	Результат.Вставить("Host", СвойУзел);
	Возврат Результат;
КонецФункции

Функция СтрокаИз(Знач Символ, Знач Длина)
	Возврат СтрСоединить(Новый Массив(Длина + 1), Символ);
КонецФункции

&Тест
Процедура СменаТемыСохраняетОстальноеОформление() Экспорт

	Текущее = КодироватьСтроку("тема=светлая&акцент=%239184d9&плотность=1.2",
		СпособКодированияСтроки.КодировкаURL);

	Новое = РаскодироватьСтроку(UI.Оформление.ЗначениеCookieСТемой(Текущее, "тёмная"),
		СпособКодированияСтроки.КодировкаURL);

	Ожидаем.Что(СтрНайти(Новое, "тема=тёмная") > 0, "тема переключилась").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Новое, "плотность=1.2") > 0, "плотность уцелела").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Новое, "акцент=") > 0, "акцент уцелел").ЭтоИстина();

	Пустая = РаскодироватьСтроку(UI.Оформление.ЗначениеCookieСТемой("", "светлая"),
		СпособКодированияСтроки.КодировкаURL);
	Ожидаем.Что(Пустая, "только тема").Равно("тема=светлая");

КонецПроцедуры

#КонецОбласти

#Область МенюВыдачи

// Тот же инвариант на ЦЕЛОЙ странице: выдача кита печатает несколько меню подряд, и каждая кнопка
// открывает СВОЮ панель. Единого меню инсталляции в выдаче нет,
// поэтому оно не считается — его связь стережёт ХолстКита на настоящей странице хаба.
&Тест
Процедура НаСтраницеИдентификаторыМенюНеПовторяютсяИКнопкиСходятся() Экспорт

	HTML = Выдача.Отрисовать();

	Панели = БезЕдиногоМеню(ИдентификаторыПанелейМеню(HTML));
	Ожидаем.Что(Панели.Количество() > 1,
		"в выдаче кита меню несколько — иначе уникальность сторожить не на чем").ЭтоИстина();

	Встреченные = Новый Соответствие();
	Для Каждого Ид Из Панели Цикл
		Ожидаем.Что(Встреченные.Получить(Ид) = Неопределено,
			"идентификатор панели «" + Ид + "» на странице не один").ЭтоИстина();
		Встреченные.Вставить(Ид, Истина);
	КонецЦикла;

	Цели = ЦелиКнопокМеню(HTML);
	Ожидаем.Что(Цели.Количество(), "у каждой панели своя кнопка").Равно(Панели.Количество());

	Потерянные = Новый Массив();
	Для Каждого Цель Из Цели Цикл
		Если Встреченные.Получить(Цель) = Неопределено Тогда
			Потерянные.Добавить(Цель);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"кнопка целится в панель, которой на странице нет").Равно("");

КонецПроцедуры

// Идентификаторы панелей: id элемента с атрибутом popover, а не с префиксом «menu-».
Функция ЦелиКнопокМеню(Знач Текст)
	Возврат БезЕдиногоМеню(ЗначенияПоМаркеру(Текст, "popovertarget="""));
КонецФункции

// Без единого меню инсталляции: его связь стережёт ХолстКита на настоящей странице хаба.
Функция БезЕдиногоМеню(Знач Значения)

	Результат = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Если НЕ СтрНачинаетсяС(Значение, "hubmenu") Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИдентификаторыПанелейМеню(Знач Текст)

	Результат = Новый Массив();
	Для Каждого Найденное Из ЗначенияПоМаркеруСХвостом(Текст, "id=""") Цикл
		Если СтрНачинаетсяС(Найденное.Хвост, " popover") Тогда
			Результат.Добавить(Найденное.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗначенияПоМаркеру(Знач Текст, Знач Маркер)

	Результат = Новый Массив();
	Для Каждого Найденное Из ЗначенияПоМаркеруСХвостом(Текст, Маркер) Цикл
		Результат.Добавить(Найденное.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Значения атрибута по маркеру «имя="» с хвостом за кавычкой: так различаются одноимённые атрибуты.
Функция ЗначенияПоМаркеруСХвостом(Знач Текст, Знач Маркер)

	Результат = Новый Массив();
	Позиция = СтрНайти(Текст, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Результат.Добавить(Новый Структура("Значение, Хвост",
				Лев(Хвост, Конец - 1), Лев(Сред(Хвост, Конец + 1), 16)));
		КонецЕсли;
		Смещение = Позиция + СтрДлина(Маркер);
		Следующая = СтрНайти(Сред(Текст, Смещение), Маркер);
		Позиция = ?(Следующая = 0, 0, Смещение + Следующая - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВыдачаКита

// Выдача кита печатает разом все узлы и компоненты, которыми хаб собирает экраны, поэтому
// она и самый широкий образец: скрипта, инлайнового обработчика и инлайнового стиля в ней
// быть не должно.
&Тест
Процедура ВыдачаКитаРаботаетБезJS() Экспорт

	HTML = Выдача.Отрисовать();
	Ожидаем.Что(СтрНайти(HTML, "UI-кит") > 0, "выдача кита собирается целиком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "скриптов в ките нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "onclick"), "инлайн-обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "onchange"), "инлайн-обработчиков нет").Равно(0);
	// цвет кружка поля цвета и зеркала образца — данные для листа кита, а не оформление: атрибут
	// целиком одно свойство с цветом, без второго объявления
	ДанныеЦвета = Новый РегулярноеВыражение(
		"style=""(--_swatch: |--mirror-[^:"";]+:)#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})""");
	Ожидаем.Что(ДанныеЦвета.НайтиСовпадения(HTML).Количество() > 0,
		"КОНТРОЛЬ: в выдаче есть цвет кружка, сверять есть что").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ДанныеЦвета.Заменить(HTML, ""), "style="), "инлайн-стилей в ките нет").Равно(0);
	Ожидаем.Что(СтрНайти(ДанныеЦвета.Заменить("<i style=""--_swatch: #fff; position:fixed"">", ""), "style="),
		"самотест: цвет со вторым объявлением — уже стиль").Больше(0);

КонецПроцедуры

// Реестр значков проверяется НА КАРТОЧКЕ ПАКЕТА, а не на образце: подписи в реестр
// заводят ради ряда меты, и доказательство — что каждая доезжает до разметки значком.
&Тест
Процедура КаждаяПодписьМетыДоезжаетДоРазметкиЗначком() Экспорт

	Подписи = UI.ЗначкиМеты.Подписи();
	Ожидаем.Что(Подписи.Количество() > 5, "реестр непустой: " + Подписи.Количество()).ЭтоИстина();

	Мета = Новый Массив();
	Для Каждого Подпись Из Подписи Цикл
		Мета.Добавить(Новый Структура("Подпись, Значение", Подпись, "значение"));
	КонецЦикла;
	Мета.Добавить(Новый Структура("Подпись, Значение", "зеркал", "3"));

	HTML = UI.КарточкаОбъекта.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Непоказанные = Новый Массив();
	Для Каждого Подпись Из Подписи Цикл
		Если СтрНайти(HTML, "title=""" + Подпись + """") = 0 Тогда
			Непоказанные.Добавить(Подпись);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Непоказанные, ", "),
		"подписи реестра, не получившие значка в разметке").Равно("");

	Ожидаем.Что(СтрНайти(HTML, "зеркал: значение") > 0 ИЛИ СтрНайти(HTML, "зеркал: 3") > 0,
		"и случай «значка для подписи нет» печатается текстом").ЭтоИстина();

КонецПроцедуры

