// Слой представления хаба на ките: статика и лист стилей (цвета, ритм форм, сетки, каскад),
// токены и выбор темы, выдача кита без скрипта, витрины каталога (карточка, плашки тегов, значки
// версий, вкладка версий), брендирование, тексты экранов; сканы модуля интерфейс — сырая
// разметка, классы без правил, куки в каждом вызове страницы.

#Использовать asserts
#Использовать "../фикстуры"

Перем Исходники;       // ИсходникиПроекта — чтение файлов репозитория
Перем UI;              // Структура компонентов (фикстура СборкаUI)
Перем Поиск;           // КлассыСлоя — файл класса по имени
Перем Корпус;          // КорпусСлояПредставления — модуль интерфейс и кит
Перем ФайлыКорпуса;    // Соответствие — "модуль/Файл.os" -> полное имя
Перем КаталогПроекта;
Перем КаталогКлассов;
Перем РазборCSS;       // фикстура РитмФорм — единственный разбор таблицы стилей в слое
Перем Выдача;          // ВыдачаКита — образцы узлов и компонентов кита, которыми печатает хаб

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

КонецПроцедуры

&ПередВсеми
Процедура СобратьКомпоненты() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(ОбъединитьПути(КаталогКлассов, "..", ".."));

	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("РитмФорм");
	РеестрФикстур.Подключить("РядИнлайнов");
	РеестрФикстур.Подключить("КукиЗаглушка");
	Поиск.Подключить(КаталогКлассов, "РазборФормы");
	Поиск.Подключить(КаталогКлассов, "КонтроллерОформления");
	Поиск.Подключить(КаталогКлассов, "ПоляТега");
	РеестрФикстур.Подключить("СловарьТекстовЗаглушка");
	РеестрФикстур.Подключить("ФейкОкруженияВитрины");
	Поиск.Подключить(КаталогКлассов, "ВитринаПакетов");
	Поиск.Подключить(КаталогКлассов, "ОформлениеХаба");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	UI = Новый СборкаUI().Собрать(КаталогКлассов);
	РеестрФикстур.Подключить("ВыдачаКита");
	Выдача = Новый ВыдачаКита(UI.Кит);

	РеестрФикстур.Подключить("КорпусСлояПредставления");
	Корпус = Новый КорпусСлояПредставления("интерфейс", 230);
	ФайлыКорпуса = Корпус.Файлы();

КонецПроцедуры

#Область РядКарточек

// Ряд карточек читается как ряд: соседи одной высоты, разделитель и кнопки на одной линии
// при описаниях разной длины. Держится это двумя правилами — карточка в ячейке сетки
// колонка на всю высоту, полоса действий прижата к низу; без них ряд разъезжается.
&Тест
Процедура КарточкаВЯчейкеСеткиТянетсяНаРядИПрижимаетДействияКНизу() Экспорт

	Текст = ТекстCSS();

	ВСетке = ОбъявленияПравилаCSS(Текст, ".grid__cell > .card");
	Ожидаем.Что(ВСетке.Количество(), "на «.grid__cell > .card» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(ВСетке[0], "display: flex") > 0,
		"карточка в сетке — колонка: " + ВСетке[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВСетке[0], "flex-direction: column") > 0, "именно колонка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВСетке[0], "height: 100%") > 0,
		"и занимает ячейку целиком — иначе высоты соседей разные").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВСетке[0], "margin-bottom: 0") > 0,
		"собственный нижний маргин в сетке снят: интервал рядов держит её gap").ЭтоИстина();

	Действия = ОбъявленияПравилаCSS(Текст, ".grid__cell > .card > .card__actions");
	Ожидаем.Что(Действия.Количество(),
		"на «.grid__cell > .card > .card__actions» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Действия[0], "margin-top: auto") > 0,
		"полоса действий прижата к низу карточки: " + Действия[0]).ЭтоИстина();

	// вне сетки карточка остаётся блоком потока ни на какой ширине: одиночную растягивать
	// не во что, а margin-top: auto без флекса схлопнулся бы в ноль и убрал зазор над
	// разделителем; правила в @media (поля на телефоне) этого не меняют
	Обычная = БезусловныеПравилаCSS(Текст, ".card");
	Ожидаем.Что(Обычная.Количество(), "на «.card» ровно одно безусловное правило").Равно(1);
	Для Каждого Объявления Из ОбъявленияПравилаCSS(Текст, ".card") Цикл
		Ожидаем.Что(СтрНайти(Объявления, "display: flex"),
			"обычная карточка не флекс: " + Объявления).Равно(0);
		Ожидаем.Что(СтрНайти(Объявления, "height:"), "и высоты себе не назначает: " + Объявления).Равно(0);
	КонецЦикла;

	Полоса = ОбъявленияПравилаCSS(Текст, ".card__actions");
	Ожидаем.Что(Полоса.Количество(), "на «.card__actions» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Полоса[0], "margin-top: var(--space-4)") > 0,
		"вне сетки полоса держит свой отступ, а не auto: " + Полоса[0]).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ИменаПолейВыдачи

&Тест
Процедура КаждоеОтрисованноеУправлениеИмеетName() Экспорт

	Проверено = 0;
	Нарушители = Новый Массив();

	Для Каждого Часть Из Выдача.Разделы() Цикл
		Для Каждого Образец Из Часть.Образцы Цикл
			Для Каждого Управление Из УправленияФормы(Образец.Разметка) Цикл
				Если СтрНайти(Управление, " disabled") > 0 Тогда
					Продолжить; // disabled формой не отправляется
				КонецЕсли;
				Если СтрНайти(Управление, "props__reveal-box") > 0 Тогда
					Продолжить; // показ секрета свойства — состояние экрана, а не данные формы
				КонецЕсли;
				Если СтрНайти(Управление, " form=""""") > 0 Тогда
					Продолжить; // отвязано от формы (кружки и палитра поля цвета): не отправляется
				КонецЕсли;
				Проверено = Проверено + 1;
				Если НЕ ЗначениеЗаполнено(АтрибутТега(Управление, "name")) Тогда
					Нарушители.Добавить(Часть.Ключ + " / " + Образец.Подпись + ": " + Управление);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено >= 8,
		"отправляемых управлений в выдаче кита не меньше восьми: " + Проверено).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушители, "; "),
		"управления формы без непустого name").Равно("");

КонецПроцедуры

#КонецОбласти

#Область РазборФлажков

&Тест
Процедура ЧтениеТумблераЗначениемАНеЗаполненностью() Экспорт

	Разбор = Новый РазборФормы();

	ВыключенныйТумблер = ТелоФормыИзРазметки(
		UI.Кит.Тумблер("публикация", "Публикация").Включено(Ложь).Рендер());
	ВключённыйТумблер = ТелоФормыИзРазметки(
		UI.Кит.Тумблер("публикация", "Публикация").Включено(Истина).Рендер());

	Ожидаем.Что(ЗначениеЗаполнено(Разбор.Поле(Разбор.Разобрать(ВыключенныйТумблер), "публикация")),
		"ЗначениеЗаполнено(""0"") = Истина — приём непригоден для тумблера").ЭтоИстина();

	Ожидаем.Что(Разбор.Флажок(Разбор.Разобрать(ВыключенныйТумблер), "публикация"),
		"выключенный тумблер читается как Ложь").ЭтоЛожь();
	Ожидаем.Что(Разбор.Флажок(Разбор.Разобрать(ВключённыйТумблер), "публикация"),
		"включённый тумблер читается как Истина").ЭтоИстина();

	ВыключенныйФлажок = ТелоФормыИзРазметки(
		UI.Кит.Поле("публикация", "Публикация").ТипЗначения(Тип("Булево")).Отмечено(Ложь).Рендер());
	ВключённыйФлажок = ТелоФормыИзРазметки(
		UI.Кит.Поле("публикация", "Публикация").ТипЗначения(Тип("Булево")).Отмечено(Истина).Рендер());

	Ожидаем.Что(ВыключенныйФлажок, "невыбранный checkbox не отправляется вовсе").Равно("");
	Ожидаем.Что(Разбор.Флажок(Разбор.Разобрать(ВыключенныйФлажок), "публикация"),
		"отсутствие поля — Ложь").ЭтоЛожь();
	Ожидаем.Что(Разбор.Флажок(Разбор.Разобрать(ВключённыйФлажок), "публикация"),
		"отмеченный checkbox — Истина").ЭтоИстина();

	Ожидаем.Что(Разбор.Флажок(Разбор.Разобрать("публикация=on"), "публикация"),
		"чужое значение не включает").ЭтоЛожь();

КонецПроцедуры

Функция ЧислоВхождений(Знач Текст, Знач Фрагмент)

	Количество = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Фрагмент);

	Пока Позиция > 0 Цикл
		Количество = Количество + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Фрагмент));
		Позиция = СтрНайти(Хвост, Фрагмент);
	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция ТелоФормыИзРазметки(Знач HTML)

	Части = Новый Массив();
	Позиция = СтрНайти(HTML, "<input");

	Пока Позиция > 0 Цикл

		Хвост = Сред(HTML, Позиция);
		КонецТега = СтрНайти(Хвост, ">");
		Если КонецТега = 0 Тогда
			Прервать;
		КонецЕсли;
		Тег = Лев(Хвост, КонецТега);

		Имя = АтрибутТега(Тег, "name");
		Значение = АтрибутТега(Тег, "value");
		ЭтоФлажок = СтрНайти(Тег, "type=""checkbox""") > 0;
		Отмечен = СтрНайти(Тег, " checked") > 0;
		Заблокирован = СтрНайти(Тег, " disabled") > 0;

		Отправляется = ЗначениеЗаполнено(Имя) И НЕ Заблокирован И (НЕ ЭтоФлажок ИЛИ Отмечен);
		Если Отправляется Тогда
			Части.Добавить(Имя + "=" + Значение);
		КонецЕсли;

		Смещение = Позиция + КонецТега;
		Следующая = СтрНайти(Сред(HTML, Смещение), "<input");
		Позиция = ?(Следующая = 0, 0, Смещение + Следующая - 1);

	КонецЦикла;

	Возврат СтрСоединить(Части, "&");

КонецФункции

Функция АтрибутТега(Знач Тег, Знач Имя)

	Маркер = " " + Имя + "=""";
	Начало = СтрНайти(Тег, Маркер);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Тег, Начало + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

#КонецОбласти

#Область ЗначкиМетыИВитринаПакетов

// Реестр значков меты бесполезен, если он показывает на иконку, которой в наборе нет:
// компонент нарисовал бы подсказку без самого значка.
&Тест
Процедура ЗначкиМетыПоказываютНаСуществующиеИконки() Экспорт

	Подписи = UI.ЗначкиМеты.Подписи();
	Ожидаем.Что(Подписи.Количество() > 0, "реестр непустой").ЭтоИстина();

	Потерянные = Новый Массив();
	Для Каждого Подпись Из Подписи Цикл
		Имя = UI.ЗначкиМеты.Значок(Подпись);
		Если НЕ UI.НаборИконок.Содержит(Имя) Тогда
			Потерянные.Добавить(Подпись + " → " + Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"подписи показывают на иконки, которых нет в наборе").Равно("");

КонецПроцедуры

// Реестр значков ключуется ОТОБРАЖАЕМЫМ текстом подписи: и переформулированная строка
// словаря, и новый экран со своей подписью тихо возвращают ряд к тексту «подпись: значение».
// Сторож двусторонний: состав поставщиков сверяется поимённо, подписи каждого — с реестром.
&Тест
Процедура ПодписиМетыПоставщиковЛежатВРеестреЗначков() Экспорт

	Поставщики = ПоставщикиМеты();
	Ожидаемые = ФайлыПоставщиковМеты();

	Новые = Новый Массив();
	Для Каждого КиЗ Из Поставщики Цикл
		Если Ожидаемые.Получить(КиЗ.Ключ) = Неопределено Тогда
			Новые.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Новые, ", "),
		"новый поставщик меты: заведите значки его подписям и объявите его"
			+ " в ФайлыПоставщиковМеты()").Равно("");

	Пропавшие = Новый Массив();
	Для Каждого КиЗ Из Ожидаемые Цикл
		Если Поставщики.Получить(КиЗ.Ключ) = Неопределено Тогда
			Пропавшие.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение.Почему + ")");
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Пропавшие, ", "),
		"поставщик меты больше не находится: сканер ослеп либо экран переписан").Равно("");

	Известные = Новый Соответствие();
	Для Каждого Подпись Из UI.ЗначкиМеты.Подписи() Цикл
		Известные.Вставить(Подпись, Истина);
	КонецЦикла;

	Немые = Новый Массив();
	Безымянные = Новый Массив();
	Для Каждого КиЗ Из Поставщики Цикл

		Если КиЗ.Значение.Количество() = 0 Тогда
			Немые.Добавить(КиЗ.Ключ);
			Продолжить;
		КонецЕсли;

		Для Каждого Подпись Из КиЗ.Значение Цикл
			Если Известные.Получить(Подпись) = Неопределено Тогда
				Безымянные.Добавить(КиЗ.Ключ + ": «" + Подпись + "»");
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Немые, ", "),
		"у поставщика не разобрано ни одной подписи: сторож его больше не проверяет").Равно("");
	Ожидаем.Что(СтрСоединить(Безымянные, ", "),
		"подписи меты без значка в ЗначкиМеты: ряд напечатает их текстом").Равно("");

КонецПроцедуры

// Модель шапки пакета собирает витрина, а не контроллер: кит должен получить ВСЁ, чего сам
// придумать не может, — слаг вида, иконку, подпись вида и значки меты. Путь до живой
// страницы длинный, а потеря любого из четырёх полей страницу не роняет.
&Тест
Процедура ВитринаСобираетМодельШапкиПакетаСоЗначкамиИВидом() Экспорт

	Окружение = Новый ФейкОкруженияВитрины();
	Витрина = Новый ВитринаПакетов(Окружение, Окружение, UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Окружение);

	Модель = Витрина.ШапкаПакета(ПакетДляВитрины(), "alice", 1204);

	Ожидаем.Что(Модель.Вид, "слаг вида для data-kind").Равно("package");
	Ожидаем.Что(Модель.Иконка, "иконка вида").Равно("пакет");
	Ожидаем.Что(Модель.Подпись, "подпись вида").Равно("пакет");
	Ожидаем.Что(Модель.Имя, "имя объекта").Равно("winow");

	Значки = Новый Соответствие();
	Для Каждого Элемент Из Модель.Мета Цикл
		Подпись = "";
		Если Элемент.Свойство("Подпись", Подпись) Тогда
			Значки.Вставить(Подпись, Элемент.Значок);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Значки.Получить("автор"), "значок автора").Равно(UI.ЗначкиМеты.Значок("автор"));
	Ожидаем.Что(Значки.Получить("скачиваний"), "значок скачиваний")
		.Равно(UI.ЗначкиМеты.Значок("скачиваний"));
	Ожидаем.Что(Значки.Получить("лицензия"), "значок лицензии")
		.Равно(UI.ЗначкиМеты.Значок("лицензия"));

	// у репозитория своя подпись: без неё реестр значков проходит мимо, и ссылка печатается
	// голым текстом без значка
	Ожидаем.Что(Значки.Получить("репозиторий"), "значок репозитория")
		.Равно(UI.ЗначкиМеты.Значок("репозиторий"));
	Ожидаем.Что(ЗначениеМеты(Модель.Мета, "репозиторий"),
		"видимый текст ссылки — адрес без схемы").Равно("github.com/x");
	Ожидаем.Что(АдресМеты(Модель.Мета, "репозиторий"),
		"ведёт ссылка на полный адрес карточки").Равно("https://github.com/x");

	// число — через локаль резолвера, а не маской на месте
	Ожидаем.Что(ЗначениеМеты(Модель.Мета, "скачиваний"), "число в пользовательском виде")
		.Равно(UI.Тексты.ЧислоТекстом(1204));

	// пустой автор в мету не попадает
	БезАвтора = Витрина.ШапкаПакета(ПакетДляВитрины(), "", 0);
	Ожидаем.Что(ЗначениеМеты(БезАвтора.Мета, "автор"), "пустой автор не показывается").Равно("");

КонецПроцедуры

// Плашка «с апстрима» ставится по ОТСУТСТВИЮ собственных версий у имени, а не по наличию
// апстрима у пула: в проксирующем пуле часть имён своя, часть чужая. Обе стороны ответа
// проверяются в одном списке — иначе «объявить своими всех» и «никого» выглядели бы одинаково.
&Тест
Процедура ПлашкаСАпстримаСтоитТолькоУПривезённогоИмени() Экспорт

	Окружение = Новый ФейкОкруженияВитрины();
	Окружение.ОбъявитьСвоим(17); // winow здесь публиковали, а «привезённый» только проксируется
	Витрина = Новый ВитринаПакетов(Окружение, Окружение, UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Окружение);

	Привезённый = ПакетДляВитрины();
	Привезённый.Идентификатор = 91;
	Привезённый.Имя = "чужой";

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Пакет, Пул", ПакетДляВитрины(), Новый Структура("Имя", "main")));
	Строки.Добавить(Новый Структура("Пакет, Пул", Привезённый, Новый Структура("Имя", "main")));

	Карточки = Витрина.Карточки(Строки);

	Ожидаем.Что(ТекстыПлашек(Карточки[0].Плашки),
		"у своего имени плашки происхождения нет").Равно("");
	Ожидаем.Что(ТекстыПлашек(Карточки[1].Плашки),
		"у привезённого имени плашка «с апстрима» стоит")
		.Равно(UI.Тексты.Текст("public.showcase.upstream.tag"));

КонецПроцедуры

// Резерв — имя без единой версии: у него плашка «резерв», а не «с апстрима», хотя своих версий
// нет и у него. Снять резерв предлагают только тому, кто вправе, — пунктом меню ⚙ карточки,
// который открывает окно подтверждения страницы пула, а не формой в карточке.
&Тест
Процедура ПлашкаРезерваИСнятиеСтоятТолькоУИмениБезВерсий() Экспорт

	Окружение = Новый ФейкОкруженияВитрины();
	Окружение.ОбъявитьСвоим(17);
	Окружение.ОбъявитьРезервом(91);
	Витрина = Новый ВитринаПакетов(Окружение, Окружение, UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(),
		Окружение);

	Резерв = ПакетДляВитрины();
	Резерв.Идентификатор = 91;
	Резерв.Имя = "reserved-name";
	Привезённый = ПакетДляВитрины();
	Привезённый.Идентификатор = 92;
	Привезённый.Имя = "upstream-name";

	Пул = Новый Структура("Имя, Идентификатор", "main", 1);
	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Пакет, Пул", ПакетДляВитрины(), Пул));
	Строки.Добавить(Новый Структура("Пакет, Пул", Резерв, Пул));
	Строки.Добавить(Новый Структура("Пакет, Пул", Привезённый, Пул));
	Смотрящий = Новый Структура("Идентификатор, Логин", 5, "owner");

	Окружение.РазрешитьСнятиеРезервов(Истина);
	Карточки = Витрина.Карточки(Строки, Смотрящий);

	Ожидаем.Что(ТекстыПлашек(Карточки[0].Плашки), "у своего имени плашек нет").Равно("");
	Ожидаем.Что(ТекстыПлашек(Карточки[1].Плашки), "у имени без версий — «резерв»")
		.Равно(UI.Тексты.Текст("public.showcase.reserve.tag"));
	Ожидаем.Что(ТекстыПлашек(Карточки[2].Плашки), "у привезённого — «с апстрима»")
		.Равно(UI.Тексты.Текст("public.showcase.upstream.tag"));

	Ожидаем.Что(АдресаДействий(Карточки[1].Действия), "снятие резерва ведёт в окно подтверждения")
		.Равно(Новый АдресаСтраниц().СнятияРезерва("main", "reserved-name"));
	Ожидаем.Что(Карточки[1].МенюДействий, "действия резерва собраны в меню ⚙").Заполнено();
	Ожидаем.Что(Карточки[0].МенюДействий, "у своего имени меню нет").Равно("");
	Карточка = UI.КарточкаОбъекта.Карточка(Карточки[1]).Рендер();
	Ожидаем.Что(Карточка, "в карточке — меню ⚙").Содержит("popovertarget=");
	Ожидаем.Что(Карточка, "пункт снятия — кнопка окна по адресу").Содержит("data-window-link");
	Ожидаем.Что(Карточка, "и ведёт без скрипта на страницу с окном")
		.Содержит("href=""" + Новый АдресаСтраниц().СнятияРезерва("main", "reserved-name") + """");
	Ожидаем.Что(СтрНайти(Карточка, "<form"), "формы в карточке нет").Равно(0);
	Ожидаем.Что(АдресаДействий(Карточки[0].Действия), "у своего имени снимать нечего").Равно("");
	Ожидаем.Что(АдресаДействий(Карточки[2].Действия), "у привезённого тоже").Равно("");

	Окружение.РазрешитьСнятиеРезервов(Ложь);
	Ожидаем.Что(АдресаДействий(Витрина.Карточки(Строки, Смотрящий)[1].Действия),
		"не вправе — кнопки снятия нет").Равно("");
	Ожидаем.Что(АдресаДействий(Витрина.Карточки(Строки)[1].Действия),
		"гостю — тоже").Равно("");

КонецПроцедуры

Функция АдресаДействий(Знач Действия)

	Адреса = Новый Массив();
	Для Каждого Действие Из Действия Цикл
		Адреса.Добавить(Строка(Действие.Адрес));
	КонецЦикла;
	Возврат СтрСоединить(Адреса, ",");

КонецФункции

// Тексты плашек модели через запятую: плашки сравниваются по СОДЕРЖАНИЮ, а не по числу.
Функция ТекстыПлашек(Знач Плашки)

	Тексты = Новый Массив();
	Для Каждого Плашка Из Плашки Цикл
		Тексты.Добавить(Строка(Плашка.Текст));
	КонецЦикла;
	Возврат СтрСоединить(Тексты, ",");

КонецФункции

// Адрес репозитория может лечь в карточку мимо доменной проверки (перенос, правка в базе
// руками). Слой вывода не делает из него ни ссылки, ни видимого текста — иначе
// «javascript:…» печаталось бы на странице пакета.
&Тест
Процедура НевеббовыйАдресРепозиторияВШапкуНеПопадает() Экспорт

	Окружение = Новый ФейкОкруженияВитрины();
	Витрина = Новый ВитринаПакетов(Окружение, Окружение, UI.Тексты, UI.ЗначкиМеты, Новый АдресаСтраниц(), Окружение);

	Пакет = ПакетДляВитрины();
	Пакет.АдресРепозитория = "javascript:alert('REPO')";
	Модель = Витрина.ШапкаПакета(Пакет, "alice", 1);

	Ожидаем.Что(ЗначениеМеты(Модель.Мета, "репозиторий"),
		"небезопасный адрес не стал видимым текстом").Равно("");
	Ожидаем.Что(АдресМеты(Модель.Мета, "репозиторий"),
		"и ссылкой не стал").Равно("");

	// подпись остаётся: строка меты про репозиторий у пакета есть, просто она не ведёт никуда
	Подписи = "";
	Для Каждого Элемент Из Модель.Мета Цикл
		Найденная = "";
		Если Элемент.Свойство("Подпись", Найденная) Тогда
			Подписи = Подписи + Найденная + ";";
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Подписи, "репозиторий") > 0, "подпись репозитория на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗначокМетыИщетсяБезОглядкиНаРегистрИПробелы() Экспорт

	Ожидаем.Что(UI.ЗначкиМеты.Значок("  ПУЛ "), "регистр и пробелы значения не имеют").Равно("стопка");
	Ожидаем.Что(UI.ЗначкиМеты.Значок("зеркал"), "незнакомая подпись значка не получает").Равно("");
	Ожидаем.Что(UI.ЗначкиМеты.Значок(""), "пустая подпись").Равно("");
	Ожидаем.Что(UI.ЗначкиМеты.Значок(Неопределено), "и Неопределено").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ТокеныТемы

// Прогрессивное улучшение ломается МОЛЧА: разметку правит экран, а читает её скрипт, и серверный
// тест этого не заметит. Носитель значения обязан различать <select> и брать выбранный
// вариант, а не сам список.
&Тест
Процедура ТокеныПечатаютОбеТемыИВсеГруппыПеременных() Экспорт

	CSS = UI.Токены.Переменные();

	Ожидаем.Что(СтрНайти(CSS, ":root{") > 0, "тёмная тема в :root").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "html[data-theme=""light""]{") > 0, "светлая тема отдельным селектором").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--color-bg:") > 0, "цвета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--font-body:") > 0, "шрифты").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--space-1:") > 0, "шаг сетки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--radius-md:") > 0, "радиусы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--shadow-sm:") > 0, "тени").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--color-success:") > 0, "семантические цвета статусов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--motion-fast:") > 0, "движение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТокеныСодержатРампыАкцентаИНейтрали() Экспорт

	CSS = UI.Токены.Переменные();

	Ожидаем.Что(СтрНайти(CSS, "--color-neutral-100:") > 0, "нейтральная рампа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--color-neutral-900:") > 0, "девять ступеней").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--color-accent-500:#") > 0, "рампа акцента").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТемаИзОформленияМеняетАтрибутHTML() Экспорт
	Ожидаем.Что(UI.Токены.АтрибутТемы()).Равно("dark");
	Ожидаем.Что(UI.Токены.АтрибутТемы(Новый Структура("Тема", "светлая"))).Равно("light");
	Ожидаем.Что(UI.Токены.АтрибутТемы(Новый Структура("Тема", "чепуха"))).Равно("dark");
КонецПроцедуры

&Тест
Процедура ПлотностьМасштабируетСеткуИПечатаетсяСТочкой() Экспорт

	CSS = UI.Токены.Переменные(Новый Структура("Плотность", 1.4));

	Ожидаем.Что(СтрНайти(CSS, "--space-1:5.6px") > 0, "шаг сетки умножен, разделитель — точка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "5,6"), "локальная запятая не просочилась в CSS").Равно(0);

КонецПроцедуры

&Тест
Процедура АкцентИзПрофиляПопадаетВПеременные() Экспорт

	Свой = ЗначенияПеременных(UI.Токены.Переменные(Новый Структура("Акцент", "#ff8800")));
	Базовый = ЗначенияПеременных(UI.Токены.Переменные());

	Ожидаем.Что(Свой.Получить("--md-sys-color-primary"),
		"акцент применён: основной цвет схемы выведен из него")
		.Не_().Равно(Базовый.Получить("--md-sys-color-primary"));
	Ожидаем.Что(Свой.Получить("--color-accent"), "акцент кита — основной цвет схемы")
		.Равно("var(--md-sys-color-primary)");

КонецПроцедуры

&Тест
Процедура ОпасныйАкцентНеПопадаетВStyle() Экспорт

	Опасные = Новый Массив();
	Опасные.Добавить("#fff;}html{display:none}");
	Опасные.Добавить("red;background:url(http://evil/x)");
	Опасные.Добавить("</style><script>alert(1)</script>");
	Опасные.Добавить("expression(alert(1))");
	Опасные.Добавить("#12345");
	Опасные.Добавить("＃ffffff");                       // fullwidth-решётка (обход по виду)
	Опасные.Добавить("#fff fff");                       // пробел внутри значения
	Опасные.Добавить("#fff" + Символы.ПС + "html{display:none}"); // перевод строки
	Опасные.Добавить("#ff/*комментарий*/f");            // CSS-комментарий внутри цвета
	Опасные.Добавить("var(--color-bg);}html{display:none");       // выход из var()

	Для Каждого Значение Из Опасные Цикл
		CSS = UI.Токены.Переменные(Новый Структура("Акцент", Значение));
		Ожидаем.Что(СтрНайти(НРег(CSS), "</style"), "тег style не закрыт извне").Равно(0);
		Ожидаем.Что(СтрНайти(НРег(CSS), "display:none"), "чужое правило не просочилось").Равно(0);
		Ожидаем.Что(СтрНайти(НРег(CSS), "expression("), "выражение не просочилось").Равно(0);
		Ожидаем.Что(СтрНайти(НРег(CSS), "url(http"), "внешняя ссылка не просочилась").Равно(0);
	КонецЦикла;

	Ожидаем.Что(СтрНайти(UI.Токены.Переменные(Новый Структура("Акцент", "#fff" + Символы.ПС + "x")), Символы.ПС),
		"перевода строки в объявлениях нет").Равно(0);

	Ожидаем.Что(UI.Токены.БезопасныйЦвет("#abc")).Равно("#abc");
	Ожидаем.Что(UI.Токены.БезопасныйЦвет("#AABBCC")).Равно("#AABBCC");
	Ожидаем.Что(UI.Токены.БезопасныйЦвет("rgb(1,2,3)")).Равно("");
	Ожидаем.Что(UI.Токены.БезопасныйМножитель("чепуха")).Равно(1);
	Ожидаем.Что(UI.Токены.БезопасныйМножитель(99)).Равно(1);

КонецПроцедуры

&Тест
Процедура ТекстНаАкцентеЧитаетсяПриЛюбомАкцентеВОбеихТемах() Экспорт

	// текст на акцентной заливке читается в обеих темах при любом акценте, даже почти
	// чёрном и почти белом: контраст держит схема, а не удачный выбор цвета
	Для Каждого Акцент Из СтрРазделить("#111111,#f5f5f5", ",") Цикл
		Весь = UI.Токены.Переменные(Новый Структура("Акцент", Акцент));
		Граница = СтрНайти(Весь, "html[data-theme=""light""]");
		Темы = Новый Структура("Тёмная, Светлая",
			ЗначенияПеременных(Лев(Весь, Граница - 1)), ЗначенияПеременных(Сред(Весь, Граница)));
		Для Каждого Тема Из Темы Цикл
			Контраст = UI.Токены.КоэффициентКонтраста(Тема.Значение.Получить("--md-sys-color-primary"),
				Тема.Значение.Получить("--md-sys-color-on-primary"));
			Ожидаем.Что(Контраст >= 4.5, СтрШаблон("акцент %1, тема %2: контраст текста на акценте %3",
				Акцент, Тема.Ключ, Формат(Контраст, "ЧДЦ=2"))).ЭтоИстина();
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(UI.Токены.КонтрастныйЦвет("#fff"), "#fff — светлый фон").Равно("#16181f");
	Ожидаем.Что(UI.Токены.КонтрастныйЦвет("#000"), "#000 — тёмный фон").Равно("#ffffff");
	Ожидаем.Что(UI.Токены.КонтрастныйЦвет("</style>"), "мусор — безопасное умолчание").Равно("#ffffff");

КонецПроцедуры

#КонецОбласти

#Область ВыборОформления

&Тест
Процедура ОформлениеРазбираетсяИзЗначенияCookie() Экспорт

	Разобранное = UI.Оформление.РазобратьЗначение("тема=светлая&акцент=%239184d9&плотность=1.2");

	Ожидаем.Что(Разобранное.Тема).Равно("светлая");
	Ожидаем.Что(Разобранное.Акцент).Равно("#9184d9");
	Ожидаем.Что(Разобранное.Плотность).Равно("1.2");

КонецПроцедуры

&Тест
Процедура ПустоеЗначениеCookieДаётДефолт() Экспорт
	Ожидаем.Что(UI.Оформление.РазобратьЗначение("").Количество()).Равно(0);
	Ожидаем.Что(UI.Оформление.ПоКукам(Неопределено).Свойство("Тема")).ЭтоИстина();
КонецПроцедуры

#КонецОбласти

#Область СтраницаИСтатика

&Тест
Процедура СтраницаСсылаетсяНаСтатикуСКонтентХешем() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));

	ХешСтилей = Лев(UI.Активы.Отпечаток(UI.Поставка.ФайлСтилей()), UI.Отпечатки.ДлинаПрефиксаХеша());
	ХешСкрипта = Лев(UI.Активы.Отпечаток(UI.Поставка.ФайлСкрипта()), UI.Отпечатки.ДлинаПрефиксаХеша());

	Ожидаем.Что(СтрНайти(HTML, СтрШаблон("<link rel=""stylesheet"" href=""%1"">", UI.Адреса.АдресСтилей())) > 0,
		"CSS с контент-хешем подключён").ЭтоИстина();
	Ожидаем.Что(СтрДлина(ХешСтилей), "отпечаток стилей посчитан").Равно(UI.Отпечатки.ДлинаПрефиксаХеша());
	Ожидаем.Что(СтрНайти(HTML, "openhub-" + ХешСтилей + ".css") > 0, "хеш содержимого в имени файла").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "openhub-" + ХешСкрипта + ".js") > 0, "хеш содержимого в имени скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<style") > 0, "в <style> остались только токены темы").ЭтоИстина();

КонецПроцедуры

// Оформление приезжает ДВУМЯ листами, и порядок между ними — это порядок каскада.
// Встань лист хаба первым, его правила перестали бы перебивать китовые, и брендирование
// молча вернулось бы к виду библиотеки.
&Тест
Процедура ЛистХабаПриезжаетПослеБазовогоЛистаКита() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Голова = Лев(HTML, СтрНайти(HTML, "</head>"));

	Базовый = СтрНайти(Голова, СтрШаблон("<link rel=""stylesheet"" href=""%1"">",
		UI.Активы.АдресБазовогоЛиста()));
	Свой = СтрНайти(Голова, СтрШаблон("<link rel=""stylesheet"" href=""%1"">",
		UI.Адреса.АдресСтилей()));

	Ожидаем.Что(Базовый > 0, "базовый лист библиотеки подключён: " + Голова).ЭтоИстина();
	Ожидаем.Что(Свой > 0, "лист хаба подключён: " + Голова).ЭтоИстина();
	Ожидаем.Что(Базовый < Свой, "лист хаба идёт ВТОРЫМ: " + Голова).ЭтоИстина();
	Ожидаем.Что(UI.Активы.АдресБазовогоЛиста() = UI.Адреса.АдресСтилей(),
		"адреса у листов разные").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура АдресСтатикиМеняетсяВместеССодержимым() Экспорт

	ХешА = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
	ХешБ = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210";

	ИмяА = UI.Отпечатки.ИмяСОтпечатком("openhub.css", ХешА);
	ИмяБ = UI.Отпечатки.ИмяСОтпечатком("openhub.css", ХешБ);

	Ожидаем.Что(ИмяА, "хеш подставлен перед расширением").Равно("openhub-0123456789abcdef.css");
	Ожидаем.Что(ИмяА = ИмяБ, "другое содержимое — другой адрес").ЭтоЛожь();

	Ожидаем.Что(UI.Отпечатки.ИмяСОтпечатком("openhub.css", ВРег(ХешА)), "хеш в адресе всегда в нижнем регистре")
		.Равно(ИмяА);

	Ожидаем.Что(UI.Отпечатки.ИмяСОтпечатком("README", ХешА)).Равно("README-0123456789abcdef");
	Ожидаем.Что(UI.Отпечатки.ИмяСОтпечатком("openhub.css", ""), "нет отпечатка — имя как есть")
		.Равно("openhub.css");

КонецПроцедуры

&Тест
Процедура БелыйСписокСтатикиНеПодпускаетКДискуЧужиеИмена() Экспорт

	Чужие = Новый Массив();
	Чужие.Добавить("../../etc/passwd");
	Чужие.Добавить("..%2F..%2Fetc%2Fpasswd");
	Чужие.Добавить("../статика/openhub.css");
	Чужие.Добавить("openhub.css");                          // верное имя БЕЗ хеша
	Чужие.Добавить("openhub-0000000000000000.css");          // верное имя с ЧУЖИМ хешем
	Чужие.Добавить(ВРег(UI.Активы.ПубличноеИмя(UI.Поставка.ФайлСтилей()))); // верный адрес, чужой регистр
	Чужие.Добавить("packagedef");
	Чужие.Добавить("");

	Для Каждого Имя Из Чужие Цикл
		Ожидаем.Что(UI.Активы.ТипКонтента(Имя) = Неопределено,
			"тип контента не выдан для «" + Имя + "»").ЭтоИстина();
		Ожидаем.Что(UI.Активы.ПутьНаДиске(Имя) = Неопределено,
			"путь на диске не выдан для «" + Имя + "»").ЭтоИстина();
		Ожидаем.Что(UI.Активы.ETag(Имя), "ETag не выдан для «" + Имя + "»").Равно("");
	КонецЦикла;

	Верное = UI.Активы.ПубличноеИмя(UI.Поставка.ФайлСтилей());
	Ожидаем.Что(UI.Активы.ТипКонтента(Верное), "верный адрес отдаётся").Равно("text/css; charset=utf-8");
	Ожидаем.Что(UI.Активы.ПутьНаДиске(Верное), "путь ведёт на файл стилей поставки")
		.Равно(ОбъединитьПути(UI.Поставка.Каталог(), UI.Поставка.ФайлСтилей()));
	Ожидаем.Что(Новый Файл(UI.Активы.ПутьНаДиске(Верное)).Существует(),
		"и такой файл есть").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИконкаСайтаОбъявленаИОтдаётся() Экспорт

	Каталог = ОбъединитьПути(КаталогПроекта, "src", UI.Поставка.ИмяКаталога());
	Иконка = Новый Файл(ОбъединитьПути(Каталог,
		UI.Активы.ОтносительныйПуть(UI.Поставка.ФайлИконки())));
	Ожидаем.Что(Иконка.Существует(), "файл иконки есть на диске").ЭтоИстина();

	Адрес = UI.Адреса.АдресИконки();
	Имя = UI.Активы.ПубличноеИмя(UI.Поставка.ФайлИконки());
	Ожидаем.Что(UI.Активы.ТипКонтента(Имя), "иконка в белом списке отдачи").Равно(UI.Поставка.ТипИконки());
	Ожидаем.Что(СтрНайти(Адрес, Лев(Sha256Файла(Иконка.ПолноеИмя), UI.Отпечатки.ДлинаПрефиксаХеша())) > 0,
		"адрес иконки несёт хеш её содержимого: " + Адрес).ЭтоИстина();

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Голова = Лев(HTML, СтрНайти(HTML, "</head>"));
	Ожидаем.Что(СтрНайти(Голова, СтрШаблон("<link rel=""icon"" type=""%1"" href=""%2"">",
		UI.Поставка.ТипИконки(), Адрес)) > 0, "иконка подключена в <head>").ЭтоИстина();

КонецПроцедуры

// Запасной .ico и иконка домашнего экрана бесполезны по адресу, которого хаб не отдаёт. Адреса
// берутся ИЗ РАЗМЕТКИ, тип — из белого списка, содержимое сверяется с фирменным китом: сверка
// адреса с методом активов была бы тавтологией — разметка из него и собрана.
&Тест
Процедура ЗапаснаяИконкаИИконкаЭкранаОбъявленыИОтдаются() Экспорт

	Голова = ГоловаСтраницы();

	Запасная = АдресИзГоловы(Голова, "<link rel=""icon"" sizes=""any"" href=""");
	Экранная = АдресИзГоловы(Голова, "<link rel=""apple-touch-icon"" href=""");

	Ожидаем.Что(UI.Активы.ТипКонтента(ИмяИзАдресаСтатики(Запасная)),
		"запасная иконка в белом списке отдачи").Равно(UI.Поставка.ТипЗапаснойИконки());
	Ожидаем.Что(UI.Активы.ТипКонтента(ИмяИзАдресаСтатики(Экранная)),
		"иконка домашнего экрана в белом списке отдачи").Равно(UI.Поставка.ТипИконкиДомашнегоЭкрана());

	Ожидаем.Что(UI.Поставка.ТипЗапаснойИконки(), "тип .ico").Равно("image/vnd.microsoft.icon");
	Ожидаем.Что(UI.Поставка.ТипИконкиДомашнегоЭкрана(), "тип иконки экрана").Равно("image/png");


	Ожидаем.Что(Запасная = UI.Адреса.АдресИконки(),
		"запасная иконка не подменена основной: .ico и .svg — разные файлы").ЭтоЛожь();

КонецПроцедуры

// Знак бренда рисуется картинкой из статики, а не глифом кита. Адрес из разметки с
// Активы.АдресЗнака() не сверяется — разметка из него и собрана: сторож смотрит на тип
// содержимого, белый список отдачи и на то, что знак не подменён иконкой сайта.
&Тест
Процедура ЗнакБрендаРисуетсяВШапкеИОтдаётся() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Шапка = МеждуМаркерами(HTML, "<header", "</header>");

	Адрес = АдресИзГоловы(Шапка, "<img class=""brand__mark"" src=""");

	Ожидаем.Что(UI.Активы.ТипКонтента(ИмяИзАдресаСтатики(Адрес)), "знак в белом списке отдачи")
		.Равно(UI.Поставка.ТипИконки());

	Ожидаем.Что(Адрес = UI.Адреса.АдресИконки(),
		"знак шапки и иконка вкладки — разные файлы: знак рисуется крупно, иконка"
			+ " упрощена под 16 px").ЭтоЛожь();

	// текст названия остаётся текстом рядом с картинкой — картинка декоративна
	Ожидаем.Что(СтрНайти(Шапка, СтрШаблон("<span>%1</span>", UI.Бренд.Знак())) > 0,
		"название хаба рядом со знаком осталось текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "alt=""""") > 0, "у декоративной картинки пустой alt").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтраницаПечатаетТокеныТемыИнлайномВHead() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("светлая")));

	Голова = Лев(HTML, СтрНайти(HTML, "</head>"));

	Ожидаем.Что(СтрНайти(Голова, "<style id=""токены-темы"">") > 0, "блок токенов в <head>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "--color-bg:") > 0, "переменные цвета инлайном").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ТегHTML("light")) > 0, "тема из куки попала в <html>").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТемуИзКукДостаётСамРендерер() Экспорт

	Тёмная = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("тёмная")));
	Светлая = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("светлая")));
	БезКук = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));

	Ожидаем.Что(СтрНайти(Тёмная, ТегHTML("dark")) > 0, "куки с тёмной темой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Светлая, ТегHTML("light")) > 0, "куки со светлой темой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезКук, ТегHTML("dark")) > 0, "без кук — оформление инсталляции").ЭтоИстина();

	Мусор = Новый КукиЗаглушка();
	Мусор.Добавить(UI.Оформление.ИмяCookie(), "%%%&тема=&&акцент=</style>");
	Испорченная = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Мусор));

	Ожидаем.Что(СтрНайти(Испорченная, ТегHTML("dark")) > 0, "мусорная кука — тема по умолчанию").ЭтоИстина();
	// значение из куки не выходит за пределы значения свойства: закрывающих </style> на странице
	// ровно столько, сколько открывающих, а схема цветов — схема по умолчанию
	Ожидаем.Что(СтрЧислоВхождений(НРег(Испорченная), "</style>"), "из куки не вырвался тег")
		.Равно(СтрЧислоВхождений(НРег(Испорченная), "<style"));
	Ожидаем.Что(СтрНайти(Испорченная, UI.Токены.Переменные()) > 0,
		"КОНТРОЛЬ: мусорный акцент отброшен, схема по умолчанию на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбъявленнаяСтатикаСуществуетНаДиске() Экспорт

	Каталог = ОбъединитьПути(КаталогПроекта, "src", UI.Поставка.ИмяКаталога());

	Стили = Новый Файл(ОбъединитьПути(Каталог, UI.Поставка.ФайлСтилей()));
	Скрипт = Новый Файл(ОбъединитьПути(Каталог, UI.Поставка.ФайлСкрипта()));

	Ожидаем.Что(Стили.Существует(), "объявленный CSS есть на диске").ЭтоИстина();
	Ожидаем.Что(Скрипт.Существует(), "объявленный JS есть на диске").ЭтоИстина();

	Ожидаем.Что(Скрипт.Размер() < 32768, "скрипт укладывается в бюджет 32 КБ").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтпечатокСтатикиСчитаетсяИзСодержимогоФайла() Экспорт

	Каталог = ОбъединитьПути(КаталогПроекта, "src", UI.Поставка.ИмяКаталога());

	СтилиНаДиске = Sha256Файла(ОбъединитьПути(Каталог, UI.Поставка.ФайлСтилей()));
	СкриптНаДиске = Sha256Файла(ОбъединитьПути(Каталог, UI.Поставка.ФайлСкрипта()));

	Ожидаем.Что(UI.Активы.Отпечаток(UI.Поставка.ФайлСтилей()), "отпечаток стилей — SHA-256 файла стилей")
		.Равно(СтилиНаДиске);
	Ожидаем.Что(UI.Активы.Отпечаток(UI.Поставка.ФайлСкрипта()), "отпечаток скрипта — SHA-256 файла скрипта")
		.Равно(СкриптНаДиске);
	Ожидаем.Что(СтилиНаДиске = СкриптНаДиске, "два файла — два разных отпечатка").ЭтоЛожь();

	Ожидаем.Что(UI.Активы.Отпечаток("такого-файла-нет.css"), "нет файла — нет отпечатка").Равно("");
	Ожидаем.Что(UI.Активы.ПубличноеИмя("такого-файла-нет.css")).Равно("такого-файла-нет.css");

КонецПроцедуры

&Тест
Процедура КукуОформленияПишетТолькоСервер() Экспорт

	Скрипт = Исходники.Текст(ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", UI.Поставка.ИмяКаталога()), UI.Поставка.ФайлСкрипта()));

	Ожидаем.Что(СтрНайти(Скрипт, UI.Оформление.ИмяCookie()),
		"скрипт не читает и не пишет куку оформления: " + UI.Оформление.ИмяCookie()).Равно(0);
	Ожидаем.Что(СтрНайти(Скрипт, "document.cookie ="),
		"скрипт не пишет куки").Равно(0);
	Ожидаем.Что(СтрНайти(Скрипт, "document.cookie."),
		"и не разбирает их").Равно(0);
	Ожидаем.Что(СтрНайти(Скрипт, "document.cookie ?"),
		"и не читает вовсе").Равно(0);

	Ожидаем.Что(СтрНайти(
		Исходники.Текст(Корпус.ФайлКласса("ВыборОформления")),
		"Процедура ЗаписатьКуку") > 0, "единственный писатель — сервер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаркасОсмысленБезJS() Экспорт

	HTML = UI.Каркас.Страница("Каталог", UI.Кит.Карточка("Пакеты", "список пакетов"),
		UI.Каркас.КонтекстСтраницы(Новый Структура("Логин", "alice"), Неопределено));

	БезСкриптов = БезТегаScript(HTML);

