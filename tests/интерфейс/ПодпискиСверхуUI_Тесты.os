		"«Сохранить» вне формы отправляет именно её — без скрипта").Равно(Якорь);

	Ряд = РядДействий(HTML);
	Для Каждого Действие Из СтрРазделить("test,toggle,delete", ",") Цикл
		Ожидаем.Что(Ряд, "в ряду действий — " + Действие).Содержит("/hub/settings/webhooks/7/" + Действие);
	КонецЦикла;
