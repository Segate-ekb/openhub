КонецПроцедуры

// Перечни — подписанными строками, а не плашками одного веса с состоянием.
&Тест
Процедура СобытияИТегиПодписаннымиСтрокамиАСостояниеОтдельнымЗнаком() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Стенд.Каналы.ЗавестиТегПула(3, "develop");
	Подписка = Запись(Стенд, 9, "пул", "вебхук", "https://hook.example.com/c",
		"{""подписка"":{""теги"":[""stable"",""develop""]}}");
	Подписка.ТипыСобытий = "package.version.published,pool.storage.filled";
	Подписка.Активен = Ложь;
	Стенд.Сервис.ДобавитьПодписку(Подписка);

	Шапка = ПерваяШапка(ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("пул"))));

	Ожидаем.Что(Сведение(Шапка, "События"), "события — одной подписанной строкой")
		.Равно("Версия опубликована, Пул заполняется");
	Ожидаем.Что(Сведение(Шапка, "Теги"), "теги — своей строкой").Равно("stable, develop");
	Ожидаем.Что(ЗнакиУНазвания(Шапка), "плашкой — только состояние").Равно("выключена");
	Ожидаем.Что(СтрЧислоВхождений(Шапка, "class=""tag"), "других плашек в свёрнутой строке нет").Равно(1);

КонецПроцедуры

&Тест
Процедура ФормаПравкиРазделамиАДействияОднимРядом() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Сервис.ДобавитьПодписку(ПодпискаХаба(Стенд, "telegram", "-100777", "", "", ""));

	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("хаб")));
