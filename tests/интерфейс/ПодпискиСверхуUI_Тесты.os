// Разметка раздела «Подписки сверху» и свойств подписки: нижестоящий видит название, способ
// доставки, события и отбор без адреса и секретов; хозяин видит, кто сузил его подписку; отбор
// по тегам — галки из тегов пула или пакета, у хаба его нет. Карточка своей подписки и подписки
// сверху читается с первого взгляда: название первым, состояние знаком у него, сведения —
// подписанными строками; форма — разделами, действия — одним рядом.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем UI;              // фикстура СборкаUI — кит компонентов, словарь, резолвер текстов
Перем Разбор;          // РазборФормы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Собрать() Экспорт

	РеестрФикстур.Подключить("ГалкиВРазметке");
	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	КаталогПодписок = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");

	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(КаталогWebUI);

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЗаписьФормы");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "СписокЧерезЗапятую");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Для Каждого Имя Из СтрРазделить("РазборФормы,ИменаПолейПодписки,КаталогДействийПодписки,ПоляПодписки,"
		+ "РазборФормыПодписки,БланкРаздела,ПоляСобытийПодписки,ПоляСвойствПодписки,ПоправкиНижестоящих,"
		+ "ДеревоПолучателей,ВитринаПодписок,ВитринаПодписокСверху,СводкаПодписки,ПравилоДереваПолучателей,"
		+ "СчётСловами,ПроверкаПодпискиДоСохранения", ",") Цикл
		ПоискКлассов.Подключить(КаталогWebUI, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(КаталогПодписок, "РеестрДействийПодписок");
	ПоискКлассов.Подключить(КаталогПодписок, "ПараметрыПодписки");
	ПоискКлассов.Подключить(КаталогПодписок, "ШаблонУведомления");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогПодписок, "обработчики", "вебхук"), "РендерНастроекВебхука");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогПодписок, "обработчики", "telegram"), "РендерНастроекTelegram");

	Для Каждого Имя Из СтрРазделить("ПробныйТипДействия,ФейкСервисПодписок,ФейкКаталогСобытий,"
		+ "ФейкХранилищеВебхуков,ФейкВебхукЗапись,ФейкСервисПоправок,ФейкСервисПулов,"
		+ "ФейкПакетыПоИдентификатору,ФейкХранилищеПоправок,ФейкПоправкаЗапись,ФейкСервисИсключений", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЧтениеПолей");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "КанонСтроки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(КаталогПодписок, "ОтборПоТегам");
	ПоискКлассов.Подключить(КаталогWebUI, "ОтборТеговПодписки");
	РеестрФикстур.Подключить("ФейкКаналыПакетов");
	РеестрФикстур.Подключить("ФейкПредпросмотрУведомления");

	Разбор = Новый РазборФормы();

КонецПроцедуры

#Область ПодпискиСверху

&Тест
Процедура ПодпискаСверхуНеНесётАдресаИСекретов() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба(Стенд, "telegram", "-100777", "s3cr3t-value",
		"123456:AAhub-token", "шаблон-уведомления"));

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина)));

	Для Каждого Тайное Из СтрРазделить("-100777,s3cr3t-value,123456:AAhub-token,шаблон-уведомления", ",") Цикл
		Ожидаем.Что(СтрНайти(HTML, Тайное), СтрШаблон("«%1» в разметку не попадает", Тайное)).Равно(0);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(HTML, "релизы в общий чат") > 0, "название видно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Telegram") > 0, "способ доставки виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Версия опубликована") > 0, "события видны").ЭтоИстина();
	Ожидаем.Что(Сведение(HTML, "Теги"), "у подписки хаба отбора по тегам нет, сохранённый не виден")
		.Равно("");

КонецПроцедуры

// Пакету видна подписка пула с отбором по тегам пула: действующий отбор и тег, которого у пула
// больше нет.
&Тест
Процедура ОтборПодпискиПулаВиденПакету() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Стенд.Поправки.ДобавитьСверху(Запись(Стенд, 8, "пул", "вебхук", "https://hook.example.com/b",
		"{""подписка"":{""сужение"":true,""теги"":[""stable"",""lts""]}}"));

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина, "пакет", 42)));
	Ожидаем.Что(Сведение(HTML, "Теги"), "действующий отбор виден").Равно("stable");
	Ожидаем.Что(Сведение(HTML, "Тегов больше нет"), "удалённый у пула тег помечен").Равно("lts");

КонецПроцедуры

&Тест
Процедура БезНазванияПодпискаЗовётсяПоХозяину() Экспорт

	Стенд = НовыйСтенд();
	Хаба = Запись(Стенд, 7, "хаб", "вебхук", "https://hook.example.com/a", "");
	Пула = Запись(Стенд, 8, "пул", "вебхук", "https://hook.example.com/b", "");
	Стенд.Поправки.ДобавитьСверху(Хаба);
	Стенд.Поправки.ДобавитьСверху(Пула);

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина)));
	Ожидаем.Что(СтрНайти(HTML, "Подписка хаба") > 0, "подписка хаба без названия").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Подписка пула main") > 0, "подписка пула без названия").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФормаПоправкиПредлагаетТолькоСобытияПодписки() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Стенд.Каналы.ЗавестиТегПула(3, "prerelease");
	Стенд.Поправки.ДобавитьСверху(Запись(Стенд, 7, "хаб", "вебхук", "https://hook.example.com/a", ""));

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина)));
	Ожидаем.Что(СтрНайти(HTML, "/pools/main/settings/webhooks/inherited/7/narrow") > 0,
		"форма поправки постит на адрес подписки сверху").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""событие_0""") > 0, "событие подписки — флажком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""событие_1"""), "события, которого у подписки нет, нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "name=""не_присылать""") > 0, "«не присылать» есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тега_stable""") > 0, "галка тега пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тега_prerelease""") > 0, "у каждого тега своя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тегов"""), "строки ввода тегов нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "/delete"), "удалить чужую подписку нечем").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "/toggle"), "выключить — тоже").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "/test"), "и проверить доставку").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "/reset"), "снимать поправку, которой нет, нечем").Равно(0);

КонецПроцедуры

&Тест
Процедура ПоставленнаяПоправкаВидныИСнимается() Экспорт

	Стенд = НовыйСтенд();
	Поправка = Новый ФейкПоправкаЗапись(Новый ФейкХранилищеПоправок());
	Поправка.НеПрисылать = Истина;
	Стенд.Поправки.ДобавитьСверху(Запись(Стенд, 7, "хаб", "вебхук", "https://hook.example.com/a", ""), Поправка);

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина)));
	Ожидаем.Что(СтрНайти(HTML, "не присылается") > 0, "состояние поправки в шапке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "/pools/main/settings/webhooks/inherited/7/reset") > 0,
		"поправку можно снять").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезПраваФормыПоправкиНет() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(Запись(Стенд, 7, "хаб", "вебхук", "https://hook.example.com/a", ""));

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Ложь)));
	Ожидаем.Что(СтрНайти(HTML, "/narrow"), "формы поправки нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Сужать подписки сверху вправе") > 0, "вместо неё — объяснение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезПодписокСверхуРазделаНет() Экспорт

	Стенд = НовыйСтенд();
	Ожидаем.Что(Стенд.Сверху.Секции(ПараметрыСверху(Истина)).Количество(), "секции нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ФормаПодписки

&Тест
Процедура ФормаПодпискиПулаНесётНазваниеОтборИФлажокСужения() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("пул")));

	Ожидаем.Что(СтрНайти(HTML, "name=""название""") > 0, "поле названия").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тега_stable""") > 0, "галка тега пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тегов"""), "строки ввода тегов нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "name=""сужение_снизу""") > 0, "флажок сужения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "только что опубликованная версия") > 0,
		"подсказка: у новой версии ручного состава нет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УПодпискиПакетаФлажкаСуженияНет() Экспорт

	Стенд = НовыйСтенд();
	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("пакет")));
	Ожидаем.Что(СтрНайти(HTML, "name=""сужение_снизу"""), "ниже пакета никого").Равно(0);

КонецПроцедуры

// У пакета галки — его теги вместе с унаследованными: так их отдаёт реестр.
&Тест
Процедура ФормаПодпискиПакетаПредлагаетЕгоТеги() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиРучной(3, "lts", "1.0.0");
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("пакет")));
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тега_lts""") > 0, "тег пакета — галкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тега_stable"""),
		"галки пакета — из тегов пакета, а не из перечня пула").Равно(0);

КонецПроцедуры

&Тест
Процедура УПодпискиХабаГалокТеговНет() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("хаб")));
	Ожидаем.Что(СтрНайти(HTML, "отбор_тега_"), "галок тегов у хаба нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Только версии под тегами"), "и самого отбора").Равно(0);

КонецПроцедуры

&Тест
Процедура ПулБезТеговГоворитОткудаОниБерутся() Экспорт

	Стенд = НовыйСтенд();
	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("пул")));
	Ожидаем.Что(СтрНайти(HTML, "У пула нет тегов для отбора") > 0, "откуда берутся теги").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "отбор_тега_"), "галок нет").Равно(0);

КонецПроцедуры

// Тег, выбранный в отборе, удалили из пула: галки у него больше нет, карточка и форма правки
// предупреждают, что отбор по нему снят.
&Тест
Процедура ВыпавшийТегПомеченВКарточкеИФормеПравки() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Подписка = Запись(Стенд, 9, "пул", "вебхук", "https://hook.example.com/c",
		"{""подписка"":{""теги"":[""stable"",""lts""]}}");
	Стенд.Сервис.ДобавитьПодписку(Подписка);

	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("пул")));
	Ожидаем.Что(Сведение(HTML, "Теги"), "действующий отбор в карточке").Равно("stable");
	Ожидаем.Что(Сведение(HTML, "Тегов больше нет"), "выпавший тег помечен в карточке").Равно("lts");
	Ожидаем.Что(СтрНайти(HTML, "Тегов lts больше нет") > 0, "форма правки предупреждает").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""отбор_тега_lts"""), "галки удалённого тега нет").Равно(0);
	Ожидаем.Что(Отмечен(HTML, "отбор_тега_stable"), "живой тег отмечен в форме правки").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ХозяинВидитКтоСузилПодписку() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Сервис.ДобавитьПодписку(Запись(Стенд, 7, "хаб", "вебхук", "https://hook.example.com/a", ""));
	Стенд.Пулы.ДобавитьПул(3, "main");
	Стенд.Пакеты.ДобавитьПакет(42, "oint");
	Стенд.Каналы.ЗавестиРучной(42, "stable", "1.0.0");
	Стенд.Поправки.ДобавитьСузившую(ПоправкаОбъекта("пул", 3, 3, Истина, "", ""));
	Стенд.Поправки.ДобавитьСузившую(ПоправкаОбъекта("пакет", 42, 3, Ложь, "", "stable"));

	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("хаб")));
	Ожидаем.Что(СтрНайти(HTML, "пул main") > 0, "пул назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "не присылать") > 0, "и что он сделал").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "пакет main/oint") > 0, "пакет назван с пулом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "только теги: stable") > 0, "и его отбор").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "поправки хранятся, но не действуют") > 0,
		"флажок снят — поправки спят, и хозяин об этом знает").ЭтоИстина();
	Ожидаем.Что(ЗнакиУНазвания(ПерваяШапка(HTML)), "и видит это знаком у названия, не раскрывая карточку")
		.Равно("поправки снизу не действуют");
	Ожидаем.Что(Сведение(ПерваяШапка(HTML), "Снизу"), "сколько сузили — строкой").Равно("сузили для себя 2 объекта");

КонецПроцедуры

#КонецОбласти

#Область ПолучателиВПуле

// Пул сужает подписку хаба своими пакетами: свёрнутым блок говорит, без скольких пакетов
// подписка, и ведёт к дереву; у пакета такого блока нет.
&Тест
Процедура УПулаЕстьПолучателиВПулеАУПакетаНет() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба(Стенд, "вебхук", "https://hook.example.com/a", "", "", ""));
	Стенд.Поправки.ЗавестиДеревоПоправки(ДеревоПакетовПула());

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина)));
	Ожидаем.Что(СтрНайти(HTML, "Получатели в пуле") > 0, "у пула блок есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "обо всех пакетах пула, кроме 2 пакетов: 1 сняли вы, 1 — хозяин подписки") > 0,
		"свёрнутым — итог с разбивкой: снятые пулом и хозяином подписки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "recipients=7") > 0, "и ссылка на дерево").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "получатель_пакет_"), "свёрнутым галок нет").Равно(0);

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина, "пакет", 42)));
	Ожидаем.Что(СтрНайти(HTML, "Получатели в пуле"), "у пакета блока нет").Равно(0);

КонецПроцедуры

// Открытое дерево — один уровень пакетов пула без галки пула; пакет, снятый хозяином подписки,
// снят закрытой галкой с пометкой; форма постит на адрес подписки сверху.
&Тест
Процедура ОткрытоеДеревоПоправкиЗакрываетПакетСнятыйХозяиномПодписки() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба(Стенд, "вебхук", "https://hook.example.com/a", "", "", ""));
	Стенд.Поправки.ЗавестиДеревоПоправки(ДеревоПакетовПула());
	Параметры = ПараметрыСверху(Истина);
	Параметры.ДеревоИд = "7";

	HTML = ТелоСекций(Стенд.Сверху.Секции(Параметры));
	Ожидаем.Что(ТегФормы(HTML, "/pools/main/settings/webhooks/inherited/7/recipients"), "форма галок поправки")
		.Содержит("method=""post""");
	Закрытая = ТегГалки(HTML, "получатель_пакет_50");
	Ожидаем.Что(Закрытая, "снятый хозяином подписки — закрыт").Содержит(" disabled");
	Ожидаем.Что(Закрытая, "и снят").Содержит("data-checktree-state=""off""");
	Ожидаем.Что(СтрНайти(HTML, "снят хозяином подписки") > 0, "с пометкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТегГалки(HTML, "получатель_пакет_43"), " disabled"), "снятый пулом открыт").Равно(0);
	Ожидаем.Что(ТегГалки(HTML, "получатель_пакет_43"), "и снят").Содержит("data-checktree-state=""off""");
	Ожидаем.Что(ТегГалки(HTML, "получатель_пакет_42"), "остальные включены").Содержит(" checked");
	Ожидаем.Что(СтрНайти(HTML, "получатель_пул_"), "своей галки у пула нет").Равно(0);

КонецПроцедуры

// Поправка пула с одними исключениями пакетов не пустая: у пула — «Здесь», у хозяина — «исключено».
&Тест
Процедура ИсключённыеПуломПакетыВидныВСводкахПоправки() Экспорт

	Стенд = НовыйСтенд();
	Поправка = ПоправкаОбъекта("пул", 3, 3, Ложь, "", "");
	Стенд.Поправки.ИсключитьПакеты(Поправка, 2);
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба(Стенд, "вебхук", "https://hook.example.com/a", "", "", ""), Поправка);

	HTML = ТелоСекций(Стенд.Сверху.Секции(ПараметрыСверху(Истина)));
	Ожидаем.Что(Сведение(ПерваяШапка(HTML), "Здесь"), "у пула — что он сделал сам").Равно("сняли 2 пакета");
	Ожидаем.Что(ЗнакиУНазвания(ПерваяШапка(HTML)), "и поправка видна сужением").Равно("сужена");

	Стенд.Сервис.ДобавитьПодписку(Запись(Стенд, 7, "хаб", "вебхук", "https://hook.example.com/a", ""));
	Стенд.Пулы.ДобавитьПул(3, "main");
	Стенд.Поправки.ДобавитьСузившую(Поправка);
	HTML = ТелоСекций(Стенд.Своя.Секции(ПараметрыСвоих("хаб")));
	Ожидаем.Что(СтрНайти(HTML, "исключено: 2 пакета") > 0, "хозяин видит, сколько пакетов исключил пул")
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

