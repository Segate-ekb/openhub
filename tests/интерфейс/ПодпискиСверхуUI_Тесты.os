// Разметка раздела «Подписки сверху» и свойств подписки: нижестоящий видит название, способ
// доставки, события и отбор без адреса и секретов; хозяин видит, кто сузил его подписку; отбор
// по тегам — галки из тегов пула или пакета, у хаба его нет. Запись своей подписки и подписки
// сверху читается с первого взгляда: значок и имя первыми, состояние плашкой у него, подробности —
// свойствами; окно — шагами, действия — меню ⚙ записи.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем UI;              // фикстура СборкаUI — кит компонентов, словарь, резолвер текстов
Перем Разбор;          // РазборФормы

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Собрать() Экспорт

	РеестрФикстур.Подключить("ГалкиВРазметке");
	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	КаталогПодписок = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");

	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(КаталогWebUI);

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЗаписьФормы");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "СписокЧерезЗапятую");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Для Каждого Имя Из СтрРазделить("РазборФормы,ИменаПолейПодписки,КаталогДействийПодписки,ПоляПодписки,"
		+ "РазборФормыПодписки,ПоляСобытийПодписки,ПоляСвойствПодписки,ПоправкиНижестоящих,СрезПодписок,"
		+ "ПолучателиЗаписи,ВитринаПодписок,ВитринаПодписокСверху,ПравилоДереваПолучателей,ОкноПолучателей,"
		+ "СчётСловами,ПроверкаПодпискиДоСохранения,ОкноРаздела,ОтметкаСохранения,ИменаПодписок,ЗаписьПодписки,"
		+ "ОкноПодписки", ",") Цикл
		ПоискКлассов.Подключить(КаталогWebUI, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(КаталогПодписок, "РеестрДействийПодписок");
	ПоискКлассов.Подключить(КаталогПодписок, "ПараметрыПодписки");
	ПоискКлассов.Подключить(КаталогПодписок, "ШаблонУведомления");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогПодписок, "обработчики", "вебхук"), "РендерНастроекВебхука");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогПодписок, "обработчики", "telegram"), "РендерНастроекTelegram");

	Для Каждого Имя Из СтрРазделить("ПробныйТипДействия,ФейкСервисПодписок,ФейкКаталогСобытий,"
		+ "ФейкХранилищеВебхуков,ФейкВебхукЗапись,ФейкСервисПоправок,ФейкСервисПулов,"
		+ "ФейкПакетыПоИдентификатору,ФейкХранилищеПоправок,ФейкПоправкаЗапись,ФейкСервисИсключений", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЧтениеПолей");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "КанонСтроки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(КаталогПодписок, "ОтборПоТегам");
	ПоискКлассов.Подключить(КаталогWebUI, "ОтборТеговПодписки");
	РеестрФикстур.Подключить("ФейкКаналыПакетов");
	РеестрФикстур.Подключить("ФейкПредпросмотрУведомления");
	РеестрФикстур.Подключить("СтендВитриныПодписок");

	Разбор = Новый РазборФормы();

КонецПроцедуры

#Область ПодпискиСверху

&Тест
Процедура ПодпискаСверхуНеНесётАдресаИСекретов() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба("telegram", "-100777", "s3cr3t-value",
		"123456:AAhub-token", "шаблон-уведомления"));

	HTML = Стенд.РазделСверху(Стенд.Параметры());

	Для Каждого Тайное Из СтрРазделить("-100777,s3cr3t-value,123456:AAhub-token,шаблон-уведомления", ",") Цикл
		Ожидаем.Что(СтрНайти(HTML, Тайное), СтрШаблон("«%1» в разметку не попадает", Тайное)).Равно(0);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(HTML, "релизы в общий чат") > 0, "название видно").ЭтоИстина();
	Ожидаем.Что(Свойство(HTML, "способ доставки"), "способ доставки виден").Равно("Telegram");
	Ожидаем.Что(СтрНайти(HTML, "Версия опубликована") > 0, "события видны").ЭтоИстина();
	Ожидаем.Что(Свойство(HTML, "теги"), "у подписки хаба отбора по тегам нет, сохранённый не виден").Равно("");

КонецПроцедуры

// Пакету видна подписка пула с отбором по тегам пула: действующий отбор и тег, которого у пула
// больше нет.
&Тест
Процедура ОтборПодпискиПулаВиденПакету() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Стенд.Поправки.ДобавитьСверху(Запись(8, "пул", "вебхук", "https://hook.example.com/b",
		"{""подписка"":{""сужение"":true,""теги"":[""stable"",""lts""]}}"));

	HTML = Стенд.РазделСверху(Стенд.Параметры("пакет", , 42));
	Ожидаем.Что(Свойство(HTML, "теги"), "действующий отбор виден").Равно("stable");
	Ожидаем.Что(HTML, "удалённый у пула тег помечен").Содержит("тегов lts больше нет");

КонецПроцедуры

&Тест
Процедура БезНазванияПодпискаЗовётсяПоХозяину() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(Запись(7, "хаб", "вебхук", "https://hook.example.com/a", ""));
	Стенд.Поправки.ДобавитьСверху(Запись(8, "пул", "вебхук", "https://hook.example.com/b", ""));

	HTML = Стенд.РазделСверху(Стенд.Параметры());
	Ожидаем.Что(ЗаписьРеестра(HTML, "Подписка хаба"), "подписка хаба без названия").Заполнено();
	Ожидаем.Что(ЗаписьРеестра(HTML, "Подписка пула main"), "подписка пула без названия").Заполнено();

КонецПроцедуры

// Окно «Сузить» по адресу предлагает только события подписки и галки тегов своего объекта; меню
// записи сверху — без удаления, тумблера и пробы чужой подписки.
&Тест
Процедура ОкноСуженияПредлагаетТолькоСобытияПодписки() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Стенд.Каналы.ЗавестиТегПула(3, "prerelease");
	Стенд.Поправки.ДобавитьСверху(Запись(7, "хаб", "вебхук", "https://hook.example.com/a", ""));

	Список = Стенд.РазделСверху(Стенд.Параметры());
	Окно = ОткрытыеОкна(Стенд.РазделСверху(Стенд.Параметры("пул", Стенд.Окна.Открытое("сузить", "7"))));

	Ожидаем.Что(Окно.Количество(), "окно сужения открыто по адресу").Равно(1);
	Ожидаем.Что(Окно[0], "форма поправки постит на адрес подписки сверху")
		.Содержит("action=""/pools/main/settings/webhooks/inherited/7/narrow""");
	Ожидаем.Что(Окно[0], "событие подписки — флажком").Содержит("name=""событие_0""");
	Ожидаем.Что(СтрНайти(Окно[0], "name=""событие_1"""), "события, которого у подписки нет, нет").Равно(0);
	Ожидаем.Что(Окно[0], "галка тега пула").Содержит("name=""отбор_тега_stable""");
	Ожидаем.Что(Окно[0], "у каждого тега своя").Содержит("name=""отбор_тега_prerelease""");
	Ожидаем.Что(Список, "меню записи — окно сужения по адресу")
		.Содержит(АдресОкна("/pools/main/settings/webhooks", "сузить-7"));
	Ожидаем.Что(Список, "и «Не присылать сюда» формой с желаемым состоянием").Содержит("name=""не_присылать""");
	Ожидаем.Что(СтрНайти(Список, "/delete"), "удалить чужую подписку нечем").Равно(0);
	Ожидаем.Что(СтрНайти(Список, "/toggle"), "выключить — тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Список, "/test"), "и проверить доставку").Равно(0);
	Ожидаем.Что(СтрНайти(Список, "/reset"), "снимать поправку, которой нет, нечем").Равно(0);

КонецПроцедуры

// Поставленная поправка видна плашкой, снимается из меню; заглушённую подписку меню предлагает
// присылать снова, а события и теги поправки едут с этой формой скрытыми полями.
&Тест
Процедура ПоставленнаяПоправкаВиднаИСнимается() Экспорт

	Стенд = НовыйСтенд();
	Поправка = ПоправкаОбъекта("пул", 3, 3, Истина, "", "stable");
	Стенд.Поправки.ДобавитьСверху(Запись(7, "хаб", "вебхук", "https://hook.example.com/a", ""), Поправка);

	HTML = Стенд.РазделСверху(Стенд.Параметры());
	Ожидаем.Что(ПлашкиЗаписи(HTML), "состояние поправки — плашкой у имени").Содержит("не присылается");
	Ожидаем.Что(HTML, "поправку можно снять").Содержит("/pools/main/settings/webhooks/inherited/7/reset");
	Ожидаем.Что(HTML, "заглушённую — присылать снова").Содержит("Присылать сюда");
	Ожидаем.Что(HTML, "отбор поправки едет с формой").Содержит("name=""отбор_тега_stable"" value=""1""");

КонецПроцедуры

&Тест
Процедура БезПраваМенюПоправкиНет() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(Запись(7, "хаб", "вебхук", "https://hook.example.com/a", ""));
	Параметры = Стенд.Параметры();
	Параметры.МожноМенять = Ложь;

	HTML = Стенд.РазделСверху(Параметры);
	Ожидаем.Что(СтрНайти(HTML, "/narrow"), "формы поправки нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "окно="), "окна сужения тоже").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Сужать подписки сверху вправе") > 0, "вместо неё — объяснение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезПодписокСверхуРазделаНет() Экспорт

	Стенд = НовыйСтенд();
	Ожидаем.Что(Стенд.Сверху.Секции(Стенд.Параметры()).Количество(), "секции нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОкноПодписки

&Тест
Процедура ОкноПодпискиПулаНесётНазваниеОтборИФлажокСужения() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Окно = ОкноНовой(Стенд.Раздел(Стенд.Параметры("пул")));

	Ожидаем.Что(Окно, "поле названия").Содержит("name=""название""");
	Ожидаем.Что(Окно, "галка тега пула").Содержит("name=""отбор_тега_stable""");
	Ожидаем.Что(СтрНайти(Окно, "name=""отбор_тегов"""), "строки ввода тегов нет").Равно(0);
	Ожидаем.Что(Окно, "флажок сужения").Содержит("name=""сужение_снизу""");
	Ожидаем.Что(Окно, "справка: у новой версии ручного состава нет").Содержит("только что опубликованная версия");

КонецПроцедуры

&Тест
Процедура УПодпискиПакетаФлажкаСуженияНет() Экспорт

	Стенд = НовыйСтенд();
	Ожидаем.Что(СтрНайти(ОкноНовой(Стенд.Раздел(Стенд.Параметры("пакет"))), "name=""сужение_снизу"""),
		"ниже пакета никого").Равно(0);

КонецПроцедуры

// У пакета галки — его теги вместе с унаследованными: так их отдаёт реестр.
&Тест
Процедура ОкноПодпискиПакетаПредлагаетЕгоТеги() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиРучной(3, "lts", "1.0.0");
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Окно = ОкноНовой(Стенд.Раздел(Стенд.Параметры("пакет")));
	Ожидаем.Что(Окно, "тег пакета — галкой").Содержит("name=""отбор_тега_lts""");
	Ожидаем.Что(СтрНайти(Окно, "name=""отбор_тега_stable"""),
		"галки пакета — из тегов пакета, а не из перечня пула").Равно(0);

КонецПроцедуры

&Тест
Процедура УПодпискиХабаГалокТеговНет() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Окно = ОкноНовой(Стенд.Раздел(Стенд.Параметры("хаб")));
	Ожидаем.Что(СтрНайти(Окно, "отбор_тега_"), "галок тегов у хаба нет").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, "Только версии под тегами"), "и самого отбора").Равно(0);

КонецПроцедуры

// Тегов нет — одна строка со ссылкой туда, где их заводят, а не абзац.
&Тест
Процедура ПулБезТеговОднаСтрокаСоСсылкой() Экспорт

	Стенд = НовыйСтенд();
	Окно = ОкноНовой(Стенд.Раздел(Стенд.Параметры("пул")));
	Ожидаем.Что(Окно, "откуда берутся теги").Содержит("У пула нет тегов для отбора");
	Ожидаем.Что(Окно, "и ссылка в раздел «Теги»").Содержит("href=""/pools/main/settings/tags""");
	Ожидаем.Что(СтрНайти(Окно, "отбор_тега_"), "галок нет").Равно(0);

КонецПроцедуры

// Тег, выбранный в отборе, удалили из пула: галки у него больше нет, запись и окно правки
// предупреждают, что отбор по нему снят.
&Тест
Процедура ВыпавшийТегПомеченВЗаписиИОкнеПравки() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Стенд.Сервис.ДобавитьПодписку(Запись(9, "пул", "вебхук", "https://hook.example.com/c",
		"{""подписка"":{""теги"":[""stable"",""lts""]}}"));

	HTML = Стенд.Раздел(Стенд.Параметры("пул"));
	Ожидаем.Что(Свойство(HTML, "теги"), "действующий отбор в записи").Равно("stable");
	Ожидаем.Что(HTML, "выпавший тег помечен в записи").Содержит("тегов lts больше нет");

	Окно = ОткрытыеОкна(Стенд.Раздел(Стенд.Параметры("пул", Стенд.Окна.Открытое("изменить", "9"))))[0];
	Ожидаем.Что(Окно, "окно правки предупреждает").Содержит("Тегов lts больше нет");
	Ожидаем.Что(СтрНайти(Окно, "name=""отбор_тега_lts"""), "галки удалённого тега нет").Равно(0);
	Ожидаем.Что(Отмечен(Окно, "отбор_тега_stable"), "живой тег отмечен в окне правки").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ХозяинВидитКтоСузилПодписку() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Сервис.ДобавитьПодписку(Запись(7, "хаб", "вебхук", "https://hook.example.com/a", ""));
	Стенд.Пулы.ДобавитьПул(3, "main");
	Стенд.Пакеты.ДобавитьПакет(42, "oint");
	Стенд.Каналы.ЗавестиРучной(42, "stable", "1.0.0");
	Стенд.Поправки.ДобавитьСузившую(ПоправкаОбъекта("пул", 3, 3, Истина, "", ""));
	Стенд.Поправки.ДобавитьСузившую(ПоправкаОбъекта("пакет", 42, 3, Ложь, "", "stable"));

	Запись_ = ЗаписьРеестра(Стенд.Раздел(Стенд.Параметры("хаб")), "https://hook.example.com/a");
	Ожидаем.Что(Запись_, "пул назван").Содержит("пул main");
	Ожидаем.Что(Запись_, "и что он сделал").Содержит("не присылать");
	Ожидаем.Что(Запись_, "пакет назван с пулом").Содержит("пакет main/oint");
	Ожидаем.Что(Запись_, "и его отбор").Содержит("только теги: stable");
	Ожидаем.Что(Запись_, "флажок снят — поправки спят, и хозяин об этом знает")
		.Содержит("поправки хранятся, но не действуют");
	Ожидаем.Что(ПлашкиЗаписи(Запись_), "и видит это плашкой у имени, не раскрывая запись")
		.Равно("поправки снизу не действуют");
	Ожидаем.Что(Свойство(Запись_, "нижестоящие"), "сколько сузили").Равно("сузили для себя 2 объекта");

КонецПроцедуры

#КонецОбласти

#Область ПолучателиВПуле

// Пул сужает подписку хаба своими пакетами окном «Пакеты пула» из меню ⚙ записи; у пакета
// такого пункта нет.
&Тест
Процедура УПулаЕстьОкноПакетовПулаАУПакетаНет() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба("вебхук", "https://hook.example.com/a", "", "", ""));
	Стенд.Поправки.ЗавестиДеревоПоправки(ДеревоПакетовПула());

	HTML = Стенд.РазделСверху(Стенд.Параметры());
	Ожидаем.Что(HTML, "у пула пункт «Пакеты пула» — окно по адресу").Содержит(АдресОкна("/pools/main/settings/webhooks", "пакеты-7"));
	Ожидаем.Что(СтрНайти(HTML, "<dialog"), "окна на странице нет — оно приходит по адресу").Равно(0);

	HTML = Стенд.РазделСверху(Стенд.Параметры("пакет", , 42));
	Ожидаем.Что(СтрНайти(HTML, АдресОкна("/pools/main/settings/webhooks", "пакеты-7")), "у пакета пункта нет").Равно(0);

КонецПроцедуры

// Окно «Пакеты пула» по адресу: итог с разбивкой, пакеты галками, пакет, снятый хозяином подписки,
// снят закрытой галкой с пометкой, снятый пулом — открытой снятой галкой (на странице, поэтому не
// в ряду отмеченного); форма уходит тихо на дверь подписки сверху и без скрипта отдаёт правки против
// поля показанного кита, где закрытой галки нет.
&Тест
Процедура ОкноПакетовПулаЗакрываетПакетСнятыйХозяиномПодписки() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба("вебхук", "https://hook.example.com/a", "", "", ""));
	Стенд.Поправки.ЗавестиДеревоПоправки(ДеревоПакетовПула());
	Параметры = Стенд.Параметры(, Стенд.Окна.Открытое("пакеты", "7"));

	Окно = Между(Стенд.РазделСверху(Параметры), "<dialog", "</dialog>");
	Ожидаем.Что(Окно, "окно открыто").Содержит(" open");
	Ожидаем.Что(ТегФормы(Окно, "/pools/main/settings/webhooks/inherited/7/recipients"), "форма — дверь поправки")
		.Содержит("data-quiet");
	Ожидаем.Что(Окно, "итог с разбивкой: снятые пулом и хозяином подписки")
		.Содержит("обо всех пакетах пула, кроме 2 пакетов: 1 сняли вы, 1 — хозяин подписки");
	Закрытая = ТегГалки(Окно, "пакет_50");
	Ожидаем.Что(Закрытая, "снятый хозяином подписки — закрыт").Содержит(" disabled");
	Ожидаем.Что(Закрытая, "и снят").Содержит("data-checktree-state=""off""");
	Ожидаем.Что(Окно, "с пометкой").Содержит("снят хозяином подписки");
	Ожидаем.Что(СтрНайти(ТегГалки(Окно, "пакет_43"), " disabled"), "снятый пулом открыт").Равно(0);
	Ожидаем.Что(ТегГалки(Окно, "пакет_43"), "и снят").Содержит("data-checktree-state=""off""");
	Ожидаем.Что(ТегГалки(Окно, "пакет_42"), "остальные включены").Содержит(" checked");
	Ожидаем.Что(СтрНайти(Окно, "data-checktree-picked"), "всё на странице — ряда отмеченного нет").Равно(0);
	Ожидаем.Что(Новый ГалкиВРазметке().Ключи(Окно, "пул_").Количество(), "своей ветки у пула нет").Равно(0);
	Показано = Между(Окно, "name=""показано"" value=""", ">");
	Ожидаем.Что(Показано, "без скрипта форма знает, что показала: снятый пулом").Содержит("-пакет_43");
	Ожидаем.Что(Показано, "и включённый").Содержит("+пакет_42");
	Ожидаем.Что(СтрНайти(Показано, "пакет_50"), "закрытой галки в показанном нет").Равно(0);
	Ожидаем.Что(Между(Окно, "<a href=""/pools/main/settings/webhooks""", "</a>"), "без скрипта закрывает ссылка на раздел")
		.Заполнено();
	Ожидаем.Что(Окно, "«Отмена» словом кита АдресЗакрытия").Содержит(">Отмена<");

КонецПроцедуры

// Поправка пула с одними исключениями пакетов не пустая: у пула — «здесь», у хозяина — «исключено».
&Тест
Процедура ИсключённыеПуломПакетыВидныВЗаписяхПоправки() Экспорт

	Стенд = НовыйСтенд();
	Поправка = ПоправкаОбъекта("пул", 3, 3, Ложь, "", "");
	Стенд.Поправки.ИсключитьПакеты(Поправка, 2);
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба("вебхук", "https://hook.example.com/a", "", "", ""), Поправка);

	HTML = Стенд.РазделСверху(Стенд.Параметры());
	Ожидаем.Что(Свойство(HTML, "Здесь"), "у пула — что он сделал сам").Равно("сняли 2 пакета");
	Ожидаем.Что(ПлашкиЗаписи(HTML), "и поправка видна сужением").Содержит("сужена");

	Стенд.Сервис.ДобавитьПодписку(Запись(7, "хаб", "вебхук", "https://hook.example.com/a", ""));
	Стенд.Пулы.ДобавитьПул(3, "main");
	Стенд.Поправки.ДобавитьСузившую(Поправка);
	HTML = Стенд.Раздел(Стенд.Параметры("хаб"));
	Ожидаем.Что(HTML, "хозяин видит, сколько пакетов исключил пул").Содержит("исключено: 2 пакета");

КонецПроцедуры

#КонецОбласти

#Область ЗаписьСПервогоВзгляда

&Тест
Процедура ЗаписьСвоейПодпискиНачинаетсяСИмениАСпособДоставкиПодписью() Экспорт

	Стенд = НовыйСтенд();
	Подписка = ПодпискаХаба("telegram", "-100777", "", "", "");
	Подписка.Активен = Ложь;
	Стенд.Сервис.ДобавитьПодписку(Подписка);

