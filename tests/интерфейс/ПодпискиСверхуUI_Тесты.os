#КонецОбласти

#Область Служебное

Функция НовыйСтенд()

	События = Новый ФейкКаталогСобытий();
	Сервис = Новый ФейкСервисПодписок();
	Типы = Новый Массив();
	Типы.Добавить("package.version.published");
	Типы.Добавить("pool.storage.filled");
	Сервис.УстановитьТипыСобытий(Типы);

	Имена = Новый ИменаПолейПодписки(Новый ЗащитаCSRF(Неопределено));
	Каталог = Новый КаталогДействийПодписки(Реестр(), UI.Тексты, Имена);
	Сохранённые = Новый ПараметрыПодписки(События);
	ПоляСобытий = Новый ПоляСобытийПодписки(UI.Кит, Сервис, События, Сохранённые, Имена, Разбор, UI.Тексты);
	ПоляСвойств = Новый ПоляСвойствПодписки(UI.Кит, Сохранённые, Имена, Разбор, UI.Тексты);
	Каналы = Новый ФейкКаналыПакетов();
	Отбор = Новый ОтборПоТегам(Каналы, Каналы, Новый ИздательСобытий());
	ОтборТегов = Новый ОтборТеговПодписки(UI.Кит, Отбор, Имена, Разбор, UI.Тексты);
	Поправки = Новый ФейкСервисПоправок();
	Пулы = Новый ФейкСервисПулов();
	Пакеты = Новый ФейкПакетыПоИдентификатору();
	Сузившие = Новый ПоправкиНижестоящих(UI.Кит, Поправки, Сохранённые, Пулы, Пакеты, ПоляСобытий, Отбор,
		UI.Тексты, Новый СчётСловами(UI.Тексты));
	Бланки = Новый БланкРаздела(UI.Кит);

	Исключения = Новый ФейкСервисИсключений();
	Счёт = Новый СчётСловами(UI.Тексты);
	Получатели = Новый ДеревоПолучателей(UI.Кит, Исключения, Поправки, Имена, Бланки, UI.Тексты,
		Новый ПравилоДереваПолучателей(Разбор, Имена, Исключения), Счёт);
	Сводки = Новый СводкаПодписки(UI.Кит, UI.Тексты, Сервис, Сохранённые, Поправки, Каталог, ПоляСобытий, ОтборТегов,
		Получатели, Счёт);

	Своя = Новый ВитринаПодписок(UI.Кит, UI.РендерерНастроек, Сервис, ПоляСобытий, ПоляСвойств, ОтборТегов, Сузившие,
		Получатели, Сохранённые, Каталог, Новый ПоляПодписки(UI.Кит, UI.Тексты, Разбор, Имена, Каталог), Имена,
		Бланки, UI.Тексты, Разбор, Новый ПроверкаПодпискиДоСохранения(UI.Кит, UI.РендерерНастроек, UI.Тексты, Бланки,
			Имена, Каталог, Новый ФейкПредпросмотрУведомления(), Реестр()), Сводки, Новый ФейкПредпросмотрУведомления());
	Сверху = Новый ВитринаПодписокСверху(UI.Кит, UI.РендерерНастроек, Поправки, Сервис, Сводки, Получатели,
		ПоляСобытий, ОтборТегов, Имена, Бланки, Разбор, UI.Тексты);

	Стенд = Новый Структура();
	Стенд.Вставить("Сервис", Сервис);
	Стенд.Вставить("Поправки", Поправки);
	Стенд.Вставить("Пулы", Пулы);
	Стенд.Вставить("Пакеты", Пакеты);
	Стенд.Вставить("Каналы", Каналы);
	Стенд.Вставить("Своя", Своя);
	Стенд.Вставить("Сверху", Сверху);
	Возврат Стенд;

КонецФункции

Функция Реестр()

	Доставки = Новый Массив();
	Доставки.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-1"));
	Доставки.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-2"));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-3"));
	Хранения.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-4"));
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());
	Рендеры.Добавить(Новый РендерНастроекTelegram(Новый ШаблонУведомления(Неопределено)));
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры);

КонецФункции

Функция Запись(Знач Стенд, Знач Ид, Знач ТипОбъекта, Знач ТипДействия, Знач Адрес, Знач СвойстваJSON)

	Запись = Новый ФейкВебхукЗапись(Новый ФейкХранилищеВебхуков());
	Запись.Идентификатор = Ид;
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ОбъектИдентификатор = 3;
	Запись.ТипДействия = ТипДействия;
	Запись.URL = Адрес;
	Запись.ТипыСобытий = "package.version.published";
	Запись.ПараметрыСобытийJSON = СвойстваJSON;
	Запись.Активен = Истина;
	Возврат Запись;

КонецФункции

Функция ПодпискаХаба(Знач Стенд, Знач ТипДействия, Знач Адрес, Знач Секрет, Знач Токен, Знач Шаблон)

	Подписка = Запись(Стенд, 7, "хаб", ТипДействия, Адрес,
		"{""подписка"":{""название"":""релизы в общий чат"",""сужение"":true,""теги"":[""stable""]}}");
	Подписка.Секрет = Секрет;
	Подписка.ТокенДействия = Токен;
	Подписка.ШаблонТекста = Шаблон;
	Подписка.НастройкиДействия = "{""тема"":""777""}";
	Возврат Подписка;

КонецФункции

Функция ПоправкаОбъекта(Знач ТипОбъекта, Знач Ид, Знач ПулИд, Знач НеПрисылать, Знач Снятые, Знач Теги)

	Поправка = Новый ФейкПоправкаЗапись(Новый ФейкХранилищеПоправок());
	Поправка.ТипОбъекта = ТипОбъекта;
	Поправка.ОбъектИдентификатор = Ид;
	Поправка.ПулИдентификатор = ПулИд;
	Поправка.НеПрисылать = НеПрисылать;
	Поправка.СнятыеСобытия = Снятые;
	Поправка.ОтборТегов = Теги;
	Возврат Поправка;

КонецФункции

// Пакеты пула main в поправке: oint включён, web снят пулом, secret снят хозяином подписки.
Функция ДеревоПакетовПула()
	Дерево = Новый ФейкСервисИсключений();
	Дерево.БезГалкиПула();
	Пул = Дерево.ДобавитьПул(3, "main");
	Дерево.ДобавитьПакет(Пул, 42, "oint");
	Дерево.ДобавитьПакет(Пул, 43, "web", Истина);
	Дерево.ДобавитьПакет(Пул, 50, "secret", Ложь, Истина);
	Возврат Дерево;
КонецФункции

// Тег галки с этим именем целиком.
Функция ТегГалки(Знач HTML, Знач ИмяПоля)
	Возврат Новый ГалкиВРазметке().Тег(HTML, ИмяПоля);
КонецФункции

Функция ПараметрыСверху(Знач МожноМенять, Знач ТипОбъекта = "пул", Знач Идентификатор = 3)

	Параметры = Новый Структура();
	Параметры.Вставить("Объект", Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор",
		ТипОбъекта, Идентификатор, 3));
	Параметры.Вставить("Адрес", "/pools/main/settings/webhooks");
	Параметры.Вставить("Токен", "csrf-токен");
	Параметры.Вставить("ИмяПула", "main");
	Параметры.Вставить("МожноМенять", МожноМенять);
	Параметры.Вставить("Форма", Неопределено);
	Параметры.Вставить("ПоправкаИд", 0);
	Параметры.Вставить("Зритель", Неопределено);
	Параметры.Вставить("ДеревоИд", "");
	Параметры.Вставить("Поиск", "");
	Возврат Параметры;

КонецФункции

Функция ПараметрыСвоих(Знач ТипОбъекта)

	Параметры = Новый Структура();
	Параметры.Вставить("Объект", Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор", ТипОбъекта, 3, 3));
	Параметры.Вставить("Адрес", "/hub/settings/webhooks");
	Параметры.Вставить("Токен", "csrf-токен");
	Параметры.Вставить("НовыйСекрет", "");
	Параметры.Вставить("Пояснение", "Пояснение раздела.");
	Параметры.Вставить("МожноМенять", Истина);
	Параметры.Вставить("Тип", "");
	Параметры.Вставить("Зритель", Новый Структура("Идентификатор, Админ", 1, Истина));
	Возврат Параметры;

КонецФункции

// Свёрнутая строка первой карточки раздела.
Функция ПерваяШапка(Знач HTML)
	Начало = СтрНайти(HTML, "<summary");
	Ожидаем.Что(Начало > 0, "карточка напечатана").ЭтоИстина();
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</summary>"));
КонецФункции

// Тексты плашек в строке названия сводки через запятую.
Функция ЗнакиУНазвания(Знач Шапка)

	Начало = СтрНайти(Шапка, "brief__head");
	Голова = Сред(Шапка, Начало, СтрНайти(Сред(Шапка, Начало), "brief__sub") - 1);
	Знаки = Новый Массив();
	Позиция = СтрНайти(Голова, "class=""tag");
	Пока Позиция > 0 Цикл
		Голова = Сред(Голова, Позиция);
		Голова = Сред(Голова, СтрНайти(Голова, ">") + 1);
		Знаки.Добавить(Лев(Голова, СтрНайти(Голова, "<") - 1));
		Позиция = СтрНайти(Голова, "class=""tag");
	КонецЦикла;
	Возврат СтрСоединить(Знаки, ",");

КонецФункции

// Открывающий тег формы с этим адресом.
Функция ТегФормы(Знач HTML, Знач Адрес)
	Позиция = СтрНайти(HTML, "action=""" + Адрес);
	Ожидаем.Что(Позиция > 0, "форма " + Адрес + " напечатана").ЭтоИстина();
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 5) <> "<form" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

// Содержимое формы с этим адресом.
Функция МеждуФормой(Знач HTML, Знач Адрес)
	Позиция = СтрНайти(HTML, "action=""" + Адрес);
	Ожидаем.Что(Позиция > 0, "форма " + Адрес + " напечатана").ЭтоИстина();
	Хвост = Сред(HTML, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</form>"));
КонецФункции

// Подписи разделов формы по порядку.
Функция Разделы(Знач Форма)
	Подписи = Новый Массив();
	Метка = "<fieldset class=""form-section""><legend>";
	Позиция = СтрНайти(Форма, Метка);
	Пока Позиция > 0 Цикл
		Форма = Сред(Форма, Позиция + СтрДлина(Метка));
		Подписи.Добавить(Лев(Форма, СтрНайти(Форма, "</legend>") - 1));
		Позиция = СтрНайти(Форма, Метка);
	КонецЦикла;
	Возврат СтрСоединить(Подписи, ",");
КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Имя)
	Метка = " " + Имя + "=""";
	Начало = СтрНайти(Тег, Метка);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Тег, Начало + СтрДлина(Метка));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);
КонецФункции

// Открывающий тег кнопки с этой подписью.
Функция КнопкаСохранить(Знач HTML, Знач Подпись)
	Позиция = СтрНайти(HTML, "<span>" + Подпись + "</span>");
	Ожидаем.Что(Позиция > 0, "кнопка «" + Подпись + "» напечатана").ЭтоИстина();
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 7) <> "<button" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

// Ряд действий карточки целиком: формы-кнопки внутри него закрываются раньше ряда.
Функция РядДействий(Знач HTML)
	Начало = СтрНайти(HTML, "<div class=""actions-row"">");
	Ожидаем.Что(Начало > 0, "ряд действий напечатан").ЭтоИстина();
	Хвост = Сред(HTML, Начало);
	Глубина = 0;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Хвост) Цикл
		Если Сред(Хвост, Позиция, 4) = "<div" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Сред(Хвост, Позиция, 6) = "</div>" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Лев(Хвост, Позиция + 5);
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Хвост;
КонецФункции

// Значение подписанной строки сводки карточки; "" — строки нет.
Функция Сведение(Знач HTML, Знач Подпись)
	Возврат СведениеКарточки(HTML, Подпись);
КонецФункции

// Значение подписанной строки в свёрнутой строке карточки — по тексту, как его читает человек:
// подпись и следующий за ней кусок текста. "" — строки нет ни в одной карточке.
Функция СведениеКарточки(Знач HTML, Знач Подпись)

	Хвост = HTML;
	Начало = СтрНайти(Хвост, "<summary");
	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало);
		Конец = СтрНайти(Хвост, "</summary>");
		Куски = КускиТекста(?(Конец = 0, Хвост, Лев(Хвост, Конец)));
		Для Номер = 0 По Куски.Количество() - 2 Цикл
			Если Куски[Номер] = Подпись Тогда
				Возврат Куски[Номер + 1];
			КонецЕсли;
		КонецЦикла;
		Хвост = Сред(Хвост, 2);
		Начало = СтрНайти(Хвост, "<summary");
	КонецЦикла;
	Возврат "";

КонецФункции

// Текст разметки кусками между тегами, без пустых.
Функция КускиТекста(Знач Разметка)

	Куски = Новый Массив();
	Для Каждого Часть Из СтрРазделить(Разметка, "<", Ложь) Цикл
		Текст = СокрЛП(Сред(Часть, СтрНайти(Часть, ">") + 1));
		Если ЗначениеЗаполнено(Текст) Тогда
			Куски.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Куски;

КонецФункции


// Отмечен ли первый в разметке флажок с этим именем.
Функция Отмечен(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Позиция > 0, СтрШаблон("флажок %1 напечатан", ИмяПоля)).ЭтоИстина();
	Хвост = Сред(HTML, Позиция);
	Возврат СтрНайти(Лев(Хвост, СтрНайти(Хвост, ">")), "checked") > 0;

КонецФункции

Функция ТелоСекций(Знач Секции)

	Результат = "";
	Для Каждого Секция Из Секции Цикл
		Результат = Результат + Строка(Секция.Тело);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
