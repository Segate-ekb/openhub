	Ожидаем.Что(Разделы(МеждуФормой(HTML, "/hub/settings/webhooks/7/save")), "разделы формы по порядку")
		.Равно("Куда отправлять,О чём сообщать,Кому,Текст уведомления");
	Якорь = ЗначениеАтрибута(Правка, "id");
