	Ожидаем.Что(Название < СтрНайти(Шапка, "Telegram"), "способ доставки — подписью под именем").ЭтоИстина();
	Ожидаем.Что(Шапка, "число событий — фактом").Содержит("brief__fact");
	Ожидаем.Что(ПлашкиЗаписи(Шапка), "выключенная — плашкой у имени").Равно("выключена");

КонецПроцедуры

&Тест
Процедура ЗаписьСверхуНазванаПервойАХозяинПодписью() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Поправки.ДобавитьСверху(ПодпискаХаба("telegram", "-100777", "", "", ""),
		ПоправкаОбъекта("пул", 3, 3, Ложь, "package.version.published", ""));

	Шапка = ПерваяШапка(Стенд.РазделСверху(Стенд.Параметры()));

	Ожидаем.Что(СтрНайти(Шапка, "релизы в общий чат") < СтрНайти(Шапка, "подписка хаба"),
		"имя — до хозяина: " + Шапка).ЭтоИстина();
	Ожидаем.Что(Шапка, "хозяин и события — одной подписью").Содержит("подписка хаба · события:");
	Ожидаем.Что(ПлашкиЗаписи(Шапка), "«сверху» и сужение — плашками у имени").Равно("сверху,сужена");

КонецПроцедуры

// Перечни — свойствами раскрытой записи, а не плашками одного веса с состоянием в строке.
&Тест
Процедура СобытияИТегиСвойствамиАСостояниеПлашкой() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Каналы.ЗавестиТегПула(3, "stable");
	Стенд.Каналы.ЗавестиТегПула(3, "develop");
	Подписка = Запись(9, "пул", "вебхук", "https://hook.example.com/c",
		"{""подписка"":{""теги"":[""stable"",""develop""]}}");
	Подписка.ТипыСобытий = "package.version.published,pool.storage.filled";
	Подписка.Активен = Ложь;
	Стенд.Сервис.ДобавитьПодписку(Подписка);

	HTML = Стенд.Раздел(Стенд.Параметры("пул"));

	Ожидаем.Что(Свойство(HTML, "события"), "события — свойством").Равно("Версия опубликована Пул заполняется");
	Ожидаем.Что(Свойство(HTML, "теги"), "теги — своим").Равно("stable, develop");
	Ожидаем.Что(ПлашкиЗаписи(ПерваяШапка(HTML)), "плашкой в строке — только состояние").Равно("выключена");

КонецПроцедуры

&Тест
Процедура ОкноПравкиШагамиВкладкамиАДействияВМенюЗаписи() Экспорт

	Стенд = НовыйСтенд();
	Стенд.Сервис.ДобавитьПодписку(ПодпискаХаба("telegram", "-100777", "", "", ""));

	Список = Стенд.Раздел(Стенд.Параметры("хаб"));
	Окно = ОткрытыеОкна(Стенд.Раздел(Стенд.Параметры("хаб", Стенд.Окна.Открытое("изменить", "7"))))[0];

	Ожидаем.Что(Шаги(Окно), "шаги окна правки по порядку").Равно("Куда,О чём,Текст");
	Ожидаем.Что(Окно, "при правке шаги — вкладками").Содержит("steps--tabs");
	Для Каждого Действие Из СтрРазделить("test,toggle", ",") Цикл
		Ожидаем.Что(Список, "в записи — " + Действие).Содержит("/pools/main/settings/webhooks/7/" + Действие);
	КонецЦикла;
	Ожидаем.Что(Список, "удаление — подтверждением по адресу")
		.Содержит(АдресОкна("/pools/main/settings/webhooks", "удалить-7"));

КонецПроцедуры

&Тест
Процедура ОкноНовойШагамиАУПакетаНетСуженияИКому() Экспорт

	Стенд = НовыйСтенд();
	Пул = ОкноНовой(Стенд.Раздел(Стенд.Параметры("пул")));
	Ожидаем.Что(Шаги(Пул), "шаги окна новой подписки").Равно("Куда,О чём,Текст");
	Ожидаем.Что(Пул, "у пула — о ком сообщает новая подписка").Содержит("обо всех пакетах пула");

	Пакет = ОкноНовой(Стенд.Раздел(Стенд.Параметры("пакет")));
	Ожидаем.Что(Шаги(Пакет), "у пакета те же три шага").Равно("Куда,О чём,Текст");
	Ожидаем.Что(СтрНайти(Пакет, "обо всех пакетах"), "ниже пакета никого — и строки «кому» нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Реестр()

	Доставки = Новый Массив();
	Доставки.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-1"));
	Доставки.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-2"));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-3"));
	Хранения.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-4"));
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());
	Рендеры.Добавить(Новый РендерНастроекTelegram(Новый ШаблонУведомления(Неопределено)));
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры);

КонецФункции

Функция Запись(Знач Ид, Знач ТипОбъекта, Знач ТипДействия, Знач Адрес, Знач СвойстваJSON)

	Запись = Новый ФейкВебхукЗапись(Новый ФейкХранилищеВебхуков());
	Запись.Идентификатор = Ид;
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ОбъектИдентификатор = 3;
	Запись.ТипДействия = ТипДействия;
	Запись.URL = Адрес;
	Запись.ТипыСобытий = "package.version.published";
	Запись.ПараметрыСобытийJSON = СвойстваJSON;
	Запись.Активен = Истина;
	Возврат Запись;

КонецФункции

Функция ПодпискаХаба(Знач ТипДействия, Знач Адрес, Знач Секрет, Знач Токен, Знач Шаблон)

	Подписка = Запись(7, "хаб", ТипДействия, Адрес,
		"{""подписка"":{""название"":""релизы в общий чат"",""сужение"":true,""теги"":[""stable""]}}");
	Подписка.Секрет = Секрет;
	Подписка.ТокенДействия = Токен;
	Подписка.ШаблонТекста = Шаблон;
	Подписка.НастройкиДействия = "{""тема"":""777""}";
	Возврат Подписка;

КонецФункции

Функция ПоправкаОбъекта(Знач ТипОбъекта, Знач Ид, Знач ПулИд, Знач НеПрисылать, Знач Снятые, Знач Теги)

	Поправка = Новый ФейкПоправкаЗапись(Новый ФейкХранилищеПоправок());
	Поправка.ТипОбъекта = ТипОбъекта;
	Поправка.ОбъектИдентификатор = Ид;
	Поправка.ПулИдентификатор = ПулИд;
	Поправка.НеПрисылать = НеПрисылать;
	Поправка.СнятыеСобытия = Снятые;
	Поправка.ОтборТегов = Теги;
	Возврат Поправка;

КонецФункции

// Пакеты пула main в поправке: oint включён, web снят пулом, secret снят хозяином подписки.
Функция ДеревоПакетовПула()
	Дерево = Новый ФейкСервисИсключений();
	Дерево.БезГалкиПула();
	Пул = Дерево.ДобавитьПул(3, "main");
	Дерево.ДобавитьПакет(Пул, 42, "oint");
	Дерево.ДобавитьПакет(Пул, 43, "web", Истина);
	Дерево.ДобавитьПакет(Пул, 50, "secret", Ложь, Истина);
	Возврат Дерево;
КонецФункции

// Тег галки узла по её ключу целиком.
Функция ТегГалки(Знач HTML, Знач Ключ, Знач ИмяПоля = "галка")
	Возврат Новый ГалкиВРазметке().Тег(HTML, Ключ, ИмяПоля);
КонецФункции

// Кусок разметки от первого «Начало» до ближайшего «Конец» включительно.
Функция Между(Знач HTML, Знач Начало, Знач Конец)
	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, Конец) + СтрДлина(Конец) - 1);
КонецФункции

// Стенд витрин над фейками, которые тест наполняет: подписки, поправки, каналы, пулы и пакеты.
Функция НовыйСтенд(Знач Исключения = Неопределено)

	Сервис = Новый ФейкСервисПодписок();
	Типы = Новый Массив();
	Типы.Добавить("package.version.published");
	Типы.Добавить("pool.storage.filled");
	Сервис.УстановитьТипыСобытий(Типы);
	Стенд = Новый СтендВитриныПодписок(UI, Сервис, Реестр(), Новый ФейкСервисПоправок(), Исключения,
		Новый ФейкКаналыПакетов(), Новый ФейкСервисПулов(), Новый ФейкПакетыПоИдентификатору());
	Возврат Стенд;

КонецФункции

// Свёрнутая строка первой карточки раздела.
Функция ПерваяШапка(Знач HTML)
	Начало = СтрНайти(HTML, "<summary");
	Ожидаем.Что(Начало > 0, "карточка напечатана").ЭтоИстина();
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</summary>"));
КонецФункции

// Тексты плашек в строке имени первой записи через запятую.
Функция ПлашкиЗаписи(Знач HTML)

	Начало = СтрНайти(HTML, "brief__head");
	Голова = Сред(HTML, Начало);
	Голова = Лев(Голова, СтрНайти(Голова, "brief__sub") - 1);
	Знаки = Новый Массив();
	Позиция = СтрНайти(Голова, "class=""tag");
	Пока Позиция > 0 Цикл
		Голова = Сред(Голова, Позиция);
		Голова = Сред(Голова, СтрНайти(Голова, ">") + 1);
		Знаки.Добавить(Лев(Голова, СтрНайти(Голова, "<") - 1));
		Позиция = СтрНайти(Голова, "class=""tag");
	КонецЦикла;
	Возврат СтрСоединить(Знаки, ",");

КонецФункции

// Открывающий тег формы с этим адресом.
Функция ТегФормы(Знач HTML, Знач Адрес)
	Позиция = СтрНайти(HTML, "action=""" + Адрес);
	Ожидаем.Что(Позиция > 0, "форма " + Адрес + " напечатана").ЭтоИстина();
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 5) <> "<form" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Имя)
	Метка = " " + Имя + "=""";
	Начало = СтрНайти(Тег, Метка);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Тег, Начало + СтрДлина(Метка));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);
КонецФункции

// Значение свойства раскрытой записи по его подписи — текстом, как его читает человек; "" — свойства нет.
Функция Свойство(Знач HTML, Знач Подпись)
	Метка = "<dt>" + Подпись + "</dt><dd";
	Позиция = СтрНайти(HTML, Метка);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Метка));
	Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
	Значение = Лев(Хвост, СтрНайти(Хвост, "</dd>") - 1);
	// примечание под значением — не само значение
	Примечание = СтрНайти(Значение, "<span class=""props__note""");
	Если Примечание > 0 Тогда
		Значение = Лев(Значение, Примечание - 1);
	КонецЕсли;
	Куски = Новый Массив();
	Для Каждого Часть Из СтрРазделить(Значение, "<", Ложь) Цикл
		Текст = СокрЛП(Сред(Часть, СтрНайти(Часть, ">") + 1));
		Если ЗначениеЗаполнено(Текст) Тогда
			Куски.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Куски, " ");
КонецФункции

// Запись реестра с этим именем: от её <li class="entry"> до следующей.
Функция ЗаписьРеестра(Знач HTML, Знач Имя)

	Хвост = HTML;
	Позиция = СтрНайти(Хвост, "<li class=""entry""");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Следующая = СтрНайти(Хвост, "<li class=""entry""", , 2);
		Запись_ = ?(Следующая = 0, Хвост, Лев(Хвост, Следующая - 1));
		Если СтрНайти(Запись_, ">" + Имя + "<") > 0 Тогда
			Возврат Запись_;
		КонецЕсли;
		Позиция = Следующая;
	КонецЦикла;
	Возврат "";

КонецФункции

// Разметка открытых окон: <dialog …open> до своего </dialog>.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Если СтрНайти(Лев(Окно, СтрНайти(Окно, ">")), " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Окно новой подписки на странице: стоит закрытым до своего </dialog>.
Функция ОкноНовой(Знач HTML)
	Позиция = СтрНайти(HTML, "id=""podpiska-novaya""");
	Ожидаем.Что(Позиция > 0, "окно новой подписки напечатано").ЭтоИстина();
	Хвост = Сред(HTML, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</dialog>"));
КонецФункции

// Подписи шагов окна по порядку: из полосы номеров.
Функция Шаги(Знач Окно)
	Подписи = Новый Массив();
	Хвост = Окно;
	Метка = "steps__label";
	Позиция = СтрНайти(Хвост, Метка);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
		Подписи.Добавить(Лев(Хвост, СтрНайти(Хвост, "<") - 1));
		Позиция = СтрНайти(Хвост, Метка);
	КонецЦикла;
	Возврат СтрСоединить(Подписи, ",");
КонецФункции

Функция АдресОкна(Знач Раздел, Знач Окно)
	Возврат Раздел + "?" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку(Окно, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Отмечен ли первый в разметке флажок с этим именем.
Функция Отмечен(Знач HTML, Знач ИмяПоля)

	Позиция = СтрНайти(HTML, "name=""" + ИмяПоля + """");
	Ожидаем.Что(Позиция > 0, СтрШаблон("флажок %1 напечатан", ИмяПоля)).ЭтоИстина();
	Хвост = Сред(HTML, Позиция);
	Возврат СтрНайти(Лев(Хвост, СтрНайти(Хвост, ">")), "checked") > 0;

КонецФункции

#КонецОбласти
