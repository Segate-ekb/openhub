// Разделы «Версии и метки» и «Опасная зона» дома «Пакет» на механизме «⚙ строки + окно по адресу
// + подтверждение»: отзыв и возврат формой из одной кнопки, тег окном по адресу, снятие тега
// подтверждением, удаление пакета с эхом имени — настоящим контроллером дома поверх настоящих
// служб версий и тегов в контейнере; резерв имени — фейк.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать oscript-ui
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Засев;         // ЗасевРеестра — пул, пакет и версии службами хаба
Перем КореньХранилища;
Перем Гвард;         // ГвардПакетаЗаглушка
Перем Резерв;        // ФейкРезерваИмён — пакет без версий для опасной зоны
Перем Контроллер;    // КонтроллерДомаПакета

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(Модули, "вход, зеркала, права, подписки, публикация, статистика");
	ПоискКлассов.ПодключитьРеализации(Модули, "ПоследствияУдаленияПакета, ПоследствияУдаленияПула");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "настройки", "Классы"));
	РеестрНастроекХаба.ПодключитьКлассы(ПоискКлассов, Модули);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "аудит", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ГотовностьХаба");

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	Для Каждого Имя Из СтрРазделить("ОкноРаздела,ОтметкаСохранения,ПлашкаТега,ОформлениеТега,ЗначкиВерсии,"
		+ "ОтветыНастроек,СборкаДомаНастроек,ДомПула,ДомПакета,АдресаКаталога,ГейтФормы,РазборФормы,ТекстСбоя,"
		+ "ИсходОкна,ДатаЧеловеку", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

	РеестрФикстур.Подключить("ЖурналАудитаФайлом");
	РеестрФикстур.Подключить("ГвардПакетаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ПорогРазделаПакетаЗаглушка");
	РеестрФикстур.Подключить("ФейкРезерваИмён");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ГотовностьЗаглушка");
	РеестрФикстур.Подключить("СчитающееХранилищеАгрегатов");

	Детальки = Новый Соответствие();
	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-screen-versions");
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-версий-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
	Поделка.ЗапуститьПриложение();
	Засев = Новый ЗасевРеестра(Поделка);

	// витрины, пульты и служба скачиваний собираются руками после старта: контейнеру они не нужны
	Для Каждого Имя Из СтрРазделить("ВитринаВерсийПакета,ПультВерсийПакета,ВитринаОпаснойЗоныПакета,"
		+ "ПультУдаленияПакета,ВитринаДомаПакета,ПультПакета,КонтроллерДомаПакета", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;
	КаталогСтатистики = ОбъединитьПути(Модули, "статистика", "Классы");
	Для Каждого Имя Из СтрРазделить("СчётчикСкачиванийВПамяти,НазначениеСброса,СлужбаСтатистикиСкачиваний", ",") Цикл
		ПоискКлассов.Подключить(КаталогСтатистики, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "фоновыеЗадания", "Классы"), "ЗапускВФонеЗаданием");

	СобратьКонтроллер(Интерфейс);

КонецПроцедуры

Процедура СобратьКонтроллер(Знач Интерфейс)

	UI = Новый СборкаUI().Собрать(Интерфейс);
	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Сборка, Новый ФейкСервисПрав(), UI.Тексты,
		Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Окна = Желудь("ОкноРаздела");
	Исходы = Желудь("ИсходОкна");
	Страницы = Новый АдресаСтраниц();
	ДомПула = Новый ДомПула(Сборка, UI.Тексты, Страницы, Новый АдресаКаталога());

	Резерв = Новый ФейкРезерваИмён();
	Удаление = Новый ПультУдаленияПакета(Желудь("РазборФормы"), Резерв, Желудь("ТекстСбоя"),
		Желудь("СервисПулов"), UI.Тексты, Исходы, Логирование.ПолучитьЛог("тест.oshub.экран-версий"));
	Дом = Новый ДомПакета(Сборка, ДомПула, Новый ПорогРазделаПакетаЗаглушка(Ложь), Удаление, UI.Тексты, Страницы);

	ПультВерсий = Новый ПультВерсийПакета(Желудь("РазборФормы"), Желудь("СервисВерсий"), Желудь("СервисТегов"),
		Окна, Исходы, Желудь("ТекстСбоя"), UI.Тексты);
	ВитринаВерсий = Новый ВитринаВерсийПакета(UI.Кит, Желудь("СервисВерсий"), Желудь("СервисТегов"), Желудь("РежимТега"),
		Желудь("ПлашкаТега"), Желудь("СервисПроисхождения"), СлужбаСкачиваний(), Желудь("ЗначкиВерсии"),
		Желудь("ОбъёмТекстом"), Окна, ПультВерсий, UI.Тексты);
	ОпаснаяЗона = Новый ВитринаОпаснойЗоныПакета(UI.Кит, Окна, Удаление, UI.Тексты);
	Витрина = Новый ВитринаДомаПакета(Дом, ДомПула, Неопределено, ВитринаВерсий, Неопределено, Неопределено, ОпаснаяЗона);
	Пульт = Новый ПультПакета(Неопределено, ПультВерсий, Неопределено, Исходы);

	Гвард = Новый ГвардПакетаЗаглушка();
	Контроллер = Новый КонтроллерДомаПакета(Гвард, Ответы, Желудь("ТекстСбоя"), Дом, Витрина, Пульт, Удаление,
		Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы")), Защита,
		Желудь("СервисПакетов"), UI.Тексты, Страницы, Окна);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

#Область Таблица

// Таблица версий из данных: номер заглавием, скачивания и размер — колонками чисел, в меню ⚙
// строки — отзыв формой из одной кнопки, «Поставить тег» и «Снять тег» — окнами по адресу.
// Ни одно окно не напечатано заранее, прежних признаков confirm() нет.
&Тест
Процедура ТаблицаВерсийСМенюСтрокиИОкнамиПоАдресу() Экспорт

	Пакет = ПакетСВерсиями("1.0.0,1.1.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0", "alice");
	Теги().ПереместитьТег(Пакет.Идентификатор, "edge", "1.1.0", "alice");

	Страница = Получить(Пакет, "versions", "");
	HTML = Страница.ТелоТекст;

	Ожидаем.Что(Страница.Код, "раздел отдан").Равно(200);
	Ожидаем.Что(HTML, "таблица карточками").Содержит("table-cards");
	Ожидаем.Что(HTML, "номер версии — заглавная ячейка").Содержит("cell-title");
	Ожидаем.Что(HTML, "колонка чисел").Содержит(">Скачиваний<");
	Ожидаем.Что(ЧислоВхождений(HTML, "value=""yank"""), "у каждой версии отзыв формой").Равно(2);
	Ожидаем.Что(HTML, "«Поставить тег» ведёт на окно этой версии")
		.Содержит(Экранировать(АдресОкна(Адрес(Пакет, "versions"), "тег-1.0.0")));
	Ожидаем.Что(HTML, "«Снять тег» ведёт на подтверждение тега этой версии")
		.Содержит(Экранировать(АдресОкна(Адрес(Пакет, "versions"), "снять-lts@1.0.0")));
	Ожидаем.Что(ОткрытыеОкна(HTML).Количество(), "открытых окон нет").Равно(0);
	Ожидаем.Что(HTML, "прежних признаков confirm() нет").Не_().Содержит("data-confirm-value");
	Ожидаем.Что(HTML, "без маркеров неизвестных ключей").Не_().Содержит("[?");

КонецПроцедуры

// Без ручных тегов пункт меню ведёт в раздел «Теги» — там их заводят.
&Тест
Процедура БезРучныхТеговПунктВедётВРазделТегов() Экспорт

	Пакет = ПакетСВерсиями("1.0.0");

	HTML = Получить(Пакет, "versions", "").ТелоТекст;

	Ожидаем.Что(HTML, "пункт ведёт в теги").Содержит("href=""" + Адрес(Пакет, "tags") + """");
	Ожидаем.Что(HTML, "окна тега нет").Не_().Содержит(Экранировать("тег-1.0.0"));

КонецПроцедуры

#КонецОбласти

#Область Отзыв

// Форма несёт желаемое состояние: повтор отзыва версию не возвращает, возврат — отдельной формой.
&Тест
Процедура ОтзывИВозвратФормойСЖелаемымСостоянием() Экспорт

	Пакет = ПакетСВерсиями("1.0.0");

	Ответ = Отправить(Пакет, "versions", "операция=yank&версия=1.0.0");
	Ожидаем.Что(Ответ.Код, "отзыв — возврат в раздел").Равно(303);
	Ожидаем.Что(Отозвана(Пакет, "1.0.0"), "версия отозвана").ЭтоИстина();

	Отправить(Пакет, "versions", "операция=yank&версия=1.0.0");
	Ожидаем.Что(Отозвана(Пакет, "1.0.0"), "повтор отзыва версию не вернул").ЭтоИстина();
	Ожидаем.Что(Получить(Пакет, "versions", "").ТелоТекст, "в меню теперь возврат").Содержит("value=""unyank""");

	Отправить(Пакет, "versions", "операция=unyank&версия=1.0.0");
	Ожидаем.Что(Отозвана(Пакет, "1.0.0"), "версия возвращена").ЭтоЛожь();

КонецПроцедуры

// Неизвестная операция и форма старой вкладки ничего не меняют: 400 и причина словами.
&Тест
Процедура СтараяИНеизвестнаяФормаНеМеняютВерсий() Экспорт

	Пакет = ПакетСВерсиями("1.0.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0", "alice");
	Отправить(Пакет, "versions", "операция=yank&версия=1.0.0");

	Ответ = Отправить(Пакет, "versions", "операция=restore&версия=1.0.0");
	Ожидаем.Что(Ответ.Код, "неизвестная операция — 400").Равно(400);
	Ожидаем.Что(Отозвана(Пакет, "1.0.0"), "отозванная не вернулась").ЭтоИстина();

	// прежняя форма снятия несла своё поле подтверждения вместо подтверждения кита
	Старая = Отправить(Пакет, "versions", "операция=тег_снять&версия=1.0.0&имя=lts&подтверждение=да");
	Ожидаем.Что(Старая.Код, "старая форма снятия — 400").Равно(400);
	Ожидаем.Что(Старая.ТелоТекст, "причина названа").Содержит("Страница устарела");
	Ожидаем.Что(ТегиВерсии(Пакет, "1.0.0"), "метка на месте").Равно("lts");

КонецПроцедуры

#КонецОбласти

#Область Теги

// Окно тега по адресу предлагает только ручные теги, которых на версии нет; поставленный тег
// виден в строке; неизвестный тег — 400 тем же окном с отказом у поля.
&Тест
Процедура ТегСтавитсяОкномПоАдресу() Экспорт

	Пакет = ПакетСВерсиями("1.0.0,1.1.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0", "alice");

	Окна = ОткрытыеОкна(Получить(Пакет, "versions", "тег-1.1.0").ТелоТекст);
	Ожидаем.Что(Окна.Количество(), "окно тега открыто").Равно(1);
	Ожидаем.Что(Окна[0], "в нём выбор ручного тега").Содержит("<option value=""lts""");
	// без скрипта окно по адресу не модальное: закрывает его ссылка на раздел без ?окно
	Ожидаем.Что(Окна[0], "окно закрывает ссылка на раздел").Содержит("href=""" + Адрес(Пакет, "versions") + """");

	Ожидаем.Что(ОткрытыеОкна(Получить(Пакет, "versions", "тег-1.0.0").ТелоТекст).Количество(),
		"версии, где все ручные теги уже стоят, окна нет").Равно(0);
	Ожидаем.Что(ОткрытыеОкна(Получить(Пакет, "versions", "тег-9.9.9").ТелоТекст).Количество(),
		"неизвестной версии окна нет").Равно(0);

	Отбитое = Отправить(Пакет, "versions", "операция=тег_добавить&версия=1.1.0&имя=nosuch");
	Ожидаем.Что(Отбитое.Код, "чужой тег — 400").Равно(400);
	ОкнаОтказа = ОткрытыеОкна(Отбитое.ТелоТекст);
	Ожидаем.Что(ОкнаОтказа.Количество(), "окно вернулось открытым").Равно(1);
	Ожидаем.Что(ОкнаОтказа[0], "поле помечено").Содержит("aria-invalid");

	Ответ = Отправить(Пакет, "versions", "операция=тег_добавить&версия=1.1.0&имя=lts");
	Ожидаем.Что(Ответ.Код, "тег поставлен — возврат в раздел").Равно(303);
	Ожидаем.Что(ТегиВерсии(Пакет, "1.1.0"), "ручной тег переехал на версию").Содержит("lts");

КонецПроцедуры

// Снятие тега без поля подтверждения (без скрипта) ведёт на окно подтверждения, метка цела;
// подтверждённое — метки нет.
&Тест
Процедура СнятиеТегаСпрашиваетПодтверждениеПоАдресу() Экспорт

	Пакет = ПакетСВерсиями("1.0.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0", "alice");

	Без = Отправить(Пакет, "versions", "операция=тег_снять&версия=1.0.0&имя=lts");
	Ожидаем.Что(Без.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(Без.ПутьРедиректа), "на окно подтверждения этой метки")
		.Равно(Адрес(Пакет, "versions") + "?окно=снять-lts@1.0.0");
	Ожидаем.Что(ТегиВерсии(Пакет, "1.0.0"), "метка цела").Равно("lts");

	Окна = ОткрытыеОкна(Получить(Пакет, "versions", "снять-lts@1.0.0").ТелоТекст);
	Ожидаем.Что(Окна.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(Окна[0], "называет тег").Содержит("lts");
	Ожидаем.Что(Окна[0], "и кнопка шлёт подтверждение").Содержит("name=""confirmed""");

	Ответ = Отправить(Пакет, "versions", "операция=тег_снять&версия=1.0.0&имя=lts&confirmed=1");
	Ожидаем.Что(Ответ.Код, "снято — возврат в раздел").Равно(303);
	Ожидаем.Что(ТегиВерсии(Пакет, "1.0.0"), "метки нет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Гвард

// Кого гвард не впустил, тот не отзывает, не возвращает, не ставит и не снимает теги и не
// удаляет пакет: ни события, ни ответа-перенаправления. КОНТРОЛЬ: впущенный той же формой меняет.
&Тест
Процедура ДвериНеТрогаютДоменТогоКогоГвардНеВпустил() Экспорт

	Пакет = ПакетСВерсиями("1.0.0,1.1.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0", "alice");
	Резерв.Зарезервировать(Пакет.Имя);
	Слушатель = СлушательВерсий();

	Гвард.Отказать();
	Ответы = Новый Массив();
	Ответы.Добавить(Послать(Пакет, "versions", "операция=yank&версия=1.0.0"));
	Ответы.Добавить(Послать(Пакет, "versions", "операция=тег_добавить&версия=1.1.0&имя=lts"));
	Ответы.Добавить(Послать(Пакет, "versions", "операция=тег_снять&версия=1.0.0&имя=lts&confirmed=1"));
	Ответы.Добавить(Послать(Пакет, "danger", "операция=пакет-удалить&подтверждение=" + Пакет.Имя + "&confirmed=1"));

	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(Ответ.Код, "гвард не впустил — 403").Равно(403);
		Ожидаем.Что(Ответ.ПутьРедиректа, "посторонний никуда не перенаправлен").Равно("");
		Ожидаем.Что(Строка(Ответ.ТелоТекст), "и тела ему не отдано").Равно("");
	КонецЦикла;
	Ожидаем.Что(Отозвана(Пакет, "1.0.0"), "версия не отозвана").ЭтоЛожь();
	Ожидаем.Что(ТегиВерсии(Пакет, "1.0.0"), "метка на месте").Равно("lts");
	Ожидаем.Что(ТегиВерсии(Пакет, "1.1.0"), "тег не переехал").Равно("");
	Ожидаем.Что(Резерв.Снятые().Количество(), "пакет не удалён").Равно(0);
	Ожидаем.Что(Слушатель.События.Количество(), "событий в журнал не ушло").Равно(0);

	// КОНТРОЛЬ: впущенный той же формой отзывает
	Отправить(Пакет, "versions", "операция=yank&версия=1.0.0");
	Ожидаем.Что(Отозвана(Пакет, "1.0.0"), "КОНТРОЛЬ: впущенный отзывает").ЭтоИстина();
	Ожидаем.Что(Слушатель.События.Количество() > 0, "КОНТРОЛЬ: событие отзыва ушло").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОпаснаяЗона

// Опасная зона: одна кнопка-ссылка на подтверждение; без подтверждения — 303 на окно, пакет цел;
// чужое эхо — 400 с открытым подтверждением и отказом под полем; верное — удаление и страница пула.
&Тест
Процедура УдалениеПакетаСпрашиваетЭхоИмени() Экспорт

	Пакет = Засев.ПакетСервисом(Засев.ПулСервисом());
	Впустить(Пакет);
	Резерв.Зарезервировать(Пакет.Имя);
	АдресЗоны = Адрес(Пакет, "danger");

	Зона = Получить(Пакет, "danger", "");
	Ожидаем.Что(Зона.Код, "зона открыта мейнтейнеру").Равно(200);
	Ожидаем.Что(Зона.ТелоТекст, "кнопка ведёт на подтверждение").Содержит(Экранировать(АдресОкна(АдресЗоны, "удалить")));
	Ожидаем.Что(ОткрытыеОкна(Зона.ТелоТекст).Количество(), "подтверждение закрыто").Равно(0);

	Окна = ОткрытыеОкна(Получить(Пакет, "danger", "удалить").ТелоТекст);
	Ожидаем.Что(Окна.Количество(), "по адресу подтверждение открыто").Равно(1);
	Ожидаем.Что(Окна[0], "эхо — имя пакета").Содержит("pattern=""" + Пакет.Имя + """");

	Без = Отправить(Пакет, "danger", "операция=пакет-удалить&подтверждение=" + Пакет.Имя);
	Ожидаем.Что(Без.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Раскодировать(Без.ПутьРедиректа), "на окно подтверждения").Равно(АдресЗоны + "?окно=удалить");
	Ожидаем.Что(Резерв.Снятые().Количество(), "пакет цел").Равно(0);

	Чужое = Отправить(Пакет, "danger", "операция=пакет-удалить&подтверждение=other&confirmed=1");
	Ожидаем.Что(Чужое.Код, "чужое эхо — 400").Равно(400);
	ОкнаОтказа = ОткрытыеОкна(Чужое.ТелоТекст);
	Ожидаем.Что(ОкнаОтказа.Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(ОкнаОтказа[0], "отказ под полем").Содержит("aria-invalid");
	Ожидаем.Что(Резерв.Снятые().Количество(), "пакет цел").Равно(0);

	Верное = Отправить(Пакет, "danger", "операция=пакет-удалить&подтверждение=" + Пакет.Имя + "&confirmed=1");
	Ожидаем.Что(Верное.Код, "удалён — переход").Равно(303);
	Ожидаем.Что(Верное.ПутьРедиректа, "на страницу пула").Равно(Новый АдресаСтраниц().Пула(ПулПакета(Пакет).Имя));
	Ожидаем.Что(Резерв.Снятые().Количество(), "пакет снят").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Теги()
	Возврат Желудь("СервисТегов");
КонецФункции

Функция СлужбаСкачиваний()

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.stats.flush_threshold", 9999);
	Настройки.Задать("oshub.stats.flush_interval_sec", 99999);
	Возврат Новый СлужбаСтатистикиСкачиваний(Новый СчётчикСкачиванийВПамяти(), Новый СчитающееХранилищеАгрегатов(),
		Неопределено, Настройки, Новый ГотовностьЗаглушка(), Новый ЗапускВФонеЗаданием());

КонецФункции

Функция СлушательВерсий()

	Издатель = Желудь("ИздательСобытий");
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипВерсияОтозвана(), Слушатель);
	Издатель.Подписать(Издатель.ТипВерсияВосстановлена(), Слушатель);
	Издатель.Подписать(Издатель.ТипТегПеремещён(), Слушатель);
	Издатель.Подписать(Издатель.ТипТегУдалён(), Слушатель);
	Возврат Слушатель;

КонецФункции

Функция ПакетСВерсиями(Знач СписокВерсий)

	Пакет = Засев.ПакетСервисом(Засев.ПулСервисом());
	Для Каждого Номер Из СтрРазделить(СписокВерсий, ",", Ложь) Цикл
		Засев.ВерсияСервисом(Пакет, СокрЛП(Номер));
	КонецЦикла;
	Впустить(Пакет);
	Возврат Пакет;

КонецФункции

Функция ПулПакета(Знач Пакет)
	Возврат Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);
КонецФункции

Процедура Впустить(Знач Пакет)
	Гвард.Впустить("alice", ПулПакета(Пакет), Пакет);
КонецПроцедуры

Функция Отозвана(Знач Пакет, Знач Номер)
	Для Каждого Версия Из Желудь("СервисВерсий").ВерсииПакета(Пакет.Идентификатор) Цикл
		Если Версия.Версия = Номер Тогда
			Возврат Версия.Отозвана = Истина;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет версии " + Номер;
КонецФункции

// Имена тегов на версии через запятую.
Функция ТегиВерсии(Знач Пакет, Знач Номер)

	Имена = Новый Массив();
	ПоВерсиям = Теги().ТегиПоВерсиям(Пакет.Идентификатор);
	Для Каждого Версия Из Желудь("СервисВерсий").ВерсииПакета(Пакет.Идентификатор) Цикл
		Если Версия.Версия = Номер И ПоВерсиям.Получить(Версия.Идентификатор) <> Неопределено Тогда
			Для Каждого Тег Из ПоВерсиям.Получить(Версия.Идентификатор) Цикл
				Имена.Добавить(Строка(Тег.Имя));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

Функция Адрес(Знач Пакет, Знач Раздел)
	Возврат СтрШаблон("/pools/%1/packages/%2/settings/%3", ПулПакета(Пакет).Имя, Пакет.Имя, Раздел);
КонецФункции

Функция Получить(Знач Пакет, Знач Раздел, Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, ПулПакета(Пакет).Имя, Пакет.Имя, Раздел, Новый Соответствие(), Новый КукиЗаглушка(),
		"GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

// POST формы раздела впущенным мейнтейнером.
Функция Отправить(Знач Пакет, Знач Раздел, Знач Тело)
	Впустить(Пакет);
	Возврат Послать(Пакет, Раздел, Тело);
КонецФункции

// POST формы раздела тем, кого гвард пустил или нет, — как решил тест.
Функция Послать(Знач Пакет, Знач Раздел, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Контроллер.Раздел(Ответ, ПулПакета(Пакет).Имя, Пакет.Имя, Раздел, Новый Соответствие(), Новый КукиЗаглушка(),
		"POST", "_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Если СтрНайти(Лев(Окно, СтрНайти(Окно, ">")), " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЧислоВхождений(Знач Текст, Знач Фрагмент)
	Возврат СтрЧислоВхождений(Текст, Фрагмент);
КонецФункции

Функция АдресОкна(Знач Раздел, Знач Окно)
	Возврат Новый ПараметрыСсылки().Установить(Раздел, "окно", Окно);
КонецФункции

// Адрес в атрибуте страницы: амперсанд экранирован.
Функция Экранировать(Знач Адрес)
	Возврат СтрЗаменить(Адрес, "&", "&amp;");
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
