// Юнит-тесты слоя представления подписок: окно собирается ИЗ ДЕКЛАРАЦИИ ОБРАБОТЧИКА — поля боевых типов
// и стороннего типа из фикстуры в наборах сегментов, сторож имён полей, секрет не печатается, подписи
// из словаря; запись реестра, окна по адресу, предпросмотр и проба без скрипта, пульт.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем UI;              // фикстура СборкаUI — кит компонентов, словарь, резолвер текстов
Перем Разбор;          // РазборФормы
Перем КаталогПроекта;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Собрать() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	КаталогОбработчиков = ОбъединитьПути(КаталогМодулей, "подписки", "Классы", "обработчики");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(КаталогWebUI);

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЗаписьФормы");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	ПоискКлассов.Подключить(КаталогWebUI, "РазборФормы");
	// ЗащитаCSRF нужна рендереру только ради ИМЕНИ поля токена — службы сессий этот путь не касается
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	ПоискКлассов.Подключить(КаталогWebUI, "ИменаПолейПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "КаталогДействийПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "ПоляПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "РазборФормыПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "ОкноРаздела");
	ПоискКлассов.Подключить(КаталогWebUI, "ОтметкаСохранения");
	ПоискКлассов.Подключить(КаталогWebUI, "ИменаПодписок");
	ПоискКлассов.Подключить(КаталогWebUI, "ЗаписьПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "ОкноПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "ВитринаПодписокСверху");
	ПоискКлассов.Подключить(КаталогWebUI, "ПоляСобытийПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "ВитринаПодписок");
	ПоискКлассов.Подключить(КаталогWebUI, "ПоляСвойствПодписки");
	ПоискКлассов.Подключить(КаталогWebUI, "ПоправкиНижестоящих");
	ПоискКлассов.Подключить(КаталогWebUI, "СрезПодписок");
	ПоискКлассов.Подключить(КаталогWebUI, "ПолучателиЗаписи");
	ПоискКлассов.Подключить(КаталогWebUI, "ПравилоДереваПолучателей");
	ПоискКлассов.Подключить(КаталогWebUI, "ОкноПолучателей");
	ПоискКлассов.Подключить(КаталогWebUI, "СчётСловами");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"),
		"РеестрДействийПодписок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"),
		"ШаблонУведомления");

	Вебхук = ОбъединитьПути(КаталогОбработчиков, "вебхук");
	ПоискКлассов.Подключить(Вебхук, "РендерНастроекВебхука");
	Телеграм = ОбъединитьПути(КаталогОбработчиков, "telegram");
	ПоискКлассов.Подключить(Телеграм, "РендерНастроекTelegram");

	РеестрФикстур.Подключить("ПробныйТипДействия");
	РеестрФикстур.Подключить("ТощийРендерНастроек");
	РеестрФикстур.Подключить("ФейкСервисПодписок");
	РеестрФикстур.Подключить("ФейкСервисИсключений");
	РеестрФикстур.Подключить("ФейкКаталогСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"), "ПараметрыПодписки");
	РеестрФикстур.Подключить("ФейкХранилищеВебхуков");
	РеестрФикстур.Подключить("ФейкВебхукЗапись");
	РеестрФикстур.Подключить("ФейкСервисПоправок");
	РеестрФикстур.Подключить("ФейкСервисПулов");
	РеестрФикстур.Подключить("ФейкПакетыПоИдентификатору");

	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ЧтениеПолей");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "КанонСтроки");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"), "ОтборПоТегам");
	ПоискКлассов.Подключить(КаталогWebUI, "ОтборТеговПодписки");
	РеестрФикстур.Подключить("ФейкКаналыПакетов");
	РеестрФикстур.Подключить("ФейкПредпросмотрУведомления");
	ПоискКлассов.Подключить(КаталогWebUI, "ПультПодписок");
	ПоискКлассов.Подключить(КаталогWebUI, "ПроверкаПодпискиДоСохранения");
	РеестрФикстур.Подключить("ТекстСбояЗаглушка");
	РеестрФикстур.Подключить("СтендВитриныПодписок");

	Разбор = Новый РазборФормы();

КонецПроцедуры

#Область ФормаИзДекларации

&Тест
Процедура ОкноРисуетПоляТипаВНабореЕгоСегмента() Экспорт

	// имена полей перечислены ЗДЕСЬ руками: тест, читающий ту же декларацию, зеленел бы и на удалении поля
	Раздел = Стенд(Реестр());
	Выбор = Раздел.Поля.ВыборКанала(Неопределено).Рендер();
	Вебхук = НаборСегмента(Выбор, "вебхук");
	Телеграм = НаборСегмента(Выбор, "telegram");

	Ожидаем.Что(Выбор, "канал выбирается радиокнопками под именем поля типа")
		.Содержит("name=""тип_действия"" value=""вебхук""");
	Ожидаем.Что(СтрНайти(Вебхук, "name=""url""") > 0, "поле url вебхука в его наборе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вебхук, "name=""секрет""") > 0, "поле секрета вебхука").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вебхук, "name=""chat-id"""), "полей чужого типа в наборе нет").Равно(0);
	Ожидаем.Что(СтрНайти(Выбор, "Вебхук (HTTP POST)") > 0, "подпись типа «вебхук» из словаря").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Телеграм, "name=""chat-id""") > 0, "поле chat-id telegram").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Телеграм, "name=""бот-токен""") > 0, "поле своего токена бота").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Телеграм, "name=""шаблон-текста"""), "шаблон — не среди адреса и токена").Равно(0);
	Ожидаем.Что(СтрНайти(Раздел.Поля.ПоляТекста("telegram", Неопределено).Рендер(), "name=""шаблон-текста""") > 0,
		"поле своего текста — у шага текста").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел.Поля.ПоляТекста("вебхук", Неопределено).Рендер(), "name="),
		"у вебхука текста уведомления нет").Равно(0);
	Ожидаем.Что(СтрНайти(Телеграм, "name=""url"""), "поля вебхука в наборе telegram нет").Равно(0);
	Ожидаем.Что(СтрНайти(Телеграм, "Чат или канал") > 0, "подпись поля telegram из словаря").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Выбор, "[?") = 0, "ни одного маркера потерянного ключа").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестныйИПустойТипДаютПервыйНаборПолей() Экспорт

	// прямая ссылка и подделанное значение обязаны дать рабочее окно, а не пустой экран
	Раздел = Стенд(Реестр());
	Первый = Раздел.Каталог.Типы()[0].Тип;

	Ожидаем.Что(Раздел.Каталог.ВыбранныйТип(""), "пустой тип — первый набор полей").Равно(Первый);
	Ожидаем.Что(Раздел.Каталог.ВыбранныйТип("голубиная.почта"), "неизвестный тип — тоже первый").Равно(Первый);
	Ожидаем.Что(Раздел.Каталог.ВыбранныйТип(" TELEGRAM "), "регистр и пробелы нормализованы").Равно("telegram");

	Выбор = Раздел.Поля.ВыборКанала(Неопределено).Рендер();
	Ожидаем.Что(Тег(Выбор, "input", "value=""" + Первый + """"), "отмечен первый канал").Содержит("checked");

КонецПроцедуры

&Тест
Процедура НовыйТипРисуетсяОкномБезПравкиЭкранов() Экспорт

	// тип, которого не знает ни окно, ни витрина, ни пульт, приезжает одной фикстурой и получает свои поля
	Проба = Новый ПробныйТипДействия("проба.форма", "канал");
	Раздел = Стенд(РеестрС(Проба));
	Выбор = Раздел.Поля.ВыборКанала(Неопределено).Рендер();

	Ожидаем.Что(СтрНайти(НаборСегмента(Выбор, "проба.форма"), "name=""канал""") > 0,
		"поле стороннего типа нарисовано по его декларации в его наборе").ЭтоИстина();
	Ожидаем.Что(СодержитТип(Раздел.Каталог.Типы(), "проба.форма"),
		"сторонний тип попал в выбор канала").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Выбор, "[?probe.action.проба.форма.label]") > 0,
		"подпись берётся ПО КЛЮЧУ декларации: нет ключа — виден маркер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТипБезРендераВОкноНеПопадает() Экспорт

	// реестр допускает тип без рендера настроек; окно показать его не может — полей нет
	Проба = Новый ПробныйТипДействия("проба.безформы", "канал");

	Доставки = Новый Массив();
	Доставки.Добавить(Проба);
	Хранения = Новый Массив();
	Хранения.Добавить(Проба);
	Реестр = Новый РеестрДействийПодписок(Доставки, Хранения, Новый Массив());

	HTML = Стенд(Реестр).Поля.ВыборКанала(Неопределено).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "проба.безформы"), "тип без рендера в окно не попал").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Ни один тип действия не заявил формы") > 0,
		"вместо пустого выбора — честное объяснение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекретноеПолеВводитсяПаролем() Экспорт

	Тег_ = Тег(Стенд(Реестр()).Поля.ВыборКанала(Неопределено).Рендер(), "input", "name=""секрет""");
	Ожидаем.Что(Тег_, "поле секрета есть").Заполнено();
	Ожидаем.Что(Тег_, "секретное поле декларации рисуется вводом пароля").Содержит("type=""password""");

КонецПроцедуры

&Тест
Процедура ОбязательностьНаборовНеПечатаетсяАтрибутомRequired() Экспорт

	// спрятанный набор не отключён: обязательное поле чужого набора не пустило бы окно — его проверяет сервер
	HTML = Стенд(Реестр()).Поля.ВыборКанала(Неопределено).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "required"),
		"обязательность наборов проверяется на сервере, а не атрибутом формы").Равно(0);

КонецПроцедуры

&Тест
Процедура ПлагинБезПоловиныКонтрактаРоняетСборкуАНеЭкран() Экспорт

	// плагин без половины контракта (КлючПодписи/КлючПояснения) отказывает на СБОРКЕ ЖЕЛУДЯ, а не пятисоткой раздела
	Тощий = Новый ТощийРендерНастроек();

	Ошибка = "";
	Попытка
		Стенд(РеестрС(Тощий));
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	// ассерты — ПОСЛЕ Попытки (упавший ассерт внутри неё сам стал бы «ошибкой сборки»)
	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"неполный рендер роняет сборку желудя, а не отрисовку страницы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "не выполняет контракт") > 0,
		"причина названа словами, а не стеком платформы: " + Ошибка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "ревью.тощий") > 0,
		"назван ТИП, чей плагин неполон").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "КлючПодписи") > 0,
		"назван весь контракт, чтобы автор плагина понял, чего не хватает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИменаПолейРазделаБерутсяУВладельцаАНеИзЛитералов() Экспорт

	// имена полей раздела объявляет владелец (ИменаПолейПодписки): проверяем СВЯЗЬ, а не совпадающие литералы
	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));

	HTML = Раздел.Раздел(Раздел.Параметры());

	Ожидаем.Что(СтрНайти(HTML, "name=""" + Раздел.Имена.ИмяПоляСобытия(0) + """") > 0,
		"флажок события назван именем владельца").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""" + Раздел.Имена.ИмяПоляВключить() + """") > 0,
		"тумблер назван именем владельца").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""" + Раздел.Имена.ИмяПоляТипа() + """") > 0,
		"выбор канала назван именем владельца").ЭтоИстина();

	Занятые = Новый Массив();
	Занятые.Добавить(Раздел.Имена.ИмяПоляТипа());
	Занятые.Добавить(Раздел.Имена.ИмяПоляВключить());
	Занятые.Добавить(Раздел.Имена.ИмяПоляСобытия(0));
	Занятые.Добавить(Раздел.Имена.ИмяПоляЭха());
	Занятые.Добавить(Новый ЗащитаCSRF(Неопределено).ИмяПоля());

	Уцелевшие = Новый Массив();
	Для Каждого Имя Из Занятые Цикл
		Ошибка = "";
		Попытка
			Стенд(РеестрС(Новый ПробныйТипДействия("проба." + Имя, Имя)));
		Исключение
			Ошибка = ОписаниеОшибки();
		КонецПопытки;
		Если СтрНайти(Ошибка, "служебное имя поля") = 0 Тогда
			Уцелевшие.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Уцелевшие, ", "),
		"каждое имя, объявленное владельцем, для типов закрыто").Равно("");

КонецПроцедуры

&Тест
Процедура ПодписиПолейВсехТиповЖивутВСловаре() Экспорт

	// подпись, вписанную строкой вместо ключа, видно сразу: резолвер вернёт маркер
	Реестр = Реестр();
	Плохие = Новый Массив();

	Для Каждого Тип Из Реестр.Типы() Цикл
		Рендер = Реестр.РендерНастроек(Тип);
		Если Рендер = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПроверитьКлюч(Плохие, Тип + "/тип", Рендер.КлючПодписи(), Истина);
		ПроверитьКлюч(Плохие, Тип + "/пояснение", Рендер.КлючПояснения(), Ложь);
		Для Каждого Поле Из Рендер.ОписаниеПолей() Цикл
			ПроверитьКлюч(Плохие, Тип + "/" + Поле.Имя, Поле.КлючПодписи, Истина);
			ПроверитьКлюч(Плохие, Тип + "/" + Поле.Имя + ".hint", Поле.КлючПодсказки, Ложь);
			ПроверитьКлюч(Плохие, Тип + "/" + Поле.Имя + ".ph", Поле.КлючПлейсхолдера, Ложь);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Плохие, "; "),
		"подписи полей деклараций: ключ словаря, а не строка и не потерянный ключ").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ПечатьИЧтениеОдногоИмени

// Печать формы правки и её чтение живут в РАЗНЫХ классах, поэтому имя флажка «секрет свой»
// берётся ИЗ НАПЕЧАТАННОГО HTML. Разъедутся имена — КАЖДОЕ сохранение вебхук-подписки молча
// выпустит новый секрет и сломает проверку подписи у получателя.
&Тест
Процедура ФлажокСвоегоСекретаЧитаетсяПодНапечатаннымИменем() Экспорт

	Раздел = Стенд(Реестр());

	Разметка = Раздел.Поля.КаналПравки("вебхук", Новый Структура("URL, Секрет, СекретСвой",
		"https://hook.example.com/a", "", Истина), Неопределено).Рендер();
	ИмяФлажка = ИмяФлажкаИзРазметки(Разметка);

	Присланное = Новый Соответствие();
	Присланное.Вставить("тип_действия", "вебхук");
	Присланное.Вставить("url", "https://hook.example.com/a");
	Присланное.Вставить("секрет", "");
	Присланное.Вставить(ИмяФлажка, "1");

	Правка = Раздел.Разбор.Правка(Присланное);

	Ожидаем.Что(ЗначениеЗаполнено(ИмяФлажка),
		"флажок «секрет свой» вообще напечатан: " + Разметка).ЭтоИстина();
	Ожидаем.Что(Правка.Ввод.СекретСвой,
		"отмеченный флажок доехал до ввода под тем именем, каким напечатан («"
			+ ИмяФлажка + "»)").ЭтоИстина();

КонецПроцедуры

// Снятый флажок — это «секрета своего нет», а не «поле потерялось»: обе стороны обязаны
// различать их одинаково.
&Тест
Процедура СнятыйФлажокСвоегоСекретаЧитаетсяКакОтсутствиеСвоего() Экспорт

	Раздел = Стенд(Реестр());

	Присланное = Новый Соответствие();
	Присланное.Вставить("тип_действия", "вебхук");
	Присланное.Вставить("url", "https://hook.example.com/a");
	Присланное.Вставить("секрет", "");

	Ожидаем.Что(Раздел.Разбор.Правка(Присланное).Ввод.СекретСвой,
		"неприсланный флажок читается как «своего секрета нет»").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПорядокТипов

// Реестр отдаёт типы в порядке регистрации — от него зависит, КАКОЙ набор полей увидит
// человек, зашедший по прямой ссылке без параметра. Порядок задаёт каталог, по алфавиту.
&Тест
Процедура ТипыДействийПеречисленыПоАлфавиту() Экспорт

	Проба = Новый ПробныйТипДействия("aaa.первый", "поле-ааа");
	Имена = Новый Массив();
	Для Каждого Вариант Из Стенд(РеестрС(Проба)).Каталог.Типы() Цикл
		Имена.Добавить(Вариант.Тип);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Имена, ","), "типы идут по алфавиту, а не в порядке регистрации")
		.Равно("aaa.первый,telegram,вебхук");

КонецПроцедуры

#КонецОбласти

#Область СторожИмёнПолей

&Тест
Процедура ДубльИмениПоляСредиТиповРоняетСборку() Экспорт

	// два значения под одним именем: разбор возьмёт одно, и подписка тихо создастся с чужими настройками
	Проба = Новый ПробныйТипДействия("проба.дубль", "url");

	Ошибка = "";
	Попытка
		Стенд(РеестрС(Проба));
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка), "сборка формы упала на дубле имени поля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "объявлено дважды") > 0,
		"причина названа: имя поля занято другим типом").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РазборФормы

&Тест
Процедура РазборОтдаётВводВыбранногоТипа() Экспорт

	Разобрано = Стенд(Реестр()).Разбор.Заведение(
		Разбор.Разобрать("тип_действия=telegram&chat-id=%40mychannel&бот-токен=42%3AAAFukAn-token"));

	Ожидаем.Что(Разобрано.ТипДействия, "тип взят из скрытого поля формы").Равно("telegram");
	Ожидаем.Что(Разобрано.Ввод.ЧатИд, "chat-id доехал под доменным именем ввода").Равно("@mychannel");
	Ожидаем.Что(Разобрано.Ввод.Свойство("URL"),
		"поле ЧУЖОГО типа во ввод не попало: адресат telegram — не URL вебхука").ЭтоЛожь();

КонецПроцедуры

// Поля спрятанных наборов окна уходят с формой и не читаются: разбор берёт поля пришедшего типа,
// и подсунутое значение чужого набора до ввода не доезжает.
&Тест
Процедура ПоляЧужогоНабораНеЧитаются() Экспорт

	Раздел = Стенд(Реестр());

	Телеграм = Раздел.Разбор.Заведение(Разбор.Разобрать("тип_действия=telegram&chat-id=%40mychannel"
		+ "&бот-токен=42%3AAAFukAn-token&url=https%3A%2F%2Fx.example.com"));
	Вебхук = Раздел.Разбор.Заведение(Разбор.Разобрать(
		"тип_действия=вебхук&url=https%3A%2F%2Fx.example.com&chat-id=12345&бот-токен=1%3Aабвгдеёжзий"));

	Ожидаем.Что(Телеграм.Ввод.Свойство("URL"), "url вебхука в ввод telegram не попал").ЭтоЛожь();
	Ожидаем.Что(Телеграм.Ввод.ЧатИд, "КОНТРОЛЬ: свой чат на месте").Равно("@mychannel");
	Ожидаем.Что(Вебхук.Ввод.Свойство("ЧатИд"), "чат telegram в ввод вебхука не попал").ЭтоЛожь();
	Ожидаем.Что(Вебхук.Ввод.Свойство("Токен"), "и токен бота тоже").ЭтоЛожь();
	Ожидаем.Что(Вебхук.Отказы.Количество(), "отказов нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустоеПолеЧужогоТипаРазборуНеМешает() Экспорт

	// браузер шлёт пустые поля формы, а не только заполненные: пустое чужое — не подделка
	Разобрано = Стенд(Реестр()).Разбор.Заведение(
		Разбор.Разобрать("тип_действия=вебхук&url=https%3A%2F%2Fx.example.com&chat-id=+"));

	Ожидаем.Что(Разобрано.ТипДействия, "разбор состоялся").Равно("вебхук");

КонецПроцедуры

// Пустое обязательное поле — отказ под этим полем: окно вернётся к нему, а не к общему отказу.
&Тест
Процедура ПустоеОбязательноеПолеОтбиваетсяПодПолем() Экспорт

	Разобрано = Стенд(Реестр()).Разбор.Заведение(Разбор.Разобрать(
		"тип_действия=telegram&chat-id=+++&бот-токен=42%3AAAFukAn-token"));

	Отказ = Разобрано.Отказы.Получить("chat-id");
	Ожидаем.Что(Отказ, "пробелы обязательное поле не заполняют").Заполнено();
	Ожидаем.Что(Отказ, "названо ИМЕННО ТО поле (подписью из словаря)").Содержит("Чат или канал");
	Ожидаем.Что(Разобрано.Отказы.Получить("бот-токен"), "заполненное поле не отбито").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НеизвестныйИПустойТипОтклонены() Экспорт

	Раздел = Стенд(Реестр());

	Пусто = "";
	Попытка
		Раздел.Разбор.Заведение(Разбор.Разобрать("url=https%3A%2F%2Fx.example.com"));
	Исключение
		Пусто = ОписаниеОшибки();
	КонецПопытки;

	Чужой = "";
	Попытка
		Раздел.Разбор.Заведение(Разбор.Разобрать("тип_действия=smtp&url=https%3A%2F%2Fx.example.com"));
	Исключение
		Чужой = ОписаниеОшибки();
	КонецПопытки;

	// ассерты — ПОСЛЕ Попытки: упавший ассерт внутри неё сам стал бы «ошибкой разбора»
	Ожидаем.Что(СтрНайти(Пусто, "Не выбран тип действия") > 0,
		"тип по умолчанию не додумывается: форма всегда присылает селектор").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, "Неизвестный тип действия") > 0,
		"тип вне реестра отклонён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РегистрИПробелыВТипеНеЛомаютРазбор() Экспорт

	// значение селектора приходит из тела с пробелами и в любом регистре — разбор нормализует так же, как реестр
	Разобрано = Стенд(Реестр()).Разбор.Заведение(
		Разбор.Разобрать("тип_действия=+TELEGRAM+&chat-id=%40mychannel&бот-токен=42%3AAAFukAn-token"));

	Ожидаем.Что(Разобрано.ТипДействия, "регистр и пробелы нормализованы").Равно("telegram");

КонецПроцедуры

&Тест
Процедура ТипБезРендераНеЗаводитсяИРазбором() Экспорт

	// тип без формы не заводится и подставленным значением поля; отказ — СЛОВАМИ, пятисотка была бы дырой
	Проба = Новый ПробныйТипДействия("проба.безформы", "канал");

	Доставки = Новый Массив();
	Доставки.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-1"));
	Доставки.Добавить(Проба);
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-2"));
	Хранения.Добавить(Проба);
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());

	Ошибка = "";
	Попытка
		Стенд(Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры)).Разбор.Заведение(
			Разбор.Разобрать("тип_действия=проба.безформы&канал=alpha"));
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Ошибка, "Неизвестный тип действия") > 0,
		"тип без формы отклонён словами, а не падением: " + Ошибка).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РазборСтороннегоТипаИдётПоЕгоДекларации() Экспорт

	Проба = Новый ПробныйТипДействия("проба.разбор", "канал");
	Разобрано = Стенд(РеестрС(Проба)).Разбор.Заведение(
		Разбор.Разобрать("тип_действия=проба.разбор&канал=alpha"));

	Ожидаем.Что(Разобрано.ТипДействия, "тип стороннего плагина разобран").Равно("проба.разбор");
	Ожидаем.Что(Разобрано.Ввод.канал, "значение поля плагина доехало до ввода").Равно("alpha");

КонецПроцедуры

#КонецОбласти

#Область ВитринаСписка

&Тест
Процедура СекретПодпискиНеПопадаетВРазметкуСписка() Экспорт

	Секрет = "s3cret-подпись-вебхука";
	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", Секрет));

	HTML = Раздел.Раздел(Раздел.Параметры());

	Ожидаем.Что(СтрНайти(HTML, Секрет), "секрет подписи в списке не печатается ни в каком виде").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "hook.example.com") > 0, "адрес доставки при этом виден").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НовыйСекретПоказываетсяРовноОдинРазОкном() Экспорт

	// сразу после создания секрет ДОЛЖЕН быть на экране — иначе приём вебхука не настроить
	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", "хранимый-секрет"));
	Параметры = Раздел.Параметры();
	Параметры.НовыйСекрет = "свежий-секрет-один-раз";

	HTML = Раздел.Раздел(Параметры);

	Окно = ОткрытыеОкна(HTML);
	Ожидаем.Что(Окно.Количество(), "секрет — открытым окном").Равно(1);
	Ожидаем.Что(Окно[0], "только что созданный секрет показан").Содержит("свежий-секрет-один-раз");
	Ожидаем.Что(СтрНайти(Окно[0], "data-closes"), "закрытия на месте у окна секрета нет — только переход").Равно(0);
	Ожидаем.Что(Окно[0], "крестик и «Закрыть» уводят на раздел").Содержит("href=""" + Параметры.Адрес + """");
	Ожидаем.Что(Окно[0], "Esc со скриптом — туда же").Содержит("data-close-to=""" + Параметры.Адрес + """");
	Ожидаем.Что(СтрНайти(HTML, "хранимый-секрет"), "а секреты уже существующих подписок — нет").Равно(0);
	Ожидаем.Что(СтрНайти(Раздел.Раздел(Раздел.Параметры()), "свежий-секрет-один-раз"),
		"без секрета в показе окна секрета нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ТипДействияПоказанПодписьюИзДекларации() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("@channel", "telegram", ""));
	Запись = ЗаписьРеестра(Раздел.Раздел(Раздел.Параметры()), "@channel");

	Ожидаем.Что(Запись, "тип действия в записи — подписью словаря, а не сырой строкой БД").Содержит("Telegram");

КонецПроцедуры

// Канал Telegram в записи — логотипом бренда из кита (слово владельца к превью 4: «значок
// телеграма кривой»), а не общим глифом «отправить»; вебхук — по-прежнему глифом.
&Тест
Процедура КаналTelegramВЗаписиЛоготипомБренда() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("@channel", "telegram", ""));
	Запись = ЗаписьРеестра(Раздел.Раздел(Раздел.Параметры()), "@channel");

	Ожидаем.Что(Запись, "КОНТРОЛЬ: запись канала найдена").Заполнено();
	Ожидаем.Что(Запись, "значок — логотип бренда кита").Содержит("icon--brand");
	Бренд = UI.НаборИконок.Бренд("telegram");
	Ожидаем.Что(Бренд, "КОНТРОЛЬ: кит знает бренд telegram").Заполнено();
	Ожидаем.Что(Запись, "рисунок — логотип Telegram из кита").Содержит(Бренд.Содержимое);
	Ожидаем.Что(Запись, "цветом бренда").Содержит("fill=""" + Бренд.Цвет + """");
	Ожидаем.Что(СтрНайти(Запись, UI.НаборИконок.Содержимое("отправить")), "не общий глиф «отправить»").Равно(0);

	Вебхук = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Запись = ЗаписьРеестра(Вебхук.Раздел(Вебхук.Параметры()), "https://hook.example.com/a");
	Ожидаем.Что(Запись, "КОНТРОЛЬ: запись вебхука найдена").Заполнено();
	Ожидаем.Что(СтрНайти(Запись, "icon--brand"), "у вебхука бренда нет").Равно(0);
	Ожидаем.Что(Запись, "у вебхука — глиф «вебхук»").Содержит(UI.НаборИконок.Содержимое("вебхук"));

КонецПроцедуры

&Тест
Процедура АдресДоставкиЭкранированВСписке() Экспорт

	// Адрес приходит от пользователя и печатается внутри <code>. Регресс на XSS.
	Раздел = Стенд(Реестр(), ВитринаСервис("https://x.example.com/""><script>alert(1)</script>", "вебхук", ""));
	HTML = Раздел.Раздел(Раздел.Параметры());

	Ожидаем.Что(СтрНайти(HTML, "<script>"), "разметка из адреса не выполнилась").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0, "адрес экранирован").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаналВыбираетсяСегментамиБезСкрипта() Экспорт

	// наборы полей переключает лист по отмеченной радиокнопке: ни обработчиков, ни ссылок ?kind=
	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Окно = Между(Раздел.Раздел(Раздел.Параметры()), "id=""podpiska-novaya""", "</dialog>");

	Ожидаем.Что(Окно, "КОНТРОЛЬ: окно новой подписки").Заполнено();
	Ожидаем.Что(Тег(Окно, "input", "value=""telegram"""), "канал — радиокнопкой").Содержит("type=""radio""");
	Ожидаем.Что(СтрНайти(Окно, "?kind="), "ссылок на наборы полей нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Окно), "onclick"), "переключение без обработчиков в разметке").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Окно), "<script"), "и без скриптов").Равно(0);

КонецПроцедуры

// Сегменты канала в окне («Куда») несут тот же значок, что запись подписки: Telegram — логотипом
// бренда кита, вебхук — своим глифом.
&Тест
Процедура СегментКаналаСоЗначкомКакУЗаписи() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Окно = Между(Раздел.Раздел(Раздел.Параметры()), "id=""podpiska-novaya""", "</dialog>");

	Телеграм = Между(Окно, "value=""telegram""", "</label>");
	Ожидаем.Что(Телеграм, "КОНТРОЛЬ: сегмент Telegram найден").Заполнено();
	Ожидаем.Что(Телеграм, "у Telegram — значок перед подписью").Содержит("segments__icon");
	Ожидаем.Что(Телеграм, "логотипом бренда").Содержит("icon--brand");
	Ожидаем.Что(Между(Окно, "value=""вебхук""", "</label>"), "у вебхука — глиф «вебхук»")
		.Содержит(UI.НаборИконок.Содержимое("вебхук"));

КонецПроцедуры

&Тест
Процедура ТокенБотаНигдеИШаблонаВСпискеНет() Экспорт

	// токен чужого бота — секрет того же рода, что секрет клиента провайдера входа
	Токен = "424242:ТОКЕН-ЧУЖОГО-БОТА-ХХХ";
	Раздел = Стенд(Реестр(), ВитринаСервис("@channel", "telegram", "", Токен, "{пакет} у {пул}"));

	Список = Раздел.Раздел(Раздел.Параметры());
	Правка = Раздел.Раздел(Раздел.Параметры("пул", Раздел.Окна.Открытое("изменить", "7")));

	Ожидаем.Что(СтрНайти(Список + Правка, Токен), "токен подписки в разметку не попадает").Равно(0);
	Ожидаем.Что(СтрНайти(Список + Правка, "ТОКЕН-ЧУЖОГО-БОТА"), "и обрывком тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Список, "{пакет} у {пул}"), "в списке шаблона текста нет").Равно(0);
	Ожидаем.Что(ЗаписьРеестра(Список, "@channel"), "признак «свой текст» у записи").Содержит("свой текст");

	// поле ввода токена пустое: маска живёт в примере, а не в значении
	Тег_ = Тег(ОткрытыеОкна(Правка)[0], "input", "name=""бот-токен""");
	Ожидаем.Что(Тег_, "токен вводится паролем").Содержит("type=""password""");
	Ожидаем.Что(СтрНайти(Тег_, "value="), "и без предзаполненного значения").Равно(0);

КонецПроцедуры

// Что видно в пустом поле шаблона, то и придёт без своего текста: пример поля — сам шаблон
// по умолчанию, многострочный.
&Тест
Процедура ПустоеПолеШаблонаПоказываетШаблонПоУмолчанию() Экспорт

	Текст = Стенд(Реестр()).Поля.ПоляТекста("telegram", Неопределено).Рендер();

	Поле = ТегСАтрибутом(Текст, "name=""шаблон-текста""");
	Ожидаем.Что(Поле, "поле шаблона: " + Текст).Заполнено();
	ПоУмолчанию = Новый ШаблонУведомления(Неопределено).ПоУмолчанию();
	Ожидаем.Что(СтрЧислоСтрок(ПоУмолчанию) > 1, "самотест: шаблон по умолчанию многострочный").ЭтоИстина();
	Ожидаем.Что(ЗначениеАтрибута(Поле, "placeholder"), "пример пустого поля").Равно(ПоУмолчанию);
	Ожидаем.Что(СтрНайти(Текст, "Оставьте пустым — придёт текст по умолчанию") > 0,
		"под полем одна строка о пустом поле").ЭтоИстина();

КонецПроцедуры

// Перечень того, что можно вставить, — свёрнутый список «имя — что подставится» ровно из тех имён,
// что принимает сохранение: разъехавшийся с кодом список хуже отсутствующего.
&Тест
Процедура ПереченьВставокПеречисляетРовноДопустимыеИмена() Экспорт

	Текст = ХвостПосле(Стенд(Реестр()).Поля.ПоляТекста("telegram", Неопределено).Рендер(),
		"name=""шаблон-текста""");

	Раскрывашка = Лев(Текст, СтрНайти(Текст, "</details>"));
	Ожидаем.Что(СтрНайти(Раскрывашка, "<details") > 0, "перечень — раскрывашкой: " + Текст).ЭтоИстина();
	Открывающий = ТегСАтрибутом(Раскрывашка, "<details");
	Ожидаем.Что(СтрНайти(Открывающий, " open"), "и свёрнут: " + Открывающий).Равно(0);
	Ожидаем.Что(СтрНайти(Раскрывашка, "Что можно вставить в текст") > 0, "под своей строкой").ЭтоИстина();
	Список = ХвостПосле(Раскрывашка, "<ul");
	Список = Лев(Список, СтрНайти(Список, "</ul>"));

	Напечатанные = Новый Массив();
	Хвост = Список;
	Пока СтрНайти(Хвост, "<li>") > 0 Цикл
		Хвост = Сред(ХвостПосле(Хвост, "<li>"), СтрДлина("<li>") + 1);
		Пункт = Лев(Хвост, СтрНайти(Хвост, "</li>") - 1);
		Ожидаем.Что(СтрНачинаетсяС(Пункт, "<code>{"), "имя — кодом: " + Пункт).ЭтоИстина();
		Имя = Сред(Пункт, СтрДлина("<code>{") + 1, СтрНайти(Пункт, "}</code>") - СтрДлина("<code>{") - 1);
		Ожидаем.Что(СтрДлина(СокрЛП(Сред(Пункт, СтрНайти(Пункт, "</code> — ") + СтрДлина("</code> — ")))) > 0,
			"и что подставится: " + Пункт).ЭтоИстина();
		Напечатанные.Добавить(Имя);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Напечатанные, ","), "перечень — ровно допустимые имена в их порядке")
		.Равно(СтрСоединить(Новый ШаблонУведомления(Неопределено).ИменаВставок(), ","));

КонецПроцедуры

&Тест
Процедура ТаблицыПеречняСобытийВОкнеНет() Экспорт

	// перечень дублировал бы флажки и предлагал внутренние события; «когда возникает» — строкой у флажка
	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Секции = Раздел.Витрина.Секции(Раздел.Параметры());

	Ожидаем.Что(Секции.Количество(), "секция раздела одна").Равно(1);

	HTML = Раздел.Разметка(Секции);
	Ожидаем.Что(СтрНайти(HTML, "События хаба"), "таблицы перечня нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Внутреннее событие"),
		"внутреннее событие подписке не предлагается вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "В пул принята новая версия пакета.") > 0,
		"«когда возникает» видно у флажка события").ЭтоИстина();

КонецПроцедуры

// Событие самого хаба — флажок только в окне подписки хаба, и у новой подписки он не отмечен: весть
// о новой версии хаба выбирают по желанию. Подписке пула и пакета о нём сообщать нечего.
&Тест
Процедура ФлажокНовойВерсииХабаТолькоУПодпискиХаба() Экспорт

	Сервис = Новый ФейкСервисПодписок();
	Типы = Новый Массив();
	Типы.Добавить("package.version.published");
	Типы.Добавить("hub.version.released");
	Сервис.УстановитьТипыСобытий(Типы);
	Раздел = Стенд(Реестр(), Сервис);
	// подпись флажка, а не упоминание события в перечне вставок шаблона
	Флажок = "<span class=""field__label"">Вышла новая версия хаба</span>";

	Хаба = Раздел.Разметка(Раздел.Витрина.Секции(Раздел.Параметры("хаб")));
	Ожидаем.Что(Хаба, "у подписки хаба флажок новой версии есть").Содержит(Флажок);
	Ожидаем.Что(ФлажокПодписи(Хаба, "Вышла новая версия хаба"), "у новой подписки он не отмечен")
		.Не_().Содержит(" checked");
	Ожидаем.Что(ФлажокПодписи(Хаба, "Версия опубликована"), "КОНТРОЛЬ: событие версии отмечено")
		.Содержит(" checked");

	Для Каждого Объект Из СтрРазделить("пул,пакет", ",") Цикл
		Разметка = Раздел.Разметка(Раздел.Витрина.Секции(Раздел.Параметры(Объект)));
		Ожидаем.Что(Разметка, "у подписки объекта «" + Объект + "» его нет").Не_().Содержит(Флажок);
		Ожидаем.Что(Разметка, "КОНТРОЛЬ: событие версии у «" + Объект + "» есть")
			.Содержит("<span class=""field__label"">Версия опубликована</span>");
	КонецЦикла;

КонецПроцедуры

// Запись подписки: тумблер своей формой, в меню ⚙ — окно правки и подтверждение по адресу, проба
// сохранёнными настройками — форма из одной кнопки. Окно правки по адресу: тип — скрытым полем
// и словами, поля — сохранённым.
&Тест
Процедура ЗаписьПодпискиВедётКОкнамПоАдресу() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Адрес = Раздел.Адрес();
	Запись = ЗаписьРеестра(Раздел.Раздел(Раздел.Параметры()), "https://hook.example.com/a");

	Ожидаем.Что(Запись, "тумблер").Содержит("action=""" + Адрес + "/7/toggle""");
	Форма = Сред(Запись, СтрНайти(Запись, "action=""" + Адрес + "/7/toggle"""));
	Форма = Лев(Форма, СтрНайти(Форма, "</form>"));
	Ожидаем.Что(СтрЧислоВхождений(Форма, "type=""submit"""), "без скрипта тумблер шлёт одна кнопка").Равно(1);
	Ожидаем.Что(Форма, "запасная кнопка кита").Содержит("toggle__save");
	Ожидаем.Что(Запись, "проба сохранёнными").Содержит("action=""" + Адрес + "/7/test""");
	Ожидаем.Что(Запись, "окно правки по адресу").Содержит(АдресОкна(Адрес, "изменить-7"));
	Ожидаем.Что(Запись, "подтверждение по адресу").Содержит(АдресОкна(Адрес, "удалить-7"));
	Ожидаем.Что(СтрНайти(Запись, "/7/save"), "формы правки в записи нет").Равно(0);

	Окно = ОткрытыеОкна(Раздел.Раздел(Раздел.Параметры("пул", Раздел.Окна.Открытое("изменить", "7"))));
	Ожидаем.Что(Окно.Количество(), "окно правки открыто").Равно(1);
	Ожидаем.Что(Окно[0], "форма окна — правка").Содержит("action=""" + Адрес + "/7/save""");
	Ожидаем.Что(Окно[0], "тип — скрытым полем").Содержит("name=""тип_действия"" value=""вебхук""");
	Ожидаем.Что(Окно[0], "и словами").Содержит("Тип действия правкой не меняется");
	Ожидаем.Что(Окно[0], "поля заполнены сохранённым").Содержит("value=""https://hook.example.com/a""");

КонецПроцедуры

&Тест
Процедура ОтклонённаяФормаВозвращаетсяЗаполненнойНоБезСекретов() Экспорт

	// одна опечатка не должна стоить набранного шаблона и отмеченных событий;
	// секрет при этом обратно не возвращается никогда
	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Форма = Разбор.Разобрать("тип_действия=telegram&chat-id=%D0%BD%D0%B5-%D1%87%D0%B0%D1%82"
		+ "&бот-токен=424242%3ATOKEN-iz-otklonyonnoy-formy"
		+ "&%D1%88%D0%B0%D0%B1%D0%BB%D0%BE%D0%BD-%D1%82%D0%B5%D0%BA%D1%81%D1%82%D0%B0={пакет}"
		+ "&%D1%81%D0%BE%D0%B1%D1%8B%D1%82%D0%B8%D0%B5_0=1");
	HTML = Раздел.Раздел(Раздел.Параметры("пул", Раздел.Окна.Отбитое("новая", "", Форма)));

	Окно = ОткрытыеОкна(HTML);
	Ожидаем.Что(Окно.Количество(), "окно новой подписки открыто").Равно(1);
	Ожидаем.Что(Окно[0], "адресат вернулся в форму").Содержит("value=""не-чат""");
	Ожидаем.Что(Окно[0], "и набранный шаблон тоже").Содержит("{пакет}</textarea>");
	Ожидаем.Что(Тег(Окно[0], "input", "value=""telegram"""), "выбран присланный канал").Содержит("checked");
	Ожидаем.Что(СтрНайти(HTML, "TOKEN-iz-otklonyonnoy-formy"), "а токен на страницу не возвращается").Равно(0);
	Ожидаем.Что(Окно[0], "и об этом честно сказано рядом с полем").Содержит("введите его заново");

КонецПроцедуры

&Тест
Процедура ОтклонённаяПравкаВозвращаетсяВСвоёОкноИНеТрогаетОкноНовой() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Форма = Разбор.Разобрать("тип_действия=%D0%B2%D0%B5%D0%B1%D1%85%D1%83%D0%BA&url=https%3A%2F%2Fnovy.example.com%2Fx");
	HTML = Раздел.Раздел(Раздел.Параметры("пул", Раздел.Окна.Отбитое("изменить", "7", Форма)));

	Окно = ОткрытыеОкна(HTML);
	Ожидаем.Что(Окно.Количество(), "открыто окно правки").Равно(1);
	Ожидаем.Что(Окно[0], "в нём присланное значение").Содержит("value=""https://novy.example.com/x""");
	Ожидаем.Что(СтрНайти(Между(HTML, "id=""podpiska-novaya""", "</dialog>"), "novy.example.com"),
		"окно новой подписки чужой правкой не заполняется").Равно(0);

КонецПроцедуры

&Тест
Процедура БезПраваОкнаИМенюНет() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Параметры = Раздел.Параметры();
	Параметры.МожноМенять = Ложь;
	HTML = Раздел.Раздел(Параметры);

	Ожидаем.Что(СтрНайти(HTML, "name=""тип_действия"""), "без права окна новой подписки нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "окно="), "и окон по адресу тоже").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Раздел показан только для чтения") > 0, "вместо окна — объяснение").ЭтоИстина();

КонецПроцедуры

// Предпросмотр без скрипта — кнопкой у текстовой доставки: шлёт форму окна на адрес предпросмотра
// и не требует обязательных полей; у вебхука текста нет — и кнопки нет.
&Тест
Процедура КнопкаПредпросмотраЕстьТолькоУТекстовойДоставки() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Новая = Между(Раздел.Раздел(Раздел.Параметры()), "id=""podpiska-novaya""", "</dialog>");
	Кнопка = ТегСАтрибутом(Новая, "formaction=""" + Раздел.Адрес() + "/preview""");
	Ожидаем.Что(Кнопка, "кнопка окна новой подписки шлёт форму на адрес предпросмотра").Заполнено();
	Ожидаем.Что(СтрНайти(Кнопка, "formtarget"), "ответ — та же страница с окном: " + Кнопка).Равно(0);
	Ожидаем.Что(СтрНайти(Кнопка, "formnovalidate") > 0, "чат и токен предпросмотру не нужны").ЭтоИстина();
	// текст канала — панелью его сегмента (слово кита): видна, пока отмечен этот канал, и без скрипта;
	// у вебхука текста нет — нет и панели
	Панели = ПанелиСегментов(Новая);
	Ожидаем.Что(Панели.Количество(), "панель текста — одна, у Telegram").Равно(1);
	Ожидаем.Что(Панели[0], "панель названа сегментом Telegram").Содержит("data-segment=""telegram""");
	Ожидаем.Что(СтрНайти(Новая, "formaction=""" + Раздел.Адрес() + "/preview""")
		> СтрНайти(Новая, "class=""segments-panel"""), "кнопка предпросмотра Telegram — в его панели").ЭтоИстина();
	Ожидаем.Что(Новая, "своих областей текста у хаба нет").ЭтоНе().Содержит("data-sub-texts");

	Вебхук = ОткрытыеОкна(Раздел.Раздел(Раздел.Параметры("пул", Раздел.Окна.Открытое("изменить", "7"))))[0];
	Ожидаем.Что(СтрНайти(Вебхук, "/preview"), "у правки вебхука предпросмотра нет").Равно(0);

	Телеграм = Стенд(Реестр(), ВитринаСервис("-100777", "telegram", ""));
	Правка = ОткрытыеОкна(Телеграм.Раздел(Телеграм.Параметры("пул", Телеграм.Окна.Открытое("изменить", "7"))))[0];
	Ожидаем.Что(ТегСАтрибутом(Правка, "formaction=""" + Раздел.Адрес() + "/7/preview"""),
		"в правке подписки Telegram — свой адрес предпросмотра").Заполнено();

КонецПроцедуры

// Сообщение, собранное сервером без скрипта, стоит в месте предпросмотра открыто; без него место
// скрыто и ждёт скрипта.
&Тест
Процедура ПредпросмотрБезСкриптаПечатаетсяВМесте() Экспорт

	Проверка = Стенд(Реестр()).Проверка;

	Собранное = Проверка.МестоПредпросмотра("/x/preview", "telegram",
		Сообщение("OpenHub: <b>lib</b>" + Символы.ПС + "вторая строка")).Рендер();
	Ожидаем.Что(ТегСАтрибутом(Собранное, "data-sub-preview="), "место").Заполнено();
	Ожидаем.Что(СтрНайти(ТегСАтрибутом(Собранное, "data-sub-preview="), "hidden"), "открыто").Равно(0);
	Ожидаем.Что(СтрНайти(Собранное, "OpenHub: &lt;b&gt;lib&lt;/b&gt;" + Символы.ПС + "вторая строка") > 0,
		"текст экранирован и с переносом: " + Собранное).ЭтоИстина();

	Ждёт = Проверка.МестоПредпросмотра("/x/preview", "telegram").Рендер();
	Ожидаем.Что(ТегСАтрибутом(Ждёт, "data-sub-preview="), "без сообщения место скрыто").Содержит("hidden");

КонецПроцедуры

// Предпросмотр рядом с полем шаблона: место за полем и до кнопок окна; скрипт берёт адрес, отвечающий
// кусочком, и имена секретных полей, которые в предпросмотр не уходят.
&Тест
Процедура МестоПредпросмотраСтоитУПоляШаблонаИСекретовНеШлёт() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Новая = Между(Раздел.Раздел(Раздел.Параметры()), "id=""podpiska-novaya""", "</dialog>");

	Место = ТегСАтрибутом(Новая, "data-sub-preview=""" + Раздел.Адрес() + "/preview?fragment=1""");
	Ожидаем.Что(Место, "место предпросмотра окна новой подписки: " + Новая).Заполнено();
	Ожидаем.Что(Место, "без скрипта место скрыто").Содержит("hidden");
	Ожидаем.Что(Место, "токен бота в предпросмотр не уходит").Содержит("data-sub-omit=""бот-токен""");
	Ожидаем.Что(СтрНайти(Новая, "name=""шаблон-текста""") < СтрНайти(Новая, "data-sub-preview="),
		"место — после поля шаблона").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Новая, "data-sub-preview=") < СтрНайти(Новая, "Создать подписку"),
		"и до кнопок окна").ЭтоИстина();
	Ожидаем.Что(ТегСАтрибутом(Новая, "data-sub-preview-target"), "место ответа").Заполнено();
	Ожидаем.Что(ТегСАтрибутом(Новая, "data-sub-preview-button"), "кнопку без скрипта скрипт прячет").Заполнено();

	Телеграм = Стенд(Реестр(), ВитринаСервис("-100777", "telegram", ""));
	Правка = ОткрытыеОкна(Телеграм.Раздел(Телеграм.Параметры("пул", Телеграм.Окна.Открытое("изменить", "7"))))[0];
	Ожидаем.Что(ТегСАтрибутом(Правка, "data-sub-preview=""" + Раздел.Адрес() + "/7/preview?fragment=1"""),
		"у окна правки — свой адрес").Заполнено();

КонецПроцедуры

// Проба из окна: без скрипта кнопка шлёт форму окна на адрес пробы, и страница вернёт окно с итогом;
// скрипт берёт адрес, отвечающий кусочком, и показывает итог у кнопки.
&Тест
Процедура ПробаИзОкнаРаботаетФормойИСкриптом() Экспорт

	Раздел = Стенд(Реестр(), ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Новая = Между(Раздел.Раздел(Раздел.Параметры()), "id=""podpiska-novaya""", "</dialog>");

	Ожидаем.Что(ТегСАтрибутом(Новая, "data-sub-trial=""" + Раздел.Адрес() + "/test?fragment=1"""),
		"проба окна новой подписки: " + Новая).Заполнено();
	Кнопка = ТегСАтрибутом(Новая, "formaction=""" + Раздел.Адрес() + "/test""");
	Ожидаем.Что(Кнопка, "без скрипта кнопка шлёт форму на адрес пробы").Заполнено();
	Ожидаем.Что(СтрНайти(Кнопка, "formtarget"), "в ту же вкладку: " + Кнопка).Равно(0);
	Ожидаем.Что(ТегСАтрибутом(Новая, "data-sub-trial-result"), "итог у кнопки объявляется скринридеру")
		.Содержит("role=""status""");

	Правка = ОткрытыеОкна(Раздел.Раздел(Раздел.Параметры("пул", Раздел.Окна.Открытое("изменить", "7"))))[0];
	Ожидаем.Что(ТегСАтрибутом(Правка, "data-sub-trial=""" + Раздел.Адрес() + "/7/test?fragment=1"""),
		"проба окна правки").Заполнено();

	Итог = Раздел.Параметры("пул", Раздел.Окна.Отбитое("новая", "", Разбор.Разобрать("тип_действия=telegram")));
	Итог.Проба = ИсходПробы(Истина, "ok", "HTTP 204");
	Окно = ОткрытыеОкна(Раздел.Раздел(Итог));
	Ожидаем.Что(Окно.Количество(), "окно с итогом пробы открыто").Равно(1);
	Ожидаем.Что(Окно[0], "итог словами").Содержит("Пробное дошло: HTTP 204");

КонецПроцедуры

// Ответ предпросмотра — сообщение так, как его покажет Telegram: текст с переносами, под ним
// карточка ссылки с узлом и адресом; без адреса — без карточки; отказ — причина.
&Тест
Процедура ОтветПредпросмотраПоказываетСообщениеTelegram() Экспорт

	Проверка = Стенд(Реестр()).Проверка;

	HTML = Проверка.ОтветПредпросмотра(Сообщение("Вышла <b>1.0</b>" + Символы.ПС + "Релиз",
		"https://github.com/acme/lib/releases/tag/v1.0")).Рендер();
	Ожидаем.Что(ТегСАтрибутом(HTML, "data-sub-result=""ok"""), "ответ помечен для скрипта").Заполнено();
	Ожидаем.Что(СтрНайти(HTML, "Вышла &lt;b&gt;1.0&lt;/b&gt;" + Символы.ПС + "Релиз") > 0,
		"текст экранирован, переносы на месте: " + HTML).ЭтоИстина();
	Карточка = ХвостПосле(HTML, "data-sub-card");
	Ожидаем.Что(СтрНайти(Карточка, "github.com") > 0, "карточка называет узел").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Карточка, "href=""https://github.com/acme/lib/releases/tag/v1.0""") > 0,
		"и ведёт по адресу: " + Карточка).ЭтоИстина();

	БезКарточки = Проверка.ОтветПредпросмотра(Сообщение("Текст", "")).Рендер();
	Ожидаем.Что(СтрНайти(БезКарточки, "data-sub-card"), "без адреса карточки нет").Равно(0);

	Отказ = Проверка.ОтветПредпросмотра(Сообщение("", "", "Неизвестный плейсхолдер «{x}». Допустимы: {пул}"))
		.Рендер();
	Ожидаем.Что(ТегСАтрибутом(Отказ, "data-sub-result=""err"""), "отказ помечен").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "Допустимы: {пул}") > 0, "с перечнем допустимых").ЭтоИстина();

КонецПроцедуры

// Итог пробы у кнопки — словом и знаком: дошла, не дошла (что ответила цель) или почему хаб её
// не отправил.
&Тест
Процедура ОтветПробыНазываетИтогСловом() Экспорт

	Проверка = Стенд(Реестр()).Проверка;

	Дошла = Проверка.ОтветПробы(ИсходПробы(Истина, "ok", "HTTP 204")).Рендер();
	Ожидаем.Что(ТегСАтрибутом(Дошла, "data-sub-result=""ok"""), "успех помечен").Заполнено();
	Ожидаем.Что(СтрНайти(Дошла, "Пробное дошло: HTTP 204") > 0, "и назван словами: " + Дошла).ЭтоИстина();

	НеДошла = Проверка.ОтветПробы(ИсходПробы(Истина, "err", "HTTP 503")).Рендер();
	Ожидаем.Что(ТегСАтрибутом(НеДошла, "data-sub-result=""err"""), "отказ цели помечен").Заполнено();
	Ожидаем.Что(СтрНайти(НеДошла, "Пробное не дошло: HTTP 503") > 0, "назван ответ цели: " + НеДошла).ЭтоИстина();

	Отбита = Проверка.ОтветПробы(ИсходПробы(Ложь, "", "Пробных отправок не больше 10 за час")).Рендер();
	Ожидаем.Что(СтрНайти(Отбита, "Пробных отправок не больше 10 за час") > 0, "причина отказа хаба").ЭтоИстина();

КонецПроцедуры

// Пульт пробует настройками формы, если форма их прислала (заведения — со всеми полями, включая
// секреты: проба без токена не дойдёт, и с отмеченными событиями — о первом из них проба, как
// и предпросмотр), и сохранёнными — если формы нет.
&Тест
Процедура ПультПробуетФормойАБезФормыСохранённым() Экспорт

	Раздел = Стенд(Реестр());
	Сервис = ВитринаСервис("https://hook.example.com/a", "вебхук", "");
	Пульт = Пульт(Раздел, Сервис, Новый ФейкПредпросмотрУведомления());
	Объект = Новый Структура("ТипОбъекта, Идентификатор", "пул", 1);

	Заведение = Разбор.Разобрать("тип_действия=telegram&chat-id=-100777&бот-токен=424242%3ATOKEN&событие_0=1");
	Исход = Пульт.Проба(Неопределено, Объект, "", Заведение);
	Ожидаем.Что(Исход.Сообщение, "итог пробы").Равно("HTTP 200");
	Ожидаем.Что(Сервис.ПоследняяПроба().Вид, "проба формы").Равно("форма");
	Ожидаем.Что(Сервис.ПоследняяПроба().Ввод.Токен, "токен формы ушёл в пробу").Равно("424242:TOKEN");
	Ожидаем.Что(Сервис.ПоследняяПроба().ТипыСобытий, "и отмеченные события формы")
		.Равно(Пульт.ТипыИзФормы(Заведение));
	Ожидаем.Что(Сервис.ПоследняяПроба().ТипыСобытий, "КОНТРОЛЬ: событие отмечено").Равно("package.version.published");

	Пульт.Проба(Неопределено, Объект, "7", Новый Соответствие());
	Ожидаем.Что(Сервис.ПоследняяПроба().Вид, "без формы — сохранённые настройки").Равно("сохранённая");

	Ожидаем.Что(Пульт.Проба(Неопределено, Объект, "99", Заведение).НеНайдено, "чужая подписка — 404").ЭтоИстина();
	Для Каждого Негодный Из СтрРазделить("0,abc,-7,7x", ",") Цикл
		Ожидаем.Что(Пульт.Проба(Неопределено, Объект, Негодный, Заведение).НеНайдено,
			СтрШаблон("адрес правки «%1» — 404, а не проба окна новой подписки", Негодный)).ЭтоИстина();
		Ожидаем.Что(Пульт.Уведомление(Неопределено, Объект, Негодный, Заведение).НеНайдено,
			СтрШаблон("и у предпросмотра «%1» — 404", Негодный)).ЭтоИстина();
	КонецЦикла;

	Пусто = Пульт.Проба(Неопределено, Объект, "", Разбор.Разобрать("тип_действия=telegram&бот-токен=1%3AA"));
	Ожидаем.Что(Пусто.Успех, "проба без чата не уходит").ЭтоЛожь();
	Ожидаем.Что(Пусто.Отказы.Получить("chat-id"), "отказ — под полем чата").Заполнено();

КонецПроцедуры

// Пульт отдаёт текст, ничего не сохраняя: ввод без секретов, чужая подписка — как несуществующая.
&Тест
Процедура ПредпросмотрПультаНеСохраняетИНеБерётСекретов() Экспорт

	Раздел = Стенд(Реестр());
	Предпросмотр = Новый ФейкПредпросмотрУведомления();
	Предпросмотр.ЗадатьСообщение("OpenHub: образец");
	Пульт = Пульт(Раздел, ВитринаСервис("https://hook.example.com/a", "вебхук", ""), Предпросмотр);
	Форма = Разбор.Разобрать("тип_действия=telegram&chat-id=-100777&бот-токен=424242%3ATOKEN"
		+ "&%D1%88%D0%B0%D0%B1%D0%BB%D0%BE%D0%BD-%D1%82%D0%B5%D0%BA%D1%81%D1%82%D0%B0={пакет}");
	Объект = Новый Структура("ТипОбъекта, Идентификатор", "пул", 1);

	Исход = Пульт.Уведомление(Неопределено, Объект, "", Форма);
	Ожидаем.Что(Исход.Текст, "текст отдан: " + Исход.Ошибка).Равно("OpenHub: образец");
	Ожидаем.Что(Предпросмотр.ПоследнийВвод().Свойство("Токен"), "токен в предпросмотр не попал").ЭтоЛожь();
	Ожидаем.Что(Предпросмотр.ПоследнийВвод().Шаблон, "шаблон — из формы").Равно("{пакет}");

	Ожидаем.Что(Пульт.Уведомление(Неопределено, Объект, "7", Форма).НеНайдено, "своя подписка 7 найдена")
		.ЭтоЛожь();
	Ожидаем.Что(Пульт.Уведомление(Неопределено, Объект, "99", Форма).НеНайдено,
		"подписки 99 у объекта нет — 404").ЭтоИстина();

КонецПроцедуры

// Форма правки старой вкладки несла поле включённости — пульт узнаёт её, окно правки такого поля
// не печатает.
&Тест
Процедура ФормуСтаройВкладкиПультУзнаёт() Экспорт

	Пульт = Пульт(Стенд(Реестр()), ВитринаСервис("https://hook.example.com/a", "вебхук", ""),
		Новый ФейкПредпросмотрУведомления());

	Ожидаем.Что(Пульт.ФормаУстарела(Разбор.Разобрать("тип_действия=вебхук&включить=1")), "старая вкладка").ЭтоИстина();
	Ожидаем.Что(Пульт.ФормаУстарела(Разбор.Разобрать("тип_действия=вебхук&url=x")), "окно правки").ЭтоЛожь();
	Ожидаем.Что(Пульт.ОтказУстаревшей().Код, "отказ — 400").Равно(400);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Значение атрибута тега в разметке кита: кавычки и угловые скобки в нём экранированы.
Функция ЗначениеАтрибута(Знач Тег, Знач Имя)
	Маркер = " " + Имя + "=""";
	Хвост = Сред(ХвостПосле(Тег, Маркер), СтрДлина(Маркер) + 1);
	Значение = Лев(Хвост, СтрНайти(Хвост, """") - 1);
	Значение = СтрЗаменить(Значение, "&quot;", """");
	Значение = СтрЗаменить(Значение, "&#39;", "'");
	Значение = СтрЗаменить(Значение, "&lt;", "<");
	Значение = СтрЗаменить(Значение, "&gt;", ">");
	Возврат СтрЗаменить(Значение, "&amp;", "&");
КонецФункции

Функция Реестр()

	Доставки = Новый Массив();
	Доставки.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-1"));
	Доставки.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-2"));

	Хранения = Новый Массив();
	Хранения.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-3"));
	Хранения.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-4"));

	// рендеры — НАСТОЯЩИЕ: доставку и хранение подменяем пробным типом, предмет проверки — форма
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());
	Рендеры.Добавить(Новый РендерНастроекTelegram(Новый ШаблонУведомления(Неопределено)));

	Возврат Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры);

КонецФункции

// Реестр боевых типов ПЛЮС сторонний тип одной фикстурой (все три контракта в ней же).
Функция РеестрС(Знач Проба)

	Доставки = Новый Массив();
	Доставки.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-1"));
	Доставки.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-2"));
	Доставки.Добавить(Проба);

	Хранения = Новый Массив();
	Хранения.Добавить(Новый ПробныйТипДействия("вебхук", "не-используется-3"));
	Хранения.Добавить(Новый ПробныйТипДействия("telegram", "не-используется-4"));
	Хранения.Добавить(Проба);

	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());
	Рендеры.Добавить(Новый РендерНастроекTelegram(Новый ШаблонУведомления(Неопределено)));
	Рендеры.Добавить(Проба);

	Возврат Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры);

КонецФункции

Функция Сообщение(Знач Текст, Знач АдресПревью = "", Знач Ошибка = "")
	Возврат Новый Структура("Текст, АдресПревью, Ошибка", Текст, АдресПревью, Ошибка);
КонецФункции

// Исход пробы пульта: удача несёт ответ цели и его вид, отказ — причину в Сообщении.
Функция ИсходПробы(Знач Успех, Знач Вид, Знач Сообщение)
	Исход = Новый Структура("Успех, Код, Сообщение, Отказы, Секрет, НеНайдено, ВидСообщения",
		Успех, ?(Успех, 200, 400), Сообщение, Новый Соответствие(), "", Ложь, Вид);
	Возврат Исход;
КонецФункции

// Имя флажка «секрет свой» из HTML: во фрагменте полей типа флажок один, name стоит ПОСЛЕ type="checkbox".
// Тег флажка, за которым стоит подпись: «<input …>» перед «<span class="field__label">Подпись</span>».
Функция ФлажокПодписи(Знач HTML, Знач Подпись)

	Позиция = СтрНайти(HTML, "<span class=""field__label"">" + Подпись + "</span>");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	До = Лев(HTML, Позиция - 1);
	Начало = СтрНайти(До, "<input", НаправлениеПоиска.СКонца);
	Возврат ?(Начало = 0, "", Сред(До, Начало));

КонецФункции

Функция ИмяФлажкаИзРазметки(Знач Разметка)

	Позиция = СтрНайти(Разметка, "type=""checkbox""");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Позиция);
	Начало = СтрНайти(Хвост, "name=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Имя = Сред(Хвост, Начало + СтрДлина("name="""));
	Возврат Лев(Имя, СтрНайти(Имя, """") - 1);

КонецФункции

// Стенд витрины над реестром типов; каталог проверяет декларации плагинов на сборке.
Функция Стенд(Знач Реестр, Знач Сервис = Неопределено)
	Возврат Новый СтендВитриныПодписок(UI, ?(Сервис = Неопределено, Новый ФейкСервисПодписок(), Сервис), Реестр);
КонецФункции

Функция Пульт(Знач Раздел, Знач Сервис, Знач Предпросмотр)
	Возврат Новый ПультПодписок(Разбор, Новый ТекстСбояЗаглушка(), Сервис, Раздел.Разбор, Раздел.Имена,
		Новый ПриведениеЧисел(), Неопределено, Неопределено, Неопределено, Предпросмотр, Неопределено,
		Неопределено, UI.Тексты);
КонецФункции

Функция ВитринаСервис(Знач URL, Знач ТипДействия, Знач Секрет, Знач Токен = "", Знач Шаблон = "")

	Сервис = Новый ФейкСервисПодписок();
	Хранилище = Новый ФейкХранилищеВебхуков();

	Запись = Новый ФейкВебхукЗапись(Хранилище);
	Запись.Идентификатор = 7;
	Запись.URL = URL;
	Запись.ТипДействия = ТипДействия;
	Запись.Секрет = Секрет;
	Запись.ТокенДействия = Токен;
	Запись.ШаблонТекста = Шаблон;
	Запись.ТипыСобытий = "package.version.published";
	Запись.Активен = Истина;
	Сервис.ДобавитьПодписку(Запись);

	Возврат Сервис;

КонецФункции

// Открывающий тег, в котором стоит атрибут; "" — такого нет.
Функция ТегСАтрибутом(Знач HTML, Знач Атрибут)
	Позиция = СтрНайти(HTML, Атрибут);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Лев(HTML, Позиция), "<", НаправлениеПоиска.СКонца);
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

// Открывающие теги панелей сегментов кита в порядке разметки.
Функция ПанелиСегментов(Знач HTML)
	Результат = Новый Массив();
	Остаток = HTML;
	Позиция = СтрНайти(Остаток, "class=""segments-panel""");
	Пока Позиция > 0 Цикл
		Результат.Добавить(ТегСАтрибутом(Остаток, "class=""segments-panel"""));
		Остаток = Сред(Остаток, Позиция + 1);
		Позиция = СтрНайти(Остаток, "class=""segments-panel""");
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Хвост разметки после маркера — чтобы смотреть форму заведения отдельно от карточек.
Функция ХвостПосле(Знач HTML, Знач Маркер)
	Позиция = СтрНайти(HTML, Маркер);
	Возврат ?(Позиция = 0, "", Сред(HTML, Позиция));
КонецФункции

Функция СодержитТип(Знач Типы, Знач Искомый)
	Для Каждого Вариант Из Типы Цикл
		Если Вариант.Тип = Искомый Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Разметка открытых окон: <dialog …open> до своего </dialog>.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Если СтрНайти(Лев(Окно, СтрНайти(Окно, ">")), " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Набор полей сегмента: от его панели до панели следующего.
Функция НаборСегмента(Знач HTML, Знач Значение)
	Набор = ХвостПосле(HTML, "data-segment=""" + Значение + """");
	Следующий = СтрНайти(Набор, "data-segment=""", , 2);
	Возврат ?(Следующий = 0, Набор, Лев(Набор, Следующий - 1));
КонецФункции

// Запись реестра с этим именем: от её <li class="entry"> до следующей.
Функция ЗаписьРеестра(Знач HTML, Знач Имя)

	Хвост = HTML;
	Позиция = СтрНайти(Хвост, "<li class=""entry""");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Следующая = СтрНайти(Хвост, "<li class=""entry""", , 2);
		Запись = ?(Следующая = 0, Хвост, Лев(Хвост, Следующая - 1));
		// окна стоят соседями списка: последняя запись кончается до них
		Окно = СтрНайти(Запись, "<dialog");
		Запись = ?(Окно = 0, Запись, Лев(Запись, Окно - 1));
		Если СтрНайти(Запись, ">" + Имя + "<") > 0 Тогда
			Возврат Запись;
		КонецЕсли;
		Позиция = Следующая;
	КонецЦикла;
	Возврат "";

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Позиция = СтрНайти(HTML, "<" + Имя + " ");
	Пока Позиция > 0 Цикл
		Хвост = Сред(HTML, Позиция);
		Тег_ = Лев(Хвост, СтрНайти(Хвост, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
		Позиция = СтрНайти(HTML, "<" + Имя + " ", , Позиция + 1);
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)
	Хвост = ХвостПосле(HTML, Начало);
	Позиция = СтрНайти(Хвост, Конец);
	Возврат ?(Позиция = 0, Хвост, Лев(Хвост, Позиция + СтрДлина(Конец) - 1));
КонецФункции

Функция АдресОкна(Знач Раздел, Знач Окно)
	Возврат Раздел + "?" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку(Окно, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Процедура ПроверитьКлюч(Плохие, Знач Где, Знач Ключ, Знач Обязателен)

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Если Обязателен Тогда
			Плохие.Добавить(Где + ": ключ не задан");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Значение = UI.Тексты.Текст(Ключ);
	Если Значение = UI.Тексты.Маркер(Ключ) Тогда
		Плохие.Добавить(Где + ": ключа «" + Ключ + "» нет в словаре");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
