// Заявки на публикацию — страница кабинета /me/inbox и раздел «Входящие» дома «Пул»: таблица с ⚙
// в строке, окна одобрения и отклонения по адресу, решение формой окна только с подтверждением,
// старая вкладка — отказ без решения; настоящими контроллерами поверх настоящего рассмотрения заявок.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем Засев;          // фикстура ЗасевРеестра — пул службой хаба
Перем Учётки;         // фикстура СтендУчёток — учётка и роль на пуле
Перем Принципалы;     // фикстура СтендПринципалов
Перем Входящие;       // фикстура СтендВходящих — заявка службой хаба
Перем Гвард;          // ГвардПринципалаЗаглушка — впускает мейнтейнера либо никого
Перем Кабинет;        // КонтроллерЛичногоПространства — /me/inbox
Перем ДомПула;        // КонтроллерДомаПула — /pools/{pool}/settings/inbox
Перем Пул;            // пул заявок
Перем Мейнтейнер;     // мейнтейнер пула — тот, кто решает

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("КонтейнерПубликации");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	Контейнер = Новый КонтейнерПубликации(ПоискКлассов, Модули);

	Контейнер.ПодключитьСоседей();
	ПоискКлассов.ПодключитьРеализации(Модули, "ПоследствияУдаленияПула, ПоследствияУдаленияПакета");
	Контейнер.ПодключитьПубликацию("СервисВходящих, СтражИздателейCI, МаскаРефа, КороткаяФормаДоверия,"
		+ " ИмяЗаписиДоверия, ВидРефаДоверия, СрокТокенаCI, АудиторияТокенаCI, ЗапускКонвейераCI, СервисДоверияCI,"
		+ " СервисПубликации, РассмотрениеВходящих, СервисРезервированияИмён");
	ПоискКлассов.Подключить(Модули, "ПоводыУведомлений");

	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);
	Слои.Подключить("интерфейс/общее");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("ДомПула,ВитринаЗаявокПула,ПультЗаявок", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

	Для Каждого Фикстура Из СтрРазделить("ЗасевРеестра, СтендУчёток, СтендПринципалов, СтендВходящих,"
		+ " ЖурналАудитаФайлом, ФейкПроверяющийGitHub, НастройкиЗаглушка, ФейкПроверяющийПодписиCI,"
		+ " ЗаписывающийПодписчик, ЛовушкаЛога, ФейкКаналаУведомлений, ГвардПринципалаЗаглушка,"
		+ " ЗащитаCSRFЗаглушка, ОтветСтраницыЗаглушка, КукиЗаглушка, СборкаUI", ",") Цикл
		РеестрФикстур.Подключить(СокрЛП(Фикстура));
	КонецЦикла;

	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-inbox-screen");
	Поделка = Контейнер.Собрать("экран-заявок-тесты", КореньХранилища);

	Засев = Новый ЗасевРеестра(Поделка);
	Учётки = Новый СтендУчёток(Поделка);
	Принципалы = Новый СтендПринципалов(Поделка);
	Входящие = Новый СтендВходящих(Поделка);

	Пул = Засев.ПулСервисом();
	Мейнтейнер = Учётки.УчёткаСРолью(Пул);
	Гвард = Новый ГвардПринципалаЗаглушка();
	ВпуститьМейнтейнера();

	// контроллеры — типом после сборки: winow в юнит-контейнере нет, и ОСень не должна видеть
	// их аннотации; страницу печатает каркас кита без обрамления хаба
	ПоискКлассов.Подключить(Интерфейс, "ВитринаДомаПула");
	ПоискКлассов.Подключить(Интерфейс, "КонтроллерДомаПула");
	ПоискКлассов.Подключить(Интерфейс, "КонтроллерЛичногоПространства");

	UI = Новый СборкаUI().Собрать(Интерфейс);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Новый СборкаДомаНастроек(UI.Кит, UI.Модели),
		Желудь("СервисПрав"), UI.Тексты, Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));

	Кабинет = Новый КонтроллерЛичногоПространства(Гвард, Ответы, Защита, Гейт, Желудь("РазборФормы"),
		Желудь("ОкноРаздела"), Желудь("РассмотрениеВходящих"), Желудь("ВитринаЗаявокПула"),
		Желудь("ПультЗаявок"), Неопределено, Неопределено, Неопределено, Желудь("ТекстыИнтерфейса"),
		Желудь("АдресаКабинета"));

	// витрина дома — только с ветвью «Входящие»: прочие разделы в этом наборе не открываются
	ВитринаДома = Новый ВитринаДомаПула(Желудь("Кит"), Желудь("ДомПула"),
		Желудь("СервисПулов"), Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		Желудь("ВитринаЗаявокПула"), Неопределено, Желудь("РассмотрениеВходящих"),
		Желудь("ТекстыИнтерфейса"), Неопределено, Желудь("ОкноРаздела"));
	ДомПула = Новый КонтроллерДомаПула(Гвард, Ответы, Желудь("ТекстСбоя"), Желудь("ДомПула"), ВитринаДома,
		Гейт, Защита, Желудь("РазборФормы"), Желудь("СервисПулов"), Неопределено, Неопределено,
		Желудь("ПультЗаявок"), Неопределено, Неопределено, Желудь("ИтогПульта"),
		Желудь("ТекстыИнтерфейса"), Желудь("ОтметкаСохранения"), Желудь("ОкноРаздела"));

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

&ПослеКаждого
Процедура ВернутьГвард() Экспорт
	ВпуститьМейнтейнера();
КонецПроцедуры

#Область Окна

// Окно одобрения по адресу — открытым, с карточкой заявки и формой на страницу заявок; без
// параметра окна открытых окон нет, а ⚙ строки ведёт на адрес окна.
&Тест
Процедура ОкноОдобренияПоАдресуПечатаетсяОткрытымСКарточкой() Экспорт

	Номер = Номер(Подать());

	Страница = ПолучитьКабинет("одобрить-" + Номер);

	Ожидаем.Что(Страница.Код, "страница с окном отдана").Равно(200);
	Открытые = ОткрытыеОкна(Страница.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто ровно одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "форма окна уходит на страницу заявок").Содержит("action=""/me/inbox""");
	Ожидаем.Что(Открытые[0], "форма несёт операцию").Содержит("value=""одобрить""");
	Ожидаем.Что(Открытые[0], "и номер заявки").Содержит("value=""" + Номер + """");
	Ожидаем.Что(Открытые[0], "решение подтверждено кнопкой окна").Содержит("name=""confirmed"" value=""1""");
	Ожидаем.Что(Открытые[0], "на карточке — sha256 целиком").Содержит("sha256");

	// КОНТРОЛЬ: без параметра окна окон нет, а пункт меню строки ведёт на адрес окна
	Раздел = ПолучитьКабинет("").ТелоТекст;
	Ожидаем.Что(ОткрытыеОкна(Раздел).Количество(), "без ?окно= окна закрыты").Равно(0);
	Ожидаем.Что(Раздел, "⚙ строки ведёт на окно одобрения")
		.Содержит(Закодировать("окно") + "=" + Закодировать("одобрить-" + Номер));
	Ожидаем.Что(Раздел, "и на окно отклонения")
		.Содержит(Закодировать("окно") + "=" + Закодировать("отклонить-" + Номер));

КонецПроцедуры

// Отклонение — подтверждение опасного вида с полем причины, которую увидит заявитель.
&Тест
Процедура ОкноОтклоненияПоАдресуСпрашиваетПричину() Экспорт

	Номер = Номер(Подать());

	Открытые = ОткрытыеОкна(ПолучитьКабинет("отклонить-" + Номер).ТелоТекст);

	Ожидаем.Что(Открытые.Количество(), "открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это подтверждение").Содержит("modal--confirm");
	Ожидаем.Что(Открытые[0], "с полем причины").Содержит("name=""причина""");
	Ожидаем.Что(Открытые[0], "операция — отклонить").Содержит("value=""отклонить""");

КонецПроцедуры

// Окно заявки, которой смотрящему не видно, и незнакомый вид окна — страница без окна.
&Тест
Процедура ОкноЧужойИлиНеизвестнойЗаявкиНеОткрывается() Экспорт

	Чужая = Номер(Подать(Засев.ПулСервисом()));
	Своя = Номер(Подать());

	Ожидаем.Что(ОткрытыеОкна(ПолучитьКабинет("одобрить-" + Чужая).ТелоТекст).Количество(),
		"заявка пула, где смотрящий никто, окна не открывает").Равно(0);
	Ожидаем.Что(ОткрытыеОкна(ПолучитьКабинет("одобрить-999999").ТелоТекст).Количество(),
		"несуществующая — тоже").Равно(0);
	Ожидаем.Что(ОткрытыеОкна(ПолучитьКабинет("удалить-" + Своя).ТелоТекст).Количество(),
		"вида «удалить» у заявок нет").Равно(0);
	Ожидаем.Что(ОткрытыеОкна(ПолучитьКабинет("одобрить-" + Своя).ТелоТекст).Количество(),
		"КОНТРОЛЬ: своя открывается").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Решение

// Без скрипта форма из меню уходит без вопроса: решение не принимается, ответ ведёт на окно.
&Тест
Процедура РешениеБезПодтвержденияВедётНаОкноИЗаявкаЦела() Экспорт

	Заявка = Подать();
	Номер = Номер(Заявка);

	Ответ = ОтправитьКабинет("операция=отклонить&заявка=" + Номер);

	Ожидаем.Что(Ответ.Код, "ответ — перенаправление").Равно(303);
	Ожидаем.Что(Раскодировать(Ответ.ПутьРедиректа), "на окно отклонения этой заявки")
		.Равно("/me/inbox?окно=отклонить-" + Номер);
	Ожидаем.Что(Ожидает(Заявка), "заявка ждёт решения").ЭтоИстина();

КонецПроцедуры

// Подтверждённое отклонение стирает заявку, заявитель получает причину; ответ — на список.
&Тест
Процедура ПодтверждённоеОтклонениеРешаетЗаявкуИНазываетПричину() Экспорт

	Заявка = Подать();
	Канал = Желудь("СлужбаЛичныхУведомлений");
	Было = Канал.Количество();

	Ответ = ОтправитьКабинет("операция=отклонить&заявка=" + Номер(Заявка) + "&confirmed=1&причина="
		+ Закодировать("нет README"));

	Ожидаем.Что(Ответ.Код, "удача — перенаправление").Равно(303);
	Ожидаем.Что(СтрНачинаетсяС(Ответ.ПутьРедиректа, "/me/inbox?"), "на список заявок: " + Ответ.ПутьРедиректа)
		.ЭтоИстина();
	Ожидаем.Что(Состояние(Заявка), "заявка отклонена").Равно(Заявка.СостояниеОтклонена());
	Ожидаем.Что(Канал.Количество(), "заявителю сказано").Равно(Было + 1);
	Ожидаем.Что(Канал.Последнее().Текст, "и названа причина").Содержит("нет README");

КонецПроцедуры

// Отказ домена по открытому окну (заявка уже решена в другой вкладке) — 4xx и причина; окна нет,
// потому что заявки среди ждущих больше нет.
&Тест
Процедура РешениеПоУжеРешённойЗаявкеНазываетПричину() Экспорт

	Заявка = Подать();
	ОтправитьКабинет("операция=отклонить&заявка=" + Номер(Заявка) + "&confirmed=1");

	Ответ = ОтправитьКабинет("операция=отклонить&заявка=" + Номер(Заявка) + "&confirmed=1");

	Ожидаем.Что(Ответ.Код >= 400, "повтор — отказ, код " + Ответ.Код).ЭтоИстина();
	Ожидаем.Что(Ответ.ТелоТекст, "причина названа").Содержит("уже рассмотрена");
	Ожидаем.Что(ОткрытыеОкна(Ответ.ТелоТекст).Количество(), "окна решённой заявки нет").Равно(0);

КонецПроцедуры

// Шаг подтверждения прежней страницы нёс номер полем «подтверждение»: форма старой вкладки —
// 400 «Страница устарела», решение не принимается.
&Тест
Процедура ФормаСтаройВкладкиОтвечает400БезРешения() Экспорт

	Заявка = Подать();
	Номер = Номер(Заявка);

	Ответ = ОтправитьКабинет("операция=отклонить&заявка=" + Номер + "&подтверждение=" + Номер);

	Ожидаем.Что(Ответ.Код, "старая вкладка — 400").Равно(400);
	Ожидаем.Что(Ответ.ТелоТекст, "причина названа").Содержит("Страница устарела");
	Ожидаем.Что(Ожидает(Заявка), "заявка ждёт решения").ЭтоИстина();

	// КОНТРОЛЬ: та же операция формой окна решает
	ОтправитьКабинет("операция=отклонить&заявка=" + Номер + "&confirmed=1");
	Ожидаем.Что(Ожидает(Заявка), "КОНТРОЛЬ: форма окна решает").ЭтоЛожь();

КонецПроцедуры

// Неизвестная операция — отказ без решения, даже подтверждённая.
&Тест
Процедура НеизвестнаяОперацияОтвечает400БезРешения() Экспорт

	Заявка = Подать();

	Ответ = ОтправитьКабинет("операция=удалить&заявка=" + Номер(Заявка) + "&confirmed=1");

	Ожидаем.Что(Ответ.Код, "неизвестная операция — 400").Равно(400);
	Ожидаем.Что(Ожидает(Заявка), "заявка ждёт решения").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ДомПула

// Раздел «Входящие» дома «Пул»: окно по адресу раздела, форма — на раздел, вопрос без
// подтверждения — переходом на окно, подтверждённое решение — переходом на раздел.
&Тест
Процедура РазделПулаРешаетЗаявкуОкномПоАдресу() Экспорт

	Заявка = Подать();
	Номер = Номер(Заявка);
	Раздел = "/pools/" + Пул.Имя + "/settings/inbox";

	Открытые = ОткрытыеОкна(ПолучитьПул("отклонить-" + Номер).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно отклонения открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "форма — на раздел пула").Содержит("action=""" + Раздел + """");

	Вопрос = ОтправитьПул("операция=отклонить&заявка=" + Номер);
	Ожидаем.Что(Раскодировать(Вопрос.ПутьРедиректа), "без подтверждения — на окно")
		.Равно(Раздел + "?окно=отклонить-" + Номер);
	Ожидаем.Что(Ожидает(Заявка), "заявка ждёт решения").ЭтоИстина();

	Готово = ОтправитьПул("операция=отклонить&заявка=" + Номер + "&confirmed=1");
	Ожидаем.Что(СтрНачинаетсяС(Готово.ПутьРедиректа, Раздел), "удача — на раздел: " + Готово.ПутьРедиректа)
		.ЭтоИстина();
	Ожидаем.Что(Ожидает(Заявка), "заявка решена").ЭтоЛожь();

КонецПроцедуры

// Раздел пула решает только свои заявки: номер заявки соседнего пула — отказ без решения.
&Тест
Процедура РазделПулаНеРешаетЗаявкуСоседнегоПула() Экспорт

	Сосед = Засев.ПулСервисом();
	Учётки.РольВПуле(Сосед, Мейнтейнер);
	Чужая = Подать(Сосед);

	Ответ = ОтправитьПул("операция=отклонить&заявка=" + Номер(Чужая) + "&confirmed=1");

	Ожидаем.Что(Ответ.Код, "заявка соседнего пула — отказ").Равно(400);
	Ожидаем.Что(Ожидает(Чужая), "и она ждёт решения").ЭтоИстина();

КонецПроцедуры

// Заявка пула, где смотрящий не мейнтейнер, неотличима от несуществующей: обе двери отвечают 404
// «Заявка не найдена» без имени пула, заявка ждёт. КОНТРОЛЬ — номер, которого нет, отвечает тем же.
&Тест
Процедура ЧужаяЗаявкаНеОтличимаОтНесуществующей() Экспорт

	Тайный = Засев.ПулСервисом();
	Желудь("СервисПулов").УстановитьВидимость(Тайный.Идентификатор, "private");
	Чужая = Подать(Тайный);
	Ненайдена = Желудь("ТекстыИнтерфейса").Текст("settings.inbox.error.missing");

	Ответы = Новый Массив();
	Ответы.Добавить(ОтправитьКабинет("операция=одобрить&заявка=" + Номер(Чужая) + "&confirmed=1"));
	Ответы.Добавить(ОтправитьПул("операция=одобрить&заявка=" + Номер(Чужая) + "&confirmed=1"));
	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(Ответ.Код, "чужая заявка — 404").Равно(404);
		Ожидаем.Что(Ответ.ТелоТекст, "причина нейтральная").Содержит(Ненайдена);
		Ожидаем.Что(Ответ.ТелоТекст, "имени пула в ответе нет").Не_().Содержит(Тайный.Имя);
	КонецЦикла;
	Ожидаем.Что(Ожидает(Чужая), "заявка ждёт решения").ЭтоИстина();

	// КОНТРОЛЬ: несуществующий номер отвечает тем же кодом и теми же словами
	Нет = ОтправитьКабинет("операция=одобрить&заявка=987654&confirmed=1");
	Ожидаем.Что(Нет.Код, "КОНТРОЛЬ: несуществующая — 404").Равно(404);
	Ожидаем.Что(Нет.ТелоТекст, "КОНТРОЛЬ: те же слова").Содержит(Ненайдена);

КонецПроцедуры

#КонецОбласти

#Область Гвард

// Обе двери решения стережёт гвард: кого он не впустил, тот заявку не решает — 403 без тела,
// заявителю ничего не сказано. КОНТРОЛЬ — впущенный той же формой решает.
&Тест
Процедура ДвериРешенияНеРешаютТогоКогоГвардНеВпустил() Экспорт

	Заявка = Подать();
	Форма = "операция=отклонить&заявка=" + Номер(Заявка) + "&confirmed=1";
	Канал = Желудь("СлужбаЛичныхУведомлений");
	Было = Канал.Количество();

	Гвард.НеВпускать();
	Ответы = Новый Массив();
	Ответы.Добавить(ОтправитьКабинет(Форма));
	Ответы.Добавить(ОтправитьПул(Форма));
	ВпуститьМейнтейнера();

	Для Каждого Ответ Из Ответы Цикл
		Ожидаем.Что(Ответ.Код, "гвард не впустил — 403").Равно(403);
		Ожидаем.Что(Строка(Ответ.ТелоТекст), "гвард не впустил — без тела").Равно("");
	КонецЦикла;
	Ожидаем.Что(Ожидает(Заявка), "заявка ждёт решения").ЭтоИстина();
	Ожидаем.Что(Канал.Количество(), "заявителю ничего не сказано").Равно(Было);

	// КОНТРОЛЬ: впущенный той же формой решает
	ОтправитьКабинет(Форма);
	Ожидаем.Что(Ожидает(Заявка), "КОНТРОЛЬ: впущенный решает").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Процедура ВпуститьМейнтейнера()
	Гвард.Впустить(Мейнтейнер, Принципалы.Сессия(Мейнтейнер), Пул);
КонецПроцедуры

// У заявителя предел ждущих заявок: каждая заявка набора — от своего заявителя.
Функция Подать(Знач ВПул = Неопределено)
	Возврат Входящие.ЗаявкаСлужбой(?(ВПул = Неопределено, Пул, ВПул), Учётки.Учётка());
КонецФункции

Функция Номер(Знач Заявка)
	Возврат Формат(Заявка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция Состояние(Знач Заявка)
	Возврат Желудь("СервисВходящих").Заявка(Заявка.Идентификатор).Состояние;
КонецФункции

Функция Ожидает(Знач Заявка)
	Возврат Состояние(Заявка) = Заявка.СостояниеОжидает();
КонецФункции

Функция ПолучитьКабинет(Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Кабинет.ВходящиеЗаявки(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

Функция ОтправитьКабинет(Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Кабинет.ВходящиеЗаявки(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

Функция ПолучитьПул(Знач Окно)
	Ответ = Новый ОтветСтраницыЗаглушка();
	ДомПула.Раздел(Ответ, Пул.Имя, "inbox", Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

Функция ОтправитьПул(Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	ДомПула.Раздел(Ответ, Пул.Имя, "inbox", Новый Соответствие(), Новый КукиЗаглушка(), "POST",
		"_csrf=токен-теста&" + Тело);
	Возврат Ответ;
КонецФункции

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
