// Раздел «Подписки на события» трёх домов на механизме «⚙ записи + окно по адресу + подтверждение»:
// окно новой подписки на странице и по адресу, отбитая форма в открытом окне, секрет подписи один
// раз окном, правка без смены включённости, удаление через подтверждение с именем, тумблер, проба
// и предпросмотр без скрипта, «Подписки сверху» с окном сужения, спойлер «Настройки доставки» —
// настоящими контроллерами поверх настоящих служб подписок в контейнере. Гвард не впустил — ни одна
// дверь не меняет домен.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;       // общий контейнер набора
Перем Засев;         // фикстура ЗасевРеестра — пулы и пакеты
Перем Учётки;        // фикстура СтендУчёток — админ хаба и хозяева пулов
Перем Гвард;         // ГвардЭкранаПодписок — один на три дома
Перем КонтроллерХаба;   // КонтроллерПодписокХаба
Перем КонтроллерПула;   // КонтроллерПодписокПула
Перем КонтроллерПакета; // КонтроллерПодписокПакета
Перем Админ;         // учётка администратора хаба
Перем НомерЧата;     // Число — у каждой подписки свой чат: дубль адреса домен не принимает
Перем Разметка_;     // фикстура НастройкаВРазметке — поле настройки и его форма сброса

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = КаталогиПроекта.Модули();
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);
	ПодключитьСлои(Модули);

	РеестрФикстур.Подключить("ГвардЭкранаПодписок");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ПорогРазделаПакетаЗаглушка");
	РеестрФикстур.Подключить("ГалкиВРазметке");
	РеестрФикстур.Подключить("НастройкаВРазметке");
	Разметка_ = Новый НастройкаВРазметке();

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "экран-подписок-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Поделка = Новый Поделка(СоветНабора.БезФайлаНастроек(Детальки));
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Учётки = Новый СтендУчёток(Поделка);
	Админ = Учётки.Учётка("admin");

	СобратьКонтроллеры(Модули);

КонецПроцедуры

// Слои подписок — как у наборов домена подписок, без фоновой доставки; сверху — раздел экрана.
Процедура ПодключитьСлои(Знач Модули)

	Слои.Подключить("данные");
	Слои.Подключить("хранилище, публикация, реестр, основа, состояние/телеметрия, события");
	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));
	Слои.Подключить("почта");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ОбезличиваниеЖурнала");
	Слои.Подключить("уведомления, вход, права, настройки");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "ТаймаутыHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "СессияИсходящегоHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "КлиентHTTP.os"));
	Слои.ПропускатьТакже("Очередь, Доставщик, Подписчик");
	Слои.Подключить("подписки");

	Интерфейс = ОбъединитьПути(Модули, "интерфейс", "Классы");
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	Слои.Подключить("интерфейс/панели/подписки");
	Для Каждого Имя Из СтрРазделить("ОкноРаздела,ОтметкаСохранения,ОтветыНастроек,СборкаДомаНастроек,"
		+ "ГейтФормы,РазборФормы,ТекстСбоя,ДомХаба,ДомПула,ДомПакета,АдресаКаталога,ВитринаНастроек,ПоляНастроек,"
		+ "ПультЗначенийНастроек,РаскладкаНастроекХаба,ВитринаДоставки,КонтроллерПодписокХаба,"
		+ "КонтроллерПодписокПула,КонтроллерПодписокПакета", ",") Цикл
		ПоискКлассов.Подключить(Интерфейс, Имя);
	КонецЦикла;

КонецПроцедуры

Процедура СобратьКонтроллеры(Знач Модули)

	// страницу печатает каркас кита без обрамления хаба: экрану нужен дом, а не шапка
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	Сборка = Новый СборкаДомаНастроек(UI.Кит, UI.Модели);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, Сборка, Желудь("СервисПрав"), UI.Тексты,
		Новый МетодыHTTP(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Защита = Новый ЗащитаCSRFЗаглушка();
	Гейт = Новый ГейтФормы(Ответы, Защита, Желудь("РазборФормы"));
	Гвард = Новый ГвардЭкранаПодписок();

	ДомПула = Новый ДомПула(Сборка, UI.Тексты, Новый АдресаСтраниц(), Новый АдресаКаталога());
	Порог = Новый ПорогРазделаПакетаЗаглушка(Ложь);
	ДомПакета = Новый ДомПакета(Сборка, ДомПула, Порог, Порог, UI.Тексты, Новый АдресаСтраниц());

	Ход = Новый ХодПодписок(Ответы, Желудь("ТекстыИнтерфейса"), Гейт, Желудь("ПультПодписок"),
		Желудь("ОкноРаздела"), Желудь("ВитринаПодписок"), Желудь("ВитринаПодписокСверху"),
		Желудь("СервисПодписок"), Желудь("ИменаПолейПодписки"), Желудь("ПроверкаПодпискиДоСохранения"),
		Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), Желудь("ОкноПолучателей"));

	КонтроллерХаба = Новый КонтроллерПодписокХаба(Гвард, Ответы, Новый ДомХаба(Сборка, UI.Тексты),
		Желудь("ВитринаПодписок"), Желудь("ВитринаДоставки"), Желудь("ВитринаНастроек"),
		Желудь("ПультЗначенийНастроек"), Ход, Гейт, Желудь("ОкноРаздела"), Защита, Желудь("СервисПодписок"),
		Желудь("ТекстыИнтерфейса"));
	КонтроллерПула = Новый КонтроллерПодписокПула(Гвард, Защита, Желудь("СервисПулов"), Желудь("СервисПодписок"),
		Желудь("СервисПрав"), Ответы, ДомПула, Желудь("ВитринаПодписок"), Желудь("ВитринаПодписокСверху"), Ход,
		Желудь("ТекстыИнтерфейса"));
	КонтроллерПакета = Новый КонтроллерПодписокПакета(Гвард, Ответы, ДомПакета, Желудь("ВитринаПодписок"),
		Желудь("ВитринаПодписокСверху"), Ход, Защита, Желудь("СервисПодписок"), Желудь("ТекстыИнтерфейса"));

КонецПроцедуры

#Область ОкноНовой

// Окно новой подписки стоит на странице закрытым, кнопка «Добавить подписку» в шапке секции —
// ссылка на ?окно=новая; по этому адресу то же окно приходит открытым.
&Тест
Процедура ОкноНовойСтоитНаСтраницеИОткрываетсяПоАдресу() Экспорт

	Страница = ПолучитьХаб("").ТелоТекст;
	Ожидаем.Что(Страница, "окно новой подписки на странице").Содержит("id=""podpiska-novaya""");
	Ожидаем.Что(ОткрытыеОкна(Страница).Количество(), "и закрыто").Равно(0);
	Ожидаем.Что(Страница, "кнопка «Добавить подписку» — ссылка на окно по адресу")
		.Содержит("href=""" + АдресОкна(РазделХаба(), "новая") + """");

	Открытые = ОткрытыеОкна(ПолучитьХаб("новая").ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по ?окно=новая открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно новой подписки").Содержит("id=""podpiska-novaya""");
	Ожидаем.Что(Открытые[0], "форма окна уходит на раздел").Содержит("action=""" + РазделХаба() + """");
	Для Каждого Шаг Из СтрРазделить("Куда,О чём,Текст", ",") Цикл
		Ожидаем.Что(Открытые[0], "шаг «" + Шаг + "»").Содержит(">" + Шаг + "<");
	КонецЦикла;
	Ожидаем.Что(Открытые[0], "канал — сегментами по типам").Содержит("value=""telegram""");
	Ожидаем.Что(Открытые[0], "вебхук — тоже").Содержит("value=""вебхук""");

КонецПроцедуры

&Тест
Процедура НеизвестноеОкноДаётСтраницуБезОкна() Экспорт

	Подписка = ПодпискаХаба("неизвестное окно");
	Для Каждого Окно Из СтрРазделить("изменить-999999,зачем-" + Ключ(Подписка) + ",удалить,сузить-"
		+ Ключ(Подписка), ",") Цикл
		Страница = ПолучитьХаб(Окно);
		Ожидаем.Что(Страница.Код, "?окно=" + Окно + " — страница раздела").Равно(200);
		Ожидаем.Что(ОткрытыеОкна(Страница.ТелоТекст).Количество(), "?окно=" + Окно + " — без окна").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Заведение

// Подписка Telegram: секрета подписи у неё нет — удача уводит 303 на раздел, запись на месте.
&Тест
Процедура ЗаведениеУводитНаРазделИЗаписьВРеестре() Экспорт

	Название = "чат " + УникальныеИмена.Хвост();
	Ответ = ПослатьХаб("", ПоляTelegram(Название, СвободныйЧат()));

	Ожидаем.Что(Ответ.Код, "заведение — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел с отметкой").Содержит(РазделХаба() + "?saved=");
	Подписка = НайтиПодписку(ОбъектХаба(), Название);
	Ожидаем.Что(Подписка <> Неопределено, "подписка заведена").ЭтоИстина();
	Ожидаем.Что(Подписка.Активен, "и включена").ЭтоИстина();

	Запись = ЗаписьРеестра(ПолучитьХаб("").ТелоТекст, Название);
	Ожидаем.Что(Запись, "запись подписки в реестре").Заполнено();
	Ожидаем.Что(Запись, "меню ведёт к окну правки по адресу")
		.Содержит(АдресОкна(РазделХаба(), "изменить-" + Ключ(Подписка)));
	Ожидаем.Что(Запись, "и к подтверждению удаления").Содержит(АдресОкна(РазделХаба(), "удалить-" + Ключ(Подписка)));
	Ожидаем.Что(СтрНайти(Запись, "123456789:"), "токена бота в записи нет").Равно(0);

КонецПроцедуры

// Секрет подписи вебхука показывается один раз окном страницы ответа — без перенаправления, в адрес
// он не попадает; на следующем показе раздела его нет.
&Тест
Процедура СекретВебхукаОдинРазОкномБезПеренаправления() Экспорт

	Название = "хук " + УникальныеИмена.Хвост();
	Ответ = ПослатьХаб("", ПоляВебхука(Название, "https://hook.example.com/" + УникальныеИмена.Хвост()));

	Ожидаем.Что(Ответ.Код, "секрет — страницей, а не редиректом").Равно(200);
	Ожидаем.Что(Ответ.ПутьРедиректа, "в адрес секрет не уходит").Равно("");
	Подписка = НайтиПодписку(ОбъектХаба(), Название);
	Ожидаем.Что(ЗначениеЗаполнено(Подписка.Секрет), "КОНТРОЛЬ: секрет выпущен").ЭтоИстина();
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "одно окно — секрета").Равно(1);
	Ожидаем.Что(Открытые[0], "секрет в окне").Содержит(Подписка.Секрет);

	Ожидаем.Что(СтрНайти(ПолучитьХаб("").ТелоТекст, Подписка.Секрет), "второй раз секрет не показывается").Равно(0);

КонецПроцедуры

// Пустое обязательное поле канала — 400, окно новой подписки открыто на набранном, отказ у поля;
// набранный токен бота обратно не печатается.
&Тест
Процедура ОтказЗаведенияВозвращаетОкноСНабраннымБезСекрета() Экспорт

	Название = "без чата " + УникальныеИмена.Хвост();
	Ответ = ПослатьХаб("", ПоляTelegram(Название, ""));

	Ожидаем.Что(Ответ.Код, "отказ — 400").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "окно новой подписки").Содержит("id=""podpiska-novaya""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""chat-id"""), "отказ у поля чата").Содержит("aria-invalid=""true""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""название"""), "название на месте")
		.Содержит("value=""" + Название + """");
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, ТокенБота()), "токен бота не вернулся").Равно(0);
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название), "подписки нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Правка

// Окно правки по адресу открыто со значениями подписки; секрета в поле нет; способ доставки
// не меняется.
&Тест
Процедура ОкноПравкиПоАдресуСоЗначениямиБезСекрета() Экспорт

	Подписка = ПодпискаХаба("правка " + УникальныеИмена.Хвост());

	Открытые = ОткрытыеОкна(ПолучитьХаб("изменить-" + Ключ(Подписка)).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "форма окна уходит на правку этой подписки")
		.Содержит("action=""" + РазделХаба() + "/" + Ключ(Подписка) + "/save""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""chat-id"""), "чат подписки в поле")
		.Содержит("value=""" + Подписка.URL + """");
	Ожидаем.Что(СтрНайти(Открытые[0], ТокенБота()), "токена в окне нет").Равно(0);
	Ожидаем.Что(СтрНайти(Открытые[0], "name=""включить"""), "включённость окно правки не несёт").Равно(0);

КонецПроцедуры

// Правка выключенной подписки оставляет её выключенной: включённость меняет тумблер.
&Тест
Процедура ПравкаНеМеняетВключённость() Экспорт

	Название = "выключенная " + УникальныеИмена.Хвост();
	Подписка = ПодпискаХаба(Название);
	Ожидаем.Что(ПослатьХаб(Ключ(Подписка) + "/toggle", "включить=0").Код, "тумблер — 303").Равно(303);
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название).Активен, "тумблер выключил").ЭтоЛожь();

	Ответ = ПослатьХаб(Ключ(Подписка) + "/save", ПоляПравки(Название + " 2", Подписка));
	Ожидаем.Что(Ответ.Код, "правка — 303").Равно(303);
	Правленая = НайтиПодписку(ОбъектХаба(), Название + " 2");
	Ожидаем.Что(Правленая <> Неопределено, "название сменилось").ЭтоИстина();
	Ожидаем.Что(Правленая.Активен, "а подписка осталась выключенной").ЭтоЛожь();

КонецПроцедуры

// Форма правки старой вкладки несла поле включённости: такая форма — 400 «страница устарела»,
// подписка прежняя.
&Тест
Процедура ФормаПравкиСтаройВкладкиОтбиваетсяБезМутации() Экспорт

	Название = "старая вкладка " + УникальныеИмена.Хвост();
	Подписка = ПодпискаХаба(Название);

	Ответ = ПослатьХаб(Ключ(Подписка) + "/save", ПоляПравки(Название + " 2", Подписка) + "&включить=1");
	Ожидаем.Что(Ответ.Код, "старая форма — 400").Равно(400);
	Ожидаем.Что(Ответ.ТелоТекст, "и слова «страница устарела»").Содержит("Страница устарела");
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название) <> Неопределено, "подписка прежняя").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Удаление

// Удаление без поля подтверждения — 303 на окно подтверждения, подписка цела; неверное эхо — 400
// с открытым подтверждением; верное — подписки нет.
&Тест
Процедура УдалениеСпрашиваетИмяПодписки() Экспорт

	Название = "удаляемая " + УникальныеИмена.Хвост();
	Подписка = ПодпискаХаба(Название);
	Хвост = Ключ(Подписка) + "/delete";

	Ответ = ПослатьХаб(Хвост, "");
	Ожидаем.Что(Ответ.Код, "без подтверждения — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "на окно подтверждения").Равно(АдресОкна(РазделХаба(), "удалить-" + Ключ(Подписка)));
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название) <> Неопределено, "подписка цела").ЭтоИстина();

	Окно = ОткрытыеОкна(ПолучитьХаб("удалить-" + Ключ(Подписка)).ТелоТекст);
	Ожидаем.Что(Окно.Количество(), "подтверждение по адресу открыто").Равно(1);
	Ожидаем.Что(Окно[0], "называет подписку").Содержит(Название);

	Ответ = ПослатьХаб(Хвост, "confirmed=1&имя_подписки=" + Закодировать("не то"));
	Ожидаем.Что(Ответ.Код, "неверное эхо — 400").Равно(400);
	Ожидаем.Что(ОткрытыеОкна(Ответ.ТелоТекст).Количество(), "подтверждение открыто").Равно(1);
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название) <> Неопределено, "подписка цела").ЭтоИстина();

	Ответ = ПослатьХаб(Хвост, "confirmed=1&имя_подписки=" + Закодировать(Название));
	Ожидаем.Что(Ответ.Код, "верное эхо — 303").Равно(303);
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название), "подписки нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ПробаИПредпросмотр

// Проба окна без скрипта: окно возвращается открытым на шаге «Текст» с итогом; отказ ввода — у поля,
// подписка не заводится.
&Тест
Процедура ПробаОкнаБезСкриптаВозвращаетОкноСИтогом() Экспорт

	Название = "проба " + УникальныеИмена.Хвост();
	Ответ = ПослатьХаб("test", ПоляTelegram(Название, ""));

	Ожидаем.Что(Ответ.Код, "отказ пробы — 400").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно новой подписки").Содержит("id=""podpiska-novaya""");
	Ожидаем.Что(Тег(Открытые[0], "input", "name=""chat-id"""), "отказ у поля чата").Содержит("aria-invalid=""true""");
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название), "проба ничего не завела").Равно(Неопределено);

КонецПроцедуры

// Предпросмотр без скрипта: окно правки открыто, на шаге «Текст» — сообщение по набранному шаблону;
// со скриптом — то же кусочком.
&Тест
Процедура ПредпросмотрБезСкриптаКладётСообщениеВОкно() Экспорт

	Подписка = ПодпискаХаба("предпросмотр " + УникальныеИмена.Хвост());
	Поля = ПоляПравки("предпросмотр", Подписка) + "&шаблон-текста=" + Закодировать("Привет {событие}");

	Ответ = ПослатьХаб(Ключ(Подписка) + "/preview", Поля);
	Ожидаем.Что(Ответ.Код, "предпросмотр — 200").Равно(200);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно правки открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "сообщение собрано").Содержит("data-sub-result=""ok""");
	Ожидаем.Что(Открытые[0], "по набранному шаблону").Содержит("Привет ");

	Кусок = ПослатьХаб(Ключ(Подписка) + "/preview", Поля, "1");
	Ожидаем.Что(Кусок.ТелоТекст, "кусочком — только ответ").Содержит("data-sub-result=""ok""");
	Ожидаем.Что(СтрНайти(Кусок.ТелоТекст, "<dialog"), "без страницы").Равно(0);

КонецПроцедуры

// Текст предпросмотра — данные пользователя, а не слово вида узла: шаблон из одного слова вида
// надписи («Заголовок», «ключ», «название») печатается текстом и со скриптом, и без него.
&Тест
Процедура ПредпросмотрШаблонаСловомВидаПечатаетсяТекстом() Экспорт

	Подписка = ПодпискаХаба("слово вида " + УникальныеИмена.Хвост());
	Для Каждого Слово Из СтрРазделить("Заголовок,ключ,название", ",") Цикл
		Поля = ПоляПравки("слово вида", Подписка) + "&шаблон-текста=" + Закодировать(Слово);

		Кусок = ПослатьХаб(Ключ(Подписка) + "/preview", Поля, "1");
		Ожидаем.Что(Кусок.Код, "кусочком «" + Слово + "» — 200").Равно(200);
		Ожидаем.Что(Между(Кусок.ТелоТекст, "data-sub-text", "</"), "слово внутри текста сообщения")
			.Содержит(">" + Слово);

		Ответ = ПослатьХаб(Ключ(Подписка) + "/preview", Поля);
		Ожидаем.Что(Ответ.Код, "без скрипта «" + Слово + "» — 200").Равно(200);
		Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
		Ожидаем.Что(Открытые.Количество(), "окно правки открыто").Равно(1);
		Ожидаем.Что(Между(Открытые[0], "data-sub-text", "</"), "слово в сообщении окна").Содержит(">" + Слово);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область НастройкиДоставки

// Спойлер под списком: плашки рубильника и прокси, поля доставки, пароль прокси пустой.
&Тест
Процедура СпойлерДоставкиСтоитПодСпискомСПлашками() Экспорт

	Страница = ПолучитьХаб("").ТелоТекст;
	Ожидаем.Что(Страница, "спойлер доставки").Содержит("Настройки доставки");
	Ожидаем.Что(Страница, "плашка рубильника").Содержит(">включена<");
	Ожидаем.Что(Страница, "плашка прокси").Содержит(">прокси не задан<");
	Ожидаем.Что(Страница, "форма спойлера уходит в свою дверь").Содержит("action=""" + РазделХаба() + "/delivery""");
	Ожидаем.Что(Страница, "поле сервера прокси").Содержит("name=""oshub.webhooks.telegram.proxy.host""");

КонецПроцедуры

// Одна дорога записи доставки: удача — 303 на раздел и значение записано; порт вне границ — 400
// с раскрытым спойлером и причиной, значение прежнее; сброс введённого руками — кнопкой у поля,
// той же дверью; операция не из белого списка — 400 «Страница устарела» без записи.
&Тест
Процедура ФормаДоставкиПишетЗначенияИОтбиваетНегодные() Экспорт

	Ключ_ = "oshub.webhooks.telegram.proxy.port";
	Настройки = Желудь("СервисНастроек");
	Попытка

		Ответ = ПослатьХаб("delivery", Ключ_ + "=8081");
		Ожидаем.Что(Ответ.Код, "удача — 303").Равно(303);
		Ожидаем.Что(Ответ.ПутьРедиректа, "на раздел подписок").Содержит(РазделХаба() + "?saved=");
		Ожидаем.Что(Строка(Настройки.Значение(Ключ_)), "порт записан").Равно("8081");
		Страница = ПолучитьХаб("").ТелоТекст;
		Сброс = Разметка_.ФормаСброса(Страница, Ключ_);
		Ожидаем.Что(Сброс, "у порта кнопка сброса, её форма — вне формы спойлера")
			.Содержит("value=""" + Ключ_ + """");
		Ожидаем.Что(Сброс, "спойлер и сброс введённого руками — одна дверь")
			.Содержит("action=""" + РазделХаба() + "/delivery""");
		Ожидаем.Что(СтрНайти(Страница, "action=""/hub/settings/delivery"""), "старой двери на странице нет").Равно(0);

		Ответ = ПослатьХаб("delivery", Ключ_ + "=70000");
		Ожидаем.Что(Ответ.Код, "порт вне границ — 400").Равно(400);
		Ожидаем.Что(СпойлерРаскрыт(Ответ.ТелоТекст), "спойлер раскрыт к отказу").ЭтоИстина();
		// отказ — под полем порта, с набранным на месте
		ПолеВвода = Тег(Ответ.ТелоТекст, "input", "name=""" + Ключ_ + """");
		Ожидаем.Что(ПолеВвода, "поле порта помечено").Содержит("aria-invalid=""true""");
		Ожидаем.Что(ПолеВвода, "набранный порт на месте").Содержит("value=""70000""");
		Ожидаем.Что(Строка(Настройки.Значение(Ключ_)), "порт прежний").Равно("8081");
		Ожидаем.Что(СпойлерРаскрыт(ПолучитьХаб("").ТелоТекст), "КОНТРОЛЬ: без отказа спойлер свёрнут").ЭтоЛожь();

		Ответ = ПослатьХаб("delivery", "операция=чепуха&ключ=" + Ключ_);
		Ожидаем.Что(Ответ.Код, "операция чужой формы — 400").Равно(400);
		Ожидаем.Что(Ответ.ТелоТекст, "страница устарела").Содержит("Страница устарела");
		Ожидаем.Что(Строка(Настройки.Значение(Ключ_)), "порт не тронут").Равно("8081");

		Ответ = ПослатьХаб("delivery", Разметка_.ТелоОтправки(Сброс));
		Ожидаем.Что(Ответ.Код, "сброс — 303").Равно(303);
		Ожидаем.Что(Строка(Настройки.Значение(Ключ_)), "порт сброшен к умолчанию").Не_().Равно("8081");

	Исключение
		Настройки.Сбросить(Ключ_, "тест", "");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить(Ключ_, "тест", "");

КонецПроцедуры

// Пароль прокси Telegram: заданный печатается пустым полем, значения нет ни на странице, ни
// в адресе ответа; пустое поле при следующей отправке оставляет сохранённый.
&Тест
Процедура ПарольПроксиНеПечатаетсяАПустоеПолеЕгоНеСтирает() Экспорт

	Ключ_ = "oshub.webhooks.telegram.proxy.password";
	Секрет = "Proxy-Pass-" + УникальныеИмена.Хвост();
	Настройки = Желудь("СервисНастроек");
	Попытка

		Ответ = ПослатьХаб("delivery", Ключ_ + "=" + Закодировать(Секрет));
		Ожидаем.Что(Ответ.Код, "пароль принят — 303").Равно(303);
		Ожидаем.Что(СтрНайти(Ответ.ПутьРедиректа, Секрет), "в адресе ответа пароля нет").Равно(0);
		Ожидаем.Что(Строка(Настройки.Значение(Ключ_)), "КОНТРОЛЬ: пароль сохранён").Равно(Секрет);

		Страница = ПолучитьХаб("").ТелоТекст;
		Ожидаем.Что(СтрНайти(Страница, Секрет), "на странице пароля нет").Равно(0);
		Поле = Тег(Страница, "input", "name=""" + Ключ_ + """");
		Ожидаем.Что(Поле, "поле пароля есть").Заполнено();
		Ожидаем.Что(СтрНайти(Поле, "value=""" + Секрет), "поле пароля пустое").Равно(0);

		Ответ = ПослатьХаб("delivery", Ключ_ + "=&oshub.webhooks.telegram.proxy.port=8082");
		Ожидаем.Что(Ответ.Код, "отправка с пустым паролем — 303").Равно(303);
		Ожидаем.Что(Строка(Настройки.Значение(Ключ_)), "пустое поле пароль не стёрло").Равно(Секрет);

		// отбитая форма возвращает набранное в поля — но не пароль
		Другой = "Other-Pass-" + УникальныеИмена.Хвост();
		Ответ = ПослатьХаб("delivery", Ключ_ + "=" + Закодировать(Другой) + "&oshub.webhooks.telegram.proxy.port=70000");
		Ожидаем.Что(Ответ.Код, "КОНТРОЛЬ: негодный порт — отказ").Равно(400);
		Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, Другой), "набранного пароля в отбитой форме нет").Равно(0);

	Исключение
		Настройки.Сбросить(Ключ_, "тест", "");
		Настройки.Сбросить("oshub.webhooks.telegram.proxy.port", "тест", "");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить(Ключ_, "тест", "");
	Настройки.Сбросить("oshub.webhooks.telegram.proxy.port", "тест", "");

КонецПроцедуры

#КонецОбласти

#Область Цена

// Окна правки и подтверждения приходят по адресу, а не печатаются на каждую запись: разметка раздела
// растёт записями, а не окнами: у пула с двумя и с десятью подписками на странице окно новой подписки
// и одна оболочка, в которую кит приносит окно по адресу.
&Тест
Процедура ОкнаРазделаНеРастутСЧисломПодписок() Экспорт

	Пул = Засев.Пул();
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	ОкнаНа = Новый Соответствие();
	Для Номер = 1 По 10 Цикл
		ПослатьПул(Пул, Хозяин, "", ПоляTelegram("цена " + Номер, СвободныйЧат()));
		Если Номер = 2 ИЛИ Номер = 10 Тогда
			Страница = ПолучитьПул(Пул, Хозяин, "").ТелоТекст;
			ОкнаНа.Вставить(Номер, СтрЧислоВхождений(Страница, "<dialog"));
			Ожидаем.Что(СтрЧислоВхождений(Страница, "/toggle"""), "КОНТРОЛЬ: записей " + Номер).Равно(Номер);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(ОкнаНа[10], "десять подписок — столько же окон, сколько две").Равно(ОкнаНа[2]);
	Ожидаем.Что(ОкнаНа[2], "окно новой подписки и одна оболочка окон по адресу").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ПулИПакет

// Запись подписки пула: значок канала, число событий, меню ⚙ с окнами по адресу, получатели —
// тоже окном; у пула без тегов в окне — одна строка со ссылкой в раздел «Теги».
&Тест
Процедура ЗаписьПодпискиПулаИСтрокаБезТегов() Экспорт

	Пул = Засев.Пул();
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	Название = "пул " + УникальныеИмена.Хвост();
	Ответ = ПослатьПул(Пул, Хозяин, "", ПоляTelegram(Название, СвободныйЧат()));
	Ожидаем.Что(Ответ.Код, "заведение — 303").Равно(303);
	Подписка = НайтиПодписку(Желудь("СервисПодписок").ОбъектПула(Пул), Название);
	Раздел = РазделПула(Пул);

	Страница = ПолучитьПул(Пул, Хозяин, "").ТелоТекст;
	Запись = ЗаписьРеестра(Страница, Название);
	// значок записи — иконка кита с классом записи; у Telegram это логотип бренда (кит 0.13.0-dev.8:
	// class="icon icon--brand entry__icon"), состав классов значка сторож не перечисляет
	Ожидаем.Что(Запись, "значок канала у имени").Содержит("<svg class=""icon ");
	Ожидаем.Что(Запись, "значок — записи реестра").Содержит(" entry__icon""");
	Ожидаем.Что(Запись, "окно правки по адресу").Содержит(АдресОкна(Раздел, "изменить-" + Ключ(Подписка)));
	Ожидаем.Что(Запись, "получатели — окном по адресу").Содержит(АдресОкна(Раздел, "получатели-" + Ключ(Подписка)));
	Окно = Между(Страница, "id=""podpiska-novaya""", "</dialog>");
	Ожидаем.Что(Окно, "без тегов — ссылка в раздел «Теги»").Содержит("href=""/pools/" + Пул.Имя + "/settings/tags""");
	Ожидаем.Что(Окно, "флажок «нижестоящие могут сузить»").Содержит("name=""сужение_снизу""");

КонецПроцедуры

// Подписка хаба, которую разрешено сужать, у пула — в «Подписках сверху»: окно сужения по адресу
// оставляет события, «Не присылать сюда» глушит, «Снять поправку» снимает.
&Тест
Процедура ПодпискаСверхуСужаетсяГлушитсяИСнимается() Экспорт

	Название = "сверху " + УникальныеИмена.Хвост();
	Ответ = ПослатьХаб("", ПоляTelegram(Название, СвободныйЧат()) + "&событие_1=1&сужение_снизу=1");
	Ожидаем.Что(Ответ.Код, "КОНТРОЛЬ: подписка хаба заведена").Равно(303);
	Сверху = НайтиПодписку(ОбъектХаба(), Название);
	Пул = Засев.Пул();
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	ОбъектПула = Желудь("СервисПодписок").ОбъектПула(Пул);
	Поправки = Желудь("СервисПоправокПодписок");
	Хвост = "inherited/" + Ключ(Сверху);

	Страница = ПолучитьПул(Пул, Хозяин, "").ТелоТекст;
	Ожидаем.Что(Страница, "секция «Подписки сверху»").Содержит("Подписки сверху");
	Запись = ЗаписьРеестра(Страница, Название);
	Ожидаем.Что(Запись, "плашка «сверху»").Содержит(">сверху<");
	Ожидаем.Что(Запись, "окно сужения по адресу").Содержит(АдресОкна(РазделПула(Пул), "сузить-" + Ключ(Сверху)));
	Ожидаем.Что(СтрНайти(Запись, Сверху.URL), "чата подписки хаба пул не видит").Равно(0);

	Окна_ = ОткрытыеОкна(ПолучитьПул(Пул, Хозяин, "сузить-" + Ключ(Сверху)).ТелоТекст);
	Ожидаем.Что(Окна_.Количество(), "окно сужения открыто").Равно(1);
	Ожидаем.Что(Окна_[0], "форма уходит на поправку").Содержит("action=""" + РазделПула(Пул) + "/" + Хвост + "/narrow""");

	Ответ = ПослатьПул(Пул, Хозяин, Хвост + "/narrow", "событие_0=1");
	Ожидаем.Что(Ответ.Код, "сужение — 303").Равно(303);
	Поправка = Поправки.ПоправкаОбъекта(ОбъектПула, Сверху);
	Ожидаем.Что(Поправка <> Неопределено, "поправка легла").ЭтоИстина();
	Ожидаем.Что(Поправки.ОставленныеСобытия(Сверху, Поправка).Количество(), "оставлено одно событие").Равно(1);

	Запись = ЗаписьРеестра(ПолучитьПул(Пул, Хозяин, "").ТелоТекст, Название);
	Ожидаем.Что(Запись, "пункт «Не присылать сюда»").Содержит("Не присылать сюда");
	Ответ = ПослатьПул(Пул, Хозяин, Хвост + "/narrow", "не_присылать=1&событие_0=1");
	Ожидаем.Что(Ответ.Код, "заглушение — 303").Равно(303);
	Поправка = Поправки.ПоправкаОбъекта(ОбъектПула, Сверху);
	Ожидаем.Что(Поправка.НеПрисылать, "не присылать").ЭтоИстина();
	Ожидаем.Что(Поправки.ОставленныеСобытия(Сверху, Поправка).Количество(), "сужение событий не потерялось").Равно(1);

	Ответ = ПослатьПул(Пул, Хозяин, Хвост + "/reset", "");
	Ожидаем.Что(Ответ.Код, "снятие — 303").Равно(303);
	Ожидаем.Что(Поправки.ПоправкаОбъекта(ОбъектПула, Сверху), "поправки нет").Равно(Неопределено);

КонецПроцедуры

// У подписки пакета нет получателей и нижестоящих: ни пункта «Получатели», ни флажка сужения.
&Тест
Процедура УПакетаНетПолучателейИСужения() Экспорт

	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	Название = "пакет " + УникальныеИмена.Хвост();
	Ответ = ПослатьПакет(Пул, Пакет, Хозяин, "", ПоляTelegram(Название, СвободныйЧат()));
	Ожидаем.Что(Ответ.Код, "заведение — 303").Равно(303);

	Страница = ПолучитьПакет(Пул, Пакет, Хозяин, "").ТелоТекст;
	Запись = ЗаписьРеестра(Страница, Название);
	Ожидаем.Что(Запись, "КОНТРОЛЬ: запись подписки пакета").Заполнено();
	Ожидаем.Что(СтрНайти(Запись, Закодировать("получатели-")), "получателей у пакета нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "name=""сужение_снизу"""), "флажка сужения нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Получатели

// Окно «Получатели» по адресу ?окно=получатели-<ключ>; дверь окна на GET отдаёт раздел с окном
// на странице ветки и на найденном — их берёт скрипт кита. Чужая подписка — 404.
&Тест
Процедура ОкноПолучателейПоАдресуИДверьОтдаётВеткуИНайденное() Экспорт

	Подписка = ПодпискаХаба("получатели " + УникальныеИмена.Хвост());
	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);

	Открытые = ОткрытыеОкна(ПолучитьХаб("получатели-" + Ключ(Подписка)).ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "по адресу открыто одно окно").Равно(1);
	Ожидаем.Что(Открытые[0], "это окно «Получатели»").Содержит("id=""podpiska-poluchateli""");
	Ожидаем.Что(Открытые[0], "пул строкой с режимом").Содержит("name=""режим:пул_" + Формат(Пул.Идентификатор, "ЧГ=0") + """");
	Ожидаем.Что(Открытые[0], "форма уходит на дверь окна").Содержит("action=""" + ДверьХаба(Подписка) + """");

	Ответ = ПолучитьДверьХаба(Подписка, "", "пул_" + Формат(Пул.Идентификатор, "ЧГ=0"), "1");
	Ожидаем.Что(Ответ.Код, "страница ветки — 200").Равно(200);
	Ожидаем.Что(Ответ.ТелоТекст, "кусок ветки").Содержит("data-checktree-page=""пул_" + Формат(Пул.Идентификатор, "ЧГ=0") + """");
	Ожидаем.Что(Ответ.ТелоТекст, "пакет пула галкой").Содержит("value=""пакет_" + Формат(Пакет.Идентификатор, "ЧГ=0") + """");

	Ответ = ПолучитьДверьХаба(Подписка, Лев(Пакет.Имя, 4), "", "");
	Ожидаем.Что(Ответ.ТелоТекст, "найденное").Содержит("data-checktree-found");
	Ожидаем.Что(Ответ.ТелоТекст, "с пакетом").Содержит("value=""пакет_" + Формат(Пакет.Идентификатор, "ЧГ=0") + """");

	Ожидаем.Что(ПолучитьДверьХаба(Новый Структура("Идентификатор", 999999), "", "", "").Код, "чужая подписка — 404")
		.Равно(404);

КонецПроцедуры

// Правки окна ложатся в домен и уводят 303 обратно в окно; с поиском — на дверь с ?найти=.
&Тест
Процедура ПравкиОкнаЛожатсяИУводятОбратноВОкно() Экспорт

	Подписка = ПодпискаХаба("правки " + УникальныеИмена.Хвост());
	Пул = Засев.Пул();
	Ключ_ = Ключ(Подписка);

	Ответ = ПослатьХаб(Ключ_ + "/recipients", ПравкаРежима(Пул, "никакие"));
	Ожидаем.Что(Ответ.Код, "правки — 303").Равно(303);
	Ожидаем.Что(Ответ.ПутьРедиректа, "обратно в раздел").Содержит(РазделХаба() + "?");
	Ожидаем.Что(Ответ.ПутьРедиректа, "с окном").Содержит(Закодировать("окно") + "=" + Закодировать("получатели-" + Ключ_));
	Ожидаем.Что(Исключено(ОбъектХаба(), Подписка), "пул «никакие»").Равно("1/0");

	Ответ = ПослатьХаб(Ключ_ + "/recipients", ПравкаРежима(Пул, "все") + "&найти=ab");
	Ожидаем.Что(Ответ.ПутьРедиректа, "с поиском — на дверь окна с ним").Содержит(ДверьХаба(Подписка) + "?");
	Ожидаем.Что(Ответ.ПутьРедиректа, "и строкой").Содержит("=ab");
	Ожидаем.Что(Исключено(ОбъектХаба(), Подписка), "пул снова «все»").Равно("0/0");

КонецПроцедуры

// Форма старого дерева или старого окна (поле, которого окно не печатает: свои перечни показанного
// до кита dev.8; режим «все, кроме» окна четырёх сегментов) — 400 «Страница устарела», домен цел.
&Тест
Процедура ФормаСтарогоДереваДаёт400БезПеремен() Экспорт

	Подписка = ПодпискаХаба("старая " + УникальныеИмена.Хвост());
	Пул = Засев.Пул();
	Для Каждого Тело Из СтрРазделить("показанные_узлы=" + Закодировать("пул_" + Формат(Пул.Идентификатор, "ЧГ=0"))
		+ ";" + Закодировать("получатель_пул_" + Формат(Пул.Идентификатор, "ЧГ=0")) + "=1"
		+ ";" + Закодировать("показаны") + "=" + Закодировать("пакет_1")
		+ ";" + Закодировать("показаны_отмеченные") + "=" + Закодировать("пакет_1")
		+ ";" + Закодировать("режим:пул_" + Формат(Пул.Идентификатор, "ЧГ=0")) + "=" + Закодировать("кроме")
		+ ";режим=" + Закодировать("пул_" + Формат(Пул.Идентификатор, "ЧГ=0") + ":кроме"), ";") Цикл
		Ответ = ПослатьХаб(Ключ(Подписка) + "/recipients", Тело + "&" + ПравкаРежима(Пул, "никакие"));
		Ожидаем.Что(Ответ.Код, "«" + Тело + "» — 400").Равно(400);
		Ожидаем.Что(Ответ.ТелоТекст, "со словами").Содержит("Страница устарела");
		Ожидаем.Что(Исключено(ОбъектХаба(), Подписка), "домен цел").Равно("0/0");
	КонецЦикла;

КонецПроцедуры

// Свой пул подписка пула не исключает: режим «никакие» — 400, окно открыто с причиной.
&Тест
Процедура РежимНикакиеУПодпискиПулаОтказВОкне() Экспорт

	Пул = Засев.Пул();
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	Название = "пул " + УникальныеИмена.Хвост();
	ПослатьПул(Пул, Хозяин, "", ПоляTelegram(Название, СвободныйЧат()));
	Подписка = НайтиПодписку(Желудь("СервисПодписок").ОбъектПула(Пул), Название);

	Ответ = ПослатьПул(Пул, Хозяин, Ключ(Подписка) + "/recipients", ПравкаРежима(Пул, "никакие"));
	Ожидаем.Что(Ответ.Код, "отказ — 400").Равно(400);
	Открытые = ОткрытыеОкна(Ответ.ТелоТекст);
	Ожидаем.Что(Открытые.Количество(), "окно открыто").Равно(1);
	Ожидаем.Что(Открытые[0], "с причиной").Содержит("не исключает");

КонецПроцедуры

// Без скрипта страница ветки пула «никакие» печатается целиком — строка пула с сегментами и запертые
// галки: отказа «пул исключён целиком» больше нет. Сегмент «выбранные» на ней начинает с пустого
// выбора, следующей формой галка пакета ложится выбором.
&Тест
Процедура СтраницаВеткиПулаНикакиеБезСкриптаПравитсяБезОтказа() Экспорт

	Подписка = ПодпискаХаба("никакие " + УникальныеИмена.Хвост());
	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);
	КлючПула = "пул_" + Формат(Пул.Идентификатор, "ЧГ=0");
	КлючПакета = "пакет_" + Формат(Пакет.Идентификатор, "ЧГ=0");
	ПослатьХаб(Ключ(Подписка) + "/recipients", ПравкаРежима(Пул, "никакие"));
	Ожидаем.Что(Исключено(ОбъектХаба(), Подписка), "КОНТРОЛЬ: пул «никакие»").Равно("1/0");

	Ответ = ПослатьХаб(Ключ(Подписка) + "/recipients", ФормаВеткиБезСкрипта(Подписка, КлючПула,
		"режим:" + КлючПула + "=выбранные"));
	Ожидаем.Что(Ответ.Код, "сегмент страницы ветки ложится — 303").Равно(303);
	Ожидаем.Что(Выбрано(ОбъектХаба(), Подписка), "пул «выбранные», выбор пуст").Равно("0/1/0");

	Ответ = ПослатьХаб(Ключ(Подписка) + "/recipients", ФормаВеткиБезСкрипта(Подписка, КлючПула, "галка:" + КлючПакета));
	Ожидаем.Что(Ответ.Код, "галка отпертого пакета ложится — 303").Равно(303);
	Ожидаем.Что(Выбрано(ОбъектХаба(), Подписка), "пакет выбран").Равно("0/1/1");

КонецПроцедуры

// Плашка отметки в записи — тихая форма двери окна: крестик снимает выбранный пакет.
&Тест
Процедура КрестикПлашкиСнимаетВыбранныйПакет() Экспорт

	Название = "плашка " + УникальныеИмена.Хвост();
	Подписка = ПодпискаХаба(Название);
	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);
	КлючПакета = "пакет_" + Формат(Пакет.Идентификатор, "ЧГ=0");
	ПослатьХаб(Ключ(Подписка) + "/recipients", ПравкаРежима(Пул, "выбранные") + "&основа="
		+ Закодировать("пул_" + Формат(Пул.Идентификатор, "ЧГ=0") + ":никакие") + "&включить=" + Закодировать(КлючПакета));
	Ожидаем.Что(Выбрано(ОбъектХаба(), Подписка), "КОНТРОЛЬ: пакет выбран").Равно("0/1/1");

	Запись = ЗаписьРеестра(ПолучитьХаб("").ТелоТекст, Название);
	Ожидаем.Что(Запись, "плашка выбранного пакета с крестиком")
		.Содержит("Убрать «" + Пул.Имя + "/" + Пакет.Имя + "» из выбранных");
	Ожидаем.Что(Запись, "её форма несёт правку кита").Содержит("name=""снять"" value=""" + КлючПакета + """");

	Ответ = ПослатьХаб(Ключ(Подписка) + "/recipients", ПравкаСнять(Пакет));
	Ожидаем.Что(Ответ.Код, "крестик — 303").Равно(303);
	Ожидаем.Что(Выбрано(ОбъектХаба(), Подписка), "выбор снят").Равно("0/1/0");

КонецПроцедуры

// Гвард не впустил — дверь окна «Получатели» хаба отвечает 403 без тела и домен не трогает;
// КОНТРОЛЬ — впущенный той же формой меняет.
&Тест
Процедура ПостороннийНеМеняетПолучателейХабаАВпущенныйМеняет() Экспорт

	Подписка = ПодпискаХаба("гвард " + УникальныеИмена.Хвост());
	Пул = Засев.Пул();
	Двери = Новый Соответствие();
	Двери.Вставить(Ключ(Подписка) + "/recipients", ПравкаРежима(Пул, "никакие"));

	НиОднаДверьНеОтвечает(КонтроллерХаба, "хаб", Неопределено, Двери);
	Ожидаем.Что(Исключено(ОбъектХаба(), Подписка), "получатели прежние").Равно("0/0");

	ПослатьХаб(Ключ(Подписка) + "/recipients", ПравкаРежима(Пул, "никакие"));
	Ожидаем.Что(Исключено(ОбъектХаба(), Подписка), "впущенный меняет").Равно("1/0");

КонецПроцедуры

// Чужой пулу двери окон «Получатели» и «Пакеты пула» отвечают 403 и ничего не меняют; гвард не
// впустил — 403 без тела. КОНТРОЛЬ — хозяин той же формой меняет обе.
&Тест
Процедура ПостороннийНеМеняетПолучателейПулаАХозяинМеняет() Экспорт

	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	Чужой = Учётки.Учётка();
	Название = "пул " + УникальныеИмена.Хвост();
	ПослатьПул(Пул, Хозяин, "", ПоляTelegram(Название, СвободныйЧат()));
	ОбъектПула = Желудь("СервисПодписок").ОбъектПула(Пул);
	Подписка = НайтиПодписку(ОбъектПула, Название);
	Сверху = ПодпискаХабаСверху();
	Двери = Новый Соответствие();
	Двери.Вставить(Ключ(Подписка) + "/recipients", ПравкаРежима(Пул, "выбранные") + "&основа="
		+ Закодировать("пул_" + Формат(Пул.Идентификатор, "ЧГ=0") + ":все") + "&" + ПравкаСнять(Пакет));
	Двери.Вставить("inherited/" + Ключ(Сверху) + "/recipients", ПравкаСнять(Пакет));

	Для Каждого Дверь Из Двери Цикл
		Ответ = ПослатьПул(Пул, Чужой, Дверь.Ключ, Дверь.Значение);
		Ожидаем.Что(Ответ.Код, "чужой пулу: «" + Дверь.Ключ + "» — 403").Равно(403);
	КонецЦикла;
	НиОднаДверьНеОтвечает(КонтроллерПула, "пул", ИменаАдреса(Пул), Двери);
	Ожидаем.Что(Выбрано(ОбъектПула, Подписка), "получатели подписки пула прежние").Равно("0/0/0");
	Ожидаем.Что(Желудь("СервисПоправокПодписок").ПоправкаОбъекта(ОбъектПула, Сверху), "поправки нет")
		.Равно(Неопределено);

	Для Каждого Дверь Из Двери Цикл
		Ответ = ПослатьПул(Пул, Хозяин, Дверь.Ключ, Дверь.Значение);
		Ожидаем.Что(Ответ.Код, "хозяин: «" + Дверь.Ключ + "» — 303").Равно(303);
	КонецЦикла;
	Ожидаем.Что(Выбрано(ОбъектПула, Подписка), "хозяин снял пакет: пул «выбранные» без него").Равно("0/1/0");
	Поправка = Желудь("СервисПоправокПодписок").ПоправкаОбъекта(ОбъектПула, Сверху);
	Ожидаем.Что(Поправка <> Неопределено, "и снял его поправкой к подписке хаба").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПоправокПодписок").ИсключённыеПакеты(Поправка).Количество(), "один пакет").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Права

// Гвард не впустил — ни одна из десяти дверей раздела хаба (заведение, правка, тумблер, удаление,
// проба и предпросмотр формы и записи, получатели, доставка) не отвечает и не меняет домен, проба
// не уходит и в аудит не пишется; КОНТРОЛЬ — впущенный той же формой выключает.
&Тест
Процедура ПостороннийНиОднойФормойНеМеняетПодпискиХаба() Экспорт

	Название = "чужая " + УникальныеИмена.Хвост();
	Подписка = ПодпискаХаба(Название);
	Ключ_ = Ключ(Подписка);
	Пул = Засев.Пул();
	Двери = ДвериПодписки(Ключ_, Название, Подписка);
	Двери.Вставить(Ключ_ + "/recipients", "правки=1&режим=" + Закодировать("пул_" + Формат(Пул.Идентификатор, "ЧГ=0") + ":никакие"));
	Двери.Вставить("delivery", "oshub.webhooks.allow_insecure=1");
	Ожидаем.Что(Двери.Количество(), "КОНТРОЛЬ: десять дверей хаба").Равно(10);

	НиОднаДверьНеОтвечает(КонтроллерХаба, "хаб", Неопределено, Двери);

	Прежняя = НайтиПодписку(ОбъектХаба(), Название);
	Ожидаем.Что(Прежняя <> Неопределено, "подписка цела").ЭтоИстина();
	Ожидаем.Что(Прежняя.Активен, "и включена").ЭтоИстина();
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), "злоумышленник"), "чужая не заведена").Равно(Неопределено);
	Ожидаем.Что(Исключено(ОбъектХаба(), Подписка), "получатели прежние").Равно("0/0");
	Ожидаем.Что(Желудь("СервисНастроек").Флаг("oshub.webhooks.allow_insecure", Ложь), "настройка прежняя").ЭтоЛожь();

	// КОНТРОЛЬ: впущенный той же формой выключает
	ПослатьХаб(Ключ_ + "/toggle", "включить=0");
	Ожидаем.Что(НайтиПодписку(ОбъектХаба(), Название).Активен, "впущенный выключает").ЭтоЛожь();

КонецПроцедуры

// КОНТРОЛЬ к сторожам дверей: впущенный той же формой меняет настройки доставки и отправляет
// пробное — двери доставки и пробы закрыты гвардом, а не сломаны.
&Тест
Процедура ВпущенныйМеняетДоставкуИШлётПробное() Экспорт

	Название = "проба " + УникальныеИмена.Хвост();
	Подписка = ПодпискаХаба(Название);
	Издатель = Желудь("ИздательСобытий");
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПробаПодписки(), Слушатель);

	Попытка
		Ответ = ПослатьХаб("delivery", "oshub.webhooks.allow_insecure=1");
		Ожидаем.Что(Ответ.Код, "впущенный: доставка — 303").Равно(303);
		Ожидаем.Что(Желудь("СервисНастроек").Флаг("oshub.webhooks.allow_insecure", Ложь),
			"впущенный меняет настройку доставки").ЭтоИстина();
	Исключение
		Желудь("СервисНастроек").Сбросить("oshub.webhooks.allow_insecure", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Желудь("СервисНастроек").Сбросить("oshub.webhooks.allow_insecure", "тест");

	ПослатьХаб(Ключ(Подписка) + "/test", "");
	Ожидаем.Что(Слушатель.Количество(), "впущенный отправляет пробное — проба в аудите").Равно(1);

КонецПроцедуры

// Чужой пулу ни одной из двенадцати дверей раздела пула — свои подписки, получатели, поправки
// к подписке хаба и дерево пакетов в поправке — ничего не меняет: 403; гвард не впустил — тоже
// ничего, и проба в аудит не пишется. КОНТРОЛЬ — хозяин той же формой выключает и сужает.
&Тест
Процедура ПостороннийНиОднойФормойНеМеняетПодпискиПула() Экспорт

	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	Чужой = Учётки.Учётка();
	Название = "пул " + УникальныеИмена.Хвост();
	ПослатьПул(Пул, Хозяин, "", ПоляTelegram(Название, СвободныйЧат()));
	ОбъектПула = Желудь("СервисПодписок").ОбъектПула(Пул);
	Подписка = НайтиПодписку(ОбъектПула, Название);
	Ключ_ = Ключ(Подписка);
	Сверху = ПодпискаХабаСверху();
	Поправка = "inherited/" + Ключ(Сверху);

	Двери = ДвериПодписки(Ключ_, Название, Подписка);
	Двери.Вставить(Ключ_ + "/recipients", ПравкаСнять(Пакет));
	Двери.Вставить(Поправка + "/narrow", "не_присылать=1&событие_0=1");
	Двери.Вставить(Поправка + "/reset", "");
	Двери.Вставить(Поправка + "/recipients", ПравкаСнять(Пакет));
	Ожидаем.Что(Двери.Количество(), "КОНТРОЛЬ: двенадцать дверей пула").Равно(12);
	Для Каждого Дверь Из Двери Цикл
		Ответ = ПослатьПул(Пул, Чужой, Дверь.Ключ, Дверь.Значение);
		Ожидаем.Что(Ответ.Код, "чужой пулу: «" + Дверь.Ключ + "» — 403").Равно(403);
	КонецЦикла;
	НиОднаДверьНеОтвечает(КонтроллерПула, "пул", ИменаАдреса(Пул), Двери);

	Прежняя = НайтиПодписку(ОбъектПула, Название);
	Ожидаем.Что(Прежняя <> Неопределено, "подписка пула цела").ЭтоИстина();
	Ожидаем.Что(Прежняя.Активен, "и включена").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПодписок").Список(ОбъектПула).Количество(), "чужая не заведена").Равно(1);
	Ожидаем.Что(Исключено(ОбъектПула, Подписка), "получатели прежние").Равно("0/0");
	Ожидаем.Что(Желудь("СервисПоправокПодписок").ПоправкаОбъекта(ОбъектПула, Сверху), "поправки нет").Равно(Неопределено);

	// КОНТРОЛЬ: хозяин той же формой выключает и сужает
	ПослатьПул(Пул, Хозяин, Ключ_ + "/toggle", "включить=0");
	Ожидаем.Что(НайтиПодписку(ОбъектПула, Название).Активен, "хозяин выключает").ЭтоЛожь();
	ПослатьПул(Пул, Хозяин, Поправка + "/narrow", "не_присылать=1&событие_0=1");
	Ожидаем.Что(Желудь("СервисПоправокПодписок").ПоправкаОбъекта(ОбъектПула, Сверху) <> Неопределено,
		"хозяин сужает").ЭтоИстина();
	ПослатьПул(Пул, Хозяин, Поправка + "/reset", "");

КонецПроцедуры

// Гвард пакета не впустил — ни одна из десяти дверей раздела пакета (свои подписки и поправки
// к подпискам сверху) ничего не меняет и пробы не отправляет. КОНТРОЛЬ — хозяин той же формой
// выключает и сужает.
&Тест
Процедура ПостороннийНиОднойФормойНеМеняетПодпискиПакета() Экспорт

	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	Название = "пакет " + УникальныеИмена.Хвост();
	ПослатьПакет(Пул, Пакет, Хозяин, "", ПоляTelegram(Название, СвободныйЧат()));
	Объект = Желудь("СервисПодписок").ОбъектПакета(Пакет);
	Подписка = НайтиПодписку(Объект, Название);
	Сверху = ПодпискаХабаСверху();
	Поправка = "inherited/" + Ключ(Сверху);

	Двери = ДвериПодписки(Ключ(Подписка), Название, Подписка);
	Двери.Вставить(Поправка + "/narrow", "не_присылать=1&событие_0=1");
	Двери.Вставить(Поправка + "/reset", "");
	Ожидаем.Что(Двери.Количество(), "КОНТРОЛЬ: десять дверей пакета").Равно(10);
	Гвард.Впустить(Хозяин, Пул, Пакет);
	НиОднаДверьНеОтвечает(КонтроллерПакета, "пакет", ИменаАдреса(Пул, Пакет), Двери);

	Ожидаем.Что(НайтиПодписку(Объект, Название).Активен, "подписка пакета цела и включена").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПодписок").Список(Объект).Количество(), "чужая не заведена").Равно(1);
	Ожидаем.Что(Желудь("СервисПоправокПодписок").ПоправкаОбъекта(Объект, Сверху), "поправки нет").Равно(Неопределено);

	// КОНТРОЛЬ: хозяин той же формой выключает и сужает
	ПослатьПакет(Пул, Пакет, Хозяин, Ключ(Подписка) + "/toggle", "включить=0");
	Ожидаем.Что(НайтиПодписку(Объект, Название).Активен, "хозяин выключает").ЭтоЛожь();
	ПослатьПакет(Пул, Пакет, Хозяин, Поправка + "/narrow", "не_присылать=1&событие_0=1");
	Ожидаем.Что(Желудь("СервисПоправокПодписок").ПоправкаОбъекта(Объект, Сверху) <> Неопределено,
		"хозяин сужает").ЭтоИстина();
	ПослатьПакет(Пул, Пакет, Хозяин, Поправка + "/reset", "");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция РазделХаба()
	Возврат "/hub/settings/webhooks";
КонецФункции

Функция ОбъектХаба()
	Возврат Желудь("СервисПодписок").ОбъектХаба();
КонецФункции

Функция ТокенБота()
	Возврат "123456789:AAH4FqSecretBotTokenValue";
КонецФункции

Функция ПоляTelegram(Знач Название, Знач Чат)
	Возврат "название=" + Закодировать(Название) + "&тип_действия=telegram&chat-id=" + Закодировать(Чат)
		+ "&бот-токен=" + Закодировать(ТокенБота()) + "&событие_0=1";
КонецФункции

Функция ПоляВебхука(Знач Название, Знач Адрес)
	Возврат "название=" + Закодировать(Название) + "&тип_действия=вебхук&url=" + Закодировать(Адрес)
		+ "&событие_0=1";
КонецФункции

// Поля окна правки подписки Telegram: пустой токен — «оставить сохранённый».
Функция ПоляПравки(Знач Название, Знач Подписка)
	Возврат "название=" + Закодировать(Название) + "&тип_действия=telegram&chat-id=" + Подписка.URL
		+ "&событие_0=1";
КонецФункции

Функция СвободныйЧат()
	НомерЧата = ?(НомерЧата = Неопределено, 1001234567000, НомерЧата + 1);
	Возврат "-" + Формат(НомерЧата, "ЧГ=0");
КонецФункции

// Подписка хаба, заведённая окном раздела.
Функция ПодпискаХаба(Знач Название)
	Ответ = ПослатьХаб("", ПоляTelegram(Название, СвободныйЧат()));
	Ожидаем.Что(Ответ.Код, "КОНТРОЛЬ: подписка «" + Название + "» заведена").Равно(303);
	Возврат НайтиПодписку(ОбъектХаба(), Название);
КонецФункции

Функция НайтиПодписку(Знач Объект, Знач Название)

	Параметры = Желудь("ПараметрыПодписки");
	Для Каждого Подписка Из Желудь("СервисПодписок").Список(Объект) Цикл
		Если Параметры.Свойства(Подписка).Название = Название Тогда
			Возврат Подписка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция Ключ(Знач Подписка)
	Возврат Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция РазделПула(Знач Пул)
	Возврат "/pools/" + Пул.Имя + "/settings/webhooks";
КонецФункции

Функция ИменаАдреса(Знач Пул, Знач Пакет = Неопределено)
	Имена = Новый Массив();
	Имена.Добавить(Пул.Имя);
	Если Пакет <> Неопределено Тогда
		Имена.Добавить(Пакет.Имя);
	КонецЕсли;
	Возврат Имена;
КонецФункции

// Двери раздела, общие трём домам, одной записью: заведение, правка, тумблер, удаление с верным
// эхом, проба и предпросмотр формы заведения и записи.
Функция ДвериПодписки(Знач Ключ_, Знач Название, Знач Подписка)
	Двери = Новый Соответствие();
	Двери.Вставить("", ПоляTelegram("злоумышленник", СвободныйЧат()));
	Двери.Вставить(Ключ_ + "/save", ПоляПравки("злоумышленник", Подписка));
	Двери.Вставить(Ключ_ + "/toggle", "включить=0");
	Двери.Вставить(Ключ_ + "/delete", "confirmed=1&имя_подписки=" + Закодировать(Название));
	Двери.Вставить(Ключ_ + "/test", "");
	Двери.Вставить(Ключ_ + "/preview", ПоляПравки("злоумышленник", Подписка));
	Двери.Вставить("test", ПоляTelegram("злоумышленник", СвободныйЧат()));
	Двери.Вставить("preview", ПоляTelegram("злоумышленник", СвободныйЧат()));
	Возврат Двери;
КонецФункции

// Правка кита: режим пула.
Функция ПравкаРежима(Знач Пул, Знач Режим)
	Возврат "правки=1&режим=" + Закодировать("пул_" + Формат(Пул.Идентификатор, "ЧГ=0") + ":" + Режим);
КонецФункции

Функция ДверьХаба(Знач Подписка)
	Возврат РазделХаба() + "/" + Ключ(Подписка) + "/recipients";
КонецФункции

// Форма окна «Получатели» на странице ветки, как её отправит браузер без скрипта.
Функция ФормаВеткиБезСкрипта(Знач Подписка, Знач КлючВетки, Знач Действия)
	Окна = ОткрытыеОкна(ПолучитьДверьХаба(Подписка, "", КлючВетки, "1").ТелоТекст);
	Ожидаем.Что(Окна.Количество(), "КОНТРОЛЬ: страница ветки в окне").Равно(1);
	Возврат Новый ГалкиВРазметке().ФормаБезСкрипта(Окна[0], Действия);
КонецФункции

// GET двери окна «Получатели» хаба: страница ветки или найденное.
Функция ПолучитьДверьХаба(Знач Подписка, Знач Найти, Знач Ветка, Знач Страница)
	Гвард.Впустить(Админ);
	Ответ = Новый ОтветСтраницыЗаглушка();
	КонтроллерХаба.Получатели(Ответ, Ключ(Подписка), Новый Соответствие(), Новый КукиЗаглушка(), "GET", "",
		Найти, Ветка, Страница);
	Возврат Ответ;
КонецФункции

// Форма окна дерева, которая снимает галку пакета правкой кита.
Функция ПравкаСнять(Знач Пакет)
	Возврат "правки=1&снять=" + Закодировать("пакет_" + Формат(Пакет.Идентификатор, "ЧГ=0"));
КонецФункции

// Под гвардом, который не впустил, каждая дверь отвечает 403 сама и тела не пишет; проба не уходит
// и в аудит не записывается.
Процедура НиОднаДверьНеОтвечает(Знач Контроллер, Знач Дом, Знач Адрес, Знач Двери)

	Издатель = Желудь("ИздательСобытий");
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПробаПодписки(), Слушатель);
	Гвард.НеВпускать();
	Попытка
		Для Каждого Дверь Из Двери Цикл
			Ответ = Послать(Контроллер, Дом, Адрес, Дверь.Ключ, Дверь.Значение);
			Ожидаем.Что(Ответ.Код, "гвард не впустил: «" + Дверь.Ключ + "» — 403").Равно(403);
			Ожидаем.Что(Строка(Ответ.ТелоТекст), "гвард не впустил: «" + Дверь.Ключ + "» — без тела").Равно("");
		КонецЦикла;
	Исключение
		Гвард.Впустить(Админ);
		ВызватьИсключение;
	КонецПопытки;
	Гвард.Впустить(Админ);
	Ожидаем.Что(Слушатель.Количество(), "проба не ушла и в аудит не записана").Равно(0);

КонецПроцедуры

// Сколько пулов и пакетов исключено из дерева подписки: «пулов/пакетов».
Функция Исключено(Знач Объект, Знач Подписка)
	Сводка = Желудь("СервисИсключенийПодписок").СводкаИсключений(Админ, Объект, Подписка.Идентификатор);
	Возврат Формат(Сводка.Пулов, "ЧН=0") + "/" + Формат(Сводка.Пакетов, "ЧН=0");
КонецФункции

// «пулов «никакие»/пулов «выбранные»/выбрано пакетов» по сводке домена.
Функция Выбрано(Знач Объект, Знач Подписка)
	Сводка = Желудь("СервисИсключенийПодписок").СводкаИсключений(Админ, Объект, Подписка.Идентификатор);
	Возврат СтрШаблон("%1/%2/%3", Формат(Сводка.Пулов, "ЧН=0"), Формат(Сводка.Выбранных, "ЧН=0"),
		Формат(Сводка.Выбрано, "ЧН=0"));
КонецФункции

// Подписка хаба, которую разрешено сужать: её видят пул и пакет снизу.
Функция ПодпискаХабаСверху()
	Название = "сверху " + УникальныеИмена.Хвост();
	Ответ = ПослатьХаб("", ПоляTelegram(Название, СвободныйЧат()) + "&сужение_снизу=1");
	Ожидаем.Что(Ответ.Код, "КОНТРОЛЬ: подписка хаба заведена").Равно(303);
	Возврат НайтиПодписку(ОбъектХаба(), Название);
КонецФункции

Функция ПолучитьПул(Знач Пул, Знач Кто, Знач Окно)
	Гвард.Впустить(Кто);
	Ответ = Новый ОтветСтраницыЗаглушка();
	КонтроллерПула.Раздел(Ответ, Пул.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

Функция ПослатьПул(Знач Пул, Знач Кто, Знач Хвост, Знач Тело)
	Гвард.Впустить(Кто);
	Возврат Послать(КонтроллерПула, "пул", ИменаАдреса(Пул), Хвост, Тело);
КонецФункции

Функция ПолучитьПакет(Знач Пул, Знач Пакет, Знач Кто, Знач Окно)
	Гвард.Впустить(Кто, Пул, Пакет);
	Ответ = Новый ОтветСтраницыЗаглушка();
	КонтроллерПакета.Раздел(Ответ, Пул.Имя, Пакет.Имя, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "",
		"", Окно);
	Возврат Ответ;
КонецФункции

Функция ПослатьПакет(Знач Пул, Знач Пакет, Знач Кто, Знач Хвост, Знач Тело)
	Гвард.Впустить(Кто, Пул, Пакет);
	Возврат Послать(КонтроллерПакета, "пакет", ИменаАдреса(Пул, Пакет), Хвост, Тело);
КонецФункции

Функция Между(Знач HTML, Знач Начало, Знач Конец)
	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, Конец) + СтрДлина(Конец) - 1);
КонецФункции

Функция ПолучитьХаб(Знач Окно)
	Гвард.Впустить(Админ);
	Ответ = Новый ОтветСтраницыЗаглушка();
	КонтроллерХаба.Раздел(Ответ, Новый Соответствие(), Новый КукиЗаглушка(), "GET", "", "", Окно);
	Возврат Ответ;
КонецФункции

Функция ПослатьХаб(Знач Хвост, Знач Тело, Знач Кусочком = "")
	Гвард.Впустить(Админ);
	Возврат Послать(КонтроллерХаба, "хаб", Неопределено, Хвост, Тело, Кусочком);
КонецФункции

// POST в дверь раздела: "" — раздел, «test», «preview», «delivery» — двери раздела, «<ключ>/<действие>»
// — дверь подписки, «inherited/<ключ>/<действие>» — поправки к подписке сверху.
Функция Послать(Знач Контроллер, Знач Дом, Знач Адрес, Знач Хвост, Знач Тело, Знач Кусочком = "")

	Ответ = Новый ОтветСтраницыЗаглушка();
	ТелоФормы = "_csrf=токен-теста&" + Тело;
	З = Новый Соответствие();
	К = Новый КукиЗаглушка();
	Части = СтрРазделить(Хвост, "/");
	Префикс = ?(Дом = "хаб", Новый Массив(), Адрес);

	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Вызвать(Контроллер, "Раздел", Префикс, Ответ, Неопределено, З, К, ТелоФормы, Кусочком);
	ИначеЕсли Части.Количество() = 1 Тогда
		Вызвать(Контроллер, ИмяДвериРаздела(Части[0]), Префикс, Ответ, Неопределено, З, К, ТелоФормы, Кусочком);
	ИначеЕсли Части[0] = "inherited" Тогда
		ДвериПоправки = Новый Структура("narrow, reset, recipients", "Сужение", "СнятиеПоправки", "ПолучателиПоправки");
		Вызвать(Контроллер, ДвериПоправки[Части[2]], Префикс, Ответ, Части[1], З, К, ТелоФормы, Кусочком);
	Иначе
		Вызвать(Контроллер, ИмяДвериПодписки(Части[1]), Префикс, Ответ, Части[0], З, К, ТелоФормы, Кусочком);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция ИмяДвериРаздела(Знач Хвост)
	Если Хвост = "test" Тогда
		Возврат "ПробаЗаведения";
	ИначеЕсли Хвост = "preview" Тогда
		Возврат "ПредпросмотрЗаведения";
	КонецЕсли;
	Возврат "НастройкиДоставки";
КонецФункции

Функция ИмяДвериПодписки(Знач Действие)
	Двери = Новый Соответствие();
	Двери.Вставить("save", "Сохранение");
	Двери.Вставить("toggle", "Переключение");
	Двери.Вставить("delete", "Удаление");
	Двери.Вставить("test", "ПробнаяОтправка");
	Двери.Вставить("preview", "ПредпросмотрПравки");
	Двери.Вставить("recipients", "Получатели");
	Возврат Двери[Действие];
КонецФункции

// Вызов точки маршрута: имена пула и пакета из адреса, ключ записи, затем запрос; у двери пробы
// и предпросмотра — ещё «fragment».
Процедура Вызвать(Знач Контроллер, Знач Имя, Знач Префикс, Ответ, Знач Ключ, Знач З, Знач К, Знач Тело,
	Знач Кусочком)

	Аргументы = Новый Массив();
	Аргументы.Добавить(Ответ);
	Для Каждого Часть Из Префикс Цикл
		Аргументы.Добавить(Часть);
	КонецЦикла;
	Если Ключ <> Неопределено Тогда
		Аргументы.Добавить(Ключ);
	КонецЕсли;
	Аргументы.Добавить(З);
	Аргументы.Добавить(К);
	Аргументы.Добавить("POST");
	Аргументы.Добавить(Тело);
	Если СтрНайти("ПробнаяОтправка,ПробаЗаведения,ПредпросмотрПравки,ПредпросмотрЗаведения", Имя) > 0 Тогда
		Аргументы.Добавить(Кусочком);
	КонецЕсли;
	Рефлектор = Новый Рефлектор();
	Рефлектор.ВызватьМетод(Контроллер, Имя, Аргументы);
	Ответ = Аргументы[0];

КонецПроцедуры

// Разметка открытых окон страницы: <dialog …open> до своего </dialog>. Окна не вкладываются.
Функция ОткрытыеОкна(Знач HTML)

	Результат = Новый Массив();
	Остаток = HTML;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<dialog");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</dialog>");
		Окно = Лев(Остаток, Конец + 8);
		Открывающий = Лев(Окно, СтрНайти(Окно, ">"));
		Если СтрНайти(Открывающий, " open") > 0 Тогда
			Результат.Добавить(Окно);
		КонецЕсли;
		Остаток = Сред(Остаток, Конец + 9);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запись реестра с этим именем: от её <li> до следующего.
// Раскрыт ли спойлер «Настройки доставки»: открывающий <details> перед его шапкой несёт open.
Функция СпойлерРаскрыт(Знач HTML)
	Позиция = СтрНайти(HTML, "Настройки доставки");
	Начало = СтрНайти(Лев(HTML, Позиция), "<details", НаправлениеПоиска.СКонца);
	Тег_ = Сред(HTML, Начало, СтрНайти(Сред(HTML, Начало), ">"));
	Возврат СтрНайти(Тег_, " open") > 0;
КонецФункции

Функция ЗаписьРеестра(Знач HTML, Знач Имя)

	Для Каждого Кусок Из Куски(HTML, "<li") Цикл
		Если СтрНайти(Кусок, ">" + Имя + "<") > 0 Тогда
			Возврат Кусок;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Открывающий тег с признаком: <input … name="имя" …>.
Функция Тег(Знач HTML, Знач Имя, Знач Признак)

	Для Каждого Кусок Из Куски(HTML, "<" + Имя + " ") Цикл
		Тег_ = Лев(Кусок, СтрНайти(Кусок, ">"));
		Если СтрНайти(Тег_, Признак) > 0 Тогда
			Возврат Тег_;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Куски(Знач HTML, Знач Начало)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Начало);
	Пока Позиция > 0 Цикл
		Следующая = СтрНайти(HTML, Начало, , Позиция + 1);
		Результат.Добавить(Сред(HTML, Позиция, ?(Следующая = 0, СтрДлина(HTML) + 1, Следующая) - Позиция));
		Позиция = Следующая;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция АдресОкна(Знач Раздел, Знач Окно)
	Возврат Раздел + "?" + Закодировать("окно") + "=" + Закодировать(Окно);
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
