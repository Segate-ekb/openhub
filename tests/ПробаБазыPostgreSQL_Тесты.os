// Живая приёмка пробы базы на PostgreSQL: серверная СУБД — единственный бэкенд, у которого
// соединение вообще может не открыться. Нужен OSHUB_TEST_PG_DSN; SQLite на macOS arm64 нет,
// поэтому третий бэкенд хаба здесь не проверяется ничем.

#Использовать asserts
#Использовать autumn-logos
#Использовать entity
#Использовать errors
#Использовать "фикстуры"

Перем ПоискКлассов;      // фикстура КлассыСлоя — файл класса ищется по имени
Перем ЖивойИсточник;     // ИсточникДанных (entity) на КоннектореPostgreSQL
Перем ЖивойМенеджер;     // МенеджерСущностей (entity) над ним
Перем МёртвыйИсточник;   // тот же коннектор на порт, где никто не слушает
Перем МёртвыйМенеджер;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("внешние")
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_TEST_PG_DSN""))",
	Причина = "не задана переменная окружения OSHUB_TEST_PG_DSN со строкой соединения PostgreSQL")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПоднятьИсточники() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогДанных = ОбъединитьПути(КаталогМодулей, "данные", "Классы");

	ПоискКлассов.Подключить(КаталогДанных, "ПробаБазы");
	ПоискКлассов.Подключить(КаталогДанных, "ПрикладнаяНастройка");
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	ЖивойИсточник = ИсточникНа("проба-pg", ПолучитьПеременнуюСреды("OSHUB_TEST_PG_DSN"));
	ЖивойМенеджер = МенеджерНа(ЖивойИсточник);

	// Порт, на котором никто не слушает: так выглядит упавшая СУБД, и так её видит проба.
	МёртвыйИсточник = ИсточникНа("проба-pg-мёртвая", "Host=localhost;Port=15999;"
		+ "Username=openhub;Password=openhub;Database=openhub");
	МёртвыйМенеджер = МенеджерНа(МёртвыйИсточник);

КонецПроцедуры

&ПослеВсех
Процедура ЗакрытьИсточники() Экспорт

	Закрыть(ЖивойИсточник);
	Закрыть(МёртвыйИсточник);

КонецПроцедуры

&Тест
Процедура НаЖивомPostgreSQLПробаОтвечаетОк() Экспорт

	Состояние = ПробаНа(ЖивойМенеджер).Состояние();

	Ожидаем.Что(Состояние["status"], "живой PostgreSQL отвечает: " + ПричинаОтказа(Состояние)).Равно("ok");
	Ожидаем.Что(Состояние["pool"]["limit"], "предел пула источника").Равно(10);

КонецПроцедуры

&Тест
Процедура ПробаНаPostgreSQLНеДержитСоединение() Экспорт

	Проба = ПробаНа(ЖивойМенеджер);
	Для Счётчик = 1 По 3 Цикл
		Проба.Состояние();
	КонецЦикла;

	Ожидаем.Что(ЖивойИсточник.ПулСоединений().КоличествоЗанятых(),
		"после проб соединений у потоков не осталось").Равно(0);
	Ожидаем.Что(ЖивойИсточник.ПулСоединений().КоличествоСвободных() > 0,
		"а в пуле лежит переиспользуемое соединение").ЭтоИстина();

КонецПроцедуры

// Оркестратор ждёт пробу секунды, а не минуты: соединение с упавшей СУБД обязано
// отказать сразу, а не висеть до таймаута.
&Тест
Процедура УпавшаяСУБДОтвечаетБыстроИНазываетПричину() Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Состояние = ПробаНа(МёртвыйМенеджер).Состояние();
	Потрачено = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем.Что(Состояние["status"], "на мёртвом порту база не отвечает").Равно("unavailable");
	Ожидаем.Что(ЗначениеЗаполнено(Состояние["reason"]), "причина названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Состояние["reason"], ".os"),
		"в тело публичной пробы пути файлов не уходят: " + Состояние["reason"]).Равно(0);
	Ожидаем.Что(Потрачено < 5000, СтрШаблон("проба уложилась в таймаут оркестратора: %1 мс",
		Потрачено)).ЭтоИстина();
	Сообщить(СтрШаблон("Замер: проба упавшей СУБД ответила за %1 мс", Потрачено));

КонецПроцедуры

// Отказ не должен копиться: пробу зовут раз в секунды, и если каждая неудача съедает
// место в пуле, то через минуту пул кончится сам — и хаб не оживёт даже после того,
// как СУБД вернётся.
&Тест
Процедура ПовторныеОтказыНеСъедаютПул() Экспорт

	Проба = ПробаНа(МёртвыйМенеджер);
	Проба.Состояние();
	ПослеПервой = МёртвыйИсточник.ПулСоединений().КоличествоСозданных();

	Для Счётчик = 1 По 5 Цикл
		Проба.Состояние();
	КонецЦикла;

	Ожидаем.Что(МёртвыйИсточник.ПулСоединений().КоличествоСозданных(),
		"мест в пуле после пяти новых отказов не прибавилось").Равно(ПослеПервой);
	Ожидаем.Что(МёртвыйИсточник.ПулСоединений().КоличествоЗанятых(),
		"и ни одно из них не осталось за потоком").Равно(0);
	Ожидаем.Что(МёртвыйИсточник.ПулСоединений().КоличествоОжидающих(),
		"очереди проба за собой не оставила").Равно(0);

КонецПроцедуры

#Область Помощники

Функция ИсточникНа(Знач Имя, Знач СтрокаСоединения)

	Источник = Новый ИсточникДанных(Имя, Тип("КоннекторPostgreSQL"), СтрокаСоединения);
	Источник.УстановитьАвтоЗакрытие(Ложь);

	Возврат Источник;

КонецФункции

// Менеджер мёртвого источника не инициализируется — базы за ним нет; проба обязана
// пережить и это, поэтому инициализация здесь необязательная.
Функция МенеджерНа(Знач Источник)

	Менеджер = Новый МенеджерСущностей(Источник);
	Менеджер.ДобавитьКлассВМодель(Тип("ПрикладнаяНастройка"));
	Попытка
		Менеджер.Инициализировать();
	Исключение
	КонецПопытки;

	Возврат Менеджер;

КонецФункции

Функция ПричинаОтказа(Знач Состояние)
	Возврат ?(Состояние.Свойство("reason"), Состояние["reason"], "");
КонецФункции

Функция ПробаНа(Знач Менеджер)

	Лог = Логирование.ПолучитьЛог("тест.oshub.проба-pg." + Строка(Новый УникальныйИдентификатор()));

	Возврат Новый ПробаБазы(Менеджер, Лог);

КонецФункции

Процедура Закрыть(Знач Источник)

	Если Источник <> Неопределено И НЕ Источник.Закрыт() Тогда
		Попытка
			Источник.Закрыть();
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
