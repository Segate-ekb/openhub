КонецПроцедуры

// Мир: сервис + шина + подписчик + очередь на ОДНОМ реестре и общем фейковом хранилище записей.
Функция НовыйМир(Знач СторонняяДоставка = Неопределено, Знач ЛогМира = Неопределено)

	Лог = ?(ЛогМира = Неопределено, ЛогТестов(), ЛогМира);
	Издатель = Новый ИздательСобытий();
	Каталог = Новый КаталогСобытий(Издатель, Новый ЗаполнениеПула());
	Валидатор = Новый ВалидаторАдресаВебхука(НастройкиПодписок());
	HTTP = Новый ФейкТранспортHTTP();
	HTTP.УстановитьОтвет(200);
	Телеграм = Новый ФейкТранспортTelegram();

	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(HTTP, Валидатор, НастройкиПодписок(), Неопределено, Лог,
		Новый ТекстОшибки()));
	Доставки.Добавить(Новый ДоставкаTelegram(Телеграм, Новый ШаблонУведомления(Каталог),
		Лог, Новый ТекстОшибки()));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Хранения.Добавить(Новый ХранениеПодпискиTelegram(Новый ШаблонУведомления(Каталог)));
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());
	Рендеры.Добавить(Новый РендерНастроекTelegram());
	Если СторонняяДоставка <> Неопределено Тогда
		Доставки.Добавить(СторонняяДоставка);
		Хранения.Добавить(Новый ХранениеТестовогоДействия());
	КонецЕсли;
	Реестр = Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры);

	Хранилище = Новый ФейкХранилищеВебхуков();
	ПараметрыПодп = Новый ПараметрыПодписки(Каталог);
	Сервис = Новый СервисПодписок(Хранилище, Новый ФейкСервисПрав(), Реестр, Каталог,
		ПараметрыПодп, Новый АудитПробыПодписки(ИменаЖурналаСХранилищами(),
			Новый СобытиеАудита(ИменаЖурналаСХранилищами(), Новый ТекстJSON()), Издатель),
		Новый ОграничительПроб(НастройкиПроб(ПотолокПроб)),
		Новый ФейкХранилищеПользователей("100"),
		Неопределено, Издатель,
		Новый ТелоСобытия(Неопределено));
	Очередь = Новый ОчередьДоставокПодписок(Новый ФейкХранилищеЗаданийДоставки(), НастройкиПодписок(),
		Лог, Новый ПриведениеЧисел());
	Служба = Новый СлужбаДоставкиПодписок(Реестр, Очередь, НастройкиПодписок(), Лог,
		Новый ТекстОшибки());
	Подписчик = Новый ПодписчикВебхуков(Сервис, Служба, Издатель, НоваяГотовность(),
		Реестр, Лог, Новый ТекстОшибки(), Новый ТелоСобытия(Неопределено),
		Новый ОтборЗаполненияПула(ПараметрыПодп, Новый ЗаполнениеПула(), Издатель));

	Возврат Новый Структура("Издатель, Каталог, Реестр, Хранилище, Сервис, Служба, Подписчик, HTTP, Телеграм",
		Издатель, Каталог, Реестр, Хранилище, Сервис, Служба, Подписчик, HTTP, Телеграм);

КонецФункции

Функция НовыйКаталог()
	Возврат Новый КаталогСобытий(Новый ИздательСобытий(), Новый ЗаполнениеПула());
КонецФункции

// Форматтер журнала с хранилищами: адрес объекта подписки он резолвит по идентификатору,
// а без хранилищ резолв падает — в хабе форматтер приезжает желудём.
Функция ИменаЖурналаСХранилищами()
	Пулы = Новый ФейкХранилищеСущностей();
	Пулы.Добавить(Новый ФейкСущностьАудита(7, "public"));
	Возврат Новый ИмяОбъектаАудита(Пулы, Новый ФейкХранилищеСущностей());
КонецФункции

Функция Владелец()
	Возврат Новый Структура("Идентификатор, Админ", 100, Истина);
КонецФункции

// Детали записи журнала — обратным разбором, а не поиском подстроки: сторож стережёт
// форму, в которой они записаны, и переформулировка сообщения его не ломает.
Функция РазобратьДетали(Знач Текст)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Разобранное = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Разобранное;

КонецФункции

Функция ОбъектПула(Знач Сервис, Знач Ид)
	Возврат Сервис.ОбъектПула(Новый Структура("Идентификатор, Имя", Ид, "пул-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция ДанныеСобытия(Знач ПулИд, Знач ПакетИд)
	Возврат Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия",
		ПулИд, ПакетИд, "пул-" + Формат(ПулИд, "ЧГ=0"), "пакет-" + Формат(ПакетИд, "ЧГ=0"), "1.2.3");
КонецФункции

// Текст отказа создания («» — подписка создалась): отказ проверяется словами, а не фактом.
Функция ОшибкаСоздания(Знач Сервис, Знач ТипДействия, Знач Ввод)
	Попытка
		Сервис.СоздатьПодписку(Владелец(), ОбъектПула(Сервис, 7), ТипДействия, Ввод, "версия.опубликована");
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ТокенОтправкиВЧат(Знач Телеграм, Знач ЧатИд)
	Для Каждого Отправка Из Телеграм.ВсеОтправки() Цикл
		Если Отправка.ЧатИд = ЧатИд Тогда
			Возврат Отправка.Токен;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ПопыткаСоздатьПодписку(Знач Сервис, Знач ТипДействия, Знач Ввод)
	Попытка
		Сервис.СоздатьПодписку(Владелец(), ОбъектПула(Сервис, 7), ТипДействия, Ввод, "версия.опубликована");
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ПопыткаСоздать(Знач Сервис, Знач Кто, Знач Объект, Знач URL, Знач Типы)
	Попытка
		Сервис.Создать(Кто, Объект, URL, Типы);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ЕстьФайлСПрефиксом(Знач Каталог, Знач Префикс)
	Возврат НайтиФайлы(Каталог, Префикс + "*.os").Количество() > 0;
КонецФункции

// Свежая ГотовностьХаба для конструкторов стартовых задач: в юнит-тестах гейт никого не держит.
Функция НоваяГотовность()

	Попытка
		КаталогНабора = Новый Файл(ТекущийСценарий().Источник).Путь;
		КореньПроекта = Новый Файл(ОбъединитьПути(КаталогНабора, "..")).ПолноеИмя;
		ПоискКлассов.Подключить(ОбъединитьПути(ОбъединитьПути(КореньПроекта, "src", "модули"),
			"наблюдаемость", "Классы"), "ГотовностьХаба");
	Исключение
	КонецПопытки;

	Возврат Новый ГотовностьХаба(ЛогТестов());

КонецФункции

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub");
КонецФункции

// Настройки подписок для прямой сборки вне контейнера. Три попытки, а не пять: мир
// теста добивает ретраи до дропа, и пятью попытками он стал бы вдвое длиннее.
Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки(Истина, 3, 10, 10000);
	Возврат Настройки;
КонецФункции

Функция НастройкиПроб(Знач Потолок)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки(Истина, 3, 10, 10000);
	Настройки.Задать("oshub.webhooks.test_max_per_hour", Потолок);
	Возврат Настройки;
КонецФункции
