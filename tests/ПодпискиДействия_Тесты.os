&Тест
Процедура ЗаписьДо7CСчитаетсяВебхуком() Экспорт

	// строки, заведённые до появления типов действий, не несут ТипДействия: читаются как «вебхук»
	Мир = НовыйМир();
	Объект = ОбъектПула(Мир.Сервис, 7);

	Легаси = Мир.Хранилище.СоздатьЭлемент();
	Легаси.ТипОбъекта = "пул";
	Легаси.ОбъектИдентификатор = 7;
	Легаси.ПулИдентификатор = 7;
	Легаси.URL = "https://legacy.example.com/h";
	Легаси.Секрет = "s";
	Легаси.ТипыСобытий = "версия.опубликована";
	Легаси.Сохранить();
	Ожидаем.Что(Легаси.ТипДействия, "легаси-строка без типа действия").Равно("");

	Ожидаем.Что(Мир.Сервис.ТипДействияПодписки(Легаси), "пустой тип читается как вебхук").Равно("вебхук");
	Ожидаем.Что(ПопыткаСоздать(Мир.Сервис, Владелец(), Объект, "https://legacy.example.com/h",
		"версия.опубликована"), "новый вебхук на тот же URL отклонён").ЭтоИстина();

	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(),
		ДанныеСобытия(7, 42), Дата(2026, 7, 30, 12, 0, 0));
	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));
	Ожидаем.Что(Итог.Доставлено, "легаси-подписка доставлена как вебхук").Равно(1);
	Ожидаем.Что(Мир.HTTP.URLПоследний(), "POST ушёл на легаси-URL").Равно("https://legacy.example.com/h");

КонецПроцедуры

&Тест
Процедура ПапкаКаждогоТипаНесётТриРоли() Экспорт

	Папки = НайтиФайлы(КаталогОбработчиков, ПолучитьМаскуВсеФайлы());
	ИмёнПапок = 0;

	Для Каждого Папка Из Папки Цикл
		Если НЕ Папка.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		ИмёнПапок = ИмёнПапок + 1;
		Ожидаем.Что(ЕстьФайлСПрефиксом(Папка.ПолноеИмя, "Доставка"),
			СтрШаблон("в папке «%1» есть обработчик доставки (Доставка*)", Папка.Имя)).ЭтоИстина();
		Ожидаем.Что(ЕстьФайлСПрефиксом(Папка.ПолноеИмя, "Хранение"),
			СтрШаблон("в папке «%1» есть описание хранения (Хранение*)", Папка.Имя)).ЭтоИстина();
		Ожидаем.Что(ЕстьФайлСПрефиксом(Папка.ПолноеИмя, "РендерНастроек"),
			СтрШаблон("в папке «%1» есть рендер настроек (РендерНастроек*)", Папка.Имя)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(ИмёнПапок >= 2, "папки типов найдены (вебхук и telegram)").ЭтоИстина();

	// классы прямо в корне обработчиков (вне папки типа) запрещены — тип живёт папкой
	Для Каждого Файл Из НайтиФайлы(КаталогОбработчиков, "*.os") Цикл
		Ожидаем.Что(Ложь, "файл вне папки типа: " + Файл.Имя).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

