&Тест
Процедура ПробаПишетЗаписьВАудитИНеНесётСекретов() Экспорт

	Мир = НовыйМир();
	Объект = ОбъектПула(Мир.Сервис, 7);
	Токен = "111111:AAFukAn-pervy-bot";
	Подписка = Мир.Сервис.СоздатьПодписку(Владелец(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен", "-100111", Токен), "версия.опубликована");

	Слушатель = Новый ЗаписывающийПодписчик();
	Мир.Издатель.Подписать(Мир.Издатель.ТипПробаПодписки(), Слушатель);

	Мир.Телеграм.УстановитьОтказ("chat not found");
	Мир.Сервис.Проверить(Владелец(), Объект, Подписка.Идентификатор);

	Ожидаем.Что(Слушатель.Количество(), "проба записана в аудит одной строкой").Равно(1);
	Данные = Слушатель.Первое(Мир.Издатель.ТипПробаПодписки()).Данные;
	Ожидаем.Что(Данные.Действие, "действие названо").Равно("проба.подписки");
	Ожидаем.Что(Найти(Данные.ДеталиJSON, "chat not found") > 0,
		"итог пробы в деталях: " + Данные.ДеталиJSON).ЭтоИстина();
	Ожидаем.Что(Найти(Данные.ДеталиJSON, Токен), "токена в аудите нет").Равно(0);
	Ожидаем.Что(Найти(Данные.ДеталиJSON, "-100111"), "адресата в аудите тоже нет").Равно(0);

	// Форма деталей одна на весь журнал: запись пробы обязана читаться и разбираться
	// так же, как запись публикации или смены прав. Проверяется КРУГОМ, а не текстом:
	// разобранное обратно и записанное владельцем формы совпадает с тем, что уехало.
	Ожидаем.Что(Данные.ДеталиJSON,
		"детали пробы записаны той же формой, что у остальных производителей")
		.Равно(Новый ТекстJSON().СПереносами(РазобратьДетали(Данные.ДеталиJSON)));

