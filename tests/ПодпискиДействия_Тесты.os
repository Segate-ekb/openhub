Процедура ОтбитаяПробаНеПишетсяВАудит() Экспорт

	ПотолокПроб = 1;
	Мир = НовыйМир();
	Слушатель = Новый ЗаписывающийПодписчик();
	Мир.Издатель.Подписать(Мир.Издатель.ТипПробаПодписки(), Слушатель);
	Объект = ОбъектПула(Мир.Сервис, 7);
	Подписка = Мир.Сервис.Создать(Владелец(), Объект, "https://hook.example.com/a",
		"версия.опубликована");

	Мир.Сервис.Проверить(Владелец(), Объект, Подписка.Идентификатор);
	Ожидаем.Что(Слушатель.Количество(), "успешная проба в аудите есть").Равно(1);

	Попытка
		Мир.Сервис.Проверить(Владелец(), Объект, Подписка.Идентификатор);
	Исключение
		// отказ ожидаем
	КонецПопытки;

	Ожидаем.Что(Слушатель.Количество(), "отбитая проба записи в аудит не добавила").Равно(1);

