&Тест
Процедура ПробаНаПриватныйАдресУходитВСеть() Экспорт

	// НФТ-ПОДП-002 и ИСТ-ПОДП-007: годность цели показывает сама проба, а не запрет хаба.
	// Приёмник в своей сети — обычный случай, и кнопка обязана до него дойти.
	Мир = НовыйМир();
	Объект = ОбъектПула(Мир.Сервис, 7);
	Подписка = Мир.Сервис.Создать(Владелец(), Объект, "https://127.0.0.1:9000/hook",
		"версия.опубликована");

	БылоЗапросов = Мир.HTTP.КоличествоВызовов();
	Итог = Мир.Сервис.Проверить(Владелец(), Объект, Подписка.Идентификатор);

	Ожидаем.Что(Мир.HTTP.КоличествоВызовов() - БылоЗапросов,
		"проба ушла в сеть, а не отбилась запретом").Равно(1);
	Ожидаем.Что(Мир.HTTP.URLПоследний(), "и пошла именно на названный адрес")
		.Равно("https://127.0.0.1:9000/hook");
	Ожидаем.Что(Итог.Ок, "итог — ответ цели, а не отказ хаба").ЭтоИстина();

КонецПроцедуры

// ИСТ-ПОДП-007: частота проб ограничена потолком, а превышение — НАЗВАННЫЙ отказ.
// Без потолка кнопка пробы это хабовый генератор исходящих запросов по чужому адресу.
&Тест
Процедура ЧастотаПробОграниченаПотолкомИОтказНазван() Экспорт

	ПотолокПроб = 2;
	Мир = НовыйМир();
	Объект = ОбъектПула(Мир.Сервис, 7);
	Подписка = Мир.Сервис.Создать(Владелец(), Объект, "https://hook.example.com/a",
		"версия.опубликована");

	Мир.Сервис.Проверить(Владелец(), Объект, Подписка.Идентификатор);
	Мир.Сервис.Проверить(Владелец(), Объект, Подписка.Идентификатор);
	Запросов = Мир.HTTP.КоличествоВызовов();

	Причина = "";
	Попытка
		Мир.Сервис.Проверить(Владелец(), Объект, Подписка.Идентификатор);
	Исключение
		Причина = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Причина), "третья проба подряд отбита").ЭтоИстина();
	Ожидаем.Что(Найти(Причина, "2") > 0, "потолок назван числом: " + Причина).ЭтоИстина();
	Ожидаем.Что(Найти(НРег(Причина), "час") > 0, "назван период: " + Причина).ЭтоИстина();
	Ожидаем.Что(Мир.HTTP.КоличествоВызовов(),
		"отбитая проба в сеть не пошла").Равно(Запросов);

КонецПроцедуры

// Потолок принадлежит подписке, а не всему хабу: сосед по объекту не должен запирать кнопку.
&Тест
Процедура ПотолокПробСчитаетсяНаКаждуюПодпискуОтдельно() Экспорт

	ПотолокПроб = 1;
	Мир = НовыйМир();
	Объект = ОбъектПула(Мир.Сервис, 7);
	Первая = Мир.Сервис.Создать(Владелец(), Объект, "https://hook.example.com/a", "версия.опубликована");
	Вторая = Мир.Сервис.Создать(Владелец(), Объект, "https://hook.example.com/b", "версия.опубликована");

	Мир.Сервис.Проверить(Владелец(), Объект, Первая.Идентификатор);

	Отбита = Ложь;
	Попытка
		Мир.Сервис.Проверить(Владелец(), Объект, Вторая.Идентификатор);
	Исключение
		Отбита = Истина;
	КонецПопытки;

	Ожидаем.Что(Отбита, "проба соседней подписки не отбита её соседкой").ЭтоЛожь();

КонецПроцедуры

// Потолок стоит ДО обработчика: отбитая проба ни в сеть не идёт, ни в аудит не пишется —
// иначе журнал засорялся бы ровно тем, от чего потолок защищает.
