	Попытка
		Мир.Сервис.ОбновитьПодписку(Владелец(), Объект, Подписка.Идентификатор, "вебхук",
			Новый Структура("URL", "https://hook.example.com/a"), "версия.опубликована", Истина);
	Исключение
		Подмена = ОписаниеОшибки();
