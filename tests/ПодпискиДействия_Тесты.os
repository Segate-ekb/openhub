	Ожидаем.Что(Итог.Подписка.ТокенДействия,
		"пустое поле токена оставило сохранённый").Равно("111111:AAFukAn-pervy-bot");
	Ожидаем.Что(Итог.Секрет, "показывать нечего: секрет подписи типу не нужен").Равно("");

КонецПроцедуры

