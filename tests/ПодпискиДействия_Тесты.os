// Юнит- и e2e-тесты действий подписок (модуль подписки) на фейках: сторонний тип «тест.запись» из фикстур
// проходит весь боевой путь без правки ядра; telegram end-to-end; инварианты реестра; уникальность с типом действия.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогВебхуков;
Перем КаталогРеестра;   // классы, уехавшие из common к своему хозяину
Перем КаталогОбработчиков;
Перем КаталогСобытийПуть;
Перем КаталогФикстур;
Перем ПотолокПроб;   // потолок частоты пробных отправок в собираемом мире

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогВебхуков = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	КаталогОбработчиков = ОбъединитьПути(КаталогВебхуков, "обработчики");
	КаталогСобытийПуть = ОбъединитьПути(КаталогМодулей, "события", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(КаталогВебхуков, "СервисПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "СлужбаДоставкиПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОчередьДоставокПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "РеестрДействийПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "ШаблонУведомления");
	ПоискКлассов.Подключить(КаталогВебхуков, "ТелоСобытия");
	ПоискКлассов.Подключить(КаталогВебхуков, "ПодписчикВебхуков");
	ПоискКлассов.Подключить(КаталогВебхуков, "ВалидаторАдресаВебхука");
	ПоискКлассов.Подключить(КаталогВебхуков, "ПараметрыПодписки");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОтборЗаполненияПула");
	ПоискКлассов.Подключить(КаталогВебхуков, "АудитПробыПодписки");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОграничительПроб");
	КаталогCommon = ОбъединитьПути(ОбъединитьПути(КаталогВебхуков, "..", ".."), "основа", "Классы");
	ПоискКлассов.Подключить(КаталогCommon, "ПриведениеЧисел");
	ПоискКлассов.Подключить(КаталогРеестра, "ЗаполнениеПула");
	КаталогАудита = ОбъединитьПути(ОбъединитьПути(КаталогСобытийПуть, "..", ".."), "аудит", "Классы");
	ПоискКлассов.Подключить(КаталогАудита, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогАудита, "СобытиеАудита");
	ПоискКлассов.Подключить(КаталогCommon, "ТекстJSON");
	ПоискКлассов.Подключить(КаталогCommon, "ТекстОшибки");
	ПоискКлассов.Подключить(КаталогCommon, "РазборАдреса");

	Вебхук = ОбъединитьПути(КаталогОбработчиков, "вебхук");
	ПоискКлассов.Подключить(Вебхук, "ДоставкаВебхуком");
	ПоискКлассов.Подключить(Вебхук, "ХранениеПодпискиВебхука");
	ПоискКлассов.Подключить(Вебхук, "РендерНастроекВебхука");

	Телеграм = ОбъединитьПути(КаталогОбработчиков, "telegram");
	ПоискКлассов.Подключить(Телеграм, "ДоставкаTelegram");
	ПоискКлассов.Подключить(Телеграм, "ХранениеПодпискиTelegram");
	ПоискКлассов.Подключить(Телеграм, "РендерНастроекTelegram");

	ПоискКлассов.Подключить(КаталогСобытийПуть, "ИздательСобытий");
	ПоискКлассов.Подключить(КаталогСобытийПуть, "КаталогСобытий");

	ПоискКлассов.Подключить(КаталогФикстур, "ФейкХранилищеВебхуков");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкЗаданиеДоставкиЗапись");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкХранилищеЗаданийДоставки");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкВебхукЗапись");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкСервисПрав");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкХранилищеПользователей");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкХранилищеСущностей");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкСущностьАудита");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкТранспортHTTP");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкТранспортTelegram");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкВалидаторВебхука");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкРазрешительImён");
	ПоискКлассов.Подключить(КаталогФикстур, "НастройкиЗаглушка");
	ПоискКлассов.Подключить(КаталогФикстур, "ЗаписывающийОбработчикДействия");
	ПоискКлассов.Подключить(КаталогФикстур, "ХранениеТестовогоДействия");
	ПоискКлассов.Подключить(КаталогФикстур, "ЛовушкаЛога");
	ПоискКлассов.Подключить(КаталогФикстур, "ЗаписывающийПодписчик");

КонецПроцедуры

// Потолок проб по умолчанию не мешает остальным тестам; тест потолка ставит своё значение.
&ПередКаждым
Процедура ЗадатьПотолокПроб() Экспорт
	ПотолокПроб = 1000;
КонецПроцедуры

&Тест
Процедура СтороннийТипДоставляетсяЧерезОбщуюОчередьEndToEnd() Экспорт

	// тип «тест.запись» ядру неизвестен — он собран в реестр ИЗВНЕ (фикстуры)
	Обработчик = Новый ЗаписывающийОбработчикДействия();
	Мир = НовыйМир(Обработчик);

	// 1) создание подписки стороннего типа — через ОБЩИЙ вход сервиса
	Подписка = Мир.Сервис.СоздатьПодписку(Владелец(), ОбъектПула(Мир.Сервис, 7),
		"тест.запись", Новый Структура("Канал, Метка", "канал-7", "важно"), "версия.опубликована");
	Ожидаем.Что(Подписка.ТипДействия, "тип действия сохранён").Равно("тест.запись");
	Ожидаем.Что(Подписка.URL, "адрес действия — канал").Равно("канал-7");
	Ожидаем.Что(Найти(Подписка.НастройкиДействия, "важно") > 0,
		"настройки сверх адреса легли в JSON-колонку").ЭтоИстина();

	// 2) доменное событие — через ШИНУ и боевую рогатку-подписчика
	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(),
		ДанныеСобытия(7, 42), Дата(2026, 7, 30, 12, 0, 0));
	Ожидаем.Что(Мир.Служба.РазмерОчереди(), "задание стороннего типа в общей очереди").Равно(1);

	// 3) разбор общей очереди — доставку выполняет СТОРОННИЙ обработчик
	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));
	Ожидаем.Что(Итог.Доставлено, "доставлено ядром без спецслучая").Равно(1);
	Доставка = Обработчик.ПоследняяДоставка();
	Ожидаем.Что(Доставка.Канал, "настройки доставки развёрнуты хранением типа").Равно("канал-7");
	Ожидаем.Что(Доставка.ТипСобытия, "тип события доехал").Равно("версия.опубликована");
	Ожидаем.Что(Найти(Доставка.Тело, """пул"":""пул-7""") > 0, "тело события доехало").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтороннийТипУчаствуетВРетраяхИДропеЯдра() Экспорт

	// изоляция сбоев и лимиты ядра — ОБЩИЕ для всех типов, включая сторонние
	Обработчик = Новый ЗаписывающийОбработчикДействия();
	Обработчик.УстановитьНеуспех();
	Мир = НовыйМир(Обработчик);
	Момент = Дата(2026, 7, 30, 12, 0, 0);

	Мир.Служба.Поставить("тест.запись", Новый Структура("Канал, Метка", "к", ""),
		"версия.опубликована", "{}", Момент);

	Итог1 = Мир.Служба.ОбработатьПартию(Момент);
	Ожидаем.Что(Итог1.Повторно, "неуспех стороннего типа → ретрай ядра").Равно(1);

	// исчерпание попыток (МаксПопыток=3 в НовыйМир)
	Момент2 = Момент;
	Для Шаг = 1 По 5 Цикл
		Момент2 = Момент2 + 3600;
		Мир.Служба.ОбработатьПартию(Момент2);
	КонецЦикла;
	Ожидаем.Что(Мир.Служба.РазмерОчереди(), "после лимита попыток задание отброшено").Равно(0);
	Ожидаем.Что(Обработчик.КоличествоДоставок(), "ровно МаксПопыток попыток").Равно(3);

КонецПроцедуры

&Тест
Процедура ОтказПроверкиСтороннегоТипаДропаетБезРетраев() Экспорт

	Обработчик = Новый ЗаписывающийОбработчикДействия();
	Обработчик.УстановитьОтказПроверки("канал закрыт");
	Мир = НовыйМир(Обработчик);
	Момент = Дата(2026, 7, 30, 12, 0, 0);

	Мир.Служба.Поставить("тест.запись", Новый Структура("Канал, Метка", "к", ""),
		"версия.опубликована", "{}", Момент);
	Итог = Мир.Служба.ОбработатьПартию(Момент);

	Ожидаем.Что(Итог.Отброшено, "не Ок из ПередДоставкой → дроп").Равно(1);
	Ожидаем.Что(Обработчик.КоличествоДоставок(), "самой доставки не было").Равно(0);
	Ожидаем.Что(Мир.Служба.РазмерОчереди(), "без ретраев").Равно(0);

КонецПроцедуры

&Тест
Процедура ИсключениеИзПроверкиИзолированоИНеТеряетСоседниеЗадания() Экспорт

	// ПередДоставкой, бросивший исключение, не роняет ОбработатьПартию и не теряет задания других подписок
	Обработчик = Новый ЗаписывающийОбработчикДействия();
	Обработчик.УстановитьИсключениеПроверки();
	Мир = НовыйМир(Обработчик);
	Момент = Дата(2026, 7, 30, 12, 0, 0);

	Мир.Служба.Поставить("тест.запись", Новый Структура("Канал, Метка", "к", ""),
		"версия.опубликована", "{}", Момент);
	Мир.Служба.Поставить("telegram", Новый Структура("ЧатИд, Токен", "42", "3:AAFukAn-sosed"),
		"версия.опубликована", "{}", Момент);

	Упало = Ложь;
	Итог = Неопределено;
	Попытка
		Итог = Мир.Служба.ОбработатьПартию(Момент);
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "ОбработатьПартию не выбрасывает наружу").ЭтоЛожь();
	Ожидаем.Что(Итог.Доставлено, "соседнее задание доставлено, не потеряно").Равно(1);
	Ожидаем.Что(Мир.Телеграм.КоличествоОтправок(), "telegram-отправка состоялась").Равно(1);
	Ожидаем.Что(Итог.Повторно, "бросившее задание — ретрай, а не молчаливая потеря").Равно(1);
	Ожидаем.Что(Мир.Служба.РазмерОчереди(), "оно вернулось в очередь с бэкоффом").Равно(1);

	// постоянный сбой проверки упирается в МаксПопыток (3 в НовыйМир) и дропается
	Момент2 = Момент;
	Для Шаг = 1 По 5 Цикл
		Момент2 = Момент2 + 3600;
		Мир.Служба.ОбработатьПартию(Момент2);
	КонецЦикла;
	Ожидаем.Что(Мир.Служба.РазмерОчереди(), "постоянный сбой проверки не живёт вечно").Равно(0);

КонецПроцедуры

&Тест
Процедура ПодпискаTelegramДоставляетсяEndToEnd() Экспорт

	Мир = НовыйМир();

	Подписка = Мир.Сервис.СоздатьПодписку(Владелец(), ОбъектПула(Мир.Сервис, 7),
		"telegram", Новый Структура("ЧатИд, Токен", "-1001234567890", "424242:AAFukAn-token-podpiski"), "версия.опубликована");
	Ожидаем.Что(Подписка.ТипДействия, "тип действия").Равно("telegram");
	Ожидаем.Что(Подписка.URL, "chat_id — адрес подписки").Равно("-1001234567890");
	Ожидаем.Что(Подписка.Секрет, "секрета подписи у telegram-подписки нет").Равно("");

	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(),
		ДанныеСобытия(7, 42), Дата(2026, 7, 30, 12, 0, 0));

	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));
	Ожидаем.Что(Итог.Доставлено, "доставлено").Равно(1);

	Отправка = Мир.Телеграм.ПоследняяОтправка();
	Ожидаем.Что(Отправка.Токен, "токен — С ПОДПИСКИ, общего бота у хаба нет").Равно("424242:AAFukAn-token-podpiski");
	Ожидаем.Что(Отправка.ЧатИд, "chat_id — С ПОДПИСКИ").Равно("-1001234567890");
	Ожидаем.Что(Найти(Отправка.Текст, "Версия опубликована") > 0,
		"текст несёт человеческую подпись события").ЭтоИстина();
	Ожидаем.Что(Найти(Отправка.Текст, "пул-7/пакет-42 1.2.3") > 0,
		"текст несёт координату пул/пакет версия").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезТокенаПодпискаНеЗаводитсяИЗаданиеДропается() Экспорт

	// общего бота у хаба нет: писать чужим ботом от имени хаба нельзя, и «пусто» больше
	// не значит «бот инсталляции» — значит «подписки не будет»
	Мир = НовыйМир();
	Ошибка = ОшибкаСоздания(Мир.Сервис, "telegram", Новый Структура("ЧатИд", "-100777"));
	Ожидаем.Что(Найти(Ошибка, "Не задан токен") > 0,
		"подписка без токена не заводится: " + Ошибка).ЭтоИстина();
	Ожидаем.Что(Найти(Ошибка, "@BotFather") > 0, "сказано, где взять токен").ЭтоИстина();

	// задание могло пережить правку записи — гейт доставки остаётся
	Момент = Дата(2026, 7, 30, 12, 0, 0);
	Мир.Служба.Поставить("telegram", Новый Структура("ЧатИд", "42"),
		"версия.опубликована", "{}", Момент);
	Итог = Мир.Служба.ОбработатьПартию(Момент);

	Ожидаем.Что(Итог.Отброшено, "задание без токена → дроп").Равно(1);
	Ожидаем.Что(Мир.Телеграм.КоличествоОтправок(), "сетевой попытки не было").Равно(0);
	Ожидаем.Что(Мир.Служба.РазмерОчереди(), "ретраи не жгутся впустую").Равно(0);

КонецПроцедуры

&Тест
Процедура УКаждойПодпискиСвойБот() Экспорт

	// два пакета одного пула уведомляют себя РАЗНЫМИ ботами: общего бота, которым мог бы
	// воспользоваться любой мейнтейнер, у хаба нет
	Мир = НовыйМир();
	Объект = ОбъектПула(Мир.Сервис, 7);

	Мир.Сервис.СоздатьПодписку(Владелец(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен", "-100111", "111111:AAFukAn-pervy-bot"), "версия.опубликована");
	Мир.Сервис.СоздатьПодписку(Владелец(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен", "-100222", "222222:AAFukAn-vtoroy-bot"), "версия.опубликована");

	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(),
		ДанныеСобытия(7, 42), Дата(2026, 7, 30, 12, 0, 0));
	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

	Ожидаем.Что(Итог.Доставлено, "доставлены обе подписки").Равно(2);
	Ожидаем.Что(ТокенОтправкиВЧат(Мир.Телеграм, "-100111"),
		"первая ушла своим токеном").Равно("111111:AAFukAn-pervy-bot");
	Ожидаем.Что(ТокенОтправкиВЧат(Мир.Телеграм, "-100222"),
		"вторая — своим, а не соседним").Равно("222222:AAFukAn-vtoroy-bot");

КонецПроцедуры

&Тест
Процедура НепохожийТокенБотаОтклонёнБезЭхаЗначения() Экспорт

	Мир = НовыйМир();
	Плохие = Новый Массив();
	Плохие.Добавить("просто-строка");            // нет двоеточия
	Плохие.Добавить("абв:секретная-часть-ххх");  // слева не число
	Плохие.Добавить("42:коротко");               // секретная часть короче предела
	Плохие.Добавить("42:секрет с пробелом ааа"); // пробел порвал бы адрес Bot API
	Плохие.Добавить("");                         // токен обязателен

	Для Каждого Токен Из Плохие Цикл
		Ошибка = ОшибкаСоздания(Мир.Сервис, "telegram", Новый Структура("ЧатИд, Токен", "-100999", Токен));
		Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
			СтрШаблон("токен «%1» отклонён", Токен)).ЭтоИстина();
		Если ЗначениеЗаполнено(Токен) Тогда
			Ожидаем.Что(Найти(Ошибка, Токен),
				"значения токена в тексте отказа нет: он ушёл бы на страницу и в журнал").Равно(0);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТокенНеПопадаетВЛогНиПриОтказеBotAPIНиПриСбоеСети() Экспорт

	// диагностику собирает чужая библиотека: и описание отказа, и текст исключения несут
	// адрес Bot API вместе с токеном, а печатает их наше ядро доставки
	Токен = "424242:tokeN-kotorogo-v-loge-byt-ne-dolzhno";
	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.телеграм.токен");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Попытка
		Момент = Дата(2026, 7, 30, 12, 0, 0);

		Отказ = НовыйМир(Неопределено, Лог);
		Отказ.Телеграм.УстановитьОтказ("Unauthorized: https://api.telegram.org/bot" + Токен + "/sendMessage");
		Отказ.Служба.Поставить("telegram", Новый Структура("ЧатИд, Токен", "42", Токен),
			"версия.опубликована", "{}", Момент);
		Отказ.Служба.ОбработатьПартию(Момент);

		Сбой = НовыйМир(Неопределено, Лог);
		Сбой.Телеграм.ЭмулироватьОффлайн("Сетевой сбой на https://api.telegram.org/bot" + Токен + "/sendMessage");
		Сбой.Служба.Поставить("telegram", Новый Структура("ЧатИд, Токен", "42", Токен),
			"версия.опубликована", "{}", Момент);
		Сбой.Служба.ОбработатьПартию(Момент);
	Исключение
		Лог.УдалитьСпособВывода(Ловушка);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(Ловушка.Количество() > 0, "ассерт не пуст: ядро вообще что-то записало").ЭтоИстина();
	Ожидаем.Что(Найти(Ловушка.Всё(), Токен),
		"токена нет ни в одной строке журнала: " + Ловушка.Всё()).Равно(0);
	Ожидаем.Что(Найти(Ловушка.Всё(), "tokeN-kotorogo"), "и обрывка тоже нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ШаблонПодпискиРазворачиваетсяИНеЛомаетсяСпецсимволами() Экспорт

	// имя пакета приходит от публикующего: «*_[)» ломало бы разметку мессенджера,
	// поэтому текст уходит без разметки и подставляется одним проходом
	Мир = НовыйМир();
	Объект = ОбъектПула(Мир.Сервис, 7);

	Мир.Сервис.СоздатьПодписку(Владелец(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100444", "5:AAFukAn-shablon",
			"{событие}: {пакет} {версия} в {пул} — {ссылка}"), "версия.опубликована");

	Данные = ДанныеСобытия(7, 42);
	Данные.Вставить("ИмяПакета", "*_[)пакет{пул}");
	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), Данные,
		Дата(2026, 7, 30, 12, 0, 0));
	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

	Ожидаем.Что(Итог.Доставлено, "доставка со спецсимволами в имени состоялась").Равно(1);

	Текст = Мир.Телеграм.ПоследняяОтправка().Текст;
	Ожидаем.Что(Найти(Текст, "Версия опубликована: *_[)пакет{пул} 1.2.3 в пул-7") > 0,
		"шаблон развёрнут, имя пакета доехало дословно: " + Текст).ЭтоИстина();
	Ожидаем.Что(Найти(Текст, "{пул} 1.2.3 в пул-7") > 0,
		"значение второй раз не разворачивается: «{пул}» из имени пакета осталось текстом").ЭтоИстина();

КонецПроцедуры

