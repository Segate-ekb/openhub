// Обработчик фонового задания: публикует события, пока стартовые рогатки на них подписываются, —
// так первые запросы приходят к хабу, ещё не закончившему старт; первую жалобу запоминает.

Перем Издатель;     // ИздательСобытий
Перем Типы;         // Массив - типы событий, которые поток публикует по кругу
Перем Старт;        // Число - момент (мс UTC), с которого поток публикует
Перем Срок;         // Число - момент (мс UTC), до которого поток публикует
Перем Жалоба;       // Строка - текст сбоя публикации; "" — поток отработал чисто

// Жалоба потока: текст сбоя публикации; пустая строка — каждая публикация прошла.
//
// Возвращаемое значение:
//  Строка - жалоба потока.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Старт Цикл
	КонецЦикла;

	Данные = Новый Структура("Метка", "во время старта");
	Попытка
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
			Для Каждого Тип Из Типы Цикл
				Издатель.Опубликовать(Тип, Данные);
			КонецЦикла;
		КонецЦикла;
	Исключение
		Жалоба = "публикация события упала: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ОбщийИздатель, Знач ТипыСобытий, Знач МоментСтарта, Знач МоментКонца)
	Издатель = ОбщийИздатель;
	Типы = ТипыСобытий;
	Старт = МоментСтарта;
	Срок = МоментКонца;
	Жалоба = "";
КонецПроцедуры
