// Обработчик фонового задания: как стартовая рогатка, подписывает своих подписчиков на общие типы
// событий издателя, начиная в общий для всех потоков момент; первую жалобу запоминает, судит набор.

Перем Издатель;     // ИздательСобытий
Перем Типы;         // Массив - типы событий в том порядке, в каком поток на них подписывается
Перем Старт;        // Число - момент (мс UTC), с которого все потоки подписываются разом
Перем Подписчики;   // Массив - Структура(Тип, Подписчик) на каждую сделанную подписку
Перем Жалоба;       // Строка - текст сбоя подписки; "" — поток отработал чисто

// Жалоба потока: текст сбоя подписки; пустая строка — все подписки приняты.
//
// Возвращаемое значение:
//  Строка - жалоба потока.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Подписки, которые поток сделал.
//
// Возвращаемое значение:
//  Массив - Структура(Тип, Подписчик): тип события и ФейкПодписчик, подписанный на него.
//
Функция Подписчики() Экспорт
	Возврат Подписчики;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Старт Цикл
	КонецЦикла;

	Попытка
		Для Каждого Тип Из Типы Цикл
			Подписчик = Новый ФейкПодписчик();
			Издатель.Подписать(Тип, Подписчик);
			Подписчики.Добавить(Новый Структура("Тип, Подписчик", Тип, Подписчик));
		КонецЦикла;
	Исключение
		Жалоба = "подписка на событие упала: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ОбщийИздатель, Знач ТипыСобытий, Знач МоментСтарта)
	Издатель = ОбщийИздатель;
	Типы = ТипыСобытий;
	Старт = МоментСтарта;
	Подписчики = Новый Массив();
	Жалоба = "";
КонецПроцедуры
