// Издатель событий на старте хаба: стартовые рогатки подписываются каждая в своём потоке, пока
// первые запросы уже публикуют события. Подписка не роняет старт и не теряется.

#Использовать asserts
#Использовать "../фикстуры"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "события", "Классы"), "ИздательСобытий");

	РеестрФикстур.Подключить("ФейкПодписчик");
	РеестрФикстур.Подключить("ПодпискаНаСобытияПотоком");
	РеестрФикстур.Подключить("ПубликацияСобытийПотоком");

КонецПроцедуры

// Шестнадцать рогаток разом подписываются на одни и те же типы, пока два потока публикуют: ни одна
// подписка и ни одна публикация не падает, каждая подписка на месте и получает следующее событие.
&Тест
Процедура ПодпискиСтартовыхРогатокНеПадаютИНеТеряются() Экспорт

	Издатель = Новый ИздательСобытий();
	Типы = ТипыСобытий(60);
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах() + 500;

	Рогатки = Новый Массив();
	Для Номер = 1 По 16 Цикл
		Рогатки.Добавить(Новый ПодпискаНаСобытияПотоком(Издатель, СоСдвигом(Типы, Номер * 7), Старт));
	КонецЦикла;
	Запросы = Новый Массив();
	Для Номер = 1 По 2 Цикл
		Запросы.Добавить(Новый ПубликацияСобытийПотоком(Издатель, Типы, Старт, Старт + 1000));
	КонецЦикла;
	ДождатьсяПотоков(Рогатки, Запросы);

	Ожидаем.Что(Жалобы(Рогатки), "ни одна подписка рогатки не упала").Равно("");
	Ожидаем.Что(Жалобы(Запросы), "ни одна публикация во время старта не упала").Равно("");

	Для Каждого Тип Из Типы Цикл
		Ожидаем.Что(Издатель.КоличествоПодписчиков(Тип), СтрШаблон("подписки на ""%1"" на месте", Тип))
			.Равно(Рогатки.Количество());
	КонецЦикла;

	Данные = Новый Структура("Метка", "после старта");
	Для Каждого Тип Из Типы Цикл
		Издатель.Опубликовать(Тип, Данные);
	КонецЦикла;
	Ожидаем.Что(НеПолучилиСобытие(Рогатки, Данные.Метка), "каждый подписчик получил событие после старта")
		.Равно("");
	Ожидаем.Что(Издатель.ПропущенныхДоставок(), "ни одна доставка не пропущена").Равно(0);

КонецПроцедуры

#Область Служебное

Функция ТипыСобытий(Знач Количество)

	Типы = Новый Массив();
	Для Номер = 1 По Количество Цикл
		Типы.Добавить(СтрШаблон("старт.событие.%1", Формат(Номер, "ЧГ=")));
	КонецЦикла;
	Возврат Типы;

КонецФункции

// Рогатки подписываются на общие типы в разном порядке — новые типы появляются в карте из многих
// потоков сразу.
Функция СоСдвигом(Знач Типы, Знач Сдвиг)

	Итог = Новый Массив();
	Всего = Типы.Количество();
	Для Номер = 0 По Всего - 1 Цикл
		Итог.Добавить(Типы[(Номер + Сдвиг) % Всего]);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// С таймаутом: запертый поток краснит набор, а не вешает его.
Процедура ДождатьсяПотоков(Знач Рогатки, Знач Запросы)

	Задания = Новый Массив();
	Для Каждого Поток Из Рогатки Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(Поток, "Исполнить"));
	КонецЦикла;
	Для Каждого Поток Из Запросы Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(Поток, "Исполнить"));
	КонецЦикла;

	Доработали = 0;
	Для Каждого Задание Из Задания Цикл
		Если Задание.ОжидатьЗавершения(60000) Тогда
			Доработали = Доработали + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Доработали, "все потоки доработали до конца, ни один не завис")
		.Равно(Задания.Количество());

КонецПроцедуры

Функция Жалобы(Знач Потоки)

	Итог = Новый Массив();
	Для Каждого Поток Из Потоки Цикл
		Если ЗначениеЗаполнено(Поток.Жалоба()) Тогда
			Итог.Добавить(Поток.Жалоба());
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Итог, Символы.ПС);

КонецФункции

Функция НеПолучилиСобытие(Знач Рогатки, Знач Метка)

	Итог = Новый Массив();
	Для Каждого Рогатка Из Рогатки Цикл
		Для Каждого Подписка Из Рогатка.Подписчики() Цикл
			Последнее = Подписка.Подписчик.Последнее();
			Если Последнее = Неопределено ИЛИ Последнее.Данные.Метка <> Метка Тогда
				Итог.Добавить(Подписка.Тип);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Итог, ", ");

КонецФункции

#КонецОбласти
