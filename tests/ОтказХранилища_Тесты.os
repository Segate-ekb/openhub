// Отказ хранилища не теряет причину по дороге: хранилище называет отказ машинным кодом
// (resource.not_found / dependency.unavailable), обёртки сохраняют исходную ошибку причиной,
// выдача и публикация судят по коду, а не по словам в тексте чужой библиотеки.

#Использовать asserts
#Использовать autumn-logos
#Использовать errors
#Использовать "фикстуры"

Перем ПоискКлассов;     // фикстура КлассыСлоя — файл класса ищется по имени
Перем ТекстБиблиотеки;  // как библиотека хранилища сообщает об отсутствии объекта
Перем ТекстНедоступности;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ТекстБиблиотеки = "storage backend says: object vanished";
	ТекстНедоступности = "MinIO не отвечает: connection refused";

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Основа = ОбъединитьПути(КаталогМодулей, "основа", "Классы");
	ПоискКлассов.Подключить(Основа, "ТекстОшибки");
	ПоискКлассов.Подключить(Основа, "ЗаголовкиHTTP");
	ПоискКлассов.Подключить(Основа, "ЗаголовкиКэша");
	ПоискКлассов.Подключить(Основа, "ТихаяУборка");

	Хранилище = ОбъединитьПути(КаталогМодулей, "хранилище", "Классы");
	ПоискКлассов.Подключить(Хранилище, "КоординатыАртефакта");
	ПоискКлассов.Подключить(Хранилище, "РаскладкаКлючейS3");
	ПоискКлассов.Подключить(Хранилище, "РаскладкаФайловХранилища");
	ПоискКлассов.Подключить(Хранилище, "КвотаХранилища");
	ПоискКлассов.Подключить(Хранилище, "ПомощникАртефакта");
	ПоискКлассов.Подключить(Хранилище, "ВердиктОтветаS3");
	ПоискКлассов.Подключить(Хранилище, "S3Хранилище");
	ПоискКлассов.Подключить(Хранилище, "ФайловоеХранилище");

	ИнтерфейсAPI = ОбъединитьПути(КаталогМодулей, "api", "Классы");
	ПоискКлассов.Подключить(ИнтерфейсAPI, "РезолверФайлаПакета");
	ПоискКлассов.Подключить(ИнтерфейсAPI, "КонтроллерВыдачиAPI");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "публикация", "Классы"),
		"КонтроллерПубликации");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		"ОбезличиваниеЖурнала");

	РеестрФикстур.Подключить("ФейкКлиентS3");
	РеестрФикстур.Подключить("ФейкРезолверВыдачи");
	РеестрФикстур.Подключить("ФейкПубликацииПадающий");
	РеестрФикстур.Подключить("ПерехватчикПубликацииЗаглушка");
	РеестрФикстур.Подключить("ДопускКПулуЗаглушка");
	РеестрФикстур.Подключить("СборкаКонтроллераВыдачи");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиОтветаЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");

КонецПроцедуры

#Область ВердиктПоОтветуХранилища

// Приговор читается из СТРУКТУРЫ ответа oint, поэтому проверяется на ней же: без сети,
// без клиента и без фейка, который мог бы решить за хранилище.
&Тест
Процедура ОтветСтатусом404ЭтоОтсутствиеОбъекта() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ожидаем.Что(Вердикт.ЭтоОтсутствие(Ответ(404)), "404 — объекта нет").ЭтоИстина();
	Ожидаем.Что(Вердикт.Успех(Ответ(404)), "404 успехом не считается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтветСтатусом500ОтсутствиемНеЯвляется() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ожидаем.Что(Вердикт.ЭтоОтсутствие(Ответ(500)),
		"500 — это «не смогли», а не «нет объекта»").ЭтоЛожь();
	Ожидаем.Что(Вердикт.ЭтоОтсутствие(ОтветСКодомОшибки(500, "InternalError")),
		"машинный код InternalError отсутствием не является").ЭтоЛожь();

КонецПроцедуры

// NoSuchKey приезжает и не с 404: закрытый листингом бакет отвечает 403, но объект
// при этом честно отсутствует.
&Тест
Процедура КодNoSuchKeyОпознаётсяПриЛюбомСтатусе() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ожидаем.Что(Вердикт.ЭтоОтсутствие(ОтветСКодомОшибки(403, "NoSuchKey")),
		"403 с NoSuchKey — объекта нет").ЭтоИстина();
	Ожидаем.Что(Вердикт.ЭтоОтсутствие(ОтветСКодомОшибки(403, "nosuchkey")),
		"регистр машинного кода приговор не меняет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УспешныйОтветНеОтсутствиеИНеОтказ() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ожидаем.Что(Вердикт.Успех(Ответ(200)), "200 — успех").ЭтоИстина();
	Ожидаем.Что(Вердикт.ЭтоОтсутствие(Ответ(200)), "успех отсутствием не является").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтветБезСтатусаНеВыдаётсяЗаОтсутствие() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ожидаем.Что(Вердикт.Статус(Новый Структура("мусор", 1)), "статуса нет — ноль").Равно(0);
	Ожидаем.Что(Вердикт.Статус("вообще не структура"), "не структура — ноль").Равно(0);
	Ожидаем.Что(Вердикт.ЭтоОтсутствие(Новый Структура("мусор", 1)),
		"молчащий ответ отсутствием не объявляется").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Успех(Новый Структура("мусор", 1)),
		"молчащий ответ успехом не объявляется").ЭтоЛожь();

КонецПроцедуры

// Рядом с Error.Code S3 кладёт эхо AccessKeyId — в текст исключения оно попасть не должно.
&Тест
Процедура ПояснениеОтказаНеситКодИСообщениеИБольшеНичего() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ошибка = Новый Соответствие();
	Ошибка.Вставить("Code", "SignatureDoesNotMatch");
	Ошибка.Вставить("Message", "подпись не сошлась");
	Ошибка.Вставить("AWSAccessKeyId", "AKIAСЕКРЕТНЫЙКЛЮЧ");

	Пояснение = Вердикт.ПояснениеОтказа(ОтветСТеломОшибки(403, Ошибка));

	Ожидаем.Что(Пояснение, "код назван").Содержит("SignatureDoesNotMatch");
	Ожидаем.Что(Пояснение, "сообщение названо").Содержит("подпись не сошлась");
	Ожидаем.Что(СтрНайти(Пояснение, "AKIAСЕКРЕТНЫЙКЛЮЧ"),
		"эхо ключа доступа в пояснение не едет: " + Пояснение).Равно(0);

КонецПроцедуры

// Вопрос «есть ли объект» имеет три ответа, а не два: есть, нет и «хранилище не ответило».
// Третий обязан отличаться от второго — иначе лежащее хранилище выглядит как «пакета нет».
&Тест
Процедура МолчаниеХранилищаОтличаетсяОтОтсутствияОбъекта() Экспорт

	Вердикт = Новый ВердиктОтветаS3();

	Ожидаем.Что(Вердикт.ХранилищеНеОтветилоПоСуществу(Ответ(200)),
		"успешный ответ — это «есть»").ЭтоЛожь();
	Ожидаем.Что(Вердикт.ХранилищеНеОтветилоПоСуществу(Ответ(404)),
		"404 — это «нет», ответ по существу").ЭтоЛожь();
	Ожидаем.Что(Вердикт.ХранилищеНеОтветилоПоСуществу(ОтветСКодомОшибки(403, "NoSuchKey")),
		"403 с NoSuchKey — тоже «нет»").ЭтоЛожь();
	Ожидаем.Что(Вердикт.ХранилищеНеОтветилоПоСуществу(Ответ(500)),
		"500 — не «нет», а «не ответило»").ЭтоИстина();
	Ожидаем.Что(Вердикт.ХранилищеНеОтветилоПоСуществу(ОтветСКодомОшибки(500, "InternalError")),
		"машинный код чужой ошибки отсутствием не становится").ЭтоИстина();
	Ожидаем.Что(Вердикт.ХранилищеНеОтветилоПоСуществу(Новый Структура("мусор", 1)),
		"молчащий ответ — «не ответило»").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ХранилищеНазываетОтказКодом

&Тест
Процедура ОтсутствиеАртефактаНазываетсяКодомРесурсНеНайден() Экспорт

	Сбой = СбойЧтения(S3НадФейком(ФейкПустой()));

	Ожидаем.Что(Сбой <> Неопределено, "чтение отсутствующего артефакта обязано упасть").ЭтоИстина();
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()),
		"«артефакта нет» опознаётся кодом: " + Представление(Сбой)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НедоступностьХранилищаНазываетсяДругимКодом() Экспорт

	Сбой = СбойЧтения(S3НадФейком(ФейкНедоступный()));

	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ЗависимостьНедоступна()),
		"«хранилище недоступно» — свой код: " + Представление(Сбой)).ЭтоИстина();
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()),
		"недоступность не выдаётся за отсутствие артефакта").ЭтоЛожь();

КонецПроцедуры

// Вердикт держится на ОТВЕТЕ хранилища. Библиотека вправе переписать своё сообщение
// хоть по-английски — приговор хаба от этого не меняется.
&Тест
Процедура СменаТекстаБиблиотекиВердиктНеМеняет() Экспорт

	Фейк = ФейкПустой();
	Фейк.ГоворитьОбОтсутствииТак(ТекстБиблиотеки);

	Сбой = СбойЧтения(S3НадФейком(Фейк));

	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()),
		"код тот же при чужой формулировке: " + Представление(Сбой)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбёрткаХранилищаСохраняетИсходнуюПричину() Экспорт

	Фейк = ФейкПустой();
	Фейк.ГоворитьОбОтсутствииТак(ТекстБиблиотеки);

	Разбор = ДиагностикаОшибок.Разобрать(СбойЧтения(S3НадФейком(Фейк)));

	Ожидаем.Что(Разбор.КорневаяПричина().Сообщение(),
		"корневой причиной осталась ошибка библиотеки хранилища дословно").Равно(ТекстБиблиотеки);
	Ожидаем.Что(Разбор.КраткоеПредставление(),
		"обёртка добавила координаты артефакта, не съев причину")
		.Содержит("main/pkg/pkg-1.0.0.ospx");
	// формулировку обёртки выбирает КОД причины: чужой текст библиотеки не должен
	// превращать «артефакта нет» в общее «хранилище не отдало»
	Ожидаем.Что(Разбор.КраткоеПредставление(),
		"обёртка назвала отсутствие отсутствием, хотя библиотека сказала это по-своему")
		.Содержит("Артефакт не найден в хранилище");

КонецПроцедуры

&Тест
Процедура ФайловоеХранилищеГоворитТемЖеКодом() Экспорт

	Корень = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-отказ-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Корень);

	Попытка
		Сбой = СбойЧтения(Новый ФайловоеХранилище(Корень));
	Исключение
		УдалитьФайлы(Корень);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(Корень);

	Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()),
		"оба бэкенда называют отсутствие одним кодом: " + Представление(Сбой)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ВыдачаСудитПоКоду

&Тест
Процедура ОтсутствиеАртефактаВХранилищеОтдаёт404СНазваннымАртефактом() Экспорт

	Ответ = ОтветВыдачи(ОтказХранилища(ФейкПустой()));

	Ожидаем.Что(Ответ.Код, "«артефакта нет» — это 404, а не 502").Равно(404);
	Ожидаем.Что(Ответ.ТелоТекст, "в теле назван запрошенный артефакт").Содержит("pkg-1.0.0.ospx");
	Ожидаем.Что(Ответ.ТелоТекст, "в теле назван пул артефакта").Содержит("main");

КонецПроцедуры

// Хранилище отвечает не по существу на вопрос «есть ли объект»: тихое «нет» увело бы
// выдачу в 404 «пакета нет», и opm сообщил бы, что пакета не существует.
&Тест
Процедура МолчащееХранилищеНаВопросОНаличииДаёт503АНе404() Экспорт

	Фейк = ФейкНедоступный();
	Хранилище = S3НадФейком(Фейк);

	Сбой = Неопределено;
	Попытка
		Хранилище.Существует(Новый КоординатыАртефакта("main", "pkg", "1.0.0"));
	Исключение
		Сбой = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(Сбой <> Неопределено,
		"«есть ли объект» на недоступном хранилище — не Ложь, а отказ").ЭтоИстина();
	Ожидаем.Что(ОтветВыдачи(Сбой).Код, "выдача отвечает 503, а не 404").Равно(503);

КонецПроцедуры

&Тест
Процедура НедоступноеХранилищеОтдаёт503() Экспорт

	Ответ = ОтветВыдачи(ОтказХранилища(ФейкНедоступный()));

	Ожидаем.Что(Ответ.Код, "недоступное хранилище — 503, клиенту есть смысл повторить").Равно(503);
	Ожидаем.Что(ЗначениеЗаполнено(Ответ.Заголовок("Retry-After")),
		"503 называет, через сколько повторять").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбойБезМашинногоКодаОстаётся502() Экспорт

	Ответ = ОтветВыдачи("резолвер сорвался на индексе апстрима");

	Ожидаем.Что(Ответ.Код, "неклассифицированный сбой резолва — прежние 502").Равно(502);

КонецПроцедуры

&Тест
Процедура СменаТекстаБиблиотекиКодОтветаВыдачиНеМеняет() Экспорт

	Фейк = ФейкПустой();
	Фейк.ГоворитьОбОтсутствииТак(ТекстБиблиотеки);

	Ожидаем.Что(ОтветВыдачи(ОтказХранилища(Фейк)).Код,
		"404 держится на коде отказа, а не на словах «не найден»").Равно(404);

КонецПроцедуры

// Приговор выносится по машинному коду: отказ, в тексте которого нет ни слова из
// привычных формулировок хаба, всё равно опознаётся как отсутствие ресурса.
&Тест
Процедура ВердиктВыдачиДержитсяНаКодеАНеНаСловах() Экспорт

	Пропажа = СтандартныеОшибки.РесурсНеНайден("main/pkg/pkg-1.0.0.ospx", "the object is gone");
	Ожидаем.Что(ОтветВыдачи(Пропажа).Код, "404 по коду, а не по словам «не найден»").Равно(404);

	Простой = СтандартныеОшибки.ЗависимостьНедоступна("s3://bucket", "backend is down");
	Ожидаем.Что(ОтветВыдачи(Простой).Код, "503 по коду, а не по словам «недоступно»").Равно(503);

КонецПроцедуры

// Уровень ОШИБКА взят намеренно: на нём отладочных строк в журнале нет вовсе, и видно,
// что причину несёт именно строка отказа, а не соседняя диагностика.
&Тест
Процедура СтрокаОшибкиВыдачиНесётТекстБиблиотекиИМесто() Экспорт

	Фейк = ФейкПустой();
	Фейк.ГоворитьОбОтсутствииТак(ТекстБиблиотеки);

	Журнал = ЖурналВыдачи(ОтказХранилища(Фейк), УровниЛога.Ошибка);

	Ожидаем.Что(Журнал, "текст библиотеки хранилища ушёл в строку ОШИБКИ дословно")
		.Содержит(ТекстБиблиотеки);
	Ожидаем.Что(Журнал, "строка ОШИБКИ назвала место возникновения причины")
		.Содержит("ФейкКлиентS3.os");

КонецПроцедуры

// Полная цепочка со стеком стоит дорого и человеку в строке отказа не нужна — её место
// на ОТЛАДКЕ, и включённая отладка обязана её показать.
&Тест
Процедура ЦепочкаПричинЦеликомПоказываетсяНаОтладке() Экспорт

	Фейк = ФейкПустой();
	Фейк.ГоворитьОбОтсутствииТак(ТекстБиблиотеки);
	Сбой = ОтказХранилища(Фейк);

	// опора — ЗНАЧЕНИЕ из данных корневой причины, а не литерал заголовка раздела: заголовки
	// приезжают из НСтр библиотеки errors и меняются вместе с языком запуска. Данные кадра
	// печатает только полный отчёт, строка ОШИБКИ их не разворачивает.
	КлючВХранилище = Строка(ДиагностикаОшибок.Разобрать(Сбой).КорневаяПричина().Данные().ИмяРесурса);

	Ожидаем.Что(ЗначениеЗаполнено(КлючВХранилище),
		"у корневой причины есть данные, по которым видно отчёт").ЭтоИстина();
	Ожидаем.Что(ЖурналВыдачи(Сбой, УровниЛога.Отладка),
		"на отладке журнал разворачивает данные цепочки").Содержит(КлючВХранилище);
	Ожидаем.Что(СтрНайти(ЖурналВыдачи(Сбой, УровниЛога.Ошибка), КлючВХранилище),
		"на уровне ОШИБКА полного отчёта нет — иначе журнал не прочитать").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОтказПубликацииЧитаетЧеловек

&Тест
Процедура ТелоОтказаПубликацииБезСлужебнойПриписки() Экспорт

	Ответ = ОтветПубликации(ПричинаОтказаПубликации());

	Ожидаем.Что(Ответ.Код, "сорванная публикация — 500").Равно(500);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "{Модуль"),
		"служебной обёртки OneScript в консоли opm нет: " + Ответ.ТелоТекст).Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "Error in line"),
		"координат кадра в консоли opm нет: " + Ответ.ТелоТекст).Равно(0);
	Ожидаем.Что(Ответ.ТелоТекст, "причина отказа человеку названа")
		.Содержит(ПричинаОтказаПубликации());
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "ФейкПубликацииПадающий.os"),
		"координат кадра, которые несёт строка журнала, в теле нет: " + Ответ.ТелоТекст).Равно(0);

КонецПроцедуры

&Тест
Процедура СтрокаОшибкиПубликацииНесётПричинуИМесто() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Лог = ЛогПодЛовушкой(Ловушка, "публикация", УровниЛога.Ошибка);
	ОтветПубликации(ПричинаОтказаПубликации(), Лог);
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(Ловушка.Всё(), "причина в строке ОШИБКИ дословно")
		.Содержит(ПричинаОтказаПубликации());
	Ожидаем.Что(Ловушка.Всё(), "строка ОШИБКИ назвала место возникновения")
		.Содержит("ФейкПубликацииПадающий.os");

КонецПроцедуры

// Граница с чужой библиотекой: наружу идёт фраза хаба, дословный текст библиотеки
// хранилища остаётся причиной и печатается только в журнал.
&Тест
Процедура ТекстБиблиотекиХранилищаНаружуНеИдётАВЖурналИдёт() Экспорт

	Фейк = ФейкПустой();
	Фейк.ГоворитьОбОтсутствииТак(ТекстБиблиотеки);
	Сбой = ОтказХранилища(Фейк);

	Ловушка = Новый ЛовушкаЛога();
	Лог = ЛогПодЛовушкой(Ловушка, "граница", УровниЛога.Ошибка);
	Ответ = ОтветПубликации(Сбой, Лог);
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, ТекстБиблиотеки),
		"внутренности библиотеки хранилища в ответ не едут: " + Ответ.ТелоТекст).Равно(0);
	Ожидаем.Что(Ответ.ТелоТекст, "человеку названа фраза хаба")
		.Содержит("Артефакт не найден в хранилище");
	Ожидаем.Что(Ловушка.Всё(), "а журналу — дословный текст библиотеки").Содержит(ТекстБиблиотеки);

КонецПроцедуры

#КонецОбласти

#Область Обвязка

// Ответ oint: структура с полем status, как её отдаёт OPI_S3.
Функция Ответ(Знач Статус)
	Возврат Новый Структура("status", Статус);
КонецФункции

Функция ОтветСКодомОшибки(Знач Статус, Знач КодОшибки)
	Ошибка = Новый Соответствие();
	Ошибка.Вставить("Code", КодОшибки);
	Возврат ОтветСТеломОшибки(Статус, Ошибка);
КонецФункции

Функция ОтветСТеломОшибки(Знач Статус, Знач Ошибка)
	Тело = Новый Соответствие();
	Тело.Вставить("Error", Ошибка);
	Возврат Новый Структура("status, response", Статус, Тело);
КонецФункции

Функция ФейкПустой()
	Возврат Новый ФейкКлиентS3();
КонецФункции

Функция ФейкНедоступный()
	Фейк = Новый ФейкКлиентS3();
	Фейк.СтатьНедоступным(ТекстНедоступности);
	Возврат Фейк;
КонецФункции

Функция S3НадФейком(Знач Фейк)
	Возврат Новый S3Хранилище(Фейк);
КонецФункции

Функция ПричинаОтказаПубликации()
	Возврат "Хранилище недоступно: том смонтирован только на чтение";
КонецФункции

// Сбой чтения артефакта как ИнформацияОбОшибке; Неопределено — чтение неожиданно удалось.
Функция СбойЧтения(Знач Хранилище)

	Попытка
		Хранилище.ПолучитьДанные(Новый КоординатыАртефакта("main", "pkg", "1.0.0"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Тот же сбой, что увидела бы выдача: отказ хранилища за координатами артефакта.
Функция ОтказХранилища(Знач Фейк)
	Возврат СбойЧтения(S3НадФейком(Фейк));
КонецФункции

// Ответ маршрута выдачи на сбой резолва.
Функция ОтветВыдачи(Знач Сбой, Знач Лог = Неопределено)

	Ответ = Новый ОтветСтраницыЗаглушка(Новый КукиОтветаЗаглушка());

	Сборка = Новый СборкаКонтроллераВыдачи(?(Лог = Неопределено, ЛогТестов(), Лог));
	Сборка.Резолвер = Новый ФейкРезолверВыдачи(Сбой);
	Контроллер = Сборка.Собрать();

	Контроллер.ФайлПула(Ответ, "main", "pkg", "pkg-1.0.0.ospx", "GET", Новый Соответствие(),
		Новый КукиЗаглушка());

	Возврат Ответ;

КонецФункции

// Ответ маршрута публикации на сорвавшуюся публикацию.
Функция ОтветПубликации(Знач Сбой, Знач Лог = Неопределено)

	Ответ = Новый ОтветСтраницыЗаглушка(Новый КукиОтветаЗаглушка());

	Контроллер = Новый КонтроллерПубликации(
		Новый ФейкПубликацииПадающий(Сбой),
		Новый ПерехватчикПубликацииЗаглушка(),
		Новый КукиЗаглушка(),
		Неопределено,
		?(Лог = Неопределено, ЛогТестов(), Лог),
		Новый ЗаголовкиHTTP(),
		Новый ТекстОшибки());

	Контроллер.ПушВПул(Ответ, "main", "POST", Новый Соответствие(),
		ПолучитьДвоичныеДанныеИзСтроки("пакет"));

	Возврат Ответ;

КонецФункции

// Журнал маршрута выдачи на заданном уровне: что реально написала строка отказа.
Функция ЖурналВыдачи(Знач Сбой, Знач Уровень)

	Ловушка = Новый ЛовушкаЛога();
	Лог = ЛогПодЛовушкой(Ловушка, "выдача", Уровень);
	ОтветВыдачи(Сбой, Лог);
	Лог.УдалитьСпособВывода(Ловушка);

	Возврат Ловушка.Всё();

КонецФункции

// Имя лога включает уровень: логи в logos живут по имени на весь процесс, и общее имя
// унесло бы уровень одного теста в соседний.
Функция ЛогПодЛовушкой(Знач Ловушка, Знач Имя, Знач Уровень)

	Лог = Логирование.ПолучитьЛог("тест.oshub.отказхранилища." + Имя + "." + Строка(Уровень));
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(Ловушка);
	Возврат Лог;

КонецФункции

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.отказхранилища");
КонецФункции

Функция Представление(Знач Сбой)
	Возврат ?(Сбой = Неопределено, "сбоя не было", ДиагностикаОшибок.КраткоеПредставление(Сбой));
КонецФункции

#КонецОбласти
