// Границы публикации — сторож поверхности «право на push»: очередь заявок, резервирование имён, доверенные конвейеры,
// личные пулы. Каждый негативный тест несёт КОНТРОЛЬ рядом; набор изолирован в отдельный процесс.
// Написан ревью-агентом (не автором кода) как набор эксплойтов — удалению и ослаблению не подлежит.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем КаталогСборки;
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	// SSRF-гейт апстримов (5.B): СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО.
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтФикстура = Новый ГейтАпстримов();
	ГейтФикстура.Подключить();

	// auth: ядро прав, выдача прав, гейт и гвард ключа, учётки (личный пул при регистрации)
	КаталогВхода = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("вход", "Классы"));
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПравДоступа");
	ПоискКлассов.Подключить(КаталогМодулей, "ПроверяющийGitHub");
	ПоискКлассов.Подключить(КаталогМодулей, "СверкаСекретов");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисТокенов");
	ПоискКлассов.Подключить(КаталогМодулей, "ГейтТокена");
	ПоискКлассов.Подключить(КаталогМодулей, "ГвардКлюча");
	ПоискКлассов.Подключить(КаталогМодулей, "НормализаторУчётки");
	ПоискКлассов.Подключить(КаталогМодулей, "ПолитикаПароля");
	ПоискКлассов.Подключить(КаталогМодулей, "АдресУчётки");
	// СервисПользователей пишет события безопасности учётки через летопись
	ПоискКлассов.Подключить(КаталогМодулей, "ЛетописьУчёток");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПользователей");

	// события + аудит: выдача прав публикует событие шины
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	// observability: издатель событий инъектирует Телеметрию (здесь выключенную)
	КаталогNet = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("сеть", "Классы"));
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПробХаба = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПробХаба, "ГотовностьХаба.os"));

	// общий модуль утилит: классы реестра берут ПриведениеЧисел желудём
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("основа", "Классы")));

	// settings: лимиты публикации и опция легаси-токена GitHub
	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	// publish целиком, кроме контроллера (ему нужны перехватчик и куки winow) и боевого
	// ПроверяющийПодписиJWKS с его источником ключей — прозвище занимает фейк
	КаталогPublish = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("публикация", "Классы"));
	ПоискКлассов.Подключить(КаталогPublish, "СервисВходящих");
	ПоискКлассов.Подключить(КаталогPublish, "СтражИздателейCI");
	ПоискКлассов.Подключить(КаталогPublish, "МаскаРефа");
	ПоискКлассов.Подключить(КаталогPublish, "КороткаяФормаДоверия");
	ПоискКлассов.Подключить(КаталогPublish, "ИмяЗаписиДоверия");
	ПоискКлассов.Подключить(КаталогPublish, "ВидРефаДоверия");
	ПоискКлассов.Подключить(КаталогPublish, "СрокТокенаCI");
	ПоискКлассов.Подключить(КаталогPublish, "АудиторияТокенаCI");
	ПоискКлассов.Подключить(КаталогPublish, "СервисДоверияCI");
	ПоискКлассов.Подключить(КаталогPublish, "МестоВПуле");
	ПоискКлассов.Подключить(КаталогPublish, "СервисПубликации");
	ПоискКлассов.Подключить(КаталогPublish, "РассмотрениеВходящих");
	ПоискКлассов.Подключить(КаталогPublish, "СервисРезервированияИмён");

	// исход заявки заявителю уходит личным каналом; здесь проверяется домен, а не канал,
	// поэтому дверь подменена фейком — перечень поводов при этом настоящий
	ПоискКлассов.Подключить(КаталогМодулей, "ПоводыУведомлений");
	РеестрФикстур.Подключить("ФейкКаналаУведомлений");

	// mirror: путь, которым в пул кладёт САМ ХАБ. Берутся только классы приёма — движок
	// цикла, очередь и фоновый рабочий этому набору не нужны.
	КаталогMirror = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("зеркала", "Классы"));
	Для Каждого ИмяКласса Из СтрРазделить("ДроссельПрогресса,СчётчикиОбхода,СрезОбхода,"
		+ "ЧислаЗеркалирования,РазборНастроекЗеркала,ПрогонЗеркала,ПределыПриёмаПакета,"
		+ "РазборПакетовЗеркала,СледЦиклаЗеркала,ПереносЭлементаСинка,СервисЗеркал", ",") Цикл
		ПоискКлассов.Подключить(КаталогMirror, ИмяКласса);
	КонецЦикла;

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкИсточникЗеркала.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийGitHub.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "НастройкиЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "КодировкаТестов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийПодписиCI.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФикстураПакета.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-review7b-unit-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Поделка = СобратьПоделку(Неопределено);

КонецПроцедуры

// Контейнер хаба с конфигурацией инсталляции. Пределы очереди заявок — числа
// инсталляции, а не настройки администратора: задать их можно только здесь.
Функция СобратьПоделку(Знач ДопДетальки)

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	// aud обязателен, и сверяется он с настройкой хаба: у этих токенов он "openhub"
	Детальки.Вставить("oshub.publish.ci.audience", "openhub");

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "ревизия-7b-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Если ДопДетальки <> Неопределено Тогда
		Для Каждого КиЗ Из ДопДетальки Цикл
			Детальки.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Собранная = Новый Поделка(Совет);
	Собранная.ЗапуститьПриложение();
	Возврат Собранная;

КонецФункции

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры
#Область РевизияОчередь

// Заявка в ЧУЖОЙ ПРИВАТНЫЙ пул не принимается: иначе любой аутентифицированный клал бы байты в хранилище пула,
// содержимое которого не вправе читать. КОНТРОЛЬ: тот же чужак в ПУБЛИЧНОМ пуле получает 202.
&Тест
Процедура ЗаявкаВЧужойПриватныйПулОтбита() Экспорт

	Владелец = СоздатьПользователя();
	Приватный = Желудь("СервисПулов").СоздатьПул(УникальноеИмя("priv"), "custom", "private",
		Владелец.Идентификатор, 0);
	Чужак = СоздатьПользователя();

	Права = Желудь("СервисПрав");
	Ожидаем.Что(Права.МожетЧитать(Чужак, Приватный), "чужак не читает приватный пул").ЭтоЛожь();

	Итог = Опубликовать(Приватный, Чужак, УникальноеИмя("intrude"), "1.0.0");
	Ожидаем.Что(Итог.Код, "в чужой приватный пул заявка не принимается").Равно(403);
	Ожидаем.Что(Входящие().ОжидающиеПула(Приватный.Идентификатор).Количество(),
		"и ни байта в его хранилище не легло").Равно(0);

	Публичный = СоздатьПул();
	Ожидаем.Что(Опубликовать(Публичный, Чужак, УникальноеИмя("intrude"), "1.0.0").Код,
		"КОНТРОЛЬ: в публичный пул тот же чужак подаёт заявку").Равно(202);

КонецПроцедуры

// Пул, закрытый для публикации, заявок НЕ ПРИНИМАЕТ: одобрение упёрлось бы в тот же запрет,
// и заявка стала бы неодобряемой навсегда. КОНТРОЛЬ: тот же push в открытый пул — 202.
&Тест
Процедура ЗакрытыйДляПубликацииПулЗаявокНеПринимает() Экспорт

	Закрытый = СоздатьПул();
	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Закрытый.Идентификатор, Ложь);
	Закрытый = Желудь("СервисПулов").ПулПоИдентификатору(Закрытый.Идентификатор);
	Автор = СоздатьПользователя();
	Имя = УникальноеИмя("closedreq");

	Итог = Опубликовать(Закрытый, Автор, Имя, "1.0.0");
	Ожидаем.Что(Итог.Код, "заявка в закрытый для публикации пул не принимается").Равно(409);
	Ожидаем.Что(Итог.Сообщение, "и сказано почему").Содержит("не принимает публикации");
	Ожидаем.Что(Входящие().ОжидающиеПула(Закрытый.Идентификатор).Количество(),
		"во «входящих» пусто — неодобряемых заявок не заводим").Равно(0);

	Ожидаем.Что(Опубликовать(СоздатьПул(), Автор, Имя, "1.0.0").Код,
		"КОНТРОЛЬ: в открытый пул тот же push даёт заявку").Равно(202);

КонецПроцедуры

// Пределы вместимости «входящих»: очередь — канал расхода чужого хранилища. Проверяются обе оси и выключение нулём.
&Тест
Процедура ПределыВместимостиВходящих() Экспорт

	// Пределы очереди — числа инсталляции (ИСТ-НАСТ-012): администратор их не правит,
	// поэтому каждый предел проверяется на хабе, поднятом с этим значением.
	Прежняя = Поделка;

	Попытка

		// 1. ПРЕДЕЛ НА АВТОРА: ставим 1 — вторая заявка того же человека не принимается
		Поделка = СобратьПоделку(Пределы(50, 1));
		Пул = СоздатьПул();
		Автор = СоздатьПользователя();
		Ожидаем.Что(Опубликовать(Пул, Автор, УникальноеИмя("cap"), "1.0.0").Код,
			"первая заявка автора принята").Равно(202);
		Вторая = Опубликовать(Пул, Автор, УникальноеИмя("cap"), "1.0.0");
		Ожидаем.Что(Вторая.Код, "вторая заявка того же автора → 429").Равно(429);

		// КОНТРОЛЬ: ДРУГОЙ автор при том же пределе заявку подаёт — предел персональный
		Ожидаем.Что(Опубликовать(Пул, СоздатьПользователя(), УникальноеИмя("cap"), "1.0.0").Код,
			"КОНТРОЛЬ: предел на автора не мешает соседу").Равно(202);

		// 2. ПРЕДЕЛ НА ПУЛ: в пуле уже 2 заявки, ставим потолок 2 — третья не проходит
		Поделка = СобратьПоделку(Пределы(2, 50));
		Ожидаем.Что(Опубликовать(Пул, СоздатьПользователя(), УникальноеИмя("cap"), "1.0.0").Код,
			"«входящие» пула заполнены → 429").Равно(429);

		// КОНТРОЛЬ: в СОСЕДНЕМ пустом пуле тот же push при том же пределе проходит
		Ожидаем.Что(Опубликовать(СоздатьПул(), СоздатьПользователя(), УникальноеИмя("cap"), "1.0.0").Код,
			"КОНТРОЛЬ: предел считается по пулу, а не по хабу").Равно(202);

		// 3. НОЛЬ ВЫКЛЮЧАЕТ ПРИЁМ ЦЕЛИКОМ — это и есть «переключатель» очереди
		Поделка = СобратьПоделку(Пределы(0, 50));
		Выключено = Опубликовать(СоздатьПул(), СоздатьПользователя(), УникальноеИмя("cap"), "1.0.0");
		Ожидаем.Что(Выключено.Код, "нулевой предел → приём заявок выключен").Равно(429);
		Ожидаем.Что(Выключено.Сообщение, "и текст говорит именно это").Содержит("выключен");

	Исключение
		Поделка = Прежняя;
		ВызватьИсключение;
	КонецПопытки;

	Поделка = Прежняя;

КонецПроцедуры

// Детальки конфигурации инсталляции с пределами очереди заявок.
Функция Пределы(Знач НаПул, Знач НаАвтора)

	// XMLСтрока, а не Формат: у Формат представление нуля по умолчанию ПУСТОЕ, а пустая
	// деталька для реестра означает «не задано» — предел молча стал бы умолчанием.
	Результат = Новый Соответствие();
	Результат.Вставить("oshub.publish.inbox.max_pending_per_pool", XMLСтрока(НаПул));
	Результат.Вставить("oshub.publish.inbox.max_pending_per_user", XMLСтрока(НаАвтора));
	Возврат Результат;

КонецФункции

// Заявка на ЗАРЕЗЕРВИРОВАННОЕ имя заявкой не становится: имя занято плейсхолдером — это push в существующий пакет,
// то есть 403, а не 202. КОНТРОЛЬ: соседнее свободное имя тем же пользователем даёт 202.
&Тест
Процедура ЗаявкаНаЗарезервированноеИмяОтбита() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Чужак = СоздатьПользователя();
	Имя = УникальноеИмя("resvd");

	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя).Успех,
		"имя зарезервировано").ЭтоИстина();

	Атака = Опубликовать(Пул, Чужак, Имя, "1.0.0");
	Ожидаем.Что(Атака.Код, "на занятое резервом имя заявки нет").Равно(403);

	Контроль = Опубликовать(Пул, Чужак, УникальноеИмя("resvd"), "1.0.0");
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: свободное имя того же пула — 202").Равно(202);

КонецПроцедуры

// Откат неудавшегося одобрения: публикация валится запретом публикации в пуле, включённым уже после приёма заявки —
// заявителю не осталось ни прав, ни имени, заявка снова рассматриваема. КОНТРОЛЬ: снимаем запрет — одобрение проходит.
&Тест
Процедура ОткатОдобренияНеОставляетПравИИмени() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	Имя = УникальноеИмя("rollb");

	Заявка = ПодатьЗаявку(Пул, Заявитель, Имя, "1.0.0");
	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Ложь);

	Итог = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Итог.Успех, "одобрение упало на запрете публикации в пуле").ЭтоЛожь();

	Права = Желудь("СервисПрав");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя);
	Ожидаем.Что(Пакет = Неопределено, "плейсхолдер снесён откатом").ЭтоИстина();
	Ожидаем.Что(Входящие().Заявка(Заявка.Идентификатор).Состояние,
		"заявка снова ожидает").Равно("ожидает");
	// смотрим В ХРАНИЛИЩЕ по идентификатору снесённого объекта: новый пакет получит новый идентификатор, и «прав нет»
	// через сервис прав было бы ложно-зелёным
	Ожидаем.Что(ГрантовНаПакеты(Заявитель), "у заявителя не осталось прав на пакеты").Равно(0);

	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Истина);
	Контроль = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Контроль.Успех,
		"КОНТРОЛЬ: в открытом пуле то же одобрение проходит: " + Контроль.Сообщение).ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя);
	Ожидаем.Что(Права.РольНеНиже(Заявитель, Права.ОбъектПакет(Пакет), Права.РольМейнтейнер()),
		"после успешного одобрения право есть").ЭтоИстина();

КонецПроцедуры

// Гонка «одобрение против резерва»: пока заявка ждёт, мейнтейнер резервирует то же имя — одобрение обязано отказать.
&Тест
Процедура РезервПеребиваетОдобрениеА_НеНаоборот() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	Имя = УникальноеИмя("race");

	Заявка = ПодатьЗаявку(Пул, Заявитель, Имя, "1.0.0");
	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя,
		"пользователь", Мейнтейнер.Идентификатор, "мейнтейнер").Успех, "имя занято резервом").ЭтоИстина();

	Итог = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Итог.Успех, "одобрение не отбирает зарезервированное имя").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "занятое имя → 409").Равно(409);

	Права = Желудь("СервисПрав");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя);
	Ожидаем.Что(Права.РольНеНиже(Заявитель, Права.ОбъектПакет(Пакет), Права.РольЧитатель()),
		"заявитель прав на чужой резерв не получил").ЭтоЛожь();

КонецПроцедуры

// Отклонение — второй вход того же пролога: мейнтейнер СОСЕДНЕГО пула и read-only ключ.
// КОНТРОЛЬ: мейнтейнер своего пула полным ключом ту же заявку отклоняет.
&Тест
Процедура ОтклонениеЗакрытоТемиЖеРамками() Экспорт

	Пул = СоздатьПул();
	Чужой = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	МейнтейнерЧужого = СоздатьМейнтейнера(Чужой);
	Заявитель = СоздатьПользователя();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальноеИмя("rejguard"), "1.0.0");

	Атака1 = Рассмотрение().Отклонить(СессияПринципал(МейнтейнерЧужого), Заявка.Идентификатор, "");
	Ожидаем.Что(Атака1.Код, "чужой мейнтейнер не отклоняет").Равно(403);

	Атака2 = Рассмотрение().Отклонить(КлючПринципал(Мейнтейнер, "read", 0), Заявка.Идентификатор, "");
	Ожидаем.Что(Атака2.Код, "read-only ключ не отклоняет").Равно(403);
	Ожидаем.Что(Атака2.Сообщение, "причина — скоуп").Содержит("скоуп");

	Атака3 = Рассмотрение().Отклонить(
		КлючПринципал(Мейнтейнер, "read,write", Пул.Идентификатор + 7000), Заявка.Идентификатор, "");
	Ожидаем.Что(Атака3.Код, "ключ чужого пула не отклоняет").Равно(403);

	Атака4 = Рассмотрение().Отклонить(Неопределено, Заявка.Идентификатор, "");
	Ожидаем.Что(Атака4.Код, "аноним не отклоняет").Равно(401);

	Контроль = Рассмотрение().Отклонить(
		КлючПринципал(Мейнтейнер, "read,write", Пул.Идентификатор), Заявка.Идентификатор, "");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: свой мейнтейнер полным ключом отклоняет").ЭтоИстина();

КонецПроцедуры

// DEFAULT-CLOSED: несобранный ГвардКлюча закрывает ВСЕ новые входы, включая сессию, у которой ключа нет вовсе.
&Тест
Процедура БезГвардаКлючаВсеНовыеВходыЗакрыты() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальноеИмя("noguard"), "1.0.0");

	БезГварда = Новый РассмотрениеВходящих(Входящие(), Желудь("СервисПубликации"),
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Желудь("СервисПрав"), Желудь("СервисПравДоступа"), Желудь("СервисПользователей"),
		Желудь("СлужбаЛичныхУведомлений"), Неопределено, ЛогТестов());

	Итог = БезГварда.Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Итог.Код, "одобрение без гварда закрыто").Равно(403);
	Ожидаем.Что(Итог.Сообщение, "причина названа").Содержит("гейт ключа доступа не собран");
	Ожидаем.Что(БезГварда.ВидимыеЗаявки(СессияПринципал(Мейнтейнер), Пул).Количество(),
		"и список тоже пуст").Равно(0);

	РезервБезГварда = Новый СервисРезервированияИмён(Желудь("СервисПакетов"), Желудь("СервисПулов"),
		Желудь("СервисВерсий"), Желудь("ХранилищеВерсийПакета"), Желудь("СервисПрав"),
		Желудь("СервисПравДоступа"), Желудь("ПравилаИменования"), Неопределено);
	Ожидаем.Что(РезервБезГварда.Зарезервировать(СессияПринципал(Мейнтейнер), Пул,
		УникальноеИмя("ng")).Код, "резерв без гварда закрыт").Равно(403);

	// КОНТРОЛЬ: те же вызовы через собранные контейнером желуди проходят
	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул,
		УникальноеИмя("ng")).Успех, "КОНТРОЛЬ: с гвардом резерв проходит").ЭтоИстина();
	Ожидаем.Что(Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор).Успех,
		"КОНТРОЛЬ: с гвардом одобрение проходит").ЭтоИстина();

КонецПроцедуры

// ГвардКлюча сам по себе: без ГейтТокена отказывает всему, с гейтом повторяет его вердикт — не мягче старого.
&Тест
Процедура ГвардКлючаНеМягчеГейтаТокена() Экспорт

	Пользователь = СоздатьПользователя();
	Гейт = Желудь("ГейтТокена");
	Гвард = Желудь("ГвардКлюча");
	Пустой = Новый ГвардКлюча(Неопределено);

	Ожидаем.Что(Пустой.Пропустить(Неопределено, "чтение", 0).Разрешено,
		"несобранный гвард закрывает даже анонимное чтение").ЭтоЛожь();
	Ожидаем.Что(Пустой.Пропустить(СессияПринципал(Пользователь), "создание", 0).Разрешено,
		"и сессию тоже").ЭтоЛожь();

	Случаи = Новый Массив();
	Случаи.Добавить(Новый Структура("П, Д, Пул", Неопределено, "создание", 0));
	Случаи.Добавить(Новый Структура("П, Д, Пул", СессияПринципал(Пользователь), "создание", 3));
	Случаи.Добавить(Новый Структура("П, Д, Пул", КлючПринципал(Пользователь, "read", 0), "создание", 0));
	Случаи.Добавить(Новый Структура("П, Д, Пул", КлючПринципал(Пользователь, "read", 0), "чтение", 0));
	Случаи.Добавить(Новый Структура("П, Д, Пул", КлючПринципал(Пользователь, "read,write", 5), "изменение", 6));
	Случаи.Добавить(Новый Структура("П, Д, Пул", КлючПринципал(Пользователь, "read,write", 5), "изменение", 5));
	Для Каждого С Из Случаи Цикл
		Ожидаем.Что(Гвард.Пропустить(С.П, С.Д, С.Пул).Разрешено,
			"гвард повторяет гейт на " + С.Д).Равно(Гейт.Проверить(С.П, С.Д, С.Пул).Разрешено);
	КонецЦикла;

КонецПроцедуры

// Гонка за именем: заявка на имя, УЖЕ заявленное другим пользователем в другой версии, отбивается 409 — иначе порядок
// записи в таблицу решал бы, чьё имя. КОНТРОЛЬ: та же вторая заявка на СОСЕДНЕЕ имя принимается.
&Тест
Процедура ЗаявкаНаЧужоеЗаявленноеИмяОтбита() Экспорт

	Пул = СоздатьПул();
	Первый = СоздатьПользователя();
	Второй = СоздатьПользователя();
	Имя = УникальноеИмя("contest");

	ПодатьЗаявку(Пул, Первый, Имя, "1.0.0");

	Атака = Опубликовать(Пул, Второй, Имя, "2.0.0");
	Ожидаем.Что(Атака.Код, "второй претендент на то же имя → 409").Равно(409);
	Ожидаем.Что(Атака.Сообщение, "и ему сказано, чем занято").Содержит("заявлено другим");
	Ожидаем.Что(ОжидающихНаИмя(Пул.Идентификатор, Имя), "заявка осталась одна").Равно(1);

	Контроль = Опубликовать(Пул, Второй, Имя + "x", "2.0.0");
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: соседнее имя тот же пользователь заявляет").Равно(202);

КонецПроцедуры

// Повтор push той же версии тем же автором не плодит вторую заявку: opm повторяет push при сетевом сбое.
&Тест
Процедура ПовторнаяЗаявкаТогоЖеАвтораИдемпотентна() Экспорт

	Пул = СоздатьПул();
	Автор = СоздатьПользователя();
	Имя = УникальноеИмя("retry");

	Первая = Опубликовать(Пул, Автор, Имя, "1.0.0");
	Ожидаем.Что(Первая.Код, "первая заявка принята").Равно(202);
	Повтор = Опубликовать(Пул, Автор, Имя, "1.0.0");
	Ожидаем.Что(Повтор.Код, "повтор тоже 202").Равно(202);
	Ожидаем.Что(Цел(Повтор.Заявка.Идентификатор), "и это ТА ЖЕ заявка").Равно(Цел(Первая.Заявка.Идентификатор));
	Ожидаем.Что(ОжидающихНаИмя(Пул.Идентификатор, Имя), "во «входящих» одна запись").Равно(1);

	// КОНТРОЛЬ: другая версия того же имени тем же автором — законная вторая заявка
	Другая = Опубликовать(Пул, Автор, Имя, "1.0.1");
	Ожидаем.Что(Другая.Код, "КОНТРОЛЬ: другая версия принимается").Равно(202);
	Ожидаем.Что(ОжидающихНаИмя(Пул.Идентификатор, Имя), "теперь их две").Равно(2);

КонецПроцедуры

// Заявка ДЕАКТИВИРОВАННОГО пользователя не одобряется: одобрение выдало бы права и опубликовало версию от имени
// отключённой учётки. КОНТРОЛЬ: возвращаем активность — то же одобрение проходит.
&Тест
Процедура ЗаявкаОтключённойУчёткиНеОдобряется() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальноеИмя("banned"), "1.0.0");

	Заявитель.Активен = Ложь;
	Заявитель.Сохранить();

	Атака = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Атака.Успех, "заявка отключённой учётки не одобряется").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "неактивный заявитель → 409").Равно(409);

	Заявитель.Активен = Истина;
	Заявитель.Сохранить();
	Контроль = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: активному ту же заявку одобряют").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РевизияРезерв

// Резерв с ролью ВЫШЕ мейнтейнера проваливается ЦЕЛИКОМ: имя не остаётся занятым «ни за кем».
&Тест
Процедура РезервСНедопустимойРолиНеЗанимаетИмя() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Прошенный = СоздатьПользователя();
	Имя = УникальноеИмя("badrole");

	Итог = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя,
		"пользователь", Прошенный.Идентификатор, "владелец");
	Ожидаем.Что(Итог.Успех, "роль владельца через резерв не выдаётся").ЭтоЛожь();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя) = Неопределено,
		"имя не осталось занятым после отката").ЭтоИстина();

	Контроль = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя,
		"пользователь", Прошенный.Идентификатор, "мейнтейнер");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: мейнтейнерская роль выдаётся").ЭтоИстина();

КонецПроцедуры

// Канонизация имени на резерве: «Foo» и «foo» — одно имя, иначе резерв заводил бы пакет-двойник.
&Тест
Процедура РезервНеЗависитОтРегистраИмени() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Имя = УникальноеИмя("Case");

	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя).Успех,
		"первый резерв").ЭтоИстина();
	Повтор = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, НРег(Имя));
	Ожидаем.Что(Повтор.Код, "тот же в нижнем регистре → 409").Равно(409);

	Пробел = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, "  " + ВРег(Имя) + "  ");
	Ожидаем.Что(Пробел.Код, "и с пробелами/в верхнем — тоже 409").Равно(409);

	Контроль = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя + "x");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: другое имя резервируется").ЭтоИстина();

КонецПроцедуры

// Резерв не заводит имя, страница которого недостижима: тот же список системных адресов, что и на публикации.
&Тест
Процедура РезервНеЗанимаетСистемныеАдреса() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);

	Итог = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, "settings");
	Ожидаем.Что(Итог.Успех, "системное имя не резервируется").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "и это 400").Равно(400);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "settings") = Неопределено,
		"пакет не создан").ЭтоИстина();

	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул,
		УникальноеИмя("plainname")).Успех, "КОНТРОЛЬ: обычное имя резервируется").ЭтоИстина();

КонецПроцедуры

// Список резервов собирался перебором «на каждый пакет пула — запрос его версий»: раздел
// открывался тем дольше, чем больше в пуле пакетов, даже когда резервов нет ни одного.
// Отбор стал пакетным, и тест сторожит, что ответ от этого не поехал.
&Тест
Процедура СписокРезервовВидитТолькоПустыеПакетыСвоегоПула() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Соседний = СоздатьПул();
	СоседнийМейнтейнер = СоздатьМейнтейнера(Соседний);

	Ожидаем.Что(Резерв().Резервы(Пул).Количество(), "в свежем пуле резервов нет").Равно(0);

	ПервоеИмя = УникальноеИмя("resv-a");
	ВтороеИмя = УникальноеИмя("resv-b");
	Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, ПервоеИмя);
	Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, ВтороеИмя);

	// пакет С версией резервом не является, даже если имя занимали тем же способом
	СВерсией = УникальноеИмя("resv-live");
	Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, СВерсией);
	Ожидаем.Что(Опубликовать(Пул, Мейнтейнер, СВерсией, "1.0.0").Успех,
		"версия в занятое имя опубликована").ЭтоИстина();

	// резерв соседнего пула в чужой список не протекает
	Резерв().Зарезервировать(СессияПринципал(СоседнийМейнтейнер), Соседний, УникальноеИмя("resv-alien"));

	Имена = ИменаРезервов(Пул);
	Ожидаем.Что(Имена.Количество(), "в списке ровно два пустых имени").Равно(2);
	Ожидаем.Что(Имена.Найти(НРег(ПервоеИмя)) <> Неопределено, "первое имя в списке").ЭтоИстина();
	Ожидаем.Что(Имена.Найти(НРег(ВтороеИмя)) <> Неопределено, "второе имя в списке").ЭтоИстина();
	Ожидаем.Что(Имена.Найти(НРег(СВерсией)), "пакет с версией — не резерв").Равно(Неопределено);

	Ожидаем.Что(ИменаРезервов(Соседний).Количество(), "у соседнего пула свой список").Равно(1);
	Ожидаем.Что(Резерв().Резервы(Неопределено).Количество(), "пул не задан — пустой список").Равно(0);

КонецПроцедуры

// Резервировать имя в пуле с ВЫКЛЮЧЕННОЙ публикацией бессмысленно и вредно: имя занято,
// а push в него отбивается 409 — опубликовать в занятое имя не сможет никто. Отказ живёт
// в домене, чтобы правило было одно на экран, API и любой будущий вход.
&Тест
Процедура РезервНеЗанимаетИмяВПулеБезПубликации() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Ложь);

	Имя = УникальноеИмя("nopub");
	Итог = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя);

	Ожидаем.Что(Итог.Успех, "в пуле без публикации имя не занимается").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "и это 409 — тот же код, которым отвечает push").Равно(409);
	Ожидаем.Что(Итог.Сообщение, "причина названа").Содержит("не принимает публикации");
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя) = Неопределено,
		"пакет-плейсхолдер не создан").ЭтоИстина();

	// КОНТРОЛЬ: в обычном пуле поведение прежнее, и в этом же пуле — после включения публикации
	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(СоздатьМейнтейнера(СоздатьПул())),
		Пул, Имя).Код, "чужой мейнтейнер по-прежнему получает 403 прав, а не 409").Равно(403);

	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Истина);
	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Мейнтейнер),
		Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор), Имя).Успех,
		"КОНТРОЛЬ: с включённой публикацией имя занимается").ЭтоИстина();

КонецПроцедуры

// ⚠ СТОРОЖ ОСЛАБЛЕНИЯ. Выключенная публикация закрывает пул ДЛЯ ЛЮДЕЙ, а не для хаба:
// копию с названного администратором апстрима никто со стороны не подавал. Обе стороны
// проверяются на ОДНОМ И ТОМ ЖЕ пуле в одном состоянии — снятая с человеческого пути
// застава красит этот тест, а восстановленная на пути зеркала красит его же.
&Тест
Процедура ПулБезПубликацииНаполняетсяЗеркаломНоНеЛюдьми() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Ложь);
	Закрытый = Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор);

	// --- сторона хаба: зеркало заводится и кладёт версию
	Зеркало = Желудь("СервисЗеркал").Создать(Мейнтейнер, Закрытый, АдресАпстрима());
	Ожидаем.Что(Зеркало.Включено, "зеркало закрытому для публикации пулу заведено").ЭтоИстина();

	Привезённое = УникальноеИмя("mirrored");
	Исход = Перенести(Зеркало, Закрытый, Привезённое, "1.0.0");

	Ожидаем.Что(Исход.Скачано, "зеркало уложило версию в закрытый пул").ЭтоИстина();
	Пакет = Желудь("СервисПакетов").НайтиПакет(Закрытый.Идентификатор, Привезённое);
	Ожидаем.Что(Пакет <> Неопределено, "пакет появился в пуле").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0") <> Неопределено,
		"и версия проиндексирована — пул наполняется").ЭтоИстина();

	// --- сторона человека: тот же пул, то же состояние — отказ каждым входом
	Push = Опубликовать(Закрытый, Мейнтейнер, УникальноеИмя("byhand"), "1.0.0");
	Ожидаем.Что(Push.Успех, "человеку push в этот же пул не проходит").ЭтоЛожь();
	Ожидаем.Что(Push.Код, "и отвечает тем же 409, что и раньше").Равно(409);
	Ожидаем.Что(Push.Сообщение, "причина названа").Содержит("не принимает публикации");

	Резервирование = Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Закрытый,
		УникальноеИмя("byhand"));
	Ожидаем.Что(Резервирование.Успех, "и резерв имени не занимает").ЭтоЛожь();
	Ожидаем.Что(Резервирование.Код, "резерв отвечает тем же 409").Равно(409);

	// человеку закрыт и путь «дописать версию к тому, что привезло зеркало»
	Поверх = Опубликовать(Закрытый, Мейнтейнер, Привезённое, "2.0.0");
	Ожидаем.Что(Поверх.Код, "поверх зеркалированного имени человек тоже не публикует").Равно(409);
	Ожидаем.Что(Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "2.0.0") = Неопределено,
		"и второй версии в пуле не появилось").ЭтоИстина();

	// КОНТРОЛЬ: тот же пул с включённой публикацией человека пускает — отказ давала
	// именно настройка, а не права и не состояние пула
	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Истина);
	Открытый = Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор);
	Ожидаем.Что(Опубликовать(Открытый, Мейнтейнер, УникальноеИмя("byhand"), "1.0.0").Успех,
		"КОНТРОЛЬ: с включённой публикацией тот же человек публикует").ЭтоИстина();

КонецПроцедуры

// Приезд зеркалом и публикация человеком РАЗЛИЧИМЫ ПОСТФАКТУМ: журнал аудита несёт
// на версию отдельное действие с субъектом «mirror», а не выдаёт её за чью-то публикацию.
&Тест
Процедура ЖурналОтличаетПриездЗеркаломОтПубликацииЧеловеком() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Ложь);
	Закрытый = Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор);

	Привезённое = УникальноеИмя("audmir");
	Зеркало = Желудь("СервисЗеркал").Создать(Мейнтейнер, Закрытый, АдресАпстрима());
	Перенести(Зеркало, Закрытый, Привезённое, "1.0.0");

	// в открытом пуле то же самое делает человек
	Открытый = СоздатьПул();
	Руками = УникальноеИмя("audman");
	Ожидаем.Что(Опубликовать(Открытый, СоздатьМейнтейнера(Открытый), Руками, "1.0.0").Успех,
		"публикация человеком удалась").ЭтоИстина();

	Имена = Желудь("ИмяОбъектаАудита");
	АдресПривезённой = Имена.ВерсияПоИменам(Закрытый.Имя, Привезённое, "1.0.0");
	АдресРучной = Имена.ВерсияПоИменам(Открытый.Имя, Руками, "1.0.0");

	Ожидаем.Что(ДействиеЖурналаПоОбъекту(АдресПривезённой),
		"версия зеркала помечена в журнале своим действием").Равно("зеркалирование.версии");
	Ожидаем.Что(ДействиеЖурналаПоОбъекту(АдресРучной),
		"а публикация человека — своим").Равно("публикация.версии");
	Ожидаем.Что(КтоЖурналаПоОбъекту(АдресПривезённой),
		"субъект приезда — сам хаб, а не учётка").Равно("mirror");
	Ожидаем.Что(КтоЖурналаПоОбъекту(АдресРучной),
		"КОНТРОЛЬ: у публикации человека субъект — его логин").Не_().Равно("mirror");

КонецПроцедуры

// Снятие резерва уносит и роли на плейсхолдер: иначе следующий владелец имени унаследует чужого мейнтейнера.
&Тест
Процедура СнятыйРезервНеОставляетПравНаИмя() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Прежний = СоздатьПользователя();
	Новый_ = СоздатьПользователя();
	Имя = УникальноеИмя("handover");

	Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя,
		"пользователь", Прежний.Идентификатор, "мейнтейнер");
	СтарыйИд = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя).Идентификатор;
	Ожидаем.Что(Резерв().СнятьРезерв(СессияПринципал(Мейнтейнер), Пул, Имя).Успех,
		"резерв снят").ЭтоИстина();
	// смотрим В ХРАНИЛИЩЕ по идентификатору снятого плейсхолдера: переиспользование идентификаторов отдало бы
	// повисший грант новому владельцу
	Ожидаем.Что(Желудь("ХранилищеПравДоступа").НайтиГрант("пользователь",
			Цел(Прежний.Идентификатор), "пакет", Цел(СтарыйИд)) = Неопределено,
		"грант на снятый резерв удалён").ЭтоИстина();

	Резерв().Зарезервировать(СессияПринципал(Мейнтейнер), Пул, Имя,
		"пользователь", Новый_.Идентификатор, "мейнтейнер");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя);
	Права = Желудь("СервисПрав");
	Ожидаем.Что(Права.РольНеНиже(Прежний, Права.ОбъектПакет(Пакет), Права.РольЧитатель()),
		"прежний держатель имени прав не унаследовал").ЭтоЛожь();
	Ожидаем.Что(Права.РольНеНиже(Новый_, Права.ОбъектПакет(Пакет), Права.РольМейнтейнер()),
		"КОНТРОЛЬ: новый держатель мейнтейнер").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РевизияТриПути

// Легаси-токен GitHub при ВКЛЮЧЁННОЙ опции работает ТОЛЬКО в дефолтном пуле.
// КОНТРОЛЬ: тот же токен, тот же пакет, тот же пользователь — в дефолтном пуле публикация проходит.
&Тест
Процедура ЛегасиТокенТолькоВДефолтномПуле() Экспорт

	Дефолтный = ОбеспечитьДефолтныйПул();
	Обычный = СоздатьПул();
	Автор = СоздатьПользователя();
	Имя = УникальноеИмя("legacy");
	Токен = "gh-" + Имя;
	Желудь("ПроверяющийGitHub").Разрешить(Токен, Имя);

	УстановитьЛегаси(Истина);

	Атака = ОпубликоватьСТокеном(Обычный, Автор, Имя, "1.0.0", Токен);
	Ожидаем.Что(Атака.Код, "легаси-токен в обычном пуле не публикует — уходит в очередь").Равно(202);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Обычный.Идентификатор, Имя) = Неопределено,
		"в обычном пуле пакет не создан").ЭтоИстина();

	Контроль = ОпубликоватьСТокеном(Дефолтный, Автор, Имя, "1.0.0", Токен);
	Ожидаем.Что(Контроль.Успех,
		"КОНТРОЛЬ: тот же токен в дефолтном пуле публикует: " + Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

// ВЫКЛЮЧЕННАЯ опция закрывает легаси-путь и в дефолтном пуле. КОНТРОЛЬ: включаем опцию — тот же запрос проходит.
&Тест
Процедура ЛегасиТокенЗакрытВыключеннойОпцией() Экспорт

	Дефолтный = ОбеспечитьДефолтныйПул();
	Автор = СоздатьПользователя();
	Имя = УникальноеИмя("legoff");
	Токен = "gh-" + Имя;
	Желудь("ПроверяющийGitHub").Разрешить(Токен, Имя);

	УстановитьЛегаси(Ложь);
	Атака = ОпубликоватьСТокеном(Дефолтный, Автор, Имя, "1.0.0", Токен);
	Ожидаем.Что(Атака.Код,
		"при выключенной опции легаси-путь закрыт (свободное имя уходит в очередь)").Равно(202);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Дефолтный.Идентификатор, Имя) = Неопределено,
		"версия не опубликована").ЭтоИстина();

	УстановитьЛегаси(Истина);
	Контроль = ОпубликоватьСТокеном(Дефолтный, Автор, Имя, "1.0.0", Токен);
	Ожидаем.Что(Контроль.Успех,
		"КОНТРОЛЬ: с включённой опцией тот же запрос проходит: " + Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

// Значение, записанное в хранилище МИМО сервиса настроек (сырой литерал «Истина» — так пишут admin-cli, сидеры и
// правка базы руками), обязано читаться сервисом как БУЛЕВО: обычная запись кладёт XMLСтрока («true»), и
// расхождение форматов молча закрыло бы легаси-push зеркалу oscript-library.
&Тест
Процедура СыройЛитералОпцииВключаетЛегасиПуть() Экспорт

	Дефолтный = ОбеспечитьДефолтныйПул();
	Автор = СоздатьПользователя();
	Имя = УникальноеИмя("migopt");
	Токен = "gh-" + Имя;
	Желудь("ПроверяющийGitHub").Разрешить(Токен, Имя);

	// сырой литерал в хранилище, мимо СервисНастроек
	Желудь("ХранилищеПрикладныхНастроек").Установить("oshub.publish.github_legacy",
		"Истина", "system", ТекущаяУниверсальнаяДата());

	// СВЕЖИЙ экземпляр сервиса: у желудя контейнера значение могло осесть в TTL-кэше от соседнего теста
	Свежий = Новый СервисНастроек(Желудь("РеестрНастроек"),
		Желудь("ХранилищеПрикладныхНастроек"), Желудь("ИздательСобытий"),
		Желудь("ИмяОбъектаАудита"), Желудь("ВалидаторНастроек"), ЛогТестов());
	Ожидаем.Что(Свежий.Значение("oshub.publish.github_legacy"),
		"сервис настроек читает сырой литерал как ИСТИНУ").Равно(Истина);
	Ожидаем.Что(Свежий.Источник("oshub.publish.github_legacy"), "источник — база").Равно("база");
	Ожидаем.Что(ОпубликоватьСТокеном(Дефолтный, Автор, Имя, "1.0.0", Токен).Успех,
		"и легаси-путь по сырому литералу действительно работает").ЭтоИстина();

КонецПроцедуры

// TOFU по ТИПУ пула: в дефолтном пуле легаси-публикация не делает публикатора владельцем имени, в обычном — делает.
&Тест
Процедура TOFUНеРаботаетВДефолтномПуле() Экспорт

	Дефолтный = ОбеспечитьДефолтныйПул();
	Обычный = СоздатьПул();
	Автор = СоздатьПользователя();
	Права = Желудь("СервисПрав");

	Имя = УникальноеИмя("tofud");
	Токен = "gh-" + Имя;
	Желудь("ПроверяющийGitHub").Разрешить(Токен, Имя);
	УстановитьЛегаси(Истина);
	Ожидаем.Что(ОпубликоватьСТокеном(Дефолтный, Автор, Имя, "1.0.0", Токен).Успех,
		"легаси-публикация в дефолтный пул").ЭтоИстина();
	ПакетД = Желудь("СервисПакетов").НайтиПакет(Дефолтный.Идентификатор, Имя);
	Ожидаем.Что(Права.РольНеНиже(Автор, Права.ОбъектПакет(ПакетД), Права.РольЧитатель()),
		"TOFU в дефолтном пуле не срабатывает").ЭтоЛожь();

	// КОНТРОЛЬ: в обычном пуле райтер публикует новое имя и становится его владельцем
	Райтер = СоздатьСРолью(Обычный, "райтер");
	ИмяО = УникальноеИмя("tofuc");
	Ожидаем.Что(Опубликовать(Обычный, Райтер, ИмяО, "1.0.0").Успех, "райтер публикует").ЭтоИстина();
	ПакетО = Желудь("СервисПакетов").НайтиПакет(Обычный.Идентификатор, ИмяО);
	Ожидаем.Что(Права.РольНеНиже(Райтер, Права.ОбъектПакет(ПакетО), Права.РольМейнтейнер()),
		"КОНТРОЛЬ: в обычном пуле TOFU работает").ЭтоИстина();

КонецПроцедуры

// Пути НЕ СКЛАДЫВАЮТСЯ: доверенный конвейер даёт право только на СВОЙ пакет и ничего — на соседний пакет того же пула.
&Тест
Процедура ДовериеНеРаспространяетсяНаСоседнийПакет() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Свой = УникальноеИмя("trusted");
	Сосед = УникальноеИмя("neighbour");
	Опубликовать(Пул, Мейнтейнер, Свой, "1.0.0");
	Опубликовать(Пул, Мейнтейнер, Сосед, "1.0.0");
	ПакетСвой = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Свой);

	ФейкПодписи().Разрешить();
	Доверие().Доверить(СессияПринципал(Мейнтейнер), ПакетСвой, "github", ИздательGitHub(),
		"acme/lib", "", "refs/heads/main");
	Токен = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", 300);

	Атака = ОпубликоватьТокеном(Пул, Сосед, "2.0.0", Токен);
	Ожидаем.Что(Атака.Успех, "конвейер не публикует соседний пакет").ЭтоЛожь();

	Контроль = ОпубликоватьТокеном(Пул, Свой, "2.0.0", Токен);
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: свой пакет тот же токен публикует").ЭтоИстина();

КонецПроцедуры

// Конвейерный токен НЕ обходит рамки предъявленного ключа: read-only PAT закрывает push раньше конвейера.
&Тест
Процедура КонвейерНеОбходитРамкиКлюча() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Имя = УникальноеИмя("cikey");
	Опубликовать(Пул, Мейнтейнер, Имя, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя);

	ФейкПодписи().Разрешить();
	Доверие().Доверить(СессияПринципал(Мейнтейнер), Пакет, "github", ИздательGitHub(),
		"acme/lib", "", "refs/heads/main");
	Токен = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", 300);

	Данные = ПостроитьOspxДанные(Имя, "3.0.0");
	Атака = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", Имя, "3.0.0"), "stable", Неопределено, Токен,
		КлючПринципал(Мейнтейнер, "read", 0));
	Ожидаем.Что(Атака.Код, "read-only ключ закрывает push с CI-токеном").Равно(403);

	Данные2 = ПостроитьOspxДанные(Имя, "3.0.0");
	Контроль = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные2,
		СтрШаблон("%1-%2.ospx", Имя, "3.0.0"), "stable", Неопределено, Токен,
		КлючПринципал(Мейнтейнер, "read,write", 0));
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: тот же CI-токен полным ключом публикует").ЭтоИстина();

КонецПроцедуры

// Реф в записи доверия — защита от публикации с чужой ветки трастового репозитория (workflow с ветки форка/PR):
// токен с тем же издателем и репозиторием, но ДРУГИМ рефом, публиковать не должен. КОНТРОЛЬ: тот же реф — публикует.
&Тест
Процедура КонвейерСЧужогоРефаНеПубликует() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Имя = УникальноеИмя("refpin");
	Опубликовать(Пул, Мейнтейнер, Имя, "1.0.0");
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя);

	ФейкПодписи().Разрешить();
	Ожидаем.Что(Доверие().Доверить(СессияПринципал(Мейнтейнер), Пакет, "github",
		ИздательGitHub(), "acme/lib", "", "refs/heads/main").Успех, "доверие ветке main").ЭтоИстина();

	Чужой = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/attacker", 300);
	Атака = ОпубликоватьТокеном(Пул, Имя, "2.0.0", Чужой);
	Ожидаем.Что(Атака.Успех, "конвейер с чужой ветки не публикует").ЭтоЛожь();

	Безрефа = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "", 300);
	Атака2 = ОпубликоватьТокеном(Пул, Имя, "2.0.0", Безрефа);
	Ожидаем.Что(Атака2.Успех, "и токен вовсе без рефа тоже").ЭтоЛожь();

	Свой = СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "refs/heads/main", 300);
	Контроль = ОпубликоватьТокеном(Пул, Имя, "2.0.0", Свой);
	Ожидаем.Что(Контроль.Успех,
		"КОНТРОЛЬ: с доверенной ветки публикует: " + Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

// Заглушка ПроверяющийПодписиОтсутствует остаётся честной: контейнер без проверки подписи отказывает всему.
&Тест
Процедура ПоставочныйПроверяющийОтказываетВсему() Экспорт

	ПодключитьБоевойПроверяющий();
	Боевой = Новый ПроверяющийПодписиОтсутствует(ЛогТестов());

	Ожидаем.Что(Боевой.ПроверитьТокен("", "").Достоверна, "пустой токен").ЭтоЛожь();
	Проверка = Боевой.ПроверитьТокен(
		СобратьТокенКонвейера(ИздательGitHub(), "acme/lib", "", "", 300), ИздательGitHub());
	Ожидаем.Что(Проверка.Достоверна, "валидный по клеймам токен").ЭтоЛожь();
	Ожидаем.Что(Проверка.Клеймы = Неопределено, "непроверенная нагрузка наружу не отдана").ЭтоИстина();
	Ожидаем.Что(Боевой.ПроверитьТокен("a.b.c", "любой").Достоверна, "любой мусор").ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(Проверка.Причина), "причина названа").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РевизияЛичныеПулы

// Выключенная опция личных пулов на БОЕВОМ пути регистрации: учётка создаётся, пул — нет, прав — нет, исключения нет.
// КОНТРОЛЬ: тот же сервис с включённой опцией заводит и пул, и роль.
&Тест
Процедура РегистрацияПриВыключенныхЛичныхПулах() Экспорт

	Выключенные = СервисПользователейСПулами(СервисПуловСОпцией(Ложь));
	Логин = УникальноеИмя("nolp");
	Пользователь = Выключенные.СоздатьПользователя(Логин, "", "");

	Ожидаем.Что(Пользователь <> Неопределено, "учётка создана").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПулов").НайтиПул(Логин) = Неопределено,
		"личного пула нет").ЭтоИстина();

	Включённые = СервисПользователейСПулами(Желудь("СервисПулов"));
	ЛогинК = УникальноеИмя("yeslp");
	ПользовательК = Включённые.СоздатьПользователя(ЛогинК, "", "");
	ПулК = Желудь("СервисПулов").НайтиПул(ЛогинК);
	Ожидаем.Что(ПулК <> Неопределено, "КОНТРОЛЬ: с включённой опцией пул есть").ЭтоИстина();
	Права = Желудь("СервисПрав");
	Ожидаем.Что(Права.РольНеНиже(ПользовательК, Права.ОбъектПул(ПулК), Права.РольМейнтейнер()),
		"КОНТРОЛЬ: и роль выдана").ЭтоИстина();

КонецПроцедуры

// Опция личных пулов правится из интерфейса и лежит в базе: выключение действует СРАЗУ на
// боевом пути, но уже созданные личные пулы не трогает — их пакеты продолжают отдаваться.
&Тест
Процедура ВыключениеЛичныхПуловНеТрогаетУжеСозданные() Экспорт

	Перем Ошибка;

	Пулы = Желудь("СервисПулов");
	Логин = УникальноеИмя("keeplp");
	Пользователь = СервисПользователейСПулами(Пулы).СоздатьПользователя(Логин, "", "");
	Личный = Пулы.НайтиПул(Логин);
	Ожидаем.Что(Личный <> Неопределено, "личный пул создан при регистрации").ЭтоИстина();

	ИмяПакета = УникальноеИмя("keeppkg");
	Ожидаем.Что(ОпубликоватьСТокеном(Личный, Пользователь, ИмяПакета, "1.0.0", "").Код,
		"пакет опубликован в личный пул").Равно(201);

	Желудь("СервисНастроек").УстановитьМеханизмом("oshub.pools.personal_enabled", Ложь,
		"ревизия", "ПультЛичныхПространств");

	Ошибка = "";
	Попытка
		ПроверитьВыключенныеЛичныеПулы(Личный, ИмяПакета, Пользователь);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Желудь("СервисНастроек").Сбросить("oshub.pools.personal_enabled", "ревизия");

	Ожидаем.Что(Ошибка, "проверки при выключенной опции").Равно("");
	Ожидаем.Что(Пулы.ЛичныеПулыРазрешены(), "сброс вернул опцию").ЭтоИстина();

КонецПроцедуры

// ВТОРОЙ ВХОД к тому же инварианту: приватный личный пул заводится и обычным СоздатьПул с типом `user` — приватность
// личного пространства запрещена НЕЗАВИСИМО от входа. КОНТРОЛЬ: тот же вызов с типом `custom` приватный пул создаёт.
&Тест
Процедура ПриватныйПулТипаUserНеСоздаётсяВторымВходом() Экспорт

	Перем Ошибка;

	Пулы = Желудь("СервисПулов");
	Владелец = СоздатьПользователя();
	Имя = УникальноеИмя("upriv");

	Ошибка = "";
	Попытка
		Пулы.СоздатьПул(Имя, "user", "private", Владелец.Идентификатор, 0);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка, "приватный пул типа user не создаётся").Содержит("приватным быть не может");
	Ожидаем.Что(Пулы.НайтиПул(Имя) = Неопределено, "и пул не остался").ЭтоИстина();

	ИмяК = УникальноеИмя("cpriv");
	Ожидаем.Что(Пулы.СоздатьПул(ИмяК, "custom", "private", Владелец.Идентификатор, 0).Видимость,
		"КОНТРОЛЬ: обычный приватный пул создаётся").Равно("private");

КонецПроцедуры

// ОбеспечитьЛичныйПул обёрнут в `Попытка`: сбой создания личного пула НЕ РОНЯЕТ создание учётки — держится это на
// `Лог.Ошибка(...)` в обработчике. У экземпляра, созданного напрямую БЕЗ лога, эта строка сама бросает исключение
// наружу («Value is not of object type»). Сравниваются два экземпляра, отличающиеся РОВНО наличием лога.
&Тест
Процедура БезЛогаПрямойЭкземплярРонялБыРегистрацию() Экспорт

	Перем ОшибкаБезЛога;
	Перем ОшибкаСЛогом;

	Ломающий = Желудь("СервисПрав"); // не сервис пулов: любой вызов из ОбеспечитьЛичныйПул упадёт

	БезЛога = Новый СервисПользователей(
		Желудь("ХранилищеПользователей"), Желудь("НормализаторУчётки"),
		Желудь("АдресУчётки"), Желудь("ПолитикаПароля"), Желудь("ПравилаИменования"),
		Желудь("ПространствоИмён"), Ломающий, Желудь("СервисПрав"),
		Желудь("СервисПравДоступа"), Желудь("ЛетописьУчёток"));

	ОшибкаБезЛога = "";
	Попытка
		БезЛога.СоздатьПользователя(УникальноеИмя("nolog"), "", "");
	Исключение
		ОшибкаБезЛога = ОписаниеОшибки();
	КонецПопытки;

	СЛогом = Новый СервисПользователей(
		Желудь("ХранилищеПользователей"), Желудь("НормализаторУчётки"),
		Желудь("АдресУчётки"), Желудь("ПолитикаПароля"), Желудь("ПравилаИменования"),
		Желудь("ПространствоИмён"), Ломающий, Желудь("СервисПрав"),
		Желудь("СервисПравДоступа"), Желудь("ЛетописьУчёток"), ЛогТестов());

	ОшибкаСЛогом = "";
	Логин = УникальноеИмя("withlog");
	Попытка
		СЛогом.СоздатьПользователя(Логин, "", "");
	Исключение
		ОшибкаСЛогом = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ОшибкаСЛогом,
		"с логом регистрация переживает сбой личного пула (контракт ОбеспечитьЛичныйПул)").Равно("");
	Ожидаем.Что(Желудь("ХранилищеПользователей").НайтиПоЛогину(Логин) <> Неопределено,
		"и учётка действительно создана").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаБезЛога),
		"а без лога тот же сбой выносит исключение наружу из обработчика:"
		+ " находка сторожа ДисциплинаЛогирования содержательна, а не формальна").ЭтоИстина();

КонецПроцедуры

// Пул типа user, названный чужим логином, роли чужаку не даёт, и владелец личного пространства не получает ничего
// за его пределами.
&Тест
Процедура ЛичныйПулНеРасширяетПравНаружу() Экспорт

	Хозяин = Желудь("СервисПользователей").СоздатьПользователя(УникальноеИмя("own"), "", "");
	Личный = Желудь("СервисПулов").НайтиПул(Хозяин.Логин);
	Соседний = СоздатьПул();
	Права = Желудь("СервисПрав");

	Ожидаем.Что(Права.РольНеНиже(Хозяин, Права.ОбъектПул(Соседний), Права.РольРайтер()),
		"на соседний пул прав нет").ЭтоЛожь();
	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Хозяин), Соседний,
		УникальноеИмя("grab")).Код, "и имён он там не резервирует").Равно(403);
	Ожидаем.Что(Опубликовать(Соседний, Хозяин, УникальноеИмя("grab"), "1.0.0").Код,
		"а push свободного имени — только заявка").Равно(202);

	Ожидаем.Что(Резерв().Зарезервировать(СессияПринципал(Хозяин), Личный,
		УникальноеИмя("mine")).Успех, "КОНТРОЛЬ: в своём пространстве резервирует").ЭтоИстина();

КонецПроцедуры

#КонецОбласти
#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Подключает заглушку ПроверяющийПодписиОтсутствует КАК ТИП после сборки контейнера: поздние типы ОСень не сканирует.
Процедура ПодключитьБоевойПроверяющий()
	РеестрФикстур.Подключить("ПроверяющийПодписиОтсутствует");
КонецПроцедуры

Функция Входящие()
	Возврат Желудь("СервисВходящих");
КонецФункции

Функция Рассмотрение()
	Возврат Желудь("РассмотрениеВходящих");
КонецФункции

Функция Резерв()
	Возврат Желудь("СервисРезервированияИмён");
КонецФункции

// Апстрим-адрес документационного диапазона: SSRF-гейт его пропускает, а ходить по нему
// некому — пробник источника в этот контейнер не собран.
Функция АдресАпстрима()
	Возврат "http://198.51.100.10/download/";
КонецФункции

// Переносит одну версию с фейкового апстрима в пул — то, чем зеркало наполняет пул.
Функция Перенести(Знач Зеркало, Знач Пул, Знач ИмяПакета, Знач Версия)

	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию(ИмяПакета, Версия, 200, ПостроитьOspxДанные(ИмяПакета, Версия));
	Элемент = Новый Структура("ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна",
		ИмяПакета, Версия, СтрШаблон("%1/%1-%2.ospx", ИмяПакета, Версия), Истина);

	Возврат Желудь("ПереносЭлементаСинка").Перенести(Зеркало, Пул, Источник, Элемент);

КонецФункции

// Действие свежайшей записи журнала аудита об этом объекте; "" — записи нет.
Функция ДействиеЖурналаПоОбъекту(Знач Адрес)
	Запись = ЗаписьЖурналаПоОбъекту(Адрес);
	Возврат ?(Запись = Неопределено, "", Строка(Запись.Действие));
КонецФункции

// Субъект свежайшей записи журнала аудита об этом объекте; "" — записи нет.
Функция КтоЖурналаПоОбъекту(Знач Адрес)
	Запись = ЗаписьЖурналаПоОбъекту(Адрес);
	Возврат ?(Запись = Неопределено, "", Строка(Запись.Кто));
КонецФункции

// Журнал отдаёт новые первыми, а соседи по набору пишут в тот же файл: берём первую
// запись именно об этом объекте.
Функция ЗаписьЖурналаПоОбъекту(Знач Адрес)

	Для Каждого Запись Из Желудь("СлужбаАудита").ЗаписиСтраницей(Неопределено, 1, 200).Записи Цикл
		Если Строка(Запись.Объект) = Адрес Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ИменаРезервов(Знач Пул)
	Результат = Новый Массив();
	Для Каждого Пакет Из Резерв().Резервы(Пул) Цикл
		Результат.Добавить(НРег(Строка(Пакет.Имя)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Доверие()
	Возврат Желудь("СервисДоверияCI");
КонецФункции

Функция ФейкПодписи()
	Возврат Желудь("ПроверяющийПодписиCI");
КонецФункции

Функция ИздательGitHub()
	Возврат "https://token.actions.githubusercontent.com";
КонецФункции

// Принципал СЕССИИ браузера: ключа нет, рамки ключа прозрачны — остаются только права человека.
Функция СессияПринципал(Знач Пользователь)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, "session", "", 0, Неопределено);
КонецФункции

// Принципал КЛЮЧА (PAT) с заданными скоупами и привязкой к пулу.
Функция КлючПринципал(Знач Пользователь, Знач Права, Знач ПулКлюча)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, "token", Права, ПулКлюча, Неопределено);
КонецФункции

Функция Опубликовать(Знач Пул, Знач Пользователь, Знач ИмяПакета, Знач Версия)
	Данные = ПостроитьOspxДанные(ИмяПакета, Версия);
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Пользователь, "");
КонецФункции

// Публикация с сырым токеном и БЕЗ пользователя — так приходит конвейер CI.
Функция ОпубликоватьТокеном(Знач Пул, Знач ИмяПакета, Знач Версия, Знач Токен)
	Данные = ПостроитьOspxДанные(ИмяПакета, Версия);
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Неопределено, Токен);
КонецФункции

// Кладёт заявку во «входящие» ШТАТНЫМ путём — через push без прав, а не записью в хранилище.
Функция ПодатьЗаявку(Знач Пул, Знач Заявитель, Знач ИмяПакета, Знач Версия)

	Результат = Опубликовать(Пул, Заявитель, ИмяПакета, Версия);
	Если Результат.Код <> 202 Тогда
		ВызватьИсключение СтрШаблон("Заявка не принята (%1): %2", Результат.Код, Результат.Сообщение);
	КонецЕсли;
	Возврат Результат.Заявка;

КонецФункции

// Собирает JWS compact с нужными клеймами; достоверность подписи решает ПроверяющийПодписиCI, а не содержимое.
Функция СобратьТокенКонвейера(Знач Издатель, Знач Репозиторий, Знач Конвейер, Знач Реф,
	Знач СекундДоИстечения)

	Заголовок = Новый Структура("alg, typ, kid", "RS256", "JWT", "test-key");

	Клеймы = Новый Структура();
	Клеймы.Вставить("iss", Издатель);
	Клеймы.Вставить("aud", "openhub");
	Клеймы.Вставить("exp", ЮниксСейчас() + СекундДоИстечения);
	Клеймы.Вставить("iat", ЮниксСейчас() - 10);
	Клеймы.Вставить("repository", Репозиторий);
	Если ЗначениеЗаполнено(Конвейер) Тогда
		Клеймы.Вставить("job_workflow_ref", Конвейер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Реф) Тогда
		Клеймы.Вставить("ref", Реф);
	КонецЕсли;

	Возврат Base64URL(ВJSON(Заголовок)) + "." + Base64URL(ВJSON(Клеймы)) + "." + Base64URL("подпись");

КонецФункции

Функция ЮниксСейчас()
	Возврат ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1);
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция Base64URL(Знач Текст)
	Значение = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"));
	Значение = СтрЗаменить(СтрЗаменить(Значение, Символы.ПС, ""), Символы.ВК, "");
	Значение = СтрЗаменить(СтрЗаменить(Значение, "+", "-"), "/", "_");
	Пока СтрЗаканчиваетсяНа(Значение, "=") Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	Возврат Значение;
КонецФункции

// СервисПулов, собранный НАПРЯМУЮ с заданным значением детальки «личные пулы»: опция читается в конструкторе.
// Отдельный экземпляр с собственным резолвером настроек: опция гасится только здесь,
// глобальное состояние набора не трогается.
// Тело проверок вынесено, чтобы тест вернул настройку в исходное состояние при любом исходе.
Процедура ПроверитьВыключенныеЛичныеПулы(Знач Личный, Знач ИмяПакета, Знач Пользователь)

	Пулы = Желудь("СервисПулов");

	Ожидаем.Что(Пулы.ЛичныеПулыРазрешены(), "настройка из базы действует сразу").ЭтоЛожь();

	Существующий = Пулы.НайтиПул(Личный.Имя);
	Ожидаем.Что(Существующий <> Неопределено, "уже созданный личный пул на месте").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПрав").МожетЧитать(Неопределено, Существующий),
		"его пакеты по-прежнему видны анониму").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Существующий.Идентификатор, ИмяПакета) <> Неопределено,
		"опубликованный пакет продолжает отдаваться").ЭтоИстина();

	Отказ = "";
	Попытка
		Пулы.СоздатьЛичныйПул(УникальноеИмя("newlp"), Пользователь.Идентификатор);
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "новое личное пространство уже не заводится").Содержит("отключены");

КонецПроцедуры

Функция СервисПуловСОпцией(Знач ЛичныеРазрешены)

	Резолвер = Новый НастройкиЗаглушка();
	Резолвер.Задать("oshub.pools.personal_enabled", ЛичныеРазрешены);
	Настройки = Новый Массив();
	Настройки.Добавить(Резолвер);

	Возврат Новый СервисПулов(
		Желудь("ХранилищеПулов"), Желудь("УборкаПула"), Желудь("ПравилаИменования"),
		Желудь("ПространствоИмён"), Желудь("СервисАпстримовПула"),
		Желудь("КвотаПула"), Желудь("УчётОбъёмаПула"),
		Новый Массив(), Новый Массив(), Новый Массив(), Новый Массив(),
		Желудь("ИмяОбъектаАудита"), Настройки);

КонецФункции

Функция СоздатьПул()
	Возврат Желудь("СервисПулов").СоздатьПул(УникальноеИмя("pool"), "custom", "public");
КонецФункции

Функция СоздатьПользователя()
	Хранилище = Желудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("u");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = "user";
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

Функция СоздатьМейнтейнера(Знач Пул)
	Возврат СоздатьСРолью(Пул, "owner"); // легаси-пресет owner нормализуется в мейнтейнера
КонецФункции

Функция СоздатьСРолью(Знач Пул, Знач Роль)
	Польз = СоздатьПользователя();
	Участник = Желудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Польз.Идентификатор;
	Участник.Роль = Роль;
	Участник.Сохранить();
	Возврат Польз;
КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия)
	Возврат Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия);
КонецФункции

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.очередь");
КонецФункции


Функция ОбеспечитьДефолтныйПул()
	Пулы = Желудь("СервисПулов");
	Существующий = Пулы.ДефолтныйПул();
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Новый_ = Пулы.СоздатьПул("download-" + Формат(Счётчик + 1, "ЧГ=0; ЧН=0"), "custom", "public", 0, 0);
	Возврат Пулы.НазначитьПулПоУмолчанию(Новый_.Идентификатор, "тест");
КонецФункции

Процедура УстановитьЛегаси(Знач Включено)
	Желудь("СервисНастроек").Установить("oshub.publish.github_legacy", Включено, "ревизия");
КонецПроцедуры

Функция ОпубликоватьСТокеном(Знач Пул, Знач Пользователь, Знач ИмяПакета, Знач Версия, Знач Токен)
	Данные = ПостроитьOspxДанные(ИмяПакета, Версия);
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Пользователь, Токен);
КонецФункции

// Сколько ОЖИДАЮЩИХ заявок на это имя во «входящих» пула.
Функция ОжидающихНаИмя(Знач ПулИдентификатор, Знач ИмяПакета)
	Итого = 0;
	Для Каждого Заявка Из Входящие().ОжидающиеПула(Цел(ПулИдентификатор)) Цикл
		Если НРег(СокрЛП(Строка(Заявка.ИмяПакета))) = НРег(СокрЛП(Строка(ИмяПакета))) Тогда
			Итого = Итого + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итого;
КонецФункции

// Сколько у субъекта грантов НА ПАКЕТЫ — считаем по хранилищу: после отката объект удалён, и сервису прав вопрос
// задать не о чем.
Функция ГрантовНаПакеты(Знач Пользователь)
	Итого = 0;
	Для Каждого Грант Из Желудь("ХранилищеПравДоступа").ГрантыСубъекта(
		"пользователь", Цел(Пользователь.Идентификатор)) Цикл
		Если НРег(СокрЛП(Строка(Грант.ТипОбъекта))) = "пакет" Тогда
			Итого = Итого + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итого;
КонецФункции

// Прямое создание (минуя контейнер) — чтобы подменить СервисПулов. ЛОГ ПЕРЕДАЁТСЯ ПАРАМЕТРОМ: инъекция `&Лог`
// до объектов, созданных `Новый`, не доезжает.
Функция СервисПользователейСПулами(Знач Пулы)
	Возврат Новый СервисПользователей(
		Желудь("ХранилищеПользователей"), Желудь("НормализаторУчётки"),
		Желудь("АдресУчётки"), Желудь("ПолитикаПароля"), Желудь("ПравилаИменования"),
		Желудь("ПространствоИмён"), Пулы, Желудь("СервисПрав"), Желудь("СервисПравДоступа"),
		Желудь("ЛетописьУчёток"), ЛогТестов());
КонецФункции
#КонецОбласти
