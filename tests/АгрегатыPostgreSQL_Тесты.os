// Живая приёмка агрегатов на PostgreSQL: SQL-ветка исполняется только здесь — продуктовый
// дефолт и все остальные наборы идут на КоннекторJSON, а SQLite на macOS arm64 нет.
// Нужен OSHUB_TEST_PG_DSN; база общая для всех прогонов, поэтому набор убирает свои строки
// и сверяется с прямой выборкой, а не с абсолютными числами таблицы.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать errors
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Агрегаты;       // АгрегатыБазы (данные) — желудь из контейнера, с живым коннектором
Перем Пулы;           // ЗапросыПулов — репозиторий entity
Перем Пакеты;         // ЗапросыПакетов — репозиторий entity
Перем Счётчик;        // СчётчикОбращенийКБазе — цена агрегата в запросах и строках
Перем Суффикс;        // хвост имён этого прогона: база общая
Перем ЗасеянныеПулы;
Перем ЗасеянныеПакеты;
Перем ЗасеянныеЗаявки;
Перем ЗасеянныеУведомления;
Перем ЗасеянныеСтроки;   // Массив — прочие строки, положенные этим прогоном в общие таблицы
Перем НачалоЗасева_;   // момент до засева: от него отсчитываются отборы по дате

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("внешние")
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_TEST_PG_DSN""))",
	Причина = "не задана переменная окружения OSHUB_TEST_PG_DSN со строкой соединения PostgreSQL")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("СчётчикОбращенийКБазе");
	ПоискКлассов = Новый КлассыСлоя();
	ЗасеянныеПулы = Новый Массив();
	ЗасеянныеПакеты = Новый Массив();
	ЗасеянныеЗаявки = Новый Массив();
	ЗасеянныеУведомления = Новый Массив();
	ЗасеянныеСтроки = Новый Массив();

КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабНаPostgreSQL() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КореньМодулей = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя,
		"src", "модули");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КореньМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьОснову(КореньМодулей);

	Поделка = ПостроитьКонтейнер(ПолучитьПеременнуюСреды("OSHUB_TEST_PG_DSN"));
	Агрегаты = Поделка.НайтиЖелудь("АгрегатыБазы");
	Пулы = Поделка.НайтиЖелудь("ЗапросыПулов");
	Пакеты = Поделка.НайтиЖелудь("ЗапросыПакетов");

	Счётчик = Новый СчётчикОбращенийКБазе();
	Поделка.НайтиЖелудь("ИсточникДанных").ДобавитьНаблюдателя(Счётчик);

	// проба SQL — тоже запрос: без неё первый же замер насчитал бы лишнее обращение
	Агрегаты.БазаСчитает();

	Суффикс = УникальныеИмена.Хвост();
	НачалоЗасева_ = ТекущаяУниверсальнаяДата();
	ЗасеятьРеестр();

КонецПроцедуры

&ПослеВсех
Процедура УбратьСвоиСтроки() Экспорт

	Для Каждого Строка_ Из ЗасеянныеСтроки Цикл
		Строка_.Удалить();
	КонецЦикла;
	Для Каждого Уведомление Из ЗасеянныеУведомления Цикл
		Уведомление.Удалить();
	КонецЦикла;
	Для Каждого Заявка Из ЗасеянныеЗаявки Цикл
		Заявка.Удалить();
	КонецЦикла;
	Для Каждого Пакет Из ЗасеянныеПакеты Цикл
		Пакет.Удалить();
	КонецЦикла;
	Для Каждого Пул Из ЗасеянныеПулы Цикл
		Пул.Удалить();
	КонецЦикла;

КонецПроцедуры

#Область Приёмка

&Тест
Процедура НаPostgreSQLАгрегатыСчитаетСамаБаза() Экспорт
	Ожидаем.Что(Агрегаты.БазаСчитает(), "коннектор PostgreSQL исполняет SQL").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура СчётИНаличиеСходятсяСПрямойВыборкой() Экспорт

	Мои = МоиПулы();

	Ожидаем.Что(Агрегаты.Количество(Пулы, Мои), "счёт своих пулов")
		.Равно(Пулы.Получить(Мои).Количество());
	Ожидаем.Что(Агрегаты.Количество(Пулы, МоиПубличные()), "счёт с двумя отборами")
		.Равно(Пулы.Получить(МоиПубличные()).Количество());
	Ожидаем.Что(Агрегаты.Есть(Пулы, ПоИмени(ЗасеянныеПулы[0].Имя)), "пул с таким именем есть")
		.ЭтоИстина();
	Ожидаем.Что(Агрегаты.Есть(Пулы, ПоИмени("нет-такого-пула-" + Суффикс)), "а с таким — нет")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СуммаСходитсяСПрямойВыборкой() Экспорт

	Ожидаем.Что(Агрегаты.Сумма(Пулы, "ЗанятоБайт", МоиПулы()), "сумма занятого по своим пулам")
		.Равно(ЗанятоПоВыборке(МоиПулы()));
	Ожидаем.Что(Агрегаты.Сумма(Пулы, "ЗанятоБайт", ПоИмени("нет-такого-пула-" + Суффикс)),
		"сумма по пустому отбору — ноль, а не NULL").Равно(0);

КонецПроцедуры

&Тест
Процедура РазрезыСходятсяСПрямойВыборкой() Экспорт

	ПоПулам = Агрегаты.КоличествоПоКлючу(Пакеты, "ПулИдентификатор", МоиПакеты());
	Ожидаем.Что(ПоПулам.Количество(), "в разрезе только пулы с пакетами").Равно(2);
	Ожидаем.Что(ПоПулам.Получить(Цел(ЗасеянныеПулы[0].Идентификатор)), "пакетов первого пула")
		.Равно(3);
	Ожидаем.Что(ПоПулам.Получить(Цел(ЗасеянныеПулы[1].Идентификатор)), "пакетов второго пула")
		.Равно(1);
	Ожидаем.Что(ПоПулам.Получить(Цел(ЗасеянныеПулы[2].Идентификатор)),
		"пула без пакетов в разрезе нет").ЭтоНеопределено();

	ПоВидимости = Агрегаты.СуммаПоКлючу(Пулы, "Видимость", "ЗанятоБайт", МоиПулы());
	Ожидаем.Что(ПоВидимости.Получить("public"), "объём своих публичных").Равно(30);
	Ожидаем.Что(ПоВидимости.Получить("private"), "объём своих закрытых").Равно(30);

КонецПроцедуры

// Цена агрегата — то, ради чего он и заведён: одно обращение к СУБД и ни одной поднятой
// строки там, где прямая выборка поднимает их все.
&Тест
Процедура АгрегатСтоитОдногоЗапросаИНеПоднимаетСущностей() Экспорт

	Счётчик.Сбросить();
	Агрегаты.Количество(Пулы, МоиПулы());
	Ожидаем.Что(Счётчик.Запросов(), "счёт — один запрос").Равно(1);
	Ожидаем.Что(Счётчик.ПоднятоСущностей(), "и ни одной поднятой сущности").Равно(0);
	Ожидаем.Что(Счётчик.Тексты()[0], "запросом считает сама база").Содержит("COUNT(*)");

	Счётчик.Сбросить();
	Агрегаты.КоличествоПоКлючу(Пакеты, "ПулИдентификатор", МоиПакеты());
	Ожидаем.Что(Счётчик.Запросов(), "разрез — тоже один запрос").Равно(1);
	Ожидаем.Что(Счётчик.ПоднятоСущностей(), "и ни одной поднятой сущности").Равно(0);
	Ожидаем.Что(Счётчик.Тексты()[0], "с группировкой на стороне базы").Содержит("GROUP BY");

	Счётчик.Сбросить();
	Всего = Пулы.Получить(МоиПулы()).Количество();
	Ожидаем.Что(Счётчик.ПоднятоСущностей(), "а прямая выборка поднимает строки все").Равно(Всего);

КонецПроцедуры

// Ни SQL, ни сложение в памяти текст не суммируют. Отказ обязан быть один на обе дороги
// и до обращения к базе: иначе одна дорога молчала бы, а вторая падала пятисоткой.
&Тест
Процедура СуммаПоТекстовойКолонкеОтвергаетсяДоОбращенияКБазе() Экспорт

	Счётчик.Сбросить();

	Ожидаем.Что(УпалоНаСумме("Имя"), "сумма по текстовой колонке отвергнута").ЭтоИстина();
	Ожидаем.Что(УпалоНаСумме("Создан"), "и по колонке момента тоже").ЭтоИстина();
	Ожидаем.Что(Счётчик.Запросов(), "база об этом даже не спрошена").Равно(0);

КонецПроцедуры

// Npgsql пишет пустую дату в timestamp как -infinity, и «Истекает = '0001-01-01 …'»
// не находит НИ ОДНОЙ строки — молча. Владелец, у которого ЕДИНСТВЕННЫЙ ключ бессрочный,
// читал бы «заведите ключ» при живом ключе; сосед с единственным истёкшим здесь затем,
// чтобы «Истина» не приходила из воздуха.
&Тест
Процедура ВладелецОдногоБессрочногоКлючаНаходитсяСамойБазой() Экспорт

	Ключи_ = Желудь("ХранилищеТокенов");
	Сейчас = ТекущаяУниверсальнаяДата();

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("АгрегатыБазы");
	УровеньДоТеста = Лог.Уровень();
	Лог.УстановитьУровень(УровниЛога.Предупреждение);
	Лог.ДобавитьСпособВывода(Ловушка);

	Попытка
		Бессрочный = Ключи_.ЕстьДействующий(ВладелецТолькоБессрочного(), Сейчас);
		Истёкший = Ключи_.ЕстьДействующий(ВладелецТолькоИстёкшего(), Сейчас);
	Исключение
		ВернутьЛог(Лог, Ловушка, УровеньДоТеста);
		ВызватьИсключение;
	КонецПопытки;
	ВернутьЛог(Лог, Ловушка, УровеньДоТеста);

	Ожидаем.Что(Агрегаты.БазаСчитает(), "считает база, а не память").ЭтоИстина();
	Ожидаем.Что(Бессрочный, "единственный бессрочный ключ найден").ЭтоИстина();
	Ожидаем.Что(Истёкший, "а единственный истёкший — нет").ЭтоЛожь();
	Ожидаем.Что(Ловушка.Всё(), "и база ни в чём не обвинена: " + Ловушка.Всё()).Равно("");

КонецПроцедуры

// Прямая сверка дорог на отборе по незаполненному моменту: у агрегата и у деривации
// одна и та же таблица, где есть и пустые моменты, и заполненные.
&Тест
Процедура ОтборПоНезаполненномуМоментуСходитсяСДеривацией() Экспорт

	Входящие_ = Желудь("ЗапросыВходящихПубликаций");

	Нерассмотренные = ЗаявкиЗамера().Отбор("Рассмотрена", ВидСравнения.Равно, ПустаяДата());
	Рассмотренные = ЗаявкиЗамера().Отбор("Рассмотрена", ВидСравнения.НеРавно, ПустаяДата());

	Ожидаем.Что(Агрегаты.Количество(Входящие_, Нерассмотренные), "нерассмотренные")
		.Равно(Входящие_.Получить(Нерассмотренные).Количество());
	Ожидаем.Что(Агрегаты.Количество(Входящие_, Нерассмотренные), "и их засеяно трое").Равно(3);

	Ожидаем.Что(Агрегаты.Количество(Входящие_, Рассмотренные), "рассмотренные")
		.Равно(Входящие_.Получить(Рассмотренные).Количество());
	Ожидаем.Что(Агрегаты.Количество(Входящие_, Рассмотренные), "и она одна").Равно(1);

	// «больше пустого» и «не позже пустого» на -infinity отвечают так же, как в памяти
	Позже = ЗаявкиЗамера().Отбор("Рассмотрена", ВидСравнения.Больше, ПустаяДата());
	НеПозже = ЗаявкиЗамера().Отбор("Рассмотрена", ВидСравнения.МеньшеИлиРавно, ПустаяДата());

	Ожидаем.Что(Агрегаты.Количество(Входящие_, Позже), "«больше пустого»")
		.Равно(Входящие_.Получить(Позже).Количество());
	Ожидаем.Что(Агрегаты.Количество(Входящие_, НеПозже), "«не позже пустого»")
		.Равно(Входящие_.Получить(НеПозже).Количество());

КонецПроцедуры

// «Не раньше пустого» в памяти берёт ВСЕ строки, а в PostgreSQL — все, кроме -infinity;
// «раньше пустого» в памяти не берёт НИ ОДНОЙ, а в PostgreSQL берёт как раз -infinity.
// Переписать их нечем, поэтому агрегат отказывается и ответ приезжает выборкой: цифра
// остаётся той же, что у деривации, а в журнале стоит «не собран», а не обвинение базы.
&Тест
Процедура ВидыСравненияРасходящиесяНаПустомМоментеУходятВПамять() Экспорт

	Входящие_ = Желудь("ЗапросыВходящихПубликаций");

	НеРаньше = ЗаявкиЗамера().Отбор("Рассмотрена", ВидСравнения.БольшеИлиРавно, ПустаяДата());
	Раньше = ЗаявкиЗамера().Отбор("Рассмотрена", ВидСравнения.Меньше, ПустаяДата());

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("АгрегатыБазы");
	УровеньДоТеста = Лог.Уровень();
	Лог.УстановитьУровень(УровниЛога.Предупреждение);
	Лог.ДобавитьСпособВывода(Ловушка);

	Попытка
		Счётчик.Сбросить();
		СчётНеРаньше = Агрегаты.Количество(Входящие_, НеРаньше);
		ПоднятоНеРаньше = Счётчик.ПоднятоСущностей();
		СчётРаньше = Агрегаты.Количество(Входящие_, Раньше);
	Исключение
		ВернутьЛог(Лог, Ловушка, УровеньДоТеста);
		ВызватьИсключение;
	КонецПопытки;
	ВернутьЛог(Лог, Ловушка, УровеньДоТеста);

	Ожидаем.Что(СчётНеРаньше, "«не раньше пустого» — как у деривации")
		.Равно(Входящие_.Получить(НеРаньше).Количество());
	Ожидаем.Что(СчётНеРаньше, "то есть все четыре заявки").Равно(4);
	Ожидаем.Что(СчётРаньше, "«раньше пустого» — как у деривации")
		.Равно(Входящие_.Получить(Раньше).Количество());
	Ожидаем.Что(СчётРаньше, "то есть ни одной").Равно(0);

	Ожидаем.Что(ПоднятоНеРаньше > 0, "ответ приехал выборкой, а не запросом").ЭтоИстина();
	Ожидаем.Что(Ловушка.Всё(), "журнал говорит про несобранный запрос").Содержит("не собран");
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "база не посчитала"), "и базу не обвиняет").Равно(0);

КонецПроцедуры

// Отбор «только мои заявки»: база общая для всех прогонов.
Функция ЗаявкиЗамера()
	Возврат Новый ОпцииПоиска()
		.Отбор("ЗаявительИдентификатор", ВидСравнения.Равно, ЗаявительЗамера());
КонецФункции

// Дата в отборе печатается ISO-строкой, а колонка timestamp сравнивается с ней самой базой:
// расхождение часового пояса между записью entity и нашим литералом видно только здесь.
&Тест
Процедура ДатаВОтбореСравниваетсяСКолонкойТакЖеКакВПамяти() Экспорт

	Граница = НачалоЗасева() - 1;
	Свежие = Новый ОпцииПоиска()
		.Отбор("ЗаявительИдентификатор", ВидСравнения.Равно, ЗаявительЗамера())
		.Отбор("Создана", ВидСравнения.Больше, Граница);
	Старые = Новый ОпцииПоиска()
		.Отбор("ЗаявительИдентификатор", ВидСравнения.Равно, ЗаявительЗамера())
		.Отбор("Создана", ВидСравнения.Меньше, Граница);

	Входящие_ = Желудь("ЗапросыВходящихПубликаций");

	Ожидаем.Что(Агрегаты.Количество(Входящие_, Свежие), "заявки позже границы")
		.Равно(Входящие_.Получить(Свежие).Количество());
	Ожидаем.Что(Агрегаты.Количество(Входящие_, Свежие), "и их действительно все четыре").Равно(4);
	Ожидаем.Что(Агрегаты.Количество(Входящие_, Старые), "заявок раньше границы нет")
		.Равно(Входящие_.Получить(Старые).Количество());

	// одностороннюю границу сдвиг часового пояса на три часа не поймал бы: равенство
	// записанному моменту ловит
	Записанный = ЗасеянныеЗаявки[0].Создана;
	ПоМоменту = Новый ОпцииПоиска()
		.Отбор("ЗаявительИдентификатор", ВидСравнения.Равно, ЗаявительЗамера())
		.Отбор("Создана", ВидСравнения.Равно, Записанный);

	Ожидаем.Что(Агрегаты.Количество(Входящие_, ПоМоменту), "равенство записанному моменту")
		.Равно(Входящие_.Получить(ПоМоменту).Количество());
	Ожидаем.Что(Агрегаты.Количество(Входящие_, ПоМоменту) > 0,
		"и такая заявка в базе есть — иначе сверялись бы два нуля").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ФасадыХранилищ

// Фасады слоя данных отдают то же число, что и обход их собственной выборки. Проверка
// идёт на живой СУБД: на файловом бэкенде обе дороги — одна и та же выборка в памяти,
// и расхождение SQL с обходом там проявиться не может.
&Тест
Процедура ФасадыСчитаютТоЖеЧтоИхСобственнаяВыборка() Экспорт

	// подчёркивание в локальных именах — чтобы имя не отобрало глобальное у библиотеки:
	// «Версии» занято общим модулем semver, «Пулы» и «Теги» — соседями по хабу
	// (ЗНАНИЕ, захват имён в OneScript)
	Пулы_ = Желудь("ХранилищеПулов");
	Ожидаем.Что(Пулы_.Количество(), "счёт пулов").Равно(Пулы_.Все().Количество());
	Ожидаем.Что(Пулы_.СуммаЗанятогоБайт(), "занятое всеми пулами").Равно(ЗанятоОбходом(Пулы_));

	Учётки_ = Желудь("ХранилищеПользователей");
	Ожидаем.Что(Учётки_.Количество(), "счёт учёток").Равно(Учётки_.Все().Количество());

	Входящие_ = Желудь("ХранилищеВходящихПубликаций");
	Ожидаем.Что(Входящие_.СчётЗаявокПула(ЗасеянныеПулы[0].Идентификатор, СостояниеЗамера()),
		"очередь пула").Равно(2);
	Ожидаем.Что(Входящие_.СчётЗаявокЗаявителя(ЗаявительЗамера(), СостояниеЗамера()),
		"очередь заявителя").Равно(3);
	Ожидаем.Что(Входящие_.СчётЗаявокПоПулам(СостояниеЗамера()).Получить(
		Цел(ЗасеянныеПулы[1].Идентификатор)), "разрез очереди по пулам").Равно(1);

	Уведомления_ = Желудь("ХранилищеЛичныхУведомлений");
	Ожидаем.Что(Уведомления_.СчётНепрочитанных(АдресатЗамера()), "счёт непрочитанного")
		.Равно(Уведомления_.Непрочитанные(АдресатЗамера()).Количество());
	Ожидаем.Что(Уведомления_.СчётНепрочитанных(АдресатЗамера()), "и он равен засеянным двум")
		.Равно(2);

КонецПроцедуры

// Пакеты, версии и теги на живой СУБД.
&Тест
Процедура ФасадыРеестраСчитаютТоЖеЧтоИхСобственнаяВыборка() Экспорт

	Пакеты_ = Желудь("ХранилищеПакетов");
	ПулПервый = Цел(ЗасеянныеПулы[0].Идентификатор);

	Ожидаем.Что(Пакеты_.КоличествоВПуле(ПулПервый), "пакетов в пуле")
		.Равно(Пакеты_.ПолучитьПоПулИдентификаторРавно(ПулПервый).Количество());
	Ожидаем.Что(Пакеты_.КоличествоВПуле(ПулПервый), "скрытый считается вместе с прочими")
		.Равно(3);
	Ожидаем.Что(Пакеты_.КоличествоВидимыхВПулах(МоиПулыИдентификаторами()),
		"а среди видимых его нет: их трое из четырёх").Равно(3);
	Ожидаем.Что(Пакеты_.КоличествоВидимыхВПулах(Новый Массив()),
		"пустой список пулов — ноль").Равно(0);

	Версии_ = Желудь("ХранилищеВерсийПакета");
	ПакетПервый = Цел(ЗасеянныеПакеты[0].Идентификатор);

	Ожидаем.Что(Версии_.КоличествоВПакетах(МоиПакетыИдентификаторами()), "версий своих пакетов")
		.Равно(3);
	Ожидаем.Что(Версии_.КоличествоВПакетах(Новый Массив()), "пустой список пакетов — ноль")
		.Равно(0);
	Ожидаем.Что(Версии_.ЕстьВерсии(ПакетПервый), "у пакета с версиями они есть").ЭтоИстина();
	Ожидаем.Что(Версии_.ЕстьВерсии(Цел(ЗасеянныеПакеты[2].Идентификатор)),
		"у пакета без версий их нет").ЭтоЛожь();
	Ожидаем.Что(Версии_.ЕстьВерсияПубликатора(ПакетПервый, ПубликаторЗамера()),
		"свою версию публикатор находит").ЭтоИстина();
	Ожидаем.Что(Версии_.ЕстьВерсияПубликатора(Цел(ЗасеянныеПакеты[1].Идентификатор),
		ПубликаторЗамера()), "а в чужом пакете — нет").ЭтоЛожь();
	Ожидаем.Что(Версии_.ЕстьВерсииПубликатораВХабе(ПубликаторЗамера()),
		"по хабу версии публикатора есть").ЭтоИстина();
	Ожидаем.Что(Версии_.ЕстьВерсииПубликатораВХабе(ПубликаторЗамера() + 1),
		"а у соседнего идентификатора — нет").ЭтоЛожь();

	Теги_ = Желудь("ХранилищеТегов");
	Ожидаем.Что(Теги_.ЕстьТегиПакета(ПакетПервый), "у помеченного пакета теги есть").ЭтоИстина();
	Ожидаем.Что(Теги_.ЕстьТегиПакета(Цел(ЗасеянныеПакеты[2].Идентификатор)),
		"у непомеченного — нет").ЭтоЛожь();

КонецПроцедуры

// Источники пулов, участники групп, очередь доставок и происшествия на живой СУБД.
&Тест
Процедура ФасадыСлужбСчитаютТоЖеЧтоИхСобственнаяВыборка() Экспорт

	Источники_ = Желудь("ХранилищеАпстримовПула");
	Ожидаем.Что(Источники_.ЕстьУПула(Цел(ЗасеянныеПулы[0].Идентификатор)),
		"у пула с источником он есть").ЭтоИстина();
	Ожидаем.Что(Источники_.ЕстьУПула(Цел(ЗасеянныеПулы[2].Идентификатор)),
		"у пула без источников — нет").ЭтоЛожь();
	Ожидаем.Что(Источники_.ПулыСИсточниками().Найти(Цел(ЗасеянныеПулы[0].Идентификатор)),
		"свой пул в разрезе назван").Существует();
	Ожидаем.Что(Источники_.ПулыСИсточниками().Найти(Цел(ЗасеянныеПулы[2].Идентификатор)),
		"а пула без источников в разрезе нет").ЭтоНеопределено();

	Участники_ = Желудь("ХранилищеУчастниковГрупп");
	Составы = Участники_.СчётПоГруппам(МоиГруппыИдентификаторами());
	Ожидаем.Что(Составы.Получить(ГруппаЗамера()), "участников первой группы").Равно(2);
	Ожидаем.Что(Составы.Получить(ГруппаЗамера() + 1), "участников второй").Равно(1);
	Ожидаем.Что(Составы.Получить(ГруппаЗамера() + 2), "пустой группы в разрезе нет")
		.ЭтоНеопределено();

	Задания_ = Желудь("ХранилищеЗаданийДоставки");
	Ожидаем.Что(Задания_.Количество(), "размер очереди доставок")
		.Равно(Задания_.Все().Количество());
	Ожидаем.Что(Задания_.Количество() > 0, "и очередь не пуста").ЭтоИстина();

	Происшествия_ = Желудь("ХранилищеПроисшествий");
	Ожидаем.Что(Происшествия_.Количество("зеркало", ОбъектЗамера()), "все происшествия объекта")
		.Равно(2);
	Ожидаем.Что(Происшествия_.Количество("зеркало", ОбъектЗамера(), ПрогонЗамера()),
		"происшествия одного обхода").Равно(1);
	Ожидаем.Что(Происшествия_.Есть("зеркало", ОбъектЗамера()), "они есть").ЭтоИстина();
	Ожидаем.Что(Происшествия_.Есть("зеркало", ОбъектЗамера() + "-чужой"),
		"у чужого объекта — нет").ЭтоЛожь();

КонецПроцедуры

// Счётчики скачиваний: сумма по пакету, по версии и оба разреза.
&Тест
Процедура СчётчикиСкачиванийСуммируютсяСамойБазой() Экспорт

	Счётчики_ = Желудь("ХранилищеСкачиванийАгрегатов");
	ПакетПервый = Цел(ЗасеянныеПакеты[0].Идентификатор);

	Ожидаем.Что(Счётчики_.СуммаПоПакету(ПакетПервый), "скачивания пакета за все сутки")
		.Равно(12);
	Ожидаем.Что(Счётчики_.СуммаПоВерсии(ВерсияЗамера()), "скачивания версии").Равно(15);

	Разрез = Счётчики_.СуммыПакетов(МоиПакетыИдентификаторами());
	Ожидаем.Что(Разрез.Получить(ПакетПервый), "разрез по списку: первый пакет").Равно(12);
	Ожидаем.Что(Разрез.Получить(Цел(ЗасеянныеПакеты[1].Идентификатор)), "и второй").Равно(3);
	Ожидаем.Что(Разрез.Получить(Цел(ЗасеянныеПакеты[2].Идентификатор)),
		"пакета без скачиваний в разрезе нет").ЭтоНеопределено();

	Ожидаем.Что(Счётчики_.СуммыПоПакетам().Получить(ПакетПервый),
		"разрез по всему хабу называет то же число").Равно(12);
	Ожидаем.Что(Счётчики_.СуммыПакетов(Новый Массив()).Количество(),
		"пустой список пакетов — пустой разрез").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Так сумму собирал обход пулов до агрегата: счётчик ниже нуля вносит ноль.
Функция ЗанятоОбходом(Знач ХранилищеПулов)

	Всего = 0;
	Для Каждого Пул Из ХранилищеПулов.Все() Цикл
		Всего = Всего + Макс(0, Цел(Пул.ЗанятоБайт));
	КонецЦикла;

	Возврат Всего;

КонецФункции

Процедура ЗасеятьРеестр()

	Засев = Новый ЗасевРеестра(Поделка);

	ЗасеянныеПулы.Добавить(ЗасеятьПул(Засев, "public", 10));
	ЗасеянныеПулы.Добавить(ЗасеятьПул(Засев, "public", 20));
	ЗасеянныеПулы.Добавить(ЗасеятьПул(Засев, "private", 30));

	ЗасеянныеПакеты.Добавить(Засев.Пакет(ЗасеянныеПулы[0], "пакет-а-" + Суффикс));
	ЗасеянныеПакеты.Добавить(Засев.Пакет(ЗасеянныеПулы[0], "пакет-б-" + Суффикс));
	ЗасеянныеПакеты.Добавить(Засев.Пакет(ЗасеянныеПулы[1], "пакет-в-" + Суффикс));
	// скрытый: без него «видимых» не отличить от «всех», и сторож доказывал бы не отбор
	ЗасеянныеПакеты.Добавить(СкрытыйПакет(Засев, ЗасеянныеПулы[0], "пакет-г-" + Суффикс));

	ЗасеятьЗаявку(ЗасеянныеПулы[0], СостояниеЗамера());
	ЗасеятьЗаявку(ЗасеянныеПулы[0], СостояниеЗамера());
	ЗасеятьЗаявку(ЗасеянныеПулы[1], СостояниеЗамера());
	// соседнее состояние: отбор по состоянию обязан его отсеять. Она же — единственная
	// РАССМОТРЕННАЯ: в таблице нужны и пустые моменты, и заполненные
	Рассмотренная = ЗасеятьЗаявку(ЗасеянныеПулы[1], "одобрена");
	Рассмотренная.Рассмотрена = ТекущаяУниверсальнаяДата();
	Рассмотренная.Сохранить();

	ЗасеятьУведомление(Ложь);
	ЗасеятьУведомление(Ложь);
	ЗасеятьУведомление(Истина);

	ЗасеятьКлючиДоступа();
	ЗасеятьОстальныеФасады(Засев);

КонецПроцедуры

// Фактура остальных фасадов. Каждая цифра отличима от «всех строк таблицы»: база общая
// для всех прогонов, и сторож, сверяющий счёт со всей таблицей, доказывал бы не отбор.
Процедура ЗасеятьОстальныеФасады(Знач Засев)

	Засеять(ВерсияПубликатора(Засев, ЗасеянныеПакеты[0], "1.0.0", ПубликаторЗамера()));
	Засеять(ВерсияПубликатора(Засев, ЗасеянныеПакеты[0], "1.1.0", ПубликаторЗамера()));
	Засеять(ВерсияПубликатора(Засев, ЗасеянныеПакеты[1], "2.0.0", 0));

	Засеять(ТегПакета(ЗасеянныеПакеты[0], "latest-" + Суффикс));

	Засеять(УчастникГруппы(ГруппаЗамера(), 1));
	Засеять(УчастникГруппы(ГруппаЗамера(), 2));
	Засеять(УчастникГруппы(ГруппаЗамера() + 1, 3));

	Засеять(ИсточникПула(ЗасеянныеПулы[0]));

	Засеять(ПроисшествиеЗамера(ПрогонЗамера()));
	Засеять(ПроисшествиеЗамера(""));

	Засеять(СкачиванияЗаДень(ЗасеянныеПакеты[0], 5, ТекущаяУниверсальнаяДата()));
	Засеять(СкачиванияЗаДень(ЗасеянныеПакеты[0], 7, ТекущаяУниверсальнаяДата() - 86400));
	Засеять(СкачиванияЗаДень(ЗасеянныеПакеты[1], 3, ТекущаяУниверсальнаяДата()));

	Засеять(ЗаданиеДоставки());

КонецПроцедуры

Функция ПубликаторЗамера()
	Возврат 600000 + Цел(ЗасеянныеПулы[0].Идентификатор);
КонецФункции

Функция ГруппаЗамера()
	Возврат 500000 + Цел(ЗасеянныеПулы[0].Идентификатор);
КонецФункции

Функция ВерсияЗамера()
	Возврат 400000 + Цел(ЗасеянныеПулы[0].Идентификатор);
КонецФункции

Функция ОбъектЗамера()
	Возврат "зеркало-" + Суффикс;
КонецФункции

Функция ПрогонЗамера()
	Возврат "прогон-" + Суффикс;
КонецФункции

Функция ВерсияПубликатора(Знач Засев, Знач Пакет, Знач Номер, Знач Публикатор)

	Запись = Засев.Версия(Пакет, Номер);
	Запись.ОпубликовалИдентификатор = Публикатор;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция ТегПакета(Знач Пакет, Знач Имя)

	Запись = Желудь("ХранилищеТегов").СоздатьЭлемент();
	Запись.ПакетИдентификатор = Цел(Пакет.Идентификатор);
	Запись.Имя = Имя;
	Запись.Режим = "";
	Запись.Правило = "";
	Запись.ТипПравила = "";
	Запись.ПоУмолчанию = Ложь;
	Запись.ПерезаписьРазрешена = Истина;
	Запись.Стиль = "";
	Запись.Значок = "";
	Запись.Обновлён = ТекущаяУниверсальнаяДата();
	Запись.КемИдентификатор = 0;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция УчастникГруппы(Знач Группа, Знач Пользователь)

	Запись = Желудь("ХранилищеУчастниковГрупп").СоздатьЭлемент();
	Запись.ГруппаИдентификатор = Цел(Группа);
	Запись.ПользовательИдентификатор = Цел(Пользователь);
	Запись.Источник = "local";
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция ИсточникПула(Знач Пул)

	Запись = Желудь("ХранилищеАпстримовПула").СоздатьЭлемент();
	Запись.ПулИдентификатор = Цел(Пул.Идентификатор);
	Запись.Порядок = 1;
	Запись.Url = "https://источник-" + Суффикс + "/";
	Запись.ТокенДоступа = "";
	Запись.ВремяЖизниСек = 60;
	Запись.СписокРазрешенийJSON = "";
	Запись.Включён = Истина;
	Запись.ПоследняяСинхронизация = ПустаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция ПроисшествиеЗамера(Знач Прогон)

	Запись = Желудь("ХранилищеПроисшествий").СоздатьЭлемент();
	Запись.Подсистема = "зеркало";
	Запись.Объект = ОбъектЗамера();
	Запись.Предмет = "";
	Запись.Код = "проба";
	Запись.Причина = "замер";
	Запись.Количество = 1;
	Запись.Впервые = ТекущаяУниверсальнаяДата();
	Запись.Последний = ТекущаяУниверсальнаяДата();
	Запись.Прогон = Прогон;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция СкачиванияЗаДень(Знач Пакет, Знач Сколько, Знач День)

	Запись = Желудь("ХранилищеСкачиванийАгрегатов").СоздатьЭлемент();
	Запись.ПакетИдентификатор = Цел(Пакет.Идентификатор);
	Запись.ВерсияИдентификатор = ВерсияЗамера();
	Запись.ДатаДень = НачалоДня(День);
	Запись.Количество = Сколько;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция ЗаданиеДоставки()

	Запись = Желудь("ХранилищеЗаданийДоставки").СоздатьЭлемент();
	Запись.ИдДоставки = "доставка-" + Суффикс;
	Запись.ТипДействия = "вебхук";
	Запись.НастройкиJSON = "{}";
	Запись.ТипСобытия = "версия.опубликована";
	Запись.Тело = "{}";
	Запись.НомерПопытки = 0;
	Запись.НеРанее = ТекущаяУниверсальнаяДата();
	Запись.Поставлено = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Три ключа одного владельца — бессрочный, действующий и истёкший — и два владельца
// с ОДНИМ ключом каждый. Одиночки здесь обязательны: у владельца с тремя ключами «есть
// действующий» приходит от любого из них, и сторож бессрочного зеленел бы по случайности.
Процедура ЗасеятьКлючиДоступа()

	Засеять(Ключ(ВладелецКлючейЗамера(), ПустаяДата()));
	Засеять(Ключ(ВладелецКлючейЗамера(), ТекущаяУниверсальнаяДата() + 86400));
	Засеять(Ключ(ВладелецКлючейЗамера(), ТекущаяУниверсальнаяДата() - 86400));

	Засеять(Ключ(ВладелецТолькоБессрочного(), ПустаяДата()));
	Засеять(Ключ(ВладелецТолькоИстёкшего(), ТекущаяУниверсальнаяДата() - 86400));

КонецПроцедуры

// Момент, которым записан бессрочный ключ.
Функция ПустаяДата()
	Возврат '00010101';
КонецФункции

// Владелец ключей замера: идентификатор свой на прогон — база общая.
Функция ВладелецКлючейЗамера()
	Возврат 700000 + Цел(ЗасеянныеПулы[0].Идентификатор);
КонецФункции

Функция ВладелецТолькоБессрочного()
	Возврат ВладелецКлючейЗамера() + 1;
КонецФункции

Функция ВладелецТолькоИстёкшего()
	Возврат ВладелецКлючейЗамера() + 2;
КонецФункции

Функция Ключ(Знач Владелец, Знач Истекает)

	Запись = Желудь("ХранилищеТокенов").СоздатьЭлемент();
	Запись.ПользовательИдентификатор = Цел(Владелец);
	Запись.Префикс = Лев(Суффикс, 6);
	Запись.Имя = "ключ-" + Суффикс;
	Запись.Хеш = "хеш-" + Суффикс;
	Запись.Права = "";
	Запись.ПулИдентификатор = 0;
	Запись.Истекает = Истекает;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Кладёт строку в общую таблицу и берёт её на уборку.
Функция Засеять(Знач Запись)
	ЗасеянныеСтроки.Добавить(Запись);
	Возврат Запись;
КонецФункции

Функция СкрытыйПакет(Знач Засев, Знач Пул, Знач Имя)

	Запись = Засев.Пакет(Пул, Имя);
	Запись.Скрыт = Истина;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Момент, снятый до засева: все заявки прогона созданы позже него.
Функция НачалоЗасева()
	Возврат НачалоЗасева_;
КонецФункции

// Состояние очереди, в котором считаются заявки замера.
Функция СостояниеЗамера()
	Возврат "ожидает";
КонецФункции

// Заявитель замера: идентификатор свой на прогон — база общая.
Функция ЗаявительЗамера()
	Возврат 900000 + Цел(ЗасеянныеПулы[0].Идентификатор);
КонецФункции

// Адресат ленты замера: идентификатор свой на прогон — база общая.
Функция АдресатЗамера()
	Возврат 800000 + Цел(ЗасеянныеПулы[0].Идентификатор);
КонецФункции

Функция ЗасеятьЗаявку(Знач Пул, Знач Состояние)

	Заявка = Желудь("ХранилищеВходящихПубликаций").СоздатьЭлемент();
	Заявка.ПулИдентификатор = Цел(Пул.Идентификатор);
	Заявка.ИмяПакета = "Заявка-" + Суффикс;
	Заявка.ИмяНижнийРегистр = НРег("Заявка-" + Суффикс);
	Заявка.Версия = "1.0." + Формат(ЗасеянныеЗаявки.Количество(), "ЧГ=0");
	Заявка.ЗаявительИдентификатор = ЗаявительЗамера();
	Заявка.Состояние = Состояние;
	Заявка.Создана = ТекущаяУниверсальнаяДата();
	Заявка.Рассмотрена = '00010101';
	Заявка.РассмотрелИдентификатор = 0;
	Заявка.ИмяФайла = "заявка.ospx";
	Заявка.Канал = "";
	Заявка.АвторМанифеста = "";
	Заявка.Размер = 0;
	Заявка.Sha256 = "";
	Заявка.КлючХранилища = "";
	Заявка.Комментарий = "";
	Заявка.Сохранить();

	ЗасеянныеЗаявки.Добавить(Заявка);

	Возврат Заявка;

КонецФункции

Процедура ЗасеятьУведомление(Знач Прочитано)

	Уведомление = Желудь("ХранилищеЛичныхУведомлений").СоздатьЭлемент();
	Уведомление.ПользовательИдентификатор = АдресатЗамера();
	Уведомление.Повод = "замер";
	Уведомление.Заголовок = "замер " + Суффикс;
	Уведомление.Текст = "";
	Уведомление.Ссылка = "";
	Уведомление.Прочитано = Прочитано;
	Уведомление.Создано = ТекущаяУниверсальнаяДата();
	Уведомление.Сохранить();

	ЗасеянныеУведомления.Добавить(Уведомление);

КонецПроцедуры

Функция ЗасеятьПул(Знач Засев, Знач Видимость, Знач Занято)

	Пул = Засев.Пул("пул-" + Видимость + "-" + Формат(Занято, "ЧГ=0") + "-" + Суффикс, Видимость);
	Пул.ЗанятоБайт = Занято;
	Пул.Сохранить();

	Возврат Пул;

КонецФункции

// Отбор «мои строки»: база общая для всех прогонов, и агрегат по всей таблице сверять
// не с чем.
Функция МоиПулы()

	Имена = Новый Массив();
	Для Каждого Пул Из ЗасеянныеПулы Цикл
		Имена.Добавить(Пул.Имя);
	КонецЦикла;

	Возврат Новый ОпцииПоиска().Отбор("Имя", ВидСравнения.В, Имена);

КонецФункции

Функция МоиПубличные()
	Возврат МоиПулы().Отбор("Видимость", ВидСравнения.Равно, "public");
КонецФункции

Функция МоиПулыИдентификаторами()

	Результат = Новый Массив();
	Для Каждого Пул Из ЗасеянныеПулы Цикл
		Результат.Добавить(Цел(Пул.Идентификатор));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МоиПакетыИдентификаторами()

	Результат = Новый Массив();
	Для Каждого Пакет Из ЗасеянныеПакеты Цикл
		Результат.Добавить(Цел(Пакет.Идентификатор));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МоиГруппыИдентификаторами()

	Результат = Новый Массив();
	Результат.Добавить(ГруппаЗамера());
	Результат.Добавить(ГруппаЗамера() + 1);
	Результат.Добавить(ГруппаЗамера() + 2);

	Возврат Результат;

КонецФункции

Функция МоиПакеты()

	Идентификаторы = Новый Массив();
	Для Каждого Пул Из ЗасеянныеПулы Цикл
		Идентификаторы.Добавить(Цел(Пул.Идентификатор));
	КонецЦикла;

	Возврат Новый ОпцииПоиска().Отбор("ПулИдентификатор", ВидСравнения.В, Идентификаторы);

КонецФункции

Функция ПоИмени(Знач Имя)
	Возврат Новый ОпцииПоиска().Отбор("Имя", ВидСравнения.Равно, Имя);
КонецФункции

// Отказ сверяется кодом: любое другое исключение — находка, а не ожидаемое поведение.
Функция УпалоНаСумме(Знач ИмяПоля)

	Попытка
		Агрегаты.Сумма(Пулы, ИмяПоля, МоиПулы());
	Исключение
		Возврат ДиагностикаОшибок.Содержит(ИнформацияОбОшибке(),
			КодыСтандартныхОшибок.ОперацияНеПоддерживается());
	КонецПопытки;

	Возврат Ложь;

КонецФункции

Функция ЗанятоПоВыборке(Знач Опции)

	Итог = 0;
	Для Каждого Пул Из Пулы.Получить(Опции) Цикл
		Итог = Итог + Пул.ЗанятоБайт;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Лог logos живёт на процесс: ловушку и уровень надо вернуть, иначе тест испортит журнал
// следующим тестам набора.
Процедура ВернутьЛог(Знач Лог, Знач Ловушка, Знач Уровень)
	Лог.УдалитьСпособВывода(Ловушка);
	Лог.УстановитьУровень(Уровень);
КонецПроцедуры

Функция ПостроитьКонтейнер(Знач СтрокаСоединения)

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторPostgreSQL");
	ИсточникДанных.Вставить("СтрокаСоединения", СтрокаСоединения);

	Детальки = Новый Соответствие();
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Контейнер = Новый Поделка(Совет);
	Контейнер.ЗапуститьПриложение();

	Возврат Контейнер;

КонецФункции

#КонецОбласти
