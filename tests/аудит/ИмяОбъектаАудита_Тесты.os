// Адрес объекта в журнале аудита: сборка из готовых имён, имена по идентификатору от предметов
// и «тип#идентификатор» у утраченной сущности.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулей;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	ПоискКлассов.Подключить(КаталогМодулей, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогМодулей, "КанонIP");
	// имена объектов называют их предметы: реестр — пулы и пакеты, вход — учётки, права — группы
	ПоискКлассов.Подключить(КаталогМодулей, "ИменаОбъектовРеестра");
	ПоискКлассов.Подключить(КаталогМодулей, "ИменаОбъектовВхода");
	ПоискКлассов.Подключить(КаталогМодулей, "ИменаОбъектовПрав");
	РеестрФикстур.Подключить("ФейкХранилищеСущностей");
	РеестрФикстур.Подключить("ФейкСущностьАудита");

КонецПроцедуры

#Область Компоновка

&Тест
Процедура АдресаСобираютсяЕдинымФорматом() Экспорт

	Имена = Новый ИмяОбъектаАудита();

	Ожидаем.Что(Имена.Хаб(), "хаб").Равно("хаб");
	Ожидаем.Что(Имена.ПулПоИмени("main"), "пул отличим от учётки словом «пул»").Равно("пул/main");
	Ожидаем.Что(Имена.ПакетПоИменам("main", "oint"), "пакет").Равно("main/oint");
	Ожидаем.Что(Имена.ВерсияПоИменам("main", "oint", "1.2.3"), "версия").Равно("main/oint@1.2.3");
	Ожидаем.Что(Имена.Пользователь("alice"), "учётка — с префиксом").Равно("пользователь/alice");

КонецПроцедуры

&Тест
Процедура ОбъектыПроисшествийНазываютСебяТемЧемИхВидитОператор() Экспорт

	// зеркало — номером, хранилище — корзиной либо корнем, источник — адресом: схема
	// и путь здесь часть имени, без них оператор не найдёт объект руками
	Имена = Новый ИмяОбъектаАудита();

	Ожидаем.Что(Имена.Зеркало(17), "зеркало").Равно("зеркало/17");
	Ожидаем.Что(Имена.ХранилищеS3("openhub-artifacts"), "корзина, а не эндпоинт с ключами")
		.Равно("хранилище/s3://openhub-artifacts");
	Ожидаем.Что(Имена.ХранилищеФайлами("./data"), "файловый корень").Равно("хранилище/./data");
	Ожидаем.Что(Имена.Источник("https://hub.example/download/"), "источник")
		.Равно("источник/https://hub.example/download/");

КонецПроцедуры

&Тест
Процедура МеткаУтраченнойСущностиВКоординатуНеПускается() Экспорт

	// «#» — метка «тип#идентификатор»: координата с ней перестала бы отличаться
	// от утраченного объекта, поэтому обезвреживается вместе с управляющими
	Имена = Новый ИмяОбъектаАудита();

	Ожидаем.Что(Имена.ХранилищеS3("bucket#1"), "решётка снята").Равно("хранилище/s3://bucket_1");
	Ожидаем.Что(Имена.Источник("https://hub.example/a b"), "пробел снят")
		.Равно("источник/https://hub.example/a_b");
	Ожидаем.Что(Имена.ЭтоАдресЖурнала("хранилище/s3://bucket#1"),
		"координата с решёткой формы не держит").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПробелыИРегистрИменНеПортятАдрес() Экспорт

	Имена = Новый ИмяОбъектаАудита();

	Ожидаем.Что(Имена.ВерсияПоИменам("  main ", " oint", "1.0.0 "), "края обрезаются")
		.Равно("main/oint@1.0.0");
	Ожидаем.Что(Имена.Пользователь(" Alice "), "регистр логина сохраняется как есть").Равно("пользователь/Alice");

КонецПроцедуры

&Тест
Процедура ПустоеИмяНеСклеиваетАдресВНеразбираемый() Экспорт

	// без заглушки получилось бы "/oint" и "main/" — адреса, по которым объект не найти
	Имена = Новый ИмяОбъектаАудита();

	Ожидаем.Что(Имена.ПакетПоИменам("", "oint"), "пул неизвестен").Равно("?/oint");
	Ожидаем.Что(Имена.ПакетПоИменам("main", ""), "пакет неизвестен").Равно("main/?");
	Ожидаем.Что(Имена.ПулПоИмени(""), "имя пула пусто").Равно("пул/?");

КонецПроцедуры

#КонецОбласти

#Область Резолв

&Тест
Процедура ПулИПакетРезолвятсяПоИдентификатору() Экспорт

	Пулы = Новый ФейкХранилищеСущностей();
	Пулы.Добавить(Новый ФейкСущностьАудита(7, "main"));
	Пакеты = Новый ФейкХранилищеСущностей();
	Пакеты.Добавить(Новый ФейкСущностьАудита(42, "oint", 7));

	Имена = Новый ИмяОбъектаАудита(Называющие(Новый ИменаОбъектовРеестра(Пулы, Пакеты)));

	Ожидаем.Что(Имена.Пул(7), "пул по номеру").Равно("пул/main");
	Ожидаем.Что(Имена.Пакет(42), "пакет по номеру — с именем своего пула").Равно("main/oint");
	Ожидаем.Что(Имена.ПоТипу("ПУЛ", 7), "тип нормализуется").Равно("пул/main");
	Ожидаем.Что(Имена.ПоТипу("пакет", 42), "пакет по типу").Равно("main/oint");
	Ожидаем.Что(Имена.ПоТипу("хаб", 0), "хаб идентификатора не спрашивает").Равно("хаб");

КонецПроцедуры

&Тест
Процедура СубъектПраваНазываетсяЛогиномИлиИменемГруппы() Экспорт

	Люди = Новый ФейкХранилищеСущностей();
	Человек = Новый ФейкСущностьАудита(3, "");
	Человек.Логин = "alice";
	Люди.Добавить(Человек);
	Группы = Новый ФейкХранилищеСущностей();
	Группы.Добавить(Новый ФейкСущностьАудита(5, "релиз-инженеры"));

	Имена = Новый ИмяОбъектаАудита(Называющие(Новый ИменаОбъектовВхода(Люди), Новый ИменаОбъектовПрав(Группы)));

	Ожидаем.Что(Имена.Субъект("пользователь", 3), "субъект-учётка").Равно("пользователь/alice");
	Ожидаем.Что(Имена.Субъект("группа", 5), "субъект-группа").Равно("группа/релиз-инженеры");
	Ожидаем.Что(Имена.Субъект("пользователь", 999), "снесённая учётка").Равно("пользователь#999");
	Ожидаем.Что(Имена.Субъект("робот", 1), "неизвестный тип субъекта").Равно("робот#1");

КонецПроцедуры

&Тест
Процедура УтраченнаяСущностьСохраняетПрежнюЮФормуАдреса() Экспорт

	// утраченная сущность — «тип#идентификатор»: эту форму читают экран и отбор
	Имена = Новый ИмяОбъектаАудита(Называющие(
		Новый ИменаОбъектовРеестра(Новый ФейкХранилищеСущностей(), Новый ФейкХранилищеСущностей())));

	Ожидаем.Что(Имена.Пул(10), "снесённый пул").Равно("пул#10");
	Ожидаем.Что(Имена.Пакет(1), "снесённый пакет").Равно("пакет#1");
	Ожидаем.Что(Имена.ПоТипу("группа", 4), "тип, объектом права не бывающий").Равно("группа#4");
	Ожидаем.Что(Имена.Неизвестный("пул", 0), "нулевой идентификатор").Равно("пул#0");

КонецПроцедуры

&Тест
Процедура БезХранилищаРезолвПадаетАНеВыдаётНомерЗаАдрес() Экспорт

	// «пул#7» означает «сущность утрачена». Выдавать эту форму, когда резолвить было
	// НЕКОМУ, значит выдать невнедрённый желудь за штатный адрес: экран показывает номер,
	// и жалоба «в журнале номера вместо имён» не отличима от снесённого пула.
	Имена = Новый ИмяОбъектаАудита();

	Ожидаем.Что(Отказ(Имена, "пул", 7), "пулы называть некому").Содержит("«пул» назвать некому");
	Ожидаем.Что(Отказ(Имена, "пакет", 42), "пакеты называть некому").Содержит("«пакет» назвать некому");
	Ожидаем.Что(Отказ(Имена, "пользователь", 3), "учётки называть некому")
		.Содержит("«пользователь» назвать некому");
	Ожидаем.Что(Отказ(Имена, "группа", 5), "группы называть некому").Содержит("«группа» назвать некому");

	// а компоновка из готовых имён без называющих работала и работает
	Ожидаем.Что(Имена.Пользователь("alice"), "логин уже в руках у вызывающего")
		.Равно("пользователь/alice");

КонецПроцедуры

&Тест
Процедура ПакетБезСвоегоПулаНеТеряетИмени() Экспорт

	Пакеты = Новый ФейкХранилищеСущностей();
	Пакеты.Добавить(Новый ФейкСущностьАудита(42, "oint", 7));
	Имена = Новый ИмяОбъектаАудита(Называющие(Новый ИменаОбъектовРеестра(Новый ФейкХранилищеСущностей(), Пакеты)));

	Ожидаем.Что(Имена.Пакет(42), "пул снесён, пакет остался").Равно("?/oint");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Реализации контракта ИменаОбъектовАудита — так их собирает ОСень массивом по прозвищу.
Функция Называющие(Знач Первый, Знач Второй = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Текст отказа резолва; пустая строка — резолв неожиданно прошёл и что-то выдал.
Функция Отказ(Знач Имена, Знач ТипОбъекта, Знач Идентификатор)

	Попытка
		Если ТипОбъекта = "пул" Тогда
			Имена.Пул(Идентификатор);
		ИначеЕсли ТипОбъекта = "пакет" Тогда
			Имена.Пакет(Идентификатор);
		Иначе
			Имена.Субъект(ТипОбъекта, Идентификатор);
		КонецЕсли;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти
