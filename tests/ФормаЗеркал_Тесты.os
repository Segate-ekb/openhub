// Форма заведения зеркала в доме «Пул»: примечание о пробном подключении обязано
// совпадать с тем, делает ли хаб пробу на самом деле. Базы нет — зеркала пула отдаёт
// фейк сервиса, выключатель пробы читает настоящий ПробникИсточника.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем UI;         // СборкаUI — граф компонентов и рендереров web-ui
Перем Кабинет;    // РендерерКабинета
Перем Прогоны;    // ПредставлениеПрогонаЗеркала
Перем Зеркала;    // ФейкСервисЗеркалЭкрана
Перем Пул;        // ПулЗаглушка
Перем Настройки;  // НастройкиЗаглушка — выключатель пробы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисЗеркалЭкрана");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ФлажокВРазметке");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.ПодключитьОснову(КаталогМодулей);
	// пробник источника спрашивает ожидание похода наружу у сеть/ТаймаутыHTTP
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СчётчикиОбхода");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СрезОбхода");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "СекретИсточника");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "ЗаведениеИсточника");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "ПробникИсточника");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "РендерерКабинета");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "ПредставлениеПрогонаЗеркала");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "ВитринаЗеркал");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "БланкРаздела");

	Кабинет = Новый РендерерКабинета(UI.Каркас);
	Прогоны = Новый ПредставлениеПрогонаЗеркала(UI.Тексты,
		Новый СчётчикиОбхода(Новый ПриведениеЧисел()));

	Пул = Новый ПулЗаглушка(7, "owned", "custom");

КонецПроцедуры

&ПередКаждым
Процедура ЗадатьОкружение() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси();

	Зеркала = Новый ФейкСервисЗеркалЭкрана();
	Зеркала.Задать(ЗаведённыеЗеркала());

КонецПроцедуры

// Дефект аудита 2026-08-08: обещание пробы на форме зеркала печаталось безусловно, хотя
// зеркала/СервисЗеркал.ПроверитьПодключение ходит через тот же ПробникИсточника, что и
// заведение источника пула. Экран не вправе обещать проверку, которой на этом хабе нет.
&Тест
Процедура ФормаОбещаетПробуТолькоКогдаХабЕёДелает() Экспорт

	Настройки.Задать("oshub.upstream.probe.enabled", Истина);
	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, ОбещаниеПробы()) > 0,
		"с включённой пробой форма обещает подключение: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ЧестноеПредупреждение()),
		"и не говорит про выключенную пробу").Равно(0);

КонецПроцедуры

&Тест
Процедура СВыключеннойПробойФормаГоворитЧтоАдресНеПроверяется() Экспорт

	Настройки.Задать("oshub.upstream.probe.enabled", Ложь);
	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, ЧестноеПредупреждение()) > 0,
		"выключенная проба названа на самой форме: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ОбещаниеПробы()),
		"обещания, которого хаб не выполнит, на форме нет").Равно(0);

КонецПроцедуры

// ИСТ-АПСТ-006: правило секрета одно для источника пула и для зеркала — форма зеркала
// заведённый токен обратно не показывает.
&Тест
Процедура ФормаЗеркалНеПоказываетЗаведённыйТокен() Экспорт

	Зеркала.Задать(ЗеркалаСТокеном("sekret-42"));

	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, "sekret-42"),
		"значения токена в разметке нет вовсе: " + Разметка).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "по токену") > 0,
		"но видно, что апстрим читается по токену").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, АдресСнятияТокена()) > 0,
		"и строка предлагает снять токен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УАнонимногоЗеркалаНечегоСнимать() Экспорт

	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, "анонимно") > 0,
		"зеркало без токена названо анонимным: " + Разметка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, АдресСнятияТокена()),
		"адреса снятия токена в строке нет").Равно(0);

КонецПроцедуры

// Модуль proxy может не собраться вовсе — тогда СервисЗеркал.ПроверитьПодключение
// пропускает пробу так же молча, как выключатель.
&Тест
Процедура БезМодуляProxyФормаПробуНеОбещает() Экспорт

	Разметка = РазметкаФормы(Неопределено);

	Ожидаем.Что(СтрНайти(Разметка, ЧестноеПредупреждение()) > 0,
		"без пробника форма обещает ровно столько же, сколько хаб делает").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ОбещаниеПробы()), "обещания пробы нет").Равно(0);

КонецПроцедуры

// Режим переноса — решение момента заведения, и форма обязана его предлагать: без флажка
// перевезти пакеты с другого хаба нельзя вовсе.
&Тест
Процедура ФормаЗаведенияПредлагаетПеренестиПакеты() Экспорт

	Разметка = РазметкаФормы(ПробникПоНастройкам());
	Флажок = ТегФлажкаПереноса(Разметка);

	Ожидаем.Что(Флажок, "в форме заведения есть поле «перенос»: " + Разметка).Не_().Равно("");
	Ожидаем.Что(Флажок, "и это флажок, а не строка ввода").Содержит("type=""checkbox""");
	Ожидаем.Что(СтрНайти(Разметка, МеткаПереноса()) > 0,
		"флажок подписан словами про переезд").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ПодсказкаПереноса()) > 0,
		"рядом с подписью — одна короткая строка о том, зачем это").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ПримечаниеПереноса()) > 0,
		"а следствия переезда стоят примечанием под флажком").ЭтоИстина();
	Ожидаем.Что(ПереносОтмечен(Разметка),
		"по умолчанию флажок снят: обычное зеркало не переносит").ЭтоЛожь();

КонецПроцедуры

// Протокол чтения источника хаб определяет сам, поэтому выбирать его человеку не дают:
// поля «режим» в форме заведения нет, а строка списка называет протокол словами — это
// наблюдение, а не настройка.
&Тест
Процедура ФормаЗаведенияПротоколНеСпрашиваетАСписокЕгоПоказывает() Экспорт

	Разметка = РазметкаФормы(ПробникПоНастройкам());

	Ожидаем.Что(СтрНайти(Разметка, "name=""режим"""),
		"поля выбора протокола в форме нет: " + Разметка).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "<select"),
		"и выбора в форме заведения не осталось вовсе").Равно(0);

	Ожидаем.Что(СтрНайти(РазметкаСпискаЗеркал(),
			UI.Экран.Экранировать(UI.Тексты.Текст("settings.pool.mirrors.protocol.legacy"))) > 0,
		"а строка списка называет прочитанный протокол: " + РазметкаСпискаЗеркал()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(РазметкаСпискаЗеркал(),
			UI.Экран.Экранировать(UI.Тексты.Текст("settings.pool.mirrors.col.protocol"))) > 0,
		"и колонка названа протоколом").ЭтоИстина();

КонецПроцедуры

// Со страницы пустого пула человек приходит уже с решением перевезти: адрес раздела несёт
// migrate, и флажок на форме его дожидается отмеченным.
&Тест
Процедура ПараметрMigrateПредвыбираетФлажокПереноса() Экспорт

	Ожидаем.Что(ПереносОтмечен(РазметкаФормыСПредвыбором(Истина)),
		"флажок переноса предвыбран").ЭтоИстина();
	Ожидаем.Что(ПереносОтмечен(РазметкаФормыСПредвыбором(Ложь)),
		"КОНТРОЛЬ: без параметра он снят").ЭтоЛожь();

КонецПроцедуры

// Строка списка обязана говорить, ЧТО зеркало делает с пулом: переносящее зеркало названо
// переносящим, иначе два разных по следствиям зеркала выглядят одинаково. Судится ТОЛЬКО
// секция списка: в форме заведения то же слово стоит меткой флажка и именем поля.
&Тест
Процедура ПереносящееЗеркалоНазваноВСпискеПереносящим() Экспорт

	Зеркала.Задать(ЗеркалаПереноса());
	Ожидаем.Что(СтрНайти(РазметкаСпискаЗеркал(), СловоПереноса()) > 0,
		"зеркало переноса названо в списке: " + РазметкаСпискаЗеркал()).ЭтоИстина();

	Зеркала.Задать(ЗаведённыеЗеркала());
	Ожидаем.Что(СтрНайти(РазметкаСпискаЗеркал(), СловоПереноса()),
		"КОНТРОЛЬ: у обычного зеркала этого слова в строке нет").Равно(0);

КонецПроцедуры

#Область Помощники

// У пула уже есть зеркало: примечание судится на полном разделе, а не на пустом экране.
Функция ЗаведённыеЗеркала()

	Запись = Новый Структура();
	Запись.Вставить("Идентификатор", 1);
	Запись.Вставить("АпстримURL", "http://hub.example.test/download/");
	Запись.Вставить("ТокенДоступа", "");
	Запись.Вставить("Режим", "legacy");
	Запись.Вставить("Перенос", Ложь);
	Запись.Вставить("ИнтервалСинкаСек", 3600);
	Запись.Вставить("Включено", Истина);
	Запись.Вставить("ПоследнийСинк", Дата(2026, 3, 12, 10, 30, 0));
	Запись.Вставить("Статус", "создано");
	Запись.Вставить("СостояниеПрогона", "");
	Запись.Вставить("ПрогонНачат", '00010101000000');
	Запись.Вставить("ПрогонОбновлён", '00010101000000');
	Запись.Вставить("ПрогонВсего", 0);
	Запись.Вставить("ПрогонСкачано", 0);
	Запись.Вставить("ПрогонПропущено", 0);
	Запись.Вставить("ПрогонОшибок", 0);
	Запись.Вставить("ПрогонНедоступно", 0);
	Запись.Вставить("ПрогонИмёнВсего", 0);
	Запись.Вставить("ПрогонИмёнПройдено", 0);
	Запись.Вставить("ПрогонКурсор", "");
	Запись.Вставить("ПрогонЗапустил", "");
	Запись.Вставить("ВычитаноДо", '00010101000000');
	Запись.Вставить("ПрогонСрезС", '00010101000000');
	Запись.Вставить("ПрогонМоментСреза", '00010101000000');

	Результат = Новый Массив();
	Результат.Добавить(Запись);
	Возврат Результат;

КонецФункции

Функция ЗеркалаПереноса()

	Результат = ЗаведённыеЗеркала();
	Результат[0].Перенос = Истина;
	Возврат Результат;

КонецФункции

Функция ЗеркалаСТокеном(Знач Токен)

	Результат = ЗаведённыеЗеркала();
	Результат[0].ТокенДоступа = Токен;
	Возврат Результат;

КонецФункции

// Адрес операции снятия: подпись кнопки живёт ещё и в подсказке формы, а этот адрес —
// только в строке зеркала с заведённым токеном.
Функция АдресСнятияТокена()
	Возврат "/owned/settings/mirrors/1/token-off";
КонецФункции

// Разметка раздела «Зеркала» дома «Пул» целиком — как её увидит браузер.
Функция РазметкаФормы(Знач Пробник)
	Возврат РазметкаРаздела(Пробник, Неопределено);
КонецФункции

// То же, но с решением о переносе, пришедшим параметром адреса.
Функция РазметкаФормыСПредвыбором(Знач Предвыбран)
	Возврат РазметкаРаздела(ПробникПоНастройкам(), Предвыбран);
КонецФункции

Функция РазметкаРаздела(Знач Пробник, Знач Предвыбран)

	Витрина = Новый ВитринаЗеркал(UI.Кит, UI.РендерерНастроек, Зеркала, Прогоны, UI.Тексты,
		Новый БланкРаздела(UI.Кит), Желуди(Пробник), UI.Примечания, UI.ПоляЗеркала);

	Результат = "";
	Для Каждого Секция Из Витрина.Секции(ПараметрыРаздела(Предвыбран)) Цикл
		Результат = Результат + UI.РендерерНастроек.Отрисовать(МодельДома(Секция));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Неопределено в предвыборе означает «параметра migrate в адресе не было»: витрина обязана
// собираться и без него.
Функция ПараметрыРаздела(Знач Предвыбран)

	Параметры = Новый Структура("Пул, Адрес, Токен",
		Пул, "/owned/settings/mirrors", "токен-сессии-42");
	Если Предвыбран <> Неопределено Тогда
		Параметры.Вставить("Перенос", Предвыбран);
	КонецЕсли;
	Возврат Параметры;

КонецФункции

// Разметка ОДНОЙ секции — списка зеркал: слово «перенос» живёт и в форме заведения, и сторож
// строки обязан смотреть только туда, где строка.
Функция РазметкаСпискаЗеркал()

	Витрина = Новый ВитринаЗеркал(UI.Кит, UI.РендерерНастроек, Зеркала, Прогоны, UI.Тексты,
		Новый БланкРаздела(UI.Кит), Желуди(ПробникПоНастройкам()), UI.Примечания,
		UI.ПоляЗеркала);

	Для Каждого Секция Из Витрина.Секции(ПараметрыРаздела(Неопределено)) Цикл
		Если Секция.Заголовок = UI.Тексты.Текст("settings.pool.mirrors.title") Тогда
			Возврат UI.РендерерНастроек.Отрисовать(МодельДома(Секция));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ТегФлажкаПереноса(Знач Разметка)
	Возврат Новый ФлажокВРазметке().Тег(Разметка, "перенос");
КонецФункции

Функция ПереносОтмечен(Знач Разметка)
	Возврат Новый ФлажокВРазметке().Отмечен(Разметка, "перенос");
КонецФункции

// Настоящий пробник поверх заглушки настроек: выключатель читается тем же кодом,
// каким его читает заведение зеркала.
Функция ПробникПоНастройкам()
	Возврат Новый ПробникИсточника(Неопределено, Настройки);
КонецФункции

// Массив-пластилин ОСени: пусто означает «желудя в контейнере нет».
Функция Желуди(Знач Желудь)
	Результат = Новый Массив();
	Если Желудь <> Неопределено Тогда
		Результат.Добавить(Желудь);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Тексты берутся из словаря, а не переписываются в тест: сторож стережёт, КАКОЕ
// примечание печатается, а не его редакцию.
Функция ОбещаниеПробы()
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст("settings.pool.mirror-new.probe.note"));
КонецФункции

Функция ЧестноеПредупреждение()
