// Юнит-тесты почтового слоя: гейт «почта настроена», защита письма от подстановки чужих
// заголовков, отказ сервера как код причины, а не исключение, и пульт проверки отправки.
// Живого SMTP нет: транспорт подменён фейком.

#Использовать asserts
#Использовать logos
#Использовать "фикстуры"

Перем UI;        // СборкаUI — граф компонентов и рендереров web-ui
Перем Кабинет;   // РендерерКабинета (web-ui)
Перем Разбор;    // РазборФормы (web-ui)

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ХранилищеНастроекВПамяти");
	РеестрФикстур.Подключить("ИздательНастроекЗаглушка");
	РеестрФикстур.Подключить("ФейкОтправителяПисем");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы",
			"ИмяОбъектаАудита.os"), "ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы",
			"СобытиеАудита.os"), "СобытиеАудита");
	Исключение
	КонецПопытки;

	КаталогОбщего = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "общее");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(КаталогОбщего, "РендерерКабинета");
	Поиск.Подключить(КаталогОбщего, "РазборФормы");

	КаталогSettings = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	Поиск.Подключить(КаталогSettings, "ВидыПроверок");
	Поиск.Подключить(КаталогSettings, "НастройкиПодсистем");
	Поиск.Подключить(КаталогSettings, "РеестрНастроек");
	Поиск.Подключить(КаталогSettings, "СервисНастроек");
	Поиск.Подключить(КаталогSettings, "ВалидаторНастроек");
	Поиск.ПодключитьОснову(КаталогМодулей);

	// ловушка журнала стоит за дверью выхода — там, где строку получает коллектор
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		"ОбезличиваниеЖурнала");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		"ВыводЛогаВOTelХаба");

	КаталогПочты = ОбъединитьПути(КаталогМодулей, "почта", "Классы");
	Поиск.Подключить(КаталогПочты, "ПочтовыйАдрес");
	Поиск.Подключить(КаталогПочты, "НастройкиПочты");
	Поиск.Подключить(КаталогПочты, "СлужбаПочты");
	Поиск.Подключить(КаталогПочты, "ПисьмоЗаданием");

	КаталогВхода = ОбъединитьПути(КаталогМодулей, "вход", "Классы");
	Поиск.Подключить(КаталогВхода, "НормализаторУчётки");
	Поиск.Подключить(КаталогВхода, "ПисьмоПодтверждения");
	Поиск.Подключить(КаталогВхода, "ПолитикаПодтвержденияEmail");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "АдресИнстанса");

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "настройки");
	Поиск.Подключить(КаталогНастроек, "ИтогПульта");
	Поиск.Подключить(КаталогНастроек, "ВитринаПробыПочты");
	Поиск.Подключить(КаталогНастроек, "ПультПробыПочты");

	Кабинет = Новый РендерерКабинета(UI.Каркас);
	Разбор = Новый РазборФормы();

КонецПроцедуры

#Область ГейтНастройки

&Тест
Процедура БезНастроекПисьмоНеУходитИТранспортНеТрогают() Экспорт

	Стенд = Стенд();

	Итог = Стенд.Почта.Отправить("user@example.org", "Тема", "Тело");

	Ожидаем.Что(Итог.Успех, "почта не настроена — письма нет").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "код отказа").Равно(Стенд.Почта.ПричинаНеНастроена());
	Ожидаем.Что(Стенд.Транспорт.Количество(), "транспорт не позван").Равно(0);

КонецПроцедуры

&Тест
Процедура ВключённойПочтеБезСервераИлиОтправителяХодуНет() Экспорт

	Стенд = Стенд();
	Стенд.Настройки.Установить("oshub.mail.enabled", Истина, "тест");
	Ожидаем.Что(Стенд.Почта.Настроена(), "включения мало").ЭтоЛожь();

	Стенд.Настройки.Установить("oshub.mail.smtp.host", "smtp.example.com", "тест");
	Ожидаем.Что(Стенд.Почта.Настроена(), "без адреса отправителя письмо не подписать")
		.ЭтоЛожь();

	Стенд.Настройки.Установить("oshub.mail.from", "hub@example.com", "тест");
	Ожидаем.Что(Стенд.Почта.Настроена(), "сервер и отправитель названы — почта готова")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НастроеннаяПочтаОтдаётПисьмоТранспортуСОтправителемИзНастроек() Экспорт

	Стенд = НастроенныйСтенд();

	Итог = Стенд.Почта.Отправить("user@example.org", "Тема", "Тело");

	Ожидаем.Что(Итог.Успех, "письмо ушло: " + Итог.Причина).ЭтоИстина();
	Письмо = Стенд.Транспорт.Последнее();
	Ожидаем.Что(Письмо.Кому, "получатель").Равно("user@example.org");
	Ожидаем.Что(Письмо.ОтКого, "отправитель — из настроек хаба").Равно("hub@example.com");
	Ожидаем.Что(Письмо.Текст, "тело").Равно("Тело");

КонецПроцедуры

&Тест
Процедура ОтказСервераСтановитсяКодомПричиныАНеИсключением() Экспорт

	Стенд = НастроенныйСтенд();
	Стенд.Транспорт.ПадатьНаОтправке(Истина);

	Итог = Стенд.Почта.Отправить("user@example.org", "Тема", "Тело");

	Ожидаем.Что(Итог.Успех, "сервер письмо не принял").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "код отказа").Равно(Стенд.Почта.ПричинаОтказ());

КонецПроцедуры

#КонецОбласти

#Область ЗаголовкиПисьма

// Перевод строки в адресе получателя — это дописанные заголовки письма (Bcc, From).
// Адрес приходит из учётной записи, но доверять ему нельзя: в базу он мог попасть
// когда угодно и чем угодно.
&Тест
Процедура АдресСПереводомСтрокиОтвергаетсяДоТранспорта() Экспорт

	Стенд = НастроенныйСтенд();

	// одна собака на весь адрес: иначе отказ дал бы счётчик @, а не проверка разрывов,
	// и снятая защита от подстановки заголовков осталась бы незамеченной
	Отравленный = "user@example.org" + Символы.ВК + Символы.ПС + "X-Evil: yes";
	Итог = Стенд.Почта.Отправить(Отравленный, "Тема", "Тело");

	Ожидаем.Что(Итог.Успех, "такой адрес письма не получает").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "код отказа").Равно(Стенд.Почта.ПричинаАдрес());
	Ожидаем.Что(Стенд.Транспорт.Количество(), "транспорт не позван").Равно(0);

КонецПроцедуры

&Тест
Процедура АдресСПробеломИБезСобакиТожеОтвергается() Экспорт

	Стенд = НастроенныйСтенд();

	Ожидаем.Что(Стенд.Почта.Отправить("user @example.org", "Т", "Т").Причина,
		"пробел внутри адреса").Равно(Стенд.Почта.ПричинаАдрес());
	Ожидаем.Что(Стенд.Почта.Отправить("useexample.org", "Т", "Т").Причина,
		"адрес без @").Равно(Стенд.Почта.ПричинаАдрес());
	Ожидаем.Что(Стенд.Почта.Отправить("", "Т", "Т").Причина,
		"пустой адрес").Равно(Стенд.Почта.ПричинаАдрес());
	Ожидаем.Что(Стенд.Транспорт.Количество(), "ни одно из них не доехало до транспорта")
		.Равно(0);

КонецПроцедуры

// Тема — заголовок письма, и разрыв строки в ней расщепляет заголовок так же, как в адресе.
&Тест
Процедура ТемаСРазрывомСтрокиСхлопываетсяВОднуСтроку() Экспорт

	Стенд = НастроенныйСтенд();

	Стенд.Почта.Отправить("user@example.org",
		"Тема" + Символы.ВК + Символы.ПС + "Bcc: victim@example.net", "Тело");

	Тема = Стенд.Транспорт.Последнее().Тема;
	Ожидаем.Что(СтрНайти(Тема, Символы.ПС), "переводов строки в теме не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(Тема, Символы.ВК), "и возвратов каретки тоже").Равно(0);
	Ожидаем.Что(Тема, "текст при этом сохранён").Равно("Тема  Bcc: victim@example.net");

КонецПроцедуры

// Отправителя правят через форму настроек, и разрыв строки в нём — те же дописанные
// заголовки, что и в адресе получателя. Проверялся он раньше нигде.
&Тест
Процедура ОтправительСРазрывомСтрокиДоТранспортаНеДоезжает() Экспорт

	Стенд = НастроенныйСтенд();
	Стенд.Настройки.Установить("oshub.mail.from",
		"hub@example.com" + Символы.ПС + "Bcc: victim@evil.org", "тест");

	Ожидаем.Что(Стенд.Почта.Настроена(),
		"негодный отправитель означает «почта не настроена»").ЭтоЛожь();
	Ожидаем.Что(Стенд.Почта.Отправить("user@example.org", "Тема", "Тело").Успех,
		"и письма не будет").ЭтоЛожь();
	Ожидаем.Что(Стенд.Транспорт.Количество(), "транспорт не позван").Равно(0);

КонецПроцедуры

// Мусор вместо адреса отправителя — это ошибка настройки, а не сбой отправки: оператор
// должен видеть «почта не настроена», а не гадать по коду отказа сервера.
&Тест
Процедура НеАдресВОтправителеЗначитПочтаНеНастроена() Экспорт

	Стенд = НастроенныйСтенд();
	Стенд.Настройки.Установить("oshub.mail.from", "не-адрес-вовсе", "тест");

	Ожидаем.Что(Стенд.Почта.Настроена(), "почта не готова").ЭтоЛожь();
	Ожидаем.Что(Стенд.Почта.Отправить("user@example.org", "Т", "Т").Причина,
		"и код отказа говорит про настройку").Равно(Стенд.Почта.ПричинаНеНастроена());

КонецПроцедуры

// Строки заголовка разделяет не только «код меньше 32»: NEL и разделители Юникода
// делают то же самое, а неразрывный пробел и DEL в адресе не имеют права стоять.
&Тест
Процедура ЮникодныеРазрывыВАдресеТожеОтвергаются() Экспорт

	Стенд = НастроенныйСтенд();

	Коды = Новый Массив();
	Коды.Добавить(133);   // NEL
	Коды.Добавить(160);   // неразрывный пробел
	Коды.Добавить(8232);  // разделитель строк
	Коды.Добавить(8233);  // разделитель абзацев
	Коды.Добавить(127);   // DEL

	Прошедшие = Новый Массив();
	Для Каждого Код Из Коды Цикл
		Отравленный = "user" + Символ(Код) + "x@example.org";
		Если Стенд.Почта.Отправить(Отравленный, "Тема", "Тело").Успех Тогда
			Прошедшие.Добавить(Формат(Код, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Прошедшие, ", "),
		"коды символов, проехавшие в адрес письма").Равно("");
	Ожидаем.Что(Стенд.Транспорт.Количество(), "ни одно письмо не ушло").Равно(0);

КонецПроцедуры

// Второй рубеж той же защиты: адрес с переводом строки не попадает даже в учётку.
&Тест
Процедура НормализаторНеПропускаетАдресСПереводомСтроки() Экспорт

	Нормализатор = Новый НормализаторУчётки();

	Ожидаем.Что(Нормализатор.НормализоватьEmail(" User@Example.ORG "),
		"обычный адрес нормализуется").Равно("user@example.org");

	Ожидаем.Что(ОтвергнутАдрес(Нормализатор, "user@example.org" + Символы.ПС + "Bcc: x@y.z"),
		"перевод строки").ЭтоИстина();
	Ожидаем.Что(ОтвергнутАдрес(Нормализатор, "user@exam ple.org"), "пробел внутри")
		.ЭтоИстина();
	Ожидаем.Что(ОтвергнутАдрес(Нормализатор, "us" + Символы.Таб + "er@example.org"),
		"табуляция внутри").ЭтоИстина();
	Ожидаем.Что(Нормализатор.НормализоватьEmail("user@example.org" + Символы.Таб),
		"краевая табуляция — просто мусор по краям, его срезают").Равно("user@example.org");
	Ожидаем.Что(ОтвергнутАдрес(Нормализатор, "us" + Символ(8232) + "er@example.org"),
		"разделитель строк Юникода").ЭтоИстина();
	Ожидаем.Что(ОтвергнутАдрес(Нормализатор, "us" + Символ(133) + "er@example.org"),
		"NEL").ЭтоИстина();
	Ожидаем.Что(ОтвергнутАдрес(Нормализатор, "us" + Символ(160) + "er@example.org"),
		"неразрывный пробел").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ТекстПисьма

&Тест
Процедура ПисьмоПодтвержденияБерётТекстИзСловаряИНесётСсылку() Экспорт

	Стенд = НастроенныйСтенд();

	Тема = Стенд.Письмо.Тема();
	Текст = Стенд.Письмо.Текст("alice", "https://hub.example.com/confirm-email?token=oshub_cnf_1_ab");

	Ожидаем.Что(СтрНайти(Тема, "[?"), "тема — из словаря, а не маркер отсутствующего ключа")
		.Равно(0);
	Ожидаем.Что(СтрНайти(Текст, "[?"), "и текст тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Текст, "alice") > 0, "письмо называет учётную запись").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "oshub_cnf_1_ab") > 0, "и несёт саму ссылку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "https://hub.example.com") > 0,
		"хаб называет себя внешним адресом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "<") , "разметки в письме нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПультПроверки

&Тест
Процедура ЧужойРазделИЧужаяОперацияПультуНеИнтересны() Экспорт

	Стенд = НастроенныйСтенд();

	Ожидаем.Что(Стенд.Пульт.Применить("auth", ФормаПробы(), Админ("root@example.org")).Перехвачено,
		"чужой раздел").ЭтоЛожь();
	Ожидаем.Что(Стенд.Пульт.Применить("mail", Новый Соответствие(),
		Админ("root@example.org")).Перехвачено, "раздел наш, а операция чужая").ЭтоЛожь();
	Ожидаем.Что(Стенд.Транспорт.Количество(), "писем не было").Равно(0);

КонецПроцедуры

&Тест
Процедура ПробаПриНенастроеннойПочтеОтказываетИНеЗовётТранспорт() Экспорт

	Стенд = Стенд();

	Итог = Стенд.Пульт.Применить("mail", ФормаПробы(), Админ("root@example.org"));

	Ожидаем.Что(Итог.Перехвачено, "пульт распорядился сам").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка), "и отказал").ЭтоИстина();
	Ожидаем.Что(Стенд.Транспорт.Количество(), "транспорт не позван").Равно(0);

КонецПроцедуры

&Тест
Процедура ПробаБезАдресаУАдминистратораОтказывает() Экспорт

	Стенд = НастроенныйСтенд();

	Итог = Стенд.Пульт.Применить("mail", ФормаПробы(), Админ(""));

	Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка), "слать некуда").ЭтоИстина();
	Ожидаем.Что(Стенд.Транспорт.Количество(), "письма нет").Равно(0);

КонецПроцедуры

// Получателя проверочного письма форма не называет: иначе кнопка в настройках хаба
// становится формой рассылки с чужого обратного адреса.
&Тест
Процедура ПробаШлётПисьмоТолькоНаАдресНажавшего() Экспорт

	Стенд = НастроенныйСтенд();

	Форма = ФормаПробы();
	Форма.Вставить("кому", "victim@example.net");
	Форма.Вставить("адрес", "victim@example.net");

	Итог = Стенд.Пульт.Применить("mail", Форма, Админ("root@example.org"));

	Ожидаем.Что(Итог.Ошибка, "проверка удалась").Равно("");
	Ожидаем.Что(ЗначениеЗаполнено(Итог.Уведомление), "и сказала об этом").ЭтоИстина();
	Ожидаем.Что(Стенд.Транспорт.Количество(), "письмо ровно одно").Равно(1);
	Ожидаем.Что(Стенд.Транспорт.Последнее().Кому, "и ушло оно администратору, а не в форму")
		.Равно("root@example.org");

КонецПроцедуры

&Тест
Процедура ПробаПриОтказеСервераГоворитОбЭтомАНеПадает() Экспорт

	Стенд = НастроенныйСтенд();
	Стенд.Транспорт.ПадатьНаОтправке(Истина);

	Итог = Стенд.Пульт.Применить("mail", ФормаПробы(), Админ("root@example.org"));

	Ожидаем.Что(Итог.Перехвачено, "пульт распорядился сам").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка), "и назвал неудачу").ЭтоИстина();
	Ожидаем.Что(Итог.Уведомление, "успеха при этом не объявил").Равно("");

КонецПроцедуры

// Кнопка не предлагается там, где нажать её бессмысленно.
&Тест
Процедура СекцияПробыБезАдресаАдминистратораЗаблокирована() Экспорт

	Стенд = НастроенныйСтенд();

	Без = Стенд.Витрина.Секция("/hub/settings/mail", "тк", "");
	Ожидаем.Что(Без.Заблокирована, "адреса нет — кнопка заблокирована").ЭтоИстина();

	С_ = Стенд.Витрина.Секция("/hub/settings/mail", "тк", "root@example.org");
	Ожидаем.Что(С_.Заблокирована, "адрес есть — кнопка живая").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(С_.Тело, "root@example.org") > 0,
		"секция честно называет получателя").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЖурналПочты

// По журналу оператор обязан понять, кому ушло письмо и на какой сервер, и не должен
// узнать из него ни ящика получателя, ни темы, ни тела.
&Тест
Процедура ПринятоеПисьмоНазываетПолучателяИСервер() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	// ИНФОРМАЦИЯ, а не отладка: строка обязана дойти до оператора на уровне по умолчанию
	Стенд = НастроенныйСтенд(Ловушка, УровниЛога.Информация);

	Ожидаем.Что(Стенд.Почта.Отправить("sergey@example.org", "Тема письма", "Тело письма").Успех,
		"письмо ушло").ЭтоИстина();

	Написанное = Ловушка.Всё();
	Ожидаем.Что(СтрНайти(Написанное, "s***@example.org") > 0,
		"получатель назван почтовой системой, а не ящиком: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "smtp.example.com:587") > 0,
		"сервер назван вместе с портом: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "sergey@example.org"),
		"сырого адреса получателя в журнале нет").Равно(0);
	Ожидаем.Что(СтрНайти(Написанное, "Тема письма"), "темы письма тоже нет").Равно(0);
	Ожидаем.Что(СтрНайти(Написанное, "Тело письма"), "и тела").Равно(0);

КонецПроцедуры

// Отказ сервера оператор обязан прочитать целиком: чем сервер ответил, кому не доехало
// письмо и на какой адрес хаб ходил.
&Тест
Процедура ОтказТранспортаНазываетПричинуПолучателяИСервер() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НастроенныйСтенд(Ловушка);
	Стенд.Транспорт.ПадатьНаОтправке(Истина);

	Ожидаем.Что(Стенд.Почта.Отправить("sergey@example.org", "Тема письма", "Тело письма").Успех,
		"сервер письмо не принял").ЭтоЛожь();

	Написанное = Ловушка.Всё();
	Ожидаем.Что(СтрНайти(Написанное, "Почтовый сервер недоступен") > 0,
		"причина названа словами отказа: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "smtp.example.com:587") > 0,
		"назван сервер, который отказал: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "s***@example.org") > 0,
		"и получатель, до которого письмо не доехало: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "sergey@example.org"),
		"сырого адреса нет и в отказе").Равно(0);

КонецПроцедуры

// Негодный адрес получателя — признак битых данных, и говорится он предупреждением:
// на спокойном уровне журнала строка обязана быть, причём ровно одна. Самого значения
// в ней нет вовсе — только факт наличия и длина: собаку и всё, что после неё, выбирает
// тот, кто подставил строку, и журнал назвал бы ЕГО домен как домен получателя.
&Тест
Процедура НегодныйАдресПолучателяГоворитсяПредупреждениемБезДомена() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НастроенныйСтенд(Ловушка, УровниЛога.Предупреждение);

	Отравленный = "victim@example.org" + Символы.ВК + Символы.ПС + "Bcc: attacker@evil.com";
	Ожидаем.Что(Стенд.Почта.Отправить(Отравленный, "Тема", "Тело").Причина,
		"письма нет").Равно(Стенд.Почта.ПричинаАдрес());

	Написанное = Ловушка.Всё();
	Ожидаем.Что(Ловушка.Количество(),
		"на спокойном уровне сказано ровно раз: " + Написанное).Равно(1);
	Ожидаем.Что(СтрНайти(Написанное, Стенд.Почта.ПричинаАдрес()) > 0,
		"причина названа кодом: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Сообщение(0), Символы.ПС),
		"переводов строки в записи нет: печать самого значения вернула бы их").Равно(0);
	Ожидаем.Что(СтрНайти(Написанное, "victim@example.org"),
		"сырого адреса нет и в предупреждении").Равно(0);
	Ожидаем.Что(СтрНайти(Написанное, "evil.com"),
		"и домена, выбранного подставившим строку, в журнале нет: " + Написанное).Равно(0);
	Ожидаем.Что(СтрНайти(Написанное, "attacker"),
		"как нет и его ящика").Равно(0);

КонецПроцедуры

// Хаб без настроенной почты — законное состояние, и каждое уведомление проходит этой
// дорогой: на спокойном уровне журнал о ней молчит.
&Тест
Процедура НенастроеннаяПочтаНаСпокойномУровнеМолчит() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	// ИНФОРМАЦИЯ, а не предупреждение: поднятая до INFO строка тоже засоряет журнал
	Стенд = Стенд(Ловушка, УровниЛога.Информация);

	Ожидаем.Что(Стенд.Почта.Отправить("sergey@example.org", "Тема", "Тело").Причина,
		"почта не настроена").Равно(Стенд.Почта.ПричинаНеНастроена());

	Ожидаем.Что(Ловушка.Всё(), "и журнал этим не засоряется").Равно("");

КонецПроцедуры

// Живой хаб шлёт письма фоном, и всё, что оператор о них знает, пишет это задание:
// сервер, получателя и то, сколько ждали ответа. Ноль миллисекунд — законное значение,
// и в строке он обязан стоять цифрой, а не пустым местом.
&Тест
Процедура ФоновоеПисьмоНазываетСерверПолучателяИДлительность() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Транспорт = Новый ФейкОтправителяПисем();

	ЗаданиеПисьма(Транспорт, Ловушка).Исполнить();

	Написанное = Ловушка.Всё();
	Ожидаем.Что(Транспорт.Количество(), "письмо отдано транспорту").Равно(1);
	Ожидаем.Что(СтрНайти(Написанное, "s***@example.org") > 0,
		"получатель назван без ящика: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "sergey@"), "ящика в строке задания нет").Равно(0);
	Ожидаем.Что(СтрНайти(Написанное, "smtp.example.com:587") > 0,
		"и назван сервер: " + Написанное).ЭтоИстина();
	Ожидаем.Что(ДлительностьНазвана(Написанное),
		"длительность названа цифрами: " + Написанное).ЭтоИстина();

КонецПроцедуры

// Отказ фонового письма — единственная весть оператору о том, что письма не будет:
// причина, получатель, сервер и длительность попытки.
&Тест
Процедура ОтказФоновогоПисьмаНазываетПричинуИСервер() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Транспорт = Новый ФейкОтправителяПисем();
	Транспорт.ПадатьНаОтправке(Истина);

	ЗаданиеПисьма(Транспорт, Ловушка).Исполнить();

	Написанное = Ловушка.Всё();
	Ожидаем.Что(СтрНайти(Написанное, "Почтовый сервер недоступен") > 0,
		"причина названа словами отказа: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "smtp.example.com:587") > 0,
		"назван сервер: " + Написанное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "s***@example.org") > 0,
		"и получатель: " + Написанное).ЭтоИстина();
	Ожидаем.Что(ДлительностьНазвана(Написанное),
		"длительность попытки названа цифрами: " + Написанное).ЭтоИстина();

КонецПроцедуры

// Живой хаб шлёт письма фоном, и на этой дороге говорят двое: служба — что отдала письмо
// заданию, задание — чем кончилось. Обе строки нужны оператору на уровне по умолчанию,
// и обе выходят из журнала с получателем без ящика.
&Тест
Процедура СлужбаОтдаётЗаданиюОбезличенногоПолучателя() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Фон = Новый ЗапускВФонеСинхронный();
	Стенд = НастроенныйСтенд(Ловушка, УровниЛога.Информация, Фон);

	Ожидаем.Что(Стенд.Почта.ОтправитьВФоне("sergey@example.org", "Тема", "Тело").Успех,
		"письмо принято к отправке").ЭтоИстина();

	Написанное = Ловушка.Всё();
	СтрокаСлужбы = ЗаписьЖурнала(Ловушка, "отдано фоновому заданию");
	СтрокаЗадания = ЗаписьЖурнала(Ловушка, "Фоновое письмо");

	Ожидаем.Что(Фон.Запусков(), "письмо ушло фоновым заданием").Равно(1);
	Ожидаем.Что(Стенд.Транспорт.Количество(), "и доехало до транспорта").Равно(1);

	Ожидаем.Что(ЗначениеЗаполнено(СтрокаСлужбы),
		"служба сказала, что отдала письмо фону: " + Написанное).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(СтрокаЗадания),
		"задание сказало, чем это кончилось: " + Написанное).ЭтоИстина();
	Ожидаем.Что(Ловушка.Количество(),
		"и обе строки сказаны по разу: " + Написанное).Равно(2);

	Ожидаем.Что(СтрНайти(СтрокаСлужбы, "s***@example.org") > 0,
		"получатель без ящика в строке службы: " + СтрокаСлужбы).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаЗадания, "s***@example.org") > 0,
		"и в строке задания: " + СтрокаЗадания).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Написанное, "sergey@example.org"),
		"сырого адреса нет ни в строке службы, ни в строке задания").Равно(0);

	Ожидаем.Что(СтрНайти(СтрокаСлужбы, "smtp.example.com:587") > 0,
		"сервер назван строкой службы: " + СтрокаСлужбы).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаЗадания, "smtp.example.com:587") > 0,
		"и строкой задания: " + СтрокаЗадания).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Стенд(Знач Ловушка = Неопределено, Знач Уровень = Неопределено,
	Знач Фон = Неопределено)

	Реестр = Новый РеестрНастроек(Новый ВидыПроверок(),
		Новый НастройкиПодсистем(Новый ВидыПроверок()));
	ИменаЖурнала = Новый ИмяОбъектаАудита();
	Настройки = Новый СервисНастроек(Реестр, Новый ХранилищеНастроекВПамяти(),
		Новый ИздательНастроекЗаглушка(), ИменаЖурнала, Новый СобытиеАудита(ИменаЖурнала, Новый ТекстJSON()),
		Новый ВалидаторНастроек(Новый КанонIP()));

	Адреса = Новый ПочтовыйАдрес();
	Параметры = Новый НастройкиПочты(Настройки, Адреса);
	Транспорт = Новый ФейкОтправителяПисем();
	// по умолчанию без ЗапускВФоне: набор смотрит исход отправки, а боевой фон сделал бы
	// его гонкой; тесты фоновой дороги передают синхронный фейк
	Почта = Новый СлужбаПочты(Параметры, Транспорт, Адреса, Фон, ЛогПочты(Ловушка, Уровень));

	Адрес = Новый АдресИнстанса(Настройки);
	Письмо = Новый ПисьмоПодтверждения(UI.Тексты, Новый ПолитикаПодтвержденияEmail(Настройки),
		Адрес);

	Витрина = Новый ВитринаПробыПочты(UI.Кит, UI.РендерерНастроек, UI.Тексты);
	Пульт = Новый ПультПробыПочты(Разбор, Почта, Витрина, Новый ИтогПульта(), Адрес, UI.Тексты);

	Возврат Новый Структура("Настройки, Почта, Транспорт, Письмо, Витрина, Пульт, Адреса",
		Настройки, Почта, Транспорт, Письмо, Витрина, Пульт, Адреса);

КонецФункции

// Лог почтовой службы: свой на каждый стенд, иначе ловушка соседнего теста ловила бы
// чужие строки. Ловушка стоит на месте коллектора — за дверью выхода журнала, и видит
// строку такой, какой её видит оператор.
Функция ЛогПочты(Знач Ловушка, Знач Уровень)

	Лог = Логирование.ПолучитьЛог("тест.oshub.почта."
		+ Строка(Новый УникальныйИдентификатор()));

	Если Ловушка <> Неопределено Тогда
		Лог.УстановитьУровень(?(Уровень = Неопределено, УровниЛога.Отладка, Уровень));
		Лог.ДобавитьСпособВывода(Новый ВыводЛогаВOTelХаба(Ловушка));
	КонецЕсли;

	Возврат Лог;

КонецФункции

Функция НастроенныйСтенд(Знач Ловушка = Неопределено, Знач Уровень = Неопределено,
	Знач Фон = Неопределено)

	Стенд = Стенд(Ловушка, Уровень, Фон);
	Стенд.Настройки.Установить("oshub.instance.url", "https://hub.example.com", "тест");
	Стенд.Настройки.Установить("oshub.mail.enabled", Истина, "тест");
	Стенд.Настройки.Установить("oshub.mail.smtp.host", "smtp.example.com", "тест");
	Стенд.Настройки.Установить("oshub.mail.from", "hub@example.com", "тест");
	Возврат Стенд;

КонецФункции

// Фоновое задание письма ровно в той сборке, в какой его создаёт служба почты: приметы
// письма — именованными полями, лог — на уровне по умолчанию.
Функция ЗаданиеПисьма(Знач Транспорт, Знач Ловушка)

	Письмо = Новый Структура("Кому, Тема, Текст, ОтКого",
		"sergey@example.org", "Тема", "Тело", "hub@example.com");
	Приметы = Новый Структура("Получатель, Сервер",
		"sergey@example.org", "smtp.example.com:587");

	Возврат Новый ПисьмоЗаданием(Транспорт, Письмо,
		ЛогПочты(Ловушка, УровниЛога.Информация), Приметы);

КонецФункции

// Первая запись журнала, в которой назван искомый кусок; пустая строка — такой записи нет.
Функция ЗаписьЖурнала(Знач Ловушка, Знач Искомое)

	Для Индекс = 0 По Ловушка.Количество() - 1 Цикл
		Если СтрНайти(Ловушка.Сообщение(Индекс), Искомое) > 0 Тогда
			Возврат Ловушка.Сообщение(Индекс);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Названа ли в строке журнала длительность: перед « мс» обязаны стоять цифры. Пустое
// место там — потерянное значение, а не ноль миллисекунд.
Функция ДлительностьНазвана(Знач Написанное)

	Позиция = СтрНайти(Написанное, " мс");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Цифры = "";
	Номер = Позиция - 1;
	Пока Номер >= 1 Цикл
		Символ = Сред(Написанное, Номер, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Символ + Цифры;
		Номер = Номер - 1;
	КонецЦикла;

	Возврат ЗначениеЗаполнено(Цифры);

КонецФункции

Функция ФормаПробы()
	Форма = Новый Соответствие();
	Форма.Вставить("операция", "проба-почты");
	Возврат Форма;
КонецФункции

// Учётка администратора в форме, которую читает пульт: только адрес и логин.
Функция Админ(Знач Адрес)
	Возврат Новый Структура("Логин, Email", "root", Адрес);
КонецФункции

Функция ОтвергнутАдрес(Знач Нормализатор, Знач Значение)
	Попытка
		Нормализатор.НормализоватьEmail(Значение);
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

#КонецОбласти
