КонецПроцедуры

#КонецОбласти

#Область СогласованностьСОсенью

&Тест
Процедура ЗагрузкаИПоделкаВидятОдноИТоже() Экспорт

	// Загрузка читает configor сама. Разъедется её состав источников с составом ОСени —
	// загрузка будет решать о ключах, которых Поделка не увидит, и наоборот.
	Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "загрузка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	ИмяФайла = "загрузка-проба";
	ЗаписатьФайл(ОбъединитьПути(Каталог, ИмяФайла + ".json"),
		"{""oshub"": {""probe"": {""file"": ""из-файла"", ""both"": ""из-файла""},"
		+ " ""storage"": {""root"": ""/из-файла""}},"
		+ " ""data"": {""ИсточникиДанных"": {""ТипКоннектора"": ""КоннекторPostgreSQL""}}}");

	Имена = Новый ИменаПеременныхОкружения();
	ПеременнаяФайлаПароля = Имена.Переменная("oshub.admin.password_file");
	СтрокаСоединения = "Host=127.0.0.1;Port=1;Username=u;Password=проба;Database=d";
	УстановитьПеременнуюСреды("OSHUB_PROBE_BOTH", "из-окружения");
	УстановитьПеременнуюСреды("OSHUB_PROBE_ENVONLY", "только-окружение");
	УстановитьПеременнуюСреды(ПеременнаяФайлаПароля, "/run/secrets/admin");
	УстановитьПеременнуюСреды("OSHUB_DB_CONNECTION", СтрокаСоединения);

	Попытка
		Основа = Новый СоветДругогоМастера();
		Основа.ИмяФайлаСоЗначениямиДеталек(ИмяФайла);
		Основа.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек(Каталог);
		Явные = Новый Соответствие();
		КореньЯвно = ОбъединитьПути(Каталог, "явно");
		Явные.Вставить("oshub.storage.root", КореньЯвно);
		Основа.ЗначенияДеталек(Явные);

		Загрузка = Новый ЗагрузкаНастроек();
		Поделка = Новый Поделка(Загрузка.Совет(Основа));

		Для Каждого Ключ Из СтрРазделить("oshub.probe.file,oshub.probe.both,oshub.probe.envonly,"
			+ "oshub.admin.password_file,oshub.storage.root,"
			+ "data.ИсточникиДанных.ТипКоннектора,data.ИсточникиДанных.СтрокаСоединения", ",") Цикл
			Ожидаем.Что(Поделка.НайтиДетальку(Ключ), "Поделка и загрузка расходятся: " + Ключ)
				.Равно(Загрузка.Значение(Ключ));
		КонецЦикла;

		УзелБазы = Поделка.НайтиДетальку("data.ИсточникиДанных");
		Ожидаем.Что(УзелБазы["ТипКоннектора"], "коннектор файла дошёл до Поделки").Равно("КоннекторPostgreSQL");
		Ожидаем.Что(УзелБазы["СтрокаСоединения"], "строка из окружения легла в тот же узел")
			.Равно(СтрокаСоединения);

		Ожидаем.Что(Поделка.НайтиДетальку("oshub.probe.file"), "файл найден").Равно("из-файла");
		Ожидаем.Что(Поделка.НайтиДетальку("oshub.probe.both"), "окружение сильнее файла")
			.Равно("из-окружения");
		Ожидаем.Что(Поделка.НайтиДетальку("oshub.admin.password_file"),
			"имя переменной, названное хабом, доезжает до ключа").Равно("/run/secrets/admin");
		Ожидаем.Что(Поделка.НайтиДетальку("oshub.storage.root"),
			"программная деталька основы сильнее вычисленных").Равно(КореньЯвно);
		Ожидаем.Что(Загрузка.КореньДанных(), "корень считается после деталек основы")
			.Равно(Новый Файл(КореньЯвно).ПолноеИмя);
	Исключение
		ОчиститьПробу(ПеременнаяФайлаПароля, Каталог);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьПробу(ПеременнаяФайлаПароля, Каталог);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

// Загрузка после правил над деревом файла и переменными окружения (имя → значение).
Функция Загружено(Знач Файл, Знач Переменные, Знач Сервер = Ложь)

	Если Сервер Тогда
		Типы = Новый Соответствие();
		Типы.Вставить("console", "ВыводЛогаВКонсольХаба");
		Типы.Вставить("otel", "ВыводЛогаВOTelХаба");
		Загрузка = Новый ЗагрузкаНастроек(КаталогМодулей(), Типы);
	Иначе
		Загрузка = Новый ЗагрузкаНастроек();
	КонецЕсли;

	Загрузка.ДеталькиПоверх(Файл, КартаПровайдера(Переменные));
	Возврат Загрузка;

КонецФункции

// Так переменные отдаёт провайдер окружения configor: «_» — точка, «__» — подчёркивание.
Функция КартаПровайдера(Знач Переменные)

	Карта = Новый Соответствие();
	Для Каждого Переменная Из Переменные Цикл
		Карта.Вставить(СтрЗаменить(СтрЗаменить(Переменная.Ключ, "_", "."), "..", "_"),
			Переменная.Значение);
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Что подать в переменную псевдонима и где увидеть результат — по описанию из списка.
Функция ПробаПсевдонима(Знач Псевдоним)

	Проба = Новый Структура("Значение, Где, Ожидается", "проба", Псевдоним.Цель, "проба");
	Если Псевдоним.Число Тогда
		Проба.Значение = "12";
		Проба.Ожидается = "12";
	ИначеЕсли Псевдоним.Пара Тогда
		// с этим значением узел базы проходит проверку при любом листе пары
		Проба.Значение = "КоннекторInMemory";
		Проба.Ожидается = "КоннекторInMemory";
	ИначеЕсли Псевдоним.ЦельУзел И СтрНайти(Псевдоним.Цель, "<журнал>") > 0 Тогда
		Проба.Значение = "Проба=WARN";
		Проба.Ожидается = "WARN";
		Проба.Где = СтрЗаменить(Псевдоним.Цель, "<журнал>", "Проба") + ".level";
	ИначеЕсли Псевдоним.ЦельУзел Тогда
		Проба.Значение = "DEBUG";
		Проба.Ожидается = "DEBUG";
		Проба.Где = Псевдоним.Цель + ".rootLogger.level";
	КонецЕсли;
	Проба.Где = СтрЗаменить(Проба.Где, "<кэш>", Новый ЗагрузкаНастроек().КэшиЧтенийИзБазы()[0]);
	Возврат Проба;

КонецФункции

// Файл без узла базы и файл с узлом без строки соединения: коннектор окружения сильнее
// коннектора файла, а строки нет ни там, ни там.
Функция ФайлыДляБазы()

	Файлы = Новый Массив();
	Файлы.Добавить(Новый Соответствие());
	Файлы.Добавить(ВФайле(Новый Соответствие(), "data.ИсточникиДанных.ТипКоннектора", "КоннекторJSON"));
	Возврат Файлы;

КонецФункции

// Пара псевдонимов базы, которую зашивает образ.
Функция ОкружениеОбраза()

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторSQLite");
	Окружение.Вставить("OSHUB_DB_CONNECTION", "Data Source=/образ/openhub.db");
	Возврат Окружение;

КонецФункции

// Текст отказа загрузки; пусто — загрузка прошла.
Функция ОтказЗагрузки(Знач Файл, Знач Окружение)

	Попытка
		Загружено(Файл, Окружение);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ВременныйКаталог(Знач Префикс)
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), Префикс + "-" + Строка(Новый УникальныйИдентификатор));
КонецФункции

// Кладёт значение в дерево файла по ключу через точку — так, как его написали бы в JSON.
Функция ВФайле(Файл, Знач Ключ, Знач Значение)

	Сегменты = СтрРазделить(Ключ, ".");
	Узел = Файл;
	Для Номер = 0 По Сегменты.ВГраница() - 1 Цикл
		Если ТипЗнч(Узел.Получить(Сегменты[Номер])) <> Тип("Соответствие") Тогда
			Узел.Вставить(Сегменты[Номер], Новый Соответствие());
		КонецЕсли;
		Узел = Узел.Получить(Сегменты[Номер]);
	КонецЦикла;
	Узел.Вставить(Сегменты[Сегменты.ВГраница()], Значение);
	Возврат Файл;

КонецФункции

Функция УзелБазыВФайле(Знач ТипКоннектора, Знач СтрокаСоединения)

	Файл = ВФайле(Новый Соответствие(), "data.ИсточникиДанных.ТипКоннектора", ТипКоннектора);
	Возврат ВФайле(Файл, "data.ИсточникиДанных.СтрокаСоединения", СтрокаСоединения);

КонецФункции

Функция Текстом(Знач Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение, "ЧГ=0; ЧН=0"), Строка(Значение));
КонецФункции

Функция ЕстьКлюч(Знач Детальки, Знач Ключ)

	Для Каждого Деталька Из Детальки Цикл
		Если НРег(Деталька.Ключ) = НРег(Ключ) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Имя переменной, которое принимает POSIX-оболочка: латиница, цифры, подчёркивание, не с цифры.
Функция ИмяОболочки(Знач Имя)

	Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789";
	Если НЕ ЗначениеЗаполнено(Имя) ИЛИ СтрНайти("0123456789", Лев(Имя, 1)) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Имя) Цикл
		Если СтрНайти(Допустимые, Сред(Имя, Номер, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Процедура ОчиститьПробу(Знач ПеременнаяФайлаПароля, Знач Каталог)

	УстановитьПеременнуюСреды("OSHUB_PROBE_BOTH", "");
	УстановитьПеременнуюСреды("OSHUB_PROBE_ENVONLY", "");
	УстановитьПеременнуюСреды(ПеременнаяФайлаПароля, "");
	УстановитьПеременнуюСреды("OSHUB_DB_CONNECTION", "");
	УдалитьФайлы(Каталог);

КонецПроцедуры

#КонецОбласти
