		.Равно(ОбъединитьПути(Новый Файл(Корень).ПолноеИмя, "кэш", "артефакты"));
	Ожидаем.Что(Загрузка.Значение("data.ИсточникиДанных")["СтрокаСоединения"])
		.Равно(ОбъединитьПути(Новый Файл(Корень).ПолноеИмя, "entities"));

КонецПроцедуры

&Тест
Процедура СэмплерХабаДействуетПриФайлеОператораСДолей() Экспорт

	// Доля в файле оператора делает otel.traces.sampler узлом {arg}: имени сэмплера там нет,
	// и без умолчания SDK доли не послушал бы.
	Файл = ВФайле(Новый Соответствие(), "otel.traces.sampler.arg", "0.1");

	Загрузка = Загружено(Файл, Новый Соответствие());

	Ожидаем.Что(Загрузка.Значение("otel.traces.sampler")).Равно("parentbased_traceidratio");
	Ожидаем.Что(Загрузка.Значение("otel.traces.sampler.arg"), "доля оператора на месте").Равно("0.1");

КонецПроцедуры

#КонецОбласти

#Область ИменаПеременных

&Тест
Процедура ПеременнаяКлючаНазываетсяПсевдонимомЛибоКонвенцией() Экспорт

	Имена = Новый ИменаПеременныхОкружения();

