// Загрузка настроек: правила над тем, что прочитал configor, — окружение перебивает файл,
// производные ключи, устройство хаба и умолчания хаба для чужих деталек; имена переменных;
// согласованность с тем, что видит собранная Поделка.

#Использовать asserts
#Использовать autumn
#Использовать "фикстуры"

&ТестовыйНабор
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Модули = КаталогМодулей();
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ИменаПеременныхОкружения");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "УровниЖурнала");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "КонфигурацияХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "ЗагрузкаНастроек");

КонецПроцедуры

#Область ОкружениеПеребиваетФайл

&Тест
Процедура ОкружениеПеребиваетФайл() Экспорт

	Файл = ВФайле(Новый Соответствие(), "oshub.storage.root", "./из-файла");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_STORAGE_ROOT", "/из-окружения");

	Загрузка = Загружено(Файл, Окружение);

	Ожидаем.Что(Загрузка.Значение("oshub.storage.root"), "переменная сильнее ключа файла")
		.Равно("/из-окружения");

КонецПроцедуры

&Тест
Процедура ПустоеЗначениеФайлаНеОтменяетПеременную() Экспорт

	// Ключ файла, даже пустой, у configor отбирает переменную: пустой «образец» в файле
	// однажды выключил OSHUB_AUTH_PASSWORD_ENABLED=false.
	Файл = ВФайле(Новый Соответствие(), "oshub.auth.password.enabled", "");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_AUTH_PASSWORD_ENABLED", "false");

	Ожидаем.Что(Загружено(Файл, Окружение).Значение("oshub.auth.password.enabled"))
		.Равно("false");

КонецПроцедуры

&Тест
Процедура ПустаяПеременнаяНичегоНеЗадаёт() Экспорт

	// Процесс не умеет снять переменную, только обнулить: фикстура тестов так и «чистит».
	Файл = ВФайле(Новый Соответствие(), "oshub.pools.default", "public");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_POOLS_DEFAULT", "");

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Файл, КартаПровайдера(Окружение));

	Ожидаем.Что(Загрузка.Значение("oshub.pools.default"), "значение файла на месте").Равно("public");
	Ожидаем.Что(ЕстьКлюч(Детальки, "oshub.pools.default"),
		"пустая переменная программной деталькой не легла").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Производные

&Тест
Процедура ПсевдонимСтавитсяТолькоПриИзвестномИсточнике() Экспорт

	Файл = ВФайле(Новый Соответствие(), "winow.Порт", 3333);

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Файл, Новый Соответствие());
	Ожидаем.Что(ЕстьКлюч(Детальки, "winow.Порт"), "без источника производной нет").ЭтоЛожь();
	Ожидаем.Что(ЕстьКлюч(Детальки, "otel.entity.query-text"), "и у дефисного ключа тоже").ЭтоЛожь();
	Ожидаем.Что(Загрузка.Значение("winow.Порт"), "порт — из файла").Равно(3333);

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_PORT", "4242");
	Ожидаем.Что(Загружено(Файл, Окружение).Значение("winow.Порт"),
		"псевдоним из окружения сильнее файла и приходит числом").Равно(4242);

	Ожидаем.Что(Загружено(ВФайле(Файл, "oshub.port", 4343), Новый Соответствие()).Значение("winow.Порт"),
		"псевдоним — обычный ключ configor, и из файла он тоже действует").Равно(4343);

КонецПроцедуры

&Тест
Процедура РодноеИмяЦелиСильнееПсевдонима() Экспорт

	// docker и k8s умеют переменную с дефисом — родное имя ключа autumn-opentelemetry
	Окружение = Новый Соответствие();
	Окружение.Вставить("OTEL_ENTITY_QUERY_TEXT", "true");
	Окружение.Вставить("OTEL_ENTITY_QUERY-TEXT", "false");

	Ожидаем.Что(Загружено(Новый Соответствие(), Окружение).Значение("otel.entity.query-text"))
		.Равно("false");

КонецПроцедуры

&Тест
Процедура НечисловойПортНеПереноситсяИНазванЗамечанием() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_PORT", "восемьдесят");

	Загрузка = Загружено(ВФайле(Новый Соответствие(), "winow.Порт", 3333), Окружение);

	Ожидаем.Что(Загрузка.Значение("winow.Порт"), "порт остался файловым").Равно(3333);
	Ожидаем.Что(СтрНайти(СтрСоединить(Загрузка.Замечания(), Символы.ПС), "OSHUB_PORT=восемьдесят") > 0,
		"замечание называет переменную и значение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УзелБазыСливаетсяЛистКЛисту() Экспорт

	// Лист окружения, для которого псевдонима нет, не теряется: узел собирается из всех
	// листьев под префиксом, а не из двух известных.
	Файл = УзелБазыВФайле("КоннекторJSON", "./data/entities");
	Окружение = Новый Соответствие();
	Окружение.Вставить("data_ИсточникиДанных_РазмерПула", "20");

	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел.Количество(), "в узле три листа").Равно(3);
	Ожидаем.Что(Узел["РазмерПула"], "лист из окружения").Равно("20");
	Ожидаем.Что(Узел["ТипКоннектора"], "листья файла на месте").Равно("КоннекторJSON");
	Ожидаем.Что(Узел["СтрокаСоединения"]).Равно("./data/entities");

КонецПроцедуры

&Тест
Процедура ПсевдонимыБазыЛожатсяНаЛистыУзла() Экспорт

	Файл = УзелБазыВФайле("КоннекторJSON", "./data/entities");
	ВФайле(Файл, "data.ИсточникиДанных.РазмерПула", 5);
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", "/врем/база");

	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел["СтрокаСоединения"], "псевдоним заменил свой лист").Равно("/врем/база");
	Ожидаем.Что(Узел["ТипКоннектора"], "коннектор — из файла").Равно("КоннекторJSON");
	Ожидаем.Что(Узел["РазмерПула"], "чужой лист файла не тронут").Равно(5);

КонецПроцедуры

&Тест
Процедура РодныеЛистыБазыОтменяютПсевдонимыЦеликом() Экспорт

	// Образ зашивает пару OSHUB_DB_*; оператор, назвавший коннектор родным именем, не должен
	// получить его склеенным со строкой соединения образа.
	Файл = УзелБазыВФайле("КоннекторJSON", "./data/entities");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторSQLite");
	Окружение.Вставить("OSHUB_DB_CONNECTION", "Data Source=/образ/openhub.db");
	Окружение.Вставить("data_ИсточникиДанных_ТипКоннектора", "КоннекторInMemory");

	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел["ТипКоннектора"], "родной лист").Равно("КоннекторInMemory");
	Ожидаем.Что(Узел["СтрокаСоединения"], "строка соединения образа не приклеилась")
		.Равно("./data/entities");

КонецПроцедуры

&Тест
Процедура УзелПровайдеровВходаСобираетсяИзЛистьев() Экспорт

	Файл = ВФайле(Новый Соответствие(), "oshub.oidc.keycloak.label", "Keycloak из файла");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_OIDC_PROVIDERS", "keycloak");
	Окружение.Вставить("OSHUB_OIDC_KEYCLOAK_ISSUER", "https://kc.example/realms/main");
	Окружение.Вставить("OSHUB_OIDC_KEYCLOAK_CLIENT__ID", "openhub");

	Загрузка = Загружено(Файл, Окружение);
	Узел = Загрузка.Значение("oshub.oidc");

	Ожидаем.Что(ТипЗнч(Узел), "провайдеры входа — узлом").Равно(Тип("Соответствие"));
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.providers")).Равно("keycloak");
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.keycloak.issuer"), "лист из окружения").Равно(
		"https://kc.example/realms/main");
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.keycloak.client_id"),
		"удвоенное подчёркивание имени дало подчёркивание ключа").Равно("openhub");
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.keycloak.label"), "лист файла сохранён")
		.Равно("Keycloak из файла");
	Ожидаем.Что(Узел.Количество(), "провайдер из окружения лёг в ветку файла, а не рядом").Равно(2);

КонецПроцедуры

&Тест
Процедура КаждыйПсевдонимЗакрытогоСпискаДействует() Экспорт

	// Список закрыт: новый псевдоним — это строка здесь и правило в загрузке, и без
	// правила строка здесь краснеет.
	Ожидаемые = Новый Соответствие();
	Ожидаемые.Вставить("oshub.port", "winow.Порт=4242");
	Ожидаемые.Вставить("oshub.db.connector", "data.ИсточникиДанных.ТипКоннектора=КоннекторInMemory");
	Ожидаемые.Вставить("oshub.db.connection", "data.ИсточникиДанных.СтрокаСоединения=/врем/база");
	Ожидаемые.Вставить("oshub.log.level", "logos.logger.rootLogger.level=DEBUG");
	Ожидаемые.Вставить("oshub.log.levels", "logos.logger.СервисПулов.level=WARN");
	Ожидаемые.Вставить("otel.entity.query.text", "otel.entity.query-text=true");
	Ожидаемые.Вставить("oshub.cache.artifacts.dir", "cache.артефакты.Каталог=/врем/кэш");
	Ожидаемые.Вставить("oshub.cache.artifacts.limit_bytes", "cache.артефакты.Предел=7340032");
	Ожидаемые.Вставить("oshub.cache.memory.limit_bytes", "cache.ПределПамяти=1048576");
	Ожидаемые.Вставить("oshub.cache.memory.ttl_sec", "cache.каналыПакета.СрокЖизни=7");

	Значения = Новый Соответствие();
	Значения.Вставить("oshub.port", "4242");
	Значения.Вставить("oshub.db.connector", "КоннекторInMemory");
	Значения.Вставить("oshub.db.connection", "/врем/база");
	Значения.Вставить("oshub.log.level", "DEBUG");
	Значения.Вставить("oshub.log.levels", "СервисПулов=WARN");
	Значения.Вставить("otel.entity.query.text", "true");
	Значения.Вставить("oshub.cache.artifacts.dir", "/врем/кэш");
	Значения.Вставить("oshub.cache.artifacts.limit_bytes", "7340032");
	Значения.Вставить("oshub.cache.memory.limit_bytes", "1048576");
	Значения.Вставить("oshub.cache.memory.ttl_sec", "7");

	Псевдонимы = Новый ИменаПеременныхОкружения().Псевдонимы();
	Ожидаем.Что(Псевдонимы.Количество(), "псевдонимов ровно столько, сколько здесь ожидается")
		.Равно(Ожидаемые.Количество());

	Для Каждого Псевдоним Из Псевдонимы Цикл

		Ожидание = Ожидаемые.Получить(Псевдоним.Ключ);
		Ожидаем.Что(Ожидание, "псевдоним вне закрытого списка: " + Псевдоним.Ключ).Заполнено();

		Окружение = Новый Соответствие();
		Окружение.Вставить(Псевдоним.Переменная, Значения.Получить(Псевдоним.Ключ));
		Загрузка = Загружено(Новый Соответствие(), Окружение, Истина);

		Знак = СтрНайти(Ожидание, "=");
		Цель = Лев(Ожидание, Знак - 1);
		Ожидаем.Что(Текстом(Загрузка.Значение(Цель)),
			СтрШаблон("%1 доезжает до %2", Псевдоним.Переменная, Цель)).Равно(Сред(Ожидание, Знак + 1));

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СрокЖизниПсевдонимаРаздаётсяВсемКэшамЧтений() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_CACHE_MEMORY_TTL__SEC", "7");

	Загрузка = Загружено(Новый Соответствие(), Окружение);

	Для Каждого ИмяКэша Из Загрузка.КэшиЧтенийИзБазы() Цикл
		Ожидаем.Что(Загрузка.Значение("cache." + ИмяКэша + ".СрокЖизни"), "кэш " + ИмяКэша)
			.Равно("7");
	КонецЦикла;
	Ожидаем.Что(Загрузка.КэшиЧтенийИзБазы().Количество(), "перечень кэшей не пуст").Больше(0);

КонецПроцедуры

#КонецОбласти

#Область УстройствоХаба

&Тест
Процедура УстройствоХабаСтавитсяПоверхВсего() Экспорт

	Файл = ВФайле(Новый Соответствие(), "winow.АвтоСтарт", Истина);
	ВФайле(Файл, "cache.артефакты.Поставщик", "память");
	Окружение = Новый Соответствие();
	Окружение.Вставить("WINOW_ИспользоватьПрикладнойСервер", "true");
	Окружение.Вставить("OSHUB_LOG_LEVEL", "WARN");

	Загрузка = Загружено(Файл, Окружение, Истина);

	Ожидаем.Что(Загрузка.Значение("winow.АвтоСтарт"), "порт открывает ОткрытиеПорта").Равно(Ложь);
	Ожидаем.Что(Загрузка.Значение("winow.ИспользоватьПрикладнойСервер")).Равно(Ложь);
	Ожидаем.Что(Загрузка.Значение("winow.КаталогСПриложениями")).Равно(КаталогМодулей());
	Ожидаем.Что(Загрузка.Значение("cache.артефакты.Поставщик"), "кэш артефактов на диске")
		.Равно("файлы");

	СпособыВывода = Загрузка.Значение("logos.appender");
	Ожидаем.Что(СпособыВывода["console"]["type"], "консоль хаба").Равно("ВыводЛогаВКонсольХаба");
	Ожидаем.Что(СпособыВывода["otel"]["type"], "мост журнала в OTel").Равно("ВыводЛогаВOTelХаба");
	Ожидаем.Что(Загрузка.Значение("logos.logger.rootLogger.level"),
		"уровень — производная oshub.log.level").Равно("WARN");

КонецПроцедуры

&Тест
Процедура ВнеСервераWinowИЖурналНеСвязываются() Экспорт

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Новый Соответствие(), Новый Соответствие());

	Ожидаем.Что(ЕстьКлюч(Детальки, "winow.АвтоСтарт"), "сценарий — не сервер").ЭтоЛожь();
	Ожидаем.Что(ЕстьКлюч(Детальки, "logos.appender"),
		"способов вывода хаба в процессе сценария нет").ЭтоЛожь();
	Ожидаем.Что(Загрузка.Значение("cache.артефакты.Поставщик"),
		"кэш артефактов — на диске в любом процессе хаба").Равно("файлы");

КонецПроцедуры

#КонецОбласти

#Область УмолчанияХабаДляЧужихДеталек

&Тест
Процедура УмолчанияДляЧужихДеталекЗаполняютПустоту() Экспорт

	Загрузка = Загружено(Новый Соответствие(), Новый Соответствие());
	Корень = Загрузка.КореньДанных();

	Ожидаем.Что(Корень, "корень по умолчанию — ./data хаба").Равно(Новый Файл("./data").ПолноеИмя);

	ИсточникДанных = Загрузка.Значение("data.ИсточникиДанных");
	Ожидаем.Что(ИсточникДанных["ТипКоннектора"]).Равно("КоннекторJSON");
	Ожидаем.Что(ИсточникДанных["СтрокаСоединения"]).Равно(ОбъединитьПути(Корень, "entities"));
	Ожидаем.Что(Загрузка.Значение("otel.traces.sampler")).Равно("parentbased_traceidratio");
	Ожидаем.Что(Загрузка.Значение("otel.service.name")).Равно("openhub");
	Ожидаем.Что(Загрузка.Значение("cache.артефакты.Каталог"))
		.Равно(ОбъединитьПути(Корень, "кэш", "артефакты"));
	Ожидаем.Что(Загрузка.Значение("cache.артефакты.Предел")).Равно(1073741824);
	Ожидаем.Что(Загрузка.Значение("cache.ПределПамяти")).Равно(134217728);
	Для Каждого ИмяКэша Из Загрузка.КэшиЧтенийИзБазы() Цикл
		Ожидаем.Что(Загрузка.Значение("cache." + ИмяКэша + ".СрокЖизни"), ИмяКэша).Равно(30);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ФайлСильнееУмолчанияХабаДляЧужойДетальки() Экспорт

	Файл = УзелБазыВФайле("КоннекторSQLite", "Data Source=/база.db");
	ВФайле(Файл, "otel.traces.sampler", "always_on");
	ВФайле(Файл, "otel.service.name", "хаб-оператора");
	ВФайле(Файл, "cache.артефакты.Каталог", "/кэш-оператора");
	ВФайле(Файл, "cache.ПределПамяти", 1024);
	ВФайле(Файл, "cache.пулы.СрокЖизни", 5);

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Файл, Новый Соответствие());

	Для Каждого Ключ Из СтрРазделить("data.ИсточникиДанных,otel.traces.sampler,otel.service.name,"
		+ "cache.артефакты.Каталог,cache.ПределПамяти,cache.пулы.СрокЖизни", ",") Цикл
		Ожидаем.Что(ЕстьКлюч(Детальки, Ключ), "умолчание хаба не легло поверх файла: " + Ключ)
			.ЭтоЛожь();
	КонецЦикла;
	Ожидаем.Что(Загрузка.Значение("otel.service.name")).Равно("хаб-оператора");
	Ожидаем.Что(Загрузка.Значение("data.ИсточникиДанных")["ТипКоннектора"]).Равно("КоннекторSQLite");
	Ожидаем.Что(Загрузка.Значение("cache.источникиПула.СрокЖизни"),
		"соседний кэш получил умолчание").Равно(30);

КонецПроцедуры

&Тест
Процедура ОкружениеСильнееУмолчанияХабаДляЧужойДетальки() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OTEL_SERVICE_NAME", "хаб-из-окружения");

	Ожидаем.Что(Загружено(Новый Соответствие(), Окружение).Значение("otel.service.name"))
		.Равно("хаб-из-окружения");

КонецПроцедуры

&Тест
Процедура КаталогиПоУмолчаниюСчитаютсяОтКорняДанных() Экспорт

	Корень = ОбъединитьПути(КаталогВременныхФайлов(), "корень-загрузки");
