// Дефект владельца (боевой хаб, 2026-08-06): под убил рабочего посреди обхода, запись
// осталась в состоянии «идёт», и каждая заявка — плановая и от администратора — два часа
// отбивалась «прогон этого зеркала уже идёт». Здесь проверяется, что рестарт лечит: прогон,
// оставшийся идущим от прошлого запуска, подбирается на старте, обход возобновляется
// С КУРСОРА, а отказ живой заявке называет цифры вместо «уже идёт».

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулей_;
Перем КаталогФикстур_;
Перем Хранилище_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур_ = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Классы = ОбъединитьПути(КаталогМодулей_, "зеркала", "Классы");
	ПоискКлассов.Подключить(Классы, "ПодборОборванныхПрогонов");
	ПоискКлассов.Подключить(Классы, "ПрогонЗеркала");
	ПоискКлассов.Подключить(Классы, "ДроссельПрогресса");
	ПоискКлассов.Подключить(Классы, "СервисЗеркал");
	ПоискКлассов.Подключить(Классы, "ОчередьСинхронизацииЗеркал");
	ПоискКлассов.Подключить(Классы, "СинхронизаторЗеркал");
	ПоискКлассов.Подключить(Классы, "ЧислаЗеркалирования");
	ПоискКлассов.Подключить(Классы, "СчётчикиОбхода");
	ПоискКлассов.Подключить(Классы, "РазборНастроекЗеркала");
	ПоискКлассов.Подключить(Классы, "СледЦиклаЗеркала");
	ПоискКлассов.Подключить(Классы, "ОтметкаПеречисления");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "аудит", "Классы"), "ИмяОбъектаАудита");
	Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы", "ПриведениеЧисел.os"),
		"ПриведениеЧисел");
	Подключить(ОбъединитьПути(КаталогФикстур_, "НастройкиЗаглушка.os"), "НастройкиЗаглушка");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ФейкХранилищеЗеркал.os"), "ФейкХранилищеЗеркал");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ФейкЗеркалоЗапись.os"), "ФейкЗеркалоЗапись");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ЧасыРучные.os"), "ЧасыРучные");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ПрогонЗеркалаБезЗаписи.os"), "ПрогонЗеркалаБезЗаписи");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ЛовушкаЛога.os"), "ЛовушкаЛога");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ШпионИздателяЗеркала.os"), "ШпионИздателяЗеркала");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ФейкХранилищеСущностей.os"), "ФейкХранилищеСущностей");
	Подключить(ОбъединитьПути(КаталогФикстур_, "НастройкиЗаглушка.os"), "НастройкиЗаглушка");

КонецПроцедуры

&ПередКаждым
Процедура НовоеХранилище() Экспорт
	Хранилище_ = Новый ФейкХранилищеЗеркал();
КонецПроцедуры

// Ровно та ситуация, что была на боевом хабе: отметка прогресса СВЕЖАЯ (порог ещё не вышел),
// поэтому по молчанию прогон живым и остаётся, а вести его некому. До подбора заявка
// отбивается; после старта хаба зеркало снова синхронизируется, и обход НЕ начинается заново.
&Тест
Процедура РестартПосредиОбходаВозобновляетСинхронизациюСКурсора() Экспорт

	Стенд = НовыйСтенд("возобновление");
	Зеркало = ЗеркалоСОборваннымПрогоном(60); // молчит минуту при пороге 900 с

	Ожидаем.Что(Стенд.Очередь.Поставить(Зеркало.Идентификатор, "admin"),
		"до подбора заявка отбивается — ровно на это жаловался владелец").ЭтоЛожь();

	Стенд.Подбор.ПриЗапускеПриложения();

	Ожидаем.Что(Стенд.Очередь.Размер(), "подбор сам вернул обход в очередь: кнопку жать не надо")
		.Равно(1);
	Ожидаем.Что(Стенд.Очередь.Состояние(Зеркало.Идентификатор), "зеркало снова в работе")
		.Равно("поставлено");

	// возобновление — это ПРОДОЛЖЕНИЕ: 300 уже перенесённых пакетов не переносятся заново
	Заявка = Стенд.Очередь.Забрать();
	Захват = Стенд.Прогон.Занять(Заявка.ЗеркалоИдентификатор);
	Ожидаем.Что(Захват.Занят, "движок захватил зеркало").ЭтоИстина();
	Ожидаем.Что(Захват.Курсор, "обход продолжается с недойденного пакета").Равно("coverage");

	Состояние = Стенд.Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Скачано, "счётчики обхода не потеряны").Равно(300);
	Ожидаем.Что(Состояние.Начат, "отсчёт времени обхода не сброшен").Равно(НачалоОбхода());

КонецПроцедуры

// Заявка после подбора обязана приниматься не только от рогатки, но и от человека:
// кнопка «синхронизировать сейчас» — единственное, чем оператор располагает.
&Тест
Процедура ЗаявкаПослеПодбораПринимается() Экспорт

	Стенд = НовыйСтенд("заявка");
	Зеркало = ЗеркалоСОборваннымПрогоном(60);

	Стенд.Подбор.ПриЗапускеПриложения();
	Стенд.Очередь.Забрать();                        // рабочий разобрал заявку подбора
	Стенд.Очередь.Завершить(Зеркало.Идентификатор); // и отпустил зеркало

	Ожидаем.Что(Стенд.Очередь.Поставить(Зеркало.Идентификатор, "admin"),
		"кнопка администратора снова работает").ЭтоИстина();

КонецПроцедуры

// Подобранный прогон обязан быть ЗАКРЫТ, а не просто разблокирован: экран, часами
// показывавший «идёт» с застывшими счётчиками, врал оператору — и статус обязан объяснить,
// что случилось, словами.
&Тест
Процедура ПодобранныйПрогонЗакрытИОбъяснёнСтатусом() Экспорт

	Стенд = НовыйСтенд("закрытие");
	Зеркало = ЗеркалоСОборваннымПрогоном(60);
	ПоследняяОтметка = Зеркало.ПрогонОбновлён; // снимок ДО подбора: хранилище отдаёт саму запись

	Стенд.Подбор.ПриЗапускеПриложения();

	Состояние = Стенд.Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Идёт, "прогон больше не числится идущим").ЭтоЛожь();
	Ожидаем.Что(Состояние.Состояние, "зеркало ждёт возобновлённого обхода").Равно("поставлено");
	Ожидаем.Что(НРег(Состояние.Статус), "статус называет причину: " + Состояние.Статус)
		.Содержит("оборван остановкой процесса");
	Ожидаем.Что(Состояние.Курсор, "курсор сохранён для продолжения").Равно("coverage");
	// «последний синк» — момент последней настоящей отметки, а не момент подбора:
	// в момент подбора этот обход не синхронизировал ничего
	Ожидаем.Что(Состояние.ПоследнийСинк, "момент синка не подменён моментом подбора")
		.Равно(ПоследняяОтметка);

КонецПроцедуры

// Подбор трогает ТОЛЬКО прогоны, оставшиеся идущими. Зеркало, честно отработавшее до
// рестарта, обязано пережить старт нетронутым — иначе каждый деплой стирал бы итог синка.
&Тест
Процедура ЗакрытыеПрогоныПодборНеТрогает() Экспорт

	Стенд = НовыйСтенд("здоровые");

	Для Каждого Состояние_ Из СтрРазделить("завершён,ошибка,поставлено,простаивает", ",") Цикл
		Зеркало = НовоеЗеркало();
		Зеркало.СостояниеПрогона = Состояние_;
		Зеркало.Статус = "итог прошлого синка: " + Состояние_;
		Зеркало.ПрогонОбновлён = НачалоОбхода() + 22;
		Зеркало.Сохранить();
	КонецЦикла;

	Стенд.Подбор.ПриЗапускеПриложения();

	Для Каждого Запись Из Хранилище_.Все() Цикл
		Состояние = Стенд.Прогон.Состояние(Запись.Идентификатор);
		Ожидаем.Что(Состояние.Статус, "итог закрытого прогона не переписан подбором")
			.Равно("итог прошлого синка: " + Состояние.Состояние);
	КонецЦикла;
	Ожидаем.Что(Стенд.Очередь.Размер(), "здоровых зеркал подбор в очередь не ставит").Равно(0);

КонецПроцедуры

// Выключенное зеркало синхронизировать нечем, но врать «идёт» оно тоже не вправе:
// иначе включение упрётся в прогон, которого нет.
&Тест
Процедура ВыключенноеЗеркалоОсвобождаетсяНоВОчередьНеИдёт() Экспорт

	Стенд = НовыйСтенд("выключенное");
	Зеркало = ЗеркалоСОборваннымПрогоном(60);
	Зеркало.Включено = Ложь;
	Зеркало.Сохранить();

	Стенд.Подбор.ПриЗапускеПриложения();

	Состояние = Стенд.Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Идёт, "прогон выключенного зеркала тоже отпущен").ЭтоЛожь();
	Ожидаем.Что(Состояние.Состояние, "и закрыт как несостоявшийся, раз возобновлять его нечем")
		.Равно("ошибка");
	Ожидаем.Что(Стенд.Очередь.Размер(), "но синхронизировать выключенное зеркало не пытаемся")
		.Равно(0);

КонецПроцедуры

// Ручки «инстанс один» больше нет: инстанс один по устройству продукта. Но допущение
// произносится ВСЛУХ на каждом старте — второй инстанс за балансировщиком заведут не те,
// кто читал исходники подбора, и молча действующее допущение они бы не нашли.
&Тест
Процедура ДопущениеОбОдномИнстансеНазваноНаСтарте() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НовыйСтенд("допущение", 900, 20, Ловушка);

	Стенд.Подбор.ПриЗапускеПриложения();

	Ожидаем.Что(НРег(Ловушка.Всё()), "допущение названо словами: " + Ловушка.Всё())
		.Содержит("инстанс хаба один");
	Ожидаем.Что(Ловушка.Всё(), "и сказано, что делать при втором инстансе")
		.Содержит("подбор придётся переделать");

КонецПроцедуры

// Настройка обязана быть настройкой. Раньше `run_stale_sec` был лишь нижней границей:
// администратор, поднявший порцию до 344, молча получал порог 6900 с вместо заданных 900
// и зеркало, два часа отбивавшее кнопку.
&Тест
Процедура ПорогОстаётсяТемЧтоЗадалОператор() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НовыйСтенд("порог", 900, 344, Ловушка);

	Стенд.Подбор.ПриЗапускеПриложения();

	Ожидаем.Что(Стенд.Прогон.ПорогЗависания(), "долгий таймаут апстрима порог оператора не поднимает")
		.Равно(900);
	Ожидаем.Что(Ловушка.Всё(), "действующий порог назван числом на старте: " + Ловушка.Всё())
		.Содержит("после 900 с молчания");

КонецПроцедуры

// Пол не исчез — он перестал быть потолком поверх воли оператора и стал предупреждением.
// Порог ниже окна перечисления объявляет брошенным ЖИВОЙ обход, и оператор обязан узнать
// об этом из журнала, а не из поведения кнопки.
&Тест
Процедура ПорогНижеОкнаМолчанияПорцииОбъявленПредупреждением() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НовыйСтенд("окно", 100, 200, Ловушка);

	Стенд.Подбор.ПриЗапускеПриложения();

	Ожидаем.Что(Ловушка.Всё(), "окно молчания цикла названо числом: " + Ловушка.Всё())
		.Содержит("400 с");
	Ожидаем.Что(Ловушка.Всё(), "и названо, чем оно набирается")
		.Содержит("oshub.proxy.timeout.sec 200");

КонецПроцедуры

// Совет «поднимите порог» в одиночку заводит оператора боевого хаба ОБРАТНО в инцидент:
// при порции 344 это 6900 с. Предупреждение обязано предлагать обе стороны — и порог,
// и порцию — и называть, чем он заплатит, если не сделает ничего.
&Тест
Процедура ПредупреждениеОбОкнеПредлагаетОбеСтороныИНазываетЦену() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НовыйСтенд("совет", 100, 200, Ловушка);

	Стенд.Подбор.ПриЗапускеПриложения();

	// 2 × 50 = 100 — ровно порог, то есть таймаут, который в него укладывается
	Ожидаем.Что(Ловушка.Всё(), "назван таймаут, который уложится в заданный порог: " + Ловушка.Всё())
		.Содержит("oshub.proxy.timeout.sec опустить до 50");
	Ожидаем.Что(Ловушка.Всё(), "и порог, который покроет заданный таймаут")
		.Содержит("run_stale_sec поднять до 400");
	Ожидаем.Что(Ловушка.Всё(), "названо следствие бездействия — обход пойдёт по второму кругу")
		.Содержит("по второму кругу");
	Ожидаем.Что(Ловушка.Всё(), "и сказано, что данные при этом целы").Содержит("Данные при этом целы");

КонецПроцедуры

// Опечатка в OSHUB_PROXY_TIMEOUT_SEC не вправе уронить сборку контейнера: детальки
// приезжают строками, а конструктор считается ВНЕ перехвата ПриЗапускеПриложения.
&Тест
Процедура НечисловаяНастройкаТаймаутаНеРоняетСборкуКонтейнера() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Числа = ЧислаЗеркал(900);
	Прогон = Новый ПрогонЗеркала(Хранилище_, Новый ПриведениеЧисел(),
		Дроссель(10, 2), Числа,
		Новый СчётчикиОбхода(Новый ПриведениеЧисел()));
	Сервис = Новый СервисЗеркал(Хранилище_, Неопределено, Неопределено, Новый Массив(), Прогон, Числа,
		Новый РазборНастроекЗеркала(Числа));
	Лог = ЛогСЛовушкой("опечатка", Ловушка);
	Очередь = Новый ОчередьСинхронизацииЗеркал(Новый ПриведениеЧисел(), Сервис, Числа, Лог);

	Подбор = Новый ПодборОборванныхПрогонов(Хранилище_, Прогон, Очередь, Новый ПриведениеЧисел(),
		НастройкиПрокси(20), Лог);
	Подбор.ПриЗапускеПриложения();

	Ожидаем.Что(Ловушка.Всё(), "хаб поднялся и отработал на дефолтах: " + Ловушка.Всё())
		.Содержит("после 900 с молчания");

КонецПроцедуры

// Нечитаемая настройка порога не вправе обнулить его и объявить брошенными все прогоны:
// берётся умолчание кода.
&Тест
Процедура НечисловойПорогПадаетНаУмолчаниеКода() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.run_stale_sec", "пятнадцать");
	Числа = Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);

	Ожидаем.Что(Числа.ПорогЗависания(), "негодное значение не роняет синхронизацию").Равно(300);

КонецПроцедуры

// Плановый проход ходит через ту же очередь: при выключенной синхронизации обещать его —
// значит отправить оператора ждать того, чего не будет.
&Тест
Процедура ПриВыключеннойСинхронизацииПодборНеОбещаетПлановыйПроход() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НовыйСтенд("выключено", 900, 20, Ловушка, Ложь);

	ЗеркалоСОборваннымПрогоном(60);
	Стенд.Подбор.ПриЗапускеПриложения();

	Ожидаем.Что(Ловушка.Всё(), "названа настоящая причина: " + Ловушка.Всё())
		.Содержит("oshub.mirror.sync_enabled");
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "подхватит плановый проход") > 0,
		"и не обещан проход, которого не будет: " + Ловушка.Всё()).ЭтоЛожь();

КонецПроцедуры

// Обратная сторона: при мелкой порции окно меньше порога, и пугать оператора нечем.
&Тест
Процедура ПорогВышеОкнаМолчанияПорцииНеПугаетОператора() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НовыйСтенд("тихо", 900, 20, Ловушка);

	Стенд.Подбор.ПриЗапускеПриложения();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "меньше окна молчания цикла") > 0,
		"порог 900 с при окне 40 с предупреждения не заслуживает: " + Ловушка.Всё()).ЭтоЛожь();

КонецПроцедуры

// Отказ живой заявке обязан называть цифры: без них «прогон уже идёт» не отличает живой
// обход от осиротевшего, и оператору нечего ждать и не на что смотреть.
&Тест
Процедура ОтказЗаявкеНазываетМолчаниеИОстатокДоОтвисания() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Часы = Новый ЧасыРучные();
	Стенд = НовыйСтенд("отказ", 900, 20, Ловушка);
	Стенд.Прогон.УстановитьЧасы(Часы);
	Стенд.Очередь.УстановитьЧасы(Часы);

	Зеркало = ЗеркалоСОборваннымПрогоном(120, Часы.Сейчас());

	Ожидаем.Что(Стенд.Очередь.Поставить(Зеркало.Идентификатор, "admin"), "заявка отбита")
		.ЭтоЛожь();

	Ожидаем.Что(Ловушка.Всё(), "названо, сколько прогон молчит: " + Ловушка.Всё())
		.Содержит("120 с назад");
	Ожидаем.Что(Ловушка.Всё(), "и через сколько он будет отпущен").Содержит("через 780 с");

КонецПроцедуры

// Второй способ застрять в «идёт»: цикл отработал, а записать итог не смог. Запись состояния
// считалась вторичной и падала В ПУСТОЙ ОБРАБОТЧИК — зеркало запиралось ровно так же, как
// от убитого процесса, и в журнале не было ни строки о том, почему.
&Тест
Процедура НезаписанныйИтогЦиклаВиденОператору() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Движок = ДвижокНадСломаннойЗаписью(Ловушка, Новый ШпионИздателяЗеркала());

	Движок.Синхронизировать(ЗеркалоСтруктурой());

	Ожидаем.Что(Ловушка.Всё(), "несделанная запись итога названа: " + Ловушка.Всё())
		.Содержит("прогон остался помечен идущим");
	Ожидаем.Что(Ловушка.Всё(), "и названо зеркало, которое из-за неё заперто").Содержит("Зеркало #7");

КонецПроцедуры

// Обход, чей итог записать не удалось, НЕ закрыт: запись осталась «идёт», курсор не сдвинут.
// Объявить его синхронизированным значило бы написать в журнал заведомую неправду — и как раз
// о том обходе, ради разбора которого в журнал и смотрят.
&Тест
Процедура НезаписанныйИтогВЖурналНеПопадает() Экспорт

	Шпион = Новый ШпионИздателяЗеркала();
	Движок = ДвижокНадСломаннойЗаписью(Новый ЛовушкаЛога(), Шпион);

	Движок.Синхронизировать(ЗеркалоСтруктурой());

	Ожидаем.Что(Шпион.Количество(), "события о синхронизации не было").Равно(0);

КонецПроцедуры

// Подбор — не повод не стартовать: хаб обязан подняться, а несделанную работу назвать.
&Тест
Процедура СбойПодбораНеРоняетСтартИВиденОператору() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Стенд = НовыйСтенд("сбой", 900, 20, Ловушка);
	Битый = Новый ПодборОборванныхПрогонов(Неопределено, Стенд.Прогон, Стенд.Очередь,
		Новый ПриведениеЧисел(), НастройкиПрокси(20), Стенд.Лог);

	Битый.ПриЗапускеПриложения();

	Ожидаем.Что(Ловушка.Всё(), "сбой подбора назван: " + Ловушка.Всё())
		.Содержит("Подбор оборванных прогонов зеркал не выполнен");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Стенд боевой связки: очередь ходит в СервисЗеркал, тот — в ПрогонЗеркала, все трое
// смотрят в одно хранилище. Подменён только слой БД.
Функция НовыйСтенд(Знач Прозвище, Знач Порог = 900, Знач ТаймаутАпстрима = 20,
	Знач Ловушка = Неопределено, Знач Включена = Истина)

	Числа = ЧислаЗеркал(Порог, Включена);
	Прогон = Новый ПрогонЗеркала(Хранилище_, Новый ПриведениеЧисел(),
		Дроссель(10, 2), Числа,
		Новый СчётчикиОбхода(Новый ПриведениеЧисел()));
	Сервис = Новый СервисЗеркал(Хранилище_, Неопределено, Неопределено, Новый Массив(), Прогон, Числа,
		Новый РазборНастроекЗеркала(Числа));
	Лог = ЛогСЛовушкой(Прозвище, Ловушка);
	Очередь = Новый ОчередьСинхронизацииЗеркал(Новый ПриведениеЧисел(), Сервис, Числа, Лог);
	Подбор = Новый ПодборОборванныхПрогонов(Хранилище_, Прогон, Очередь, Новый ПриведениеЧисел(),
		НастройкиПрокси(ТаймаутАпстрима), Лог);

	Возврат Новый Структура("Прогон, Сервис, Очередь, Подбор, Лог, Числа",
		Прогон, Сервис, Очередь, Подбор, Лог, Числа);

КонецФункции

// Движок, у которого получается всё, кроме записи итога. След наружу собран РАБОЧИМ:
// настоящие имена журнала поверх пустого хранилища и шпион вместо издателя. Пустая
// зависимость здесь недопустима: имена без хранилища бросают исключение, публикация
// глохнет в собственном перехвате следа, и «событий нет» доказывало бы только это.
Функция ДвижокНадСломаннойЗаписью(Знач Ловушка, Знач Издатель)
	Возврат Новый СинхронизаторЗеркал(Неопределено, Неопределено, Неопределено,
		Новый ПрогонЗеркалаБезЗаписи(),
		Новый СледЦиклаЗеркала(Новый ИмяОбъектаАудита(Новый ФейкХранилищеСущностей()), Издатель),
		Неопределено, Новый Массив(), Неопределено, Новый ПриведениеЧисел(), ЧислаЗеркал(900),
		ЛогСЛовушкой("итог", Ловушка));
КонецФункции

Функция ЗеркалоСтруктурой()
	Возврат Новый Структура(
		"Идентификатор, Режим, АпстримURL, ПулНазначенияИдентификатор, РазрешитьПриватные",
		7, "opm", "https://hub.oscript.io/download/", 1, Ложь);
КонецФункции

// Дроссель с заданным темпом — тестовый шов: в боевом контейнере темп фиксирован.
Функция Дроссель(Знач Элементов, Знач Секунд)
	Результат = Новый ДроссельПрогресса(Новый ПриведениеЧисел());
	Результат.УстановитьТемп(Элементов, Секунд);
	Возврат Результат;
КонецФункции

// Порог и рубильник живут в настройках хаба и спрашиваются на каждый вызов.
Функция ЧислаЗеркал(Знач Порог, Знач Включена = Истина)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.run_stale_sec", Порог);
	Настройки.Задать("oshub.mirror.sync_enabled", Включена);
	Настройки.Задать("oshub.mirror.max_per_pool", 5);
	Настройки.Задать("oshub.mirror.queue_max", 100);
	Возврат Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);
КонецФункции

// Запись ровно того вида, в каком её оставил убитый под: состояние «идёт», курсор на
// недойденном пакете, счётчики обхода на месте, отметка прогресса моложе порога.
Функция ЗеркалоСОборваннымПрогоном(Знач СекундМолчания, Знач Момент = Неопределено)

	Сейчас_ = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Зеркало = НовоеЗеркало();
	Зеркало.СостояниеПрогона = "идёт";
	Зеркало.ПрогонНачат = НачалоОбхода();
	Зеркало.ПрогонОбновлён = Сейчас_ - СекундМолчания;
	Зеркало.ПрогонКурсор = "coverage";
	Зеркало.ПрогонВсего = 344;
	Зеркало.ПрогонСкачано = 300;
	Зеркало.ПрогонПропущено = 15;
	Зеркало.Сохранить();
	Возврат Зеркало;

КонецФункции

Функция НачалоОбхода()
	Возврат Дата(2026, 8, 6, 4, 30, 46);
КонецФункции

Функция НовоеЗеркало()
	Зеркало = Хранилище_.СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = 1;
	Зеркало.АпстримURL = "https://hub.oscript.io/download/";
	Зеркало.Режим = "opm";
	Зеркало.Сохранить();
	Возврат Зеркало;
КонецФункции

// Уровень консоли хаба: то, чего тут нет, оператор в консоли не увидит. Имя лога уникально
// на тест — иначе способ вывода соседа доживает до следующего теста, и набор читает чужое.
Функция ЛогСЛовушкой(Знач Прозвище, Знач Ловушка)

	Лог = Логирование.ПолучитьЛог("тест.oshub.зеркала.рестарт." + Прозвище);
	Если Ловушка <> Неопределено Тогда
		Лог.УстановитьУровень(УровниЛога.Информация);
		Лог.ДобавитьСпособВывода(Ловушка);
	КонецЕсли;
	Возврат Лог;

КонецФункции

Процедура Подключить(Знач Путь, Знач Имя)
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти

// Настройки прокси для прямой сборки подбора вне контейнера: он читает у них таймаут
// апстрима — из него выводится окно молчания порции.
Функция НастройкиПрокси(Знач Таймаут)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси(Таймаут);
	Возврат Настройки;
КонецФункции
