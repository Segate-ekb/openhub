КонецПроцедуры

&Тест
Процедура СервисПравБерётРольЧерезГруппу() Экспорт

	СП = Желудь("СервисПользователей");
	СГ = Желудь("СервисГрупп");
	СПрав = Желудь("СервисПрав");
	ХранилищеУчастниковПула = Желудь("ХранилищеУчастниковПула");

	Юзер = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Группа = СГ.СоздатьГруппу(УникальныйЛогин(), "maintainers");
	СГ.ДобавитьУчастника(Группа.Идентификатор, Юзер.Идентификатор);

	ПулИд = 777;
	Запись = ХранилищеУчастниковПула.СоздатьЭлемент();
	Запись.ПулИдентификатор = ПулИд;
	Запись.ТипСубъекта = "группа";
	Запись.СубъектИдентификатор = Группа.Идентификатор;
	Запись.Роль = "publisher";
	Запись.Сохранить();

	Ожидаем.Что(СПрав.РольНаПул(Юзер, ПулИд)).Равно("райтер");
	Ожидаем.Что(СПрав.МожетПисать(Юзер, ПоддельныйПул(ПулИд, "private"))).ЭтоИстина();
	Ожидаем.Что(СПрав.МожетАдминистрировать(Юзер, ПоддельныйПул(ПулИд, "private"))).ЭтоЛожь();

	Ожидаем.Что(СПрав.РольНаПул(Юзер, 888)).Равно("");

КонецПроцедуры

&Тест
Процедура ЛокальноеЧленствоГруппыДобавляетсяИУдаляется() Экспорт

	СП = Желудь("СервисПользователей");
	СГ = Желудь("СервисГрупп");
	Юзер = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Группа = СГ.СоздатьГруппу(УникальныйЛогин(), "");

	СГ.ДобавитьУчастника(Группа.Идентификатор, Юзер.Идентификатор);
	СГ.ДобавитьУчастника(Группа.Идентификатор, Юзер.Идентификатор); // идемпотентно
	Ожидаем.Что(СГ.УчастникиГруппы(Группа.Идентификатор).Количество()).Равно(1);
	Ожидаем.Что(СГ.ГруппыПользователя(Юзер.Идентификатор).Количество() >= 1).ЭтоИстина();

	Ожидаем.Что(СГ.УдалитьУчастника(Группа.Идентификатор, Юзер.Идентификатор)).ЭтоИстина();
	Ожидаем.Что(СГ.УчастникиГруппы(Группа.Идентификатор).Количество()).Равно(0);

