// Юнит-тесты модуля auth: пользователи, пароли, нормализация логина, сессии, PAT,
// СервисПрав с группами, rate-limit, регистрация, онбординг.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;
Перем КореньХранилища;
Перем ЛогОтметки;   // журнал, в который обёртка ответа пишет о своих сбоях

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Счётчик = 0;

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("данные", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("реестр", "Классы")));

	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("основа", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, "наблюдаемость", "Классы", "телеметрия"));
	// издатель событий строится только с зарегистрированной телеметрией, а без издателя
	// правка настройки роняет сервис — контейнер обязан уметь то же, что и хаб
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("события", "Классы")));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();
	// audit целиком: ИмяОбъектаАудита собирают сервисы auth, а СлужбаАудита пишет строку
	// журнала по событию замка — тесты локаута смотрят именно её. Рогатке службы нужна
	// ГотовностьХаба, иначе желудь не собирается.
	ПодключитьСервисы(ОбъединитьПути(Модули, "наблюдаемость", "Классы", "пробы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("аудит", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("вход", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("права", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("настройки", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, "интерфейс", "Классы", "настройки"));
	// служба аудита — подписчик: без неё контейнер не отвечает на вопрос, доезжает ли
	// событие смены роли до журнала
	ПодключитьСервисы(ОбъединитьПути(Модули, "наблюдаемость", "Классы", "пробы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("аудит", "Классы")));
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ПодтверждениеАдресаЗаглушка");
	РеестрФикстур.Подключить("ЖурналАудитаФайлом");
	РеестрФикстур.Подключить("ОбработчикЗапросовЗаглушка");
	РеестрФикстур.Подключить("ПерехватчикПадающий");
	РеестрФикстур.Подключить("ЛовушкаЛога");

	ЛогОтметки = Логирование.ПолучитьЛог("тест.oshub.отметка-токена");

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-auth-unit-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "auth-unit-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	// журнал аудита — файл под корнем хранилища: набор смотрит именно его
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область Пользователи

&Тест
Процедура СоздаётПользователяИХешируетПароль() Экспорт

	СП = Желудь("СервисПользователей");
	Логин = УникальныйЛогин();
	Пользователь = СП.СоздатьПользователя(Логин, "u@ex.com", "password123", "user");

	Ожидаем.Что(Пользователь.Идентификатор > 0).ЭтоИстина();
	Ожидаем.Что(Пользователь.Активен).ЭтоИстина();
	Ожидаем.Что(Пользователь.РольХаба).Равно("user");
	Ожидаем.Что(СтрНачинаетсяС(Пользователь.ХешПароля, "$pbkdf2-sha256$")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Пользователь.ХешПароля, "password123")).Равно(0);

	Ожидаем.Что(СП.ПроверитьПароль(Пользователь, "password123")).ЭтоИстина();
	Ожидаем.Что(СП.ПроверитьПароль(Пользователь, "wrong-pass")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПрозрачноеПерехешированиеПриУстаревшихПараметрах() Экспорт

	СП = Желудь("СервисПользователей");
	Логин = УникальныйЛогин();
	Пользователь = СП.СоздатьПользователя(Логин, "", "password123", "user");

	УстаревшийХеш = ХешированиеПаролей.Захешировать("password123", ХешированиеПаролей.МинимальныеИтерации());
	Пользователь.ХешПароля = УстаревшийХеш;
	Пользователь.Сохранить();
	Ожидаем.Что(ХешированиеПаролей.ТребуетПерехеширования(УстаревшийХеш), "устаревший хеш требует апгрейда").ЭтоИстина();

	Ожидаем.Что(СП.ПроверитьПароль(Пользователь, "password123")).ЭтоИстина();

	Обновлённый = СП.ПоИдентификатору(Пользователь.Идентификатор);
	Ожидаем.Что(Обновлённый.ХешПароля = УстаревшийХеш, "хеш в БД обновлён").ЭтоЛожь();
	Ожидаем.Что(ХешированиеПаролей.ТребуетПерехеширования(Обновлённый.ХешПароля),
		"после апгрейда перехеширование не требуется").ЭтоЛожь();
	Ожидаем.Что(СП.ПроверитьПароль(Обновлённый, "password123")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЛогинНормализуетсяКНижнемуРегиструИПоискНечувствителен() Экспорт

	СП = Желудь("СервисПользователей");
	База = УникальныйЛогин();
	Пользователь = СП.СоздатьПользователя(ВРег(База), "", "password123", "user");

	Ожидаем.Что(Пользователь.Логин).Равно(НРег(База));
	Ожидаем.Что(СП.НайтиПоЛогину(ВРег(База)).Идентификатор).Равно(Пользователь.Идентификатор);
	Ожидаем.Что(СП.НайтиПоЛогину(НРег(База)).Идентификатор).Равно(Пользователь.Идентификатор);

КонецПроцедуры

&Тест
Процедура ПовторныйЛогинЗапрещён() Экспорт

	СП = Желудь("СервисПользователей");
	Логин = УникальныйЛогин();
	СП.СоздатьПользователя(Логин, "", "password123", "user");

	Ожидаем.Что(Попытка_СоздатьДубль(СП, Логин)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НормализаторВалидируетЛогинИEmail() Экспорт

	Норм = Желудь("НормализаторУчётки");
	Ожидаем.Что(Норм.НормализоватьЛогин("  BoB  ")).Равно("bob");

	Ожидаем.Что(ЛогинНевалиден(Норм, "a")).ЭтоИстина();          // слишком короткий
	Ожидаем.Что(ЛогинНевалиден(Норм, "bad login")).ЭтоИстина();  // пробел
	Ожидаем.Что(ЛогинНевалиден(Норм, "_bad")).ЭтоИстина();       // не с буквы/цифры
	Ожидаем.Что(ЛогинНевалиден(Норм, "good.name-1")).ЭтоЛожь();

	Ожидаем.Что(Норм.НормализоватьEmail("")).Равно("");
	Ожидаем.Что(Норм.НормализоватьEmail(" A@B.COM ")).Равно("a@b.com");
	Ожидаем.Что(EmailНевалиден(Норм, "no-at")).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УникальностьАдресаПочты

// Уникальность держит сервисный слой, а не база: авто-DDL entity UNIQUE не создаёт,
// и на файловом бэкенде дубль прошёл бы молча.
&Тест
Процедура ВтораяУчёткаНаЗанятыйАдресНеЗаводится() Экспорт

	СП = Желудь("СервисПользователей");
	Адрес = УникальныйАдрес();
	СП.СоздатьПользователя(УникальныйЛогин(), Адрес, "password123", "user");

	ВторойЛогин = УникальныйЛогин();
	Отказ = ОтказСоздания(СП, ВторойЛогин, Адрес);

	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "вторая учётка на тот же адрес не заведена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "email_taken") > 0, "отказ назвал причину: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СП.НайтиПоЛогину(ВторойЛогин) = Неопределено, "дубля в базе нет").ЭтоИстина();

КонецПроцедуры

// Регистр и краевые пробелы занятости не обходят: сравнение идёт по нормализованному
// адресу, а не по тому, как его набрали.
&Тест
Процедура РегистрИПробелыЗанятостьНеОбходят() Экспорт

	СП = Желудь("СервисПользователей");
	Адрес = УникальныйАдрес();
	СП.СоздатьПользователя(УникальныйЛогин(), Адрес, "password123", "user");

	Ожидаем.Что(ЗначениеЗаполнено(ОтказСоздания(СП, УникальныйЛогин(), ВРег(Адрес))),
		"верхний регистр — тот же адрес").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(ОтказСоздания(СП, УникальныйЛогин(), "  " + Адрес + "  ")),
		"краевые пробелы — тот же адрес").ЭтоИстина();

КонецПроцедуры

// Учёток без почты бывает сколько угодно: пустой адрес занятым не считается.
&Тест
Процедура ПустойАдресЗанятымНеСчитается() Экспорт

	СП = Желудь("СервисПользователей");
	Первый = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Второй = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Ожидаем.Что(Первый.Идентификатор > 0, "первая учётка без почты заведена").ЭтоИстина();
	Ожидаем.Что(Второй.Идентификатор > 0, "и вторая тоже").ЭтоИстина();
	Ожидаем.Что(Адреса().Занят(""), "пустой адрес не занят").ЭтоЛожь();

КонецПроцедуры

// Отказ приходит ДО записи: чужой адрес в учётку не попадает и флаг подтверждения
// не сбрасывается — то есть и письма подтверждения на него хаб не шлёт.
&Тест
Процедура СменаАдресаНаЗанятыйОтвергаетсяДоЗаписи() Экспорт

	СП = Желудь("СервисПользователей");
	Чужой = УникальныйАдрес();
	СП.СоздатьПользователя(УникальныйЛогин(), Чужой, "password123", "user");

	Свой = УникальныйАдрес();
	Мой = СП.СоздатьПользователя(УникальныйЛогин(), Свой, "password123", "user");
	Адреса().Подтвердить(Мой, Истина);

	Отказ = ОтказСменыАдреса(СП, Мой, Чужой);
	Ожидаем.Что(СтрНайти(Отказ, "email_taken") > 0, "смена отвергнута: " + Отказ).ЭтоИстина();

	Перечитанный = СП.ПоИдентификатору(Мой.Идентификатор);
	Ожидаем.Что(Перечитанный.Email, "адрес в базе прежний").Равно(Свой);
	Ожидаем.Что(Перечитанный.EmailПодтверждён = Истина, "и подтверждение не снято").ЭтоИстина();

КонецПроцедуры

// Свой собственный адрес занятым для себя не считается — иначе сохранить форму профиля
// без правки адреса было бы нельзя.
&Тест
Процедура СвойАдресДляСебяНеЗанят() Экспорт

	СП = Желудь("СервисПользователей");
	Адрес = УникальныйАдрес();
	Мой = СП.СоздатьПользователя(УникальныйЛогин(), Адрес, "password123", "user");

	Ожидаем.Что(Адреса().Занят(Адрес, Мой.Идентификатор), "свой адрес не занят собой").ЭтоЛожь();
	Ожидаем.Что(Адреса().Занят(Адрес), "а без исключения — занят").ЭтоИстина();

	Адреса().Сменить(Мой, ВРег(Адрес));
	Ожидаем.Что(СП.ПоИдентификатору(Мой.Идентификатор).Email, "адрес остался своим").Равно(Адрес);

КонецПроцедуры

// Отказ не превращается в разведку: занятость сообщается, чужой логин — никогда.
&Тест
Процедура ОтказНеНазываетЧужуюУчётку() Экспорт

	СП = Желудь("СервисПользователей");
	Адрес = УникальныйАдрес();
	ЧужойЛогин = УникальныйЛогин();
	СП.СоздатьПользователя(ЧужойЛогин, Адрес, "password123", "user");

	Отказ = ОтказСоздания(СП, УникальныйЛогин(), Адрес);
	Ожидаем.Что(СтрНайти(НРег(Отказ), НРег(ЧужойЛогин)), "чужой логин в отказе не назван")
		.Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Отказ), НРег(Адрес)), "и чужой адрес тоже не пересказан")
		.Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ВходИRateLimit

&Тест
Процедура ВходУспешенИСоздаётСессию() Экспорт

	СП = Желудь("СервисПользователей");
	СА = Желудь("СервисАутентификации");
	Логин = УникальныйЛогин();
	СП.СоздатьПользователя(Логин, "", "password123", "user");

	Результат = СА.ВойтиПоПаролю(ВРег(Логин), "password123", "10.0.0.1");
	Ожидаем.Что(Результат.Успех).ЭтоИстина();
	Ожидаем.Что(СтрДлина(Результат.Сессия.Идентификатор())).Равно(64);

КонецПроцедуры

&Тест
Процедура ВходСНевернымПаролемОтклоняется() Экспорт

	СП = Желудь("СервисПользователей");
	СА = Желудь("СервисАутентификации");
	Логин = УникальныйЛогин();
	СП.СоздатьПользователя(Логин, "", "password123", "user");

	Результат = СА.ВойтиПоПаролю(Логин, "неверный", "10.0.0.2");
	Ожидаем.Что(Результат.Успех).ЭтоЛожь();
	Ожидаем.Что(Результат.Причина).Равно("invalid_credentials");
	Ожидаем.Что(Результат.Сессия).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура RateLimitБлокируетПослеПорогаИСбрасываетсяПоОкну() Экспорт

	Лимитер = Новый ОграничительВхода(НастройкиВхода(3, 60));
	Ключ = "login:тест";
	Старт = Дата(2026, 7, 24, 12, 0, 0);

	Ожидаем.Что(Лимитер.РазрешёнЛи(Ключ, Старт)).ЭтоИстина();
	Лимитер.ЗафиксироватьНеудачу(Ключ, Старт);
	Лимитер.ЗафиксироватьНеудачу(Ключ, Старт);
	Ожидаем.Что(Лимитер.РазрешёнЛи(Ключ, Старт)).ЭтоИстина(); // 2 < 3
	Лимитер.ЗафиксироватьНеудачу(Ключ, Старт);
	Ожидаем.Что(Лимитер.РазрешёнЛи(Ключ, Старт)).ЭтоЛожь();   // порог достигнут

	Ожидаем.Что(Лимитер.РазрешёнЛи(Ключ, Старт + 30)).ЭтоЛожь();
	Ожидаем.Что(Лимитер.РазрешёнЛи(Ключ, Старт + 61)).ЭтоИстина();

	Лимитер.Сбросить(Ключ);
	Ожидаем.Что(Лимитер.ОставшихсяПопыток(Ключ, Старт)).Равно(3);

КонецПроцедуры

&Тест
Процедура RateLimitСрабатываетВСервисеАутентификации() Экспорт

	СП = Желудь("СервисПользователей");
	Логин = УникальныйЛогин();
	СП.СоздатьПользователя(Логин, "", "password123", "user");

	СлСес = Желудь("СлужбаСессий");
	Лимитер = Новый ОграничительВхода(НастройкиВхода(2, 300));
	СА = Новый СервисАутентификации(СП, СлСес, Лимитер,
		Новый ПолитикаПарольногоВхода(НастройкиВхода(2, 300)),
		Желудь("ГейтПодтвержденияАдреса"), Желудь("ИмяОбъектаАудита"),
		Неопределено, ЛогТестов());
	IP = "192.168.0.5";
	Момент = Дата(2026, 7, 24, 12, 0, 0);

	СА.ВойтиПоПаролю(Логин, "bad", IP, Момент);
	СА.ВойтиПоПаролю(Логин, "bad", IP, Момент);
	Р = СА.ВойтиПоПаролю(Логин, "password123", IP, Момент);
	Ожидаем.Что(Р.Успех).ЭтоЛожь();
	Ожидаем.Что(Р.Причина).Равно("rate_limited");

КонецПроцедуры

// Сервис, собранный КОНТЕЙНЕРОМ, а не тестом: сеть на весь путь события — от учётки
// до строки файла журнала. Замок обязан называть учётку логином; «пользователь#<ид>»
// здесь означает, что запись собрана мимо форматтера или форматтером без хранилищ.
// Резолва по идентификатору сам auth не делает — эту сторону закрывает второе ожидание.
&Тест
Процедура ЗамокИзКонтейнераНазываетУчёткуЛогиномАНеНомером() Экспорт

	Логин = УникальныйЛогин();
	Пользователь = Желудь("СервисПользователей").СоздатьПользователя(Логин, "", "password123", "admin");
	СА = Желудь("СервисАутентификации");
	Момент = Дата(2026, 7, 24, 12, 0, 0);

	// порог по умолчанию — пять попыток подряд
	Для Попытка_ = 1 По 5 Цикл
		СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.77", Момент);
	КонецЦикла;

	Записи = ЗаписиЖурнала("пользователь/" + Логин);
	Ожидаем.Что(Записи.Количество(), "замок записан в журнал").Равно(1);
	Ожидаем.Что(Строка(Записи[0].Действие), "действие").Равно("вход.заблокирован");
	Ожидаем.Что(Строка(Записи[0].Объект), "объект — логин, а не пользователь#<ид>")
		.Равно("пользователь/" + Логин);
	Ожидаем.Что(Строка(Записи[0].Субъект), "кого заперли — тоже логином")
		.Равно("пользователь/" + Логин);
	Ожидаем.Что(ЗаписиЖурнала("пользователь#" + Пользователь.Идентификатор).Количество(),
		"записи с номером вместо логина в журнале нет").Равно(0);

	// желудь форматтера отличается от «Новый ИмяОбъектаАудита()» ровно тем, что резолвит
	// идентификаторы: без внедрённых хранилищ этот адрес был бы «пользователь#<ид>»
	Ожидаем.Что(Желудь("ИмяОбъектаАудита").Субъект("пользователь", Пользователь.Идентификатор),
		"форматтер из контейнера резолвит учётку по идентификатору")
		.Равно("пользователь/" + Логин);

КонецПроцедуры

// Подобранная учётка админа — это отъём власти над инсталляцией; путь обязан быть виден
// в журнале. Пишется ФАКТ замка, а не каждая попытка: журнал аудита не лог доступа.
&Тест
Процедура ЗамокУчёткиПишетОднуЗаписьЖурналаСЧисломПопыток() Экспорт

	Логин = УникальныйЛогин();
	Желудь("СервисПользователей").СоздатьПользователя(Логин, "", "password123", "admin");
	СА = АутентификацияСЖурналом(3, 300);
	Момент = Дата(2026, 7, 24, 12, 0, 0);

	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.9", Момент);
	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.9", Момент);
	Ожидаем.Что(ЗаписиЖурнала("пользователь/" + Логин).Количество(), "до порога журнал молчит").Равно(0);

	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.9", Момент);
	Записи = ЗаписиЖурнала("пользователь/" + Логин);

	Ожидаем.Что(Записи.Количество(), "замок — ровно одна запись, а не запись на попытку").Равно(1);
	Ожидаем.Что(Строка(Записи[0].Действие), "действие журнала").Равно("вход.заблокирован");
	Ожидаем.Что(Строка(Записи[0].Объект), "объект — учётка, а не номер").Равно("пользователь/" + Логин);
	Ожидаем.Что(Строка(Записи[0].Субъект), "кого заперли").Равно("пользователь/" + Логин);
	Ожидаем.Что(Строка(Записи[0].АдресIP), "адрес подбиравшего").Равно("198.51.100.9");
	Ожидаем.Что(СтрНайти(Строка(Записи[0].Детали), "3") > 0, "число попыток в деталях").ЭтоИстина();

	// четвёртая попытка уже отбита лимитом и новой записи не добавляет
	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.9", Момент);
	Ожидаем.Что(ЗаписиЖурнала("пользователь/" + Логин).Количество(), "запертая учётка журнал не растит").Равно(1);

КонецПроцедуры

&Тест
Процедура ПереборЛогиновВиденЖурналуКакЗамокАдреса() Экспорт

	// Перебор логинов и распыление паролей — самые частые атаки на хаб. Учётки нет,
	// запирать нечего, но ИСТОЧНИК заперт, и запись обязана назвать, сколько попыток
	// пришлось на несуществующие логины: строк по числу логинов при этом не заводится.
	Адрес = "198.51.100.10";
	СА = АутентификацияСЖурналом(4, 300);
	Момент = Дата(2026, 7, 24, 12, 0, 0);

	Логины = Новый Массив();
	Для Счёт = 1 По 4 Цикл
		Логины.Добавить(УникальныйЛогин());
	КонецЦикла;
	Для Каждого Чужой Из Логины Цикл
		СА.ВойтиПоПаролю(Чужой, "bad", Адрес, Момент);
	КонецЦикла;

	Для Каждого Чужой Из Логины Цикл
		Ожидаем.Что(ЗаписиЖурнала("пользователь/" + Чужой).Количество(),
			"учётки нет — строки по логину не заводится").Равно(0);
	КонецЦикла;

	ПоАдресу = ЗаписиЖурнала("адрес/" + Адрес);
	Ожидаем.Что(ПоАдресу.Количество(), "замок источника — ровно одна запись").Равно(1);
	Ожидаем.Что(Строка(ПоАдресу[0].Действие), "действие").Равно("вход.заблокирован");
	Ожидаем.Что(Строка(ПоАдресу[0].Субъект), "у замка источника адресата нет").Равно("");
	// именно ЧИСЛО: наличие ключа ещё не значит, что агрегат считается
	Ожидаем.Что(СтрНайти(Строка(ПоАдресу[0].Детали), """несуществующих_логинов"": 4") > 0,
		"агрегат перебора логинов посчитан: " + Строка(ПоАдресу[0].Детали)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(ПоАдресу[0].Детали), "заперт_до") > 0,
		"запись самоописывающая: несёт срок замка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗаписьЗамкаНесётСрокАНеОбещаетПарности() Экспорт

	// Замок истекает сам, а лимитер живёт в памяти процесса: отсутствие записи о снятии
	// не значит «всё ещё заперт». Поэтому «когда закрылся» отвечает срок в самой записи.
	Логин = УникальныйЛогин();
	Желудь("СервисПользователей").СоздатьПользователя(Логин, "", "password123", "user");
	СА = АутентификацияСЖурналом(2, 60);
	Момент = Дата(2026, 7, 24, 12, 0, 0);

	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.12", Момент);
	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.12", Момент);

	Замок = ЗаписиЖурнала("пользователь/" + Логин)[0];
	Ожидаем.Что(СтрНайти(Строка(Замок.Детали), "заперт_до") > 0,
		"срок замка в деталях: " + Строка(Замок.Детали)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Замок.Детали), "2026-07-24T12:01:00Z") > 0,
		"срок посчитан от момента замка и длины блокировки: " + Строка(Замок.Детали)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПониженныйПорогНеРождаетСнятиеЗамкаКоторогоНеБыло() Экспорт

	// Порог читается из настроек на каждом вызове. Сравнение «неудач >= порога» на входе
	// записывало снятие замка, если админ понизил порог между неудачей и входом.
	Логин = УникальныйЛогин();
	Желудь("СервисПользователей").СоздатьПользователя(Логин, "", "password123", "user");
	Настройки = НастройкиВхода(5, 60);
	Лимитер = Новый ОграничительВхода(Настройки);
	СА = Новый СервисАутентификации(Желудь("СервисПользователей"), Желудь("СлужбаСессий"),
		Лимитер, Новый ПолитикаПарольногоВхода(Настройки),
		Желудь("ГейтПодтвержденияАдреса"), Желудь("ИмяОбъектаАудита"),
		Желудь("ИздательСобытий"), ЛогТестов());
	Момент = Дата(2026, 7, 24, 12, 0, 0);

	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.13", Момент);
	Ожидаем.Что(ДействияЖурнала("пользователь/" + Логин), "до порога журнал молчит").Равно("");

	// админ понизил порог: одной записанной неудачи стало «достаточно» для порога
	Настройки.ЗадатьВход(1, 60);
	Ожидаем.Что(СА.ВойтиПоПаролю(Логин, "password123", "198.51.100.13", Момент).Успех,
		"вход проходит").ЭтоИстина();

	Ожидаем.Что(ДействияЖурнала("пользователь/" + Логин),
		"замка не было — снятия в журнале тоже нет").Равно("");

КонецПроцедуры

&Тест
Процедура СнятиеЗамкаПишетсяПарнойЗаписью() Экспорт

	Логин = УникальныйЛогин();
	Желудь("СервисПользователей").СоздатьПользователя(Логин, "", "password123", "user");
	СА = АутентификацияСЖурналом(2, 60);
	Момент = Дата(2026, 7, 24, 12, 0, 0);

	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.11", Момент);
	СА.ВойтиПоПаролю(Логин, "bad", "198.51.100.11", Момент);
	Ожидаем.Что(ДействияЖурнала("пользователь/" + Логин), "замок записан").Равно("вход.заблокирован");

	// удачный вход САМ ПО СЕБЕ в журнал не идёт — иначе это лог доступа, а не аудит
	Успех = СА.ВойтиПоПаролю(Логин, "password123", "198.51.100.11", Момент + 61);
	Ожидаем.Что(Успех.Успех, "после истечения срока вход проходит").ЭтоИстина();
	Ожидаем.Что(ДействияЖурнала("пользователь/" + Логин), "снятие замка — парная запись").Равно(
		"вход.разблокирован,вход.заблокирован");

	СА.ВойтиПоПаролю(Логин, "password123", "198.51.100.11", Момент + 62);
	Ожидаем.Что(ДействияЖурнала("пользователь/" + Логин), "обычный удачный вход журнал не растит").Равно(
		"вход.разблокирован,вход.заблокирован");

КонецПроцедуры

#КонецОбласти

#Область Токены

&Тест
Процедура ВыпускПроверкаОтзывТокена() Экспорт

	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Пользователь = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Выпуск = СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read,write", 30, 0);
	Ожидаем.Что(СтрНачинаетсяС(Выпуск.ЗначениеТокена, "oshub_")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Выпуск.Запись.Хеш, Выпуск.ЗначениеТокена)).Равно(0);

	Проверка = СТ.РезультатПроверки(Выпуск.ЗначениеТокена).Проверка;
	Ожидаем.Что(Проверка).Существует();
	Ожидаем.Что(Проверка.ПользовательИдентификатор).Равно(Пользователь.Идентификатор);
	Ожидаем.Что(СТ.ПраваСодержат(Проверка.Права, "write")).ЭтоИстина();

	Ожидаем.Что(СТ.РезультатПроверки("мусор").Проверка).Равно(Неопределено);
	Ожидаем.Что(СТ.РезультатПроверки("oshub_999999_deadbeef").Проверка).Равно(Неопределено);

	Ожидаем.Что(СТ.Отозвать(Пользователь.Идентификатор, Выпуск.Запись.Идентификатор)).ЭтоИстина();
	Ожидаем.Что(СТ.РезультатПроверки(Выпуск.ЗначениеТокена).Проверка).Равно(Неопределено);

КонецПроцедуры

// Хеш записи пуст между двумя её сохранениями при выпуске: такой ключ не проходит.
// Отказ даёт сравнение длин — пустому хешу противостоит 64-символьный sha256; то, что
// ключи судит то же правило, что и одноразовые ссылки, проверяется вызовом рядом.
&Тест
Процедура ЗаписьКлючаБезХешаНеПропускаетНикого() Экспорт

	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Пользователь = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Выпуск = СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read", 30, 0);
	Выпуск.Запись.Хеш = "";
	Выпуск.Запись.Сохранить();

	Ожидаем.Что(СТ.РезультатПроверки(Выпуск.ЗначениеТокена).Проверка,
		"ключ без записанного хеша не проходит даже своим значением").Равно(Неопределено);
	Ожидаем.Что(Желудь("СверкаСекретов").Совпадают("", ""),
		"и правило сверки у ключей то же, что у одноразовых ссылок").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПросроченныйТокенНеПроходит() Экспорт

	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Пользователь = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Выпуск = СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read", 1, 0); // срок 1 день
	Ожидаем.Что(СТ.РезультатПроверки(Выпуск.ЗначениеТокена, ТекущаяУниверсальнаяДата()).Проверка).Существует();
	ПослеИстечения = ТекущаяУниверсальнаяДата() + 2 * 86400;
	Ожидаем.Что(СТ.РезультатПроверки(Выпуск.ЗначениеТокена, ПослеИстечения).Проверка).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура БессрочныйТокенНеВыпускаетсяВовсе() Экспорт

	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Пользователь = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	ОтказНоль = ОтказВыпуска(СТ, Пользователь.Идентификатор, 0);
	ОтказМинус = ОтказВыпуска(СТ, Пользователь.Идентификатор, -1);

	ОтказПропуска = "";
	Попытка
		СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read");
	Исключение
		ОтказПропуска = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ОтказНоль, "Бессрочные токены не выпускаются") > 0,
		"ноль больше не значит «вечно» (" + ОтказНоль + ")").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(ОтказМинус), "отрицательный срок — тоже отказ").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(ОтказПропуска),
		"забытый аргумент срока не выпускает вечный ключ молча").ЭтоИстина();
	Ожидаем.Что(СТ.ТокеныПользователя(Пользователь.Идентификатор).Количество(),
		"ни одна отвергнутая попытка не оставила записи").Равно(0);

КонецПроцедуры

&Тест
Процедура СрокБольшеПотолкаОтвергается() Экспорт

	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Пользователь = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Потолок = СТ.ПотолокСрокаДней();

	Отказ = ОтказВыпуска(СТ, Пользователь.Идентификатор, Потолок + 1);

	Ожидаем.Что(СтрНайти(Отказ, "больше потолка") > 0,
		"причина отказа названа (" + Отказ + ")").ЭтоИстина();

	НаПотолке = СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read", Потолок, 0);
	Ожидаем.Что(СТ.РезультатПроверки(НаПотолке.ЗначениеТокена).Проверка, "ровно потолок выпускается").Существует();
	Ожидаем.Что(СТ.ТокеныПользователя(Пользователь.Идентификатор).Количество(),
		"сверхпотолочный токен не завёлся").Равно(1);

КонецПроцедуры

&Тест
Процедура СрокиТокеновБерутсяИзНастроекХаба() Экспорт

	СТ = Желудь("СервисТокенов");
	Настройки = Желудь("СервисНастроек");

	Ожидаем.Что(СТ.СрокПоУмолчаниюДней(), "дефолт хаба — неделя").Равно(7);
	Ожидаем.Что(СТ.ПотолокСрокаДней(), "потолок хаба — год").Равно(365);

	// Срок токена выбирает администратор, потолок срока — число инсталляции
	// (ИСТ-НАСТ-012), поэтому правится тут только первый.
	Попытка
		Настройки.Установить("oshub.auth.token.cli_days", 3, "тест");
		Ожидаем.Что(СТ.СрокПоУмолчаниюДней(), "срок opm login правится настройкой").Равно(3);

		// несогласованная пара не выпускает ключ длиннее потолка инсталляции
		Настройки.Установить("oshub.auth.token.cli_days", 4000, "тест");
		Ожидаем.Что(СТ.СрокПоУмолчаниюДней(), "срок по умолчанию потолок не перешагивает").Равно(365);
	Исключение
		Настройки.Сбросить("oshub.auth.token.cli_days", "тест");
		ВызватьИсключение;
	КонецПопытки;

	Настройки.Сбросить("oshub.auth.token.cli_days", "тест");
	Ожидаем.Что(СТ.СрокПоУмолчаниюДней(), "после сброса снова дефолт").Равно(7);

КонецПроцедуры

&Тест
Процедура ПросроченныйКлючНеПускаетВAPI() Экспорт

	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Перехватчик = Желудь("ПерехватчикАутентификации");
	Пользователь = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Выпуск = СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read,write", 2, 0, "ключ на два дня");
	Заголовки = ЗаголовкиСТокеном(Выпуск.ЗначениеТокена);

	ПокаЖивой = Перехватчик.ОпределитьПринципала(Заголовки, Неопределено,
		ТекущаяУниверсальнаяДата() + 86400);
	ПослеСрока = Перехватчик.ОпределитьПринципала(Заголовки, Неопределено,
		ТекущаяУниверсальнаяДата() + 3 * 86400);

	// граница включительно: в саму секунду истечения дверь уже закрыта
	Истекает = Выпуск.Запись.Истекает;
	ЗаСекундуДо = Перехватчик.ОпределитьПринципала(Заголовки, Неопределено, Истекает - 1);
	ВМоментИстечения = Перехватчик.ОпределитьПринципала(Заголовки, Неопределено, Истекает);

	Ожидаем.Что(ПокаЖивой.Пользователь, "до срока ключ пускает").Существует();
	Ожидаем.Что(ПослеСрока.Пользователь, "после срока дверь API закрыта").Равно(Неопределено);
	Ожидаем.Что(ПослеСрока.Способ, "просроченный ключ — аноним, а не «token»").Равно("");
	Ожидаем.Что(ЗаСекундуДо.Пользователь, "за секунду до истечения ключ ещё пускает").Существует();
	Ожидаем.Что(ВМоментИстечения.Пользователь, "в момент истечения ключ уже мёртв")
		.Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЧужойТокенНеОтзывается() Экспорт

	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Владелец = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Чужой = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Выпуск = СТ.ВыпуститьТокен(Владелец.Идентификатор, "read", 30, 0);

	Ожидаем.Что(СТ.Отозвать(Чужой.Идентификатор, Выпуск.Запись.Идентификатор)).ЭтоЛожь();
	Ожидаем.Что(СТ.РезультатПроверки(Выпуск.ЗначениеТокена).Проверка).Существует();

КонецПроцедуры

&Тест
Процедура ГейтТокенаЭнфорситСкоупы() Экспорт

	Гейт = Желудь("ГейтТокена");

	ТолькоЧтение = Принципал("token", "read", 0);
	Полный = Принципал("token", "read,write", 0);

	Ожидаем.Что(Гейт.Проверить(ТолькоЧтение, "чтение", 5).Разрешено, "read читает").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(ТолькоЧтение, "создание", 5).Разрешено, "read не создаёт").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(ТолькоЧтение, "изменение", 5).Разрешено, "read не изменяет").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(ТолькоЧтение, "удаление", 5).Разрешено, "read не удаляет").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(ТолькоЧтение, "создание", 5).Причина, "причина отказа — скоуп").Равно("скоуп");
	Ожидаем.Что(Гейт.Проверить(Полный, "создание", 5).Разрешено, "write создаёт").ЭтоИстина();

	Ожидаем.Что(Гейт.Проверить(Принципал("token", "write", 0), "чтение", 5).Разрешено,
		"write без read не читает").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(Принципал("token", "", 0), "чтение", 5).Разрешено,
		"пустые скоупы — отказ").ЭтоЛожь();

	Ожидаем.Что(Гейт.Проверить(Принципал("session", "", 0), "удаление", 5).Разрешено, "сессия прозрачна").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Неопределено, "удаление", 5).Разрешено, "нет принципала — гейт прозрачен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГейтТокенаЭнфорситПривязкуКПулу() Экспорт

	Гейт = Желудь("ГейтТокена");
	Привязанный = Принципал("token", "read,write", 7);

	Ожидаем.Что(Гейт.Проверить(Привязанный, "создание", 7).Разрешено, "свой пул").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Привязанный, "чтение", 8).Разрешено, "чужой пул — отказ").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(Привязанный, "чтение", 8).Причина, "причина — привязка").Равно("привязка");
	Ожидаем.Что(Гейт.Проверить(Привязанный, "создание", 0).Разрешено, "хаб-уровень закрыт").ЭтоЛожь();

	Свободный = Принципал("token", "read,write", 0);
	Ожидаем.Что(Гейт.Проверить(Свободный, "чтение", 8).Разрешено, "непривязанный читает любой").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Свободный, "создание", 0).Разрешено, "и хаб-уровень").ЭтоИстина();

КонецПроцедуры

// Рамка ключа — НАБОР пулов, а не один пул: гейт судит по множеству целиком.
&Тест
Процедура ГейтТокенаЭнфорситНаборПулов() Экспорт

	Гейт = Желудь("ГейтТокена");
	Двухпуловый = ПринципалНабора("token", "read,write", ДваПула(4, 9));

	Ожидаем.Что(Гейт.Проверить(Двухпуловый, "создание", 4).Разрешено, "первый пул набора").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Двухпуловый, "создание", 9).Разрешено,
		"второй пул набора — набор судится целиком, а не первым элементом").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Двухпуловый, "чтение", 5).Разрешено, "пул вне набора — отказ").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(Двухпуловый, "чтение", 5).Причина, "причина — привязка").Равно("привязка");
	Ожидаем.Что(Гейт.Проверить(Двухпуловый, "создание", 0).Разрешено,
		"хаб-уровень закрыт набору так же, как одиночной привязке").ЭтоЛожь();

	// пустой набор — это «весь хаб», а не «ничего нельзя»: иначе непривязанный ключ умер бы
	Пустой = ПринципалНабора("token", "read", Новый Массив());
	Ожидаем.Что(Гейт.Проверить(Пустой, "чтение", 5).Разрешено, "пустой набор — весь хаб").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Пустой, "чтение", 0).Разрешено, "и хаб-уровень").ЭтоИстина();

	// скоуп судится РАНЬШЕ рамок: ключ на чтение не пишет даже в свой пул
	Читающий = ПринципалНабора("token", "read", ДваПула(4, 9));
	Ожидаем.Что(Гейт.Проверить(Читающий, "изменение", 4).Разрешено, "read не пишет в свой пул").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(Читающий, "изменение", 4).Причина, "и причина — скоуп").Равно("скоуп");

КонецПроцедуры

// Ключи, выпущенные до появления набора, судятся как набор из одного пула: у них
// заполнено старое поле записи, строк набора нет вовсе.
&Тест
Процедура ЛегасиОдиночнаяПривязкаРаботаетКакНаборИзОдногоПула() Экспорт

	Гейт = Желудь("ГейтТокена");
	Легаси = Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Неопределено, "token", "read,write", 7, Неопределено);

	Ожидаем.Что(Гейт.Проверить(Легаси, "создание", 7).Разрешено,
		"принципал БЕЗ поля набора судится по старой привязке").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(Легаси, "чтение", 8).Разрешено, "и чужой пул ему закрыт").ЭтоЛожь();
	Ожидаем.Что(Гейт.Проверить(Легаси, "создание", 0).Разрешено, "и хаб-уровень тоже").ЭтоЛожь();

	// та же запись с пустым набором рядом: одно другому не противоречит
	СПустымНабором = ПринципалНабора("token", "read,write", Новый Массив());
	СПустымНабором.Вставить("ПулИдентификатор", 7);
	Ожидаем.Что(Гейт.Проверить(СПустымНабором, "создание", 7).Разрешено,
		"старое поле читается и при наличии поля набора").ЭтоИстина();
	Ожидаем.Что(Гейт.Проверить(СПустымНабором, "чтение", 8).Разрешено, "чужой пул закрыт").ЭтоЛожь();

КонецПроцедуры

// Набор доезжает от выпуска до проверки: сервис пишет строки привязок, проверка их читает,
// а отзыв уносит вместе с ключом.
&Тест
Процедура ВыпущенныйСНаборомТокенОтдаётЕгоПриПроверке() Экспорт

	СТ = Желудь("СервисТокенов");
	СП = Желудь("СервисПользователей");
	Владелец = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Выпуск = СТ.ВыпуститьТокен(Владелец.Идентификатор, "read", 30, 0, "набор", ДваПула(11, 12));

	Пулы = СТ.ПулыТокена(Выпуск.Запись);
	Ожидаем.Что(Пулы.Количество(), "записаны обе привязки").Равно(2);
	Ожидаем.Что(Пулы.Найти(11) <> Неопределено, "первая привязка").ЭтоИстина();
	Ожидаем.Что(Пулы.Найти(12) <> Неопределено, "вторая привязка").ЭтоИстина();

	Проверка = СТ.РезультатПроверки(Выпуск.ЗначениеТокена).Проверка;
	Ожидаем.Что(Проверка.Пулы.Количество(), "проверка отдаёт набор целиком").Равно(2);

	// принципал перехватчика несёт тот же набор — гейт судит именно по нему
	Принципал_ = Желудь("ПерехватчикАутентификации").ОпределитьПринципала(
		ЗаголовкиСТокеном(Выпуск.ЗначениеТокена), Неопределено);
	Ожидаем.Что(Принципал_.Пулы.Количество(), "принципал несёт набор").Равно(2);
	Ожидаем.Что(Желудь("ГейтТокена").Проверить(Принципал_, "чтение", 12).Разрешено,
		"и гейт пускает во второй пул набора").ЭтоИстина();
	Ожидаем.Что(Желудь("ГейтТокена").Проверить(Принципал_, "чтение", 13).Разрешено,
		"а в чужой не пускает").ЭтоЛожь();

	// отзыв уносит привязки: строка без токена досталась бы следующему с тем же номером
	Ид = Выпуск.Запись.Идентификатор;
	Ожидаем.Что(СТ.Отозвать(Владелец.Идентификатор, Ид), "ключ отозван").ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеПривязокТокенов").ПривязкиТокена(Ид).Количество(),
		"привязки отозванного ключа сняты").Равно(0);

КонецПроцедуры

// Ключ, выпущенный до появления набора, несёт единственную рамку КОЛОНКОЙ записи, строк
// привязок у него нет вовсе. Обе двери сервиса — поштучная и списком — обязаны эту рамку
// видеть: потерянная доливка печатает старому ключу в кабинете «весь хаб» вместо имени пула
// и раздаёт ему весь хаб на проверке.
&Тест
Процедура СтараяОдиночнаяПривязкаВиднаИПоштучноИСписком() Экспорт

	СТ = Желудь("СервисТокенов");
	СП = Желудь("СервисПользователей");
	Владелец = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Старый = СТ.ВыпуститьТокен(Владелец.Идентификатор, "read", 30, 31, "легаси").Запись;
	Ожидаем.Что(Желудь("ХранилищеПривязокТокенов").ПривязкиТокена(Старый.Идентификатор).Количество(),
		"строк набора у старого ключа нет").Равно(0);

	Поштучно = СТ.ПулыТокена(Старый);
	Ожидаем.Что(Поштучно.Количество(), "поштучная дверь видит рамку из колонки").Равно(1);
	Ожидаем.Что(Поштучно[0], "и это пул старой привязки").Равно(31);

	Списком = СТ.НаборыПулов(Записями(Старый)).Получить(Цел(Старый.Идентификатор));
	Ожидаем.Что(Списком.Количество(), "дверь «списком» видит ту же рамку").Равно(1);
	Ожидаем.Что(Списком[0], "и это тот же пул").Равно(31);

	// старый ключ рядом с современным в ОДНОМ списке: ни один не берёт рамки другого
	Современный = СТ.ВыпуститьТокен(Владелец.Идентификатор, "read", 30, 0, "набор",
		ДваПула(41, 42)).Запись;
	Наборы = СТ.НаборыПулов(Записями(Старый, Современный));

	Ожидаем.Что(Наборы.Получить(Цел(Старый.Идентификатор)).Количество(),
		"старый ключ в общем списке не потерял свою рамку").Равно(1);
	Ожидаем.Что(Наборы.Получить(Цел(Современный.Идентификатор)).Количество(),
		"а современный отдаёт свой набор целиком").Равно(2);

КонецПроцедуры

// Дубль и ноль в наборе — не рамки: ноль означает «весь хаб», а повтор сделал бы одно
// ограничение двумя.
&Тест
Процедура НаборПуловТокенаЧиститсяОтНуляИПовторов() Экспорт

	СТ = Желудь("СервисТокенов");
	СП = Желудь("СервисПользователей");
	Владелец = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Заявленные = Новый Массив();
	Заявленные.Добавить(21);
	Заявленные.Добавить(21);
	Заявленные.Добавить(0);

	Выпуск = СТ.ВыпуститьТокен(Владелец.Идентификатор, "read", 30, 0, "повторы", Заявленные);
	Пулы = СТ.ПулыТокена(Выпуск.Запись);

	Ожидаем.Что(Пулы.Количество(), "повтор и ноль в набор не попали").Равно(1);
	Ожидаем.Что(Пулы[0]).Равно(21);

КонецПроцедуры

&Тест
Процедура ГвардДоступаКПулуЗакрываетПулКлючомБезСкоупа() Экспорт

	Гвард = Желудь("ГвардДоступаКПулу");
	Пулы = Желудь("СервисПулов");
	Пул = Пулы.СоздатьПул(УникальныйЛогин(), "custom", "public");

	Ожидаем.Что(Гвард.ЧитаемыйПул(Неопределено, Пул.Имя), "без ключа публичный читается").Существует();
	Ожидаем.Что(Гвард.ЧитаемыйПул(Неопределено, Пул.Имя, Принципал("token", "read", 0)),
		"ключ со скоупом read читает").Существует();
	Ожидаем.Что(Гвард.ЧитаемыйПул(Неопределено, Пул.Имя, Принципал("token", "write", 0)),
		"ключ без скоупа read не читает").Равно(Неопределено);
	Ожидаем.Что(Гвард.ЧитаемыйПул(Неопределено, Пул.Имя, Принципал("token", "read", Пул.Идентификатор + 1)),
		"ключ чужого пула не читает").Равно(Неопределено);
	Ожидаем.Что(Гвард.ЧитаемыйПул(Неопределено, Пул.Имя, Принципал("token", "read", Пул.Идентификатор)),
		"ключ своего пула читает").Существует();

КонецПроцедуры

&Тест
Процедура ГвардПроверитьЭнфорситКлючНаПоверхностиВыдачи() Экспорт

	Гвард = Желудь("ГвардДоступаКПулу");
	СП = Желудь("СервисПользователей");
	СТ = Желудь("СервисТокенов");
	Пулы = Желудь("СервисПулов");

	Владелец = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "admin");
	Пул = Пулы.СоздатьПул(УникальныйЛогин(), "custom", "private");

	ЧитающийТокен = СТ.ВыпуститьТокен(Владелец.Идентификатор, "read", 30, 0).ЗначениеТокена;
	ПишущийТокен = СТ.ВыпуститьТокен(Владелец.Идентификатор, "write", 30, 0).ЗначениеТокена;
	ЧужойПулТокен = СТ.ВыпуститьТокен(Владелец.Идентификатор, "read", 30, Пул.Идентификатор + 1000).ЗначениеТокена;

	Ожидаем.Что(Гвард.Проверить(ЗаголовкиСТокеном(ЧитающийТокен), Неопределено, Пул.Имя).Разрешено,
		"ключ со скоупом read читает приватный пул владельца").ЭтоИстина();
	Ожидаем.Что(Гвард.Проверить(ЗаголовкиСТокеном(ПишущийТокен), Неопределено, Пул.Имя).Разрешено,
		"ключ без скоупа read не читает — даже у админа хаба").ЭтоЛожь();
	Ожидаем.Что(Гвард.Проверить(ЗаголовкиСТокеном(ЧужойПулТокен), Неопределено, Пул.Имя).Разрешено,
		"ключ, привязанный к другому пулу, не читает").ЭтоЛожь();

	ОтказКлюча = Гвард.Проверить(ЗаголовкиСТокеном(ЧужойПулТокен), Неопределено, Пул.Имя);
	НетПула = Гвард.Проверить(ЗаголовкиСТокеном(ЧитающийТокен), Неопределено, "нет-такого-пула-7a");
	Ожидаем.Что(ОтказКлюча.Пул, "отказ ключа не отдаёт пул").Равно(Неопределено);
	Ожидаем.Что(НетПула.Разрешено, "несуществующий пул — тот же отказ").ЭтоЛожь();
	Ожидаем.Что(НетПула.Пул, "и тоже без пула").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОтметкаНегодногоТокена

&Тест
Процедура ИстёкшийТокенОтличимОтНеопознанного() Экспорт

	СТ = Желудь("СервисТокенов");
	Пользователь = НовыйПользователь();

	Живой = СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read", 30, 0);
	Истёкший = ПротухшийТокен(Пользователь);
	Отозванный = СТ.ВыпуститьТокен(Пользователь.Идентификатор, "read", 30, 0);
	СТ.Отозвать(Пользователь.Идентификатор, Отозванный.Запись.Идентификатор);
	ЧужойСекрет = СтрШаблон("oshub_%1_deadbeef", Формат(Живой.Запись.Идентификатор, "ЧГ=0"));

	Ожидаем.Что(СТ.РезультатПроверки(Живой.ЗначениеТокена).ПроблемаТокена,
		"к живому ключу вопросов нет").Равно("");
	Ожидаем.Что(СТ.РезультатПроверки(Живой.ЗначениеТокена).Проверка,
		"и данные ключа отданы").Существует();
	Ожидаем.Что(СТ.РезультатПроверки(Истёкший.ЗначениеТокена).ПроблемаТокена,
		"вышел срок — ключ истёк, а не «не опознан»").Равно("expired");
	Ожидаем.Что(СТ.РезультатПроверки(Истёкший.ЗначениеТокена).Проверка,
		"и данных негодный ключ не даёт").Равно(Неопределено);
	Ожидаем.Что(СТ.РезультатПроверки(Отозванный.ЗначениеТокена).ПроблемаТокена,
		"записи нет — ключ не опознан").Равно("invalid");
	Ожидаем.Что(СТ.РезультатПроверки(ЧужойСекрет).ПроблемаТокена,
		"секрет не сошёлся — ключ не опознан").Равно("invalid");
	Ожидаем.Что(СТ.РезультатПроверки("не-ключ-вовсе").ПроблемаТокена,
		"строка не разобрана — ключ не опознан").Равно("invalid");

КонецПроцедуры

&Тест
Процедура ПерехватчикНазываетПроблемуТокенаНоПравНеДаёт() Экспорт

	Перехватчик = Желудь("ПерехватчикАутентификации");
	Пользователь = НовыйПользователь();

	Истёкший = ПротухшийТокен(Пользователь);
	Живой = Желудь("СервисТокенов").ВыпуститьТокен(Пользователь.Идентификатор, "read", 30, 0);
	Отключённый = НовыйПользователь();
	КлючОтключённого = Желудь("СервисТокенов").ВыпуститьТокен(Отключённый.Идентификатор, "read", 30, 0);
	Отключённый.Активен = Ложь;
	Отключённый.Сохранить();

	Просроченный = Перехватчик.ОпределитьПринципала(ЗаголовкиСТокеном(Истёкший.ЗначениеТокена),
		Неопределено);

	Ожидаем.Что(Просроченный.ПроблемаТокена, "истёкший ключ назван истёкшим").Равно("expired");
	Ожидаем.Что(Просроченный.Пользователь, "и при этом прав не даёт").Равно(Неопределено);
	Ожидаем.Что(Просроченный.Способ, "негодный ключ — аноним").Равно("");
	Ожидаем.Что(Просроченный.Права, "негодный ключ без скоупов").Равно("");

	Ожидаем.Что(Перехватчик.ПроблемаТокена(ЗаголовкиСТокеном(Истёкший.ЗначениеТокена)),
		"Authorization: Bearer").Равно("expired");
	Ожидаем.Что(Перехватчик.ПроблемаТокена(ЗаголовкиOAuth(Истёкший.ЗначениеТокена)),
		"легаси-заголовок OAUTH-TOKEN — тот же ответ").Равно("expired");
	Ожидаем.Что(Перехватчик.ПроблемаТокена(ЗаголовкиСТокеном(КлючОтключённого.ЗначениеТокена)),
		"ключ отключённой учётки — не опознан").Равно("invalid");
	Ожидаем.Что(Перехватчик.ПроблемаТокена(ЗаголовкиСТокеном(Живой.ЗначениеТокена)),
		"к живому ключу вопросов нет").Равно("");
	Ожидаем.Что(Перехватчик.ПроблемаТокена(Новый Соответствие()),
		"аноним ключа не предъявлял").Равно("");

КонецПроцедуры

&Тест
Процедура ОтметкаПоявляетсяТолькоНаНегодномТокене() Экспорт

	Пользователь = НовыйПользователь();
