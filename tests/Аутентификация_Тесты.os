		"неопознанный ключ назван в ответе").Равно("invalid");

КонецПроцедуры

&Тест
Процедура ОтметкаНеТрогаетКодТелоИМеткуРесурса() Экспорт

	Истёкший = ПротухшийТокен(НовыйПользователь());
	Ответ = ОтветВыдачи();
	Обёртка = ОбёрткаНад(Ответ);

	Отмеченный = Обёртка.СформироватьОтвет(ЗапросСЗаголовками(ЗаголовкиСТокеном(Истёкший.ЗначениеТокена)));

	Ожидаем.Что(Отмеченный.СостояниеКод, "код ответа не сдвинулся").Равно(200);
	Ожидаем.Что(Отмеченный.ТелоТекст, "тело не тронуто").Равно("пакет-один" + Символы.ПС + "пакет-два");
	Ожидаем.Что(Отмеченный.Заголовки.Получить("ETag"), "метка ресурса та же").Равно("""abc123""");
	Ожидаем.Что(Отмеченный.Заголовки.Получить("Content-Type"), "тип содержимого тот же")
		.Равно("text/plain; charset=utf-8");

КонецПроцедуры

&Тест
Процедура ОтмеченныйОтветНеЛожитсяВОбщийКэш() Экспорт

	Истёкший = ПротухшийТокен(НовыйПользователь());
	Ключ = ЗаголовкиСТокеном(Истёкший.ЗначениеТокена);

	Ожидаем.Что(УказанияКэшу(Ключ, Неопределено, ""),
		"ответ без указаний кэшу закрывается от общего кэша").Равно("private");
	Ожидаем.Что(УказанияКэшу(Ключ, "Cache-Control", "public, max-age=60"),
		"«public» уходит, срок остаётся").Равно("private, max-age=60");
	Ожидаем.Что(УказанияКэшу(Ключ, "Cache-Control", "no-cache"),
		"сверка метки остаётся на месте").Равно("private, no-cache");
	Ожидаем.Что(УказанияКэшу(Ключ, "Cache-Control", "private, no-store"),
		"более строгое указание не ослаблено").Равно("private, no-store");

	// заголовки различают регистр ключа: второй ключ дал бы в ответе два Cache-Control
	Ответ = ОтветСКэшем("cache-control", "public, max-age=60");
	Обёртка = ОбёрткаНад(Ответ);
	Обёртка.СформироватьОтвет(ЗапросСЗаголовками(Ключ));

	Ожидаем.Что(ЧислоУказанийКэшу(Ответ.Заголовки), "указание кэшу в ответе ровно одно").Равно(1);
	Ожидаем.Что(Ответ.Заголовки.Получить("cache-control"), "поправлен тот ключ, что был")
		.Равно("private, max-age=60");

КонецПроцедуры

&Тест
Процедура АнонимныйОтветОстаётсяНетронутым() Экспорт

	Ответ = ОтветСКэшем("Cache-Control", "public, max-age=60");
	Обёртка = ОбёрткаНад(Ответ);

	Обёртка.СформироватьОтвет(ЗапросСЗаголовками(Новый Соответствие()));

	Ожидаем.Что(Ответ.Заголовки.Получить("Cache-Control"), "указания кэшу не тронуты")
		.Равно("public, max-age=60");
	Ожидаем.Что(Ответ.Заголовки.Получить("OSHub-Token-Status"), "отметки нет")
		.Равно(Неопределено);

КонецПроцедуры

// Отметка — сведение о запросе, а не сам ответ. Сбой её сбора не вправе отменить уже
// собранный ответ: иначе недоступное хранилище токенов роняло бы пятисоткой и те адреса,
// которые к токенам не ходят вовсе.
&Тест
Процедура СбойОпределенияТокенаНеРоняетОтвет() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	ЛогОтметки.ДобавитьСпособВывода(Ловушка);

	Попытка
		Ответ = ОбёрткаНад(ОтветВыдачи(), Новый ПерехватчикПадающий("база токенов отвалилась"))
			.СформироватьОтвет(ЗапросСЗаголовками(ЗаголовкиСТокеном("oshub_1_deadbeef")));
	Исключение
		ЛогОтметки.УдалитьСпособВывода(Ловушка);
		ВызватьИсключение "Сбой отметки вышел наружу и уронил ответ: " + ОписаниеОшибки();
	КонецПопытки;
	ЛогОтметки.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(Ответ.СостояниеКод, "ответ дошёл до клиента целым").Равно(200);
	Ожидаем.Что(Ответ.ТелоТекст, "и с телом").Равно("пакет-один" + Символы.ПС + "пакет-два");
	Ожидаем.Что(Ответ.Заголовки.Получить("OSHub-Token-Status"),
		"отметки нет — состояние токена неизвестно").Равно(Неопределено);
	Ожидаем.Что(Ловушка.Всё(), "но сбой назван в журнале, а не проглочен молча")
		.Содержит("база токенов отвалилась");

КонецПроцедуры

