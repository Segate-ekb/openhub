	Ожидаем.Что(ОтметкаОтвета(ЗаголовкиСТокеном(Живой.ЗначениеТокена)),
		"живой ключ отметки не получает").Равно("");
	Ожидаем.Что(ОтметкаОтвета(ЗаголовкиСТокеном(Истёкший.ЗначениеТокена)),
		"истёкший ключ назван в ответе").Равно("expired");
