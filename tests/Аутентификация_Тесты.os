&Тест
Процедура ОчисткаУдаляетТолькоНедействительные() Экспорт

	ХранилищеСессийБД = Желудь("ХранилищеСессийБД");
	СлСес = Новый СлужбаСессий(ХранилищеСессийБД, НастройкиСессий(100));
	Старт = Дата(2026, 7, 24, 12, 0, 0);

	Живая = СлСес.Создать(1001, Неопределено, Неопределено, Старт + 1000);   // свежая (доступ Старт+1000)
	Старая = СлСес.Создать(1002, Неопределено, Неопределено, Старт);         // истечёт к Старт+100

	Удалено = СлСес.УдалитьПросроченные(Старт + 1050);
	Ожидаем.Что(Удалено >= 1).ЭтоИстина();
	Ожидаем.Что(ХранилищеСессийБД.Прочитать(Старая.Идентификатор())).Равно(Неопределено);
	Ожидаем.Что(ХранилищеСессийБД.Прочитать(Живая.Идентификатор())).Существует();

КонецПроцедуры

&Тест
Процедура ХранилищеСессийОтклоняетНебезопасныйИдентификатор() Экспорт

	ХранилищеСессийБД = Желудь("ХранилищеСессийБД");
	Ожидаем.Что(ХранилищеСессийБД.Прочитать("../etc/passwd")).Равно(Неопределено);
	Ожидаем.Что(ХранилищеСессийБД.ИдентификаторБезопасен("abc")).ЭтоЛожь();
	Ожидаем.Что(ХранилищеСессийБД.ИдентификаторБезопасен(
		"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РегистрацияИОнбординг

&Тест
Процедура РегистрацияВРежимеOpenСоздаётПользователя() Экспорт

	СР = НовыйСервисРегистрации(Желудь("СервисПользователей"), "open");
	Ожидаем.Что(СР.РегистрацияОткрыта()).ЭтоИстина();
	Пользователь = СР.Зарегистрировать(УникальныйЛогин(), "r@ex.com", "password123");
	Ожидаем.Что(Пользователь.РольХаба).Равно("user");
	Ожидаем.Что(Пользователь.EmailПодтверждён).ЭтоЛожь(); // модель подтверждения адреса

КонецПроцедуры

&Тест
Процедура РегистрацияDisabledИInviteОтклоняются() Экспорт

	СП = Желудь("СервисПользователей");
	Ожидаем.Что(РегистрацияПадает(НовыйСервисРегистрации(СП, "disabled"))).ЭтоИстина();
	Ожидаем.Что(РегистрацияПадает(НовыйСервисРегистрации(СП, "invite"))).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОнбордингСоздаётПервогоАдминаОдинРаз() Экспорт

	Желудь("СервисПользователей").СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Онб = Желудь("ОнбордингПервогоЗапуска");
	Ожидаем.Что(Онб.НуженОнбординг()).ЭтоЛожь();
	Ожидаем.Что(СозданиеАдминаПадает(Онб)).ЭтоИстина();

КонецПроцедуры

// Форму можно подделать, сервис — нет: порог смены роли хаба живёт здесь, и вызов мимо
// проверки отбивается исключением, а не пишет роль.
&Тест
Процедура СменаРолиХабаТолькоАдминомИНеСебе() Экспорт

	СП = Желудь("СервисПользователей");
	Админ = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "admin");
	Обычный = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
	Жертва = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	Ожидаем.Что(СП.ПроверитьСменуРоли(Обычный, Жертва, "admin").Причина,
		"обычный пользователь роль не раздаёт").Равно(СП.ПричинаНеАдмин());
	Ожидаем.Что(СП.ПроверитьСменуРоли(Обычный, Обычный, "admin").Причина,
		"и себе тоже").Равно(СП.ПричинаНеАдмин());
	Ожидаем.Что(СП.ПроверитьСменуРоли(Неопределено, Жертва, "admin").Причина,
		"аноним тем более").Равно(СП.ПричинаНеАдмин());
	Ожидаем.Что(СП.ПроверитьСменуРоли(Админ, Админ, "user").Причина,
		"администратор себя не понижает — хаб не остаётся без администратора").Равно(СП.ПричинаСебе());
	Ожидаем.Что(СП.ПроверитьСменуРоли(Админ, Неопределено, "admin").Причина,
		"несуществующая учётка — отказ, а не сбой").Равно(СП.ПричинаНетУчётки());
	Ожидаем.Что(СП.ПроверитьСменуРоли(Админ, Жертва, "superadmin").Причина,
		"выдуманная роль отвергнута").Равно(СП.ПричинаНеизвестнаяРоль());
	Ожидаем.Что(СП.ПроверитьСменуРоли(Админ, Жертва, "admin").Можно,
		"а законная выдача разрешена").ЭтоИстина();

	Ожидаем.Что(СменаРолиПадает(СП, Обычный, Жертва, "admin"),
		"вызов мимо проверки отбивается исключением").ЭтоИстина();
	Ожидаем.Что(СП.ПоИдентификатору(Жертва.Идентификатор).РольХаба,
		"роль жертвы не изменилась").Равно("user");

	Ожидаем.Что(СП.НазначитьРольХаба(Админ, Жертва, "admin"),
		"администратор роль выдаёт").ЭтоИстина();
	Ожидаем.Что(СП.ПоИдентификатору(Жертва.Идентификатор).РольХаба, "роль записана").Равно("admin");
	Ожидаем.Что(СП.НазначитьРольХаба(Админ, Жертва, "admin"),
		"повтор ничего не меняет").ЭтоЛожь();
	Ожидаем.Что(СП.НазначитьРольХаба(Админ, Жертва, "user"),
		"тем же методом роль снимается").ЭтоИстина();
	Ожидаем.Что(СП.ПоИдентификатору(Жертва.Идентификатор).РольХаба, "роль снята").Равно("user");

КонецПроцедуры

// Разбор инцидента «кому раздали полные права» начинается с адреса инициатора: событие
// безопасности без него наполовину бесполезно.
&Тест
Процедура СобытиеСменыРолиНесётАдресИнициатора() Экспорт

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

	Издатель = Желудь("ИздательСобытий");
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипРольХабаИзменена(), Слушатель);

	СП = Желудь("СервисПользователей");
	Админ = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "admin");
	Цель = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	СП.НазначитьРольХаба(Админ, Цель, "admin", "203.0.113.7");

	Событие = Слушатель.Первое(Издатель.ТипРольХабаИзменена());
	Ожидаем.Что(Событие <> Неопределено, "событие опубликовано").ЭтоИстина();
	Ожидаем.Что(Событие.Данные.АдресIP, "адрес инициатора попал в журнал").Равно("203.0.113.7");
	Ожидаем.Что(Событие.Данные.Кто, "инициатор назван логином").Равно(Админ.Логин);
	Ожидаем.Что(Событие.Данные.Объект, "объект — учётка логином, а не номером").Равно("пользователь/" + Цель.Логин);
	Ожидаем.Что(Событие.Данные.Субъект, "кому меняли роль — отдельным полем").Равно("пользователь/" + Цель.Логин);
	Ожидаем.Что(СтрНайти(Событие.Данные.ДеталиJSON, Цель.Логин) > 0,
		"детали называют учётку").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СменаРолиДоезжаетДоЖурналаАудита() Экспорт

	// Событие мало опубликовать — на него нужно быть подписанным: снятая подписка
	// оставляет журнал без записи о выдаче прав на весь хаб, и заметить это нечем.
	// Наблюдатель — сам файл журнала: базы под аудитом больше нет.
	Имена = Желудь("ИмяОбъектаАудита");
	СП = Желудь("СервисПользователей");

	Админ = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "admin");
	Цель = СП.СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");

	СП.НазначитьРольХаба(Админ, Цель, "admin", "203.0.113.9");

	Записи = ЗаписиЖурнала(Имена.Пользователь(Цель.Логин));

	Ожидаем.Что(Записи.Количество() > 0, "смена роли записана в журнал аудита").ЭтоИстина();
	Ожидаем.Что(Строка(Записи[0].Действие), "действие названо").Равно("роль.хаба.изменена");
	Ожидаем.Что(Строка(Записи[0].Кто), "инициатор — из события").Равно(Админ.Логин);
	Ожидаем.Что(Строка(Записи[0].Субъект), "кому меняли роль — отдельным полем")
		.Равно(Имена.Пользователь(Цель.Логин));
	Ожидаем.Что(Строка(Записи[0].АдресIP), "адрес инициатора доехал").Равно("203.0.113.9");
	Ожидаем.Что(СтрНайти(Строка(Записи[0].Детали), "admin") > 0,
		"в деталях названа новая роль: " + Строка(Записи[0].Детали)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Адреса()
	Возврат Желудь("АдресУчётки");
КонецФункции

Функция СменаРолиПадает(Знач СП, Знач Инициатор, Знач Цель, Знач Роль)
	Попытка
		СП.НазначитьРольХаба(Инициатор, Цель, Роль);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция УникальныйЛогин()
	Счётчик = Счётчик + 1;
	Возврат "user" + Формат(Счётчик, "ЧГ=0") + "x";
КонецФункции

Функция УникальныйАдрес()
	Счётчик = Счётчик + 1;
	Возврат "mail" + Формат(Счётчик, "ЧГ=0") + "x@example.org";
КонецФункции

// Текст отказа заведения учётки; пустая строка — учётка неожиданно завелась.
Функция ОтказСоздания(Знач СП, Знач Логин, Знач Email)
	Попытка
		СП.СоздатьПользователя(Логин, Email, "password123", "user");
		Возврат "";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

// Текст отказа смены адреса; пустая строка — адрес неожиданно сменился.
Функция ОтказСменыАдреса(Знач СП, Знач Пользователь, Знач Email)
	Попытка
		Адреса().Сменить(Пользователь, Email);
		Возврат "";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция ПоддельныйПул(Знач Ид, Знач Видимость)
	Возврат Новый Структура("Идентификатор, Видимость", Ид, Видимость);
КонецФункции

// Текст отказа выпуска; пустая строка — токен неожиданно выпустился.
Функция ОтказВыпуска(Знач СТ, Знач ПользовательИдентификатор, Знач СрокДней)
	Попытка
		СТ.ВыпуститьТокен(ПользовательИдентификатор, "read", СрокДней, 0);
		Возврат "";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция ЗаголовкиСТокеном(Знач ЗначениеТокена)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "Bearer " + ЗначениеТокена);
	Возврат Заголовки;
КонецФункции

Функция ЗаголовкиOAuth(Знач ЗначениеТокена)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("OAUTH-TOKEN", ЗначениеТокена);
	Возврат Заголовки;
КонецФункции

Функция НовыйПользователь()
	Возврат Желудь("СервисПользователей").СоздатьПользователя(УникальныйЛогин(), "", "password123", "user");
КонецФункции

// Ключ с вышедшим сроком: хаб бессрочных не выпускает, поэтому срок отодвигается
// в прошлое прямо в записи.
Функция ПротухшийТокен(Знач Пользователь)

	Выпуск = Желудь("СервисТокенов").ВыпуститьТокен(Пользователь.Идентификатор, "read", 1, 0);
	Выпуск.Запись.Истекает = ТекущаяУниверсальнаяДата() - 3600;
	Выпуск.Запись.Сохранить();

	Возврат Выпуск;

КонецФункции

// Обёртка ответа над заглушкой обработчика: перехватчик по умолчанию настоящий.
Функция ОбёрткаНад(Знач Ответ, Знач Перехватчик = Неопределено)

	Возврат Новый ОбработчикСОтметкойТокена(
		Новый ОбработчикЗапросовЗаглушка(Ответ),
		?(Перехватчик = Неопределено, Желудь("ПерехватчикАутентификации"), Перехватчик),
		ЛогОтметки);

КонецФункции

// Значение отметки состояния ключа на ответе, собранном обёрткой; "" — отметки нет.
Функция ОтметкаОтвета(Знач ЗаголовкиЗапроса)

	Ответ = ОтветВыдачи();
	Обёртка = ОбёрткаНад(Ответ);
	Обёртка.СформироватьОтвет(ЗапросСЗаголовками(ЗаголовкиЗапроса));

	Отметка = Ответ.Заголовки.Получить("OSHub-Token-Status");
	Возврат ?(Отметка = Неопределено, "", Строка(Отметка));

КонецФункции

// Указания кэшу на ответе после обёртки: заголовок ставится тем ключом, что назван.
Функция УказанияКэшу(Знач ЗаголовкиЗапроса, Знач КлючКэша, Знач ЗначениеКэша)

	Ответ = ОтветСКэшем(КлючКэша, ЗначениеКэша);
	Обёртка = ОбёрткаНад(Ответ);
	Обёртка.СформироватьОтвет(ЗапросСЗаголовками(ЗаголовкиЗапроса));

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "CACHE-CONTROL" Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЧислоУказанийКэшу(Знач Заголовки)

	Число_ = 0;
	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "CACHE-CONTROL" Тогда
			Число_ = Число_ + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Число_;

КонецФункции

// Ответ выдачи списка пакетов, каким его собирает контроллер: код, тело, метка ресурса.
Функция ОтветВыдачи()

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	Заголовки.Вставить("ETag", """abc123""");

	Возврат Новый Структура("Заголовки, СостояниеКод, ТелоТекст",
		Заголовки, 200, "пакет-один" + Символы.ПС + "пакет-два");

КонецФункции

Функция ОтветСКэшем(Знач КлючКэша, Знач ЗначениеКэша)

	Ответ = ОтветВыдачи();
	Если ЗначениеЗаполнено(КлючКэша) Тогда
		Ответ.Заголовки.Вставить(КлючКэша, ЗначениеКэша);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция ЗапросСЗаголовками(Знач Заголовки)
	Возврат Новый Структура("Заголовки", Заголовки);
КонецФункции

Функция Принципал(Знач Способ, Знач Права, Знач ПулИдентификатор)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Неопределено, Способ, Права, ПулИдентификатор, Неопределено);
КонецФункции

// Принципал ключа с НАБОРОМ пулов — так его собирает перехватчик после выпуска.
Функция ПринципалНабора(Знач Способ, Знач Права, Знач Пулы)
	Возврат Новый Структура("Пользователь, Способ, Права, Пулы, ПулИдентификатор, Сессия",
		Неопределено, Способ, Права, Пулы, 0, Неопределено);
КонецФункции

// Записи токенов списком — аргумент дверей, работающих на весь экран сразу.
Функция Записями(Знач Первая, Знач Вторая = Неопределено)
	Записи = Новый Массив();
	Записи.Добавить(Первая);
	Если Вторая <> Неопределено Тогда
		Записи.Добавить(Вторая);
	КонецЕсли;
	Возврат Записи;
КонецФункции

Функция ДваПула(Знач Первый, Знач Второй)
	Пулы = Новый Массив();
	Пулы.Добавить(Первый);
	Пулы.Добавить(Второй);
	Возврат Пулы;
КонецФункции

Функция Попытка_СоздатьДубль(Знач СП, Знач Логин)
	Попытка
		СП.СоздатьПользователя(Логин, "", "password123", "user");
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция ЛогинНевалиден(Знач Норм, Знач Логин)
	Попытка
		Норм.ПроверитьЛогин(Норм.НормализоватьЛогин(Логин));
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция EmailНевалиден(Знач Норм, Знач Email)
	Попытка
		Норм.НормализоватьEmail(Email);
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция РегистрацияПадает(Знач СР)
	Попытка
		СР.Зарегистрировать(УникальныйЛогин(), "", "password123");
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция СозданиеАдминаПадает(Знач Онб)
	Попытка
		Онб.СоздатьПервогоАдмина("someadmin", "password123", Ложь);
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Сервис входа со своим лимитером (порог задаётся тестом), но с НАСТОЯЩЕЙ шиной
// контейнера: на ней сидит СлужбаАудита, и строка журнала проходит весь путь.
Функция АутентификацияСЖурналом(Знач МаксПопыток, Знач СекундБлокировки)
	Возврат Новый СервисАутентификации(
		Желудь("СервисПользователей"), Желудь("СлужбаСессий"),
		Новый ОграничительВхода(НастройкиВхода(МаксПопыток, СекундБлокировки)),
		Новый ПолитикаПарольногоВхода(НастройкиВхода(МаксПопыток, СекундБлокировки)),
		Желудь("ГейтПодтвержденияАдреса"), Желудь("ИмяОбъектаАудита"),
		Желудь("ИздательСобытий"), ЛогТестов());
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.вход");
КонецФункции

Функция ЗаписиЖурнала(Знач Объект)
	Возврат Новый ЖурналАудитаФайлом(Желудь("ЧитательЖурналаАудита")).ПоОбъекту(Объект);
КонецФункции

Функция ДействияЖурнала(Знач Объект)
	Действия = Новый Массив();
	Для Каждого Запись Из ЗаписиЖурнала(Объект) Цикл
		Действия.Добавить(Строка(Запись.Действие));
	КонецЦикла;
	Возврат СтрСоединить(Действия, ",");
КонецФункции

Функция НастройкиВхода(Знач МаксПопыток, Знач СекундБлокировки)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.ЗадатьВход(МаксПопыток, СекундБлокировки);
	Возврат Заглушка;
КонецФункции

Функция НастройкиСессий(Знач ТТЛСекунд)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.Задать("oshub.auth.session.ttlseconds", ТТЛСекунд);
	Возврат Заглушка;
КонецФункции

Функция НастройкиРежима(Знач Режим)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.Задать("oshub.auth.registration.mode", Режим);
	Возврат Заглушка;
КонецФункции

// Парольный вход в заглушке не задан — политика отвечает дефолтом реестра «включён».
Функция НовыйСервисРегистрации(Знач СервисПользователей, Знач Режим)
	Настройки = НастройкиРежима(Режим);
	Возврат Новый СервисРегистрации(СервисПользователей, Настройки,
		Новый ПолитикаПарольногоВхода(Настройки), Новый ПодтверждениеАдресаЗаглушка(),
		Желудь("ОтказыУчётки"), ЛогТестов());
КонецФункции

Процедура ПодключитьСервисы(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить; // контроллерам нужен winow, в юнит-контейнере не подключаем
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
