// HTTP-тесты главной кабинета «/me»: она отвечает на вопрос «что у меня происходит»,
// а не «куда пойти». Хаб настоящий, фактуру задаёт сидер ЗасеятьСводкуКабинета.os:
// автор с восемью пакетами, новичок без единого, одиночка с двумя, владелец ключей
// по обе стороны порога, владелец пула с зеркалами, райтер того же пула и три учётки
// с испорченным личным пространством.

#Использовать asserts
// 1connector — клиент, НЕ следующий редиректам: адрес возврата штатным клиентом не виден
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КаталогПроекта;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьСводкуКабинета.os");

	Хаб.ФайловаяБаза("openhub-сводка-кабинета");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// фоновая доставка вебхуков и резолв имён тестам не нужны и ходят в сеть
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область МоиПакеты

// Карточка пакета несёт то, чего у плашки-навигации не было вовсе: последнюю версию,
// дату публикации и счётчик скачиваний.
&Тест
Процедура КарточкаПакетаНесётВерсиюДатуИСчётчик() Экспорт

	Страница = Кабинет("author", "AuthorPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "sum-pkg-8") > 0,
		"кабинет называет пакет в управлении: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "1.8.0") > 0,
		"и его последнюю версию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "опубликована") > 0,
		"и дату публикации").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "скачиваний") > 0,
		"и счётчик скачиваний").ЭтоИстина();

КонецПроцедуры

// Свежеопубликованное сверху, показана горстка, остальное — в каталоге с отбором «мои».
&Тест
Процедура СвежееСверхуАХвостУводитВКаталог() Экспорт

	Страница = Кабинет("author", "AuthorPassw0rd");

	// у автора восемь пакетов, показываются шесть свежих: двух самых старых на странице нет
	Ожидаем.Что(СтрНайти(Страница, "sum-pkg-1"),
		"самый старый пакет в горстку не попал").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "sum-pkg-2"),
		"и предпоследний по свежести тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "sum-pkg-3") > 0,
		"а шестой по свежести показан").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница, "sum-pkg-8") < СтрНайти(Страница, "sum-pkg-3"),
		"свежеопубликованное стоит первым").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница, "И ещё 2") > 0,
		"хвост называет, сколько осталось").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/packages?mine=1""") > 0,
		"и уводит в каталог с отбором «мои»").ЭтоИстина();

КонецПроцедуры

// Плашки-входы «открой раздел», у которых кроме заголовка и ссылки ничего не было,
// со страницы сняты целиком.
&Тест
Процедура ПлашекНавигацииНаСтраницеНет() Экспорт

	Страница = Кабинет("author", "AuthorPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "Личный контекст"),
		"сетки карточек-входов нет: " + Страница).Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Открыть настройки"),
		"входа в настройки аккаунта карточкой тоже нет").Равно(0);

КонецПроцедуры

// Показано всё — хвоста нет: «И ещё 0» сказало бы человеку, что где-то есть ещё пакеты.
&Тест
Процедура ПриГорсткеПакетовХвостаНет() Экспорт

	Страница = Кабинет("solo", "SoloPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "solo-issued") > 0,
		"КОНТРОЛЬ: карточки одиночки на месте: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "solo-unreleased") > 0,
		"КОНТРОЛЬ: и второй его пакет тоже").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "И ещё"),
		"показаны все пакеты — хвоста нет").Равно(0);

КонецПроцедуры

// Пакету без единой публикации нечего сказать о выпуске: версии и даты у него нет,
// и встаёт он ниже изданного.
&Тест
Процедура ПакетБезПубликацийИдётВнизИБезВерсии() Экспорт

	Страница = Кабинет("solo", "SoloPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "solo-issued") < СтрНайти(Страница, "solo-unreleased"),
		"изданный пакет стоит выше неизданного").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Страница, "visually-hidden"">версия: "),
		"версия печатается ровно у того пакета, у которого она есть").Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(Страница, "visually-hidden"">опубликована: "),
		"и дата публикации тоже").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЛичноеПространство

// Личное пространство названо местом, а не ссылкой: занято, квота и число пакетов
// видны прямо в кабинете.
&Тест
Процедура МестоВЛичномПространствеПоказаноПолосой() Экспорт

	Страница = Кабинет("author", "AuthorPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "Место в пуле author") > 0,
		"блок личного пространства на месте: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "role=""progressbar""") > 0,
		"заполнение показано полосой, а не словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Пакетов в пространстве") > 0,
		"и число пакетов названо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/author""") > 0,
		"из блока есть дорога в сам пул").ЭтоИстина();

КонецПроцедуры

// У пула без ограничения процента не существует: вместо полосы печатается одно занятое.
&Тест
Процедура БезКвотыВместоПолосыОдноЗанятое() Экспорт

	Страница = Кабинет("solo", "SoloPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "Место в пуле solo") > 0,
		"блок пространства на месте: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "ограничения нет") > 0,
		"без квоты сказано словами, а не нулевым процентом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "role=""progressbar"""),
		"и полосы, которой нечего показывать, нет").Равно(0);

КонецПроцедуры

// Личное пространство — это пул типа «личный», принадлежащий смотрящему. Не совпало
// хоть одно — блок молчит: рассказывать о чужом пуле кабинету нечего.
&Тест
Процедура ЧужойПулПодИменемЛогинаПространствомНеСчитается() Экспорт

	Разжалованный = Кабинет("demoted", "DemotedPassw0rd");
	Ожидаем.Что(СтрНайти(Разжалованный, "Место в пуле demoted"),
		"пул перестал быть личным — блока нет: " + Разжалованный).Равно(0);

	Обобранный = Кабинет("usurped", "UsurpedPassw0rd");
	Ожидаем.Что(СтрНайти(Обобранный, "Место в пуле usurped"),
		"имя логина носит пул чужого владельца — блока нет").Равно(0);

	Бездомный = Кабинет("homeless", "HomelessPassw0rd");
	Ожидаем.Что(СтрНайти(Бездомный, "Место в пуле homeless"),
		"пространства нет вовсе — блока нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПервыеШаги

// Новичку без единого пакета кабинет показывает шаги первой публикации и оставляет
// дорогу на проводник: со страницы можно уйти и вернуться к тем же шагам.
&Тест
Процедура НовичкуПоказаныПервыеШагиИХодВПроводник() Экспорт

	Кука = Клиент.Войти("newbie", "NewbiePassw0rd");
	Страница = Клиент.Тело(Клиент.GETСКукой("/me", Кука));

	Ожидаем.Что(СтрНайти(Страница, "Первая публикация") > 0,
		"новичку показаны шаги: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Выпустить токен публикации") > 0,
		"и это сами шаги пути, а не один заголовок блока").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/tour""") > 0,
		"к шагам можно вернуться, уйдя со страницы").ЭтоИстина();

	Проводник = Клиент.GETСКукой("/tour", Кука);
	Ожидаем.Что(Проводник.КодСостояния, "проводник открывается").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Проводник), "Выпустить токен публикации") > 0,
		"и показывает те же шаги").ЭтоИстина();

КонецПроцедуры

// Тому, кто уже публиковал, место занято карточками: шаги для новичка ему не показывают.
&Тест
Процедура АвторуПервыеШагиНеПоказывают() Экспорт

	Ожидаем.Что(СтрНайти(Кабинет("author", "AuthorPassw0rd"), "Первая публикация"),
		"у автора с пакетами первых шагов нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ТокеныНаИсходе

// Предупреждают о том, что вот-вот перестанет работать: истёкший и истекающий ключи.
// Бессрочный и дальний поводом для предупреждения не считаются.
&Тест
Процедура ПредупреждениеТолькоОКлючахНаИсходе() Экспорт

	Страница = Кабинет("keyman", "KeymanPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "Токены на исходе: 5") > 0,
		"предупреждение считает ровно горящие ключи: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "ключ-истёкший") > 0, "истёкший назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "ключ-на-исходе") > 0, "истекающий назван").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница, "ключ-бессрочный"),
		"бессрочный ключ не истекает, и предупреждать о нём не о чем").Равно(0);

	Ожидаем.Что(СтрНайти(Страница, "истёк") > 0, "состояние названо словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "скоро истечёт") > 0, "и второе состояние тоже").ЭтоИстина();

КонецПроцедуры

// Обе границы порога: ключ ровно на четырнадцатые сутки внутри окна, на пятнадцатые —
// снаружи. Порог считается от «сейчас», а не от полуночи, поэтому граница проверяется
// парой соседних дней, а не одним значением.
&Тест
Процедура ГраницаПорогаСрокаПроверенаСОбеихСторон() Экспорт

	Страница = Кабинет("keyman", "KeymanPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "ключ-граница-14") > 0,
		"ключ ровно на пороге предупреждает: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "ключ-граница-15"),
		"а сутками дальше — уже нет").Равно(0);

КонецПроцедуры

// Ключ, срок которого вышел только что, назван истёкшим, а не «скоро истечёт».
// Саму границу (`<=` против `<`) живым хабом не поймать: сидер пишет срок до старта,
// запрос приходит секундами позже, и момент уже строго в прошлом — момент не остановить.
&Тест
Процедура ТолькоЧтоИстёкшийНазванИстёкшим() Экспорт

	Страница = Кабинет("keyman", "KeymanPassw0rd");
	Строка_ = СтрокаТаблицы(Страница, "ключ-ровно-сейчас");

	Ожидаем.Что(СтрНайти(Строка_, "истёк") > 0,
		"момент позади — ключ истёк: " + Строка_).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "скоро истечёт"),
		"и «скоро» о нём уже не говорят").Равно(0);

КонецПроцедуры

// Ключ без имени называется заглушкой: пустая ячейка не даёт его опознать среди своих.
&Тест
Процедура БезымянныйКлючНазванЗаглушкой() Экспорт

	Ожидаем.Что(СтрНайти(Кабинет("keyman", "KeymanPassw0rd"), "(без имени)") > 0,
		"безымянный ключ назван заглушкой").ЭтоИстина();

КонецПроцедуры

// У кого горящих ключей нет, тому и блока нет: предупреждение без повода приучает
// его не читать.
&Тест
Процедура БезГорящихКлючейБлокаНет() Экспорт

	Ожидаем.Что(СтрНайти(Кабинет("author", "AuthorPassw0rd"), "Токены на исходе"),
		"у автора горящих ключей нет — блока тоже").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ЗеркалаМоихПулов

// Зеркало показывается тому, кто им распоряжается: апстрим, состояние прогона,
// последний синк и причина неудачи — словами.
&Тест
Процедура ЗеркалоПулаПоказаноСПричинойНеудачи() Экспорт

	Страница = Кабинет("mirrorman", "MirrorPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "Зеркала ваших пулов") > 0,
		"блок зеркал на месте: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "upstream.example/download/") > 0,
		"апстрим назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Последний синк") > 0,
		"и момент последнего синка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "апстрим не отвечает") > 0,
		"неудача объяснена словами, а не кодом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/replica""") > 0,
		"из строки есть дорога в пул назначения").ЭтоИстина();

КонецПроцедуры

// Зеркало, которое ещё ни разу не отработало, называет это словами, а не пустой ячейкой.
&Тест
Процедура НеСинхронизированноеЗеркалоНазываетЭтоСловами() Экспорт

	Строка_ = СтрокаТаблицы(Кабинет("mirrorman", "MirrorPassw0rd"), "untouched.example");

	Ожидаем.Что(СтрНайти(Строка_, "ни разу") > 0,
		"отсутствие синка названо словами: " + Строка_).ЭтоИстина();

КонецПроцедуры

// Выборка «мои пулы» идёт по правам: посторонний чужого зеркала не видит вовсе.
&Тест
Процедура ЧужогоЗеркалаПостороннийНеВидит() Экспорт

	Страница = Кабинет("author", "AuthorPassw0rd");

	Ожидаем.Что(СтрНайти(Страница, "upstream.example"),
		"чужое зеркало постороннему не показывают").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Зеркала ваших пулов"),
		"и блока у него нет вовсе").Равно(0);

КонецПроцедуры

// Порог зеркал — распоряжение пулом, а не запись в него. Райтер публикует в тот же пул,
// но не решает, откуда пул наполняется, и зеркал в кабинете не видит. Он единственный,
// кого отсекает проверка права: пул в его «управлении» есть, а в «распоряжении» — нет.
&Тест
Процедура РайтеруПулаЗеркалаНеПоказывают() Экспорт

	Страница = Кабинет("penman", "PenmanPassw0rd");

	// КОНТРОЛЬ, без которого тест проходил бы и у постороннего: пакет пула репликации
	// в кабинете райтера ЕСТЬ — значит, пул в его управлении, и молчит блок зеркал
	// именно из-за порога, а не из-за отсутствия прав вовсе
	Ожидаем.Что(СтрНайти(Страница, "replica-pkg") > 0,
		"КОНТРОЛЬ: пул репликации у райтера в управлении: " + Страница).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница, "upstream.example"),
		"зеркала пула, куда он только пишет, ему не принадлежат").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Зеркала ваших пулов"),
		"и блока у него нет вовсе").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область HTTPПомощники

Функция Кабинет(Знач Логин, Знач Пароль)
	Возврат Клиент.Тело(Клиент.GETСКукой("/me", Клиент.Войти(Логин, Пароль)));
КонецФункции

// Строка таблицы, внутри которой встречается маркер: судить о состоянии по всей странице
// нельзя — соседняя строка говорит о другом ключе и о другом зеркале.
Функция СтрокаТаблицы(Знач Разметка, Знач Маркер)

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет строки с маркером " + Маркер;
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<tr");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<tr");
	КонецЦикла;
	Если Начало = 0 Тогда
		ВызватьИсключение "Маркер " + Маркер + " найден вне таблицы";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</tr>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти
