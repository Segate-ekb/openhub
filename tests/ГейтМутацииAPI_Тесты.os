// Сторож ветки «неизвестный способ аутентификации» в ДопускAPI.ПроверитьМутацию:
// она обязана быть default-closed, а по HTTP в неё не въехать — отсюда прямой экземпляр.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;

// Изоляция процессом: набор регистрирует классы прикладных модулей в процессе теста,
// и делить процесс с чужими регистрациями того же имени незачем (мина захвата имён).
&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогТестов = ОбъединитьПути(КаталогПроекта, "tests");

	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	ПоискКлассов.Подключить(Модули, "ОтветыAPI");
	ПоискКлассов.Подключить(Модули, "ЗаголовкиHTTP");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "api", "Классы", "ДопускAPI.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ОтветJSONЗаглушка.os"));

КонецПроцедуры

&Тест
Процедура НеизвестныйСпособАутентификацииНеПропускаетМутацию() Экспорт

	Ответ = Новый ОтветJSONЗаглушка();
	Разрешено = Допуск().ПроверитьМутацию(Ответ, Принципал("mtls", "кто-то"),
		Новый Соответствие(), Новый Соответствие());

	Ожидаем.Что(Разрешено, "неизвестный способ мутацию НЕ проходит").ЭтоЛожь();
	Ожидаем.Что(Ответ.Код, "и получает 403").Равно(403);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "unknown_auth_method") > 0,
		"причина названа своим кодом (тело: " + Ответ.ТелоТекст + ")").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АнонимПроходитНасквозьАПолуличностьНет() Экспорт

	// аноним = пустой способ И отсутствующий пользователь — только он проходит
	ОтветАнонима = Новый ОтветJSONЗаглушка();
	Ожидаем.Что(Допуск().ПроверитьМутацию(ОтветАнонима, Принципал("", Неопределено),
		Новый Соответствие(), Новый Соответствие()), "аноним проходит насквозь").ЭтоИстина();
	Ожидаем.Что(ОтветАнонима.Код, "и ответ не тронут — отказ выдаст аутентификация ниже").Равно(0);

	// «полуличность» (пустой способ, но пользователь есть) — такого перехватчик не
	// выдаёт, и гейт обязан считать это неизвестным способом, а не анонимом
	ОтветПолу = Новый ОтветJSONЗаглушка();
	Ожидаем.Что(Допуск().ПроверитьМутацию(ОтветПолу, Принципал("", "кто-то"),
		Новый Соответствие(), Новый Соответствие()),
		"пустой способ с пользователем насквозь не проходит").ЭтоЛожь();
	Ожидаем.Что(ОтветПолу.Код, "и это 403").Равно(403);

КонецПроцедуры

// --- хелперы ---

// Допуск ПРЯМЫМ экземпляром: проверяемая ветка не трогает ни одной зависимости, кроме
// ОтветыAPI (он пишет отказ в ответ).
Функция Допуск()
	Возврат Новый ДопускAPI(Неопределено, Неопределено, Неопределено, Неопределено,
		Новый ЗаголовкиHTTP(), Новый ОтветыAPI(Новый ЗаголовкиHTTP()), Неопределено);
КонецФункции

Функция Принципал(Знач Способ, Знач Пользователь)
	Возврат Новый Структура("Способ, Пользователь, Права, ПулИдентификатор, Сессия",
		Способ, Пользователь, "", 0, Неопределено);
КонецФункции
