КонецПроцедуры

&Тест
Процедура ЕдиноеМенюВедётВЛентуИПоказываетНепрочитанное() Экспорт

	Человек = СоздатьПользователя();

	Меню = МенюХаба(Человек);
	Ожидаем.Что(АдресаДел(Меню.Дела), "из меню есть дорога до ленты")
		.Содержит("/me/notifications");
	Ожидаем.Что(ПодписьДела(Меню.Дела, "/me/notifications"),
		"подпись дела не носит чисел: число печатается бейджем").Равно("Уведомления");
	Ожидаем.Что(СчётДела(Меню.Дела, "/me/notifications"), "и бейджа у дела нет").Равно(0);
	Ожидаем.Что(Меню.Счётчик, "и на бургере его нет").Равно(0);

	Лента().Записать(Человек, Поводы().ЗаявкаОдобрена(), "Заявка одобрена", "Подробности");

	Меню = МенюХаба(Человек);
	Ожидаем.Что(СчётДела(Меню.Дела, "/me/notifications"),
		"непрочитанное встало бейджем своего дела").Равно(1);
	Ожидаем.Что(РечьДела(Меню.Дела, "/me/notifications"),
		"и названо словами, а не голой цифрой").Содержит("Непрочитанных уведомлений");
	Ожидаем.Что(Меню.Счётчик, "оно же слагаемым суммы на бургере").Равно(1);
	Ожидаем.Что(Меню.ПодписьСчётчика, "сумма названа словами, а не голой цифрой")
		.Содержит("Ждут вашего внимания");

КонецПроцедуры

// Бейдж на бургере — СУММА двух дел, а своё число несёт каждое дело: цифра без имени
// не говорит, куда идти. Дорога до «входящих» есть и при нуле заявок.
&Тест
Процедура ЗаявкиНаРешениеПопадаютВЕдиноеМенюСлагаемымБейджа() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);

	Меню = МенюХаба(Мейнтейнер);
	Ожидаем.Что(АдресаДел(Меню.Дела), "дорога до входящих есть и на пустой очереди")
		.Содержит("/me/inbox");
	Ожидаем.Что(СчётДела(Меню.Дела, "/me/inbox"), "и бейджа у дела нет").Равно(0);
	Ожидаем.Что(Меню.Счётчик, "бейджа при нуле дел нет").Равно(0);

	ПодатьЗаявку(Пул, СоздатьПользователя(), УникальноеИмя("waits"), "1.0.0");
	Лента().Записать(Мейнтейнер, Поводы().ЗаявкаОдобрена(), "Заявка одобрена", "Подробности");

	Меню = МенюХаба(Мейнтейнер);
	Ожидаем.Что(СчётДела(Меню.Дела, "/me/inbox"),
		"ждущая заявка видна бейджем своего дела").Равно(1);
	Ожидаем.Что(СчётДела(Меню.Дела, "/me/notifications"),
		"а непрочитанное — бейджем своего").Равно(1);
	Ожидаем.Что(Меню.Счётчик, "на бургере — сумма заявок и непрочитанного").Равно(2);

	Ожидаем.Что(МенюХаба(СоздатьПользователя()).Счётчик,
		"постороннему чужая очередь не считается").Равно(0);

КонецПроцедуры

// Порог пункта «Настройки хаба» держат ПРАВА, а не флаг экрана: флаг ставят только
// контроллеры приватной части, и на публичной странице админ терял бы свой пункт.
// Обратная сторона того же решения: истинный флаг рядовому участнику прав не выдаёт.
&Тест
Процедура НастройкиХабаВМенюОткрываютсяПоПравамАНеПоФлагуЭкрана() Экспорт

	Админ = МенюНаПубличнойСтранице(СоздатьАдмина());
	Ожидаем.Что(АдресаДел(Админ.Дела),
		"админ видит настройки хаба и на публичной странице").Содержит("/hub/settings");
	Ожидаем.Что(Админ.Учётка.Роль, "и роль подписана под его именем")
		.Равно("администратор хаба");

	Рядовой = МенюНаПубличнойСтранице(СоздатьПользователя());
	Ожидаем.Что(СтрНайти(АдресаДел(Рядовой.Дела), "/hub/settings"),
		"рядовому участнику дело не печатается").Равно(0);
	Ожидаем.Что(АдресаДел(Рядовой.Дела),
		"КОНТРОЛЬ: остальные дороги у него на месте").Содержит("/me/inbox");
	Ожидаем.Что(Рядовой.Учётка.Роль, "и роли под именем у него нет").Равно("");

	// права собраны — флаг экрана запасной путь и решать не вправе, иначе один контроллер,
	// поставивший его щедро, роздал бы вход в настройки хаба всем своим страницам
	СФлагом = МенюНаПубличнойСтранице(СоздатьПользователя(), Истина);
	Ожидаем.Что(СтрНайти(АдресаДел(СФлагом.Дела), "/hub/settings"),
		"истинный флаг экрана прав рядовому не добавляет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Канал()
	Возврат Желудь("СлужбаЛичныхУведомлений");
КонецФункции

Функция Лента()
	Возврат Желудь("ЛентаУведомлений");
КонецФункции

Функция Поводы()
	Возврат Желудь("ПоводыУведомлений");
КонецФункции

Функция Рассмотрение()
	Возврат Желудь("РассмотрениеВходящих");
КонецФункции

Функция Настройки()
	Возврат Желудь("СервисНастроек");
КонецФункции

Функция МояЛента(Знач Человек)
	Возврат Лента().Мои(Человек);
КонецФункции

// Канал, у которого лента отказывает на каждой записи.
Функция КаналСПадающейЛентой()
	Возврат Новый СлужбаЛичныхУведомлений(Поводы(), Новый ФейкПадающейЛенты(),
		Желудь("СлужбаПочты"), Желудь("АдресИнстанса"), ЛогТестов());
КонецФункции

// Канал с настоящей лентой и почтой, у которой отказывает постановка письма в фон:
// почтовый слой отдаёт отказ кодом, а вот сам фоновый запуск — обычный вызов и падает.
Функция КаналСПадающимФоном()

	Почта = Новый СлужбаПочты(Желудь("НастройкиПочты"), Желудь("ОтправительПисем"),
		Желудь("ПочтовыйАдрес"), Новый ЗапускВФонеПадающий(), ЛогТестов());

	Возврат Новый СлужбаЛичныхУведомлений(Поводы(), Лента(), Почта,
		Желудь("АдресИнстанса"), ЛогТестов());

КонецФункции

// То же рассмотрение заявок, но с каналом, чья лента отказывает: решение обязано пройти.
Функция РассмотрениеСПадающейЛентой()

	Возврат Новый РассмотрениеВходящих(Желудь("СервисВходящих"), Желудь("СервисПубликации"),
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Желудь("СервисПрав"), Желудь("СервисПравДоступа"), Желудь("СервисПользователей"),
		КаналСПадающейЛентой(), Желудь("ГвардКлюча"), ЛогТестов());

КонецФункции

Функция ВитринаЛенты()
	Возврат Новый ВитринаУведомлений(UI.Кит, UI.РендерерНастроек, UI.Тексты);
КонецФункции

// Обрамление хаба со СВОИМИ счётчиками: граф рендера собирается без доменных желудей,
// и меню в нём остаётся без чисел по построению.
Функция ОбрамлениеСоСчётчиками()

	Возврат Новый ОбрамлениеХаба(UI.Бренд, UI.Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), UI.Тексты,
		UI.АдресаКаталога, Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит, UI.Подсветка,
		Лента(), Рассмотрение());

КонецФункции

// Единое меню, каким его получил бы этот человек на любой странице хаба.
Функция МенюХаба(Знач Человек)
	Возврат ОбрамлениеСоСчётчиками().Обрамление(КонтекстКабинета(Человек)).МенюХаба;
КонецФункции

// Обрамление С ПРАВАМИ — так его собирает боевой контейнер. Порог пункта «Настройки хаба»
// держится именно на этом желуде, а не на флаге контекста.
Функция ОбрамлениеСПравами()

	Возврат Новый ОбрамлениеХаба(UI.Бренд, UI.Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), UI.Тексты,
		UI.АдресаКаталога, Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит, UI.Подсветка,
		Лента(), Рассмотрение(), Желудь("СервисПрав"));

КонецФункции

// Меню на ПУБЛИЧНОЙ странице: «Приватная» Ложь, и по умолчанию экран об админских дорогах
// не просит. Ровно так контроллер каталога и собирает контекст.
Функция МенюНаПубличнойСтранице(Знач Человек, Знач ПоказатьАдмин = Ложь)

	Контекст = Новый Структура("Пользователь, КукиЗапроса, ПоказатьАдмин, Приватная",
		Человек, Неопределено, ПоказатьАдмин, Ложь);
	Возврат ОбрамлениеСПравами().Обрамление(Контекст).МенюХаба;

КонецФункции

Функция КонтекстКабинета(Знач Человек)
	Возврат Новый Структура("Пользователь, КукиЗапроса, ПоказатьАдмин, Приватная",
		Человек, Неопределено, Ложь, Истина);
КонецФункции

Функция АдресаДел(Знач Дела)

	Результат = Новый Массив();
	Для Каждого Дело Из Дела Цикл
		Результат.Добавить(Дело.Адрес);
	КонецЦикла;
	Возврат СтрСоединить(Результат, " ");

КонецФункции

Функция ПодписьДела(Знач Дела, Знач Адрес)
	Возврат ПолеДела(Дела, Адрес, "Подпись", "");
КонецФункции

Функция СчётДела(Знач Дела, Знач Адрес)
	Возврат ПолеДела(Дела, Адрес, "Счётчик", 0);
КонецФункции

// Чем число дела зовётся в речи: голая цифра на бейдже — картинка для глаза.
Функция РечьДела(Знач Дела, Знач Адрес)
	Возврат ПолеДела(Дела, Адрес, "ПодписьСчётчика", "");
КонецФункции

Функция ПолеДела(Знач Дела, Знач Адрес, Знач Имя, Знач ПоУмолчанию)

	Для Каждого Дело Из Дела Цикл
		Значение = Неопределено;
		Если Дело.Адрес = Адрес И Дело.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат ПоУмолчанию;

КонецФункции

// Разметка виджета главной: свежие непрочитанные берутся отбором, а не фильтром в памяти.
Функция РазметкаВиджета(Знач Человек)

	Витрина = ВитринаЛенты();
	Возврат Витрина.Виджет(Лента().Свежие(Человек, Витрина.ПределВиджета()),
		Лента().Непрочитано(Человек), "/me/notifications");

КонецФункции

// Разметка экрана ленты — то, что увидит человек.
Функция РазметкаЛенты(Знач Человек)

	Модель = Новый Структура();
	Модель.Вставить("Ключ", "notifications");
	Модель.Вставить("Заголовок", "Уведомления");
	Модель.Вставить("Объект", "");
	Модель.Вставить("Пояснение", "");
	Модель.Вставить("Разделы", Новый Массив());
	Модель.Вставить("Уведомления", Новый Массив());
	Модель.Вставить("Хлебные", Новый Массив());
	Модель.Вставить("Секции", ВитринаЛенты().Секции(
		Новый Структура("Записи, Адрес, Токен, Непрочитано",
			МояЛента(Человек), "/me/notifications", "csrf-токен",
			Лента().Непрочитано(Человек))));

	Возврат UI.РендерерНастроек.Отрисовать(Модель);

КонецФункции

Процедура НастроитьПочту()

	Настройки().Установить("oshub.instance.url", "https://hub.example.com", "тест");
	Настройки().Установить("oshub.mail.enabled", Истина, "тест");
	Настройки().Установить("oshub.mail.smtp.host", "smtp.example.com", "тест");
	Настройки().Установить("oshub.mail.from", "hub@example.com", "тест");
	Настройки().Установить("oshub.auth.email.confirm.enabled", Истина, "тест");

КонецПроцедуры

Процедура ВыключитьПочту()
	Настройки().Установить("oshub.mail.enabled", Ложь, "тест");
КонецПроцедуры

// Принципал СЕССИИ браузера: ключа нет, рамки ключа прозрачны.
Функция СессияПринципал(Знач Пользователь)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, "session", "", 0, Неопределено);
КонецФункции

Функция СоздатьПул()
	Возврат Желудь("СервисПулов").СоздатьПул(УникальноеИмя("pool"), "custom", "public");
КонецФункции

Функция СоздатьПользователя(Знач РольХаба = "user")

	Польз = Желудь("ХранилищеПользователей").СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("u");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;

КонецФункции

Функция СоздатьАдмина()
	Возврат СоздатьПользователя("admin");
КонецФункции

Функция СоздатьМейнтейнера(Знач Пул)

	Польз = СоздатьПользователя();
	Участник = Желудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Польз.Идентификатор;
	Участник.Роль = "owner"; // легаси-пресет нормализуется в мейнтейнера
	Участник.Сохранить();
	Возврат Польз;

КонецФункции

// Кладёт заявку во «входящие» ШТАТНЫМ путём — push без прав, а не записью в хранилище.
Функция ПодатьЗаявку(Знач Пул, Знач Заявитель, Знач ИмяПакета, Знач Версия)

	Данные = ПостроитьOspxДанные(ИмяПакета, Версия);
	Результат = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Заявитель, "");
	Если Результат.Код <> 202 Тогда
		ВызватьИсключение СтрШаблон("Заявка не принята (%1): %2",
			Результат.Код, Результат.Сообщение);
	КонецЕсли;
	Возврат Результат.Заявка;

КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия)

	Возврат Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия);

КонецФункции

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

// Боевой SMTP-отправитель носит то же прозвище, что фейк, — вдвоём они спорили бы
// за одно место в контейнере.
Процедура ПодключитьПочтуБезSMTP(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если ФайлКласса.ИмяБезРасширения <> "ОтправительПисемSMTP" Тогда
			ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.канал");
КонецФункции

#КонецОбласти
