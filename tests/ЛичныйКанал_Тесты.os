#КонецОбласти

#Область СекретВЛентуНеПопадает

&Тест
Процедура ПоводССекретомСледаВЛентеНеОставляет() Экспорт

	Секретные = Новый Массив();
	Для Каждого Повод Из Поводы().Все() Цикл
		Если Поводы().НесётСекрет(Повод) И Поводы().ОставляетСлед(Повод) Тогда
			Секретные.Добавить(Повод);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Секретные, ", "),
		"поводы, у которых письмо несёт секрет, а запись ложится в ленту").Равно("");

КонецПроцедуры

&Тест
Процедура УведомлениеСекретнымПоводомВЛентуНеПишется() Экспорт

	Человек = СоздатьПользователя();

	Итог = Канал().Уведомить(Человек, Поводы().ПодтверждениеАдреса(),
		"Подтвердите адрес", "Ссылка: oshub_cnf_1_секрет");

	Ожидаем.Что(Итог.Записано, "секрет в ленту не лёг").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "повод развёрнут кодом").Равно(Канал().ПричинаЧужойПовод());
	Ожидаем.Что(МояЛента(Человек).Количество(), "лента пуста").Равно(0);
	Ожидаем.Что(Транспорт.Количество(), "и письма этой дверью не ушло").Равно(0);

КонецПроцедуры

&Тест
Процедура НеизвестныйПоводНеХодитНиОднойДверью() Экспорт

	Человек = СоздатьПользователя();
	Выдуманный = "выдуманный.повод";

	Ожидаем.Что(Поводы().Известен(Выдуманный), "повода в каталоге нет").ЭтоЛожь();

	ВЛенту = Канал().Уведомить(Человек, Выдуманный, "Заголовок", "Текст");
	Ожидаем.Что(ВЛенту.Записано, "неизвестный повод в ленту не лёг").ЭтоЛожь();
	Ожидаем.Что(ВЛенту.Причина, "и назван своим кодом, а не «чужой дверью»")
		.Равно(Канал().ПричинаНеизвестныйПовод());

	Письмом = Канал().ПисьмоСоСсылкой(Человек, Выдуманный, "Тема", "Текст");
	Ожидаем.Что(Письмом.Отправлено, "и письмом не ушёл").ЭтоЛожь();
	Ожидаем.Что(Письмом.Причина, "тем же кодом")
		.Равно(Канал().ПричинаНеизвестныйПовод());

	Ожидаем.Что(МояЛента(Человек).Количество(), "лента пуста").Равно(0);
	Ожидаем.Что(Транспорт.Количество(), "писем нет").Равно(0);

