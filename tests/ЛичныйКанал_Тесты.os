&Тест
Процедура ЧужаяЛентаНеЧитаетсяИНеОтмечается() Экспорт

	Свой = СоздатьПользователя();
	Чужой = СоздатьПользователя();

	Лента().Записать(Свой, Поводы().ЗаявкаОдобрена(), "Моё", "Текст моего");
	Лента().Записать(Чужой, Поводы().ЗаявкаОдобрена(), "Чужое", "Текст чужого");

	МоиЗаписи = МояЛента(Свой);
	Ожидаем.Что(МоиЗаписи.Количество(), "в своей ленте только своё").Равно(1);
	Ожидаем.Что(МоиЗаписи[0].Заголовок, "и это именно своё").Равно("Моё");

	Лента().ОтметитьВсеПрочитанными(Свой);

	Ожидаем.Что(Лента().Непрочитано(Чужой),
