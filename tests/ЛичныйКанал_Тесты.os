// Личный канал хаба: исход заявки на имя доходит до заявителя лентой кабинета и письмом,
// хаб без почты сообщает лентой, отказ почты и отказ ленты рассмотрение не роняют, чужая
// лента не читается, а письма с одноразовой ссылкой следа в ленте не оставляют.
// Живого SMTP нет: транспорт подменён фейком.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать autumn-logos
#Использовать oscript-ui
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем КаталогСборки;
Перем Транспорт;      // ФейкОтправителяПисем
Перем UI;             // СборкаUI — граф рендера для проверки разметки ленты
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("основа", "Классы")));

	// SSRF-гейт апстримов: СервисПулов требует валидатор адреса обязательно
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтФикстура = Новый ГейтАпстримов();
	ГейтФикстура.Подключить();

	// вход и права — поимённо: модуль целиком тянет стартовые рогатки, которым в юнит-
	// контейнере не на чем работать
	Для Каждого Имя Из СтрРазделить("СверкаСекретов,СборкаПубличнойСсылки,"
		+ "СервисПрав,СервисГрупп,СервисПравДоступа,"
		+ "ПроверяющийGitHub,СервисТокенов,ГейтТокена,ГвардКлюча,НормализаторУчётки,"
		+ "ПолитикаПароля,ЛетописьУчёток,ОтказыУчётки,АдресУчётки,СервисПользователей,"
		+ "УчёткаПоНазванному,ПолитикаПарольногоВхода,"
		+ "ПолитикаПодтвержденияEmail,АдресПодтверждения,ПисьмоПодтверждения,"
		+ "СекретПодтверждения,КодыПодтверждения,ЗаявкиПодтверждения,"
		+ "СервисПодтвержденияEmail,"
		+ "СервисПриглашений,АдресПриглашения,ПисьмоВосстановления,ВосстановлениеПароля",
		",") Цикл
		ПоискКлассов.Подключить(КаталогМодулей, Имя);
	КонецЦикла;

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	КаталогСети = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("сеть", "Классы"));
	КаталогТелеметрии = ОбъединитьПути(КаталогМодулей,
		ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПроб = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСети, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСети, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьВсе(КаталогТелеметрии);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПроб, "ГотовностьХаба.os"));

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	Для Каждого Имя Из СтрРазделить("ВидыПроверок,НастройкиПодсистем,РеестрНастроек,"
		+ "СервисНастроек,ВалидаторНастроек,АдресИнстанса", ",") Цикл
		ПоискКлассов.Подключить(КаталогНастроек, Имя);
	КонецЦикла;

	// письмо уходит фоновым заданием, а набор смотрит исход сразу — фон синхронный
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	// транспорт подменяется ДО модуля почты: боевой SMTP-отправитель носит то же прозвище
	РеестрФикстур.Подключить("ФейкОтправителяПисем");
	ПодключитьПочтуБезSMTP(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("почта", "Классы")));

	// сам канал — настоящий: набор про него
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("уведомления", "Классы")));

	КаталогПубликации = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("публикация", "Классы"));
	Для Каждого Имя Из СтрРазделить("СервисВходящих,СтражИздателейCI,МаскаРефа,"
		+ "КороткаяФормаДоверия,ИмяЗаписиДоверия,ВидРефаДоверия,СрокТокенаCI,"
		+ "АудиторияТокенаCI,СервисДоверияCI,МестоВПуле,СервисПубликации,"
		+ "РассмотрениеВходящих,СервисРезервированияИмён", ",") Цикл
		ПоискКлассов.Подключить(КаталогПубликации, Имя);
	КонецЦикла;

	РеестрФикстур.Подключить("ФейкПроверяющийGitHub");
	РеестрФикстур.Подключить("ФейкПроверяющийПодписиCI");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("ФейкПадающейЛенты");
	РеестрФикстур.Подключить("ЗапускВФонеПадающий");

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-канал-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "личный-канал-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Транспорт = Желудь("ОтправительПисем");

	// граф рендера собирается ПОСЛЕ контейнера: витрине нужен кит, а не доменные желуди
	РеестрФикстур.Подключить("СборкаUI");
	КаталогИнтерфейса = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("интерфейс", "Классы"));
	Сборка = Новый СборкаUI();
	UI = Сборка.Собрать(КаталогИнтерфейса);
	ПоискКлассов.Подключить(КаталогИнтерфейса, "ВитринаУведомлений");

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьХаб() Экспорт

	НастроитьПочту();
	Транспорт.ПадатьНаОтправке(Ложь);
	Транспорт.Очистить();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область СборкаКанала

&Тест
Процедура ЖелудиКаналаСобраны() Экспорт

	Имена = "ПоводыУведомлений,ЛентаУведомлений,СлужбаЛичныхУведомлений,ХранилищеЛичныхУведомлений";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ИсходЗаявки

&Тест
Процедура ОдобрениеКладётСобытиеВЛентуЗаявителяИШлётПисьмо() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	ИмяПакета = УникальноеИмя("ok");
	Заявка = ПодатьЗаявку(Пул, Заявитель, ИмяПакета, "1.0.0");

	Итог = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);
	Ожидаем.Что(Итог.Успех, "заявка одобрена: " + Итог.Сообщение).ЭтоИстина();

	Лента = МояЛента(Заявитель);
	Ожидаем.Что(Лента.Количество(), "заявителю записано одно событие").Равно(1);
	Ожидаем.Что(Лента[0].Повод, "повод — одобрение заявки")
		.Равно(Поводы().ЗаявкаОдобрена());
	Ожидаем.Что(Лента[0].Заголовок, "в заголовке названо имя").Содержит(ИмяПакета);
	Ожидаем.Что(Лента[0].Текст, "в тексте назван пул").Содержит(Пул.Имя);
	Ожидаем.Что(Лента[0].Ссылка, "запись ведёт на страницу пакета")
		.Равно("/" + Пул.Имя + "/" + ИмяПакета);
	Ожидаем.Что(Лента[0].Прочитано = Истина, "новое событие непрочитано").ЭтоЛожь();

	Ожидаем.Что(Транспорт.Количество(), "письмо ушло ровно одно").Равно(1);
	Ожидаем.Что(Транспорт.Последнее().Кому, "письмо ушло на адрес заявителя")
		.Равно(Заявитель.Email);
	Ожидаем.Что(Транспорт.Последнее().Текст, "в письме есть адрес хаба и ссылка на пакет")
		.Содержит("https://hub.example.com/" + Пул.Имя + "/" + ИмяПакета);

	// решение адресовано ЗАЯВИТЕЛЮ, а не тому, кто его принял
	Ожидаем.Что(МояЛента(Мейнтейнер).Количество(),
		"рассматривающему в ленту ничего не легло").Равно(0);

КонецПроцедуры

&Тест
Процедура ОтклонениеНесётЗаявителюПричинуОтказа() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальноеИмя("rej"), "1.0.0");

	Итог = Рассмотрение().Отклонить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор,
		"имя занято другим проектом");
	Ожидаем.Что(Итог.Успех, "заявка отклонена").ЭтоИстина();

	Лента = МояЛента(Заявитель);
	Ожидаем.Что(Лента.Количество(), "заявителю записано одно событие").Равно(1);
	Ожидаем.Что(Лента[0].Повод, "повод — отказ по заявке")
		.Равно(Поводы().ЗаявкаОтклонена());
	Ожидаем.Что(Лента[0].Текст, "причина отказа названа в уведомлении")
		.Содержит("имя занято другим проектом");
	Ожидаем.Что(Лента[0].Ссылка, "вести некуда: пакета не появилось").Равно("");

	Ожидаем.Что(Транспорт.Последнее().Текст, "и письмо несёт ту же причину")
		.Содержит("имя занято другим проектом");

КонецПроцедуры

&Тест
Процедура ОтклонениеБезПричиныГоворитЧтоПричинуНеНазвали() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальноеИмя("silent"), "1.0.0");

	Рассмотрение().Отклонить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор, "");

	Ожидаем.Что(МояЛента(Заявитель)[0].Текст, "молчание названо словами, а не пустотой")
		.Содержит("Причину рассматривающий не назвал");

КонецПроцедуры

&Тест
Процедура ХабБезПочтыВсёРавноПишетВЛенту() Экспорт

	ВыключитьПочту();

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	Заявка = ПодатьЗаявку(Пул, Заявитель, УникальноеИмя("nomail"), "1.0.0");

	Итог = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);

	Ожидаем.Что(Итог.Успех, "одобрение прошло и без почты: " + Итог.Сообщение).ЭтоИстина();
	Ожидаем.Что(МояЛента(Заявитель).Количество(),
		"человек всё равно видит, что с ним произошло").Равно(1);
	Ожидаем.Что(Транспорт.Количество(), "письма при этом нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ОтказПочтыНеРоняетРассмотрение() Экспорт

	Транспорт.ПадатьНаОтправке(Истина);

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	ИмяПакета = УникальноеИмя("smtpdown");
	Заявка = ПодатьЗаявку(Пул, Заявитель, ИмяПакета, "1.0.0");

	Итог = Рассмотрение().Одобрить(СессияПринципал(Мейнтейнер), Заявка.Идентификатор);

	Ожидаем.Что(Итог.Успех, "упавший SMTP решение не отменил: " + Итог.Сообщение).ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета) <> Неопределено,
		"пакет опубликован").ЭтоИстина();
	Ожидаем.Что(МояЛента(Заявитель).Количество(), "и лента запись получила").Равно(1);

КонецПроцедуры

&Тест
Процедура ОтказЛентыНеРоняетРассмотрение() Экспорт

	Пул = СоздатьПул();
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	Заявитель = СоздатьПользователя();
	ИмяПакета = УникальноеИмя("nofeed");
	Заявка = ПодатьЗаявку(Пул, Заявитель, ИмяПакета, "1.0.0");

	Итог = РассмотрениеСПадающейЛентой().Одобрить(СессияПринципал(Мейнтейнер),
		Заявка.Идентификатор);

	Ожидаем.Что(Итог.Успех, "несохранённое уведомление решение не отменило: "
		+ Итог.Сообщение).ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета) <> Неопределено,
		"пакет опубликован").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЛентаЧеловека

&Тест
Процедура КаналГаситОтказЛентыИНазываетЕгоКодом() Экспорт

	Человек = СоздатьПользователя();
	Итог = КаналСПадающейЛентой().Уведомить(Человек, Поводы().ЗаявкаОдобрена(),
		"Заголовок", "Текст");

	Ожидаем.Что(Итог.Записано, "лента запись не приняла").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "отказ ленты назван кодом")
		.Равно(Канал().ПричинаЛентаНеПриняла());

КонецПроцедуры

&Тест
Процедура УпавшийФоновыйЗапускПисьмаКаналНеРонает() Экспорт

	Человек = СоздатьПользователя();

	Итог = КаналСПадающимФоном().Уведомить(Человек, Поводы().ЗаявкаОдобрена(),
		"Заявка одобрена", "Подробности");

	Ожидаем.Что(Итог.Записано, "лента запись приняла").ЭтоИстина();
	Ожидаем.Что(Итог.Отправлено, "письмо не ушло").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "отказ назван кодом почтового слоя")
		.Равно(Желудь("СлужбаПочты").ПричинаОтказ());
	Ожидаем.Что(МояЛента(Человек).Количество(), "событие человек всё равно видит").Равно(1);

КонецПроцедуры

&Тест
Процедура ПрочитанноеОтличимоОтНепрочитанного() Экспорт

	Человек = СоздатьПользователя();
	Лента().Записать(Человек, Поводы().ЗаявкаОдобрена(), "Первое", "Текст первого");
	Лента().Записать(Человек, Поводы().ЗаявкаОтклонена(), "Второе", "Текст второго");

	Ожидаем.Что(Лента().Непрочитано(Человек), "оба события непрочитаны").Равно(2);

	Отмечено = Лента().ОтметитьВсеПрочитанными(Человек);

	Ожидаем.Что(Отмечено, "отмечены оба").Равно(2);
	Ожидаем.Что(Лента().Непрочитано(Человек), "непрочитанного не осталось").Равно(0);
	Для Каждого Запись Из МояЛента(Человек) Цикл
		Ожидаем.Что(Запись.Прочитано = Истина,
			СтрШаблон("запись «%1» прочитана", Запись.Заголовок)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Лента().ОтметитьВсеПрочитанными(Человек),
		"повторная отметка ничего не трогает").Равно(0);

КонецПроцедуры

