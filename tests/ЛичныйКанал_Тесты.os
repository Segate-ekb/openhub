#Область ЭкранЛенты

&Тест
Процедура ЭкранЛентыПомечаетНепрочитанноеИНеПомечаетПрочитанное() Экспорт

	Человек = СоздатьПользователя();
	Лента().Записать(Человек, Поводы().ЗаявкаОдобрена(), "Заявка одобрена",
		"Версия опубликована", "/pool/pkg");

	СНепрочитанным = РазметкаЛенты(Человек);
	Ожидаем.Что(СНепрочитанным, "непрочитанное помечено плашкой").Содержит("новое");
	Ожидаем.Что(СНепрочитанным, "заголовок события на экране").Содержит("Заявка одобрена");
	Ожидаем.Что(СНепрочитанным, "запись ведёт по своей ссылке").Содержит("/pool/pkg");
	Ожидаем.Что(СНепрочитанным, "есть чем отметить прочитанным")
		.Содержит("Отметить всё прочитанным");

	Лента().ОтметитьВсеПрочитанными(Человек);

	Прочитанное = РазметкаЛенты(Человек);
	Ожидаем.Что(СтрНайти(Прочитанное, "новое"), "прочитанное плашки не носит").Равно(0);
	Ожидаем.Что(СтрНайти(Прочитанное, "Отметить всё прочитанным"),
		"и кнопки без работы на экране нет").Равно(0);

КонецПроцедуры

