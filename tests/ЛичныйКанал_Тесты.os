Процедура ВиджетГлавнойПоявляетсяТолькоПриНепрочитанном() Экспорт

	Человек = СоздатьПользователя();

	Ожидаем.Что(РазметкаВиджета(Человек), "пустой ленте виджет не рисуется").Равно("");

	Лента().Записать(Человек, Поводы().ЗаявкаОдобрена(), "Заявка одобрена", "Подробности");

	Виджет = РазметкаВиджета(Человек);
