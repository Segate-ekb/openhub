// НФТ-ИНТФ-007: значение, которое человек набрал в форме или увидел в адресе, доезжает
// до хаба тем же. Здесь — двери, которые читает САМ хаб (форма экрана, тело формы API,
// подсветка раздела) и свойство собранной им ссылки: она читается одним процентным
// декодированием, то есть одинаково обоими серверами winow. Круг «ссылка → живой экран»
// стережёт НастройкиДомены_Тесты.ОтборДоезжаетДоЖивогоЭкранаСобраннойХабомСсылкой.

#Использовать asserts
#Использовать url
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Форма;          // РазборФормы (web-ui)
Перем ОтветыВхода;    // ОтветыAPI (вход)
Перем Подсветка;      // ПодсветкаТекущейДороги (web-ui)
Перем АдресаПакетов;  // АдресаКаталога (web-ui)
Перем ВозвратВхода;   // ВозвратПослеВхода (вход)
Перем Ссылки;         // ПараметрыСсылки (основа) — одно место, ставящее параметр на адрес

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "РазборФормы");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "ПодсветкаТекущейДороги");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "АдресаКаталога");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ОтветыAPI");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ВозвратПослеВхода");

	Форма = Новый РазборФормы();
	ОтветыВхода = Новый ОтветыAPI(Новый ЗаголовкиHTTP());
	Подсветка = Новый ПодсветкаТекущейДороги();
	АдресаПакетов = Новый АдресаКаталога();
	ВозвратВхода = Новый ВозвратПослеВхода();
	Ссылки = Новый ПараметрыСсылки();

КонецПроцедуры

#Область КаждаяДверьЧитаетОдинаково

// Набранное в форме экрана и то же самое в теле формы API — одно значение. Двери
// расходились: одна переводила «+» в пробел, вторая резала значение по первому «=».
&Тест
Процедура ФормаЭкранаИТелоФормыAPIЧитаютОдноИТоЖе() Экспорт

	Расхождения = Новый Массив();

	Для Каждого Набранное Из НаборЗначений() Цикл

		Тело = "q=" + ВПараметрФормы(Набранное);
		СЭкрана = Форма.Поле(Форма.Разобрать(Тело), "q");
		ИзAPI = ОтветыВхода.Поле(ОтветыВхода.РазобратьТело(Тело, ЗаголовкиФормы()), "q");

		Если СЭкрана <> Набранное ИЛИ ИзAPI <> Набранное Тогда
			Расхождения.Добавить(СтрШаблон("«%1»: экран дал «%2», API дал «%3»",
				Набранное, СЭкрана, ИзAPI));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"обе двери читают набранное одинаково").Равно("");

КонецПроцедуры

// «+» это пробел в обеих формах, которые читает САМ хаб. Строку запроса экрана читает
// каркас, а не хаб, — её круг стережёт живой набор
// (НастройкиДомены_Тесты.ОтборДоезжаетДоЖивогоЭкранаСобраннойХабомСсылкой).
&Тест
Процедура ПлюсЭтоПробелВОбеихФормах() Экспорт

	Ожидаем.Что(Форма.Поле(Форма.Разобрать("q=a+b"), "q"),
		"форма экрана").Равно("a b");
	Ожидаем.Что(ОтветыВхода.Поле(ОтветыВхода.РазобратьТело("q=a+b", ЗаголовкиФормы()), "q"),
		"тело формы API").Равно("a b");

КонецПроцедуры

// «=» внутри значения — часть значения: пароль и маска отбора им пользуются штатно.
&Тест
Процедура РавноВнутриЗначенияЗначениеНеРежет() Экспорт

	Ожидаем.Что(Форма.Поле(Форма.Разобрать("пароль=x=y=z"), "пароль"),
		"форма экрана").Равно("x=y=z");
	Ожидаем.Что(ОтветыВхода.Поле(
		ОтветыВхода.РазобратьТело("password=x=y=z", ЗаголовкиФормы()), "password"),
		"тело формы API").Равно("x=y=z");

КонецПроцедуры

// Процент декодируется РОВНО ОДИН раз: «%252F» это текст «%2F», а не косая.
&Тест
Процедура ПроцентДекодируетсяОдинРаз() Экспорт

	Ожидаем.Что(Форма.Поле(Форма.Разобрать("q=%252F"), "q"),
		"форма экрана").Равно("%2F");
	Ожидаем.Что(ОтветыВхода.Поле(ОтветыВхода.РазобратьТело("q=%252F", ЗаголовкиФормы()), "q"),
		"тело формы API").Равно("%2F");
	Ожидаем.Что(Форма.Поле(Форма.Разобрать("q=%2F"), "q"),
		"а «%2F» это косая").Равно("/");

КонецПроцедуры

// Повторяющееся имя поля не теряет порядок: группа флажков приезжает столькими парами,
// сколько отмечено, и читается в порядке отправки.
&Тест
Процедура ПовторяющеесяИмяСохраняетПорядок() Экспорт

	Значения = Форма.Значения("роль=админ&роль=автор&роль=читатель", "роль");

	Ожидаем.Что(Значения.Количество(), "все три значения на месте").Равно(3);
	Ожидаем.Что(СтрСоединить(Значения, ","), "и в порядке отправки")
		.Равно("админ,автор,читатель");

КонецПроцедуры

// Поле без «=» это поле с пустым значением, а не отсутствующее поле.
&Тест
Процедура ПолеБезЗначенияЧитаетсяПустым() Экспорт

	Ожидаем.Что(Форма.Поле(Форма.Разобрать("флаг&q=x"), "флаг", "НЕТ"),
		"форма экрана").Равно("");
	Ожидаем.Что(ОтветыВхода.Поле(ОтветыВхода.РазобратьТело("флаг&q=x", ЗаголовкиФормы()),
		"флаг", "НЕТ"), "тело формы API").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СсылкаХабаЧитаетсяХабом

// Ссылка, собранная хабом, читается им же без потерь — иначе отбор не переживает
// ни перезагрузку страницы, ни возврат после мутации.
&Тест
Процедура ОтборКаталогаДоезжаетСсылкойОбратно() Экспорт

	Расхождения = Новый Массив();

	Для Каждого Набранное Из НаборЗначений() Цикл

		Прочитано = Новый URL(АдресаПакетов.Каталог(Набранное)).ПараметрыЗапроса().Получить("pool");
		Если ?(Прочитано = Неопределено, "", Прочитано) <> Набранное Тогда
			Расхождения.Добавить(СтрШаблон("«%1» вернулось как «%2»", Набранное, Прочитано));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "), "круг ссылки сошёлся").Равно("");

КонецПроцедуры

// ⚠ Ссылку экрана читает КАРКАС, а у winow два сервера с разными правилами: нативный
// (на нём хаб и работает) считает «+» пробелом, прикладной — нет. Ссылка, в которой «+»
// вместо пробела не встречается вовсе, читается обоими одинаково; на том и стоит «%20»
// в ПараметрыСсылки. Инвариант проверяется на самой ссылке — она обязана читаться ОДНИМ
// процентным декодированием, без знания, какой сервер поднят.
&Тест
Процедура СсылкаЭкранаОдинаковаДляОбоихСерверовКаркаса() Экспорт

	Расхождения = Новый Массив();

	Для Каждого Набранное Из НаборЗначений() Цикл

		Ссылка = АдресаПакетов.Каталог(Набранное);
		Прочитано = ЗначениеПараметраПроцентами(Ссылка, "pool");
		Если ?(Прочитано = Неопределено, "", Прочитано) <> Набранное Тогда
			Расхождения.Добавить(СтрШаблон("«%1» в ссылке «%2» прочлось как «%3»",
				Набранное, Ссылка, Прочитано));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"ссылка каталога читается одним процентным декодированием").Равно("");

КонецПроцедуры

// Одно место ставит параметр на адрес — им же собраны отбор списка, поиск учёток
// и возврат после мутации. Пробел в набранном встречается там чаще всего: администратор
// ищет «два слова» и обязан увидеть их же, а не «два+слова».
&Тест
Процедура ПараметрНаАдресеЧитаетсяПроцентамиПоЛюбомуЗначению() Экспорт

	Расхождения = Новый Массив();

	Для Каждого Набранное Из НаборЗначений() Цикл

		Ссылка = Ссылки.Установить("/hub/settings/users?saved=1", "q", Набранное);
		Прочитано = ЗначениеПараметраПроцентами(Ссылка, "q");
		Если ?(Прочитано = Неопределено, "", Прочитано) <> Набранное Тогда
			Расхождения.Добавить(СтрШаблон("«%1» в ссылке «%2» прочлось как «%3»",
				Набранное, Ссылка, Прочитано));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"параметр, поставленный на адрес, читается процентами").Равно("");
	Ожидаем.Что(СтрЧислоВхождений(Ссылки.Установить("/hub/settings/users?saved=1", "q", "два слова"),
		"?"), "прежний параметр адреса на месте, второго «?» нет").Равно(1);
	Ожидаем.Что(ЗначениеПараметраПроцентами(
		Ссылки.Установить("/hub/settings/users?saved=1", "q", "два слова"), "saved"),
		"и он не потерян").Равно("1");

КонецПроцедуры

// Адрес возврата уезжает в параметр целиком — вместе со своим собственным запросом.
&Тест
Процедура АдресВозвратаДоезжаетСоСвоимЗапросом() Экспорт

	Собрано = ВозвратВхода.СВозвратом("/login", "/cli/login?user_code=a+b");

	Ожидаем.Что(Новый URL(Собрано).ПараметрыЗапроса().Получить(ВозвратВхода.ИмяПараметра()),
		"чужой запрос внутри параметра — часть значения")
		.Равно("/cli/login?user_code=a+b");

КонецПроцедуры

// Второго «?» в ссылке не появляется, каким бы ни был исходный адрес.
&Тест
Процедура ВозвратНеСтавитВторойЗнакВопроса() Экспорт

	Собрано = ВозвратВхода.СВозвратом("/login/oidc/github?preset=gh", "/me/tokens");

	Ожидаем.Что(СтрЧислоВхождений(Собрано, "?"), "знак вопроса в адресе ровно один").Равно(1);
	Ожидаем.Что(Новый URL(Собрано).ПараметрыЗапроса().Получить("preset"),
		"прежний параметр не потерян").Равно("gh");
	Ожидаем.Что(Новый URL(Собрано).ПараметрыЗапроса().Получить(ВозвратВхода.ИмяПараметра()),
		"и новый на месте").Равно("/me/tokens");

КонецПроцедуры

#КонецОбласти

// Базовый адрес инсталляции задаёт администратор, и ссылкой он бывает не всегда:
// «ПроверитьАдрес» пропускает «https://ха|б». Приглашение по такому адресу выходит
// кривой ссылкой — но выходит, а не падает пятисоткой на выдаче.
&Тест
Процедура НегодныйБазовыйАдресНеРонитСборкуСсылки() Экспорт

	Собрано = Ссылки.Установить("https://ха|б/invite", "code", "два слова");

	Ожидаем.Что(Собрано, "адрес остался собой, параметр приклеен")
		.Равно("https://ха|б/invite?code=%D0%B4%D0%B2%D0%B0%20%D1%81%D0%BB%D0%BE%D0%B2%D0%B0");
	Ожидаем.Что(ЗначениеПараметраПроцентами(Собрано, "code"),
		"и читается тем же правилом").Равно("два слова");
	Ожидаем.Что(Ссылки.Установить("https://ха|б/invite?a=1", "code", "x"),
		"разделитель выбран по наличию «?»").Равно("https://ха|б/invite?a=1&code=x");

КонецПроцедуры

#Область ПодсветкаЧитаетТотЖеАдрес

// Меню горит на той ссылке, которую собрал сам хаб: подсветка читала строку запроса
// третьим разбором и не декодировала её вовсе.
&Тест
Процедура ПодсветкаУзнаётСобраннуюХабомСсылку() Экспорт

	Дороги = Новый Массив();
	Дороги.Добавить(Пункт("Каталог", "/packages"));
	Дороги.Добавить(Пункт("Мои пакеты", АдресаПакетов.Управляемые()));

	Подсветка.ОтметитьТекущую(АдресаПакетов.Управляемые(), Новый Массив(), Дороги);

	Ожидаем.Что(Активна(Дороги, "Мои пакеты"), "на своей ссылке горят «Мои пакеты»").ЭтоИстина();
	Ожидаем.Что(Активна(Дороги, "Каталог"), "и только они").ЭтоЛожь();

КонецПроцедуры

// Значение отбора в адресе может быть закодировано как угодно — пункт меню тот же.
&Тест
Процедура ПодсветкаНеЗависитОтЗаписиЗначения() Экспорт

	Дороги = Новый Массив();
	Дороги.Добавить(Пункт("Пул", "/packages?pool=мой пул"));

	Подсветка.ОтметитьТекущую("/packages?pool=%D0%BC%D0%BE%D0%B9+%D0%BF%D1%83%D0%BB",
		Новый Массив(), Дороги);

	Ожидаем.Что(Активна(Дороги, "Пул"),
		"процентная запись того же значения — тот же раздел").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Значение параметра, прочитанное ОДНИМ процентным декодированием: пары делятся по «&»
// и «=», обе стороны раскодируются процентами. Так читает строку запроса прикладной
// сервер winow; нативный сверх этого считает «+» пробелом, поэтому ссылка, проходящая
// эту проверку, одинакова для обоих. Живой круг стережёт НастройкиДомены_Тесты.
Функция ЗначениеПараметраПроцентами(Знач Ссылка, Знач Имя)

	Части = СтрРазделить(Строка(Ссылка), "?", Истина);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Пара Из СтрРазделить(Части[1], "&", Ложь) Цикл
		Разделитель = СтрНайти(Пара, "=");
		СыроеИмя = ?(Разделитель = 0, Пара, Лев(Пара, Разделитель - 1));
		СыроеЗначение = ?(Разделитель = 0, "", Сред(Пара, Разделитель + 1));
		Если Процентами(СыроеИмя) = Имя Тогда
			Возврат Процентами(СыроеЗначение);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Процентами(Знач Значение)
	Возврат РаскодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Значения из НФТ-ИНТФ-007: каждое ломало хотя бы одну дверь.
Функция НаборЗначений()

	Значения = Новый Массив();
	Значения.Добавить("a+b");
	Значения.Добавить("a b");
	Значения.Добавить("x=y=z");
	Значения.Добавить("50%");
	Значения.Добавить("%2F");
	Значения.Добавить("кириллица");
	Значения.Добавить("");
	Возврат Значения;

КонецФункции

// Значение в том виде, в каком его пришлёт браузер формой.
Функция ВПараметрФормы(Знач Значение)
	Возврат КодированиеURL.КодироватьПараметрФормы(Строка(Значение));
КонецФункции

Функция ЗаголовкиФормы()

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Возврат Заголовки;

КонецФункции

Функция Пункт(Знач Подпись, Знач Адрес)
	Возврат Новый Структура("Подпись, Адрес, Иконка", Подпись, Адрес, "");
КонецФункции

Функция Активна(Знач Пункты, Знач Подпись)

	Для Каждого Пункт Из Пункты Цикл
		Если Пункт.Подпись = Подпись Тогда
			Возврат Пункт.Свойство("Активен") И Пункт.Активен = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти
