// Юнит-тесты удаления учётной записи: что уходит вместе с человеком (сессии, ключи,
// личности, заявки, членства, гранты, личное пространство), что остаётся жить
// (опубликованное в общих пулах — безымянным) и кого удалить нельзя.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;
Перем Засев;         // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба
Перем Стенд;         // фикстура СтендУчёток — учётка, её роль на пуле и ключ доступа

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные");
	// storage и publish — ради уборки пула: она сносит область файлов и входящие заявки,
	// а без них удаление личного пространства падает на пустой ссылке
	Слои.Подключить("хранилище, публикация, реестр, основа, наблюдаемость/телеметрия, события");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"),
			"СобытиеАудита");
	Исключение
	КонецПопытки;

	// почта — ради сборки: на ней стоит цикл подтверждения адреса, а на нём допуск ко входу
	Слои.Подключить("почта");
	// личный канал: через него ходят письма входа и исход заявки
	Слои.Подключить("уведомления, вход, права, настройки");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "удаление-учёток-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендУчёток(Поделка);

КонецПроцедуры

#Область ЧтоУходит

&Тест
Процедура УдалениеУноситУчёткуИЕёСессии() Экспорт

	Жертва = ЗавестиУчётку();
	Желудь("СлужбаСессий").Создать(Жертва.Идентификатор);

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.90");

	Ожидаем.Что(Пользователи().НайтиПоЛогину(Жертва.Логин) = Неопределено,
		"учётной записи больше нет").ЭтоИстина();
	Ожидаем.Что(Снято.Сессий, "сессия снята").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеСессий").ПолучитьПоПользовательИдентификаторРавно(
			Жертва.Идентификатор).Количество(), "в хранилище её тоже нет").Равно(0);

КонецПроцедуры

&Тест
Процедура УдалениеУноситКлючиДоступа() Экспорт

	Жертва = ЗавестиУчётку();
	Стенд.Ключ(Жертва, "", 0, "ключ-жертвы");

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.91");

	Ожидаем.Что(Снято.Ключей, "ключ снят").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеТокенов").ПолучитьПоПользовательИдентификаторРавно(
			Жертва.Идентификатор).Количество(), "и в хранилище пусто").Равно(0);

КонецПроцедуры

// Лента адресована учётке: без хозяина её записи стали бы уведомлениями для никого.
&Тест
Процедура УдалениеУноситЛентуУведомленийИНеТрогаетЧужую() Экспорт

	Жертва = ЗавестиУчётку();
	Сосед = ЗавестиУчётку();

	Лента = Желудь("ЛентаУведомлений");
	Поводы = Желудь("ПоводыУведомлений");
	Лента.Записать(Жертва, Поводы.ЗаявкаОдобрена(), "Заявка одобрена", "Подробности");
	Лента.Записать(Жертва, Поводы.ЗаявкаОтклонена(), "Заявка отклонена", "Причина");
	Лента.Записать(Сосед, Поводы.ЗаявкаОдобрена(), "Соседнее событие", "Подробности");

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.92");

	Ожидаем.Что(Снято.Уведомлений, "уведомления жертвы сняты").Равно(2);
	Ожидаем.Что(Желудь("ХранилищеЛичныхУведомлений").ЛентаУчётки(
			Жертва.Идентификатор).Количество(), "и в хранилище их не осталось").Равно(0);
	Ожидаем.Что(Лента.Мои(Сосед).Количество(), "чужая лента не тронута").Равно(1);

КонецПроцедуры

// Личное пространство равно логину и без хозяина не живёт: уходит целиком.
&Тест
Процедура УдалениеУноситЛичноеПространство() Экспорт

	Жертва = ЗавестиУчётку();
	Пользователи().ОбеспечитьЛичныйПул(Жертва);
	Ожидаем.Что(Пулы().НайтиПул(Жертва.Логин), "личный пул заведён").Существует();

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.92");

	Ожидаем.Что(Снято.Пулов, "пул снесён").Равно(1);
	Ожидаем.Что(Пулы().НайтиПул(Жертва.Логин) = Неопределено,
		"личного пространства больше нет").ЭтоИстина();

КонецПроцедуры

// Роль на ЧУЖОМ пуле снимается, а сам пул остаётся цел: он не принадлежит удаляемому.
&Тест
Процедура УдалениеСнимаетГрантыНоЧужойПулНеТрогает() Экспорт

	Жертва = ЗавестиУчётку();
	Чужой = Засев.ПулСервисом(УникальныеИмена.Имя("common"), "public", Цел(Админ().Идентификатор));

	Стенд.РольВПуле(Чужой, Жертва, "maintainer", "user");

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.93");

	Ожидаем.Что(Снято.Грантов, "грант снят").Равно(1);
	Ожидаем.Что(Пулы().НайтиПул(Чужой.Имя), "а чужой пул на месте").Существует();

КонецПроцедуры

#КонецОбласти

#Область КогоНельзя

// Себя не удаляют. Второй админ в сцене обязателен: без него сработала бы застава
// «последний администратор», и сторож зеленел бы не на той причине.
&Тест
Процедура СебяУдалитьНельзя() Экспорт

	Запасной = ЗавестиАдмина();

	Вердикт = Удаление().ПроверитьУдаление(Админ(), Админ());

	Ожидаем.Что(Вердикт.Успех, "себя не удаляют").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина, "и причина названа").Равно(Удаление().ПричинаСебе());

	Удаление().Удалить(Админ(), Запасной, "203.0.113.96"); // сцена возвращается к одному админу

КонецПроцедуры

&Тест
Процедура НеАдминНеУдаляетНикого() Экспорт

	Жертва = ЗавестиУчётку();
	Проситель = ЗавестиУчётку();

	Вердикт = Удаление().ПроверитьУдаление(Проситель, Жертва);

	Ожидаем.Что(Вердикт.Успех, "обычный пользователь учёток не сносит").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина).Равно(Удаление().ПричинаНеАдмин());

КонецПроцедуры

// Последний администратор неудаляем: без него хаб остаётся без хозяина, а мастер первого
// запуска открывается анониму.
&Тест
Процедура ПоследнегоАдминаУдалитьНельзяАПредпоследнегоМожно() Экспорт

	Первый = Админ();
	Второй = ЗавестиАдмина();

	// пока админов двое, второго удалить можно
	Ожидаем.Что(Удаление().ПроверитьУдаление(Первый, Второй).Успех,
		"второго админа удалить можно").ЭтоИстина();
	Удаление().Удалить(Первый, Второй, "203.0.113.94");

	// остался один — и он неприкосновенен, причём именно по этой причине, а не потому,
	// что «себя нельзя»: хаб без администратора открывает мастер первого запуска анониму
	Вердикт = Удаление().ПроверитьУдаление(Первый, Первый);
	Ожидаем.Что(Вердикт.Успех, "последнего админа не удалить").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина, "и отказ называет именно эту заставу")
		.Равно(Удаление().ПричинаПоследнийАдмин());

КонецПроцедуры

&Тест
Процедура УдалениеМимоПорогаПадаетИсключением() Экспорт

	Жертва = ЗавестиУчётку();
	Проситель = ЗавестиУчётку();

	Упало = Ложь;
	Попытка
		Удаление().Удалить(Проситель, Жертва, "203.0.113.95");
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "порог операции держит и прямой вызов").ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Жертва.Логин), "учётка цела").Существует();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Удаление()
	Возврат Желудь("УдалениеУчётки");
КонецФункции

Функция Пользователи()
	Возврат Желудь("СервисПользователей");
КонецФункции

Функция Пулы()
	Возврат Желудь("СервисПулов");
КонецФункции

// Единственный администратор набора: пороги операций судят по нему.
Функция Админ()

	Найденный = Пользователи().НайтиПоЛогину("deladmin");
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;
	Возврат Пользователи().СоздатьПользователя("deladmin", "deladmin@example.com",
		"AdminPassw0rd", "admin");

КонецФункции

Функция ЗавестиАдмина()
	Логин = УникальныеИмена.Имя("adm");
	Возврат Пользователи().СоздатьПользователя(Логин, Логин + "@example.com",
		"AdminPassw0rd", "admin");
КонецФункции

Функция ЗавестиУчётку()
	Возврат Стенд.УчёткаСлужбой("user", УникальныеИмена.Имя("victim"), "Password123!");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

#КонецОбласти
