// Фейковый коннектор 1connector (Get/Post без сети): запоминает параметры последнего вызова.

Перем КодОтвета;
Перем ДвоичныеОтвета;
Перем ЗаголовкиОтвета;
Перем БросатьСбой;
Перем ПоследнийМетод_;
Перем ПоследнийURL_;
Перем ПоследнееТело_;
Перем ПоследниеДопПараметры_;

// Задаёт ответ на следующий Get/Post и снимает режим сбоя.
//
// Параметры:
//  Код       - Число - код состояния ответа.
//  Двоичные  - ДвоичныеДанные - тело ответа (необязательный, по умолчанию Неопределено).
//  Заголовки - Соответствие - заголовки ответа (необязательный, по умолчанию пустое).
//
Процедура НастроитьОтвет(Знач Код, Знач Двоичные = Неопределено, Знач Заголовки = Неопределено) Экспорт
	КодОтвета = Код;
	ДвоичныеОтвета = Двоичные;
	ЗаголовкиОтвета = ?(Заголовки = Неопределено, Новый Соответствие(), Заголовки);
	БросатьСбой = Ложь;
КонецПроцедуры

// Переводит коннектор в режим сетевого сбоя: следующий Get/Post бросит исключение.
//
Процедура ЭмулироватьСбой() Экспорт
	БросатьСбой = Истина;
КонецПроцедуры

// Запоминает вызов и отдаёт настроенный ответ (контракт 1connector).
//
// Параметры:
//  URL             - Строка - адрес запроса.
//  ПараметрыЗапроса - Произвольный - не используется (необязательный, по умолчанию Неопределено).
//  ДопПараметры    - Структура - дополнительные параметры (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  ФейкОтветаКоннектора - настроенный ответ.
//
Функция Get(Знач URL, Знач ПараметрыЗапроса = Неопределено, Знач ДопПараметры = Неопределено) Экспорт
	ЗапомнитьВызов("GET", URL, Неопределено, ДопПараметры);
	Возврат Ответ();
КонецФункции

// Запоминает вызов вместе с телом и отдаёт настроенный ответ (контракт 1connector).
//
// Параметры:
//  URL          - Строка - адрес запроса.
//  Данные       - Произвольный - тело запроса (необязательный, по умолчанию Неопределено).
//  Json         - Произвольный - не используется (необязательный, по умолчанию Неопределено).
//  ДопПараметры - Структура - дополнительные параметры (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  ФейкОтветаКоннектора - настроенный ответ.
//
Функция Post(Знач URL, Знач Данные = Неопределено, Знач Json = Неопределено, Знач ДопПараметры = Неопределено) Экспорт
	ЗапомнитьВызов("POST", URL, Данные, ДопПараметры);
	Возврат Ответ();
КонецФункции

#Область Наблюдение

// Метод последнего вызова.
//
// Возвращаемое значение:
//  Строка - "GET", "POST" либо "" до первого вызова.
//
Функция ПоследнийМетод() Экспорт
	Возврат ПоследнийМетод_;
КонецФункции

// Адрес последнего вызова.
//
// Возвращаемое значение:
//  Строка - URL либо "" до первого вызова.
//
Функция ПоследнийURL() Экспорт
	Возврат ПоследнийURL_;
КонецФункции

// Тело последнего POST.
//
// Возвращаемое значение:
//  Строка - тело запроса либо "" если тела не было.
//
Функция ПоследнееТело() Экспорт
	Возврат ?(ПоследнееТело_ = Неопределено, "", Строка(ПоследнееТело_));
КонецФункции

// Значение заголовка из дополнительных параметров последнего вызова.
//
// Параметры:
//  Имя - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка - значение заголовка либо "" если его нет.
//
Функция ПоследнийЗаголовок(Знач Имя) Экспорт
	Если ПоследниеДопПараметры_ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Заголовки = Неопределено;
	ПоследниеДопПараметры_.Свойство("Заголовки", Заголовки);
	Если ТипЗнч(Заголовки) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Заголовки.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

// Значение произвольного ключа дополнительных параметров последнего вызова.
//
// Параметры:
//  Имя - Строка - имя ключа.
//
// Возвращаемое значение:
//  Произвольный - значение ключа либо Неопределено.
//
Функция ПоследнийПараметр(Знач Имя) Экспорт
	Если ПоследниеДопПараметры_ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = Неопределено;
	ПоследниеДопПараметры_.Свойство(Имя, Значение);
	Возврат Значение;
КонецФункции

#КонецОбласти

#Область Служебное

Процедура ЗапомнитьВызов(Знач Метод, Знач URL, Знач Тело, Знач ДопПараметры)
	ПоследнийМетод_ = Метод;
	ПоследнийURL_ = URL;
	ПоследнееТело_ = Тело;
	ПоследниеДопПараметры_ = ДопПараметры;
КонецПроцедуры

Функция Ответ()
	Если БросатьСбой Тогда
		ВызватьИсключение "эмуляция сетевого сбоя (offline)";
	КонецЕсли;
	Возврат Новый ФейкОтветаКоннектора(КодОтвета, ДвоичныеОтвета, ЗаголовкиОтвета);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	КодОтвета = 200;
	ДвоичныеОтвета = Неопределено;
	ЗаголовкиОтвета = Новый Соответствие();
	БросатьСбой = Ложь;
	ПоследнийМетод_ = "";
	ПоследнийURL_ = "";
	ПоследнееТело_ = Неопределено;
	ПоследниеДопПараметры_ = Неопределено;
КонецПроцедуры
