// Юнит-тесты фабрики КонфигурацияХранилища: выбор бэкенда по конфигу, проброс каталога и квоты,
// ключи S3 — детальками значением либо файлом. Фабрика создаётся прямым конструктором.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогКлассов = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"), "хранилище", "Классы");

	ПоискКлассов.ПодключитьВсе(КаталогКлассов);

	// примитивы основы целиком, а не поштучно: хранилище спрашивает у них уборку, хеш,
	// числа и флаги, и поимённый список ломал бы набор на каждом новом примитиве
	ПоискКлассов.ПодключитьОснову(ОбъединитьПути(КаталогКлассов, "..", ".."));

	// реестр настроек — для сверки умолчаний фабрики с объявленными
	КаталогНастроек = ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "..", ".."), "настройки", "Классы");
	ПоискКлассов.Подключить(КаталогНастроек, "ВидыПроверок");
	ПоискКлассов.Подключить(КаталогНастроек, "ОбъявленияНастроек");
	ПоискКлассов.Подключить(КаталогНастроек, "ИменаПеременныхОкружения");
	ПоискКлассов.Подключить(КаталогНастроек, "РеестрНастроек");

	// умолчание корня данных — для сверки с тем, что считают загрузка настроек и хаб
	КаталогЗапуска = ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "..", ".."), "запуск", "Классы");
	ПоискКлассов.Подключить(КаталогЗапуска, "РасположениеДанных");

	РеестрФикстур.Подключить("НастройкиЗаглушка");

КонецПроцедуры

&Тест
Процедура ПотолокОбъёмаСпрашиваетсяНаЗаписиАНеПриСборке() Экспорт

	// порог крутят по мере роста хаба: поднятый из формы потолок судит уже следующую публикацию
	Каталог = УникальныеИмена.ВременныйКаталог("oshub-storage-cap");

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.storage.quota.bytes", 10);
	Хранилище = Новый ФайловоеХранилище(Каталог, 0, Новый ПотолокХранилища(Настройки));

	Координаты = Новый КоординатыАртефакта("pool", "pkg", "1.0.0");
	Данные = ПолучитьДвоичныеДанныеИзСтроки("0123456789ABCDEF", "UTF-8");

	Ожидаем.Что(Падает(Хранилище, Координаты, Данные),
		"артефакт крупнее потолка не размещается").ЭтоИстина();

	// потолок поднят из интерфейса — БЕЗ пересборки бэкенда
	Настройки.Задать("oshub.storage.quota.bytes", 1048576);
	Ожидаем.Что(Падает(Хранилище, Координаты, Данные),
		"тот же бэкенд судит уже по новому потолку").ЭтоЛожь();

	// ноль по-прежнему означает «хаб объём не ограничивает»
	Настройки.Задать("oshub.storage.quota.bytes", 0);
	Ожидаем.Что(Падает(Хранилище, Новый КоординатыАртефакта("pool", "pkg", "2.0.0"), Данные),
		"ноль — без ограничения, а не «места нет»").ЭтоЛожь();

	УникальныеИмена.УбратьВременное(Каталог);

КонецПроцедуры

&Тест
Процедура BackendFileСобираетФайловыйБэкенд() Экспорт

	Фабрика = Новый КонфигурацияХранилища("file", "./данные-тест", , , , , , , ЛогТестов());
	Хранилище = Фабрика.ХранилищеАртефактов();

	Ожидаем.Что(ТипЗнч(Хранилище)).Равно(Тип("ФайловоеХранилище"));
	Ожидаем.Что(Хранилище.Бэкенд()).Равно("file");

КонецПроцедуры

&Тест
Процедура ПустойBackendПоУмолчаниюФайловый() Экспорт

	Фабрика = Новый КонфигурацияХранилища("", "./данные-тест", , , , , , , ЛогТестов());
	Ожидаем.Что(ТипЗнч(Фабрика.ХранилищеАртефактов())).Равно(Тип("ФайловоеХранилище"));

КонецПроцедуры

&Тест
Процедура BackendS3БезСекретовПадаетПонятнойОшибкой() Экспорт

	// s3-ветка выбрана, а ключей нет ни значением, ни файлом
	Фабрика = Новый КонфигурацияХранилища("s3", "",
		"http://localhost:9000", "us-east-1", "openhub-artifacts", "Истина", "", , ЛогТестов());

	ТекстОшибки = "";
	Попытка
		Фабрика.ХранилищеАртефактов();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "S3") > 0,
		"ожидали ошибку конфигурации S3-бэкенда, получили: " + ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстОшибки, "oshub.storage.s3.access_key") > 0,
		"ошибка называет настройку ключа доступа, получили: " + ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстОшибки, "oshub.storage.s3.secret_key_file") > 0,
		"и файловый путь секретного ключа, получили: " + ТекстОшибки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлючиS3ПриходятДетальками() Экспорт

	Параметры = Новый ПараметрыS3(Новый Структура("КлючДоступа, СекретныйКлюч",
		"ключ-доступа", "секретный-ключ"), ЛогТестов());

	Ожидаем.Что(Параметры.КлючДоступа()).Равно("ключ-доступа");
	Ожидаем.Что(Параметры.СекретныйКлюч()).Равно("секретный-ключ");
	Ожидаем.Что(Параметры.Недостающее().Количество(), "не хватает только бакета и эндпоинта")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура КлючиS3ЧитаютсяИзФайлов() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("ключи-s3");
	ФайлДоступа = ОбъединитьПути(Каталог, "access");
	ФайлСекрета = ОбъединитьПути(Каталог, "secret");
	ЗаписатьТекст(ФайлДоступа, "ключ-доступа" + Символы.ПС);
	ЗаписатьТекст(ФайлСекрета, "секретный-ключ" + Символы.ПС);

	Попытка
		Параметры = Новый ПараметрыS3(Новый Структура("ФайлКлючаДоступа, ФайлСекретногоКлюча",
			ФайлДоступа, ФайлСекрета), ЛогТестов());
		Ожидаем.Что(Параметры.КлючДоступа(), "ключ доступа — из файла, без перевода строки")
			.Равно("ключ-доступа");
		Ожидаем.Что(Параметры.СекретныйКлюч(), "секретный ключ — из файла").Равно("секретный-ключ");
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Каталог);

КонецПроцедуры

&Тест
Процедура ЗначениеКлючаS3СильнееФайла() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("ключи-s3-оба");
	ФайлДоступа = ОбъединитьПути(Каталог, "access");
	ЗаписатьТекст(ФайлДоступа, "из-файла");

	Попытка
		Параметры = Новый ПараметрыS3(Новый Структура("КлючДоступа, ФайлКлючаДоступа",
			"значением", ФайлДоступа), ЛогТестов());
		Ожидаем.Что(Параметры.КлючДоступа()).Равно("значением");
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Каталог);

КонецПроцедуры

&Тест
Процедура УмолчанияФабрикиСовпадаютСОбъявленнымиВРеестре() Экспорт

	// Умолчание объявляют двое — потребитель и реестр, который показывает его оператору.
	// Разъедутся — экран назовёт одно, а хаб будет жить с другим.
	Реестр = РеестрКлючейХранилища();
	БезНастроек = Новый ПараметрыS3(Новый Структура(), ЛогТестов());

	Ожидаем.Что(БезНастроек.Регион(), "регион")
		.Равно(Реестр.Описание("oshub.storage.s3.region").Дефолт);
	Ожидаем.Что(БезНастроек.ПутьСтиль(), "адресация путём")
		.Равно(Реестр.Описание("oshub.storage.s3.force_path_style").Дефолт);
	Ожидаем.Что(БезНастроек.Эндпоинт()).Равно(Реестр.Описание("oshub.storage.s3.endpoint").Дефолт);
	Ожидаем.Что(БезНастроек.Бакет()).Равно(Реестр.Описание("oshub.storage.s3.bucket").Дефолт);
	Ожидаем.Что(БезНастроек.Префикс()).Равно(Реестр.Описание("oshub.storage.s3.prefix").Дефолт);
	Ожидаем.Что(СрокИзНастройки(""), "срок ответа корзины")
		.Равно(Реестр.Описание("oshub.storage.s3.timeout.sec").Дефолт);

	// бэкенд: умолчание реестра, названное явно, собирает то же, что незаданное
	Названный = Новый КонфигурацияХранилища(Реестр.Описание("oshub.storage.backend").Дефолт,
		"./данные-тест", , , , , , , ЛогТестов());
	Незаданный = Новый КонфигурацияХранилища("", "./данные-тест", , , , , , , ЛогТестов());
	Ожидаем.Что(ТипЗнч(Названный.ХранилищеАртефактов()), "бэкенд")
		.Равно(ТипЗнч(Незаданный.ХранилищеАртефактов()));

КонецПроцедуры

// Умолчание корня данных объявляют и хранилище, и запуск: хранилище не может спросить запуск
// (инверсия слоёв), поэтому равенство стережётся значением. Разъедутся — артефакты лягут
// не туда, где загрузка настроек создала корень и где его ищет хаб.
&Тест
Процедура КореньХранилищаПоУмолчаниюСовпадаетСРасположениемДанных() Экспорт

	Расположение = Новый РасположениеДанных();

	Ожидаем.Что(Новый ФайловоеХранилище().КореньПоУмолчанию(), "умолчание файлового хранилища")
		.Равно(Расположение.КореньПоУмолчанию());

	Незаданный = Новый КонфигурацияХранилища("", "", , , , , , , ЛогТестов());
	Ожидаем.Что(Незаданный.ХранилищеАртефактов().Корень(), "фабрика без заданного корня")
		.Равно(Расположение.Корень(""));

	Реестр = РеестрКлючейХранилища();
	Ожидаем.Что(Реестр.Описание("oshub.storage.root").Дефолт, "умолчание, которое показывает реестр")
		.Равно(Расположение.КореньПоУмолчанию());

КонецПроцедуры

&Тест
Процедура BackendS3БезБакетаИЭндпоинтаПеречисляетНедостающее() Экспорт

	Фабрика = Новый КонфигурацияХранилища("s3", "", "", "us-east-1", "", "Истина", "", , ЛогТестов());

	ТекстОшибки = "";
	Попытка
		Фабрика.ХранилищеАртефактов();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "бакет") > 0, ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстОшибки, "эндпоинт") > 0, ТекстОшибки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлиентS3OintИS3ХранилищеКонструируютсяБезСети() Экспорт

	Клиент = Новый КлиентS3Oint("http://localhost:9000", "us-east-1", "bkt", "ak", "sk",
		Истина, ЛогТестов());
	Хранилище = Новый S3Хранилище(Клиент, "префикс", 0);

	Ожидаем.Что(Хранилище.Бэкенд()).Равно("s3");

КонецПроцедуры

// Срок приходит строкой окружения либо числом файла; мусор и пустое — умолчание, меньше секунды — секунда.
// Набор общего процесса: последним ставится умолчание — его и оставляет процессу.
&Тест
Процедура СрокОтветаКорзиныЧитаетсяИзНастройки() Экспорт

	Ожидаем.Что(СрокИзНастройки("45"), "строка окружения").Равно(45);
	Ожидаем.Что(СрокИзНастройки(7), "число файла настроек").Равно(7);
	Ожидаем.Что(СрокИзНастройки("2.7"), "дробное — целые секунды").Равно(2);
	Ожидаем.Что(СрокИзНастройки("0"), "ноль — не «без срока», а наименьший срок").Равно(1);
	Ожидаем.Что(СрокИзНастройки("-5"), "отрицательное — тоже").Равно(1);
	Ожидаем.Что(СрокИзНастройки("полминуты"), "мусор — умолчание").Равно(30);
	Ожидаем.Что(СрокИзНастройки(""), "пусто — умолчание").Равно(30);

КонецПроцедуры

// Срок, который рогатка старта ставит процессу oint по значению настройки.
Функция СрокИзНастройки(Знач Значение)
	Установка = Новый УстановкаСрокаОтветаOint(Значение);
	Установка.ПриЗапускеПриложения();
	Возврат Новый СрокОтветаOint().Секунд();
КонецФункции

Процедура ЗаписатьТекст(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

// Лог для классов, созданных напрямую минуя контейнер: продуктовый класс получает лог инъекцией
// и без него отказывает громко (см. ДисциплинаЛогирования_Тесты).
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.storage");
КонецФункции

// Отвергает ли хранилище размещение артефакта.
Функция Падает(Знач Хранилище, Знач Координаты, Знач Данные)
	Попытка
		Хранилище.Сохранить(Координаты, Данные);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Реестр над ключами хранилища: те умолчания, которые экран настроек показывает оператору.
Функция РеестрКлючейХранилища()

	Предметы = Новый Массив();
	Предметы.Добавить(Новый КлючиНастроекХранилища(Новый ВидыПроверок()));
	Возврат Новый РеестрНастроек(Предметы);

КонецФункции
