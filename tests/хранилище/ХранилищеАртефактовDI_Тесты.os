// Интеграционный тест DI хранилища артефактов: бэкенд выбирает фабрика по детальке
// oshub.storage.backend — file по умолчанию, s3 с секретами только из окружения; срок ответа
// корзины приходит деталькой oshub.storage.s3.timeout.sec.

#Использовать asserts
#Использовать tempfiles
#Использовать autumn
#Использовать errors
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогКлассов; // Строка - src/модули/хранилище/Классы
Перем КореньДанных;   // Строка - временный корень файлового хранилища
Перем Выдача;         // фикстура ВыдачаПортов — порт молчащей корзины

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ВыдачаПортов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогКлассов = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"), "хранилище", "Классы");

	ПоискКлассов.ПодключитьВсе(КаталогКлассов);

	ПоискКлассов.ПодключитьОснову(ОбъединитьПути(КаталогКлассов, "..", ".."));

	КореньДанных = ВременныеФайлы.СоздатьКаталог();
	Выдача = Новый ВыдачаПортов();

КонецПроцедуры

&ПослеВсех
Процедура УбратьКорень() Экспорт
	ВременныеФайлы.УдалитьФайл(КореньДанных);
	Выдача.ВернутьВсе();
КонецПроцедуры

&Тест
Процедура ПоУмолчаниюФайловыйБэкендИЧитаетДетальки() Экспорт

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньДанных);

	Хранилище = ПостроитьХранилище(Детальки);

	// бэкенд называет себя сам: хранилище приезжает под стражем, и имя типа о выборе
	// бэкенда больше не говорит
	Ожидаем.Что(Хранилище.Бэкенд()).Равно("file");
	Ожидаем.Что(Хранилище.Корень()).Равно(Новый Файл(КореньДанных).ПолноеИмя);

	Координаты = Новый КоординатыАртефакта("main", "пакет", "1.0.0");
	Результат = Хранилище.Сохранить(Координаты, ПолучитьДвоичныеДанныеИзСтроки("hello"));
	Ожидаем.Что(Результат.Sha256)
		.Равно("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824");
	Ожидаем.Что(Хранилище.Существует(Координаты)).ЭтоИстина();

	// потолок объёма деталькой больше не приезжает: он прикладная настройка и спрашивается
	// у резолвера на каждой записи — это ФабрикаХранилища_Тесты.ПотолокОбъёмаСпрашиваетсяНаЗаписи…
	Второй = Хранилище.Сохранить(Новый КоординатыАртефакта("main", "пакет", "2.0.0"),
		ПолучитьДвоичныеДанныеИзСтроки("второй артефакт"));
	Ожидаем.Что(ЗначениеЗаполнено(Второй.Sha256),
		"без заданного потолка хаб объём не ограничивает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЯвныйBackendFileТожеФайловый() Экспорт

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.backend", "file");
	Детальки.Вставить("oshub.storage.root", КореньДанных);

	Ожидаем.Что(ПостроитьХранилище(Детальки).Бэкенд()).Равно("file");

КонецПроцедуры

// Корзина принимает соединение и молчит: запись, чтение, вопрос о размере и проба хранилища, собранного
// фабрикой контейнера, отказывают за срок из настройки — тот, что назвал оператор, а не через час. Срок
// процессу oint ставит рогатка старта, а не сборка хранилища.
&Тест
Процедура СрокОтветаКорзиныИзНастройкиДоходитДоКаждогоОбращения() Экспорт

	Порт = Выдача.Выдать();
	Корзина = Новый TCPСервер(Порт);
	Корзина.Запустить();

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.backend", "s3");
	Детальки.Вставить("oshub.storage.root", КореньДанных);
	Детальки.Вставить("oshub.storage.s3.endpoint", "http://127.0.0.1:" + Формат(Порт, "ЧГ=0"));
	Детальки.Вставить("oshub.storage.s3.bucket", "openhub");
	Детальки.Вставить("oshub.storage.s3.access_key", "AKIADI");
	Детальки.Вставить("oshub.storage.s3.secret_key", "di-secret-key");
	Детальки.Вставить("oshub.storage.s3.timeout.sec", Формат(СрокКорзиныСек(), "ЧГ=0"));

	Попытка
		Хранилище = ПостроитьХранилище(Детальки);
		Ожидаем.Что(Новый СрокОтветаOint().Секунд(), "срок настройки стоит с рогатки старта — его ждёт и Telegram")
			.Равно(СрокКорзиныСек());
		Сводка = Новый Массив();
		Для Каждого Обращение Из СтрРазделить("запись,чтение,размер,проба", ",") Цикл
			Сводка.Добавить(ОтказМолчащейКорзины(Хранилище, Обращение));
		КонецЦикла;
	Исключение
		Корзина.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	Корзина.Остановить();
	Выдача.Вернуть(Порт);

	Ожидаем.Что(СтрСоединить(Сводка, Символы.ПС), "обращения, не уложившиеся в срок корзины").Равно(
		СтрСоединить(СтрРазделить("запись: в срок,чтение: в срок,размер: в срок,проба: в срок", ","), Символы.ПС));

КонецПроцедуры

// Страж слышит каждый ответ хранилища, поэтому стоит НА ПУТИ каждого вызова: забытый
// в обёртке метод контракта всплывёт исключением «это контракт» уже в проде.
&Тест
Процедура ОбёрткаСтражаЗакрываетКонтрактЦеликом() Экспорт

	Контракт = ЭкспортныеМетоды("ХранилищеАртефактов");
	Обёртка = ЭкспортныеМетоды("ХранилищеПодСтражем");

	Недостающие = Новый Массив();
	Для Каждого Метод Из Контракт Цикл
		Если Обёртка.Найти(Метод) = Неопределено Тогда
			Недостающие.Добавить(Метод);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Недостающие, ", "),
		"ХранилищеПодСтражем не делегирует методы контракта").Равно("");

КонецПроцедуры


&Тест
Процедура ОбаБэкендаЗакрываютКонтрактЦеликом() Экспорт

	// контракт — не документация: метод, добавленный в ХранилищеАртефактов и забытый
	// в одной из реализаций, всплывёт исключением «это контракт» уже в проде — на том
	// бэкенде, который на стенде не гоняли
	Контракт = ЭкспортныеМетоды("ХранилищеАртефактов");
	Ожидаем.Что(Контракт.Количество() > 5, "методы контракта вообще нашлись").ЭтоИстина();

	Для Каждого ИмяРеализации Из СтрРазделить("ФайловоеХранилище,S3Хранилище", ",") Цикл
		Реализованные = ЭкспортныеМетоды(ИмяРеализации);
		Недостающие = Новый Массив();
		Для Каждого Метод Из Контракт Цикл
			Если Реализованные.Найти(Метод) = Неопределено Тогда
				Недостающие.Добавить(Метод);
			КонецЕсли;
		КонецЦикла;
		Ожидаем.Что(СтрСоединить(Недостающие, ", "),
			СтрШаблон("%1 не реализует методы контракта", ИмяРеализации)).Равно("");
	КонецЦикла;

КонецПроцедуры

#Область Служебные

// Имена экспортных процедур и функций класса модуля.
Функция ЭкспортныеМетоды(Знач ИмяКласса)

	Чтение = Новый ЧтениеТекста(ПоискКлассов.ФайлКласса(КаталогКлассов, ИмяКласса), "utf-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(?(Текст = Неопределено, "", Текст), Символы.ПС, Ложь) Цикл
		Очищенная = СокрЛП(Строка_);
		Если СтрНачинаетсяС(Очищенная, "Функция ") ИЛИ СтрНачинаетсяС(Очищенная, "Процедура ") Тогда
			Если СтрЗаканчиваетсяНа(Очищенная, "Экспорт") Тогда
				Скобка = СтрНайти(Очищенная, "(");
				Пробел = СтрНайти(Очищенная, " ");
				Результат.Добавить(Сред(Очищенная, Пробел + 1, Скобка - Пробел - 1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// «<обращение>: в срок», если отказ назван недоступностью со сроком из настройки и пришёл за этот срок.
Функция ОтказМолчащейКорзины(Знач Хранилище, Знач Обращение)

	Координаты = Новый КоординатыАртефакта("main", "pkg", "1.0.0");
	Сбой = Неопределено;
	Проба = Неопределено;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если Обращение = "запись" Тогда
			Хранилище.Сохранить(Координаты, ПолучитьДвоичныеДанныеИзСтроки("hello"));
		ИначеЕсли Обращение = "чтение" Тогда
			Хранилище.ПолучитьДанные(Координаты);
		ИначеЕсли Обращение = "размер" Тогда
			Хранилище.Размер(Координаты);
		Иначе
			Проба = Хранилище.Доступность();
		КонецЕсли;
	Исключение
		Сбой = ИнформацияОбОшибке();
	КонецПопытки;
	Занял = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Если Обращение = "проба" Тогда
		Возврат ВердиктПробы(Проба, Занял);
	ИначеЕсли Сбой = Неопределено Тогда
		Возврат Обращение + ": молчащая корзина ответила";
	ИначеЕсли НЕ ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ЗависимостьНедоступна()) Тогда
		Возврат Обращение + ": отказ не назван недоступностью — " + ДиагностикаОшибок.КраткоеПредставление(Сбой);
	ИначеЕсли СтрНайти(ДиагностикаОшибок.ДиагностическоеПредставление(Сбой),
		СтрШаблон("срок ожидания — %1 с", СрокКорзиныСек())) = 0 Тогда
		Возврат Обращение + ": отказ не называет срок настройки — " + ДиагностикаОшибок.КраткоеПредставление(Сбой);
	ИначеЕсли Занял < СрокКорзиныСек() * 1000 / 2 ИЛИ Занял > 15000 Тогда
		Возврат СтрШаблон("%1: ждал %2 мс при сроке %3 с", Обращение, Формат(Занял, "ЧГ=0"), СрокКорзиныСек());
	КонецЕсли;

	Возврат Обращение + ": в срок";

КонецФункции

// Проба не бросает: молчание корзины — вердикт «не отвечает» с тем же сроком в причине.
Функция ВердиктПробы(Знач Проба, Знач Занял)

	Если Проба = Неопределено ИЛИ Проба.Успех Тогда
		Возврат "проба: молчащая корзина названа отвечающей";
	ИначеЕсли СтрНайти(Проба.Сообщение, СтрШаблон("срок ожидания — %1 с", СрокКорзиныСек())) = 0 Тогда
		Возврат "проба: вердикт не называет срок настройки — " + Проба.Сообщение;
	ИначеЕсли Занял < СрокКорзиныСек() * 1000 / 2 ИЛИ Занял > 15000 Тогда
		Возврат СтрШаблон("проба: ждала %1 мс при сроке %2 с", Формат(Занял, "ЧГ=0"), СрокКорзиныСек());
	КонецЕсли;

	Возврат "проба: в срок";

КонецФункции

// Не умолчание: совпадение с ним не доказало бы, что деталька дошла.
Функция СрокКорзиныСек()
	Возврат 2;
КонецФункции

Функция ПостроитьХранилище(Знач Детальки)

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка.НайтиЖелудь("ХранилищеАртефактов");

КонецФункции

#КонецОбласти
