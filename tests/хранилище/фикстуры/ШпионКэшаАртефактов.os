// Шпион на месте табакерки МенеджерКэшей: запоминает, что кэш «артефакты» просили положить, вместо
// autumn-cache, которого у класса, созданного напрямую, нет.

Перем Положенное;  // Соответствие sha256 -> Строка - содержимое положенного потока

// Табакерка: менеджер кэшей — сам шпион.
//
// Возвращаемое значение:
//  ШпионКэшаАртефактов - этот объект.
//
Функция Достать() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Кэш по имени — тоже сам шпион.
//
// Параметры:
//  Имя - Строка - имя кэша.
//
// Возвращаемое значение:
//  ШпионКэшаАртефактов - этот объект.
//
Функция Кэш(Знач Имя) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Что положил бы кэш: поток вычитывается сразу, как это делает запись кэша.
//
// Параметры:
//  Sha256 - Строка - ключ записи.
//  Поток - Поток - содержимое.
//
// Возвращаемое значение:
//  Поток - тот же поток; закрывает вызывающий.
//
Функция Положить(Знач Sha256, Знач Поток) Экспорт
	Данные = Новый ЧтениеДанных(Поток).Прочитать().ПолучитьДвоичныеДанные();
	Положенное.Вставить(Sha256, ПолучитьСтрокуИзДвоичныхДанных(Данные));
	Возврат Поток;
КонецФункции

// Содержимое, положенное под ключом; Неопределено, если не клали.
//
// Параметры:
//  Sha256 - Строка - ключ записи.
//
// Возвращаемое значение:
//  Строка, Неопределено - содержимое строкой.
//
Функция Положено(Знач Sha256) Экспорт
	Возврат Положенное.Получить(Sha256);
КонецФункции

Процедура ПриСозданииОбъекта()
	Положенное = Новый Соответствие();
КонецПроцедуры
