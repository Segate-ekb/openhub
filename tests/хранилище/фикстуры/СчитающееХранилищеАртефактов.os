// Хранилище артефактов, считающее обращения: им проверяют, что экран в хранилище
// не ходит вовсе. Данных не держит — отвечает пустотой и отмечает, что его спросили.

Перем Счётчик;        // СчётчикОбращений — счёт обращений к фикстуре
Перем СрокПоследний;  // Число - срок, с которым просили пробу в последний раз

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// С каким сроком хранилище просили о пробе в последний раз.
//
// Возвращаемое значение:
//  Число - секунды; 0, если пробы не было.
//
Функция СрокПоследнейПробы() Экспорт
	Возврат СрокПоследний;
КонецФункции

// Контракт ХранилищеАртефактов: суммарный занятый объём.
//
// Возвращаемое значение:
//  Число - всегда 0.
//
Функция ЗанятыйОбъем() Экспорт
	Счётчик.Отметить("ЗанятыйОбъем");
	Возврат 0;
КонецФункции

// Контракт ХранилищеАртефактов: объём области пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Число - всегда 0.
//
Функция ОбъёмПула(Знач ИмяПула) Экспорт
	Счётчик.Отметить("ОбъёмПула");
	Возврат 0;
КонецФункции

// Контракт ХранилищеАртефактов: объёмы всех пулов.
//
// Возвращаемое значение:
//  Соответствие - всегда пустое.
//
Функция ОбъёмыПулов() Экспорт
	Счётчик.Отметить("ОбъёмыПулов");
	Возврат Новый Соответствие();
КонецФункции

// Контракт ХранилищеАртефактов: проба доступности.
//
// Параметры:
//  СрокСек - Число - срок ожидания.
//
// Возвращаемое значение:
//  Структура - Успех, ОтказДоступа, Сообщение.
//
Функция Доступность(Знач СрокСек) Экспорт
	Счётчик.Отметить("Доступность");
	СрокПоследний = Цел(СрокСек);
	Возврат Новый Структура("Успех, ОтказДоступа, Сообщение", Истина, Ложь, "");
КонецФункции

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
	СрокПоследний = 0;
КонецПроцедуры
