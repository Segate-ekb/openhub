// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:InvalidCharacterInFile-off
// BSLLS:YoLetterUsage-off
// Хранилище артефактов, считающее обращения: им проверяют, что экран в хранилище
// не ходит вовсе. Данных не держит — отвечает пустотой и отмечает, что его спросили.

Перем Счетчик;        // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число
//
Функция Обращений() Экспорт
	Возврат Счетчик.Обращений();
КонецФункции

// Контракт ХранилищеАртефактов: суммарный занятый объём.
//
// Возвращаемое значение:
//  Число - всегда 0.
//
Функция ЗанятыйОбъем() Экспорт
	Счетчик.Отметить("ЗанятыйОбъем");
	Возврат 0;
КонецФункции

// Контракт ХранилищеАртефактов: объём области пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Число - всегда 0.
//
Функция ОбъемПула(Знач ИмяПула) Экспорт
	Счетчик.Отметить("ОбъемПула");
	Возврат 0;
КонецФункции

// Контракт ХранилищеАртефактов: объёмы всех пулов.
//
// Возвращаемое значение:
//  Соответствие - всегда пустое.
//
Функция ОбъемыПулов() Экспорт
	Счетчик.Отметить("ОбъемыПулов");
	Возврат Новый Соответствие();
КонецФункции

// Контракт ХранилищеАртефактов: проба доступности.
//
// Возвращаемое значение:
//  Структура - Успех, ОтказДоступа, Сообщение.
//
Функция Доступность() Экспорт
	Счетчик.Отметить("Доступность");
	Возврат Новый Структура("Успех, ОтказДоступа, Сообщение", Истина, Ложь, "");
КонецФункции

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счетчик = Новый СчётчикОбращений();
КонецПроцедуры
