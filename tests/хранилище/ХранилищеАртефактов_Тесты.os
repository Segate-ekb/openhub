КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция НовоеХранилище(Знач Бэкенд, Знач Квота = 0)

	Если Бэкенд = "s3" Тогда
		КорзинаS3 = Новый ФейкКлиентS3();
		Возврат Новый S3Хранилище(КорзинаS3, "", Квота);
	КонецЕсли;

	Возврат Новый ФайловоеХранилище(КореньДанных, Квота);

КонецФункции

// Сколько всего лежит у бэкенда, мимо контракта: объектов в корзине либо файлов под корнем.
Функция ЛежитОбъектов(Знач Бэкенд)

	Если Бэкенд = "s3" Тогда
		Возврат КорзинаS3.Количество();
	КонецЕсли;

	Файлов = 0;
	Для Каждого Найденный Из НайтиФайлы(КореньДанных, "*", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлов = Файлов + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Файлов;

КонецФункции

Функция Координаты111()
	Возврат Новый КоординатыАртефакта("пул", "пакет", "1.1.1");
КонецФункции

// Без BOM: sha256 строки "hello" тогда равен общеизвестному эталону.
Функция Данные(Знач Текст)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст);
КонецФункции

Функция ДанныеHello()
	Возврат Данные("hello");
КонецФункции

// Случайные байты: размер файла и объекта не зависит от сжатия.
Функция НесжимаемыеДанные(Знач Размер)

	Генератор = Новый ГенераторСлучайныхЧисел(20260930);
	Буфер = Новый БуферДвоичныхДанных(Размер);
	Для Индекс = 0 По Размер - 1 Цикл
		Буфер.Установить(Индекс, Генератор.СлучайноеЧисло(0, 255));
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

Функция ДочитатьИЗакрыть(Знач Поток)
	Прочитанное = Новый ЧтениеДанных(Поток).Прочитать().ПолучитьДвоичныеДанные();
	Поток.Закрыть();
	Возврат Прочитанное;
КонецФункции

Функция Sha256(Знач Содержимое)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Содержимое);
	Возврат Хеширование.ХешСуммаСтрокой;
КонецФункции

Функция ТекстОшибкиЧтения(Знач Хранилище, Знач ИмяМетода, Знач Координаты, Знач Сумма)
	Возврат ОтказЧтения(Хранилище, ИмяМетода, Координаты, Сумма).Текст;
КонецФункции

// Чем отказало чтение методом контракта: описание и сам сбой; пустой текст — чтение прошло.
Функция ОтказЧтения(Знач Хранилище, Знач ИмяМетода, Знач Координаты, Знач Сумма)

	Отказ = Новый Структура("Текст, Сбой", "", Неопределено);
	Попытка
		Если ИмяМетода = "Получить" Тогда
			Хранилище.Получить(Координаты, Сумма);
		ИначеЕсли ИмяМетода = "ОткрытьПоток" Тогда
			Хранилище.ОткрытьПоток(Координаты, Сумма).Закрыть();
		Иначе
			Хранилище.ПолучитьДанные(Координаты, Сумма);
		КонецЕсли;
	Исключение
		Отказ.Текст = ОписаниеОшибки();
		Отказ.Сбой = ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Отказ;

КонецФункции

#КонецОбласти
