// Контракт ХранилищеАртефактов одним набором на обе реализации: файловое хранилище во временном
// корне и S3Хранилище на фейке шва КлиентS3. Параметр теста — имя бэкенда, как его называет Бэкенд().

#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КореньДанных;   // Строка - временный корень файлового хранилища текущего теста
Перем ЭталонSha256;   // Строка - sha256 строки "hello" (utf-8, без BOM)
Перем КорзинаS3;      // ФейкКлиентS3 - корзина S3-хранилища текущего теста

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ЭталонSha256 = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824";

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	ПоискКлассов.ПодключитьОснову(КаталогиПроекта.Модули());

	Хранилище = ОбъединитьПути(КаталогиПроекта.Модули(), "хранилище", "Классы");
	Для Каждого ИмяКласса Из СтрРазделить("КоординатыАртефакта,ПомощникАртефакта,ТипСодержимогоАртефакта,"
		+ "ВместимостьКвоты,КвотаХранилища,РаскладкаФайловХранилища,ФайловоеХранилище,"
		+ "РаскладкаКлючейS3,ВердиктОтветаS3,S3Хранилище", ",") Цикл
		ПоискКлассов.Подключить(Хранилище, ИмяКласса);
	КонецЦикла;

	РеестрФикстур.Подключить("ФейкКлиентS3");

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьКорень() Экспорт
	КореньДанных = ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура УбратьКорень() Экспорт
	ВременныеФайлы.УдалитьФайл(КореньДанных);
КонецПроцедуры

#Область СохранениеИЧтение

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СохранениеИзДвоичныхДанныхНазываетСуммуИРазмер(Знач Бэкенд) Экспорт

	Результат = НовоеХранилище(Бэкенд).Сохранить(Координаты111(), ДанныеHello());

	Ожидаем.Что(Результат.Sha256).Равно(ЭталонSha256);
	Ожидаем.Что(Результат.Размер).Равно(5);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СохранениеИзФайлаДаетТотЖеРезультат(Знач Бэкенд) Экспорт

	ФайлИсточника = ВременныеФайлы.НовоеИмяФайла("bin");
	ДанныеHello().Записать(ФайлИсточника);

	Хранилище = НовоеХранилище(Бэкенд);
	Результат = Хранилище.Сохранить(Координаты111(), ФайлИсточника);

	Ожидаем.Что(Результат.Sha256).Равно(ЭталонSha256);
	Ожидаем.Что(Результат.Размер).Равно(5);
	Ожидаем.Что(Новый Файл(ФайлИсточника).Существует(), "источник копируется, а не переносится").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПолучитьВозвращаетФайлСИсходнымСодержимым(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Путь = Хранилище.Получить(Координаты111());

	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь))).Равно("hello");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПолучитьДанныеВозвращаетСодержимое(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты111()))).Равно("hello");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ОткрытыйПотокДаётБайтыАртефакта(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Содержимое = НесжимаемыеДанные(200000);
	Хранилище.Сохранить(Координаты111(), Содержимое);

	Поток = Хранилище.ОткрытьПоток(Координаты111());
	Размер = Поток.Размер();
	Прочитанное = ДочитатьИЗакрыть(Поток);

	Ожидаем.Что(Размер, "размер потока известен до чтения").Равно(Содержимое.Размер());
	Ожидаем.Что(Sha256(Прочитанное), "поток отдаёт байты артефакта").Равно(Sha256(Содержимое));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СкачатьВФайлПишетСодержимоеПоНазванномуПути(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	Путь = ВременныеФайлы.НовоеИмяФайла("ospx");

	Хранилище.СкачатьВФайл(Координаты111(), Путь);

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь))).Равно("hello");
	Ожидаем.Что(ЛежитОбъектов(Бэкенд), "копия хранилище не пополняет").Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СкачатьВФайлОтсутствующегоАртефактаПадает(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Ошибка = "";
	Попытка
		Хранилище.СкачатьВФайл(Координаты111(), ВременныеФайлы.НовоеИмяФайла("ospx"));
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка).Содержит("не найден");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура НачатыйПотокПереживаетПерезаписьАртефакта(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Поток = Хранилище.ОткрытьПоток(Координаты111());
	Хранилище.Сохранить(Координаты111(), Данные("новое содержимое"));

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(ДочитатьИЗакрыть(Поток)),
		"начатое чтение дочитывает прежние байты").Равно("hello");
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(ДочитатьИЗакрыть(Хранилище.ОткрытьПоток(Координаты111()))),
		"следующее чтение берёт новые").Равно("новое содержимое");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СверкаВернойКонтрольнойСуммыПроходит(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	// регистр суммы не важен
	Путь = Хранилище.Получить(Координаты111(), ВРег(ЭталонSha256));
	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоИстина();

	Данные = Хранилище.ПолучитьДанные(Координаты111(), ЭталонSha256);
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Данные)).Равно("hello");

	Поток = Хранилище.ОткрытьПоток(Координаты111(), ЭталонSha256);
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(ДочитатьИЗакрыть(Поток))).Равно("hello");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СверкаНевернойКонтрольнойСуммыПадает(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	НевернаяСумма = СтрЗаменить(ЭталонSha256, "2", "3");

	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "Получить", Координаты111(), НевернаяСумма))
		.Содержит("не совпадает");
	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "ПолучитьДанные", Координаты111(), НевернаяСумма))
		.Содержит("не совпадает");
	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "ОткрытьПоток", Координаты111(), НевернаяСумма))
		.Содержит("не совпадает");

КонецПроцедуры

// Расхождение суммы отличимо от «артефакта нет» машинным кодом, а не текстом.
&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура РасхождениеСуммыНазваноКодомПорчиДанных(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	НевернаяСумма = СтрЗаменить(ЭталонSha256, "2", "3");

	Для Каждого ИмяМетода Из СтрРазделить("Получить,ПолучитьДанные,ОткрытьПоток", ",") Цикл
		Сбой = ОтказЧтения(Хранилище, ИмяМетода, Координаты111(), НевернаяСумма).Сбой;
		Ожидаем.Что(Сбой, ИмяМетода + ": чтение с неверной суммой отказало").Не_().Равно(Неопределено);
		Ожидаем.Что(ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ДанныеПовреждены()),
			ИмяМетода + ": расхождение суммы названо data.corrupt").ЭтоИстина();
	КонецЦикла;

	Несохранённый = Новый КоординатыАртефакта("пул", "пакет", "2.2.2");
	Отсутствие = ОтказЧтения(Хранилище, "ОткрытьПоток", Несохранённый, ЭталонSha256).Сбой;
	Ожидаем.Что(Отсутствие, "чтение отсутствующего артефакта отказало").Не_().Равно(Неопределено);
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Отсутствие, КодыСтандартныхОшибок.ДанныеПовреждены()),
		"отсутствие артефакта порчей данных не названо").ЭтоЛожь();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПолучениеОтсутствующегоАртефактаПадает(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "Получить", Координаты111(), "")).Содержит("не найден");
	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "ПолучитьДанные", Координаты111(), "")).Содержит("не найден");
	Ожидаем.Что(ТекстОшибкиЧтения(Хранилище, "ОткрытьПоток", Координаты111(), "")).Содержит("не найден");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПустойАртефактНольБайтСохраняетсяКорректно(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Результат = Хранилище.Сохранить(Координаты111(), Данные(""));

	// эталонный sha256 пустого содержимого
	Ожидаем.Что(Результат.Sha256)
		.Равно("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
	Ожидаем.Что(Результат.Размер).Равно(0);
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();
	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(0);
	Ожидаем.Что(Хранилище.ПолучитьДанные(Координаты111()).Размер()).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ЮникодноеИмяПакетаСохраняетсяИЧитается(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Координаты = Новый КоординатыАртефакта("пул-приватный", "пакет-тест", "1.0.0");

	Хранилище.Сохранить(Координаты, ДанныеHello());

	Ожидаем.Что(Хранилище.Существует(Координаты)).ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты))).Равно("hello");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура БэкендНазываетСебя(Знач Бэкенд) Экспорт
	Ожидаем.Что(НовоеХранилище(Бэкенд).Бэкенд()).Равно(Бэкенд);
КонецПроцедуры

#КонецОбласти

#Область СуществованиеУдалениеРазмер

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СуществуетОтражаетНаличиеИУдалениеИдемпотентно(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();

	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();

	// повторное удаление — не ошибка
	Хранилище.Удалить(Координаты111());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура РазмерВозвращаетБайтыАртефакта(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(5);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура РазмерОтсутствующегоАртефактаПадает(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	БылоИсключение = Ложь;
	Попытка
		Хранилище.Размер(Координаты111());
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение, "ожидали исключение на размере отсутствующего артефакта").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ЗанятыйОбъемСуммируетВсеАртефакты(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                       // 5 байт
	Хранилище.Сохранить(Новый КоординатыАртефакта("другой", "пакет", "2.0.0"), Данные("abc")); // 3 байта

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(8);

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(3);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ОбъёмПулаСчитаетТолькоСвойПул(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Ожидаем.Что(Хранилище.ОбъёмПула("пул"), "пула ещё нет — не ошибка, а ноль").Равно(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                       // 5 байт
	Хранилище.Сохранить(Новый КоординатыАртефакта("пул", "второй", "2.0.0"), Данные("abc"));   // 3 байта
	Хранилище.Сохранить(Новый КоординатыАртефакта("чужой", "пакет", "2.0.0"), Данные("xyzw"));

	Ожидаем.Что(Хранилище.ОбъёмПула("пул"), "оба пакета своего пула").Равно(8);
	Ожидаем.Что(Хранилище.ОбъёмПула("чужой"), "соседний пул считается отдельно").Равно(4);

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.ОбъёмПула("пул"), "удаление освободило место").Равно(3);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ОбъёмПулаНеПутаетПулыСОбщимНачаломИмени(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "lib", "1.0.0"), ДанныеHello());   // 5
	Хранилище.Сохранить(Новый КоординатыАртефакта("main-2", "lib", "1.0.0"), Данные("abc")); // 3

	Ожидаем.Что(Хранилище.ОбъёмПула("main"), "main-2 в main не входит").Равно(5);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ОбъёмыПуловСнимаютВсеПулыОднимПроходом(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Ожидаем.Что(Хранилище.ОбъёмыПулов().Количество(), "пустое хранилище — пустой снимок").Равно(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                     // пул: 5
	Хранилище.Сохранить(Новый КоординатыАртефакта("пул", "второй", "2.0.0"), Данные("abc")); // пул: +3
	Хранилище.Сохранить(Новый КоординатыАртефакта("чужой", "пакет", "2.0.0"), Данные("xy")); // чужой: 2

	Снимок = Хранилище.ОбъёмыПулов();

	Ожидаем.Что(Снимок.Количество(), "в снимке ровно два пула").Равно(2);
	Ожидаем.Что(Снимок.Получить("пул"), "объём первого пула").Равно(8);
	Ожидаем.Что(Снимок.Получить("чужой"), "объём второго пула").Равно(2);
	Ожидаем.Что(Снимок.Получить("пул"), "снимок согласован с поштучным замером")
		.Равно(Хранилище.ОбъёмПула("пул"));

КонецПроцедуры

#КонецОбласти

#Область ОписьИОбластиПулов

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ОписьВозвращаетТолькоСвойПулИУдалитьФайлРаботает(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "a", "1.0.0"), ДанныеHello());
	Хранилище.Сохранить(Новый КоординатыАртефакта("main", "b", "2.0.0"), Данные("xy"));
	Хранилище.Сохранить(Новый КоординатыАртефакта("other", "c", "3.0.0"), Данные("z"));

	Ожидаем.Что(Хранилище.Опись("main").Количество(), "в пуле main два артефакта").Равно(2);

	Хранилище.УдалитьФайл("main", "a", "a-1.0.0.ospx");
	Ожидаем.Что(Хранилище.Опись("main").Количество()).Равно(1);
	// повторное удаление — не ошибка
	Хранилище.УдалитьФайл("main", "a", "a-1.0.0.ospx");

	Ожидаем.Что(Хранилище.Опись("").Количество(), "опись без имени пула пуста").Равно(0);
	Ожидаем.Что(Хранилище.Опись("нет-такого").Количество(), "опись незаведённого пула пуста").Равно(0);

КонецПроцедуры

// Имя пула входит в координаты, поэтому переименование пула — операция над всей его
// областью: артефакты обязаны переехать вместе с именем, иначе выдача ищет их не там.
&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПереименованиеПулаПереноситВсюОбластьХранения(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	Хранилище.Сохранить(Новый КоординатыАртефакта("старый", "lib", "1.0.0"), Данные("артефакт"));
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("старый", "lib", "1.0.0")),
		"артефакт на месте до переноса").ЭтоИстина();

	Хранилище.ПереименоватьПул("старый", "новый");

	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("новый", "lib", "1.0.0")),
		"артефакт доступен по новому имени").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("старый", "lib", "1.0.0")),
		"по старому имени не остался").ЭтоЛожь();

	// исходной области больше нет — переносить нечего, это не ошибка
	Хранилище.ПереименоватьПул("старый", "новый");
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("новый", "lib", "1.0.0")),
		"повторный вызов ничего не сломал").ЭтоИстина();

КонецПроцедуры

// Слияние областей молча потеряло бы артефакт при совпадении имён файлов.
&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПереименованиеПулаНеСливаетДвеОбласти(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Новый КоординатыАртефакта("а", "lib", "1.0.0"), Данные("первый"));
	Хранилище.Сохранить(Новый КоординатыАртефакта("б", "lib", "1.0.0"), Данные("второй"));

	Поймано = "";
	Попытка
		Хранилище.ПереименоватьПул("а", "б");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Поймано), "перенос в занятую область отклонён").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("а", "lib", "1.0.0")),
		"исходная область не тронута").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("б", "lib", "1.0.0")),
		"целевая область не тронута").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Перезапись

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПерезаписьЗаменяетСодержимоеЦеликом(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Результат = Хранилище.Сохранить(Координаты111(), Данные("новое содержимое"));

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты111())))
		.Равно("новое содержимое");
	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(Результат.Размер);
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(Результат.Размер);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура НеподдерживаемыйТипИсточникаПадаетБезСледов(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд);

	БылоИсключение = Ложь;
	Попытка
		Хранилище.Сохранить(Координаты111(), 12345);
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(0);
	Ожидаем.Что(ЛежитОбъектов(Бэкенд), "в хранилище не осталось ни одного файла или объекта").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Квоты

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура ПревышениеКвотыПадаетПонятнойОшибкойИНеОставляетСледов(Знач Бэкенд) Экспорт

	Хранилище = НовоеХранилище(Бэкенд, 8);
	Хранилище.Сохранить(Координаты111(), ДанныеHello()); // 5 из 8

