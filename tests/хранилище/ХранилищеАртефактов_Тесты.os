	ТекстОшибки = "";
	Попытка
		Хранилище.Сохранить(Вторые, Данные("1234")); // 5 + 4 > 8
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ТекстОшибки, "понятная ошибка о квоте").Содержит("квота");
	Ожидаем.Что(Хранилище.Существует(Вторые), "артефакт сверх квоты не появился").ЭтоЛожь();
	Ожидаем.Что(Хранилище.Существует(Координаты111()), "первый артефакт цел").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("file")
&ИсточникЗначение("s3")
Процедура СохранениеВПределахКвотыПроходит(Знач Бэкенд) Экспорт

