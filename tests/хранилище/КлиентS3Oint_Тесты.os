// Скачивание и размер объекта S3 со своим сроком против слушателя на свободном порту: молчащее хранилище
// отказывает по сроку, а не через час; ответ ложится в файл одним подписанным GET; отказ корзины и сбой
// записи файла называются каждый своим кодом, а ключи доступа не попадают ни в журнал, ни в отказ.

#Использовать asserts
#Использовать errors
#Использовать oint
#Использовать logos
#Использовать "../фикстуры"

Перем Выдача;           // фикстура ВыдачаПортов — свободный порт спрашивается у ОС
Перем Ловушка;          // фикстура ЛовушкаЛога — журнал клиента на уровне отладки
Перем Клиент;           // КлиентS3Oint на слушателе: его зовёт фоновое задание
Перем ПутьФайла;        // Строка - куда скачивает задание
Перем Отказ;            // Строка - описание исключения задания; пусто — запрос удался
Перем ОтказЗависимости; // Булево - отказ назван кодом dependency.unavailable
Перем ОтказОтсутствия;  // Булево - отказ назван кодом resource.not_found
Перем ЗапросЗанял;      // Число - мс
Перем РазмерОбъекта;    // Число - что вернул Размер

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ВыдачаПортов");
	РеестрФикстур.Подключить("ЛовушкаЛога");

	Поиск = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Поиск.ПодключитьОснову(Модули);
	Каталог = ОбъединитьПути(Модули, "хранилище", "Классы");
	Для Каждого ИмяКласса Из СтрРазделить("ВердиктОтветаS3,АдресаБакетаS3,КлиентS3Oint", ",") Цикл
		Поиск.Подключить(Каталог, ИмяКласса);
	КонецЦикла;

	Выдача = Новый ВыдачаПортов();

КонецПроцедуры

&ПередКаждым
Процедура ПоставитьЛовушку() Экспорт
	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(ЛогТестов(), УровниЛога.Отладка);
КонецПроцедуры

&ПослеКаждого
Процедура СнятьЛовушку() Экспорт
	Ловушка.Снять();
КонецПроцедуры

&ПослеВсех
Процедура ВернутьПорты() Экспорт
	Выдача.ВернутьВсе();
КонецПроцедуры

#Область Скачивание

// Чёрная дыра: слушатель принимает соединение и молчит. Без своего срока клиент oint ждёт
// ответа час, а загрузка кэша держит версию всё это время.
&Тест
Процедура МолчащееХранилищеСкачиваниеОбрываетсяСвоимСроком() Экспорт

	Соединение = ЗапроситьМолчащее("СкачатьИЗамерить");

	Ожидаем.Что(Соединение <> Неопределено,
		"слушатель принял соединение: это молчание, а не отказ связи").ЭтоИстина();
	Ожидаем.Что(Отказ, "молчащее хранилище объект не отдало").Заполнено();
	Ожидаем.Что(ОтказЗависимости, "отказ назван недоступностью зависимости: " + Отказ).ЭтоИстина();
	Ожидаем.Что(Отказ, "отказ называет срок").Содержит(СтрШаблон("срок ожидания — %1 с", СрокСек()));
	ПроверитьСрок("скачивание");
	ПроверитьБезКлючей();

КонецПроцедуры

&Тест
Процедура ОтветХранилищаЛожитсяВФайлОднимПодписаннымGET() Экспорт

	Запрос = Ответить("СкачатьИЗамерить", "HTTP/1.1 200 OK" + КонецСтроки()
		+ "Content-Length: 5" + КонецСтроки() + КонецСтроки() + "hello");

	Ожидаем.Что(Отказ, "скачивание удалось").Равно("");
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(ПутьФайла)), "тело ответа — в файле")
		.Равно("hello");
	Ожидаем.Что(СтрНачинаетсяС(Запрос, "GET /openhub/" + КлючОбъекта() + " "),
		"один GET объекта path-style: " + Лев(Запрос, 80)).ЭтоИстина();
	Ожидаем.Что(НРег(Запрос), "запрос подписан SigV4").Содержит("authorization: aws4-hmac-sha256");

КонецПроцедуры

&Тест
Процедура ОтсутствиеОбъектаНазываетсяСвоимКодом() Экспорт

	Тело = "<?xml version=""1.0"" encoding=""UTF-8""?><Error><Code>NoSuchKey</Code></Error>";
	Ответить("СкачатьИЗамерить", ОтветСТелом("404 Not Found", Тело));

	Ожидаем.Что(ОтказОтсутствия, "«объекта нет» — resource.not_found: " + Отказ).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("500 Internal Server Error")
&ИсточникЗначение("503 Slow Down")
&ИсточникЗначение("403 Forbidden")
Процедура ОтказКорзиныНазываетсяНедоступностью(Знач Статус) Экспорт

	Тело = "<?xml version=""1.0"" encoding=""UTF-8""?><Error><Code>Denied</Code></Error>";
	Ответить("СкачатьИЗамерить", ОтветСТелом(Статус, Тело));

	Ожидаем.Что(ОтказЗависимости, СтрШаблон("%1 — dependency.unavailable: %2", Статус, Отказ)).ЭтоИстина();
	Ожидаем.Что(ОтказОтсутствия, "и не «объекта нет»").ЭтоЛожь();
	ПроверитьБезКлючей();

КонецПроцедуры

// Сбой записи файла — неполадка хаба, а не корзины: недоступностью хранилища он не называется,
// а причину платформы несёт в отказе.
&Тест
Процедура СбойЗаписиФайлаНеВыдаётсяЗаНедоступностьХранилища() Экспорт

	Каталог = "нет-такого-" + Строка(Новый УникальныйИдентификатор);
	ПутьФайла = ОбъединитьПути(КаталогВременныхФайлов(), Каталог, "объект.ospx");
	Ответить("СкачатьИЗамерить", ОтветСТелом("200 OK", "hello"), Ложь);

	Ожидаем.Что(Отказ, "скачивание не состоялось").Заполнено();
	Ожидаем.Что(ОтказЗависимости, "сбой диска хаба — не недоступность корзины: " + Отказ).ЭтоЛожь();
	Ожидаем.Что(Отказ, "отказ называет причину платформы с путём файла").Содержит(Каталог);
	ПроверитьБезКлючей();

КонецПроцедуры

#КонецОбласти

#Область Размер

&Тест
Процедура МолчащееХранилищеРазмерОбрываетсяСвоимСроком() Экспорт

	Соединение = ЗапроситьМолчащее("СпроситьРазмерИЗамерить");

	Ожидаем.Что(Соединение <> Неопределено, "слушатель принял соединение").ЭтоИстина();
	Ожидаем.Что(ОтказЗависимости, "отказ назван недоступностью зависимости: " + Отказ).ЭтоИстина();
	Ожидаем.Что(Отказ, "отказ называет срок").Содержит(СтрШаблон("срок ожидания — %1 с", СрокСек()));
	ПроверитьСрок("запрос размера");
	ПроверитьБезКлючей();

КонецПроцедуры

&Тест
Процедура РазмерЧитаетсяИзЗаголовкаОтветаНаHEAD() Экспорт

	Запрос = Ответить("СпроситьРазмерИЗамерить", "HTTP/1.1 200 OK" + КонецСтроки()
		+ "Content-Length: 12345" + КонецСтроки() + КонецСтроки());

	Ожидаем.Что(Отказ, "размер назван").Равно("");
	Ожидаем.Что(РазмерОбъекта, "размер — из Content-Length").Равно(12345);
	Ожидаем.Что(СтрНачинаетсяС(Запрос, "HEAD /openhub/" + КлючОбъекта() + " "),
		"один HEAD объекта: " + Лев(Запрос, 80)).ЭтоИстина();
	Ожидаем.Что(НРег(Запрос), "запрос подписан SigV4").Содержит("authorization: aws4-hmac-sha256");

КонецПроцедуры

#КонецОбласти

#Область ЗаданияФона

// Задание скачивания: слушатель держит главный поток набора.
Процедура СкачатьИЗамерить() Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Клиент.СкачатьСоСроком(КлючОбъекта(), ПутьФайла, СрокСек());
	Исключение
		ЗапомнитьОтказ(ИнформацияОбОшибке(), ОписаниеОшибки());
	КонецПопытки;
	ЗапросЗанял = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

КонецПроцедуры

// Задание запроса размера: слушатель держит главный поток набора.
Процедура СпроситьРазмерИЗамерить() Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		РазмерОбъекта = Клиент.Размер(КлючОбъекта(), СрокСек());
	Исключение
		ЗапомнитьОтказ(ИнформацияОбОшибке(), ОписаниеОшибки());
	КонецПопытки;
	ЗапросЗанял = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

КонецПроцедуры

#КонецОбласти

#Область Обвязка

Процедура ЗапомнитьОтказ(Знач Сбой, Знач Описание)
	Отказ = Описание;
	ОтказЗависимости = ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ЗависимостьНедоступна());
	ОтказОтсутствия = ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден());
КонецПроцедуры

// Ключ доступа — латиницей: кириллица в нём роняет запрос до сети.
Функция ЗапуститьВФоне(Знач Порт, Знач Задание, Знач НовыйФайл = Истина)

	Клиент = Новый КлиентS3Oint("http://127.0.0.1:" + Формат(Порт, "ЧГ=0"), "us-east-1",
		"openhub", КлючДоступа(), СекретныйКлюч(), Истина, ЛогТестов());
	Если НовыйФайл Тогда
		ПутьФайла = ПолучитьИмяВременногоФайла("ospx");
	КонецЕсли;
	Отказ = "";
	ОтказЗависимости = Ложь;
	ОтказОтсутствия = Ложь;
	РазмерОбъекта = Неопределено;

	Возврат ФоновыеЗадания.Выполнить(ЭтотОбъект, Задание);

КонецФункции

// Слушатель принимает соединение и молчит, пока задание не сдастся.
Функция ЗапроситьМолчащее(Знач Задание)

	Порт = Выдача.Выдать();
	Сервер = ПоднятьСлушатель(Порт);

	Попытка
		Фон = ЗапуститьВФоне(Порт, Задание);
		Соединение = ПринятьСоединение(Сервер, 20000);
		Дождаться(Фон);
	Исключение
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Закрыть(Соединение);
	Остановить(Сервер, Порт);

	Возврат Соединение;

КонецФункции

// Слушатель отвечает на один запрос заданным ответом; возвращает начало запроса.
Функция Ответить(Знач Задание, Знач ОтветСлушателя, Знач НовыйФайл = Истина)

	Порт = Выдача.Выдать();
	Сервер = ПоднятьСлушатель(Порт);

	Попытка
		Фон = ЗапуститьВФоне(Порт, Задание, НовыйФайл);
		Запрос = ОтветитьНаЗапрос(Сервер, ОтветСлушателя);
		Дождаться(Фон);
	Исключение
		Остановить(Сервер, Порт);
		ВызватьИсключение;
	КонецПопытки;
	Остановить(Сервер, Порт);

	Возврат Запрос;

КонецФункции

// Нижняя граница — сторож ложной зелени: мгновенный отказ доказывает поломку, а не срок.
Процедура ПроверитьСрок(Знач Что)

	Ожидаем.Что(ЗапросЗанял >= МинимумОжиданияМс(),
		СтрШаблон("%1 ждал молчащее хранилище: %2 мс при сроке %3 с",
			Что, Формат(ЗапросЗанял, "ЧГ=0"), Формат(СрокСек(), "ЧГ=0"))).ЭтоИстина();
	Ожидаем.Что(ЗапросЗанял < ПотолокОжиданияМс(),
		СтрШаблон("и сдался в свой срок, а не ждал час: %1 мс", Формат(ЗапросЗанял, "ЧГ=0"))).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьБезКлючей()

	Журнал = Ловушка.Всё();
	Ожидаем.Что(Журнал, "самотест: журнал клиента на отладке не пуст").Заполнено();
	Для Каждого Ключ Из СтрРазделить(КлючДоступа() + "," + СекретныйКлюч(), ",") Цикл
		Ожидаем.Что(СтрНайти(Журнал, Ключ), "ключ доступа не попадает в журнал: " + Ключ).Равно(0);
		Ожидаем.Что(СтрНайти(Отказ, Ключ), "и в текст отказа: " + Ключ).Равно(0);
	КонецЦикла;

КонецПроцедуры

Функция ОтветСТелом(Знач Статус, Знач Тело)
	Возврат "HTTP/1.1 " + Статус + КонецСтроки()
		+ "Content-Length: " + Формат(СтрДлина(Тело), "ЧГ=0") + КонецСтроки() + КонецСтроки() + Тело;
КонецФункции

Функция КлючОбъекта()
	Возврат "pools/main/pkg/pkg-1.0.0.ospx";
КонецФункции

Функция КлючДоступа()
	Возврат "AKIAFETCH";
КонецФункции

Функция СекретныйКлюч()
	Возврат "fetch-secret-key";
КонецФункции

Функция СрокСек()
	Возврат 3;
КонецФункции

// Ниже этого запрос не ждал молчащее хранилище вовсе — значит упал не по сроку.
Функция МинимумОжиданияМс()
	Возврат 1500;
КонецФункции

// Потолок терпения теста: свой срок — секунды, а без него клиент oint ждёт час.
Функция ПотолокОжиданияМс()
	Возврат 30000;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.клиентs3");
КонецФункции

#КонецОбласти

#Область Слушатель

Функция ПоднятьСлушатель(Знач Порт)
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	Возврат Сервер;
КонецФункции

// ⚠ ОжидатьСоединения выжидает свой таймаут ЦЕЛИКОМ — ждём короткими ломтями.
Функция ПринятьСоединение(Знач Сервер, Знач ТаймаутМс)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутМс;
	Пока Истина Цикл
		Соединение = Сервер.ОжидатьСоединения(200);
		Если Соединение <> Неопределено Тогда
			Возврат Соединение;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

КонецФункции

// Принимает одно соединение: читает заголовки запроса, отвечает и закрывается. Возвращает
// прочитанное начало запроса; пустую строку — если соединения не было.
Функция ОтветитьНаЗапрос(Знач Сервер, Знач Ответ)

	Соединение = ПринятьСоединение(Сервер, 20000);
	Если Соединение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Соединение.ТаймаутЧтения = 5000;
	Запрос = ПолучитьСтрокуИзДвоичныхДанных(Соединение.ПрочитатьДвоичныеДанные(), "UTF-8");
	Соединение.ОтправитьСтроку(Ответ);
	Приостановить(100);
	Закрыть(Соединение);

	Возврат Запрос;

КонецФункции

Процедура Закрыть(Знач Соединение)

	Если Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Соединение.Закрыть();
	Исключение
		// клиент уже сдался по своему сроку — закрывать нечего
	КонецПопытки;

КонецПроцедуры

Процедура Остановить(Знач Сервер, Знач Порт)

	Попытка
		Сервер.Остановить();
	Исключение
		// слушатель мог не подняться — порт всё равно надо вернуть в оборот
	КонецПопытки;
	Выдача.Вернуть(Порт);

КонецПроцедуры

Процедура Дождаться(Знач Задание)

	Задания = Новый Массив();
	Задания.Добавить(Задание);
	ФоновыеЗадания.ОжидатьВсе(Задания, 60000);

КонецПроцедуры

Функция КонецСтроки()
	Возврат Символы.ВК + Символы.ПС;
КонецФункции

#КонецОбласти
