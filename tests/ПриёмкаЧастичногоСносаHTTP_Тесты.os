// Сквозняк частичного сбоя сноса личных пространств на настоящем хабе: одно пространство
// снести физически нельзя (каталог пакета закрыт на запись), и админ обязан увидеть отказ
// с двумя числами, включённую настройку, окно предупреждения — и суметь повторить операцию,
// когда причина устранена.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем КаталогПроекта;
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьЛичныеПространства.os");

	Хаб.ФайловаяБаза("openhub-частичный-снос");
	КореньХранилища = Хаб.КореньХранилища();
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Попытка
		Права(КаталогПакетаAnna(), "755");
	Исключение
	КонецПопытки;
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Сбой берётся с продуктового пути: каталог пакета закрыт на запись, снос области пула
// падает на нём. Хаб обязан снести остальные пространства, назвать оба числа, оставить
// настройку включённой и показать окно снова.
&Тест
Процедура ЧастичныйСносОтчитываетсяДвумяЧисламиИНеГаситТумблер() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "стенд: пространство anna есть").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("boris"), "стенд: пространство boris есть").ЭтоИстина();

	Права(КаталогПакетаAnna(), "500");

	Окно = ОткрытьОкно(КукаАдмина);
	Поля = ПоляФормыСо(Окно, "name=""подтверждение""");
	Поля.Вставить("подтверждение", ЧислоИзОкна(Окно));

	Ответ = Клиент.POSTФормы(Раздел(), Поля, КукаАдмина);
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "частичный снос — отказ, а не «сохранено»").Равно(400);
	Ожидаем.Что(СтрНайти(Тело_, "Снесено пространств — 3") > 0,
		"названо число снесённых").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "но 1 снести не удалось") > 0,
		"и число неснесённых — оба числа на экране").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "name=""подтверждение""") > 0,
		"окно предупреждения показано снова").ЭтоИстина();

	Ожидаем.Что(ЛичныйПулЕсть("boris"), "исправное пространство снесено").ЭтоЛожь();
	Ожидаем.Что(ЛичныйПулЕсть("anna"), "неудачное осталось").ЭтоИстина();
	Ожидаем.Что(НастройкаВключена(КукаАдмина),
		"тумблер НЕ погашен — переход остался, операцию можно повторить").ЭтоИстина();

КонецПроцедуры

// Причина устранена — повтор проходит из интерфейса тем же путём, без обходных манёвров.
&Тест
Процедура ПослеУстраненияПричиныОперацияПовторяетсяИДоводитсяДоКонца() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(ЛичныйПулЕсть("anna"), "состояние после частичного сноса").ЭтоИстина();

	Права(КаталогПакетаAnna(), "755");

	Окно = ОткрытьОкно(КукаАдмина);
	Ожидаем.Что(ЧислоИзОкна(Окно), "окно пересчитало остаток").Равно("1");

	Поля = ПоляФормыСо(Окно, "name=""подтверждение""");
	Поля.Вставить("подтверждение", "1");

	Ответ = Клиент.POSTФормы(Раздел(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "повтор принят").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Личные пространства выключены") > 0,
		"операция доведена до конца").ЭтоИстина();

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "пространство anna снесено").ЭтоЛожь();
	Ожидаем.Что(АртефактЕсть("anna", "anna-lib", "1.0.0"), "и его файл").ЭтоЛожь();
	Ожидаем.Что(НастройкаВключена(КукаАдмина), "только теперь тумблер погашен").ЭтоЛожь();

	// проектный пул каскад не тронул ни на одном из двух заходов
	Ожидаем.Что(Клиент.GET("/shared/shared-lib").КодСостояния, "проектный пул на месте").Равно(200);
	Ожидаем.Что(АртефактЕсть("shared", "shared-lib", "1.0.0"), "и его артефакт").ЭтоИстина();

	// След в аудите — ЛичныеПространства_Тесты: экран журнала читает файл лога, а не базу.

КонецПроцедуры

#Область Помощники

Функция Раздел()
	Возврат "/hub/settings/pools";
КонецФункции

Функция КаталогПакетаAnna()
	Возврат ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", "anna"), "anna-lib");
КонецФункции

Процедура Права(Знач Путь, Знач Режим)
	П = СоздатьПроцесс(СтрШаблон("chmod %1 ""%2""", Режим, Путь), , Истина);
	П.Запустить();
	П.ОжидатьЗавершения();
	Если П.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("chmod %1 %2 не удался: %3", Режим, Путь,
			П.ПолучитьВыводПотокаОшибок());
	КонецЕсли;
КонецПроцедуры

Функция ОткрытьОкно(Знач Кука)
	Возврат Клиент.Тело(Клиент.POSTФормы(Раздел(),
		ПоляФормыСо(Клиент.Тело(Клиент.GETСКукой(Раздел(), Кука)), "name=""oshub.pools.personal_enabled"""), Кука));
КонецФункции

Функция ЧислоИзОкна(Знач Окно)

	Маркер = "личных пространств — ";
	Поз = СтрНайти(Окно, Маркер);
	Если Поз = 0 Тогда
		ВызватьИсключение "В окне предупреждения нет числа удаляемых пространств";
	КонецЕсли;

	Остаток = Сред(Окно, Поз + СтрДлина(Маркер));
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;

	Возврат Цифры;

КонецФункции

Функция ЛичныйПулЕсть(Знач Логин)
	Возврат Клиент.GET("/" + Логин).КодСостояния = 200;
КонецФункции

Функция НастройкаВключена(Знач Кука)
	Разметка = Клиент.Тело(Клиент.GETСКукой(Раздел(), Кука));
	Возврат СтрНайти(Разметка, "name=""oshub.pools.personal_enabled"" value=""1"" checked") > 0;
КонецФункции

Функция АртефактЕсть(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Путь = ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", ИмяПула), ИмяПакета,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Возврат Новый Файл(Путь).Существует();
КонецФункции

Функция ПоляФормыСо(Знач Разметка, Знач Маркер)

	Результат = Новый Соответствие();

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет формы с маркером " + Маркер;
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<form");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<form");
	КонецЦикла;
	Если Начало = 0 Тогда
		ВызватьИсключение "Маркер " + Маркер + " найден вне формы";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</form>");
	Форма = ?(Конец = 0, Остаток, Лев(Остаток, Конец));

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл
		Если НЕ СтрНачинаетсяС(НРег(Кусок), "input") Тогда
			Продолжить;
		КонецЕсли;
		Имя = ЗначениеАтрибута(Кусок, "name");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Имя, ЗначениеАтрибута(Кусок, "value"));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Атрибут)
	Маркер = Атрибут + "=""";
	Поз = СтрНайти(Тег, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));
КонецФункции

#КонецОбласти
