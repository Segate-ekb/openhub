// Живая приёмка ИСТ-АПСТ-009: причина, по которой источник молчал, переживает ПЕРЕЗАПУСК
// хаба. Два экземпляра поднимаются по очереди на ОДНОЙ файловой базе — второй и есть
// перезапустившийся хаб: память процесса у него пуста, а написанное в базу на месте.
// Каталоги базы и хранилища держит сам набор: ЭкземплярХаба сносит свой временный корень
// при остановке, и база не дожила бы до второго запуска.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — текущий поднятый экземпляр
Перем Клиент;          // фикстура КлиентХаба — запросы к нему
Перем КаталогПроекта;
Перем КореньДанных;    // каталог, переживающий перезапуск: db/ и storage/
Перем МёртвыйАдрес;    // заявленный, но никем не слушаемый порт

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	МёртвыйАдрес = "http://127.0.0.1:39947/download/";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	КореньДанных = УникальныеИмена.ВременныйКаталог("oshub-память-источников");
	СоздатьКаталог(КаталогБазы());
	СоздатьКаталог(КореньХранилища());

	Хаб = НовыйХаб(Истина);
	КаталогПроекта = Хаб.КаталогПроекта();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КореньДанных);

КонецПроцедуры

// Критерий ИСТ-АПСТ-009: причина, по которой источник числился лежащим, переживает
// перезапуск и названа вместе с моментом последнего наблюдения — и на экране источников,
// и карточкой API. Прошлое наблюдение за нынешний вердикт не выдаётся: перезапустившийся
// хаб честно говорит, что источник ещё не проверял.
&Тест
Процедура ПричинаМолчанияПереживаетПерезапускИВиднаЭкрануИAPI() Экспорт

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Токен = ВыпуститьPAT(Кука);
	Раздел = "/owned/settings/upstreams";

	Заведение = СтрШаблон("{""url"":""%1"",""ttl"":300}", МёртвыйАдрес);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/upstreams",
		Заведение, Токен).КодСостояния, "источник заведён").Равно(201);

	// боевой запрос выдачи честно платит одним таймаутом за упавший источник
	Ожидаем.Что(Клиент.GETСТокеном(
		"/api/v1/pools/owned/download/net-takogo/net-takogo-1.0.0.ospx", Токен).КодСостояния,
		"пакета нет ни у пула, ни у источника").Равно(404);

	Ожидаем.Что(СостояниеКарточки(Токен), "источник числится лежащим").Равно("down");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(Раздел, Кука)), "лежит с ") > 0,
		"и экран говорит то же").ЭтоИстина();

	Перезапустить();

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Токен = ВыпуститьPAT(Кука);

	Карточка = КарточкаИсточника(Токен);
	Ожидаем.Что(Карточка.Получить("state"),
		"перезапустившийся хаб источник ещё не проверял").Равно("unknown");

	Прошлая = Карточка.Получить("last_failure");
	Ожидаем.Что(Прошлая <> Неопределено, "но помнит, что у него не получилось").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Прошлая.Получить("reason")),
		"с причиной: " + Строка(Прошлая.Получить("reason"))).ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Прошлая.Получить("at")),
		"и моментом последнего наблюдения").ЭтоИстина();

	Страница = Клиент.Тело(Клиент.GETСКукой(Раздел, Кука));
	Ожидаем.Что(СтрНайти(Страница, "ещё не проверялся после перезапуска") > 0,
		"экран называет прошлое наблюдение прошлым: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "в последний раз не отвечал") > 0,
		"и говорит, чем источник молчал").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "лежит с "),
		"нынешним вердиктом прошлое наблюдение не притворяется").Равно(0);

КонецПроцедуры

#Область Служебные

// Останавливает хаб и поднимает новый на той же базе — то же самое, что перезапуск
// боевой инсталляции.
Процедура Перезапустить()

	Хаб.Остановить();
	Хаб = НовыйХаб(Ложь);

КонецПроцедуры

// Экземпляр хаба на общей базе набора. Засев нужен только первому: учётки и пулы
// второй читает из той же базы, что и написанные помехи.
Функция НовыйХаб(Знач СЗасевом)

	Экземпляр = Новый ЭкземплярХаба(90);

	Экземпляр.Среда("OSHUB_DB_CONNECTION", КаталогБазы());
	Экземпляр.Среда("OSHUB_STORAGE_ROOT", КореньХранилища());
	Экземпляр.Среда("OSHUB_ADMIN_LOGIN", "");
	Экземпляр.Среда("OSHUB_ADMIN_PASSWORD", "");
	Экземпляр.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	Если СЗасевом Тогда
		Экземпляр.ЗапуститьСидер(ОбъединитьПути(Экземпляр.КаталогПроекта(),
			"scripts", "сидеры", "ЗасеятьКабинет.os"));
	КонецЕсли;

	Экземпляр.Запустить();
	Клиент = Новый КлиентХаба(Экземпляр, 60);
	Возврат Экземпляр;

КонецФункции

Функция СостояниеКарточки(Знач Токен)
	Возврат Строка(КарточкаИсточника(Токен).Получить("state"));
КонецФункции

Функция КарточкаИсточника(Знач Токен)

	Список = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned/upstreams", Токен));
	Для Каждого Карточка Из Список.Получить("items") Цикл
		Если Строка(Карточка.Получить("url")) = МёртвыйАдрес Тогда
			Возврат Карточка;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("В выдаче апстримов нет источника ""%1""", МёртвыйАдрес);

КонецФункции

Функция ВыпуститьPAT(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);

	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write"",""пул"":0}", КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;

	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

КонецФункции

Функция КаталогБазы()
	Возврат ОбъединитьПути(КореньДанных, "db");
КонецФункции

Функция КореньХранилища()
	Возврат ОбъединитьПути(КореньДанных, "storage");
КонецФункции

#КонецОбласти
