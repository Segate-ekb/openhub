// HTTP-интеграционные тесты JSON API v2 (/api/v1/*): поднимает настоящий хаб на файловой БД, засеянной сидером
// ЗасеятьКабинет.os, и гоняет сценарии по реальному HTTP — чтение, видимость, публикация, теги, аутентификация, ошибки.

#Использовать asserts
#Использовать ospx-tools
#Использовать "фикстуры"

Перем Хаб;              // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;           // фикстура КлиентХаба — запросы к подопытному хабу
Перем Порт;
Перем КаталогПроекта;
Перем КореньДанных;

Перем ТокенAlice;   // PAT alice (read,write) — автор alice-pkg
Перем ТокенBob;     // PAT bob — без прав на alice-pkg / без создания пула
Перем ТокенRoot;    // PAT root — admin
Перем ТокенOwner;   // PAT owner1 — владелец приватного пула owned
Перем КукаAlice;    // сессия alice (для теста сессия+CSRF)
Перем CSRFAlice;    // CSRF-токен сессии alice

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);
	КаталогПроекта = Хаб.КаталогПроекта();
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьКабинет.os");

	// фикстура сборки .ospx (в контейнер не входит — регистрируем в процессе теста)
	РеестрФикстур.Подключить("ФикстураПакета");

	КореньДанных = Хаб.ФайловаяБаза("openhub-apiv2");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// инсталляция без почты выбирает одну из двух развилок (ИСТ-ПОЧТ-007); здесь —
	// выключенное подтверждение адреса, иначе регистрация закрыта
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();     // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();

	// сессии → PAT'ы для каждого актёра
	КукаAlice = Клиент.Войти("alice", "AlicePassw0rd");
	ТокенAlice = ВыпуститьPAT(КукаAlice);
	ТокенBob = ВыпуститьPAT(Клиент.Войти("bob", "BobPassw0rd"));
	ТокенRoot = ВыпуститьPAT(Клиент.Войти("root", "RootPassw0rd"));
	ТокенOwner = ВыпуститьPAT(Клиент.Войти("owner1", "Owner1Passw0rd"));

	// CSRF-токен сессии alice — берём из HTML кабинета (токен session-bound, не page-bound)
	CSRFAlice = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/tokens", КукаAlice)));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	// фикстура снимает процесс, заявку на порт, окружение и временные каталоги независимо от исхода набора
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ЗдоровьеИМетрики() Экспорт
	Здор = Клиент.GET("/api/v1/health");
	Ожидаем.Что(Здор.КодСостояния, "health 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Здор).Получить("status")).Равно("ok");

	Метр = Клиент.GET("/api/v1/metrics");
	Ожидаем.Что(Метр.КодСостояния, "metrics 200").Равно(200);
	ТМетр = Клиент.ТелоJSON(Метр);
	Ожидаем.Что(ТМетр.Получить("pools_total") >= 1, "metrics: есть пулы").ЭтоИстина();
КонецПроцедуры

// /metrics анониму не раскрывает число приватных пулов: публичные счётчики равны тому, что видно в листингах.
&Тест
Процедура МетрикиТолькоПубличное() Экспорт

	// приватный пул owned существует (сидер), но аноним его не видит и в /pools
	АнонПулы = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools?pageSize=100"));
	ВидимоПулов = АнонПулы.Получить("total");

	// сумма НЕскрытых пакетов по видимым анониму (=публичным) пулам
	ВидимоПакетов = 0;
	Для Каждого П Из АнонПулы.Получить("items") Цикл
		Имя = Строка(П.Получить("name"));
		ВидимоПакетов = ВидимоПакетов + Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/" + Имя + "/packages?pageSize=1")).Получить("total");
	КонецЦикла;

	ТМетр = Клиент.ТелоJSON(Клиент.GET("/api/v1/metrics"));
	Ожидаем.Что(ТМетр.Получить("pools_total"), "metrics.pools_total = только публичные пулы").Равно(ВидимоПулов);
	Ожидаем.Что(ТМетр.Получить("packages_total"), "metrics.packages_total = только публичные пакеты").Равно(ВидимоПакетов);

	// приватный пул owned НЕ должен попасть в число (аноним его не видит)
	Ожидаем.Что(Клиент.GET("/api/v1/pools/owned").КодСостояния, "owned приватен для анонима").Равно(404);
	// прямой контроль: публичный пул один (public), приватные (owned и созданные приватные) не в счёте
	Ожидаем.Что(ВидимоПулов >= 1, "хотя бы один публичный пул").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура OpenapiПрисутствует() Экспорт
	Ответ = Клиент.GET("/api/v1/openapi.json");
	Ожидаем.Что(Ответ.КодСостояния, "openapi 200").Равно(200);
	Док = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(ЗначениеЗаполнено(Док.Получить("openapi")), "поле openapi").ЭтоИстина();
	Пути = Док.Получить("paths");
	Ожидаем.Что(Пути.Получить("/pools") <> Неопределено, "путь /pools описан").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/search") <> Неопределено, "путь /search описан").ЭтоИстина();

	// выдача для opm — часть ТОГО ЖЕ API, значит она обязана быть в его описании
	Ожидаем.Что(Пути.Получить("/pools/{pool}/download/list.txt") <> Неопределено,
		"list.txt описан").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/pools/{pool}/download/{name}/{file}") <> Неопределено,
		"выдача .ospx описана").ЭтоИстина();
	Ожидаем.Что(Пути.Получить("/pools/{pool}/channels/{channel}/download/{name}/{file}") <> Неопределено,
		"канальная выдача .ospx описана").ЭтоИстина();
	Пуш = Пути.Получить("/pools/{pool}/push");
	Ожидаем.Что(Пуш <> Неопределено, "push описан").ЭтоИстина();
	Ожидаем.Что(Пуш.Получить("post") <> Неопределено, "у push есть POST").ЭтоИстина();

	// описание — единственное, по чему интегратор узнаёт язык адреса: необязательный
	// параметр, о котором там не сказано, для него не существует
	Для Каждого Адрес Из СтрРазделить("/pools/{pool}/download/{name}/{file}|"
		+ "/pools/{pool}/channels/{channel}/download/{name}/{file}", "|") Цикл
		Сводка = Строка(Пути.Получить(Адрес).Получить("get").Получить("summary"));
		Ожидаем.Что(СтрНайти(Сводка, "?spec=") > 0,
			"в описании " + Адрес + " назван параметр spec: " + Сводка).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Сводка, "основного тега") > 0,
			"и то, что безверсионное имя файла отдаёт версию основного тега: " + Сводка).ЭтоИстина();
	КонецЦикла;

	СводкаРезолва = Строка(Пути.Получить("/pools/{pool}/packages/{name}/resolve").Получить("get").Получить("summary"));
	Ожидаем.Что(СтрНайти(СводкаРезолва, "точная версия") > 0,
		"в описании резолва названа первая ступень лесенки: " + СводкаРезолва).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СводкаРезолва, "yanked") > 0,
		"и пометка отзыва в ответе: " + СводкаРезолва).ЭтоИстина();

	// адрес, которого нет в описании, клиент не найдёт: описанный, но несуществующий адрес врёт ровно так же
	Открепление = Пути.Получить("/pools/{pool}/packages/{name}/tags/{tag}/pin");
	Ожидаем.Что(Открепление <> Неопределено,
		"упразднённое открепление описано как упразднённое").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Открепление.Получить("delete").Получить("summary")), "410") > 0,
		"в описании открепления сказано про 410").ЭтоИстина();

	Состав = Пути.Получить("/pools/{pool}/packages/{name}/tags/{tag}/versions/{version}");
	Ожидаем.Что(Состав <> Неопределено, "правка состава канала описана").ЭтоИстина();
	Ожидаем.Что(Состав.Получить("put") <> Неопределено, "у состава есть PUT").ЭтоИстина();
	Ожидаем.Что(Состав.Получить("delete") <> Неопределено, "у состава есть DELETE").ЭтоИстина();
	Схемы = Док.Получить("components").Получить("schemas");
	Ожидаем.Что(Схемы.Получить("Error") <> Неопределено, "схема Error").ЭтоИстина();

	// коды, которыми публикация отвечает на самом деле: неописанный код клиент разбирает наугад
	Для Каждого Адрес Из СтрРазделить("/pools/{pool}/push|/pools/{pool}/packages/{name}/versions", "|") Цикл
		Ответы_ = Пути.Получить(Адрес).Получить("post").Получить("responses");
		Ожидаем.Что(Ответы_.Получить("202") <> Неопределено,
			"у " + Адрес + " описан 202 (заявка во «входящие»)").ЭтоИстина();
		Ожидаем.Что(Ответы_.Получить("429") <> Неопределено,
			"у " + Адрес + " описан 429 (предел незакрытых заявок)").ЭтоИстина();
		Ожидаем.Что(Ответы_.Получить("413") <> Неопределено,
			"у " + Адрес + " описан 413 (артефакт больше предела)").ЭтоИстина();
		Ожидаем.Что(Ответы_.Получить("507") <> Неопределено,
			"у " + Адрес + " описан 507 (квота пула исчерпана)").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Строка(Ответы_.Получить("202").Получить("description")), "queued") > 0,
			"описание 202 называет статус тела").ЭтоИстина();
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура СписокПуловПагинация() Экспорт
	Ответ = Клиент.GET("/api/v1/pools");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Т = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(Т.Получить("items") <> Неопределено, "items присутствует").ЭтоИстина();
	Ожидаем.Что(Т.Получить("page")).Равно(1);
	Ожидаем.Что(Т.Получить("total") >= 1, "total>=1").ЭтоИстина();

	// пустая страница за границей — items пуст, total сохраняется
	Пустая = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools?page=999"));
	Ожидаем.Что(Пустая.Получить("items").Количество(), "пустая страница").Равно(0);
	Ожидаем.Что(Пустая.Получить("total") >= 1, "total не потерян").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ОтборПуловПоИмениНеРасширяетВидимость() Экспорт

	// владелец находит свой приватный пул по имени
	Влад = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools?query=owned&pageSize=100", ТокенOwner));
	Ожидаем.Что(СодержитПул(Влад.Получить("items"), "owned"), "владелец находит свой пул").ЭтоИстина();

	// аноним по тому же запросу приватный пул не получает: поиск сужает выдачу, а не открывает её
	Аноним = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools?query=owned&pageSize=100"));
	Ожидаем.Что(СодержитПул(Аноним.Получить("items"), "owned"),
		"аноним приватный пул не находит").ЭтоЛожь();

	// отбор именно отбирает: пул, не подходящий под запрос, из выдачи ушёл
	Отобранные = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools?query=public&pageSize=100"));
	Ожидаем.Что(СодержитПул(Отобранные.Получить("items"), "public"), "подошедший пул на месте").ЭтоИстина();
	Ожидаем.Что(СодержитПул(Отобранные.Получить("items"), "owner1"),
		"не подошедший пул отобран").ЭтоЛожь();

	// опечатка в имени — нечёткий этап поиска
	Опечатка = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools?query=publci&pageSize=100"));
	Ожидаем.Что(СодержитПул(Опечатка.Получить("items"), "public"), "опечатка находит публичный пул").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КарточкаПулаИ404() Экспорт
	Ответ = Клиент.GET("/api/v1/pools/public");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("pool").Получить("name")).Равно("public");

	НетТакого = Клиент.GET("/api/v1/pools/nonexistent");
	Ожидаем.Что(НетТакого.КодСостояния, "неизвестный пул 404").Равно(404);
	ПроверитьФорматОшибки(НетТакого, "pool_not_found");
КонецПроцедуры

&Тест
Процедура ПриватныйПулАнониму404ВладельцуВиден() Экспорт
	// аноним НЕ должен отличить приватный пул от несуществующего (не раскрываем)
	Аноним = Клиент.GET("/api/v1/pools/owned");
	Ожидаем.Что(Аноним.КодСостояния, "приватный пул анониму 404").Равно(404);
	ПроверитьФорматОшибки(Аноним, "pool_not_found");

	// bob (не участник) тоже 404
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned", ТокенBob).КодСостояния, "чужому 404").Равно(404);

	// владелец owner1 видит свой приватный пул
	Влад = Клиент.GETСТокеном("/api/v1/pools/owned", ТокенOwner);
	Ожидаем.Что(Влад.КодСостояния, "владельцу приватный виден").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Влад).Получить("pool").Получить("visibility")).Равно("private");
КонецПроцедуры

&Тест
Процедура СозданиеПулаПравоИДубликат() Экспорт
	// bob без права создания → 403
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools", "{""имя"":""bobpool""}", ТокенBob).КодСостояния,
		"bob без права создания пула → 403").Равно(403);

	// root (admin) создаёт пул → 201
	Созд = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools", "{""имя"":""apipool"",""тип"":""custom"",""видимость"":""private""}", ТокенRoot);
	Ожидаем.Что(Созд.КодСостояния, "root создаёт пул → 201").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Созд).Получить("pool").Получить("name")).Равно("apipool");

	// дубликат → 409
	Дубль = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools", "{""имя"":""public""}", ТокенRoot);
	Ожидаем.Что(Дубль.КодСостояния, "дубликат пула → 409").Равно(409);
	ПроверитьФорматОшибки(Дубль, "pool_exists");
КонецПроцедуры

&Тест
Процедура СписокПакетовПулаИФильтр() Экспорт
	Все = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages"));
	Ожидаем.Что(Все.Получить("total") >= 1, "есть пакеты").ЭтоИстина();
	Ожидаем.Что(СодержитПакет(Все.Получить("items"), "alice-pkg"), "alice-pkg в списке").ЭтоИстина();

	// фильтр по подстроке имени
	Найдено = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages?query=alice"));
	Ожидаем.Что(СодержитПакет(Найдено.Получить("items"), "alice-pkg"), "фильтр находит").ЭтоИстина();
	Пусто = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages?query=zzzznope"));
	Ожидаем.Что(Пусто.Получить("total"), "фильтр без совпадений").Равно(0);
КонецПроцедуры

&Тест
Процедура КарточкаПакетаИ404() Экспорт
	Карт = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg")).Получить("package");
	Ожидаем.Что(Карт.Получить("name")).Равно("alice-pkg");
	Ожидаем.Что(Карт.Получить("versions_total") >= 2, "versions_total>=2").ЭтоИстина();
	Ожидаем.Что(Карт.Получить("latest_version")).Равно("1.1.0");
	Ожидаем.Что(Карт.Получить("keywords") <> Неопределено, "keywords массив").ЭтоИстина();
	Ожидаем.Что(Карт.Получить("tags") <> Неопределено, "tags массив").ЭтоИстина();

	НетПак = Клиент.GET("/api/v1/pools/public/packages/nopkg");
	Ожидаем.Что(НетПак.КодСостояния, "нет пакета 404").Равно(404);
	ПроверитьФорматОшибки(НетПак, "package_not_found");
КонецПроцедуры

&Тест
Процедура ВерсииПакета() Экспорт
	Верс = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/versions")).Получить("versions");
	Ожидаем.Что(Верс.Количество() >= 2, "две версии").ЭтоИстина();
	Первая = Верс[0];
	Ожидаем.Что(ЗначениеЗаполнено(Первая.Получить("sha256")), "sha256 присутствует").ЭтоИстина();
	Ожидаем.Что(Первая.Получить("semver") <> Неопределено, "semver-метаданные").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура РезолвSpecТегИОшибки() Экспорт
	// spec → максимальная удовлетворяющая
	Р = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve?spec=^1.0"));
	Ожидаем.Что(Р.Получить("version")).Равно("1.1.0");
	Ожидаем.Что(ЗначениеЗаполнено(Р.Получить("url")), "url присутствует").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Р.Получить("sha256")), "sha256 присутствует").ЭтоИстина();

	// без параметров → latest
	РЛатест = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve"));
	Ожидаем.Что(РЛатест.Получить("version")).Равно("1.1.0");

	// мусорный spec → 422
	Плохой = Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve?spec=%5E%5Bbad");
	Ожидаем.Что(Плохой.КодСостояния, "мусорный spec → 422").Равно(422);
	ПроверитьФорматОшибки(Плохой, "invalid_spec");

	// channel — устаревший синоним spec: неизвестное имя → 404 tag_not_found, а не молча другая версия
	НетТега = Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve?channel=nope");
	Ожидаем.Что(НетТега.КодСостояния, "неизвестное имя тега → 404").Равно(404);
	ПроверитьФорматОшибки(НетТега, "tag_not_found");

	// незаведённое имя канала — «нет такого», и отказ называет его сам
	База = "/api/v1/pools/public/packages/alice-pkg/tags/";
	НетКанала = Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve?spec=stable");
	Ожидаем.Что(НетКанала.КодСостояния, "незаведённый stable → 404").Равно(404);
	Ожидаем.Что(СтрНайти(НетКанала.ПолучитьТелоКакСтроку(), "stable") > 0,
		"и отказ называет незаведённое имя").ЭтоИстина();

	// spec принимает ИМЯ ТЕГА и отдаёт КОНКРЕТНУЮ версию (О-9) — заведённого тега
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "stable/versions/1.1.0", "", ТокенAlice).КодСостояния,
		"канал stable заведён").Равно(200);
	Попытка
		ПоТегу = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve?spec=stable"));
		Ожидаем.Что(ПоТегу.Получить("version"), "resolve по имени заведённого тега").Равно("1.1.0");
	Исключение
		Клиент.ЗапросJSONСТокеном("DELETE", База + "stable", "", ТокенAlice);
		ВызватьИсключение;
	КонецПопытки;
	Клиент.ЗапросJSONСТокеном("DELETE", База + "stable", "", ТокенAlice);
КонецПроцедуры

&Тест
Процедура ReadmeОтдаётся() Экспорт
	Ответ = Клиент.GET("/api/v1/pools/public/packages/alice-pkg/readme");
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Т = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(Т.Получить("has_readme") <> Неопределено, "поле has_readme").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ГлобальныйПоискСубъект() Экспорт
	Рез = Клиент.ТелоJSON(Клиент.GET("/api/v1/search?q=alice"));
	Ожидаем.Что(Рез.Получить("total") >= 1, "поиск нашёл").ЭтоИстина();
	Ожидаем.Что(СодержитПакет(Рез.Получить("items"), "alice-pkg"), "alice-pkg в выдаче").ЭтоИстина();
	Ожидаем.Что(Рез.Получить("page") <> Неопределено, "пагинация в ответе").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПубликацияPATИммутабельность() Экспорт
	// owner1 — владелец пула (не admin): запрет одинаков для всех ролей
	Путь = "/api/v1/pools/owned/packages/immutpkg/versions";

	// аноним → 401
	Ожидаем.Что(Публикация(Путь, OspxДанные("immutpkg", "1.0.0"), "immutpkg-1.0.0.ospx", "").КодСостояния,
		"аноним публикует → 401").Равно(401);

	// owner1 с PAT публикует пакет → 201
	Успех = Публикация(Путь, OspxДанные("immutpkg", "1.0.0"), "immutpkg-1.0.0.ospx", ТокенOwner);
	Ожидаем.Что(Успех.КодСостояния, "PAT публикация → 201: " + Клиент.Тело(Успех)).Равно(201);

	// новая версия видна владельцу через API (пул приватный)
	Верс = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned/packages/immutpkg/versions", ТокенOwner)).Получить("versions");
	Ожидаем.Что(СодержитВерсию(Верс, "1.0.0"), "версия 1.0.0 опубликована").ЭтоИстина();

	// повторная публикация номера → 409: запрет держит базовый тег
	Повтор = Публикация(Путь, OspxДанные("immutpkg", "1.0.0"), "immutpkg-1.0.0.ospx", ТокенOwner);
	Ожидаем.Что(Повтор.КодСостояния, "повтор номера → 409").Равно(409);
	ПроверитьФорматОшибки(Повтор, "conflict");

	// и эта дверь понимает «?force=1» так же, как push: параметр разбирает тот же домен
	Форсом = Публикация(Путь + "?force=1", OspxДанные("immutpkg", "1.0.0"),
		"immutpkg-1.0.0.ospx", ТокенOwner);
	Ожидаем.Что(Форсом.КодСостояния, "форс на двери versions заменяет номер: "
		+ Клиент.Тело(Форсом)).Равно(200);
КонецПроцедуры

&Тест
Процедура ПриватныйПакетНеУтекает() Экспорт
	// root (admin) публикует пакет в ПРИВАТНЫЙ пул owned
	Путь = "/api/v1/pools/owned/packages/secretpkg/versions";
	Пуб = Публикация(Путь, OspxДанные("secretpkg", "1.0.0"), "secretpkg-1.0.0.ospx", ТокенRoot);
	Ожидаем.Что(Пуб.КодСостояния, "root публикует в приватный owned → 201: " + Клиент.Тело(Пуб)).Равно(201);

	// аноним НЕ видит пакеты приватного пула (404 на пул)
	Ожидаем.Что(Клиент.GET("/api/v1/pools/owned/packages").КодСостояния, "аноним: пакеты приватного пула 404").Равно(404);
	Ожидаем.Что(Клиент.GET("/api/v1/pools/owned/packages/secretpkg").КодСостояния, "аноним: приватный пакет 404").Равно(404);

	// владелец видит
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/packages/secretpkg", ТокенOwner).КодСостояния,
		"владельцу приватный пакет виден").Равно(200);

	// глобальный поиск анониму НЕ раскрывает приватный пакет
	Аноним = Клиент.ТелоJSON(Клиент.GET("/api/v1/search?q=secretpkg"));
	Ожидаем.Что(СодержитПакет(Аноним.Получить("items"), "secretpkg"), "аноним НЕ находит приватный пакет").ЭтоЛожь();

	// владельцу поиск его показывает (проброс субъекта)
	Влад = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/search?q=secretpkg", ТокенOwner));
	Ожидаем.Что(СодержитПакет(Влад.Получить("items"), "secretpkg"), "владельцу поиск показывает приватный").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура YankUnyankГейты() Экспорт
	Верс = "/api/v1/pools/public/packages/alice-pkg/versions/1.0.0";

	// аноним → 401
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":true}", "").КодСостояния, "аноним yank → 401").Равно(401);
	// чужой bob → 403 (нет прав на alice-pkg)
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":true}", ТокенBob).КодСостояния, "bob yank чужого → 403").Равно(403);
	// невалидный токен → 401
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":true}", "oshub_bogus_token").КодСостояния, "битый PAT → 401").Равно(401);

	// alice (автор) yank → 200, статус отражён
	Отзыв = Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":true}", ТокенAlice);
	Ожидаем.Что(Отзыв.КодСостояния, "alice yank → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Отзыв).Получить("version").Получить("yanked")).ЭтоИстина();

	// unyank возвращает
	Восст = Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":false}", ТокенAlice);
	Ожидаем.Что(Клиент.ТелоJSON(Восст).Получить("version").Получить("yanked")).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ТегИРазрешениеПоТегу() Экспорт
	// alice назначает тег beta версии 1.1.0
	Тег = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/beta", "{""version"":""1.1.0""}", ТокенAlice);
	Ожидаем.Что(Тег.КодСостояния, "alice тег → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Тег).Получить("version")).Равно("1.1.0");

	// разрешение name@tag: resolve?channel=beta → 1.1.0
	Разр = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve?channel=beta"));
	Ожидаем.Что(Разр.Получить("version"), "resolve по тегу beta").Равно("1.1.0");

	// чужой bob не может назначать тег → 403
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/hack", "{""version"":""1.0.0""}", ТокенBob).КодСостояния,
		"bob тег чужого → 403").Равно(403);
КонецПроцедуры

// Имя тега и номер версии в одном пакете не пересекаются: запись «пакет@1.1.0» читается сначала
// как точная версия, и одноимённый тег был бы недостижим. Отказ приходит СО СВОИМ кодом на всех
// трёх адресах заведения тега — общее «некорректный тег» не сказало бы мейнтейнеру, чем имя занято.
&Тест
Процедура ИменемВерсииТегНеЗаводитсяНиОднимАдресом() Экспорт

	Прямой = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/1.1.0",
		"{""mode"":""ручной""}", ТокенAlice);
	Ожидаем.Что(Прямой.КодСостояния, "PUT tags/1.1.0 → 422").Равно(422);
	ПроверитьФорматОшибки(Прямой, "tag_name_is_version");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Прямой), "занято версией") > 0,
		"причина названа словами, а не «некорректный тег»").ЭтоИстина();

	Метка = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/1.0.0/versions/1.1.0",
		"", ТокенAlice);
	Ожидаем.Что(Метка.КодСостояния, "метка версии тегом-именем версии → 422").Равно(422);
	ПроверитьФорматОшибки(Метка, "tag_name_is_version");

	Легаси = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/channels/1.1.0",
		"{""тип"":""semver"",""паттерн"":""^1.0""}", ТокенAlice);
	Ожидаем.Что(Легаси.КодСостояния, "легаси-переходник каналов → 422").Равно(422);
	ПроверитьФорматОшибки(Легаси, "tag_name_is_version");

	// КОНТРОЛЬ: «1.9» выглядит версией, но версии с такой строкой у пакета нет — имя свободно
	Свободное = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/1.9",
		"{""rule"":""^1.0"",""ruleType"":""semver""}", ТокенAlice);
	Ожидаем.Что(Свободное.КодСостояния, "имя, не занятое версией, заводится → 200").Равно(200);

	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/public/packages/alice-pkg/tags/1.9", "", ТокенAlice);

КонецПроцедуры

// Оформление тега — часть его контракта, и словарь у формы и у API ОДИН. В хабе хранится
// КЛЮЧ: цвет даёт тема клиента, поэтому одна и та же выдача читается в обеих темах.
&Тест
Процедура ОформлениеТегаВAPIСудитсяТемЖеСловарёмЧтоИФорма() Экспорт

	Путь = "/api/v1/pools/public/packages/alice-pkg/tags/painted";

	Создание = Клиент.ЗапросJSONСТокеном("PUT", Путь,
		"{""mode"":""ручной"",""style"":""special"",""icon"":""lock""}", ТокенAlice);
	Ожидаем.Что(Создание.КодСостояния, "ручной тег с оформлением создан").Равно(200);
	Данные = Клиент.ТелоJSON(Создание);
	Ожидаем.Что(Данные.Получить("style"), "стиль отдан ключом").Равно("special");
	Ожидаем.Что(Данные.Получить("icon"), "значок отдан ключом").Равно("lock");
	Ожидаем.Что(Данные.Получить("version"), "новый ручной канал пуст").Равно("");

	// цвета в выдаче нет вовсе: он живёт в теме клиента, а не в данных хаба
	Тело_ = Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags").ПолучитьТелоКакСтроку();
	Ожидаем.Что(СтрНайти(Тело_, "special") > 0, "ключ стиля доехал до выдачи тегов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "borderColor"), "поля цвета рамки больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело_, "textColor"), "поля цвета надписи больше нет").Равно(0);

	// русские имена полей — как везде в проекте
	Русские = Клиент.ЗапросJSONСТокеном("PUT", Путь,
		"{""mode"":""ручной"",""стиль"":""deprecated"",""значок"":""""}", ТокенAlice);
	Ожидаем.Что(Клиент.ТелоJSON(Русские).Получить("style"), "русская пара имён работает").Равно("deprecated");
	Ожидаем.Что(Клиент.ТелоJSON(Русские).Получить("icon"), "пустой значок — плашка без значка").Равно("");

	// вызов БЕЗ полей оформления его не стирает
	Без = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной""}", ТокенAlice);
	Ожидаем.Что(Клиент.ТелоJSON(Без).Получить("style"),
		"поля оформления не присланы — оформление не тронуто").Равно("deprecated");

	// незнакомый ключ отбивается отдельным кодом, до мутации
	ПлохойСтиль = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной"",""style"":""кислотный""}", ТокенAlice);
	Ожидаем.Что(ПлохойСтиль.КодСостояния, "незнакомый стиль отбит").Равно(422);
	ПроверитьФорматОшибки(ПлохойСтиль, "invalid_style");

	ПлохойЗначок = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной"",""icon"":""череп""}", ТокенAlice);
	Ожидаем.Что(ПлохойЗначок.КодСостояния, "незнакомый значок отбит").Равно(422);
	ПроверитьФорматОшибки(ПлохойЗначок, "invalid_icon");

	Ожидаем.Что(Клиент.ТелоJSON(Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной""}", ТокенAlice)).Получить("style"),
		"отказы прошли ДО записи").Равно("deprecated");

	Клиент.ЗапросJSONСТокеном("DELETE", Путь, "", ТокенAlice);

КонецПроцедуры

// Запрет повторной публикации — настройка ТЕГА, а значит читается и правится из API так же,
// как оформление: без него владельцу пришлось бы ходить в веб-форму ради того, чем управляет
// его же CI.
&Тест
Процедура ЗапретПовторнойПубликацииЧитаетсяИПравитсяИзAPI() Экспорт

	Путь = "/api/v1/pools/public/packages/alice-pkg/tags/repush";

	Создание = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной""}", ТокенAlice);
	Ожидаем.Что(Создание.КодСостояния, "ручной тег создан").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Создание).Получить("overwrite_allowed"),
		"новый тег переиздание номеров не разрешает").ЭтоЛожь();

	Снятие = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной"",""overwrite_allowed"":true}", ТокенAlice);
	Ожидаем.Что(Клиент.ТелоJSON(Снятие).Получить("overwrite_allowed"),
		"запрет снят и виден в ответе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags").ПолучитьТелоКакСтроку(),
		"overwrite_allowed") > 0, "поле доехало и до списка тегов").ЭтоИстина();

	// вызов БЕЗ поля запрет не трогает: правка правила не имеет права снимать защиту
	Без = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной""}", ТокенAlice);
	Ожидаем.Что(Клиент.ТелоJSON(Без).Получить("overwrite_allowed"),
		"поле не прислано — настройка не тронута").ЭтоИстина();

	// а присланная Ложь возвращает запрет: «пусто» и «Ложь» здесь разные ответы
	Русское = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной"",""перезапись_разрешена"":false}", ТокенAlice);
	Ожидаем.Что(Клиент.ТелоJSON(Русское).Получить("overwrite_allowed"),
		"русская пара имён работает и возвращает запрет").ЭтоЛожь();

	// мусор в поле читается как «разрешения нет»: неразобранное значение не имеет права
	// снимать защиту
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.ЗапросJSONСТокеном("PUT", Путь,
		"{""mode"":""ручной"",""overwrite_allowed"":""кажется да""}", ТокенAlice))
			.Получить("overwrite_allowed"),
		"невнятное значение защиту не снимает").ЭтоЛожь();

	// чужой в настройку не лезет
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""mode"":""ручной"",""overwrite_allowed"":true}", ТокенBob).КодСостояния,
		"без права на пакет запрет не снять").Равно(403);
	Ожидаем.Что(ЗапретСнят("alice-pkg", "repush"),
		"и настройка осталась прежней").ЭтоЛожь();

	Клиент.ЗапросJSONСТокеном("DELETE", Путь, "", ТокенAlice);

КонецПроцедуры

// Ветка `Способ <> "session" → Истина` пропускает запрос мимо CSRF и рамок ключа. Недействительный Bearer тоже даёт
// Способ = "" (отката на куку нет) — такой запрос обязан получить 401, и кука с мусорным ключом способ не понижает.
&Тест
Процедура ЭксплойтРевью_ПроходНасквозьНеПропускаетЛичность() Экспорт

	Путь = "/api/v1/pools/public/packages/alice-pkg/tags/passthru";

	Мусорный = Клиент.ЗапросJSONСТокеном("PUT", Путь, "{""version"":""1.0.0""}", "oshub_0_notavalidtoken");
	Ожидаем.Что(Мусорный.КодСостояния,
		"недействительный Bearer → 401, а не проход мутации").Равно(401);

	// кука + мусорный ключ: приоритет у ключа, отката на сессию нет → снова 401
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer oshub_0_notavalidtoken");
	Заголовки.Вставить("Cookie", "oshub_session=" + КукаAlice);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""version"":""1.0.0""}", КодировкаТекста.UTF8);
	Смешанный = Клиент.Соединение().Записать(Запрос);
	Ожидаем.Что(Смешанный.КодСостояния,
		"кука вместе с мусорным ключом не понижает способ до прохода насквозь").Равно(401);

	// и сессия без CSRF по-прежнему отбивается (проход насквозь её не задел)
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Путь, "{""version"":""1.0.0""}", Клиент.ЗаголовкиМутации(КукаAlice, "")).КодСостояния,
		"сессия без CSRF → 403").Равно(403);

	// мутация не состоялась ни в одном случае
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Ожидаем.Что(СтрНайти(Строка(Теги), "passthru"), "тег не создан").Равно(0);

КонецПроцедуры

&Тест
Процедура КлючНеВыпускаетИНеОтзываетКлючи() Экспорт

	// POST /api/v1/tokens требовал лишь аутентификации: read-only PAT выписывал себе ПОЛНЫЙ непривязанный токен —
	// весь энфорсмент обходился одним запросом. КОНТРОЛЬ: тот же человек той же сессией токен выпускает.
	Контроль = ВыпуститьPATСоСкоупом(КукаAlice, "read");
	Ожидаем.Что(ЗначениеЗаполнено(Контроль), "КОНТРОЛЬ: сессией токен выпускается").ЭтоИстина();

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Контроль);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);
	ПоКлючу = Клиент.Соединение().ОтправитьДляОбработки(Запрос);

	Ожидаем.Что(ПоКлючу.КодСостояния,
		"read-only ключ не выписывает себе полный ключ → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Клиент.Тело(ПоКлючу), "token_cannot_manage_tokens") > 0,
		"причина названа кодом").ЭтоИстина();

	// и ПОЛНЫЙ ключ тоже не размножается — запрет по способу, а не по скоупу
	ЗаголовкиП = Новый Соответствие();
	ЗаголовкиП.Вставить("Content-Type", "application/json");
	ЗаголовкиП.Вставить("Authorization", "Bearer " + ТокенAlice);
	ЗапросП = Новый HTTPЗапрос("/api/v1/tokens", ЗаголовкиП);
	ЗапросП.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);
	Ожидаем.Что(Клиент.Соединение().ОтправитьДляОбработки(ЗапросП).КодСостояния,
		"полный ключ тоже не выписывает ключи → 403").Равно(403);

	// список токенов по ключу — тоже нет (иначе ключ перечисляет ключи владельца)
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/tokens", ТокенAlice).КодСостояния,
		"ключ не перечисляет ключи → 403").Равно(403);

КонецПроцедуры

// Тот же выпуск набором пулов прямым обращением к API: клиент называет «пулы», а прежнее
// одиночное «пул» продолжает приниматься — ключи старых клиентов выпускаются как раньше.
&Тест
Процедура ВыпускКлючаAPIПринимаетНаборПуловИПрежнееОдиночноеПоле() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Первый = ЗавестиПриватныйПул();
	Второй = ЗавестиПриватныйПул();

	Набором = ВыпуститьPATТелом(КукаRoot,
		СтрШаблон("{""права"":""read"",""пулы"":[%1,%2]}", Первый.Ид, Второй.Ид));
	Ожидаем.Что(Набором.КодСостояния, "набор пулов принят (" + Клиент.Тело(Набором) + ")").Равно(201);

	Сведения = Клиент.ТелоJSON(Набором).Получить("token_info");
	Ожидаем.Что(Сведения.Получить("pool_ids").Количество(), "оба пула названы в ответе").Равно(2);
	Ожидаем.Что(Формат(Сведения.Получить("pool_id"), "ЧГ=0; ЧН=0"),
		"одиночное поле набором из двух не выражается — прежние клиенты видят ноль").Равно("0");

	// ключ и правда работает в обоих пулах набора и не работает в третьем
	Ключ = Строка(Сведения.Получить("token"));
	Третий = ЗавестиПриватныйПул();
	Перечисление = Клиент.Тело(Клиент.GETСТокеном("/api/v1/pools?pageSize=200", Ключ));
	Ожидаем.Что(СтрНайти(Перечисление, Первый.Имя) > 0, "первый пул набора ключу виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Перечисление, Второй.Имя) > 0, "и второй").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Перечисление, Третий.Имя), "пул вне набора закрыт").Равно(0);

	// одиночное поле прежних клиентов: ответ отдаёт его как раньше И как набор из одного
	Одиночным = ВыпуститьPATТелом(КукаRoot, СтрШаблон("{""права"":""read"",""пул"":%1}", Первый.Ид));
	Ожидаем.Что(Одиночным.КодСостояния, "прежнее поле принимается").Равно(201);
	СведенияОдного = Клиент.ТелоJSON(Одиночным).Получить("token_info");
	Ожидаем.Что(Формат(СведенияОдного.Получить("pool_id"), "ЧГ=0; ЧН=0"),
		"прежнее поле ответа не сломано").Равно(Первый.Ид);
	Ожидаем.Что(СведенияОдного.Получить("pool_ids").Количество(),
		"и оно же видно набором из одного").Равно(1);

	// английское имя поля — то же самое
	ПоАнглийски = ВыпуститьPATТелом(КукаRoot,
		СтрШаблон("{""scopes"":""read"",""pools"":[%1]}", Второй.Ид));
	Ожидаем.Что(ПоАнглийски.КодСостояния, "pools принимается наравне с «пулы»").Равно(201);

КонецПроцедуры

// Одиночное поле и набор живут по разным правилам (одно пишется колонкой записи и уносит
// ключ вместе со своим пулом, другое — строками), поэтому вместе не принимаются: иначе
// удаление пула из одиночного поля снесло бы ключ, у которого рамки набора ещё живы.
&Тест
Процедура ОбаПоляПуловРазомОтвергаютсяСПричиной() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Одиночный = ЗавестиПриватныйПул();
	Наборный = ЗавестиПриватныйПул();

	Смешанный = ВыпуститьPATТелом(КукаRoot, СтрШаблон(
		"{""права"":""read"",""пул"":%1,""пулы"":[%2]}", Одиночный.Ид, Наборный.Ид));

	Ожидаем.Что(Смешанный.КодСостояния, "смешение полей — отказ").Равно(400);
	Ожидаем.Что(КодОшибкиОтвета(Смешанный), "причина названа кодом").Равно("pool_fields_conflict");

	// КОНТРОЛЬ: каждое поле по отдельности принимается — отказ вызван именно смешением
	Ожидаем.Что(ВыпуститьPATТелом(КукаRoot,
		СтрШаблон("{""права"":""read"",""пул"":%1}", Одиночный.Ид)).КодСостояния,
		"КОНТРОЛЬ: одиночное поле в одиночку принимается").Равно(201);
	Ожидаем.Что(ВыпуститьPATТелом(КукаRoot,
		СтрШаблон("{""права"":""read"",""пулы"":[%1]}", Наборный.Ид)).КодСостояния,
		"КОНТРОЛЬ: набор в одиночку принимается").Равно(201);

	// английские имена той же пары запрещены так же
	Ожидаем.Что(КодОшибкиОтвета(ВыпуститьPATТелом(КукаRoot, СтрШаблон(
		"{""scopes"":""read"",""pool"":%1,""pools"":[%2]}", Одиночный.Ид, Наборный.Ид))),
		"pool + pools — тот же отказ").Равно("pool_fields_conflict");

КонецПроцедуры

// Пул, которого смотрящему не видно, при выпуске ключа отвечает ровно как несуществующий:
// иначе перебор идентификаторов рассказывал бы, какие приватные пулы на хабе есть.
&Тест
Процедура НевидимыйПулВНабореКлючаОтвечаетКакНесуществующий() Экспорт

	ЧужойПул = ЗавестиПриватныйПул();
	Ожидаем.Что(Клиент.GETСКукой("/api/v1/pools/" + ЧужойПул.Имя, КукаAlice).КодСостояния,
		"КОНТРОЛЬ: чужой приватный пул алисе не виден вовсе").Равно(404);

	Невидимый = ВыпуститьPATТелом(КукаAlice,
		СтрШаблон("{""права"":""read"",""пулы"":[%1]}", ЧужойПул.Ид));
	Небывалый = ВыпуститьPATТелом(КукаAlice, "{""права"":""read"",""пулы"":[99999999]}");

	Ожидаем.Что(Невидимый.КодСостояния, "невидимый пул — отказ").Равно(400);
	Ожидаем.Что(Небывалый.КодСостояния, "и несуществующий — тот же код").Равно(400);
	Ожидаем.Что(КодОшибкиОтвета(Невидимый), "причина названа кодом").Равно("pool_not_found");
	Ожидаем.Что(КодОшибкиОтвета(Невидимый), "и она совпадает с несуществующим")
		.Равно(КодОшибкиОтвета(Небывалый));
	Ожидаем.Что(СтрНайти(Клиент.Тело(Невидимый), ЧужойПул.Имя),
		"имя чужого пула в ответе не названо").Равно(0);

	// КОНТРОЛЬ: админ хаба тот же набор выпускает — отказ вызван видимостью, а не полем
	Владельцем = ВыпуститьPATТелом(Клиент.Войти("root", "RootPassw0rd"),
		СтрШаблон("{""права"":""read"",""пулы"":[%1]}", ЧужойПул.Ид));
	Ожидаем.Что(Владельцем.КодСостояния,
		"КОНТРОЛЬ: тот же набор, которому пул виден, выпускается").Равно(201);

КонецПроцедуры

// Приватный пул под рамки ключа: заводится ключом админа хаба, как это делает оператор.
// Имя уникально целиком — «pool-1» лежало бы внутри «pool-10», и поиск в выдаче путал бы
// один пул с другим.
Функция ЗавестиПриватныйПул()

	Имя = "scoped-pool-"
		+ Лев(НРег(СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "")), 12);

	Ответ = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""private""}", Имя), ТокенRoot);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Пул под рамки ключа не заведён (%1): %2",
			Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

	Возврат Новый Структура("Имя, Ид", Имя,
		Формат(Клиент.ТелоJSON(Ответ).Получить("pool").Получить("id"), "ЧГ=0; ЧН=0"));

КонецФункции

Функция КодОшибкиОтвета(Знач Ответ)
	Ошибка = Клиент.ТелоJSON(Ответ).Получить("error");
	Возврат ?(Ошибка = Неопределено, "", Строка(Ошибка.Получить("code")));
КонецФункции

// Ключ, выданный API, всегда истекает: пропуск и ноль дают срок хаба по умолчанию,
// а запрос длиннее потолка отбивается кодом ошибки, а не выполняется молча.
&Тест
Процедура СрокКлючаВAPIНеБываетВечным() Экспорт

	БезСрока = ВыпуститьPATТелом(КукаAlice, "{""права"":""read""}");
	СНулём = ВыпуститьPATТелом(КукаAlice, "{""права"":""read"",""срок_дней"":0}");
	СверхПотолка = ВыпуститьPATТелом(КукаAlice, "{""права"":""read"",""срок_дней"":100000}");
	Отрицательный = ВыпуститьPATТелом(КукаAlice, "{""права"":""read"",""срок_дней"":-1}");
	НаПотолке = ВыпуститьPATТелом(КукаAlice, "{""права"":""read"",""expires_in_days"":365}");

	Ожидаем.Что(БезСрока.КодСостояния, "выпуск без поля срока принят").Равно(201);
	Ожидаем.Что(ЧерезСколькоДнейИстекает(БезСрока), "пропуск срока даёт неделю хаба").Равно(7);

	Ожидаем.Что(СНулём.КодСостояния, "ноль в сроке принят").Равно(201);
	Ожидаем.Что(ЧерезСколькоДнейИстекает(СНулём), "ноль больше не значит «вечно»").Равно(7);

	Ожидаем.Что(СверхПотолка.КодСостояния, "срок сверх потолка → 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(СверхПотолка), "token_ttl_too_long") > 0,
		"причина названа кодом (" + Клиент.Тело(СверхПотолка) + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(СверхПотолка), "365") > 0, "потолок назван числом").ЭтоИстина();

	// минус — ошибка клиента, а не «срок не указан»: форма его тоже отвергает
	Ожидаем.Что(Отрицательный.КодСостояния, "отрицательный срок → 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отрицательный), "invalid_expires_in_days") > 0,
		"причина названа кодом (" + Клиент.Тело(Отрицательный) + ")").ЭтоИстина();

	Ожидаем.Что(НаПотолке.КодСостояния, "ровно потолок принят").Равно(201);
	Ожидаем.Что(ЧерезСколькоДнейИстекает(НаПотолке), "expires_in_days читается наравне")
		.Равно(365);

КонецПроцедуры

&Тест
Процедура РамкиКлючаНаМутацияхAPI() Экспорт

	// ветка токена в ПроверитьМутацию возвращала Истину сразу: read-only PAT выполнял любую мутацию API хаба, а ключ,
	// привязанный к пулу X, работал в пуле Y. Куку берём ГОТОВУЮ: присваивание КукаAlice внутри теста попадает в
	// одноимённое ПОЛЕ МОДУЛЯ (мина захвата имён OneScript) и подменяет сессию, к которой привязан CSRFAlice.
	ТолькоЧтение = ВыпуститьPATСоСкоупом(КукаAlice, "read");

	Отказ = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/scoped",
		"{""version"":""1.0.0""}", ТолькоЧтение);
	Ожидаем.Что(Отказ.КодСостояния, "read-only PAT не мутирует API хаба → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "token_scope") > 0, "причина названа кодом").ЭтоИстина();
	// мутация не состоялась
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Ожидаем.Что(СтрНайти(Строка(Теги), "scoped"), "тег read-only ключом не создан").Равно(0);

	// ключ, привязанный к ДРУГОМУ пулу: пул owned существует, но это не пул маршрута
	ИдЧужого = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned", ТокенOwner)).Получить("pool").Получить("id");
	ЧужойПул = ВыпуститьPATСоСкоупом(КукаAlice, "read,write", ИдЧужого);
	ОтказПула = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/bound",
		"{""version"":""1.0.0""}", ЧужойПул);
	Ожидаем.Что(ОтказПула.КодСостояния, "PAT чужого пула не мутирует → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Клиент.Тело(ОтказПула), "token_pool_mismatch") > 0, "причина — привязка").ЭтоИстина();

	// создание пула — уровень ХАБА: привязанному ключу недоступно тем более
	Хабовое = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools", "{""имя"":""boundpool""}", ЧужойПул);
	Ожидаем.Что(Хабовое.КодСостояния, "привязанный ключ не создаёт пулы → 403").Равно(403);

	// штатный путь не сломан: полный непривязанный ключ мутирует
	Норма = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/tags/okscope",
		"{""version"":""1.0.0""}", ТокенAlice);
	Ожидаем.Что(Норма.КодСостояния, "полный PAT мутирует как раньше").Равно(200);

КонецПроцедуры

// Читающая сторона тех же рамок: каталог, поиск и список пулов раньше судили выдачу по
// правам ЧЕЛОВЕКА, а привязка ключа туда не доезжала — узкий ключ перечислял все
// приватные пулы своего владельца и пакеты в них.
&Тест
Процедура РамкиКлючаНаЧтенииКаталогаИПуловAPI() Экспорт

	// owner1 — владелец ДВУХ приватных пулов сидера: owned и secret (пакет secret-pkg)
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ИдOwned = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/owned", ТокенOwner)).Получить("pool").Получить("id");
	КлючOwned = ВыпуститьPATСоСкоупом(КукаOwner, "read", ИдOwned);

	Пулы = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools?pageSize=100", КлючOwned)).Получить("items");
	Ожидаем.Что(СодержитПул(Пулы, "public"), "узкий ключ видит публичный пул").ЭтоИстина();
	Ожидаем.Что(СодержитПул(Пулы, "owned"), "и пул своей привязки").ЭтоИстина();
	Ожидаем.Что(СодержитПул(Пулы, "secret"), "второй приватный пул владельца ключу закрыт").ЭтоЛожь();

	// имя, а не счёт: нечёткий этап поиска поднимает по этому запросу и пакеты пула owned,
	// а они ключу как раз доступны
	Поиск = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/search?q=secret-pkg", КлючOwned));
	Ожидаем.Что(СодержитПакет(Поиск.Получить("items"), "secret-pkg"),
		"и его пакет не всплывает в поиске").ЭтоЛожь();

	Каталог = Клиент.GETСТокеном("/packages?pool=secret", КлючOwned);
	Небывалый = Клиент.GETСТокеном("/packages?pool=nosuchpool-" + Формат(Порт, "ЧГ=0"), КлючOwned);
	Ожидаем.Что(Каталог.КодСостояния, "каталог с отбором по закрытому пулу отвечает как обычно").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Каталог), "secret-pkg"), "имя пакета в разметку не попало").Равно(0);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Каталог), "В этом пуле пока нет пакетов") > 0,
		"закрытый пул неотличим от несуществующего").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Небывалый), "В этом пуле пока нет пакетов") > 0,
		"и несуществующий пул отвечает тем же").ЭтоИстина();

	// КОНТРОЛЬ: тот же человек НЕПРИВЯЗАННЫМ ключом видит secret везде — отказ вызван
	// рамками ключа, а не правами человека
	Полные = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools?pageSize=100", ТокенOwner)).Получить("items");
	ПоискПолным = Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/search?q=secret-pkg", ТокенOwner));
	КаталогПолным = Клиент.GETСТокеном("/packages?pool=secret", ТокенOwner);
	Ожидаем.Что(СодержитПул(Полные, "secret"), "КОНТРОЛЬ: непривязанный ключ владельца видит secret").ЭтоИстина();
	Ожидаем.Что(СодержитПакет(ПоискПолным.Получить("items"), "secret-pkg"),
		"КОНТРОЛЬ: и находит его пакет поиском").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(КаталогПолным), "secret-pkg") > 0,
		"КОНТРОЛЬ: и видит пакет в каталоге с тем же отбором").ЭтоИстина();

КонецПроцедуры

// Карточка названного пула — дверь, а не перечисление: список пулов узкий ключ уже сузил,
// а прямой адрес карточки судил только права ЧЕЛОВЕКА — и перебор имён по адресам отдавал
// метаданные соседнего приватного пула того же владельца.
&Тест
Процедура КарточкаПулаЗакрытаКлючуЧужойПривязки() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	КлючOwned = ВыпуститьPATСоСкоупом(КукаOwner, "read", ИдентификаторПула("owned"));

	Свой = Клиент.GETСТокеном("/api/v1/pools/owned", КлючOwned);
	Ожидаем.Что(Свой.КодСостояния, "карточка пула своей привязки открыта").Равно(200);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/packages", КлючOwned).КодСостояния,
		"и его пакеты").Равно(200);
	// ключ зеркала привязан к пулу источника и читает им срез изменений: узкая привязка
	// закрывает соседей, а не собственный пул
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/changes", КлючOwned).КодСостояния,
		"и срез изменений — тот самый запрос, которым синхронизируется зеркало").Равно(200);

	Соседний = Клиент.GETСТокеном("/api/v1/pools/secret", КлючOwned);
	Небывалый = Клиент.GETСТокеном("/api/v1/pools/" + НебывалоеИмяПула(), КлючOwned);
	Ожидаем.Что(Соседний.КодСостояния, "карточка соседнего приватного пула — 404").Равно(404);
	Ожидаем.Что(КодОшибкиОтвета(Соседний), "и код тот же, что у несуществующего").Равно("pool_not_found");
	Ожидаем.Что(Клиент.Тело(Соседний),
		"тело закрытого пула совпадает с телом несуществующего с точностью до имени в адресе")
		.Равно(СтрЗаменить(Клиент.Тело(Небывалый), НебывалоеИмяПула(), "secret"));

	// КОНТРОЛЬ: тот же человек непривязанным ключом и своей сессией читает secret —
	// отказ вызван рамками ключа, а не правами человека
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/secret", ТокенOwner).КодСостояния,
		"КОНТРОЛЬ: непривязанный ключ владельца читает карточку secret").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/api/v1/pools/secret", КукаOwner).КодСостояния,
		"КОНТРОЛЬ: сессия владельца читает карточку secret").Равно(200);
	Ожидаем.Что(СодержитПакет(Клиент.ТелоJSON(Клиент.GETСКукой("/api/v1/pools/secret/packages", КукаOwner))
		.Получить("items"), "secret-pkg"),
		"КОНТРОЛЬ: и видит сессией всё своё содержимое").ЭтоИстина();

КонецПроцедуры

// Дверь закрыта на всю глубину адреса, а не только на карточке: пакеты, версии, теги,
// README и служебные разделы пула отвечают тем же 404, иначе рамка обходится адресом
// на сегмент длиннее.
&Тест
Процедура МаршрутыГлубжеКарточкиЗакрытыКлючуЧужойПривязки() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	КлючOwned = ВыпуститьPATСоСкоупом(КукаOwner, "read", ИдентификаторПула("owned"));

	Для Каждого Адрес Из АдресаВглубьПулаSecret() Цикл
		Закрытый = Клиент.GETСТокеном(Адрес, КлючOwned);
		Ожидаем.Что(Закрытый.КодСостояния, Адрес + " под ключом чужой привязки — 404").Равно(404);
		Ожидаем.Что(КодОшибкиОтвета(Закрытый), Адрес + ": отказ на двери пула").Равно("pool_not_found");
		Ожидаем.Что(СтрНайти(Клиент.Тело(Закрытый), "secret-pkg"), Адрес + ": имя пакета наружу не ушло").Равно(0);

		// КОНТРОЛЬ: тот же адрес непривязанным ключом того же человека до двери пула
		// не доходит — значит 404 выше даёт привязка ключа, а не права и не сам маршрут
		Ожидаем.Что(КодОшибкиОтвета(Клиент.GETСТокеном(Адрес, ТокенOwner)) <> "pool_not_found",
			"КОНТРОЛЬ: " + Адрес + " непривязанным ключом владельца на двери пула не отбивается").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Публичность пула дверь не открывает: ключ чужой привязки не входит и в неё. Это та самая
// разница форм — перечисление публичное ключом не сужает, названный адрес сужает.
&Тест
Процедура ДверьПубличногоПулаЗакрытаКлючуЧужойПривязкиНоНеАнониму() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	КлючOwned = ВыпуститьPATСоСкоупом(КукаOwner, "read", ИдентификаторПула("owned"));

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public", КлючOwned).КодСостояния,
		"публичный пул чужой привязки — та же дверь").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public/packages", КлючOwned).КодСостояния,
		"и его пакеты тем же адресом").Равно(404);

	Ожидаем.Что(Клиент.GET("/api/v1/pools/public").КодСостояния,
		"аноним читает публичную карточку как раньше").Равно(200);
	Ожидаем.Что(СодержитПакет(Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages")).Получить("items"),
		"alice-pkg"), "и его пакеты").ЭтоИстина();

	// перечисление — другая форма того же вопроса, и публичное она ключом не сужает
	Ожидаем.Что(СодержитПул(Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools?pageSize=100", КлючOwned))
		.Получить("items"), "public"),
		"список пулов публичный пул ключу оставляет").ЭтоИстина();

КонецПроцедуры

// Скоуп чтения спрашивается на тех же дверях: ключ, которым можно только писать,
// метаданных пула не получает.
&Тест
Процедура КлючБезСкоупаЧтенияНеЧитаетКарточкиAPI() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ИдOwned = ИдентификаторПула("owned");
	ТолькоЗапись = ВыпуститьPATСоСкоупом(КукаOwner, "write", ИдOwned);

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned", ТолькоЗапись).КодСостояния,
		"write-only ключ карточку приватного пула не читает").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/packages", ТолькоЗапись).КодСостояния,
		"и его пакеты тоже").Равно(404);

	// КОНТРОЛЬ: тот же человек, тот же пул, ключ отличается одним скоупом
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned",
		ВыпуститьPATСоСкоупом(КукаOwner, "read", ИдOwned)).КодСостояния,
		"КОНТРОЛЬ: ключ со скоупом чтения ту же карточку читает").Равно(200);

КонецПроцедуры

// Публикация через API хаба — та же мутация, но рамки ключа по ней не применялись: ПроверитьМутацию звалась только для
// сессии, а СервисПубликации.Опубликовать — без Принципала. Легаси-push принципал передаёт: энфорсмент зависел от адреса.
&Тест
Процедура ЭксплойтРевью_ReadOnlyКлючПубликуетЧерезAPI() Экспорт

	// КОНТРОЛЬ: тот же человек ПОЛНЫМ ключом публикует — значит отказ вызван рамками ключа, а не правами человека
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Контроль = Публикация("/api/v1/pools/owned/packages/ro-push/versions",
		OspxДанные("ro-push", "1.0.0"), "ro-push-1.0.0.ospx", ТокенOwner);

	ТолькоЧтение = ВыпуститьPATСоСкоупом(КукаOwner, "read");
	Ответ = Публикация("/api/v1/pools/owned/packages/ro-push/versions",
		OspxДанные("ro-push", "1.1.0"), "ro-push-1.1.0.ospx", ТолькоЧтение);

	Ожидаем.Что(Контроль.КодСостояния,
		"КОНТРОЛЬ: полным ключом владелец публикует (иначе тест ничего не доказывает)").Равно(201);
	Ожидаем.Что(Ответ.КодСостояния,
		"read-only PAT не публикует через API хаба (получили " + Ответ.КодСостояния
		+ ", тело: " + Клиент.Тело(Ответ) + ")").Равно(403);

КонецПроцедуры

// Тот же маршрут с ключом, привязанным к ДРУГОМУ пулу: привязка обязана отбить публикацию так же, как теги.
&Тест
Процедура ЭксплойтРевью_КлючЧужогоПулаПубликуетЧерезAPI() Экспорт

	// ключ владельца, привязанный к чужому пулу, публикует в свой: права полные, ограничивать обязана привязка
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ИдPublic = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public")).Получить("pool").Получить("id");
	ЧужойПул = ВыпуститьPATСоСкоупом(КукаOwner, "read,write", ИдPublic);

	Ответ = Публикация("/api/v1/pools/owned/packages/bound-push/versions",
		OspxДанные("bound-push", "1.0.0"), "bound-push-1.0.0.ospx", ЧужойПул);

	Ожидаем.Что(Ответ.КодСостояния,
		"PAT, привязанный к другому пулу, не публикует через API хаба (получили "
		+ Ответ.КодСостояния + ", тело: " + Клиент.Тело(Ответ) + ")").Равно(403);

КонецПроцедуры

&Тест
Процедура КаналПакетаГейт() Экспорт
	База = "/api/v1/pools/public/packages/alice-pkg/channels/band1";
	// alice (автор) определяет канал пакета → 200
	Ок = Клиент.ЗапросJSONСТокеном("PUT", База, "{""тип"":""semver"",""паттерн"":""^1.0""}", ТокенAlice);
	Ожидаем.Что(Ок.КодСостояния, "alice канал пакета → 200").Равно(200);

	// невалидный regex → 422
	Плохо = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/channels/band2",
		"{""тип"":""regex"",""паттерн"":""([""}", ТокенAlice);
	Ожидаем.Что(Плохо.КодСостояния, "невалидный regex → 422").Равно(422);
	ПроверитьФорматОшибки(Плохо, "invalid_channel");

	// легаси-переходник: pin → РУЧНОЙ тег ровно на одной версии (поведение старого клиента), label → 422 —
	// отбирать версии по метке правило тега больше не умеет вообще
	Пин = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/channels/legacy-pin",
		"{""тип"":""pin"",""версия"":""1.0.0""}", ТокенAlice);
	Ожидаем.Что(Пин.КодСостояния, "legacy pin → 200 (ручной тег)").Равно(200);
	Ожидаем.Что(ВерсияТегаИзAPI("legacy-pin"), "ручной тег на указанной версии").Равно("1.0.0");

	Метка = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/channels/legacy-label",
		"{""тип"":""label"",""паттерн"":""dev""}", ТокенAlice);
	Ожидаем.Что(Метка.КодСостояния, "legacy label → 422").Равно(422);
	ПроверитьФорматОшибки(Метка, "invalid_channel");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Метка), "упразднён") > 0,
		"причина названа поимённо, а не «некорректное определение» (Б-6)").ЭтоИстина();
	// и при этом БЕЗ эха пользовательского ввода (прежнее решение МЕЛОЧЬ-3 в силе)
	Ожидаем.Что(СтрНайти(Клиент.Тело(Метка), "dev"), "паттерн в ответе не отражается").Равно(0);

	// чужой bob → 403
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/channels/hack",
		"{""тип"":""semver"",""паттерн"":""^9""}", ТокенBob).КодСостояния, "bob канал чужого → 403").Равно(403);

	Клиент.ЗапросJSONСТокеном("DELETE", "/api/v1/pools/public/packages/alice-pkg/tags/legacy-pin", "", ТокенAlice);
КонецПроцедуры

&Тест
Процедура УровеньКаналаПулаУпразднён() Экспорт

	// уровня «канал по умолчанию пула» больше нет: адрес отвечает 410 Gone ВСЕМ, включая admin и владельца —
	// 404 врал бы «пул не найден» и уводил бы оператора искать проблему в правах
	Тело_ = "{""тип"":""semver"",""паттерн"":""^1.0""}";

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/channels/stable2", Тело_, ТокенRoot).КодСостояния,
		"admin: уровень упразднён → 410").Равно(410);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/owned/channels/mych", Тело_, ТокенOwner).КодСостояния,
		"владелец пула: уровень упразднён → 410").Равно(410);
	Ответ410 = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/channels/stable2", Тело_, ТокенAlice);
	Ожидаем.Что(Ответ410.КодСостояния, "не-owner: тоже 410, а не 403").Равно(410);

	// аноним обязан получить тот же 410: уровень упразднён для всех — не 401 (аутентификация не поможет) и не 404
	Аноним410 = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/channels/anon", Тело_, "");
	Ожидаем.Что(Аноним410.КодСостояния, "аноним: уровень упразднён → 410").Равно(410);
	ПроверитьФорматОшибки(Аноним410, "channels_removed");
	ПроверитьФорматОшибки(Ответ410, "channels_removed");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ410), "tags") > 0, "в сообщении есть путь на теги").ЭтоИстина();

	// канал уровня ПАКЕТА остаётся переходником на тег того же имени
	Пакетный = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/channels/frompkg",
		Тело_, ТокенAlice);
	Ожидаем.Что(Пакетный.КодСостояния, "канал пакета → 200 (создан как тег)").Равно(200);
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Найден = Ложь;
	Для Каждого Тег Из Теги Цикл
		Если Тег.Получить("name") = "frompkg" Тогда
			Найден = Истина;
			Ожидаем.Что(Тег.Получить("mode"), "канал приехал режимом «правило»").Равно("правило");
			Ожидаем.Что(Тег.Получить("rule")).Равно("^1.0");
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Найден, "канал пакета стал тегом").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОпечаткаВРежимеТегаОтклоняется() Экспорт

	// раньше контроллер сравнивал строки сам, и НЕИЗВЕСТНЫЙ режим проваливался в «ручной» (mode=prin → 200);
	// теперь режим разбирает словарь РежимТега (fail-closed)
	База = "/api/v1/pools/public/packages/alice-pkg/tags/";

	Опечатка = Клиент.ЗапросJSONСТокеном("PUT", База + "typo", "{""mode"":""prin"",""version"":""1.1.0""}", ТокенAlice);
	Ожидаем.Что(Опечатка.КодСостояния, "mode=prin → 422, а НЕ 200").Равно(422);
	ПроверитьФорматОшибки(Опечатка, "invalid_mode");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Опечатка), "ручной") > 0, "в ответе перечислены допустимые режимы").ЭтоИстина();

	// тег с опечаткой НЕ создан — отказ произошёл до записи
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Для Каждого Тег Из Теги Цикл
		Ожидаем.Что(Тег.Получить("name") = "typo", "тег с опечаткой не создан").ЭтоЛожь();
	КонецЦикла;

	// оба слова словаря принимаются, значение хранится родное
	Родное = Клиент.ЗапросJSONСТокеном("PUT", База + "mode-ru", "{""mode"":""ручной"",""version"":""1.1.0""}", ТокенAlice);
	Ожидаем.Что(Родное.КодСостояния, "mode=ручной → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Родное).Получить("mode")).Равно("ручной");

	Английское = Клиент.ЗапросJSONСТокеном("PUT", База + "mode-en", "{""mode"":""manual"",""version"":""1.1.0""}", ТокенAlice);
	Ожидаем.Что(Английское.КодСостояния, "mode=manual → 200").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Английское).Получить("mode"), "хранится родное значение").Равно("ручной");

	Клиент.ЗапросJSONСТокеном("DELETE", База + "mode-ru", "", ТокенAlice);
	Клиент.ЗапросJSONСТокеном("DELETE", База + "mode-en", "", ТокенAlice);

КонецПроцедуры

// Режим «пин» упразднён, и отказ называет причину: прежде пин снимался отдельным адресом DELETE .../pin,
// теперь на их месте гарантия, что старый клиент получит внятный 422, а не 200 с молча подвижным тегом.
&Тест
Процедура УпразднённыйПинОтклоняетсяИАдресаОткрепленияНет() Экспорт

	База = "/api/v1/pools/public/packages/alice-pkg/tags/";

	Родное = Клиент.ЗапросJSONСТокеном("PUT", База + "customer-a", "{""mode"":""пин"",""version"":""1.1.0""}", ТокенAlice);
	Ожидаем.Что(Родное.КодСостояния, "mode=пин → 422, а не 200").Равно(422);
	ПроверитьФорматОшибки(Родное, "invalid_mode");
	// причина доезжает до клиента: «422 с прямым указанием причины», а не «неизвестный режим»
	Ожидаем.Что(СтрНайти(Клиент.Тело(Родное), "упразднён") > 0,
		"в ответе названо упразднение, а не «неизвестный режим»").ЭтоИстина();

	Английское = Клиент.ЗапросJSONСТокеном("PUT", База + "customer-b", "{""mode"":""pin"",""version"":""1.1.0""}", ТокенAlice);
	Ожидаем.Что(Английское.КодСостояния, "mode=pin → 422").Равно(422);

	// ТЕГ НЕ СОЗДАН НИ ОДНИМ ИЗ НАПИСАНИЙ: отказ до записи, а не «создали ручным»
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Для Каждого Тег Из Теги Цикл
		Ожидаем.Что(Тег.Получить("name") = "customer-a", "тег из пин-запроса не создан").ЭтоЛожь();
		Ожидаем.Что(Тег.Получить("name") = "customer-b", "тег из pin-запроса не создан").ЭтоЛожь();
	КонецЦикла;

	// адрес открепления отвечает 410, а не удаляет тег: winow — first-match, и без своего маршрута
	// «DELETE .../tags/beta/pin» попал бы в «DELETE .../tags/{tag}» и удалил тег beta
	ДоОткрепления = Клиент.ЗапросJSONСТокеном("PUT", База + "beta", "{""version"":""1.0.0""}", ТокенAlice);
	Ожидаем.Что(ДоОткрепления.КодСостояния, "тег beta заведён").Равно(200);

	Открепление = Клиент.ЗапросJSONСТокеном("DELETE", База + "beta/pin", "", ТокенAlice);
	Ожидаем.Что(Открепление.КодСостояния, "упразднённое открепление → 410").Равно(410);
	ПроверитьФорматОшибки(Открепление, "pin_removed");
	Ожидаем.Что(ВерсияТегаИзAPI("beta"), "тег НЕ удалён запросом открепления").Равно("1.0.0");
	Клиент.ЗапросJSONСТокеном("DELETE", База + "beta", "", ТокенAlice);

	// РУЧНОЙ ТЕГ НА ОДНОЙ ВЕРСИИ — ЗАМЕНА ПИНА: ставится и удаляется без всякой церемонии
	Ручной = Клиент.ЗапросJSONСТокеном("PUT", База + "customer-a", "{""mode"":""ручной"",""version"":""1.1.0""}", ТокенAlice);
	Ожидаем.Что(Ручной.КодСостояния, "ручной тег на одной версии → 200").Равно(200);
	Ожидаем.Что(ВерсияТегаИзAPI("customer-a"), "стоит на своей версии").Равно("1.1.0");
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("DELETE", База + "customer-a", "", ТокенAlice).КодСостояния,
		"удаляется без открепления").Равно(200);

КонецПроцедуры

// Хвост пути не исполняет короткий адрес: winow — first-match, лишние сегменты отбрасываются. Зонд ревьюера нашёл
// четыре живых «двести» на DELETE .../tags/{тег}/<что угодно>, и КАЖДОЕ УДАЛЯЛО ТЕГ.
&Тест
Процедура ХвостПутиНеУдаляетТег() Экспорт

	База = "/api/v1/pools/public/packages/alice-pkg/tags/";

	Хвосты = Новый Массив();
	Хвосты.Добавить("versions");   // забыли /{версия} — самый вероятный промах
	Хвосты.Добавить("unpin");      // выдуманный клиентом глагол
	Хвосты.Добавить("default");    // адрес, которого у нас нет
	Хвосты.Добавить("xyz");        // просто мусор

	Для Каждого Хвост Из Хвосты Цикл

		Создание = Клиент.ЗапросJSONСТокеном("PUT", База + "probe", "{""version"":""1.0.0""}", ТокенAlice);
		Ожидаем.Что(Создание.КодСостояния, "тег-зонд заведён перед хвостом " + Хвост).Равно(200);

		Ответ = Клиент.ЗапросJSONСТокеном("DELETE", База + "probe/" + Хвост, "", ТокенAlice);
		Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("DELETE .../tags/probe/%1 → 404", Хвост)).Равно(404);
		ПроверитьФорматОшибки(Ответ, "unknown_path");

		// ГЛАВНОЕ: тег на месте. Раньше здесь был 200 и удалённый тег.
		Ожидаем.Что(ВерсияТегаИзAPI("probe"),
			СтрШаблон("тег НЕ удалён хвостом /%1", Хвост)).Равно("1.0.0");

		Клиент.ЗапросJSONСТокеном("DELETE", База + "probe", "", ТокенAlice);

	КонецЦикла;

	// PUT с хвостом — тоже 404, а не «создали тег probe»
	СХвостом = Клиент.ЗапросJSONСТокеном("PUT", База + "probe2/whatever", "{""version"":""1.0.0""}", ТокенAlice);
	Ожидаем.Что(СХвостом.КодСостояния, "PUT с хвостом → 404").Равно(404);
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Для Каждого Тег Из Теги Цикл
		Ожидаем.Что(Тег.Получить("name") = "probe2", "тег из запроса с хвостом не создан").ЭтоЛожь();
	КонецЦикла;

	// и хвост у списка тегов тоже не отдаёт список
	Ожидаем.Что(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags/").КодСостояния = 200,
		"чистый адрес списка тегов работает").ЭтоИстина();

КонецПроцедуры

// Канал отдаёт СОСТАВ, а не только выбранную версию; ручной канал набирается по одной версии отдельным адресом.
&Тест
Процедура СоставКаналаВидноИПравитсяПоHTTP() Экспорт

	База = "/api/v1/pools/public/packages/alice-pkg/tags/";

	// правило "*" помечает ВСЕ релизы пакета — вот он, ответ на «что в канале»
	Правило = Клиент.ЗапросJSONСТокеном("PUT", База + "channel-all", "{""mode"":""правило"",""rule"":""*""}", ТокенAlice);
	Ожидаем.Что(Правило.КодСостояния, "тег-правило создан").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Правило).Получить("versions").Количество() > 1,
		"состав канала отдан списком, а не одной версией").ЭтоИстина();

	// ручной канал: две версии, резолв — максимум
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "lts/versions/1.0.0", "", ТокенAlice).КодСостояния,
		"версия добавлена в канал").Равно(200);
	Пополнение = Клиент.ЗапросJSONСТокеном("PUT", База + "lts/versions/1.1.0", "", ТокенAlice);
	Ожидаем.Что(Пополнение.КодСостояния, "вторая версия добавлена").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Пополнение).Получить("versions").Количество(),
		"в ручном канале две версии").Равно(2);
	Ожидаем.Что(ВерсияТегаИзAPI("lts"), "резолв — максимум помеченных").Равно("1.1.0");

	// снятие метки — обратная операция, резолв уезжает вниз
	Снятие = Клиент.ЗапросJSONСТокеном("DELETE", База + "lts/versions/1.1.0", "", ТокенAlice);
	Ожидаем.Что(Снятие.КодСостояния, "метка снята").Равно(200);
	Ожидаем.Что(ВерсияТегаИзAPI("lts"), "канал вернулся на оставшуюся версию").Равно("1.0.0");

	// неизвестная версия и тег-правило — fail-closed, и коды РАЗНЫЕ: нет такой версии — 404, нельзя с этим тегом — 422
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "lts/versions/9.9.9", "", ТокенAlice).КодСостояния,
		"неизвестная версия → 404").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "channel-all/versions/1.0.0", "", ТокенAlice).КодСостояния,
		"ручная метка на тег-правило → 422").Равно(422);

	// чужой канал не правится
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "lts/versions/1.0.0", "", ТокенBob).КодСостояния,
		"bob без прав → 403").Равно(403);

	// причины отказа различимы, а не свалены в один код: клиент по ответу обязан понимать, что чинить
	ПроверитьФорматОшибки(Клиент.ЗапросJSONСТокеном("PUT", База + "lts/versions/9.9.9", "", ТокенAlice), "version_not_found");
	ПроверитьФорматОшибки(Клиент.ЗапросJSONСТокеном("PUT", База + "channel-all/versions/1.0.0", "", ТокенAlice), "tag_is_rule");
	ПроверитьФорматОшибки(Клиент.ЗапросJSONСТокеном("DELETE", База + "no-such-tag/versions/1.0.0", "", ТокенAlice), "tag_not_found");
	ПроверитьФорматОшибки(Клиент.ЗапросJSONСТокеном("PUT", База + "a b/versions/1.0.0", "", ТокенAlice), "invalid_tag");

	// CSRF-гейт нового адреса: по сессии-cookie мутация без X-CSRF-Token обязана отлетать 403
	БезCSRF = Клиент.ЗапросJSON("PUT", База + "lts/versions/1.0.0", "", Клиент.ЗаголовкиМутации(КукаAlice, ""));
	Ожидаем.Что(БезCSRF.КодСостояния, "сессия без CSRF на составе канала → 403").Равно(403);
	СCSRF = Клиент.ЗапросJSON("PUT", База + "lts/versions/1.0.0", "", Клиент.ЗаголовкиМутации(КукаAlice, CSRFAlice));
	Ожидаем.Что(СCSRF.КодСостояния, "сессия + CSRF → 200").Равно(200);

	// уборка: тег-правило "channel-all" мешал бы соседним тестам считать теги пакета
	Клиент.ЗапросJSONСТокеном("DELETE", База + "channel-all", "", ТокенAlice);
	Клиент.ЗапросJSONСТокеном("DELETE", База + "lts", "", ТокенAlice);

КонецПроцедуры

// Отзыв версии метку НЕ снимает: отозванная версия остаётся видна в составе канала, но не отдаётся при установке.
// Карточку пакета строит ДРУГОЙ путь, чем ответ на мутацию тега, — без этого теста обе стороны остались бы зелёными.
&Тест
Процедура ОтозваннаяВерсияВидноВСоставеКаналаНаКарточке() Экспорт

	База = "/api/v1/pools/public/packages/alice-pkg/tags/";

	Правило = Клиент.ЗапросJSONСТокеном("PUT", База + "revoked-vis", "{""mode"":""правило"",""rule"":""*""}", ТокенAlice);
	Ожидаем.Что(Правило.КодСостояния, "тег-правило создан").Равно(200);

	Верс = "/api/v1/pools/public/packages/alice-pkg/versions/1.0.0";
	Отзыв = Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":true}", ТокенAlice);
	Ожидаем.Что(Отзыв.КодСостояния, "версия отозвана").Равно(200);

	Попытка
		Карточка = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg")).Получить("package");
		НайденТег = Ложь;
		Для Каждого Тег Из Карточка.Получить("tags") Цикл
			Если Тег.Получить("name") <> "revoked-vis" Тогда
				Продолжить;
			КонецЕсли;
			НайденТег = Истина;
			Состав = Тег.Получить("versions");
			ЕстьОтозванная = Ложь;
			Для Каждого Версия Из Состав Цикл
				Если Строка(Версия) = "1.0.0" Тогда
					ЕстьОтозванная = Истина;
				КонецЕсли;
			КонецЦикла;
			Ожидаем.Что(ЕстьОтозванная,
				"отозванная версия видна в составе канала на карточке").ЭтоИстина();
		КонецЦикла;
		Ожидаем.Что(НайденТег, "тег найден на карточке").ЭтоИстина();
	Исключение
		Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":false}", ТокенAlice);
		Клиент.ЗапросJSONСТокеном("DELETE", База + "revoked-vis", "", ТокенAlice);
		ВызватьИсключение;
	КонецПопытки;

	Клиент.ЗапросJSONСТокеном("PATCH", Верс, "{""yanked"":false}", ТокенAlice);
	Клиент.ЗапросJSONСТокеном("DELETE", База + "revoked-vis", "", ТокенAlice);

КонецПроцедуры

&Тест
Процедура ПредпросмотрПравилаТребуетПраваНаПакет() Экспорт

	// эндпоинт не пишет, но ИСПОЛНЯЕТ пользовательское выражение по всем версиям пакета: аноним на публичном пуле
	// мог занять поток хаба на минуты (замер: 86 832 мс)
	Путь = "/api/v1/tags/preview";
	Обычное = "{""pool"":""public"",""package"":""alice-pkg"",""rule"":""^1.0"",""type"":""semver""}";

	// аноним → 401
	Аноним = Клиент.ЗапросJSONСТокеном("POST", Путь, Обычное, "");
	Ожидаем.Что(Аноним.КодСостояния, "аноним: предпросмотр → 401").Равно(401);
	ПроверитьФорматОшибки(Аноним, "unauthorized");

	// отказ ДО исполнения выражения: правило заведомо невалидно — гейт после разбора дал бы 422 invalid_rule
	Кривое = "{""pool"":""public"",""package"":""alice-pkg"",""rule"":""(["",""type"":""regex""}";
	ДоКомпиляции = Клиент.ЗапросJSONСТокеном("POST", Путь, Кривое, "");
	Ожидаем.Что(ДоКомпиляции.КодСостояния,
		"аноним с невалидным правилом: 401 (а НЕ 422) — выражение не разбиралось").Равно(401);
	ПроверитьФорматОшибки(ДоКомпиляции, "unauthorized");

	// то же для приватного пула: аноним не узнаёт даже о существовании пакета
	Приватный = "{""pool"":""owned"",""package"":""secretpkg"",""rule"":""^1.0"",""type"":""semver""}";
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("POST", Путь, Приватный, "").КодСостояния,
		"аноним на приватном пуле: 401").Равно(401);

	// аутентифицированный БЕЗ ПРАВА на пакет → 403 (одного чтения пула не хватает)
	Чужой = Клиент.ЗапросJSONСТокеном("POST", Путь, Обычное, ТокенBob);
	Ожидаем.Что(Чужой.КодСостояния, "bob без прав на alice-pkg → 403").Равно(403);

	// порядок и для аутентифицированного: bob с НЕВАЛИДНЫМ правилом обязан получить 403, а не 422 — иначе
	// неправомочный клиент всё равно оплачивает нам вычисление
	ЧужойКривое = Клиент.ЗапросJSONСТокеном("POST", Путь, Кривое, ТокенBob);
	Ожидаем.Что(ЧужойКривое.КодСостояния,
		"bob с невалидным правилом: 403 (а НЕ 422) — правило не исполнялось").Равно(403);

	// владелец пакета → 200 и осмысленный ответ
	Свой = Клиент.ЗапросJSONСТокеном("POST", Путь, Обычное, ТокенAlice);
	Ожидаем.Что(Свой.КодСостояния, "alice: предпросмотр → 200").Равно(200);
	Данные = Клиент.ТелоJSON(Свой);
	Ожидаем.Что(Данные.Получить("version"), "версия-кандидат по правилу ^1.0").Равно("1.1.0");
	Ожидаем.Что(Данные.Получить("matches") <> Неопределено, "список совпадений").ЭтоИстина();

	// злое правило отклоняется и для правомочного клиента — быстро, а не «через минуту»
	Злое = "{""pool"":""public"",""package"":""alice-pkg"",""rule"":""(a+)+$"",""type"":""regex""}";
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОтветЗлое = Клиент.ЗапросJSONСТокеном("POST", Путь, Злое, ТокенAlice);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Ожидаем.Что(ОтветЗлое.КодСостояния, "вложенный квантификатор → 422").Равно(422);
	ПроверитьФорматОшибки(ОтветЗлое, "invalid_rule");
	Ожидаем.Что(Длительность < 5000,
		СтрШаблон("отказ быстрый, поток не занят (%1 мс)", Формат(Длительность, "ЧГ=0"))).ЭтоИстина();

КонецПроцедуры

// Дверь мутаций шире двери чтения ровно на ключ, которому в этом пуле позволено только
// писать: закройся она по скоупу чтения, такой ключ не написал бы и в собственный пул.
&Тест
Процедура ДверьМутацииПропускаетКлючСПравомВСвоёмПуле() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ИдOwned = ИдентификаторПула("owned");
	ТолькоЗапись = ВыпуститьPATСоСкоупом(КукаOwner, "write", ИдOwned);
	ЧтениеИЗапись = ВыпуститьPATСоСкоупом(КукаOwner, "read,write", ИдOwned);

	Для Каждого Адрес Из АдресаМутацийПулаOwned() Цикл
		Запись = Клиент.ЗапросJSONСТокеном("POST", Адрес, "{}", ТолькоЗапись);
		Полный = Клиент.ЗапросJSONСТокеном("POST", Адрес, "{}", ЧтениеИЗапись);

		Ожидаем.Что(КодОшибкиОтвета(Запись) = "pool_not_found", Адрес
			+ ": дверь пула write-only ключ не отбивает (получили " + Запись.КодСостояния
			+ ", тело: " + Клиент.Тело(Запись) + ")").ЭтоЛожь();
		Ожидаем.Что(Запись.КодСостояния, Адрес + ": и до дела он доходит там же, где полный ключ")
			.Равно(Полный.КодСостояния);
		Ожидаем.Что(КодОшибкиОтвета(Запись), Адрес + ": тем же ответом по телу запроса")
			.Равно(КодОшибкиОтвета(Полный));
	КонецЦикла;

КонецПроцедуры

// Рамки ключа мутацию по-прежнему держат — просто отвечает раньше гейт мутаций, которому
// пул назван адресом: ключ чужой привязки до двери пула не доходит вовсе.
&Тест
Процедура ЧужаяПривязкаНеМутируетПулДажеСПолнымиСкоупами() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ЧужаяПривязка = ВыпуститьPATСоСкоупом(КукаOwner, "read,write", ИдентификаторПула("secret"));
	СвояПривязка = ВыпуститьPATСоСкоупом(КукаOwner, "read,write", ИдентификаторПула("owned"));

	Для Каждого Адрес Из АдресаМутацийПулаOwned() Цикл
		Чужой = Клиент.ЗапросJSONСТокеном("POST", Адрес, "{}", ЧужаяПривязка);
		Ожидаем.Что(Чужой.КодСостояния, Адрес + ": ключ, привязанный к другому пулу, не мутирует")
			.Равно(403);
		Ожидаем.Что(КодОшибкиОтвета(Чужой), Адрес + ": и причина названа привязкой")
			.Равно("token_pool_mismatch");

		// КОНТРОЛЬ: тот же человек, те же скоупы, отличается только пул привязки
		Ожидаем.Что(КодОшибкиОтвета(Клиент.ЗапросJSONСТокеном("POST", Адрес, "{}", СвояПривязка)) = "token_pool_mismatch",
			"КОНТРОЛЬ: " + Адрес + " ключом своей привязки на привязку не жалуется").ЭтоЛожь();
	КонецЦикла;

	// Маршрут подписок открывает дверь пула РАНЬШЕ, чем разбирает метод и зовёт гейт
	// мутаций, поэтому здесь чужую привязку закрывает сама дверь — и закрывает её 404,
	// неотличимым от несуществующего пула.
	Подписка = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/webhooks", "{}", ЧужаяПривязка);
	Ожидаем.Что(Подписка.КодСостояния, "на подписках чужую привязку закрывает дверь пула")
		.Равно(404);
	Ожидаем.Что(КодОшибкиОтвета(Подписка), "и отвечает как на несуществующий пул")
		.Равно("pool_not_found");
	Ожидаем.Что(КодОшибкиОтвета(Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/webhooks", "{}", СвояПривязка))
		= "pool_not_found",
		"КОНТРОЛЬ: ключом своей привязки та же дверь на том же адресе открыта").ЭтоЛожь();

КонецПроцедуры

// Скоуп чтения мутацию не открывает: дверь его пропускает, а гейт мутаций — нет.
&Тест
Процедура ЧтениеБезЗаписиМутациюНеОткрывает() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ТолькоЧтение = ВыпуститьPATСоСкоупом(КукаOwner, "read", ИдентификаторПула("owned"));

	Для Каждого Адрес Из АдресаМутацийПулаOwned() Цикл
		Ответ = Клиент.ЗапросJSONСТокеном("POST", Адрес, "{}", ТолькоЧтение);
		Ожидаем.Что(Ответ.КодСостояния, Адрес + ": read-only ключ своего пула не мутирует").Равно(403);
		Ожидаем.Что(КодОшибкиОтвета(Ответ), Адрес + ": и причина названа скоупом").Равно("token_scope");
	КонецЦикла;

КонецПроцедуры

// Мутации пакета живут за той же дверью: тег и версию write-only ключ своего пула правит.
&Тест
Процедура ДверьМутацииПакетаПропускаетКлючТолькоНаЗапись() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	ИдOwned = ИдентификаторПула("owned");
	ТолькоЗапись = ВыпуститьPATСоСкоупом(КукаOwner, "write", ИдOwned);
	ЧтениеИЗапись = ВыпуститьPATСоСкоупом(КукаOwner, "read,write", ИдOwned);

	// пакет для правки: публикуется полным ключом, дальше правится тегом
	Публикация("/api/v1/pools/owned/packages/door-pkg/versions",
		OspxДанные("door-pkg", "1.0.0"), "door-pkg-1.0.0.ospx", ЧтениеИЗапись);

	Тег = "/api/v1/pools/owned/packages/door-pkg/tags/doorband";
	Запись = Клиент.ЗапросJSONСТокеном("PUT", Тег, "{""version"":""1.0.0""}", ТолькоЗапись);
	Ожидаем.Что(Запись.КодСостояния, "write-only ключ своего пула ставит тег пакета (тело: "
		+ Клиент.Тело(Запись) + ")").Равно(200);

	// и подписка пула — маршрут, где дверь открывается до разбора метода
	Подписка = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/owned/webhooks", "{}", ТолькоЗапись);
	Ожидаем.Что(КодОшибкиОтвета(Подписка) = "pool_not_found",
		"дверь пула не отбивает write-only ключ и на подписках (получили "
		+ Подписка.КодСостояния + ", тело: " + Клиент.Тело(Подписка) + ")").ЭтоЛожь();

	// КОНТРОЛЬ: тот же ключ на ЧТЕНИИ тех же сущностей дверь по-прежнему закрывает
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/packages/door-pkg/tags", ТолькоЗапись).КодСостояния,
		"КОНТРОЛЬ: читать теги тем же ключом нельзя — дверь чтения требует скоуп read").Равно(404);
	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/owned/webhooks", ТолькоЗапись).КодСостояния,
		"КОНТРОЛЬ: и список подписок тоже").Равно(404);

КонецПроцедуры

&Тест
Процедура РегистрацияПользователя() Экспорт
	Нов = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/users", "{""логин"":""charlie"",""email"":""c@ex.com"",""пароль"":""CharliePassw0rd""}", "");
	Ожидаем.Что(Нов.КодСостояния, "регистрация нового → 201").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Нов).Получить("user").Получить("login")).Равно("charlie");

	// дубликат логина → 409
	Дубль = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/users", "{""логин"":""alice"",""email"":""a2@ex.com"",""пароль"":""AlicePassw0rd""}", "");
	Ожидаем.Что(Дубль.КодСостояния, "дубликат логина → 409").Равно(409);
	ПроверитьФорматОшибки(Дубль, "user_exists");
КонецПроцедуры

&Тест
Процедура СессияБезCSRF403СCSRFОК() Экспорт
	// мутация по сессии-cookie БЕЗ CSRF → 403 (защита от CSRF при cookie-аутентификации)
	БезТокена = Клиент.ЗапросJSON("PATCH", "/api/v1/pools/public/packages/alice-pkg/versions/1.1.0", "{""yanked"":false}", Клиент.ЗаголовкиМутации(КукаAlice, ""));
	Ожидаем.Что(БезТокена.КодСостояния, "сессия без CSRF → 403").Равно(403);
	ПроверитьФорматОшибки(БезТокена, "csrf_failed");

	// та же мутация С валидным CSRF (заголовок X-CSRF-Token) → 200
	СТокеном = Клиент.ЗапросJSON("PATCH", "/api/v1/pools/public/packages/alice-pkg/versions/1.1.0", "{""yanked"":false}", Клиент.ЗаголовкиМутации(КукаAlice, CSRFAlice));
	Ожидаем.Что(СТокеном.КодСостояния, "сессия + CSRF → 200").Равно(200);
КонецПроцедуры

&Тест
Процедура ФиксированныеСообщенияОшибок() Экспорт

	// невалидное имя пула → 400 invalid_pool с ФИКСИРОВАННЫМ сообщением (не текст исключения)
	ПлохойПул = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools", "{""имя"":""bad name!""}", ТокенRoot);
	Ожидаем.Что(ПлохойПул.КодСостояния, "невалидное имя пула → 400").Равно(400);
	ОшП = Клиент.ТелоJSON(ПлохойПул).Получить("error");
	Ожидаем.Что(ОшП.Получить("code")).Равно("invalid_pool");
	Ожидаем.Что(ОшП.Получить("message"), "фиксированное сообщение invalid_pool").Равно("Некорректные параметры пула (имя/тип/видимость)");

	// невалидный regex канала пакета → 422 invalid_channel с фиксированным сообщением
	ПлохойКанал = Клиент.ЗапросJSONСТокеном("PUT", "/api/v1/pools/public/packages/alice-pkg/channels/badfixed",
		"{""тип"":""regex"",""паттерн"":""([""}", ТокенAlice);
	Ожидаем.Что(ПлохойКанал.КодСостояния, "невалидный regex → 422").Равно(422);
	ОшК = Клиент.ТелоJSON(ПлохойКанал).Получить("error");
	Ожидаем.Что(ОшК.Получить("code")).Равно("invalid_channel");
	Ожидаем.Что(ОшК.Получить("message"), "фиксированное сообщение invalid_channel").Равно("Некорректное определение канала (тип/паттерн/версия)");
	// сообщение НЕ содержит фрагментов исходного regex/исключения
	Ожидаем.Что(СтрНайти(Строка(ОшК.Получить("message")), "(["), "нет эха паттерна исключения").Равно(0);

КонецПроцедуры

#Область ТегиНаЖивомХабе

// Отзыв метку не снимает, но установка по тегу отозванную не берёт: тег уезжает на
// следующую действующую, а когда действующих не осталось — не отдаёт НИЧЕГО, а не
// отдаёт отозванную. Сквозь HTTP, потому что отсев живёт в резолве, а не в списке версий.
&Тест
Процедура ТегОтдаётСтаршуюИзДействующихАИзОднихОтозванныхНеОтдаётНичего() Экспорт

	База = "/api/v1/pools/public/packages/alice-pkg/tags/";
	АдресВерсий = "/api/v1/pools/public/packages/alice-pkg/versions/";
	Резолв = "/api/v1/pools/public/packages/alice-pkg/resolve?spec=recall";

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "recall/versions/1.0.0", "", ТокенAlice).КодСостояния,
		"тег набран первой версией").Равно(200);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "recall/versions/1.1.0", "", ТокенAlice).КодСостояния,
		"и второй").Равно(200);

	Попытка

		Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(Резолв)).Получить("version"),
			"КОНТРОЛЬ: пока обе действуют, тег отдаёт старшую").Равно("1.1.0");

		Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", АдресВерсий + "1.1.0", "{""yanked"":true}", ТокенAlice).КодСостояния,
			"старшая отозвана").Равно(200);

		Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(Резолв)).Получить("version"),
			"установка по тегу берёт старшую среди НЕотозванных").Равно("1.0.0");
		Ожидаем.Что(СоставТега("recall").Найти("1.1.0") <> Неопределено,
			"а из состава тега отозванная не пропала: человеку видно, почему тег её пропустил")
			.ЭтоИстина();

		Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", АдресВерсий + "1.0.0", "{""yanked"":true}", ТокенAlice).КодСостояния,
			"отозваны обе").Равно(200);

		Пусто = Клиент.GET(Резолв);
		Ожидаем.Что(Пусто.КодСостояния, "тег из одних отозванных не резолвится вовсе").Равно(404);
		ПроверитьФорматОшибки(Пусто, "version_not_found");

	Исключение
		ПрибратьЗаТегомОтзыва(База, АдресВерсий);
		ВызватьИсключение;
	КонецПопытки;

	ПрибратьЗаТегомОтзыва(База, АдресВерсий);

КонецПроцедуры

// Отозванную версию хаб сам не выбирает, но названную точно — называет И ПОМЕЧАЕТ:
// без пометки ответ про отозванную неотличим от ответа про действующую, и скачивающий
// узнаёт об отзыве откуда угодно, только не из хаба.
&Тест
Процедура РезолвТочнойОтозваннойНазываетЕёИПомечаетОтзыв() Экспорт

	АдресВерсий = "/api/v1/pools/public/packages/alice-pkg/versions/";
	Резолв = "/api/v1/pools/public/packages/alice-pkg/resolve?spec=1.0.0";

	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(Резолв)).Получить("yanked"),
		"КОНТРОЛЬ: действующая версия помечена не отозванной").ЭтоЛожь();

	Попытка

		Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", АдресВерсий + "1.0.0", "{""yanked"":true}", ТокенAlice).КодСостояния,
			"версия отозвана").Равно(200);

		Отозванная = Клиент.ТелоJSON(Клиент.GET(Резолв));
		Ожидаем.Что(Отозванная.Получить("version"),
			"названную точно хаб называет и после отзыва").Равно("1.0.0");
		Ожидаем.Что(ЗначениеЗаполнено(Отозванная.Получить("url")),
			"адрес файла при этом настоящий: он и правда скачивается").ЭтоИстина();
		Ожидаем.Что(Отозванная.Получить("yanked"), "и помечает её отозванной").ЭтоИстина();

	Исключение
		Клиент.ЗапросJSONСТокеном("PATCH", АдресВерсий + "1.0.0", "{""yanked"":false}", ТокенAlice);
		ВызватьИсключение;
	КонецПопытки;

	Клиент.ЗапросJSONСТокеном("PATCH", АдресВерсий + "1.0.0", "{""yanked"":false}", ТокенAlice);

КонецПроцедуры

// Основной тег у пакета ровно один, ставит его мейнтейнер со своего экрана, и пометка
// ПЕРЕЕЗЖАЕТ, а не копируется. Отвечает на безверсионный запрос именно он — константы
// «stable» в правиле нет.
&Тест
Процедура ПометкаОсновногоПереезжаетИБезверсионныйЗапросИдётЗаНей() Экспорт

	База = "/api/v1/pools/public/packages/alice-pkg/tags/";
	Резолв = "/api/v1/pools/public/packages/alice-pkg/resolve";
	Раздел = "/public/alice-pkg/settings/tags";

	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(Резолв)).Получить("version"),
		"КОНТРОЛЬ: безверсионный запрос отдаёт старшую").Равно("1.1.0");

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "oldline/versions/1.0.0", "", ТокенAlice).КодСостояния,
		"тег на МЛАДШЕЙ версии заведён").Равно(200);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "newline/versions/1.1.0", "", ТокенAlice).КодСостояния,
		"и тег на старшей").Равно(200);
	// stable здесь — обычный тег мейнтейнера, а не умолчание хаба: сам хаб каналов не заводит
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "stable/versions/1.1.0", "", ТокенAlice).КодСостояния,
		"и канал stable на старшей").Равно(200);

	Попытка

		Ответ = ПометитьОсновным(Раздел, "oldline");
		Ожидаем.Что(Ответ.КодСостояния < 400,
			"мейнтейнер помечает тег основным со своего экрана: " + Ответ.КодСостояния).ЭтоИстина();

		Ожидаем.Что(ОсновныеТеги(), "основной у пакета ровно один").Равно("oldline");
		Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(Резолв)).Получить("version"),
			"и безверсионный запрос пошёл за пометкой — вниз, к младшей версии").Равно("1.0.0");
		// stable по-прежнему отдаёт старшую: будь в правиле константа «stable», а не пометка,
		// строкой выше стояла бы 1.1.0
		Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(Резолв + "?spec=stable")).Получить("version"),
			"при этом сам stable указывает на старшую").Равно("1.1.0");

		Ожидаем.Что(ПометитьОсновным(Раздел, "newline").КодСостояния < 400,
			"пометка переносится на другой тег тем же путём").ЭтоИстина();
		Ожидаем.Что(ОсновныеТеги(), "и снова ровно один: она переехала, а не размножилась")
			.Равно("newline");
		Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(Резолв)).Получить("version"), "выдача уехала вместе с ней")
			.Равно("1.1.0");

	Исключение
		ПрибратьЗаТегамиОсновного(База);
		ВызватьИсключение;
	КонецПопытки;

	ПрибратьЗаТегамиОсновного(База);

КонецПроцедуры

// Тег заводится на ПАКЕТЕ: сосед по пулу его не наследует ни в API, ни на своём экране.
// Наследование «по месту жительства» означало бы, что stable у двух пакетов пула — одно
// обещание на двоих.
&Тест
Процедура СоседПоПулуЧужогоТегаНеНаследует() Экспорт

	База = "/api/v1/pools/public/packages/alice-pkg/tags/";
	Сосед = "neighbour-pkg";

	// публикует админ хаба: у alice прав на новое имя в этом пуле нет, и её push ушёл бы
	// во «входящие» заявкой, а не пакетом
	Публикуем = Публикация("/api/v1/pools/public/packages/" + Сосед + "/versions",
		OspxДанные(Сосед, "1.0.0"), Сосед + "-1.0.0.ospx", ТокенRoot);
	Ожидаем.Что(Публикуем.КодСостояния,
		"сосед заведён в том же пуле: " + Клиент.Тело(Публикуем)).Равно(201);

	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PUT", База + "houseline/versions/1.0.0", "", ТокенAlice).КодСостояния,
		"тег заведён у первого пакета").Равно(200);

	Попытка

		Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/resolve?spec=houseline"))
			.Получить("version"), "КОНТРОЛЬ: у своего пакета тег разрешается").Равно("1.0.0");

		Чужой = Клиент.GET("/api/v1/pools/public/packages/" + Сосед + "/resolve?spec=houseline");
		Ожидаем.Что(Чужой.КодСостояния, "у соседа такого тега нет").Равно(404);
		ПроверитьФорматОшибки(Чужой, "tag_not_found");

		СоседниеТеги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/" + Сосед + "/tags")).Получить("tags");
		Ожидаем.Что(ИменаТегов(СоседниеТеги).Найти("houseline"),
			"и в списке тегов соседа он не появился").Равно(Неопределено);

		// оба экрана открывает ОДИН человек: разница между ними — в пакете, а не в правах
		КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
		Свой = Клиент.Тело(Клиент.GETСКукой("/public/alice-pkg/settings/tags", КукаАдмина));
		Ожидаем.Что(СтрНайти(Свой, "houseline") > 0,
			"раздел «Теги» своего пакета тег показывает").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой("/public/" + Сосед + "/settings/tags", КукаАдмина)),
			"houseline"), "а раздел «Теги» соседа — нет").Равно(0);

	Исключение
		Клиент.ЗапросJSONСТокеном("DELETE", База + "houseline", "", ТокенAlice);
		ВызватьИсключение;
	КонецПопытки;

	Клиент.ЗапросJSONСТокеном("DELETE", База + "houseline", "", ТокенAlice);

КонецПроцедуры

#КонецОбласти

#Область Инфраструктура

// Окружение БД/хранилища, ожидание готовности и очистка — в фикстуре ЭкземплярХаба.

Функция OspxДанные(Знач ИмяПакета, Знач Версия)
	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(Каталог);
	Путь = Новый ФикстураПакета().ПостроитьOspx(Каталог, ИмяПакета, Версия, "# " + ИмяПакета);
	Возврат Новый ДвоичныеДанные(Путь);
КонецФункции

#КонецОбласти

#Область HTTPПомощники

// Снят ли с тега пакета запрет повторной публикации — по списку тегов, как его видит клиент.
Функция ЗапретСнят(Знач ИмяПакета, Знач ИмяТега)

	Теги = Клиент.ТелоJSON(Клиент.GET(СтрШаблон("/api/v1/pools/public/packages/%1/tags", ИмяПакета))).Получить("tags");
	Для Каждого Тег Из Теги Цикл
		Если Строка(Тег.Получить("name")) = ИмяТега Тогда
			Возврат Тег.Получить("overwrite_allowed") = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Состав тега (все помеченные версии) по списку тегов API — пустой массив, если тега нет.
Функция СоставТега(Знач ИмяТега)
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Для Каждого Тег Из Теги Цикл
		Если Тег.Получить("name") = ИмяТега Тогда
			Возврат Тег.Получить("versions");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Массив();
КонецФункции

// Имена тегов, помеченных основными, через запятую: пустая строка — основного нет,
// две запятые — их развелось несколько.
Функция ОсновныеТеги()
	Имена = Новый Массив();
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Для Каждого Тег Из Теги Цикл
		Если Тег.Получить("default") = Истина Тогда
			Имена.Добавить(Строка(Тег.Получить("name")));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");
КонецФункции

Функция ИменаТегов(Знач Теги)
	Имена = Новый Массив();
	Для Каждого Тег Из Теги Цикл
		Имена.Добавить(Строка(Тег.Получить("name")));
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Помечает тег основным так, как это делает мейнтейнер: формой раздела «Теги» дома пакета.
Функция ПометитьОсновным(Знач Раздел, Знач ИмяТега)
	Поля = Новый Соответствие();
	Поля.Вставить("операция", "по_умолчанию");
	Поля.Вставить("имя", ИмяТега);
	Поля.Вставить("_csrf", CSRFAlice);
	Возврат Клиент.POSTФормы(Раздел, Поля, КукаAlice);
КонецФункции

Процедура ПрибратьЗаТегомОтзыва(Знач База, Знач АдресаВерсий)
	Клиент.ЗапросJSONСТокеном("PATCH", АдресаВерсий + "1.0.0", "{""yanked"":false}", ТокенAlice);
	Клиент.ЗапросJSONСТокеном("PATCH", АдресаВерсий + "1.1.0", "{""yanked"":false}", ТокенAlice);
	Клиент.ЗапросJSONСТокеном("DELETE", База + "recall", "", ТокенAlice);
КонецПроцедуры

Процедура ПрибратьЗаТегамиОсновного(Знач База)
	Клиент.ЗапросJSONСТокеном("DELETE", База + "oldline", "", ТокенAlice);
	Клиент.ЗапросJSONСТокеном("DELETE", База + "newline", "", ТокенAlice);
	Клиент.ЗапросJSONСТокеном("DELETE", База + "stable", "", ТокенAlice);
КонецПроцедуры

// Версия, на которую указывает тег, по списку тегов API («» — тега нет).
Функция ВерсияТегаИзAPI(Знач ИмяТега)
	Теги = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/alice-pkg/tags")).Получить("tags");
	Для Каждого Тег Из Теги Цикл
		Если Тег.Получить("name") = ИмяТега Тогда
			Возврат Тег.Получить("version");
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Публикация: сырое бинарное тело .ospx + FILE-NAME + Bearer PAT (или аноним).
Функция Публикация(Знач Путь, Знач Данные, Знач ИмяФайла, Знач Токен)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("CHANNEL", "stable");
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

// Моменты выпуска и истечения ключа подписаны зоной, как и всё остальное время в API:
// клиент, считающий срок жизни ключа, не должен угадывать, в какой зоне ему ответили.
// Смотрим СЫРОЕ тело: разбор JSON приводит строку к дате и суффикс теряет.
&Тест
Процедура МоментыТокенаПодписаныЗонойUTC() Экспорт

	Ответ = ВыпуститьPATТелом(КукаAlice, "{""права"":""read"",""срок_дней"":30}");
	Ожидаем.Что(Ответ.КодСостояния, "ключ выпущен").Равно(201);

	Тело = Клиент.Тело(Ответ);
	Выпущен = МоментТокенаИзТела(Тело, "created");
	Истекает = МоментТокенаИзТела(Тело, "expires");

	Ожидаем.Что(СтрЗаканчиваетсяНа(Выпущен, "Z"),
		"момент выпуска подписан зоной: " + Выпущен).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(Истекает, "Z"),
		"и момент истечения тоже: " + Истекает).ЭтоИстина();

КонецПроцедуры

// Значение поля из СЫРОГО тела: суффикс зоны виден только до разбора JSON.
Функция МоментТокенаИзТела(Знач Тело, Знач Поле)

	Начало = СтрНайти(Тело, """" + Поле + """: """);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Тело, Начало + СтрДлина(Поле) + 5);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

// PAT с произвольными скоупами и привязкой к пулу — для проверки рамок ключа (7.A п.3).
Функция ВыпуститьPATСоСкоупом(Знач Кука, Знач Права, Знач ПулИдентификатор = 0)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрШаблон("{""права"":""%1"",""пул"":%2}", Права,
		Формат(ПулИдентификатор, "ЧГ=0; ЧН=0")), КодировкаТекста.UTF8);
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;
	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");
КонецФункции

Функция ВыпуститьPATТелом(Знач Кука, Знач ТелоЗапроса)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

// Через сколько суток истекает выпущенный ключ; -1 — срока в ответе нет вовсе.
// Дату из JSON разбор отдаёт уже датой, поэтому строкой она приходит только пустой.
Функция ЧерезСколькоДнейИстекает(Знач Ответ)

	Значение = Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("expires");
	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Если НЕ ЗначениеЗаполнено(Строка(Значение)) Тогда
			Возврат -1;
		КонецЕсли;
		Значение = XMLЗначение(Тип("Дата"), Строка(Значение));
	КонецЕсли;

	Возврат Цел((Значение - ТекущаяУниверсальнаяДата() + 3600) / 86400);

КонецФункции

Функция ВыпуститьPAT(Знач Кука)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;
	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");
КонецФункции

// Имя пула, которого в хабе заведомо нет: с ним сверяется отказ по закрытому пулу.
Функция НебывалоеИмяПула()
	Возврат "nosuchpool-" + Формат(Порт, "ЧГ=0");
КонецФункции

Функция ИдентификаторПула(Знач Имя)
	Возврат Клиент.ТелоJSON(Клиент.GETСТокеном("/api/v1/pools/" + Имя, ТокенRoot)).Получить("pool").Получить("id");
КонецФункции

// Адреса, где POST меняет сам пул: обе двери мутаций помощника — административная
// (зеркала, апстримы) и обычная (права). Тело намеренно пустое: спор идёт о том, дошёл ли
// запрос до разбора тела, а не о том, что домен на него ответил.
Функция АдресаМутацийПулаOwned()

	Адреса = Новый Массив();
	Адреса.Добавить("/api/v1/pools/owned/mirrors");
	Адреса.Добавить("/api/v1/pools/owned/upstreams");
	Адреса.Добавить("/api/v1/pools/owned/grants");
	Возврат Адреса;

КонецФункции

// Адреса пула secret на всю глубину — по одному на контроллер, который спрашивает дверь
// пула у помощника: пакеты, версии и теги, README, доверенные конвейеры, срез изменений,
// права, входящие заявки, подписки, зеркала и апстримы.
Функция АдресаВглубьПулаSecret()

	Адреса = Новый Массив();
	Адреса.Добавить("/api/v1/pools/secret/packages");
	Адреса.Добавить("/api/v1/pools/secret/packages/secret-pkg");
	Адреса.Добавить("/api/v1/pools/secret/packages/secret-pkg/readme");
	Адреса.Добавить("/api/v1/pools/secret/packages/secret-pkg/versions");
	Адреса.Добавить("/api/v1/pools/secret/packages/secret-pkg/tags");
	Адреса.Добавить("/api/v1/pools/secret/packages/secret-pkg/trusted-workflows");
	Адреса.Добавить("/api/v1/pools/secret/packages/secret-pkg/webhooks");
	Адреса.Добавить("/api/v1/pools/secret/changes");
	Адреса.Добавить("/api/v1/pools/secret/grants");
	Адреса.Добавить("/api/v1/pools/secret/inbox");
	Адреса.Добавить("/api/v1/pools/secret/webhooks");
	Адреса.Добавить("/api/v1/pools/secret/mirrors");
	Адреса.Добавить("/api/v1/pools/secret/upstreams");
	Адреса.Добавить("/api/v1/pools/secret/settings");
	Возврат Адреса;

КонецФункции

// Проверяет единый формат ошибки {error:{code,message}} и ожидаемый код.
Процедура ПроверитьФорматОшибки(Знач Ответ, Знач ОжидаемыйКод)
	Т = Клиент.ТелоJSON(Ответ);
	Ошибка = Т.Получить("error");
	Ожидаем.Что(Ошибка <> Неопределено, "есть объект error").ЭтоИстина();
	Ожидаем.Что(Ошибка.Получить("code"), "код ошибки").Равно(ОжидаемыйКод);
	Ожидаем.Что(ЗначениеЗаполнено(Ошибка.Получить("message")), "сообщение есть").ЭтоИстина();
	// message НЕ содержит внутренностей (стектрейс/путь модуля)
	Ожидаем.Что(СтрНайти(НРег(Строка(Ошибка.Получить("message"))), "модуль"), "нет утечки стектрейса").Равно(0);
КонецПроцедуры

Функция СодержитПакет(Знач Массив, Знач Имя)
	Для Каждого Элемент Из Массив Цикл
		Если Строка(Элемент.Получить("name")) = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// items пула и пакета одной формы: имя лежит в поле name
Функция СодержитПул(Знач Массив, Знач Имя)
	Возврат СодержитПакет(Массив, Имя);
КонецФункции

Функция СодержитВерсию(Знач Массив, Знач Версия)
	Для Каждого Элемент Из Массив Цикл
		Если Строка(Элемент.Получить("version")) = Версия Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти
