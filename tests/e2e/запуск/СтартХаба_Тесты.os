// Живой хаб на текущей раскладке классов: контейнер собирается, а контракты кита перебиты
// реализациями инсталляции.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — запросы к подопытному хабу

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 15);

	// у пустышки кита оформление пустое, и подстановки акцента в разметке не было бы вовсе
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_UI_ACCENT", АкцентИнсталляции());
	Хаб.Поднять("openhub-регистрация", Окружение);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

КонецПроцедуры

&Тест
&Тег("смоук")
Процедура ЖивойХабПоднимаетсяСТекущейРаскладкойКлассов() Экспорт

	Готовность = ДождатьсяГотовности(30);

	Ожидаем.Что(Готовность.Код,
		"GET /ready поднятого хаба: 503 или отказ соединения = контейнер не собрался"
		+ " на текущей раскладке файлов классов. Последний ответ: " + Готовность.Ответ).Равно(200);

КонецПроцедуры

// Страница живого хаба показывает, чья реализация выиграла у контейнера: у пустышек кита
// словарь пуст, оформление пусто, статики нет вовсе.
&Тест
&Тег("смоук")
Процедура КонтрактыКитаПеребитыИнсталляциейНаЖивомХабе() Экспорт

	Ответ = Клиент.GET(СтраницаБезВхода());
	Ожидаем.Что(Ответ.КодСостояния, "страница входа отдана").Равно(200);
	Разметка = Клиент.Тело(Ответ);

	Ожидаем.Что(СтрНайти(Разметка, "[?"),
		"маркер [?ключ] в разметке: СловарьИнтерфейса остался пустышкой кита,"
		+ " и экраны печатают ключи вместо текстов").Равно(0);

	Ожидаем.Что(СтрНайти(Разметка, "--color-accent:" + АкцентИнсталляции()) > 0,
		СтрШаблон("акцент инсталляции %1 не доехал до страницы: ОформлениеИнсталляции"
			+ " осталось пустышкой кита", АкцентИнсталляции())).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Разметка, "/static/openhub-") > 0,
		"адреса таблицы стилей с отпечатком на странице нет: СтатикаИнсталляции"
		+ " осталась пустышкой кита, и хаб отдаёт страницу без оформления").ЭтоИстина();

КонецПроцедуры

#Область Обвязка

// Опрашивает /ready, пока не получит 200 или не выйдет срок: сразу после старта готовность
// законно отвечает 503, пока фоновые стартовые задачи не закрыли свои гейты.
//
// Параметры:
//  ТаймаутСек - Число - предел ожидания готовности.
//
// Возвращаемое значение:
//  Структура - Код (Число, 0 — ни одного ответа), Ответ (Строка) последней попытки.
//
Функция ДождатьсяГотовности(Знач ТаймаутСек)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Код = 0;
	ТелоОтвета = "";

	Пока Истина Цикл

		Попытка
			Ответ = Клиент.GET("/ready");
			Код = Ответ.КодСостояния;
			ТелоОтвета = Клиент.Тело(Ответ);
		Исключение
			Код = 0;
			ТелоОтвета = ОписаниеОшибки();
		КонецПопытки;

		Если Код = 200 ИЛИ ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Прервать;
		КонецЕсли;

		Приостановить(200);

	КонецЦикла;

	Возврат Новый Структура("Код, Ответ", Код, ТелоОтвета);

КонецФункции

// Экран, который отдаётся без сессии и без наполненной базы: форма входа.
Функция СтраницаБезВхода()
	Возврат "/login";
КонецФункции

// Цвет ничей: совпасть с палитрой темы он не может, и в разметке он значит одно — настройку инсталляции.
Функция АкцентИнсталляции()
	Возврат "#123456";
КонецФункции

#КонецОбласти
