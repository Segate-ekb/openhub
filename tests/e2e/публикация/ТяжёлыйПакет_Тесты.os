// Пакет в десятки мегабайт на живом хабе: push проходит и скачивается байт в байт, тело сверх
// предела загрузки получает 413 хаба без следов, временный каталог хаба после запросов пуст.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;                  // фикстура ЭкземплярХаба
Перем Клиент;               // фикстура КлиентХаба
Перем ТаймаутСек;
Перем ТокенАдмина;
Перем КаталогСборки;        // Строка - сборка тяжёлых .ospx и скачанного
Перем КаталогВременныхХаба; // Строка - TMPDIR процесса хаба
Перем СнимокВременных;      // Соответствие - что лежало во временном каталоге хаба после старта

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 60;
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(ТаймаутСек);
	Клиент = Новый КлиентХаба(Хаб, 180);
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-heavy-build");
	КаталогВременныхХаба = УникальныеИмена.ВременныйКаталог("oshub-heavy-tmp");

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_SEED_FIXTURE", ОбъединитьПути(КаталогиПроекта.Фикстуры(), "spike0c-testpkg-0.1.0.ospx"));
	Окружение.Вставить("OSHUB_SEED_POOL", "public");
	Окружение.Вставить("OSHUB_ADMIN_LOGIN", "root");
	Окружение.Вставить("OSHUB_ADMIN_PASSWORD", "RootPassw0rd");
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UPLOAD__BYTES", Формат(ПределЗагрузки(), "ЧГ=0"));
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UNPACKED__BYTES", Формат(4 * ПределЗагрузки(), "ЧГ=0"));
	Хаб.ВыключитьФон();

	// свой временный каталог получает только процесс хаба: набор возвращает прежний сразу
	Прежний = ПолучитьПеременнуюСреды("TMPDIR");
	УстановитьПеременнуюСреды("TMPDIR", КаталогВременныхХаба);
	Попытка
		Хаб.Поднять("oshub-heavy", Окружение, "ЗасеятьПакет.os");
	Исключение
		УстановитьПеременнуюСреды("TMPDIR", Прежний);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПеременнуюСреды("TMPDIR", Прежний);

	ТокенАдмина = Клиент.ВыпуститьPAT(Клиент.ВойтиДождавшись("root", "RootPassw0rd"));
	СнимокВременных = СодержимоеКаталога(КаталогВременныхХаба);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборки);
	УникальныеИмена.УбратьВременное(КаталогВременныхХаба);

КонецПроцедуры

// Больше 30 МБ — выше прежнего предела веб-сервера: push проходит потому, что предел
// сервера следует за пределом загрузки хаба.
&Тест
Процедура ТяжёлыйPushПроходитИСкачиваетсяБайтВБайт() Экспорт

	Пакет = Новый ФикстураПакета().ПостроитьТяжёлыйOspx(НовыйКаталогСборки(), "heavy-pkg", "1.0.0", 40 * 1048576);

	Ответ = Клиент.ОтправитьПакет("public", Пакет, ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "push тяжёлого пакета принят: " + Клиент.Тело(Ответ)).Равно(201);

	Скачанное = ОбъединитьПути(НовыйКаталогСборки(), "скачано.ospx");
	Выдача = Клиент.Соединение().Получить(
		Новый HTTPЗапрос("/api/v1/pools/public/download/heavy-pkg/heavy-pkg-1.0.0.ospx"), Скачанное);

	Ожидаем.Что(Выдача.КодСостояния, "версия отдаётся").Равно(200);
	Ожидаем.Что(Sha256Файла(Скачанное), "скачанное — ровно опубликованные байты").Равно(Sha256Файла(Пакет));
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Выдача, "Content-Length"), "длина — размер файла")
		.Равно(Формат(Новый Файл(Пакет).Размер(), "ЧГ=0"));
	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Выдача, "X-Checksum-Sha256")), "сумма заголовка — сумма байт")
		.Равно(Sha256Файла(Пакет));
	Ожидаем.Что(НовоеВоВременном(), "после приёма и отдачи временный каталог хаба пуст").Равно("");

КонецПроцедуры

// Тело между пределом загрузки и пределом сервера доходит до хаба — и тот отвечает своим 413.
&Тест
Процедура ТелоСверхПределаПолучает413ХабаБезСледов() Экспорт

	Лишнее = ОбъединитьПути(НовыйКаталогСборки(), "over-pkg-1.0.0.ospx");
	ЗаписатьБайты(Лишнее, ПределЗагрузки() + 1048576);

	Ответ = Клиент.ОтправитьПакет("public", Лишнее, ТокенАдмина);

	Ожидаем.Что(Ответ.КодСостояния, "сверх предела → 413 хаба: " + Клиент.Тело(Ответ)).Равно(413);
	Ожидаем.Что(Клиент.Тело(Ответ), "opm печатает предел словами хаба").Содержит("превышает лимит");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Хаб.КореньХранилища(), "pools", "public", "over-pkg")).Существует(),
		"в хранилище пакета нет").ЭтоЛожь();
	Ожидаем.Что(Клиент.GET("/api/v1/pools/public/packages/over-pkg").КодСостояния, "и в реестре нет")
		.Равно(404);
	Ожидаем.Что(НовоеВоВременном(), "временный каталог хаба пуст").Равно("");

КонецПроцедуры

#Область Служебные

// 48 МиБ: выше 30 МБ веб-сервера по умолчанию, предел сервера — 60 МиБ.
Функция ПределЗагрузки()
	Возврат 50331648;
КонецФункции

Функция НовыйКаталогСборки()
	Каталог = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Возврат Каталог;
КонецФункции

Процедура ЗаписатьБайты(Знач Путь, Знач Размер)

	Буфер = Новый БуферДвоичныхДанных(1048576);
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Буфер.Установить(Индекс, Индекс % 251);
	КонецЦикла;

	Файл = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
	Осталось = Размер;
	Пока Осталось > 0 Цикл
		Порция = Мин(Буфер.Размер, Осталось);
		Файл.Записать(Буфер, 0, Порция);
		Осталось = Осталось - Порция;
	КонецЦикла;
	Файл.Закрыть();

КонецПроцедуры

Функция Sha256Файла(Знач Путь)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(Путь);
	Возврат НРег(Хеширование.ХешСуммаСтрокой);
КонецФункции

Функция СодержимоеКаталога(Знач Каталог)
	Имена = Новый Соответствие();
	Для Каждого Найденный Из НайтиФайлы(Каталог, "*", Ложь) Цикл
		Имена.Вставить(Найденный.Имя, Истина);
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Имена, которых не было во временном каталоге хаба после старта, через запятую.
Функция НовоеВоВременном()
	Новые = Новый Массив();
	Для Каждого Имя Из СодержимоеКаталога(КаталогВременныхХаба) Цикл
		Если СнимокВременных.Получить(Имя.Ключ) = Неопределено Тогда
			Новые.Добавить(Имя.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Новые, ", ");
КонецФункции

#КонецОбласти
