// Дерево получателей подписки хаба и пула и дерево пакетов пула в его поправке к подписке хаба
// через API на живом хабе: чтение дерева, замена исключений, отказы на чужих именах, права;
// исключённый узел подписку сверху не видит. Засев кабинета: публичный пул public с пакетом
// alice-pkg и издателем pub, приватные owned и secret (с пакетом secret-pkg) во владении owner1.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу
Перем КаталогСборки;  // временный каталог под .ospx публикаций

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-получатели-ospx");

	Хаб.ФайловаяБаза("openhub-получатели-api");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборки);
КонецПроцедуры

#Область Тесты

&Тест
Процедура ДеревоИИсключенияПодпискиХабаЧитаютсяИЗаменяются() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ид = Подписка(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/api-tree");
	Путь = "/api/v1/webhooks/" + Ид + "/recipients";

	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", Путь, "", Клиент.Кука(КукаRoot)));
	Secret = ПулДерева(Дерево, "secret");
	Ожидаем.Что(Secret, "приватный пул в дереве хаба").Существует();
	Ожидаем.Что(Secret.Получить("private"), "и назван приватным").ЭтоИстина();
	Ожидаем.Что(Secret.Получить("packages")[0].Получить("name"), "его пакет вторым уровнем").Равно("secret-pkg");
	Ожидаем.Что(Дерево.Получить("excluded_pools").Количество(), "исключений пока нет").Равно(0);

	Ответ = Клиент.ЗапросJSON("PUT", Путь, "{""excluded_pools"":[""secret""],""excluded_packages"":[""public/alice-pkg""]}",
		Мутация(КукаRoot, "/hub/settings/webhooks"));
	Ожидаем.Что(Ответ.КодСостояния, "исключения приняты: " + Клиент.Тело(Ответ)).Равно(200);
	Ожидаем.Что(СтрСоединить(Клиент.ТелоJSON(Ответ).Получить("excluded_pools"), ","), "пул исключён").Равно("secret");

	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", Путь, "", Клиент.Кука(КукаRoot)));
	Ожидаем.Что(ПулДерева(Дерево, "secret").Получить("excluded"), "исключение сохранено").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Дерево.Получить("excluded_packages"), ","), "и пакет").Равно("public/alice-pkg");

	Ответ = Клиент.ЗапросJSON("PUT", Путь, "{}", Мутация(КукаRoot, "/hub/settings/webhooks"));
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("excluded_packages").Количество(), "пустое тело вернуло всех")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ПодпискаПулаИсключаетТолькоСвоиПакеты() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Ид = Подписка(КукаOwner, "/api/v1/pools/secret/webhooks", Раздел, "https://hooks.example.com/api-pool-tree");
	Путь = "/api/v1/pools/secret/webhooks/" + Ид + "/recipients";

	Ответ = Клиент.ЗапросJSON("PUT", Путь, "{""excluded_packages"":""secret-pkg""}", Мутация(КукаOwner, Раздел));
	Ожидаем.Что(Ответ.КодСостояния, "пакет своего пула исключён: " + Клиент.Тело(Ответ)).Равно(200);
	Тело = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(Тело.Получить("packages")[0].Получить("excluded"), "пакет помечен").ЭтоИстина();
	Ожидаем.Что(Тело.Получить("pools"), "пулов у подписки пула нет").Равно(Неопределено);

	ЗавестиЧужойПриватныйПул("tree-foreign-private");
	Отказы = Новый Массив();
	Для Каждого ИмяПула Из СтрРазделить("secret,tree-foreign-private,tree-no-such-pool", ",") Цикл
		Ответ = Клиент.ЗапросJSON("PUT", Путь, СтрШаблон("{""excluded_pools"":[""%1""]}", ИмяПула),
			Мутация(КукаOwner, Раздел));
		Отказы.Добавить(Формат(Ответ.КодСостояния, "ЧГ=0") + " " + СтрЗаменить(Клиент.Тело(Ответ), ИмяПула, "*"));
	КонецЦикла;
	Ожидаем.Что(Отказы[0], "пул подписка пула не исключает").Содержит("422");
	Ожидаем.Что(Отказы[1], "чужой приватный пул неотличим от своего").Равно(Отказы[0]);
	Ожидаем.Что(Отказы[2], "и от несуществующего").Равно(Отказы[0]);
	Ответ = Клиент.ЗапросJSON("PUT", Путь, "{""excluded_packages"":[""alice-pkg""]}", Мутация(КукаOwner, Раздел));
	Ожидаем.Что(Ответ.КодСостояния, "пакет чужого пула — отказ").Равно(422);
	Ожидаем.Что(Клиент.Тело(Ответ), "отказ называет имя").Содержит("alice-pkg");

КонецПроцедуры

&Тест
Процедура ДеревоВидитТолькоХозяинПодписки() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = Подписка(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/api-mask",
		Истина);
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	КукаBob = Клиент.Войти("bob", "BobPassw0rd");

	Ожидаем.Что(Код("/api/v1/webhooks/" + Хаба + "/recipients", КукаOwner), "не админ — 403").Равно(403);
	Ожидаем.Что(Код("/api/v1/pools/secret/webhooks/" + Хаба + "/recipients", КукаOwner),
		"подписка хаба под адресом пула — как несуществующая").Равно(404);
	Ожидаем.Что(Код("/api/v1/pools/secret/webhooks/" + Хаба + "/recipients", КукаBob),
		"чужой приватный пул не находится").Равно(404);

	Пакета = Подписка(КукаOwner, "/api/v1/pools/secret/packages/secret-pkg/webhooks",
		"/pools/secret/packages/secret-pkg/settings/webhooks", "https://hooks.example.com/api-package");
	Ожидаем.Что(Код("/api/v1/pools/secret/packages/secret-pkg/webhooks/" + Пакета + "/recipients", КукаOwner),
		"у подписки пакета дерева нет").Равно(404);

КонецПроцедуры

// Исключённый узел подписку хаба в API не видит: ни в списке подписок сверху, ни карточкой, и
// поправку к ней не ставит; соседний пакет того же пула и сам пул её видят, пока пул не исключён.
&Тест
Процедура ИсключённыйХабомУзелНеВидитЕгоПодпискуСверхуВAPI() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = Подписка(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/api-masked",
		Истина);
	Опубликовать("secret", "api-sibling", "1.0.0", Клиент.ВыпуститьPAT(КукаRoot));
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Пул = "/api/v1/pools/secret/inherited-webhooks";
	Пакет = "/api/v1/pools/secret/packages/secret-pkg/inherited-webhooks";
	Сосед = "/api/v1/pools/secret/packages/api-sibling/inherited-webhooks";
	Для Каждого Адрес Из СтрРазделить(Пул + "," + Пакет + "," + Сосед, ",") Цикл
		Ожидаем.Что(Видна(Адрес, Хаба, КукаOwner), "КОНТРОЛЬ: до исключения видна " + Адрес).ЭтоИстина();
	КонецЦикла;

	Исключить(КукаRoot, Хаба, "{""excluded_packages"":[""secret/secret-pkg""]}");
	Ожидаем.Что(Видна(Пакет, Хаба, КукаOwner), "исключённый пакет её не видит").ЭтоЛожь();
	Ожидаем.Что(Код(Пакет + "/" + Хаба, КукаOwner), "карточка исключённому — 404").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Пакет + "/" + Хаба, "{""mute"":true}",
		Мутация(КукаOwner, "/pools/secret/packages/secret-pkg/settings/webhooks")).КодСостояния,
		"поправка исключённого — 404").Равно(404);
	Ожидаем.Что(Видна(Сосед, Хаба, КукаOwner), "соседний пакет того же пула видит").ЭтоИстина();
	Ожидаем.Что(Видна(Пул, Хаба, КукаOwner), "и сам пул").ЭтоИстина();

	Исключить(КукаRoot, Хаба, "{""excluded_pools"":[""secret""],""excluded_packages"":[""secret/secret-pkg""]}");
	Ожидаем.Что(Видна(Пул, Хаба, КукаOwner), "исключённый пул её не видит").ЭтоЛожь();
	Ожидаем.Что(Видна(Сосед, Хаба, КукаOwner), "и его пакеты").ЭтоЛожь();
	Ожидаем.Что(Код(Пул + "/" + Хаба, КукаOwner), "карточка исключённому пулу — 404").Равно(404);

	Исключить(КукаRoot, Хаба, "{""excluded_pools"":[],""excluded_packages"":[]}");
	Ожидаем.Что(Видна(Пакет, Хаба, КукаOwner), "узел вернули — подписка снова видна").ЭтоИстина();

КонецПроцедуры

// Пул исключает свои пакеты из подписки хаба деревом поправки: снятый пакет подписку не видит,
// хозяин подписки видит число снятых, пакет, снятый хозяином, снизу не возвращается, сброс
// поправки снимает и исключения.
&Тест
Процедура ПулИсключаетСвоиПакетыИзПодпискиХабаВAPI() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = Подписка(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/api-amend-tree",
		Истина);
	Опубликовать("secret", "amend-sibling", "1.0.0", Клиент.ВыпуститьPAT(КукаRoot));
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Поправка = "/api/v1/pools/secret/inherited-webhooks/" + Хаба;
	Путь = Поправка + "/recipients";
	Пакет = "/api/v1/pools/secret/packages/secret-pkg/inherited-webhooks";

	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", Путь, "", Клиент.Кука(КукаOwner)));
	Ожидаем.Что(ОтметкиПакетов(Дерево), "пакеты пула включены и открыты")
		.Равно("amend-sibling:+,secret-pkg:+");

	Ответ = Клиент.ЗапросJSON("PUT", Путь, "{""excluded_packages"":[""secret-pkg""]}", Мутация(КукаOwner, Раздел));
	Ожидаем.Что(Ответ.КодСостояния, "пакет снят: " + Клиент.Тело(Ответ)).Равно(200);
	Ожидаем.Что(ОтметкиПакетов(Клиент.ТелоJSON(Ответ)), "снятый отмечен").Равно("amend-sibling:+,secret-pkg:-");
	Ожидаем.Что(Видна(Пакет, Хаба, КукаOwner), "снятый пакет подписку хаба не видит").ЭтоЛожь();
	Ожидаем.Что(Код(Пакет + "/" + Хаба, КукаOwner), "карточка ему — 404").Равно(404);
	Ожидаем.Что(Видна("/api/v1/pools/secret/packages/amend-sibling/inherited-webhooks", Хаба, КукаOwner),
		"соседний пакет видит").ЭтоИстина();

	Ожидаем.Что(СужениеПула(Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", Поправка, "", Клиент.Кука(КукаOwner)))
		.Получить("subscription").Получить("amendment")), "поправка пула с одним снятым пакетом").Равно(1);
	Карточка = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", "/api/v1/webhooks/" + Хаба, "", Клиент.Кука(КукаRoot)));
	Ожидаем.Что(СужениеПула(Карточка.Получить("subscription").Получить("narrowed_by")[0]),
		"хозяин подписки видит число снятых пулом пакетов").Равно(1);

	Исключить(КукаRoot, Хаба, "{""excluded_packages"":[""secret/amend-sibling""]}");
	Ответ = Клиент.ЗапросJSON("PUT", Путь, "{""excluded_packages"":[]}", Мутация(КукаOwner, Раздел));
	Ожидаем.Что(ОтметкиПакетов(Клиент.ТелоJSON(Ответ)), "снятый сверху снизу не вернуть, свой вернулся")
		.Равно("amend-sibling:-закрыт,secret-pkg:+");
	Ожидаем.Что(Видна(Пакет, Хаба, КукаOwner), "вернули — подписка снова видна").ЭтоИстина();

	Клиент.ЗапросJSON("PUT", Путь, "{""excluded_packages"":""secret-pkg""}", Мутация(КукаOwner, Раздел));
	Ответ = Клиент.ЗапросJSON("DELETE", Поправка, "", Мутация(КукаOwner, Раздел));
	Ожидаем.Что(Ответ.КодСостояния, "поправка сброшена: " + Клиент.Тело(Ответ)).Равно(200);
	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", Путь, "", Клиент.Кука(КукаOwner)));
	Ожидаем.Что(ОтметкиПакетов(Дерево), "сброс снял и исключения пула").Равно("amend-sibling:-закрыт,secret-pkg:+");

КонецПроцедуры

// Пакет чужого пула и несуществующий пакет — один исход; у поправки пакета и в теле поправки поле
// пакетов не принимается; без права на пул и для невидимой сверху подписки дерева нет.
&Тест
Процедура ДеревоПоправкиОтказываетОдинаково() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = Подписка(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/api-amend-deny",
		Истина);
	Закрытая = Подписка(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks",
		"https://hooks.example.com/api-amend-closed");
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Путь = "/api/v1/pools/secret/inherited-webhooks/" + Хаба + "/recipients";

	Отказы = Новый Массив();
	Для Каждого Имя Из СтрРазделить("alice-pkg,amend-no-such-pkg", ",") Цикл
		Ответ = Клиент.ЗапросJSON("PUT", Путь, СтрШаблон("{""excluded_packages"":[""%1""]}", Имя),
			Мутация(КукаOwner, Раздел));
		Отказы.Добавить(Формат(Ответ.КодСостояния, "ЧГ=0") + " " + СтрЗаменить(Клиент.Тело(Ответ), Имя, "*"));
	КонецЦикла;
	Ожидаем.Что(Отказы[0], "пакет чужого пула — отказ").Содержит("422");
	Ожидаем.Что(Отказы[1], "несуществующий пакет — тот же отказ").Равно(Отказы[0]);
	Ответ = Клиент.ЗапросJSON("PUT", Путь, "{""excluded_pools"":[""secret""]}", Мутация(КукаOwner, Раздел));
	Ожидаем.Что(Ответ.КодСостояния, "пул в поправке пула не снимается").Равно(422);

	Ответ = Клиент.ЗапросJSON("PUT", "/api/v1/pools/secret/inherited-webhooks/" + Хаба,
		"{""excluded_packages"":[""secret-pkg""]}", Мутация(КукаOwner, Раздел));
	Ожидаем.Что(Ответ.КодСостояния, "в теле поправки пула поле пакетов отклонено").Равно(422);
	Ответ = Клиент.ЗапросJSON("PUT", "/api/v1/pools/secret/packages/secret-pkg/inherited-webhooks/" + Хаба,
		"{""excluded_packages"":[""secret-pkg""]}",
		Мутация(КукаOwner, "/pools/secret/packages/secret-pkg/settings/webhooks"));
	Ожидаем.Что(Ответ.КодСостояния, "у поправки пакета поле отклонено").Равно(422);
	Ожидаем.Что(Клиент.Тело(Ответ), "код отказа поправки").Содержит("invalid_amendment");

	Ожидаем.Что(Код("/api/v1/pools/secret/inherited-webhooks/" + Закрытая + "/recipients", КукаOwner),
		"подписка без разрешения сужать — 404").Равно(404);
	Ожидаем.Что(Код("/api/v1/pools/public/inherited-webhooks/" + Хаба + "/recipients",
		Клиент.Войти("pub", "PubPassw0rd")), "издатель пула без права удаления — 403").Равно(403);
	Ожидаем.Что(Код("/api/v1/pools/secret/inherited-webhooks/" + Хаба + "/recipients",
		Клиент.Войти("bob", "BobPassw0rd")), "посторонний чужой приватный пул не находит").Равно(404);
	Ожидаем.Что(Код(Путь, КукаOwner), "своё дерево — 200").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Пакеты secret-pkg и amend-sibling дерева поправки строкой по имени: «имя:+», снятый — «имя:-»,
// снятый сверху — «имя:-закрыт»; пакеты пула из соседних тестов не входят.
Функция ОтметкиПакетов(Знач Дерево)
	Отметки = Новый Массив();
	Для Каждого Пакет Из Дерево.Получить("packages") Цикл
		Если Пакет.Получить("name") <> "secret-pkg" И Пакет.Получить("name") <> "amend-sibling" Тогда
			Продолжить;
		КонецЕсли;
		Отметки.Добавить(Пакет.Получить("name") + ":" + ?(Пакет.Получить("excluded"), "-", "+")
			+ ?(Пакет.Получить("excluded_above"), "закрыт", ""));
	КонецЦикла;
	Возврат СтрСоединить(Отметки, ",");
КонецФункции

// Сколько пакетов снял пул в поправке; поправки нет — минус один.
Функция СужениеПула(Знач Поправка)
	Если Поправка = Неопределено Тогда
		Возврат -1;
	КонецЕсли;
	Возврат Поправка.Получить("excluded_package_count");
КонецФункции


Функция Подписка(Знач Кука, Знач Путь, Знач Раздел, Знач Адрес, Знач Сужаемая = Ложь)

	Тело = СтрШаблон("{""kind"":""вебхук"",""URL"":""%1"",""events"":[""версия.опубликована""]%2}",
		Адрес, ?(Сужаемая, ",""narrowing_allowed"":true", ""));
	Ответ = Клиент.ЗапросJSON("POST", Путь, Тело, Мутация(Кука, Раздел));
	Ожидаем.Что(Ответ.КодСостояния, "подписка заведена: " + Клиент.Тело(Ответ)).Равно(201);
	Возврат Формат(Клиент.ТелоJSON(Ответ).Получить("subscription").Получить("id"), "ЧГ=0");

КонецФункции

// Видна ли подписка в списке подписок сверху по адресу.
Функция Видна(Знач Адрес, Знач Ид, Знач Кука)
	Ответ = Клиент.ЗапросJSON("GET", Адрес, "", Клиент.Кука(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "список " + Адрес).Равно(200);
	Для Каждого Подписка Из Клиент.ТелоJSON(Ответ).Получить("items") Цикл
		Если Формат(Подписка.Получить("id"), "ЧГ=0") = Ид Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура Исключить(Знач КукаRoot, Знач Хаба, Знач Тело)
	Ответ = Клиент.ЗапросJSON("PUT", "/api/v1/webhooks/" + Хаба + "/recipients", Тело,
		Мутация(КукаRoot, "/hub/settings/webhooks"));
	Ожидаем.Что(Ответ.КодСостояния, "исключения заменены: " + Клиент.Тело(Ответ)).Равно(200);
КонецПроцедуры

Процедура Опубликовать(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Токен)
	Ответ = Клиент.ОтправитьАртефакт(СтрШаблон("/api/v1/pools/%1/push", ИмяПула),
		Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия),
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), Токен);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("%1 %2 опубликован: %3", ИмяПакета, Версия, Клиент.Тело(Ответ)))
		.Равно(201);
КонецПроцедуры

// Приватный пул root, которого owner1 не видит.
Процедура ЗавестиЧужойПриватныйПул(Знач Имя)
	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""private""}", Имя), Мутация(КукаRoot, "/hub/settings/webhooks"));
	Ожидаем.Что(Ответ.КодСостояния, "чужой приватный пул заведён: " + Клиент.Тело(Ответ)).Равно(201);
КонецПроцедуры

// Заголовки мутации сессией: CSRF — со страницы раздела, которую пользователь вправе открыть.
Функция Мутация(Знач Кука, Знач Раздел)
	Возврат Клиент.ЗаголовкиМутации(Кука, Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, Кука))));
КонецФункции

Функция Код(Знач Путь, Знач Кука)
	Возврат Клиент.ЗапросJSON("GET", Путь, "", Клиент.Кука(Кука)).КодСостояния;
КонецФункции

Функция ПулДерева(Знач Дерево, Знач Имя)
	Для Каждого Пул Из Дерево.Получить("pools") Цикл
		Если Пул.Получить("name") = Имя Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
