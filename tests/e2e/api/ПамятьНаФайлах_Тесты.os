// Память хаба на файлах: приём и отдача пакета в 40 МБ не поднимают его в память процесса —
// пик RSS хаба по ходу передачи выше исходного меньше чем на половину размера пакета.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;            // фикстура ЭкземплярХаба
Перем Клиент;         // фикстура КлиентХаба
Перем ТаймаутСек;
Перем ТокенАдмина;
Перем КаталогСборки;  // Строка - сборка .ospx и скачанного

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 60;
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(ТаймаутСек);
	Клиент = Новый КлиентХаба(Хаб, 180);
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-rss-build");

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_SEED_FIXTURE", ОбъединитьПути(КаталогиПроекта.Фикстуры(), "spike0c-testpkg-0.1.0.ospx"));
	Окружение.Вставить("OSHUB_SEED_POOL", "public");
	Окружение.Вставить("OSHUB_ADMIN_LOGIN", "root");
	Окружение.Вставить("OSHUB_ADMIN_PASSWORD", "RootPassw0rd");
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UPLOAD__BYTES", "67108864");
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UNPACKED__BYTES", "268435456");
	Хаб.ВыключитьФон();
	Хаб.Поднять("oshub-rss", Окружение, "ЗасеятьПакет.os");

	ТокенАдмина = Клиент.ВыпуститьPAT(Клиент.ВойтиДождавшись("root", "RootPassw0rd"));

	// разогрев: первые приём и отдача грузят код разбора и выдачи, а не байты пакета
	ОпубликоватьИСкачать("warm-pkg", 1048576);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборки);
КонецПроцедуры

&Тест
Процедура ПриёмИОтдачаПакетаНеПоднимаютЕгоВПамять() Экспорт

	Размер = 40 * 1048576;
	Пакет = Новый ФикстураПакета().ПостроитьТяжёлыйOspx(НовыйКаталогСборки(), "rss-pkg", "1.0.0", Размер);

	ДоПриёма = ПамятьХаба();
	Замер = НачатьЗамерПика();
	Клиент.Опубликовать("public", Пакет, ТокенАдмина);
	Приём = ИтогЗамера(Замер);

	ДоОтдачи = ПамятьХаба();
	Замер = НачатьЗамерПика();
	Скачанное = Скачать("rss-pkg", "rss-pkg-1.0.0.ospx");
	Отдача = ИтогЗамера(Замер);

	Ожидаем.Что(Новый Файл(Скачанное).Размер(), "самотест: отдан весь пакет").Равно(Новый Файл(Пакет).Размер());
	Ожидаем.Что(Приём.Опросов, "самотест: RSS опрошен по ходу приёма").БольшеИлиРавно(3);
	Ожидаем.Что(Отдача.Опросов, "самотест: RSS опрошен по ходу отдачи").БольшеИлиРавно(3);
	Ожидаем.Что(Приём.Пик - ДоПриёма < Размер / 2,
		СтрШаблон("приём: RSS хаба %1, пик %2 байт за %3 опросов", ДоПриёма, Приём.Пик, Приём.Опросов)).ЭтоИстина();
	Ожидаем.Что(Отдача.Пик - ДоОтдачи < Размер / 2,
		СтрШаблон("отдача: RSS хаба %1, пик %2 байт за %3 опросов", ДоОтдачи, Отдача.Пик, Отдача.Опросов)).ЭтоИстина();

КонецПроцедуры

#Область Служебные

Процедура ОпубликоватьИСкачать(Знач ИмяПакета, Знач Размер)
	Пакет = Новый ФикстураПакета().ПостроитьТяжёлыйOspx(НовыйКаталогСборки(), ИмяПакета, "1.0.0", Размер);
	Клиент.Опубликовать("public", Пакет, ТокенАдмина);
	Скачать(ИмяПакета, ИмяПакета + "-1.0.0.ospx");
КонецПроцедуры

Функция Скачать(Знач ИмяПакета, Знач ИмяФайла)
	Скачанное = ОбъединитьПути(НовыйКаталогСборки(), ИмяФайла);
	Ответ = Клиент.Соединение().Получить(
		Новый HTTPЗапрос(СтрШаблон("/api/v1/pools/public/download/%1/%2", ИмяПакета, ИмяФайла)), Скачанное);
	Ожидаем.Что(Ответ.КодСостояния, "версия отдаётся").Равно(200);
	Возврат Скачанное;
КонецФункции

// Resident set процесса хаба, байты: ps есть и на macOS, и на Linux раннера.
Функция ПамятьХаба()

	Процесс_ = СоздатьПроцесс(СтрШаблон("ps -o rss= -p %1", Формат(Хаб.ИдентификаторПроцесса(), "ЧГ=0")),
		, Истина);
	Процесс_.Запустить();
	Процесс_.ОжидатьЗавершения();
	Вывод = СокрЛП(Процесс_.ПотокВывода.Прочитать());
	Ожидаем.Что(Вывод, "ps назвал RSS хаба").Заполнено();
	Возврат Число(Вывод) * 1024;

КонецФункции

// Опрос ps без пауз в отдельном sh до файла-стопа; первый опрос снят до возврата.
Функция НачатьЗамерПика()

	Каталог = НовыйКаталогСборки();
	Замер = Новый Структура("Итог, Стоп, Процесс",
		ОбъединитьПути(Каталог, "peak"), ОбъединитьПути(Каталог, "stop"));
	Скрипт = ОбъединитьПути(Каталог, "peak.sh");

	Запись = Новый ЗаписьТекста(Скрипт, КодировкаТекста.UTF8NoBOM, , , Символы.ПС);
	Запись.ЗаписатьСтроку("max=0; n=0");
	Запись.ЗаписатьСтроку("while :; do");
	Запись.ЗаписатьСтроку("  r=$(ps -o rss= -p ""$1"" | tr -d ' ')");
	Запись.ЗаписатьСтроку("  [ -z ""$r"" ] && break");
	Запись.ЗаписатьСтроку("  n=$((n + 1)); [ ""$r"" -gt ""$max"" ] && max=$r");
	Запись.ЗаписатьСтроку("  echo ""$max $n"" > ""$2.part"" && mv ""$2.part"" ""$2""");
	Запись.ЗаписатьСтроку("  [ -e ""$3"" ] && break");
	Запись.ЗаписатьСтроку("done");
	Запись.Закрыть();

	Замер.Процесс = СоздатьПроцесс(СтрШаблон("sh %1 %2 %3 %4", Скрипт,
		Формат(Хаб.ИдентификаторПроцесса(), "ЧГ=0"), Замер.Итог, Замер.Стоп), , Истина);
	Замер.Процесс.Запустить();

	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока НЕ Новый Файл(Замер.Итог).Существует() И ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
		Приостановить(20);
	КонецЦикла;
	Ожидаем.Что(Новый Файл(Замер.Итог).Существует(), "самотест: опрос RSS запущен").ЭтоИстина();
	Возврат Замер;

КонецФункции

// Пик RSS в байтах и число опросов за время замера.
Функция ИтогЗамера(Знач Замер)

	Запись = Новый ЗаписьТекста(Замер.Стоп);
	Запись.Закрыть();
	Замер.Процесс.ОжидатьЗавершения();

	Чтение = Новый ЧтениеТекста(Замер.Итог);
	Части = СтрРазделить(СокрЛП(Чтение.Прочитать()), " ");
	Чтение.Закрыть();
	Возврат Новый Структура("Пик, Опросов", Число(Части[0]) * 1024, Число(Части[1]));

КонецФункции

Функция НовыйКаталогСборки()
	Каталог = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Возврат Каталог;
КонецФункции

#КонецОбласти
