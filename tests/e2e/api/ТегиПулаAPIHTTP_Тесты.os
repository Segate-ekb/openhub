// Теги пула через API на живом хабе: галка pool_tags в настройках пула, набор пула
// под /pools/{pool}/tags, теги пакета с происхождением и выключенными, выключение тега пула
// у пакета, копия правкой тега пула и отказы. Засев кабинета: пул public с alice-pkg 1.0.0
// и 1.1.0, root — администратор хаба.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу
Перем Кука;     // сессия root
Перем Мутация;  // заголовки мутации root: кука и CSRF

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);

	Хаб.ФайловаяБаза("openhub-теги-пула-api");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры",
		"ЗасеятьКабинет.os"));

	Хаб.Запустить();

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Мутация = Клиент.ЗаголовкиМутации(Кука,
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/tokens", Кука))));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Тесты

// Галка pool_tags включается настройками пула и видна в них; первое включение заводит набор,
// тег пула заводится и правится PUT, пакет отдаёт его сразу и называет происхождением «пул».
&Тест
Процедура НаборПулаЧерезAPIДоезжаетДоПакета() Экспорт

	Настройки = Запрос("PATCH", "/api/v1/pools/public/settings", "{""pool_tags"":true}");
	Ожидаем.Что(Настройки.КодСостояния, "галка включена").Равно(200);
	Ожидаем.Что(ТелоJSON(Настройки).Получить("settings").Получить("pool_tags"), "и видна").ЭтоИстина();

	Набор = ТелоJSON(Запрос("GET", "/api/v1/pools/public/tags"));
	Ожидаем.Что(Набор.Получить("enabled"), "набор включён").ЭтоИстина();
	Ожидаем.Что(ИменаТегов(Набор), "первое включение — три канала").Равно("develop,prerelease,stable");

	Сохранён = Запрос("PUT", "/api/v1/pools/public/tags/lts", "{""rule"":""^1.0"",""overwrite_allowed"":true}");
	Ожидаем.Что(Сохранён.КодСостояния, "тег пула заведён").Равно(200);
	Ожидаем.Что(ТелоJSON(Сохранён).Получить("overwrite_allowed"), "с разрешённой перезаписью").ЭтоИстина();

	Ожидаем.Что(Резолв("alice-pkg", "lts"), "пакет отдаёт тег пула сразу").Равно("1.1.0");
	ТегиПакета = ТелоJSON(Запрос("GET", "/api/v1/pools/public/packages/alice-pkg/tags"));
	Ожидаем.Что(Происхождение(ТегиПакета, "lts"), "происхождение — пул").Равно("пул");

КонецПроцедуры

// Выключенный у пакета тег пула пропадает из тегов пакета и резолва, остаётся в перечне
// выключенных; удалить унаследованный тег нельзя — отказ называет выключение; правка тега пула
// у пакета заводит копию, перекрывающую тег пула.
&Тест
Процедура ВыключениеИКопияУПакетаЧерезAPI() Экспорт

	Запрос("PATCH", "/api/v1/pools/public/settings", "{""pool_tags"":true}");
	Пакет = "/api/v1/pools/public/packages/alice-pkg";

	Ожидаем.Что(Запрос("PUT", Пакет + "/tags/develop/disabled").КодСостояния, "выключен").Равно(200);
	ТегиПакета = ТелоJSON(Запрос("GET", Пакет + "/tags"));
	Ожидаем.Что(Происхождение(ТегиПакета, "develop"), "в тегах пакета его нет").Равно("");
	Ожидаем.Что(СтрСоединить(ТегиПакета.Получить("disabled"), ","), "он в выключенных").Равно("develop");
	Ожидаем.Что(Резолв("alice-pkg", "develop"), "и не резолвится").Равно("404");
	Ожидаем.Что(Запрос("DELETE", Пакет + "/tags/develop/disabled").КодСостояния, "возвращён").Равно(200);
	Ожидаем.Что(Запрос("DELETE", Пакет + "/tags/develop/disabled").КодСостояния,
		"не выключенный не возвращается").Равно(404);

	Удаление = Запрос("DELETE", Пакет + "/tags/prerelease");
	Ожидаем.Что(Удаление.КодСостояния, "унаследованный тег не удаляется").Равно(422);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Удаление), "tag_inherited") > 0, "код отказа свой").ЭтоИстина();

	Копия = Запрос("PUT", Пакет + "/tags/prerelease", "{""rule"":""~1.0.0"",""mode"":""правило""}");
	Ожидаем.Что(Копия.КодСостояния, "копия заведена").Равно(200);
	Ожидаем.Что(ТелоJSON(Копия).Получить("origin"), "копия перекрывает пул").Равно("перекрывает");
	Ожидаем.Что(Резолв("alice-pkg", "prerelease"), "резолв по копии").Равно("1.0.0");
	Ожидаем.Что(Запрос("DELETE", Пакет + "/tags/prerelease").КодСостояния, "копия снята").Равно(200);
	Ожидаем.Что(Резолв("alice-pkg", "prerelease"), "вернулся тег пула").Равно("1.1.0");

КонецПроцедуры

// Отказы двери тегов пула: имя версии пакета пула, ручной режим, тег, которого нет; галка
// выключена — пакеты не наследуют, набор хранится.
&Тест
Процедура ОтказыИВыключениеГалкиЧерезAPI() Экспорт

	Запрос("PATCH", "/api/v1/pools/public/settings", "{""pool_tags"":true}");

	ИмяВерсии = Запрос("PUT", "/api/v1/pools/public/tags/1.1.0", "{""rule"":""*""}");
	Ожидаем.Что(ИмяВерсии.КодСостояния, "имя версии пакета пула").Равно(422);
	Ожидаем.Что(СтрНайти(Клиент.Тело(ИмяВерсии), "tag_name_is_version") > 0, "со своим кодом").ЭтоИстина();
	Ожидаем.Что(Запрос("PUT", "/api/v1/pools/public/tags/pin", "{""mode"":""ручной""}").КодСостояния,
		"ручного тега у пула нет").Равно(422);
	Ожидаем.Что(Запрос("DELETE", "/api/v1/pools/public/tags/nosuch").КодСостояния, "нет такого").Равно(404);

	Ожидаем.Что(Запрос("PATCH", "/api/v1/pools/public/settings", "{""pool_tags"":false}").КодСостояния,
		"галка выключена").Равно(200);
	Ожидаем.Что(Резолв("alice-pkg", "stable"), "пакет тег пула не наследует").Равно("404");
	Набор = ТелоJSON(Запрос("GET", "/api/v1/pools/public/tags"));
	Ожидаем.Что(Набор.Получить("enabled"), "галка снята").ЭтоЛожь();
	Ожидаем.Что(Набор.Получить("tags").Количество() >= 3, "набор хранится").ЭтоИстина();

	Запрос("PATCH", "/api/v1/pools/public/settings", "{""pool_tags"":true}");
	Ожидаем.Что(Резолв("alice-pkg", "stable"), "галка вернула наследование").Равно("1.1.0");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Запрос(Знач Метод, Знач Путь, Знач Тело = "")
	Возврат Клиент.ЗапросJSON(Метод, Путь, Тело, Мутация);
КонецФункции

Функция ТелоJSON(Знач Ответ)
	Возврат Клиент.ТелоJSON(Ответ);
КонецФункции

// Версия, которую отдаёт спецификация, строкой; код ответа строкой — если версии нет.
Функция Резолв(Знач ИмяПакета, Знач Спецификация)

	Ответ = Запрос("GET", СтрШаблон("/api/v1/pools/public/packages/%1/resolve?spec=%2",
		ИмяПакета, Спецификация));
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Формат(Ответ.КодСостояния, "ЧГ=0");
	КонецЕсли;
	Возврат Строка(ТелоJSON(Ответ).Получить("version"));

КонецФункции

Функция ИменаТегов(Знач Набор)

	Список = Новый СписокЗначений();
	Для Каждого Тег Из Набор.Получить("tags") Цикл
		Если Тег.Получить("name") <> "lts" Тогда
			Список.Добавить(Тег.Получить("name"));
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), ",");

КонецФункции

// Происхождение тега пакета; "" — такого тега у пакета нет.
Функция Происхождение(Знач ТегиПакета, Знач ИмяТега)

	Для Каждого Тег Из ТегиПакета.Получить("tags") Цикл
		Если Тег.Получить("name") = ИмяТега Тогда
			Возврат Тег.Получить("origin");
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти
