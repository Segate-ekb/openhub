// Схемы описания API против живого хаба: сценарий вызывает каждую операцию документа /v3/api-docs,
// и каждый ответ сверяется со схемой своего кода — поля, их типы, обязательность и null.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;           // фикстура ЭкземплярХаба
Перем Клиент;        // фикстура КлиентХаба
Перем Док;           // Соответствие — разобранный /v3/api-docs
Перем Сверка;        // фикстура СверкаПоСхемеOpenAPI — со схемами документа
Перем Вызванные;     // Соответствие — «глагол адрес» → Соответствие кодов, которыми операция ответила
Перем Расхождения;   // Массив из Строка — ответы, разошедшиеся со схемой
Перем КореньДанных;  // Строка — каталог данных хаба, в нём собираются .ospx
Перем Кука;          // Строка — сессия администратора
Перем Ключ;          // Строка — ключ администратора
Перем КукаГостя;     // Строка — сессия зарегистрированного пользователя без прав
Перем КлючГостя;     // Строка — его ключ
Перем СхемыГлаголов; // Соответствие — «ГЛАГОЛ адрес код» → схема ответа этого глагола

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПройтиСценарий() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("СверкаПоСхемеOpenAPI");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);

	КореньДанных = Хаб.ФайловаяБаза("openhub-schemas");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "schemas-admin");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.ВыключитьДоставкуВебхуков();

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	Ответ = Клиент.GET("/v3/api-docs");
	Ожидаем.Что(Ответ.КодСостояния, "описание API отдаётся").Равно(200);
	Док = Клиент.ТелоJSON(Ответ);
	Сверка = Новый СверкаПоСхемеOpenAPI(Док.Получить("components").Получить("schemas"));
	СхемыГлаголов = СхемыГлаголовАдресов();

	Вызванные = Новый Соответствие();
	Расхождения = Новый Массив();

	Кука = Клиент.Войти("schemas-admin", ПарольАдмина());
	Ключ = Клиент.ВыпуститьPAT(Кука);

	Учётки();
	Пулы();
	Пакеты();
	Теги();
	Заявки();
	Подписки();
	Доступ();
	Источники();
	СостояниеИНастройкиХаба();
	ВходСУстройства();
	УдалениеПула();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Тесты

// Каждый ответ с телом объявлен схемой: JSON — схемой из components или простого типа, текст — типом
// содержимого. Новая операция без схемы — красный.
&Тест
Процедура КаждыйОтветОперацииОписанСхемой() Экспорт

	Непокрытые = Новый Массив();
	Для Каждого Пункт Из Док.Получить("paths") Цикл
		Для Каждого Операция Из Пункт.Значение Цикл
			Для Каждого Код Из Операция.Значение.Получить("responses") Цикл
				Если Код.Ключ = "304" Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ ЕстьСхемаСодержимого(Код.Значение) Тогда
					Непокрытые.Добавить(СтрШаблон("%1 %2 %3", ВРег(Операция.Ключ), Пункт.Ключ, Код.Ключ));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Непокрытые, Символы.ПС), "ответы без схемы тела").Равно("");
	Ожидаем.Что(Док.Получить("components").Получить("schemas").Количество() > 80,
		"общие объекты API — в components").ЭтоИстина();

КонецПроцедуры

// У каждой операции с JSON-телом запроса схема тела — объект из components, а не голый object; двоичное
// тело публикации описано типом содержимого.
&Тест
Процедура КаждоеТелоЗапросаОписаноСхемой() Экспорт

	Непокрытые = Новый Массив();
	Тел = 0;
	Для Каждого Пункт Из Док.Получить("paths") Цикл
		Для Каждого Операция Из Пункт.Значение Цикл
			Тело_ = Операция.Значение.Получить("requestBody");
			Если Тело_ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Тел = Тел + 1;
			Схема = СхемаJSON(Тело_.Получить("content"));
			Если Тело_.Получить("content").Получить("application/octet-stream") = Неопределено
				И (Схема = Неопределено ИЛИ Схема.Получить("$ref") = Неопределено) Тогда
				Непокрытые.Добавить(СтрШаблон("%1 %2", ВРег(Операция.Ключ), Пункт.Ключ));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Тел > 80, СтрШаблон("операций с телом запроса: %1", Тел)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Непокрытые, Символы.ПС), "тела запросов без схемы").Равно("");

КонецПроцедуры

// Каждый ответ, который хаб дал сценарию, совпал со схемой своего кода: нет лишних и недостающих
// обязательных полей, типы и null — как обещано, код ответа объявлен; тело, которое хаб принял,
// подходит под схему тела запроса.
&Тест
Процедура ОтветыХабаСовпадаютСоСхемами() Экспорт
	Ожидаем.Что(СтрСоединить(Расхождения, Символы.ПС), "ответы, разошедшиеся со схемой").Равно("");
КонецПроцедуры

// Каждая схема components, до которой доходит схема ответа, хоть раз сверена с полученным значением:
// схема, которой не коснулся ни один ответ, ничего не стережёт.
&Тест
Процедура КаждаяСхемаОтветаСверенаСОтветом() Экспорт

	Схемы = Док.Получить("components").Получить("schemas");
	Достижимые = Новый Соответствие();
	Для Каждого Пункт Из Док.Получить("paths") Цикл
		Для Каждого Операция Из Пункт.Значение Цикл
			Для Каждого Код Из Операция.Значение.Получить("responses") Цикл
				СобратьСсылки(Код.Значение.Получить("content"), Схемы, Достижимые);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Несверенные = Новый Массив();
	Для Каждого Имя Из Достижимые Цикл
		Если Сверка.Пройденные().Получить(Имя.Ключ) = Неопределено Тогда
			Несверенные.Добавить(Схемы.Получить(Имя.Ключ).Получить("description"));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Достижимые.Количество() > 80, СтрШаблон("схем ответов: %1", Достижимые.Количество())).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Несверенные, ", "), "схемы ответов, не сверенные ни с одним ответом").Равно("");

КонецПроцедуры

// Сценарий дошёл до каждой операции документа и получил от неё успешный ответ: схема, которую ни разу
// не сверили с ответом, ничего не стережёт.
&Тест
Процедура СценарийВызываетКаждуюОперацию() Экспорт

	Непройденные = Новый Массив();
	Всего = 0;
	Для Каждого Пункт Из Док.Получить("paths") Цикл
		Для Каждого Операция Из Пункт.Значение Цикл
			Всего = Всего + 1;
			Коды = Вызванные.Получить(ВРег(Операция.Ключ) + " " + Пункт.Ключ);
			Если НЕ ЕстьУспех(Коды, Операция.Значение) Тогда
				Непройденные.Добавить(СтрШаблон("%1 %2 (ответы: %3)", ВРег(Операция.Ключ), Пункт.Ключ,
					КодыСтрокой(Коды)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Всего > 100, СтрШаблон("операций в документе: %1", Всего)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Непройденные, Символы.ПС), "операции без успешного ответа в сценарии").Равно("");

КонецПроцедуры

// Флаг строкой, число строкой и строку числом хаб принимает и у точек со схемой тела: ответ — тот же, что
// у булева, числа и строки, и разбор тела winow не пишет в журнал хаба ни одного несовпадения типа.
&Тест
Процедура ФлагИЧислоСтрокойПринимаютсяБезОшибокВЖурнале() Экспорт

	Начало = СтрДлина(Хаб.Дамп());
	Версия = АдресПакета() + "/versions/1.1.0";

	Отзыв = Клиент.ЗапросJSON("PATCH", Версия, "{""yanked"":""true""}", Клиент.Токен(Ключ));
	Ожидаем.Что(Отзыв.КодСостояния, "отзыв флагом-строкой: " + Клиент.Тело(Отзыв)).Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Отзыв).Получить("version").Получить("yanked"), "версия отозвана").ЭтоИстина();

	Возврат_ = Клиент.ЗапросJSON("PATCH", Версия, "{""yanked"":""0""}", Клиент.Токен(Ключ));
	Ожидаем.Что(Клиент.ТелоJSON(Возврат_).Получить("version").Получить("yanked"), "версия возвращена").ЭтоЛожь();

	Настройки = Клиент.ЗапросJSON("PATCH", АдресПула() + "/settings", "{""publish_allowed"":""1""}", Клиент.Токен(Ключ));
	Ожидаем.Что(Клиент.ТелоJSON(Настройки).Получить("settings").Получить("publish_allowed"), "публикация разрешена")
		.ЭтоИстина();

	Апстрим = Клиент.ЗапросJSON("POST", "/api/v1/pools/schemas-mirror/upstreams",
		"{""url"":""http://127.0.0.1:2/download/"",""ttl"":""300""}", Клиент.Токен(Ключ));
	Ожидаем.Что(Апстрим.КодСостояния, "апстрим со сроком строкой: " + Клиент.Тело(Апстрим)).Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Апстрим).Получить("upstream").Получить("ttl"), "срок кэша").Равно(300);

	Выпуск = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""scopes"":""read"",""expires_in_days"":""30"",""name"":124}",
		Клиент.Кука(Кука));
	Ожидаем.Что(Выпуск.КодСостояния, "ключ со сроком строкой и именем числом: " + Клиент.Тело(Выпуск)).Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Выпуск).Получить("token_info").Получить("name"), "имя ключа").Равно("124");

	Журнал = Сред(Хаб.Дамп(), Начало + 1);
	Ошибки = Новый Массив();
	Для Каждого Строчка Из СтрРазделить(Журнал, Символы.ПС, Ложь) Цикл
		Если СтрНайти(Строчка, "ОШИБКА") > 0 И СтрНайти(Строчка, "Тип свойства") > 0 Тогда
			Ошибки.Добавить(СокрЛП(Строчка));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Ошибки, " | "), "несовпадения типа при разборе тела в журнале хаба").Равно("");
	Ожидаем.Что(СтрНайти(Журнал, "Request finished HTTP/1.1 PATCH") > 0,
		"срез журнала видит эти запросы: проверка не вечнозелёная").ЭтоИстина();

КонецПроцедуры

// Ни у одного свойства схем тел запросов нет type: хаб читает поле терпимо, а тип у поля winow сверяет при
// разборе тела и на несовпадение пишет ошибку в журнал. Свойство — перечень либо пустая схема.
&Тест
Процедура СвойстваТелЗапросовБезТипа() Экспорт

	Схемы = Док.Получить("components").Получить("schemas");
	Тела = Новый Соответствие();
	Для Каждого Пункт Из Док.Получить("paths") Цикл
		Для Каждого Операция Из Пункт.Значение Цикл
			Тело_ = Операция.Значение.Получить("requestBody");
			Схема = ?(Тело_ = Неопределено, Неопределено, СхемаJSON(Тело_.Получить("content")));
			Если Схема <> Неопределено И Схема.Получить("$ref") <> Неопределено Тогда
				Тела.Вставить(СтрЗаменить(Схема.Получить("$ref"), "#/components/schemas/", ""), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Типизированные = Новый Массив();
	Свойств = 0;
	Для Каждого Имя Из Тела Цикл
		Для Каждого Свойство Из Схемы.Получить(Имя.Ключ).Получить("properties") Цикл
			Свойств = Свойств + 1;
			Для Каждого Слово Из Свойство.Значение Цикл
				Если Слово.Ключ <> "enum" Тогда
					Типизированные.Добавить(СтрШаблон("%1.%2: %3", Схемы.Получить(Имя.Ключ).Получить("description"),
						Свойство.Ключ, Слово.Ключ));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Свойств > 80, СтрШаблон("свойств тел запросов: %1", Свойств)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Типизированные, Символы.ПС), "свойства тел запросов с типом").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Сценарий

Процедура Учётки()

	Тело_ = СтрШаблон("{""login"":""schemas-guest"",""email"":""guest@example.com"",""password"":""%1""}",
		ПарольГостя());
	Ответ = Вызов("POST", "/api/v1/register", "/api/v1/register", Тело_, Аноним());
	КукаГостя = Клиент.КукаСессии(Ответ);
	Вызов("POST", "/api/v1/register", "/api/v1/register", Тело_, Аноним());

	Вызов("POST", "/api/v1/login", "/api/v1/login",
		СтрШаблон("{""login"":""schemas-guest"",""password"":""%1""}", ПарольГостя()), Аноним());
	Вызов("POST", "/api/v1/login", "/api/v1/login", "{""login"":""schemas-guest"",""password"":""x""}",
		Новый Соответствие());
	Вызов("GET", "/api/v1/whoami", "/api/v1/whoami", "", Клиент.Кука(КукаГостя));
	Вызов("GET", "/api/v1/whoami", "/api/v1/whoami", "", Аноним());

	Вызов("GET", "/api/v1/tokens", "/api/v1/tokens", "", Клиент.Кука(КукаГостя));
	Выпуск = Вызов("POST", "/api/v1/tokens", "/api/v1/tokens", "{""scopes"":""read,write"",""name"":""guest""}",
		Клиент.Кука(КукаГостя));
	КлючГостя = Поле(Выпуск, "token_info", "token");
	Временный = Вызов("POST", "/api/v1/tokens", "/api/v1/tokens", "{""scopes"":""read""}", Клиент.Кука(КукаГостя));
	Вызов("DELETE", "/api/v1/tokens/{ИдТокена}", "/api/v1/tokens/" + Ид(Временный, "token_info"), "",
		Клиент.Кука(КукаГостя));
	Вызов("DELETE", "/api/v1/tokens/{ИдТокена}", "/api/v1/tokens/999999", "", Клиент.Кука(КукаГостя));

	Вызов("POST", "/api/v1/users", "/api/v1/users",
		СтрШаблон("{""login"":""schemas-other"",""password"":""%1""}", ПарольГостя()), Аноним());

	Выход = Клиент.Войти("schemas-guest", ПарольГостя());
	Вызов("POST", "/api/v1/logout", "/api/v1/logout", "", Клиент.Кука(Выход));

КонецПроцедуры

Процедура Пулы()

	Вызов("GET", "/api/v1/pools", "/api/v1/pools?pageSize=5");
	Вызов("POST", "/api/v1/pools", "/api/v1/pools", СтрШаблон("{""name"":""%1"",""visibility"":""public""}", Пул()));
	Вызов("POST", "/api/v1/pools", "/api/v1/pools", СтрШаблон("{""name"":""%1""}", Пул()));
	Вызов("POST", "/api/v1/pools", "/api/v1/pools", "{""name"":""-bad""}");
	Вызов("GET", "/api/v1/pools/{Пул}", АдресПула());
	Вызов("GET", "/api/v1/pools/{Пул}", "/api/v1/pools/no-such-pool");
	Вызов("POST", "/api/v1/pools/{Пул}/default", АдресПула() + "/default", "{}");

	Вызов("GET", "/api/v1/pools/{Пул}/settings", АдресПула() + "/settings");
	Вызов("PATCH", "/api/v1/pools/{Пул}/settings", АдресПула() + "/settings", "{""pool_tags"":true}");
	Вызов("PATCH", "/api/v1/pools/{Пул}/settings", АдресПула() + "/settings", "{}");
	Вызов("PUT", "/api/v1/pools/{Пул}/channels/{Канал}", АдресПула() + "/channels/stable", "{}");

КонецПроцедуры

Процедура Пакеты()

	Ответ = Клиент.ОтправитьАртефакт(АдресПакета() + "/versions", Ospx("1.0.0"), ИмяФайла("1.0.0"), Ключ);
	Сверить("POST", "/api/v1/pools/{Пул}/packages/{Имя}/versions", Ответ);
	Ответ = Клиент.ОтправитьАртефакт(АдресПакета() + "/versions", Ospx("1.0.0"), ИмяФайла("1.0.0"), Ключ);
	Сверить("POST", "/api/v1/pools/{Пул}/packages/{Имя}/versions", Ответ);
	Ответ = Клиент.ОтправитьАртефакт(АдресПула() + "/push", Ospx("1.1.0"), ИмяФайла("1.1.0"), Ключ);
	Сверить("POST", "/api/v1/pools/{Пул}/push", Ответ);
	Сверить("PUT", "/api/v1/pools/{Пул}/push", Отправить("PUT", АдресПула() + "/push", Ospx("1.2.0"),
		ИмяФайла("1.2.0"), Ключ));
	Сверить("PUT", "/api/v1/pools/{Пул}/push", Отправить("PUT", АдресПула() + "/push", Ospx("1.2.0"),
		ИмяФайла("1.2.0"), ""));

	Вызов("GET", "/api/v1/pools/{Пул}/packages", АдресПула() + "/packages");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}", АдресПакета());
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}", АдресПула() + "/packages/no-such-package");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/versions", АдресПакета() + "/versions");
	Вызов("PATCH", "/api/v1/pools/{Пул}/packages/{Имя}/versions/{Версия}", АдресПакета() + "/versions/1.0.0",
		"{""label"":""lts""}");
	Вызов("PATCH", "/api/v1/pools/{Пул}/packages/{Имя}/versions/{Версия}", АдресПакета() + "/versions/1.0.0", "{}");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/resolve", АдресПакета() + "/resolve?spec=1.0.0");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/resolve", АдресПакета() + "/resolve?spec=nosuchtag");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/resolve", АдресПакета() + "/resolve?spec=%3E%3E%3E");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/readme", АдресПакета() + "/readme");
	Вызов("GET", "/api/v1/search", "/api/v1/search?q=" + Пакет());

	Выдача("/api/v1/pools/{Пул}/download/list.txt", АдресПула() + "/download/list.txt");
	Выдача("/api/v1/pools/{Пул}/download/{ИмяПакета}/{ИмяФайла}",
		СтрШаблон("%1/download/%2/%3", АдресПула(), Пакет(), ИмяФайла("1.0.0")));
	Выдача("/api/v1/pools/{Пул}/channels/{Канал}/download/list.txt", АдресПула() + "/channels/stable/download/list.txt");
	Выдача("/api/v1/pools/{Пул}/channels/{Канал}/download/{ИмяПакета}/{ИмяФайла}",
		СтрШаблон("%1/channels/stable/download/%2/%3", АдресПула(), Пакет(), ИмяФайла("1.0.0")));
	Вызов("GET", "/api/v1/pools/{Пул}/download/{ИмяПакета}/{ИмяФайла}",
		СтрШаблон("%1/download/%2/%3", АдресПула(), Пакет(), ИмяФайла("9.9.9")));
	Вызов("GET", "/api/v1/pools/{Пул}/changes", АдресПула() + "/changes");
	Вызов("GET", "/api/v1/pools/{Пул}/changes", АдресПула() + "/changes?since=вчера");

	Конвейер = "{""provider"":""github"",""repository"":""schemas/pkg"",""workflow"":""release.yml"",""ref"":""main""}";
	Адрес = АдресПакета() + "/trusted-workflows";
	Заведённый = Вызов("POST", "/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows", Адрес, Конвейер);
	Вызов("POST", "/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows", Адрес, Конвейер);
	Вызов("POST", "/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows", Адрес, "{""provider"":""bitbucket""}");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows", Адрес);
	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows/{Ид}",
		Адрес + "/" + Ид(Заведённый, "trusted_workflow"), "{}");
	Второй = Вызов("POST", "/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows", Адрес, Конвейер);
	Вызов("POST", "/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows/{Ид}/delete",
		Адрес + "/" + Ид(Второй, "trusted_workflow") + "/delete", "{}");

КонецПроцедуры

Процедура Теги()

	АдресТегаПула = АдресПула() + "/tags/beta";
	Вызов("PUT", "/api/v1/pools/{Пул}/tags/{Тег}", АдресТегаПула, "{""rule"":"">=1.0.0"",""ruleType"":""semver""}");
	Вызов("PUT", "/api/v1/pools/{Пул}/tags/{Тег}", АдресТегаПула, "{""rule"":""(a+)+"",""ruleType"":""regex""}");
	Вызов("GET", "/api/v1/pools/{Пул}/tags", АдресПула() + "/tags");

	Теги = АдресПакета() + "/tags";
	Вызов("PUT", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}/disabled", Теги + "/beta/disabled", "{}");
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/tags", Теги);
	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}/disabled", Теги + "/beta/disabled", "{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/tags/{Тег}", АдресТегаПула, "{}");

	Вызов("PUT", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}", Теги + "/manual", "{""mode"":""ручной""}");
	Вызов("PUT", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}/versions/{Версия}", Теги + "/manual/versions/1.0.0", "{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}/versions/{Версия}", Теги + "/manual/versions/1.0.0",
		"{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}", Теги + "/manual", "{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}", Теги + "/manual", "{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}/pin", Теги + "/stable/pin", "{}");
	Вызов("PUT", "/api/v1/pools/{Пул}/packages/{Имя}/channels/{Канал}", АдресПакета() + "/channels/legacy",
		"{""type"":""semver"",""pattern"":"">=1.0.0""}");

	Вызов("POST", "/api/v1/tags/preview", "/api/v1/tags/preview",
		СтрШаблон("{""pool"":""%1"",""package"":""%2"",""rule"":"">=1.0.0"",""type"":""semver""}", Пул(), Пакет()));
	Вызов("POST", "/api/v1/tags/preview", "/api/v1/tags/preview",
		СтрШаблон("{""pool"":""%1"",""package"":""%2"",""rule"":""(("",""type"":""regex""}", Пул(), Пакет()));

КонецПроцедуры

Процедура Заявки()

	Ответ = Клиент.ОтправитьАртефакт(АдресПула() + "/push", ФикстураЗаявки("schemas-inbox-a"),
		"schemas-inbox-a-1.0.0.ospx", КлючГостя);
	Сверить("POST", "/api/v1/pools/{Пул}/push", Ответ);
	Ответ = Клиент.ОтправитьАртефакт(СтрШаблон("%1/packages/schemas-inbox-b/versions", АдресПула()),
		ФикстураЗаявки("schemas-inbox-b"), "schemas-inbox-b-1.0.0.ospx", КлючГостя);
	Сверить("POST", "/api/v1/pools/{Пул}/packages/{Имя}/versions", Ответ);

	Вызов("GET", "/api/v1/inbox", "/api/v1/inbox");
	Вызов("GET", "/api/v1/inbox", "/api/v1/inbox", "", Аноним());
	Список = Клиент.ТелоJSON(Вызов("GET", "/api/v1/pools/{Пул}/inbox", АдресПула() + "/inbox"));
	Номера = Новый Соответствие();
	Для Каждого Заявка Из Список.Получить("items") Цикл
		Номера.Вставить(Заявка.Получить("package"), Формат(Заявка.Получить("id"), "ЧГ=0; ЧН=0"));
	КонецЦикла;
	Ожидаем.Что(Номера.Количество(), "обе заявки во входящих пула").Равно(2);

	Вызов("POST", "/api/v1/pools/{Пул}/inbox/{Заявка}/approve",
		СтрШаблон("%1/inbox/%2/approve", АдресПула(), Номера.Получить("schemas-inbox-a")), "{}");
	Вызов("POST", "/api/v1/pools/{Пул}/inbox/{Заявка}/reject",
		СтрШаблон("%1/inbox/%2/reject", АдресПула(), Номера.Получить("schemas-inbox-b")), "{""reason"":""нет""}");
	Вызов("POST", "/api/v1/pools/{Пул}/inbox/{Заявка}/reject",
		СтрШаблон("%1/inbox/%2/reject", АдресПула(), Номера.Получить("schemas-inbox-b")), "{}");

КонецПроцедуры

Процедура Подписки()

	Вызов("GET", "/api/v1/webhook-meta", "/api/v1/webhook-meta", "", Аноним());

	Хаба = ПодпискаОбъекта("/api/v1/webhooks", "", "hub", ",""narrowing_allowed"":true");
	Вызов("PATCH", "/api/v1/webhooks/{Ид}", "/api/v1/webhooks/" + Хаба,
		"{""events"":[""версия.опубликована"",""пул.заполнен""],""params"":{""пул.заполнен"":90}}");
	Вызов("GET", "/api/v1/webhooks/{Ид}/recipients", "/api/v1/webhooks/" + Хаба + "/recipients");
	Вызов("PUT", "/api/v1/webhooks/{Ид}/recipients", "/api/v1/webhooks/" + Хаба + "/recipients",
		"{""excluded_pools"":[]}");
	Вызов("PUT", "/api/v1/webhooks/{Ид}/recipients", "/api/v1/webhooks/" + Хаба + "/recipients",
		"{""excluded_pools"":[""no-such-pool""]}");

	Пула = ПодпискаОбъекта("/api/v1/pools/{Пул}", АдресПула(), "pool", ",""narrowing_allowed"":true");
	Получатели = СтрШаблон("%1/webhooks/%2/recipients", АдресПула(), Пула);
	Вызов("GET", "/api/v1/pools/{Пул}/webhooks/{Ид}/recipients", Получатели);
	Вызов("PUT", "/api/v1/pools/{Пул}/webhooks/{Ид}/recipients", Получатели, "{""excluded_packages"":[]}");

	Сверху = АдресПула() + "/inherited-webhooks";
	Вызов("GET", "/api/v1/pools/{Пул}/inherited-webhooks", Сверху);
	Вызов("GET", "/api/v1/pools/{Пул}/inherited-webhooks/{Ид}", Сверху + "/" + Хаба);
	Вызов("PUT", "/api/v1/pools/{Пул}/inherited-webhooks/{Ид}", Сверху + "/" + Хаба, "{""mute"":true}");
	Вызов("GET", "/api/v1/pools/{Пул}/inherited-webhooks/{Ид}/recipients", Сверху + "/" + Хаба + "/recipients");
	Вызов("PUT", "/api/v1/pools/{Пул}/inherited-webhooks/{Ид}/recipients", Сверху + "/" + Хаба + "/recipients",
		СтрШаблон("{""excluded_packages"":[""%1""]}", Пакет()));
	Вызов("GET", "/api/v1/pools/{Пул}/inherited-webhooks", Сверху);
	Вызов("DELETE", "/api/v1/pools/{Пул}/inherited-webhooks/{Ид}", Сверху + "/" + Хаба, "{}");

	Пакета = ПодпискаОбъекта("/api/v1/pools/{Пул}/packages/{Имя}", АдресПакета(), "package", "");
	СверхуПакета = АдресПакета() + "/inherited-webhooks";
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/inherited-webhooks", СверхуПакета);
	Вызов("GET", "/api/v1/pools/{Пул}/packages/{Имя}/inherited-webhooks/{Ид}", СверхуПакета + "/" + Пула);
	Вызов("PUT", "/api/v1/pools/{Пул}/packages/{Имя}/inherited-webhooks/{Ид}", СверхуПакета + "/" + Пула,
		"{""events"":[]}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/inherited-webhooks/{Ид}", СверхуПакета + "/" + Пула, "{}");

	Вызов("DELETE", "/api/v1/pools/{Пул}/packages/{Имя}/webhooks/{Ид}",
		СтрШаблон("%1/webhooks/%2", АдресПакета(), Пакета), "{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/webhooks/{Ид}", СтрШаблон("%1/webhooks/%2", АдресПула(), Пула), "{}");
	Вызов("DELETE", "/api/v1/webhooks/{Ид}", "/api/v1/webhooks/" + Хаба, "{}");

КонецПроцедуры

// Подписка объекта целиком: заведение, список, карточка, правка; номер подписки.
Функция ПодпискаОбъекта(Знач ШаблонОбъекта, Знач АдресОбъекта, Знач Метка, Знач Дополнение)

	Шаблон = ?(ЗначениеЗаполнено(АдресОбъекта), ШаблонОбъекта + "/webhooks", ШаблонОбъекта);
	Адрес = ?(ЗначениеЗаполнено(АдресОбъекта), АдресОбъекта + "/webhooks", ШаблонОбъекта);
	Тело_ = СтрШаблон("{""kind"":""вебхук"",""url"":""https://hooks.example.com/%1"","
		+ """events"":[""версия.опубликована""]%2}", Метка, Дополнение);

	Номер = Ид(Вызов("POST", Шаблон, Адрес, Тело_), "subscription");
	Вызов("POST", Шаблон, Адрес, "{""events"":[]}");
	Вызов("GET", Шаблон, Адрес);
	Вызов("GET", Шаблон + "/{Ид}", Адрес + "/" + Номер);
	Вызов("GET", Шаблон + "/{Ид}", Адрес + "/999999");
	Вызов("PATCH", Шаблон + "/{Ид}", Адрес + "/" + Номер, "{""name"":""schemas""}");
	Возврат Номер;

КонецФункции

Процедура Доступ()

	Права = АдресПула() + "/grants";
	Вызов("POST", "/api/v1/pools/{Пул}/grants", Права, "{""subject"":""schemas-guest"",""role"":""читатель""}");
	Вызов("POST", "/api/v1/pools/{Пул}/grants", Права, "{""subject"":""nobody""}");
	Вызов("GET", "/api/v1/pools/{Пул}/grants", Права);
	Вызов("DELETE", "/api/v1/pools/{Пул}/grants", Права, "{""subject"":""schemas-guest""}");
	Вызов("GET", "/api/v1/users/{Логин}/grants", "/api/v1/users/schemas-admin/grants");

	Вызов("POST", "/api/v1/groups", "/api/v1/groups", "{""name"":""schemas-team"",""description"":""Схемы""}");
	Вызов("POST", "/api/v1/groups", "/api/v1/groups", "{""name"":""schemas-team""}");
	Вызов("GET", "/api/v1/groups", "/api/v1/groups");
	Вызов("GET", "/api/v1/groups", "/api/v1/groups", "", Аноним());
	Группа = "/api/v1/groups/schemas-team";
	Вызов("GET", "/api/v1/groups/{Группа}", Группа);
	Вызов("GET", "/api/v1/groups/{Группа}", "/api/v1/groups/no-such-group");
	Вызов("GET", "/api/v1/groups/{Группа}/grants", Группа + "/grants");
	Вызов("POST", "/api/v1/groups/{Группа}/members", Группа + "/members", "{""login"":""schemas-guest""}");
	Вызов("GET", "/api/v1/groups/{Группа}/members", Группа + "/members");
	Вызов("DELETE", "/api/v1/groups/{Группа}/members/{Логин}", Группа + "/members/schemas-guest", "{}");
	Сопоставление = "{""issuer"":""https://idp.example.com"",""value"":""schemas""}";
	Вызов("POST", "/api/v1/groups/{Группа}/oidc-mappings", Группа + "/oidc-mappings", Сопоставление);
	Вызов("POST", "/api/v1/groups/{Группа}/oidc-mappings", Группа + "/oidc-mappings", "{}");
	Вызов("GET", "/api/v1/groups/{Группа}/oidc-mappings", Группа + "/oidc-mappings");
	Вызов("GET", "/api/v1/oidc-mappings", "/api/v1/oidc-mappings");
	Вызов("DELETE", "/api/v1/groups/{Группа}/oidc-mappings", Группа + "/oidc-mappings", Сопоставление);

КонецПроцедуры

Процедура Источники()

	Вызов("POST", "/api/v1/pools", "/api/v1/pools", "{""name"":""schemas-mirror"",""visibility"":""public""}");
	ПулЗеркала = "/api/v1/pools/schemas-mirror";
	Апстрим = СтрШаблон("{""url"":""%1"",""ttl"":300}", АдресИсточника());
	Вызов("POST", "/api/v1/pools/{Пул}/upstreams", ПулЗеркала + "/upstreams", Апстрим);
	Вызов("POST", "/api/v1/pools/{Пул}/upstreams", ПулЗеркала + "/upstreams", "{""url"":""""}");
	Вызов("GET", "/api/v1/pools/{Пул}/upstreams", ПулЗеркала + "/upstreams");

	// пакет, которого в пуле нет, хаб ищет у апстрима — недоступный апстрим оставляет прошлую неудачу
	Клиент.GET(ПулЗеркала + "/download/schemas-absent/schemas-absent.ospx", Клиент.Токен(Ключ));
	ДождатьсяПоля("GET", "/api/v1/pools/{Пул}/upstreams", ПулЗеркала + "/upstreams", "items", "last_failure");
	Вызов("DELETE", "/api/v1/pools/{Пул}/upstreams", ПулЗеркала + "/upstreams", Апстрим);

	Зеркала = ПулЗеркала + "/mirrors";
	Номер = Ид(Вызов("POST", "/api/v1/pools/{Пул}/mirrors", Зеркала,
		СтрШаблон("{""url"":""%1"",""interval"":900}", АдресИсточника())), "mirror");
	Вызов("POST", "/api/v1/pools/{Пул}/mirrors", Зеркала, "{""url"":""""}");
	Вызов("GET", "/api/v1/pools/{Пул}/mirrors", Зеркала);
	Вызов("POST", "/api/v1/pools/{Пул}/mirrors/{Ид}/sync", Зеркала + "/" + Номер + "/sync", "{}");
	// синхронизация с недоступным источником оставляет у зеркала происшествие
	ДождатьсяПоля("GET", "/api/v1/pools/{Пул}/mirrors/{Ид}", Зеркала + "/" + Номер, "mirror", "incidents");
	Вызов("PATCH", "/api/v1/pools/{Пул}/mirrors/{Ид}", Зеркала + "/" + Номер, "{""enabled"":false}");
	Вызов("PATCH", "/api/v1/pools/{Пул}/mirrors/{Ид}", Зеркала + "/" + Номер, "{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}/mirrors/{Ид}", Зеркала + "/" + Номер, "{}");
	Вызов("GET", "/api/v1/pools/{Пул}/mirrors/{Ид}", Зеркала + "/" + Номер);

КонецПроцедуры

Процедура СостояниеИНастройкиХаба()

	Вызов("GET", "/api/v1/health", "/api/v1/health", "", Аноним());
	Вызов("GET", "/api/v1/metrics", "/api/v1/metrics", "", Аноним());

	Вызов("GET", "/api/v1/hub/settings", "/api/v1/hub/settings");
	Вызов("GET", "/api/v1/hub/settings", "/api/v1/hub/settings?section=mail");
	Вызов("GET", "/api/v1/hub/settings/{Ключ}", "/api/v1/hub/settings/oshub.api.page_size");
	Настройка = "/api/v1/hub/settings/oshub.publish.github.org";
	Вызов("GET", "/api/v1/hub/settings/{Ключ}", Настройка);
	Вызов("GET", "/api/v1/hub/settings/{Ключ}", "/api/v1/hub/settings/oshub.mail.smtp.password");
	Вызов("PATCH", "/api/v1/hub/settings/{Ключ}", Настройка, "{""value"":""schemas-org""}");
	Вызов("PATCH", "/api/v1/hub/settings/{Ключ}", Настройка, "{}");
	Вызов("DELETE", "/api/v1/hub/settings/{Ключ}", Настройка, "{}");
	Вызов("GET", "/api/v1/hub/settings/{Ключ}", "/api/v1/hub/settings/oshub.no.such.key");

КонецПроцедуры

Процедура ВходСУстройства()

	Вызов("POST", "/api/v1/cli/auth/device", "/api/v1/cli/auth/device", "{""scopes"":""bad""}", Аноним());
	Заявка = Клиент.ТелоJSON(Вызов("POST", "/api/v1/cli/auth/device", "/api/v1/cli/auth/device",
		"{""client_name"":""schemas"",""scopes"":""read""}", Аноним()));
	КодУстройства = Строка(Заявка.Получить("device_code"));
	КодЧеловека = Строка(Заявка.Получить("user_code"));
	Опрос = СтрШаблон("{""device_code"":""%1""}", КодУстройства);

	Вызов("POST", "/api/v1/cli/auth/device/token", "/api/v1/cli/auth/device/token", Опрос, Аноним());

	Страница = Клиент.Тело(Клиент.GETСКукой("/cli/login?user_code=" + КодЧеловека, Кука));
	Поля = Новый Соответствие();
	Поля.Вставить("user_code", КодЧеловека);
	Поля.Вставить("действие", "разрешить");
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Ожидаем.Что(Клиент.POSTФормы("/cli/login", Поля, Кука).КодСостояния, "вход устройства разрешён").Равно(200);

	// опрос чаще интервала заявки отвечает slow_down
	Приостановить(Заявка.Получить("interval") * 1000 + 500);
	Вызов("POST", "/api/v1/cli/auth/device/token", "/api/v1/cli/auth/device/token", Опрос, Аноним());

КонецПроцедуры

Процедура УдалениеПула()

	Вызов("POST", "/api/v1/pools", "/api/v1/pools", "{""name"":""schemas-gone"",""visibility"":""public""}");
	Вызов("DELETE", "/api/v1/pools/{Пул}", "/api/v1/pools/schemas-gone", "{}");
	Вызов("DELETE", "/api/v1/pools/{Пул}", АдресПула(), "{}");

КонецПроцедуры

#КонецОбласти

#Область Сверка

// Запрос JSON по адресу и сверка ответа с операцией документа.
Функция Вызов(Знач Глагол, Знач Шаблон, Знач Адрес, Знач Тело_ = "", Знач Заголовки = Неопределено)

	Ответ = Клиент.ЗапросJSON(Глагол, Адрес, Тело_, ?(Заголовки = Неопределено, Клиент.Токен(Ключ), Заголовки));
	Сверить(Глагол, Шаблон, Ответ);
	Если ЗначениеЗаполнено(Тело_) И Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		СверитьПринятоеТело(Глагол, Шаблон, Тело_);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Повторяет чтение, пока в ответе не появится непустое поле: фон хаба пишет его не сразу. Сверяется
// каждый ответ, последний — с полем.
Процедура ДождатьсяПоля(Знач Глагол, Знач Шаблон, Знач Адрес, Знач Объект, Знач Поле)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 60000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Тело_ = Клиент.ТелоJSON(Вызов(Глагол, Шаблон, Адрес));
		Носитель = Тело_.Получить(Объект);
		Если ТипЗнч(Носитель) = Тип("Массив") И Носитель.Количество() > 0 Тогда
			Носитель = Носитель[0];
		КонецЕсли;
		Если ТипЗнч(Носитель) = Тип("Соответствие") И ЗначениеЗаполнено(Носитель.Получить(Поле)) Тогда
			Возврат;
		КонецЕсли;
		Приостановить(2000);
	КонецЦикла;

	Расхождения.Добавить(СтрШаблон("%1 %2: за минуту в ответе не появилось %3.%4", Глагол, Шаблон, Объект, Поле));

КонецПроцедуры

// Выдача для opm: GET и HEAD одного адреса.
Процедура Выдача(Знач Шаблон, Знач Адрес)
	Сверить("GET", Шаблон, Клиент.GET(Адрес, Клиент.Токен(Ключ)));
	Сверить("HEAD", Шаблон, Клиент.HEAD(Адрес, Клиент.Токен(Ключ)));
КонецПроцедуры

Процедура Сверить(Знач Глагол, Знач Шаблон, Знач Ответ)

	Где = СтрШаблон("%1 %2 %3", ВРег(Глагол), Шаблон, Формат(Ответ.КодСостояния, "ЧГ=0"));

	Пункт = Док.Получить("paths").Получить(Шаблон);
	Операция = ?(Пункт = Неопределено, Неопределено, Пункт.Получить(НРег(Глагол)));
	Если Операция = Неопределено Тогда
		Расхождения.Добавить(Где + ": операции нет в документе");
		Возврат;
	КонецЕсли;

	Отметить(ВРег(Глагол) + " " + Шаблон, Формат(Ответ.КодСостояния, "ЧГ=0"));

	Объявленный = Операция.Получить("responses").Получить(Формат(Ответ.КодСостояния, "ЧГ=0"));
	Если Объявленный = Неопределено Тогда
		Расхождения.Добавить(Где + ": код не объявлен; тело " + Лев(Клиент.Тело(Ответ), 300));
		Возврат;
	КонецЕсли;

	Если ВРег(Глагол) = "HEAD" ИЛИ Ответ.КодСостояния = 304 Тогда
		Возврат;
	КонецЕсли;

	ТипОтвета = НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type"));
	Содержимое = Объявленный.Получить("content");
	Если НЕ СтрНачинаетсяС(ТипОтвета, "application/json") Тогда
		Если Содержимое = Неопределено ИЛИ Содержимое.Получить(СокрЛП(СтрРазделить(ТипОтвета, ";")[0])) = Неопределено Тогда
			Расхождения.Добавить(СтрШаблон("%1: тип содержимого %2 не объявлен", Где, ТипОтвета));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Схема = СхемаJSON(Содержимое);
	Если Схема = Неопределено Тогда
		Расхождения.Добавить(Где + ": JSON-ответ без схемы");
		Возврат;
	КонецЕсли;

	Тело_ = Клиент.ТелоJSON(Ответ);
	Для Каждого Расхождение Из Сверка.Расхождения(Тело_, Схема) Цикл
		Расхождения.Добавить(Где + ": " + Расхождение);
	КонецЦикла;

	СхемаГлагола = СхемыГлаголов.Получить(СтрШаблон("%1 %2 %3", ВРег(Глагол), Шаблон, Формат(Ответ.КодСостояния, "ЧГ=0")));
	Если СхемаГлагола <> Неопределено Тогда
		Для Каждого Расхождение Из Сверка.Расхождения(Тело_, СхемаГлагола) Цикл
			Расхождения.Добавить(Где + ", схема глагола: " + Расхождение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// У адреса с несколькими глаголами winow даёт одну схему на код — объединение полей глаголов, все
// необязательные. Ответ своего глагола сверяется ещё и со схемой этого глагола: класс из components либо
// поля объединения, которые глагол отдаёт всегда.
Функция СхемыГлаголовАдресов()

	Т = Новый Соответствие();
	Пул = "/api/v1/pools/{Пул}";
	Пакет = Пул + "/packages/{Имя}";
	Страница = "items, page, pageSize, total, has_more";

	ГлаголКлассом(Т, "GET " + Пул, "КарточкаПулаJSON");
	ГлаголПолями(Т, "DELETE " + Пул, "ПулИлиСносПулаJSON", "deleted, pool, removed", "pool");
	ГлаголПолями(Т, "GET " + Пакет + "/versions", "ВерсииИлиПубликацияJSON", "versions, page, pageSize, total, has_more");
	ГлаголКлассом(Т, "POST " + Пакет + "/versions", "ИтогПубликацииJSON");
	ГлаголКлассом(Т, "PUT " + Пул + "/tags/{Тег}", "ТегВПулеJSON");
	ГлаголКлассом(Т, "DELETE " + Пул + "/tags/{Тег}", "УдалениеJSON");
	ГлаголКлассом(Т, "PUT " + Пакет + "/tags/{Тег}", "ТегПакетаJSON");
	ГлаголКлассом(Т, "DELETE " + Пакет + "/tags/{Тег}", "УдалениеJSON");
	Для Каждого Владелец Из СтрРазделить("/api/v1|" + Пул + "|" + Пакет, "|") Цикл
		ГлаголПолями(Т, "GET " + Владелец + "/webhooks/{Ид}", "ПодпискаИлиСносJSON", "subscription");
		ГлаголПолями(Т, "PATCH " + Владелец + "/webhooks/{Ид}", "ПодпискаИлиСносJSON", "subscription");
		ГлаголКлассом(Т, "DELETE " + Владелец + "/webhooks/{Ид}", "УдалениеJSON");
	КонецЦикла;
	ГлаголКлассом(Т, "GET " + Пул + "/grants", "СтраницаПравJSON");
	ГлаголПолями(Т, "DELETE " + Пул + "/grants", "ПраваИлиОтзывJSON", "revoked");
	ГлаголПолями(Т, "GET " + Пул + "/upstreams", "АпстримыИлиСнятиеJSON", Страница);
	ГлаголКлассом(Т, "DELETE " + Пул + "/upstreams", "СнятиеJSON");
	ГлаголКлассом(Т, "GET " + Пул + "/mirrors/{Ид}", "КарточкаЗеркалаJSON");
	ГлаголКлассом(Т, "PATCH " + Пул + "/mirrors/{Ид}", "КарточкаЗеркалаJSON");
	ГлаголКлассом(Т, "DELETE " + Пул + "/mirrors/{Ид}", "УдалениеJSON");
	ГлаголПолями(Т, "GET " + Пакет + "/trusted-workflows", "КонвейерыИлиКонвейерJSON", Страница);
	ГлаголКлассом(Т, "POST " + Пакет + "/trusted-workflows", "КарточкаДоверенногоКонвейераJSON");
	ГлаголПолями(Т, "GET /api/v1/groups/{Группа}/oidc-mappings", "СопоставленияИлиСнятиеJSON", Страница + ", policy");
	ГлаголКлассом(Т, "DELETE /api/v1/groups/{Группа}/oidc-mappings", "СнятиеJSON");
	Возврат Т;

КонецФункции

Процедура ГлаголКлассом(Т, Знач Операция, Знач Класс)
	Т.Вставить(Операция + " 200", Ссылка(СхемаКласса(Класс)));
КонецПроцедуры

// Схема глагола из полей объединения: поля обязательны, прочих нет; поле объединения без типа глагол
// отдаёт строкой.
Процедура ГлаголПолями(Т, Знач Операция, Знач Объединение, Знач Поля, Знач Строкой = "")

	Свойства_ = Док.Получить("components").Получить("schemas").Получить(СхемаКласса(Объединение)).Получить("properties");
	Свойства = Новый Соответствие();
	Обязательные = Новый Массив();
	Для Каждого Имя Из СтрРазделить(Поля, ", ", Ложь) Цикл
		Свойства.Вставить(Имя, Свойства_.Получить(Имя));
		Обязательные.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить(Строкой, ", ", Ложь) Цикл
		Строка_ = Новый Соответствие();
		Строка_.Вставить("type", "string");
		Свойства.Вставить(Имя, Строка_);
	КонецЦикла;

	Схема = Новый Соответствие();
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);
	Т.Вставить(Операция + " 200", Схема);

КонецПроцедуры

// Имя схемы в components по имени класса: winow транслитерирует имя, а исходное кладёт в описание.
Функция СхемаКласса(Знач Класс)
	Для Каждого Схема Из Док.Получить("components").Получить("schemas") Цикл
		Если Схема.Значение.Получить("description") = Класс Тогда
			Возврат Схема.Ключ;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("схемы класса %1 в документе нет", Класс);
КонецФункции

Функция Ссылка(Знач ИмяСхемы)
	Схема = Новый Соответствие();
	Схема.Вставить("$ref", "#/components/schemas/" + ИмяСхемы);
	Возврат Схема;
КонецФункции

Процедура СверитьПринятоеТело(Знач Глагол, Знач Шаблон, Знач Тело_)

	Где = СтрШаблон("%1 %2, тело запроса", ВРег(Глагол), Шаблон);
	Пункт = Док.Получить("paths").Получить(Шаблон);
	Описание = ?(Пункт = Неопределено, Неопределено, Пункт.Получить(НРег(Глагол)).Получить("requestBody"));
	Схема = ?(Описание = Неопределено, Неопределено, СхемаJSON(Описание.Получить("content")));
	Если Схема = Неопределено Тогда
		Расхождения.Добавить(Где + ": хаб принял тело, схемы которого нет");
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело_);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Для Каждого Расхождение Из Сверка.Расхождения(Значение, Схема) Цикл
		Расхождения.Добавить(Где + ": " + Расхождение);
	КонецЦикла;

КонецПроцедуры

Процедура Отметить(Знач Операция, Знач Код)
	Коды = Вызванные.Получить(Операция);
	Если Коды = Неопределено Тогда
		Коды = Новый Соответствие();
		Вызванные.Вставить(Операция, Коды);
	КонецЕсли;
	Коды.Вставить(Код, Истина);
КонецПроцедуры

Функция СхемаJSON(Знач Содержимое)
	Если Содержимое = Неопределено ИЛИ Содержимое.Получить("application/json") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Содержимое.Получить("application/json").Получить("schema");
КонецФункции

// Имена схем components, на которые ссылается узел документа, со всеми, на которые ссылаются они.
Процедура СобратьСсылки(Знач Узел, Знач Схемы, Достижимые)

	Если ТипЗнч(Узел) = Тип("Массив") Тогда
		Для Каждого Элемент Из Узел Цикл
			СобратьСсылки(Элемент, Схемы, Достижимые);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Поле Из Узел Цикл
		Если Поле.Ключ = "$ref" Тогда
			Имя = СтрЗаменить(Поле.Значение, "#/components/schemas/", "");
			Если Достижимые.Получить(Имя) = Неопределено Тогда
				Достижимые.Вставить(Имя, Истина);
				СобратьСсылки(Схемы.Получить(Имя), Схемы, Достижимые);
			КонецЕсли;
		Иначе
			СобратьСсылки(Поле.Значение, Схемы, Достижимые);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьСхемаСодержимого(Знач Ответ)

	Содержимое = Ответ.Получить("content");
	Если Содержимое = Неопределено ИЛИ Содержимое.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Вид Из Содержимое Цикл
		Если Вид.Ключ = "application/json" И (Вид.Значение.Получить("schema") = Неопределено
				ИЛИ Вид.Значение.Получить("schema").Количество() = 0) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Успех операции — код 2xx; у операции, которая успеха не объявляет (упразднённый адрес), — любой
// объявленный код.
Функция ЕстьУспех(Знач Коды, Знач Операция)

	Если Коды = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбъявленУспех = Ложь;
	Для Каждого Код Из Операция.Получить("responses") Цикл
		ОбъявленУспех = ОбъявленУспех ИЛИ СтрНачинаетсяС(Код.Ключ, "2");
	КонецЦикла;

	Для Каждого Код Из Коды Цикл
		Если СтрНачинаетсяС(Код.Ключ, "2") ИЛИ НЕ ОбъявленУспех Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция КодыСтрокой(Знач Коды)
	Если Коды = Неопределено Тогда
		Возврат "не вызвана";
	КонецЕсли;
	Список = Новый Массив();
	Для Каждого Код Из Коды Цикл
		Список.Добавить(Код.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Список, ",");
КонецФункции

#КонецОбласти

#Область Помощники

// Публикация двоичного тела глаголом, которого клиент хаба не умеет.
Функция Отправить(Знач Глагол, Знач Путь, Знач Данные, Знач ИмяФайла_, Знач Ключ_)
	Заголовки = Клиент.Токен(Ключ_);
	Заголовки.Вставить("FILE-NAME", ИмяФайла_);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Клиент.Соединение().ВызватьHTTPМетод(Глагол, Запрос);
КонецФункции

// Заголовки запроса без входа.
Функция Аноним()
	Возврат Новый Соответствие();
КонецФункции

Функция Поле(Знач Ответ, Знач Объект, Знач Имя)
	Тело_ = Клиент.ТелоJSON(Ответ).Получить(Объект);
	Возврат ?(Тело_ = Неопределено, "", Строка(Тело_.Получить(Имя)));
КонецФункции

Функция Ид(Знач Ответ, Знач Объект)
	Тело_ = Клиент.ТелоJSON(Ответ).Получить(Объект);
	Если Тело_ = Неопределено Тогда
		ВызватьИсключение СтрШаблон("в ответе %1 нет %2: %3", Ответ.КодСостояния, Объект, Клиент.Тело(Ответ));
	КонецЕсли;
	Возврат Формат(Тело_.Получить("id"), "ЧГ=0; ЧН=0");
КонецФункции

Функция Ospx(Знач Версия)
	Возврат Новый ФикстураПакета().ДанныеOspx(КореньДанных, Пакет(), Версия);
КонецФункции

// Пакет заявки с зависимостями: сведения манифеста во входящих несут их перечень.
Функция ФикстураЗаявки(Знач ИмяПакета)
	Манифест = Новый ФикстураПакета().МанифестСРепозиторием(ИмяПакета, "1.0.0")
		.ДобавитьЗависимость("logos", "1.7.1", "2.0.0")
		.ДобавитьЗависимость("asserts", "1.6.0", "", Истина);
	Возврат Новый ФикстураПакета().ДанныеOspxПоМанифесту(КореньДанных, Манифест);
КонецФункции

Функция ИмяФайла(Знач Версия)
	Возврат СтрШаблон("%1-%2.ospx", Пакет(), Версия);
КонецФункции

Функция АдресПула()
	Возврат "/api/v1/pools/" + Пул();
КонецФункции

Функция АдресПакета()
	Возврат АдресПула() + "/packages/" + Пакет();
КонецФункции

// Источник, до которого не дойти: зеркало и апстрим заводятся, синхронизация кончается быстро.
Функция АдресИсточника()
	Возврат "http://127.0.0.1:1/download/";
КонецФункции

Функция Пул()
	Возврат "schemas";
КонецФункции

Функция Пакет()
	Возврат "schemas-pkg";
КонецФункции

Функция ПарольАдмина()
	Возврат "SchemasAdminPass1";
КонецФункции

Функция ПарольГостя()
	Возврат "SchemasGuestPass1";
КонецФункции

#КонецОбласти
