// Боевая доставка вебхука на живом хабе настоящим HTTP-транспортом: событие версии уходит
// на приёмник набора с латинским кодом события в X-OpenHub-Event, идентификатором доставки
// и подписью — все заголовки ASCII, тело несёт тип события как есть.
// Засев кабинета: пул public с alice-pkg 1.0.0 и 1.1.0, root — администратор хаба.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу
Перем Мутация;  // заголовки мутации root: кука и CSRF

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ПриёмникВебхука");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);

	Хаб.ФайловаяБаза("openhub-доставка-вебхука");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// приёмник набора — http на loopback; он не отвечает, хаб бросает ждать быстро
	Хаб.Среда("OSHUB_WEBHOOKS_ALLOW__INSECURE", "true");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__TIMEOUT__SEC", "2");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__INTERVAL__SEC", "1");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры",
		"ЗасеятьКабинет.os"));

	Хаб.Запустить();

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Мутация = Клиент.ЗаголовкиМутации(Кука,
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/tokens", Кука))));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Отзыв версии доходит до приёмника POST-ом с кодом «version.yanked» в заголовке: настоящий
// транспорт отвергает кириллицу в заголовке до сети, и доставка не ушла бы вовсе.
&Тест
Процедура ОтзывВерсииУходитВебхукомСЛатинскимКодомСобытия() Экспорт

	Приёмник = Новый ПриёмникВебхука();
	Порт = Формат(Приёмник.Слушать(), "ЧГ=0");
	Попытка
		Заведена = Клиент.ЗапросJSON("POST", "/api/v1/pools/public/packages/alice-pkg/webhooks",
			"{""тип"":""вебхук"",""url"":""http://127.0.0.1:" + Порт + "/boevaya"","
			+ """секрет"":""sekret-boevoy"",""события"":[""версия.отозвана""]}", Мутация);
		Ожидаем.Что(Заведена.КодСостояния, "подписка заведена: " + Клиент.Тело(Заведена)).Равно(201);
		Отзыв = Клиент.ЗапросJSON("PATCH", "/api/v1/pools/public/packages/alice-pkg/versions/1.0.0",
			"{""yanked"":true}", Мутация);
		Ожидаем.Что(Отзыв.КодСостояния, "версия отозвана: " + Клиент.Тело(Отзыв)).Равно(200);
		Запрос = Приёмник.ПринятьЗапрос(60);
	Исключение
		Приёмник.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	Приёмник.Остановить();

	Ожидаем.Что(СтрНачинаетсяС(Запрос, "POST /boevaya "), "доставка дошла до приёмника: " + Запрос
		+ Символы.ПС + СтрокиЖурнала("Вебхук")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Запрос), "x-openhub-event: version.yanked") > 0,
		"в заголовке — латинский код события: " + Запрос).ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Запрос), "x-openhub-delivery: ") > 0, "идентификатор доставки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Запрос), "x-openhub-signature: sha256=") > 0, "подпись").ЭтоИстина();
	Ожидаем.Что(ЗаголовкиТолькоASCII(Запрос), "все заголовки — ASCII: " + Запрос).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запрос, """тип"":""версия.отозвана""") > 0, "тело несёт тип события как есть")
		.ЭтоИстина();

КонецПроцедуры

// Заголовки — всё до пустой строки, отделяющей тело.
Функция ЗаголовкиТолькоASCII(Знач Запрос)
	Граница = СтрНайти(Запрос, Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС);
	Заголовки = ?(Граница = 0, Запрос, Лев(Запрос, Граница));
	Для Номер = 1 По СтрДлина(Заголовки) Цикл
		Если КодСимвола(Заголовки, Номер) > 127 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Строки журнала хаба с фрагментом: причина сбоя доставки видна в сообщении упавшей проверки.
Функция СтрокиЖурнала(Знач Фрагмент)
	Найденные = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Хаб.Дамп(), Символы.ПС) Цикл
		Если СтрНайти(Строка_, Фрагмент) > 0 Тогда
			Найденные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Найденные, Символы.ПС);
КонецФункции
