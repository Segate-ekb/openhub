// Живой хаб с телеметрией против OTLP-приёмника: фоновая работа — разбор очереди доставок
// и обход зеркала — уезжает трассами и метриками. Протокол http/json: партия читается текстом.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;
Перем Клиент;
Перем Коллектор;
Перем Разбор;          // фикстура РазборOTLP — партии спанов и срезы метрик значениями
Перем КаталогСборки;
Перем ТокенRoot;
Перем ТрассыПростоя;   // трассы, уехавшие за окно простоя — снято ДО заказа фона
Перем ШаговПростоя;    // сколько шагов цикла доставщик сделал за то же окно

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("РазборOTLP");

	Разбор = Новый РазборOTLP();

	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-метрики-фона-ospx");

	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);
	Хаб.Поднять("openhub-метрики-фона", ОкружениеХаба(), "ЗасеятьКабинет.os");

	ТокенRoot = Клиент.ВыпуститьPAT(Клиент.Войти("root", "RootPassw0rd"));

	ПростоятьИСнятьУлики();

	ЗаказатьДоставкуВебхука();
	ЗаказатьОбходЗеркала();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;

	УникальныеИмена.УбратьВременное(КаталогСборки);

КонецПроцедуры

// Пустой шаг вечного цикла доставщика корня трассы не заводит, иначе в поиске по трассам
// утонуло бы всё остальное. Улики сняты до заказа фона: порядок тестов на сторож не влияет.
&Тест
Процедура ПустойШагДоставщикаКорняНеЗаводит() Экспорт

	// без отработанного окна «спанов нет» значило бы всего лишь «цикл не крутился»
	Ожидаем.Что(ШаговПростоя >= ШаговДляУлики(), СтрШаблон(
		"за окно простоя доставщик сделал не меньше %1 шагов цикла, а сделал %2",
		ШаговДляУлики(), ШаговПростоя)).ЭтоИстина();

	Спаны = Разбор.СпаныПартий(ТрассыПростоя);
	// пустая выборка доказывала бы разве что молчание коллектора
	Ожидаем.Что(Спаны.Количество() > 0,
		"за окно простоя трассы хаба уезжали — выборка сторожа не пуста").ЭтоИстина();

	Ожидаем.Что(Разбор.СпановСИменем(Спаны, ИмяСпанаПартии()), СтрШаблон(
		"на %1 пустых шагах цикла спанов ""%2"" не завелось ни одного",
		ШаговПростоя, ИмяСпанаПартии())).Равно(0);

КонецПроцедуры

// Доставка вебхука идёт под корнем своего шага разбора очереди. Родство сверяется ссылкой
// parentSpanId: соседями по партии спаны оказываются и без всякого родства.
&Тест
Процедура ДоставкаВебхукаИдётПодКорнемПартии() Экспорт

	Родство = ДождатьсяДоставкиПодПартией(ЖдатьСекунд());

	Ожидаем.Что(Родство, СтрШаблон(
		"среди уехавших спанов есть доставка ""%1"" с родителем ""%2""",
		ИмяСпанаДоставки(), ИмяСпанаПартии())).Заполнено();
	Ожидаем.Что(Родство.Доставка.Трасса,
		"доставка и партия ведут ОДНУ трассу").Равно(Родство.Партия.Трасса);

КонецПроцедуры

// По счётчику попыток видно, что очередь доставок действительно разбирается. Сверяется точка
// данных прибора: имя метрики встречается в партии и тогда, когда вызовов не было ни одного.
&Тест
Процедура СчётчикПопытокДоставкиУезжаетМетрикой() Экспорт

	Тело = Коллектор.ДождатьсяПартии("metrics", ИмяСчётчикаПопыток(), ЖдатьСекунд());

	Ожидаем.Что(ВызововСчётчика(Тело, ИмяСчётчикаПопыток()) >= 1, СтрШаблон(
		"у счётчика %1 есть точка данных с непустым числом попыток",
		ИмяСчётчикаПопыток())).ЭтоИстина();

КонецПроцедуры

// Цикл обхода зеркала меряется парой приборов: счётчик — «сколько порций хаб прогнал»,
// гистограмма — «сколько порция стоила».
&Тест
Процедура ЦиклСинхронизацииЗеркалаУезжаетСчётчикомИГистограммой() Экспорт

	Счётчики = Коллектор.ДождатьсяПартии("metrics", ИмяСчётчикаЦиклов(), ЖдатьСекунд());
	Ожидаем.Что(ВызововСчётчика(Счётчики, ИмяСчётчикаЦиклов()) >= 1, СтрШаблон(
		"у счётчика %1 есть точка данных с непустым числом циклов",
		ИмяСчётчикаЦиклов())).ЭтоИстина();

	Замеры = Коллектор.ДождатьсяПартии("metrics", ИмяГистограммыЦикла(), ЖдатьСекунд());
	Ожидаем.Что(ЗамеровГистограммы(Замеры, ИмяГистограммыЦикла()) >= 1, СтрШаблон(
		"у гистограммы %1 есть точка данных хотя бы с одним замером",
		ИмяГистограммыЦикла())).ЭтоИстина();

КонецПроцедуры

#Область Окружение

// Телеметрия в приёмник и ускоренные фоновые циклы.
Функция ОкружениеХаба()

	Окружение = Новый Соответствие();
	Окружение.Вставить("OTEL_ENABLED", "true");
	Окружение.Вставить("OTEL_SERVICE_NAME", "openhub-метрики-фона-тест");
	Окружение.Вставить("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Окружение.Вставить("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");

	// партия спанов раз в секунду и срез метрик раз в две вместо штатных 5 и 60
	Окружение.Вставить("OTEL_BSP_SCHEDULE_DELAY", "1000");
	Окружение.Вставить("OTEL_METRIC_EXPORT_INTERVAL", "2000");

	// очередь доставок — раз в секунду, мёртвая цель — не дольше двух
	Окружение.Вставить("OSHUB_WEBHOOKS_DELIVERY__INTERVAL__SEC", "1");
	Окружение.Вставить("OSHUB_WEBHOOKS_DELIVERY__TIMEOUT__SEC", "2");

	// шаги доставщика видны строками отладки — по ним считается окно простоя
	Окружение.Вставить("OSHUB_LOG_LEVEL", "DEBUG");

	Окружение.Вставить("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Окружение.Вставить("OSHUB_ADMIN_LOGIN", "");
	Окружение.Вставить("OSHUB_ADMIN_PASSWORD", "");

	Возврат Окружение;

КонецФункции

#КонецОбласти

#Область Имена

Функция ИмяСпанаПартии()
	Возврат "webhooks.batch";
КонецФункции

Функция ИмяСпанаДоставки()
	Возврат "webhook.deliver";
КонецФункции

Функция ИмяСчётчикаПопыток()
	Возврат "oshub.webhook.attempts";
КонецФункции

Функция ИмяСчётчикаЦиклов()
	Возврат "oshub.mirror.sync.cycles";
КонецФункции

Функция ИмяГистограммыЦикла()
	Возврат "oshub.mirror.sync.cycle.duration";
КонецФункции

// С запасом на медленную машину: разбор очереди идёт раз в секунду, срез метрик — раз в две.
Функция ЖдатьСекунд()
	Возврат 120;
КонецФункции

// Столько шагов цикла доказывают работающего доставщика; окно простоя кончается по ним, не по часам.
Функция ШаговДляУлики()
	Возврат 5;
КонецФункции

// Потолок ожидания шагов: на сломанном цикле сторож краснеет, а не висит.
Функция ПотолокПростояСекунд()
	Возврат 30;
КонецФункции

// Хвост окна: партия спанов уезжает раз в секунду, заведённое последними шагами успевает доехать.
Функция ВыгрузкиПартииСекунд()
	Возврат 2;
КонецФункции

// Строка отладки, которой доставщик отчитывается о каждом своём шаге.
Функция ПриметаШагаЦикла()
	Возврат "Доставщик подписок: шаг цикла";
КонецФункции

// Порт 1 отбивает соединение сразу; схема https — http хаб без allow_insecure не примет.
Функция МёртваяЦельВебхука()
	Возврат "https://127.0.0.1:1/hook-" + Строка(Новый УникальныйИдентификатор());
КонецФункции

// Апстрим зеркала там же и по той же причине.
Функция МёртвыйАпстрим()
	Возврат "http://127.0.0.1:1/download/";
КонецФункции

#КонецОбласти

#Область ЗаказРаботыФону

// Держит хаб в простое окно шагов доставщика и снимает улики окна: трассы и число шагов цикла.
Процедура ПростоятьИСнятьУлики()

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПотолокПростояСекунд() * 1000;

	Пока СтрЧислоВхождений(Хаб.Дамп(), ПриметаШагаЦикла()) < ШаговДляУлики()
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(200);
	КонецЦикла;

	// спан уезжает очередной партией, а не в момент своего конца
	Приостановить(ВыгрузкиПартииСекунд() * 1000);

	ТрассыПростоя = Коллектор.Принятое("traces");
	ШаговПростоя = СтрЧислоВхождений(Хаб.Дамп(), ПриметаШагаЦикла());

КонецПроцедуры

// Подписка и публикация: событие кладёт задание в очередь, разбирает её фоновый доставщик.
Процедура ЗаказатьДоставкуВебхука()

	Пул = ЗавестиПул("hooks");

	Подписка = СтрШаблон("{""тип"":""вебхук"",""url"":""%1"",""события"":[""версия.опубликована""]}",
		МёртваяЦельВебхука());
	Заведена = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/webhooks", Пул),
		Подписка, ТокенRoot);
	Ожидаем.Что(Заведена.КодСостояния,
		"подписка на вебхук заведена: " + Клиент.Тело(Заведена)).Равно(201);

	Пакет = Новый ФикстураПакета().ПостроитьOspx(КаталогСборки, "hookpkg", "1.0.0", "# hookpkg");
	Клиент.Опубликовать(Пул, Пакет, ТокенRoot, "stable");

КонецПроцедуры

// Заявка на синхронизацию: обход гоняет фоновый рабочий очереди, а не этот запрос.
Процедура ЗаказатьОбходЗеркала()

	Пул = ЗавестиПул("mirror");

	Заведено = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/mirrors", Пул),
		СтрШаблон("{""url"":""%1"",""интервал"":900}", МёртвыйАпстрим()), ТокенRoot);
	Ожидаем.Что(Заведено.КодСостояния,
		"зеркало заведено: " + Клиент.Тело(Заведено)).Равно(201);
	Ид = Формат(Клиент.ТелоJSON(Заведено).Получить("mirror").Получить("id"), "ЧГ=0; ЧН=0");

	Заявка = Клиент.ЗапросJSONСТокеном("POST",
		СтрШаблон("/api/v1/pools/%1/mirrors/%2/sync", Пул, Ид), "{}", ТокенRoot);
	Ожидаем.Что(Заявка.КодСостояния,
		"заявка на обход принята: " + Клиент.Тело(Заявка)).Равно(202);

КонецПроцедуры

Функция ЗавестиПул(Знач Примета)

	Имя = УникальныеИмена.Имя(Примета);
	Ответ = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя), ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);

	Возврат Имя;

КонецФункции

#КонецОбласти

#Область РазборТрасс

// Спан партии уезжает позже своих детей: читается всё принятое, пока родство не сойдётся.
Функция ДождатьсяДоставкиПодПартией(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл

		Родство = ДоставкаПодПартией(Разбор.СпаныПартий(Коллектор.Принятое("traces")));
		Если Родство <> Неопределено Тогда
			Возврат Родство;
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
		Приостановить(1000);

	КонецЦикла;

КонецФункции

// Пара «доставка и её партия» по ссылке parentSpanId; Неопределено — такой пары нет.
Функция ДоставкаПодПартией(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл

		Спан = Пара.Значение;
		Если Спан.Имя <> ИмяСпанаДоставки() Тогда
			Продолжить;
		КонецЕсли;

		Родитель = Спаны.Получить(Спан.Родитель);
		Если Родитель <> Неопределено И Родитель.Имя = ИмяСпанаПартии() Тогда
			Возврат Новый Структура("Доставка, Партия", Спан, Родитель);
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область РазборМетрик

// Наибольший накопительный срез счётчика — сумма точек всех исходов; -1 — прибора в партиях нет.
Функция ВызововСчётчика(Знач Тело, Знач ИмяПрибора)

	Наибольшее = -1;

	Для Каждого Прибор Из Разбор.СнимкиПрибора(Тело, ИмяПрибора) Цикл
		Вызовов = 0;
		Для Каждого Точка Из Разбор.ТочкиАгрегации(Прибор, "sum") Цикл
			Вызовов = Вызовов + Разбор.ЧислоТочки(Точка, "asInt")
				+ Разбор.ЧислоТочки(Точка, "asDouble");
		КонецЦикла;
		Наибольшее = Макс(Наибольшее, Вызовов);
	КонецЦикла;

	Возврат Наибольшее;

КонецФункции

// Наибольшее число замеров в срезе гистограммы — сумма count её точек; -1 — прибора нет.
Функция ЗамеровГистограммы(Знач Тело, Знач ИмяПрибора)

	Наибольшее = -1;

	Для Каждого Прибор Из Разбор.СнимкиПрибора(Тело, ИмяПрибора) Цикл
		Замеров = 0;
		Для Каждого Точка Из Разбор.ТочкиАгрегации(Прибор, "histogram") Цикл
			Замеров = Замеров + Разбор.ЧислоТочки(Точка, "count");
		КонецЦикла;
		Наибольшее = Макс(Наибольшее, Замеров);
	КонецЦикла;

	Возврат Наибольшее;

КонецФункции

#КонецОбласти
