// Живой хаб с включённой телеметрией и заведомо мёртвым коллектором: включённость едет строкой
// из окружения, а спаны родятся только на настоящем запросе.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;              // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем ВыдачаПортов;     // фикстура ВыдачаПортов — порт под коллектор берётся у ОС
Перем ПортМёртвогоКоллектора;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабСТелеметрией() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ВыдачаПортов");

	// порт у выдачи без слушателя: угаданный номер мог оказаться занят чужим процессом
	ВыдачаПортов = Новый ВыдачаПортов();
	ПортМёртвогоКоллектора = ВыдачаПортов.Выдать();

	Окружение = ОкружениеТелеметрии("openhub-живой-тест", ПортМёртвогоКоллектора);
	Окружение.Вставить("OTEL_EXPORTER_OTLP_HEADERS", "Authorization=Bearer " + СекретКоллектора());

	Хаб = Новый ЭкземплярХаба();
	Хаб.Поднять("openhub-отел-живой", Окружение);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Если ВыдачаПортов <> Неопределено Тогда
		ВыдачаПортов.ВернутьВсе();
	КонецЕсли;

КонецПроцедуры

// Спан, дошедший до экспорта, доказывает цепочку разом: настройки → напильник winow → SDK → экспорт.
// Признак — путь /v1/traces в тексте ошибки SDK: сменит SDK формулировку — тест повиснет до таймаута,
// и читать такой отказ надо как «сигнал устарел», а не «телеметрия сломана».
&Тест
Процедура ЗапросРождаетСпанИКонвейерДоходитДоЭкспорта() Экспорт

	Ожидаем.Что(ОтветНаЗдоровье("").КодСостояния, "хаб отвечает при включённой телеметрии").Равно(200);

	// отказ соединения мёртвого коллектора — значит спаны до него дошли
	Хаб.ДождатьсяСтрокиЖурнала("/v1/traces", 60);

КонецПроцедуры

// Входящий traceparent — чужой ввод на горячем пути: хаб отвечает верно и на валидный,
// и на заведомо мусорный.
&Тест
Процедура ВходящийTraceparentНеМешаетОтвету() Экспорт

	Валидный = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
	Ожидаем.Что(ОтветНаЗдоровье(Валидный).КодСостояния,
		"запрос с валидным traceparent обслужен").Равно(200);

	// мусор только ASCII: не-ASCII заголовок отвергает ещё клиент, до хаба он не доедет
	Ожидаем.Что(ОтветНаЗдоровье("not-a-traceparent").КодСостояния,
		"запрос с мусорным traceparent обслужен, а не отвергнут").Равно(200);

	Ожидаем.Что(ОтветНаЗдоровье("00-" + Сверхдлинный()).КодСостояния,
		"сверхдлинный traceparent не роняет запрос").Равно(200);

КонецПроцедуры

// Секрет коллектора живёт только в окружении: в журнале хаба, уже сходившего к коллектору
// и получившего отказ, его нет. Признак похода — тот же /v1/traces, что и выше.
&Тест
Процедура СекретКоллектораВЖурналеЖивогоХабаНеПоявляется() Экспорт

	Хаб.ДождатьсяСтрокиЖурнала("/v1/traces", 60);

	Ожидаем.Что(СтрНайти(Хаб.Дамп(), СекретКоллектора()),
		"секрет коллектора в журнале живого хаба").Равно(0);

КонецПроцедуры

// Имя сэмплера даёт умолчание загрузки настроек, а не поставочный файл, который оператор
// монтирует поверх. Снаружи это видно одним способом: доля 0.0 отсекает всё, а без умолчания
// SDK взял бы ParentBased(AlwaysOn) и долю проигнорировал.
&Тест
Процедура ДоляНольОтсекаетТрассыБезИмениСэмплераВОкружении() Экспорт

	// имя сэмплера не задаём: его обязано дать умолчание загрузки настроек
	Окружение = ОкружениеТелеметрии("openhub-доля-ноль", ВыдачаПортов.Выдать());
	Окружение.Вставить("OTEL_TRACES_SAMPLER_ARG", "0.0");

	Второй = Новый ЭкземплярХаба();

	Попытка
		Второй.Поднять("openhub-отел-доля", Окружение);

		// положительный контроль: хаб обслуживает запросы, спанам было из чего родиться
		Для Счёт = 1 По 5 Цикл
			Запрос = Новый HTTPЗапрос("/health");
			Ожидаем.Что(Второй.Соединение().Получить(Запрос).КодСостояния,
				"хаб с нулевой долей обслуживает запросы").Равно(200);
		КонецЦикла;

		// заведомо дольше партии (5 с): при работающем умолчании /v1/traces не появится никогда
		ПодождатьПартии(15);

		Ожидаем.Что(СтрНайти(Второй.Дамп(), "/v1/traces"),
			"при доле 0.0 трассы не уезжают — значит инъекция сэмплера на месте").Равно(0);
	Исключение
		Второй.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Второй.Остановить();

КонецПроцедуры

#Область Служебное

// Телеметрия включена строками, как их приносит окружение инсталляции; коллектор — по порту.
Функция ОкружениеТелеметрии(Знач ИмяСлужбы, Знач ПортКоллектора)

	Окружение = Новый Соответствие();
	Окружение.Вставить("OTEL_ENABLED", "true");
	Окружение.Вставить("OTEL_SERVICE_NAME", ИмяСлужбы);
	Окружение.Вставить("OTEL_EXPORTER_OTLP_ENDPOINT", "http://127.0.0.1:" + Формат(ПортКоллектора, "ЧГ=0"));

	Возврат Окружение;

КонецФункции

Функция СекретКоллектора()
	Возврат "SEKRET-ЖИВОЙ-XYZ";
КонецФункции

// Ожидание партии фонового экспорта: своего сигнала «партия ушла» снаружи нет.
Процедура ПодождатьПартии(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(500);
	КонецЦикла;

КонецПроцедуры

Функция Сверхдлинный()

	Буква = "a";
	Пока СтрДлина(Буква) < 4000 Цикл
		Буква = Буква + Буква;
	КонецЦикла;

	Возврат Буква;

КонецФункции

Функция ОтветНаЗдоровье(Знач Traceparent)

	Запрос = Новый HTTPЗапрос("/health");
	Если ЗначениеЗаполнено(Traceparent) Тогда
		Запрос.Заголовки.Вставить("traceparent", Traceparent);
	КонецЕсли;

	Возврат Хаб.Соединение().Получить(Запрос);

КонецФункции

#КонецОбласти
