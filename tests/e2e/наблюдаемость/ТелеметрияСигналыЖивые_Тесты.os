// Живой хаб с телеметрией против OTLP-приёмника: все три сигнала уезжают по сети, строка журнала
// несёт идентификатор трассы своего запроса. Протокол http/json: партия читается текстом.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;
Перем Коллектор;
Перем Разбор;   // фикстура РазборOTLP — партии спанов и срезы метрик значениями

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");
	РеестрФикстур.Подключить("РазборOTLP");

	Разбор = Новый РазборOTLP();
	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	// засев пулами и пакетами: на пустом реестре сверка приборов с API была бы сверкой нуля с нулём
	Хаб = Новый ЭкземплярХаба();
	Хаб.Поднять("openhub-отел-сигналы", ОкружениеХаба(), "ЗасеятьХаб.os");

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;

КонецПроцедуры

// Журнал хаба уезжает OTLP-логами.
&Тест
Процедура ЖурналХабаУезжаетOTLPЛогами() Экспорт

	// ждём сразу нужную строку: партии уходят по расписанию, и первая могла её не нести
	Тело = Коллектор.ДождатьсяПартии("logs", "Стартовые задачи завершены");

	Ожидаем.Что(СтрНайти(Тело, "resourceLogs") > 0, "это OTLP-тело логов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "openhub-сигналы-тест") > 0,
		"в партии логов имя службы этой инсталляции").ЭтоИстина();

КонецПроцедуры

// Журнал аудита пишется только в свой файл: его JSON в коллектор не уходит, а строка предмета
// о той же правке — уходит. Правка — замок адреса после неудачных входов: её пишет и аудит,
// и служба входа.
&Тест
Процедура ЗаписьАудитаНеУходитВКоллектор() Экспорт

	РеестрФикстур.Подключить("КлиентХаба");
	Клиент = Новый КлиентХаба(Хаб, 15);
	Для НомерВхода = 1 По 6 Цикл
		Клиент.Войти("nobody-" + Формат(НомерВхода, "ЧГ=0"), "wrong-password");
	КонецЦикла;

	Коллектор.ДождатьсяПартии("logs", "заперт до");
	Хаб.ДождатьсяСтрокиЖурнала("заперт до", 30);

	Ожидаем.Что(СтрНайти(Коллектор.Принятое("logs"), "действие"),
		"JSON журнала аудита в коллекторе нет").Равно(0);
	Ожидаем.Что(СтрНайти(Хаб.Дамп(), "действие"), "и в консоли хаба нет").Равно(0);

КонецПроцедуры

// Строка журнала сшита со своей трассой общим идентификатором — по нему собирается переход
// «трасса ↔ логи». Идентификатор из живой партии логов обязан найтись в живой партии трасс.
&Тест
Процедура СтрокаЖурналаСшиваетсяСоСвоейТрассой() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	ИдТрассы = ДождатьсяСшитойСтроки(90);
	Ожидаем.Что(ЗначениеЗаполнено(ИдТрассы),
		"в уехавших логах нашлась строка с непустым traceId").ЭтоИстина();

	Трассы = Коллектор.ДождатьсяПартии("traces", ИдТрассы);
	Ожидаем.Что(СтрНайти(Трассы, ИдТрассы) > 0,
		СтрШаблон("трасса %1 из строки журнала нашлась среди уехавших спанов", ИдТрассы)).ЭтоИстина();

КонецПроцедуры

// Фоновая задача — единственная работа хаба, у которой нет своего запроса: серверный спан
// ей не от кого унаследовать, и заводит его аннотация на Исполнить(). Имя сверяется
// буквально: по нему сшиты панели наблюдаемости и разбор «трасса ↔ логи».
&Тест
Процедура ФоноваяЗадачаИдётПодСвоимСпаном() Экспорт

	Партия = Коллектор.ДождатьсяПартии("traces", ИмяСпанаЗдоровьяИсточников());
	Спаны = Разбор.СпаныПартий(Партия);

	// сверяется имя разобранного спана: подстрока нашлась бы и в атрибуте, и в чужом спане
	Ожидаем.Что(Разбор.СпанСИменем(Спаны, ИмяСпанаЗдоровьяИсточников()),
		СтрШаблон("среди уехавших спанов есть спан фоновой задачи ""%1""",
			ИмяСпанаЗдоровьяИсточников())).Заполнено();

КонецПроцедуры

// Публикация доменного события идёт под своим спаном, и тип события лежит атрибутом: без него
// спаны всех публикаций в трассе неразличимы. Скачивание артефакта публикует своё событие.
&Тест
Процедура ПубликацияСобытияИдётПодСвоимСпаномСТипом() Экспорт

	Ожидаем.Что(ОтветНаФайлПакета().КодСостояния, "артефакт отдан — событие опубликовано").Равно(200);

	// ждём своё событие, а не любое: публикацию под тем же именем спана дают и соседние тесты
	Партия = Коллектор.ДождатьсяПартии("traces", ТипСобытияСкачивания());
	Спаны = Разбор.СпаныПартий(Партия);

	Ожидаем.Что(Разбор.СпанСАтрибутом(Спаны, "oshub.event.type", ТипСобытияСкачивания()),
		СтрШаблон("спан ""%1"" несёт тип события атрибутом", ИмяСпанаПубликацииСобытия())).Заполнено();

КонецПроцедуры

// Под телеметрией обработчик доставки приезжает сгенерированным декоратором, а реестр действий
// подписок спрашивает его методы рефлексией: потеряй декоратор метод «Проба» — кнопка пробы
// и признак testable в справочнике API пропали бы молча.
&Тест
Процедура ПробаВебхукаОстаётсяДоступнойПодДекоратором() Экспорт

	Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос("/api/v1/webhook-meta"));
	Ожидаем.Что(Ответ.КодСостояния, "справочник подписок отвечает").Равно(200);

	Вид = ВидДействияСправочника(Ответ.ПолучитьТелоКакСтроку(), ВидДействияВебхук());
	Ожидаем.Что(Вид, СтрШаблон("в справочнике есть вид действия «%1»", ВидДействияВебхук())).Заполнено();
	Ожидаем.Что(Вид["testable"], "проба вебхука доступна под декоратором").ЭтоИстина();

КонецПроцедуры

// Метрики точек маршрута уезжают, только если провайдер метрик собран и читатель запущен;
// имя прибора выведено из имени желудя и метода транслитерацией.
&Тест
Процедура МетрикиТочекМаршрутаУезжаютOTLP() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	Тело = Коллектор.ДождатьсяПартии("metrics", "kontroller_zdorovya.zdorove.duration");

	Ожидаем.Что(СтрНайти(Тело, "kontroller_zdorovya.zdorove.counted") > 0,
		"вместе с длительностью уехал и счётчик вызовов точки маршрута").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "openhub-сигналы-тест") > 0,
		"в партии метрик имя службы этой инсталляции").ЭтоИстина();

КонецПроцедуры

// Доменные приборы хаба: те же числа, что отдаёт /api/v1/metrics, снимаются метрикой
// по расписанию. Наблюдаемый датчик спрашивает значение сам — на горячем пути их нет.
&Тест
Процедура ЧислаРеестраУезжаютПриборамиХаба() Экспорт

	Тело = Коллектор.ДождатьсяПартии("metrics", "oshub.pools");

	Ожидаем.Что(СтрНайти(Тело, "oshub.packages") > 0,
		"вместе с пулами уехали и пакеты").ЭтоИстина();

	// приборы и /api/v1/metrics обязаны рассказывать о хабе одно и то же
	ПулыПрибора = Разбор.ЗначениеИзПрибора(Тело, "oshub.pools");
	Ожидаем.Что(ПулыПрибора > 0, "значение прибора прочиталось и оно не пустое").ЭтоИстина();
	Ожидаем.Что(ПулыПрибора,
		"публичных пулов у прибора столько же, сколько у /api/v1/metrics").Равно(
			ЧислоИзМетрикAPI("pools_total"));

КонецПроцедуры

// Работу с базой инструментируют библиотеки без кода хаба: операции менеджера сущностей
// и запросы коннектора уезжают спанами и гистограммами.
&Тест
Процедура ОбращенияКБазеУезжаютМетрикамиИСпанами() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	Тело = Коллектор.ДождатьсяПартии("metrics", "db.client.operation.duration");
	Ожидаем.Что(СтрНайти(Тело, "entity.operation.duration") > 0,
		"рядом с длительностью запроса уехала длительность операции менеджера").ЭтоИстина();

	Трассы = Коллектор.ДождатьсяПартии("traces", "entity.type");
	Ожидаем.Что(СтрНайти(Трассы, "db.system.name") > 0,
		"в трассах есть и спан запроса к СУБД, а не только спан операции").ЭтоИстина();

КонецПроцедуры

// Вызовы хранилищ сущностей меряет второй механизм — напильник слоя хранилищ, со своей
// ручкой otel.entity.repository.enabled. Без него в трассе видно, ЧТО хаб спросил
// у базы, но не видно, сколько стоил вызов самого хранилища.
&Тест
Процедура ВызовыХранилищМеряютсяГистограммой() Экспорт

	Для Счёт = 1 По 5 Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает").Равно(200);
	КонецЦикла;

	Тело = Коллектор.ДождатьсяПартии("metrics", "entity.repository.invocation.duration");
	Ожидаем.Что(СтрНайти(Тело, "entity.repository") > 0,
		"гистограмма вызовов помечена именем хранилища").ЭтоИстина();

КонецПроцедуры

// Трасса запроса связна сверху донизу: маршрут winow, служба, операция менеджера сущностей
// и запрос к СУБД (на промахе кэша) — звенья одной цепи родителей по parentSpanId, а не четыре
// спана, случайно оказавшиеся в одной партии.
&Тест
Процедура ТрассаЗапросаСшитаОтМаршрутаЧерезСлужбуДоБазы() Экспорт

	Ожидаем.Что(ОтветНаФайлПакета().КодСостояния, "файл пакета выдан").Равно(200);

	Цепочка = ДождатьсяЦепочкиВыдачи(90);
	Имена = ИменаЦепочки(Цепочка);

	ЗапросКСУБД = 0;
	ОперацияEntity = ИндексПоАтрибуту(Цепочка, "entity.type");
	СпанСлужбыПакетов = ИндексПоИмени(Цепочка, ИмяСпанаПоискаПакета());
	СпанРезолвера = ИндексПоИмени(Цепочка, ИмяСпанаРезолва());
	СпанМаршрута = ИндексПоАтрибуту(Цепочка, "http.route");

	Ожидаем.Что(ОперацияEntity > ЗапросКСУБД,
		СтрШаблон("над запросом к СУБД стоит спан операции entity; цепочка: %1", Имена)).ЭтоИстина();
	Ожидаем.Что(СпанСлужбыПакетов > ОперацияEntity,
		СтрШаблон("над операцией entity стоит спан службы пакетов; цепочка: %1", Имена)).ЭтоИстина();
	Ожидаем.Что(СпанРезолвера > СпанСлужбыПакетов,
		СтрШаблон("над службой пакетов стоит спан резолвера выдачи; цепочка: %1", Имена)).ЭтоИстина();
	Ожидаем.Что(СпанМаршрута > СпанРезолвера,
		СтрШаблон("над резолвером выдачи стоит серверный спан маршрута; цепочка: %1", Имена)).ЭтоИстина();

	Ожидаем.Что(Цепочка[СпанСлужбыПакетов].Атрибуты["oshub.package"],
		"спан службы назвал пакет, который искал").Равно(ИмяПакетаСида());
	Ожидаем.Что(Цепочка[СпанРезолвера].Атрибуты["oshub.package"],
		"спан резолва назвал пакет, который выдавал").Равно(ИмяПакетаСида());

КонецПроцедуры

// Контекст трассировки принадлежит запросу, а не процессу: перемешайся стеки — спан службы уехал
// бы в трассу соседнего запроса. Видно это только на перекрытии, поэтому первое утверждение —
// про саму волну: у серверных спанов всех запросов есть общий отрезок жизни.
&Тест
Процедура ПараллельныеЗапросыВедутКаждыйСвоюТрассу() Экспорт

	Волна = ВолнаПроб();
	СпроситьВолнойПараллельно(Волна);

	Спаны = ДождатьсяСпановВолны(Волна, 90);
	Маршруты = СерверныеСпаныВолны(Спаны, Волна);

	ПозднийСтарт = Крайний(Маршруты, "Начало", Истина);
	РаннийКонец = Крайний(Маршруты, "Конец", Ложь);
	Ожидаем.Что(ПозднийСтарт < РаннийКонец,
		СтрШаблон("все %1 запросов волны были в обработке одновременно; общий отрезок %2 мс",
			Волна.Количество(), Миллисекунды(РаннийКонец - ПозднийСтарт))).ЭтоИстина();

	Для Индекс = 0 По Волна.ВГраница() Цикл
		Проба = Волна[Индекс];

		СпанСлужбы = СпанПробы(Спаны, Проба);
		Ожидаем.Что(СпанСлужбы.Трасса,
			СтрШаблон("спан службы пакетов для %1 остался в трассе своего запроса", Проба.Пакет))
			.Равно(Проба.Трасса);

		Ожидаем.Что(Маршруты[Индекс].Атрибуты["url.path"],
			СтрШаблон("над спаном службы для %1 стоит серверный спан его же запроса", Проба.Пакет))
			.Равно(АдресПробы(Проба.Пакет));
	КонецЦикла;

КонецПроцедуры

// Под телеметрией желуди служб приезжают декораторами, а остальные наборы гоняют хаб без неё:
// страховка «декоратор не сломал желудь» живёт здесь, на живых путях хаба.
&Тест
Процедура ОсновныеПутиХабаЖивутПодДекораторами() Экспорт

	Для Каждого Путь Из ПутиПодДекораторами() Цикл
		Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос(Путь.Адрес));
		Ожидаем.Что(Ответ.КодСостояния,
			СтрШаблон("%1 отвечает под декораторами", Путь.Название)).Равно(200);
		Ожидаем.Что(СтрНайти(Ответ.ПолучитьТелоКакСтроку(), Путь.Примета) > 0,
			СтрШаблон("%1 отдал своё содержимое, а не пустой ответ", Путь.Название)).ЭтоИстина();
	КонецЦикла;

	Артефакт = ОтветНаФайлПакета();
	Ожидаем.Что(Артефакт.КодСостояния, "выдача файла пакета отвечает").Равно(200);
	Ожидаем.Что(Артефакт.ПолучитьТелоКакДвоичныеДанные().Размер() > 0,
		"выдача файла пакета отдала непустой артефакт").ЭтоИстина();

КонецПроцедуры

// Один вызов — один спан: вложение в спан того же имени читается как «метод позвал сам себя».
// Имя родителя берётся по parentSpanId на разобранных спанах.
&Тест
Процедура НиОдинСпанНеВложенВОдноимённыйСпан() Экспорт

	Ожидаем.Что(ДождатьсяЦепочкиВыдачи(90).Количество() > 0,
		"цепочка выдачи уехала — спанов накопилось достаточно").ЭтоИстина();

	Спаны = Разбор.СпаныПартий(Коллектор.Принятое("traces"));
	Ожидаем.Что(Спаны.Количество() > 0, "уехавшие спаны разобраны").ЭтоИстина();

	Ожидаем.Что(ВложениеВОдноимённого(Спаны),
		"ни один спан не вложен в спан того же имени").Равно("");

КонецПроцедуры

// Спан службы называет, чем занимался: без приметы трасса выдачи — одинаковые «нашёл версию»
// без имени и номера. Сверяется значение атрибута на разобранном спане.
&Тест
Процедура СпанПоискаВерсииНазываетВерсиюВыдачи() Экспорт

	Ожидаем.Что(ОтветНаФайлПакета().КодСостояния, "файл пакета выдан").Равно(200);

	Спан = ДождатьсяСпанаПоискаВерсии(90);
	Ожидаем.Что(Спан.Атрибуты["oshub.version"],
		СтрШаблон("спан ""%1"" назвал версию, которую искал", ИмяСпанаПоискаВерсии()))
		.Равно(ВерсияПакетаСида());

КонецПроцедуры

// Поток логов живёт, а не выдыхается первой партией. Партии считаются по числу принятых POST;
// наблюдение идёт последним в наборе, когда хаб работает уже несколько минут.
&Тест
Процедура ПотокЛоговНеВыдыхаетсяПослеПервойПартии() Экспорт

	Было = Коллектор.ЧислоПартий("logs");

	// Хаб под нагрузкой всё время наблюдения: тишина не спишется на «нечего слать».
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 60 * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Ожидаем.Что(ОтветНаЗдоровье().КодСостояния, "хаб отвечает всё время наблюдения").Равно(200);
		Если Коллектор.ЧислоПартий("logs") >= Было + ПартийДляЖивогоПотока() Тогда
			Прервать;
		КонецЕсли;
		Приостановить(1000);
	КонецЦикла;

	Стало = Коллектор.ЧислоПартий("logs");
	Ожидаем.Что(Стало >= Было + ПартийДляЖивогоПотока(),
		СтрШаблон("за минуту работы партий логов стало %1 против %2 — поток жив",
			Стало, Было)).ЭтоИстина();

КонецПроцедуры

// Инсталляция с выключенной телеметрией коллектора не трогает вовсе. Мост журнала — вторая дверь
// к SDK, подключён он всегда и закрыт только флагом: проверить это можно лишь тишиной в сети.
&Тест
Процедура ВыключеннаяТелеметрияКоллекторуНичегоНеШлёт() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OTEL_ENABLED", "false");
	Окружение.Вставить("OTEL_SERVICE_NAME", ИмяМолчуна());
	Окружение.Вставить("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Окружение.Вставить("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	Окружение.Вставить("OSHUB_LOG_LEVEL", "DEBUG");

	Молчун = Новый ЭкземплярХаба();

	Попытка
		Молчун.Поднять("openhub-отел-молчун", Окружение);

		Для Счёт = 1 По 5 Цикл
			Запрос = Новый HTTPЗапрос("/health");
			Ожидаем.Что(Молчун.Соединение().Получить(Запрос).КодСостояния,
				"хаб без телеметрии обслуживает запросы").Равно(200);
		КонецЦикла;

		// Заведомо дольше партии логов (1 с) и среза метрик (2 с) соседнего хаба.
		Приостановить(10000);

		Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
			Ожидаем.Что(СтрНайти(Коллектор.Принятое(Сигнал), ИмяМолчуна()),
				СтрШаблон("выключенная телеметрия не прислала сигнал %1", Сигнал)).Равно(0);
		КонецЦикла;
	Исключение
		Молчун.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Молчун.Остановить();

КонецПроцедуры

#Область Служебное

// Телеметрия в приёмник, ускоренные партии и частый обход здоровья источников.
Функция ОкружениеХаба()

	Окружение = Новый Соответствие();
	Окружение.Вставить("OTEL_ENABLED", "true");
	Окружение.Вставить("OTEL_SERVICE_NAME", "openhub-сигналы-тест");
	Окружение.Вставить("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Окружение.Вставить("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");

	// партия спанов раз в секунду и срез метрик раз в две вместо штатных 5 и 60
	Окружение.Вставить("OTEL_BSP_SCHEDULE_DELAY", "1000");
	Окружение.Вставить("OTEL_METRIC_EXPORT_INTERVAL", "2000");

	// строку журнала с traceId пишет работа внутри спана: фоновая задача на уровне отладки
	Окружение.Вставить("OSHUB_LOG_LEVEL", "DEBUG");
	Окружение.Вставить("OSHUB_JOBS_TICK__INTERVAL__MS", "500");
	Окружение.Вставить("OSHUB_JOBS_UPSTREAM__HEALTH__INTERVAL__SEC", "2");

	// секундный срок кэша в памяти спускает повторную выдачу в базу: «маршрут — служба — база»
	Окружение.Вставить("OSHUB_CACHE_MEMORY_TTL__SEC", "1");

	// ключей otel.entity.* нет намеренно: сигналы базы обязаны наследовать одну настройку включения

	Возврат Окружение;

КонецФункции

Функция ИмяМолчуна()
	Возврат "openhub-выключенная-телеметрия";
КонецФункции

// Пул, пакет и версия засева: страницы, API и выдача спрашиваются об одном и том же.
Функция ИмяПулаСида()
	Возврат "main";
КонецФункции

Функция ИмяПакетаСида()
	Возврат "winow";
КонецФункции

Функция ВерсияПакетаСида()
	Возврат "1.1.0";
КонецФункции

// Пул выдача берёт гвардом до резолвера, поэтому под резолвером в базу спускается пакет.
Функция ИмяСпанаПоискаПакета()
	Возврат "СервисПакетов.ПакетДляЧтения";
КонецФункции

Функция ИмяСпанаРезолва()
	Возврат "РезолверВыдачи.РазрешитьФайл";
КонецФункции

Функция ИмяСпанаПоискаВерсии()
	Возврат "СервисВерсий.НайтиВерсиюДляЧтения";
КонецФункции

// Обход здоровья источников ходит чаще всех: интервал ему задаёт окружение набора.
Функция ИмяСпанаЗдоровьяИсточников()
	Возврат "job.upstream_health";
КонецФункции

Функция ИмяСпанаПубликацииСобытия()
	Возврат "events.publish";
КонецФункции

// Скачивание артефакта — единственное событие, которое живой набор порождает сам.
Функция ТипСобытияСкачивания()
	Возврат "скачивание.зафиксировано";
КонецФункции

Функция ВидДействияВебхук()
	Возврат "вебхук";
КонецФункции

// Описание вида действия из справочника GET /api/v1/webhook-meta; Неопределено — вида нет.
Функция ВидДействияСправочника(Знач Тело, Знач Вид)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Справочник = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Для Каждого Описание Из Справочник["kinds"] Цикл
		Если Описание["kind"] = Вид Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ОтветНаФайлПакета()

	Адрес = СтрШаблон("/api/v1/pools/%1/download/%2/%2-%3.ospx",
		ИмяПулаСида(), ИмяПакетаСида(), ВерсияПакетаСида());

	Возврат Хаб.Соединение().Получить(Новый HTTPЗапрос(Адрес));

КонецФункции

// Живые пути хаба: адрес, название для отказа и примета содержательного ответа.
Функция ПутиПодДекораторами()

	Пул = ИмяПулаСида();
	Пакет = ИмяПакетаСида();

	Результат = Новый Массив();
	Результат.Добавить(Путь("главная", "/", "</html>"));
	Результат.Добавить(Путь("страница пула", "/pools/" + Пул, "</html>"));
	Результат.Добавить(Путь("страница пакета", "/pools/" + Пул + "/packages/" + Пакет, "</html>"));
	Результат.Добавить(Путь("страница входа", "/login", "</html>"));
	Результат.Добавить(Путь("список пакетов пула",
		СтрШаблон("/api/v1/pools/%1/packages", Пул), Пакет));
	Результат.Добавить(Путь("список версий пакета",
		СтрШаблон("/api/v1/pools/%1/packages/%2/versions", Пул, Пакет), ВерсияПакетаСида()));

	Возврат Результат;

КонецФункции

Функция Путь(Знач Название, Знач Адрес, Знач Примета)
	Возврат Новый Структура("Название, Адрес, Примета", Название, Адрес, Примета);
КонецФункции

// Волна запросов: свой traceparent и несуществующий пакет — атрибут спана ставится до поиска.
Функция ВолнаПроб()

	Метка = Лев(БезДефисов(Новый УникальныйИдентификатор()), 8);

	Результат = Новый Массив();
	Для Номер = 1 По ЗапросовВВолне() Цикл
		Результат.Добавить(Новый Структура("Пакет, Трасса",
			СтрШаблон("proba-%1-%2", Метка, Номер), БезДефисов(Новый УникальныйИдентификатор())));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько запросов уходит в хаб одновременно.
Функция ЗапросовВВолне()
	Возврат 8;
КонецФункции

// Идентификатор трассы — 32 шестнадцатеричных знака, ровно столько даёт УИД без дефисов.
Функция БезДефисов(Знач Идентификатор)
	Возврат НРег(СтрЗаменить(Строка(Идентификатор), "-", ""));
КонецФункции

Функция АдресПробы(Знач ИмяПакета)
	Возврат СтрШаблон("/api/v1/pools/%1/packages/%2/versions", ИмяПулаСида(), ИмяПакета);
КонецФункции

Процедура СпроситьВолнойПараллельно(Знач Волна)

	Задания = Новый Массив();

	Для Каждого Проба Из Волна Цикл
		Параметры = Новый Массив();
		Параметры.Добавить(Проба.Пакет);
		Параметры.Добавить(Проба.Трасса);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СпроситьПробу", Параметры));
	КонецЦикла;

	ФоновыеЗадания.ОжидатьВсе(Задания);

КонецПроцедуры

// Точка входа фонового задания волны: один запрос под своим traceparent.
//
// Параметры:
//  ИмяПакета - Строка - имя несуществующего пакета, узнаваемое в спане службы.
//  ИдТрассы - Строка - идентификатор трассы этого запроса.
//
Процедура СпроситьПробу(Знач ИмяПакета, Знач ИдТрассы) Экспорт

	Запрос = Новый HTTPЗапрос(АдресПробы(ИмяПакета));
	Запрос.Заголовки.Вставить("traceparent",
		СтрШаблон("00-%1-%2-01", ИдТрассы, Лев(ИдТрассы, 16)));

	Хаб.Соединение().Получить(Запрос);

КонецПроцедуры

// Ждёт только присутствия спанов волны: перемешанный контекст уводит спан в чужую трассу, а не теряет.
Функция ДождатьсяСпановВолны(Знач Волна, Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл
		Спаны = Разбор.СпаныПартий(Коллектор.Принятое("traces"));
		Если ВолнаСобралась(Спаны, Волна) Тогда
			Возврат Спаны;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			ВызватьИсключение СтрШаблон(
				"За %1 с в уехавших трассах собрались спаны не всех %2 запросов волны",
				Секунд, Волна.Количество());
		КонецЕсли;
		Приостановить(1000);
	КонецЦикла;

КонецФункции

Функция ВолнаСобралась(Знач Спаны, Знач Волна)

	Для Каждого Проба Из Волна Цикл
		Спан = Разбор.СпанСАтрибутом(Спаны, "oshub.package", Проба.Пакет);
		Если Спан = Неопределено
			ИЛИ ПредокСАтрибутом(Спаны, Спан, "http.route") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Серверные спаны волны в порядке проб — предки спанов службы каждой пробы.
Функция СерверныеСпаныВолны(Знач Спаны, Знач Волна)

	Результат = Новый Массив();
	Для Каждого Проба Из Волна Цикл
		Результат.Добавить(СерверныйПредок(Спаны, СпанПробы(Спаны, Проба)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Самое позднее либо самое раннее значение поля по набору спанов.
Функция Крайний(Знач Спаны, Знач Поле, Знач Наибольшее)

	Результат = Спаны[0][Поле];

	Для Каждого Спан Из Спаны Цикл
		Если ?(Наибольшее, Спан[Поле] > Результат, Спан[Поле] < Результат) Тогда
			Результат = Спан[Поле];
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Миллисекунды(Знач Наносекунд)
	Возврат Окр(Наносекунд / 1000000, 1);
КонецФункции

Функция СпанПробы(Знач Спаны, Знач Проба)

	Спан = Разбор.СпанСАтрибутом(Спаны, "oshub.package", Проба.Пакет);
	Ожидаем.Что(Спан, СтрШаблон("спан службы пакетов для %1 уехал", Проба.Пакет)).Заполнено();

	Возврат Спан;

КонецФункции

Функция СерверныйПредок(Знач Спаны, Знач Спан)

	Предок = ПредокСАтрибутом(Спаны, Спан, "http.route");
	Ожидаем.Что(Предок, СтрШаблон("у спана %1 есть серверный предок", Спан.Имя)).Заполнено();

	Возврат Предок;

КонецФункции

// Ближайший предок спана, несущий указанный атрибут: подъём идёт по ссылкам на родителя.
Функция ПредокСАтрибутом(Знач Спаны, Знач Спан, Знач Ключ)

	Цепочка = ЦепочкаККорню(Спаны, Спан);
	Индекс = ИндексПоАтрибуту(Цепочка, Ключ);

	Возврат ?(Индекс < 0, Неопределено, Цепочка[Индекс]);

КонецФункции

// Первое вложение спана в спан того же имени; "" — такого нет (не уехавший родитель не в счёт).
Функция ВложениеВОдноимённого(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл
		Родитель = Спаны[Пара.Значение.Родитель];
		Если Родитель <> Неопределено И Родитель.Имя = Пара.Значение.Имя Тогда
			Возврат СтрШаблон("%1 (спан %2 вложен в спан %3)",
				Пара.Значение.Имя, Пара.Ключ, Пара.Значение.Родитель);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Спан поиска версии именно под резолвером выдачи: тот же спан бывает и на других путях хаба.
Функция ДождатьсяСпанаПоискаВерсии(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл
		Спан = СпанПоискаВерсииПодВыдачей(Разбор.СпаныПартий(Коллектор.Принятое("traces")));
		Если Спан <> Неопределено Тогда
			Возврат Спан;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			ВызватьИсключение СтрШаблон(
				"За %1 с в уехавших трассах не нашёлся спан ""%2"" под ""%3""",
				Секунд, ИмяСпанаПоискаВерсии(), ИмяСпанаРезолва());
		КонецЕсли;
		ОтветНаФайлПакета();
		Приостановить(1000);
	КонецЦикла;

КонецФункции

Функция СпанПоискаВерсииПодВыдачей(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Имя <> ИмяСпанаПоискаВерсии() Тогда
			Продолжить;
		КонецЕсли;
		Если ИндексПоИмени(ЦепочкаККорню(Спаны, Пара.Значение), ИмяСпанаРезолва()) >= 0 Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Спан родителя уезжает позже детей: читается всё принятое, пока цепочка выдачи не сойдётся.
Функция ДождатьсяЦепочкиВыдачи(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл
		Цепочка = ЦепочкаВыдачи(Разбор.СпаныПартий(Коллектор.Принятое("traces")));
		Если Цепочка.Количество() > 0 Тогда
			Возврат Цепочка;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			ВызватьИсключение СтрШаблон(
				"За %1 с в уехавших трассах не собралась цепочка от запроса к СУБД"
				+ " через %2 до %3", Секунд, ИмяСпанаПоискаПакета(), ИмяСпанаРезолва());
		КонецЕсли;
		ОтветНаФайлПакета();
		Приостановить(1000);
	КонецЦикла;

КонецФункции

// Цепочка от запроса к СУБД до корня, в которой поиск пакета поднят резолвером выдачи.
Функция ЦепочкаВыдачи(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Атрибуты["db.system.name"] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Цепочка = ЦепочкаККорню(Спаны, Пара.Значение);
		Если ИндексПоИмени(Цепочка, ИмяСпанаПоискаПакета()) >= 0
			И ИндексПоИмени(Цепочка, ИмяСпанаРезолва()) >= 0 Тогда
			Возврат Цепочка;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Массив();

КонецФункции

// Спан и его родители до корня; обрыв ссылки (родитель ещё не уехал) останавливает подъём.
Функция ЦепочкаККорню(Знач Спаны, Знач Спан)

	Цепочка = Новый Массив();
	Текущий = Спан;

	Пока Текущий <> Неопределено И Цепочка.Количество() < 32 Цикл
		Цепочка.Добавить(Текущий);
		Текущий = Спаны[Текущий.Родитель];
	КонецЦикла;

	Возврат Цепочка;

КонецФункции

// Место спана в цепочке; -1 — такого спана в ней нет.
Функция ИндексПоИмени(Знач Цепочка, Знач Имя)

	Для Индекс = 0 По Цепочка.ВГраница() Цикл
		Если Цепочка[Индекс].Имя = Имя Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

Функция ИндексПоАтрибуту(Знач Цепочка, Знач Ключ)

	Для Индекс = 0 По Цепочка.ВГраница() Цикл
		Если Цепочка[Индекс].Атрибуты[Ключ] <> Неопределено Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

// Цепочка одной строкой для сообщения отказа: от запроса к СУБД к корню трассы.
Функция ИменаЦепочки(Знач Цепочка)

	Имена = Новый Массив();
	Для Каждого Спан Из Цепочка Цикл
		Имена.Добавить(Спан.Имя);
	КонецЦикла;

	Возврат СтрСоединить(Имена, " ← ");

КонецФункции

// Порог с запасом: партия уезжает раз в секунду, за минуту наблюдения их набегает заметно больше.
Функция ПартийДляЖивогоПотока()
	Возврат 5;
КонецФункции

Функция ОтветНаЗдоровье()
	Возврат Хаб.Соединение().Получить(Новый HTTPЗапрос("/health"));
КонецФункции

// Первая строка журнала с непустым traceId — такую пишет только работа изнутри операции.
Функция ДождатьсяСшитойСтроки(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		ИдТрассы = ПервыйИдТрассы(Коллектор.Принятое("logs"));
		Если ЗначениеЗаполнено(ИдТрассы) Тогда
			Возврат ИдТрассы;
		КонецЕсли;
		ОтветНаЗдоровье();
		Приостановить(1000);
	КонецЦикла;

	Возврат "";

КонецФункции

// Число из ответа /api/v1/metrics — источник правды для сверки с прибором.
Функция ЧислоИзМетрикAPI(Знач Ключ)

	Ответ = Хаб.Соединение().Получить(Новый HTTPЗапрос("/api/v1/metrics"));
	Ожидаем.Что(Ответ.КодСостояния, "эндпоинт метрик отвечает").Равно(200);

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Данные[Ключ];

КонецФункции

// Первый непустой traceId из партии логов OTLP/JSON.
Функция ПервыйИдТрассы(Знач Тело)

	Позиция = 1;
	Пока Истина Цикл
		Найдено = СтрНайти(Тело, """traceId"":", Направление(), Позиция);
		Если Найдено = 0 Тогда
			Возврат "";
		КонецЕсли;
		Значение = ЗначениеЗаКлючом(Сред(Тело, Найдено));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

Функция Направление()
	Возврат НаправлениеПоиска.СНачала;
КонецФункции

// Строковое значение первого ключа в куске OTLP/JSON: "ключ": "значение".
Функция ЗначениеЗаКлючом(Знач Кусок)

	Двоеточие = СтрНайти(Кусок, ":");
	Если Двоеточие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Кусок, Двоеточие + 1);
	Открывающая = СтрНайти(Хвост, """");
	Если Открывающая = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Хвост, Открывающая + 1);
	Закрывающая = СтрНайти(Хвост, """");

	Возврат ?(Закрывающая = 0, "", Лев(Хвост, Закрывающая - 1));

КонецФункции

#КонецОбласти
