// Хаб до мастера /setup: онбординг нужен, лендинг, каталог и кабинет уводят на мастер, форма мастера
// называет требования к паролю, анонимная регистрация закрыта всеми тремя дверями одной причиной. Хаб —
// общий группы «мастер», фаза «пусто»: набор идёт первым в группе, мастера не проходит и ничего не заводит.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;     // фикстура ЭкземплярХаба — хаб группы «мастер» до мастера
Перем Клиент;  // фикстура КлиентХаба — запросы к подопытному хабу
Перем Отказы;  // ОтказыУчётки (вход) — ожидаемое спрашивается у таблицы причин, а не пишется литералом
Перем Тексты;  // ТекстыОтказовВхода (интерфейс) — экранные слова той же причины

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
&Тег("хаб:мастер")
&Тег("фаза:пусто")
&Порядок(0)
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("КлассыСлоя");

	ПоискКлассов = Новый КлассыСлоя();
	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ОтказыУчётки");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "ТекстыОтказовВхода");
	Отказы = Новый ОтказыУчётки(Новый ТекстОшибки());
	Тексты = Новый ТекстыОтказовВхода(Неопределено, Неопределено, Отказы);

	Хаб = ОбщийХаб.Экземпляр("мастер");
	Клиент = Новый КлиентХаба(Хаб, 15);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ОнбордингНуженНаПустомХабе() Экспорт

	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET("/setup")).Получить("onboarding_needed"),
		"GET /setup без Accept отвечает JSON").ЭтоИстина();

	Состояние = Клиент.ТелоJSON(Клиент.GETДанных("/setup"));
	Ожидаем.Что(Состояние.Получить("onboarding_needed"), "JSON-контракт /setup").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЛендингИКаталогУводятНаSetup() Экспорт

	Ожидаем.Что(РедиректНаSetup("/"), "лендинг → /setup на онбординге").ЭтоИстина();
	Ожидаем.Что(РедиректНаSetup("/packages"), "каталог → /setup на онбординге").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФормаМастераНазываетТребованияКПаролю() Экспорт

	ФормаSetup = Клиент.Тело(Клиент.GETСтраницы("/setup"));
	Ожидаем.Что(СтрНайти(ФормаSetup, "Первый запуск") > 0, "HTML-форма мастера").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "action=""/setup""") > 0, "форма постит на /setup").ЭтоИстина();

	// требования к паролю названы прямо у поля — словами и с кодом живой проверки,
	// а не отсылкой к ключам конфигурации
	Ожидаем.Что(СтрНайти(ФормаSetup, "data-pwreq=""пароль""") > 0,
		"подсказка привязана к полю пароля мастера").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "data-pwrule=""length""") > 0,
		"и несёт код требования длины").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "длина от 8 до 256 символов") > 0,
		"а человек читает требование словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "oshub.auth.password"),
		"к ключам конфигурации мастер больше не отсылает").Равно(0);

КонецПроцедуры

&Тест
Процедура ВходНеУводитНаSetupИЗовётВРегистрацию() Экспорт

	СтраницаВхода = Клиент.Тело(Клиент.GETСтраницы("/login"));
	Ожидаем.Что(СтрНайти(СтраницаВхода, "Первый запуск"), "/login не редиректит на /setup").Равно(0);
	Ожидаем.Что(СтрНайти(СтраницаВхода, "href=""/register""") > 0, "ссылка на регистрацию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтраницаВхода, "Зарегистрироваться") > 0, "кнопка Зарегистрироваться").ЭтоИстина();

КонецПроцедуры

// Гейт первого запуска: администратора ещё нет, и ни одна из трёх дверей регистрации не пропускает
// анонима — иначе он необратимо закрыл бы мастер /setup. Статус, код и слова — по таблице причин.
&Тест
Процедура АнонимнаяРегистрацияДоМастераНеПроходитНиОднойДверью() Экспорт

	Причина = Отказы.ОнбордингНеЗавершён();
	Ожидаемый = Отказы.Разобрать(Отказы.Ошибка(Причина));
	Подпись = " (причина " + Причина + ")";
	ТелоРегистрации = "{""логин"":""eve"",""email"":""eve@ex.com"",""пароль"":""EveSecret1""}";

	Регистрация = Клиент.POSTДанных("/api/v1/register", ТелоРегистрации);
	Аккаунты = Клиент.POSTДанных("/api/v1/users", ТелоРегистрации);

	Ожидаем.Что(Регистрация.КодСостояния, "POST /api/v1/register" + Подпись).Равно(Ожидаемый.Статус);
	Ожидаем.Что(Аккаунты.КодСостояния, "POST /api/v1/users" + Подпись).Равно(Ожидаемый.Статус);
	Ожидаем.Что(КодОшибки(Регистрация), "код /api/v1/register" + Подпись).Равно(Ожидаемый.Код);
	Ожидаем.Что(КодОшибки(Аккаунты), "код /api/v1/users" + Подпись).Равно(Ожидаемый.Код);

	// та же причина — те же поля: подробности не вправе быть у одной двери и не быть у другой
	Ожидаем.Что(ПодробностиСтрокой(Аккаунты), "details /api/v1/users" + Подпись)
		.Равно(ПодробностиСтрокой(Регистрация));

	Форма = Клиент.POSTФормыСтраницы("/register", "логин=eve&email=eve%40ex.com&пароль=EveSecret1");
	ТелоФормы = Клиент.Тело(Форма);
	Ожидаем.Что(Форма.КодСостояния, "POST /register" + Подпись).Равно(Ожидаемый.Статус);
	Ожидаем.Что(СтрНайти(ТелоФормы, Тексты.ОтказРегистрации(Причина, "")) > 0,
		"форма объясняет ту же причину" + Подпись + ": " + Лев(ТелоФормы, 400)).ЭтоИстина();

	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETДанных("/setup")).Получить("onboarding_needed"),
		"после попыток анонимной регистрации онбординг всё ещё нужен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КабинетУводитНаSetup() Экспорт

	Ожидаем.Что(РедиректНаSetup("/me"), "кабинет → /setup на онбординге").ЭтоИстина();

КонецПроцедуры

#Область Служебное

Функция РедиректНаSetup(Знач Путь)
	Ответ = Клиент.GETСтраницы(Путь);
	Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда
		Возврат СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "/setup") > 0;
	КонецЕсли;
	Возврат СтрНайти(Клиент.Тело(Ответ), "Первый запуск") > 0;
КонецФункции

Функция КодОшибки(Знач Ответ)
	Ошибка = Клиент.ТелоJSON(Ответ).Получить("error");
	Возврат ?(Ошибка = Неопределено, "", Строка(Ошибка.Получить("code")));
КонецФункции

// Подробности отказа одной строкой «поле=значение;…» в порядке имён — для сравнения целиком.
Функция ПодробностиСтрокой(Знач Ответ)

	Ошибка = Клиент.ТелоJSON(Ответ).Получить("error");
	Подробности = ?(Ошибка = Неопределено, Неопределено, Ошибка.Получить("details"));
	Если Подробности = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Поля = Новый СписокЗначений();
	Для Каждого Поле Из Подробности Цикл
		Поля.Добавить(Строка(Поле.Ключ) + "=" + Строка(Поле.Значение));
	КонецЦикла;
	Поля.СортироватьПоЗначению();
	Возврат СтрСоединить(Поля.ВыгрузитьЗначения(), ";");

КонецФункции

#КонецОбласти
