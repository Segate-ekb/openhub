// Выключатель парольного входа на настоящем хабе: предохранитель, подтверждение, закрытый парольный путь,
// возврат конфигом и тумблером; IdP — фейковый в отдельном процессе, каждый тест сам готовит состояние.

#Использовать asserts
#Использовать 1connector
#Использовать "../../фикстуры"

Перем Хаб;
Перем IdP;
Перем Порт;
Перем КореньДанных;    // общий каталог БД: переживает перезапуск хаба
Перем ИмяПровайдера;
Перем ЛогинАдмина;
Перем ПарольАдмина;
Перем КлючНастройки;
Перем ЛогинУПровайдера;  // preferred_username фейкового IdP: не равен sub и длиннее предела таблицы кабинета
Перем ВидимаяЧастьЛогина; // столько от логина таблица показывает текстом, остальное в title
Перем СессияМастера;      // кука сессии, открытой мастером: сессии лежат в базе и переживают перезапуск хаба
Перем ТокенМастера;       // CSRF-токен этой сессии — он хранится в самой сессии

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ИмяПровайдера = "fake";
	ЛогинАдмина = "root";
	ПарольАдмина = "SuperSecret1";
	КлючНастройки = "oshub.auth.password.enabled";
	// длина preferred_username у фейка больше предела таблицы, чтобы обрезка проверялась на основной
	// ветке показа, а не только на откате к субъекту
	ЛогинУПровайдера = "root-at-idp-0123456789abcdef0123456789abcdef";
	ВидимаяЧастьЛогина = "root-at-idp-0123456789ab";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьСтенд() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоIdP");

	// логин у провайдера отличается от sub намеренно: кабинет показывает именно логин
	IdP = Новый ЭкземплярФейковогоIdP("хаб-клиент", "субъект-админа", "admin@example.com",
		60, ЛогинУПровайдера);
	IdP.Запустить();

	КореньДанных = УникальныеИмена.ВременныйПуть("openhub-password-login");
	СоздатьКаталог(ОбъединитьПути(КореньДанных, "db"));
	СоздатьКаталог(ОбъединитьПути(КореньДанных, "storage"));

	ПоднятьХаб("");

	// администратор и его личность у провайдера — предусловие всех тестов, кроме первого
	СессияМастера = ЗавестиАдмина();
	ПривязатьПровайдера(СессияМастера);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьСтенд() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
		Хаб = Неопределено;
	КонецЕсли;
	Если IdP <> Неопределено Тогда
		IdP.Остановить();
		IdP = Неопределено;
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КореньДанных);

КонецПроцедуры

#Область Предохранитель

&Тест
Процедура БезПривязаннойЛичностиАдминаВыключитьНельзя() Экспорт

	// провайдер включён, но личность админа снимается вместе с ним: остаётся хаб,
	// на котором кнопка входа есть, а войти ею некому
	Сессия = ОбеспечитьВключён();
	Личность = ОтвязатьПровайдера(Сессия);

	Попытка
		Раздел = ТелоОтвета(GET("/hub/settings/login", Сессия));
		Отказ = POSTФормы("/hub/settings/login", ФормаТумблера(CSRF(Раздел), "0"), Сессия);

		Ожидаем.Что(Отказ.КодСостояния, "выключение отклонено").Равно(400);
		Ожидаем.Что(СтрНайти(Отказ.Текст(), "ни у одного администратора хаба нет привязанной личности") > 0,
			"отказ называет нехватку личности: " + Лев(Отказ.Текст(), 400)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ.Текст(), "name=""подтверждение"""),
			"подтверждать нечего — окна подтверждения нет").Равно(0);
		Ожидаем.Что(ПарольныйВходРаботает(), "парольный вход остался включённым").ЭтоИстина();
	Исключение
		ПривязатьПровайдера(Сессия);
		ВызватьИсключение;
	КонецПопытки;

	ПривязатьПровайдера(Сессия);
	Ожидаем.Что(Личность > 0, "личность действительно отвязывалась, а не «не нашлась»").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ВыключениеИВозврат

&Тест
Процедура ВыключениеПроходитЧерезОкноПодтвержденияИЭхо() Экспорт

	Сессия = ОбеспечитьВключён();

	Раздел = ТелоОтвета(GET("/hub/settings/login", Сессия));
	Отправка = POSTФормы("/hub/settings/login", ФормаТумблера(CSRF(Раздел), "0"), Сессия);

	Ожидаем.Что(Отправка.КодСостояния, "первая отправка уводит на окно подтверждения").Равно(303);
	Ожидаем.Что(ПарольныйВходРаботает(), "вопрос ничего не сохранил").ЭтоИстина();

	Вопрос = ТелоОтвета(GET(ПутьСЗапросом(Локейшн(Отправка)), Сессия));
	Ожидаем.Что(СтрНайти(Вопрос, "<dialog") > 0 И СтрНайти(Вопрос, " open") > 0,
		"страница пришла с открытым окном подтверждения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вопрос, "name=""подтверждение""") > 0,
		"с полем эха").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вопрос, "токены доступа продолжают работать") > 0,
		"и с честным перечнем того, что НЕ гаснет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вопрос, "OSHUB_AUTH_PASSWORD_ENABLED") > 0,
		"и с аварийным возвратом").ЭтоИстина();

	Мимо = POSTФормы("/hub/settings/login",
		ФормаПодтверждения(CSRF(Вопрос), "не-то-слово"), Сессия);
	Ожидаем.Что(Мимо.КодСостояния, "неверное эхо — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Мимо.Текст(), "aria-invalid=""true""") > 0, "отказ — под полем эха").ЭтоИстина();
	Ожидаем.Что(ПарольныйВходРаботает(), "после неверного эха пароль работает").ЭтоИстина();

	Готово = POSTФормы("/hub/settings/login",
		ФормаПодтверждения(CSRF(Мимо.Текст()), "выключить"), Сессия);
	Ожидаем.Что(Готово.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНайти(Готово.Текст(), "Вход по логину и паролю выключен") > 0,
		"итог операции назван: " + Лев(Готово.Текст(), 400)).ЭтоИстина();
	Ожидаем.Что(ПарольныйВходРаботает(), "парольный вход выключен").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПриВыключенномПарольныйПутьЗакрытЦеликом() Экспорт

	ОбеспечитьВыключен();

	Страница = ТелоОтвета(GET("/login", ""));
	Ожидаем.Что(СтрНайти(Страница, "name=""пароль"""),
		"поля пароля на странице входа нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "name=""логин"""),
		"поля логина на странице входа нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "/login/oidc/" + ИмяПровайдера) > 0,
		"кнопка провайдера на месте").ЭтоИстина();

	POSTВхода = POSTФормы("/login", ТелоВхода(ЛогинАдмина, ПарольАдмина), "");
	Ожидаем.Что(POSTВхода.КодСостояния, "POST браузерного входа отвечает отказом").Равно(403);
	Ожидаем.Что(ЗначениеЗаполнено(КукаПоИмени(POSTВхода, "oshub_session")),
		"и сессии не выдаёт").ЭтоЛожь();

	ОтветAPI = ВойтиПоAPI(ЛогинАдмина, ПарольАдмина);
	Ожидаем.Что(ОтветAPI.КодСостояния, "API-вход отвечает отказом").Равно(403);
	Ожидаем.Что(СтрНайти(ТелоОтвета(ОтветAPI), "password_login_disabled") > 0,
		"с машинным кодом причины").ЭтоИстина();

	// пароль не проверяется вовсе: неверный даёт тот же отказ, а не 401
	Ожидаем.Что(ВойтиПоAPI(ЛогинАдмина, "совершенно-неверный").КодСостояния,
		"неверный пароль даёт тот же отказ — брутфорсить нечего").Равно(403);

КонецПроцедуры

&Тест
Процедура ПриВыключенномРегистрацияСПаролемЗакрыта() Экспорт

	ОбеспечитьВыключен();

	Аккаунты = POSTjson("/api/v1/users",
		"{""логин"":""novichok"",""email"":""n@example.com"",""пароль"":""password123""}");
	Ожидаем.Что(Аккаунты.КодСостояния, "POST /api/v1/users отвечает 403, как соседние причины")
		.Равно(403);
	Ожидаем.Что(СтрНайти(ТелоОтвета(Аккаунты), "registration_password_login_disabled") > 0,
		"с машинным кодом причины: " + Лев(ТелоОтвета(Аккаунты), 300)).ЭтоИстина();

	Регистрация = POSTjson("/api/v1/register",
		"{""логин"":""novichok2"",""email"":""n2@example.com"",""пароль"":""password123""}");
	Ожидаем.Что(Регистрация.КодСостояния,
		"вторая дверь регистрации отвечает тем же статусом, что и первая").Равно(403);
	Ожидаем.Что(СтрНайти(ТелоОтвета(Регистрация), "registration_password_login_disabled") > 0,
		"с названной причиной: " + Лев(ТелоОтвета(Регистрация), 300)).ЭтоИстина();

	Страница = GET("/register", "");
	Ожидаем.Что(Страница.КодСостояния, "страница регистрации отвечает, а не ломается").Равно(200);
	Ожидаем.Что(СтрНайти(ТелоОтвета(Страница), "регистрация с паролем") > 0,
		"и объясняет, почему формы нет: " + Лев(ТелоОтвета(Страница), 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоОтвета(Страница), "action=""/register"""),
		"самой формы на ней нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПеременнаяОкруженияВозвращаетФормуПоверхБазы() Экспорт

	ОбеспечитьВыключен();

	Хаб.Остановить();
	ПоднятьХаб("true");

	Ожидаем.Что(СтрНайти(ТелоОтвета(GET("/login", "")), "name=""пароль""") > 0,
		"переменная окружения вернула форму входа").ЭтоИстина();
	Ожидаем.Что(ВойтиПоAPI(ЛогинАдмина, ПарольАдмина).КодСостояния,
		"и API-вход по паролю — тоже").Равно(200);

	// заданное переменной окружения из интерфейса не правится, и поля ему не достаётся:
	// тумблер, который ничего не меняет, обещал бы неправду; сессия открыта до перезапуска
	// без переходов: умершая сессия увела бы на /login, где поля нет тоже
	Сессия = СессияАдмина();
	ОтветРаздела = GET_БезПереходов("/hub/settings/login", "oshub_session=" + Сессия);
	Ожидаем.Что(ОтветРаздела.КодСостояния, "раздел настроек открыт под сессией администратора").Равно(200);
	Ожидаем.Что(СтрНайти(ОтветРаздела.Текст(), "name=""" + КлючНастройки + """"),
		"форсированной переменной окружения поля не досталось").Равно(0);

	// база при этом по-прежнему говорит «выключено»: уберите переменную — вернётся
	Хаб.Остановить();
	ПоднятьХаб("");
	Ожидаем.Что(ПарольныйВходРаботает(), "без переменной снова действует значение базы").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТумблерВозвращаетПарольныйВходАдмину() Экспорт

	// штатный возврат: администратор входит провайдером (паролем уже нельзя)
	// и включает тумблер обратно
	ОбеспечитьВыключен();
	Сессия = ВойтиПровайдером();
	Ожидаем.Что(ЗначениеЗаполнено(Сессия), "провайдером админ вошёл").ЭтоИстина();

	Раздел = ТелоОтвета(GET("/hub/settings/login", Сессия));
	Ожидаем.Что(СтрНайти(Раздел, "data-setting=""" + КлючНастройки + """ data-source=""database""") > 0,
		"действующее значение сейчас из базы").ЭтоИстина();

	Итог = POSTФормы("/hub/settings/login", ФормаТумблера(CSRF(Раздел), "1"), Сессия);

	Ожидаем.Что(Итог.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНайти(Итог.Текст(), "Вход по логину и паролю включён") > 0,
		"итог операции назван: " + Лев(Итог.Текст(), 400)).ЭтоИстина();
	Ожидаем.Что(ПарольныйВходРаботает(), "парольный вход снова работает").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоОтвета(GET("/login", "")), "name=""пароль""") > 0,
		"и форма вернулась на страницу входа").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПривязкиВКабинете

// Раздел «Привязки OIDC» показывает логин у провайдера, а не машинный sub. Личность заводит сам тест
// ручной привязкой — чтобы логин в записи не дописал сосед, входящий провайдером.
&Тест
Процедура ПривязкиПоказываютЛогинУПровайдераАНеСубъект() Экспорт

	Сессия = ОбеспечитьВключён();
	ЗавестиПривязкуЗаново(Сессия);

	Страница = ТелоОтвета(GET("/me/settings/oidc", Сессия));

	Ожидаем.Что(СтрНайти(Страница, ВидимаяЧастьЛогина) > 0,
		"в таблице привязок виден логин у провайдера: " + Лев(Страница, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "субъект-админа"),
		"машинный sub на экран не выводится вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Аккаунт у провайдера") > 0,
		"и колонка названа тем, что в ней показано").ЭтоИстина();

КонецПроцедуры

// Значение от провайдера обрезается по тому, что показано: длину выбирает провайдер, и логин
// ничем не лучше субъекта; полное значение остаётся в title.
&Тест
Процедура ДлинныйЛогинУПровайдераВТаблицеОбрезается() Экспорт

	Сессия = ОбеспечитьВключён();
	ЗавестиПривязкуЗаново(Сессия);

	Страница = ТелоОтвета(GET("/me/settings/oidc", Сессия));

	// текстом ячейки полное значение не печатается: между тегами его быть не должно
	Ожидаем.Что(СтрНайти(Страница, ">" + ЛогинУПровайдера + "<"),
		"полный логин напечатан текстом ячейки — таблица снова растаскивается").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, ВидимаяЧастьЛогина + "…") > 0,
		"показано начало логина с многоточием: " + Лев(Страница, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "title=""" + ЛогинУПровайдера + """") > 0,
		"полное значение осталось доступно подсказкой").ЭтоИстина();

КонецПроцедуры

// Посторонний не отвязывает чужую личность ни формой окна, ни адресом окна: ответ ведёт к его
// собственному списку и существования чужой личности не раскрывает. КОНТРОЛЬ — личность админа цела.
&Тест
Процедура ПостороннийНеОтвязываетЧужуюЛичность() Экспорт

	Сессия = ОбеспечитьВключён();
	ЗавестиПривязкуЗаново(Сессия);
	Страница = ТелоОтвета(GET("/me/settings/oidc", Сессия));
	Личность = ЗначениеПослеМаркера(Страница, МаркерОкнаОтвязки());
	Личность = Лев(Личность, СтрНайти(Личность + """", """") - 1);

	Логин = "stranger" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() % 1000000, "ЧГ=0");
	Ожидаем.Что(POSTjson("/api/v1/users",
		СтрШаблон("{""логин"":""%1"",""email"":"""",""пароль"":""%2""}", Логин, "StrangerPassw0rd")).КодСостояния,
		"посторонняя учётка заведена").Равно(201);
	Чужой = КукаПоИмени(ВойтиПоAPI(Логин, "StrangerPassw0rd"), "oshub_session");

	СвояСтраница = ТелоОтвета(GET("/me/settings/oidc?" + КодироватьURL("окно") + "="
		+ КодироватьURL("отвязать-" + Личность), Чужой));
	Ожидаем.Что(СтрНайти(СвояСтраница, "<dialog") > 0 И СтрНайти(СвояСтраница, " open") > 0,
		"адрес окна чужой личности окна не открывает").ЭтоЛожь();

	Ответ = POSTФормы("/me/settings/oidc/unlink",
		"_csrf=" + КодироватьURL(CSRF(СвояСтраница))
			+ "&" + КодироватьURL("личность") + "=" + КодироватьURL(Личность) + "&confirmed=1", Чужой);
	Ожидаем.Что(Ответ.КодСостояния, "посторонний уведён").Равно(303);
	Ожидаем.Что(Локейшн(Ответ), "к своему списку, без окна").Равно("/me/settings/oidc");
	Ожидаем.Что(СтрНайти(ТелоОтвета(GET("/me/settings/oidc", Сессия)), МаркерОкнаОтвязки()) > 0,
		"КОНТРОЛЬ: личность админа цела").ЭтоИстина();

КонецПроцедуры

// Полный вход через провайдера обязан спросить userinfo: снаружи «профиль получен» от «профиль
// деградировал до клеймов id_token» отличает только этот запрос.
&Тест
Процедура ВходЧерезПровайдераЗапрашиваетUserinfo() Экспорт

	ОбеспечитьВключён();
	ДоВхода = IdP.ВызововПрофиля();

	Сессия = ВойтиПровайдером();

	Ожидаем.Что(ЗначениеЗаполнено(Сессия), "вход провайдером состоялся").ЭтоИстина();
	Ожидаем.Что(IdP.ВызововПрофиля() > ДоВхода,
		СтрШаблон("вход спросил у провайдера профиль (было %1, стало %2)",
			ДоВхода, IdP.ВызововПрофиля())).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПриведениеСостояния

Функция ПарольныйВходРаботает()
	Возврат ВойтиПоAPI(ЛогинАдмина, ПарольАдмина).КодСостояния = 200;
КонецФункции

// Приводит хаб к «парольный вход включён» и отдаёт сессию администратора.
Функция ОбеспечитьВключён()

	Сессия = СессияАдмина();
	Если ФормаПароляНаВходе() Тогда
		Возврат Сессия;
	КонецЕсли;

	POSTФормы("/hub/settings/login", ФормаТумблера(ТокенАдмина(), "1"), Сессия);
	Ожидаем.Что(ПарольныйВходРаботает(), "подготовка: парольный вход включён").ЭтоИстина();
	Возврат Сессия;

КонецФункции

// Приводит хаб к «парольный вход выключен» тем же путём, что и человек: тумблер и эхо.
Функция ОбеспечитьВыключен()

	Сессия = СессияАдмина();
	Если НЕ ФормаПароляНаВходе() Тогда
		Возврат Сессия;
	КонецЕсли;

	// первая отправка уводит на окно подтверждения, его форма несёт тот же токен сессии
	POSTФормы("/hub/settings/login", ФормаТумблера(ТокенАдмина(), "0"), Сессия);
	POSTФормы("/hub/settings/login", ФормаПодтверждения(ТокенАдмина(), "выключить"), Сессия);
	Ожидаем.Что(ПарольныйВходРаботает(), "подготовка: парольный вход выключен").ЭтоЛожь();
	Возврат Сессия;

КонецФункции

// Сессия администратора, открытая мастером: годится при любом положении выключателя и после
// перезапуска хаба, вход заново паролем стоил бы хеша.
Функция СессияАдмина()
	Возврат СессияМастера;
КонецФункции

// CSRF-токен сессии администратора: берётся с раздела настроек входа один раз на набор.
Функция ТокенАдмина()

	Если НЕ ЗначениеЗаполнено(ТокенМастера) Тогда
		ТокенМастера = CSRF(ТелоОтвета(GET("/hub/settings/login", СессияАдмина())));
	КонецЕсли;
	Возврат ТокенМастера;

КонецФункции

// Положение выключателя без входа: форма пароля на странице входа есть, только пока он включён.
Функция ФормаПароляНаВходе()
	Возврат СтрНайти(ТелоОтвета(GET("/login", "")), "name=""пароль""") > 0;
КонецФункции

#КонецОбласти

#Область Стенд

// Поднимает хаб на ОБЩЕМ каталоге данных: перезапуск обязан видеть прежнюю базу.
Процедура ПоднятьХаб(Знач ПарольныйВход)

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньДанных, "db"));
	Хаб.Среда("OSHUB_STORAGE_ROOT", ОбъединитьПути(КореньДанных, "storage"));
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// инсталляция без почты выбирает одну из двух развилок; здесь — выключенное подтверждение
	// адреса, иначе регистрация закрыта
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_AUTH_PASSWORD_ENABLED", ПарольныйВход);
	Хаб.Среда("OSHUB_OIDC_PROVIDERS", ИмяПровайдера);
	Хаб.Среда("OSHUB_OIDC_FAKE_LABEL", "Фейковый IdP");
	Хаб.Среда("OSHUB_OIDC_FAKE_ISSUER", IdP.Издатель());
	Хаб.Среда("OSHUB_OIDC_FAKE_CLIENT__ID", "хаб-клиент");
	Хаб.Среда("OSHUB_OIDC_FAKE_CLIENT__SECRET", "секрет-хаб-клиента");
	Хаб.Среда("OSHUB_OIDC_FAKE_REDIRECT__URI", "http://localhost/oidc/callback");

	Хаб.Запустить();
	Порт = Хаб.Порт();

КонецПроцедуры

// Первый запуск: мастер /setup заводит администратора и сразу открывает ему сессию.
Функция ЗавестиАдмина()

	Ответ = POSTjson("/setup",
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", ЛогинАдмина, ПарольАдмина));
	Если Ответ.КодСостояния = 201 Тогда
		Возврат КукаПоИмени(Ответ, "oshub_session");
	КонецЕсли;
	Возврат КукаПоИмени(ВойтиПоAPI(ЛогинАдмина, ПарольАдмина), "oshub_session");

КонецФункции

// Ручная привязка личности: кабинет уводит к провайдеру, на хаб возвращаемся по пути и запросу.
Процедура ПривязатьПровайдера(Знач Сессия)

	Старт = GET_БезПереходов("/me/settings/oidc/link/" + ИмяПровайдера, "oshub_session=" + Сессия);
	Ожидаем.Что(Старт.КодСостояния, "кабинет уводит к провайдеру").Равно(302);

	КукаТранзакции = КукаПоИмени(Старт, "oshub_oidc_txn");
	Согласие = GET_БезПереходовПоАдресу(Локейшн(Старт), "");
	Ожидаем.Что(Согласие.КодСостояния, "провайдер вернул браузер на хаб").Равно(302);

	Возврат_ = GET_БезПереходов(ПутьСЗапросом(Локейшн(Согласие)),
		"oshub_oidc_txn=" + КукаТранзакции + "; oshub_session=" + Сессия);
	Ожидаем.Что(Локейшн(Возврат_), "личность привязана, кабинет показывает список")
		.Равно("/me/settings/oidc");

КонецПроцедуры

// Пересоздаёт личность администратора одной ручной привязкой: снимает прежнюю и заводит свою.
Процедура ЗавестиПривязкуЗаново(Знач Сессия)

	Страница = ТелоОтвета(GET("/me/settings/oidc", Сессия));
	Если СтрНайти(Страница, МаркерОкнаОтвязки()) > 0 Тогда
		ОтвязатьПровайдера(Сессия);
	КонецЕсли;
	ПривязатьПровайдера(Сессия);

КонецПроцедуры

// Снимает привязку личности администратора формой окна подтверждения кабинета; отдаёт её
// идентификатор. Номер личности — из адреса окна отвязки в ⚙ строки: ?окно=отвязать-{номер}.
Функция ОтвязатьПровайдера(Знач Сессия)

	Страница = ТелоОтвета(GET("/me/settings/oidc", Сессия));
	Личность = ЗначениеПослеМаркера(Страница, МаркерОкнаОтвязки());
	Личность = Лев(Личность, СтрНайти(Личность + """", """") - 1);
	Ожидаем.Что(ЗначениеЗаполнено(Личность), "в кабинете есть привязанная личность").ЭтоИстина();

	POSTФормы("/me/settings/oidc/unlink",
		"_csrf=" + КодироватьURL(CSRF(Страница))
			+ "&" + КодироватьURL("личность") + "=" + КодироватьURL(Личность) + "&confirmed=1", Сессия);

	Возврат Число(Личность);

КонецФункции

Функция МаркерОкнаОтвязки()
	Возврат КодироватьСтроку("отвязать-", СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Полный круг входа через провайдера; отдаёт куку открытой сессии.
Функция ВойтиПровайдером()

	Старт = GET_БезПереходов("/login/oidc/" + ИмяПровайдера, "");
	КукаТранзакции = КукаПоИмени(Старт, "oshub_oidc_txn");
	Согласие = GET_БезПереходовПоАдресу(Локейшн(Старт), "");
	Возврат_ = GET_БезПереходов(ПутьСЗапросом(Локейшн(Согласие)),
		"oshub_oidc_txn=" + КукаТранзакции);
	Возврат КукаПоИмени(Возврат_, "oshub_session");

КонецФункции

Функция ФормаТумблера(Знач Токен, Знач Значение)
	Возврат "_csrf=" + КодироватьURL(Токен)
		+ "&" + КодироватьURL(КлючНастройки) + "=" + Значение;
КонецФункции

Функция ФормаПодтверждения(Знач Токен, Знач Эхо)
	Возврат "_csrf=" + КодироватьURL(Токен)
		+ "&" + КодироватьURL("операция") + "=" + КодироватьURL("парольный-вход")
		+ "&" + КодироватьURL("подтверждение") + "=" + КодироватьURL(Эхо);
КонецФункции

Функция ТелоВхода(Знач Логин, Знач Пароль)
	Возврат КодироватьURL("логин") + "=" + КодироватьURL(Логин)
		+ "&" + КодироватьURL("пароль") + "=" + КодироватьURL(Пароль);
КонецФункции

Функция CSRF(Знач Страница)

	Токен = ЗначениеПослеМаркера(Страница, "name=""_csrf"" value=""");
	Ожидаем.Что(ЗначениеЗаполнено(Токен), "на странице раздела есть CSRF-токен").ЭтоИстина();
	Возврат Токен;

КонецФункции

#КонецОбласти

#Область HTTP

Функция GET(Знач Путь, Знач Сессия)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept", "text/html");
	Если ЗначениеЗаполнено(Сессия) Тогда
		Заголовки.Вставить("Cookie", "oshub_session=" + Сессия);
	КонецЕсли;
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));

КонецФункции

Функция GET_БезПереходов(Знач Путь, Знач СтрокаКуки)
	Возврат GET_БезПереходовПоАдресу(АдресНаХабе(Путь), СтрокаКуки);
КонецФункции

// Запрос без следования редиректам через 1connector: штатное HTTPСоединение переходит само.
Функция GET_БезПереходовПоАдресу(Знач ПолныйАдрес, Знач СтрокаКуки)

	Сессия = Новый Сессия();
	Сессия.Заголовки.Вставить("Accept", "text/html");
	Если ЗначениеЗаполнено(СтрокаКуки) Тогда
		Сессия.Заголовки.Вставить("Cookie", СтрокаКуки);
	КонецЕсли;

	Возврат Сессия.ВызватьМетод("GET", ПолныйАдрес,
		Новый Структура("РазрешитьПеренаправление", Ложь));

КонецФункции

Функция POSTФормы(Знач Путь, Знач ТелоФормы, Знач Кука)

	Сессия = Новый Сессия();
	Сессия.Заголовки.Вставить("Accept", "text/html");
	Сессия.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Если ЗначениеЗаполнено(Кука) Тогда
		Сессия.Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	КонецЕсли;

	Возврат Сессия.ВызватьМетод("POST", АдресНаХабе(Путь),
		Новый Структура("РазрешитьПеренаправление, Данные", Ложь, ТелоФормы));

КонецФункции

Функция ВойтиПоAPI(Знач Логин, Знач Пароль)
	Возврат POSTjson("/api/v1/login",
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль));
КонецФункции

Функция POSTjson(Знач Путь, Знач ТелоЗапроса)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция Соединение()
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 20);
КонецФункции

Функция АдресНаХабе(Знач Путь)
	Возврат СтрШаблон("http://localhost:%1%2", Формат(Порт, "ЧГ=0; ЧН=0"), Путь);
КонецФункции

Функция КодироватьURL(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция ТелоОтвета(Знач Ответ)
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

Функция ЗначениеПослеМаркера(Знач Страница, Знач Маркер)

	Начало = СтрНайти(Страница, Маркер);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Страница, Начало + СтрДлина(Маркер));
	Кавычка = СтрНайти(Хвост, """");
	Возврат ?(Кавычка = 0, "", Лев(Хвост, Кавычка - 1));

КонецФункции

Функция ПутьСЗапросом(Знач Адрес)

	Позиция = СтрНайти(Адрес, "://");
	Если Позиция = 0 Тогда
		Возврат Адрес;
	КонецЕсли;

	Хвост = Сред(Адрес, Позиция + 3);
	Слеш = СтрНайти(Хвост, "/");
	Возврат ?(Слеш = 0, "/", Сред(Хвост, Слеш));

КонецФункции

Функция Локейшн(Знач Ответ)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "LOCATION" Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция КукаПоИмени(Знач Ответ, Знач Имя)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеКуки(Строка(КиЗ.Значение), Имя);
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЗначениеКуки(Знач СтрокаКук, Знач Имя)

	Маркер = Имя + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	Конец = СтрДлина(Остаток) + 1;
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Если ТочкаЗпт > 0 И ТочкаЗпт < Конец Тогда
		Конец = ТочкаЗпт;
	КонецЕсли;
	Запятая = СтрНайти(Остаток, ",");
	Если Запятая > 0 И Запятая < Конец Тогда
		Конец = Запятая;
	КонецЕсли;

	Возврат СокрЛП(Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти
