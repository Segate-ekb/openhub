// Онбординг живым хабом на пустой базе без администратора из окружения. Мастер необратим:
// тест, заведший администратора, отмечает базу тронутой, и следующему поднимается свежий хаб.

#Использовать asserts
#Использовать 1connector
#Использовать "../../фикстуры"

Перем Хаб;   // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем Порт;
Перем БазаТронута; // Булево — мастер уже завёл администратора, следующему тесту нужна свежая база

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьФикстуры() Экспорт
	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	ОстановитьТекущий();
КонецПроцедуры

#Область МастерВЦелевомВиде

&Тест
Процедура МастерСобранКомпонентамиКитаИНесётAutocomplete() Экспорт

	ХабНаСвежейБазе();

	Страница = Клиент.Тело(Клиент.GETСтраницы("/setup"));

	Ожидаем.Что(СтрНайти(Страница, "Первый запуск") > 0, "мастер отдан").ЭтоИстина();
	// мастер собран компонентами кита: карточка и поля, а не <label><input> на месте
	Ожидаем.Что(СтрНайти(Страница, "<section class=""card""") > 0, "мастер собран карточкой кита").ЭтоИстина();
	// признак компонента — базовый класс поля и его управление
	Ожидаем.Что(СтрНайти(Страница, "<label class=""field""") > 0, "поля — компонент кита").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "class=""field__control""") > 0, "и его управление").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "class=""field__hint""") > 0, "у полей есть подсказки").ЭтоИстина();
	// autocomplete: без него менеджер паролей подставляет в мастер СТАРУЮ пару
	Ожидаем.Что(СтрНайти(Страница, "autocomplete=""username""") > 0, "логин помечен как username").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "autocomplete=""new-password""") > 0, "пароль помечен как новый").ЭтоИстина();
	// работает без JS: обычная POST-форма на свой адрес
	Ожидаем.Что(СтрНайти(Страница, "action=""/setup""") > 0, "обычная форма").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура МастерУводитВПроводникАНеВПустойКабинет() Экспорт

	ХабНаСвежейБазе();
	БазаТронута = Истина;

	Ответ = Клиент.POSTФормыБезПереходов("/setup", "логин=root&пароль=RootSecret1");

	Ожидаем.Что(Ответ.КодСостояния, "успешный мастер отвечает редиректом").Равно(302);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "браузер уводится в проводник первой публикации").Равно("/tour");

КонецПроцедуры

#КонецОбласти

#Область РегрессFirstRunHijack

&Тест
Процедура ПослеПоявленияАдминаМастерНедоступенНаОбоихКонтрактах() Экспорт

	ХабНаСвежейБазе();
	БазаТронута = Истина;

	// мастер закрывается навсегда, как только в хабе появился пользователь: проверяются оба
	// контракта ответа и факт отсутствия второй учётки

	// 1. онбординг завершён штатно
	Ожидаем.Что(Клиент.ЗапросJSON("POST", "/setup", "{""логин"":""root"",""пароль"":""RootSecret1""}", Клиент.Заголовок("Accept", "application/json")).КодСостояния,
		"первый админ создан").Равно(201);
	Ожидаем.Что(JSON(Клиент.GET("/setup", Клиент.Заголовок("Accept", "application/json"))).Получить("onboarding_needed"),
		"онбординг больше не нужен").ЭтоЛожь();

	// 2. JSON-контракт: 409 с внятным кодом, а не 200/201
	ОтветJSON = Клиент.ЗапросJSON("POST", "/setup", "{""логин"":""eve"",""пароль"":""EveSecret1""}", Клиент.Заголовок("Accept", "application/json"));
	Ожидаем.Что(ОтветJSON.КодСостояния, "повторный мастер (JSON) отбит").Равно(409);
	Ожидаем.Что(JSON(ОтветJSON).Получить("error").Получить("code")).Равно("already_initialized");

	// 3. HTML-контракт: та же 409 и НИКАКОЙ сессии — иначе аноним получал бы вход
	ОтветHTML = Клиент.POSTФормыБезПереходов("/setup", "логин=eve2&пароль=EveSecret1");
	Ожидаем.Что(ОтветHTML.КодСостояния, "повторный мастер (HTML) отбит").Равно(409);
	ТелоОтказа = ОтветHTML.Текст();
	Ожидаем.Что(СтрНайти(ТелоОтказа, "инициализирован") > 0, "объяснение вместо формы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоОтказа, "action=""/setup"""), "рабочей формы нет").Равно(0);
	Ожидаем.Что(Клиент.КукаСессии(ОтветHTML), "отказ не выдаёт сессионную куку").Равно("");

	// 4. ГЛАВНОЕ: вторая учётка не создана — проверяем не текстом ответа, а входом.
	//     Именно этот ассерт отличает «мастер ответил 409» от «мастер закрыт».
	Ожидаем.Что(Клиент.ЗапросJSON("POST", "/api/v1/login", "{""логин"":""eve"",""пароль"":""EveSecret1""}", Клиент.Заголовок("Accept", "application/json")).КодСостояния,
		"пользователь eve не создан повторным мастером").Равно(401);
	Ожидаем.Что(Клиент.ЗапросJSON("POST", "/api/v1/login", "{""логин"":""eve2"",""пароль"":""EveSecret1""}", Клиент.Заголовок("Accept", "application/json")).КодСостояния,
		"пользователь eve2 не создан повторным мастером").Равно(401);
	Ожидаем.Что(Клиент.ЗапросJSON("POST", "/api/v1/login", "{""логин"":""root"",""пароль"":""RootSecret1""}", Клиент.Заголовок("Accept", "application/json")).КодСостояния,
		"настоящий админ по-прежнему входит").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Проводник

&Тест
Процедура ПроводникПерсоналенИПоказываетШагиСНастройкойOpm() Экспорт

	ХабНаСвежейБазе();
	БазаТронута = Истина;

	// свежая инсталляция: /tour ещё не существует для анонима — сначала мастер
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Клиент.GETБезПереходов("/tour", Клиент.СтрокаКукиСессии("")), "Location"),
		"на пустом хабе проводник уводит в мастер").Равно("/setup");

	Вход = Клиент.ЗапросJSON("POST", "/setup", "{""логин"":""root"",""пароль"":""RootSecret1""}", Клиент.Заголовок("Accept", "application/json"));
	Ожидаем.Что(Вход.КодСостояния).Равно(201);
	Кука = Клиент.КукаСессии(Вход);
	Ожидаем.Что(ЗначениеЗаполнено(Кука), "мастер выдал сессию").ЭтоИстина();

	// аноним (без куки) на инициализированном хабе — на вход, а не на страницу
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Клиент.GETБезПереходов("/tour", Клиент.СтрокаКукиСессии("")), "Location"), "аноним уводится на вход").Равно("/login");

	Страница = Клиент.Тело(Клиент.GETСтраницы("/tour", Кука));
	Ожидаем.Что(СтрНайти(Страница, "Первая публикация") > 0, "заголовок проводника").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "guide__list") > 0, "список шагов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Пройдено") > 0, "прогресс").ЭтоИстина();
	// шаг «создать администратора» только что выполнен, а какой-то шаг — текущий
	Ожидаем.Что(СтрНайти(Страница, "guide__step--done") > 0, "пройденный шаг отмечен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "guide__step--current") > 0, "текущий шаг подсвечен").ЭтоИстина();
	// настройка opm — то, ради чего проводник вообще нужен
	Ожидаем.Что(СтрНайти(Страница, "РесурсПубликацииПакетов") > 0, "запись пула в opm.cfg").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "opm push") > 0, "команда публикации").ЭтоИстина();
	// страница живёт без JS
	Ожидаем.Что(СтрНайти(Страница, "<link rel=""stylesheet""") > 0, "оформление не зависит от JS").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПредупреждениеОПрефиксеГрупп

&Тест
Процедура ХабПредупреждаетОПустомПрефиксеГруппПриСтарте() Экспорт

	// само правило стережёт юнит ВходOIDC_Тесты; здесь — что его зовут и предупреждение доезжает
	// до журнала инсталляции
	ХабOIDC = Новый ЭкземплярХаба(90);
	ХабOIDC.ФайловаяБаза("openhub-5f-oidc-префикс");
	ХабOIDC.Среда("OSHUB_ADMIN_LOGIN", "");
	ХабOIDC.Среда("OSHUB_ADMIN_PASSWORD", "");
	ХабOIDC.Среда("OSHUB_OIDC_PROVIDERS", "keycloak");
	ХабOIDC.Среда("OSHUB_OIDC_KEYCLOAK_ISSUER", "https://kc.example/realms/main");
	ХабOIDC.Среда("OSHUB_OIDC_KEYCLOAK_CLIENT__ID", "openhub");
	ХабOIDC.Среда("OSHUB_OIDC_KEYCLOAK_REDIRECT__URI", "http://localhost/oidc/callback");
	// связка по имени включена, префикс НЕ задан — заряженное ружьё обязано щёлкнуть
	ХабOIDC.Среда("OSHUB_OIDC_KEYCLOAK_LINK__GROUPS__BY__NAME", "true");
	ХабOIDC.Среда("OSHUB_OIDC_KEYCLOAK_GROUP__PREFIX", "");

	Попытка
		ХабOIDC.Запустить();
		// формулировка обязана называть ПОСЛЕДСТВИЕ, а не факт «префикс пуст»
		// предупреждение называет переменную так, как её набирает оператор
		ХабOIDC.ДождатьсяСтрокиЖурнала("OSHUB_OIDC_<ID>_GROUP__PREFIX", 60);
		Ожидаем.Что(СтрНайти(ХабOIDC.Дамп(), "ЛОКАЛЬНЫМИ группами хаба") > 0,
			"предупреждение называет последствие").ЭтоИстина();
	Исключение
		ХабOIDC.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабOIDC.Остановить();

КонецПроцедуры

#КонецОбласти

#Область HTTPПомощники

// Хаб на базе без администратора: пока мастер его не завёл, база годится и следующему тесту.
Процедура ХабНаСвежейБазе()

	Если Хаб <> Неопределено И НЕ БазаТронута Тогда
		Возврат;
	КонецЕсли;
	ОстановитьТекущий();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	Хаб.ФайловаяБаза("openhub-5f-онбординг");
	// администратор из окружения закрыл бы мастер ещё до первого запроса
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_AUTH_REGISTRATION_MODE", "");
	Хаб.Запустить();
	Порт = Хаб.Порт();
	БазаТронута = Ложь;

КонецПроцедуры

Процедура ОстановитьТекущий()
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
		Хаб = Неопределено;
	КонецЕсли;
КонецПроцедуры

Функция JSON(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

#КонецОбласти
