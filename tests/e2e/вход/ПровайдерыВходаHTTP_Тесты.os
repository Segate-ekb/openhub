// HTTP-тесты раздела «провайдеры входа» на настоящем хабе: запрос собирается из напечатанной
// разметки (имена полей и адрес действия читаются из HTML, окна — по адресу ?окно=…),
// вложенных форм на странице нет.

#Использовать asserts
#Использовать 1connector
#Использовать oscript-ui
#Использовать "../../фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем КаталогПроекта;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-провайдеры");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	// провайдер, объявленный ТОЛЬКО окружением: строки базы у него нет, и в списке
	// инсталляций он обязан быть виден — на чтение
	Хаб.Среда("OSHUB_OIDC_PROVIDERS", "envonly");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_ISSUER", "https://idp.example.com");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_CLIENT__ID", "env-client-id");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_CLIENT__SECRET", "env-secret-value-42");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_REDIRECT__URI", "https://hub.example.com/oidc/callback");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Гвард

&Тест
Процедура РазделТолькоАдминуХаба() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела(), КукаАдмина).КодСостояния,
		"КОНТРОЛЬ: администратор раздел видит").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела(), КукаАлисы).КодСостояния,
		"обычному пользователю — 403").Равно(403);

	Аноним = Клиент.Тело(Клиент.GET(АдресРаздела()));
	Ожидаем.Что(СтрНайти(Аноним, "providers.section.title"),
		"аноним не видит маркера ключей раздела").Равно(0);
	Ожидаем.Что(СтрНайти(Аноним, "Новый провайдер"),
		"аноним не видит окна заведения провайдера").Равно(0);

КонецПроцедуры

&Тест
Процедура МутацияБезCSRFОтбивается() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("csrf");

	Поля = ПоляСоздания(Имя, Кука);
	Поля.Удалить("_csrf");
	БезТокена = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(БезТокена.КодСостояния, "без CSRF — 403").Равно(403);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Имя),
		"провайдер не появился").Равно(0);

	СТокеном = Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука);
	Ожидаем.Что(СТокеном.КодСостояния < 400, "КОНТРОЛЬ: с CSRF мутация проходит").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ФормаИРазметка

&Тест
Процедура ВложенныхФормНаСтраницеРазделаНет() Экспорт

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Клиент.Войти("root", "RootPassw0rd")));

	Открытий = 0;
	Максимум = 0;
	Хвост = HTML;
	Пока Истина Цикл
		ПозицияОткрытия = СтрНайти(Хвост, "<form");
		ПозицияЗакрытия = СтрНайти(Хвост, "</form>");
		Если ПозицияОткрытия = 0 И ПозицияЗакрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ПозицияОткрытия > 0 И (ПозицияЗакрытия = 0 ИЛИ ПозицияОткрытия < ПозицияЗакрытия) Тогда
			Открытий = Открытий + 1;
			Максимум = Макс(Максимум, Открытий);
			Хвост = Сред(Хвост, ПозицияОткрытия + 5);
		Иначе
			Открытий = Открытий - 1;
			Хвост = Сред(Хвост, ПозицияЗакрытия + 7);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Максимум > 0, "формы на странице вообще есть (иначе проверять нечего)").ЭтоИстина();
	Ожидаем.Что(Максимум, "глубина вложенности форм: браузер вложенную форму схлопывает"
		+ " и присоединяет её поля к внешней").Равно(1);
	Ожидаем.Что(Открытий, "все формы закрыты").Равно(0);

КонецПроцедуры

&Тест
Процедура ПресетомЗаводитсяКнопкаВходаИСнимаетсяОбратно() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("github");

	Создание = Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука);
	Ожидаем.Что(Создание.КодСостояния < 400,
		"провайдер заведён вводом только client_id/secret").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, Имя) > 0, "провайдер виден в разделе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресОкна("изменить", Имя), Кука)),
		"oauth2:github") > 0, "синтетический издатель GitHub назначен хабом").ЭтоИстина();

	Вход = Клиент.Тело(Клиент.GET("/login"));
	Ожидаем.Что(СтрНайти(Вход, "/login/oidc/" + Имя) > 0,
		"кнопка провайдера появилась на странице входа").ЭтоИстина();

	Выключение = Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/toggle", ПоляТумблера(Кука, "0"), Кука);
	Ожидаем.Что(Выключение.КодСостояния < 400, "выключение прошло").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/login")), "/login/oidc/" + Имя),
		"выключенный провайдер со страницы входа исчез").Равно(0);

	Удаление = Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", ПоляУдаления(Имя, Кука), Кука);
	Ожидаем.Что(Удаление.КодСостояния < 400, "удаление прошло").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Имя),
		"строка снята").Равно(0);

КонецПроцедуры

&Тест
Процедура СекретКлиентаВРазметкеНеПечатается() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("sec");

	Поля = ПоляСоздания(Имя, Кука);
	Поля.Вставить("секрет", "очень-секретное-значение");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Поля, Кука).КодСостояния < 400).ЭтоИстина();

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)) + Клиент.Тело(Клиент.GETСКукой(
		АдресОкна("изменить", Имя), Кука));
	Ожидаем.Что(СтрНайти(HTML, Имя) > 0, "КОНТРОЛЬ: провайдер на странице есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "очень-секретное-значение"),
		"секрет клиента в разметку не попадает — ни в список, ни в окно правки").Равно(0);

КонецПроцедуры

// Удаление спрашивает подтверждение: без поля подтверждения провайдер цел, а ответ ведёт
// на страницу с открытым окном подтверждения; несовпавшее эхо — 400, провайдер цел.
&Тест
Процедура УдалениеТолькоСПодтверждениемИменем() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("del");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: провайдер заведён").ЭтоИстина();

	// без переходов: клиент по умолчанию идёт за 303 и вернул бы 200 страницы, куда увели
	Первая = Клиент.POSTФормыБезПереходов(АдресРаздела() + "/" + Имя + "/delete", ТолькоТокен(Кука),
		Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Первая.КодСостояния, "без подтверждения — перенаправление").Равно(303);
	Ожидаем.Что(РаскодироватьСтроку(Клиент.ЗаголовокОтвета(Первая, "Location"),
		СпособКодированияСтроки.КодировкаURL), "на адрес окна подтверждения")
		.Равно(АдресРаздела() + "?окно=удалить-" + Имя);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Имя) > 0,
		"провайдер цел").ЭтоИстина();

	Окно = Клиент.Тело(Клиент.GETСКукой(АдресОкна("удалить", Имя), Кука));
	Ожидаем.Что(ЕстьОткрытоеОкно(Окно), "по адресу подтверждение пришло открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "pattern=""" + Имя + """") > 0, "эхо ждёт имя провайдера").ЭтоИстина();

	Чужое = ПоляУдаления(Имя, Кука);
	Чужое.Вставить("провайдер", "чужое-имя");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", Чужое, Кука).КодСостояния,
		"неверное эхо — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Имя) > 0,
		"провайдер цел и после неверного эха").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", ПоляУдаления(Имя, Кука),
		Кука).КодСостояния < 400, "КОНТРОЛЬ: с верным эхом провайдер удаляется").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОкноЗаведенияИСписокИнсталляций

// Пресет выбирается сегментами — радиокнопками одного имени: отмечен ровно один, и выбор
// уходит с формой без скрипта.
&Тест
Процедура ПресетВыбираетсяСегментамиСОднимОтмеченным() Экспорт

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Клиент.Войти("root", "RootPassw0rd")));
	Окно = ОкноЗаведения(HTML);

	Пресеты = ОткрывающиеТеги(Окно, "<input type=""radio"" class=""segments__input"" name=""пресет""");
	Ожидаем.Что(Пресеты.Количество(), "четыре пресета: GitHub, GitLab, Google и свой").Равно(4);
	Отмеченные = Новый Массив();
	Для Каждого Тег Из Пресеты Цикл
		Если СтрНайти(Тег, " checked") > 0 Тогда
			Отмеченные.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Отмеченные.Количество(), "отмечен ровно один пресет").Равно(1);
	Ожидаем.Что(Отмеченные[0], "по умолчанию — GitHub").Содержит("value=""github""");

КонецПроцедуры

// Поля «своего» провайдера в окне есть у любого пресета и уходят пустыми: пресет их не ждёт,
// а заполненное поле, которого пресет не показывает, сервер отбивает.
&Тест
Процедура ПустыеПоляСвоегоПровайдераНеМешаютПресету() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));

	Поля = ИменаПолейФормы(HTML, АдресРаздела());
	Для Каждого Имя Из СтрРазделить("издатель,авторизация,токен,профиль,базовый", ",") Цикл
		Ожидаем.Что(Поля.Получить(Имя), "поле «" + Имя + "» в окне есть и пусто").Равно("");
	КонецЦикла;

	Имя = УникальныеИмена.Имя("traps");
	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("пресет", "github");
	Поля.Вставить("имя", Имя);
	Поля.Вставить("клиент", "Iv1.abcdef");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"форма, собранная как браузером, сохраняется (код " + Ответ.КодСостояния
		+ "; поля: " + СписокКлючей(Поля) + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресОкна("изменить", Имя), Кука)),
		"oauth2:github") > 0, "заведён именно пресетный провайдер: издателя назначил хаб").ЭтоИстина();

	Подделка = ИменаПолейФормы(HTML, АдресРаздела());
	Подделка.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Подделка.Вставить("пресет", "github");
	Подделка.Вставить("имя", УникальныеИмена.Имя("trapf"));
	Подделка.Вставить("клиент", "Iv1.abcdef");
	Подделка.Вставить("секрет", "секрет-значение");
	Подделка.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Подделка.Вставить("издатель", "https://evil.example.com");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Подделка, Кука).КодСостояния,
		"заполненное поле, которого пресет не показывает, — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), "evil.example.com"),
		"и в разделе его нет").Равно(0);

КонецПроцедуры

// Окно правки показывает пресетному провайдеру только то, что пресет не задаёт сам:
// подписи кнопки и значка у GitHub нет, у своего провайдера — есть.
&Тест
Процедура ОкноПравкиПрячетПоляПресета() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	GitHub = УникальныеИмена.Имя("gh");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(GitHub, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: GitHub заведён").ЭтоИстина();
	Поля = ПоляПравки(GitHub, Кука);
	Ожидаем.Что(Поля.Получить("метка"), "GitHub подписи кнопки не показывает").Равно(Неопределено);
	Ожидаем.Что(Поля.Получить("значок"), "и значка").Равно(Неопределено);
	Ожидаем.Что(Поля.Получить("клиент") <> Неопределено, "КОНТРОЛЬ: client_id на месте").ЭтоИстина();

	Свой = УникальныеИмена.Имя("own");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСвоего(Свой, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: свой провайдер заведён").ЭтоИстина();
	ПоляСвоего = ПоляПравки(Свой, Кука);
	Ожидаем.Что(ПоляСвоего.Получить("метка") <> Неопределено, "свой — подпись кнопки").ЭтоИстина();
	Ожидаем.Что(ПоляСвоего.Получить("значок") <> Неопределено, "и значок").ЭтоИстина();

КонецПроцедуры

// Области заводятся окном своего провайдера и стоят в записи и в окне правки.
&Тест
Процедура ОбластиЗадаютсяОкномИВидныВЗаписи() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Имя = УникальныеИмена.Имя("scope");
	Поля = ПоляСвоего(Имя, Кука);
	Поля.Вставить("область", "openid profile email teams.read");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"окно с заданными областями сохраняется (код " + Ответ.КодСостояния + ")").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)),
		"openid profile email teams.read") > 0, "области видны в записи реестра").ЭтоИстина();
	Ожидаем.Что(ПоляПравки(Имя, Кука).Получить("область"),
		"и стоят в окне правки").Равно("openid profile email teams.read");

КонецПроцедуры

// Поле, которого пресет не показывает, сервер не принимает, даже подсунутое формой напрямую.
&Тест
Процедура ПолеВнеПресетаОтбиваетсяСервером() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Поля = ПоляСоздания(УникальныеИмена.Имя("forb"), Кука);
	Поля.Вставить("издатель", "https://evil.example.com");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "издатель в форме пресета — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "вводом оно не меняется") > 0,
		"окно отказа называет причину: " + Лев(Клиент.Тело(Ответ), 400)).ЭтоИстина();
	Ожидаем.Что(ЕстьОткрытоеОкно(Клиент.Тело(Ответ)), "и это открытое окно заведения").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "evil.example.com"), "и в разделе его нет").Равно(0);

	// КОНТРОЛЬ: та же форма без запрещённого поля проходит
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(УникальныеИмена.Имя("okforb"), Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: без запрещённого поля заведение проходит").ЭтоИстина();

КонецПроцедуры

// Значок печатается в разметку — принимается только бренд кита из набора.
&Тест
Процедура ПодделанныйКлючЗначкаОтбивается() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Поля = ПоляСвоего(УникальныеИмена.Имя("ico"), Кука);
	Поля.Вставить("значок", "../../openhub.css");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "подделанный ключ значка — 400").Равно(400);

	Имя = УникальныеИмена.Имя("icook");
	Хороший = ПоляСвоего(Имя, Кука);
	Хороший.Вставить("значок", "бренд:authentik");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Хороший, Кука).КодСостояния < 400,
		"КОНТРОЛЬ: бренд кита принимается").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "icon--brand") > 0, "в списке провайдеров значок — логотип бренда кита")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "../../openhub.css"), "подделки в разметке нет").Равно(0);

КонецПроцедуры

// Реестр провайдеров раскрывается нативным <details>, а действия записи — ссылки и формы.
&Тест
Процедура РеестрРаскрываетсяИДействуетБезJS() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("det");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400).ЭтоИстина();

	БезСкриптов = БезТегов(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), "<script", "</script>");

	Ожидаем.Что(СтрНайти(БезСкриптов, "<details class=""panel entry__panel""") > 0,
		"запись — нативный <details>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<summary class=""panel__head entry__head""") > 0,
		"свёрнутая строка — <summary>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, Имя) > 0, "имя провайдера видно свёрнутым").ЭтоИстина();
	Для Каждого Вид Из СтрРазделить("изменить,страны,удалить", ",") Цикл
		Ожидаем.Что(СтрНайти(БезСкриптов, "href=""" + АдресОкна(Вид, Имя) + """") > 0,
			"окно «" + Вид + "» — обычная ссылка на адрес с окном").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(БезСкриптов, "action=""" + АдресРаздела() + "/" + Имя + "/toggle""") > 0,
		"тумблер — форма с кнопкой").ЭтоИстина();

КонецПроцедуры

// Окно «Новый провайдер» без скрипта: стоит на странице формой с обычной кнопкой отправки,
// по адресу ?окно=новый приходит открытым; инлайновых обработчиков нет.
&Тест
Процедура ОкноЗаведенияРаботаетБезJS() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	БезСкриптов = БезТегов(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), "<script", "</script>");

	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onsubmit="), "и обработчиков отправки тоже").Равно(0);

	Окно = ОкноЗаведения(БезСкриптов);
	Ожидаем.Что(Окно, "окно заведения — форма на адрес раздела")
		.Содержит("action=""" + АдресРаздела() + """");
	Ожидаем.Что(Окно, "заведение — обычная кнопка отправки формы").Содержит("type=""submit""");
	Поля = ИменаПолейФормы(БезСкриптов, АдресРаздела());
	Ожидаем.Что(Поля.Получить("имя") <> Неопределено, "поле имени на месте").ЭтоИстина();
	Ожидаем.Что(Поля.Получить("клиент") <> Неопределено, "и client_id").ЭтоИстина();

	Ожидаем.Что(ЕстьОткрытоеОкно(БезСкриптов), "на странице окно закрыто").ЭтоЛожь();
	Ожидаем.Что(ЕстьОткрытоеОкно(Клиент.Тело(Клиент.GETСКукой(АдресОкна("новый", ""), Кука))),
		"по адресу ?окно=новый оно открыто").ЭтоИстина();

КонецПроцедуры

// redirect_uri считается из адреса хаба и отдаётся готовым к копированию; незаданный URL
// инстанса объясняется на экране, а не даёт молча пустой адрес.
&Тест
Процедура АдресВозвратаСчитаетсяИзАдресаХаба() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	// адрес хаба не задан: окно говорит, почему адреса возврата нет
	Пустой = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Пустой, "Адрес возврата не определён") > 0,
		"незаданный адрес хаба объяснён на экране").ЭтоИстина();

	Ожидаем.Что(ЗадатьАдресХаба("https://hub.example.com/", Кука) < 400,
		"адрес хаба сохраняется").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "https://hub.example.com/oidc/callback") > 0,
		"redirect_uri собран из адреса хаба и показан готовым к копированию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "data-copy=""https://hub.example.com/oidc/callback""") > 0,
		"у блока есть кнопка копирования").ЭтоИстина();

	// пусто в поле возврата = считать автоматически
	Имя = УникальныеИмена.Имя("auto");
	Поля = ПоляСоздания(Имя, Кука);
	Поля.Вставить("возврат", "");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Поля, Кука).КодСостояния < 400,
		"пустое поле возврата принимается: адрес считается сам").ЭтоИстина();

	// заполнено — используется как есть (хаб за прокси с другим внешним адресом)
	Прокси = УникальныеИмена.Имя("proxy");
	ПоляПрокси = ПоляСоздания(Прокси, Кука);
	ПоляПрокси.Вставить("возврат", "https://outer.example.com/oidc/callback");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляПрокси, Кука).КодСостояния < 400).ЭтоИстина();

	После = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(После, "https://outer.example.com/oidc/callback") > 0,
		"ручной адрес возврата остаётся как есть").ЭтоИстина();

	Ожидаем.Что(ЗадатьАдресХаба("не-адрес", Кука),
		"невалидный адрес хаба отбивается").Равно(400);
	Ожидаем.Что(ЗадатьАдресХаба("https://hub.example.com/путь/мусор", Кука),
		"и адрес с путём — тоже").Равно(400);

КонецПроцедуры

// Провайдер из конфигурации показывается только на чтение, и изменить его не даёт сервер,
// а не разметка.
&Тест
Процедура ПровайдерИзКонфигурацииНеПравитсяСервером() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Окно = Клиент.Тело(Клиент.GETСКукой(АдресОкна("изменить", "envonly"), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "envonly") > 0,
		"провайдер из окружения виден в списке инсталляций").ЭтоИстина();
	Ожидаем.Что(ЕстьОткрытоеОкно(Окно), "КОНТРОЛЬ: окно провайдера открыто на чтение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел + Окно, АдресРаздела() + "/envonly/save"),
		"формы правки у него нет ни в списке, ни в окне").Равно(0);
	Ожидаем.Что(СтрНайти(Раздел, "href=""" + АдресОкна("удалить", "envonly") + """"),
		"и удаления в меню нет").Равно(0);
	Ожидаем.Что(СтрНайти(Раздел + Окно, "env-secret-значение"),
		"и секрет из окружения в разметку не попадает").Равно(0);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Раздел));
	Поля.Вставить("клиент", "подменённый-client");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");

	Провалы = "";
	Для Каждого Хвост Из СтрРазделить("/save,/toggle", ",") Цикл
		Ответ = Клиент.POSTФормы(АдресРаздела() + "/envonly" + Хвост, Поля, Кука);
		Если Ответ.КодСостояния < 400 Тогда
			Провалы = Провалы + Символы.ПС + Хвост + " → " + Ответ.КодСостояния;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Провалы, "точки, поддавшиеся правке провайдера из конфигурации:" + Провалы).Равно("");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), "подменённый-client"),
		"подмена не применилась").Равно(0);

КонецПроцедуры

// Экран входа: у пресетного провайдера логотип его бренда, у своего — выбранный, у провайдера
// без значка — глиф «ключ» набора кита; кнопки идут столбиком во всю ширину.
&Тест
Процедура КнопкиВходаНесутЗначкиИИдутСтолбиком() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Пресетный = УникальныеИмена.Имя("vgh");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Пресетный, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: пресетный провайдер заведён").ЭтоИстина();

	Свой = УникальныеИмена.Имя("vown");
	ПоляСвоегоПровайдера = ПоляСвоего(Свой, Кука);
	ПоляСвоегоПровайдера.Вставить("значок", "google");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСвоегоПровайдера, Кука).КодСостояния < 400,
		"КОНТРОЛЬ: свой провайдер заведён").ЭтоИстина();

	HTML = Клиент.Тело(Клиент.GET("/login"));
	БезСкриптов = БезТегов(HTML, "<script", "</script>");

	Ожидаем.Что(КнопкаВхода(БезСкриптов, Пресетный), "у пресетного провайдера логотип бренда")
		.Содержит("icon--brand");
	Ожидаем.Что(КнопкаВхода(БезСкриптов, Свой), "у своего провайдера — выбранный бренд")
		.Содержит("icon--brand");
	Ожидаем.Что(КнопкаВхода(БезСкриптов, Свой), "КОНТРОЛЬ: и это логотип Google — цветом бренда")
		.Содержит("fill=""#4285F4""");
	Ожидаем.Что(СтрНайти(БезСкриптов, "class=""button__pic"""), "картинок статики на кнопках нет")
		.Равно(0);

	// провайдер окружения значка не задаёт и бренда не угадать — у него глиф «ключ»
	Ожидаем.Что(КнопкаВхода(БезСкриптов, "envonly"), "у провайдера окружения — глиф набора")
		.Содержит("<svg class=""icon""");

	Ожидаем.Что(СтрНайти(БезСкриптов, "<div class=""stack"">") > 0,
		"кнопки входа идут столбиком").ЭтоИстина();
	Ожидаем.Что(КнопкаВхода(БезСкриптов, Пресетный), "и растянуты во всю ширину")
		.Содержит("button--block");

КонецПроцедуры

// Кнопка входа через провайдера целиком: от <a до </a> со ссылкой на старт его входа.
Функция КнопкаВхода(Знач HTML, Знач Имя)

	Позиция = СтрНайти(HTML, "href=""/login/oidc/" + Имя + """");
	Ожидаем.Что(Позиция, "КОНТРОЛЬ: кнопка провайдера «" + Имя + "» на странице входа").Больше(0);
	Хвост = Сред(HTML, СтрНайти(HTML, "<a ", НаправлениеПоиска.СКонца, Позиция));
	Возврат Лев(Хвост, СтрНайти(Хвост, "</a>") + 3);

КонецФункции

// Протокол своего провайдера — сегменты: у OpenID Connect набор — издатель, у OAuth 2.0 —
// точки авторизации, токена и профиля; без нужного набора сервер не заводит.
&Тест
Процедура НаборПолейСвоегоПровайдераЗависитОтПротокола() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Окно = ОкноЗаведения(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)));

	Ожидаем.Что(ПанельСегмента(Окно, "oidc"), "у OpenID Connect — издатель")
		.Содержит("name=""издатель""");
	ПанельOAuth = ПанельСегмента(Окно, "oauth2");
	Для Каждого Точка Из СтрРазделить("авторизация,токен,профиль,письма", ",") Цикл
		Ожидаем.Что(ПанельOAuth, "у OAuth 2.0 — точка «" + Точка + "»")
			.Содержит("name=""" + Точка + """");
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Окно, "/.well-known/openid-configuration") > 0,
		"справка издателя называет документ дискавери").ЭтоИстина();

	БезТочек = ПоляСвоего(УникальныеИмена.Имя("ownbad"), Кука, "oauth2");
	БезТочек.Вставить("токен", "");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), БезТочек, Кука).КодСостояния,
		"OAuth 2.0 без точки токена — 400").Равно(400);

	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСвоего(УникальныеИмена.Имя("ownok"), Кука, "oauth2"),
		Кука).КодСостояния < 400, "КОНТРОЛЬ: с точками — заведён").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПравкаИГвардыИзРазметки

&Тест
Процедура ПравкаСобственнойФормойОкна() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("edit");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: провайдер заведён").ЭтоИстина();

	Поля = ПоляПравки(Имя, Кука);
	Ожидаем.Что(Поля.Количество() > 0,
		"окно правки для " + Имя + " по адресу есть (иначе проверять нечего)").ЭтоИстина();

	Ответ = Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/save", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"СОБСТВЕННАЯ форма окна правки обязана сохраняться (код " + Ответ.КодСостояния
		+ "; поля формы: " + СписокКлючей(Поля) + ")").ЭтоИстина();

КонецПроцедуры

// Пресет прячет поля, которыми распоряжается сам: у пресетного провайдера подписи кнопки
// и значка в окне правки нет, у своего — есть.
&Тест
Процедура СоставФормыПравкиЗафиксирован() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("cmp");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400).ЭтоИстина();

	Ожидаем.Что(СписокКлючей(СоставОкнаПравки(Имя, Кука)), "состав окна правки пресетного провайдера").Равно(
		"_csrf, автосоздание, включить, возврат, клейм, клиент, область, префикс,"
		+ " провижининг, связка, секрет");

	Свой = УникальныеИмена.Имя("cmpown");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСвоего(Свой, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: свой провайдер заведён").ЭтоИстина();

	Ожидаем.Что(СписокКлючей(СоставОкнаПравки(Свой, Кука)), "состав окна правки своего провайдера").Равно(
		"_csrf, автосоздание, включить, возврат, значок, клейм, клиент, метка, область,"
		+ " префикс, провижининг, связка, секрет");

КонецПроцедуры

&Тест
Процедура ЛишниеПоляЛичностиВТелеПравкиИгнорируются() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("extra");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: провайдер заведён пресетом github").ЭтоИстина();

	Действие = АдресРаздела() + "/" + Имя + "/save";
	Поля = ПоляПравки(Имя, Кука);
	Ожидаем.Что(Поля.Количество() > 0, "окно правки по адресу есть").ЭтоИстина();

	Поля.Вставить("пресет", "google");
	Поля.Вставить("протокол", "oidc");
	Поля.Вставить("издатель", "https://evil.example.com");
	Поля.Вставить("авторизация", "https://169.254.169.254/authorize");
	Поля.Вставить("токен", "https://10.0.0.5/token");
	Поля.Вставить("профиль", "https://127.0.0.1/user");
	Поля.Вставить("метка", "правка с лишними полями");
	Поля.Вставить("область", "user:email правка-состоялась");

	Ответ = Клиент.POSTФормы(Действие, Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"правка с лишними полями проходит (код " + Ответ.КодСостояния + ")").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Окно = Клиент.Тело(Клиент.GETСКукой(АдресОкна("изменить", Имя), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "правка-состоялась") > 0,
		"изменяемое поле применилось — значит правка действительно состоялась").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "правка с лишними полями"),
		"подпись кнопки пресета телом правки не перебивается").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, "oauth2:github") > 0,
		"издатель остался синтетическим издателем пресета").ЭтоИстина();
	Для Каждого Ядовитый Из СтрРазделить("evil.example.com,169.254.169.254,10.0.0.5", ",") Цикл
		Ожидаем.Что(СтрНайти(Раздел + Окно, Ядовитый), "в разделе нет <" + Ядовитый + ">").Равно(0);
	КонецЦикла;

	Плохой = ПоляСоздания(УникальныеИмена.Имя("extra2"), Кука);
	Плохой.Вставить("пресет", "own");
	Плохой.Вставить("протокол", "oauth2");
	Плохой.Вставить("авторизация", "https://idp.example.com/authorize");
	Плохой.Вставить("токен", "https://10.0.0.5/token");
	Плохой.Вставить("профиль", "https://idp.example.com/user");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Плохой, Кука).КодСостояния,
		"КОНТРОЛЬ: при заведении приватный адрес — 400").Равно(400);

КонецПроцедуры

&Тест
Процедура ОбычныйПользовательНеМутируетНиОднуТочку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Имя = УникальныеИмена.Имя("guard");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, КукаАдмина), КукаАдмина).КодСостояния < 400,
		"КОНТРОЛЬ: админ завёл").ЭтоИстина();

	ТокенАлисы = ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", КукаАлисы)));

	Точки = Новый Массив();
	Точки.Добавить(АдресРаздела());
	Точки.Добавить(АдресРаздела() + "/" + Имя + "/save");
	Точки.Добавить(АдресРаздела() + "/" + Имя + "/toggle");
	Точки.Добавить(АдресРаздела() + "/" + Имя + "/delete");

	Провалы = "";
	Для Каждого Точка Из Точки Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", ТокенАлисы);
		Поля.Вставить("имя", Имя);
		Поля.Вставить("включить", "0");
		Ответ = Клиент.POSTФормы(Точка, Поля, КукаАлисы);
		Если Ответ.КодСостояния < 400 Тогда
			Провалы = Провалы + Символы.ПС + Точка + " → " + Ответ.КодСостояния;
		КонецЕсли;
	КонецЦикла;

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Раздел, Имя) > 0, "провайдер не удалён Алисой").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", ПоляУдаления(Имя, КукаАдмина),
		КукаАдмина).КодСостояния < 400, "КОНТРОЛЬ: админ удаляет").ЭтоИстина();

	Ожидаем.Что(Провалы, "точки, поддавшиеся обычному пользователю:" + Провалы).Равно("");

КонецПроцедуры

&Тест
Процедура БезCSRFНеПроходитНиОднаТочкаМутации() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("nocsrf");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: заведение прошло").ЭтоИстина();

	Провалы = "";
	Для Каждого Хвост Из СтрРазделить("/save,/toggle,/delete", ",") Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("имя", Имя);
		Поля.Вставить("включить", "0");
		Ответ = Клиент.POSTФормы(АдресРаздела() + "/" + Имя + Хвост, Поля, Кука);
		Если Ответ.КодСостояния < 400 Тогда
			Провалы = Провалы + Символы.ПС + Хвост + " → " + Ответ.КодСостояния;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", ПоляУдаления(Имя, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: с CSRF удаление проходит").ЭтоИстина();

	Ожидаем.Что(Провалы, "точки без CSRF:" + Провалы).Равно("");

КонецПроцедуры

&Тест
Процедура GETНаМутирующиеТочкиНеМутирует() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("getm");
	Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука);

	Клиент.GETСКукой(АдресРаздела() + "/" + Имя + "/delete", Кука);
	Клиент.GETСКукой(АдресРаздела() + "/" + Имя + "/toggle", Кука);

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Имя) > 0,
		"GET ничего не удалил").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/login")), "/login/oidc/" + Имя) > 0,
		"GET ничего не выключил").ЭтоИстина();

КонецПроцедуры

