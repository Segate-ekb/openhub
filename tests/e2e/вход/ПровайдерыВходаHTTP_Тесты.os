#КонецОбласти

#Область ЗакрытиеПоСтранам

// Дорога к окну правила серверная: страница приходит с уже открытым окном.
&Тест
Процедура ОкноСтранОткрываетсяСервернойДорогой() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(Кука);

	Список = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Список, "href=""" + АдресОкнаСтран(Имя) + """") > 0,
		"на записи есть дорога к окну правила").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "name=""страны"""),
		"без серверной дороги форма стран на странице не печатается").Равно(0);

	Открытое = Клиент.Тело(Клиент.GETСКукой(АдресОкнаСтран(Имя), Кука));
	Ожидаем.Что(СтрНайти(Открытое, "name=""страны""") > 0, "поле стран напечатано").ЭтоИстина();
	Ожидаем.Что(ЕстьОткрытоеОкно(Открытое), "окно пришло открытым").ЭтоИстина();

КонецПроцедуры

// Окно правила стоит вне всех раскрывашек — и открытое ссылкой, и после отбитой формы:
// свёрнутая карточка провайдера его не прячет.
&Тест
Процедура ОкноСтранСтоитВнеСвёрнутойКарточки() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(Кука);

	Открытое = Клиент.Тело(Клиент.GETСКукой(АдресОкнаСтран(Имя), Кука));
	Ожидаем.Что(ЕстьОткрытоеОкно(Открытое), "КОНТРОЛЬ: окно пришло открытым").ЭтоИстина();
	Ожидаем.Что(ГлубинаРаскрывашекУОкна(Открытое),
		"открытое окно не вложено ни в одну раскрывашку").Равно(0);
	Ожидаем.Что(СтрНайти(Открытое, Имя) > 0,
		"окно само называет провайдера — карточка рядом с ним не стоит").ЭтоИстина();

	Отбитое = Клиент.Тело(Клиент.POSTФормы(АдресДействияСтран(Имя),
		ПоляСтран(Имя, Кука, "RU, QQ"), Кука));
	Ожидаем.Что(ЕстьОткрытоеОкно(Отбитое), "КОНТРОЛЬ: отбитая форма вернулась окном").ЭтоИстина();
	Ожидаем.Что(ГлубинаРаскрывашекУОкна(Отбитое),
		"и это окно тоже вне раскрывашек").Равно(0);

КонецПроцедуры

&Тест
Процедура СохранениеСтранПишетПравилоИЗаписьАудита() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(Кука);

	Ответ = Клиент.POSTФормы(АдресДействияСтран(Имя), ПоляСтран(Имя, Кука, "by, RU"), Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400, "правило сохранено").ЭтоИстина();

	Список = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Список, "закрыт: BY, RU") > 0,
		"строка правила видна на карточке").ЭтоИстина();
	Ожидаем.Что(ЗначениеПоляСтран(Клиент.Тело(Клиент.GETСКукой(АдресОкнаСтран(Имя), Кука))),
		"в окне стоит действующее правило").Равно("BY, RU");

	Журнал = Клиент.Тело(Клиент.GETСКукой("/hub/settings/audit", Кука));
	Ожидаем.Что(СтрНайти(Журнал, "провайдер.геоправило") > 0,
		"правка правила записана в журнал аудита").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НегоднаяСтранаВозвращаетОткрытоеОкноСПричинойИНабранным() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(Кука);

	Ответ = Клиент.POSTФормы(АдресДействияСтран(Имя), ПоляСтран(Имя, Кука, "RU, QQ"), Кука);
	Ожидаем.Что(Ответ.КодСостояния, "негодный код — отказ").Равно(400);

	Тело = Клиент.Тело(Ответ);
	Ожидаем.Что(ЕстьОткрытоеОкно(Тело), "окно вернулось открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "QQ") > 0, "причина называет сам код").ЭтоИстина();
	Ожидаем.Что(ЗначениеПоляСтран(Тело), "набранное не съедено").Равно("RU, QQ");

	Свежее = Клиент.Тело(Клиент.GETСКукой(АдресОкнаСтран(Имя), Кука));
	Ожидаем.Что(ЗначениеПоляСтран(Свежее), "правило так и не поставлено").Равно("");

КонецПроцедуры

// Файла базы стран на этом стенде нет, и правило поэтому закрывает провайдера всем:
// неизвестная страна считается закрытой. Администратор обязан прочитать это ДО сохранения.
&Тест
Процедура ОкноСтранГоворитЧтоПравилоЗакрываетВсем() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(Кука);

	Открытое = Клиент.Тело(Клиент.GETСКукой(АдресОкнаСтран(Имя), Кука));

	Ожидаем.Что(СтрНайти(Открытое, "закрывает провайдера всем") > 0,
		"окно называет следствие прямо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Открытое, "файла базы нет") > 0,
		"и говорит, чего хабу не хватает").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Открытое, "dbip-country-lite.csv") > 0,
		"называя путь, по которому файл кладут").ЭтоИстина();

КонецПроцедуры

// Карточка закрытого провайдера говорит то же, что окно; вхождения считаются до и после —
// у соседей на странице свои правила.
&Тест
Процедура КарточкаСПравиломГоворитЧтоЗакрытоВсемБезОткрытогоОкна() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(Кука);

	Оговорка = "закрывает провайдера всем";
	ДоПравила = ЧислоВхождений(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Оговорка);

	Ответ = Клиент.POSTФормы(АдресДействияСтран(Имя), ПоляСтран(Имя, Кука, "RU"), Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400, "правило поставлено").ЭтоИстина();

	Список = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(ЧислоВхождений(Список, Оговорка) - ДоПравила,
		"карточка с правилом принесла ровно одну оговорку").Равно(1);
	Ожидаем.Что(СтрНайти(Список, "name=""страны"""),
		"и это БЕЗ открытого окна — форма стран не печаталась").Равно(0);

КонецПроцедуры

// Условие лицензии базы (CC BY 4.0): ссылка стоит там, где хаб пользуется результатом,
// и только пока правило есть, а база загружена. Базы на этом стенде нет — ссылки нет.
