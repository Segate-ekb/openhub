	Ожидаем.Что(Ответ.КодСостояния < 400, "КОНТРОЛЬ: правило поставлено").ЭтоИстина();

	Список = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Список, "IP Geolocation by DB-IP"),
		"база не загружена — атрибуции не печатаем").Равно(0);

КонецПроцедуры

// Поле стран принимает произвольный текст, а отказ его называет: набранное доезжает
// до страницы и обязано доехать данными, а не разметкой.
&Тест
Процедура ПодделкаВПолеСтранНеВыходитСыройРазметкой() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(Кука);
	Подделка = "RU""><script>alert(1)</script>";

	Ответ = Клиент.POSTФормы(АдресДействияСтран(Имя), ПоляСтран(Имя, Кука, Подделка), Кука);
	Ожидаем.Что(Ответ.КодСостояния, "подделка отбита").Равно(400);

	Тело = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело, "<script>alert(1)</script>"),
		"сырого тега в теле нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "alert(1)") > 0,
		"КОНТРОЛЬ: набранное на странице есть — значит, оно экранировано, а не вырезано")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравилоПоСтранеТребуетАдминаИТокена() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Имя = ЗавестиПровайдераДляСтран(КукаАдмина);
	Поля = ПоляСтран(Имя, КукаАдмина, "RU");

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Ожидаем.Что(Клиент.POSTФормы(АдресДействияСтран(Имя), Поля, КукаАлисы).КодСостояния,
		"не администратору — отказ").Равно(403);

	БезТокена = ПоляСтран(Имя, КукаАдмина, "RU");
	БезТокена.Удалить("_csrf");
	Ожидаем.Что(Клиент.POSTФормы(АдресДействияСтран(Имя), БезТокена, КукаАдмина).КодСостояния,
		"без CSRF — отказ").Равно(403);

	Ожидаем.Что(Клиент.POSTФормы(АдресДействияСтран(Имя), Поля, КукаАдмина).КодСостояния < 400,
		"КОНТРОЛЬ: администратор с токеном правило ставит").ЭтоИстина();

КонецПроцедуры

// Окружение описывает, КАК хаб говорит с провайдером, а правило — КОМУ он предлагается:
// «envonly» правке не подлежит, а правило по стране принимает.
&Тест
Процедура ПровайдерИзОкруженияПравилоПоСтранеПринимает() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Ответ = Клиент.POSTФормы(АдресДействияСтран("envonly"),
		ПоляСтран("envonly", Кука, "KZ"), Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400, "правило принято").ЭтоИстина();

	Список = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Список, "закрыт: KZ") > 0,
		"правило видно на карточке провайдера из окружения").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция АдресРаздела()
	Возврат "/hub/settings/providers";
КонецФункции

// Адрес раздела с окном: ?окно=<вид>-<имя>, как его печатает экран.
Функция АдресОкна(Знач Вид, Знач Имя)
	Значение = ?(ЗначениеЗаполнено(Имя), Вид + "-" + Имя, Вид);
	Возврат АдресРаздела() + "?" + Закодировать("окно") + "=" + Закодировать(Значение);
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция АдресОкнаСтран(Знач Имя)
	Возврат АдресОкна("страны", Имя);
КонецФункции

Функция АдресДействияСтран(Знач Имя)
	Возврат АдресРаздела() + "/" + Имя + "/countries";
КонецФункции

// Поля берутся с той же страницы, что видит браузер: токен и имя поля — из разметки.
Функция ПоляСтран(Знач Имя, Знач Кука, Знач Страны)

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресОкнаСтран(Имя), Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("страны", Страны);
	Возврат Поля;

КонецФункции

Функция ЗавестиПровайдераДляСтран(Знач Кука)

	Имя = УникальныеИмена.Имя("geo");
	Ответ = Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400, "провайдер для стенда заведён").ЭтоИстина();
	Возврат Имя;

КонецФункции

// Что стоит в поле стран — значение самого поля, а не наличие строки где-то на странице.
Функция ЗначениеПоляСтран(Знач HTML)

	Позиция = СтрНайти(HTML, "name=""страны""");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// значение ищется ВНУТРИ своего тега: у пустого поля атрибута value нет вовсе,
	// и поиск по всей странице подобрал бы чужой — скрытое поле токена соседней формы
	Хвост = Сред(HTML, Позиция);
	КонецТега = СтрНайти(Хвост, ">");
	Тег = ?(КонецТега = 0, Хвост, Лев(Хвост, КонецТега));

	ПозицияЗначения = СтрНайти(Тег, "value=""");
	Если ПозицияЗначения = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, ПозицияЗначения + 7);
	Кавычка = СтрНайти(Остаток, """");
	Возврат ?(Кавычка = 0, "", Лев(Остаток, Кавычка - 1));

КонецФункции

Функция ЧислоВхождений(Знач Текст, Знач Подстрока)

	Итог = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Подстрока);
	Пока Позиция > 0 Цикл
		Итог = Итог + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Подстрока));
		Позиция = СтрНайти(Хвост, Подстрока);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Во скольких раскрывашках лежит открытое окно: открытые <details> минус закрытые до его начала.
Функция ГлубинаРаскрывашекУОкна(Знач HTML)

	Позиция = ПозицияОткрытогоОкна(HTML);
	Если Позиция = 0 Тогда
		Возврат -1;
	КонецЕсли;

	Начало = Лев(HTML, Позиция - 1);
	Возврат ЧислоВхождений(Начало, "<details") - ЧислоВхождений(Начало, "</details>");

КонецФункции

Функция ПозицияОткрытогоОкна(Знач HTML)

	Позиция = СтрНайти(HTML, "<dialog");
	Пока Позиция > 0 Цикл
		Хвост = Сред(HTML, Позиция);
		Конец = СтрНайти(Хвост, ">");
		Тег = ?(Конец = 0, Хвост, Лев(Хвост, Конец));
		Если СтрНайти(Тег, " open") > 0 Тогда
			Возврат Позиция;
		КонецЕсли;
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Сдвиг = СтрНайти(Сред(HTML, Позиция + 1), "<dialog");
		Позиция = ?(Сдвиг = 0, 0, Позиция + Сдвиг);
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция ЕстьОткрытоеОкно(Знач HTML)
	Возврат ПозицияОткрытогоОкна(HTML) > 0;
КонецФункции

// Поля окна «Новый провайдер» с той же страницы, что видит браузер, выбравший пресет GitHub.
Функция ПоляСоздания(Знач Имя, Знач Кука)

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Поля = ИменаПолейФормы(HTML, АдресРаздела());

	Ожидаем.Что(Поля.Получить("имя") <> Неопределено,
		"окно заведения содержит поле имени (иначе тест шлёт мимо разметки)").ЭтоИстина();
	Ожидаем.Что(Поля.Получить("клиент") <> Неопределено, "и поле client_id").ЭтоИстина();

	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("пресет", "github");
	Поля.Вставить("клиент", "Iv1.abcdef");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");
	Возврат Поля;

КонецФункции

// Поля окна «Новый провайдер» для своего провайдера заданного протокола.
Функция ПоляСвоего(Знач Имя, Знач Кука, Знач Протокол = "oidc")

	Поля = ПоляСоздания(Имя, Кука);
	Поля.Вставить("пресет", "own");
	Поля.Вставить("протокол", Протокол);
	Поля.Вставить("значок", "key");
	Поля.Вставить("клиент", "own-client");
	Поля.Вставить("секрет", "own-secret");

	Если Протокол = "oauth2" Тогда
		Поля.Вставить("авторизация", "https://idp.example.com/authorize");
		Поля.Вставить("токен", "https://idp.example.com/token");
		Поля.Вставить("профиль", "https://idp.example.com/userinfo");
	Иначе
		Поля.Вставить("издатель", "https://idp.example.com");
	КонецЕсли;

	Возврат Поля;

КонецФункции

// Поля окна «Изменить» провайдера — со страницы, которую сервер отдаёт по адресу окна.
Функция ПоляПравки(Знач Имя, Знач Кука)
	HTML = Клиент.Тело(Клиент.GETСКукой(АдресОкна("изменить", Имя), Кука));
	Возврат ИменаПолейФормы(HTML, АдресРаздела() + "/" + Имя + "/save");
КонецФункции

// Состав окна «Изменить»: имена всех полей, которые окно может отправить, — флажок входит
// в состав и неотмеченным (браузер его тогда не шлёт, но поле в окне есть).
Функция СоставОкнаПравки(Знач Имя, Знач Кука)

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресОкна("изменить", Имя), Кука));
	Маркер = "action=""" + АдресРаздела() + "/" + Имя + "/save""";
	Флажки = Новый Соответствие();
	Для Каждого Тег Из ОткрывающиеТеги(МеждуМаркеров(HTML, Маркер, "</form>"), "<input type=""checkbox""") Цикл
		Флажки.Вставить(Клиент.ЗначениеАтрибута(Тег, "name"), Истина);
	КонецЦикла;
	Возврат Клиент.ПоляФормыСо(HTML, Маркер, Флажки);

КонецФункции

// Подтверждённое удаление: поле подтверждения и имя в эхо-поле, как их шлёт окно подтверждения.
Функция ПоляУдаления(Знач Имя, Знач Кука)
	Поля = ТолькоТокен(Кука);
	Поля.Вставить("confirmed", "1");
	Поля.Вставить("провайдер", Имя);
	Возврат Поля;
КонецФункции

// Разметка окна «Новый провайдер»: от его <dialog> до закрывающего.
Функция ОкноЗаведения(Знач HTML)
	Возврат МеждуМаркеров(HTML, "<dialog class=""modal"" id=""provaider-novyi""", "</dialog>");
КонецФункции

// Набор полей сегмента: от его панели до следующей панели сегментов.
Функция ПанельСегмента(Знач HTML, Знач Значение)

	Начало = СтрНайти(HTML, "data-segment=""" + Значение + """");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Сред(Хвост, 2), "class=""segments__panel""");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Функция ПоляТумблера(Знач Кука, Знач Значение)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука))));
	Поля.Вставить("включить", Значение);
	Возврат Поля;
КонецФункции

Функция ТолькоТокен(Знач Кука)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука))));
	Возврат Поля;
КонецФункции

// Записывает адрес хаба через настоящую форму раздела «Основное».
Функция ЗадатьАдресХаба(Знач Значение, Знач Кука)

	Адрес = "/hub/settings/identity";
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(Адрес, Кука))));
	Поля.Вставить("oshub.instance.url", Значение);
	Возврат Клиент.POSTФормы(Адрес, Поля, Кука).КодСостояния;

КонецФункции

// Страница глазами браузера с выключенным JS: содержимое <script> вырезано целиком.
Функция БезТегов(Знач HTML, Знач Открытие, Знач Закрытие)

	Результат = HTML;
	Позиция = СтрНайти(Результат, Открытие);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Результат, Позиция);
		Конец = СтрНайти(Хвост, Закрытие);
		Если Конец = 0 Тогда
			Возврат Лев(Результат, Позиция - 1);
		КонецЕсли;
		Результат = Лев(Результат, Позиция - 1) + Сред(Хвост, Конец + СтрДлина(Закрытие));
		Позиция = СтрНайти(Результат, Открытие);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поля формы с этим действием так, как их соберёт браузер (фикстура КлиентХаба): отключённое
// и всё под <fieldset disabled> не уходит, а у флажков и переключателей — только отмеченные;
// формы нет — пустой набор.
Функция ИменаПолейФормы(Знач HTML, Знач Действие)

	Маркер = "action=""" + Действие + """";
	Если СтрНайти(HTML, Маркер) = 0 Тогда
		Возврат Новый Соответствие();
	КонецЕсли;
	Возврат Клиент.ПоляФормыСо(HTML, Маркер);

КонецФункции

// Открывающие теги, начинающиеся с маркера, целиком — чтобы читать их атрибуты.
Функция ОткрывающиеТеги(Знач HTML, Знач Маркер)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Маркер);

	Пока Позиция > 0 Цикл
		КонецТега = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Позиция);
		Если КонецТега = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Сред(HTML, Позиция, КонецТега - Позиция + 1));
		Следующая = СтрНайти(Сред(HTML, КонецТега + 1), Маркер);
		Позиция = ?(Следующая = 0, 0, КонецТега + Следующая);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МеждуМаркеров(Знач HTML, Знач Открытие, Знач Закрытие)

	Начало = СтрНайти(HTML, Открытие);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Хвост, Закрытие);
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

КонецФункции

Функция СколькоРаз(Знач Текст, Знач Фрагмент)

	Количество = 0;
	Позиция = СтрНайти(Текст, Фрагмент);
	Пока Позиция > 0 Цикл
		Количество = Количество + 1;
		Следующая = СтрНайти(Сред(Текст, Позиция + СтрДлина(Фрагмент)), Фрагмент);
		Позиция = ?(Следующая = 0, 0, Позиция + СтрДлина(Фрагмент) + Следующая - 1);
	КонецЦикла;
	Возврат Количество;

КонецФункции

Функция СписокКлючей(Знач Поля)
	Части = Новый Массив();
	Для Каждого КиЗ Из Поля Цикл
		Части.Добавить(Строка(КиЗ.Ключ));
	КонецЦикла;
	Для Внешний = 0 По Части.Количество() - 2 Цикл
		Для Внутренний = 0 По Части.Количество() - 2 - Внешний Цикл
			Если Части[Внутренний] > Части[Внутренний + 1] Тогда
				Буфер = Части[Внутренний];
				Части[Внутренний] = Части[Внутренний + 1];
				Части[Внутренний + 1] = Буфер;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ИзвлечьCSRF(Знач HTML)

	Маркер = "name=""_csrf""";
	Позиция = СтрНайти(HTML, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Позиция);
	ПозицияЗначения = СтрНайти(Хвост, "value=""");
	Если ПозицияЗначения = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Хвост, ПозицияЗначения + 7);
	Кавычка = СтрНайти(Остаток, """");
	Возврат ?(Кавычка = 0, "", Лев(Остаток, Кавычка - 1));

КонецФункции

#КонецОбласти
