// Права учётки на живом хабе: роль администратора хаба — надстройка, её назначение и снятие
// выданного на пулах не трогают; удалённая учётка уносит свои права из списков прав пула.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — все запросы к подопытному хабу
Перем КаталогСборки;   // временный каталог под .ospx публикаций

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-rights-ospx");

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.ФайловаяБаза("openhub-rights");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.ВыключитьДоставкуВебхуков();
	Хаб.ЗапуститьСидер(Хаб.ПутьСидера("ЗасеятьКабинет.os"));
	Хаб.Запустить();
	Клиент = Новый КлиентХаба(Хаб, 20);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборки);
КонецПроцедуры

#Область РольАдминистратораХаба

// Роль, выданная на пуле экраном «Права доступа», переживает назначение администратором
// и его снятие: человек снова читает приватный пул и публикует в него.
&Тест
Процедура СнятиеАдминаОставляетРольНаПуле() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(ВыдатьРоль(КукаАдмина, "owned", "bob", "райтер").КодСостояния < 400,
		"bob получил роль райтера на пуле owned").ЭтоИстина();

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned", КукаBob).КодСостояния,
		"до повышения bob читает приватный пул").Равно(200);

	СменитьРоль(КукаАдмина, "bob", "admin");
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаBob).КодСостояния,
		"bob — администратор хаба").Равно(200);

	СменитьРоль(КукаАдмина, "bob", "user");
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаBob).КодСостояния,
		"роль администратора снята").Равно(403);

	Ожидаем.Что(Клиент.GETСКукой("/pools/owned", КукаBob).КодСостояния,
		"после снятия роли приватный пул снова читается").Равно(200);
	Ожидаем.Что(СтрНайти(СтрокаПрава(СписокПрав(КукаАдмина, "owned"), "bob"), ">райтер<") > 0,
		"выдача осталась в списке прав пула").ЭтоИстина();

	Ключ = Клиент.ВыпуститьPAT(КукаBob, "read,write", 0);
	Файл = Новый ФикстураПакета().ПостроитьOspx(КаталогСборки, "bob-after-admin", "1.0.0", "# bob");
	Ожидаем.Что(Клиент.ОтправитьПакет("owned", Файл, Ключ).КодСостояния,
		"и публикует в него").Равно(201);

КонецПроцедуры

// Роль участия в пуле тоже не пропадает вместе с ролью администратора.
&Тест
Процедура СнятиеАдминаОставляетВладельцуЕгоПул() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/settings", КукаOwner).КодСостояния,
		"до повышения владелец в доме своего пула").Равно(200);

	СменитьРоль(КукаАдмина, "owner1", "admin");
	СменитьРоль(КукаАдмина, "owner1", "user");

	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаOwner).КодСостояния,
		"роль администратора снята").Равно(403);
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/settings", КукаOwner).КодСостояния,
		"дом своего пула снова открыт").Равно(200);

КонецПроцедуры

// Имя, заведённое администратором в основном пуле, остаётся за ним и после снятия роли хаба.
&Тест
Процедура СнятиеАдминаОставляетЕмуЕгоПакетВОсновномПуле() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаAlice = Клиент.Войти("alice", "AlicePassw0rd");
	Ключ = Клиент.ВыпуститьPAT(КукаAlice, "read,write", 0);
	Сборка = Новый ФикстураПакета();

	СменитьРоль(КукаАдмина, "alice", "admin");
	Ожидаем.Что(Клиент.ОтправитьПакет("public",
		Сборка.ПостроитьOspx(КаталогСборки, "alice-as-admin", "1.0.0", "# alice"), Ключ).КодСостояния,
		"администратор заводит имя в основном пуле").Равно(201);

	СменитьРоль(КукаАдмина, "alice", "user");
	Ожидаем.Что(Клиент.ОтправитьПакет("public",
		Сборка.ПостроитьOspx(КаталогСборки, "alice-as-admin", "1.0.1", "# alice"), Ключ).КодСостояния,
		"после снятия роли следующую версию своего пакета она публикует").Равно(201);

КонецПроцедуры

// Суперправо — не выдача: администратора хаба нет в списке прав пула, пока ему там ничего
// не выдано; выданная ему роль появляется в списке обычной строкой.
&Тест
Процедура СуперправаНетВСпискеПравПула() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	СменитьРоль(КукаАдмина, "pub", "admin");

	Список = СписокПрав(КукаАдмина, "secret");
	Ожидаем.Что(СтрокаПрава(Список, "pub"), "назначенного администратора в списке нет").Равно("");
	Ожидаем.Что(СтрокаПрава(Список, "root"), "и того, кто смотрит, тоже").Равно("");

	Ожидаем.Что(ВыдатьРоль(КукаАдмина, "secret", "pub", "читатель").КодСостояния < 400,
		"администратору выдана роль на пуле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаПрава(СписокПрав(КукаАдмина, "secret"), "pub"), ">читатель<") > 0,
		"выданное появляется в списке обычной строкой").ЭтоИстина();

	СменитьРоль(КукаАдмина, "pub", "user");

КонецПроцедуры

#КонецОбласти

#Область УдалениеУчётки

// Выдача удалённой учётки не остаётся в списке прав пула строкой с номером вместо логина.
&Тест
Процедура УдалённаяУчёткаУноситСвоюВыдачуИзСпискаПравПула() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(ВыдатьРоль(КукаАдмина, "secret", "mustchange", "читатель").КодСостояния < 400,
		"mustchange получил роль читателя на пуле secret").ЭтоИстина();
	Ожидаем.Что(СтрокаПрава(СписокПрав(КукаАдмина, "secret"), "mustchange"),
		"КОНТРОЛЬ: выдача видна в списке прав").Заполнено();

	Ид = УдалитьУчётку(КукаАдмина, "mustchange");

	Список = СписокПрав(КукаАдмина, "secret");
	Ожидаем.Что(СтрокаПрава(Список, "mustchange"), "логина в списке прав нет").Равно("");
	Ожидаем.Что(СтрокаПрава(Список, Ид), "и строки-сироты с номером удалённой учётки тоже").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Смена роли тем же ходом, что у администратора: окно подтверждения строки и его форма.
Процедура СменитьРоль(Знач КукаАдмина, Знач Логин, Знач Роль)

	Окно = Клиент.Тело(Клиент.GETСКукой(АдресОкна("роль", Логин), КукаАдмина));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Окно));
	Поля.Вставить("confirmed", "1");
	Поля.Вставить("роль", Роль);
	Ожидаем.Что(Клиент.POSTФормы(АдресУчётки(Логин, "role"), Поля, КукаАдмина).КодСостояния < 400,
		СтрШаблон("роль %1 назначена %2", Роль, Логин)).ЭтоИстина();

КонецПроцедуры

// Удаление с подтверждением логином; возвращает идентификатор удалённой учётки.
Функция УдалитьУчётку(Знач КукаАдмина, Знач Логин)

	Ид = НомерУчётки(КукаАдмина, Логин);
	Окно = Клиент.Тело(Клиент.GETСКукой(АдресОкна("удалить", Логин), КукаАдмина));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Окно));
	Поля.Вставить("confirmed", "1");
	Поля.Вставить("логин", Логин);
	Ожидаем.Что(Клиент.POSTФормы(АдресУчётки(Логин, "delete"), Поля, КукаАдмина).КодСостояния < 400,
		"учётка " + Логин + " удалена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтраницаУчётки(КукаАдмина, Логин), ">" + Логин + "</td>"),
		"КОНТРОЛЬ: учётки больше нет в списке").Равно(0);

	Возврат Ид;

КонецФункции

Функция СтраницаУчётки(Знач КукаАдмина, Знач Логин)
	Возврат Клиент.Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
КонецФункции

// Страница «Пользователи» с открытым окном строки: «?окно=<вид>-<логин>».
Функция АдресОкна(Знач Вид, Знач Логин)
	Возврат "/hub/settings/users?q=" + Логин + "&" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL)
		+ "=" + КодироватьСтроку(Вид + "-" + Логин, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция АдресУчётки(Знач Логин, Знач Действие)
	Возврат "/hub/settings/users/" + Логин + "/" + Действие;
КонецФункции

// Номер учётки — из её прав в API: строка права называет субъекта номером.
Функция НомерУчётки(Знач КукаАдмина, Знач Логин)

	Ключ = Клиент.ВыпуститьPAT(КукаАдмина, "read,write", 0);
	Ответ = Клиент.GETСТокеном("/api/v1/users/" + Логин + "/grants", Ключ);
	Для Каждого Право Из Клиент.ТелоJSON(Ответ).Получить("items") Цикл
		Если Право.Получить("subject_type") = "пользователь" И Право.Получить("subject") = Логин Тогда
			Возврат Формат(Право.Получить("subject_id"), "ЧГ=0; ЧН=0");
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не нашёлся номер учётки " + Логин + ": у неё нет ни одного права";

КонецФункции

// Выдача роли на пуле экраном «Права доступа» от имени администратора.
Функция ВыдатьРоль(Знач Кука, Знач ИмяПула, Знач Субъект, Знач Роль)

	Экран = ЭкранПрав(ИмяПула);
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Экран, Кука))));
	Поля.Вставить("операция", "выдать");
	Поля.Вставить("тип_субъекта", "пользователь");
	Поля.Вставить("субъект", Субъект);
	Поля.Вставить("роль", Роль);
	Возврат Клиент.POSTФормы(Экран, Поля, Кука);

КонецФункции

Функция СписокПрав(Знач Кука, Знач ИмяПула)
	Возврат Клиент.Тело(Клиент.GETСКукой(ЭкранПрав(ИмяПула), Кука));
КонецФункции

Функция ЭкранПрав(Знач ИмяПула)
	Возврат "/pools/" + ИмяПула + "/settings/access";
КонецФункции

// Строка таблицы прав, где субъект назван ячейкой целиком: от её <tr до </tr>; нет — пусто.
// Ищется в теле таблицы: логин смотрящего стоит и в шапке страницы.
Функция СтрокаПрава(Знач Список, Знач Субъект)

	Таблица = Сред(Список, СтрНайти(Список, "<tbody"));
	Таблица = Лев(Таблица, СтрНайти(Таблица, "</tbody>"));
	Позиция = СтрНайти(Таблица, ">" + Субъект + "<");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Таблица, "<tr", НаправлениеПоиска.СКонца, Позиция);
	Конец = СтрНайти(Таблица, "</tr>", , Позиция);
	Возврат Сред(Таблица, Начало, Конец - Начало);

КонецФункции

#КонецОбласти
