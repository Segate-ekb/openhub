// Три двери самостоятельной регистрации на настоящем хабе: на каждое состояние хаба — один статус
// и одна причина; каждое состояние поднимает свой хаб из окружения.

#Использовать asserts
#Использовать "../../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Отказы;        // ОтказыУчётки (вход) — ожидаемое спрашивается у таблицы причин, а не пишется литералом
Перем Тексты;        // ТекстыОтказовВхода (интерфейс) — экранные слова той же причины

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьТаблицу() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЭкземплярХаба");
	ПоискКлассов = Новый КлассыСлоя();

	Модули = ОбъединитьПути(КаталогПроекта(), "src", "модули");
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ОтказыУчётки");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "ТекстыОтказовВхода");

	Отказы = Новый ОтказыУчётки(Новый ТекстОшибки());
	Тексты = Новый ТекстыОтказовВхода(Неопределено, Неопределено, Отказы);

КонецПроцедуры

// Состояния, закрытые решением администратора — режим хаба, выключенный парольный вход,
// ненастроенная почта: все двери отвечают одним статусом.
&Тест
Процедура ЗакрытыйХабОтвечаетОдинаковоВоВсехДверях() Экспорт

	СверитьДвери("openhub-отказ-disabled", ОкружениеРежима("disabled"),
		Отказы.РегистрацияВыключена());
	СверитьДвери("openhub-отказ-invite", ОкружениеРежима("invite"),
		Отказы.ТолькоПоПриглашению());
	СверитьДвери("openhub-отказ-без-пароля", ОкружениеБезПарольногоВхода(),
		Отказы.ПарольныйВходВыключен());
	СверитьДвери("openhub-отказ-без-почты", ОкружениеБезПочты(),
		Отказы.ПочтаНеНастроена());

КонецПроцедуры

// Два запрета сразу: порядок причин принадлежит службе, и двери не выбирают каждая свой.
&Тест
Процедура ДваЗапретаСразуНазываютсяОдинаковоВоВсехДверях() Экспорт
	СверитьДвери("openhub-отказ-два-запрета", ОкружениеДвухЗапретов(),
		Отказы.ПарольныйВходВыключен());
КонецПроцедуры

// Гейт первого запуска: администратора ещё нет, и ни одна дверь не должна пропустить
// анонима — иначе он необратимо закрыл бы мастер /setup.
&Тест
Процедура ГейтПервогоЗапускаОтвечаетОдинаковоВоВсехДверях() Экспорт
	СверитьДвери("openhub-отказ-онбординг", ОкружениеБезАдминистратора(),
		Отказы.ОнбордингНеЗавершён());
КонецПроцедуры

// Данные человека, а не состояние хаба: занятый адрес и занятый логин — отказ один, адрес
// в подробностях есть, чужого логина нет.
&Тест
Процедура ЗанятыйАдресИЛогинОтвечаютОдинаковоВоВсехДверях() Экспорт

	Хаб = НовыйХаб("openhub-отказ-занято", ОкружениеОткрытойРегистрации());
	Попытка
		Порт = Хаб.Порт();
		Ожидаем.Что(РегистрацияAPI(Порт, "/api/v1/register", "pervyj", "zanyato@example.test").Состояние,
			"первая учётка заведена").Равно(201);

		СверитьТриДвери(Порт, Отказы.АдресЗанят(), "novyj", "zanyato@example.test");
		СверитьТриДвери(Порт, Отказы.ЛогинЗанят(), "pervyj", "");

		ПроверитьПодробностиЗанятогоАдреса(Порт);
	Исключение
		Хаб.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Хаб.Остановить();

КонецПроцедуры

#Область Проверки

// Отказ по занятому адресу называет полем только адрес: чужого логина в подробностях нет.
Процедура ПроверитьПодробностиЗанятогоАдреса(Знач Порт)

	Ответ = РегистрацияAPI(Порт, "/api/v1/register", "tretij", "zanyato@example.test");
	Подробности = ТелоJSON(Ответ).Получить("error").Получить("details");

	Ожидаем.Что(Подробности <> Неопределено, "подробности отказа есть: " + Ответ.Тело).ЭтоИстина();
	Ожидаем.Что(Подробности.Получить("email"), "и называют занятый адрес полем")
		.Равно("zanyato@example.test");
	Ожидаем.Что(СтрНайти(Ответ.Тело, "pervyj"), "но не рассказывают, чья это учётка").Равно(0);

	// у отказа без подробностей поля нет вовсе, а не null: негодный логин — общий отказ,
	// подробностям в нём взяться неоткуда
	Негодный = РегистрацияAPI(Порт, "/api/v1/register", "-нельзя-так-", "");
	Ожидаем.Что(Негодный.Состояние, "негодный логин — общий отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Негодный.Тело, "details"),
		"отказ без подробностей поля details не печатает: " + Негодный.Тело).Равно(0);

КонецПроцедуры

// Поднимает хаб в нужном состоянии и спрашивает у него три двери подряд.
Процедура СверитьДвери(Знач Префикс, Знач Окружение, Знач Причина)

	Хаб = НовыйХаб(Префикс, Окружение);
	Попытка
		СверитьТриДвери(Хаб.Порт(), Причина, "novichok", "novichok@example.test");
	Исключение
		Хаб.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Хаб.Остановить();

КонецПроцедуры

// Три двери на одно состояние: статус у всех трёх, машинный код у дверей API, слова формы — по той же причине.
Процедура СверитьТриДвери(Знач Порт, Знач Причина, Знач Логин, Знач Email)

	Ожидаемый = Отказы.Разобрать(Отказы.Ошибка(Причина));
	Подпись = " (причина " + Причина + ")";

	Регистрация = РегистрацияAPI(Порт, "/api/v1/register", Логин, Email);
	Аккаунты = РегистрацияAPI(Порт, "/api/v1/users", Логин, Email);

	Ожидаем.Что(Регистрация.Состояние, "POST /api/v1/register" + Подпись).Равно(Ожидаемый.Статус);
	Ожидаем.Что(Аккаунты.Состояние, "POST /api/v1/users" + Подпись).Равно(Ожидаемый.Статус);
	Ожидаем.Что(КодОшибки(Регистрация), "код /api/v1/register" + Подпись).Равно(Ожидаемый.Код);
	Ожидаем.Что(КодОшибки(Аккаунты), "код /api/v1/users" + Подпись).Равно(Ожидаемый.Код);

	// та же причина — те же поля: подробности не вправе быть у одной двери и не быть у другой
	Ожидаем.Что(ПодробностиСтрокой(Аккаунты), "details /api/v1/users" + Подпись)
		.Равно(ПодробностиСтрокой(Регистрация));

	Форма = РегистрацияФормой(Порт, Логин, Email);
	Ожидаем.Что(Форма.Состояние, "POST /register" + Подпись).Равно(Ожидаемый.Статус);
	Ожидаем.Что(СтрНайти(Форма.Тело, Тексты.ОтказРегистрации(Причина, "")) > 0,
		"форма объясняет ту же причину" + Подпись + ": " + Лев(Форма.Тело, 400)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Окружение

// Хаб с администратором и открытой регистрацией — основа, поверх которой приписывается состояние.
Функция ОкружениеОткрытойРегистрации()
	Переменные = Новый Соответствие();
	Переменные.Вставить("OSHUB_ADMIN_LOGIN", "root");
	Переменные.Вставить("OSHUB_ADMIN_PASSWORD", "RootSecret1");
	Переменные.Вставить("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Возврат Переменные;
КонецФункции

Функция ОкружениеРежима(Знач Режим)
	Переменные = ОкружениеОткрытойРегистрации();
	Переменные.Вставить("OSHUB_AUTH_REGISTRATION_MODE", Режим);
	Возврат Переменные;
КонецФункции

Функция ОкружениеБезПарольногоВхода()
	Переменные = ОкружениеОткрытойРегистрации();
	Переменные.Вставить("OSHUB_AUTH_PASSWORD_ENABLED", "false");
	Возврат Переменные;
КонецФункции

// Подтверждение адреса обещано, а SMTP не настроен — регистрации некуда слать письмо.
Функция ОкружениеБезПочты()
	Переменные = ОкружениеОткрытойРегистрации();
	Переменные.Вставить("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "true");
	Переменные.Вставить("OSHUB_MAIL_ENABLED", "false");
	Возврат Переменные;
КонецФункции

// Выключенный парольный вход и закрытая регистрация сразу: служба называет парольный вход.
Функция ОкружениеДвухЗапретов()
	Переменные = ОкружениеБезПарольногоВхода();
	Переменные.Вставить("OSHUB_AUTH_REGISTRATION_MODE", "disabled");
	Возврат Переменные;
КонецФункции

// Администратора нет — онбординг не пройден.
Функция ОкружениеБезАдминистратора()
	Переменные = ОкружениеОткрытойРегистрации();
	Переменные.Вставить("OSHUB_ADMIN_LOGIN", "");
	Переменные.Вставить("OSHUB_ADMIN_PASSWORD", "");
	Возврат Переменные;
КонецФункции

#КонецОбласти

#Область Инфраструктура

Функция НовыйХаб(Знач Префикс, Знач Окружение)

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.ФайловаяБаза(Префикс);
	Для Каждого Переменная Из Окружение Цикл
		Хаб.Среда(Переменная.Ключ, Переменная.Значение);
	КонецЦикла;
	Хаб.Запустить();
	Возврат Хаб;

КонецФункции

Функция РегистрацияAPI(Знач Порт, Знач Путь, Знач Логин, Знач Email)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрШаблон(
		"{""логин"":""%1"",""email"":""%2"",""пароль"":""ProbnyjPassw0rd""}", Логин, Email),
		КодировкаТекста.UTF8);
	Возврат Ответ(Соединение(Порт).ОтправитьДляОбработки(Запрос));

КонецФункции

Функция РегистрацияФормой(Знач Порт, Знач Логин, Знач Email)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "text/html");
	Запрос = Новый HTTPЗапрос("/register", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрШаблон("логин=%1&email=%2&пароль=ProbnyjPassw0rd",
		КодироватьURL(Логин), КодироватьURL(Email)), КодировкаТекста.UTF8);
	Возврат Ответ(Соединение(Порт).ОтправитьДляОбработки(Запрос));

КонецФункции

Функция Ответ(Знач Сырой)
	Возврат Новый Структура("Состояние, Тело", Сырой.КодСостояния, Сырой.ПолучитьТелоКакСтроку());
КонецФункции

// Подробности отказа одной строкой «поле=значение;…» — для сравнения целиком.
Функция ПодробностиСтрокой(Знач Ответ)

	Ошибка = ТелоJSON(Ответ).Получить("error");
	Подробности = ?(Ошибка = Неопределено, Неопределено, Ошибка.Получить("details"));
	Если Подробности = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Поля = Новый Массив();
	Для Каждого Поле Из Подробности Цикл
		Поля.Добавить(Строка(Поле.Ключ) + "=" + Строка(Поле.Значение));
	КонецЦикла;
	Возврат СтрСоединить(ПоАлфавиту(Поля), ";");

КонецФункции

// Значения в устойчивом порядке: порядок обхода соответствия платформа не обещает.
Функция ПоАлфавиту(Знач Значения)

	Результат = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Место = Результат.Количество();
		Для Индекс = 0 По Результат.Количество() - 1 Цикл
			Если Значение < Результат[Индекс] Тогда
				Место = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить(Место, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КодОшибки(Знач Ответ)
	Ошибка = ТелоJSON(Ответ).Получить("error");
	Возврат ?(Ошибка = Неопределено, "", Строка(Ошибка.Получить("code")));
КонецФункции

Функция ТелоJSON(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.Тело);
	Разобрано = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Разобрано;
КонецФункции

Функция Соединение(Знач Порт)
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 20);
КонецФункции

Функция КодироватьURL(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция КаталогПроекта()
	Возврат КаталогиПроекта.Корень();
КонецФункции

#КонецОбласти
