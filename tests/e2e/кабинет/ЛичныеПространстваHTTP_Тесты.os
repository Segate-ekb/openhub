// Раздел «Пулы» дома «Хаб» живым хабом: выключение личных пространств через окно с эхом,
// включение с раздачей, порог админа хаба. Тесты идут по состоянию стенда в порядке, заданном &Порядок.

#Использовать asserts
#Использовать 1connector
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем Экран;           // фикстура РазделЛичныхПространств — раздел «Пулы» стенда
Перем КаталогПроекта;
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьЛичныеПространства.os");

	// фикстура сборки .ospx: личное пространство доказывается публикацией в него
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб.ФайловаяБаза("openhub-личные-пространства");
	КореньХранилища = Хаб.КореньХранилища();
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	// почты на стенде нет, а регистрация нужна живая: подтверждение адреса выключено
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

	РеестрФикстур.Подключить("РазделЛичныхПространств");
	Экран = Новый РазделЛичныхПространств(Клиент, КореньХранилища);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ПорогАдминаХаба

// Настройка и обе её операции — только админу хаба; тот же адрес и форма от админа принимаются.
&Тест
&Порядок(1)
Процедура НеАдминНиВыключитьНиВключитьНеМожет() Экспорт

	КукаАнны = Клиент.Войти("anna", "AnnaPassw0rd");
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Ожидаем.Что(Клиент.GETСКукой(Экран.Адрес(), КукаАнны).КодСостояния,
		"обычный пользователь раздел «Пулы» не видит").Равно(403);

	// токен со страницы админа: иначе отказ дал бы CSRF, а не гейт роли
	Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Экран.Адрес(), КукаАдмина)));

	Выключение = Новый Соответствие();
	Выключение.Вставить("_csrf", Токен);
	Выключение.Вставить("операция", "личные-пространства");
	Выключение.Вставить("подтверждение", "4");
	Ожидаем.Что(Клиент.POSTФормы(Экран.Адрес(), Выключение, КукаАнны).КодСостояния,
		"и снести чужие пространства не может").Равно(403);

	Включение = Новый Соответствие();
	Включение.Вставить("_csrf", Токен);
	Включение.Вставить("oshub.pools.personal_enabled", "1");
	Ожидаем.Что(Клиент.POSTФормы(Экран.Адрес(), Включение, КукаАнны).КодСостояния,
		"и раздать их всем — тоже").Равно(403);

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "личное пространство anna на месте").ЭтоИстина();

	// КОНТРОЛЬ: тот же адрес и та же форма от админа хаба принимаются
	Ожидаем.Что(Клиент.GETСКукой(Экран.Адрес(), КукаАдмина).КодСостояния,
		"КОНТРОЛЬ: админу хаба раздел открыт").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область ВыключениеЧерезОкноПредупреждения

// Форма берётся из выданной разметки и отправляется ровно теми полями, что отправит браузер:
// снятый тумблер приезжает скрытым полем «0», в ответ — окно предупреждения с числами.
&Тест
&Порядок(2)
Процедура ВыключениеТумблераВедётНаОкноПредупрежденияСЧислами() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Форма = Экран.ПоляСТумблером(КукаАдмина, Ложь);
	Ожидаем.Что(Форма.Получить("oshub.pools.personal_enabled"),
		"форма раздела печатает выключенное значение тумблера").Равно("0");

	Вопрос = Клиент.POSTФормы(Экран.Адрес(), Форма, КукаАдмина);
	Ожидаем.Что(Вопрос.КодСостояния, "выключение спрашивает, а не сохраняет").Равно(200);

	Окно = Клиент.Тело(Вопрос);
	Ожидаем.Что(СтрНайти(Окно, "Выключить личные пространства") > 0,
		"показано окно предупреждения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "Будет удалено безвозвратно") > 0,
		"и в нём числа последствий").ЭтоИстина();
	// сид: четыре личных пространства (root, anna, boris, sleeper) и одно из них с пакетом
	Ожидаем.Что(СтрНайти(Окно, "личных пространств — 4") > 0,
		"число удаляемых пространств посчитано на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "из них с пакетами — 1") > 0, "и непустые среди них").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "пакетов — 1") > 0, "и пакеты").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "версий — 2") > 0, "и версии").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "name=""подтверждение""") > 0,
		"подтверждение — поле ввода, а не галочка").ЭтоИстина();

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "и ни одно пространство ещё не снесено").ЭтоИстина();
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина), "и настройка не изменилась").ЭтоИстина();

КонецПроцедуры

// Браузер схлопывает вложенную форму: окно внутри формы раздела отправило бы эхо с тумблером.
&Тест
&Порядок(3)
Процедура ВложенныхФормНетНиДоОкнаНиВНём() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Раздел = Клиент.Тело(Клиент.GETСКукой(Экран.Адрес(), КукаАдмина));
	Ожидаем.Что(ГлубинаФорм(Раздел), "глубина вложенности форм на разделе «Пулы»").Равно(1);

	Окно = Экран.ОткрытьОкно(КукаАдмина);
	Ожидаем.Что(СтрНайти(Окно, "name=""подтверждение""") > 0, "окно подтверждения показано").ЭтоИстина();
	Ожидаем.Что(ГлубинаФорм(Окно), "глубина вложенности форм на странице с окном").Равно(1);

КонецПроцедуры

// Эхо — точное совпадение строки: всё, что лишь «похоже на число», отвергается.
&Тест
&Порядок(4)
Процедура ПохожиеНаЧислоЭхаОтвергаются() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Окно = Экран.ОткрытьОкно(КукаАдмина);
	Число_ = Экран.ЧислоИзОкна(Окно);

	Ожидаем.Что(Число_, "в окне напечатано число пространств").Равно("4");

	Отвергнуть(Окно, КукаАдмина, "0" + Число_, "ведущий ноль");
	Отвергнуть(Окно, КукаАдмина, Число_ + ".0", "дробная запись");
	Отвергнуть(Окно, КукаАдмина, "-" + Число_, "отрицательное");
	Отвергнуть(Окно, КукаАдмина, "+" + Число_, "со знаком плюс");
	Отвергнуть(Окно, КукаАдмина, Число_ + Число_, "число дважды");
	Отвергнуть(Окно, КукаАдмина, "все", "слово вместо числа");
	Отвергнуть(Окно, КукаАдмина, "", "пустое подтверждение");

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "после всех отказов пространство anna на месте").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("boris"), "и boris").ЭтоИстина();
	Ожидаем.Что(Экран.АртефактЕсть("anna", "anna-lib", "1.0.0"), "и его артефакт").ЭтоИстина();

КонецПроцедуры

// Эхо — точное число удаляемых пространств; ошибся числом — не удалено ничего.
&Тест
&Порядок(5)
Процедура НеверноеЭхоНеУдаляетНичего() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Окно = Экран.ОткрытьОкно(КукаАдмина);

	Поля = Экран.ПоляОкна(Окно);
	Поля.Вставить("подтверждение", "1");    // не то число: пространств больше

	Ответ = Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "неверное эхо — отказ, а не «сохранено»").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Ничего не удалено") > 0,
		"и сказано, что не удалено ничего").ЭтоИстина();

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "пространство anna на месте").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("boris"), "пространство boris на месте").ЭтоИстина();
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина), "настройка тоже не менялась").ЭтоИстина();
	Ожидаем.Что(Экран.АртефактЕсть("anna", "anna-lib", "1.0.0"), "и файл артефакта на месте").ЭтоИстина();

	// пустое подтверждение — тот же отказ: «просто нажать ещё раз» не проходит
	Пустое = Экран.ПоляОкна(Окно);
	Пустое.Вставить("подтверждение", "");
	Ожидаем.Что(Клиент.POSTФормы(Экран.Адрес(), Пустое, КукаАдмина).КодСостояния,
		"пустое подтверждение тоже отвергнуто").Равно(400);
	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "и снова ничего не снесено").ЭтоИстина();

КонецПроцедуры

// Верное эхо сносит личные пространства с пакетами, версиями и файлами, обычный пул не
// трогает и оставляет след в журнале аудита с автором.
&Тест
&Порядок(6)
Процедура ВерноеЭхоСноситПространстваИПишетВАудит() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Окно = Экран.ОткрытьОкно(КукаАдмина);

	Поля = Экран.ПоляОкна(Окно);
	Поля.Вставить("подтверждение", Экран.ЧислоИзОкна(Окно));

	Ответ = Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "верное эхо принято").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Личные пространства выключены") > 0,
		"итог операции показан с числами").ЭтоИстина();

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "личное пространство anna снесено").ЭтоЛожь();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("boris"), "и boris тоже").ЭтоЛожь();
	Ожидаем.Что(Экран.АртефактЕсть("anna", "anna-lib", "1.0.0"),
		"файл артефакта личного пространства снят с диска").ЭтоЛожь();
	Ожидаем.Что(Экран.АртефактЕсть("anna", "anna-lib", "1.1.0"), "обе версии").ЭтоЛожь();
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина), "настройка выключена").ЭтоЛожь();

	// обычный пул каскад не трогает — отбор идёт по типу пула
	Ожидаем.Что(Клиент.GET("/pools/shared/packages/shared-lib").КодСостояния, "обычный пул на месте").Равно(200);
	Ожидаем.Что(Экран.АртефактЕсть("shared", "shared-lib", "1.0.0"),
		"и его артефакт тоже").ЭтоИстина();

	// числа операции проверяет ЛичныеПространства_Тесты, здесь — что запись дошла до экрана
	Журнал = Клиент.Тело(Клиент.GETСКукой("/hub/settings/audit", КукаАдмина));
	Ожидаем.Что(СтрНайти(Журнал, "<td>root</td><td>пространства.личные.снесены</td>") > 0,
		"снос записан в журнал аудита, автор — вошедший администратор").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Включение

// Включение подтверждения не требует и раздаёт пространства всем существующим учёткам,
// кроме отключённой; продолжает состояние после сноса.
&Тест
&Порядок(7)
Процедура ВключениеРаздаётПространстваВсемКромеОтключённой() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	// состояние после сноса: настройка выключена, личных пространств нет
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина), "исходно настройка выключена").ЭтоЛожь();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "и личных пространств нет").ЭтоЛожь();

	Поля = Экран.ПоляСТумблером(КукаАдмина, Истина);

	Ответ = Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "включение выполняется без подтверждения").Равно(200);

	Итог = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Итог, "Личные пространства включены") > 0, "итог показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итог, "создано — 3") > 0,
		"пространства созданы всем активным учёткам, а не только будущим").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итог, "пропущено отключённых учёток — 1") > 0,
		"отключённая учётка пропущена").ЭтоИстина();

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "у anna пространство появилось").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("boris"), "у boris тоже").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("sleeper"), "у отключённой учётки — нет").ЭтоЛожь();
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина), "настройка включена").ЭтоИстина();

	// след раздачи в аудите — там же, в ЛичныеПространства_Тесты

КонецПроцедуры

// Повторное включение при включённой настройке — не переход: раздачи нет, отказа тоже.
&Тест
&Порядок(8)
Процедура ПовторноеВключениеНичегоНеМеняет() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "пространства уже розданы").ЭтоИстина();

	Поля = Экран.ПоляСТумблером(КукаАдмина, Истина);

	Ответ = Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния < 400, "повторное включение принято без отказа").ЭтоИстина();

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "пространство anna на месте").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("boris"), "и boris").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("sleeper"), "отключённая учётка по-прежнему без пространства").ЭтоЛожь();
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина), "настройка по-прежнему включена").ЭтоИстина();

	// а повторная РАЗДАЧА (снос и включение заново) дублей не плодит и не падает
	Окно = Экран.ОткрытьОкно(КукаАдмина);
	Снос = Экран.ПоляОкна(Окно);
	Снос.Вставить("подтверждение", Экран.ЧислоИзОкна(Окно));
	Клиент.POSTФормы(Экран.Адрес(), Снос, КукаАдмина);

	Повтор = Клиент.Тело(Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина));
	Ожидаем.Что(СтрНайти(Повтор, "создано — 3") > 0,
		"вторая раздача заводит ровно те же три пространства").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "и anna снова со своим пространством").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПространствоНовойУчётки

// Пространство появляется у зарегистрировавшегося само, называется его логином, и владелец
// сразу публикует в него по адресу /{логин}/{пакет}.
&Тест
&Порядок(9)
Процедура ЗарегистрировавшийсяПолучаетСвоёПространствоИСразуВНегоПубликует() Экспорт

	Логин = "newcomer";
	Ожидаем.Что(ЗавестиУчётку(Логин).КодСостояния, "учётка заведена").Равно(201);

	Ожидаем.Что(Клиент.GET("/pools/" + Логин).КодСостояния,
		"пространство появилось само и названо логином").Равно(200);

	Токен = Клиент.ВыпуститьPAT(Клиент.Войти(Логин, ПарольНовичка()));
	Ожидаем.Что(ЗначениеЗаполнено(Токен), "владелец выпустил себе ключ").ЭтоИстина();

	ИмяПакета = "newcomer-lib";
	Публикация = Опубликовать(Логин, ИмяПакета, "1.0.0", Токен);
	Ожидаем.Что(Публикация.КодСостояния,
		"владелец публикует в своё пространство, ничего не выпрашивая: "
		+ Клиент.Тело(Публикация)).Равно(201);

	Ожидаем.Что(Клиент.GET("/pools/" + Логин + "/packages/" + ИмяПакета).КодСостояния,
		"и пакет лежит по адресу /{логин}/{пакет}").Равно(200);

КонецПроцедуры

// Личное пространство раздаётся каждому, поэтому закрыть его нельзя (отказ называет эту
// причину, а не «нет прав»), как и назначить основным пулом хаба.
&Тест
&Порядок(10)
Процедура ЛичноеПространствоНеЗакрытьИНеСделатьОсновнымПуломХаба() Экспорт

	Логин = "newcomer";
	Кука = Клиент.Войти(Логин, ПарольНовичка());
	Раздел = "/pools/" + Логин + "/settings/visibility";

	Поля = Новый Соответствие();
	Поля.Вставить("видимость", "private");
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, Кука))));

	Отказ = Клиент.POSTФормы(Раздел, Поля, Кука);
	Ожидаем.Что(Отказ.КодСостояния, "закрыть пространство не дают").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "личное пространство") > 0,
		"и названа именно эта причина, а не «нет прав»: " + Лев(Клиент.Тело(Отказ), 600)).ЭтоИстина();

	Ожидаем.Что(Клиент.GET("/pools/" + Логин).КодСостояния,
		"пространство осталось видно всем").Равно(200);

	Основным = Клиент.POSTJSONСТокеном("/api/v1/pools/" + Логин + "/default", "{}",
		Клиент.ВыпуститьPAT(Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(Основным.КодСостояния >= 400,
		"основным пулом хаба личное пространство не назначается: " + Клиент.Тело(Основным)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЭхоСПробелами

// Пробелы вокруг числа отбрасываются. Последним тестом: сносит пространства, розданные включением.
&Тест
&Порядок(11)
Процедура ПробелыВокругЧислаНеМешают() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Окно = Экран.ОткрытьОкно(КукаАдмина);

	Поля = Экран.ПоляОкна(Окно);
	Поля.Вставить("подтверждение", "  " + Экран.ЧислоИзОкна(Окно) + "  ");

	Ответ = Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "эхо с пробелами принято").Равно(200);
	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "и пространства снесены").ЭтоЛожь();

	// проектный пул и его файл каскад не тронул
	СтраницаПула = Клиент.GET("/pools/shared/packages/shared-lib");
	Ожидаем.Что(СтраницаПула.КодСостояния,
		"проектный пул на месте." + ЖурналПриОтказе(СтраницаПула)).Равно(200);
	Ожидаем.Что(Экран.АртефактЕсть("shared", "shared-lib", "1.0.0"), "и его артефакт").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ПарольНовичка()
	Возврат "NewcomerPassw0rd";
КонецФункции

Функция ЗавестиУчётку(Знач Логин)
	Возврат Клиент.POSTJSON("/api/v1/register", СтрШаблон(
		"{""логин"":""%1"",""email"":""%1@example.org"",""пароль"":""%2""}", Логин, ПарольНовичка()));
КонецФункции

Функция Опубликовать(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Токен)

	Каталог = УникальныеИмена.ВременныйКаталог("ospx-build");
	Путь = Новый ФикстураПакета().ПостроитьOspx(Каталог, ИмяПакета, Версия, "# " + ИмяПакета);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос("/api/v1/pools/" + ИмяПула + "/push", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Новый ДвоичныеДанные(Путь));

	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

// Код и тело ответа с хвостом журнала хаба — только при отказе; у 200 пусто.
Функция ЖурналПриОтказе(Знач Ответ)

	Если Ответ.КодСостояния = 200 Тогда
		Возврат "";
	КонецЕсли;

	Возврат " Код " + Ответ.КодСостояния + ", тело: "
		+ Лев(Ответ.ПолучитьТелоКакСтроку(), 500) + Символы.ПС
		+ "Журнал хаба: " + Прав(Хаб.Дамп(), 4000);

КонецФункции

Процедура Отвергнуть(Знач Окно, Знач Кука, Знач Эхо, Знач Пояснение)

	Поля = Экран.ПоляОкна(Окно);
	Поля.Вставить("подтверждение", Эхо);

	Ожидаем.Что(Клиент.POSTФормы(Экран.Адрес(), Поля, Кука).КодСостояния,
		"эхо «" + Эхо + "» (" + Пояснение + ") отвергнуто").Равно(400);

КонецПроцедуры

// Максимальная глубина вложенности <form> в разметке.
Функция ГлубинаФорм(Знач Разметка)

	Глубина = 0;
	Максимум = 0;
	Хвост = Разметка;

	Пока Истина Цикл

		Открытие = СтрНайти(Хвост, "<form");
		Закрытие = СтрНайти(Хвост, "</form>");

		Если Открытие = 0 И Закрытие = 0 Тогда
			Прервать;
		КонецЕсли;

		Если Открытие > 0 И (Закрытие = 0 ИЛИ Открытие < Закрытие) Тогда
			Глубина = Глубина + 1;
			Максимум = Макс(Максимум, Глубина);
			Хвост = Сред(Хвост, Открытие + 5);
		Иначе
			Глубина = Глубина - 1;
			Хвост = Сред(Хвост, Закрытие + 7);
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Глубина, "все формы закрыты").Равно(0);
	Ожидаем.Что(Максимум > 0, "формы на странице вообще есть").ЭтоИстина();
	Возврат Максимум;

КонецФункции

#КонецОбласти
