// Теги пула на живом хабе: владелец пула включает галку и правит набор в разделе «Теги»
// настроек пула, пакет наследует теги сразу, мейнтейнер правит тег пула у себя копией,
// снимает копию и выключает тег пула; чужой пул и чужой раздел закрыты. Засев кабинета:
// приватный пул secret с пакетом secret-pkg 1.0.0 во владении owner1, pub — издатель public.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);

	Хаб.ФайловаяБаза("openhub-теги-пула");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры",
		"ЗасеятьКабинет.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Тесты

// Галка включает раздел тегов пула с тремя каналами визарда; тег, заведённый окном пула,
// пакет отдаёт сразу, без публикации; раздел пакета называет такие теги «из пула».
&Тест
Процедура ГалкаИНаборПулаДоезжаютДоПакета() Экспорт

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/tags";

	// соседний тест мог включить галку раньше: контроль начинается с выключенной
	ПереключитьГалку(Раздел, Кука, Ложь);
	Ожидаем.Что(СтрНайти(Страница(Раздел, Кука), "Набор тегов пула"), "КОНТРОЛЬ: без галки набора не видно")
		.Равно(0);
	Ожидаем.Что(Резолв(Кука, "secret", "secret-pkg", "stable"), "КОНТРОЛЬ: без галки stable нет")
		.Равно("404");

	ПереключитьГалку(Раздел, Кука, Истина);

	Разметка = Страница(Раздел, Кука);
	Для Каждого Имя Из СтрРазделить("stable,prerelease,develop", ",") Цикл
		Ожидаем.Что(СтрНайти(Разметка, ">" + Имя + "</span>") > 0,
			СтрШаблон("первое включение завело «%1»", Имя)).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(Резолв(Кука, "secret", "secret-pkg", "stable"), "пакет наследует stable").Равно("1.0.0");

	Поля = ПоляНовогоТегаПула(Разметка);
	Поля.Вставить("имя", "lts");
	Поля.Вставить("вид", "semver");
	Поля.Вставить("правило_semver", "^1.0");
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, Кука).КодСостояния < 400, "тег пула сохранён").ЭтоИстина();

	Ожидаем.Что(Резолв(Кука, "secret", "secret-pkg", "lts"), "правка пула доехала без публикации")
		.Равно("1.0.0");
	РазделПакета = Страница("/pools/secret/packages/secret-pkg/settings/tags", Кука);
	Ожидаем.Что(СтрНайти(РазделПакета, ">lts</span>") > 0, "раздел пакета видит тег пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(РазделПакета, "из пула secret") > 0, "и называет его унаследованным").ЭтоИстина();
	Ожидаем.Что(СтрНайти(РазделПакета, "Создать каналы"), "визард пакету с тегами не нужен").Равно(0);

	// имя, занятое версией пакета пула, тегом пула не становится
	Отказ = ПоляНовогоТегаПула(Страница(Раздел, Кука));
	Отказ.Вставить("имя", "1.0.0");
	Отказ.Вставить("вид", "semver");
	Отказ.Вставить("правило_semver", "*");
	Ответ = Клиент.POSTФормы(Раздел, Отказ, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "имя версии — отказ окна").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Имя тега занято версией пакета этого пула") > 0,
		"причина названа словами").ЭтоИстина();

КонецПроцедуры

// Мейнтейнер правит унаследованный тег окном пакета — у пакета копия, «перекрывает пул»;
// «Вернуть тег пула» снимает копию; выключенный тег у пакета не резолвится и включается снова.
&Тест
Процедура КопияИВыключениеВРазделеПакета() Экспорт

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	ПереключитьГалку("/pools/secret/settings/tags", Кука, Истина);
	РазделПакета = "/pools/secret/packages/secret-pkg/settings/tags";

	Окно = Страница(РазделПакета + "?" + Закодировать("окно") + "=" + Закодировать("изменить-stable"), Кука);
	Поля = Клиент.ПоляФормыСо(Окно, "/stable/save""");
	Поля.Вставить("вид", "semver");
	Поля.Вставить("правило_semver", "^9.0");
	Ожидаем.Что(Клиент.POSTФормы(РазделПакета + "/stable/save", Поля, Кука).КодСостояния < 400,
		"копия сохранена").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница(РазделПакета, Кука), "перекрывает пул") > 0, "копия названа").ЭтоИстина();
	Ожидаем.Что(Резолв(Кука, "secret", "secret-pkg", "stable"), "у пакета — правило копии").Равно("404");
	Ожидаем.Что(СтрНайти(Страница("/pools/secret/settings/tags", Кука), "^9.0"),
		"тег пула не изменился").Равно(0);

	Операция(РазделПакета, Кука, "delete", "stable");
	Ожидаем.Что(Резолв(Кука, "secret", "secret-pkg", "stable"), "снятая копия вернула тег пула")
		.Равно("1.0.0");

	Операция(РазделПакета, Кука, "disable", "prerelease");
	Ожидаем.Что(СтрНайти(Страница(РазделПакета, Кука), "выключен у пакета") > 0, "выключенный виден")
		.ЭтоИстина();
	Ожидаем.Что(Резолв(Кука, "secret", "secret-pkg", "prerelease"), "и не резолвится").Равно("404");

	Операция(РазделПакета, Кука, "enable", "prerelease");
	Ожидаем.Что(Резолв(Кука, "secret", "secret-pkg", "prerelease"), "включённый вернулся").Равно("1.0.0");

КонецПроцедуры

// Галку и теги пула меняет владелец пула: издатель пула раздела не открывает, посторонний
// приватного пула не находит ни экраном, ни API; выключение тега пула у чужого пакета — 404.
&Тест
Процедура ТегиПулаПравитТолькоВладелецПула() Экспорт

	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/pools/public/settings/tags", КукаPub).КодСостояния,
		"издатель пула раздела не открывает").Равно(403);

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/pools/secret/settings/tags", КукаBob).КодСостояния,
		"посторонний приватного пула не находит").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSON("GET", "/api/v1/pools/secret/tags", "", Клиент.Кука(КукаBob)).КодСостояния,
		"и в API").Равно(404);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.ЗапросJSON("GET", "/api/v1/pools/secret/tags", "", Клиент.Кука(КукаOwner)).КодСостояния,
		"КОНТРОЛЬ: владелец пула набор видит").Равно(200);

	Токен = Клиент.ТокенCSRF(Страница("/pools/secret/settings/tags", КукаOwner));
	ТокенPub = Клиент.ТокенCSRF(Страница("/me/settings/profile", КукаPub));
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", "/api/v1/pools/public/tags/lts", "{""rule"":""*""}",
		Клиент.ЗаголовкиМутации(КукаPub, ТокенPub)).КодСостояния, "издатель тег пула не заводит").Равно(403);
	ТокенBob = Клиент.ТокенCSRF(Страница("/me/settings/profile", КукаBob));
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", "/api/v1/pools/secret/packages/secret-pkg/tags/stable/disabled", "",
		Клиент.ЗаголовкиМутации(КукаBob, ТокенBob)).КодСостояния, "чужой пакет — как несуществующий").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", "/api/v1/pools/secret/tags/lts", "{""rule"":""*""}",
		Клиент.ЗаголовкиМутации(КукаBob, ТокенBob)).КодСостояния, "чужой пул — как несуществующий").Равно(404);
	Ожидаем.Что(ЗначениеЗаполнено(Токен), "КОНТРОЛЬ: у владельца форма раздела есть").ЭтоИстина();

	// формы окна тега пула — правка и удаление — держат то же право, что и страница раздела
	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	НаборPublic = НаборПула("public", КукаRoot);
	НаборSecret = НаборПула("secret", КукаRoot);
	Для Каждого Действие Из СтрРазделить("save,delete", ",") Цикл
		Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/tags/stable/" + Действие,
			ПоляПравкиЧужимТегом(ТокенPub), КукаPub).КодСостояния, "издатель: форма «" + Действие + "» тега пула").Равно(403);
		Ожидаем.Что(Клиент.POSTФормы("/pools/secret/settings/tags/stable/" + Действие,
			ПоляПравкиЧужимТегом(ТокенBob), КукаBob).КодСостояния, "посторонний: форма «" + Действие + "» — как несуществующий").Равно(404);
	КонецЦикла;
	Ожидаем.Что(НаборПула("public", КукаRoot), "набор тегов public не тронут").Равно(НаборPublic);
	Ожидаем.Что(НаборПула("secret", КукаRoot), "набор тегов secret не тронут").Равно(НаборSecret);

КонецПроцедуры

// Публичная страница пакета глазами анонима: вкладка версий показывает тег пула плашкой канала
// и у версии, а выключенного у пакета тега пула на витрине нет — ни каналом, ни у версии.
&Тест
Процедура ВитринаПакетаПоказываетТегиПулаБезВыключенных() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	ПереключитьГалку("/pools/public/settings/tags", КукаRoot, Истина);
	Витрина = "/pools/public/packages/alice-pkg/versions";

	Страница = Клиент.Тело(Клиент.GET(Витрина));
	Ожидаем.Что(СтрНайти(Страница, ">stable</span>") > 0, "плашка тега пула на витрине").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, ">prerelease</span>") > 0, "КОНТРОЛЬ: prerelease пула виден").ЭтоИстина();

	Операция("/pools/public/packages/alice-pkg/settings/tags", КукаRoot, "disable", "prerelease");
	Попытка
		Страница = Клиент.Тело(Клиент.GET(Витрина));
		Ожидаем.Что(СтрНайти(Страница, ">prerelease</span>"), "выключенного тега на витрине нет").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, ">stable</span>") > 0, "соседний тег пула на месте").ЭтоИстина();
	Исключение
		Операция("/pools/public/packages/alice-pkg/settings/tags", КукаRoot, "enable", "prerelease");
		ВызватьИсключение;
	КонецПопытки;
	Операция("/pools/public/packages/alice-pkg/settings/tags", КукаRoot, "enable", "prerelease");

КонецПроцедуры

// Выключает тег пула у пакета тот, кто вправе вести теги пакета: читатель пула — нет (форма
// с настоящим токеном и API — 403, тег у пакета остаётся); издатель пула право изменения
// пакетов пула имеет — у него выключение проходит, и тег возвращается.
&Тест
Процедура ЧитательПулаНеВыключаетТегУПакета() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	ПереключитьГалку("/pools/public/settings/tags", КукаRoot, Истина);
	Раздел = "/pools/public/packages/alice-pkg/settings/tags";
	Адрес = "/api/v1/pools/public/packages/alice-pkg/tags/stable/disabled";

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	ТокенBob = Клиент.ТокенCSRF(Страница("/me/settings/profile", КукаBob));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ТокенBob);
	Ожидаем.Что(Клиент.POSTФормы(Раздел + "/stable/disable", Поля, КукаBob).КодСостояния,
		"читатель: форма закрыта").Равно(403);
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Адрес, "", Клиент.ЗаголовкиМутации(КукаBob, ТокенBob)).КодСостояния,
		"читатель: API закрыт").Равно(403);
	Ожидаем.Что(Резолв(КукаRoot, "public", "alice-pkg", "stable"), "тег у пакета остался").Равно("1.1.0");

	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	ТокенPub = Клиент.ТокенCSRF(Страница("/me/settings/profile", КукаPub));
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Адрес, "", Клиент.ЗаголовкиМутации(КукаPub, ТокенPub)).КодСостояния,
		"КОНТРОЛЬ: издатель пула ведёт теги пакетов пула").Равно(200);
	Ожидаем.Что(Клиент.ЗапросJSON("DELETE", Адрес, "", Клиент.ЗаголовкиМутации(КукаPub, ТокенPub)).КодСостояния,
		"и возвращает тег").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Страница(Знач Путь, Знач Кука)
	Возврат Клиент.Тело(Клиент.GETСКукой(Путь, Кука));
КонецФункции

Процедура ПереключитьГалку(Знач Раздел, Знач Кука, Знач Включить)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница(Раздел, Кука)));
	Поля.Вставить("операция", "теги_пула");
	Поля.Вставить("теги_пула", ?(Включить, "1", "0"));
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, Кука).КодСостояния < 400, "галка переключена").ЭтоИстина();

КонецПроцедуры

// Форма тега пакета: «<тег>/<действие>» — disable, enable или delete; снятие копии тега пула
// подтверждается окном, и его кнопка шлёт confirmed=1.
Процедура Операция(Знач Раздел, Знач Кука, Знач Действие, Знач ИмяТега)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница(Раздел, Кука)));
	Если Действие = "delete" Тогда
		Поля.Вставить("confirmed", "1");
	КонецЕсли;
	Ожидаем.Что(Клиент.POSTФормы(Раздел + "/" + ИмяТега + "/" + Действие, Поля, Кука).КодСостояния < 400,
		СтрШаблон("действие «%1» над «%2» прошло", Действие, ИмяТега)).ЭтоИстина();

КонецПроцедуры

// Поля окна «Новый тег пула» так, как их отправит браузер.
Функция ПоляНовогоТегаПула(Знач Разметка)
	Возврат Клиент.ПоляФормыСо(Разметка, "name=""правило_semver""");
КонецФункции

// Поля, которыми форма окна тега правит и удаляет тег пула: подтверждение и эхо — на месте.
Функция ПоляПравкиЧужимТегом(Знач Токен)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("вид", "semver");
	Поля.Вставить("правило_semver", "*");
	Поля.Вставить("confirmed", "1");
	Поля.Вставить("тег", "stable");
	Возврат Поля;

КонецФункции

// Набор тегов пула глазами администратора хаба — телом ответа API.
Функция НаборПула(Знач Пул, Знач Кука)
	Возврат Клиент.Тело(Клиент.ЗапросJSON("GET", "/api/v1/pools/" + Пул + "/tags", "", Клиент.Кука(Кука)));
КонецФункции

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Версия, которую отдаёт спецификация, строкой; код ответа строкой — если версии нет.
Функция Резолв(Знач Кука, Знач Пул, Знач Пакет, Знач Спецификация)

	Ответ = Клиент.ЗапросJSON("GET", СтрШаблон("/api/v1/pools/%1/packages/%2/resolve?spec=%3",
		Пул, Пакет, Спецификация), "", Клиент.Кука(Кука));
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Формат(Ответ.КодСостояния, "ЧГ=0");
	КонецЕсли;
	Возврат Строка(Клиент.ТелоJSON(Ответ).Получить("version"));

КонецФункции

#КонецОбласти
