// Частичный сбой сноса личных пространств на живом хабе: админ видит отказ с двумя числами,
// включённую настройку и окно предупреждения и повторяет операцию, когда причина устранена.

#Использовать asserts
#Использовать 1connector
#Использовать "../../фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем Экран;           // фикстура РазделЛичныхПространств — раздел «Пулы» стенда
Перем КаталогПроекта;
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьЛичныеПространства.os");

	Хаб.ФайловаяБаза("openhub-частичный-снос");
	КореньХранилища = Хаб.КореньХранилища();
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

	РеестрФикстур.Подключить("РазделЛичныхПространств");
	Экран = Новый РазделЛичныхПространств(Клиент, КореньХранилища);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Попытка
		Права(КаталогПакетаAnna(), "755");
	Исключение
	КонецПопытки;
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Каталог пакета закрыт на запись: остальные пространства снесены, названы оба числа,
// настройка осталась включённой, окно показано снова.
&Тест
Процедура ЧастичныйСносОтчитываетсяДвумяЧисламиИНеГаситТумблер() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "стенд: пространство anna есть").ЭтоИстина();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("boris"), "стенд: пространство boris есть").ЭтоИстина();

	Права(КаталогПакетаAnna(), "500");

	Окно = Экран.ОткрытьОкно(КукаАдмина);
	Поля = Экран.ПоляОкна(Окно);
	Поля.Вставить("подтверждение", Экран.ЧислоИзОкна(Окно));

	Ответ = Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина);
	Тело_ = Клиент.Тело(Ответ);

	Ожидаем.Что(Ответ.КодСостояния, "частичный снос — отказ, а не «сохранено»").Равно(400);
	Ожидаем.Что(СтрНайти(Тело_, "Снесено пространств — 3") > 0,
		"названо число снесённых").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "но 1 снести не удалось") > 0,
		"и число неснесённых — оба числа на экране").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "name=""подтверждение""") > 0,
		"окно предупреждения показано снова").ЭтоИстина();

	Ожидаем.Что(Экран.ЛичныйПулЕсть("boris"), "исправное пространство снесено").ЭтоЛожь();
	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "неудачное осталось").ЭтоИстина();
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина),
		"тумблер НЕ погашен — переход остался, операцию можно повторить").ЭтоИстина();

КонецПроцедуры

// Причина устранена — повтор проходит из интерфейса тем же путём.
&Тест
Процедура ПослеУстраненияПричиныОперацияПовторяетсяИДоводитсяДоКонца() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "состояние после частичного сноса").ЭтоИстина();

	Права(КаталогПакетаAnna(), "755");

	Окно = Экран.ОткрытьОкно(КукаАдмина);
	Ожидаем.Что(Экран.ЧислоИзОкна(Окно), "окно пересчитало остаток").Равно("1");

	Поля = Экран.ПоляОкна(Окно);
	Поля.Вставить("подтверждение", "1");

	Ответ = Клиент.POSTФормы(Экран.Адрес(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "повтор принят").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Личные пространства выключены") > 0,
		"операция доведена до конца").ЭтоИстина();

	Ожидаем.Что(Экран.ЛичныйПулЕсть("anna"), "пространство anna снесено").ЭтоЛожь();
	Ожидаем.Что(Экран.АртефактЕсть("anna", "anna-lib", "1.0.0"), "и его файл").ЭтоЛожь();
	Ожидаем.Что(Экран.НастройкаВключена(КукаАдмина), "только теперь тумблер погашен").ЭтоЛожь();

	// проектный пул каскад не тронул ни на одном из двух заходов
	Ожидаем.Что(Клиент.GET("/pools/shared/packages/shared-lib").КодСостояния, "проектный пул на месте").Равно(200);
	Ожидаем.Что(Экран.АртефактЕсть("shared", "shared-lib", "1.0.0"), "и его артефакт").ЭтоИстина();

	// След в аудите — ЛичныеПространства_Тесты: экран журнала читает файл лога, а не базу.

КонецПроцедуры

#Область Помощники

Функция КаталогПакетаAnna()
	Возврат ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", "anna"), "anna-lib");
КонецФункции

Процедура Права(Знач Путь, Знач Режим)
	П = СоздатьПроцесс(СтрШаблон("chmod %1 ""%2""", Режим, Путь), , Истина);
	П.Запустить();
	П.ОжидатьЗавершения();
	Если П.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("chmod %1 %2 не удался: %3", Режим, Путь,
			Строка(П.ПотокОшибок.Прочитать()));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
