// HTTP-интеграционные тесты приватной части: настоящий хаб на файловой БД, засеянной
// сидером ЗасеятьКабинет.os. Вход, кабинет, управление, CSRF, yank, PAT, админка.

#Использовать asserts
// клиент 1connector не следует редиректам: адрес возврата (Location) виден
#Использовать 1connector
// раскладка статики кита: по ней тест находит базовый лист библиотеки
#Использовать oscript-ui
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем КаталогПроекта;
Перем РитмПолей;       // фикстура РитмФорм — сквозной гейт ритма форм
Перем РядыИнлайнов;    // фикстура РядИнлайнов — сквозной гейт соседних атомарных инлайнов
Перем СтилиХаба;       // оба листа страницы (кит + инсталляция), прочитанные один раз

Перем КаталогСборкиЗаявок;  // временный каталог под .ospx очереди заявок
Перем ТокенBobДляPush;      // PAT bob — заявителя без прав, выпускается один раз
Перем ТокенPubДляPush;      // PAT pub — второй заявитель: очередь bob упирается в предел
Перем Клиент;               // фикстура КлиентХаба — все запросы к подопытному хабу
Перем Подделки;             // фикстура ПодделкаТокена — токен той же длины с одним подменённым символом

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТокенBobДляPush = "";
	ТокенPubДляPush = "";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	Хаб = НовыйХаб();
	КаталогПроекта = Хаб.КаталогПроекта();
	РеестрФикстур.Подключить("РитмФорм");
	РеестрФикстур.Подключить("РядИнлайнов");
	// очередь заявок гоняется настоящим push, поэтому нужен настоящий .ospx
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("ПодделкаТокена");
	Подделки = Новый ПодделкаТокена();
	КаталогСборкиЗаявок = УникальныеИмена.ВременныйКаталог("oshub-office-ospx");
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-office");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// фоновый доставщик вебхуков гасим: созданный в тесте вебхук не должен уйти в сеть;
	// «__» в имени переменной — это «_» в имени свойства delivery_enabled
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();     // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();
	Клиент = Новый КлиентХаба(Хаб, 20);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборкиЗаявок);
КонецПроцедуры

// --- сценарии ---

// Ячейки сетки выбора значка с таким именем поля — в порядке печати: Значение (value радиокнопки)
// и Подпись (title ячейки — имя глифа или название бренда).
Функция ЯчейкиСеткиЗначков(Знач Разметка, Знач ИмяПоля)

	Результат = Новый Массив();
	Начало = "<label class=""iconpicker__item""";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Начало);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + 1);
		Ячейка = Лев(Хвост, СтрНайти(Хвост + "</label>", "</label>"));
		Радио = Сред(Ячейка, СтрНайти(Ячейка, "<input"));
		Если СтрНайти(Радио, "name=""" + ИмяПоля + """") > 0 Тогда
			Результат.Добавить(Новый Структура("Значение, Подпись",
				Клиент.ЗначениеАтрибута(Радио, "value"), Клиент.ЗначениеАтрибута(Ячейка, "title")));
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Начало);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазныхПодписей(Знач Подписи) Экспорт

	Разные = Новый Соответствие();
	Для Каждого Подпись Из Подписи Цикл
		Разные.Вставить(Подпись, Истина);
	КонецЦикла;
	Возврат Разные.Количество();

КонецФункции

// Истина, если вариант с таким значением помечен выбранным: между value и selected
// могут стоять data-атрибуты варианта, поэтому соседства подстрок недостаточно.
Функция ВариантВыбран(Знач Разметка, Знач Значение) Экспорт

	Маркер = "<option value=""" + Значение + """";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, ">");
		Если Конец > 1 И СтрНайти(Лев(Хвост, Конец - 1), "selected") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Максимальная глубина вложенности тегов <form> в разметке.
//
// Параметры:
//  Разметка - Строка - HTML страницы.
//
// Возвращаемое значение:
//  Число - глубина; 1 означает, что вложенности нет.
//
Функция ГлубинаВложенностиФорм(Знач Разметка) Экспорт

	Глубина = 0;
	Максимум = 0;
	Хвост = Разметка;

	Пока Истина Цикл
		Открывающий = СтрНайти(Хвост, "<form");
		Закрывающий = СтрНайти(Хвост, "</form>");
		Если Открывающий = 0 И Закрывающий = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Открывающий > 0 И (Закрывающий = 0 ИЛИ Открывающий < Закрывающий) Тогда
			Глубина = Глубина + 1;
			Максимум = Макс(Максимум, Глубина);
			Хвост = Сред(Хвост, Открывающий + 5);
		Иначе
			Глубина = Глубина - 1;
			Хвост = Сред(Хвост, Закрывающий + 7);
		КонецЕсли;
	КонецЦикла;

	Возврат Максимум;

КонецФункции

// Закрытые <details> внутри <form> и обязательные поля, спрятанные в них; отключённое
// (disabled на поле или на <fieldset>) нарушением не считается — браузер его не валидирует.
//
// Параметры:
//  Разметка - Строка - HTML страницы.
//
// Возвращаемое значение:
//  Структура - Закрытых (Число закрытых катов внутри форм), Обязательные (Массив тегов
//              с required, до которых пользователь не доберётся), Незакрытых (Число
//              катов без </details>).
//
Функция КатыВнутриФорм(Знач Разметка) Экспорт

	Результат = Новый Структура("Закрытых, Обязательные, Незакрытых", 0, Новый Массив(), 0);
	ГлубинаФорм = 0;
	Каты = Новый Массив();     // по одному Булево на открытый <details>: «закрыт и внутри формы»
	Наборы = Новый Массив();   // по одному Булево на открытый <fieldset>: «отключён»
	Хвост = Разметка;

	Пока Истина Цикл

		Открытие = СтрНайти(Хвост, "<");
		Если Открытие = 0 Тогда
			Прервать;
		КонецЕсли;
		Хвост = Сред(Хвост, Открытие);

		Длина = ДлинаТега(Хвост);
		Если Длина = 0 Тогда
			Прервать;
		КонецЕсли;
		Тег = Лев(Хвост, Длина);
		Хвост = Сред(Хвост, Длина + 1);

		Имя = ИмяТега(Тег);
		Скелет = СкелетТега(Тег);

		Если Имя = "/form" Тогда
			ГлубинаФорм = Макс(0, ГлубинаФорм - 1);
		ИначеЕсли Имя = "form" Тогда
			ГлубинаФорм = ГлубинаФорм + 1;
		ИначеЕсли Имя = "/details" Тогда
			Если Каты.Количество() > 0 Тогда
				Каты.Удалить(Каты.Количество() - 1);
			КонецЕсли;
		ИначеЕсли Имя = "details" Тогда
			ЗакрытВФорме = ГлубинаФорм > 0 И НЕ ЕстьАтрибут(Скелет, "open");
			Каты.Добавить(ЗакрытВФорме);
			Если ЗакрытВФорме Тогда
				Результат.Закрытых = Результат.Закрытых + 1;
			КонецЕсли;
		ИначеЕсли Имя = "/fieldset" Тогда
			Если Наборы.Количество() > 0 Тогда
				Наборы.Удалить(Наборы.Количество() - 1);
			КонецЕсли;
		ИначеЕсли Имя = "fieldset" Тогда
			Наборы.Добавить(ЕстьАтрибут(Скелет, "disabled"));
		ИначеЕсли ЕстьАтрибут(Скелет, "required")
			И Каты.Найти(Истина) <> Неопределено
			И НЕ ЕстьАтрибут(Скелет, "disabled")
			И Наборы.Найти(Истина) = Неопределено Тогда
			Результат.Обязательные.Добавить(Тег);
		КонецЕсли;

	КонецЦикла;

	Результат.Незакрытых = Каты.Количество();
	Возврат Результат;

КонецФункции

// Длина тега до «>» вне кавычек: «<input value="a>b" required>» — один тег, required не теряется.
Функция ДлинаТега(Знач Текст)

	Кавычка = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
		ИначеЕсли Символ = ">" Тогда
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Имя тега в нижнем регистре («form», «/form», «details»), без пробела перед скобкой.
Функция ИмяТега(Знач Тег)

	Закрывающий = (Лев(Тег, 2) = "</");
	Результат = "";

	Для Позиция = ?(Закрывающий, 3, 2) По СтрДлина(Тег) Цикл
		Символ = НРег(Сред(Тег, Позиция, 1));
		Если ПробельныйСимвол(Символ) ИЛИ Символ = ">" ИЛИ Символ = "/" Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;

	Возврат ?(Закрывающий, "/", "") + Результат;

КонецФункции

// Тег без значений атрибутов: «class="fold open"» → «class=», слово значения — не атрибут.
Функция СкелетТега(Знач Тег)

	Результат = " ";
	Кавычка = "";

	Для Позиция = 1 По СтрДлина(Тег) Цикл
		Символ = Сред(Тег, Позиция, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
		ИначеЕсли ПробельныйСимвол(Символ) ИЛИ Символ = ">" ИЛИ Символ = "/" Тогда
			Результат = Результат + " ";
		Иначе
			Результат = Результат + НРег(Символ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат + " ";

КонецФункции

Функция ЕстьАтрибут(Знач Скелет, Знач Имя)
	Возврат СтрНайти(Скелет, " " + Имя + " ") > 0 ИЛИ СтрНайти(Скелет, " " + Имя + "=") > 0;
КонецФункции

Функция ПробельныйСимвол(Знач Символ)
	Возврат Символ = " " ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК ИЛИ Символ = Символы.Таб;
КонецФункции

&Тест
Процедура АнонимНеПопадаетВКабинет() Экспорт
	Ответ = Клиент.GET("/me");
	// гвард редиректит анонима на /login (клиент может и не пойти по редиректу)
	Если Редирект(Ответ) Тогда
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "/login") > 0, "редирект анонима на /login").ЭтоИстина();
	Иначе
		Ожидаем.Что(СтрНайти(Тело(Ответ), "Мои пакеты"), "аноним не видит кабинет").Равно(0);
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура АвторВидитСвоиПакеты() Экспорт

	// «мои пакеты» — отбор каталога: сводка кабинета показывает горстку, весь список — в каталоге
	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/me", Кука)), "href=""/packages?mine=1""") > 0,
		"кабинет ведёт в каталог с отбором").ЭтоИстина();

	Ответ = Клиент.GETСКукой("/packages?mine=1", Кука);
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "alice-pkg") > 0, "пакет автора в отборе").ЭтоИстина();

	// и шестерёнка «настройки» у управляемого пакета ведёт в дом пакета
	Ожидаем.Что(СтрНайти(Тело(Ответ), "/alice-pkg/settings") > 0,
		"шестерёнка ведёт в дом пакета").ЭтоИстина();

КонецПроцедуры

// Отбор обязан УБИРАТЬ чужое, а присутствие своего пакета об этом не говорит ничего:
// каталог без отбора отдаёт весь читаемый хаб, и свой пакет в нём тоже есть.
&Тест
Процедура ОтборМоихПакетовУбираетЧужойПакетИзВыдачи() Экспорт

	// чужой пакет в том же публичном пуле: alice его ВИДИТ, но не управляет им
	Чужой = УникальныеИмена.Имя("pub-foreign");
	Ожидаем.Что(ЗаявкаОтPub("public", Чужой, "1.0.0").КодСостояния,
		"чужой пакет опубликован в публичном пуле").Равно(201);

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	// запросы различаются ровно отбором; ищется ссылка карточки, а не имя — имя запроса
	// страница печатает обратно в поле поиска
	КарточкаЧужого = "href=""/pools/public/packages/" + Чужой + """";

	Весь = Тело(Клиент.GETСКукой("/packages?q=" + Чужой, Кука));
	Ожидаем.Что(СтрНайти(Весь, КарточкаЧужого) > 0,
		"КОНТРОЛЬ: без отбора карточка чужого пакета alice видна").ЭтоИстина();

	ПодОтбором = Тело(Клиент.GETСКукой("/packages?mine=1&q=" + Чужой, Кука));
	Ожидаем.Что(СтрНайти(ПодОтбором, КарточкаЧужого), "а под отбором её нет").Равно(0);

	Мои = Тело(Клиент.GETСКукой("/packages?mine=1", Кука));
	Ожидаем.Что(СтрНайти(Мои, "href=""/pools/public/packages/alice-pkg""") > 0,
		"свой пакет отбор оставил").ЭтоИстина();

КонецПроцедуры

// Дороги вошедшего — в едином меню, доступном с любой страницы, включая публичный каталог;
// «Входящие» в нём постоянно. Дороги ищутся внутри панели меню.
&Тест
Процедура ЕдиноеМенюДаётДорогиВошедшемуСПубличнойСтраницы() Экспорт

	Панель = ПанельЕдиногоМеню(Тело(Клиент.GETСКукой("/packages", Клиент.Войти("alice", "AlicePassw0rd"))));

	Ожидаем.Что(Панель <> "", "единое меню печатается на публичном каталоге").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "class=""hubmenu__login"">alice<") > 0,
		"и подписано именем вошедшего").ЭтоИстина();
	Для Каждого Дорога Из СтрРазделить(
		"/me,/pools/alice,/packages?mine=1,/me/notifications,/me/inbox", ",") Цикл
		Ожидаем.Что(СтрНайти(Панель, "href=""" + Дорога + """") > 0,
			"дорога " + Дорога + " из меню каталога").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Панель, ">Аккаунт<") > 0,
		"кабинет открывает «Аккаунт» группы настроек").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, ">Кабинет<"), "отдельного пункта «Кабинет» нет").Равно(0);
	Ожидаем.Что(СтрНайти(Панель, "action=""/logout""") > 0,
		"и выход формой в том же меню").ЭтоИстина();

	Ожидаем.Что(Клиент.GETСКукой("/me/inbox", Клиент.Войти("alice", "AlicePassw0rd")).КодСостояния,
		"дорога до входящих ведёт на живой экран").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/pools/alice", Клиент.Войти("alice", "AlicePassw0rd")).КодСостояния,
		"и дорога до личного пространства — тоже").Равно(200);

	Ожидаем.Что(СтрНайти(Панель, "href=""/hub/settings"""),
		"а настройки хаба рядовому участнику не печатаются").Равно(0);
	АдминскаяПанель = ПанельЕдиногоМеню(Тело(Клиент.GETСКукой("/packages", ВойтиRoot())));
	Ожидаем.Что(СтрНайти(АдминскаяПанель, "href=""/hub/settings""") > 0,
		"админ видит их в своём меню на той же странице").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", ВойтиRoot()).КодСостояния,
		"и эта дорога ведёт на живой экран").Равно(200);

КонецПроцедуры

&Тест
Процедура УправлениеРедактированиеCSRFиОтражениеНаПубличной() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	// страница управления
	Стр = Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/card", Кука));
	Ожидаем.Что(СтрНайти(Стр, "alice-pkg") > 0, "заголовок пакета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/versions", Кука)), "1.1.0") > 0,
		"версия в таблице раздела «версии»").ЭтоИстина();
	Токен = Клиент.ТокенCSRF(Стр);
	Ожидаем.Что(СтрДлина(Токен)).Равно(64);

	// мутация без CSRF → 403
	БезТокена = Новый Соответствие();
	БезТокена.Вставить("описание", "взлом");
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/card", БезТокена, Кука).КодСостояния,
		"сохранение без CSRF отклонено").Равно(403);

	// опасный репозиторий отвергается целиком: карточка не записана
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("описание", "MARKERREJECTED");
	Поля.Вставить("репозиторий", "javascript:alert(2)");
	Поля.Вставить("лицензия", "MIT");
	Поля.Вставить("ключевые_слова", "");
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/card", Поля, Кука).КодСостояния,
		"js-URL репозитория отвергнут").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/pools/public/packages/alice-pkg")), "MARKERREJECTED"),
		"и карточка не записана").Равно(0);

	// мутация с CSRF (описание с XSS) → редирект
	Поля.Вставить("описание", "<script>alert(1)</script>MARKERDESC");
	Поля.Вставить("репозиторий", "");
	ОтветСохр = Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/card", Поля, Кука);
	Ожидаем.Что(УспехМутации(ОтветСохр), "успешное сохранение").ЭтоИстина();

	// отражение на публичной странице + санитизация
	Пуб = Тело(Клиент.GET("/pools/public/packages/alice-pkg"));
	Ожидаем.Что(СтрНайти(Пуб, "MARKERDESC") > 0, "новое описание отражено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Пуб), "<script>alert"), "script вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Пуб), "href=""javascript"), "js-URL репозитория не исполним").Равно(0);

КонецПроцедуры

// Тело формы x-www-form-urlencoded: пробел приходит «+», свой плюс — «%2B»; хаб читает его
// по этим правилам, иначе в описании пакета вместо пробелов встали бы плюсы.
&Тест
Процедура ПлюсВТелеФормыДоезжаетПробеломДоСтраницыПакета() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/card", Кука)));

	ТелоФормы = "_csrf=" + Токен + "&лицензия=MIT&ключевые_слова="
		+ "&описание=MARKERPLUS+два+слова+и+плюс+%2B+внутри";
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/card", ТелоФормы, Кука)),
		"карточка сохранена").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/pools/public/packages/alice-pkg")),
		"MARKERPLUS два слова и плюс + внутри") > 0,
		"«+» доехал пробелом, а «%2B» — плюсом").ЭтоИстина();

КонецПроцедуры

// Самописный клиент не кодирует тело формы (скобки и пробелы как есть), но это всё ещё
// форма, и поле из неё доезжает целиком.
&Тест
Процедура СыраяЗаписьТелаФормыДоезжаетДоСтраницыПакета() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/card", Кука)));

	Ответ = Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/card",
		"_csrf=" + Токен + "&лицензия=MIT&ключевые_слова="
		+ "&описание=MARKERRAW шаблон {пакет} и сырой пробел", Кука);

	Ожидаем.Что(УспехМутации(Ответ), "карточка сохранена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/pools/public/packages/alice-pkg")),
		"MARKERRAW шаблон {пакет} и сырой пробел") > 0,
		"набранное доехало целиком").ЭтоИстина();

КонецПроцедуры

// Подделка CSRF той же длины отбивается и формой, и API: длина токена публична, стережётся
// посимвольное сравнение, а не сверка длин.
&Тест
Процедура ПодделкаCSRFТойЖеДлиныОтбиваетсяФормойИAPI() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/card", Кука)));
	Подделка = Подделки.СПодменённымСимволом(Токен, 32);

	Ожидаем.Что(СтрДлина(Подделка), "подделка неотличима по длине").Равно(СтрДлина(Токен));
	Ожидаем.Что(Подделка = Токен, "и всё же это другой токен").ЭтоЛожь();

	// форма кабинета: подделка не сохраняет карточку
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Подделка);
	Поля.Вставить("описание", "ПОДДЕЛКАCSRF");
	Поля.Вставить("лицензия", "MIT");
	Поля.Вставить("ключевые_слова", "");
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/card", Поля, Кука).КодСостояния,
		"форма кабинета с подделанным токеном → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/pools/public/packages/alice-pkg")), "ПОДДЕЛКАCSRF"),
		"и карточка пакета не изменилась").Равно(0);

	// та же подделка в заголовке мутации API
	АдресВерсии = "/api/v1/pools/public/packages/alice-pkg/versions/1.0.0";
	ОтказAPI = Клиент.ЗапросJSON("PATCH", АдресВерсии, "{""yanked"":false}",
		Клиент.ЗаголовкиМутации(Кука, Подделка));
	Ожидаем.Что(ОтказAPI.КодСостояния, "мутация API с подделанным токеном → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Клиент.Тело(ОтказAPI), "csrf_failed") > 0,
		"и отказ назван своим кодом").ЭтоИстина();

	// КОНТРОЛЬ: тот же запрос с настоящим токеном проходит — дело в токене, а не в правах
	Ожидаем.Что(Клиент.ЗапросJSON("PATCH", АдресВерсии, "{""yanked"":false}",
		Клиент.ЗаголовкиМутации(Кука, Токен)).КодСостояния,
		"КОНТРОЛЬ: настоящий токен ту же мутацию проводит").Равно(200);

КонецПроцедуры

// Форма кабинета принимает только POST: иной метод с настоящим телом и токеном получает 405
// со списком разрешённого, а не мутацию.
&Тест
Процедура ФормаКабинетаПринимаетТолькоPOST() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Раздел = "/pools/public/packages/alice-pkg/settings/card";

	// тело настоящее: те же поля и тот же токен, которыми POST карточку сохраняет
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("описание", "МЕТОДОММИМОPOST");
	Поля.Вставить("лицензия", "MIT");
	Поля.Вставить("ключевые_слова", "");

	Для Каждого Метод Из СтрРазделить("PUT,DELETE,PATCH", ",") Цикл
		Ответ = Клиент.ЗапросФормы(Метод, Раздел, Поля, Клиент.Кука(Кука));
		Ожидаем.Что(Ответ.КодСостояния, Метод + " на форму кабинета → 405").Равно(405);
		Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Allow"),
			Метод + ": 405 называет ОБА разрешённых метода").Равно("GET, POST");
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/pools/public/packages/alice-pkg")), "МЕТОДОММИМОPOST"),
		"мимо POST карточка не сохранена").Равно(0);

КонецПроцедуры

// Скрытый пакет постороннему через API неотличим от несуществующего — и на чтении карточки,
// и на мутации версии.
&Тест
Процедура СкрытыйПакетНеЧитаетсяИНеМутируетсяПостороннимЧерезAPI() Экспорт

	Карточка = "/api/v1/pools/public/packages/alice-pkg";
	Версия = Карточка + "/versions/1.0.0";
	ТокенПостороннего = PATBob();

	Ожидаем.Что(Клиент.GETСТокеном(Карточка, ТокенПостороннего).КодСостояния,
		"КОНТРОЛЬ: пока пакет виден, карточка постороннему отдаётся").Равно(200);
	Ожидаем.Что(Клиент.ЗапросJSONСТокеном("PATCH", Версия, "{""yanked"":true}", ТокенПостороннего).КодСостояния,
		"КОНТРОЛЬ: и мутация ему отказана по правам — объект виден").Равно(403);

	Снимок = ПометитьПакетСкрытым(Истина);

	// ассерты — ПОСЛЕ восстановления: упавший ассерт оставил бы пакет скрытым соседям
	Попытка
		Прочтение = Клиент.GETСТокеном(Карточка, ТокенПостороннего);
		Мутация = Клиент.ЗапросJSONСТокеном("PATCH", Версия, "{""yanked"":true}", ТокенПостороннего);
	Исключение
		ВосстановитьСкрытиеПакета(Снимок);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьСкрытиеПакета(Снимок);

	Ожидаем.Что(Прочтение.КодСостояния, "скрытый пакет: карточка постороннему → 404").Равно(404);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Прочтение), "package_not_found") > 0,
		"и отказ назван своим кодом").ЭтоИстина();

	Ожидаем.Что(Мутация.КодСостояния,
		"скрытый пакет: мутация версии → 404, а не прежние 403: скрытое неотличимо от несуществующего")
		.Равно(404);

	Ожидаем.Что(ОтозванаЛиВерсия(Карточка + "/versions", "1.0.0", ТокенПостороннего),
		"мимо закрытой двери версию не отозвали").ЭтоЛожь();

КонецПроцедуры

// Закрытый пул неотличим от несуществующего и в кабинете: посторонний получает 404,
// а не 403 — иначе список чужих приватных пулов читается перебором адресов.
&Тест
Процедура ЧужойПриватныйПулВКабинетеНеотличимОтНесуществующего() Экспорт

	КукаAlice = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(Клиент.GETСКукой("/pools/secret/settings/visibility", КукаAlice).КодСостояния,
		"чужой приватный пул для alice — 404, а не 403").Равно(404);
	Ожидаем.Что(Клиент.GETСКукой("/pools/такого-пула-нет/settings/visibility", КукаAlice).КодСостояния,
		"несуществующий пул отвечает ровно тем же").Равно(404);

	// КОНТРОЛЬ: владельцу тот же адрес открыт — дело в правах чтения, а не в адресе
	Ожидаем.Что(Клиент.GETСКукой("/pools/secret/settings/visibility",
		Клиент.Войти("owner1", "Owner1Passw0rd")).КодСостояния,
		"КОНТРОЛЬ: владелец свой приватный пул настраивает").Равно(200);

КонецПроцедуры

&Тест
Процедура YankВерсииЧерезКабинет() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/versions", Кука)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "yank");
	Поля.Вставить("версия", "1.1.0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/versions", Поля, Кука)),
		"yank принят").ЭтоИстина();

	// на публичной странице версия помечена отозванной (версии — своя вкладка)
	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/pools/public/packages/alice-pkg/versions")), "отозвана") > 0,
		"вкладка версий показывает отозванную версию").ЭтоИстина();
	// в кабинете появилась кнопка восстановления
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/versions", Кука)),
		"value=""unyank""") > 0, "в меню версии — возврат").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧужойПакетБезПравДаёт403() Экспорт
	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Ответ = Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings", Кука);
	Ожидаем.Что(Ответ.КодСостояния).Равно(403);
КонецПроцедуры

&Тест
Процедура УправлениеКаналамиПакетаЧерезКабинет() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Теги пакета") > 0, "секция тегов на странице").ЭтоИстина();
	Токен = Клиент.ТокенCSRF(Стр);

	// заведение тега-правила формой окна: выражение — в поле своего вида
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница,
		ПоляТега(Токен, "semver", "myband", "^1.0", "plain", ""), Кука)), "тег создан").ЭтоИстина();
	Ожидаем.Что(СтрокаКанала(Тело(Клиент.GETСКукой(Страница, Кука)), "myband") <> "",
		"тег в таблице").ЭтоИстина();

	// некорректный regex → та же страница с 400 и открытым окном, PRG не выполнен
	ОтветПлохо = Клиент.POSTФормы(Страница, ПоляТега(Токен, "regex", "badrx", "([", "plain", ""), Кука);
	Ожидаем.Что(ОтветПлохо.КодСостояния, "невалидный тег не редиректит, а показывает страницу с 400").Равно(400);
	Ожидаем.Что(СтрНайти(ТегВвода(ОткрытоеОкно(Тело(ОтветПлохо)), "правило_regex"), "aria-invalid=""true""") > 0,
		"отказ назван у поля выражения в открытом окне").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "badrx"), "невалидный тег не сохранён").Равно(0);

	// удаление — формой подтверждения с эхом имени
	ПоляУд = Новый Соответствие();
	ПоляУд.Вставить("_csrf", Токен);
	ПоляУд.Вставить("confirmed", "1");
	ПоляУд.Вставить("тег", "myband");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница + "/myband/delete", ПоляУд, Кука)), "тег удалён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "myband"), "тег исчез из таблицы").Равно(0);

КонецПроцедуры

// Запрет повторной публикации переключается окном правки в обе стороны; запрос без поля
// тумблера защиту не снимает — снятие говорится явным «0».
&Тест
Процедура ТумблерЗапретаПовторнойПубликацииРаботаетВОбеСтороны() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	Сохранение = Страница + "/guarded/save";

	// тег-правило, а не ручной: он не попадает в список ручных тегов соседних экранов,
	// и упавший на полпути тест не мешает соседям
	ЗавестиТегПравила(Кука, "guarded", "^9.9", "", "");
	Окно = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-guarded"), Кука)));
	Ожидаем.Что(СтрНайти(Окно, "Запрет повторной публикации") > 0,
		"тумблер запрета есть в окне правки").ЭтоИстина();

	Поля = ПоляПравкиТега(Кука, "guarded");
	Ожидаем.Что(Поля.Получить("запрет_перезаписи"),
		"у нового тега тумблер включён").Равно("1");
	Ожидаем.Что(СтрНайти(СтрокаКанала(Тело(Клиент.GETСКукой(Страница, Кука)), "guarded"), "переиздание разрешено"),
		"и в таблице канал ничем не помечен").Равно(0);

	// выключенный тумблер приезжает нулём — это и есть снятие
	Поля.Вставить("запрет_перезаписи", "0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Сохранение, Поля, Кука)), "тег сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаКанала(Тело(Клиент.GETСКукой(Страница, Кука)), "guarded"), "переиздание разрешено") > 0,
		"снятый запрет отмечен в строке тега").ЭтоИстина();

	// запрос БЕЗ поля запрет не снимает и не оставляет снятым — он о нём просто не говорил
	БезПоля = ПоляПравкиТега(Кука, "guarded");
	БезПоля.Удалить("запрет_перезаписи");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Сохранение, БезПоля, Кука)), "тег сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаКанала(Тело(Клиент.GETСКукой(Страница, Кука)), "guarded"), "переиздание разрешено"),
		"умолчавший запрос вернул защиту, а не снял её").Равно(0);

	// и обратно тумблером: включённый возвращает запрет
	Включённый = ПоляПравкиТега(Кука, "guarded");
	Ожидаем.Что(Включённый.Получить("запрет_перезаписи"),
		"окно показывает вернувшийся запрет").Равно("1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Сохранение, Включённый, Кука)), "тег сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаКанала(Тело(Клиент.GETСКукой(Страница, Кука)), "guarded"), "переиздание разрешено"),
		"запрет на месте").Равно(0);

	УдалитьТег(Кука, "guarded");

КонецПроцедуры

// Выражение у semver и regex своё, и поле — в наборе своего вида; у ручного тега выражения нет.
// Браузер шлёт поля всех наборов, а сервер читает поле пришедшего вида.
&Тест
Процедура ПоляВыраженияСтоятВНабореСвоегоВида() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Окно = ОкноСИд(Разметка, "teg-paketa-novyi");
	Ожидаем.Что(Окно <> "", "окно нового тега на странице").ЭтоИстина();
	Ожидаем.Что(СегментВыбран(Окно, "вид", "semver"), "новый тег предложен правилом semver").ЭтоИстина();

	Semver = НаборСегмента(Окно, "semver");
	Ожидаем.Что(СтрНайти(Semver, "name=""правило_semver""") > 0, "диапазон — в наборе semver").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Semver, "name=""правило_regex"""), "чужого выражения в наборе semver нет").Равно(0);

	Regex = НаборСегмента(Окно, "regex");
	Ожидаем.Что(СтрНайти(Regex, "name=""правило_regex""") > 0, "регулярка — в наборе regex").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Regex, "якорится") > 0,
		"вид regex: предупреждение о footgun незаякоренного regex").ЭтоИстина();

	// у ручного тега отбирать версии нечем — в его наборе примечание, а не поле
	Ручной = НаборСегмента(Окно, "manual");
	Ожидаем.Что(Ручной <> "", "у ручного тега свой набор").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ручной, "name=""правило_"), "у ручного тега поля выражения нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ручной, "Ручной тег заводится пустым") > 0, "вместо него — примечание").ЭтоИстина();

	// поля упразднённых режимов не печатаются вовсе
	Ожидаем.Что(СтрНайти(Окно, "name=""метка"""), "поля метки в окне нет").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, "name=""версия"""), "поля версии в окне тега нет").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, "пин"), "режима «пин» в окне нет").Равно(0);

	// браузер отправит оба выражения; записано выражение выбранного вида, соседнее не прочитано
	Поля = ПоляНовогоТега(Разметка);
	Поля.Вставить("имя", "kindpick");
	Поля.Вставить("вид", "regex");
	Поля.Вставить("правило_semver", "^9.9");
	Поля.Вставить("правило_regex", "^1\.0\.0$");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "тег сохранён").ЭтоИстина();

	Строка_ = СтрокаКанала(Тело(Клиент.GETСКукой(Страница, Кука)), "kindpick");
	Ожидаем.Что(СтрНайти(Строка_, "<code>^1\.0\.0$</code>") > 0,
		"записано выражение выбранного вида: " + Строка_).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "^9.9"), "поле чужого набора не прочитано").Равно(0);

	УдалитьТег(Кука, "kindpick");

КонецПроцедуры

// Проба правила — вторичная кнопка ТОЙ ЖЕ формы окна: она читает и ничего не пишет (422 с окном,
// открытым на составе канала), а пишет та же форма без операции.
&Тест
Процедура ПроверкаПравилаПоказываетВерсииИНеПишет() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	// операцию называет НАЖАТАЯ кнопка: скрытым полем она не едет вовсе
	Поля = ПоляНовогоТега(Разметка);
	Ожидаем.Что(Поля.Получить("операция"), "скрытого поля операции в форме нет").Равно(Неопределено);
	Ожидаем.Что(СтрНайти(ОкноСИд(Разметка, "teg-paketa-novyi"), "name=""операция"" value=""проверить""") > 0,
		"проба правила — кнопка той же формы").ЭтоИстина();

	// заполняем видимые поля так, как это сделал бы человек, и жмём «Проверить состав»
	Поля.Вставить("имя", "preview-tag");
	Поля.Вставить("правило_semver", "^1.0");
	Поля.Вставить("операция", "проверить");

	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "проба — не запись: страница с окном, а не редирект").Равно(422);

	Окно = ОткрытоеОкно(Тело(Ответ));
	Ожидаем.Что(СтрНайти(Окно, "Под тегом") > 0, "состав канала показан в окне").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "Отдаёт") > 0, "названа версия, которую отдаст тег").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "<code>1.0.0</code>") > 0, "версия 1.0.0 в составе канала").ЭтоИстина();
	// введённое осталось в окне: иначе проба стирала бы работу автора
	Ожидаем.Что(СтрНайти(ТегВвода(Окно, "имя"), "value=""preview-tag""") > 0,
		"имя тега осталось в окне").ЭтоИстина();

	// НИЧЕГО НЕ СОЗДАНО: проба — чтение
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "preview-tag"),
		"проба тег не создала").Равно(0);

	// ...и пишет ТА ЖЕ форма, отправленная основной кнопкой
	Поля.Удалить("операция");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"основная кнопка той же формы пишет тег").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "preview-tag") > 0,
		"тег создан ИМЕННО отправкой").ЭтоИстина();

	УдалитьТег(Кука, "preview-tag");

	// негатив: мусорное правило не роняет страницу, а печатает отказ у поля в окне
	Мусор = ПоляНовогоТега(Тело(Клиент.GETСКукой(Страница, Кука)));
	Мусор.Вставить("операция", "проверить");
	Мусор.Вставить("имя", "junk-tag");
	Мусор.Вставить("правило_semver", "не-диапазон");
	ОтветМусор = Клиент.POSTФормы(Страница, Мусор, Кука);
	Ожидаем.Что(ОтветМусор.КодСостояния, "мусор в пробе — окно с отказом").Равно(422);
	ОкноМусора = ОткрытоеОкно(Тело(ОтветМусор));
	Ожидаем.Что(СтрНайти(ОкноМусора, "Правило не применено") > 0,
		"причина отказа названа в окне").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТегВвода(ОкноМусора, "правило_semver"), "aria-invalid=""true""") > 0,
		"и стоит у поля выражения").ЭтоИстина();

КонецПроцедуры

// Кнопка пробы есть только в наборах правила и стоит в дереве перед отправкой окна: неявная
// отправка по Enter попадает в пробу, а не пишет тег молча; пустое имя пробу не держит.
&Тест
Процедура КнопкаПроверкиПравилаЕстьТолькоУТегаПравила() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Окно = ОкноСИд(Тело(Клиент.GETСКукой(РазделТегов(), Кука)), "teg-paketa-novyi");

	Для Каждого Вид Из СтрРазделить("semver,regex", ",") Цикл
		Набор = НаборСегмента(Окно, Вид);
		Ожидаем.Что(СтрНайти(Набор, "name=""операция"" value=""проверить""") > 0,
			"вид «" + Вид + "»: проба правила предложена").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Набор, "Проверить состав") > 0,
			"вид «" + Вид + "»: кнопка названа по делу").ЭтоИстина();
		// type="button" молча вернул бы Enter записи; без formnovalidate пустое имя держало бы пробу
		Проверка = ТегКнопкиСо(Набор, "value=""проверить""");
		Ожидаем.Что(СтрНайти(Проверка, "type=""submit""") > 0,
			"вид «" + Вид + "»: проба отправляет форму: " + Проверка).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Проверка, "formnovalidate") > 0,
			"вид «" + Вид + "»: проба уходит без проверки обязательных полей: " + Проверка).ЭтоИстина();
	КонецЦикла;

	// Enter отдаёт форму ПЕРВОЙ кнопке отправки в дереве
	Отправка = СтрНайти(Окно, "<span>Создать тег</span>");
	Ожидаем.Что(Отправка > 0, "у окна есть кнопка записи").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "value=""проверить""") < Отправка,
		"Enter попадает в пробу, а не в запись").ЭтоИстина();

	Ручной = НаборСегмента(Окно, "manual");
	Ожидаем.Что(СтрНайти(Ручной, "value=""проверить"""),
		"у ручного тега правила нет — и кнопки пробы тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Ручной, "Проверить состав"), "и подписи её нет").Равно(0);

КонецПроцедуры

// Имя тега не может совпадать с номером версии пакета: «пакет@1.1.0» читается как версия.
// Окно судит имя само — иначе мейнтейнер увидел бы пятисотку вместо объяснения.
&Тест
Процедура ФормаТегаНеБерётИмяЗанятоеВерсией() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	Поля = ПоляНовогоТега(Тело(Клиент.GETСКукой(Страница, Кука)));
	Поля.Вставить("имя", "1.1.0");
	Поля.Вставить("правило_semver", "^1.0");

	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "имя, занятое версией, — отказ от записи").Равно(400);
	// сравнивается формулировка окна: отказ домена пришёл бы текстом исключения и стёр набранное
	Разметка = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Разметка, "Имя тега занято версией пакета") > 0,
		"причина названа окном, а не пересказом исключения домена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТегВвода(ОткрытоеОкно(Разметка), "имя"), "aria-invalid=""true""") > 0,
		"и стоит у поля имени").ЭтоИстина();
	Ожидаем.Что(ПлашкаТегаНаСтранице(Тело(Клиент.GETСКукой(Страница, Кука)), "1.1.0"),
		"тега с именем версии в разделе не появилось").Равно("");

	// проверка имени до отправки называет занятое имя ДО того, как жать «Создать тег»
	Вопрос = Клиент.GETСКукой(АдресПроверкиИмени(Страница, "1.1.0"), Кука);
	Ожидаем.Что(Вопрос.КодСостояния, "проверка до отправки: имя занято").Равно(409);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Вопрос), "Имя тега занято версией пакета") > 0,
		"проверка называет причину словами").ЭтоИстина();

	// КОНТРОЛЬ: «1.9» выглядит версией, но версии с такой строкой у пакета нет — имя свободно
	Ожидаем.Что(Клиент.GETСКукой(АдресПроверкиИмени(Страница, "1.9"), Кука).КодСостояния,
		"проверка до отправки: свободное имя годится").Равно(200);
	Свободные = ПоляНовогоТега(Тело(Клиент.GETСКукой(Страница, Кука)));
	Свободные.Вставить("имя", "1.9");
	Свободные.Вставить("правило_semver", "^1.0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Свободные, Кука)),
		"имя, не занятое версией, сохраняется").ЭтоИстина();

	УдалитьТег(Кука, "1.9");

КонецПроцедуры

// Кто правило не проверял, узнаёт его состав ПОСЛЕ записи: тег, который молча не отдаёт
// ничего, — самая дорогая ошибка этого экрана.
&Тест
Процедура ПослеСохраненияПравилаВидноКакиеВерсииПопали() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Ответ = Клиент.POSTФормы(Страница, ПоляТега(Токен, "semver", "shownrule", "^1.0", "plain", ""), Кука);
	Ожидаем.Что(УспехМутации(Ответ), "тег-правило сохранён одним нажатием").ЭтоИстина();

	Разметка = ПослеЗаписи(Ответ, Кука);
	Ожидаем.Что(СтрНайти(Разметка, "Под правило тега shownrule попали версии") > 0,
		"состав канала показан и без нажатия пробы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "1.0.0") > 0, "названа попавшая версия").ЭтоИстина();

	// правило, не поймавшее ни одной версии, — предупреждением: такой тег не отдаёт ничего
	ОтветПустого = Клиент.POSTФормы(Страница, ПоляТега(Токен, "semver", "hollowrule", "^99.0", "plain", ""), Кука);
	Ожидаем.Что(УспехМутации(ОтветПустого), "тег с пустым каналом всё равно сохраняется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеЗаписи(ОтветПустого, Кука),
		"Под правило тега hollowrule не попала ни одна") > 0,
		"о пустом канале сказано прямо").ЭтоИстина();

	// у ручного тега правила нет — и состава канала после записи тоже
	ОтветРучного = Клиент.POSTФормы(Страница, ПоляТега(Токен, "manual", "quietman", "", "plain", ""), Кука);
	Ожидаем.Что(СтрНайти(ПослеЗаписи(ОтветРучного, Кука), "попали версии"),
		"ручному тегу нечего отбирать — и уведомления о составе нет").Равно(0);

	УдалитьТег(Кука, "shownrule");
	УдалитьТег(Кука, "hollowrule");
	УдалитьТег(Кука, "quietman");

КонецПроцедуры

// Отозванная версия в канал попадает, но установка её не выбирает: канал из одних
// отозванных читается предупреждением, а не «попали версии».
&Тест
Процедура ОтозванныеВСоставеКаналаНазваныОтдельно() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	// состояние отзывов задаём САМИ: иначе тест читает то, что оставили соседи по набору
	ОтозватьВерсию(Кука, "1.0.0", "unyank");
	ОтозватьВерсию(Кука, "1.1.0", "yank");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	// часть попавших отозвана: успех, но отозванные названы ОТДЕЛЬНО, а не в общем списке
	Разметка = ПослеЗаписи(Клиент.POSTФормы(Страница,
		ПоляТега(Токен, "semver", "mixedrule", "^1.0", "plain", ""), Кука), Кука);

	Смешанный = ТекстТостаСо(Разметка, "Под правило тега mixedrule");
	Ожидаем.Что(СтрНайти(Смешанный, "1.0.0") > 0,
		"отдаваемая версия названа: " + Смешанный).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Смешанный, "Отозванные тоже попали (1.1.0)") > 0,
		"отозванная названа отдельно: " + Смешанный).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ДоПодстроки(Смешанный, "Отозванные"), "1.1.0"),
		"отозванной нет среди отдаваемых: " + Смешанный).Равно(0);
	Ожидаем.Что(ВидТостаСо(Разметка, "Под правило тега mixedrule"),
		"канал с отдаваемой версией — успех").Равно("ok");

	// попали ТОЛЬКО отозванные: тег не отдаёт ничего — это предупреждение, а не успех
	Итог = ПослеЗаписи(Клиент.POSTФормы(Страница,
		ПоляТега(Токен, "regex", "onlyyanked", "^1\.1\.0$", "plain", ""), Кука), Кука);

	Только = ТекстТостаСо(Итог, "Под правило тега onlyyanked");
	Ожидаем.Что(СтрНайти(Только, "попали только отозванные версии (1.1.0)") > 0,
		"канал из одних отозванных назван прямо: " + Только).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Только, "тег не отдаст ничего") > 0,
		"и сказано, что тег не отдаёт ничего: " + Только).ЭтоИстина();
	Ожидаем.Что(ВидТостаСо(Итог, "Под правило тега onlyyanked"),
		"такой канал показан предупреждением, а не успехом").Равно("warn");

	УдалитьТег(Кука, "mixedrule");
	УдалитьТег(Кука, "onlyyanked");

КонецПроцедуры

&Тест
Процедура ФормыДомаНеВложеныДругВДруга() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	Адреса = Новый Массив();
	Адреса.Добавить("/pools/public/packages/alice-pkg/settings/tags");
	Адреса.Добавить("/pools/public/packages/alice-pkg/settings/versions");
	Адреса.Добавить("/pools/public/packages/alice-pkg/settings/card");

	Для Каждого Адрес Из Адреса Цикл
		Ожидаем.Что(ГлубинаВложенностиФорм(Тело(Клиент.GETСКукой(Адрес, Кука))),
			"максимальная вложенность <form> на " + Адрес).Равно(1);
	КонецЦикла;

	// подтверждение удаления пула (куки хаба) приходит окном по адресу: вложенности нет, и поле
	// эха лежит в форме окна — вне её браузер его не отправит
	КукаХаба = Клиент.Войти("root", "RootPassw0rd");
	АдресЗоны = "/pools/owned/settings/danger?" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL)
		+ "=" + КодироватьСтроку("удалить", СпособКодированияСтроки.КодировкаURL);
	ЗонаПула = Тело(Клиент.GETСКукой(АдресЗоны, КукаХаба));
	Ожидаем.Что(ГлубинаВложенностиФорм(ЗонаПула),
		"максимальная вложенность <form> на " + АдресЗоны).Равно(1);

	ПоляЗоны = Клиент.ПоляФормыСо(ЗонаПула, "name=""подтверждение""");
	Ожидаем.Что(ПоляЗоны.Получить("операция"),
		"форма подтверждения объявляет операцию").Равно("пул-удалить");
	Ожидаем.Что(ЗначениеЗаполнено(ПоляЗоны.Получить("_csrf")),
		"и несёт CSRF-токен").ЭтоИстина();

	// раздел доверия — отдельной куки: его порог выше домового; окно заведения закрытым
	// и открытым по адресу (раскрывашка «дополнительно», наборы сегментов)
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Доверие_ = Новый Массив();
	Доверие_.Добавить("/pools/public/packages/alice-pkg/settings/ci");
	Доверие_.Добавить("/pools/public/packages/alice-pkg/settings/ci?" + ОкноВерсии("новый"));
	Для Каждого Адрес Из Доверие_ Цикл
		Разметка = Тело(Клиент.GETСКукой(Адрес, КукаАдмина));
		Ожидаем.Что(СтрНайти(Разметка, "name=""репозиторий""") > 0,
			"страница доверия отдана: " + Адрес).ЭтоИстина();
		Ожидаем.Что(ГлубинаВложенностиФорм(Разметка),
			"максимальная вложенность <form> на " + Адрес).Равно(1);
	КонецЦикла;

	// и на странице ПОСЛЕ пробы правила — там окно тега открыто, и у его формы две кнопки
	Страница = РазделТегов();
	Поля = ПоляНовогоТега(Тело(Клиент.GETСКукой(Страница, Кука)));
	Поля.Вставить("операция", "проверить");
	Поля.Вставить("имя", "nest-probe");
	Поля.Вставить("правило_semver", "*");
	Ожидаем.Что(ГлубинаВложенностиФорм(Тело(Клиент.POSTФормы(Страница, Поля, Кука))),
		"после пробы правила формы тоже не вложены").Равно(1);

КонецПроцедуры

// Обязательное поле под закрытой раскрывашкой внутри формы браузер не отправит — сабмит
// молча не происходит; под кат прячут только необязательное.
&Тест
Процедура ОбязательныхПолейПодЗакрытымКатомНет() Экспорт

	СамотестСканераКатов();

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Страницы = Новый Соответствие();
	Страницы.Вставить("/pools/public/packages/alice-pkg/settings/ci", КукаАдмина);
	Страницы.Вставить("/pools/public/packages/alice-pkg/settings/ci?" + ОкноВерсии("новый"), КукаАдмина);
	Страницы.Вставить("/pools/public/packages/alice-pkg/settings/versions", Кука);
	Страницы.Вставить("/hub/settings/pools", КукаАдмина);

	Закрытых = 0;
	Для Каждого Страница Из Страницы Цикл
		Каты = КатыВнутриФорм(Тело(Клиент.GETСКукой(Страница.Ключ, Страница.Значение)));
		Закрытых = Закрытых + Каты.Закрытых;
		Ожидаем.Что(СтрСоединить(Каты.Обязательные, "; "),
			"обязательные поля под закрытым катом на " + Страница.Ключ).Равно("");
		Ожидаем.Что(Каты.Незакрытых, "незакрытые <details> на " + Страница.Ключ).Равно(0);
	КонецЦикла;

	Ожидаем.Что(Закрытых > 0,
		"закрытые каты внутри форм на этих страницах есть — иначе сторож сторожит пустоту")
		.ЭтоИстина();

КонецПроцедуры

// Самотест сканера катов: образцы, где сторож обязан ловить, и где обязан молчать.
Процедура СамотестСканераКатов()

	Ловит = Новый Соответствие();
	Ловит.Вставить("простой кат в форме",
		"<form><details><summary>ещё</summary><input name=""а"" required></details></form>");
	Ловит.Вставить("слово open ВНУТРИ значения класса атрибутом не является",
		"<form><details class=""fold open danger""><input name=""а"" required></details></form>");
	Ловит.Вставить("слово open внутри значения data-атрибута — тоже не атрибут",
		"<form><details data-x=""a open b""><input name=""а"" required></details></form>");
	Ловит.Вставить("угловая скобка в значении не обрезает тег и не съедает required",
		"<form><details><input value=""a>b"" required></details></form>");
	Ловит.Вставить("включённый набор полей внутри ката прячет обязательное по-настоящему",
		"<form><details><fieldset data-set=""oidc""><input name=""а"" required></fieldset></details></form>");

	Для Каждого Образец Из Ловит Цикл
		Ожидаем.Что(КатыВнутриФорм(Образец.Значение).Обязательные.Количество(),
			"сканер обязан поймать: " + Образец.Ключ).Равно(1);
	КонецЦикла;

	Молчит = Новый Соответствие();
	Молчит.Вставить("раскрытый кат ничего не прячет",
		"<form><details open><input name=""а"" required></details></form>");
	Молчит.Вставить("кат ВНЕ формы браузеру отправлять нечего",
		"<details><input name=""а"" required></details>");
	Молчит.Вставить("обязательное поле рядом с катом — норма",
		"<form><details><input name=""а""></details><input name=""б"" required></form>");
	Молчит.Вставить("отключённый набор полей браузер не валидирует ([data-set])",
		"<form><details><fieldset class=""choice-set"" data-set=""oidc"" disabled hidden>"
		+ "<input name=""а"" required></fieldset></details></form>");
	Молчит.Вставить("отключённое поле браузер не валидирует и поодиночке",
		"<form><details><input name=""а"" required disabled></details></form>");
	Молчит.Вставить("пробел перед скобкой закрывающего тега закрывает кат",
		"<form><details><input name=""а""></details ><input name=""б"" required></form >");
	Молчит.Вставить("выключённый набор закрылся — соседнее поле снова видно",
		"<form><details><fieldset disabled><input name=""а""></fieldset></details>"
		+ "<input name=""б"" required></form>");

	Для Каждого Образец Из Молчит Цикл
		Ожидаем.Что(СтрСоединить(КатыВнутриФорм(Образец.Значение).Обязательные, "; "),
			"сканер обязан молчать: " + Образец.Ключ).Равно("");
	КонецЦикла;

	// незакрытый <details> уводит внутрь всё до конца родителя и считается отдельным числом
	Рваная = КатыВнутриФорм("<form><details><input name=""а"" required></form>");
	Ожидаем.Что(Рваная.Незакрытых, "незакрытый кат назван отдельно").Равно(1);
	Ожидаем.Что(Рваная.Обязательные.Количество(),
		"поле под незакрытым катом всё равно спрятано — так его видит и браузер").Равно(1);
	Ожидаем.Что(КатыВнутриФорм(
		"<form><details><input name=""а""></details></form>").Незакрытых,
		"закрытый кат незакрытым не считается").Равно(0);

КонецПроцедуры

&Тест
Процедура ТегВешаетсяВМенюВерсииВыборомИзСпискаРучных() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/versions";

	// пока ручных тегов у пакета нет, меню не ведёт к пустому окну, а ведёт туда, где их заводят
	Пусто = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Пусто, "class=""menu""") > 0,
		"у строки версии есть меню действий").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Пусто, "href=""/pools/public/packages/alice-pkg/settings/tags""") > 0,
		"без ручных тегов пункт ведёт в раздел «Теги»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Пусто, ОкноВерсии("тег-1.0.0")),
		"без ручных тегов окна тега нет").Равно(0);

	ЗавестиРучнойТег(Кука, "rowtag", "", "");

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, ОкноВерсии("тег-1.0.0")) > 0, "в меню версии — окно тега по адресу").ЭтоИстина();
	// панель стоит внутри обёртки прокрутки — её обрезал бы этот предок, если бы не верхний слой
	Ожидаем.Что(СтрНайти(МеждуМаркеров(Стр, "<div class=""table-scroll"">", "</table>"),
		"class=""menu__panel""") > 0,
		"панель меню — потомок обёртки прокрутки таблицы").ЭтоИстина();

	Окно = Тело(Клиент.GETСКукой(Страница + "?" + ОкноВерсии("тег-1.0.0"), Кука));
	Ожидаем.Что(СтрНайти(Окно, "<option value=""rowtag""") > 0,
		"ручной тег предложен выбором из списка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "<option value=""stable"""),
		"тег-правило в списке не предлагается").Равно(0);
	Токен = Клиент.ТокенCSRF(Окно);

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "rowtag"), Кука)),
		"тег повешен из окна").ЭтоИстина();

	После = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(После, "rowtag") > 0, "тег виден в строке версии").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, ОкноВерсии("снять-rowtag@1.0.0")) > 0,
		"у ручного тега в меню версии — «Снять тег» подтверждением по адресу").ЭтоИстина();
	// у версии с этим тегом его больше не предлагают: других ручных тегов нет — окна нет
	Ожидаем.Что(СтрНайти(После, ОкноВерсии("тег-1.0.0")),
		"вешать висящее нечестно — пункта тега у этой версии нет").Равно(0);

	СнятьТегСВерсии(Кука, "rowtag", "1.0.0");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), ОкноВерсии("снять-rowtag@1.0.0")),
		"тега на версии больше нет").Равно(0);

	УдалитьТег(Кука, "rowtag");

КонецПроцедуры

// Снятие тега без поля подтверждения (форма ушла без скрипта) ведёт на окно подтверждения этой
// метки и ничего не снимает; подтверждённое — снимает. Вопрос задаёт сервер.
&Тест
Процедура СнятиеТегаБезПодтвержденияНеПроходит() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "askme", "", "");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));
	Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "askme"), Кука);

	Спрос = Тело(Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_снять", "1.0.0", "askme"), Кука));
	Окно = ОкноСо(Спрос, "value=""тег_снять""");
	Ожидаем.Что(СтрНайти(Лев(Окно, СтрНайти(Окно, ">")), " open") > 0,
		"первый POST ведёт на страницу с открытым подтверждением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "askme") > 0 И СтрНайти(Окно, "1.0.0") > 0,
		"вопрос называет и тег, и версию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), ОкноВерсии("снять-askme@1.0.0")) > 0,
		"после вопроса тег ВСЁ ЕЩЁ на версии").ЭтоИстина();

	СнятьТегСВерсии(Кука, "askme", "1.0.0");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), ОкноВерсии("снять-askme@1.0.0")),
		"подтверждённое снятие сработало").Равно(0);

	УдалитьТег(Кука, "askme");

КонецПроцедуры

// Снятие тега без скрипта: пункт меню — ссылка на страницу с открытым подтверждением, его форма
// уходит обычной отправкой; прежняя форма снятия со своим полем подтверждения — устарела.
&Тест
Процедура СнятиеТегаИзМенюРаботаетБезJS() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "askjs", "", "");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));
	Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "askjs"), Кука);

	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Страница, Кука)));
	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, "data-confirm-value"), "прежних признаков confirm() нет").Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, "href=""" + Страница + "?" + ОкноВерсии("снять-askjs@1.0.0") + """") > 0,
		"пункт меню — обычная ссылка на страницу с подтверждением").ЭтоИстина();

	// старая форма снятия (своё поле подтверждения вместо подтверждения кита) — 400 без мутации
	Старая = ПоляМеню(Токен, "тег_снять", "1.0.0", "askjs");
	Старая.Вставить("подтверждение", "да");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Старая, Кука).КодСостояния,
		"старая форма снятия — 400 «Страница устарела»").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), ОкноВерсии("снять-askjs@1.0.0")) > 0,
		"тег на месте").ЭтоИстина();

	// путь без скрипта: страница с открытым подтверждением, его форма и кнопка подтверждения
	Вопрос = БезТеговScript(Тело(Клиент.GETСКукой(Страница + "?" + ОкноВерсии("снять-askjs@1.0.0"), Кука)));
	Поля = Клиент.ПоляФормыСо(Вопрос, "value=""тег_снять""");
	Ожидаем.Что(Поля.Получить("имя"), "форма подтверждения называет тег").Равно("askjs");
	Поля.Вставить("confirmed", "1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"подтверждённое снятие проходит обычной отправкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), ОкноВерсии("снять-askjs@1.0.0")),
		"тег снят").Равно(0);

	УдалитьТег(Кука, "askjs");

КонецПроцедуры

// Образец плашки в окне тега зеркалит поля окна словом кита (имя — текстом, стиль и значок —
// признаками), и окно полностью работает без скрипта: ту же плашку печатает сервер в любой перерисовке.
&Тест
Процедура КонструкторТегаОбъявляетКонтрактПлашкиИЖивётБезJS() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Страница, Кука)));

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "oninput="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onchange="), "и обработчиков изменения тоже").Равно(0);

	Окно = ОкноСИд(БезСкриптов, "teg-paketa-novyi");
	Плашка = МеждуМаркеров(Окно, "<span data-mirrors=", ">");
	Ожидаем.Что(СтрНайти(Плашка, "data-mirrors=""стиль значок""") > 0,
		"плашка образца зеркалит стиль и значок: " + Плашка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "data-mirror=""имя""") > 0, "и имя — подписью").ЭтоИстина();

	// имена зеркал — это НАСТОЯЩИЕ поля формы окна, а не отдельный словарь скрипта
	Для Каждого Имя Из СтрРазделить("имя,стиль,значок,вид", ",") Цикл
		Ожидаем.Что(СтрНайти(Окно, "name=""" + Имя + """") > 0,
			"поле «" + Имя + "» есть в окне").ЭтоИстина();
	КонецЦикла;

	// без скрипта плашка всё равно нарисована сервером, окно открывается адресом,
	// а запись уходит обычной кнопкой отправки формы
	Ожидаем.Что(СтрНайти(Плашка, "class=""tag") > 0,
		"плашка напечатана сервером, а не создаётся скриптом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "data-opens=""teg-paketa-novyi""") > 0,
		"кнопка «Новый тег» ведёт к окну и без скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТегКнопкиСо(Окно, "<span>Создать тег</span>"), "type=""submit""") > 0,
		"запись — обычная кнопка отправки формы окна").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НаборСегмента(Окно, "manual"), "value=""проверить"""),
		"у ручного тега кнопки пробы нет вовсе").Равно(0);

	Токен = Клиент.ТокенCSRF(БезСкриптов);
	Запись = Клиент.POSTФормы(Страница, ПоляТега(Токен, "manual", "nojstag", "", "stable", "lock"), Кука);
	Ожидаем.Что(УспехМутации(Запись), "ручной тег заведён без единого скрипта").ЭтоИстина();

	Разметка = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-nojstag"), Кука)));
	Ожидаем.Что(СтрНайти(Разметка, "data-mirror-стиль=""stable"" data-mirror-значок=""замок"" class=""tag tag--ok""><svg") > 0,
		"плашка окна правки напечатана сервером в выбранном стиле, с выбранными признаками").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<span data-mirror=""имя"">nojstag</span>") > 0,
		"подпись — отдельным узлом, её зеркалит поле имени").ЭтоИстина();
	// сохранённый значок плашка печатает сама (выше — <svg сразу за открывающим тегом); значок,
	// выбранный сеткой, кладёт скрипт кита
	Ожидаем.Что(СтрНайти(Разметка, "data-chip-glyph"), "своих глифов-переключателей у хаба нет").Равно(0);
	// проверяем ИМЕННО плашку, а не всю страницу: инлайновый блок токенов темы законен
	Плашка = МеждуМаркеров(Разметка, "<span data-mirrors=", "</div>");
	Ожидаем.Что(СтрНайти(Плашка, "style="),
		"инлайнового стиля у плашки нет: цвет живёт в теме — " + Плашка).Равно(0);

	УдалитьТег(Кука, "nojstag");

КонецПроцедуры

// Существующий тег правится окном по адресу: имя — адрес установки «пакет@тег» и не меняется,
// а вид, правило и оформление меняются.
&Тест
Процедура СуществующийТегПравитсяКонструктором() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	ЗавестиТегПравила(Кука, "editme", "^1.0", "stable", "check");

	// в строке тега есть переход к окну правки этого тега
	Строка_ = СтрокаКанала(Тело(Клиент.GETСКукой(Страница, Кука)), "editme");
	Ожидаем.Что(СтрНайти(Строка_, "Изменить") > 0, "у тега есть правка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, АдресОкнаТегов(Страница, "изменить-editme")) > 0,
		"правка ведёт на окно этого тега по адресу").ЭтоИстина();

	// окно открывается заполненным: вид, правило и оформление подставлены
	Окно = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-editme"), Кука)));
	Ожидаем.Что(Окно <> "", "окно правки открыто адресом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "Тег «editme»") > 0,
		"окно названо правкой этого тега, а не заведением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "/editme/save""") > 0, "форма окна уходит на правку этого тега").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТегВвода(Окно, "правило_semver"), "value=""^1.0""") > 0,
		"правило подставлено в поле своего вида").ЭтоИстина();
	Ожидаем.Что(СегментВыбран(Окно, "вид", "semver"), "вид тега выбран").ЭтоИстина();
	Ожидаем.Что(СегментВыбран(Окно, "стиль", "stable"), "стиль выбран").ЭтоИстина();
	Ожидаем.Что(СегментВыбран(Окно, "значок", "галочка"), "значок (прежний ключ check) отмечен в сетке").ЭтоИстина();

	// правим оформление, не трогая имя, — одной отправкой окна
	Поля = Клиент.ПоляФормыСо(Окно, "/editme/save""");
	Поля.Вставить("стиль", "deprecated");
	Поля.Вставить("значок", "history");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница + "/editme/save", Поля, Кука)),
		"правка сохранена").ЭтоИстина();

	После = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(КлассПлашки(ПлашкаТегаНаСтранице(После, "editme")), "стиль тега изменился")
		.Равно("tag tag--err");
	Ожидаем.Что(СколькоРаз(После, ">editme<"), "второго тега не появилось").Равно(1);

	УдалитьТег(Кука, "editme");

КонецПроцедуры

// Смена вида у существующего тега меняет СОСТАВ канала, поэтому о ней предупреждают
// до записи — в наборе того вида, на который меняют.
&Тест
Процедура СменаРежимаСуществующегоТегаПредупреждаетОСоставе() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	ЗавестиРучнойТег(Кука, "switchme", "plain", "");

	// ручной -> правило: метки будут сняты. Окно правки говорит это ДО записи
	Окно = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-switchme"), Кука)));
	Набор = НаборСегмента(Окно, "semver");
	Ожидаем.Что(СтрНайти(Набор, "сейчас ручной") > 0,
		"названо текущее состояние тега").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Набор, "метки будут сняты") > 0,
		"сказано, ЧТО именно изменится").ЭтоИстина();

	// и проба правила предупреждение не теряет
	Поля = Клиент.ПоляФормыСо(Окно, "/switchme/save""");
	Поля.Вставить("вид", "semver");
	Поля.Вставить("правило_semver", "*");
	Поля.Вставить("операция", "проверить");
	Проба = Клиент.POSTФормы(Страница + "/switchme/save", Поля, Кука);
	Ожидаем.Что(Проба.КодСостояния, "проба — не запись").Равно(422);
	Ожидаем.Что(СтрНайти(ОткрытоеОкно(Тело(Проба)), "метки будут сняты") > 0,
		"проба правила предупреждение не теряет").ЭтоИстина();

	// у заведения нового тега такого предупреждения нет — пугать не за что
	ПоляНового = ПоляТега(Поля.Получить("_csrf"), "semver", "freshtag", "*", "plain", "");
	ПоляНового.Вставить("операция", "проверить");
	ПробаНового = Клиент.POSTФормы(Страница, ПоляНового, Кука);
	Ожидаем.Что(СтрНайти(ОткрытоеОкно(Тело(ПробаНового)), "метки будут сняты"),
		"у нового тега состав менять не с чего").Равно(0);

	УдалитьТег(Кука, "switchme");

КонецПроцедуры

// Список в меню — не гарантия: форму можно подделать. Судит сервер, а не <select>.
&Тест
Процедура ПодделанноеИмяТегаВМенюОтбиваетсяСервером() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "real", "", "");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	// (1) тега с таким именем у пакета нет вовсе
	Чужой = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "нетакого"), Кука);
	Ожидаем.Что(Чужой.КодСостояния, "неизвестное имя тега отбито").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Чужой), "Такого ручного тега у пакета нет") > 0,
		"причина отказа названа").ЭтоИстина();

	// (2) тег есть, но он ПРАВИЛО: ручная метка на нём ни на что не влияет
	Правило = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "stable"), Кука);
	Ожидаем.Что(Правило.КодСостояния, "тег-правило вместо ручного отбит").Равно(400);

	// (3) снять тем же способом чужой тег тоже нельзя
	Снятие = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_снять", "1.0.0", "stable"), Кука);
	Ожидаем.Что(Снятие.КодСостояния, "снятие метки с тега-правила отбито").Равно(400);

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Разметка, "Снять тег нетакого"), "подделка ничего не создала").Равно(0);

	УдалитьТег(Кука, "real");

КонецПроцедуры

// Окно заводит ОБА вида тега; ручной приходит пустым, а оформление — свойство тега,
// поэтому стоит вне наборов вида.
&Тест
Процедура КонструкторЗаводитРучнойТегИПоказываетПревьюПлашки() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Окно = ОкноСИд(Разметка, "teg-paketa-novyi");
	Ожидаем.Что(СтрНайти(Окно, "Как отбирать версии") > 0, "выбор вида тега на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "name=""вид"" value=""manual""") > 0, "ручной — один из видов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "name=""имя""") > 0, "поле имени").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "name=""стиль""") > 0, "выбор стиля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "name=""значок""") > 0, "выбор значка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "type=""color"""), "нативной пипетки больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, "<span data-mirrors=") > 0, "рядом с полями — образец плашки").ЭтоИстина();

	Ручной = НаборСегмента(Окно, "manual");
	Правило = НаборСегмента(Окно, "semver");
	Ожидаем.Что(СтрНайти(Ручной, "name=""правило_"), "у ручного тега поля выражения нет").Равно(0);
	Ожидаем.Что(СтрНайти(Правило, "name=""правило_semver""") > 0, "у тега-правила оно на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ручной + Правило, "name=""стиль"""),
		"стиль — свойство тега, а не вида: в наборах вида его нет").Равно(0);

	// ручной тег заводится ОДНОЙ отправкой окна: шага-предпросмотра между вводом и записью нет
	Токен = Клиент.ТокенCSRF(Разметка);
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница,
		ПоляТега(Токен, "manual", "brandtag", "", "special", "lock"), Кука)),
		"ручной тег сохранён одним нажатием").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-brandtag"), Кука))),
		"data-mirror-стиль=""special"" data-mirror-значок=""замок"" class=""tag tag--accent""") > 0,
		"плашка окна правки — в сохранённом стиле").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(КлассПлашки(ПлашкаТегаНаСтранице(Список, "brandtag")),
		"плашка тега в таблице несёт сохранённый стиль").Равно("tag tag--accent");
	Ожидаем.Что(СтрНайти(СтрокаКанала(Список, "brandtag"), "вручную") > 0,
		"режим сохранён ручным").ЭтоИстина();

	УдалитьТег(Кука, "brandtag");

КонецПроцедуры

// Запрос собирается ровно из выданной разметки окна, как его отправит браузер: поля формы
// плюс выбранные сегменты и вариант списка.
&Тест
Процедура ФормаТегаСобираетсяИзРазметкиИСохраняетВыбранноеОформление() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Окно = ОкноСИд(Разметка, "teg-paketa-novyi");

	// стиль — сегменты, значок — сетка кита, и в них ВСЕ варианты словарей
	Для Каждого Ключ Из СтрРазделить("plain,stable,prerelease,deprecated,special", ",") Цикл
		Ожидаем.Что(СтрНайти(Окно, "name=""стиль"" value=""" + Ключ + """") > 0,
			"стиль «" + Ключ + "» предложен сегментом").ЭтоИстина();
	КонецЦикла;
	Для Каждого Ключ Из СтрРазделить("галочка,успех,предупреждение,ошибка,замок,история,куб,ключ,бренд:telegram", ",") Цикл
		Ожидаем.Что(СтрНайти(Окно, "name=""значок"" value=""" + Ключ + """") > 0,
			"значок «" + Ключ + "» предложен сеткой").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СегментВыбран(Окно, "значок", ""),
		"«без значка» — пустой ключ, а не подпись").ЭтоИстина();

	Поля = ПоляНовогоТега(Разметка);
	Ожидаем.Что(Поля.Получить("вид"), "выбранный вид доехал до запроса").Равно("semver");
	Ожидаем.Что(Поля.Получить("стиль"), "выбранный стиль доехал до запроса").Равно("plain");
	Ожидаем.Что(Поля.Получить("значок"), "выбранный значок доехал до запроса").Равно("");

	// человек меняет ровно то, что меняется мышью, и жмёт единственную основную кнопку
	Поля.Вставить("имя", "formtag");
	Поля.Вставить("правило_semver", "^1.0");
	Поля.Вставить("стиль", "deprecated");
	Поля.Вставить("значок", "lock");

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "тег сохранён").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(КлассПлашки(ПлашкаТегаНаСтранице(Список, "formtag")),
		"плашка тега в таблице несёт выбранный стиль").Равно("tag tag--err");

	// и окно правки открывается с ТЕМИ ЖЕ выбранными вариантами
	Правка = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-formtag"), Кука)));
	Ожидаем.Что(СегментВыбран(Правка, "стиль", "deprecated"),
		"сохранённый стиль выбран при открытии").ЭтоИстина();
	Ожидаем.Что(СегментВыбран(Правка, "значок", "замок"),
		"сохранённый значок (прежний ключ lock) отмечен при открытии").ЭтоИстина();

	УдалитьТег(Кука, "formtag");

КонецПроцедуры

// Вид тега — один список из трёх значений, и каждое сохраняется и открывается выбранным.
&Тест
Процедура ТриВидаТегаСохраняютсяИЧитаютсяОбратно() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	ПроверитьВидТега(Кука, "semver", "^1.0", "kindsemver");
	ПроверитьВидТега(Кука, "regex", "^1\.0\..*$", "kindregex");
	ПроверитьВидТега(Кука, "manual", "", "kindmanual");

КонецПроцедуры

// Тег-правило без выражения отбирать нечем: ни проба, ни запись его не принимают.
&Тест
Процедура ПравилоБезДиапазонаНеСохраняется() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));

	Поля = ПоляНовогоТега(Разметка);
	Поля.Вставить("операция", "проверить");
	Поля.Вставить("имя", "emptyrule");
	Поля.Вставить("правило_semver", "");

	Показ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Показ.КодСостояния, "пустое правило не роняет страницу: окно с отказом").Равно(422);
	Ожидаем.Что(СтрНайти(ТегВвода(ОткрытоеОкно(Тело(Показ)), "правило_semver"), "aria-invalid=""true""") > 0,
		"отказ назван у поля выражения").ЭтоИстина();

	Прямо = ПоляНовогоТега(Разметка);
	Прямо.Вставить("имя", "emptyrule");
	Прямо.Вставить("правило_semver", "");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Прямо, Кука).КодСостояния,
		"запись неисполнимого правила отбита").Равно(400);

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "emptyrule"), "тег не создан").Равно(0);

КонецПроцедуры

// Образец плашки зеркалит выбранный сегмент стиля признаком: поле, которое называет плашка, —
// сегменты окна, напечатан набранный стиль, а вид плашки — тот же класс, что у заведённого тега.
&Тест
Процедура ОбразецПлашкиСтоитНаВыбранномСтиле() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Поля = ПоляТега(Токен, "semver", "chiptag", "*", "deprecated", "lock");
	Поля.Вставить("операция", "проверить");
	Показ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Показ.КодСостояния, "проба правила отдана окном").Равно(422);
	Окно = ОткрытоеОкно(Тело(Показ));

	Плашка = МеждуМаркеров(Окно, "<span data-mirrors=", ">");
	Зеркала = СтрРазделить(Клиент.ЗначениеАтрибута(Плашка, "data-mirrors"), " ", Ложь);
	Ожидаем.Что(Зеркала.Количество(), "плашка образца зеркалит стиль и значок: " + Плашка).Равно(2);
	ИмяПоляСтиля = Зеркала[0];
	Ожидаем.Что(СегментВыбран(Окно, ИмяПоляСтиля, "deprecated"),
		"поле «" + ИмяПоляСтиля + "» — сегменты, и выбран набранный стиль").ЭтоИстина();
	Ожидаем.Что(Клиент.ЗначениеАтрибута(Плашка, "data-mirror-" + ИмяПоляСтиля),
		"плашка напечатана с набранным стилем").Равно("deprecated");

	// вид плашки — тот же класс, что у заведённого тега этого стиля
	Ожидаем.Что(СтрНайти(Плашка, "class=""tag tag--err""") > 0,
		"серверный вид образца — вид устаревшего тега: " + Плашка).ЭтоИстина();

	// и значок: набранный отмечен в сетке кита, а образец несёт его имя
	Ожидаем.Что(Клиент.ЗначениеАтрибута(Плашка, "data-mirror-" + Зеркала[1]),
		"плашка напечатана с набранным значком").Равно("замок");

КонецПроцедуры

// У основного тега тумблер «Тег по умолчанию» включён и заблокирован: заблокированное поле
// браузер не отправляет, и окно, сохранённое как есть, основной не снимает.
&Тест
Процедура ФормаПравкиДефолтногоТегаНеОтдаётПоУмолчанию() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/tags";

	ЗавестиРучнойТег(Кука, "defaulttag", "plain", "");
	СделатьОсновным(Кука, "defaulttag");

	Правка = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-defaulttag"), Кука)));
	Тумблер = ТегВвода(Правка, "по_умолчанию");
	Ожидаем.Что(СтрНайти(Тумблер, " checked") > 0, "у основного тега тумблер включён: " + Тумблер).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тумблер, " disabled") > 0, "и заблокирован: " + Тумблер).ЭтоИстина();

	Поля = Клиент.ПоляФормыСо(Правка, "/defaulttag/save""");
	Ожидаем.Что(Поля.Получить("по_умолчанию"),
		"заблокированный тумблер браузер не отправляет").Равно(Неопределено);

	// окно, отправленное как есть, основной не снимает: снимается он назначением другого тега
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница + "/defaulttag/save", Поля, Кука)),
		"окно правки основного тега сохранено").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(КаналыСПометкойОсновного(Тело(Клиент.GETСКукой(Страница, Кука))), ", "),
		"тег остался основным").Равно("defaulttag");

	// самотест харнесса на живой форме: включённый тумблер даёт «1», выключенный — «0»,
	// и на повторяющееся имя побеждает ПЕРВОЕ значение — ровно как читает сервер
	Карточка = "/pools/public/packages/alice-pkg/settings/card";
	Выключен = Клиент.ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Ожидаем.Что(Выключен.Получить("устарел"), "выключенный тумблер уезжает нулём").Равно("0");

	Включение = Клиент.ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Включение.Вставить("устарел", "1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Карточка + "/deprecated", Включение, Кука)), "признак включён")
		.ЭтоИстина();

	Включен = Клиент.ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Ожидаем.Что(Включен.Получить("устарел"), "включённый тумблер уезжает единицей").Равно("1");

	Возврат_ = Клиент.ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Возврат_.Вставить("устарел", "0");
	Клиент.POSTФормы(Карточка + "/deprecated", Возврат_, Кука);

	УдалитьТег(Кука, "defaulttag");

КонецПроцедуры

// Удача окна — 303 в раздел, где окно закрыто и раздел знает записанный тег; окно правки этого
// тега открывается в его виде: автор ручного тега не оказывается молча в semver-правиле.
&Тест
Процедура ПослеЗаписиОкноЗакрытоИТегОткрываетсяВСвоёмВиде() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Ответ = Клиент.POSTФормыБезПереходов(Страница, ПоляТега(Токен, "manual", "backtag", "", "plain", ""),
		Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "удача окна — перенаправление, а не страница").Равно(303);

	Адрес = Клиент.ЗаголовокОтвета(Ответ, "Location");
	Ожидаем.Что(СтрНайти(Адрес, Страница) > 0, "возврат — в раздел тегов: " + Адрес).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Адрес, "saved_tag=backtag") > 0,
		"раздел узнаёт, какой тег записан: " + Адрес).ЭтоИстина();
	Ожидаем.Что(ОткрытыеОкна(Тело(Клиент.GETСКукой(Адрес, Кука))).Количество(),
		"по возврату окно закрыто").Равно(0);

	Правка = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "изменить-backtag"), Кука)));
	Ожидаем.Что(СегментВыбран(Правка, "вид", "manual"),
		"окно правки открылось в ручном виде").ЭтоИстина();

	УдалитьТег(Кука, "backtag");

КонецПроцедуры

// «Снять тег» в меню версии есть ТОЛЬКО у ручного тега: у тега-правила снятие метки —
// гарантированная ошибка, и пункта, который всегда ошибается, в разметке быть не должно.
&Тест
Процедура СнятиеТегаЕстьТолькоУРучногоТега() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "crosstag", "plain", "");
	ЗавестиТегПравила(Кука, "ruletag", "^1.0", "plain", "");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));
	Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "crosstag"), Кука);

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Разметка, ОкноВерсии("снять-crosstag@1.0.0")) > 0,
		"у ручного тега пункт снятия есть").ЭтоИстина();
	// тег-правило стоит на той же версии сам, без ручной метки
	Ожидаем.Что(СтрНайти(Разметка, ">ruletag<") > 0,
		"тег-правило виден в строке версии").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ОкноВерсии("снять-ruletag@1.0.0")),
		"у тега-правила пункта снятия нет").Равно(0);
	Ожидаем.Что(Клиент.GETСКукой(Страница + "?" + ОкноВерсии("снять-ruletag@1.0.0"), Кука).КодСостояния,
		"адрес снятия тега-правила — страница без окна").Равно(200);

	СнятьТегСВерсии(Кука, "crosstag", "1.0.0");
	УдалитьТег(Кука, "crosstag");
	УдалитьТег(Кука, "ruletag");

КонецПроцедуры

// Стили различаются подписью сегмента, значки — ячейкой сетки кита: у каждой своё значение
// и своя подпись (имя глифа или название бренда), «Без значка» — пустым значением и отмечен у нового.
&Тест
Процедура ВариантыОформленияРазличимыВСегментахИСетке() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Окно = ОкноСИд(Тело(Клиент.GETСКукой(РазделТегов(), Кука)), "teg-paketa-novyi");

	Стили = ПодписиСегментов(Окно, "стиль");
	Ожидаем.Что(Стили.Количество(), "у стиля пять сегментов").Равно(5);
	Ожидаем.Что(РазныхПодписей(Стили), "все подписи стилей различны: "
		+ СтрСоединить(Стили, ", ")).Равно(5);

	Ячейки = ЯчейкиСеткиЗначков(Окно, "значок");
	Значения = Новый Массив();
	Подписи = Новый Массив();
	Для Каждого Ячейка Из Ячейки Цикл
		Значения.Добавить(Ячейка.Значение);
		Подписи.Добавить(Ячейка.Подпись);
	КонецЦикла;
	Ожидаем.Что(Ячейки.Количество() > 9, "в сетке больше прежних девяти вариантов: " + Ячейки.Количество())
		.ЭтоИстина();
	Ожидаем.Что(РазныхПодписей(Значения), "значения ячеек различны").Равно(Ячейки.Количество());
	Ожидаем.Что(РазныхПодписей(Подписи), "подписи ячеек различны: " + СтрСоединить(Подписи, ", "))
		.Равно(Ячейки.Количество());
	Ожидаем.Что(Значения.Найти("бренд:telegram") <> Неопределено, "бренды в сетке есть").ЭтоИстина();
	Ожидаем.Что(Значения.Найти("замок") <> Неопределено, "и глифы").ЭтоИстина();
	Ожидаем.Что(СегментВыбран(Окно, "значок", ""), "у нового тега отмечено «Без значка»").ЭтоИстина();

КонецПроцедуры

// Стиль и значок — ключи закрытых списков, и судит их СЕРВЕР: сегменты и список в браузере —
// удобство, а не гарантия. Подделанное значение не сохраняется и не доезжает до разметки.
&Тест
Процедура ПодделанноеОформлениеТегаОтбиваетсяФормой() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = РазделТегов();
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Подделки = Новый Массив();
	Подделки.Добавить("'><script>alert(1)</script>");
	Подделки.Добавить("#e0603a");
	Подделки.Добавить("кислотный");

	Для Каждого Значение Из Подделки Цикл
		Ответ = Клиент.POSTФормы(Страница, ПоляТега(Токен, "manual", "poison", "", Значение, ""), Кука);
		Ожидаем.Что(Ответ.КодСостояния, "стиль «" + Значение + "» отклонён").Равно(400);
		Разметка = Тело(Ответ);
		Ожидаем.Что(СтрНайти(Разметка, "Оформление не принято") > 0, "причина названа").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Разметка, Значение),
			"непринятое значение НЕ отражается обратно в разметку").Равно(0);
	КонецЦикла;

	// значок судится тем же гейтом: закрытый список и на нём
	Значок = Клиент.POSTФормы(Страница, ПоляТега(Токен, "manual", "poison", "", "stable", "череп"), Кука);
	Ожидаем.Что(Значок.КодСостояния, "незнакомый значок отклонён").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Значок), "Оформление не принято") > 0,
		"причина отказа по значку названа").ЭтоИстина();

	// вид — такой же закрытый список, и он стоит на пути ЗАПИСИ: политика на всех трёх
	// полях одной формы одна
	Для Каждого Значение Из Подделки Цикл
		Ответ = Клиент.POSTФормы(Страница, ПоляТега(Токен, Значение, "poison", "", "stable", ""), Кука);
		Ожидаем.Что(Ответ.КодСостояния, "вид «" + Значение + "» отклонён").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Ответ), "Вид тега не принят") > 0, "причина названа").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Ответ), Значение),
			"непринятый вид НЕ отражается обратно в разметку").Равно(0);
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "poison"),
		"ни одна подделка не создала тега").Равно(0);

	// и сырого цвета в разметке страницы пакета нет вовсе — цвет живёт в теме
	Публичная = Тело(Клиент.GET("/pools/public/packages/alice-pkg")) + Тело(Клиент.GET("/pools/public/packages/alice-pkg/versions"));
	Ожидаем.Что(СтрНайти(Публичная, "#e0603a"), "хранимого цвета не осталось").Равно(0);

	// имя тега тоже судит сервер: непринимаемое имя не пишется
	Запись = Клиент.POSTФормы(Страница, ПоляТега(Токен, "manual", "Плохое Имя", "", "", ""), Кука);
	Ожидаем.Что(Запись.КодСостояния, "непринимаемое имя не сохраняется").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Запись), "Имя тега не принято") > 0, "причина названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Плохое"), "тег не создан").Равно(0);

	// а проверка до отправки — вопрос, а не запись: тот же отказ называется без записи
	Вопрос = Клиент.GETСКукой(АдресПроверкиИмени(Страница, "Плохое Имя"), Кука);
	Ожидаем.Что(Вопрос.КодСостояния, "проверка непринимаемого имени отвечает отказом").Равно(409);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Вопрос), "Имя тега не принято") > 0,
		"причина названа и в проверке").ЭтоИстина();

КонецПроцедуры

#Область ВидТегаНаВсехСтраницах


// Стиль и значок выбираются один раз, а тег виден на четырёх страницах: цвет и значок везде
// одни, эталон — экран настроек.
&Тест
Процедура ВидТегаОдинаковыйНаВсехСтраницахПакета() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-old", "*", "deprecated", "stop");

	Эталон = ПлашкаТегаНаСтранице(
		Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/tags", Кука)), "chan-old");
	Ожидаем.Что(КлассПлашки(Эталон),
		"стиль «устаревший» на экране, где его выбрали").Равно("tag tag--err");
	Ожидаем.Что(ЗначокПлашки(Эталон) <> "", "и выбранный значок нарисован").ЭтоИстина();

	Для Каждого Страница Из СтраницыСТегами(Кука) Цикл

		Плашка = ПлашкаТегаНаСтранице(Страница.Значение, "chan-old");
		Ожидаем.Что(Плашка <> "", "плашка тега есть на " + Страница.Ключ).ЭтоИстина();
		Ожидаем.Что(КлассПлашки(Плашка),
			"цвет тега на " + Страница.Ключ).Равно(КлассПлашки(Эталон));
		Ожидаем.Что(ЗначокПлашки(Плашка),
			"значок тега на " + Страница.Ключ).Равно(ЗначокПлашки(Эталон));

	КонецЦикла;

	УдалитьТег(Кука, "chan-old");

КонецПроцедуры

// «Сюда придёт установка без версии» — свойство ОСНОВНОГО тега, а не совпадения имени
// с базовым списком. Пометка едет за пометкой мейнтейнера и выглядит везде одинаково.
&Тест
Процедура ПометкаОсновногоКаналаЕдетЗаПометкойМейнтейнера() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-first", "*", "stable", "verified");
	ЗавестиТегПравила(Кука, "chan-second", "*", "prerelease", "warning");

	СделатьОсновным(Кука, "chan-first");
	ПроверитьПометкуОсновного(Кука, "chan-first");

	СделатьОсновным(Кука, "chan-second");
	ПроверитьПометкуОсновного(Кука, "chan-second");

	УдалитьТег(Кука, "chan-first");
	УдалитьТег(Кука, "chan-second");

КонецПроцедуры

// Пометка основного канала — значок с подписью: подпись озвучивается скринридеру
// и печатается подсказкой браузера.
&Тест
Процедура ПометкаОсновногоКаналаЗначокСоСловеснойПодписью() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-mark", "*", "stable", "verified");
	СделатьОсновным(Кука, "chan-mark");

	Разметка = Тело(Клиент.GETСКукой(РазделТегов(), Кука));

	Ожидаем.Что(СтрНайти(Разметка, "(по умолчанию)"),
		"словесной пометки на экране не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "<title>" + ПодписьОсновногоКанала() + "</title>") > 0,
		"пометка звучит словами: подпись значка на месте").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(КаналыСПометкойОсновного(Разметка), ", "),
		"и значок стоит у основного канала").Равно("chan-mark");

	УдалитьТег(Кука, "chan-mark");

КонецПроцедуры

// Значок пометки основного канала стоит в ячейке тега своей строки: своего столбца у пометки
// нет — на узком экране строка становится карточкой.
&Тест
Процедура ПометкаОсновногоКаналаСтоитВЯчейкеТегаСвоейСтроки() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-main", "*", "stable", "verified");
	ЗавестиТегПравила(Кука, "chan-side", "*", "prerelease", "warning");
	СделатьОсновным(Кука, "chan-main");

	Разметка = Тело(Клиент.GETСКукой(РазделТегов(), Кука));
	Основная = СтрокаКанала(Разметка, "chan-main");
	Прочая = СтрокаКанала(Разметка, "chan-side");

	Ожидаем.Что(ПометкаВЯчейкеТега(Основная),
		"строка основного канала несёт значок пометки в ячейке тега: " + Основная).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Основная, ПодписьОсновногоКанала()),
		"пометка в строке ОДНА: второй копии столбцом нет: " + Основная).Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(Прочая, ПодписьОсновногоКанала()),
		"у обычного канала пометки нет вовсе: " + Прочая).Равно(0);

	УдалитьТег(Кука, "chan-main");
	УдалитьТег(Кука, "chan-side");

КонецПроцедуры

// Действия строки своего канала — за шестерёнкой, как в списках пулов, учёток и версий: панель
// во всплывающем слое, правка и удаление — окнами по адресу, мимо окна ничего не уходит.
&Тест
Процедура МенюСтрокиКаналаНесётДействияЗаШестерёнкой() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-menu", "^1.0", "", "");

	// всё утверждается В ПРЕДЕЛАХ СТРОКИ канала: меню учётки в шапке страницы даёт и
	// class="menu", и popovertarget — на целой странице эти признаки зелены всегда
	Строка_ = СтрокаКанала(Тело(Клиент.GETСКукой(РазделТегов(), Кука)), "chan-menu");
	Ожидаем.Что(Строка_ <> "", "строка канала нашлась в таблице").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Строка_, "class=""menu""") > 0,
		"действия строки собраны в меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "popovertarget=""") > 0,
		"у меню есть кнопка-открывашка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "Действия с каналом «chan-menu»") > 0,
		"меню названо своим каналом: одинаковых шестерёнок в таблице столько же,"
		+ " сколько строк").ЭтоИстина();

	Правка = КодироватьСтроку("изменить-chan-menu", СпособКодированияСтроки.КодировкаURL);
	Удаление = КодироватьСтроку("удалить-chan-menu", СпособКодированияСтроки.КодировкаURL);
	Панель = ПанельМенюСо(Строка_, Правка);
	Ожидаем.Что(Панель <> "", "панель этой строки лежит во всплывающем слое").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "Изменить") > 0, "правка — пунктом меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "Удалить") > 0, "удаление — пунктом меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, Удаление) > 0,
		"удаление ведёт в окно подтверждения этого тега").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "<form"),
		"своему тегу меню форм мимо окон не шлёт").Равно(0);

	// за пределами панели действий в строке нет
	Снаружи = БезПанелейМеню(Строка_);
	Ожидаем.Что(СтрНайти(Снаружи, "Удалить"),
		"голой кнопки удаления в строке нет").Равно(0);
	Ожидаем.Что(СтрНайти(Снаружи, Удаление), "и голой ссылки на удаление тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Снаружи, Правка), "и голой ссылки правки тоже").Равно(0);

	УдалитьТег(Кука, "chan-menu");

КонецПроцедуры

// Длинное выражение распирало бы колонку: в строке канала — его начало с многоточием, целиком —
// в подсказке; у ручного тега вместо выражения — слово.
&Тест
Процедура ДлинноеПравилоКаналаОбрезаноИЦеликомВПодсказке() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	// в выражении нет символов, которые экранирование переписало бы: ищем его как есть
	Выражение = "^1\.2\.(3|4)-nightly\.[0-9]+-build\.[0-9]+$";
	ЗавестиТегРегекса(Кука, "chan-long", Выражение);
	ЗавестиРучнойТег(Кука, "chan-plain", "", "");

	Разметка = Тело(Клиент.GETСКукой(РазделТегов(), Кука));

	Длинная = СтрокаКанала(Разметка, "chan-long");
	Ожидаем.Что(Длинная <> "", "строка канала нашлась в таблице").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Длинная, Лев(Выражение, 31) + "…</code>") > 0,
		"в строке — начало выражения с многоточием: " + Длинная).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Длинная, "title=""" + Выражение + """") > 0,
		"целиком — в подсказке: " + Длинная).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Длинная, ">" + Выражение + "<"),
		"целиком текстом строки выражение не печатается").Равно(0);

	// ручной тег правила не имеет: в ячейке слово, а не выражение
	Ручная = СтрокаКанала(Разметка, "chan-plain");
	Ожидаем.Что(СтрНайти(Ручная, "вручную") > 0, "у ручного тега — «вручную»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ручная, "<code"), "и выражения нет").Равно(0);

	УдалитьТег(Кука, "chan-long");
	УдалитьТег(Кука, "chan-plain");

КонецПроцедуры

// Канал — свойство ЛЮБОГО тега, а не только тега с базовым именем: тег-правило со своим
// именем показан каналом, в своём стиле и со своей командой установки.
&Тест
Процедура ЛюбойТегПоказанКаналомСоСвоейКомандойУстановки() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-lts", "*", "special", "lock");
	ЗавестиТегПравила(Кука, "chan-any", "*", "plain", "");

	Плоско = Тело(Клиент.GET("/pools/public/packages/alice-pkg/versions?flat=1"));

	Для Каждого Имя Из СтрРазделить("chan-lts,chan-any", ",") Цикл
		Плашка = ПлашкаТегаНаСтранице(Плоско, Имя);
		Ожидаем.Что(Плашка <> "", "канал «" + Имя + "» показан в списке версий").ЭтоИстина();
		Подсказка = ПодсказкаПлашки(Плашка);
		Ожидаем.Что(СтрНачинаетсяС(Подсказка, "Канал обновления: opm install "),
			"подсказка канала «" + Имя + "»: " + Подсказка).ЭтоИстина();
		Ожидаем.Что(СтрЗаканчиваетсяНа(Подсказка, "@" + Имя),
			"и команда называет ЭТОТ тег: " + Подсказка).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(КлассПлашки(ПлашкаТегаНаСтранице(Плоско, "chan-lts")),
		"«особый» стиль небазового канала не подменён нейтральным").Равно("tag tag--accent");

	УдалитьТег(Кука, "chan-lts");
	УдалитьТег(Кука, "chan-any");

КонецПроцедуры

// У пакета без каналов экран тегов пуст и предлагает визард; каждое заведённое им имя
// отвечает версией, а не «нет такого».
&Тест
Процедура ВизардЗаводитКаналыСЭкранаТегов() Экспорт

	// свой пакет, которого не касается ни один сосед по набору: у нового пакета каналов
	// нет вовсе, и именно это состояние показывает визард
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Имя = "wizard-pkg";
	Токен = Клиент.ВыпуститьPAT(Кука);
	// по версии на каждый предлагаемый канал: релиз, кандидат и сборочная
	Для Каждого Версия Из СтрРазделить("1.0.0,1.1.0-rc.1,1.2.0-alpha.1", ",") Цикл
		Ожидаем.Что(PushТокеном(Токен, "public", Имя, Версия).КодСостояния,
			"свежий пакет опубликован: " + Версия).Равно(201);
	КонецЦикла;

	Страница = "/pools/public/packages/" + Имя + "/settings/tags";
	Ожидаемые = СтрРазделить("stable,prerelease,develop", ",");
	Резолв = "/api/v1/pools/public/packages/" + Имя + "/resolve?spec=";

	Пусто = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Пусто, "Создать каналы") > 0,
		"у пакета без каналов на экране есть кнопка визарда").ЭтоИстина();
	Ожидаем.Что(Клиент.GET(Резолв + "stable").КодСостояния,
		"КОНТРОЛЬ: до визарда «stable» — «нет такого»").Равно(404);

	// серверная дорога к окну: кнопка — ссылка на адрес, по которому визард приходит открытым
	Ожидаем.Что(СтрНайти(Пусто, "data-opens=""kanaly-po-umolchaniyu""") > 0,
		"кнопка визарда ведёт к окну и без скрипта").ЭтоИстина();
	Окно = ОткрытоеОкно(Тело(Клиент.GETСКукой(АдресОкнаТегов(Страница, "каналы"), Кука)));
	Ожидаем.Что(СтрНайти(Окно, " id=""kanaly-po-umolchaniyu""") > 0, "адресом открыт именно визард").ЭтоИстина();

	// каждый предлагаемый канал показан с составом словами — плашка словами не является
	Для Каждого ИмяКанала Из Ожидаемые Цикл
		Ожидаем.Что(СоставКаналаВОкне(Окно, ИмяКанала),
			"канал «" + ИмяКанала + "» предложен со словами о своём составе").Заполнено();
	КонецЦикла;

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Пусто));
	Поля.Вставить("операция", "каналы_по_умолчанию");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "визард отработал").ЭтоИстина();

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Для Каждого ИмяКанала Из Ожидаемые Цикл
		Ожидаем.Что(ЗначениеЗаполнено(ПлашкаТегаНаСтранице(Разметка, ИмяКанала)),
			"экран показывает канал «" + ИмяКанала + "»").ЭтоИстина();
		Ожидаем.Что(Клиент.GET(Резолв + ИмяКанала).КодСостояния,
			"показанный экраном канал «" + ИмяКанала + "» отдаёт версию").Равно(200);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Разметка, "Создать каналы"),
		"кнопки визарда у пакета с каналами больше нет").Равно(0);

	// опечатка в имени канала объясняется перечнем заведённых — и на резолве, и на выдаче
	Отказ = Клиент.GET(Резолв + "stabel");
	Ожидаем.Что(Отказ.КодСостояния, "незаведённое имя → 404").Равно(404);
	Сообщение = Отказ.ПолучитьТелоКакСтроку();
	Ожидаем.Что(СтрНайти(Сообщение, "stabel") > 0, "названо то, чего нет: " + Сообщение).ЭтоИстина();

	Выдача = Клиент.GET("/api/v1/pools/public/channels/stabel/download/" + Имя + "/" + Имя + ".ospx");
	Ожидаем.Что(Выдача.КодСостояния, "канальный путь с опечаткой → 404").Равно(404);
	ТелоВыдачи = Выдача.ПолучитьТелоКакСтроку();
	Ожидаем.Что(СтрНайти(ТелоВыдачи, "stabel") > 0,
		"выдача тоже называет незаведённое имя: " + ТелоВыдачи).ЭтоИстина();

	Для Каждого ИмяКанала Из Ожидаемые Цикл
		Ожидаем.Что(СтрНайти(Сообщение, ИмяКанала) > 0,
			"резолв перечислил заведённый «" + ИмяКанала + "»: " + Сообщение).ЭтоИстина();
		Ожидаем.Что(СтрНайти(ТелоВыдачи, ИмяКанала) > 0,
			"и выдача теми же словами: " + ТелоВыдачи).ЭтоИстина();
	КонецЦикла;

	ПовторноеНажатиеПредупреждает(Кука, Страница);

КонецПроцедуры

// Пометка основного на трёх страницах, где тег показан каналом, — один и тот же канал.
Процедура ПроверитьПометкуОсновного(Знач Кука, Знач Ожидаемый)

	Адреса = Новый Массив();
	Адреса.Добавить(РазделТегов());
	Адреса.Добавить("/pools/public/packages/alice-pkg/versions");
	Адреса.Добавить("/pools/public/packages/alice-pkg/versions?flat=1");

	Для Каждого Адрес Из Адреса Цикл
		Помеченные = КаналыСПометкойОсновного(Тело(Клиент.GETСКукой(Адрес, Кука)));
		Ожидаем.Что(СтрСоединить(Помеченные, ", "),
			"пометка основного канала на " + Адрес).Равно(Ожидаемый);
	КонецЦикла;

КонецПроцедуры

// «Сделать основным» — тумблер «Тег по умолчанию» в окне правки: форма окна уходит целиком.
Процедура СделатьОсновным(Знач Кука, Знач ИмяТега)

	Поля = ПоляПравкиТега(Кука, ИмяТега);
	Поля.Вставить("по_умолчанию", "1");

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(РазделТегов() + "/" + ИмяТега + "/save", Поля, Кука)),
		"тег " + ИмяТега + " стал основным").ЭтоИстина();

КонецПроцедуры

Функция СтраницыСТегами(Знач Кука)

	Результат = Новый Соответствие();
	Для Каждого Адрес Из СтрРазделить("/settings/tags,/settings/versions,/versions,"
		+ "/versions?flat=1", ",") Цикл
		Результат.Вставить("/pools/public/packages/alice-pkg" + Адрес,
			Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg" + Адрес, Кука)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Плашка тега по подписи; у тега-правила первый же </span> закрывает именно её.
Функция ПлашкаТегаНаСтранице(Знач Разметка, Знач ИмяТега)

	Хвост = Разметка;
	Начало = СтрНайти(Хвост, "<span class=""tag");

	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало);
		Конец = СтрНайти(Хвост, "</span>");
		Фрагмент = ?(Конец = 0, Хвост, Лев(Хвост, Конец + 6));
		Если СтрЗаканчиваетсяНа(Фрагмент, ">" + ИмяТега + "</span>") Тогда
			Возврат Фрагмент;
		КонецЕсли;
		Хвост = Сред(Хвост, 2);
		Начало = СтрНайти(Хвост, "<span class=""tag");
	КонецЦикла;

	Возврат "";

КонецФункции

Функция КлассПлашки(Знач Фрагмент)
	Возврат Клиент.ПослеМаркера(Фрагмент, "class=""", """");
КонецФункции

Функция ПодсказкаПлашки(Знач Фрагмент)
	Возврат Клиент.ПослеМаркера(Фрагмент, "title=""", """");
КонецФункции

Функция ЗначокПлашки(Знач Фрагмент)

	Начало = СтрНайти(Фрагмент, "<svg");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Фрагмент, Начало);
	Конец = СтрНайти(Хвост, "</svg>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец + 5));

КонецФункции

// Имена каналов с пометкой основного, опознанной по словам подписи значка.
Функция КаналыСПометкойОсновного(Знач Разметка)

	Найденные = Новый Соответствие();
	Маркер = "</span> <span class=""muted""><svg";

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Голова = Лев(Хвост, Позиция - 1);
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Если ЗначокОзвучен(Хвост, ПодписьОсновногоКанала()) Тогда
			Найденные.Вставить(ПодписьПеред(Голова), Истина);
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого КиЗ Из Найденные Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Что пометка основного канала говорит человеку и скринридеру.
Функция ПодписьОсновногоКанала()
	Возврат "Канал по умолчанию";
КонецФункции

// Стоит ли в первой ячейке строки значок пометки, названный словами.
Функция ПометкаВЯчейкеТега(Знач Строка_)

	Ячейка = ПерваяЯчейкаСтроки(Строка_);
	Если СтрНайти(Ячейка, "<span class=""tag") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// значков в ячейке два: свой значок плашки тега и пометка — ищем ОЗВУЧЕННЫЙ
	Хвост = Ячейка;
	Позиция = СтрНайти(Хвост, "<svg");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + 4);
		Если ЗначокОзвучен(Хвост, ПодписьОсновногоКанала()) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, "<svg");
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПерваяЯчейкаСтроки(Знач Строка_)
	Возврат МеждуМаркеров(Строка_, "<td", "</td>");
КонецФункции

// Значок озвучен, если в пределах одного рисунка его имя — ожидаемые слова.
Функция ЗначокОзвучен(Знач ХвостПослеSVG, Знач Подпись)

	Конец = СтрНайти(ХвостПослеSVG, "</svg>");
	Если Конец = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Рисунок = Лев(ХвостПослеSVG, Конец);
	Возврат СтрНайти(Рисунок, "role=""img""") > 0
		И СтрНайти(Рисунок, "<title>" + Подпись + "</title>") > 0;

КонецФункции

// Содержимое всплывающих панелей меню: вложенных блоков нет, панель закрывает первый </div>.
Функция ПанелиМеню(Знач Разметка)

	Результат = Новый Массив();
	Маркер = " popover class=""menu__panel"">";

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, "</div>");
		Результат.Добавить(?(Конец = 0, Хвост, Лев(Хвост, Конец - 1)));
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Панель меню, внутри которой встретился признак строки.
Функция ПанельМенюСо(Знач Разметка, Знач Признак)

	Для Каждого Панель Из ПанелиМеню(Разметка) Цикл
		Если СтрНайти(Панель, Признак) > 0 Тогда
			Возврат Панель;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Страница без содержимого панелей: в ней видно только то, что осталось стоять в строках.
Функция БезПанелейМеню(Знач Разметка)

	Результат = Разметка;
	Для Каждого Панель Из ПанелиМеню(Разметка) Цикл
		Результат = СтрЗаменить(Результат, Панель, "");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка таблицы, в которой напечатана плашка этого канала.
Функция СтрокаКанала(Знач Разметка, Знач ИмяТега)

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, "<tr");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + 3);
		Конец = СтрНайти(Хвост, "</tr>");
		Строка_ = ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));
		Если СтрНайти(Строка_, ">" + ИмяТега + "</span>") > 0 Тогда
			Возврат Строка_;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, "<tr");
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПодписьПеред(Знач Голова)

	Индекс = СтрДлина(Голова);
	Пока Индекс > 0 Цикл
		Если Сред(Голова, Индекс, 1) = ">" Тогда
			Возврат Сред(Голова, Индекс + 1);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Голова;

КонецФункции

#КонецОбласти

&Тест
Процедура УровняТеговПулаБольшеНет() Экспорт

	// у тегов нет уровня пула: publisher правит теги своих пакетов, а подсунутое поле «уровень»
	// ничего не даёт
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/tags";

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Теги пакета") > 0, "publisher видит страницу управления").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Теги пула"), "секции тегов ПУЛА больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "name=""уровень"""), "поля «уровень» в форме нет").Равно(0);
	Токен = Клиент.ТокенCSRF(Стр);
	Ожидаем.Что(СтрДлина(Токен)).Равно(64);

	// подсунутое поле «уровень=пул» игнорируется: тег создаётся на ПАКЕТЕ, а не на пуле
	Поля = ПоляТега(Токен, "semver", "poollevel", "^0.0", "plain", "");
	Поля.Вставить("уровень", "пул");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "тег сохранён на пакете").ЭтоИстина();

	// тег лёг на этот пакет: сущность Тег привязана к пакету, уровня пула нет
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "poollevel") > 0,
		"тег виден в списке тегов пакета").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧужойНеПравитТегиПакета() Экспорт

	// bob не имеет прав на alice-pkg → 403 на любую мутацию тега пакета (гвард пакета).
	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Страница = "/pools/public/packages/alice-pkg/settings/tags";

	Поля = ПоляТега("нет", "semver", "hack", "^1.0", "plain", "");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Поля, Кука).КодСостояния,
		"чужой без прав: 403 на заведение тега пакета").Равно(403);
	Ожидаем.Что(Клиент.POSTФормы(Страница + "/hack/save", Поля, Кука).КодСостояния,
		"чужой без прав: 403 на правку тега пакета").Равно(403);
	Удаление = Новый Соответствие();
	Удаление.Вставить("_csrf", "нет");
	Удаление.Вставить("confirmed", "1");
	Удаление.Вставить("тег", "hack");
	Ожидаем.Что(Клиент.POSTФормы(Страница + "/hack/delete", Удаление, Кука).КодСостояния,
		"чужой без прав: 403 на удаление тега пакета").Равно(403);

КонецПроцедуры

&Тест
Процедура АдминРазделСтрогоДляАдмина() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаАдмина).КодСостояния, "админ входит").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/users", КукаАдмина).КодСостояния, "список пользователей").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаАлисы).КодСостояния, "не-админу отказ").Равно(403);

	// заведение пула — мутация админа под CSRF; не-админ той же формой пул не заводит
	Имя = УникальныеИмена.Имя("adminonly");
	Ожидаем.Что(УспехМутации(ЗавестиПул(КукаАдмина, Имя, "public")), "админ заводит пул").ЭтоИстина();
	Чужой = УникальныеИмена.Имя("aliceonly");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), ПоляНовогоПула(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/", КукаАлисы))),
			Чужой, "public"), КукаАлисы).КодСостояния,
		"не-админ пул в разделе хаба не заводит").Равно(403);
	Ожидаем.Что(ИдПула(Чужой), "и пула в базе нет").Равно(0);

	// удаление пула — тоже только админу: посторонний с верным эхом и подтверждением получает 403, пул цел
	ПоляУдаления = ПоляПодтверждения(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/", КукаАлисы))));
	ПоляУдаления.Вставить("имя", Имя);
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов() + "/" + Имя + "/delete", ПоляУдаления, КукаАлисы).КодСостояния,
		"не-админ пул в разделе хаба не удаляет").Равно(403);
	Ожидаем.Что(ИдПула(Имя) > 0, "и пул цел").ЭтоИстина();

КонецПроцедуры

// Проба почты доходит до администратора обеими половинами: кнопка есть на странице,
// а нажатие попадает в пульт пробы, а не в общий разбор «сохранить значения раздела».
&Тест
Процедура РазделПочтыПредлагаетПробуИОтвечаетНаНеё() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Страница = Тело(Клиент.GETСКукой(АдресПочты(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Страница, "Отправить проверочное письмо") > 0,
		"в разделе «Почта» есть кнопка пробы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Письмо уйдёт на адрес вашей учётной записи") > 0,
		"и страница называет получателя, а поля «кому» не предлагает").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Поля.Вставить("операция", "проба-почты");
	Ответ = Клиент.POSTФормы(АдресПочты(), Поля, КукаАдмина);

	// почта стенда не настроена — ждём отказ пробы, а не «неизвестную операцию» общего разбора
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Отправка почты не настроена") > 0,
		"нажатие разобрал пульт пробы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Неизвестная операция раздела") = 0,
		"и операция не провалилась в общий разбор значений").ЭтоИстина();

КонецПроцедуры

#Область ПриглашенияУчёток

// Полный цикл глазами обоих участников: админ заводит закрытую учётку и получает ссылку,
// человек по ссылке задаёт пароль и входит логином. Ссылка после этого мертва.
&Тест
Процедура АдминПриглашаетЧеловекСтавитПарольИВходит() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "invited1";

	Страница = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ответ = Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(Клиент.ТокенCSRF(Страница), Логин, Логин + "@ex.com", "user"), КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "учётка заведена").Равно(200);

	Ссылка = ИзвлечьЗначениеПриглашения(Тело(Ответ));
	Ожидаем.Что(ЗначениеЗаполнено(Ссылка), "ссылка показана один раз прямо в ответе").ЭтоИстина();

	// до установки пароля учётка закрыта: вход не пускает
	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти(Логин, "Invited1Passw0rd")),
		"закрытая учётка не пускает").ЭтоЛожь();

	ФормаПароля = Клиент.GET("/invite?token=" + Ссылка);
	Ожидаем.Что(ФормаПароля.КодСостояния, "аноним видит форму установки пароля").Равно(200);
	ТелоФормыПароля = Тело(ФормаПароля);
	Ожидаем.Что(СтрНайти(ТелоФормыПароля, Логин) > 0,
		"и форма называет учётную запись").ЭтоИстина();

	// требования к паролю названы прямо у поля: словами — для человека, кодом — для
	// живой проверки по мере набора
	Ожидаем.Что(СтрНайти(ТелоФормыПароля, "data-pwreq=""пароль""") > 0,
		"подсказка привязана к полю нового пароля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоФормыПароля, "длина от 8 до 256 символов") > 0,
		"действующая политика напечатана словами").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/invite",
		ПоляПароля(Ссылка, "Invited1Passw0rd"), "")), "пароль принят").ЭтоИстина();

	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти(Логин, "Invited1Passw0rd")),
		"после установки человек входит логином и паролем").ЭтоИстина();

	Повтор = Клиент.GET("/invite?token=" + Ссылка);
	Ожидаем.Что(Повтор.КодСостояния, "использованная ссылка мертва").Равно(410);

КонецПроцедуры

// «Сбросить пароль» выпускает новую ссылку и гасит прежнюю: две живые ссылки на одну
// учётку означали бы, что отозванное приглашение продолжает открывать вход.
&Тест
Процедура СбросПароляГаситПрежнююСсылку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "invited2";

	Страница = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Первая = ИзвлечьЗначениеПриглашения(Тело(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(Клиент.ТокенCSRF(Страница), Логин, "", "user"), КукаАдмина)));
	Ожидаем.Что(ЗначениеЗаполнено(Первая), "первая ссылка выпущена").ЭтоИстина();

	// подтверждение сброса — окно по адресу строки; его форма шлёт confirmed=1
	Окно = Тело(Клиент.GETСКукой(АдресПользователей() + "?q=" + Логин + "&" + ПараметрОкна("сброс-" + Логин),
		КукаАдмина));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Окно));
	Поля.Вставить("confirmed", "1");
	Вторая = ИзвлечьЗначениеПриглашения(Тело(Клиент.POSTФормы(
		АдресПользователей() + "/" + Логин + "/reset", Поля, КукаАдмина)));

	Ожидаем.Что(ЗначениеЗаполнено(Вторая), "вторая ссылка выпущена").ЭтоИстина();
	Ожидаем.Что(Вторая = Первая, "и это другая ссылка").ЭтоЛожь();
	Ожидаем.Что(Клиент.GET("/invite?token=" + Первая).КодСостояния, "прежняя ссылка мертва").Равно(410);
	Ожидаем.Что(Клиент.GET("/invite?token=" + Вторая).КодСостояния, "новая работает").Равно(200);

КонецПроцедуры

// Заведение учётки — окно поверх списка вместе с выбором роли; у окна серверная дорога,
// а отбитая форма возвращается в него же.
&Тест
Процедура ФормаЗаведенияУчёткиЖивётВОкнеИВозвращаетсяВНегоЖе() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	// окно на странице всегда; кнопка «Добавить пользователя» без скрипта ведёт на адрес с открытым окном
	Закрытая = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Закрытая, ОкноЗаведенияУчётки()) > 0, "окно заведения на странице").ЭтоИстина();
	Ожидаем.Что(ОкноОткрыто(Закрытая, ОкноЗаведенияУчётки()), "по умолчанию окно закрыто").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Закрытая, "href=""" + АдресПользователей() + "?" + ПараметрОкна("новый") + """") > 0,
		"кнопка заведения ведёт на окно по адресу").ЭтоИстина();

	Открытая = Тело(Клиент.GETСКукой(АдресПользователей() + "?" + ПараметрОкна("новый"), КукаАдмина));
	Ожидаем.Что(ОкноОткрыто(Открытая, ОкноЗаведенияУчётки()),
		"адрес с ?окно=новый открывает окно заведения").ЭтоИстина();

	// выбор роли — часть формы заведения, а не отдельного экрана
	Окно = ОкноПоМетке(Открытая, ОкноЗаведенияУчётки());
	Ожидаем.Что(СтрНайти(Окно, "<select") > 0, "роль выбирается прямо в окне").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "Роль на хабе") > 0, "и подписана словами").ЭтоИстина();

	// логин занят: отказ домена метит логин и не съедает набранный email
	Отбитая = Тело(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(Клиент.ТокенCSRF(Открытая), "bob", "bob-dubl@ex.com", "user"), КукаАдмина));

	Ожидаем.Что(ОкноОткрыто(Отбитая, ОкноЗаведенияУчётки()),
		"отбитая форма вернулась ТЕМ ЖЕ окном — открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОкноПоМетке(Отбитая, ОкноЗаведенияУчётки()), "aria-invalid=""true""") > 0,
		"отбитое поле помечено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""bob-dubl@ex.com""") > 0,
		"набранное в соседнем поле не съедено").ЭтоИстина();

КонецПроцедуры

// Мусорная ссылка не открывает формы и не рассказывает о существовании учёток.
&Тест
Процедура НеизвестнаяСсылкаОтдаётОтказБезФормы() Экспорт

	Ответ = Клиент.GET("/invite?token=oshub_inv_999999_нетакого");

	Ожидаем.Что(Ответ.КодСостояния, "неизвестная ссылка").Равно(404);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "name=""пароль"""), "формы установки пароля нет").Равно(0);

КонецПроцедуры

// Заведение учётки — админская мутация: чужому 403, без CSRF 403, и в обоих случаях
// учётки не появляется.
&Тест
Процедура ЗаведениеУчёткиТребуетАдминаИCSRF() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина)));

	Ожидаем.Что(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(Токен, "byalice", "", "admin"), КукаАлисы).КодСостояния,
		"не-админ учёток не заводит").Равно(403);

	Ожидаем.Что(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки("подделка", "bycsrf", "", "user"), КукаАдмина).КодСостояния,
		"без верного CSRF — отказ").Равно(403);

	Список = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Список, "byalice"), "учётка чужого не появилась").Равно(0);
	Ожидаем.Что(СтрНайти(Список, "bycsrf"), "учётка мимо CSRF не появилась").Равно(0);

КонецПроцедуры

// Двери строки учётки стережёт гвард хаба: не-админ подтверждённой формой не блокирует и не удаляет.
&Тест
Процедура НеАдминНеБлокируетИНеУдаляетУчётку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы))));
	Поля.Вставить("активна", "0");
	Ожидаем.Что(Клиент.POSTФормы(АдресПользователей() + "/bob/toggle", Поля, КукаАлисы).КодСостояния,
		"блокировка чужой учётки не-админом").Равно(403);

	Поля.Вставить("confirmed", "1");
	Поля.Вставить("логин", "bob");
	Ожидаем.Что(Клиент.POSTФормы(АдресПользователей() + "/bob/delete", Поля, КукаАлисы).КодСостояния,
		"удаление чужой учётки не-админом").Равно(403);

	Строка_ = СтрокаТаблицыС(Тело(Клиент.GETСКукой(АдресПользователей() + "?q=bob", КукаАдмина)), ">bob<");
	Ожидаем.Что(СтрНайти(Строка_, "Заблокировать") > 0, "bob на месте и активен").ЭтоИстина();

КонецПроцедуры

// Строка приглашённого: плашка «нечем войти» и нет кнопки «Разблокировать» — домен такую
// активацию не примет; у активного пользователя наоборот.
&Тест
Процедура СтрокаПриглашённогоНеПредлагаетРазблокировку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "invited3";

	Страница = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(Клиент.ТокенCSRF(Страница), Логин, "", "user"), КукаАдмина)),
		"учётка приглашена").ЭтоИстина();

	// маркер ячейкой, а не логином: первым его встречает поле формы отбора над таблицей
	Строка_ = СтрокаТаблицыС(Тело(Клиент.GETСКукой(АдресПользователей() + "?q=" + Логин, КукаАдмина)),
		">" + Логин + "<");

	Ожидаем.Что(СтрНайти(Строка_, "нечем войти") > 0,
		"плашка называет причину закрытой учётки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "Разблокировать"),
		"кнопки разблокировки у неё нет").Равно(0);
	Ожидаем.Что(СтрНайти(Строка_, "Сбросить пароль") > 0,
		"а выпуск ссылки предлагается").ЭтоИстина();

	// контроль: у активного пользователя ровно обратное
	Контрольная = СтрокаТаблицыС(Тело(Клиент.GETСКукой(АдресПользователей() + "?q=bob", КукаАдмина)),
		">bob<");
	Ожидаем.Что(СтрНайти(Контрольная, "Заблокировать") > 0,
		"у активного кнопка блокировки на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Контрольная, "нечем войти"),
		"и плашки закрытой учётки у него нет").Равно(0);

КонецПроцедуры

// Форма раздела только заводит учётку: подделанное поле «операция» с номером учётки не попадает
// ни в блокировку, ни в другую ветку — отказ, и активность не тронута.
&Тест
Процедура НеизвестнаяОперацияРазделаОтказываетИНичегоНеМеняет() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Список = Тело(Клиент.GETСКукой(АдресПользователей() + "?q=bob", КукаАдмина));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Список));
	Поля.Вставить("операция", "чего-нибудь");
	Поля.Вставить("пользователь", "bob");

	Ответ = Клиент.POSTФормы(АдресПользователей(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "неизвестное действие — отказ").Равно(400);

	Строка_ = СтрокаТаблицыС(Тело(Клиент.GETСКукой(АдресПользователей() + "?q=bob", КукаАдмина)), ">bob<");
	Ожидаем.Что(СтрНайти(Строка_, "Заблокировать") > 0,
		"активность bob не тронута").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

// Карточка основного пула на главной несёт плашку «Основной», у проектного пула плашки нет;
// основной пул засева — public.
&Тест
Процедура КарточкаОсновногоПулаНаГлавнойНесётПлашкуОсновного() Экспорт

	Стр = Тело(Клиент.GET("/"));

	Ожидаем.Что(СтрНайти(Стр, "Пулы хаба") > 0, "предпосылка: обзор пулов на главной").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "href=""/pools/public""") > 0, "и карточка основного пула в нём").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, "Основной") > 0, "у основного пула плашка роли есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Проектный"), "а плашки проектного типа нет").Равно(0);

КонецПроцедуры

// Колонка типа раздела «Пулы» называет пул хаба словом: основной или пул; личные пространства
// стоят своей группой «Личные пространства — N», без прежних «Пользовательский» и «Проектный».
&Тест
Процедура КолонкаТипаПуловХабаСловами() Экспорт

	Стр = Тело(Клиент.GETСКукой(АдресПулов() + "?pq=bob", Клиент.Войти("root", "RootPassw0rd")));
	Группа = Сред(Стр, СтрНайти(Стр, "id=""lichnye-prostranstva"""));
	Ожидаем.Что(СтрНайти(Группа, ">bob<") > 0, "предпосылка: личное пространство в своей группе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Личные пространства — ") > 0, "группа названа со счётчиком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Пользовательский"), "прежней плашки нет").Равно(0);

	Все = Тело(Клиент.GETСКукой(АдресПулов() + "?q=public", Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(СтрНайти(Все, ">Основной<") > 0, "основной пул назван словом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Все, ">Публичный</span>") > 0, "видимость — плашкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Все, "Проектный"), "плашки проектного типа нет").Равно(0);

КонецПроцедуры


// «Показаны N из M» в обзоре пулов считается по срезу смотрящего: по приросту M аноним узнал
// бы о приватном пуле. Замер до/после, поэтому порядок тестов безразличен.
&Тест
Процедура ЧислоОбзораПуловНеРастётАнонимуОтПриватногоПула() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	ЗавестиПулыДоОговорки(Кука);

	АнонимДо = ЧислоПуловИзОговорки(Тело(Клиент.GET("/")), "аноним до");
	АдминДо = ЧислоПуловИзОговорки(Тело(Клиент.GETСКукой("/", Кука)), "админ до");

	Скрытый = УникальныеИмена.Имя("hidden");
	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, Скрытый, "private")),
		"приватный пул заведён").ЭтоИстина();

	Ожидаем.Что(ЧислоПуловИзОговорки(Тело(Клиент.GET("/")), "аноним после"),
		"приватный пул не поднял число пулов анониму").Равно(АнонимДо);
	Ожидаем.Что(ЧислоПуловИзОговорки(Тело(Клиент.GETСКукой("/", Кука)), "админ после"),
		"а тому, кто его видит, поднял ровно на один").Равно(АдминДо + 1);

КонецПроцедуры

&Тест
Процедура PATМенеджерВыпускИОтзыв() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("чтение", "1");
	Поля.Вставить("запись", "1");
	Поля.Вставить("срок_дней", "30");
	ОтветВыпуск = Клиент.POSTФормы("/me/settings/tokens", Поля, Кука);
	Ожидаем.Что(ОтветВыпуск.КодСостояния).Равно(200);
	ТелоВыпуска = Тело(ОтветВыпуск);
	Секрет = ИзвлечьСекрет(ТелоВыпуска);
	Ожидаем.Что(СтрНачинаетсяС(Секрет, "oshub_"), "секрет показан один раз").ЭтоИстина();

	// список НЕ раскрывает секрет
	ТелоСписка = Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));
	Ожидаем.Что(СтрНайти(ТелоСписка, Секрет), "секрет не в списке").Равно(0);

	// отзыв токена
	ИдТокена = ИзвлечьИдТокена(ТелоСписка);
	Ожидаем.Что(ЗначениеЗаполнено(ИдТокена), "id токена найден").ЭтоИстина();
	ТокенСписка = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));
	ПоляОтзыва = Новый Соответствие();
	ПоляОтзыва.Вставить("_csrf", ТокенСписка);
	ПоляОтзыва.Вставить("confirmed", "1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/me/settings/tokens/" + ИдТокена + "/revoke", ПоляОтзыва, Кука)),
		"отзыв принят").ЭтоИстина();

КонецПроцедуры

// Форма кабинета глазами пользователя: бессрочных ключей она не выпускает вовсе,
// а отказ называет причину и не превращается ни в 500, ни в молчаливую подмену срока.
&Тест
Процедура ФормаКабинетаНеВыпускаетБессрочныйКлюч() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = СтраницаВыпуска(Кука);
	Токен = Клиент.ТокенCSRF(Страница);

	Ожидаем.Что(СтрНайти(Страница, "0 — бессрочно"), "формулировки «0 — бессрочно» больше нет")
		.Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Бессрочных токенов хаб не выпускает") > 0,
		"подсказка поля объясняет запрет").ЭтоИстина();

	ОтказНоль = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "0"), Кука);
	ОтказСверхПотолка = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "100000"), Кука);
	ОтказМусор = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "неделя"), Кука);
	ОтказПустого = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, ""), Кука);
	Успех = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "7"), Кука);

	Ожидаем.Что(ОтказНоль.КодСостояния, "ноль — отказ формы, а не 500").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(ОтказНоль), "бессрочных токенов хаб не выпускает") > 0,
		"причина отказа названа (" + Тело(ОтказНоль) + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтказНоль), "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(ОтказСверхПотолка.КодСостояния).Равно(400);
	Ожидаем.Что(СтрНайти(Тело(ОтказСверхПотолка), "от 1 до 365 дней") > 0,
		"потолок назван числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтказСверхПотолка), "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(СтрНайти(Тело(ОтказМусор), "Токен выпущен"), "мусор в сроке ключа не даёт").Равно(0);

	// поле помечено обязательным в разметке — сервер требует его так же строго,
	// а не подставляет дефолт молча
	Ожидаем.Что(ОтказПустого.КодСостояния, "пустой срок — отказ формы").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(ОтказПустого), "бессрочных токенов хаб не выпускает") > 0,
		"пустое поле отвергается той же причиной, что и ноль").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтказПустого), "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(СтрНайти(Тело(Успех), "Токен выпущен") > 0, "срок 7 дней принят").ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(ИзвлечьСекрет(Тело(Успех)), "oshub_"), "секрет показан").ЭтоИстина();

КонецПроцедуры

// Легаси-бессрочный ключ живёт до отзыва и помечен в таблице; кладёт его сидер
// ЗасеятьКабинет.os — продуктом такой не завести.
&Тест
Процедура ЛегасиВечныйКлючПускаетИПомеченВТаблице() Экспорт

	Кука = Клиент.Войти("legacy", "LegacyPassw0rd");
	Страница = Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));

	Ожидаем.Что(СтрНайти(Страница, "легаси-вечный") > 0, "легаси-ключ виден в кабинете").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "бессрочно — выпущен до запрета, отзовите") > 0,
		"пустой срок назван своим именем, а не прочерком").ЭтоИстина();

	Ид = ИзвлечьИдТокена(Сред(Страница, СтрНайти(Страница, "легаси-вечный")));
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "идентификатор легаси-ключа найден на странице").ЭтоИстина();

	// 403 «ключ не выпускает ключи» приходит только ОПОЗНАННОМУ ключу: анониму здесь 401
	ПоЛегаси = Клиент.GETСТокеном("/api/v1/tokens", "oshub_" + Ид + "_" + СекретЛегасиКлюча());
	ПоПодделке = Клиент.GETСТокеном("/api/v1/tokens", "oshub_" + Ид + "_wrongsecret");

	Ожидаем.Что(ПоЛегаси.КодСостояния,
		"старый вечный ключ по-прежнему пускают в API").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(ПоЛегаси), "token_cannot_manage_tokens") > 0,
		"отказ ключу как ключу, а не как анониму (" + Тело(ПоЛегаси) + ")").ЭтоИстина();
	Ожидаем.Что(ПоПодделке.КодСостояния, "подделанный секрет того же ключа — 401").Равно(401);

КонецПроцедуры

// Сессия учётки без пароля открыта сидером ЗасеятьКабинет.os: войти паролем ей нечем.
Функция СессияУчёткиБезПароля()
	Возврат "decafbaddecafbaddecafbaddecafbaddecafbaddecafbaddecafbaddecafbad";
КонецФункции

Функция ПоляВхода(Знач Логин, Знач Пароль)

	Поля = Новый Соответствие();
	Поля.Вставить("логин", Логин);
	Поля.Вставить("пароль", Пароль);
	Возврат Поля;

КонецФункции

// Секрет легаси-ключа задан сидером ЗасеятьКабинет.os — без него значение не собрать.
Функция СекретЛегасиКлюча()
	Возврат "legacyeternalsecret00000000000000000000000000000000";
КонецФункции

Функция ПоляВыпускаКлюча(Знач Токен, Знач Срок)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("имя", "срок " + Срок);
	Поля.Вставить("чтение", "1");
	Поля.Вставить("срок_дней", Срок);
	Возврат Поля;
КонецФункции

// Рамки токена задаются в окне выпуска: ключ на отмеченные в дереве пулы работает в них,
// а в третьем — нет.
&Тест
Процедура ФормаКабинетаВыпускаетТокенСНаборомПулов() Экспорт

	Кука = ВойтиRoot();
	Первый = ЗавестиПриватныйПул(Кука);
	Второй = ЗавестиПриватныйПул(Кука);
	Третий = ЗавестиПриватныйПул(Кука);

	ТокенCSRF = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));

	ПервыйНайден = Найденные(Тело(Клиент.POSTФормы(АдресПоискаПулов(),
		ПоляПоискаПулов(ТокенCSRF, "ключ-набора", Первый.Имя, Новый Массив()), Кука)));
	ТретийНайден = Найденные(Тело(Клиент.POSTФормы(АдресПоискаПулов(),
		ПоляПоискаПулов(ТокенCSRF, "ключ-набора", Третий.Имя, Новый Массив()), Кука)));
	Ожидаем.Что(СтрНайти(ПервыйНайден, ФлажокПула(Первый)) > 0,
		"пул предложен галкой в ответе поиска").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТретийНайден, ФлажокПула(Третий)) > 0,
		"и третий тоже — отбирает человек, а не сервер").ЭтоИстина();

	Пары = ПоляЗаявкиТокена(ТокенCSRF, "ключ-набора", Идентификаторы(Первый, Второй));

	Выпуск = Клиент.POSTФормы("/me/settings/tokens", Пары, Кука);
	Ожидаем.Что(Выпуск.КодСостояния).Равно(200);
	Ключ = ИзвлечьСекрет(Тело(Выпуск));
	Ожидаем.Что(СтрНачинаетсяС(Ключ, "oshub_"), "ключ выпущен и показан один раз").ЭтоИстина();

	// перечисление пулов — та поверхность, где рамки ключа реально судят выдачу
	ПоКлючу = Тело(Клиент.GETСТокеном("/api/v1/pools?pageSize=200", Ключ));
	Ожидаем.Что(СтрНайти(ПоКлючу, Первый.Имя) > 0, "первый отмеченный пул ключу виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоКлючу, Второй.Имя) > 0,
		"второй отмеченный пул тоже — рамка это НАБОР, а не один пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоКлючу, Третий.Имя), "неотмеченный пул ключу закрыт").Равно(0);

	// КОНТРОЛЬ: сессией тот же человек видит третий пул — дело в рамках ключа, а не в правах
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/api/v1/pools?pageSize=200", Кука)), Третий.Имя) > 0,
		"КОНТРОЛЬ: сессией третий пул виден").ЭтоИстина();

	// операции уровня хаба привязанному ключу недоступны тем более
	Хабовое = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", ИмяНовогоПула()), Ключ);
	Ожидаем.Что(Хабовое.КодСостояния, "ключ с рамками не заводит пулы на хабе").Равно(403);

	// список кабинета называет рамки словами, а не идентификаторами
	Строка_ = СтрокаТокенаПоИмени(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)), "ключ-набора");
	Ожидаем.Что(СтрНайти(Строка_, Первый.Имя) > 0, "в списке названо имя первого пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, Второй.Имя) > 0, "и второго").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, Третий.Имя), "чужой пул в запись не попал").Равно(0);
	Ожидаем.Что(СтрНайти(Строка_, "чтение, запись") > 0, "права названы словами окна").ЭтоИстина();

КонецПроцедуры

// Свежее окно выпуска стоит на «весь хаб» и не отмечает ни одного пула: иначе ключ, обещанный
// «на весь хаб», молча оказался бы привязан к пулам.
&Тест
Процедура СвежееОкноВыпускаСтоитНаВсёмХабеИНичегоНеОтмечает() Экспорт

	Кука = ВойтиRoot();
	Пул = ЗавестиПриватныйПул(Кука);

	Окно = ОкноВыпуска(СтраницаВыпуска(Кука));

	// пулов на живом хабе много: на окне первые двадцать, новый пул находит поиск
	Ожидаем.Что(СтрЧислоВхождений(Окно, "data-checktree-box") <= 20, "на окне не больше двадцати пулов").ЭтоИстина();
	Найдено = Найденные(Тело(Клиент.POSTФормы(АдресПоискаПулов(),
		ПоляПоискаПулов(Клиент.ТокенCSRF(Окно), "свежий", Пул.Имя, Новый Массив()), Кука)));
	Ожидаем.Что(СтрНайти(Найдено, ФлажокПула(Пул)) > 0, "пул предложен галкой в ответе поиска").ЭтоИстина();
	Ожидаем.Что(ОтмеченныхПулов(Окно), "ни один пул не приехал отмеченным").Равно(0);
	Ожидаем.Что(ОтмеченныхПулов(Найдено), "и найденный тоже").Равно(0);
	Ожидаем.Что(Отмечен(Окно, "name=""где"" value=""хаб"""), "выбран «весь хаб»").ЭтоИстина();
	Закрытое = ОкноВыпуска(СтраницаРаздела(Кука));
	Ожидаем.Что(СтрНайти(Лев(Закрытое, СтрНайти(Закрытое, ">")), " open"),
		"без ?окно= окно выпуска на странице закрыто").Равно(0);

КонецПроцедуры

// Путь целиком: поиск пулов через сервер, отметка и выпуск ключа ровно на отмеченный пул.
&Тест
Процедура ПодборПуловСужаетсяПоискомИДаётКлючРовноНаОтмеченный() Экспорт

	Кука = ВойтиRoot();
	Искомый = ЗавестиПриватныйПул(Кука);
	Соседний = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));

	Ответ = Тело(Клиент.POSTФормы(АдресПоискаПулов(),
		ПоляПоискаПулов(ТокенCSRF, "ключ-подбора", Искомый.Имя, Новый Массив()), Кука));
	Найдено = Найденные(Ответ);
	Ожидаем.Что(СтрНайти(Найдено, ФлажокПула(Искомый)) > 0,
		"поиск по подстроке нашёл искомый пул (" + Найдено + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Найдено, ФлажокПула(Соседний)), "и не предложил остальное").Равно(0);
	Ожидаем.Что(ОтмеченныхПулов(Найдено), "найденное не отмечено само").Равно(0);
	Ожидаем.Что(СтрНайти(ОкноВыпуска(Ответ), "value=""ключ-подбора""") > 0,
		"набранное имя доехало до ответа поиска").ЭтоИстина();

	Ключ = ИзвлечьСекрет(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-подбора", Идентификаторы(Искомый)), Кука)));
	ПоКлючу = Тело(Клиент.GETСТокеном("/api/v1/pools?pageSize=200", Ключ));
	Ожидаем.Что(СтрНайти(ПоКлючу, Искомый.Имя) > 0, "ключ работает в отмеченном пуле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоКлючу, Соседний.Имя), "и не работает в неотмеченном").Равно(0);

КонецПроцедуры

// Поиск — серверный, и он обязан ПОМНИТЬ отмеченное: иначе набор пулов нельзя собрать из двух
// поисков, а человек теряет отметку, не понимая, куда она делась.
&Тест
Процедура ПоискПуловНеТеряетУжеОтмеченное() Экспорт

	Кука = ВойтиRoot();
	Отмеченный = ЗавестиПриватныйПул(Кука);
	Искомый = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));

	Окно = ОкноВыпуска(Тело(Клиент.POSTФормы(АдресПоискаПулов(),
		ПоляПоискаПулов(ТокенCSRF, "ключ-двух-поисков", Искомый.Имя, Идентификаторы(Отмеченный)), Кука)));

	Ожидаем.Что(СтрНайти(Найденные(Окно), ФлажокПула(Искомый)) > 0, "поиск нашёл второй пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Найденные(Окно), ФлажокПула(Отмеченный)),
		"первый пул выдачей поиска не является").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, СкрытыйПул(Отмеченный)) > 0,
		"но отметка на нём пережила поиск скрытым полем (" + Окно + ")").ЭтоИстина();

	// набор из двух пулов, собранный за два поиска, доезжает до выпуска целиком
	Ключ = ИзвлечьСекрет(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-двух-поисков", Идентификаторы(Отмеченный, Искомый)), Кука)));
	Ожидаем.Что(СтрНачинаетсяС(Ключ, "oshub_"), "ключ выпущен").ЭтоИстина();
	Строка_ = СтрокаТокенаПоИмени(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)), "ключ-двух-поисков");
	Ожидаем.Что(СтрНайти(Строка_, Отмеченный.Имя) > 0, "первый пул в наборе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, Искомый.Имя) > 0, "и второй тоже").ЭтоИстина();

КонецПроцедуры

// «Включить найденные» без скрипта отмечает найденное и не выпускает ключ раньше времени.
&Тест
Процедура НайденныеВключаютсяБезСкрипта() Экспорт

	Кука = ВойтиRoot();
	Искомый = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));

	Пары = ПоляПоискаПулов(ТокенCSRF, "ключ-найденных", Искомый.Имя, Новый Массив());
	Пары.Добавить(Пара("найденные", "вкл"));
	Ответ = Клиент.POSTФормы("/me/settings/tokens", Пары, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "шаг подбора, а не выпуск").Равно(200);
	Ожидаем.Что(Отмечен(ОкноВыпуска(Тело(Ответ)), ФлажокПула(Искомый)), "найденный пул отмечен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Токен выпущен"), "ключ не выпущен").Равно(0);

КонецПроцедуры

// Ключ на весь хаб — без единого отмеченного пула: рамок нет, и список обязан сказать это
// словами, а не пустой плашкой.
&Тест
Процедура ТокенБезОтмеченныхПуловДействуетНаВесьХабИТакИНазван() Экспорт

	Кука = Клиент.Войти("bob", "BobPassw0rd");
	ТокенCSRF = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", "ключ-всего-хаба"));
	Пары.Добавить(Пара("чтение", "1"));
	Пары.Добавить(Пара("где", "хаб"));
	Пары.Добавить(Пара("срок_дней", "30"));

	Выпуск = Клиент.POSTФормы("/me/settings/tokens", Пары, Кука);
	Ожидаем.Что(Выпуск.КодСостояния).Равно(200);
	Ключ = ИзвлечьСекрет(Тело(Выпуск));

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public", Ключ).КодСостояния,
		"ключ без рамок читает пул хаба").Равно(200);

	Строка_ = СтрокаТокенаПоИмени(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)), "ключ-всего-хаба");
	Ожидаем.Что(СтрНайти(Строка_, "весь хаб") > 0,
		"отсутствие рамок названо словами (" + Строка_ + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "чтение") > 0, "право названо словом окна").ЭтоИстина();

КонецПроцедуры

// Токен без единого права не выпускается: отказ называет причину и возвращает окно в том
// виде, в каком его отправили.
&Тест
Процедура ФормаКабинетаОтвергаетВыпускБезОбластей() Экспорт

	Кука = ВойтиRoot();
	Пул = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = Клиент.ТокенCSRF(СтраницаВыпуска(Кука));

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", "ключ-без-областей"));
	Пары.Добавить(Пара("где", "пулы"));
	Пары.Добавить(Пара("пулы", Пул.Ид));
	Пары.Добавить(Пара("срок_дней", "17"));

	Отказ = Клиент.POSTФормы("/me/settings/tokens", Пары, Кука);
	Окно = ОкноВыпуска(Тело(Отказ));

	Ожидаем.Что(Отказ.КодСостояния, "отказ формы, а не 500").Равно(400);
	Ожидаем.Что(СтрНайти(Окно, "Отметьте хотя бы одно право") > 0,
		"причина названа (" + Окно + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Отказ), "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(СтрНайти(Окно, "value=""ключ-без-областей""") > 0, "имя не потеряно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "value=""17""") > 0, "срок не потерян").ЭтоИстина();
	// пул на окне — отмеченной галкой, за пределом показа — скрытым полем и словами
	Ожидаем.Что(Отмечен(Окно, ФлажокПула(Пул))
		ИЛИ (СтрНайти(Окно, СкрытыйПул(Пул)) > 0 И СтрНайти(Окно, "Уже отмечены: ") > 0),
		"отмеченный пул остался отмеченным").ЭтоИстина();

	// ключа с этим именем в списке нет — отказ был отказом, а не «показали ошибку и выпустили»
	Ожидаем.Что(СтрНайти(СтраницаРаздела(Кука), ">ключ-без-областей<"), "ключ в списке не появился").Равно(0);

КонецПроцедуры

// Пул, которого смотрящий не видит, отвечает ему как несуществующий — даже когда его
// идентификатор угадан. Иначе перебор чисел в форме рассказывал бы о чужих пулах.
&Тест
Процедура ФормаКабинетаНеПринимаетНевидимыйПулВНабор() Экспорт

	ЧужойПул = ЗавестиПриватныйПул(ВойтиRoot());

	КукаЖертвы = Клиент.Войти("bob", "BobPassw0rd");
	Страница = СтраницаВыпуска(КукаЖертвы);
	ТокенCSRF = Клиент.ТокенCSRF(Страница);
	Ожидаем.Что(СтрНайти(Страница, ФлажокПула(ЧужойПул)),
		"чужой приватный пул в дереве не предлагается").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, ЧужойПул.Имя), "как и его имени").Равно(0);

	Подделка = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПодделкиПула(ТокенCSRF, ЧужойПул.Ид), КукаЖертвы));
	Небывалый = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПодделкиПула(ТокенCSRF, "99999999"), КукаЖертвы));
	// поиск — та же дверь: найти чужой пул по имени нельзя
	ПоискЧужого = Тело(Клиент.POSTФормы(АдресПоискаПулов(),
		ПоляПоискаПулов(ТокенCSRF, "ключ-подбора", ЧужойПул.Имя, Новый Массив()), КукаЖертвы));

	Ожидаем.Что(СтрНайти(Подделка, "не найден") > 0,
		"невидимый пул отвергнут как несуществующий").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Подделка, ЧужойПул.Имя),
		"и имени чужого пула на экране нет").Равно(0);
	Ожидаем.Что(СтрНайти(Небывалый, "не найден") > 0,
		"несуществующий пул отвергнут так же").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Подделка, "Токен выпущен"), "ключ не выпущен").Равно(0);
	Ожидаем.Что(СтрНайти(Найденные(ПоискЧужого), ФлажокПула(ЧужойПул)),
		"поиск чужой пул не находит").Равно(0);

КонецПроцедуры

Функция ПоляПодделкиПула(Знач ТокенCSRF, Знач ИдПула)

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", "ключ-подделки"));
	Пары.Добавить(Пара("чтение", "1"));
	Пары.Добавить(Пара("где", "пулы"));
	Пары.Добавить(Пара("пулы", ИдПула));
	Пары.Добавить(Пара("срок_дней", "30"));
	Возврат Пары;

КонецФункции

#Область ОкноВыпускаТокена

// Страница раздела с окном выпуска, открытым по адресу: в нём форма и токен сессии.
Функция СтраницаВыпуска(Знач Кука)
	Возврат Тело(Клиент.GETСКукой("/me/settings/tokens?" + Закодировано("окно") + "=" + Закодировано("новый"),
		Кука));
КонецФункции

Функция СтраницаРаздела(Знач Кука)
	Возврат Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));
КонецФункции

// Поиск пулов окна выпуска: без скрипта «Найти» отправляет форму выпуска на этот адрес.
Функция АдресПоискаПулов()
	Возврат "/me/settings/tokens/pools";
КонецФункции

Функция Закодировано(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Поля окна выпуска, как их отправит браузер: пустой набор — весь хаб.
Функция ПоляЗаявкиТокена(Знач ТокенCSRF, Знач Имя, Знач Пулы)

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", Имя));
	Пары.Добавить(Пара("чтение", "1"));
	Пары.Добавить(Пара("запись", "1"));
	Пары.Добавить(Пара("где", ?(Пулы.Количество() > 0, "пулы", "хаб")));
	Для Каждого Идентификатор Из Пулы Цикл
		Пары.Добавить(Пара("пулы", Идентификатор));
	КонецЦикла;
	Пары.Добавить(Пара("срок_дней", "30"));
	Возврат Пары;

КонецФункции

// Поля окна по кнопке «Найти»: строка поиска рядом с набранным.
Функция ПоляПоискаПулов(Знач ТокенCSRF, Знач Имя, Знач Подстрока, Знач Пулы)

	Пары = ПоляЗаявкиТокена(ТокенCSRF, Имя, Пулы);
	Пары.Добавить(Пара("найти", Подстрока));
	Возврат Пары;

КонецФункции

Функция Идентификаторы(Знач Первый, Знач Второй = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первый.Ид);
	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй.Ид);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция СкрытыйПул(Знач Пул)
	Возврат СтрШаблон("type=""hidden"" name=""пулы"" value=""%1""", Пул.Ид);
КонецФункции

// Окно выпуска на странице: от его <dialog> до закрывающего.
Функция ОкноВыпуска(Знач Страница)

	Начало = СтрНайти(Страница, "<dialog class=""modal"" id=""token-novyi""");
	Если Начало = 0 Тогда
		ВызватьИсключение "На странице токенов нет окна выпуска";
	КонецЕсли;

	Хвост = Сред(Страница, Начало);
	Конец = СтрНайти(Хвост, "</dialog>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

// Ответ поиска в окне: совпадения, которые кит кладёт на место дерева.
Функция Найденные(Знач Разметка)

	Начало = СтрНайти(Разметка, "data-checktree-found");
	Если Начало = 0 Тогда
		ВызватьИсключение "В ответе нет совпадений поиска пулов";
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, "</ul>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

// Сколько галок пулов отмечено — по значению разметки, а не по слову «checked».
Функция ОтмеченныхПулов(Знач Разметка)

	Найдено = 0;
	Позиция = СтрНайти(Разметка, "name=""пулы""");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Разметка, Позиция);
		Поле = Лев(Хвост, СтрНайти(Хвост, ">"));
		Если СтрНайти(Поле, " checked") > 0 Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
		Смещение = СтрНайти(Сред(Хвост, 2), "name=""пулы""");
		Позиция = ?(Смещение = 0, 0, Позиция + Смещение);
	КонецЦикла;
	Возврат Найдено;

КонецФункции

// Отмечен ли ввод с этим признаком: его открывающий тег несёт checked.
Функция Отмечен(Знач Разметка, Знач Признак)

	Позиция = СтрНайти(Разметка, Признак);
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Хвост = Сред(Разметка, Позиция);
	Возврат СтрНайти(Лев(Хвост, СтрНайти(Хвост, ">")), " checked") > 0;

КонецФункции

#КонецОбласти

// Приватный пул под рамки токена: заводится админом хаба, как это делает живой человек.
Функция ЗавестиПриватныйПул(Знач Кука)

	Имя = ИмяНовогоПула();

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Заголовки.Вставить("X-CSRF-Token", Клиент.ТокенCSRF(СтраницаВыпуска(Кука)));
	Запрос = Новый HTTPЗапрос("/api/v1/pools", Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		СтрШаблон("{""имя"":""%1"",""видимость"":""private""}", Имя), КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Пул под рамки токена не заведён (%1): %2",
			Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Разобрано = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Новый Структура("Имя, Ид", Имя,
		Формат(Разобрано.Получить("pool").Получить("id"), "ЧГ=0; ЧН=0"));

КонецФункции

// Имя пула уникально целиком: «scope-pool-1» лежит внутри «scope-pool-10».
Функция ИмяНовогоПула()
	Возврат УникальныеИмена.Имя("scope-pool");
КонецФункции

// Разметка галки пула: имя группы и значение — идентификатор, как их отправит браузер.
Функция ФлажокПула(Знач Пул)
	Возврат СтрШаблон("name=""пулы"" value=""%1""", Пул.Ид);
КонецФункции

// Запись реестра токенов, в которой встречается имя ключа.
Функция СтрокаТокенаПоИмени(Знач Страница, Знач ИмяКлюча)

	Позиция = СтрНайти(Страница, ">" + ИмяКлюча + "<");
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон("Ключа «%1» нет в реестре токенов кабинета", ИмяКлюча);
	КонецЕсли;

	Хвост = Сред(Страница, Позиция);
	Конец = СтрНайти(Хвост, "</li>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Функция Пара(Знач Имя, Знач Значение)
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

&Тест
Процедура ОтзывЧужогоИНесуществующегоТокенаНеразличим404() Экспорт

	// Алиса выпускает токен и узнаёт его id.
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	ТокенАлисы = Клиент.ТокенCSRF(СтраницаВыпуска(КукаАлисы));
	ПоляВыпуск = Новый Соответствие();
	ПоляВыпуск.Вставить("_csrf", ТокенАлисы);
	ПоляВыпуск.Вставить("чтение", "1");
	ПоляВыпуск.Вставить("запись", "1");
	ПоляВыпуск.Вставить("срок_дней", "30");
	Клиент.POSTФормы("/me/settings/tokens", ПоляВыпуск, КукаАлисы);
	ИдЧужого = ИзвлечьИдТокена(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы)));
	Ожидаем.Что(ЗначениеЗаполнено(ИдЧужого), "id токена алисы найден").ЭтоИстина();

	// Боб пытается отозвать ЧУЖОЙ токен (принадлежит алисе) со своим валидным CSRF.
	КукаБоба = Клиент.Войти("bob", "BobPassw0rd");
	ТокенБоба = Клиент.ТокенCSRF(СтраницаВыпуска(КукаБоба));
	ПоляОтзыва = Новый Соответствие();
	ПоляОтзыва.Вставить("_csrf", ТокенБоба);
	ПоляОтзыва.Вставить("confirmed", "1");

	ОтветЧужой = Клиент.POSTФормы("/me/settings/tokens/" + ИдЧужого + "/revoke", ПоляОтзыва, КукаБоба);
	Ожидаем.Что(ОтветЧужой.КодСостояния).Равно(404);

	// Несуществующий токен — тем же CSRF; ответ обязан совпадать (не раскрываем существование).
	ОтветНесущ = Клиент.POSTФормы("/me/settings/tokens/999999/revoke", ПоляОтзыва, КукаБоба);
	Ожидаем.Что(ОтветНесущ.КодСостояния).Равно(404);
	Ожидаем.Что(ОтветЧужой.КодСостояния).Равно(ОтветНесущ.КодСостояния);

	// Чужой токен НЕ отозван — по-прежнему виден в кабинете алисы.
	ИдПосле = ИзвлечьИдТокена(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы)));
	Ожидаем.Что(ИдПосле).Равно(ИдЧужого);

КонецПроцедуры

&Тест
Процедура ФорсированнаяСменаПароля() Экспорт

	Кука = Клиент.Войти("mustchange", "OldPassw0rd");

	// любой маршрут кабинета редиректит на смену пароля
	ОтветКаб = Клиент.GETСКукой("/me", Кука);
	Если Редирект(ОтветКаб) Тогда
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(ОтветКаб, "Location"), "/me/settings/security") > 0, "форс-редирект на смену").ЭтоИстина();
	Иначе
		Ожидаем.Что(СтрНайти(Тело(ОтветКаб), "Текущий пароль") > 0, "показана форма смены").ЭтоИстина();
	КонецЕсли;

	// сама страница смены доступна
	СтрСмены = Тело(Клиент.GETСКукой("/me/settings/security", Кука));
	Ожидаем.Что(СтрНайти(СтрСмены, "Текущий пароль") > 0, "форма смены пароля").ЭтоИстина();
	Токен = Клиент.ТокенCSRF(СтрСмены);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("старый", "OldPassw0rd");
	Поля.Вставить("новый", "NewPassw0rd1");
	Поля.Вставить("повтор", "NewPassw0rd1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/me/settings/security", Поля, Кука)), "смена принята").ЭтоИстина();

	// после смены кабинет доступен без форс-редиректа: у учётки нет пакетов, поэтому сводка
	// показывает первые шаги
	ОтветПосле = Клиент.GETСКукой("/me", Кука);
	Ожидаем.Что(ОтветПосле.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтветПосле), "Выпустить токен публикации") > 0,
		"кабинет доступен и собран").ЭтоИстина();

КонецПроцедуры

// Учётка без пароля (вход через провайдера, сессию открывает сидер) заводит первый пароль:
// форма не спрашивает текущий и открывает вход по заведённому.
&Тест
Процедура УчёткаБезПароляЗаводитПервыйПарольБезПоляТекущего() Экспорт

	Кука = СессияУчёткиБезПароля();
	Страница = Тело(Клиент.GETСКукой("/me/settings/security", Кука));

	Ожидаем.Что(СтрНайти(Страница, "name=""старый"""),
		"подтверждать нечего — поля текущего пароля на форме нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "name=""новый""") > 0, "а поле нового пароля есть").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Поля.Вставить("новый", "GuestPassw0rd");
	Поля.Вставить("повтор", "GuestPassw0rd");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/me/settings/security", Поля, Кука)),
		"первый пароль принят").ЭтоИстина();

	// доказательство не в том, что страница не отругалась: учётка входит заведённым паролем
	Вход = Клиент.POSTФормыБезПереходов("/login", ПоляВхода("guest", "GuestPassw0rd"), "");
	Ожидаем.Что(ЗначениеЗаполнено(Клиент.КукаОтвета(Вход, "oshub_session")),
		"POST /login выдал сессию, код ответа " + Вход.КодСостояния).ЭтоИстина();

КонецПроцедуры

// Смена пароля показывает требования живьём, как регистрация: список привязан к полю и несёт
// коды для браузера; без скрипта — те же требования словами и отказ с причиной.
&Тест
Процедура СменаПароляПоказываетТребованияЖивьём() Экспорт

	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Страница = Тело(Клиент.GETСКукой("/me/settings/security", Кука));

	Ожидаем.Что(СтрНайти(Страница, "data-pwreq=""новый""") > 0,
		"подсказка привязана к полю нового пароля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "data-pwrule=""length""") > 0,
		"требование длины несёт код живой проверки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "data-pwmin=""8""") > 0, "минимум длины числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "data-pwmax=""256""") > 0, "максимум длины числом").ЭтоИстина();

	// без JavaScript та же страница называет требования словами
	Ожидаем.Что(СтрНайти(БезТеговScript(Страница), "длина от 8 до 256 символов") > 0,
		"действующая политика напечатана словами").ЭтоИстина();
	// и ровно один раз: второго перечня требований на странице нет
	Ожидаем.Что(СтрЧислоВхождений(Страница, "длина от 8 до 256 символов"),
		"перечень требований на странице один").Равно(1);

	// без скрипта форма работает, а негодный пароль сервер отвергает с причиной
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Поля.Вставить("старый", "BobPassw0rd");
	Поля.Вставить("новый", "abc");
	Поля.Вставить("повтор", "abc");
	Отказ = Клиент.POSTФормы("/me/settings/security", Поля, Кука);
	Ожидаем.Что(Отказ.КодСостояния, "негодный пароль отвергнут").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Отказ), "длина от 8 до 256 символов") > 0,
		"и причина названа теми же словами").ЭтоИстина();

	// пароль не сменился: прежний по-прежнему пускает
	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти("bob", "BobPassw0rd")),
		"отвергнутая смена пароль не тронула").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОнбордингРедиректНаSetup() Экспорт

	// отдельный хаб на пустой БД: онбординг не завершён — кабинет уводит на /setup
	ХабДва = НовыйХаб();
	ХабДва.ФайловаяБаза("openhub-office-empty");
	ХабДва.Среда("OSHUB_ADMIN_LOGIN", "");
	ХабДва.Среда("OSHUB_ADMIN_PASSWORD", "");

	Попытка
		ХабДва.Запустить();
		Ответ = Новый КлиентХаба(ХабДва, 20).GET("/me");
		Если Редирект(Ответ) Тогда
			Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "/setup") > 0, "редирект на /setup").ЭтоИстина();
		Иначе
			Ожидаем.Что(СтрНайти(Тело(Ответ), "onboarding_needed") > 0, "достигнут мастер /setup").ЭтоИстина();
		КонецЕсли;
	Исключение
		ХабДва.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	ХабДва.Остановить();

КонецПроцедуры

// --- управление доступом в кабинете (self-service пул, гранты, эскалация, CSRF) ---

&Тест
Процедура SelfServiceСозданиеПулаАдмином() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Стр = Тело(Клиент.GETСКукой(АдресПулов(), Кука));
	Ожидаем.Что(СтрНайти(Стр, "Добавить пул") > 0, "админ видит кнопку «Добавить пул»").ЭтоИстина();

	// окно нового пула на странице всегда, закрытым; без скрипта кнопка ведёт на его адрес
	Ожидаем.Что(СтрНайти(Стр, ОкноЗаведенияПула()) > 0, "окно заведения на странице").ЭтоИстина();
	Ожидаем.Что(ОкноОткрыто(Стр, ОкноЗаведенияПула()), "по умолчанию окно закрыто").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Стр, "href=""" + АдресОкнаНовогоПула() + """") > 0,
		"кнопка — ссылка на окно по адресу").ЭтоИстина();

	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, "granttest", "private")), "пул создан").ЭтоИстина();

	// пул появился в списке
	Обзор = Тело(Клиент.GETСКукой(АдресПулов() + "?q=granttest", Кука));
	Ожидаем.Что(СтрНайти(Обзор, ">granttest<") > 0, "новый пул в списке пулов хаба").ЭтоИстина();

КонецПроцедуры


// Окно нового пула открывается адресом, а отбитая форма возвращается в то же окно
// с набранным вводом.
&Тест
Процедура ФормаЗаведенияПулаОткрываетсяАдресомИВозвращаетсяВНегоЖе() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Закрытая = Тело(Клиент.GETСКукой(АдресПулов(), Кука));

	Открытая = Тело(Клиент.GETСКукой(АдресОкнаНовогоПула(), Кука));
	Ожидаем.Что(ОкноОткрыто(Открытая, ОкноЗаведенияПула()), "адрес ?окно=новый открывает окно заведения")
		.ЭтоИстина();

	Поля = ПоляНовогоПула(Клиент.ТокенCSRF(Закрытая), "quotatest", "private");
	Поля.Вставить("квота_мб", "5oo"); // мусор: пул с таким пределом не заводится

	Отбитая = Тело(Клиент.POSTФормы(АдресПулов(), Поля, Кука));

	Ожидаем.Что(ОкноОткрыто(Отбитая, ОкноЗаведенияПула()),
		"отбитая форма вернулась ТЕМ ЖЕ окном — открытым").ЭтоИстина();
	Окно = ОкноПоМетке(Отбитая, ОкноЗаведенияПула());
	Ожидаем.Что(СтрНайти(Окно, "aria-invalid=""true""") > 0, "отбитое поле помечено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "value=""quotatest""") > 0,
		"набранное в соседних полях не съедено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "value=""5oo""") > 0, "и в самом отбитом поле — тоже").ЭтоИстина();
	Ожидаем.Что(ИдПула("quotatest"), "пул не заведён").Равно(0);

КонецПроцедуры


// Отказ на форме показывает ПРИЧИНУ, а не служебное «{Модуль /путь/к/файлам/сервера …}»:
// координаты чужого кадра админу ничего не объясняют, зато раскрывают файловую систему хаба.
&Тест
Процедура ОтказСозданияПулаНеПечатаетСлужебнуюОбёртку() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(АдресПулов(), Кука)));

	Поля = ПоляНовогоПула(Токен, "public", "public"); // пул с таким именем уже есть

	Страница = Тело(Клиент.POSTФормы(АдресПулов(), Поля, Кука));

	Ожидаем.Что(СтрНайти(Страница, "{Модуль"), "служебной обёртки на странице нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "oscript_modules"), "путей к файлам сервера на странице нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Error in line"), "координат кадра на странице нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "уже существует") > 0, "причина названа словами").ЭтоИстина();

КонецПроцедуры

// Быстрый старт главной собирается из настоящих полей: узел — из заголовка Host, пути —
// из имени основного пула (у засева он есть — public).
&Тест
Процедура БыстрыйСтартГлавнойНесётНастоящийАдресИОсновнойПул() Экспорт

	Тело = Тело(Клиент.GET("/"));

	Ожидаем.Что(СтрНайти(Тело, "Быстрый старт") > 0, "блок быстрого старта на месте").ЭтоИстина();
	// сверяем поля образца, а не подстроку страницы: «3333» встречается в отпечатках статики
	Ожидаем.Что(СтрНайти(Тело, "&quot;Порт&quot;: 3333"), "выдуманного порта нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "localhost:3333"), "и в адресе сервера образца тоже").Равно(0);

	// узел берётся из Host запроса, а тесты ходят на localhost:<живой порт>
	НомерПорта = Формат(Порт, "ЧН=0; ЧГ=0");
	Ожидаем.Что(СтрНайти(Тело, "&quot;Сервер&quot;: &quot;http://localhost:" + НомерПорта + "&quot;") > 0,
		"сервер образца — узел запроса").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "&quot;Порт&quot;: " + НомерПорта) > 0,
		"и порт запроса, а не 3333").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "/api/v1/pools/public/download/") > 0,
		"пути образца ведут в основной пул хаба").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "opm install &lt;имя-пакета&gt;") > 0,
		"а установка из основного пула идёт короткой формой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СозданиеПулаБезCSRFОтклонено() Экспорт
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Поля = ПоляНовогоПула("", "nocsrf", "public");
	Поля.Удалить("_csrf");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), Поля, Кука).КодСостояния,
		"создание пула без CSRF → 403").Равно(403);
	// отказ обязан не только ответить, но и не завести пул
	Ожидаем.Что(ИдПула("nocsrf"), "пул без CSRF не заведён").Равно(0);
КонецПроцедуры

// Закладка на прежний экран прав пула ведёт мейнтейнера в раздел прав его пула, а не на 403;
// адрес возврата проверяется клиентом без переходов и сравнивается целиком.
&Тест
Процедура ЗакладкаНаСтарыеПраваПулаВедётВДомПула() Экспорт

	ИдOwned = ИдПула("owned");
	Закладки = СтрРазделить("/office/pools/grants|/office/access/grants|/office/access/groups", "|");

	// владелец пула owned: любая из трёх закладок доводит его до РАЗДЕЛА ПРАВ ЕГО ПУЛА
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Для Каждого Закладка Из Закладки Цикл
		Адрес = СтрШаблон("%1?pool=%2", Закладка, Формат(ИдOwned, "ЧН=0; ЧГ=0"));
		Переход = Клиент.GETБезПереходов(Адрес, Клиент.СтрокаКукиСессии(КукаOwner));
		Ожидаем.Что(Редирект(Переход), Закладка + ": закладка уводит переходом").ЭтоИстина();
		Ожидаем.Что(Клиент.ЗаголовокОтвета(Переход, "Location"), Закладка + ": мейнтейнера ведут в права ЕГО пула")
			.Равно("/pools/owned/settings/access");

		Ответ = Клиент.GETСКукой(Адрес, КукаOwner);
		Ожидаем.Что(Ответ.КодСостояния, Закладка + ": владельцу не отказ").Равно(200);
		Ожидаем.Что(СтрНайти(Тело(Ответ), "Выдать роль на пул") > 0,
			Закладка + ": владелец доехал до раздела прав своего пула").ЭтоИстина();
	КонецЦикла;

	// Посторонний: пул ему не виден, и адрес возврата обязан быть ОДИН И ТОТ ЖЕ на любой
	// невидимый пул — иначе перебор идентификаторов раскрывает имена приватных пулов.
	ИдSecret = ИдПула("secret");
	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	АдресЧужого = СтрШаблон("/office/pools/grants?pool=%1", Формат(ИдSecret, "ЧН=0; ЧГ=0"));

	ПереходЧужой = Клиент.GETБезПереходов(АдресЧужого, Клиент.СтрокаКукиСессии(КукаBob));
	Ожидаем.Что(Редирект(ПереходЧужой), "постороннего тоже уводят переходом, а не отказом").ЭтоИстина();
	Ожидаем.Что(Клиент.ЗаголовокОтвета(ПереходЧужой, "Location"), "посторонний уходит в свои права")
		.Равно("/me/settings/permissions");
	Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(ПереходЧужой, "Location"), "secret"),
		"имя невидимого пула в адрес возврата не утекает").Равно(0);

	// и тот же адрес — у пула, которого не существует вовсе: неотличимо
	Небывалый = Клиент.GETБезПереходов("/office/pools/grants?pool=987654321", Клиент.СтрокаКукиСессии(КукаBob));
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Небывалый, "Location"), "несуществующий пул неотличим от невидимого")
		.Равно(Клиент.ЗаголовокОтвета(ПереходЧужой, "Location"));

	ОтветЧужой = Клиент.GETСКукой(АдресЧужого, КукаBob);
	Ожидаем.Что(ОтветЧужой.КодСостояния, "постороннему не отказ").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтветЧужой), "secret"),
		"и на посадочной странице имени невидимого пула нет").Равно(0);

КонецПроцедуры

// Меню строки пула — дом пула, «Сделать основным» и удаление окнами по адресу; панель уходит
// в верхний слой: в потоке она раздвигала бы строку, а абсолютную обрезала бы обёртка прокрутки.
&Тест
Процедура МенюСтрокиПулаНесётДомОсновнойИУдаление() Экспорт

	Кука = ВойтиRoot();
	Имя = УникальныеИмена.Имя("menurow");
	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, Имя, "public")), "пул заведён").ЭтоИстина();
	Стр = Тело(Клиент.GETСКукой(АдресПулов() + "?q=" + Имя, Кука));

	// таблица помечена своим классом: на узком экране строка становится карточкой
	Ожидаем.Что(СтрНайти(Стр, "class=""table table-cards""") > 0,
		"таблица пулов несёт класс адаптива").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, "class=""menu""") > 0, "меню строки на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "popovertarget=""") > 0, "у меню есть кнопка-открывашка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, " popover class=""menu__panel""") > 0,
		"и панель с действиями — во всплывающем слое").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, """/pools/" + Имя + "/settings""") > 0, "меню ведёт в дом пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, КодироватьСтроку("основной-" + Имя, СпособКодированияСтроки.КодировкаURL)) > 0,
		"«Сделать основным» — окном по адресу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, КодироватьСтроку("удалить-" + Имя, СпособКодированияСтроки.КодировкаURL)) > 0,
		"удаление — окном по адресу").ЭтоИстина();

КонецПроцедуры


// Списки с меню строки на узком экране перестраиваются в записи — шестерёнка видна в каждой,
// а не уезжает за край рамки прокрутки; проверяются все такие таблицы на четырёх экранах.
&Тест
Процедура СпискиСМенюСтрокиНаТелефонеСтановятсяЗаписями() Экспорт

	КукаRoot = ВойтиRoot();
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(КукаАлисы, "chan-cards", "^1.0", "", "");

	Экраны = Новый Соответствие();
	Экраны.Вставить(АдресПулов(), КукаRoot);
	Экраны.Вставить("/hub/settings/users", КукаRoot);
	Экраны.Вставить("/pools/public/packages/alice-pkg/settings/versions", КукаАлисы);
	Экраны.Вставить("/pools/public/packages/alice-pkg/settings/tags", КукаАлисы);

	// тег убирается и тогда, когда проверка упала: хаб живой и общий для набора
	Попытка

		Для Каждого Экран Из Экраны Цикл

			Таблицы = ТаблицыСМенюСтроки(Тело(Клиент.GETСКукой(Экран.Ключ, Экран.Значение)));
			Ожидаем.Что(Таблицы.Количество() > 0,
				Экран.Ключ + ": таблица с меню строки нашлась — иначе сторожить нечего")
				.ЭтоИстина();

			Для Каждого Открывающий Из Таблицы Цикл
				Ожидаем.Что(СтрНайти(Открывающий, "table-cards") > 0,
					Экран.Ключ + ": список с шестерёнкой в строке на телефоне остаётся таблицей,"
						+ " и шестерёнка уезжает за край: " + Открывающий).ЭтоИстина();
			КонецЦикла;

		КонецЦикла;

	Исключение
		УдалитьТег(КукаАлисы, "chan-cards");
		ВызватьИсключение;
	КонецПопытки;

	УдалитьТег(КукаАлисы, "chan-cards");

КонецПроцедуры

// Идентификаторы связи кнопки меню с панелью на странице пулов уникальны: два пула с почти
// одинаковыми именами — пара, на которой идентификатор «из имени» слипся бы.
&Тест
Процедура ИдентификаторыМенюНаСтраницеПуловУникальны() Экспорт

	Кука = ВойтиRoot();
	Отметка = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧН=0; ЧГ=0");
	ЗавестиПул(Кука, "twin-pool-" + Отметка, "public");
	ЗавестиПул(Кука, "twin-pool-" + Отметка + "-2", "public");

	Стр = Тело(Клиент.GETСКукой(АдресПулов(), Кука));

	// единое меню инсталляции считается отдельно: его панель открывают три кнопки (бургер,
	// рейка, крест) — их связь стережёт ХолстКита.ТриКнопкиЕдиногоМенюОткрываютОднуПанель
	Панели = БезЕдиногоМеню(ИдентификаторыПанелейМеню(Стр));
	Ожидаем.Что(Панели.Количество() > 2,
		"на странице пулов меню несколько: " + Формат(Панели.Количество(), "ЧН=0; ЧГ=0")).ЭтоИстина();

	Встреченные = Новый Соответствие();
	Повторы = Новый Массив();
	Для Каждого Ид Из Панели Цикл
		Если Встреченные.Получить(Ид) <> Неопределено Тогда
			Повторы.Добавить(Ид);
		КонецЕсли;
		Встреченные.Вставить(Ид, Истина);
		Ожидаем.Что(СтрНайти(Ид, "twin"),
			"имя пула протекло в идентификатор связи: " + Ид).Равно(0);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Повторы, ", "),
		"две панели с одним идентификатором: шестерёнка откроет меню чужой строки").Равно("");

	Цели = БезЕдиногоМеню(ЗначенияАтрибутовВТеле(Стр, "popovertarget="""));
	Ожидаем.Что(Цели.Количество(), "у каждой панели своя кнопка").Равно(Панели.Количество());

	Потерянные = Новый Массив();
	Для Каждого Цель Из Цели Цикл
		Если Встреченные.Получить(Цель) = Неопределено Тогда
			Потерянные.Добавить(Цель);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"кнопка целится в панель, которой на странице нет").Равно("");

КонецПроцедуры

// Отказы раздела «Пулы» называются своими кодами: по вводу — 400, по праву — 403 (порог раздела —
// админ хаба), форма старой вкладки — 400, и ни один не падает в 500.
&Тест
Процедура ОтказыПультовРазделаПулыНазываютсяСвоимиКодами() Экспорт

	КукаRoot = ВойтиRoot();
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot)));

	// отказ ПО ВВОДУ — 400: форму есть что поправить
	Поля = ПоляНовогоПула(Токен, УникальныеИмена.Имя("badquota"), "public");
	Поля.Вставить("квота_мб", "5oo");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), Поля, КукаRoot).КодСостояния, "мусор в квоте — 400").Равно(400);

	// отказ ПО ПРАВУ — 403
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), ПоляНовогоПула(Токен, УникальныеИмена.Имя("alien"), "public"),
			Клиент.Войти("alice", "AlicePassw0rd")).КодСостояния,
		"не-админ: отказ по праву, а не отказ по вводу").Равно(403);

	// форма старой вкладки — 400 «Страница устарела», без мутации и без 500
	Старая = Новый Соответствие();
	Старая.Вставить("_csrf", Токен);
	Старая.Вставить("операция", "пул-создать");
	Старая.Вставить("имя", "legacytab");
	Ответ = Клиент.POSTФормы(АдресПулов(), Старая, КукаRoot);
	Ожидаем.Что(Ответ.КодСостояния, "старая вкладка — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Страница устарела") > 0, "причина названа").ЭтоИстина();
	Ожидаем.Что(ИдПула("legacytab"), "пул не заведён").Равно(0);

КонецПроцедуры


// Новый пул наследует квоту хаба (в базе записано −1): таблица печатает ДЕЙСТВУЮЩИЙ предел
// полосой, а не выдаёт пул за пул без ограничения.
&Тест
Процедура КолонкаПечатаетДействующуюКвотуАНеЗаписаннуюМинусЕдиницу() Экспорт

	Кука = ВойтиRoot();
	Имя = УникальныеИмена.Имя("inherit");
	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, Имя, "public")), "пул заведён").ЭтоИстина();

	Обзор = Тело(Клиент.GETСКукой(АдресПулов() + "?q=" + Имя, Кука));
	Ожидаем.Что(СтрНайти(Обзор, ">" + Имя + "</a>") > 0, "предпосылка: пул в отобранном списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/" + Имя + "/settings/quota", Кука)), "value=""-1""") > 0,
		"предпосылка: у нового пула записано «как в хабе»").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Обзор, "class=""meter") > 0, "действующий предел — полосой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Обзор, "квота хаба") > 0, "наследование квоты хаба названо прямо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Обзор, "квота не задана"),
		"строка наследующего пула НЕ выдаёт себя за пул без ограничения").Равно(0);

КонецПроцедуры

// «Сделать основным» — право на хабе, а не на пуле: админ отдельного пула не уводит
// короткие адреса /download и /push на себя.
&Тест
Процедура ОсновнойПулНазначаетсяТолькоПравомХаба() Экспорт

	КукаRoot = ВойтиRoot();

	// НЕГАТИВ: владелец пула не назначает свой пул основным — ни ответом, ни в базе
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов() + "/owned/primary",
			ПоляПодтверждения(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/", КукаOwner)))), КукаOwner).КодСостояния,
		"владелец пула: назначение основного → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned", КукаOwner)), "Основной"),
		"подделанный POST основной пул не переставил").Равно(0);

	// ПОЗИТИВ: админ хаба назначает и возвращает обратно
	Попытка

		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресПулов() + "/owned/primary",
				ПоляПодтверждения(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot)))), КукаRoot)),
			"админ хаба назначил основной пул").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned", КукаRoot)), "Основной") > 0,
			"плашка основного переехала на owned").ЭтоИстина();

	Исключение

		ВернутьОсновнымPublic(КукаRoot);
		ВызватьИсключение;

	КонецПопытки;

	ВернутьОсновнымPublic(КукаRoot);

КонецПроцедуры

Процедура ВернутьОсновнымPublic(Знач Кука)
	Клиент.POSTФормы(АдресПулов() + "/public/primary",
		ПоляПодтверждения(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(АдресПулов(), Кука)))), Кука);
КонецПроцедуры

// Поля отправки из окна подтверждения: без них сервер только задаёт вопрос.
Функция ПоляПодтверждения(Знач Токен)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("confirmed", "1");
	Возврат Поля;
КонецФункции

// Отбор по имени переживает мутацию: после удаления пула администратор возвращается к тому же
// суженному списку, а не к полному.
&Тест
Процедура ОтборПереживаетУдалениеПула() Экспорт

	Кука = ВойтиRoot();
	Имя = УникальныеИмена.Имя("keepfilter");
	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, Имя, "public")), "пул заведён").ЭтоИстина();

	Поля = ПоляПодтверждения(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(АдресПулов() + "?q=own", Кука))));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("q", "own");
	Ответ = Клиент.POSTФормыБезПереходов(АдресПулов() + "/" + Имя + "/delete", Поля, Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "пул удалён — 303").Равно(303);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "ответ ведёт к тому же отбору")
		.Равно(АдресПулов() + "?q=own&saved=1");
	Ожидаем.Что(ИдПула(Имя), "пула нет").Равно(0);

КонецПроцедуры


&Тест
Процедура НеВладелецНеСоздаётПулИНеУправляетДоступом() Экспорт

	// bob не админ хаба → раздел «Пулы» закрыт ему целиком: ни списка, ни формы создания
	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой(АдресПулов(), Кука).КодСостояния,
		"не-админу раздел пулов дома «Хаб» → 403").Равно(403);

	// но своим личным пространством он распоряжается
	Ожидаем.Что(Клиент.GETСКукой("/pools/bob/settings", Кука).КодСостояния,
		"владелец личного пространства входит в его дом").Равно(200);
	Свои = Клиент.GETСКукой("/pools/bob/settings/access", Кука);
	Ожидаем.Что(Свои.КодСостояния, "и в раздел прав своего пула").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Свои), "Выдать роль на пул") > 0,
		"мейнтейнер своего пула раздаёт роли на нём").ЭтоИстина();

	// чужим пулом — не управляет
	Ожидаем.Что(Клиент.GETСКукой(ЭкранПравПула("public"), Кука).КодСостояния,
		"не-мейнтейнер: права чужого пула → 403").Равно(403);

	// райтер пула страницы раздачи ролей не получает — иначе эскалация в один клик;
	// одна сессия root на всю связку: CSRF-токен привязан к своей сессии
	КукаRoot7A = ВойтиRoot();
	ЭкранПрав = ЭкранПравПула("public");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(ЭкранПрав, КукаRoot7A)));
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПрав, Токен, КукаRoot7A, "bob", "райтер")),
		"bob сделан райтером public").ЭтоИстина();

	КукаBob7A = Клиент.Войти("bob", "BobPassw0rd");
	ОтветРайтера = Клиент.GETСКукой(ЭкранПрав, КукаBob7A);
	Ожидаем.Что(ОтветРайтера.КодСостояния, "РАЙТЕР пула не входит на экран прав → 403").Равно(403);

	// и выдать роль формой он тоже не может (гейт стоит не только на GET)
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПрав, Клиент.ТокенCSRF(Тело(ОтветРайтера)),
		КукаBob7A, "bob", "мейнтейнер")), "райтер не выдаёт себе мейнтейнера").ЭтоЛожь();

	// отказ обязан не только ответить кодом, но и НЕ записать: перечитываем глазами админа
	Ожидаем.Что(СтрНайти(СтрокаПрава(Тело(Клиент.GETСКукой(ЭкранПрав, КукаRoot7A)), "bob"), ">мейнтейнер<"),
		"подделанный POST райтера роль в базе не поднял").Равно(0);

	// уборка: снимаем роль bob, чтобы соседние тесты видели прежнюю картину
	УспехМутации(ОтозватьРольНаПул(ЭкранПрав, Токен, КукаRoot7A, "bob"));

КонецПроцедуры

&Тест
Процедура АдминВыдаётИОтзываетРольЧерезUI() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = ЭкранПравПула("public");

	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	// выдать bob роль райтера на пул public: форма спрашивает роль, а не действия
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(Страница, Токен, Кука, "bob", "райтер")),
		"роль выдана (302)").ЭтоИстина();

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));

	// в списке ролей нет владельца и админа хаба, а по умолчанию выбрана самая слабая роль —
	// иначе один промах мыши раздаёт администраторов пула
	Ожидаем.Что(СтрНайти(Стр, "value=""читатель""") > 0, "в списке есть читатель").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "value=""райтер""") > 0, "в списке есть райтер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "value=""мейнтейнер""") > 0, "в списке есть мейнтейнер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "value=""владелец"""), "владельца в форме выдачи нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "value=""админ"""), "админа хаба в форме выдачи нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "value=""читатель"" selected") > 0,
		"по умолчанию выбран читатель — самая слабая роль").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, "bob") > 0, "субъект bob в таблице прав").ЭтоИстина();
	// наружу — роль, а не набор действий; сверяется ячейка целиком: подписи ролей печатает
	// и сама форма выдачи
	Ожидаем.Что(СтрНайти(СтрокаПрава(Стр, "bob"), ">райтер<") > 0, "роль отражена в строке выдачи").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, ">чтение, создание, изменение<"), "действий на экране нет").Равно(0);

	// без поля «роль» в теле POST сервер выдаёт самую слабую роль: наименьшие права держит
	// сервер, а не вёрстка
	ПоляБезРоли = Новый Соответствие();
	ПоляБезРоли.Вставить("_csrf", Токен);
	ПоляБезРоли.Вставить("операция", "выдать");
	ПоляБезРоли.Вставить("тип_субъекта", "пользователь");
	ПоляБезРоли.Вставить("субъект", "bob");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, ПоляБезРоли, Кука)),
		"форма без поля «роль» принимается").ЭтоИстина();

	СтрБезРоли = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(СтрокаПрава(СтрБезРоли, "bob"), ">читатель<") > 0,
		"без поля «роль» выдаётся САМАЯ СЛАБАЯ роль, а не мейнтейнер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокаПрава(СтрБезРоли, "bob"), ">мейнтейнер<"),
		"мейнтейнер по умолчанию не выдаётся").Равно(0);

	// возвращаем райтера — дальше проверяется отзыв именно его
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(Страница, Токен, Кука, "bob", "райтер")),
		"роль возвращена на райтера").ЭтоИстина();

	// отозвать
	Ожидаем.Что(УспехМутации(ОтозватьРольНаПул(Страница, Токен, Кука, "bob")),
		"грант отозван (302)").ЭтоИстина();
	Ожидаем.Что(СтрокаПрава(Тело(Клиент.GETСКукой(Страница, Кука)), "bob"), "bob исчез из таблицы").Равно("");

КонецПроцедуры

// Права складываются и не вычитаются: выданное на пуле действует на его пакетах, а операции
// «запретить» в хабе нет.
&Тест
Процедура РольНаПулеОткрываетЕгоПакетАЗапретаНеСуществует() Экспорт

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	ДомПакета = "/pools/public/packages/alice-pkg/settings";
	Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
		"самотест: без выдачи bob в дом чужого пакета не входит").Равно(403);

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	ЭкранПула = ЭкранПравПула("public");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(ЭкранПула, КукаАдмина)));

	Попытка

		Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПула, Токен, КукаАдмина, "bob", "мейнтейнер")),
			"роль выдана на ПУЛ, а на пакете не выдавалось ничего").ЭтоИстина();
		Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
			"роль родителя действует на вложенном объекте").Равно(200);

		// «запретить» — не операция раздела, и форму с ней раздел отбивает: прибавлять он умеет,
		// отнимать — нет
		ЭкранПакета = "/pools/public/packages/alice-pkg/settings/access";
		Запрет = Новый Соответствие();
		Запрет.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(ЭкранПакета, КукаАдмина))));
		Запрет.Вставить("операция", "запретить");
		Запрет.Вставить("тип_субъекта", "пользователь");
		Запрет.Вставить("субъект", "bob");
		Запрет.Вставить("роль", "читатель");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(ЭкранПакета, Запрет, КукаАдмина)),
			"слова «запретить» раздел не знает и форму отбивает").ЭтоЛожь();
		Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
			"попытка запрета выданного на пуле доступа не отняла").Равно(200);
		СнятьПравоПакета(КукаАдмина, Токен, "bob");

	Исключение
		СнятьПравоПакета(КукаАдмина, Токен, "bob");
		ОтозватьРольНаПул(ЭкранПула, Токен, КукаАдмина, "bob");
		ВызватьИсключение;
	КонецПопытки;

	// доступ отбирают тем, что снимают саму выдачу — ту, из которой он взялся
	Ожидаем.Что(УспехМутации(ОтозватьРольНаПул(ЭкранПула, Токен, КукаАдмина, "bob")),
		"выдача снята").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
		"снятие выдачи закрыло и вложенный объект").Равно(403);

КонецПроцедуры

&Тест
Процедура ВитринаПравВДомеПулаНазываетСубъектаЛогиномАНеЧислом() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	ЭкранПрав = ЭкранПравПула("public");

	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(ЭкранПрав, Кука)));

	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПрав, Токен, Кука, "bob", "читатель")),
		"право доступа выдано (302)").ЭтоИстина();

	Попытка

		Витрина = Тело(Клиент.GETСКукой(ЭкранПрав, Кука));

		// строка витрины целиком — соседство ячеек, а не логин где-нибудь на странице
		Ожидаем.Что(СтрНайти(СтрокаПрава(Витрина, "bob"), ">пользователь<") > 0,
			"в витрине дома пула субъект назван логином, а не идентификатором, тип — словом").ЭтоИстина();

		// витрина дома пула говорит ролью, как и экран прав
		Ожидаем.Что(СтрНайти(СтрокаПрава(Витрина, "bob"), ">читатель<") > 0,
			"витрина дома пула называет роль").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Витрина, ">чтение<"), "набора действий в витрине нет").Равно(0);

		// оба экрана называют субъект одинаково — разворот у них общий
		Ожидаем.Что(СтрокаПрава(Тело(Клиент.GETСКукой(ЭкранПрав, Кука)), "bob"),
			"экран прав доступа называет субъект тем же логином").Заполнено();

	Исключение

		Снять(Кука, Токен, "public");
		ВызватьИсключение;

	КонецПопытки;

	Снять(Кука, Токен, "public");

КонецПроцедуры

&Тест
Процедура СообщениеОНенайденномПулеЗеркалЭкранировано() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Полезное = "<script>alert(1)</script>";
	Ответ = Клиент.GETСКукой("/office/mirrors/" + КодироватьСтроку(Полезное, СпособКодированияСтроки.КодировкаURL), Кука);

	Ожидаем.Что(Ответ.КодСостояния, "несуществующий пул — 404").Равно(404);

	Стр = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Стр, Полезное), "тег из URL в разметку не вырвался").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "&lt;script&gt;") > 0, "имя пула отдано экранированным: " + Стр).ЭтоИстина();

КонецПроцедуры

// Двери зеркал пула в кабинете — заведение, заявка, переключение, удаление — стережёт право
// администрировать пул: постороннему 403 на каждой, с верным токеном и подтверждением.
&Тест
Процедура ПостороннийНеТрогаетЗеркалаПулаИзКабинета() Экспорт

	КукаAlice = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/me/settings/profile", КукаAlice)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("url", "http://127.0.0.1:6/download/");
	Поля.Вставить("confirmed", "1");
	Поля.Вставить("зеркало", "127.0.0.1:6");
	Поля.Вставить("включить", "0");
	Для Каждого Адрес Из СтрРазделить("/office/mirrors/owned,/office/mirrors/owned/1/sync,"
		+ "/office/mirrors/owned/1/toggle,/office/mirrors/owned/1/delete", ",") Цикл
		Ожидаем.Что(Клиент.POSTФормы(Адрес, Поля, КукаAlice).КодСостояния,
			"посторонний к пулу отбит на " + Адрес).Равно(403);
	КонецЦикла;
	Ожидаем.Что(Клиент.GETСКукой("/office/mirrors/owned?" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL)
		+ "=" + КодироватьСтроку("новый", СпособКодированияСтроки.КодировкаURL), КукаAlice).КодСостояния,
		"и окна зеркал чужого пула ему не открываются").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/office/mirrors/owned", Клиент.Войти("owner1", "Owner1Passw0rd"))),
		"127.0.0.1:6"), "зеркала постороннего у пула нет").Равно(0);

КонецПроцедуры

// Галка пула «теги пула для пакетов» по умолчанию выключена и живёт в разделе «Теги»: с ней
// новый пакет отдаёт три канала визарда, унаследованные от пула, а не заведённые у себя.
&Тест
Процедура ГалкаПулаОтдаётТегиПулаНовымПакетам() Экспорт

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/owned/settings/tags";
	Токен = Клиент.ВыпуститьPAT(Кука);

	Ожидаем.Что(ТумблерВключён(Тело(Клиент.GETСКукой(Раздел, Кука)), "теги_пула"),
		"КОНТРОЛЬ: у пула настройка выключена").ЭтоЛожь();

	Ожидаем.Что(PushТокеном(Токен, "owned", "auto-off-pkg", "1.0.0").КодСостояния,
		"пакет в пул без настройки опубликован").Равно(201);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned/packages/auto-off-pkg/settings/tags", Кука)),
		"Создать каналы") > 0, "и каналов у него нет — экран предлагает визард").ЭтоИстина();

	Попытка

		ПереключитьТегиПула(Раздел, Кука, Истина);
		Ожидаем.Что(ТумблерВключён(Тело(Клиент.GETСКукой(Раздел, Кука)), "теги_пула"),
			"настройка включена и видна на экране").ЭтоИстина();

		Ожидаем.Что(PushТокеном(Токен, "owned", "auto-on-pkg", "1.0.0").КодСостояния,
			"пакет в пул с настройкой опубликован").Равно(201);

		Разметка = Тело(Клиент.GETСКукой("/pools/owned/packages/auto-on-pkg/settings/tags", Кука));
		Для Каждого ИмяКанала Из СтрРазделить("stable,prerelease,develop", ",") Цикл
			Ожидаем.Что(ЗначениеЗаполнено(ПлашкаТегаНаСтранице(Разметка, ИмяКанала)),
				"пакет отдаёт канал пула «" + ИмяКанала + "»").ЭтоИстина();
		КонецЦикла;
		Ожидаем.Что(СтрНайти(Разметка, "из пула owned") > 0, "каналы — от пула, а не копии").ЭтоИстина();

	Исключение
		// уборка обязана пройти и по провалу: включённая настройка уронила бы соседей
		ПереключитьТегиПула(Раздел, Кука, Ложь);
		ВызватьИсключение;
	КонецПопытки;

	ПереключитьТегиПула(Раздел, Кука, Ложь);
	Ожидаем.Что(ТумблерВключён(Тело(Клиент.GETСКукой(Раздел, Кука)), "теги_пула"),
		"настройка выключена обратно").ЭтоЛожь();

КонецПроцедуры

// Выключенная публикация закрывает пул для ЛЮДЕЙ, а не для хаба: из обзора «где заводят
// зеркала» такой пул не пропадает, и карточка пула говорит, чем он наполняется.
&Тест
Процедура ЗакрытыйДляПубликацииПулВиденТамГдеЗаводятЗеркала() Экспорт

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/owned/settings/upstreams";

	// КОНТРОЛЬ до выключения: пул в обзоре есть, и плашки наполнения на карточке нет
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/office/mirrors", Кука)), "/office/mirrors/owned") > 0,
		"КОНТРОЛЬ: с публикацией пул в обзоре зеркал есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned", Кука)), "Закрыт для публикации"),
		"КОНТРОЛЬ: с публикацией карточка о закрытости молчит").Равно(0);

	Ид = "";
	Попытка

		ПереключитьПубликациюПула(Раздел, Кука, Ложь);

		Обзор = Тело(Клиент.GETСКукой("/office/mirrors", Кука));
		Ожидаем.Что(СтрНайти(Обзор, "/office/mirrors/owned") > 0,
			"закрытый для публикации пул из обзора зеркал не пропал: " + Обзор).ЭтоИстина();

		// зеркала на нём ещё нет — карточка обязана сказать именно «закрыт», а не выдумывать
		Карточка = Тело(Клиент.GETСКукой("/pools/owned", Кука));
		Ожидаем.Что(СтрНайти(Карточка, "Закрыт для публикации") > 0,
			"карточка пула без зеркал называет его закрытым: " + Карточка).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Карточка, "Наполняется зеркалом"),
			"и зеркала себе не приписывает").Равно(0);

		// заводим зеркало на этот же закрытый пул — подпись обязана перестать врать
		Ид = ЗавестиЗеркалоПула("/office/mirrors/owned", Кука, "http://127.0.0.1:8/download/");
		Ожидаем.Что(ЗначениеЗаполнено(Ид), "зеркало закрытому пулу заведено").ЭтоИстина();

		СЗеркалом = Тело(Клиент.GETСКукой("/pools/owned", Кука));
		Ожидаем.Что(СтрНайти(СЗеркалом, "Наполняется зеркалом") > 0,
			"карточка пула с зеркалом называет источник наполнения: " + СЗеркалом).ЭтоИстина();
		Ожидаем.Что(СтрНайти(СЗеркалом, "Закрыт для публикации"),
			"и «закрыт для всех» больше не говорит").Равно(0);

	Исключение
		// уборка обязана пройти и по провалу: оставленное зеркало и выключенная публикация
		// уронили бы соседние тесты набора — они делят один хаб
		УбратьЗеркалоПула("/office/mirrors/owned", Кука, Ид, "127.0.0.1:8");
		ПереключитьПубликациюПула(Раздел, Кука, Истина);
		ВызватьИсключение;
	КонецПопытки;

	УбратьЗеркалоПула("/office/mirrors/owned", Кука, Ид, "127.0.0.1:8");
	ПереключитьПубликациюПула(Раздел, Кука, Истина);

КонецПроцедуры

// Тумблер раздела «Теги» дома пула: включённый шлёт «1», выключенный — «0».
Процедура ПереключитьТегиПула(Знач Раздел, Знач Кука, Знач Включить)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("операция", "теги_пула");
	Поля.Вставить("теги_пула", ?(Включить, "1", "0"));

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, Кука)),
		"галка тегов пула переключена").ЭтоИстина();

КонецПроцедуры

// Включён ли тумблер: ищется чекбокс с «checked», а не парное скрытое поле с тем же именем.
Функция ТумблерВключён(Знач Разметка, Знач ИмяПоля)

	Маркер = "name=""" + ИмяПоля + """";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, "<input");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Конец = СтрНайти(Хвост, ">");
		Поле = ?(Конец = 0, Хвост, Лев(Хвост, Конец));
		Если СтрНайти(Поле, Маркер) > 0 И СтрНайти(Поле, "type=""checkbox""") > 0 Тогда
			Возврат СтрНайти(Поле, "checked") > 0;
		КонецЕсли;
		Хвост = Сред(Хвост, 7);
		Позиция = СтрНайти(Хвост, "<input");
	КонецЦикла;

	ВызватьИсключение "Тумблера «" + ИмяПоля + "» на странице нет";

КонецФункции

// Тумблер публикации пула через штатную форму раздела «Апстримы».
Процедура ПереключитьПубликациюПула(Знач Раздел, Знач Кука, Знач Разрешить)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("публикация", ?(Разрешить, "1", "0"));

	// у тумблера публикации свой адрес в разделе «Апстримы»
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел + "/publication", Поля, Кука)),
		"тумблер публикации переключён").ЭтоИстина();

КонецПроцедуры

// Заводит зеркало пула формой обзора и возвращает его идентификатор; апстрим у теста свой.
Функция ЗавестиЗеркалоПула(Знач Обзор, Знач Кука, Знач Апстрим)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Обзор, Кука))));
	Поля.Вставить("url", Апстрим);
	Поля.Вставить("интервал", "600");

	Ответ = Клиент.POSTФормы(Обзор, Поля, Кука);
	Ожидаем.Что(УспехМутации(Ответ), "форма зеркала принята: " + Тело(Ответ)).ЭтоИстина();
	Возврат ИдЗеркалаИзСсылки(Тело(Клиент.GETСКукой(Обзор, Кука)));

КонецФункции

// Удаление — подтверждённой формой окна: эхо повторяет узел адреса апстрима.
Процедура УбратьЗеркалоПула(Знач Обзор, Знач Кука, Знач Ид, Знач Узел)

	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат;
	КонецЕсли;
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Обзор, Кука))));
	Поля.Вставить("confirmed", "1");
	Поля.Вставить("зеркало", Узел);
	Клиент.POSTФормы(Обзор + "/" + Ид + "/delete", Поля, Кука);

КонецПроцедуры

&Тест
Процедура ИзОбзораЗеркалЕстьХодНаЭкранСостоянияВДомеПула() Экспорт

	// кабинет своего экрана состояния не заводит: обзор ведёт в дом пула, и адрес
	// из ссылки обязан отвечать живой страницей
	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Обзор = "/office/mirrors/owned";
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Обзор, Кука)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("url", "http://127.0.0.1:9/download/");
	Поля.Вставить("интервал", "600");
	Ответ = Клиент.POSTФормы(Обзор, Поля, Кука);
	Ожидаем.Что(УспехМутации(Ответ), "зеркало заведено: " + Тело(Ответ)).ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Обзор, Кука));
	Ид = ИдЗеркалаИзСсылки(Список);
	Ожидаем.Что(ЗначениеЗаполнено(Ид),
		"обзор кабинета ведёт на экран состояния в доме пула: " + Список).ЭтоИстина();

	Экран = "/pools/owned/settings/mirrors/" + Ид;

	ОтветЭкрана = Клиент.GETСКукой(Экран, Кука);
	Ожидаем.Что(ОтветЭкрана.КодСостояния, "экран состояния отдан").Равно(200);

	Страница = Тело(ОтветЭкрана);
	Ожидаем.Что(СтрНайти(Страница, "127.0.0.1:9") > 0, "экран показывает это зеркало").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Счётчики прогона") > 0, "счётчики прогона на экране").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTФормы(Экран, Поля, Кука).КодСостояния,
		"экран состояния ничего не мутирует — POST не разрешён").Равно(405);
	// клиент проходит редирект сам, поэтому судим по содержимому: аноним получает вход
	Ожидаем.Что(СтрНайти(Тело(Клиент.GET(Экран)), "Счётчики прогона"),
		"аноним состояния чужого зеркала не видит").Равно(0);

	// «синхронизировать сейчас» ставит заявку фоновому рабочему; апстрим мёртв (порт 9) —
	// прогон обязан закончиться внятным итогом
	ОтветСинка = Клиент.POSTФормы(Обзор + "/" + Ид + "/sync", Поля, Кука);
	Ожидаем.Что(УспехМутации(ОтветСинка), "заявка принята и не уронила раздел").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтветСинка), "поставлено в очередь синхронизации") > 0,
		"после нажатия экран говорит, что произошло: " + Тело(ОтветСинка)).ЭтоИстина();

	// заявка доезжает до записи зеркала: нажатие пишет логин инициатора в колонку прогона
	// вместо «по расписанию»
	СтраницаПослеСинка = Тело(Клиент.GETСКукой(Экран, Кука));
	Ожидаем.Что(СтрНайти(СтраницаПослеСинка, "по расписанию"),
		"прогон больше не безымянный: кнопка записала инициатора в состояние прогона: "
		+ СтраницаПослеСинка).Равно(0);

	Поля.Вставить("confirmed", "1");
	Поля.Вставить("зеркало", "127.0.0.1:9");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Обзор + "/" + Ид + "/delete", Поля, Кука)),
		"зеркало убрано за собой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИзНастроекЗеркалированияЧеловекДоходитДоСвоегоЗеркала() Экспорт

	// зеркало заводится прямой формой, а разыскивается обходом ссылок от раздела, где настроено
	// зеркалирование, — как человеком, который не помнит адреса
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Обзор = "/office/mirrors/owned";
	// свой порт апстрима: у соседних тестов набора он другой, и брошенное зеркало
	// не встретится с чужим как дубль. Он же — примета зеркала на странице
	ПриметаЗеркала = "127.0.0.1:7";

	Ид = ЗавестиЗеркалоПула(Обзор, Кука, "http://" + ПриметаЗеркала + "/download/");
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "зеркало, которое предстоит разыскать, заведено").ЭтоИстина();

	Попытка

		АдресГдеВидноЗеркало = АдресДостижимойСтраницы("/hub/settings/mirrors", Кука,
			ПриметаЗеркала, 2);
		Ожидаем.Что(ЗначениеЗаполнено(АдресГдеВидноЗеркало),
			"из раздела «Зеркалирование» по ссылкам виден список зеркал с заведённым зеркалом")
			.ЭтоИстина();

	Исключение
		УбратьЗеркалоПула(Обзор, Кука, Ид, ПриметаЗеркала);
		ВызватьИсключение;
	КонецПопытки;

	УбратьЗеркалоПула(Обзор, Кука, Ид, ПриметаЗеркала);

КонецПроцедуры

// Обход ссылок вширь от Начала: адрес первой страницы с Признаком в пределах Глубины; "" — нет.
Функция АдресДостижимойСтраницы(Знач Начало, Знач Кука, Знач Признак, Знач Глубина)

	Посещённые = Новый Соответствие();
	Посещённые.Вставить(Начало, Истина);

	Фронт = ВнутренниеСсылки(РазметкаСтраницы(Начало, Кука));
	Шаг = 1;

	Пока Шаг <= Глубина Цикл

		Следующий = Новый Массив();
		Для Каждого Адрес Из Фронт Цикл

			Если Посещённые.Получить(Адрес) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Посещённые.Вставить(Адрес, Истина);

			Страница = РазметкаСтраницы(Адрес, Кука);
			Если СтрНайти(Страница, Признак) > 0 Тогда
				Возврат Адрес;
			КонецЕсли;

			Если Шаг < Глубина Тогда
				Для Каждого Ссылка Из ВнутренниеСсылки(Страница) Цикл
					Следующий.Добавить(Ссылка);
				КонецЦикла;
			КонецЕсли;

		КонецЦикла;

		Фронт = Следующий;
		Шаг = Шаг + 1;

	КонецЦикла;

	Возврат "";

КонецФункции

// Разметка страницы без гейтов ритма форм: предмет обхода — дорога, а не вёрстка.
Функция РазметкаСтраницы(Знач Путь, Знач Кука)
	Возврат Клиент.GETСКукой(Путь, Кука).ПолучитьТелоКакСтроку();
КонецФункции

// Ссылки внутрь хаба, по которым обход идёт дальше: без ресурсов, якорей и чужих сайтов.
Функция ВнутренниеСсылки(Знач Страница)

	Результат = Новый Массив();
	Маркер = "href=""";
	Хвост = Страница;

	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Адрес = Лев(Хвост, Конец - 1);
			Если АдресВнутриХаба(Адрес) Тогда
				Результат.Добавить(Адрес);
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АдресВнутриХаба(Знач Адрес)

	Возврат Лев(Адрес, 1) = "/"
		И Лев(Адрес, 2) <> "//"
		И СтрНайти(Адрес, "#") = 0
		И НЕ СтрНачинаетсяС(Адрес, "/static/")
		И НЕ СтрНачинаетсяС(Адрес, "/brand/");

КонецФункции

// Идентификатор зеркала из ссылки обзора кабинета на дом пула; "" — ссылки нет.
Функция ИдЗеркалаИзСсылки(Знач Разметка)

	Маркер = "href=""/pools/owned/settings/mirrors/";
	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец > 1, Лев(Хвост, Конец - 1), "");

КонецФункции

// Отзывает выданное предыдущим тестом право, чтобы витрина не осталась засорённой.
Процедура Снять(Знач Кука, Знач Токен, Знач ИмяПула)

	ОтозватьРольНаПул(ЭкранПравПула(ИмяПула), Токен, Кука, "bob");

КонецПроцедуры

&Тест
Процедура КроссПуловыйГрантОтклонён() Экспорт

	// раздел прав ограничен пулом из адреса: поля «объект»/«объект_ид»/«пул» — предмет сверки,
	// и подделка даёт отказ
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	СвойЭкран = ЭкранПравПула("owned");
	ТокенOwner = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(СвойЭкран, КукаOwner)));

	ИдOwned = ИдПула("owned");
	ИдPublic = ИдПула("public");
	Ожидаем.Что(ИдPublic <> ИдOwned, "пулы public и owned различны").ЭтоИстина();

	// 0. в лоб чужой экран — гвард дома пула не пускает вовсе
	Ожидаем.Что(Клиент.GETСКукой(ЭкранПравПула("public"), КукаOwner).КодСостояния,
		"чужой пул: раздел прав → 403").Равно(403);

	// 1. подставлен ЧУЖОЙ пул в поле формы своего экрана
	АтакаПул = Новый Соответствие();
	АтакаПул.Вставить("_csrf", ТокенOwner);
	АтакаПул.Вставить("пул", Формат(ИдPublic, "ЧГ=0"));
	АтакаПул.Вставить("объект", "пул");
	АтакаПул.Вставить("операция", "выдать");
	АтакаПул.Вставить("тип_субъекта", "пользователь");
	АтакаПул.Вставить("субъект", "owner1");
	АтакаПул.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаПул, КукаOwner)),
		"подставленный чужой пул отбит").ЭтоЛожь();

	// 2. НАСТОЯЩИЙ кросс-пуловый IDOR: объект — ПАКЕТ чужого пула. Раздел управляет
	//    правами только на свой ПУЛ, поэтому чужой объект не проходит по типу.
	ИдЧужогоПакета = ИдПакетаИзAPI("public", "alice-pkg");
	Ожидаем.Что(ИдЧужогоПакета > 0, "идентификатор чужого пакета получен из API").ЭтоИстина();

	АтакаПакет = Новый Соответствие();
	АтакаПакет.Вставить("_csrf", ТокенOwner);
	АтакаПакет.Вставить("объект", "пакет");
	АтакаПакет.Вставить("объект_ид", Формат(ИдЧужогоПакета, "ЧГ=0"));
	АтакаПакет.Вставить("операция", "выдать");
	АтакаПакет.Вставить("тип_субъекта", "пользователь");
	АтакаПакет.Вставить("субъект", "owner1");
	АтакаПакет.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаПакет, КукаOwner)),
		"пакет чужого пула с экрана прав пула отбит").ЭтоЛожь();

	// 3. упразднённый тип объекта — отказ, а не 404/500 и тем более не выдача
	АтакаЛегаси = Новый Соответствие();
	АтакаЛегаси.Вставить("_csrf", ТокенOwner);
	АтакаЛегаси.Вставить("объект", "группа_пакетов");
	АтакаЛегаси.Вставить("объект_ид", Формат(ИдPublic, "ЧГ=0"));
	АтакаЛегаси.Вставить("операция", "выдать");
	АтакаЛегаси.Вставить("тип_субъекта", "пользователь");
	АтакаЛегаси.Вставить("субъект", "owner1");
	АтакаЛегаси.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаЛегаси, КукаOwner)),
		"упразднённый тип объекта отбит").ЭтоЛожь();

	// 4. «хаб» — тип законный, но раздел пул-ограниченный: хаб-гранты выдаёт только
	//    администратор хаба, и владелец пула этим путём их не получит.
	АтакаХаб = Новый Соответствие();
	АтакаХаб.Вставить("_csrf", ТокенOwner);
	АтакаХаб.Вставить("объект", "хаб");
	АтакаХаб.Вставить("объект_ид", "0");
	АтакаХаб.Вставить("операция", "выдать");
	АтакаХаб.Вставить("тип_субъекта", "пользователь");
	АтакаХаб.Вставить("субъект", "owner1");
	АтакаХаб.Вставить("роль", "мейнтейнер");
	ОтветХаб = Клиент.POSTФормы(СвойЭкран, АтакаХаб, КукаOwner);
	Ожидаем.Что(УспехМутации(ОтветХаб), "хаб-грант с экрана пула отбит").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Тело(ОтветХаб), "только на свой пул") > 0,
		"причина названа: раздел работает только со своим пулом").ЭтоИстина();

	// 5. чужой пул назван общим именем идентификатора: сверка не зависит от имени поля
	АтакаОбщееИмя = Новый Соответствие();
	АтакаОбщееИмя.Вставить("_csrf", ТокенOwner);
	АтакаОбщееИмя.Вставить("объект_ид", Формат(ИдPublic, "ЧГ=0"));
	АтакаОбщееИмя.Вставить("операция", "выдать");
	АтакаОбщееИмя.Вставить("тип_субъекта", "пользователь");
	АтакаОбщееИмя.Вставить("субъект", "owner1");
	АтакаОбщееИмя.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаОбщееИмя, КукаOwner)),
		"чужой пул в поле «объект_ид» отбит").ЭтоЛожь();

	// 6. назван объект ЧУЖОГО вида: раздел пула пакетами не распоряжается вовсе
	АтакаЧужойВид = Новый Соответствие();
	АтакаЧужойВид.Вставить("_csrf", ТокенOwner);
	АтакаЧужойВид.Вставить("пакет", Формат(ИдЧужогоПакета, "ЧГ=0"));
	АтакаЧужойВид.Вставить("операция", "выдать");
	АтакаЧужойВид.Вставить("тип_субъекта", "пользователь");
	АтакаЧужойВид.Вставить("субъект", "owner1");
	АтакаЧужойВид.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаЧужойВид, КукаOwner)),
		"пакет в форме раздела прав пула отбит").ЭтоЛожь();

	// ГЛАВНОЕ: ни одна из шести подделок ничего не записала. Код ответа без этой
	// проверки ничего не стоит — отказ обязан оставить базу в прежнем состоянии.
	ЧужойЭкран = Тело(Клиент.GETСКукой(ЭкранПравПула("public"), ВойтиRoot()));
	Ожидаем.Что(СтрокаПрава(ЧужойЭкран, "owner1"),
		"в правах чужого пула owner1 не появился").Равно("");

КонецПроцедуры

// Настоящий идентификатор чужого пакета — из публичного API v2: наугад проверялся бы 404.
Функция ИдПакетаИзAPI(Знач ИмяПула, Знач ИмяПакета)

	Тело_ = Тело(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2", ИмяПула, ИмяПакета)));
	Поз = СтрНайти(Тело_, """id""");
	Если Поз = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Цифры = "";
	Для Индекс = Поз + 4 По СтрДлина(Тело_) Цикл
		С = Сред(Тело_, Индекс, 1);
		Если С >= "0" И С <= "9" Тогда
			Цифры = Цифры + С;
		ИначеЕсли ЗначениеЗаполнено(Цифры) Тогда
			Прервать;
		ИначеЕсли С <> ":" И С <> " " Тогда
			Возврат 0;   // за ключом идёт не число — карточка не та, что ожидали
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ЗначениеЗаполнено(Цифры), Число(Цифры), 0);

КонецФункции

&Тест
Процедура АдресГруппПакетовВедётРедиректом() Экспорт

	Кука = ВойтиRoot();
	ИдPublic = ИдПула("public");

	// клиент проходит по редиректу сам, поэтому смотрим на обе формы ответа: либо 3xx с
	// Location, либо уже отрисованную целевую страницу
	ОтветGET = Клиент.GETСКукой(СтрШаблон("/office/access/groups?pool=%1", ИдPublic), Кука);
	Ожидаем.Что(ОтветGET.КодСостояния < 400,
		"старый адрес не отдаёт ошибку (код " + Формат(ОтветGET.КодСостояния, "ЧГ=0") + ")").ЭтоИстина();
	// адрес несёт пул, поэтому ведёт не в общий список, а в права ЭТОГО пула
	Если Редирект(ОтветGET) Тогда
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(ОтветGET, "Location"), "/settings/access") > 0,
			"редирект ведёт в раздел прав пула").ЭтоИстина();
	Иначе
		Ожидаем.Что(СтрНайти(Тело(ОтветGET), "Выдать роль на пул") > 0,
			"клиент доехал до раздела прав пула").ЭтоИстина();
	КонецЕсли;

	// POST старой формы (без CSRF — страницы, которая его выдавала, больше нет)
	ПоляСтарые = Новый Соответствие();
	ПоляСтарые.Вставить("пул", Формат(ИдPublic, "ЧГ=0"));
	ПоляСтарые.Вставить("действие", "создать");
	ПоляСтарые.Вставить("имя", "victimgrp");
	ОтветPOST = Клиент.POSTФормы("/office/access/groups", ПоляСтарые, Кука);
	Ожидаем.Что(ОтветPOST.КодСостояния < 400,
		"POST старой формы не отдаёт ошибку (редирект, а не 404/405/500)").ЭтоИстина();

	// самой страницы групп больше нет ни под каким адресом
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), "группы пакетов"),
		"ссылки на группы пакетов в обзоре нет").Равно(0);

КонецПроцедуры

// --- управление вебхуками пула в кабинете (UI + права + CSRF + SSRF) ---

&Тест
Процедура АдминСоздаётИВидитВебхукПула() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd"); // хаб-админ администрирует любой пул
	Страница = "/pools/public/settings/webhooks";

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Подписки на события") > 0, "страница подписок пула открыта").ЭтоИстина();
	Токен = Клиент.ТокенCSRF(Стр);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	// форма подписки всегда присылает тип действия: типа по умолчанию у раздела нет
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://hooks.example.com/openhub");
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	ОтветСоздания = Клиент.POSTФормы(Страница, Поля, Кука);

	// секрет показывается один раз на странице результата создания
	ТелоСоздания = Тело(ОтветСоздания);
	Ожидаем.Что(СтрНайти(ТелоСоздания, "Скопируйте секрет") > 0, "секрет показан один раз при создании").ЭтоИстина();

	// вебхук виден в списке; окна секрета на следующем показе раздела нет
	СтрСписка = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(СтрСписка, "hooks.example.com/openhub") > 0, "вебхук в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрСписка, "Скопируйте секрет"), "секрет второй раз не показывается").Равно(0);

КонецПроцедуры

