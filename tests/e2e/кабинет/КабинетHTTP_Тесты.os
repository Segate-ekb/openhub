	Ожидаем.Что(ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука))),
		"подписка на приёмник в своей сети заведена").Равно(БылоПодписок + 1);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "127.0.0.1:9443") > 0,
		"и видна в списке раздела").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура НеАдресОтклонёнUI() Экспорт
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/pools/public/settings/webhooks";
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	// строка без схемы адресом не является — создание не проходит, страница показывает ошибку
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "не-адрес-вовсе");
	Поля.Вставить("событие_0", "1");
	БылоПодписок = ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука)));
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);

	// факт важнее причины: подписка не создана
	Ожидаем.Что(Ответ.КодСостояния, "отказ отдаётся кодом 400, как в остальных домах").Равно(400);
	Ожидаем.Что(ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука))),
		"ни одной новой подписки не появилось").Равно(БылоПодписок);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "не-адрес-вовсе"), "мусор не сохранён").Равно(0);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Скопируйте секрет"), "секрет не выдан на отклонённый URL").Равно(0);
	// причина проверяется маркером, которого на обычной странице нет, — не подсказкой поля
	Маркер = "Недопустимый URL вебхука";
	Ожидаем.Что(СтрНайти(Тело(Ответ), Маркер) > 0, "показана причина отказа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), Маркер),
		"ассерт причины не пуст: на обычной странице раздела этого маркера нет").Равно(0);
КонецПроцедуры

&Тест
Процедура АдресСУправляющимиСимволамиОтклонён() Экспорт

	// «%0D%0AX-Evil:+1» доезжает до валидатора настоящими CR/LF и порвал бы строку журнала
