// Подделанный токен формы отбивается на каждой мутирующей дороге кабинета и домов настроек:
// принципал законный, идентификаторы несуществующие — токен смотрят до поиска предмета.
&Тест
Процедура ПодделанныйТокенОтбиваетсяНаЧетырнадцатиМутирующихДорогах() Экспорт

	КукаRoot = ВойтиRoot();
	КукаВладельца = Клиент.Войти("owner1", "Owner1Passw0rd");
	КукаAlice = Клиент.Войти("alice", "AlicePassw0rd");

	Дороги = Новый Массив();
	Дороги.Добавить(Дорога("/hub/settings/users", КукаRoot));
	Дороги.Добавить(Дорога("/hub/settings/groups", КукаRoot));
	Дороги.Добавить(Дорога("/pools/owned/settings/mirrors", КукаВладельца));
	Дороги.Добавить(Дорога("/pools/owned/settings/mirrors/999999/toggle", КукаВладельца));
	Дороги.Добавить(Дорога("/pools/owned/settings/mirrors/999999/sync", КукаВладельца));
	Дороги.Добавить(Дорога("/pools/owned/settings/mirrors/999999/token-off", КукаВладельца));
	Дороги.Добавить(Дорога("/pools/owned/settings/mirrors/999999/delete", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned/999999/toggle", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned/999999/sync", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned/999999/delete", КукаВладельца));
	Дороги.Добавить(Дорога("/me/settings/oidc/unlink", КукаAlice));
	Дороги.Добавить(Дорога("/me/inbox", КукаAlice));
	Дороги.Добавить(Дорога("/me/notifications", КукаAlice));

	Для Каждого Дорога_ Из Дороги Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", "деадбиф");
		Ожидаем.Что(Клиент.POSTФормы(Дорога_.Адрес, Поля, Дорога_.Кука).КодСостояния,
			"подделанный токен отбит на " + Дорога_.Адрес).Равно(403);
	КонецЦикла;

КонецПроцедуры

Функция Дорога(Знач Адрес, Знач Кука)
	Возврат Новый Структура("Адрес, Кука", Адрес, Кука);
КонецФункции

// Цель во внутренней сети — законный выбор мейнтейнера, кабинет её принимает; отвергается
// только то, что адресом не является.
&Тест
Процедура ЦельВоВнутреннейСетиПринимаетсяUI() Экспорт
