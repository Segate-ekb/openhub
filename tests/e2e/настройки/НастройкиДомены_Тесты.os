&Тест
Процедура УчастникВидитГруппуТолькоЧитая() Экспорт
	// alice — участник platform: дом виден, но менять состав нельзя (иначе участник дописал бы себе кого угодно)
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Ответ = Клиент.GETСКукой("/groups/platform/settings", КукаАлисы);
	Ожидаем.Что(Ответ.КодСостояния, "участник видит дом группы").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Добавить участника"), "участнику форма правки не показана").Равно(0);

	// токен — настоящий, со своей страницы участника: отбить форму обязан гвард правки, а не CSRF
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/me/settings/profile", КукаАлисы))));
	Поля.Вставить("логин", "bob");
	Ожидаем.Что(Клиент.POSTФормы("/groups/platform/settings/members", Поля, КукаАлисы).КодСостояния,
		"участник не меняет состав группы").Равно(403);
	Состав = Тело(Клиент.GETСКукой("/groups/platform/settings/members", Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(СтрНайти(Состав, ">bob<"), "bob в группу не попал").Равно(0);
КонецПроцедуры

