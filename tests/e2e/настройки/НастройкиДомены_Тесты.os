	Ожидаем.Что(Клиент.GET("/static/nothing.css").КодСостояния, "неизвестный файл — 404").Равно(404);
КонецПроцедуры

// Приватный пул означает, что приватны все его пакеты: страница пула, страница пакета и выдача
// .ospx закрыты так же, как JSON-часть API.

&Тест
Процедура АнонимНеВидитПриватныйПул() Экспорт

	// secret — приватный пул owner1, которого не трогает ни один другой тест
	Ответ = Клиент.GET("/pools/secret");
	Ожидаем.Что(Ответ.КодСостояния, "страница приватного пула — 404 для анонима").Равно(404);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "secret-pkg"), "список пакетов не раскрыт").Равно(0);

	// существование не раскрывается: несуществующий пул отвечает так же
	Ожидаем.Что(Клиент.GET("/pools/нетакогопула").КодСостояния, "несуществующий пул — тот же 404").Равно(404);

КонецПроцедуры

&Тест
Процедура АнонимНеВидитПакетПриватногоПула() Экспорт
	Ожидаем.Что(Клиент.GET("/pools/secret/packages/secret-pkg").КодСостояния,
		"страница пакета приватного пула — 404 для анонима").Равно(404);
КонецПроцедуры

// Этим путём ходит opm — дыра здесь означала бы утечку артефактов. Канонический адрес и вечный алиас
// проверяются ОБА: гейт стоит в общей процедуре выдачи, но регресс мог бы завести маршрут мимо неё.
&Тест
Процедура АнонимНеКачаетИзПриватногоПулаНиАдресомНиАлиасом() Экспорт

	Пары = Новый Соответствие();
	Пары.Вставить("/api/v1/pools/secret/download/list.txt", "/pools/secret/download/list.txt");
	Пары.Вставить("/api/v1/pools/secret/download/secret-pkg/secret-pkg-1.0.0.ospx",
		"/pools/secret/download/secret-pkg/secret-pkg-1.0.0.ospx");
	Пары.Вставить("/api/v1/pools/secret/download/secret-pkg/secret-pkg.ospx",
		"/pools/secret/download/secret-pkg/secret-pkg.ospx");
	Пары.Вставить("/api/v1/pools/secret/channels/stable/download/list.txt",
		"/pools/secret/channels/stable/download/list.txt");
	Пары.Вставить("/api/v1/pools/secret/channels/stable/download/secret-pkg/secret-pkg.ospx",
		"/pools/secret/channels/stable/download/secret-pkg/secret-pkg.ospx");

	Для Каждого Пара Из Пары Цикл
		Канонический = Клиент.GET(Пара.Ключ);
		Алиас = Клиент.GET(Пара.Значение);
		Ожидаем.Что(Канонический.КодСостояния, "приватный пул закрыт: " + Пара.Ключ).Равно(404);
		Ожидаем.Что(Алиас.КодСостояния, "приватный пул закрыт алиасом: " + Пара.Значение).Равно(404);
		Ожидаем.Что(СтрНайти(Тело(Канонический), "secret-pkg"),
			"имена пакетов не раскрыты: " + Пара.Ключ).Равно(0);
		Ожидаем.Что(СтрНайти(Тело(Алиас), "secret-pkg"),
			"имена пакетов не раскрыты: " + Пара.Значение).Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
