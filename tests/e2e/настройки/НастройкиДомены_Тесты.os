&Тест
Процедура ЛюдиГруппыИПровайдерыСтоятСвоимиПунктамиДерева() Экспорт

	// у каждого экрана свой пункт дерева: пользователи — раздел «Люди», группы и провайдеры
	// входа — свои разделы; прежний адрес «Людей» переехал к пользователям насовсем
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	ПроверитьПереезд("/hub/settings/people", "/hub/settings/users", КукаАдмина);

	Учётки = Тело(Клиент.GETСКукой("/hub/settings/users", КукаАдмина));
	Ожидаем.Что(АктивныйПунктДерева(Учётки), "пользователи — пункт «Люди»").Равно("/hub/settings/users");
	Группы = Тело(Клиент.GETСКукой("/hub/settings/groups", КукаАдмина));
	Ожидаем.Что(АктивныйПунктДерева(Группы), "группы — свой пункт").Равно("/hub/settings/groups");
	Ожидаем.Что(АктивныйПунктДерева(Тело(Клиент.GETСКукой("/hub/settings/providers", КукаАдмина))),
		"провайдеры стоят в своём пункте").Равно("/hub/settings/providers");

	// и два экрана различимы по заголовку вкладки
	Ожидаем.Что(СтрНайти(Учётки, "<title>Люди") > 0, "у пользователей своё имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Группы, "<title>Группы") > 0, "у групп своё имя").ЭтоИстина();

КонецПроцедуры

// Адрес активного пункта дерева разделов: пункт помечен классом tree__link--active.
Функция АктивныйПунктДерева(Знач Разметка)

	Позиция = СтрНайти(Разметка, "tree__link--active");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Голова = Лев(Разметка, Позиция);
	Начало = СтрНайти(Голова, "href=""", НаправлениеПоиска.СКонца);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Голова, Начало + 6);
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

// Пункты дерева разделов дома из отданной страницы: адрес и разметка, до корня дома (`data-house`).
Функция ПунктыДереваДома(Знач Разметка)

	Результат = Новый Массив();
	КореньДома = СтрНайти(Разметка, "data-house=");
	Если КореньДома = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Маркер = "<a href=""";
	Признак = """ class=""tree__link";
	Хвост = Сред(Разметка, КореньДома);
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 0 И СтрНачинаетсяС(Сред(Хвост, Конец), Признак) Тогда
			Закрытие = СтрНайти(Хвост, "</a>");
			Результат.Добавить(Новый Структура("Адрес, Разметка",
				Лев(Хвост, Конец - 1), ?(Закрытие > 0, Лев(Хвост, Закрытие), Хвост)));
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АдресаДереваХаба(Знач Разметка)

	Результат = Новый Массив();
	Встреченные = Новый Соответствие();
	Основа = "/hub/settings/";
	Маркер = "<a href=""";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 0 И СтрНачинаетсяС(Сред(Хвост, Конец), """ class=""tree__link") Тогда
			Адрес = Лев(Хвост, Конец - 1);
			Если СтрНачинаетсяС(Адрес, Основа) И Встреченные.Получить(Адрес) = Неопределено Тогда
				Встреченные.Вставить(Адрес, Истина);
				Результат.Добавить(Адрес);
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Тест
Процедура ПунктДереваНеВедётВПустоту() Экспорт

	// пункт дерева, открывающий страницу без единой секции, выглядит сломанным экраном.
	// Ключи разделов берутся ИЗ САМОГО дерева: раздел, которого в нём нет, недостижим
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Адреса = АдресаДереваХаба(Тело(Клиент.GETСКукой("/hub/settings", КукаАдмина)));

	Ожидаем.Что(Адреса.Количество(), "дерево дома «Хаб» отдало все свои пункты").Равно(17);

	Пустые = Новый Массив();
	Для Каждого Адрес Из Адреса Цикл
		Если Адрес = "/hub/settings/mail" Тогда
			// раздел почты заведён пустым
			Продолжить;
		КонецЕсли;
		Страница = Тело(Клиент.GETСКукой(Адрес, КукаАдмина));
		Если СтрНайти(Страница, "<section class=""section") = 0 Тогда
			Пустые.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пустые, ", "),
		"пункты дерева, ведущие на страницу без единой секции").Равно("");

КонецПроцедуры

&Тест
Процедура МутацияНаУпразднённыйАдресОтвечаетОтказомАНеРедиректом() Экспорт

	// редирект POST «как будто применилось» хуже честного отказа: вкладка со старой
	// формой ушла бы в никуда, а администратор считал бы значение изменённым
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("oshub.auth.token.cli_days", "9999");
	Отказ = Клиент.POSTФормы("/hub/settings/auth", Поля, КукаАдмина);

	Ожидаем.Что(Отказ.КодСостояния, "мутация на упразднённый адрес отбита").Равно(405);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина)), "value=""9999"""),
		"и ничего не записала").Равно(0);

