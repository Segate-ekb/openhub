	Ожидаем.Что(СтрНайти(Тело(Нет), "учётная запись не найдена") > 0,
		"отказ объяснён").ЭтоИстина();
	// экран говорит по-человечески: ни кода домена, ни текста доменного исключения
	Ожидаем.Что(СтрНайти(Тело(Нет), "role_change_"), "служебный код не показан").Равно(0);
	Ожидаем.Что(СтрНайти(Тело(Нет), "эту точку нельзя"),
		"текст доменного исключения не показан").Равно(0);

	Мусор = ПостРоли("не логин", "admin", Истина, Токен, КукаАдмина);
	Ожидаем.Что(Мусор.КодСостояния, "мусор в адресе учётки — тот же отказ").Равно(400);

	Логин = "rolebadvalue";
