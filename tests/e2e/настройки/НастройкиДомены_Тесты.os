&Тест
Процедура МутацияПулаБезCSRF403() Экспорт
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Поля = Новый Соответствие();
	Поля.Вставить("видимость", "public");
	Ожидаем.Что(Клиент.POSTФормы("/pools/owned/settings/visibility", Поля, КукаOwner).КодСостояния,
		"мутация настроек пула без CSRF отклонена").Равно(403);
КонецПроцедуры

&Тест
Процедура ЭскалацияЧерезЧужойПулОтбита() Экспорт
	// гвард пула отбивает мутацию чужого пула ДО чтения тела: пул резолвится из сущности по URL, а не из формы
	// токен — настоящий, из сессии owner1 (его свой пул): отбить форму обязан гвард, а не CSRF
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/visibility", КукаOwner))));
	Поля.Вставить("видимость", "private");
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/visibility", Поля, КукаOwner).КодСостояния,
		"эскалация на чужой пул отбита").Равно(403);
	// те же двери квоты и удаления пула: посторонний к пулу — 403 до формы
	Поля.Вставить("квота_мб", "1");
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/quota", Поля, КукаOwner).КодСостояния,
		"квота чужого пула — посторонний отбит").Равно(403);
	Поля.Вставить("операция", "пул-удалить");
	Поля.Вставить("confirmed", "1");
	Поля.Вставить("подтверждение", "public");
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/danger", Поля, КукаOwner).КодСостояния,
		"удаление чужого пула — посторонний отбит").Равно(403);
	Ожидаем.Что(Клиент.GET("/pools/public").КодСостояния, "пул цел и по-прежнему публичный").Равно(200);
КонецПроцедуры

&Тест
Процедура ВладелецМеняетВидимостьИКвотуБезJS() Экспорт

	// раздел без JS: обычная POST-форма на СВОЙ URL, ответ — редирект (PRG)
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");

	СтрВидимость = Тело(Клиент.GETСКукой("/pools/owned/settings/visibility", КукаOwner));
	Ожидаем.Что(СтрНайти(СтрВидимость, "<form class=""section__form"" method=""post"" action=""/pools/owned/settings/visibility""") > 0,
		"секция — обычная POST-форма на свой URL (работает без JS)").ЭтоИстина();
	Токен = Клиент.ТокенCSRF(СтрВидимость);
	Ожидаем.Что(СтрДлина(Токен)).Равно(64);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("видимость", "public");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/owned/settings/visibility", Поля, КукаOwner)),
		"видимость сохранена").ЭтоИстина();

	// квоту назначает админ хаба; владелец пула видит её и занятое, но не правит
	КукаАдминаКвоты = Клиент.Войти("root", "RootPassw0rd");
	ТокенКвоты = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаАдминаКвоты)));
	ПоляКвоты = Новый Соответствие();
	ПоляКвоты.Вставить("_csrf", ТокенКвоты);
	ПоляКвоты.Вставить("квота_мб", "42");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/owned/settings/quota", ПоляКвоты, КукаАдминаКвоты)),
		"квота сохранена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаАдминаКвоты)), "42") > 0,
		"новая квота отражена").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АпстримыПулаДобавляютсяИУдаляются() Экспорт

	// апстрим — свойство пула, а не его тип
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/owned/settings/upstreams";

	Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "добавить", "http://example.org/download/", "600", КукаOwner)),
		"апстрим добавлен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "example.org") > 0,
		"апстрим в списке").ЭтоИстина();

	// удаление без подтверждения ведёт на окно подтверждения и источник не трогает
	Номер = НомерИсточника(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), Раздел, "http://example.org/download/");
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner))));
	Клиент.POSTФормы(Раздел + "/" + Номер + "/delete", Поля, КукаOwner);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "example.org") > 0,
		"без подтверждения апстрим цел").ЭтоИстина();

	Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "удалить", "http://example.org/download/", "", КукаOwner)),
		"апстрим удалён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned/settings/upstreams", КукаOwner)), "example.org"),
		"апстрим исчез").Равно(0);

КонецПроцедуры

// Порядок источников задаёт мейнтейнер, и он значим — по нему идёт опрос. Выключение
// же не есть удаление: выключенный остаётся в списке со своим адресом и местом, иначе
// «убрать на время» пришлось бы делать удалением и заводить источник заново.
&Тест
Процедура ПорядокИсточниковПравитсяАВыключениеНеУдаляетИхИзСписка() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/owned/settings/upstreams";
	Первый = "http://127.0.0.1:39901/download/";
	Второй = "http://127.0.0.1:39902/download/";

	Попытка

		Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "добавить", Первый, "600", КукаOwner)),
			"первый источник заведён").ЭтоИстина();
		Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "добавить", Второй, "600", КукаOwner)),
			"второй источник заведён").ЭтоИстина();

		Порядок = ПодопытныеИсточники(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
		Ожидаем.Что(Порядок.Количество(), "оба источника в списке").Равно(2);
		Ожидаем.Что(НРег(Порядок[0]), "первым стоит заведённый первым").Равно(НРег(Первый));

		Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "вниз", Первый, "", КукаOwner)),
			"источник переставлен вниз").ЭтоИстина();
		Переставленный = ПодопытныеИсточники(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
		Ожидаем.Что(Переставленный.Количество(), "перестановка список не укоротила").Равно(2);
		Ожидаем.Что(НРег(Переставленный[0]), "наверх поднялся сосед").Равно(НРег(Второй));
		Ожидаем.Что(НРег(Переставленный[1]), "а переставленный ушёл вниз").Равно(НРег(Первый));

		// тот же адрес иным регистром — это тот же источник: заводится не второй, а правится
		// заведённый
		Ожидаем.Что(УспехМутации(
			ОперацияАпстрима(Раздел, "добавить", "HTTP://127.0.0.1:39901/download/", "900", КукаOwner)),
			"повторное заведение принято").ЭтоИстина();
		Повтор = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
		Ожидаем.Что(ПодопытныеИсточники(Повтор).Количество(),
			"второй записи на тот же адрес не завелось").Равно(2);
		Ожидаем.Что(СтрНайти(Повтор, ">900 с<") > 0, "а TTL заведённой записи обновился").ЭтоИстина();

		// выключение оставляет источник в списке, и повтор его не переворачивает
		Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "выключить", Первый, "", КукаOwner)),
			"источник выключен").ЭтоИстина();
		ОперацияАпстрима(Раздел, "выключить", Первый, "", КукаOwner);

		Выключенный = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
		Список = ПодопытныеИсточники(Выключенный);
		Ожидаем.Что(Список.Количество(), "выключенный источник из списка не исчез").Равно(2);
		Ожидаем.Что(НРег(Список[1]), "и места своего не потерял").Равно(НРег(Первый));
		Ожидаем.Что(СтрЧислоВхождений(Выключенный, "выключен вручную"),
			"выключен ровно один источник, повтор выключения его не вернул").Равно(1);

		Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "включить", Первый, "", КукаOwner)),
			"источник включён обратно").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "выключен вручную"),
			"выключенных не осталось").Равно(0);

	Исключение
		УбратьПодопытныеИсточники(Раздел, КукаOwner);
		ВызватьИсключение;
	КонецПопытки;

	УбратьПодопытныеИсточники(Раздел, КукаOwner);
	Ожидаем.Что(ПодопытныеИсточники(Тело(Клиент.GETСКукой(Раздел, КукаOwner))).Количество(),
		"удаление — отдельное действие, и оно источники убирает").Равно(0);

КонецПроцедуры

// Хаб помнит, жив ли источник, и говорит об этом там, где источниками управляют.
// Без памяти каждый запрос к упавшему источнику стоил бы ожидания, а человек, глядя
// на список, не отличал бы «лежит» от «выключен мной».
&Тест
Процедура УпавшийИсточникВиденВСостоянииИНеВыдаётсяЗаВыключенный() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/owned/settings/upstreams";
	Мёртвый = "http://127.0.0.1:39917/download/";

	Попытка

		Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "добавить", Мёртвый, "600", КукаOwner)),
			"источник заведён").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "ещё не проверялся") > 0,
			"пока про источник ничего не известно, экран так и говорит").ЭтоИстина();

		// боевой запрос выдачи честно платит одним таймаутом за упавший источник
		Промах = Клиент.GETСКукой("/api/v1/pools/owned/download/net-takogo/net-takogo-1.0.0.ospx", КукаOwner);
		Ожидаем.Что(Промах.КодСостояния,
			"пакета нет ни у пула, ни у источника").Равно(404);

		Страница = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
		Ожидаем.Что(СтрНайти(Страница, "лежит с ") > 0,
			"падение источника запомнено и показано: " + Страница).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "ещё не проверялся"),
			"«неизвестно» сменилось знанием").Равно(0);

		// «лежит» и «выключен» — две независимые вещи, и экран их не путает
		Ожидаем.Что(УспехМутации(ОперацияАпстрима(Раздел, "выключить", Мёртвый, "", КукаOwner)),
			"источник выключен рукой").ЭтоИстина();
		Выключенный = Тело(Клиент.GETСКукой(Раздел, КукаOwner));
		Ожидаем.Что(СтрНайти(Выключенный, "выключен вручную") > 0,
			"выключенный назван выключенным").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Выключенный, "лежит с "),
			"и его живость экран больше не обсуждает").Равно(0);

	Исключение
		УбратьПодопытныеИсточники(Раздел, КукаOwner);
		ВызватьИсключение;
	КонецПопытки;

	УбратьПодопытныеИсточники(Раздел, КукаOwner);

КонецПроцедуры

// Адреса источников этого набора (127.0.0.1:399xx) в порядке обхода — имена записей реестра.
Функция ПодопытныеИсточники(Знач Страница)

	Результат = Новый Массив();
	Маркер = "class=""brief__name"">";
	Хвост = Страница;

	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, "</span>");
		Если Конец > 1 Тогда
			Адрес = Лев(Хвост, Конец - 1);
			Если СтрНайти(Адрес, "127.0.0.1:399") > 0 Тогда
				Результат.Добавить(Адрес);
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Номер источника по его адресу: из адреса формы тумблера его записи. Нет такого — "".
Функция НомерИсточника(Знач Страница, Знач Раздел, Знач Адрес)

	Для Каждого Запись Из СтрРазделить(Страница, "<li class=""entry""", Ложь) Цикл
		Если СтрНайти(НРег(Запись), "brief__name"">" + НРег(Адрес) + "</span>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Маркер = "action=""" + Раздел + "/";
		Позиция = СтрНайти(Запись, Маркер);
		Если Позиция > 0 Тогда
			Остаток = Сред(Запись, Позиция + СтрДлина(Маркер));
			Возврат Лев(Остаток, СтрНайти(Остаток, "/") - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Действие над источником так, как его шлёт экран: заведение — форма окна на раздел, остальное —
// формы записи на «<номер>/<действие>»; удаление — подтверждённое.
Функция ОперацияАпстрима(Знач Раздел, Знач Операция, Знач Адрес, Знач TTL, Знач Кука)

	Страница = Тело(Клиент.GETСКукой(Раздел, Кука));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Если Операция = "добавить" Тогда
		Поля.Вставить("url", Адрес);
		Если ЗначениеЗаполнено(TTL) Тогда
			Поля.Вставить("ttl", TTL);
		КонецЕсли;
		Возврат Клиент.POSTФормы(Раздел, Поля, Кука);
	КонецЕсли;

	Номер = НомерИсточника(Страница, Раздел, Адрес);
	Если Операция = "вниз" ИЛИ Операция = "вверх" Тогда
		Поля.Вставить("сдвиг", Операция);
		Действие = "move";
	ИначеЕсли Операция = "выключить" ИЛИ Операция = "включить" Тогда
		Поля.Вставить("включить", ?(Операция = "включить", "1", "0"));
		Действие = "toggle";
	ИначеЕсли Операция = "снять-токен" Тогда
		Действие = "token-off";
	Иначе
		Поля.Вставить("confirmed", "1");
		Действие = "delete";
	КонецЕсли;
	Возврат Клиент.POSTФормы(Раздел + "/" + Номер + "/" + Действие, Поля, Кука);

КонецФункции

// Убирает подопытные источники: пул делится между тестами набора.
Процедура УбратьПодопытныеИсточники(Знач Раздел, Знач Кука)

	Для Счётчик = 1 По 10 Цикл
		Адреса = ПодопытныеИсточники(Тело(Клиент.GETСКукой(Раздел, Кука)));
		Если Адреса.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ОперацияАпстрима(Раздел, "удалить", Адреса[0], "", Кука);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ИзНастроекПулаЕстьПереходКЗеркалам() Экспорт
	// зеркалами пула управляют ИЗ ПУЛА: кабинетный обзор — не единственный вход
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Стр = Тело(Клиент.GETСКукой("/pools/owned/settings", КукаOwner));
	Ожидаем.Что(СтрНайти(Стр, "/pools/owned/settings/mirrors") > 0,
		"в дереве разделов пула есть «Зеркала»").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ЗеркалаПулаЗаводятсяВключаютсяИУдаляютсяБезJS() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Адрес = "/pools/owned/settings/mirrors";

	Пустой = Тело(Клиент.GETСКукой(Адрес, КукаOwner));
	Ожидаем.Что(СтрНайти(Пустой, "Зеркал пока нет") > 0, "на старте зеркал у пула нет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Пустой, "<form method=""post"" action=""" + Адрес + """") > 0,
		"создание — обычная POST-форма окна на свой URL (работает без JS)").ЭтоИстина();

	// интервал 1 сек: сервис поднимает его до минимального (oshub.mirror.min_interval_sec)
	Ожидаем.Что(УспехМутации(СоздатьЗеркало(Адрес, "http://127.0.0.1:9/download/", КукаOwner, "1")),
		"зеркало создано").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Адрес, КукаOwner));
	Ожидаем.Что(СтрНайти(Список, "127.0.0.1:9") > 0, "зеркало в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "opm") > 0, "режим показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, ">60 с<") > 0, "интервал поднят до минимального, а не сохранён как 1").ЭтоИстина();

	Ид = ИдентификаторПодписки(Список, Адрес);
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "идентификатор зеркала виден в адресах форм записи").ЭтоИстина();
	Ожидаем.Что(ТумблерВключён(Список, Адрес, Ид), "новое зеркало включено").ЭтоИстина();

	Ожидаем.Что(УспехМутации(ДействиеЗеркала(Адрес, Ид, "toggle", "0", КукаOwner)),
		"зеркало выключено").ЭтоИстина();
	Ожидаем.Что(ТумблерВключён(Тело(Клиент.GETСКукой(Адрес, КукаOwner)), Адрес, Ид),
		"состояние выключено").ЭтоЛожь();

	Ожидаем.Что(УспехМутации(ДействиеЗеркала(Адрес, Ид, "toggle", "1", КукаOwner)),
		"зеркало включено обратно").ЭтоИстина();

	// Проверки синка держат зеркало живым, а упавшее утверждение снимает тест до удаления.
	// Убираем за собой в любом исходе: иначе сосед по набору валится на лимите зеркал
	// сообщением, не имеющим отношения к причине.
	Попытка
		ПроверитьЗапускСинка(Адрес, Ид, КукаOwner);
	Исключение
		ДействиеЗеркала(Адрес, Ид, "delete", "", КукаOwner);
		ВызватьИсключение;
	КонецПопытки;

	Ожидаем.Что(УспехМутации(ДействиеЗеркала(Адрес, Ид, "delete", "", КукаOwner)),
		"зеркало удалено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаOwner)), "127.0.0.1:9"),
		"зеркало исчезло из списка").Равно(0);

КонецПроцедуры

// «Синхронизировать сейчас»: адрес возврата несёт известный код исхода, экран зеркала объясняет его словами.
Процедура ПроверитьЗапускСинка(Знач Адрес, Знач Ид, Знач КукаOwner)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Адрес, КукаOwner))));
	Синк = Клиент.POSTФормыБезПереходов(Адрес + "/" + Ид + "/sync", Поля, Клиент.СтрокаКукиСессии(КукаOwner));
	Ожидаем.Что(Синк.КодСостояния, "заявка принята редиректом").Равно(303);
	Ожидаем.Что(Локейшн1С(Синк), "первое нажатие по свободному зеркалу принято")
		.Равно(Адрес + "/" + Ид + "?sync=1");

	Приостановить(4000); // столько же, сколько тратит человек, глядя на страницу

	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Адрес, КукаOwner))));
	Повтор = Локейшн1С(Клиент.POSTФормыБезПереходов(Адрес + "/" + Ид + "/sync", Поля, Клиент.СтрокаКукиСессии(КукаOwner)));
	Хвост = СтрЗаменить(Повтор, Адрес + "/" + Ид, "");
	Ожидаем.Что(ИсходНазван(Хвост), "исход нажатия назван кодом, а не молчанием: " + Повтор)
		.ЭтоИстина();

	// фразы перечислены под ВСЕ коды набора выше: rejected объясняется «не принята»
	Экран = Тело(Клиент.GETСКукой(Адрес + "/" + Ид + Хвост, КукаOwner));
	Ожидаем.Что(СтрНайти(Экран, "Заявка принята") + СтрНайти(Экран, "Заявка не нужна")
			+ СтрНайти(Экран, "Заявка не принята") > 0,
		"экран состояния объясняет исход словами").ЭтоИстина();

КонецПроцедуры

// Известный набор кодов исхода заявки в адресе возврата.
Функция ИсходНазван(Знач Хвост)

	Для Каждого Код Из СтрРазделить("1,running,queued,rejected", ",") Цикл
		Если Хвост = "?sync=" + Код Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Источниками пула управляет его мейнтейнер: читатель публичного пула получает 403 (пул не скрыт),
// посторонний к чужому приватному — 404 (существование не раскрывается); ни одна форма не проходит.
&Тест
Процедура ПостороннийНеУправляетАпстримамиЧужогоПула() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", "любой");
	Поля.Вставить("url", "http://example.org/download/");
	Поля.Вставить("публикация", "0");
	Поля.Вставить("confirmed", "1");

	Для Каждого Хвост Из СтрРазделить(",/publication,/1/move,/1/toggle,/1/token-off,/1/delete", ",") Цикл
		Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/upstreams" + Хвост, Поля, КукаOwner).КодСостояния,
			"читатель публичного пула: upstreams" + Хвост + " → 403").Равно(403);
	КонецЦикла;

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Для Каждого Хвост Из СтрРазделить(",/publication,/1/delete", ",") Цикл
		Ожидаем.Что(Клиент.POSTФормы("/pools/secret/settings/upstreams" + Хвост, Поля, КукаАлисы).КодСостояния,
			"посторонний к чужому приватному: upstreams" + Хвост + " → 404").Равно(404);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЗеркалоВоВнутреннююСетьПринимаетсяUI() Экспорт

	// сеть источника хаб не судит: её выбирает администратор пула
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Адрес = "/pools/owned/settings/mirrors";

	Ответ = СоздатьЗеркало(Адрес, "http://10.1.2.3/download/", КукаOwner, "600");
	Ожидаем.Что(УспехМутации(Ответ), "интранет-зеркало заведено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаOwner)), "10.1.2.3") > 0,
		"и видно в списке").ЭтоИстина();

	УдалитьЗеркала(Адрес, КукаOwner); // пул делится между тестами набора

КонецПроцедуры

&Тест
Процедура ЛимитЗеркалНаПулСоблюдается() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Адрес = "/pools/owned/settings/mirrors";

	Для Индекс = 1 По 5 Цикл
		Ответ = СоздатьЗеркало(Адрес,
			СтрШаблон("http://127.0.0.1:90%1/download/", Формат(Индекс, "ЧГ=0; ЧН=0")),
			КукаOwner, "600");
		Ожидаем.Что(УспехМутации(Ответ), СтрШаблон("зеркало %1 создано", Индекс)).ЭтоИстина();
	КонецЦикла;

	Лишнее = СоздатьЗеркало(Адрес, "http://127.0.0.1:9099/download/", КукаOwner, "600");
	Ожидаем.Что(Лишнее.КодСостояния, "шестое зеркало отбито лимитом oshub.mirror.max_per_pool").Равно(422);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаOwner)), "127.0.0.1:9099"),
		"сверхлимитное зеркало не сохранено").Равно(0);

	УдалитьЗеркала(Адрес, КукаOwner); // пул делится между тестами набора

КонецПроцедуры

&Тест
Процедура ПостороннийНеВидитЗеркалЧужогоПула() Экспорт

	// secret — приватный пул owner1 (видимость «owned» меняет соседний тест): и раздел,
	// и его действия дают 404, существование пула не раскрывается
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(Клиент.GETСКукой("/pools/secret/settings/mirrors", КукаАлисы).КодСостояния,
		"раздел зеркал чужого приватного пула скрыт").Равно(404);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", "любой");
	Поля.Вставить("url", "http://example.org/download/");

	Ожидаем.Что(Клиент.POSTФормы("/pools/secret/settings/mirrors", Поля, КукаАлисы).КодСостояния,
		"зеркало в чужом пуле не заводится").Равно(404);
	Ожидаем.Что(Клиент.POSTФормы("/pools/secret/settings/mirrors/1/sync", Поля, КукаАлисы).КодСостояния,
		"синхронизация чужого зеркала не запускается").Равно(404);
	Ожидаем.Что(Клиент.POSTФормы("/pools/secret/settings/mirrors/1/delete", Поля, КукаАлисы).КодСостояния,
		"чужое зеркало не удаляется").Равно(404);

КонецПроцедуры

&Тест
Процедура ЧитательПулаНеУправляетЕгоЗеркалами() Экспорт

	// public виден всем, но owner1 его не администрирует: 403 (пул не скрыт), а не 404
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");

	Ожидаем.Что(Клиент.GETСКукой("/pools/public/settings/mirrors", КукаOwner).КодСостояния,
		"чужой публичный пул: раздел зеркал закрыт").Равно(403);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", "любой");
	Поля.Вставить("url", "http://example.org/download/");

	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/mirrors", Поля, КукаOwner).КодСостояния,
		"зеркало в неадминистрируемом пуле не заводится").Равно(403);
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/mirrors/1/sync", Поля, КукаOwner).КодСостояния,
		"и синхронизация не запускается").Равно(403);
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/mirrors/1/save", Поля, КукаOwner).КодСостояния,
		"и токен не правится").Равно(403);
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/mirrors/1/token-off", Поля, КукаOwner).КодСостояния,
		"и токен не снимается").Равно(403);

