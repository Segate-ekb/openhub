КонецПроцедуры

&Тест
Процедура АдминДобавляетИИсключаетУчастника() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/groups/platform/settings/members", КукаАдмина)));

	// окно «Добавить участника»: выбранная учётка — поле «логин» формы окна
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("логин", "bob");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/groups/platform/settings/members", Поля, КукаАдмина)),
		"участник добавлен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/groups/platform/settings/members", КукаАдмина)), ">bob<") > 0,
		"bob в составе").ЭтоИстина();

	// «Убрать из группы» без подтверждения не убирает: ответ ведёт на окно подтверждения
	ПоляУд = Новый Соответствие();
	ПоляУд.Вставить("_csrf", Токен);
	БезВопроса = Клиент.POSTФормы("/groups/platform/settings/members/bob/delete", ПоляУд, КукаАдмина);
	Ожидаем.Что(БезВопроса.КодСостояния, "без подтверждения — на окно").Равно(303);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/groups/platform/settings/members", КукаАдмина)), ">bob<") > 0,
		"bob на месте").ЭтоИстина();

	ПоляУд.Вставить("confirmed", "1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/groups/platform/settings/members/bob/delete", ПоляУд, КукаАдмина)),
		"участник исключён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/groups/platform/settings/members", КукаАдмина)), ">bob<"),
		"bob вне состава").Равно(0);

КонецПроцедуры

// Подбор кандидатов — в окне «Добавить участника»: строка поиска — обычная GET-форма раздела,
// которая держит окно открытым (?окно=новый), выбор — список формы окна. Без скрипта работает всё:
// окно по адресу, поиск, отправка выбора.
&Тест
Процедура ПодборКандидатовОтбираетсяСерверомИРаботаетБезJS() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/groups/platform/settings/members";
	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Раздел + "?"
		+ КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку("новый", СпособКодированияСтроки.КодировкаURL), КукаАдмина)));

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, "id=""uchastnik-novyi"""), "окно напечатано").Не_().Равно(0);
	Ожидаем.Что(СтрНайти(БезСкриптов, "<form class=""filters"" method=""get"" action=""" + Раздел + """") > 0,
		"серверный отбор — обычная GET-форма").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "name=""q""") > 0, "с полем подстроки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "value=""новый""") > 0, "поиск держит окно открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<form method=""post"" action=""" + Раздел + """") > 0,
		"выбор уходит POST-формой окна на раздел").ЭтоИстина();

	// кандидаты — варианты списка окна
	Ожидаем.Что(СтрНайти(БезСкриптов, "<option value=""bob""") > 0, "кандидат bob в выдаче").ЭтоИстина();

	// серверный отбор действительно сужает выдачу — он и нужен, когда строк больше выдачи
	Отобрано = БезТеговScript(Тело(Клиент.GETСКукой(Раздел + "?q=bob", КукаАдмина)));
	Ожидаем.Что(СтрНайти(Отобрано, "<option value=""bob""") > 0, "искомый кандидат остался").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отобрано, "<option value=""owner1"""), "прочие отсеяны сервером").Равно(0);

	Пусто = Тело(Клиент.GETСКукой(Раздел + "?q=нетакого", КукаАдмина));
	Ожидаем.Что(СтрНайти(Пусто, "ничего не найдено") > 0,
		"пустая серверная выдача объяснена").ЭтоИстина();

КонецПроцедуры

// Двери состава и связки группы стережёт гвард дома: посторонний (не участник, не админ) и
// участник без права правки получают 403 у каждой двери со своим настоящим токеном и по настоящему
// номеру сопоставления — и ничего не меняется: состав, сопоставление и политика прежние.
&Тест
Процедура ДвериГруппыНеВпускаютПостороннегоИУчастника() Экспорт

	Дом = "/groups/platform/settings";
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	// КОНТРОЛЬ: сопоставление, по чьему номеру бьют чужие, заводит админ — дверь без гварда его бы удалила
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Дом + "/oidc", КукаАдмина))));
	Поля.Вставить("издатель", "https://idp.example.com");
	Поля.Вставить("значение", "doors-guard");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Дом + "/oidc", Поля, КукаАдмина)),
		"КОНТРОЛЬ: админ сопоставление заводит").ЭтоИстина();
	Связка = Тело(Клиент.GETСКукой(Дом + "/oidc", КукаАдмина));
	Номер = НомерИзПунктаУдаления(Связка, "doors-guard");
	Ожидаем.Что(Номер, "номер сопоставления из пункта ⚙").Заполнено();
	ПолитикаБыла = ФормаПоМаркеру(Связка, "name=""политика""");
	Owner1Был = СтрНайти(Тело(Клиент.GETСКукой(Дом + "/members", КукаАдмина)), ">owner1<") > 0;
	Политика = ?(СтрНайти(ПолитикаБыла, " checked") > 0, "исключать", "оставлять");

	Чужие = Новый Массив();
	Чужие.Добавить(Клиент.Войти("bob", "BobPassw0rd"));
	Чужие.Добавить(Клиент.Войти("alice", "AlicePassw0rd"));
	Для Каждого Кука Из Чужие Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));
		Поля.Вставить("confirmed", "1");
		Поля.Вставить("логин", "owner1");
		Поля.Вставить("издатель", "https://idp.example.com");
		Поля.Вставить("значение", "chuzhoe");
		Поля.Вставить("политика", Политика);
		Двери = СтрШаблон("/members,/members/alice/delete,/oidc,/oidc/%1/delete,/oidc/policy", Номер);
		Для Каждого Дверь Из СтрРазделить(Двери, ",") Цикл
			Ожидаем.Что(Клиент.POSTФормы(Дом + Дверь, Поля, Кука).КодСостояния,
				"чужому и участнику дверь " + Дверь + " закрыта").Равно(403);
		КонецЦикла;
	КонецЦикла;

	Состав = Тело(Клиент.GETСКукой(Дом + "/members", КукаАдмина));
	Ожидаем.Что(СтрНайти(Состав, ">owner1<") > 0, "никого не добавили").Равно(Owner1Был);
	Ожидаем.Что(СтрНайти(Состав, ">alice<") > 0, "alice на месте").ЭтоИстина();
	Связка = Тело(Клиент.GETСКукой(Дом + "/oidc", КукаАдмина));
	Ожидаем.Что(НомерИзПунктаУдаления(Связка, "doors-guard"), "сопоставление цело").Равно(Номер);
	Ожидаем.Что(СтрНайти(Связка, "chuzhoe"), "чужое сопоставление не заведено").Равно(0);
	Ожидаем.Что(ФормаПоМаркеру(Связка, "name=""политика"""), "политика прежняя").Равно(ПолитикаБыла);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Связка));
	Поля.Вставить("confirmed", "1");
	Клиент.POSTФормы(СтрШаблон("%1/oidc/%2/delete", Дом, Номер), Поля, КукаАдмина);

КонецПроцедуры

&Тест
Процедура ПользовательВидитДомАккаунта() Экспорт
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Ответ = Клиент.GETСКукой("/me/settings/profile", КукаАлисы);
	Ожидаем.Что(Ответ.КодСостояния, "пользователь видит дом аккаунта").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "data-house=""account""") > 0, "каркас пометил дом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "alice") > 0, "показан объект настройки — сам аккаунт").ЭтоИстина();
КонецПроцедуры

// Человек видит в меню, где он стоит. Путь текущей страницы доезжает до обрамления через
// живой конвейер (winow → контроллер → каркас), поэтому сторож и живой: на доме адрес
// берётся от активного раздела, на каталоге — от самого запроса.
&Тест
Процедура ТекущаяДорогаПодсвеченаНаЖивыхЭкранах() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/hub/settings/pools", КукаАдмина))),
		"в доме хаба горит «Хаб» группы настроек и только он").Равно("Хаб");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/me/settings/profile", КукаАлисы))),
		"в доме аккаунта — «Аккаунт»").Равно("Аккаунт");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/me", КукаАлисы))),
		"и в кабинете, первом разделе этого дома, — он же").Равно("Аккаунт");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages", КукаАлисы))),
		"на каталоге — «Каталог»").Равно("Каталог");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages?mine=1", КукаАлисы))),
		"на каталоге с отбором «мои» — «Мои пакеты», а не «Каталог»").Равно("Мои пакеты");
	// подсветка узнаёт свой параметр среди соседей, а не по всей строке запроса
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages?mine=1&page=1", КукаАлисы))),
		"соседний параметр отбор «мои» не сбивает").Равно("Мои пакеты");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/packages?page=1&q=win", КукаАлисы))),
		"а без отбора горит «Каталог», сколько бы параметров ни пришло").Равно("Каталог");
	Ожидаем.Что(ПодписиАктивныхДорог(Тело(Клиент.GETСКукой("/me/notifications", КукаАлисы))),
		"на ленте — «Уведомления», а не «Аккаунт»").Равно("Уведомления");

КонецПроцедуры

// Разделы дома доезжают до единого меню отдельной секцией под именем дома. Это не украшение:
// на узком экране колонка разделов не показывается вовсе, и другой дороги из раздела в раздел
// с телефона нет. Дом ЖИВОЙ — разделы собирает он сам, а не тест.
&Тест
Процедура РазделыДомаДоезжаютДоЕдиногоМеню() Экспорт

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = Тело(Клиент.GETСКукой("/me/settings/profile", КукаАлисы));
	Панель = ПанельЕдиногоМеню(Страница);

	Ожидаем.Что(Панель <> "", "единое меню на экране дома печатается").ЭтоИстина();
	Ожидаем.Что(ЗаголовокДома(Страница) <> "", "у дома есть заголовок").ЭтоИстина();
	// секция названа общим именем дома, без логина: логин в шторке уже стоит блоком учётки
	Ожидаем.Что(ПодписьРазделовЭкрана(Панель),
		"разделы дома названы в меню своей секцией — общим именем дома").Равно("Настройки аккаунта");
	Ожидаем.Что(СтрНайти(ЗаголовокДома(Страница), "alice") > 0,
		"КОНТРОЛЬ: заголовок дома на странице — с логином").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "href=""/me/settings/tokens""") > 0,
		"соседний раздел дома достижим прямо из меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "aria-current=""true""") > 0,
		"а текущий раздел в меню помечен").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы).КодСостояния,
		"дорога из меню ведёт на живой экран").Равно(200);

	// на экране без своих разделов секции нет: заголовок над пустотой обещает пункты,
	// которых там не будет
	Ожидаем.Что(СтрНайти(ПанельЕдиногоМеню(Тело(Клиент.GETСКукой("/packages", КукаАлисы))),
		"hubmenu__section--screen"), "на публичном каталоге секции разделов нет").Равно(0);

КонецПроцедуры

// Кабинет — первый раздел дома «Аккаунт» и живёт на /me: вход в дом /me/settings и адрес
// раздела под ним уводят туда же, и сохранённые ссылки на оба адреса открывают кабинет.
&Тест
Процедура ВходВДомАккаунтаВедётВКабинет() Экспорт

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	ПроверитьРедирект("/me/settings", "/me", КукаАлисы);
	ПроверитьРедирект("/me/settings/office", "/me", КукаАлисы);

	Для Каждого Адрес Из СтрРазделить("/me,/me/settings", ",") Цикл

		Ответ = Клиент.GETСКукой(Адрес, КукаАлисы);
		Ожидаем.Что(Ответ.КодСостояния, Адрес + " открывается").Равно(200);

		Колонка = КолонкаРазделов(Тело(Ответ));
		Ожидаем.Что(ПервыйРаздел(Колонка), Адрес + ": первой строкой разделов дома стоит кабинет")
			.Равно("/me|Кабинет");
		Ожидаем.Что(РазделыАктивные(Колонка), Адрес + ": и открыт именно он").Равно("Кабинет");
		Ожидаем.Что(СтрНайти(Колонка, "href=""/me/settings/profile""") > 0,
			Адрес + ": профиль — следующим разделом того же дома").ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОбычныйНеВидитВходаВНастройкиХаба() Экспорт
	// доменная граница в UI: у обычного пользователя нет входа в дом хаба, у админа — есть
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
