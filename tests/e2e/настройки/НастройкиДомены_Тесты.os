&Тест
Процедура ПрикладнаяНастройкаПравитсяИзUIИПопадаетВАудитСАвторомИзСессии() Экспорт

	// прикладная настройка правится из UI, действует сразу и доезжает до экрана журнала
	// через файл лога; АВТОР берётся ИЗ СЕССИИ — литеральный принципал в контроллере
	// покрасит эту строку
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("oshub.auth.token.cli_days", "4321");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/hub/settings/login", Поля, КукаАдмина)),
		"форма раздела приняла изменение").ЭтоИстина();

	Стр = Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина));
	Ожидаем.Что(СтрНайти(Стр, "value=""4321""") > 0, "новое значение действует сразу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр,
		"data-setting=""oshub.auth.token.cli_days"" data-source=""database""") > 0,
		"источник значения — база").ЭтоИстина();

	// строка журнала целиком: кто · что сделал · с чем — в соседних ячейках одной строки
	Журнал = Тело(Клиент.GETСКукой("/hub/settings/audit", КукаАдмина));
	Ожидаем.Что(СтрНайти(Журнал,
		"data-label=""Кто"">root</td><td data-label=""Действие"">настройка.изменена</td><td data-label=""Объект"">настройка/oshub.auth.token.cli_days</td>") > 0,
		"в аудите автор — вошедший администратор, а не литерал").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбросУбираетВведённоеРукамиЗначение() Экспорт

	// «Сбросить», который ничего не удаляет, выглядел бы работающим: проверяем оба конца — значение появилось и исчезло
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/maintenance", КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("oshub.ui.audit_page_size", "42");
	Клиент.POSTФормы("/hub/settings/maintenance", Поля, КукаАдмина);

	Стр = Тело(Клиент.GETСКукой("/hub/settings/maintenance", КукаАдмина));
	Ожидаем.Что(СтрНайти(Стр,
		"data-setting=""oshub.ui.audit_page_size"" data-source=""database""") > 0,
		"значение введено руками и лежит в базе").ЭтоИстина();

	Сброс = Новый Соответствие();
	Сброс.Вставить("_csrf", Клиент.ТокенCSRF(Стр));
	Сброс.Вставить("операция", "сбросить");
	Сброс.Вставить("ключ", "oshub.ui.audit_page_size");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/hub/settings/maintenance", Сброс, КукаАдмина)),
		"сброс принят").ЭтоИстина();

	Стр = Тело(Клиент.GETСКукой("/hub/settings/maintenance", КукаАдмина));
	Ожидаем.Что(СтрНайти(Стр,
		"data-setting=""oshub.ui.audit_page_size"" data-source=""default""") > 0,
		"после сброса действует дефолт из кода").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "value=""20""") > 0, "и это именно значение по умолчанию").ЭтоИстина();

КонецПроцедуры

// «Почему тут это» экран отвечает у каждого значения отдельно. Общая на раздел плашка
// выглядела бы работающей ровно до первой правки: человек правит одну настройку, а экран
// объявляет базой весь раздел — и дальше администратор ищет несуществующие записи.
&Тест
Процедура ИсточникЗначенияСвойУКаждогоИСледуетЗаПравкойЭтогоЖеЗначения() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/hub/settings/login";
	Ключ = "oshub.auth.registration.mode";

	Страница = Тело(Клиент.GETСКукой(Раздел, КукаАдмина));
	ДоПравки = ИсточникиРаздела(Страница);
	Ожидаем.Что(ДоПравки.Количество() > 1,
		"самотест: раздел показывает не одно значение, есть чему разъехаться").ЭтоИстина();
	Ожидаем.Что(ДоПравки.Получить(Ключ), "режим регистрации пока действует умолчанием хаба")
		.Равно("default");

	// у каждого ПОКАЗАННОГО значения раздела напечатан источник: поле без плашки оставляет
	// человека гадать, откуда взялось то, что он видит
	Для Каждого Имя Из ИменаНастроекНаСтранице(Страница) Цикл
		Ожидаем.Что(ДоПравки.Получить(Имя) <> Неопределено,
			СтрШаблон("у значения %1 напечатан его источник", Имя)).ЭтоИстина();
	КонецЦикла;

	Попытка

		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
		Поля.Вставить(Ключ, "invite");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаАдмина)),
			"режим регистрации введён здесь").ЭтоИстина();

		ПослеПравки = ИсточникиРаздела(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)));
		Ожидаем.Что(ПослеПравки.Получить(Ключ), "введённое здесь названо базой").Равно("database");
		Для Каждого КиЗ Из ДоПравки Цикл
			Если КиЗ.Ключ = Ключ Тогда
				Продолжить;
			КонецЕсли;
			Ожидаем.Что(ПослеПравки.Получить(КиЗ.Ключ),
				СтрШаблон("источник %1 за соседним не поехал", КиЗ.Ключ)).Равно(КиЗ.Значение);
		КонецЦикла;

	Исключение
		СброситьКлюч(Раздел, Ключ, КукаАдмина);
		ВызватьИсключение;
	КонецПопытки;

	СброситьКлюч(Раздел, Ключ, КукаАдмина);

	// источник — производная, а не отдельная настройка: запись убрали, надпись поменялась сама
	Ожидаем.Что(ИсточникиРаздела(Тело(Клиент.GETСКукой(Раздел, КукаАдмина))).Получить(Ключ),
		"после сброса записи источником снова названо умолчание").Равно("default");

КонецПроцедуры

// Плашки источников страницы: ключ настройки -> «config» | «database» | «default».
Функция ИсточникиРаздела(Знач Страница)

	Результат = Новый Соответствие();
	МаркерКлюча = "data-setting=""";
	МаркерИсточника = """ data-source=""";
	Хвост = Страница;

	Позиция = СтрНайти(Хвост, МаркерКлюча);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(МаркерКлюча));
		КонецКлюча = СтрНайти(Хвост, МаркерИсточника);
		ГраницаТега = СтрНайти(Хвост, ">");
		Если КонецКлюча > 0 И (ГраницаТега = 0 ИЛИ КонецКлюча < ГраницаТега) Тогда
			Ключ = Лев(Хвост, КонецКлюча - 1);
			Остаток = Сред(Хвост, КонецКлюча + СтрДлина(МаркерИсточника));
			КонецИсточника = СтрНайти(Остаток, """");
			Если КонецИсточника > 1 Тогда
				Результат.Вставить(Ключ, Лев(Остаток, КонецИсточника - 1));
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, МаркерКлюча);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ключи настроек, у которых на странице есть поле ввода: это и есть показанные значения.
Функция ИменаНастроекНаСтранице(Знач Страница)

	Найденные = Новый Соответствие();
	Маркер = "name=""oshub.";
	Хвост = Страница;

	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Найденные.Вставить("oshub." + Лев(Хвост, Конец - 1), Истина);
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого КиЗ Из Найденные Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Убирает введённое руками значение ключа: хаб у набора один на все тесты.
Процедура СброситьКлюч(Знач Раздел, Знач Ключ, Знач Кука)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("операция", "сбросить");
	Поля.Вставить("ключ", Ключ);
	Клиент.POSTФормы(Раздел, Поля, Кука);

КонецПроцедуры

// Опечатка в конфигурации инсталляции не превращает хаб в набор страниц с ошибкой:
// негодное значение отбрасывается в пользу следующего источника — но не молча, оператор
// узнаёт о нём из журнала. Хаб поднимается со сломанным ключом, как поднялся бы у того,
// кто ошибся в переменной окружения.
&Тест
Процедура НегодноеЗначениеКонфигурацииНеРонитСтраницуИВидноВЖурнале() Экспорт

	Подопытный = Новый ЭкземплярХаба(90);
	Подопытный.ФайловаяБаза("openhub-негодная-настройка");
	// администратор нужен, чтобы хаб отдавал витрину, а не уводил на онбординг
	Подопытный.Среда("OSHUB_ADMIN_LOGIN", "brokenadmin");
	Подопытный.Среда("OSHUB_ADMIN_PASSWORD", "BrokenSecret123");
	// цветом это не является: значение не пройдёт ни типизацию, ни валидатор
	Подопытный.Среда("OSHUB_UI_ACCENT", "red;}html{display:none");

	Попытка

		Подопытный.Запустить();
		Подопытный.ДождатьсяОнбординга();

		Ответ = Новый КлиентХаба(Подопытный, 20).GET("/packages");
		Ожидаем.Что(Ответ.КодСостояния, "страница отдана, а не заменена ошибкой").Равно(200);

		Страница = Ответ.ПолучитьТелоКакСтроку();
		Ожидаем.Что(СтрНайти(Страница, "токены-темы") > 0,
			"самотест: оформление на странице собрано").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "display:none"),
			"негодное значение на страницу не пролезло").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, Новый ТокеныТемы().Переменные()) > 0,
			"действует следующий источник — акцент кита").ЭтоИстина();

		// про каждое отброшенное значение оператор читает строку резолвера: ключ и причина.
		// Без неё негодная настройка проглатывается молча — и хаб работает не так, как
		// написано в его же конфигурации
		Журнал = Подопытный.Дамп();
		Ожидаем.Что(СтрНайти(Журнал, "setting oshub.ui.accent: value from config rejected") > 0,
			"отброшенное значение названо в журнале ключом и причиной: " + Лев(Журнал, 4000))
			.ЭтоИстина();

	Исключение
		Подопытный.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Подопытный.Остановить();

КонецПроцедуры

// Граница продукта, а не придирка формы: за префиксом пути хаб жить не обещает, и адрес
// инсталляции — основа, из которой собираются redirect_uri провайдера, образец конфига opm
// и ссылки писем. Валидатор вида «адрес» до сегодня не был покрыт ничем.
&Тест
Процедура АдресИнсталляцииПринимаетОсновуХостаИОтвергаетПуть() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/hub/settings/identity";
	Ключ = "oshub.instance.url";

	Страница = Тело(Клиент.GETСКукой(Раздел, КукаАдмина));
	Ожидаем.Что(СтрНайти(Страница, "name=""" + Ключ + """") > 0,
		"самотест: адрес инсталляции правится на этом экране").ЭтоИстина();

	Попытка

		// путь отвергается с названной причиной, а не обрезается молча
		Отказ = ЗадатьАдресИнсталляции(Раздел, "https://tools.corp/hub", КукаАдмина);
		Ожидаем.Что(Отказ.КодСостояния, "адрес с путём не принят").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Отказ), "без пути") > 0,
			"причина названа: " + Тело(Отказ)).ЭтоИстина();
		Ожидаем.Что(ИсточникиРаздела(Тело(Клиент.GETСКукой(Раздел, КукаАдмина))).Получить(Ключ),
			"отвергнутый адрес не записан").Равно("default");

		// а основа со схемой, хостом и портом — законный адрес инсталляции
		Ожидаем.Что(УспехМутации(ЗадатьАдресИнсталляции(Раздел, "https://tools.corp:8443", КукаАдмина)),
			"схема, хост и порт приняты").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)), "https://tools.corp:8443") > 0,
			"и адрес виден в поле").ЭтоИстина();

	Исключение
		СброситьКлюч(Раздел, Ключ, КукаАдмина);
		ВызватьИсключение;
	КонецПопытки;

	СброситьКлюч(Раздел, Ключ, КукаАдмина);

КонецПроцедуры

Функция ЗадатьАдресИнсталляции(Знач Раздел, Знач Адрес, Знач Кука)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("oshub.instance.url", Адрес);
	Возврат Клиент.POSTФормы(Раздел, Поля, Кука);

КонецФункции

// Администратор объявляет хаб известным opm формой «Основного» — и тот же процесс
// отдаёт страницу пакета основного публичного пула и главную уже без прописки в opm.cfg.
// Кэш страниц прежний ответ не держит: метка до правки не даёт 304 на странице после неё.
// Образец узнаётся по списку серверов, который он прописывает: путь выдачи пула на странице
// пакета есть и у кнопки скачивания.
&Тест
Процедура ХабИзвестныйOpmСнимаетПропискуОсновногоПулаБезРестарта() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/hub/settings/identity";
	Ключ = "oshub.instance.opm_default_hub";
	Пакет = "/pools/public/packages/alice-pkg";
	УстановкаЧерезOpmCfg = "opm install -m public alice-pkg";
	ОбразецНастройки = "СервераПакетов";

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаАдмина)), "name=""" + Ключ + """") > 0,
		"самотест: настройка правится на этом экране").ЭтоИстина();

	До = Клиент.GET(Пакет);
	МеткаДо = Клиент.ЗаголовокОтвета(До, "ETag");
	СтраницаДо = Тело(До);
	Ожидаем.Что(СтрНайти(СтраницаДо, "opm install alice-pkg") > 0,
		"КОНТРОЛЬ: пул public основной — команда шапки короткая").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтраницаДо, УстановкаЧерезOpmCfg) > 0,
		"КОНТРОЛЬ: без настройки карточка записи в opm.cfg на странице есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/")), ОбразецНастройки) > 0,
		"КОНТРОЛЬ: и образец opm.cfg на главной").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, КукаАдмина))));
	Поля.Вставить(Ключ, "1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаАдмина)),
		"форма «Основного» приняла флаг").ЭтоИстина();

	Попытка

		После = Клиент.GET(Пакет, Клиент.Заголовок("If-None-Match", МеткаДо));
		Ожидаем.Что(После.КодСостояния, "метка прежней страницы больше не годится").Равно(200);
		Страница = Тело(После);
		Ожидаем.Что(СтрНайти(Страница, УстановкаЧерезOpmCfg), "карточки записи в opm.cfg нет").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, ОбразецНастройки), "образца opm.cfg на странице нет").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, "opm install alice-pkg") > 0,
			"команда установки на месте").ЭтоИстина();

		Главная = Тело(Клиент.GET("/"));
		Ожидаем.Что(СтрНайти(Главная, ОбразецНастройки), "образца opm.cfg на главной нет").Равно(0);
		Ожидаем.Что(СтрНайти(Главная, "opm install ") > 0,
			"а образец команды установки остался").ЭтоИстина();

	Исключение
		СброситьКлюч(Раздел, Ключ, КукаАдмина);
		ВызватьИсключение;
	КонецПопытки;

	СброситьКлюч(Раздел, Ключ, КукаАдмина);

	Ожидаем.Что(СтрНайти(Тело(Клиент.GET(Пакет)), УстановкаЧерезOpmCfg) > 0,
		"сброс вернул карточку записи в opm.cfg").ЭтоИстина();

КонецПроцедуры

// Экран хранилища читается человеком: бэкенд назван словами, место — единицами, имён ключей нет.
&Тест
Процедура ЭкранХранилищаРассказываетСостояниеСловами() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Стр = Тело(Клиент.GETСКукой("/hub/settings/storage", КукаАдмина));

	Ожидаем.Что(СтрНайти(Стр, "Файловая система сервера") > 0,
		"бэкенд назван словами, а не значением ключа: " + ВыдержкаСекции(Стр)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Занято ") > 0,
		"занятое место названо: " + Стр).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, " Б") > 0 ИЛИ СтрНайти(Стр, "КБ") > 0 ИЛИ СтрНайти(Стр, "МБ") > 0,
		"и названо единицами, а не числом байтов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "не ограничен") > 0,
		"потолок объёма по умолчанию назван словами").ЭтоИстина();

	// полей ввода на экране нет: править в хранилище нечего
	Ожидаем.Что(СтрНайти(Стр, "<input"), "полей ввода в «Хранилище» нет").Равно(0);
	// имена ключей содержанием экрана не являются — только подпись мелким шрифтом
	Ожидаем.Что(СтрНайти(Стр, "oshub.storage.root"),
		"имени ключа в содержании экрана нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "OSHUB_STORAGE_ROOT") > 0,
		"а переменная окружения подписана — тому, кто пойдёт править конфигурацию").ЭтоИстина();

КонецПроцедуры

// Недоступность хранилища была не видна из интерфейса вовсе: лежащий S3 выглядел пустым.
// Экран обязан сказать «Отвечает» — и сказать это по БОЕВОМУ обращению, а не по тому,
// что хаб только что поднялся: выдача просит у хранилища артефакт засеянной версии,
// и его ответ «нет» слышит страж.
&Тест
Процедура ЭкранХранилищаНазываетЕгоДоступность() Экспорт

	Выдача = Клиент.GET("/api/v1/pools/public/download/alice-pkg/alice-pkg-1.0.0.ospx");
	Ожидаем.Что(Выдача.КодСостояния,
		"версия засеяна в реестр, а файла в хранилище нет — выдача спросила хранилище"
		+ " и получила «нет»").Равно(404);

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Стр = Тело(Клиент.GETСКукой("/hub/settings/storage", КукаАдмина));

	Ожидаем.Что(СтрНайти(Стр, "Отвечает") > 0,
		"ответившее боевому вызову хранилище названо отвечающим: "
			+ ВыдержкаСекции(Стр)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Не отвечает"),
		"работающее хранилище лежащим не объявляется: " + ВыдержкаСекции(Стр)).Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "Ещё не проверялось"),
		"и не выдаётся за непроверенное: " + ВыдержкаСекции(Стр)).Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "Хаб проверяет хранилище сам, каждые ") > 0,
		"и сказано, что состояние хаб снимает сам, с названным периодом").ЭтоИстина();

КонецПроцедуры

// Страница от заголовка секции хранилища — для сообщения упавшей проверки.
Функция ВыдержкаСекции(Знач Страница)
	Начало = СтрНайти(Страница, "section__head");
	Возврат ?(Начало = 0, Лев(Страница, 800), Сред(Страница, Начало, 2200));
КонецФункции

// Раздел, в котором править нечего, POST не принимает вовсе — форме там неоткуда взяться.
&Тест
Процедура ЭкранХранилищаНеПринимаетФорму() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина))));
	Поля.Вставить("oshub.storage.root", "/tmp/подмена");

	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/storage", Поля, КукаАдмина).КодСостояния,
		"раздел без правимых значений POST не принимает").Равно(405);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/hub/settings/storage", КукаАдмина)), "/tmp/подмена"),
		"и ничего не записал").Равно(0);

КонецПроцедуры

// Подтверждение адреса, выключенное конфигурацией (OSHUB_AUTH_EMAIL_CONFIRM_ENABLED=false), видно
// в разделе «Почта» на странице живого хаба, а не пропадает с неё.
&Тест
Процедура ЗанятаяКонфигомНастройкаВиднаНаЭкранеПочты() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Стр = Тело(Клиент.GETСКукой("/hub/settings/mail", КукаАдмина));

	Ожидаем.Что(СтрНайти(Стр, "Подтверждение адреса письмом") > 0,
		"подпись переключателя осталась на экране: " + ВыдержкаСекции(Стр)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр,
		"data-setting=""oshub.auth.email.confirm.enabled"" data-source=""config""") > 0,
		"настройка на своём месте и названа заданной конфигурацией").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "OSHUB_AUTH_EMAIL_CONFIRM_ENABLED") > 0,
		"названа переменная, которую надо убрать, чтобы вернуть правку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "снова станет редактируемым") > 0,
		"и сказано, что после этого будет").ЭтоИстина();

	// править её отсюда всё равно нельзя: поля с именем ключа на странице нет
	Ожидаем.Что(СтрНайти(Стр, "name=""oshub.auth.email.confirm.enabled"""),
		"поля правки занятой настройке не досталось").Равно(0);

КонецПроцедуры

// Пароль SMTP задаётся с экрана и не выходит ни одной поверхностью: форма раздела «Почта»,
// страница после сохранения, журнал аудита, вывод процесса хаба.
&Тест
Процедура ЗаданныйПарольSMTPНеВозвращаетсяНиЭкраномНиАудитомНиЛогом() Экспорт

	Секрет = "Smtp-Pass-4f2a9d7b";
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/mail", КукаАдмина))));
	Поля.Вставить("oshub.mail.smtp.password", Секрет);
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/hub/settings/mail", Поля, КукаАдмина)),
		"пароль SMTP принят формой").ЭтоИстина();

	// на странице секрет ищется ЦЕЛИКОМ: и поле ввода, и ENV-сниппет печатаются здесь же
	Страница = Тело(Клиент.GETСКукой("/hub/settings/mail", КукаАдмина));
	Ожидаем.Что(СтрНайти(Страница,
		"data-setting=""oshub.mail.smtp.password"" data-source=""database""") > 0,
		"самотест: пароль действительно сохранён, страница судит заданное значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, Секрет),
		"заданный пароль не возвращается страницей настроек").Равно(0);

	Журнал = Тело(Клиент.GETСКукой("/hub/settings/audit", КукаАдмина));
	Ожидаем.Что(СтрНайти(Журнал,
		"data-label=""Действие"">настройка.изменена</td><td data-label=""Объект"">настройка/oshub.mail.smtp.password</td>") > 0,
		"самотест: правка секрета дошла до журнала аудита").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, Секрет),
		"в деталях аудита секрет идёт маской, а не значением").Равно(0);

	Вывод = Хаб.Дамп();
	Ожидаем.Что(ЗначениеЗаполнено(Вывод), "самотест: журнал процесса хаба прочитан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вывод, Секрет), "в журнал приложения секрет не идёт вовсе").Равно(0);

КонецПроцедуры

// Поле секрета браузер отправляет пустым всегда — оно и открывается пустым. Прими сервер
// эту пустоту за «стереть», и администратор терял бы пароль SMTP каждый раз, когда правит
// соседнее поле того же раздела: почта отваливалась бы после сохранения формы, которую
// человек считает не относящейся к паролю. Стирание — отдельное действие сброса.
&Тест
Процедура ПустоеПолеСекретаОставляетПарольSMTPНаМесте() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/hub/settings/mail";

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, КукаАдмина))));
	Поля.Вставить("oshub.mail.smtp.password", "Smtp-Pass-7c1e0a53");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаАдмина)),
		"пароль SMTP задан формой раздела").ЭтоИстина();

	Задано = Тело(Клиент.GETСКукой(Раздел, КукаАдмина));
	Ожидаем.Что(СтрНайти(Задано, "Значение задано") > 0,
		"самотест: раздел говорит, что секрет теперь задан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Задано, "value=""Smtp-Pass-7c1e0a53"""),
		"и в поле его не возвращает — оно открывается пустым").Равно(0);

	Попытка

		// раздел сохраняется ровно так, как его отправит браузер: поле секрета пустое,
		// соседнее поле изменено
		Повтор = Новый Соответствие();
		Повтор.Вставить("_csrf", Клиент.ТокенCSRF(Задано));
		Повтор.Вставить("oshub.mail.smtp.password", "");
		Повтор.Вставить("oshub.mail.smtp.user", "почтальон-пустого-поля");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Повтор, КукаАдмина)),
			"раздел сохранён с пустым полем секрета").ЭтоИстина();

		ПослеПустого = Тело(Клиент.GETСКукой(Раздел, КукаАдмина));
		Ожидаем.Что(СтрНайти(ПослеПустого, "почтальон-пустого-поля") > 0,
			"самотест: сохранение дошло до раздела — соседнее поле изменилось").ЭтоИстина();
		Ожидаем.Что(СтрНайти(ПослеПустого, "Значение задано") > 0,
			"пустое поле секрета означает «оставить как есть», а не «стереть»").ЭтоИстина();

		// а стирает значение отдельное действие сброса — иначе «задано» ничего не значило бы
		Сброс = Новый Соответствие();
		Сброс.Вставить("_csrf", Клиент.ТокенCSRF(ПослеПустого));
		Сброс.Вставить("операция", "сбросить");
		Сброс.Вставить("ключ", "oshub.mail.smtp.password");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Сброс, КукаАдмина)), "сброс принят").ЭтоИстина();

		ПослеСброса = Тело(Клиент.GETСКукой(Раздел, КукаАдмина));
		Ожидаем.Что(СтрНайти(ПослеСброса, "Значение не задано") > 0,
			"сброс стёр секрет — и это единственный путь его стереть").ЭтоИстина();

	Исключение
		ВернутьПочтуКУмолчанию(КукаАдмина, Раздел);
		ВызватьИсключение;
	КонецПопытки;

	ВернутьПочтуКУмолчанию(КукаАдмина, Раздел);

КонецПроцедуры

// Раздел «Почта» — к умолчанию: хаб у набора общий.
Процедура ВернутьПочтуКУмолчанию(Знач Кука, Знач Раздел)

	Для Каждого Ключ Из СтрРазделить("oshub.mail.smtp.user,oshub.mail.smtp.password", ",") Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
		Поля.Вставить("операция", "сбросить");
		Поля.Вставить("ключ", Ключ);
		Клиент.POSTФормы(Раздел, Поля, Кука);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НастройкиДоставкиЖивутНаЭкранеПодписок() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	// чтение адреса блока уводит к хозяину: своего экрана у доставки нет; дорога записи одна —
	// «webhooks/delivery», прежний адрес блока POST не принимает
	ПроверитьРедирект("/hub/settings/delivery", "/hub/settings/webhooks", КукаАдмина);
	Прежняя = Новый Соответствие();
	Прежняя.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаАдмина))));
	Прежняя.Вставить("oshub.webhooks.allow_insecure", "1");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/delivery", Прежняя, КукаАдмина).КодСостояния,
		"прежний адрес блока POST не принимает").Равно(405);

	Подписки = Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаАдмина));

	// разрешение http — решение администратора: поле стоит прямо на экране подписок.
	// Рубильник доставки этому хабу задан конфигурацией, и поля у него нет
	Ожидаем.Что(СтрНайти(Подписки, "name=""oshub.webhooks.allow_insecure""") > 0,
		"разрешение http правится на экране подписок").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Подписки, "name=""oshub.webhooks.delivery_enabled"""),
		"форсированному конфигом рубильнику поля не досталось").Равно(0);
	Ожидаем.Что(СтрНайти(Подписки, "data-setting=""oshub.webhooks.max_queue"""),
		"чисел доставки на экране нет — их задаёт разворачивающий").Равно(0);

КонецПроцедуры

// Прокси до Bot API задаётся там же, где остальная доставка; секрет проходит форму, страницу
// после сохранения и журнал аудита.
&Тест
Процедура ПроксиTelegramЗадаётсяНаЭкранеПодписокАПарольНеВозвращается() Экспорт

	Секрет = "Proxy-Pass-6b3d81ac";
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Экран = "/hub/settings/webhooks";
	Блок = "/hub/settings/webhooks/delivery";

	Страница = Тело(Клиент.GETСКукой(Экран, КукаАдмина));
	Для Каждого Ключ Из СтрРазделить(КлючиПроксиTelegram(), ",") Цикл
		Ожидаем.Что(СтрНайти(Страница, "name=""" + Ключ + """") > 0,
			"поле " + Ключ + " правится на экране подписок").ЭтоИстина();
	КонецЦикла;

	Попытка

		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
		Поля.Вставить("oshub.webhooks.telegram.proxy.host", "proxy.example.ru");
		Поля.Вставить("oshub.webhooks.telegram.proxy.port", "8080");
		Поля.Вставить("oshub.webhooks.telegram.proxy.user", "оператор");
		Поля.Вставить("oshub.webhooks.telegram.proxy.password", Секрет);
		Принят = Клиент.POSTФормы(Блок, Поля, КукаАдмина);
		Ожидаем.Что(УспехМутации(Принят), "прокси Telegram принят формой спойлера доставки").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Принят, "Location"), Секрет),
			"пароль не уходит в адрес ответа").Равно(0);

		Сохранено = Тело(Клиент.GETСКукой(Экран, КукаАдмина));
		Ожидаем.Что(СтрНайти(Сохранено, "value=""proxy.example.ru""") > 0,
			"сервер прокси вернулся в поле").ЭтоИстина();
		Ожидаем.Что(ИсточникНастройки(Сохранено, "oshub.webhooks.telegram.proxy.password"),
			"самотест: пароль действительно сохранён").Равно("database");
		Ожидаем.Что(СтрНайти(Сохранено, Секрет),
			"а сам пароль страница не возвращает — поле открывается пустым").Равно(0);

		Журнал = Тело(Клиент.GETСКукой("/hub/settings/audit", КукаАдмина));
		Ожидаем.Что(СтрНайти(Журнал,
			"data-label=""Действие"">настройка.изменена</td><td data-label=""Объект"">настройка/oshub.webhooks.telegram.proxy.password</td>") > 0,
			"самотест: правка секрета дошла до журнала аудита").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Журнал, Секрет),
			"в деталях аудита пароль прокси идёт маской, а не значением").Равно(0);

		Повтор = Новый Соответствие();
		Повтор.Вставить("_csrf", Клиент.ТокенCSRF(Сохранено));
		Повтор.Вставить("oshub.webhooks.telegram.proxy.port", "8080");
		Повтор.Вставить("oshub.webhooks.telegram.proxy.password", "");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Блок, Повтор, КукаАдмина)), "повтор с пустым паролем принят")
			.ЭтоИстина();
		Ожидаем.Что(ИсточникНастройки(Тело(Клиент.GETСКукой(Экран, КукаАдмина)),
			"oshub.webhooks.telegram.proxy.password"), "пустое поле пароль не стёрло").Равно("database");

		Негодный = Новый Соответствие();
		Негодный.Вставить("_csrf", Клиент.ТокенCSRF(Сохранено));
		Негодный.Вставить("oshub.webhooks.telegram.proxy.port", "70000");
		Ожидаем.Что(Клиент.POSTФормы(Блок, Негодный, КукаАдмина).КодСостояния,
			"порт вне границ — отказ, а не «сохранено»").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Экран, КукаАдмина)), "value=""8080""") > 0,
			"и прежний порт остался на месте").ЭтоИстина();

	Исключение
		ВернутьПроксиTelegramКУмолчанию(КукаАдмина, Экран, Блок);
		ВызватьИсключение;
	КонецПопытки;

	ВернутьПроксиTelegramКУмолчанию(КукаАдмина, Экран, Блок);

КонецПроцедуры

// Источник значения настройки на странице — признак data-source того тега, что несёт её
// data-setting; порядок признаков в теге не важен. Настройки на странице нет — пусто.
Функция ИсточникНастройки(Знач HTML, Знач Ключ)

	Признак = Новый РегулярноеВыражение("<[^>]*\sdata-setting=""" + СтрЗаменить(Ключ, ".", "\.") + """[^>]*>");
	Совпадения = Признак.НайтиСовпадения(HTML);
	Если Совпадения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Источник = Новый РегулярноеВыражение("\sdata-source=""([^""]*)""").НайтиСовпадения(Совпадения[0].Значение);
	Возврат ?(Источник.Количество() = 0, "", Источник[0].Группы[1].Значение);

КонецФункции

Функция КлючиПроксиTelegram()
	Возврат "oshub.webhooks.telegram.proxy.host,oshub.webhooks.telegram.proxy.port,"
		+ "oshub.webhooks.telegram.proxy.user,oshub.webhooks.telegram.proxy.password";
КонецФункции

// Хаб у набора один на все тесты: оставленный прокси достался бы соседям.
Процедура ВернутьПроксиTelegramКУмолчанию(Знач Кука, Знач Экран, Знач Блок)

	Для Каждого Ключ Из СтрРазделить(КлючиПроксиTelegram(), ",") Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Экран, Кука))));
		Поля.Вставить("операция", "сбросить");
		Поля.Вставить("ключ", Ключ);
		Клиент.POSTФормы(Блок, Поля, Кука);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НеизвестнаяОперацияРазделаОтбиваетсяБелымСписком() Экспорт

	// белый список операций: устаревшая вкладка, повторный сабмит или подделанное поле «операция» не проваливаются
	// в ветку «сохранить всё» — неизвестная операция даёт отказ и ни одного изменения состояния
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/proxy", КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "чепуха-из-устаревшей-вкладки");
	Поля.Вставить("oshub.proxy.negative.ttl.sec", "17");
	Ответ = Клиент.POSTФормы("/hub/settings/proxy", Поля, КукаАдмина);

	Ожидаем.Что(Ответ.КодСостояния, "неизвестная операция — отказ, а не «сохранено»").Равно(400);

	Стр = Тело(Клиент.GETСКукой("/hub/settings/proxy", КукаАдмина));
	Ожидаем.Что(СтрНайти(Стр, "value=""17"""),
		"поле формы, приехавшее с неизвестной операцией, не записано").Равно(0);
	Ожидаем.Что(СтрНайти(Стр,
		"data-setting=""oshub.proxy.negative.ttl.sec"" data-source=""default""") > 0,
		"значение осталось прежним").ЭтоИстина();

КонецПроцедуры

// Раздел прав знает ровно две операции. Всякая другая — отказ: раздел, читающий
// «всё, что не отзыв» как выдачу, раздаёт права по опечатке и по подделанной форме.
// Разделов прав два — у пула и у пакета, — и правило у них одно.
&Тест
Процедура ВыдуманнаяОперацияРазделаПравНеВыдаётРоль() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	ЭкранПула = "/pools/public/settings/access";
	ОтказПула = Клиент.POSTФормы(ЭкранПула,
		ПоляРоли(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(ЭкранПула, КукаАдмина))), "запретить", "bob", "мейнтейнер"),
		КукаАдмина);

	Ожидаем.Что(ОтказПула.КодСостояния, "выдуманная операция раздела прав пула — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(ЭкранПула, КукаАдмина)), ">bob<"),
		"и роль на пул ею не выдана").Равно(0);

	ЭкранПакета = "/pools/public/packages/alice-pkg/settings/access";
	ОтказПакета = Клиент.POSTФормы(ЭкранПакета,
		ПоляРоли(Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(ЭкранПакета, КукаАдмина))), "выдатьь", "bob", "мейнтейнер"),
		КукаАдмина);

	Ожидаем.Что(ОтказПакета.КодСостояния, "опечатка в операции раздела прав пакета — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(ЭкранПакета, КукаАдмина)), ">bob<"),
		"и роль на пакет ею не выдана").Равно(0);

КонецПроцедуры

// То же умолчание жило в составе группы: «всё, что не удалить» читалось как «добавить»,
// и подделанное поле заводило участника, а с ним — все права группы. Нынешняя дверь операций
// не знает вовсе: форма с полем «операция» — старая вкладка, 400 без мутации.
&Тест
Процедура ВыдуманнаяОперацияСоставаГруппыНеДобавляетУчастника() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Раздел = "/groups/platform/settings/members";
	Подбор = Раздел + "?q=bob";

	// предпосылка: bob в подборе окна, значит в группе его нет (подбор показывает свободных)
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Подбор, КукаАдмина)), "<option value=""bob""") > 0,
		"предпосылка: bob не участник группы").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, КукаАдмина))));
	Поля.Вставить("операция", "выгнать");
	Поля.Вставить("логин", "bob");
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, КукаАдмина).КодСостояния,
		"выдуманная операция состава — отказ").Равно(400);

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Подбор, КукаАдмина)), "<option value=""bob""") > 0,
		"bob остался свободным: участником его не сделали").ЭтоИстина();

КонецПроцедуры

// И в сопоставлениях OIDC: связка раздаёт членство по клейму провайдера, поэтому
// заводиться она обязана названной операцией, а не «всем остальным».
&Тест
Процедура ВыдуманнаяОперацияСопоставленийНеЗаводитСвязку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Адрес = "/groups/platform/settings/oidc";
	Значение = "poddelka-team";

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Адрес, КукаАдмина))));
	Поля.Вставить("операция", "подсунуть");
	Поля.Вставить("издатель", "https://idp.example.com");
	Поля.Вставить("клейм", "groups");
	Поля.Вставить("значение", Значение);

	Ожидаем.Что(Клиент.POSTФормы(Адрес, Поля, КукаАдмина).КодСостояния,
		"выдуманная операция сопоставлений — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Адрес, КукаАдмина)), "<code>" + Значение + "</code>"),
		"связка ею не заведена").Равно(0);

КонецПроцедуры

// Раздел версий тем же умолчанием ВОССТАНАВЛИВАЛ отозванную версию: «всё, что не yank»
// доезжало до отзыва с признаком «восстановить».
&Тест
Процедура ВыдуманнаяОперацияВерсийНеВосстанавливаетОтозванную() Экспорт

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Адрес = "/pools/public/packages/alice-pkg/settings/versions";
	Версия = "1.1.0";
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Адрес, КукаАлисы)));

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Адрес, ПоляВерсии(Токен, "yank", Версия), КукаАлисы)),
		"предпосылка: версия отозвана").ЭтоИстина();

	Попытка

		Ожидаем.Что(Клиент.POSTФормы(Адрес, ПоляВерсии(Токен, "восстановить", Версия), КукаАлисы).КодСостояния,
			"выдуманная операция раздела версий — отказ").Равно(400);
		Ожидаем.Что(СтрНайти(СтрокаВерсии(Тело(Клиент.GETСКукой(Адрес, КукаАлисы)), Версия),
			"value=""unyank""") > 0, "версия осталась отозванной").ЭтоИстина();

	Исключение
		Клиент.POSTФормы(Адрес, ПоляВерсии(Токен, "unyank", Версия), КукаАлисы);
		ВызватьИсключение;
	КонецПопытки;

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Адрес, ПоляВерсии(Токен, "unyank", Версия), КукаАлисы)),
		"уборка: версия восстановлена").ЭтоИстина();

КонецПроцедуры

Функция ПоляВерсии(Знач Токен, Знач Операция, Знач Версия)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("версия", Версия);
	Возврат Поля;
КонецФункции

// Строка версии целиком: кнопка отзыва в ней, а не у соседней версии.
Функция СтрокаВерсии(Знач Разметка, Знач Версия)

	Начало = СтрНайти(Разметка, "<code>" + Версия + "</code>");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, "</tr>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

&Тест
Процедура СбросЧужогоКлючаОтбиваетсяРазделом() Экспорт

	// защита в глубину: ключ сброса проверяется по РЕДАКТИРУЕМЫМ карточкам именно этого раздела — подделанная форма
	// не доходит до домена ни с чужим, ни с bootstrap-ключом (домен отобьёт и сам, но проверять обязаны оба слоя)
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	// значение из другого раздела, введённое руками: его и попробуем сбросить «не оттуда»
	ТокенПрокси = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/proxy", КукаАдмина)));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ТокенПрокси);
	Поля.Вставить("oshub.proxy.timeout.sec", "33");
	Клиент.POSTФормы("/hub/settings/proxy", Поля, КукаАдмина);

	ТокенАут = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина)));

	Чужой = Новый Соответствие();
	Чужой.Вставить("_csrf", ТокенАут);
	Чужой.Вставить("операция", "сбросить");
	Чужой.Вставить("ключ", "oshub.proxy.timeout.sec");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/login", Чужой, КукаАдмина).КодСостояния,
		"ключ чужого раздела сбросить нельзя").Равно(400);

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/hub/settings/proxy", КукаАдмина)),
		"data-setting=""oshub.proxy.timeout.sec"" data-source=""database""") > 0,
		"чужое значение осталось в базе").ЭтоИстина();

	Bootstrap = Новый Соответствие();
	Bootstrap.Вставить("_csrf", ТокенАут);
	Bootstrap.Вставить("операция", "сбросить");
	Bootstrap.Вставить("ключ", "oshub.admin.login");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/login", Bootstrap, КукаАдмина).КодСостояния,
		"bootstrap-ключ не сбрасывается: он и в базе-то не бывает").Равно(400);

	// уборка за собой: раздел, из которого ключ действительно виден
	Уборка = Новый Соответствие();
	Уборка.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/proxy", КукаАдмина))));
	Уборка.Вставить("операция", "сбросить");
	Уборка.Вставить("ключ", "oshub.proxy.timeout.sec");
	Клиент.POSTФормы("/hub/settings/proxy", Уборка, КукаАдмина);

КонецПроцедуры

&Тест
Процедура ПовторныйСабмитБезПравокНеПишетВАудит() Экспорт

	// пишем только изменившееся: иначе каждое нажатие «Сохранить» плодило бы записи об изменении, которого не было
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/maintenance", КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("oshub.stats.flush_threshold", "600");
	Клиент.POSTФормы("/hub/settings/maintenance", Поля, КукаАдмина);

	Строка_ = "data-label=""Действие"">настройка.изменена</td><td data-label=""Объект"">настройка/oshub.stats.flush_threshold</td>";
	Ожидаем.Что(СколькоРаз(Тело(Клиент.GETСКукой("/hub/settings/audit", КукаАдмина)), Строка_),
		"первая правка записана в аудит").Равно(1);

	// тот же самый сабмит ещё раз — состояние не меняется, значит и записи быть не должно
	Повтор = Новый Соответствие();
	Повтор.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/maintenance", КукаАдмина))));
	Повтор.Вставить("oshub.stats.flush_threshold", "600");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/hub/settings/maintenance", Повтор, КукаАдмина)),
		"повторный сабмит принят").ЭтоИстина();

	Ожидаем.Что(СколькоРаз(Тело(Клиент.GETСКукой("/hub/settings/audit", КукаАдмина)), Строка_),
		"второй записи об изменении, которого не было, нет").Равно(1);

КонецПроцедуры

&Тест
Процедура НепринятыйВводНеСохраняетсяИНазываетНастройку() Экспорт

	// мусор в числовом поле не превращается молча в 0: домен отвергает по типу, экран отдаёт 400 и называет настройку
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/proxy", КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("oshub.proxy.upstream.recheck.ttl.sec", "пять");
	Ответ = Клиент.POSTФормы("/hub/settings/proxy", Поля, КукаАдмина);

	Ожидаем.Что(Ответ.КодСостояния, "непринятый ввод — 400, а не «сохранено»").Равно(400);
	ТелоОтказа = Тело(Ответ);
	Ожидаем.Что(СтрНайти(ТелоОтказа, "Перепроверка живости источника") > 0,
		"в сообщении названа настройка").ЭтоИстина();
	// экран называет фактическое состояние: домен не умеет проверять без записи, поэтому «не сохранена» обязано
	// сопровождаться тем, что применилось
	Ожидаем.Что(СтрНайти(ТелоОтказа, "Ничего из формы не применено") > 0,
		"названо фактическое состояние формы").ЭтоИстина();

	Стр = Тело(Клиент.GETСКукой("/hub/settings/proxy", КукаАдмина));
	Ожидаем.Что(СтрНайти(Стр,
		"data-setting=""oshub.proxy.upstream.recheck.ttl.sec"" data-source=""default""") > 0,
		"значение осталось прежним").ЭтоИстина();

КонецПроцедуры

