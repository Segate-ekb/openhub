&Тест
Процедура СтатикаНеПерехватываетсяСегментнымМаршрутом() Экспорт
	// /static отдаёт файл, а не страницу хаба
	Ответ = Клиент.GET(АдресСтилей());
	Ожидаем.Что(Ответ.КодСостояния, "статика отдана").Равно(200);
	Ожидаем.Что(СтрНайти(Строка(Ответ.Заголовки.Получить("Content-Type")), "text/css") > 0,
		"это именно css, а не html страницы пула").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура СтатикаОтдаётсяСЗаголовкамиКэша() Экспорт
	// версия в имени файла: ответ кэшируется «навсегда»
	Ответ = Клиент.GET(АдресСтилей());
	Управление = Строка(Ответ.Заголовки.Получить("Cache-Control"));
	Ожидаем.Что(СтрНайти(Управление, "immutable") > 0, "immutable для версионированного имени").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Управление, "max-age=31536000") > 0, "год жизни в кэше").ЭтоИстина();
	Метка = Строка(Ответ.Заголовки.Получить("ETag"));
	Ожидаем.Что(ЗначениеЗаполнено(Метка), "сильный ETag").ЭтоИстина();

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("If-None-Match", Метка);
	Ожидаем.Что(Клиент.Соединение().Получить(Новый HTTPЗапрос(АдресСтилей(), Заголовки)).КодСостояния,
		"условный запрос даёт 304").Равно(304);
КонецПроцедуры

&Тест
Процедура СтатикаНеСтавитСессионнуюКуку() Экспорт

	// ответ с Set-Cookie shared-кэш хранить не имеет права, и заявленный `public` был бы наполовину ложью:
	// куку снимаем тем же приёмом, что и на прочих stateless-ответах хаба
	Ответ = Клиент.GET(АдресСтилей());
	Ожидаем.Что(ЕстьЗаголовок(Ответ, "Set-Cookie"), "статика не ставит кук вовсе").ЭтоЛожь();

	// для сравнения: обычная страница куку ставит — значит проверка не вырождена
	Ожидаем.Что(ЕстьЗаголовок(Клиент.GET("/login"), "Set-Cookie"), "страница куку ставит").ЭтоИстина();

КонецПроцедуры

