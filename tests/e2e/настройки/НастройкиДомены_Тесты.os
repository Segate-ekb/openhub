// Значение, которым распоряжается разворачивающий, на экран настроек не выходит: ни поля,
// ни строки-карточки. Оно при этом действует — состояние хранилища рассказано словами.
&Тест
Процедура BootstrapЗначениеНаЭкранНастроекНеВыходит() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Стр = Тело(Клиент.GETСКукой("/hub/settings/storage", КукаАдмина));

	Ожидаем.Что(СтрНайти(Стр, "name=""oshub.storage.root"""), "поля ему не досталось").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "data-setting=""oshub.storage.root"""),
		"и строки-карточки тоже").Равно(0);

	// токен — с раздела, где форма есть (он сессионный): иначе запрос отбился бы CSRF, а не гейтом
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/login", КукаАдмина))));
	Поля.Вставить("oshub.storage.root", "/tmp/подмена");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/storage", Поля, КукаАдмина).КодСостояния,
		"раздел из одних bootstrap-значений мутаций не принимает").Равно(405);

	// упразднённые разделы исчезли из дома целиком: у них не осталось ни одного правимого
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/jobs", КукаАдмина).КодСостояния,
		"раздела «Фоновые задачи» больше нет").Равно(404);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/telemetry", КукаАдмина).КодСостояния,
		"и раздела телеметрии тоже").Равно(404);

КонецПроцедуры

&Тест
Процедура ЗнакИОформлениеИнсталляцииПравятсяИзФормыБезРестарта() Экспорт

	// то, ради чего раздел завели: администратор правит название, подпись, тему, пресет и акцент
	// формой, и ТОТ ЖЕ процесс отдаёт публичную страницу уже с ними
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/branding", КукаАдмина)));
	Ожидаем.Что(ЗначениеЗаполнено(Токен), "у раздела «Брендирование» есть форма правки").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("brand", "Хаб Ромашка");
	Поля.Вставить("tagline", "Внутренний хаб компании Ромашка");
	Поля.Вставить("theme", "светлая");
	Поля.Вставить("preset", "oscript");
	Поля.Вставить("accent", "#ff8800");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/hub/settings/branding", Поля, КукаАдмина)),
		"форма брендирования принята").ЭтоИстина();

	Попытка

		Публичная = Тело(Клиент.GET("/packages"));
		Ожидаем.Что(СтрНайти(Публичная, "Хаб Ромашка") > 0,
			"новое название инсталляции на публичной странице").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Публичная, "Внутренний хаб компании Ромашка") > 0,
			"новая подпись в подвале").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Публичная, Новый ТокеныТемы().Переменные(
			Новый Структура("Пресет, Акцент", "oscript", "#ff8800"))) > 0,
			"новые пресет и акцент поверх него приехали в <head>").ЭтоИстина();
		ЦветаПресета = Новый ТокеныТемы().ЦветаПресета("oscript", Ложь, "#ff8800");
		Поверхность = "--md-sys-color-surface:" + ЗначениеПеременной(ЦветаПресета, "--md-sys-color-surface") + ";";
		Ожидаем.Что(СтрНайти(Публичная, Поверхность) > 0,
			"поверхность светлой темы — пресета oscript: " + Поверхность).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Публичная, "<html lang=""ru"" data-theme=""light"">") > 0,
			"новая тема инсталляции").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Публичная, "— OpenHub<"), "прежний знак со страницы ушёл").Равно(0);

		// мусор в цвете отбивается формой, а не уезжает в <style> инъекцией
		Плохие = Новый Соответствие();
		Плохие.Вставить("_csrf", Токен);
		Плохие.Вставить("accent", "red;}html{display:none");
		Отказ = Клиент.POSTФормы("/hub/settings/branding", Плохие, КукаАдмина);
		Ожидаем.Что(Отказ.КодСостояния, "мусорный цвет — отказ формы").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Отказ), "#rrggbb") > 0,
			"отказ называет требуемую запись цвета").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/packages")), "display:none"),
			"отвергнутый цвет в <style> не попал").Равно(0);

	Исключение
		СброситьБрендирование(Токен, КукаАдмина);
		ВызватьИсключение;
	КонецПопытки;

	СброситьБрендирование(Токен, КукаАдмина);

	Вернулась = Тело(Клиент.GET("/packages"));
	Ожидаем.Что(СтрНайти(Вернулась, "— OpenHub<") > 0,
		"сброс вернул знак по умолчанию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вернулась, "Хаб Ромашка"), "чужого знака на странице не осталось").Равно(0);

КонецПроцедуры

