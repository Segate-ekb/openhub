	Страница = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));

	Неизвестная = ПостРоли(Логин, "superadmin", Истина, Клиент.ТокенCSRF(Страница), КукаАдмина);
	Ожидаем.Что(Неизвестная.КодСостояния, "неизвестная роль — отказ").Равно(400);
	Ожидаем.Что(РольУчётки(Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина)),
		Логин), "выдуманная роль в базу не попала").Равно("user");

КонецПроцедуры

// Форма окна смены роли строки: запрошенная роль и, у подтверждённой отправки, confirmed=1.
Функция ПостРоли(Знач Логин, Знач Роль, Знач Подтверждено, Знач Токен, Знач Кука)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("роль", Роль);
	Если Подтверждено Тогда
		Поля.Вставить("confirmed", "1");
	КонецЕсли;
	Возврат Клиент.POSTФормы("/hub/settings/users/"
		+ КодироватьСтроку(Логин, СпособКодированияСтроки.КодировкаURL) + "/role", Поля, Кука);

КонецФункции

// Номер учётки — из её прав в API: личное пространство даёт учётке роль на своём пуле,
// и строка права называет субъекта номером.
Функция НомерУчётки(Знач КукаАдмина, Знач Логин)

	Ключ = Клиент.ВыпуститьPAT(КукаАдмина, "read,write", 0);
	Ответ = Клиент.GETСТокеном("/api/v1/users/" + Логин + "/grants", Ключ);
	Для Каждого Право Из Клиент.ТелоJSON(Ответ).Получить("items") Цикл
		Если Право.Получить("subject_type") = "пользователь" И Право.Получить("subject") = Логин Тогда
			Возврат Формат(Право.Получить("subject_id"), "ЧГ=0; ЧН=0");
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не нашёлся номер учётки " + Логин + ": у неё нет ни одного права";

КонецФункции

// Ячейка колонки «Роль» (по шапке таблицы) в строке учётки; "" — строки или колонки нет.
Функция РольУчётки(Знач Разметка, Знач Логин)

	Номер = НомерКолонки(Разметка, "Роль");
	Строка_ = СтрокаУчётки(Разметка, Логин);
	Если Номер < 0 ИЛИ Строка_ = "" Тогда
		Возврат "";
	КонецЕсли;

	// ячейка номер N — за N-м вхождением «<td»; первые ячейки строки учётки не вложены
	Позиция = 0;
	Для Шаг = 0 По Номер Цикл
		Позиция = СтрНайти(Строка_, "<td", НаправлениеПоиска.СНачала, Позиция + 1);
		Если Позиция = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Ячейка = Сред(Строка_, Позиция);
	Ячейка = Сред(Ячейка, СтрНайти(Ячейка, ">") + 1);
	Возврат СокрЛП(Лев(Ячейка, СтрНайти(Ячейка + "</td>", "</td>") - 1));

КонецФункции

// Номер колонки с этим заголовком в шапке её таблицы, от нуля; -1 — такой колонки нет.
Функция НомерКолонки(Знач Разметка, Знач Заголовок)

	Конец = СтрНайти(Разметка, ">" + Заголовок + "</th>");
	Если Конец = 0 Тогда
		Возврат -1;
	КонецЕсли;

	Шапка = Лев(Разметка, Конец);
	Начало = СтрНайти(Шапка, "<thead", НаправлениеПоиска.СКонца);
	Возврат СтрЧислоВхождений(Сред(Шапка, Начало), "<th ") - 1;

КонецФункции

// Строка учётки целиком, чтобы за неё не ответила соседняя.
Функция СтрокаУчётки(Знач Разметка, Знач Логин)

	// заглавная ячейка таблицы карточками несёт свой класс — ищем по тексту ячейки
	Поз = СтрНайти(Разметка, ">" + Логин + "</td>");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Поз = СтрНайти(Разметка, "<td", НаправлениеПоиска.СКонца, Поз);
	Остаток = Сред(Разметка, Поз);
	Конец = СтрНайти(Остаток, "</tr>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец));

КонецФункции

#КонецОбласти

