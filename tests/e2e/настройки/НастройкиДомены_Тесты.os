&Тест
Процедура ПодпискаЧужогоОбъектаНеТрогаетсяПоId() Экспорт

	// идентификатор подписки, подставленный в адрес ДРУГОГО объекта, ничего не меняет: служба ищет её внутри объекта
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	АдресХаба = "/hub/settings/webhooks";
	СоздатьПодписку(АдресХаба, "https://hook.example.com/iso", КукаАдмина);

	СписокДо = Тело(Клиент.GETСКукой(АдресХаба, КукаАдмина));
	БылоПодписок = ЧислоПодписок(СписокДо);
	Ожидаем.Что(БылоПодписок > 0, "подписки хаба в списке есть").ЭтоИстина();

	// считаем ВСЕ подписки хаба, а не ищем одну по имени: разметка отдаёт идентификатор ПЕРВОЙ строки, и проверка
	// «моя подписка на месте» молча зеленела бы, удалив соседнюю
	Ид = ИдентификаторПодписки(СписокДо, АдресХаба);
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "идентификатор подписки хаба найден в разметке").ЭтоИстина();

	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/webhooks", КукаАдмина)));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/webhooks/" + Ид + "/delete", Поля, КукаАдмина);

	СписокПосле = Тело(Клиент.GETСКукой(АдресХаба, КукаАдмина));
	Ожидаем.Что(ЧислоПодписок(СписокПосле),
		"ни одна подписка хаба не удалена через адрес пакета").Равно(БылоПодписок);
	Ожидаем.Что(СтрНайти(СписокПосле, "hook.example.com/iso") > 0,
		"подписка хаба цела: удаление через адрес пакета — no-op").ЭтоИстина();

КонецПроцедуры

