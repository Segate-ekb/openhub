&Тест
Процедура ТумблерПодпискиВыключаетИВключает() Экспорт

	// тумблер «включить» — то самое поле со значением "0", на котором ЗначениеЗаполнено("0") = Истина сделало бы
	// «выключить» неотличимым от «включить»: читаем ЧЕРЕЗ значение
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Адрес = "/pools/public/packages/alice-pkg/settings/webhooks";
	СоздатьПодписку(Адрес, "https://toggle.example.com/hook", Кука);

	Ид = ИдентификаторПодписки(Тело(Клиент.GETСКукой(Адрес, Кука)), Адрес);
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "идентификатор подписки найден").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Переключить(Адрес, Ид, "0", Кука)), "выключение принято").ЭтоИстина();
	Ожидаем.Что(ПодпискаВключена(Ид, Кука), "в API подписка выключена").ЭтоЛожь();
	Ожидаем.Что(ПомеченаВыключенной(Тело(Клиент.GETСКукой(Адрес, Кука)), Адрес, Ид),
		"её карточка помечена «выключена»").ЭтоИстина();

	// правка сохраняет включённость как есть: поля в окне правки нет, выключенная подписка не оживает
	Страница = Тело(Клиент.GETСКукой(Адрес + "?" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL)
		+ "=" + КодироватьСтроку("изменить-" + Ид, СпособКодированияСтроки.КодировкаURL), Кука));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Адрес + "/" + Ид + "/save",
		Клиент.ПоляФормыСо(Страница, "action=""" + Адрес + "/" + Ид + "/save"""), Кука)), "правка окном принята").ЭтоИстина();
	Ожидаем.Что(ПодпискаВключена(Ид, Кука), "после правки подписка всё так же выключена").ЭтоЛожь();

	Ожидаем.Что(УспехМутации(Переключить(Адрес, Ид, "1", Кука)), "включение принято").ЭтоИстина();
	Ожидаем.Что(ПодпискаВключена(Ид, Кука), "в API подписка снова включена").ЭтоИстина();
	Ожидаем.Что(ПомеченаВыключенной(Тело(Клиент.GETСКукой(Адрес, Кука)), Адрес, Ид),
		"знака «выключена» у карточки больше нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура АдресПодпискиЭкранируетсяВРазметке() Экспорт

	// адрес доставки задаёт пользователь, и хаб рисует его на трёх экранах: спецсимволы в query — законный адрес,
	// и снятие экранирования дало бы XSS молча
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Адрес = "/pools/public/packages/alice-pkg/settings/webhooks";
	Опасный = "https://xss.example.com/?a=<b>&c=""d""";

	Ожидаем.Что(УспехМутации(СоздатьПодписку(Адрес, Опасный, Кука)),
		"адрес со спецсимволами принят валидатором").ЭтоИстина();

	Стр = Тело(Клиент.GETСКукой(Адрес, Кука));
	Ожидаем.Что(СтрНайти(Стр, "xss.example.com") > 0, "подписка в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "&lt;b&gt;") > 0, "угловые скобки экранированы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "/?a=<b>"), "сырой тег в разметку не попал").Равно(0);

