&Тест
Процедура ВитринаМоихПравТолькоЧтение() Экспорт
	// «право видно рядом с объектом»: в аккаунте — витрина, правка уводит на объект
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Стр = Тело(Клиент.GETСКукой("/me/settings/permissions", КукаOwner));
	Ожидаем.Что(СтрНайти(Стр, "Мои права") > 0, "витрина прав").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "owned") > 0, "виден свой пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "/pools/owned/settings") > 0, "ссылка на объект, где право правится").ЭтоИстина();
	// у витрины нет своей формы сохранения: с ВАЛИДНЫМ CSRF получаем «метод не разрешён» — отказ по природе раздела
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/me/settings/profile", КукаOwner)));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Ожидаем.Что(Клиент.POSTФормы("/me/settings/permissions", Поля, КукаOwner).КодСостояния,
		"витрину нельзя мутировать").Равно(405);
КонецПроцедуры

&Тест
Процедура ОформлениеПравитсяЦеликомОднойФормой() Экспорт

	// раздел «вид и язык» пишет cookie целиком — тему, акцент, плотность и радиус, — не стирая соседей
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Стр = Тело(Клиент.GETСКукой("/me/settings/appearance", КукаАлисы));

	Для Каждого Имя Из СтрРазделить("тема,акцент,плотность,радиус", ",") Цикл
		Ожидаем.Что(СтрНайти(Стр, СтрШаблон("name=""%1""", Имя)) > 0,
			СтрШаблон("поле «%1» есть в форме оформления", Имя)).ЭтоИстина();
	КонецЦикла;

	Токен = Клиент.ТокенCSRF(Стр);
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("тема", "светлая");
	Поля.Вставить("акцент", "#111111");
	Поля.Вставить("плотность", "1");
	Поля.Вставить("радиус", "1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/me/settings/appearance", Поля, КукаАлисы)),
		"оформление сохранено одной обычной формой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТекстНаТёмномАкцентеЧитается() Экспорт
	// тёмный акцент #111111 не делает кнопку нечитаемой: схему с контрастными парами
	// выводит кит, страница несёт её целиком
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_ui=" + КодироватьСтроку("тема=тёмная&акцент=#111111",
		СпособКодированияСтроки.КодировкаURL));
	Стр = Тело(Клиент.Соединение().Получить(Новый HTTPЗапрос("/", Заголовки)));
	Схема = ПеременныеСАкцентом("#111111");
	Ожидаем.Что(СтрНайти(Стр, Схема) > 0,
		"акцент посетителя приехал схемой цветов").ЭтоИстина();

	Токены = Новый ТокеныТемы();
	Основной = ЗначениеПеременной(Схема, "--md-sys-color-primary");
	НаОсновном = ЗначениеПеременной(Схема, "--md-sys-color-on-primary");
	Ожидаем.Что(Токены.КоэффициентКонтраста(Основной, НаОсновном) >= 4.5,
		"на тёмном акценте текст читается: " + Основной + " / " + НаОсновном).ЭтоИстина();
КонецПроцедуры

// Переменные темы, которые кит выводит из этого акцента: страница с ним несёт их целиком.
Функция ПеременныеСАкцентом(Знач Акцент)
	Возврат Новый ТокеныТемы().Переменные(Новый Структура("Акцент", Акцент));
КонецФункции

// Значение переменной в тёмной (первой) палитре: «--имя:значение;».
Функция ЗначениеПеременной(Знач CSS, Знач Имя)
	Хвост = Сред(CSS, СтрНайти(CSS, Имя + ":") + СтрДлина(Имя) + 1);
	Возврат Лев(Хвост, СтрНайти(Хвост, ";") - 1);
КонецФункции

&Тест
Процедура АнонимНеВДомАккаунта() Экспорт
	Ожидаем.Что(НеДоступноАнониму(Клиент.GET("/me/settings/profile"), "data-house=""account"""),
		"аноним не в доме аккаунта").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура РазделУведомленийСнятСКартыДомаАккаунта() Экспорт

	// подписка на события — настройка объекта, а не личного профиля. Проверяется ДЕРЕВО
	// разделов дома, а не вся страница: слово «Уведомления» законно живёт в навигации
	// кабинета — там оно ведёт в личную ленту (/me/notifications), а это другой экран
	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Пункты = ПунктыДереваДома(Тело(Клиент.GETСКукой("/me/settings/profile", Кука)));

	Ожидаем.Что(Пункты.Количество() > 0, "дерево дома «Аккаунт» прочитано, сканер не ослеп")
		.ЭтоИстина();

	Нарушители = Новый Массив();
	Для Каждого Пункт Из Пункты Цикл
		Если СтрНайти(Пункт.Адрес, "/me/settings/notifications") > 0
			ИЛИ СтрНайти(Пункт.Разметка, "Уведомления") > 0 Тогда
			Нарушители.Добавить(Пункт.Адрес);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"пункты дерева дома «Аккаунт», вернувшие раздел уведомлений").Равно("");

КонецПроцедуры

&Тест
Процедура СтарыйАдресУведомленийВедётРедиректом() Экспорт
	// инвариант этапа №2: снятый раздел отвечает редиректом, а не 404
	ПроверитьРедирект("/me/settings/notifications", "/me");
КонецПроцедуры

&Тест
Процедура ИздательВедётПодпискиПакета() Экспорт

	// pub — publisher на пуле public: «изменение» наследуется на пакет, значит подписками ПАКЕТА он распоряжается
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Адрес = "/pools/public/packages/alice-pkg/settings/webhooks";

	Стр = Тело(Клиент.GETСКукой(Адрес, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Подписки на события") > 0, "раздел подписок пакета открыт").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Новая подписка") > 0, "форма создания показана").ЭтоИстина();

	Ответ = СоздатьПодписку(Адрес, "https://hook.example.com/pkg", Кука);
	Ожидаем.Что(УспехМутации(Ответ), "подписка создана").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Адрес, Кука));
	Ожидаем.Что(СтрНайти(Список, "hook.example.com/pkg") > 0, "подписка в списке").ЭтоИстина();

	// секрет показывается ровно один раз при создании — на следующем показе раздела окна секрета нет
	Ожидаем.Что(СтрНайти(Список, "Скопируйте секрет"), "секрет второй раз не показан").Равно(0);

КонецПроцедуры

&Тест
Процедура ИздательНеВедётПодпискиПула() Экспорт

	// подписками ПУЛА распоряжается owner-уровень: гейт страницы пула отбивает publisher
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/pools/public/settings/webhooks", Кука).КодСостояния,
		"publisher не входит в подписки пула").Равно(403);

КонецПроцедуры

&Тест
Процедура АвторБезПраваВидитПодпискиТолькоЧитая() Экспорт

	// alice — АВТОР пакета, роли на пуле у неё нет: страницу дома видит, подписками не распоряжается
