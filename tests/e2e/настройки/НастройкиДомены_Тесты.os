// Пять домов настроек на живом хабе (аккаунт · группа · пул · пакет · хаб): гвард каждого дома, CSRF
// на мутациях, переезды адресов, статика, работа без JS, поле из конфигурации.

#Использовать asserts
#Использовать 1connector
#Использовать oscript-ui
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем КаталогПроекта;
Перем РитмПолей;       // фикстура РитмФорм — ритм полей форм
Перем СтилиХаба;       // оба листа страницы (кит + инсталляция), прочитанные один раз
Перем Клиент;          // фикстура КлиентХаба — все запросы к подопытному хабу

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("РитмФорм");

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_ADMIN_LOGIN", "");
	Окружение.Вставить("OSHUB_ADMIN_PASSWORD", "");
	// без почты подтверждение адреса выключено, иначе регистрация закрыта
	Окружение.Вставить("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	// self-hosted GitLab среди доверенных издателей — для переноса издателя в форму
	Окружение.Вставить("OSHUB_PUBLISH_CI_ISSUERS", "https://git.example.test");
	// плановая проба хранилища за горизонтом прогона: «Отвечает» на экране — от запроса, а не от неё
	Окружение.Вставить("OSHUB_JOBS_STORAGE__HEALTH__INTERVAL__SEC", "3600");

	Хаб = Новый ЭкземплярХаба(90);
	КаталогПроекта = Хаб.КаталогПроекта();
	Хаб.ВыключитьДоставкуВебхуков();
	Хаб.Поднять("openhub-дома", Окружение, "ЗасеятьКабинет.os");
	Порт = Хаб.Порт();
	Клиент = Новый КлиентХаба(Хаб, 20);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ХабТолькоАдмину() Экспорт
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ответ = Клиент.GETСКукой("/hub/settings", КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "админ видит дом настроек хаба").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Настройки хаба") > 0, "заголовок дома").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "data-house=""hub""") > 0, "каркас пометил дом").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ОбычныйНеВидитХаб() Экспорт
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаАлисы).КодСостояния, "не-админу отказ на дом хаба").Равно(403);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/login", КукаАлисы).КодСостояния, "не-админу отказ на раздел").Равно(403);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/users", КукаАлисы).КодСостояния, "не-админу отказ на пользователей").Равно(403);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/pools", КукаАлисы).КодСостояния, "не-админу отказ на пулы").Равно(403);
КонецПроцедуры

// Каждая форма дома «Хаб» отбивает не-админа: ни значение, ни выключение входа по паролю, ни проба
// почты не доходят до домена, хотя CSRF-токен у человека свой и настоящий.
&Тест
Процедура ОбычныйНеМеняетХабНиОднойФормой() Экспорт

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/me/settings/profile", КукаАлисы)));

	Значение = Новый Соответствие();
	Значение.Вставить("_csrf", Токен);
	Значение.Вставить("oshub.instance.url", "https://alice-захват.example.org");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/identity", Значение, КукаАлисы).КодСостояния,
		"не-админу отказ на форму «Основного»").Равно(403);

	Выключение = Новый Соответствие();
	Выключение.Вставить("_csrf", Токен);
	Выключение.Вставить("операция", "парольный-вход");
	Выключение.Вставить("подтверждение", "выключить");
	Выключение.Вставить("confirmed", "1");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/login", Выключение, КукаАлисы).КодСостояния,
		"не-админу отказ на выключение входа по паролю").Равно(403);

	Проба = Новый Соответствие();
	Проба.Вставить("_csrf", Токен);
	Проба.Вставить("операция", "проба-почты");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/mail", Проба, КукаАлисы).КодСостояния,
		"не-админу отказ на пробу почты").Равно(403);

	Знак = Новый Соответствие();
	Знак.Вставить("_csrf", Токен);
	Знак.Вставить("brand", "Хаб Алисы");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/branding", Знак, КукаАлисы).КодСостояния,
		"не-админу отказ на значения брендирования").Равно(403);
	СбросЛоготипа = Новый Соответствие();
	СбросЛоготипа.Вставить("_csrf", Токен);
	СбросЛоготипа.Вставить("confirmed", "1");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/branding/logo/reset", СбросЛоготипа, КукаАлисы).КодСостояния,
		"не-админу отказ на возврат стандартного логотипа").Равно(403);
	Файл = Новый Массив();
	Файл.Добавить(Новый Структура("Имя, ИмяФайла, ТипКонтента, Данные", "logo", "лого.svg", "image/svg+xml",
		ПолучитьДвоичныеДанныеИзСтроки("<svg xmlns=""http://www.w3.org/2000/svg""/>")));
	ТокенЗагрузки = Новый Соответствие();
	ТокенЗагрузки.Вставить("_csrf", Токен);
	Ожидаем.Что(Клиент.POSTСоставной("/hub/settings/branding/logo", ТокенЗагрузки, Файл, КукаАлисы).КодСостояния,
		"не-админу отказ на загрузку логотипа").Равно(403);

	Доставка = Новый Соответствие();
	Доставка.Вставить("_csrf", Токен);
	Доставка.Вставить("oshub.webhooks.allow_insecure", "1");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/webhooks/delivery", Доставка, КукаАлисы).КодСостояния,
		"не-админу отказ на форму «Настройки доставки»").Равно(403);

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ожидаем.Что(ЗначениеЗаполнено(КукаАдмина), "вход по паролю остался включённым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/hub/settings/identity", КукаАдмина)), "alice-захват"),
		"адрес хаба не тронут").Равно(0);

КонецПроцедуры

&Тест
Процедура ВладелецПулаНеЭскалируетДоХаба() Экспорт
	// эскалация «управляю своим пулом ⇒ управляю хабом» невозможна: гвард дома «Хаб» смотрит только на суперправо
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/settings", КукаOwner).КодСостояния, "свой пул виден").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаOwner).КодСостояния, "но дом хаба — 403").Равно(403);
КонецПроцедуры

&Тест
Процедура АнонимНеВХаб() Экспорт
	Ожидаем.Что(НеДоступноАнониму(Клиент.GET("/hub/settings"), "Настройки хаба"), "аноним не в доме хаба").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПоискПоПользователямСужаетСписокХаба() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Все = Тело(Клиент.GETСКукой("/hub/settings/users", КукаАдмина));
	Ожидаем.Что(СтрНайти(Все, "alice") > 0 И СтрНайти(Все, "mustchange") > 0,
		"без отбора в списке все учётки").ЭтоИстина();

	ПоЛогину = Тело(Клиент.GETСКукой("/hub/settings/users?q=ali", КукаАдмина));
	Ожидаем.Что(СтрНайти(ПоЛогину, "alice") > 0, "фрагмент логина находит учётку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоЛогину, "mustchange"), "прочие учётки отобраны").Равно(0);

	ПоEmail = Тело(Клиент.GETСКукой("/hub/settings/users?q=mc@ex.com", КукаАдмина));
	Ожидаем.Что(СтрНайти(ПоEmail, "mustchange") > 0, "фрагмент email находит учётку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоEmail, "alice"), "по чужому email учётка не показана").Равно(0);

	Пусто = Тело(Клиент.GETСКукой("/hub/settings/users?q=нетТакогоЛогина", КукаАдмина));
	Ожидаем.Что(СтрНайти(Пусто, "ничего не найдено") > 0, "пустая выдача объяснена").ЭтоИстина();

КонецПроцедуры

#Область РольАдминистратораХаба

// Права проверяются ДОСТУПОМ к админскому разделу, а не полем в базе: назначение,
// которое не открывает раздел, администратором человека не делает.
&Тест
Процедура АдминНазначаетИСнимаетАдминистратора() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "rolegrant";
	Ожидаем.Что(РегистрацияКод(Логин, "GoodPass1"), "учётка для назначения заведена").Равно(201);

	КукаНового = Клиент.Войти(Логин, "GoodPass1");
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/users", КукаНового).КодСостояния,
		"до назначения раздел администрирования закрыт").Равно(403);

	Страница = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
	Ожидаем.Что(СтрНайти(СтрокаУчётки(Страница, Логин), "Сделать администратором") > 0,
		"строка обычной учётки предлагает выдать роль").ЭтоИстина();

	Ожидаем.Что(УспехМутации(ПостРоли(Логин, "admin", Истина, Клиент.ТокенCSRF(Страница), КукаАдмина)),
		"назначение принято").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/users", КукаНового).КодСостояния,
		"новый администратор попадает в раздел той же сессией").Равно(200);

	ПослеНазначения = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
	Ожидаем.Что(РольУчётки(ПослеНазначения, Логин), "список показывает новую роль")
		.Равно("admin");
	Ожидаем.Что(СтрНайти(СтрокаУчётки(ПослеНазначения, Логин), "Снять администратора") > 0,
		"операция двусторонняя: та же строка предлагает снятие").ЭтоИстина();

	Ожидаем.Что(УспехМутации(ПостРоли(Логин, "user", Истина, Клиент.ТокенCSRF(ПослеНазначения), КукаАдмина)),
		"снятие принято").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/users", КукаНового).КодСостояния,
		"после снятия права потеряны").Равно(403);

КонецПроцедуры

&Тест
Процедура СменаРолиПопадаетВЖурналАудита() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "roleaudit";
	Ожидаем.Что(РегистрацияКод(Логин, "GoodPass1"), "учётка для аудита заведена").Равно(201);

	Страница = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
	Ид = НомерУчётки(КукаАдмина, Логин);
	Ожидаем.Что(УспехМутации(ПостРоли(Логин, "admin", Истина, Клиент.ТокенCSRF(Страница), КукаАдмина)),
		"назначение принято").ЭтоИстина();

	Журнал = Тело(Клиент.GETСКукой("/hub/settings/audit", КукаАдмина));
	Ожидаем.Что(СтрНайти(Журнал, "роль.хаба.изменена") > 0,
		"журнал знает о смене роли").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, "data-label=""Объект"">пользователь/" + Логин + "</td>") > 0,
		"журнал называет учётку логином, а не номером").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, "пользователь#" + Ид) = 0,
		"номера учётки на экране журнала больше нет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, "data-label=""Кто"">root</td>") > 0,
		"журнал называет инициатора").ЭтоИстина();

	// уборка: администратор набора остаётся один
	ПослеНазначения = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
	ПостРоли(Логин, "user", Истина, Клиент.ТокенCSRF(ПослеНазначения), КукаАдмина);

КонецПроцедуры

&Тест
Процедура НеАдминНеМеняетРольНикому() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "rolestranger";
	Ожидаем.Что(РегистрацияКод(Логин, "GoodPass1"), "учётка-цель заведена").Равно(201);

	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Ожидаем.Что(ПостРоли(Логин, "admin", Истина, "любой", КукаАлисы).КодСостояния,
		"обычному пользователю раздел закрыт и на запись").Равно(403);

	КукаЖертвы = Клиент.Войти(Логин, "GoodPass1");
	Ожидаем.Что(ПостРоли(Логин, "admin", Истина, "любой", КукаЖертвы).КодСостояния,
		"и себе роль администратора не выдать").Равно(403);
	Ожидаем.Что(НеДоступноАнониму(ПостРоли(Логин, "admin", Истина, "любой", ""), "Пользователи"),
		"аноним ролями не распоряжается").ЭтоИстина();

	Ожидаем.Что(РольУчётки(Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина)),
		Логин), "роль осталась прежней").Равно("user");

КонецПроцедуры

// Себя понизить нельзя ровно по той же причине, по какой нельзя себя заблокировать:
// инициатор всегда остаётся действующим администратором, поэтому хаб не остаётся без
// администратора вовсе.
&Тест
Процедура АдминистраторНеСнимаетРольССебя() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "roleself";
	Ожидаем.Что(РегистрацияКод(Логин, "GoodPass1"), "второй администратор заведён").Равно(201);

	Страница = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
	Ожидаем.Что(УспехМутации(ПостРоли(Логин, "admin", Истина, Клиент.ТокенCSRF(Страница), КукаАдмина)),
		"назначение принято").ЭтоИстина();

	// список без отбора: CSRF-токен своей сессии берётся с формы ЧУЖОЙ строки — своей нет
	КукаВторого = Клиент.Войти(Логин, "GoodPass1");
	Своя = Тело(Клиент.GETСКукой("/hub/settings/users", КукаВторого));
	Ожидаем.Что(СтрНайти(СтрокаУчётки(Своя, Логин), "Снять администратора"),
		"своей строке кнопка снятия не рисуется").Равно(0);

	Ответ = ПостРоли(Логин, "user", Истина, Клиент.ТокенCSRF(Своя), КукаВторого);
	Ожидаем.Что(Ответ.КодСостояния, "подделанная форма отвергнута сервисом").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "свою роль изменить нельзя") > 0,
		"отказ назван причиной").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "role_change_"),
		"служебный код домена на экран не выносится").Равно(0);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/users", КукаВторого).КодСостояния,
		"права остались при нём").Равно(200);

	// уборка: администратор набора остаётся один
	ПослеПроверки = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
	Ожидаем.Что(УспехМутации(ПостРоли(Логин, "user", Истина, Клиент.ТокенCSRF(ПослеПроверки), КукаАдмина)),
		"чужую роль администратор снимает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезПодтвержденияРольНеМеняется() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "roleconfirm";
	Ожидаем.Что(РегистрацияКод(Логин, "GoodPass1"), "учётка для подтверждения заведена").Равно(201);

	Страница = Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина));
	Токен = Клиент.ТокенCSRF(Страница);

	// без скрипта форма уходит без поля подтверждения: сервер ведёт на страницу с окном вопроса
	БезПоля = ПостРоли(Логин, "admin", Ложь, Токен, КукаАдмина);
	Ожидаем.Что(БезПоля.КодСостояния, "без подтверждения — страница с вопросом").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(БезПоля), "Сделать «" + Логин + "» администратором?") > 0,
		"сервер задал вопрос сам — путь без скрипта").ЭтоИстина();

	Ожидаем.Что(РольУчётки(Тело(Клиент.GETСКукой("/hub/settings/users?q=" + Логин, КукаАдмина)),
		Логин), "роль осталась прежней").Равно("user");

КонецПроцедуры

&Тест
Процедура НесуществующаяУчёткаОтвечаетОтказомАНе500() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/hub/settings/users", КукаАдмина)));

	Нет = ПостРоли("nosuchuser999", "admin", Истина, Токен, КукаАдмина);
