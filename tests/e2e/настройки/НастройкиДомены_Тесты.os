&Тест
Процедура ПодсказкаКвотыГоворитТоЖе_ЧтоИОтказГейта() Экспорт

	// РЕГРЕССИЯ: подсказка под полем квоты пережила смену правила и продолжала советовать
	// «отозванные версии в квоту не входят» — ровно то, что из текста отказа гейта убрали.
	// Экран и отказ обязаны говорить одно и то же, иначе админ чинит переполнение отзывом.
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Страница = Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаАдмина));

	// снятое правило ищется целиком: подстрока «не входят» сама по себе ничего не значит
	Ожидаем.Что(СтрНайти(Страница, "отозванные версии в неё не входят"),
		"подсказка больше не выводит отозванные версии из квоты").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "ВКЛЮЧАЯ отозванные") > 0,
		"а прямо говорит обратное").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "отзыв места не освобождает") > 0,
		"подсказка называет действующее правило отзыва").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "удаление пакета") > 0,
		"и говорит, что место освобождает").ЭтоИстина();
	// кэш прокси входит в квоту: подсказка называет его среди занявшего место
	Ожидаем.Что(СтрНайти(Страница, "кэш прокси") > 0,
		"а также что кэш прокси занимает место пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "уборка кэша прокси") > 0,
		"и что место кэша возвращает уборка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВладелецПулаКвотуНеМеняетДажеПодделаннойФормой() Экспорт

	// квоту пула владелец себе не назначает: поле подделывается, поэтому проверяются отказ
	// сервера и неизменность базы
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаАдмина)));
	Исходные = Новый Соответствие();
	Исходные.Вставить("_csrf", Токен);
	Исходные.Вставить("квота_мб", "512");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/owned/settings/quota", Исходные, КукаАдмина)),
		"админ хаба квоту ставит").ЭтоИстина();

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	СтраницаВладельца = Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner));
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner).КодСостояния,
		"раздел владельцу виден").Равно(200);
	Ожидаем.Что(СтрНайти(СтраницаВладельца, "name=""квота_мб"""),
		"органа управления у владельца нет").Равно(0);
	Ожидаем.Что(СтрНайти(СтраницаВладельца, "role=""progressbar""") > 0,
		"а полоса заполнения показана").ЭтоИстина();

	// подделанная форма: владелец шлёт POST напрямую, взяв CSRF-токен своей сессии
	Подделка = Новый Соответствие();
	Подделка.Вставить("_csrf", Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/visibility", КукаOwner))));
	Подделка.Вставить("квота_мб", "0");
	Ответ = Клиент.POSTФормы("/pools/owned/settings/quota", Подделка, КукаOwner);

	Ожидаем.Что(Ответ.КодСостояния, "сервер отвечает 403").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаАдмина)), "value=""512""") > 0,
		"квота в базе НЕ изменилась").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НечисловаяКвотаНеСнимаетЛимит() Экспорт

	// опечатка «5oo» приводилась к 0, а 0 означает «без лимита»: администратор снимал ограничение и видел «сохранено»
	КукаOwner = Клиент.Войти("root", "RootPassw0rd"); // квоту правит админ хаба
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("квота_мб", "128");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/owned/settings/quota", Поля, КукаOwner)),
		"исходная квота выставлена").ЭтоИстина();

	Плохие = Новый Соответствие();
	Плохие.Вставить("_csrf", Токен);
	Плохие.Вставить("квота_мб", "5oo");
	Ответ = Клиент.POSTФормы("/pools/owned/settings/quota", Плохие, КукаOwner);

	Ожидаем.Что(Ответ.КодСостояния, "непринятый ввод → 400, а не «сохранено»").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "НЕ изменена") > 0, "сказано, что ничего не изменилось").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner)), "128") > 0,
		"квота осталась прежней").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НулеваяКвотаДоезжаетДоПоляНаЖивомХабе() Экспорт

	// Формат(0, "ЧГ=0") возвращает ПУСТУЮ строку, а ЭкранированиеHTML.Атрибут пустое значение не печатает — поле
	// «квота_мб» приезжало БЕЗ атрибута value, хотя нуль здесь значим («без лимита»). Проверяется выдача СЕРВЕРА.
	КукаOwner = Клиент.Войти("root", "RootPassw0rd"); // квоту правит админ хаба
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("квота_мб", "0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/owned/settings/quota", Поля, КукаOwner)),
		"нулевая квота сохранена").ЭтоИстина();

	ТелоСтраницы = Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner));
	Позиция = СтрНайти(ТелоСтраницы, "name=""квота_мб""");

	Ожидаем.Что(Позиция > 0, "поле квоты на странице есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сред(ТелоСтраницы, Позиция, 120), "value=""0""") > 0,
		"нулевая квота доезжает до value, а не исчезает из поля").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеправдоподобноБольшаяКвотаОтклоняется() Экспорт

	// 10^21 МБ принималось и уезжало в арифметику сверки квот, где такая величина молча теряет точность
	КукаOwner = Клиент.Войти("root", "RootPassw0rd"); // квоту правит админ хаба
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("квота_мб", "999999999999999999999");
	Ответ = Клиент.POSTФормы("/pools/owned/settings/quota", Поля, КукаOwner);

	Ожидаем.Что(Ответ.КодСостояния, "запредельная квота → 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "слишком велика") > 0, "причина названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned/settings/quota", КукаOwner)), "999999999999999999999"),
		"значение не сохранилось").Равно(0);

	// правдоподобная квота по-прежнему принимается
	Норм = Новый Соответствие();
	Норм.Вставить("_csrf", Токен);
	Норм.Вставить("квота_мб", "1024");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/pools/owned/settings/quota", Норм, КукаOwner)),
		"обычная квота принята").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестнаяОперацияАпстримовНеГаситПубликацию() Экспорт

	// публикация пула выключалась любой формой раздела без чекбокса: устаревшей вкладки или
	// двойного сабмита хватало, чтобы пул перестал принимать opm push. Теперь у тумблера свой адрес,
	// а форма без его поля — отказ
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/owned/settings/upstreams";
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Мусор = Новый Соответствие();
	Мусор.Вставить("_csrf", Токен);
	Мусор.Вставить("операция", "чепуха");
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Мусор, КукаOwner).КодСостояния,
		"форма раздела без адреса источника → 400").Равно(400);

	Пустой = Новый Соответствие();
	Пустой.Вставить("_csrf", Токен);
	Ожидаем.Что(Клиент.POSTФормы(Раздел + "/publication", Пустой, КукаOwner).КодСостояния,
		"тумблер публикации без своего поля → 400").Равно(400);

	Ожидаем.Что(ПубликацияВключена(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), Раздел),
		"публикация осталась разрешённой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПубликацияВыключаетсяТолькоЯвнойОперацией() Экспорт

	// позитив к предыдущему тесту: законный путь — тумблер публикации — работает
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/owned/settings/upstreams";
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(Раздел, КукаOwner)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("публикация", "0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел + "/publication", Поля, КукаOwner)),
		"тумблер принят").ЭтоИстина();
	Ожидаем.Что(ПубликацияВключена(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), Раздел),
		"публикация выключена явным действием").ЭтоЛожь();

	// и включается обратно: включённый тумблер шлёт пару «1» и «0»
	Обратно = Новый Соответствие();
	Обратно.Вставить("_csrf", Токен);
	Обратно.Вставить("публикация", "1");
	Клиент.POSTФормы(Раздел + "/publication", Обратно, КукаOwner);
	Ожидаем.Что(ПубликацияВключена(Тело(Клиент.GETСКукой(Раздел, КукаOwner)), Раздел),
		"публикация включена обратно").ЭтоИстина();

КонецПроцедуры

// Отмечен ли тумблер публикации пула: форма на «publication» несёт отмеченный флажок.
Функция ПубликацияВключена(Знач Страница, Знач Раздел)

	Позиция = СтрНайти(Страница, "action=""" + Раздел + "/publication""");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Форма = Сред(Страница, Позиция);
	Форма = Лев(Форма, СтрНайти(Форма, "</form>"));
	Возврат СтрНайти(Форма, " checked") > 0;

КонецФункции

&Тест
Процедура НеАдресОтклонёнUIСВнятнойПричинойАСетьНеСудится() Экспорт

	// отвергается только то, что не является адресом выдачи; сеть назначения не судится
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/upstreams", КукаOwner)));

	Векторы = Новый Массив();
	Векторы.Добавить("file:///etc/passwd");
	Векторы.Добавить("gopher://hub.local/");
	Векторы.Добавить("hub.local/download/");
	Векторы.Добавить("http://user:pw@127.0.0.1:34999/");

	Для Каждого Вектор Из Векторы Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Токен);
		Поля.Вставить("url", Вектор);
		Поля.Вставить("ttl", "900");
		Ответ = Клиент.POSTФормы("/pools/owned/settings/upstreams", Поля, КукаOwner);
		Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("апстрим ""%1"" отклонён", Вектор)).Равно(422);
		// причина отказа читаема, а не «внутренняя ошибка»
		Ожидаем.Что(СтрНайти(Тело(Ответ), "отклонён") > 0,
			СтрШаблон("причина отказа показана (%1)", Вектор)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Ответ), "внутренняя ошибка"),
			"причина не подменена заглушкой").Равно(0);
	КонецЦикла;

	Страница = Тело(Клиент.GETСКукой("/pools/owned/settings/upstreams", КукаOwner));
	Ожидаем.Что(СтрНайти(Страница, "etc/passwd"), "не-адрес не создан").Равно(0);

	// а адрес во внутренней сети — законный источник: он заводится и виден в списке
	Ответ = ОперацияАпстрима("/pools/owned/settings/upstreams", "добавить",
		"http://169.254.169.254/latest/meta-data/", "900", КукаOwner);
	Ожидаем.Что(УспехМутации(Ответ), "адрес во внутренней сети принят").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/pools/owned/settings/upstreams", КукаOwner)), "169.254") > 0,
		"и виден в списке источников").ЭтоИстина();

	// убираем за собой: пул делится между тестами набора
	ОперацияАпстрима("/pools/owned/settings/upstreams", "удалить",
		"http://169.254.169.254/latest/meta-data/", "", КукаOwner);

КонецПроцедуры

// С выключенной пробой источника (OSHUB_UPSTREAM_PROBE_ENABLED=false) форма источников говорит,
// что адрес не проверяется, а не обещает пробное подключение.
&Тест
Процедура ФормаИсточниковНеОбещаетПробуКоторойНаЭтомХабеНет() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Страница = Тело(Клиент.GETСКукой("/pools/owned/settings/upstreams", КукаOwner));

	Ожидаем.Что(СтрНайти(Страница, "апстрим не заводится"),
		"обещания пробы, которой хаб не делает, на форме нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Пробное подключение выключено") > 0,
		"экран сам говорит, что адрес не проверяется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "oshub.upstream.probe.enabled") > 0,
		"и называет настройку, которой это включают").ЭтоИстина();

	// самотест: форма заведения на странице есть — иначе отсутствие обещания ничего не значит
	Ожидаем.Что(СтрНайти(Страница, "name=""url""") > 0, "форма заведения источника на месте")
		.ЭтоИстина();

КонецПроцедуры

// Та же неправда жила на форме зеркала: СервисЗеркал.ПроверитьПодключение ходит через
// тот же выключенный пробник, что и заведение источника пула.
&Тест
Процедура ФормаЗеркалНеОбещаетПробуКоторойНаЭтомХабеНет() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Страница = Тело(Клиент.GETСКукой("/pools/owned/settings/mirrors", КукаOwner));

	Ожидаем.Что(СтрНайти(Страница, "зеркало не заводится"),
		"обещания пробы, которой хаб не делает, на форме нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Пробное подключение выключено") > 0,
		"экран сам говорит, что адрес не проверяется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "oshub.upstream.probe.enabled") > 0,
		"и называет настройку, которой это включают").ЭтоИстина();

	// самотест: форма создания зеркала на странице есть
	Ожидаем.Что(СтрНайти(Страница, "name=""url""") > 0, "форма создания зеркала на месте")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВитриныДомовНеПринимаютPOST() Экспорт

	// разделы без мутаций отвечают 405, а не «сохранено без действия»
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	// токен берётся из раздела с формой: у «Квоты» её нет — владелец пула квоту не правит
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/owned/settings/visibility", КукаOwner)));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);

	// у пакета с версиями необратимых действий нет: опасной зоны нет и для администратора
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	ПоляПакета = Новый Соответствие();
	ПоляПакета.Вставить("_csrf",
		Клиент.ТокенCSRF(Тело(Клиент.GETСКукой("/pools/public/packages/alice-pkg/settings/card", КукаАдмина))));
	Ожидаем.Что(Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/danger", ПоляПакета, КукаАдмина).КодСостояния,
		"опасной зоны у пакета с версиями нет").Равно(404);

	// опасная зона мутацию принимает (удаление пула), но право на неё — уровня ХАБА:
	// владельцу собственного пула отвечает 403, а не 405 и не 400
	Ожидаем.Что(Клиент.POSTФормы("/pools/owned/settings/danger", Поля, КукаOwner).КодСостояния,
		"владелец пула его не удаляет: право уровня хаба").Равно(403);

КонецПроцедуры

&Тест
Процедура ЭкзотическийМетодДаётМетодНеРазрешён() Экспорт

	// winow не различает метод — его разбирает контроллер; проверяем, что разбор есть
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Ответ = ВызватьМетодом("DELETE", "/hub/settings/identity", КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "экзотический метод → 405").Равно(405);
	Ожидаем.Что(ЕстьЗаголовок(Ответ, "Allow"), "405 несёт заголовок Allow").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВитринаПравГруппыГоворитРолью() Экспорт

	// витрина дома ГРУППЫ откатывалась на набор действий, и ни один тест не краснел: одна и та же выдача обязана
	// читаться одинаково на всех экранах — в этом смысл единой ТаблицыПрав
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	ЭкранПрав = "/pools/public/settings/access";
	Токен = Клиент.ТокенCSRF(Тело(Клиент.GETСКукой(ЭкранПрав, КукаАдмина)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "выдать");
	Поля.Вставить("тип_субъекта", "группа");
	Поля.Вставить("субъект", "platform");
	Поля.Вставить("роль", "мейнтейнер");
	Клиент.POSTФормы(ЭкранПрав, Поля, КукаАдмина);

	Витрина = Тело(Клиент.GETСКукой("/groups/platform/settings/grants", КукаАдмина));

	Ожидаем.Что(СтрНайти(Витрина, ">Роль<") > 0, "витрина группы печатает колонку роли").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Витрина, ">мейнтейнер<") > 0, "и саму роль словом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Витрина, ">Действия<"), "колонки действий на витрине группы нет").Равно(0);
	Ожидаем.Что(СтрНайти(Витрина, ">чтение, создание, изменение, удаление<"),
		"набор действий не печатается").Равно(0);
	Ожидаем.Что(СтрНайти(Витрина, "/pools/public/settings/access") > 0,
		"«где править» ведёт в права доступа пула").ЭтоИстина();

КонецПроцедуры

