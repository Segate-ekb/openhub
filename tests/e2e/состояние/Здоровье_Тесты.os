// Пробы живого хаба: /health отвечает 200 и JSON с версией из packagedef, растущим аптаймом
// и состоянием живой базы, /ready — тем же разделом базы, неизвестный путь — 404.

#Использовать asserts
#Использовать packageinfo
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — запросы к подопытному хабу

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗапуститьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(60);
	Клиент = Новый КлиентХаба(Хаб, 10);

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_ADMIN_LOGIN", "health-admin");
	Окружение.Вставить("OSHUB_ADMIN_PASSWORD", "HealthAdminPass1");
	Хаб.Поднять("openhub-health", Окружение);
	Хаб.ДождатьсяОнбординга();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

КонецПроцедуры

&Тест
&Тег("смоук")
Процедура ЗдоровьеОтвечает200ИВалиднымJSON() Экспорт

	Ответ = Клиент.GET("/health");

	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНачинаетсяС(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "application/json"))
		.ЭтоИстина();

	Тело = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(Тело["status"]).Равно("ok");
	Ожидаем.Что(Тело["version"], "версия в /health — та, что объявлена в packagedef").Равно(ВерсияМанифеста());
	Ожидаем.Что(Тело["uptime_seconds"]).ИмеетТип("Число");

	ПервыйАптайм = Тело["uptime_seconds"];
	Приостановить(1100);
	ВторойАптайм = Клиент.ТелоJSON(Клиент.GET("/health"))["uptime_seconds"];
	Ожидаем.Что(ВторойАптайм > ПервыйАптайм,
		СтрШаблон("аптайм растёт между запросами: было %1, стало %2", ПервыйАптайм, ВторойАптайм))
		.ЭтоИстина();

КонецПроцедуры

// Снимок пула приезжает из настоящего источника данных: предел 10 — умолчание entity.
&Тест
Процедура ЖивыеПробыНесутСостояниеБазыИСнимокПула() Экспорт

	Для Каждого Адрес Из АдресаПроб() Цикл

		Ответ = Клиент.GET(Адрес);
		Ожидаем.Что(Ответ.КодСостояния, Адрес + ": живой хаб с живой базой").Равно(200);

		База = Клиент.ТелоJSON(Ответ)["database"];
		Ожидаем.Что(База["status"], Адрес + ": база отвечает").Равно("ok");
		Ожидаем.Что(База.Получить("reason"), Адрес + ": причины у отвечающей базы нет")
			.ЭтоНеопределено();

		Пул = База["pool"];
		Ожидаем.Что(Пул["limit"], Адрес + ": предел пула из источника данных").Равно(10);
		Ожидаем.Что(Пул["busy"], Адрес + ": занято").ИмеетТип("Число");
		Ожидаем.Что(Пул["free"], Адрес + ": свободно").ИмеетТип("Число");
		Ожидаем.Что(Пул["waiting"], Адрес + ": ждут").Равно(0);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НеизвестныйПутьОтвечает404() Экспорт

	Ожидаем.Что(Клиент.GET("/нет-такого-пути").КодСостояния, "неизвестный адрес -> 404").Равно(404);
	Ожидаем.Что(Клиент.GET("/a/b/c").КодСостояния, "немаршрутизируемый путь -> 404 роутера").Равно(404);

КонецПроцедуры

Функция АдресаПроб()

	Адреса = Новый Массив();
	Адреса.Добавить("/health");
	Адреса.Добавить("/ready");
	Адреса.Добавить("/api/v1/health");

	Возврат Адреса;

КонецФункции

Функция ВерсияМанифеста()
	Возврат Новый ИнформацияОПакете(ОбъединитьПути(Хаб.КаталогПроекта(), "packagedef")).Версия();
КонецФункции
