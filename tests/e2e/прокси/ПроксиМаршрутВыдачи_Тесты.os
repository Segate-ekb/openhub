// Пулы с апстримом через настоящий маршрут выдачи: запрос идёт по HTTP в выдачу пула и доходит
// до апстрима — нашего второго хаба на свободном порту. Два пула кэширующего хаба на одной паре хабов.

#Использовать asserts
#Использовать "../../фикстуры"

Перем ХабАпстрима;      // фикстуры ЭкземплярХаба: свой свободный порт у каждого
Перем ХабПрокси;
Перем ПортАпстрима;
Перем ПортПрокси;
Перем КореньАпстрима;
Перем КореньПрокси;
Перем КаталогПроекта;
Перем ТаймаутСек;        // Число - готовность хаба и завершение процессов засева
Перем ТаймаутАпстримаСек; // Число - сколько кэширующий хаб ждёт апстрим на один поход
Перем ТаймаутЗапросаСек; // Число - сколько набор ждёт ответа хаба
Перем Пул;               // Строка - пул с апстримом, названный сидером
Перем Пакет;
Перем ПакетТега;
Перем ПакетПозже;
Перем ПакетДефолтногоПула; // Строка - пакет, который дефолтный пул public берёт у апстрима
Перем НегативныйTTLСек;
Перем КлиентПрокси;     // фикстуры КлиентХаба поверх обоих поднятых хабов
Перем КлиентАпстрима;

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 60;
	ТаймаутАпстримаСек = 20;
	// один запрос выдачи ходит к апстриму до трёх раз подряд — за перечнем версий, страницей
	// и артефактом, поэтому набор ждёт дольше самой длинной такой цепочки
	ТаймаутЗапросаСек = 3 * ТаймаутАпстримаСек + 30;
	Пул = "upstream";
	Пакет = "proxy-route-pkg";
	ПакетТега = "proxy-tag-pkg";
	ПакетПозже = "proxy-late-pkg";
	ПакетДефолтногоПула = "spike0c-testpkg";
	НегативныйTTLСек = 2;
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабы() Экспорт

	ХабАпстрима = НовыйХаб();
	КаталогПроекта = ХабАпстрима.КаталогПроекта();

	КореньАпстрима = УникальныеИмена.ВременныйПуть("oshub-proxy-up");
	КореньПрокси = УникальныеИмена.ВременныйПуть("oshub-proxy-down");
	СоздатьКаталог(ОбъединитьПути(КореньАпстрима, "jsondb"));
	СоздатьКаталог(ОбъединитьПути(КореньПрокси, "jsondb"));

	ЗадатьОкружениеАпстрима(Пакет, "1.0.0,2.0.0");
	ЗапуститьЗасев();
	ЗадатьОкружениеАпстрима(ПакетТега, "1.0.0");
	ЗапуститьЗасев();
	ЗадатьОкружениеАпстрима(ПакетДефолтногоПула, "1.0.0,1.1.0,1.1.0.7,2.0.0-rc.1", "1.1.0.7");
	ЗапуститьЗасев();
	ХабАпстрима.Запустить();
	ПортАпстрима = ХабАпстрима.Порт();
	КлиентАпстрима = Новый КлиентХаба(ХабАпстрима, ТаймаутЗапросаСек);

	// апстрим пулов известен только после старта апстрима — его порт выдаёт ОС
	ХабПрокси = НовыйХаб();
	ЗадатьОкружениеПрокси(Пул, "proxy-own-pkg", "2");
	ЗапуститьЗасев();
	ЗадатьОкружениеПрокси("public", "mirror-local-pkg", "3");
	ЗапуститьЗасев();
	ХабПрокси.Запустить();
	ПортПрокси = ХабПрокси.Порт();
	КлиентПрокси = Новый КлиентХаба(ХабПрокси, ТаймаутЗапросаСек);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХабы() Экспорт
	Если ХабПрокси <> Неопределено Тогда
		ХабПрокси.Остановить();
	КонецЕсли;
	Если ХабАпстрима <> Неопределено Тогда
		ХабАпстрима.Остановить();
	КонецЕсли;
	ОчиститьОкружение();
КонецПроцедуры

// Сценарий один и идёт по порядку: шаги зависят от состояния кэша, последний гасит апстрим,
// а очерёдность отдельных &Тест OneUnit не гарантирует. При провале печатается вывод обоих хабов.
&Тест
Процедура КэширующийПулРаботаетЧерезМаршрутВыдачи() Экспорт

	Попытка
		ТриФормыЗапросаДоходятДоАпстрима();
		СкачанноеПопадаетВРеестрПула();
		НеканальныйТегНаружуНеХодит();
		SNAPSHOTПроксируетсяНоПоследнейНеСтановится();
		ПакетТолькоСоСнапшотомБезверсионноНеОтдаётся();
		Промах404НеСтановитсяВечнойДырой();
		ДефолтныйПулОтдаётВерсиюАпстримаПоАдресуПулаИАлиасу();
		ПоследняяВерсияБерётсяИзМанифестаСкачанного();
		OpmInstallЧерезДефолтныйПул();
		ОтказАпстримаНеЛомаетВыдачу();
	Исключение
		ДампХабов();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#Область ШагиСценария

// Точная версия, безверсионный файл и канальный путь: пакета нет в пуле — каждая форма
// обязана уйти на апстрим и вернуть тело.
Процедура ТриФормыЗапросаДоходятДоАпстрима()

	Версия = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-1.0.0.ospx", Пул, Пакет));
	Ожидаем.Что(Версия.КодСостояния, "точная версия проксирована с апстрима").Равно(200);
	Ожидаем.Что(Версия.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело .ospx не пустое").ЭтоИстина();

	Последняя = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2.ospx", Пул, Пакет));
	Ожидаем.Что(Последняя.КодСостояния, "безверсионный файл проксирован с апстрима").Равно(200);

	Канальная = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/channels/stable/download/%2/%2.ospx", Пул, Пакет));
	Ожидаем.Что(Канальная.КодСостояния, "канальный путь stable проксирован с апстрима").Равно(200);

	Артефакт = ОбъединитьПути(ОбъединитьПути(КореньПрокси, "pools", Пул), Пакет, Пакет + "-1.0.0.ospx");
	Ожидаем.Что(Новый Файл(Артефакт).Существует(), "артефакт закэширован: " + Артефакт).ЭтоИстина();

КонецПроцедуры

// Ленивая индексация: имя и версия видны реестру пула, а страницы пакета не падают.
Процедура СкачанноеПопадаетВРеестрПула()

	Список = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/list.txt", Пул));
	Ожидаем.Что(СтрНайти(Список.ПолучитьТелоКакСтроку(), Пакет) > 0,
		"проксированный пакет попал в list.txt пула").ЭтоИстина();

	// имя «Версии» занимает глобальный контекст: присваивание ему в наборе не пишется
	ОтветВерсий = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/packages/%2/versions", Пул, Пакет));
	Ожидаем.Что(ОтветВерсий.КодСостояния, "версии проксированного пакета отдаются API").Равно(200);
	Ожидаем.Что(СтрНайти(ОтветВерсий.ПолучитьТелоКакСтроку(), "1.0.0") > 0,
		"скачанная версия проиндексирована: " + ОтветВерсий.ПолучитьТелоКакСтроку()).ЭтоИстина();

	Карточка = КлиентПрокси.GET(СтрШаблон("/pools/%1/packages/%2", Пул, Пакет));
	Ожидаем.Что(Карточка.КодСостояния, "карточка проксированного пакета открывается").Равно(200);

	Зависимости = КлиентПрокси.GET(СтрШаблон("/pools/%1/packages/%2/deps", Пул, Пакет));
	Ожидаем.Что(Зависимости.КодСостояния, "вкладка зависимостей проксированного пакета открывается").Равно(200);

КонецПроцедуры

// Апстрим отдаёт ровно один безверсионный {имя}.ospx — свой stable; прочие теги обслуживает
// локальный индекс пула, и незнакомое пулу имя по каналу dev даёт 404.
Процедура НеканальныйТегНаружуНеХодит()

	Дев = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/channels/dev/download/%2/%2.ospx", Пул, ПакетТега));
	Ожидаем.Что(Дев.КодСостояния, "неизвестное пулу имя по каналу dev апстриму не адресуется").Равно(404);

	Стабл = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/channels/stable/download/%2/%2.ospx", Пул, ПакетТега));
	Ожидаем.Что(Стабл.КодСостояния, "то же имя по каналу stable уходит на апстрим").Равно(200);

КонецПроцедуры

// Имя пакета с дефисами: разбор, делящий «имя-версия» по первому дефису, взял бы версию
// «dash-pkg-SNAPSHOT». Слот проксируется, но последней версией не становится.
Процедура SNAPSHOTПроксируетсяНоПоследнейНеСтановится()

	Имя = "vanessa-dash-pkg";
	ЗасеятьВАпстримПослеСтарта(Имя, "1.0.0,SNAPSHOT");

	Снапшот = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-SNAPSHOT.ospx", Пул, Имя));
	Ожидаем.Что(Снапшот.КодСостояния, "SNAPSHOT пакета с дефисами в имени проксирован").Равно(200);
	Ожидаем.Что(Снапшот.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело .ospx не пустое").ЭтоИстина();

	Артефакт = ОбъединитьПути(ОбъединитьПути(КореньПрокси, "pools", Пул), Имя, Имя + "-SNAPSHOT.ospx");
	Ожидаем.Что(Новый Файл(Артефакт).Существует(), "артефакт закэширован: " + Артефакт).ЭтоИстина();

	ОтветВерсий = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/packages/%2/versions", Пул, Имя));
	Ожидаем.Что(СтрНайти(ОтветВерсий.ПолучитьТелоКакСтроку(), "SNAPSHOT") > 0,
		"скачанный SNAPSHOT проиндексирован: " + ОтветВерсий.ПолучитьТелоКакСтроку()).ЭтоИстина();

	// координата слота не называет сборку — её называет манифест, и API обязан её показать
	Ожидаем.Что(НомерМанифестаВерсии(ОтветВерсий, "SNAPSHOT"),
		"API называет сборку, лежащую в слоте").Равно("0.1.0");

	Спеком = КлиентПрокси.GET(
		СтрШаблон("/api/v1/pools/%1/download/%2/%2.ospx?spec=SNAPSHOT", Пул, Имя));
	Ожидаем.Что(Спеком.КодСостояния, "?spec=SNAPSHOT обслужен").Равно(200);
	Ожидаем.Что(ИмяВыданногоФайла(Спеком), "и отдал именно слот").Равно(Имя + "-SNAPSHOT.ospx");

	// у апстрима версии опубликованы: безверсионный запрос отдаёт релиз
	УАпстрима = КлиентАпстрима.GET(СтрШаблон("/download/%1/%1.ospx", Имя));
	Ожидаем.Что(ИмяВыданногоФайла(УАпстрима),
		"опубликованный SNAPSHOT не стал последней версией").Равно(Имя + "-1.0.0.ospx");

	// строку версии latest прокси берёт из манифеста скачанного: сверяется отсутствие снапшота
	Последняя = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2.ospx", Пул, Имя));
	Ожидаем.Что(Последняя.КодСостояния, "безверсионный запрос обслужен").Равно(200);
	Ожидаем.Что(СтрНайти(ВРег(ИмяВыданногоФайла(Последняя)), "SNAPSHOT"),
		"выдан релиз, а не снапшот: " + ИмяВыданногоФайла(Последняя)).Равно(0);

	Канальная = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/channels/stable/download/%2/%2.ospx", Пул, Имя));
	Ожидаем.Что(СтрНайти(ВРег(ИмяВыданногоФайла(Канальная)), "SNAPSHOT"),
		"канал stable — тоже не снапшот: " + ИмяВыданногоФайла(Канальная)).Равно(0);

КонецПроцедуры

// Релизов нет вовсе — последней версии не существует: 404 честнее отданной ночной сборки,
// а точная координата снапшота работает.
Процедура ПакетТолькоСоСнапшотомБезверсионноНеОтдаётся()

	Имя = "snap-only-pkg";
	ЗасеятьВАпстримПослеСтарта(Имя, "SNAPSHOT");

	Точная = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-SNAPSHOT.ospx", Пул, Имя));
	Ожидаем.Что(Точная.КодСостояния, "по точной версии снапшот доступен").Равно(200);

	Безверсионный = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2.ospx", Пул, Имя));
	Ожидаем.Что(Безверсионный.КодСостояния,
		"без релизов последней версии нет — 404, а не снапшот").Равно(404);

	Для Каждого ИмяКанала Из СтрРазделить("stable,latest", ",") Цикл
		Канальный = КлиентПрокси.GET(
			СтрШаблон("/api/v1/pools/%1/channels/%2/download/%3/%3.ospx", Пул, ИмяКанала, Имя));
		Ожидаем.Что(Канальный.КодСостояния,
			СтрШаблон("канал %1 снапшот не отдаёт", ИмяКанала)).Равно(404);
	КонецЦикла;

КонецПроцедуры

// 404 апстрима доезжает до клиента как 404, а негативная запись живёт ровно свой срок:
// появившийся позже пакет обязан скачаться.
Процедура Промах404НеСтановитсяВечнойДырой()

	Промах = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-1.0.0.ospx", Пул, ПакетПозже));
	Ожидаем.Что(Промах.КодСостояния, "неизвестный апстриму пакет — 404 клиенту").Равно(404);
	Ожидаем.Что(СтрНачинаетсяС(Промах.ПолучитьТелоКакСтроку(), "not found:"),
		"404 объясняет себя: " + Промах.ПолучитьТелоКакСтроку()).ЭтоИстина();

	// негативная запись не отравляет соседей: уже известный пакет продолжает обслуживаться
	Сосед = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-2.0.0.ospx", Пул, Пакет));
	Ожидаем.Что(Сосед.КодСостояния, "промах по одному имени не закрывает другое").Равно(200);

	ЗасеятьВАпстримПослеСтарта(ПакетПозже, "1.0.0");
	Приостановить((НегативныйTTLСек + 1) * 1000);

	Появился = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-1.0.0.ospx", Пул, ПакетПозже));
	Ожидаем.Что(Появился.КодСостояния,
		"по истечении срока негативной записи пакет скачивается, а не остаётся дырой").Равно(200);

КонецПроцедуры

// Дефолтный пул public с апстримом отдаёт чужую версию и по адресу пула, и по алиасу /download,
// кладёт артефакт в кэш на диске и индексирует его с суммой — отсюда ETag.
Процедура ДефолтныйПулОтдаётВерсиюАпстримаПоАдресуПулаИАлиасу()

	ИмяФайла = ПакетДефолтногоПула + "-1.0.0.ospx";

	ПоПулу = КлиентПрокси.GET(СтрШаблон("/pools/public/download/%1/%2", ПакетДефолтногоПула, ИмяФайла));
	Ожидаем.Что(ПоПулу.КодСостояния, "точная версия проксирована дефолтным пулом").Равно(200);
	Ожидаем.Что(ПоПулу.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело .ospx не пустое").ЭтоИстина();

	ПоАлиасу = КлиентПрокси.GET(СтрШаблон("/download/%1/%2", ПакетДефолтногоПула, ИмяФайла));
	Ожидаем.Что(ПоАлиасу.КодСостояния, "точная версия через дефолтный алиас /download").Равно(200);

	Список = КлиентПрокси.GET("/pools/public/download/list.txt");
	Ожидаем.Что(СтрНайти(Список.ПолучитьТелоКакСтроку(), ПакетДефолтногоПула) > 0,
		"скачанный пакет проиндексирован в дефолтном пуле").ЭтоИстина();

	Ожидаем.Что(ЗначениеЗаполнено(КлиентПрокси.ЗаголовокОтвета(ПоПулу, "ETag")),
		"проксированная версия отдаёт ETag").ЭтоИстина();

	Артефакт = ОбъединитьПути(ОбъединитьПути(КореньПрокси, "pools", "public"), ПакетДефолтногоПула, ИмяФайла);
	Ожидаем.Что(Новый Файл(Артефакт).Существует(), "артефакт закэширован: " + Артефакт).ЭтоИстина();

КонецПроцедуры

// Версию latest хаб берёт из манифеста скачанного .ospx: у фикстуры он называет 0.1.0.
Процедура ПоследняяВерсияБерётсяИзМанифестаСкачанного()

	Последняя = КлиентПрокси.GET(СтрШаблон("/download/%1/%1.ospx", ПакетДефолтногоПула));
	Ожидаем.Что(Последняя.КодСостояния, "latest проксирован").Равно(200);
	Ожидаем.Что(ИмяВыданногоФайла(Последняя), "latest резолвится по версии из манифеста")
		.Равно(ПакетДефолтногоПула + "-0.1.0.ospx");

КонецПроцедуры

// Настоящий opm install через кэширующий пул — когда opm установлен на машине.
Процедура OpmInstallЧерезДефолтныйПул()

	Если НЕ ОпмДоступен() Тогда
		Возврат;
	КонецЕсли;

	РабочийКаталог = УникальныеИмена.ВременныйКаталог("oshub-opm-proxy");

	Конфиг =
	"{
	|    ""СервераПакетов"": [
	|        {
	|            ""Имя"": ""openhub-proxy"",
	|            ""Сервер"": ""http://localhost"",
	|            ""Порт"": " + Формат(ПортПрокси, "ЧГ=0; ЧН=0") + ",
	|            ""ПутьНаСервере"": ""/pools/public/download/"",
	|            ""РесурсПубликацииПакетов"": ""/pools/public/push"",
	|            ""Приоритет"": 0
	|        }
	|    ]
	|}";
	ЗаписьКонфига = Новый ЗаписьТекста(ОбъединитьПути(РабочийКаталог, "opm.cfg"), КодировкаТекста.UTF8);
	ЗаписьКонфига.Записать(Конфиг);
	ЗаписьКонфига.Закрыть();

	ПроцессOpm = СоздатьПроцесс("opm install -l " + ПакетДефолтногоПула, РабочийКаталог, Истина);
	ПроцессOpm.Запустить();
	ДождатьсяПроцесса(ПроцессOpm, "opm install через кэширующий пул");

	Ожидаем.Что(ПроцессOpm.КодВозврата, "opm install через кэширующий пул завершился кодом 0").Равно(0);

	Установленный = ОбъединитьПути(РабочийКаталог, "oscript_modules", ПакетДефолтногоПула, "opm-metadata.xml");
	Ожидаем.Что(Новый Файл(Установленный).Существует(),
		"пакет установлен через кэширующий пул: " + Установленный).ЭтоИстина();

КонецПроцедуры

// Апстрим лёг: закэшированное продолжает отдаваться, а не скачанное отвечает внятным 404,
// а не 500 со стектрейсом.
Процедура ОтказАпстримаНеЛомаетВыдачу()

	ХабАпстрима.Остановить();
	Приостановить(1000);

	ИзКэша = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-1.0.0.ospx", Пул, Пакет));
	Ожидаем.Что(ИзКэша.КодСостояния, "закэшированный артефакт отдаётся при лежащем апстриме").Равно(200);

	Незнакомый = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/%2/%2-3.0.0.ospx", Пул, Пакет));
	Ожидаем.Что(Незнакомый.КодСостояния,
		"не скачанное ранее при лежащем апстриме — 404, а не 5xx").Равно(404);
	Ожидаем.Что(СтрНачинаетсяС(Незнакомый.ПолучитьТелоКакСтроку(), "not found:"),
		"отказ объясняет себя: " + Незнакомый.ПолучитьТелоКакСтроку()).ЭтоИстина();

	Список = КлиентПрокси.GET(СтрШаблон("/api/v1/pools/%1/download/list.txt", Пул));
	Ожидаем.Что(Список.КодСостояния, "list.txt при лежащем апстриме отдаётся из кэша").Равно(200);

	ИзКэшаДефолтного = КлиентПрокси.GET(СтрШаблон("/download/%1/%1-1.0.0.ospx", ПакетДефолтногоПула));
	Ожидаем.Что(ИзКэшаДефолтного.КодСостояния,
		"дефолтный пул отдаёт закэшированное при лежащем апстриме").Равно(200);

	ПромахДефолтного = КлиентПрокси.GET(СтрШаблон("/download/%1/%1-2.0.0-rc.1.ospx", ПакетДефолтногоПула));
	Ожидаем.Что(ПромахДефолтного.КодСостояния,
		"не скачанная ранее версия дефолтного пула при лежащем апстриме — 404").Равно(404);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Процедура ЗадатьОкружениеАпстрима(Знач ИмяПакета, Знач СписокВерсий, Знач Отозванные = "")
	ХабАпстрима.Среда("OSHUB_STORAGE_ROOT", КореньАпстрима);
	ХабАпстрима.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньАпстрима, "jsondb"));
	ХабАпстрима.Среда("OSHUB_SEED_FIXTURE", ПутьФикстурыПакета());
	ХабАпстрима.Среда("OSHUB_SEED_POOL", "public");
	ХабАпстрима.Среда("OSHUB_SEED_PACKAGE", ИмяПакета);
	ХабАпстрима.Среда("OSHUB_SEED_VERSIONS", СписокВерсий);
	ХабАпстрима.Среда("OSHUB_SEED_YANKED", Отозванные);
	СнятьПеременныеАпстримаЗасева(); // апстрим — обычный хаб, своих апстримов у него нет
КонецПроцедуры

// Пул с апстримом заводит сидер — тем же путём, каким его заводит оператор; свой пакет пула
// раздаётся из пула, чужие подтягиваются апстримом.
Процедура ЗадатьОкружениеПрокси(Знач ИмяПула, Знач СвойПакет, Знач СрокЖизниСек)
	ХабПрокси.Среда("OSHUB_STORAGE_ROOT", КореньПрокси);
	ХабПрокси.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньПрокси, "jsondb"));
	ХабПрокси.Среда("OSHUB_POOLS_DEFAULT", "");
	ХабПрокси.Среда("OSHUB_SEED_FIXTURE", ПутьФикстурыПакета());
	ХабПрокси.Среда("OSHUB_SEED_POOL", ИмяПула);
	ХабПрокси.Среда("OSHUB_SEED_PACKAGE", СвойПакет);
	ХабПрокси.Среда("OSHUB_SEED_VERSIONS", "0.1.0");
	ХабПрокси.Среда("OSHUB_SEED_YANKED", "");
	ХабПрокси.Среда("OSHUB_SEED_UPSTREAM_URL",
		СтрШаблон("http://localhost:%1/download/", Формат(ПортАпстрима, "ЧГ=0; ЧН=0")));
	ХабПрокси.Среда("OSHUB_SEED_UPSTREAM_TTL_SEC", СрокЖизниСек);
	// «_» в имени переменной configor читает точкой: так задаётся oshub.proxy.negative.ttl.sec
	ХабПрокси.Среда("OSHUB_PROXY_NEGATIVE_TTL_SEC", Формат(НегативныйTTLСек, "ЧГ=0; ЧН=0"));
	ХабПрокси.Среда("OSHUB_PROXY_TIMEOUT_SEC", Формат(ТаймаутАпстримаСек, "ЧГ=0; ЧН=0"));
КонецПроцедуры

// Досев пакета в базу работающего апстрима: между запросами набора хаб простаивает,
// и файловый коннектор читает уже дописанные файлы.
Процедура ЗасеятьВАпстримПослеСтарта(Знач ИмяПакета, Знач СписокВерсий)

	УстановитьПеременнуюСреды("OSHUB_STORAGE_ROOT", КореньАпстрима);
	УстановитьПеременнуюСреды("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньАпстрима, "jsondb"));
	УстановитьПеременнуюСреды("OSHUB_SEED_FIXTURE", ПутьФикстурыПакета());
	УстановитьПеременнуюСреды("OSHUB_SEED_POOL", "public");
	УстановитьПеременнуюСреды("OSHUB_SEED_PACKAGE", ИмяПакета);
	УстановитьПеременнуюСреды("OSHUB_SEED_VERSIONS", СписокВерсий);
	УстановитьПеременнуюСреды("OSHUB_SEED_YANKED", "");
	СнятьПеременныеАпстримаЗасева();

	ЗапуститьЗасев();

КонецПроцедуры

// Номер из манифеста, как его называет ответ /versions по конкретной строке версии.
Функция НомерМанифестаВерсии(Знач Ответ, Знач СтрокаВерсии)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Тело = ПрочитатьJSON(Чтение, Истина);

	Для Каждого Версия Из Тело.Получить("versions") Цикл
		Если Строка(Версия.Получить("version")) = СтрокаВерсии Тогда
			Возврат Строка(Версия.Получить("manifest_version"));
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "версии " + СтрокаВерсии + " в ответе /versions нет";

КонецФункции

// Имя файла из Content-Disposition — снаружи только так видно, КАКУЮ версию отдал безверсионный запрос.
Функция ИмяВыданногоФайла(Знач Ответ)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если НРег(Строка(КиЗ.Ключ)) <> "content-disposition" Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Строка(КиЗ.Значение), """", Ложь);
		Возврат ?(Части.Количество() >= 2, Части[1], Строка(КиЗ.Значение));
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПутьФикстурыПакета()
	Возврат ОбъединитьПути(КаталогиПроекта.Фикстуры(), "spike0c-testpkg-0.1.0.ospx");
КонецФункции

Процедура СнятьПеременныеАпстримаЗасева()
	Для Каждого Имя Из СтрРазделить(
		"OSHUB_SEED_UPSTREAM_URL,OSHUB_SEED_UPSTREAM_TTL_SEC,OSHUB_POOLS_DEFAULT", ",") Цикл
		УстановитьПеременнуюСреды(Имя, "");
	КонецЦикла;
КонецПроцедуры

Процедура ОчиститьОкружение()
	Перем_ = "OSHUB_PORT,OSHUB_STORAGE_ROOT,OSHUB_DB_CONNECTOR,OSHUB_DB_CONNECTION,OSHUB_SEED_FIXTURE,"
		+ "OSHUB_SEED_POOL,OSHUB_SEED_PACKAGE,OSHUB_SEED_VERSIONS,OSHUB_SEED_YANKED,OSHUB_POOLS_DEFAULT,"
		+ "OSHUB_SEED_UPSTREAM_URL,OSHUB_SEED_UPSTREAM_TTL_SEC,"
		+ "OSHUB_PROXY_NEGATIVE_TTL_SEC,OSHUB_PROXY_TIMEOUT_SEC";
	Для Каждого Имя Из СтрРазделить(Перем_, ",") Цикл
		УстановитьПеременнуюСреды(Имя, "");
	КонецЦикла;
КонецПроцедуры

Процедура ЗапуститьЗасев()
	ПутьЗасевщика = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьПакет.os");
	ПроцессЗасева = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ПутьЗасевщика), КаталогПроекта, Истина);
	ПроцессЗасева.Запустить();
	ДождатьсяПроцесса(ПроцессЗасева, "засев хаба");
	Если ПроцессЗасева.КодВозврата <> 0 Тогда
		// упавший сценарий печатает своё падение в stdout; молчавший поток читается Неопределено
		ВызватьИсключение "Засев завершился с ошибкой: "
			+ Строка(ПроцессЗасева.ПотокВывода.Прочитать()) + Строка(ПроцессЗасева.ПотокОшибок.Прочитать());
	КонецЕсли;
КонецПроцедуры

// Установлен ли исполняемый opm.
Функция ОпмДоступен()
	Попытка
		Проба = СоздатьПроцесс("opm version", , Истина);
		Проба.Запустить();
		ДождатьсяПроцесса(Проба, "opm version");
		Возврат Проба.КодВозврата = 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Фоновые задачи и доставщик вебхуков выключены: обработчик запроса и фоновая рогатка в одном
// процессе лезут в один JSON-файл файлового коннектора. «__» в имени — это «_» в имени детальки.
Функция НовыйХаб()

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(ТаймаутСек);
	Хаб.Среда("OSHUB_JOBS_ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Возврат Хаб;

КонецФункции

Процедура ДождатьсяПроцесса(Знач Процесс_, Знач Пояснение)
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Если Процесс_.Завершен Тогда
			Возврат;
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Процесс ""%1"" не завершился за %2 сек", Пояснение, ТаймаутСек);
КонецПроцедуры

// Вывод обоих хабов — единственный источник серверного стектрейса при 5xx.
Процедура ДампХабов()
	Сообщить("=== КЭШИРУЮЩИЙ ХАБ ===");
	Сообщить(?(ХабПрокси = Неопределено, "не поднимался", ХабПрокси.Дамп()));
	Сообщить("=== АПСТРИМ ===");
	Сообщить(?(ХабАпстрима = Неопределено, "не поднимался", ХабАпстрима.Дамп()));
КонецПроцедуры

#КонецОбласти
