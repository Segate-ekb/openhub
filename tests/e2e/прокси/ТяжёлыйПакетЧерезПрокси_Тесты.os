// Пакет в 40 МБ через кэширующий пул: хаб привозит его с апстрима в файл, сверяет с ETag
// и отдаёт байт в байт — и в первый раз, и из своего кэша.

#Использовать asserts
#Использовать "../../фикстуры"

Перем ХабАпстрима;   // фикстура ЭкземплярХаба
Перем ХабПрокси;
Перем КлиентПрокси;  // фикстура КлиентХаба
Перем ТаймаутСек;
Перем КаталогСборки;
Перем Пакет;         // Строка - путь к тяжёлому .ospx, засеянному в апстрим

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 60;
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабы() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-heavy-proxy");
	Пакет = Новый ФикстураПакета().ПостроитьТяжёлыйOspx(КаталогСборки, "heavy-proxy-pkg", "1.0.0",
		40 * 1048576);

	ХабАпстрима = НовыйХаб();
	Апстрим = Новый Соответствие();
	Апстрим.Вставить("OSHUB_SEED_FIXTURE", Пакет);
	Апстрим.Вставить("OSHUB_SEED_POOL", "public");
	Апстрим.Вставить("OSHUB_SEED_PACKAGE", "heavy-proxy-pkg");
	Апстрим.Вставить("OSHUB_SEED_VERSIONS", "1.0.0");
	ХабАпстрима.Поднять("oshub-heavy-up", Апстрим, "ЗасеятьПакет.os");

	ХабПрокси = НовыйХаб();
	Прокси = Новый Соответствие();
	Прокси.Вставить("OSHUB_SEED_FIXTURE", ОбъединитьПути(КаталогиПроекта.Фикстуры(), "spike0c-testpkg-0.1.0.ospx"));
	Прокси.Вставить("OSHUB_SEED_POOL", "cache");
	Прокси.Вставить("OSHUB_SEED_PACKAGE", "own-pkg");
	Прокси.Вставить("OSHUB_SEED_VERSIONS", "0.1.0");
	Прокси.Вставить("OSHUB_POOLS_DEFAULT", "");
	Прокси.Вставить("OSHUB_SEED_UPSTREAM_URL",
		СтрШаблон("http://localhost:%1/download/", Формат(ХабАпстрима.Порт(), "ЧГ=0; ЧН=0")));
	Прокси.Вставить("OSHUB_SEED_UPSTREAM_TTL_SEC", "60");
	Прокси.Вставить("OSHUB_PROXY_TIMEOUT_SEC", "120");
	ХабПрокси.Поднять("oshub-heavy-down", Прокси, "ЗасеятьПакет.os");
	КлиентПрокси = Новый КлиентХаба(ХабПрокси, 300);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХабы() Экспорт
	Если ХабПрокси <> Неопределено Тогда
		ХабПрокси.Остановить();
	КонецЕсли;
	Если ХабАпстрима <> Неопределено Тогда
		ХабАпстрима.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборки);
КонецПроцедуры

&Тест
Процедура ТяжёлыйПакетЧерезПроксиОтдаётсяБайтВБайт() Экспорт

	Эталон = Sha256Файла(Пакет);

	Первое = СкачатьЧерезПрокси();
	Ожидаем.Что(Sha256Файла(Первое), "первая выдача — привезённые с апстрима байты").Равно(Эталон);

	Файл = ОбъединитьПути(ОбъединитьПути(ХабПрокси.КореньХранилища(), "pools", "cache"), "heavy-proxy-pkg",
		"heavy-proxy-pkg-1.0.0.ospx");
	Ожидаем.Что(Новый Файл(Файл).Существует(), "артефакт лёг в кэш пула").ЭтоИстина();

	Второе = СкачатьЧерезПрокси();
	Ожидаем.Что(Sha256Файла(Второе), "повтор из кэша пула — те же байты").Равно(Эталон);

КонецПроцедуры

#Область Служебные

Функция СкачатьЧерезПрокси()

	Скачанное = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор) + ".ospx");
	Ответ = КлиентПрокси.Соединение().Получить(
		Новый HTTPЗапрос("/api/v1/pools/cache/download/heavy-proxy-pkg/heavy-proxy-pkg-1.0.0.ospx"), Скачанное);
	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("=== КЭШИРУЮЩИЙ ХАБ ===" + Символы.ПС + ХабПрокси.Дамп());
		Сообщить("=== АПСТРИМ ===" + Символы.ПС + ХабАпстрима.Дамп());
	КонецЕсли;
	Ожидаем.Что(Ответ.КодСостояния, "кэширующий пул отдаёт пакет апстрима").Равно(200);
	Возврат Скачанное;

КонецФункции

// Фон и доставка вебхуков выключены: обработчик запроса и фоновая задача в одном процессе
// делят файлы файловой базы.
Функция НовыйХаб()
	Хаб = Новый ЭкземплярХаба(ТаймаутСек);
	Хаб.ВыключитьФон();
	Возврат Хаб;
КонецФункции

Функция Sha256Файла(Знач Путь)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(Путь);
	Возврат НРег(Хеширование.ХешСуммаСтрокой);
КонецФункции

#КонецОбласти
