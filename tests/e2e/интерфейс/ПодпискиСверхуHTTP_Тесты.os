// Подписки сверху на живом хабе: администратор заводит подписку хаба и разрешает её сузить,
// владелец пула и пакета видит её без адреса и секретов, ставит поправку и не может тронуть
// саму подписку; подписка без разрешения на адресе поправки отвечает 404. Засев кабинета:
// приватный пул secret с пакетом secret-pkg во владении owner1.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);

	Хаб.ФайловаяБаза("openhub-подписки-сверху");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// фоновую доставку гасим: набор смотрит страницы и ответы, а не сеть
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры",
		"ЗасеятьКабинет.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Тесты

&Тест
Процедура ВладелецПулаВидитПодпискуХабаБезСекретовИСужаетЕё() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Адрес = "https://hooks.example.com/hub-narrow-ui";
	Ид = ПодпискаХабаЭкраном(КукаRoot, Адрес, "релизы для пулов");

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Страница = Клиент.Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Страница, "Подписки сверху") > 0, "раздел подписок сверху есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "релизы для пулов") > 0, "название видно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "теги: stable") > 0, "отбор виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, Адрес), "адреса доставки в разметке нет").Равно(0);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Поля.Вставить("не_присылать", "1");
	Ответ = Клиент.POSTФормы(Раздел + "/inherited/" + Ид + "/narrow", Поля, КукаOwner);
	Ожидаем.Что(Ответ.КодСостояния < 400, "поправка принята").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "не присылается") > 0,
		"пул видит свою поправку").ЭтоИстина();
	Хозяину = Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot));
	Ожидаем.Что(СтрНайти(Хозяину, "пул secret") > 0, "хозяин видит, кто сузил").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПоправкаНеДаётУдалитьВыключитьИПроверитьЧужуюПодписку() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ид = ПодпискаХабаВAPI(КукаRoot, "https://hooks.example.com/hub-foreign", "чужая", Истина);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, КукаOwner)));
	Поля = Новый Соответствие();
	// поля полной формы правки: отказ обязан быть «нет такой подписки», а не «форма не та»
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("включить", "0");
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://evil.example.com/takeover");
	Поля.Вставить("событие_0", "1");

	Для Каждого Действие Из СтрРазделить("delete,toggle,test,save", ",") Цикл
		Ожидаем.Что(Клиент.POSTФормы(Раздел + "/" + Ид + "/" + Действие, Поля, КукаOwner).КодСостояния,
			СтрШаблон("%1 подписки хаба из раздела пула — как несуществующей", Действие)).Равно(404);
	КонецЦикла;

	Карточка = Клиент.ЗапросJSON("GET", "/api/v1/webhooks/" + Ид, "", Клиент.Кука(КукаRoot));
	Ожидаем.Что(Карточка.КодСостояния, "подписка хаба жива").Равно(200);
	Ожидаем.Что(Значение(Клиент.Тело(Карточка), "subscription").Получить("enabled"), "и включена").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПодпискаБезРазрешенияНевиднаИНаАдресеПоправкиОтвечает404() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ид = ПодпискаХабаВAPI(КукаRoot, "https://hooks.example.com/hub-closed", "закрытая подписка", Ложь);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Страница = Клиент.Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Страница, "закрытая подписка"), "без разрешения подписки не видно").Равно(0);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Поля.Вставить("не_присылать", "1");
	Ожидаем.Что(Клиент.POSTФормы(Раздел + "/inherited/" + Ид + "/narrow", Поля, КукаOwner).КодСостояния,
		"поправка к неразрешённой подписке — 404").Равно(404);
	Ожидаем.Что(Клиент.ЗапросJSON("GET", "/api/v1/pools/secret/inherited-webhooks/" + Ид, "",
		Клиент.Кука(КукаOwner)).КодСостояния, "и в API — 404").Равно(404);

КонецПроцедуры

&Тест
Процедура ПакетСужаетПодпискуХабаЧерезAPIБезАдресаВОтвете() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Адрес = "https://hooks.example.com/hub-package-api";
	Ид = ПодпискаХабаВAPI(КукаRoot, Адрес, "релизы для пакетов", Истина);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/packages/secret-pkg/settings/webhooks";
	Страница = Клиент.Тело(Клиент.GETСКукой(Раздел, КукаOwner));
	Ожидаем.Что(СтрНайти(Страница, "релизы для пакетов") > 0, "пакет видит подписку хаба").ЭтоИстина();

	Путь = "/api/v1/pools/secret/packages/secret-pkg/inherited-webhooks";
	Список = Клиент.ЗапросJSON("GET", Путь, "", Клиент.Кука(КукаOwner));
	Ожидаем.Что(Список.КодСостояния, "список подписок сверху").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Список), Адрес), "адреса в ответе нет").Равно(0);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Список), "релизы для пакетов") > 0, "название есть").ЭтоИстина();

	Поставлено = Клиент.ЗапросJSON("PUT", Путь + "/" + Ид, "{""tags"":[""stable""]}",
		Клиент.ЗаголовкиМутации(КукаOwner, Клиент.ТокенCSRF(Страница)));
	Ожидаем.Что(Поставлено.КодСостояния, "поправка через API").Равно(200);
	Поправка = Значение(Клиент.Тело(Поставлено), "subscription").Получить("amendment");
	Ожидаем.Что(СтрСоединить(Поправка.Получить("tags"), ","), "отбор поправки лёг").Равно("stable");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Поставлено), Адрес), "и в ответе на правку адреса нет").Равно(0);

	Ожидаем.Что(Клиент.ЗапросJSON("GET", Путь, "", Клиент.Кука(Клиент.Войти("bob", "BobPassw0rd"))).КодСостояния,
		"посторонний чужой приватный пакет не находит").Равно(404);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Подписка хаба формой раздела, с разрешением сужать и отбором stable; идентификатор — из карточки.
Функция ПодпискаХабаЭкраном(Знач Кука, Знач Адрес, Знач Название)

	Раздел = "/hub/settings/webhooks";
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", Адрес);
	Поля.Вставить("название", Название);
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	Поля.Вставить("отбор_тегов", "stable");
	Поля.Вставить("сужение_снизу", "1");
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, Кука).КодСостояния, "подписка хаба заведена").Равно(200);

	Разметка = Клиент.Тело(Клиент.GETСКукой(Раздел, Кука));
	Позиция = СтрНайти(Разметка, Адрес);
	Ожидаем.Что(Позиция > 0, "подписка в списке хозяина").ЭтоИстина();
	Возврат Клиент.ПослеМаркера(Сред(Разметка, Позиция), Раздел + "/", "/save");

КонецФункции

// Подписка хаба через API; идентификатор — из ответа на создание.
Функция ПодпискаХабаВAPI(Знач Кука, Знач Адрес, Знач Название, Знач Сужаемая)

	Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", Кука)));
	Тело = СтрШаблон("{""kind"":""вебхук"",""URL"":""%1"",""events"":[""версия.опубликована""],"
		+ """name"":""%2"",""narrowing_allowed"":%3}", Адрес, Название, ?(Сужаемая, "true", "false"));
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/webhooks", Тело, Клиент.ЗаголовкиМутации(Кука, Токен));
	Ожидаем.Что(Ответ.КодСостояния, "подписка хаба заведена через API").Равно(201);
	Возврат Формат(Значение(Клиент.Тело(Ответ), "subscription").Получить("id"), "ЧГ=0");

КонецФункции

Функция Значение(Знач ТекстJSON, Знач Ключ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТекстJSON);
	Разобрано = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Разобрано.Получить(Ключ);
КонецФункции

#КонецОбласти
