// Страницы пула и пакета на живом хабе: живут под /pools, служебные имена свободны, прежние адреса —
// «не найдено», короткая нотация opm работает; страница и машинные двойники — о версии канала по умолчанию.

#Использовать asserts
#Использовать ospx-tools
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КлючАдмина;      // Строка — ключ доступа администратора хаба
Перем КореньДанных;    // Строка — временный каталог стенда: в нём собираются .ospx
Перем Кнопки;          // фикстура КнопкиСкачиванияСтраницы — кнопки .ospx из разметки

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("КнопкиСкачиванияСтраницы");
	Кнопки = Новый КнопкиСкачиванияСтраницы();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);

	КореньДанных = Хаб.ФайловаяБаза("openhub-адреса");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", ЛогинАдмина());
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());
	// регистрация без почты открыта только при выключенном подтверждении адреса
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	// описание API выключено: его адреса обязаны быть неизвестными, а не страницей пула
	Хаб.Среда("OSHUB_OPENAPI_ENABLED", "false");

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	Сессия = Клиент.Кука(Клиент.Войти(ЛогинАдмина(), ПарольАдмина()));
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""права"":""read,write""}", Сессия);
	Ожидаем.Что(Ответ.КодСостояния, "ключ администратора выпущен: " + Клиент.Тело(Ответ)).Равно(201);
	КлючАдмина = Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

	ЗавестиПул(ОсновнойПул());
	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools/" + ОсновнойПул() + "/default", "{}", КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "пул стал основным: " + Клиент.Тело(Ответ)).Равно(200);
	Опубликовать(ОсновнойПул(), "winow", "1.0.0");
	ЗавестиПул(ПулКаналов());

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ИменаБезРезерва

// Пул называется любым допустимым именем, в том числе именем служебного адреса, и его
// страница открывается под /pools. Служебный адрес с тем же словом остаётся собой.
&Тест
Процедура ПулСИменемСлужебногоАдресаЗаводитсяИОткрывается() Экспорт

	Для Каждого Имя Из СтрРазделить("api|login|settings|v3", "|") Цикл
		ЗавестиПул(Имя);
		ПроверитьСтраницу("/pools/" + Имя, Имя);
	КонецЦикла;

	Вход = Клиент.GET("/login");
	Ожидаем.Что(Вход.КодСостояния, "вход на месте").Равно(200);
	Ожидаем.Что(Клиент.Тело(Вход), "по /login — форма входа, а не пул login")
		.Содержит("type=""password""");
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/api")).Получить("pool").Получить("name"),
		"пул api отвечает и в API").Равно("api");

КонецПроцедуры

// Логин, повторяющий служебный адрес, заводится, и личное пространство — пул с именем
// логина — открывается под /pools.
&Тест
Процедура УчёткаСЛогиномСлужебногоАдресаЗаводитсяИПространствоОткрывается() Экспорт

	Для Каждого Логин Из СтрРазделить("static|hub|me|office", "|") Цикл
		Тело = СтрШаблон("{""логин"":""%1"",""email"":"""",""пароль"":""GoodPass1""}", Логин);
		Ответ = Клиент.POSTJSON("/api/v1/users", Тело);
		Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("учётка ""%1"" заведена: %2", Логин, Клиент.Тело(Ответ)))
			.Равно(201);
		ПроверитьСтраницу("/pools/" + Логин, Логин);
	КонецЦикла;

КонецПроцедуры

// Имя пакета «settings» и «packages» ни с чем не соревнуется: страница пакета и его вкладки
// открываются под /pools/{пул}/packages/{имя}.
&Тест
Процедура ПакетСИменемСлужебногоСловаПубликуетсяИОткрывается() Экспорт

	Для Каждого Имя Из СтрРазделить("settings|packages", "|") Цикл
		Опубликовать(ОсновнойПул(), Имя, "1.0.0");
		Адрес = "/pools/" + ОсновнойПул() + "/packages/" + Имя;
		ПроверитьСтраницу(Адрес, Имя);
		Ожидаем.Что(Клиент.GET(Адрес + "/versions").КодСостояния, "вкладка версий " + Имя).Равно(200);
		Ожидаем.Что(Клиент.GET(Адрес + "/deps").КодСостояния, "вкладка зависимостей " + Имя).Равно(200);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрежниеИНеизвестныеАдреса

// Прежний адрес страницы не обслуживается и никуда не ведёт, а человек видит страницу хаба
// «не найдено» с навигацией.
&Тест
Процедура ПрежниеАдресаОтвечаютНеНайденоБезПереадресации() Экспорт

	Для Каждого Адрес Из ПрежниеАдреса() Цикл
		Ответ = Клиент.GETБезПереходов(Адрес);
		Ожидаем.Что(Ответ.КодСостояния, "прежний адрес не обслуживается: " + Адрес).Равно(404);
		Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "и не переадресует: " + Адрес).Равно("");
		Страница = Ответ.Текст();
		Ожидаем.Что(Страница, "страница хаба с навигацией: " + Адрес).Содержит("aria-label=""Основная навигация""");
		Ожидаем.Что(Страница, "и дорогой в каталог: " + Адрес).Содержит("href=""/packages""");
	КонецЦикла;

	// КОНТРОЛЬ: та же страница живёт по новому адресу
	ПроверитьСтраницу("/pools/" + ОсновнойПул() + "/packages/winow", "winow");

КонецПроцедуры

// При выключенном описании API его адреса по умолчанию — просто неизвестные адреса: человек
// видит страницу хаба «не найдено», машина — конверт not_found. Страницей пула они не
// становятся, даже когда пул с именем «v3» на хабе есть.
&Тест
Процедура АдресаВыключенногоОписанияНеизвестны() Экспорт

	ЗавестиПул("v3");

	Для Каждого Адрес Из СтрРазделить("/v3/api-docs|/v3/api-docs.yaml|/swagger-ui.html", "|") Цикл

		Человеку = Клиент.GET(Адрес);
		Ожидаем.Что(Человеку.КодСостояния, "описание выключено, адрес неизвестен: " + Адрес).Равно(404);
		Страница = Клиент.Тело(Человеку);
		Ожидаем.Что(Страница, "страница хаба «не найдено»: " + Адрес).Содержит("По этому адресу у хаба ничего нет");
		Ожидаем.Что(СтрНайти(Страница, "<title>v3 — "), "а не страница пула v3: " + Адрес).Равно(0);

		Машине = Клиент.GET(Адрес, Клиент.Заголовок("Accept", "application/json"));
		Ожидаем.Что(Машине.КодСостояния, "машине тот же 404: " + Адрес).Равно(404);
		Ожидаем.Что(Клиент.ТелоJSON(Машине).Получить("error").Получить("code"), "конверт: " + Адрес)
			.Равно("not_found");

	КонецЦикла;

КонецПроцедуры

// Неизвестный адрес машинной двери — конверт отказа, а не разметка.
&Тест
Процедура НеизвестныйАдресМашинеКонвертОтказа() Экспорт

	Ответ = Клиент.GET("/api/v1/нет-такого-адреса");

	Ожидаем.Что(Ответ.КодСостояния, "неизвестный адрес API").Равно(404);
	Ожидаем.Что(СтрНачинаетсяС(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "application/json"),
		"ответ — JSON").ЭтоИстина();
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("error").Получить("code"), "код отказа").Равно("not_found");

КонецПроцедуры

#КонецОбласти

#Область КороткаяНотацияOpm

// Адреса выдачи и публикации без пула работают с основным пулом: список и файл, публикация,
// лента изменений.
&Тест
Процедура КороткаяНотацияOpmРаботаетКакПрежде() Экспорт

	Список = Клиент.GET("/download/list.txt");
	Ожидаем.Что(Список.КодСостояния, "список пакетов основного пула").Равно(200);
	Ожидаем.Что(Клиент.Тело(Список), "в нём опубликованный пакет").Содержит("winow");

	Файл = Клиент.GET("/download/winow/winow-1.0.0.ospx");
	Ожидаем.Что(Файл.КодСостояния, "файл версии по короткому адресу").Равно(200);
	Ожидаем.Что(Файл.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "и это не пустышка").ЭтоИстина();

	Ожидаем.Что(Клиент.GET("/changes").КодСостояния, "лента изменений основного пула").Равно(200);

	Заголовки = Клиент.Токен(КлючАдмина);
	Заголовки.Вставить("FILE-NAME", "winow-1.1.0.ospx");
	Запрос = Новый HTTPЗапрос("/push", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Новый ФикстураПакета().ДанныеOspx(КореньДанных, "winow", "1.1.0"));
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Ожидаем.Что(Ответ.КодСостояния, "публикация по короткому адресу: " + Клиент.Тело(Ответ)).Равно(201);
	Ожидаем.Что(Клиент.GET("/download/winow/winow-1.1.0.ospx").КодСостояния,
		"опубликованное отдаётся по короткому адресу").Равно(200);

КонецПроцедуры

// Команда установки и адрес страницы — разные вещи. Команда остаётся в форме хост/пул/пакет,
// которую разбирает клиент opm, и за адресом страницы не переезжает; страница пакета
// не основного пула живёт под /pools. Обе строки — в одном тесте, чтобы разница была видна.
&Тест
Процедура КомандаУстановкиНеПереезжаетВследЗаСтраницей() Экспорт

	ЗавестиПул("team");
	Опубликовать("team", "teamlib", "1.0.0");
	Узел = "localhost:" + Формат(Хаб.Порт(), "ЧГ=0");

	Страница = Клиент.Тело(Клиент.GET("/pools/team/packages/teamlib"));

	Ожидаем.Что(Страница, "команда установки — хост/пул/пакет")
		.Содержит("opm install " + Узел + "/team/teamlib<");
	Ожидаем.Что(СтрНайти(Страница, "opm install " + Узел + "/pools/"),
		"в команду адрес страницы не просочился").Равно(0);
	Ожидаем.Что(Страница, "а сама страница живёт под /pools: вкладка «Описание» ведёт на неё")
		.Содержит("href=""/pools/team/packages/teamlib""");

КонецПроцедуры

#КонецОбласти

#Область КаналПоУмолчанию

// Канал по умолчанию переключают, ничего не публикуя, — и страница обязана переехать
// на README той версии, которую теперь отдаёт установка без версии.
&Тест
Процедура СменаКаналаПоУмолчаниюМеняетОписаниеБезПубликации() Экспорт

	Имя = "chreadme";
	ОпубликоватьСREADME(Имя, "1.0.0", "# МаркерСтарой");
	ОпубликоватьСREADME(Имя, "2.0.0", "# МаркерНовой");

	Ожидаем.Что(РезолвВерсии(Имя), "КОНТРОЛЬ: без спецификации установка берёт старшую").Равно("2.0.0");
	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "МаркерНовой") > 0,
		"КОНТРОЛЬ: и страница показывает её README").ЭтоИстина();

	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Ожидаем.Что(РезолвВерсии(Имя), "установка без версии уехала на канал по умолчанию").Равно("1.0.0");
	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "МаркерСтарой") > 0,
		"страница показывает README версии канала — публиковать для этого нечего").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "МаркерНовой"),
		"README прежней версии со страницы ушёл").Равно(0);

КонецПроцедуры

// Отзыв — второй способ сменить показанное описание без публикации: отозванную версию
// установка без версии не берёт, значит и страница о ней больше не говорит.
&Тест
Процедура ОтзывВерсииМеняетОписаниеНаСтранице() Экспорт

	Имя = "yankreadme";
	ОпубликоватьСREADME(Имя, "1.0.0", "# МаркерПервой");
	ОпубликоватьСREADME(Имя, "1.1.0", "# МаркерВторой");

	Ожидаем.Что(СтрНайти(ВкладкаОписания(Имя), "МаркерВторой") > 0,
		"КОНТРОЛЬ: до отзыва показан README старшей версии").ЭтоИстина();

	Отозвать(Имя, "1.1.0", Истина);

	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "МаркерПервой") > 0,
		"отзыв увёл страницу на версию, которая резолвится теперь").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "МаркерВторой"),
		"README отозванной версии со страницы ушёл").Равно(0);

	// возврат тем же путём всё возвращает: иначе сторож зеленел бы на застрявшей странице
	Отозвать(Имя, "1.1.0", Ложь);
	Ожидаем.Что(СтрНайти(ВкладкаОписания(Имя), "МаркерВторой") > 0,
		"снятый отзыв вернул страницу на старшую версию").ЭтоИстина();

КонецПроцедуры

// Состав «зависит от» — записи реестра той же версии, о которой говорит страница:
// распаковывать .ospx на показе не нужно, а вот версию брать надо ту самую.
&Тест
Процедура СменаКаналаМеняетСоставЗависимостейНаВкладке() Экспорт

	Имя = "chdeps";
	ОпубликоватьСЗависимостью(Имя, "1.0.0", "depalpha");
	ОпубликоватьСЗависимостью(Имя, "2.0.0", "depbeta");

	Зависимости = ВкладкаЗависимостей(Имя);
	Ожидаем.Что(СтрНайти(Зависимости, "depbeta") > 0,
		"КОНТРОЛЬ: показан состав старшей версии").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Зависимости, "depalpha"),
		"КОНТРОЛЬ: и только он").Равно(0);

	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Зависимости = ВкладкаЗависимостей(Имя);
	Ожидаем.Что(СтрНайти(Зависимости, "depalpha") > 0,
		"вкладка зависимостей переехала вместе с каналом по умолчанию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Зависимости, "depbeta"),
		"состав прежней версии со вкладки ушёл").Равно(0);

КонецПроцедуры

// Машинный адрес описания отвечает о ТОЙ ЖЕ версии, что и страница: две двери к одному
// README, разошедшиеся на смене канала, — это два разных ответа на один вопрос.
&Тест
Процедура АдресREADMEИдётЗаКаналомПоУмолчанию() Экспорт

	Имя = "apireadme";
	ОпубликоватьСREADME(Имя, "1.0.0", "# МаркерAPIСтарой");
	ОпубликоватьСREADME(Имя, "2.0.0", "# МаркерAPIНовой");

	ДоСмены = READMEАдресом(Имя);
	Ожидаем.Что(ДоСмены.Получить("version"), "КОНТРОЛЬ: адрес называет старшую версию").Равно("2.0.0");
	Ожидаем.Что(СтрНайти(Строка(ДоСмены.Получить("html")), "МаркерAPIНовой") > 0,
		"КОНТРОЛЬ: и отдаёт её README").ЭтоИстина();

	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	ПослеСмены = READMEАдресом(Имя);
	Ожидаем.Что(ПослеСмены.Получить("version"),
		"адрес README уехал на версию канала по умолчанию").Равно("1.0.0");
	Ожидаем.Что(СтрНайти(Строка(ПослеСмены.Получить("html")), "МаркерAPIСтарой") > 0,
		"и отдаёт её README").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(ПослеСмены.Получить("html")), "МаркерAPIНовой"),
		"README прежней версии с адреса ушёл").Равно(0);

	Ожидаем.Что(СтрНайти(ВкладкаОписания(Имя), "МаркерAPIСтарой") > 0,
		"страница говорит о той же версии, что и адрес").ЭтоИстина();

КонецПроцедуры

// Карточка пакета называет ту же версию, что страница: поле latest_version — это версия
// установки без тега и версии, и смена канала по умолчанию двигает её без публикации.
&Тест
Процедура КарточкаAPIИдётЗаКаналомПоУмолчанию() Экспорт

	Имя = "cardchannel";
	ОпубликоватьСREADME(Имя, "1.0.0", "# МаркерКарточкиСтарой");
	ОпубликоватьСREADME(Имя, "2.0.0", "# МаркерКарточкиНовой");

	Ожидаем.Что(Строка(КарточкаПакета(Имя).Получить("latest_version")),
		"КОНТРОЛЬ: без тега по умолчанию карточка называет старшую действующую").Равно("2.0.0");

	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Ожидаем.Что(Строка(КарточкаПакета(Имя).Получить("latest_version")),
		"карточка уехала на версию канала по умолчанию — публиковать для этого нечего").Равно("1.0.0");
	Ожидаем.Что(РезолвВерсии(Имя),
		"и называет ровно ту версию, которую получит установка без версии").Равно("1.0.0");

КонецПроцедуры

// Канал по умолчанию опустошён отзывом: установке отдавать нечего, и карточка о версии
// молчит, как о пакете без версий. Старшую действующую вместо пустого канала она не
// подставляет: клиент поставил бы не её.
&Тест
Процедура БезВерсииПоУмолчаниюКарточкаЧужуюНеНазывает() Экспорт

	Имя = "cardempty";
	ОпубликоватьСREADME(Имя, "1.0.0", "# МаркерКарточкиКанальной");
	ОпубликоватьСREADME(Имя, "2.0.0", "# МаркерКарточкиСтаршей");
	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Отозвать(Имя, "1.0.0", Истина);

	Карточка = КарточкаПакета(Имя);
	Ожидаем.Что(Строка(Карточка.Получить("latest_version")),
		"версии по умолчанию нет — поле пусто").Равно("");
	Ожидаем.Что(Карточка.Получить("versions_total") >= 2,
		"самотест: версии у пакета есть, пусто именно поле версии по умолчанию").ЭтоИстина();

КонецПроцедуры

// Канал по умолчанию можно опустошить отзывом — и тогда установка без версии не даёт
// ничего. Страница в этом случае честно говорит об отсутствии версии по умолчанию,
// а не выдаёт README какой-нибудь другой версии за «текущую».
&Тест
Процедура БезВерсииПоУмолчаниюСтраницаНазываетПричину() Экспорт

	Имя = "emptychannel";
	ОпубликоватьСREADME(Имя, "1.0.0", "# МаркерКанальной");
	ОпубликоватьСREADME(Имя, "2.0.0", "# МаркерСтаршей");
	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Отозвать(Имя, "1.0.0", Истина);

	Ожидаем.Что(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2/resolve", ПулКаналов(), Имя)).КодСостояния,
		"самотест: установка без версии теперь ничего не получает").Равно(404);

	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "нет версии по умолчанию") > 0,
		"страница называет причину пустоты: " + Описание).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "МаркерСтаршей"),
		"README чужой версии за текущую не выдаётся").Равно(0);
	Ожидаем.Что(СтрНайти(Описание, "МаркерКанальной"),
		"и README отозванной — тоже").Равно(0);

	// кнопка шапки отдаёт версию установки без координаты, а её нет — кнопки в шапке нет;
	// памятка остаётся: у версий на вкладке версий кнопки свои
	Ожидаем.Что(Кнопки.Все(Описание).Количество(),
		"в шапке кнопки скачивания нет: версии по умолчанию не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(Описание, "opm install -f") > 0,
		"а памятка про установку из файла на месте: кнопки версий никуда не делись").ЭтоИстина();

	Зависимости = ВкладкаЗависимостей(Имя);
	Ожидаем.Что(СтрНайти(Зависимости, "нет версии по умолчанию") > 0,
		"и вкладка зависимостей говорит то же, а не «ни от чего не зависит»").ЭтоИстина();

	// адрес README, в отличие от резолва, при пустом канале не отказывает: 200 с пустой версией
	// и has_readme = false; README чужой версии он не подставляет, как и страница
	Пустой = READMEАдресом(Имя);
	Ожидаем.Что(Строка(Пустой.Получить("version")),
		"адрес README версии не называет — её нет").Равно("");
	Ожидаем.Что(Пустой.Получить("has_readme"),
		"и честно говорит, что описания нет").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Строка(Пустой.Получить("html")), "МаркерСтаршей"),
		"README чужой версии адрес не подставляет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Заводит пул один раз на набор, кто бы из тестов ни попросил первым: порядок тестов любой.
Процедура ЗавестиПул(Знач Имя)

	Если Клиент.GET("/api/v1/pools/" + Имя).КодСостояния = 200 Тогда
		Возврат;
	КонецЕсли;

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""name"":""%1"",""visibility"":""public""}", Имя), КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("пул ""%1"" заведён: %2", Имя, Клиент.Тело(Ответ))).Равно(201);

КонецПроцедуры

Процедура Опубликовать(Знач Пул, Знач Пакет, Знач Версия)

	Заголовки = Клиент.Токен(КлючАдмина);
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", Пакет, Версия));
	Запрос = Новый HTTPЗапрос(СтрШаблон("/api/v1/pools/%1/packages/%2/versions", Пул, Пакет), Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Новый ФикстураПакета().ДанныеOspx(КореньДанных, Пакет, Версия));
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("%1 %2 опубликован: %3", Пакет, Версия, Клиент.Тело(Ответ)))
		.Равно(201);

КонецПроцедуры

// Страница открылась и это страница того объекта, чьё имя стоит в заголовке вкладки.
Процедура ПроверитьСтраницу(Знач Адрес, Знач Имя)

	Ответ = Клиент.GET(Адрес);
	Ожидаем.Что(Ответ.КодСостояния, "страница открывается: " + Адрес).Равно(200);
	Ожидаем.Что(Клиент.Тело(Ответ), "это страница «" + Имя + "»: " + Адрес).Содержит("<title>" + Имя + " — ");

КонецПроцедуры

Функция ПрежниеАдреса()

	Результат = Новый Массив();
	Результат.Добавить("/" + ОсновнойПул());
	Результат.Добавить("/" + ОсновнойПул() + "/winow");
	Результат.Добавить("/" + ОсновнойПул() + "/winow/versions");
	Результат.Добавить("/" + ОсновнойПул() + "/winow/deps");
	Результат.Добавить("/" + ОсновнойПул() + "/settings");
	Результат.Добавить("/" + ОсновнойПул() + "/winow/settings");
	Результат.Добавить("/package/winow");
	Возврат Результат;

КонецФункции

// Публикует версию пакета с заданным README в пул каналов.
Процедура ОпубликоватьСREADME(Знач ИмяПакета, Знач Версия, Знач ТекстREADME)

	Клиент.Опубликовать(ПулКаналов(),
		ФайлПакета(Новый ФикстураПакета().МанифестСРепозиторием(ИмяПакета, Версия), ТекстREADME), КлючАдмина);

КонецПроцедуры

// Публикует версию пакета, зависящую ровно от одного названного пакета.
Процедура ОпубликоватьСЗависимостью(Знач ИмяПакета, Знач Версия, Знач ИмяЗависимости)

	Манифест = Новый ФикстураПакета().МанифестСРепозиторием(ИмяПакета, Версия);
	Манифест.ДобавитьЗависимость(ИмяЗависимости, "1.0.0");

	Клиент.Опубликовать(ПулКаналов(), ФайлПакета(Манифест, "# " + ИмяПакета), КлючАдмина);

КонецПроцедуры

// Заводит ручной тег на версии и делает его каналом по умолчанию — тем же адресом, что мейнтейнер.
Процедура НазначитьКаналомПоУмолчанию(Знач ИмяПакета, Знач ИмяТега, Знач Версия)

	Ответ = Клиент.ЗапросJSONСТокеном("PUT",
		СтрШаблон("/api/v1/pools/%1/packages/%2/tags/%3", ПулКаналов(), ИмяПакета, ИмяТега),
		СтрШаблон("{""mode"":""ручной"",""version"":""%1"",""default"":true}", Версия),
		КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("тег %1 стоит на %2 и назначен основным: %3",
		ИмяТега, Версия, Клиент.Тело(Ответ))).Равно(200);

КонецПроцедуры

// Отзывает версию или снимает отзыв.
Процедура Отозвать(Знач ИмяПакета, Знач Версия, Знач Отозвана)

	Ответ = Клиент.ЗапросJSONСТокеном("PATCH",
		СтрШаблон("/api/v1/pools/%1/packages/%2/versions/%3", ПулКаналов(), ИмяПакета, Версия),
		СтрШаблон("{""yanked"":%1}", ?(Отозвана, "true", "false")), КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("отзыв версии %1 (%2): %3",
		Версия, Отозвана, Клиент.Тело(Ответ))).Равно(200);

КонецПроцедуры

// Разметка вкладки «Описание» страницы пакета.
Функция ВкладкаОписания(Знач ИмяПакета)
	Ответ = Клиент.GET(СтрШаблон("/pools/%1/packages/%2", ПулКаналов(), ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "страница пакета отдана").Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

// Разметка вкладки «Зависимости» страницы пакета.
Функция ВкладкаЗависимостей(Знач ИмяПакета)
	Ответ = Клиент.GET(СтрШаблон("/pools/%1/packages/%2/deps", ПулКаналов(), ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "вкладка зависимостей отдана").Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

// Карточка пакета машинным адресом.
Функция КарточкаПакета(Знач ИмяПакета)
	Ответ = Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2", ПулКаналов(), ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "карточка пакета отдана: " + Клиент.Тело(Ответ)).Равно(200);
	Возврат Клиент.ТелоJSON(Ответ).Получить("package");
КонецФункции

// Ответ машинного адреса README без указания версии.
Функция READMEАдресом(Знач ИмяПакета)
	Ответ = Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2/readme", ПулКаналов(), ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "адрес README ответил: " + Клиент.Тело(Ответ)).Равно(200);
	Возврат Клиент.ТелоJSON(Ответ);
КонецФункции

// Версия, которую называет резолв без спецификации, — то, что получит `opm install <имя>`.
Функция РезолвВерсии(Знач ИмяПакета)
	Ответ = Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2/resolve", ПулКаналов(), ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "резолв без спецификации ответил: " + Клиент.Тело(Ответ)).Равно(200);
	Возврат Строка(Клиент.ТелоJSON(Ответ).Получить("version"));
КонецФункции

// Собирает .ospx по манифесту с README во временном каталоге стенда.
Функция ФайлПакета(Знач Манифест, Знач ТекстREADME)
	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Возврат Новый ФикстураПакета().ПостроитьOspxПоМанифесту(Каталог, Манифест, ТекстREADME);
КонецФункции

Функция ПулКаналов()
	Возврат "channels";
КонецФункции

Функция ОсновнойПул()
	Возврат "public";
КонецФункции

Функция ЛогинАдмина()
	Возврат "addr-admin";
КонецФункции

Функция ПарольАдмина()
	Возврат "AddrAdminPass1";
КонецФункции

#КонецОбласти
