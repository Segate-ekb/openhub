// Список пулов /pools на живом хабе глазами гостя, участника приватных пулов и постороннего;
// засев кабинета: public — публичный, owned и secret — приватные пулы owner1.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
&Тег("хаб:кабинет")
&Тег("фаза:чтение")
&Порядок(1)
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = ОбщийХаб.Экземпляр("кабинет");
	Клиент = Новый КлиентХаба(Хаб);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Гостю открыт список публичных пулов; приватные не названы ни строкой, ни ссылкой. У страницы
// свой заголовок вкладки, адрес без параметров и те же пулы, что у /api/v1/pools, кроме личных
// пространств.
&Тест
Процедура ГостюСписокПубличныхПулов() Экспорт

	Ответ = Клиент.GET("/pools");
	Ожидаем.Что(Ответ.КодСостояния, "список открыт гостю").Равно(200);
	Страница = Клиент.Тело(Ответ);
	Ожидаем.Что(Страница, "заголовок вкладки").Содержит("<title>Пулы — ");
	Ожидаем.Что(Страница, "публичный пул ссылкой на свою страницу").Содержит("href=""/pools/public""");
	Ожидаем.Что(СтрНайти(Страница, "owned") + СтрНайти(Страница, "secret"),
		"приватные пулы не названы").Равно(0);

	ПроверитьТеЖеПулыЧтоAPI(Страница, "");

КонецПроцедуры

// Участник приватного пула видит его в списке, посторонний — нет.
&Тест
Процедура УчастникуВидныЕгоПриватныеПулы() Экспорт

	Кука = Войти("owner1", "Owner1Passw0rd");
	УВладельца = Клиент.Тело(Клиент.GETСКукой("/pools", Кука));
	Ожидаем.Что(УВладельца, "участник видит свой приватный пул").Содержит("href=""/pools/owned""");
	Ожидаем.Что(УВладельца, "и второй").Содержит("href=""/pools/secret""");
	Ожидаем.Что(УВладельца, "приватный назван словом").Содержит("Приватный");

	Постороннему = Клиент.Тело(Клиент.GETСКукой("/pools", Войти("bob", "BobPassw0rd")));
	Ожидаем.Что(Постороннему, "КОНТРОЛЬ: посторонний видит публичный").Содержит("href=""/pools/public""");
	Ожидаем.Что(СтрНайти(Постороннему, "owned") + СтрНайти(Постороннему, "secret"),
		"чужие приватные не названы").Равно(0);

КонецПроцедуры

#Область Помощники

Функция Войти(Знач Логин, Знач Пароль)
	Возврат Клиент.Войти(Логин, Пароль);
КонецФункции

// Строки списка — ровно те пулы, что API называет гостю, кроме личных пространств: ни одного
// лишнего, ни одного пропущенного; личные пространства в таблице не стоят.
Процедура ПроверитьТеЖеПулыЧтоAPI(Знач Страница, Знач Кто)

	Выдача = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools?pageSize=100"));
	Ожидаемые = Новый Массив();
	Личные = Новый Массив();
	Для Каждого Пул Из Выдача.Получить("items") Цикл
		Если Пул.Получить("type") = "user" Тогда
			Личные.Добавить(Пул.Получить("name"));
		Иначе
			Ожидаемые.Добавить(Пул.Получить("name"));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Ожидаемые.Количество() > 0, "КОНТРОЛЬ: API назвал пулы").ЭтоИстина();

	ВСписке = ПулыТаблицы(Страница);
	Для Каждого Имя Из Ожидаемые Цикл
		Ожидаем.Что(ВСписке.Найти(Имя), "пул из API есть в списке" + Кто + ": " + Имя)
			.Не_().Равно(Неопределено);
	КонецЦикла;
	Для Каждого Имя Из ВСписке Цикл
		Ожидаем.Что(Ожидаемые.Найти(Имя), "в списке нет пула, которого API не называет" + Кто + ": " + Имя)
			.Не_().Равно(Неопределено);
	КонецЦикла;
	Для Каждого Имя Из Личные Цикл
		Ожидаем.Что(ВСписке.Найти(Имя), "личное пространство не перечислено: " + Имя).Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Имена пулов строк таблицы: первая ссылка на страницу пула в каждой строке тела таблицы.
Функция ПулыТаблицы(Знач Страница)

	Результат = Новый Массив();
	Начало = СтрНайти(Страница, "<tbody");
	Если Начало = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Тело = Сред(Страница, Начало, СтрНайти(Страница, "</tbody>") - Начало);

	Метка = "href=""/pools/";
	Позиция = СтрНайти(Тело, "<tr");
	Пока Позиция > 0 Цикл
		Конец = СтрНайти(Тело, "</tr>", НаправлениеПоиска.СНачала, Позиция);
		Строка = Сред(Тело, Позиция, Конец - Позиция);
		Ссылка = СтрНайти(Строка, Метка);
		Если Ссылка > 0 Тогда
			Хвост = Сред(Строка, Ссылка + СтрДлина(Метка));
			Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
		КонецЕсли;
		Позиция = СтрНайти(Тело, "<tr", НаправлениеПоиска.СНачала, Конец);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
