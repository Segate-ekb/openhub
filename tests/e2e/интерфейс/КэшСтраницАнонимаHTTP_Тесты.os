// Кэш страниц гостя на живом хабе: в странице гостя нет следов чужой сессии, оформление различает
// страницы, опубликованное видно гостю сразу, вошедший получает свою страницу.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КлючАдмина;      // Строка — ключ доступа администратора хаба
Перем СессияАдмина;    // Строка — значение куки сессии администратора
Перем КореньДанных;    // Строка — временный каталог стенда: в нём собираются .ospx

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);

	КореньДанных = Хаб.ФайловаяБаза("openhub-кэш-гостя");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", ЛогинАдмина());
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	СессияАдмина = Клиент.Войти(ЛогинАдмина(), ПарольАдмина());
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""права"":""read,write""}", Клиент.Кука(СессияАдмина));
	Ожидаем.Что(Ответ.КодСостояния, "ключ администратора выпущен: " + Клиент.Тело(Ответ)).Равно(201);
	КлючАдмина = Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""name"":""%1"",""visibility"":""public""}", Пул()), КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);
	Опубликовать("cache-probe", "1.0.0");

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Страница гостя, отданная повторно, — та же страница гостя: без токена формы и без куки сессии.
&Тест
Процедура ВСтраницеГостяНетТокенаФормыИСессии() Экспорт

	Для Каждого Путь Из АдресаКаталога() Цикл
		Для Номер = 1 По 2 Цикл
			Ответ = Клиент.GET(Путь);
			Тело = Клиент.Тело(Ответ);
			Подпись = СтрШаблон("%1, запрос %2", Путь, Номер);
			Ожидаем.Что(Ответ.КодСостояния, Подпись + ": страница открылась").Равно(200);
			Ожидаем.Что(СтрНайти(Тело, "_csrf"), Подпись + ": в странице нет токена формы").Равно(0);
			Ожидаем.Что(СтрНайти(Тело, "oshub_session"), Подпись + ": в странице нет куки сессии").Равно(0);
			Ожидаем.Что(Клиент.КукаСессии(Ответ), Подпись + ": гостю не выдана сессия").Равно("");
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Тема из куки оформления различает страницы: светлая и тёмная не подменяют друг друга.
&Тест
Процедура РазнаяТемаДаётРазныйDataTheme() Экспорт

	Путь = "/pools/" + Пул();
	Для Номер = 1 По 2 Цикл
		Ожидаем.Что(Клиент.Тело(Клиент.GET(Путь, СТемой("светлая"))), "светлая, запрос " + Номер)
			.Содержит(ТегHTML("light"));
		Ожидаем.Что(Клиент.Тело(Клиент.GET(Путь, СТемой("тёмная"))), "тёмная, запрос " + Номер)
			.Содержит(ТегHTML("dark"));
	КонецЦикла;

КонецПроцедуры

// Новую версию и новый пакет гость видит на следующем же запросе, а не через срок страницы.
&Тест
Процедура ОпубликованноеГостьВидитСразу() Экспорт

	АдресВерсий = "/pools/" + Пул() + "/packages/cache-probe/versions";
	СтраницаПула = "/pools/" + Пул();
	Ожидаем.Что(Клиент.Тело(Клиент.GET(АдресВерсий)), "до публикации версии 1.1.0 нет").Не_().Содержит("1.1.0");
	Ожидаем.Что(Клиент.Тело(Клиент.GET(СтраницаПула)), "до публикации пакета нет").Не_().Содержит("cache-fresh");
	Клиент.GET(АдресВерсий);
	Клиент.GET(СтраницаПула);

	Опубликовать("cache-probe", "1.1.0");
	Опубликовать("cache-fresh", "1.0.0");

	Ожидаем.Что(Клиент.Тело(Клиент.GET(АдресВерсий)), "гость сразу видит новую версию").Содержит("1.1.0");
	Ожидаем.Что(Клиент.Тело(Клиент.GET(СтраницаПула)), "гость сразу видит новый пакет").Содержит("cache-fresh");

КонецПроцедуры

// Страница из памяти несёт возраст в Age, и браузер не держит её сверх срока; POST гостя на страницу
// каталога, смена темы и выход гостем память не сбрасывают, а страница с незнакомым параметром в неё не идёт.
&Тест
Процедура ЗапросыГостяНеСбрасываютПамятьСтраниц() Экспорт

	Путь = "/pools/" + Пул();
	Клиент.GET(Путь);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Клиент.GET(Путь), "Age"), "повтор отдан из памяти с возрастом")
		.Не_().Равно("");

	Клиент.ЗапросФормы("POST", "/", "");
	Клиент.ЗапросФормы("POST", Путь, "");
	Клиент.POSTФормыБезПереходов("/ui/theme", "theme=light");
	Клиент.POSTФормыБезПереходов("/ui/theme", "theme=light", Клиент.СтрокаКукиСессии("fake-session"));
	Ожидаем.Что(Клиент.POSTФормыБезПереходов("/logout", "").КодСостояния,
		"КОНТРОЛЬ: выход гостя отвечает без отказа и гасит куку").Меньше(400);
	Ожидаем.Что(Клиент.POSTJSON("/api/v1/logout", "{}").КодСостояния,
		"КОНТРОЛЬ: выход гостя через API отвечает без отказа").Меньше(400);

	Ответ = Клиент.GET(Путь);
	Ожидаем.Что(Ответ.КодСостояния, "страница открылась").Равно(200);
	Возраст = Клиент.ЗаголовокОтвета(Ответ, "Age");
	Ожидаем.Что(Возраст, "после POST гостя страница всё ещё из памяти").Не_().Равно("");
	Ожидаем.Что(Число(Возраст), "и не старше срока страницы").Меньше(60);

	Клиент.GET(Путь + "?junk=1");
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Клиент.GET(Путь + "?junk=1"), "Age"),
		"страница с незнакомым параметром собирается заново").Равно("");

КонецПроцедуры

// Вошедший получает свою страницу с формой выхода, а гость после него — по-прежнему страницу гостя.
&Тест
Процедура ВошедшийПолучаетСвоюСтраницуАНеКэш() Экспорт

	Путь = "/pools/" + Пул();
	Клиент.GET(Путь);
	Гостя = Клиент.Тело(Клиент.GET(Путь));

	Своя = Клиент.Тело(Клиент.GETСКукой(Путь, СессияАдмина));
	Ожидаем.Что(Клиент.ТокенCSRF(Своя), "вошедшему — своя страница с токеном формы").Не_().Равно("");
	Ожидаем.Что(Своя, "и с его логином").Содержит(ЛогинАдмина());

	Ещё = Клиент.Тело(Клиент.GETСКукой(Путь, СессияАдмина));
	Ожидаем.Что(Клиент.ТокенCSRF(Ещё), "и при повторе — своя").Не_().Равно("");

	ГостяПосле = Клиент.Тело(Клиент.GET(Путь));
	Ожидаем.Что(СтрНайти(ГостяПосле, "_csrf"), "гость после вошедшего — без токена формы").Равно(0);
	Ожидаем.Что(ГостяПосле, "и та же страница гостя, что до вошедшего").Равно(Гостя);

КонецПроцедуры

#Область Служебное

Функция АдресаКаталога()
	Адреса = Новый Массив();
	Адреса.Добавить("/");
	Адреса.Добавить("/packages");
	Адреса.Добавить("/pools");
	Адреса.Добавить("/pools/" + Пул());
	Адреса.Добавить("/pools/" + Пул() + "/packages/cache-probe");
	Адреса.Добавить("/pools/" + Пул() + "/packages/cache-probe/versions");
	Возврат Адреса;
КонецФункции

// Кука оформления хаба — url-кодированное «тема=…».
Функция СТемой(Знач Тема)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_ui=" + КодироватьСтроку("тема=" + Тема, СпособКодированияСтроки.КодировкаURL));
	Возврат Заголовки;
КонецФункции

// Тег <html> целиком: подстрока «data-theme="light"» есть на каждой странице в селекторе палитры.
Функция ТегHTML(Знач Тема)
	Возврат СтрШаблон("<html lang=""ru"" data-theme=""%1"">", Тема);
КонецФункции

Процедура Опубликовать(Знач Пакет, Знач Версия)

	Заголовки = Клиент.Токен(КлючАдмина);
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", Пакет, Версия));
	Запрос = Новый HTTPЗапрос(СтрШаблон("/api/v1/pools/%1/packages/%2/versions", Пул(), Пакет), Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Новый ФикстураПакета().ДанныеOspx(КореньДанных, Пакет, Версия));
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("%1 %2 опубликован: %3", Пакет, Версия, Клиент.Тело(Ответ)))
		.Равно(201);

КонецПроцедуры

Функция Пул()
	Возврат "cachepool";
КонецФункции

Функция ЛогинАдмина()
	Возврат "cache-admin";
КонецФункции

Функция ПарольАдмина()
	Возврат "CacheAdminPass1";
КонецФункции

#КонецОбласти
