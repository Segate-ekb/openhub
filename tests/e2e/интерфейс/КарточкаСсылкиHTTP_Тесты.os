// Карточка ссылки на живом хабе: страница пакета публичного пула отдаёт анонимному краулеру
// свойства Open Graph с абсолютными адресами, приватного — тот же 404 без разметки карточки.

#Использовать asserts
#Использовать ospx-tools
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КлючАдмина;      // Строка — ключ доступа администратора хаба
Перем КореньДанных;    // Строка — временный каталог стенда: в нём собираются .ospx

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);

	КореньДанных = Хаб.ФайловаяБаза("openhub-карточка");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", ЛогинАдмина());
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_INSTANCE_URL", АдресХаба());

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	Сессия = Клиент.Кука(Клиент.Войти(ЛогинАдмина(), ПарольАдмина()));
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""права"":""read,write""}", Сессия);
	Ожидаем.Что(Ответ.КодСостояния, "ключ администратора выпущен: " + Клиент.Тело(Ответ)).Равно(201);
	КлючАдмина = Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

	ЗавестиПул("team", "public");
	ЗавестиПул("inner", "private");
	Опубликовать("team", "githublib", "1.2.3", "https://github.com/acme/githublib");
	Опубликовать("team", "githublib", "1.2.4", "https://github.com/acme/githublib");
	Опубликовать("team", "elselib", "1.0.0", "https://gitlab.com/acme/elselib");
	Опубликовать("inner", "secretlib", "1.0.0", "https://github.com/acme/secretlib");

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Краулер ходит без входа и читает голову страницы: заглавие, описание, абсолютный адрес
// страницы и социальную карточку репозитория на GitHub.
&Тест
Процедура СтраницаПубличногоПакетаНесётКарточкуДляКраулера() Экспорт

	Голова = ГоловаСтраницы("/pools/team/packages/githublib");

	Ожидаем.Что(Свойство(Голова, "og:title"), "заглавие — имя пакета").Равно("githublib");
	Ожидаем.Что(Свойство(Голова, "og:description"), "описание пакета").Равно("Описание githublib");
	Ожидаем.Что(Свойство(Голова, "og:url"), "адрес страницы — абсолютный, внешним адресом хаба")
		.Равно(АдресХаба() + "/pools/team/packages/githublib");
	Ожидаем.Что(Свойство(Голова, "og:image"), "картинка — карточка репозитория на GitHub")
		.Равно("https://opengraph.githubassets.com/1.2.4/acme/githublib");

КонецПроцедуры

// Страница версии — страница пакета с версией в запросе: карточка называет версию,
// адрес у неё свой, картинка GitHub снята с ключом этой версии.
&Тест
Процедура СтраницаВерсииНесётКарточкуВерсии() Экспорт

	Голова = ГоловаСтраницы("/pools/team/packages/githublib?version=1.2.3");

	Ожидаем.Что(Свойство(Голова, "og:title"), "пакет и версия").Равно("githublib 1.2.3");
	Ожидаем.Что(Свойство(Голова, "og:url"), "адрес — страница этой версии")
		.Равно(АдресХаба() + "/pools/team/packages/githublib?version=1.2.3");
	Ожидаем.Что(Свойство(Голова, "og:image"), "картинка этой версии")
		.Равно("https://opengraph.githubassets.com/1.2.3/acme/githublib");

КонецПроцедуры

// Неизвестная версия страницу не роняет: та же страница с карточкой пакета.
&Тест
Процедура НеизвестнаяВерсияДаётКарточкуПакета() Экспорт

	Голова = ГоловаСтраницы("/pools/team/packages/githublib?version=9.9.9");

	Ожидаем.Что(Свойство(Голова, "og:title"), "заглавие — пакет без версии").Равно("githublib");
	Ожидаем.Что(Свойство(Голова, "og:url"), "адрес — страница пакета")
		.Равно(АдресХаба() + "/pools/team/packages/githublib");

КонецПроцедуры

// Анонимная страница публичного пула уходит в общий кэш: ответ одной версии не должен
// достаться адресу другой. Метки ответов разные, и метка одной версии на адресе другой
// не даёт 304 — кэш, сверяющий метку, отдаст свежую карточку.
&Тест
Процедура ОбщийКэшРазличаетСтраницыВерсий() Экспорт

	Первая = Клиент.GET("/pools/team/packages/githublib?version=1.2.3");
	Вторая = Клиент.GET("/pools/team/packages/githublib?version=1.2.4");
	МеткаПервой = Клиент.ЗаголовокОтвета(Первая, "ETag");

	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Первая, "Cache-Control")),
		"самотест: страница годится общему кэшу").Содержит("public");
	Ожидаем.Что(МеткаПервой, "у версий разные метки").Не_().Равно(Клиент.ЗаголовокОтвета(Вторая, "ETag"));

	Сверка = Клиент.GET("/pools/team/packages/githublib?version=1.2.4",
		Клиент.Заголовок("If-None-Match", МеткаПервой));
	Ожидаем.Что(Сверка.КодСостояния, "метка чужой версии не даёт 304").Равно(200);
	Ожидаем.Что(Свойство(ГоловаОтвета(Сверка), "og:title"), "и карточка — своей версии")
		.Равно("githublib 1.2.4");

КонецПроцедуры

// Репозиторий не на GitHub — картинкой идёт растровый знак хаба: абсолютный адрес, и по нему
// хаб действительно отдаёт PNG.
&Тест
Процедура ПакетНеСGitHubПолучаетРастровыйЗнакХаба() Экспорт

	Картинка = Свойство(ГоловаСтраницы("/pools/team/packages/elselib"), "og:image");

	Ожидаем.Что(СтрНачинаетсяС(Картинка, АдресХаба() + "/"), "адрес абсолютный: " + Картинка).ЭтоИстина();
	Ответ = Клиент.GET(Сред(Картинка, СтрДлина(АдресХаба()) + 1));
	Ожидаем.Что(Ответ.КодСостояния, "знак отдаётся: " + Картинка).Равно(200);
	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "и это PNG").Содержит("image/png");

КонецПроцедуры

// Вкладки страницы пакета — та же карточка: ссылка на любую из них описывает пакет.
&Тест
Процедура ВкладкиПакетаНесутТуЖеКарточку() Экспорт

	Голова = ГоловаСтраницы("/pools/team/packages/githublib/versions");

	Ожидаем.Что(Свойство(Голова, "og:url"), "адрес — страница пакета")
		.Равно(АдресХаба() + "/pools/team/packages/githublib");

КонецПроцедуры

// Приватный пул анонимному краулеру отвечает тем же 404, что неизвестному пулу, и разметки
// карточки в ответе нет.
&Тест
Процедура ПриватныйПакетОтвечаетКраулеру404БезКарточки() Экспорт

	Закрытый = Клиент.GET("/pools/inner/packages/secretlib");
	Неизвестный = Клиент.GET("/pools/nosuchpool/packages/secretlib");

	Ожидаем.Что(Закрытый.КодСостояния, "приватная страница — 404").Равно(404);
	Ожидаем.Что(Неизвестный.КодСостояния, "самотест: неизвестный пул — 404").Равно(404);
	Ожидаем.Что(СтрЗаменить(Клиент.Тело(Закрытый), "inner", "nosuchpool"),
		"ответ тот же, что у несуществующего пула").Равно(Клиент.Тело(Неизвестный));
	Ожидаем.Что(СтрНайти(Клиент.Тело(Закрытый), "og:"), "карточки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Закрытый), "secretlib"), "имя пакета не утекло").Равно(0);

КонецПроцедуры

#Область Служебное

Функция ГоловаСтраницы(Знач Адрес)

	Ответ = Клиент.GET(Адрес);
	Ожидаем.Что(Ответ.КодСостояния, "страница отдана гостю: " + Адрес).Равно(200);
	Возврат ГоловаОтвета(Ответ);

КонецФункции

Функция ГоловаОтвета(Знач Ответ)

	Страница = Клиент.Тело(Ответ);
	Начало = СтрНайти(Страница, "<head>");
	Конец = СтрНайти(Страница, "</head>");
	Ожидаем.Что(Начало > 0 И Конец > Начало, "самотест: у страницы есть голова").ЭтоИстина();
	Возврат Сред(Страница, Начало, Конец - Начало);

КонецФункции

// Содержание свойства карточки так, как его прочтёт краулер; нет свойства — Неопределено.
Функция Свойство(Знач Голова, Знач Имя)

	Метка = "<meta property=""" + Имя + """ content=""";
	Позиция = СтрНайти(Голова, Метка);
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хвост = Сред(Голова, Позиция + СтрДлина(Метка));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Процедура ЗавестиПул(Знач Имя, Знач Видимость)

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""name"":""%1"",""visibility"":""%2""}", Имя, Видимость), КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("пул ""%1"" заведён: %2", Имя, Клиент.Тело(Ответ))).Равно(201);

КонецПроцедуры

Процедура Опубликовать(Знач Пул, Знач Имя, Знач Версия, Знач Репозиторий)

	Манифест = ПакетыOspx.НовыйМанифест(Имя, Версия).УстановитьАдресРепозитория(Репозиторий);
	Манифест.УстановитьОписание("Описание " + Имя);

	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Клиент.Опубликовать(Пул, Новый ФикстураПакета().ПостроитьOspxПоМанифесту(Каталог, Манифест, "# " + Имя),
		КлючАдмина);

КонецПроцедуры

Функция АдресХаба()
	Возврат "https://hub.example.ru";
КонецФункции

Функция ЛогинАдмина()
	Возврат "card-admin";
КонецФункции

Функция ПарольАдмина()
	Возврат "CardAdminPass1";
КонецФункции

#КонецОбласти
