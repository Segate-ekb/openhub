// «Добавить пакет» в списке пакетов пула и снятие резерва оттуда же — глазами мейнтейнера пула,
// райтера, читателя и гостя; засев кабинета (owner1 — владелец owned, pub — райтер public)
// и пакет owned/yanked-only с единственной отозванной версией.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу
Перем Кнопки;   // фикстура КнопкиСкачиванияСтраницы — кнопки .ospx из разметки

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("КнопкиСкачиванияСтраницы");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	Кнопки = Новый КнопкиСкачиванияСтраницы();

	Хаб.ФайловаяБаза("openhub-добавление-пакета");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(Хаб.ПутьСидера("ЗасеятьКабинет.os"));

	// версия была, но отозвана: такой пакет — не резерв
	Хаб.Среда("OSHUB_SEED_FIXTURE", ОбъединитьПути(КаталогиПроекта.Фикстуры(), "spike0c-testpkg-0.1.0.ospx"));
	Хаб.Среда("OSHUB_SEED_POOL", "owned");
	Хаб.Среда("OSHUB_SEED_PACKAGE", "yanked-only");
	Хаб.Среда("OSHUB_SEED_VERSIONS", "1.0.0");
	Хаб.Среда("OSHUB_SEED_YANKED", "1.0.0");
	Хаб.ЗапуститьСидер(Хаб.ПутьСидера("ЗасеятьПакет.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Кнопка

// Кнопку видит мейнтейнер пула — и больше никто: ни райтер, ни читатель, ни гость. Без скрипта
// она — раскрывашка с обычной формой одного поля.
&Тест
Процедура ДобавитьПакетВидитТолькоМейнтейнерПула() Экспорт

	УВладельца = Клиент.Тело(Клиент.GETСКукой("/pools/owned", Войти("owner1")));
	Ожидаем.Что(СтрНайти(УВладельца, "Добавить пакет") > 0, "мейнтейнер пула видит кнопку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(УВладельца, "<details") > 0, "кнопка раскрывает форму без скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(УВладельца, "action=""/pools/owned/packages""") > 0,
		"форма уходит в список пакетов пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(УВладельца, "name=""имя""") > 0, "и спрашивает имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(РаскрывашкаФормы(УВладельца), " open"), "до нажатия форма свёрнута").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(УВладельца), "onclick="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(УВладельца), "onsubmit="), "и обработчиков отправки тоже").Равно(0);
	Ожидаем.Что(СтрНайти(РаскрывашкаЦеликом(УВладельца), "type=""submit""") > 0,
		"добавление — обычная кнопка отправки формы").ЭтоИстина();

	Для Каждого Логин Из СтрРазделить("pub|bob", "|") Цикл
		Страница = Клиент.Тело(Клиент.GETСКукой("/pools/public", Войти(Логин)));
		Ожидаем.Что(СтрНайти(Страница, "alice-pkg") > 0, "КОНТРОЛЬ: " + Логин + " видит список").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "action=""/pools/public/packages"""),
			Логин + " — не мейнтейнер пула: формы нет").Равно(0);
		Ожидаем.Что(СтрНайти(Страница, "Добавить пакет"), Логин + " — и кнопки тоже").Равно(0);
	КонецЦикла;

	Гостю = Клиент.Тело(Клиент.GET("/pools/public"));
	Ожидаем.Что(СтрНайти(Гостю, "alice-pkg") > 0, "КОНТРОЛЬ: гость видит список").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Гостю, "Добавить пакет"), "гостю кнопки нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Добавление

// Удавшаяся форма ведёт на страницу нового пакета. Она осмысленна без версий: говорит, что их
// нет, как опубликовать первую, и не предлагает ни скачать, ни поставить то, чего нет.
&Тест
Процедура ДобавленныйПакетОткрываетсяСтраницейБезВерсий() Экспорт

	Кука = Войти("owner1");
	Имя = "fresh-name";

	Ответ = Добавить("owned", Имя, Кука);
	Ожидаем.Что(Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400, "форма уводит редиректом: "
		+ Ответ.КодСостояния).ЭтоИстина();
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "на страницу нового пакета")
		.Равно("/pools/owned/packages/" + Имя);

	Карточка = Клиент.GETСКукой("/pools/owned/packages/" + Имя, Кука);
	Ожидаем.Что(Карточка.КодСостояния, "страница пакета открыта").Равно(200);
	Страница = Клиент.Тело(Карточка);
	Ожидаем.Что(СтрНайти(Страница, "Версий пока нет") > 0, "она говорит, что версий нет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Как опубликовать первую версию") > 0,
		"и как опубликовать первую").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "opm push --hub ") > 0, "командой opm push").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "/pools/owned/packages/" + Имя + "/settings/ci") > 0,
		"или доверенным конвейером").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "/pools/owned/packages/" + Имя + "/settings/access") > 0,
		"рядом — права на пакет").ЭтоИстина();
	Ожидаем.Что(Кнопки.Все(Страница).Количество(), "скачивать нечего").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "opm install"), "и ставить нечего").Равно(0);

	Список = Клиент.Тело(Клиент.GETСКукой("/pools/owned", Кука));
	Ожидаем.Что(СтрНайти(КарточкаВСписке(Список, "owned", Имя), "Имя занято, версий ещё нет") > 0,
		"в списке пакетов пула имя помечено резервом").ЭтоИстина();

	Снять("owned", Имя, Кука);

	// читатель публичного пула видит ту же пустую страницу, но без пути публикации
	КукаRoot = Войти("root");
	Добавить("public", "fresh-public", КукаRoot);
	Читателю = Клиент.GETСКукой("/pools/public/packages/fresh-public", Войти("bob"));
	Ожидаем.Что(Читателю.КодСостояния, "КОНТРОЛЬ: читателю страница открыта").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Читателю), "Версий пока нет") > 0, "и говорит, что версий нет")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Читателю), "Как опубликовать первую версию"),
		"не управляющему пакетом путь публикации не предлагают").Равно(0);
	Снять("public", "fresh-public", КукаRoot);

КонецПроцедуры

// Имя служебного слова — обычное имя: страница пакета живёт под /pools/{пул}/packages/{имя}
// и ни с чем не соревнуется, даже с адресом, куда уходит сама форма.
&Тест
Процедура ИмяСлужебногоСловаДобавляетсяКакЛюбое() Экспорт

	Кука = Войти("owner1");
	Для Каждого Имя Из СтрРазделить("settings|packages|versions", "|") Цикл

		Ответ = Добавить("owned", Имя, Кука);
		Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "имя «" + Имя + "» занято, переход — на пакет")
			.Равно("/pools/owned/packages/" + Имя);

		Страница = Клиент.GETСКукой("/pools/owned/packages/" + Имя, Кука);
		Ожидаем.Что(Страница.КодСостояния, "страница пакета «" + Имя + "» открыта").Равно(200);
		Ожидаем.Что(СтрНайти(Клиент.Тело(Страница), "Версий пока нет") > 0,
			"и это страница пакета, а не служебный экран: " + Имя).ЭтоИстина();

		Снять("owned", Имя, Кука);

	КонецЦикла;

КонецПроцедуры

// Отбитая форма возвращается раскрытой, с набранным именем и причиной у поля. Правила те же,
// что у публикации, а уникальность имени в пуле держит приложение.
&Тест
Процедура ОтбитаяФормаВозвращаетсяСНабраннымУПоля() Экспорт

	Кука = Войти("owner1");
	Имя = "dup-name";
	Ожидаем.Что(Добавить("owned", Имя, Кука).КодСостояния < 400, "КОНТРОЛЬ: первое имя занято").ЭтоИстина();

	Дубль = Клиент.POSTФормы("/pools/owned/packages", Поля(Кука, "добавить", ВРег(Имя), ""), Кука);
	Ожидаем.Что(Дубль.КодСостояния, "дубль имени — отказ").Равно(409);
	ПроверитьОтбитую(Клиент.Тело(Дубль), ВРег(Имя), "уже занято");

	Кривое = Клиент.POSTФормы("/pools/owned/packages", Поля(Кука, "добавить", "-плохое имя!", ""), Кука);
	Ожидаем.Что(Кривое.КодСостояния, "недопустимое имя — 400").Равно(400);
	ПроверитьОтбитую(Клиент.Тело(Кривое), "-плохое имя!", "Недопустимое имя пакета");

	Пустое = Клиент.POSTФормы("/pools/owned/packages", Поля(Кука, "добавить", "  ", ""), Кука);
	Ожидаем.Что(Пустое.КодСостояния, "пустое имя — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Пустое), "Укажите имя пакета") > 0, "и названо").ЭтоИстина();

	Снять("owned", Имя, Кука);

КонецПроцедуры

// Пул без публикации пакет без версий не примет: имя осталось бы пустым навсегда. Кнопка
// объясняет это вместо формы, подделанная форма отбивается доменом.
&Тест
Процедура ПулБезПубликацииПакетНеДобавляет() Экспорт

	Кука = Войти("owner1");
	Публикация(Кука, Ложь);
	Попытка
		Страница = Клиент.Тело(Клиент.GETСКукой("/pools/owned", Кука));
		Ожидаем.Что(СтрНайти(Страница, "Публикация в пул выключена") > 0, "кнопка объясняет отказ")
			.ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "name=""имя"""), "формы нет").Равно(0);

		Отказ_ = Клиент.POSTФормы("/pools/owned/packages", Поля(Кука, "добавить", "nopub-name", ""), Кука);
		Ожидаем.Что(Отказ_.КодСостояния, "подделанная форма имя не занимает").Равно(409);
		Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ_), "Публикация в пул выключена") > 0, "причина названа")
			.ЭтоИстина();
	Исключение
		Публикация(Кука, Истина);
		ВызватьИсключение;
	КонецПопытки;
	Публикация(Кука, Истина);

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой("/pools/owned", Кука)), "name=""имя""") > 0,
		"с публикацией форма вернулась").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Снятие

// Снятие — из списка пакетов пула: кнопка в карточке резерва ведёт на шаг подтверждения,
// первый POST только спрашивает, чужое подтверждение снова спрашивает. Снятый резерв уносит
// роли на имя: следующий, кто займёт его, ничего не унаследует.
&Тест
Процедура СнятиеРезерваСпрашиваетИУноситРоли() Экспорт

	Кука = Войти("owner1");
	Имя = "handover-name";
	Права = "/pools/owned/packages/" + Имя + "/settings/access";
	Добавить("owned", Имя, Кука);

	ТокенПрав = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Права, Кука)));
	Клиент.POSTФормы(Права, ПоляРоли(ТокенПрав, "bob", "мейнтейнер"), Кука);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(Права, Кука)), "<td>bob</td>") > 0,
		"КОНТРОЛЬ: роль на резерв выдана").ЭтоИстина();

	Карточка = КарточкаВСписке(Клиент.Тело(Клиент.GETСКукой("/pools/owned", Кука)), "owned", Имя);
	Ожидаем.Что(СтрНайти(Карточка, "href=""/pools/owned?release=" + Имя + """") > 0,
		"в карточке резерва — кнопка снятия").ЭтоИстина();

	Вопрос = Клиент.Тело(Клиент.GETСКукой("/pools/owned?release=" + Имя, Кука));
	Ожидаем.Что(СтрНайти(Вопрос, "Снять резерв имени") > 0, "шаг подтверждения показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вопрос, "name=""подтверждение"" value=""" + Имя + """") > 0,
		"подтверждение повторяет имя").ЭтоИстина();

	Спрос = Клиент.POSTФормы("/pools/owned/packages", Поля(Кука, "снять", Имя, ""), Кука);
	Ожидаем.Что(Спрос.КодСостояния, "без подтверждения — снова вопрос").Равно(200);
	Чужое = Клиент.POSTФормы("/pools/owned/packages", Поля(Кука, "снять", Имя, "dup-other"), Кука);
	Ожидаем.Что(Чужое.КодСостояния, "чужое подтверждение — тоже вопрос").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/packages/" + Имя, Кука).КодСостояния,
		"и пакет на месте").Равно(200);

	Снятие = Клиент.POSTФормыБезПереходов("/pools/owned/packages", Поля(Кука, "снять", Имя, Имя),
		Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Снятие, "Location"), "снятие уводит в список пакетов пула")
		.Равно("/pools/owned");
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/packages/" + Имя, Кука).КодСостояния,
		"пакета без версий больше нет").Равно(404);

	Добавить("owned", Имя, Кука);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(Права, Кука)), "<td>bob</td>"),
		"прежняя роль на имя не пережила снятие").Равно(0);
	Снять("owned", Имя, Кука);

КонецПроцедуры

// Снятый резерв уносит всё, что на него ссылалось: доверие конвейеру, подписку и роль. Тот же
// идентификатор и то же имя достаются следующему пакету чистыми, а снятие видно в журнале аудита.
&Тест
Процедура СнятыйРезервНичегоНеОставляетСледующемуПакету() Экспорт

	Кука = Войти("owner1");
	Токен = Клиент.ВыпуститьPAT(Кука);
	Имя = "inherit-name";
	Добавить("owned", Имя, Кука);

	Доверие = Клиент.ЗапросJSONСТокеном("POST", АдресДоверия(Имя), ТелоДоверия("acme/inherit"), Токен);
	Ожидаем.Что(Доверие.КодСостояния, "КОНТРОЛЬ: резерву доверен конвейер: " + Клиент.Тело(Доверие))
		.Равно(201);
	Подписка = Клиент.ЗапросJSONСТокеном("POST", АдресПодписок(Имя),
		"{""тип"":""вебхук"",""url"":""https://hooks.example.org/inherit"",""события"":[""версия.опубликована""]}",
		Токен);
	Ожидаем.Что(Подписка.КодСостояния, "КОНТРОЛЬ: на резерв заведена подписка: " + Клиент.Тело(Подписка))
		.Равно(201);
	Права = "/pools/owned/packages/" + Имя + "/settings/access";
	Клиент.POSTФормы(Права, ПоляРоли(Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Права, Кука))), "bob",
		"райтер"), Кука);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(Права, Кука)), "<td>bob</td>") > 0,
		"КОНТРОЛЬ: на резерв выдана роль").ЭтоИстина();

	Снять("owned", Имя, Кука);

	Для Каждого Следующий Из СтрРазделить(Имя + "|inherit-other", "|") Цикл
		Добавить("owned", Следующий, Кука);
		ПроверитьЧистоту(Следующий, Токен, Кука);
		Снять("owned", Следующий, Кука);
	КонецЦикла;

	Журнал = Клиент.Тело(Клиент.GETСКукой("/hub/settings/audit", Войти("root")));
	Ожидаем.Что(СтрНайти(Журнал, "пакет.удалён") > 0, "снятие резерва записано в журнал аудита").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, "owned/" + Имя) > 0, "запись называет снятый пакет").ЭтоИстина();

КонецПроцедуры

// Отозванная версия — тоже версия: пакет с одними отозванными — не резерв, ни пометкой, ни
// снятием. Пакет с живыми версиями резервом не снимается тем более.
&Тест
Процедура ПакетСВерсиямиКакРезервНеСнимается() Экспорт

	Кука = Войти("owner1");
	Список = Клиент.Тело(Клиент.GETСКукой("/pools/owned", Кука));
	Отозванный = КарточкаВСписке(Список, "owned", "yanked-only");
	Ожидаем.Что(ЗначениеЗаполнено(Отозванный), "КОНТРОЛЬ: пакет с отозванной версией в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отозванный, "Имя занято, версий ещё нет"), "пометки «резерв» у него нет")
		.Равно(0);
	Ожидаем.Что(СтрНайти(Отозванный, "release="), "и снимать его как резерв не предлагают").Равно(0);

	Вопрос = Клиент.Тело(Клиент.GETСКукой("/pools/owned?release=yanked-only", Кука));
	Ожидаем.Что(СтрНайти(Вопрос, "Снять резерв имени"), "по адресу вопроса не задают").Равно(0);

	Подделка = Клиент.POSTФормы("/pools/owned/packages",
		Поля(Кука, "снять", "yanked-only", "yanked-only"), Кука);
	Ожидаем.Что(Подделка.КодСостояния, "подделанное снятие отбито").Равно(409);
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/packages/yanked-only", Кука).КодСостояния,
		"пакет на месте").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Отказы

// Порог держит сервер: подделанная форма без права не добавляет и не снимает — ни у райтера,
// ни у читателя, ни у гостя.
&Тест
Процедура ПодделкаФормыБезПраваОтбивается() Экспорт

	Для Каждого Логин Из СтрРазделить("pub|bob", "|") Цикл
		Кука = Войти(Логин);
		Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/security", Кука)));
		Ответ = Клиент.POSTФормы("/pools/public/packages", ПоляСТокеном(Токен, "добавить", "steal-" + Логин, ""),
			Кука);
		Ожидаем.Что(Ответ.КодСостояния, Логин + " имя не занимает").Равно(403);
		Снятие = Клиент.POSTФормы("/pools/public/packages", ПоляСТокеном(Токен, "снять", "alice-pkg",
			"alice-pkg"), Кука);
		Ожидаем.Что(Снятие.КодСостояния, Логин + " и не снимает").Равно(403);
	КонецЦикла;

	Гость = Клиент.POSTФормыБезПереходов("/pools/public/packages",
		ПоляСТокеном("", "добавить", "steal-guest", ""), "");
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Гость, "Location"), "гостя уводят ко входу").Равно("/login");

	БезТокена = Клиент.POSTФормы("/pools/owned/packages", ПоляСТокеном("", "добавить", "no-csrf", ""),
		Войти("owner1"));
	Ожидаем.Что(БезТокена.КодСостояния, "форма без токена сессии отбита").Равно(403);

	Список = Клиент.Тело(Клиент.GETСКукой("/pools/public", Войти("root")));
	Ожидаем.Что(СтрНайти(Список, "steal-"), "КОНТРОЛЬ: ни одно имя не занято").Равно(0);
	Ожидаем.Что(СтрНайти(Список, "alice-pkg") > 0, "и alice-pkg на месте").ЭтоИстина();

КонецПроцедуры

// Раздела резервов в настройках пула больше нет: адреса нет, пункта меню тоже.
&Тест
Процедура РазделаРезервовВНастройкахПулаНет() Экспорт

	Кука = Войти("owner1");
	Ожидаем.Что(Клиент.GETСКукой("/pools/owned/settings/reserved", Кука).КодСостояния,
		"прежний адрес раздела — 404").Равно(404);
	Настройки = Клиент.Тело(Клиент.GETСКукой("/pools/owned/settings", Кука));
	Ожидаем.Что(СтрНайти(Настройки, "/pools/owned/settings/access") > 0,
		"КОНТРОЛЬ: дерево разделов на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Настройки, "settings/reserved"), "пункта резервов в нём нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Войти(Знач Логин)
	Возврат Клиент.Войти(Логин, Пароль(Логин));
КонецФункции

Функция Пароль(Знач Логин)
	Пароли = Новый Соответствие();
	Пароли.Вставить("owner1", "Owner1Passw0rd");
	Пароли.Вставить("pub", "PubPassw0rd");
	Пароли.Вставить("bob", "BobPassw0rd");
	Пароли.Вставить("root", "RootPassw0rd");
	Возврат Пароли.Получить(Логин);
КонецФункции

// «Добавить пакет» без переходов: удавшаяся форма отвечает редиректом.
Функция Добавить(Знач Пул, Знач Имя, Знач Кука)
	Возврат Клиент.POSTФормыБезПереходов("/pools/" + Пул + "/packages", Поля(Кука, "добавить", Имя, ""),
		Клиент.СтрокаКукиСессии(Кука));
КонецФункции

// Уборка: снятие подтверждённой формой, чтобы набор не зависел от порядка тестов.
Процедура Снять(Знач Пул, Знач Имя, Знач Кука)
	Клиент.POSTФормы("/pools/" + Пул + "/packages", Поля(Кука, "снять", Имя, Имя), Кука);
КонецПроцедуры

// Поля формы с токеном сессии: он берётся с экрана, где форма с токеном есть всегда.
Функция Поля(Знач Кука, Знач Операция, Знач Имя, Знач Подтверждение)
	Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/security", Кука)));
	Возврат ПоляСТокеном(Токен, Операция, Имя, Подтверждение);
КонецФункции

Функция ПоляСТокеном(Знач Токен, Знач Операция, Знач Имя, Знач Подтверждение)
	Поля = Новый Соответствие();
	Если ЗначениеЗаполнено(Токен) Тогда
		Поля.Вставить("_csrf", Токен);
	КонецЕсли;
	Поля.Вставить("операция", Операция);
	Поля.Вставить("имя", Имя);
	Если ЗначениеЗаполнено(Подтверждение) Тогда
		Поля.Вставить("подтверждение", Подтверждение);
	КонецЕсли;
	Возврат Поля;
КонецФункции

Функция ПоляРоли(Знач Токен, Знач Субъект, Знач Роль)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "выдать");
	Поля.Вставить("тип_субъекта", "пользователь");
	Поля.Вставить("субъект", Субъект);
	Поля.Вставить("роль", Роль);
	Возврат Поля;
КонецФункции

Процедура ПроверитьЧистоту(Знач Имя, Знач Токен, Знач Кука)

	Доверие = Клиент.GETСТокеном(АдресДоверия(Имя), Токен);
	Ожидаем.Что(Доверие.КодСостояния, "КОНТРОЛЬ: доверие пакета читается").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Доверие).Получить("items").Количество(),
		"у пакета «" + Имя + "» нет унаследованного доверия").Равно(0);

	Подписки = Клиент.GETСТокеном(АдресПодписок(Имя), Токен);
	Ожидаем.Что(Подписки.КодСостояния, "КОНТРОЛЬ: подписки пакета читаются").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Подписки).Получить("total"),
		"у пакета «" + Имя + "» нет унаследованных подписок").Равно(0);

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой("/pools/owned/packages/" + Имя + "/settings/access",
		Кука)), "<td>bob</td>"), "у пакета «" + Имя + "» нет унаследованной роли").Равно(0);

КонецПроцедуры

Функция АдресДоверия(Знач Имя)
	Возврат "/api/v1/pools/owned/packages/" + Имя + "/trusted-workflows";
КонецФункции

Функция АдресПодписок(Знач Имя)
	Возврат "/api/v1/pools/owned/packages/" + Имя + "/webhooks";
КонецФункции

Функция ТелоДоверия(Знач Репозиторий)
	Возврат СтрШаблон("{""провайдер"":""github"",""издатель"":""https://token.actions.githubusercontent.com"","
		+ """репозиторий"":""%1"",""реф"":""refs/heads/main""}", Репозиторий);
КонецФункции

Процедура Публикация(Знач Кука, Знач Разрешить)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/pools/owned/settings/upstreams",
		Кука))));
	Поля.Вставить("операция", "флаги");
	Поля.Вставить("публикация", ?(Разрешить, "1", "0"));
	Клиент.POSTФормы("/pools/owned/settings/upstreams", Поля, Кука);
КонецПроцедуры

// Отбитая форма раскрыта, набранное имя на месте, причина — у поля.
Процедура ПроверитьОтбитую(Знач Страница, Знач Набранное, Знач Причина)
	Ожидаем.Что(СтрНайти(РаскрывашкаФормы(Страница), " open") > 0, "форма приехала раскрытой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "value=""" + Набранное + """") > 0,
		"набранное имя не потерялось: " + Набранное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "field--error") > 0, "поле помечено отказом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, Причина) > 0, "причина названа: " + Причина).ЭтоИстина();
КонецПроцедуры

// Раскрывашка «Добавить пакет» целиком — от открывающего тега до закрывающего.
Функция РаскрывашкаЦеликом(Знач Страница)

	Начало = СтрНайти(Страница, РаскрывашкаФормы(Страница));
	Если Начало = 0 ИЛИ НЕ ЗначениеЗаполнено(РаскрывашкаФормы(Страница)) Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Страница, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</details>"));

КонецФункции

// Открывающий тег раскрывашки, в которой стоит поле имени «Добавить пакет».
Функция РаскрывашкаФормы(Знач Страница)

	Поле = СтрНайти(Страница, "id=""add-package-name""");
	Если Поле = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Лев(Страница, Поле), "<details", НаправлениеПоиска.СКонца);
	Хвост = Сред(Страница, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Карточка пакета в списке — статья от ссылки на страницу пакета до конца статьи.
Функция КарточкаВСписке(Знач Страница, Знач Пул, Знач Имя)

	Ссылка = СтрНайти(Страница, "href=""/pools/" + Пул + "/packages/" + Имя + """");
	Если Ссылка = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Лев(Страница, Ссылка), "<article", НаправлениеПоиска.СКонца);
	Хвост = Сред(Страница, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</article>"));

КонецФункции

#КонецОбласти
