// Публичный вход на живом хабе: онбординг-редирект и мастер /setup, регистрация, аккаунт
// в шапке, /logout; второй хаб — с отключённой регистрацией.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;     // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;  // фикстура КлиентХаба — запросы к подопытному хабу

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 15);

	Хаб.ФайловаяБаза("openhub-4ui");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_AUTH_REGISTRATION_MODE", "");
	// без почты форма регистрации есть только при выключенном подтверждении адреса
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ПолныйСценарий4UI() Экспорт

	Ожидаем.Что(РедиректНаSetup("/"), "лендинг → /setup на онбординге").ЭтоИстина();
	Ожидаем.Что(РедиректНаSetup("/packages"), "каталог → /setup на онбординге").ЭтоИстина();

	Состояние = Клиент.ТелоJSON(Клиент.GETДанных("/setup"));
	Ожидаем.Что(Состояние.Получить("onboarding_needed"), "JSON-контракт /setup").ЭтоИстина();

	ФормаSetup = Клиент.Тело(Клиент.GETСтраницы("/setup"));
	Ожидаем.Что(СтрНайти(ФормаSetup, "Первый запуск") > 0, "HTML-форма мастера").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "action=""/setup""") > 0, "форма постит на /setup").ЭтоИстина();

	// требования к паролю названы прямо у поля — словами и с кодом живой проверки,
	// а не отсылкой к ключам конфигурации
	Ожидаем.Что(СтрНайти(ФормаSetup, "data-pwreq=""пароль""") > 0,
		"подсказка привязана к полю пароля мастера").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "data-pwrule=""length""") > 0,
		"и несёт код требования длины").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "длина от 8 до 256 символов") > 0,
		"а человек читает требование словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаSetup, "oshub.auth.password"),
		"к ключам конфигурации мастер больше не отсылает").Равно(0);

	СтраницаВхода = Клиент.Тело(Клиент.GETСтраницы("/login"));
	Ожидаем.Что(СтрНайти(СтраницаВхода, "Первый запуск"), "/login не редиректит на /setup").Равно(0);
	Ожидаем.Что(СтрНайти(СтраницаВхода, "href=""/register""") > 0, "ссылка на регистрацию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтраницаВхода, "Зарегистрироваться") > 0, "кнопка Зарегистрироваться").ЭтоИстина();

	ОтветApiРано = Клиент.POSTДанных("/api/v1/users",
		"{""логин"":""eve"",""email"":""eve@ex.com"",""пароль"":""EveSecret1""}");
	Ожидаем.Что(ОтветApiРано.КодСостояния, "POST /users на пустой БД отклонён").Равно(403);
	Ожидаем.Что(Клиент.ТелоJSON(ОтветApiРано).Получить("error").Получить("code")).Равно("registration_locked_onboarding");
	Клиент.POSTФормыСтраницы("/register", "логин=eve&email=eve%40ex.com&пароль=EveSecret1");
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETДанных("/setup")).Получить("onboarding_needed"),
		"после попыток анонимной регистрации онбординг всё ещё нужен").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTДанных("/setup", "{""логин"":""root"",""пароль"":""RootSecret1""}").КодСостояния).Равно(201);

	Лендинг = Клиент.GETСтраницы("/");
	Ожидаем.Что(Лендинг.КодСостояния).Равно(200);
	ТелоЛендинга = Клиент.Тело(Лендинг);
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "Первый запуск"), "лендинг больше не редиректит").Равно(0);
	Ожидаем.Что(СтрНайти(ТелоЛендинга, ">Войти<") > 0, "шапка анонима: Войти").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "Выйти"), "у анонима нет Выйти").Равно(0);

	// свежий хаб без пакетов объясняет, что делать дальше, а не показывает нули в рамочках
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "На хабе пока нет пакетов") > 0,
		"пустое состояние вместо пустых счётчиков").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "opm push") > 0, "и называет способ опубликовать первый").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "tile__value"), "плиток со счётчиками на пустом хабе нет").Равно(0);
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "Недавно опубликовано"), "и пустых списков тоже").Равно(0);
	// поиск на месте всегда: пустой хаб — не повод прятать вход в каталог
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "action=""/packages""") > 0, "поиск с главной на месте").ЭтоИстина();

	СтраницаSetupПосле = Клиент.Тело(Клиент.GETСтраницы("/setup"));
	Ожидаем.Что(СтрНайти(СтраницаSetupПосле, "инициализирован") > 0,
		"GET /setup после онбординга — сообщение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтраницаSetupПосле, "action=""/setup"""),
		"рабочей формы мастера быть не должно").Равно(0);
	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GETДанных("/setup")).Получить("onboarding_needed"),
		"JSON-контракт /setup остаётся false").ЭтоЛожь();

	ФормаРег = Клиент.Тело(Клиент.GETСтраницы("/register"));
	Ожидаем.Что(СтрНайти(ФормаРег, "action=""/register""") > 0, "форма регистрации").ЭтоИстина();

	// требования к паролю человек читает там же, где его набирает: словами — без скрипта,
	// кодом — для отметки выполненных по мере набора
	Ожидаем.Что(СтрНайти(ФормаРег, "data-pwreq=""пароль""") > 0,
		"подсказка привязана к полю пароля регистрации").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаРег, "data-pwmin=""8""") > 0,
		"граница длины приехала из политики числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаРег, ">длина от 8 до 256 символов<") > 0,
		"и она же напечатана словами").ЭтоИстина();
	// политика по умолчанию классов символов не требует — лишних строк в списке нет
	Ожидаем.Что(СтрНайти(ФормаРег, "data-pwrule=""digit"""),
		"невключённого требования в списке нет").Равно(0);

	ОтветРег = Клиент.POSTФормыСтраницы("/register", "логин=bob&email=bob%40ex.com&пароль=BobSecret1");
	Ожидаем.Что(ОтветРег.КодСостояния < 400, "регистрация не вернула ошибку").ЭтоИстина();

	ОтветВход = Клиент.POSTДанных("/api/v1/login", "{""логин"":""bob"",""пароль"":""BobSecret1""}");
	Ожидаем.Что(ОтветВход.КодСостояния, "вход зарегистрированного пользователя").Равно(200);
	КукаСессии = Клиент.КукаСессии(ОтветВход);
	Ожидаем.Что(ЗначениеЗаполнено(КукаСессии), "вход выдал сессионную куку").ЭтоИстина();

	ТелоАвторизованного = Клиент.Тело(Клиент.GETСтраницы("/", КукаСессии));
	Ожидаем.Что(СтрНайти(ТелоАвторизованного, "bob") > 0, "логин в шапке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоАвторизованного, "Выйти") > 0, "кнопка Выйти").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоАвторизованного, ">Войти<"), "у авторизованного нет Войти").Равно(0);

	// вошедшему пустой хаб даёт проводник первой публикации — он за гвардом кабинета,
	// поэтому анониму его не предлагают
	Ожидаем.Что(СтрНайти(ТелоАвторизованного, "href=""/tour""") > 0,
		"вошедшему предложен проводник первой публикации").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоЛендинга, "href=""/tour"""),
		"анониму проводник не предлагается").Равно(0);

	Клиент.POSTФормыСтраницы("/logout", "", КукаСессии);
	Ожидаем.Что(Клиент.GETСКукой("/api/v1/whoami", КукаСессии).КодСостояния,
		"после выхода сессия недействительна").Равно(401);

КонецПроцедуры

&Тест
Процедура РегистрацияОтключенаНеВыдаётФормуИОтклоняетPOST() Экспорт

	ХабB = Новый ЭкземплярХаба(90);
	ХабB.ФайловаяБаза("openhub-4ui-off");
	ХабB.Среда("OSHUB_ADMIN_LOGIN", "root");
	ХабB.Среда("OSHUB_ADMIN_PASSWORD", "RootSecret1");
	ХабB.Среда("OSHUB_AUTH_REGISTRATION_MODE", "disabled");

	Попытка
		ХабB.Запустить();
		ХабB.ДождатьсяОнбординга();
		КлиентB = Новый КлиентХаба(ХабB);

		Страница = КлиентB.Тело(КлиентB.GETСтраницы("/register"));
		Ожидаем.Что(СтрНайти(Страница, "отключена") > 0, "сообщение об отключённой регистрации").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Страница, "action=""/register"""), "формы регистрации быть не должно").Равно(0);

		Ответ = КлиентB.POSTФормыСтраницы("/register", "логин=eve&email=e%40ex.com&пароль=EveSecret1");
		Ожидаем.Что(Ответ.КодСостояния, "POST регистрации отклонён").Равно(403);

	Исключение
		ХабB.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	ХабB.Остановить();

КонецПроцедуры

#Область Служебное

Функция РедиректНаSetup(Знач Путь)
	Ответ = Клиент.GETСтраницы(Путь);
	Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда
		Возврат СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "/setup") > 0;
	КонецЕсли;
	Возврат СтрНайти(Клиент.Тело(Ответ), "Первый запуск") > 0;
КонецФункции

#КонецОбласти
