// Дерево получателей подписки на живом хабе: администратор видит в форме подписки хаба все пулы,
// включая приватные, снимает галку — исключение сохраняется и гасит доставку; владелец пула правит
// дерево своей подписки и не видит чужих исключений. Засев кабинета: публичный пул public с пакетом
// alice-pkg, приватные owned и secret (с пакетом secret-pkg) во владении owner1.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;            // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;         // фикстура КлиентХаба — все запросы к подопытному хабу
Перем КаталогСборки;  // временный каталог под .ospx публикаций

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-дерево-ospx");

	Хаб.ФайловаяБаза("openhub-дерево-получателей");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// разбор очереди откладываем на час: задания остаются в таблице, и по ним видно, кому событие ушло
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__INTERVAL__SEC", "3600");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборки);
КонецПроцедуры

#Область Тесты

&Тест
Процедура ДеревоПодпискиХабаНесётВсеПулыИПакетыСвёрнутымиВетками() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ид = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/tree-form");

	Свёрнуто = Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot));
	Ожидаем.Что(Свёрнуто, "в карточке — ссылка на дерево").Содержит("/hub/settings/webhooks?recipients=" + Ид);
	Ожидаем.Что(СтрНайти(Свёрнуто, "получатель_"), "галок без запроса дерева нет").Равно(0);

	Страница = Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks?recipients=" + Ид, КукаRoot));
	Поля = Клиент.ПоляФормыСо(Страница, "webhooks/" + Ид + "/recipients");
	Для Каждого Пул Из СтрРазделить("public,owned,secret", ",") Цикл
		Ожидаем.Что(Поля.Получить("получатель_пул_" + Ид_(Пул)), СтрШаблон("пул %1 в дереве и включён", Пул))
			.Равно("1");
	КонецЦикла;
	Ожидаем.Что(Поля.Получить(ИмяГалкиПакета("alice-pkg")), "пакет публичного пула вторым уровнем").Равно("1");
	Ожидаем.Что(Поля.Получить(ИмяГалкиПакета("secret-pkg")), "и пакет приватного").Равно("1");
	Ожидаем.Что(Страница, "приватный пул помечен").Содержит("приватный");

КонецПроцедуры

&Тест
Процедура СнятаяГалкаСохраняетсяИГаситДоставку() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Адрес = "https://hooks.example.com/tree-effect";
	Ид = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", Адрес);
	Дерево = "/hub/settings/webhooks?recipients=" + Ид;

	Снятые = Новый Соответствие();
	Снятые.Вставить("получатель_пул_" + Ид_("secret"), Ложь);
	Снятые.Вставить(ИмяГалкиПакета("alice-pkg"), Ложь);
	Поля = Клиент.ПоляФормыСо(Клиент.Тело(Клиент.GETСКукой(Дерево, КукаRoot)), "webhooks/" + Ид + "/recipients", Снятые);
	Ответ = Клиент.POSTФормыБезПереходов("/hub/settings/webhooks/" + Ид + "/recipients", Поля,
		Клиент.СтрокаКукиСессии(КукаRoot));
	Ожидаем.Что(Ответ.КодСостояния, "галки легли, хаб уводит на открытое дерево").Равно(302);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "туда же").Содержит("recipients=" + Ид);

	Сохранённые = Клиент.ПоляФормыСо(Клиент.Тело(Клиент.GETСКукой(Дерево, КукаRoot)), "webhooks/" + Ид + "/recipients");
	Ожидаем.Что(Сохранённые.Получить("получатель_пул_" + Ид_("secret")), "пул secret снят").Равно(Неопределено);
	Ожидаем.Что(Сохранённые.Получить(ИмяГалкиПакета("alice-pkg")), "alice-pkg снят").Равно(Неопределено);
	Ожидаем.Что(Сохранённые.Получить("получатель_пул_" + Ид_("public")), "его пул включён").Равно("1");
	Ожидаем.Что(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot)), "свёрнутая сводка")
		.Содержит("пулов — 1, пакетов — 1");

	Токен = Клиент.ВыпуститьPAT(КукаRoot);
	Опубликовать("public", "alice-pkg", "9.0.0", Токен);
	Опубликовать("public", "tree-newcomer", "1.0.0", Токен);
	Опубликовать("secret", "tree-hidden", "1.0.0", Токен);

	Доставлено = ПакетыЗаданийДоставки(Адрес, "tree-newcomer");
	Ожидаем.Что(Доставлено, "новый пакет включённого пула получает событие").Содержит("tree-newcomer");
	Ожидаем.Что(Доставлено.Найти("alice-pkg"), "исключённый пакет — нет").Равно(Неопределено);
	Ожидаем.Что(Доставлено.Найти("tree-hidden"), "пакет исключённого пула — нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ВладелецПулаПравитДеревоСвоейПодпискиБезПодпискиХаба() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks",
		"https://hooks.example.com/tree-above", Истина);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Своя = ПодпискаВAPI(КукаOwner, "/api/v1/pools/secret/webhooks", Раздел, "https://hooks.example.com/tree-pool");

	Поля = Клиент.ПоляФормыСо(Клиент.Тело(Клиент.GETСКукой(Раздел + "?recipients=" + Своя, КукаOwner)),
		"webhooks/" + Своя + "/recipients");
	Ожидаем.Что(Поля.Получить(ИмяГалкиПакета("secret-pkg")), "пакет своего пула в дереве").Равно("1");
	Ожидаем.Что(Поля.Получить("получатель_пул_" + Ид_("secret")), "своего пула галкой нет").Равно(Неопределено);

	Найденное = Клиент.ПоляФормыСо(Клиент.Тело(Клиент.GETСКукой(Раздел + "?recipients=" + Своя + "&find=secret",
		КукаOwner)), "webhooks/" + Своя + "/recipients");
	Ответ = Клиент.POSTФормыБезПереходов(Раздел + "/" + Своя + "/recipients", Найденное,
		Клиент.СтрокаКукиСессии(КукаOwner));
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "после сохранения поиск остаётся").Содержит("find=secret");

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(Раздел + "?recipients=" + Хаба, КукаOwner)), "получатель_"),
		"дерево подписки хаба под адресом пула не открывается").Равно(0);
	Ожидаем.Что(Клиент.POSTФормы(Раздел + "/" + Хаба + "/recipients", Поля, КукаOwner).КодСостояния,
		"галки подписки хаба из раздела пула — как несуществующей").Равно(404);

КонецПроцедуры

&Тест
Процедура ИсключениеХабомНеВидноВРазделахИсключённогоПулаИПакета() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks",
		"https://hooks.example.com/tree-masked", Истина);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	РазделПула = "/pools/secret/settings/webhooks";
	РазделПакета = "/pools/secret/packages/secret-pkg/settings/webhooks";
	ПулДо = Клиент.Тело(Клиент.GETСКукой(РазделПула, КукаOwner));
	ПакетДо = Клиент.Тело(Клиент.GETСКукой(РазделПакета, КукаOwner));
	Ожидаем.Что(ПулДо, "подписка хаба видна пулу сверху").Содержит("Подписки сверху");

	Снятые = Новый Соответствие();
	Снятые.Вставить("получатель_пул_" + Ид_("secret"), Ложь);
	Снятые.Вставить(ИмяГалкиПакета("secret-pkg"), Ложь);
	Ответ = Клиент.POSTФормыБезПереходов("/hub/settings/webhooks/" + Хаба + "/recipients",
		Клиент.ПоляФормыСо(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks?recipients=" + Хаба, КукаRoot)),
			"webhooks/" + Хаба + "/recipients", Снятые), Клиент.СтрокаКукиСессии(КукаRoot));
	Ожидаем.Что(Ответ.КодСостояния, "хаб исключил пул secret и его пакет").Равно(302);
	Ожидаем.Что(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot)), "исключения легли")
		.Содержит("пулов — 1, пакетов — 1");

	Ожидаем.Что(Клиент.Тело(Клиент.GETСКукой(РазделПула, КукаOwner)),
		"раздел исключённого пула тот же, что до исключения").Равно(ПулДо);
	Ожидаем.Что(Клиент.Тело(Клиент.GETСКукой(РазделПакета, КукаOwner)),
		"раздел исключённого пакета тот же, что до исключения").Равно(ПакетДо);

КонецПроцедуры

&Тест
Процедура ГалкаПакетаЧужогоПулаНеОтличимаОтНесуществующего() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/pools", "{""имя"":""tree-foreign-private"",""видимость"":""private""}",
		Клиент.ЗаголовкиМутации(КукаRoot, Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot)))));
	Ожидаем.Что(Ответ.КодСостояния, "чужой приватный пул заведён: " + Клиент.Тело(Ответ)).Равно(201);
	Опубликовать("tree-foreign-private", "tree-foreign-pkg", "1.0.0", Клиент.ВыпуститьPAT(КукаRoot));
	Чужой = ИдПакета("tree-foreign-private", "tree-foreign-pkg");

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Своя = ПодпискаВAPI(КукаOwner, "/api/v1/pools/secret/webhooks", Раздел, "https://hooks.example.com/tree-probe");
	Свой = ИдПакета("secret", "secret-pkg");

	Исходы = Новый Массив();
	Для Каждого Номер Из СтрРазделить(Чужой + ",99999999", ",") Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, КукаOwner))));
		Поля.Вставить("показанные_узлы", "пакет_" + Номер + ",пакет_" + Свой);
		Ответ = Клиент.POSTФормыБезПереходов(Раздел + "/" + Своя + "/recipients", Поля,
			Клиент.СтрокаКукиСессии(КукаOwner));
		Исходы.Добавить(Формат(Ответ.КодСостояния, "ЧГ=0") + " " + Клиент.ЗаголовокОтвета(Ответ, "Location"));
		Страница = Клиент.Тело(Клиент.GETСКукой(Раздел + "?recipients=" + Своя, КукаOwner));
		Ожидаем.Что(СтрНайти(Страница, "tree-foreign-pkg"), "имени чужого пакета на странице нет").Равно(0);
	КонецЦикла;

	Ожидаем.Что(Исходы[0], "галки легли, хаб уводит на дерево").Содержит("302");
	Ожидаем.Что(Исходы[1], "пакет чужого приватного пула неотличим от несуществующего").Равно(Исходы[0]);
	Ожидаем.Что(Клиент.Тело(Клиент.GETСКукой(Раздел, КукаOwner)), "свой пакет исключён, чужой не записан")
		.Содержит("Исключены из подписки: пакетов — 1.");

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Подписка объекта через API с CSRF страницы раздела; идентификатор — из ответа на создание.
Функция ПодпискаВAPI(Знач Кука, Знач Путь, Знач Раздел, Знач Адрес, Знач Сужаемая = Ложь)

	Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, Кука)));
	Тело = СтрШаблон("{""kind"":""вебхук"",""URL"":""%1"",""events"":[""версия.опубликована""]%2}",
		Адрес, ?(Сужаемая, ",""narrowing_allowed"":true", ""));
	Ответ = Клиент.ЗапросJSON("POST", Путь, Тело, Клиент.ЗаголовкиМутации(Кука, Токен));
	Ожидаем.Что(Ответ.КодСостояния, "подписка заведена: " + Клиент.Тело(Ответ)).Равно(201);
	Возврат Формат(Клиент.ТелоJSON(Ответ).Получить("subscription").Получить("id"), "ЧГ=0");

КонецФункции

// Идентификатор пула засева — из ответа API пулов.
Функция Ид_(Знач ИмяПула)

	Ответ = Клиент.ЗапросJSON("GET", "/api/v1/pools/" + ИмяПула, "", Клиент.Кука(Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(Ответ.КодСостояния, "пул " + ИмяПула + " читается").Равно(200);
	Пул = Клиент.ТелоJSON(Ответ);
	Пул = ?(Пул.Получить("pool") = Неопределено, Пул, Пул.Получить("pool"));
	Возврат Формат(Пул.Получить("id"), "ЧГ=0");

КонецФункции

// Идентификатор пакета строкой — из API пакета, глазами root.
Функция ИдПакета(Знач ИмяПула, Знач ИмяПакета)

	Ответ = Клиент.ЗапросJSON("GET", СтрШаблон("/api/v1/pools/%1/packages/%2", ИмяПула, ИмяПакета), "",
		Клиент.Кука(Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(Ответ.КодСостояния, "пакет " + ИмяПакета + " читается").Равно(200);
	Пакет = Клиент.ТелоJSON(Ответ);
	Пакет = ?(Пакет.Получить("package") = Неопределено, Пакет, Пакет.Получить("package"));
	Возврат Формат(Пакет.Получить("id"), "ЧГ=0");

КонецФункции

// Имя галки пакета засева: идентификатор пакета читается из API пакета.
Функция ИмяГалкиПакета(Знач ИмяПакета)

	ИмяПула = ?(ИмяПакета = "alice-pkg", "public", "secret");
	Ответ = Клиент.ЗапросJSON("GET", СтрШаблон("/api/v1/pools/%1/packages/%2", ИмяПула, ИмяПакета), "",
		Клиент.Кука(Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(Ответ.КодСостояния, "пакет " + ИмяПакета + " читается").Равно(200);
	Пакет = Клиент.ТелоJSON(Ответ);
	Пакет = ?(Пакет.Получить("package") = Неопределено, Пакет, Пакет.Получить("package"));
	Возврат "получатель_пакет_" + Формат(Пакет.Получить("id"), "ЧГ=0");

КонецФункции

Процедура Опубликовать(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Токен)

	Ответ = Клиент.ОтправитьАртефакт(СтрШаблон("/api/v1/pools/%1/push", ИмяПула),
		Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия),
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), Токен);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("%1 %2 опубликован: %3", ИмяПакета, Версия, Клиент.Тело(Ответ)))
		.Равно(201);

КонецПроцедуры

// Пакеты из тел заданий доставки на адрес подписки — разбором таблицы файловой базы. Таблицу
// дописывает подписчик после ответа на публикацию: ждём, пока в ней появится названный пакет.
Функция ПакетыЗаданийДоставки(Знач Адрес, Знач ЖдатьПакет)

	Для Заход = 1 По 40 Цикл
		Пакеты = Новый Массив();
		Для Каждого Строка_ Из СтрокиЗаданийДоставки() Цикл
			Поля = РазобратьJSON(Строка_.Получить("Тело"));
			Если ТипЗнч(Поля) = Тип("Соответствие") И СтрНайти(Строка_.Получить("НастройкиJSON"), Адрес) > 0 Тогда
				Пакеты.Добавить(Поля.Получить("пакет"));
			КонецЕсли;
		КонецЦикла;
		Если Пакеты.Найти(ЖдатьПакет) <> Неопределено Тогда
			Возврат Пакеты;
		КонецЕсли;
		Приостановить(250);
	КонецЦикла;
	Возврат Пакеты;

КонецФункции

Функция СтрокиЗаданийДоставки()

	Результат = Новый Массив();
	Найденные = НайтиФайлы(Хаб.КаталогБазы(), "*ЗаданияДоставки*", Истина);
	Если Найденные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Найденные[0].ПолноеИмя, КодировкаТекста.UTF8);
	Таблица = РазобратьJSON(Чтение.Прочитать());
	Чтение.Закрыть();
	Если ТипЗнч(Таблица) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Таблица Цикл
			Если ТипЗнч(Элемент.Значение) = Тип("Соответствие") Тогда
				Результат.Добавить(Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Недочитанный файл (его пишет хаб) — не JSON: такой заход просто повторяется.
Функция РазобратьJSON(Знач Текст)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
