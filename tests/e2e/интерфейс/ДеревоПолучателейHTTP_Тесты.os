// Окно «Получатели» подписки на живом хабе: администратор видит в окне подписки хаба все пулы,
// включая приватные, с настоящим режимом «Все / Выбранные / Никто»; правки окна сохраняются и гасят
// доставку, сегмент «Выбранные» (со скриптом и без) начинает с того, что было видно, и не берёт новых
// пакетов; галки пакетов пула «все» и «никакие» заперты; владелец пула правит окно своей подписки
// сегментами и галками и не видит чужих отметок; дверь окна постороннему закрыта; в окне «Пакеты пула»
// поправки к подписке хаба снимает свои пакеты.
// Засев кабинета: публичный пул public с пакетом
// alice-pkg (набор публикует в него второй — tree-companion), приватные owned и secret (с пакетом
// secret-pkg) во владении owner1.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;            // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;         // фикстура КлиентХаба — все запросы к подопытному хабу
Перем КаталогСборки;  // временный каталог под .ospx публикаций

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ГалкиВРазметке");
	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-дерево-ospx");

	Хаб.ФайловаяБаза("openhub-дерево-получателей");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// разбор очереди откладываем на час: задания остаются в таблице, и по ним видно, кому событие ушло
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__INTERVAL__SEC", "3600");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));

	Хаб.Запустить();

	// у пула public — два пакета: снятый в «выбранных» один оставляет второй, а не снимает пул целиком
	Опубликовать("public", "tree-companion", "1.0.0", Клиент.ВыпуститьPAT(Клиент.Войти("root", "RootPassw0rd")));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	УникальныеИмена.УбратьВременное(КаталогСборки);
КонецПроцедуры

#Область Тесты

// Окно «Получатели» подписки хаба по адресу: все пулы, включая приватные, строками с режимом;
// пакеты пула приезжают страницей ветки с двери окна.
&Тест
Процедура ОкноПодпискиХабаНесётВсеПулыСРежимамиАПакетыПоАдресу() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ид = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/tree-form");

	Раздел = Страница("/hub/settings/webhooks", КукаRoot);
	Ожидаем.Что(Раздел, "в меню записи — окно получателей по адресу").Содержит(Код("окно") + "=" + Код("получатели-" + Ид));
	Ожидаем.Что(СтрНайти(Раздел, "data-checktree-modes"), "дерева без окна на странице нет").Равно(0);

	Окно = Страница(ОкноПолучателей("/hub/settings/webhooks", Ид), КукаRoot);
	Для Каждого Пул Из СтрРазделить("public,owned,secret", ",") Цикл
		Ожидаем.Что(Окно, СтрШаблон("пул %1 строкой в режиме «все»", Пул))
			.Содержит("name=""режим:пул_" + Ид_(Пул) + """ value=""все"" checked");
	КонецЦикла;
	Ожидаем.Что(Окно, "приватный пул помечен").Содержит("приватный");

	Ветка = Страница(Дверь("/hub/settings/webhooks", Ид) + "?ветка=" + Код("пул_" + Ид_("secret")) + "&страница=1",
		КукаRoot);
	Ожидаем.Что(Ветка, "страница ветки — кусок с её ключом").Содержит("data-checktree-page=""пул_" + Ид_("secret") + """");
	Ожидаем.Что(Новый ГалкиВРазметке().Есть(Ветка, КлючПакета("secret", "secret-pkg")), "пакет приватного пула галкой")
		.ЭтоИстина();

КонецПроцедуры

// Правки окна ложатся и гасят доставку: пул «никакие» не получает ни своих пакетов, пакет, снятый
// в «выбранных», — тоже, новый пакет пула «выбранные» не приходит, новый пакет пула «все» получает сам;
// ответ — 303 обратно в окно. Без скрипта запертая галка пула «никакие» в форму не уходит.
&Тест
Процедура ПравкиОкнаСохраняютсяИГасятДоставку() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	ПулСДвумяПакетами(КукаRoot, "tree-effect-all", "effect-one", "effect-two");
	Адрес = "https://hooks.example.com/tree-effect";
	Ид = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", Адрес);

	Ответ = ПравкиОкна(КукаRoot, "/hub/settings/webhooks", Ид, "правки=1&режим=" + Код("пул_" + Ид_("secret") + ":никакие")
		+ "&" + ПравкаВыбранныхБез("public", "alice-pkg"));
	Ожидаем.Что(Ответ.КодСостояния, "правки легли — 303").Равно(303);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "обратно в окно").Содержит(Код("получатели-" + Ид));
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, Ид, "secret"), "пул secret — «никакие»").Равно("пулы: secret; пакеты: ");
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, Ид, "public"), "alice-pkg снят").Равно("пулы: ; пакеты: public/alice-pkg");
	Ожидаем.Что(РежимВAPI(КукаRoot, Ид, "public"), "public — «выбранные»").Равно("выбранные");

	// без скрипта страница ветки пула «никакие» печатает сегменты и запертые галки: запертая в форму не
	// уходит — правок нет, домен цел (отказа «пул исключён целиком» больше нет)
	Ответ = Клиент.POSTФормыБезПереходов(Дверь("/hub/settings/webhooks", Ид), ТелоФормы(КукаRoot, "/hub/settings/webhooks",
		ФормаОкнаБезСкрипта(КукаRoot, "/hub/settings/webhooks", Ид, "галка:" + КлючПакета("secret", "secret-pkg"),
		"пул_" + Ид_("secret"))), Клиент.СтрокаКукиСессии(КукаRoot));
	Ожидаем.Что(Ответ.КодСостояния, "форма страницы ветки «никакие» без скрипта — 303").Равно(303);
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, Ид, "secret"), "домен цел").Равно("пулы: secret; пакеты: ");
	Ожидаем.Что(Страница("/hub/settings/webhooks", КукаRoot), "запись говорит, кому сообщает")
		.Содержит("; выбранные: ");
	Ожидаем.Что(СтрНайти(Страница("/hub/settings/webhooks", КукаRoot), "все, кроме"), "«все, кроме» в записи нет")
		.Равно(0);

	Токен = Клиент.ВыпуститьPAT(КукаRoot);
	Опубликовать("public", "alice-pkg", "9.0.0", Токен);
	Опубликовать("public", "tree-newcomer", "1.0.0", Токен);
	Опубликовать("tree-effect-all", "effect-new", "1.0.0", Токен);
	Опубликовать("secret", "tree-hidden", "1.0.0", Токен);

	Доставлено = ПакетыЗаданийДоставки(Адрес, "effect-new");
	Ожидаем.Что(Доставлено, "новый пакет пула «все» получает событие").Содержит("effect-new");
	Ожидаем.Что(Доставлено.Найти("tree-newcomer"), "новый пакет пула «выбранные» — нет").Равно(Неопределено);
	Ожидаем.Что(Доставлено.Найти("alice-pkg"), "снятый пакет — нет").Равно(Неопределено);
	Ожидаем.Что(Доставлено.Найти("tree-hidden"), "пакет пула «никакие» — нет").Равно(Неопределено);

КонецПроцедуры

// Сегмент «Выбранные» оставляет пулу то, что он получал, и новые пакеты в подписку больше не попадают:
// со скриптом (правка кита «режим=пул_N:выбранные», снятый пакет — снятие выбора) и без (радиокнопка
// формы на всём дереве).
&Тест
Процедура СегментВыбранныеНовыйПакетНеПолучает() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	ПулСДвумяПакетами(КукаRoot, "tree-picked", "picked-one", "picked-two");
	Адрес = "https://hooks.example.com/tree-picked";
	АдресБезСкрипта = "https://hooks.example.com/tree-picked-nojs";
	Ид = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", Адрес);
	БезСкрипта = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", АдресБезСкрипта);
	Пул = "пул_" + Ид_("tree-picked");

	Ответ = ПравкиОкна(КукаRoot, "/hub/settings/webhooks", Ид, ПравкаВыбранныхБез("tree-picked", "picked-two"));
	Ожидаем.Что(Ответ.КодСостояния, "правки легли").Равно(303);
	Ожидаем.Что(РежимВAPI(КукаRoot, Ид, "tree-picked"), "пул в режиме «выбранные»").Равно("выбранные");
	ПравкиОкнаБезСкрипта(КукаRoot, "/hub/settings/webhooks", БезСкрипта, "режим:" + Пул + "=выбранные");
	Ожидаем.Что(РежимВAPI(КукаRoot, БезСкрипта, "tree-picked"), "без скрипта радиокнопка — тоже «выбранные»")
		.Равно("выбранные");
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, БезСкрипта, "tree-picked"), "и выбрано всё, что пул получал")
		.Равно("пулы: ; пакеты: ");
	Окно = Страница(ОкноПолучателей("/hub/settings/webhooks", БезСкрипта), КукаRoot);
	Ожидаем.Что(Окно, "сегмент печатает настоящий режим")
		.Содержит("name=""режим:" + Пул + """ value=""выбранные"" checked");

	Токен = Клиент.ВыпуститьPAT(КукаRoot);
	Опубликовать("tree-picked", "picked-new", "1.0.0", Токен);
	Опубликовать("tree-picked", "picked-two", "2.0.0", Токен);
	Опубликовать("tree-picked", "picked-one", "2.0.0", Токен);
	Доставлено = ПакетыЗаданийДоставки(Адрес, "picked-one");
	Ожидаем.Что(Доставлено, "выбранный пакет получает").Содержит("picked-one");
	Ожидаем.Что(Доставлено.Найти("picked-new"), "новый пакет пула «выбранные» — нет").Равно(Неопределено);
	Ожидаем.Что(Доставлено.Найти("picked-two"), "невыбранный — нет").Равно(Неопределено);
	Доставлено = ПакетыЗаданийДоставки(АдресБезСкрипта, "picked-one");
	Ожидаем.Что(Доставлено, "без скрипта: выбранные оба получают").Содержит("picked-two");
	Ожидаем.Что(Доставлено.Найти("picked-new"), "без скрипта: новый — нет").Равно(Неопределено);

КонецПроцедуры

// Одно действие — одно сохранение, отправил ли форму скрипт правками или браузер формой окна, какой её
// напечатал сервер (поле показанного кита): со скриптом одной формой, без скрипта — сегментом и
// следующей формой страницы ветки. В «все» галки заперты; «все» → «выбранные» со снятыми — весь пул
// минус снятые; «выбранные» → «все» — весь пул; «никто» → «выбранные» с отмеченным — только он.
&Тест
Процедура СоСкриптомИБезСкриптаОдноСохранение() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	ПулСДвумяПакетами(КукаRoot, "tree-same", "same-one", "same-two");
	БезСкрипта = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/tree-nojs");
	СоСкриптом = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/tree-js");
	Пул = "пул_" + Ид_("tree-same");
	Один = "пакет_" + ИдПакета("tree-same", "same-one");
	Два = "пакет_" + ИдПакета("tree-same", "same-two");
	Раздел = "/hub/settings/webhooks";

	// пул «все»: на странице ветки галки заперты — форма без скрипта правок не несёт
	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "галка:" + Один + "&галка:" + Два, Пул);
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, БезСкрипта, "tree-same"), "в «все» запертые галки ничего не правят")
		.Равно("пулы: ; пакеты: ");

	// «все» → «выбранные» и сняты обе: без скрипта — сегмент, затем галки отпертой страницы ветки
	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "режим:" + Пул + "=выбранные");
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, БезСкрипта, "tree-same"), "сегмент «выбранные» из «все» — весь пул")
		.Равно("пулы: ; пакеты: ");
	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "галка:" + Один + "&галка:" + Два, Пул);
	ПравкиОкна(КукаRoot, Раздел, СоСкриптом, "правки=1&режим=" + Код(Пул + ":выбранные") + "&основа=" + Код(Пул + ":все")
		+ "&снять=" + Код(Один) + "&снять=" + Код(Два));
	Для Каждого Ид Из СтрРазделить(БезСкрипта + "," + СоСкриптом, ",") Цикл
		Ожидаем.Что(РежимВAPI(КукаRoot, Ид, "tree-same"), "пул «выбранные»").Равно("выбранные");
		Ожидаем.Что(ИсключённоеВПуле(КукаRoot, Ид, "tree-same"), "весь пул минус оба снятых")
			.Равно("пулы: ; пакеты: tree-same/same-one,tree-same/same-two");
	КонецЦикла;

	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "галка:" + Один, Пул);
	ПравкиОкна(КукаRoot, Раздел, СоСкриптом, "правки=1&включить=" + Код(Один));
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, БезСкрипта, "tree-same"), "отмеченный пакет выбран")
		.Равно("пулы: ; пакеты: tree-same/same-two");
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, СоСкриптом, "tree-same"), "со скриптом — то же")
		.Равно("пулы: ; пакеты: tree-same/same-two");

	// «выбранные» → «Все»: весь пул
	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "режим:" + Пул + "=все");
	ПравкиОкна(КукаRoot, Раздел, СоСкриптом, "правки=1&режим=" + Код(Пул + ":все"));
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, БезСкрипта, "tree-same"), "режим «все» — пул целиком").Равно("пулы: ; пакеты: ");
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, СоСкриптом, "tree-same"), "на обоих путях").Равно("пулы: ; пакеты: ");

	// «Никто» → «Выбранные» с отмеченным same-one: только он
	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "режим:" + Пул + "=никакие");
	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "режим:" + Пул + "=выбранные");
	ПравкиОкнаБезСкрипта(КукаRoot, Раздел, БезСкрипта, "галка:" + Один, Пул);
	ПравкиОкна(КукаRoot, Раздел, СоСкриптом, "правки=1&режим=" + Код(Пул + ":выбранные") + "&основа="
		+ Код(Пул + ":никакие") + "&включить=" + Код(Один));
	Для Каждого Ид Из СтрРазделить(БезСкрипта + "," + СоСкриптом, ",") Цикл
		Ожидаем.Что(РежимВAPI(КукаRoot, Ид, "tree-same"), "из «никто» — «выбранные»").Равно("выбранные");
		Ожидаем.Что(ИсключённоеВПуле(КукаRoot, Ид, "tree-same"), "выбран только same-one")
			.Равно("пулы: ; пакеты: tree-same/same-two");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ВладелецПулаПравитОкноСвоейПодпискиБезПодпискиХаба() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks",
		"https://hooks.example.com/tree-above", Истина);

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Своя = ПодпискаВAPI(КукаOwner, "/api/v1/pools/secret/webhooks", Раздел, "https://hooks.example.com/tree-pool");

	Окно = Страница(ОкноПолучателей(Раздел, Своя), КукаOwner);
	Ожидаем.Что(Новый ГалкиВРазметке().Есть(Окно, КлючПакета("secret", "secret-pkg")), "пакет своего пула в окне")
		.ЭтоИстина();
	Ожидаем.Что(Окно, "сегменты режима своего пула").Содержит("name=""режим:пул_" + Ид_("secret") + """");
	Ожидаем.Что(СтрНайти(Окно, "name=""режим:пул_" + Ид_("public") + """"), "чужих пулов нет").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, "value=""никакие"""), "«никакие» подписке пула не печатается").Равно(0);

	Ответ = ПравкиОкна(КукаOwner, Раздел, Своя, ПравкаВыбранныхБез("secret", "secret-pkg") + "&найти=secret");
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "после сохранения поиск остаётся").Содержит("=secret");
	Ожидаем.Что(РежимПодпискиПула(КукаOwner, Своя), "подписка пула — «выбранные»").Равно("выбранные");
	Окно = Страница(ОкноПолучателей(Раздел, Своя), КукаOwner);
	Ожидаем.Что(Окно, "сегмент печатает настоящий режим").Содержит("value=""выбранные"" checked");
	Ожидаем.Что(Новый ГалкиВРазметке().Тег(Окно, КлючПакета("secret", "secret-pkg")), "снятый пакет не выбран")
		.Не_().Содержит(" checked");

	// сегмент «Все» без скрипта — весь пул, галки отмечены и заперты; «Выбранные» из «все» — все отмечены
	// и отперты, снятая следующей формой галка снимает выбор
	ПравкиОкнаБезСкрипта(КукаOwner, Раздел, Своя, "режим:пул_" + Ид_("secret") + "=все");
	Ожидаем.Что(РежимПодпискиПула(КукаOwner, Своя), "сегмент «все» — режим «все»").Равно("все");
	Окно = Страница(ОкноПолучателей(Раздел, Своя), КукаOwner);
	Ожидаем.Что(Новый ГалкиВРазметке().Тег(Окно, КлючПакета("secret", "secret-pkg")), "пакет отмечен и заперт")
		.Содержит("data-checktree-locked");
	ПравкиОкнаБезСкрипта(КукаOwner, Раздел, Своя, "режим:пул_" + Ид_("secret") + "=выбранные");
	Окно = Страница(ОкноПолучателей(Раздел, Своя), КукаOwner);
	Ожидаем.Что(Новый ГалкиВРазметке().Тег(Окно, КлючПакета("secret", "secret-pkg")), "из «все» — выбран")
		.Содержит(" checked");
	ПравкиОкнаБезСкрипта(КукаOwner, Раздел, Своя, "галка:" + КлючПакета("secret", "secret-pkg"));
	Окно = Страница(ОкноПолучателей(Раздел, Своя), КукаOwner);
	Ожидаем.Что(Новый ГалкиВРазметке().Тег(Окно, КлючПакета("secret", "secret-pkg")), "снятая галка снимает выбор")
		.Не_().Содержит(" checked");
	Ожидаем.Что(СтрНайти(Окно, "value=""кроме"""), "сегмента «все, кроме» нет").Равно(0);

	// под адресом пула окна получателей подписки хаба нет: она здесь сверху
	Ожидаем.Что(СтрНайти(Страница(ОкноПолучателей(Раздел, Хаба), КукаOwner), "data-checktree-modes"),
		"окна получателей подписки хаба нет").Равно(0);
	Ожидаем.Что(Клиент.POSTФормыБезПереходов(Дверь(Раздел, Хаба), ТелоФормы(КукаOwner, Раздел,
		"правки=1&режим=" + Код("пул_" + Ид_("public") + ":никакие")), Клиент.СтрокаКукиСессии(КукаOwner)).КодСостояния,
		"правки подписки хаба из раздела пула — как несуществующей").Равно(404);

КонецПроцедуры

// Узел, которому дерево подписки хаба не достаётся, её не видит: исключённый и невыбранный пакет —
// ни в своём разделе, ни на адресе поправки; пул «никакие» — ни сам, ни своими пакетами.
&Тест
Процедура ИсключённыйХабомУзелНеВидитЕгоПодпискуСверху() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks",
		"https://hooks.example.com/tree-masked", Истина);
	Опубликовать("secret", "tree-sibling", "1.0.0", Клиент.ВыпуститьPAT(КукаRoot));

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	РазделПула = "/pools/secret/settings/webhooks";
	РазделПакета = "/pools/secret/packages/secret-pkg/settings/webhooks";
	РазделСоседа = "/pools/secret/packages/tree-sibling/settings/webhooks";
	Поправка = "/inherited/" + Хаба + "/narrow";
	Для Каждого Раздел Из СтрРазделить(РазделПула + "," + РазделПакета + "," + РазделСоседа, ",") Цикл
		Ожидаем.Что(СтрНайти(Страница(Раздел, КукаOwner), Раздел + Поправка) > 0,
			"КОНТРОЛЬ: до исключения подписка хаба видна в " + Раздел).ЭтоИстина();
	КонецЦикла;

	ПравкиОкна(КукаRoot, "/hub/settings/webhooks", Хаба, ПравкаВыбранныхБез("secret", "secret-pkg"));
	Ожидаем.Что(СтрНайти(Страница(РазделПакета, КукаOwner), Поправка), "снятый пакет её не видит").Равно(0);
	Ожидаем.Что(СтрНайти(Страница(РазделСоседа, КукаOwner), РазделСоседа + Поправка) > 0,
		"соседний пакет того же пула видит").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница(РазделПула, КукаOwner), РазделПула + Поправка) > 0, "и сам пул").ЭтоИстина();
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница(РазделПакета, КукаOwner)));
	Поля.Вставить("не_присылать", "1");
	Ожидаем.Что(Клиент.POSTФормы(РазделПакета + Поправка, Поля, КукаOwner).КодСостояния,
		"поправка исключённого пакета — как к несуществующей подписке").Равно(404);

	// пул «выбранные» и без соседа: сосед не выбран и подписку не видит, пул видит
	ПравкиОкна(КукаRoot, "/hub/settings/webhooks", Хаба, "правки=1&снять=" + Код(КлючПакета("secret", "tree-sibling")));
	Ожидаем.Что(СтрНайти(Страница(РазделСоседа, КукаOwner), Поправка), "невыбранный пакет её не видит").Равно(0);
	Ожидаем.Что(СтрНайти(Страница(РазделПула, КукаOwner), РазделПула + Поправка) > 0, "пул «выбранные» видит")
		.ЭтоИстина();

	ПравкиОкна(КукаRoot, "/hub/settings/webhooks", Хаба, "правки=1&режим=" + Код("пул_" + Ид_("secret") + ":никакие"));
	Для Каждого Раздел Из СтрРазделить(РазделПула + "," + РазделСоседа, ",") Цикл
		Ожидаем.Что(СтрНайти(Страница(Раздел, КукаOwner), Поправка),
			"пул «никакие» не видит подписку ни сам, ни пакетами: " + Раздел).Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ГалкаПакетаЧужогоПулаНеОтличимаОтНесуществующего() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/pools", "{""имя"":""tree-foreign-private"",""видимость"":""private""}",
		Клиент.ЗаголовкиМутации(КукаRoot, Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot)))));
	Ожидаем.Что(Ответ.КодСостояния, "чужой приватный пул заведён: " + Клиент.Тело(Ответ)).Равно(201);
	Опубликовать("tree-foreign-private", "tree-foreign-pkg", "1.0.0", Клиент.ВыпуститьPAT(КукаRoot));
	Чужой = ИдПакета("tree-foreign-private", "tree-foreign-pkg");

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Своя = ПодпискаВAPI(КукаOwner, "/api/v1/pools/secret/webhooks", Раздел, "https://hooks.example.com/tree-probe");
	Свой = КлючПакета("secret", "secret-pkg");

	Исходы = Новый Массив();
	Для Каждого Номер Из СтрРазделить(Чужой + ",99999999", ",") Цикл
		Ответ = ПравкиОкна(КукаOwner, Раздел, Своя, ПравкаВыбранныхБез("secret", "secret-pkg") + "&снять="
			+ Код("пакет_" + Номер));
		Исходы.Добавить(Формат(Ответ.КодСостояния, "ЧГ=0") + " " + Клиент.ЗаголовокОтвета(Ответ, "Location"));
		Ожидаем.Что(СтрНайти(Страница(ОкноПолучателей(Раздел, Своя), КукаOwner), "tree-foreign-pkg"),
			"имени чужого пакета в окне нет").Равно(0);
	КонецЦикла;

	Ожидаем.Что(Исходы[0], "правки легли, хаб уводит в окно").Содержит("303");
	Ожидаем.Что(Исходы[1], "пакет чужого приватного пула неотличим от несуществующего").Равно(Исходы[0]);
	Ожидаем.Что(РежимПодпискиПула(КукаOwner, Своя), "свой пакет снят: пул «выбранные»").Равно("выбранные");
	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", "/api/v1/pools/secret/webhooks/" + Своя + "/recipients", "",
		Клиент.Кука(КукаOwner)));
	Ожидаем.Что(СтрСоединить(Дерево.Получить("excluded_packages"), ","), "снят только свой, чужой не записан")
		.Равно("secret-pkg");

КонецПроцедуры

// Владелец пула снимает свой пакет в окне «Пакеты пула» поправки к подписке хаба: пакет перестаёт
// получать её события и не видит её в «Подписках сверху»; пакет, снятый хозяином подписки, напечатан
// закрытой галкой и подделкой формы не возвращается.
&Тест
Процедура ВладелецПулаСнимаетПакетВОкнеПакетовПула() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Адрес = "https://hooks.example.com/tree-amend";
	Хаба = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", Адрес, Истина);
	Токен = Клиент.ВыпуститьPAT(КукаRoot);
	Опубликовать("secret", "amend-open", "1.0.0", Токен);
	Опубликовать("secret", "amend-closed", "1.0.0", Токен);
	ЗаменитьИсключения(КукаRoot, Хаба, "{""excluded_packages"":[""secret/amend-closed""]}");

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/pools/secret/settings/webhooks";
	Ожидаем.Что(Страница(Раздел, КукаOwner), "в меню записи сверху — окно «Пакеты пула»")
		.Содержит(Код("окно") + "=" + Код("пакеты-" + Хаба));

	Окно = Страница(Раздел + "?" + Код("окно") + "=" + Код("пакеты-" + Хаба), КукаOwner);
	Закрытый = КлючПакета("secret", "amend-closed");
	Свой = КлючПакета("secret", "secret-pkg");
	Ожидаем.Что(Новый ГалкиВРазметке().Тег(Окно, Закрытый), "снятый хозяином подписки — закрытая галка")
		.Содержит(" disabled");
	Ожидаем.Что(Окно, "с пометкой").Содержит("снят хозяином подписки");
	Ожидаем.Что(Окно, "итог — без скольких пакетов и кто их снял").Содержит("кроме снятых хозяином подписки: 1 пакет.");
	Ожидаем.Что(Новый ГалкиВРазметке().Тег(Окно, Свой), "свой пакет включён").Содержит(" checked");

	ПоправкаДверь = Раздел + "/inherited/" + Хаба + "/recipients";
	Ответ = Клиент.POSTФормыБезПереходов(ПоправкаДверь, ТелоФормы(КукаOwner, Раздел, "правки=1&снять=" + Код(Свой)),
		Клиент.СтрокаКукиСессии(КукаOwner));
	Ожидаем.Что(Ответ.КодСостояния, "галка легла — 303").Равно(303);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Location"), "обратно в окно").Содержит(Код("пакеты-" + Хаба));
	Ожидаем.Что(ИсключённыеПулом(КукаOwner, Хаба), "пакет снят пулом").Равно("amend-closed:сверху,secret-pkg");

	Ожидаем.Что(СтрНайти(Страница("/pools/secret/packages/secret-pkg/settings/webhooks", КукаOwner),
		"/inherited/" + Хаба + "/narrow"), "снятый пакет подписку хаба не видит").Равно(0);
	Опубликовать("secret", "secret-pkg", "7.0.0", Токен);
	Опубликовать("secret", "amend-open", "2.0.0", Токен);
	Доставлено = ПакетыЗаданийДоставки(Адрес, "amend-open");
	Ожидаем.Что(Доставлено, "соседний пакет получает событие").Содержит("amend-open");
	Ожидаем.Что(Доставлено.Найти("secret-pkg"), "снятый пулом — нет").Равно(Неопределено);

	// подделка: закрытый включён правкой, свой возвращён
	Ответ = Клиент.POSTФормыБезПереходов(ПоправкаДверь, ТелоФормы(КукаOwner, Раздел, "правки=1&включить=" + Код(Закрытый)
		+ "&включить=" + Код(Свой)), Клиент.СтрокаКукиСессии(КукаOwner));
	Ожидаем.Что(Ответ.КодСостояния, "форма принята").Равно(303);
	Ожидаем.Что(ИсключённыеПулом(КукаOwner, Хаба), "закрытый так и снят, свой вернулся").Равно("amend-closed:сверху");

КонецПроцедуры

// Окно «Пакеты пула» — только у пула и только тому, кто распоряжается его подписками.
&Тест
Процедура ОкноПакетовПулаЧужомуНеОткрывается() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/tree-amend-deny",
		Истина);
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Правка = ПравкаВыбранныхБез("public", "alice-pkg");

	Ожидаем.Что(Клиент.GETСКукой("/pools/secret/settings/webhooks/inherited/" + Хаба + "/recipients",
		Клиент.Войти("bob", "BobPassw0rd")).КодСостояния, "посторонний чужой приватный пул не находит").Равно(404);
	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	Ответ = Клиент.POSTФормыБезПереходов("/pools/public/settings/webhooks/inherited/" + Хаба + "/recipients",
		ТелоФормы(КукаPub, "/pools/public", Правка), Клиент.СтрокаКукиСессии(КукаPub));
	Ожидаем.Что(Ответ.КодСостояния, "издатель пула со своим токеном — отказ по праву").Равно(403);
	Ожидаем.Что(Клиент.Тело(Ответ), "отказ называет право, а не токен")
		.Содержит("Недостаточно прав для управления подписками этого пула");
	Своя = ПодпискаВAPI(КукаOwner, "/api/v1/pools/secret/webhooks", "/pools/secret/settings/webhooks",
		"https://hooks.example.com/tree-amend-own");
	Ожидаем.Что(Клиент.POSTФормыБезПереходов("/pools/secret/settings/webhooks/inherited/" + Своя + "/recipients",
		ТелоФормы(КукаOwner, "/pools/secret/settings/webhooks", Правка), Клиент.СтрокаКукиСессии(КукаOwner)).КодСостояния,
		"своя подписка пула — не подписка сверху").Равно(404);
	КодОтвета = Клиент.POSTФормыБезПереходов("/pools/secret/packages/secret-pkg/settings/webhooks/inherited/" + Хаба
		+ "/recipients", ТелоФормы(КукаOwner, "/pools/secret/settings/webhooks", Правка),
		Клиент.СтрокаКукиСессии(КукаOwner)).КодСостояния;
	Ожидаем.Что(КодОтвета >= 400 И КодОтвета < 500, "у пакета окна поправки нет — отказ, а не сохранение: " + КодОтвета)
		.ЭтоИстина();

КонецПроцедуры

// Дверь окна «Получатели» (GET страницы ветки и найденного, POST правок) — тому, кто распоряжается
// подписками объекта: посторонний на хабе — 403 на обоих методах, посторонний к приватному пулу —
// 404 (пул ему не виден), издатель публичного пула — 403 по праву.
&Тест
Процедура ДверьОкнаПолучателейПостороннемуЗакрыта() Экспорт

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Хаба = ПодпискаВAPI(КукаRoot, "/api/v1/webhooks", "/hub/settings/webhooks", "https://hooks.example.com/tree-door");
	Публичная = ПодпискаВAPI(КукаRoot, "/api/v1/pools/public/webhooks", "/pools/public/settings/webhooks",
		"https://hooks.example.com/tree-door-public");
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Приватная = ПодпискаВAPI(КукаOwner, "/api/v1/pools/secret/webhooks", "/pools/secret/settings/webhooks",
		"https://hooks.example.com/tree-door-secret");
	Правка = ПравкаВыбранныхБез("public", "alice-pkg");

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	ДверьХаба = Дверь("/hub/settings/webhooks", Хаба);
	Ожидаем.Что(Клиент.GETСКукой(ДверьХаба + "?" + Код("найти") + "=alice", КукаBob).КодСостояния,
		"посторонний: GET двери подписки хаба").Равно(403);
	Ожидаем.Что(Клиент.POSTФормыБезПереходов(ДверьХаба, ТелоФормы(КукаBob, "/pools/public", Правка),
		Клиент.СтрокаКукиСессии(КукаBob)).КодСостояния, "посторонний: POST двери подписки хаба").Равно(403);

	ДверьСекрета = Дверь("/pools/secret/settings/webhooks", Приватная);
	Ожидаем.Что(Клиент.GETСКукой(ДверьСекрета, КукаBob).КодСостояния,
		"посторонний: дверь подписки приватного пула — как несуществующей").Равно(404);
	Ожидаем.Что(Клиент.POSTФормыБезПереходов(ДверьСекрета, ТелоФормы(КукаBob, "/pools/public", Правка),
		Клиент.СтрокаКукиСессии(КукаBob)).КодСостояния, "и POST — тоже 404").Равно(404);

	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	ДверьПубличного = Дверь("/pools/public/settings/webhooks", Публичная);
	Ожидаем.Что(Клиент.GETСКукой(ДверьПубличного, КукаPub).КодСостояния,
		"издатель публичного пула: GET — отказ по праву").Равно(403);
	Ответ = Клиент.POSTФормыБезПереходов(ДверьПубличного, ТелоФормы(КукаPub, "/pools/public", Правка),
		Клиент.СтрокаКукиСессии(КукаPub));
	Ожидаем.Что(Ответ.КодСостояния, "и POST — отказ по праву").Равно(403);
	Ожидаем.Что(ИсключённоеВПуле(КукаRoot, Хаба, "public"), "КОНТРОЛЬ: подписка хаба не тронута")
		.Равно("пулы: ; пакеты: ");

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Адрес раздела с окном «Получатели» подписки.
Функция ОкноПолучателей(Знач Раздел, Знач Ид)
	Возврат Раздел + "?" + Код("окно") + "=" + Код("получатели-" + Ид);
КонецФункции

// Дверь окна «Получатели» подписки в разделе.
Функция Дверь(Знач Раздел, Знач Ид)
	Возврат Раздел + "/" + Ид + "/recipients";
КонецФункции

// Тело формы окна: токен CSRF страницы раздела и поля формы строкой.
Функция ТелоФормы(Знач Кука, Знач Раздел, Знач Поля)
	Возврат "_csrf=" + Код(Клиент.ТокенCSRF(Страница(Раздел, Кука))) + "&" + Поля;
КонецФункции

// Отправляет форму окна «Получатели» подписки — правками кита или галками без скрипта.
Функция ПравкиОкна(Знач Кука, Знач Раздел, Знач Ид, Знач Поля)
	Ответ = Клиент.POSTФормыБезПереходов(Дверь(Раздел, Ид), ТелоФормы(Кука, Раздел, Поля), Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "форма окна принята: " + Поля).Равно(303);
	Возврат Ответ;
КонецФункции

// Отправляет форму окна «Получатели» так, как её отправит браузер без скрипта, — ответ 303.
Функция ПравкиОкнаБезСкрипта(Знач Кука, Знач Раздел, Знач Ид, Знач Действия, Знач Ветка = "")
	Возврат ПравкиОкна(Кука, Раздел, Ид, ФормаОкнаБезСкрипта(Кука, Раздел, Ид, Действия, Ветка));
КонецФункции

// Тело формы окна «Получатели», какое отправит браузер без скрипта: со страницы окна (Ветка — ключ
// пула: страница его ветки), сделав названное (ГалкиВРазметке.ФормаБезСкрипта).
Функция ФормаОкнаБезСкрипта(Знач Кука, Знач Раздел, Знач Ид, Знач Действия, Знач Ветка = "")

	Если ЗначениеЗаполнено(Ветка) Тогда
		Адрес = Дверь(Раздел, Ид) + "?" + Код("ветка") + "=" + Код(Ветка) + "&" + Код("страница") + "=1";
	Иначе
		Адрес = ОкноПолучателей(Раздел, Ид);
	КонецЕсли;
	HTML = Страница(Адрес, Кука);
	Якорь = СтрНайти(HTML, "id=""podpiska-poluchateli""");
	Ожидаем.Что(Якорь > 0, "окно «Получатели» на " + Адрес).ЭтоИстина();
	Окно = Сред(HTML, СтрНайти(Лев(HTML, Якорь), "<dialog", НаправлениеПоиска.СКонца));
	Окно = Лев(Окно, СтрНайти(Окно, "</dialog>"));
	Возврат Новый ГалкиВРазметке().ФормаБезСкрипта(Окно, Действия);

КонецФункции

// Режим пула в дереве подписки хаба из API.
Функция РежимВAPI(Знач КукаRoot, Знач Хаба, Знач ИмяПула)
	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", "/api/v1/webhooks/" + Хаба + "/recipients", "",
		Клиент.Кука(КукаRoot)));
	Для Каждого Пул Из Дерево.Получить("pools") Цикл
		Если Пул.Получить("name") = ИмяПула Тогда
			Возврат Пул.Получить("mode");
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Ключ галки пакета засева: «пакет_<идентификатор>».
Функция КлючПакета(Знач ИмяПула, Знач ИмяПакета)
	Возврат "пакет_" + ИдПакета(ИмяПула, ИмяПакета);
КонецФункции

Функция Код(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Пакеты пула secret, снятые в его поправке к подписке хаба, из API: «имя», снятый хозяином — «имя:сверху».
Функция ИсключённыеПулом(Знач Кука, Знач Хаба)

	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", "/api/v1/pools/secret/inherited-webhooks/" + Хаба + "/recipients",
		"", Клиент.Кука(Кука)));
	Снятые = Новый Массив();
	Для Каждого Пакет Из Дерево.Получить("packages") Цикл
		Если Пакет.Получить("excluded") Тогда
			Снятые.Добавить(Пакет.Получить("name") + ?(Пакет.Получить("excluded_above"), ":сверху", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Снятые, ",");

КонецФункции

// Подписка объекта через API с CSRF страницы раздела; идентификатор — из ответа на создание.
Функция ПодпискаВAPI(Знач Кука, Знач Путь, Знач Раздел, Знач Адрес, Знач Сужаемая = Ложь)

	Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, Кука)));
	Тело = СтрШаблон("{""kind"":""вебхук"",""URL"":""%1"",""events"":[""версия.опубликована""]%2}",
		Адрес, ?(Сужаемая, ",""narrowing_allowed"":true", ""));
	Ответ = Клиент.ЗапросJSON("POST", Путь, Тело, Клиент.ЗаголовкиМутации(Кука, Токен));
	Ожидаем.Что(Ответ.КодСостояния, "подписка заведена: " + Клиент.Тело(Ответ)).Равно(201);
	Возврат Формат(Клиент.ТелоJSON(Ответ).Получить("subscription").Получить("id"), "ЧГ=0");

КонецФункции

Функция Страница(Знач Путь, Знач Кука)
	Ответ = Клиент.GETСКукой(Путь, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "страница " + Путь).Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

// Правка окна со скриптом: пул «выбранные» от всего пула (массовая отметка «все») без одного пакета —
// так, как её шлёт скрипт кита.
Функция ПравкаВыбранныхБез(Знач ИмяПула, Знач ИмяПакета)
	Пул = "пул_" + Ид_(ИмяПула);
	Возврат "правки=1&режим=" + Код(Пул + ":выбранные") + "&основа=" + Код(Пул + ":все") + "&снять="
		+ Код(КлючПакета(ИмяПула, ИмяПакета));
КонецФункции

// Режим своего пула у подписки пула secret — из API.
Функция РежимПодпискиПула(Знач Кука, Знач Ид)
	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", "/api/v1/pools/secret/webhooks/" + Ид + "/recipients", "",
		Клиент.Кука(Кука)));
	Возврат Дерево.Получить("mode");
КонецФункции

// Публичный пул с двумя пакетами, заведённый root через API.
Процедура ПулСДвумяПакетами(Знач КукаRoot, Знач ИмяПула, Знач Первый, Знач Второй)
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/pools", СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", ИмяПула),
		Клиент.ЗаголовкиМутации(КукаRoot, Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot)))));
	Ожидаем.Что(Ответ.КодСостояния, "пул " + ИмяПула + " заведён: " + Клиент.Тело(Ответ)).Равно(201);
	Токен = Клиент.ВыпуститьPAT(КукаRoot);
	Опубликовать(ИмяПула, Первый, "1.0.0", Токен);
	Опубликовать(ИмяПула, Второй, "1.0.0", Токен);
КонецПроцедуры

// Заменяет исключения подписки хаба через API.
Процедура ЗаменитьИсключения(Знач КукаRoot, Знач Хаба, Знач ТелоJSON)
	Ответ = Клиент.ЗапросJSON("PUT", "/api/v1/webhooks/" + Хаба + "/recipients", ТелоJSON,
		Клиент.ЗаголовкиМутации(КукаRoot, Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/hub/settings/webhooks", КукаRoot)))));
	Ожидаем.Что(Ответ.КодСостояния, "исключения приняты: " + Клиент.Тело(Ответ)).Равно(200);
КонецПроцедуры

// Исключения подписки по пулу из API: «пулы: …; пакеты: …».
Функция ИсключённоеВПуле(Знач КукаRoot, Знач Хаба, Знач ИмяПула)

	Дерево = Клиент.ТелоJSON(Клиент.ЗапросJSON("GET", "/api/v1/webhooks/" + Хаба + "/recipients", "",
		Клиент.Кука(КукаRoot)));
	Пулы = Новый Массив();
	Для Каждого Имя Из Дерево.Получить("excluded_pools") Цикл
		Если Имя = ИмяПула Тогда
			Пулы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Пакеты = Новый Массив();
	Для Каждого Имя Из Дерево.Получить("excluded_packages") Цикл
		Если СтрНачинаетсяС(Имя, ИмяПула + "/") Тогда
			Пакеты.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "пулы: " + СтрСоединить(Пулы, ",") + "; пакеты: " + СтрСоединить(Пакеты, ",");

КонецФункции

// Идентификатор пула засева — из ответа API пулов.
Функция Ид_(Знач ИмяПула)

	Ответ = Клиент.ЗапросJSON("GET", "/api/v1/pools/" + ИмяПула, "", Клиент.Кука(Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(Ответ.КодСостояния, "пул " + ИмяПула + " читается").Равно(200);
	Пул = Клиент.ТелоJSON(Ответ);
	Пул = ?(Пул.Получить("pool") = Неопределено, Пул, Пул.Получить("pool"));
	Возврат Формат(Пул.Получить("id"), "ЧГ=0");

КонецФункции

// Идентификатор пакета строкой — из API пакета, глазами root.
Функция ИдПакета(Знач ИмяПула, Знач ИмяПакета)

	Ответ = Клиент.ЗапросJSON("GET", СтрШаблон("/api/v1/pools/%1/packages/%2", ИмяПула, ИмяПакета), "",
		Клиент.Кука(Клиент.Войти("root", "RootPassw0rd")));
	Ожидаем.Что(Ответ.КодСостояния, "пакет " + ИмяПакета + " читается").Равно(200);
	Пакет = Клиент.ТелоJSON(Ответ);
	Пакет = ?(Пакет.Получить("package") = Неопределено, Пакет, Пакет.Получить("package"));
	Возврат Формат(Пакет.Получить("id"), "ЧГ=0");

КонецФункции

Процедура Опубликовать(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Токен)

	Ответ = Клиент.ОтправитьАртефакт(СтрШаблон("/api/v1/pools/%1/push", ИмяПула),
		Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия),
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), Токен);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("%1 %2 опубликован: %3", ИмяПакета, Версия, Клиент.Тело(Ответ)))
		.Равно(201);

КонецПроцедуры

// Пакеты из тел заданий доставки на адрес подписки — разбором таблицы файловой базы. Таблицу
// дописывает подписчик после ответа на публикацию: ждём, пока в ней появится названный пакет.
Функция ПакетыЗаданийДоставки(Знач Адрес, Знач ЖдатьПакет)

	Для Заход = 1 По 40 Цикл
		Пакеты = Новый Массив();
		Для Каждого Строка_ Из СтрокиЗаданийДоставки() Цикл
			Поля = РазобратьJSON(Строка_.Получить("Тело"));
			Если ТипЗнч(Поля) = Тип("Соответствие") И СтрНайти(Строка_.Получить("НастройкиJSON"), Адрес) > 0 Тогда
				Пакеты.Добавить(Поля.Получить("пакет"));
			КонецЕсли;
		КонецЦикла;
		Если Пакеты.Найти(ЖдатьПакет) <> Неопределено Тогда
			Возврат Пакеты;
		КонецЕсли;
		Приостановить(250);
	КонецЦикла;
	Возврат Пакеты;

КонецФункции

Функция СтрокиЗаданийДоставки()

	Результат = Новый Массив();
	Найденные = НайтиФайлы(Хаб.КаталогБазы(), "*ЗаданияДоставки*", Истина);
	Если Найденные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Найденные[0].ПолноеИмя, КодировкаТекста.UTF8);
	Таблица = РазобратьJSON(Чтение.Прочитать());
	Чтение.Закрыть();
	Если ТипЗнч(Таблица) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Таблица Цикл
			Если ТипЗнч(Элемент.Значение) = Тип("Соответствие") Тогда
				Результат.Добавить(Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Недочитанный файл (его пишет хаб) — не JSON: такой заход просто повторяется.
Функция РазобратьJSON(Знач Текст)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
