// Блоки кода в README на странице пакета: блок с языком раскрашивает тег подсветки oscript-md,
// он стоит на странице один раз и только когда такие блоки есть; код чужого README остаётся текстом.

#Использовать asserts
#Использовать oscript-md
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КлючАдмина;      // Строка — ключ доступа администратора хаба
Перем КореньДанных;    // Строка — временный каталог стенда: в нём собираются .ospx

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);

	КореньДанных = Хаб.ФайловаяБаза("openhub-подсветка");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", ЛогинАдмина());
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	Сессия = Клиент.Кука(Клиент.Войти(ЛогинАдмина(), ПарольАдмина()));
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""права"":""read,write""}", Сессия);
	Ожидаем.Что(Ответ.КодСостояния, "ключ администратора выпущен: " + Клиент.Тело(Ответ)).Равно(201);
	КлючАдмина = Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""name"":""%1"",""visibility"":""public""}", Пул()), КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);

	ОпубликоватьСREADME(ПакетСКодом(), "1.0.0", READMEСКодом());
	ОпубликоватьСREADME(ПакетБезКода(), "1.0.0", READMEБезКода());

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область БлокиКода

// Блоки ```bsl и ```json доходят до страницы блоками своего языка, а раскрашивает их
// тег подсветки библиотеки — один на страницу, сколько бы блоков ни было.
&Тест
Процедура БлокиКодаСЯзыкомРаскрашиваетОдинТегПодсветки() Экспорт

	Страница = СтраницаПакета(ПакетСКодом());

	Ожидаем.Что(Страница, "блок bsl — блоком своего языка").Содержит("<code class=""language-bsl"">");
	Ожидаем.Что(Страница, "блок json — блоком своего языка").Содержит("<code class=""language-json"">");
	Ожидаем.Что(СтрЧислоВхождений(Страница, ТегПодсветки()), "тег подсветки стоит на странице ровно один раз")
		.Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(НРег(Страница), "esm.sh"), "и движок подсветки подключён один раз")
		.Равно(1);

КонецПроцедуры

// Страница версии показывает тот же README — и подсвечивает его так же.
&Тест
Процедура СтраницаВерсииПодсвечиваетКодТакЖе() Экспорт

	Страница = Тело(Клиент.GET(СтрШаблон("/pools/%1/packages/%2?version=1.0.0", Пул(), ПакетСКодом())));

	Ожидаем.Что(Страница, "КОНТРОЛЬ: это README пакета").Содержит("<code class=""language-bsl"">");
	Ожидаем.Что(СтрЧислоВхождений(Страница, ТегПодсветки()), "тег подсветки на странице версии").Равно(1);

КонецПроцедуры

// Разметка внутри блока кода — текст: скрипт из README не становится тегом, а подсветка
// получает его тем же текстом, что видит читатель.
&Тест
Процедура СкриптВБлокеКодаОстаётсяТекстом() Экспорт

	Страница = СтраницаПакета(ПакетСКодом());

	Ожидаем.Что(Страница, "скрипт из блока кода доехал экранированным")
		.Содержит("&lt;script&gt;alert(&quot;xss-в-коде&quot;)&lt;/script&gt;");
	Ожидаем.Что(СтрНайти(НРег(Страница), "<script>alert"), "и тегом не стал").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "xss-в-коде")
		< СтрНайти(Страница, ТегПодсветки()), "КОНТРОЛЬ: блок стоит до тега подсветки").ЭтоИстина();

КонецПроцедуры

// README без блоков с языком — заголовки, код в строке и блок без языка — подсветку не грузит:
// блок без языка остаётся простым кодом.
&Тест
Процедура БезБлоковСЯзыкомПодсветкиНет() Экспорт

	Страница = СтраницаПакета(ПакетБезКода());

	Ожидаем.Что(Страница, "КОНТРОЛЬ: блок без языка на странице — простым кодом").Содержит("<pre><code>");
	Ожидаем.Что(Страница, "КОНТРОЛЬ: и код в строке").Содержит("<code>инлайн</code>");
	Ожидаем.Что(СтрНайти(Страница, ТегПодсветки()), "тега подсветки нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Страница), "esm.sh"), "движок подсветки не подключён").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Страница), "type=""module"""), "скрипта-модуля на странице нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Темы

// Цвета подсветки выбирает браузер по color-scheme страницы: тег не фиксирует тему, а каждая
// тема хаба объявляет свою схему — тёмная по умолчанию, светлая по куке оформления.
&Тест
Процедура ПодсветкаИдётЗаТемойСтраницы() Экспорт

	Тёмная = СтраницаПакета(ПакетСКодом());
	Ожидаем.Что(Тёмная, "КОНТРОЛЬ: без куки — тёмная тема").Содержит(ТегHTML("dark"));
	Ожидаем.Что(ОбъявляетСхему(Тёмная, "dark"), "тёмная тема объявляет браузеру тёмную схему").ЭтоИстина();

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_ui=" + КодироватьСтроку("тема=светлая", СпособКодированияСтроки.КодировкаURL));
	Светлая = Тело(Клиент.GET(АдресПакета(ПакетСКодом()), Заголовки));
	Ожидаем.Что(Светлая, "КОНТРОЛЬ: кука включила светлую тему").Содержит(ТегHTML("light"));
	Ожидаем.Что(ОбъявляетСхему(Светлая, "light"), "светлая тема объявляет браузеру светлую схему").ЭтоИстина();

	Ожидаем.Что(СтрЧислоВхождений(Тёмная, ТегПодсветки()), "тег без зафиксированной темы — в тёмной").Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(Светлая, ТегПодсветки()), "и тот же — в светлой").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ВнешниеАдреса

// Браузер, открывая страницу пакета, ходит наружу только за движком подсветки, и только
// когда в README есть код с языком; страница без кода наружу не ходит вовсе.
&Тест
Процедура НаружуСтраницаХодитТолькоЗаПодсветкой() Экспорт

	СКодом = ВнешниеРесурсы(СтраницаПакета(ПакетСКодом()));
	Ожидаем.Что(СКодом.Количество(), "один внешний ресурс: " + СтрСоединить(СКодом, ", ")).Равно(1);
	ДвижокПодсветки = Новый РегулярноеВыражение("^https://esm\.sh/shiki@\d+\.\d+\.\d+$");
	Ожидаем.Что(ДвижокПодсветки.Совпадает(СКодом[0]), "и это движок подсветки точной версии: " + СКодом[0])
		.ЭтоИстина();

	БезКода = ВнешниеРесурсы(СтраницаПакета(ПакетБезКода()));
	Ожидаем.Что(БезКода.Количество(), "без кода внешних ресурсов нет: " + СтрСоединить(БезКода, ", ")).Равно(0);

КонецПроцедуры

// Сторож сам себя: каждая форма внешней загрузки находится, ссылка, метаданные, своя статика
// и разметка, напечатанная текстом, — нет.
&Тест
Процедура ПоискВнешнихРесурсовВидитКаждыйВидЗагрузки() Экспорт

	Случаи = Новый Соответствие();
	Случаи.Вставить("<script src=""https://a.example/x.js""></script>", "https://a.example/x.js");
	Случаи.Вставить("<img alt="""" src='https://b.example/z.png'>", "https://b.example/z.png");
	Случаи.Вставить("<iframe src=https://c.example/frame></iframe>", "https://c.example/frame");
	Случаи.Вставить("<audio src=""//d.example/a.ogg""></audio>", "//d.example/a.ogg");
	Случаи.Вставить("<img src=""/static/x.png"" srcset=""https://e.example/1.png 1x, /static/2.png 2x,"
		+ " //f.example/3.png 3x"">", "https://e.example/1.png //f.example/3.png");
	Случаи.Вставить("<picture><source srcset='https://g.example/w.webp'></picture>", "https://g.example/w.webp");
	Случаи.Вставить("<video poster=""https://h.example/p.jpg""></video>", "https://h.example/p.jpg");
	Случаи.Вставить("<object type=""image/svg+xml"" data=""https://i.example/o.svg""></object>",
		"https://i.example/o.svg");
	Случаи.Вставить("<link rel=""stylesheet"" href=""//j.example/y.css"">", "//j.example/y.css");
	Случаи.Вставить("<style>.q{background:url(""https://k.example/w.png"")}</style>", "https://k.example/w.png");
	Случаи.Вставить("<style>@import 'https://l.example/v.css';</style>", "https://l.example/v.css");
	Случаи.Вставить("<script type=""module"">import { a } from 'https://m.example/m.js';</script>",
		"https://m.example/m.js");
	Случаи.Вставить("<script type=""module"">import 'https://n.example/side.js';</script>",
		"https://n.example/side.js");
	Случаи.Вставить("<script type=""module"">const m = await import(""https://o.example/lazy.js"");</script>",
		"https://o.example/lazy.js");
	Случаи.Вставить("<script type=""module"">export { b } from 'https://p.example/re.js';</script>",
		"https://p.example/re.js");
	Случаи.Вставить("<a href=""https://q.example/"">ссылка</a>", "");
	Случаи.Вставить("<meta property=""og:image"" content=""https://r.example/i.png"">", "");
	Случаи.Вставить("<script src=""/static/openhub.js""></script>", "");
	Случаи.Вставить("<pre><code>&lt;script src=&quot;https://s.example/t.js&quot;&gt;</code></pre>", "");

	Для Каждого Случай Из Случаи Цикл
		Ожидаем.Что(СтрСоединить(ВнешниеРесурсы(Случай.Ключ), " "), "внешние загрузки в " + Случай.Ключ)
			.Равно(Случай.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Адреса, за которыми браузер идёт сам, открывая страницу: скрипты, кадры, картинки и их наборы,
// обложки видео, объекты, стили, фон из стилей и импорт модулей в любой форме. Ссылки и метаданные
// он не загружает.
Функция ВнешниеРесурсы(Знач Разметка)

	Адрес = "((?:https?:)?//[^""'\s>)]+)";
	ВАтрибуте = "\s*=\s*[""']?" + Адрес;
	ВКавычках = "\s*[""']" + Адрес;

	Шаблоны = Новый Массив();
	Шаблоны.Добавить("<(?:script|img|iframe|frame|source|video|audio|embed|track|input)\b[^>]*?\ssrc" + ВАтрибуте);
	Шаблоны.Добавить("<video\b[^>]*?\sposter" + ВАтрибуте);
	Шаблоны.Добавить("<object\b[^>]*?\sdata" + ВАтрибуте);
	Шаблоны.Добавить("<link\b[^>]*?\shref" + ВАтрибуте);
	Шаблоны.Добавить("url\(" + СтрЗаменить(ВКавычках, "[""']", "[""']?"));
	Шаблоны.Добавить("@import\s+(?:url\()?" + ВКавычках);
	Шаблоны.Добавить("\b(?:import|export)\b[^;""'()]*?\bfrom" + ВКавычках);
	// import модуля без имён и динамический import(); @import стилей разобран выше
	Шаблоны.Добавить("(?<!@)\bimport" + ВКавычках);
	Шаблоны.Добавить("(?<!@)\bimport\s*\(" + ВКавычках);

	Найдено = Новый Массив();
	Для Каждого Шаблон Из Шаблоны Цикл
		Для Каждого Совпадение Из Выражение(Шаблон).НайтиСовпадения(Разметка) Цикл
			Найдено.Добавить(Совпадение.Группы[1].Значение);
		КонецЦикла;
	КонецЦикла;

	// набор картинок — список «адрес ширина» через запятую: наружу ведёт каждый внешний адрес
	Для Каждого Совпадение Из Выражение("\ssrcset\s*=\s*(?:""([^""]*)""|'([^']*)')").НайтиСовпадения(Разметка) Цикл
		Набор = Совпадение.Группы[1].Значение + Совпадение.Группы[2].Значение;
		Для Каждого Вариант Из СтрРазделить(Набор, ",", Ложь) Цикл
			АдресВарианта = СтрРазделить(СокрЛП(Вариант), " ", Ложь)[0];
			Если СтрНачинаетсяС(АдресВарианта, "//") ИЛИ Выражение("^https?://").Совпадает(АдресВарианта) Тогда
				Найдено.Добавить(АдресВарианта);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Найдено;

КонецФункции

Функция Выражение(Знач Шаблон)
	Результат = Новый РегулярноеВыражение(Шаблон);
	Результат.ИгнорироватьРегистр = Истина;
	Возврат Результат;
КонецФункции

// Тема страницы объявляет браузеру схему цветов, по которой он выбирает цвет в light-dark().
Функция ОбъявляетСхему(Знач Страница, Знач Схема)
	Возврат Выражение("color-scheme\s*:\s*" + Схема + "\b").Совпадает(Страница);
КонецФункции

// Тег подсветки, который библиотека отдаёт без темы: цвета обеих тем, выбор — за браузером.
Функция ТегПодсветки()
	Возврат MarkdownПодсветка.ТегСкрипта();
КонецФункции

Функция СтраницаПакета(Знач ИмяПакета)
	Ответ = Клиент.GET(АдресПакета(ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "страница пакета отдана: " + ИмяПакета).Равно(200);
	Возврат Тело(Ответ);
КонецФункции

Функция АдресПакета(Знач ИмяПакета)
	Возврат СтрШаблон("/pools/%1/packages/%2", Пул(), ИмяПакета);
КонецФункции

Функция Тело(Знач Ответ)
	Возврат Клиент.Тело(Ответ);
КонецФункции

Функция ТегHTML(Знач Тема)
	Возврат СтрШаблон("<html lang=""ru"" data-theme=""%1"">", Тема);
КонецФункции

// Публикует версию пакета с заданным README.
Процедура ОпубликоватьСREADME(Знач ИмяПакета, Знач Версия, Знач ТекстREADME)

	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Фикстура = Новый ФикстураПакета();
	Файл = Фикстура.ПостроитьOspxПоМанифесту(Каталог,
		Фикстура.МанифестСРепозиторием(ИмяПакета, Версия), ТекстREADME);
	Клиент.Опубликовать(Пул(), Файл, КлючАдмина);

КонецПроцедуры

Функция READMEСКодом()
	Возврат "# Пакет с кодом
	|
	|```bsl
	|Процедура Привет() Экспорт
	|	Сообщить(""<script>alert(""xss-в-коде"")</script>"");
	|КонецПроцедуры
	|```
	|
	|```json
	|{""имя"": ""пакет"", ""версия"": 1}
	|```
	|
	|```bsl
	|// второй блок того же языка
	|```
	|";
КонецФункции

Функция READMEБезКода()
	Возврат "# Пакет без кода
	|
	|Текст и `инлайн` код в строке.
	|
	|```
	|блок без языка
	|```
	|";
КонецФункции

Функция ПакетСКодом()
	Возврат "codelib";
КонецФункции

Функция ПакетБезКода()
	Возврат "plainlib";
КонецФункции

Функция Пул()
	Возврат "codes";
КонецФункции

Функция ЛогинАдмина()
	Возврат "code-admin";
КонецФункции

Функция ПарольАдмина()
	Возврат "CodeAdminPass1";
КонецФункции

#КонецОбласти
