// Форма подписки на живом хабе: отбор по тегам — галки из тегов пула или пакета, строки ввода
// тегов нет, у хаба отбора нет; тег, удалённый из пула, выпадает из отбора, и раздел об этом
// предупреждает. Предпросмотр текста Telegram — шаблон формы на образце пакета: кусочком для
// скрипта страницы и страницей в новой вкладке без него, без сохранения, в разделах пакета, пула
// и хаба. Проба настройками формы — без сохранения, по введённому адресу, с потолком и правом.
// Засев кабинета: пул public с alice-pkg 1.0.0 и 1.1.0, root — администратор хаба, bob — нет.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу
Перем Кука;     // сессия root
Перем Мутация;  // заголовки мутации root: кука и CSRF

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ПриёмникВебхука");
	РеестрФикстур.Подключить("ВыдачаПортов");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);

	Хаб.ФайловаяБаза("openhub-форма-подписки");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// фоновую доставку гасим: набор смотрит страницы, а не сеть
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	// проба ходит в приёмник набора по http на loopback; приёмник не отвечает — хаб бросает ждать быстро
	Хаб.Среда("OSHUB_WEBHOOKS_ALLOW__INSECURE", "true");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__TIMEOUT__SEC", "2");
	Хаб.Среда("OSHUB_WEBHOOKS_TEST__MAX__PER__HOUR", "2");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры",
		"ЗасеятьКабинет.os"));

	Хаб.Запустить();

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Мутация = Клиент.ЗаголовкиМутации(Кука,
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/tokens", Кука))));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ГалкиТегов

// У пула без тегов форма говорит, откуда они берутся; с тегами пула — по галке на тег, строки
// ввода нет. Отмеченная галка ложится в отбор, выдуманное имя отклоняется, а тег, удалённый
// из пула, выпадает из отбора — раздел помечает его в карточке и в форме правки.
&Тест
Процедура ФормаПодпискиПулаПредлагаетГалкиТеговПула() Экспорт

	Пул = НовыйПул();
	Раздел = "/pools/" + Пул + "/settings/webhooks";
	Ожидаем.Что(СтрНайти(Страница(Раздел), "У пула нет тегов для отбора") > 0,
		"без тегов пула форма говорит, откуда они берутся").ЭтоИстина();

	ВключитьТегиПула(Пул);
	Форма = Страница(Раздел);
	Для Каждого Имя Из СтрРазделить("stable,prerelease,develop", ",") Цикл
		Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тега_" + Имя + """") > 0,
			СтрШаблон("галка тега пула %1", Имя)).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тегов"""), "строки ввода тегов нет").Равно(0);

	Выдуманный = Клиент.POSTФормы(Раздел, ПоляЗаведения(Форма, "https://hooks.example.com/forged", "nightly"), Кука);
	Ожидаем.Что(Выдуманный.КодСостояния, "имя не из тегов пула — отказ формы").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Выдуманный), "Тега «nightly» нет среди тегов пула") > 0,
		"отказ называет перечень").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTФормы(Раздел, ПоляЗаведения(Форма, "https://hooks.example.com/stable", "stable"),
		Кука).КодСостояния, "подписка с галкой stable заведена").Равно(200);
	Ожидаем.Что(СведениеКарточки(Страница(Раздел), "Теги"), "отбор виден в карточке строкой «Теги»").Равно("stable");

	Ожидаем.Что(Клиент.ЗапросJSON("DELETE", "/api/v1/pools/" + Пул + "/tags/stable", "", Мутация).КодСостояния,
		"тег stable удалён из пула").Равно(200);
	ПослеУдаления = Страница(Раздел);
	Ожидаем.Что(СведениеКарточки(ПослеУдаления, "Тегов больше нет"), "карточка помечает выпавший тег своей строкой")
		.Равно("stable");
	Ожидаем.Что(СтрНайти(ПослеУдаления, "Тегов stable больше нет") > 0, "форма правки предупреждает")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеУдаления, "name=""отбор_тега_stable"""), "галки удалённого тега нет").Равно(0);

КонецПроцедуры

// У пакета галки — его теги: свой и унаследованные от пула, без выключенного у пакета.
&Тест
Процедура ФормаПодпискиПакетаПредлагаетТегиПакета() Экспорт

	ВключитьТегиПула("public");
	Пакет = "/api/v1/pools/public/packages/alice-pkg";
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Пакет + "/tags/lts", "{""rule"":""^1.0"",""mode"":""правило""}",
		Мутация).КодСостояния, "свой тег пакета заведён").Равно(200);
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Пакет + "/tags/develop/disabled", "", Мутация).КодСостояния,
		"develop выключен у пакета").Равно(200);

	Форма = Страница("/pools/public/packages/alice-pkg/settings/webhooks");
	Для Каждого Имя Из СтрРазделить("lts,stable,prerelease", ",") Цикл
		Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тега_" + Имя + """") > 0,
			СтрШаблон("галка тега пакета %1", Имя)).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тега_develop"""), "выключенного у пакета тега нет").Равно(0);
	Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тегов"""), "строки ввода тегов нет").Равно(0);

	Клиент.ЗапросJSON("DELETE", Пакет + "/tags/develop/disabled", "", Мутация);
	Клиент.ЗапросJSON("DELETE", Пакет + "/tags/lts", "", Мутация);

КонецПроцедуры

&Тест
Процедура УПодпискиХабаОтбораПоТегамНет() Экспорт

	ВключитьТегиПула("public");
	Форма = Страница("/hub/settings/webhooks");
	Ожидаем.Что(СтрНайти(Форма, "Подписки на события") > 0, "КОНТРОЛЬ: раздел подписок хаба").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "отбор_тега_"), "галок тегов у хаба нет").Равно(0);
	Ожидаем.Что(СтрНайти(Форма, "Только версии под тегами"), "и самого отбора").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Предпросмотр

// Кнопка формы заведения шлёт форму на адрес предпросмотра и открывает ответ в новой вкладке:
// форма с токеном остаётся на своей странице. Страница предпросмотра — текст на последней версии
// пакета, без формы и без токена; подписка не заведена; пустой шаблон — текст по умолчанию,
// неизвестное имя — тот же отказ с перечнем, что на сохранении.
&Тест
Процедура ПредпросмотрФормыЗаведенияНичегоНеЗаводит() Экспорт

	Раздел = "/pools/public/packages/alice-pkg/settings/webhooks";
	Форма = Страница(Раздел + "?kind=telegram");
	Кнопка = ТегСАтрибутом(Форма, "formaction=""" + Раздел + "/preview""");
	Ожидаем.Что(Кнопка, "кнопка предпросмотра есть").Заполнено();
	Ожидаем.Что(СтрНайти(Кнопка, "formtarget=""_blank""") > 0, "ответ — в новой вкладке: " + Кнопка).ЭтоИстина();
	Было = ЧислоПодписокПакета();

	Шаблон = "{пул}/{пакет} {версия}: {кто}, {как}";
	Ответ = Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, Шаблон), Кука);
	Ожидаем.Что(Ответ.КодСостояния, "предпросмотр показан").Равно(200);
	Показ = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Показ, "Так придёт уведомление") > 0, "страница предпросмотра").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Показ, "public/alice-pkg 1.1.0: root, учётка хаба") > 0,
		"шаблон развёрнут на последней версии пакета: " + Показ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Показ, "name=""шаблон-текста"""), "формы на странице предпросмотра нет").Равно(0);
	Ожидаем.Что(СтрНайти(Показ, "AAFukAn-predprosmotr"), "токена на ней нет").Равно(0);
	Ожидаем.Что(ЧислоПодписокПакета(), "подписка не заведена").Равно(Было);

	ПоУмолчанию = Клиент.Тело(Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, ""), Кука));
	Ожидаем.Что(СтрНайти(ПоУмолчанию, "OpenHub: ") > 0, "пустой шаблон — текст по умолчанию").ЭтоИстина();

	Отказ = Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, "Вышел {пакетик}"), Кука);
	Ожидаем.Что(Отказ.КодСостояния, "неизвестное имя — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "Неизвестный плейсхолдер «{пакетик}»") > 0,
		"названо имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "{ссылка}") > 0, "и перечень допустимых").ЭтоИстина();
	Ожидаем.Что(ЧислоПодписокПакета(), "и после отказа подписок не прибавилось").Равно(Было);

	БезТокенаФормы = ПоляTelegram(Форма, Шаблон);
	БезТокенаФормы.Удалить("_csrf");
	Ожидаем.Что(Клиент.POSTФормы(Раздел + "/preview", БезТокенаФормы, Кука).КодСостояния,
		"предпросмотр без токена формы отклонён").Равно(403);

КонецПроцедуры

// Предпросмотр формы правки показывает текст по новому шаблону, а подписка хранит прежний;
// чужая подписка на адресе предпросмотра — 404.
&Тест
Процедура ПредпросмотрПравкиНеМеняетПодписку() Экспорт

	Раздел = "/pools/public/packages/alice-pkg/settings/webhooks";
	Ид = ПодпискаTelegram(Раздел, "-100778", "Было {версия}");
	Правка = ПоляTelegram(Страница(Раздел), "Стало {версия}");
	Правка.Вставить("chat-id", "-100778");
	Правка.Вставить("включить", "1");

	Ответ = Клиент.POSTФормы(Раздел + "/" + Ид + "/preview", Правка, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "предпросмотр правки показан").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Стало 1.1.0") > 0, "текст по новому шаблону").ЭтоИстина();

	После = Страница(Раздел);
	Ожидаем.Что(СтрНайти(После, "Было {версия}</textarea>") > 0, "подписка хранит прежний шаблон").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, "Стало {версия}"), "новый не сохранён").Равно(0);

	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/webhooks/" + Ид + "/preview", Правка, Кука).КодСостояния,
		"подписка пакета на адресе раздела пула — как несуществующая").Равно(404);

КонецПроцедуры

// Адреса предпросмотра раздела пула и раздела хаба отвечают текстом по формам заведения и правки:
// кнопка каждой формы ведёт туда, где её ждут.
&Тест
Процедура ПредпросмотрРаботаетВРазделахПулаИХаба() Экспорт

	Для Каждого Раздел Из СтрРазделить("/pools/public/settings/webhooks,/hub/settings/webhooks", ",") Цикл

		Форма = Страница(Раздел + "?kind=telegram");
		Ожидаем.Что(ТегСАтрибутом(Форма, "formaction=""" + Раздел + "/preview"""),
			Раздел + ": кнопка формы заведения").Заполнено();
		Заведение = Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, "заведение {событие}"), Кука);
		Ожидаем.Что(Заведение.КодСостояния, Раздел + ": предпросмотр заведения").Равно(200);
		Ожидаем.Что(СтрНайти(Клиент.Тело(Заведение), "заведение ") > 0, Раздел + ": текст заведения").ЭтоИстина();

		Ид = ПодпискаTelegram(Раздел, "-100779", "Было {версия}");
		Правка = ПоляTelegram(Страница(Раздел), "правка {версия}");
		Правка.Вставить("chat-id", "-100779");
		Правка.Вставить("включить", "1");
		Ожидаем.Что(ТегСАтрибутом(Страница(Раздел), "formaction=""" + Раздел + "/" + Ид + "/preview"""),
			Раздел + ": кнопка формы правки").Заполнено();
		ВПравке = Клиент.POSTФормы(Раздел + "/" + Ид + "/preview", Правка, Кука);
		Ожидаем.Что(ВПравке.КодСостояния, Раздел + ": предпросмотр правки").Равно(200);
		Ожидаем.Что(СтрНайти(Клиент.Тело(ВПравке), "правка 1.0.0") > 0, Раздел + ": текст правки").ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

// Скрипт страницы шлёт форму без токена бота на адрес, который отвечает кусочком, и вставляет
// ответ рядом с полем шаблона: сообщение на образце — без страницы вокруг, без формы и без токена,
// карточка ссылки — только если в тексте есть ссылка; отказ — причина с перечнем допустимых;
// подписка не заводится.
&Тест
Процедура ПредпросмотрНаЛетуОтвечаетКусочкомСообщения() Экспорт

	Раздел = "/pools/public/packages/alice-pkg/settings/webhooks";
	Форма = Страница(Раздел + "?kind=telegram");
	Место = ТегСАтрибутом(Форма, "data-sub-preview=""" + Раздел + "/preview?fragment=1""");
	Ожидаем.Что(Место, "место предпросмотра у поля шаблона").Заполнено();
	Ожидаем.Что(СтрНайти(Место, "data-sub-omit=""бот-токен""") > 0, "токен бота скрипт не шлёт: " + Место)
		.ЭтоИстина();
	Было = ЧислоПодписокПакета();

	Поля = ПоляTelegram(Форма, "{пакет} {версия}" + Символы.ПС + "{кто}");
	Поля.Удалить("бот-токен");
	Ответ = Клиент.POSTФормы(Раздел + "/preview?fragment=1", Поля, Кука);
	Кусок = Клиент.Тело(Ответ);
	Ожидаем.Что(Ответ.КодСостояния, "сообщение собрано: " + Кусок).Равно(200);
	Ожидаем.Что(СтрНайти(Кусок, "data-sub-result=""ok""") > 0, "кусочек для скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кусок, "alice-pkg 1.1.0" + Символы.ПС + "root") > 0,
		"текст на образце, переносы строк на месте: " + Кусок).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кусок, "data-sub-card"), "в тексте нет ссылки — и карточки нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Кусок), "<html"), "страницы вокруг нет").Равно(0);
	Ожидаем.Что(СтрНайти(Кусок, "<form"), "формы нет").Равно(0);
	Ожидаем.Что(СтрНайти(Кусок, "AAFukAn"), "токена нет").Равно(0);

	Поля = ПоляTelegram(Форма, "{пакет} {версия}" + Символы.ПС + "{релиз}");
	Поля.Удалить("бот-токен");
	СоСсылкой = Клиент.Тело(Клиент.POSTФормы(Раздел + "/preview?fragment=1", Поля, Кука));
	Ожидаем.Что(СтрНайти(СоСсылкой, "data-sub-card") > 0, "ссылка в тексте — под ним карточка: " + СоСсылкой)
		.ЭтоИстина();

	Отказ = Клиент.POSTФормы(Раздел + "/preview?fragment=1", ПоляTelegram(Форма, "Вышел {пакетик}"), Кука);
	Ожидаем.Что(Отказ.КодСостояния, "неизвестное имя — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "data-sub-result=""err""") > 0, "отказ — кусочком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "Неизвестный плейсхолдер «{пакетик}»") > 0, "названо имя")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "{ссылка}") > 0, "и перечень допустимых").ЭтоИстина();
	Ожидаем.Что(ЧислоПодписокПакета(), "подписок не прибавилось").Равно(Было);

КонецПроцедуры

// Что видно в пустом поле шаблона, то и придёт: подсказка поля — шаблон по умолчанию, и
// предпросмотр пустого поля даёт тот же текст, что этот шаблон, набранный в поле.
&Тест
Процедура ПустоеПолеШаблонаПоказываетТекстКоторыйПридёт() Экспорт

	Раздел = "/pools/public/packages/alice-pkg/settings/webhooks";
	Форма = Страница(Раздел + "?kind=telegram");
	Подсказка = Клиент.ЗначениеАтрибута(ТегСАтрибутом(Форма, "name=""шаблон-текста"""), "placeholder");
	Ожидаем.Что(СтрНачинаетсяС(Подсказка, "OpenHub: {событие}" + Символы.ПС), "в пустом поле — шаблон по умолчанию: "
		+ Подсказка).ЭтоИстина();

	Пустое = ТекстСообщения(ПредпросмотрКусочком(Раздел, Форма, ""));
	Набранное = ТекстСообщения(ПредпросмотрКусочком(Раздел, Форма, Подсказка));
	Ожидаем.Что(СтрНайти(Пустое, "alice-pkg") > 0, "предпросмотр пустого поля — текст по умолчанию: " + Пустое)
		.ЭтоИстина();
	Ожидаем.Что(БезВремени(Набранное), "тот же текст, что у набранной подсказки").Равно(БезВремени(Пустое));

КонецПроцедуры

#КонецОбласти

#Область ПробаФормы

// Проба формы заведения уходит одной попыткой по введённому адресу и ничего не заводит: приёмник
// получает POST с телом пробы, итог возвращается кусочком у кнопки. Без скрипта кнопка шлёт ту же
// форму на адрес пробы в новую вкладку.
&Тест
Процедура ПробаФормыЗаведенияУходитПоВведённомуАдресуИНичегоНеЗаводит() Экспорт

	Раздел = "/pools/public/settings/webhooks";
	Форма = Страница(Раздел);
	Кнопка = ТегСАтрибутом(Форма, "formaction=""" + Раздел + "/test""");
	Ожидаем.Что(СтрНайти(Кнопка, "formtarget=""_blank""") > 0, "без скрипта — в новую вкладку: " + Кнопка)
		.ЭтоИстина();
	Ожидаем.Что(ТегСАтрибутом(Форма, "data-sub-trial=""" + Раздел + "/test?fragment=1"""), "скрипту — кусочком")
		.Заполнено();
	Было = ЧислоПодписок("/api/v1/pools/public/webhooks");

	Приёмник = Новый ПриёмникВебхука();
	Порт = Формат(Приёмник.Слушать(), "ЧГ=0");
	Попытка
		Ответ = Клиент.POSTФормы(Раздел + "/test?fragment=1",
			ПоляВебхука(Форма, "http://127.0.0.1:" + Порт + "/iz-formy-zavedeniya"), Кука);
		Запрос = Приёмник.ПринятьЗапрос();
	Исключение
		Приёмник.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	Приёмник.Остановить();

	Ожидаем.Что(Ответ.КодСостояния, "проба отправлена: " + Клиент.Тело(Ответ)).Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "data-sub-result=") > 0, "итог — кусочком").ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Запрос, "POST /iz-formy-zavedeniya "),
		"по введённому адресу: " + Запрос + Символы.ПС + СтрокиЖурнала("Проба вебхука")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запрос, """проба"":true") > 0, "тело помечено пробой: " + Запрос).ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Запрос), "x-openhub-event: subscription.test") > 0,
		"в заголовке — латинский код пробы: " + Запрос).ЭтоИстина();
	Ожидаем.Что(ЧислоПодписок("/api/v1/pools/public/webhooks"), "подписка не заведена").Равно(Было);

КонецПроцедуры

// Проба формы правки идёт введёнными настройками, а подписка хранит прежние; форма правки чужой
// подписки на адресе пробы своего раздела — как несуществующая.
&Тест
Процедура ПробаФормыПравкиИдётВведённымиНастройкамиАЧужаяНеНаходится() Экспорт

	Раздел = "/pools/public/settings/webhooks";
	Ид = ПодпискаВебхука(Раздел, "https://hooks.example.com/sohranyonny-adres");

	Приёмник = Новый ПриёмникВебхука();
	Порт = Формат(Приёмник.Слушать(), "ЧГ=0");
	Правка = ПоляВебхука(Страница(Раздел), "http://127.0.0.1:" + Порт + "/iz-formy-pravki");
	Правка.Вставить("секрет-свой", "1");
	Правка.Вставить("включить", "1");
	Попытка
		Ответ = Клиент.POSTФормы(Раздел + "/" + Ид + "/test?fragment=1", Правка, Кука);
		Запрос = Приёмник.ПринятьЗапрос();
	Исключение
		Приёмник.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	Приёмник.Остановить();

	Ожидаем.Что(Ответ.КодСостояния, "проба правки отправлена: " + Клиент.Тело(Ответ)).Равно(200);
	Ожидаем.Что(СтрНачинаетсяС(Запрос, "POST /iz-formy-pravki "),
		"адрес — из формы: " + Запрос + Символы.ПС + СтрокиЖурнала("Проба вебхука")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запрос, "X-OpenHub-Signature") > 0, "подписана").ЭтоИстина();
	После = Страница(Раздел);
	Ожидаем.Что(СтрНайти(После, "sohranyonny-adres") > 0, "подписка хранит прежний адрес").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, "iz-formy-pravki"), "введённый не сохранён").Равно(0);

	Ожидаем.Что(Клиент.POSTФормы("/pools/public/packages/alice-pkg/settings/webhooks/" + Ид + "/test?fragment=1",
		Правка, Кука).КодСостояния, "подписка пула на адресе раздела пакета — как несуществующая").Равно(404);

КонецПроцедуры

// Потолок незаведённой подписки — на автора и объект: третья проба формы заведения за час —
// названный отказ кусочком; без права распоряжаться подписками объекта и без токена формы — 403;
// адрес правки с негодным идентификатором — 404, а не проба формы заведения.
&Тест
Процедура ПробаФормыУпираетсяВПотолокИТребуетПрава() Экспорт

	Раздел = "/hub/settings/webhooks";
	Форма = Страница(Раздел);
	// порт без слушателя: цель отказывает сразу, итог пробы — «не дошло»
	Выдача = Новый ВыдачаПортов();
	Адрес = "http://127.0.0.1:" + Формат(Выдача.Выдать(), "ЧГ=0") + "/nikto-ne-slushaet";
	Выдача.ВернутьВсе();

	Для Номер = 1 По 2 Цикл
		Ожидаем.Что(Клиент.POSTФормы(Раздел + "/test?fragment=1", ПоляВебхука(Форма, Адрес), Кука).КодСостояния,
			СтрШаблон("проба %1 в пределах потолка", Номер)).Равно(200);
	КонецЦикла;
	Сверх = Клиент.POSTФормы(Раздел + "/test?fragment=1", ПоляВебхука(Форма, Адрес), Кука);
	Ожидаем.Что(Сверх.КодСостояния, "третья — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Сверх), "не больше 2 за час") > 0, "отказ назван: " + Клиент.Тело(Сверх))
		.ЭтоИстина();

	КукаБоба = Клиент.Войти("bob", "BobPassw0rd");
	РазделПула = "/pools/public/settings/webhooks";
	Поля = ПоляВебхука(Форма, Адрес);
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/tokens", КукаБоба))));
	Ожидаем.Что(Клиент.POSTФормы(РазделПула + "/test?fragment=1", Поля, КукаБоба).КодСостояния,
		"без права на подписки пула — отказ").Равно(403);

	БезТокенаФормы = ПоляВебхука(Форма, Адрес);
	БезТокенаФормы.Удалить("_csrf");
	Для Каждого Адрес_ Из СтрРазделить(Раздел + "/test?fragment=1," + Раздел + "/test", ",") Цикл
		Ожидаем.Что(Клиент.POSTФормы(Адрес_, БезТокенаФормы, Кука).КодСостояния,
			Адрес_ + ": без токена формы — отказ").Равно(403);
	КонецЦикла;
	Для Каждого Негодный Из СтрРазделить("0,abc", ",") Цикл
		Ожидаем.Что(Клиент.POSTФормы(Раздел + "/" + Негодный + "/test?fragment=1", ПоляВебхука(Форма, Адрес),
			Кука).КодСостояния, СтрШаблон("адрес правки «%1» — как несуществующий", Негодный)).Равно(404);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Страница(Знач Путь)
	Ответ = Клиент.GETСКукой(Путь, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "страница " + Путь).Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

// Значение подписанной строки в свёрнутой строке карточки — по тексту, как его читает человек:
// подпись и следующий за ней кусок текста. "" — строки нет ни в одной карточке.
Функция СведениеКарточки(Знач HTML, Знач Подпись)

	Хвост = HTML;
	Начало = СтрНайти(Хвост, "<summary");
	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало);
		Конец = СтрНайти(Хвост, "</summary>");
		Куски = КускиТекста(?(Конец = 0, Хвост, Лев(Хвост, Конец)));
		Для Номер = 0 По Куски.Количество() - 2 Цикл
			Если Куски[Номер] = Подпись Тогда
				Возврат Куски[Номер + 1];
			КонецЕсли;
		КонецЦикла;
		Хвост = Сред(Хвост, 2);
		Начало = СтрНайти(Хвост, "<summary");
	КонецЦикла;
	Возврат "";

КонецФункции

// Текст разметки кусками между тегами, без пустых.
Функция КускиТекста(Знач Разметка)

	Куски = Новый Массив();
	Для Каждого Часть Из СтрРазделить(Разметка, "<", Ложь) Цикл
		Текст = СокрЛП(Сред(Часть, СтрНайти(Часть, ">") + 1));
		Если ЗначениеЗаполнено(Текст) Тогда
			Куски.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Куски;

КонецФункции

// Пул root-а без тегов: его теги набор правит сам и соседям не мешает.
Функция НовыйПул()
	Имя = УникальныеИмена.Имя("tagform");
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/pools", СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя),
		Мутация);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён").Равно(201);
	Возврат Имя;
КонецФункции

// Галка «теги пула для пакетов»: первое включение заводит stable, prerelease и develop.
Процедура ВключитьТегиПула(Знач Пул)
	Ответ = Клиент.ЗапросJSON("PATCH", "/api/v1/pools/" + Пул + "/settings", "{""pool_tags"":true}", Мутация);
	Ожидаем.Что(Ответ.КодСостояния, "теги пула включены").Равно(200);
КонецПроцедуры

// Подписка Telegram формой раздела; идентификатор — из адреса её формы правки.
Функция ПодпискаTelegram(Знач Раздел, Знач Чат, Знач Шаблон)
	Поля = ПоляTelegram(Страница(Раздел + "?kind=telegram"), Шаблон);
	Поля.Вставить("chat-id", Чат);
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, Кука).КодСостояния, "подписка Telegram заведена").Равно(200);
	Список = Страница(Раздел);
	Возврат Клиент.ПослеМаркера(Сред(Список, СтрНайти(Список, Чат)), Раздел + "/", "/save");
КонецФункции

Функция ПредпросмотрКусочком(Знач Раздел, Знач Форма, Знач Шаблон)
	Поля = ПоляTelegram(Форма, Шаблон);
	Поля.Удалить("бот-токен");
	Ответ = Клиент.POSTФормы(Раздел + "/preview?fragment=1", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "предпросмотр собран: " + Клиент.Тело(Ответ)).Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

// Текст «пузыря» сообщения в кусочке предпросмотра — как он напечатан.
Функция ТекстСообщения(Знач Кусок)
	Хвост = Сред(Кусок, СтрНайти(Кусок, "data-sub-text"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, ">") + 1);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</") - 1);
КонецФункции

// Время образца — «сейчас»: два запроса подряд могут разойтись на секунду.
Функция БезВремени(Знач Текст)
	Строки = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		ЭтоВремя = СтрДлина(Строка_) = 20 И Сред(Строка_, 11, 1) = "T" И Прав(Строка_, 1) = "Z";
		Строки.Добавить(?(ЭтоВремя, "<время>", Строка_));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Открывающий тег, в котором стоит атрибут; "" — такого нет.
Функция ТегСАтрибутом(Знач HTML, Знач Атрибут)
	Позиция = СтрНайти(HTML, Атрибут);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Лев(HTML, Позиция), "<", НаправлениеПоиска.СКонца);
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

// Форма Telegram с шаблоном на публикацию версии; токен — секрет, в предпросмотр он не идёт.
Функция ПоляTelegram(Знач Форма, Знач Шаблон)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Форма));
	Поля.Вставить("тип_действия", "telegram");
	Поля.Вставить("chat-id", "-100777");
	Поля.Вставить("бот-токен", "123456:AAFukAn-predprosmotr");
	Поля.Вставить("шаблон-текста", Шаблон);
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	Возврат Поля;
КонецФункции

Функция ЧислоПодписокПакета()
	Ответ = Клиент.ЗапросJSON("GET", "/api/v1/pools/public/packages/alice-pkg/webhooks", "", Мутация);
	Ожидаем.Что(Ответ.КодСостояния, "подписки пакета читаются").Равно(200);
	Возврат Клиент.ТелоJSON(Ответ).Получить("total");
КонецФункции

// Строки журнала хаба с фрагментом: причина сбоя пробы видна в сообщении упавшей проверки.
Функция СтрокиЖурнала(Знач Фрагмент)
	Найденные = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Хаб.Дамп(), Символы.ПС) Цикл
		Если СтрНайти(Строка_, Фрагмент) > 0 Тогда
			Найденные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Найденные, Символы.ПС);
КонецФункции

// Подписка-вебхук формой раздела; идентификатор — из адреса её формы правки.
Функция ПодпискаВебхука(Знач Раздел, Знач Адрес)
	Ожидаем.Что(Клиент.POSTФормы(Раздел, ПоляВебхука(Страница(Раздел), Адрес), Кука).КодСостояния,
		"подписка-вебхук заведена").Равно(200);
	Список = Страница(Раздел);
	Возврат Клиент.ПослеМаркера(Сред(Список, СтрНайти(Список, Адрес)), Раздел + "/", "/save");
КонецФункции

// Форма вебхука на публикацию версии без отбора по тегам.
Функция ПоляВебхука(Знач Форма, Знач Адрес)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Форма));
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", Адрес);
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	Возврат Поля;
КонецФункции

Функция ЧислоПодписок(Знач АдресAPI)
	Ответ = Клиент.ЗапросJSON("GET", АдресAPI, "", Мутация);
	Ожидаем.Что(Ответ.КодСостояния, "подписки читаются").Равно(200);
	Возврат Клиент.ТелоJSON(Ответ).Получить("total");
КонецФункции

// Форма заведения вебхука на публикацию версии с одной отмеченной галкой тега.
Функция ПоляЗаведения(Знач Форма, Знач Адрес, Знач Тег)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Форма));
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", Адрес);
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	Поля.Вставить("отбор_тега_" + Тег, "1");
	Возврат Поля;
КонецФункции

#КонецОбласти
