// Форма подписки на живом хабе: отбор по тегам — галки из тегов пула или пакета, строки ввода
// тегов нет, у хаба отбора нет; тег, удалённый из пула, выпадает из отбора, и раздел об этом
// предупреждает. Предпросмотр текста Telegram — шаблон формы на образце пакета в новой вкладке,
// без сохранения, в разделах пакета, пула и хаба.
// Засев кабинета: пул public с alice-pkg 1.0.0 и 1.1.0, root — администратор хаба.

#Использовать asserts
#Использовать "../../фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу
Перем Кука;     // сессия root
Перем Мутация;  // заголовки мутации root: кука и CSRF

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);

	Хаб.ФайловаяБаза("openhub-форма-подписки");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// фоновую доставку гасим: набор смотрит страницы, а не сеть
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры",
		"ЗасеятьКабинет.os"));

	Хаб.Запустить();

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Мутация = Клиент.ЗаголовкиМутации(Кука,
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/tokens", Кука))));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ГалкиТегов

// У пула без тегов форма говорит, откуда они берутся; с тегами пула — по галке на тег, строки
// ввода нет. Отмеченная галка ложится в отбор, выдуманное имя отклоняется, а тег, удалённый
// из пула, выпадает из отбора — раздел помечает его в карточке и в форме правки.
&Тест
Процедура ФормаПодпискиПулаПредлагаетГалкиТеговПула() Экспорт

	Пул = НовыйПул();
	Раздел = "/pools/" + Пул + "/settings/webhooks";
	Ожидаем.Что(СтрНайти(Страница(Раздел), "У пула нет тегов для отбора") > 0,
		"без тегов пула форма говорит, откуда они берутся").ЭтоИстина();

	ВключитьТегиПула(Пул);
	Форма = Страница(Раздел);
	Для Каждого Имя Из СтрРазделить("stable,prerelease,develop", ",") Цикл
		Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тега_" + Имя + """") > 0,
			СтрШаблон("галка тега пула %1", Имя)).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тегов"""), "строки ввода тегов нет").Равно(0);

	Выдуманный = Клиент.POSTФормы(Раздел, ПоляЗаведения(Форма, "https://hooks.example.com/forged", "nightly"), Кука);
	Ожидаем.Что(Выдуманный.КодСостояния, "имя не из тегов пула — отказ формы").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Выдуманный), "Тега «nightly» нет среди тегов пула") > 0,
		"отказ называет перечень").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTФормы(Раздел, ПоляЗаведения(Форма, "https://hooks.example.com/stable", "stable"),
		Кука).КодСостояния, "подписка с галкой stable заведена").Равно(200);
	Ожидаем.Что(СтрНайти(Страница(Раздел), "теги: stable") > 0, "отбор виден в карточке").ЭтоИстина();

	Ожидаем.Что(Клиент.ЗапросJSON("DELETE", "/api/v1/pools/" + Пул + "/tags/stable", "", Мутация).КодСостояния,
		"тег stable удалён из пула").Равно(200);
	ПослеУдаления = Страница(Раздел);
	Ожидаем.Что(СтрНайти(ПослеУдаления, "тега больше нет: stable") > 0, "карточка помечает выпавший тег")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеУдаления, "Тегов stable больше нет") > 0, "форма правки предупреждает")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеУдаления, "name=""отбор_тега_stable"""), "галки удалённого тега нет").Равно(0);

КонецПроцедуры

// У пакета галки — его теги: свой и унаследованные от пула, без выключенного у пакета.
&Тест
Процедура ФормаПодпискиПакетаПредлагаетТегиПакета() Экспорт

	ВключитьТегиПула("public");
	Пакет = "/api/v1/pools/public/packages/alice-pkg";
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Пакет + "/tags/lts", "{""rule"":""^1.0"",""mode"":""правило""}",
		Мутация).КодСостояния, "свой тег пакета заведён").Равно(200);
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", Пакет + "/tags/develop/disabled", "", Мутация).КодСостояния,
		"develop выключен у пакета").Равно(200);

	Форма = Страница("/pools/public/packages/alice-pkg/settings/webhooks");
	Для Каждого Имя Из СтрРазделить("lts,stable,prerelease", ",") Цикл
		Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тега_" + Имя + """") > 0,
			СтрШаблон("галка тега пакета %1", Имя)).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тега_develop"""), "выключенного у пакета тега нет").Равно(0);
	Ожидаем.Что(СтрНайти(Форма, "name=""отбор_тегов"""), "строки ввода тегов нет").Равно(0);

	Клиент.ЗапросJSON("DELETE", Пакет + "/tags/develop/disabled", "", Мутация);
	Клиент.ЗапросJSON("DELETE", Пакет + "/tags/lts", "", Мутация);

КонецПроцедуры

&Тест
Процедура УПодпискиХабаОтбораПоТегамНет() Экспорт

	ВключитьТегиПула("public");
	Форма = Страница("/hub/settings/webhooks");
	Ожидаем.Что(СтрНайти(Форма, "Подписки на события") > 0, "КОНТРОЛЬ: раздел подписок хаба").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "отбор_тега_"), "галок тегов у хаба нет").Равно(0);
	Ожидаем.Что(СтрНайти(Форма, "Только версии под тегами"), "и самого отбора").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Предпросмотр

// Кнопка формы заведения шлёт форму на адрес предпросмотра и открывает ответ в новой вкладке:
// форма с токеном остаётся на своей странице. Страница предпросмотра — текст на последней версии
// пакета, без формы и без токена; подписка не заведена; пустой шаблон — текст по умолчанию,
// неизвестное имя — тот же отказ с перечнем, что на сохранении.
&Тест
Процедура ПредпросмотрФормыЗаведенияНичегоНеЗаводит() Экспорт

	Раздел = "/pools/public/packages/alice-pkg/settings/webhooks";
	Форма = Страница(Раздел + "?kind=telegram");
	Кнопка = ТегСАтрибутом(Форма, "formaction=""" + Раздел + "/preview""");
	Ожидаем.Что(Кнопка, "кнопка предпросмотра есть").Заполнено();
	Ожидаем.Что(СтрНайти(Кнопка, "formtarget=""_blank""") > 0, "ответ — в новой вкладке: " + Кнопка).ЭтоИстина();
	Было = ЧислоПодписокПакета();

	Шаблон = "{пул}/{пакет} {версия}: {кто}, {как}";
	Ответ = Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, Шаблон), Кука);
	Ожидаем.Что(Ответ.КодСостояния, "предпросмотр показан").Равно(200);
	Показ = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Показ, "Так придёт уведомление") > 0, "страница предпросмотра").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Показ, "public/alice-pkg 1.1.0: root, учётка хаба") > 0,
		"шаблон развёрнут на последней версии пакета: " + Показ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Показ, "name=""шаблон-текста"""), "формы на странице предпросмотра нет").Равно(0);
	Ожидаем.Что(СтрНайти(Показ, "AAFukAn-predprosmotr"), "токена на ней нет").Равно(0);
	Ожидаем.Что(ЧислоПодписокПакета(), "подписка не заведена").Равно(Было);

	ПоУмолчанию = Клиент.Тело(Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, ""), Кука));
	Ожидаем.Что(СтрНайти(ПоУмолчанию, "OpenHub: ") > 0, "пустой шаблон — текст по умолчанию").ЭтоИстина();

	Отказ = Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, "Вышел {пакетик}"), Кука);
	Ожидаем.Что(Отказ.КодСостояния, "неизвестное имя — отказ").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "Неизвестный плейсхолдер «{пакетик}»") > 0,
		"названо имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Отказ), "{ссылка}") > 0, "и перечень допустимых").ЭтоИстина();
	Ожидаем.Что(ЧислоПодписокПакета(), "и после отказа подписок не прибавилось").Равно(Было);

	БезТокенаФормы = ПоляTelegram(Форма, Шаблон);
	БезТокенаФормы.Удалить("_csrf");
	Ожидаем.Что(Клиент.POSTФормы(Раздел + "/preview", БезТокенаФормы, Кука).КодСостояния,
		"предпросмотр без токена формы отклонён").Равно(403);

КонецПроцедуры

// Предпросмотр формы правки показывает текст по новому шаблону, а подписка хранит прежний;
// чужая подписка на адресе предпросмотра — 404.
&Тест
Процедура ПредпросмотрПравкиНеМеняетПодписку() Экспорт

	Раздел = "/pools/public/packages/alice-pkg/settings/webhooks";
	Ид = ПодпискаTelegram(Раздел, "-100778", "Было {версия}");
	Правка = ПоляTelegram(Страница(Раздел), "Стало {версия}");
	Правка.Вставить("chat-id", "-100778");
	Правка.Вставить("включить", "1");

	Ответ = Клиент.POSTФормы(Раздел + "/" + Ид + "/preview", Правка, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "предпросмотр правки показан").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Стало 1.1.0") > 0, "текст по новому шаблону").ЭтоИстина();

	После = Страница(Раздел);
	Ожидаем.Что(СтрНайти(После, "Было {версия}</textarea>") > 0, "подписка хранит прежний шаблон").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, "Стало {версия}"), "новый не сохранён").Равно(0);

	Ожидаем.Что(Клиент.POSTФормы("/pools/public/settings/webhooks/" + Ид + "/preview", Правка, Кука).КодСостояния,
		"подписка пакета на адресе раздела пула — как несуществующая").Равно(404);

КонецПроцедуры

// Адреса предпросмотра раздела пула и раздела хаба отвечают текстом по формам заведения и правки:
// кнопка каждой формы ведёт туда, где её ждут.
&Тест
Процедура ПредпросмотрРаботаетВРазделахПулаИХаба() Экспорт

	Для Каждого Раздел Из СтрРазделить("/pools/public/settings/webhooks,/hub/settings/webhooks", ",") Цикл

		Форма = Страница(Раздел + "?kind=telegram");
		Ожидаем.Что(ТегСАтрибутом(Форма, "formaction=""" + Раздел + "/preview"""),
			Раздел + ": кнопка формы заведения").Заполнено();
		Заведение = Клиент.POSTФормы(Раздел + "/preview", ПоляTelegram(Форма, "заведение {событие}"), Кука);
		Ожидаем.Что(Заведение.КодСостояния, Раздел + ": предпросмотр заведения").Равно(200);
		Ожидаем.Что(СтрНайти(Клиент.Тело(Заведение), "заведение ") > 0, Раздел + ": текст заведения").ЭтоИстина();

		Ид = ПодпискаTelegram(Раздел, "-100779", "Было {версия}");
		Правка = ПоляTelegram(Страница(Раздел), "правка {версия}");
		Правка.Вставить("chat-id", "-100779");
		Правка.Вставить("включить", "1");
		Ожидаем.Что(ТегСАтрибутом(Страница(Раздел), "formaction=""" + Раздел + "/" + Ид + "/preview"""),
			Раздел + ": кнопка формы правки").Заполнено();
		ВПравке = Клиент.POSTФормы(Раздел + "/" + Ид + "/preview", Правка, Кука);
		Ожидаем.Что(ВПравке.КодСостояния, Раздел + ": предпросмотр правки").Равно(200);
		Ожидаем.Что(СтрНайти(Клиент.Тело(ВПравке), "правка 1.0.0") > 0, Раздел + ": текст правки").ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Страница(Знач Путь)
	Ответ = Клиент.GETСКукой(Путь, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "страница " + Путь).Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

// Пул root-а без тегов: его теги набор правит сам и соседям не мешает.
Функция НовыйПул()
	Имя = УникальныеИмена.Имя("tagform");
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/pools", СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя),
		Мутация);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён").Равно(201);
	Возврат Имя;
КонецФункции

// Галка «теги пула для пакетов»: первое включение заводит stable, prerelease и develop.
Процедура ВключитьТегиПула(Знач Пул)
	Ответ = Клиент.ЗапросJSON("PATCH", "/api/v1/pools/" + Пул + "/settings", "{""pool_tags"":true}", Мутация);
	Ожидаем.Что(Ответ.КодСостояния, "теги пула включены").Равно(200);
КонецПроцедуры

// Подписка Telegram формой раздела; идентификатор — из адреса её формы правки.
Функция ПодпискаTelegram(Знач Раздел, Знач Чат, Знач Шаблон)
	Поля = ПоляTelegram(Страница(Раздел + "?kind=telegram"), Шаблон);
	Поля.Вставить("chat-id", Чат);
	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, Кука).КодСостояния, "подписка Telegram заведена").Равно(200);
	Список = Страница(Раздел);
	Возврат Клиент.ПослеМаркера(Сред(Список, СтрНайти(Список, Чат)), Раздел + "/", "/save");
КонецФункции

// Открывающий тег, в котором стоит атрибут; "" — такого нет.
Функция ТегСАтрибутом(Знач HTML, Знач Атрибут)
	Позиция = СтрНайти(HTML, Атрибут);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = СтрНайти(Лев(HTML, Позиция), "<", НаправлениеПоиска.СКонца);
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));
КонецФункции

// Форма Telegram с шаблоном на публикацию версии; токен — секрет, в предпросмотр он не идёт.
Функция ПоляTelegram(Знач Форма, Знач Шаблон)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Форма));
	Поля.Вставить("тип_действия", "telegram");
	Поля.Вставить("chat-id", "-100777");
	Поля.Вставить("бот-токен", "123456:AAFukAn-predprosmotr");
	Поля.Вставить("шаблон-текста", Шаблон);
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	Возврат Поля;
КонецФункции

Функция ЧислоПодписокПакета()
	Ответ = Клиент.ЗапросJSON("GET", "/api/v1/pools/public/packages/alice-pkg/webhooks", "", Мутация);
	Ожидаем.Что(Ответ.КодСостояния, "подписки пакета читаются").Равно(200);
	Возврат Клиент.ТелоJSON(Ответ).Получить("total");
КонецФункции

// Форма заведения вебхука на публикацию версии с одной отмеченной галкой тега.
Функция ПоляЗаведения(Знач Форма, Знач Адрес, Знач Тег)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Форма));
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", Адрес);
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	Поля.Вставить("отбор_тега_" + Тег, "1");
	Возврат Поля;
КонецФункции

#КонецОбласти
