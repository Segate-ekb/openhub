// Настройки пакета на живом хабе: поле «Репозиторий» карточки — проверка, снятие, приём
// версии и картинка карточки ссылки; опасная зона — только когда в ней есть что делать.

#Использовать asserts
#Использовать ospx-tools
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КлючАдмина;      // Строка — ключ доступа администратора хаба
Перем КореньДанных;    // Строка — временный каталог стенда: в нём собираются .ospx

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);

	КореньДанных = Хаб.ФайловаяБаза("openhub-настройки-пакета");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", ЛогинАдмина());
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_INSTANCE_URL", АдресХаба());

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	Сессия = Клиент.Кука(Клиент.Войти(ЛогинАдмина(), ПарольАдмина()));
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""права"":""read,write""}", Сессия);
	Ожидаем.Что(Ответ.КодСостояния, "ключ администратора выпущен: " + Клиент.Тело(Ответ)).Равно(201);
	КлючАдмина = Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools", "{""name"":""team"",""visibility"":""public""}",
		КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);

	ЗавестиУчётку(ЛогинВладельца(), ПарольВладельца());
	ЗавестиУчётку(ЛогинЧужого(), ПарольЧужого());
	ВыдатьРоль("", ЛогинВладельца());

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Репозиторий

// Пакет пришёл с адресом не на GitHub — картинкой знак хаба; мейнтейнер вписал адрес GitHub
// в настройках, и ссылка на пакет получила карточку репозитория.
&Тест
Процедура АдресGitHubИзНастроекДаётКартинкуРепозитория() Экспорт

	Опубликовать("lambdas", "1.0.0", "https://gitlab.com/acme/lambdas");
	Ожидаем.Что(Картинка("lambdas"), "самотест: без GitHub — знак хаба")
		.Не_().Содержит("opengraph.githubassets.com");

	Ответ = СохранитьРепозиторий("lambdas", "https://github.com/sfaqer/lambdas", КукаВладельца());
	Ожидаем.Что(Ответ.КодСостояния, "карточка сохранена").Равно(200);

	Ожидаем.Что(Картинка("lambdas"), "картинка — карточка репозитория на GitHub")
		.Равно("https://opengraph.githubassets.com/1.0.0/sfaqer/lambdas");
	Ожидаем.Что(ЗначениеПоляРепозитория("lambdas"), "поле показывает введённое")
		.Равно("https://github.com/sfaqer/lambdas");

КонецПроцедуры

// Пустое поле снимает адрес: страница пакета возвращается к знаку хаба.
&Тест
Процедура ПустоеПолеСнимаетАдрес() Экспорт

	Опубликовать("clearlib", "1.0.0", "https://github.com/acme/clearlib");
	Ожидаем.Что(Картинка("clearlib"), "самотест: адрес из манифеста работает")
		.Содержит("opengraph.githubassets.com");

	Ответ = СохранитьРепозиторий("clearlib", "", КукаВладельца());
	Ожидаем.Что(Ответ.КодСостояния, "карточка сохранена").Равно(200);

	Ожидаем.Что(ЗначениеПоляРепозитория("clearlib"), "поле пусто").Равно("");
	Ожидаем.Что(Картинка("clearlib"), "картинка — знак хаба").Не_().Содержит("opengraph.githubassets.com");

КонецПроцедуры

// Негодный адрес отвергается словами отказа и не записывается: прежний остаётся на месте.
&Тест
Процедура НегодныйАдресОтвергаетсяИНеЗаписывается() Экспорт

	Опубликовать("strictlib", "1.0.0", "https://github.com/acme/strictlib");
	Кука = КукаВладельца();

	Длинный = "https://github.com/acme/" + СтрСоединить(Новый Массив(500), "x");
	Негодные = Новый Соответствие();
	Негодные.Вставить("http://github.com/acme/strictlib", "https://");
	Негодные.Вставить("javascript:alert(1)", "https://");
	Негодные.Вставить("https://", "https://");
	Негодные.Вставить(Длинный, "длиннее 500");
	Негодные.Вставить("https://github.com/acme/" + Символы.Таб + "strictlib", "управляющие");

	Для Каждого Пара Из Негодные Цикл
		Ответ = СохранитьРепозиторий("strictlib", Пара.Ключ, Кука);
		Ожидаем.Что(Ответ.КодСостояния, "отказ: " + Лев(Пара.Ключ, 40)).Равно(400);
		Ожидаем.Что(Клиент.Тело(Ответ), "отказ назван: " + Лев(Пара.Ключ, 40)).Содержит(Пара.Значение);
		Ожидаем.Что(ЗначениеПоляРепозитория("strictlib"), "адрес не тронут: " + Лев(Пара.Ключ, 40))
			.Равно("https://github.com/acme/strictlib");
	КонецЦикла;

КонецПроцедуры

// Версия без адреса в манифесте введённый руками адрес не стирает; версия с адресом его
// обновляет.
&Тест
Процедура АдресМанифестаОбновляетПустойНеСтирает() Экспорт

	Опубликовать("intakelib", "1.0.0", "https://gitlab.com/acme/intakelib");
	СохранитьРепозиторий("intakelib", "https://github.com/acme/handset", КукаВладельца());

	Опубликовать("intakelib", "1.1.0", "");
	Ожидаем.Что(ЗначениеПоляРепозитория("intakelib"), "пустой адрес манифеста поле не стёр")
		.Равно("https://github.com/acme/handset");
	Ожидаем.Что(Картинка("intakelib"), "и картинка новой версии с введённого адреса")
		.Равно("https://opengraph.githubassets.com/1.1.0/acme/handset");

	Опубликовать("intakelib", "1.2.0", "https://github.com/acme/fromdef");
	Ожидаем.Что(ЗначениеПоляРепозитория("intakelib"), "адрес манифеста поле обновил")
		.Равно("https://github.com/acme/fromdef");

КонецПроцедуры

// Карточку правит тот, кто управляет пакетом; посторонний получает отказ, адрес не меняется.
&Тест
Процедура ПостороннийКарточкуНеПравит() Экспорт

	Опубликовать("guardedlib", "1.0.0", "https://github.com/acme/guardedlib");
	КукаЧужого = Клиент.Войти(ЛогинЧужого(), ПарольЧужого());
	Токен = Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", КукаЧужого)));
	Ожидаем.Что(ЗначениеЗаполнено(Токен), "самотест: у постороннего есть токен формы").ЭтоИстина();

	Поля = ПоляКарточки(Токен, "https://github.com/evil/guardedlib");
	Ответ = Клиент.POSTФормы(АдресРаздела("guardedlib", "card"), Поля, КукаЧужого);

	Ожидаем.Что(Ответ.КодСостояния, "постороннему — отказ").Равно(403);
	Ожидаем.Что(ЗначениеПоляРепозитория("guardedlib"), "адрес не тронут")
		.Равно("https://github.com/acme/guardedlib");

КонецПроцедуры

// Правка карточки оставляет след: кто, что и над каким пакетом, было и стало; повтор той же
// формы второй записи не даёт.
&Тест
Процедура ПравкаКарточкиПишетсяВЖурналАудита() Экспорт

	Опубликовать("auditlib", "1.0.0", "https://github.com/acme/auditlib");
	Кука = КукаВладельца();
	СохранитьРепозиторий("auditlib", "https://github.com/acme/auditlib-renamed", Кука);
	СохранитьРепозиторий("auditlib", "https://github.com/acme/auditlib-renamed", Кука);

	Записи = ДождатьсяЗаписейАудита("пакет.карточка.изменена", "team/auditlib");
	Ожидаем.Что(Записи.Количество(), "одна запись: повтор той же формы записи не дал").Равно(1);
	Запись = Записи[0];
	Ожидаем.Что(Запись, "автор").Содержит(СтрШаблон("""кто"":""%1""", ЛогинВладельца()));
	Ожидаем.Что(Запись, "было").Содержит("https://github.com/acme/auditlib""");
	Ожидаем.Что(Запись, "стало").Содержит("https://github.com/acme/auditlib-renamed");

КонецПроцедуры

#КонецОбласти

#Область ОпаснаяЗона

// У пакета с версиями необратимых действий нет — и раздела нет: ни в дереве, ни по адресу.
&Тест
Процедура УПакетаСВерсиямиОпаснойЗоныНет() Экспорт

	Опубликовать("versionedlib", "1.0.0", "https://github.com/acme/versionedlib");
	Кука = КукаВладельца();

	Карточка = Клиент.Тело(Клиент.GETСКукой(АдресРаздела("versionedlib", "card"), Кука));
	Ожидаем.Что(Карточка, "самотест: карточка отдана").Содержит("name=""репозиторий""");
	Ожидаем.Что(Карточка, "в дереве разделов опасной зоны нет")
		.Не_().Содержит(АдресРаздела("versionedlib", "danger"));

	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела("versionedlib", "danger"), Кука).КодСостояния,
		"по адресу раздела — 404").Равно(404);
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела("versionedlib", "danger"),
		ПоляУдаления(ТокенКарточки("versionedlib", Кука), "versionedlib"), Кука).КодСостояния,
		"и форма удаления — 404").Равно(404);
	Ожидаем.Что(Клиент.GET("/pools/team/packages/versionedlib").КодСостояния,
		"пакет на месте").Равно(200);

КонецПроцедуры

// Пакет без версий удаляется из опасной зоны после эха имени; без эха — остаётся.
&Тест
Процедура ПакетБезВерсийУдаляетсяИзОпаснойЗоныПоЭху() Экспорт

	Кука = КукаВладельца();
	ЗавестиПакетБезВерсий("emptylib", Кука);
	Адрес = АдресРаздела("emptylib", "danger");

	// поля — те, что отправит браузер: форма зоны целиком, вложенных форм нет
	Зона = Клиент.Тело(Клиент.GETСКукой(Адрес, Кука));
	Ожидаем.Что(ГлубинаВложенностиФорм(Зона), "форма опасной зоны не вложена в другую").Равно(1);
	Поля = Клиент.ПоляФормыСо(Зона, "name=""подтверждение""");
	Ожидаем.Что(Поля.Получить("операция"), "форма объявляет операцию").Равно("пакет-удалить");
	Ожидаем.Что(ЗначениеЗаполнено(Поля.Получить("_csrf")), "и несёт токен").ЭтоИстина();

	Поля.Вставить("подтверждение", "EmptyLib");
	Ответ = Клиент.POSTФормы(Адрес, Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "эхо не совпало — отказ").Равно(400);
	Ожидаем.Что(Клиент.Тело(Ответ), "отказ назван").Содержит("Подтверждение не совпало");
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела("emptylib", "card"), Кука).КодСостояния,
		"пакет на месте").Равно(200);

	Чужая = ПоляУдаления(Поля.Получить("_csrf"), "emptylib");
	Чужая.Вставить("операция", "пул-удалить");
	Ответ = Клиент.POSTФормы(Адрес, Чужая, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "операция не из белого списка — отказ").Равно(400);
	Ожидаем.Что(Клиент.Тело(Ответ), "отказ назван").Содержит("не назвала операцию");
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела("emptylib", "card"), Кука).КодСостояния,
		"пакет на месте").Равно(200);

	Поля.Вставить("подтверждение", "emptylib");
	Ответ = Клиент.POSTФормыБезПереходов(Адрес, Поля, Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "удалён — переход").Равно(302);
	Ожидаем.Что(Локейшн(Ответ), "на страницу пула").Равно("/pools/team");
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела("emptylib", "card"), Кука).КодСостояния,
		"настроек пакета больше нет").Равно(404);
	Ожидаем.Что(Клиент.GETСКукой("/pools/team/packages/emptylib", Кука).КодСостояния,
		"и страницы пакета").Равно(404);

КонецПроцедуры

// Удаление из опасной зоны уносит всё, что на пакет ссылалось: доверие конвейеру, подписку
// и роль. То же имя заводится заново чистым, а удаление видно в журнале аудита.
&Тест
Процедура УдалённыйИзОпаснойЗоныПакетНичегоНеОставляетСледующему() Экспорт

	Кука = КукаВладельца();
	Токен = Клиент.ВыпуститьPAT(Кука);
	Имя = "inheritlib";
	ЗавестиПакетБезВерсий(Имя, Кука);

	Доверие = Клиент.ЗапросJSONСТокеном("POST", АдресДоверия(Имя), ТелоДоверия("acme/inheritlib"), Токен);
	Ожидаем.Что(Доверие.КодСостояния, "КОНТРОЛЬ: пакету доверен конвейер: " + Клиент.Тело(Доверие))
		.Равно(201);
	Подписка = Клиент.ЗапросJSONСТокеном("POST", АдресПодписок(Имя),
		"{""тип"":""вебхук"",""url"":""https://hooks.example.org/inheritlib"",""события"":[""версия.опубликована""]}",
		Токен);
	Ожидаем.Что(Подписка.КодСостояния, "КОНТРОЛЬ: на пакет заведена подписка: " + Клиент.Тело(Подписка))
		.Равно(201);
	ВыдатьРоль(Имя, ЛогинЧужого());
	Ожидаем.Что(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(Имя, "access"), Кука)),
		"КОНТРОЛЬ: на пакет выдана роль").Содержит("<td>" + ЛогинЧужого() + "</td>");

	Ответ = Клиент.POSTФормыБезПереходов(АдресРаздела(Имя, "danger"),
		ПоляУдаления(ТокенКарточки(Имя, Кука), Имя), Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "удалён из опасной зоны").Равно(302);

	ЗавестиПакетБезВерсий(Имя, Кука);

	Доверия = Клиент.GETСТокеном(АдресДоверия(Имя), Токен);
	Ожидаем.Что(Доверия.КодСостояния, "КОНТРОЛЬ: доверие нового пакета читается").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Доверия).Получить("items").Количество(), "доверия прежнего нет").Равно(0);
	Подписки = Клиент.GETСТокеном(АдресПодписок(Имя), Токен);
	Ожидаем.Что(Подписки.КодСостояния, "КОНТРОЛЬ: подписки нового пакета читаются").Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(Подписки).Получить("total"), "подписок прежнего нет").Равно(0);
	Ожидаем.Что(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(Имя, "access"), Кука)), "роли прежнего нет")
		.Не_().Содержит("<td>" + ЛогинЧужого() + "</td>");

	Записи = ДождатьсяЗаписейАудита("пакет.удалён", "team/" + Имя);
	Ожидаем.Что(Записи.Количество(), "удаление записано в журнал аудита одной записью").Равно(1);
	Ожидаем.Что(Записи[0], "и называет, кто удалил")
		.Содержит(СтрШаблон("""кто"":""%1""", ЛогинВладельца()));

КонецПроцедуры

// Мейнтейнер пакета без роли на пуле пакет не удаляет — и опасной зоны не видит.
&Тест
Процедура МейнтейнерПакетаБезРолиНаПулеОпаснойЗоныНеВидит() Экспорт

	ЗавестиПакетБезВерсий("handedlib", КукаВладельца());
	ВыдатьРоль("handedlib", ЛогинЧужого());

	Кука = Клиент.Войти(ЛогинЧужого(), ПарольЧужого());
	Карточка = Клиент.Тело(Клиент.GETСКукой(АдресРаздела("handedlib", "card"), Кука));
	Ожидаем.Что(Карточка, "самотест: мейнтейнер пакета в настройки входит")
		.Содержит("name=""репозиторий""");
	Ожидаем.Что(Карточка, "опасной зоны в дереве нет").Не_().Содержит(АдресРаздела("handedlib", "danger"));
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела("handedlib", "danger"), Кука).КодСостояния,
		"по адресу — 404").Равно(404);
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела("handedlib", "danger"),
		ПоляУдаления(Клиент.ТокенCSRF(Карточка), "handedlib"), Кука).КодСостояния,
		"форма удаления — 404").Равно(404);
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела("handedlib", "card"), КукаВладельца()).КодСостояния,
		"пакет на месте").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция СохранитьРепозиторий(Знач Пакет, Знач Адрес, Знач Кука)
	Возврат Клиент.POSTФормы(АдресРаздела(Пакет, "card"),
		ПоляКарточки(ТокенКарточки(Пакет, Кука), Адрес), Кука);
КонецФункции

// Форма карточки целиком, как её шлёт браузер: правится только репозиторий.
Функция ПоляКарточки(Знач Токен, Знач Адрес)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("описание", "Описание");
	Поля.Вставить("ключевые_слова", "");
	Поля.Вставить("лицензия", "MIT");
	Поля.Вставить("репозиторий", Адрес);
	Возврат Поля;

КонецФункции

Функция ПоляУдаления(Знач Токен, Знач Эхо)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "пакет-удалить");
	Поля.Вставить("подтверждение", Эхо);
	Возврат Поля;

КонецФункции

Функция ТокенКарточки(Знач Пакет, Знач Кука)
	Возврат Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(Пакет, "card"), Кука)));
КонецФункции

// Значение поля так, как его покажет браузер: сущности разметки раскрыты.
Функция ЗначениеПоляРепозитория(Знач Пакет)

	Страница = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(Пакет, "card"), КукаВладельца()));
	Позиция = СтрНайти(Страница, "name=""репозиторий""");
	Ожидаем.Что(Позиция > 0, "поле репозитория напечатано").ЭтоИстина();
	Начало = СтрНайти(Страница, "<input", НаправлениеПоиска.СКонца, Позиция);
	Тег = Сред(Страница, Начало, СтрНайти(Сред(Страница, Начало), ">"));

	Метка = "value=""";
	ПозицияЗначения = СтрНайти(Тег, Метка);
	Если ПозицияЗначения = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Тег, ПозицияЗначения + СтрДлина(Метка));
	Значение = Лев(Хвост, СтрНайти(Хвост, """") - 1);
	Возврат СтрЗаменить(СтрЗаменить(Значение, "&#x2F;", "/"), "&amp;", "&");

КонецФункции

// og:image страницы пакета так, как её прочтёт краулер.
Функция Картинка(Знач Пакет)

	Страница = Клиент.Тело(Клиент.GET("/pools/team/packages/" + Пакет));
	Метка = "<meta property=""og:image"" content=""";
	Позиция = СтрНайти(Страница, Метка);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Страница, Позиция + СтрДлина(Метка));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

// Пакет без версий заводит мейнтейнер пула кнопкой «Добавить пакет» списка пакетов пула.
Процедура ЗавестиПакетБезВерсий(Знач Имя, Знач Кука)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/security", Кука))));
	Поля.Вставить("операция", "добавить");
	Поля.Вставить("имя", Имя);
	Ответ = Клиент.POSTФормыБезПереходов("/pools/team/packages", Поля, Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "пакет без версий заведён: " + Имя).Равно(302);
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела(Имя, "card"), Кука).КодСостояния,
		"самотест: настройки пакета открываются").Равно(200);

КонецПроцедуры

Процедура Опубликовать(Знач Пакет, Знач Версия, Знач Репозиторий)

	Манифест = ПакетыOspx.НовыйМанифест(Пакет, Версия).УстановитьАдресРепозитория(Репозиторий);
	Манифест.УстановитьОписание("Описание " + Пакет);

	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Клиент.Опубликовать("team", Новый ФикстураПакета().ПостроитьOspxПоМанифесту(Каталог, Манифест,
		"# " + Пакет), КлючАдмина);

КонецПроцедуры

// Наибольшая глубина вложенности <form>: 1 — вложенности нет.
Функция ГлубинаВложенностиФорм(Знач Разметка)

	Глубина = 0;
	Максимум = 0;
	Хвост = Разметка;
	Пока Истина Цикл
		Открывающий = СтрНайти(Хвост, "<form");
		Закрывающий = СтрНайти(Хвост, "</form>");
		Если Открывающий = 0 И Закрывающий = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Открывающий > 0 И (Закрывающий = 0 ИЛИ Открывающий < Закрывающий) Тогда
			Глубина = Глубина + 1;
			Максимум = Макс(Максимум, Глубина);
			Хвост = Сред(Хвост, Открывающий + 5);
		Иначе
			Глубина = Глубина - 1;
			Хвост = Сред(Хвост, Закрывающий + 7);
		КонецЕсли;
	КонецЦикла;
	Возврат Максимум;

КонецФункции

Функция АдресДоверия(Знач Имя)
	Возврат "/api/v1/pools/team/packages/" + Имя + "/trusted-workflows";
КонецФункции

Функция АдресПодписок(Знач Имя)
	Возврат "/api/v1/pools/team/packages/" + Имя + "/webhooks";
КонецФункции

Функция ТелоДоверия(Знач Репозиторий)
	Возврат СтрШаблон("{""провайдер"":""github"",""издатель"":""https://token.actions.githubusercontent.com"","
		+ """репозиторий"":""%1"",""реф"":""refs/heads/main""}", Репозиторий);
КонецФункции

Функция Локейшн(Знач Ответ)
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "LOCATION" Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция СколькоРаз(Знач Текст, Знач Фрагмент)
	Возврат (СтрДлина(Текст) - СтрДлина(СтрЗаменить(Текст, Фрагмент, ""))) / СтрДлина(Фрагмент);
КонецФункции

Функция АдресРаздела(Знач Пакет, Знач Раздел)
	Возврат СтрШаблон("/pools/team/packages/%1/settings/%2", Пакет, Раздел);
КонецФункции

Функция КукаВладельца()
	Возврат Клиент.Войти(ЛогинВладельца(), ПарольВладельца());
КонецФункции

Процедура ЗавестиУчётку(Знач Логин, Знач Пароль)
	Ответ = Клиент.POSTJSON("/api/v1/register", СтрШаблон(
		"{""логин"":""%1"",""email"":""%1@example.org"",""пароль"":""%2""}", Логин, Пароль));
	Ожидаем.Что(Ответ.КодСостояния, "учётка заведена: " + Логин + " " + Клиент.Тело(Ответ)).Равно(201);
КонецПроцедуры

// Роль мейнтейнера на пул команды, а с именем пакета — на пакет.
Процедура ВыдатьРоль(Знач Пакет, Знач Логин)
	Выдача = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools/team/grants", СтрШаблон(
		"{""тип_субъекта"":""пользователь"",""субъект"":""%1"",""роль"":""мейнтейнер""%2}",
			Логин, ?(ЗначениеЗаполнено(Пакет), ",""пакет"":""" + Пакет + """", "")), КлючАдмина);
	Ожидаем.Что(Выдача.КодСостояния, "роль выдана: " + Клиент.Тело(Выдача)).Равно(201);
КонецПроцедуры

// Приёмник пишет файл вслед за ответом: запись ждём, а не ловим мгновением.
Функция ДождатьсяЗаписейАудита(Знач Действие, Знач Объект)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Записи = ЗаписиАудита(Действие, Объект);
	Пока Записи.Количество() = 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(200);
		Записи = ЗаписиАудита(Действие, Объект);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Строки журнала аудита с действием над объектом: файл — единственный приёмник записи.
Функция ЗаписиАудита(Знач Действие, Знач Объект)

	Результат = Новый Массив();
	Путь = ОбъединитьПути(Хаб.КореньХранилища(), "аудит.log");
	Если НЕ Новый Файл(Путь).Существует() Тогда
		Возврат Результат;
	КонецЕсли;
	// хаб держит файл открытым на запись: читаем без монопольного захвата
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8", , , Ложь);
	Содержимое = Строка(Чтение.Прочитать());
	Чтение.Закрыть();

	Для Каждого Строка_ Из СтрРазделить(Содержимое, Символы.ПС, Ложь) Цикл
		Если СтрНайти(Строка_, """действие"":""" + Действие + """") > 0
			И СтрНайти(Строка_, """объект"":""" + Объект + """") > 0 Тогда
			Результат.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция АдресХаба()
	Возврат "https://hub.example.ru";
КонецФункции

