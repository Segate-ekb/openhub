// README из репозитория на живом хабе: opm push без README в пакете, GitHub — стенд сырого содержимого
// на своём порту; публикация и страница его не ждут, найденное видно на странице и в GET …/readme.

#Использовать asserts
#Использовать ospx-tools
#Использовать "../../фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем GitHub;          // фикстура СтендGitHubНаПорту — сырое содержимое репозиториев
Перем КлючАдмина;      // Строка — ключ доступа администратора хаба
Перем КореньДанных;    // Строка — временный каталог стенда: в нём собираются .ospx

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("СтендGitHubНаПорту");

	GitHub = Новый СтендGitHubНаПорту();
	АдресСодержимого = GitHub.Слушать();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);

	КореньДанных = Хаб.ФайловаяБаза("openhub-readme-repo");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", ЛогинАдмина());
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_README_REPOSITORY_ENABLED", "true");
	Хаб.Среда("OSHUB_README_REPOSITORY_RAW_URL", АдресСодержимого);

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	Сессия = Клиент.Кука(Клиент.Войти(ЛогинАдмина(), ПарольАдмина()));
	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""права"":""read,write""}", Сессия);
	Ожидаем.Что(Ответ.КодСостояния, "ключ администратора выпущен: " + Клиент.Тело(Ответ)).Равно(201);
	КлючАдмина = Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""name"":""%1"",""visibility"":""public""}", ИмяПула()), КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	Если GitHub <> Неопределено Тогда
		GitHub.Остановить();
	КонецЕсли;
КонецПроцедуры

// Ради чего всё: в пакете README нет, на теге версии в репозитории — есть. Ответ на push и страница
// GitHub не ждут: стенд ещё никому не ответил, а версия принята и страница показана без README.
// Обслужил стенд фон — страница и машинный адрес показывают README и называют тег ссылкой на файл.
&Тест
Процедура READMEИзРепозиторияПриходитФономИНазываетТег() Экспорт

	GitHub.Положить("acme/readme-tag/v1.0.0/README.md", "# МаркерРепозитория");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Опубликовать("readme-tag", "1.0.0", "https://github.com/acme/readme-tag", Неопределено);
	Ожидаем.Что(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало,
		"ответ push не ждал GitHub: его запрос ещё стоит в очереди стенда").Меньше(12000);

	До = Клиент.Тело(Клиент.GET(АдресСтраницы("readme-tag")));
	Ожидаем.Что(До, "страница показана, пока GitHub молчит, — как без README").Содержит("У этой версии нет README");

	Ожидаем.Что(GitHub.Обслужить(1, 30), "фон пришёл за README на тег версии").Равно(1);
	Ожидаем.Что(GitHub.Пути()[0], "первым спрошен тег v<версия>").Равно("/acme/readme-tag/v1.0.0/README.md");

	Ответ = ДождатьсяREADME("readme-tag");
	Источник = Ответ.Получить("source");
	Ожидаем.Что(Ответ.Получить("html"), "README из репозитория отдан").Содержит("МаркерРепозитория");
	Ожидаем.Что(Источник.Получить("from"), "источник — репозиторий").Равно("repository");
	Ожидаем.Что(Источник.Получить("ref_kind"), "с тега").Равно("tag");
	Ожидаем.Что(Источник.Получить("ref")).Равно("v1.0.0");
	Ожидаем.Что(Источник.Получить("url")).Равно("https://github.com/acme/readme-tag/blob/v1.0.0/README.md");

	Страница = Клиент.Тело(Клиент.GET(АдресСтраницы("readme-tag")));
	Ожидаем.Что(Страница, "страница показывает README").Содержит("МаркерРепозитория");
	Ожидаем.Что(Страница, "и называет тег").Содержит("с тега v1.0.0");
	Ожидаем.Что(Страница, "ссылкой на файл на GitHub")
		.Содержит("href=""https://github.com/acme/readme-tag/blob/v1.0.0/README.md""");

КонецПроцедуры

// Тега нет — README из ветки по умолчанию, и страница так и говорит, ссылкой на файл в ветке.
&Тест
Процедура READMEИзВеткиПоУмолчаниюНазываетВетку() Экспорт

	GitHub.Положить("acme/readme-branch/HEAD/README.md", "# МаркерВетки");
	Опубликовать("readme-branch", "1.0.0", "https://github.com/acme/readme-branch", Неопределено);

	Ожидаем.Что(GitHub.Обслужить(7, 60), "два тега по три записи имени, затем ветка").Равно(7);

	Ответ = ДождатьсяREADME("readme-branch");
	Ожидаем.Что(Ответ.Получить("source").Получить("ref_kind"), "из ветки").Равно("default_branch");

	Страница = Клиент.Тело(Клиент.GET(АдресСтраницы("readme-branch")));
	Ожидаем.Что(Страница, "страница показывает README").Содержит("МаркерВетки");
	Ожидаем.Что(Страница, "и называет ветку").Содержит("из ветки по умолчанию");
	Ожидаем.Что(Страница, "ссылкой на файл в ветке")
		.Содержит("href=""https://github.com/acme/readme-branch/blob/HEAD/README.md""");

КонецПроцедуры

// README в пакете есть — в репозиторий не ходят, источник — пакет.
&Тест
Процедура READMEИзПакетаНазываетПакетИВРепозиторийНеВедёт() Экспорт

	GitHub.Положить("acme/readme-own/v1.0.0/README.md", "# Не тот");
	Опубликовать("readme-own", "1.0.0", "https://github.com/acme/readme-own", "# МаркерПакета");

	Ожидаем.Что(GitHub.Обслужить(1, 3), "в репозиторий не ходили").Равно(0);

	Ответ = READMEАдресом("readme-own");
	Ожидаем.Что(Ответ.Получить("html")).Содержит("МаркерПакета");
	Ожидаем.Что(Ответ.Получить("source").Получить("from"), "источник — пакет").Равно("package");

КонецПроцедуры

// README нет нигде — адрес отдаёт «README нет» и пустой источник.
&Тест
Процедура БезREADMEИсточникаНет() Экспорт

	Опубликовать("readme-none", "1.0.0", "https://example.org/acme/readme-none", Неопределено);

	Ответ = READMEАдресом("readme-none");
	Ожидаем.Что(Ответ.Получить("has_readme")).ЭтоЛожь();
	Ожидаем.Что(Ответ.Получить("source"), "источника нет").Равно(Неопределено);

	// README может прийти из репозитория позже: «README нет» у названной версии навсегда не кэшируется
	Ожидаем.Что(КэшНазваннойВерсии("readme-none", "1.0.0"), "ответ без README не неизменяем")
		.ЭтоНе().Содержит("immutable");

КонецПроцедуры

// Контроль к предыдущему: README названной версии кэшируется как неизменяемый.
&Тест
Процедура READMEНазваннойВерсииНеизменяем() Экспорт

	Опубликовать("readme-cached", "1.0.0", "https://example.org/acme/readme-cached", "# Кэш");
	Ожидаем.Что(КэшНазваннойВерсии("readme-cached", "1.0.0"), "README названной версии неизменяем")
		.Содержит("immutable");

КонецПроцедуры

#Область Помощники

// ТекстREADME Неопределено — в пакете README нет вовсе.
Процедура Опубликовать(Знач Пакет, Знач Версия, Знач АдресРепозитория, Знач ТекстREADME)

	Манифест = ПакетыOspx.НовыйМанифест(Пакет, Версия).УстановитьАдресРепозитория(АдресРепозитория);
	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Клиент.Опубликовать(ИмяПула(), Новый ФикстураПакета().ПостроитьOspxПоМанифесту(Каталог, Манифест, ТекстREADME),
		КлючАдмина);

КонецПроцедуры

// Фон пишет описание за мгновение после ответа стенда; страница его не ждёт, а тест ждёт.
Функция ДождатьсяREADME(Знач Пакет)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000;
	Ответ = READMEАдресом(Пакет);
	Пока НЕ Ответ.Получить("has_readme") И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(200);
		Ответ = READMEАдресом(Пакет);
	КонецЦикла;

	Ожидаем.Что(Ответ.Получить("has_readme"), "README из репозитория лёг описанием версии").ЭтоИстина();
	Возврат Ответ;

КонецФункции

Функция READMEАдресом(Знач Пакет)
	Ответ = Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2/readme", ИмяПула(), Пакет));
	Ожидаем.Что(Ответ.КодСостояния, "адрес README ответил: " + Клиент.Тело(Ответ)).Равно(200);
	Возврат Клиент.ТелоJSON(Ответ);
КонецФункции

Функция КэшНазваннойВерсии(Знач Пакет, Знач Версия)
	Ответ = Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2/readme?version=%3", ИмяПула(), Пакет, Версия));
	Ожидаем.Что(Ответ.КодСостояния, "адрес README версии ответил: " + Клиент.Тело(Ответ)).Равно(200);
	Для Каждого Заголовок Из Ответ.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "cache-control" Тогда
			Возврат Строка(Заголовок.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция АдресСтраницы(Знач Пакет)
	Возврат СтрШаблон("/pools/%1/packages/%2", ИмяПула(), Пакет);
КонецФункции

Функция ИмяПула()
	Возврат "readme-repo";
КонецФункции

Функция ЛогинАдмина()
	Возврат "readme-admin";
КонецФункции

Функция ПарольАдмина()
	Возврат "ReadmeAdminPass1";
КонецФункции

#КонецОбласти
