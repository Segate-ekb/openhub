// Юнит-тесты валидатора адреса вебхука. Две несмешиваемые темы:
// 1) РАЗБОР присланной строки — схема, userinfo, управляющие символы: только это и отвергается;
// 2) движок КАНОНИЗАЦИИ (ХостПриватный) — формы IP-литералов и DNS через фейк-резолвер;
//    вебхуку он больше не судья, его спрашивают валидаторы апстрима и провайдера входа.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогКлассов;
Перем КаталогФикстур;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "подписки", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "..", ".."),
		"основа", "Классы"), "РазборАдреса");
	ПоискКлассов.Подключить(КаталогКлассов, "ВалидаторАдресаВебхука");
	Подключить(ОбъединитьПути(КаталогФикстур, "ФейкРазрешительImён.os"), "ФейкРазрешительImён");
	Подключить(ОбъединитьПути(КаталогФикстур, "НастройкиЗаглушка.os"), "НастройкиЗаглушка");
КонецПроцедуры

&Тест
Процедура ПубличныйHTTPSДопустим() Экспорт
	Вердикт = ПоУмолчанию().Проверить("https://example.com/hooks/1");
	Ожидаем.Что(Вердикт.Ок, "публичный https допустим: " + Вердикт.Ошибка).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПубличныйХостСПортомДопустим() Экспорт
	Вердикт = ПоУмолчанию().Проверить("https://hooks.example.com:8443/path?x=1");
	Ожидаем.Что(Вердикт.Ок, "https с портом и query допустим").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПубличныйIPv4Допустим() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("https://8.8.8.8/hook").Ок, "публичный IPv4 допустим").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура УправляющиеСимволыИПробелыОтклонены() Экспорт

	// Из формы адрес приходит уже раскодированным: %0D%0A доходит настоящими CR/LF и рвал строку журнала.
	Валидатор = ПоУмолчанию();

	CRLF = "https://crlf.example.com/a" + Символы.ВК + Символы.ПС + "X-Evil: 1";
	Ожидаем.Что(Валидатор.Проверить(CRLF).Ок, "CR/LF в адресе отклонены").ЭтоЛожь();
	Ожидаем.Что(Валидатор.Проверить("https://sp.example.com/a b").Ок, "пробел в адресе отклонён").ЭтоЛожь();
	Ожидаем.Что(Валидатор.Проверить("https://tab.example.com/a" + Символы.Таб + "b").Ок,
		"табуляция в адресе отклонена").ЭтоЛожь();

	Причина = Валидатор.Проверить(CRLF).Ошибка;
	Ожидаем.Что(Найти(Причина, Символы.ПС), "перевод строки не попал в текст отказа").Равно(0);

	Ожидаем.Что(Валидатор.Проверить("https://ok.example.com/a%0D%0Ab").Ок,
		"закодированные CR/LF допустимы").ЭтоИстина();
	Ожидаем.Что(Валидатор.Проверить("https://ok.example.com/a%20b").Ок,
		"закодированный пробел допустим").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура HTTPПоУмолчаниюЗапрещён() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("http://example.com/hook").Ок, "http по умолчанию запрещён").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура HTTPРазрешёнПриAllowInsecure() Экспорт
	Валидатор = Новый ВалидаторАдресаВебхука(Резолвер(), НастройкиПодписок(Истина));
	Ожидаем.Что(Валидатор.Проверить("http://example.com/hook").Ок, "http допустим при allow_insecure").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ЧужаяСхемаЗапрещена() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("ftp://example.com/x").Ок, "ftp запрещён").ЭтоЛожь();
	Ожидаем.Что(ПоУмолчанию().Проверить("file:///etc/passwd").Ок, "file запрещён").ЭтоЛожь();
	Ожидаем.Что(ПоУмолчанию().Проверить("example.com/x").Ок, "без схемы запрещён").ЭтоЛожь();
КонецПроцедуры

// НФТ-ПОДП-002: куда идёт уведомление, решает человек. Порог требования — НОЛЬ адресов,
// отвергнутых по признаку сети назначения, поэтому вектора, которыми прежде закрывался
// запрет приватных целей, здесь проверяются С ОБРАТНЫМ знаком: все они проходят.
&Тест
Процедура ЦельВоВнутреннейСетиПринимается() Экспорт

	В = ПоУмолчанию();
	Цели = "https://localhost/hook,https://foo.localhost/hook,https://127.0.0.1/x,"
		+ "https://10.1.2.3/x,https://192.168.0.5/x,https://172.16.0.1/x,https://100.64.0.1/x,"
		+ "https://169.254.169.254/latest/meta-data/,https://2852039166/latest/,"
		+ "https://0xA9FEA9FE/x,https://0177.0.0.1/x,https://127.1/x,"
		+ "https://[::1]/x,https://[fe80::1]/x,https://[fc00::1]/x,"
		+ "https://[::ffff:127.0.0.1]/x,https://[64:ff9b::7f00:1]/x,https://[::ffff:0:0]/x";

	Отвергнутые = Новый Массив();
	Для Каждого Цель Из СтрРазделить(Цели, ",") Цикл
		Вердикт = В.Проверить(Цель);
		Если НЕ Вердикт.Ок Тогда
			Отвергнутые.Добавить(Цель + " — " + Вердикт.Ошибка);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отвергнутые, Символы.ПС),
		"ни один адрес не отвергается по признаку сети назначения").Равно("");

КонецПроцедуры

// Порт на петле — обычный случай стенда: приёмник поднят рядом с хабом.
&Тест
Процедура ЦельНаLocalhostСПортомПринимается() Экспорт
	Валидатор = Новый ВалидаторАдресаВебхука(Резолвер(), НастройкиПодписок(Истина));
	Ожидаем.Что(Валидатор.Проверить("http://localhost:9000/hook").Ок,
		"приёмник на петле с портом — законная цель").ЭтоИстина();
КонецПроцедуры

// Имя внутренней зоны хаб не резолвит и не судит: резолвер на пути проверки адреса
// не зовётся вовсе.
&Тест
Процедура ИмяРезолвящеесяВПриватныйПринимается() Экспорт

	Рез = Новый ФейкРазрешительImён();
	Рез.ЗадатьПриватный("internal.corp", "169.254.169.254");
	В = Новый ВалидаторАдресаВебхука(Рез, НастройкиПодписок(Ложь));

	Ожидаем.Что(В.Проверить("https://internal.corp/steal").Ок,
		"имя внутренней зоны — законная цель").ЭтоИстина();
	Ожидаем.Что(Рез.КоличествоЗапросов(),
		"резолв имени на проверке адреса не выполняется вовсе").Равно(0);

КонецПроцедуры

&Тест
Процедура ПубличныеЦелиПринимаются() Экспорт
	В = ПоУмолчанию();
	Ожидаем.Что(В.Проверить("https://[2606:4700:4700::1111]/x").Ок, "публичный IPv6").ЭтоИстина();
	Ожидаем.Что(В.Проверить("https://unknown.example.com/hook").Ок, "неизвестное имя").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура UserinfoЗапрещён() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("https://user@evil.example.com/x").Ок, "userinfo запрещён").ЭтоЛожь();
КонецПроцедуры

// --- движок канонизации: вебхуку он не судья, но им судят апстрим и провайдера входа ---

&Тест
Процедура ДвижокУзнаётПриватныйХостВЛюбойФорме() Экспорт

	В = ПоУмолчанию();
	Формы = "localhost,foo.localhost,127.0.0.1,10.1.2.3,192.168.0.5,172.16.0.1,172.31.255.255,"
		+ "100.64.0.1,169.254.169.254,2852039166,0xA9FEA9FE,0x7f000001,0177.0.0.1,127.1,10.1,"
		+ "::1,::,fe80::1,fc00::1,fd12:3456::1,::ffff:127.0.0.1,::ffff:10.0.0.1,::ffff:a9fe:a9fe,"
		+ "0:0:0:0:0:ffff:a9fe:a9fe,::ffff:0:0,::ffff:0:1,64:ff9b::a9fe:a9fe,64:ff9b::7f00:1";

	Пропущенные = Новый Массив();
	Для Каждого Хост Из СтрРазделить(Формы, ",") Цикл
		Если НЕ В.ХостПриватный(Хост) Тогда
			Пропущенные.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "),
		"движок канонизации не признал приватными").Равно("");

КонецПроцедуры

&Тест
Процедура ДвижокНеСчитаетПриватнымПубличный() Экспорт

	В = ПоУмолчанию();
	Формы = "8.8.8.8,172.15.0.1,example.com,2606:4700:4700::1111,::ffff:8.8.8.8,64:ff9b::8080:8080";

	Ложные = Новый Массив();
	Для Каждого Хост Из СтрРазделить(Формы, ",") Цикл
		Если В.ХостПриватный(Хост) Тогда
			Ложные.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Ложные, ", "), "движок канонизации ошибся на публичных").Равно("");

КонецПроцедуры

&Тест
Процедура ДвижокСудитИмяПоРезультатуРезолва() Экспорт

	Рез = Новый ФейкРазрешительImён();
	Рез.ЗадатьПриватный("internal.evil.com", "169.254.169.254");
	Смешанные = Новый Массив();
	Смешанные.Добавить("93.184.216.34");
	Смешанные.Добавить("10.0.0.5");
	Рез.ЗадатьАдреса("mixed.example.com", Смешанные);
	Публичные = Новый Массив();
	Публичные.Добавить("93.184.216.34");
	Рез.ЗадатьАдреса("good.example.com", Публичные);
	В = Новый ВалидаторАдресаВебхука(Рез, НастройкиПодписок(Ложь));

	Ожидаем.Что(В.ХостПриватный("internal.evil.com"), "имя в метаданные — приватное").ЭтоИстина();
	Ожидаем.Что(В.ХостПриватный("mixed.example.com"), "любой приватный A делает имя приватным").ЭтоИстина();
	Ожидаем.Что(В.ХостПриватный("good.example.com"), "имя в публичный IP — не приватное").ЭтоЛожь();
	Ожидаем.Что(В.ХостПриватный("unknown.example.com"), "нерезолвящееся имя приватным не числится").ЭтоЛожь();

КонецПроцедуры

// Скрипт резолва лежал в общем временном каталоге под ПОСТОЯННЫМ именем: два хаба на одной
// машине (соседние прогоны, blue/green на одном хосте) затирали файл друг у друга ровно
// тогда, когда python3 его читал, и резолв молча отдавал пустой список — SSRF-гейт при этом
// открывается (fail-open). Проверяется САМО имя: два подряд идущих резолва обязаны взять
// разные пути. Уборка за собой — отдельное, более слабое требование, и одной ею постоянное
// имя не ловится.
&Тест
Процедура ИмяСкриптаРезолваСвоёНаКаждыйВызов() Экспорт

	ПодключитьРезолвер();

	Песочница = НоваяПесочницаTMPDIR();
	Прежний = ПолучитьПеременнуюСреды("TMPDIR");

	Попытка
		УстановитьПеременнуюСреды("TMPDIR", Песочница);
		Резолвер = Новый РазрешительImёнСистемный();

		Адреса = Резолвер.Разрешить("localhost");
		Первый = Резолвер.ПутьСкриптаПоследнегоРезолва();

		Резолвер.Разрешить("localhost");
		Второй = Резолвер.ПутьСкриптаПоследнегоРезолва();

		Остаток = ИменаФайлов(Песочница);
	Исключение
		УстановитьПеременнуюСреды("TMPDIR", Прежний);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПеременнуюСреды("TMPDIR", Прежний);
	УдалитьФайлы(Песочница);

	Ожидаем.Что(ЗначениеЗаполнено(Первый), "путь скрипта виден снаружи — иначе проверять нечего")
		.ЭтоИстина();
	Ожидаем.Что(Первый = Второй,
		СтрШаблон("два резолва взяли ОДИН путь скрипта (%1): общее имя во временном каталоге"
			+ " перезапишет соседний хаб ровно на чтении интерпретатором", Первый)).ЭтоЛожь();

	Ожидаем.Что(СтрСоединить(Остаток, ", "),
		"резолвер оставил за собой файлы во временном каталоге").Равно("");

	// Песочница с пробелом в имени: без кавычек вокруг путей команда разваливается и резолв
	// отдаёт Неопределено. Наличие python3 спрашивается отдельно — иначе «резолв недоступен»
	// прятало бы поломку под законный исход окружения без интерпретатора.
	Если НЕ ЕстьPython3() Тогда
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Адреса <> Неопределено,
		"python3 в окружении есть, а резолв недоступен: пути в команде обязаны быть"
		+ " в кавычках — временный каталог содержит пробел").ЭтоИстина();
	Ожидаем.Что(Адреса.Количество() > 0, "localhost разрешился хотя бы в один адрес").ЭтоИстина();
	Ожидаем.Что(Адреса.Найти("127.0.0.1") <> Неопределено ИЛИ Адреса.Найти("::1") <> Неопределено,
		"среди адресов localhost есть петля: " + СтрСоединить(Адреса, ", ")).ЭтоИстина();

КонецПроцедуры

// Резолвер создаётся напрямую (`Новый`) — лог инъекцией в поле до него не доезжает.
// Любой сбой резолва обязан стать Неопределено, а не улететь наружу: наружу он приходит
// в ПроверитьХост, то есть валит проверку адреса целиком.
&Тест
Процедура СбойРезолваНеЛетитНаружуБезИнъекцииЛога() Экспорт

	ПодключитьРезолвер();

	// каталог заведомо не существует — запись скрипта сорвётся внутри резолва
	Несуществующий = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-нет-каталога-" + Строка(Новый УникальныйИдентификатор));
	Прежний = ПолучитьПеременнуюСреды("TMPDIR");

	Попытка
		УстановитьПеременнуюСреды("TMPDIR", Несуществующий);
		Резолвер = Новый РазрешительImёнСистемный();
		Результат = Резолвер.Разрешить("localhost");
	Исключение
		УстановитьПеременнуюСреды("TMPDIR", Прежний);
		ВызватьИсключение СтрШаблон(
			"сбой резолва улетел наружу вместо Неопределено: %1", ОписаниеОшибки());
	КонецПопытки;

	УстановитьПеременнуюСреды("TMPDIR", Прежний);

	Ожидаем.Что(Результат, "недоступный резолв — Неопределено, а не исключение").Равно(Неопределено);

КонецПроцедуры

// Недоступный резолв — это выключенный SSRF-гейт по адресу, и молчать о нём нельзя:
// оператор иначе никогда не узнает, что имена перестали проверяться.
&Тест
Процедура НедоступныйРезолвПишетПредупреждениеВЖурнал() Экспорт

	ПодключитьРезолвер();
	Подключить(ОбъединитьПути(КаталогФикстур, "ЛовушкаЛога.os"), "ЛовушкаЛога");

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.webhooks.резолв");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Несуществующий = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-нет-каталога-" + Строка(Новый УникальныйИдентификатор));
	Прежний = ПолучитьПеременнуюСреды("TMPDIR");

	Попытка
		УстановитьПеременнуюСреды("TMPDIR", Несуществующий);
		Резолвер = Новый РазрешительImёнСистемный(, , , Лог);
		Резолвер.Разрешить("localtest.me");
	Исключение
		УстановитьПеременнуюСреды("TMPDIR", Прежний);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПеременнуюСреды("TMPDIR", Прежний);

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "localtest.me") > 0,
		"в журнале названо имя, для которого резолв не отработал: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "не проверен") > 0
			ИЛИ СтрНайти(Ловушка.Всё(), "сорвался") > 0,
		"сказано, что адрес по результату разрешения имени не проверен: " + Ловушка.Всё())
		.ЭтоИстина();

КонецПроцедуры

Процедура ПодключитьРезолвер()

	КлассыОбщие = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогКлассов, "..", "..")).ПолноеИмя,
		"основа", "Классы");
	Подключить(ОбъединитьПути(КлассыОбщие, "ПриведениеЧисел.os"), "ПриведениеЧисел");
	Подключить(ОбъединитьПути(КлассыОбщие, "ПриведениеФлагов.os"), "ПриведениеФлагов");
	Подключить(ОбъединитьПути(КлассыОбщие, "РазборАдреса.os"), "РазборАдреса");
	ПоискКлассов.Подключить(КаталогКлассов, "РазрешительImёнСистемный");

КонецПроцедуры

Функция ЕстьPython3()

	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение("/bin/sh -c ""command -v python3 >/dev/null 2>&1""", , Истина, КодВозврата);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат КодВозврата = 0;

КонецФункции

// Пробел в имени намеренный: временный каталог пользователя может его содержать.
Функция НоваяПесочницаTMPDIR()

	Песочница = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub резолв " + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Песочница);
	Возврат Песочница;

КонецФункции

Функция ИменаФайлов(Знач Каталог)

	Результат = Новый Массив();
	Для Каждого Найденный Из НайтиФайлы(Каталог, "*") Цикл
		Результат.Добавить(Найденный.Имя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПоУмолчанию()
	Возврат Новый ВалидаторАдресаВебхука(Резолвер(), НастройкиПодписок(Ложь));
КонецФункции

Функция Резолвер()
	Возврат Новый ФейкРазрешительImён();
КонецФункции

Процедура Подключить(Знач Путь, Знач Имя)
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Настройки подписок для валидатора: единственное, что он у них спрашивает, — допускать ли http.
Функция НастройкиПодписок(Знач РазрешитьHTTP)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки(Истина, 5, 10, 10000, РазрешитьHTTP);
	Возврат Настройки;
КонецФункции
