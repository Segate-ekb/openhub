// Юнит-тесты валидатора адреса вебхука. Тема одна — ФОРМА присланной строки: схема,
// userinfo, управляющие символы, непустой хост; только это и отвергается. Сеть назначения
// вебхука не судится вовсе: куда слать, решает человек (НФТ-ПОДП-002), а разрешитель имён
// и политика своей сети живут в модуле «сеть» и проверяются СвояСеть_Тесты.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогКлассов;
Перем КаталогФикстур;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "подписки", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьОснову(ОбъединитьПути(КаталогКлассов, "..", ".."));
	ПоискКлассов.Подключить(КаталогКлассов, "ВалидаторАдресаВебхука");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "НастройкиЗаглушка.os"));
КонецПроцедуры

&Тест
Процедура ПубличныйHTTPSДопустим() Экспорт
	Вердикт = ПоУмолчанию().Проверить("https://example.com/hooks/1");
	Ожидаем.Что(Вердикт.Успех, "публичный https допустим: " + Вердикт.Сообщение).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПубличныйХостСПортомДопустим() Экспорт
	Вердикт = ПоУмолчанию().Проверить("https://hooks.example.com:8443/path?x=1");
	Ожидаем.Что(Вердикт.Успех, "https с портом и query допустим").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПубличныйIPv4Допустим() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("https://8.8.8.8/hook").Успех, "публичный IPv4 допустим").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура УправляющиеСимволыИПробелыОтклонены() Экспорт

	// Из формы адрес приходит уже раскодированным: %0D%0A доходит настоящими CR/LF и рвал строку журнала.
	Валидатор = ПоУмолчанию();

	CRLF = "https://crlf.example.com/a" + Символы.ВК + Символы.ПС + "X-Evil: 1";
	Ожидаем.Что(Валидатор.Проверить(CRLF).Успех, "CR/LF в адресе отклонены").ЭтоЛожь();
	Ожидаем.Что(Валидатор.Проверить("https://sp.example.com/a b").Успех, "пробел в адресе отклонён").ЭтоЛожь();
	Ожидаем.Что(Валидатор.Проверить("https://tab.example.com/a" + Символы.Таб + "b").Успех,
		"табуляция в адресе отклонена").ЭтоЛожь();

	Причина = Валидатор.Проверить(CRLF).Сообщение;
	Ожидаем.Что(Найти(Причина, Символы.ПС), "перевод строки не попал в текст отказа").Равно(0);

	Ожидаем.Что(Валидатор.Проверить("https://ok.example.com/a%0D%0Ab").Успех,
		"закодированные CR/LF допустимы").ЭтоИстина();
	Ожидаем.Что(Валидатор.Проверить("https://ok.example.com/a%20b").Успех,
		"закодированный пробел допустим").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура HTTPПоУмолчаниюЗапрещён() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("http://example.com/hook").Успех, "http по умолчанию запрещён").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура HTTPРазрешёнПриAllowInsecure() Экспорт
	Валидатор = Новый ВалидаторАдресаВебхука(НастройкиПодписок(Истина));
	Ожидаем.Что(Валидатор.Проверить("http://example.com/hook").Успех, "http допустим при allow_insecure").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ЧужаяСхемаЗапрещена() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("ftp://example.com/x").Успех, "ftp запрещён").ЭтоЛожь();
	Ожидаем.Что(ПоУмолчанию().Проверить("file:///etc/passwd").Успех, "file запрещён").ЭтоЛожь();
	Ожидаем.Что(ПоУмолчанию().Проверить("example.com/x").Успех, "без схемы запрещён").ЭтоЛожь();
КонецПроцедуры

// НФТ-ПОДП-002: куда идёт уведомление, решает человек. Порог требования — НОЛЬ адресов,
// отвергнутых по признаку сети назначения, поэтому вектора, которыми прежде закрывался
// запрет приватных целей, здесь проверяются С ОБРАТНЫМ знаком: все они проходят.
&Тест
Процедура ЦельВоВнутреннейСетиПринимается() Экспорт

	В = ПоУмолчанию();
	Цели = "https://localhost/hook,https://foo.localhost/hook,https://127.0.0.1/x,"
		+ "https://10.1.2.3/x,https://192.168.0.5/x,https://172.16.0.1/x,https://100.64.0.1/x,"
		+ "https://169.254.169.254/latest/meta-data/,https://2852039166/latest/,"
		+ "https://0xA9FEA9FE/x,https://0177.0.0.1/x,https://127.1/x,"
		+ "https://[::1]/x,https://[fe80::1]/x,https://[fc00::1]/x,"
		+ "https://[::ffff:127.0.0.1]/x,https://[64:ff9b::7f00:1]/x,https://[::ffff:0:0]/x";

	Отвергнутые = Новый Массив();
	Для Каждого Цель Из СтрРазделить(Цели, ",") Цикл
		Вердикт = В.Проверить(Цель);
		Если НЕ Вердикт.Успех Тогда
			Отвергнутые.Добавить(Цель + " — " + Вердикт.Сообщение);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отвергнутые, Символы.ПС),
		"ни один адрес не отвергается по признаку сети назначения").Равно("");

КонецПроцедуры

// Порт на петле — обычный случай стенда: приёмник поднят рядом с хабом.
&Тест
Процедура ЦельНаLocalhostСПортомПринимается() Экспорт
	Валидатор = Новый ВалидаторАдресаВебхука(НастройкиПодписок(Истина));
	Ожидаем.Что(Валидатор.Проверить("http://localhost:9000/hook").Успех,
		"приёмник на петле с портом — законная цель").ЭтоИстина();
КонецПроцедуры

// Имя внутренней зоны хаб не резолвит и не судит: разрешителя имён у валидатора нет вовсе.
&Тест
Процедура ИмяРезолвящеесяВПриватныйПринимается() Экспорт

	Ожидаем.Что(ПоУмолчанию().Проверить("https://internal.corp/steal").Успех,
		"имя внутренней зоны — законная цель").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПубличныеЦелиПринимаются() Экспорт
	В = ПоУмолчанию();
	Ожидаем.Что(В.Проверить("https://[2606:4700:4700::1111]/x").Успех, "публичный IPv6").ЭтоИстина();
	Ожидаем.Что(В.Проверить("https://unknown.example.com/hook").Успех, "неизвестное имя").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура UserinfoЗапрещён() Экспорт
	Ожидаем.Что(ПоУмолчанию().Проверить("https://user@evil.example.com/x").Успех, "userinfo запрещён").ЭтоЛожь();
КонецПроцедуры

Функция ПоУмолчанию()
	Возврат Новый ВалидаторАдресаВебхука(НастройкиПодписок(Ложь));
КонецФункции

// Настройки подписок для валидатора: единственное, что он у них спрашивает, — допускать ли http.
Функция НастройкиПодписок(Знач РазрешитьHTTP)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки(Истина, 5, 10, 10000, РазрешитьHTTP);
	Возврат Настройки;
КонецФункции
