// Дефекты чужих библиотек — список к разбору, а не сторожа. Каждый тест ПРОПУЩЕН
// безусловным &ВключенЕсли: он описывает поведение чужой библиотеки, пишется против неё
// напрямую (не через наши обёртки) и позеленеет только когда апстрим починит дефект.
// Причина пропуска называет библиотеку с версией, симптом, взгляд пользователя хаба и issue.
// Тела не исполняются: набор не поднимает контейнер, не ходит в сеть, не создаёт файлов.

#Использовать asserts
#Использовать entity
#Использовать semver

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьПробу() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ФайлПробы = ОбъединитьПути(КаталогТестов, "фикстуры", "СтрокаПробыДефекта.os");
	// `ТипЗарегистрирован` в этом наборе недоступен (он приходит с ОСенью, а контейнер
	// здесь не поднимается), поэтому повторное подключение гасится Попыткой: имя уже
	// зарегистрировано в процессе — подключать нечего.
	Попытка
		ПодключитьСценарий(ФайлПробы, "СтрокаПробыДефекта");
	Исключение
		// уже подключено этим процессом — допустимо
	КонецПопытки;

КонецПроцедуры

#Область Entity

// Корень: флаг ЭтоВставкаОбъекта при &ГенерируемоеЗначение истинен ВСЕГДА, а
// ИДПоследнейДобавленнойЗаписи у PostgreSQL реализована через SELECT max(id), а не RETURNING.
// Специфично для PostgreSQL: SQLite берёт last_insert_rowid(), InMemory и JSON пишут id только пустым.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1: КоннекторPostgreSQL.Сохранить кладёт в Идентификатор объекта max(id) таблицы, и обновление уводит сущность на чужую строку; пользователь хаба видит это как переставленный канал обновлений ЧУЖОГО пакета и как выданные не тому права на приватный пул; черновик issue готов — issues/ЧЕРНОВИК-ENTITY-порча-идентификатора.md")
Процедура EntityНеУводитИдентификаторНаМаксимумТаблицы() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	Первая = ВставитьПробу(Хранилище, "первая");
	Последняя = ВставитьПробу(Хранилище, "последняя");
	ИдПервой = Первая.Идентификатор;
	ИдПоследней = Последняя.Идентификатор;

	// обновляем строку, которая НЕ является максимумом таблицы
	Первая.Метка = "первая-изменённая";
	Первая.Сохранить();

	Ожидаем.Что(Первая.Идентификатор,
		"UPDATE не имеет права двигать Идентификатор объекта в памяти").Равно(ИдПервой);
	Ожидаем.Что(МеткаПробы(Хранилище, ИдПервой),
		"UPDATE изменил СВОЮ строку").Равно("первая-изменённая");
	Ожидаем.Что(МеткаПробы(Хранилище, ИдПоследней),
		"UPDATE не тронул чужую строку").Равно("последняя");

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Второе следствие того же корня: РаботаСКоннекторами.Сохранить кладёт сущность в ПулСущностей
// ПО ЗНАЧЕНИЮ испорченного идентификатора и затирает законного жильца. Пул живёт весь процесс.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1: испорченный идентификатор идёт ключом в ПулСущностей и затирает законного жильца — выборка отдаёт дубль и теряет строку до конца жизни процесса; пользователь хаба видит после одной правки тега список тегов пакета с дублем и пропавшей строкой, до перезапуска хаба; черновик issue готов — issues/ЧЕРНОВИК-ENTITY-порча-идентификатора.md")
Процедура EntityНеОтравляетКешСущностейЧужимКлючом() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	Первая = ВставитьПробу(Хранилище, "первая");
	Вторая = ВставитьПробу(Хранилище, "вторая");

	Первая.Метка = "первая-изменённая";
	Первая.Сохранить();

	Встреченные = Новый Соответствие();
	Всего = 0;
	Для Каждого Элемент Из Хранилище.Получить() Цикл
		Всего = Всего + 1;
		Ключ = Строка(Элемент.Идентификатор);
		Ожидаем.Что(Встреченные.Получить(Ключ) = Неопределено,
			"чтение таблицы не отдаёт один идентификатор дважды (ид " + Ключ + ")").ЭтоИстина();
		Встреченные.Вставить(Ключ, Истина);
	КонецЦикла;

	Ожидаем.Что(Всего, "строк прочитано после обновления").Равно(2);
	Ожидаем.Что(Встреченные.Получить(Строка(Вторая.Идентификатор)),
		"строка, не участвовавшая в обновлении, прочиталась").Равно(Истина);

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Корень: АбстрактныйКоннекторSQL строит CREATE TABLE только с PRIMARY KEY на идентификаторе.
// Объявить уникальность бизнес-ключа нечем — целостность держит прикладной сервис, а это
// классическая гонка «проверил-вставил». Тест позеленеет лишь вместе с появлением способа
// объявить уникальность: фикстуру СтрокаПробыДефекта тогда придётся дополнить объявлением.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1: авто-DDL строит только PRIMARY KEY по идентификатору, объявить UNIQUE бизнес-ключа нечем — целостность держит прикладной сервис проверкой «проверил-вставил»; пользователь хаба видит это как два одновременных opm push одной версии, создавшие ДВЕ строки версии, недетерминированный latest и задвоенную витрину; issue нет — нужен feature request в nixel2007/entity")
Процедура EntityОтвергаетДубльПоОбъявленномуБизнесКлючу() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	ВставитьПробу(Хранилище, "дубль");

	Ошибка = "";
	Попытка
		ВставитьПробу(Хранилище, "дубль");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"вторая строка с тем же бизнес-ключом обязана быть отвергнута БАЗОЙ, а не сервисом").ЭтоИстина();

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Корень: упавший INSERT оставляет физическое соединение entity/Npgsql рассинхронизированным,
// следующая операция на нём виснет НАВСЕГДА вместо ошибки. Смена контейнера не спасает —
// соединение возвращается в пул Npgsql и достаётся следующему потребителю.
// ОСТОРОЖНО: снятие пропуска подвешивает прогон навсегда, раннер придётся снимать руками.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1 + sql 1.3.3/Npgsql (мина R6): упавший на нарушении уникальности INSERT оставляет соединение рассинхронизированным, и СЛЕДУЮЩАЯ операция виснет навсегда вместо ошибки; пользователь хаба видит зависший opm push вместо честной 409 при гонке публикаций, а хаб теряет рабочий поток и соединение из пула; issue нет — снятие пропуска ПОДВЕШИВАЕТ прогон, а не красит его")
Процедура PostgreSQLНеВисаетПослеНарушенияПервичногоКлюча() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	Первый = Хранилище.СоздатьЭлемент();
	Первый.Идентификатор = 777;
	Первый.Метка = "первый";
	Первый.Сохранить();

	Дубль = Хранилище.СоздатьЭлемент();
	Дубль.Идентификатор = 777;
	Дубль.Метка = "дубль";
	Ошибка = "";
	Попытка
		Дубль.Сохранить();
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"нарушение первичного ключа обязано дать ошибку").ЭтоИстина();

	// вот здесь соединение и виснет — операция обязана ВЕРНУТЬСЯ, любым результатом
	ВставитьПробу(Хранилище, "после дубля");
	Ожидаем.Что(МеткаПробы(Хранилище, 777),
		"соединение живо после упавшего INSERT").Равно("первый");

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Корень: семафором защищены только пишущие операции (Сохранить 95-96, Удалить 151-152,
// УдалитьСтрокиВТаблице 296-297), читающая НайтиСтрокиВТаблице (191-196) открывает файл
// без защиты; запись при этом усекает целевой файл, а не идёт через временный.
// Обхода у нас больше нет: укреплённые коннекторы сняты решением владельца.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1: КоннекторJSON не защищает ЧТЕНИЕ таблицы и синхронизируется процессно-локальным семафором, поэтому одновременные чтение и запись дают IOException, а второй ПРОЦЕСС на том же каталоге видит обрезанный файл; пользователь хаба видит это как петлю падений при старте (запрос в окно старта роняет стартовую рогатку и весь процесс) и как случайные 502 на витрине; текст issue готов — issues/ИШУЗЫ-ENTITY.md §1, репро — spikes/коннекторы-вставка/Гонка.os")
Процедура КоннекторJSONВыдерживаетОдновременноеЧтениеИЗапись() Экспорт

	ВоспроизводитсяВне(
		"oscript spikes/коннекторы-вставка/Гонка.os КоннекторJSON — читатель в главном потоке"
		+ " против писателя в фоновом задании даёт IOException. Второй ПРОЦЕСС на том же"
		+ " каталоге воспроизводится запуском scripts/сидеры при работающем хабе.");

КонецПроцедуры

// Корень: Захватить/Освободить в КоннекторJSON не обёрнуты Попыткой, а между ними есть
// и ВызватьИсключение (109), и файловый ввод-вывод, и вызов НЕЗАЩИЩЁННОЙ НайтиСтрокиВТаблице
// из УдалитьСтрокиВТаблице (299). Ждёт потом навсегда: entity зовёт Захватить() без таймаута,
// а semaphore 1.1.0 при ТаймаутОжидания = 0 исключение не бросает вовсе.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1: упавшая операция КоннекторJSON не освобождает захваченный семафор таблицы (Сохранить 96/138, Удалить 152/171, УдалитьСтрокиВТаблице 297/316 — без Попытки), и следующая операция с этой таблицей висит ВЕЧНО, потому что Захватить зовётся без таймаута; пользователь хаба видит вставший колом хаб: процесс жив, журнал молчит, запросы копятся до исчерпания потоков, лечится только перезапуском; текст issue готов — issues/ИШУЗЫ-ENTITY.md §2")
Процедура КоннекторJSONОсвобождаетСемафорПослеУпавшейОперации() Экспорт

	ВоспроизводитсяВне(
		"голый entity: сущность со СТРОКОВЫМ идентификатором, Сохранить без идентификатора"
		+ " падает на строке 109, после чего ЛЮБАЯ следующая запись в ту же таблицу не"
		+ " возвращает управление. Сценарий целиком — issues/ИШУЗЫ-ENTITY.md §2. ОСТОРОЖНО:"
		+ " снятие пропуска ПОДВЕШИВАЕТ прогон, а не красит его.");

КонецПроцедуры

// Корень: в КоннекторInMemory слова «Семафор» нет вовсе, при этом его ТаблицаЗначений
// (КешТаблиц — процессный кеш, строка 23) правится из нескольких потоков: Добавить (134),
// Удалить (175, 334) и перебор лямбда-процессором в НайтиСтрокиВТаблице (208-303).
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1: КоннекторInMemory не синхронизирован вовсе, а его ТаблицаЗначений меняется из нескольких потоков (Добавить 134, Удалить 175 и 334) при одновременном переборе в НайтиСтрокиВТаблице; пользователь хаба видит это опосредованно — мигающими интеграционными тестами на рекомендованном для тестов бэкенде, из-за которых тонут настоящие дефекты продукта; текст issue готов — issues/ИШУЗЫ-ENTITY.md §3")
Процедура КоннекторInMemoryСинхронизируетДоступКТаблице() Экспорт

	ВоспроизводитсяВне(
		"тот же сценарий, что у Гонки: писатель в фоновом задании против читателя в главном"
		+ " потоке, Тип(""КоннекторInMemory"") и строка соединения-имя базы. Воспроизводимость"
		+ " зависит от тайминга, поэтому нужны несколько прогонов подряд.");

КонецПроцедуры

// Корень: и КоннекторInMemory (110-112), и КоннекторJSON (112-114) на КАЖДУЮ вставку
// считают максимум идентификатора полным перебором таблицы лямбда-процессором fluent.
// Вставка N строк в таблицу из M стоит N × (M + N/2) вычислений лямбды.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.3.1: КоннекторInMemory (110-112) и КоннекторJSON (112-114) на каждую вставку ищут максимум идентификатора полным перебором таблицы лямбда-процессором — массовая вставка квадратична (замер: 200 строк в таблицу из 1000 — 79 с; те же 200 строк с ЗАДАННЫМИ идентификаторами — доли секунды); пользователь хаба видит это как разворачивание демо-стенда и сидеров за десятки минут вместо секунд и как дорожающую со временем публикацию на файловом бэкенде; текст issue готов — issues/ИШУЗЫ-ENTITY.md §4, замер — spikes/коннекторы-вставка/Замер.os")
Процедура МягкиеКоннекторыНеПеребираютТаблицуНаКаждуюВставку() Экспорт

	ВоспроизводитсяВне(
		"oscript spikes/коннекторы-вставка/Замер.os — таблица замеров «строк вставляется /"
		+ " всего в таблице / режим»: строка с заданными идентификаторами показывает «пол»"
		+ " стоимости, разница с генерируемыми и есть цена перебора.");

КонецПроцедуры

#КонецОбласти

#Область Semaphore

// Корень: Захватить меняет мСчетчик под БлокировкойРесурса, а Освободить делает
// «мСчетчик = мСчетчик + 1» без блокировки — тройка «чтение → сложение → запись» теряет
// инкремент. Последствие необратимо: счётчик уходит ниже числа свободных мест, и Захватить
// навсегда уходит в Приостановить(10), а при ТаймаутОжидания = 0 исключение не бросается.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semaphore 1.1.0: Семафор.Освободить меняет счётчик без БлокировкаРесурса, потерянный инкремент необратимо уводит счётчик в минус и вешает Захватить навсегда (ТаймаутОжидания=0 по умолчанию не бросает исключение); пользователь хаба видит это как один старт из двадцати, вставший насмерть — процесс жив, порт не открыт, журнал обрывается на первом обращении к БД; черновик issue готов — issues/ЧЕРНОВИК-SEMAPHORE-освободить-без-блокировки.md")
Процедура SemaphoreНеТеряетИнкрементВОсвободить() Экспорт

	ВоспроизводитсяВне(
		"8 потоков × 20 000 пар Захватить/Освободить одного семафора — 10 зависаний из 10 запусков"
		+ " (тот же объём в одном потоке идёт 0,33 с). Сценарий и цифры — в"
		+ " issues/ЧЕРНОВИК-SEMAPHORE-освободить-без-блокировки.md, раздел «Репродукция».");

КонецПроцедуры

// ЗАПИСЬ О ЦЕНЕ, а не сторож: что стоило хабу снятие укреплённых коннекторов (2026-07-31).
// Числа — свои, снятые на этом чекауте до и после снятия; корень — квадратичная вставка выше.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "ЗАПИСЬ О ЦЕНЕ, а не сторож: на штатном КоннектореInMemory набор Теги_Тесты со ЖИВЫМ сторожем ПересчётТеговНаГорячемПутиДешёвый идёт 511 087 мс против 29 мс суммарного времени тех же 41 теста на укреплённом коннекторе, а сам сторож перестаёт держать порог (13688 мс против 8000); сторож помечен пропуском, и без его данных набор возвращается к 13 мс — то есть цена целиком в объёме вставок; корень — квадратичная вставка entity 3.4.3.1 (issues/ИШУЗЫ-ENTITY.md §4), обходить его у себя запрещено решением владельца; снимать запись — когда апстрим починит генерацию идентификатора")
Процедура СнятиеУкреплённыхКоннекторовНеЗамедляетПрогон() Экспорт

	ВоспроизводитсяВне(
		"oneunit execute -f tests/Теги_Тесты.os со снятым пропуском с"
		+ " ПересчётТеговНаГорячемПутиДешёвый: 511 087 мс на набор и красный порог."
		+ " Время уходит в .Максимум() по всей таблице на каждую вставку.");

КонецПроцедуры

#КонецОбласти

#Область Semver

// Корень: «>=1.2.0 <2.0.0» разбирается молча и оставляет только нижнюю границу — fail-open.
// Наш обход — реестр/РазобранныйДиапазон разбирает диапазоны сам, поэтому тест
// написан против библиотеки напрямую.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: составной диапазон одной строкой (>=1.2.0 <2.0.0) молча теряет верхнюю границу — fail-open без единой ошибки; пользователь хаба видит это как opm install, поставивший мажор, который автор пакета диапазоном как раз запретил, и сломанную сборку у всех потребителей; PR готов и ждёт отправки владельцем — ветка fix/compound-ranges-and-caret-zero")
Процедура SemverНеТеряетВерхнююГраницуСоставногоДиапазона() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("1.5.0", ">=1.2.0 <2.0.0"),
		"версия внутри составного диапазона принимается").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("2.0.0", ">=1.2.0 <2.0.0"),
		"верхняя граница составного диапазона обязана действовать").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("3.0.0", ">=1.2.0 <2.0.0"),
		"мажор выше верхней границы обязан отсекаться").ЭтоЛожь();

КонецПроцедуры

// Корень: ^0.0.3 расширяется до >=0.0.3 <0.1.0 вместо >=0.0.3 <0.0.4 — по npm каретка
// фиксирует ПЕРВУЮ НЕНУЛЕВУЮ компоненту. Экосистема OneScript живёт на нулевых мажорах.
// Наш обход — тот же РазобранныйДиапазон.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: ^0.0.3 раскрывается в <0.1.0 вместо <0.0.4 — правило npm «каретка фиксирует первую ненулевую компоненту» не применено; пользователь хаба видит это на нулевых мажорах экосистемы (winow 0.11.3, configor 0.9.1): написал ^0.0.3, получил 0.0.9 со сменившимся API и несобирающийся пакет; PR готов и ждёт отправки владельцем — ветка fix/compound-ranges-and-caret-zero")
Процедура SemverРаскрываетКареткуНадНулевымМажоромПоNpm() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.0.3", "^0.0.3"),
		"сама версия входит в диапазон").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.0.4", "^0.0.3"),
		"^0.0.3 обязана фиксировать ПАТЧ: 0.0.4 вне диапазона").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.2.5", "^0.2.3"),
		"^0.2.3 фиксирует минор: 0.2.5 внутри").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.3.0", "^0.2.3"),
		"^0.2.3 фиксирует минор: 0.3.0 снаружи").ЭтоЛожь();

КонецПроцедуры

// Корень: неразобранная строка сводится к >=0.0.0 — fail-OPEN в разборе НЕДОВЕРЕННЫХ данных
// (строка диапазона приезжает из packagedef чужого пакета).
// Наш обход — РазобранныйДиапазон fail-closed: неразобранный токен бросает исключение.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: неразобранный (мусорный) диапазон сводится к >=0.0.0, то есть «пропустить всё» — fail-open на НЕДОВЕРЕННОЙ строке из чужого packagedef; пользователь хаба видит это как опечатку в диапазоне, которую ни публикация, ни резолв не отвергли: пакет ставится с любой версией, а виноватым выглядит хаб; issue нет, в подготовленный PR не входит")
Процедура SemverОтвергаетМусорныйДиапазон() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", ">=1,2"),
		"диапазон с запятой вместо точки не имеет права пропускать всё").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", "^1.x || ~2.0"),
		"неподдерживаемый оператор || не имеет права пропускать всё").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", "как-нибудь"),
		"мусор не имеет права пропускать всё").ЭтоЛожь();

КонецПроцедуры

// Корень: 1.2.3.4 не парсится — Версии.ВерсияИзСтроки бросает исключение, Новый Версия
// взводит флаг ошибки. Формально не semver 2.0, но такие версии лежат на живом hub.oscript.io.
// Наш обход — легаси-ветка в core-registry (РазобраннаяВерсия, числовой компаратор).
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: четырёхкомпонентная легаси-версия (1.2.3.4) не разбирается — ВерсияИзСтроки бросает исключение; пользователь хаба видит это на реальных пакетах экосистемы (единственная версия entity на хабе — 3.4.3.1): публикация и сортировка легаси-версий отказывают там, где старый хаб их принимал; issue нет, доказательства — spikes/0b-semver/tests/Тесты_ЧетыреКомпоненты.os")
Процедура SemverРазбираетЛегасиВерсиюИзЧетырёхКомпонент() Экспорт

	Ошибка = "";
	Попытка
		Версии.ВерсияИзСтроки("1.2.3.4");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "легаси-версия 1.2.3.4 обязана разбираться без исключения").Равно("");
	Ожидаем.Что(Версии.ВерсияБольше("1.2.3.10", "1.2.3.4"),
		"четвёртая компонента сравнивается численно, а не лексикографически").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Opm

// Корень: при push запрос уходит на порт по умолчанию из схемы URL поля «Сервер»;
// у opm install --url порт из URL теряется тем же образом. Обходной приём — писать порт
// прямо в URL поля «Сервер», но узнать об этом неоткуда: поле «Порт» выглядит рабочим.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "opm 1.4.1: поле Порт в opm.cfg при push игнорируется (у opm install --url порт из URL теряется тем же образом) — запрос уходит на порт по умолчанию; пользователь хаба видит это как отказ соединения при публикации в приватный OpenHub на нестандартном порту либо как попадание на ЧУЖОЙ сервис на 80-м порту того же хоста; PR готов и ждёт отправки владельцем — ветка fix/honor-port-url-and-config")
Процедура OpmУчитываетПолеПортПриPush() Экспорт

	ВоспроизводитсяВне(
		"opm.cfg с Сервер=http://localhost и Порт=<порт стенда>, затем opm push <пакет>.ospx:"
		+ " запрос уходит на 80, а не на указанный порт. Перехват реального opm 1.4.1 —"
		+ " спайки spikes/0a-winow и spikes/0c-push-contract.");

КонецПроцедуры

// Тот же корень, что у № 11, но другая поверхность: собственный semver-парсер opm не разбирает
// четырёхкомпонентную версию, и ЛЮБОЕ сравнение версий такого пакета роняет opm целиком.
// Отсюда бутстрап проекта: entity ставится отдельной командой ДО остальных зависимостей.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "opm 1.4.x: собственный semver-парсер не разбирает четырёхкомпонентную версию, и любое сравнение версий такого пакета роняет opm целиком; пользователь хаба видит это как падающий opm install ЛЮБОГО пакета, объявившего зависимость от entity 3.4.3.1 — единственной версии entity на хабе, — из-за чего entity приходится ставить руками отдельной командой до остальных зависимостей; issue нет, обходная инструкция вытеснена в шапку packagedef, README и CI")
Процедура OpmСравниваетВерсиюПакетаИзЧетырёхКомпонент() Экспорт

	ВоспроизводитсяВне(
		"в чистом каталоге: packagedef с .ЗависитОт(""entity"", ""3.4.3.1"") и opm install -l —"
		+ " opm падает на сравнении версий. Прямая установка (opm install -l entity) версии"
		+ " не сравнивает и проходит; см. шапку packagedef этого проекта.");

КонецПроцедуры

