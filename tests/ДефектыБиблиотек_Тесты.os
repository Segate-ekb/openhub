// Дефекты чужих библиотек — список к разбору, а не сторожа. Каждый тест ПРОПУЩЕН
// безусловным &ВключенЕсли: он описывает поведение чужой библиотеки, пишется против неё
// напрямую (не через наши обёртки) и позеленеет только когда апстрим починит дефект.
// Причина пропуска называет библиотеку с версией, симптом, взгляд пользователя хаба и issue.
// Тела не исполняются: набор не поднимает контейнер, не ходит в сеть, не создаёт файлов.

#Использовать asserts
#Использовать entity
#Использовать semver

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьПробу() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ФайлПробы = ОбъединитьПути(КаталогТестов, "фикстуры", "СтрокаПробыДефекта.os");
	// `ТипЗарегистрирован` в этом наборе недоступен (он приходит с ОСенью, а контейнер
	// здесь не поднимается), поэтому повторное подключение гасится Попыткой: имя уже
	// зарегистрировано в процессе — подключать нечего.
	Попытка
		ПодключитьСценарий(ФайлПробы, "СтрокаПробыДефекта");
	Исключение
		// уже подключено этим процессом — допустимо
	КонецПопытки;

КонецПроцедуры

#Область Entity

// Корень: АбстрактныйКоннекторSQL строит CREATE TABLE только с PRIMARY KEY на идентификаторе.
// Объявить уникальность бизнес-ключа нечем — целостность держит прикладной сервис, а это
// классическая гонка «проверил-вставил». Тест позеленеет лишь вместе с появлением способа
// объявить уникальность: фикстуру СтрокаПробыДефекта тогда придётся дополнить объявлением.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.4.0: авто-DDL строит только PRIMARY KEY по идентификатору, объявить UNIQUE бизнес-ключа нечем — целостность держит прикладной сервис проверкой «проверил-вставил»; пользователь хаба видит это как два одновременных opm push одной версии, создавшие ДВЕ строки версии, недетерминированный latest и задвоенную витрину; issue нет — нужен feature request в nixel2007/entity")
Процедура EntityОтвергаетДубльПоОбъявленномуБизнесКлючу() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	ВставитьПробу(Хранилище, "дубль");

	Ошибка = "";
	Попытка
		ВставитьПробу(Хранилище, "дубль");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"вторая строка с тем же бизнес-ключом обязана быть отвергнута БАЗОЙ, а не сервисом").ЭтоИстина();

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Корень: упавший INSERT оставляет физическое соединение entity/Npgsql рассинхронизированным,
// следующая операция на нём виснет НАВСЕГДА вместо ошибки. Смена контейнера не спасает —
// соединение возвращается в пул Npgsql и достаётся следующему потребителю.
// Тело показывает вход через дубль первичного ключа: в 3.4.4.0 этот вход закрыт — Сохранить
// идёт ON CONFLICT (id) DO UPDATE и не падает, — поэтому снятие пропуска потребует другого
// падающего INSERT (not-null, несовпадение типа, внешний ключ).
// ОСТОРОЖНО: снятие пропуска подвешивает прогон навсегда, раннер придётся снимать руками.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.4.0 + sql 1.3.3/Npgsql (мина R6): упавший INSERT оставляет соединение рассинхронизированным, и СЛЕДУЮЩАЯ операция виснет навсегда вместо ошибки; дефект лежит в слое sql/Npgsql, выпуск entity 3.4.4.0 его не трогает, но сузил вход — сохранение сущности перешло на ON CONFLICT (id) DO UPDATE, поэтому конфликт первичного ключа через Сохранить больше не возникает и мина достаётся любому другому падающему INSERT; пользователь хаба видит зависший запрос вместо честной ошибки, а хаб теряет рабочий поток и соединение из пула; issue нет — снятие пропуска ПОДВЕШИВАЕТ прогон, а не красит его")
Процедура PostgreSQLНеВисаетПослеНарушенияПервичногоКлюча() Экспорт

	Хранилище = ХранилищеПробыPostgreSQL();
	ОчиститьПробы(Хранилище);

	Первый = Хранилище.СоздатьЭлемент();
	Первый.Идентификатор = 777;
	Первый.Метка = "первый";
	Первый.Сохранить();

	Дубль = Хранилище.СоздатьЭлемент();
	Дубль.Идентификатор = 777;
	Дубль.Метка = "дубль";
	Ошибка = "";
	Попытка
		Дубль.Сохранить();
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"нарушение первичного ключа обязано дать ошибку").ЭтоИстина();

	// вот здесь соединение и виснет — операция обязана ВЕРНУТЬСЯ, любым результатом
	ВставитьПробу(Хранилище, "после дубля");
	Ожидаем.Что(МеткаПробы(Хранилище, 777),
		"соединение живо после упавшего INSERT").Равно("первый");

	ОчиститьПробы(Хранилище);

КонецПроцедуры

// Корень: гонка чтения-записи закрыта в 3.4.4.0 только ВНУТРИ процесса — чтение идёт под
// блокировкой чтения (НайтиСтрокиВТаблице 227-228), записи монопольны, освобождение
// гарантировано и на исключении. Пул блокировок процессный (БлокировкиЧтенияЗаписи, переменная
// модуля), а запись по-прежнему усекает целевой файл, а не идёт через временный, — второму
// процессу на том же каталоге противопоставить нечего.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.4.0: одновременные чтение и запись таблицы КоннектораJSON разведены только ВНУТРИ процесса (пул БлокировкиЧтенияЗаписи — переменная модуля, а владельцем блокировки считается контекст исполнения: весь код вне фоновых заданий это один владелец), при этом запись усекает целевой файл, временного файла с переименованием нет — и ВТОРОЙ процесс на том же каталоге читает обрезанную таблицу; пользователь хаба видит это как случайные 502 на витрине, когда рядом с живым хабом работают scripts/сидеры или admin-cli, а КоннекторJSON у хаба бэкенд по умолчанию (src/main.os); текст issue готов — issues/ИШУЗЫ-ENTITY.md §1, внутрипроцессная половина закрыта выпуском 3.4.4.0")
Процедура КоннекторJSONВыдерживаетОдновременноеЧтениеИЗапись() Экспорт

	ВоспроизводитсяВне(
		"второй ПРОЦЕСС на каталоге работающего хаба: scripts/сидеры при поднятом хабе на"
		+ " КоннектореJSON — читатель одного процесса видит файл, усечённый записью другого."
		+ " Внутри одного процесса (spikes/коннекторы-вставка/Гонка.os) гонка с 3.4.4.0"
		+ " больше не воспроизводится: чтение идёт под блокировкой чтения.");

КонецПроцедуры

// Корень: блокировок чтения-записи, приехавших в 3.4.4.0, КоннекторInMemory не получил — в файле
// нет ни одной. Его ТаблицаЗначений живёт в процессном кеше (ХранилищеВПамяти.КешТаблиц) и правится
// из нескольких потоков: Добавить (132), Удалить (173, 332) и перебор лямбда-процессором
// в НайтиСтрокиВТаблице (194-302). Счётчик идентификаторов, заменивший в 3.4.4.0 поиск максимума,
// защиты тоже не имеет: «прочитал — прибавил — записал» (СледующийИдентификатор 350-362).
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.4.0: КоннекторInMemory не синхронизирован вовсе — новых блокировок чтения-записи ему не досталось, — а данные его процессные: ТаблицаЗначений из ХранилищеВПамяти.КешТаблиц меняется из нескольких потоков (Добавить 132, Удалить 173 и 332) при одновременном переборе в НайтиСтрокиВТаблице, и незащищённый счётчик идентификаторов (СледующийИдентификатор 350-362) выдаёт двум одновременным сохранениям ОДИН номер, вторая запись затирает первую; пользователь хаба видит это опосредованно — мигающими интеграционными тестами на рекомендованном для тестов бэкенде, из-за которых тонут настоящие дефекты продукта; текст issue готов — issues/ИШУЗЫ-ENTITY.md §3")
Процедура КоннекторInMemoryСинхронизируетДоступКТаблице() Экспорт

	ВоспроизводитсяВне(
		"писатель в фоновом задании против читателя в главном потоке одного процесса"
		+ " (spikes/коннекторы-вставка/Гонка.os с Тип(""КоннекторInMemory"") и строкой"
		+ " соединения-именем базы). Воспроизводимость зависит от тайминга, поэтому нужны"
		+ " несколько прогонов подряд.");

КонецПроцедуры

// Корень: КоннекторJSON на КАЖДУЮ вставку ищет максимум идентификатора проходом по всей таблице
// (СледующийИдентификатор 560-573). В 3.4.4.0 проход перестал быть лямбдой процессора коллекций,
// поэтому константа упала на порядок, но сам проход остался линейным: вставка N строк в таблицу из M
// стоит N × (M + N/2) сравнений. КоннекторInMemory из дефекта вышел — счётчики на строку
// подключения (ХранилищеВПамяти.СчетчикиИдентификаторов) выдают идентификатор за O(1).
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "entity 3.4.4.0: КоннекторJSON на каждую вставку ищет максимум идентификатора проходом по всей таблице, поэтому массовая вставка на файловом бэкенде остаётся квадратичной — лямбда-процессор заменён обычным циклом, константа на порядок меньше, асимптотика та же; КоннекторInMemory починен счётчиками идентификаторов и из дефекта вышел; пользователь хаба видит это как публикацию, дорожающую по мере наполнения файлового бэкенда — он у хаба по умолчанию (src/main.os), — и как сидеры, которые тем медленнее, чем больше уже опубликовано; текст issue готов — issues/ИШУЗЫ-ENTITY.md §4, замер (200 строк в таблицу из 1000 — 79 с) снят на 3.4.3.1 и на 3.4.4.0 не переснимался")
Процедура КоннекторJSONНеПеребираетТаблицуНаКаждуюВставку() Экспорт

	ВоспроизводитсяВне(
		"oscript spikes/коннекторы-вставка/Замер.os на КоннектореJSON — таблица замеров"
		+ " «строк вставляется / всего в таблице / режим»: строка с заданными идентификаторами"
		+ " показывает «пол» стоимости, разница с генерируемыми и есть цена прохода."
		+ " На КоннектореInMemory эта разница исчезла: идентификатор выдаёт счётчик.");

КонецПроцедуры

#КонецОбласти

#Область Semaphore

// Корень: Захватить меняет мСчетчик под БлокировкойРесурса, а Освободить делает
// «мСчетчик = мСчетчик + 1» без блокировки — тройка «чтение → сложение → запись» теряет
// инкремент. Последствие необратимо: счётчик уходит ниже числа свободных мест, и Захватить
// навсегда уходит в Приостановить(10), а при ТаймаутОжидания = 0 исключение не бросается.
// entity 3.4.4.0 увела с семафора КоннекторJSON, но не пути, которые проходит любой старт хаба.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semaphore 1.1.0: Семафор.Освободить меняет счётчик без БлокировкаРесурса, потерянный инкремент необратимо уводит счётчик в минус и вешает Захватить навсегда (ТаймаутОжидания=0 по умолчанию не бросает исключение); хаб зависит от этого на любом бэкенде — entity 3.4.4.0 держит семафор в ХранилищаСущностей.Получить (выдача хранилища сущностей), КоннекторPostgreSQL.Сохранить и КоннекторSQLite.Сохранить, ушёл он только из КоннектораJSON; пользователь хаба видит это как один старт из двадцати, вставший насмерть — процесс жив, порт не открыт, журнал обрывается на первом обращении к БД; черновик issue готов — issues/ЧЕРНОВИК-SEMAPHORE-освободить-без-блокировки.md")
Процедура SemaphoreНеТеряетИнкрементВОсвободить() Экспорт

	ВоспроизводитсяВне(
		"8 потоков × 20 000 пар Захватить/Освободить одного семафора — 10 зависаний из 10 запусков"
		+ " (тот же объём в одном потоке идёт 0,33 с). Сценарий и цифры — в"
		+ " issues/ЧЕРНОВИК-SEMAPHORE-освободить-без-блокировки.md, раздел «Репродукция».");

КонецПроцедуры

#КонецОбласти

#Область Semver

// Корень: «>=1.2.0 <2.0.0» разбирается молча и оставляет только нижнюю границу — fail-open.
// Наш обход — реестр/РазобранныйДиапазон разбирает диапазоны сам, поэтому тест
// написан против библиотеки напрямую.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: составной диапазон одной строкой (>=1.2.0 <2.0.0) молча теряет верхнюю границу — fail-open без единой ошибки; пользователь хаба видит это как opm install, поставивший мажор, который автор пакета диапазоном как раз запретил, и сломанную сборку у всех потребителей; PR готов и ждёт отправки владельцем — ветка fix/compound-ranges-and-caret-zero")
Процедура SemverНеТеряетВерхнююГраницуСоставногоДиапазона() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("1.5.0", ">=1.2.0 <2.0.0"),
		"версия внутри составного диапазона принимается").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("2.0.0", ">=1.2.0 <2.0.0"),
		"верхняя граница составного диапазона обязана действовать").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("3.0.0", ">=1.2.0 <2.0.0"),
		"мажор выше верхней границы обязан отсекаться").ЭтоЛожь();

КонецПроцедуры

// Корень: ^0.0.3 расширяется до >=0.0.3 <0.1.0 вместо >=0.0.3 <0.0.4 — по npm каретка
// фиксирует ПЕРВУЮ НЕНУЛЕВУЮ компоненту. Экосистема OneScript живёт на нулевых мажорах.
// Наш обход — тот же РазобранныйДиапазон.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: ^0.0.3 раскрывается в <0.1.0 вместо <0.0.4 — правило npm «каретка фиксирует первую ненулевую компоненту» не применено; пользователь хаба видит это на нулевых мажорах экосистемы (winow 0.11.3, configor 0.9.1): написал ^0.0.3, получил 0.0.9 со сменившимся API и несобирающийся пакет; PR готов и ждёт отправки владельцем — ветка fix/compound-ranges-and-caret-zero")
Процедура SemverРаскрываетКареткуНадНулевымМажоромПоNpm() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.0.3", "^0.0.3"),
		"сама версия входит в диапазон").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.0.4", "^0.0.3"),
		"^0.0.3 обязана фиксировать ПАТЧ: 0.0.4 вне диапазона").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.2.5", "^0.2.3"),
		"^0.2.3 фиксирует минор: 0.2.5 внутри").ЭтоИстина();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("0.3.0", "^0.2.3"),
		"^0.2.3 фиксирует минор: 0.3.0 снаружи").ЭтоЛожь();

КонецПроцедуры

// Корень: неразобранная строка сводится к >=0.0.0 — fail-OPEN в разборе НЕДОВЕРЕННЫХ данных
// (строка диапазона приезжает из packagedef чужого пакета).
// Наш обход — РазобранныйДиапазон fail-closed: неразобранный токен бросает исключение.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: неразобранный (мусорный) диапазон сводится к >=0.0.0, то есть «пропустить всё» — fail-open на НЕДОВЕРЕННОЙ строке из чужого packagedef; пользователь хаба видит это как опечатку в диапазоне, которую ни публикация, ни резолв не отвергли: пакет ставится с любой версией, а виноватым выглядит хаб; issue нет, в подготовленный PR не входит")
Процедура SemverОтвергаетМусорныйДиапазон() Экспорт

	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", ">=1,2"),
		"диапазон с запятой вместо точки не имеет права пропускать всё").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", "^1.x || ~2.0"),
		"неподдерживаемый оператор || не имеет права пропускать всё").ЭтоЛожь();
	Ожидаем.Что(Версии.ВерсияВДиапазоне("9.9.9", "как-нибудь"),
		"мусор не имеет права пропускать всё").ЭтоЛожь();

КонецПроцедуры

// Корень: 1.2.3.4 не парсится — Версии.ВерсияИзСтроки бросает исключение, Новый Версия
// взводит флаг ошибки. Формально не semver 2.0, но такие версии лежат на живом hub.oscript.io.
// Наш обход — легаси-ветка в core-registry (РазобраннаяВерсия, числовой компаратор).
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "semver 1.1.1: четырёхкомпонентная легаси-версия (1.2.3.4) не разбирается — ВерсияИзСтроки бросает исключение; пользователь хаба видит это на реальных пакетах экосистемы (entity на хабе четырёхкомпонентна всеми версиями: 3.4.4.0, прежде 3.4.3.1): публикация и сортировка легаси-версий отказывают там, где старый хаб их принимал; issue нет, доказательства — spikes/0b-semver/tests/Тесты_ЧетыреКомпоненты.os")
Процедура SemverРазбираетЛегасиВерсиюИзЧетырёхКомпонент() Экспорт

	Ошибка = "";
	Попытка
		Версии.ВерсияИзСтроки("1.2.3.4");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "легаси-версия 1.2.3.4 обязана разбираться без исключения").Равно("");
	Ожидаем.Что(Версии.ВерсияБольше("1.2.3.10", "1.2.3.4"),
		"четвёртая компонента сравнивается численно, а не лексикографически").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Opm

// Корень: при push запрос уходит на порт по умолчанию из схемы URL поля «Сервер»;
// у opm install --url порт из URL теряется тем же образом. Обходной приём — писать порт
// прямо в URL поля «Сервер», но узнать об этом неоткуда: поле «Порт» выглядит рабочим.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "opm 1.4.1: поле Порт в opm.cfg при push игнорируется (у opm install --url порт из URL теряется тем же образом) — запрос уходит на порт по умолчанию; пользователь хаба видит это как отказ соединения при публикации в приватный OpenHub на нестандартном порту либо как попадание на ЧУЖОЙ сервис на 80-м порту того же хоста; PR готов и ждёт отправки владельцем — ветка fix/honor-port-url-and-config")
Процедура OpmУчитываетПолеПортПриPush() Экспорт

	ВоспроизводитсяВне(
		"opm.cfg с Сервер=http://localhost и Порт=<порт стенда>, затем opm push <пакет>.ospx:"
		+ " запрос уходит на 80, а не на указанный порт. Перехват реального opm 1.4.1 —"
		+ " спайки spikes/0a-winow и spikes/0c-push-contract.");

КонецПроцедуры

// Тот же корень, что у № 11, но другая поверхность: собственный semver-парсер opm не разбирает
// четырёхкомпонентную версию, и ЛЮБОЕ сравнение версий такого пакета роняет opm целиком.
// Отсюда бутстрап проекта: entity ставится отдельной командой ДО остальных зависимостей.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "opm 1.4.x: собственный semver-парсер не разбирает четырёхкомпонентную версию, и любое сравнение версий такого пакета роняет opm целиком; пользователь хаба видит это как падающий opm install ЛЮБОГО пакета, объявившего зависимость от entity 3.4.4.0 — версии entity на хабе четырёхкомпонентны все, — из-за чего entity приходится ставить руками отдельной командой до остальных зависимостей; issue нет, обходная инструкция вытеснена в шапку packagedef, README и CI")
Процедура OpmСравниваетВерсиюПакетаИзЧетырёхКомпонент() Экспорт

	ВоспроизводитсяВне(
		"в чистом каталоге: packagedef с .ЗависитОт(""entity"", ""3.4.4.0"") и opm install -l —"
		+ " opm падает на сравнении версий. Прямая установка (opm install -l entity) версии"
		+ " не сравнивает и проходит; см. шапку packagedef этого проекта.");

КонецПроцедуры

#КонецОбласти

#Область Winow

// Корень: в native-режиме (ВебСервер 2.0) лимит тела запроса 30 МБ и из winow не настраивается.
// Applied-режим лимита не имеет, но обрезает тело медленных клиентов — для продакшена не годится.
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "winow 0.11.3: в native-режиме (ВебСервер 2.0) тело запроса ограничено 30 МБ и лимит не настраивается, а applied-режим лимита не имеет, но обрезает тело медленных клиентов; пользователь хаба видит это как невозможность opm push пакета тяжелее ~28,6 МБ — обрыв публикации, похожий на ошибку сети; черновик issue готов — issues/ЧЕРНОВИК-WINOW-большие-тела.md")
Процедура WinowПринимаетТелоЗапросаБольшеТридцатиМегабайт() Экспорт

	ВоспроизводитсяВне(
		"прототип spikes/0a-winow (порядок запуска — в шапке его точки входа): поднять хаб"
		+ " в native-режиме и сделать opm push артефакта"
		+ " на 40 МБ — запрос отвергается Kestrel до контроллера. Цифры и разбор режимов —"
		+ " в issues/ЧЕРНОВИК-WINOW-большие-тела.md.");

КонецПроцедуры

#КонецОбласти

#Область Oint

// Корень: клиент S3 неверно подписывает query — слеш внутри значения ломает SigV4.
// Отсюда листинг по ведущему сегменту страницами по 250; постраничный токен ловит тот же дефект.
// Обхода нет и не будет: S3Хранилище падает ГРОМКО, сторожа — S3Хранилище_Тесты «ПределЛистинга».
&Тест
&ВключенЕсли("() -> Ложь",
	Причина = "oint 2.3.0: клиент S3 неверно подписывает query по SigV4 — ?prefix= со слешем ломает подпись, тот же дефект ловит постраничный токен, поэтому листинг за пределом страницы падает; пользователь хаба на S3 видит это как внезапно переставший работать opm push в пул с квотой (предпроверка ЗанятыйОбъем не может перечислить хранилище) и как вставшую сборку мусора прокси-кэша; issue нет, у нас закрыто fail-loud-сторожами S3Хранилище_Тесты")
Процедура OintПодписываетQueryСоСлешемПоSigV4() Экспорт

	ВоспроизводитсяВне(
		"живой S3/MinIO: листинг с ?prefix=pools/<пул>/ через клиент oint 2.3.0 отвергается"
		+ " подписью; тот же запрос без слеша в значении проходит. Постраничный токен"
		+ " (continuation-token) ловит тот же дефект.");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дефект достижим только в окружении, которого у процесса OneUnit нет. Тело падает
// ГРОМКО и с точной командой: набор не имеет права зеленеть на «нечего проверить».
Процедура ВоспроизводитсяВне(Знач Команда)
	ВызватьИсключение "воспроизведение вне процесса OneUnit: " + Команда;
КонецПроцедуры

Функция ХранилищеПробыPostgreSQL()

	DSN = ПолучитьПеременнуюСреды("OSHUB_TEST_PG_DSN");
	Если НЕ ЗначениеЗаполнено(DSN) Тогда
		ВызватьИсключение "нужна переменная окружения OSHUB_TEST_PG_DSN со строкой соединения PostgreSQL";
	КонецЕсли;

	Менеджер = Новый МенеджерСущностей(Тип("КоннекторPostgreSQL"), DSN);
	Менеджер.ДобавитьКлассВМодель(Тип("СтрокаПробыДефекта"));
	Менеджер.Инициализировать();

	Возврат Менеджер.ПолучитьХранилищеСущностей(Тип("СтрокаПробыДефекта"));

КонецФункции

Функция ВставитьПробу(Хранилище, Знач Метка)
	Элемент = Хранилище.СоздатьЭлемент();
	Элемент.Метка = Метка;
	Элемент.Сохранить();
	Возврат Элемент;
КонецФункции

Функция МеткаПробы(Хранилище, Знач Идентификатор)
	Опции = Новый ОпцииПоиска();
	Опции.Отбор("Идентификатор", ВидСравнения.Равно, Идентификатор);
	Найденное = Хранилище.ПолучитьОдно(Опции);
	Возврат ?(Найденное = Неопределено, "<строки нет>", Строка(Найденное.Метка));
КонецФункции

Процедура ОчиститьПробы(Хранилище)
	Для Каждого Элемент Из Хранилище.Получить() Цикл
		Хранилище.Удалить(Элемент);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
