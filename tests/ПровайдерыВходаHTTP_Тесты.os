		"GET ничего не выключил").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекретНеВсплываетНаСтраницеОтказа() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Плохой = ПоляСоздания(УникальныеИмена.Имя("err"), Кука);
	Плохой.Вставить("секрет", "СЕКРЕТ-СТРАНИЦЫ-ОШИБКИ");
	Плохой.Вставить("возврат", "http://public.example.com/cb"); // отбивается валидатором
