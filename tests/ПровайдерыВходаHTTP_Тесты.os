	Ожидаем.Что(Ответ.КодСостояния, "ввод отбит — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "СЕКРЕТ-СТРАНИЦЫ-ОШИБКИ"),
		"введённый секрет не перепечатан на странице отказа").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция АдресРаздела()
	Возврат "/hub/settings/providers";
КонецФункции

// Поля формы заведения читаются с ТОЙ ЖЕ страницы, что видит браузер, выбравший пресет:
// набор полей у каждого пресета свой, и посылать чужой набор значит бить мимо разметки.
Функция ПоляСоздания(Знач Имя, Знач Кука)

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресФормы("github"), Кука));
	Поля = ИменаПолейФормы(HTML, АдресРаздела());

	Ожидаем.Что(Поля.Получить("имя") <> Неопределено,
		"форма создания содержит поле имени (иначе тест шлёт мимо разметки)").ЭтоИстина();
	Ожидаем.Что(Поля.Получить("клиент") <> Неопределено, "и поле client_id").ЭтоИстина();

	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("пресет", "github");
	Поля.Вставить("клиент", "Iv1.abcdef");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");
	Возврат Поля;

КонецФункции

// Форма «свой провайдер»: пресет ничего не подставляет, поля заполняет администратор.
// Форма «свой провайдер» ЗАДАННОГО протокола: поля читаются с той страницы, которую
// увидит браузер, выбравший этот протокол, — набор у протоколов разный.
Функция ПоляСвоего(Знач Имя, Знач Кука, Знач Протокол = "oidc")

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресФормыПротокола(Протокол), Кука));
	Поля = ИменаПолейФормы(HTML, АдресРаздела());

	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("пресет", "");
	Поля.Вставить("протокол", Протокол);
	Поля.Вставить("значок", "key");
	Поля.Вставить("клиент", "own-client");
	Поля.Вставить("секрет", "own-secret");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");

	Если Протокол = "oauth2" Тогда
		Поля.Вставить("авторизация", "https://idp.example.com/authorize");
		Поля.Вставить("токен", "https://idp.example.com/token");
		Поля.Вставить("профиль", "https://idp.example.com/userinfo");
	Иначе
		Поля.Вставить("издатель", "https://idp.example.com");
	КонецЕсли;

	Возврат Поля;

КонецФункции

Функция АдресФормы(Знач Пресет)
	Возврат АдресРаздела() + "?preset=" + Пресет;
КонецФункции

Функция АдресФормыПротокола(Знач Протокол)
	Возврат АдресФормы("") + "&protocol=" + Протокол;
КонецФункции

// Разметка одного набора: от его <fieldset> до конца формы — соседний набор начинается
// новым тегом с тем же классом, поэтому граница берётся по нему.
Функция ОбластьНабора(Знач HTML, Знач Ключ)

	Начало = СтрНайти(HTML, "data-set=""" + Ключ + """");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Сред(Хвост, 2), "<fieldset class=""choice-set""");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Функция ПоляТумблера(Знач Кука, Знач Значение)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука))));
	Поля.Вставить("включить", Значение);
	Возврат Поля;
КонецФункции

Функция ТолькоТокен(Знач Кука)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука))));
	Возврат Поля;
КонецФункции

// Наборы делятся на два уровня: пресетные (ключ — пресет) и вложенные в «свой провайдер»
// наборы протокола (ключ — oidc/oauth2). Уровень определяется по ключу набора.
Функция НаборыУровня(Знач Наборы, Знач Пресетные)

	Результат = Новый Массив();
	Для Каждого Тег Из Наборы Цикл
		Протокольный = СтрНайти(Тег, "data-set=""oidc""") > 0
			ИЛИ СтрНайти(Тег, "data-set=""oauth2""") > 0;
		Если Протокольный <> Пресетные Тогда
			Результат.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Живые(Знач Наборы)

	Результат = Новый Массив();
	Для Каждого Тег Из Наборы Цикл
		Если СтрНайти(Тег, " disabled") = 0 Тогда
			Результат.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Записывает URL инстанса через настоящую форму раздела «Базовые настройки».
Функция ЗадатьURLИнстанса(Знач Значение, Знач Кука)

	Адрес = "/hub/settings/identity";
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(Адрес, Кука))));
	Поля.Вставить("oshub.instance.url", Значение);
	Возврат Клиент.POSTФормы(Адрес, Поля, Кука).КодСостояния;

КонецФункции

// Страница глазами браузера с выключенным JS: содержимое <script> вырезано целиком.
Функция БезТегов(Знач HTML, Знач Открытие, Знач Закрытие)

	Результат = HTML;
	Позиция = СтрНайти(Результат, Открытие);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Результат, Позиция);
		Конец = СтрНайти(Хвост, Закрытие);
		Если Конец = 0 Тогда
			Возврат Лев(Результат, Позиция - 1);
		КонецЕсли;
		Результат = Лев(Результат, Позиция - 1) + Сред(Хвост, Конец + СтрДлина(Закрытие));
		Позиция = СтрНайти(Результат, Открытие);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИменаПолейФормы(Знач HTML, Знач Действие)

	Маркер = "action=""" + Действие + """";
	Начало = СтрНайти(HTML, Маркер);
	Если Начало = 0 Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Хвост, "</form>");
	Если Конец > 0 Тогда
		Хвост = Лев(Хвост, Конец);
	КонецЕсли;

	Возврат ПоляВключённыхГрупп(Хвост);

КонецФункции

// Поля так, как их соберёт БРАУЗЕР: отключённое поле и всё содержимое отключённой группы
// <fieldset disabled> в тело запроса не попадают вовсе. Тест, читающий их наравне
// с остальными, слал бы то, чего форма на самом деле не шлёт, — и мимо разметки.
Функция ПоляВключённыхГрупп(Знач ФрагментФормы)

	Результат = Новый Соответствие();
	Глубина = 0;    // сколько <fieldset> открыто
	Отключено = 0;  // глубина отключённой группы; 0 — таких нет
	Позиция = 1;

	Пока Истина Цикл

		Начало = СтрНайти(ФрагментФормы, "<", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		КонецТега = СтрНайти(ФрагментФормы, ">", НаправлениеПоиска.СНачала, Начало);
		Если КонецТега = 0 Тогда
			Прервать;
		КонецЕсли;

		Тег = Сред(ФрагментФормы, Начало, КонецТега - Начало + 1);
		Позиция = КонецТега + 1;
		Низкий = НРег(Тег);

		Если СтрНачинаетсяС(Низкий, "<fieldset") Тогда
			Глубина = Глубина + 1;
			Если Отключено = 0 И СтрНайти(Низкий, " disabled") > 0 Тогда
				Отключено = Глубина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Низкий, "</fieldset") Тогда
			Если Отключено = Глубина Тогда
				Отключено = 0;
			КонецЕсли;
			Глубина = Макс(0, Глубина - 1);
			Продолжить;
		КонецЕсли;

		Если Отключено > 0 ИЛИ СтрНайти(Низкий, " disabled") > 0 Тогда
			Продолжить;
		КонецЕсли;

		ИмяПоля = ЗначениеАтрибута(Тег, "name");
		Если ЗначениеЗаполнено(ИмяПоля) Тогда
			Результат.Вставить(ИмяПоля, ЗначениеАтрибута(Тег, "value"));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Открывающие теги, начинающиеся с маркера, целиком — чтобы читать их атрибуты.
Функция ОткрывающиеТеги(Знач HTML, Знач Маркер)

	Результат = Новый Массив();
	Позиция = СтрНайти(HTML, Маркер);

	Пока Позиция > 0 Цикл
		КонецТега = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Позиция);
		Если КонецТега = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Сред(HTML, Позиция, КонецТега - Позиция + 1));
		Следующая = СтрНайти(Сред(HTML, КонецТега + 1), Маркер);
		Позиция = ?(Следующая = 0, 0, КонецТега + Следующая);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МеждуМаркеров(Знач HTML, Знач Открытие, Знач Закрытие)

	Начало = СтрНайти(HTML, Открытие);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Начало);
	Конец = СтрНайти(Хвост, Закрытие);
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

КонецФункции

Функция СколькоРаз(Знач Текст, Знач Фрагмент)

	Количество = 0;
	Позиция = СтрНайти(Текст, Фрагмент);
	Пока Позиция > 0 Цикл
		Количество = Количество + 1;
		Следующая = СтрНайти(Сред(Текст, Позиция + СтрДлина(Фрагмент)), Фрагмент);
		Позиция = ?(Следующая = 0, 0, Позиция + СтрДлина(Фрагмент) + Следующая - 1);
	КонецЦикла;
	Возврат Количество;

КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Имя)

	Маркер = " " + Имя + "=""";
	Позиция = СтрНайти(Тег, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, Позиция + СтрДлина(Маркер));
	Кавычка = СтрНайти(Остаток, """");
	Возврат ?(Кавычка = 0, "", Лев(Остаток, Кавычка - 1));

КонецФункции

Функция СписокКлючей(Знач Поля)
	Части = Новый Массив();
	Для Каждого КиЗ Из Поля Цикл
		Части.Добавить(Строка(КиЗ.Ключ));
	КонецЦикла;
	Для Внешний = 0 По Части.Количество() - 2 Цикл
		Для Внутренний = 0 По Части.Количество() - 2 - Внешний Цикл
			Если Части[Внутренний] > Части[Внутренний + 1] Тогда
				Буфер = Части[Внутренний];
				Части[Внутренний] = Части[Внутренний + 1];
				Части[Внутренний + 1] = Буфер;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ИзвлечьCSRF(Знач HTML)

	Маркер = "name=""_csrf""";
	Позиция = СтрНайти(HTML, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Позиция);
	ПозицияЗначения = СтрНайти(Хвост, "value=""");
	Если ПозицияЗначения = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Хвост, ПозицияЗначения + 7);
	Кавычка = СтрНайти(Остаток, """");
	Возврат ?(Кавычка = 0, "", Лев(Остаток, Кавычка - 1));

КонецФункции

// Адрес значка берётся У ТАБЛИЦЫ АКТИВОВ, а не собирается здесь из имени файла: сторож
// обязан стеречь инвариант «в разметке ровно тот адрес, который выдаёт таблица», а не
// форму записи имени. Кусок имени в ожидании молчал бы на адресе с чужим отпечатком
// и краснел бы на всякой перекладке статики.
Функция АдресЗначка(Знач Ключ)

	Место = Новый РаскладкаСтатики(НоваяПоставкаСтатики());
	Возврат Новый АктивыСтатики(Место, Новый ОтпечаткиСтатики(Место))
		.Адрес(Место.ФайлЗначка(Ключ));

КонецФункции

// Поставка статики инсталляции — класс проекта: кит его не везёт, а адрес без него
// выродится в имя без отпечатка.
Функция НоваяПоставкаСтатики()

	Попытка
		Проба = Тип("СтатикаХаба");
		Проба = Проба;
	Исключение
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули", "настройки"),
			"Классы", "СтатикаХаба.os"), "СтатикаХаба");
	КонецПопытки;

	Возврат Новый СтатикаХаба();

КонецФункции

// Значок на странице: он и напечатан адресом из таблицы, и по этому адресу хаб реально
// отдаёт картинку. Битый адрес — то же самое, что пропавший значок.
Процедура ПроверитьЖивойЗначок(Знач Разметка, Знач Ключ, Знач Пояснение)

	Адрес = АдресЗначка(Ключ);
	Ожидаем.Что(ЗначениеЗаполнено(Адрес), "таблица активов знает значок «" + Ключ + "»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "src=""" + Адрес + """") > 0, Пояснение).ЭтоИстина();

	Ответ = Клиент.GET(Адрес);
	Ожидаем.Что(Ответ.КодСостояния, "значок «" + Ключ + "» отдаётся по своему адресу").Равно(200);

КонецПроцедуры

#КонецОбласти
