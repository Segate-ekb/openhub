// HTTP-тесты раздела «провайдеры входа» на настоящем хабе: запрос собирается из напечатанной
// разметки (имена полей и адрес действия читаются из HTML), вложенных форм на странице нет.

#Использовать asserts
#Использовать 1connector
#Использовать oscript-ui
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем КаталогПроекта;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-провайдеры");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");

	// провайдер, объявленный ТОЛЬКО окружением: строки базы у него нет, и в списке
	// инсталляций он обязан быть виден — на чтение
	Хаб.Среда("OSHUB_OIDC_PROVIDERS", "envonly");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_ISSUER", "https://idp.example.com");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_CLIENT_ID", "env-client-id");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_CLIENT_SECRET", "env-secret-value-42");
	Хаб.Среда("OSHUB_OIDC_ENVONLY_REDIRECT_URI", "https://hub.example.com/oidc/callback");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Гвард

&Тест
Процедура РазделТолькоАдминуХаба() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела(), КукаАдмина).КодСостояния,
		"КОНТРОЛЬ: администратор раздел видит").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой(АдресРаздела(), КукаАлисы).КодСостояния,
		"обычному пользователю — 403").Равно(403);

	Аноним = Клиент.Тело(Клиент.GET(АдресРаздела()));
	Ожидаем.Что(СтрНайти(Аноним, "providers.section.title"),
		"аноним не видит маркера ключей раздела").Равно(0);
	Ожидаем.Что(СтрНайти(Аноним, "Завести провайдера"),
		"аноним не видит форму заведения провайдера").Равно(0);

КонецПроцедуры

&Тест
Процедура МутацияБезCSRFОтбивается() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("csrf");

	Поля = ПоляСоздания(Имя, Кука);
	Поля.Удалить("_csrf");
	БезТокена = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(БезТокена.КодСостояния, "без CSRF — 403").Равно(403);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Имя),
		"провайдер не появился").Равно(0);

	СТокеном = Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука);
	Ожидаем.Что(СТокеном.КодСостояния < 400, "КОНТРОЛЬ: с CSRF мутация проходит").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ФормаИРазметка

&Тест
Процедура ВложенныхФормНаСтраницеРазделаНет() Экспорт

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Клиент.Войти("root", "RootPassw0rd")));

	Открытий = 0;
	Максимум = 0;
	Хвост = HTML;
	Пока Истина Цикл
		ПозицияОткрытия = СтрНайти(Хвост, "<form");
		ПозицияЗакрытия = СтрНайти(Хвост, "</form>");
		Если ПозицияОткрытия = 0 И ПозицияЗакрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ПозицияОткрытия > 0 И (ПозицияЗакрытия = 0 ИЛИ ПозицияОткрытия < ПозицияЗакрытия) Тогда
			Открытий = Открытий + 1;
			Максимум = Макс(Максимум, Открытий);
			Хвост = Сред(Хвост, ПозицияОткрытия + 5);
		Иначе
			Открытий = Открытий - 1;
			Хвост = Сред(Хвост, ПозицияЗакрытия + 7);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Максимум > 0, "формы на странице вообще есть (иначе проверять нечего)").ЭтоИстина();
	Ожидаем.Что(Максимум, "глубина вложенности форм: браузер вложенную форму схлопывает"
		+ " и присоединяет её поля к внешней").Равно(1);
	Ожидаем.Что(Открытий, "все формы закрыты").Равно(0);

КонецПроцедуры

&Тест
Процедура ПресетомЗаводитсяКнопкаВходаИСнимаетсяОбратно() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("github");

	Создание = Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука);
	Ожидаем.Что(Создание.КодСостояния < 400,
		"провайдер заведён вводом только client_id/secret").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, Имя) > 0, "провайдер виден в разделе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "oauth2:github") > 0,
		"синтетический издатель GitHub назначен хабом").ЭтоИстина();

	Вход = Клиент.Тело(Клиент.GET("/login"));
	Ожидаем.Что(СтрНайти(Вход, "/login/oidc/" + Имя) > 0,
		"кнопка провайдера появилась на странице входа").ЭтоИстина();

	Выключение = Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/toggle", ПоляТумблера(Кука, "0"), Кука);
	Ожидаем.Что(Выключение.КодСостояния < 400, "выключение прошло").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/login")), "/login/oidc/" + Имя),
		"выключенный провайдер со страницы входа исчез").Равно(0);

	Удаление = Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", ТолькоТокен(Кука), Кука);
	Ожидаем.Что(Удаление.КодСостояния < 400, "удаление прошло").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), Имя),
		"строка снята").Равно(0);

КонецПроцедуры

&Тест
Процедура СекретКлиентаВРазметкеНеПечатается() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("sec");

	Поля = ПоляСоздания(Имя, Кука);
	Поля.Вставить("секрет", "очень-секретное-значение");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Поля, Кука).КодСостояния < 400).ЭтоИстина();

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(HTML, Имя) > 0, "КОНТРОЛЬ: провайдер на странице есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "очень-секретное-значение"),
		"секрет клиента в разметку не попадает").Равно(0);

КонецПроцедуры

&Тест
Процедура АдресВоВнутреннейСетиФормойНеПринимается() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Плохой = ПоляСоздания(УникальныеИмена.Имя("ssrf"), Кука);
	Плохой.Вставить("пресет", "");
	Плохой.Вставить("протокол", "oauth2");
	Плохой.Вставить("авторизация", "https://idp.example.com/authorize");
	Плохой.Вставить("токен", "https://169.254.169.254/token");
	Плохой.Вставить("профиль", "https://idp.example.com/user");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Плохой, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "адрес во внутренней сети — 400, а не тихое сохранение").Равно(400);

	Хороший = ПоляСоздания(УникальныеИмена.Имя("okssrf"), Кука);
	Хороший.Вставить("пресет", "");
	Хороший.Вставить("протокол", "oauth2");
	Хороший.Вставить("авторизация", "https://idp.example.com/authorize");
	Хороший.Вставить("токен", "https://idp.example.com/token");
	Хороший.Вставить("профиль", "https://idp.example.com/user");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Хороший, Кука).КодСостояния < 400,
		"КОНТРОЛЬ: публичный адрес принимается").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПереключательПресетаИСписокИнсталляций

// Наборы полей всех пресетов лежат на странице, но включён РОВНО ОДИН — выбранный
// сервером. Отключённая группа не отправляется браузером, поэтому «мгновенное»
// переключение скриптом не может послать больше, чем переключение ссылкой.
&Тест
Процедура НаборыНевыбранныхПресетовВыключеныИСкрыты() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Для Каждого Ключ Из СтрРазделить(",github,gitlab,google", ",") Цикл

		HTML = Клиент.Тело(Клиент.GETСКукой(АдресФормы(Ключ), Кука));
		Наборы = ОткрывающиеТеги(HTML, "<fieldset class=""choice-set""");
		Пресетные = НаборыУровня(Наборы, Истина);
		Протокольные = НаборыУровня(Наборы, Ложь);

		Ожидаем.Что(Пресетные.Количество(), "наборов пресета ровно столько, сколько пресетов"
			+ " (пресет «" + Ключ + "»)").Равно(4);
		// «свой провайдер» делится ещё раз — по протоколу, и это вложенные наборы
		Ожидаем.Что(Протокольные.Количество(), "внутри «своего провайдера» два набора протокола"
			+ " (пресет «" + Ключ + "»)").Равно(2);

		Включённые = Живые(Пресетные);
		Ожидаем.Что(Включённые.Количество(), "включён ровно один набор пресета (пресет «" + Ключ + "»):"
			+ Символы.ПС + СтрСоединить(Пресетные, Символы.ПС)).Равно(1);
		Ожидаем.Что(СтрНайти(Включённые[0], "data-set=""" + Ключ + """") > 0,
			"включён именно выбранный набор, а не соседний: " + Включённые[0]).ЭтоИстина();

		Ожидаем.Что(Живые(Протокольные).Количество(),
			"и ровно один набор протокола внутри него (пресет «" + Ключ + "»)").Равно(1);

		Для Каждого Тег Из Наборы Цикл
			Если СтрНайти(Тег, " disabled") > 0 Тогда
				Ожидаем.Что(СтрНайти(Тег, " hidden") > 0,
					"выключенный набор ещё и скрыт (иначе он виден, но мёртв): " + Тег).ЭтоИстина();
			КонецЕсли;
		КонецЦикла;

		// пресет едет своим скрытым полем ВНУТРИ набора — второго источника ключа нет
		Поля = ИменаПолейФормы(HTML, АдресРаздела());
		Ожидаем.Что(Поля.Получить("пресет"), "форма отправит ключ выбранного набора").Равно(Ключ);

	КонецЦикла;

КонецПроцедуры

// ЛОВУШКА, ради которой наборы отключаются, а не прячутся стилями: скрытое, но живое поле
// браузер отправляет, и сервер отбил бы форму как «поле не принадлежит пресету».
// Здесь проверяется ОБА конца: браузерная сборка полей чужого не шлёт, а подделанная —
// по-прежнему краснеет.
&Тест
Процедура ПоляВыключенныхНаборовНеДоезжаютДоСервера() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	HTML = Клиент.Тело(Клиент.GETСКукой(АдресФормы("github"), Кука));

	// в РАЗМЕТКЕ поля чужих наборов есть — иначе переключать скрипту было бы нечего
	Ожидаем.Что(СтрНайти(HTML, "name=""издатель""") > 0,
		"КОНТРОЛЬ: поле издателя напечатано (в выключенном наборе «свой провайдер»)").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""базовый""") > 0,
		"КОНТРОЛЬ: и поле адреса инсталляции (в выключенном наборе gitlab)").ЭтоИстина();

	// ...а в ЗАПРОСЕ их нет: браузер отключённую группу не отправляет
	Поля = ИменаПолейФормы(HTML, АдресРаздела());
	Ожидаем.Что(Поля.Получить("издатель"), "издатель в запрос не попадает").Равно(Неопределено);
	Ожидаем.Что(Поля.Получить("базовый"), "и адрес инсталляции тоже").Равно(Неопределено);

	Имя = УникальныеИмена.Имя("traps");
	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("клиент", "Iv1.abcdef");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"форма, собранная как браузером, сохраняется (код " + Ответ.КодСостояния
		+ "; поля: " + СписокКлючей(Поля) + ")").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "oauth2:github") > 0,
		"заведён именно пресетный провайдер: издателя назначил хаб").ЭтоИстина();

	// подделка формы руками — серверная проверка на месте и не ослаблена
	Подделка = ИменаПолейФормы(HTML, АдресРаздела());
	Подделка.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Подделка.Вставить("имя", УникальныеИмена.Имя("trapf"));
	Подделка.Вставить("клиент", "Iv1.abcdef");
	Подделка.Вставить("секрет", "секрет-значение");
	Подделка.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Подделка.Вставить("издатель", "https://evil.example.com");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Подделка, Кука).КодСостояния,
		"поле выключенного набора, присланное вручную, — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), "evil.example.com"),
		"и в разделе его нет").Равно(0);

КонецПроцедуры

// Требование 1: пресет меняет НАБОР ПОЛЕЙ на странице, и это делает сервер — у каждого
// набора свой адрес, JS для переключения не нужен. Поля читаются так, как их собирает
// браузер: содержимое отключённых наборов в запрос не попадает.
&Тест
Процедура ПереключательПресетаМеняетНаборПолейСервером() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Свой = ИменаПолейФормы(Клиент.Тело(Клиент.GETСКукой(АдресФормы(""), Кука)), АдресРаздела());
	Ожидаем.Что(Свой.Получить("издатель") <> Неопределено,
		"свой провайдер показывает издателя").ЭтоИстина();
	Ожидаем.Что(Свой.Получить("метка") <> Неопределено, "и подпись кнопки").ЭтоИстина();
	Ожидаем.Что(Свой.Получить("значок") <> Неопределено, "и значок").ЭтоИстина();

	GitHub = ИменаПолейФормы(Клиент.Тело(Клиент.GETСКукой(АдресФормы("github"), Кука)), АдресРаздела());
	Ожидаем.Что(GitHub.Получить("издатель"), "GitHub издателя не показывает").Равно(Неопределено);
	Ожидаем.Что(GitHub.Получить("метка"), "и подписи кнопки тоже").Равно(Неопределено);
	Ожидаем.Что(GitHub.Получить("значок"), "и значка").Равно(Неопределено);
	Ожидаем.Что(GitHub.Получить("базовый"), "и адреса инсталляции").Равно(Неопределено);
	Ожидаем.Что(GitHub.Получить("клиент") <> Неопределено,
		"КОНТРОЛЬ: client_id остаётся у любого пресета").ЭтоИстина();

	GitLab = Клиент.Тело(Клиент.GETСКукой(АдресФормы("gitlab"), Кука));
	ПоляGitLab = ИменаПолейФормы(GitLab, АдресРаздела());
	Ожидаем.Что(ПоляGitLab.Получить("базовый") <> Неопределено,
		"GitLab показывает адрес инсталляции").ЭтоИстина();
	// требование 3: адрес инсталляции gitlab.com подставлен пресетом, а не вписан в форму
	Ожидаем.Что(ПоляGitLab.Получить("базовый"), "и подставляет gitlab.com").Равно("https://gitlab.com");

	// неизвестный пресет не ломает экран, а показывает «свой провайдер»
	Мусор = ИменаПолейФормы(Клиент.Тело(Клиент.GETСКукой(АдресФормы("нетакого"), Кука)), АдресРаздела());
	Ожидаем.Что(Мусор.Получить("издатель") <> Неопределено,
		"неизвестный пресет — это свой провайдер, а не пустой экран").ЭтоИстина();

КонецПроцедуры

// Области задаёт тот, кому есть что задавать: у своего провайдера форма печатает поле
// с умолчанием, и вписанное в него доезжает до записи и возвращается в форму правки.
// У GitHub поля нет — scope там не средство настройки.
&Тест
Процедура ОбластиЗадаютсяФормойЗаведенияТамГдеОниЕсть() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Ожидаем.Что(ИменаПолейФормы(Клиент.Тело(Клиент.GETСКукой(АдресФормы("github"), Кука)),
		АдресРаздела()).Получить("область"),
		"форма GitHub поля областей не печатает").Равно(Неопределено);

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресФормыПротокола("oidc"), Кука));
	Поля = ИменаПолейФормы(HTML, АдресРаздела());
	Умолчание = Поля.Получить("область");
	Ожидаем.Что(Умолчание <> Неопределено, "форма своего провайдера поле печатает").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Умолчание),
		"и подставляет умолчание: пустое поле означало бы «просить нечего»").ЭтоИстина();

	Имя = УникальныеИмена.Имя("scope");
	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("пресет", "");
	Поля.Вставить("протокол", "oidc");
	Поля.Вставить("издатель", "https://idp.example.com");
	Поля.Вставить("клиент", "own-client");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("область", Умолчание + " teams.read");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"форма с изменёнными областями сохраняется (код " + Ответ.КодСостояния + ")").ЭтоИстина();

	Правка = ИменаПолейФормы(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)),
		АдресРаздела() + "/" + Имя + "/save");
	Ожидаем.Что(Правка.Получить("область"),
		"заданные области стоят в записи и в форме правки").Равно(Умолчание + " teams.read");

КонецПроцедуры

// Требование 1 (сервер): поле, которого пресет не показывает, не принимается, даже если
// подсунуть его формой напрямую.
&Тест
Процедура ПолеВнеПресетаОтбиваетсяСервером() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Поля = ПоляСоздания(УникальныеИмена.Имя("forb"), Кука);
	Поля.Вставить("издатель", "https://evil.example.com");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "издатель в форме пресета — 400").Равно(400);

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "evil.example.com"), "и в разделе его нет").Равно(0);

	// КОНТРОЛЬ: та же форма без запрещённого поля проходит
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(УникальныеИмена.Имя("okforb"), Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: без запрещённого поля заведение проходит").ЭтоИстина();

КонецПроцедуры

// Требование 5: значение значка едет в адрес картинки — принимается только ключ набора.
&Тест
Процедура ПодделанныйКлючЗначкаОтбивается() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Поля = ПоляСвоего(УникальныеИмена.Имя("ico"), Кука);
	Поля.Вставить("значок", "../../openhub.css");
	Ответ = Клиент.POSTФормы(АдресРаздела(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "подделанный ключ значка — 400").Равно(400);

	Имя = УникальныеИмена.Имя("icook");
	Хороший = ПоляСвоего(Имя, Кука);
	Хороший.Вставить("значок", "github");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Хороший, Кука).КодСостояния < 400,
		"КОНТРОЛЬ: ключ из набора принимается").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	ПроверитьЖивойЗначок(Раздел, "github", "значок печатается адресом из таблицы активов");
	Ожидаем.Что(СтрНайти(Раздел, "../../openhub.css"), "подделки в разметке нет").Равно(0);

КонецПроцедуры

// Требование 6: список инсталляций раскрывается нативным <details>, а не скриптом.
&Тест
Процедура СписокИнсталляцийРаскрываетсяБезJS() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("det");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400).ЭтоИстина();

	HTML = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	БезСкриптов = БезТегов(HTML, "<script", "</script>");

	Ожидаем.Что(СтрНайти(БезСкриптов, "<details class=""panel""") > 0,
		"раскрывашка — нативный <details>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<summary class=""panel__head""") > 0,
		"свёрнутая строка — <summary>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, Имя) > 0, "имя провайдера видно свёрнутым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "oauth2:github") > 0, "и издатель").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, АдресРаздела() + "/" + Имя + "/save") > 0,
		"форма правки доступна без скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "type=""submit""") > 0,
		"мутации — обычные кнопки отправки формы").ЭтоИстина();

	// переключатель пресета — ссылки, а не обработчик клика
	Ожидаем.Что(СтрНайти(БезСкриптов, "?preset=github") > 0,
		"у каждого набора полей свой адрес").ЭтоИстина();

КонецПроцедуры

// Экран заведения провайдера с ВЫКЛЮЧЕННЫМ JS: переключатель — ссылки, выбранный набор
// один и включён, выбор помечен для скринридера, форма отправляется обычной кнопкой.
&Тест
Процедура ФормаЗаведенияПереключаетНаборыБезJS() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	БезСкриптов = БезТегов(Клиент.Тело(Клиент.GETСКукой(АдресФормы("gitlab"), Кука)), "<script", "</script>");

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onsubmit="), "и обработчиков отправки тоже").Равно(0);

	Для Каждого Ключ Из СтрРазделить(",github,gitlab,google", ",") Цикл
		Ожидаем.Что(СтрНайти(БезСкриптов, "?preset=" + Ключ + """") > 0,
			"у набора «" + Ключ + "» свой адрес и обычная ссылка").ЭтоИстина();
	КонецЦикла;

	Переключатель = МеждуМаркеров(БезСкриптов, "<div class=""choice-row""", "</div>");
	Ожидаем.Что(СколькоРаз(Переключатель, "aria-current=""true"""),
		"выбранный пресет помечен для скринридера ровно один раз").Равно(1);
	Ожидаем.Что(СтрНайти(Переключатель, "?preset=gitlab"" class=""button button--ghost"" aria-current") > 0,
		"и это именно выбранный сервером набор: " + Переключатель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Переключатель, "role=""group""") > 0,
		"ряд ссылок объявлен группой").ЭтоИстина();

	Наборы = ОткрывающиеТеги(БезСкриптов, "<fieldset class=""choice-set""");
	Ожидаем.Что(Живые(НаборыУровня(Наборы, Истина)).Количество(),
		"без скрипта работоспособен ровно один набор пресета").Равно(1);

	// поля выбранного набора видны и заполнены пресетом, форма отправляется кнопкой
	Поля = ИменаПолейФормы(БезСкриптов, АдресРаздела());
	Ожидаем.Что(Поля.Получить("базовый"), "адрес инсталляции подставлен пресетом")
		.Равно("https://gitlab.com");
	Ожидаем.Что(Поля.Получить("имя") <> Неопределено, "поле имени на месте").ЭтоИстина();
	Ожидаем.Что(Поля.Получить("клиент") <> Неопределено, "и client_id").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "type=""submit""") > 0,
		"заведение — обычная кнопка отправки формы").ЭтоИстина();

КонецПроцедуры

// Требование 2: redirect_uri считается из URL инстанса и отдаётся готовым к копированию;
// незаданный URL инстанса объясняется на экране, а не даёт молча пустой адрес.
&Тест
Процедура АдресВозвратаСчитаетсяИзURLИнстанса() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	// URL инстанса не задан: экран говорит, почему адреса возврата нет
	Пустой = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Пустой, "URL инстанса не задан") > 0,
		"незаданный URL инстанса объяснён на экране").ЭтоИстина();

	Ожидаем.Что(ЗадатьURLИнстанса("https://hub.example.com/", Кука) < 400,
		"URL инстанса сохраняется").ЭтоИстина();

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "https://hub.example.com/oidc/callback") > 0,
		"redirect_uri собран из URL инстанса и показан готовым к копированию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "data-copy=""https://hub.example.com/oidc/callback""") > 0,
		"у блока есть кнопка копирования").ЭтоИстина();

	// пусто в поле возврата = считать автоматически
	Имя = УникальныеИмена.Имя("auto");
	Поля = ПоляСоздания(Имя, Кука);
	Поля.Вставить("возврат", "");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Поля, Кука).КодСостояния < 400,
		"пустое поле возврата принимается: адрес считается сам").ЭтоИстина();

	// заполнено — используется как есть (хаб за прокси с другим внешним адресом)
	Прокси = УникальныеИмена.Имя("proxy");
	ПоляПрокси = ПоляСоздания(Прокси, Кука);
	ПоляПрокси.Вставить("возврат", "https://outer.example.com/oidc/callback");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляПрокси, Кука).КодСостояния < 400).ЭтоИстина();

	После = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(После, "https://outer.example.com/oidc/callback") > 0,
		"ручной адрес возврата остаётся как есть").ЭтоИстина();

	Ожидаем.Что(ЗадатьURLИнстанса("не-адрес", Кука),
		"невалидный URL инстанса отбивается").Равно(400);
	Ожидаем.Что(ЗадатьURLИнстанса("https://hub.example.com/путь/мусор", Кука),
		"и адрес с путём — тоже").Равно(400);

КонецПроцедуры

// Требование 6: провайдер из конфигурации показывается только на чтение, и сервер
// отклоняет попытку его изменить — не разметка, а сервер.
&Тест
Процедура ПровайдерИзКонфигурацииНеПравитсяСервером() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "envonly") > 0,
		"провайдер из окружения виден в списке инсталляций").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, АдресРаздела() + "/envonly/save"),
		"формы правки у него нет").Равно(0);
	Ожидаем.Что(СтрНайти(Раздел, "env-secret-значение"),
		"и секрет из окружения в разметку не попадает").Равно(0);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Раздел));
	Поля.Вставить("клиент", "подменённый-client");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");

	Провалы = "";
	Для Каждого Хвост Из СтрРазделить("/save,/toggle", ",") Цикл
		Ответ = Клиент.POSTФормы(АдресРаздела() + "/envonly" + Хвост, Поля, Кука);
		Если Ответ.КодСостояния < 400 Тогда
			Провалы = Провалы + Символы.ПС + Хвост + " → " + Ответ.КодСостояния;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Провалы, "точки, поддавшиеся правке провайдера из конфигурации:" + Провалы).Равно("");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), "подменённый-client"),
		"подмена не применилась").Равно(0);

КонецПроцедуры

// Экран входа: у пресетного провайдера его значок, у своего — выбранный, у провайдера
// без значка — дежурная иконка набора; кнопки идут стопкой в один столбец.
&Тест
Процедура КнопкиВходаНесутЗначкиИИдутСтолбиком() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Пресетный = УникальныеИмена.Имя("vgh");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Пресетный, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: пресетный провайдер заведён").ЭтоИстина();

	Свой = УникальныеИмена.Имя("vown");
	ПоляСвоегоПровайдера = ПоляСвоего(Свой, Кука);
	ПоляСвоегоПровайдера.Вставить("значок", "google");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСвоегоПровайдера, Кука).КодСостояния < 400,
		"КОНТРОЛЬ: свой провайдер заведён").ЭтоИстина();

	HTML = Клиент.Тело(Клиент.GET("/login"));
	БезСкриптов = БезТегов(HTML, "<script", "</script>");

	ПроверитьЖивойЗначок(БезСкриптов, "github", "у пресетного провайдера его значок");
	ПроверитьЖивойЗначок(БезСкриптов, "google", "у своего провайдера — выбранный в настройках");
	Ожидаем.Что(СтрНайти(БезСкриптов, "class=""button__pic""") > 0,
		"значок печатается картинкой кнопки").ЭтоИстина();

	// провайдер окружения значка не задаёт — у него остаётся дежурная иконка набора
	Ожидаем.Что(СтрНайти(БезСкриптов, "/login/oidc/envonly") > 0,
		"КОНТРОЛЬ: провайдер окружения на странице входа есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<svg") > 0,
		"дежурная иконка набора никуда не делась").ЭтоИстина();

	Ожидаем.Что(СтрНайти(БезСкриптов, "class=""grid grid--1""") > 0,
		"кнопки входа идут стопкой в один столбец").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "button--block") > 0,
		"и растянуты по контейнеру одинаково").ЭтоИстина();

КонецПроцедуры

// «Свой провайдер» с дискавери и без требует РАЗНЫХ полей: при дискавери хаб забирает
// конечные точки из документа издателя, без дискавери издателя назначает сам.
&Тест
Процедура НаборПолейСвоегоПровайдераЗависитОтПротокола() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Дискавери = Клиент.Тело(Клиент.GETСКукой(АдресФормыПротокола("oidc"), Кука));
	ПоляДискавери = ИменаПолейФормы(Дискавери, АдресРаздела());
	Ожидаем.Что(ПоляДискавери.Получить("издатель") <> Неопределено,
		"при дискавери форма отправляет издателя").ЭтоИстина();
	Ожидаем.Что(ПоляДискавери.Получить("протокол"), "и сам протокол — скрытым полем набора")
		.Равно("oidc");
	Для Каждого Точка Из СтрРазделить("авторизация,токен,профиль,письма", ",") Цикл
		Ожидаем.Что(ПоляДискавери.Получить(Точка),
			"конечная точка «" + Точка + "» при дискавери не отправляется").Равно(Неопределено);
	КонецЦикла;

	Без = Клиент.Тело(Клиент.GETСКукой(АдресФормыПротокола("oauth2"), Кука));
	ПоляБез = ИменаПолейФормы(Без, АдресРаздела());
	Ожидаем.Что(ПоляБез.Получить("издатель"),
		"без дискавери издателя назначает хаб — поля нет").Равно(Неопределено);
	Ожидаем.Что(ПоляБез.Получить("протокол")).Равно("oauth2");
	Для Каждого Точка Из СтрРазделить("авторизация,токен,профиль", ",") Цикл
		Ожидаем.Что(ПоляБез.Получить(Точка) <> Неопределено,
			"конечная точка «" + Точка + "» без дискавери отправляется").ЭтоИстина();
	КонецЦикла;

	// требование 3: обязательность объявлена РАЗМЕТКОЙ, а не только сервером
	Ожидаем.Что(СтрНайти(ОбластьНабора(Без, "oauth2"), "name=""авторизация"" required") > 0,
		"конечная точка авторизации помечена обязательной").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОбластьНабора(Дискавери, "oidc"), "name=""издатель"" required") > 0,
		"а при дискавери обязателен издатель").ЭтоИстина();

	// требование 4: переключение — обычные ссылки, работает без скрипта
	БезСкриптов = БезТегов(Без, "<script", "</script>");
	Ожидаем.Что(СтрНайти(БезСкриптов, "?preset=&amp;protocol=oidc") > 0,
		"у набора дискавери свой адрес").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "?preset=&amp;protocol=oauth2"" class=""button button--ghost"" aria-current") > 0,
		"а выбранный помечен для скринридера").ЭтоИстина();

КонецПроцедуры

// Выбор протокола делается ДО того, как форма покажет поля, поэтому подсказка обязана
// назвать разницу: какой режим требует издателя, а какой — конечных точек. Подсказка
// стоит под переключателем и печатается в обоих режимах: она нужна для выбора, а не
// после него.
&Тест
Процедура ПереключательПротоколаОбъясняетРазницуРежимов() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Для Каждого Протокол Из СтрРазделить("oidc,oauth2", ",") Цикл

		HTML = Клиент.Тело(Клиент.GETСКукой(АдресФормыПротокола(Протокол), Кука));
		Режим = "режим «" + Протокол + "»: ";

		Дискавери = СтрНайти(HTML, "/.well-known/openid-configuration");
		Ожидаем.Что(Дискавери > 0, Режим + "подсказка называет документ дискавери").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "только издатель (issuer)") > 0,
			Режим + "и единственное обязательное поле режима с дискавери").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "авторизации, токена и профиля") > 0,
			Режим + "и обязательные конечные точки режима без дискавери").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "издателя хаб назначает сам") > 0,
			Режим + "и то, откуда без дискавери берётся издатель").ЭтоИстина();

		Переключатель = СтрНайти(HTML, "data-sets=""protocol""");
		Ожидаем.Что(Переключатель > 0 И Переключатель < Дискавери,
			Режим + "подсказка стоит под переключателем протокола").ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

// Требование 5: сервер первичен — поле чужого протокола отбивается, даже если разметка
// его не показывала.
&Тест
Процедура ПолеЧужогоПротоколаОтбиваетсяСервером() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	СТочкой = ПоляСвоего(УникальныеИмена.Имя("dsc"), Кука, "oidc");
	СТочкой.Вставить("токен", "https://idp.example.com/token");
	Ответ = Клиент.POSTФормы(АдресРаздела(), СТочкой, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "конечная точка при дискавери — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "не относится к протоколу") > 0,
		"отказ назван протоколом").ЭтоИстина();

	СИздателем = ПоляСвоего(УникальныеИмена.Имя("oa"), Кука, "oauth2");
	СИздателем.Вставить("издатель", "https://evil.example.com");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), СИздателем, Кука).КодСостояния,
		"издатель без дискавери — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука)), "evil.example.com"),
		"и в разделе его нет").Равно(0);

	// КОНТРОЛЬ: оба набора в своём протоколе заводятся
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСвоего(УникальныеИмена.Имя("okd"), Кука, "oidc"), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: дискавери").ЭтоИстина();
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСвоего(УникальныеИмена.Имя("oko"), Кука, "oauth2"), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: без дискавери").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПравкаИГвардыИзРазметки

&Тест
Процедура ПравкаСобственнойФормойРаздела() Экспорт

