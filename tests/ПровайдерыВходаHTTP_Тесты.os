	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), Кука));
	Ожидаем.Что(СтрНайти(Раздел, "правка-состоялась") > 0,
		"изменяемое поле применилось — значит правка действительно состоялась").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Раздел, "правка с лишними полями"),
		"подпись кнопки пресета телом правки не перебивается").Равно(0);
	Ожидаем.Что(СтрНайти(Раздел, "oauth2:github") > 0,
		"издатель остался синтетическим издателем пресета").ЭтоИстина();
	Для Каждого Ядовитый Из СтрРазделить("evil.example.com,169.254.169.254,10.0.0.5", ",") Цикл
		Ожидаем.Что(СтрНайти(Раздел, Ядовитый), "в разделе нет <" + Ядовитый + ">").Равно(0);
	КонецЦикла;

	Плохой = ПоляСоздания(УникальныеИмена.Имя("extra2"), Кука);
	Плохой.Вставить("пресет", "");
	Плохой.Вставить("протокол", "oauth2");
	Плохой.Вставить("авторизация", "https://idp.example.com/authorize");
	Плохой.Вставить("токен", "https://10.0.0.5/token");
	Плохой.Вставить("профиль", "https://idp.example.com/user");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), Плохой, Кука).КодСостояния,
		"КОНТРОЛЬ: при заведении приватный адрес — 400").Равно(400);

КонецПроцедуры

&Тест
Процедура ОбычныйПользовательНеМутируетНиОднуТочку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Имя = УникальныеИмена.Имя("guard");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, КукаАдмина), КукаАдмина).КодСостояния < 400,
		"КОНТРОЛЬ: админ завёл").ЭтоИстина();

	ТокенАлисы = ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings", КукаАлисы)));

	Точки = Новый Массив();
	Точки.Добавить(АдресРаздела());
	Точки.Добавить(АдресРаздела() + "/" + Имя + "/save");
	Точки.Добавить(АдресРаздела() + "/" + Имя + "/toggle");
	Точки.Добавить(АдресРаздела() + "/" + Имя + "/delete");

	Провалы = "";
	Для Каждого Точка Из Точки Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", ТокенАлисы);
		Поля.Вставить("имя", Имя);
		Поля.Вставить("включить", "0");
		Ответ = Клиент.POSTФормы(Точка, Поля, КукаАлисы);
		Если Ответ.КодСостояния < 400 Тогда
			Провалы = Провалы + Символы.ПС + Точка + " → " + Ответ.КодСостояния;
		КонецЕсли;
	КонецЦикла;

	Раздел = Клиент.Тело(Клиент.GETСКукой(АдресРаздела(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Раздел, Имя) > 0, "провайдер не удалён Алисой").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", ТолькоТокен(КукаАдмина),
		КукаАдмина).КодСостояния < 400, "КОНТРОЛЬ: админ удаляет").ЭтоИстина();

	Ожидаем.Что(Провалы, "точки, поддавшиеся обычному пользователю:" + Провалы).Равно("");

КонецПроцедуры

&Тест
Процедура БезCSRFНеПроходитНиОднаТочкаМутации() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("nocsrf");
	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела(), ПоляСоздания(Имя, Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: заведение прошло").ЭтоИстина();

	Провалы = "";
	Для Каждого Хвост Из СтрРазделить("/save,/toggle,/delete", ",") Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("имя", Имя);
		Поля.Вставить("включить", "0");
		Ответ = Клиент.POSTФормы(АдресРаздела() + "/" + Имя + Хвост, Поля, Кука);
		Если Ответ.КодСостояния < 400 Тогда
			Провалы = Провалы + Символы.ПС + Хвост + " → " + Ответ.КодСостояния;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Клиент.POSTФормы(АдресРаздела() + "/" + Имя + "/delete", ТолькоТокен(Кука), Кука).КодСостояния < 400,
		"КОНТРОЛЬ: с CSRF удаление проходит").ЭтоИстина();

	Ожидаем.Что(Провалы, "точки без CSRF:" + Провалы).Равно("");

КонецПроцедуры

&Тест
Процедура GETНаМутирующиеТочкиНеМутирует() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Имя = УникальныеИмена.Имя("getm");
