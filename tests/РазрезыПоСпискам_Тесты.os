// Разрезы по спискам идентификаторов, которыми экраны заменили вопрос на строку: пакеты,
// учётки, лента и агрегаты скачиваний. В каждой таблице лежат строки, которые разрез
// ОБЯЗАН отсеять, — иначе пропущенный вид сравнения вернул бы всё.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;        // общий контейнер на все тесты набора

Перем Пакеты;
Перем Учётки;
Перем Лента;
Перем Агрегаты;

Перем Сейчас;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнерИЗасеятьДанные() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("данные", "Классы"));

	ПоискКлассов.ПодключитьВсе(КаталогКлассовDb);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "разрезы-по-спискам-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет 2, соответствие деталек — 3: файл настроек
	// переименовывается в несуществующий, иначе набор уедет на КоннекторJSON и общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("разрезы-по-спискам-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Пакеты = Поделка.НайтиЖелудь("ХранилищеПакетов");
	Учётки = Поделка.НайтиЖелудь("ХранилищеПользователей");
	Лента = Поделка.НайтиЖелудь("ХранилищеЛичныхУведомлений");
	Агрегаты = Поделка.НайтиЖелудь("ХранилищеСкачиванийАгрегатов");

	Сейчас = ТекущаяУниверсальнаяДата();

КонецПроцедуры

#Область ПакетыСписком

// Экран кабинета спрашивает пакеты грантов и своих публикаций разом: рядом лежит пакет,
// которого в списке нет, — вид сравнения «В» обязан его отсеять.
&Тест
Процедура ПакетыЧитаютсяСпискомИдентификаторов() Экспорт

	Первый = ДобавитьПакет(1, "спис-один");
	Второй = ДобавитьПакет(1, "спис-два");
	ДобавитьПакет(1, "спис-мимо");

	Список = Новый Массив();
	Список.Добавить(Первый.Идентификатор);
	Список.Добавить(Второй.Идентификатор);
	Список.Добавить(999999);

	Найденные = Пакеты.ПакетыПоИдентификаторам(Список);
	Ожидаем.Что(Найденные.Количество(), "два названных пакета, третий идентификатор ничей").Равно(2);
	Ожидаем.Что(Имена(Найденные), "имена названных пакетов").Равно("спис-два,спис-один");

	Ожидаем.Что(Пакеты.ПакетыПоИдентификаторам(Новый Массив()).Количество(),
		"пустой список — пустая выдача, а не вся таблица").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область УчёткиСписком

// Сводка входящих называет заявителя каждой строки: учётки спрашиваются разом, и чужая
// учётка рядом в выдачу попадать не должна.
&Тест
Процедура УчёткиЧитаютсяСпискомИдентификаторов() Экспорт

	Первая = ДобавитьУчётку("разрез-один");
	Вторая = ДобавитьУчётку("разрез-два");
	ДобавитьУчётку("разрез-мимо");

	Список = Новый Массив();
	Список.Добавить(Первая.Идентификатор);
	Список.Добавить(Вторая.Идентификатор);
	Список.Добавить(999999);

	Найденные = Учётки.ПоИдентификаторам(Список);
	Ожидаем.Что(Найденные.Количество(), "две названные учётки, третий идентификатор ничей").Равно(2);
	Ожидаем.Что(Найденные.Получить(Цел(Первая.Идентификатор)).Логин, "учётка по ключу разреза")
		.Равно("разрез-один");
	Ожидаем.Что(Найденные.Получить(999999), "ненайденного ключа в разрезе нет").Равно(Неопределено);

	Ожидаем.Что(Учётки.ПоИдентификаторам(Новый Массив()).Количество(),
		"пустой список — пустая выдача, а не вся таблица").Равно(0);

КонецПроцедуры

// Вопрос «в хабе уже кто-то есть» задаётся на каждой странице кабинета и обязан стоить
// одной строки, а не всей таблицы учёток.
&Тест
Процедура ЕстьХотяБыОднаОтвечаетПоОднойСтроке() Экспорт

	ДобавитьУчётку("разрез-онбординг");

	Ожидаем.Что(Учётки.ЕстьХотяБыОдна(), "учётки заведены").ЭтоИстина();
	Ожидаем.Что(Учётки.Количество() > 0, "КОНТРОЛЬ: и полная выборка того же мнения").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЛентаИАгрегаты

// Виджету ленты нужны и верхние строки, и счёт непрочитанного: один срез, упорядоченный
// базой. Прочитанное и чужая лента в него попадать не должны.
&Тест
Процедура НепрочитанноеСвежимиПервымиОтсеиваетПрочитанноеИЧужое() Экспорт

	Адресат = ДобавитьУчётку("лента-адресат");
	Чужой = ДобавитьУчётку("лента-чужой");

	ДобавитьУведомление(Адресат.Идентификатор, "старое", Сейчас - 300, Ложь);
	ДобавитьУведомление(Адресат.Идентификатор, "свежее", Сейчас - 100, Ложь);
	ДобавитьУведомление(Адресат.Идентификатор, "прочитанное", Сейчас - 10, Истина);
	ДобавитьУведомление(Чужой.Идентификатор, "чужое", Сейчас - 5, Ложь);

	Срез = Лента.НепрочитанныеСвежимиПервыми(Адресат.Идентификатор);

	Ожидаем.Что(Заголовки(Срез), "свежие первыми, прочитанное и чужое отсеяны")
		.Равно("свежее,старое");
	Ожидаем.Что(Лента.НепрочитанныеСвежимиПервыми(999999).Количество(),
		"у учётки без ленты пусто").Равно(0);

КонецПроцедуры

// Счётчики скачиваний блока «Мои пакеты» спрашиваются по показанной горстке: чужой пакет
// рядом в разрез попадать не должен.
&Тест
Процедура АгрегатыЧитаютсяСпискомПакетов() Экспорт

	Агрегаты.Накопить(7001, 1, НачалоСуток(Сейчас), 3);
	Агрегаты.Накопить(7002, 2, НачалоСуток(Сейчас), 5);
	Агрегаты.Накопить(7003, 3, НачалоСуток(Сейчас), 7);

	Список = Новый Массив();
	Список.Добавить(7001);
	Список.Добавить(7002);

	Найденные = Агрегаты.АгрегатыПакетов(Список);
	Ожидаем.Что(Найденные.Количество(), "агрегаты двух названных пакетов").Равно(2);
	Ожидаем.Что(СуммаСтрок(Найденные), "чужой пакет в сумму не попал").Равно(8);

	Ожидаем.Что(Агрегаты.АгрегатыПакетов(Новый Массив()).Количество(),
		"пустой список — пустая выдача, а не вся таблица").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ДобавитьПакет(Знач ПулИдентификатор, Знач Имя)

	Пакет = Пакеты.СоздатьЭлемент();
	Пакет.ПулИдентификатор = ПулИдентификатор;
	Пакет.Имя = Имя;
	Пакет.ИмяНижнийРегистр = НРег(Имя);
	Пакет.Описание = "";
	Пакет.Устарел = Ложь;
	Пакет.Скрыт = Ложь;
	Пакет.Создан = Сейчас;
	Пакет.Сохранить();
	Возврат Пакет;

КонецФункции

Функция ДобавитьУчётку(Знач Логин)

	Учётка = Учётки.СоздатьЭлемент();
	Учётка.Логин = Логин;
	Учётка.Email = Логин + "@ex.com";
	Учётка.Активен = Истина;
	Учётка.РольХаба = "user";
	Учётка.ТребуетсяСменаПароля = Ложь;
	Учётка.Создан = Сейчас;
	Учётка.Сохранить();
	Возврат Учётка;

КонецФункции

Функция ДобавитьУведомление(Знач ПользовательИдентификатор, Знач Заголовок, Знач Создано,
	Знач Прочитано)

	Запись = Лента.СоздатьЭлемент();
	Запись.ПользовательИдентификатор = ПользовательИдентификатор;
	Запись.Повод = "проба";
	Запись.Заголовок = Заголовок;
	Запись.Текст = "";
	Запись.Ссылка = "";
	Запись.Прочитано = Прочитано;
	Запись.Создано = Создано;
	Запись.Сохранить();
	Возврат Запись;

КонецФункции

Функция НачалоСуток(Знач Момент)
	Возврат Дата(Год(Момент), Месяц(Момент), День(Момент), 0, 0, 0);
КонецФункции

// Имена выборки одной строкой, отсортированные: порядок выдачи «В» коннектор не обещает.
Функция Имена(Знач Записи)

	Отсортированные = Новый СписокЗначений();
	Для Каждого Запись Из Записи Цикл
		Отсортированные.Добавить(Строка(Запись.Имя));
	КонецЦикла;
	Отсортированные.СортироватьПоЗначению();

	Значения = Новый Массив();
	Для Каждого Элемент Из Отсортированные Цикл
		Значения.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Значения, ",");

КонецФункции

Функция Заголовки(Знач Записи)

	Значения = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Значения.Добавить(Строка(Запись.Заголовок));
	КонецЦикла;
	Возврат СтрСоединить(Значения, ",");

КонецФункции

Функция СуммаСтрок(Знач Записи)

	Итог = 0;
	Для Каждого Запись Из Записи Цикл
		Итог = Итог + Запись.Количество;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти
