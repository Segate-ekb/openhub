// ИСТ-АПСТ-001: канон адреса источника. Один адрес, записанный по-разному, обязан дать
// одну строку — на этом стоит «мелочи записи не плодят вторую запись источника».
// Здесь же сверяется, что тем же каноном сличают источники пула (ПорядокАпстримов)
// и адреса подписок вебхука (ХранениеПодпискиВебхука), и что составные части адреса
// одинаково видят все три судящие двери.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Адреса;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "РазборАдреса");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "реестр", "Классы"), "ПорядокАпстримов");

КонецПроцедуры

&ПередКаждым
Процедура СобратьРазбор() Экспорт
	Адреса = Новый РазборАдреса();
КонецПроцедуры

// Один адрес чужого хаба, записанный семью способами, — одна запись источника.
#Область ОдинАдресОднаЗапись

&Тест
Процедура ПортПоУмолчаниюВтороеИсточникаНеЗаводит() Экспорт

	Ожидаем.Что(Адреса.Каноничный("https://хаб.example:443/download/"),
		"явные :443 у https — тот же адрес").Равно(Адреса.Каноничный("https://хаб.example/download/"));
	Ожидаем.Что(Адреса.Каноничный("http://хаб.example:80/download/"),
		"явные :80 у http — тот же адрес").Равно(Адреса.Каноничный("http://хаб.example/download/"));

КонецПроцедуры

&Тест
Процедура НестандартныйПортОстаётсяОтдельнымИсточником() Экспорт

	Ожидаем.Что(Адреса.Каноничный("https://хаб.example:8443/download/") =
		Адреса.Каноничный("https://хаб.example/download/"),
		"хаб на 8443 — другой хаб, и запись у него своя").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТочечныеСегментыПутиСхлопываются() Экспорт

	Канон = Адреса.Каноничный("https://хаб.example/download/");

	Ожидаем.Что(Адреса.Каноничный("https://хаб.example/download/./"),
		"«./» пути не добавляет").Равно(Канон);
	Ожидаем.Что(Адреса.Каноничный("https://хаб.example/pub/../download/"),
		"«../» поднимает на уровень").Равно(Канон);

КонецПроцедуры

&Тест
Процедура РазноеПроцентноеКодированиеСходитсяКОдному() Экспорт

	Ожидаем.Что(Адреса.Каноничный("https://хаб.example/download/%7euser/"),
		"регистр шестнадцатеричных цифр значения не меняет")
		.Равно(Адреса.Каноничный("https://хаб.example/download/%7Euser/"));
	Ожидаем.Что(Адреса.Каноничный("https://хаб.example/download/%7Euser/"),
		"незарезервированный символ кодировать незачем")
		.Равно(Адреса.Каноничный("https://хаб.example/download/~user/"));

КонецПроцедуры

&Тест
Процедура ЗарезервированныйСимволИзКодировкиНеВыходит() Экспорт

	// «%2F» это слеш ВНУТРИ сегмента: раскодируй его — и адрес станет указывать
	// на другой ресурс
	Ожидаем.Что(Адреса.Каноничный("https://хаб.example/download/a%2Fb"),
		"слеш остаётся закодированным").Содержит("%2F");

КонецПроцедуры

&Тест
Процедура РегистрСхемыИХостаЗначенияНеИмеет() Экспорт

	Ожидаем.Что(Адреса.Каноничный("HTTPS://Хаб.EXAMPLE/download/"),
		"схема и хост сличаются без регистра")
		.Равно(Адреса.Каноничный("https://хаб.example/download/"));

КонецПроцедуры

&Тест
Процедура РегистрПутиЗначениеИмеет() Экспорт

	Ожидаем.Что(Адреса.Каноничный("https://хаб.example/Download/") =
		Адреса.Каноничный("https://хаб.example/download/"),
		"чужой хаб вправе различать /Download/ и /download/").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ХвостовойСлешОстаётсяКакНабран() Экспорт

	Ожидаем.Что(Адреса.Каноничный("https://хаб.example/download") =
		Адреса.Каноничный("https://хаб.example/download/"),
		"о чужом контракте не гадаем: хвостовой слеш пишет мейнтейнер").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПробелыПоКраямСнимаются() Экспорт

	Ожидаем.Что(Адреса.Каноничный("  https://хаб.example/download/  "),
		"вставленный из буфера адрес несёт пробелы")
		.Равно(Адреса.Каноничный("https://хаб.example/download/"));

КонецПроцедуры

&Тест
Процедура НеразбираемыйАдресВозвращаетсяКакЕсть() Экспорт

	// канон ничего не отвергает — отказ со словами это дело валидатора
	Ожидаем.Что(Адреса.Каноничный("хаб.example/download/"),
		"адрес без схемы остаётся собой").Равно("хаб.example/download/");
	Ожидаем.Что(Адреса.Каноничный("не адрес вовсе"),
		"строка, которая адресом не является, тоже").Равно("не адрес вовсе");
	Ожидаем.Что(Адреса.Каноничный(""), "пустое остаётся пустым").Равно("");

КонецПроцедуры

// Адрес подписки с «?a=<b>» ссылкой по RFC не является, но дублем по регистру хоста
// быть обязан: так было до перевода канона на библиотеку, и так должно остаться.
&Тест
Процедура НеразбираемыйАдресВсёЖеТеряетРегистрСхемыИУзла() Экспорт

	Ожидаем.Что(Адреса.Каноничный("HTTPS://ХАБ.example/?a=<b>"),
		"регистр схемы и узла не различает и негодный адрес")
		.Равно(Адреса.Каноничный("https://хаб.example/?a=<b>"));
	Ожидаем.Что(Адреса.Каноничный("HTTPS://ХАБ.example/?a=<b>"),
		"а путь и запрос остаются как набраны").Равно("https://хаб.example/?a=<b>");

КонецПроцедуры

#КонецОбласти

// Тот же канон сличает источники пула: иначе идемпотентность заведения держалась бы
// на своём правиле, разошедшемся с общим.
#Область КаноннымСличаютИсточникиПула

&Тест
Процедура ИсточникНаходитсяПоЛюбойЗаписиТогоЖеАдреса() Экспорт

	Нумерация = Новый ПорядокАпстримов(Адреса);
	Список = Новый Массив();
	Список.Добавить(Новый Структура("Url", "https://хаб.example/download/"));

	Записи = Новый Массив();
	Записи.Добавить("https://ХАБ.example:443/download/");
	Записи.Добавить("https://хаб.example/download/./");
	Записи.Добавить("https://хаб.example/pub/../download/");
	Записи.Добавить("  https://хаб.example/download/  ");

	Для Каждого Запись Из Записи Цикл
		Ожидаем.Что(Нумерация.НайтиПоАдресу(Список, Запись) <> Неопределено,
			"«" + Запись + "» — тот же источник, а не второй").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ДругойАдресНаходитсяНеБудет() Экспорт

	Нумерация = Новый ПорядокАпстримов(Адреса);
	Список = Новый Массив();
	Список.Добавить(Новый Структура("Url", "https://хаб.example/download/"));

	Чужие = Новый Массив();
	Чужие.Добавить("https://хаб.example:8443/download/");
	Чужие.Добавить("https://иной.example/download/");
	Чужие.Добавить("http://хаб.example/download/");
	Чужие.Добавить("https://хаб.example/pub/");

	Для Каждого Чужой Из Чужие Цикл
		Ожидаем.Что(Нумерация.НайтиПоАдресу(Список, Чужой) = Неопределено,
			"«" + Чужой + "» — другой источник").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// Составные части адреса — то, чем судят схему, userinfo и хост все три двери.
#Область СоставныеЧастиАдреса

&Тест
Процедура СхемаИХостЧитаютсяВНижнемРегистре() Экспорт

	Части = Адреса.СхемаИУзел("HTTPS://Хаб.EXAMPLE:8443/download/");

	Ожидаем.Что(Части.СхемаЕсть, "схема в строке есть").ЭтоИстина();
	Ожидаем.Что(Части.Схема, "схема — в нижнем регистре").Равно("https");
	Ожидаем.Что(Части.Хост, "хост — в нижнем регистре и без порта").Равно("хаб.example");
	Ожидаем.Что(Части.СДаннымиПользователя, "userinfo в адресе нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЛитералIPv6ЧитаетсяБезСкобок() Экспорт

	// сети адрес нужен сам, а не литерал ссылки: в скобках его не узнает ни одна политика
	Ожидаем.Что(Адреса.СхемаИУзел("https://[2001:DB8::1]:8443/x").Хост,
		"скобки литерала — часть ссылки, а не адреса").Равно("2001:db8::1");

КонецПроцедуры

&Тест
Процедура UserinfoВидноДажеПустым() Экспорт

	Ожидаем.Что(Адреса.СхемаИУзел("https://кто:пароль@хаб.example/x").СДаннымиПользователя,
		"user:pass@ — это userinfo").ЭтоИстина();
	Ожидаем.Что(Адреса.СхемаИУзел("https://@хаб.example/x").СДаннымиПользователя,
		"пустое userinfo прячет настоящий хост так же успешно").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтсутствиеСхемыИХостаНазываетсяОтдельно() Экспорт

	БезСхемы = Адреса.СхемаИУзел("хаб.example/download/");
	Ожидаем.Что(БезСхемы.СхемаЕсть, "схемы в строке нет").ЭтоЛожь();
	Ожидаем.Что(БезСхемы.Хост, "и хоста тоже").Равно("");

	БезХоста = Адреса.СхемаИУзел("https://");
	Ожидаем.Что(БезХоста.СхемаЕсть, "схема названа").ЭтоИстина();
	Ожидаем.Что(БезХоста.Хост, "а хоста нет — дверь скажет об этом своими словами").Равно("");

КонецПроцедуры

// Судят двери УЗЕЛ, а не путь: «?a=<b>» ссылкой по RFC не является, но хост в таком
// адресе читается — и отвергать его дверь не обязана (иначе сторож экранирования
// подписки лишился бы своего опасного адреса).
&Тест
Процедура НеразбираемыйПутьХостуНеМешает() Экспорт

	Части = Адреса.СхемаИУзел("https://хаб.example/?a=<b>&c=""d""");

	Ожидаем.Что(Части.СхемаЕсть, "схема в строке есть").ЭтоИстина();
	Ожидаем.Что(Части.Хост, "хост прочитан").Равно("хаб.example");
	Ожидаем.Что(Части.СДаннымиПользователя, "userinfo в адресе нет").ЭтоЛожь();

КонецПроцедуры

// А вот негодный УЗЕЛ хоста не даёт: именно он решает, куда пойдёт запрос.
&Тест
Процедура НегодныйУзелХостаНеДаёт() Экспорт

	Ожидаем.Что(Адреса.СхемаИУзел("https://х|аб.example/путь").Хост,
		"узел не разбирается — хоста нет").Равно("");
	Ожидаем.Что(Адреса.СхемаИУзел("https://").Хост,
		"узла нет вовсе").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ХвостВыдачи

&Тест
Процедура ХвостовойСегментОтрезаетсяТолькоСвой() Экспорт

	Ожидаем.Что(Адреса.БезХвостовогоСегмента("https://хаб.example/api/v1/pools/p/download/", "/download"),
		"хаб на подпути теряет только сегмент выдачи")
		.Равно("https://хаб.example/api/v1/pools/p");
	Ожидаем.Что(Адреса.БезХвостовогоСегмента("https://download.example/", "/download"),
		"имя хоста сегментом пути не является").Равно("https://download.example");
	Ожидаем.Что(Адреса.БезХвостовогоСегмента("https://хаб.example/pub/", "/download"),
		"чужой хвост не трогаем").Равно("https://хаб.example/pub");

КонецПроцедуры

#КонецОбласти

#Область УправляющиеСимволы

&Тест
Процедура УправляющийСимволНазываетсяИменем() Экспорт

	Ожидаем.Что(Адреса.НайтиУправляющий("https://хаб.example/a b"),
		"пробел назван словом, а не подставлен в текст").Равно("пробел");
	Ожидаем.Что(Адреса.НайтиУправляющий("https://хаб.example/a" + Символы.ВК + "b"),
		"CR назван кодом: подставить его значило бы повторить инъекцию").Равно("код 13");
	Ожидаем.Что(Адреса.НайтиУправляющий("https://хаб.example/ок"),
		"в чистом адресе управляющих символов нет").Равно("");

КонецПроцедуры

#КонецОбласти
