// Самотест фикстуры ЗасевРеестра: на ней стоят наборы слоя данных, и засев, который
// кладёт в базу не то, делает их зелёными на выпотрошенных запросах. Проверяется
// не сама фикстура на себе, а то, ЧТО ВИДЯТ хранилища после засева.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;        // общий контейнер на все тесты набора
Перем Засев;          // фикстура ЗасевРеестра — пул, пакет и версия в базе

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КлассыДанных = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("данные", "Классы"));

	ПоискКлассов.ПодключитьВсе(КлассыДанных);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "засев-реестра-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("засев-реестра-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);

КонецПроцедуры

&Тест
Процедура ЗасеянныйПулЧитаетсяХранилищемПоИмени() Экспорт

	Пул = Засев.Пул("самотест-пул", "private", "user");

	Найденный = Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Пул.Идентификатор);

	Ожидаем.Что(Найденный, "пул лёг в базу").Существует();
	Ожидаем.Что(Найденный.Имя, "имя пула").Равно("самотест-пул");
	Ожидаем.Что(Найденный.Видимость, "видимость пула").Равно("private");
	Ожидаем.Что(Найденный.Тип, "тип пула").Равно("user");

КонецПроцедуры

&Тест
Процедура ПакетЛожитсяВНазванныйПулИКанонИмениЗаполнен() Экспорт

	Пул = Засев.Пул();

	Пакет = Засев.Пакет(Пул, "СамоТест");

	Найденный = Желудь("ХранилищеПакетов").НайтиПоИмени(Пул.Идентификатор, "самотест");
	Ожидаем.Что(Найденный, "пакет ищется по канону имени").Существует();
	Ожидаем.Что(Найденный.Идентификатор, "тот самый пакет").Равно(Пакет.Идентификатор);
	Ожидаем.Что(Найденный.Имя, "имя как записано").Равно("СамоТест");

КонецПроцедуры

// Пул называется набору то записью, то идентификатором — обе формы обязаны класть
// пакет в один и тот же пул.
&Тест
Процедура ПулНазываетсяЗаписьюЛибоИдентификатором() Экспорт

	Пул = Засев.Пул();

	ПоЗаписи = Засев.Пакет(Пул);
	ПоЧислу = Засев.Пакет(Пул.Идентификатор);

	Ожидаем.Что(ПоЗаписи.ПулИдентификатор, "пакет по записи пула").Равно(Пул.Идентификатор);
	Ожидаем.Что(ПоЧислу.ПулИдентификатор, "пакет по идентификатору пула").Равно(Пул.Идентификатор);

КонецПроцедуры

// Semver-колонки — не украшение: по ним хаб сортирует версии, и версия с нулями
// вместо разрядов встанет в выдаче не туда.
&Тест
Процедура ВерсияРаскладываетсяПоSemverКолонкам() Экспорт

	Пакет = Засев.Пакет(Засев.Пул());

	Версия = Засев.Версия(Пакет, "2.15.7");

	Прочитанная = Желудь("ХранилищеВерсийПакета")
		.ПолучитьОдноПоИдентификаторРавно(Версия.Идентификатор);
	Ожидаем.Что(Прочитанная.Версия, "номер версии").Равно("2.15.7");
	Ожидаем.Что(Прочитанная.SemverМажор, "мажор").Равно(2);
	Ожидаем.Что(Прочитанная.SemverМинор, "минор").Равно(15);
	Ожидаем.Что(Прочитанная.SemverПатч, "патч").Равно(7);
	Ожидаем.Что(Прочитанная.Отозвана, "версия не отозвана").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтозваннаяВерсияСохраняетПризнак() Экспорт

	Пакет = Засев.Пакет(Засев.Пул());

	Засев.Версия(Пакет, "1.0.0", Истина);

	Действующие = Желудь("ХранилищеВерсийПакета").ДействующиеВерсии(Пакет.Идентификатор);
	Ожидаем.Что(Действующие.Количество(), "отозванная версия из действующих ушла").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолныйЗасевСвязываетПулПакетИВерсию() Экспорт

	Тройка = Засев.ПулПакетВерсия("связка", "3.1.4");

	Ожидаем.Что(Тройка.Пакет.ПулИдентификатор, "пакет в своём пуле")
		.Равно(Тройка.Пул.Идентификатор);
	Ожидаем.Что(Тройка.Версия.ПакетИдентификатор, "версия у своего пакета")
		.Равно(Тройка.Пакет.Идентификатор);

	Найденные = Желудь("ХранилищеВерсийПакета")
		.ПолучитьПоПакетИдентификаторРавно(Тройка.Пакет.Идентификатор);
	Ожидаем.Что(Найденные.Количество(), "версия видна хранилищу").Равно(1);
	Ожидаем.Что(Найденные[0].Версия, "номер версии").Равно("3.1.4");

КонецПроцедуры

// Имя по умолчанию обязано быть уникальным: одноимённые пулы в одной базе не живут,
// а набор, засевающий три пула подряд, имён им не придумывает.
&Тест
Процедура ИменаПоУмолчаниюНеСталкиваются() Экспорт

	Первый = Засев.Пул();
	Второй = Засев.Пул();
	Пакет = Засев.Пакет(Первый);
	Соседний = Засев.Пакет(Первый);

	Ожидаем.Что(Первый.Имя <> Второй.Имя, "два пула — два имени").ЭтоИстина();
	Ожидаем.Что(Пакет.Имя <> Соседний.Имя, "два пакета — два имени").ЭтоИстина();

КонецПроцедуры

// Засевов в наборе может быть несколько, и общего счётчика у них нет: свобода имени
// проверяется ПО ТАБЛИЦЕ. Счётчик экземпляра дал бы здесь два пула «pool-1» — молча,
// потому что уникальность имени пула держит сервисный слой, а не база.
&Тест
Процедура ДваЗасеваВОдномНабореНеДаютОдноимённыхПулов() Экспорт

	Первый = Новый ЗасевРеестра(Поделка);
	Второй = Новый ЗасевРеестра(Поделка);

	ПулПервого = Первый.Пул();
	ПулВторого = Второй.Пул();

	Ожидаем.Что(ПулПервого.Имя <> ПулВторого.Имя,
		СтрШаблон("два засева дали пулам разные имена (%1 и %2)",
			ПулПервого.Имя, ПулВторого.Имя)).ЭтоИстина();

	Одноимённые = 0;
	Для Каждого Пул Из Желудь("ХранилищеПулов").Все() Цикл
		Если Пул.Имя = ПулПервого.Имя Тогда
			Одноимённые = Одноимённые + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Одноимённые, "в таблице ровно один пул с этим именем").Равно(1);

КонецПроцедуры

// Пакеты уникальны в пределах пула: одно и то же имя в соседнем пуле — законная фактура,
// и засев не имеет права её избегать.
&Тест
Процедура ПакетыСоседнихПуловМогутБытьОдноимённы() Экспорт

	Первый = Засев.Пул();
	Второй = Засев.Пул();

	ПакетПервого = Засев.Пакет(Первый);
	ПакетВторого = Засев.Пакет(Второй);

	Ожидаем.Что(ПакетВторого.Имя, "в пустом соседнем пуле имя начинается сначала")
		.Равно(ПакетПервого.Имя);

КонецПроцедуры

// Легаси-четвёрка и пререлиз не разбираются в semver — хаб оставляет там нули,
// и фикстура обязана вести себя так же, а не падать.
&Тест
Процедура НеразборчивыйНомерДаётНулиАНеПадение() Экспорт

	Пакет = Засев.Пакет(Засев.Пул());

	Версия = Засев.Версия(Пакет, "3.4.4.0-rc");

	Ожидаем.Что(Версия.Версия, "номер сохранён как есть").Равно("3.4.4.0-rc");
	Ожидаем.Что(Версия.SemverМажор, "мажор разобран").Равно(3);
	Ожидаем.Что(Версия.SemverПатч, "патч разобран").Равно(4);

КонецПроцедуры

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции
