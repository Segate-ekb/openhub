// Самотест фикстуры ЗасевРеестра: на ней стоят наборы реестра, и засев, который кладёт
// в базу не то, делает их зелёными на выпотрошенных запросах. Проверяется не сама фикстура
// на себе, а то, ЧТО ВИДЯТ хранилища и службы хаба после засева — обе двери, и строкой,
// и службами.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;     // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;          // общий контейнер на все тесты набора
Перем Засев;            // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба
Перем КореньХранилища;  // временный корень файлового хранилища артефактов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьСлоиРеестра(Модули);

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-засев-реестра-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "засев-реестра-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("засев-реестра-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт

	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Хранилища и службы реестра: дверь «строкой» живёт на первых, дверь «службами» — на вторых,
// и самотест обязан видеть обе. Реестру нужен бэкенд артефактов (занятое пулом меряется
// по хранилищу) и SSRF-гейт апстримов, который СервисПулов требует обязательным швом.
Процедура ПодключитьСлоиРеестра(Знач Модули)

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));
	ПоискКлассов.ПодключитьОснову(Модули);

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

КонецПроцедуры

&Тест
Процедура ЗасеянныйПулЧитаетсяХранилищемПоИмени() Экспорт

	Пул = Засев.Пул("самотест-пул", "private", "user");

	Найденный = Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Пул.Идентификатор);

	Ожидаем.Что(Найденный, "пул лёг в базу").Существует();
	Ожидаем.Что(Найденный.Имя, "имя пула").Равно("самотест-пул");
	Ожидаем.Что(Найденный.Видимость, "видимость пула").Равно("private");
	Ожидаем.Что(Найденный.Тип, "тип пула").Равно("user");

КонецПроцедуры

&Тест
Процедура ПакетЛожитсяВНазванныйПулИКанонИмениЗаполнен() Экспорт

	Пул = Засев.Пул();

	Пакет = Засев.Пакет(Пул, "СамоТест");

	Найденный = Желудь("ХранилищеПакетов").НайтиПоИмени(Пул.Идентификатор, "самотест");
	Ожидаем.Что(Найденный, "пакет ищется по канону имени").Существует();
	Ожидаем.Что(Найденный.Идентификатор, "тот самый пакет").Равно(Пакет.Идентификатор);
	Ожидаем.Что(Найденный.Имя, "имя как записано").Равно("СамоТест");

КонецПроцедуры

// Пул называется набору то записью, то идентификатором — обе формы обязаны класть
// пакет в один и тот же пул.
&Тест
Процедура ПулНазываетсяЗаписьюЛибоИдентификатором() Экспорт

	Пул = Засев.Пул();

	ПоЗаписи = Засев.Пакет(Пул);
	ПоЧислу = Засев.Пакет(Пул.Идентификатор);

	Ожидаем.Что(ПоЗаписи.ПулИдентификатор, "пакет по записи пула").Равно(Пул.Идентификатор);
	Ожидаем.Что(ПоЧислу.ПулИдентификатор, "пакет по идентификатору пула").Равно(Пул.Идентификатор);

КонецПроцедуры

// Semver-колонки — не украшение: по ним хаб сортирует версии, и версия с нулями
// вместо разрядов встанет в выдаче не туда.
&Тест
Процедура ВерсияРаскладываетсяПоSemverКолонкам() Экспорт

	Пакет = Засев.Пакет(Засев.Пул());

	Версия = Засев.Версия(Пакет, "2.15.7");

	Прочитанная = Желудь("ХранилищеВерсийПакета")
		.ПолучитьОдноПоИдентификаторРавно(Версия.Идентификатор);
	Ожидаем.Что(Прочитанная.Версия, "номер версии").Равно("2.15.7");
	Ожидаем.Что(Прочитанная.SemverМажор, "мажор").Равно(2);
	Ожидаем.Что(Прочитанная.SemverМинор, "минор").Равно(15);
	Ожидаем.Что(Прочитанная.SemverПатч, "патч").Равно(7);
	Ожидаем.Что(Прочитанная.Отозвана, "версия не отозвана").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтозваннаяВерсияСохраняетПризнак() Экспорт

	Пакет = Засев.Пакет(Засев.Пул());

	Засев.Версия(Пакет, "1.0.0", Истина);

	Действующие = Желудь("ХранилищеВерсийПакета").ДействующиеВерсии(Пакет.Идентификатор);
	Ожидаем.Что(Действующие.Количество(), "отозванная версия из действующих ушла").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолныйЗасевСвязываетПулПакетИВерсию() Экспорт

	Тройка = Засев.ПулПакетВерсия("связка", "3.1.4");

	Ожидаем.Что(Тройка.Пакет.ПулИдентификатор, "пакет в своём пуле")
		.Равно(Тройка.Пул.Идентификатор);
	Ожидаем.Что(Тройка.Версия.ПакетИдентификатор, "версия у своего пакета")
		.Равно(Тройка.Пакет.Идентификатор);

	Найденные = Желудь("ХранилищеВерсийПакета")
		.ПолучитьПоПакетИдентификаторРавно(Тройка.Пакет.Идентификатор);
	Ожидаем.Что(Найденные.Количество(), "версия видна хранилищу").Равно(1);
	Ожидаем.Что(Найденные[0].Версия, "номер версии").Равно("3.1.4");

КонецПроцедуры

// Имя по умолчанию обязано быть уникальным: одноимённые пулы в одной базе не живут,
// а набор, засевающий три пула подряд, имён им не придумывает.
&Тест
Процедура ИменаПоУмолчаниюНеСталкиваются() Экспорт

	Первый = Засев.Пул();
	Второй = Засев.Пул();
	Пакет = Засев.Пакет(Первый);
	Соседний = Засев.Пакет(Первый);

	Ожидаем.Что(Первый.Имя <> Второй.Имя, "два пула — два имени").ЭтоИстина();
	Ожидаем.Что(Пакет.Имя <> Соседний.Имя, "два пакета — два имени").ЭтоИстина();

КонецПроцедуры

// Засевов в наборе может быть несколько, и общего счётчика у них нет: свобода имени
// проверяется ПО ТАБЛИЦЕ. Счётчик экземпляра дал бы здесь два пула «pool-1» — молча,
// потому что уникальность имени пула держит сервисный слой, а не база.
&Тест
Процедура ДваЗасеваВОдномНабореНеДаютОдноимённыхПулов() Экспорт

	Первый = Новый ЗасевРеестра(Поделка);
	Второй = Новый ЗасевРеестра(Поделка);

	ПулПервого = Первый.Пул();
	ПулВторого = Второй.Пул();

	Ожидаем.Что(ПулПервого.Имя <> ПулВторого.Имя,
		СтрШаблон("два засева дали пулам разные имена (%1 и %2)",
			ПулПервого.Имя, ПулВторого.Имя)).ЭтоИстина();

	Одноимённые = 0;
	Для Каждого Пул Из Желудь("ХранилищеПулов").Все() Цикл
		Если Пул.Имя = ПулПервого.Имя Тогда
			Одноимённые = Одноимённые + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Одноимённые, "в таблице ровно один пул с этим именем").Равно(1);

КонецПроцедуры

// Пакеты уникальны в пределах пула: одно и то же имя в соседнем пуле — законная фактура,
// и засев не имеет права её избегать.
&Тест
Процедура ПакетыСоседнихПуловМогутБытьОдноимённы() Экспорт

	Первый = Засев.Пул();
	Второй = Засев.Пул();

	ПакетПервого = Засев.Пакет(Первый);
	ПакетВторого = Засев.Пакет(Второй);

	Ожидаем.Что(ПакетВторого.Имя, "в пустом соседнем пуле имя начинается сначала")
		.Равно(ПакетПервого.Имя);

КонецПроцедуры

// Легаси-четвёрка и пререлиз не разбираются в semver — хаб оставляет там нули,
// и фикстура обязана вести себя так же, а не падать.
&Тест
Процедура НеразборчивыйНомерДаётНулиАНеПадение() Экспорт

	Пакет = Засев.Пакет(Засев.Пул());

	Версия = Засев.Версия(Пакет, "3.4.4.0-rc");

	Ожидаем.Что(Версия.Версия, "номер сохранён как есть").Равно("3.4.4.0-rc");
	Ожидаем.Что(Версия.SemverМажор, "мажор разобран").Равно(3);
	Ожидаем.Что(Версия.SemverПатч, "патч разобран").Равно(4);

КонецПроцедуры

// Дверь «службами хаба» отличается от двери «строкой» не оформлением, а последствиями:
// пул, заведённый службой, получает квоту хаба, а не безлимит, — и набор, который потом
// проверяет на нём предел публикации, обязан видеть именно её.
&Тест
Процедура ПулСлужбойПолучаетКвотуХабаАСтрокойБезлимит() Экспорт

	Служебный = Засев.ПулСервисом();
	Строкой = Засев.Пул();

	Ожидаем.Что(Служебный.КвотаМб, "квота пула хаба").Равно(Желудь("КвотаПула").КакВХабе());
	Ожидаем.Что(Строкой.КвотаМб, "квота пула строкой").Равно(0);

КонецПроцедуры

// Имя пула хаб канонизирует, и пакет ищется в нём по канону: пул, заведённый службой,
// обязан вести себя так же, как заведённый администратором.
&Тест
Процедура ПулИПакетСлужбойКанонизируютИмена() Экспорт

	Пул = Засев.ПулСервисом("SelfTest-Pool");

	Пакет = Засев.ПакетСервисом(Пул, "SelfTest-Package");

	Ожидаем.Что(Пул.Имя, "имя пула в каноне").Равно("selftest-pool");
	Ожидаем.Что(Желудь("СервисПулов").НайтиПул("SELFTEST-POOL"), "пул ищется службой").Существует();
	Ожидаем.Что(Пакет.ПулИдентификатор, "пакет в своём пуле").Равно(Пул.Идентификатор);
	Ожидаем.Что(Пакет.ИмяНижнийРегистр, "канон имени пакета").Равно("selftest-package");

КонецПроцедуры

// Имена по умолчанию у службы такие же свободные, как у строки: набор, засевающий
// два пула подряд, имён им не придумывает, а служба одноимённый пул отвергает исключением.
&Тест
Процедура ИменаПоУмолчаниюСлужбыНеСталкиваются() Экспорт

	Первый = Засев.ПулСервисом();
	Второй = Засев.ПулСервисом();

	Ожидаем.Что(Первый.Имя <> Второй.Имя, "два пула — два имени").ЭтоИстина();
	Ожидаем.Что(Засев.ПакетСервисом(Первый).Имя <> Засев.ПакетСервисом(Первый).Имя,
		"два пакета одного пула — два имени").ЭтоИстина();

КонецПроцедуры

// Что набор назвал двери, то и должно доехать до хаба: приватность пула, его владелец
// и карточка пакета. Параметр, потерянный по дороге, оставляет набор зелёным на пуле,
// которого он не заказывал, — публичном вместо приватного и ничей вместо своего.
&Тест
Процедура ДверьСлужбыДоноситВидимостьВладельцаИКарточкуПакета() Экспорт

	Хозяин = 77;

	Пул = Засев.ПулСервисом("selftest-closed", "private", Хозяин);
	Пакет = Засев.ПакетСервисом(Пул, "selftest-carded",
		Новый Структура("Описание, Лицензия", "карточка засева", "MIT"));

	Ожидаем.Что(Пул.Видимость, "видимость пула дошла до хаба").Равно("private");
	Ожидаем.Что(Цел(Пул.ВладелецИдентификатор), "владелец пула дошёл до хаба").Равно(Хозяин);
	Ожидаем.Что(Пакет.Описание, "карточка пакета дошла до хаба").Равно("карточка засева");

КонецПроцедуры

// Основной пул хаба ровно один, и повторный спрос его не пересоздаёт: иначе набор,
// зовущий фикстуру в каждом тесте, получал бы каждый раз новый основной пул.
&Тест
Процедура ОсновнойПулЗаводитсяОдинРазИНазначенНаХабе() Экспорт

	Первый = Засев.ОсновнойПул();
	Повторный = Засев.ОсновнойПул();

	Ожидаем.Что(Первый.Идентификатор, "тот же основной пул").Равно(Повторный.Идентификатор);
	Ожидаем.Что(Первый.ЭтоДефолтный(), "признак основного пула стоит").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПулов").ДефолтныйПул().Идентификатор,
		"хаб видит его основным").Равно(Первый.Идентификатор);

КонецПроцедуры

// Пул, положенный строкой, службы хаба видят так же, как заведённый ими: иначе набор,
// смешавший двери, читал бы пустоту.
&Тест
Процедура ПулСтрокойВиденСлужбамХаба() Экспорт

	Пул = Засев.Пул("selftest-row");

	Найденный = Желудь("СервисПулов").НайтиПул("selftest-row");

	Ожидаем.Что(Найденный, "служба видит пул, положенный строкой").Существует();
	Ожидаем.Что(Найденный.Идентификатор, "тот самый пул").Равно(Пул.Идентификатор);

КонецПроцедуры

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции
