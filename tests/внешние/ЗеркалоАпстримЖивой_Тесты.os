// Перечисление версий против живого hub.oscript.io: разбор на настоящей разметке апстрима
// (тег «внешние» и OSHUB_MIRROR_LIVE).

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогMirror;
Перем КаталогObservability;
Перем КаталогProxy;
Перем КаталогNet;
Перем КаталогМодулей;
Перем КаталогРеестра;

&ТестовыйНабор(Характер = "Одиночка")
&Тег("внешние")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогМодулей = КаталогиПроекта.Модули();
	КаталогMirror = ОбъединитьПути(КаталогМодулей, "зеркала", "Классы");
	КаталогObservability = ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "журнал");
	КаталогProxy = ОбъединитьПути(КаталогМодулей, "прокси", "Классы");
	КаталогNet = ОбъединитьПути(КаталогМодулей, "сеть", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогMirror, "ИсточникАпстримаOpm");
	ПоискКлассов.Подключить(КаталогMirror, "КореньАпстрима");
	ПоискКлассов.Подключить(КаталогРеестра, "АллоулистИмён");
	ПоискКлассов.Подключить(КаталогProxy, "РазборВерсийПакета");
	// токен источника легаси-протокол спрашивает сам, даже когда зеркало анонимно
	ПоискКлассов.Подключить(КаталогProxy, "СекретИсточника");
	ПоискКлассов.Подключить(КаталогObservability, "ОбезличиваниеЖурнала");
	// примитивы основы спрашивает почти каждый класс проекта, и перечисление их по одному
	// роняет набор на каждом новом примитиве — причём не утверждением, а незагрузкой
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.Подключить(КаталогProxy, "КлиентАпстрима");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	// ожидание похода наружу клиент апстрима создаёт сам, если его не внедрили
	ПоискКлассов.Подключить(КаталогNet, "ТаймаутыHTTP");
	ПоискКлассов.Подключить(КаталогРеестра, "МаскаИмениПакета");
	ПоискКлассов.Подключить(КаталогРеестра, "СравнительВерсий");
	ПоискКлассов.Подключить(КаталогРеестра, "РазобраннаяВерсия");
	ПоискКлассов.Подключить(КаталогРеестра, "РазобранныйДиапазон");
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_MIRROR_LIVE""))")
Процедура ЖивоеПеречислениеРеальногоХаба() Экспорт

	Перечень = Источник().Перечислить(
		Зеркало("https://hub.oscript.io/download/", "[""asserts""]"), 10);

	Ожидаем.Что(Перечень.Код, "реальный list.txt отдан").Равно(200);
	Ожидаем.Что(Перечень.Элементы.Количество() > 1,
		"реальный хаб перечислил НЕ ОДНУ версию пакета").ЭтоИстина();
	Ожидаем.Что(Перечень.Элементы[0].ВерсияИзвестна, "версия известна из перечня").ЭтоИстина();
	Ожидаем.Что(Перечень.Элементы[0].ПутьСкачивания,
		"путь версионный").Равно(СтрШаблон("asserts/asserts-%1.ospx", Перечень.Элементы[0].Версия));

КонецПроцедуры

// Версионный артефакт апстрима действительно скачивается по построенному пути —
// иначе перечень версий был бы перечнем несуществующих адресов.
&Тест
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_MIRROR_LIVE""))")
Процедура ЖивоеСкачиваниеВерсииСРеальногоХаба() Экспорт

	Источник_ = Источник();
	Зеркало_ = Зеркало("https://hub.oscript.io/download/", "[""asserts""]");

	Перечень = Источник_.Перечислить(Зеркало_, 10);
	Файл = ПолучитьИмяВременногоФайла("ospx");
	Результат = Источник_.Скачать(Зеркало_, Перечень.Элементы[Перечень.Элементы.ВГраница()], Файл);

	Ожидаем.Что(Результат.Код, "самая старая версия пакета отдана апстримом").Равно(200);
	Ожидаем.Что(Новый Файл(Файл).Размер() > 0, "артефакт непустой").ЭтоИстина();
	УдалитьФайлы(Файл);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Источник()
	Возврат Новый ИсточникАпстримаOpm(
		Новый КлиентАпстрима(Новый КлиентHTTP(), НастройкиПрокси(30), Логирование.ПолучитьЛог("тест.oshub")),
		Новый РазборВерсийПакета(Новый СравнительВерсий()), Неопределено,
		Новый КореньАпстрима(Новый РазборАдреса()), Новый АллоулистИмён(),
		Логирование.ПолучитьЛог("тест.oshub"));
КонецФункции

Функция Зеркало(Знач URL, Знач ФильтрJSON)
	Возврат Новый Структура("АпстримURL, ФильтрJSON", URL, ФильтрJSON);
КонецФункции

#КонецОбласти

// Настройки прокси для прямой сборки вне контейнера: таймаут — параметром.
Функция НастройкиПрокси(Знач Таймаут)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси(Таймаут);
	Возврат Настройки;
КонецФункции
