// Хаб на S3 отдаёт пакет в 40 МБ из кэша выдачи байт в байт, и попадание не поднимает его в память:
// пик RSS хаба по ходу скачивания из кэша выше исходного меньше чем на половину размера пакета.
// Включается OSHUB_S3_SMOKE; адрес, бакет, регион и ключи — из OSHUB_STORAGE_S3_*.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем Хаб;            // фикстура ЭкземплярХаба
Перем Клиент;         // фикстура КлиентХаба
Перем Память;         // фикстура ЗамерПамятиХаба
Перем ТокенАдмина;
Перем КаталогСборки;  // Строка - сборка .ospx и скачанного
Перем КаталогКэша;    // Строка - файловый кэш выдачи поднятого хаба
Перем ПрефиксПрогона; // Строка - префикс ключей хаба в корзине; всё под ним убирается после набора

&ТестовыйНабор(Характер = "Одиночка")
&Тег("внешние")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабНаS3() Экспорт

	Если НЕ S3Доступен() Тогда
		Возврат;
	КонецЕсли;

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("ЗамерПамятиХаба");
	РеестрФикстур.Подключить("КлассыСлоя");
	ПодключитьКлиентКорзины();

	Хаб = Новый ЭкземплярХаба(60);
	Клиент = Новый КлиентХаба(Хаб, 180);
	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-rss-s3");
	КаталогКэша = НовыйКаталогСборки();

	// префикс свой на прогон: всё под ним набор уберёт за собой
	ПрефиксПрогона = "rss-" + Лев(Строка(Новый УникальныйИдентификатор), 8) + "/";
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_STORAGE_BACKEND", "s3");
	Окружение.Вставить("OSHUB_STORAGE_S3_PREFIX", ПрефиксПрогона);
	Окружение.Вставить("OSHUB_CACHE_ARTIFACTS_DIR", КаталогКэша);
	Окружение.Вставить("OSHUB_SEED_FIXTURE", ОбъединитьПути(КаталогиПроекта.Фикстуры(), "spike0c-testpkg-0.1.0.ospx"));
	Окружение.Вставить("OSHUB_SEED_POOL", "public");
	Окружение.Вставить("OSHUB_ADMIN_LOGIN", "root");
	Окружение.Вставить("OSHUB_ADMIN_PASSWORD", "RootPassw0rd");
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UPLOAD__BYTES", "67108864");
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UNPACKED__BYTES", "268435456");
	Хаб.ВыключитьФон();
	Хаб.Поднять("oshub-rss-s3", Окружение, "ЗасеятьПакет.os");

	ТокенАдмина = Клиент.ВыпуститьPAT(Клиент.ВойтиДождавшись("root", "RootPassw0rd"));
	Память = Новый ЗамерПамятиХаба(Хаб, НовыйКаталогСборки());

	// разогрев: первые промах и попадание грузят код выдачи и кэша, а не байты пакета
	ОпубликоватьИСкачатьДважды("warm-pkg", 1048576);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХабИУбратьЗаСобой() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	Если ЗначениеЗаполнено(ПрефиксПрогона) Тогда
		УбратьОбъектыПрогона();
	КонецЕсли;
	Если КаталогСборки <> Неопределено Тогда
		УникальныеИмена.УбратьВременное(КаталогСборки);
	КонецЕсли;
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗначениеЗаполнено(ПолучитьПеременнуюСреды(""OSHUB_S3_SMOKE""))",
	Причина = "не задана переменная окружения OSHUB_S3_SMOKE (нет доступного MinIO/S3)")
Процедура ПопаданиеКэшаВыдачиОтдаётПакетБезПодъёмаВПамять() Экспорт

	Размер = 40 * 1048576;
	Пакет = Новый ФикстураПакета().ПостроитьТяжёлыйOspx(НовыйКаталогСборки(), "rss-s3-pkg", "1.0.0", Размер);
	Клиент.Опубликовать("public", Пакет, ТокенАдмина);

	Промах = Скачать("rss-s3-pkg", "rss-s3-pkg-1.0.0.ospx");
	Ожидаем.Что(ДождатьсяВКэше(Новый Файл(Пакет).Размер()), "самотест: промах положил пакет в кэш выдачи")
		.ЭтоИстина();

	ДоПопадания = Память.Текущая();
	Замер = Память.НачатьПик();
	Попадание = Скачать("rss-s3-pkg", "rss-s3-pkg-1.0.0.ospx");
	Итог = Память.ИтогПика(Замер);

	Эталон = Sha256Файла(Пакет);
	Ожидаем.Что(Sha256Файла(Промах), "промах отдал опубликованные байты").Равно(Эталон);
	Ожидаем.Что(Sha256Файла(Попадание), "попадание отдало те же байты").Равно(Эталон);
	Ожидаем.Что(Итог.Опросов, "самотест: RSS опрошен по ходу попадания").БольшеИлиРавно(3);
	Ожидаем.Что(Итог.Пик - ДоПопадания < Размер / 2,
		СтрШаблон("попадание: RSS хаба %1, пик %2 байт за %3 опросов", ДоПопадания, Итог.Пик, Итог.Опросов))
		.ЭтоИстина();

КонецПроцедуры

#Область Служебные

Функция S3Доступен()
	Возврат ЗначениеЗаполнено(ПолучитьПеременнуюСреды("OSHUB_S3_SMOKE"));
КонецФункции

// Корзину набор чистит сам, клиентом хаба: зависимости клиента — классы основы и хранилища.
Процедура ПодключитьКлиентКорзины()
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьОснову(КаталогиПроекта.Модули());
	КлассыХранилища = ОбъединитьПути(КаталогиПроекта.Модули(), "хранилище", "Классы");
	Для Каждого ИмяКласса Из СтрРазделить("ВердиктОтветаS3,СрокОтветаOint,КлиентS3Oint", ",") Цикл
		ПоискКлассов.Подключить(КлассыХранилища, ИмяКласса);
	КонецЦикла;
КонецПроцедуры

// Всё, что хаб прогона положил в корзину, лежит под префиксом прогона.
Процедура УбратьОбъектыПрогона()

	Корзина = Новый КлиентS3Oint(
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_ENDPOINT"),
		ИзОкружения("OSHUB_STORAGE_S3_REGION", "us-east-1"),
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_BUCKET"),
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_ACCESS__KEY"),
		ПолучитьПеременнуюСреды("OSHUB_STORAGE_S3_SECRET__KEY"),
		Истина, Логирование.ПолучитьЛог("тест.oshub.s3"));

	Для Каждого Объект Из Корзина.Перечислить(ПрефиксПрогона) Цикл
		Корзина.Удалить(Объект.Ключ);
	КонецЦикла;

КонецПроцедуры

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура ОпубликоватьИСкачатьДважды(Знач ИмяПакета, Знач Размер)
	Пакет = Новый ФикстураПакета().ПостроитьТяжёлыйOspx(НовыйКаталогСборки(), ИмяПакета, "1.0.0", Размер);
	Клиент.Опубликовать("public", Пакет, ТокенАдмина);
	Скачать(ИмяПакета, ИмяПакета + "-1.0.0.ospx");
	Скачать(ИмяПакета, ИмяПакета + "-1.0.0.ospx");
КонецПроцедуры

Функция Скачать(Знач ИмяПакета, Знач ИмяФайла)
	Скачанное = ОбъединитьПути(НовыйКаталогСборки(), ИмяФайла);
	Ответ = Клиент.Соединение().Получить(
		Новый HTTPЗапрос(СтрШаблон("/api/v1/pools/public/download/%1/%2", ИмяПакета, ИмяФайла)), Скачанное);
	Ожидаем.Что(Ответ.КодСостояния, "версия отдаётся").Равно(200);
	Возврат Скачанное;
КонецФункции

// Промах отдаёт клиенту растущий файл загрузки, а в кэш готовый файл ложится фоном чуть позже:
// сумма и копия 40 МБ занимают секунды после того, как клиент дочитал тело.
Функция ДождатьсяВКэше(Знач Размер)
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
	Пока НЕ ЛежитВКэше(Размер) Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > Предел Тогда
			Возврат Ложь;
		КонецЕсли;
		Приостановить(200);
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Запись кэша — файл ровно того размера, что опубликованный пакет.
Функция ЛежитВКэше(Знач Размер)
	Для Каждого Запись Из НайтиФайлы(КаталогКэша, "*.cache") Цикл
		Если Запись.Размер() = Размер Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция Sha256Файла(Знач Путь)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.ДобавитьФайл(Путь);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Функция НовыйКаталогСборки()
	Каталог = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Возврат Каталог;
КонецФункции

#КонецОбласти
