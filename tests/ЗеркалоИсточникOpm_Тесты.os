// Тесты источника апстрима по контракту opm: перечисление пакетов и их версий, адрес
// страницы версий, фильтр масок, лимит цикла, деградация к latest и offline.
// Сети не требуют — живой синк вынесен в ЗеркалоАпстримЖивой_Тесты.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогMirror;
Перем КаталогПрокси;
Перем КаталогCommon;
Перем КаталогРеестра;
Перем КаталогФикстур;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогMirror = ОбъединитьПути(КаталогМодулей, "зеркала", "Классы");
	КаталогПрокси = ОбъединитьПути(КаталогМодулей, "прокси", "Классы");
	КаталогCommon = ОбъединитьПути(КаталогМодулей, "основа", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогПрокси, "СекретИсточника");
	ПоискКлассов.Подключить(КаталогMirror, "ИсточникАпстримаOpm");
	ПоискКлассов.Подключить(КаталогMirror, "КореньАпстрима");
	ПоискКлассов.Подключить(КаталогMirror, "ФильтрИмёнЗеркала");
	ПоискКлассов.Подключить(КаталогПрокси, "РазборВерсийПакета");
	ПоискКлассов.Подключить(КаталогРеестра, "МаскаИмениПакета");
	Подключить(ОбъединитьПути(КаталогРеестра, "СравнительВерсий.os"), "СравнительВерсий");
	Подключить(ОбъединитьПути(КаталогРеестра, "РазобраннаяВерсия.os"), "РазобраннаяВерсия");
	Подключить(ОбъединитьПути(КаталогРеестра, "РазобранныйДиапазон.os"), "РазобранныйДиапазон");
	Подключить(ОбъединитьПути(КаталогФикстур, "ФейкКлиентАпстрима.os"), "ФейкКлиентАпстрима");
	Подключить(ОбъединитьПути(КаталогФикстур, "СчётчикОтметок.os"), "СчётчикОтметок");
КонецПроцедуры

// Ядро дефекта: list.txt даёт только имена, и зеркало забирало latest каждого пакета.
// Перечень версий читается со страницы пакета, и элемент синка заводится на КАЖДУЮ.
&Тест
Процедура ПеречислениеОтдаётВсеВерсииПакета() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");
	Клиент.УстановитьОтветТекстПоПути("package/alfa", 200, Страница("alfa", "1.2.0,1.1.0,1.0.0"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 200);

	Ожидаем.Что(Перечень.Элементы.Количество(), "элемент на каждую версию пакета").Равно(3);
	Ожидаем.Что(ВерсииПеречня(Перечень), "версии перечислены по убыванию").Равно("1.2.0,1.1.0,1.0.0");
	Ожидаем.Что(Перечень.Элементы[0].ВерсияИзвестна, "версия известна до скачивания").ЭтоИстина();
	Ожидаем.Что(Перечень.Элементы[0].ПутьСкачивания, "путь версионный, а не latest")
		.Равно("alfa/alfa-1.2.0.ospx");
	Ожидаем.Что(Перечень.Элементы[2].ПутьСкачивания).Равно("alfa/alfa-1.0.0.ospx");

КонецПроцедуры

&Тест
Процедура СкачиваниеИдётПоВерсионномуПути() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");
	Клиент.УстановитьОтветТекстПоПути("package/alfa", 200, Страница("alfa", "1.2.0"));
	Источник_ = Источник(Клиент);

	Перечень = Источник_.Перечислить(Зеркало(""), 200);
	Источник_.Скачать(Зеркало(""), Перечень.Элементы[0]);

	Ожидаем.Что(Клиент.ПутиЗапросов()[Клиент.ПутиЗапросов().ВГраница()],
		"качается именно версионный артефакт").Равно("alfa/alfa-1.2.0.ospx");

КонецПроцедуры

// Деградация, а не потеря пакета: без перечня версий за пакетом остаётся latest-элемент.
// Страница пакета — сосед выдачи, а не корня сайта: у хаба на подпути
// ("/api/v1/pools/{pool}/download/") корень отдаёт 404, и все версии молча терялись бы.
&Тест
Процедура СтраницаВерсийСпрашиваетсяРядомСВыдачейНаПодпути() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");
	Клиент.УстановитьОтветТекстПоПути("package/alfa", 200, Страница("alfa", "1.0.0"));
	Апстрим = "https://corp.example/api/v1/pools/main/download/";

	Перечень = Источник(Клиент).Перечислить(ЗеркалоURL(Апстрим, ""), 200);

	Ожидаем.Что(Клиент.БазыЗапросов()[0], "список берётся у самой выдачи").Равно(Апстрим);
	Ожидаем.Что(Клиент.ПутиЗапросов()[1], "страница пакета").Равно("package/alfa");
	Ожидаем.Что(Клиент.БазыЗапросов()[1], "путь хаба сохранён, отрезан только сегмент выдачи")
		.Равно("https://corp.example/api/v1/pools/main");
	Ожидаем.Что(Перечень.Элементы[0].ВерсияИзвестна, "версии хаба на подпути перечислены").ЭтоИстина();

КонецПроцедуры

// Имя хоста сегментом выдачи не считается, иначе от адреса осталась бы схема.
&Тест
Процедура ХостСИменемDownloadНеОбрезается() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");

	Источник(Клиент).Перечислить(ЗеркалоURL("https://download/", ""), 200);

	Ожидаем.Что(Клиент.БазыЗапросов()[1], "хост не тронут").Равно("https://download");

КонецПроцедуры

// База не по контракту opm (без хвостового "download") — не гадаем: страница
// спрашивается относительно самой базы, промах даёт штатную деградацию к latest.
&Тест
Процедура БазаБезСегментаВыдачиОстаётсяКакЕсть() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");

	Источник(Клиент).Перечислить(ЗеркалоURL("https://corp.example/myhub/", ""), 200);

	Ожидаем.Что(Клиент.БазыЗапросов()[1], "путь базы сохранён целиком")
		.Равно("https://corp.example/myhub");

КонецПроцедуры

&Тест
Процедура ПакетБезСтраницыВерсийОстаётсяLatest() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");
	Клиент.УстановитьОтветТекстПоПути("package/alfa", 404, "");

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 200);

	Ожидаем.Что(Перечень.Элементы.Количество(), "пакет не потерян").Равно(1);
	Ожидаем.Что(Перечень.Элементы[0].ПутьСкачивания, "путь latest").Равно("alfa/alfa.ospx");
	Ожидаем.Что(Перечень.Элементы[0].ВерсияИзвестна, "версия неизвестна до скачивания").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СтраницаБезСсылокНаВерсииОставляетLatest() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");
	Клиент.УстановитьОтветТекстПоПути("package/alfa", 200, "<html><body>пусто</body></html>");

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 200);

	Ожидаем.Что(Перечень.Элементы.Количество(), "пакет не потерян").Равно(1);
	Ожидаем.Что(Перечень.Элементы[0].ВерсияИзвестна, "разбор ничего не дал — latest").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СбойСтраницыОдногоПакетаНеРоняетПеречисление() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa" + Символы.ПС + "beta");
	Клиент.УстановитьСбойПоПути("package/alfa");
	Клиент.УстановитьОтветТекстПоПути("package/beta", 200, Страница("beta", "2.0.0,1.0.0"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 200);

	Ожидаем.Что(Перечень.Элементы.Количество(), "сбойный пакет — latest, соседний — все версии").Равно(3);
	Ожидаем.Что(Перечень.Элементы[0].ВерсияИзвестна, "у сбойного пакета версия неизвестна").ЭтоЛожь();
	Ожидаем.Что(Перечень.Элементы[1].ИмяПакета).Равно("beta");
	Ожидаем.Что(Перечень.Элементы[2].ВерсияИзвестна, "сосед перечислен полностью").ЭтоИстина();

КонецПроцедуры

// Знаменатель обхода — ИМЕНА апстрима после фильтра, и считается он по ВСЕМУ списку,
// а не по текущей порции: иначе доля упирается в сто процентов на конце каждого цикла
// и падает в начале следующего.
&Тест
Процедура ПеречислениеОтдаётШкалуОбходаПоИменам() Экспорт

	Клиент = КлиентСоСписком(СтрСоединить(СтрРазделить("a,b,c,d,e", ","), Символы.ПС));
	Источник_ = Источник(Клиент);

	Первая = Источник_.Перечислить(Зеркало(""), 2);
	Вторая = Источник_.Перечислить(Зеркало(""), 2, Первая.Курсор);
	Третья = Источник_.Перечислить(Зеркало(""), 2, Вторая.Курсор);

	Ожидаем.Что(Первая.ИменВсего, "знаменатель — весь список, а не порция").Равно(5);
	Ожидаем.Что(Первая.ИменПройдено, "с начала обхода пройдено ноль").Равно(0);
	Ожидаем.Что(Вторая.ИменВсего, "знаменатель между порциями не скачет").Равно(5);
	Ожидаем.Что(Вторая.ИменПройдено, "две порции назад — два имени").Равно(2);
	Ожидаем.Что(Третья.ИменПройдено, "и ещё два").Равно(4);

КонецПроцедуры

// Фильтр имён режет и знаменатель: пул, зеркалирующий три имени из пятисот, не должен
// видеть долю в полпроцента на завершённом обходе.
&Тест
Процедура ФильтрРежетЗнаменательОбхода() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200,
		СтрСоединить(СтрРазделить("corp-a,corp-b,alien-c,alien-d", ","), Символы.ПС));
	Для Каждого Имя Из СтрРазделить("corp-a,corp-b,alien-c,alien-d", ",") Цикл
		Клиент.УстановитьОтветТекстПоПути("package/" + Имя, 200, Страница(Имя, "1.0.0"));
	КонецЦикла;

	Перечень = Источник(Клиент).Перечислить(Зеркало("[""corp-*""]"), 200);

	Ожидаем.Что(Перечень.ИменВсего, "чужие имена в знаменатель не входят").Равно(2);
	Ожидаем.Что(ИменаПеречня(Перечень), "и в порцию тоже").Равно("corp-a,corp-b");

КонецПроцедуры

// Страница версий — отдельный запрос к апстриму на КАЖДОЕ имя порции. Без отметки живости
// внутри перечисления цикл молчал (порция + 1) × таймаут, и порог «прогон брошен» нельзя
// было опустить до единиц минут: он объявлял брошенным живой обход.
&Тест
Процедура ПеречислениеОтмечаетсяНаКаждомИмени() Экспорт

	Клиент = КлиентСоСписком(СтрСоединить(СтрРазделить("a,b,c", ","), Символы.ПС));
	Отметка = Новый СчётчикОтметок();

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 200, "", Отметка);

	Ожидаем.Что(Перечень.Элементы.Количество() > 0, "порция перечислена").ЭтоИстина();
	Ожидаем.Что(Отметка.Шагов(), "отметка на каждом имени порции").Равно(3);
	Ожидаем.Что(СтрСоединить(Отметка.Имена(), ","), "и названы сами имена").Равно("a,b,c");

КонецПроцедуры

// Отметка необязательна: источник зовут и без неё (набор источника, живой смоук).
&Тест
Процедура ПеречислениеБезОтметкиРаботаетКакПрежде() Экспорт

	Клиент = КлиентСоСписком("a");

	Ожидаем.Что(Источник(Клиент).Перечислить(Зеркало(""), 200).Код,
		"без отметки перечисление проходит").Равно(200);

КонецПроцедуры

// Порция (oshub.mirror.max_packages_per_cycle) режет ИМЕНА, а не элементы: иначе
// зеркало хаба с десятками версий у первых пакетов никогда не дошло бы до остальных.
&Тест
Процедура ПорцияСчитаетПакетыАНеВерсии() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200,
		СтрСоединить(СтрРазделить("a,b,c,d", ","), Символы.ПС));
	Клиент.УстановитьОтветТекстПоПути("package/a", 200, Страница("a", "1.0.0,0.9.0,0.8.0"));
	Клиент.УстановитьОтветТекстПоПути("package/b", 200, Страница("b", "1.0.0,0.9.0,0.8.0"));
	Клиент.УстановитьОтветТекстПоПути("package/c", 200, Страница("c", "1.0.0"));
	Клиент.УстановитьОтветТекстПоПути("package/d", 200, Страница("d", "1.0.0"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 2);

	Ожидаем.Что(ИменаПеречня(Перечень), "порция 2 отобрала два ПАКЕТА").Равно("a,b");
	Ожидаем.Что(Перечень.Элементы.Количество(), "версии отобранных пакетов идут целиком").Равно(6);
	Ожидаем.Что(Перечень.ЕстьЕщё, "за порцией остался хвост").ЭтоИстина();
	Ожидаем.Что(Перечень.Курсор, "и назван первым непройденным именем").Равно("c");

КонецПроцедуры

// Ядро дефекта: имена за пределами порции не зеркалировались НИКОГДА — каждый цикл
// начинал список с начала. Курсор доводит обход до последнего имени и сбрасывается.
&Тест
Процедура ХвостСпискаЗаПорциейДостижимСледующимЦиклом() Экспорт

	Клиент = КлиентСоСписком(СтрСоединить(СтрРазделить("a,b,c", ","), Символы.ПС));
	Источник_ = Источник(Клиент);

	Первая = Источник_.Перечислить(Зеркало(""), 2);
	Вторая = Источник_.Перечислить(Зеркало(""), 2, Первая.Курсор);

	Ожидаем.Что(ИменаПеречня(Первая), "первая порция").Равно("a,b");
	Ожидаем.Что(ИменаПеречня(Вторая), "вторая порция начинается С КУРСОРА и добирает хвост")
		.Равно("c");
	Ожидаем.Что(Вторая.ЕстьЕщё, "список пройден целиком").ЭтоЛожь();
	Ожидаем.Что(Вторая.Курсор, "курсор сброшен — следующий обход с начала").Равно("");

КонецПроцедуры

// Курсор — это позиция в устойчивом порядке, поэтому порядок задаёт источник сортировкой:
// апстрим волен переставить строки list.txt между циклами.
&Тест
Процедура ОбходИдётПоАлфавитуНезависимоОтПорядкаСписка() Экспорт

	Клиент = КлиентСоСписком(СтрСоединить(СтрРазделить("delta,alfa,charlie,bravo", ","), Символы.ПС));

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 2);

	Ожидаем.Что(ИменаПеречня(Перечень), "порция взята по алфавиту, а не по порядку строк")
		.Равно("alfa,bravo");
	Ожидаем.Что(Перечень.Курсор, "курсор — следующее имя того же порядка").Равно("charlie");

КонецПроцедуры

// Список апстрима меняется между циклами. Имя, вставшее ПЕРЕД курсором, этот обход
// не увидит — и это осознанный выбор: обход обязан заканчиваться, а не топтаться в голове
// списка. Забирает такое имя следующий обход, когда курсор сброшен.
&Тест
Процедура ИмяПередКурсоромЗаберётсяСледующимОбходом() Экспорт

	Клиент = КлиентСоСписком(СтрСоединить(СтрРазделить("bravo,charlie", ","), Символы.ПС));
	Первая = Источник(Клиент).Перечислить(Зеркало(""), 1);

	// апстрим опубликовал alfa, пока шёл обход
	СЖивчиком = КлиентСоСписком(СтрСоединить(СтрРазделить("alfa,bravo,charlie", ","), Символы.ПС));
	Источник_ = Источник(СЖивчиком);
	Вторая = Источник_.Перечислить(Зеркало(""), 5, Первая.Курсор);

	Ожидаем.Что(ИменаПеречня(Вторая), "новое имя перед курсором в этот обход не попало")
		.Равно("charlie");
	Ожидаем.Что(Вторая.Курсор, "обход завершён").Равно("");

	Следующий = Источник_.Перечислить(Зеркало(""), 5, Вторая.Курсор);
	Ожидаем.Что(ИменаПеречня(Следующий), "следующий обход забирает и его").Равно("alfa,bravo,charlie");

КонецПроцедуры

// Пакет, на котором стоял курсор, апстрим мог удалить: обход обязан продолжиться
// со следующего по порядку, а не начаться заново.
&Тест
Процедура ИсчезнувшееИмяКурсораНеРоняетОбход() Экспорт

	Клиент = КлиентСоСписком(СтрСоединить(СтрРазделить("alfa,charlie", ","), Символы.ПС));

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 5, "bravo");

	Ожидаем.Что(ИменаПеречня(Перечень), "продолжили со следующего имени, голову не перечитали")
		.Равно("charlie");

КонецПроцедуры

&Тест
Процедура ПеречислениеБезФильтраВозвращаетВсе() Экспорт

	Клиент = КлиентСоСписком("alfa" + Символы.ПС + "beta" + Символы.ПС + "corp-x");

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 200);

	Ожидаем.Что(Перечень.Код, "list.txt получен").Равно(200);
	Ожидаем.Что(ИменаПеречня(Перечень), "все пакеты перечислены").Равно("alfa,beta,corp-x");

КонецПроцедуры

&Тест
Процедура ФильтрМаскиОграничиваетНабор() Экспорт

	Клиент = КлиентСоСписком("alfa" + Символы.ПС + "corp-x" + Символы.ПС + "corp-y");

	Перечень = Источник(Клиент).Перечислить(Зеркало("[""corp-*""]"), 200);

	Ожидаем.Что(ИменаПеречня(Перечень), "только corp-* попали").Равно("corp-x,corp-y");

КонецПроцедуры

&Тест
Процедура ФильтрМаскиСличаетИмяЦеликом() Экспорт

	Клиент = КлиентСоСписком("corp-x" + Символы.ПС + "evil-corp-x" + Символы.ПС + "corp-x-evil");

	Перечень = Источник(Клиент).Перечислить(Зеркало("[""corp-x""]"), 200);

	Ожидаем.Что(ИменаПеречня(Перечень), "маска без звёздочки — только точное имя").Равно("corp-x");

КонецПроцедуры

// Имена пакетов в хабе канонизируются нижним регистром, поэтому фильтр обязан пропускать
// апстримное имя в любом регистре — эта регистронезависимость живёт в вызывающем коде,
// а не в маске.
&Тест
Процедура ФильтрНеЗависитОтРегистраИмениАпстрима() Экспорт

	Клиент = КлиентСоСписком("CORP-X" + Символы.ПС + "alfa");

	Перечень = Источник(Клиент).Перечислить(Зеркало("[""Corp-*""]"), 200);

	Ожидаем.Что(ИменаПеречня(Перечень), "имя апстрима отдаётся как есть").Равно("CORP-X");

КонецПроцедуры

&Тест
Процедура БитыйФильтрFailClosed() Экспорт

	Клиент = КлиентСоСписком("alfa" + Символы.ПС + "beta");

	Перечень = Источник(Клиент).Перечислить(Зеркало("{битый"), 200);

	Ожидаем.Что(Перечень.Элементы.Количество(), "битый фильтр — пустой набор").Равно(0);

КонецПроцедуры

&Тест
Процедура OfflineПеречислениеОтдаётКодНоль() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 0, ""); // апстрим недоступен

	Перечень = Источник(Клиент).Перечислить(Зеркало(""), 200);

	Ожидаем.Что(Перечень.Код, "offline — код 0").Равно(0);
	Ожидаем.Что(Перечень.Элементы.Количество(), "offline — пустой набор").Равно(0);
	Ожидаем.Что(Клиент.ПутиЗапросов().Количество(), "без списка страницы не запрашиваются").Равно(1);

КонецПроцедуры

// ИСТ-АПСТ-006: правило одно для источника пула и для зеркала — токен едет с КАЖДЫМ
// запросом протокола: за списком имён, за страницей версий и за самим .ospx.
&Тест
Процедура ТокенЗеркалаЕдетСКаждымЗапросомПротокола() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекстПоПути("list.txt", 200, "alfa");
	Клиент.УстановитьОтветТекстПоПути("package/alfa", 200, Страница("alfa", "1.0.0"));
	Клиент.УстановитьОтветДанные(200, ПолучитьДвоичныеДанныеИзСтроки("ospx"));

	Приватное = ЗеркалоСТокеном("sekret-42");
	Перечень = Источник(Клиент).Перечислить(Приватное, 10);
	Источник(Клиент).Скачать(Приватное, Перечень.Элементы[0]);

	Токены = Клиент.ТокеныЗапросов();
	Ожидаем.Что(Токены.Количество(), "список, страница версий и скачивание").Равно(3);
	Для Каждого Токен Из Токены Цикл
		Ожидаем.Что(Токен, "каждый запрос к приватному апстриму несёт токен").Равно("sekret-42");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЗеркалоБезТокенаЧитаетАпстримАнонимно() Экспорт

	Клиент = КлиентСоСписком("alfa");

	Источник(Клиент).Перечислить(Зеркало(""), 10);

	Ожидаем.Что(Клиент.ТокеныЗапросов()[0], "анонимное зеркало токена не несёт").Равно("");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Источник(Знач Клиент)
	Возврат Новый ИсточникАпстримаOpm(Клиент, Новый РазборВерсийПакета(Новый СравнительВерсий()));
КонецФункции

// Общий ответ отдаётся и на страницу пакета: ссылок в списке имён нет, поэтому каждый
// пакет деградирует к latest — так тесты фильтра считают именно пакеты.
Функция КлиентСоСписком(Знач Список)
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Список);
	Возврат Клиент;
КонецФункции

// Разметка страницы пакета апстрима с перечисленными версиями (через запятую).
Функция Страница(Знач ИмяПакета, Знач Версии_)
	Разметка = "<div class=""ui relaxed list"">";
	Для Каждого Версия Из СтрРазделить(Версии_, ",", Ложь) Цикл
		Разметка = Разметка + СтрШаблон(
			"<div class=""item""><a class=""header"" href=""/download/%1/%1-%2.ospx"">%2</a></div>",
			ИмяПакета, Версия);
	КонецЦикла;
	Возврат Разметка + "</div>";
КонецФункции

Функция ИменаПеречня(Знач Перечень)
	Имена = Новый Массив();
	Для Каждого Элемент Из Перечень.Элементы Цикл
		Если Имена.Найти(Элемент.ИмяПакета) = Неопределено Тогда
			Имена.Добавить(Элемент.ИмяПакета);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");
КонецФункции

Функция ВерсииПеречня(Знач Перечень)
	Значения = Новый Массив();
	Для Каждого Элемент Из Перечень.Элементы Цикл
		Значения.Добавить(Элемент.Версия);
	КонецЦикла;
	Возврат СтрСоединить(Значения, ",");
КонецФункции

Функция Зеркало(Знач ФильтрJSON)
	Возврат ЗеркалоURL("http://upstream.invalid/download/", ФильтрJSON);
КонецФункции

Функция ЗеркалоURL(Знач URL, Знач ФильтрJSON)
	Возврат Новый Структура("АпстримURL, ФильтрJSON, ТокенДоступа", URL, ФильтрJSON, "");
КонецФункции

Функция ЗеркалоСТокеном(Знач Токен)
	Запись = Зеркало("");
	Запись.ТокенДоступа = Токен;
	Возврат Запись;
КонецФункции

Процедура Подключить(Знач Путь, Знач Имя)
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти
