// Юнит-тесты общего отбора коллекций в памяти (поиск/ПоискПоКоллекции): порядок полей
// и видов совпадения, нечёткий этап на опечатке, отбор списка пользователей.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Отбор_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(КаталогПроекта, "src", "модули", "поиск");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "Классы", "ПоискПоКоллекции.os"));

	Отбор_ = Новый ПоискПоКоллекции();

КонецПроцедуры

// --- подстрочный отбор и ранжирование ---

&Тест
Процедура ПустойЗапросОтдаётВсюКоллекциюВИсходномПорядке() Экспорт

	Коллекция = Пакеты("winow,autumn,entity");

	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "", "Имя")), "пустой запрос — вся коллекция как есть")
		.Равно("winow,autumn,entity");
	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "   ", "Имя")), "пробелы — тоже пустой запрос")
		.Равно("winow,autumn,entity");

КонецПроцедуры

&Тест
Процедура ТочноеСовпадениеВышеПрефиксаИПодстроки() Экспорт

	Коллекция = Пакеты("myjson,jsonschema,json");

	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "json", "Имя")),
		"точное > префикс > подстрока, исходный порядок роли не играет").Равно("json,jsonschema,myjson");

КонецПроцедуры

&Тест
Процедура СовпадениеВПервомПолеВажнееСовпаденияВоВтором() Экспорт

	Коллекция = Новый Массив();
	Коллекция.Добавить(Пользователь("bob", "json@example.com"));   // совпало во втором поле
	Коллекция.Добавить(Пользователь("jsonman", "bob@example.com")); // совпало в первом

	Ожидаем.Что(Логины(Отбор_.Отобрать(Коллекция, "json", "Логин,Email")),
		"любое совпадение в важном поле выше любого совпадения в следующем").Равно("jsonman,bob");

КонецПроцедуры

&Тест
Процедура НеподошедшиеЭлементыВВыдачуНеПопадают() Экспорт

	Коллекция = Пакеты("json,jsonschema,winow");

	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "json", "Имя")), "отбор сужает выдачу")
		.Равно("json,jsonschema");

КонецПроцедуры

&Тест
Процедура ОтсутствующееПолеНеРоняетОтбор() Экспорт

	Коллекция = Пакеты("json,winow");

	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "json", "НетТакогоПоля,Имя")),
		"неизвестное имя поля пропускается, отбор идёт по остальным").Равно("json");

КонецПроцедуры

// --- отбор списка пользователей (админский список хаба) ---

&Тест
Процедура ПользователиНаходятсяПоФрагментуЛогинаИEmail() Экспорт

	Коллекция = Новый Массив();
	Коллекция.Добавить(Пользователь("alice", "alice@example.com"));
	Коллекция.Добавить(Пользователь("bob", "bob@corp.test"));
	Коллекция.Добавить(Пользователь("carol", "carol@example.com"));

	Ожидаем.Что(Логины(Отбор_.Отобрать(Коллекция, "ali", "Логин,Email")), "фрагмент логина")
		.Равно("alice");
	Ожидаем.Что(Логины(Отбор_.Отобрать(Коллекция, "corp.test", "Логин,Email")), "фрагмент email")
		.Равно("bob");
	Ожидаем.Что(Логины(Отбор_.Отобрать(Коллекция, "example.com", "Логин,Email")),
		"фрагмент email отбирает всех, у кого он есть").Равно("alice,carol");

КонецПроцедуры

// --- нечёткий этап ---

&Тест
Процедура ОпечаткаНаходитсяНечёткимЭтапом() Экспорт

	Коллекция = Пакеты("json,winow,logos");

	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "josn", "Имя")), "перестановка букв").Равно("json");
	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "jsoon", "Имя")), "лишний символ").Равно("json");
	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "wimow", "Имя")), "замена символа").Равно("winow");

КонецПроцедуры

&Тест
Процедура КороткийЗапросВариантамиНеРазмывается() Экспорт

	// три символа — обрывок, вариантами с пропуском он совпал бы почти со всем
	Коллекция = Пакеты("abc,zzz");

	Ожидаем.Что(Имена(Отбор_.Отобрать(Коллекция, "acb", "Имя")),
		"короткая опечатка выдачу не открывает").Равно("");
	Ожидаем.Что(Имена(Отбор_.Отобрать(Пакеты("abcd,zzzz"), "acbd", "Имя")),
		"с четырёх символов опечатка ищется").Равно("abcd");

КонецПроцедуры

&Тест
Процедура НечёткийОтборНаПустомЗапросеПуст() Экспорт
	Ожидаем.Что(Отбор_.ОтобратьНечётко(Пакеты("json"), "", "Имя").Количество(),
		"нечёткий этап без запроса ничего не выдумывает").Равно(0);
	Ожидаем.Что(Отбор_.ОтобратьНечётко(Новый Массив(), "json", "Имя").Количество(),
		"нечёткий этап на пустой коллекции пуст").Равно(0);
КонецПроцедуры

// --- оценка релевантности ---

&Тест
Процедура ОценкаРелевантностиОтличаетВидыСовпаденияИПоля() Экспорт

	Точное = Отбор_.ОценкаРелевантности(Пакет("json"), "json", "Имя,Описание");
	Префикс = Отбор_.ОценкаРелевантности(Пакет("jsonschema"), "json", "Имя,Описание");
	Подстрока = Отбор_.ОценкаРелевантности(Пакет("myjson"), "json", "Имя,Описание");
	ПоОписанию = Отбор_.ОценкаРелевантности(ПакетСОписанием("winow", "json parser"), "json", "Имя,Описание");
	НеПодошёл = Отбор_.ОценкаРелевантности(Пакет("winow"), "json", "Имя,Описание");

	Ожидаем.Что(Точное > Префикс, "точное выше префикса").ЭтоИстина();
	Ожидаем.Что(Префикс > Подстрока, "префикс выше подстроки").ЭтоИстина();
	Ожидаем.Что(Подстрока > ПоОписанию, "любое совпадение в имени выше совпадения в описании").ЭтоИстина();
	Ожидаем.Что(НеПодошёл, "не подошёл — ноль").Равно(0);
	Ожидаем.Что(Отбор_.ОценкаРелевантности(Пакет("json"), "", "Имя"), "пустой запрос — ноль").Равно(0);

КонецПроцедуры

// --- служебные ---

Функция Пакет(Знач Имя)
	Возврат Новый Структура("Имя, Описание", Имя, "");
КонецФункции

Функция ПакетСОписанием(Знач Имя, Знач Описание)
	Возврат Новый Структура("Имя, Описание", Имя, Описание);
КонецФункции

Функция Пакеты(Знач ИменаЧерезЗапятую)
	Результат = Новый Массив();
	Для Каждого Имя Из СтрРазделить(ИменаЧерезЗапятую, ",", Ложь) Цикл
		Результат.Добавить(Пакет(Имя));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Пользователь(Знач Логин, Знач Email)
	Возврат Новый Структура("Логин, Email", Логин, Email);
КонецФункции

Функция Имена(Знач Коллекция)
	Результат = "";
	Для Каждого Элемент Из Коллекция Цикл
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), ",", "") + Элемент.Имя;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Логины(Знач Коллекция)
	Результат = "";
	Для Каждого Элемент Из Коллекция Цикл
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), ",", "") + Элемент.Логин;
	КонецЦикла;
	Возврат Результат;
КонецФункции
