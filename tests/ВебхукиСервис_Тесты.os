КонецПроцедуры

// --- сквозной путь через подписчик ---

&Тест
Процедура ПодписчикСтавитДоставкуТолькоСвоемуПулу() Экспорт

	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://a.example.com/hook", "версия.опубликована");

	Транспорт = Новый ФейкТранспортHTTP();
	Служба = НоваяСлужбаДоставки(Транспорт);
	Подписчик = НовыйПодписчик(Сервис, Служба);

	// событие ЧУЖОГО пула 8 (у него вебхуков нет) — доставок не ставит
	Подписчик.ОбработатьСобытие(СобытиеПубликации(8, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "событие пула 8 без своих вебхуков — 0 доставок").Равно(0);

	// событие СВОЕГО пула 7 — ставит доставку его вебхуку
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "событие пула 7 — 1 доставка").Равно(1);

КонецПроцедуры

&Тест
Процедура ПодписчикДоставляетПодпискеПакетаИХаба() Экспорт

	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПакета(Сервис, 42, 7), "https://pkg.example.com/hook", "версия.опубликована");
	Сервис.Создать(Владелец(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");

	Транспорт = Новый ФейкТранспортHTTP();
	Служба = НоваяСлужбаДоставки(Транспорт);
	Подписчик = НовыйПодписчик(Сервис, Служба);

	// событие пакета 43 того же пула: подписка пакета 42 молчит, подписка хаба срабатывает
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 43, "другой", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "только подписка хаба").Равно(1);

	// событие пакета 42: срабатывают обе
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "подписка пакета + подписка хаба").Равно(3);

КонецПроцедуры

&Тест
Процедура СобытиеБезСкоупаНеДоставляетсяДажеПодпискеХаба() Экспорт

	// ГЕЙТ СКОУПА (ревью М-5). Событие без пула и пакета адресовать некому: доставить его
	// подписке хаба значило бы рассылать наружу всё, что окажется на шине, включая типы,
	// про которые перечень говорит «внутреннее».
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");

	Служба = НоваяСлужбаДоставки(Новый ФейкТранспортHTTP());
	Подписчик = НовыйПодписчик(Сервис, Служба);

	БезСкоупа = Новый Структура("Тип, Когда, Данные", "версия.опубликована",
		Дата(2026, 7, 26, 10, 0, 0), Новый Структура("ИмяПакета, Версия", "пакет", "1.0.0"));
	Подписчик.ОбработатьСобытие(БезСкоупа);
	Ожидаем.Что(Служба.РазмерОчереди(), "событие без пула и пакета — 0 доставок").Равно(0);

	// контроль: то же событие СО скоупом доставляется
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "со скоупом — доставка есть").Равно(1);

КонецПроцедуры

&Тест
Процедура ПодписчикРазличаетТипСобытия() Экспорт

	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://a.example.com/hook", "версия.опубликована"); // только публикация

	Транспорт = Новый ФейкТранспортHTTP();
	Служба = НоваяСлужбаДоставки(Транспорт);
	Подписчик = НовыйПодписчик(Сервис, Служба);

	Подписчик.ОбработатьСобытие(СобытиеОтзыва(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "неподписанный тип (отзыв) не ставится").Равно(0);

	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "подписанный тип (публикация) ставится").Равно(1);

КонецПроцедуры

&Тест
Процедура ТелоДоставкиНесётМетаданныеСобытия() Экспорт

	Подписчик = НовыйПодписчик(НовыйСервис(), НоваяСлужбаДоставки(Новый ФейкТранспортHTTP()));
	Событие = Новый Структура("Тип, Когда, Данные",
		"версия.опубликована", Дата(2026, 7, 26, 10, 0, 0),
		Новый Структура("ПулИдентификатор, ИмяПула, ИмяПакета, Версия", 7, "мойпул", "мойпакет", "1.2.3"));

	Тело = Подписчик.СформироватьТело(Событие);

	Ожидаем.Что(Найти(Тело, """тип"":""версия.опубликована""") > 0, "тип в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, """пул"":""мойпул""") > 0, "пул в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, """пакет"":""мойпакет""") > 0, "пакет в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, """версия"":""1.2.3""") > 0, "версия в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, "2026-07-26T10:00:00Z") > 0, "время ISO в теле").ЭтоИстина();

КонецПроцедуры

// --- служебные ---

Функция НовыйСервис()
	Возврат НовыйСервисСПравами(Новый ФейкСервисПрав());
КонецФункции

Функция НовыйСервисСПравами(Знач Права, Знач АдминыCSV = "100")
	// (Хранилище, Права, Реестр, Каталог, Параметры, Аудит, Ограничитель, Пользователи)
	Возврат Новый СервисПодписок(
		Новый ФейкХранилищеВебхуков(),
		Права,
		РеестрВебхука(),
		НовыйКаталог(),
		НовыеПараметрыПодписки(),
		Новый АудитПробыПодписки(ИменаЖурналаСХранилищами()),
		Новый ОграничительПроб(НастройкиПодписок()),
		Новый ФейкХранилищеПользователей(АдминыCSV));
КонецФункции

// Настройки подписок для прямой сборки вне контейнера — умолчаниями реестра.
Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Возврат Настройки;
КонецФункции

Функция НовыйКаталог()
	Возврат Новый КаталогСобытий(НовыйИздатель(), Новый ЗаполнениеПула());
КонецФункции

// Форматтер журнала с хранилищами: адрес объекта подписки он резолвит по идентификатору,
// а без хранилищ резолв падает — в хабе форматтер приезжает желудём.
Функция ИменаЖурналаСХранилищами()
	Пулы = Новый ФейкХранилищеСущностей();
	Пулы.Добавить(Новый ФейкСущностьАудита(7, "public"));
	Пакеты = Новый ФейкХранилищеСущностей();
	Пакеты.Добавить(Новый ФейкСущностьАудита(42, "oint", 7));
	Возврат Новый ИмяОбъектаАудита(Пулы, Пакеты);
КонецФункции

Функция НовыеПараметрыПодписки()
	Возврат Новый ПараметрыПодписки(НовыйКаталог());
КонецФункции

// Реестр с единственным типом «вебхук» (SSRF-гейт создания живёт в хранении типа).
Функция РеестрВебхука()
	Валидатор = Новый ВалидаторАдресаВебхука(Новый ФейкРазрешительImён(), НастройкиПодписок());
	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(Новый ФейкТранспортHTTP(), Валидатор, НастройкиПодписок(), Неопределено, ЛогТестов()));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения);
КонецФункции

// Ядро-очередь с обработчиком «вебхук» на заданном транспорте (сквозные тесты подписчика).
Функция НоваяСлужбаДоставки(Знач Транспорт)
	Валидатор = Новый ФейкВалидаторВебхука();
	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(Транспорт, Валидатор, НастройкиПодписок(), Неопределено, ЛогТестов()));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Реестр = Новый РеестрДействийПодписок(Доставки, Хранения);
	Очередь = Новый ОчередьДоставокПодписок(Новый ФейкХранилищеЗаданийДоставки(), НастройкиПодписок(),
		ЛогТестов(), Новый ПриведениеЧисел());
	Возврат Новый СлужбаДоставкиПодписок(Реестр, Очередь, НастройкиПодписок(), ЛогТестов(),
		Новый ПриведениеЧисел(), Новый ТекстОшибки());
КонецФункции

// Подписчик 7.C: (Сервис, СлужбаДоставки, Издатель, Готовность, Реестр, Лог).
Функция НовыйПодписчик(Знач Сервис, Знач Служба)
	Возврат Новый ПодписчикВебхуков(Сервис, Служба, НовыйИздатель(), НоваяГотовность(),
		РеестрВебхука(), ЛогТестов(), Новый ТекстОшибки(), Новый ТелоСобытия(Неопределено),
		НовыйОтборЗаполнения());
КонецФункции

Функция НовыйОтборЗаполнения()
	Возврат Новый ОтборЗаполненияПула(НовыеПараметрыПодписки(), Новый ЗаполнениеПула(), НовыйИздатель());
КонецФункции

// Набор прав издателя пула: «изменение» есть (наследуется на пакет), «удаления» нет.
Функция ПраваИздателя()
	Возврат Новый ФейкСервисПравСНабором("создание,изменение,чтение");
КонецФункции

// Набор прав читателя: только «чтение».
Функция ПраваЧитателя()
	Возврат Новый ФейкСервисПравСНабором("чтение");
КонецФункции

Функция НовыйИздатель()
	Возврат Новый ИздательСобытий();
КонецФункции

Функция ОбъектПула(Знач Сервис, Знач Ид)
	Возврат Сервис.ОбъектПула(Новый Структура("Идентификатор, Имя", Ид, "пул-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция ОбъектПакета(Знач Сервис, Знач Ид, Знач ПулИд)
	Возврат Сервис.ОбъектПакета(Новый Структура("Идентификатор, ПулИдентификатор, Имя",
		Ид, ПулИд, "пакет-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция СписокПула(Знач Сервис, Знач Ид)
	Возврат Сервис.Список(ОбъектПула(Сервис, Ид));
КонецФункции

Функция Владелец()
	Возврат Новый Структура("Идентификатор, Админ", 100, Истина);
КонецФункции

Функция Чужак()
	Возврат Новый Структура("Идентификатор, Админ", 200, Ложь);
КонецФункции

Функция Издатель_()
	Возврат Новый Структура("Идентификатор, Админ", 300, Ложь);
КонецФункции

Функция Читатель()
	Возврат Новый Структура("Идентификатор, Админ", 400, Ложь);
КонецФункции

Функция СобытиеПубликации(Знач ПулИд, Знач ПакетИд, Знач Пакет, Знач Версия)
	Возврат Новый Структура("Тип, Когда, Данные", "версия.опубликована", Дата(2026, 7, 26, 10, 0, 0),
		Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия",
			ПулИд, ПакетИд, "пул", Пакет, Версия));
КонецФункции

Функция СобытиеОтзыва(Знач ПулИд, Знач ПакетИд, Знач Пакет, Знач Версия)
	Возврат Новый Структура("Тип, Когда, Данные", "версия.отозвана", Дата(2026, 7, 26, 10, 0, 0),
		Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия, Отозвана",
			ПулИд, ПакетИд, "пул", Пакет, Версия, Истина));
КонецФункции

Функция ПопыткаСоздать(Знач Сервис, Знач Кто, Знач Объект, Знач URL, Знач Типы)
	Попытка
		Сервис.Создать(Кто, Объект, URL, Типы);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ПопыткаМутации(Знач Сервис, Знач Действие, Знач Кто, Знач Объект, Знач Ид)
	Попытка
		Если Действие = "удалить" Тогда
			Сервис.Удалить(Кто, Объект, Ид);
		Иначе
			Сервис.Переключить(Кто, Объект, Ид, Ложь);
		КонецЕсли;
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Класс ищется по имени в каталоге и его подкаталогах: путь к файлу из имени
// не строится (docs/процесс/РАСКЛАДКА.md).
Процедура Подключить(Знач КаталогКлассов, Знач Имя)
	ПоискКлассов.Подключить(КаталогКлассов, Имя);
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Свежая ГотовностьХаба для конструкторов стартовых задач: они заявляют в ней свой гейт
// В юнит-тестах гейт никого не держит — важна только корректная сборка.
Функция НоваяГотовность()

	Попытка
		КаталогНабора = Новый Файл(ТекущийСценарий().Источник).Путь;
		КореньПроекта = Новый Файл(ОбъединитьПути(КаталогНабора, "..")).ПолноеИмя;
		ПоискКлассов.Подключить(ОбъединитьПути(ОбъединитьПути(КореньПроекта, "src", "модули"),
			"наблюдаемость", "Классы"), "ГотовностьХаба");
	Исключение
		// тип мог быть зарегистрирован ранее
	КонецПопытки;

	Возврат Новый ГотовностьХаба(ЛогТестов());

КонецФункции

// Лог для классов, создаваемых НАПРЯМУЮ (минуя контейнер ОСени): инъекция `&Лог` до них
// не доезжает, поэтому лог передаёт тест параметром конструктора (шаг 6.D).
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции
