// Юнит-тесты СервисаВебхуков и ПодписчикаВебхуков на фейках, без контейнера, БД и сети:
// права на объект, SSRF, уникальность, лимиты, приватность адресации доставок.

#Использовать asserts
#Использовать "фикстуры"
// autumn-logos — единая точка входа логирования (logos транзитивно): классы, созданные
// НАПРЯМУЮ (минуя контейнер ОСени), с шага 6.D получают лог от теста параметром.
#Использовать autumn-logos

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогВебхуков;
Перем КаталогРеестра;   // классы, уехавшие из common к своему хозяину
Перем КаталогСобытийПуть;
Перем КаталогФикстур;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогВебхуков = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	КаталогСобытийПуть = ОбъединитьПути(КаталогМодулей, "события", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Подключить(КаталогВебхуков, "СервисПодписок");
	Подключить(КаталогВебхуков, "ВалидаторАдресаВебхука");
	Подключить(КаталогВебхуков, "СлужбаДоставкиПодписок");
	Подключить(КаталогВебхуков, "ОчередьДоставокПодписок");
	Подключить(КаталогВебхуков, "РеестрДействийПодписок");
	Подключить(КаталогВебхуков, "ПодписчикВебхуков");
	Подключить(КаталогВебхуков, "ТелоСобытия");
	КаталогОбработчикаВебхука = ОбъединитьПути(ОбъединитьПути(КаталогВебхуков, "обработчики"), "вебхук");
	Подключить(КаталогОбработчикаВебхука, "ДоставкаВебхуком");
	Подключить(КаталогОбработчикаВебхука, "ХранениеПодпискиВебхука");
	// общий модуль утилит (6.C п.8): служба, подписчик и обработчики берут его желудями
	КаталогCommon = ОбъединитьПути(ОбъединитьПути(КаталогВебхуков, "..", ".."), "основа", "Классы");
	Подключить(КаталогCommon, "ПриведениеЧисел");
	Подключить(КаталогCommon, "ТекстОшибки");
	Подключить(КаталогСобытийПуть, "ИздательСобытий");
	Подключить(КаталогСобытийПуть, "КаталогСобытий");
	Подключить(КаталогРеестра, "ЗаполнениеПула");
	КаталогАудита = ОбъединитьПути(ОбъединитьПути(КаталогCommon, "..", ".."), "аудит", "Классы");
	Подключить(КаталогАудита, "ИмяОбъектаАудита");
	Подключить(КаталогВебхуков, "ПараметрыПодписки");
	Подключить(КаталогВебхуков, "ОтборЗаполненияПула");
	Подключить(КаталогВебхуков, "АудитПробыПодписки");
	Подключить(КаталогВебхуков, "ОграничительПроб");
	Подключить(КаталогФикстур, "ФейкХранилищеВебхуков");
	Подключить(КаталогФикстур, "ФейкЗаданиеДоставкиЗапись");
	Подключить(КаталогФикстур, "ФейкХранилищеЗаданийДоставки");
	Подключить(КаталогФикстур, "ФейкВебхукЗапись");
	Подключить(КаталогФикстур, "ФейкСервисПрав");
	Подключить(КаталогФикстур, "ФейкСервисПравСНабором");
	Подключить(КаталогФикстур, "ФейкХранилищеПользователей");
	Подключить(КаталогФикстур, "ФейкХранилищеСущностей");
	Подключить(КаталогФикстур, "ФейкСущностьАудита");
	Подключить(КаталогФикстур, "ФейкТранспортHTTP");
	Подключить(КаталогФикстур, "ФейкРазрешительImён");
	Подключить(КаталогФикстур, "НастройкиЗаглушка");
	Подключить(КаталогФикстур, "ФейкВалидаторВебхука");
КонецПроцедуры

// --- права ---

&Тест
Процедура ВладелецСоздаётВебхукССекретом() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://example.com/hook", "версия.опубликована");
	Ожидаем.Что(ЗначениеЗаполнено(Вебхук.Секрет), "секрет сгенерирован").ЭтоИстина();
	Ожидаем.Что(Вебхук.Активен, "новый вебхук активен").ЭтоИстина();
	Ожидаем.Что(Вебхук.ТипОбъекта, "тип объекта — пул").Равно("пул");
	Ожидаем.Что(Вебхук.ОбъектИдентификатор, "привязан к пулу").Равно(7);
	Ожидаем.Что(Вебхук.ПулИдентификатор, "пул-контейнер заполнен").Равно(7);
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "вебхук сохранён").Равно(1);
КонецПроцедуры

&Тест
Процедура НеВладелецНеМожетСоздать() Экспорт
	Сервис = НовыйСервис();
	Ожидаем.Что(ПопыткаСоздать(Сервис, Чужак(), ОбъектПула(Сервис, 7), "https://example.com/h", "версия.опубликована"),
		"не-владелец не создаёт вебхук").ЭтоИстина();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "вебхук не создан").Равно(0);
КонецПроцедуры

&Тест
Процедура НеВладелецНеМожетУдалитьИлиПереключить() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://example.com/h", "версия.опубликована");
	Ожидаем.Что(ПопыткаМутации(Сервис, "удалить", Чужак(), ОбъектПула(Сервис, 7), Вебхук.Идентификатор),
		"чужак не удаляет").ЭтоИстина();
	Ожидаем.Что(ПопыткаМутации(Сервис, "переключить", Чужак(), ОбъектПула(Сервис, 7), Вебхук.Идентификатор),
		"чужак не переключает").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ЗаданныйСекретСохраняется() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://example.com/s", "версия.опубликована", "мой-секрет");
	Ожидаем.Что(Вебхук.Секрет, "переданный секрет сохранён как есть").Равно("мой-секрет");
КонецПроцедуры

// --- права ПО ТИПУ ОБЪЕКТА (5.J) ---

&Тест
Процедура ИздательВедётПодпискуПакетаНоНеПула() Экспорт

	// издатель пула: «изменение» есть (наследуется на пакет), «удаления» нет (owner-уровень)
	Сервис = НовыйСервисСПравами(ПраваИздателя());

	Подписка = Сервис.Создать(Издатель_(), ОбъектПакета(Сервис, 42, 7), "https://pkg.example.com/h", "версия.опубликована");
	Ожидаем.Что(Подписка.ТипОбъекта, "подписка пакета создана").Равно("пакет");
	Ожидаем.Что(Подписка.ОбъектИдентификатор, "привязана к пакету").Равно(42);
	Ожидаем.Что(Подписка.ПулИдентификатор, "пул-контейнер — пул пакета").Равно(7);

	Ожидаем.Что(ПопыткаСоздать(Сервис, Издатель_(), ОбъектПула(Сервис, 7), "https://pool.example.com/h", "версия.опубликована"),
		"издатель не заводит подписку ПУЛА (нужен owner-уровень)").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧитательНеЗаводитПодпискуПакета() Экспорт

	// ПИН ТРЕБУЕМОГО ПРАВА (ревью В-1). Подписка уносит поток событий пакета на внешний
	// адрес — это право УПРАВЛЕНИЯ («изменение»), а не чтения. Подмени продукт «чтением» —
	// и любой, кто вправе читать пакет, заведёт подписку; этот тест краснеет на такой замене.
	Сервис = НовыйСервисСПравами(ПраваЧитателя());

	Ожидаем.Что(ПопыткаСоздать(Сервис, Читатель(), ОбъектПакета(Сервис, 42, 7),
		"https://reader.example.com/h", "версия.опубликована"),
		"читатель не заводит подписку пакета").ЭтоИстина();
	Ожидаем.Что(Сервис.МожетУправлять(Читатель(), ОбъектПакета(Сервис, 42, 7)),
		"и по запросу права — нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПодпискуХабаЗаводитТолькоАдминХаба() Экспорт
	Сервис = НовыйСервис();
	Подписка = Сервис.Создать(Владелец(), Сервис.ОбъектХаба(), "https://hub.example.com/h", "версия.опубликована");
	Ожидаем.Что(Подписка.ТипОбъекта, "подписка хаба создана").Равно("хаб");
	Ожидаем.Что(Подписка.ПулИдентификатор, "у подписки хаба нет пула-контейнера").Равно(0);

	// издатель пула админом хаба не является
	СервисИздателя = НовыйСервисСПравами(ПраваИздателя());
	Ожидаем.Что(ПопыткаСоздать(СервисИздателя, Издатель_(), СервисИздателя.ОбъектХаба(),
		"https://hub2.example.com/h", "версия.опубликована"),
		"не-админ хаба не заводит подписку хаба").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура МожетУправлятьНеБросаетИСовпадаетСГейтом() Экспорт
	Сервис = НовыйСервис();
	Ожидаем.Что(Сервис.МожетУправлять(Владелец(), ОбъектПула(Сервис, 7)), "владелец — да").ЭтоИстина();
	Ожидаем.Что(Сервис.МожетУправлять(Чужак(), ОбъектПула(Сервис, 7)), "чужак — нет").ЭтоЛожь();
	Ожидаем.Что(Сервис.МожетУправлять(Неопределено, Сервис.ОбъектХаба()), "аноним — нет").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура НеизвестныйТипОбъектаОтклонён() Экспорт
	// fail-closed: незнакомый объект не даёт подписку даже администратору
	Сервис = НовыйСервис();
	Чужой = Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор", "группа", 1, 1);
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Чужой, "https://x.example.com/h", "версия.опубликована"),
		"объект неизвестного типа отклонён").ЭтоИстина();
КонецПроцедуры

// --- SSRF на создании ---

&Тест
Процедура НеАдресОтклонёнАСетьНазначенияНеСудится() Экспорт

	// НФТ-ПОДП-002: отвергается только то, что адресом не является. Куда адрес ведёт —
	// выбор мейнтейнера, и подписка на приёмник в своей сети обязана заводиться.
	Сервис = НовыйСервис();
	Объект = ОбъектПула(Сервис, 7);

	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Объект, "http://example.com/h", "версия.опубликована"),
		"http отклонён (схема, а не сеть)").ЭтоИстина();
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Объект, "example.com/h", "версия.опубликована"),
		"строка без схемы адресом не является").ЭтоИстина();

	Сервис.Создать(Владелец(), Объект, "https://127.0.0.1/h", "версия.опубликована");
	Сервис.Создать(Владелец(), Объект, "https://169.254.169.254/h", "версия.опубликована");
	Сервис.Создать(Владелец(), Объект, "https://hooks.internal.corp/h", "версия.опубликована");

	Ожидаем.Что(СписокПула(Сервис, 7).Количество(),
		"подписки на петлю, метаданные и внутреннее имя заведены").Равно(3);

КонецПроцедуры

// --- уникальность, лимит, типы ---

&Тест
Процедура ДубльURLВОбъектеОтклонён() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://example.com/dup", "версия.опубликована");
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), ОбъектПула(Сервис, 7), "https://example.com/dup", "версия.опубликована"), "повторный URL отклонён").ЭтоИстина();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "второй не создан").Равно(1);
КонецПроцедуры

&Тест
Процедура ДубльПоРегиструХостаОтклонён() Экспорт
	// https://Example.COM и https://example.com — один и тот же адрес (схема/DNS
	// регистронезависимы): второй не должен обойти инвариант (объект, URL)
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://Example.COM/dup", "версия.опубликована");
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), ОбъектПула(Сервис, 7), "https://example.com/dup", "версия.опубликована"),
		"дубль по регистру хоста отклонён").ЭтоИстина();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "второй не создан").Равно(1);
КонецПроцедуры

&Тест
Процедура ТотЖеURLВРазныхОбъектахДопустим() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://example.com/x", "версия.опубликована");
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 8), "https://example.com/x", "версия.опубликована");
	// пакет пула 7 и сам пул 7 — РАЗНЫЕ объекты: один адрес у обоих законен
	Сервис.Создать(Владелец(), ОбъектПакета(Сервис, 42, 7), "https://example.com/x", "версия.опубликована");
	Ожидаем.Что(СписокПула(Сервис, 8).Количество(), "тот же URL в другом пуле допустим").Равно(1);
	Ожидаем.Что(Сервис.Список(ОбъектПакета(Сервис, 42, 7)).Количество(), "тот же URL у пакета допустим").Равно(1);
КонецПроцедуры

// Владелец снял квоту подписок: «убрать вообще. Неограниченное количество хуков.
// Хуки могут быть отдельные на каждом пакете».
&Тест
Процедура ЧислоПодписокНаОбъектНеОграничено() Экспорт
	Сервис = НовыйСервис();
	Для Номер = 1 По 25 Цикл
		Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7),
			"https://example.com/" + Формат(Номер, "ЧГ=0"), "версия.опубликована");
	КонецЦикла;
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "все двадцать пять подписок заведены").Равно(25);
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), ОбъектПула(Сервис, 7),
		"https://example.com/ещё", "версия.опубликована"), "и двадцать шестая тоже").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура НеизвестныйПустойИВнутреннийТипыОтклонены() Экспорт
	Сервис = НовыйСервис();
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), ОбъектПула(Сервис, 7), "https://example.com/t", "не.такое.событие"), "неизвестный тип отклонён").ЭтоИстина();
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), ОбъектПула(Сервис, 7), "https://example.com/t2", ""), "пустой набор типов отклонён").ЭтоИстина();
	// «скачивание.зафиксировано» есть в перечне, но помечено внутренним — подписки на него нет
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), ОбъектПула(Сервис, 7), "https://example.com/t3", "скачивание.зафиксировано"),
		"внутреннее событие для подписки недоступно").ЭтоИстина();
КонецПроцедуры

// --- приватность адресации ---

&Тест
Процедура АктивныеДляСобытияИзолируютПулы() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://a.example.com/hook", "версия.опубликована");

	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(), "виден в своём пуле").Равно(1);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(8, "версия.опубликована").Количество(), "не виден чужому пулу").Равно(0);
КонецПроцедуры

&Тест
Процедура АктивныеДляСобытияИзолируютПакеты() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), ОбъектПакета(Сервис, 42, 7), "https://pkg.example.com/hook", "версия.опубликована");

	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована", 42).Количество(),
		"подписка пакета получает событие своего пакета").Равно(1);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована", 43).Количество(),
		"подписка пакета НЕ получает событие соседнего пакета").Равно(0);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(),
		"подписка пакета не срабатывает на событии без пакета").Равно(0);
КонецПроцедуры

&Тест
Процедура ПодпискаХабаПолучаетСобытияЛюбогоПула() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");

	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(), "событие пула 7").Равно(1);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(8, "версия.опубликована").Количество(), "событие пула 8").Равно(1);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.отозвана").Количество(), "неподписанный тип — не доставляется").Равно(0);
КонецПроцедуры

&Тест
Процедура ПодпискаХабаГаснетПриРазжалованииАвтора() Экспорт

	// РЕВЬЮ В-5: подписка хаба получает события ВСЕХ пулов, включая приватные, и оправдана
	// только тем, что заводит её администратор. Роль отзывают — поток обязан прекратиться
	// немедленно, иначе разжалованный продолжает получать имена приватных пакетов, а снять
	// подписку сам уже не может (403 на разделе).
	Сервис = НовыйСервис();
	Сервис.Создать(Владелец(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(),
		"пока автор администратор — доставляется").Равно(1);

	// тот же набор подписок, но администраторов в хабе не осталось
	Разжалованный = НовыйСервисСПравами(Новый ФейкСервисПрав(), "");
	Разжалованный.Создать(Владелец(), Разжалованный.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");
	Ожидаем.Что(Разжалованный.АктивныеДляСобытия(7, "версия.опубликована").Количество(),
		"автора разжаловали — доставки нет").Равно(0);
	Ожидаем.Что(Разжалованный.Список(Разжалованный.ОбъектХаба()).Количество(),
		"но в списке подписка видна: действующий администратор должен её снять").Равно(1);

КонецПроцедуры

&Тест
Процедура ПодпискаПулаИПакетаАвторомНеПерепроверяется() Экспорт

	// перепроверка автора — гарантия ПОДПИСКИ ХАБА и только её: у пула и пакета скоуп
	// ограничен объектом, а право на объект отзывается вместе с грантом
	Сервис = НовыйСервисСПравами(Новый ФейкСервисПрав(), ""); // администраторов нет вовсе
	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://pool.example.com/h", "версия.опубликована");
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(),
		"подписка пула доставляется независимо от роли автора").Равно(1);

КонецПроцедуры

&Тест
Процедура ВыключенныйИНеподписанныйНеВыбираются() Экспорт
	Сервис = НовыйСервис();
	Выкл = Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://off.example.com/h", "версия.опубликована");
	Сервис.Переключить(Владелец(), ОбъектПула(Сервис, 7), Выкл.Идентификатор, Ложь);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(), "выключенный не выбран").Равно(0);

	Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://on.example.com/h", "версия.опубликована"); // только публикация
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.отозвана").Количество(), "неподписанный на отзыв не выбран").Равно(0);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(), "подписанный на публикацию выбран").Равно(1);
КонецПроцедуры

&Тест
Процедура ЧужойОбъектНельзяТронутьПоId() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Владелец(), ОбъектПула(Сервис, 7), "https://iso.example.com/h", "версия.опубликована");
	// подставляем ДРУГОЙ пул с тем же id вебхука — «не найден» в этом объекте
	Ожидаем.Что(Сервис.Удалить(Владелец(), ОбъектПула(Сервис, 8), Вебхук.Идентификатор), "удаление в чужом пуле — no-op").ЭтоЛожь();
	Ожидаем.Что(Сервис.Переключить(Владелец(), ОбъектПула(Сервис, 8), Вебхук.Идентификатор, Ложь), "переключение в чужом пуле — no-op").ЭтоЛожь();
	// и через объект ДРУГОГО ТИПА с совпавшим идентификатором (пакет №7 против пула №7)
	Ожидаем.Что(Сервис.Удалить(Владелец(), ОбъектПакета(Сервис, 7, 7), Вебхук.Идентификатор),
		"удаление через объект другого типа — no-op").ЭтоЛожь();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "вебхук пула 7 цел").Равно(1);
КонецПроцедуры

&Тест
Процедура ПодпискаПакетаНеВидныВСпискеПула() Экспорт
	Сервис = НовыйСервис();
