// Самотест фикстуры СтендУчёток: на ней стоят учётки, роли на пулах, гранты и ключи
// полутора десятков наборов. Стенд, который кладёт в базу не то, делает их зелёными
// на выпотрошенных проверках прав. Проверяется не сама фикстура на себе, а то, ЧТО ВИДЯТ
// хранилища и службы хаба после стенда, — обе двери, и строкой, и службами.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;       // общий контейнер на все тесты набора
Перем Засев;         // фикстура ЗасевРеестра — пул, на котором выдаются роли
Перем Стенд;         // фикстура СтендУчёток — учётка, роль, грант и ключ

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	ПодключитьСлоиУчёток(Модули);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "стенд-учёток-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("стенд-учёток-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендУчёток(Поделка);

КонецПроцедуры

// Хранилища и службы учёток: дверь «строкой» живёт на первых, дверь «службами» — на вторых,
// и самотест обязан видеть обе. СервисПользователей тянет за собой цикл подтверждения
// адреса и личный канал, а роли и гранты — реестр пулов и слой прав.
Процедура ПодключитьСлоиУчёток(Знач Модули)

	Слои.Подключить("данные");
	Слои.Подключить("хранилище, публикация, реестр, основа, наблюдаемость/телеметрия, события");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));

	Слои.Подключить("почта");
	Слои.Подключить("уведомления, вход, права, настройки");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

КонецПроцедуры

#Область УчёткаСтрокой

&Тест
Процедура УчёткаЛожитсяВБазуИЧитаетсяПоЛогину() Экспорт

	Хозяин = Стенд.Учётка();

	Найденная = Желудь("ХранилищеПользователей").НайтиПоЛогину(Хозяин.Логин);

	Ожидаем.Что(Найденная, "учётка легла в базу").Существует();
	Ожидаем.Что(Найденная.Идентификатор, "та самая учётка").Равно(Хозяин.Идентификатор);
	Ожидаем.Что(Найденная.Email, "адрес выведен из логина").Равно(Хозяин.Логин + "@example.com");
	Ожидаем.Что(Найденная.Активен, "учётка действует").ЭтоИстина();
	Ожидаем.Что(Найденная.РольХаба, "роль на хабе по умолчанию").Равно("user");

КонецПроцедуры

// Что набор назвал двери, то и должно доехать до базы. Роль, потерянная по дороге,
// оставила бы набор про админа зелёным на обычном пользователе.
&Тест
Процедура ДверьСтрокойДоноситРольЛогинАдресИПризнакДействия() Экспорт

	Админ = Стенд.Учётка("admin", "самотест-админ", "admin@самотест.test", Ложь);

	Прочитанный = Желудь("ХранилищеПользователей").НайтиПоЛогину("самотест-админ");
	Ожидаем.Что(Прочитанный, "названный логин").Существует();
	Ожидаем.Что(Прочитанный.РольХаба, "роль дошла до базы").Равно("admin");
	Ожидаем.Что(Прочитанный.Email, "названный адрес дошёл до базы").Равно("admin@самотест.test");
	Ожидаем.Что(Прочитанный.Активен, "снятый признак действия дошёл до базы").ЭтоЛожь();
	Ожидаем.Что(Прочитанный.Идентификатор, "та самая учётка").Равно(Админ.Идентификатор);

КонецПроцедуры

// Логины по умолчанию обязаны быть свободными: одноимённых учёток хаб не заводит,
// а набор, поднимающий три учётки подряд, логинов им не придумывает.
&Тест
Процедура ЛогиныПоУмолчаниюНеСталкиваются() Экспорт

	Первый = Стенд.Учётка();
	Второй = Стенд.Учётка();

	Ожидаем.Что(Первый.Логин <> Второй.Логин,
		СтрШаблон("две учётки — два логина (%1 и %2)", Первый.Логин, Второй.Логин)).ЭтоИстина();

КонецПроцедуры

// Стендов в наборе бывает несколько, и общего счётчика у них нет: свобода логина держится
// на модуле УникальныеИмена, один на процесс. Счётчик экземпляра дал бы здесь две учётки
// «u-1» — молча, потому что занятость логина держит сервисный слой, а не база.
&Тест
Процедура ДваСтендаВОдномНабореНеДаютОдноимённыхУчёток() Экспорт

	Первый = Новый СтендУчёток(Поделка);
	Второй = Новый СтендУчёток(Поделка);

	ЛогинПервого = Первый.Учётка().Логин;
	ЛогинВторого = Второй.Учётка().Логин;

	Ожидаем.Что(ЛогинПервого <> ЛогинВторого,
		СтрШаблон("два стенда дали учёткам разные логины (%1 и %2)",
			ЛогинПервого, ЛогинВторого)).ЭтоИстина();

	Одноимённых = 0;
	Для Каждого Учётка Из Желудь("ХранилищеПользователей").Все() Цикл
		Если Учётка.Логин = ЛогинПервого Тогда
			Одноимённых = Одноимённых + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Одноимённых, "в таблице ровно одна учётка с этим логином").Равно(1);

КонецПроцедуры

// Учётка, положенная строкой, службы хаба видят так же, как заведённую ими: иначе набор,
// смешавший двери, читал бы пустоту.
&Тест
Процедура УчёткаСтрокойВиднаСлужбамХаба() Экспорт

	Хозяин = Стенд.Учётка();

	Найденная = Желудь("СервисПользователей").НайтиПоЛогину(Хозяин.Логин);

	Ожидаем.Что(Найденная, "служба видит учётку, положенную строкой").Существует();
	Ожидаем.Что(Найденная.Идентификатор, "та самая учётка").Равно(Хозяин.Идентификатор);

КонецПроцедуры

#КонецОбласти

#Область РолиНаПуле

&Тест
Процедура УчёткаСРольюПолучаетНазваннуюРольНаНазванномПуле() Экспорт

	Пул = Засев.Пул();

	Издатель = Стенд.УчёткаСРолью(Пул, "publisher");

	Участие = Желудь("ХранилищеУчастниковПула").НайтиРоль(
		Пул.Идентификатор, "пользователь", Издатель.Идентификатор);
	Ожидаем.Что(Участие, "роль легла в базу").Существует();
	Ожидаем.Что(Участие.Роль, "названная роль дошла до базы").Равно("publisher");

КонецПроцедуры

// Роль по умолчанию — владелец пула: самый частый стенд наборов публикации.
&Тест
Процедура РольПоУмолчаниюЭтоВладелецПула() Экспорт

	Пул = Засев.Пул();

	Хозяин = Стенд.УчёткаСРолью(Пул);

	Ожидаем.Что(Желудь("ХранилищеУчастниковПула").НайтиРоль(
		Пул.Идентификатор, "пользователь", Хозяин.Идентификатор).Роль,
		"роль по умолчанию").Равно("owner");

КонецПроцедуры

// Субъектом роли бывает не только человек: группа получает роль тем же хранилищем,
// и набор, проверяющий групповые права, обязан суметь её положить.
&Тест
Процедура РольВыдаётсяИГруппеАНеТолькоЧеловеку() Экспорт

	Пул = Засев.Пул();

	Стенд.РольВПуле(Пул, 42, "reader", "группа");

	Ожидаем.Что(Желудь("ХранилищеУчастниковПула").НайтиРоль(Пул.Идентификатор, "группа", 42),
		"роль группы легла в базу").Существует();
	Ожидаем.Что(Желудь("ХранилищеУчастниковПула").НайтиРоль(Пул.Идентификатор, "пользователь", 42),
		"и не выдана человеку с тем же номером").Равно(Неопределено);

КонецПроцедуры

// Пул и субъект называются набору то записью, то идентификатором — обе формы обязаны
// класть роль на один и тот же пул.
&Тест
Процедура ПулИСубъектНазываютсяЗаписьюЛибоИдентификатором() Экспорт

	Пул = Засев.Пул();
	Хозяин = Стенд.Учётка();

	Стенд.РольВПуле(Пул.Идентификатор, Хозяин.Идентификатор, "reader");

	Ожидаем.Что(Желудь("ХранилищеУчастниковПула").НайтиРоль(
		Пул.Идентификатор, "пользователь", Хозяин.Идентификатор).Роль,
		"роль по числовым именам").Равно("reader");

КонецПроцедуры

#КонецОбласти

#Область ГрантыПрав

&Тест
Процедура ГрантЛожитсяВБазуИЧитаетсяПоСубъектуИОбъекту() Экспорт

	Пул = Засев.Пул();
	Хозяин = Стенд.Учётка();

	Стенд.Грант(Хозяин, "пул", Пул.Идентификатор, Стенд.Действия(Истина, Истина, Ложь, Истина));

	Грант = Желудь("ХранилищеПравДоступа").НайтиГрант(
		"пользователь", Хозяин.Идентификатор, "пул", Пул.Идентификатор);
	Ожидаем.Что(Грант, "грант легла в базу").Существует();
	Ожидаем.Что(Грант.Создание, "создание разрешено").ЭтоИстина();
	Ожидаем.Что(Грант.Изменение, "изменение разрешено").ЭтоИстина();
	Ожидаем.Что(Грант.Удаление, "удаление запрещено").ЭтоЛожь();
	Ожидаем.Что(Грант.Чтение, "чтение разрешено").ЭтоИстина();

КонецПроцедуры

// Действия называются по одному, и каждое обязано доехать до базы своим: перепутанные
// местами флаги оставили бы набор про «читать можно, удалять нельзя» зелёным наоборот.
&Тест
Процедура КаждоеДействиеДоезжаетСвоим() Экспорт

	Хозяин = Стенд.Учётка();

	Стенд.Грант(Хозяин, "пакет", 777, Стенд.Действия(Ложь, Ложь, Истина, Ложь));

	Грант = Желудь("ХранилищеПравДоступа").НайтиГрант("пользователь", Хозяин.Идентификатор,
		"пакет", 777);
	Ожидаем.Что(Грант.Создание, "создание запрещено").ЭтоЛожь();
	Ожидаем.Что(Грант.Изменение, "изменение запрещено").ЭтоЛожь();
	Ожидаем.Что(Грант.Удаление, "разрешено ровно удаление").ЭтоИстина();
	Ожидаем.Что(Грант.Чтение, "чтение запрещено").ЭтоЛожь();
	Ожидаем.Что(Грант.ТипОбъекта, "тип объекта дошёл до базы").Равно("пакет");
	Ожидаем.Что(Цел(Грант.ОбъектИдентификатор), "объект дошёл до базы").Равно(777);

КонецПроцедуры

// Грант выдаётся и группе: тип субъекта — параметр двери, а не догадка.
&Тест
Процедура ГрантВыдаётсяГруппеОтдельноОтЧеловека() Экспорт

	Стенд.Грант(51, "хаб", 0, Стенд.Действия(Ложь, Ложь, Ложь, Истина), "группа");

	Ожидаем.Что(Желудь("ХранилищеПравДоступа").НайтиГрант("группа", 51, "хаб", 0),
		"грант группы легла в базу").Существует();
	Ожидаем.Что(Желудь("ХранилищеПравДоступа").НайтиГрант("пользователь", 51, "хаб", 0),
		"и не выдана человеку с тем же номером").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область КлючиДоступа

&Тест
Процедура КлючЛожитсяВБазуНаСвоегоХозяина() Экспорт

	Хозяин = Стенд.Учётка();

	Ключ = Стенд.Ключ(Хозяин);

	Ключи = Желудь("ХранилищеТокенов").ПолучитьПоПользовательИдентификаторРавно(
		Хозяин.Идентификатор);
	Ожидаем.Что(Ключи.Количество(), "ключ виден хранилищу").Равно(1);
	Ожидаем.Что(Ключи[0].Идентификатор, "тот самый ключ").Равно(Ключ.Идентификатор);
	Ожидаем.Что(Ключи[0].Права, "права по умолчанию").Равно("read");
	Ожидаем.Что(Цел(Ключи[0].ПулИдентификатор), "рамки пула по умолчанию нет").Равно(0);

	// хеш и срок — то, чем гейт ключа отбивает предъявленный секрет раньше всякой логики
	// набора: пустой хеш не совпадёт ни с чем, а прошедший срок закроет ключ молча
	Ожидаем.Что(Ключи[0].Хеш, "хеш ключа непустой").Заполнено();
	Ожидаем.Что(Ключи[0].Истекает, "ключ по умолчанию бессрочный").Равно('00010101');

	Срочный = Стенд.Ключ(Хозяин, "read", 0, "ключ до срока", '20300102030405');
	Ожидаем.Что(Желудь("ХранилищеТокенов").ПолучитьОдноПоИдентификаторРавно(
		Срочный.Идентификатор).Истекает, "названный срок дошёл до базы").Равно('20300102030405');

КонецПроцедуры

// Рамка пула — то, ради чего ключ заводят половина наборов: ключ на весь хаб и ключ
// одного пула ведут себя по-разному, и дверь обязана донести именно названный.
&Тест
Процедура КлючСРамкойПулаЧитаетсяКакКлючЭтогоПула() Экспорт

	Пул = Засев.Пул();
	Хозяин = Стенд.Учётка();

	Стенд.Ключ(Хозяин, "publish", Пул.Идентификатор, "ключ публикации");

	Пуловые = Желудь("ХранилищеТокенов").ТокеныПула(Пул.Идентификатор);
	Ожидаем.Что(Пуловые.Количество(), "ключ виден как ключ пула").Равно(1);
	Ожидаем.Что(Пуловые[0].Права, "названные права дошли до базы").Равно("publish");
	Ожидаем.Что(Пуловые[0].Имя, "названное имя дошло до базы").Равно("ключ публикации");

КонецПроцедуры

// Префиксы ключей свободны: по префиксу владелец узнаёт ключ в списке, и два ключа
// с одним префиксом слиплись бы в кабинете в один.
&Тест
Процедура ПрефиксыКлючейНеСталкиваются() Экспорт

	Хозяин = Стенд.Учётка();

	Первый = Стенд.Ключ(Хозяин);
	Второй = Стенд.Ключ(Хозяин);

	Ожидаем.Что(Первый.Префикс <> Второй.Префикс,
		СтрШаблон("два ключа — два префикса (%1 и %2)",
			Первый.Префикс, Второй.Префикс)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УчёткаСлужбамиХаба

// Дверь «службами хаба» отличается от двери «строкой» не оформлением, а последствиями:
// учётка, заведённая службой, получает настоящий хеш пароля и занимает логин, а учётка,
// положенная строкой, входит только тем, что уже лежит в базе.
&Тест
Процедура УчёткаСлужбойПолучаетХешПароляАСтрокойНет() Экспорт

	Служебная = Стенд.УчёткаСлужбой();
	Строкой = Стенд.Учётка();

	Ожидаем.Что(ЗначениеЗаполнено(Служебная.ХешПароля), "хаб посчитал хеш пароля").ЭтоИстина();
	Ожидаем.Что(Строкой.ХешПароля, "строкой хеша нет").Равно("");

КонецПроцедуры

// Логин хаб канонизирует, и учётка ищется по канону: заведённая службой обязана вести
// себя так же, как заведённая регистрацией.
&Тест
Процедура УчёткаСлужбойКанонизируетЛогинИДоноситРольИАдрес() Экспорт

	Админ = Стенд.УчёткаСлужбой("admin", "SelfTest-Admin", "TestPassw0rd",
		"selftest@example.test");

	Ожидаем.Что(Админ.Логин, "логин в каноне").Равно("selftest-admin");
	Ожидаем.Что(Админ.РольХаба, "роль дошла до хаба").Равно("admin");
	Ожидаем.Что(Админ.Email, "адрес дошёл до хаба").Равно("selftest@example.test");
	Ожидаем.Что(Желудь("СервисПользователей").НайтиПоЛогину("SELFTEST-ADMIN"),
		"учётка ищется службой по любому регистру").Существует();

КонецПроцедуры

// Пароль — параметр двери, а не украшение: набор, проверяющий вход, задаёт свой,
// и хаб обязан пустить именно с ним.
&Тест
Процедура НазванныйПарольПускаетВХаб() Экспорт

	Учётка = Стенд.УчёткаСлужбой("user", "", "Свой-Пароль-9");

	Ожидаем.Что(Желудь("СервисПользователей").ПроверитьПароль(Учётка, "Свой-Пароль-9"),
		"хаб пускает с названным паролем").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПользователей").ПроверитьПароль(Учётка, "TestPassw0rd"),
		"и не пускает с умолчанием двери").ЭтоЛожь();

КонецПроцедуры

// Логины по умолчанию свободны и у службы: одноимённую учётку хаб отвергает исключением.
&Тест
Процедура ЛогиныПоУмолчаниюСлужбыНеСталкиваются() Экспорт

	Первый = Стенд.УчёткаСлужбой();
	Второй = Стенд.УчёткаСлужбой();

	Ожидаем.Что(Первый.Логин <> Второй.Логин,
		СтрШаблон("две учётки — два логина (%1 и %2)", Первый.Логин, Второй.Логин)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции
