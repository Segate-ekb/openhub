// Таблица решений выключателя парольного входа: вердикт предохранителя (СтражПарольногоВхода)
// и разбор формы раздела (ПультПарольногоВхода). Провайдеров даёт НАСТОЯЩАЯ КонфигурацияOIDC
// над фейковой таблицей — вместе с её отбором по признаку «включён».

#Использовать asserts
#Использовать logos
#Использовать oidc-client
#Использовать "фикстуры"

Перем UI;        // СборкаUI — граф компонентов и рендереров web-ui
Перем Кабинет;   // РендерерКабинета (кабинет)
Перем Разбор;    // РазборФормы (кабинет)
Перем Ошибки;    // ТекстОшибки (основа)
Перем Издатель;  // issuer подопытного провайдера

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Издатель = "https://idp.example/realm";
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ХранилищеНастроекВПамяти");
	РеестрФикстур.Подключить("ИздательНастроекЗаглушка");
	РеестрФикстур.Подключить("ФейкУчётокХаба");
	РеестрФикстур.Подключить("ФейкЛичностейПользователя");
	РеестрФикстур.Подключить("ФейкПровайдеровВБазе");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	КаталогОбщего = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "общее");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(КаталогОбщего, "РендерерКабинета");
	Поиск.Подключить(КаталогОбщего, "РазборФормы");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");

	КаталогSettings = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	Поиск.Подключить(КаталогSettings, "ВидыПроверок");
	Поиск.Подключить(КаталогSettings, "НастройкиПодсистем");
	Поиск.Подключить(КаталогSettings, "РеестрНастроек");
	Поиск.Подключить(КаталогSettings, "СервисНастроек");
	Поиск.Подключить(КаталогSettings, "ВалидаторНастроек");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "КанонIP");
	Поиск.Подключить(КаталогSettings, "РазделыНастроекХаба");

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "настройки");
	Поиск.Подключить(КаталогНастроек, "РаскладкаНастроекХаба");
	Поиск.Подключить(КаталогНастроек, "ПоляНастроек");
	Поиск.Подключить(КаталогНастроек, "ВитринаНастроек");
	Поиск.Подключить(КаталогНастроек, "БланкРаздела");
	Поиск.Подключить(КаталогНастроек, "ВитринаПарольногоВхода");
	Поиск.Подключить(КаталогНастроек, "ИтогПульта");
	Поиск.Подключить(КаталогНастроек, "ПультПарольногоВхода");

	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КаталогВхода = ОбъединитьПути(КаталогМодулей, "вход", "Классы");
	Поиск.Подключить(КаталогВхода, "ПолитикаПарольногоВхода");
	Поиск.Подключить(КаталогВхода, "СтражПарольногоВхода");

	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "КонфигурацияOIDC");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ПровайдерыИзБазы");

	Кабинет = Новый РендерерКабинета(UI.Каркас, UI.Экран, Новый ЗащитаCSRF(Неопределено), UI.Набор, UI.Тексты);
	Разбор = Новый РазборФормы();
	Ошибки = Новый ТекстОшибки();

КонецПроцедуры

#Область ВердиктПредохранителя

&Тест
Процедура БезПровайдеровВыключатьНельзя() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Учётки.Добавить(1, "admin");

	Вердикт = Стенд.Страж.ПроверитьВыключение();

	Ожидаем.Что(Вердикт.Можно, "выключать нечем — войти будет нечем").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина).Равно(Стенд.Страж.ПричинаНетПровайдеров());
	Ожидаем.Что(Вердикт.Провайдеров, "включённых провайдеров нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПровайдерЕстьАПривязаннойЛичностиНет() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin");

	Вердикт = Стенд.Страж.ПроверитьВыключение();

	Ожидаем.Что(Вердикт.Можно, "кнопка входа есть, а войти ею некому").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина).Равно(Стенд.Страж.ПричинаНетАдминов());
	Ожидаем.Что(Вердикт.Провайдеров, "провайдер посчитан").Равно(1);
	Ожидаем.Что(Вердикт.Админов, "готовых войти админов нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ЛичностьНеактивногоАдминаНеСчитается() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin", Ложь);
	Стенд.Личности.ДобавитьЛичность(1, Издатель);

	Ожидаем.Что(Стенд.Страж.ПроверитьВыключение().Можно,
		"отключённая учётка админа войти не может").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЛичностьНеАдминаНеСчитается() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin");
	Стенд.Учётки.Добавить(2, "user");
	Стенд.Личности.ДобавитьЛичность(2, Издатель);

	Вердикт = Стенд.Страж.ПроверитьВыключение();

	Ожидаем.Что(Вердикт.Можно, "обычный пользователь админом хаба не распоряжается").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина).Равно(Стенд.Страж.ПричинаНетАдминов());

КонецПроцедуры

&Тест
Процедура ВыключенныйПровайдерНеСчитается() Экспорт

	// выключенная строка базы не участвует в действующей конфигурации: кнопки входа нет,
	// и личность, привязанная к её издателю, войти не даёт
	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Ложь);
	Стенд.Учётки.Добавить(1, "admin");
	Стенд.Личности.ДобавитьЛичность(1, Издатель);

	Вердикт = Стенд.Страж.ПроверитьВыключение();

	Ожидаем.Что(Вердикт.Можно, "выключенный провайдер входа не даёт").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина).Равно(Стенд.Страж.ПричинаНетПровайдеров());
	Ожидаем.Что(Вердикт.Провайдеров, "в действующей конфигурации его нет").Равно(0);

КонецПроцедуры

&Тест
Процедура АдминСЛичностьюВключённогоПровайдераРазрешаетВыключение() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin");
	Стенд.Личности.ДобавитьЛичность(1, Издатель);

	Вердикт = Стенд.Страж.ПроверитьВыключение();

	Ожидаем.Что(Вердикт.Можно, "войти после выключения будет кому").ЭтоИстина();
	Ожидаем.Что(Вердикт.Причина, "отказа нет").Равно("");
	Ожидаем.Что(Вердикт.Админов).Равно(1);
	Ожидаем.Что(Вердикт.Провайдеров).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЗапретСамогоСтража

// Собственный запрет стража, а не пред-проверка пульта: писать значение в обход
// предохранителя нельзя даже прямым вызовом домена.
&Тест
Процедура СтражОтказываетПрямомуВызовуВыключения() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin"); // личности нет — войти будет некому

	Отказ = ВыключениеПадает(Стенд.Страж);

	Ожидаем.Что(Отказ.Упало, "прямое выключение отвергнуто").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ.Сообщение, Стенд.Страж.ПричинаНетАдминов()) > 0,
		"исключение называет код причины: " + Отказ.Сообщение).ЭтоИстина();
	Ожидаем.Что(Стенд.Хранилище.Значение("oshub.auth.password.enabled"),
		"значение в базу не записано").Равно(Неопределено);
	Ожидаем.Что(Стенд.Политика.Включён(), "парольный вход остался включённым").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтражБезПровайдеровОтказываетПрямомуВызову() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Учётки.Добавить(1, "admin");

	Отказ = ВыключениеПадает(Стенд.Страж);

	Ожидаем.Что(Отказ.Упало).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ.Сообщение, Стенд.Страж.ПричинаНетПровайдеров()) > 0,
		"исключение называет код причины: " + Отказ.Сообщение).ЭтоИстина();
	Ожидаем.Что(Стенд.Политика.Включён()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтражВыключаетКогдаВойтиБудетКому() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin");
	Стенд.Личности.ДобавитьЛичность(1, Издатель);

	Стенд.Страж.Выключить("ольга-админ");

	Ожидаем.Что(Стенд.Политика.Выключен(), "парольный вход выключен").ЭтоИстина();
	Ожидаем.Что(Стенд.Хранилище.Автор("oshub.auth.password.enabled"),
		"автор изменения доехал до базы").Равно("ольга-админ");

КонецПроцедуры

&Тест
Процедура СтражВключаетБезПредохранителя() Экспорт

	// путь возврата: администратор, вошедший провайдером, включает форму обратно
	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin");
	Стенд.Личности.ДобавитьЛичность(1, Издатель);
	Стенд.Страж.Выключить("ольга-админ");
	Ожидаем.Что(Стенд.Политика.Выключен(), "КОНТРОЛЬ: выключено").ЭтоИстина();

	// личность отвязана — включению это не мешает: способов входа оно не отнимает
	Стенд.Личности.ОчиститьЛичности(1);
	Стенд.Страж.Включить("ольга-админ");

	Ожидаем.Что(Стенд.Политика.Включён(), "парольный вход включён обратно").ЭтоИстина();
	Ожидаем.Что(Стенд.Хранилище.Значение("oshub.auth.password.enabled"),
		"в базе лежит включённое значение").Равно("true");

КонецПроцедуры

&Тест
Процедура НечитаемаяНастройкаОставляетВходВключённымНоПишетВЛог() Экспорт

	// дефолт реестра не запирает хаб, но тихо открытая дверь обязана быть видна оператору
	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.парольныйвход.нечитаемая");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Политика = Новый ПолитикаПарольногоВхода(Новый НастройкиЗаглушка(), Лог);

	Ожидаем.Что(Политика.Включён(), "нечитаемая настройка не гасит вход").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "password login stays ENABLED") > 0,
		"предупреждение в журнале: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "oshub.auth.password.enabled") > 0,
		"с именем ключа").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РешенияПульта

&Тест
Процедура БезПоляТумблераПультМимо() Экспорт

	Стенд = ПостроитьСтенд();
	Итог = Стенд.Пульт.Применить("login", Новый Соответствие(), "root");

	Ожидаем.Что(Итог.Перехвачено, "чужую форму пульт не трогает").ЭтоЛожь();
	Ожидаем.Что(Стенд.Политика.Включён(), "и ничего не пишет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧужойРазделПультМимо() Экспорт

	Стенд = ПостроитьСтенд();
	Итог = Стенд.Пульт.Применить("pools", ФормаТумблера("0"), "root");

	Ожидаем.Что(Итог.Перехвачено, "раздел не его").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗначениеРавноеТекущемуПультМимо() Экспорт

	Стенд = ПостроитьСтенд();
	Итог = Стенд.Пульт.Применить("login", ФормаТумблера("1"), "root");

	Ожидаем.Что(Итог.Перехвачено, "включённое включать незачем").ЭтоЛожь();
	Ожидаем.Что(Стенд.Хранилище.Значение("oshub.auth.password.enabled"),
		"в базу ничего не писалось").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ВыключениеБезПредохранителяОтклоняетсяДоВопроса() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin");

	Итог = Стенд.Пульт.Применить("login", ФормаТумблера("0"), "root");

	Ожидаем.Что(Итог.Перехвачено).ЭтоИстина();
	Ожидаем.Что(Итог.Спросить, "подтверждать нечего: операция запрещена по существу")
		.Равно(Неопределено);
	Ожидаем.Что(СтрНайти(Итог.Ошибка, "ни у одного администратора") > 0,
		"отказ называет нехватку личности: " + Итог.Ошибка).ЭтоИстина();
	Ожидаем.Что(Стенд.Политика.Включён()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВыключениеСПредохранителемСпрашиваетПодтверждение() Экспорт

	Стенд = РазрешающийСтенд();
	Итог = Стенд.Пульт.Применить("login", ФормаТумблера("0"), "root");

	Ожидаем.Что(Итог.Перехвачено).ЭтоИстина();
	Ожидаем.Что(Итог.Ошибка, "это не отказ, а вопрос").Равно("");
	Ожидаем.Что(Итог.Спросить <> Неопределено, "вопрос задан").ЭтоИстина();
	Ожидаем.Что(Итог.Спросить.Админов, "вопрос несёт числа вердикта").Равно(1);
	Ожидаем.Что(Стенд.Политика.Включён(), "вопрос ничего не записал").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПодтверждениеПриУжеВыключенномОтклоняется() Экспорт

	Стенд = РазрешающийСтенд();
	Стенд.Страж.Выключить("root");

	Итог = Стенд.Пульт.Применить("login", ФормаПодтверждения("выключить"), "root");

	Ожидаем.Что(Итог.Перехвачено).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итог.Ошибка, "уже выключен") > 0,
		"операция живёт только как переход: " + Итог.Ошибка).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеверноеЭхоНичегоНеМеняетИСпрашиваетЗаново() Экспорт

	Стенд = РазрешающийСтенд();
	Итог = Стенд.Пульт.Применить("login", ФормаПодтверждения("выключай"), "root");

	Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка), "отказ по эху").ЭтоИстина();
	Ожидаем.Что(Итог.Спросить <> Неопределено, "вопрос показан заново").ЭтоИстина();
	Ожидаем.Что(Стенд.Политика.Включён(), "парольный вход не выключен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВерноеЭхоВыключаетНезависимоОтРегистра() Экспорт

	Стенд = РазрешающийСтенд();
	Итог = Стенд.Пульт.Применить("login", ФормаПодтверждения("  ВЫКЛЮЧИТЬ "), "root");

	Ожидаем.Что(Итог.Ошибка, "отказа нет").Равно("");
	Ожидаем.Что(ЗначениеЗаполнено(Итог.Уведомление), "итог операции назван").ЭтоИстина();
	Ожидаем.Что(Стенд.Политика.Выключен(), "парольный вход выключен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВердиктПересчитываетсяМеждуВопросомИОтветом() Экспорт

	// между вопросом и подтверждением админ отвязал свою личность: подтверждать
	// надо ровно то, что происходит СЕЙЧАС, иначе форма выключит вход в пустоту
	Стенд = РазрешающийСтенд();
	Вопрос = Стенд.Пульт.Применить("login", ФормаТумблера("0"), "root");
	Ожидаем.Что(Вопрос.Спросить <> Неопределено, "КОНТРОЛЬ: вопрос задан").ЭтоИстина();

	Стенд.Личности.ОчиститьЛичности(1);
	Итог = Стенд.Пульт.Применить("login", ФормаПодтверждения("выключить"), "root");

	Ожидаем.Что(СтрНайти(Итог.Ошибка, "ни у одного администратора") > 0,
		"подтверждение отвергнуто пересчитанным вердиктом: " + Итог.Ошибка).ЭтоИстина();
	Ожидаем.Что(Стенд.Политика.Включён(), "парольный вход остался включённым").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТумблерВключаетПарольныйВходОбратно() Экспорт

	Стенд = РазрешающийСтенд();
	Стенд.Страж.Выключить("root");
	Ожидаем.Что(Стенд.Политика.Выключен(), "КОНТРОЛЬ: выключено").ЭтоИстина();

	Итог = Стенд.Пульт.Применить("login", ФормаТумблера("1"), "root");

	Ожидаем.Что(Итог.Перехвачено, "включение — тоже переход пульта").ЭтоИстина();
	Ожидаем.Что(Итог.Ошибка, "отказа нет").Равно("");
	Ожидаем.Что(ЗначениеЗаполнено(Итог.Уведомление), "итог операции назван").ЭтоИстина();
	Ожидаем.Что(Стенд.Политика.Включён(), "парольный вход включён").ЭтоИстина();
	Ожидаем.Что(Стенд.Хранилище.Автор("oshub.auth.password.enabled"),
		"автор изменения доехал до базы").Равно("root");

КонецПроцедуры

&Тест
Процедура ВключениеНеТребуетПредохранителя() Экспорт

	// провайдеров нет вовсе, войти после выключения было бы некому — но включение
	// способов входа не отнимает, и предохранитель ему не помеха
	Стенд = ПостроитьСтенд();
	Стенд.Хранилище.Установить("oshub.auth.password.enabled", "false", "root",
		ТекущаяУниверсальнаяДата());

	Итог = Стенд.Пульт.Применить("login", ФормаТумблера("1"), "root");

	Ожидаем.Что(Итог.Ошибка, "отказа нет").Равно("");
	Ожидаем.Что(Стенд.Политика.Включён(), "парольный вход включён").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Стенд

Функция ПостроитьСтенд()

	Реестр = Новый РеестрНастроек(Новый ВидыПроверок(),
		Новый НастройкиПодсистем(Новый ВидыПроверок()));
	Хранилище = Новый ХранилищеНастроекВПамяти();
	Настройки = Новый СервисНастроек(Реестр, Хранилище, Новый ИздательНастроекЗаглушка(),
		Новый ИмяОбъектаАудита(), Новый ВалидаторНастроек(Новый КанонIP()));
	Разделы = Новый РазделыНастроекХаба();
	Раскладка = Новый РаскладкаНастроекХаба();
	ПоляКарточек = Новый ПоляНастроек(Реестр, UI.Кит, UI.Тексты);
	Витрина = Новый ВитринаНастроек(Настройки, Разделы, Раскладка, ПоляКарточек, UI.Кит,
		UI.РендерерНастроек, UI.Тексты, Новый БланкРаздела(UI.Кит));

	Учётки = Новый ФейкУчётокХаба();
	Личности = Новый ФейкЛичностейПользователя();
	Провайдеры = Новый ФейкПровайдеровВБазе();

	Политика = Новый ПолитикаПарольногоВхода(Настройки);
	Конфигурация = Новый КонфигурацияOIDC(Логирование.ПолучитьЛог("тест.oshub.парольныйвход"),
		Новый ПровайдерыИзБазы(Провайдеры));
	Страж = Новый СтражПарольногоВхода(Настройки, Политика, Учётки, Личности, Конфигурация);

	Окно = Новый ВитринаПарольногоВхода(UI.Кит, UI.РендерерНастроек, UI.Тексты);
	Пульт = Новый ПультПарольногоВхода(Разбор, Политика, Страж, Разделы, ПоляКарточек,
		Окно, Новый ИтогПульта(), Ошибки, UI.Тексты);

	Итог = Новый Структура();
	Итог.Вставить("Хранилище", Хранилище);
	Итог.Вставить("Настройки", Настройки);
	Итог.Вставить("Учётки", Учётки);
	Итог.Вставить("Личности", Личности);
	Итог.Вставить("Провайдеры", Провайдеры);
	Итог.Вставить("Политика", Политика);
	Итог.Вставить("Страж", Страж);
	Итог.Вставить("Пульт", Пульт);
	Возврат Итог;

КонецФункции

// Стенд, на котором предохранитель разрешает выключение: включённый провайдер и админ
// с привязанной к нему личностью.
Функция РазрешающийСтенд()

	Стенд = ПостроитьСтенд();
	Стенд.Провайдеры.Добавить("fake", Издатель, Истина);
	Стенд.Учётки.Добавить(1, "admin");
	Стенд.Личности.ДобавитьЛичность(1, Издатель);
	Возврат Стенд;

КонецФункции

Функция ФормаТумблера(Знач Значение)
	Форма = Новый Соответствие();
	Форма.Вставить("oshub.auth.password.enabled", Значение);
	Возврат Форма;
КонецФункции

Функция ФормаПодтверждения(Знач Эхо)
	Форма = Новый Соответствие();
	Форма.Вставить("операция", "парольный-вход");
	Форма.Вставить("подтверждение", Эхо);
	Возврат Форма;
КонецФункции

Функция ВыключениеПадает(Знач Страж)

	Результат = Новый Структура("Упало, Сообщение", Ложь, "");
	Попытка
		Страж.Выключить("root");
	Исключение
		Результат.Упало = Истина;
		Результат.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти
