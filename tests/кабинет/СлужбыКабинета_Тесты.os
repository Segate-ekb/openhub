// Юнит-тесты служб кабинета на фейках соседей: службы реестра, прав и учёток подменены,
// гвард квоты, журнал аудита и шина событий — настоящие. Проверяется решение службы.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем Пулы;          // фикстура СервисПуловЗаглушка — пулы; заведение, назначение и снос запоминаются
Перем Пакеты;        // фикстура ФейкПакетовДляЛетописи — пакеты и счёт вопросов о пакетах пула
Перем Версии;        // фикстура ФейкСервисВерсий — кто что публиковал
Перем Права;         // фикстура ФейкСервисПрав — что кому можно
Перем Доступы;       // фикстура ФейкСервисПравДоступа — выданные и отозванные права
Перем Учётки;        // фикстура СервисПользователейЗаглушка — учётки хаба
Перем Шина;          // ИздательСобытий (события) — настоящая шина
Перем Журнал;        // фикстура ЗаписывающийПодписчик — что шина разослала
Перем Ловушка;       // фикстура ЛовушкаЛога — что службы написали в журнал приложения
Перем Следующий;     // Число — идентификатор следующей записи засева

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СервисПуловЗаглушка");
	РеестрФикстур.Подключить("ФейкПакетЗапись");
	РеестрФикстур.Подключить("ФейкПакетовДляЛетописи");
	РеестрФикстур.Подключить("ФейкСервисВерсий");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ФейкСервисПравДоступа");
	РеестрФикстур.Подключить("СервисПользователейЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ЛовушкаЛога");

	Модули = КаталогиПроекта.Модули();
	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "события", "Классы"), "ИздательСобытий");
	Поиск.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	Поиск.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Поиск.Подключить(ОбъединитьПути(Модули, "права", "Классы"), "ГвардКвотыПула");
	Поиск.ПодключитьВсе(ОбъединитьПути(Модули, "кабинет", "Классы"));

	Ловушка = Новый ЛовушкаЛога();
	ЛогСлужб().ДобавитьСпособВывода(Ловушка, УровниЛога.Отладка);

КонецПроцедуры

&ПередКаждым
Процедура НовыеСоседи() Экспорт

	Пулы = Новый СервисПуловЗаглушка();
	Пакеты = Новый ФейкПакетовДляЛетописи();
	Версии = Новый ФейкСервисВерсий();
	Права = Новый ФейкСервисПрав();
	Доступы = Новый ФейкСервисПравДоступа();
	Учётки = Новый СервисПользователейЗаглушка();
	Шина = Новый ИздательСобытий();
	Журнал = Новый ЗаписывающийПодписчик();
	Шина.Подписать(Шина.ТипПулУдалён(), Журнал);
	Шина.Подписать(Шина.ТипЛичныеПространстваИзменены(), Журнал);
	Ловушка.Очистить();
	Следующий = 0;

КонецПроцедуры

#Область СлужбаДоступа

&Тест
Процедура ПулСоздаётТолькоТотКомуМожно() Экспорт

	Ожидаем.Что(Отказ("СоздатьПул", Человек(), "team"),
		"без права создания пул не заводится").Содержит("Недостаточно прав");
	Ожидаем.Что(Пулы.Созданные.Количество(), "реестр не спрошен").Равно(0);

	Права = Новый ФейкСервисПрав("создание");
	Пул = Доступ().СоздатьПул(Человек(), "team");

	Ожидаем.Что(Пул.Имя, "с правом — заводится").Равно("team");

КонецПроцедуры

&Тест
Процедура ПулБезКвотыНаследуетКвотуХаба() Экспорт

	Права = Новый ФейкСервисПрав("создание");

	Доступ().СоздатьПул(Человек(), "team");

	Ожидаем.Что(Пулы.Созданные[0].КвотаМб, "квота «как в хабе»").Равно(Пулы.КвотаКакВХабе());

КонецПроцедуры

// Удалённый пул — веха уровня хаба строкой службы: имя пула и номер удалившего.
&Тест
Процедура УдалённыйПулВиденНаИнформации() Экспорт

	Права = Новый ФейкСервисПрав("создание,удаление");
	Пул = Доступ().СоздатьПул(Человек(), "gonepool");
	ПриИнформации = Новый ЛовушкаЛога();
	ПриИнформации.Поставить(ЛогСлужб(), УровниЛога.Информация);
	Попытка
		Доступ().УдалитьПул(Человек(), Пул.Идентификатор);
	Исключение
		ПриИнформации.Снять();
		ВызватьИсключение;
	КонецПопытки;
	ПриИнформации.Снять();

	Ожидаем.Что(ПриИнформации.Всё(), "удаление пула названо: " + ПриИнформации.Всё())
		.Содержит("""gonepool""");
	Ожидаем.Что(ПриИнформации.Всё(), "с тем, кто удалил")
		.Содержит("#" + Формат(Человек().Идентификатор, "ЧГ=0"));
	Ожидаем.Что(ПриИнформации.Всё(), "и числом снятых заявок").Содержит("заявок");

КонецПроцедуры

// Назначение основного пула — веха уровня хаба; повтор того же пула ничего не меняет и молчит.
&Тест
Процедура НазначениеОсновногоПулаВидноНаИнформацииАПовторМолчит() Экспорт

	Пул = ЗавестиПул("mainveha");
	Права = Новый ФейкСервисПрав("изменение");
	ПриИнформации = Новый ЛовушкаЛога();
	ПриИнформации.Поставить(ЛогСлужб(), УровниЛога.Информация);
	Попытка
		Доступ().НазначитьОсновнойПул(Человек(), Пул.Идентификатор);
		Назначение = ПриИнформации.Всё();
		ПриИнформации.Очистить();
		Доступ().НазначитьОсновнойПул(Человек(), Пул.Идентификатор);
	Исключение
		ПриИнформации.Снять();
		ВызватьИсключение;
	КонецПопытки;
	ПриИнформации.Снять();

	Ожидаем.Что(Назначение, "назначение названо: " + Назначение).Содержит("""mainveha""");
	Ожидаем.Что(Назначение, "с тем, кто назначил").Содержит("""alice""");
	Ожидаем.Что(ПриИнформации.Всё(), "повтор того же пула молчит").Равно("");

КонецПроцедуры

// Включение и выключение личных пространств — вехи уровня хаба с числами и тем, кто переключил.
&Тест
Процедура ВключениеИВыключениеЛичныхПространствВидныНаИнформации() Экспорт

	Засеять();
	Учётки.ДобавитьУчётку("new");
	ПриИнформации = Новый ЛовушкаЛога();
	ПриИнформации.Поставить(ЛогСлужб(), УровниЛога.Информация);
	Попытка
		Пространства().РаздатьВсем("root");
		Включение = ПриИнформации.Всё();
		ПриИнформации.Очистить();
		Пространства().УдалитьВсе("root");
	Исключение
		ПриИнформации.Снять();
		ВызватьИсключение;
	КонецПопытки;
	ПриИнформации.Снять();
	Выключение = ПриИнформации.Всё();

	Ожидаем.Что(Включение, "включение названо: " + Включение)
		.Содержит("Личные пространства включены, кто ""root"": заведено 1");
	Ожидаем.Что(Выключение, "выключение названо: " + Выключение)
		.Содержит("Личные пространства выключены, кто ""root"": снесено пулов 2");

КонецПроцедуры

// Заведённый пул — веха уровня хаба: имя пула и номер создателя видны без отладки.
&Тест
Процедура ЗаведённыйПулВиденНаИнформации() Экспорт

	Права = Новый ФейкСервисПрав("создание");
	ПриИнформации = Новый ЛовушкаЛога();
	ПриИнформации.Поставить(ЛогСлужб(), УровниЛога.Информация);
	Попытка
		Доступ().СоздатьПул(Человек(), "infopool");
	Исключение
		ПриИнформации.Снять();
		ВызватьИсключение;
	КонецПопытки;
	ПриИнформации.Снять();

	Ожидаем.Что(ПриИнформации.Всё(), "пул назван на ИНФОРМАЦИИ: " + ПриИнформации.Всё())
		.Содержит("""infopool""");
	Ожидаем.Что(ПриИнформации.Всё(), "с создателем")
		.Содержит("#" + Формат(Человек().Идентификатор, "ЧГ=0"));

КонецПроцедуры

&Тест
Процедура КвотуНовогоПулаЗадаётТолькоТотКтоВправеЕёМенять() Экспорт

	Права = Новый ФейкСервисПрав("создание");

	Ожидаем.Что(Отказ("СоздатьПул", Человек(), "team", "custom", "public", 100),
		"причина — слова гварда квоты").Содержит(Новый ГвардКвотыПула(Права).ПричинаОтказа());
	Ожидаем.Что(Пулы.Созданные.Количество(), "пул не заведён").Равно(0);

	Права = Новый ФейкСервисПрав();
	Доступ().СоздатьПул(Админ(), "team", "custom", "public", 100);

	Ожидаем.Что(Пулы.Созданные[0].КвотаМб, "администратору хаба — квота принята").Равно(100);

КонецПроцедуры

&Тест
Процедура СоздательСтановитсяВладельцемСвоегоПула() Экспорт

	Права = Новый ФейкСервисПрав("создание");

	Пул = Доступ().СоздатьПул(Человек(), "team");

	Гранты = Доступы.ВызовыМетода("ЗафиксироватьГрант");
	Ожидаем.Что(Гранты.Количество(), "грант выдан один").Равно(1);
	Ожидаем.Что(Гранты[0].СубъектИд, "создателю").Равно(Человек().Идентификатор);
	Ожидаем.Что(Гранты[0].Объект.Идентификатор, "на его пул").Равно(Пул.Идентификатор);
	Для Каждого Действие Из СтрРазделить("создание,изменение,удаление,чтение", ",") Цикл
		Ожидаем.Что(Гранты[0].Значение[Действие], "полный набор: " + Действие).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(Пулы.Созданные[0].ВладелецИдентификатор, "и пул записан за ним")
		.Равно(Человек().Идентификатор);

КонецПроцедуры

&Тест
Процедура ОсновнойПулНазначаетТолькоИмеющийПраво() Экспорт

	Пул = ЗавестиПул("main");

	Ожидаем.Что(Отказ("НазначитьОсновнойПул", Человек(), Пул.Идентификатор),
		"без права — отказ").Содержит("основной пул");
	Ожидаем.Что(Пулы.Назначенные.Количество(), "реестр не спрошен").Равно(0);

	Права = Новый ФейкСервисПрав("изменение");
	Доступ().НазначитьОсновнойПул(Человек(), Пул.Идентификатор);

	Ожидаем.Что(Пулы.Назначенные[0].ПулИдентификатор, "назначен тот пул").Равно(Пул.Идентификатор);
	Ожидаем.Что(Пулы.Назначенные[0].Кем, "и назван, кем").Равно(Человек().Логин);

КонецПроцедуры

&Тест
Процедура ПулУдаляетТолькоИмеющийПраво() Экспорт

	Пул = ЗавестиПул("old");

	Ожидаем.Что(Отказ("УдалитьПул", Человек(), Пул.Идентификатор),
		"без права — отказ").Содержит("удаления пула");
	Ожидаем.Что(Пулы.Удалённые.Количество(), "пул цел").Равно(0);
	Ожидаем.Что(Журнал.Количество(), "и в журнал ничего не ушло").Равно(0);

КонецПроцедуры

&Тест
Процедура УдалениеПулаОставляетСледВЖурналеАудитаСЧисламиУборки() Экспорт

	Права = Новый ФейкСервисПрав("удаление");
	Пул = ЗавестиПул("old");

	Итог = Доступ().УдалитьПул(Человек(), Пул.Идентификатор);

	Ожидаем.Что(Пулы.Удалённые.Найти(Пул.Идентификатор), "пул снесён").Не_().Равно(Неопределено);

	Событие = Журнал.Первое(Шина.ТипПулУдалён());
	Ожидаем.Что(Событие, "в журнал ушло удаление пула").Не_().Равно(Неопределено);
	Ожидаем.Что(Событие.Данные.Кто, "названо, кто удалил").Равно(Человек().Логин);
	Ожидаем.Что(Событие.Данные.Объект, "объект — пул по имени: его уже нет").Равно("пул/old");

	Детали = ИзJSON(Событие.Данные.ДеталиJSON);
	Для Каждого Число_ Из СтрРазделить("Пакетов,Артефактов,Доступов,Ролей,Подписок,Зеркал,Апстримов,Заявок,Строк", ",") Цикл
		Ожидаем.Что(Детали.Получить(Число_), "детали несут число уборки " + Число_).Равно(Итог[Число_]);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура БезШиныПулУдаляетсяАЖурналМолчит() Экспорт

	Права = Новый ФейкСервисПрав("удаление");
	Пул = ЗавестиПул("old");

	Доступ(Новый Массив()).УдалитьПул(Человек(), Пул.Идентификатор);

	Ожидаем.Что(Пулы.Удалённые.Количество(), "пул снесён и без модуля событий").Равно(1);

КонецПроцедуры

// Пул объекта права берётся из сущности, а не из ввода: иначе пакет чужого пула
// наследовал бы права того пула, который назвал запрос.
&Тест
Процедура ПравоНаОбъектВыдаётсяСПуломИзСущности() Экспорт

	Свой = ЗавестиПул("own");
	Чужой = ЗавестиПул("foreign");
	Пакет = ЗавестиПакет(Чужой, "lib");

	Доступ().ВыдатьРоль(Человек(), "пользователь", 7, "Пакет", Пакет.Идентификатор, "читатель");
	Доступ().ВыдатьРоль(Человек(), "пользователь", 7, " пул ", Свой.Идентификатор, "читатель");

	НаПакет = Доступы.ВызовыМетода("ВыдатьРоль")[0].Объект;
	Ожидаем.Что(НаПакет.ПулИдентификатор, "у пакета — пул, где пакет живёт").Равно(Чужой.Идентификатор);
	Ожидаем.Что(НаПакет.Идентификатор, "объект — сам пакет").Равно(Пакет.Идентификатор);

	НаПул = Доступы.ВызовыМетода("ВыдатьРоль")[1].Объект;
	Ожидаем.Что(НаПул.ТипОбъекта, "тип объекта нормализован").Равно("пул");
	Ожидаем.Что(НаПул.ПулИдентификатор, "у пула — он сам").Равно(Свой.Идентификатор);

КонецПроцедуры

&Тест
Процедура ПравоНаНеизвестныйИлиПропавшийОбъектНеВыдаётся() Экспорт

	Ожидаем.Что(Отказ("ВыдатьРоль", Человек(), "пользователь", 7, "группа", 1, "читатель"),
		"тип объекта вне модели прав").Содержит("Неизвестный тип объекта");
	Ожидаем.Что(Отказ("ВыдатьРоль", Человек(), "пользователь", 7, "пул", 999, "читатель"),
		"пул, которого нет").Содержит("не найден");
	Ожидаем.Что(Отказ("ВыдатьРоль", Человек(), "пользователь", 7, "пакет", 999, "читатель"),
		"пакет, которого нет").Содержит("не найден");
	Ожидаем.Что(Доступы.ВызовыМетода("ВыдатьРоль").Количество(), "права не спрошены").Равно(0);

КонецПроцедуры

&Тест
Процедура ПравоНаХабНеСпрашиваетРеестр() Экспорт

	Доступ().ВыдатьРоль(Человек(), "пользователь", 7, "хаб", 0, "читатель");

	Выдача = Доступы.ВызовыМетода("ВыдатьРоль")[0];
	Ожидаем.Что(Выдача.Объект.ТипОбъекта, "объект — хаб").Равно("хаб");
	Ожидаем.Что(Выдача.Значение, "роль передана как есть").Равно("читатель");

КонецПроцедуры

&Тест
Процедура ТипыОбъектовПраваХабПулПакет() Экспорт

	Для Каждого Тип Из СтрРазделить("хаб,пул,пакет, Пул ", ",") Цикл
		Ожидаем.Что(Доступ().ТипОбъектаПоддерживается(Тип), "поддерживается: " + Тип).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(Доступ().ТипОбъектаПоддерживается("группа"), "группа — субъект, а не объект").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужбаКабинета

&Тест
Процедура АнонимуИНеполномуВопросуУправлятьНельзя() Экспорт

	Права = Новый ФейкСервисПрав("изменение");
	Пул = ЗавестиПул("own");
	Пакет = ЗавестиПакет(Пул, "lib");

	Ожидаем.Что(Кабинет().МожетУправлять(Неопределено, Пул, Пакет), "аноним").ЭтоЛожь();
	Ожидаем.Что(Кабинет().МожетУправлять(Человек(), Неопределено, Пакет), "без пула").ЭтоЛожь();
	Ожидаем.Что(Кабинет().МожетУправлять(Человек(), Пул, Неопределено), "без пакета").ЭтоЛожь();
	Ожидаем.Что(Кабинет().МожетУправлять(Человек(), Пул, Пакет), "КОНТРОЛЬ: с полным вопросом — да").ЭтоИстина();

КонецПроцедуры

