	Версии.ДобавитьВерсию(Опубликованный.Идентификатор, Человек().Идентификатор);
	Версии.ДобавитьВерсию(Чужой.Идентификатор, Человек().Идентификатор + 1);

	Ожидаем.Что(Кабинет().МожетУправлять(Человек(), Пул, Опубликованный), "по публикации").ЭтоИстина();
	Ожидаем.Что(Кабинет().МожетУправлять(Человек(), Пул, Чужой), "чужая публикация").ЭтоЛожь();

	Права = Новый ФейкСервисПрав("изменение");
	Ожидаем.Что(Кабинет().МожетУправлять(Человек(), Пул, Чужой), "по праву изменения").ЭтоИстина();

