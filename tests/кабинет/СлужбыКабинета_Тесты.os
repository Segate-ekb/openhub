#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Доступ(Знач Издатели = Неопределено)
	Возврат Новый СлужбаДоступа(Пулы, Пакеты, Права, Доступы, Новый ГвардКвотыПула(Права),
		?(Издатели = Неопределено, ИздателиШины(), Издатели), ИменаЖурнала(), СобытиеЖурнала(), ЛогСлужб());
КонецФункции

Функция Кабинет()
	Возврат Новый СлужбаКабинета(Пулы, Пакеты, Версии, Права);
КонецФункции

Функция Пространства(Знач Издатели = Неопределено)
	Возврат Новый СлужбаЛичныхПространств(Пулы, Пакеты, Версии, Учётки,
		?(Издатели = Неопределено, ИздателиШины(), Издатели), ИменаЖурнала(), СобытиеЖурнала(), ЛогСлужб());
КонецФункции

// Два личных пространства — с пакетами и пустое — и проектный пул с пакетом рядом.
Процедура Засеять()

	Алиса = ЗавестиПул("alice", "user", 1);
	Библиотека = ЗавестиПакет(Алиса, "lib");
	Версии.ДобавитьВерсию(Библиотека.Идентификатор, 1);
	Версии.ДобавитьВерсию(Библиотека.Идентификатор, 1);
	Версии.ДобавитьВерсию(ЗавестиПакет(Алиса, "tool").Идентификатор, 1);
	ЗавестиПул("bob", "user", 2);
	Версии.ДобавитьВерсию(ЗавестиПакет(ЗавестиПул("team"), "shared").Идентификатор, 1);

КонецПроцедуры

Функция ЗавестиПул(Знач Имя, Знач Тип = "custom", Знач ВладелецИдентификатор = 0)
	Пул = Новый Структура("Идентификатор, Имя, Тип, ВладелецИдентификатор",
		ЗавестиИдентификатор(), Имя, Тип, ВладелецИдентификатор);
	Пулы.ДобавитьПул(Пул, Ложь);
	Возврат Пул;
КонецФункции

Функция ЗавестиПакет(Знач Пул, Знач Имя)
	Возврат Пакеты.Добавить(ЗавестиИдентификатор(), Имя, Пул.Идентификатор);
КонецФункции

Функция ЗавестиИдентификатор()
	Следующий = Следующий + 1;
	Возврат Следующий;
КонецФункции

Функция Список(Знач Первый, Знач Второй = Неопределено)
	Результат = Новый Массив();
	Результат.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ИздателиШины()
	Результат = Новый Массив();
	Результат.Добавить(Шина);
	Возврат Результат;
КонецФункции

Функция ИменаЖурнала()
	Возврат Новый ИмяОбъектаАудита();
КонецФункции

Функция СобытиеЖурнала()
	Возврат Новый СобытиеАудита(ИменаЖурнала(), Новый ТекстJSON());
КонецФункции

Функция ЛогСлужб()
	Возврат Логирование.ПолучитьЛог("тест.oshub.кабинет");
КонецФункции

Функция Человек()
	Возврат Новый Структура("Идентификатор, Логин, Админ", 42, "alice", Ложь);
КонецФункции

Функция Админ()
	Возврат Новый Структура("Идентификатор, Логин, Админ", 1, "root", Истина);
КонецФункции

// Текст исключения метода службы доступа; метод не отказал — пустая строка.
Функция Отказ(Знач Метод, Знач П1, Знач П2, Знач П3 = Неопределено, Знач П4 = Неопределено,
	Знач П5 = Неопределено, Знач П6 = Неопределено)

	Служба = Доступ();
	Попытка
		Если Метод = "СоздатьПул" Тогда
			Служба.СоздатьПул(П1, П2, ?(П3 = Неопределено, "custom", П3), ?(П4 = Неопределено, "public", П4), П5);
		ИначеЕсли Метод = "НазначитьОсновнойПул" Тогда
			Служба.НазначитьОсновнойПул(П1, П2);
		ИначеЕсли Метод = "УдалитьПул" Тогда
			Служба.УдалитьПул(П1, П2);
		ИначеЕсли Метод = "ВыдатьРоль" Тогда
			Служба.ВыдатьРоль(П1, П2, П3, П4, П5, П6);
		КонецЕсли;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция Координаты(Знач Выдача)
	Части = Новый Массив();
	Для Каждого Строка_ Из Выдача Цикл
		Части.Добавить(Строка_.Пул.Имя + "/" + Строка_.Пакет.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция Имена(Знач Пулы_)
	Части = Новый Массив();
	Для Каждого Пул Из Пулы_ Цикл
		Части.Добавить(Пул.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ИзJSON(Знач Текст)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

#КонецОбласти
