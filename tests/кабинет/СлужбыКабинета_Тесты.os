&Тест
Процедура РаздачаСчитаетИсходыПоУчёткам() Экспорт

	Учётки.ДобавитьУчётку("new", Учётки.ИтогСоздан());
	Учётки.ДобавитьУчётку("old", Учётки.ИтогБыло());
	Учётки.ДобавитьУчётку("off", Учётки.ИтогПропущен());
	Учётки.ДобавитьУчётку("taken", Учётки.ИтогИмяЗанято());
