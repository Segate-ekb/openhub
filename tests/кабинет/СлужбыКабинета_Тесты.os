	Ожидаем.Что(Ловушка.Всё(), "журнал называет учётку без пространства").Содержит("""taken"" не заведено");

	Событие = Журнал.Первое(Шина.ТипЛичныеПространстваИзменены());
	Ожидаем.Что(Событие.Данные.Действие, "в журнал ушла раздача").Равно("пространства.личные.розданы");
	Ожидаем.Что(ИзJSON(Событие.Данные.ДеталиJSON).Получить("Ошибок")).Равно(2);

