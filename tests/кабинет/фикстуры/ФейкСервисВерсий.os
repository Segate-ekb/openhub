// Фейк СервисаВерсий глазами кабинета: версии в памяти — чьи пакеты публиковал человек
// и сколько версий у списка пакетов.

Перем Версии_; // Массив из Структура (ПакетИдентификатор, ОпубликовалИдентификатор)

// Заводит версию пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ОпубликовалИдентификатор - Число - публикатор (необязательный, по умолчанию 0).
//
Процедура ДобавитьВерсию(Знач ПакетИдентификатор, Знач ОпубликовалИдентификатор = 0) Экспорт
	Версии_.Добавить(Новый Структура("ПакетИдентификатор, ОпубликовалИдентификатор",
		Цел(ПакетИдентификатор), Цел(ОпубликовалИдентификатор)));
КонецПроцедуры

// Контракт СервисаВерсий: версии, опубликованные пользователем.
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор публикатора.
//
// Возвращаемое значение:
//  Массив из Структура - ПакетИдентификатор, ОпубликовалИдентификатор.
//
Функция ВерсииПользователя(Знач ПользовательИдентификатор) Экспорт

	Результат = Новый Массив();
	Для Каждого Версия Из Версии_ Цикл
		Если Версия.ОпубликовалИдентификатор = Цел(ПользовательИдентификатор) Тогда
			Результат.Добавить(Версия);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контракт СервисаВерсий: публиковал ли человек версию пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ПользовательИдентификатор - Число - идентификатор публикатора.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПользовательОпубликовалВерсию(Знач ПакетИдентификатор, Знач ПользовательИдентификатор) Экспорт

	Для Каждого Версия Из ВерсииПользователя(ПользовательИдентификатор) Цикл
		Если Версия.ПакетИдентификатор = Цел(ПакетИдентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Контракт СервисаВерсий: сколько версий у перечисленных пакетов вместе.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВерсийВПакетах(Знач ПакетИдентификаторы) Экспорт

	Итог = 0;
	Для Каждого Версия Из Версии_ Цикл
		Если ПакетИдентификаторы.Найти(Версия.ПакетИдентификатор) <> Неопределено Тогда
			Итог = Итог + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Процедура ПриСозданииОбъекта()
	Версии_ = Новый Массив();
КонецПроцедуры
