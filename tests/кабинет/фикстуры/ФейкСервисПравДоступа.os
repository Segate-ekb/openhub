// Фейк СервисаПравДоступа: выдачи, отзывы и вопросы о правах запоминаются в Вызовы; выдавать
// права вправе вошедший, если это разрешено РазрешитьВыдачу.

Перем ВыдачаРазрешена; // Булево — МожетВыдаватьГрант отвечает «да» вошедшему
Перем Вызовы Экспорт;  // Массив из Структура (Метод, ТипСубъекта, СубъектИд, Объект, Значение)

// Разрешает вошедшему выдавать права.
//
Процедура РазрешитьВыдачу() Экспорт
	ВыдачаРазрешена = Истина;
КонецПроцедуры

// Вызовы с заданным именем метода.
//
// Параметры:
//  Метод - Строка - имя метода фейка.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ВызовыМетода(Знач Метод) Экспорт

	Результат = Новый Массив();
	Для Каждого Вызов Из Вызовы Цикл
		Если Вызов.Метод = Метод Тогда
			Результат.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контракт СервисаПравДоступа: системная фиксация гранта.
//
// Параметры:
//  ТипСубъекта - Строка.
//  СубъектИд - Число.
//  Объект - Структура.
//  Действия - Структура.
//  КемВыдано - Число (необязательный).
//  КтоСтрокой - Строка (необязательный).
//
// Возвращаемое значение:
//  Структура - запись вызова.
//
Функция ЗафиксироватьГрант(Знач ТипСубъекта, Знач СубъектИд, Знач Объект, Знач Действия,
	Знач КемВыдано = 0, Знач КтоСтрокой = "") Экспорт
	Возврат Запомнить("ЗафиксироватьГрант", ТипСубъекта, СубъектИд, Объект, Действия);
КонецФункции

// Контракт СервисаПравДоступа: выдача гранта.
//
// Параметры:
//  КтоВыдаёт - Структура.
//  ТипСубъекта - Строка.
//  СубъектИд - Число.
//  Объект - Структура.
//  Действия - Структура.
//
// Возвращаемое значение:
//  Структура - запись вызова.
//
Функция ВыдатьГрант(Знач КтоВыдаёт, Знач ТипСубъекта, Знач СубъектИд, Знач Объект, Знач Действия) Экспорт
	Возврат Запомнить("ВыдатьГрант", ТипСубъекта, СубъектИд, Объект, Действия);
КонецФункции

// Контракт СервисаПравДоступа: выдача роли.
//
// Параметры:
//  КтоВыдаёт - Структура.
//  ТипСубъекта - Строка.
//  СубъектИд - Число.
//  Объект - Структура.
//  Роль - Строка.
//
// Возвращаемое значение:
//  Структура - запись вызова.
//
Функция ВыдатьРоль(Знач КтоВыдаёт, Знач ТипСубъекта, Знач СубъектИд, Знач Объект, Знач Роль) Экспорт
	Возврат Запомнить("ВыдатьРоль", ТипСубъекта, СубъектИд, Объект, Роль);
КонецФункции

// Контракт СервисаПравДоступа: вправе ли выдавать права на объекте.
//
// Параметры:
//  КтоВыдаёт - Структура, Неопределено.
//  Объект - Структура.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетВыдаватьГрант(Знач КтоВыдаёт, Знач Объект) Экспорт
	Запомнить("МожетВыдаватьГрант", "", 0, Объект, Неопределено);
	Возврат КтоВыдаёт <> Неопределено И ВыдачаРазрешена;
КонецФункции

// Контракт СервисаПравДоступа: гранты субъекта.
//
// Параметры:
//  ТипСубъекта - Строка.
//  СубъектИд - Число.
//
// Возвращаемое значение:
//  Массив - пустой.
//
Функция ГрантыСубъекта(Знач ТипСубъекта, Знач СубъектИд) Экспорт
	Запомнить("ГрантыСубъекта", ТипСубъекта, СубъектИд, Неопределено, Неопределено);
	Возврат Новый Массив();
КонецФункции

// Контракт СервисаПравДоступа: роль записи гранта.
//
// Параметры:
//  Грант - Произвольный.
//
// Возвращаемое значение:
//  Строка - всегда «читатель».
//
Функция РольЗаписи(Знач Грант) Экспорт
	Возврат "читатель";
КонецФункции

// Контракт СервисаПравДоступа: отзыв гранта.
//
// Параметры:
//  КтоВыдаёт - Структура.
//  ТипСубъекта - Строка.
//  СубъектИд - Число.
//  Объект - Структура.
//
// Возвращаемое значение:
//  Булево - всегда Истина.
//
Функция ОтозватьГрант(Знач КтоВыдаёт, Знач ТипСубъекта, Знач СубъектИд, Знач Объект) Экспорт
	Запомнить("ОтозватьГрант", ТипСубъекта, СубъектИд, Объект, Неопределено);
	Возврат Истина;
КонецФункции

// Контракт СервисаПравДоступа: гранты на объект.
//
// Параметры:
//  Объект - Структура.
//
// Возвращаемое значение:
//  Массив - пустой.
//
Функция ГрантыНаОбъект(Знач Объект) Экспорт
	Запомнить("ГрантыНаОбъект", "", 0, Объект, Неопределено);
	Возврат Новый Массив();
КонецФункции

Функция Запомнить(Знач Метод, Знач ТипСубъекта, Знач СубъектИд, Знач Объект, Знач Значение)
	Вызов = Новый Структура("Метод, ТипСубъекта, СубъектИд, Объект, Значение",
		Метод, ТипСубъекта, СубъектИд, Объект, Значение);
	Вызовы.Добавить(Вызов);
	Возврат Вызов;
КонецФункции

Процедура ПриСозданииОбъекта()
	ВыдачаРазрешена = Ложь;
	Вызовы = Новый Массив();
КонецПроцедуры
