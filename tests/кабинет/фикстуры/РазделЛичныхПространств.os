// Раздел «Пулы» дома «Хаб» на живом стенде: формы раздела и окна предупреждения о сносе
// личных пространств, число в окне и следы пространств на стенде.

Перем Клиент;          // фикстура КлиентХаба стенда
Перем КореньХранилища; // корень файлового хранилища стенда

// Адрес раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция Адрес() Экспорт
	Возврат "/hub/settings/pools";
КонецФункции

// Страница с окном предупреждения: форма раздела отправлена с тумблером в «выключено».
//
// Параметры:
//  Кука - Строка - сессия администратора.
//
// Возвращаемое значение:
//  Строка - разметка страницы с окном.
//
Функция ОткрытьОкно(Знач Кука) Экспорт
	Возврат Клиент.Тело(Клиент.POSTФормы(Адрес(), ПоляСТумблером(Кука, Ложь), Кука));
КонецФункции

// Поля формы раздела так, как их отправит браузер, когда администратор поставил тумблер
// «Личные пространства» в нужное положение.
//
// Параметры:
//  Кука - Строка - сессия администратора.
//  Включено - Булево - положение тумблера при отправке.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> значение.
//
Функция ПоляСТумблером(Знач Кука, Знач Включено) Экспорт

	Тумблер = Новый Соответствие();
	Тумблер.Вставить(ИмяТумблера(), Включено);

	Раздел = Клиент.Тело(Клиент.GETСКукой(Адрес(), Кука));
	Возврат Клиент.ПоляФормыСо(Раздел, "name=""" + ИмяТумблера() + """", Тумблер);

КонецФункции

// Поля формы окна предупреждения так, как их отправит браузер; эхо числа вписывает тест.
//
// Параметры:
//  Окно - Строка - разметка страницы с окном.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> значение.
//
Функция ПоляОкна(Знач Окно) Экспорт
	Возврат Клиент.ПоляФормыСо(Окно, "name=""подтверждение""");
КонецФункции

// Число пространств, которое окно предупреждения просит повторить.
//
// Параметры:
//  Окно - Строка - разметка страницы с окном.
//
// Возвращаемое значение:
//  Строка - цифры числа; окна нет — исключение.
//
Функция ЧислоИзОкна(Знач Окно) Экспорт

	Маркер = "личных пространств — ";
	Поз = СтрНайти(Окно, Маркер);
	Если Поз = 0 Тогда
		ВызватьИсключение "В окне предупреждения нет числа удаляемых пространств";
	КонецЕсли;

	Остаток = Сред(Окно, Поз + СтрДлина(Маркер));
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;

	Возврат Цифры;

КонецФункции

// Включена ли настройка «Личные пространства» — так, как её показывает тумблер раздела.
//
// Параметры:
//  Кука - Строка - сессия администратора.
//
// Возвращаемое значение:
//  Булево.
//
Функция НастройкаВключена(Знач Кука) Экспорт
	Разметка = Клиент.Тело(Клиент.GETСКукой(Адрес(), Кука));
	Возврат СтрНайти(Разметка, "name=""" + ИмяТумблера() + """ value=""1"" checked") > 0;
КонецФункции

// Отвечает ли страница личного пространства учётки.
//
// Параметры:
//  Логин - Строка - логин хозяина.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЛичныйПулЕсть(Знач Логин) Экспорт
	Возврат Клиент.GET("/pools/" + Логин).КодСостояния = 200;
КонецФункции

// Лежит ли файл версии пакета в хранилище стенда.
//
// Параметры:
//  ИмяПула - Строка.
//  ИмяПакета - Строка.
//  Версия - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция АртефактЕсть(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт
	Путь = ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", ИмяПула), ИмяПакета,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Возврат Новый Файл(Путь).Существует();
КонецФункции

Функция ИмяТумблера()
	Возврат "oshub.pools.personal_enabled";
КонецФункции

Процедура ПриСозданииОбъекта(Знач КлиентСтенда, Знач КореньХранилищаСтенда)
	Клиент = КлиентСтенда;
	КореньХранилища = КореньХранилищаСтенда;
КонецПроцедуры
