// Юнит-тесты ПодсказкаПароля: список требований под полем ввода — что печатается словами,
// какие машинные коды несёт каждое требование и что бывает с требованием без кода.

#Использовать asserts
#Использовать oscript-ui
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КитЭлементов;  // Кит — фабрика элементов экрана
Перем Тексты;

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подключить() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Общее = ОбъединитьПути(Модули, "интерфейс", "Классы", "общее");

	ПоискКлассов.Подключить(Модули, "ПолитикаПароля");
	ПоискКлассов.Подключить(Общее, "СловарьТекстов");
	ПоискКлассов.Подключить(Общее, "ПодсказкаПароля");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ПолитикаЧужогоТребования");

	// подсказка собрана родами холста, компонентов кита не зовёт — набора и каркаса
	// этой фабрике здесь не нужно
	КитЭлементов = Новый Кит(Новый РазметкаЭлементов(Новый ЭкранированиеHTML()),
		Неопределено, Неопределено);
	Тексты = Новый ТекстыИнтерфейса(Новый СловарьТекстов());

КонецПроцедуры

// Список требований приезжает из политики: второй его копии в разметке нет, поэтому
// правка политики администратором меняет то, что читает человек, — сразу и целиком.
&Тест
Процедура СписокТребованийПриезжаетИзПолитикиАНеИзРазметки() Экспорт

	Настройки = Настройки(10, 32, Ложь, Ложь, Истина, Ложь);
	Подсказка = Новый ПодсказкаПароля(КитЭлементов, Тексты, Новый ПолитикаПароля(Настройки));

	Было = Подсказка.Требования("пароль").Рендер();
	Ожидаем.Что(СтрНайти(Было, "длина от 10 до 32 символов") > 0,
		"границы длины напечатаны словами: " + Было).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Было, "цифра") > 0, "включённое требование в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Было, "спецсимвол"), "выключенного в списке нет").Равно(0);

	Настройки.Задать("oshub.auth.password.min_length", 14);
	Настройки.Задать("oshub.auth.password.require_special", Истина);

	Стало = Подсказка.Требования("пароль").Рендер();
	Ожидаем.Что(СтрНайти(Стало, "длина от 14 до 32 символов") > 0,
		"новый минимум читается на той же странице: " + Стало).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стало, "спецсимвол") > 0, "и новое требование тоже").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стало, "длина от 10"), "прежнего минимума не осталось").Равно(0);

КонецПроцедуры

// Живая проверка судит по коду требования, а не по его тексту: код объявлен на строке
// списка, границы длины — числами там же.
&Тест
Процедура КаждоеТребованиеНесётСвойКодДляЖивойПроверки() Экспорт

	Подсказка = Новый ПодсказкаПароля(КитЭлементов, Тексты,
		Новый ПолитикаПароля(Настройки(12, 64, Истина, Ложь, Истина, Истина)));

	HTML = Подсказка.Требования("новый").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "data-pwreq=""новый""") > 0,
		"подсказка названа полем, за которым следит: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-pwrule=""length""") > 0, "код требования длины").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-pwmin=""12""") > 0, "минимум числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-pwmax=""64""") > 0, "максимум числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-pwrule=""lower""") > 0, "код строчной буквы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-pwrule=""digit""") > 0, "код цифры").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-pwrule=""special""") > 0, "код спецсимвола").ЭтоИстина();

	// выключенное требование не только не названо словами, но и не имеет строки:
	// иначе браузер помечал бы невыполненным то, чего политика не требует
	Ожидаем.Что(СтрНайти(HTML, "data-pwrule=""upper"""),
		"выключенного требования нет и в кодах").Равно(0);

КонецПроцедуры

// Без скрипта страница обязана оставаться осмысленной: текст каждого требования
// напечатан как текст, а не спрятан в атрибут.
&Тест
Процедура ТребованияЧитаютсяСловамиИБезСкрипта() Экспорт

	Политика = Новый ПолитикаПароля(Настройки(8, 20, Ложь, Истина, Истина, Ложь));
	HTML = Новый ПодсказкаПароля(КитЭлементов, Тексты, Политика).Требования("пароль").Рендер();

	Ожидаем.Что(Политика.Требования().Количество(), "требований в политике трое").Равно(3);
	Для Каждого Требование Из Политика.Требования() Цикл
		Ожидаем.Что(СтрНайти(HTML, ">" + Требование + "<") > 0,
			СтрШаблон("требование «%1» напечатано текстом, а не только атрибутом: %2",
				Требование, HTML)).ЭтоИстина();
	КонецЦикла;

	// заголовок списка приезжает из словаря: потерянный ключ виден маркером «[?…]»,
	// и человек прочитал бы его вместо подписи
	Ожидаем.Что(СтрНайти(HTML, "Требования к паролю") > 0, "список подписан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "[?"), "маркера потерянного ключа в подсказке нет").Равно(0);

КонецПроцедуры

// Требование, которого хаб судить не умеет, показывается человеку, но живой проверки
// не получает: помечать выполненным то, чего не проверял, нельзя.
&Тест
Процедура ТребованиеБезКодаПоказываетсяНоНеСудится() Экспорт

	Подсказка = Новый ПодсказкаПароля(КитЭлементов, Тексты, Новый ПолитикаЧужогоТребования());
	HTML = Подсказка.Требования("пароль").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "не из этого мира") > 0,
		"незнакомое требование напечатано словами: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-pwrule"), "но кода живой проверки у него нет").Равно(0);

КонецПроцедуры

// Поле без имени привязать не к чему: подсказка молчит, а не печатает список,
// который ни за чем не следит.
&Тест
Процедура БезИмениПоляПодсказкиНет() Экспорт

	Подсказка = Новый ПодсказкаПароля(КитЭлементов, Тексты,
		Новый ПолитикаПароля(Настройки(8, 256, Ложь, Ложь, Ложь, Ложь)));

	Ожидаем.Что(Подсказка.Требования("").Рендер(), "имени поля нет — разметки нет").Равно("");
	Ожидаем.Что(Подсказка.Требования("   ").Рендер(), "и пробелы именем не считаются").Равно("");

КонецПроцедуры

// Имя поля попадает в атрибут через экранирование: подсказку рисует сервер, но имя
// приходит из вызывающего кода, и дыры в разметке через него быть не должно.
&Тест
Процедура ИмяПоляЭкранируетсяВАтрибуте() Экспорт

	Подсказка = Новый ПодсказкаПароля(КитЭлементов, Тексты,
		Новый ПолитикаПароля(Настройки(8, 256, Ложь, Ложь, Ложь, Ложь)));

	HTML = Подсказка.Требования("зло"" onmouseover=""alert(1).Рендер()");

	Ожидаем.Что(СтрНайти(HTML, "onmouseover=""alert"), "кавычка не вырвалась из атрибута").Равно(0);

КонецПроцедуры

#Область Служебное

Функция Настройки(Знач МинДлина, Знач МаксДлина, Знач Строчная, Знач Прописная, Знач Цифра,
	Знач Спец)

	Результат = Новый НастройкиЗаглушка();
	Результат.Задать("oshub.auth.password.min_length", МинДлина);
	Результат.Задать("oshub.auth.password.max_length", МаксДлина);
	Результат.Задать("oshub.auth.password.require_lowercase", Строчная);
	Результат.Задать("oshub.auth.password.require_uppercase", Прописная);
	Результат.Задать("oshub.auth.password.require_digit", Цифра);
	Результат.Задать("oshub.auth.password.require_special", Спец);
	Возврат Результат;

КонецФункции

#КонецОбласти
