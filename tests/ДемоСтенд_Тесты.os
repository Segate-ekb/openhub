// Демо-стенд: сторож «наполнение ходит только по HTTP» (скан tools/демо) и смоук
// разворачивания tools/demo.os --no-run в песочнице с проверкой полученных данных.

#Использовать asserts
#Использовать json
#Использовать "фикстуры"

Перем КаталогПроекта;
Перем КаталогНаполнителя;
Перем Сценарий;

Перем КореньСтенда;
Перем ВыдачаПортов;
Перем НомерПорта;
Перем ВыводРазворачивания;
Перем КодВозврата;

// Единственная библиотека, которую наполнителю можно подключать: сборка .ospx — работа
// автора пакета, она и на клиенте выполняется этой же библиотекой.
Перем РазрешённыеБиблиотеки;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогНаполнителя = ОбъединитьПути(КаталогПроекта, "tools", "демо");
	РазрешённыеБиблиотеки = СтрРазделить("ospx-tools", ",");

КонецПроцедуры

&ПередВсеми
Процедура РазвернутьСтенд() Экспорт

	ПодключитьСценарий(ОбъединитьПути(КаталогНаполнителя, "СценарийСтенда.os"), "СценарийСтенда");
	Сценарий = Новый СценарийСтенда();

	РеестрФикстур.Подключить("ВыдачаПортов");
	ВыдачаПортов = Новый ВыдачаПортов();
	НомерПорта = ВыдачаПортов.Выдать();

	КореньСтенда = ОбъединитьПути(КаталогВременныхФайлов(),
		"openhub-демо-тест-" + Строка(Новый УникальныйИдентификатор));

	УстановитьПеременнуюСреды("OSHUB_DEMO_ROOT", КореньСтенда);

	Команда = СтрШаблон("oscript ""%1"" --no-run --port %2",
		ОбъединитьПути(КаталогПроекта, "tools", "demo.os"),
		Формат(НомерПорта, "ЧГ=0; ЧН=0"));

	Процесс = СоздатьПроцесс(Команда, КаталогПроекта, Истина);
	Процесс.Запустить();

	ВыводРазворачивания = ВычитатьПотокиДоЗавершения(Процесс);

	Процесс.ОжидатьЗавершения();
	КодВозврата = Процесс.КодВозврата;

КонецПроцедуры

&ПослеВсех
Процедура УбратьСтенд() Экспорт

	УстановитьПеременнуюСреды("OSHUB_DEMO_ROOT", "");

	Если ВыдачаПортов <> Неопределено Тогда
		ВыдачаПортов.ВернутьВсе();
	КонецЕсли;

	Если ЗначениеЗаполнено(КореньСтенда) И Новый Файл(КореньСтенда).Существует() Тогда
		УдалитьФайлы(КореньСтенда);
	КонецЕсли;

КонецПроцедуры

#Область СторожПользовательскихМеханик

&Тест
Процедура НаполнительПодключаетТолькоРазрешённыеБиблиотеки() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыНаполнителя() Цикл
		Для Каждого Библиотека Из ПодключённыеБиблиотеки(ПрочитатьФайл(Файл.ПолноеИмя)) Цикл
			Если РазрешённыеБиблиотеки.Найти(Библиотека) = Неопределено Тогда
				Нарушители.Добавить(Файл.Имя + ": " + Библиотека);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"tools/демо подключает библиотеки рантайма хаба: наполнение обязано ходить"
		+ " по HTTP, а не собирать у себя контейнер").Равно("");

КонецПроцедуры

&Тест
Процедура НаполнительНеСобираетКонтейнерОСени() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыНаполнителя() Цикл
		Текст = ПрочитатьФайл(Файл.ПолноеИмя);
		Для Каждого Маркер Из МаркерыКонтейнера() Цикл
			Если СтрНайти(Текст, Маркер) > 0 Тогда
				Нарушители.Добавить(Файл.Имя + ": " + Маркер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"tools/демо собирает контейнер ОСени: стенд наполняется поднятым хабом,"
		+ " а не сервисами в своём процессе").Равно("");

КонецПроцедуры

&Тест
Процедура НаполнительНеПодключаетКлассыИсходников() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыНаполнителя() Цикл
		Для Каждого Строчка Из СтрокиФайла(ПрочитатьФайл(Файл.ПолноеИмя)) Цикл
			Если СтрНайти(Строчка, "ПодключитьСценарий") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(Строчка, """src""") > 0 ИЛИ СтрНайти(Строчка, """модули""") > 0
				ИЛИ СтрНайти(Строчка, """Классы""") > 0 Тогда
				Нарушители.Добавить(Файл.Имя + ": " + СокрЛП(Строчка));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"tools/демо подключает классы src/модули: наполнителю доступен только HTTP").Равно("");

КонецПроцедуры

&Тест
Процедура НаполнительНеУпоминаетСлужебныеКлассыХаба() Экспорт

	Двери = ДвериХаба();

	Ожидаем.Что(Двери.Количество() > 50,
		"скан ослеп: служебных классов хаба найдено " + Двери.Количество()
		+ ", а их в src/модули/**/Классы/ больше сотни").ЭтоИстина();

	Нарушители = Новый Массив();
	Для Каждого Файл Из ФайлыНаполнителя() Цикл
		Текст = ПрочитатьФайл(Файл.ПолноеИмя);
		Для Каждого Имя Из Двери Цикл
			Если СтрНайти(Текст, Имя) > 0 Тогда
				Нарушители.Добавить(Файл.Имя + ": " + Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"tools/демо называет служебные классы хаба (Сервис*, Хранилище*, Служба*, Гвард*,"
		+ " Гейт*, Издатель*, Резолвер*, Контроллер*): прямого обращения к ним быть не может")
		.Равно("");

КонецПроцедуры

&Тест
Процедура СкриптСтендаНеНесётСекретовИПровайдеровВхода() Экспорт

	Настройки = НастройкиСкриптаСтенда(
		ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "tools", "demo.os")));

	Ожидаем.Что(СтрСоединить(СекретныеНастройки(Настройки), ", "),
		"tools/demo.os задаёт секреты: скрипт лежит в репозитории, и всё, что он"
		+ " экспортирует, публикуется вместе с ним").Равно("");

	Ожидаем.Что(СтрСоединить(НастройкиПровайдеровВхода(Настройки), ", "),
		"tools/demo.os настраивает внешнего провайдера входа: демо поднимается на localhost,"
		+ " и живой IdP ему не нужен — вход показывается паролем").Равно("");

КонецПроцедуры

&Тест
Процедура СкриптСтендаЖдётГотовностиПоReady() Экспорт

	Текст = ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "tools", "demo.os"));

	Ожидаем.Что(СтрНайти(Текст, """/ready""") > 0,
		"tools/demo.os опрашивает /ready на порту стенда").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Текст, """/health"""),
		"готовность проверяется /ready, а не /health: последний отвечает 200"
		+ " и на недособранном хабе, и наполнение ушло бы в недостроенный хаб").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СамотестыДетекторов

&Тест
Процедура ДетекторБиблиотекВидитПодключение() Экспорт

	// образец берёт entity, а не autumn-data: строковый литерал с директивой связки
	// «autumn-data ⇒ entity» другой скан-набор читает как настоящее подключение
	Найденные = ПодключённыеБиблиотеки("// шапка" + Символы.ПС + "#Использовать entity" + Символы.ПС);
	Ожидаем.Что(СтрСоединить(Найденные, ","), "детектор видит #Использовать").Равно("entity");

	Ожидаем.Что(ПодключённыеБиблиотеки("// про #Использовать pwhash в комментарии").Количество(),
		"упоминание в комментарии подключением не считается").Равно(0);

КонецПроцедуры

&Тест
Процедура ДетекторКонтейнераВидитСборку() Экспорт

	Найдено = Ложь;
	Для Каждого Маркер Из МаркерыКонтейнера() Цикл
		Найдено = Найдено ИЛИ СтрНайти("Поделка = Новый Поделка(Совет);", Маркер) > 0;
	КонецЦикла;

	Ожидаем.Что(Найдено, "детектор видит сборку поделки").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторНастроекЧитаетExportАНеКомментарий() Экспорт

	Образец = "// Настройка(""OSHUB_OIDC_AUTHENTIK_CLIENT_SECRET"", ""было-когда-то"");" + Символы.ПС
		+ "// про SECRET в комментарии" + Символы.ПС
		+ "	Настройка(""OSHUB_PORT"", Формат(НомерПорта)); // порт стенда" + Символы.ПС;

	Настройки = НастройкиСкриптаСтенда(Образец);

	Ожидаем.Что(СтрСоединить(Настройки, ","),
		"детектор видит вызов и не видит закомментированное").Равно("OSHUB_PORT");

	Ожидаем.Что(СекретныеНастройки(Настройки).Количество(),
		"закомментированный секрет секретом не считается").Равно(0);

	СНастоящим = НастройкиСкриптаСтенда(Образец
		+ "	Настройка(""OSHUB_OIDC_ACME_CLIENT_SECRET"", ""живой"");" + Символы.ПС);

	Ожидаем.Что(СтрСоединить(СекретныеНастройки(СНастоящим), ","),
		"настоящий секрет детектор находит").Равно("OSHUB_OIDC_ACME_CLIENT_SECRET");
	Ожидаем.Что(СтрСоединить(НастройкиПровайдеровВхода(СНастоящим), ","),
		"настройку провайдера входа детектор находит").Равно("OSHUB_OIDC_ACME_CLIENT_SECRET");

КонецПроцедуры

&Тест
Процедура ДетекторДверейБерётИменаИзИсходников() Экспорт

	Двери = ДвериХаба();

	Ожидаем.Что(Двери.Найти("СервисПубликации") <> Неопределено,
		"в списке дверей есть СервисПубликации").ЭтоИстина();
	Ожидаем.Что(Двери.Найти("ХранилищеАртефактов") <> Неопределено,
		"в списке дверей есть ХранилищеАртефактов").ЭтоИстина();
	Ожидаем.Что(Двери.Найти("ХранилищеСекретов"),
		"класс демо-пакета дверью хаба не считается").ЭтоНеопределено();

КонецПроцедуры

#КонецОбласти

#Область СмоукСтенда

&Тест
Процедура СтендРазворачиваетсяУспешно() Экспорт

	Ожидаем.Что(КодВозврата, "код возврата tools/demo.os --no-run; вывод: " + ВыводРазворачивания)
		.Равно(0);
	Ожидаем.Что(Найти(ВыводРазворачивания, "DEMO-BUILD-OK") > 0, "маркер сборки пакетов").ЭтоИстина();
	Ожидаем.Что(Найти(ВыводРазворачивания, "DEMO-OK") > 0, "маркер наполнения").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НаполнявшийХабНеОставилОшибокВЖурнале() Экспорт

	Журнал = ПрочитатьФайл(ОбъединитьПути(КореньСтенда, "хаб-наполнение.log"));

	Ошибки = Новый Массив();
	Для Каждого Строчка Из СтрокиФайла(Журнал) Цикл
		Если Найти(Строчка, "ОШИБКА") > 0 ИЛИ Найти(Строчка, "Не удалось инициализировать") > 0 Тогда
			Ошибки.Добавить(СокрЛП(Строчка));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Ошибки, " | "),
		"строки ОШИБКА в журнале наполнявшего хаба").Равно("");

	Ожидаем.Что(Найти(Журнал, "ИНФОРМАЦИЯ") > 0,
		"детектор видит обычные строки лога (проверка не вечнозелёная)").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтендСодержитПулыСюжета() Экспорт

	ИменаИТипы = Новый Соответствие();
	Видимости = Новый Соответствие();
	Публикации = Новый Соответствие();
	Для Каждого Пул Из ПрочитатьТаблицу("Пулы") Цикл
		ИменаИТипы.Вставить(Пул["Имя"], Пул["Тип"]);
		Видимости.Вставить(Пул["Имя"], Пул["Видимость"]);
		Публикации.Вставить(Пул["Имя"], Пул["ПубликацияРазрешена"] = Истина);
	КонецЦикла;

	Для Каждого Пул Из Сценарий.Пулы() Цикл
		Ожидаем.Что(ИменаИТипы.Получить(Пул.Имя), "тип пула " + Пул.Имя).Равно(Пул.Тип);
		Ожидаем.Что(Видимости.Получить(Пул.Имя), "видимость пула " + Пул.Имя).Равно(Пул.Видимость);
		Ожидаем.Что(Публикации.Получить(Пул.Имя), "публикация в пуле " + Пул.Имя)
			.Равно(Пул.ПубликацияРазрешена);
	КонецЦикла;

	Ожидаем.Что(ИменаИТипы.Получить("upstream"),
		"отдельного пула upstream больше нет: апстрим переехал на дефолтный пул").ЭтоНеопределено();

	// личные пространства заводит сама регистрация — их никто отдельно не создавал
	Ожидаем.Что(ИменаИТипы.Получить("alice"), "личный пул alice").Равно("user");
	Ожидаем.Что(ИменаИТипы.Получить("bob"), "личный пул bob").Равно("user");

КонецПроцедуры

&Тест
Процедура ДефолтныйПулСтендаЗеркалитАпстрим() Экспорт

	Дефолтный = Сценарий.ДефолтныйПул();

	Ожидаем.Что(Найти(ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "tools", "demo.os")),
		"""OSHUB_DEFAULT_POOL"", """ + Дефолтный + """") > 0,
		"tools/demo.os назначает дефолтным пулом " + Дефолтный
		+ ": сценарий и скрипт разъехались бы молча").ЭтоИстина();

	// в кэше зеркала может лежать что угодно из апстрима, но собственного пакета
	// стенда там быть не может: публикация в дефолтный пул запрещена
	СвоиИмена = Новый Соответствие();
	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		СвоиИмена.Вставить(НРег(Пакет.Имя), Истина);
	КонецЦикла;

	СвоиВЗеркале = Новый Массив();
	Для Каждого Пакет Из ПакетыПула(Дефолтный) Цикл
		Если СвоиИмена.Получить(НРег(Строка(Пакет["Имя"]))) <> Неопределено Тогда
			СвоиВЗеркале.Добавить(Строка(Пакет["Имя"]));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(СвоиВЗеркале, ", "),
		"собственные пакеты стенда в дефолтном пуле: они переехали в пул "
		+ Сценарий.ПулОрганизации()).Равно("");

КонецПроцедуры

&Тест
Процедура СтендЗаполненПакетамиИВерсиями() Экспорт

	Пакеты = СвоиПакеты();
	СписокВерсий = ВерсииПакетов(Пакеты);

	Ожидаем.Что(Пакеты.Количество(), "пакетов на стенде").Равно(Сценарий.Пакеты().Количество());
	Ожидаем.Что(СписокВерсий.Количество(), "версий на стенде").Равно(ВерсийВСценарии());

	Отозванные = 0;
	Пререлизы = 0;
	Для Каждого Версия Из СписокВерсий Цикл
		Если Версия["Отозвана"] = Истина Тогда
			Отозванные = Отозванные + 1;
		КонецЕсли;
		Если ЗначениеЗаполнено(Версия["SemverПререлиз"]) Тогда
			Пререлизы = Пререлизы + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отозванные, "отозванных версий").Равно(Сценарий.ОтозванныеВерсии().Количество());
	Ожидаем.Что(Пререлизы, "пререлизных версий").Больше(0);

	Устаревшие = 0;
	Для Каждого Пакет Из Пакеты Цикл
		Ожидаем.Что(ЗначениеЗаполнено(Пакет["Описание"]), "описание пакета " + Пакет["Имя"]
			+ " приехало из манифеста").ЭтоИстина();
		Ожидаем.Что(Пакет["Лицензия"], "лицензия пакета " + Пакет["Имя"]
			+ " проставлена формой карточки").Равно("MIT");
		Если Пакет["Устарел"] = Истина Тогда
			Устаревшие = Устаревшие + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Устаревшие, "устаревших пакетов").Больше(0);

КонецПроцедуры

&Тест
Процедура АртефактыВерсийЛежатВХранилище() Экспорт

	Артефакты = Новый Массив();
	Для Каждого ИмяПула Из ИменаСвоихПулов() Цикл
		Каталог = ОбъединитьПути(КореньСтенда, "data", "pools", ИмяПула);
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Артефакт Из НайтиФайлы(Каталог, "*.ospx", Истина) Цикл
			Артефакты.Добавить(Артефакт);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Артефакты.Количество(), "артефактов .ospx в хранилище").Равно(ВерсийВСценарии());

	Для Каждого Артефакт Из Артефакты Цикл
		Ожидаем.Что(Артефакт.Размер() > 0, "размер " + Артефакт.Имя).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СтатистикаСкачиванийНабранаНастоящимиЗапросами() Экспорт

	Свои = Новый Соответствие();
	Для Каждого Пакет Из СвоиПакеты() Цикл
		Свои.Вставить(Строка(Пакет["Идентификатор"]), Истина);
	КонецЦикла;

	// Точное совпадение держится сквозной записью: с буферным дефолтом скачивания копятся
	// в памяти, и всё несброшенное наполнявший хаб уносит с собой при остановке.
	Ожидаем.Что(Найти(ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "tools", "demo.os")),
		"""OSHUB_STATS_FLUSH__THRESHOLD"", ""1""") > 0,
		"tools/demo.os поднимает стенд со сквозной записью статистики: без неё счёт зависел бы"
		+ " от того, успел ли сброс до остановки хаба").ЭтоИстина();

	Агрегаты = ПрочитатьТаблицу("СкачиванияАгрегаты");
	Ожидаем.Что(Агрегаты.Количество(), "строк суточных агрегатов").Больше(0);

	Всего = 0;
	Сутки = Новый Соответствие();
	Для Каждого Агрегат Из Агрегаты Цикл
		Если Свои.Получить(Строка(Агрегат["ПакетИдентификатор"])) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + Число(Агрегат["Количество"]);
		Сутки.Вставить(Строка(Агрегат["ДатаДень"]), Истина);
	КонецЦикла;

	Ожидаем.Что(Всего, "скачиваний в базе — ровно столько, сколько запросов сделал стенд")
		.Равно(СкачиванийВСценарии());

	// дат в прошлом стенд не рисует: всё, что он набрал, набрано днём запуска
	Ожидаем.Что(Сутки.Количество(), "суток в агрегатах скачиваний").Равно(1);

КонецПроцедуры

&Тест
Процедура ТегиСтендаОбоихРежимов() Экспорт

	Свои = Новый Соответствие();
	Для Каждого Пакет Из СвоиПакеты() Цикл
		Свои.Вставить(Строка(Пакет["Идентификатор"]), Истина);
	КонецЦикла;

	Теги = Новый Массив();
	Для Каждого Тег Из ПрочитатьТаблицу("Теги") Цикл
		Если Свои.Получить(Строка(Тег["ПакетИдентификатор"])) <> Неопределено Тогда
			Теги.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Теги.Количество(), "тегов").Больше(0);

	Режимы = Новый Соответствие();
	Умолчаний = 0;
	Для Каждого Тег Из Теги Цикл
		Режимы.Вставить(Строка(Тег["Режим"]), Истина);
		Если Тег["ПоУмолчанию"] = Истина Тогда
			Умолчаний = Умолчаний + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Режимы.Получить("правило") = Истина, "на стенде есть тег-правило").ЭтоИстина();
	Ожидаем.Что(Режимы.Получить("ручной") = Истина, "на стенде есть ручной тег").ЭтоИстина();
	Ожидаем.Что(Режимы.Получить("пин"), "упразднённого режима на стенде нет").ЭтоНеопределено();

	// базовые теги заводит сама публикация, и stable у каждого пакета — тег по умолчанию
	Ожидаем.Что(Умолчаний, "тегов по умолчанию").Равно(Сценарий.Пакеты().Количество());

	Ожидаем.Что(ПрочитатьТаблицу("МеткиВерсий").Количество(),
		"меток версий (заголовок CHANNEL при публикации)").Больше(0);

КонецПроцедуры

&Тест
Процедура ПраваРозданыГрантами() Экспорт

	Ожидаем.Что(ПрочитатьТаблицу("ПраваДоступа").Количество(), "грантов прав доступа").Больше(0);

	// пресеты УчастникиПулов пишутся только в обход API — записи там означают, что
	// стенд лазил мимо пользовательских механик
	Ожидаем.Что(ПрочитатьТаблицу("УчастникиПулов").Количество(),
		"записей пресетов ролей на пулах: их HTTP-путём не создать").Равно(0);

	Ожидаем.Что(ПрочитатьТаблицу("Группы").Количество(), "групп")
		.Равно(Сценарий.Группы().Количество());
	Ожидаем.Что(ПрочитатьТаблицу("УчастникиГрупп").Количество(), "членств в группах")
		.Равно(УчастниковВСценарии());

	Ожидаем.Что(ПрочитатьТаблицу("СопоставленияГруппOIDC").Количество(),
		"сопоставлений групп OIDC: стенд внешнего провайдера не настраивает,"
		+ " роли на его пулах раздаются грантами").Равно(0);

	Пользователи = ПрочитатьТаблицу("Пользователи");
	Ожидаем.Что(Пользователи.Количество(), "пользователей")
		.Равно(Сценарий.Люди().Количество() + 1);

	Админы = 0;
	Для Каждого Пользователь Из Пользователи Цикл
		Если Пользователь["РольХаба"] = "admin" Тогда
			Админы = Админы + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Админы, "администраторов: первого создаёт мастер /setup").Равно(1);

КонецПроцедуры

&Тест
Процедура ПамяткаОписываетУчёткиИОграничения() Экспорт

	ПутьПамятки = ОбъединитьПути(КореньСтенда, "ДЕМО.md");
	Ожидаем.Что(Новый Файл(ПутьПамятки).Существует(), "файл ДЕМО.md").ЭтоИстина();

	Текст = ПрочитатьФайл(ПутьПамятки);

	Ожидаемые = СтрРазделить("root,alice,oshub_,/hub/settings", ",");
	Ожидаемые.Добавить("/" + Сценарий.ПулОрганизации() + "/veles-core");
	Для Каждого Ожидаемое Из Ожидаемые Цикл
		Ожидаем.Что(Найти(Текст, Ожидаемое) > 0, "памятка упоминает " + Ожидаемое).ЭтоИстина();
	КонецЦикла;

	// то, чего на стенде нет, обязано быть названо: иначе памятка врёт умолчанием
	Ожидаем.Что(Найти(Текст, "датировано днём запуска") > 0,
		"памятка честно говорит про даты").ЭтоИстина();
	Ожидаем.Что(Найти(Текст, "кэш дефолтного пула") > 0,
		"памятка честно говорит про состояние кэша зеркала").ЭтоИстина();
	Ожидаем.Что(Найти(Текст, Сценарий.АдресАпстрима()) > 0,
		"памятка называет адрес апстрима с путём выдачи").ЭтоИстина();

	// оба адреса: коротким ставят из зеркала, адресом пула ставят и публикуют своё
	Ожидаем.Что(Найти(Текст, "## Установка и публикация") > 0,
		"памятка описывает установку и публикацию").ЭтоИстина();
	Ожидаем.Что(Найти(Текст, """ПутьНаСервере"": ""/download/""") > 0,
		"памятка показывает короткий адрес зеркала").ЭтоИстина();
	Ожидаем.Что(Найти(Текст,
		СтрШаблон("""РесурсПубликацииПакетов"": ""/api/v1/pools/%1/push""",
			Сценарий.ПулОрганизации())) > 0,
		"памятка показывает адрес публикации в пул организации").ЭтоИстина();
	Ожидаем.Что(Найти(Текст, "409") > 0,
		"памятка называет код отказа короткой публикации").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Детекторы

// Библиотеки, подключённые директивой #Использовать (только в начале строки).
Функция ПодключённыеБиблиотеки(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строчка Из СтрокиФайла(Текст) Цикл
		Обрезанная = СокрЛП(Строчка);
		Если НЕ СтрНачинаетсяС(Обрезанная, "#Использовать") Тогда
			Продолжить;
		КонецЕсли;
		Имя = СокрЛП(Сред(Обрезанная, СтрДлина("#Использовать") + 1));
		Если ЗначениеЗаполнено(Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МаркерыКонтейнера()
	Возврат СтрРазделить("Новый Поделка,СоветДругогоМастера,НайтиЖелудь,ЗапуститьПриложение,"
		+ "ПолучитьОпределенияЖелудей,ЗначенияДеталек", ",");
КонецФункции

// Имена классов-дверей хаба: их наполнителю не полагается даже называть.
Функция ДвериХаба()

	Префиксы = СтрРазделить("Сервис,Хранилище,Служба,Гвард,Гейт,Издатель,Резолвер,Контроллер", ",");
	Результат = Новый Массив();

	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src", "модули"), "*.os", Истина) Цикл
		Если СтрНайти(Файл.Путь, "Классы") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Префикс Из Префиксы Цикл
			Если СтрНачинаетсяС(Файл.ИмяБезРасширения, Префикс)
				И Результат.Найти(Файл.ИмяБезРасширения) = Неопределено Тогда
				Результат.Добавить(Файл.ИмяБезРасширения);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ФайлыНаполнителя()
	Возврат НайтиФайлы(КаталогНаполнителя, "*.os", Истина);
КонецФункции

// Имена деталек, которые скрипт стенда задаёт окружением: читаются только вызовы
// Настройка("ИМЯ", …) и НастройкаПоУмолчанию("ИМЯ", …) в коде, поэтому упоминание
// в комментарии настройкой не считается.
Функция НастройкиСкриптаСтенда(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строчка Из СтрокиФайла(Текст) Цикл

		Код = СокрЛП(БезКомментария(Строчка));

		Для Каждого Вызов Из СтрРазделить("Настройка(""|НастройкаПоУмолчанию(""", "|") Цикл
			Начало = СтрНайти(Код, Вызов);
			Если Начало = 0 Тогда
				Продолжить;
			КонецЕсли;
			Остаток = Сред(Код, Начало + СтрДлина(Вызов));
			Конец = СтрНайти(Остаток, """");
			Если Конец > 1 Тогда
				Имя = Лев(Остаток, Конец - 1);
				Если Результат.Найти(Имя) = Неопределено Тогда
					Результат.Добавить(Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строка без хвостового комментария OneScript.
Функция БезКомментария(Знач Строчка)

	Начало = СтрНайти(Строчка, "//");

	Возврат ?(Начало = 0, Строчка, Лев(Строчка, Начало - 1));

КонецФункции

Функция СекретныеНастройки(Знач Настройки)

	Результат = Новый Массив();

	Для Каждого Имя Из Настройки Цикл
		Если СтрНайти(ВРег(Имя), "SECRET") > 0 ИЛИ СтрНайти(ВРег(Имя), "PASSWORD") > 0
			ИЛИ СтрНайти(ВРег(Имя), "TOKEN") > 0 Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НастройкиПровайдеровВхода(Знач Настройки)

	Результат = Новый Массив();

	Для Каждого Имя Из Настройки Цикл
		Если СтрНачинаетсяС(ВРег(Имя), "OSHUB_OIDC") Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебное

// Пулы, в которые стенд сам публиковал: кэш зеркала в счёт собственных данных не идёт.
Функция ИменаСвоихПулов()

	Результат = Новый Массив();
	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Если Результат.Найти(Пакет.Пул) = Неопределено Тогда
			Результат.Добавить(Пакет.Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИдентификаторыПулов(Знач Имена)

	Искомые = Новый Соответствие();
	Для Каждого Имя Из Имена Цикл
		Искомые.Вставить(НРег(Имя), Истина);
	КонецЦикла;

	Результат = Новый Соответствие();
	Для Каждого Пул Из ПрочитатьТаблицу("Пулы") Цикл
		Если Искомые.Получить(НРег(Строка(Пул["Имя"]))) <> Неопределено Тогда
			Результат.Вставить(Строка(Пул["Идентификатор"]), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПакетыПулов(Знач Имена)

	Идентификаторы = ИдентификаторыПулов(Имена);

	Результат = Новый Массив();
	Для Каждого Пакет Из ПрочитатьТаблицу("Пакеты") Цикл
		Если Идентификаторы.Получить(Строка(Пакет["ПулИдентификатор"])) <> Неопределено Тогда
			Результат.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПакетыПула(Знач ИмяПула)
	Имена = Новый Массив();
	Имена.Добавить(ИмяПула);
	Возврат ПакетыПулов(Имена);
КонецФункции

Функция СвоиПакеты()
	Возврат ПакетыПулов(ИменаСвоихПулов());
КонецФункции

Функция ВерсииПакетов(Знач Пакеты)

	Идентификаторы = Новый Соответствие();
	Для Каждого Пакет Из Пакеты Цикл
		Идентификаторы.Вставить(Строка(Пакет["Идентификатор"]), Истина);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Версия Из ПрочитатьТаблицу("ВерсииПакетов") Цикл
		Если Идентификаторы.Получить(Строка(Версия["ПакетИдентификатор"])) <> Неопределено Тогда
			Результат.Добавить(Версия);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВерсийВСценарии()
	Всего = 0;
	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Всего = Всего + Пакет.Версии.Количество();
	КонецЦикла;
	Возврат Всего;
КонецФункции

Функция СкачиванийВСценарии()
	Всего = 0;
	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Для Каждого Версия Из Пакет.Версии Цикл
			Всего = Всего + Версия.Скачиваний;
		КонецЦикла;
	КонецЦикла;
	Возврат Всего;
КонецФункции

Функция УчастниковВСценарии()
	Всего = 0;
	Для Каждого Группа Из Сценарий.Группы() Цикл
		Всего = Всего + Группа.Участники.Количество();
	КонецЦикла;
	Возврат Всего;
КонецФункции

Функция СтрокиФайла(Знач Текст)
	Возврат СтрРазделить(СтрЗаменить(Строка(Текст), Символы.ВК, ""), Символы.ПС, Ложь);
КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Если НЕ Новый Файл(Путь).Существует() Тогда
		Возврат "";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция ПрочитатьТаблицу(Знач ИмяТаблицы)

	Текст = ПрочитатьФайл(ОбъединитьПути(КореньСтенда, "data", "entities", ИмяТаблицы + ".json"));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Массив();
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Записи = Новый Массив();
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Записи = Данные;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Данные Цикл
			Записи.Добавить(Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Записи;

КонецФункции

Функция ВычитатьПотокиДоЗавершения(Знач Процесс)

	Куски = Новый Массив();

	Пока НЕ Процесс.Завершен Цикл
		Если НЕ ДочитатьКусок(Куски, Процесс) Тогда
			Приостановить(200); // процесс молчит — не жжём CPU холостым опросом
		КонецЕсли;
	КонецЦикла;

	Пока ДочитатьКусок(Куски, Процесс) Цикл
	КонецЦикла;

	Возврат СтрСоединить(Куски, Символы.ПС);

КонецФункции

Функция ДочитатьКусок(Куски, Знач Процесс)

	Прочитано = Ложь;

	Потоки = Новый Массив();
	Потоки.Добавить(Процесс.ПотокВывода);
	Потоки.Добавить(Процесс.ПотокОшибок);

	Для Каждого Поток Из Потоки Цикл
		Кусок = Поток.Прочитать();
		Если Кусок <> Неопределено И ЗначениеЗаполнено(Строка(Кусок)) Тогда
			Куски.Добавить(Строка(Кусок));
			Прочитано = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Прочитано;

КонецФункции

#КонецОбласти
