// Юнит-тесты подсказки установки: адресная форма команды (узел, пул, имя), источник узла
// (настройка «URL инстанса» либо заголовок Host), описание сервера для opm.cfg, карточка
// со вторым способом установки и то, где прописка клиенту не нужна вовсе — при установке
// и при публикации.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;               // Структура компонентов (фикстура СборкаUI)
Перем Поиск;            // КлассыСлоя
Перем Настройки;        // НастройкиЗаглушка
Перем Команды;          // КомандыOpm
Перем Подсказка;        // ПодсказкаУстановки
Перем Сниппеты;         // СниппетыКонвейеров
Перем Дефолтный;        // ПулЗаглушка — дефолтный пул хаба
Перем Обычный;          // ПулЗаглушка — обычный публичный пул
Перем Приватный;        // ПулЗаглушка — приватный пул
Перем ОсновнойПриватный; // ПулЗаглушка — приватный основной пул
Перем Личный;           // ПулЗаглушка — личный пул пользователя
Перем Окружение;        // ЗамерОкруженияЛендинга — всё, что главной не нужно из базы
Перем ОкружениеПути;    // ОкружениеПроводника — всё, что проводнику не нужно из базы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьПодсказку() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогКлассов = ОбъединитьПути(Модули, "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();

	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ЗамерОкруженияЛендинга");
	РеестрФикстур.Подключить("ОкружениеПроводника");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ОтветыНастроекЗаглушка");
	Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "АдресИнстанса");
	Поиск.Подключить(КаталогКлассов, "КомандыOpm");
	Поиск.Подключить(КаталогКлассов, "ПодсказкаУстановки");
	Поиск.Подключить(КаталогКлассов, "КонтроллерЛендинга");
	Поиск.Подключить(КаталогКлассов, "ПутьПервойПубликации");
	Поиск.Подключить(КаталогКлассов, "ВитринаПервойПубликации");
	Поиск.Подключить(КаталогКлассов, "КонтроллерПроводника");
	Поиск.Подключить(КаталогКлассов, "СниппетыКонвейеров");
	Поиск.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "ВидРефаДоверия");

	UI = Новый СборкаUI().Собрать(КаталогКлассов);

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.instance.url", "");
	Настройки.Задать("oshub.instance.opm_default_hub", Ложь);

	Команды = Новый КомандыOpm(Новый АдресИнстанса(Настройки), Новый ЗаголовкиHTTP(),
		Неопределено, Неопределено, Настройки);
	Подсказка = Новый ПодсказкаУстановки(Команды, UI.Тексты, UI.Кит);
	Сниппеты = Новый СниппетыКонвейеров(Команды, Новый ВидРефаДоверия());

	Дефолтный = Новый ПулЗаглушка(1, "public", "default");
	Обычный = Новый ПулЗаглушка(2, "contrib", "custom");
	Приватный = Новый ПулЗаглушка(3, "team", "custom", 0, Истина, "private");
	ОсновнойПриватный = Новый ПулЗаглушка(4, "inhouse", "default", 0, Истина, "private");
	Личный = Новый ПулЗаглушка(5, "alice", "user");

	Окружение = Новый ЗамерОкруженияЛендинга();
	ОкружениеПути = Новый ОкружениеПроводника();

КонецПроцедуры

&ПередКаждым
Процедура СброситьНастройку() Экспорт
	Настройки.Задать("oshub.instance.url", "");
	Настройки.Задать("oshub.instance.opm_default_hub", Ложь);
	Окружение.НазначитьОсновнойПул(Дефолтный);
КонецПроцедуры

#Область ФормаКоманды

// Пакет дефолтного пула ставится и без адреса: короткая форма верна и читается лучше.
&Тест
Процедура ПакетДефолтногоПулаДаётКороткуюФорму() Экспорт

	Ожидаем.Что(Команды.Установка(Дефолтный, "md-view", Узел()))
		.Равно("opm install md-view");
	Ожидаем.Что(Команды.КороткаяФорма(Дефолтный), "дефолтность спрошена у пула").ЭтоИстина();

КонецПроцедуры

// Исходный дефект: пакет пула contrib предлагал команду «opm install md-view», которая
// ставит одноимённый пакет из пула по умолчанию у клиента — то есть чужой или никакой.
&Тест
Процедура ПакетОбычногоПулаНесётАдресИПул() Экспорт

	Ожидаем.Что(Команды.Установка(Обычный, "md-view", Узел()))
		.Равно("opm install localhost:3380/contrib/md-view");
	Ожидаем.Что(Команды.КороткаяФорма(Обычный)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТегИВерсияДописываютсяКАдресу() Экспорт

	Ожидаем.Что(Команды.Установка(Обычный, "md-view", Узел(), "stable"))
		.Равно("opm install localhost:3380/contrib/md-view@stable");
	Ожидаем.Что(Команды.Установка(Обычный, "md-view", Узел(), "1.2.0"))
		.Равно("opm install localhost:3380/contrib/md-view@1.2.0");
	Ожидаем.Что(Команды.Установка(Дефолтный, "md-view", Узел(), "1.2.0"))
		.Равно("opm install md-view@1.2.0");

КонецПроцедуры

// Узел не определился — пул из команды всё равно не пропадает: короткая форма соврала бы
// про то, откуда берётся пакет.
&Тест
Процедура БезУзлаКомандаСохраняетПул() Экспорт

	Ожидаем.Что(Команды.Установка(Обычный, "md-view", ""))
		.Равно("opm install contrib/md-view");

КонецПроцедуры

#КонецОбласти

#Область ИсточникУзла

&Тест
Процедура БезНастройкиУзелБерётсяИзЗаголовкаHost() Экспорт

	Ожидаем.Что(Команды.Узел(Заголовки("hub.example.org:3380"))).Равно("hub.example.org:3380");

КонецПроцедуры

&Тест
Процедура НастройкаАдресаИнстансаПеребиваетЗаголовок() Экспорт

	Настройки.Задать("oshub.instance.url", "https://packages.example.org/");

	Ожидаем.Что(Команды.Узел(Заголовки("localhost:3380")),
		"адрес инсталляции сильнее заголовка запроса").Равно("packages.example.org");

КонецПроцедуры

&Тест
Процедура ПутьИзНастройкиВУзелНеПопадает() Экспорт

	Настройки.Задать("oshub.instance.url", "https://example.org/hub/");

	Ожидаем.Что(Команды.Узел(Заголовки("localhost:3380"))).Равно("example.org");

КонецПроцедуры

// Host приходит от клиента: в команду попадает только то, что может быть узлом.
&Тест
Процедура ПоддельныйHostОбрезаетсяДоУзла() Экспорт

	Ожидаем.Что(Команды.Узел(Заголовки("evil.example/x"" onmouseover=alert(1) y=""")),
		"хвост с разметкой отрезан").Равно("evil.example");

	Ожидаем.Что(Команды.Узел(Заголовки("evil.example" + Символы.ПС + "X-Injected: 1")),
		"перевод строки не уезжает в команду").Равно("evil.example");

	Ожидаем.Что(Команды.Узел(Заголовки("user:pass@evil.example:8080")),
		"учётные данные из Host отброшены").Равно("evil.example:8080");

	Ожидаем.Что(Команды.Узел(Заголовки("зло.example")),
		"узел не из допустимых символов не берётся вовсе").Равно("");

	Ожидаем.Что(Команды.Узел(Заголовки("-example.org")),
		"узел не начинается со служебного символа").Равно("");

	Ожидаем.Что(Команды.Узел(Неопределено), "заголовков нет вовсе").Равно("");

КонецПроцедуры

&Тест
Процедура ПоддельныйHostНеДоезжаетДоКоманды() Экспорт

	Команда = Команды.Установка(Обычный, "md-view",
		Команды.Узел(Заголовки("evil.example/x"" onmouseover=alert(1) y=""")));

	Ожидаем.Что(Команда).Равно("opm install evil.example/contrib/md-view");
	Ожидаем.Что(СтрНайти(Команда, "onmouseover"), "полезная нагрузка не в команде").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОписаниеСервера

&Тест
Процедура ОписаниеСервераНесётПутьПулаИПортВАдресе() Экспорт

	Конфиг = Команды.ОписаниеСервера(Обычный, Узел());

	Ожидаем.Что(СтрНайти(Конфиг, """Имя"": ""contrib""") > 0, "имя сервера").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Конфиг, """Сервер"": ""http://localhost:3380""") > 0,
		"порт продублирован в адресе: opm push поле «Порт» не читает").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Конфиг, """Порт"": 3380") > 0, "порт числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Конфиг, """ПутьНаСервере"": ""/api/v1/pools/contrib/download/""") > 0,
		"путь выдачи пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Конфиг, """РесурсПубликацииПакетов"": ""/api/v1/pools/contrib/push""") > 0,
		"путь публикации пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Конфиг, "Авторизация"), "публичному пулу ключ не нужен").Равно(0);

КонецПроцедуры

&Тест
Процедура ПортБерётсяИзСхемыКогдаЕгоНетВУзле() Экспорт

	Настройки.Задать("oshub.instance.url", "https://packages.example.org");

	Конфиг = Команды.ОписаниеСервера(Обычный, Команды.Узел(Заголовки("localhost:3380")));

	Ожидаем.Что(СтрНайти(Конфиг, """Сервер"": ""https://packages.example.org""") > 0,
		"схема из настройки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Конфиг, """Порт"": 443") > 0, "порт схемы https").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПриватныйПулПолучаетПолеАвторизации() Экспорт

	Конфиг = Команды.ОписаниеСервера(Приватный, Узел());

	Ожидаем.Что(Команды.ТребуетКлюча(Приватный)).ЭтоИстина();
	Ожидаем.Что(Команды.ТребуетКлюча(Обычный)).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Конфиг, """Авторизация"": ""Bearer ") > 0,
		"без ключа приватный пул отвечает «не найдено»").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УстановкаЧерезСерверНазываетСерверИПакет() Экспорт

	Ожидаем.Что(Команды.УстановкаЧерезСервер(Обычный, "md-view"))
		.Равно("opm install -m contrib md-view");
	Ожидаем.Что(Команды.УстановкаЧерезСервер(Обычный, "md-view", "stable"))
		.Равно("opm install -m contrib md-view@stable");

КонецПроцедуры

#КонецОбласти

#Область Разметка

&Тест
Процедура КомандаШапкиОговариваетТребованиеККлиенту() Экспорт

	Модель = Подсказка.КомандаШапки(Обычный, "md-view", Узел());

	Ожидаем.Что(Модель.Команда).Равно("opm install localhost:3380/contrib/md-view");
	Ожидаем.Что(Модель.Пояснение).Равно(UI.Тексты.Шаблон("public.package.install.hint-address",
		Команды.ВерсияКлиентаСАдресациейПула()));

КонецПроцедуры

&Тест
Процедура КомандаШапкиДефолтногоПулаГоворитПроОсновнойПул() Экспорт

	Модель = Подсказка.КомандаШапки(Дефолтный, "md-view", Узел());

	Ожидаем.Что(Модель.Команда).Равно("opm install md-view");
	Ожидаем.Что(Модель.Пояснение).Равно(UI.Тексты.Текст("public.package.install.hint-short"));

КонецПроцедуры

&Тест
Процедура КарточкаПоказываетВторойСпособУстановки() Экспорт

	HTML = Подсказка.Карточка(Обычный, "md-view", Узел());

	Ожидаем.Что(СтрНайти(HTML, "/api/v1/pools/contrib/download/") > 0,
		"описание сервера для opm.cfg").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "opm install -m contrib md-view") > 0,
		"установка через -m — способ, работающий со штатным клиентом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, UI.Тексты.Шаблон("public.package.install.title",
			Команды.ВерсияКлиентаСАдресациейПула())) > 0,
		"заголовок карточки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "class=""cmd""") > 0, "команды нарисованы блоком команды").ЭтоИстина();

КонецПроцедуры

// ИСТ-КАТ-005: двухчастная подсказка названа легаси-флоу и НАЗЫВАЕТ версию клиента,
// с которой она перестаёт быть нужна. Без этого человек с новым opm читает её как
// единственный способ и правит настройки клиента зря.
&Тест
Процедура КарточкаНазываетЛегасиФлоуИВерсиюКлиента() Экспорт

	Версия = Команды.ВерсияКлиентаСАдресациейПула();
	HTML = Подсказка.Карточка(Обычный, "md-view", Узел());

	Ожидаем.Что(СтрНайти(НРег(HTML), "легаси") > 0,
		"двухчастная подсказка названа легаси-флоу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Версия) > 0,
		"и названа версия клиента, с которой она не нужна: " + Версия).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "%1"),
		"шаблон подставлен, а не напечатан как есть").Равно(0);

	// на карточке не бывает ВТОРОЙ версии клиента: зашитая в текст мимо КомандыOpm
	// разъедется с настоящей молча, и подсказка начнёт называть не тот рубеж
	Найденные = ВерсииВТексте(HTML);
	Ожидаем.Что(Найденные.Количество() > 0,
		"скан версий не ослеп: хоть одну на карточке он видит").ЭтоИстина();
	Для Каждого Найденная Из Найденные Цикл
		Ожидаем.Что(Найденная,
			"каждая версия на карточке — та, что называет КомандыOpm").Равно(Версия);
	КонецЦикла;

	// та же версия названа и в пояснении команды шапки — это ОДНО обещание, и разъехаться
	// два его места не должны
	Шапка = Подсказка.КомандаШапки(Обычный, "md-view", Узел());
	Ожидаем.Что(СтрНайти(Шапка.Пояснение, Версия) > 0,
		"пояснение команды шапки называет ту же версию").ЭтоИстина();

	// у пакета основного пула команда короткая, и легаси-оговорка ей не нужна
	Короткая = Подсказка.КомандаШапки(Дефолтный, "md-view", Узел());
	Ожидаем.Что(СтрНайти(Короткая.Пояснение, Версия),
		"короткой форме версия клиента не нужна").Равно(0);

КонецПроцедуры

// Все подстроки вида «X.Y.Z» из текста: чем их искать, тем и держится «версия названа
// в одном месте» — вторая, зашитая мимо КомандыOpm, окажется в этом списке чужой.
Функция ВерсииВТексте(Знач Текст)

	Найденные = Новый Массив();
	Части = СтрРазделить(СтрЗаменить(СтрЗаменить(Текст, "<", " "), ">", " "), " " + Символы.ПС + Символы.Таб, Ложь);

	Для Каждого Часть Из Части Цикл
		Кандидат = СокрЛП(СтрЗаменить(СтрЗаменить(Часть, ",", ""), ";", ""));
		Числа = СтрРазделить(Кандидат, ".", Ложь);
		Если Числа.Количество() <> 3 Тогда
			Продолжить;
		КонецЕсли;
		Если ТолькоЦифры(Числа[0]) И ТолькоЦифры(Числа[1]) И ТолькоЦифры(Числа[2]) Тогда
			Найденные.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

Функция ТолькоЦифры(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&Тест
Процедура КарточкаПриватногоПулаГоворитПроКлюч() Экспорт

	Приватная = Подсказка.Карточка(Приватный, "hushlib", Узел());
	Публичная = Подсказка.Карточка(Обычный, "md-view", Узел());

	Ожидаем.Что(СтрНайти(Приватная, UI.Тексты.Текст("public.package.install.private")) > 0,
		"приватный пул без ключа даёт «не найдено» — об этом сказано прямо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Публичная, UI.Тексты.Текст("public.package.install.private")),
		"публичному пулу оговорка про ключ не нужна").Равно(0);

КонецПроцедуры

&Тест
Процедура ПоддельныйHostВРазметкеЭкранирован() Экспорт

	HTML = Подсказка.Карточка(Обычный, "md-view",
		Команды.Узел(Заголовки("evil.example/x""><script>alert(1)</script>")));

	Ожидаем.Что(СтрНайти(HTML, "<script"), "разметки из заголовка в карточке нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "http://evil.example") > 0, "остался только узел").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ХабИзвестныйOpm

// Прописка не нужна ровно там, куда opm ходит сам: хаб объявлен известным клиенту, пул
// основной и ключа не требует. Во всех прочих случаях легаси-флоу — единственный способ,
// которым клиент младше адресной формы поставит пакет.
&Тест
Процедура ПропискаНеНужнаТолькоОсновномуПубличномуПулуИзвестногоХаба() Экспорт

	БезНастройки = Новый НастройкиЗаглушка();
	БезНастройки.Задать("oshub.instance.url", "");
	ПоУмолчанию = Новый КомандыOpm(Новый АдресИнстанса(БезНастройки), Новый ЗаголовкиHTTP(),
		Неопределено, Неопределено, БезНастройки);
	Ожидаем.Что(ПоУмолчанию.ПропискаНужна(Дефолтный),
		"незаданная настройка не объявляет хаб известным opm").ЭтоИстина();

	Ожидаем.Что(Команды.ПропискаНужна(Дефолтный),
		"выключенная настройка: прописка нужна и основному пулу").ЭтоИстина();

	ОбъявитьХабИзвестнымOpm();

	Ожидаем.Что(Команды.ПропискаНужна(Дефолтный),
		"основной публичный пул известного хаба opm находит сам").ЭтоЛожь();
	Ожидаем.Что(Команды.ПропискаНужна(Обычный),
		"короткий адрес ведёт только в основной пул: прочим прописка нужна").ЭтоИстина();
	Ожидаем.Что(Команды.ПропискаНужна(Приватный),
		"и приватному не основному тоже").ЭтоИстина();
	Ожидаем.Что(Команды.ПропискаНужна(ОсновнойПриватный),
		"приватному основному нужен ключ в поле «Авторизация»").ЭтоИстина();
	Ожидаем.Что(Команды.ПропискаНужна(Неопределено),
		"о неизвестном пуле хаб прописку не отменяет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОсновнойПубличныйПулИзвестногоХабаБезКарточкиИХвостаПроOpmCfg() Экспорт

	До = Подсказка.Карточка(Дефолтный, "md-view", Узел());
	ШапкаДо = Подсказка.КомандаШапки(Дефолтный, "md-view", Узел());

	ОбъявитьХабИзвестнымOpm();

	После = Подсказка.Карточка(Дефолтный, "md-view", Узел());
	ШапкаПосле = Подсказка.КомандаШапки(Дефолтный, "md-view", Узел());

	Ожидаем.Что(ЕстьЛегасиФлоу(До, Дефолтный, "md-view"),
		"КОНТРОЛЬ: без настройки карточка основного пула на месте").ЭтоИстина();
	Ожидаем.Что(ШапкаДо.Пояснение, "КОНТРОЛЬ: и пояснение шапки — с оговоркой про opm.cfg")
		.Равно(UI.Тексты.Текст("public.package.install.hint-short"));

	Ожидаем.Что(После, "карточки легаси-флоу на странице нет вовсе").Равно("");
	Ожидаем.Что(ШапкаПосле.Команда, "команда установки та же").Равно(ШапкаДо.Команда);
	Ожидаем.Что(СтрНайти(ШапкаПосле.Пояснение, "opm.cfg"),
		"пояснение не велит прописывать хаб: " + ШапкаПосле.Пояснение).Равно(0);
	Ожидаем.Что(ШапкаПосле.Пояснение, "пояснение — свой текст, а не обрезок прежнего")
		.Равно(UI.Тексты.Текст("public.package.install.hint-short.default-hub"));

КонецПроцедуры

// Короткий адрес известного хаба ведёт в основной пул, а не в этот: клиенту младше адресной
// формы карточка остаётся единственным способом, и шапка по-прежнему к ней отсылает.
&Тест
Процедура НеОсновнойПулИзвестногоХабаСохраняетКарточку() Экспорт

	ОбъявитьХабИзвестнымOpm();

	Ожидаем.Что(ЕстьЛегасиФлоу(Подсказка.Карточка(Обычный, "md-view", Узел()), Обычный, "md-view"),
		"карточка не основного пула на месте").ЭтоИстина();
	Ожидаем.Что(Подсказка.КомандаШапки(Обычный, "md-view", Узел()).Пояснение,
		"пояснение адресной формы отсылает к способу ниже, как и без настройки")
		.Равно(UI.Тексты.Шаблон("public.package.install.hint-address",
			Команды.ВерсияКлиентаСАдресациейПула()));

КонецПроцедуры

&Тест
Процедура ПриватныйОсновнойПулИзвестногоХабаСохраняетКарточкуИКлюч() Экспорт

	ОбъявитьХабИзвестнымOpm();

	HTML = Подсказка.Карточка(ОсновнойПриватный, "hushlib", Узел());
	Ожидаем.Что(ЕстьЛегасиФлоу(HTML, ОсновнойПриватный, "hushlib"),
		"без прописки с ключом приватный пул отвечает «не найдено»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, UI.Тексты.Текст("public.package.install.private")) > 0,
		"и карточка говорит про ключ").ЭтоИстина();
	Ожидаем.Что(Подсказка.КомандаШапки(ОсновнойПриватный, "hushlib", Узел()).Пояснение,
		"пояснение короткой формы оставляет оговорку про opm.cfg")
		.Равно(UI.Тексты.Текст("public.package.install.hint-short"));

КонецПроцедуры

&Тест
Процедура БыстрыйСтартИзвестногоХабаБезОбразцаOpmCfg() Экспорт

	До = Главная();
	ОбъявитьХабИзвестнымOpm();
	После = Главная();

	Ожидаем.Что(ЕстьОбразецНастройки(До, Дефолтный),
		"КОНТРОЛЬ: без настройки образец opm.cfg на главной есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(До, UI.Тексты.Текст("public.landing.start.install")) > 0,
		"КОНТРОЛЬ: и пояснение команды продолжает его").ЭтоИстина();

	Ожидаем.Что(ЕстьОбразецНастройки(После, Дефолтный), "образца opm.cfg нет").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(После, UI.Экран.Экранировать(
			Команды.Установка(Дефолтный, "<имя-пакета>", Узел()))) > 0,
		"команда установки осталась").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, UI.Тексты.Текст("public.landing.start.install")),
		"пояснение не продолжает снятый шаг").Равно(0);
	Ожидаем.Что(СтрНайти(После, UI.Тексты.Текст("public.landing.start.install.default-hub")) > 0,
		"у команды своё пояснение").ЭтоИстина();

КонецПроцедуры

// У приватного основного пула прописка с ключом нужна и на известном хабе: образец остаётся.
&Тест
Процедура БыстрыйСтартИзвестногоХабаСПриватнымОсновнымПуломСохраняетОбразец() Экспорт

	ОбъявитьХабИзвестнымOpm();
	Окружение.НазначитьОсновнойПул(ОсновнойПриватный);

	HTML = Главная();

	Ожидаем.Что(ЕстьОбразецНастройки(HTML, ОсновнойПриватный), "образец opm.cfg на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Авторизация") > 0, "и в нём поле ключа").ЭтоИстина();

КонецПроцедуры

Процедура ОбъявитьХабИзвестнымOpm()
	Настройки.Задать("oshub.instance.opm_default_hub", Истина);
КонецПроцедуры

// Легаси-флоу узнаётся по тому, ради чего он написан: пул сервером в opm.cfg и установка через -m.
Функция ЕстьЛегасиФлоу(Знач HTML, Знач Пул, Знач ИмяПакета)

	Возврат СтрНайти(HTML, Команды.УстановкаЧерезСервер(Пул, ИмяПакета)) > 0
		И ЕстьОбразецНастройки(HTML, Пул);

КонецФункции

// Образец настройки узнаётся по тому, что он прописывает клиенту: список серверов пакетов
// и путь выдачи пула в нём.
Функция ЕстьОбразецНастройки(Знач HTML, Знач Пул)

	Возврат СтрНайти(HTML, "СервераПакетов") > 0
		И СтрНайти(HTML, "/api/v1/pools/" + Пул.Имя + "/download/") > 0;

КонецФункции

// Главная собирается настоящим контроллером; из базы ей ничего не нужно — всё отдаёт окружение.
Функция Главная()

	Экран = Новый КонтроллерЛендинга(Окружение, Неопределено, UI.КарточкаПакета, Неопределено,
		UI.Кит, Окружение, UI.Набор, UI.Тексты, UI.Экран, UI.Бренд, Окружение, Окружение,
		Команды, Окружение, UI.АдресаКабинета, UI.Даты);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Показать(Ответ, Заголовки("localhost:3380"), Неопределено);
	Возврат Ответ.ТелоТекст;

КонецФункции

#КонецОбласти

#Область ПодсказкиПубликации

// opm push без настройки клиента уходит на /push хаба по умолчанию, а этот адрес публикует
// в основной пул: пустой главной известного opm хаба прописывать хаб незачем. Цель тогда
// короткий адрес, и токен с каналом едут опциями.
&Тест
Процедура ПустаяГлавнаяИзвестногоХабаНеПроситПрописыватьХаб() Экспорт

	До = ПояснениеПустогоХаба(Главная());
	ОбъявитьХабИзвестнымOpm();
	После = ПояснениеПустогоХаба(Главная());

	Ожидаем.Что(До, "КОНТРОЛЬ: без настройки — пояснение с прописью")
		.Равно(ТекстСтраницы("public.landing.empty.lead"));
	Ожидаем.Что(УпоминаетOpmCfg(До), "КОНТРОЛЬ: и оно велит прописать хаб в opm.cfg").ЭтоИстина();

	Ожидаем.Что(После, "в основной пул известного хаба — пояснение без прописи")
		.Равно(ТекстСтраницы("public.landing.empty.lead.default-hub"));
	Ожидаем.Что(УпоминаетOpmCfg(После), "opm.cfg не упомянут: " + После).ЭтоЛожь();
	Ожидаем.Что(ЕстьТокенКаналИФайл(После), "токен, канал и файл пакета названы: " + После).ЭтоИстина();

КонецПроцедуры

// Основной пул с ключом предикат страхует прописью и на известном хабе, а без основного
// пула короткому адресу публикации вести некуда: в обоих случаях подсказка прежняя.
&Тест
Процедура ПустаяГлавнаяИзвестногоХабаБезОткрытогоОсновногоПулаПроситПрописку() Экспорт

	ОбъявитьХабИзвестнымOpm();
	ПриОткрытом = ПояснениеПустогоХаба(Главная());

	Окружение.НазначитьОсновнойПул(ОсновнойПриватный);
	ПриПриватном = ПояснениеПустогоХаба(Главная());

	Окружение.НазначитьОсновнойПул(Неопределено);
	БезОсновного = ПояснениеПустогоХаба(Главная());

	Ожидаем.Что(ПриОткрытом, "КОНТРОЛЬ: настройка действует — открытому основному пулу прописка не нужна")
		.Равно(ТекстСтраницы("public.landing.empty.lead.default-hub"));
	Ожидаем.Что(ПриПриватном, "публикацию в основной пул с ключом хаб без opm.cfg не обещает")
		.Равно(ТекстСтраницы("public.landing.empty.lead"));
	Ожидаем.Что(БезОсновного, "без основного пула короткий адрес публикации никуда не ведёт")
		.Равно(ТекстСтраницы("public.landing.empty.lead"));

КонецПроцедуры

// Без opm.cfg поля «Авторизация» нет: шаги токена и публикации говорят про опции команды.
&Тест
Процедура ШагиПроводникаВОсновнойПулИзвестногоХабаНеПросятПрописку() Экспорт

	ОкружениеПути.ДатьПулПубликации(Дефолтный);

	ТокенДо = ПояснениеШага("токен");
	ПубликацияДо = ПояснениеШага("публикация");
	ОбъявитьХабИзвестнымOpm();
	ТокенПосле = ПояснениеШага("токен");
	ПубликацияПосле = ПояснениеШага("публикация");

	Ожидаем.Что(УпоминаетOpmCfg(ПубликацияДо),
		"КОНТРОЛЬ: без настройки шаг публикации велит прописать пул в opm.cfg").ЭтоИстина();
	Ожидаем.Что(УпоминаетOpmCfg(ТокенДо),
		"КОНТРОЛЬ: и шаг токена говорит про opm.cfg").ЭтоИстина();

	Ожидаем.Что(УпоминаетOpmCfg(ПубликацияПосле), "шаг публикации без opm.cfg: " + ПубликацияПосле)
		.ЭтоЛожь();
	Ожидаем.Что(ЕстьТокенКаналИФайл(ПубликацияПосле),
		"токен, канал и файл пакета названы: " + ПубликацияПосле).ЭтоИстина();
	Ожидаем.Что(УпоминаетOpmCfg(ТокенПосле), "шаг токена без opm.cfg: " + ТокенПосле).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ТокенПосле, "--token") > 0,
		"шаг токена называет опцию, которой токен передаётся: " + ТокенПосле).ЭтоИстина();

КонецПроцедуры

// Короткий адрес публикации ведёт в основной пул, а не в личный: в личный без прописки
// не опубликовать и на известном хабе.
&Тест
Процедура ШагиПроводникаВЛичныйПулИзвестногоХабаПросятПрописку() Экспорт

	ОбъявитьХабИзвестнымOpm();

	ОкружениеПути.ДатьПулПубликации(Дефолтный);
	ВОсновной = ПояснениеШага("публикация");

	ОкружениеПути.ДатьПулПубликации(Личный);
	ВЛичный = ПояснениеШага("публикация");
	ТокенВЛичный = ПояснениеШага("токен");

	Ожидаем.Что(УпоминаетOpmCfg(ВОсновной),
		"КОНТРОЛЬ: настройка действует — в основной пул прописка не нужна").ЭтоЛожь();
	Ожидаем.Что(УпоминаетOpmCfg(ВЛичный), "в личный пул шаг велит прописать пул в opm.cfg")
		.ЭтоИстина();
	Ожидаем.Что(ЕстьТокенКаналИФайл(ВЛичный), "и опций вместо прописи не предлагает").ЭтоЛожь();
	Ожидаем.Что(УпоминаетOpmCfg(ТокенВЛичный), "шаг токена — прежний, про opm.cfg").ЭтоИстина();

КонецПроцедуры

// Без opm.cfg карточке публикации нечего прописывать: вместо образца — команда, в которой
// токен и канал переданы опциями, а описание называет пул, куда уйдёт пакет.
&Тест
Процедура КарточкаПубликацииВОсновнойПулИзвестногоХабаДаётКомандуСТокеномИКаналом() Экспорт

	ОкружениеПути.ДатьПулПубликации(Дефолтный);

	До = СтраницаПроводника();
	ОбъявитьХабИзвестнымOpm();
	После = СтраницаПроводника();

	Ожидаем.Что(ЕстьОбразецНастройки(До, Дефолтный),
		"КОНТРОЛЬ: без настройки образец opm.cfg на месте").ЭтоИстина();
	Ожидаем.Что(ЕстьПубликацияСТокеномИКаналом(До),
		"КОНТРОЛЬ: и команда публикации опций не несёт — их даёт opm.cfg").ЭтоЛожь();
	Ожидаем.Что(ОписаниеНазываетПул(До, Дефолтный),
		"КОНТРОЛЬ: описание карточки с прописью пул по имени не называет").ЭтоЛожь();

	Ожидаем.Что(СтрНайти(После, "СервераПакетов"), "образца opm.cfg нет").Равно(0);
	Ожидаем.Что(ЕстьПубликацияСТокеномИКаналом(После),
		"команда публикации передаёт токен, канал и файл: "
		+ СтрСоединить(КомандыСтраницы(После), " | ")).ЭтоИстина();
	Ожидаем.Что(ОписаниеНазываетПул(После, Дефолтный),
		"описание карточки называет основной пул: "
		+ СтрСоединить(ОписанияКарточек(После), " | ")).ЭтоИстина();

КонецПроцедуры

// В личный пул короткий адрес публикации не ведёт: образец opm.cfg остаётся и на известном хабе.
&Тест
Процедура КарточкаПубликацииВЛичныйПулИзвестногоХабаСохраняетОбразец() Экспорт

	ОбъявитьХабИзвестнымOpm();

	ОкружениеПути.ДатьПулПубликации(Дефолтный);
	ВОсновной = СтраницаПроводника();

	ОкружениеПути.ДатьПулПубликации(Личный);
	ВЛичный = СтраницаПроводника();

	Ожидаем.Что(СтрНайти(ВОсновной, "СервераПакетов"),
		"КОНТРОЛЬ: настройка действует — в основной пул образца нет").Равно(0);
	Ожидаем.Что(ЕстьОбразецНастройки(ВЛичный, Личный), "в личный пул образец opm.cfg на месте")
		.ЭтоИстина();
	Ожидаем.Что(ЕстьПубликацияСТокеномИКаналом(ВЛичный),
		"и команда публикации опирается на него, а не на опции").ЭтоЛожь();

КонецПроцедуры

// Пояснение пустого состояния берётся целиком — абзац под заголовком, ровно один на странице.
Функция ПояснениеПустогоХаба(Знач HTML)

	Начало = "<p class=""empty__text"">";
	Ожидаем.Что(СтрЧислоВхождений(HTML, Начало), "на главной одно пустое состояние").Равно(1);

	Хвост = Сред(HTML, СтрНайти(HTML, Начало) + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост, "</p>") - 1);

КонецФункции

Функция ТекстСтраницы(Знач Ключ)
	Возврат UI.Экран.Экранировать(UI.Тексты.Текст(Ключ));
КонецФункции

Функция УпоминаетOpmCfg(Знач Текст)
	Возврат СтрНайти(Текст, "opm.cfg") > 0;
КонецФункции

// Без opm.cfg цель публикации — короткий адрес хаба: токен нужен опцией, канал там обязателен,
// а файл пакета клиенты младше 1.8.0 без аргумента не находят.
Функция ЕстьТокенКаналИФайл(Знач Текст)

	ЕстьКанал = СтрНайти(Текст, "-c stable") > 0 ИЛИ СтрНайти(Текст, "--channel stable") > 0;
	Возврат СтрНайти(Текст, "--token ") > 0 И ЕстьКанал И СтрНайти(Текст, ".ospx") > 0;

КонецФункции

// Путь собирается настоящим классом; из базы ему ничего не нужно — всё отдаёт окружение.
Функция ПутьПервойПубликации()

	Возврат Новый ПутьПервойПубликации(ОкружениеПути, ОкружениеПути, ОкружениеПути, ОкружениеПути,
		ОкружениеПути, ОкружениеПути, ОкружениеПути, Команды);

КонецФункции

Функция ПояснениеШага(Знач Ключ)

	Для Каждого Шаг Из ПутьПервойПубликации().Состояние(Новый Структура("Идентификатор", 7)).Шаги Цикл
		Если Шаг.Ключ = Ключ Тогда
			Возврат Шаг.Пояснение;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("в пути первой публикации нет шага «%1»", Ключ);

КонецФункции

// Страница /tour собирается настоящим контроллером; окружение впускает пользователя
// и отдаёт тело без обрамления.
Функция СтраницаПроводника()

	Путь = ПутьПервойПубликации();
	Экран = Новый КонтроллерПроводника(ОкружениеПути, ОкружениеПути, UI.Экран, UI.Набор, Путь,
		Новый ОтветыНастроекЗаглушка(), ОкружениеПути,
		Новый ВитринаПервойПубликации(UI.Кит, Путь, UI.Тексты));

	Ответ = Новый ОтветСтраницыЗаглушка();
	Экран.Проводник(Ответ, Новый Соответствие(), Неопределено, "GET", "/tour");
	Ожидаем.Что(Ответ.Код, "проводник отдан").Равно(200);
	Возврат Ответ.ТелоТекст;

КонецФункции

// Команды страницы — содержимое блоков команд, без слов вокруг: пояснение шага тоже
// называет опции, и поиск по всей странице нашёл бы их там.
Функция КомандыСтраницы(Знач HTML)
	Возврат Фрагменты(HTML, "<div class=""cmd""><code>", "</code>");
КонецФункции

Функция ОписанияКарточек(Знач HTML)
	Возврат Фрагменты(HTML, "<p class=""card__lead"">", "</p>");
КонецФункции

// Пул ищется в описаниях карточек, а не по всей странице: адрес его настроек стоит в шагах.
Функция ОписаниеНазываетПул(Знач HTML, Знач Пул)

	Для Каждого Описание Из ОписанияКарточек(HTML) Цикл
		Если СтрНайти(Описание, " " + Пул.Имя) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Содержимое всех узлов между открывающей разметкой и её закрытием, по порядку на странице.
Функция Фрагменты(Знач HTML, Знач Начало, Знач Конец)

	Результат = Новый Массив();

	Хвост = HTML;
	Позиция = СтрНайти(Хвост, Начало);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Начало));
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, Конец) - 1));
		Позиция = СтрНайти(Хвост, Начало);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьПубликацияСТокеномИКаналом(Знач HTML)

	Для Каждого Команда Из КомандыСтраницы(HTML) Цикл
		Если СтрНачинаетсяС(Команда, "opm push ") И ЕстьТокенКаналИФайл(Команда) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СниппетыКонвейеров

// Адрес хаба уезжает ВНУТРЬ чужого конвейера, поэтому оба его источника — настройка
// и заголовок — проходят тот же разбор узла, что и команды opm.
&Тест
Процедура АдресДляСниппетаБерётсяИзНастройкиЛибоИзHost() Экспорт

	Ожидаем.Что(Сниппеты.БазовыйАдрес(Заголовки("hub.example.org:3380")),
		"без настройки — узел из заголовка со схемой http").Равно("http://hub.example.org:3380");

	Настройки.Задать("oshub.instance.url", "https://packages.example.org/");
	Ожидаем.Что(Сниппеты.БазовыйАдрес(Заголовки("localhost:3380")),
		"настройка сильнее заголовка и приносит свою схему").Равно("https://packages.example.org");

КонецПроцедуры

// Подделанный Host и мусор в настройке одинаково обрезаются до того, что вообще может
// быть узлом: перевод строки в YAML — это подделка чужого конвейера.
&Тест
Процедура МусорВАдресеДоСниппетаНеДоезжает() Экспорт

	Ожидаем.Что(Сниппеты.БазовыйАдрес(Заголовки("evil.example" + Символы.ПС + "X-Injected: 1")),
		"перевод строки из Host обрезан").Равно("http://evil.example");

	Настройки.Задать("oshub.instance.url",
		"https://hub.example.org" + Символы.ПС + "audience: evil.example");
	Ожидаем.Что(Сниппеты.БазовыйАдрес(Заголовки("localhost:3380")),
		"перевод строки из настройки обрезан тем же разбором").Равно("https://hub.example.org");

	Настройки.Задать("oshub.instance.url", "");
	Ожидаем.Что(Сниппеты.БазовыйАдрес(Заголовки("зло.example")),
		"нелатинский узел не годится — адреса нет вовсе").Равно("");
	Ожидаем.Что(Сниппеты.БазовыйАдрес(Неопределено),
		"без заголовков и настройки адреса нет").Равно("");

КонецПроцедуры

// Конвейер без разрешения id-token токена не получит, а без audience хаб не поймёт,
// кому токен выписан. Аудитория — ОТДЕЛЬНОЕ значение: с адресом хаба она совпадает
// только пока администратор не задал свою.
&Тест
Процедура КонвейерGitHubЗаказываетIdTokenНаАудиториюХаба() Экспорт

	Текст = Сниппеты.GitHubActions("https://hub.example.org", "contrib", "mylib", "openhub-prod");

	Ожидаем.Что(СтрНайти(Текст, "id-token: write") > 0, "разрешение на id-token").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "audience: openhub-prod") > 0,
		"audience — то, что сверяет хаб").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "audience: https://hub.example.org"),
		"а не адрес хаба").Равно(0);
	Ожидаем.Что(СтрНайти(Текст, "hub: https://hub.example.org") > 0,
		"адрес хаба остаётся у самой публикации").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "/api/v1/pools/$pool/push") > 0, "адрес публикации").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "pool: contrib") > 0, "пул назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "package: mylib") > 0, "пакет назван").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КонвейерGitLabЗаказываетIdTokenНаАудиториюХаба() Экспорт

	Текст = Сниппеты.GitLabCI("https://hub.example.org", "contrib", "mylib", "openhub-prod");

	Ожидаем.Что(СтрНайти(Текст, "id_tokens:") > 0, "заказ токена объявлен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "aud: openhub-prod") > 0,
		"aud — то, что сверяет хаб").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "aud: https://hub.example.org"), "а не адрес хаба").Равно(0);
	Ожидаем.Что(СтрНайти(Текст, "OAUTH-TOKEN: $OPENHUB_TOKEN") > 0,
		"токен уходит тем же заголовком, что и PAT").ЭтоИстина();

КонецПроцедуры

// Сниппет копируют к себе и запускают: неработающая строка ломается у пользователя.
// version у setup-onescript объявлен обязательным, а версию opm экшен не выбирает вовсе —
// в дистрибутиве едет своя, поэтому нужная ставится отдельным шагом.
&Тест
Процедура ОбаКонвейераСтавятOneScriptИНужнуюВерсиюOpm() Экспорт

	Шаг = "opm install opm@" + Сниппеты.ВерсияOpm();

	GitHub = Сниппеты.GitHubActions("https://hub.example.org", "contrib", "mylib", "aud");
	Ожидаем.Что(СтрНайти(GitHub, "version:") > 0,
		"обязательный вход экшена задан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(GitHub, Шаг) > 0, "версия opm закреплена шагом").ЭтоИстина();

	GitLab = Сниппеты.GitLabCI("https://hub.example.org", "contrib", "mylib", "aud");
	Ожидаем.Что(СтрНайти(GitLab, "image:") > 0,
		"на голом раннере OneScript нет — образ назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(GitLab, Шаг) > 0, "и та же версия opm").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Узел()
	Возврат Команды.Узел(Заголовки("localhost:3380"));
КонецФункции

Функция Заголовки(Знач Host)

	Результат = Новый Соответствие();
	Результат.Вставить("Host", Host);
	Возврат Результат;

КонецФункции

#КонецОбласти
