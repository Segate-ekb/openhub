// Юнит-тесты формы страницы списковых ручек API: разметка из параметров запроса, потолок
// выдачи, срез и конверт {items, page, pageSize, total, has_more}.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулей;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "СтраницыAPI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

КонецПроцедуры

#Область ФормаСтраницы

&Тест
Процедура ПеречисленьБезПараметровОтдаётСписокЦеликомВПрежнейФорме() Экспорт

	Страница = Страницы().Перечень(Список(7), "", "");

	Ожидаем.Что(Страница.items.Количество(), "элементы отданы все").Равно(7);
	Ожидаем.Что(Страница.total, "total — полное число").Равно(7);
	Ожидаем.Что(Страница.items[0], "первый элемент на месте").Равно("э1");
	Ожидаем.Что(Страница.items[6], "последний элемент на месте").Равно("э7");
	Ожидаем.Что(Страница.has_more, "за страницей ничего не осталось").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КонвертНесётНомерРазмерВсегоИПризнакПродолжения() Экспорт

	Страница = Страницы().Перечень(Список(3), "", "");

	Ожидаем.Что(Страница.Свойство("items"), "поле items").ЭтоИстина();
	Ожидаем.Что(Страница.Свойство("page"), "поле page").ЭтоИстина();
	Ожидаем.Что(Страница.Свойство("pageSize"), "поле pageSize").ЭтоИстина();
	Ожидаем.Что(Страница.Свойство("total"), "поле total").ЭтоИстина();
	Ожидаем.Что(Страница.Свойство("has_more"), "поле has_more").ЭтоИстина();
	Ожидаем.Что(Страница.page, "первая страница").Равно(1);

КонецПроцедуры

&Тест
Процедура ИсторическаяРучкаЗовётСписокСвоимИменем() Экспорт

	Страница = Страницы().Перечень(Список(2), "", "", "versions");

	Ожидаем.Что(Страница.Свойство("versions"), "поле versions").ЭтоИстина();
	Ожидаем.Что(Страница.Свойство("items"), "поля items у неё нет").ЭтоЛожь();
	Ожидаем.Что(Страница.versions.Количество(), "версии на месте").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ПотолокВыдачи

&Тест
Процедура ПотолокОбрезаетЗапрошенныйРазмерСтраницы() Экспорт

	Страница = Страницы().Перечень(Список(500), "", "100000");

	Ожидаем.Что(Страница.items.Количество(), "в одном ответе не больше потолка").Равно(200);
	Ожидаем.Что(Страница.pageSize, "и размер страницы назван по потолку").Равно(200);

КонецПроцедуры

&Тест
Процедура ПотолокОбрезаетИВыдачуБезПараметров() Экспорт

	Страница = Страницы().Перечень(Список(250), "", "");

	Ожидаем.Что(Страница.items.Количество(), "список длиннее потолка обрезан").Равно(200);
	Ожидаем.Что(Страница.total, "но total называет всё").Равно(250);
	Ожидаем.Что(Страница.has_more, "и усечение объявлено").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПотолокЧитаетсяИзНастройкиИнсталляции() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.api.page_max", 5);

	Страница = Страницы(Настройки).Перечень(Список(50), "", "40");

	Ожидаем.Что(Страница.items.Количество(), "потолок инсталляции ниже запроса").Равно(5);

КонецПроцедуры

&Тест
Процедура ЛистающаясяРучкаБерётРазмерИзНастройкиЛистания() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.api.page_size", 7);

	Ожидаем.Что(Страницы(Настройки).РазметкаЛистания("", "").Размер,
		"размер листания задаёт инсталляция").Равно(7);
	Ожидаем.Что(Страницы().РазметкаЛистания("", "").Размер,
		"без настройки — умолчание кода").Равно(20);

КонецПроцедуры

&Тест
Процедура РазмерПоУмолчаниюНеПерепрыгиваетПотолок() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.api.page_size", 1000);
	Настройки.Задать("oshub.api.page_max", 30);

	Разметка = Страницы(Настройки).РазметкаЛистания("", "");

	Ожидаем.Что(Разметка.Размер, "умолчание тоже под потолком").Равно(30);

КонецПроцедуры

#КонецОбласти

#Область НомерИРазмер

&Тест
Процедура ВтораяСтраницаНеПовторяетПервую() Экспорт

	Первая = Страницы().Перечень(Список(6), "1", "2");
	Вторая = Страницы().Перечень(Список(6), "2", "2");

	Ожидаем.Что(Первая.items[0], "первая начинается с первого").Равно("э1");
	Ожидаем.Что(Вторая.items[0], "вторая — с третьего").Равно("э3");
	Ожидаем.Что(Вторая.items[1], "и продолжается четвёртым").Равно("э4");
	Ожидаем.Что(Вторая.page, "номер страницы назван").Равно(2);

КонецПроцедуры

&Тест
Процедура ПоследняяСтраницаЗакрываетПризнакПродолжения() Экспорт

	Ожидаем.Что(Страницы().Перечень(Список(4), "1", "2").has_more,
		"за первой страницей есть ещё").ЭтоИстина();
	Ожидаем.Что(Страницы().Перечень(Список(4), "2", "2").has_more,
		"за последней — уже нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СтраницаЗаКраемПустаНоСписокНеТеряется() Экспорт

	Страница = Страницы().Перечень(Список(4), "999", "2");

	Ожидаем.Что(Страница.items.Количество(), "за краем элементов нет").Равно(0);
	Ожидаем.Что(Страница.total, "но всего их по-прежнему четыре").Равно(4);
	Ожидаем.Что(Страница.has_more, "и продолжения за краем нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура МусорВПараметрахДаётПервуюСтраницуУмолчания() Экспорт

	Страница = Страницы().Перечень(Список(3), "не число", "тоже не число");

	Ожидаем.Что(Страница.page, "номер — первая страница").Равно(1);
	Ожидаем.Что(Страница.pageSize, "размер — умолчание перечня").Равно(200);
	Ожидаем.Что(Страница.items.Количество(), "и список отдан целиком").Равно(3);

КонецПроцедуры

&Тест
Процедура НеположительныеНомерИРазмерВыправляются() Экспорт

	Страница = Страницы().Перечень(Список(3), "0", "-5");

	Ожидаем.Что(Страница.page, "нулевой страницы не бывает").Равно(1);
	Ожидаем.Что(Страница.pageSize, "отрицательный размер — умолчание").Равно(200);

КонецПроцедуры

&Тест
Процедура РазмерСрезаИзмененийЖивётПоСвоимЧислам() Экспорт

	Страницы = Страницы();

	Ожидаем.Что(Страницы.Размер("", 100, 500), "пусто — умолчание порции").Равно(100);
	Ожидаем.Что(Страницы.Размер("100000", 100, 500), "и своя граница порции").Равно(500);

КонецПроцедуры

&Тест
Процедура РазметкаОтСервисаНазываетТоЧтоВыбралСервис() Экспорт

	Страницы = Страницы();
	Разметка = Страницы.РазметкаОтСервиса(3, 25);

	Ожидаем.Что(Страницы.Конверт(Список(2), 60, Разметка).page, "номер от сервиса").Равно(3);
	Ожидаем.Что(Страницы.Конверт(Список(2), 60, Разметка).pageSize, "размер от сервиса").Равно(25);
	Ожидаем.Что(Страницы.Конверт(Список(2), 60, Разметка).has_more,
		"75 из 60 пройдено — продолжения нет").ЭтоЛожь();

КонецПроцедуры

// Сервис вправе вернуть ноль страниц («ничего не нашлось») либо мусор: конверт обязан
// назвать клиенту страницу, которую можно попросить снова, а «page=0» такой не является.
&Тест
Процедура РазметкаОтСервисаПоднимаетНольИМинусКЕдинице() Экспорт

	Страницы = Страницы();

	Пустая = Страницы.РазметкаОтСервиса(0, 0);
	Ожидаем.Что(Пустая.Номер, "номер страницы не бывает нулевым").Равно(1);
	Ожидаем.Что(Пустая.Размер, "размер страницы не бывает нулевым").Равно(1);

	Отрицательная = Страницы.РазметкаОтСервиса(-5, -20);
	Ожидаем.Что(Отрицательная.Номер, "отрицательный номер поднят к первой странице").Равно(1);
	Ожидаем.Что(Отрицательная.Размер, "отрицательный размер поднят к единице").Равно(1);

	Конверт = Страницы.Конверт(Список(0), 0, Пустая);
	Ожидаем.Что(Конверт.page, "в конверте пустой выдачи стои́т первая страница").Равно(1);
	Ожидаем.Что(Конверт.pageSize, "и размер не ноль").Равно(1);

КонецПроцедуры

// Настройка, отдавшая ноль, оставила бы списковую ручку с пустой страницей: клиент
// получал бы 200 и ничего в теле. Держит инвариант сам класс — клампы в Размер и Номер;
// минимум в чтении настройки здесь вторая сеть за ними.
&Тест
Процедура НольВНастройкахСтраницыДаётЕдиницуАНеПустуюВыдачу() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.api.page_size", 0);
	Настройки.Задать("oshub.api.page_max", 0);
	Страницы = Страницы(Настройки);

	Разметка = Страницы.РазметкаЛистания("", "");
	Ожидаем.Что(Разметка.Размер, "размер страницы листания не обнуляется").Равно(1);
	Ожидаем.Что(Разметка.Номер, "и номер остаётся первой страницей").Равно(1);

	Ожидаем.Что(Страницы.Срез(Список(5), Разметка).Количество(),
		"в срезе есть что отдать клиенту").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Страницы(Знач Настройки = Неопределено)
	Возврат Новый СтраницыAPI(Настройки);
КонецФункции

Функция Список(Знач Сколько)
	Результат = Новый Массив();
	Для Номер = 1 По Сколько Цикл
		Результат.Добавить("э" + Формат(Номер, "ЧГ=0"));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
