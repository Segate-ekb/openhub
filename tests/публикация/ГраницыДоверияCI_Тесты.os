// Попытки обойти доверенный конвейер через точку маршрута push: формы aud, канонизация iss,
// сверка конвейера, срок токена, чужой пакет, транспорт ключей и отказ при сбое внутри проверки.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать autumn-logos
#Использовать pwhash
#Использовать annotations
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Контейнер;     // фикстура КонтейнерПубликации — соседи, сборка поделки, точка маршрута push
Перем Поделка;
Перем Контроллер;
Перем Фикстура;      // содержимое файла токенов: издатель, репозиторий, ключи, токены
Перем Конвейеры;     // фикстура СтендКонвейеровCI — запись доверия, push токеном, ключи издателей
Перем КореньХранилища;
Перем КаталогСборки;
Перем Публикация;    // фикстура СтендПубликации — пул с мейнтейнером
Перем Принципалы;    // фикстура СтендПринципалов — принципал сессии браузера
                     // и имя пакета, заведённое публикацией .ospx
Перем МаршрутыКонтроллераПуша; // Массив из Строка — адреса точек маршрута, как их читает рантайм

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("КонтейнерПубликации");
	РеестрФикстур.Подключить("СтендПубликации");
	РеестрФикстур.Подключить("СтендПринципалов");
	РеестрФикстур.Подключить("СтендКонвейеровCI");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	Контейнер = Новый КонтейнерПубликации(ПоискКлассов, КаталогМодулей);

	Контейнер.ПодключитьСоседей();
	Контейнер.ПодключитьДверьПуша();
	Контейнер.ПодключитьПубликацию("СервисВходящих, СтражИздателейCI, МаскаРефа, КороткаяФормаДоверия,"
		+ " ИмяЗаписиДоверия, ВидРефаДоверия, СрокТокенаCI, АудиторияТокенаCI, ЗапускКонвейераCI, ТранспортJWKSХаба,"
		+ " КэшиКлючейCI, ПроверяющийПодписиJWKS, СервисДоверияCI, СервисПубликации,"
		+ " РассмотрениеВходящих, СервисРезервированияИмён");

	// исход заявки заявителю уходит личным каналом; здесь проверяется домен, а не канал,
	// поэтому дверь подменена фейком — перечень поводов при этом настоящий
	ПоискКлассов.Подключить(КаталогМодулей, "ПоводыУведомлений");
	РеестрФикстур.Подключить("ФейкКаналаУведомлений");

	Для Каждого Имя Из СтрРазделить("ФейкПроверяющийGitHub, ФейкТранспортHTTPПоАдресам, ФикстураПакета,"
		+ " ОтветПушаЗаглушка, ФейкПадающийСтражИздателей, ФейкПроверяющийСПодменойКлеймов, ЛовушкаЛога", ",") Цикл
		РеестрФикстур.Подключить(СокрЛП(Имя));
	КонецЦикла;

	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-ci-bounds");
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Поделка = Контейнер.Собрать("границы-доверия-тесты", КореньХранилища);

	Публикация = Новый СтендПубликации(Поделка, КаталогСборки);
	Принципалы = Новый СтендПринципалов(Поделка);
	Контроллер = Контейнер.КонтроллерПуша(Поделка, ЛогТестов());
	Конвейеры = Новый СтендКонвейеровCI(Поделка, Контроллер, КаталогСборки,
		ОбъединитьПути(КаталогиПроекта.Фикстуры(), "ci-токены-границ.json"));
	Фикстура = Конвейеры.ФайлТокенов();

	НаполнитьТранспорт();
	Конвейеры.ЗадатьАудиторию(Фикстура["аудитория"]);

	// сниппеты конвейера подключаются типом после сборки: интерфейса в этом контейнере нет
	КлассыWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Сниппеты = НайтиФайлы(КлассыWebUI, "СниппетыКонвейеров.os", Истина);
	Если Сниппеты.Количество() = 0 Тогда
		ВызватьИсключение "СниппетыКонвейеров не найдены в " + КлассыWebUI;
	КонецЕсли;
	ПоискКлассов.ПодключитьФайл(Сниппеты[0].ПолноеИмя);
	МаршрутыКонтроллераПуша = МаршрутыКонтроллера(Тип("КонтроллерПубликации"));

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

#Область Аудитория

// Массивная форма aud без нашего адреса не публикует, с нашим адресом — публикует.
&Тест
Процедура AudМассивомБезНашегоАдресаНеПубликует() Экспорт

	Стенд = Конвейеры.ЗавестиСтенд("raudarr");

	Атака = Конвейеры.ПушТокеном(Стенд, "1.1.0", Конвейеры.Токен("aud_массив_чужой"));
	Ожидаем.Что(Атака.Код, "массив без нашего адреса → 403").Равно(403);
	Ожидаем.Что(Атака.ТелоТекст, "причина названа").Содержит("другого сервиса");

	Контроль = Конвейеры.ПушТокеном(Стенд, "1.1.0", Конвейеры.Токен("aud_массив_регистр"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: массив с нашим адресом публикует: "
		+ Контроль.ТелоТекст).Равно(201);

КонецПроцедуры

// Отказ публикации — веха уровня хаба: пул, файл и код видны без отладки. Принятая версия
// на журнале двери не повторяется: её называет запись аудита «публикация.версии».
&Тест
Процедура ОтказПубликацииВиденНаИнформацииАПринятаяНеДублируется() Экспорт

	Доверие = Новый ЛовушкаЛога();
	Доверие.Поставить(Логирование.ПолучитьЛог("СервисДоверияCI"), УровниЛога.Информация);
	Попытка
		Стенд = Конвейеры.ЗавестиСтенд("rlogrej");
	Исключение
		Доверие.Снять();
		ВызватьИсключение;
	КонецПопытки;
	Доверие.Снять();

	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(ЛогТестов(), УровниЛога.Информация);
	Служба = Новый ЛовушкаЛога();
	Служба.Поставить(Логирование.ПолучитьЛог("СервисПубликации"), УровниЛога.Информация);
	Попытка
		Отказ = Конвейеры.ПушТокеном(Стенд, "1.1.0", Конвейеры.Токен("aud_массив_чужой"));
		ЖурналОтказа = Ловушка.Всё();
		Ловушка.Очистить();
		Служба.Очистить();
		Принята = Конвейеры.ПушТокеном(Стенд, "1.1.0", Конвейеры.Токен("aud_массив_регистр"));
	Исключение
		Ловушка.Снять();
		Служба.Снять();
		ВызватьИсключение;
	КонецПопытки;
	Ловушка.Снять();
	Служба.Снять();

	Ожидаем.Что(Отказ.Код, "чужая аудитория — отказ").Равно(403);
	Ожидаем.Что(ЖурналОтказа, "отказ назван на ИНФОРМАЦИИ: " + ЖурналОтказа).Содержит(Стенд.Пул.Имя);
	Ожидаем.Что(ЖурналОтказа, "с файлом").Содержит(Стенд.ИмяПакета + "-1.1.0.ospx");
	Ожидаем.Что(ЖурналОтказа, "и кодом").Содержит("403");
	Ожидаем.Что(Принята.Код, "КОНТРОЛЬ: версия принята: " + Принята.ТелоТекст).Равно(201);
	Ожидаем.Что(Ловушка.Всё(), "принятая версия на журнале двери не повторяется").Равно("");
	Ожидаем.Что(Служба.Всё(), "принятую версию называет служба публикации: " + Служба.Всё())
		.Содержит(Стенд.ИмяПакета);
	Ожидаем.Что(Служба.Всё(), "с конвейером, который её принёс").Содержит("ci:");
	Ожидаем.Что(Доверие.Всё(), "доверие конвейеру названо службой доверия: " + Доверие.Всё())
		.Содержит(Стенд.ИмяПакета);

КонецПроцедуры

// aud не должен совпадать ни по префиксу, ни по подстроке, ни с добавленным путём.
&Тест
Процедура AudПоЧастичномуСовпадениюНеПубликует() Экспорт

	Стенд = Конвейеры.ЗавестиСтенд("raudpart");
	Отказы = Новый Массив();

	Для Каждого Имя Из СтрРазделить("aud_наш_как_префикс,aud_наш_с_путём,aud_подстрока,aud_пустой", ",") Цикл
		Ответ = Конвейеры.ПушТокеном(Стенд, "1.1.0", Конвейеры.Токен(Имя));
		Если Ответ.Код = 403 Тогда
			Отказы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отказы.Количество(), "все четыре частичные формы aud отбиты: "
		+ СтрСоединить(Отказы, ", ")).Равно(4);

	Контроль = Конвейеры.ПушТокеном(Стенд, "1.1.0", Конвейеры.Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: точный aud публикует").Равно(201);

КонецПроцедуры

// Регистр и хвостовой слэш адреса инстанса совпадению мешать не должны.
&Тест
Процедура AudДругогоРегистраИСоСлэшемПубликует() Экспорт

	Стенд = Конвейеры.ЗавестиСтенд("raudcase");

	Ответ = Конвейеры.ПушТокеном(Стенд, "1.1.0", Конвейеры.Токен("aud_регистр_и_слэш"));
	Ожидаем.Что(Ответ.Код, "регистр и хвостовой слэш: " + Ответ.ТелоТекст).Равно(201);

КонецПроцедуры

#КонецОбласти

