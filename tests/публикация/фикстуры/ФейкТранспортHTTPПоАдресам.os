// Фейковый ТранспортHTTP с ответом НА КАЖДЫЙ АДРЕС: нужен там, где один сценарий читает
// несколько документов (discovery и JWKS). Незаданный адрес — сетевой сбой.

Перем Ответы;     // Соответствие: URL → Структура(Код, Тело)
Перем Счётчики;   // Соответствие: URL → Число
Перем Всего;
Перем ПоLocation; // Булево - просил ли хоть один вызывающий идти по перенаправлениям
Перем ЗаголовкиПоследнего; // Соответствие - заголовки последнего запроса
Перем ПоследнийSSL;      // Булево, Неопределено — ПроверятьSSL последнего вызова
Перем ПоследнийРедирект; // Булево, Неопределено — РазрешитьПеренаправление последнего вызова

// Задаёт ответ на запрос по адресу.
//
// Параметры:
//  URL - Строка - адрес.
//  Код - Число - код состояния.
//  Тело - Строка - тело ответа.
//
Процедура ПриАдресе(Знач URL, Знач Код, Знач Тело) Экспорт
	Ответы.Вставить(Строка(URL), Новый Структура("Код, Тело", Код, Строка(Тело)));
КонецПроцедуры

// Число обращений по адресу.
//
// Параметры:
//  URL - Строка - адрес.
//
// Возвращаемое значение:
//  Число - сколько раз транспорт спрашивали про этот адрес.
//
Функция Запросов(Знач URL) Экспорт
	Значение = Счётчики.Получить(Строка(URL));
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

// Общее число обращений.
//
// Возвращаемое значение:
//  Число - обращений за всё время жизни фейка.
//
Функция ВсегоЗапросов() Экспорт
	Возврат Всего;
КонецФункции

// Значение ПроверятьSSL последнего вызова: без него «ключи читаются по проверенному TLS»
// ничем не держится.
//
// Возвращаемое значение:
//  Булево, Неопределено - Неопределено, если вызовов не было.
//
Функция ПроверялСертификат() Экспорт
	Возврат ПоследнийSSL;
КонецФункции

// Значение РазрешитьПеренаправление последнего вызова.
//
// Возвращаемое значение:
//  Булево, Неопределено - Неопределено, если вызовов не было.
//
Функция РазрешалПеренаправление() Экспорт
	Возврат ПоследнийРедирект;
КонецФункции

// Просил ли хоть один вызывающий идти по перенаправлениям.
//
// Возвращаемое значение:
//  Булево - Истина, если хоть раз пришло РазрешитьПеренаправление = Истина.
//
Функция РедиректыРазрешалисьХотяБыРаз() Экспорт
	Возврат ПоLocation;
КонецФункции

// Заголовки последнего запроса: ими проверяется, что и как транспорт предъявил серверу.
//
// Возвращаемое значение:
//  Соответствие - заголовки; пустое соответствие, если запросов ещё не было.
//
Функция ЗаголовкиПоследнегоЗапроса() Экспорт
	Возврат ЗаголовкиПоследнего;
КонецФункции

// Контракт ТранспортHTTP.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//  РазрешитьПеренаправление - Булево - идти ли по Location (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код (Число), Заголовки (Соответствие), Данные (ДвоичныеДанные).
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина, Знач РазрешитьПеренаправление = Ложь) Экспорт

	Ключ = Строка(URL);
	Всего = Всего + 1;
	ПоследнийSSL = ПроверятьSSL;
	ПоследнийРедирект = РазрешитьПеренаправление;
	Счётчики.Вставить(Ключ, Запросов(Ключ) + 1);
	ПоLocation = ПоLocation ИЛИ (РазрешитьПеренаправление = Истина);
	ЗаголовкиПоследнего = ?(Заголовки = Неопределено, Новый Соответствие(), Заголовки);

	Ответ = Ответы.Получить(Ключ);
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "ФейкТранспортHTTPПоАдресам: ответ для " + Ключ + " не задан";
	КонецЕсли;

	Возврат Новый Структура("Код, Заголовки, Данные", Ответ.Код, Новый Соответствие(),
		ПолучитьДвоичныеДанныеИзСтроки(Ответ.Тело));

КонецФункции

// Контракт ТранспортHTTP: POST этому фейку не нужен, но бин обязан его иметь.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Тело - Строка - тело запроса.
//  Заголовки - Соответствие - заголовки (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Отправить(Знач URL, Знач Тело, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина) Экспорт
	Возврат Получить(URL, Заголовки, ТаймаутСек, ПроверятьSSL, Ложь);
КонецФункции

// Значение User-Agent (контракт ТранспортHTTP).
//
// Возвращаемое значение:
//  Строка - имя агента.
//
Функция ИмяАгента() Экспорт
	Возврат "OpenHubTest/1.0";
КонецФункции

&Прозвище("ТранспортHTTP")
&Желудь
Процедура ПриСозданииОбъекта()
	Ответы = Новый Соответствие();
	Счётчики = Новый Соответствие();
	Всего = 0;
	ПоLocation = Ложь;
	ЗаголовкиПоследнего = Новый Соответствие();
	ПоследнийSSL = Неопределено;
	ПоследнийРедирект = Неопределено;
КонецПроцедуры
