// id-token конвейера в форме JWS compact без настоящей подписи: достоверность решает
// ПроверяющийПодписиCI набора, а не содержимое токена.

// Собирает токен с клеймами доверенного конвейера; aud — «openhub».
//
// Параметры:
//  Издатель - Строка - клейм iss.
//  Репозиторий - Строка - клейм repository.
//  Конвейер - Строка - клейм job_workflow_ref; пусто — клейма нет.
//  Реф - Строка - клейм ref; пусто — клейма нет.
//  СекундДоИстечения - Число - через сколько секунд от текущего момента истекает exp.
//
// Возвращаемое значение:
//  Строка - заголовок, клеймы и подпись через точку, каждая часть в base64url.
//
Функция Собрать(Знач Издатель, Знач Репозиторий, Знач Конвейер, Знач Реф,
	Знач СекундДоИстечения) Экспорт

	Заголовок = Новый Структура("alg, typ, kid", "RS256", "JWT", "test-key");

	Сейчас = ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1);
	Клеймы = Новый Структура();
	Клеймы.Вставить("iss", Издатель);
	Клеймы.Вставить("aud", "openhub");
	Клеймы.Вставить("exp", Сейчас + СекундДоИстечения);
	Клеймы.Вставить("iat", Сейчас - 10);
	Клеймы.Вставить("repository", Репозиторий);
	Если ЗначениеЗаполнено(Конвейер) Тогда
		Клеймы.Вставить("job_workflow_ref", Конвейер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Реф) Тогда
		Клеймы.Вставить("ref", Реф);
	КонецЕсли;

	Возврат Base64URL(ВJSON(Заголовок)) + "." + Base64URL(ВJSON(Клеймы)) + "." + Base64URL("подпись");

КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция Base64URL(Знач Текст)
	Значение = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"));
	Значение = СтрЗаменить(СтрЗаменить(Значение, Символы.ПС, ""), Символы.ВК, "");
	Значение = СтрЗаменить(СтрЗаменить(Значение, "+", "-"), "/", "_");
	Пока СтрЗаканчиваетсяНа(Значение, "=") Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	Возврат Значение;
КонецФункции
