// Обёртка СервисПользователей, считающая обращения к нему: учётки отдаёт настоящая служба,
// счёт нужен там, где цена выдачи росла числом строк.

Перем Служба;   // СервисПользователей — настоящий источник учёток
Перем Счётчик;  // СчётчикОбращений — счёт обращений к службе

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Контракт СервисПользователей: пользователь по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Служба.ПоИдентификатору(Идентификатор);
КонецФункции

// Контракт СервисПользователей: учётки перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Пользователь; ненайденных в нём нет.
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт
	Счётчик.Отметить();
	Возврат Служба.ПоИдентификаторам(Идентификаторы);
КонецФункции

Процедура ПриСозданииОбъекта(Знач НастоящаяСлужба)
	Служба = НастоящаяСлужба;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
