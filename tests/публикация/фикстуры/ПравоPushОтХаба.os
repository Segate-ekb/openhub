// СервисПрав, у которого право push есть у каждого — даже у анонима — и выдано самим хабом.
// Прочие вопросы уходят настоящему сервису прав.

Перем Настоящий; // СервисПрав

// Источник права push: всегда право хаба.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - не используется.
//  Пул - Пул - не используется.
//  ИмяПакета - Строка - не используется.
//  Токен - Строка - не используется (необязательный, по умолчанию "").
//  Пакет - Пакет, Неопределено - не используется (необязательный, по умолчанию Неопределено).
//  ЛегасиGitHubВключён - Булево - не используется (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Строка - источник «хаб».
//
Функция ИсточникПраваPush(Знач Пользователь, Знач Пул, Знач ИмяПакета, Знач Токен = "",
	Знач Пакет = Неопределено, Знач ЛегасиGitHubВключён = Ложь) Экспорт
	Возврат Настоящий.ИсточникПраваХаб();
КонецФункции

// Источник «GitHub» — как у настоящего сервиса.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникПраваGitHub() Экспорт
	Возврат Настоящий.ИсточникПраваGitHub();
КонецФункции

// Видит ли пользователь пул — как у настоящего сервиса.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект.
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетЧитать(Знач Пользователь, Знач Пул) Экспорт
	Возврат Настоящий.МожетЧитать(Пользователь, Пул);
КонецФункции

// Описание объекта «пакет» — как у настоящего сервиса.
//
// Параметры:
//  Пакет - Пакет - пакет.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОбъектПакет(Знач Пакет) Экспорт
	Возврат Настоящий.ОбъектПакет(Пакет);
КонецФункции

Процедура ПриСозданииОбъекта(Знач СервисПрав)
	Настоящий = СервисПрав;
КонецПроцедуры
