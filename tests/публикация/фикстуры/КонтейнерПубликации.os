// Юнит-контейнер публикации: соседи и таблицы, без которых службы публикации не собираются,
// и сборка поделки на КоннекторInMemory. Классы публикации и фейки набор называет сам.

#Использовать autumn

Перем ПоискКлассов;   // фикстура КлассыСлоя
Перем КаталогМодулей;

// Подключает соседей публикации: базу, таблицы входа, прав, настроек и самой публикации,
// реестр с обязательными соседями, хранилище артефактов, допуск запроса и модель прав, службу
// учёток, события, аудит, настройки и основу. Служб публикации и фейков здесь нет.
//
// Параметры:
//  Таблицы - Строка - модули, чьи таблицы нужны сверх входа, прав, публикации и настроек,
//            через запятую (необязательный, по умолчанию "").
//
Процедура ПодключитьСоседей(Знач Таблицы = "") Экспорт

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(КаталогМодулей, "вход, права, публикация, настройки"
		+ ?(ЗначениеЗаполнено(Таблицы), ", " + Таблицы, ""));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить(КаталогМодулей);

	// допуск запроса и модель прав; ПроверяющийGitHub — контракт, его прозвище занимает фейк набора
	Для Каждого Имя Из СтрРазделить("СервисПрав, УчёткаПринципала, ВердиктГварда, СервисГрупп,"
		+ " СервисПравДоступа, ПроверяющийGitHub, СверкаСекретов, СервисТокенов, ГейтТокена,"
		+ " ГвардКлюча, ДопускПринципала", ",") Цикл
		ПоискКлассов.Подключить(КаталогМодулей, СокрЛП(Имя));
	КонецЦикла;
	ПодключитьСлужбуУчёток();

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"));
	ПоискКлассов.ПодключитьРеализации(КаталогМодулей, "ИменаОбъектовАудита");
	ПоискКлассов.Подключить(КаталогМодулей, "ГотовностьХаба");

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	РеестрНастроекХаба.ПодключитьКлассы(ПоискКлассов, КаталогМодулей);
	Для Каждого Имя Из СтрРазделить("ВидыПроверок, ИменаПеременныхОкружения, РеестрНастроек,"
		+ " СервисНастроек, ВалидаторНастроек", ",") Цикл
		ПоискКлассов.Подключить(КаталогНастроек, СокрЛП(Имя));
	КонецЦикла;

КонецПроцедуры

// Подключает службу учёток вместе с её собственными зависимостями из входа.
//
Процедура ПодключитьСлужбуУчёток() Экспорт
	Для Каждого Имя Из СтрРазделить("НормализаторУчётки, ПолитикаПароля, ОтказыУчётки, АдресУчётки,"
		+ " ЛетописьУчёток, СервисПользователей", ",") Цикл
		ПоискКлассов.Подключить(КаталогМодулей, СокрЛП(Имя));
	КонецЦикла;
КонецПроцедуры

// Подключает классы публикации по именам.
//
// Параметры:
//  Имена - Строка - имена классов модуля публикации через запятую.
//
Процедура ПодключитьПубликацию(Знач Имена) Экспорт

	КаталогПубликации = ОбъединитьПути(КаталогМодулей, "публикация", "Классы");
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		ПоискКлассов.Подключить(КаталогПубликации, СокрЛП(Имя));
	КонецЦикла;

КонецПроцедуры

// Подключает то, что нужно точке маршрута push сверх службы: сессии и перехватчик
// аутентификации, таймауты исходящего HTTP для транспорта ключей.
//
Процедура ПодключитьДверьПуша() Экспорт
	Для Каждого Имя Из СтрРазделить("ХранилищеСессийБД, СлужбаСессий, ПерехватчикАутентификации,"
		+ " ТаймаутыHTTP", ",") Цикл
		ПоискКлассов.Подключить(КаталогМодулей, СокрЛП(Имя));
	КонецЦикла;
КонецПроцедуры

// Точка маршрута push на собранном контейнере. Контроллер подключается типом после сборки:
// winow в юнит-контейнере нет, и ОСень не должна видеть его аннотацию.
//
// Параметры:
//  Поделка - Поделка - собранный контейнер.
//  Лог - Лог - лог контроллера: инъекция &Лог до объекта, созданного Новый, не доезжает.
//
// Возвращаемое значение:
//  КонтроллерПубликации - контроллер с пустыми куками.
//
Функция КонтроллерПуша(Знач Поделка, Знач Лог) Экспорт

	РеестрФикстур.Подключить("КукиЗаглушка");
	ПоискКлассов.Подключить(КаталогМодулей, "ОбезличиваниеЖурнала");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "публикация", "Классы"), "КонтроллерПубликации");

	Возврат Новый КонтроллерПубликации(Поделка.НайтиЖелудь("СервисПубликации"),
		Поделка.НайтиЖелудь("ПерехватчикАутентификации"), Новый КукиЗаглушка(),
		Поделка.НайтиЖелудь("СервисПулов"), Лог, Поделка.НайтиЖелудь("ЗаголовкиHTTP"));

КонецФункции

// Отдельный СервисПулов со своим значением опции личных пулов: опция читается в конструкторе,
// и общее состояние контейнера не трогается.
//
// Параметры:
//  Поделка - Поделка - собранный контейнер.
//  ЛичныеРазрешены - Булево - значение oshub.pools.personal_enabled.
//
// Возвращаемое значение:
//  СервисПулов - служба пулов на желудях контейнера.
//
Функция СервисПуловСОпциейЛичныхПулов(Знач Поделка, Знач ЛичныеРазрешены) Экспорт

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	Резолвер = Новый НастройкиЗаглушка();
	Резолвер.Задать("oshub.pools.personal_enabled", ЛичныеРазрешены);
	Настройки = Новый Массив();
	Настройки.Добавить(Резолвер);

	Возврат Новый СервисПулов(
		Поделка.НайтиЖелудь("ХранилищеПулов"), Поделка.НайтиЖелудь("УборкаПула"),
		Поделка.НайтиЖелудь("ПравилаИменования"), Поделка.НайтиЖелудь("ПространствоИмён"),
		Поделка.НайтиЖелудь("СервисАпстримовПула"), Поделка.НайтиЖелудь("КвотаПула"),
		Поделка.НайтиЖелудь("УчётОбъёмаПула"), Новый Массив(), Новый Массив(), Новый Массив(),
		Поделка.НайтиЖелудь("ИмяОбъектаАудита"), Поделка.НайтиЖелудь("СобытиеАудита"), Настройки);

КонецФункции

// Собирает и запускает поделку на КоннекторInMemory с хранилищем артефактов в каталоге.
//
// Параметры:
//  ИмяБазы - Строка - строка соединения InMemory: у набора своя база.
//  КореньХранилища - Строка - каталог хранилища артефактов.
//  Детальки - Соответствие, Неопределено - детальки сверх базы и хранилища
//             (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Поделка - запущенный контейнер.
//
Функция Собрать(Знач ИмяБазы, Знач КореньХранилища, Знач Детальки = Неопределено) Экспорт

	Все = Новый Соответствие();
	Все.Вставить("oshub.storage.root", КореньХранилища);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", ИмяБазы);
	Все.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Если Детальки <> Неопределено Тогда
		Для Каждого КиЗ Из Детальки Цикл
			Все.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Все);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;

КонецФункции

Процедура ПриСозданииОбъекта(Знач _ПоискКлассов, Знач _КаталогМодулей)
	ПоискКлассов = _ПоискКлассов;
	КаталогМодулей = _КаталогМодулей;
КонецПроцедуры
