	Ожидаем.Что(Результат.Успех).ЭтоЛожь();
	Ожидаем.Что(Результат.Код, "не .ospx → 400").Равно(400);

КонецПроцедуры

// «Пакет 40 МиБ при пределе 25 МиБ», а не «слишком большой файл»: скрипт конвейера читает
// предел, его ключ и своё число полями и решает сам — пересобрать или просить поднять предел.
&Тест
Процедура ОтказПоПределуЗагрузкиНазываетПределЧислами() Экспорт

	Ключ = "oshub.publish.max_upload_bytes";

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("bigone");
	Данные = Публикация.ДанныеOspx(ИмяПакета, "1.0.0");

	// предел — bootstrap-настройка, доменным API её не подвинуть, поэтому меньшее число
	// приезжает заглушкой: гейт размера стоит до всех остальных чтений настроек
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать(Ключ, Данные.Размер() - 1);

	Результат = СервисПубликацииСНастройками(Настройки).Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Польз, "");

	Ожидаем.Что(Результат.Успех, "загрузка сверх предела отвергнута").ЭтоЛожь();
	Ожидаем.Что(Результат.Код, "предел запроса → 413").Равно(413);
	Ожидаем.Что(Результат.Подробности <> Неопределено, "отказ несёт подробности").ЭтоИстина();
	Ожидаем.Что(Результат.Подробности.limit, "назван ключ предела").Равно(Ключ);
	Ожидаем.Что(Результат.Подробности.limit_bytes, "предел числом").Равно(Данные.Размер() - 1);
	Ожидаем.Что(Результат.Подробности.actual_bytes, "и число, которым он не пройден")
		.Равно(Данные.Размер());

КонецПроцедуры

// Тот же сервис с подменённым ядром прав; опознание владельца токена — желудь контейнера.
Функция ПубликацияСПравами(Знач СервисПрав)
	Возврат Новый СервисПубликации(
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Желудь("ПриёмВерсии"),
		Желудь("СервисМетокВерсий"), Желудь("ПравилаИменования"),
		Желудь("ХранилищеАртефактов"), Желудь("ЗаписьЗанятогоМеста"),
		СервисПрав, Желудь("ДопускПринципала"),
		Желудь("СервисПравДоступа"), Желудь("ИздательСобытий"),
		Желудь("СервисНастроек"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Неопределено, Неопределено, ЛогТестов(), , , , , Желудь("ОпознаниеGitHub"));
КонецФункции

// Тот же сервис, но с подменёнными настройками: остальные желуди — настоящие.
Функция СервисПубликацииСНастройками(Знач Настройки)
	Возврат Новый СервисПубликации(
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Желудь("ПриёмВерсии"),
		Желудь("СервисМетокВерсий"), Желудь("ПравилаИменования"),
		Желудь("ХранилищеАртефактов"), Желудь("ЗаписьЗанятогоМеста"),
		Желудь("СервисПрав"), Желудь("ДопускПринципала"),
		Желудь("СервисПравДоступа"), Желудь("ИздательСобытий"),
		Настройки, Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Желудь("СервисВходящих"), Желудь("СервисДоверияCI"), ЛогТестов());
КонецФункции

// Занятое имя ресурса — полем: скрипту достаточно его, чтобы переименовать и повторить.
&Тест
Процедура ОтказПоНенайденномуПулуНазываетИмяРесурса() Экспорт

	Польз = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("nopooldetails");
	Результат = Желудь("СервисПубликации").Опубликовать(
		"нет-такого-пула", Публикация.ДанныеOspx(ИмяПакета, "1.0.0"),
		СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Польз, "");

	Ожидаем.Что(Результат.Код).Равно(404);
	Ожидаем.Что(Результат.Подробности.pool, "названо имя пула, которого нет")
		.Равно("нет-такого-пула");

КонецПроцедуры

&Тест
Процедура ПушВProxyПулОтклонён() Экспорт

	// «прокси-пул» — обычный пул с выключенной публикацией и апстримом; гейт push — свойство пула
	Имя = УникальныеИмена.Имя("prx");
	Пулы = Желудь("СервисПулов");
	Прокси = Пулы.СоздатьПул(Имя, "custom", "public");
	Пулы.УстановитьПубликациюРазрешена(Прокси.Идентификатор, Ложь);
	Польз = Стенд.Учётка();

	ИмяПакета = УникальныеИмена.Имя("p");
	Данные = Публикация.ДанныеOspx(ИмяПакета, "1.0.0");
	Результат = Желудь("СервисПубликации").Опубликовать(
		Прокси.Имя, Данные, СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Польз, "");
	Ожидаем.Что(Результат.Успех, "push в proxy-пул недопустим").ЭтоЛожь();
	Ожидаем.Что(Результат.Код).Равно(409);

КонецПроцедуры

// Номер версии не пересекается с именем тега: спецификацию «пакет@1.4» резолв читает сначала
// точной версией, и принятая под таким номером версия навсегда затенила бы тег «1.4». Отказ
// доезжает до клиента причиной, а артефакт откатывается — файла без записи не остаётся.
&Тест
Процедура ПушВерсииСИменемСуществующегоТегаОтклонён() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("tagclash");

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.4.0", "stable", "").Код,
		"первая версия пакета публикуется").Равно(201);
	Желудь("СервисТегов").ПереместитьТег(НайтиПакет(Пул, ИмяПакета).Идентификатор, "1.4", "1.4.0");

	Отказ = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.4", "stable", "");
	Ожидаем.Что(Отказ.Успех, "версия с именем существующего тега отклонена").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Строка(Отказ.Сообщение), "как имя тега") > 0,
		"причина названа словами: " + Отказ.Сообщение).ЭтоИстина();

	Ожидаем.Что(НайтиВерсию(Пул, ИмяПакета, "1.4"), "версия не создана").Равно(Неопределено);
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Существует(
		Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.4")), "артефакт откачен").ЭтоЛожь();

	// КОНТРОЛЬ: соседний номер, которым тег не назван, публикуется как обычно
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.5.0", "stable", "").Код,
		"свободный номер публикуется").Равно(201);

КонецПроцедуры

// Поломка приёма случается УЖЕ ПОСЛЕ записи артефакта, и тогда за хабом остаются и файл,
// и байты в счётчике пула: место утекает молча, а видно это только сверке объёмов. Ядро приёма
// подменено падающим — иначе на этот путь снаружи не попасть: отказы по правилу дверь
// спрашивает до записи.
&Тест
Процедура ПоломкаПриёмаНеОставляетНиАртефактаНиБайтов() Экспорт

	РеестрФикстур.Подключить("ФейкПриёмаПадающий");

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("broken");
	ТекстСбоя = "приём версии сорвался (проверка отката)";

	Сервис = Новый СервисПубликации(
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Новый ФейкПриёмаПадающий(ТекстСбоя),
		Желудь("СервисМетокВерсий"), Желудь("ПравилаИменования"),
		Желудь("ХранилищеАртефактов"), Желудь("ЗаписьЗанятогоМеста"),
		Желудь("СервисПрав"), Желудь("ДопускПринципала"),
		Желудь("СервисПравДоступа"), Желудь("ИздательСобытий"),
		Желудь("СервисНастроек"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Желудь("СервисВходящих"), Желудь("СервисДоверияCI"), ЛогТестов());

	Итог = Сервис.Опубликовать(Пул.Имя, Публикация.ДанныеOspx(ИмяПакета, "1.0.0"),
		ИмяПакета + "-1.0.0.ospx", "stable", Польз, "");

	Ожидаем.Что(Итог.Успех, "поломка приёма — не публикация").ЭтоЛожь();
	Ожидаем.Что(Итог.Код, "поломка → 500, а не 400: чинить публикатору нечего").Равно(500);
	Ожидаем.Что(СтрНайти(Строка(Итог.Сообщение), ТекстСбоя),
		"внутренности наружу не идут: " + Итог.Сообщение).Равно(0);

	Ожидаем.Что(Желудь("ХранилищеАртефактов").Существует(
		Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.0.0")), "артефакт откачен").ЭтоЛожь();
	Ожидаем.Что(ЗанятоПулом(Пул), "байты сорвавшейся публикации в счётчике не осели").Равно(0);
	Ожидаем.Что(Желудь("УчётОбъёмаПула").Пересчитать(ЗаписьПула(Пул)),
		"и на диске их тоже нет").Равно(0);

КонецПроцедуры

// Правила самой строки версии — тоже отказ ПО ПРАВИЛУ, и публикатор обязан узнать, что чинить.
// Спрашиваются они у приёма тем же вопросом, что и столкновение с тегом: разойдись они, и «01.2.3»
// вернулся бы клиенту как «внутренняя ошибка хаба», по которой чинить нечего.
&Тест
Процедура ПушНеканоническойВерсииНазываетПричину() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("zeroes");

	Отказ = Публикация.Отправить(Пул, Польз, ИмяПакета, "01.2.3", "stable", "");

	Ожидаем.Что(Отказ.Успех, "версия с ведущими нулями отклонена").ЭтоЛожь();
	Ожидаем.Что(Отказ.Код, "отказ по правилу → 400, а не 500").Равно(400);
	Ожидаем.Что(СтрНайти(Строка(Отказ.Сообщение), "ведущие нули") > 0,
		"причина названа словами: " + Отказ.Сообщение).ЭтоИстина();

	// КОНТРОЛЬ: каноническая соседка тем же путём публикуется
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.2.3", "stable", "").Код,
		"каноническая запись принимается").Равно(201);

КонецПроцедуры

&Тест
Процедура ПушВПулСЗапрещённойПубликациейОтклонён() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("nopub");

	// пока публикация разрешена (дефолт «истина») — push проходит
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "").Код,
		"дефолт «публикация разрешена» — push проходит").Равно(201);

	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Ложь);

	Отказ = Публикация.Отправить(Пул, Польз, ИмяПакета, "2.0.0", "stable", "");
	Ожидаем.Что(Отказ.Успех, "push в пул с запрещённой публикацией отклонён").ЭтоЛожь();
	Ожидаем.Что(Отказ.Код, "запрет публикации → 409").Равно(409);

	// отказ — ДО приёма артефакта: ни версии в реестре, ни файла в хранилище
	Ожидаем.Что(НайтиВерсию(Пул, ИмяПакета, "2.0.0"), "версия не создана").Равно(Неопределено);
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Существует(
		Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "2.0.0")), "артефакт не сохранён").ЭтоЛожь();

	// флаг возвращается — публикация снова принимается
	Желудь("СервисПулов").УстановитьПубликациюРазрешена(Пул.Идентификатор, Истина);
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "2.0.0", "stable", "").Код,
		"после возврата флага push снова принимается").Равно(201);

КонецПроцедуры

&Тест
Процедура ПушВНесуществующийПул404() Экспорт
	Польз = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("nopool");
