&Тест
Процедура СвободноеИмяБезПраваУходитВоВходящие() Экспорт

	Перем Найдена;

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("inbox");

	Результат = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Результат.Код, "свободное имя без прав → 202 во «входящие»").Равно(202);
	Ожидаем.Что(Результат.Успех, "202 — успех приёма, opm его принимает").ЭтоИстина();
	Ожидаем.Что(Результат.Сообщение, "ответ объясняет ситуацию").Содержит("входящие");

	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета) = Неопределено,
		"версия не опубликована и имя не занято").ЭтоИстина();

	Найдена = Ложь;
	Для Каждого Заявка Из Желудь("СервисВходящих").ОжидающиеПула(Пул.Идентификатор) Цикл
		Если Заявка.ИмяПакета = ИмяПакета Тогда
			Найдена = Истина;
			Ожидаем.Что(Заявка.ЗаявительИдентификатор, "заявитель записан").Равно(Польз.Идентификатор);
			Ожидаем.Что(Заявка.Версия, "версия записана").Равно("1.0.0");
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Найдена, "заявка видна во «входящих» пула").ЭтоИстина();

КонецПроцедуры

