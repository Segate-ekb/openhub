КонецПроцедуры

&Тест
Процедура ГрантСозданияИTOFUВладение() Экспорт

	Права = Желудь("СервисПрав");
	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.ГрантСлужбой(Польз, Права.ОбъектПул(Пул),
		Стенд.Действия(Истина, Ложь, Ложь, Ложь));

	ИмяПакета = УникальныеИмена.Имя("tofu");
	Результат = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Результат.Успех, "грант создание разрешает первое имя: " + Результат.Сообщение).ЭтоИстина();

	// TOFU: публикатор стал владельцем пакета (получил удаление на пакет, чего у него не было)
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Ожидаем.Что(Права.РазрешеноДействие(Польз, "удаление", Права.ОбъектПакет(Пакет)),
		"TOFU дал владельцу удаление на пакет").ЭтоИстина();

КонецПроцедуры

// Владение по первой публикации одно во всех пулах: основной пул отдельного режима не имеет.
&Тест
Процедура ВДефолтномПулеTOFUВладениеТоЖе() Экспорт

	Права = Желудь("СервисПрав");
	Public = Засев.ОсновнойПул();
	Польз = Стенд.Учётка();
	Стенд.ГрантСлужбой(Польз, Права.ОбъектПул(Public),
		Стенд.Действия(Истина, Истина, Ложь, Ложь));
	Ожидаем.Что(Права.РазрешеноДействие(Польз, "удаление", Права.ОбъектПул(Public)),
		"КОНТРОЛЬ: права удалять в пуле у публикатора нет").ЭтоЛожь();

	ИмяПакета = УникальныеИмена.Имя("pubname");
	Результат = Публикация.Отправить(Public, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Результат.Успех, "с грантом можно опубликовать в основной пул").ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Public.Идентификатор, ИмяПакета);
	Ожидаем.Что(Права.РольНаОбъекте(Польз, Права.ОбъектПакет(Пакет)),
		"основной пул: первая публикация делает публикатора мейнтейнером имени").Равно(Права.РольМейнтейнер());

КонецПроцедуры

// Суперправо администратора — надстройка: имя, заведённое им в основном пуле, остаётся за ним
// и после снятия роли хаба — следующие версии он публикует своим правом на пакет.
&Тест
Процедура ИмяЗаведённоеАдминомОстаётсяЗаНимПослеСнятияРоли() Экспорт

	Права = Желудь("СервисПрав");
	Public = Засев.ОсновнойПул();
	Админ = Стенд.Учётка("admin");

	ИмяПакета = УникальныеИмена.Имя("adminname");
	Ожидаем.Что(Публикация.Отправить(Public, Админ, ИмяПакета, "1.0.0", "stable", "").Успех,
		"администратор заводит имя в основном пуле").ЭтоИстина();

	Админ.РольХаба = "user";
	Админ.Сохранить();
	Ожидаем.Что(Права.ПользовательАдмин(Админ), "КОНТРОЛЬ: роль администратора снята").ЭтоЛожь();

	Следующая = Публикация.Отправить(Public, Админ, ИмяПакета, "1.0.1", "stable", "");
	Ожидаем.Что(Следующая.Успех, "следующую версию своего пакета он публикует: " + Следующая.Сообщение)
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЛегасиGitHubТолькоВДефолтномПулеИПоОпцииХаба() Экспорт

	Настройки = Желудь("СервисНастроек");
	Дефолтный = Засев.ОсновнойПул();
	ИмяПакета = УникальныеИмена.Имя("ghpkg");
	Токен = "gh-token-xyz";
	Желудь("ПроверяющийGitHub").Разрешить(Токен, ИмяПакета);

	Попытка

		// 1. опция хаба выключена (дефолт) — write-доступ на GitHub права не даёт
		Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);
		Отказ = Публикация.Отправить(Дефолтный, Неопределено, ИмяПакета, "1.0.0", "stable", Токен);
		Ожидаем.Что(Отказ.Успех, "опция хаба выключена → легаси-путь закрыт").ЭтоЛожь();
		Ожидаем.Что(Отказ.Код, "нет принципала и легаси выключен → 401").Равно(401);

		// 2. КОНТРОЛЬ, отличающийся РОВНО опцией: включаем — тот же push проходит
		Настройки.Установить("oshub.publish.github_legacy", Истина, Неопределено);
		Успех = Публикация.Отправить(Дефолтный, Неопределено, ИмяПакета, "1.0.0", "stable", Токен);
		Ожидаем.Что(Успех.Успех, "опция включена + дефолтный пул → push: " + Успех.Сообщение).ЭтоИстина();

		// 3. НЕ дефолтный пул — отказ даже при включённой опции и старом флаге пула
		Обычный = Засев.ПулСервисом();
		Желудь("СервисПулов").УстановитьФлаг(Обычный.Идентификатор, "github_compat", Истина);
		Обычный = Желудь("СервисПулов").ПулПоИдентификатору(Обычный.Идентификатор);
		ВтороеИмя = УникальныеИмена.Имя("ghpkg2");
		Желудь("ПроверяющийGitHub").Разрешить(Токен, ВтороеИмя);
		ВнеДефолта = Публикация.Отправить(Обычный, Неопределено, ВтороеИмя, "1.0.0", "stable", Токен);
		Ожидаем.Что(ВнеДефолта.Успех,
			"легаси-путь вне дефолтного пула закрыт даже со старым флагом github_compat").ЭтоЛожь();

	Исключение
		Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);
		ВызватьИсключение;
	КонецПопытки;

	Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);

КонецПроцедуры

// Легаси-токен GitHub подписывает публикацию логином владельца со слов самого GitHub:
// журнал и уведомления читают одно и то же «кто», и символов токена в нём нет.
&Тест
Процедура ЛегасиТокенGitHubПодписываетПубликациюЛогиномGitHub() Экспорт

	Дефолтный = Засев.ОсновнойПул();
	ИмяПакета = УникальныеИмена.Имя("ghwho");
	Токен = "github_pat_11WHOAMI0001";
	Желудь("ПроверяющийGitHub").Разрешить(Токен, ИмяПакета);
	Транспорт().УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки("{""login"":""octocat""}", "UTF-8"));

	Результат = ОпубликоватьПриЛегасиGitHub(Дефолтный, Неопределено, ИмяПакета, Токен);

	Ожидаем.Что(Результат.Успех, "легаси-токен публикует: " + Результат.Сообщение).ЭтоИстина();
	Ожидаем.Что(КтоВЖурнале(Дефолтный, ИмяПакета), "кто — логин владельца токена на GitHub")
		.Равно("github:octocat");
	Ожидаем.Что(Транспорт().ЗаголовокПоследний("Authorization"), "GitHub спрошен тем же токеном")
		.Равно("token " + Токен);

КонецПроцедуры

// Опознание подписывает публикацию, а не решает её судьбу: GitHub не ответил или не признал
// токен — публикация состоялась, а вместо логина метка без единого символа токена.
&Тест
Процедура НеопознанныйВладелецТокенаНеМешаетПубликации() Экспорт

	Дефолтный = Засев.ОсновнойПул();
	Токен = "github_pat_11WHOAMI0002";

	БезСети = УникальныеИмена.Имя("ghoff");
	Желудь("ПроверяющийGitHub").Разрешить(Токен, БезСети);
	Транспорт().ЭмулироватьОффлайн();
	Результат = ОпубликоватьПриЛегасиGitHub(Дефолтный, Неопределено, БезСети, Токен);

	Ожидаем.Что(Результат.Код, "GitHub недоступен, а версия принята: " + Результат.Сообщение).Равно(201);
	Ожидаем.Что(КтоВЖурнале(Дефолтный, БезСети), "метка вместо логина").Равно("github:(не опознан)");

	Отказано = УникальныеИмена.Имя("gh401");
	Желудь("ПроверяющийGitHub").Разрешить(Токен, Отказано);
	Транспорт().УстановитьОтвет(401, ПолучитьДвоичныеДанныеИзСтроки("{""login"":""octocat""}", "UTF-8"));
	Результат = ОпубликоватьПриЛегасиGitHub(Дефолтный, Неопределено, Отказано, Токен);

	Ожидаем.Что(Результат.Код, "GitHub отказал в профиле, а версия принята: " + Результат.Сообщение)
		.Равно(201);
	Ожидаем.Что(КтоВЖурнале(Дефолтный, Отказано), "логин из отказа не берётся")
		.Равно("github:(не опознан)");

КонецПроцедуры

// Учётка хаба называется своим логином, даже когда её пропустил легаси-путь: о владельце
// токена GitHub при этом не спрашивается.
&Тест
Процедура УчёткаХабаПодписываетПубликациюСвоимЛогиномБезОпознания() Экспорт

	Дефолтный = Засев.ОсновнойПул();
	Польз = Стенд.Учётка();
	ИмяПакета = УникальныеИмена.Имя("ghown");
	Токен = "github_pat_11WHOAMI0003";
	Желудь("ПроверяющийGitHub").Разрешить(Токен, ИмяПакета);
	Транспорт().УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки("{""login"":""octocat""}", "UTF-8"));
	ВызововДо = Транспорт().КоличествоВызовов();

	Результат = ОпубликоватьПриЛегасиGitHub(Дефолтный, Польз, ИмяПакета, Токен);

	Ожидаем.Что(Результат.Успех, "учётка без роли прошла легаси-путём: " + Результат.Сообщение).ЭтоИстина();
	Ожидаем.Что(КтоВЖурнале(Дефолтный, ИмяПакета), "кто — логин учётки хаба").Равно(Польз.Логин);
	Ожидаем.Что(Транспорт().КоличествоВызовов(), "GitHub о владельце токена не спрошен").Равно(ВызововДо);

КонецПроцедуры

// Токен из заголовка уходит в GitHub только тогда, когда право дал GitHub. Право, выданное
// хабом, — даже анониму и при включённом легаси-пути — опознания владельца не вызывает:
// в заголовке может лежать вовсе не GitHub-токен.
&Тест
Процедура ПравоОтХабаНеОтправляетТокенВGitHub() Экспорт

	Дефолтный = Засев.ОсновнойПул();
	ИмяПакета = УникальныеИмена.Имя("hubright");
	Токен = "не-github-секрет-0001";
	Транспорт().УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки("{""login"":""octocat""}", "UTF-8"));
	ВызововДо = Транспорт().КоличествоВызовов();
	Сервис = ПубликацияСПравами(Новый ПравоPushОтХаба(Желудь("СервисПрав")));

	Настройки = Желудь("СервисНастроек");
	Настройки.Установить("oshub.publish.github_legacy", Истина, Неопределено);
	Попытка
		Результат = Сервис.Опубликовать(Дефолтный.Имя, Публикация.ДанныеOspx(ИмяПакета, "1.0.0"),
			ИмяПакета + "-1.0.0.ospx", "stable", Неопределено, Токен);
	Исключение
		Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);

	Ожидаем.Что(Результат.Успех, "право хаба публикует: " + Результат.Сообщение).ЭтоИстина();
	Ожидаем.Что(Транспорт().КоличествоВызовов(), "токен в GitHub не отправлен").Равно(ВызововДо);
	Ожидаем.Что(КтоВЖурнале(Дефолтный, ИмяПакета), "кто — без GitHub").Равно("anonymous");

КонецПроцедуры

&Тест
Процедура НедопустимоеРасширениеОтклонено() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

