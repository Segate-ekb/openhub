		"нет-такого-пула", Данные, СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Польз, "");
	Ожидаем.Что(Результат.Успех).ЭтоЛожь();
	Ожидаем.Что(Результат.Код).Равно(404);
КонецПроцедуры

// --- аудит: публикация пишет журнал от имени публикатора ---

&Тест
Процедура АудитЗаписываетсяПриПубликации() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("audited");

	Результат = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Результат.Успех, "публикация прошла: " + Результат.Сообщение).ЭтоИстина();

	Запись = НайтиЗаписьАудита(СтрШаблон("%1/%2@1.0.0", Пул.Имя, ИмяПакета));
	Ожидаем.Что(Запись, "по факту публикации создана запись аудита").Существует();
	Ожидаем.Что(Запись.Кто, "принципал аудита = логин публикатора").Равно(Польз.Логин);
	Ожидаем.Что(Запись.Действие, "действие — публикация версии").Равно("публикация.версии");
	Ожидаем.Что(ДеталиЗаписи(Запись).Получить("пакет"),
		"детали называют пакет: " + Строка(Запись.Детали)).Равно(ИмяПакета);

КонецПроцедуры

&Тест
Процедура ПерезаписьПререлизаПишетДействиеПерезаписи() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("reaudit");

	Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "");
	Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "", Истина); // замена номера

	Запись = НайтиЗаписьАудита(СтрШаблон("%1/%2@1.0.0-rc.1", Пул.Имя, ИмяПакета));
	Ожидаем.Что(Запись, "запись аудита есть").Существует();
	Ожидаем.Что(Запись.Действие, "последняя операция — перезапись версии").Равно("перезапись.версии");

КонецПроцедуры

// Назначение основного пула было ЕДИНСТВЕННЫМ производителем мимо формата и поведенческого
// теста не имело вовсе: скан исходников обходится строкой, которая называет форматтер и тут
// же портит его вывод, — а записанное значение не проверял никто.
&Тест
Процедура НазначениеОсновногоПулаПишетАдресПулаВЖурнал() Экспорт

	Пул = Засев.ПулСервисом();
	Имена = Желудь("ИмяОбъектаАудита");

	Желудь("СервисПулов").НазначитьПулПоУмолчанию(Пул.Идентификатор, "root");

	Записи = ЖурналАудита().ПоОбъекту(Имена.ПулПоИмени(Пул.Имя));
	Ожидаем.Что(Записи.Количество() > 0,
		"назначение основного пула записано по адресу пула").ЭтоИстина();
	Ожидаем.Что(Строка(Записи[0].Действие), "действие").Равно("пул.основной.назначен");
	Ожидаем.Что(Строка(Записи[0].Кто), "принципал").Равно("root");
	Ожидаем.Что(Имена.ЭтоАдресЖурнала(Строка(Записи[0].Объект)),
		"адрес держит форму журнала: " + Строка(Записи[0].Объект)).ЭтоИстина();
	Ожидаем.Что(Строка(Записи[0].Объект), "и это именно адрес пула, а не голое имя")
		.Равно("пул/" + Пул.Имя);

КонецПроцедуры

// Отзыв версии — операция, ради которой журнал и заводят: до правки летопись публиковала
// событие без поля Объект, а служба аудита на него не была подписана, и путь отзыва
// не оставлял в журнале ни строки.
&Тест
Процедура ОтзывИВосстановлениеВерсииПопадаютВЖурнал() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("yanked");

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "2.0.0", "stable", "").Успех, "публикация").ЭтоИстина();
	Пакет = НайтиПакет(Пул, ИмяПакета);
	Адрес = СтрШаблон("%1/%2@2.0.0", Пул.Имя, ИмяПакета);

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "2.0.0", Истина, Польз.Логин);

	Отзыв = НайтиЗаписьАудита(Адрес);
	Ожидаем.Что(Отзыв, "отзыв версии записан в журнал").Существует();
	Ожидаем.Что(Отзыв.Действие, "действие отзыва").Равно("версия.отозвана");
	Ожидаем.Что(Отзыв.Кто, "принципал отзыва").Равно(Польз.Логин);
	Ожидаем.Что(ДеталиЗаписи(Отзыв).Получить("версия"),
		"детали называют версию: " + Строка(Отзыв.Детали)).Равно("2.0.0");

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "2.0.0", Ложь, Польз.Логин);

	Возврат_ = НайтиЗаписьАудита(Адрес);
	Ожидаем.Что(Возврат_.Действие, "восстановление — своё действие").Равно("версия.восстановлена");
	Ожидаем.Что(ЖурналАудита().ПоОбъекту(Адрес).Количество(),
		"публикация, отзыв и восстановление — три строки об одном адресе").Равно(3);

КонецПроцедуры

// --- перенос манифеста в реестр: зависимости версии и карточка пакета ---

&Тест
Процедура ЗависимостиМанифестаПопадаютВРеестр() Экспорт

	// зависимости из манифеста опубликованного пакета ложатся в реестр: вкладка «Зависимости»
	// и обратный граф строятся из них
	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("deps");

	Манифест = ПервыйМанифест(ИмяПакета, "1.0.0");
	Манифест.ДобавитьЗависимость("json", "1.0.0", "2.0.0");
	Манифест.ДобавитьЗависимость("asserts", "1.5.0", "", Истина);

	Результат = Публикация.ОтправитьМанифест(Пул, Польз, Манифест);
	Ожидаем.Что(Результат.Успех, "публикация с зависимостями: " + Результат.Сообщение).ЭтоИстина();

	Версия = НайтиВерсию(Пул, ИмяПакета, "1.0.0");
	Состав = ЗависимостиВерсии(Версия);
	Ожидаем.Что(Состав.Количество(), "обе зависимости манифеста проиндексированы").Равно(2);

	Обычная = НайтиЗависимость(Состав, "json");
	Ожидаем.Что(Обычная, "зависимость json").Существует();
	Ожидаем.Что(Обычная.ВерсияМин, "минимальная версия из манифеста").Равно("1.0.0");
	Ожидаем.Что(Обычная.ВерсияМакс, "максимальная версия из манифеста").Равно("2.0.0");
	Ожидаем.Что(Обычная.ДляРазработки = Истина, "обычная зависимость признаком не помечена").ЭтоЛожь();

	Разработочная = НайтиЗависимость(Состав, "asserts");
	Ожидаем.Что(Разработочная, "зависимость asserts").Существует();
	Ожидаем.Что(Разработочная.ДляРазработки = Истина, "dev-зависимость помечена признаком").ЭтоИстина();
	Ожидаем.Что(Разработочная.ВерсияМакс, "максимум не задан — пустая строка").Равно("");

	// ровно те два запроса, которыми живёт вкладка зависимостей (КонтроллерПакета)
	Ожидаем.Что(НайтиПоВерсии(КтоЗависитОт("json"), Версия.Идентификатор),
		"обратный граф видит опубликованную версию").Существует();

КонецПроцедуры

&Тест
Процедура ПерезаписьВерсииЗаменяетСоставЗависимостей() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("redeps");

	Первый = ПервыйМанифест(ИмяПакета, "1.0.0-rc.1");
	Первый.ДобавитьЗависимость("json", "1.0.0");
	Первый.ДобавитьЗависимость("logos", "1.7.1");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Первый).Успех, "первая публикация пререлиза").ЭтоИстина();

	Второй = НовыйМанифест(ИмяПакета, "1.0.0-rc.1");
	Второй.ДобавитьЗависимость("logos", "2.0.0");
	Второй.ДобавитьЗависимость("winow", "0.5.0");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Второй, "stable", Истина).Код,
		"замена номера форсом → 200").Равно(200);

	Версия = НайтиВерсию(Пул, ИмяПакета, "1.0.0-rc.1");
	Состав = ЗависимостиВерсии(Версия);
	Ожидаем.Что(Состав.Количество(),
		"состав версии — ровно последний манифест: без дублей и без хвостов").Равно(2);
	Ожидаем.Что(НайтиЗависимость(Состав, "winow"), "новая зависимость записана").Существует();
	Ожидаем.Что(НайтиЗависимость(Состав, "logos").ВерсияМин, "диапазон обновился").Равно("2.0.0");
	Ожидаем.Что(НайтиЗависимость(Состав, "json"), "снятая зависимость удалена").Равно(Неопределено);

	// и обратный граф снятой зависимости больше не показывает эту версию
	Ожидаем.Что(НайтиПоВерсии(КтоЗависитОт("json"), Версия.Идентификатор),
		"висячей строки в обратном графе не осталось").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура МанифестБезЗависимостейСоставаНеОставляет() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

	// граничный случай: зависимостей в манифесте нет вовсе
	Пустой = УникальныеИмена.Имя("nodeps");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, ПервыйМанифест(Пустой, "1.0.0")).Успех,
		"пакет без зависимостей публикуется").ЭтоИстина();
	Ожидаем.Что(ЗависимостиВерсии(НайтиВерсию(Пул, Пустой, "1.0.0")).Количество(),
		"строк зависимостей не появилось").Равно(0);

	// и обратный случай: манифест перезаписи растерял зависимости — состав очищается
	Убывающий = УникальныеИмена.Имя("dropdeps");
	СЗависимостью = ПервыйМанифест(Убывающий, "1.0.0-rc.1");
	СЗависимостью.ДобавитьЗависимость("json", "1.0.0");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, СЗависимостью).Успех, "первая публикация").ЭтоИстина();

	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, НовыйМанифест(Убывающий, "1.0.0-rc.1"), "stable", Истина).Код,
		"замена манифестом без зависимостей").Равно(200);
	Ожидаем.Что(ЗависимостиВерсии(НайтиВерсию(Пул, Убывающий, "1.0.0-rc.1")).Количество(),
		"прежний состав снят целиком").Равно(0);

КонецПроцедуры

&Тест
Процедура КарточкаПакетаЗаполняетсяИзМанифеста() Экспорт

	// До этого НайтиИлиЗарегистрировать заводил пакет без единого свойства: после opm push
	// карточка пуста, и в каталоге с поиском у пакета нет описания, хотя в packagedef оно есть.
	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("card");

	Первый = НовыйМанифест(ИмяПакета, "1.0.0");
	Первый.УстановитьОписание("Веб-фреймворк для OneScript");
	Первый.УстановитьАдресРепозитория("https://github.com/oscript-library/winow");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Первый).Успех, "первая публикация").ЭтоИстина();

	Пакет = НайтиПакет(Пул, ИмяПакета);
	Ожидаем.Что(Пакет.Описание, "описание из манифеста").Равно("Веб-фреймворк для OneScript");
	Ожидаем.Что(Пакет.АдресРепозитория, "адрес репозитория из манифеста")
		.Равно("https://github.com/oscript-library/winow");

	// манифест — источник истины: следующая публикация приносит новое описание
	Второй = НовыйМанифест(ИмяПакета, "1.1.0");
	Второй.УстановитьОписание("Веб-фреймворк для OneScript: маршруты и шаблоны");
	Второй.УстановитьАдресРепозитория("https://github.com/oscript-library/winow2");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Второй).Успех, "вторая публикация").ЭтоИстина();

	Пакет = НайтиПакет(Пул, ИмяПакета);
	Ожидаем.Что(Пакет.Описание, "описание обновилось публикацией")
		.Равно("Веб-фреймворк для OneScript: маршруты и шаблоны");
	Ожидаем.Что(Пакет.АдресРепозитория, "адрес репозитория обновился публикацией")
		.Равно("https://github.com/oscript-library/winow2");

КонецПроцедуры

&Тест
Процедура ПустоеПолеМанифестаКарточкуНеЗатирает() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("keepcard");

	Заполненный = НовыйМанифест(ИмяПакета, "1.0.0");
	Заполненный.УстановитьОписание("Описание из первого манифеста");
	Заполненный.УстановитьАдресРепозитория("https://example.org/repo");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Заполненный).Успех, "первая публикация").ЭтоИстина();

	// в манифесте следующей версии оба поля пусты — карточка остаётся заполненной
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, НовыйМанифест(ИмяПакета, "1.1.0")).Успех,
		"публикация без описания").ЭтоИстина();

	Пакет = НайтиПакет(Пул, ИмяПакета);
	Ожидаем.Что(Пакет.Описание, "пустое описание манифеста не затёрло карточку")
		.Равно("Описание из первого манифеста");
	Ожидаем.Что(Пакет.АдресРепозитория, "пустой адрес манифеста не затёр карточку")
		.Равно("https://example.org/repo");

	// небезопасная схема не применяется и адрес карточки не обнуляет
	Опасный = НовыйМанифест(ИмяПакета, "1.2.0");
	Опасный.УстановитьАдресРепозитория("javascript:alert(1)");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Опасный).Успех, "публикация с опасным адресом").ЭтоИстина();

	Ожидаем.Что(НайтиПакет(Пул, ИмяПакета).АдресРепозитория,
		"javascript:-адрес в карточку не попал и прежний не стёр").Равно("https://example.org/repo");

КонецПроцедуры

&Тест
Процедура ПубликацияНеТрогаетОператорскиеПоляКарточки() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("flags");

	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, ПервыйМанифест(ИмяПакета, "1.0.0")).Успех,
		"первая публикация").ЭтоИстина();

	// оператор выставил руками то, чего в формате .ospx нет вовсе
	Пакет = НайтиПакет(Пул, ИмяПакета);
	Желудь("СервисПакетов").ОбновитьМетаданные(Пакет.Идентификатор,
		Новый Структура("Лицензия, КлючевыеСлова, Скрыт, Устарел", "MIT", "web,http", Истина, Истина));

	Обновлённый = НовыйМанифест(ИмяПакета, "1.1.0");
	Обновлённый.УстановитьОписание("Описание из манифеста");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Обновлённый).Успех, "вторая публикация").ЭтоИстина();

	Пакет = НайтиПакет(Пул, ИмяПакета);
	Ожидаем.Что(Пакет.Описание, "описание манифеста применено").Равно("Описание из манифеста");
	Ожидаем.Что(Пакет.Лицензия, "лицензии в манифесте нет — публикация её не трогает").Равно("MIT");
	Ожидаем.Что(Пакет.КлючевыеСлова, "ключевых слов в манифесте нет — публикация их не трогает")
		.Равно("web,http");
	Ожидаем.Что(Пакет.Скрыт = Истина, "операторский флаг «скрыт» не сброшен публикацией").ЭтоИстина();
	Ожидаем.Что(Пакет.Устарел = Истина, "операторский флаг «устарел» не сброшен публикацией").ЭтоИстина();

КонецПроцедуры

// Push отдаёт README принятого пакета приёму версии, и тот кладёт его на диск: страница
// пакета не распаковывает .ospx ни на первом показе, ни после рестарта хаба.
&Тест
Процедура ПубликацияКладётREADMEНаДиск() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("readme");

	Данные = Новый ДвоичныеДанные(Новый ФикстураПакета().ПостроитьOspx(
		КаталогПакетаСборки(), ИмяПакета, "1.0.0", "# Пакет " + ИмяПакета));
	Итог = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Польз, "");

	Ожидаем.Что(Итог.Успех, "публикация прошла: " + Строка(Итог.Сообщение)).ЭтоИстина();

	Хранилище = Желудь("ХранилищеАртефактов");
	Описание = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.0.0",
		ИмяПакета + "-1.0.0.readme.md");

	Ожидаем.Что(Хранилище.Существует(Описание),
		"README опубликованной версии лежит рядом с артефактом").ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Описание), "UTF-8"),
		"и это README из .ospx").Равно("# Пакет " + ИмяПакета);

КонецПроцедуры

// Публикация пакета без README тоже отвечает: пустой файл означает «README нет» и спасает
// страницу такого пакета от распаковки .ospx на каждый показ.
&Тест
Процедура ПубликацияБезREADMEОставляетПустоеОписание() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("noreadme");

	Данные = Новый ДвоичныеДанные(Новый ФикстураПакета().ПостроитьOspx(
		КаталогПакетаСборки(), ИмяПакета, "1.0.0", Неопределено));
	Итог = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные,
		СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Польз, "");

	Ожидаем.Что(Итог.Успех, "публикация прошла: " + Строка(Итог.Сообщение)).ЭтоИстина();

	Хранилище = Желудь("ХранилищеАртефактов");
	Описание = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.0.0",
		ИмяПакета + "-1.0.0.readme.md");

	Ожидаем.Что(Хранилище.Существует(Описание), "файл описания заведён").ЭтоИстина();
	Ожидаем.Что(Хранилище.Размер(Описание), "и он пуст — README в пакете не было").Равно(0);

	// самотест: пакет без README принят, а не отвергнут разбором
	Ожидаем.Что(НайтиВерсию(Пул, ИмяПакета, "1.0.0"), "версия проиндексирована").Существует();

КонецПроцедуры

// Последняя запись аудита по объекту (репозиторий сортирует: новые сверху).
Функция НайтиЗаписьАудита(Знач Объект)
	Записи = ЖурналАудита().ПоОбъекту(Объект);
	Возврат ?(Записи.Количество() > 0, Записи[0], Неопределено);
КонецФункции

// --- порядок шагов приёма ---

// Разбор .ospx стоит раньше авторизации: негодные байты от анонима — 400, целый пакет — 401.
&Тест
Процедура РазборПакетаОтвечаетРаньшеАвторизации() Экспорт

	Пул = Засев.ПулСервисом();
	Битые = ПолучитьДвоичныеДанныеИзСтроки("это не zip и не ospx");

	Негодные = Желудь("СервисПубликации").Опубликовать(
		Пул.Имя, Битые, "битый-1.0.0.ospx", "stable", Неопределено, "");

	Ожидаем.Что(Негодные.Успех).ЭтоЛожь();
	Ожидаем.Что(Негодные.Код,
		"негодные байты названы разбором (400), а не авторизацией (401)").Равно(400);

	ИмяПакета = УникальныеИмена.Имя("anonorder");
	Целый = Желудь("СервисПубликации").Опубликовать(
		Пул.Имя, Публикация.ДанныеOspx(ИмяПакета, "1.0.0"),
		СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Неопределено, "");

	Ожидаем.Что(Целый.Код,
		"тот же аноним с целым пакетом доходит до авторизации").Равно(401);

КонецПроцедуры

// --- хелперы ---

// Публикация версии 1.0.0 при включённом легаси-пути GitHub. Опция выключается и при падении:
// соседние тесты живут с опцией по умолчанию.
Функция ОпубликоватьПриЛегасиGitHub(Знач Пул, Знач Польз, Знач ИмяПакета, Знач Токен)

	Настройки = Желудь("СервисНастроек");
	Настройки.Установить("oshub.publish.github_legacy", Истина, Неопределено);
	Попытка
		Результат = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", Токен);
	Исключение
		Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);

	Возврат Результат;

КонецФункции

// «Кто» записи журнала о публикации версии 1.0.0.
Функция КтоВЖурнале(Знач Пул, Знач ИмяПакета)
	Запись = НайтиЗаписьАудита(СтрШаблон("%1/%2@1.0.0", Пул.Имя, ИмяПакета));
	Возврат ?(Запись = Неопределено, "<записи нет>", Строка(Запись.Кто));
КонецФункции

// Исходящий HTTP этого контейнера: через него ходит только опознание владельца токена.
Функция Транспорт()
	Возврат Желудь("ТранспортHTTP");
КонецФункции

// Публикация от имени ключа: принципал запроса с заданными скоупами и привязкой к пулу.
Функция ОпубликоватьКлючом(Знач Пул, Знач Польз, Знач ИмяПакета, Знач Версия, Знач Права, Знач ПулКлюча)
	Возврат Публикация.Отправить(Пул, Польз, ИмяПакета, Версия, "stable", "", Ложь,
		Принципалы.Ключ(Польз, Права, ПулКлюча));
КонецФункции

Функция НайтиВерсию(Знач Пул, Знач ИмяПакета, Знач СтрокаВерсии)
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Возврат Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, СтрокаВерсии);
КонецФункции

Функция НайтиПакет(Знач Пул, Знач ИмяПакета)
	Возврат Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
КонецФункции

Функция НовыйМанифест(Знач ИмяПакета, Знач Версия)
	Возврат ПакетыOspx.НовыйМанифест(ИмяПакета, Версия);
КонецФункции

// Манифест первой версии имени: без адреса репозитория хаб её не примет.
Функция ПервыйМанифест(Знач ИмяПакета, Знач Версия)
	Возврат Новый ФикстураПакета().МанифестСРепозиторием(ИмяПакета, Версия);
КонецФункции

Функция Теги()
	Возврат Желудь("СервисТегов");
КонецФункции

Функция Визард()
	Возврат Желудь("КаналыПоУмолчанию");
КонецФункции

// Снимает запрет повторной публикации с одного тега пакета — то же, что делает тумблер
// в настройках пакета.
Функция СнятьЗапрет(Знач Пакет, Знач ИмяТега)
	Возврат Теги().УстановитьЗапретПерезаписи(Пакет.Идентификатор, ИмяТега, Ложь, "тест");
КонецФункции

// Читается тем же методом хранилища, каким живёт вкладка зависимостей страницы пакета.
Функция ЗависимостиВерсии(Знач Версия)
	Возврат Желудь("ХранилищеЗависимостей").ПоВерсии(Версия.Идентификатор);
КонецФункции

Функция КтоЗависитОт(Знач ИмяПакета)
	Возврат Желудь("ХранилищеЗависимостей").КтоЗависитОт(ИмяПакета);
КонецФункции

Функция НайтиЗависимость(Знач Состав, Знач ИмяПакета)
	Для Каждого Зависимость Из Состав Цикл
		Если Зависимость.ИмяПакета = ИмяПакета Тогда
			Возврат Зависимость;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиПоВерсии(Знач Записи, Знач ВерсияИдентификатор)
	Для Каждого Запись Из Записи Цикл
		Если Запись.ВерсияИдентификатор = ВерсияИдентификатор Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КаталогПакетаСборки()
	КаталогПакета = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогПакета);
	Возврат КаталогПакета;
КонецФункции

Функция СоздатьАдмина()
	Возврат Стенд.Учётка("admin");
КонецФункции

// Занятое пулом читается свежим, а не по объекту из момента создания.
Функция ЗанятоПулом(Знач Пул)
	Возврат Желудь("СервисПулов").ЗанятоБайт(ЗаписьПула(Пул));
КонецФункции

Функция ЗаписьПула(Знач Пул)
	Возврат Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор);
КонецФункции

// Допуск с НЕсобранным гвардом ключа: так проверяется fail-closed «гейт не собран».
Функция ДопускБезГварда()
	Возврат Новый ДопускПринципала(Желудь("УчёткаПринципала"), Неопределено);
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.публикация");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция ЖурналАудита()
	Возврат Новый ЖурналАудитаФайлом(Желудь("ЧитательЖурналаАудита"));
КонецФункции

// Детали записи журнала — полями, а не текстом: флаг остаётся флагом, имя именем,
// а пробелы сериализации ни о чём не говорят.
Функция ДеталиЗаписи(Знач Запись)
	Возврат Желудь("ФорматЖурналаАудита").ДеталиПолями(Строка(Запись.Детали));
КонецФункции
