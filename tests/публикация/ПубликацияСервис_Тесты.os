// СервисПубликации на юнит-контейнере с файловым хранилищем во временном каталоге:
// авторизация, запрет перезаписи, сверка манифеста, порядок шагов приёма, журнал.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем КаталогСборки;
Перем Засев;         // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба
Перем Стенд;         // фикстура СтендУчёток — учётка, роль на пуле, грант и ключ
Перем Принципалы;    // фикстура СтендПринципалов — принципал ключа
Перем Публикация;    // фикстура СтендПубликации — push через СервисПубликации

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("КонтейнерПубликации");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	Контейнер = Новый КонтейнерПубликации(ПоискКлассов, КаталогМодулей);

	Контейнер.ПодключитьСоседей();
	// боевой ПроверяющийПодписиJWKS не подключается: он ходит за ключами в сеть, прозвище занимает фейк
	Контейнер.ПодключитьПубликацию("СервисВходящих, СтражИздателейCI, МаскаРефа, КороткаяФормаДоверия,"
		+ " ИмяЗаписиДоверия, ВидРефаДоверия, СрокТокенаCI, АудиторияТокенаCI, СервисДоверияCI,"
		+ " СервисПубликации");
	// README принятого пакета ложится на диск в приёме версии
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "описания", "Классы"));

	// опознание владельца легаси-токена — боевая реализация поверх фейкового транспорта:
	// контейнер собирает тот же желудь, что и хаб, а в сеть никто не ходит
	ПоискКлассов.Подключить(КаталогМодулей, "ОпознаниеGitHubHTTP");
	ПоискКлассов.Подключить(КаталогМодулей, "ТаймаутыHTTP");

	Для Каждого Фикстура Из СтрРазделить("ЗасевРеестра, СтендУчёток, СтендПринципалов,"
		+ " ФейкПроверяющийGitHub, КодировкаТестов, ФейкПроверяющийПодписиCI, ФикстураПакета,"
		+ " ЖурналАудитаФайлом, ФейкТранспортHTTP, ПравоPushОтХаба, СтендПубликации", ",") Цикл
		РеестрФикстур.Подключить(СокрЛП(Фикстура));
	КонецЦикла;

	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-push-unit");
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Поделка = Контейнер.Собрать("публикация-сервис-тесты", КореньХранилища);

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендУчёток(Поделка);
	Принципалы = Новый СтендПринципалов(Поделка);
	Публикация = Новый СтендПубликации(Поделка, КаталогСборки);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

// --- проверки ---

&Тест
Процедура ЖелудиPublishЗарегистрированы() Экспорт
	Для Каждого Имя Из СтрРазделить("СервисПубликации,СервисПрав,ПроверяющийGitHub,ОпознаниеGitHub,"
		+ "ХранилищеАртефактов", ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура НесобранныйГейтКлючаЗакрываетPushПоТокенуНоНеВнутреннийВызов() Экспорт

	// несобранный гейт ключа закрывает push по ключу: служба собирается напрямую
	// с Неопределено вместо гейта
	Сервис = Новый СервисПубликации(
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Желудь("ПриёмВерсии"),
		Желудь("СервисМетокВерсий"), Желудь("ПравилаИменования"),
		Желудь("ХранилищеАртефактов"), Желудь("ЗаписьЗанятогоМеста"),
		Желудь("СервисПрав"), ДопускБезГварда(),
		Желудь("СервисПравДоступа"), Желудь("ИздательСобытий"),
		Желудь("СервисНастроек"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		// очередь и доверие — позиционные параметры перед логом, пропустить их нельзя
		Желудь("СервисВходящих"), Желудь("СервисДоверияCI"), ЛогТестов());

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

	Принципал = Принципалы.Ключ(Польз);

	ПоТокену = Сервис.Опубликовать(Пул.Имя, Публикация.ДанныеOspx("nogate", "1.0.0"),
		"nogate-1.0.0.ospx", "stable", Польз, "", Принципал);

	Ожидаем.Что(ПоТокену.Успех, "без собранного гейта публикация ПО КЛЮЧУ не проходит").ЭтоЛожь();
	Ожидаем.Что(ПоТокену.Код, "отказ ключа → 403").Равно(403);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "nogate"),
		"и пакет не заведён").Равно(Неопределено);

	// РАДИУС ПОРАЖЕНИЯ: запрос БЕЗ ключа (сессия кабинета, внутренний вызов, частичный
	// контейнер) продолжает работать — fail-closed сужен до ключа, а не до всего push
	БезКлюча = Сервис.Опубликовать(Пул.Имя, Публикация.ДанныеOspx("nogate2", "1.0.0"),
		"nogate2-1.0.0.ospx", "stable", Польз, "");
	Ожидаем.Что(БезКлюча.Успех, "публикация без ключа не сломана").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГейтКлючаЗакрываетPushТокеномБезЗаписиИЧужогоПула() Экспорт

	// скоуп ключа и привязка к пулу действуют на публикации; права человека здесь полные,
	// отказывает ровно гейт ключа
	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

	БезЗаписи = ОпубликоватьКлючом(Пул, Польз, "gate-scope", "1.0.0", "read", 0);
	Ожидаем.Что(БезЗаписи.Успех, "ключ без скоупа write не публикует").ЭтоЛожь();
	Ожидаем.Что(БезЗаписи.Код, "отказ ключа → 403").Равно(403);
	Ожидаем.Что(СтрНайти(БезЗаписи.Сообщение, "скоуп") > 0, "причина названа").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "gate-scope"),
		"пакет не создан").Равно(Неопределено);

	ЧужойПул = ОпубликоватьКлючом(Пул, Польз, "gate-bind", "1.0.0", "read,write", Пул.Идентификатор + 1000);
	Ожидаем.Что(ЧужойПул.Успех, "ключ, привязанный к другому пулу, не публикует").ЭтоЛожь();
	Ожидаем.Что(ЧужойПул.Код, "отказ привязки → 403").Равно(403);
	Ожидаем.Что(СтрНайти(ЧужойПул.Сообщение, "другому пулу") > 0, "причина названа").ЭтоИстина();

	// свой пул и полный скоуп — публикация проходит (гейт не ломает штатный путь)
	Свой = ОпубликоватьКлючом(Пул, Польз, "gate-ok", "1.0.0", "read,write", Пул.Идентификатор);
	Ожидаем.Что(Свой.Успех, "свой пул и скоуп write публикуют").ЭтоИстина();

КонецПроцедуры

// Имя пакета, совпадающее со служебным словом адреса, — обычное имя: страница пакета живёт
// под /pools/{пул}/packages/{имя}, и ни «settings», ни «packages» ни с чем там не соревнуются.
&Тест
Процедура ИменаСлужебныхАдресовДопустимыДляПакетов() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

	Для Каждого Имя Из СтрРазделить("settings|packages|versions", "|") Цикл
		Результат = Публикация.Отправить(Пул, Польз, Имя, "1.0.0", "stable", "");
		Ожидаем.Что(Результат.Успех, СтрШаблон("пакет ""%1"" публикуется: %2", Имя, Результат.Сообщение))
			.ЭтоИстина();
		Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, Имя) <> Неопределено,
			СтрШаблон("пакет ""%1"" заведён", Имя)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НоваяВерсияПубликуетсяВLocalПул() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

	ИмяПакета = УникальныеИмена.Имя("pkg");
	Результат = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");

	Ожидаем.Что(Результат.Успех, "публикация успешна: " + Результат.Сообщение).ЭтоИстина();
	Ожидаем.Что(Результат.Код, "новая версия → 201").Равно(201);

	// артефакт лёг в хранилище, версия в реестре
	Координаты = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.0.0");
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Существует(Координаты), "артефакт сохранён").ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Ожидаем.Что(Пакет, "пакет зарегистрирован").Существует();
	Версия = Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0");
	Ожидаем.Что(Версия, "версия в реестре").Существует();

КонецПроцедуры

&Тест
Процедура ПовторныйReleaseЗапрещён409() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("dup");

	Первый = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Первый.Успех).ЭтоИстина();

	Второй = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Второй.Успех, "release-дубль отклонён").ЭтоЛожь();
	Ожидаем.Что(Второй.Код, "release-дубль → 409").Равно(409);

КонецПроцедуры

&Тест
Процедура ReleaseНеПерезаписатьЧерезCHANNELdev() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("attackdev");

	Первый = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Первый.Код, "release 1.0.0 (stable) → 201").Равно(201);

	// подмена CHANNEL на dev запрет не снимает: канал — метка, а не право
	Атака = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "dev", "");
	Ожидаем.Что(Атака.Успех, "release не перезаписывается через CHANNEL=dev").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "подмена CHANNEL=dev на release → 409").Равно(409);

КонецПроцедуры

&Тест
Процедура ReleaseНеПерезаписатьПустымCHANNEL() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("attackempty");

	Первый = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Первый.Код).Равно(201);

	Атака = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "", "");
	Ожидаем.Что(Атака.Успех, "release не перезаписывается пустым CHANNEL").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "пустой CHANNEL на release → 409").Равно(409);

КонецПроцедуры

// Пререлиз попадает под базовый тег prerelease, и запрет перезаписи включён и на нём:
// второй push 1.0.0-rc.1 не заменяет уже установленные у людей байты.
&Тест
Процедура ПовторныйПререлизОтклоняетсяКакИRelease() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("pre");

	Первый = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "");
	Ожидаем.Что(Первый.Успех, "первый prerelease-push").ЭтоИстина();
	// каналы заводит мейнтейнер: сам хаб их не выдумывает, а запрет держит именно тег
	Визард().Создать(НайтиПакет(Пул, ИмяПакета).Идентификатор);

	Второй = Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "");
	Ожидаем.Что(Второй.Успех, "пререлиз сам по себе перезапись не разрешает").ЭтоЛожь();
	Ожидаем.Что(Второй.Код, "повторный номер → конфликт, а не 400").Равно(409);
	Ожидаем.Что(СтрНайти(Второй.Сообщение, "?force=1") > 0,
		"отказ называет рабочую сегодня форму замены: " + Второй.Сообщение).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Второй.Сообщение, "prerelease") > 0,
		"и второй — с именем запрещающего тега: " + Второй.Сообщение).ЭтоИстина();

	// SNAPSHOT-маркер был вторым обходом той же природы — он тоже снят
	Снимок = УникальныеИмена.Имя("snap");
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, Снимок, "1.0.0-SNAPSHOT", "stable", "").Успех,
		"первый SNAPSHOT-push").ЭтоИстина();
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, Снимок, "1.0.0-SNAPSHOT", "stable", "").Код,
		"SNAPSHOT сам по себе перезапись не разрешает → 409").Равно(409);

КонецПроцедуры

// CHANNEL не влияет ни на запрет, ни на форс: заголовок остаётся меткой версии.
&Тест
Процедура ЗапретИФорсНеЗависятОтCHANNEL() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("preany");

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "").Код,
		"prerelease → 201").Равно(201);

	Для Каждого Канал Из СтрРазделить("stable,dev,,экзотика", ",") Цикл
		Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0-rc.1", Канал, "").Код,
			СтрШаблон("CHANNEL ""%1"" запрет не снимает", Канал)).Равно(409);
	КонецЦикла;

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "экзотика", "", Истина).Код,
		"а форс проходит при любом CHANNEL").Равно(200);

КонецПроцедуры

// Запрет висит на КАЖДОМ теге отдельно: пока хоть один тег версии его держит, номер
// неизменяем. Снятый на одном канале запрет соседний не отменяет.
&Тест
Процедура ЗапретДержитЛюбойИзТеговВерсии() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("twotags");

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "2.0.0", "stable", "").Код).Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);

	// каналы «по умолчанию» завёл мейнтейнер: версия попала и в stable, и в prerelease,
	// а сверху на неё повешен ручной тег lts
	Визард().Создать(Пакет.Идентификатор);
	Теги().ПометитьВерсию(Пакет.Идентификатор, "lts", "2.0.0");

	Ожидаем.Что(СнятьЗапрет(Пакет, "stable"), "запрет снят со stable").ЭтоИстина();
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "2.0.0", "stable", "").Код,
		"prerelease и lts запрет держат → 409").Равно(409);

	Ожидаем.Что(СнятьЗапрет(Пакет, "prerelease"), "запрет снят с prerelease").ЭтоИстина();
	Отказ = Публикация.Отправить(Пул, Польз, ИмяПакета, "2.0.0", "stable", "");
	Ожидаем.Что(Отказ.Код, "ручной lts держит запрет в одиночку → 409").Равно(409);
	Ожидаем.Что(СтрНайти(Отказ.Сообщение, "lts") > 0,
		"назван именно оставшийся тег: " + Отказ.Сообщение).ЭтоИстина();

	// снят на всех тегах версии — переиздание идёт свободно, без всякого форса
	Ожидаем.Что(СнятьЗапрет(Пакет, "lts"), "запрет снят с lts").ЭтоИстина();
	Свободная = Публикация.Отправить(Пул, Польз, ИмяПакета, "2.0.0", "stable", "");
	Ожидаем.Что(Свободная.Успех, "запрета не осталось — перезапись свободна").ЭтоИстина();
	Ожидаем.Что(Свободная.Код).Равно(200);

КонецПроцедуры

// Роль на хабе перезаписи не даёт: у админа те же 409, что и у мейнтейнера, а заменяет
// номер только явный --force — и остаётся следом в журнале.
&Тест
Процедура АдминБезФорсаНеПерезаписываетАСФорсомПишетСлед() Экспорт

	Пул = Засев.ПулСервисом();
	Админ = СоздатьАдмина();
	ИмяПакета = УникальныеИмена.Имя("adminrel");

	Ожидаем.Что(Публикация.Отправить(Пул, Админ, ИмяПакета, "3.0.0", "stable", "").Успех,
		"первый release админа").ЭтоИстина();

	Второй = Публикация.Отправить(Пул, Админ, ИмяПакета, "3.0.0", "stable", "");
	Ожидаем.Что(Второй.Успех, "роль админа перезапись не разрешает").ЭтоЛожь();
	Ожидаем.Что(Второй.Код, "админ без форса → 409").Равно(409);

	Форсом = Публикация.Отправить(Пул, Админ, ИмяПакета, "3.0.0", "stable", "", Истина);
	Ожидаем.Что(Форсом.Успех, "с форсом номер заменяется: " + Форсом.Сообщение).ЭтоИстина();
	Ожидаем.Что(Форсом.Код, "замена номера → 200").Равно(200);

	Запись = НайтиЗаписьАудита(СтрШаблон("%1/%2@3.0.0", Пул.Имя, ИмяПакета));
	Ожидаем.Что(Запись, "запись аудита есть").Существует();
	Ожидаем.Что(Запись.Действие, "перезапись — в аудит").Равно("перезапись.версии");
	Ожидаем.Что(ДеталиЗаписи(Запись).Получить("форс"),
		"и в деталях виден именно форс: " + Строка(Запись.Детали)).Равно(Истина);

КонецПроцедуры

// Форс — не право, а способ: у того, кому публиковать нельзя, он не открывает ничего.
&Тест
Процедура ФорсНеЗаменяетПраваНаПубликацию() Экспорт

	Пул = Засев.ПулСервисом();
	Хозяин = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Хозяин, "owner");
	ИмяПакета = УникальныеИмена.Имя("forceacl");

	Ожидаем.Что(Публикация.Отправить(Пул, Хозяин, ИмяПакета, "1.0.0", "stable", "").Успех,
		"владелец опубликовал первым").ЭтоИстина();
	ShaДо = Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256);

	Чужой = Стенд.Учётка();
	БезПрава = Публикация.Отправить(Пул, Чужой, ИмяПакета, "1.0.0", "stable", "", Истина);
	Ожидаем.Что(БезПрава.Успех, "форс без права публикации не проходит").ЭтоЛожь();
	Ожидаем.Что(БезПрава.Код, "нет права → 403, а не 200").Равно(403);
	Ожидаем.Что(Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256),
		"и чужой артефакт не тронут").Равно(ShaДо);

КонецПроцедуры

// Отказ по правилу стоит до записи артефакта и до учёта байтов. Отклонённая
// публикация не оставляет ни новых байтов на диске, ни занятого места, ни записи в журнале,
// ни нового состава зависимостей.
&Тест
Процедура ОтклонённыйПовторныйПушНеОставляетСледов() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("notrace");

	Первый = ПервыйМанифест(ИмяПакета, "1.0.0");
	Первый.ДобавитьЗависимость("json", "1.0.0");
	Ожидаем.Что(Публикация.ОтправитьМанифест(Пул, Польз, Первый).Успех, "первая публикация").ЭтоИстина();

	Координаты = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.0.0");
	ShaДо = Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256);
	РазмерДо = Желудь("ХранилищеАртефактов").Размер(Координаты);
	ЗанятоДо = ЗанятоПулом(Пул);
	ЗаписейДо = ЖурналАудита().ПоОбъекту(
		СтрШаблон("%1/%2@1.0.0", Пул.Имя, ИмяПакета)).Количество();

	// второй push ДРУГИМИ байтами: другой состав зависимостей — другой архив
	Другой = НовыйМанифест(ИмяПакета, "1.0.0");
	Другой.ДобавитьЗависимость("winow", "0.5.0");
	Другой.ДобавитьЗависимость("logos", "2.0.0");
	Отказ = Публикация.ОтправитьМанифест(Пул, Польз, Другой);

	Ожидаем.Что(Отказ.Код, "повторный номер → 409").Равно(409);
	// скрипту конвейера имя и номер нужны полями: по ним он решает, что переименовать
	Ожидаем.Что(Отказ.Подробности <> Неопределено, "отказ несёт подробности").ЭтоИстина();
	Ожидаем.Что(Отказ.Подробности.package, "названо имя пакета").Равно(ИмяПакета);
	Ожидаем.Что(Отказ.Подробности.version, "и номер версии").Равно("1.0.0");
	Ожидаем.Что(Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256),
		"контрольная сумма версии не поменялась").Равно(ShaДо);
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Размер(Координаты),
		"и байты на диске остались прежними").Равно(РазмерДо);
	Ожидаем.Что(ЗанятоПулом(Пул), "занятое место не выросло").Равно(ЗанятоДо);
	Ожидаем.Что(Желудь("УчётОбъёмаПула").Пересчитать(ЗаписьПула(Пул)),
		"и пересчёт по диску даёт то же").Равно(ЗанятоДо);
	Ожидаем.Что(ЖурналАудита().ПоОбъекту(СтрШаблон("%1/%2@1.0.0", Пул.Имя, ИмяПакета)).Количество(),
		"отклонённая публикация в журнал не пишется").Равно(ЗаписейДо);

	Состав = ЗависимостиВерсии(НайтиВерсию(Пул, ИмяПакета, "1.0.0"));
	Ожидаем.Что(Состав.Количество(), "состав зависимостей не тронут").Равно(1);
	Ожидаем.Что(НайтиЗависимость(Состав, "json"), "остался прежний").Существует();

КонецПроцедуры

// Версия, не попавшая НИ ПОД ОДИН тег, тоже неизменяема. Голый SNAPSHOT — единственная
// строка, которую валидатор пропускает, а semver-правила не ловят: до этого запрета такой
// номер молча переписывался вторым push, потому что запрещать было некому.
&Тест
Процедура ВерсияБезЕдиногоТегаЗапрещенаБезТега() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("notag");

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "SNAPSHOT", "stable", "").Код,
		"голый SNAPSHOT публикуется").Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);
	Ожидаем.Что(Теги().ЗапретПерезаписи(Пакет, "SNAPSHOT").ИмяТега,
		"под теги пакета такой номер не попадает").Равно("");

	Повтор = Публикация.Отправить(Пул, Польз, ИмяПакета, "SNAPSHOT", "stable", "");
	Ожидаем.Что(Повтор.Код, "и всё равно 409, а не молчаливая замена").Равно(409);
	Ожидаем.Что(СтрНайти(Повтор.Сообщение, "?force=1") > 0,
		"назван единственный выход: " + Повтор.Сообщение).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Повтор.Сообщение, "снять запрет"),
		"и не предложено снимать запрет, которого не с чего снимать: " + Повтор.Сообщение).Равно(0);

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "SNAPSHOT", "stable", "", Истина).Код,
		"форс такой номер заменяет").Равно(200);

КонецПроцедуры

// Тот же запрет без тега получается вторым путём: у пакета удалили все теги. Канал,
// из которого версия выпала, не имеет права открывать её переиздание всем.
&Тест
Процедура УдалениеВсехТеговНеОткрываетНомер() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("notags");

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "").Код).Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);

	Для Каждого Тег Из Теги().ТегиПакета(Пакет.Идентификатор) Цикл
		Теги().УдалитьТег(Пакет.Идентификатор, Тег.Имя, "тест");
	КонецЦикла;
	Ожидаем.Что(Теги().ТегиПакета(Пакет.Идентификатор).Количество(),
		"тегов у пакета не осталось").Равно(0);

	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "").Код,
		"номер без тегов по-прежнему неизменяем").Равно(409);
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "", Истина).Код,
		"а форс работает").Равно(200);

КонецПроцедуры

// Форс снимает ОДИН запрет — повторной публикации, и не становится ключом от всех дверей:
// негодная строка версии и номер, занятый именем тега, отвергаются с ним ровно так же.
&Тест
Процедура ФорсНеПроноситНиНегоднуюСтрокуНиИмяТега() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "owner");
	ИмяПакета = УникальныеИмена.Имя("forcegate");

	Нулями = Публикация.Отправить(Пул, Польз, ИмяПакета, "01.2.3", "stable", "", Истина);
	Ожидаем.Что(Нулями.Код, "ведущие нули с форсом — по-прежнему 400").Равно(400);
	Ожидаем.Что(НайтиПакет(Пул, ИмяПакета), "и пакет не заведён").Равно(Неопределено);

	// имя тега и номер версии не пересекаются — форс это правило не отменяет
	Ожидаем.Что(Публикация.Отправить(Пул, Польз, ИмяПакета, "1.0.0", "stable", "").Код).Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);
	Теги().ОпределитьРучнойТег(Пакет.Идентификатор, "lts", "тест");

	ПодИмяТега = Публикация.Отправить(Пул, Польз, ИмяПакета, "lts", "stable", "", Истина);
	Ожидаем.Что(ПодИмяТега.Успех, "номер, занятый именем тега, с форсом не проходит").ЭтоЛожь();
	Ожидаем.Что(ПодИмяТега.Код, "это отказ по вводу → 400").Равно(400);
	Ожидаем.Что(НайтиВерсию(Пул, ИмяПакета, "lts"), "версия не создана").Равно(Неопределено);

КонецПроцедуры

// Разбор параметра адреса один на обе двери публикации: невнятное значение — обычный push.
&Тест
Процедура ФлагФорсаЧитаетсяОдинаковоОбеимиДверями() Экспорт

	Сервис = Желудь("СервисПубликации");
	Для Каждого Значение Из СтрРазделить("1,true,TRUE,да,истина", ",") Цикл
		Ожидаем.Что(Сервис.ЭтоФорс(Значение), "«" + Значение + "» — форс").ЭтоИстина();
	КонецЦикла;
	Для Каждого Значение Из СтрРазделить("0,false,нет,абракадабра, ", ",") Цикл
		Ожидаем.Что(Сервис.ЭтоФорс(Значение), "«" + Значение + "» форсом не считается").ЭтоЛожь();
	КонецЦикла;
	Ожидаем.Что(Сервис.ЭтоФорс(""), "пустой параметр — обычный push").ЭтоЛожь();
	Ожидаем.Что(Сервис.ЭтоФорс(Неопределено), "и отсутствующий тоже").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура МанифестНеСовпадаетСИменемФайла() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");
	ИмяПакета = УникальныеИмена.Имя("mism");

	Данные = Публикация.ДанныеOspx(ИмяПакета, "1.0.0");
	// FILE-NAME с ЧУЖИМ именем/версией — манифест источник истины, сверка обязана отклонить
	Результат = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные, "другое-9.9.9.ospx", "stable", Польз, "");

	Ожидаем.Что(Результат.Успех, "манифест vs FILE-NAME расходятся → отказ").ЭтоЛожь();
	Ожидаем.Что(Результат.Код, "несовпадение → 400").Равно(400);

КонецПроцедуры

&Тест
Процедура БитыйПакетОтклонён() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

	Данные = ПолучитьДвоичныеДанныеИзСтроки("это не zip и не ospx");
	Результат = Желудь("СервисПубликации").Опубликовать(Пул.Имя, Данные, "битый-1.0.0.ospx", "stable", Польз, "");

	Ожидаем.Что(Результат.Успех, "битый .ospx отклонён").ЭтоЛожь();
	Ожидаем.Что(Результат.Код, "битый → 400").Равно(400);
	// отказ по правилу называет причину: «некорректный пакет» без объяснения не говорит
	// публикатору, что чинить, а opm печатает сообщение как есть
	Ожидаем.Что(СтрДлина(СокрЛП(Результат.Сообщение)) > СтрДлина("Некорректный пакет .ospx: "),
		"в ответе есть причина от разбора, а не одно двоеточие: " + Результат.Сообщение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПакетСНевалиднымМанифестомОтклонён() Экспорт

	Пул = Засев.ПулСервисом();
	Польз = Стенд.Учётка();
	Стенд.РольВПуле(Пул, Польз, "publisher");

	// архив читается, но версия вне semver: пять компонент вместо четырёх
	Результат = Публикация.ОтправитьМанифест(Пул, Польз, НовыйМанифест(УникальныеИмена.Имя("badver"), "1.2.3.4.5"));

	Ожидаем.Что(Результат.Успех, "манифест не прошёл валидацию → отказ").ЭтоЛожь();
	Ожидаем.Что(Результат.Код, "невалидный манифест → 400").Равно(400);
	Ожидаем.Что(СтрНайти(Результат.Сообщение, "Некорректная версия пакета") > 0,
		"в ответе — причина от валидатора: " + Результат.Сообщение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧужойПакетБезПраваОстаётся403() Экспорт

	Права = Желудь("СервисПрав");
	Пул = Засев.ПулСервисом();
	Хозяин = Стенд.Учётка();
	Стенд.ГрантСлужбой(Хозяин, Права.ОбъектПул(Пул),
		Стенд.Действия(Истина, Истина, Истина, Истина));

	ИмяПакета = УникальныеИмена.Имя("owned");
	Ожидаем.Что(Публикация.Отправить(Пул, Хозяин, ИмяПакета, "1.0.0", "stable", "").Успех,
		"контроль: хозяин имя завёл").ЭтоИстина();

	Чужой = Стенд.Учётка(); // без роли, self-service глобально выключен
	Результат = Публикация.Отправить(Пул, Чужой, ИмяПакета, "2.0.0", "stable", "");
	Ожидаем.Что(Результат.Успех).ЭтоЛожь();
	Ожидаем.Что(Результат.Код,
		"push без прав в СУЩЕСТВУЮЩИЙ пакет → 403, а не заявка во «входящие»").Равно(403);

КонецПроцедуры

&Тест
Процедура НевалидныйТокен401() Экспорт

	Пул = Засев.ПулСервисом();
	ИмяПакета = УникальныеИмена.Имя("badtok");
	Данные = Публикация.ДанныеOspx(ИмяПакета, "1.0.0");

	Результат = Желудь("СервисПубликации").Опубликовать(
		Пул.Имя, Данные, СтрШаблон("%1-1.0.0.ospx", ИмяПакета), "stable", Неопределено, "невалидный-сырой-токен");
	Ожидаем.Что(Результат.Успех).ЭтоЛожь();
	Ожидаем.Что(Результат.Код, "невалидный токен (нет принципала) → 401, не 403").Равно(401);

КонецПроцедуры

