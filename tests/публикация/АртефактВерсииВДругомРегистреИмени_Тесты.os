// Артефакт версии, присланной push с именем пакета в другом регистре, на регистрозависимом хранилище:
// S3 над фейком корзины различает ключи по регистру, как S3 и диск Linux. Контейнер ОСени на
// КоннекторInMemory; отдельный процесс.

#Использовать asserts
#Использовать autumn-cache
#Использовать "../фикстуры"

Перем Выдача;         // фикстура СтендВыдачи — контейнер, хранилище на фейке S3, маршрут выдачи
Перем Публикация;     // фикстура СтендПубликации — push через СервисПубликации
Перем КореньСборки;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("СтендВыдачи");
	РеестрФикстур.Подключить("СтендПубликации");

	КореньСборки = УникальныеИмена.ВременныйКаталог("oshub-artifact-case");
	КаталогСборки = ОбъединитьПути(КореньСборки, "сборка");
	СоздатьКаталог(КаталогСборки);

	Выдача = Новый СтендВыдачи(Новый Соответствие(), "артефакт-регистр-тесты",
		"почта, уведомления, вход, права, публикация, статистика");
	Публикация = Новый СтендПубликации(Выдача.Поделка(), КаталогСборки);

КонецПроцедуры

&ПослеВсех
Процедура УбратьСборку() Экспорт
	УникальныеИмена.УбратьВременное(КореньСборки);
КонецПроцедуры

// Ради чего всё: пакет заведён как MyPkg, следующую версию прислали с mypkg в манифесте —
// `opm install` берёт её и по номеру, и как последнюю.
&Тест
Процедура ВерсияСИменемВДругомРегистреСкачивается() Экспорт

	Заведённое = ЗавестиПакет();
	Итог = Публикация.Опубликовать(Заведённое.Пул, Заведённое.Мейнтейнер, НРег(Заведённое.Пакет.Имя), "1.1.0");
	Ожидаем.Что(Итог.Успех, "самотест: версия в другом регистре принята: " + Итог.Сообщение).ЭтоИстина();
	Ожидаем.Что(Пакет(Заведённое).Имя, "самотест: имя в реестре осталось с первой публикации")
		.Равно(Заведённое.Пакет.Имя);

	ПоНомеру = Скачать(Заведённое, Заведённое.Пакет.Имя + "-1.1.0.ospx");
	Ожидаем.Что(ПоНомеру.Код, "версия в другом регистре скачивается по номеру").Равно(200);

	Последняя = Скачать(Заведённое, Заведённое.Пакет.Имя + ".ospx");
	Ожидаем.Что(Последняя.Код, "и как последняя").Равно(200);

	Ожидаем.Что(ЛежащиеOspx(Заведённое), "в корзине — оба файла под именем из реестра")
		.Равно(СтрШаблон("%1/%1-1.0.0.ospx,%1/%1-1.1.0.ospx", Заведённое.Пакет.Имя));

КонецПроцедуры

// Уборка пакета снимает файл версии, присланной в другом регистре: в корзине не остаётся .ospx.
&Тест
Процедура УборкаСнимаетАртефактВерсииСИменемВДругомРегистре() Экспорт

	Заведённое = ЗавестиПакет();
	Итог = Публикация.Опубликовать(Заведённое.Пул, Заведённое.Мейнтейнер, ВРег(Заведённое.Пакет.Имя), "1.1.0");
	Ожидаем.Что(Итог.Успех, "самотест: версия в другом регистре принята: " + Итог.Сообщение).ЭтоИстина();
	Ожидаем.Что(ЛежащиеOspx(Заведённое), "самотест: оба файла легли").Содержит(",");

	Выдача.Желудь("УборкаПакета").УдалитьПакет(Пакет(Заведённое));

	Ожидаем.Что(ЛежащиеOspx(Заведённое), "файлы версий сняты вместе с пакетом").Равно("");

КонецПроцедуры

#Область Помощники

// Имя в смешанном регистре: нижний и верхний регистр дают другую строку.
Функция ЗавестиПакет()

	Пара = Публикация.ПулСМейнтейнером("artcase");
	ИмяПакета = "MyPkg-" + УникальныеИмена.Хвост();
	Итог = Публикация.Опубликовать(Пара.Пул, Пара.Мейнтейнер, ИмяПакета, "1.0.0");
	Если НЕ Итог.Успех Тогда
		ВызватьИсключение "Пакет не заведён: " + Итог.Сообщение;
	КонецЕсли;

	Заведённое = Новый Структура("Пул, Мейнтейнер", Пара.Пул, Пара.Мейнтейнер);
	Заведённое.Вставить("Пакет", Выдача.Желудь("СервисПакетов").НайтиПакет(Пара.Пул.Идентификатор, ИмяПакета));
	Возврат Заведённое;

КонецФункции

Функция Пакет(Знач Заведённое)
	Возврат Выдача.Желудь("СервисПакетов").НайтиПакет(Заведённое.Пул.Идентификатор, Заведённое.Пакет.Имя);
КонецФункции

// Маршрут выдачи — тот, к которому ходит opm install: пул, имя из реестра, имя файла в адресе.
Функция Скачать(Знач Заведённое, Знач ИмяФайла)
	Возврат Выдача.Выдать(Новый Структура("Пул, Пакет", Заведённое.Пул, Заведённое.Пакет), "GET", "", ИмяФайла);
КонецФункции

// Ключи .ospx пула в корзине относительно области пула, по порядку, через запятую.
Функция ЛежащиеOspx(Знач Заведённое)

	Префикс = СтрШаблон("pools/%1/", Заведённое.Пул.Имя);
	Ключи = Новый СписокЗначений();
	Для Каждого Объект Из Выдача.КлиентS3().Перечислить(Префикс) Цикл
		Если СтрЗаканчиваетсяНа(Объект.Ключ, ".ospx") Тогда
			Ключи.Добавить(Сред(Объект.Ключ, СтрДлина(Префикс) + 1));
		КонецЕсли;
	КонецЦикла;
	Ключи.СортироватьПоЗначению();
	Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");

КонецФункции

#КонецОбласти
