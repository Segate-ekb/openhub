// Задача планировщика «переиндексация-readme» на ручных часах: ночной обход описаний идёт в час
// из настройки; час вне суток встаёт на умолчание и не срывает регистрацию соседних задач.

#Использовать asserts
#Использовать "../фикстуры"

Перем Стенд;   // фикстура ПланировщикНаЧасах — планировщик приложения на ручных часах

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("ПланировщикНаЧасах");
	Стенд = Новый ПланировщикНаЧасах();

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "реестр", "Классы"),
		"ЗадачаПереиндексацииREADME");
	Для Каждого Имя Из СтрРазделить("АктуализаторЗаглушка,ЗадачаЗаглушка,ОбработчикСчётчик", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

КонецПроцедуры

// Ноль в настройке часа — это полночь, а не «не задано»: оператор, поставивший 0,
// не получает молча умолчание 3:00.
&Тест
Процедура ЧасПереиндексацииНольЗначитПолночь() Экспорт

	Полночь = Новый АктуализаторЗаглушка();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 23, 0, 0));
	Пл = ПланировщикСПереиндексацией(0, Полночь, Часы);
	Пл.Настроить();

	Часы.Прибавить(3600); // 2026-01-02 00:00
	Пл.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Полночь.Обходов(), "час 0 поставил задачу на полночь").Равно(1);

	// контроль: с умолчальным часом та же полночь задачу не запускает
	Умолчание = Новый АктуализаторЗаглушка();
	ЧасыКонтроля = Новый ЧасыРучные(Дата(2026, 1, 1, 23, 0, 0));
	ПлКонтроля = ПланировщикСПереиндексацией(3, Умолчание, ЧасыКонтроля);
	ПлКонтроля.Настроить();

	ЧасыКонтроля.Прибавить(3600);
	ПлКонтроля.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Умолчание.Обходов(), "КОНТРОЛЬ: час 3 в полночь не срабатывает").Равно(0);

КонецПроцедуры

// Час вне суток — опечатка оператора, а не повод оставить хаб без всех фоновых задач:
// планировщик такое расписание не принимает, и исключение унесло бы всю регистрацию.
&Тест
Процедура ЧасПереиндексацииВнеСутокНеРоняетРегистрациюЗадач() Экспорт

	Актуализатор = Новый АктуализаторЗаглушка();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 2, 0, 0));
	Задачи = Новый Массив();
	Задачи.Добавить(Новый ЗадачаПереиндексацииREADME(Актуализатор, 99, Стенд.Лог()));
	Задачи.Добавить(Новый ЗадачаЗаглушка("сброс-статистики", 999999, Новый ОбработчикСчётчик()));
	Пл = Стенд.Планировщик(Задачи, Часы);
	Пл.Настроить();

	Ожидаем.Что(Пл.ЭкземплярПланировщика().Состояния().Количество(),
		"соседняя задача зарегистрирована вместе с переиндексацией").Равно(2);

	Часы.Прибавить(3600); // 03:00 — умолчальный час
	Пл.ЭкземплярПланировщика().Тик();
	Ожидаем.Что(Актуализатор.Обходов(), "и переиндексация встала на умолчальный час").Равно(1);

КонецПроцедуры

Функция ПланировщикСПереиндексацией(Знач ЧасREADME, Знач Актуализатор, Знач Часы)
	Задачи = Новый Массив();
	Задачи.Добавить(Новый ЗадачаПереиндексацииREADME(Актуализатор, ЧасREADME, Стенд.Лог()));
	Возврат Стенд.Планировщик(Задачи, Часы);
КонецФункции
