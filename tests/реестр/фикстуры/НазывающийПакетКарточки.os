// Фикстура: называет журналу аудита единственный пакет — «team/lib».

// Типы объектов, которые называет фикстура.
//
// Возвращаемое значение:
//  Массив из Строка - только «пакет».
//
Функция НазываемыеТипы() Экспорт
	Типы = Новый Массив();
	Типы.Добавить("пакет");
	Возврат Типы;
КонецФункции

// Имена пакета для адреса журнала.
//
// Параметры:
//  ТипОбъекта - Строка - «пакет».
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура - Имя и Пул.
//
Функция ИменаОбъекта(Знач ТипОбъекта, Знач Идентификатор) Экспорт
	Возврат Новый Структура("Имя, Пул", "lib", "team");
КонецФункции
