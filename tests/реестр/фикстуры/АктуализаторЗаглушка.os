// Заглушка актуализатора описаний: считает ночные обходы.

Перем Обходов_;

// Контракт АктуализаторОписаний: засчитывает обход.
//
// Возвращаемое значение:
//  Структура - Обработано, Пропущено: всегда нули.
//
Функция Актуализировать() Экспорт
	Обходов_ = Обходов_ + 1;
	Возврат Новый Структура("Обработано, Пропущено", 0, 0);
КонецФункции

// Сколько раз звали Актуализировать().
//
// Возвращаемое значение:
//  Число.
//
Функция Обходов() Экспорт
	Возврат Обходов_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Обходов_ = 0;
КонецПроцедуры
