// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:InvalidCharacterInFile-off
// BSLLS:YoLetterUsage-off
// Считающая обёртка над хранилищем, которое отвечает по версиям, — ХранилищеЗависимостей либо
// ХранилищеМетокВерсий: строки отдаёт настоящее, счёт — там, где цена уборки растёт числом версий.

Перем Хранилище;   // ХранилищеЗависимостей либо ХранилищеМетокВерсий — настоящий источник строк
Перем Счетчик;     // СчётчикОбращений — счёт обращений к хранилищу

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число
//
Функция Обращений() Экспорт
	Возврат Счетчик.Обращений();
КонецФункции

// Контракт ХранилищаЗависимостей: зависимости одной версии; считает обращение.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Массив из ЗависимостьВерсии
//
Функция ПоВерсии(Знач ВерсияИдентификатор) Экспорт
	Счетчик.Отметить();
	Возврат Хранилище.ПоВерсии(ВерсияИдентификатор);
КонецФункции

// Контракт ХранилищаЗависимостей: зависимости перечисленных версий; считает обращение.
//
// Параметры:
//  ВерсияИдентификаторы - Массив из Число - идентификаторы версий.
//
// Возвращаемое значение:
//  Массив из ЗависимостьВерсии
//
Функция ПоВерсиям(Знач ВерсияИдентификаторы) Экспорт
	Счетчик.Отметить();
	Возврат Хранилище.ПоВерсиям(ВерсияИдентификаторы);
КонецФункции

// Контракт ХранилищаМетокВерсий: метки одной версии; считает обращение.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Массив из МеткаВерсии
//
Функция ПолучитьПоВерсияИдентификаторРавно(Знач ВерсияИдентификатор) Экспорт
	Счетчик.Отметить();
	Возврат Хранилище.ПолучитьПоВерсияИдентификаторРавно(ВерсияИдентификатор);
КонецФункции

// Контракт ХранилищаМетокВерсий: метки перечисленных версий; считает обращение.
//
// Параметры:
//  ВерсияИдентификаторы - Массив из Число - идентификаторы версий.
//
// Возвращаемое значение:
//  Массив из МеткаВерсии
//
Функция МеткиВерсий(Знач ВерсияИдентификаторы) Экспорт
	Счетчик.Отметить();
	Возврат Хранилище.МеткиВерсий(ВерсияИдентификаторы);
КонецФункции

Процедура ПриСозданииОбъекта(Знач НастоящееХранилище)
	Хранилище = НастоящееХранилище;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счетчик = Новый СчётчикОбращений();
КонецПроцедуры
