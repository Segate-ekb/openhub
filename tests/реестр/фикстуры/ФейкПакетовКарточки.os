// Фикстура: один пакет в памяти вместо СервисПакетов — правка карточки читает его
// и пишет поля так же, как настоящая служба; число записей считается.

Перем Пакет Экспорт;   // Структура — поля пакета
Перем Записей Экспорт; // Число — сколько раз карточку записали

// Пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено - пакет; чужой идентификатор — Неопределено.
//
Функция ПакетПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат ?(Цел(Идентификатор) = Пакет.Идентификатор, Пакет, Неопределено);
КонецФункции

// Записывает поля карточки, как СервисПакетов.ОбновитьМетаданные.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//  Свойства - Структура - записываемые поля.
//
// Возвращаемое значение:
//  Структура - пакет после записи.
//
Функция ОбновитьМетаданные(Знач Идентификатор, Знач Свойства) Экспорт
	Для Каждого Пара Из Свойства Цикл
		Пакет.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	Записей = Записей + 1;
	Возврат Пакет;
КонецФункции

Процедура ПриСозданииОбъекта(Знач АдресРепозитория = "") Экспорт
	Пакет = Новый Структура("Идентификатор, Описание, КлючевыеСлова, Лицензия, АдресРепозитория,"
		+ " Устарел, Скрыт", 7, "Описание", "", "MIT", АдресРепозитория, Ложь, Ложь);
	Записей = 0;
КонецПроцедуры
