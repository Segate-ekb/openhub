// Юнит-тесты правила «версия пакета подходит установленному OneScript» (СовместимостьСДвижком):
// минимальная версия движка из манифеста против версии движка установки.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогКлассов = ОбъединитьПути(КаталогиПроекта.Корень(), "src",
		ОбъединитьПути("модули", "реестр", "Классы"));
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ВерсияБезТребованияПодходитЛюбомуДвижку() Экспорт

	Для Каждого Движок Из СтрРазделить("1.0.0,2.2.1,1.0.21.5", ",") Цикл
		Ожидаем.Что(Совместимость().Подходит(Версия(""), Движок),
			"пустое engine-version — ограничения нет, движок " + Движок).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТребованиеМладшеИлиРавноеПодходит() Экспорт

	Ожидаем.Что(Совместимость().Подходит(Версия("1.9.0"), "2.2.1"), "младше").ЭтоИстина();
	Ожидаем.Что(Совместимость().Подходит(Версия("2.2.1"), "2.2.1"), "равно").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТребованиеСтаршеНеПодходит() Экспорт

	Ожидаем.Что(Совместимость().Подходит(Версия("2.2.0"), "2.0.0")).ЭтоЛожь();
	Ожидаем.Что(Совместимость().Подходит(Версия("2.0.1"), "2.0.0"), "старше на патч").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура LegacyВерсииСравниваютсяПоЧетвёртомуЧислу() Экспорт

	Ожидаем.Что(Совместимость().Подходит(Версия("1.0.21.5"), "1.0.21.4"), "legacy старше").ЭтоЛожь();
	Ожидаем.Что(Совместимость().Подходит(Версия("1.0.21.5"), "1.0.21.5"), "legacy равно").ЭтоИстина();
	Ожидаем.Что(Совместимость().Подходит(Версия("1.0.21.5"), "2.2.1"), "legacy против semver").ЭтоИстина();
	Ожидаем.Что(Совместимость().Подходит(Версия("1.9.3"), "1.0.21.5"), "semver против legacy").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеразбираемоеТребованиеНеОграничивает() Экспорт

	Для Каждого Требование Из СтрРазделить(">=1.0.21;latest;1.x", ";") Цикл
		Ожидаем.Что(Совместимость().Подходит(Версия(Требование), "1.0.0"),
			"engine-version """ + Требование + """ — не ограничение").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПустойДвижокНеСужаетВыбор() Экспорт

	Кандидаты = Новый Массив();
	Кандидаты.Добавить(Версия("9.0.0"));
	Кандидаты.Добавить(Версия(""));

	Ожидаем.Что(Совместимость().Отобрать(Кандидаты, "").Количество()).Равно(2);
	Ожидаем.Что(Совместимость().Подходит(Версия("9.0.0"), "  "), "пробелы — движок не назван").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтборСохраняетПорядокИОтсеиваетСтаршие() Экспорт

	Кандидаты = Новый Массив();
	Кандидаты.Добавить(Версия("", "1.0.0"));
	Кандидаты.Добавить(Версия("1.9.0", "1.1.0"));
	Кандидаты.Добавить(Версия("2.2.0", "1.2.0"));

	Подходящие = Совместимость().Отобрать(Кандидаты, "2.0.0");

	Ожидаем.Что(Подходящие.Количество()).Равно(2);
	Ожидаем.Что(Подходящие[0].Версия).Равно("1.0.0");
	Ожидаем.Что(Подходящие[1].Версия).Равно("1.1.0");

КонецПроцедуры

&Тест
Процедура ВерсияДвижкаКорректнаДляВерсийИПустой() Экспорт

	Для Каждого Движок Из СтрРазделить("2.2.1;1.0.21.5;", ";") Цикл
		Ожидаем.Что(Совместимость().ВерсияКорректна(Движок), "движок """ + Движок + """").ЭтоИстина();
	КонецЦикла;
	Для Каждого Движок Из СтрРазделить("abc;2.x;>=2.0", ";") Цикл
		Ожидаем.Что(Совместимость().ВерсияКорректна(Движок), "движок """ + Движок + """").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// --- служебные ---

Функция Совместимость()
	Возврат Новый СовместимостьСДвижком(Новый СравнительВерсий());
КонецФункции

// Правилу нужна только требуемая версия движка: запись версии — структурой с тем же полем.
Функция Версия(Знач ВерсияДвижка, Знач Номер = "1.0.0")
	Возврат Новый Структура("Версия, ВерсияДвижка", Номер, ВерсияДвижка);
КонецФункции
