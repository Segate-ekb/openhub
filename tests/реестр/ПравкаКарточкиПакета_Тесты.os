// Адрес репозитория, который мейнтейнер вводит руками: правило годности (ПравилаИменования)
// и дверь правки карточки (ПравкаКарточкиПакета) — что записано и что ушло в журнал аудита.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ПравилаИменования");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ПравкаКарточкиПакета");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"), "СобытиеАудита");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкПакетовКарточки");
	РеестрФикстур.Подключить("НазывающийПакетКарточки");

КонецПроцедуры

#Область ПравилоАдреса

&Тест
Процедура ГодныйАдресПринимается() Экспорт

	Для Каждого Адрес Из СтрРазделить("https://github.com/sfaqer/lambdas|HTTPS://GitHub.com/acme/lib"
		+ "|https://gitlab.acme.ru:8443/team/lib|https://github.com", "|") Цикл
		Ожидаем.Что(Правила().ОтказАдресаРепозитория(Адрес), "годен: " + Адрес).Равно("");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПустойАдресГоденИСнимаетАдрес() Экспорт

	Ожидаем.Что(Правила().ОтказАдресаРепозитория(""), "пусто").Равно("");
	Ожидаем.Что(Правила().ОтказАдресаРепозитория("   "), "пробелы по краям").Равно("");
	Ожидаем.Что(Правила().ОтказАдресаРепозитория(Неопределено), "Неопределено").Равно("");

КонецПроцедуры

// Граница — 500 символов включительно.
&Тест
Процедура ПределДлиныПятьсотСимволов() Экспорт

	Приставка = "https://github.com/acme/";
	Ровно = Приставка + Повтор("x", 500 - СтрДлина(Приставка));
	Ожидаем.Что(СтрДлина(Ровно), "самотест длины").Равно(500);

	Ожидаем.Что(Правила().ОтказАдресаРепозитория(Ровно), "500 — годен").Равно("");
	Ожидаем.Что(Правила().ОтказАдресаРепозитория(Ровно + "x"), "501 — отказ")
		.Содержит("длиннее 500");

КонецПроцедуры

&Тест
Процедура ПробелИУправляющиеСимволыОтвергаются() Экспорт

	Негодные = Новый Массив();
	Негодные.Добавить("https://github.com/acme/li b");
	Негодные.Добавить("https://github.com/acme/" + Символы.Таб + "lib");
	Негодные.Добавить("https://github.com/acme/" + Символ(0) + "lib");
	Негодные.Добавить("https://github.com/acme/" + Символ(127) + "lib");
	Негодные.Добавить("https://github.com/acme/" + Символы.ПС + "lib");

	Для Каждого Адрес Из Негодные Цикл
		Ожидаем.Что(Правила().ОтказАдресаРепозитория(Адрес), "отказ: " + КодыСимволов(Адрес))
			.Содержит("пробелы или управляющие");
	КонецЦикла;

КонецПроцедуры

// Хост — по разбору адреса: приставка «https://» хоста ещё не называет.
&Тест
Процедура АдресБезИмениХостаИлиНеHttpsОтвергается() Экспорт

	Негодные = СтрРазделить("http://github.com/acme/lib|javascript:alert(1)|ftp://github.com/x"
		+ "|https://|https:///acme|https://?x|https://#a|https://@|https://:80|https://user@github.com/x"
		+ "|github.com/acme/lib|//github.com/acme/lib", "|");

	Для Каждого Адрес Из Негодные Цикл
		Ожидаем.Что(Правила().ОтказАдресаРепозитория(Адрес), "отказ: " + Адрес)
			.Содержит("https://хост");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ДверьПравки

&Тест
Процедура ГодныйАдресЗаписываетсяИПишетсяВЖурнал() Экспорт

	Пакеты = Новый ФейкПакетовКарточки("");
	Журнал = Новый ЗаписывающийПодписчик();
	Правка = НоваяПравка(Пакеты, Журнал);

	Правка.Править(7, ПоляСАдресом(" https://github.com/acme/lib "), "alice");

	Ожидаем.Что(Пакеты.Пакет.АдресРепозитория, "записан без пробелов по краям")
		.Равно("https://github.com/acme/lib");
	Ожидаем.Что(Журнал.Количество(ТипПравки()), "одна запись").Равно(1);
	Данные = Журнал.Первое(ТипПравки()).Данные;
	Ожидаем.Что(Данные.Кто, "кто").Равно("alice");
	Ожидаем.Что(Данные.Действие, "действие").Равно(ТипПравки());
	Ожидаем.Что(Данные.Объект, "пакет").Равно("team/lib");
	Детали = Детали(Данные);
	Ожидаем.Что(Детали.Количество(), "назван только изменённый").Равно(1);
	Ожидаем.Что(Детали.Получить("репозиторий").Получить("было"), "было").Равно("");
	Ожидаем.Что(Детали.Получить("репозиторий").Получить("стало"), "стало")
		.Равно("https://github.com/acme/lib");

КонецПроцедуры

&Тест
Процедура ПравкаБезИзмененийСобытияНеДаёт() Экспорт

	Пакеты = Новый ФейкПакетовКарточки("https://github.com/acme/lib");
	Журнал = Новый ЗаписывающийПодписчик();

	НоваяПравка(Пакеты, Журнал).Править(7, ПоляСАдресом("https://github.com/acme/lib"), "alice");

	Ожидаем.Что(Пакеты.Записей, "самотест: форма записана").Равно(1);
	Ожидаем.Что(Журнал.Количество(ТипПравки()), "без изменений — без записи").Равно(0);

КонецПроцедуры

&Тест
Процедура НегодныйАдресНеЗаписываетсяИСобытияНеДаёт() Экспорт

	Пакеты = Новый ФейкПакетовКарточки("https://github.com/acme/lib");
	Журнал = Новый ЗаписывающийПодписчик();

	Попытка
		НоваяПравка(Пакеты, Журнал).Править(7, ПоляСАдресом("http://github.com/acme/lib"), "alice");
		Отказ = "";
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "отказ словами правила").Содержит("https://хост");
	Ожидаем.Что(Пакеты.Записей, "ничего не записано").Равно(0);
	Ожидаем.Что(Пакеты.Пакет.АдресРепозитория, "адрес прежний").Равно("https://github.com/acme/lib");
	Ожидаем.Что(Журнал.Количество(ТипПравки()), "события нет").Равно(0);

КонецПроцедуры

// Прежний адрес мог приехать из манифеста по правилу http(s): правку соседних полей он
// не запирает, пока его не меняют.
&Тест
Процедура НеизменённыйПрежнийHttpАдресПравкуНеБлокирует() Экспорт

	Пакеты = Новый ФейкПакетовКарточки("http://example.org/lib");
	Журнал = Новый ЗаписывающийПодписчик();
	Поля = ПоляСАдресом("http://example.org/lib");
	Поля.Вставить("Описание", "Новое описание");

	НоваяПравка(Пакеты, Журнал).Править(7, Поля, "alice");

	Ожидаем.Что(Пакеты.Пакет.Описание, "описание записано").Равно("Новое описание");
	Ожидаем.Что(Пакеты.Пакет.АдресРепозитория, "адрес на месте").Равно("http://example.org/lib");
	Детали = Детали(Журнал.Первое(ТипПравки()).Данные);
	Ожидаем.Что(Детали.Получить("репозиторий"), "адреса в записи нет").Равно(Неопределено);
	Ожидаем.Что(Детали.Получить("описание").Получить("стало"), "описание в записи")
		.Равно("Новое описание");

КонецПроцедуры

&Тест
Процедура ПустоеПолеСнимаетАдресИПишетсяВЖурнал() Экспорт

	Пакеты = Новый ФейкПакетовКарточки("https://github.com/acme/lib");
	Журнал = Новый ЗаписывающийПодписчик();

	НоваяПравка(Пакеты, Журнал).Править(7, ПоляСАдресом(""), "alice");

	Ожидаем.Что(Пакеты.Пакет.АдресРепозитория, "адрес снят").Равно("");
	Ожидаем.Что(Детали(Журнал.Первое(ТипПравки()).Данные).Получить("репозиторий").Получить("стало"),
		"снятие записано").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Правила()
	Возврат Новый ПравилаИменования();
КонецФункции

Функция НоваяПравка(Знач Пакеты, Знач Журнал)

	Издатель = Новый ИздательСобытий();
	Издатель.Подписать(Издатель.ТипКарточкаПакетаИзменена(), Журнал);

	Называющие = Новый Массив();
	Называющие.Добавить(Новый НазывающийПакетКарточки());
	Имена = Новый ИмяОбъектаАудита(Называющие);

	Возврат Новый ПравкаКарточкиПакета(Пакеты, Правила(), Имена,
		Новый СобытиеАудита(Имена, Новый ТекстJSON()), Издатель);

КонецФункции

// Подробности записи журнала значением: поле → было и стало.
Функция Детали(Знач Данные)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Данные.ДеталиJSON);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ПоляСАдресом(Знач Адрес)
	Возврат Новый Структура("Описание, КлючевыеСлова, Лицензия, АдресРепозитория, Устарел, Скрыт",
		"Описание", "", "MIT", Адрес, Ложь, Ложь);
КонецФункции

Функция ТипПравки()
	Возврат "пакет.карточка.изменена";
КонецФункции

Функция Повтор(Знач Символ_, Знач Сколько)
	Результат = "";
	Для Номер = 1 По Сколько Цикл
		Результат = Результат + Символ_;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КодыСимволов(Знач Текст)
	Коды = Новый Массив();
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Коды.Добавить(Строка(КодСимвола(Сред(Текст, Поз, 1))));
	КонецЦикла;
	Возврат СтрСоединить(Коды, ",");
КонецФункции

#КонецОбласти
