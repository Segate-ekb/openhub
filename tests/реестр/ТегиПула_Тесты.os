// Теги пула в контейнере ОСени на КоннекторInMemory: пакет наследует теги пула вживую, своя
// копия перекрывает тег пула, выключенный тег пропадает у пакета, галка пула включает
// и выключает наследование; основной тег, запрет перезаписи и имя тега против номеров версий.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "../фикстуры"

Перем ПоискКлассов;     // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;          // общий контейнер на все тесты набора
Перем Засев;            // фикстура ЗасевРеестра — пул, пакет и версия службами хаба
Перем КореньХранилища;  // временный корень файлового хранилища артефактов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	// удаление пакета снимает строки соседей: их таблицы и реализации последствий удаления
	ПоискКлассов.ПодключитьТаблицы(КаталогМодулей, "вход, зеркала, права, подписки, публикация, статистика");
	ПоискКлассов.ПодключитьРеализации(КаталогМодулей, "ПоследствияУдаленияПакета, ПоследствияУдаленияПула");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы")));
	РеестрНастроекХаба.ПодключитьКлассы(ПоискКлассов, КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"), "ГотовностьХаба");

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	РеестрФикстур.Подключить("ЖурналАудитаФайлом");

	Детальки = Новый Соответствие();
	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-pool-tags");
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "теги-пула-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = СоветНабора.СДетальками(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	УникальныеИмена.УбратьВременное(КореньХранилища);
КонецПроцедуры

#Область Наследование

// Включённая галка: пакет пула отдаёт stable, prerelease и develop пула, ничего не заводя у себя;
// раздел тегов пакета показывает их унаследованными.
&Тест
Процедура ПакетНаследуетТегиПулаВживую() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0,2.0.0-rc1,2.0.0-alpha");

	Ожидаем.Что(Резолв(Пакет, "stable"), "pkg@stable — тег пула").Равно("1.1.0");
	Ожидаем.Что(Резолв(Пакет, "prerelease"), "pkg@prerelease").Равно("2.0.0-rc1");
	Ожидаем.Что(Резолв(Пакет, "develop"), "pkg@develop").Равно("2.0.0-alpha");
	Ожидаем.Что(Теги().СвоиТегиПакета(Пакет.Идентификатор).Количество(), "своих тегов у пакета нет").Равно(0);

	Каналы = Теги().КаналыПакета(Пакет.Идентификатор);
	Ожидаем.Что(ИменаКаналов(Каналы), "раздел видит три тега пула").Равно("develop,prerelease,stable");
	Ожидаем.Что(Каналы.Происхождение.Получить("stable"), "stable — от пула").Равно("пул");

КонецПроцедуры

// Правка тега пула доезжает до пакета без публикации и без перезаписи пакета: резолв видит новое
// правило сразу, хотя снимок каналов пакета до правки уже лежал в кэше.
&Тест
Процедура ПравкаТегаПулаДоезжаетБезПубликации() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0,2.0.0");
	Ожидаем.Что(Резолв(Пакет, "stable"), "до правки").Равно("2.0.0");

	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "stable", "semver", "^1.0", "owner");

	Ожидаем.Что(Резолв(Пакет, "stable"), "правка пула доехала сразу").Равно("1.1.0");
	Ожидаем.Что(Теги().СвоиТегиПакета(Пакет.Идентификатор).Количество(), "пакет не перезаписан").Равно(0);

	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "lts", "semver", "^1.0", "owner");
	Ожидаем.Что(Резолв(Пакет, "lts"), "новый тег пула — тоже").Равно("1.1.0");

КонецПроцедуры

// Правка унаследованного тега у пакета заводит копию с правкой: тег пула не меняется, соседний пакет
// видит тег пула, раздел пакета называет копию перекрывающей.
&Тест
Процедура КопияПерекрываетТегПулаТолькоУСвоегоПакета() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0,2.0.0");
	Сосед = ПакетСВерсиями(Пул, "1.0.0,2.0.0");

	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "stable", "semver", "^1.0", "maint");

	Ожидаем.Что(Резолв(Пакет, "stable"), "у пакета — копия").Равно("1.1.0");
	Ожидаем.Что(Резолв(Сосед, "stable"), "у соседа — тег пула").Равно("2.0.0");
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable").Правило,
		"тег пула не изменился").Равно(ПредложениеВизарда("stable").Правило);

	Копия = Теги().НайтиСвойТег(Пакет.Идентификатор, "stable");
	Ожидаем.Что(Копия, "копия — свой тег пакета").Не_().Равно(Неопределено);
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "STABLE"),
		"копия перекрывает тег пула, имя без регистра").Равно("перекрывает");
	Ожидаем.Что(Теги().ПроисхождениеТега(Сосед.Идентификатор, "stable"), "у соседа — от пула").Равно("пул");
	Ожидаем.Что(КаналыВерсии(Пакет, "2.0.0"), "отбор подписок судит пакет по копии").Равно("prerelease");
	Ожидаем.Что(КаналыВерсии(Сосед, "2.0.0"), "а соседа — по тегу пула").Равно("stable,prerelease");

	// правка тега пула до пакета с копией не доезжает: копия заменяет тег пула целиком
	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "stable", "semver", ">=2.0.0", "owner");
	Ожидаем.Что(Резолв(Пакет, "stable"), "копия держит своё правило").Равно("1.1.0");

КонецПроцедуры

// Копия начинается с правила и оформления пула: правка одного запрета перезаписи не теряет правила.
&Тест
Процедура КопияНачинаетсяСПравилаПула() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,2.0.0-rc1");

	Теги().УстановитьЗапретПерезаписи(Пакет.Идентификатор, "prerelease", Ложь, "maint");

	Копия = Теги().НайтиСвойТег(Пакет.Идентификатор, "prerelease");
	Ожидаем.Что(Копия, "смена запрета завела копию").Не_().Равно(Неопределено);
	Ожидаем.Что(Копия.Правило, "с правилом пула").Равно(ПредложениеВизарда("prerelease").Правило);
	Ожидаем.Что(Копия.Стиль, "и его оформлением").Равно(ПредложениеВизарда("prerelease").Стиль);
	Ожидаем.Что(Теги().ЗапретСнят(Копия), "запрет снят у копии").ЭтоИстина();
	Ожидаем.Что(ТегиПула().ЗапретСнят(ТегиПула().НайтиТегПула(Пул.Идентификатор, "prerelease")),
		"а у тега пула — нет").ЭтоЛожь();
	Ожидаем.Что(Резолв(Пакет, "prerelease"), "резолв не сломан").Равно("2.0.0-rc1");

КонецПроцедуры

// Снятие копии возвращает пакету тег пула.
&Тест
Процедура СнятиеКопииВозвращаетТегПула() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0,2.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "stable", "semver", "^1.0", "maint");
	Ожидаем.Что(Резолв(Пакет, "stable"), "копия").Равно("1.1.0");

	Ожидаем.Что(Теги().УдалитьТег(Пакет.Идентификатор, "stable", "maint"), "копия снята").ЭтоИстина();

	Ожидаем.Что(Резолв(Пакет, "stable"), "вернулся тег пула").Равно("2.0.0");
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "от пула").Равно("пул");

КонецПроцедуры

// Выключенный у пакета тег пула у пакета не существует: ни резолва, ни раздела, ни отбора подписок.
// Включение возвращает его; своя копия при выключении снимается.
&Тест
Процедура ВыключенныйТегПулаУПакетаНеСуществует() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,2.0.0-alpha");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "develop", "regex", "^2\..*$", "maint");

	Ожидаем.Что(Теги().ВыключитьТегПула(Пакет.Идентификатор, "develop", "maint"), "выключен").ЭтоИстина();

	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "develop"), "копия снята выключением").Равно(Неопределено);
	Ожидаем.Что(Теги().ТегИзвестен(Пакет, "develop"), "тега у пакета нет").ЭтоЛожь();
	Ожидаем.Что(Резолв(Пакет, "develop"), "и резолва нет").Равно("");
	Ожидаем.Что(КаналыВерсии(Пакет, "2.0.0-alpha"), "отбор подписок его не видит").Равно("");
	Каналы = Теги().КаналыПакета(Пакет.Идентификатор);
	Ожидаем.Что(ИменаКаналов(Каналы), "в каналах его нет").Равно("prerelease,stable");
	Ожидаем.Что(Каналы.Выключенные.Количество(), "раздел видит выключенный").Равно(1);
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "develop"), "выключен").Равно("выключен");

	Ожидаем.Что(Теги().ВключитьТегПула(Пакет.Идентификатор, "develop", "maint"), "включён").ЭтоИстина();
	Ожидаем.Что(Резолв(Пакет, "develop"), "резолв вернулся").Равно("2.0.0-alpha");
	Ожидаем.Что(КаналыВерсии(Пакет, "2.0.0-alpha"), "и отбор подписок").Равно("develop");

КонецПроцедуры

// Выключение держится одной строкой: повторное выключение второй не заводит, своя копия
// выключение снимает, а выключить можно только тег пула.
&Тест
Процедура ВыключениеОдноНаИмяИСнимаетсяКопией() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");

	Теги().ВыключитьТегПула(Пакет.Идентификатор, "stable", "maint");
	Теги().ВыключитьТегПула(Пакет.Идентификатор, "STABLE", "maint");
	Ожидаем.Что(ВыключенийУПакета(Пакет), "дубля выключения нет").Равно(1);

	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "stable", "semver", "*", "maint");
	Ожидаем.Что(ВыключенийУПакета(Пакет), "копия сняла выключение").Равно(0);
	Ожидаем.Что(Теги().ПроисхождениеТега(Пакет.Идентификатор, "stable"), "теперь копия").Равно("перекрывает");

	Ожидаем.Что(Теги().ВыключитьТегПула(Пакет.Идентификатор, "nosuch", "maint"),
		"тег, которого у пула нет, не выключается").ЭтоЛожь();
	Ожидаем.Что(Теги().ВключитьТегПула(Пакет.Идентификатор, "prerelease", "maint"),
		"не выключенный не включается").ЭтоЛожь();

КонецПроцедуры

// Галку сняли — теги пула пакетам не наследуются, свои копии остаются, набор пула хранится;
// вернули — наследование вернулось, а набор не перезаполняется визардом.
&Тест
Процедура ГалкуСнялиИВернули() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0,2.0.0-rc1");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "stable", "semver", "^1.0", "maint");
	ТегиПула().УдалитьТегПула(Пул.Идентификатор, "develop", "owner");

	ТегиПула().УстановитьНаследование(Пул.Идентификатор, Ложь, "owner");

	Ожидаем.Что(Теги().ТегИзвестен(Пакет, "prerelease"), "галки нет — тег пула не наследуется").ЭтоЛожь();
	Ожидаем.Что(Резолв(Пакет, "stable"), "своя копия осталась").Равно("1.1.0");
	Ожидаем.Что(ИменаКаналов(Теги().КаналыПакета(Пакет.Идентификатор)), "у пакета только копия")
		.Равно("stable");
	Ожидаем.Что(ТегиПула().ТегиПула(Пул.Идентификатор).Количество(), "набор пула хранится").Равно(2);

	Итог = ТегиПула().УстановитьНаследование(Пул.Идентификатор, Истина, "owner");

	Ожидаем.Что(Итог.Создано.Количество(), "повторное включение набор не заполняет").Равно(0);
	Ожидаем.Что(Резолв(Пакет, "prerelease"), "наследование вернулось").Равно("2.0.0-rc1");
	Ожидаем.Что(Теги().ТегИзвестен(Пакет, "develop"), "удалённый владельцем канал не воскрес").ЭтоЛожь();

КонецПроцедуры

// Первое включение галки заполняет набор пула тремя каналами визарда с их правилами: develop
// с разрешённой перезаписью, stable — основной.
&Тест
Процедура ПервоеВключениеЗаполняетНаборКаналамиВизарда() Экспорт

	Пул = Засев.ПулСервисом();
	Итог = ТегиПула().УстановитьНаследование(Пул.Идентификатор, Истина, "owner");

	Ожидаем.Что(СтрСоединить(Итог.Создано, ","), "три канала").Равно("stable,prerelease,develop");
	Для Каждого Предложение Из Желудь("КаналыПоУмолчанию").Предложения() Цикл
		ТегПула = ТегиПула().НайтиТегПула(Пул.Идентификатор, Предложение.Имя);
		Ожидаем.Что(ТегПула.Правило, СтрШаблон("правило %1 — как у визарда", Предложение.Имя))
			.Равно(Предложение.Правило);
		Ожидаем.Что(ТегиПула().ЗапретСнят(ТегПула), СтрШаблон("перезапись %1", Предложение.Имя))
			.Равно(Предложение.ПерезаписьРазрешена);
	КонецЦикла;
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "stable").ПоУмолчанию, "stable основной").ЭтоИстина();
	Ожидаем.Что(ТегиПула().НаследованиеВключено(
		Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор)), "галка включена").ЭтоИстина();

КонецПроцедуры

// Тег пула — только правило: ручная метка на унаследованный тег отбивается, как на свой тег-правило,
// и копии не заводит.
&Тест
Процедура РучнаяМеткаНаУнаследованныйТегОтбивается() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");

	Отказано = Ложь;
	Попытка
		Теги().ПометитьВерсию(Пакет.Идентификатор, "stable", "1.0.0", "maint");
	Исключение
		Отказано = Истина;
	КонецПопытки;

	Ожидаем.Что(Отказано, "метка на тег пула отбита").ЭтоИстина();
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "stable"), "копии нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОсновнойТег

// Основной тег пула — основной у пакета, пока у пакета нет своего: установка без тега идёт за ним;
// пометка своего основного (на унаследованном — копией) перебивает пул.
&Тест
Процедура ОсновнойТегПулаПокаУПакетаНетСвоего() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0,2.0.0-rc1");

	Ожидаем.Что(Резолв(Пакет, ""), "без тега — основной пула stable").Равно("1.1.0");

	ТегиПула().НазначитьОсновным(Пул.Идентификатор, "prerelease");
	Ожидаем.Что(Резолв(Пакет, ""), "основной пула переехал — и у пакета").Равно("2.0.0-rc1");

	Ожидаем.Что(Теги().НазначитьПоУмолчанию(Пакет.Идентификатор, "stable"), "свой основной").ЭтоИстина();
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "stable").ПоУмолчанию, "копия основная").ЭтоИстина();
	Ожидаем.Что(Резолв(Пакет, ""), "свой основной перебил пул").Равно("1.1.0");

	ТегиПула().НазначитьОсновным(Пул.Идентификатор, "develop");
	Ожидаем.Что(Резолв(Пакет, ""), "пул пакету больше не указ").Равно("1.1.0");

КонецПроцедуры

// Копия основного тега пула остаётся основной: основной тег пула судится по имени.
&Тест
Процедура КопияОсновногоТегаПулаОсновная() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,1.1.0,2.0.0");
	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "stable", "semver", "^1.0", "maint");

	Ожидаем.Что(Резолв(Пакет, ""), "основной — копия stable").Равно("1.1.0");
	Ожидаем.Что(Теги().НайтиСвойТег(Пакет.Идентификатор, "stable").ПоУмолчанию,
		"в базе копия пометки не несёт").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Перезапись

// Запрет повторной публикации считается по тегам пакета с унаследованными: develop пула со снятым
// запретом пускает переиздание, stable пула — держит запрет.
&Тест
Процедура ПерезаписьПоУнаследованномуТегу() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0,2.0.0-alpha");

	Ожидаем.Что(Приём().ПричинаОтказаПубликации(Пул, Пакет.Имя, "2.0.0-alpha"),
		"номер под develop пула переиздаётся без force").Равно(Неопределено);

	Отказ = Приём().ПричинаОтказаПубликации(Пул, Пакет.Имя, "1.0.0");
	Ожидаем.Что(Отказ.Код, "номер под stable пула — конфликт").Равно(409);
	Ожидаем.Что(СтрНайти(Отказ.Сообщение, """stable""") > 0, "отказ называет тег пула").ЭтоИстина();

	Теги().ВыключитьТегПула(Пакет.Идентификатор, "develop", "maint");
	Ожидаем.Что(Приём().ПричинаОтказаПубликации(Пул, Пакет.Имя, "2.0.0-alpha").Код,
		"выключенный develop запрет больше не снимает").Равно(409);

КонецПроцедуры

#КонецОбласти

#Область ИмяТегаИНомерВерсии

// Имя тега пула не совпадает с номером версии ни одного пакета пула: тег не заводится, пока номер
// занят, а заведённый тег отбивает такой номер у любого пакета пула — и у нового, и при любой галке.
&Тест
Процедура ИмяТегаПулаПротивНомеровВерсийПакетовПула() Экспорт

	Пул = ПулСГалкой();
	ПакетСВерсиями(Пул, "1.0.0,2.5");

	Ожидаем.Что(ТегиПула().ИмяДляТегаПулаЗанято(Пул.Идентификатор, "2.5"), "имя занято версией").ЭтоИстина();
	Отказано = Ложь;
	Попытка
		ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "2.5", "semver", "*", "owner");
	Исключение
		Отказано = Истина;
	КонецПопытки;
	Ожидаем.Что(Отказано, "тег пула с именем версии не заведён").ЭтоИстина();
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "2.5"), "строки нет").Равно(Неопределено);

	Чужой = Засев.ПулСервисом();
	ПакетСВерсиями(Чужой, "3.5");
	Ожидаем.Что(ТегиПула().ИмяДляТегаПулаЗанято(Пул.Идентификатор, "3.5"),
		"версия пакета чужого пула имени не занимает").ЭтоЛожь();

	// имя тега — годный номер версии: push судит строку правилами публикации раньше тега
	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "9.9.9", "semver", "*", "owner");
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	Отказ = Приём().ПричинаОтказаПубликации(Пул, Пакет.Имя, "9.9.9");
	Ожидаем.Что(Отказ.Код, "push номера-имени тега пула в пакет пула отбит").Равно(400);
	Ожидаем.Что(СтрНайти(Отказ.Сообщение, "имя тега") > 0, "отказ называет причину словами").ЭтоИстина();
	Ожидаем.Что(Приём().ПричинаОтказаПубликации(Пул, "new-pkg", "9.9.9").Код,
		"и в новый пакет пула").Равно(400);
	Ожидаем.Что(ОтказВнешнего(Пул, Пакет.Имя, "develop"), "приём привезённой — тоже").ЭтоИстина();
	Ожидаем.Что(ОтказВнешнего(Пул, Пакет.Имя, "DEVELOP"),
		"сличение — как у лесенки: спецификация DEVELOP досталась бы версии").ЭтоИстина();

	ТегиПула().УстановитьНаследование(Пул.Идентификатор, Ложь, "owner");
	Ожидаем.Что(Приём().ПричинаОтказаПубликации(Пул, Пакет.Имя, "9.9.9").Код,
		"галка выключена — набор пула имени всё равно держит").Равно(400);

	// обратная сторона асимметрии лесенки: версия NIGHTLY спецификацию nightly не перехватит
	Приём().ПринятьВнешнюю(Пул, Пакет.Имя, "NIGHTLY", Неопределено, Новый Структура("Размер, Sha256", 0, ""));
	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "nightly", "regex", "^NIGHTLY$", "owner");
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "nightly"), "тег nightly заведён")
		.Не_().Равно(Неопределено);

КонецПроцедуры

// Уникальность тега пула держит служба: повторное заведение имени правит строку, второй не заводит.
&Тест
Процедура ТегПулаОдинНаИмя() Экспорт

	Пул = Засев.ПулСервисом();
	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "lts", "semver", "^1.0", "owner");
	ТегиПула().ОпределитьТегПула(Пул.Идентификатор, "LTS", "semver", "^2.0", "owner");

	Ожидаем.Что(ТегиПула().ТегиПула(Пул.Идентификатор).Количество(), "одно имя — одна строка").Равно(1);
	Ожидаем.Что(ТегиПула().НайтиТегПула(Пул.Идентификатор, "lts").Правило, "правило заменено").Равно("^2.0");

КонецПроцедуры

#КонецОбласти

#Область Уборка

// Удаление тега пула уносит выключения этого тега у пакетов пула, а копии оставляет своими тегами.
&Тест
Процедура УдалениеТегаПулаОставляетКопииИСнимаетВыключения() Экспорт

	Пул = ПулСГалкой();
	СКопией = ПакетСВерсиями(Пул, "1.0.0,1.1.0");
	СВыключением = ПакетСВерсиями(Пул, "1.0.0");
	Теги().ОпределитьТегПравила(СКопией.Идентификатор, "stable", "semver", "^1.0", "maint");
	Теги().ВыключитьТегПула(СВыключением.Идентификатор, "stable", "maint");

	Ожидаем.Что(ТегиПула().УдалитьТегПула(Пул.Идентификатор, "stable", "owner"), "удалён").ЭтоИстина();

	Ожидаем.Что(Резолв(СКопией, "stable"), "копия осталась своим тегом").Равно("1.1.0");
	Ожидаем.Что(Теги().ПроисхождениеТега(СКопией.Идентификатор, "stable"), "уже свой").Равно("свой");
	Ожидаем.Что(ВыключенийУПакета(СВыключением), "выключение ушло с тегом").Равно(0);

КонецПроцедуры

// Удаление пакета уносит его выключения тегов пула.
&Тест
Процедура УдалениеПакетаУноситВыключения() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	Теги().ВыключитьТегПула(Пакет.Идентификатор, "develop", "maint");
	Ожидаем.Что(ВыключенийУПакета(Пакет), "выключение есть").Равно(1);

	Желудь("УборкаПакета").УдалитьПакет(Пакет);

	Ожидаем.Что(ВыключенийУПакета(Пакет), "ушло с пакетом").Равно(0);

КонецПроцедуры

// Удаление пула уносит его теги пула и выключения тегов у его пакетов, а снимок пула забывается:
// пул с тем же именем, заведённый заново, наследовать нечего.
&Тест
Процедура УдалениеПулаУноситТегиПулаИВыключения() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	Теги().ВыключитьТегПула(Пакет.Идентификатор, "develop", "maint");
	Ожидаем.Что(Резолв(Пакет, "stable"), "КОНТРОЛЬ: снимок пула в кэше").Равно("1.0.0");

	Желудь("СервисПулов").УдалитьПул(Пул.Идентификатор);

	Ожидаем.Что(ТегиПула().ТегиПула(Пул.Идентификатор).Количество(), "тегов пула не осталось").Равно(0);
	Ожидаем.Что(ВыключенийУПакета(Пакет), "выключения ушли с пакетами").Равно(0);
	Ожидаем.Что(Желудь("СнимкиКаналов").СнимокПула(Пул.Идентификатор).Теги.Количество(),
		"снимок пула забыт").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Теги()
	Возврат Желудь("СервисТегов");
КонецФункции

Функция ТегиПула()
	Возврат Желудь("СервисТеговПула");
КонецФункции

Функция Спеки()
	Возврат Желудь("РезолверСпецификации");
КонецФункции

Функция Приём()
	Возврат Желудь("ПриёмВерсии");
КонецФункции

// Версия, которую отдаёт спецификация, строкой; "" — не отдаёт ничего.
Функция Резолв(Знач Пакет, Знач Спецификация)
	Итог = Спеки().Разрешить(Пакет, Спецификация);
	Возврат ?(Итог.Версия = Неопределено, "", Строка(Итог.Версия.Версия));
КонецФункции

// Пул с включённой галкой: первое включение завело ему три канала визарда.
Функция ПулСГалкой()
	Пул = Засев.ПулСервисом();
	ТегиПула().УстановитьНаследование(Пул.Идентификатор, Истина, "owner");
	Возврат Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор);
КонецФункции

Функция ПакетСВерсиями(Знач Пул, Знач СписокВерсий)

	Пакет = Засев.ПакетСервисом(Пул);
	Для Каждого Номер Из СтрРазделить(СписокВерсий, ",", Ложь) Цикл
		Засев.ВерсияСервисом(Пакет, СокрЛП(Номер));
	КонецЦикла;
	Возврат Пакет;

КонецФункции

Функция ПредложениеВизарда(Знач Имя)
	Для Каждого Предложение Из Желудь("КаналыПоУмолчанию").Предложения() Цикл
		Если Предложение.Имя = Имя Тогда
			Возврат Предложение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Имена каналов раскладки по алфавиту.
Функция ИменаКаналов(Знач Раскладка)

	Список = Новый СписокЗначений();
	Для Каждого Канал Из Раскладка.Каналы Цикл
		Список.Добавить(Строка(Канал.Тег.Имя));
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Имена = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Имена.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

Функция КаналыВерсии(Знач Пакет, Знач СтрокаВерсии)
	Возврат СтрСоединить(Желудь("КаналыПоУмолчанию").КаналыВерсии(Пакет.Идентификатор, СтрокаВерсии), ",");
КонецФункции

Функция ВыключенийУПакета(Знач Пакет)
	Выключения = Желудь("ХранилищеВыключенныхТеговПулов").ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор);
	Возврат ?(Выключения = Неопределено, 0, Выключения.Количество());
КонецФункции

Функция ОтказВнешнего(Знач Пул, Знач ИмяПакета, Знач Номер)
	Попытка
		Приём().ПринятьВнешнюю(Пул, ИмяПакета, Номер, Неопределено, Новый Структура("Размер, Sha256", 0, ""));
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

#КонецОбласти
