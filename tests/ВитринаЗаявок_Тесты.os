// «Входящие» пула на экране: сводка манифеста разворотом под строкой заявки, раскрывашка
// с подробностями и сведения на шаге подтверждения. Разметку печатает настоящая ВитринаЗаявокПула, база
// не нужна: строки заявок задаёт тест.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;       // СборкаUI — граф компонентов и рендереров web-ui
Перем Витрина;  // ВитринаЗаявокПула

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьВитрину() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "настройки");
	Поиск.Подключить(КаталогНастроек, "БланкРаздела");
	Поиск.Подключить(КаталогНастроек, "ВитринаЗаявокПула");

	Витрина = Новый ВитринаЗаявокПула(UI.Кит, UI.РендерерНастроек, Новый АдресаСтраниц(), UI.Тексты,
		Новый БланкРаздела(UI.Кит), UI.Примечания);

КонецПроцедуры

#Область СтрокаЗаявки

// Строка заявки называет пакет не только именем: чем он себя назвал, сколько тянет за собой
// и где его исходники — видно без раскрытия.
&Тест
Процедура СтрокаЗаявкиПоказываетСводкуМанифеста() Экспорт

	Разметка = Список(СтрокаВходящих(ПолныйМанифест()));

	Ожидаем.Что(Разметка, "описание в строке").Содержит("Разбор YAML для OneScript");
	Ожидаем.Что(Разметка, "число зависимостей без зависимостей разработки").Содержит("зависимостей: 2");
	Ожидаем.Что(Разметка, "репозиторий — ссылкой").Содержит("href=""https://github.com/acme/yaml""");
	Ожидаем.Что(Разметка, "видимый текст ссылки — без схемы").Содержит(">github.com/acme/yaml<");

КонецПроцедуры

// Сведения манифеста — разворотом под строкой во всю ширину таблицы, а не в первой колонке:
// там описание ломалось по слову, а ряд вытягивался на весь экран вместе с кнопками решения.
// Ширина разворота — все колонки таблицы, и со столбцом «Пул» сводки тоже.
&Тест
Процедура СведенияМанифестаИдутВоВсюШиринуПодСтрокойЗаявки() Экспорт

	Разметка = Список(СтрокаВходящих(ПолныйМанифест()));
	Запись = РядТаблицы(Разметка, "table__record");
	Разворот = РядТаблицы(Разметка, "table__expand");

	Ожидаем.Что(Запись, "строка заявки на месте").Содержит(">yaml<");
	Ожидаем.Что(СтрНайти(Запись, "Разбор YAML"), "описания в строке заявки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Запись, "<details"), "раскрывашки в строке заявки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "</tr><tr class=""table__expand"">") > 0,
		"разворот — следующий ряд за строкой заявки").ЭтоИстина();

	Ожидаем.Что(Разворот, "разворот занял все пять колонок").Содержит("<td colspan=""5"">");
	Ожидаем.Что(Разворот, "описание — в развороте").Содержит("Разбор YAML для OneScript");
	Ожидаем.Что(Разворот, "сводка — в развороте").Содержит("зависимостей: 2");
	Ожидаем.Что(Разворот, "подробности — в развороте").Содержит("aria-label=""Подробнее о пакете yaml 1.0.0""");

	СПулом = РядТаблицы(СписокСПулом(СтрокаВходящих(ПолныйМанифест())), "table__expand");
	Ожидаем.Что(СПулом, "в сводке по всем пулам — все шесть").Содержит("<td colspan=""6"">");

КонецПроцедуры

// Подробности — под раскрывашкой, и у каждой своё доступное имя: двадцать «Подробнее»
// подряд скринридер не различил бы.
&Тест
Процедура ПодробностиМанифестаУходятПодРаскрывашкуСоСвоимИменем() Экспорт

	Разметка = Список(СтрокаВходящих(ПолныйМанифест()));
	Подробности = Раскрывашка(Разметка);

	Ожидаем.Что(Разметка, "раскрывашка названа заявкой")
		.Содержит("aria-label=""Подробнее о пакете yaml 1.0.0""");
	Ожидаем.Что(Подробности, "автор вместе с почтой").Содержит("dr-who &lt;dr@who.example&gt;");
	Ожидаем.Что(Подробности, "версия среды").Содержит("2.0.0");
	Ожидаем.Что(Подробности, "зависимости с требуемыми версиями").Содержит("logos 1.7.1, fs 1.0.0–2.0.0");
	Ожидаем.Что(Подробности, "зависимости разработки отдельно").Содержит("asserts 1.6.0");
	Ожидаем.Что(Подробности, "репозиторий и здесь ссылкой")
		.Содержит("href=""https://github.com/acme/yaml""");

КонецПроцедуры

// Описание под строкой — одной строкой и не длиннее восьмидесяти знаков; целиком оно —
// в подробностях.
&Тест
Процедура ДлинноеОписаниеВСтрокеОбрезаетсяАВПодробностяхЦеликом() Экспорт

	Абзац = "Первая строка описания пакета, достаточно длинная, чтобы не влезть в колонку таблицы";
	Описание = Абзац + Символы.ПС + "вторая строка — то, что автор дописал после переноса";
	Манифест = ПолныйМанифест();
	Манифест.Описание = Описание;

	Разметка = Список(СтрокаВходящих(Манифест));
	ВСтроке = Новый ОбрезаниеТекста().СМноготочием(Абзац + " " + "вторая строка — то, что автор"
		+ " дописал после переноса", 80);

	Ожидаем.Что(СтрЗаканчиваетсяНа(ВСтроке, "…"), "описание длиннее восьмидесяти знаков обрезано")
		.ЭтоИстина();
	Ожидаем.Что(Разметка, "в строке — обрезанное описание без переноса").Содержит(ВСтроке);
	Ожидаем.Что(Раскрывашка(Разметка), "в подробностях — целиком").Содержит(Описание);

КонецПроцедуры

// Ссылкой становится только веб-адрес: чужую схему не спасает и то, что снимок её пропустил.
&Тест
Процедура АдресНеВебСхемыСсылкойНеСтановится() Экспорт

	Манифест = ПолныйМанифест();
	Манифест.АдресРепозитория = "javascript:alert(1)";

	Ожидаем.Что(СтрНайти(НРег(Список(СтрокаВходящих(Манифест))), "href=""javascript:"),
		"ссылки на чужую схему нет").Равно(0);

	Манифест.АдресРепозитория = "";
	Подробности = Раскрывашка(Список(СтрокаВходящих(Манифест)));
	Ожидаем.Что(СтрНайти(Подробности, "href="), "без адреса ссылки нет вовсе").Равно(0);

КонецПроцедуры

// Заявка без снимка манифеста — поданная раньше, чем хаб их заводил, — показывается именем
// и версией, как прежде, и экран не падает ни на пустом снимке, ни на строке без этого поля.
&Тест
Процедура ЗаявкаБезСнимкаПоказываетсяИменемИВерсией() Экспорт

	БезСнимка = Список(СтрокаВходящих(Неопределено));
	Ожидаем.Что(БезСнимка, "имя пакета на месте").Содержит(">yaml<");
	Ожидаем.Что(СтрНайти(БезСнимка, "Подробнее о пакете"), "раскрывашки нет").Равно(0);
	Ожидаем.Что(СтрНайти(БезСнимка, "table__expand"), "и пустого разворота под строкой тоже").Равно(0);

	Прежняя = Новый Структура("Пул, Заявка, Заявитель", Пул(), Заявка(), Заявитель());
	Ожидаем.Что(Список(Прежняя), "строка прежней формы тоже рисуется").Содержит(">yaml<");

КонецПроцедуры

#КонецОбласти

#Область ШагПодтверждения

// По карточке принимается решение, поэтому сведения из packagedef на ней раскрыты сразу.
&Тест
Процедура ШагПодтвержденияРаскрываетСведенияМанифеста() Экспорт

	Разметка = Подтверждение(СтрокаВходящих(ПолныйМанифест()));

	Ожидаем.Что(Разметка, "описание").Содержит("Разбор YAML для OneScript");
	Ожидаем.Что(Разметка, "репозиторий ссылкой").Содержит("href=""https://github.com/acme/yaml""");
	Ожидаем.Что(Разметка, "зависимости").Содержит("logos 1.7.1, fs 1.0.0–2.0.0");
	Ожидаем.Что(СтрНайти(Разметка, "<details"), "раскрывать ничего не нужно").Равно(0);

КонецПроцедуры

// Без снимка карточка честно говорит, почему сведений нет, а не показывает пустоту.
&Тест
Процедура ШагПодтвержденияБезСнимкаГоворитПочему() Экспорт

	Разметка = Подтверждение(СтрокаВходящих(Неопределено));

	Ожидаем.Что(Разметка, "сказано, что сведений нет и почему")
		.Содержит(UI.Тексты.Текст("settings.inbox.manifest.missing"));
	Ожидаем.Что(Разметка, "КОНТРОЛЬ: карточка заявки на месте").Содержит("sha256");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Список(Знач СтрокаЗаявки)

	Строки = Новый Массив();
	Строки.Добавить(СтрокаЗаявки);
	Возврат Отрисовать(Новый Структура("Строки, Адрес, Токен, СПулом", Строки,
		"/pools/main/settings/inbox", "csrf", Ложь));

КонецФункции

// Сводка по всем пулам — с колонкой «Пул».
Функция СписокСПулом(Знач СтрокаЗаявки)

	Строки = Новый Массив();
	Строки.Добавить(СтрокаЗаявки);
	Возврат Отрисовать(Новый Структура("Строки, Адрес, Токен, СПулом", Строки, "/me/inbox",
		"csrf", Истина));

КонецФункции

// Ряд таблицы с классом: от его открывающего тега до закрывающего; "" — такого ряда нет.
Функция РядТаблицы(Знач Разметка, Знач КлассРяда)

	Начало = СтрНайти(Разметка, СтрШаблон("<tr class=""%1""", КлассРяда));
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Разметка, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</tr>") + СтрДлина("</tr>") - 1);

КонецФункции

Функция Подтверждение(Знач СтрокаЗаявки)

	Параметры = Новый Структура("Строки, Адрес, Токен, СПулом, Решение", Новый Массив(),
		"/pools/main/settings/inbox", "csrf", Ложь,
		Новый Структура("СтрокаВходящих, Операция", СтрокаЗаявки, "одобрить"));
	Возврат ПерваяСекция(Параметры);

КонецФункции

Функция Отрисовать(Знач Параметры)

	Возврат UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"pool", "Входящие", Витрина.Секции(Параметры)));

КонецФункции

// Секция подтверждения стоит первой; список под ней в проверку не попадает.
Функция ПерваяСекция(Знач Параметры)

	Одна = Новый Массив();
	Одна.Добавить(Витрина.Секции(Параметры)[0]);
	Возврат UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"pool", "Входящие", Одна));

КонецФункции

// Разметка раскрывашки с подробностями; пустая строка — раскрывашки нет.
Функция Раскрывашка(Знач Разметка)

	Начало = СтрНайти(Разметка, "<details");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Разметка, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</details>") + СтрДлина("</details>") - 1);

КонецФункции

Функция СтрокаВходящих(Знач Манифест)
	Возврат Новый Структура("Пул, Заявка, Заявитель, Манифест", Пул(), Заявка(), Заявитель(), Манифест);
КонецФункции

// Сведения той формы, какую отдаёт СервисВходящих.МанифестЗаявки.
Функция ПолныйМанифест()

	Зависимости = Новый Массив();
	Зависимости.Добавить(Зависимость("logos", "1.7.1", "", Ложь));
	Зависимости.Добавить(Зависимость("fs", "1.0.0", "2.0.0", Ложь));
	Зависимости.Добавить(Зависимость("asserts", "1.6.0", "", Истина));

	Результат = Новый Структура();
	Результат.Вставить("Описание", "Разбор YAML для OneScript");
	Результат.Вставить("АдресАвтора", "dr@who.example");
	Результат.Вставить("АдресРепозитория", "https://github.com/acme/yaml");
	Результат.Вставить("ВерсияДвижка", "2.0.0");
	Результат.Вставить("Зависимости", Зависимости);
	Возврат Результат;

КонецФункции

Функция Зависимость(Знач Имя, Знач ВерсияМин, Знач ВерсияМакс, Знач ДляРазработки)
	Возврат Новый Структура("Имя, ВерсияМин, ВерсияМакс, ДляРазработки",
		Имя, ВерсияМин, ВерсияМакс, ДляРазработки);
КонецФункции

Функция Заявка()

	Результат = Новый Структура();
	Результат.Вставить("Идентификатор", 7);
	Результат.Вставить("ИмяПакета", "yaml");
	Результат.Вставить("Версия", "1.0.0");
	Результат.Вставить("АвторМанифеста", "dr-who");
	Результат.Вставить("Создана", '20260928120000');
	Результат.Вставить("Размер", 2048);
	Результат.Вставить("Канал", "stable");
	Результат.Вставить("ИмяФайла", "yaml-1.0.0.ospx");
	Результат.Вставить("Sha256", "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
	Возврат Результат;

КонецФункции

Функция Пул()
	Возврат Новый Структура("Имя", "main");
КонецФункции

Функция Заявитель()
	Возврат Новый Структура("Логин", "bob");
КонецФункции

#КонецОбласти
