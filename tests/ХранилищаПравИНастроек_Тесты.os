// Тесты фасадов db: права доступа, сопоставления и связки групп OIDC, провайдеры входа,
// прикладные настройки. Проверяют, что деривованные отборы РЕАЛЬНО фильтруют:
// в таблицах лежат строки, которые метод обязан отсеять.

#Использовать asserts
#Использовать autumn
// имя коннектора стоит в autumn-properties.json — без entity тип не зарегистрирован и не
// собирается контейнер САМОГО раннера OneUnit (он тоже приложение ОСени)
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), ОбъединитьПути("данные", "Классы"));

	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассовDb, "*.os", Истина) Цикл
		// без глушения ошибок: синтаксически сломанный класс должен уронить набор
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;

	// примитивы основы: на них стоят фасады слоя данных (канон ключа таблицы)
	ПоискКлассов.ПодключитьОснову(ОбъединитьПути(КаталогКлассовDb, "..", ".."));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "хранилища-прав-и-настроек");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// файл autumn-properties.json имеет приоритет выше соответствия деталек, поэтому имя
	// искомого файла подменяется на несуществующее: набору нужен именно in-memory
	Совет.ИмяФайлаСоЗначениямиДеталек("хранилища-прав-и-настроек-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

#Область СборкаКонтейнера

&Тест
Процедура ФасадыИЗапросыСобираютсяЖелудями() Экспорт

	Имена = "ХранилищеПравДоступа,ХранилищеСопоставленийГруппOIDC,ХранилищеСвязокГруппOIDC,"
		+ "ХранилищеПровайдеровВхода,ХранилищеПрикладныхНастроек,"
		+ "ХранилищеБрендовыхАктивов,"
		+ "ЗапросыПравДоступа,ЗапросыСопоставленийГруппOIDC,ЗапросыСвязокГруппOIDC,"
		+ "ЗапросыПровайдеровВхода,ЗапросыПрикладныхНастроек,ЗапросыБрендовыхАктивов";

	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПраваДоступа

&Тест
Процедура ГрантОтбираетсяПоЧетырёмПолямСразу() Экспорт

	Хранилище = Желудь("ХранилищеПравДоступа");
	ТипОбъекта = "объект" + УникальныеИмена.Хвост();

	ЗавестиГрант(Хранилище, "пользователь", 1, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "пользователь", 1, ТипОбъекта, 20);
	ЗавестиГрант(Хранилище, "пользователь", 2, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "группа", 1, ТипОбъекта, 10);

	Грант = Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 10);

	Ожидаем.Что(Грант, "грант найден").Существует();
	Ожидаем.Что(Строка(Грант.ТипСубъекта)).Равно("пользователь");
	Ожидаем.Что(Число(Грант.СубъектИдентификатор)).Равно(1);
	Ожидаем.Что(Число(Грант.ОбъектИдентификатор)).Равно(10);
	Ожидаем.Что(Хранилище.НайтиГрант("пользователь", 9, ТипОбъекта, 10),
		"отбор по субъекту действует").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 99),
		"отбор по объекту действует").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ГрантыОтбираютсяПоОбъектуТипуИСубъекту() Экспорт

	Хранилище = Желудь("ХранилищеПравДоступа");
	ТипОбъекта = "объект" + УникальныеИмена.Хвост();
	ЧужойТип = "чужой" + УникальныеИмена.Хвост();
	// ГрантыСубъекта тип объекта не отбирает — субъект должен быть уникален в пределах набора
	Субъект = СвободныйНомер();

	ЗавестиГрант(Хранилище, "пользователь", Субъект, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "пользователь", Субъект, ТипОбъекта, 20);
	ЗавестиГрант(Хранилище, "группа", Субъект, ТипОбъекта, 10);
	// строки, которые обязаны быть отсеяны каждым из отборов
	ЗавестиГрант(Хранилище, "пользователь", Субъект, ЧужойТип, 10);
	ЗавестиГрант(Хранилище, "пользователь", Субъект + 7, ТипОбъекта, 10);

	Ожидаем.Что(Хранилище.ГрантыНаОбъект(ТипОбъекта, 10).Количество(),
		"гранты на конкретный объект").Равно(3);
	Ожидаем.Что(Хранилище.ГрантыПоТипуОбъекта(ТипОбъекта).Количество(),
		"гранты на весь тип объекта").Равно(4);
	Ожидаем.Что(Хранилище.ГрантыСубъекта("пользователь", Субъект).Количество(),
		"гранты субъекта по обоим типам объектов").Равно(3);
	Ожидаем.Что(Хранилище.ГрантыСубъекта("группа", Субъект).Количество(),
		"отбор по типу субъекта действует").Равно(1);

КонецПроцедуры

&Тест
Процедура ГрантУдаляетсяЧерезФасад() Экспорт

	Хранилище = Желудь("ХранилищеПравДоступа");
	ТипОбъекта = "объект" + УникальныеИмена.Хвост();

	ЗавестиГрант(Хранилище, "пользователь", 1, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "пользователь", 2, ТипОбъекта, 10);

	Хранилище.Удалить(Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 10));

	Ожидаем.Что(Хранилище.ГрантыНаОбъект(ТипОбъекта, 10).Количество(), "остался один").Равно(1);
	Ожидаем.Что(Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 10), "удалённого нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СопоставленияИСвязкиГруппOIDC

&Тест
Процедура СопоставленияОтбираютсяПоИздателюИГруппе() Экспорт

	Хранилище = Желудь("ХранилищеСопоставленийГруппOIDC");
	Издатель = "https://idp" + УникальныеИмена.Хвост();
	ЧужойИздатель = "https://other" + УникальныеИмена.Хвост();
	Группа = СвободныйНомер();

	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "dev");
	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "ops");
	ЗавестиСопоставление(Хранилище, Группа + 1, Издатель, "roles", "dev");
	// строки, которые обязаны быть отсеяны
	ЗавестиСопоставление(Хранилище, Группа, ЧужойИздатель, "groups", "dev");

	Ожидаем.Что(Хранилище.ПолучитьПоИздательРавно(Издатель).Количество(),
		"отбор по издателю").Равно(3);
	Ожидаем.Что(Хранилище.ПолучитьПоГруппаИдентификаторРавно(Группа + 1).Количество(),
		"отбор по группе").Равно(1);
	Ожидаем.Что(Хранилище.Все().Количество() >= 4, "Все() отдаёт всю таблицу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СопоставлениеИщетсяПоПолномуКлючуИУдаляется() Экспорт

	Хранилище = Желудь("ХранилищеСопоставленийГруппOIDC");
	Издатель = "https://idp" + УникальныеИмена.Хвост();
	Группа = СвободныйНомер();

	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "dev");
	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "ops");
	ЗавестиСопоставление(Хранилище, Группа, Издатель, "roles", "dev");
	ЗавестиСопоставление(Хранилище, Группа + 1, Издатель, "groups", "dev");

	Найдено = Хранилище.НайтиСопоставление(Группа, Издатель, "groups", "ops");

	Ожидаем.Что(Найдено, "сопоставление по полному ключу").Существует();
	Ожидаем.Что(Строка(Найдено.Значение)).Равно("ops");
	Ожидаем.Что(Хранилище.НайтиСопоставление(Группа, Издатель, "groups", "qa"),
		"отбор по значению клейма действует").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиСопоставление(Группа, Издатель, "teams", "ops"),
		"отбор по имени клейма действует").Равно(Неопределено);

	Идентификатор = Найдено.Идентификатор;
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор), "чтение по id").Существует();

	Хранилище.Удалить(Найдено);

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор), "после удаления").Равно(Неопределено);
	Ожидаем.Что(Хранилище.ПолучитьПоИздательРавно(Издатель).Количество(), "остались три").Равно(3);

КонецПроцедуры

&Тест
Процедура СвязкаОтбираетсяПоГруппе() Экспорт

	Хранилище = Желудь("ХранилищеСвязокГруппOIDC");
	База = СвободныйНомер();

	Для Сч = 0 По 2 Цикл
		Связка = Хранилище.СоздатьЭлемент();
		Связка.ГруппаИдентификатор = База + Сч;
		Связка.ПолитикаВыпавших = "исключать";
		Связка.СинхронизированаВ = ТекущаяУниверсальнаяДата();
		Связка.Сохранить();
	КонецЦикла;

	Найдена = Хранилище.НайтиПоГруппе(База + 1);

	Ожидаем.Что(Найдена, "связка группы найдена").Существует();
	Ожидаем.Что(Число(Найдена.ГруппаИдентификатор)).Равно(База + 1);
	Ожидаем.Что(Хранилище.НайтиПоГруппе(База + 999), "чужой группы нет").Равно(Неопределено);
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Найдена.Идентификатор), "чтение по id").Существует();
	Ожидаем.Что(Хранилище.Все().Количество() >= 3, "Все() отдаёт всю таблицу").ЭтоИстина();

	Хранилище.Удалить(Найдена);
	Ожидаем.Что(Хранилище.НайтиПоГруппе(База + 1), "после удаления").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ПровайдерыВхода

&Тест
Процедура ПровайдерыОтдаютсяВПорядкеИмени() Экспорт

	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Метка = УникальныеИмена.Хвост();

	Для Каждого Хвост Из СтрРазделить("gamma,alpha,beta", ",") Цикл
		ЗавестиПровайдера(Хранилище, Хвост + Метка);
	КонецЦикла;

	Имена = Новый Массив;
	Для Каждого Запись Из Хранилище.Все() Цикл
		Если СтрЗаканчиваетсяНа(Строка(Запись.Имя), Метка) Тогда
			Имена.Добавить(Строка(Запись.Имя));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Имена.Количество()).Равно(3);
	Ожидаем.Что(СтрСоединить(Имена, ","), "порядок по имени возрастанию").Равно(
		"alpha" + Метка + ",beta" + Метка + ",gamma" + Метка);

КонецПроцедуры

&Тест
Процедура ПровайдерИщетсяПоНормализованномуИмени() Экспорт

	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Имя = "gitlab" + УникальныеИмена.Хвост();

	ЗавестиПровайдера(Хранилище, Имя);
	ЗавестиПровайдера(Хранилище, "github" + УникальныеИмена.Хвост());

	Найдена = Хранилище.НайтиПоИмени("  " + ВРег(Имя) + "  ");

	Ожидаем.Что(Найдена, "регистр и пробелы не значимы").Существует();
	Ожидаем.Что(Строка(Найдена.Имя)).Равно(Имя);
	Ожидаем.Что(Строка(Найдена.ИдентификаторКлиента), "поле-двойник Идентификатора цело").Равно("cid-" + Имя);
	Ожидаем.Что(Строка(Найдена.ИмяКлеймаГрупп), "поле-двойник Имени цело").Равно("groups-" + Имя);
	Ожидаем.Что(Хранилище.НайтиПоИмени("нет-такого" + УникальныеИмена.Хвост()), "чужого имени нет").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиПоИмени("   "), "пустое имя не ищется").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура УдалениеПровайдераПоИмениИдемпотентно() Экспорт

	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Имя = "google" + УникальныеИмена.Хвост();
	Сосед = "yandex" + УникальныеИмена.Хвост();

	ЗавестиПровайдера(Хранилище, Имя);
	ЗавестиПровайдера(Хранилище, Сосед);

	Ожидаем.Что(Хранилище.УдалитьПоИмени(ВРег(Имя)), "первое удаление").ЭтоИстина();
	Ожидаем.Что(Хранилище.УдалитьПоИмени(ВРег(Имя)), "повторное удаление").ЭтоЛожь();
	Ожидаем.Что(Хранилище.НайтиПоИмени(Сосед), "соседа удаление не задело").Существует();

КонецПроцедуры

&Тест
Процедура КолонкиПровайдераРазбираютсяБезКоллизииПрефиксов() Экспорт

	// токенайзер autumn-data берёт первую подошедшую колонку в порядке объявления: если
	// Идентификатор объявить раньше ИдентификаторКлиента, отбор МОЛЧА уйдёт в первичный ключ
	ОбъектМодели = Желудь("ХранилищеСущностейПровайдерВхода").ПолучитьОбъектМодели();
	Построитель = Желудь("ПостроительОпцийПоиска");

	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьПоИдентификаторКлиентаРавно"),
		"ИдентификаторКлиента не съеден Идентификатором").Равно("ИдентификаторКлиента");
	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьОдноПоИдентификаторРавно"),
		"первичный ключ по-прежнему разбирается").Равно("Идентификатор");
	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьПоИмяКлеймаГруппРавно"),
		"ИмяКлеймаГрупп не съедено Имя").Равно("ИмяКлеймаГрупп");
	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьПоИмяРавноПервые"),
		"рабочий отбор фасада идёт в Имя").Равно("Имя");

КонецПроцедуры

#КонецОбласти

#Область ПрикладныеНастройки

&Тест
Процедура НастройкаЧитаетсяПоКанонизированномуКлючу() Экспорт

	Хранилище = Желудь("ХранилищеПрикладныхНастроек");
	Ключ = "oshub.test." + УникальныеИмена.Хвост();
	Сосед = "oshub.test." + УникальныеИмена.Хвост();

	Хранилище.Установить(Ключ, "значение-1", "root", ТекущаяУниверсальнаяДата());
	Хранилище.Установить(Сосед, "значение-2", "root", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Хранилище.Значение(Ключ)).Равно("значение-1");
	Ожидаем.Что(Хранилище.Значение("  " + ВРег(Ключ) + "  "), "регистр и пробелы не значимы").Равно("значение-1");
	Ожидаем.Что(Хранилище.Значение("oshub.нет." + УникальныеИмена.Хвост()), "чужого ключа нет").Равно(Неопределено);

КонецПроцедуры

// Ключ приезжает из формы и из API как его набрали: с пробелами и в своём регистре.
// Канон обязан быть один на чтении и на записи — иначе значение записано, но не читается,
// а каждая следующая запись заводит ещё одну строку того же ключа.
&Тест
Процедура НастройкаЗаписаннаяНеканоничнымКлючомЧитаетсяИНеДвоится() Экспорт

	Хранилище = Желудь("ХранилищеПрикладныхНастроек");
	Ключ = "oshub.test." + УникальныеИмена.Хвост();
	ДоЗаписи = Хранилище.Все().Количество();

	Хранилище.Установить("  " + ВРег(Ключ) + "  ", "первое", "root", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Хранилище.Значение(Ключ), "записанное неканоничным ключом").Равно("первое");
	Ожидаем.Что(КлючСтроки(Хранилище, "первое"), "в строке лежит каноничный ключ").Равно(Ключ);

	Хранилище.Установить(ВРег(Ключ), "второе", "admin", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Хранилище.Значение(Ключ), "вторая запись легла в ту же строку").Равно("второе");
	Ожидаем.Что(Хранилище.Все().Количество(), "строка одна, а не две").Равно(ДоЗаписи + 1);

	Хранилище.Удалить("  " + ВРег(Ключ) + "  ");

	Ожидаем.Что(Хранилище.Значение(Ключ), "сброс неканоничным ключом снял ту же строку").Равно(Неопределено);
	Ожидаем.Что(Хранилище.Все().Количество(), "убрана ровно одна строка").Равно(ДоЗаписи);

КонецПроцедуры

&Тест
Процедура ПовторнаяУстановкаПерезаписываетТуЖеСтроку() Экспорт

	Хранилище = Желудь("ХранилищеПрикладныхНастроек");
	Ключ = "oshub.test." + УникальныеИмена.Хвост();
	ДоЗаписи = Хранилище.Все().Количество();

	Хранилище.Установить(Ключ, "первое", "root", ТекущаяУниверсальнаяДата());
	Хранилище.Установить(Ключ, "второе", "admin", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Хранилище.Значение(Ключ)).Равно("второе");
	Ожидаем.Что(Хранилище.Все().Количество(), "строка одна, а не две").Равно(ДоЗаписи + 1);

КонецПроцедуры

// Ключ настройки приезжает из адреса запроса, и пустым он бывает: хвост маршрута срезан,
// поле формы не заполнено. Пустой ключ обязан не найти ничего и ничего не снести.
&Тест
Процедура ПустойКлючНеЧитаетИНеСноситЧужуюСтроку() Экспорт

	Хранилище = Желудь("ХранилищеПрикладныхНастроек");
	Ключ = "oshub.test." + УникальныеИмена.Хвост();
	Хранилище.Установить(Ключ, "значение", "root", ТекущаяУниверсальнаяДата());
	ПослеЗаписи = Хранилище.Все().Количество();

	Ожидаем.Что(Хранилище.Значение("   "), "ключ из пробелов").Равно(Неопределено);
	Ожидаем.Что(Хранилище.Значение(Неопределено), "ключ не задан вовсе").Равно(Неопределено);

	Хранилище.Удалить("   ");
	Хранилище.Удалить(Неопределено);

	Ожидаем.Что(Хранилище.Значение(Ключ), "сброс пустым ключом соседа не тронул").Равно("значение");
	Ожидаем.Что(Хранилище.Все().Количество(), "ни одной строки не убыло").Равно(ПослеЗаписи);

КонецПроцедуры

&Тест
Процедура СбросНастройкиИдемпотентенИНеЗадеваетСоседей() Экспорт

	Хранилище = Желудь("ХранилищеПрикладныхНастроек");
	Ключ = "oshub.test." + УникальныеИмена.Хвост();
	Сосед = "oshub.test." + УникальныеИмена.Хвост();

	Хранилище.Установить(Ключ, "значение-1", "root", ТекущаяУниверсальнаяДата());
	Хранилище.Установить(Сосед, "значение-2", "root", ТекущаяУниверсальнаяДата());
	ПослеЗаписи = Хранилище.Все().Количество();

	Хранилище.Удалить(Ключ);
	Хранилище.Удалить(Ключ);

	Ожидаем.Что(Хранилище.Значение(Ключ), "ключ сброшен").Равно(Неопределено);
	Ожидаем.Что(Хранилище.Значение(Сосед), "сосед цел").Равно("значение-2");
	Ожидаем.Что(Хранилище.Все().Количество(), "убрана ровно одна строка").Равно(ПослеЗаписи - 1);

КонецПроцедуры

&Тест
Процедура ВсеНастройкиОтдаютсяВПорядкеКлюча() Экспорт

	Хранилище = Желудь("ХранилищеПрикладныхНастроек");
	Метка = УникальныеИмена.Хвост();

	Хранилище.Установить("oshub.order.c." + Метка, "3", "root", ТекущаяУниверсальнаяДата());
	Хранилище.Установить("oshub.order.a." + Метка, "1", "root", ТекущаяУниверсальнаяДата());
	Хранилище.Установить("oshub.order.b." + Метка, "2", "root", ТекущаяУниверсальнаяДата());

	Значения = Новый Массив;
	Для Каждого Строка_ Из Хранилище.Все() Цикл
		Если СтрЗаканчиваетсяНа(Строка(Строка_.Ключ), Метка) Тогда
			Значения.Добавить(Строка(Строка_.Значение));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Значения, ","), "порядок по ключу возрастанию").Равно("1,2,3");

КонецПроцедуры

#КонецОбласти

#Область БрендовыеАктивы

// Уникальность ключа актива держит приложение, а не база: вторая загрузка логотипа
// обязана заменить первую, иначе хаб получит два «действующих» знака и станет рисовать
// то один, то другой в зависимости от порядка чтения.
&Тест
Процедура ПовторнаяЗагрузкаКартинкиПерезаписываетТуЖеСтроку() Экспорт

	Хранилище = Желудь("ХранилищеБрендовыхАктивов");
	Ключ = "logo";
	Хранилище.Удалить(Ключ);
	ДоЗаписи = Хранилище.Все().Количество();

	Хранилище.Установить(Ключ, ПолучитьДвоичныеДанныеИзСтроки("первая"), "image/png",
		"отпечаток-1", "root", ТекущаяУниверсальнаяДата());
	Хранилище.Установить(Ключ, ПолучитьДвоичныеДанныеИзСтроки("вторая-картинка"),
		"image/svg+xml", "отпечаток-2", "admin", ТекущаяУниверсальнаяДата());

	Актив = Хранилище.Актив(Ключ);
	Ожидаем.Что(Строка(Актив.Отпечаток), "действует последняя загрузка").Равно("отпечаток-2");
	Ожидаем.Что(Строка(Актив.ТипКонтента), "тип взят у последней").Равно("image/svg+xml");
	Ожидаем.Что(Число(Актив.Размер), "размер пересчитан").Равно(
		ПолучитьДвоичныеДанныеИзСтроки("вторая-картинка").Размер());
	Ожидаем.Что(Хранилище.Все().Количество(), "строка одна, а не две").Равно(ДоЗаписи + 1);

	Хранилище.Удалить(Ключ);

КонецПроцедуры

// Тот же канон ключа, что и у настроек: назначение картинки приходит из адреса запроса
// и из формы загрузки, поэтому регистр и пробелы не имеют права заводить вторую строку.
&Тест
Процедура КартинкаЗагруженнаяНеканоничнымКлючомЧитаетсяИНеДвоится() Экспорт

	Хранилище = Желудь("ХранилищеБрендовыхАктивов");
	Хранилище.Удалить("logo");
	ДоЗаписи = Хранилище.Все().Количество();

	Хранилище.Установить("  LOGO  ", ПолучитьДвоичныеДанныеИзСтроки("знак"), "image/png",
		"отпечаток-1", "root", ТекущаяУниверсальнаяДата());

	Актив = Хранилище.Актив("logo");
	Ожидаем.Что(Актив, "загруженное неканоничным ключом").Существует();
	Ожидаем.Что(Строка(Актив.Ключ), "в строке лежит каноничный ключ").Равно("logo");

	Хранилище.Установить("Logo", ПолучитьДвоичныеДанныеИзСтроки("другой знак"), "image/svg+xml",
		"отпечаток-2", "admin", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Строка(Хранилище.Актив("LOGO").Отпечаток), "вторая загрузка легла в ту же строку")
		.Равно("отпечаток-2");
	Ожидаем.Что(Хранилище.Все().Количество(), "строка одна, а не две").Равно(ДоЗаписи + 1);

	Хранилище.Удалить(" logo ");

	Ожидаем.Что(Хранилище.Актив("logo"), "сброс неканоничным ключом снял ту же строку").ЭтоНеопределено();
	Ожидаем.Что(Хранилище.Все().Количество(), "убрана ровно одна строка").Равно(ДоЗаписи);

КонецПроцедуры

&Тест
Процедура СбросКартинкиИдемпотентенИНеЗадеваетСоседа() Экспорт

	Хранилище = Желудь("ХранилищеБрендовыхАктивов");
	Хранилище.Установить("logo", ПолучитьДвоичныеДанныеИзСтроки("знак"), "image/png",
		"отпечаток-знака", "root", ТекущаяУниверсальнаяДата());
	Хранилище.Установить("favicon", ПолучитьДвоичныеДанныеИзСтроки("иконка"), "image/png",
		"отпечаток-иконки", "root", ТекущаяУниверсальнаяДата());
	ПослеЗаписи = Хранилище.Все().Количество();

	Хранилище.Удалить("logo");
	Хранилище.Удалить("logo");

	Ожидаем.Что(Хранилище.Актив("logo"), "знак сброшен").ЭтоНеопределено();
	Ожидаем.Что(Строка(Хранилище.Актив("favicon").Отпечаток), "иконка цела")
		.Равно("отпечаток-иконки");
	Ожидаем.Что(Хранилище.Все().Количество(), "убрана ровно одна строка").Равно(ПослеЗаписи - 1);

	Хранилище.Удалить("favicon");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Синтетический номер субъекта, группы или связки: внешних ключей в этих таблицах нет,
// строка ссылается на кого угодно. Запас в сотню оставляет тесту место для соседних
// номеров «+1», «+7» — их не выдадут никому другому.
Функция СвободныйНомер()
	Возврат УникальныеИмена.Номер(100);
КонецФункции

// Ключ, под которым в таблице лежит это значение: читается из самой строки, а не из того,
// что подавали на запись.
Функция КлючСтроки(Знач Хранилище, Знач Значение)

	Для Каждого Запись Из Хранилище.Все() Цикл
		Если Строка(Запись.Значение) = Значение Тогда
			Возврат Строка(Запись.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПолеОтбора(Знач Построитель, Знач ОбъектМодели, Знач ИмяМетода)

	Отборы = Построитель.РазобратьИмяМетода(ИмяМетода, ОбъектМодели).ОпцииПоиска.Отборы();
	Ожидаем.Что(Отборы.Количество(), СтрШаблон("отбор в %1 построен", ИмяМетода)).Равно(1);
	Возврат Отборы[0].ПутьКДанным;

КонецФункции

Процедура ЗавестиГрант(Знач Хранилище, Знач ТипСубъекта, Знач СубъектИдентификатор,
	Знач ТипОбъекта, Знач ОбъектИдентификатор)

	Грант = Хранилище.СоздатьЭлемент();
	Грант.ТипСубъекта = ТипСубъекта;
	Грант.СубъектИдентификатор = СубъектИдентификатор;
	Грант.ТипОбъекта = ТипОбъекта;
	Грант.ОбъектИдентификатор = ОбъектИдентификатор;
	Грант.Чтение = Истина;
	Грант.КемВыдано = 0;
	Грант.Выдано = ТекущаяУниверсальнаяДата();
	Грант.Сохранить();

КонецПроцедуры

Процедура ЗавестиСопоставление(Знач Хранилище, Знач ГруппаИдентификатор, Знач Издатель,
	Знач ИмяКлейма, Знач Значение)

	Сопоставление = Хранилище.СоздатьЭлемент();
	Сопоставление.ГруппаИдентификатор = ГруппаИдентификатор;
	Сопоставление.Издатель = Издатель;
	Сопоставление.ИмяКлейма = ИмяКлейма;
	Сопоставление.Значение = Значение;
	Сопоставление.Сохранить();

КонецПроцедуры

Процедура ЗавестиПровайдера(Знач Хранилище, Знач Имя)

	Запись = Хранилище.СоздатьЗапись(Имя);
	Запись.ВидПротокола = "oidc";
	Запись.ИдентификаторКлиента = "cid-" + Имя;
	Запись.ИмяКлеймаГрупп = "groups-" + Имя;
	Запись.Включён = Истина;
	Хранилище.Записать(Запись, "root", ТекущаяУниверсальнаяДата());

КонецПроцедуры

#КонецОбласти
