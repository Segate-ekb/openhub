// Юнит/интеграционные тесты поиска пакетов на контейнере ОСени с КоннекторInMemory:
// ранжирование по тирам, нечёткий этап, пагинация и ACL-видимость пулов.
// Изолирован процессом: второй контейнер ОСени в процессе раннера конфликтует.

#Использовать asserts
// autumn-logos — единая точка входа логирования (logos транзитивно): классы, созданные
// НАПРЯМУЮ (минуя контейнер ОСени), с шага 6.D получают лог от теста параметром.
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Пул_;
Перем СборкаСчётчик_;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	СборкаСчётчик_ = 0;
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"));

	// SSRF-гейт апстримов (5.B): СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО
	// (fail-closed). Модули webhooks/mirror целиком не тянем — в webhooks рогатки,
	// которым нужен весь хаб; фикстура подключает ровно три класса гейта.
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "статистика", "Классы"));
	// ГотовностьХаба — гейт стартовых задач: СлужбаСтатистикиСкачиваний
	// заявляет в ней свою задачу, без желудя её бин не собирается.
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "пробы/ГотовностьХаба.os"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "поиск", "Классы"));
	// общий модуль утилит (6.C п.8): СлужбаПоиска берёт ПриведениеЧисел желудём
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "основа", "Классы"));

	// ACL-шов 3.E: ВидимостьПулов (поиск) опирается на ядро прав 3.B (СервисПрав) —
	// точечно подключаем нужные желуди auth и ФЕЙК ПроверяющегоGitHub (без сети)
	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КаталогВхода = ОбъединитьПути(КаталогМодулей, "вход", "Классы");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПравДоступа");

	// рамки ключа доступа — второй контур видимости: без гейта узкий токен судить нечем,
	// и тесты привязки зеленели бы на мягком fail-closed, а не на самом правиле
	ПоискКлассов.Подключить(КаталогМодулей, "СервисТокенов");
	ПоискКлассов.Подключить(КаталогМодулей, "ГейтТокена");

	// видимость выдачи спрашивается у ГвардаЧтенияПула — с ним в контейнер приезжает
	// цепочка входа: гвард определяет принципала перехватчиком
	ПоискКлассов.Подключить(КаталогМодулей, "ЛетописьУчёток");
	ПоискКлассов.Подключить(КаталогМодулей, "АдресУчётки");
	ПоискКлассов.Подключить(КаталогМодулей, "НормализаторУчётки");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПользователей");
	ПоискКлассов.Подключить(КаталогМодулей, "СессияХаба");
	ПоискКлассов.Подключить(КаталогМодулей, "ХранилищеСессийБД");
	ПоискКлассов.Подключить(КаталогМодулей, "СлужбаСессий");
	ПоискКлассов.Подключить(КаталогМодулей, "ПерехватчикАутентификации");
	ПоискКлассов.Подключить(КаталогМодулей, "ГвардЧтенияПула");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкПроверяющийGitHub.os"));

КонецПроцедуры

&ПередКаждым
Процедура ПостроитьКонтейнер() Экспорт

	СборкаСчётчик_ = СборкаСчётчик_ + 1;

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "поиск-тесты-" + Формат(СборкаСчётчик_, "ЧГ=0"));
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Пул_ = СервисПулов().СоздатьПул("search-pool", "custom");

КонецПроцедуры

// --- наивное ранжирование ---

&Тест
Процедура ТирыРелевантностиУпорядоченыОтИмениКОписанию() Экспорт

	Зарег("log");                                              // точное имя -> 1000
	Зарег("logos");                                            // префикс   -> 600
	Зарег("mylog");                                            // подстрока -> 300
	ЗарегСо("kw-pkg", "утилита", "logging,cache");              // ключевые  -> 150
	ЗарегСо("desc-pkg", "structured log output", "");          // описание  -> 120
	Зарег("unrelated");                                        // не подошёл

	Найдено = Служба().НайтиПакеты("log", 1, 20);

	Ожидаем.Что(Найдено.Всего, "подошли пять пакетов").Равно(5);
	Ожидаем.Что(Имена(Найдено), "порядок тиров: имя-точное > префикс > подстрока > ключевые > описание")
		.Равно("log,logos,mylog,kw-pkg,desc-pkg");

КонецПроцедуры

&Тест
Процедура ПопулярностьРазрешаетРавныйТир() Экспорт

	A = Зарег("svc-a"); // оба префикс-тир (600) по запросу "svc"
	B = Зарег("svc-b");

	// B популярнее: три скачивания против нуля у A (ожидающие в памяти учитываются витриной)
	Статистика().ЗафиксироватьСкачивание(B.Идентификатор, 1);
	Статистика().ЗафиксироватьСкачивание(B.Идентификатор, 1);
	Статистика().ЗафиксироватьСкачивание(B.Идентификатор, 1);

	Найдено = Служба().НайтиПакеты("svc", 1, 20);
	Ожидаем.Что(Имена(Найдено), "при равном тире популярный пакет выше").Равно("svc-b,svc-a");

КонецПроцедуры

&Тест
Процедура ПустойЗапросАлфавитныйПорядокИПагинация() Экспорт

	Для Каждого Имя Из СтрРазделить("winow,autumn,configor,semver,entity", ",") Цикл
		Зарег(Имя);
	КонецЦикла;

	Все = Служба().НайтиПакеты("", 1, 20);
	Ожидаем.Что(Все.Всего).Равно(5);
	Ожидаем.Что(Все.Элементы[0].Имя, "пустой запрос — по имени").Равно("autumn");

	Стр1 = Служба().НайтиПакеты("", 1, 2);
	Ожидаем.Что(Стр1.ВсегоСтраниц).Равно(3);
	Ожидаем.Что(Стр1.Элементы.Количество()).Равно(2);

	Стр3 = Служба().НайтиПакеты("", 3, 2);
	Ожидаем.Что(Стр3.Страница).Равно(3);
	Ожидаем.Что(Стр3.Элементы.Количество()).Равно(1);

	ЗаГранью = Служба().НайтиПакеты("", 99, 2);
	Ожидаем.Что(ЗаГранью.Страница, "выход за границы клампится к последней странице").Равно(3);

КонецПроцедуры

&Тест
Процедура ПустаяВыдачаНаНеизвестныйЗапрос() Экспорт
	Зарег("alpha");
	Ожидаем.Что(Служба().НайтиПакеты("нетничего", 1, 20).Всего).Равно(0);
КонецПроцедуры

&Тест
Процедура СкрытыеПакетыИсключеныИзПоиска() Экспорт

	Зарег("vis-pkg");
	Скрытый = Зарег("hid-pkg");
	Скрытый.Скрыт = Истина;
	Скрытый.Сохранить();

	Найдено = Служба().НайтиПакеты("pkg", 1, 20);
	Ожидаем.Что(СтрНайти(Имена(Найдено), "vis-pkg") > 0, "видимый найден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Имена(Найдено), "hid-pkg"), "скрытый не найден").Равно(0);

КонецПроцедуры

// --- ACL-видимость пула в наивном поиске (шаг 3.E ACL-шов) ---

&Тест
Процедура АнонимНеВидитПакетПриватногоПула() Экспорт

	Зарег("acl-pub");                                  // в публичном Пул_
	Прив = ПриватныйПул();
	ЗарегВПул(Прив, "acl-secret");

	Найдено = Служба().НайтиПакеты("acl", 1, 20);       // Пользователь = Неопределено (аноним)
	Ожидаем.Что(СтрНайти(Имена(Найдено), "acl-pub") > 0, "аноним видит публичный").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Имена(Найдено), "acl-secret"), "аноним НЕ видит приватный (info-leak закрыт)").Равно(0);
	Ожидаем.Что(Найдено.Всего, "в счёте только публичный").Равно(1);

КонецПроцедуры

&Тест
Процедура СубъектСПравомЧтенияВидитПриватное() Экспорт

	Прив = ПриватныйПул();
	ЗарегВПул(Прив, "acl-secret");
	Читатель = СоздатьПользователя("user");
	Чужой = СоздатьПользователя("user");
	ВыдатьЧтение(Прив, Читатель);

	СРанг = Служба().НайтиПакеты("acl", 1, 20, ПринципалСессии(Читатель));
	Ожидаем.Что(СтрНайти(Имена(СРанг), "acl-secret") > 0, "субъект с чтением видит приватное").ЭтоИстина();

	БезПрав = Служба().НайтиПакеты("acl", 1, 20, ПринципалСессии(Чужой));
	Ожидаем.Что(СтрНайти(Имена(БезПрав), "acl-secret"), "субъект без права приватное НЕ видит").Равно(0);

КонецПроцедуры

&Тест
Процедура АдминВидитПриватноеБезГранта() Экспорт

	Прив = ПриватныйПул();
	ЗарегВПул(Прив, "acl-secret");
	Админ = СоздатьПользователя("admin");

	Найдено = Служба().НайтиПакеты("acl", 1, 20, ПринципалСессии(Админ));
	Ожидаем.Что(СтрНайти(Имена(Найдено), "acl-secret") > 0, "admin видит всё без гранта").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПагинацияНеПротекаетПриватным() Экспорт

	// 2 публичных + 2 приватных подходят под запрос; аноним должен видеть РОВНО 2 публичных,
	// а перебор всех страниц не должен подмешать приватное из-за смещения
	Зарег("pg-pub-1");
	Зарег("pg-pub-2");
	Прив = ПриватныйПул();
	ЗарегВПул(Прив, "pg-sec-1");
	ЗарегВПул(Прив, "pg-sec-2");

	Первая = Служба().НайтиПакеты("pg-", 1, 1);
	Ожидаем.Что(Первая.Всего, "счёт — только публичные (2)").Равно(2);
	Ожидаем.Что(Первая.ВсегоСтраниц, "страниц по 1 на 2 публичных = 2").Равно(2);

	ВсеИмена = "";
	Для Стр = 1 По Первая.ВсегоСтраниц Цикл
		ВсеИмена = ВсеИмена + "," + Имена(Служба().НайтиПакеты("pg-", Стр, 1));
	КонецЦикла;
	Ожидаем.Что(СтрНайти(ВсеИмена, "pg-sec"), "ни одна страница не протекла приватным").Равно(0);
	Ожидаем.Что(СтрНайти(ВсеИмена, "pg-pub-1") > 0 И СтрНайти(ВсеИмена, "pg-pub-2") > 0,
		"обе публичные позиции присутствуют на страницах").ЭтоИстина();

КонецПроцедуры

// --- рамки ключа доступа в выдаче поиска ---

&Тест
Процедура УзкийКлючВидитПубличноеИСвойПулНоНеВторойПриватныйВладельца() Экспорт

	Владелец = СоздатьПользователя("user");
	ПулX = ПриватныйПул();
	ПулY = ПриватныйПул();
	ВыдатьЧтение(ПулX, Владелец);
	ВыдатьЧтение(ПулY, Владелец);
	Зарег("key-pub");
	ЗарегВПул(ПулX, "key-inx");
	ЗарегВПул(ПулY, "key-iny");

	Выдача = Служба().НайтиПакеты("key-", 1, 20, ПринципалКлюча(Владелец, ПулX.Идентификатор));
	Ключом = Имена(Выдача);

	Ожидаем.Что(Выдача.Всего, "в счёте двое: публичный пакет и пакет пула X").Равно(2);
	Ожидаем.Что(СтрНайти(Ключом, "key-pub") > 0, "ключ пула X видит публичное").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, "key-inx") > 0, "ключ пула X видит свой пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, "key-iny"), "пакет второго приватного пула владельца не показан").Равно(0);

	// человек тот же, ключа нет — видно оба приватных пула: рамки принадлежат ключу
	Сессией = Имена(Служба().НайтиПакеты("key-", 1, 20, ПринципалСессии(Владелец)));
	Ожидаем.Что(СтрНайти(Сессией, "key-inx") > 0 И СтрНайти(Сессией, "key-iny") > 0,
		"сессия того же владельца видит и X, и Y").ЭтоИстина();

КонецПроцедуры

// Ключ с НАБОРОМ пулов видит в поиске ровно свои пулы: и первый, и второй, и ни одного
// сверх набора. Множество — не «первый элемент»: с одним пулом эта разница не видна.
&Тест
Процедура КлючНабораВидитВПоискеРовноСвоиПулы() Экспорт

	Владелец = СоздатьПользователя("user");
	ПулA = ПриватныйПул();
	ПулB = ПриватныйПул();
	ПулC = ПриватныйПул();
	ВыдатьЧтение(ПулA, Владелец);
	ВыдатьЧтение(ПулB, Владелец);
	ВыдатьЧтение(ПулC, Владелец);
	ЗарегВПул(ПулA, "set-ina");
	ЗарегВПул(ПулB, "set-inb");
	ЗарегВПул(ПулC, "set-inc");

	Набор = Новый Массив();
	Набор.Добавить(ПулA.Идентификатор);
	Набор.Добавить(ПулB.Идентификатор);
	Выдача = Служба().НайтиПакеты("set-", 1, 20, ПринципалНабора(Владелец, Набор));
	Ключом = Имена(Выдача);

	Ожидаем.Что(Выдача.Всего, "в счёте ровно два пакета набора").Равно(2);
	Ожидаем.Что(СтрНайти(Ключом, "set-ina") > 0, "пакет первого пула набора виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, "set-inb") > 0,
		"и второго — иначе набор судился бы первым элементом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ключом, "set-inc"), "третий пул владельца ключу закрыт").Равно(0);

	Сессией = Имена(Служба().НайтиПакеты("set-", 1, 20, ПринципалСессии(Владелец)));
	Ожидаем.Что(СтрНайти(Сессией, "set-inc") > 0,
		"КОНТРОЛЬ: сессией владелец находит пакет третьего пула").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПакетЧужогоПулаНеВсплываетУзкомуКлючуНиТиром_НиНечёткимЭтапом() Экспорт

	Владелец = СоздатьПользователя("user");
	ПулX = ПриватныйПул();
	ПулY = ПриватныйПул();
	ВыдатьЧтение(ПулX, Владелец);
	ВыдатьЧтение(ПулY, Владелец);
	Зарег("winow");                       // публичный: нечёткому этапу нужна непустая выборка
	ЗарегВПул(ПулY, "postgres");

	Ключ = ПринципалКлюча(Владелец, ПулX.Идентификатор);
	Точный = Служба().НайтиПакеты("postgres", 1, 20, Ключ);
	Опечатка = Служба().НайтиПакеты("postgers", 1, 20, Ключ);

	Ожидаем.Что(Точный.Всего, "точное имя пакета пула Y ключу пула X ничего не даёт").Равно(0);
	Ожидаем.Что(Опечатка.Всего, "нечёткий этап тоже не поднимает пакет пула Y").Равно(0);
	Ожидаем.Что(СтрНайти(Имена(Точный) + Имена(Опечатка), "postgres"),
		"имя пакета не утекло ни в одной выдаче").Равно(0);

	// контроль: тот же запрос сессией владельца пакет находит — отбор сужает, а не пустует
	Ожидаем.Что(Имена(Служба().НайтиПакеты("postgers", 1, 20, ПринципалСессии(Владелец))),
		"КОНТРОЛЬ: сессии владельца опечатка находит пакет пула Y").Равно("postgres");

КонецПроцедуры

&Тест
Процедура ПагинацияНеПротекаетПакетомЧужогоПулаУзкомуКлючу() Экспорт

	Владелец = СоздатьПользователя("user");
	ПулX = ПриватныйПул();
	ПулY = ПриватныйПул();
	ВыдатьЧтение(ПулX, Владелец);
	ВыдатьЧтение(ПулY, Владелец);
	ЗарегВПул(ПулX, "pgk-x-1");
	ЗарегВПул(ПулX, "pgk-x-2");
	ЗарегВПул(ПулY, "pgk-y-1");
	ЗарегВПул(ПулY, "pgk-y-2");

	Ключ = ПринципалКлюча(Владелец, ПулX.Идентификатор);
	Первая = Служба().НайтиПакеты("pgk-", 1, 1, Ключ);
	Ожидаем.Что(Первая.Всего, "счёт — только пакеты пула X").Равно(2);
	Ожидаем.Что(Первая.ВсегоСтраниц, "страниц по 1 на 2 пакета = 2").Равно(2);

	ВсеИмена = "";
	Для Стр = 1 По Первая.ВсегоСтраниц Цикл
		ВсеИмена = ВсеИмена + "," + Имена(Служба().НайтиПакеты("pgk-", Стр, 1, Ключ));
	КонецЦикла;
	Ожидаем.Что(СтрНайти(ВсеИмена, "pgk-y"), "ни одна страница не протекла пулом Y").Равно(0);
	Ожидаем.Что(СтрНайти(ВсеИмена, "pgk-x-1") > 0 И СтрНайти(ВсеИмена, "pgk-x-2") > 0,
		"обе позиции пула X на страницах присутствуют").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлючБезПривязкиВидитВсёЧитаемоеВладельцем() Экспорт

	Владелец = СоздатьПользователя("user");
	ПулX = ПриватныйПул();
	ПулY = ПриватныйПул();
	ВыдатьЧтение(ПулX, Владелец);
	ВыдатьЧтение(ПулY, Владелец);
	ЗарегВПул(ПулX, "free-x");
	ЗарегВПул(ПулY, "free-y");

	Найдено = Служба().НайтиПакеты("free-", 1, 20, ПринципалКлюча(Владелец, 0));

	Ожидаем.Что(Найдено.Всего, "ключ без привязки к пулу сужает выдачу не больше владельца").Равно(2);
	Ожидаем.Что(СтрНайти(Имена(Найдено), "free-x") > 0 И СтрНайти(Имена(Найдено), "free-y") > 0,
		"видны оба приватных пула владельца").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлючБезСкоупаЧтенияПриватногоНеВидит() Экспорт

	Владелец = СоздатьПользователя("user");
	Прив = ПриватныйПул();
	ВыдатьЧтение(Прив, Владелец);
	Зарег("scope-pub");
	ЗарегВПул(Прив, "scope-sec");

	ТолькоЗапись = Служба().НайтиПакеты("scope-", 1, 20, ПринципалКлюча(Владелец, 0, "write"));

	Ожидаем.Что(Имена(ТолькоЗапись), "ключ без скоупа read читает только публичное")
		.Равно("scope-pub");

КонецПроцедуры

// --- порядок тиров имени ---

&Тест
Процедура ТочноеИмяВышеПрефиксаИПодстроки() Экспорт

	Зарег("json");        // точное имя
	Зарег("jsonschema");  // префикс
	Зарег("myjson");      // подстрока

	Найдено = Служба().НайтиПакеты("json", 1, 20);
	Ожидаем.Что(Имена(Найдено), "точное > префикс > подстрока").Равно("json,jsonschema,myjson");

КонецПроцедуры

// --- нечёткий этап (fzy) ---

&Тест
Процедура ОпечаткаНаходитсяНечёткимЭтапом() Экспорт

	Зарег("json");
	Зарег("winow");

	Найдено = Служба().НайтиПакеты("josn", 1, 20);
	Ожидаем.Что(Имена(Найдено), "перестановка букв находит пакет нечётким этапом").Равно("json");

КонецПроцедуры

&Тест
Процедура НечёткийЭтапНеПодменяетТочныйОтбор() Экспорт

	// подстрока нашлась — нечёткий этап не запускается и мусор в выдачу не подмешивает
	Зарег("logos");
	Зарег("winow");

	Найдено = Служба().НайтиПакеты("logo", 1, 20);
	Ожидаем.Что(Имена(Найдено), "при точном совпадении выдача только по подстроке").Равно("logos");

КонецПроцедуры

&Тест
Процедура ПриватныйПакетНеВсплываетНиТиром_НиНечёткимЭтапом() Экспорт

	// публичный пакет нужен, чтобы нечёткий этап реально запустился на непустой выборке
	Зарег("winow");
	Прив = ПриватныйПул();
	ЗарегВПул(Прив, "postgres");

	Точный = Служба().НайтиПакеты("postgres", 1, 20);      // тир: точное имя
	Опечатка = Служба().НайтиПакеты("postgers", 1, 20);    // нечёткий этап: перестановка

	Ожидаем.Что(Точный.Всего, "аноним не видит приватный пакет по точному имени").Равно(0);
	Ожидаем.Что(Опечатка.Всего, "аноним не видит приватный пакет и через нечёткий этап").Равно(0);
	Ожидаем.Что(СтрНайти(Имена(Опечатка) + Имена(Точный), "postgres"),
		"имя приватного пакета не утекло ни в одной выдаче").Равно(0);

	// у субъекта с правом чтения оба пути работают — отбор именно сужает выдачу
	Читатель = СоздатьПользователя("user");
	ВыдатьЧтение(Прив, Читатель);
	Ожидаем.Что(Имена(Служба().НайтиПакеты("postgers", 1, 20, ПринципалСессии(Читатель))),
		"субъекту с чтением опечатка находит приватный пакет").Равно("postgres");

КонецПроцедуры

// --- граничные значения контракта ---

&Тест
Процедура НечисловойРазмерСтраницыСводитсяКДефолту() Экспорт
	Зарег("alpha");
	Найдено = Служба().НайтиПакеты("alpha", 1, "мусор");
	Ожидаем.Что(Найдено.РазмерСтраницы, "нечисловой размер -> дефолт 20, без сбоя").Равно(20);
КонецПроцедуры

&Тест
Процедура СпецсимволыЗапросаИщутсяБуквально() Экспорт
	// «%» и «_» — обычные символы запроса, а не подстановочные знаки шаблона
	Зарег("alpha");
	Зарег("beta");
	Ожидаем.Что(Служба().НайтиПакеты("%", 1, 20).Всего, "«%» ничего не находит").Равно(0);
	Ожидаем.Что(Служба().НайтиПакеты("_", 1, 20).Всего, "«_» ничего не находит").Равно(0);
КонецПроцедуры

// --- служебные ---

Функция Служба()
	Возврат Поделка.НайтиЖелудь("СлужбаПоиска");
КонецФункции

Функция СервисПулов()
	Возврат Поделка.НайтиЖелудь("СервисПулов");
КонецФункции

Функция СервисПакетов()
	Возврат Поделка.НайтиЖелудь("СервисПакетов");
КонецФункции

Функция Статистика()
	Возврат Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний");
КонецФункции

Функция Зарег(Знач Имя)
	Возврат СервисПакетов().ЗарегистрироватьПакет(Пул_.Идентификатор, Имя);
КонецФункции

// --- ACL-хелперы (шаг 3.E) ---

Функция ПриватныйПул()
	Хвост = НРег(СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", ""));
	Возврат СервисПулов().СоздатьПул("priv" + Лев(Хвост, 12), "custom", "private");
КонецФункции

Функция ЗарегВПул(Знач Пул, Знач Имя)
	Возврат СервисПакетов().ЗарегистрироватьПакет(Пул.Идентификатор, Имя);
КонецФункции

Функция СоздатьПользователя(Знач РольХаба)
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Суффикс = Строка(Новый УникальныйИдентификатор());
	Польз.Логин = "u" + Лев(СтрЗаменить(Суффикс, "-", ""), 12);
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

// Принципал сессии браузера: ключа в запросе нет, сужать выдачу нечем.
Функция ПринципалСессии(Знач Пользователь)
	Возврат Принципал(Пользователь, "session", "", 0);
КонецФункции

// Принципал запроса с ключом; ПулИдентификатор = 0 означает ключ без привязки к пулу.
Функция ПринципалКлюча(Знач Пользователь, Знач ПулИдентификатор, Знач Права = "read,write")
	Возврат Принципал(Пользователь, "token", Права, ПулИдентификатор);
КонецФункции

// Принципал ключа с НАБОРОМ пулов — так его собирает перехватчик после выпуска.
Функция ПринципалНабора(Знач Пользователь, Знач Пулы, Знач Права = "read,write")
	Возврат Новый Структура("Пользователь, Способ, Права, Пулы, ПулИдентификатор, Сессия",
		Пользователь, "token", Права, Пулы, 0, Неопределено);
КонецФункции

Функция Принципал(Знач Пользователь, Знач Способ, Знач Права, Знач ПулИдентификатор)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, Способ, Права, ПулИдентификатор, Неопределено);
КонецФункции

Процедура ВыдатьЧтение(Знач Пул, Знач Пользователь)
	Права = Поделка.НайтиЖелудь("СервисПрав");
	Доступ = Поделка.НайтиЖелудь("СервисПравДоступа");
	Действия = Новый Структура("создание, изменение, удаление, чтение", Ложь, Ложь, Ложь, Истина);
	Доступ.ЗафиксироватьГрант("пользователь", Пользователь.Идентификатор, Права.ОбъектПул(Пул), Действия, 0);
КонецПроцедуры

Функция ЗарегСо(Знач Имя, Знач Описание, Знач КлючевыеСлова)
	Возврат СервисПакетов().ЗарегистрироватьПакет(Пул_.Идентификатор, Имя,
		Новый Структура("Описание, КлючевыеСлова", Описание, КлючевыеСлова));
КонецФункции

// Имена пакетов страницы через запятую (в порядке ранжирования).
Функция Имена(Знач Найдено)
	Список = "";
	Для Каждого Пакет Из Найдено.Элементы Цикл
		Список = Список + ?(ЗначениеЗаполнено(Список), ",", "") + Пакет.Имя;
	КонецЦикла;
	Возврат Список;
КонецФункции
