// Живой хаб с включённой телеметрией против настоящего OTLP-приёмника: доказывается,
// что фоновая работа — разбор очереди доставок и обход зеркала — видна оператору.
// У доставок появляется общий корень трассы, у доставок и обходов — счётчики вызовов
// и гистограмма длительности. Офлайн этого не увидеть: спаны и срезы метрик собирает
// фоновый экспорт SDK, и сюда они попадают только по сети.
//
// Протокол выбран http/json, а не поставочный http/protobuf: сигналы одни и те же,
// а тело партии читается как текст, и приёмнику не нужен разбор protobuf.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент;
Перем Коллектор;
Перем Разбор;          // фикстура РазборOTLP — партии спанов и срезы метрик значениями
Перем КаталогСборки;
Перем ТокенRoot;
Перем ТрассыПростоя;   // трассы, уехавшие за окно простоя — снято ДО заказа фона
Перем ШаговПростоя;    // сколько шагов цикла доставщик сделал за то же окно

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("РазборOTLP");

	Разбор = Новый РазборOTLP();

	КаталогСборки = УникальныеИмена.ВременныйКаталог("oshub-метрики-фона-ospx");

	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);

	Хаб.ФайловаяБаза("openhub-метрики-фона");
	Хаб.Среда("OTEL_ENABLED", "true");
	Хаб.Среда("OTEL_SERVICE_NAME", "openhub-метрики-фона-тест");
	Хаб.Среда("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Хаб.Среда("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	// Партия спанов и срез метрик — по расписанию. Ждать штатных 5 и 60 секунд тесту
	// незачем: интервалы это настройки, и они же ускоряются.
	Хаб.Среда("OTEL_BSP_SCHEDULE_DELAY", "1000");
	Хаб.Среда("OTEL_METRIC_EXPORT_INTERVAL", "2000");
	// Очередь доставок разбирается раз в секунду вместо штатных пяти, а отправка
	// на мёртвую цель не ждёт ответа дольше двух.
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__INTERVAL__SEC", "1");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__TIMEOUT__SEC", "2");
	// О каждом своём шаге доставщик отчитывается строкой уровня отладки — по ней видно,
	// что окно простоя он отработал, а не проспал.
	Хаб.Среда("OSHUB_LOG_LEVEL", "DEBUG");
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));
	Хаб.Запустить();

	ТокенRoot = ВыпуститьPAT(Клиент.Войти("root", "RootPassw0rd"));

	ПростоятьИСнятьУлики();

	ЗаказатьДоставкуВебхука();
	ЗаказатьОбходЗеркала();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;

	УникальныеИмена.УбратьВременное(КаталогСборки);

КонецПроцедуры

// Партия из ничего не делается. Доставщик крутится вечно и на простаивающем хабе делает
// шаг за шагом впустую; заводи он корень на каждом таком шаге — в поиске по трассам
// утонуло бы всё остальное. Снимок берётся ДО заказа фона, поэтому порядок тестов
// на сторож не влияет.
&Тест
Процедура ПустойШагДоставщикаКорняНеЗаводит() Экспорт

	// Доставщик окно простоя отработал: без этого «спанов нет» означало бы всего лишь
	// «цикл не крутился», и сторож был бы зелен на спящем хабе.
	Ожидаем.Что(ШаговПростоя >= ШаговДляУлики(), СтрШаблон(
		"за окно простоя доставщик сделал не меньше %1 шагов цикла, а сделал %2",
		ШаговДляУлики(), ШаговПростоя)).ЭтоИстина();

	Спаны = Разбор.СпаныПартий(ТрассыПростоя);
	// И трассы за это окно уезжали: ноль спанов партии в пустой выборке доказывал бы
	// разве что молчание коллектора.
	Ожидаем.Что(Спаны.Количество() > 0,
		"за окно простоя трассы хаба уезжали — выборка сторожа не пуста").ЭтоИстина();

	Ожидаем.Что(Разбор.СпановСИменем(Спаны, ИмяСпанаПартии()), СтрШаблон(
		"на %1 пустых шагах цикла спанов ""%2"" не завелось ни одного",
		ШаговПростоя, ИмяСпанаПартии())).Равно(0);

КонецПроцедуры

// Ради этого корень и заводился: доставки вечного цикла раньше приезжали в трассу
// сиротами — по спану доставки было не понять, каким шагом разбора очереди он вызван.
// Родство проверяется ссылкой parentSpanId, а не соседством в партии: соседями спаны
// оказываются и без всякого родства.
&Тест
Процедура ДоставкаВебхукаИдётПодКорнемПартии() Экспорт

	Родство = ДождатьсяДоставкиПодПартией(ЖдатьСекунд());

	Ожидаем.Что(Родство, СтрШаблон(
		"среди уехавших спанов есть доставка ""%1"" с родителем ""%2""",
		ИмяСпанаДоставки(), ИмяСпанаПартии())).Заполнено();
	Ожидаем.Что(Родство.Доставка.Трасса,
		"доставка и партия ведут ОДНУ трассу").Равно(Родство.Партия.Трасса);

КонецПроцедуры

// Счётчик попыток доставки — первая бизнес-метрика хаба: по ней видно, что очередь
// не просто не растёт, а действительно разбирается. Сверяется ТОЧКА ДАННЫХ прибора,
// а не подстрока в теле партии: имя метрики встречается в партии и тогда, когда вызовов
// не было ни одного.
&Тест
Процедура СчётчикПопытокДоставкиУезжаетМетрикой() Экспорт

	Тело = Коллектор.ДождатьсяПартии("metrics", ИмяСчётчикаПопыток(), ЖдатьСекунд());

	Ожидаем.Что(ВызововСчётчика(Тело, ИмяСчётчикаПопыток()) >= 1, СтрШаблон(
		"у счётчика %1 есть точка данных с непустым числом попыток",
		ИмяСчётчикаПопыток())).ЭтоИстина();

КонецПроцедуры

// Цикл обхода зеркала меряется парой приборов: счётчик отвечает «сколько порций хаб
// прогнал», гистограмма — «сколько порция стоила». Обе поставлены аннотациями на том же
// методе, что заводит корневой спан цикла, и уехать обязаны обе.
&Тест
Процедура ЦиклСинхронизацииЗеркалаУезжаетСчётчикомИГистограммой() Экспорт

	Счётчики = Коллектор.ДождатьсяПартии("metrics", ИмяСчётчикаЦиклов(), ЖдатьСекунд());
	Ожидаем.Что(ВызововСчётчика(Счётчики, ИмяСчётчикаЦиклов()) >= 1, СтрШаблон(
		"у счётчика %1 есть точка данных с непустым числом циклов",
		ИмяСчётчикаЦиклов())).ЭтоИстина();

	Замеры = Коллектор.ДождатьсяПартии("metrics", ИмяГистограммыЦикла(), ЖдатьСекунд());
	Ожидаем.Что(ЗамеровГистограммы(Замеры, ИмяГистограммыЦикла()) >= 1, СтрШаблон(
		"у гистограммы %1 есть точка данных хотя бы с одним замером",
		ИмяГистограммыЦикла())).ЭтоИстина();

КонецПроцедуры

#Область Имена

Функция ИмяСпанаПартии()
	Возврат "webhooks.batch";
КонецФункции

Функция ИмяСпанаДоставки()
	Возврат "webhook.deliver";
КонецФункции

Функция ИмяСчётчикаПопыток()
	Возврат "oshub.webhook.attempts";
КонецФункции

Функция ИмяСчётчикаЦиклов()
	Возврат "oshub.mirror.sync.cycles";
КонецФункции

Функция ИмяГистограммыЦикла()
	Возврат "oshub.mirror.sync.cycle.duration";
КонецФункции

// Фоновому циклу надо успеть разобрать очередь, а срезу метрик — уехать. Порог взят
// с запасом на медленную машину: разбор идёт раз в секунду, срез — раз в две.
Функция ЖдатьСекунд()
	Возврат 120;
КонецФункции

// Сколько шагов цикла за окно простоя считаем доказательством работающего доставщика:
// при интервале в секунду они набегают за пять секунд, а окно кончается по ним, не по часам.
Функция ШаговДляУлики()
	Возврат 5;
КонецФункции

// Докуда ждём эти шаги, если доставщик по какой-то причине идёт медленнее: на медленной
// машине потолок не срабатывает вовсе, а на сломанном цикле сторож краснеет, а не висит.
Функция ПотолокПростояСекунд()
	Возврат 30;
КонецФункции

// Хвост окна: партия спанов уезжает по расписанию otel.bsp.schedule.delay (здесь — секунда),
// и двух секунд хватает, чтобы всё заведённое последними шагами успело доехать.
Функция ВыгрузкиПартииСекунд()
	Возврат 2;
КонецФункции

// Строка журнала, которой доставщик отчитывается о каждом своём шаге. Видна только
// на уровне отладки — его набор и включает.
Функция ПриметаШагаЦикла()
	Возврат "Доставщик подписок: шаг цикла";
КонецФункции

// Цель подписки во внутренней сети: DNS не нужен, а соединение на порт 1 отбивается
// сразу — доставка не висит на таймауте. Схема только https: http хаб принимает лишь
// при oshub.webhooks.allow_insecure, а тест настройки по умолчанию не трогает.
Функция МёртваяЦельВебхука()
	Возврат "https://127.0.0.1:1/hook-" + Строка(Новый УникальныйИдентификатор());
КонецФункции

// Апстрим зеркала там же и по той же причине.
Функция МёртвыйАпстрим()
	Возврат "http://127.0.0.1:1/download/";
КонецФункции

#КонецОбласти

#Область ЗаказРаботыФону

// Держит хаб в простое, пока доставщик не отработает окно шагами, и снимает две улики
// одного окна: что уехало трассами и сколько шагов цикла он сделал. Вторая улика нужна
// затем, что «спанов нет» у работающего доставщика и у спящего выглядит одинаково.
Процедура ПростоятьИСнятьУлики()

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПотолокПростояСекунд() * 1000;

	Пока СтрЧислоВхождений(Хаб.Дамп(), ПриметаШагаЦикла()) < ШаговДляУлики()
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(200);
	КонецЦикла;

	// Спан уезжает не в момент своего конца, а очередной партией конвейера: заведись он
	// на последнем шаге — без этой паузы сторож объявил бы тишину раньше времени.
	Приостановить(ВыгрузкиПартииСекунд() * 1000);

	ТрассыПростоя = Коллектор.Принятое("traces");
	ШаговПростоя = СтрЧислоВхождений(Хаб.Дамп(), ПриметаШагаЦикла());

КонецПроцедуры

// Подписка на публикацию плюс сама публикация: событие кладёт задание в очередь,
// а разбирает её фоновый доставщик — ровно тот путь, который тест и наблюдает.
Процедура ЗаказатьДоставкуВебхука()

	Пул = ЗавестиПул("hooks");

	Подписка = СтрШаблон("{""тип"":""вебхук"",""url"":""%1"",""события"":[""версия.опубликована""]}",
		МёртваяЦельВебхука());
	Заведена = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/webhooks", Пул),
		Подписка, ТокенRoot);
	Ожидаем.Что(Заведена.КодСостояния,
		"подписка на вебхук заведена: " + Клиент.Тело(Заведена)).Равно(201);

	Опубликована = Публикация(СтрШаблон("/api/v1/pools/%1/push", Пул),
		Новый ФикстураПакета().ДанныеOspx(КаталогСборки, "hookpkg", "1.0.0"), "hookpkg-1.0.0.ospx");
	Ожидаем.Что(Опубликована.КодСостояния,
		"версия опубликована — событие ушло в очередь: " + Клиент.Тело(Опубликована)).Равно(201);

КонецПроцедуры

// Заявка на синхронизацию: сам обход гоняет фоновый рабочий очереди, а не этот запрос.
Процедура ЗаказатьОбходЗеркала()

	Пул = ЗавестиПул("mirror");

	Заведено = Клиент.ЗапросJSONСТокеном("POST", СтрШаблон("/api/v1/pools/%1/mirrors", Пул),
		СтрШаблон("{""url"":""%1"",""интервал"":900}", МёртвыйАпстрим()), ТокенRoot);
	Ожидаем.Что(Заведено.КодСостояния,
		"зеркало заведено: " + Клиент.Тело(Заведено)).Равно(201);
	Ид = Формат(Клиент.ТелоJSON(Заведено).Получить("mirror").Получить("id"), "ЧГ=0; ЧН=0");

	Заявка = Клиент.ЗапросJSONСТокеном("POST",
		СтрШаблон("/api/v1/pools/%1/mirrors/%2/sync", Пул, Ид), "{}", ТокенRoot);
	Ожидаем.Что(Заявка.КодСостояния,
		"заявка на обход принята: " + Клиент.Тело(Заявка)).Равно(202);

КонецПроцедуры

Функция ЗавестиПул(Знач Примета)

	Имя = УникальныеИмена.Имя(Примета);
	Ответ = Клиент.ЗапросJSONСТокеном("POST", "/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя), ТокенRoot);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);

	Возврат Имя;

КонецФункции

Функция Публикация(Знач Путь, Знач Данные, Знач ИмяФайла)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("Authorization", "Bearer " + ТокенRoot);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);

	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ВыпуститьPAT(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write"",""пул"":0}", КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: " + Ответ.КодСостояния;
	КонецЕсли;

	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

КонецФункции

#КонецОбласти

#Область РазборТрасс

// Ждёт, пока среди уехавших спанов найдётся доставка, сшитая со своей партией. Спан
// партии уезжает ПОЗЖЕ своих детей — он завершается последним, — поэтому одной партии
// мало: читается всё принятое, пока родство не сойдётся.
Функция ДождатьсяДоставкиПодПартией(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;

	Пока Истина Цикл

		Родство = ДоставкаПодПартией(Разбор.СпаныПартий(Коллектор.Принятое("traces")));
		Если Родство <> Неопределено Тогда
			Возврат Родство;
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
		Приостановить(1000);

	КонецЦикла;

КонецФункции

// Пара «доставка и её партия»; Неопределено — такой пары среди спанов нет. Родителя
// ищем ссылкой: parentSpanId доставки обязан совпасть с идентификатором спана партии.
Функция ДоставкаПодПартией(Знач Спаны)

	Для Каждого Пара Из Спаны Цикл

		Спан = Пара.Значение;
		Если Спан.Имя <> ИмяСпанаДоставки() Тогда
			Продолжить;
		КонецЕсли;

		Родитель = Спаны.Получить(Спан.Родитель);
		Если Родитель <> Неопределено И Родитель.Имя = ИмяСпанаПартии() Тогда
			Возврат Новый Структура("Доставка, Партия", Спан, Родитель);
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область РазборМетрик

// Наибольшее число вызовов, попавшее в срез счётчика. Точки суммируются: своя точка
// данных у каждой комбинации атрибутов, а у счётчика вызовов их столько, сколько разных
// исходов было. Берётся наибольший срез, а не последний: срезы накопительные, и самый
// ранний снят на непрогретом хабе. -1 — прибора в партиях нет.
Функция ВызововСчётчика(Знач Тело, Знач ИмяПрибора)

	Наибольшее = -1;

	Для Каждого Прибор Из Разбор.СнимкиПрибора(Тело, ИмяПрибора) Цикл
		Вызовов = 0;
		Для Каждого Точка Из Разбор.ТочкиАгрегации(Прибор, "sum") Цикл
			Вызовов = Вызовов + Разбор.ЧислоТочки(Точка, "asInt")
				+ Разбор.ЧислоТочки(Точка, "asDouble");
		КонецЦикла;
		Наибольшее = Макс(Наибольшее, Вызовов);
	КонецЦикла;

	Возврат Наибольшее;

КонецФункции

// Наибольшее число замеров, попавшее в срез гистограммы: у каждой точки данных своё
// count, и оно же отвечает на вопрос «сколько раз метод мерялся». -1 — прибора нет.
Функция ЗамеровГистограммы(Знач Тело, Знач ИмяПрибора)

	Наибольшее = -1;

	Для Каждого Прибор Из Разбор.СнимкиПрибора(Тело, ИмяПрибора) Цикл
		Замеров = 0;
		Для Каждого Точка Из Разбор.ТочкиАгрегации(Прибор, "histogram") Цикл
			Замеров = Замеров + Разбор.ЧислоТочки(Точка, "count");
		КонецЦикла;
		Наибольшее = Макс(Наибольшее, Замеров);
	КонецЦикла;

	Возврат Наибольшее;

КонецФункции

#КонецОбласти
