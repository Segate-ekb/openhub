// Примитив основа/ТихаяУборка: имя временного файла и уборка, которая никогда не роняет
// вызывающего. Проверяется значение — что два подряд взятых пути различны (иначе два
// параллельных приёма пакета писали бы в один файл), и что уборка молчит на любом входе.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Уборка;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ТихаяУборка");

КонецПроцедуры

&ПередКаждым
Процедура СобратьУборку() Экспорт
	Уборка = Новый ТихаяУборка();
КонецПроцедуры

&Тест
Процедура ДваПутиПодрядНикогдаНеСовпадают() Экспорт

	Первый = Уборка.ВременныйПуть("oshub-push-", "ospx");
	Второй = Уборка.ВременныйПуть("oshub-push-", "ospx");

	Ожидаем.Что(Первый = Второй,
		"два приёма пакета одновременно писали бы в один файл").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПутьЛожитсяВКаталогВременныхСПрефиксомИРасширением() Экспорт

	Путь = Уборка.ВременныйПуть("oshub-mirror-", "ospx");
	Имя = Новый Файл(Путь).Имя;

	Ожидаем.Что(Новый Файл(Путь).Путь, "каталог временных файлов системы")
		.Равно(Новый Файл(ОбъединитьПути(КаталогВременныхФайлов(), "x")).Путь);
	Ожидаем.Что(СтрНачинаетсяС(Имя, "oshub-mirror-"), "префикс на месте: " + Имя).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(Имя, ".ospx"), "расширение на месте: " + Имя).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезРасширенияИмяОстаётсяБезТочки() Экспорт

	// так берут путь под КАТАЛОГ распаковки: точка в его имени ничего не значит
	Имя = Новый Файл(Уборка.ВременныйПуть("openhub-пакет-")).Имя;

	Ожидаем.Что(СтрНайти(Имя, "."), "точки в имени нет: " + Имя).Равно(0);
	Ожидаем.Что(СтрНачинаетсяС(Имя, "openhub-пакет-"), "префикс на месте: " + Имя).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПутьБезПрефиксаТожеУникален() Экспорт

	Ожидаем.Что(Уборка.ВременныйПуть("", "ospx") = Уборка.ВременныйПуть("", "ospx"),
		"без префикса уникальность держит идентификатор").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УборкаМолчитНаЛюбомВходе() Экспорт

	Путь = Уборка.ВременныйПуть("oshub-уборка-", "bin");
	Байты = ПолучитьДвоичныеДанныеИзСтроки("мусор");
	Байты.Записать(Путь);

	Уборка.УдалитьФайл(Путь);
	Ожидаем.Что(Новый Файл(Путь).Существует(), "файл убран").ЭтоЛожь();

	// мусор на диске не должен затирать исходную ошибку и обрывать успешный путь
	Уборка.УдалитьФайл(Путь);
	Уборка.УдалитьФайл("");
	Уборка.УдалитьФайл(Неопределено);
	Уборка.УдалитьФайл(КаталогВременныхФайлов());

	Ожидаем.Что(Истина, "повтор, пустой путь, Неопределено и каталог прошли молча").ЭтоИстина();

КонецПроцедуры
