// Правило частоты алерта о заполнении пула и отбор подписок по их порогам.
// Классы собираются напрямую: правило чистое, контейнер ОСени ему не нужен.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогФикстур;
Перем КаталогМодулейПуть;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
	КаталогМодулейПуть = ОбъединитьПути(
		Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя, "src", "модули");

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Подключить(ОбъединитьПути(КаталогМодулейПуть, "реестр", "Классы"), "ЗаполнениеПула");
	Подключить(ОбъединитьПути(КаталогМодулейПуть, "события", "Классы"), "ИздательСобытий");
	Подключить(ОбъединитьПути(КаталогМодулейПуть, "события", "Классы"), "КаталогСобытий");
	Подключить(ОбъединитьПути(КаталогМодулейПуть, "подписки", "Классы"), "ПараметрыПодписки");
	Подключить(ОбъединитьПути(КаталогМодулейПуть, "подписки", "Классы"), "ОтборЗаполненияПула");
	Подключить(ОбъединитьПути(КаталогМодулейПуть, "реестр", "Классы"), "КвотаПула");
	Подключить(ОбъединитьПути(КаталогМодулейПуть, "реестр", "Классы"),
		"СторожЗаполненияПула");
	Подключить(КаталогФикстур, "ЗаписывающийПодписчик");
	Подключить(КаталогФикстур, "ФейкВебхукЗапись");
	Подключить(КаталогФикстур, "ФейкХранилищеВебхуков");
	Подключить(КаталогФикстур, "ФейкПулЗаписьКвоты");

КонецПроцедуры

#Область Арифметика

&Тест
Процедура ПроцентСчитаетсяВнизИБезКвотыРавенНулю() Экспорт

	Правило = Новый ЗаполнениеПула();

	Ожидаем.Что(Правило.Процент(0, 1000), "пустой пул").Равно(0);
	Ожидаем.Что(Правило.Процент(499, 1000), "округление вниз: 49,9% — это 49").Равно(49);
	Ожидаем.Что(Правило.Процент(1000, 1000), "полный пул").Равно(100);
	Ожидаем.Что(Правило.Процент(1500, 1000), "переполнение видно числом").Равно(150);
	Ожидаем.Что(Правило.Процент(500, 0), "без квоты процента не существует").Равно(0);
	Ожидаем.Что(Правило.Процент(Неопределено, 1000), "пустое занятое — ноль").Равно(0);

КонецПроцедуры

&Тест
Процедура СтупеньЭтоНижняяГраницаДесятка() Экспорт

	Правило = Новый ЗаполнениеПула();
	Ожидаем.Что(Правило.Ступень(0)).Равно(0);
	Ожидаем.Что(Правило.Ступень(79)).Равно(70);
	Ожидаем.Что(Правило.Ступень(80)).Равно(80);
	Ожидаем.Что(Правило.Ступень(89)).Равно(80);
	Ожидаем.Что(Правило.Ступень(100)).Равно(100);

КонецПроцедуры

#КонецОбласти

#Область ПравилоЧастоты

&Тест
Процедура АлертУходитНаПересеченииПорога() Экспорт

	Правило = Новый ЗаполнениеПула();
	Ожидаем.Что(Правило.НужноСлать(80, 79, 81), "79% → 81% при пороге 80 — шлём").ЭтоИстина();
	Ожидаем.Что(Правило.НужноСлать(80, 0, 80), "ровно порог — тоже пересечение").ЭтоИстина();
	Ожидаем.Что(Правило.НужноСлать(80, 50, 95), "прыжок через порог — шлём один раз").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура МеждуДесяткамиАлертМолчит() Экспорт

	Правило = Новый ЗаполнениеПула();
	Ожидаем.Что(Правило.НужноСлать(80, 81, 82), "81% → 82% — молчим").ЭтоЛожь();
	Ожидаем.Что(Правило.НужноСлать(80, 82, 85), "82% → 85% — молчим").ЭтоЛожь();
	Ожидаем.Что(Правило.НужноСлать(80, 85, 89), "85% → 89% — тот же десяток").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НаКаждомСледующемДесяткеАлертУходит() Экспорт

	Правило = Новый ЗаполнениеПула();
	Ожидаем.Что(Правило.НужноСлать(80, 85, 90), "85% → 90% — новый десяток, шлём").ЭтоИстина();
	Ожидаем.Что(Правило.НужноСлать(80, 92, 100), "92% → 100% — шлём").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПадениеНижеПорогаСбрасываетВзвод() Экспорт

	Правило = Новый ЗаполнениеПула();

	// уже слали на 90; пул упал ниже порога и снова его пересёк — шлём опять,
	// хотя десяток тот же, что и в первый раз
	Ожидаем.Что(Правило.НужноСлать(80, 79, 81), "первое пересечение").ЭтоИстина();
	Ожидаем.Что(Правило.НужноСлать(80, 40, 81), "после падения ниже порога — снова шлём").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПадениеЗаполненияПисьмаНеПорождает() Экспорт

	Правило = Новый ЗаполнениеПула();
	Ожидаем.Что(Правило.НужноСлать(80, 95, 85), "пул опустел — не повод для письма").ЭтоЛожь();
	Ожидаем.Что(Правило.НужноСлать(80, 90, 90), "ничего не изменилось").ЭтоЛожь();
	Ожидаем.Что(Правило.НужноСлать(80, 10, 50), "ниже порога — молчим").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВзводНеХранитСостоянияИПереживаетПерезапуск() Экспорт

	// ГАРАНТИЯ: правило чистое — тот же ответ на тот же ввод, сколько раз ни спроси.
	// Поэтому «на каком десятке уже слали» нигде не хранится, и перезапуск хаба
	// не приводит ни к повторному письму, ни к потере следующего.
	Первое = Новый ЗаполнениеПула();
	Второе = Новый ЗаполнениеПула();

	Для Каждого Пара Из Пары() Цикл
		Ожидаем.Что(Первое.НужноСлать(80, Пара.До, Пара.После),
			СтрШаблон("%1 → %2 повторно", Пара.До, Пара.После))
			.Равно(Второе.НужноСлать(80, Пара.До, Пара.После));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОтборПодписок

&Тест
Процедура ОтборПропускаетТолькоПодпискиСоСработавшимПорогом() Экспорт

	Отбор = НовыйОтбор();
	Событие = СобытиеЗаполнения(79, 81);

	Ожидаем.Что(Отбор.Доставлять(ПодпискаСПорогом(80), Событие),
		"порог 80 пересечён — доставляем").ЭтоИстина();
	Ожидаем.Что(Отбор.Доставлять(ПодпискаСПорогом(90), Событие),
		"порог 90 не достигнут — не доставляем").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПодпискаБезЯвногоПорогаБерётУмолчаниеКаталога() Экспорт

	Отбор = НовыйОтбор();
	Подписка = Новый ФейкВебхукЗапись(Новый ФейкХранилищеВебхуков());
	Подписка.ТипыСобытий = ТипЗаполнения();
	Подписка.ПараметрыСобытийJSON = "";

	Ожидаем.Что(Отбор.Доставлять(Подписка, СобытиеЗаполнения(79, 81)),
		"умолчание каталога — 80%").ЭтоИстина();
	Ожидаем.Что(Отбор.Доставлять(Подписка, СобытиеЗаполнения(50, 60)),
		"до умолчания ещё далеко").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СобытиеБезПараметраОтборНеТрогает() Экспорт

	Отбор = НовыйОтбор();
	Событие = Новый Структура("Тип, Когда, Данные",
		Новый ИздательСобытий().ТипВерсияОпубликована(), ТекущаяУниверсальнаяДата(), Новый Структура());

	Ожидаем.Что(Отбор.Доставлять(ПодпискаСПорогом(90), Событие),
		"чужое событие отбор пропускает как есть").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПорогВнеГраницПриводитсяКУмолчанию() Экспорт

	Параметры = НовыеПараметры();
	Ожидаем.Что(Параметры.Значение(ПодпискаСПорогом(0), ТипЗаполнения()),
		"ноль ниже минимума — умолчание").Равно(80);
	Ожидаем.Что(Параметры.Значение(ПодпискаСПорогом(500), ТипЗаполнения()),
		"выше сотни порога не бывает — умолчание").Равно(80);
	Ожидаем.Что(Параметры.Значение(ПодпискаСПорогом(35), ТипЗаполнения()),
		"значение в границах сохраняется").Равно(35);

КонецПроцедуры

&Тест
Процедура ПараметрыСобираютсяТолькоДляВыбранныхСобытийСПараметром() Экспорт

	Параметры = НовыеПараметры();
	Ввод = Новый Соответствие();
	Ввод.Вставить(ТипЗаполнения(), "42");
	Ввод.Вставить(Новый ИздательСобытий().ТипВерсияОпубликована(), "77");

	Собранное = Параметры.Собрать(
		ТипЗаполнения() + "," + Новый ИздательСобытий().ТипВерсияОпубликована(), Ввод);

	Ожидаем.Что(СтрНайти(Собранное, "42") > 0, "порог выбранного события сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Собранное, "77"), "у события без параметра сохранять нечего").Равно(0);

	Ожидаем.Что(Параметры.Собрать(Новый ИздательСобытий().ТипВерсияОпубликована(), Ввод),
		"набор без параметризованных событий даёт пустую колонку").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Сторож

&Тест
Процедура СторожПубликуетСобытиеТолькоНаРостеЗаполнения() Экспорт

	Издатель = Новый ИздательСобытий();
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПулЗаполнен(), Слушатель);
	Сторож = НовыйСторож(Издатель);
	Пул = Новый ФейкПулЗаписьКвоты(3, "мойпул", 1);  // квота 1 МБ

	Сторож.ПослеИзменения(Пул, 0, 524288);
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПулЗаполнен()), "рост дал событие").Равно(1);

	Событие = Слушатель.Первое(Издатель.ТипПулЗаполнен());
	Ожидаем.Что(Событие.Данные.Процент, "процент после").Равно(50);
	Ожидаем.Что(Событие.Данные.ПроцентДо, "процент до").Равно(0);
	Ожидаем.Что(Цел(Событие.Данные.ПулИдентификатор), "скоуп пула в нагрузке").Равно(3);

КонецПроцедуры

&Тест
Процедура СторожСообщаетОбУрезанииКвотыПриНеизменномЗанятом() Экспорт

	Издатель = Новый ИздательСобытий();
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПулЗаполнен(), Слушатель);
	Сторож = НовыйСторож(Издатель);

	Пул = Новый ФейкПулЗаписьКвоты(3, "мойпул", 1);
	Пул.ЗанятоБайт = 209716; // 20% от 1 МБ и больше 200% от 100 КБ

	Сторож.ПослеСменыКвоты(Пул, 1048576, 102400);

	Событие = Слушатель.Первое(Издатель.ТипПулЗаполнен());
	Ожидаем.Что(Событие <> Неопределено, "урезание квоты дало событие").ЭтоИстина();
	Ожидаем.Что(Событие.Данные.ПроцентДо, "до урезания было 20%").Равно(20);
	Ожидаем.Что(Событие.Данные.Процент, "после — переполнение").Равно(204);

	// расширение квоты молчит: пул стал свободнее
	Сторож.ПослеСменыКвоты(Пул, 102400, 1048576);
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПулЗаполнен()),
		"второго события не было").Равно(1);

	// снятие ограничения тоже молчит: процента без квоты не существует
	Сторож.ПослеСменыКвоты(Пул, 1048576, 0);
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПулЗаполнен()),
		"без квоты сообщать не о чем").Равно(1);

КонецПроцедуры

&Тест
Процедура СторожМолчитНаПаденииИБезКвоты() Экспорт

	Издатель = Новый ИздательСобытий();
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПулЗаполнен(), Слушатель);
	Сторож = НовыйСторож(Издатель);

	Сторож.ПослеИзменения(Новый ФейкПулЗаписьКвоты(3, "мойпул", 1), 524288, 100);
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПулЗаполнен()), "падение события не даёт").Равно(0);

	Сторож.ПослеИзменения(Новый ФейкПулЗаписьКвоты(4, "безлимитный", 0), 0, 999999999);
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПулЗаполнен()),
		"пул без ограничения процента не имеет").Равно(0);

КонецПроцедуры

#КонецОбласти

// --- служебные ---

Функция ТипЗаполнения()
	Возврат Новый ИздательСобытий().ТипПулЗаполнен();
КонецФункции

Функция НовыйКаталог()
	Возврат Новый КаталогСобытий(Новый ИздательСобытий(), Новый ЗаполнениеПула());
КонецФункции

Функция НовыеПараметры()
	Возврат Новый ПараметрыПодписки(НовыйКаталог());
КонецФункции

Функция НовыйОтбор()
	Возврат Новый ОтборЗаполненияПула(НовыеПараметры(), Новый ЗаполнениеПула(), Новый ИздательСобытий());
КонецФункции

Функция НовыйСторож(Знач Издатель)
	Издатели = Новый Массив();
	Издатели.Добавить(Издатель);
	Возврат Новый СторожЗаполненияПула(Новый КвотаПула(Новый Массив()), Новый ЗаполнениеПула(), Издатели);
КонецФункции

Функция ПодпискаСПорогом(Знач Порог)
	Подписка = Новый ФейкВебхукЗапись(Новый ФейкХранилищеВебхуков());
	Подписка.ТипыСобытий = ТипЗаполнения();
	Подписка.ПараметрыСобытийJSON = СтрШаблон("{""%1"":{""порог"":%2}}",
		ТипЗаполнения(), Формат(Порог, "ЧГ=0; ЧН=0"));
	Возврат Подписка;
КонецФункции

Функция СобытиеЗаполнения(Знач ПроцентДо, Знач Процент)
	Данные = Новый Структура("ПулИдентификатор, ИмяПула, Процент, ПроцентДо", 1, "пул", Процент, ПроцентДо);
	Возврат Новый Структура("Тип, Когда, Данные", ТипЗаполнения(), ТекущаяУниверсальнаяДата(), Данные);
КонецФункции

Функция Пары()
	Результат = Новый Массив();
	Для Каждого Пара Из СтрРазделить("79:81,81:82,85:90,40:81,95:85,92:100", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Результат.Добавить(Новый Структура("До, После", Число(Части[0]), Число(Части[1])));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Класс ищется по имени в каталоге и его подкаталогах: путь к файлу из имени
// не строится (docs/процесс/РАСКЛАДКА.md).
Процедура Подключить(Знач КаталогКлассов, Знач Имя)
	ПоискКлассов.Подключить(КаталогКлассов, Имя);
КонецПроцедуры
