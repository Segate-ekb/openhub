// Самотест фикстуры СтендЗеркал: на ней стоят наборы движка обхода и каскадного сноса
// пула. Зеркало, заведённое с мусором в колонках прогона, ведёт себя в инкрементальном
// обходе не так, как настоящее, — и набор зеленеет на состоянии, которого у хаба не бывает.
// Проверяется то, ЧТО ВИДИТ хранилище после стенда.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;       // общий контейнер на все тесты набора
Перем Засев;         // фикстура ЗасевРеестра — пул, которому принадлежит зеркало
Перем Стенд;         // фикстура СтендЗеркал — строка зеркала хаба

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендЗеркал");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "стенд-зеркал-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("стенд-зеркал-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендЗеркал(Поделка);

КонецПроцедуры

&Тест
Процедура ЗеркалоЛожитсяВБазуНаСвойПул() Экспорт

	Пул = Засев.Пул();

	Зеркало = Стенд.Зеркало(Пул);

	Свои = Желудь("ХранилищеЗеркалХабов").ПолучитьПоПулНазначенияИдентификаторРавно(
		Пул.Идентификатор);
	Ожидаем.Что(Свои.Количество(), "зеркало видно хранилищу").Равно(1);
	Ожидаем.Что(Свои[0].Идентификатор, "то самое зеркало").Равно(Зеркало.Идентификатор);
	Ожидаем.Что(Свои[0].Включено, "зеркало включено по умолчанию").ЭтоИстина();
	Ожидаем.Что(Свои[0].Режим, "режим по умолчанию").Равно("opm");

КонецПроцедуры

// Что набор назвал двери, то и должно доехать до базы. Режим, потерянный по дороге,
// провёл бы набор инкрементального обхода мимо своей ветки движка.
&Тест
Процедура ДверьДоноситАдресРежимИПризнакВключения() Экспорт

	Пул = Засев.Пул();

	Стенд.Зеркало(Пул, "http://selftest.example/download/", "api-v1", Ложь);

	Запись = Желудь("ХранилищеЗеркалХабов").ПолучитьПоПулНазначенияИдентификаторРавно(
		Пул.Идентификатор)[0];
	Ожидаем.Что(Запись.АпстримURL, "адрес источника дошёл до базы")
		.Равно("http://selftest.example/download/");
	Ожидаем.Что(Запись.Режим, "режим дошёл до базы").Равно("api-v1");
	Ожидаем.Что(Запись.Включено, "снятый признак включения дошёл до базы").ЭтоЛожь();

КонецПроцедуры

// Колонки прогона — не украшение: движок обхода читает и пишет их, и зеркало,
// заведённое с непустым курсором или ненулевыми счётчиками, ведёт себя как зеркало
// посреди прогона, а не как только что заведённое.
&Тест
Процедура НовоеЗеркалоПростаиваетСЧистымиСчётчиками() Экспорт

	Запись = Стенд.Зеркало(Засев.Пул());

	Ожидаем.Что(Запись.СостояниеПрогона, "прогон не идёт").Равно("простаивает");
	Ожидаем.Что(Цел(Запись.ПрогонВсего), "счётчик всего").Равно(0);
	Ожидаем.Что(Цел(Запись.ПрогонСкачано), "счётчик скачанного").Равно(0);
	Ожидаем.Что(Цел(Запись.ПрогонПропущено), "счётчик пропущенного").Равно(0);
	Ожидаем.Что(Цел(Запись.ПрогонОшибок), "счётчик ошибок").Равно(0);
	Ожидаем.Что(Цел(Запись.ПрогонНедоступно), "счётчик недоступного").Равно(0);
	Ожидаем.Что(Цел(Запись.ПрогонИмёнВсего), "счётчик имён").Равно(0);
	Ожидаем.Что(Цел(Запись.ПрогонИмёнПройдено), "счётчик пройденных имён").Равно(0);
	Ожидаем.Что(Запись.ПрогонКурсор, "курсор пуст").Равно("");
	Ожидаем.Что(Запись.ПрогонЗапустил, "запустившего нет").Равно("");

КонецПроцедуры

// Моменты обхода движок сравнивает: зеркало, у которого они не заданы вовсе, читается
// как «синхронизировалось только что» и уводит инкремент не туда.
&Тест
Процедура МоментыОбходаНовогоЗеркалаПусты() Экспорт

	Запись = Стенд.Зеркало(Засев.Пул());

	Пусто = '00010101000000';
	Ожидаем.Что(Запись.ПоследнийСинк, "последний синк").Равно(Пусто);
	Ожидаем.Что(Запись.ВычитаноДо, "вычитано до").Равно(Пусто);
	Ожидаем.Что(Запись.ПрогонСрезС, "срез с").Равно(Пусто);
	Ожидаем.Что(Запись.ПрогонМоментСреза, "момент среза").Равно(Пусто);
	Ожидаем.Что(Запись.Создан, "момент заведения задан").Заполнено();
	Ожидаем.Что(Запись.Обновлён, "момент правки задан").Равно(Запись.Создан);

КонецПроцедуры

// Пул называется набору то записью, то идентификатором — обе формы кладут зеркало
// на один и тот же пул.
&Тест
Процедура ПулНазываетсяЗаписьюЛибоИдентификатором() Экспорт

	Пул = Засев.Пул();

	Стенд.Зеркало(Пул);
	Стенд.Зеркало(Пул.Идентификатор);

	Ожидаем.Что(Желудь("ХранилищеЗеркалХабов").ПолучитьПоПулНазначенияИдентификаторРавно(
		Пул.Идентификатор).Количество(), "оба зеркала на этом пуле").Равно(2);

КонецПроцедуры

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции
