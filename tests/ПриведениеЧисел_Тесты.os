// Примитив основа/ПриведениеЧисел: пять способов прочитать число снаружи и один — его
// напечатать. Проверяется значение и главное различие между ними: терпимое чтение мусор
// прощает, строгое — отвергает, а усекающее берёт целую часть. Путать их нельзя: ноль
// в квоте значим («без лимита»), и мусор обязан быть от него отличим.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Числа;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ПриведениеЧисел");

КонецПроцедуры

&ПередКаждым
Процедура СобратьЧисла() Экспорт
	Числа = Новый ПриведениеЧисел();
КонецПроцедуры

#Область ТерпимоеЧтение

&Тест
Процедура ЧислоИлиНольПрощаетМусорИПустоту() Экспорт

	Ожидаем.Что(Числа.ЧислоИлиНоль("42"), "число строкой").Равно(42);
	Ожидаем.Что(Числа.ЧислоИлиНоль(42), "число числом").Равно(42);
	Ожидаем.Что(Числа.ЧислоИлиНоль("абв"), "нечисло — ноль").Равно(0);
	Ожидаем.Что(Числа.ЧислоИлиНоль(""), "пустая строка — ноль").Равно(0);
	Ожидаем.Что(Числа.ЧислоИлиНоль(Неопределено), "Неопределено — ноль").Равно(0);

КонецПроцедуры

&Тест
Процедура ЧислоИлиДефолтОтдаётСвоёЗначениеНаПустоте() Экспорт

	Ожидаем.Что(Числа.ЧислоИлиДефолт("", 20), "пусто — дефолт").Равно(20);
	Ожидаем.Что(Числа.ЧислоИлиДефолт("абв", 20), "мусор — дефолт").Равно(20);
	Ожидаем.Что(Числа.ЧислоИлиДефолт("5", 20), "значение сильнее дефолта").Равно(5);

КонецПроцедуры

#КонецОбласти

#Область СтрогоеЧтение

&Тест
Процедура ЦелоеИлиНеопределеноОтличаетМусорОтНуля() Экспорт

	Ожидаем.Что(Числа.ЦелоеИлиНеопределено("0"), "явный ноль — это ноль").Равно(0);
	Ожидаем.Что(Числа.ЦелоеИлиНеопределено("абв"), "мусор — Неопределено, а не ноль")
		.Равно(Неопределено);
	Ожидаем.Что(Числа.ЦелоеИлиНеопределено("12abc"), "хвост букв делает значение мусором")
		.Равно(Неопределено);
	Ожидаем.Что(Числа.ЦелоеИлиНеопределено("", 7), "пусто — значение по умолчанию").Равно(7);
	Ожидаем.Что(Числа.ЦелоеИлиНеопределено(" 15 "), "обрамляющие пробелы не значимы").Равно(15);

КонецПроцедуры

&Тест
Процедура ЦелоеСтрогоИлиНольНеУсекаетДробное() Экспорт

	// строгость и есть смысл этого чтения: «3.7» в адресе — не пул номер три,
	// а мусор, и пула с номером ноль не бывает
	Ожидаем.Что(Числа.ЦелоеСтрогоИлиНоль("3"), "целое читается").Равно(3);
	Ожидаем.Что(Числа.ЦелоеСтрогоИлиНоль("3.7"), "дробное — мусор, а не тройка").Равно(0);
	Ожидаем.Что(Числа.ЦелоеСтрогоИлиНоль("-5"), "отрицательное — мусор").Равно(0);
	Ожидаем.Что(Числа.ЦелоеСтрогоИлиНоль("абв"), "нечисло — ноль").Равно(0);
	Ожидаем.Что(Числа.ЦелоеСтрогоИлиНоль(""), "пусто — ноль").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область УсекающееЧтениеИПечать

&Тест
Процедура ЦелаяЧастьУсекаетДробноеИПрощаетМусор() Экспорт

	Ожидаем.Что(Числа.ЦелаяЧасть("3.7"), "дробное усечено, а не отвергнуто").Равно(3);
	Ожидаем.Что(Числа.ЦелаяЧасть(3.7), "число тоже усекается").Равно(3);
	Ожидаем.Что(Числа.ЦелаяЧасть("абв"), "мусор — ноль").Равно(0);
	Ожидаем.Что(Числа.ЦелаяЧасть(Неопределено), "Неопределено — ноль").Равно(0);

КонецПроцедуры

&Тест
Процедура ТекстомПечатаетНольНолём() Экспорт

	// Формат(0, "ЧГ=0") в OneScript даёт ПУСТУЮ строку: «выдано 0» превратилось бы
	// в «выдано », и человек читал бы пропуск вместо числа
	Ожидаем.Что(Числа.Текстом(0), "ноль печатается нулём").Равно("0");
	Ожидаем.Что(Числа.Текстом(1234567), "разделителей групп нет").Равно("1234567");
	Ожидаем.Что(Числа.Текстом(3.7), "печатается целая часть").Равно("3");

КонецПроцедуры

#КонецОбласти

&Тест
Процедура ЦелоеСоЗнакомПринимаетМинусНоНеМусор() Экспорт

	Ожидаем.Что(Числа.ЦелоеСоЗнакомИлиНеопределено("-1"),
		"ведущий минус — часть числа: «как в хабе» пишется -1").Равно(-1);
	Ожидаем.Что(Числа.ЦелоеСоЗнакомИлиНеопределено(" 256 "),
		"пробелы по краям не мешают").Равно(256);
	Ожидаем.Что(Числа.ЦелоеСоЗнакомИлиНеопределено(-5),
		"число принимается наравне со строкой").Равно(-5);

	Для Каждого Мусор Из СтрРазделить("5oo|12abc|-|--1|-abc|1 2|+7|3.7", "|") Цикл
		Ожидаем.Что(Числа.ЦелоеСоЗнакомИлиНеопределено(Мусор),
			СтрШаблон("«%1» — не целое", Мусор)).Равно(Неопределено);
	КонецЦикла;

	Ожидаем.Что(Числа.ЦелоеСоЗнакомИлиНеопределено("", 7),
		"пустое берёт значение по умолчанию").Равно(7);

	// строгое чтение БЕЗ знака минус не принимает: там отрицательного не бывает
	Ожидаем.Что(Числа.ЦелоеИлиНеопределено("-1"),
		"минус для беззнакового чтения — мусор").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НеотрицательноеЦелоеНеОпускаетсяНижеНуля() Экспорт

	Ожидаем.Что(Числа.НеотрицательноеЦелое(-5), "отрицательное — ноль").Равно(0);
	Ожидаем.Что(Числа.НеотрицательноеЦелое("мусор"), "нечисло — ноль").Равно(0);
	Ожидаем.Что(Числа.НеотрицательноеЦелое(Неопределено), "пустое — ноль").Равно(0);
	Ожидаем.Что(Числа.НеотрицательноеЦелое(7.9), "дробное усекается").Равно(7);
	Ожидаем.Что(Числа.НеотрицательноеЦелое(1024), "обычное значение").Равно(1024);

КонецПроцедуры
