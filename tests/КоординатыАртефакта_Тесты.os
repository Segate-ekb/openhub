// Юнит-тесты координат артефакта: компоненты, имя файла по умолчанию,
// юникод, отказ на пустые/traversal/запрещённые значения.

#Использовать asserts
#Использовать "фикстуры"

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	ПутьККлассу = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("хранилище", "Классы", "КоординатыАртефакта.os"));

	// без глушения ошибок: синтаксически сломанный класс должен уронить набор
	ПоискКлассов.ПодключитьФайл(ПутьККлассу);

КонецПроцедуры

&Тест
Процедура КомпонентыСохраняютсяИИмяФайлаПоУмолчаниюКаноническое() Экспорт

	Координаты = Новый КоординатыАртефакта("main", "gitrunner", "1.9.3");

	Ожидаем.Что(Координаты.Пул()).Равно("main");
	Ожидаем.Что(Координаты.Пакет()).Равно("gitrunner");
	Ожидаем.Что(Координаты.Версия()).Равно("1.9.3");
	Ожидаем.Что(Координаты.ИмяФайла()).Равно("gitrunner-1.9.3.ospx");
	Ожидаем.Что(Координаты.Представление()).Равно("main/gitrunner/gitrunner-1.9.3.ospx");

КонецПроцедуры

&Тест
Процедура ЯвноеИмяФайлаИмеетПриоритет() Экспорт

	Координаты = Новый КоординатыАртефакта("main", "gitrunner", "1.9.3", "особый.ospx");

	Ожидаем.Что(Координаты.ИмяФайла()).Равно("особый.ospx");

КонецПроцедуры

&Тест
Процедура ЮникодВКомпонентахДопустим() Экспорт

	Координаты = Новый КоординатыАртефакта("пул-приватный", "пакет-тест", "1.0.0");

	Ожидаем.Что(Координаты.Пакет()).Равно("пакет-тест");
	Ожидаем.Что(Координаты.ИмяФайла()).Равно("пакет-тест-1.0.0.ospx");

КонецПроцедуры

&Тест
Процедура LegacyВерсияИзЧетырехКомпонентДопустима() Экспорт

	Координаты = Новый КоординатыАртефакта("main", "v8unpack", "1.2.3.4");

	Ожидаем.Что(Координаты.ИмяФайла()).Равно("v8unpack-1.2.3.4.ospx");

КонецПроцедуры

&Тест
Процедура ПустыеКомпонентыВызываютИсключение() Экспорт

	ОжидатьОтказКоординат("", "пакет", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет", "", "");
	ОжидатьОтказКоординат(Неопределено, "пакет", "1.0.0", "");
	ОжидатьОтказКоординат(42, "пакет", "1.0.0", "");

КонецПроцедуры

&Тест
Процедура РазделителиПутиВКомпонентахВызываютИсключение() Экспорт

	ОжидатьОтказКоординат("пул/вложенный", "пакет", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет\другой", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0/", "");
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0", "имя/файла.ospx");

КонецПроцедуры

&Тест
Процедура ТочкаИДвеТочкиВызываютИсключение() Экспорт

	ОжидатьОтказКоординат("..", "пакет", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "..", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет", "..", "");
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0", "..");
	ОжидатьОтказКоординат(".", "пакет", "1.0.0", "");

КонецПроцедуры

&Тест
Процедура ЗапрещенныеСимволыВызываютИсключение() Экспорт

	ОжидатьОтказКоординат("пул:диск", "пакет", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет*", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0?", "");
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0", "имя|файла");
	ОжидатьОтказКоординат("пул", "пакет" + Символы.ПС, "1.0.0", "");

КонецПроцедуры

&Тест
Процедура СлишкомДлиннаяКомпонентаВызываетИсключение() Экспорт

	ДопустимоеИмя = "";
	Для Ном = 1 По 100 Цикл
		ДопустимоеИмя = ДопустимоеИмя + "п";
	КонецЦикла;

	// ровно 100 символов - допустимо
	Координаты = Новый КоординатыАртефакта("пул", ДопустимоеИмя, "1.0.0", "файл.ospx");
	Ожидаем.Что(Координаты.Пакет()).Равно(ДопустимоеИмя);

	// 101 - отказ
	ОжидатьОтказКоординат("пул", ДопустимоеИмя + "п", "1.0.0", "файл.ospx");

КонецПроцедуры

&Тест
Процедура ЗарезервированныеИменаWindowsВызываютИсключение() Экспорт

	ОжидатьОтказКоординат("CON", "пакет", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "aux", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "Nul", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "COM1", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "lpt9", "1.0.0", "");
	// зарезервировано и с расширением
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0", "con.ospx");

	// похожие, но не зарезервированные - допустимы
	Координаты = Новый КоординатыАртефакта("пул", "console", "1.0.0", "com10.ospx");
	Ожидаем.Что(Координаты.Пакет()).Равно("console");

КонецПроцедуры

&Тест
Процедура ХвостовыеТочкиИПробелыВызываютИсключение() Экспорт

	ОжидатьОтказКоординат("пул.", "пакет", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет ", "1.0.0", "");
	ОжидатьОтказКоординат("пул", " пакет", "1.0.0", "");
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0", "имя.ospx ");
	ОжидатьОтказКоординат("пул", "пакет", "1.0.0", "имя.ospx.");

КонецПроцедуры

&Тест
Процедура ИмяИзОднихТочекВИмениФайлаНеПроходитПодмену() Экспорт

	// "a..b" внутри имени - безопасно и допустимо
	Координаты = Новый КоординатыАртефакта("пул", "пакет", "1.0.0", "и..мя.ospx");
	Ожидаем.Что(Координаты.ИмяФайла()).Равно("и..мя.ospx");

КонецПроцедуры

Процедура ОжидатьОтказКоординат(Знач Пул, Знач Пакет, Знач Версия, Знач ИмяФайла)

	БылоИсключение = Ложь;
	Попытка
		Координаты = Новый КоординатыАртефакта(Пул, Пакет, Версия, ИмяФайла);
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение,
		СтрШаблон("ожидали отказ координат для (%1, %2, %3, %4)", Пул, Пакет, Версия, ИмяФайла))
		.ЭтоИстина();

КонецПроцедуры
