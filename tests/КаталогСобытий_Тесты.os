// Юнит-тесты перечня событий хаба: каждое событие шины обязано быть в перечне и наоборот.
// Тест СКАНИРУЕТ исходники, а не спрашивает список у издателя, иначе гарантия свелась бы
// к «в списке то, что в списке». Тип события опознаётся по самому литералу, не по сигнатуре.

#Использовать asserts
#Использовать "фикстуры"
// autumn-logos — единая точка входа логирования (logos транзитивно): классы, созданные
// НАПРЯМУЮ (минуя контейнер ОСени), с шага 6.D получают лог от теста параметром.
#Использовать autumn-logos

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогСобытийПуть;
Перем ИсходникИздателя;
Перем КаталогМодулейПуть;
Перем КаталогВебхуковПуть;
Перем КаталогФикстур;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулейПуть = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогСобытийПуть = ОбъединитьПути(КаталогМодулейПуть, "события", "Классы");
	КаталогВебхуковПуть = ОбъединитьПути(КаталогМодулейПуть, "подписки", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
	ИсходникИздателя = ОбъединитьПути(КаталогСобытийПуть, "ИздательСобытий.os");

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСобытийПуть, "ИздательСобытий.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСобытийПуть, "КаталогСобытий.os"));
	ПоискКлассов.Подключить(КаталогВебхуковПуть, "ПодписчикВебхуков");
	ПоискКлассов.Подключить(КаталогВебхуковПуть, "ТелоСобытия");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулейПуть, "основа", "Классы", "ТекстОшибки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулейПуть, "реестр", "Классы", "ЗаполнениеПула.os"));
	КаталогАудита = ОбъединитьПути(КаталогМодулейПуть, "аудит", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогАудита, "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогАудита, "СлужбаАудита.os"));

	КаталогРеестра = ОбъединитьПути(КаталогМодулейПуть, "реестр", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогРеестра, "ЛетописьВерсий.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогРеестра, "СервисВерсий.os"));

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ЗаписывающийПодписчик.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ПадающийПодписчик.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкЖурналаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкПакетовДляЛетописи.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкПуловДляЛетописи.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкЗаписьВерсии.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкХранилищеВерсийОтзыва.os"));
КонецПроцедуры

// --- главная гарантия ---

&Тест
Процедура КаждоеСобытиеШиныЕстьВПеречне() Экспорт

	Каталог = НовыйКаталог();
	ТипыШины = ТипыИзТекста(ПрочитатьИсходник());

	Ожидаем.Что(ТипыШины.Количество() > 0,
		"сканер нашёл функции-константы типов в ИздателеСобытий").ЭтоИстина();

	Пропущенные = Новый Массив();
	Для Каждого Тип Из ТипыШины Цикл
		Если НЕ Каталог.Содержит(Тип) Тогда
			Пропущенные.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "),
		СтрШаблон("события шины, которых нет в перечне (типов в шине: %1)",
			Формат(ТипыШины.Количество(), "ЧГ=0; ЧН=0"))).Равно("");

КонецПроцедуры

&Тест
Процедура ВПеречнеНетТиповКоторыхНетВШине() Экспорт

	Каталог = НовыйКаталог();
	ТипыШины = ТипыИзТекста(ПрочитатьИсходник());

	Лишние = Новый Массив();
	Для Каждого Элемент Из Каталог.Все() Цикл
		Если ТипыШины.Найти(Элемент.Тип) = Неопределено Тогда
			Лишние.Добавить(Элемент.Тип);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "), "типы перечня, которых нет в шине").Равно("");

КонецПроцедуры

// Подпись и пояснение события читает человек в витрине подписок: английского термина
// «yank» там быть не должно. Сам ТИП события — внешний контракт шины и вебхуков,
// его сторож не трогает.
&Тест
Процедура ЧеловеческиеОписанияСобытийНеГоворятYank() Экспорт

	Каталог = НовыйКаталог();

	Найденные = Новый Массив();
	Для Каждого Элемент Из Каталог.Все() Цикл
		Проза = Строка(Элемент.Подпись) + " " + Строка(Элемент.Пояснение)
			+ " " + Строка(Элемент.ПочемуВнутреннее);
		Если СтрНайти(НРег(Проза), "yank") > 0 Тогда
			Найденные.Добавить(Элемент.Тип);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Каталог.Все().Количество() > 3, "каталог прочитан целиком").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Найденные, ", "),
		"события, чьё описание говорит «yank»: пишем «отзыв» и «отозвана»").Равно("");

КонецПроцедуры

&Тест
Процедура СканерВидитТипВЛюбойФормеОбъявления() Экспорт

	// ЧЕТЫРЕ ФОРМЫ, которыми обходили первую версию сканера (ревью Б-2). Каждая обязана
	// быть замечена; ни одной из них нет в перечне — значит на любой из них главный тест
	// покраснел бы.
	Каталог = НовыйКаталог();

	Формы = Новый Соответствие();
	Формы.Вставить("канон.форма",
		"Функция ТипКанон() Экспорт" + Символы.ПС
		+ "	Возврат ""канон.форма"";" + Символы.ПС + "КонецФункции");
	Формы.Вставить("многострочный.возврат",
		"Функция ТипМного() Экспорт" + Символы.ПС
		+ "	Возврат" + Символы.ПС + "		""многострочный.возврат"";" + Символы.ПС + "КонецФункции");
	Формы.Вставить("без.экспорта",
		"Функция ТипБезЭкспорта()" + Символы.ПС
		+ "	Возврат ""без.экспорта"";" + Символы.ПС + "КонецФункции");
	Формы.Вставить("чужое.имя.функции",
		"Функция СобытиеЧужоеИмя() Экспорт" + Символы.ПС
		+ "	Возврат ""чужое.имя.функции"";" + Символы.ПС + "КонецФункции");

	Для Каждого КиЗ Из Формы Цикл
		Типы = ТипыИзТекста(ПрочитатьИсходник() + Символы.ПС + КиЗ.Значение + Символы.ПС);
		Ожидаем.Что(Типы.Найти(КиЗ.Ключ) <> Неопределено,
			СтрШаблон("сканер видит объявление в форме ""%1""", КиЗ.Ключ)).ЭтоИстина();
		Ожидаем.Что(Каталог.Содержит(КиЗ.Ключ),
			СтрШаблон("перечень о ""%1"" не знает — проверка покраснела бы", КиЗ.Ключ)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СканерНеСчитаетТипомЛатиницуИКомментарии() Экспорт

	// Атрибуты телеметрии («oshub.event.type») и литерал, упомянутый в КОММЕНТАРИИ,
	// типами событий не являются: иначе сканер краснел бы на ровном месте, и его бы
	// отключили — вечнокрасный сторож не лучше вечнозелёного.
	Образец = "	Атрибуты.Вставить(""oshub.event.type"", ТипСобытия);" + Символы.ПС
		+ "// пример: Возврат ""несуществующее.событие"";" + Символы.ПС
		+ "	Значение = ""публикация"" + ""."" + ""версии""; // склейка — не литерал типа";

	Типы = ТипыИзТекста(Образец);
	Ожидаем.Что(Типы.Количество(), "ни латиница, ни комментарий не считаются типом").Равно(0);

КонецПроцедуры

&Тест
Процедура ТипНеЗаводитсяЛитераломМимоПеречня() Экспорт

	// ВТОРАЯ ДЫРА (ревью Б-2): тип можно опубликовать литералом на месте, вообще не заводя
	// функцию-константу в шине. Скан идёт по всему дереву классов.
	Каталог = НовыйКаталог();
	Чужие = Новый Массив();
	Просканировано = 0;

	Для Каждого Путь Из ФайлыКлассов() Цикл
		Просканировано = Просканировано + 1;
		Для Каждого Тип Из ТипыИзВызовов(Исходники.Текст(Путь)) Цикл
			Если НЕ Каталог.Содержит(Тип) Тогда
				Чужие.Добавить(Тип + " (" + Новый Файл(Путь).Имя + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Просканировано > 100,
		СтрШаблон("просканировано файлов классов: %1", Просканировано)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Чужие, "; "),
		"события, публикуемые литералом мимо перечня").Равно("");

КонецПроцедуры

&Тест
Процедура СканерВызововНеВечнозелёный() Экспорт

	// на заведомо плохом образце скан вызовов краснеет
	Образец = "	Издатель.Опубликовать(""левое.событие"", Данные);" + Символы.ПС
		+ "	Издатель.Подписать(""другое.левое"", ЭтотОбъект);";
	Типы = ТипыИзВызовов(Образец);

	Ожидаем.Что(Типы.Найти("левое.событие") <> Неопределено, "видит литерал в Опубликовать").ЭтоИстина();
	Ожидаем.Что(Типы.Найти("другое.левое") <> Неопределено, "видит литерал в Подписать").ЭтоИстина();
	Ожидаем.Что(НовыйКаталог().Содержит("левое.событие"), "перечень о нём не знает").ЭтоЛожь();

КонецПроцедуры

// --- обещанное событие публикуется НА ВСЕХ ПУТЯХ (ревью Б-1) ---

&Тест
Процедура ОтзывВерсииПубликуетсяСамимСервисом() Экспорт

	// До правки событие публиковал КОНТРОЛЛЕР кабинета, и второй путь отзыва —
	// PATCH /api/v1/…/versions/{v}, штатный путь CI — молчал. Точка публикации теперь одна:
	// СервисВерсий. Тест держит её на месте — вернуть публикацию в контроллер, не сломав
	// этот тест, нельзя.
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Новый ИздательСобытий();
	Издатель.Подписать(Издатель.ТипВерсияОтозвана(), Слушатель);
	Издатель.Подписать(Издатель.ТипВерсияВосстановлена(), Слушатель);

	Хранилище = Новый ФейкХранилищеВерсийОтзыва();
	Хранилище.Добавить(42, "1.2.3");
	Сервис = НовыйСервисВерсий(Хранилище, Издатель);

	Ожидаем.Что(Сервис.ОтозватьВерсию(42, "1.2.3", Истина, "alice"), "версия отозвана").ЭтоИстина();

	Событие = Слушатель.Первое(Издатель.ТипВерсияОтозвана());
	Ожидаем.Что(Событие <> Неопределено, "событие отзыва опубликовано").ЭтоИстина();
	Ожидаем.Что(Событие.Данные.ПулИдентификатор, "скоуп: пул").Равно(7);
	Ожидаем.Что(Событие.Данные.ПакетИдентификатор, "скоуп: пакет").Равно(42);
	Ожидаем.Что(Событие.Данные.ИмяПула, "имя пула для тела доставки").Равно("мойпул");
	Ожидаем.Что(Событие.Данные.ИмяПакета, "имя пакета для тела доставки").Равно("мойпакет");
	Ожидаем.Что(Событие.Данные.Версия, "версия").Равно("1.2.3");
	Ожидаем.Что(Событие.Данные.Отозвана, "признак отзыва").ЭтоИстина();
	Ожидаем.Что(Событие.Данные.Кто, "принципал").Равно("alice");

КонецПроцедуры

&Тест
Процедура ВосстановлениеВерсииПубликуетСвойТип() Экспорт

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Новый ИздательСобытий();
	Издатель.Подписать(Издатель.ТипВерсияОтозвана(), Слушатель);
	Издатель.Подписать(Издатель.ТипВерсияВосстановлена(), Слушатель);

	Хранилище = Новый ФейкХранилищеВерсийОтзыва();
	Хранилище.Добавить(42, "1.2.3");
	Сервис = НовыйСервисВерсий(Хранилище, Издатель);

	Сервис.ОтозватьВерсию(42, "1.2.3", Ложь);

	Ожидаем.Что(Слушатель.Количество(Издатель.ТипВерсияВосстановлена()),
		"опубликовано восстановление").Равно(1);
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипВерсияОтозвана()),
		"отзыв не публиковался").Равно(0);

КонецПроцедуры

&Тест
Процедура НесуществующаяВерсияСобытиеНеПорождает() Экспорт

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Новый ИздательСобытий();
	Издатель.Подписать(Издатель.ТипВерсияОтозвана(), Слушатель);

	Сервис = НовыйСервисВерсий(Новый ФейкХранилищеВерсийОтзыва(), Издатель);

	Ожидаем.Что(Сервис.ОтозватьВерсию(42, "9.9.9", Истина), "версии нет — не отозвана").ЭтоЛожь();
	Ожидаем.Что(Слушатель.Количество(), "событий не было").Равно(0);

КонецПроцедуры

&Тест
Процедура ТочкаПубликацииОтзываОдна() Экспорт

	// Класс дефекта Б-1 — ВТОРАЯ точка публикации того же события: одна ветка кода её
	// получает, другая молчит. Список мест, которым дозволено упоминать типы отзыва,
	// ЗАКРЫТ: перечень, шина, летопись (публикует) и двое подписчиков — доставка
	// подписок и журнал аудита. Подписчику мало быть в списке: он обязан ещё и молчать
	// в шину, иначе список сам стал бы лазейкой для второй точки публикации.
	Разрешённые = Новый Соответствие();
	Разрешённые.Вставить("КаталогСобытий.os", Истина);
	Разрешённые.Вставить("ИздательСобытий.os", Истина);
	Разрешённые.Вставить("ЛетописьВерсий.os", Истина);
	ТолькоПодписка = Новый Соответствие();
	ТолькоПодписка.Вставить("ПодписчикВебхуков.os", Истина);
	ТолькоПодписка.Вставить("СлужбаАудита.os", Истина);

	Лишние = Новый Массив();
	Публикующие = Новый Массив();
	Для Каждого Путь Из ФайлыКлассов() Цикл
		Имя = Новый Файл(Путь).Имя;
		Если Разрешённые.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Текст = Исходники.Текст(Путь);
		Упоминает = (Найти(Текст, "ТипВерсияОтозвана") > 0 ИЛИ Найти(Текст, "ТипВерсияВосстановлена") > 0);
		Если НЕ Упоминает Тогда
			Продолжить;
		КонецЕсли;
		Если ТолькоПодписка.Получить(Имя) = Истина Тогда
			Если Найти(Текст, ".Опубликовать(") > 0 Тогда
				Публикующие.Добавить(Имя);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Лишние.Добавить(Имя);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"типы отзыва упоминаются вне закрытого списка — вероятна вторая точка публикации").Равно("");
	Ожидаем.Что(СтрСоединить(Публикующие, ", "),
		"подписчик отзыва научился публиковать — это и есть вторая точка").Равно("");

КонецПроцедуры

// --- состав перечня ---

&Тест
Процедура ПодписочноеПодмножествоНепустоИСогласовано() Экспорт

	Каталог = НовыйКаталог();
	Подписочные = Каталог.ТипыДляПодписки();

	Ожидаем.Что(Подписочные.Количество() > 0, "есть хотя бы одно событие для подписки").ЭтоИстина();
	Для Каждого Тип Из Подписочные Цикл
		Ожидаем.Что(Каталог.Содержит(Тип), СтрШаблон("тип %1 есть в перечне", Тип)).ЭтоИстина();
		Ожидаем.Что(Каталог.ДоступноДляПодписки(Тип), СтрШаблон("тип %1 помечен подписочным", Тип)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПодписочноеПодмножествоСовпадаетСФактомДоставки() Экспорт

	// ГЛАВНАЯ ГАРАНТИЯ КРИТЕРИЯ (ревью Б-3). До правки пометку «доступно для подписки»
	// можно было переставить в любую сторону, и все наборы оставались зелёными: доставляемое
	// событие исчезало из UI, а недоставляемое предлагалось пользователю — он подписывался
	// на тишину. Пометка — не мнение, а ФАКТ: множество типов, на которые подписывается
	// ПодписчикВебхуков при старте, обязано СОВПАДАТЬ с подписочным подмножеством перечня.
	// Проверяем в обе стороны и по всем записям, а не «содержит».
	Издатель = Новый ИздательСобытий();
	Каталог = Новый КаталогСобытий(Издатель, Новый ЗаполнениеПула());

	// сервис доставки, очередь и реестр действий подписчику при регистрации не нужны —
	// ПриЗапускеПриложения трогает только издателя и гейт готовности
	Подписчик = Новый ПодписчикВебхуков(Неопределено, Неопределено, Издатель, НоваяГотовность(),
		Неопределено, ЛогТестов(), Новый ТекстОшибки(), Новый ТелоСобытия(Неопределено), Неопределено);
	Подписчик.ПриЗапускеПриложения();

	Расхождения = Новый Массив();
	Для Каждого Элемент Из Каталог.Все() Цикл
		Доставляется = (Издатель.КоличествоПодписчиков(Элемент.Тип) > 0);
		Если Доставляется <> Элемент.ДляПодписки Тогда
			Расхождения.Добавить(СтрШаблон("%1: перечень=%2, доставка=%3",
				Элемент.Тип, Строка(Элемент.ДляПодписки), Строка(Доставляется)));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"пометка «доступно для подписки» разошлась с фактом доставки").Равно("");

КонецПроцедуры

&Тест
Процедура ЖурналПодписанНаВсёКромеОбъявленныхИсключений() Экспорт

	// Забытая строка «Подписать» тихо выключает запись целого класса событий: издатель
	// глушит подписчиков, продукт работает, журнал молчит. Правило: служба журнала
	// подписана на ВСЁ, кроме закрытого списка с обоснованием.
	ВнеЖурнала = Новый Соответствие();
	// поток горячего пути: подписка на него — трафик, а не запись безопасности
	ВнеЖурнала.Вставить("скачивание.зафиксировано", Истина);
	// уведомление подписчику о росте объёма: это не действие принципала над хабом
	ВнеЖурнала.Вставить("пул.заполнен", Истина);

	Издатель = Новый ИздательСобытий();
	Каталог = Новый КаталогСобытий(Издатель, Новый ЗаполнениеПула());
	Служба = Новый СлужбаАудита(Издатель, НоваяГотовность(), Неопределено, Неопределено,
		Новый ИмяОбъектаАудита(), ЛогТестов());
	Служба.ПриЗапускеПриложения();

	Незаписываемые = Новый Массив();
	Лишние = Новый Массив();
	Для Каждого Элемент Из Каталог.Все() Цикл
		Подписан = (Издатель.КоличествоПодписчиков(Элемент.Тип) > 0);
		Исключено = (ВнеЖурнала.Получить(Элемент.Тип) = Истина);
		Если НЕ Подписан И НЕ Исключено Тогда
			Незаписываемые.Добавить(Элемент.Тип);
		КонецЕсли;
		Если Подписан И Исключено Тогда
			Лишние.Добавить(Элемент.Тип);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Каталог.Все().Количество() > 15, "перечень прочитан целиком").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Незаписываемые, ", "),
		"типы событий, которые в журнал не попадут: подписка забыта").Равно("");
	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"типы, объявленные вне журнала, но подписанные — список исключений врёт").Равно("");

КонецПроцедуры

&Тест
Процедура СверкаФормыНеРоняетПодписчикаБезЛога() Экспорт

	// Издатель глушит подписчиков: падение внутри сверки формы стоило бы ВСЕЙ записи,
	// и ровно на нештатном значении, ради которого сверка и заведена. Служба создаётся
	// напрямую — инъекция &Лог сюда не доезжает, как и в реальном `Новый`.
	Летопись = Новый ФейкЖурналаАудита();
	Служба = Новый СлужбаАудита(Новый ИздательСобытий(), НоваяГотовность(), Летопись,
		Неопределено, Новый ИмяОбъектаАудита());

	Событие = Новый Структура("Тип, Когда, Данные", "проба.формы", ТекущаяУниверсальнаяДата(),
		Новый Структура("Кто, Действие, Объект", "root", "проба", "пул#5 ← апстрим"));

	Служба.ОбработатьСобытие(Событие);

	Ожидаем.Что(Летопись.Количество(), "запись сделана, несмотря на чужую форму адреса").Равно(1);
	Ожидаем.Что(Летопись.ПоследнийОбъект(), "и значение записано как пришло").Равно("пул#5 ← апстрим");

КонецПроцедуры

&Тест
Процедура УпавшийПодписчикНеМолчит() Экспорт

	// Пустой «Исключение» в издателе делал пропуск записи невидимым: журнал безопасности
	// мог перестать писаться без единого следа.
	Издатель = Новый ИздательСобытий(Неопределено, ЛогТестов());
	Издатель.Подписать("проба.падения", Новый ПадающийПодписчик());

	Ожидаем.Что(Издатель.ПропущенныхДоставок(), "до публикации пропусков нет").Равно(0);
	Издатель.Опубликовать("проба.падения", Новый Структура());
	Ожидаем.Что(Издатель.ПропущенныхДоставок(), "падение подписчика посчитано").Равно(1);

КонецПроцедуры

&Тест
Процедура ПереченьБезДублей() Экспорт

	// дубль означал бы два разных описания одного события; сборка каталога его отбивает
	// (исключение в конструкторе), а этот тест утверждает инвариант на СОБРАННОМ перечне
	Видимые = Новый Соответствие();
	Дубли = Новый Массив();
	Для Каждого Элемент Из НовыйКаталог().Все() Цикл
		Если Видимые.Получить(Элемент.Тип) <> Неопределено Тогда
			Дубли.Добавить(Элемент.Тип);
		КонецЕсли;
		Видимые.Вставить(Элемент.Тип, Истина);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Дубли, ", "), "повторяющиеся типы в перечне").Равно("");

КонецПроцедуры

&Тест
Процедура КаждоеВнутреннееСобытиеОбъяснено() Экспорт

	// «внутреннее» без причины — это «пока не сделали», спрятанное под видом решения;
	// причина обязана быть текстом, который можно показать пользователю
	Безосновательные = Новый Массив();
	Для Каждого Элемент Из НовыйКаталог().Все() Цикл
		Если НЕ Элемент.ДляПодписки И НЕ ЗначениеЗаполнено(Элемент.ПочемуВнутреннее) Тогда
			Безосновательные.Добавить(Элемент.Тип);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Безосновательные, ", "), "внутренние события без обоснования").Равно("");

КонецПроцедуры

&Тест
Процедура КаждоеСобытиеИмеетПодписьИПояснение() Экспорт

	Пустые = Новый Массив();
	Для Каждого Элемент Из НовыйКаталог().Все() Цикл
		Если НЕ ЗначениеЗаполнено(Элемент.Подпись) ИЛИ НЕ ЗначениеЗаполнено(Элемент.Пояснение) Тогда
			Пустые.Добавить(Элемент.Тип);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пустые, ", "), "события без подписи или пояснения").Равно("");

КонецПроцедуры

&Тест
Процедура СкачиваниеПомеченоВнутренним() Экспорт

	// поток горячего пути: подписка на него — трафик, а не уведомление (решение 5.J)
	Каталог = НовыйКаталог();
	Ожидаем.Что(Каталог.Содержит("скачивание.зафиксировано"), "событие в перечне").ЭтоИстина();
	Ожидаем.Что(Каталог.ДоступноДляПодписки("скачивание.зафиксировано"),
		"подписка на скачивания не предлагается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеизвестныйТипНеДоступенДляПодписки() Экспорт

	// fail-closed: чего в перечне нет, на то и подписки нет
	Каталог = НовыйКаталог();
	Ожидаем.Что(Каталог.ДоступноДляПодписки("нет.такого.события"), "неизвестный тип").ЭтоЛожь();
	Ожидаем.Что(Каталог.Запись("нет.такого.события") = Неопределено, "записи нет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТипИщетсяБезОглядкиНаРегистрИПробелы() Экспорт

	Каталог = НовыйКаталог();
	Ожидаем.Что(Каталог.Содержит("  ВЕРСИЯ.ОПУБЛИКОВАНА "), "нормализация ключа").ЭтоИстина();

КонецПроцедуры

// --- служебные ---

Функция НовыйКаталог()
	Возврат Новый КаталогСобытий(Новый ИздательСобытий(), Новый ЗаполнениеПула());
КонецФункции

// СервисВерсий с фейковым хранилищем и НАСТОЯЩЕЙ летописью: ОтозватьВерсию трогает только
// эти две зависимости, остальные конструктору достаточно принять.
Функция НовыйСервисВерсий(Знач Хранилище, Знач Издатель)

	Пакеты = Новый ФейкПакетовДляЛетописи();
	Пакеты.Добавить(42, "мойпакет", 7);
	Пулы = Новый ФейкПуловДляЛетописи();
	Пулы.Добавить(7, "мойпул");

	Летопись = Новый ЛетописьВерсий(Пакеты, Пулы, Новый ИмяОбъектаАудита(), Издатель);
	Возврат Новый СервисВерсий(Хранилище, Неопределено, Неопределено, Неопределено, Неопределено,
		Летопись);

КонецФункции

Функция ПрочитатьИсходник()
	Возврат Исходники.Текст(ИсходникИздателя);
КонецФункции

// Имена типов событий, заведённые в тексте: строковые литералы, похожие на имя типа.
// Форма объявления значения не имеет — сканер переживает многострочный Возврат,
// функцию без «Экспорт» и любое имя функции-константы.
//
// Параметры:
//  Текст - Строка - текст файла.
//
// Возвращаемое значение:
//  Массив из Строка - имена типов без повторов.
//
Функция ТипыИзТекста(Знач Текст) Экспорт

	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		Для Каждого Литерал Из ЛитералыСтроки(Строка_) Цикл
			Если ПохожеНаТипСобытия(Литерал) И Результат.Найти(Литерал) = Неопределено Тогда
				Результат.Добавить(Литерал);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Литералы, переданные первым аргументом в Опубликовать/Подписать, — типы событий,
// заведённые мимо функций-констант шины.
//
// Параметры:
//  Текст - Строка - текст файла.
//
// Возвращаемое значение:
//  Массив из Строка - имена типов без повторов.
//
Функция ТипыИзВызовов(Знач Текст) Экспорт

	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл

		Код = БезКомментария(Строка_);
		Для Каждого Имя Из ИменаВызовов() Цикл
			Позиция = Найти(Код, Имя + "(""");
			Если Позиция = 0 Тогда
				Продолжить;
			КонецЕсли;
			Хвост = Сред(Код, Позиция + СтрДлина(Имя));
			Литералы = ЛитералыСтроки(Хвост);
			Если Литералы.Количество() > 0 И Результат.Найти(Литералы[0]) = Неопределено Тогда
				Результат.Добавить(Литералы[0]);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИменаВызовов()
	Список = Новый Массив();
	Список.Добавить("Опубликовать");
	Список.Добавить("Подписать");
	Возврат Список;
КонецФункции

// Все строковые литералы строки кода (хвостовой комментарий отрезан).
// Удвоенная кавычка внутри литерала считается экранированной.
//
// Параметры:
//  Строка_ - Строка - строка исходного кода.
//
// Возвращаемое значение:
//  Массив из Строка - содержимое литералов.
//
Функция ЛитералыСтроки(Знач Строка_) Экспорт

	Код = БезКомментария(Строка_);
	Результат = Новый Массив();
	Позиция = 1;
	Длина = СтрДлина(Код);

	Пока Позиция <= Длина Цикл
		Если Сред(Код, Позиция, 1) <> """" Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Позиция = Позиция + 1;
		Значение = "";
		Пока Позиция <= Длина Цикл
			Символ = Сред(Код, Позиция, 1);
			Если Символ = """" Тогда
				Если Сред(Код, Позиция + 1, 1) = """" Тогда
					Значение = Значение + """";
					Позиция = Позиция + 2;
					Продолжить;
				КонецЕсли;
				Позиция = Позиция + 1;
				Прервать;
			КонецЕсли;
			Значение = Значение + Символ;
			Позиция = Позиция + 1;
		КонецЦикла;
		Результат.Добавить(Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строка без хвостового комментария: «//» ВНЕ строкового литерала отрезает остаток.
// Без этого литерал, упомянутый в комментарии, считался бы объявленным типом.
//
// Параметры:
//  Строка_ - Строка - строка исходного кода.
//
// Возвращаемое значение:
//  Строка - строка без хвостового комментария.
//
Функция БезКомментария(Знач Строка_) Экспорт

	ВСтроке = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Строка_);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Строка_, Позиция, 1);
		Если Символ = """" Тогда
			ВСтроке = НЕ ВСтроке;
		ИначеЕсли НЕ ВСтроке И Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
			Возврат Лев(Строка_, Позиция - 1);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Строка_;

КонецФункции

// Похож ли литерал на имя типа события: строчная кириллица и точки, точка обязательна
// и не с краю. Латинские литералы под правило не подпадают — имена типов кириллические.
//
// Параметры:
//  Литерал - Строка - содержимое строкового литерала.
//
// Возвращаемое значение:
//  Булево - признак имени типа события.
//
Функция ПохожеНаТипСобытия(Знач Литерал) Экспорт

	Если НЕ ЗначениеЗаполнено(Литерал) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Найти(Литерал, ".") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Лев(Литерал, 1) = "." ИЛИ Прав(Литерал, 1) = "." Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Литерал) Цикл
		Символ = Сред(Литерал, Позиция, 1);
		Если Символ = "." Тогда
			Продолжить;
		КонецЕсли;
		Код = КодСимвола(Символ);
		// а..я = 1072..1103, ё = 1105
		Если НЕ ((Код >= 1072 И Код <= 1103) ИЛИ Код = 1105) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Все файлы классов дерева src/модули/*/Классы (для скана вызовов).
Функция ФайлыКлассов()

	Результат = Новый Массив();
	Для Каждого Модуль Из НайтиФайлы(КаталогМодулейПуть, "*") Цикл
		Если НЕ Модуль.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Каталог = ОбъединитьПути(Модуль.ПолноеИмя, "Классы");
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Продолжить;
		КонецЕсли;
		// РЕКУРСИВНО (6.B): классы модуля могут лежать по подкаталогам (web-ui).
		Для Каждого Файл Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Свежая ГотовностьХаба для конструктора рогатки-подписчика (гейт в юнит-тесте никого
// не держит — важна корректная сборка).
Функция НоваяГотовность()

	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулейПуть, "наблюдаемость", "Классы/пробы")
			+ "/ГотовностьХаба.os", "ГотовностьХаба");
	Исключение
		// тип мог быть зарегистрирован ранее
	КонецПопытки;
	// Лог — параметром: объект создан напрямую, инъекция ОСени до него не доезжает,
	// а ОтметитьЗадачуВыполненной пишет в журнал безусловно (шаг 6.D).
	Возврат Новый ГотовностьХаба(Логирование.ПолучитьЛог("тест.oshub.старт"));

КонецФункции

// Лог для классов, создаваемых НАПРЯМУЮ (минуя контейнер ОСени): инъекция `&Лог` до них
// не доезжает, поэтому лог передаёт тест параметром конструктора (шаг 6.D).
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub");
КонецФункции
