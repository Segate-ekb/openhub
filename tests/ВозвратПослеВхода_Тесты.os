// Юнит-тесты отбора адреса возврата после входа: что принимается как путь этого хаба,
// что отвергается и как проверенный путь вплетается в ссылки.

#Использовать asserts
#Использовать "фикстуры"

Перем Отбор;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКласс() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Модули = ОбъединитьПути(КаталогТестов, "..", "src");
	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "модули", "вход", "Классы"),
		"ВозвратПослеВхода");

	Отбор = Новый ВозвратПослеВхода();

КонецПроцедуры

#Область ОтборПути

&Тест
Процедура ПутьЭтогоХабаПринимаетсяЦеликомСЗапросом() Экспорт

	Ожидаем.Что(Отбор.Путь("/cli/login?user_code=ABCD-EFGH"),
		"запрос — часть адреса возврата, обрезать его нельзя").Равно("/cli/login?user_code=ABCD-EFGH");
	Ожидаем.Что(Отбор.Путь("/me/tokens")).Равно("/me/tokens");
	Ожидаем.Что(Отбор.Путь("  /me/tokens  "), "края обрезаются").Равно("/me/tokens");

	// двоеточие в пути законно: авторитет в относительной ссылке начинается только с «//»,
	// а поиск и теги двоеточие используют штатно
	Ожидаем.Что(Отбор.Путь("/pool/имя:тег")).Равно("/pool/имя:тег");
	Ожидаем.Что(Отбор.Путь("/search?q=время:обед")).Равно("/search?q=время:обед");
	Ожидаем.Что(Отбор.Путь("/pool:tag")).Равно("/pool:tag");
	Ожидаем.Что(Отбор.Путь("/x:y")).Равно("/x:y");
	Ожидаем.Что(Отбор.Путь("/:@evil.example"), "двоеточие сразу за слешем — всё ещё путь хаба")
		.Равно("/:@evil.example");

КонецПроцедуры

&Тест
Процедура ЧужойАдресЗаменяетсяПутёмПоУмолчанию() Экспорт

	Чужие = Новый Массив();
	Чужие.Добавить("https://evil.example/украсть");
	Чужие.Добавить("http://evil.example");
	Чужие.Добавить("//evil.example/украсть");
	Чужие.Добавить("javascript:alert(1)");
	Чужие.Добавить("data:text/html,<script>");
	Чужие.Добавить("\evil.example");
	Чужие.Добавить("/cli/login" + Символы.ПС + "Set-Cookie: подделка=1");
	Чужие.Добавить("/cli/login" + Символы.Таб + "x");
	Чужие.Добавить("/cli/login\..\..");
	Чужие.Добавить("/cli/login""onmouseover=""alert(1)");
	Чужие.Добавить("me/tokens");
	Чужие.Добавить("");
	Чужие.Добавить(Неопределено);

	Для Каждого Чужой Из Чужие Цикл
		Ожидаем.Что(Отбор.Путь(Чужой), "адрес <" + Строка(Чужой) + "> обязан быть отвергнут")
			.Равно("/me");
	КонецЦикла;

	// КОНТРОЛЬ: тот же путь без ведущей приметы чужого адреса принимается
	Ожидаем.Что(Отбор.Путь("/cli/login"), "КОНТРОЛЬ: свой путь").Равно("/cli/login");

КонецПроцедуры

&Тест
Процедура СлишкомДлинныйАдресОтвергается() Экспорт

	// Адрес приходит от анонима и оседает в серверной транзакции на 10 минут — предел
	// нужен, чтобы заход на страницу входа не был дешёвым способом занять память.
	Кусок = "";
	Для Сч = 1 По 300 Цикл
		Кусок = Кусок + "abcdefghij";
	КонецЦикла;

	Впритык = "/me/" + Лев(Кусок, Отбор.ПределДлины() - 4);
	Ожидаем.Что(СтрДлина(Впритык), "готовим адрес ровно по пределу").Равно(Отбор.ПределДлины());
	Ожидаем.Что(Отбор.Путь(Впритык), "КОНТРОЛЬ: адрес по пределу принимается").Равно(Впритык);

	Ожидаем.Что(Отбор.Путь(Впритык + "x"), "на знак длиннее — уже отвергается").Равно("/me");

КонецПроцедуры

&Тест
Процедура ЗаданТолькоТотАдресКоторыйОтличенОтУмолчания() Экспорт

	Ожидаем.Что(Отбор.Задан("/cli/login?user_code=X"), "особый путь задан").ЭтоИстина();
	Ожидаем.Что(Отбор.Задан("/me"), "путь по умолчанию особым не считается").ЭтоЛожь();
	Ожидаем.Что(Отбор.Задан("https://evil.example"), "отвергнутый адрес особым не считается").ЭтоЛожь();
	Ожидаем.Что(Отбор.Задан(""), "пустой адрес").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ВплетениеВСсылки

&Тест
Процедура ВозвратПрицепляетсяКСсылкеЗакодированным() Экспорт

	Ожидаем.Что(Отбор.СВозвратом("/login/oidc/keycloak", "/cli/login?user_code=ABCD-EFGH"),
		"знаки запроса обязаны быть закодированы, иначе они станут параметрами ссылки")
		.Равно("/login/oidc/keycloak?next=%2Fcli%2Flogin%3Fuser_code%3DABCD-EFGH");

	Ожидаем.Что(Отбор.СВозвратом("/login/oidc/keycloak?prompt=login", "/cli/login"),
		"к адресу с запросом возврат цепляется амперсандом")
		.Равно("/login/oidc/keycloak?prompt=login&next=%2Fcli%2Flogin");

КонецПроцедуры

&Тест
Процедура ОтвергнутыйИПустойВозвратКСсылкеНеЦепляются() Экспорт

	Ожидаем.Что(Отбор.СВозвратом("/register", "https://evil.example"),
		"чужой адрес в ссылку не попадает даже закодированным").Равно("/register");
	Ожидаем.Что(Отбор.СВозвратом("/register", "")).Равно("/register");
	Ожидаем.Что(Отбор.СВозвратом("/register", "/me"), "путь по умолчанию цеплять незачем")
		.Равно("/register");

КонецПроцедуры

&Тест
Процедура АдресВходаСобираетсяИзПутиВходаИВозврата() Экспорт

	Ожидаем.Что(Отбор.АдресВхода("/cli/login?user_code=ABCD-EFGH"))
		.Равно("/login?next=%2Fcli%2Flogin%3Fuser_code%3DABCD-EFGH");
	Ожидаем.Что(Отбор.АдресВхода("https://evil.example/украсть"),
		"аноним с чужим адресом уходит на голую страницу входа").Равно("/login");
	Ожидаем.Что(Отбор.ПутьВхода()).Равно("/login");
	Ожидаем.Что(Отбор.ИмяПараметра()).Равно("next");
	Ожидаем.Что(Отбор.ПутьПоУмолчанию()).Равно("/me");

КонецПроцедуры

#КонецОбласти
