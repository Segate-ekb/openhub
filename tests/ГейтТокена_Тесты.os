// Гейт токена в ЧАСТИЧНОМ контейнере: что будет, если желудь гейта не собрался —
// контракт сборки «нет гейта — нет и гварда» и мягкий fail-closed прямого экземпляра.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));

	КаталогNet = ОбъединитьПути(Модули, "сеть", "Классы");
	КаталогObs = ОбъединитьПути(Модули, "наблюдаемость", "Классы/телеметрия");
	КаталогПробХаба = ОбъединитьПути(Модули, "наблюдаемость", "Классы/пробы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтФикстура = Новый ГейтАпстримов();
	ГейтФикстура.Подключить();

	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"),
			"СобытиеАудита");
	Исключение
	КонецПопытки;
	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "УчёткаПринципала");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHub");
	ПоискКлассов.Подключить(Модули, "СверкаСекретов");
	ПоискКлассов.Подключить(Модули, "СервисТокенов");
	// сроки токенов живут в настройках хаба — без них СервисТокенов не собирается
	КаталогSettings = ОбъединитьПути(Модули, "настройки", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(
		Новый Файл(ОбъединитьПути(КаталогSettings, "..", "..")).ПолноеИмя,
		"основа", "Классы", "ПриведениеФлагов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));
	// СервисПользователей пишет события безопасности учётки через летопись
	ПоискКлассов.Подключить(Модули, "ЛетописьУчёток");
	// причина отказа «логин занят» / «адрес занят» приезжает машинным кодом из таблицы
	ПоискКлассов.Подключить(Модули, "ОтказыУчётки");
	ПоискКлассов.Подключить(Модули, "АдресУчётки");
	ПоискКлассов.Подключить(Модули, "СервисПользователей");
	ПоискКлассов.Подключить(Модули, "СлужбаСессий");
	ПоискКлассов.Подключить(Модули, "ХранилищеСессийБД");
	ПоискКлассов.Подключить(Модули, "СессияХаба");
	ПоискКлассов.Подключить(Модули, "НормализаторУчётки");
	ПоискКлассов.Подключить(Модули, "ЗаголовкиHTTP");
	ПоискКлассов.Подключить(Модули, "ПерехватчикАутентификации");
	// ГЕЙТ ТОКЕНА НАМЕРЕННО НЕ ПОДКЛЮЧЁН — это и есть частичный контейнер
	ПоискКлассов.Подключить(Модули, "ГвардДоступаКПулу");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкПроверяющийGitHub.os"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "гейт-токена-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&Тест
Процедура Г1_ЧастичныйКонтейнерБезГейтаЛомаетсяГромкоИЦеликом() Экспорт

	// ОСень не подменяет незарегистрированное имя желудя значением по умолчанию:
	// «полусобранной» защиты не бывает, ломается вся ветка чтения пула сразу.
	Гейт = Неопределено;
	Попытка
		Гейт = Поделка.НайтиЖелудь("ГейтТокена");
	Исключение
		Гейт = Неопределено;
	КонецПопытки;
	Ожидаем.Что(Гейт, "гейт в этом контейнере отсутствует — так и задумано").Равно(Неопределено);

	Гвард = Неопределено;
	Попытка
		Гвард = Поделка.НайтиЖелудь("ГвардДоступаКПулу");
	Исключение
		Гвард = Неопределено;
	КонецПопытки;
	Ожидаем.Что(Гвард,
		"без гейта гвард НЕ собирается: защита не может быть выключена наполовину").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура Г2_ПрямойЭкземплярБезГейтаЗакрываетКлючНоНеАнонима() Экспорт

	// у прямого экземпляра поле гейта бывает Неопределено — мягкий fail-closed, обе ветки без исключения
	Гвард = Новый ГвардДоступаКПулу(
		Желудь("ПерехватчикАутентификации"), Желудь("СервисПрав"), Желудь("СервисПулов"), Неопределено,
		Желудь("УчёткаПринципала"));

	Пул = Желудь("СервисПулов").СоздатьПул(УникальноеИмя("gate"), "custom", "public");
	Токен = Новый Структура("Способ, Права, ПулИдентификатор, Пользователь, Сессия",
		"token", "read", 0, Неопределено, Неопределено);

	ОшибкаКлюча = "";
	ОткрылосьКлючом = Ложь;
	Попытка
		ОткрылосьКлючом = (Гвард.ЧитаемыйПул(Неопределено, Пул.Имя, Токен) <> Неопределено);
	Исключение
		ОшибкаКлюча = ОписаниеОшибки();
	КонецПопытки;

	ОшибкаАнонима = "";
	АнонимПрочитал = Ложь;
	Попытка
		АнонимПрочитал = (Гвард.ЧитаемыйПул(Неопределено, Пул.Имя) <> Неопределено);
	Исключение
		ОшибкаАнонима = ОписаниеОшибки();
	КонецПопытки;

	// ассерты — ПОСЛЕ КонецПопытки (упавший ассерт внутри Попытки самоглотается)
	Ожидаем.Что(ОшибкаКлюча, "отказ ключу — это отказ, а не падение").Равно("");
	Ожидаем.Что(ОткрылосьКлючом, "без собранного гейта доступ по ключу не открывается").ЭтоЛожь();
	Ожидаем.Что(ОшибкаАнонима, "анонимное чтение не падает").Равно("");
	Ожидаем.Что(АнонимПрочитал, "аноним по-прежнему читает публичный пул").ЭтоИстина();

КонецПроцедуры

// Имя ключа — короткая метка списка в кабинете, и приезжает она из формы: перевод строки
// внутри неё разваливал бы таблицу, а безразмерное имя — колонку. Предел 120 символов
// и снятие управляющих живут в СервисТокенов.ОграничитьИмя.
&Тест
Процедура ИмяКлючаОбрезаетсяДоСтаДвадцатиИТеряетУправляющие() Экспорт

	Сервис = Желудь("СервисТокенов");

	Длинное = "";
	Для Счётчик_ = 1 По 200 Цикл
		Длинное = Длинное + "я";
	КонецЦикла;

	Выпуск = Сервис.ВыпуститьТокен(1, "read", 1, 0, Длинное);
	Ожидаем.Что(СтрДлина(Выпуск.Запись.Имя), "имя обрезано ровно по пределу").Равно(120);

	СПереносом = Сервис.ВыпуститьТокен(1, "read", 1, 0,
		"  ноутбук" + Символы.ПС + " дома  ");
	Ожидаем.Что(СПереносом.Запись.Имя, "перевод строки выброшен, обрамление снято")
		.Равно("ноутбук дома");

	Ровно120 = Лев(Длинное, 120);
	Впритык = Сервис.ВыпуститьТокен(1, "read", 1, 0, Ровно120);
	Ожидаем.Что(Впритык.Запись.Имя, "имя ровно в предел не трогается").Равно(Ровно120);

КонецПроцедуры

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции
