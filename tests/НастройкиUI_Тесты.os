КонецПроцедуры

&Тест
Процедура ЦветАкцентаПроверяетсяДоЗаписиВБазу() Экспорт

	// значение уезжает в <style>, где HTML-экранирование бесполезно: отказ обязан быть до базы
	Стенд = ПостроитьСтенд(Неопределено);
	Рендерер = РендерерИнсталляции(Стенд);

	Мусор = Новый Массив();
	Мусор.Добавить("red;}html{display:none");
	Мусор.Добавить("ff8800");
	Мусор.Добавить("#ff88");
	Мусор.Добавить("#gggggg");
	Мусор.Добавить("#FF88");        // верхний регистр не делает мусор цветом

	Для Каждого Значение Из Мусор Цикл
		Отказ = "";
		Попытка
			Стенд.Настройки.Установить("oshub.ui.accent", Значение, "ольга-админ");
		Исключение
			Отказ = ОписаниеОшибки();
		КонецПопытки;
		Ожидаем.Что(СтрНайти(Отказ, "#rrggbb") > 0,
			"отказ по «" + Значение + "» называет нужную запись цвета: " + Отказ).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Стенд.Хранилище.Значение("oshub.ui.accent"), "ничего из мусора не записано")
		.Равно(Неопределено);
	Ожидаем.Что(СтрНайти(Страница(Рендерер), "display:none"), "в <style> мусор не доехал").Равно(0);

	// сокращённая запись и верхний регистр — законные цвета: их принимают и кит, и валидатор
	Стенд.Настройки.Установить("oshub.ui.accent", "#f80", "ольга-админ");
	Ожидаем.Что(СтрНайти(Страница(Рендерер), "--color-accent:#f80") > 0,
		"#rgb принят и напечатан").ЭтоИстина();

	Стенд.Настройки.Установить("oshub.ui.accent", "#FF8800", "ольга-админ");
	Ожидаем.Что(СтрНайти(Страница(Рендерер), "--color-accent:#FF8800") > 0,
		"#RRGGBB верхним регистром принят и напечатан").ЭтоИстина();

КонецПроцедуры

