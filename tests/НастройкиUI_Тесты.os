// Юнит-тесты слоя ПРЕДСТАВЛЕНИЯ настроек: карточки и формы, собранные ВитринойНастроек из РЕАЛЬНОЙ выдачи
// СервисНастроек.Карточки(). Классы создаются напрямую, база — заглушка в памяти.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;            // СборкаUI — граф компонентов и рендереров web-ui
Перем Кабинет;       // РендерерКабинета (кабинет)
Перем ДомНастроек;   // ДомХаба — карта разделов дома
Перем КаталогМодулей;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ХранилищеНастроекВПамяти");
	РеестрФикстур.Подключить("ИздательНастроекЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	Попытка
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"),
			"ИмяОбъектаАудита.os"), "ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КаталогОбщего = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "общее");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(КаталогОбщего, "РендерерКабинета");
	Поиск.Подключить(КаталогОбщего, "ОформлениеХаба");

	КаталогSettings = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	Поиск.Подключить(КаталогSettings, "ВидыПроверок");
	Поиск.Подключить(КаталогSettings, "НастройкиПодсистем");
	Поиск.Подключить(КаталогSettings, "РеестрНастроек");
	Поиск.Подключить(КаталогSettings, "СервисНастроек");
	Поиск.Подключить(КаталогSettings, "ВалидаторНастроек");
	Поиск.Подключить(КаталогSettings, "РазделыНастроекХаба");

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "настройки");
	Поиск.Подключить(КаталогНастроек, "РаскладкаНастроекХаба");
	Поиск.Подключить(КаталогНастроек, "ПоляНастроек");
	Поиск.Подключить(КаталогНастроек, "ВитринаНастроек");
	Поиск.Подключить(КаталогНастроек, "КаталогРазделов");
	Поиск.Подключить(КаталогНастроек, "ДомХаба");
	Поиск.Подключить(КаталогНастроек, "ПультЗначенийНастроек");
	Поиск.Подключить(КаталогОбщего, "РазборФормы");
	РеестрФикстур.Подключить("ОтветыНастроекЗаглушка");

	// каркас нужен ради страницы, ЗащитаCSRF — ради имени поля
	Кабинет = Новый РендерерКабинета(UI.Каркас, UI.Экран, Новый ЗащитаCSRF(Неопределено), UI.Набор, UI.Тексты);
	ДомНастроек = Новый ДомХаба(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты);

КонецПроцедуры

#Область ПолнотаЭкрана

&Тест
Процедура КаждаяКарточкаРеестраПоказанаРовноВОдномРазделеДома() Экспорт

	// проверяемые элементы берутся из РЕАЛЬНОЙ выдачи Карточки(), а не из списка в тесте.
	// Экран показывает то, чем администратор распоряжается: ПРИКЛАДНУЮ настройку —
	// и правимую, и занятую конфигурацией. Стенд взят с ключом в конфиге ровно затем,
	// чтобы занятая карточка проверялась наравне с остальными
	Детальки = Новый Соответствие();
	Детальки.Вставить("режим", "invite");
	Стенд = ПостроитьСтенд(Детальки);
	Разметка = РазметкаВсехРазделов(Стенд);

	Карточки = Стенд.Настройки.Карточки();
	Ожидаем.Что(Карточки.Количество() > 0, "реестр отдал карточки").ЭтоИстина();

	Потерянные = Новый Массив();
	Задвоенные = Новый Массив();

	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Класс <> "прикладная" Тогда
			Продолжить;
		КонецЕсли;
		Сколько = СколькоРаз(Разметка, "data-setting=""" + Карточка.Ключ + """");
		Если Сколько = 0 Тогда
			Потерянные.Добавить(Карточка.Ключ + " → раздел «"
				+ Стенд.Витрина.РазделКлюча(Карточка.Ключ) + "»");
		ИначеЕсли Сколько > 1 Тогда
			Задвоенные.Добавить(Карточка.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"прикладные настройки реестра, не попавшие ни на один экран дома «Хаб»").Равно("");
	Ожидаем.Что(СтрСоединить(Задвоенные, ", "),
		"настройки, показанные сразу в нескольких разделах").Равно("");

КонецПроцедуры

&Тест
Процедура НастройкиПубликацииРазложеныПоСмыслуАНеПоПрефиксу() Экспорт

	// Весь oshub.publish. уходил в «Хранилище» одной веткой: рядом с предельными размерами
	// загрузки лежали аудитория id-token доверенных конвейеров и лимиты очереди заявок.
	// Порядок ветвей значим — узкий префикс обязан судиться ДО широкого.
	Стенд = ПостроитьСтенд(Неопределено);

	Ожидаемые = Новый Соответствие();
	Ожидаемые.Вставить("oshub.publish.github_legacy", "legacy");
	Ожидаемые.Вставить("oshub.publish.github.org", "legacy");
	Ожидаемые.Вставить("oshub.publish.ci.audience", "trusted");
	Ожидаемые.Вставить("oshub.publish.ci.issuers", "trusted");
	Ожидаемые.Вставить("oshub.publish.inbox.max_pending_per_pool", "pools");
	Ожидаемые.Вставить("oshub.publish.inbox.max_pending_per_user", "pools");
	Ожидаемые.Вставить("oshub.pools.default_quota_mb", "pools");
	Ожидаемые.Вставить("oshub.pools.personal_enabled", "pools");
	Ожидаемые.Вставить("oshub.publish.max_upload_bytes", "storage");
	Ожидаемые.Вставить("oshub.publish.max_unpacked_bytes", "storage");
	Ожидаемые.Вставить("oshub.publish.max_files", "storage");
	Ожидаемые.Вставить("oshub.publish.max_manifest_bytes", "storage");
	Ожидаемые.Вставить("oshub.storage.root", "storage");

	Расхождения = Новый Массив();
	Для Каждого КиЗ Из Ожидаемые Цикл
		Фактический = Стенд.Витрина.РазделКлюча(КиЗ.Ключ);
		Если Фактический <> КиЗ.Значение Тогда
			Расхождения.Добавить(СтрШаблон("%1: ждали «%2», получили «%3»",
				КиЗ.Ключ, КиЗ.Значение, Фактический));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"настройки разъехались с разделами дома «Хаб»").Равно("");

	// и ни один ключ реестра не потерялся: раздел есть у каждого
	Осиротевшие = Новый Массив();
	Для Каждого Ключ Из Стенд.Реестр.Ключи() Цикл
		Если НЕ ДомНастроек.ЕстьРаздел(Стенд.Витрина.РазделКлюча(Ключ)) Тогда
			Осиротевшие.Добавить(Ключ + " → " + Стенд.Витрина.РазделКлюча(Ключ));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Осиротевшие, ", "),
		"настройки, попавшие в несуществующий раздел").Равно("");

КонецПроцедуры

&Тест
Процедура НезнакомыйПрефиксКлючаВиденВОбслуживании() Экспорт

	// раздел выбирается ПРЕФИКСОМ: незнакомый витрине ключ обязан попасть в «Обслуживание», а не исчезнуть
	Стенд = ПостроитьСтенд(Неопределено);
	Ожидаем.Что(Стенд.Витрина.РазделКлюча("oshub.будущее.свойство"), "незнакомый префикс")
		.Равно("maintenance");

КонецПроцедуры

#КонецОбласти

#Область ЯрусыИПорядок

&Тест
Процедура ПолитикаВходаПечатаетсяВышеЕгоТонкихКрутилок() Экспорт

	// жалоба владельца: «выходит, что TTL сессии важнее, чем настройка входа по паролю».
	// Порядок судится ПОЗИЦИЯМИ полей на готовой странице, а не составом раздела
	Стенд = ПостроитьСтенд(Неопределено);
	Разметка = РазделHTML(Стенд, "login");

	Пароль = СтрНайти(Разметка, "name=""oshub.auth.password.enabled""");
	Режим = СтрНайти(Разметка, "name=""oshub.auth.registration.mode""");
	Срок = СтрНайти(Разметка, "name=""oshub.auth.token.cli_days""");

	Ожидаем.Что(Пароль > 0, "вход по паролю правится на экране").ЭтоИстина();
	Ожидаем.Что(Режим > 0, "режим регистрации правится на экране").ЭтоИстина();
	Ожидаем.Что(Срок > 0, "срок токена CLI правится на экране").ЭтоИстина();

	Ожидаем.Что(Пароль < Срок, "вход по паролю напечатан выше срока токена").ЭтоИстина();
	Ожидаем.Что(Режим < Срок, "режим регистрации напечатан выше срока токена").ЭтоИстина();

	// тонкие собраны своей секцией — её и прячет кат
	Ожидаем.Что(СтрНайти(Разметка, ЗаголовокТонких()) > 0,
		"тонкие настройки собраны отдельной секцией").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ЗаголовокТонких()) < Срок,
		"срок токена CLI стоит уже внутри секции тонких").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧтоНеПорогТоПолитика() Экспорт

	// инвариант проверяется ПО ВСЕМУ реестру и на ЗНАЧЕНИИ, а не по списку в тесте: порог
	// двигает число («сколько, как долго, сколько раз»), поэтому ярусы 2 и 3 бывают только
	// у настроек типа «целое». Булево и строка дверь либо открывают, либо закрывают —
	// это политика, и прятать её под кат нельзя
	Стенд = ПостроитьСтенд(Неопределено);
	Ожидаем.Что(Стенд.Реестр.Ключи().Количество() > 0, "реестр отдал ключи").ЭтоИстина();

	Нарушители = Новый Массив();
	Для Каждого Ключ Из Стенд.Реестр.Ключи() Цикл
		Ярус = Стенд.Раскладка.ЯрусКлюча(Ключ);
		Если Ярус <> 1 И Стенд.Реестр.Описание(Ключ).Тип <> "целое" Тогда
			Нарушители.Добавить(СтрШаблон("%1 — тип «%2», а ярус %3",
				Ключ, Стенд.Реестр.Описание(Ключ).Тип, Ярус));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, "; "),
		"настройки, объявленные порогом, хотя порогом быть не могут").Равно("");

КонецПроцедуры

&Тест
Процедура КаждаяПравимаяНастройкаРеестраРазмеченаЯрусом() Экспорт

	// неразмеченный ключ считается политикой — это страховка, а не разрешение не размечать:
	// ярус решает, где настройка встанет на экране, и молчаливое умолчание прячет решение
	Стенд = ПостроитьСтенд(Неопределено);

	Неразмеченные = Новый Массив();
	Для Каждого Ключ Из Стенд.Реестр.Ключи() Цикл
		Если Стенд.Реестр.ЭтоПрикладная(Ключ) И НЕ Стенд.Раскладка.Размечен(Ключ) Тогда
			Неразмеченные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Неразмеченные, ", "),
		"прикладные настройки без яруса в РаскладкаНастроекХаба").Равно("");

КонецПроцедуры

&Тест
Процедура ЯрусНастройкиОтвечаетНаВопросМеняетсяЛиСоставДоступного() Экспорт

	// якоря правила: политика — то, от чего зависит, кто может войти, завестись,
	// опубликовать и получить пространство. Порт SMTP — число, но называет координату
	// сервера, а не границу дозволенного, и потому политика; ноль в квоте пула означает
	// «без ограничения», дверей он не закрывает, — это порог.
	Стенд = ПостроитьСтенд(Неопределено);

	Политика = Новый Массив();
	Политика.Добавить("oshub.auth.password.enabled");
	Политика.Добавить("oshub.auth.registration.mode");
	Политика.Добавить("oshub.pools.personal_enabled");
	Политика.Добавить("oshub.publish.github_legacy");
	Политика.Добавить("oshub.auth.email.confirm.enabled");
	Политика.Добавить("oshub.mail.enabled");
	Политика.Добавить("oshub.mail.smtp.port");
	Политика.Добавить("oshub.mirror.sync_enabled");
	Политика.Добавить("oshub.webhooks.delivery_enabled");

	Тонкие = Новый Массив();
	Тонкие.Добавить("oshub.auth.token.cli_days");
	Тонкие.Добавить("oshub.proxy.negative.ttl.sec");
	Тонкие.Добавить("oshub.stats.flush_interval_sec");
	Тонкие.Добавить("oshub.stats.flush_threshold");

	Пороги = Новый Массив();
	Пороги.Добавить("oshub.pools.default_quota_mb");
	Пороги.Добавить("oshub.ui.audit_page_size");
	Пороги.Добавить("oshub.proxy.timeout.sec");

	Расхождения = Новый Массив();
	СверитьЯрусы(Стенд, Политика, 1, Расхождения);
	СверитьЯрусы(Стенд, Пороги, 2, Расхождения);
	СверитьЯрусы(Стенд, Тонкие, Стенд.Раскладка.ЯрусТонкий(), Расхождения);

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"настройки, которым назначен не тот ярус").Равно("");

КонецПроцедуры

&Тест
Процедура РазделБезПравимогоНеПринимаетИзменений() Экспорт

	// «Хранилище» задаёт тот, кто разворачивает: править там нечего, формы нет,
	// и POST раздел не принимает вовсе
	Стенд = ПостроитьСтенд(Неопределено);

	Ожидаем.Что(Стенд.Витрина.РедактируемыеРаздела("storage").Количество(),
		"в «Хранилище» править нечего").Равно(0);
	Ожидаем.Что(Стенд.Витрина.ПринимаетИзменения("storage"),
		"и POST раздел не принимает").ЭтоЛожь();
	Ожидаем.Что(Стенд.Витрина.Секции("storage", "Хранилище", "", "/hub/settings/storage",
		"токен-сессии-42").Количество(),
		"секций из реестра у раздела не осталось: рассказ о хранилище печатает своя витрина")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура КатНеПрименяетсяКогдаНадНимНичегоНеОстаётся() Экспорт

	// раздел, где правима ровно одна настройка и та тонкая: под кат она не уходит —
	// над катом не осталось бы ничего, и экран выглядел бы пустым
	Стенд = ПостроитьСтенд(Неопределено);

	Одна = Новый Массив();
	Одна.Добавить(Стенд.Настройки.Карточка("oshub.stats.flush_interval_sec"));
	Ожидаем.Что(Стенд.Раскладка.ЯрусКлюча(Одна[0].Ключ), "настройка и правда тонкая")
		.Равно(Стенд.Раскладка.ЯрусТонкий());

	Разложено = Стенд.Раскладка.Разложить(Одна);
	Ожидаем.Что(Разложено.Хвост.Количество(), "под кат ничего не ушло").Равно(0);
	Ожидаем.Что(Разложено.Голова.Количество(), "тонкая настройка осталась на виду").Равно(1);

	// а на готовом экране такой секции нет: прятать её не за чем
	Разметка = РазделHTML(Стенд, "branding");
	Ожидаем.Что(СтрНайти(Разметка, ЗаголовокТонких()),
		"в «Брендировании» тонких настроек не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "name=""oshub.ui.accent""") > 0,
		"а правимые настройки видны").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЭкранСобираетсяИзДвухВходовВитрины() Экспорт

	// следующие треки строят экран сами: политика — над катом, хвост — под ним.
	// Секции() обязана быть ровно их склейкой, иначе готовый экран разъедется с входами
	Стенд = ПостроитьСтенд(Неопределено);
	Адрес = ДомНастроек.АдресРаздела("login");

	Политика = Стенд.Витрина.СекцииПолитики("login", Адрес, "токен-сессии-42");
	Хвост = Стенд.Витрина.СекцииХвоста("login", Адрес, "токен-сессии-42");
	Целиком = Стенд.Витрина.Секции("login", "Вход и регистрация", "", Адрес, "токен-сессии-42");

	Ожидаем.Что(Политика.Количество() > 0, "секции политики есть").ЭтоИстина();
	Ожидаем.Что(Хвост.Количество() > 0, "секции хвоста есть").ЭтоИстина();
	Ожидаем.Что(Целиком.Количество(), "экран — склейка двух входов")
		.Равно(Политика.Количество() + Хвост.Количество());

	Ожидаем.Что(Целиком[0].Заголовок, "имя раздела дано первой секции")
		.Равно("Вход и регистрация");
	Ожидаем.Что(Целиком[Политика.Количество()].Заголовок,
		"первой под катом идёт секция тонких настроек").Равно(ЗаголовокТонких());

КонецПроцедуры

#КонецОбласти

#Область ИсточникЗначения

&Тест
Процедура УКаждогоЗначенияВиденЕгоСобственныйИсточник() Экспорт

	// источник обязателен для КАЖДОГО значения и стоит У СВОЕЙ настройки: ключ и источник — соседние атрибуты тега
	Детальки = Новый Соответствие();
	Детальки.Вставить("режим", "invite");                    // конфиг форсирует прикладную
	Стенд = ПостроитьСтенд(Детальки);
	Стенд.Настройки.Установить("oshub.ui.audit_page_size", 4242, "root");

	Разметка = РазметкаВсехРазделов(Стенд);

	Расхождения = Новый Массив();
	Для Каждого Карточка Из Стенд.Настройки.Карточки() Цикл
		Если Карточка.Класс <> "прикладная" Тогда
			Продолжить;
		КонецЕсли;
		Ожидаемый = ЛатинскийИсточник(Карточка.Источник);
		Маркер = "data-setting=""" + Карточка.Ключ + """ data-source=""" + Ожидаемый + """";
		Если СтрНайти(Разметка, Маркер) = 0 Тогда
			Расхождения.Добавить(Карточка.Ключ + " (ожидался источник " + Ожидаемый + ")");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, ", "),
		"значения, у которых показан не свой источник").Равно("");

	Ожидаем.Что(СтрНайти(Разметка, "data-source=""database""") > 0, "источник «база» показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "data-source=""default""") > 0, "источник «дефолт» показан").ЭтоИстина();
	// занятая ручка со своего места не уходит и источник называет свой: «из конфигурации»
	Ожидаем.Что(СтрНайти(Разметка,
		"data-setting=""oshub.auth.registration.mode"" data-source=""config""") > 0,
		"перебитая конфигурацией настройка показана и названа заданной конфигурацией").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЧтоРедактируемо

// Разворот владельца 2026-08-07: «решение тащить все настройки в ui — было неверным».
// В интерфейсе правится предмет решения администратора; числа, которыми живёт машина,
// задаёт тот, кто разворачивает. Список ключей — его, и проверяется он ЗНАЧЕНИЕМ карточки
// плюс готовой разметкой: ЧУЖАЯ РУЧКА на экран настроек не выходит вовсе — ни полем,
// ни строкой витрины. Состояние хранилища человек читает своей витриной, а не списком ключей.
//
// Стенд взят с ключами инсталляции В КОНФИГУРАЦИИ: именно так живёт боевая инсталляция,
// и именно этот случай нельзя спутать с занятой прикладной ручкой, которая на экран
// как раз возвращается (ИСТ-НАСТ-003).
&Тест
Процедура ЧислаИнсталляцииНеПравятсяИНеПоказываются() Экспорт

	Детальки = Новый Соответствие();
	Детальки.Вставить("потолок", "65536");         // oshub.ui.asset.max_bytes — из конфигурации
	Детальки.Вставить("пароль", "сверх-секрет-42"); // oshub.admin.password — тоже
	Стенд = ПостроитьСтенд(Детальки);
	Разметка = РазметкаВсехРазделов(Стенд);

	Ожидаем.Что(Стенд.Реестр.КонфигЗадан("oshub.ui.asset.max_bytes"),
		"самотест: значение инсталляции действительно задано конфигурацией").ЭтоИстина();

	Правимые = Новый Массив();
	Показанные = Новый Массив();
	Для Каждого Ключ Из ЧислаИнсталляции() Цикл
		Ожидаем.Что(Стенд.Реестр.Есть(Ключ), "ключ «" + Ключ + "» объявлен в реестре").ЭтоИстина();
		Карточка = Стенд.Настройки.Карточка(Ключ);
		Если Карточка.Редактируемая ИЛИ Карточка.Форсирована
			ИЛИ СтрНайти(Разметка, "name=""" + Ключ + """") > 0 Тогда
			Правимые.Добавить(Ключ);
		КонецЕсли;
		Если СтрНайти(Разметка, "data-setting=""" + Ключ + """") > 0 Тогда
			Показанные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(ЧислаИнсталляции().Количество(), "список владельца прочитан целиком").Равно(47);
	Ожидаем.Что(СтрСоединить(Правимые, ", "),
		"числа инсталляции, которые всё ещё правятся из интерфейса").Равно("");
	Ожидаем.Что(СтрСоединить(Показанные, ", "),
		"числа инсталляции, вылезшие на экран настроек: чужая ручка не показывается").Равно("");

КонецПроцедуры

// Снятое снято: ключа нет в реестре, а значит нет ни поля, ни карточки, ни имени в аудите.
&Тест
Процедура СнятыеКлючиРеестрНеЗнает() Экспорт

	Стенд = ПостроитьСтенд(Неопределено);

	Оставшиеся = Новый Массив();
	Для Каждого Ключ Из СнятыеКлючи() Цикл
		Если Стенд.Реестр.Есть(Ключ) Тогда
			Оставшиеся.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Оставшиеся, ", "),
		"ключи, снятые владельцем совсем, но живые в реестре").Равно("");

КонецПроцедуры


&Тест
Процедура ТолькоРедактируемыеКарточкиПопадаютВФорму() Экспорт

	// признак «редактируемая» берётся из карточки: bootstrap-настройка, ставшая редактируемой, покраснит сторож
	Детальки = Новый Соответствие();
	Детальки.Вставить("режим", "invite");
	Стенд = ПостроитьСтенд(Детальки);
	Разметка = РазметкаВсехРазделов(Стенд);

	Лишние = Новый Массив();
	Пропавшие = Новый Массив();

	Для Каждого Карточка Из Стенд.Настройки.Карточки() Цикл
		ЕстьПоле = СтрНайти(Разметка, "name=""" + Карточка.Ключ + """") > 0;
		Если Карточка.Редактируемая И НЕ ЕстьПоле Тогда
			Пропавшие.Добавить(Карточка.Ключ);
		ИначеЕсли НЕ Карточка.Редактируемая И ЕстьПоле Тогда
			Лишние.Добавить(Карточка.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"нередактируемые настройки, попавшие в форму (bootstrap либо форсированные конфигом)")
		.Равно("");
	Ожидаем.Что(СтрСоединить(Пропавшие, ", "),
		"прикладные настройки, которые нечем править").Равно("");

КонецПроцедуры

&Тест
Процедура ФормаРаздедаНесётДействиеИТокен() Экспорт

	Стенд = ПостроитьСтенд(Неопределено);
	Разметка = РазделHTML(Стенд, "login");

	Ожидаем.Что(СтрНайти(Разметка, "method=""post""") > 0, "секция правки — обычная форма").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "/hub/settings/login") > 0, "форма шлёт на свой раздел").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "токен-сессии-42") > 0, "CSRF-токен в форме").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "name=""oshub.auth.registration.mode""") > 0,
		"прикладная настройка правится полем формы").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НапечатанноеЗначениеСовпадаетСТемЧтоСчитаетсяПрежним() Экспорт

	// контроллер пишет только изменившееся, сравнивая ввод с ЗначениеДляСравнения: расхождение печатаемого и
	// «прежнего» (Строка(26214400) с неразрывными пробелами) давало бы запись и аудит на каждый сабмит без правок
	Стенд = ПостроитьСтенд(Неопределено);
	Разметка = РазметкаВсехРазделов(Стенд);

	Расхождения = Новый Массив();
	Для Каждого Карточка Из Стенд.Настройки.Карточки() Цикл
		Если НЕ Карточка.Редактируемая ИЛИ Карточка.Секрет ИЛИ Карточка.Тип = "булево" Тогда
			Продолжить;
		КонецЕсли;
		Прежнее = Стенд.Витрина.ЗначениеДляСравнения(Карточка);
		// ищем значение В СВОЁМ ПОЛЕ, а не где-нибудь на странице
		Поле = ФрагментПоля(Разметка, Карточка.Ключ);

		Если НЕ ЗначениеЗаполнено(Прежнее) Тогда
			// пустое значение — ОТСУТСТВИЕ атрибута value: слово «не задано» в поле сабмит записал бы в базу
			Если СтрНайти(Поле, "value=") > 0 Тогда
				Расхождения.Добавить(Карточка.Ключ + " (значения нет, а в поле что-то напечатано)");
			КонецЕсли;
		ИначеЕсли СтрНайти(Поле, "value=""" + Прежнее + """") = 0 Тогда
			Расхождения.Добавить(Карточка.Ключ + " (прежним считается «" + Прежнее
				+ "», в поле напечатано другое)");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, ", "),
		"настройки, у которых напечатанное значение не равно «прежнему»").Равно("");

КонецПроцедуры

&Тест
Процедура РазделБезРедактируемыхИзмененийНеПринимает() Экспорт

	Стенд = ПостроитьСтенд(Неопределено);
	Ожидаем.Что(Стенд.Витрина.ПринимаетИзменения("storage"),
		"хранилище — одни bootstrap-значения, POST там не по адресу").ЭтоЛожь();
	Ожидаем.Что(Стенд.Витрина.ПринимаетИзменения("branding"),
		"в брендировании есть прикладные настройки").ЭтоИстина();

	// прикладной раздел теряет приём POST, когда КАЖДЫЙ его ключ форсирован конфигом:
	// правимых карточек не осталось, и принимать раздел больше нечего
	ИзКонфига = ПостроитьСтенд(ДеталькиБрендирования());
	Ожидаем.Что(ИзКонфига.Витрина.РедактируемыеРаздела("branding").Количество(),
		"форсированных конфигом карточек в правке нет").Равно(0);
	Ожидаем.Что(ИзКонфига.Витрина.ПринимаетИзменения("branding"),
		"весь раздел из конфигурации — POST не по адресу").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЧестныеХинты

// Прикладная настройка, перебитая ключом в конфигурации, поля правки не получает — но
// со своего места не пропадает: пустого места на месте ручки не бывает. Уточнение
// владельца 2026-08-07: убирать в конфигурацию велено конкретные ключи, а не прятать
// с формы всё, что конфигурация задала (ИСТ-НАСТ-003).
&Тест
Процедура ЗанятаяКонфигомНастройкаОстаётсяНаМестеИОбъясняетСебя() Экспорт

	Детальки = Новый Соответствие();
	Детальки.Вставить("режим", "invite");
	Стенд = ПостроитьСтенд(Детальки);

	Карточка = Стенд.Настройки.Карточка("oshub.auth.registration.mode");
	Ожидаем.Что(Карточка.Редактируемая, "настройка под конфигом не редактируется").ЭтоЛожь();
	Ожидаем.Что(Карточка.Форсирована, "но ручка её — прикладная, просто занята").ЭтоИстина();

	Разметка = РазделHTML(Стенд, "login");

	Ожидаем.Что(СтрНайти(Разметка, "name=""oshub.auth.registration.mode"""),
		"поля правки занятой настройке не досталось").Равно(0);
	// подпись, действующее значение и объяснение — на том же месте, где было бы поле
	Ожидаем.Что(СтрНайти(Разметка, Стенд.Витрина.Метка(Карточка)) > 0,
		"подпись занятой настройки осталась на экране").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "value=""invite""") > 0,
		"действующее значение видно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ПричинаЗанятости(Карточка)) > 0,
		"сказано, чем задана и что убрать, чтобы править отсюда").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "OSHUB_AUTH_REGISTRATION_MODE") > 0,
		"названа переменная окружения").ЭтоИстина();

	// а соседи по разделу правятся по-прежнему — раздел не осыпался целиком
	Ожидаем.Что(СтрНайти(Разметка, "name=""oshub.auth.password.enabled""") > 0,
		"правимые соседи остались").ЭтоИстина();

КонецПроцедуры

// Занятая ручка секретной настройки показывает, ЧТО она занята, но не значение:
// ENV-сниппет заблокированного поля печатается рядом, и в него значение не попадает.
&Тест
Процедура ЗанятыйСекретНеПоказываетЗначенияНиПолемНиСниппетом() Экспорт

	Стенд = ПостроитьСтенд(Неопределено);
	Стенд.Настройки.Установить("oshub.mail.smtp.password", "пароль-почты-42", "root");

	Карточка = Стенд.Настройки.Карточка("oshub.mail.smtp.password");
	Ожидаем.Что(Карточка.Секрет, "самотест: настройка объявлена секретной").ЭтоИстина();

	Разметка = Стенд.Поля.ПолеЗанятое(Карточка).Рендер();

	Ожидаем.Что(СтрНайти(Разметка, "пароль-почты-42"),
		"значение секрета не показывается ни полем, ни ENV-сниппетом").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "OSHUB_MAIL_SMTP_PASSWORD") > 0,
		"но переменная, которой его задают, названа").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УходКлючаИзКонфигаВозвращаетПравкуБезРестарта() Экспорт

	// тот же экран без ключа в конфигурации: поле снова редактируемое — проверка обещания хинта
	Стенд = ПостроитьСтенд(Неопределено);
	Разметка = РазделHTML(Стенд, "login");

	Ожидаем.Что(СтрНайти(Разметка, "name=""oshub.auth.registration.mode""") > 0,
		"без ключа в конфигурации режим регистрации правится из UI").ЭтоИстина();
	// поле выбора собрано из валидатора реестра, а не из списка значений в UI
	Ожидаем.Что(СтрНайти(Разметка, "value=""invite""") > 0, "вариант invite предложен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "value=""disabled""") > 0, "вариант disabled предложен").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ВидЗначения

&Тест
Процедура БулевоПоказываетсяСловамиАНеTrueFalse() Экспорт

	// дом печатал «true»/«false» — машинный вид в интерфейсе оператора. Уборка введённого
	// руками печатает значение текстом, и там это видно
	Стенд = ПостроитьСтенд(Неопределено);
	Стенд.Настройки.УстановитьМеханизмом("oshub.pools.personal_enabled", Истина, "root",
		"ПультЛичныхПространств");
	Стенд.Настройки.Установить("oshub.publish.github_legacy", Ложь, "root");
	Разметка = РазделHTML(Стенд, "pools") + РазделHTML(Стенд, "legacy");

	// значение уборки печатается в <code> — проверяем его, а не слово в подсказке
	Ожидаем.Что(СтрНайти(Разметка, "<code>Да</code>") > 0, "включённое булево — «Да»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<code>Нет</code>") > 0, "выключенное булево — «Нет»").ЭтоИстина();
	// «true»/«false» ищем ИМЕННО КАК ЗНАЧЕНИЕ: слово true легально живёт в aria-hidden у иконок
	Ожидаем.Что(СтрНайти(Разметка, "<code>true</code>"), "машинного «true» в значении нет").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "<code>false</code>"), "машинного «false» в значении нет").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, ">true<"), "машинного «true» текстом нет").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, ">false<"), "машинного «false» текстом нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустоеЗначениеНазваноСловамиАНеПустотой() Экспорт

	// Пустая ячейка выглядит как сломанный экран: «не задано» — это значение, а не пустота.
	// Строкой уборки видно то же значение, что действует
	Стенд = ПостроитьСтенд(Неопределено);
	Стенд.Настройки.Установить("oshub.mail.smtp.host", "", "root");
	Разметка = РазделHTML(Стенд, "mail");

	Ожидаем.Что(СтрНайти(Разметка, "не задано") > 0,
		"пустой хост SMTP назван словами").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекретНеРаскрываетсяНиВПолеНиВСниппете() Экспорт

	// пароль администратора задаётся конфигурацией и на экраны настроек не выходит вовсе —
	// ищем его по ВСЕЙ разметке дома, а не в одном разделе
	Детальки = Новый Соответствие();
	Детальки.Вставить("пароль", "сверх-секрет-42");
	Стенд = ПостроитьСтенд(Детальки);

	Ожидаем.Что(СтрНайти(РазметкаВсехРазделов(Стенд), "сверх-секрет-42"),
		"секрет конфигурации не показывается ни на одном экране дома").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолеРедактируемогоСекретаОткрываетсяПустымИНеНесётЗначения() Экспорт

	// ИСТ-НАСТ-007: секрет ВВОДИТСЯ из формы, но обратно не читается. Прежний сторож
	// секретности стоял на НЕредактируемом ключе и на этой ветке молчал бы
	Стенд = ПостроитьСтенд(Неопределено);
	Стенд.Настройки.Установить("oshub.mail.smtp.password", "сверх-секрет-42", "root");

	Разметка = РазделHTML(Стенд, "mail");

	Ожидаем.Что(СтрНайти(Разметка, "сверх-секрет-42"),
		"введённый секрет не возвращается в поле").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "type=""password""") > 0,
		"поле секрета — password, а не текст: " + Разметка).ЭтоИстина();
	// поле ОТКРЫВАЕТСЯ ПУСТЫМ: подставленная маска уехала бы обратно новым значением
	Ожидаем.Что(СтрНайти(Разметка, "value=""•••"""),
		"в поле не подставлена и маска: " + Разметка).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "Значение задано") > 0,
		"рядом сказано, что значение задано — но не какое").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустоеПолеСекретаОставляетЗначениеКакЕсть() Экспорт

	// пустое поле означает «не трогать», а не «стереть»: иначе любое сохранение раздела
	// почты сносило бы пароль SMTP, которого форма и не показывала
	Стенд = ПостроитьСтенд(Неопределено);
	Стенд.Настройки.Установить("oshub.mail.smtp.password", "сверх-секрет-42", "root");

	Пульт = Новый ПультЗначенийНастроек(Стенд.Настройки, Стенд.Витрина, Новый РазборФормы(),
		Новый ОтветыНастроекЗаглушка(), UI.Тексты);

	Форма = Новый Соответствие();
	Форма.Вставить("oshub.mail.smtp.password", "");
	Ожидаем.Что(Пульт.Применить("mail", Форма, "root"), "пустое поле секрета — не отказ").Равно("");

	Ожидаем.Что(Стенд.Настройки.Значение("oshub.mail.smtp.password"),
		"значение осталось прежним").Равно("сверх-секрет-42");

	Форма.Вставить("oshub.mail.smtp.password", "новый-секрет-7");
	Ожидаем.Что(Пульт.Применить("mail", Форма, "root"), "заполненное поле принимается").Равно("");
	Ожидаем.Что(Стенд.Настройки.Значение("oshub.mail.smtp.password"),
		"заполненное поле заменяет значение").Равно("новый-секрет-7");

КонецПроцедуры

&Тест
Процедура ПолитикаПароляСобранаОднимБлокомВСвоёмРазделе() Экспорт

	// ИСТ-ДОСТ-032: «небольшой дашборд с настройкой» — шесть значений вместе, а не
	// россыпь по разделу входа. Судим по РАЗДЕЛУ каждого ключа, а не по тексту страницы
	Стенд = ПостроитьСтенд(Неопределено);

	Ключи = СтрРазделить("min_length,max_length,require_lowercase,require_uppercase,"
		+ "require_digit,require_special", ",");
	Для Каждого Хвост Из Ключи Цикл
		Ожидаем.Что(Стенд.Разделы.РазделКлюча("oshub.auth.password." + Хвост),
			"значение политики пароля живёт в своём разделе").Равно("password");
	КонецЦикла;

	// выключатель парольного входа — другая история и другой раздел
	Ожидаем.Что(Стенд.Разделы.РазделКлюча("oshub.auth.password.enabled"),
		"тумблер входа остаётся в разделе входа").Равно("login");

	// одним блоком — значит ни одно значение не уходит под кат
	Хвост = Стенд.Раскладка.Разложить(Стенд.Витрина.РедактируемыеРаздела("password")).Хвост;
	Ожидаем.Что(Хвост.Количество(), "под катом политики пароля не остаётся ничего").Равно(0);
	Ожидаем.Что(Стенд.Витрина.РедактируемыеРаздела("password").Количество(),
		"в разделе ровно шесть правимых значений").Равно(6);

КонецПроцедуры

&Тест
Процедура НастройкаЭкранаЖурналаЖивётНеВБрендировании() Экспорт

	// ИСТ-НАСТ-009: раздел — по смыслу, а не по написанию ключа. oshub.ui.audit_page_size
	// начинается как оформление, а настраивает журнал
	Стенд = ПостроитьСтенд(Неопределено);

	Ожидаем.Что(Стенд.Разделы.РазделКлюча("oshub.ui.audit_page_size"),
		"размер страницы журнала — не брендирование").Равно("maintenance");
	Ожидаем.Что(Стенд.Разделы.РазделКлюча("oshub.ui.theme"),
		"КОНТРОЛЬ: соседний ключ того же префикса остался в брендировании").Равно("branding");

КонецПроцедуры

#КонецОбласти

#Область УборкаВведённогоРуками

&Тест
Процедура ЗначениеИзБазыПредлагаетсяКСбросуИИсчезаетПослеНего() Экспорт

	// проверяем оба конца сброса: секция появилась по факту записи и исчезла по факту её удаления
	Стенд = ПостроитьСтенд(Неопределено);

	Ожидаем.Что(СтрНайти(РазделHTML(Стенд, "maintenance"), "value=""сбросить"""),
		"без введённых руками значений уборке нечего показывать").Равно(0);

	Стенд.Настройки.Установить("oshub.ui.audit_page_size", 4242, "root");
	Разметка = РазделHTML(Стенд, "maintenance");

	Ожидаем.Что(СтрНайти(Разметка, "data-setting=""oshub.ui.audit_page_size"" data-source=""database""") > 0,
		"введённое руками значение отмечено источником «база»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "value=""сбросить""") > 0, "предложена уборка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "value=""oshub.ui.audit_page_size""") > 0,
		"уборка знает, какой ключ убирает").ЭтоИстина();

	Стенд.Настройки.Сбросить("oshub.ui.audit_page_size", "root");
	Разметка = РазделHTML(Стенд, "maintenance");

	Ожидаем.Что(СтрНайти(Разметка, "value=""сбросить"""),
		"после сброса убирать нечего").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "data-setting=""oshub.ui.audit_page_size"" data-source=""default""") > 0,
		"значение вернулось к дефолту").ЭтоИстина();
	Ожидаем.Что(Стенд.Хранилище.Значение("oshub.ui.audit_page_size"),
		"строка базы действительно удалена, а не «сброшена» на словах").Равно(Неопределено);

КонецПроцедуры

