КонецПроцедуры

&Тест
Процедура ОтказБазыОставляетСтраницуЖивойНоВиденВЖурнале() Экспорт

	// у оператора отвалилась база: страница обязана нарисоваться умолчаниями, а причина —
	// доехать до журнала. Тихий фолбэк выглядит как «хаб сам себя переименовал»
	Стенд = ПостроитьСтенд(Неопределено);

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.брендирование.отказбазы");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Рендерер = КаркасНаНастройках(Новый Брендирование(Стенд.Настройки, Неопределено, Лог),
		Новый ВыборОформления(Новый ОформлениеХаба(Стенд.Настройки, Лог)));

	Стенд.Хранилище.ПадатьПриЧтении("база недоступна: соединение закрыто");
	Разметка = Страница(Рендерер);

	Ожидаем.Что(СтрНайти(Разметка, "<title>Каталог — OpenHub</title>") > 0,
		"страница нарисована знаком по умолчанию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ТегHTML("dark")) > 0,
		"и темой кита, а не отказом отдать страницу").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "oshub.ui.brand") > 0,
		"в журнале назван нечитаемый ключ знака: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "oshub.ui.theme") > 0,
		"и нечитаемый ключ оформления").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "falling back") > 0,
		"предупреждение говорит, что значение подменено умолчанием").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БрендированиеФорсированноеКонфигомИзФормыНеПравится() Экспорт

	// в этом разделе конфигурация заняла ВСЕ ручки: секция перестаёт быть формой,
	// но остаётся на экране — иначе «Брендирование» выглядело бы снесённым
	Стенд = ПостроитьСтенд(ДеталькиБрендирования());
	Разметка = РазделHTML(Стенд, "branding");

	Ожидаем.Что(СтрНайти(Разметка, "name=""oshub.ui.brand"""),
		"форсированному конфигом знаку поля не досталось").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "Хаб Из Конфига") > 0,
		"но действующий знак виден значением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "OSHUB_UI_BRAND") > 0,
		"и названо, чем он задан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "type=""submit"""),
		"кнопки сохранения у секции без единой правимой настройки нет").Равно(0);

	Отказ = "";
	Попытка
		Стенд.Настройки.Установить("oshub.ui.brand", "Хаб Ромашка", "ольга-админ");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "форсирована") > 0,
		"доменный API отказал форсированному ключу: " + Отказ).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Рендерер каркаса, собранный на ЖИВЫХ настройках стенда: знак, подпись, тема и акцент
// читаются через СервисНастроек ровно так, как на боевом запросе.
Функция РендерерИнсталляции(Знач Стенд)

	Возврат КаркасНаНастройках(Новый Брендирование(Стенд.Настройки, Неопределено, Неопределено),
		Новый ВыборОформления(Новый ОформлениеХаба(Стенд.Настройки)));

КонецФункции

// Каркас страницы на СВОЁМ брендировании и СВО�ек оформлении: корень принадлежит киту,
// а знак, подпись и адреса приходят ему обрамлением инсталляции.
Функция КаркасНаНастройках(Знач Бренд, Знач Оформление)

	Обрамление = Новый ОбрамлениеХаба(Бренд, UI.Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), UI.Тексты,
		UI.АдресаКаталога, Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит);
	Возврат Новый КаркасСтраницы(UI.Кит, UI.Токены, Оформление, UI.Тексты, UI.Модели,
		UI.Активы, Обрамление, UI.МенюХаба);

КонецФункции

// Тег <html> ровно в том виде, как его печатает каркас страницы. Подстрока
// «data-theme="light"» истинной бывает ВСЕГДА: тем же текстом ТокеныТемы печатают
// селектор светлой палитры в <head> каждой страницы, и сторож на ней тождествен.
Функция ТегHTML(Знач Тема)
	Возврат СтрШаблон("<html lang=""ru"" data-theme=""%1"">", Тема);
КонецФункции

Функция Страница(Знач Рендерер)
	Возврат Рендерер.Страница("Каталог", "<p>тело</p>",
		Рендерер.КонтекстСтраницы(Неопределено, Неопределено));
КонецФункции

// Все ключи раздела «Брендирование», заданные конфигурацией.
Функция ДеталькиБрендирования()

	Результат = Новый Соответствие();
	Результат.Вставить("тема", "светлая");
	Результат.Вставить("акцент", "#123456");
	Результат.Вставить("знак", "Хаб Из Конфига");
	Результат.Вставить("подпись", "Подпись из конфига");
	Результат.Вставить("название", "false");
	Результат.Вставить("потолок", "65536");
	Возврат Результат;

КонецФункции

// Стенд: реестр («конфиг» — необязательными детальками), сервис на заглушке базы, витрина.
// Имена деталек: «режим» → oshub.auth.registration.mode, «пароль» → oshub.admin.password,
// «тема», «акцент», «знак», «подпись» → одноимённые oshub.ui.*.
Функция ПостроитьСтенд(Знач Детальки)

	// параметры реестра позиционные: правила, таблица подсистем, порт, каталог, бэкенд,
	// ТЕМА, АКЦЕНТ, ЗНАК, ПОДПИСЬ, НАЗВАНИЕ РЯДОМ СО ЗНАКОМ, ПОТОЛОК КАРТИНКИ, задачи,
	// телеметрия, адрес телеметрии, логин админа, ПАРОЛЬ АДМИНА, файл пароля, РЕЖИМ РЕГИСТРАЦИИ
	Правила = Новый ВидыПроверок();
	Реестр = Новый РеестрНастроек(Правила, Новый НастройкиПодсистем(Правила), "", "", "",
		Деталька(Детальки, "тема"), Деталька(Детальки, "акцент"),
		Деталька(Детальки, "знак"), Деталька(Детальки, "подпись"),
		Деталька(Детальки, "название"), Деталька(Детальки, "потолок"),
		"", "", "", "", Деталька(Детальки, "пароль"), "", Деталька(Детальки, "режим"));

	Хранилище = Новый ХранилищеНастроекВПамяти();
	Издатель = Новый ИздательНастроекЗаглушка();
	Настройки = Новый СервисНастроек(Реестр, Хранилище, Издатель, Новый ИмяОбъектаАудита(),
		Новый ВалидаторНастроек());
	Разделы = Новый РазделыНастроекХаба();
	Раскладка = Новый РаскладкаНастроекХаба();
	ПоляКарточек = Новый ПоляНастроек(Реестр, UI.Кит, UI.Тексты);
	Витрина = Новый ВитринаНастроек(Настройки, Разделы, Раскладка, ПоляКарточек, UI.Кит,
		UI.РендерерНастроек, UI.Тексты);

	Возврат Новый Структура("Реестр, Хранилище, Издатель, Настройки, Витрина, Разделы, Раскладка, Поля",
		Реестр, Хранилище, Издатель, Настройки, Витрина, Разделы, Раскладка, ПоляКарточек);

КонецФункции

// Ключи, названные владельцем при развороте 2026-08-07: они уходят из интерфейса
// в конфигурацию инсталляции и остаются на экране карточкой.
Функция ЧислаИнсталляции()

	Список = "oshub.ui.asset.max_bytes,"
		+ "oshub.auth.session.ttlseconds,oshub.auth.login.maxattempts,"
		+ "oshub.auth.login.lockoutseconds,oshub.auth.invite.ttl.days,"
		+ "oshub.auth.token.max_days,oshub.auth.email.confirm.ttl.hours,"
		+ "oshub.admin.login,oshub.admin.password,oshub.admin.password_file,"
		+ "oshub.publish.inbox.max_pending_per_pool,oshub.publish.inbox.max_pending_per_user,"
		+ "oshub.publish.max_unpacked_bytes,oshub.publish.max_files,"
		+ "oshub.publish.max_manifest_bytes,oshub.publish.max_upload_bytes,"
		+ "oshub.storage.quota.bytes,oshub.storage.root,oshub.storage.backend,"
		+ "oshub.storage.s3.endpoint,oshub.storage.s3.bucket,oshub.storage.s3.region,"
		+ "oshub.storage.s3.prefix,oshub.storage.s3.force_path_style,"
		+ "oshub.mirror.max_per_pool,oshub.mirror.default_interval_sec,"
		+ "oshub.mirror.min_interval_sec,oshub.mirror.run_stale_sec,"
		+ "oshub.mirror.max_packages_per_cycle,oshub.mirror.max_cycles_per_run,"
		+ "oshub.mirror.queue_max,oshub.mirror.cycles_per_turn,oshub.mirror.queue_poll_sec,"
		+ "oshub.webhooks.max_queue,oshub.webhooks.max_attempts,"
		+ "oshub.webhooks.backoff_base_sec,oshub.webhooks.delivery_interval_sec,"
		+ "oshub.webhooks.delivery_timeout_sec,oshub.webhooks.test_max_per_hour,"
		+ "oshub.jobs.enabled,oshub.jobs.tick_interval_ms,oshub.jobs.readme_reindex_hour,"
		+ "oshub.jobs.mirror_sync_interval_sec,oshub.jobs.proxy_gc_interval_sec,"
		+ "oshub.jobs.cli_device_gc_interval_sec,oshub.jobs.invite_gc_interval_sec,"
		+ "oshub.jobs.pool_volume_audit_interval_sec";

	Возврат СтрРазделить(Список, ",", Ложь);

КонецФункции

// Ключи, снятые владельцем совсем — вместе с механизмами, которые они настраивали.
Функция СнятыеКлючи()

	Возврат СтрРазделить("oshub.auth.email.confirm.max.per.day,"
		+ "oshub.auth.email.confirm.max.per.day.ip,oshub.webhooks.max_per_pool", ",", Ложь);

КонецФункции

Функция Деталька(Знач Детальки, Знач Имя)

	Если Детальки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Детальки.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

// Разметка одного раздела дома (все его секции подряд).
Функция РазделHTML(Знач Стенд, Знач Раздел)

	Результат = "";
	Секции = Стенд.Витрина.Секции(Раздел, ДомНастроек.ПодписьРаздела(Раздел), "",
		ДомНастроек.АдресРаздела(Раздел), "токен-сессии-42");

	Для Каждого Секция Из Секции Цикл
		// секция с действием оборачивается каркасом в <form> — берём разметку целиком, как её увидит браузер
		Результат = Результат + UI.РендерерНастроек.Отрисовать(МодельДома(Секция));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разметка ВСЕХ разделов дома — корпус для сторожей полноты.
Функция РазметкаВсехРазделов(Знач Стенд)

	Результат = "";
	Для Каждого Ключ Из КлючиРазделовДома() Цикл
		Результат = Результат + РазделHTML(Стенд, Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключи разделов дома — из настоящего дерева навигации: раздел, которого в доме нет, недостижим по URL.
Функция КлючиРазделовДома()

	Результат = Новый Массив();
	Основа = ДомНастроек.БазовыйАдрес() + "/";

	Для Каждого Блок Из ДомНастроек.ВложенныеБлоки() Цикл
		// блок без своего пункта дерева печатается на чужом экране, но настройки у него свои
		Результат.Добавить(Блок);
	КонецЦикла;

	Для Каждого Раздел Из ДомНастроек.Разделы("") Цикл
		Ключ = Сред(Раздел.Адрес, СтрДлина(Основа) + 1);
		Ожидаем.Что(ДомНастроек.ЕстьРаздел(Ключ),
			"ключ раздела вынут из адреса «" + Раздел.Адрес + "»").ЭтоИстина();
		Результат.Добавить(Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МодельДома(Знач Секция)

	Секции = Новый Массив();
	Секции.Добавить(Секция);

	Модель = Новый Структура();
	Модель.Вставить("Ключ", "hub");
	Модель.Вставить("Заголовок", "Настройки хаба");
	Модель.Вставить("Объект", "openhub");
	Модель.Вставить("Пояснение", "");
	Модель.Вставить("Разделы", Новый Массив());
	Модель.Вставить("Уведомления", Новый Массив());
	Модель.Вставить("Секции", Секции);
	Возврат Модель;

КонецФункции

// Ожидаемое значение data-source вычисляется здесь заново: сторож, спрашивающий ответ у проверяемого, зеленеет.
Функция ЛатинскийИсточник(Знач Источник)

	Если Источник = "конфиг" Тогда
		Возврат "config";
	ИначеЕсли Источник = "база" Тогда
		Возврат "database";
	ИначеЕсли Источник = "дефолт" Тогда
		Возврат "default";
	КонецЕсли;
	Возврат "неизвестный-источник-" + Строка(Источник);

КонецФункции

// Заголовок секции тонких настроек берётся из словаря: правка формулировки тест не роняет.
Функция ЗаголовокТонких()
	Возврат UI.Тексты.Текст("settings.hub.fine.title");
КонецФункции

Процедура СверитьЯрусы(Знач Стенд, Знач Ключи, Знач Ожидаемый, Расхождения)

	Для Каждого Ключ Из Ключи Цикл
		Факт = Стенд.Раскладка.ЯрусКлюча(Ключ);
		Если Факт <> Ожидаемый Тогда
			Расхождения.Добавить(СтрШаблон("%1: ждали ярус %2, назначен %3",
				Ключ, Ожидаемый, Факт));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция Роли()
	Результат = Новый Массив();
	Результат.Добавить("label");
	Результат.Добавить("hint");
	Возврат Результат;
КонецФункции

// Объяснение занятой ручки берётся из словаря: правка формулировки тест не роняет,
// подмена смысла — роняет.
Функция ПричинаЗанятости(Знач Карточка)
	Возврат UI.Тексты.Шаблон("settings.value.locked.forced", Карточка.Ключ, Карточка.Переменная);
КонецФункции

// Разметка ОДНОГО поля формы: от атрибута name до конца обёртки <label> — компонент «Поле» держит всё внутри неё.
Функция ФрагментПоля(Знач Разметка, Знач Ключ)

	Начало = СтрНайти(Разметка, "name=""" + Ключ + """");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, "</label>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Функция СколькоРаз(Знач Текст, Знач Подстрока)

	Результат = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Подстрока);

	Пока Позиция > 0 Цикл
		Результат = Результат + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Подстрока));
		Позиция = СтрНайти(Хвост, Подстрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
