КонецПроцедуры

#КонецОбласти

#Область СловарьМетокНастроек

&Тест
Процедура УКаждогоКлючаРеестраЕстьМеткаИПодсказкаВСловаре() Экспорт

	// ключ словаря ВЫЧИСЛЯЕТСЯ из ключа настройки, поэтому скан «мёртвых ключей» семейство settings.key.* не видит:
	// настройка без метки даёт на экране маркер «[?…]», метка без настройки — мёртвый груз словаря
	Стенд = ПостроитьСтенд(Неопределено);

	Ожидаемые = Новый Соответствие();
	Пропущенные = Новый Массив();

	Для Каждого Ключ Из Стенд.Реестр.Ключи() Цикл
		Для Каждого Роль Из Роли() Цикл
			КлючСловаря = Стенд.Витрина.КлючТекста(Ключ, Роль);
			Ожидаемые.Вставить(КлючСловаря, Ключ);
			Если UI.СловарьТекстов.НайтиТекст(КлючСловаря) = Неопределено Тогда
				Пропущенные.Добавить(КлючСловаря + " (" + Ключ + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Лишние = Новый Массив();
	Для Каждого КлючСловаря Из UI.СловарьТекстов.Ключи() Цикл
		Если Лев(КлючСловаря, 13) = "settings.key." И Ожидаемые.Получить(КлючСловаря) = Неопределено Тогда
			Лишние.Добавить(КлючСловаря);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "),
		"настройки без метки/подсказки: на экране будет маркер «[?ключ]»").Равно("");
	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"метки настроек, которых нет в реестре: мёртвый груз словаря").Равно("");

КонецПроцедуры

&Тест
Процедура КлючиСловаряРазличаютНастройкиОднозначно() Экспорт

	// ключ словаря выводится из имени переменной окружения: проверяется взаимная однозначность, а не формат
	Стенд = ПостроитьСтенд(Неопределено);

	Встреченные = Новый Соответствие();
	Столкновения = Новый Массив();

	Для Каждого Ключ Из Стенд.Реестр.Ключи() Цикл
		КлючСловаря = Стенд.Витрина.КлючТекста(Ключ, "label");
		Прежний = Встреченные.Получить(КлючСловаря);
		Если Прежний <> Неопределено Тогда
			Столкновения.Добавить(Прежний + " и " + Ключ + " → " + КлючСловаря);
		КонецЕсли;
		Встреченные.Вставить(КлючСловаря, Ключ);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Столкновения, ", "),
		"настройки, получившие один и тот же ключ словаря").Равно("");

КонецПроцедуры

#КонецОбласти

#Область БрендированиеИнсталляции

&Тест
Процедура ЗнакИПодписьМеняютсяБезПересборкиГрафа() Экспорт

	// рендерер собран ОДИН раз: если знак читается на старте, вторая страница останется прежней
	Стенд = ПостроитьСтенд(Неопределено);
	Рендерер = РендерерИнсталляции(Стенд);

	Ожидаем.Что(СтрНайти(Страница(Рендерер), "<title>Каталог — OpenHub</title>") > 0,
		"знак по умолчанию печатается, пока настройка пуста").ЭтоИстина();

	Стенд.Настройки.Установить("oshub.ui.brand", "Хаб Ромашка", "ольга-админ");
	Стенд.Настройки.Установить("oshub.ui.tagline", "Внутренний хаб компании", "ольга-админ");

	Свежая = Страница(Рендерер);
	Ожидаем.Что(СтрНайти(Свежая, "<title>Каталог — Хаб Ромашка</title>") > 0,
		"сохранённое название видно тем же процессом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Свежая, "Внутренний хаб компании") > 0,
		"сохранённая подпись видна в подвале").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Свежая, "— OpenHub<"), "прежний знак со страницы ушёл").Равно(0);

КонецПроцедуры

&Тест
Процедура ТемаИАкцентИнсталляцииПриезжаютВHead() Экспорт

