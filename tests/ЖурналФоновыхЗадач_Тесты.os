// Оператор судит о фоновых задачах только по журналу: тут проверяется, что состав задач
// объявлен целиком, прогон виден стартом и исходом на ОТЛАДКЕ и не шумит на ИНФОРМАЦИИ,
// упавшая задача не выдаёт себя за успешную, а смерть фонового цикла не пропадает молча.

#Использовать asserts
#Использовать autumn-logos
#Использовать os-scheduler

Перем КаталогМодулей_;
Перем КаталогФикстур_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур_ = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ПланировщикПриложения.os"), "ПланировщикПриложения");
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЖурналФоновыхЗадач.os"), "ЖурналФоновыхЗадач");
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаПодЖурналом.os"), "ЗадачаПодЖурналом");
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаПодСпаном.os"), "ЗадачаПодСпаном");
	Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы", "ПриведениеЧисел.os"), "ПриведениеЧисел");
	Подключить(ОбъединитьПути(КаталогМодулей_, "основа", "Классы", "ПриведениеФлагов.os"), "ПриведениеФлагов");
	Подключить(ОбъединитьПути(ОбъединитьПути(КаталогМодулей_, "наблюдаемость", "Классы", "пробы"),
		"ГотовностьХаба.os"), "ГотовностьХаба");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ОбработчикСчётчик.os"), "ОбработчикСчётчик");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ОбработчикПадающий.os"), "ОбработчикПадающий");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ЧасыРучные.os"), "ЧасыРучные");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ЧасыПадающие.os"), "ЧасыПадающие");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ЛовушкаЛога.os"), "ЛовушкаЛога");
КонецПроцедуры

#Область СоставЗадач

// Оператор читает состав задач из журнала: задача, которой в объявлении нет, для него
// не существует. Сверяется не с рукописным списком, а с реестром самого планировщика.
&Тест
Процедура ОбъявленныйСоставСовпадаетСРеестромПланировщика() Экспорт

	Мир = НовыйМир("состав", УровниЛога.Информация, Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0)));
	Мир.Планировщик.Настроить();

	Необъявленные = Новый Массив();
	Для Каждого Запись Из Мир.Планировщик.ЭкземплярПланировщика().Состояния() Цикл
		Если СтрНайти(Мир.Ловушка.Всё(), Запись.Ключ) = 0 Тогда
			Необъявленные.Добавить(Запись.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Мир.Планировщик.ЭкземплярПланировщика().Состояния().Количество(),
		"планировщик поднял все задачи хаба").Равно(8);
	Ожидаем.Что(СтрСоединить(Необъявленные, ", "),
		"задачи, которых оператор в журнале старта не увидит: " + Мир.Ловушка.Всё()).Равно("");

КонецПроцедуры

#КонецОбласти

#Область ПрогоныЗадач

// Прогон полезен, но шумит на каждый проход, — значит ОТЛАДКА: поднявший подробность
// этого журнала видит старт и исход, а обычная консоль хаба ими не засоряется.
&Тест
Процедура ПрогонЗадачиВиденСтартомИЗавершениемНаОтладке() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("прогон", УровниЛога.Отладка, Часы);
	Мир.Планировщик.Настроить();
	ДоПрогона = Мир.Ловушка.Количество();

	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Мир.Обработчики.Статистика.Вызовов(), "задача действительно отработала").Равно(1);

	Старт = Мир.Ловушка.Сообщение(ДоПрогона);
	Исход = Мир.Ловушка.Сообщение(ДоПрогона + 1);
	Ожидаем.Что(Мир.Ловушка.Количество() - ДоПрогона,
		"прогон дал ровно две записи — старт и исход").Равно(2);
	Ожидаем.Что(СтрНайти(Старт, "сброс-статистики") > 0 И СтрНайти(Старт, "стартовала") > 0,
		"первая запись — старт задачи: " + Старт).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Исход, "сброс-статистики") > 0 И СтрНайти(Исход, "отработала") > 0,
		"вторая запись — её завершение: " + Исход).ЭтоИстина();

КонецПроцедуры

// Молчащий сбой неотличим от неработающего планировщика — самый дорогой из режимов
// отказа: хаб выглядит живым, а задача не делает ничего много суток подряд.
&Тест
Процедура УпавшаяЗадачаВиднаСТекстомОшибкиИНеСчитаетсяУспешной() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("сбой", УровниЛога.Информация, Часы, Новый ОбработчикПадающий());

	Мир.Планировщик.Настроить();
	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();

	Состояние = Мир.Планировщик.ЭкземплярПланировщика().Состояние("сброс-статистики");
	Ожидаем.Что(Состояние.статус, "исключение обёртка не проглотила").Равно("ошибка");
	Ожидаем.Что(Состояние.успехов, "упавший прогон не засчитан успехом").Равно(0);
	Ожидаем.Что(СтрНайти(Мир.Ловушка.Всё(), "ОбработчикПадающий: намеренный сбой задачи") > 0,
		"текст ошибки обработчика дошёл до оператора: " + Мир.Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Уровень прогонов не переключается из хаба: на ИНФОРМАЦИИ их нет никогда, а сбой
// остаётся ОШИБКОЙ — то есть виден и там.
&Тест
Процедура НаИнформацииПрогоновНетАСбойВиден() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("тихо", УровниЛога.Информация, Часы, Новый ОбработчикПадающий());
	Мир.Планировщик.Настроить();
	ДоПрогона = Мир.Ловушка.Количество();

	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();
	Записано = Мир.Ловушка.Сообщение(ДоПрогона);

	// Ровно одна запись на упавший прогон: старт и исход ушли на ОТЛАДКУ, сбой остался.
	Ожидаем.Что(Мир.Ловушка.Количество() - ДоПрогона,
		"на ИНФОРМАЦИИ прогон оставляет в консоли одну запись — сбой").Равно(1);
	Ожидаем.Что(СтрНайти(Записано, "ОбработчикПадающий: намеренный сбой задачи") > 0,
		"сбой виден и без поднятой подробности: " + Записано).ЭтоИстина();

КонецПроцедуры

// Успешный прогон на уровне консоли хаба не пишет НИЧЕГО: ровно та строка, которую
// владелец назвал шумом («Фоновая задача „сброс-статистики“ стартовала»).
&Тест
Процедура НаИнформацииУспешныйПрогонМолчит() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("молча", УровниЛога.Информация, Часы);
	Мир.Планировщик.Настроить();
	ДоПрогона = Мир.Ловушка.Количество();

	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Мир.Обработчики.Статистика.Вызовов(), "задача действительно отработала").Равно(1);
	Ожидаем.Что(Мир.Ловушка.Количество() - ДоПрогона,
		"успешный прогон на ИНФОРМАЦИИ не пишет ни строки: " + Мир.Ловушка.Всё()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ЖивучестьЦикла

// ОСень фоновую рогатку с ОжидатьЗавершения = Ложь не дожидается и её исход не смотрит:
// без перехвата внутри цикл умирает, не оставив в журнале ни строки, а хаб продолжает
// отвечать 200 — планировщик «не работает» ровно так, как это видит владелец.
&Тест
Процедура СмертьФоновогоЦиклаПопадаетВЖурнал() Экспорт

	Мир = НовыйМир("цикл", УровниЛога.Информация, Новый ЧасыПадающие());

	Мир.Планировщик.ПриЗапускеПриложения();

	Ожидаем.Что(СтрНайти(Мир.Ловушка.Всё(), "ЧасыПадающие: намеренный сбой источника времени") > 0,
		"причина смерти фонового цикла названа: " + Мир.Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Обвязка

// Планировщик хаба на ручных часах с ловушкой журнала.
Функция НовыйМир(Знач Прозвище, Знач Уровень, Знач Часы, Знач ЗадачаСтатистики = Неопределено)

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.задачи." + Прозвище);
	// Уровень журнала: то, чего тут нет, оператор в консоли не увидит.
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(Ловушка);

	Обработчики = Новый Структура("Статистика", ?(ЗадачаСтатистики = Неопределено,
		Новый ОбработчикСчётчик(), ЗадачаСтатистики));

	Планировщик = Новый ПланировщикПриложения(Обработчики.Статистика, Новый ОбработчикСчётчик(),
		Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		60, 999999, 3, 999999, 999999, 999999, 999999, 999999, 10, Истина,
		Новый ГотовностьХаба(Лог), Новый ЖурналФоновыхЗадач(Лог), Лог);
	Планировщик.УстановитьЧасы(Часы);

	Возврат Новый Структура("Планировщик, Ловушка, Обработчики", Планировщик, Ловушка, Обработчики);

КонецФункции

Процедура Подключить(Знач ПолныйПуть, Знач ИмяКласса)
	Если НЕ ТипЗарегистрирован(ИмяКласса) Тогда
		ПодключитьСценарий(ПолныйПуть, ИмяКласса);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти
