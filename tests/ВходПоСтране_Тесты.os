// Правило «закрыт в странах» на настоящем хабе (ИСТ-ДОСТ-037, часть 2): провайдер
// с правилом закрыт посетителю, чью страну хаб назвать не смог, — и закрыт целиком,
// на всех дверях сразу. Базу стран хабу подкладывает фикстура: тридцати мегабайт
// настоящей DB-IP в дереве нет и не будет.
//
// Посетитель здесь приходит с петлевого адреса, то есть «своя сеть» — страна неизвестна.
// Доверенных прокси у стенда нет, поэтому подделанный CF-IPCountry снимается с запроса
// и открыть закрытое им нельзя.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент;        // фикстура КлиентХаба
Перем Проба;         // фикстура БазаСтранПробная
Перем Закрытый;      // имя провайдера с правилом
Перем Свободный;     // имя провайдера без правила

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("БазаСтранПробная");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	Проба = Новый БазаСтранПробная();

	Сидер = ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-страна-входа");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	// база стран у стенда есть: без неё атрибуции не печатают, а состояние базы не проверить
	Хаб.Среда("OSHUB_GEO_DB__PATH", ПодложитьБазу());

	Хаб.ЗапуститьСидер(Сидер);
	Хаб.Запустить();

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Свободный = ЗавестиПровайдера(Кука);
	Закрытый = ЗавестиПровайдера(Кука);
	ПоставитьПравило(Закрытый, "RU", Кука);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область СтраницаВхода

// Кнопка и отказ спрашивают одно правило: закрытого провайдера посетитель не видит,
// а свободный остаётся на месте — гейт закрывает адресно, а не всё подряд.
&Тест
Процедура КнопкиЗакрытогоПровайдераНаСтраницеВходаНет() Экспорт

	Страница = Клиент.Тело(Клиент.GET("/login"));

	Ожидаем.Что(СтрНайти(Страница, АдресСтарта(Закрытый)),
		"кнопки закрытого провайдера нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, АдресСтарта(Свободный)) > 0,
		"КОНТРОЛЬ: кнопка свободного провайдера на месте").ЭтоИстина();

КонецПроцедуры

// Запрет держит вход, а не вывод: прямой адрес старта отвечает отказом так же,
// как исчезает кнопка.
&Тест
Процедура ПрямойАдресСтартаОтвечаетОтказом() Экспорт

	Ответ = Клиент.GET(АдресСтарта(Закрытый));

	Ожидаем.Что(Ответ.КодСостояния, "закрытому посетителю — 403").Равно(403);

	Тело = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело, "недоступен из вашего региона") > 0,
		"отказ назвал причину человеческими словами: " + Лев(Тело, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "логину и паролю") > 0,
		"и назвал запасной путь — на этом хабе парольный вход включён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "RU"),
		"кода страны в лоб посетителю не показывают").Равно(0);

КонецПроцедуры

// КОНТРОЛЬ: свободный провайдер стартует как раньше — редиректом к издателю.
&Тест
Процедура СвободныйПровайдерСтартуетКакРаньше() Экспорт

	Ответ = Клиент.GETБезПереходов(АдресСтарта(Свободный));

	Ожидаем.Что(Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400,
		"старт свободного провайдера уводит браузер к издателю").ЭтоИстина();

КонецПроцедуры

// Доверенных прокси у стенда нет, и написать себе страну может кто угодно: заголовок
// снимается с запроса, открыть им закрытое нельзя.
&Тест
Процедура ПодделанныйЗаголовокСтраныЗакрытоеНеОткрывает() Экспорт

	Ответ = Клиент.GET(АдресСтарта(Закрытый), Клиент.Заголовок("CF-IPCountry", "DE"));

	Ожидаем.Что(Ответ.КодСостояния,
		"подделанная страна с недоверенного соединения ничего не меняет").Равно(403);

КонецПроцедуры

#КонецОбласти

#Область Кабинет

// Привязать закрытого провайдера в кабинете тоже нельзя: правило одно на все двери.
&Тест
Процедура ПривязкаЗакрытогоПровайдераВКабинетеОтбита() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	Ответ = Клиент.GETСКукой("/me/settings/oidc/link/" + Закрытый, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "привязка закрыта тем же правилом").Равно(403);

	Тело = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(Тело, "Из вашего региона этого провайдера привязать нельзя") > 0,
		"отказ кабинета говорит про привязку, а не про вход").ЭтоИстина();
	// вошедшего незачем звать к форме входа и к восстановлению пароля: он уже вошёл
	Ожидаем.Что(СтрНайти(Тело, "логину и паролю"),
		"про парольный вход в кабинете не говорим").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "форма на этой странице"),
		"и к несуществующей здесь форме не отправляем").Равно(0);

	Раздел = Клиент.Тело(Клиент.GETСКукой("/me/settings/oidc", Кука));
	Ожидаем.Что(СтрНайти(Раздел, "/link/" + Закрытый),
		"кнопки привязки закрытого провайдера в кабинете нет").Равно(0);
	Ожидаем.Что(СтрНайти(Раздел, "/link/" + Свободный) > 0,
		"КОНТРОЛЬ: свободный провайдер привязывается").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Атрибуция

// Условие лицензии CC BY 4.0: ссылка стоит на страницах, которые пользуются результатом,
// — пока правило есть и база загружена.
&Тест
Процедура АтрибуцияБазыСтоитНаСтраницахПользующихсяРезультатом() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(ЕстьАтрибуция(Клиент.Тело(Клиент.GET("/login"))),
		"страница входа несёт ссылку DB-IP").ЭтоИстина();
	Ожидаем.Что(ЕстьАтрибуция(Клиент.Тело(Клиент.GETСКукой("/me/settings/oidc", Кука))),
		"и привязка в кабинете").ЭтоИстина();
	Ожидаем.Что(ЕстьАтрибуция(Клиент.Тело(Клиент.GET(АдресСтарта(Закрытый)))),
		"и экран отказа").ЭтоИстина();

КонецПроцедуры

// База у стенда лежит и индекс по ней построен: окно показывает её состояние, не жалуется
// на пропажу и не пугает «закрывает всем» — вход по этому индексу работает.
&Тест
Процедура ОкноПравилаПоказываетСостояниеЛежащейБазы() Экспорт

	Окно = ОкноПравила(Закрытый);

	Ожидаем.Что(СтрНайти(Окно, "База стран:") > 0,
		"состояние базы названо: " + Лев(Окно, 200)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "Файла базы стран нет"),
		"жалобы на пропажу файла нет").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, "закрывает провайдера ВСЕМ"),
		"индекс жив — «закрывает всем» не печатаем").Равно(0);

КонецПроцедуры

// «Заперся сам» разбирается этой строкой: окно печатает, какой страной хаб видит запрос
// САМОГО администратора, тем же определителем, каким судит посетителей. Стенд отвечает
// с петли, поэтому страна не определится — и окно обязано назвать настройку прокси.
&Тест
Процедура ОкноПравилаНазываетСтрануЗапросаАдминистратора() Экспорт

	Окно = ОкноПравила(Закрытый);

	Ожидаем.Что(СтрНайти(Окно, "Страна вашего запроса") > 0,
		"строка про свой запрос напечатана: " + Лев(Окно, 200)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "не определена") > 0,
		"с петли страна не определяется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "trusted_proxies") > 0,
		"и названа настройка, из-за которой так бывает за прокси").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ПодложитьБазу()

	Куда = ОбъединитьПути(УникальныеИмена.ВременныйКаталог("гео-стенд"),
		"dbip-country-lite.csv");
	Возврат Проба.Положить(Куда);

КонецФункции

Функция ОкноПравила(Знач Имя)

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Возврат Клиент.Тело(Клиент.GETСКукой("/hub/settings/providers?countries=" + Имя, Кука));

КонецФункции

Функция АдресСтарта(Знач Имя)
	Возврат "/login/oidc/" + Имя;
КонецФункции

// Токен формы: имя и значение в разметке стоят не вплотную, между ними атрибут типа.
Функция ИзвлечьCSRF(Знач HTML)

	Позиция = СтрНайти(HTML, "name=""_csrf""");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Позиция);
	ПозицияЗначения = СтрНайти(Хвост, "value=""");
	Если ПозицияЗначения = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Хвост, ПозицияЗначения + 7);
	Кавычка = СтрНайти(Остаток, """");
	Возврат ?(Кавычка = 0, "", Лев(Остаток, Кавычка - 1));

КонецФункции

Функция ЕстьАтрибуция(Знач HTML)
	Возврат СтрНайти(HTML, "IP Geolocation by DB-IP") > 0
		И СтрНайти(HTML, "https://db-ip.com") > 0;
КонецФункции

Функция ЗавестиПровайдера(Знач Кука)

	Имя = УникальныеИмена.Имя("geo");
	HTML = Клиент.Тело(Клиент.GETСКукой("/hub/settings/providers?preset=github", Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("пресет", "github");
	Поля.Вставить("клиент", "Iv1.abcdef");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");

	Ответ = Клиент.POSTФормы("/hub/settings/providers", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"провайдер стенда заведён: " + Лев(Клиент.Тело(Ответ), 300)).ЭтоИстина();
	Возврат Имя;

КонецФункции

Процедура ПоставитьПравило(Знач Имя, Знач Страны, Знач Кука)

	Адрес = "/hub/settings/providers?countries=" + Имя;
	HTML = Клиент.Тело(Клиент.GETСКукой(Адрес, Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(HTML));
	Поля.Вставить("страны", Страны);

	Ответ = Клиент.POSTФормы("/hub/settings/providers/" + Имя + "/countries", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400, "правило стенда поставлено").ЭтоИстина();

КонецПроцедуры

#КонецОбласти
