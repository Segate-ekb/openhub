	Хранения.Добавить(Проба);
	Рендеры = Новый Массив();
	Рендеры.Добавить(Новый РендерНастроекВебхука());

	Ошибка = "";
	Попытка
		Форма(Новый РеестрДействийПодписок(Доставки, Хранения, Рендеры)).Разобрать(
			Разбор.Разобрать("тип_действия=проба.безформы&канал=alpha"));
	Исключение
		Ошибка = ОписаниеОшибки();
