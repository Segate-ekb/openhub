// Юнит-тесты слоя представления подписок: форма собирается ИЗ ДЕКЛАРАЦИИ ОБРАБОТЧИКА — поля боевых типов
// и стороннего типа из фикстуры, сторож имён полей, секрет не печатается, подписи из словаря.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем UI;              // фикстура СборкаUI — кит компонентов, словарь, резолвер текстов
Перем Разбор;          // РазборФормы
Перем КаталогПроекта;
Перем КаталогФикстур;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Собрать() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	КаталогОбщего = ОбъединитьПути(КаталогWebUI, "общее");
	КаталогНастроек = ОбъединитьПути(КаталогWebUI, "настройки", "общее");
	КаталогОбработчиков = ОбъединитьПути(КаталогМодулей, "подписки", "Классы", "обработчики");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(КаталогWebUI);

	ПоискКлассов.Подключить(КаталогОбщего, "РазборФормы");
	// ЗащитаCSRF нужна рендереру только ради ИМЕНИ поля токена — службы сессий этот путь не касается
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	ПоискКлассов.Подключить(КаталогНастроек, "ФормаДействияПодписки");
	ПоискКлассов.Подключить(КаталогНастроек, "ВитринаПодписок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"),
		"РеестрДействийПодписок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"),
		"ШаблонУведомления");

	Вебхук = ОбъединитьПути(КаталогОбработчиков, "вебхук");
	ПоискКлассов.Подключить(Вебхук, "РендерНастроекВебхука");
	Телеграм = ОбъединитьПути(КаталогОбработчиков, "telegram");
	ПоискКлассов.Подключить(Телеграм, "РендерНастроекTelegram");

	ПоискКлассов.Подключить(КаталогФикстур, "ПробныйТипДействия");
	ПоискКлассов.Подключить(КаталогФикстур, "ТощийРендерНастроек");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкСервисПодписок");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкКаталогСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"), "ПараметрыПодписки");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкХранилищеВебхуков");
	ПоискКлассов.Подключить(КаталогФикстур, "ФейкВебхукЗапись");

	Разбор = Новый РазборФормы();

КонецПроцедуры

#Область ФормаИзДекларации

&Тест
Процедура ФормаРисуетПоляТолькоВыбранногоТипа() Экспорт

	// имена полей перечислены ЗДЕСЬ руками: тест, читающий ту же декларацию, зеленел бы и на удалении поля
	Вебхук = Форма(Реестр()).Поля("вебхук").Рендер();

	Ожидаем.Что(СтрНайти(Вебхук, "name=""тип_действия"" value=""вебхук""") > 0,
		"выбранный тип едет скрытым полем формы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вебхук, "name=""url""") > 0, "поле url вебхука").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вебхук, "name=""секрет""") > 0, "поле секрета вебхука").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вебхук, "name=""chat-id"""),
		"полей чужого типа на форме нет вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(Вебхук, "Вебхук (HTTP POST)") > 0, "подпись типа «вебхук» из словаря").ЭтоИстина();

	Телеграм = Форма(Реестр()).Поля("telegram").Рендер();

	Ожидаем.Что(СтрНайти(Телеграм, "name=""chat-id""") > 0, "поле chat-id telegram").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Телеграм, "name=""бот-токен""") > 0, "поле своего токена бота").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Телеграм, "name=""шаблон-текста""") > 0, "поле своего текста").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Телеграм, "name=""url"""), "поля вебхука на форме telegram нет").Равно(0);
	Ожидаем.Что(СтрНайти(Телеграм, "Чат или канал") > 0, "подпись поля telegram из словаря").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Вебхук + Телеграм, "[?") = 0, "ни одного маркера потерянного ключа").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестныйИПустойТипДаютПервыйНаборПолей() Экспорт

	// прямая ссылка без параметра и подделанный параметр обязаны дать рабочую форму, а не пустой экран
	Форма = Форма(Реестр());
	Первый = Форма.Типы()[0].Тип;

	Ожидаем.Что(Форма.ВыбранныйТип(""), "пустой тип — первый набор полей").Равно(Первый);
	Ожидаем.Что(Форма.ВыбранныйТип("голубиная.почта"), "неизвестный тип — тоже первый").Равно(Первый);
	Ожидаем.Что(Форма.ВыбранныйТип(" TELEGRAM "), "регистр и пробелы нормализованы").Равно("telegram");

	Ожидаем.Что(СтрНайти(Форма.Поля("").Рендер(), "name=""тип_действия"" value=""" + Первый + """") > 0,
		"форма по умолчанию честно объявляет, чей набор полей показан").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НовыйТипРисуетсяФормойБезПравкиЭкранов() Экспорт

	// тип, которого не знает ни форма, ни витрина, ни пульт, приезжает одной фикстурой и получает свои поля
	Проба = Новый ПробныйТипДействия("проба.форма", "канал");
	Форма = Форма(РеестрС(Проба));
	HTML = Форма.Поля("проба.форма").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "name=""канал""") > 0,
		"поле стороннего типа нарисовано по его декларации").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-action-type=""проба.форма""") > 0,
		"группа полей стороннего типа помечена его типом").ЭтоИстина();
	Ожидаем.Что(СодержитТип(Форма.Типы(), "проба.форма"),
		"сторонний тип попал в переключатель типов").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "[?probe.action.проба.форма.label]") > 0,
		"подпись берётся ПО КЛЮЧУ декларации: нет ключа — виден маркер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТипБезРендераВФормуНеПопадает() Экспорт

	// реестр допускает тип без рендера настроек; форма показать его не может — полей нет, «создать» ушло бы пустым вводом
	Проба = Новый ПробныйТипДействия("проба.безформы", "канал");

	Доставки = Новый Массив();
	Доставки.Добавить(Проба);
	Хранения = Новый Массив();
	Хранения.Добавить(Проба);
	Реестр = Новый РеестрДействийПодписок(Доставки, Хранения, Новый Массив());

	HTML = Форма(Реестр).Поля("").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "проба.безформы"), "тип без рендера в форму не попал").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Ни один тип действия не заявил формы") > 0,
		"вместо пустой формы — честное объяснение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекретноеПолеВводитсяПаролем() Экспорт

	HTML = Форма(Реестр()).Поля("вебхук").Рендер();

	Позиция = СтрНайти(HTML, "name=""секрет""");
	Ожидаем.Что(Позиция > 0, "поле секрета есть").ЭтоИстина();

	// тип берём у ТОГО ЖЕ <input>: «где-то на странице есть password» ничего не значит
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Тег = Сред(HTML, Начало, СтрНайти(Сред(HTML, Начало), ">"));

	Ожидаем.Что(СтрНайти(Тег, "type=""password""") > 0,
		"секретное поле декларации рисуется вводом пароля").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбязательностьНеПечатаетсяАтрибутомRequired() Экспорт

	// проверку обязательности держит сервер: браузерная не заменяет её и расходилась бы с ней
	HTML = Форма(Реестр()).Поля("telegram").Рендер() + Форма(Реестр()).Поля("вебхук").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "required"),
		"обязательность проверяется на сервере, а не атрибутом формы").Равно(0);

КонецПроцедуры

&Тест
Процедура ПлагинБезПоловиныКонтрактаРоняетСборкуАНеЭкран() Экспорт

	// плагин, написанный по шапке реестра (без КлючПодписи/КлючПояснения), собирался молча и ронял раздел 500;
	// правильное место отказа — СБОРКА ЖЕЛУДЯ
	Тощий = Новый ТощийРендерНастроек();

	Ошибка = "";
	Попытка
		Форма(РеестрС(Тощий));
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	// ассерты — ПОСЛЕ Попытки (упавший ассерт внутри неё сам стал бы «ошибкой сборки»)
	Ожидаем.Что(ЗначениеЗаполнено(Ошибка),
		"неполный рендер роняет сборку желудя, а не отрисовку страницы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "не выполняет контракт") > 0,
		"причина названа словами, а не стеком платформы: " + Ошибка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "ревью.тощий") > 0,
		"назван ТИП, чей плагин неполон").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "КлючПодписи") > 0,
		"назван весь контракт, чтобы автор плагина понял, чего не хватает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИменаПолейРазделаБерутсяУВладельцаАНеИзЛитералов() Экспорт

	// имена флажков событий объявляет владелец (ФормаДействияПодписки): проверяем СВЯЗЬ, а не совпадающие литералы
	ФормаДействия = Форма(Реестр());
	Витрина = Новый ВитринаПодписок(UI.Кит, UI.РендерерНастроек,
		ВитринаСервис("https://hook.example.com/a", "вебхук", ""),
		Новый ФейкКаталогСобытий(), Новый ПараметрыПодписки(Новый ФейкКаталогСобытий()),
		ФормаДействия, UI.Тексты, Разбор);

	HTML = ТелоСекций(Витрина.Секции(ПараметрыРаздела("")));

	Ожидаем.Что(СтрНайти(HTML, "name=""" + ФормаДействия.ИмяПоляСобытия(0) + """") > 0,
		"флажок события назван именем владельца").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""" + ФормаДействия.ИмяПоляВключить() + """") > 0,
		"тумблер назван именем владельца").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""" + ФормаДействия.ИмяПоляТипа() + """") > 0,
		"селектор типа назван именем владельца").ЭтоИстина();

	Занятые = Новый Массив();
	Занятые.Добавить(ФормаДействия.ИмяПоляТипа());
	Занятые.Добавить(ФормаДействия.ИмяПоляВключить());
	Занятые.Добавить(ФормаДействия.ИмяПоляСобытия(0));
	Занятые.Добавить(Новый ЗащитаCSRF(Неопределено).ИмяПоля());

	Уцелевшие = Новый Массив();
	Для Каждого Имя Из Занятые Цикл
		Ошибка = "";
		Попытка
			Форма(РеестрС(Новый ПробныйТипДействия("проба." + Имя, Имя)));
		Исключение
			Ошибка = ОписаниеОшибки();
		КонецПопытки;
		Если СтрНайти(Ошибка, "служебное имя поля") = 0 Тогда
			Уцелевшие.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Уцелевшие, ", "),
		"каждое имя, объявленное владельцем, для типов закрыто").Равно("");

КонецПроцедуры

&Тест
Процедура ПодписиПолейВсехТиповЖивутВСловаре() Экспорт

	// подпись, вписанную строкой вместо ключа, видно сразу: резолвер вернёт маркер
	Реестр = Реестр();
	Плохие = Новый Массив();

	Для Каждого Тип Из Реестр.Типы() Цикл
		Рендер = Реестр.РендерНастроек(Тип);
		Если Рендер = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПроверитьКлюч(Плохие, Тип + "/тип", Рендер.КлючПодписи(), Истина);
		ПроверитьКлюч(Плохие, Тип + "/пояснение", Рендер.КлючПояснения(), Ложь);
		Для Каждого Поле Из Рендер.ОписаниеПолей() Цикл
			ПроверитьКлюч(Плохие, Тип + "/" + Поле.Имя, Поле.КлючПодписи, Истина);
			ПроверитьКлюч(Плохие, Тип + "/" + Поле.Имя + ".hint", Поле.КлючПодсказки, Ложь);
			ПроверитьКлюч(Плохие, Тип + "/" + Поле.Имя + ".ph", Поле.КлючПлейсхолдера, Ложь);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Плохие, "; "),
		"подписи полей деклараций: ключ словаря, а не строка и не потерянный ключ").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СторожИмёнПолей

&Тест
Процедура ДубльИмениПоляСредиТиповРоняетСборку() Экспорт

	// два значения под одним именем: разбор возьмёт одно, и подписка тихо создастся с чужими настройками
	Проба = Новый ПробныйТипДействия("проба.дубль", "url");

	Ошибка = "";
	Попытка
		Форма(РеестрС(Проба));
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка), "сборка формы упала на дубле имени поля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ошибка, "объявлено дважды") > 0,
		"причина названа: имя поля занято другим типом").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РазборФормы

&Тест
Процедура РазборОтдаётВводВыбранногоТипа() Экспорт

	Разобрано = Форма(Реестр()).Разобрать(
		Разбор.Разобрать("тип_действия=telegram&chat-id=%40mychannel&бот-токен=42%3AAAFukAn-token"));

	Ожидаем.Что(Разобрано.ТипДействия, "тип взят из скрытого поля формы").Равно("telegram");
	Ожидаем.Что(Разобрано.Ввод.ЧатИд, "chat-id доехал под доменным именем ввода").Равно("@mychannel");
	Ожидаем.Что(Разобрано.Ввод.Свойство("URL"),
		"поле ЧУЖОГО типа во ввод не попало: адресат telegram — не URL вебхука").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗаполненноеПолеЧужогоТипаОтбиваетсяСервером() Экспорт

	// форма выбранного типа поля чужого не показывает — значит и не принимает: иначе
	// подделанный POST завёл бы подписку, не похожую на то, что видел администратор
	Форма = Форма(Реестр());

	ЧужойURL = "";
	Попытка
		Форма.Разобрать(Разбор.Разобрать("тип_действия=telegram&chat-id=%40mychannel"
			+ "&бот-токен=42%3AAAFukAn-token&url=https%3A%2F%2Fx.example.com"));
	Исключение
		ЧужойURL = ОписаниеОшибки();
	КонецПопытки;

	ЧужойЧат = "";
	Попытка
		Форма.Разобрать(Разбор.Разобрать(
			"тип_действия=вебхук&url=https%3A%2F%2Fx.example.com&chat-id=12345"));
	Исключение
		ЧужойЧат = ОписаниеОшибки();
	КонецПопытки;

	ЧужойТокен = "";
	Попытка
		Форма.Разобрать(Разбор.Разобрать(
			"тип_действия=вебхук&url=https%3A%2F%2Fx.example.com&бот-токен=1%3Aабвгдеёжзий"));
	Исключение
		ЧужойТокен = ОписаниеОшибки();
	КонецПопытки;

	// ассерты — ПОСЛЕ Попыток: упавший ассерт внутри неё сам стал бы «ошибкой разбора»
	Ожидаем.Что(СтрНайти(ЧужойURL, "не относится к действию") > 0,
		"url в форме telegram отбит: " + ЧужойURL).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЧужойURL, "Адрес доставки") > 0,
		"названо ИМЕННО ТО поле, которое лишнее").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЧужойЧат, "не относится к действию") > 0,
		"chat-id в форме вебхука отбит: " + ЧужойЧат).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЧужойТокен, "не относится к действию") > 0,
		"чужой токен бота не подсовывается вебхуку: " + ЧужойТокен).ЭтоИстина();

