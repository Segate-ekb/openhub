&Тест
Процедура ПереключательТиповРаботаетБезJS() Экспорт

	// у каждого набора полей свой адрес: страница живёт ссылками, а не обработчиком onchange
	Витрина = Витрина(ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	HTML = ТелоСекций(Витрина.Секции(ПараметрыРаздела("")));

	Ожидаем.Что(СтрНайти(HTML, "/main/settings/webhooks?kind=telegram") > 0,
		"ссылка на набор полей telegram").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "?kind=%D0%B2%D0%B5%D0%B1%D1%85%D1%83%D0%BA") > 0,
		"ссылка на набор полей вебхука (тип кодирован для строки запроса)").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "onclick"), "переключение без обработчиков в разметке").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "и без скриптов").Равно(0);

	// форму заведения смотрим отдельно от карточек: у карточки вебхука поле url законное
	Заведение = ХвостПосле(ТелоСекций(Витрина.Секции(ПараметрыРаздела("", "telegram"))),
		"choice-row");
	Ожидаем.Что(СтрНайти(Заведение, "name=""тип_действия"" value=""telegram""") > 0,
		"выбранный ссылкой тип попадает в форму").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заведение, "name=""url"""), "и полей другого типа на ней нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ТокенБотаИШаблонПодпискиНеПопадаютВРазметку() Экспорт

	// токен чужого бота — секрет того же рода, что секрет клиента провайдера входа:
	// в разметке от него остаётся только признак «задан»
	Токен = "424242:ТОКЕН-ЧУЖОГО-БОТА-ХХХ";
	Витрина = Витрина(ВитринаСервис("@channel", "telegram", "", Токен, "{пакет} у {пул}"));

	HTML = ТелоСекций(Витрина.Секции(ПараметрыРаздела("", "telegram")));

	Ожидаем.Что(СтрНайти(HTML, Токен), "токен подписки в разметку не попадает").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "ТОКЕН-ЧУЖОГО-БОТА"), "и обрывком тоже").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "{пакет} у {пул}"), "чужой шаблон текста наружу не отдаётся").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "свой бот") > 0, "но признак «свой бот» в списке виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "свой текст") > 0, "и признак «свой текст» тоже").ЭтоИстина();

	// поле ввода токена пустое: маска живёт в подсказке, а не в значении
	Позиция = СтрНайти(HTML, "name=""бот-токен""");
	Ожидаем.Что(Позиция > 0, "поле токена на форме есть").ЭтоИстина();
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Тег = Сред(HTML, Начало, СтрНайти(Сред(HTML, Начало), ">"));
	Ожидаем.Что(СтрНайти(Тег, "type=""password""") > 0, "токен вводится паролем").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тег, "value="""""), "и без предзаполненного значения").Равно(0);

КонецПроцедуры

&Тест
Процедура ПодсказкаШаблонаПеречисляетВсеПлейсхолдеры() Экспорт

	// список рядом с полем — единственное место, где пользователь узнаёт допустимые имена;
	// разъехавшийся с кодом список хуже отсутствующего
	Шаблоны = Новый ШаблонУведомления(Неопределено);
	Подсказка = UI.Тексты.Текст("subscriptions.telegram.template.hint");

	Пропущенные = Новый Массив();
	Для Каждого Имя Из Шаблоны.Плейсхолдеры() Цикл
		Если СтрНайти(Подсказка, "{" + Имя + "}") = 0 Тогда
			Пропущенные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "),
		"плейсхолдеры, о которых подсказка поля молчит").Равно("");

КонецПроцедуры

&Тест
Процедура ТаблицыПеречняСобытийНаФормеНет() Экспорт

	// перечень дублировал флажки и предлагал внутренние события, на которые подписаться нельзя;
	// полезное из него — «когда возникает» — переехало подсказкой к флажку
	Витрина = Витрина(ВитринаСервис("https://hook.example.com/a", "вебхук", ""));
	Секции = Витрина.Секции(ПараметрыРаздела(""));

	Ожидаем.Что(Секции.Количество(), "секция раздела осталась одна").Равно(1);

	HTML = ТелоСекций(Секции);
	Ожидаем.Что(СтрНайти(HTML, "События хаба"), "таблицы перечня на форме нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Внутреннее событие"),
		"внутреннее событие на форме подписки не предлагается вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "В пул принята новая версия пакета.") > 0,
		"«когда возникает» видно подсказкой у флажка события").ЭтоИстина();

