	Ожидаем.Что(СтрНайти(HTML, "/main/settings/webhooks/7/toggle") > 0, "тумблер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "/main/settings/webhooks/7/delete") > 0, "удаление").ЭтоИстина();

	// тип на правке не меняется: он едет скрытым полем, а форма говорит об этом словами
