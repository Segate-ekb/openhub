		"тип_действия=telegram&chat-id=%D0%BD%D0%B5-%D1%87%D0%B0%D1%82"
		+ "&бот-токен=424242%3ATOKEN-iz-otklonyonnoy-formy"
		+ "&%D1%88%D0%B0%D0%B1%D0%BB%D0%BE%D0%BD-%D1%82%D0%B5%D0%BA%D1%81%D1%82%D0%B0={пакет}"
		+ "&%D1%81%D0%BE%D0%B1%D1%8B%D1%82%D0%B8%D0%B5_0=1"));
	HTML = ТелоСекций(Витрина.Секции(Параметры));

	Ожидаем.Что(СтрНайти(HTML, "value=""не-чат""") > 0, "адресат вернулся в форму").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "{пакет}</textarea>") > 0, "и набранный шаблон тоже").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "TOKEN-iz-otklonyonnoy-formy"),
		"а токен на страницу не возвращается").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "введите его заново") > 0,
		"и об этом честно сказано рядом с полем").ЭтоИстина();

