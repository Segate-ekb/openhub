// Самотест фикстуры СтендПубликации: на ней стоят наборы доверия конвейерам CI и ревью
// заявок. Стенд, который «завёл» имя, не заведя его, делает эти наборы зелёными на пустом
// реестре. Проверяется не фикстура на себе, а то, ЧТО ВИДЯТ службы хаба после стенда:
// пул, роль мейнтейнера, найденный пакет и опубликованная версия.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;     // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;             // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;          // общий контейнер на все тесты набора
Перем Стенд;            // фикстура СтендПубликации — пул, мейнтейнер и заведённое имя
Перем КореньХранилища;  // временный корень файлового хранилища артефактов
Перем КаталогСборки;    // временный каталог сборки .ospx

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПубликации");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	ПодключитьСлоиПубликации(Модули);

	КореньХранилища = ВременныйКаталог("oshub-стенд-публикации-");
	КаталогСборки = ВременныйКаталог("oshub-сборка-публикации-");

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "стенд-публикации-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("стенд-публикации-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Стенд = Новый СтендПубликации(Поделка, КаталогСборки);

КонецПроцедуры

&ПослеВсех
Процедура УбратьВременное() Экспорт

	Убрать(КореньХранилища);
	Убрать(КаталогСборки);

КонецПроцедуры

// Публикация тянет за собой весь путь push: реестр, хранилище артефактов, права
// и учётки — стенд обязан собираться на том же наборе классов, что и продукт.
Процедура ПодключитьСлоиПубликации(Знач Модули)

	Слои.Подключить("данные");
	Слои.Подключить("хранилище, публикация, реестр, основа, наблюдаемость/телеметрия, события");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));

	Слои.Подключить("почта");
	Слои.Подключить("уведомления, вход, права, настройки");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

КонецПроцедуры

#Область ПулСМейнтейнером

&Тест
Процедура ПулЗаводитсяСлужбойИМейнтейнерПолучаетРольВладельца() Экспорт

	Пара = Стенд.ПулСМейнтейнером();

	Ожидаем.Что(Желудь("СервисПулов").НайтиПул(Пара.Пул.Имя), "пул заведён хабом").Существует();
	Ожидаем.Что(Желудь("ХранилищеУчастниковПула").НайтиРоль(
		Пара.Пул.Идентификатор, "пользователь", Пара.Мейнтейнер.Идентификатор).Роль,
		"мейнтейнер — владелец пула").Равно("owner");

КонецПроцедуры

// Приставка — то, по чему набор узнаёт свой стенд среди чужих пулов в общей базе.
&Тест
Процедура ПриставкаПопадаетВИмяПула() Экспорт

	Пара = Стенд.ПулСМейнтейнером("selftest");

	Ожидаем.Что(СтрНачинаетсяС(Пара.Пул.Имя, "selftestpool-"),
		СтрШаблон("имя пула: %1", Пара.Пул.Имя)).ЭтоИстина();

КонецПроцедуры

// Два стенда подряд — два разных пула: набор заводит их пачками и имён им не придумывает.
&Тест
Процедура ДваПулаПодрядНеСталкиваются() Экспорт

	Ожидаем.Что(Стенд.ПулСМейнтейнером().Пул.Имя <> Стенд.ПулСМейнтейнером().Пул.Имя,
		"два стенда — два пула").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Публикация

// Публикация — не украшение стенда: после неё в реестре есть пакет с версией, а в пуле
// занято место. Пакет, «заведённый» без публикации, ведёт себя в наборах доверия иначе.
&Тест
Процедура ПубликацияЗаводитПакетИВерсиюВНазванномПуле() Экспорт

	Пара = Стенд.ПулСМейнтейнером();

	Итог = Стенд.Опубликовать(Пара.Пул, Пара.Мейнтейнер, "selftest-publish", "2.3.4");

	Ожидаем.Что(Итог.Успех, "публикация удалась: " + Строка(Итог.Сообщение)).ЭтоИстина();
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пара.Пул.Идентификатор, "selftest-publish");
	Ожидаем.Что(Пакет, "пакет виден службе").Существует();
	Опубликованные = Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор);
	Ожидаем.Что(Опубликованные.Количество(), "версия одна").Равно(1);
	Ожидаем.Что(Опубликованные[0].Версия, "названный номер версии").Равно("2.3.4");

КонецПроцедуры

// Замена уже опубликованного номера — отдельный параметр двери: без него хаб отказывает,
// с ним переписывает. Набор, проверяющий «?force=1», обязан видеть разницу.
&Тест
Процедура ПовторныйНомерОтвергаетсяАСЗаменойПроходит() Экспорт

	Пара = Стенд.ПулСМейнтейнером();
	Стенд.Опубликовать(Пара.Пул, Пара.Мейнтейнер, "selftest-repeat", "1.0.0");

	Повтор = Стенд.Опубликовать(Пара.Пул, Пара.Мейнтейнер, "selftest-repeat", "1.0.0");
	Замена = Стенд.Опубликовать(Пара.Пул, Пара.Мейнтейнер, "selftest-repeat", "1.0.0", Истина);

	Ожидаем.Что(Повтор.Успех, "тот же номер без замены не публикуется").ЭтоЛожь();
	Ожидаем.Что(Замена.Успех, "с заменой публикуется: " + Строка(Замена.Сообщение)).ЭтоИстина();

КонецПроцедуры

// Автор публикации — параметр, а не догадка: у чужака прав на пул нет, и его push уходит
// во «входящие» заявкой, а не в реестр. Набор, перепутавший автора, проверял бы не тот путь.
&Тест
Процедура АвторПубликацииДоезжаетДоХаба() Экспорт

	Пара = Стенд.ПулСМейнтейнером();
	Чужак = Новый СтендУчёток(Поделка).Учётка();

	Итог = Стенд.Опубликовать(Пара.Пул, Чужак, "selftest-outsider", "1.0.0");

	Ожидаем.Что(Итог.Код, "заявка чужака принята во «входящие»").Равно(202);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пара.Пул.Идентификатор, "selftest-outsider"),
		"и пакет в реестре не появился").Равно(Неопределено);

	// КОНТРОЛЬ: тот же вызов от мейнтейнера стенда имя заводит
	Стенд.Опубликовать(Пара.Пул, Пара.Мейнтейнер, "selftest-owner", "1.0.0");
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пара.Пул.Идентификатор, "selftest-owner"),
		"публикация мейнтейнера заводит имя").Существует();

КонецПроцедуры

#КонецОбласти

#Область ЗаведённоеИмя

&Тест
Процедура ЗаведённоеИмяСвязываетПулМейнтейнераИПакет() Экспорт

	Стенд_ = Стенд.ЗаведённоеИмя("selfname");

	Ожидаем.Что(Стенд_.Пакет, "пакет найден службой").Существует();
	Ожидаем.Что(Цел(Стенд_.Пакет.ПулИдентификатор), "пакет в своём пуле")
		.Равно(Цел(Стенд_.Пул.Идентификатор));
	Ожидаем.Что(Стенд_.Пакет.ИмяНижнийРегистр, "имя пакета в каноне")
		.Равно(НРег(Стенд_.ИмяПакета));
	Ожидаем.Что(Желудь("ХранилищеУчастниковПула").НайтиРоль(
		Стенд_.Пул.Идентификатор, "пользователь", Стенд_.Мейнтейнер.Идентификатор),
		"мейнтейнер стенда — участник его пула").Существует();

КонецПроцедуры

// Номер первой версии — параметр: наборы срока действия клейма ставят стенд на своей
// версии, а не на «1.0.0».
&Тест
Процедура НомерПервойВерсииЗадаётсяДверью() Экспорт

	Стенд_ = Стенд.ЗаведённоеИмя("selfversion", "0.9.1");

	Опубликованные = Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(
		Стенд_.Пакет.Идентификатор);
	Ожидаем.Что(Опубликованные.Количество(), "версия одна").Равно(1);
	Ожидаем.Что(Опубликованные[0].Версия, "номер названной версии").Равно("0.9.1");

КонецПроцедуры

// Два стенда одной приставки не сталкиваются ни пулами, ни именами пакетов: набор ставит
// их подряд в одной базе.
&Тест
Процедура ДваСтендаОднойПриставкиНеСталкиваются() Экспорт

	Первый = Стенд.ЗаведённоеИмя("selfpair");
	Второй = Стенд.ЗаведённоеИмя("selfpair");

	Ожидаем.Что(Первый.Пул.Имя <> Второй.Пул.Имя, "разные пулы").ЭтоИстина();
	Ожидаем.Что(Первый.ИмяПакета <> Второй.ИмяПакета, "разные имена пакетов").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция ВременныйКаталог(Знач Приставка)
	Путь = ОбъединитьПути(КаталогВременныхФайлов(),
		Приставка + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Путь);
	Возврат Путь;
КонецФункции

Процедура Убрать(Знач Путь)
	Попытка
		Если ЗначениеЗаполнено(Путь) И Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры
