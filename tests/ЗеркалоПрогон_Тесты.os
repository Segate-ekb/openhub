// Юнит-тесты ПрогонаЗеркала (модуль зеркала) на фейковом хранилище: захват прогона и защита
// от двойного запуска, отвисание брошенного прогона, курсор, дросселирование прогресса.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогMirror;
Перем КаталогCommon;
Перем КаталогФикстур;
Перем Хранилище_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогMirror = ОбъединитьПути(КаталогМодулей, "зеркала", "Классы");
	КаталогCommon = ОбъединитьПути(КаталогМодулей, "основа", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогMirror, "ПрогонЗеркала");
	ПоискКлассов.Подключить(КаталогMirror, "ДроссельПрогресса");
	ПоискКлассов.Подключить(КаталогMirror, "ЧислаЗеркалирования");
	ПоискКлассов.Подключить(КаталогMirror, "СчётчикиОбхода");
	ПоискКлассов.Подключить(КаталогMirror, "СрезОбхода");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "НастройкиЗаглушка.os"));
	ПоискКлассов.Подключить(КаталогCommon, "ПриведениеЧисел");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкХранилищеЗеркал.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкЗеркалоЗапись.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ЧасыРучные.os"));
КонецПроцедуры

&ПередКаждым
Процедура НовоеХранилище() Экспорт
	Хранилище_ = Новый ФейкХранилищеЗеркал();
КонецПроцедуры

&Тест
Процедура НетронутоеЗеркалоПростаивает() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Состояние, "новое зеркало простаивает").Равно("простаивает");
	Ожидаем.Что(Состояние.Идёт, "и не идёт").ЭтоЛожь();
	Ожидаем.Что(Состояние.Курсор, "курсора нет — обход начнётся с начала").Равно("");

КонецПроцедуры

&Тест
Процедура СостояниеНеизвестногоЗеркалаНеопределено() Экспорт
	Ожидаем.Что(НовыйПрогон().Состояние(4242), "неизвестное зеркало").Равно(Неопределено);
КонецПроцедуры

// Инвариант «одновременно идёт не более одного прогона на зеркало» держит приложение,
// а не база: кнопка и расписание могут совпасть на любом бэкенде.
&Тест
Процедура ВторойЗахватПокаПервыйИдётОтклонён() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();

	Первый = Прогон.Занять(Зеркало.Идентификатор);
	Второй = Прогон.Занять(Зеркало.Идентификатор);

	Ожидаем.Что(Первый.Занят, "первый захват состоялся").ЭтоИстина();
	Ожидаем.Что(Второй.Занят, "второй отклонён").ЭтоЛожь();
	Ожидаем.Что(Второй.Причина, "и назвал причину").Равно("идёт");
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Идёт, "зеркало помечено идущим").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗахватНеизвестногоЗеркалаОтклонён() Экспорт
	Ответ = НовыйПрогон().Занять(4242);
	Ожидаем.Что(Ответ.Занят, "захватывать нечего").ЭтоЛожь();
	Ожидаем.Что(Ответ.Причина, "причина названа").Равно("нет записи");
КонецПроцедуры

// Процесс может умереть в состоянии «идёт»: без отвисания зеркало заперто навсегда.
&Тест
Процедура БрошенныйПрогонПерехватываетсяПоПорогуМолчания() Экспорт

	Прогон = НовыйПрогонСПорогом(60);
	Зеркало = НовоеЗеркало();
	Зеркало.СостояниеПрогона = "идёт";
	Зеркало.ПрогонКурсор = "остановились-тут";
	Зеркало.ПрогонОбновлён = ТекущаяУниверсальнаяДата() - 61;
	Зеркало.Сохранить();

	Ответ = Прогон.Занять(Зеркало.Идентификатор);

	Ожидаем.Что(Ответ.Занят, "брошенный прогон перехвачен").ЭтоИстина();
	Ожидаем.Что(Ответ.Курсор, "и продолжится с его курсора").Равно("остановились-тут");

КонецПроцедуры

// Граница «молчит ровно порог» проверяется УПРАВЛЯЕМЫМИ часами: на системных секунда
// расхождения между подготовкой записи и захватом делает границу недостижимой, и мутация
// «>= на >» переживает тест. Порог включителен: молчит ровно порог — уже брошен.
&Тест
Процедура ГраницаМолчанияРовноПорогПерехватывает() Экспорт

	Часы = Новый ЧасыРучные();
	Прогон = НовыйПрогонСПорогом(60);
	Прогон.УстановитьЧасы(Часы);

	ЧутьМеньше = ЗеркалоМолчащееС(Часы, 59);
	Ожидаем.Что(Прогон.Занять(ЧутьМеньше.Идентификатор).Занят,
		"молчит 59 с при пороге 60 — прогон жив").ЭтоЛожь();

	Ровно = ЗеркалоМолчащееС(Часы, 60);
	Ожидаем.Что(Прогон.Занять(Ровно.Идентификатор).Занят,
		"молчит РОВНО 60 с при пороге 60 — прогон брошен").ЭтоИстина();

	Больше = ЗеркалоМолчащееС(Часы, 61);
	Ожидаем.Что(Прогон.Занять(Больше.Идентификатор).Занят,
		"молчит 61 с — тем более брошен").ЭтоИстина();

КонецПроцедуры

// Находка живой пробы: обход оборвался ПОСРЕДИ порции, продолжение с курсора перечислило
// недойденный хвост заново — и хвост попал в знаменатель дважды (владелец видел «120 из 322»
// вместо «120 из 241»). Знаменатель обязан расти от УЖЕ ОБРАБОТАННОГО, а не от того, что
// оборванный цикл успел записать.
//
// Про монотонность доли тест не утверждает ничего, и утверждать не может: знаменатель здесь —
// «обработано + перечислено текущей порцией», а не «сколько всего у апстрима», поэтому доля
// упирается в сто в конце КАЖДОГО цикла и падает в начале следующего. Это свойство шкалы
// пришло с main, отдельно от двойного счёта, и закрывается отдельной задачей.
//
// Снимки значений берутся ДО следующего шага: хранилище отдаёт саму запись, а не копию,
// и переменные, взятые с разных шагов, указывали бы на один объект — сравнение таких
// «двух» состояний истинно при любом коде и не краснеет ни на одной мутации.
&Тест
Процедура ПродолжениеСКурсораНеСкладываетЗнаменательДважды() Экспорт

	Прогон = НовыйПрогонСДросселем(1); // отметка на каждый элемент: тест меряет счётчики
	Зеркало = НовоеЗеркало();

	// первый цикл: перечислил 194 имени, успел обработать 113 (100 скачал, 10 пропустил,
	// 3 не ответили — недоступные это подмножество пропущенных, и в сумму не входят)
	Прогон.Занять(Зеркало.Идентификатор);
	Прогон.Завершить(Зеркало.Идентификатор, ИтогОборванный(194, 100, 10, 3, 3), "autumn",
		ТекущаяУниверсальнаяДата(), Истина);

	Оборванное = Хранилище_.ПолучитьОдноПоИдентификаторРавно(Зеркало.Идентификатор);
	ЗнаменательДоОбрыва = Оборванное.ПрогонВсего;
	ОбработаноДоОбрыва = Оборванное.ПрогонСкачано + Оборванное.ПрогонПропущено
		+ Оборванное.ПрогонОшибок;
	Ожидаем.Что(ЗнаменательДоОбрыва, "до обрыва знаменатель — вся порция").Равно(194);
	Ожидаем.Что(ОбработаноДоОбрыва, "а обработано из неё 113").Равно(113);

	// продолжение с курсора: новый цикл перечисляет 128 имён, из них хвост прошлого — те же
	Захват = Прогон.Занять(Зеркало.Идентификатор);
	Ожидаем.Что(Захват.Курсор, "продолжаем с недойденного пакета").Равно("autumn");
	Прогон.Отметить(Зеркало.Идентификатор, ИтогОборванный(128, 7, 0, 0, 0), "autumn-cli");

	Продолженное = Хранилище_.ПолучитьОдноПоИдентификаторРавно(Зеркало.Идентификатор);
	Ожидаем.Что(Продолженное.ПрогонВсего,
		"знаменатель = обработанное (113) + перечисленное новым циклом (128), а не 194 + 128")
		.Равно(241);
	Ожидаем.Что(Продолженное.ПрогонСкачано, "числитель продолжает с обработанного").Равно(107);

	// дочитали хвост целиком — знаменатель и числитель сошлись, обход закрыт стопроцентно
	Прогон.Завершить(Зеркало.Идентификатор, ИтогОборванный(128, 128, 0, 0, 0), "",
		ТекущаяУниверсальнаяДата());
	Закрытое = Хранилище_.ПолучитьОдноПоИдентификаторРавно(Зеркало.Идентификатор);
	ОбработаноВКонце = Закрытое.ПрогонСкачано + Закрытое.ПрогонПропущено + Закрытое.ПрогонОшибок;
	Ожидаем.Что(ОбработаноВКонце, "дочитанный обход сходится со своим знаменателем")
		.Равно(Закрытое.ПрогонВсего);

КонецПроцедуры

// ЗаписьБрошена — вердикт для ЭКРАНОВ: они держат запись в руках и второго чтения базы
// себе позволить не могут. Без него карточка часами показывала «идёт», застывшие счётчики
// и обещание «страница обновляется сама» после смерти рабочего. Правило то же, что у захвата:
// занятое состояние ПЛЮС молчание не меньше порога; граница включительная.
&Тест
Процедура ЗаписьБрошенаСудитПоСостояниюИПорогуМолчания() Экспорт

	Часы = Новый ЧасыРучные();
	Прогон = НовыйПрогонСПорогом(60);
	Прогон.УстановитьЧасы(Часы);

	Ожидаем.Что(Прогон.ЗаписьБрошена(ЗеркалоМолчащееС(Часы, 59)),
		"идёт и молчит 59 с при пороге 60 — прогон жив").ЭтоЛожь();
	Ожидаем.Что(Прогон.ЗаписьБрошена(ЗеркалоМолчащееС(Часы, 60)),
		"идёт и молчит РОВНО порог — уже брошен").ЭтоИстина();
	Ожидаем.Что(Прогон.ЗаписьБрошена(ЗеркалоМолчащееС(Часы, 600)),
		"молчит десять порогов — тем более").ЭтоИстина();

	// заявка, которую никто не взял, виснет так же — и так же обязана называться брошенной
	Ожидаем.Что(Прогон.ЗаписьБрошена(ЗеркалоВСостоянииМолчащее(Часы, "поставлено", 600)),
		"поставленный, но не взятый прогон тоже брошен").ЭтоИстина();

	// закрытые состояния молчат ПО ПРИРОДЕ: объявлять их брошенными — врать на экране
	Для Каждого Состояние Из СтрРазделить("завершён,ошибка,простаивает", ",") Цикл
		Ожидаем.Что(Прогон.ЗаписьБрошена(ЗеркалоВСостоянииМолчащее(Часы, Состояние, 600)),
			"закрытое состояние «" + Состояние + "» брошенным не объявляется").ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Прогон.ЗаписьБрошена(Неопределено), "записи нет — судить не о чем").ЭтоЛожь();

КонецПроцедуры

// Дефект владельца: настройка порога порогом не была — её молча поднимал пол
// «(порция + 1) × таймаут». Администратор, задавший 900 с и крупную порцию, получал
// порог в 4020 или 6900 с и зеркало, два часа отбивавшее кнопку. Порог = настройка, точка;
// соотношение с окном молчания порции стережёт предупреждение на старте, а не потолок.
&Тест
Процедура ПорогЗависанияРавенНастройкеИСамПоСебеНеРастёт() Экспорт

	Ожидаем.Что(НовыйПрогонСПорогом(900).ПорогЗависания(), "порог — ровно то, что задано")
		.Равно(900);

	МолчитЧас = НовоеЗеркалоВСостоянии("идёт", 3600);
	Ожидаем.Что(НовыйПрогонСПорогом(900).Занять(МолчитЧас.Идентификатор).Занят,
		"час молчания при пороге 900 с — брошенный прогон, какой бы ни была порция")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПоставленныйПрогонВторойРазНеСтавится() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();

	Ожидаем.Что(Прогон.Поставить(Зеркало.Идентификатор, "42"), "первый раз поставлен").ЭтоИстина();
	Ожидаем.Что(Прогон.Поставить(Зеркало.Идентификатор, "43"), "второй раз отклонён").ЭтоЛожь();
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Состояние, "состояние — поставлено")
		.Равно("поставлено");
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Запустил, "запомнен первый инициатор")
		.Равно("42");

КонецПроцедуры

&Тест
Процедура ЗахватСохраняетТогоКтоПоставилПрогон() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Поставить(Зеркало.Идентификатор, "77");

	Ожидаем.Что(Прогон.Занять(Зеркало.Идентификатор).Занят, "поставленный прогон захватывается")
		.ЭтоИстина();
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Запустил,
		"инициатор не потерян плановым захватом").Равно("77");

КонецПроцедуры

// Прогресс пишется по ходу, но не на каждый чих: между записями либо N элементов,
// либо N секунд.
&Тест
Процедура ПрогрессДросселируетсяПоЧислуЭлементов() Экспорт

	Прогон = НовыйПрогонСДросселем(5);
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);

	Для Сч = 1 По 4 Цикл
		Прогон.Отметить(Зеркало.Идентификатор, Итог(Сч), "пакет-" + Формат(Сч, "ЧГ=0"));
	КонецЦикла;
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Скачано,
		"четыре элемента дросселем придержаны").Равно(0);

	Прогон.Отметить(Зеркало.Идентификатор, Итог(5), "пакет-5");
	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Скачано, "пятый элемент открыл дроссель").Равно(5);
	Ожидаем.Что(Состояние.Курсор, "и записал курсор").Равно("пакет-5");

КонецПроцедуры

// Момент, до которого источник заведомо вычитан, ставит ЗАКРЫТЫЙ обход: срез пройден
// до конца, курсора не осталось, ошибок не было. С него начнётся следующий инкремент.
&Тест
Процедура ЗакрытыйОбходСтавитМоментВычитки() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСрезом('20260812100000', '20260812120000'),
		"", ТекущаяУниверсальнаяДата());

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.ВычитаноДо, "момент вычитки записан").Равно('20260812120000');
	Ожидаем.Что(Состояние.Способ, "и обход назван инкрементным").Равно("инкремент");
	Ожидаем.Что(Состояние.СрезС, "с моментом, откуда спрошены изменения").Равно('20260812100000');

КонецПроцедуры

// Сорвавшийся цикл момента НЕ двигает: что он успел перенести, неизвестно.
&Тест
Процедура СорвавшийсяЦиклМоментаНеСтавит() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСрезом('20260812100000', '20260812120000'),
		"", ТекущаяУниверсальнаяДата(), Истина);

	Ожидаем.Что(ЗначениеЗаполнено(Прогон.Состояние(Зеркало.Идентификатор).ВычитаноДо),
		"момент вычитки остался прежним").ЭтоЛожь();

КонецПроцедуры

// Обход, оставивший курсор, срез не дочитал — момент ждёт следующего цикла.
&Тест
Процедура НедойденныйСрезМоментаНеСтавит() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСрезом('20260812100000', '20260812120000'),
		"дальше-отсюда", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(ЗначениеЗаполнено(Прогон.Состояние(Зеркало.Идентификатор).ВычитаноДо),
		"момент вычитки остался прежним").ЭтоЛожь();

КонецПроцедуры

// Сбой пакета изолируется, и обход идёт дальше — но момента такой обход не двигает:
// иначе невзятый пакет не приехал бы уже никогда.
&Тест
Процедура ОбходСОшибкойНаЭлементеМоментаНеСтавит() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);

	Итог_ = ИтогСоСрезом('20260812100000', '20260812120000');
	Итог_.Ошибок = 1;
	Прогон.Завершить(Зеркало.Идентификатор, Итог_, "", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(ЗначениеЗаполнено(Прогон.Состояние(Зеркало.Идентификатор).ВычитаноДо),
		"момент вычитки остался прежним").ЭтоЛожь();

КонецПроцедуры

// Источник, инкремента не умеющий, моментов не называет — и обход остаётся полным.
&Тест
Процедура ОбходБезМоментовОстаётсяПолным() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("синк ок"), "",
		ТекущаяУниверсальнаяДата());

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Способ, "обход полный").Равно("полный");
	Ожидаем.Что(ЗначениеЗаполнено(Состояние.ВычитаноДо), "и момента не оставил").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗавершениеПишетСтатусКурсорИМоментСинка() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);
	Момент = ТекущаяУниверсальнаяДата();

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("синк ок"), "дальше-отсюда", Момент);

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Состояние, "прогон закрыт").Равно("завершён");
	Ожидаем.Что(Состояние.Идёт, "признак «идёт» снят").ЭтоЛожь();
	Ожидаем.Что(Состояние.Статус, "статус записан").Равно("синк ок");
	Ожидаем.Что(Состояние.Курсор, "курсор следующего цикла записан").Равно("дальше-отсюда");
	Ожидаем.Что(Состояние.ПоследнийСинк, "момент синка записан").Равно(Момент);

КонецПроцедуры

&Тест
Процедура СбойнымЗавершениемПрогонПомеченОшибкой() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("ошибка синхронизации: бум"), "",
		ТекущаяУниверсальнаяДата(), Истина);

	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Состояние, "прогон помечен ошибкой")
		.Равно("ошибка");

КонецПроцедуры

// Кнопка обязана менять состояние СРАЗУ: очередь отвечает мгновенно, а движок доберётся
// до зеркала позже, и всё это время экран не должен показывать «простаивает».
&Тест
Процедура ЗаявкаНеЗатираетИдущийПрогон() Экспорт

	Прогон = НовыйПрогонСДросселем(1); // дроссель не должен придержать отметку этого теста
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор, "7");
	Прогон.Отметить(Зеркало.Идентификатор, Итог(11), "середина-обхода");

	Ожидаем.Что(Прогон.Поставить(Зеркало.Идентификатор, "99"), "заявка на идущий прогон отклонена")
		.ЭтоЛожь();

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Состояние, "живой прогон остался идущим").Равно("идёт");
	Ожидаем.Что(Состояние.Запустил, "инициатор живого прогона не подменён").Равно("7");
	Ожидаем.Что(Состояние.Курсор, "курсор живого прогона цел").Равно("середина-обхода");
	Ожидаем.Что(Состояние.Скачано, "счётчики живого прогона целы").Равно(11);

КонецПроцедуры

// Заявка показывает последний результат, пока новый прогон не начался: обнулить счётчики
// значило бы стереть с экрана то, что зеркало насчитало в прошлый раз.
&Тест
Процедура ЗаявкаНеТрогаетСчётчикиИКурсорПрошлогоПрогона() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);
	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("синк ок"), "хвост",
		ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Прогон.Поставить(Зеркало.Идентификатор, "5"), "заявка принята").ЭтоИстина();

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Состояние, "зеркало поставлено в очередь").Равно("поставлено");
	Ожидаем.Что(Состояние.Запустил, "инициатор записан").Равно("5");
	Ожидаем.Что(Состояние.Скачано, "счётчики прошлого прогона показываются дальше").Равно(3);
	Ожидаем.Что(Состояние.Курсор, "курсор прошлого прогона цел").Равно("хвост");
	Ожидаем.Что(Состояние.Статус, "и его статус тоже").Равно("синк ок");

КонецПроцедуры

// Процесс мог умереть СРАЗУ ПОСЛЕ постановки, не начав цикла: зеркало, застрявшее
// в «поставлено», отвисает по тому же порогу молчания, что и застрявшее «идёт» —
// снаружи эти два случая неразличимы.
&Тест
Процедура ЗаявкаБезЦиклаОтвисаетПоТомуЖеПорогу() Экспорт

	Прогон = НовыйПрогонСПорогом(60);
	Зеркало = НовоеЗеркало();
	Зеркало.СостояниеПрогона = "поставлено";
	Зеркало.ПрогонОбновлён = ТекущаяУниверсальнаяДата() - 61;
	Зеркало.Сохранить();

	Ожидаем.Что(Прогон.Поставить(Зеркало.Идентификатор, "8"), "протухшая заявка ставится заново")
		.ЭтоИстина();
	Ожидаем.Что(Прогон.Занять(Зеркало.Идентификатор).Занят, "и захватывается движком").ЭтоИстина();

КонецПроцедуры

// Между порциями одного обхода зеркало ждёт следующего цикла, а не отработало: «завершён»
// на экране посреди длинного обхода — та же дезинформация, что и «простаивает» после кнопки.
&Тест
Процедура НезаконченныйОбходОстаётсяПоставленнымАНеЗавершённым() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор, "3");

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("порция ок", Истина), "следующее-имя",
		ТекущаяУниверсальнаяДата());

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние.Состояние, "обход не пройден — зеркало ждёт следующей порции")
		.Равно("поставлено");
	Ожидаем.Что(Состояние.Курсор, "курсор указывает на продолжение").Равно("следующее-имя");
	Ожидаем.Что(Состояние.Запустил, "инициатор обхода не потерян между порциями").Равно("3");
	Ожидаем.Что(Прогон.Занять(Зеркало.Идентификатор).Занят,
		"следующая порция захватывается без препятствий").ЭтоИстина();

КонецПроцедуры

// Инициатор принадлежит обходу, а не зеркалу навсегда: иначе экран вечно приписывал бы
// плановые синки последнему, кто нажимал кнопку.
&Тест
Процедура ПлановыйЗахватНеНаследуетИнициатораРучногоПрогона() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();

	Прогон.Занять(Зеркало.Идентификатор, "user-42");
	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("синк ок"), "",
		ТекущаяУниверсальнаяДата());
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Запустил,
		"ручной прогон записал инициатора").Равно("user-42");

	Прогон.Занять(Зеркало.Идентификатор);

	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Запустил,
		"плановый прогон кнопки не наследует — его никто не запускал").Равно("");

КонецПроцедуры

// Счётчики — за ОБХОД: пользователь смотрит на прогон целиком, и «скачано 3» посреди
// обхода, скачавшего двести, — это неправда.
&Тест
Процедура СчётчикиНакапливаютсяЗаОбходАНеЗаЦикл() Экспорт

	Прогон = НовыйПрогонСДросселем(1);
	Зеркало = НовоеЗеркало();

	Прогон.Занять(Зеркало.Идентификатор);
	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("порция 1", Истина), "вторая-порция",
		ТекущаяУниверсальнаяДата());
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Скачано, "первая порция").Равно(3);

	Прогон.Занять(Зеркало.Идентификатор);
	Прогон.Отметить(Зеркало.Идентификатор, Итог(2), "середина-второй");
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Скачано,
		"по ходу второй порции счёт продолжается с накопленного").Равно(5);

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("порция 2"), "",
		ТекущаяУниверсальнаяДата());
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Скачано,
		"обход из двух порций насчитал обе").Равно(6);

КонецПроцедуры

&Тест
Процедура НовыйОбходСчётчикиОбнуляет() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Прогон.Занять(Зеркало.Идентификатор);
	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("обход пройден"), "",
		ТекущаяУниверсальнаяДата());

	Прогон.Занять(Зеркало.Идентификатор);

	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Скачано,
		"курсор пуст — начался новый обход, счёт с нуля").Равно(0);

КонецПроцедуры

// ПрогонНачат — начало ОБХОДА апстрима, а не отдельного цикла: продолжение с курсора
// не должно обнулять «идёт с».
&Тест
Процедура ПродолжениеОбходаНеСбрасываетНачало() Экспорт

	Прогон = НовыйПрогон();
	Зеркало = НовоеЗеркало();
	Начало = ТекущаяУниверсальнаяДата() - 300;
	Зеркало.СостояниеПрогона = "завершён";
	Зеркало.ПрогонНачат = Начало;
	Зеркало.ПрогонКурсор = "середина";
	Зеркало.ПрогонОбновлён = ТекущаяУниверсальнаяДата() - 300;
	Зеркало.Сохранить();

	Прогон.Занять(Зеркало.Идентификатор);
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Начат,
		"продолжение обхода считает время с его начала").Равно(Начало);

	Прогон.Завершить(Зеркало.Идентификатор, ИтогСоСтатусом("ок"), "", ТекущаяУниверсальнаяДата());
	Прогон.Занять(Зеркало.Идентификатор);
	Ожидаем.Что(Прогон.Состояние(Зеркало.Идентификатор).Начат > Начало,
		"новый обход (курсор пуст) начинает отсчёт заново").ЭтоИстина();

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция НовыйПрогон()
	Возврат НовыйПрогонСПорогом(900);
КонецФункции

Функция НовыйПрогонСПорогом(Знач Порог)
	Возврат Новый ПрогонЗеркала(Хранилище_, Новый ПриведениеЧисел(), Дроссель(10, 2),
		ЧислаСПорогом(Порог), Новый СчётчикиОбхода(Новый ПриведениеЧисел()));
КонецФункции

// Дроссель по времени задран так, чтобы тест мерил ровно счётчик элементов.
Функция НовыйПрогонСДросселем(Знач Элементов)
	Возврат Новый ПрогонЗеркала(Хранилище_, Новый ПриведениеЧисел(), Дроссель(Элементов, 86400),
		ЧислаСПорогом(900), Новый СчётчикиОбхода(Новый ПриведениеЧисел()));
КонецФункции

// Порог живёт в настройках хаба и спрашивается на каждый вопрос «брошен ли прогон»:
// задать его тесту можно только заглушкой настроек.
Функция ЧислаСПорогом(Знач Порог)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.run_stale_sec", Порог);
	Возврат Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);
КонецФункции

Функция Дроссель(Знач Элементов, Знач Секунд)
	Результат = Новый ДроссельПрогресса(Новый ПриведениеЧисел());
	Результат.УстановитьТемп(Элементов, Секунд);
	Возврат Результат;
КонецФункции

// Молчание отмеряется теми же часами, что читает прогон: разность выходит ровной.
Функция ЗеркалоМолчащееС(Знач Часы, Знач СекундМолчания)
	Зеркало = НовоеЗеркало();
	Зеркало.СостояниеПрогона = "идёт";
	Зеркало.ПрогонОбновлён = Часы.Сейчас() - СекундМолчания;
	Зеркало.Сохранить();
	Возврат Зеркало;
КонецФункции

// То же, что ЗеркалоМолчащееС, но состояние задаёт тест: молчание отмеряется управляемыми
// часами, поэтому граница порога достижима точно.
Функция ЗеркалоВСостоянииМолчащее(Знач Часы, Знач Состояние, Знач СекундМолчания)
	Зеркало = НовоеЗеркало();
	Зеркало.СостояниеПрогона = Состояние;
	Зеркало.ПрогонОбновлён = Часы.Сейчас() - СекундМолчания;
	Зеркало.Сохранить();
	Возврат Зеркало;
КонецФункции

Функция НовоеЗеркалоВСостоянии(Знач Состояние, Знач СекундМолчания)
	Зеркало = НовоеЗеркало();
	Зеркало.СостояниеПрогона = Состояние;
	Зеркало.ПрогонОбновлён = ТекущаяУниверсальнаяДата() - СекундМолчания;
	Зеркало.Сохранить();
	Возврат Зеркало;
КонецФункции

Функция НовоеЗеркало()
	Зеркало = Хранилище_.СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = 1;
	Зеркало.АпстримURL = "http://upstream.invalid/download/";
	Зеркало.Режим = "opm";
	Зеркало.Сохранить();
	Возврат Зеркало;
КонецФункции

Функция Итог(Знач Скачано)
	Возврат Новый Структура("Всего, Скачано, Пропущено, Ошибок, Недоступно, ЕстьЕщё, Статус",
		20, Скачано, 0, 0, 0, Ложь, "");
КонецФункции

// Итог цикла, перечислившего Всего имён и разобравшего часть из них: ровно так выглядит
// оборванный посреди порции обход. Недоступно задаётся отдельно — оно накладывается
// на Пропущено, и без него формула «обработано» не проверяется вовсе.
Функция ИтогОборванный(Знач Всего, Знач Скачано, Знач Пропущено, Знач Ошибок, Знач Недоступно)
	Возврат Новый Структура("Всего, Скачано, Пропущено, Ошибок, Недоступно, ЕстьЕщё, Статус",
		Всего, Скачано, Пропущено, Ошибок, Недоступно, Ложь, "");
КонецФункции

// Итог цикла, которому источник назвал срез: с какого момента спрошены изменения
// и до какого момента источник этим обходом вычитан.
Функция ИтогСоСрезом(Знач СрезС, Знач МоментСреза)
	Результат = ИтогСоСтатусом("синк ок");
	Результат.Вставить("СрезС", СрезС);
	Результат.Вставить("МоментСреза", МоментСреза);
	Возврат Результат;
КонецФункции

Функция ИтогСоСтатусом(Знач Статус, Знач ЕстьЕщё = Ложь)
	Результат = Итог(3);
	Результат.Статус = Статус;
	Результат.ЕстьЕщё = ЕстьЕщё;
	Возврат Результат;
КонецФункции

#КонецОбласти
