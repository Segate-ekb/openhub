// Примитив основа/ЗаголовкиHTTP: чтение и правка заголовка по имени без учёта регистра.
// Проверяется значение — что регистр, в котором заголовок прислала другая сторона, ответа
// не меняет, а ключ для ПРАВКИ возвращается ровно тем, каким лежит в коллекции.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Заголовки;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ЗаголовкиHTTP");

КонецПроцедуры

&ПередКаждым
Процедура СобратьЗаголовки() Экспорт
	Заголовки = Новый ЗаголовкиHTTP();
КонецПроцедуры

&Тест
Процедура ЗначениеЧитаетсяВЛюбомРегистреИмени() Экспорт

	Пришедшие = Новый Соответствие();
	Пришедшие.Вставить("cache-control", "no-store");

	Ожидаем.Что(Заголовки.Значение(Пришедшие, "Cache-Control"), "имя в другом регистре")
		.Равно("no-store");
	Ожидаем.Что(Заголовки.Значение(Пришедшие, "CACHE-CONTROL"), "и в верхнем").Равно("no-store");
	Ожидаем.Что(Заголовки.Значение(Пришедшие, "ETag"), "чужого заголовка нет")
		.Равно(Неопределено);
	Ожидаем.Что(Заголовки.Значение(Неопределено, "ETag"), "заголовков нет вовсе")
		.Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТекстОтсутствующегоЗаголовкаПуст() Экспорт

	Пришедшие = Новый Соответствие();
	Пришедшие.Вставить("If-None-Match", """abc""");

	Ожидаем.Что(Заголовки.Текст(Пришедшие, "if-none-match"), "значение строкой")
		.Равно("""abc""");
	Ожидаем.Что(Заголовки.Текст(Пришедшие, "ETag"), "нет заголовка — пустая строка").Равно("");
	Ожидаем.Что(Заголовки.Текст(Неопределено, "ETag"), "нет коллекции — пустая строка")
		.Равно("");

КонецПроцедуры

&Тест
Процедура КлючПоИмениВозвращаетНаписаниеКоллекции() Экспорт

	// в Соответствии регистр ключа значим: запись по «Cache-Control» рядом с чужим
	// «cache-control» дала бы в ответе два заголовка вместо одного
	Ответные = Новый Соответствие();
	Ответные.Вставить("cache-control", "public");

	Ожидаем.Что(Заголовки.КлючПоИмени(Ответные, "Cache-Control"), "ключ как он записан")
		.Равно("cache-control");
	Ожидаем.Что(Заголовки.КлючПоИмени(Ответные, "ETag"), "нет заголовка — само имя")
		.Равно("ETag");
	Ожидаем.Что(Заголовки.КлючПоИмени(Неопределено, "ETag"), "нет коллекции — само имя")
		.Равно("ETag");

	Ответные.Вставить(Заголовки.КлючПоИмени(Ответные, "Cache-Control"), "private");
	Ожидаем.Что(Ответные.Количество(), "правка по найденному ключу заголовка не двоит")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура БезСнимаетЗаголовокВЛюбомРегистре() Экспорт

	Исходные = Новый Соответствие();
	Исходные.Вставить("authorization", "Bearer секрет");
	Исходные.Вставить("Accept", "application/json");

	Оставшиеся = Заголовки.Без(Исходные, "Authorization");

	Ожидаем.Что(Оставшиеся.Количество(), "снят ровно один заголовок").Равно(1);
	Ожидаем.Что(Оставшиеся.Получить("Accept"), "соседний остался").Равно("application/json");
	Ожидаем.Что(Исходные.Количество(), "исходная коллекция не тронута: копия, а не правка")
		.Равно(2);
	Ожидаем.Что(Заголовки.Без(Неопределено, "Authorization").Количество(),
		"нет коллекции — пустая копия").Равно(0);

КонецПроцедуры
