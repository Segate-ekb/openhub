// Хаб, на котором основной пул не назначен: свежая инсталляция, где общего пула ещё нет.
// Короткие адреса (/download, /dev-channel, /push) обязаны объяснить отказ, старт —
// предупредить оператора, а раздел «Пулы» — сказать «не назначен» (ИСТ-ПУЛ-010).

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;   // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем КукаАдмина;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабБезОсновногоПула() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	Хаб.ФайловаяБаза("openhub-без-основного-пула");

	// Сидер НЕ запускается: пулов в хабе нет вовсе, и сиду oshub.pools.default (public)
	// назначать нечего. Это и есть инсталляция сразу после первого старта.
	// Админ заводится мастером /setup, а не окружением: безголовая рогатка требует смены
	// пароля при первом входе и уводит с любого раздела настроек на экран учётки.
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.Запустить();

	ПройтиМастерПервогоЗапуска("root", "RootSecret1");
	КукаАдмина = Клиент.КукаСессии(ДождатьсяВхода("root", "RootSecret1"));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Самотест набора: подопытный хаб обязан быть тем, за что себя выдаёт. Единственный его
// пул — личное пространство администратора, заведённое регистрацией; общего пула нет,
// поэтому назначать основным нечего. Заведись такой пул — сид сделал бы его основным,
// и все проверки ниже стерегли бы пустоту.
&Тест
Процедура ОсновногоПулаНаЭтомХабеДействительноНет() Экспорт

	Ответ = Клиент.GETСКукой("/api/v1/pools", КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "список пулов отдан").Равно(200);

	Для Каждого Пул Из РазобратьJSON(Ответ.ПолучитьТелоКакСтроку())["items"] Цикл
		Ожидаем.Что(Пул["default"], СтрШаблон("пул ""%1"" основным не числится", Пул["name"]))
			.ЭтоЛожь();
		Ожидаем.Что(Пул["type"], СтрШаблон(
			"пул ""%1"" — личное пространство: основным его не назначить даже руками", Пул["name"]))
			.Равно("user");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КороткийАдресВыдачиОтвечаетОбъяснимым404() Экспорт

	Для Каждого Адрес Из СтрРазделить("/download/list.txt,/dev-channel/list.txt", ",") Цикл

		Ответ = Клиент.GET(Адрес);
		Тело_ = Ответ.ПолучитьТелоКакСтроку();

		Ожидаем.Что(Ответ.КодСостояния, Адрес + " отвечает отказом, а не 5xx").Равно(404);
		Ожидаем.Что(СтрНайти(Тело_, "основной пул хаба не назначен") > 0,
			Адрес + " называет причину: " + Тело_).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело_, "/hub/settings/pools") > 0,
			Адрес + " говорит, где это чинится: " + Тело_).ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КороткийАдресАртефактаОтвечаетОбъяснимым404() Экспорт

	Ответ = Клиент.GET("/download/имяпакета/имяпакета-1.0.0.ospx");
	Тело_ = Ответ.ПолучитьТелоКакСтроку();

	Ожидаем.Что(Ответ.КодСостояния, "адрес артефакта отвечает отказом").Равно(404);
	Ожидаем.Что(СтрНайти(Тело_, "основной пул хаба не назначен") > 0,
		"и отличает «пула нет» от «пакета нет»: " + Тело_).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АлиасПубликацииОтвечаетОбъяснимым404() Экспорт

	Ответ = PUSH("/push", КукаАдмина);
	Тело_ = Ответ.ПолучитьТелоКакСтроку();

	Ожидаем.Что(Ответ.КодСостояния, "публикация без имени пула отбита отказом").Равно(404);
	Ожидаем.Что(СтрНайти(Тело_, "Основной пул хаба не назначен") > 0,
		"отказ называет причину: " + Тело_).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело_, "/api/v1/pools/") > 0,
		"и показывает адрес, по которому публиковать можно: " + Тело_).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтартПредупреждаетОператора() Экспорт

	Журнал = Хаб.Дамп();

	Ожидаем.Что(СтрНайти(Журнал, "Основной пул хаба не назначен") > 0,
		"старт сказал это в журнал, а не промолчал").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Журнал, "/hub/settings/pools") > 0,
		"и назвал раздел, где основной пул назначается").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РазделПуловГоворитЧтоОсновнойНеНазначен() Экспорт

	Страница = Клиент.GETСКукой("/hub/settings/pools", КукаАдмина).ПолучитьТелоКакСтроку();

	Ожидаем.Что(СтрНайти(Страница, "Основной пул") > 0,
		"карточка основного пула на экране есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "не назначен") > 0,
		"и говорит, что назначения нет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "короткие адреса отвечают отказом") > 0,
		"и называет последствие, а не только факт").ЭтоИстина();

КонецПроцедуры

#Область Служебное

// Публикация в короткий адрес: тело намеренно не .ospx — отказ обязан прийти РАНЬШЕ
// разбора архива, от отсутствия основного пула.
Функция PUSH(Знач Путь, Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/octet-stream");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки("не архив", КодировкаТекста.UTF8);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

// Мастер первого запуска: заводит администратора без требования сменить пароль.
Процедура ПройтиМастерПервогоЗапуска(Знач Логин, Знач Пароль)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/setup", Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль), КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Мастер /setup не создал администратора: код %1, тело %2",
			Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

КонецПроцедуры

Функция ДождатьсяВхода(Знач Логин, Знач Пароль)

	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30 * 1000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Запрос = Новый HTTPЗапрос("/api/v1/login", Заголовки);
		Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
		Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
		Если Ответ.КодСостояния = 200 Тогда
			Возврат Ответ;
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;

	ВызватьИсключение "Админ не смог войти за отведённое время." + Символы.ПС + Хаб.Дамп();

КонецФункции

Функция РазобратьJSON(Знач Текст)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

#КонецОбласти
