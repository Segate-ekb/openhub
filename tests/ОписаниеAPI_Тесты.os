// Описание API, которое отдаёт winow: спецификация /v3/api-docs и её YAML, страница Swagger UI,
// разметка адресов под /api/ аннотациями, краткость текстов, неописанность прочих адресов
// и честность описания перед живым хабом.

#Использовать asserts
#Использовать oscript-yaml
#Использовать ospx-tools
#Использовать "фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КэшДокумента;    // Соответствие — разобранный /v3/api-docs, один на набор
Перем КлючАдмина;      // Строка — ключ доступа администратора хаба
Перем СессияАдмина;    // Соответствие — заголовки с кукой сессии администратора
Перем КэшМаршрутов;    // МаршрутыХаба — маршруты хаба по исходникам, один на набор

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");
	РеестрФикстур.Подключить("МаршрутыХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);

	КореньДанных = Хаб.ФайловаяБаза("openhub-openapi");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", ЛогинАдмина());
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", ПарольАдмина());

	Хаб.Запустить();
	Хаб.ДождатьсяОнбординга();

	Кука = Клиент.Войти(ЛогинАдмина(), ПарольАдмина());
	Ожидаем.Что(ЗначениеЗаполнено(Кука), "администратор вошёл").ЭтоИстина();
	СессияАдмина = Клиент.Кука(Кука);
	КлючАдмина = ВыпуститьКлючАдмина();

	ЗавестиОсновнойПулСПакетом(КореньДанных);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Документ

&Тест
Процедура СпецификацияОтдаётсяПоАдресуWinowСПаспортомХаба() Экспорт

	Ответ = Клиент.GET(АдресСпецификации());

	Ожидаем.Что(Ответ.КодСостояния, "спецификация отдаётся").Равно(200);
	Ожидаем.Что(СтрНачинаетсяС(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "application/json"),
		"спецификация — JSON").ЭтоИстина();

	Док = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(СтрНачинаетсяС(Строка(Док.Получить("openapi")), "3."), "документ OpenAPI 3").ЭтоИстина();

	Паспорт = Док.Получить("info");
	Ожидаем.Что(Паспорт.Получить("title"), "заголовок хаба, а не умолчание winow").Равно("OpenHub API");
	Ожидаем.Что(ЗначениеЗаполнено(Паспорт.Получить("description")), "общие правила API описаны").ЭтоИстина();
	Ожидаем.Что(Паспорт.Получить("license").Получить("name"), "лицензия хаба").Равно("MIT");

КонецПроцедуры

// Версия описания — версия хаба, а не умолчание winow «1.0.0»: клиент по ней понимает,
// с какой инсталляцией говорит.
&Тест
Процедура ВерсияОписанияРавнаВерсииХаба() Экспорт

	ВерсияХаба = Клиент.ТелоJSON(Клиент.GET("/health")).Получить("version");
	Ожидаем.Что(ЗначениеЗаполнено(ВерсияХаба), "проба живости называет версию").ЭтоИстина();

	Ожидаем.Что(Документ().Получить("info").Получить("version"), "версия описания").Равно(ВерсияХаба);

КонецПроцедуры

&Тест
Процедура YAMLОтдаётТотЖеДокумент() Экспорт

	Ответ = Клиент.GET(АдресСпецификации() + ".yaml");
	Ожидаем.Что(Ответ.КодСостояния, "YAML отдаётся").Равно(200);

	ИзYAML = Новый ПарсерYaml().ПрочитатьYaml(Клиент.Тело(Ответ));
	Док = Документ();

	Ожидаем.Что(ИзYAML.Получить("info").Получить("title"), "тот же заголовок").Равно(
		Док.Получить("info").Получить("title"));
	Ожидаем.Что(ИзYAML.Получить("paths").Количество(), "те же адреса").Равно(Док.Получить("paths").Количество());

КонецПроцедуры

&Тест
Процедура СтраницаSwaggerUIОтдаётсяHTML() Экспорт

	Ответ = Клиент.GET("/swagger-ui.html");

	Ожидаем.Что(Ответ.КодСостояния, "страница описания отдаётся").Равно(200);
	Ожидаем.Что(СтрНачинаетсяС(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "text/html"),
		"страница — HTML").ЭтоИстина();

КонецПроцедуры

// Прежний рукописный адрес снят: описанием он больше не отвечает, и второй копии описания нет.
&Тест
Процедура РукописныйАдресОписанияСнят() Экспорт

	Ответ = Клиент.GET("/api/v1/openapi.json");

	Ожидаем.Что(Ответ.КодСостояния, "рукописного описания больше нет").Равно(404);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), """openapi"""), "тело не документ OpenAPI").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Разметка

// Каждая операция адреса под /api/ размечена автором: у неё сводка и описание словами, группа
// с описанием и объявленные коды. Без аннотаций winow дал бы имя процедуры сводкой,
// группу по адресу контроллера и единственный ответ «200 Успешный ответ».
&Тест
Процедура КаждыйАдресAPIРазмеченАннотациями() Экспорт

	Док = Документ();
	Группы = ГруппыСОписанием(Док);
	Неразмеченные = Новый Массив();
	Проверено = 0;

	Для Каждого Путь Из АдресаAPI(Док) Цикл
		Для Каждого Операция Из Док.Получить("paths").Получить(Путь) Цикл
			Причина = ПричинаНеразмеченности(Операция.Значение, Путь, Группы);
			Если ЗначениеЗаполнено(Причина) Тогда
				Неразмеченные.Добавить(ВРег(Операция.Ключ) + " " + Путь + ": " + Причина);
			КонецЕсли;
			Проверено = Проверено + 1;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено > 90, СтрШаблон("проверено операций: %1", Проверено)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Неразмеченные, Символы.ПС),
		"операции под /api/ без &Операция, &Группа или &Возвращает").Равно("");

КонецПроцедуры

// Адреса не под /api/ — экраны, беспрефиксные алиасы выдачи, среза и публикации, корневые
// пробы — попадают в документ, но хаб их не описывает: сводка — имя процедуры, как winow
// подписывает неразмеченное, описания нет, ответ — единственный 200 генератора, группы
// с описанием нет.
&Тест
Процедура АдресаНеПодAPIНеОписаны() Экспорт

	Док = Документ();
	Группы = ГруппыСОписанием(Док);
	Описанные = Новый Массив();
	Проверенные = Новый Массив();
	Проверено = 0;

	Для Каждого Пункт Из Док.Получить("paths") Цикл

		Путь = Пункт.Ключ;
		Если СтрНачинаетсяС(Путь, "/api/") Тогда
			Продолжить;
		КонецЕсли;
		Проверенные.Добавить(Путь);

		Для Каждого Операция Из Пункт.Значение Цикл
			Причина = ЧемОписана(Операция.Значение, Путь, Группы);
			Если ЗначениеЗаполнено(Причина) Тогда
				Описанные.Добавить(ВРег(Операция.Ключ) + " " + Путь + ": " + Причина);
			КонецЕсли;
			Проверено = Проверено + 1;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(Проверено > 50, СтрШаблон("проверено операций не под /api/: %1", Проверено)).ЭтоИстина();

	Непроверенные = Новый Массив();
	Для Каждого Алиас Из СтрРазделить(АлиасыИПробы(), "|") Цикл
		Если Проверенные.Найти(Алиас) = Неопределено Тогда
			Непроверенные.Добавить(Алиас);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Непроверенные, ", "), "алиасы и пробы в документе и под проверкой").Равно("");

	Ожидаем.Что(СтрСоединить(Описанные, Символы.ПС), "адреса не под /api/ описаны хабом").Равно("");

КонецПроцедуры

&Тест
Процедура ОперацияНесётСводкуГруппуИКодыИзАннотаций() Экспорт

	Поиск = Операция("/api/v1/search", "get");

	Ожидаем.Что(Поиск.Получить("summary"), "сводка из &Операция").Равно("Поиск пакетов");
	Ожидаем.Что(Поиск.Получить("tags").Количество(), "одна группа").Равно(1);
	Ожидаем.Что(Поиск.Получить("tags")[0], "группа из &Группа").Равно("Поиск");
	Ожидаем.Что(ГруппыСОписанием(Документ()).Получить("Поиск") <> Неопределено,
		"у группы есть описание").ЭтоИстина();

	Коды = Поиск.Получить("responses");
	Ожидаем.Что(Коды.Получить("200") <> Неопределено, "успех объявлен").ЭтоИстина();
	Ожидаем.Что(Коды.Получить("405") <> Неопределено, "отказ по глаголу объявлен").ЭтоИстина();

КонецПроцедуры

// Упразднённый адрес описан как устаревший, и хаб отвечает на него тем, что обещано.
&Тест
Процедура УпразднённыеАдресаПомеченыИОтвечают410() Экспорт

	Открепление = Операция("/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}/pin", "delete");
	Ожидаем.Что(Открепление.Получить("deprecated"), "открепление устарело").ЭтоИстина();
	Ожидаем.Что(Открепление.Получить("responses").Получить("410") <> Неопределено, "обещан 410").ЭтоИстина();
	Ожидаем.Что(Клиент.ЗапросJSON("DELETE", АдресПакета() + "/tags/stable/pin", "").КодСостояния,
		"хаб отвечает обещанным 410").Равно(410);

	КаналПула = Операция("/api/v1/pools/{Пул}/channels/{Канал}", "put");
	Ожидаем.Что(КаналПула.Получить("deprecated"), "канал пула устарел").ЭтоИстина();
	Ожидаем.Что(Клиент.ЗапросJSON("PUT", "/api/v1/pools/" + ИмяПула() + "/channels/stable", "{}").КодСостояния,
		"хаб отвечает обещанным 410").Равно(410);

	Устаревшие = Новый Массив();
	Для Каждого Параметр Из Операция("/api/v1/pools/{Пул}/packages/{Имя}/resolve", "get").Получить("parameters") Цикл
		Если Параметр.Получить("deprecated") = Истина Тогда
			Устаревшие.Добавить(Параметр.Получить("name"));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Устаревшие, ","), "устаревший синоним spec помечен").Равно("channel");

КонецПроцедуры

// Адрес артефакта принимает версию параметром `spec`: необязательный параметр, которого нет
// в описании, для интегратора не существует.
&Тест
Процедура АдресаАртефактаОбъявляютSpec() Экспорт

	Адреса = "/api/v1/pools/{Пул}/download/{ИмяПакета}/{ИмяФайла}"
		+ "|/api/v1/pools/{Пул}/channels/{Канал}/download/{ИмяПакета}/{ИмяФайла}";
	Для Каждого Путь Из СтрРазделить(Адреса, "|") Цикл
		Артефакт = Операция(Путь, "get");
		Ожидаем.Что(Артефакт.Получить("tags")[0], Путь + " — в группе выдачи").Равно(ГруппаВыдачи());
		Ожидаем.Что(ИменаПараметров(Артефакт), Путь + " объявляет параметр spec").Содержит("spec");
	КонецЦикла;

	Ожидаем.Что(ИменаПараметров(Операция("/api/v1/pools/{Пул}/packages/{Имя}/resolve", "get")),
		"выбор версии объявляет параметр spec").Содержит("spec");

КонецПроцедуры

// Коды, которые хаб отдаёт на самом деле: неописанный код клиент разбирает наугад.
&Тест
Процедура ОписаниеОбъявляетКодыПубликацииЗеркалИДоверия() Экспорт

	Для Каждого Путь Из СтрРазделить("/api/v1/pools/{Пул}/push|/api/v1/pools/{Пул}/packages/{Имя}/versions", "|") Цикл
		Коды = Операция(Путь, "post").Получить("responses");
		Для Каждого Код Из СтрРазделить("201,202,413,429,507", ",") Цикл
			Ожидаем.Что(Коды.Получить(Код) <> Неопределено, СтрШаблон("у %1 описан %2", Путь, Код)).ЭтоИстина();
		КонецЦикла;
	КонецЦикла;

	Синк = Операция("/api/v1/pools/{Пул}/mirrors/{Ид}/sync", "post").Получить("responses");
	Ожидаем.Что(Синк.Получить("202") <> Неопределено, "синхронизация обещает 202").ЭтоИстина();
	Ожидаем.Что(Синк.Получить("200"), "и не обещает синхронного итога").Равно(Неопределено);

	Доверие = Операция("/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows", "post").Получить("responses");
	Ожидаем.Что(Доверие.Получить("201") <> Неопределено, "заведение доверия — 201").ЭтоИстина();
	Ожидаем.Что(Доверие.Получить("200") <> Неопределено, "идемпотентный повтор — 200").ЭтоИстина();
	Ожидаем.Что(Операция("/api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows/{Ид}/delete", "post")
			.Получить("responses").Получить("201"),
		"отзыв действием ничего не создаёт").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Краткость

// Описание читается за секунды: шапка — два-три предложения, группа — одно, операция — не
// больше трёх коротких предложений одним абзацем, сводка — одна строка, ответ — несколько
// слов. Меряется отданный документ, а не исходник: фразу, которую winow сам дописывает
// к части операций, автор убрать не может, и она в счёт не идёт.
&Тест
Процедура ОписаниеКороткое() Экспорт

	Док = Документ();
	Нарушения = Новый Массив();
	Операций = 0;
	Ответов = 0;

	Шапка = Паспорт();
	ПроверитьДлину(Нарушения, "шапка", Шапка, ПределШапки());
	ПроверитьПредложения(Нарушения, "шапка", Шапка, ПредложенийШапки());
	ПроверитьФорму(Нарушения, "шапка", Шапка);

	Для Каждого Группа Из ГруппыСОписанием(Док) Цикл
		ПроверитьДлину(Нарушения, "группа " + Группа.Ключ, Группа.Значение, ПределГруппы());
		ПроверитьПредложения(Нарушения, "группа " + Группа.Ключ, Группа.Значение, ПредложенийГруппы());
	КонецЦикла;

	Для Каждого Путь Из АдресаAPI(Док) Цикл
		Для Каждого Операция Из Док.Получить("paths").Получить(Путь) Цикл

			Где = ВРег(Операция.Ключ) + " " + Путь;

			Сводка = Операция.Значение.Получить("summary");
			ПроверитьДлину(Нарушения, Где + ": сводка", Сводка, ПределСводки());
			Если СтрНайти(Строка(Сводка), Символы.ПС) > 0 Тогда
				Нарушения.Добавить(Где + ": сводка не в одну строку");
			КонецЕсли;

			Описание = АвторскоеОписание(Операция.Значение);
			ПроверитьДлину(Нарушения, Где + ": описание", Описание, ПределОписания());
			ПроверитьПредложения(Нарушения, Где + ": описание", Описание, ПредложенийОписания());
			ПроверитьФорму(Нарушения, Где + ": описание", Описание);

			Для Каждого Ответ Из Операция.Значение.Получить("responses") Цикл
				ТекстОтвета = Ответ.Значение.Получить("description");
				ПроверитьДлину(Нарушения, Где + ": ответ " + Ответ.Ключ, ТекстОтвета, ПределОтвета());
				ПроверитьПредложения(Нарушения, Где + ": ответ " + Ответ.Ключ, ТекстОтвета, ПредложенийОтвета());
				Ответов = Ответов + 1;
			КонецЦикла;
			Операций = Операций + 1;

		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Операций > 90, СтрШаблон("проверено операций: %1", Операций)).ЭтоИстина();
	Ожидаем.Что(Ответов > 500, СтрШаблон("проверено ответов: %1", Ответов)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС),
		"тексты описания длиннее предела, в несколько предложений сверх предела или в абзацах").Равно("");

КонецПроцедуры

// Счёт предложений не обманывается кодом: точка внутри `.ospx` или `opm.cfg` предложение
// не кончает, а хвост без точки — ещё одно предложение.
&Тест
Процедура ПредложенияСчитаютсяБезКода() Экспорт

	Ожидаем.Что(Предложений(""), "пусто").Равно(0);
	Ожидаем.Что(Предложений("Канонический адрес."), "одно").Равно(1);
	Ожидаем.Что(Предложений("Публикация `.ospx` из `opm.cfg`, ответ `{a. b}`."), "код внутри").Равно(1);
	Ожидаем.Что(Предложений("Упразднено: отвечает 410." + Символы.ПС + "Замена — PUT /api/v1/x"),
		"хвост без точки").Равно(2);
	Ожидаем.Что(Предложений("Один. Два! Три? Четыре."), "четыре").Равно(4);
	Ожидаем.Что(Предложений("Версия 1.0.0 и -1 предложение не кончают."), "числа").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ГлаголыИАдреса

&Тест
Процедура ГлаголыТочкиПеречисленыВсе() Экспорт

	Ожидаем.Что(Глаголы("/api/v1/pools"), "пулы").Равно("get,post");
	Ожидаем.Что(Глаголы("/api/v1/pools/{Пул}"), "пул").Равно("delete,get");
	Ожидаем.Что(Глаголы("/api/v1/pools/{Пул}/mirrors/{Ид}"), "зеркало").Равно("delete,get,patch");
	Ожидаем.Что(Глаголы("/api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}/versions/{Версия}"), "состав тега")
		.Равно("delete,put");
	Ожидаем.Что(Глаголы("/api/v1/pools/{Пул}/push"), "публикация протоколом opm").Равно("post,put");
	Ожидаем.Что(Глаголы("/api/v1/pools/{Пул}/download/list.txt"), "выдача для opm").Равно("get,head");

	Ответ = Клиент.HEAD("/api/v1/pools/" + ИмяПула() + "/download/list.txt");
	Ожидаем.Что(Ответ.КодСостояния, "обещанный HEAD выдачи обслуживается").Равно(200);

КонецПроцедуры

// Описание не расходится с хабом по глаголам ни на одном адресе под /api/; параметры пути
// подставлены заведёнными пулом, пакетом и версией. Объявленный глагол хаб не отвергает 405:
// запрос идёт анонимно с пустым телом, а где вход спрашивается раньше глагола и аноним получил
// 401 — повторяется сессией администратора, а публикация, которая сессию не видит, — ключом;
// повтор обязан пройти вход, иначе проверка ничего не доказывает. Необъявленный
// отвергается 405 даже администратору, а упразднённый адрес — обещанным 410. Выдача для opm
// метод не проверяет: ей годится любой.
&Тест
Процедура ГлаголыОписанияСовпадаютСОбслуживаемыми() Экспорт

	Док = Документ();
	Расхождения = Новый Массив();
	Проверено = 0;
	СВходом = 0;

	Для Каждого Путь Из АдресаAPI(Док) Цикл

		Пункт = Док.Получить("paths").Получить(Путь);
		Адрес = АдресСПодстановкой(Путь);
		ЛюбойГлагол = ПунктВыдачи(Пункт);

		Для Каждого Глагол Из СтрРазделить("get,post,put,patch,delete", ",") Цикл

			Если ЛюбойГлагол ИЛИ Пункт.Получить(Глагол) <> Неопределено Тогда
				Ответ = Клиент.ЗапросJSON(ВРег(Глагол), Адрес, "{}");
				Если ВходНеПройден(Ответ) Тогда
					Ответ = ОтветСоВходом(Пункт.Получить(Глагол), ВРег(Глагол), Адрес);
					Если ВходНеПройден(Ответ) Тогда
						Расхождения.Добавить(СтрШаблон("%1 %2: вход администратора не принят — 401",
							ВРег(Глагол), Путь));
					Иначе
						СВходом = СВходом + 1;
					КонецЕсли;
				КонецЕсли;
				Если Ответ.КодСостояния = 405 Тогда
					Расхождения.Добавить(СтрШаблон("%1 %2: обслуживается по описанию, а хаб отвечает 405",
						ВРег(Глагол), Путь));
				КонецЕсли;
			Иначе
				Код = Клиент.ЗапросJSON(ВРег(Глагол), Адрес, "{}", СессияАдмина).КодСостояния;
				Ожидаемый = ?(Упразднён(Пункт), 410, 405);
				Если Код <> Ожидаемый Тогда
					Расхождения.Добавить(СтрШаблон("%1 %2: не объявлен, а хаб отвечает %3 вместо %4",
						ВРег(Глагол), Путь, Код, Ожидаемый));
				КонецЕсли;
			КонецЕсли;
			Проверено = Проверено + 1;

		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(Проверено > 300, СтрШаблон("проверено пар «глагол — адрес»: %1", Проверено)).ЭтоИстина();
	Ожидаем.Что(СВходом > 30, СтрШаблон("объявленных пар, проверенных со входом: %1", СВходом)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Расхождения, Символы.ПС), "глаголы описания и хаба расходятся").Равно("");

КонецПроцедуры

// Адреса описания winow по умолчанию не обслуживает ни один маршрут хаба. Это то условие,
// при котором регистратор описания не может проиграть маршрутам хаба при любом порядке старта:
// занятость адреса он проверяет тем же поиском маршрута, каким обслуживается запрос. Таблица —
// маршруты одного хаба без регистратора, то есть хаб с выключенным описанием.
&Тест
Процедура АдресаОписанияНеЗанятыМаршрутамиХаба() Экспорт

	Маршруты = Маршруты();
	Ожидаем.Что(Маршруты.Контроллеров() > 40, "маршруты хаба прочитаны").ЭтоИстина();

	Для Каждого Адрес Из СтрРазделить(АдресСпецификации() + "|" + АдресСпецификации() + ".yaml"
		+ "|/swagger-ui.html", "|") Цикл
		Обработчик = Маршруты.Обработчик(Адрес);
		Ожидаем.Что(Обработчик, "адрес описания не обслуживается экраном хаба: " + Адрес
			+ ?(Обработчик = Неопределено, "", " (" + Обработчик.Контроллер + ")")).Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Имена адресов описания — обычные имена пулов: пул заводится, его страница живёт под /pools,
// а описание по-прежнему отдаётся по своим адресам.
&Тест
Процедура ИменаАдресовОписанияДоступныПулам() Экспорт

	Для Каждого Имя Из СтрРазделить("v3|swagger-ui.html", "|") Цикл

		Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools",
			СтрШаблон("{""name"":""%1"",""visibility"":""public""}", Имя), КлючАдмина);
		Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("пул ""%1"" заведён: %2", Имя, Клиент.Тело(Ответ)))
			.Равно(201);

		Страница = Клиент.GET("/pools/" + Имя);
		Ожидаем.Что(Страница.КодСостояния, СтрШаблон("страница пула ""%1"" открывается", Имя)).Равно(200);
		Ожидаем.Что(Клиент.Тело(Страница), "это страница пула " + Имя).Содержит("<title>" + Имя);

	КонецЦикла;

	Ожидаем.Что(Клиент.ТелоJSON(Клиент.GET(АдресСпецификации())).Получить("info").Получить("title"),
		"описание по-прежнему отдаётся своим адресом").Равно("OpenHub API");
	Ожидаем.Что(Клиент.GET("/swagger-ui.html").КодСостояния, "и страница описания тоже").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресСпецификации()
	Возврат "/v3/api-docs";
КонецФункции

Функция Документ()
	Если КэшДокумента = Неопределено Тогда
		КэшДокумента = Клиент.ТелоJSON(Клиент.GET(АдресСпецификации()));
	КонецЕсли;
	Возврат КэшДокумента;
КонецФункции

Функция Паспорт()
	Возврат Строка(Документ().Получить("info").Получить("description"));
КонецФункции

Функция Операция(Знач Путь, Знач Глагол)

	Пункт = Документ().Получить("paths").Получить(Путь);
	Ожидаем.Что(Пункт <> Неопределено, "адрес в описании: " + Путь).ЭтоИстина();
	Операция = Пункт.Получить(Глагол);
	Ожидаем.Что(Операция <> Неопределено, СтрШаблон("глагол %1 у %2", Глагол, Путь)).ЭтоИстина();
	Возврат Операция;

КонецФункции

// Описание операции без фразы, которую winow дописывает сам к адресу с позиционными сегментами.
Функция АвторскоеОписание(Знач Операция)

	Строки = Новый Массив();
	Для Каждого СтрокаТекста Из СтрРазделить(Строка(Операция.Получить("description")), Символы.ПС) Цикл
		Если СокрЛП(СтрокаТекста) <> ШумГенератора() Тогда
			Строки.Добавить(СтрокаТекста);
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(СтрСоединить(Строки, Символы.ПС));

КонецФункции

Функция ШумГенератора()
	Возврат "Принимает позиционные сегменты пути после адреса маршрута.";
КонецФункции

Процедура ПроверитьДлину(Нарушения, Знач Где, Знач Текст, Знач Предел)
	Длина = СтрДлина(Строка(Текст));
	Если Длина > Предел Тогда
		Нарушения.Добавить(СтрШаблон("%1: %2 знаков при пределе %3", Где, Длина, Предел));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПредложения(Нарушения, Знач Где, Знач Текст, Знач Предел)
	Число = Предложений(Текст);
	Если Число > Предел Тогда
		Нарушения.Добавить(СтрШаблон("%1: %2 предложений при пределе %3", Где, Число, Предел));
	КонецЕсли;
КонецПроцедуры

// Предложения текста: точка, восклицательный или вопросительный знак перед пробелом или концом
// текста, плюс хвост без знака. Код в обратных кавычках не считается: `.ospx` предложение не кончает.
Функция Предложений(Знач Текст)

	БезКода = СокрЛП(Новый РегулярноеВыражение("`[^`]*`").Заменить(Строка(Текст), "код"));
	Если ПустаяСтрока(БезКода) Тогда
		Возврат 0;
	КонецЕсли;

	Число = Новый РегулярноеВыражение("[.!?](?=\s|$)").НайтиСовпадения(БезКода).Количество();
	Если СтрНайти(".!?", Прав(БезКода, 1)) = 0 Тогда
		Число = Число + 1;
	КонецЕсли;
	Возврат Число;

КонецФункции

// Один абзац без списков и жирного: пустая строка делит текст на абзацы, строка с маркером
// в начале становится пунктом списка.
Процедура ПроверитьФорму(Нарушения, Знач Где, Знач Текст)

	Если СтрНайти(Текст, "**") > 0 Тогда
		Нарушения.Добавить(Где + ": жирное");
	КонецЕсли;

	Маркер = Новый РегулярноеВыражение("^([-*+]|\d+[.)])\s");
	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС) Цикл
		Начало = СокрЛ(СтрокаТекста);
		Если ПустаяСтрока(Начало) Тогда
			Нарушения.Добавить(Где + ": пустая строка — второй абзац");
			Прервать;
		КонецЕсли;
		Если Маркер.Совпадает(Начало) Тогда
			Нарушения.Добавить(Где + ": маркер списка в «" + Начало + "»");
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПределШапки()
	Возврат 400;
КонецФункции

Функция ПределГруппы()
	Возврат 140;
КонецФункции

Функция ПределСводки()
	Возврат 80;
КонецФункции

Функция ПределОписания()
	Возврат 280;
КонецФункции

Функция ПределОтвета()
	Возврат 80;
КонецФункции

Функция ПредложенийШапки()
	Возврат 3;
КонецФункции

Функция ПредложенийГруппы()
	Возврат 1;
КонецФункции

Функция ПредложенийОписания()
	Возврат 3;
КонецФункции

Функция ПредложенийОтвета()
	Возврат 1;
КонецФункции

Функция ИменаПараметров(Знач Операция)

	Имена = Новый Массив();
	Параметры = Операция.Получить("parameters");
	Если Параметры <> Неопределено Тогда
		Для Каждого Параметр Из Параметры Цикл
			Имена.Добавить(Параметр.Получить("name"));
		КонецЦикла;
	КонецЕсли;
	Возврат Имена;

КонецФункции

// Глаголы адреса через запятую в алфавитном порядке.
Функция Глаголы(Знач Путь)

	Пункт = Документ().Получить("paths").Получить(Путь);
	Если Пункт = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Имена = Новый Массив();
	Для Каждого КиЗ Из Пункт Цикл
		Имена.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат ПоАлфавиту(Имена);

КонецФункции

// Упразднённый адрес: каждая его операция помечена устаревшей и обещает 410.
Функция Упразднён(Знач Пункт)
	Для Каждого Операция Из Пункт Цикл
		Если Операция.Значение.Получить("deprecated") <> Истина
			ИЛИ Операция.Значение.Получить("responses").Получить("410") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПунктВыдачи(Знач Пункт)
	Для Каждого Операция Из Пункт Цикл
		ГруппыОперации = Операция.Значение.Получить("tags");
		Если ГруппыОперации <> Неопределено И ГруппыОперации.Найти(ГруппаВыдачи()) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Отказ именно во входе: 401 с кодом `unauthorized`. Неверный пароль у входа — тоже 401,
// но до глагола запрос уже дошёл.
Функция ВходНеПройден(Знач Ответ)
	Возврат Ответ.КодСостояния = 401 И КодОтказа(Ответ) = "unauthorized";
КонецФункции

// Повтор со входом: сессией администратора, а публикация, которая сессию не видит, — ключом.
Функция ОтветСоВходом(Знач Операция, Знач Глагол, Знач Адрес)

	Ответ = Клиент.ЗапросJSON(Глагол, Адрес, ТелоБезПоследствий(), СессияАдмина);
	Если ВходНеПройден(Ответ) И ВГруппе(Операция, ГруппаПубликации()) Тогда
		Ответ = Клиент.ЗапросJSON(Глагол, Адрес, ТелоБезПоследствий(), Клиент.Токен(КлючАдмина));
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция КодОтказа(Знач Ответ)
	Попытка
		Отказ = Клиент.ТелоJSON(Ответ).Получить("error");
		Возврат ?(Отказ = Неопределено, "", Строка(Отказ.Получить("code")));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Тело повтора со входом: изменения по сессии стопорит проверка CSRF, выпуск ключа,
// которому CSRF не нужен, отказывает на негодном сроке раньше, чем ключ появится,
// а публикация ключом — на теле, которое не `.ospx`.
Функция ТелоБезПоследствий()
	Возврат "{""expires_in_days"":-1}";
КонецФункции

Функция ВГруппе(Знач Операция, Знач Группа)
	Если Операция = Неопределено ИЛИ Операция.Получить("tags") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Операция.Получить("tags").Найти(Группа) <> Неопределено;
КонецФункции

Функция ГруппаПубликации()
	Возврат "Публикация";
КонецФункции

Функция ГруппаВыдачи()
	Возврат "Выдача для opm";
КонецФункции

// Адрес описания с параметрами пути, заменёнными заведёнными объектами; несуществующие
// заявка, зеркало, группа и ключ годятся — глагол проверяется раньше поиска объекта.
Функция АдресСПодстановкой(Знач Путь)

	Подстановка = Новый Соответствие();
	Подстановка.Вставить("Пул", ИмяПула());
	Подстановка.Вставить("Имя", ИмяПакета());
	Подстановка.Вставить("ИмяПакета", ИмяПакета());
	Подстановка.Вставить("ИмяФайла", ИмяПакета() + ".ospx");
	Подстановка.Вставить("Версия", ВерсияПакета());
	Подстановка.Вставить("Тег", "stable");
	Подстановка.Вставить("Канал", "stable");
	Подстановка.Вставить("Ид", "1");
	Подстановка.Вставить("Заявка", "1");
	Подстановка.Вставить("Группа", "nosuch");
	Подстановка.Вставить("Логин", ЛогинАдмина());
	Подстановка.Вставить("Ключ", "oshub.api.page_size");
	Подстановка.Вставить("ИдТокена", "999999");

	Адрес = Путь;
	Для Каждого КиЗ Из Подстановка Цикл
		Адрес = СтрЗаменить(Адрес, "{" + КиЗ.Ключ + "}", КиЗ.Значение);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Адрес, "{"), "все параметры пути подставлены: " + Адрес).Равно(0);
	Возврат Адрес;

КонецФункции

Функция ПоАлфавиту(Знач Имена)

	Список = Новый СписокЗначений();
	Список.ЗагрузитьЗначения(Имена);
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), ",");

КонецФункции

// Группы, объявленные с описанием: только их winow кладёт в раздел tags документа.
Функция ГруппыСОписанием(Знач Док)

	Группы = Новый Соответствие();
	Раздел = Док.Получить("tags");
	Если Раздел = Неопределено Тогда
		Возврат Группы;
	КонецЕсли;
	Для Каждого Группа Из Раздел Цикл
		Группы.Вставить(Группа.Получить("name"), Группа.Получить("description"));
	КонецЦикла;
	Возврат Группы;

КонецФункции

// Адреса описания под /api/ — только их хаб описывает.
Функция АдресаAPI(Знач Док)

	Пути = Новый Массив();
	Для Каждого КиЗ Из Док.Получить("paths") Цикл
		Если СтрНачинаетсяС(КиЗ.Ключ, "/api/") Тогда
			Пути.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Пути;

КонецФункции

// Беспрефиксные алиасы выдачи, среза и публикации и корневые пробы: в документе они есть,
// описания у них нет.
Функция АлиасыИПробы()
	Возврат "/download/list.txt|/download/{ИмяПакета}/{ИмяФайла}|/dev-channel/list.txt"
		+ "|/dev-channel/{ИмяПакета}/{ИмяФайла}|/pools/{Пул}/download/list.txt"
		+ "|/pools/{Пул}/download/{ИмяПакета}/{ИмяФайла}|/pools/{Пул}/channels/{Канал}/download/list.txt"
		+ "|/pools/{Пул}/channels/{Канал}/download/{ИмяПакета}/{ИмяФайла}|/changes|/pools/{Пул}/changes"
		+ "|/push|/pools/{Пул}/push|/health|/ready";
КонецФункции

Функция Маршруты()
	Если КэшМаршрутов = Неопределено Тогда
		КэшМаршрутов = Новый МаршрутыХаба(ОбъединитьПути(Хаб.КаталогПроекта(), "src", "модули"));
	КонецЕсли;
	Возврат КэшМаршрутов;
КонецФункции

// Имя процедуры, которая обслуживает адрес описания; Неопределено — маршрута хаба нет.
Функция ИмяПроцедуры(Знач Путь)

	Сегменты = Новый Массив();
	Для Каждого Сегмент Из СтрРазделить(Путь, "/") Цикл
		ЭтоПараметр = СтрНачинаетсяС(Сегмент, "{") И СтрЗаканчиваетсяНа(Сегмент, "}");
		Сегменты.Добавить(?(ЭтоПараметр, "x", Сегмент));
	КонецЦикла;

	Обработчик = Маршруты().Обработчик(СтрСоединить(Сегменты, "/"));
	Возврат ?(Обработчик = Неопределено, Неопределено, Обработчик.Метод);

КонецФункции

// Пустая строка — операция размечена; иначе — чего ей не хватает.
Функция ПричинаНеразмеченности(Знач Операция, Знач Путь, Знач Группы)

	ИмяМетода = ИмяПроцедуры(Путь);
	Если ИмяМетода = Неопределено Тогда
		Возврат "маршрут хаба не найден";
	КонецЕсли;
	Если Операция.Получить("summary") = ИмяМетода Тогда
		Возврат "сводка — имя процедуры, нет &Операция(Сводка)";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АвторскоеОписание(Операция)) Тогда
		Возврат "нет описания из &Операция";
	КонецЕсли;

	ГруппыОперации = Операция.Получить("tags");
	Если ГруппыОперации = Неопределено ИЛИ ГруппыОперации.Количество() = 0 Тогда
		Возврат "нет группы";
	КонецЕсли;
	Для Каждого Имя Из ГруппыОперации Цикл
		Если Группы.Получить(Имя) = Неопределено Тогда
			Возврат СтрШаблон("группа ""%1"" не объявлена &Группа с описанием", Имя);
		КонецЕсли;
	КонецЦикла;

	Если ОтветПоУмолчанию(Операция) Тогда
		Возврат "ответы не объявлены &Возвращает";
	КонецЕсли;

	Возврат "";

КонецФункции

// Пустая строка — операция не описана хабом, как winow выводит неразмеченную точку; иначе —
// чем она описана.
Функция ЧемОписана(Знач Операция, Знач Путь, Знач Группы)

	ИмяМетода = ИмяПроцедуры(Путь);
	Если ИмяМетода = Неопределено Тогда
		Возврат "маршрут хаба не найден";
	КонецЕсли;
	Если Операция.Получить("summary") <> ИмяМетода Тогда
		Возврат СтрШаблон("сводка «%1» вместо имени процедуры %2", Операция.Получить("summary"), ИмяМетода);
	КонецЕсли;

	Если ЗначениеЗаполнено(АвторскоеОписание(Операция)) Тогда
		Возврат "описание «" + АвторскоеОписание(Операция) + "»";
	КонецЕсли;

	Если НЕ ОтветПоУмолчанию(Операция) Тогда
		Возврат "объявлены ответы";
	КонецЕсли;

	ГруппыОперации = Операция.Получить("tags");
	Если ГруппыОперации <> Неопределено Тогда
		Для Каждого Имя Из ГруппыОперации Цикл
			Если Группы.Получить(Имя) <> Неопределено Тогда
				Возврат СтрШаблон("группа с описанием ""%1""", Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Операция.Получить("deprecated") = Истина Тогда
		Возврат "помечена устаревшей";
	КонецЕсли;

	Возврат "";

КонецФункции

// Ответ, который winow придумывает за точку без &Возвращает: единственный 200.
Функция ОтветПоУмолчанию(Знач Операция)
	Коды = Операция.Получить("responses");
	Возврат Коды.Количество() = 1 И Коды.Получить("200") <> Неопределено
		И Коды.Получить("200").Получить("description") = "Успешный ответ";
КонецФункции

Функция ВыпуститьКлючАдмина()

	Ответ = Клиент.ЗапросJSON("POST", "/api/v1/tokens", "{""права"":""read,write""}", СессияАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "ключ администратора выпущен: " + Клиент.Тело(Ответ)).Равно(201);
	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");

КонецФункции

// Публичный пул — основной пул хаба, в нём пакет с одной версией: на них подставляются
// параметры адресов, и срез с беспрефиксной выдачей видят основной пул.
Процедура ЗавестиОсновнойПулСПакетом(Знач КореньДанных)

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""name"":""%1"",""visibility"":""public""}", ИмяПула()), КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "пул заведён: " + Клиент.Тело(Ответ)).Равно(201);

	Ответ = Клиент.POSTJSONСТокеном("/api/v1/pools/" + ИмяПула() + "/default", "{}", КлючАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "пул стал основным: " + Клиент.Тело(Ответ)).Равно(200);

	Заголовки = Клиент.Токен(КлючАдмина);
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", ИмяПакета(), ВерсияПакета()));
	Запрос = Новый HTTPЗапрос(АдресПакета() + "/versions", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(
		Новый ФикстураПакета().ДанныеOspx(КореньДанных, ИмяПакета(), ВерсияПакета()));
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Ожидаем.Что(Ответ.КодСостояния, "версия опубликована: " + Клиент.Тело(Ответ)).Равно(201);

КонецПроцедуры

Функция АдресПакета()
	Возврат СтрШаблон("/api/v1/pools/%1/packages/%2", ИмяПула(), ИмяПакета());
КонецФункции

Функция ИмяПула()
	Возврат "openapi";
КонецФункции

Функция ИмяПакета()
	Возврат "openapi-pkg";
КонецФункции

Функция ВерсияПакета()
	Возврат "1.0.0";
КонецФункции

Функция ЛогинАдмина()
	Возврат "openapi-admin";
КонецФункции

Функция ПарольАдмина()
	Возврат "OpenapiAdminPass1";
КонецФункции

#КонецОбласти
