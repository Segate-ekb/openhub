// Самотест фикстуры СтендПодписок: на ней стоят наборы отборов запросов и каскадной уборки
// пула. Подписка, положенная с чужим написанием типа действия, доставок не получает —
// и набор зеленеет на подписке, которой хаб не умеет пользоваться.
// Проверяется то, ЧТО ВИДЯТ хранилище и служба подписок после стенда, — обе двери,
// и строкой, и службами; строка первой обязана совпадать со строкой второй.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;       // общий контейнер на все тесты набора
Перем Засев;         // фикстура ЗасевРеестра — пул и пакет, на которые заводится подписка
Перем Учётки;        // фикстура СтендУчёток — учётка, от чьего имени заводится подписка
Перем Стенд;         // фикстура СтендПодписок — строка подписки на события

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	РеестрФикстур.Подключить("СтендПодписок");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	ПодключитьСлоиПодписок(Модули);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "стенд-подписок-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("стенд-подписок-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Учётки = Новый СтендУчёток(Поделка);
	Стенд = Новый СтендПодписок(Поделка);

КонецПроцедуры

// Хранилище подписок живёт в слое данных, служба — в подписках, а та спрашивает права
// на объект, реестр пулов и каталог типов событий.
Процедура ПодключитьСлоиПодписок(Знач Модули)

	Слои.Подключить("данные");
	Слои.Подключить("хранилище, публикация, реестр, основа, наблюдаемость/телеметрия, события");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));

	Слои.Подключить("почта");
	Слои.Подключить("уведомления, вход, права, настройки");

	// Исходящий транспорт берётся из сети поштучно: слой сети целиком поднимает свои
	// стартовые задачи, которых юнит-контейнеру не надо.
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "ТаймаутыHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "СессияИсходящегоHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "КлиентHTTP.os"));

	// Очередь, доставщик и подписчик поднимают фоновую доставку, которой юнит-контейнеру
	// не надо. Обработчики типов остаются: реестр действий проверяет спаренность
	// «доставка — хранение» и без них не собирается, а без реестра служба не заводит
	// подписку вовсе.
	Слои.ПропускатьТакже("Очередь, Доставщик, Подписчик");
	Слои.Подключить("подписки");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

КонецПроцедуры

#Область ПодпискаСтрокой

&Тест
Процедура ПодпискаЛожитсяВБазуНаСвойОбъект() Экспорт

	Пул = Засев.Пул();

	Запись = Стенд.Подписка("пул", Пул, Пул.Идентификатор);

	Свои = Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пул", Пул.Идентификатор);
	Ожидаем.Что(Свои.Количество(), "подписка видна хранилищу").Равно(1);
	Ожидаем.Что(Свои[0].Идентификатор, "та самая подписка").Равно(Запись.Идентификатор);
	Ожидаем.Что(Свои[0].Активен, "подписка по умолчанию действует").ЭтоИстина();
	Ожидаем.Что(Свои[0].ТипыСобытий, "тип события по умолчанию").Равно("версия.опубликована");

КонецПроцедуры

// Тип и идентификатор объекта — параметры двери, и различает подписки именно пара:
// «пакет 7» и «пул 7» — разные объекты, и подписка, ушедшая не туда, оставила бы
// набор про каскадную уборку зелёным на несобранном хвосте.
&Тест
Процедура ДверьСтрокойРазличаетТипИИдентификаторОбъекта() Экспорт

	// номера объектов берутся у общего счётчика, а не пишутся числом: пул с таким же
	// номером заводит соседний тест, и синтетическая строка нашлась бы в его выдаче
	Общий = УникальныеИмена.Номер();
	Ничей = УникальныеИмена.Номер();

	Стенд.Подписка("пул", Общий);
	Стенд.Подписка("пакет", Общий);
	Стенд.Подписка("хаб", 0);

	Ожидаем.Что(Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пул", Общий).Количество(),
		"подписка пула").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пакет", Общий).Количество(),
		"тот же номер, другой тип объекта").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("хаб", 0).Количество() > 0,
		"подписка хаба").ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пул", Ничей).Количество(),
		"у объекта без подписок пусто").Равно(0);

КонецПроцедуры

// Пул-контейнер — отдельный параметр: он задаёт скоуп приватности подписки, и уборка
// пула ищет хвосты именно по нему. Потерянный номер оставил бы сироту в базе.
&Тест
Процедура ДверьСтрокойДоноситПулКонтейнер() Экспорт

	Пул = Засев.Пул();
	Пакет = Засев.Пакет(Пул);

	Запись = Стенд.Подписка("пакет", Пакет, Пул.Идентификатор);

	Ожидаем.Что(Цел(Запись.ПулИдентификатор), "названный пул-контейнер дошёл до базы")
		.Равно(Пул.Идентификатор);
	Ожидаем.Что(Цел(Стенд.Подписка("хаб", 0).ПулИдентификатор),
		"у подписки хаба контейнера нет").Равно(0);

КонецПроцедуры

// Адрес — параметр двери: доставка идёт именно на него, и набор, проверяющий выдачу
// списка подписок, узнаёт свою строку по адресу.
&Тест
Процедура ДверьСтрокойДоноситАдресИДаётСвободныйПоУмолчанию() Экспорт

	СвойНомер = УникальныеИмена.Номер();
	Названный = Стенд.Подписка("пул", СвойНомер, СвойНомер, "https://selftest.example/hook");

	Ожидаем.Что(Названный.URL, "названный адрес дошёл до базы")
		.Равно("https://selftest.example/hook");

	Соседний = УникальныеИмена.Номер();
	Первая = Стенд.Подписка("пул", Соседний);
	Вторая = Стенд.Подписка("пул", Соседний);
	Ожидаем.Что(Первая.URL <> Вторая.URL,
		СтрШаблон("адреса по умолчанию свободны (%1 и %2)", Первая.URL, Вторая.URL)).ЭтоИстина();

КонецПроцедуры

// Типы событий и признак действия — параметры двери: подписка на отзыв не должна
// получать доставку о публикации, а выключенная — не получать ничего.
&Тест
Процедура ДверьСтрокойДоноситТипыСобытийИПризнакДействия() Экспорт

	Номер = УникальныеИмена.Номер();
	Запись = Стенд.Подписка("пул", Номер, Номер, "", "версия.отозвана", Ложь);

	Ожидаем.Что(Запись.ТипыСобытий, "названные типы событий дошли до базы")
		.Равно("версия.отозвана");
	Ожидаем.Что(Запись.Активен, "снятый признак действия дошёл до базы").ЭтоЛожь();

КонецПроцедуры

// Автора подписки хаб судит на каждой доставке: подписку УРОВНЯ ХАБА он выбирает, только
// если её завёл действующий админ. Стенд без автора кладёт запись, которую хаб никогда
// не выберет, — и набор про доставку зеленел бы на пустом списке.
&Тест
Процедура ХабоваяПодпискаДоставокНеПолучаетПокаЕйНеНазванАвторАдмин() Экспорт

	Тип = "версия.опубликована";

	Безымянная = Стенд.Подписка("хаб", 0);
	Ожидаем.Что(НайденаСредиАктивных(Безымянная, Тип),
		"подписка хаба без автора доставок не получает").ЭтоЛожь();

	Админская = Стенд.Подписка("хаб", 0, 0, "", Тип, Истина, Учётки.Учётка("admin"));
	Ожидаем.Что(Цел(Админская.СозданКем) > 0, "автор дошёл до базы").ЭтоИстина();
	Ожидаем.Что(НайденаСредиАктивных(Админская, Тип),
		"подписка хаба, заведённая админом, доставку получает").ЭтоИстина();

	// автор без роли админа хабовую подписку не оживляет: судится роль, а не заполненность поля
	Обычная = Стенд.Подписка("хаб", 0, 0, "", Тип, Истина, Учётки.Учётка());
	Ожидаем.Что(НайденаСредиАктивных(Обычная, Тип),
		"автор без прав админа доставок подписке хаба не открывает").ЭтоЛожь();

КонецПроцедуры

// На подписке пула автор не судится — она доставляется и без него, и это разные ветки
// одного правила, а не одна.
&Тест
Процедура ПодпискеПулаАвторБезразличен() Экспорт

	Пул = Засев.Пул();

	Подписка = Стенд.Подписка("пул", Пул, Пул.Идентификатор);

	Ожидаем.Что(Цел(Подписка.СозданКем), "автора нет").Равно(0);
	Ожидаем.Что(НайденаСредиАктивных(Подписка, "версия.опубликована", Пул.Идентификатор),
		"и доставку она всё равно получает").ЭтоИстина();

КонецПроцедуры

// Объект называется набору то записью, то идентификатором — обе формы кладут подписку
// на один и тот же объект. Наборам отборов объект как запись недоступен вовсе.
&Тест
Процедура ОбъектНазываетсяЗаписьюЛибоИдентификатором() Экспорт

	Пул = Засев.Пул();

	Стенд.Подписка("пул", Пул);
	Стенд.Подписка("пул", Пул.Идентификатор);

	Ожидаем.Что(Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пул", Пул.Идентификатор).Количество(),
		"обе подписки на этом пуле").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ПодпискаСлужбамиХаба

// Главный сторож фикстуры. Подписка, положенная строкой, обязана быть неотличима
// от заведённой службой в тех колонках, по которым её судит хаб: чужое написание типа
// действия («webhook» вместо «вебхук») оставляет подписку без обработчика доставки,
// и набор про доставку зеленеет на строке, которой хаб не умеет пользоваться.
&Тест
Процедура СтрокаСтендаСовпадаетСоСтрокойСлужбыВСудимыхКолонках() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("sub"));
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");

	Службой = Стенд.ПодпискаСлужбой(Хозяин, Подписки().ОбъектПула(Пул),
		"https://selftest.example/service");
	Строкой = Стенд.Подписка("пул", Пул, Пул.Идентификатор, "https://selftest.example/string");

	Ожидаем.Что(Строкой.ТипДействия, "тип действия тот же, что кладёт служба")
		.Равно(Службой.ТипДействия);
	Ожидаем.Что(Подписки().ТипДействияПодписки(Строкой), "и служба читает его так же")
		.Равно(Подписки().ТипДействияПодписки(Службой));
	Ожидаем.Что(Строкой.ТипОбъекта, "тип объекта тот же").Равно(Службой.ТипОбъекта);
	Ожидаем.Что(Цел(Строкой.ОбъектИдентификатор), "объект тот же")
		.Равно(Цел(Службой.ОбъектИдентификатор));
	Ожидаем.Что(Цел(Строкой.ПулИдентификатор), "пул-контейнер тот же")
		.Равно(Цел(Службой.ПулИдентификатор));
	Ожидаем.Что(Строкой.ТипыСобытий, "типы событий те же").Равно(Службой.ТипыСобытий);
	Ожидаем.Что(Строкой.Активен, "признак действия тот же").Равно(Службой.Активен);

КонецПроцедуры

// Подписка, положенная строкой, видна службе в списке объекта наравне с заведённой ею:
// иначе набор, смешавший двери, читал бы половину списка.
&Тест
Процедура ПодпискаСтрокойВиднаСлужбеВСпискеОбъекта() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("sub"));
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");

	Стенд.ПодпискаСлужбой(Хозяин, Подписки().ОбъектПула(Пул));
	Стенд.Подписка("пул", Пул, Пул.Идентификатор);

	Ожидаем.Что(Подписки().Список(Подписки().ОбъектПула(Пул)).Количество(),
		"служба видит обе подписки объекта").Равно(2);

КонецПроцедуры

// Дверь службой требует прав на объект — этим она и отличается от двери строкой,
// которая кладёт строку кому угодно. Набор, проверяющий отказ постороннему, обязан
// брать вторую дверь.
&Тест
Процедура ДверьСлужбойТребуетПравНаОбъектАДверьСтрокойНет() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("sub"));
	Посторонний = Учётки.Учётка();

	Отказ = "";
	Попытка
		Стенд.ПодпискаСлужбой(Посторонний, Подписки().ОбъектПула(Пул));
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "постороннему служба подписку не заводит").ЭтоИстина();
	Ожидаем.Что(Подписки().Список(Подписки().ОбъектПула(Пул)).Количество(),
		"и в базу ничего не легло").Равно(0);

	Стенд.Подписка("пул", Пул, Пул.Идентификатор);
	Ожидаем.Что(Подписки().Список(Подписки().ОбъектПула(Пул)).Количество(),
		"дверь строкой кладёт строку мимо прав").Равно(1);

КонецПроцедуры

// Адрес и типы событий — параметры и этой двери; адрес по умолчанию свободен, иначе
// вторая подписка того же объекта упёрлась бы в запрет дубля.
&Тест
Процедура ДверьСлужбойДоноситАдресИТипыСобытий() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("sub"));
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");

	Названная = Стенд.ПодпискаСлужбой(Хозяин, Подписки().ОбъектПула(Пул),
		"https://selftest.example/named", "версия.отозвана");

	Ожидаем.Что(Названная.URL, "названный адрес дошёл до базы")
		.Равно("https://selftest.example/named");
	Ожидаем.Что(Названная.ТипыСобытий, "названные типы событий дошли до базы")
		.Равно("версия.отозвана");

	Первая = Стенд.ПодпискаСлужбой(Хозяин, Подписки().ОбъектПула(Пул));
	Вторая = Стенд.ПодпискаСлужбой(Хозяин, Подписки().ОбъектПула(Пул));
	Ожидаем.Что(Первая.URL <> Вторая.URL,
		СтрШаблон("адреса по умолчанию свободны (%1 и %2)", Первая.URL, Вторая.URL)).ЭтоИстина();
	Ожидаем.Что(Первая.ТипыСобытий, "типы событий по умолчанию").Равно("версия.опубликована");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Подписки()
	Возврат Желудь("СервисПодписок");
КонецФункции

// Выбрал бы хаб эту подписку для доставки события: тем же отбором, каким он рассылает.
Функция НайденаСредиАктивных(Знач Подписка, Знач ТипСобытия, Знач ПулИдентификатор = 0)

	Для Каждого Активная Из Подписки().АктивныеДляСобытия(ПулИдентификатор, ТипСобытия) Цикл
		Если Активная.Идентификатор = Подписка.Идентификатор Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
