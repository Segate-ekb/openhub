	Ожидаем.Что(Найти(Текст, """%1#%2""") > 0, "фолбэк утраченной сущности живёт в форматтере").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ФормаАдреса

&Тест
Процедура ФормаАдресаОпознаётсяОбратно() Экспорт

	// вторая, независимая от текста сеть: значение, собранное мимо форматтера, формы
	// не держит — это и проверяет служба журнала на записи
	Годные = Новый Массив();
	Годные.Добавить(Имена.Хаб());
	Годные.Добавить(Имена.ПулПоИмени("main"));
	Годные.Добавить(Имена.ПакетПоИменам("main", "oint"));
	Годные.Добавить(Имена.ВерсияПоИменам("main", "oint", "1.0.0"));
	Годные.Добавить(Имена.Тег(Имена.ПакетПоИменам("main", "oint"), "stable"));
	// метка поверх фолбэка утраченного пакета — форма, которую выдаёт летопись тегов
	Годные.Добавить(Имена.Версия(Имена.Неизвестный("пакет", 5), "1.0.0"));
	Годные.Добавить(Имена.Тег(Имена.Неизвестный("пакет", 5), "stable"));
	Годные.Добавить(Имена.Пользователь("alice"));
	Годные.Добавить(Имена.Группа("релиз-инженеры"));
	Годные.Добавить(Имена.Настройка("oshub.auth.password.minlength"));
	Годные.Добавить(Имена.Провайдер("authentik"));
	Годные.Добавить(Имена.Адрес("198.51.100.9"));
	Годные.Добавить(Имена.Адрес("::1"));
	Годные.Добавить(Имена.Адрес("::ffff:127.0.0.1"));
	Годные.Добавить(Имена.Адрес("2001:db8::1"));
	Годные.Добавить(Имена.Адрес("не-адрес-вовсе"));
	Годные.Добавить(Имена.Неизвестный("пул", 10));

	Отвергнутые = Новый Массив();
	Для Каждого Адрес Из Годные Цикл
		Если НЕ Имена.ЭтоАдресЖурнала(Адрес) Тогда
			Отвергнутые.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Отвергнутые, ", "),
		"форматтер выдал адрес, который сам не признаёт").Равно("");

КонецПроцедуры

&Тест
Процедура ПрежниеФорматыФормуНеДержат() Экспорт

	// ровно те виды, ради которых трек и делался, плюс обход из ревью
	Чужие = Новый Массив();
	Чужие.Добавить("corp");                          // голое имя пула
	Чужие.Добавить("пул#5 ← апстрим");               // зеркала до правки
	Чужие.Добавить("oshub.pools.personal_enabled");  // ключ настройки без префикса
	Чужие.Добавить("main/oint@1.0.0@2.0.0");         // две метки
	Чужие.Добавить("группа/пул/main");               // имя группы с разделителем
	Чужие.Добавить("");
	Чужие.Добавить("пакет#не-число");

	Принятые = Новый Массив();
	Для Каждого Адрес Из Чужие Цикл
		Если Имена.ЭтоАдресЖурнала(Адрес) Тогда
			Принятые.Добавить("«" + Адрес + "»");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Принятые, ", "), "чужая форма принята за адрес журнала").Равно("");

КонецПроцедуры

&Тест
Процедура ТегИВерсияДаютРазныеАдреса() Экспорт

	// алфавит тегов допускает «1.0.0»: с общим разделителем тег и версия слились бы
	Пакет = Имена.ПакетПоИменам("main", "oint");

	Ожидаем.Что(Имена.Версия(Пакет, "1.0.0") = Имена.Тег(Пакет, "1.0.0"),
		"версия 1.0.0 и тег 1.0.0 — разные адреса").ЭтоЛожь();
