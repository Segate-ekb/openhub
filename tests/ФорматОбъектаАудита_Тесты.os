// Сторож единого формата: нагрузку записи журнала собирает ТОЛЬКО аудит/СобытиеАудита,
// а адрес объекта в ней — ТОЛЬКО аудит/ИмяОбъектаАудита. Стережётся ИНВАРИАНТ, а не форма
// записи: ручная сборка опознаётся в любом виде — «Вставить» в любом регистре ключа и
// литерал структуры, — вызов билдера разбирается по аргументам, а собранное значение
// обязано держать форму адреса.

#Использовать asserts
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогМодулейПуть;
Перем КаталогАудита;
Перем Имена;
Перем Нагрузка;    // СобытиеАудита — билдер нагрузки записи журнала

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулейПуть = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогАудита = ОбъединитьПути(КаталогМодулейПуть, "аудит", "Классы");

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогАудита, "ИмяОбъектаАудита.os"), "ИмяОбъектаАудита");
	Исключение
		// класс уже подключён соседним набором того же процесса
	КонецПопытки;
	Попытка
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогМодулейПуть, "основа", "Классы"),
			"КанонIP.os"), "КанонIP");
	Исключение
		// класс уже подключён соседним набором того же процесса
	КонецПопытки;
	Попытка
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогМодулейПуть, "основа", "Классы"),
			"ТекстJSON.os"), "ТекстJSON");
	Исключение
		// класс уже подключён соседним набором того же процесса
	КонецПопытки;
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогАудита, "СобытиеАудита.os"), "СобытиеАудита");
	Исключение
		// класс уже подключён соседним набором того же процесса
	КонецПопытки;
	РеестрФикстур.Подключить("КанонПадающий");
	Имена = Новый ИмяОбъектаАудита(Неопределено, Неопределено, Неопределено, Неопределено,
		Новый КанонIP());
	Нагрузка = Новый СобытиеАудита(Имена, Новый ТекстJSON());
КонецПроцедуры

#Область НагрузкаЗаписи

// Форма нагрузки — контракт СлужбыАудита и читателя журнала: она берёт поля по именам
// и молча подставляет умолчания, поэтому переименованное поле не падает, а теряется.
&Тест
Процедура БилдерОтдаётВсеПоляЗаписи() Экспорт

	Данные = Нагрузка.Собрать("alice", "пул.создан", Имена.ПулПоИмени("main"),
		Имена.Пользователь("bob"), Новый Структура("пул", "main"), "10.0.0.5");

	Ожидаем.Что(Данные.Кто, "принципал").Равно("alice");
	Ожидаем.Что(Данные.Действие, "действие").Равно("пул.создан");
	Ожидаем.Что(Данные.Объект, "объект").Равно("пул/main");
	Ожидаем.Что(Данные.Субъект, "субъект").Равно("пользователь/bob");
	Ожидаем.Что(Данные.АдресIP, "адрес клиента").Равно("10.0.0.5");
	Ожидаем.Что(ПолеJSON(Данные.ДеталиJSON, "пул"), "детали доехали").Равно("main");

КонецПроцедуры

// Безымянное действие принадлежит хабу: запись с пустым принципалом читается как
// потерянная — по ней не отличить «сделал хаб» от «сделал кто-то, но мы не записали».
&Тест
Процедура БилдерПодставляетСистемуНаБезымянномПринципале() Экспорт

	Пустой = Нагрузка.Собрать("", "пул.основной.назначен", Имена.ПулПоИмени("main"), "",
		Новый Структура());
	Ожидаем.Что(Пустой.Кто, "пустой принципал — это хаб").Равно(Имена.Система());

	Названный = Нагрузка.Собрать("alice", "пул.основной.назначен", Имена.ПулПоИмени("main"), "",
		Новый Структура());
	Ожидаем.Что(Названный.Кто, "КОНТРОЛЬ: названный принципал не подменяется").Равно("alice");

КонецПроцедуры

// Детали уезжают в журнал ТЕКСТОМ: структура в этом поле доедет до файла как
// «Структура», и подробности операции пропадут целиком.
&Тест
Процедура БилдерСериализуетДеталиАНеКладётИхКакЕсть() Экспорт

	Детали = Новый Структура();
	Детали.Вставить("было", "public");
	Детали.Вставить("стало", "main");

	Данные = Нагрузка.Собрать("alice", "пул.основной.назначен", Имена.ПулПоИмени("main"), "",
		Детали);

	Ожидаем.Что(ТипЗнч(Данные.ДеталиJSON), "детали — строка").Равно(Тип("Строка"));
	Ожидаем.Что(ПолеJSON(Данные.ДеталиJSON, "было"), "прежнее значение читается обратно")
		.Равно("public");
	Ожидаем.Что(ПолеJSON(Данные.ДеталиJSON, "стало"), "новое значение читается обратно")
		.Равно("main");

КонецПроцедуры

// Системный путь клиента не имеет: у зеркала, планировщика и рогатки адреса нет, и
// журнал обязан говорить это пустотой, а не чужим адресом предыдущей записи.
&Тест
Процедура АдресКлиентаПоУмолчаниюПуст() Экспорт

	Данные = Нагрузка.Собрать("mirror", "зеркало.синхронизировано", Имена.ПулПоИмени("main"),
		"", Новый Структура());

	Ожидаем.Что(Данные.АдресIP, "адреса нет — поле пустое").Равно("");

КонецПроцедуры

// Деталей может не быть вовсе: пустой объект в журнале читается, «Неопределено» — нет.
&Тест
Процедура ОтсутствующиеДеталиДаютПустойОбъект() Экспорт

	Данные = Нагрузка.Собрать("alice", "пул.создан", Имена.ПулПоИмени("main"), "", Неопределено);

	Ожидаем.Что(СокрЛП(СтрЗаменить(Данные.ДеталиJSON, Символы.ПС, "")),
		"пустой объект JSON").Равно("{}");

КонецПроцедуры

#КонецОбласти

#Область СборкаАдреса

&Тест
Процедура НагрузкаЖурналаСобираетсяТолькоБилдером() Экспорт

	// Поля записи журнала — Кто, Объект, ДеталиJSON, АдресIP — собирает один класс,
	// СобытиеАудита. Производитель, собравший их руками, заводит шестой формат: журнал
	// перестанет читаться, а СверитьФорму увидит это только на боевой записи.
	Свои = Новый Массив();

	Для Каждого Путь Из ФайлыКлассов() Цикл
		Имя = Новый Файл(Путь).Имя;
		Если Имя = "СобытиеАудита.os" Тогда
			Продолжить; // сам билдер и есть то самое место
		КонецЕсли;
		Текст = БезКомментариев(Исходники.Текст(Путь));
		Если Найти(Текст, ".Опубликовать(") = 0 Тогда
			Продолжить; // не производитель событий — его «Объект» не про журнал
		КонецЕсли;
		Для Каждого Место Из МестаОбъекта(Текст) Цикл
			Свои.Добавить(СтрШаблон("%1 [%2]: %3", Имя, Место.Форма, Место.Фрагмент));
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Свои, "; "),
		"нагрузка записи журнала собрана мимо СобытиеАудита").Равно("");

КонецПроцедуры

&Тест
Процедура АдресОбъектаСобираетсяТолькоФорматтером() Экспорт

	// Класс, публикующий доменное событие, не вправе собирать адрес объекта сам — он
	// обязан спросить его у желудя ИмяОбъектаАудита (поле ИменаЖурнала). Иначе следующий
	// производитель заведёт шестой формат, и журнал перестанет читаться.
	Свои = Новый Массив();
	Проверено = 0;

	Для Каждого Путь Из ФайлыКлассов() Цикл
		Имя = Новый Файл(Путь).Имя;
		Текст = БезКомментариев(Исходники.Текст(Путь));
		Если Найти(Текст, ".Опубликовать(") = 0 Тогда
			Продолжить; // не производитель событий — его «Объект» не про журнал
		КонецЕсли;
		Для Каждого Место Из ВызовыБилдера(Текст) Цикл
			Проверено = Проверено + 1;
			Если НЕ Место.ЧерезФорматтер Тогда
				Свои.Добавить(СтрШаблон("%1: %2", Имя, Место.Адрес));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено > 10,
		СтрШаблон("сканер нашёл вызовов билдера: %1", Проверено)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Свои, "; "),
		"адрес объекта журнала собран мимо ИмяОбъектаАудита").Равно("");

КонецПроцедуры

&Тест
Процедура СканерВидитОбходВЛюбойФорме() Экспорт

	// ЧЕТЫРЕ обхода, каждый из которых оставлял прежнего сканера зелёным. Ключи Структуры
	// в OneScript регистронезависимы, поэтому строчная буква — рабочий продукт, а не опечатка.
	Формы = Новый Соответствие();
	Формы.Вставить("канон",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""Объект"", СтрШаблон(""%1#%2"", ТипОбъекта, Идентификатор));");
	Формы.Вставить("другой регистр ключа",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""объект"", СтрШаблон(""%1#%2 ← апстрим"", ПулИд, Апстрим));");
	Формы.Вставить("литерал структуры",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные = Новый Структура(""Кто, Действие, Объект, ДеталиJSON"","
		+ " Кем, Действие, Строка(Целевой.Имя), Детали);");
	Формы.Вставить("литерал структуры в другом регистре",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные = Новый Структура(""кто, действие, объект"", Кем, Действие, Строка(Имя));");

	Пропущенные = Новый Массив();
	Для Каждого КиЗ Из Формы Цикл
		Места = МестаОбъекта(КиЗ.Значение);
		Если Места.Количество() = 0 Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (место не найдено)");
			Продолжить;
		КонецЕсли;
		Если Места[0].ЧерезФорматтер Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (засчитано как через форматтер)");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, "; "),
		"обходы сторожа, которые он не замечает").Равно("");

	// двойной слэш внутри литерала не имеет права обрубать строку: за ним стоит сборка
	СоСсылкой = "	Издатель.Опубликовать(Тип, Данные); Адрес = ""https://hub.example"";" + Символы.ПС
		+ "	Данные.Вставить(""Объект"", СтрШаблон(""%1#%2"", ТипОбъекта, Идентификатор));";
	Ожидаем.Что(МестаОбъекта(БезКомментариев(СоСсылкой)).Количество(),
		"сборка после литерала со «//» найдена").Равно(1);

КонецПроцедуры

&Тест
Процедура СканерАдресаВидитОбходВЛюбойФорме() Экспорт

	// Билдер принимает адрес позиционно, и обойти форматтер можно тремя способами:
	// написать адрес литералом, собрать его шаблоном на месте и спрятать любое из этих
	// двух за именем переменной. Все три обязаны считаться обходом.
	Формы = Новый Соответствие();
	Формы.Вставить("литерал на месте",
		"	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кем, Действие, ""пул/"" + Имя, """", Детали));");
	Формы.Вставить("шаблон на месте",
		"	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кем, Действие, СтрШаблон(""%1#%2"", Тип, Ид), """", Детали));");
	Формы.Вставить("шаблон за именем переменной",
		"	Адрес = СтрШаблон(""%1#%2"", Тип, Ид);" + Символы.ПС
		+ "	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кем, Действие, Адрес, """", Детали));");
	Формы.Вставить("шаблон за именем функции",
		"	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кем, Действие, АдресТега(Тег), """", Детали));" + Символы.ПС
		+ "Функция АдресТега(Знач Тег)" + Символы.ПС
		+ "	Возврат СтрШаблон(""%1:%2"", Тег.Пакет, Тег.Имя);" + Символы.ПС
		+ "КонецФункции");

	Пропущенные = Новый Массив();
	Для Каждого КиЗ Из Формы Цикл
		Места = ВызовыБилдера(КиЗ.Значение);
		Если Места.Количество() = 0 Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (вызов не найден)");
			Продолжить;
		КонецЕсли;
		Если Места[0].ЧерезФорматтер Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (засчитано как через форматтер)");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, "; "),
		"обходы сторожа адреса, которые он не замечает").Равно("");

	// вызов с двумя аргументами — чужой «Собрать», а не билдер журнала
	Чужой = "	Издатель.Опубликовать(Тип, Данные); Ключ = Ключи.Собрать(Пул, Пакет);";
	Ожидаем.Что(ВызовыБилдера(Чужой).Количество(),
		"однофамилец билдера сторожем не считается").Равно(0);

КонецПроцедуры

// Обе стороны одной ошибки: сканер, читающий литерал как код, даёт ложный ОТКАЗ на
// образце в тексте — и его снимают вместе с защитой. Сканер обязан читать код.
&Тест
Процедура СканерАдресаНеЧитаетЛитералКакВызов() Экспорт

	ВЛитерале = "Функция ПримерДляДокументации()" + Символы.ПС
		+ "	Возврат ""СобытиеЖурнала.Собрать(Кем, Действие, Адрес, Субъект, Детали)"";"
		+ Символы.ПС + "КонецФункции";
	Ожидаем.Что(ВызовыБилдера(ВЛитерале).Количество(),
		"вызов, напечатанный внутри литерала, местом сборки не считается").Равно(0);

	// КОНТРОЛЬ: тот же вызов кодом сканер видит и опознаёт обходом — иначе проверка
	// выше зеленела бы просто потому, что сканер ослеп
	Кодом = "	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кем, Действие, Адрес, Субъект, Детали));";
	Места = ВызовыБилдера(Кодом);
	Ожидаем.Что(Места.Количество(), "тот же вызов кодом найден").Равно(1);
	Ожидаем.Что(Места[0].ЧерезФорматтер, "и засчитан обходом").ЭтоЛожь();

	// многострочный литерал не имеет права склеить строки: по ним ищется определение имени
	Многострочный = "	Учётка = ИменаЖурнала.Пользователь(Логин);" + Символы.ПС
		+ "	Текст = ""первая" + Символы.ПС + "	|вторая"";" + Символы.ПС
		+ "	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кто, Действие, Учётка, Учётка, Детали));";
	Ожидаем.Что(ВызовыБилдера(Многострочный)[0].ЧерезФорматтер,
		"определение имени за многострочным литералом находится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравильноеМестоСканерПринимает() Экспорт

	// вечнокрасный сторож не лучше вечнозелёного: канон обязан проходить
	Хороший = "	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""Объект"", ИменаЖурнала.ПоТипу(Объект.ТипОбъекта, Объект.Идентификатор));";
	Места = МестаОбъекта(Хороший);

	Ожидаем.Что(Места.Количество(), "место найдено").Равно(1);
	Ожидаем.Что(Места[0].ЧерезФорматтер, "и засчитано как собранное форматтером").ЭтоИстина();

	Перенос = "	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""Объект""," + Символы.ПС
		+ "		ИменаЖурнала.ВерсияПоИменам(ИмяПула, ИмяПакета, Версия));";
	Ожидаем.Что(МестаОбъекта(Перенос)[0].ЧерезФорматтер,
		"значение на следующей строке — тоже через форматтер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравильныйВызовБилдераСканерПринимает() Экспорт

	// вечнокрасный сторож не лучше вечнозелёного: все три канонические формы адреса
	// — на месте, через переменную и через однострочный сборщик — обязаны проходить
	НаМесте = "	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать(" + Символы.ПС
		+ "		Кем, Действие, ИменаЖурнала.ПоТипу(Объект.ТипОбъекта, Объект.Идентификатор),"
		+ Символы.ПС + "		"""", Детали));";
	Места = ВызовыБилдера(НаМесте);
	Ожидаем.Что(Места.Количество(), "вызов билдера найден").Равно(1);
	Ожидаем.Что(Места[0].ЧерезФорматтер, "адрес на месте — через форматтер").ЭтоИстина();

	ЧерезПеременную = "	Учётка = ИменаЖурнала.Пользователь(Логин);" + Символы.ПС
		+ "	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кто, Действие, Учётка, Учётка, Детали));";
	Ожидаем.Что(ВызовыБилдера(ЧерезПеременную)[0].ЧерезФорматтер,
		"адрес через переменную — тоже через форматтер").ЭтоИстина();

	ЧерезСборщик = "	Издатель.Опубликовать(Тип, СобытиеЖурнала.Собрать("
		+ "Кем, Действие, АдресТега(Тег), """", Детали));" + Символы.ПС
		+ "Функция АдресТега(Знач Тег)" + Символы.ПС
		+ "	Возврат ИменаЖурнала.Тег(Координаты.АдресПакета(Тег.ПакетИдентификатор), Тег.Имя);"
		+ Символы.ПС + "КонецФункции";
	Ожидаем.Что(ВызовыБилдера(ЧерезСборщик)[0].ЧерезФорматтер,
		"адрес через однострочный сборщик — тоже через форматтер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СканерНеВидитМоделейЭкранов() Экспорт

	// контроллеры кладут «Объект» в модель страницы — это подпись на экране, а не адрес
	// журнала; сканер не должен на них краснеть, иначе его отключат
	Контроллеры = 0;
	Для Каждого Путь Из ФайлыКлассов() Цикл
		Текст = БезКомментариев(Исходники.Текст(Путь));
		Если Найти(Текст, ".Опубликовать(") = 0 И МестаОбъекта(Текст).Количество() > 0 Тогда
			Контроллеры = Контроллеры + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Контроллеры > 0,
		СтрШаблон("классов с моделью «Объект» и без публикации: %1 — их сканер пропускает",
			Контроллеры)).ЭтоИстина();

КонецПроцедуры

