// Сторож единого формата: адрес объекта в записи журнала собирает ТОЛЬКО
// аудит/ИмяОбъектаАудита. Стережётся ИНВАРИАНТ, а не форма записи: место сборки
// опознаётся в любом виде — «Вставить» в любом регистре ключа и литерал структуры
// с полем «Объект», — а собранное значение обязано держать форму адреса.

#Использовать asserts
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогМодулейПуть;
Перем КаталогАудита;
Перем Имена;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулейПуть = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогАудита = ОбъединитьПути(КаталогМодулейПуть, "аудит", "Классы");

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогАудита, "ИмяОбъектаАудита.os"), "ИмяОбъектаАудита");
	Исключение
		// класс уже подключён соседним набором того же процесса
	КонецПопытки;
	Попытка
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогМодулейПуть, "основа", "Классы"),
			"КанонIP.os"), "КанонIP");
	Исключение
		// класс уже подключён соседним набором того же процесса
	КонецПопытки;
	РеестрФикстур.Подключить("КанонПадающий");
	Имена = Новый ИмяОбъектаАудита(Неопределено, Неопределено, Неопределено, Неопределено,
		Новый КанонIP());
КонецПроцедуры

#Область СборкаАдреса

&Тест
Процедура АдресОбъектаСобираетсяТолькоФорматтером() Экспорт

	// Класс, публикующий доменное событие, не вправе собирать адрес объекта сам — он
	// обязан спросить его у желудя ИмяОбъектаАудита (поле ИменаЖурнала). Иначе следующий
	// производитель заведёт шестой формат, и журнал перестанет читаться.
	Свои = Новый Массив();
	Проверено = 0;

	Для Каждого Путь Из ФайлыКлассов() Цикл
		Имя = Новый Файл(Путь).Имя;
		Если Имя = "ИмяОбъектаАудита.os" Тогда
			Продолжить; // сам форматтер и есть то самое место
		КонецЕсли;
		Текст = БезКомментариев(Исходники.Текст(Путь));
		Если Найти(Текст, ".Опубликовать(") = 0 Тогда
			Продолжить; // не производитель событий — его «Объект» не про журнал
		КонецЕсли;
		Для Каждого Место Из МестаОбъекта(Текст) Цикл
			Проверено = Проверено + 1;
			Если НЕ Место.ЧерезФорматтер Тогда
				Свои.Добавить(СтрШаблон("%1 [%2]: %3", Имя, Место.Форма, Место.Фрагмент));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено > 10,
		СтрШаблон("сканер нашёл места сборки адреса: %1", Проверено)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Свои, "; "),
		"адрес объекта журнала собран мимо ИмяОбъектаАудита").Равно("");

КонецПроцедуры

&Тест
Процедура СканерВидитОбходВЛюбойФорме() Экспорт

	// ЧЕТЫРЕ обхода, каждый из которых оставлял прежнего сканера зелёным. Ключи Структуры
	// в OneScript регистронезависимы, поэтому строчная буква — рабочий продукт, а не опечатка.
	Формы = Новый Соответствие();
	Формы.Вставить("канон",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""Объект"", СтрШаблон(""%1#%2"", ТипОбъекта, Идентификатор));");
	Формы.Вставить("другой регистр ключа",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""объект"", СтрШаблон(""%1#%2 ← апстрим"", ПулИд, Апстрим));");
	Формы.Вставить("литерал структуры",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные = Новый Структура(""Кто, Действие, Объект, ДеталиJSON"","
		+ " Кем, Действие, Строка(Целевой.Имя), Детали);");
	Формы.Вставить("литерал структуры в другом регистре",
		"	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные = Новый Структура(""кто, действие, объект"", Кем, Действие, Строка(Имя));");

	Пропущенные = Новый Массив();
	Для Каждого КиЗ Из Формы Цикл
		Места = МестаОбъекта(КиЗ.Значение);
		Если Места.Количество() = 0 Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (место не найдено)");
			Продолжить;
		КонецЕсли;
		Если Места[0].ЧерезФорматтер Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (засчитано как через форматтер)");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, "; "),
		"обходы сторожа, которые он не замечает").Равно("");

	// двойной слэш внутри литерала не имеет права обрубать строку: за ним стоит сборка
	СоСсылкой = "	Издатель.Опубликовать(Тип, Данные); Адрес = ""https://hub.example"";" + Символы.ПС
		+ "	Данные.Вставить(""Объект"", СтрШаблон(""%1#%2"", ТипОбъекта, Идентификатор));";
	Ожидаем.Что(МестаОбъекта(БезКомментариев(СоСсылкой)).Количество(),
		"сборка после литерала со «//» найдена").Равно(1);

КонецПроцедуры

&Тест
Процедура ПравильноеМестоСканерПринимает() Экспорт

	// вечнокрасный сторож не лучше вечнозелёного: канон обязан проходить
	Хороший = "	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""Объект"", ИменаЖурнала.ПоТипу(Объект.ТипОбъекта, Объект.Идентификатор));";
	Места = МестаОбъекта(Хороший);

	Ожидаем.Что(Места.Количество(), "место найдено").Равно(1);
	Ожидаем.Что(Места[0].ЧерезФорматтер, "и засчитано как собранное форматтером").ЭтоИстина();

	Перенос = "	Издатель.Опубликовать(Тип, Данные);" + Символы.ПС
		+ "	Данные.Вставить(""Объект""," + Символы.ПС
		+ "		ИменаЖурнала.ВерсияПоИменам(ИмяПула, ИмяПакета, Версия));";
	Ожидаем.Что(МестаОбъекта(Перенос)[0].ЧерезФорматтер,
		"значение на следующей строке — тоже через форматтер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СканерНеВидитМоделейЭкранов() Экспорт

	// контроллеры кладут «Объект» в модель страницы — это подпись на экране, а не адрес
	// журнала; сканер не должен на них краснеть, иначе его отключат
	Контроллеры = 0;
	Для Каждого Путь Из ФайлыКлассов() Цикл
		Текст = БезКомментариев(Исходники.Текст(Путь));
		Если Найти(Текст, ".Опубликовать(") = 0 И МестаОбъекта(Текст).Количество() > 0 Тогда
			Контроллеры = Контроллеры + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Контроллеры > 0,
		СтрШаблон("классов с моделью «Объект» и без публикации: %1 — их сканер пропускает",
			Контроллеры)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФорматтерОстаётсяЕдинственнымМестомШаблонов() Экспорт

	Текст = Исходники.Текст(ОбъединитьПути(КаталогАудита, "ИмяОбъектаАудита.os"));
	Ожидаем.Что(Найти(Текст, """%1/%2""") > 0, "шаблон пакета живёт в форматтере").ЭтоИстина();
	Ожидаем.Что(Найти(Текст, """%1@%2""") > 0, "шаблон версии живёт в форматтере").ЭтоИстина();
	Ожидаем.Что(Найти(Текст, """%1:%2""") > 0, "шаблон тега живёт в форматтере").ЭтоИстина();
	Ожидаем.Что(Найти(Текст, """%1#%2""") > 0, "фолбэк утраченной сущности живёт в форматтере").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ФормаАдреса

&Тест
Процедура ФормаАдресаОпознаётсяОбратно() Экспорт

	// вторая, независимая от текста сеть: значение, собранное мимо форматтера, формы
	// не держит — это и проверяет служба журнала на записи
	Годные = Новый Массив();
	Годные.Добавить(Имена.Хаб());
	Годные.Добавить(Имена.ПулПоИмени("main"));
	Годные.Добавить(Имена.ПакетПоИменам("main", "oint"));
	Годные.Добавить(Имена.ВерсияПоИменам("main", "oint", "1.0.0"));
	Годные.Добавить(Имена.Тег(Имена.ПакетПоИменам("main", "oint"), "stable"));
	// метка поверх фолбэка утраченного пакета — форма, которую выдаёт летопись тегов
	Годные.Добавить(Имена.Версия(Имена.Неизвестный("пакет", 5), "1.0.0"));
	Годные.Добавить(Имена.Тег(Имена.Неизвестный("пакет", 5), "stable"));
	Годные.Добавить(Имена.Пользователь("alice"));
	Годные.Добавить(Имена.Группа("релиз-инженеры"));
	Годные.Добавить(Имена.Настройка("oshub.auth.password.minlength"));
	Годные.Добавить(Имена.Провайдер("authentik"));
	Годные.Добавить(Имена.Адрес("198.51.100.9"));
	Годные.Добавить(Имена.Адрес("::1"));
	Годные.Добавить(Имена.Адрес("::ffff:127.0.0.1"));
	Годные.Добавить(Имена.Адрес("2001:db8::1"));
	Годные.Добавить(Имена.Адрес("не-адрес-вовсе"));
	Годные.Добавить(Имена.Неизвестный("пул", 10));

	Отвергнутые = Новый Массив();
	Для Каждого Адрес Из Годные Цикл
		Если НЕ Имена.ЭтоАдресЖурнала(Адрес) Тогда
			Отвергнутые.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Отвергнутые, ", "),
		"форматтер выдал адрес, который сам не признаёт").Равно("");

КонецПроцедуры

&Тест
Процедура ПрежниеФорматыФормуНеДержат() Экспорт

	// ровно те виды, ради которых трек и делался, плюс обход из ревью
	Чужие = Новый Массив();
	Чужие.Добавить("corp");                          // голое имя пула
	Чужие.Добавить("пул#5 ← апстрим");               // зеркала до правки
	Чужие.Добавить("oshub.pools.personal_enabled");  // ключ настройки без префикса
	Чужие.Добавить("main/oint@1.0.0@2.0.0");         // две метки
	Чужие.Добавить("группа/пул/main");               // имя группы с разделителем
	Чужие.Добавить("");
	Чужие.Добавить("пакет#не-число");

	Принятые = Новый Массив();
	Для Каждого Адрес Из Чужие Цикл
		Если Имена.ЭтоАдресЖурнала(Адрес) Тогда
			Принятые.Добавить("«" + Адрес + "»");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Принятые, ", "), "чужая форма принята за адрес журнала").Равно("");

КонецПроцедуры

&Тест
Процедура ТегИВерсияДаютРазныеАдреса() Экспорт

	// алфавит тегов допускает «1.0.0»: с общим разделителем тег и версия слились бы
	Пакет = Имена.ПакетПоИменам("main", "oint");

	Ожидаем.Что(Имена.Версия(Пакет, "1.0.0") = Имена.Тег(Пакет, "1.0.0"),
		"версия 1.0.0 и тег 1.0.0 — разные адреса").ЭтоЛожь();
	Ожидаем.Что(Имена.Тег(Пакет, "stable"), "адрес тега").Равно("main/oint:stable");

КонецПроцедуры

&Тест
Процедура АдресИсточникаПишетсяКанонично() Экспорт

	// объект записи о замке источника читает оператор, чтобы перенести адрес в правило
	// файрвола: искалеченный IPv6 обесценивает саму запись, а РАЗНЫЕ записи одного узла
	// разъехались бы по трём объектам вместо одного
	Ожидаем.Что(Имена.Адрес("::1"), "короткая форма IPv6").Равно("адрес/::1");
	Ожидаем.Что(Имена.Адрес("2001:db8::1"), "обычный IPv6").Равно("адрес/2001:db8::1");
	Ожидаем.Что(Имена.Адрес("198.51.100.9"), "IPv4").Равно("адрес/198.51.100.9");

	// отображённый IPv4 — так веб-сервер на двойном стеке называет клиента IPv4
	Ожидаем.Что(Имена.Адрес("::ffff:127.0.0.1"), "отображённый IPv4 — это IPv4")
		.Равно("адрес/127.0.0.1");
	Ожидаем.Что(Имена.Адрес("2001:0DB8:0000:0000:0000:0000:0000:0001"),
		"развёрнутая запись в верхнем регистре — тот же объект").Равно("адрес/2001:db8::1");
	Ожидаем.Что(Имена.Адрес("2001:DB8::1"), "верхний регистр — тот же объект")
		.Равно("адрес/2001:db8::1");

	// а вот разделитель пути внутри адреса обезвреживается: третьей части у адреса нет
	Ожидаем.Что(Имена.Адрес("1.2.3.4/24"), "подсеть не создаёт третью часть")
		.Равно("адрес/1.2.3.4_24");
	// адрес, которого канон не понял, журнал всё равно записывает — обезвреженным
	Ожидаем.Что(Имена.Адрес("не-адрес-вовсе"), "непонятый адрес пишется как есть")
		.Равно("адрес/не-адрес-вовсе");

КонецПроцедуры

&Тест
Процедура СломанныйКанонНеРоняетОперацию() Экспорт

	// адрес объекта собирают на пути входа по паролю, ДО публикации события: исключение
	// отсюда роняет не запись в журнал, а сам вход. Цена сбоя канона — неканоничный адрес
	СоСломаннымКаноном = Новый ИмяОбъектаАудита(Неопределено, Неопределено, Неопределено,
		Неопределено, Новый КанонПадающий());

	Ожидаем.Что(СоСломаннымКаноном.Адрес("::ffff:127.0.0.1"),
		"адрес записан как пришёл, а не потерян вместе с операцией").Равно("адрес/::ffff:127.0.0.1");

	БезКанона = Новый ИмяОбъектаАудита();
	Ожидаем.Что(БезКанона.Адрес("2001:DB8::1"),
		"невнедрённый канон операцию тоже не роняет").Равно("адрес/2001:DB8::1");

КонецПроцедуры

&Тест
Процедура МеткаПоверхФолбэкаНеЛомаетФормуУтраченнойСущности() Экспорт

	// летопись тегов оборачивает "пакет#<ид>" меткой, когда пакет снесён: если чистка
	// съедает «#», форматтер выдаёт значение, которое сам же потом отвергает, и вторая
	// сеть начинает предупреждать о собственном выводе
	Фолбэк = Имена.Неизвестный("пакет", 5);

	Ожидаем.Что(Имена.Версия(Фолбэк, "1.0.0"), "версия поверх фолбэка").Равно("пакет#5@1.0.0");
	Ожидаем.Что(Имена.Тег(Фолбэк, "stable"), "тег поверх фолбэка").Равно("пакет#5:stable");
	Ожидаем.Что(Имена.ЭтоАдресЖурнала(Имена.Версия(Фолбэк, "1.0.0")),
		"и обе формы форматтер признаёт своими").ЭтоИстина();
	Ожидаем.Что(Имена.ЭтоАдресЖурнала(Имена.Тег(Фолбэк, "stable")), "тег тоже").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УправляющиеСимволыНеПопадаютВАдрес() Экспорт

	// имена групп алфавитом не проверяются: возврат каретки в имени — это инъекция
	// строки в колонку объекта журнала безопасности
	Управляющие = Новый Соответствие();
	Управляющие.Вставить("возврат каретки", Символы.ВК);
	Управляющие.Вставить("перевод строки", Символы.ПС);
	Управляющие.Вставить("таб", Символы.Таб);
	Управляющие.Вставить("вертикальный таб", Символы.ВТаб);
	Управляющие.Вставить("перевод формата", Символы.ПФ);
	Управляющие.Вставить("неразрывный пробел", Символы.НПП);

	Пропущенные = Новый Массив();
	Для Каждого КиЗ Из Управляющие Цикл
		Адрес = Имена.Группа("a" + КиЗ.Значение + "b");
		Если Найти(Адрес, КиЗ.Значение) > 0 Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (не обезврежен)");
		КонецЕсли;
		Если Имена.ЭтоАдресЖурнала("группа/a" + КиЗ.Значение + "b") Тогда
			Пропущенные.Добавить(КиЗ.Ключ + " (признан корректным адресом)");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, "; "), "управляющие символы в адресе журнала").Равно("");
	Ожидаем.Что(Имена.Группа("a" + Символы.ВК + "b"), "заменяется подчёркиванием").Равно("группа/a_b");

КонецПроцедуры

&Тест
Процедура СубъектРазличаетУчёткуИГруппу() Экспорт

	// имена групп алфавитом не проверяются: группа вправе называться «alice»
	Ожидаем.Что(Имена.Пользователь("alice") = Имена.Группа("alice"),
		"учётка alice и группа alice — разные субъекты").ЭтоЛожь();
	Ожидаем.Что(Имена.Группа("пул/main"), "разделитель внутри имени группы обезврежен")
		.Равно("группа/пул_main");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Места, где в нагрузку события кладётся поле «Объект» — в любой форме и любом регистре.
//
// Параметры:
//  Текст - Строка - текст файла класса.
//
// Возвращаемое значение:
//  Массив из Структура - Форма (Строка), Фрагмент (Строка), ЧерезФорматтер (Булево).
//
Функция МестаОбъекта(Знач Текст) Экспорт

	Результат = Новый Массив();
	Строки = СтрРазделить(Текст, Символы.ПС);

	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		// ключ ищется в СВОЕЙ строке, а значение дочитывается со следующей: окно из двух
		// строк на обеих итерациях находило одно и то же место дважды
		Своя = НРег(СтрЗаменить(СтрЗаменить(СокрЛП(Строки[Индекс]), " ", ""), Символы.Таб, ""));

		Форма = "";
		Если Найти(Своя, "вставить(""объект""") > 0 Тогда
			Форма = "вставить";
		ИначеЕсли ЛитералСОбъектом(Своя) Тогда
			Форма = "литерал";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Форма) Тогда
			Продолжить;
		КонецЕсли;

		Фрагмент = СокрЛП(Строки[Индекс]);
		Если Индекс + 1 < Строки.Количество() Тогда
			Фрагмент = Фрагмент + " " + СокрЛП(Строки[Индекс + 1]);
		КонецЕсли;
		Сжатый = НРег(СтрЗаменить(СтрЗаменить(Фрагмент, " ", ""), Символы.Таб, ""));

		// литерал структуры проверить нечем: значение позиционное, и связь имени поля
		// со значением текстом не восстанавливается — такая сборка запрещена целиком
		ЧерезФорматтер = (Форма = "вставить" И Найти(Сжатый, "именажурнала.") > 0);
		Результат.Добавить(Новый Структура("Форма, Фрагмент, ЧерезФорматтер",
			Форма, Фрагмент, ЧерезФорматтер));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// «Новый Структура("…, Объект, …"» — сборка нагрузки литералом.
Функция ЛитералСОбъектом(Знач Сжатый)

	Позиция = Найти(Сжатый, "новыйструктура(""");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Сжатый, Позиция + СтрДлина("новыйструктура("""));
	Конец = Найти(Хвост, """");
	Если Конец = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Поле Из СтрРазделить(Лев(Хвост, Конец - 1), ",", Ложь) Цикл
		Если СокрЛП(Поле) = "объект" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Комментарии вырезаются: упоминание формата в пояснении — не место сборки.
Функция БезКомментариев(Знач Текст)

	Строки = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		Строки.Добавить(БезХвостовогоКомментария(Строка_));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Резать по первому «//» нельзя: адрес "https://hub.example" внутри литерала обрубил бы
// строку, и сканер перестал бы видеть сборку, стоящую следом.
Функция БезХвостовогоКомментария(Знач Строка_) Экспорт

	ВЛитерале = Ложь;
	Для Позиция = 1 По СтрДлина(Строка_) Цикл
		Символ = Сред(Строка_, Позиция, 1);
		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
		ИначеЕсли НЕ ВЛитерале И Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
			Возврат Лев(Строка_, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Строка_;

КонецФункции

Функция ФайлыКлассов()

	Результат = Новый Массив();
	Для Каждого Файл_ Из НайтиФайлы(КаталогМодулейПуть, "*.os", Истина) Цикл
		Если Файл_.ЭтоФайл() Тогда
			Результат.Добавить(Файл_.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
