// Поток ложится в файл байт в байт; сверх потолка и после сбоя чтения файла на диске нет.

#Использовать asserts
#Использовать tempfiles
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Приём;          // ПриёмПотокаВФайл
Перем Путь;           // Строка - файл текущего теста

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ПотокСоСбоемЧтения");
	ПоискКлассов = Новый КлассыСлоя();

	Основа = ОбъединитьПути(КаталогиПроекта.Модули(), "основа", "Классы");
	ПоискКлассов.Подключить(Основа, "ТихаяУборка");
	ПоискКлассов.Подключить(Основа, "ПриёмПотокаВФайл");

КонецПроцедуры

&ПередКаждым
Процедура Подготовить() Экспорт
	Приём = Новый ПриёмПотокаВФайл();
	Путь = ВременныеФайлы.НовоеИмяФайла("bin");
КонецПроцедуры

&ПослеКаждого
Процедура Убрать() Экспорт
	ВременныеФайлы.УдалитьФайл(Путь);
КонецПроцедуры

&Тест
Процедура ПотокНесколькихПорцийЛожитсяБайтВБайт() Экспорт

	Данные = СлучайныеДанные(Приём.Порция() * 3 + 17);

	Итог = Приём.Принять(Данные.ОткрытьПотокДляЧтения(), Путь, Данные.Размер());

	Ожидаем.Что(Итог.ПотолокПревышен, "ровно потолок — принят").ЭтоЛожь();
	Ожидаем.Что(Итог.Байт).Равно(Данные.Размер());
	Ожидаем.Что(Sha256(Новый ДвоичныеДанные(Путь)), "файл повторяет поток байт в байт").Равно(Sha256(Данные));

КонецПроцедуры

&Тест
Процедура ПустойПотокДаётПустойФайл() Экспорт

	Итог = Приём.Принять(ПолучитьДвоичныеДанныеИзСтроки("").ОткрытьПотокДляЧтения(), Путь, 10);

	Ожидаем.Что(Итог.ПотолокПревышен).ЭтоЛожь();
	Ожидаем.Что(Итог.Байт).Равно(0);
	Ожидаем.Что(Новый Файл(Путь).Размер(), "файл есть и пуст").Равно(0);

КонецПроцедуры

&Тест
Процедура БайтСверхПотолкаНеОставляетФайла() Экспорт

	Данные = СлучайныеДанные(1001);

	Итог = Приём.Принять(Данные.ОткрытьПотокДляЧтения(), Путь, 1000);

	Ожидаем.Что(Итог.ПотолокПревышен, "лишний байт — превышение").ЭтоИстина();
	Ожидаем.Что(Итог.Байт > 1000, "прочитанное названо больше потолка: " + Итог.Байт).ЭтоИстина();
	Ожидаем.Что(Новый Файл(Путь).Существует(), "недопринятый файл убран").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПревышениеОстанавливаетЧтениеНаПорции() Экспорт

	Данные = СлучайныеДанные(Приём.Порция() * 10);
	Поток = Данные.ОткрытьПотокДляЧтения();

	Итог = Приём.Принять(Поток, Путь, Приём.Порция());

	Ожидаем.Что(Итог.ПотолокПревышен).ЭтоИстина();
	Ожидаем.Что(Поток.ТекущаяПозиция(), "поток дочитан только до порции сверх потолка")
		.Равно(Приём.Порция() * 2);

КонецПроцедуры

&Тест
Процедура СбойЧтенияПробрасываетсяБезФайла() Экспорт

	Текст = "";
	Попытка
		Приём.Принять(Новый ПотокСоСбоемЧтения(), Путь, 1000000000);
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Текст, "сбой потока доходит до вызывающего").Содержит("соединение оборвано");
	Ожидаем.Что(Новый Файл(Путь).Существует(), "начатый файл убран").ЭтоЛожь();

КонецПроцедуры

#Область Служебные

Функция СлучайныеДанные(Знач Размер)

	Генератор = Новый ГенераторСлучайныхЧисел(20260930);
	Буфер = Новый БуферДвоичныхДанных(Размер);
	Для Индекс = 0 По Размер - 1 Цикл
		Буфер.Установить(Индекс, Генератор.СлучайноеЧисло(0, 255));
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

Функция Sha256(Знач Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат Хеширование.ХешСуммаСтрокой;
КонецФункции

#КонецОбласти
