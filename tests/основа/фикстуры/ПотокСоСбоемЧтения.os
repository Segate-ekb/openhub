// Поток, который отдаёт одну порцию и на следующем чтении падает, как оборванное соединение.

Перем Отдано;   // Булево - первая порция уже ушла

// Контракт потока: читает в буфер.
//
// Параметры:
//  Буфер - БуферДвоичныхДанных - куда читать.
//  Позиция - Число - с какой позиции буфера писать.
//  Количество - Число - сколько байт просят.
//
// Возвращаемое значение:
//  Число - сколько байт прочитано.
//
Функция Прочитать(Буфер, Знач Позиция, Знач Количество) Экспорт

	Если Отдано Тогда
		ВызватьИсключение "соединение оборвано";
	КонецЕсли;

	Отдано = Истина;
	Для Индекс = 0 По Количество - 1 Цикл
		Буфер.Установить(Позиция + Индекс, 7);
	КонецЦикла;
	Возврат Количество;

КонецФункции

Процедура ПриСозданииОбъекта()
	Отдано = Ложь;
КонецПроцедуры
