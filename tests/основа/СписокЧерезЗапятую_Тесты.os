// Список в одной колонке: пробелы, пустые элементы и регистр его не меняют, порядок записи сохраняется.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем ЧерезЗапятую;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Модули = КаталогиПроекта.Модули();
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);

КонецПроцедуры

&ПередКаждым
Процедура СобратьСписок() Экспорт
	ЧерезЗапятую = Новый СписокЧерезЗапятую();
КонецПроцедуры

&Тест
Процедура ПробелыИПустыеЭлементыСписокНеМеняют() Экспорт

	Ожидаем.Что(СтрСоединить(ЧерезЗапятую.Разобрать(" read , , write ,"), "|"),
		"обрамление снято, пустые элементы выброшены").Равно("read|write");
	Ожидаем.Что(ЧерезЗапятую.Разобрать("").Количество(), "пустая строка — пустой список")
		.Равно(0);
	Ожидаем.Что(ЧерезЗапятую.Разобрать(Неопределено).Количество(),
		"Неопределено — пустой список, а не отказ").Равно(0);

КонецПроцедуры

&Тест
Процедура ПорядокЗаписиСохраняется() Экспорт

	Ожидаем.Что(СтрСоединить(ЧерезЗапятую.Разобрать("write,read,write"), "|"),
		"порядок и повторы принадлежат вызывающему").Равно("write|read|write");

КонецПроцедуры

&Тест
Процедура КанонизацияВключаетсяПризнаком() Экспорт

	Ожидаем.Что(СтрСоединить(ЧерезЗапятую.Разобрать("Read, WRITE"), "|"),
		"по умолчанию регистр опускается").Равно("read|write");
	Ожидаем.Что(СтрСоединить(ЧерезЗапятую.Разобрать("Read, WRITE", Ложь), "|"),
		"с выключенной канонизацией регистр сохраняется").Равно("Read|WRITE");

КонецПроцедуры

&Тест
Процедура СодержитСличаетКанонично() Экспорт

	Ожидаем.Что(ЧерезЗапятую.Содержит("read,write", "WRITE"),
		"регистр вопроса и колонки не значим").ЭтоИстина();
	Ожидаем.Что(ЧерезЗапятую.Содержит("read, write", " read "),
		"обрамление вопроса не значимо").ЭтоИстина();
	Ожидаем.Что(ЧерезЗапятую.Содержит("read", "readwrite"),
		"частичное совпадение правом не является").ЭтоЛожь();
	Ожидаем.Что(ЧерезЗапятую.Содержит("", "read"), "пустой список не содержит ничего")
		.ЭтоЛожь();

КонецПроцедуры
