// Секрет значением либо файлом: значение сильнее файла, у файла снимаются края, пустой
// и отсутствующий файл дают пустой секрет, а путь к отсутствующему назван в журнале.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЛовушкаЛога");

	Модули = КаталогиПроекта.Модули();
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "СекретИзФайла");

КонецПроцедуры

&Тест
Процедура ЗначениеСильнееФайла() Экспорт

	Путь = ФайлСекрета("из-файла");
	Попытка
		Ожидаем.Что(Новый СекретИзФайла().Секрет("значением", Путь, "проба_file")).Равно("значением");
	Исключение
		УникальныеИмена.УбратьВременное(Путь);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Путь);

КонецПроцедуры

&Тест
Процедура УФайлаСнимаютсяКраяИПереводСтроки() Экспорт

	Путь = ФайлСекрета("  секрет" + Символы.ПС);
	Попытка
		Ожидаем.Что(Новый СекретИзФайла().Секрет("", Путь, "проба_file")).Равно("секрет");
	Исключение
		УникальныеИмена.УбратьВременное(Путь);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Путь);

КонецПроцедуры

&Тест
Процедура ПустойФайлДаётПустойСекрет() Экспорт

	Путь = ФайлСекрета(Символы.ПС);
	Попытка
		Ожидаем.Что(Новый СекретИзФайла().Секрет(Неопределено, Путь, "проба_file")).Равно("");
	Исключение
		УникальныеИмена.УбратьВременное(Путь);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(Путь);

КонецПроцедуры

&Тест
Процедура БезЗначенияИФайлаСекретПуст() Экспорт

	Ожидаем.Что(Новый СекретИзФайла().Секрет("", "", "проба_file")).Равно("");
	Ожидаем.Что(Новый СекретИзФайла().Секрет(Неопределено, Неопределено)).Равно("");

КонецПроцедуры

&Тест
Процедура ОтсутствующийФайлНазванВЖурнале() Экспорт

	Лог = Логирование.ПолучитьЛог("oshub.тесты.секрет-из-файла");
	Ловушка = Новый ЛовушкаЛога();
	Лог.ДобавитьСпособВывода(Ловушка, УровниЛога.Отладка);

	Попытка
		Секрет = Новый СекретИзФайла(Лог).Секрет("", "/нет/такого/секрета", "проба_file");
	Исключение
		Лог.УдалитьСпособВывода(Ловушка);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(Секрет, "без файла секрет пуст").Равно("");
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "/нет/такого/секрета") > 0, "назван путь: " + Ловушка.Всё())
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "проба_file") > 0, "назван ключ настройки: " + Ловушка.Всё())
		.ЭтоИстина();

КонецПроцедуры

Функция ФайлСекрета(Знач Содержимое)

	Путь = УникальныеИмена.ВременныйПуть("секрет", "txt");
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();
	Возврат Путь;

КонецФункции
