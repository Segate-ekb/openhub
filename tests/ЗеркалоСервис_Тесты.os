	Ожидаем.Что(Сервис.Переключить(Владелец(), Пул(8), Зеркало.Идентификатор, Ложь), "переключение в чужом пуле — no-op").ЭтоЛожь();
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "зеркало пула 7 цело").Равно(1);
КонецПроцедуры

// Состояние прогона читают экран зеркал и очередь синхронизации — через сервисный слой,
// а не через сущность напрямую.
&Тест
Процедура НовоеЗеркалоОтдаётПростаивающийПрогон() Экспорт

	Сервис = НовыйСервис(3);
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/");

	Состояние = Сервис.СостояниеПрогона(Зеркало.Идентификатор);
	Ожидаем.Что(Состояние, "состояние прогона отдаётся сервисом").Существует();
	Ожидаем.Что(Состояние.Состояние, "новое зеркало простаивает").Равно("простаивает");
	Ожидаем.Что(Состояние.Идёт, "и ничего не идёт").ЭтоЛожь();
	Ожидаем.Что(Состояние.Курсор, "обход ещё не начинался").Равно("");

КонецПроцедуры

// Кнопка и расписание могут совпасть: инвариант «один прогон на зеркало» держит
// приложение, а не база.
&Тест
Процедура ПрогонСтавитсяВОчередьТолькоОдин() Экспорт

	Сервис = НовыйСервис(3);
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/");

	Ожидаем.Что(Сервис.ПоставитьПрогон(Зеркало.Идентификатор, "100"), "первый запрос принят")
		.ЭтоИстина();
	Ожидаем.Что(Сервис.ПоставитьПрогон(Зеркало.Идентификатор, "101"), "второй отклонён")
		.ЭтоЛожь();
	Ожидаем.Что(Сервис.СостояниеПрогона(Зеркало.Идентификатор).Состояние, "прогон поставлен")
		.Равно("поставлено");

КонецПроцедуры

// Числа зеркалирования спрашиваются на КАЖДЫЙ вызов: правка экраном действует сразу,
// без перезапуска хаба. Раньше они защёлкивались в конструкторе при сборке контейнера.
&Тест
Процедура ПравкаЧислаДействуетБезПерезапуска() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.max_per_pool", 1);
	Числа = Новый ЧислаЗеркалирования(Настройки);
	Хранилище = Новый ФейкХранилищеЗеркал();
	Сервис = Новый СервисЗеркал(Хранилище, Новый ФейкСервисПрав(), НовыйВалидатор(), Новый ЗаведениеИсточника(),
		Новый ПрогонЗеркала(Хранилище, Новый ПриведениеЧисел(), Дроссель(10, 2), Числа,
			Новый СчётчикиОбхода(Новый ПриведениеЧисел())),
		Числа, Новый РазборНастроекЗеркала(Числа));

	Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/");

	Отказ = "";
	Попытка
		Сервис.Создать(Владелец(), Пул(7), "http://hub2.example/download/");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "при потолке 1 второе зеркало отбито").Содержит("лимит зеркал на пул (1)");

	// тот же объект сервиса, без пересборки контейнера
	Настройки.Задать("oshub.mirror.max_per_pool", 2);
	Второе = Сервис.Создать(Владелец(), Пул(7), "http://hub2.example/download/");

	Ожидаем.Что(Второе <> Неопределено, "поднятый экраном потолок действует сразу").ЭтоИстина();

КонецПроцедуры

// Список зеркал держит записи в руках. Второе чтение на каждое зеркало превращало страницу
// пула и карточку API в N+1 запрос к базе.
&Тест
Процедура СостояниеПрогонаПоЗаписиВБазуНеХодит() Экспорт

	Хранилище = Новый ФейкХранилищеЗеркал();
	Числа = ЧислаЗеркал(5);
	Сервис = Новый СервисЗеркал(Хранилище, Новый ФейкСервисПрав(), НовыйВалидатор(), Новый ЗаведениеИсточника(),
		Новый ПрогонЗеркала(Хранилище, Новый ПриведениеЧисел(), Дроссель(10, 2), Числа,
			Новый СчётчикиОбхода(Новый ПриведениеЧисел())),
		Числа, Новый РазборНастроекЗеркала(Числа));
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/");

	Хранилище.СброситьСчётчикЧтений();
	Состояние = Сервис.СостояниеПрогонаПоЗаписи(Зеркало);
	Сервис.ПрогонИдётПоЗаписи(Зеркало);
	Сервис.ПрогонБрошен(Зеркало);

	Ожидаем.Что(Состояние.Состояние, "состояние прочитано с записи").Равно("простаивает");
	Ожидаем.Что(Хранилище.ЧтенийПоИдентификатору(),
		"ни одного лишнего чтения базы на прочитанной записи").Равно(0);

	// контрольный замер: спрошенное ПО ИДЕНТИФИКАТОРУ в базу ходит — иначе счётчик слеп
	Сервис.СостояниеПрогона(Зеркало.Идентификатор);
	Ожидаем.Что(Хранилище.ЧтенийПоИдентификатору() > 0,
		"счётчик чтений не слеп: по идентификатору читать приходится").ЭтоИстина();

КонецПроцедуры

// Числа зеркалирования в хабе — РОВНО те десять, что называет ЧислаЗеркалирования.
// Ключ сверх них — это второй набор пределов приёма (свои max_artifact_bytes и соседи),
// снятая ручка «инстанс один» либо крутилка частоты записи прогресса: всё это владелец
// снял, и появление любого из них снова расщепляет управление на два места.
&Тест
Процедура ЧиселЗеркалированияВРеестреРовноДесятьИТеСамые() Экспорт

	Правила = Новый ВидыПроверок();
	Реестр = Новый РеестрНастроек(Правила, Новый НастройкиПодсистем(Правила));
	Ожидаемые = Новый Соответствие();
	Для Каждого Ключ Из Новый ЧислаЗеркалирования().Ключи() Цикл
		Ожидаемые.Вставить(НРег(Ключ), Истина);
	КонецЦикла;

	Лишние = Новый Массив();
	Мирроровых = 0;
	Для Каждого Ключ Из Реестр.Ключи() Цикл
		Если Лев(НРег(Ключ), 13) <> "oshub.mirror." Тогда
			Продолжить;
		КонецЕсли;
		Мирроровых = Мирроровых + 1;
		Если Ожидаемые.Получить(НРег(Ключ)) = Неопределено Тогда
			Лишние.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"лишних чисел зеркалирования в реестре нет").Равно("");
	Ожидаем.Что(Мирроровых, "и ни одно из десяти не потеряно").Равно(Ожидаемые.Количество());

КонецПроцедуры

// Разворот владельца 2026-08-07: из интерфейса правится РУБИЛЬНИК подсистемы —
// «синхронизируем или нет», — а девять чисел темпа и квот задаёт тот, кто разворачивает.
// Ключа, которого нет в реестре, не видно на экране вовсе, поэтому в реестре — все десять.
&Тест
Процедура ИзИнтерфейсаПравитсяРубильникЗеркалАНеЕгоЧисла() Экспорт

	Правила = Новый ВидыПроверок();
	Реестр = Новый РеестрНастроек(Правила, Новый НастройкиПодсистем(Правила));
	Числа = Новый ЧислаЗеркалирования();

	Незнакомые = Новый Массив();
	Правимые = Новый Массив();
	Для Каждого Ключ Из Числа.Ключи() Цикл
		Если НЕ Реестр.Есть(Ключ) Тогда
			Незнакомые.Добавить(Ключ);
			Продолжить;
		КонецЕсли;
		Если Реестр.ЭтоПрикладная(Ключ) Тогда
			Правимые.Добавить(НРег(Ключ));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Числа.Ключи().Количество(), "чисел зеркалирования десять").Равно(10);
	Ожидаем.Что(СтрСоединить(Незнакомые, ", "),
		"числа зеркалирования, которых реестр не знает: их не видно и карточкой").Равно("");
	Ожидаем.Что(СтрСоединить(Правимые, ", "),
		"из интерфейса правится ровно рубильник синхронизации")
		.Равно("oshub.mirror.sync_enabled");

КонецПроцедуры

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция &Лог до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.зеркала");
КонецФункции

// Служба зеркал с ВКЛЮЧЁННОЙ пробой поверх фейкового транспорта.
Функция НовыйСервисСПробой(Знач Транспорт)

	Хранилище = Новый ФейкХранилищеЗеркал();
	Числа = ЧислаЗеркал(9);
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси(20, Ложь, 60, 300, 5, Истина);

	Пробники = Новый Массив();
	Пробники.Добавить(Новый ПробникИсточника(
		Новый КлиентАпстрима(Транспорт, Настройки, ЛогТестов()), Настройки, ЛогТестов()));

	Возврат Новый СервисЗеркал(
		Хранилище,
		Новый ФейкСервисПрав(),
		НовыйВалидатор(),
		Новый ЗаведениеИсточника(Неопределено, Пробники),
		Новый ПрогонЗеркала(Хранилище, Новый ПриведениеЧисел(),
			Дроссель(10, 2), Числа,
			Новый СчётчикиОбхода(Новый ПриведениеЧисел())),
		Числа, Новый РазборНастроекЗеркала(Числа));

КонецФункции

Функция НовыйСервис(Знач МаксНаПул)
	Хранилище = Новый ФейкХранилищеЗеркал();
	Числа = ЧислаЗеркал(МаксНаПул);
	Возврат Новый СервисЗеркал(
		Хранилище,
		Новый ФейкСервисПрав(),
		НовыйВалидатор(),
		Новый ЗаведениеИсточника(),
		Новый ПрогонЗеркала(Хранилище, Новый ПриведениеЧисел(),
			Дроссель(10, 2), Числа,
			Новый СчётчикиОбхода(Новый ПриведениеЧисел())),
		Числа, Новый РазборНастроекЗеркала(Числа));
КонецФункции

// Числа зеркалирования из настроек хаба: сервис спрашивает их на каждом вызове,
// поэтому заглушка настроек — единственный способ их задать.
Функция ЧислаЗеркал(Знач МаксНаПул)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.max_per_pool", МаксНаПул);
	Настройки.Задать("oshub.mirror.default_interval_sec", 3600);
	Настройки.Задать("oshub.mirror.min_interval_sec", 60);
	Настройки.Задать("oshub.mirror.run_stale_sec", 900);
	Возврат Новый ЧислаЗеркалирования(Настройки);
КонецФункции

// Дроссель с заданным темпом — тестовый шов: в боевом контейнере темп фиксирован.
Функция Дроссель(Знач Элементов, Знач Секунд)
	Результат = Новый ДроссельПрогресса(Новый ПриведениеЧисел());
	Результат.УстановитьТемп(Элементов, Секунд);
	Возврат Результат;
КонецФункции

Функция НовыйВалидатор()
	Возврат Новый ВалидаторАдресаАпстрима();
КонецФункции

Функция Владелец()
	Возврат Новый Структура("Идентификатор, Админ", 100, Истина);
КонецФункции

Функция Чужак()
	Возврат Новый Структура("Идентификатор, Админ", 200, Ложь);
КонецФункции

Функция Пул(Знач Ид)
	Возврат ПулТипа(Ид, "custom");
КонецФункции

// Заглушка пула — КЛАСС, а не Структура: гейты источников спрашивают предикат АпстримыДопустимы(),
// а приёмник зеркала определяется колонкой «принимает публикации».
Функция ПулТипа(Знач Ид, Знач Тип, Знач ПубликацияРазрешена = Истина)
	Возврат Новый ПулЗаглушка(Ид, "пул-" + Формат(Ид, "ЧГ=0"), Тип, 0, ПубликацияРазрешена);
КонецФункции

// Причина отказа либо "" — текст, а не Булево: «поймали хоть что-нибудь» зеленело бы и при снесённом гейте.
Функция ПричинаОтказаСоздания(Знач Сервис, Знач Кто, Знач Пул, Знач URL)
	Попытка
		Сервис.Создать(Кто, Пул, URL, "opm", "", 0);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ПопыткаСоздать(Знач Сервис, Знач Кто, Знач Пул, Знач URL)
	Возврат ПопыткаСоздатьПолн(Сервис, Кто, Пул, URL, "opm", "", 0);
КонецФункции

Функция ПопыткаСоздатьПолн(Знач Сервис, Знач Кто, Знач Пул, Знач URL, Знач Режим, Знач Фильтр, Знач Интервал)
	Попытка
		Сервис.Создать(Кто, Пул, URL, Режим, Фильтр, Интервал);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ПопыткаМутации(Знач Сервис, Знач Действие, Знач Кто, Знач Пул, Знач Ид)
	Попытка
		Если Действие = "удалить" Тогда
			Сервис.Удалить(Кто, Пул, Ид);
		ИначеЕсли Действие = "задать-токен" Тогда
			Сервис.ЗадатьТокен(Кто, Пул, Ид, "sekret-42");
		ИначеЕсли Действие = "снять-токен" Тогда
			Сервис.СнятьТокен(Кто, Пул, Ид);
		Иначе
			Сервис.Переключить(Кто, Пул, Ид, Ложь);
		КонецЕсли;
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Настройки подписок для прямой сборки вне контейнера — умолчания реестра.
Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Возврат Настройки;
КонецФункции
