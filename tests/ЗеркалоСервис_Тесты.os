// Юнит-тесты СервисаЗеркал и ВалидатораАдресаАпстрима (модуль зеркала): права, пул назначения,
// SSRF апстрим-URL, уникальность/лимит/режим/фильтр, изоляция чужого пула.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогMirror;
Перем КаталогWebhooks;
Перем КаталогCommon;
Перем КаталогНастроек;
Перем КаталогФикстур;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогMirror = ОбъединитьПути(КаталогМодулей, "зеркала", "Классы");
	КаталогWebhooks = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");
	КаталогCommon = ОбъединитьПути(КаталогМодулей, "основа", "Классы");
	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогMirror, "СервисЗеркал");
	ПоискКлассов.Подключить(КаталогMirror, "ВалидаторАдресаАпстрима");
	ПоискКлассов.Подключить(КаталогMirror, "ПрогонЗеркала");
	ПоискКлассов.Подключить(КаталогMirror, "ДроссельПрогресса");
	ПоискКлассов.Подключить(КаталогMirror, "ЧислаЗеркалирования");
	ПоискКлассов.Подключить(КаталогMirror, "СчётчикиОбхода");
	ПоискКлассов.Подключить(КаталогMirror, "СрезОбхода");
	ПоискКлассов.Подключить(КаталогMirror, "РазборНастроекЗеркала");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "НастройкиЗаглушка.os"));
	ПоискКлассов.Подключить(КаталогCommon, "ПриведениеЧисел");
	ПоискКлассов.Подключить(КаталогCommon, "ВнедрённыеЖелуди");
	ПоискКлассов.Подключить(КаталогCommon, "ЗаголовкиHTTP");
	ПоискКлассов.Подключить(КаталогCommon, "ТекстОшибки");
	ПоискКлассов.Подключить(КаталогCommon, "РазборАдреса");
	ПоискКлассов.Подключить(КаталогCommon, "ТихаяУборка");
	ПоискКлассов.Подключить(КаталогWebhooks, "ВалидаторАдресаВебхука");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкХранилищеЗеркал.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкЗеркалоЗапись.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкСервисПрав.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкРазрешительImён.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "НастройкиЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ПулЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогНастроек, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогНастроек, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогНастроек, "РеестрНастроек.os"));
	КаталогМодулей_ = Новый Файл(Новый Файл(КаталогMirror).Путь).Путь;
	КаталогПрокси = ОбъединитьПути(ОбъединитьПути(КаталогМодулей_, "прокси"), "Классы");
	КаталогЖурнала = ОбъединитьПути(ОбъединитьПути(
		ОбъединитьПути(КаталогМодулей_, "наблюдаемость"), "Классы"), "журнал");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогЖурнала, "ОбезличиваниеЖурнала.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПрокси, "СекретИсточника.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПрокси, "КлиентАпстрима.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПрокси, "ПробникИсточника.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкТранспортИсточника.os"));
КонецПроцедуры

&Тест
Процедура ВладелецСоздаётЗеркало() Экспорт
	Сервис = НовыйСервис(3);
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/", "opm");
	Ожидаем.Что(Зеркало.Включено, "новое зеркало включено").ЭтоИстина();
	Ожидаем.Что(Зеркало.ПулНазначенияИдентификатор, "привязано к пулу").Равно(7);
	Ожидаем.Что(Зеркало.Режим, "режим сохранён").Равно("opm");
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "зеркало сохранено").Равно(1);
КонецПроцедуры

&Тест
Процедура НеВладелецНеМожетСоздать() Экспорт
	Сервис = НовыйСервис(3);
	Ожидаем.Что(ПопыткаСоздать(Сервис, Чужак(), Пул(7), "http://hub.example/"),
		"не-владелец не создаёт зеркало").ЭтоИстина();
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "зеркало не создано").Равно(0);
КонецПроцедуры

&Тест
Процедура НеВладелецНеМожетУдалитьИлиПереключить() Экспорт
	Сервис = НовыйСервис(3);
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://hub.example/");
	Ожидаем.Что(ПопыткаМутации(Сервис, "удалить", Чужак(), Пул(7), Зеркало.Идентификатор),
		"чужак не удаляет").ЭтоИстина();
	Ожидаем.Что(ПопыткаМутации(Сервис, "переключить", Чужак(), Пул(7), Зеркало.Идентификатор),
		"чужак не переключает").ЭтоИстина();
	Ожидаем.Что(ПопыткаМутации(Сервис, "задать-токен", Чужак(), Пул(7), Зеркало.Идентификатор),
		"чужак не задаёт токен доступа").ЭтоИстина();
	Ожидаем.Что(ПопыткаМутации(Сервис, "снять-токен", Чужак(), Пул(7), Зеркало.Идентификатор),
		"чужак не снимает токен доступа").ЭтоИстина();
КонецПроцедуры

// Выключенная публикация закрывает пул для ЛЮДЕЙ, а не для хаба: копию, которую хаб тянет
// с названного администратором апстрима, публикацией со стороны никто не подавал.
&Тест
Процедура ЗеркалоЗаводитсяВПулеБезПубликации() Экспорт

	Сервис = НовыйСервис(3);
	Закрытый = ПулТипа(7, "custom", Ложь);

	Зеркало = Сервис.Создать(Владелец(), Закрытый, "http://hub.example/download/");

	Ожидаем.Что(Зеркало.Включено, "зеркало пулу без публикации заведено и включено").ЭтоИстина();
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "и попало в список пула").Равно(1);

	// КОНТРОЛЬ: тот же пул с публикацией ведёт себя так же — признак на путь зеркала
	// не влияет ни одной стороной
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), ПулТипа(8, "custom", Истина),
		"http://hub.example/download/"), "КОНТРОЛЬ: открытому пулу отказа тоже нет").ЭтоЛожь();

КонецПроцедуры

// Зеркало — ещё один путь к внешнему источнику: личное пространство раздаётся автоматически и
// публикации принимает, поэтому спрашивается ТОТ ЖЕ предикат типа, что у апстримов.
&Тест
Процедура ЛичныйПулЗеркалоНеПринимает() Экспорт

	Сервис = НовыйСервис(3);
	Причина = ПричинаОтказаСоздания(Сервис, Владелец(), ПулТипа(7, "user"), "http://hub.example/");

	Ожидаем.Что(Причина, "отказ по ТИПУ пула, а не по правам или публикации").Содержит("личное пространство");
	Ожидаем.Что(Причина, "названа структурность запрета").Содержит("структурный");
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "зеркало не создано").Равно(0);

	Сервис.Создать(Владелец(), ПулТипа(8, "custom"), "http://hub.example/download/");
	Ожидаем.Что(Сервис.СписокПула(8).Количество(), "обычный пул зеркало принимает").Равно(1);

КонецПроцедуры

&Тест
Процедура HTTPиHTTPSРазрешены() Экспорт
	Сервис = НовыйСервис(5);
	Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/");
	Сервис.Создать(Владелец(), Пул(7), "https://other.example/download/");
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "http и https приняты").Равно(2);
КонецПроцедуры

&Тест
Процедура НедопустимаяСхемаИUserinfoОтклонены() Экспорт
	Сервис = НовыйСервис(5);
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Пул(7), "ftp://hub.example/"), "ftp отклонён").ЭтоИстина();
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Пул(7), "file:///etc/passwd"), "file отклонён").ЭтоИстина();
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Пул(7), "http://user@hub.example/"), "userinfo отклонён").ЭтоИстина();
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "ничего не создано").Равно(0);
КонецПроцедуры

// Правило одно для источника пула и для зеркала: адрес, по которому не удалось подключиться,
// не сохраняется (НФТ-АПСТ-001). Сети в наборе нет: транспорт — фейк.
&Тест
Процедура ЗеркалоНеЗаводитсяБезУдачногоПодключения() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://dead.example/download/list.txt", "Connection refused");
	Транспорт.ПриАдресе("http://alive.example/download/list.txt", 200, "alpha");
	Сервис = НовыйСервисСПробой(Транспорт);

	Отказ = "";
	Попытка
		Сервис.Создать(Владелец(), Пул(7), "http://dead.example/download/");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "не подключился — назвали, что именно").Содержит("не удалось подключиться");
	Ожидаем.Что(Отказ, "названа причина").Содержит("соединение отбито");
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "зеркало не сохранено").Равно(0);

	Сервис.Создать(Владелец(), Пул(7), "http://alive.example/download/");
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "ответивший источник заведён").Равно(1);

КонецПроцедуры

// ИСТ-АПСТ-006: правило одно для источника пула и для зеркала — проба идёт тем доступом,
// с которым апстрим будет читаться дальше.
&Тест
Процедура ПробаЗеркалаИдётСЕгоТокеном() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://private.example/download/list.txt", 200, "alpha");
	Сервис = НовыйСервисСПробой(Транспорт);

	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://private.example/download/", "opm",
		"", 0, "sekret-42");

	Ожидаем.Что(Транспорт.Заголовок("Authorization"),
		"проба пришла к апстриму с токеном зеркала").Равно("Bearer sekret-42");
	Ожидаем.Что(Зеркало.ТокенДоступа, "токен сохранён у зеркала").Равно("sekret-42");

КонецПроцедуры

// Источник не пустил — это не «источник лежит»: администратору говорят про доступ.
&Тест
Процедура ЗеркалоНеЗаводитсяПоОтказуВДоступеСВнятнойПричиной() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://private.example/download/list.txt", 401);
	Сервис = НовыйСервисСПробой(Транспорт);

	Отказ = "";
	Попытка
		Сервис.Создать(Владелец(), Пул(7), "http://private.example/download/");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "названо, что источник не пустил").Содержит("источник не пустил");
	Ожидаем.Что(Отказ, "и что делать").Содержит("задайте токен доступа");
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "зеркало не сохранено").Равно(0);

КонецПроцедуры

// Токен зеркала задаётся и снимается отдельными операциями: пустое поле и маска означают
// «оставить прежний», иначе сохранение неизменённой формы стирало бы секрет.
&Тест
Процедура ТокенЗеркалаЗадаётсяМаскойНеПодменяетсяИСнимается() Экспорт

	Сервис = НовыйСервис(9);
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://private.example/download/", "opm",
		"", 0, "sekret-42");

	Ожидаем.Что(Сервис.ЗадатьТокен(Владелец(), Пул(7), Зеркало.Идентификатор, ""),
		"зеркало найдено").ЭтоИстина();
	Ожидаем.Что(Сервис.ЗеркалоПула(Пул(7), Зеркало.Идентификатор).ТокенДоступа,
		"пустое поле означает «оставить прежний»").Равно("sekret-42");

	Сервис.ЗадатьТокен(Владелец(), Пул(7), Зеркало.Идентификатор, "•••");
	Ожидаем.Что(Сервис.ЗеркалоПула(Пул(7), Зеркало.Идентификатор).ТокенДоступа,
		"пришедшая обратно маска токен не подменяет").Равно("sekret-42");

	Сервис.ЗадатьТокен(Владелец(), Пул(7), Зеркало.Идентификатор, "sekret-77");
	Ожидаем.Что(Сервис.ЗеркалоПула(Пул(7), Зеркало.Идентификатор).ТокенДоступа,
		"новое значение токен меняет").Равно("sekret-77");

	Сервис.СнятьТокен(Владелец(), Пул(7), Зеркало.Идентификатор);
	Ожидаем.Что(Сервис.ЗеркалоПула(Пул(7), Зеркало.Идентификатор).ТокенДоступа,
		"снятие возвращает анонимное чтение").Равно("");

КонецПроцедуры

// Токен непригодный как заголовок авторизации не сохраняется вовсе: перевод строки внутри
// него — это подделка чужого заголовка.
&Тест
Процедура ТокенСПереводомСтрокиОтвергается() Экспорт

	Сервис = НовыйСервис(9);
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "http://private.example/download/");

	Отказ = "";
	Попытка
		Сервис.ЗадатьТокен(Владелец(), Пул(7), Зеркало.Идентификатор,
			"sekret" + Символы.ПС + "X-Forwarded-For: 10.0.0.1");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "названо, каким токен быть обязан").Содержит("печатных символов латиницы");
	Ожидаем.Что(Сервис.ЗеркалоПула(Пул(7), Зеркало.Идентификатор).ТокенДоступа,
		"негодное значение не сохранено").Равно("");

КонецПроцедуры

// Правило одно для источника пула и для зеркала: сеть, в которой живёт адрес, не судится
// ни там, ни там — её выбирает администратор пула (ИСТ-АПСТ-004).
&Тест
Процедура ЗеркалоНаЛюбуюСетьПринимается() Экспорт
	Сервис = НовыйСервис(9);
	Сервис.Создать(Владелец(), Пул(7), "http://127.0.0.1/download/");
	Сервис.Создать(Владелец(), Пул(7), "http://169.254.169.254/download/");
	Сервис.Создать(Владелец(), Пул(7), "http://10.0.0.5/download/");
	Сервис.Создать(Владелец(), Пул(7), "http://[fe80::1]/download/");
	Сервис.Создать(Владелец(), Пул(7), "http://intranet.corp:8081/download/");
	Ожидаем.Что(Сервис.СписокПула(7).Количество(),
		"ноль отвергнутых по признаку сети назначения").Равно(5);
КонецПроцедуры

&Тест
Процедура ДубльАпстримаВПулеОтклонён() Экспорт
	Сервис = НовыйСервис(5);
	Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/");
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Пул(7), "http://HUB.example/download/"),
		"дубль апстрима (регистр хоста) отклонён").ЭтоИстина();
	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "второй не создан").Равно(1);
КонецПроцедуры

// Записи в базе могли лечь по ПРЕЖНЕМУ правилу канона (он опускал только регистр):
// явный «:443», точечные сегменты, «%64» вместо буквы. Сличение точным равенством строк
// такую запись дублем не считает — и в пуле появляется второе зеркало на тот же апстрим.
// Канон применяется к ОБЕИМ сторонам.
&Тест
Процедура ЗеркалоПрежнегоКанонаСчитаетсяДублем() Экспорт

	ПрежниеФормы = Новый Массив();
	ПрежниеФормы.Добавить("https://hub.example:443/download/");
	ПрежниеФормы.Добавить("https://hub.example/pub/../download/");
	ПрежниеФормы.Добавить("https://hub.example/%64ownload/");

	Для Каждого Прежняя Из ПрежниеФормы Цикл

		Сервис = НовыйСервис(5);
		Сервис.Создать(Владелец(), Пул(7), "https://hub.example/download/");
		ПодменитьАпстрим(Сервис, Прежняя);

		Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Пул(7), "https://hub.example/download/"),
			"«" + Прежняя + "» — тот же апстрим, а не второй").ЭтоИстина();
		Ожидаем.Что(Сервис.СписокПула(7).Количество(),
			"второго зеркала не появилось").Равно(1);

	КонецЦикла;

КонецПроцедуры

// Кладёт адрес в базу МИМО сервиса — так в ней оказались записи прежнего канона.
Процедура ПодменитьАпстрим(Знач Сервис, Знач Адрес)

	Зеркало = Сервис.СписокПула(7)[0];
	Зеркало.АпстримURL = Адрес;
	Зеркало.Сохранить();

КонецПроцедуры

// ОСень отдаёт необязательный желудь тремя способами, и все три обязаны читаться одинаково:
// иначе настройки хаба молча перестают действовать (число берётся из умолчания кода при
// живом СервисеНастроек) либо контейнер без настроек роняет зеркалирование целиком.
&Тест
Процедура НеобязательныйЖелудьЧитаетсяВоВсехТрёхФормахВнедрения() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.max_per_pool", 11);

	// ВТОРОЙ кандидат в массиве обязателен: на массиве из одного элемента «берём первый»
	// и «берём последний» неразличимы, и выбор желудя не стерёг бы никто
	Запасные = Новый НастройкиЗаглушка();
	Запасные.Задать("oshub.mirror.max_per_pool", 77);
	Массивом = Новый Массив();
	Массивом.Добавить(Настройки);
	Массивом.Добавить(Запасные);

	Ожидаем.Что(Новый ЧислаЗеркалирования(Настройки).ЗеркалНаПул(),
		"сам желудь").Равно(11);
	Ожидаем.Что(Новый ЧислаЗеркалирования(Массивом).ЗеркалНаПул(),
		"кандидатов несколько — берётся ПЕРВЫЙ, а не любой из них").Равно(11);
	Ожидаем.Что(Новый ЧислаЗеркалирования(Новый Массив()).ЗеркалНаПул(),
		"настроек в контейнере нет — умолчание кода, а не падение").Равно(5);
	Ожидаем.Что(Новый ЧислаЗеркалирования().ЗеркалНаПул(),
		"желудя не передали вовсе").Равно(5);

КонецПроцедуры

// Канонизация трогает РОВНО схему и хост: они у адреса регистронезависимы, а путь и query —
// нет. Опущенный целиком адрес увёл бы зеркало на несуществующий каталог выдачи, поднятый
// целиком — расплодил бы дубли на одном апстриме.
&Тест
Процедура КанонизируетсяСхемаИХостАПутьОстаётсяКакЕсть() Экспорт

	Сервис = НовыйСервис(5);
	Зеркало = Сервис.Создать(Владелец(), Пул(7), "  HTTP://HUB.Example:8080/Download/Corp?Tag=Rc  ");

	Ожидаем.Что(Зеркало.АпстримURL, "схема и хост в нижнем регистре, путь и query нетронуты")
		.Равно("http://hub.example:8080/Download/Corp?Tag=Rc");

	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Пул(7), "hTTp://Hub.EXAMPLE:8080/Download/Corp?Tag=Rc"),
		"тот же апстрим в другом регистре схемы и хоста — дубль").ЭтоИстина();
	Ожидаем.Что(ПопыткаСоздать(Сервис, Владелец(), Пул(7), "http://hub.example:8080/download/corp?Tag=Rc"),
		"путь в другом регистре — ДРУГОЙ каталог выдачи, а не дубль").ЭтоЛожь();

	Ожидаем.Что(Сервис.СписокПула(7).Количество(), "заведено ровно два зеркала").Равно(2);

КонецПроцедуры

&Тест
Процедура ТотЖеАпстримВРазныхПулахДопустим() Экспорт
	Сервис = НовыйСервис(5);
	Сервис.Создать(Владелец(), Пул(7), "http://hub.example/download/");
	Сервис.Создать(Владелец(), Пул(8), "http://hub.example/download/");
	Ожидаем.Что(Сервис.СписокПула(8).Количество(), "тот же апстрим в другом пуле допустим").Равно(1);
КонецПроцедуры

