// След правок пульта журнала в журнале аудита: одна правка — одно событие через шину, как
// у остальных мутаций настроек; кто, над каким ключом, с какого значения на какое и какие логи.

#Использовать asserts
#Использовать "фикстуры"

&ТестовыйНабор
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = КаталогМодулей();
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ШкалаЖурнала");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ЛетописьПультаЖурнала");

КонецПроцедуры

&Тест
Процедура ГрупповаяПравкаУровняОднимСобытиемСоВсемиЛогами() Экспорт

	Когда = Дата(2026, 9, 28, 10, 11, 12);
	Правка = Правка("уровень", "admin1", Когда, "DEBUG");
	Правка.Было.Вставить("СервисНастроек", "INFO");
	Правка.Было.Вставить("КонтроллерНастроекХабаAPI", "WARN");
	Правка.Пропущены.Добавить("аудит");

	События = Записать(Правка);

	Ожидаем.Что(События.Количество(), "одна правка — одно событие").Равно(1);
	Событие = События[0];
	Ожидаем.Что(Событие.Тип, "событие настроек, которое пишет служба аудита").Равно("настройка.изменена");
	Ожидаем.Что(Событие.Когда, "момент самой правки").Равно(Когда);
	Ожидаем.Что(Событие.Данные.Кто).Равно("admin1");
	Ожидаем.Что(Событие.Данные.Действие).Равно("логи.уровень.изменён");
	Ожидаем.Что(Событие.Данные.Объект, "ключ уровней логов").Равно("настройка/oshub.log.levels");
	Ожидаем.Что(Событие.Данные.АдресIP, "адрес клиента").Равно("203.0.113.7");

	Детали = Детали(Событие);
	Ожидаем.Что(СтрСоединить(Детали["логи"], ","), "какие логи затронуты")
		.Равно("СервисНастроек,КонтроллерНастроекХабаAPI");
	Ожидаем.Что(Детали["было"]["КонтроллерНастроекХабаAPI"], "с какого — по каждому логу").Равно("WARN");
	Ожидаем.Что(Детали["стало"], "на какое").Равно("DEBUG");
	Ожидаем.Что(СтрСоединить(Детали["пропущены"], ","), "кого правка не тронула").Равно("аудит");

КонецПроцедуры

&Тест
Процедура ПравкаКорняПишетсяОКлючеКорня() Экспорт

	Правка = Правка("уровень", "root", ТекущаяУниверсальнаяДата(), "WARN");
	Правка.Было.Вставить("rootLogger", "INFO");

	Событие = Записать(Правка)[0];

	Ожидаем.Что(Событие.Данные.Объект).Равно("настройка/oshub.log.level");
	Ожидаем.Что(Детали(Событие).Получить("пропущены"), "пропущенных нет — и поля нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПравкаОтправкиПишетсяОКлючахКоллектора() Экспорт

	Правка = Правка("отправка", "root", ТекущаяУниверсальнаяДата(), Новый Соответствие());
	Правка.Было.Вставить("СервисНастроек", "DEBUG");
	Правка.Стало.Вставить("СервисНастроек", "DISABLE");
	Событие = Записать(Правка)[0];
	Ожидаем.Что(Событие.Данные.Действие).Равно("логи.коллектор.изменён");
	Ожидаем.Что(Событие.Данные.Объект).Равно("настройка/oshub.log.otel.levels");

	Корня = Правка("отправка", "root", ТекущаяУниверсальнаяДата(), Новый Соответствие());
	Корня.Было.Вставить("rootLogger", "DEBUG");
	Корня.Стало.Вставить("rootLogger", "WARN");
	Ожидаем.Что(Записать(Корня)[0].Данные.Объект).Равно("настройка/oshub.log.otel.level");

КонецПроцедуры

&Тест
Процедура ВозвратПишетБылоИСталоПоЛогам() Экспорт

	Правка = Правка("возврат", "root", ТекущаяУниверсальнаяДата(), Новый Соответствие());
	Правка.Возвращено = "всё";
	Правка.Было.Вставить("СервисНастроек", Новый Структура("Уровень, Отправка", "DEBUG", "DISABLE"));
	Правка.Стало.Вставить("СервисНастроек", Новый Структура("Уровень, Отправка", "INFO", "DEBUG"));

	Событие = Записать(Правка)[0];

	Ожидаем.Что(Событие.Данные.Действие).Равно("логи.возвращены");
	Ожидаем.Что(Событие.Данные.Объект, "вернули уровень и отправку — журнал целиком").Равно("настройка/oshub.log");
	Детали = Детали(Событие);
	Ожидаем.Что(Детали["было"]["СервисНастроек"]["отправка"]).Равно("DISABLE");
	Ожидаем.Что(Детали["стало"]["СервисНастроек"]["уровень"]).Равно("INFO");

	ТолькоОтправка = Правка("возврат", "root", ТекущаяУниверсальнаяДата(), Новый Соответствие());
	ТолькоОтправка.Возвращено = "отправка";
	ТолькоОтправка.Было.Вставить("СервисНастроек", Новый Структура("Уровень, Отправка", "INFO", "DISABLE"));
	ТолькоОтправка.Стало.Вставить("СервисНастроек", Новый Структура("Уровень, Отправка", "INFO", "DEBUG"));
	Ожидаем.Что(Записать(ТолькоОтправка)[0].Данные.Объект, "вернули отправку — объект отправки")
		.Равно("настройка/oshub.log.otel.levels");

КонецПроцедуры

#Область Обвязка

Функция Правка(Знач Что, Знач Кто, Знач Когда, Знач Стало)
	Возврат Новый Структура("Что, Кто, АдресIP, Когда, Было, Стало, Пропущены, Возвращено", Что, Кто,
		"203.0.113.7", Когда, Новый Соответствие(), Стало, Новый Массив(), "");
КонецФункции

// События, которые летопись опубликовала одним вызовом.
Функция Записать(Знач Правка)

	Издатель = Новый ИздательСобытий();
	Подписчик = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипНастройкаИзменена(), Подписчик);
	Летопись = Новый ЛетописьПультаЖурнала(Новый ШкалаЖурнала(), Издатель, Новый ИмяОбъектаАудита(),
		Новый СобытиеАудита(Новый ИмяОбъектаАудита(), Новый ТекстJSON()));

	Летопись.Записать(Правка);
	Возврат Подписчик.События;

КонецФункции

Функция Детали(Знач Событие)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Событие.Данные.ДеталиJSON);
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
