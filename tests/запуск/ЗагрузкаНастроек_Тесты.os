// Загрузка настроек: правила над тем, что прочитал configor, — окружение перебивает файл,
// производные ключи, устройство хаба и умолчания хаба для чужих деталек; имена переменных;
// согласованность с тем, что видит собранная Поделка.

#Использовать asserts
#Использовать autumn
#Использовать packageinfo
#Использовать "../фикстуры"

&ТестовыйНабор
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Модули = КаталогМодулей();
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ИменаПеременныхОкружения");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "УровниЖурнала");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "РасположениеДанных");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "ИсточникиНастроек");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ПриведениеФлагов");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ОписаниеПриложения");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "api", "Классы"), "ПаспортОписанияAPI");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "ЗагрузкаНастроек");

КонецПроцедуры

#Область ОкружениеПеребиваетФайл

&Тест
Процедура ОкружениеПеребиваетФайл() Экспорт

	Файл = ВФайле(Новый Соответствие(), "oshub.storage.root", "./из-файла");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_STORAGE_ROOT", "/из-окружения");

	Загрузка = Загружено(Файл, Окружение);

	Ожидаем.Что(Загрузка.Значение("oshub.storage.root"), "переменная сильнее ключа файла")
		.Равно("/из-окружения");

КонецПроцедуры

&Тест
Процедура ПустоеЗначениеФайлаНеОтменяетПеременную() Экспорт

	// Ключ файла, даже пустой, у configor отбирает переменную: пустой «образец» в файле
	// однажды выключил OSHUB_AUTH_PASSWORD_ENABLED=false.
	Файл = ВФайле(Новый Соответствие(), "oshub.auth.password.enabled", "");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_AUTH_PASSWORD_ENABLED", "false");

	Ожидаем.Что(Загружено(Файл, Окружение).Значение("oshub.auth.password.enabled"))
		.Равно("false");

КонецПроцедуры

&Тест
Процедура ПустаяПеременнаяНичегоНеЗадаёт() Экспорт

	// Процесс не умеет снять переменную, только обнулить: фикстура тестов так и «чистит».
	Файл = ВФайле(Новый Соответствие(), "oshub.pools.default", "public");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_POOLS_DEFAULT", "");

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Файл, КартаПровайдера(Окружение));

	Ожидаем.Что(Загрузка.Значение("oshub.pools.default"), "значение файла на месте").Равно("public");
	Ожидаем.Что(ЕстьКлюч(Детальки, "oshub.pools.default"),
		"пустая переменная программной деталькой не легла").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Производные

&Тест
Процедура ПсевдонимСтавитсяТолькоПриИзвестномИсточнике() Экспорт

	Файл = ВФайле(Новый Соответствие(), "winow.Порт", 3333);

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Файл, Новый Соответствие());
	Ожидаем.Что(ЕстьКлюч(Детальки, "winow.Порт"), "без источника производной нет").ЭтоЛожь();
	Ожидаем.Что(ЕстьКлюч(Детальки, "otel.entity.query-text"), "и у дефисного ключа тоже").ЭтоЛожь();
	Ожидаем.Что(Загрузка.Значение("winow.Порт"), "порт — из файла").Равно(3333);

КонецПроцедуры

// Правило одно: сначала источник (окружение сильнее файла), при одном источнике родное
// имя сильнее псевдонима.
&Тест
Процедура ПсевдонимИзОкруженияСильнееРодногоИмениИзФайла() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_PORT", "4242");

	Ожидаем.Что(Загружено(ВФайле(Новый Соответствие(), "winow.Порт", 3333), Окружение).Значение("winow.Порт"),
		"источник важнее имени; порт приходит числом").Равно(4242);

КонецПроцедуры

&Тест
Процедура ВФайлеРодноеИмяСильнееПсевдонима() Экспорт

	Файл = ВФайле(ВФайле(Новый Соответствие(), "winow.Порт", 3333), "oshub.port", 4343);

	Ожидаем.Что(Загружено(Файл, Новый Соответствие()).Значение("winow.Порт"),
		"при одном источнике родное имя сильнее").Равно(3333);

КонецПроцедуры

&Тест
Процедура ПсевдонимИзФайлаДействуетКогдаРодногоИмениНет() Экспорт

	Ожидаем.Что(Загружено(ВФайле(Новый Соответствие(), "oshub.port", 4343), Новый Соответствие())
		.Значение("winow.Порт"),
		"псевдоним — обычный ключ configor, и из файла он тоже действует").Равно(4343);

КонецПроцедуры

&Тест
Процедура РодноеИмяЦелиСильнееПсевдонима() Экспорт

	// docker и k8s умеют переменную с дефисом — родное имя ключа autumn-opentelemetry
	Файл = ВФайле(Новый Соответствие(), "otel.entity.query-text", "из-файла");
	ВФайле(Файл, "otel.entity.query.text", "псевдоним-из-файла");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OTEL_ENTITY_QUERY_TEXT", "true");
	Окружение.Вставить("OTEL_ENTITY_QUERY-TEXT", "false");

	Ожидаем.Что(Загружено(Файл, Окружение).Значение("otel.entity.query-text"),
		"родное имя из окружения сильнее всего").Равно("false");

КонецПроцедуры

&Тест
Процедура НечисловойПортНеПереноситсяИНазванЗамечанием() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_PORT", "восемьдесят");

	Загрузка = Загружено(ВФайле(Новый Соответствие(), "winow.Порт", 3333), Окружение);

	Ожидаем.Что(Загрузка.Значение("winow.Порт"), "порт остался файловым").Равно(3333);
	Ожидаем.Что(СтрНайти(СтрСоединить(Загрузка.Замечания(), Символы.ПС), "OSHUB_PORT=восемьдесят") > 0,
		"замечание называет переменную и значение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УзелБазыСливаетсяЛистКЛисту() Экспорт

	// Лист окружения, для которого псевдонима нет, не теряется: узел собирается из всех
	// листьев под префиксом, а не из двух известных.
	Файл = УзелБазыВФайле("КоннекторJSON", "./data/entities");
	Окружение = Новый Соответствие();
	Окружение.Вставить("data_ИсточникиДанных_РазмерПула", "20");

	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел.Количество(), "в узле три листа").Равно(3);
	Ожидаем.Что(Узел["РазмерПула"], "лист из окружения — числом: пул entity строку не примет")
		.Равно(20);
	Ожидаем.Что(Узел["ТипКоннектора"], "листья файла на месте").Равно("КоннекторJSON");
	Ожидаем.Что(Узел["СтрокаСоединения"]).Равно("./data/entities");

КонецПроцедуры

&Тест
Процедура ПсевдонимыБазыЛожатсяНаЛистыУзла() Экспорт

	Файл = УзелБазыВФайле("КоннекторJSON", "./data/entities");
	ВФайле(Файл, "data.ИсточникиДанных.РазмерПула", 5);
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", "/врем/база");

	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел["СтрокаСоединения"], "псевдоним заменил свой лист").Равно("/врем/база");
	Ожидаем.Что(Узел["ТипКоннектора"], "коннектор файла на месте").Равно("КоннекторJSON");
	Ожидаем.Что(Узел["РазмерПула"], "чужой лист файла не тронут").Равно(5);

КонецПроцедуры

&Тест
Процедура ЛистПарыИзОкруженияЗаменяетТолькоСвойЛист() Экспорт

	// Между окружением и файлом пара «коннектор, строка» сливается лист к листу, как весь узел.
	Файл = УзелБазыВФайле("КоннекторSQLite", "Data Source=/файл/openhub.db");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", "Data Source=/окружение/openhub.db");

	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел["ТипКоннектора"], "коннектор файла остался при строке из окружения")
		.Равно("КоннекторSQLite");
	Ожидаем.Что(Узел["СтрокаСоединения"], "строка — из окружения")
		.Равно("Data Source=/окружение/openhub.db");

КонецПроцедуры

&Тест
Процедура КоннекторИзФайлаИСтрокаИзОкруженияСобираютсяВУзел() Экспорт

	// Несекретное оператор держит в файле, строку с паролем — в переменной.
	Корень = ВременныйКаталог("корень-пары");
	СтрокаСоединения = "Host=127.0.0.1;Port=1;Username=u;Password=проба-"
		+ Строка(Новый УникальныйИдентификатор) + ";Database=d";
	Файл = ВФайле(Новый Соответствие(), "data.ИсточникиДанных.ТипКоннектора", "КоннекторPostgreSQL");
	ВФайле(Файл, "oshub.storage.root", Корень);

	Для Каждого Переменная Из СтрРазделить("OSHUB_DB_CONNECTION,data_ИсточникиДанных_СтрокаСоединения", ",") Цикл

		Окружение = Новый Соответствие();
		Окружение.Вставить(Переменная, СтрокаСоединения);

		Загрузка = Загружено(Файл, Окружение);
		Узел = Загрузка.Значение("data.ИсточникиДанных");
		Ожидаем.Что(Узел["ТипКоннектора"], Переменная + ": коннектор — из файла").Равно("КоннекторPostgreSQL");
		Ожидаем.Что(Узел["СтрокаСоединения"], Переменная + ": строка — из окружения").Равно(СтрокаСоединения);

		Загрузка.СоздатьКаталогиДанных();
		КаталогПоСтроке = Новый Файл(СтрокаСоединения);
		КаталогПоСтрокеСоздан = КаталогПоСтроке.Существует();
		ВКорнеПусто = НайтиФайлы(Корень, ПолучитьМаскуВсеФайлы()).Количество() = 0;
		УдалитьФайлы(Корень);
		Если КаталогПоСтрокеСоздан Тогда
			УдалитьФайлы(КаталогПоСтроке.ПолноеИмя);
		КонецЕсли;

		Ожидаем.Что(КаталогПоСтрокеСоздан,
			Переменная + ": строка соединения нефайловой базы каталогом не стала").ЭтоЛожь();
		Ожидаем.Что(ВКорнеПусто, Переменная + ": в корне данных под базу ничего не создано").ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СтрокаИзФайлаИКоннекторИзОкруженияСобираютсяВУзел() Экспорт

	Файл = ВФайле(Новый Соответствие(), "data.ИсточникиДанных.СтрокаСоединения", "Host=db;Database=openhub");

	Для Каждого Переменная Из СтрРазделить("OSHUB_DB_CONNECTOR,data_ИсточникиДанных_ТипКоннектора", ",") Цикл

		Окружение = Новый Соответствие();
		Окружение.Вставить(Переменная, "КоннекторPostgreSQL");

		Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");
		Ожидаем.Что(Узел["ТипКоннектора"], Переменная + ": коннектор — из окружения").Равно("КоннекторPostgreSQL");
		Ожидаем.Что(Узел["СтрокаСоединения"], Переменная + ": строка — из файла").Равно("Host=db;Database=openhub");

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОднаСтрокаСоединенияБезФайлаДаётРабочийУзел() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", "/врем/база");

	Узел = Загружено(Новый Соответствие(), Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел["ТипКоннектора"], "тип коннектора — умолчание хаба").Равно("КоннекторJSON");
	Ожидаем.Что(Узел["СтрокаСоединения"], "строка — из окружения").Равно("/врем/база");
	Ожидаем.Что(Узел.Количество(), "узел целиком и без лишнего").Равно(2);

КонецПроцедуры

&Тест
Процедура ОдинФайловыйКоннекторПолучаетКаталогВКорнеДанных() Экспорт

	Корень = ОбъединитьПути(КаталогВременныхФайлов(), "корень-коннектора");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторJSON");
	Окружение.Вставить("OSHUB_STORAGE_ROOT", Корень);

	Файл = ВФайле(Новый Соответствие(), "data.ИсточникиДанных.ТипКоннектора", "КоннекторSQLite");
	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");

	Ожидаем.Что(Узел["ТипКоннектора"], "коннектор окружения сильнее файла").Равно("КоннекторJSON");
	Ожидаем.Что(Узел["СтрокаСоединения"], "каталог файловой базы — в корне данных")
		.Равно(ОбъединитьПути(Новый Файл(Корень).ПолноеИмя, "entities"));

КонецПроцедуры

&Тест
Процедура НефайловыйКоннекторБезСтрокиСоединенияОтвергаетсяСразу() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторPostgreSQL");

	Для Каждого Файл Из ФайлыДляБазы() Цикл
		Отказ = ОтказЗагрузки(Файл, Окружение);
		Ожидаем.Что(СтрНайти(Отказ, "для коннектора КоннекторPostgreSQL обязательна строка соединения") > 0,
			"внятная ошибка конфигурации, а не падение в хранилище: " + Отказ).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, "OSHUB_DB_CONNECTION") > 0, "названа переменная: " + Отказ).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КоннекторВПамятиСтрокиСоединенияНеТребует() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторInMemory");

	Узел = Загружено(Новый Соответствие(), Окружение).Значение("data.ИсточникиДанных");
	Ожидаем.Что(Узел["ТипКоннектора"]).Равно("КоннекторInMemory");

КонецПроцедуры

&Тест
Процедура РазмерПулаЗадаётсяПсевдонимомЕслиРодноеИмяМолчит() Экспорт

	Файл = УзелБазыВФайле("КоннекторSQLite", "Data Source=/база.db");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_POOL_SIZE", "15");

	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");
	Ожидаем.Что(Узел["РазмерПула"], "псевдоним лёг на лист узла числом").Равно(15);
	Ожидаем.Что(Узел["ТипКоннектора"], "пара файла на месте").Равно("КоннекторSQLite");

	Окружение.Вставить("data_ИсточникиДанных_РазмерПула", "30");
	Узел = Загружено(Файл, Окружение).Значение("data.ИсточникиДанных");
	Ожидаем.Что(Узел["РазмерПула"], "родное имя сильнее псевдонима").Равно(30);

КонецПроцедуры

&Тест
Процедура НечисловойРазмерПулаНазванЗамечанием() Экспорт

	// замечание называет ключ узла и имя, которым лист задал оператор, — как замечание о порте
	Ключ = "data.ИсточникиДанных.РазмерПула";
	Случаи = Новый Массив();

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_POOL_SIZE", "много");
	Случаи.Добавить(Новый Структура("Файл, Окружение, Название",
		УзелБазыВФайле("КоннекторJSON", "./data/entities"), Окружение, Ключ + " / OSHUB_DB_POOL_SIZE"));

	Окружение = Новый Соответствие();
	Окружение.Вставить("data_ИсточникиДанных_РазмерПула", "много");
	Случаи.Добавить(Новый Структура("Файл, Окружение, Название",
		УзелБазыВФайле("КоннекторJSON", "./data/entities"), Окружение, Ключ + " / data_ИсточникиДанных_РазмерПула"));

	Случаи.Добавить(Новый Структура("Файл, Окружение, Название",
		ВФайле(УзелБазыВФайле("КоннекторJSON", "./data/entities"), Ключ, "много"), Новый Соответствие(), Ключ));

	Случаи.Добавить(Новый Структура("Файл, Окружение, Название",
		ВФайле(УзелБазыВФайле("КоннекторJSON", "./data/entities"), "oshub.db.pool.size", "много"),
		Новый Соответствие(), Ключ + " / oshub.db.pool.size"));

	Для Каждого Случай Из Случаи Цикл
		Загрузка = Загружено(Случай.Файл, Случай.Окружение);
		Замечания = СтрСоединить(Загрузка.Замечания(), Символы.ПС);
		Ожидаем.Что(СтрНайти(Замечания, Случай.Название + "=много не является числом") > 0,
			Случай.Название + ": замечание называет ключ и имя — " + Замечания).ЭтоИстина();
		// пул entity читает узел целиком — лист смотрится в узле, а не плоским ключом
		Ожидаем.Что(Загрузка.Значение("data.ИсточникиДанных").Получить("РазмерПула"),
			Случай.Название + ": строка в пул entity не уехала").Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Размер пула строкой в файле доходит до пула числом: узел ложится деталькой целиком, со всеми
// листьями и вложенными узлами. Узел, где размер уже число, остаётся файловым.
&Тест
Процедура РазмерПулаСтрокойИзФайлаДоходитДоПулаЧислом() Экспорт

	Файл = УзелБазыВФайле("КоннекторJSON", "./data/entities");
	ВФайле(Файл, "data.ИсточникиДанных.РазмерПула", "4");
	ВФайле(Файл, "data.ИсточникиДанных.Параметры.Таймаут", 30);

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Файл, Новый Соответствие());
	Узел = Загрузка.Значение("data.ИсточникиДанных");

	Ожидаем.Что(ЕстьКлюч(Детальки, "data.ИсточникиДанных"), "приведённый узел лёг деталькой").ЭтоИстина();
	Ожидаем.Что(Узел["РазмерПула"], "пул получает число").Равно(4);
	Ожидаем.Что(ТипЗнч(Узел["РазмерПула"]), "именно число, а не строка").Равно(Тип("Число"));
	Ожидаем.Что(Узел["ТипКоннектора"], "коннектор на месте").Равно("КоннекторJSON");
	Ожидаем.Что(Узел["СтрокаСоединения"], "строка соединения на месте").Равно("./data/entities");
	Ожидаем.Что(Узел["Параметры"]["Таймаут"], "вложенный узел на месте").Равно(30);

	Файл = УзелБазыВФайле("КоннекторJSON", "./data/entities");
	ВФайле(Файл, "data.ИсточникиДанных.РазмерПула", 4);

	Загрузка = Новый ЗагрузкаНастроек();
	Детальки = Загрузка.ДеталькиПоверх(Файл, Новый Соответствие());

	Ожидаем.Что(ЕстьКлюч(Детальки, "data.ИсточникиДанных"), "узел с числом из файла не тронут").ЭтоЛожь();
	Ожидаем.Что(Загрузка.Значение("data.ИсточникиДанных")["РазмерПула"]).Равно(4);

КонецПроцедуры

&Тест
Процедура РодныеЛистыБазыОтменяютПсевдонимыЦеликом() Экспорт

	// Образ зашивает пару OSHUB_DB_*: коннектор оператора, названный родным именем, со строкой
	// образа не склеивается. Семейства имён спорят только внутри окружения — с файлом узел
	// по-прежнему сливается лист к листу.
	Окружение = ОкружениеОбраза();
	Окружение.Вставить("data_ИсточникиДанных_ТипКоннектора", "КоннекторInMemory");

	Узел = Загружено(Новый Соответствие(), Окружение).Значение("data.ИсточникиДанных");
	Ожидаем.Что(Узел["ТипКоннектора"], "родной лист").Равно("КоннекторInMemory");
	Ожидаем.Что(Узел["СтрокаСоединения"], "строка соединения образа не приклеилась").Равно(Неопределено);

	Узел = Загружено(УзелБазыВФайле("КоннекторJSON", "./data/entities"), Окружение)
		.Значение("data.ИсточникиДанных");
	Ожидаем.Что(Узел["ТипКоннектора"], "родной лист сильнее файла").Равно("КоннекторInMemory");
	Ожидаем.Что(Узел["СтрокаСоединения"], "строка файла на месте, строка образа не взята")
		.Равно("./data/entities");

КонецПроцедуры

&Тест
Процедура РодноеИмяНефайловогоКоннектораБезСтрокиОтвергаетсяСразу() Экспорт

	Окружение = ОкружениеОбраза();
	Окружение.Вставить("data_ИсточникиДанных_ТипКоннектора", "КоннекторPostgreSQL");

	Отказ = ОтказЗагрузки(Новый Соответствие(), Окружение);

	Ожидаем.Что(СтрНайти(Отказ, "для коннектора КоннекторPostgreSQL обязательна строка соединения") > 0,
		"строка соединения образа к родному коннектору не приклеилась: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "data_ИсточникиДанных_СтрокаСоединения либо") > 0,
		"названо родное имя строки: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "OSHUB_DB_CONNECTION не берётся, пока пара задана родными именами") > 0,
		"сказано, почему заданная переменная образа не взята: " + Отказ).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФайловыйКоннекторСоСтрокойСУБДОтвергаетсяБезЗначенияСтроки() Экспорт

	// Забытый коннектор: умолчание КоннекторJSON превратило бы строку с паролем в каталог базы.
	Секрет = "пароль-" + Строка(Новый УникальныйИдентификатор);
	Строки = Новый Массив();
	Строки.Добавить("Host=127.0.0.1;Port=1;Username=u;Password=" + Секрет + ";Database=d");
	Строки.Добавить("Password=" + Секрет);
	Строки.Добавить("Data Source = /база/" + Секрет + ".db");

	Для Каждого СтрокаСоединения Из Строки Цикл
		Окружение = Новый Соответствие();
		Окружение.Вставить("OSHUB_DB_CONNECTION", СтрокаСоединения);

		Отказ = ОтказЗагрузки(Новый Соответствие(), Окружение);

		Ожидаем.Что(СтрНайти(Отказ, "строка соединения похожа на строку СУБД, а коннектор КоннекторJSON файловый") > 0,
			"отказ конфигурации, а не файловая база в каталоге с паролем: " + Отказ).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, "OSHUB_DB_CONNECTOR") > 0, "названо, где задать коннектор: " + Отказ)
			.ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, "Коннектор — умолчание хаба; строка соединения — переменная OSHUB_DB_CONNECTION") > 0,
			"названо, откуда пришёл каждый лист: " + Отказ).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, Секрет), "значения строки в тексте нет").Равно(0);
	КонецЦикла;

КонецПроцедуры

// Коннектор-умолчание значит, что коннектор забыт, — совет задать коннектор. Файловый коннектор,
// заданный явно (проектный файл с КоннекторJSON и строка PostgreSQL переменной, КоннекторJSON поверх
// образа), ошибся либо коннектором, либо строкой — советов два.
&Тест
Процедура СоветСтрокеСУБДУФайловогоКоннектораЗависитОтТогоЗаданЛиКоннектор() Экспорт

	СтрокаОбраза = "Data Source=/образ/openhub.db";
	Случаи = Новый Массив();

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", СтрокаОбраза);
	Случаи.Добавить(Новый Структура("Имя, Файл, Окружение, КоннекторЗадан",
		"коннектор — умолчание хаба", Новый Соответствие(), Окружение, Ложь));

	Окружение = ОкружениеОбраза();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторJSON");
	Случаи.Добавить(Новый Структура("Имя, Файл, Окружение, КоннекторЗадан",
		"КоннекторJSON переменной поверх образа", Новый Соответствие(), Окружение, Истина));

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", СтрокаОбраза);
	Случаи.Добавить(Новый Структура("Имя, Файл, Окружение, КоннекторЗадан", "КоннекторJSON в файле",
		ВФайле(Новый Соответствие(), "data.ИсточникиДанных.ТипКоннектора", "КоннекторJSON"), Окружение, Истина));

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", "Host=db;Username=openhub;Password=секрет;Database=openhub");
	Случаи.Добавить(Новый Структура("Имя, Файл, Окружение, КоннекторЗадан",
		"проектный файл {КоннекторJSON, ./data/entities} и строка PostgreSQL переменной",
		УзелБазыВФайле("КоннекторJSON", "./data/entities"), Окружение, Истина));

	Для Каждого Случай Из Случаи Цикл

		Отказ = ОтказЗагрузки(Случай.Файл, Случай.Окружение);

		Ожидаем.Что(СтрНайти(Отказ, "похожа на строку СУБД") > 0, Случай.Имя + ": отказ — " + Отказ).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, "задайте коннектор СУБД (OSHUB_DB_CONNECTOR") > 0,
			Случай.Имя + ": совет задать коннектор СУБД — " + Отказ).Равно(Случай.КоннекторЗадан);
		Ожидаем.Что(СтрНайти(Отказ, "либо путь каталога файловой базы строкой соединения (OSHUB_DB_CONNECTION") > 0,
			Случай.Имя + ": совет задать путь каталога — " + Отказ).Равно(Случай.КоннекторЗадан);
		Ожидаем.Что(СтрНайти(Отказ, "задайте тип коннектора") > 0,
			Случай.Имя + ": совет задать забытый коннектор — " + Отказ).Равно(НЕ Случай.КоннекторЗадан);
		Ожидаем.Что(СтрНайти(Отказ, "секрет"), Случай.Имя + ": значения строки в тексте нет").Равно(0);

	КонецЦикла;

КонецПроцедуры

// Пример строки соединения — для того коннектора, который задан.
&Тест
Процедура ПримерСтрокиСоединенияПодбираетсяПоКоннектору() Экспорт

	ПримерSQLite = "Data Source=<путь к файлу базы>";
	ПримерPostgreSQL = "Host=...;Username=...;Password=...;Database=...;";
	Случаи = Новый Массив();

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторSQLite");
	Окружение.Вставить("OSHUB_DB_CONNECTION", "/база/openhub.db");
	Случаи.Добавить(Новый Структура("Имя, Окружение, Пример, Чужой",
		"SQLite с голым путём", Окружение, ПримерSQLite, ПримерPostgreSQL));

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторSQLite");
	Случаи.Добавить(Новый Структура("Имя, Окружение, Пример, Чужой",
		"SQLite без строки", Окружение, ПримерSQLite, ПримерPostgreSQL));

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторPostgreSQL");
	Окружение.Вставить("OSHUB_DB_CONNECTION", "./data/entities");
	Случаи.Добавить(Новый Структура("Имя, Окружение, Пример, Чужой",
		"PostgreSQL с путём каталога", Окружение, ПримерPostgreSQL, ПримерSQLite));

	Для Каждого Случай Из Случаи Цикл
		Отказ = ОтказЗагрузки(Новый Соответствие(), Случай.Окружение);
		Ожидаем.Что(СтрНайти(Отказ, Случай.Пример) > 0, Случай.Имя + ": свой пример — " + Отказ).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, Случай.Чужой), Случай.Имя + ": чужого примера нет — " + Отказ).Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПутьКаталогаФайловойБазыНеПутаетсяСоСтрокойСУБД() Экспорт

	Пути = Новый Массив();
	Пути.Добавить("/данные/entities");
	Пути.Добавить("./data/entities");
	Пути.Добавить("C:\база=старая");
	Пути.Добавить("/данные/каталог;с-точкой-с-запятой");

	Для Каждого СтрокаСоединения Из Пути Цикл
		Окружение = Новый Соответствие();
		Окружение.Вставить("OSHUB_DB_CONNECTION", СтрокаСоединения);
		Ожидаем.Что(ОтказЗагрузки(Новый Соответствие(), Окружение), "путь " + СтрокаСоединения).Равно("");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СтрокаБезПарКлючЗначениеУНефайловогоКоннектораОтвергается() Экспорт

	// Обратная сторона «лист к листу»: коннектор из окружения, каталог файловой базы из файла.
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTOR", "КоннекторPostgreSQL");

	Отказ = ОтказЗагрузки(УзелБазыВФайле("КоннекторJSON", "./data/entities"), Окружение);

	Ожидаем.Что(СтрНайти(Отказ, "строка соединения коннектора КоннекторPostgreSQL не строка СУБД") > 0,
		"отказ конфигурации, а не каскад ошибок соединения: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "Коннектор — переменная OSHUB_DB_CONNECTOR; строка соединения —"
		+ " ключ data.ИсточникиДанных.СтрокаСоединения файла настроек") > 0,
		"названо, откуда пришёл каждый лист: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "./data/entities"), "значения строки в тексте нет").Равно(0);

КонецПроцедуры

&Тест
Процедура УзелБазыЗначениемВФайлеОтвергается() Экспорт

	Файл = ВФайле(Новый Соответствие(), "data.ИсточникиДанных", "абв");

	Для Каждого Окружение Из ОкруженияУзлаЗначением() Цикл
		Отказ = ОтказЗагрузки(Файл, Окружение);
		Ожидаем.Что(СтрНайти(Отказ, "должен быть объектом с листьями") > 0,
			"узел значением — отказ, а не молча проглоченная переменная: " + Отказ).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СведенияНазываютИсточникиЛистьевПарыБезЗначений() Экспорт

	Секрет = "пароль-" + Строка(Новый УникальныйИдентификатор);
	Файл = ВФайле(Новый Соответствие(), "data.ИсточникиДанных.ТипКоннектора", "КоннекторPostgreSQL");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_DB_CONNECTION", "Host=db;Password=" + Секрет);

	Сведения = СтрСоединить(Загружено(Файл, Окружение).Сведения(), Символы.ПС);

	Ожидаем.Что(СтрНайти(Сведения, "коннектор КоннекторPostgreSQL — ключ data.ИсточникиДанных.ТипКоннектора"
		+ " файла настроек; строка соединения — переменная OSHUB_DB_CONNECTION") > 0,
		"строка сведений называет источник каждого листа: " + Сведения).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сведения, Секрет), "значения строки в сведениях нет").Равно(0);

	Сведения = Загружено(УзелБазыВФайле("КоннекторSQLite", "Data Source=/база.db"), Новый Соответствие())
		.Сведения();
	Ожидаем.Что(Сведения.Количество(), "из одного источника — сказать нечего").Равно(0);

КонецПроцедуры

&Тест
Процедура УзелПровайдеровВходаСобираетсяИзЛистьев() Экспорт

	Файл = ВФайле(Новый Соответствие(), "oshub.oidc.keycloak.label", "Keycloak из файла");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_OIDC_PROVIDERS", "keycloak");
	Окружение.Вставить("OSHUB_OIDC_KEYCLOAK_ISSUER", "https://kc.example/realms/main");
	Окружение.Вставить("OSHUB_OIDC_KEYCLOAK_CLIENT__ID", "openhub");

	Загрузка = Загружено(Файл, Окружение);
	Узел = Загрузка.Значение("oshub.oidc");

	Ожидаем.Что(ТипЗнч(Узел), "провайдеры входа — узлом").Равно(Тип("Соответствие"));
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.providers")).Равно("keycloak");
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.keycloak.issuer"), "лист из окружения").Равно(
		"https://kc.example/realms/main");
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.keycloak.client_id"),
		"удвоенное подчёркивание имени дало подчёркивание ключа").Равно("openhub");
	Ожидаем.Что(Загрузка.Значение("oshub.oidc.keycloak.label"), "лист файла сохранён")
		.Равно("Keycloak из файла");
	Ожидаем.Что(Узел.Количество(), "провайдер из окружения лёг в ветку файла, а не рядом").Равно(2);

КонецПроцедуры

&Тест
Процедура КаждыйПсевдонимСпискаДействует() Экспорт

	Псевдонимы = Новый ИменаПеременныхОкружения().Псевдонимы();
	Ожидаем.Что(Псевдонимы.Количество(), "список псевдонимов не пуст").Больше(0);

	Для Каждого Псевдоним Из Псевдонимы Цикл

		Проба = ПробаПсевдонима(Псевдоним);
		Окружение = Новый Соответствие();
		Окружение.Вставить(Псевдоним.Переменная, Проба.Значение);
		Загрузка = Загружено(Новый Соответствие(), Окружение, Истина);

		Ожидаем.Что(Текстом(Загрузка.Значение(Проба.Где)),
			СтрШаблон("%1 доезжает до %2", Псевдоним.Переменная, Проба.Где)).Равно(Проба.Ожидается);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ВключениеОписанияAPIЧитаетсяФлагом() Экспорт

	Написания = Новый Соответствие();
	Написания.Вставить("true", Истина);
	Написания.Вставить("1", Истина);
	Написания.Вставить("TRUE", Истина);
	Написания.Вставить("false", Ложь);
	Написания.Вставить("0", Ложь);
	Написания.Вставить("да", Истина);
	Написания.Вставить("истина", Истина);
	Написания.Вставить("нет", Ложь);
	// пустая переменная не говорит ничего: флаг не ставится, и замечать нечего
	Написания.Вставить("", Неопределено);

	Для Каждого Написание Из Написания Цикл
		Окружение = Новый Соответствие();
		Окружение.Вставить("OSHUB_OPENAPI_ENABLED", Написание.Ключ);
		Загрузка = Загружено(Новый Соответствие(), Окружение);
		Ожидаем.Что(Загрузка.Значение("winow.openapi.Включено"), "OSHUB_OPENAPI_ENABLED=" + Написание.Ключ)
			.Равно(Написание.Значение);
		Ожидаем.Что(Загрузка.Замечания().Количество(), "понятный флаг без замечаний").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура МусорВключенияОписанияAPIНеПрименёнИНазван() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_OPENAPI_ENABLED", "включить");

	Загрузка = Загружено(Новый Соответствие(), Окружение);

	Ожидаем.Что(Загрузка.Значение("winow.openapi.Включено"), "мусор описание не включает").Равно(Неопределено);
	Ожидаем.Что(СтрСоединить(Загрузка.Замечания(), Символы.ПС), "замечание называет переменную")
		.Содержит("OSHUB_OPENAPI_ENABLED=включить");

КонецПроцедуры

&Тест
Процедура ПсевдонимДобавленныйТолькоВСписокДействует() Экспорт

	// Загрузка ходит по списку, а не по своим ключам: новой строке списка правило не нужно.
	РеестрФикстур.Подключить("ИменаПеременныхСПробой");
	Имена = Новый ИменаПеременныхСПробой("oshub.probe.alias", "winow.ПробаЧисла", Истина);
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_PROBE_ALIAS", "17");

	Загрузка = Новый ЗагрузкаНастроек(, , Имена);
	Загрузка.ДеталькиПоверх(Новый Соответствие(), КартаПровайдера(Окружение));

	Ожидаем.Что(Загрузка.Значение("winow.ПробаЧисла"), "пробный псевдоним доехал числом").Равно(17);

КонецПроцедуры

