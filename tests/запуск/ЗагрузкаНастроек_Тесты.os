&Тест
Процедура НегодныйПределЗагрузкиПределТелаНеДвигает() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UPLOAD__BYTES", "много");

	Загрузка = Загружено(Новый Соответствие(), Окружение, Истина);

	Ожидаем.Что(Загрузка.Значение("winow.МаксимальныйРазмерТелаЗапроса")).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

