&Тест
Процедура УмолчанияДляЧужихДеталекЗаполняютПустоту() Экспорт

	Загрузка = Загружено(Новый Соответствие(), Новый Соответствие());
	Корень = Загрузка.КореньДанных();

	Ожидаем.Что(Корень, "корень по умолчанию — ./data хаба").Равно(Новый Файл("./data").ПолноеИмя);

	ИсточникДанных = Загрузка.Значение("data.ИсточникиДанных");
	Ожидаем.Что(ИсточникДанных["ТипКоннектора"]).Равно("КоннекторJSON");
	Ожидаем.Что(ИсточникДанных["СтрокаСоединения"]).Равно(ОбъединитьПути(Корень, "entities"));
	Ожидаем.Что(Загрузка.Значение("otel.traces.sampler")).Равно("parentbased_traceidratio");
	Ожидаем.Что(Загрузка.Значение("otel.service.name")).Равно("openhub");
	Ожидаем.Что(Загрузка.Значение("cache.артефакты.Каталог"))
		.Равно(ОбъединитьПути(Корень, "кэш", "артефакты"));
	Ожидаем.Что(Загрузка.Значение("cache.артефакты.Предел")).Равно(1073741824);
	Ожидаем.Что(Загрузка.Значение("cache.ПределПамяти")).Равно(134217728);
	Для Каждого ИмяКэша Из Загрузка.КэшиЧтенийИзБазы() Цикл
		Ожидаем.Что(Загрузка.Значение("cache." + ИмяКэша + ".СрокЖизни"), ИмяКэша).Равно(30);
	КонецЦикла;
	Ожидаем.Что(Загрузка.Значение("cache.именаGitHub.СрокЖизни"), "имена GitHub помнятся сутки")
		.Равно(86400);

КонецПроцедуры

// Паспорт описания API — умолчание хаба: образ без файла настроек отдаёт описание хаба,
// а не «winow API» 1.0.0. Само описание в поставке выключено.
&Тест
Процедура ПаспортОписанияAPIВУмолчанияхХаба() Экспорт

	Загрузка = Загружено(Новый Соответствие(), Новый Соответствие());

	Ожидаем.Что(Загрузка.Значение("winow.openapi.Заголовок")).Равно("OpenHub API");
	Ожидаем.Что(Загрузка.Значение("winow.openapi.Версия"), "версия описания — версия хаба")
		.Равно(ВерсияИзPackagedef());
	Ожидаем.Что(ЗначениеЗаполнено(Загрузка.Значение("winow.openapi.Сводка")), "сводка есть").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Загрузка.Значение("winow.openapi.Описание")), "шапка есть").ЭтоИстина();
	Ожидаем.Что(Загрузка.Значение("winow.openapi.Лицензия.Имя")).Равно("MIT");
	Ожидаем.Что(Загрузка.Значение("winow.openapi.Лицензия.Идентификатор")).Равно("MIT");
	Ожидаем.Что(Загрузка.Значение("winow.openapi.Включено"), "описание в поставке выключено")
		.Равно(Неопределено);

КонецПроцедуры

