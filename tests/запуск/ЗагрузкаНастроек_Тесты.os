	Окружение.Вставить("OSHUB_PUBLISH_MAX__UPLOAD__BYTES", "1048576");
	Окружение.Вставить("Kestrel__Limits__MaxRequestBodySize", "3000000");

	Загрузка = Загружено(Новый Соответствие(), Окружение, Истина);

	Ожидаем.Что(Загрузка.Значение("winow.МаксимальныйРазмерТелаЗапроса")).Равно(3000000);

