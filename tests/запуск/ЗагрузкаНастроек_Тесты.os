// Предел тела сервера стоит на четверть выше предела загрузки: тело сверх предела доходит
// до хаба, и тот отвечает своим 413, а не Kestrel обрывом соединения.
&Тест
Процедура ПределТелаСервераНаЧетвертьВышеПределаЗагрузки() Экспорт

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_PUBLISH_MAX__UPLOAD__BYTES", "40000000");

