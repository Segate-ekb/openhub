// Поделка с определениями желудей не того устройства, что ждёт освобождение метаданных:
// структура вместо ОпределениеЖелудя либо исключение на запросе определений.

Перем Падает_;

// Контракт поделки: определения желудей по имени.
//
// Возвращаемое значение:
//  Соответствие - имя → определение (здесь — структура с теми же полями).
//
Функция ПолучитьОпределенияЖелудей() Экспорт
	Если Падает_ Тогда
		ВызватьИсключение "ПоделкаСЧужимиОпределениями: намеренный сбой запроса определений";
	КонецЕсли;
	Определения = Новый Соответствие();
	Определения.Вставить("Чужой", Новый Структура("Методы, Свойства, КешМетодовПоАннотациям, _РефлекторОбъекта"));
	Возврат Определения;
КонецФункции

// Параметры:
//  Падает - Булево - Истина — запрос определений бросает исключение.
//
Процедура ПриСозданииОбъекта(Знач Падает = Ложь)
	Падает_ = Падает;
КонецПроцедуры
