// Освобождение метаданных желудей: таблицы рефлексии ОСени отпускаются после готовности, контейнер
// после этого отдаёт желуди и строит определения заново; чужое устройство ОСени и сбой — предупреждение, не изменение.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать reflector
#Использовать "../фикстуры"

Перем Ловушка;   // ЛовушкаЛога на логе освобождения

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ГотовностьХаба");
	Поиск.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "ОсвобождениеМетаданныхЖелудей");

	Для Каждого Имя Из СтрРазделить("ЛовушкаЛога,ПоделкаСЧужимиОпределениями,ЗадачаПриГотовностиСчитающая,ЖелудьКомпанейскийДляОсвобождения", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(Логирование.ПолучитьЛог("ОсвобождениеМетаданныхЖелудей"), УровниЛога.Отладка);

КонецПроцедуры

&ПослеВсех
Процедура СнятьЛовушку() Экспорт
	Ловушка.Снять();
КонецПроцедуры

&ПередКаждым
Процедура ОчиститьЖурнал() Экспорт
	Ловушка.Очистить();
КонецПроцедуры

&Тест
Процедура ТаблицыРефлексииОтпускаютсяАКонтейнерРаботаетДальше() Экспорт

	Поделка = Контейнер(Новый Соответствие());
	Определение = Поделка.ПолучитьОпределенияЖелудей().Получить("ГотовностьХаба");
	Владелец = Определение.Завязь().ДанныеМетода().Владелец();
	Ожидаем.Что(Владелец.Количество() > 0, "до освобождения таблица методов класса полная").ЭтоИстина();
	Ожидаем.Что(Определение.Методы().Количество() > 0, "определение построено").ЭтоИстина();

	Поделка.НайтиЖелудь("ОсвобождениеМетаданныхЖелудей").Исполнить();

	Ожидаем.Что(Владелец.Количество(), "таблица-владелец строки завязи отпущена").Равно(0);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "Метаданные желудей освобождены") > 0, "веха в журнале: " + Ловушка.Всё())
		.ЭтоИстина();
	Ожидаем.Что(Определение.Методы().Количество() > 0, "определение строится заново по обращению").ЭтоИстина();
	Ожидаем.Что(Определение.Свойства().Количество() > 0, "свойства строятся заново по обращению").ЭтоИстина();
	Ожидаем.Что(Поделка.ПолучитьОпределенияЖелудей().Получить("ОсвобождениеМетаданныхЖелудей")
		.НайтиМетодыСАннотациями("Наблюдаемый").Количество(), "кэш методов по аннотациям строится заново").Равно(1);
	Ожидаем.Что(ТипЗнч(Поделка.НайтиЖелудь("ГотовностьХаба")), "желудь отдаётся").Равно(Тип("ГотовностьХаба"));
	Ожидаем.Что(ТипЗнч(Поделка.НайтиЖелудь("ЗадачаПриГотовностиСчитающая")), "желудь по прозвищу отдаётся")
		.Равно(Тип("ЗадачаПриГотовностиСчитающая"));

	Ловушка.Очистить();
	Поделка.НайтиЖелудь("ОсвобождениеМетаданныхЖелудей").Исполнить();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "Метаданные желудей освобождены") > 0, "повторный прогон безопасен")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВыключенноеНастройкойНичегоНеТрогает() Экспорт

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.start.release_bean_metadata", "false");
	Поделка = Контейнер(Детальки);
	Владелец = Поделка.ПолучитьОпределенияЖелудей().Получить("ГотовностьХаба").Завязь().ДанныеМетода().Владелец();
	Было = Владелец.Количество();

	Поделка.НайтиЖелудь("ОсвобождениеМетаданныхЖелудей").Исполнить();

	Ожидаем.Что(Владелец.Количество(), "таблица не тронута").Равно(Было);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "выключено настройкой") > 0, "причина в журнале: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КомпанейскиеОпределенияСохраняютПоляОдиночкиОтпускают() Экспорт

	Поделка = Контейнер(Новый Соответствие());
	Рефлектор = Новый Рефлектор();
	Одиночка = Поделка.ПолучитьОпределенияЖелудей().Получить("ГотовностьХаба");
	Компанейский = Поделка.ПолучитьОпределенияЖелудей().Получить("ЖелудьКомпанейскийДляОсвобождения");
	Ожидаем.Что(Компанейский.Характер(), "фикстура компанейская").Равно(ХарактерыЖелудей.Компанейский());
	ВладелецКомпанейского = Компанейский.Завязь().ДанныеМетода().Владелец();
	Ожидаем.Что(ВладелецКомпанейского.Количество() > 0, "до освобождения таблица полная").ЭтоИстина();

	Поделка.НайтиЖелудь("ОсвобождениеМетаданныхЖелудей").Исполнить();

	Ожидаем.Что(ВладелецКомпанейского.Количество(), "таблица-владелец отпущена и у компанейского").Равно(0);
	Ожидаем.Что(Рефлектор.ПолучитьСвойство(Одиночка, "Методы"), "поля одиночки сброшены").Равно(Неопределено);
	Ожидаем.Что(ТипЗнч(Рефлектор.ПолучитьСвойство(Компанейский, "Методы")), "поля компанейского на месте")
		.Равно(Тип("ТаблицаЗначений"));
	Ожидаем.Что(ТипЗнч(Рефлектор.ПолучитьСвойство(Компанейский, "Свойства")), "свойства компанейского на месте")
		.Равно(Тип("ТаблицаЗначений"));
	Ожидаем.Что(ТипЗнч(Поделка.НайтиЖелудь("ЖелудьКомпанейскийДляОсвобождения")), "компанейский создаётся после освобождения")
		.Равно(Тип("ЖелудьКомпанейскийДляОсвобождения"));

КонецПроцедуры

&Тест
Процедура ПолеОпределенияЧужогоТипаОстанавливаетОсвобождениеЦеликом() Экспорт

	Поделка = Контейнер(Новый Соответствие());
	Рефлектор = Новый Рефлектор();
	Испорченное = Поделка.ПолучитьОпределенияЖелудей().Получить("ГотовностьХаба");
	Соседнее = Поделка.ПолучитьОпределенияЖелудей().Получить("ОсвобождениеМетаданныхЖелудей");
	ВладелецСоседнего = Соседнее.Завязь().ДанныеМетода().Владелец();
	Было = ВладелецСоседнего.Количество();
	Ожидаем.Что(Было > 0, "до освобождения таблица полная").ЭтоИстина();
	Рефлектор.УстановитьСвойство(Испорченное, "КешМетодовПоАннотациям", "не кэш");

	Попытка
		Поделка.НайтиЖелудь("ОсвобождениеМетаданныхЖелудей").Исполнить();
	Исключение
		Рефлектор.УстановитьСвойство(Испорченное, "КешМетодовПоАннотациям", Новый Соответствие());
		ВызватьИсключение;
	КонецПопытки;
	Рефлектор.УстановитьСвойство(Испорченное, "КешМетодовПоАннотациям", Новый Соответствие());

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "поле КешМетодовПоАннотациям типа") > 0, "предупреждение: " + Ловушка.Всё())
		.ЭтоИстина();
	Ожидаем.Что(ВладелецСоседнего.Количество(), "ни одна таблица не тронута").Равно(Было);
	Ожидаем.Что(ТипЗнч(Рефлектор.ПолучитьСвойство(Соседнее, "Методы")), "поля соседнего на месте").Равно(Тип("ТаблицаЗначений"));

КонецПроцедуры

&Тест
Процедура ЧужоеУстройствоОпределенийДаётПредупреждениеБезИсключения() Экспорт

	Задача = Новый ОсвобождениеМетаданныхЖелудей(Новый ПоделкаСЧужимиОпределениями(), "", Лог());

	Задача.Исполнить();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "устройство ОСени не то") > 0, "предупреждение: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "Метаданные желудей освобождены") = 0, "вехи освобождения нет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбойЗапросаОпределенийДаётПредупреждениеБезИсключения() Экспорт

	Задача = Новый ОсвобождениеМетаданныхЖелудей(Новый ПоделкаСЧужимиОпределениями(Истина), "", Лог());

	Задача.Исполнить();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "намеренный сбой запроса определений") > 0, "текст сбоя в журнале: " + Ловушка.Всё())
		.ЭтоИстина();

КонецПроцедуры

Функция Лог()
	Возврат Логирование.ПолучитьЛог("ОсвобождениеМетаданныхЖелудей");
КонецФункции

// Контейнер набора: готовность, задача освобождения и одна задача-фикстура по прозвищу.
Функция Контейнер(Знач Детальки)
	Поделка = Новый Поделка(СоветНабора.БезФайлаНастроек(Детальки));
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;
КонецФункции
