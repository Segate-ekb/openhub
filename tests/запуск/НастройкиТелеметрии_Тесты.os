// Ручки телеметрии, которыми управляет оператор: поставочное умолчание, карточки сигналов
// и запрет на секрет коллектора в файле настроек. Спаны, конвейер и экспорт — дело
// аннотаций autumn-opentelemetry и SDK, здесь их нет.

#Использовать asserts
#Использовать "../фикстуры"

Перем КаталогПроекта;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрНастроекХаба.ПодключитьКлассы(Новый КлассыСлоя(),
		ОбъединитьПути(КаталогПроекта, "src", "модули"));

КонецПроцедуры

#Область ПоставочноеУмолчание

// Умолчание живёт в поставочном autumn-properties.json, а не только в аннотации детальки:
// инсталляция, которую никто не настраивал, обязана стартовать без телеметрии.
&Тест
Процедура ПоставочнаяКонфигурацияТрассировкуНеВключает() Экспорт

	Настройки = ПрочитатьНастройкиПоставки();

	Ожидаем.Что(Настройки.Свойство("otel"), "в поставке объявлен раздел otel").ЭтоИстина();
	Ожидаем.Что(Настройки.otel.enabled, "трассировка в поставке выключена").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область КарточкиСигналов

// Б-блокер регрессии: доля выборки без имени сэмплера мертва. SDK при пустом
// otel.traces.sampler ставит ParentBased(AlwaysOn) и аргумент ИГНОРИРУЕТ — карточка
// «доля отбираемых трасс» показывала бы 0.1, а уезжали бы все трассы.
&Тест
Процедура ДоляВыборкиНеЖивётБезИмениСэмплера() Экспорт

	Объявленные = ОбъявленныеКлючиНастроек();
	Ожидаем.Что(Объявленные.Найти("otel.traces.sampler.arg") <> Неопределено,
		"доля выборки объявлена настройкой").ЭтоИстина();
	Ожидаем.Что(Объявленные.Найти("otel.traces.sampler") <> Неопределено,
		"вместе с долей объявлено и правило отбора — иначе доля не работает").ЭтоИстина();

	// Само умолчание сэмплера здесь не проверяется, и это осознанно: его ставит загрузка
	// настроек, а не файл, — иначе смонтированный поверх файл оператора тихо уносил бы долю
	// выборки. Правило стережёт ЗагрузкаНастроек_Тесты.СэмплерХабаДействуетПриФайлеОператораСДолей,
	// итог на живом хабе — ТелеметрияЖивая_Тесты.ДоляНольОтсекаетТрассыБезИмениСэмплераВОкружении.

КонецПроцедуры

// Включённая телеметрия шлёт три сигнала, и у каждого своя ручка выключения. Оператору
// нечем управлять тем, чего он не видит: без карточки экспортёра единственным способом
// «выключить только логи» осталось бы выключить телеметрию целиком.
&Тест
Процедура КаждыйСигналВыключаетсяСвоейКарточкой() Экспорт

	Объявленные = ОбъявленныеКлючиНастроек();

	Для Каждого Сигнал Из СтрРазделить("traces,metrics,logs", ",") Цикл
		Ключ = "otel." + Сигнал + ".exporter";
		Ожидаем.Что(Объявленные.Найти(Ключ) <> Неопределено,
			СтрШаблон("экспортёр сигнала объявлен настройкой: %1", Ключ)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Объявленные.Найти("otel.metric.export.interval") <> Неопределено,
		"интервал среза метрик объявлен: партиями метрики не уезжают").ЭтоИстина();

КонецПроцедуры

// Сигналы базы данных приходят от библиотек и наследуют otel.enabled, но выключать их
// по отдельности оператору иногда надо — а выключить он может только то, что видит.
// Ключ текста запроса вдобавок несёт дефис, которого конвенция имён окружения не даёт:
// без карточки оператор не узнал бы даже имени переменной.
&Тест
Процедура СигналыБазыВыключаютсяСвоимиКарточками() Экспорт

	Объявленные = ОбъявленныеКлючиНастроек();

	Для Каждого Ключ Из СтрРазделить(
		"otel.entity.enabled,otel.entity.repository.enabled,otel.entity.query-text", ",") Цикл
		Ожидаем.Что(Объявленные.Найти(Ключ) <> Неопределено,
			СтрШаблон("сигнал базы объявлен настройкой: %1", Ключ)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СекретКоллектора

// Секрет коллектора берётся только из окружения (OTEL_EXPORTER_OTLP_HEADERS). Файл
// поставки и реестр настроек про него не знают: настройка, попавшая в реестр, показывается
// в интерфейсе и уезжает в бэкап конфигурации.
&Тест
Процедура СекретКоллектораВФайлНастроекНеПопадает() Экспорт

	// Сверяется ровно заголовочный ключ: endpoint, протокол и таймаут в поставке законны
	// и секретом не являются — запрет на весь exporter краснел бы на честной настройке.
	Ожидаем.Что(СтрНайти(НРег(ТекстомJSON(ПрочитатьНастройкиПоставки())), "headers"),
		"ключ заголовков коллектора в поставочном autumn-properties.json").Равно(0);

	Объявленные = ОбъявленныеКлючиНастроек();
	Для Каждого Ключ Из Объявленные Цикл
		Ожидаем.Что(СтрНайти(Ключ, "headers") = 0,
			"ключ заголовков коллектора не объявлен настройкой: " + Ключ).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Объявленные.Количество() > 0, "ключи otel в реестре настроек нашлись").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ПрочитатьНастройкиПоставки()

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(ОбъединитьПути(КаталогПроекта, "autumn-properties.json"));
	Настройки = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Настройки;

КонецФункции

Функция ТекстомJSON(Знач Данные)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

// Ключи otel, объявленные реестром настроек: их видно в интерфейсе, и секрету там не место.
Функция ОбъявленныеКлючиНастроек()

	Результат = Новый Массив();
	Для Каждого Ключ Из РеестрНастроекХаба.Реестр().Ключи() Цикл
		Если СтрНачинаетсяС(Ключ, "otel.") Тогда
			Результат.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
