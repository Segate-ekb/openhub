// Запуск задач при готовности: задачи собираются по прозвищу, исполняются после готовности хаба
// одним фоновым заданием, сбой одной не трогает прочих, неготовый хаб задачи не получает.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем Ловушка;   // ЛовушкаЛога на логе запуска задач

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"), "ГотовностьХаба");
	Поиск.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "ЗапускЗадачПриГотовности");

	Для Каждого Имя Из СтрРазделить("ЗапускВФонеСинхронный,ЛовушкаЛога,ЗадачаПриГотовностиСчитающая,"
		+ "ЗадачаПриГотовностиПадающая", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(Логирование.ПолучитьЛог("ЗапускЗадачПриГотовности"), УровниЛога.Отладка);

КонецПроцедуры

&ПослеВсех
Процедура СнятьЛовушку() Экспорт
	Ловушка.Снять();
КонецПроцедуры

&ПередКаждым
Процедура ОчиститьЖурнал() Экспорт
	Ловушка.Очистить();
КонецПроцедуры

&Тест
Процедура ГотовыйХабИсполняетЗадачиВФонеИПереживаетСбойОдной() Экспорт

	Поделка = Контейнер();
	Поделка.НайтиЖелудь("ГотовностьХаба").ОтметитьСтартЗавершённым();

	Поделка.НайтиЖелудь("ЗапускЗадачПриГотовности").Запустить();

	Ожидаем.Что(Поделка.НайтиЖелудь("ЗапускВФоне").Запусков(), "одно фоновое задание").Равно(1);
	Ожидаем.Что(Поделка.НайтиЖелудь("ЗадачаПриГотовностиСчитающая").Вызовов(),
		"считающая исполнена, хотя падающая упала").Равно(1);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "ЗадачаПриГотовностиПадающая") > 0,
		"сбой падающей — в журнале: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеготовыйХабЗадачНеПолучает() Экспорт

	Поделка = Контейнер();
	Поделка.НайтиЖелудь("ГотовностьХаба").ЗаявитьЗадачу("тест.вечный-гейт");
	Поделка.НайтиЖелудь("ГотовностьХаба").ОтметитьСтартЗавершённым();

	Поделка.НайтиЖелудь("ЗапускЗадачПриГотовности").Запустить();

	Ожидаем.Что(Поделка.НайтиЖелудь("ЗадачаПриГотовностиСчитающая").Вызовов(), "задачи не исполнялись").Равно(0);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "не стал готов") > 0,
		"предупреждение о неготовности: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезЗадачФоновоеЗаданиеНеЗапускается() Экспорт

	Готовность = Новый ГотовностьХаба(Логирование.ПолучитьЛог("тест.oshub.старт"));
	Готовность.ОтметитьСтартЗавершённым();
	Фон = Новый ЗапускВФонеСинхронный();

	Запуск = Новый ЗапускЗадачПриГотовности(Новый Массив(), Готовность, Фон, "", Логирование.ПолучитьЛог("ЗапускЗадачПриГотовности"));
	Запуск.Запустить();

	Ожидаем.Что(Фон.Запусков(), "запускать нечего").Равно(0);

КонецПроцедуры

// Контейнер набора: готовность, запуск задач, синхронный фон и две задачи-фикстуры; ожидание готовности — секунда.
Функция Контейнер()
	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.start.ready_wait_sec", 1);
	Поделка = Новый Поделка(СоветНабора.БезФайлаНастроек(Детальки));
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;
КонецФункции
