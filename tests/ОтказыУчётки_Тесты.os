// Юнит-тесты таблицы отказов учётки: причина едет машинным кодом, ответ выбирается
// по коду, а не по словам в тексте, и подробности наружу отдаются перечисленными полями.

#Использовать asserts
#Использовать errors
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Отказы;

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подключить() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Модули = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя,
		"src", "модули");

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ТекстОшибки");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ОтказыУчётки");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "ТекстыОтказовВхода");

	Отказы = Новый ОтказыУчётки(Новый ТекстОшибки());

КонецПроцедуры

#Область ПричинаЕдетКодом

// Ответ выбирается по коду причины: у каждой причины свой машинный код наружу и свой
// HTTP-статус, и они не зависят от того, какими словами написано сообщение.
&Тест
Процедура УКаждойПричиныСвойКодИСтатус() Экспорт

	Ожидаем.Что(Ответ(Отказы.ОнбордингНеЗавершён()), "гейт первого запуска")
		.Равно("registration_locked_onboarding 403");
	Ожидаем.Что(Ответ(Отказы.ПарольныйВходВыключен()), "парольный вход выключен")
		.Равно("registration_password_login_disabled 403");
	Ожидаем.Что(Ответ(Отказы.РегистрацияВыключена()), "регистрация выключена")
		.Равно("registration_disabled 403");
	Ожидаем.Что(Ответ(Отказы.ТолькоПоПриглашению()), "только по приглашению")
		.Равно("registration_invite_only 403");
	Ожидаем.Что(Ответ(Отказы.ПочтаНеНастроена()), "почта не настроена — состояние хаба")
		.Равно("registration_mail_not_configured 503");
	Ожидаем.Что(Ответ(Отказы.АдресЗанят()), "адрес занят").Равно("email_taken 409");
	Ожидаем.Что(Ответ(Отказы.ЛогинЗанят()), "логин занят").Равно("user_exists 409");

КонецПроцедуры

// Сторож на значение, а не на текст: сообщение подменяется целиком, ответ не меняется.
// Ровно это ломалось, когда двери искали причину подстрокой в тексте исключения.
&Тест
Процедура СменаТекстаСообщенияОтветНеМеняет() Экспорт

	Причина = Отказы.РегистрацияВыключена();
	ПоТаблице = Отказы.Разобрать(Отказы.Ошибка(Причина));

	// та же причина, но сообщение — чужое, да ещё и с чужим кодом внутри текста
	Подменённое = Отказы.Разобрать(ФабрикаОшибок.Создать(Причина,
		"email_taken: пользователь уже существует, регистрация только по приглашению"));

	Ожидаем.Что(Подменённое.Код, "код не читается из текста").Равно(ПоТаблице.Код);
	Ожидаем.Что(Подменённое.Статус, "и статус тоже").Равно(ПоТаблице.Статус);
	Ожидаем.Что(Подменённое.Сообщение, "наружу едет текст таблицы, а не текст исключения")
		.Равно(ПоТаблице.Сообщение);

КонецПроцедуры

// Постороннее исключение — общий отказ, чем бы оно себя ни называло. Раньше слово «уже»
// в чужом тексте уезжало клиенту как «пользователь существует» (409).
&Тест
Процедура ПостороннееИсключениеНеСтановитсяЗанятымЛогином() Экспорт

	Чужое = ОтказНаИсключении("Пул ""public"" уже занят другим владельцем, exist");

	Ожидаем.Что(Чужое.Код, "общий отказ, а не user_exists").Равно("registration_failed");
	Ожидаем.Что(Чужое.Статус, "и 400, а не 409").Равно(400);
	Ожидаем.Что(Чужое.Причина, "причина не названа").Равно("");
	Ожидаем.Что(СтрНайти(Чужое.Сообщение, "уже занят") > 0,
		"текст исключения виден человеку: " + Чужое.Сообщение).ЭтоИстина();

КонецПроцедуры

// Чужой машинный код наружу не транслируется: библиотека вправе называть свои ошибки
// как угодно, а конверт хаба обещает только свои коды.
&Тест
Процедура ЧужойКодНеСтановитсяКодомОтвета() Экспорт

	Чужой = Отказы.Разобрать(ФабрикаОшибок.Создать("resource.already_exists",
		"Ресурс уже существует"));

	Ожидаем.Что(Чужой.Код, "общий отказ").Равно("registration_failed");
	Ожидаем.Что(Чужой.Статус).Равно(400);
	Ожидаем.Что(Чужой.Подробности.error_code, "но код библиотеки назван подробностью")
		.Равно("resource.already_exists");

КонецПроцедуры

// Обёртка причины не теряет то, из-за чего отказ возник: наружу едет код таблицы,
// а корневая причина остаётся в цепочке — по ней разбирают инцидент (НФТ-ЭКСП-012).
&Тест
Процедура ОбёрткаПричиныКорневуюПричинуНеТеряет() Экспорт

	Исходная = ФабрикаОшибок.Создать("registry.name_taken",
		"Логин занят именем пула: имена пулов и логины делят первый сегмент адреса");

	Обёрнутая = Отказы.ОшибкаНад(Отказы.ЛогинЗанят(), Исходная,
		Новый Структура("login", "teamspace"));

	Разбор = ДиагностикаОшибок.Разобрать(Обёрнутая);
	Корневая = Разбор.КорневаяПричина();

	Ожидаем.Что(Корневая <> Неопределено, "корневая причина сохранена").ЭтоИстина();
	Ожидаем.Что(Корневая.КодОшибки(), "и это та самая исходная причина")
		.Равно("registry.name_taken");
	Ожидаем.Что(СтрНайти(Корневая.Сообщение(), "именем пула") > 0,
		"вместе с её словами: " + Корневая.Сообщение()).ЭтоИстина();

	// а снаружи по-прежнему видно только причину таблицы
	Отказ = Отказы.Разобрать(Обёрнутая);
	Ожидаем.Что(Отказ.Причина, "наружу едет причина таблицы").Равно(Отказы.ЛогинЗанят());
	Ожидаем.Что(Отказ.Подробности.login).Равно("teamspace");

КонецПроцедуры

#КонецОбласти

#Область Подробности

// Подробности отдаются перечисленными полями: что положили в данные ошибки сверх них —
// внутреннее дело хаба и наружу не уезжает.
&Тест
Процедура НаружуЕдутТолькоОбъявленныеПоля() Экспорт

	Данные = Новый Структура();
	Данные.Вставить("email", "zanyato@example.test");
	Данные.Вставить("Логин", "chuzhoj");            // чужой логин наружу не отдают
	Данные.Вставить("ХешПароля", "$2b$10$secret");  // и тем более секреты

	Подробности = Отказы.Разобрать(Отказы.Ошибка(Отказы.АдресЗанят(), Данные)).Подробности;

	Ожидаем.Что(Подробности.Количество(), "объявлено ровно одно поле").Равно(1);
	Ожидаем.Что(Подробности.email).Равно("zanyato@example.test");
	Ожидаем.Что(Подробности.Свойство("Логин"), "чужой логин в подробностях не появился")
		.ЭтоЛожь();
	Ожидаем.Что(Подробности.Свойство("ХешПароля"), "и секрет тоже").ЭтоЛожь();

КонецПроцедуры

// Занятый логин называет имя ресурса — то самое, которое прислал сам обратившийся.
&Тест
Процедура ЗанятыйЛогинНазываетИмяРесурса() Экспорт

	Подробности = Отказы.Разобрать(Отказы.Ошибка(Отказы.ЛогинЗанят(),
		Новый Структура("login", "petya"))).Подробности;

	Ожидаем.Что(Подробности.login).Равно("petya");

КонецПроцедуры

// Подробностей нет — поля нет: пустой объект и «не сообщили» для клиента разные вещи.
&Тест
Процедура ПричинаБезПодробностейИхНеПридумывает() Экспорт

	Ожидаем.Что(Отказы.Разобрать(Отказы.Ошибка(Отказы.РегистрацияВыключена())).Подробности,
		"у закрытой регистрации подробностей нет").Равно(Неопределено);
	Ожидаем.Что(Отказы.Разобрать(Отказы.Ошибка(Отказы.АдресЗанят())).Подробности,
		"объявленное поле без значения подробностей не рождает").Равно(Неопределено);
	Ожидаем.Что(ОтказНаИсключении("Пароль слишком короткий").Подробности,
		"обычное исключение подробностей не несёт").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ЭкранныйТекст

// Слова на форме свои, но выбираются по той же причине: у каждой причины свой текст,
// и ни один не повторяет соседний.
&Тест
Процедура УКаждойПричиныСвойЭкранныйТекст() Экспорт

	Тексты = Новый ТекстыОтказовВхода(Неопределено, Неопределено, Отказы);
	Сказанное = Новый Соответствие();

	Для Каждого Причина Из ВсеПричины() Цикл
		Текст = Тексты.ОтказРегистрации(Причина, "запасной текст");
		Ожидаем.Что(ЗначениеЗаполнено(Текст), "текст причины " + Причина).ЭтоИстина();
		Ожидаем.Что(Сказанное.Получить(Текст), "текст причины " + Причина
			+ " повторяет соседний").Равно(Неопределено);
		Сказанное.Вставить(Текст, Причина);
	КонецЦикла;

	Ожидаем.Что(Тексты.ОтказРегистрации("", "Пароль слишком короткий"),
		"без названной причины человек читает то, что сказала служба")
		.Равно("Пароль слишком короткий");

КонецПроцедуры

#КонецОбласти

#Область Инфраструктура

// «код статус» одной строкой: сравнение целиком не даёт тесту позеленеть на половине пары.
Функция Ответ(Знач Причина)
	Отказ = Отказы.Разобрать(Отказы.Ошибка(Причина));
	Возврат СтрШаблон("%1 %2", Отказ.Код, Отказ.Статус);
КонецФункции

Функция ОтказНаИсключении(Знач Текст)
	Попытка
		ВызватьИсключение Текст;
	Исключение
		Возврат Отказы.Разобрать(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ВсеПричины()
	Результат = Новый Массив();
	Результат.Добавить(Отказы.ОнбордингНеЗавершён());
	Результат.Добавить(Отказы.ПарольныйВходВыключен());
	Результат.Добавить(Отказы.РегистрацияВыключена());
	Результат.Добавить(Отказы.ТолькоПоПриглашению());
	Результат.Добавить(Отказы.ПочтаНеНастроена());
	Результат.Добавить(Отказы.АдресЗанят());
	Результат.Добавить(Отказы.ЛогинЗанят());
	Возврат Результат;
КонецФункции

#КонецОбласти
