// Имя пользователя GitHub по логину на собранном контейнере с autumn-cache: GitHub без токена
// отвечает одному адресу ограниченное число раз в час, поэтому ответ помнится, а неудача — нет.

#Использовать asserts
#Использовать autumn
#Использовать autumn-cache
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем Поделка;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	Классы = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Классы.ПодключитьФайл(ОбъединитьПути(Модули, "основа", "Классы", "ТекстОшибки.os"));
	Классы.ПодключитьФайл(ОбъединитьПути(Модули, "основа", "Классы", "КонтрольСимволов.os"));
	Классы.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "ТаймаутыHTTP.os"));
	Классы.Подключить(Модули, "ОпознаниеGitHubHTTP");
	// прозвище ТранспортHTTP занимает фейк: в сеть набор не ходит
	РеестрФикстур.Подключить("ФейкТранспортHTTP");

	Детальки = Новый Соответствие();
	Детальки.Вставить("cache.ПределПамяти", 1048576);
	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

// Второй вопрос о том же логине GitHub не спрашивает; другой логин — свой вопрос.
&Тест
Процедура ИмяЛогинаСпрашиваетсяУGitHubОдинРаз() Экспорт

	Транспорт().УстановитьОтвет(200, ТелоJSON("{""login"":""mona"",""name"":""Mona Lisa""}"));
	До = Транспорт().КоличествоВызовов();

	Ожидаем.Что(Опознание().Имя("mona"), "имя прочитано").Равно("Mona Lisa");
	Ожидаем.Что(Опознание().Имя("mona"), "и названо снова").Равно("Mona Lisa");
	Ожидаем.Что(Транспорт().КоличествоВызовов() - До, "GitHub спрошен один раз").Равно(1);

	Опознание().Имя("hubot");
	Ожидаем.Что(Транспорт().КоличествоВызовов() - До, "другой логин — свой запрос").Равно(2);

КонецПроцедуры

// «Имени нет» помнится так же, как имя: профиль без имени не спрашивается заново.
&Тест
Процедура ОтсутствиеИмениПомнится() Экспорт

	Транспорт().УстановитьОтвет(200, ТелоJSON("{""login"":""noname"",""name"":null}"));
	До = Транспорт().КоличествоВызовов();

	Ожидаем.Что(Опознание().Имя("noname"), "имени нет").Равно("");
	Ожидаем.Что(Опознание().Имя("noname"), "и снова нет").Равно("");
	Ожидаем.Что(Транспорт().КоличествоВызовов() - До, "GitHub спрошен один раз").Равно(1);

КонецПроцедуры

// GitHub не ответил — неудача в кэш не ложится: пока длится пауза, GitHub не спрашивают, а после
// неё вопрос о том же логине снова идёт в GitHub и получает имя. Запомни кэш неудачу — после паузы
// ответ пришёл бы из кэша без запроса. Моменты — в прошлом, чтобы пауза не задела соседние тесты.
&Тест
Процедура НеудачаНеКэшируетсяИПослеПаузыИмяЕсть() Экспорт

	Сбой = Дата(2001, 1, 1, 12, 0, 0);
	Транспорт().ЭмулироватьОффлайн();
	До = Транспорт().КоличествоВызовов();
	Ожидаем.Что(Опознание().Имя("later", Сбой), "GitHub недоступен").Равно(Неопределено);

	Транспорт().УстановитьОтвет(200, ТелоJSON("{""login"":""later"",""name"":""Later Person""}"));
	Ожидаем.Что(Опознание().Имя("other", Сбой + 60), "в паузе соседа не спрашивают").Равно(Неопределено);
	Ожидаем.Что(Опознание().Имя("later", Сбой + 300), "после паузы — имя из GitHub").Равно("Later Person");
	Ожидаем.Что(Транспорт().КоличествоВызовов() - До, "запросов два: сбой и после паузы").Равно(2);

КонецПроцедуры

Функция Опознание()
	Возврат Поделка.НайтиЖелудь("ОпознаниеGitHub");
КонецФункции

Функция Транспорт()
	Возврат Поделка.НайтиЖелудь("ТранспортHTTP");
КонецФункции

Функция ТелоJSON(Знач Текст)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8");
КонецФункции
