// Исходящий HTTP к GitHub поверх фейкового транспорта: право записи по карточке репозитория
// и опознание владельца токена.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогПроекта = КаталогиПроекта.Корень();
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ОбезличиваниеЖурнала.os")));
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "ТаймаутыHTTP.os"));
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHubHTTP");
	ПоискКлассов.Подключить(Модули, "ОпознаниеGitHubHTTP");
	РеестрФикстур.Подключить("ФейкТранспортHTTP");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");

КонецПроцедуры

// Имя пакета приходит из запроса, и в адрес GitHub API оно едет СЕГМЕНТОМ пути: слеш,
// «..» и пробел внутри имени иначе увели бы запрос на другую карточку GitHub — и право
// записи посчиталось бы по чужому репозиторию.
&Тест
Процедура ИмяПакетаНеУводитЗапросСКарточкиРепозитория() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки("{""permissions"":{""push"":true}}", "UTF-8"));
	Проверяющий = Новый ПроверяющийGitHubHTTP(Фейк, Настройки(Истина), , ЛогТестов());

	Проверяющий.ЕстьПравоЗаписи("gho_token", "../../user/repos");

	Ожидаем.Что(Фейк.URLПоследний(), "путь остался карточкой репозитория организации")
		.Равно("https://api.github.com/repos/oscript-library/..%2F..%2Fuser%2Frepos");

	Проверяющий.ЕстьПравоЗаписи("gho_token", "имя с пробелом");

	Ожидаем.Что(Фейк.URLПоследний(), "пробел и кириллица уехали процентами")
		.Равно("https://api.github.com/repos/oscript-library/"
			+ "%D0%B8%D0%BC%D1%8F%20%D1%81%20%D0%BF%D1%80%D0%BE%D0%B1%D0%B5%D0%BB%D0%BE%D0%BC");

КонецПроцедуры

&Тест
Процедура GitHubПоРедиректамНеХодит() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки("{""permissions"":{""push"":true}}", "UTF-8"));
	Проверяющий = Новый ПроверяющийGitHubHTTP(Фейк, Настройки(Истина), , ЛогТестов());
	Проверяющий.ЕстьПравоЗаписи("gho_token", "repo");

	Ожидаем.Что(Фейк.РедиректыПоследний(),
		"редиректы включает только клиент апстрима, остальной исходящий HTTP их не ходит").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура GitHubPushTrueДаётПравоЗаписи() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки("{""permissions"":{""push"":true}}", "UTF-8"));
	Проверяющий = Новый ПроверяющийGitHubHTTP(Фейк, Настройки(Истина), , ЛогТестов());

	Ожидаем.Что(Проверяющий.ЕстьПравоЗаписи("gho_token", "winow"),
		"permissions.push=true → есть право записи").ЭтоИстина();
	Ожидаем.Что(Фейк.URLПоследний(), "репозиторий зеркала — организация из настройки плюс имя пакета")
		.Равно("https://api.github.com/repos/oscript-library/winow");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("Authorization"), "токен в заголовке").Равно("token gho_token");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("Accept"), "GitHub Accept").Равно("application/vnd.github+json");

КонецПроцедуры

&Тест
Процедура GitHubPushFalseИлиНе200ДаётЛожь() Экспорт

	ФейкFalse = Новый ФейкТранспортHTTP();
	ФейкFalse.УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки("{""permissions"":{""push"":false}}", "UTF-8"));
	Ожидаем.Что(Новый ПроверяющийGitHubHTTP(ФейкFalse, Настройки(Истина), , ЛогТестов()).ЕстьПравоЗаписи("t", "pkg"),
		"push=false → нет права").ЭтоЛожь();

	Фейк404 = Новый ФейкТранспортHTTP();
	Фейк404.УстановитьОтвет(404);
	Ожидаем.Что(Новый ПроверяющийGitHubHTTP(Фейк404, Настройки(Истина), , ЛогТестов()).ЕстьПравоЗаписи("t", "pkg"),
		"404 → нет доступа (fail-closed)").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура GitHubОтключёнНеДёргаетТранспорт() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Проверяющий = Новый ПроверяющийGitHubHTTP(Фейк, Настройки(Ложь), , ЛогТестов()); // выключен настройкой

	Ожидаем.Что(Проверяющий.ЕстьПравоЗаписи("t", "pkg"), "отключён → Ложь").ЭтоЛожь();
	Ожидаем.Что(Фейк.КоличествоВызовов(), "отключён → сеть не дёргается").Равно(0);

КонецПроцедуры

// Резолвера настроек нет — GitHub не опрашивается: в контейнере без настроек внешний
// источник права не включается по недоразумению.
&Тест
Процедура GitHubБезРезолвераНастроекНеХодитВСеть() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Проверяющий = Новый ПроверяющийGitHubHTTP(Фейк, Неопределено, , ЛогТестов());

	Ожидаем.Что(Проверяющий.ЕстьПравоЗаписи("t", "pkg"), "нет резолвера → Ложь").ЭтоЛожь();
	Ожидаем.Что(Фейк.КоличествоВызовов(), "нет резолвера → сеть не дёргается").Равно(0);

КонецПроцедуры

&Тест
Процедура GitHubСбойТранспортаFailClosed() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.ЭмулироватьОффлайн();
	Проверяющий = Новый ПроверяющийGitHubHTTP(Фейк, Настройки(Истина), , ЛогТестов());

	Ожидаем.Что(Проверяющий.ЕстьПравоЗаписи("t", "pkg"),
		"сбой сети → Ложь (fail-closed), исключение не всплывает").ЭтоЛожь();

КонецПроцедуры

// Логин владельца токена спрашивается у самого GitHub тем же токеном и с тем же ожиданием,
// что и право записи: опознание не задерживает публикацию дольше служебного запроса.
&Тест
Процедура ОпознаниеGitHubНазываетЛогинВладельцаТокена() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""octocat"",""id"":583231,""name"":""The Octocat""}"));

	Владелец = НовоеОпознание(Фейк).Владелец("github_pat_11ABCDEFG");

	Ожидаем.Что(Владелец.Логин, "логин из профиля владельца токена").Равно("octocat");
	Ожидаем.Что(Владелец.Имя, "имя из того же профиля").Равно("The Octocat");
	Ожидаем.Что(Фейк.КоличествоВызовов(), "логин и имя — одним запросом").Равно(1);
	Ожидаем.Что(Фейк.URLПоследний(), "профиль владельца токена").Равно("https://api.github.com/user");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("Authorization"), "токен в заголовке")
		.Равно("token github_pat_11ABCDEFG");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("Accept"), "GitHub Accept").Равно("application/vnd.github+json");
	Ожидаем.Что(Фейк.ТаймаутПоследний(), "ожидание — как у служебного запроса")
		.Равно(Новый ТаймаутыHTTP().ТаймаутСлужебногоЗапроса());
	Ожидаем.Что(Фейк.РедиректыПоследний(), "по перенаправлениям не ходит").ЭтоЛожь();

КонецПроцедуры

// Хост GitHub API — тот же, что у проверки права: инсталляция с GitHub Enterprise
// спрашивает свой сервер, а не github.com.
&Тест
Процедура ОпознаниеGitHubСпрашиваетНастроенныйХост() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""octocat_acme""}"));

	Логин = Новый ОпознаниеGitHubHTTP(Фейк, "ghe.example.com/api/v3", ЛогТестов()).Владелец("ghp_enterprise1").Логин;

	Ожидаем.Что(Фейк.URLПоследний(), "профиль на хосте из настройки")
		.Равно("https://ghe.example.com/api/v3/user");
	Ожидаем.Что(Логин, "логин управляемой учётки Enterprise с подчёркиванием").Равно("octocat_acme");

КонецПроцедуры

&Тест
Процедура ОпознаниеGitHubПриНедоступномGitHubДаётПустойЛогин() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.ЭмулироватьОффлайн();

	Ожидаем.Что(НовоеОпознание(Фейк).Владелец("github_pat_offline1").Логин,
		"сбой сети — пустой логин, исключение не всплывает").Равно("");

КонецПроцедуры

// Текст сбоя собирает чужая библиотека и может повторить в нём токен: в журнал токен не попадает.
&Тест
Процедура ОпознаниеGitHubНеПишетТокенВЖурнал() Экспорт

	Токен = "github_pat_11MASKME0001secret";
	Фейк = Новый ФейкТранспортHTTP();
	Фейк.ЭмулироватьОффлайн("Сетевой сбой: Authorization: token " + Токен + " → api.github.com/user");
	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.опознание-github");
	Лог.ДобавитьСпособВывода(Ловушка);

	Попытка
		Логин = Новый ОпознаниеGitHubHTTP(Фейк, , Лог).Владелец(Токен).Логин;
	Исключение
		Лог.УдалитьСпособВывода(Ловушка);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(Логин, "сбой — пустой логин").Равно("");
	Ожидаем.Что(Найти(Ловушка.Всё(), "Сетевой сбой"), "сбой в журнале есть: " + Ловушка.Всё()).Больше(0);
	Ожидаем.Что(Найти(Ловушка.Всё(), Токен), "токена в журнале нет: " + Ловушка.Всё()).Равно(0);
	Ожидаем.Что(Найти(Ловушка.Всё(), "MASKME"), "и обрывка тоже нет").Равно(0);

КонецПроцедуры

// Логин в теле ответа с кодом отказа не принимается: отказ значит, что токен GitHub не признал.
&Тест
Процедура ОпознаниеGitHubНе200ДаётПустойЛогин() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(401, ТелоJSON("{""login"":""octocat"",""message"":""Bad credentials""}"));

	Ожидаем.Что(НовоеОпознание(Фейк).Владелец("github_pat_revoked1").Логин, "401 — пустой логин").Равно("");

КонецПроцедуры

// Логин уходит в журнал аудита и в текст уведомлений, поэтому всё, чем логин GitHub быть
// не может, отбрасывается целиком, а не подрезается.
&Тест
Процедура ОпознаниеGitHubНегодныйЛогинНеПринимается() Экспорт

	Негодные = Новый Массив();
	Негодные.Добавить("не JSON вовсе");
	Негодные.Добавить("[""octocat""]");
	Негодные.Добавить("{""id"":583231}");
	Негодные.Добавить("{""login"":583231}");
	Негодные.Добавить("{""login"":""""}");
	Негодные.Добавить("{""login"":""octo cat""}");
	Негодные.Добавить("{""login"":""-octocat""}");
	Негодные.Добавить("{""login"":""<b>octocat</b>""}");
	Негодные.Добавить("{""login"":""octocat\ntoken:ghp_1""}");
	Негодные.Добавить("{""login"":""" + Повтор("a", 65) + """}");

	Для Каждого Тело Из Негодные Цикл
		Фейк = Новый ФейкТранспортHTTP();
		Фейк.УстановитьОтвет(200, ТелоJSON(Тело));
		Ожидаем.Что(НовоеОпознание(Фейк).Владелец("github_pat_garbage1").Логин,
			"негодный профиль даёт пустой логин: " + Тело).Равно("");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОпознаниеGitHubБезТокенаНеХодитВСеть() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""octocat""}"));
	Опознание = НовоеОпознание(Фейк);

	Ожидаем.Что(Опознание.Владелец("").Логин, "пустой токен — пустой логин").Равно("");
	Ожидаем.Что(Опознание.Владелец("   ").Логин, "токен из пробелов — пустой логин").Равно("");
	Ожидаем.Что(Фейк.КоличествоВызовов(), "без токена GitHub не спрашивается").Равно(0);

КонецПроцедуры

// Имени в профиле может не быть вовсе: владелец опознан логином, имя пустое.
&Тест
Процедура ВладелецБезИмениВПрофилеОпознанЛогином() Экспорт

	Для Каждого Тело Из СтрРазделить("{""login"":""octocat""}|{""login"":""octocat"",""name"":null}"
		+ "|{""login"":""octocat"",""name"":""""}|{""login"":""octocat"",""name"":42}", "|") Цикл
		Фейк = Новый ФейкТранспортHTTP();
		Фейк.УстановитьОтвет(200, ТелоJSON(Тело));
		Владелец = НовоеОпознание(Фейк).Владелец("github_pat_noname1");
		Ожидаем.Что(Владелец.Логин, "логин опознан: " + Тело).Равно("octocat");
		Ожидаем.Что(Владелец.Имя, "имени нет: " + Тело).Равно("");
	КонецЦикла;

КонецПроцедуры

// Имя набирает человек, а уходит оно строкой в чат и в тело вебхука: перевод строки, разрыв
// строки Юникода, смена направления письма, C1 и невидимые символы становятся пробелом — строку
// «Релиз: …» в текст не подсунуть и «(логин)» не перевернуть; длина ограничена.
&Тест
Процедура ИмяИзПрофиляСтановитсяСтрокойТекста() Экспорт

	Грязные = Новый Соответствие();
	Грязные.Вставить("  Mona\nLisa\t", "Mona Lisa");
	Грязные.Вставить("Mona\u2028Релиз: https://evil.example", "Mona Релиз: https://evil.example");
	Грязные.Вставить("Mona\u202Easil", "Mona asil");
	Грязные.Вставить("Mo\u200Bna\u2066x\u0085y\u007Fz\u00ADq", "Mo na x y z q");
	// КОНТРОЛЬ: составное эмодзи с ZWJ и персидское слово с ZWNJ остаются как есть
	Грязные.Вставить("Mona \ud83d\udc69\u200d\ud83d\udcbb Lisa", "Mona " + Символ(55357) + Символ(56425)
		+ Символ(8205) + Символ(55357) + Символ(56507) + " Lisa");
	Грязные.Вставить("\u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645",
		Символ(1605) + Символ(1740) + Символ(8204) + Символ(1582) + Символ(1608) + Символ(1575)
		+ Символ(1607) + Символ(1605));

	Для Каждого Пара Из Грязные Цикл
		Фейк = Новый ФейкТранспортHTTP();
		Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""octocat"",""name"":""" + Пара.Ключ + """}"));
		Имя = НовоеОпознание(Фейк).Владелец("github_pat_dirty1").Имя;
		Ожидаем.Что(Имя, "строка текста из " + Пара.Ключ).Равно(Пара.Значение);
		Ожидаем.Что(НетНепечатных(Имя), "ни одного непечатного символа: " + Пара.Ключ).ЭтоИстина();
	КонецЦикла;

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""octocat"",""name"":""" + Повтор("Ж", 200) + """}"));
	Ожидаем.Что(СтрДлина(НовоеОпознание(Фейк).Владелец("github_pat_long1").Имя), "длина ограничена")
		.Равно(100);

	// эмодзи на границе предела отрезается целиком: половинки суррогатной пары в строке нет
	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""octocat"",""name"":""" + Повтор("Ж", 99)
		+ "\ud83d\ude00""}"));
	Имя = НовоеОпознание(Фейк).Владелец("github_pat_emoji1").Имя;
	Ожидаем.Что(Имя, "эмодзи не разрезан").Равно(Повтор("Ж", 99));

КонецПроцедуры

// Имя по логину — из публичного профиля: токена в запросе нет, хост тот же, что у опознания.
&Тест
Процедура ИмяПоЛогинуСпрашиваетПубличныйПрофильБезТокена() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""mona"",""name"":""Mona Lisa""}"));

	Имя = Новый ОпознаниеGitHubHTTP(Фейк, "ghe.example.com/api/v3", ЛогТестов()).Имя("mona");

	Ожидаем.Что(Имя, "имя из публичного профиля").Равно("Mona Lisa");
	Ожидаем.Что(Фейк.URLПоследний(), "профиль по логину на настроенном хосте")
		.Равно("https://ghe.example.com/api/v3/users/mona");
	Ожидаем.Что(Фейк.ЗаголовокПоследний("Authorization"), "токена в запросе нет").Равно("");
	Ожидаем.Что(Фейк.ТаймаутПоследний(), "ожидание — как у служебного запроса")
		.Равно(Новый ТаймаутыHTTP().ТаймаутСлужебногоЗапроса());
	Ожидаем.Что(Фейк.РедиректыПоследний(), "по перенаправлениям не ходит").ЭтоЛожь();

КонецПроцедуры

// «Имени нет» — ответ, который стоит помнить: профиль без имени и несуществующий логин.
&Тест
Процедура ИмяПоЛогинуБезИмениИНенайденныйДаютПустуюСтроку() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""mona"",""name"":null}"));
	Ожидаем.Что(НовоеОпознание(Фейк).Имя("mona"), "имени в профиле нет").Равно("");

	Фейк.УстановитьОтвет(404, ТелоJSON("{""message"":""Not Found""}"));
	Ожидаем.Что(НовоеОпознание(Фейк).Имя("ghost-user"), "пользователя нет").Равно("");

КонецПроцедуры

// GitHub не ответил или отказал (лимит запросов без токена — 403): вопрос не закрыт,
// и ответ — Неопределено, а не пустое имя, которое запомнилось бы.
&Тест
Процедура ИмяПоЛогинуПриСбоеНеОтвечено() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.ЭмулироватьОффлайн();
	Ожидаем.Что(НовоеОпознание(Фейк).Имя("mona"), "сеть недоступна").Равно(Неопределено);

	Для Каждого Код Из СтрРазделить("403,429,500,502", ",") Цикл
		Фейк = Новый ФейкТранспортHTTP();
		Фейк.УстановитьОтвет(Число(Код), ТелоJSON("{""login"":""mona"",""name"":""Mona Lisa""}"));
		Ожидаем.Что(НовоеОпознание(Фейк).Имя("mona"), "код " + Код + " — не ответ").Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Логин, которым GitHub-логин быть не может, в адрес не попадает: запроса нет вовсе.
&Тест
Процедура НегодныйЛогинЗаИменемНеХодит() Экспорт

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""mona"",""name"":""Mona Lisa""}"));
	Опознание = НовоеОпознание(Фейк);

	Для Каждого Логин Из СтрРазделить("|../user|octo cat|-octocat|mona/../../user", "|") Цикл
		Ожидаем.Что(Опознание.Имя(Логин), "негодный логин: " + Логин).Равно("");
	КонецЦикла;
	Ожидаем.Что(Фейк.КоличествоВызовов(), "GitHub не спрошен").Равно(0);

КонецПроцедуры

// После сбоя GitHub об именах несколько минут не спрашивают: повторы доставок и соседние задания
// не ждут его таймаута и не продлевают лимит под 403/429. Ответ 404 паузы не ставит.
&Тест
Процедура ПослеСбояGitHubОбИменахНеСпрашивают() Экспорт

	Для Каждого Сбой Из СтрРазделить("сеть,403,429,500", ",") Цикл
		Фейк = Новый ФейкТранспортHTTP();
		Если Сбой = "сеть" Тогда
			Фейк.ЭмулироватьОффлайн();
		Иначе
			Фейк.УстановитьОтвет(Число(Сбой), ТелоJSON("{""message"":""limit""}"));
		КонецЕсли;
		Опознание = НовоеОпознание(Фейк);
		Ожидаем.Что(Опознание.Имя("mona"), "сбой: " + Сбой).Равно(Неопределено);

		Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""hubot"",""name"":""Hubot""}"));
		Ожидаем.Что(Опознание.Имя("hubot"), "в паузе не спрашиваем: " + Сбой).Равно(Неопределено);
		Ожидаем.Что(Фейк.КоличествоВызовов(), "один запрос на сбой и паузу: " + Сбой).Равно(1);
	КонецЦикла;

	Фейк = Новый ФейкТранспортHTTP();
	Фейк.УстановитьОтвет(404, ТелоJSON("{""message"":""Not Found""}"));
	Опознание = НовоеОпознание(Фейк);
	Опознание.Имя("ghost-user");
	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""hubot"",""name"":""Hubot""}"));
	Ожидаем.Что(Опознание.Имя("hubot"), "КОНТРОЛЬ: после 404 спрашиваем дальше").Равно("Hubot");

КонецПроцедуры

// Пауза кончается: через пять минут после сбоя GitHub спрашивают снова, и имя есть.
&Тест
Процедура ПаузаПослеСбояКончаетсяЧерезПятьМинут() Экспорт

	Сбой = Дата(2026, 7, 30, 12, 0, 0);
	Фейк = Новый ФейкТранспортHTTP();
	Фейк.ЭмулироватьОффлайн();
	Опознание = НовоеОпознание(Фейк);
	Ожидаем.Что(Опознание.Имя("mona", Сбой), "сбой").Равно(Неопределено);

	Фейк.УстановитьОтвет(200, ТелоJSON("{""login"":""mona"",""name"":""Mona Lisa""}"));
	Ожидаем.Что(Опознание.Имя("mona", Сбой + 299), "за секунду до конца паузы — не спрашиваем")
		.Равно(Неопределено);
	Ожидаем.Что(Опознание.Имя("mona", Сбой + 300), "пауза кончилась — имя есть").Равно("Mona Lisa");
	Ожидаем.Что(Фейк.КоличествоВызовов(), "запросов два: сбой и после паузы").Равно(2);

КонецПроцедуры

// Ни управляющего, ни разрыва, ни символа формата.
Функция НетНепечатных(Знач Текст)
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 32 ИЛИ (Код >= 127 И Код <= 160) ИЛИ Код = 173 ИЛИ Код = 8203 ИЛИ Код = 8206 ИЛИ Код = 8207
			ИЛИ (Код >= 8232 И Код <= 8238) ИЛИ (Код >= 8288 И Код <= 8303) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция НовоеОпознание(Знач Транспорт)
	Возврат Новый ОпознаниеGitHubHTTP(Транспорт, , ЛогТестов());
КонецФункции

Функция ТелоJSON(Знач Текст)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8");
КонецФункции

Функция Повтор(Знач Символ, Знач Сколько)
	Результат = "";
	Для Номер = 1 По Сколько Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Резолвер настроек с единственным рубильником пути GitHub-токена.
Функция Настройки(Знач Включено)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.Задать("oshub.publish.github_legacy", Включено);
	Заглушка.Задать("oshub.publish.github.org", "oscript-library");
	Заглушка.ЗадатьПрокси();
	Возврат Заглушка;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub");
КонецФункции
