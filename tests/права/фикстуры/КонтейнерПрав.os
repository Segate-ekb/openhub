// Юнит-контейнер модели прав на базе в памяти: реестр, таблицы входа, прав и настроек, аудит,
// события, службы прав и служба доступа кабинета; набор подключает сверх этого своё.

#Использовать autumn
#Использовать autumn-data
#Использовать entity

// Подключает классы модели прав и её соседей.
//
// Параметры:
//  ПоискКлассов - КлассыСлоя - через неё файл попадает в контейнер.
//  Модули - Строка - каталог src/модули.
//
Процедура Подключить(Знач ПоискКлассов, Знач Модули) Экспорт

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(Модули, "вход, права, настройки");
	ПоискКлассов.ПодключитьРеализации(Модули, "ИменаОбъектовАудита");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));

	КаталогСети = ОбъединитьПути(Модули, "сеть", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСети, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСети, "КлиентHTTP.os"));

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	ПоискКлассов.Подключить(Модули, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(Модули, "СобытиеАудита");
	ПоискКлассов.ПодключитьОснову(Модули);

	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "УчёткаПринципала");
	ПоискКлассов.Подключить(Модули, "ВердиктГварда");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHub");
	// СлужбаДоступа спрашивает у гварда право задать квоту при создании пула
	ПоискКлассов.Подключить(Модули, "ГвардКвотыПула");
	ПоискКлассов.Подключить(Модули, "СлужбаДоступа");

	РеестрФикстур.Подключить("ФейкПроверяющийGitHub");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

КонецПроцедуры

// Собирает и запускает контейнер на базе в памяти.
//
// Параметры:
//  ИмяБазы - Строка - строка соединения коннектора в памяти; своя у каждого набора.
//
// Возвращаемое значение:
//  Поделка - запущенный контейнер.
//
Функция Поднять(Знач ИмяБазы) Экспорт

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", ИмяБазы);

	Детальки = Новый Соответствие();
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = СоветНабора.СДетальками(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;

КонецФункции
