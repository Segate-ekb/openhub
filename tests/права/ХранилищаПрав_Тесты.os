// Хранилища прав на базе в памяти: гранты, сопоставления и связки групп OIDC, провайдеры входа.
// Деривованные отборы обязаны отсеять лежащие в таблице чужие строки.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "../фикстуры"

Перем Поделка;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("ТаблицыВПамяти");
	Таблицы = Новый ТаблицыВПамяти();
	Поделка = Таблицы.Поднять("вход, права", "хранилища-прав");

КонецПроцедуры

#Область СборкаКонтейнера

&Тест
Процедура ХранилищаСобираютсяЖелудями() Экспорт

	Имена = "ХранилищеПравДоступа,ХранилищеСопоставленийГруппOIDC,ХранилищеСвязокГруппOIDC,"
		+ "ХранилищеПровайдеровВхода";

	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПраваДоступа

&Тест
Процедура ГрантОтбираетсяПоЧетырёмПолямСразу() Экспорт

	Хранилище = Желудь("ХранилищеПравДоступа");
	ТипОбъекта = "объект" + УникальныеИмена.Хвост();

	ЗавестиГрант(Хранилище, "пользователь", 1, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "пользователь", 1, ТипОбъекта, 20);
	ЗавестиГрант(Хранилище, "пользователь", 2, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "группа", 1, ТипОбъекта, 10);

	Грант = Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 10);

	Ожидаем.Что(Грант, "грант найден").Существует();
	Ожидаем.Что(Строка(Грант.ТипСубъекта)).Равно("пользователь");
	Ожидаем.Что(Число(Грант.СубъектИдентификатор)).Равно(1);
	Ожидаем.Что(Число(Грант.ОбъектИдентификатор)).Равно(10);
	Ожидаем.Что(Хранилище.НайтиГрант("пользователь", 9, ТипОбъекта, 10),
		"отбор по субъекту действует").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 99),
		"отбор по объекту действует").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ГрантыОтбираютсяПоОбъектуТипуИСубъекту() Экспорт

	Хранилище = Желудь("ХранилищеПравДоступа");
	ТипОбъекта = "объект" + УникальныеИмена.Хвост();
	ЧужойТип = "чужой" + УникальныеИмена.Хвост();
	// ГрантыСубъекта тип объекта не отбирает — субъект должен быть уникален в пределах набора
	Субъект = СвободныйНомер();

	ЗавестиГрант(Хранилище, "пользователь", Субъект, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "пользователь", Субъект, ТипОбъекта, 20);
	ЗавестиГрант(Хранилище, "группа", Субъект, ТипОбъекта, 10);
	// строки, которые обязаны быть отсеяны каждым из отборов
	ЗавестиГрант(Хранилище, "пользователь", Субъект, ЧужойТип, 10);
	ЗавестиГрант(Хранилище, "пользователь", Субъект + 7, ТипОбъекта, 10);

	Ожидаем.Что(Хранилище.ГрантыНаОбъект(ТипОбъекта, 10).Количество(),
		"гранты на конкретный объект").Равно(3);
	Ожидаем.Что(Хранилище.ГрантыПоТипуОбъекта(ТипОбъекта).Количество(),
		"гранты на весь тип объекта").Равно(4);
	Ожидаем.Что(Хранилище.ГрантыСубъекта("пользователь", Субъект).Количество(),
		"гранты субъекта по обоим типам объектов").Равно(3);
	Ожидаем.Что(Хранилище.ГрантыСубъекта("группа", Субъект).Количество(),
		"отбор по типу субъекта действует").Равно(1);

КонецПроцедуры

&Тест
Процедура ГрантУдаляетсяЧерезХранилище() Экспорт

	Хранилище = Желудь("ХранилищеПравДоступа");
	ТипОбъекта = "объект" + УникальныеИмена.Хвост();

	ЗавестиГрант(Хранилище, "пользователь", 1, ТипОбъекта, 10);
	ЗавестиГрант(Хранилище, "пользователь", 2, ТипОбъекта, 10);

	Хранилище.Удалить(Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 10));

	Ожидаем.Что(Хранилище.ГрантыНаОбъект(ТипОбъекта, 10).Количество(), "остался один").Равно(1);
	Ожидаем.Что(Хранилище.НайтиГрант("пользователь", 1, ТипОбъекта, 10), "удалённого нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СопоставленияИСвязкиГруппOIDC

&Тест
Процедура СопоставленияОтбираютсяПоИздателюИГруппе() Экспорт

	Хранилище = Желудь("ХранилищеСопоставленийГруппOIDC");
	Издатель = "https://idp" + УникальныеИмена.Хвост();
	ЧужойИздатель = "https://other" + УникальныеИмена.Хвост();
	Группа = СвободныйНомер();

	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "dev");
	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "ops");
	ЗавестиСопоставление(Хранилище, Группа + 1, Издатель, "roles", "dev");
	// строки, которые обязаны быть отсеяны
	ЗавестиСопоставление(Хранилище, Группа, ЧужойИздатель, "groups", "dev");

	Ожидаем.Что(Хранилище.ПолучитьПоИздательРавно(Издатель).Количество(),
		"отбор по издателю").Равно(3);
	Ожидаем.Что(Хранилище.ПолучитьПоГруппаИдентификаторРавно(Группа + 1).Количество(),
		"отбор по группе").Равно(1);
	Ожидаем.Что(Хранилище.Все().Количество() >= 4, "Все() отдаёт всю таблицу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СопоставлениеИщетсяПоПолномуКлючуИУдаляется() Экспорт

	Хранилище = Желудь("ХранилищеСопоставленийГруппOIDC");
	Издатель = "https://idp" + УникальныеИмена.Хвост();
	Группа = СвободныйНомер();

	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "dev");
	ЗавестиСопоставление(Хранилище, Группа, Издатель, "groups", "ops");
	ЗавестиСопоставление(Хранилище, Группа, Издатель, "roles", "dev");
	ЗавестиСопоставление(Хранилище, Группа + 1, Издатель, "groups", "dev");

	Найдено = Хранилище.НайтиСопоставление(Группа, Издатель, "groups", "ops");

	Ожидаем.Что(Найдено, "сопоставление по полному ключу").Существует();
	Ожидаем.Что(Строка(Найдено.Значение)).Равно("ops");
	Ожидаем.Что(Хранилище.НайтиСопоставление(Группа, Издатель, "groups", "qa"),
		"отбор по значению клейма действует").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиСопоставление(Группа, Издатель, "teams", "ops"),
		"отбор по имени клейма действует").Равно(Неопределено);

	Идентификатор = Найдено.Идентификатор;
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор), "чтение по id").Существует();

	Хранилище.Удалить(Найдено);

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор), "после удаления").Равно(Неопределено);
	Ожидаем.Что(Хранилище.ПолучитьПоИздательРавно(Издатель).Количество(), "остались три").Равно(3);

КонецПроцедуры

&Тест
Процедура СвязкаОтбираетсяПоГруппе() Экспорт

	Хранилище = Желудь("ХранилищеСвязокГруппOIDC");
	База = СвободныйНомер();

	Для Сч = 0 По 2 Цикл
		Связка = Хранилище.СоздатьЭлемент();
		Связка.ГруппаИдентификатор = База + Сч;
		Связка.ПолитикаВыпавших = "исключать";
		Связка.СинхронизированаВ = ТекущаяУниверсальнаяДата();
		Связка.Сохранить();
	КонецЦикла;

	Найдена = Хранилище.НайтиПоГруппе(База + 1);

	Ожидаем.Что(Найдена, "связка группы найдена").Существует();
	Ожидаем.Что(Число(Найдена.ГруппаИдентификатор)).Равно(База + 1);
	Ожидаем.Что(Хранилище.НайтиПоГруппе(База + 999), "чужой группы нет").Равно(Неопределено);
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Найдена.Идентификатор), "чтение по id").Существует();
	Ожидаем.Что(Хранилище.Все().Количество() >= 3, "Все() отдаёт всю таблицу").ЭтоИстина();

	Хранилище.Удалить(Найдена);
	Ожидаем.Что(Хранилище.НайтиПоГруппе(База + 1), "после удаления").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ПровайдерыВхода

&Тест
Процедура ПровайдерыОтдаютсяВПорядкеИмени() Экспорт

	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Метка = УникальныеИмена.Хвост();

	Для Каждого Хвост Из СтрРазделить("gamma,alpha,beta", ",") Цикл
		ЗавестиПровайдера(Хранилище, Хвост + Метка);
	КонецЦикла;

	Имена = Новый Массив;
	Для Каждого Запись Из Хранилище.Все() Цикл
		Если СтрЗаканчиваетсяНа(Строка(Запись.Имя), Метка) Тогда
			Имена.Добавить(Строка(Запись.Имя));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Имена.Количество()).Равно(3);
	Ожидаем.Что(СтрСоединить(Имена, ","), "порядок по имени возрастанию").Равно(
		"alpha" + Метка + ",beta" + Метка + ",gamma" + Метка);

КонецПроцедуры

&Тест
Процедура ПровайдерИщетсяПоНормализованномуИмени() Экспорт

	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Имя = "gitlab" + УникальныеИмена.Хвост();

	ЗавестиПровайдера(Хранилище, Имя);
	ЗавестиПровайдера(Хранилище, "github" + УникальныеИмена.Хвост());

	Найдена = Хранилище.НайтиПоИмени("  " + ВРег(Имя) + "  ");

	Ожидаем.Что(Найдена, "регистр и пробелы не значимы").Существует();
	Ожидаем.Что(Строка(Найдена.Имя)).Равно(Имя);
	Ожидаем.Что(Строка(Найдена.ИдентификаторКлиента), "поле-двойник Идентификатора цело").Равно("cid-" + Имя);
	Ожидаем.Что(Строка(Найдена.ИмяКлеймаГрупп), "поле-двойник Имени цело").Равно("groups-" + Имя);
	Ожидаем.Что(Хранилище.НайтиПоИмени("нет-такого" + УникальныеИмена.Хвост()), "чужого имени нет").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиПоИмени("   "), "пустое имя не ищется").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура УдалениеПровайдераПоИмениИдемпотентно() Экспорт

	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Имя = "google" + УникальныеИмена.Хвост();
	Сосед = "yandex" + УникальныеИмена.Хвост();

	ЗавестиПровайдера(Хранилище, Имя);
	ЗавестиПровайдера(Хранилище, Сосед);

	Ожидаем.Что(Хранилище.УдалитьПоИмени(ВРег(Имя)), "первое удаление").ЭтоИстина();
	Ожидаем.Что(Хранилище.УдалитьПоИмени(ВРег(Имя)), "повторное удаление").ЭтоЛожь();
	Ожидаем.Что(Хранилище.НайтиПоИмени(Сосед), "соседа удаление не задело").Существует();

КонецПроцедуры

&Тест
Процедура КолонкиПровайдераРазбираютсяБезКоллизииПрефиксов() Экспорт

	// колонки с общим началом имени разбираются каждая в свою, а не в первую объявленную
	ОбъектМодели = Желудь("ХранилищеСущностейПровайдерВхода").ПолучитьОбъектМодели();
	Построитель = Желудь("ПостроительОпцийПоиска");

	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьПоИдентификаторКлиентаРавно"),
		"ИдентификаторКлиента не съеден Идентификатором").Равно("ИдентификаторКлиента");
	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьОдноПоИдентификаторРавно"),
		"первичный ключ по-прежнему разбирается").Равно("Идентификатор");
	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьПоИмяКлеймаГруппРавно"),
		"ИмяКлеймаГрупп не съедено Имя").Равно("ИмяКлеймаГрупп");
	Ожидаем.Что(ПолеОтбора(Построитель, ОбъектМодели, "ПолучитьПоИмяРавноПервые"),
		"рабочий отбор хранилища идёт в Имя").Равно("Имя");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Синтетический номер субъекта, группы или связки с запасом под соседние номера «+1», «+7».
Функция СвободныйНомер()
	Возврат УникальныеИмена.Номер(100);
КонецФункции

Функция ПолеОтбора(Знач Построитель, Знач ОбъектМодели, Знач ИмяМетода)

	Отборы = Построитель.РазобратьИмяМетода(ИмяМетода, ОбъектМодели).ОпцииПоиска.Отборы();
	Ожидаем.Что(Отборы.Количество(), СтрШаблон("отбор в %1 построен", ИмяМетода)).Равно(1);
	Возврат Отборы[0].ПутьКДанным;

КонецФункции

Процедура ЗавестиГрант(Знач Хранилище, Знач ТипСубъекта, Знач СубъектИдентификатор,
	Знач ТипОбъекта, Знач ОбъектИдентификатор)

	Грант = Хранилище.СоздатьЭлемент();
	Грант.ТипСубъекта = ТипСубъекта;
	Грант.СубъектИдентификатор = СубъектИдентификатор;
	Грант.ТипОбъекта = ТипОбъекта;
	Грант.ОбъектИдентификатор = ОбъектИдентификатор;
	Грант.Чтение = Истина;
	Грант.КемВыдано = 0;
	Грант.Выдано = ТекущаяУниверсальнаяДата();
	Грант.Сохранить();

КонецПроцедуры

Процедура ЗавестиСопоставление(Знач Хранилище, Знач ГруппаИдентификатор, Знач Издатель,
	Знач ИмяКлейма, Знач Значение)

	Сопоставление = Хранилище.СоздатьЭлемент();
	Сопоставление.ГруппаИдентификатор = ГруппаИдентификатор;
	Сопоставление.Издатель = Издатель;
	Сопоставление.ИмяКлейма = ИмяКлейма;
	Сопоставление.Значение = Значение;
	Сопоставление.Сохранить();

КонецПроцедуры

Процедура ЗавестиПровайдера(Знач Хранилище, Знач Имя)

	Запись = Хранилище.СоздатьЗапись(Имя);
	Запись.ВидПротокола = "oidc";
	Запись.ИдентификаторКлиента = "cid-" + Имя;
	Запись.ИмяКлеймаГрупп = "groups-" + Имя;
	Запись.Включён = Истина;
	Хранилище.Записать(Запись, "root", ТекущаяУниверсальнаяДата());

КонецПроцедуры

#КонецОбласти
