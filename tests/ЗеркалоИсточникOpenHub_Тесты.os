// Тесты источника апстрима режима "api-v1": срез изменений одним запросом, момент отсчёта,
// продолжение порции тем же срезом, фильтр имён, шкала обхода и отказы.
// Сети не требуют: клиент апстрима — фейк.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогMirror;
Перем КаталогПрокси;
Перем КаталогРеестра;
Перем КаталогФикстур;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогMirror = ОбъединитьПути(КаталогМодулей, "зеркала", "Классы");
	КаталогПрокси = ОбъединитьПути(КаталогМодулей, "прокси", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогПрокси, "СекретИсточника");
	ПоискКлассов.Подключить(КаталогПрокси, "ЗаведениеИсточника");
	ПоискКлассов.Подключить(КаталогMirror, "ИсточникАпстримаOpenHub");
	ПоискКлассов.Подключить(КаталогMirror, "РазборСрезаИзменений");
	ПоискКлассов.Подключить(КаталогMirror, "КореньАпстрима");
	ПоискКлассов.ПодключитьОснову(ОбъединитьПути(КаталогMirror, "..", ".."));
	ПоискКлассов.Подключить(КаталогРеестра, "АллоулистИмён");
	ПоискКлассов.Подключить(КаталогРеестра, "МаскаИмениПакета");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкКлиентАпстрима.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "СчётчикОтметок.os"));

КонецПроцедуры

// Ядро режима: одна порция — ОДИН запрос, и версии каждого имени приезжают вместе с ним.
// Легаси-протокол платит запросом за каждое имя, и ровно в этом разница цен.
&Тест
Процедура ПорцияСтоитОдногоЗапроса() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0;1.1.0|beta:2.0.0"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Клиент.ПутиЗапросов().Количество(), "перечисление порции — один запрос").Равно(1);
	Ожидаем.Что(Перечень.Элементы.Количество(), "элемент на каждую изменившуюся версию").Равно(3);
	Ожидаем.Что(Перечень.Код, "срез получен").Равно(200);

КонецПроцедуры

&Тест
Процедура ЭлементНесётВерсиюИВерсионныйПуть() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.2.0"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Перечень.Элементы[0].ИмяПакета).Равно("alfa");
	Ожидаем.Что(Перечень.Элементы[0].Версия).Равно("1.2.0");
	Ожидаем.Что(Перечень.Элементы[0].ВерсияИзвестна, "срез называет версию до скачивания").ЭтоИстина();
	Ожидаем.Что(Перечень.Элементы[0].ПутьСкачивания, "путь версионный")
		.Равно("alfa/alfa-1.2.0.ospx");

КонецПроцедуры

// Срез — сосед выдачи: выдача "{корень}/download/", срез "{корень}/changes".
&Тест
Процедура СрезСпрашиваетсяРядомСВыдачейНаПодпути() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0"));
	Апстрим = "https://corp.example/api/v1/pools/main/download/";

	Источник(Клиент).Перечислить(ЗеркалоURL(Апстрим), 10);

	Ожидаем.Что(Клиент.БазыЗапросов()[0], "путь хаба сохранён, отрезан только сегмент выдачи")
		.Равно("https://corp.example/api/v1/pools/main");
	Ожидаем.Что(СтрНачинаетсяС(Клиент.ПутиЗапросов()[0], "changes?"), "спрошен срез изменений")
		.ЭтоИстина();

КонецПроцедуры

// Первый обход отсчитывать не от чего: момента у зеркала нет, и срез спрашивается полным.
&Тест
Процедура ПервыйОбходИдётПолнымСрезом() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[0], "since="), "момента в запросе нет").Равно(0);
	Ожидаем.Что(ЗначениеЗаполнено(Перечень.СрезС), "обход объявлен полным").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОбходСМоментомСпрашиваетТолькоИзменения() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0"));
	Запись = Зеркало();
	Запись.ВычитаноДо = '20260812100000';

	Перечень = Источник(Клиент).Перечислить(Запись, 10);

	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[0], "since=2026-08-12T10%3A00%3A00") > 0,
		"срез спрошен с момента, до которого источник вычитан").ЭтоИстина();
	Ожидаем.Что(Перечень.СрезС, "и обход объявлен инкрементным с него же").Равно('20260812100000');

КонецПроцедуры

// Продолжение порции обязано смотреть на ТОТ ЖЕ срез: спроси оно свежий, изменения между
// порциями сдвинули бы состав, а курсор указывал бы в другой список.
&Тест
Процедура ПродолжениеПорцииСпрашиваетТотЖеСрез() Экспорт

	Клиент = КлиентСоСрезом(Срез("gamma:1.0.0"));
	Запись = Зеркало();
	Запись.ВычитаноДо = '20260812100000';
	Запись.ПрогонСрезС = '20260811090000';
	Запись.ПрогонМоментСреза = '20260812235959';

	Перечень = Источник(Клиент).Перечислить(Запись, 10, "gamma");

	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[0], "since=2026-08-11T09%3A00%3A00") > 0,
		"срез продолжения — тот, с которого начат обход").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[0], "cursor=gamma") > 0, "курсор передан").ЭтоИстина();
	Ожидаем.Что(Перечень.МоментСреза, "момент вычитки снят первой порцией и не пересматривается")
		.Равно('20260812235959');

КонецПроцедуры

// Момент, до которого источник вычитан этим обходом, называет САМ источник ответом:
// назначить его себе зеркало не вправе, иначе оно пропустило бы всё, что случилось
// между его часами и часами источника.
&Тест
Процедура МоментВычиткиБерётсяИзОтветаИсточника() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0", "2026-08-12T12:00:00Z"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Перечень.МоментСреза, "as_of ответа стал моментом вычитки обхода")
		.Равно('20260812120000');

КонецПроцедуры

// Зеркало с пустыми моментами (так его заводит СервисЗеркал) обходится полным срезом:
// инкременту не от чего отсчитывать.
&Тест
Процедура ЗеркалоСПустымиМоментамиОбходитсяПолнымСрезом() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Перечень.Код, "перечисление прошло").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[0], "since="), "момента в запросе нет").Равно(0);
	Ожидаем.Что(ЗначениеЗаполнено(Перечень.СрезС), "обход полный").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПорцияИШкалаБерутсяИзОтвета() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, СрезСоШкалой("alfa:1.0.0", 12, 4, Истина, "delta"));

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 1);

	Ожидаем.Что(Перечень.ИменВсего, "знаменатель — весь срез").Равно(12);
	Ожидаем.Что(Перечень.ИменПройдено, "числитель — имена до курсора").Равно(4);
	Ожидаем.Что(Перечень.ЕстьЕщё, "за порцией остался хвост").ЭтоИстина();
	Ожидаем.Что(Перечень.Курсор, "и назван первым непройденным именем").Равно("delta");
	Ожидаем.Что(СтрНайти(Клиент.ПутиЗапросов()[0], "limit=1") > 0, "порция спрошена в именах")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФильтрЗеркалаРежетСостав() Экспорт

	Клиент = КлиентСоСрезом(Срез("corp-a:1.0.0|alien-b:2.0.0"));

	Перечень = Источник(Клиент).Перечислить(ЗеркалоСФильтром("[""corp-*""]"), 10);

	Ожидаем.Что(Перечень.Элементы.Количество(), "чужое имя в состав не попало").Равно(1);
	Ожидаем.Что(Перечень.Элементы[0].ИмяПакета).Равно("corp-a");

КонецПроцедуры

// Шкалу считает источник, и фильтра зеркала он не знает. Доля обхода такого зеркала
// остаётся НЕИЗВЕСТНОЙ (ноль), а не врёт числом чужих имён.
&Тест
Процедура ФильтрОставляетДолюОбходаНеизвестной() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, СрезСоШкалой("corp-a:1.0.0", 12, 4, Ложь, ""));

	Перечень = Источник(Клиент).Перечислить(ЗеркалоСФильтром("[""corp-*""]"), 10);

	Ожидаем.Что(Перечень.ИменВсего, "знаменатель источника фильтра зеркала не знает").Равно(0);
	Ожидаем.Что(Перечень.ИменПройдено, "и числитель тоже").Равно(0);

КонецПроцедуры

&Тест
Процедура БитыйФильтрFailClosed() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0"));

	Перечень = Источник(Клиент).Перечислить(ЗеркалоСФильтром("{битый"), 10);

	Ожидаем.Что(Перечень.Элементы.Количество(), "битый фильтр — пустой набор").Равно(0);

КонецПроцедуры

&Тест
Процедура OfflineПеречислениеОтдаётКодНоль() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(0, "");

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Перечень.Код, "offline — код 0").Равно(0);
	Ожидаем.Что(Перечень.Элементы.Количество(), "offline — пустой набор").Равно(0);
	Ожидаем.Что(ЗначениеЗаполнено(Перечень.МоментСреза),
		"момент вычитки не назван: источник не отвечал").ЭтоЛожь();

КонецПроцедуры

// Ответ, срезом не являющийся, — ОТКАЗ перечисления, а не пустой срез: иначе битый ответ
// выглядел бы как «ничего не изменилось» и двигал бы момент, до которого источник вычитан.
&Тест
Процедура ОтветНеСрезомОтдаётсяОтказом() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, "<html>не срез</html>");

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Перечень.Код, "не срез — отказ перечисления").Равно(502);
	Ожидаем.Что(Перечень.Элементы.Количество(), "переносить нечего").Равно(0);
	Ожидаем.Что(ЗначениеЗаполнено(Перечень.МоментСреза), "момент вычитки не назван").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеТотКодСрезаНеДвигаетМомент() Экспорт

	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(404, "");

	Перечень = Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Перечень.Код).Равно(404);
	Ожидаем.Что(ЗначениеЗаполнено(Перечень.МоментСреза), "момент вычитки не назван").ЭтоЛожь();

КонецПроцедуры

// ИСТ-АПСТ-006: правило одно для источника пула и для зеркала — токен едет с КАЖДЫМ
// запросом протокола: и за срезом, и за самим .ospx.
&Тест
Процедура ТокенЗеркалаЕдетСКаждымЗапросомПротокола() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0"));
	Клиент.УстановитьОтветДанные(200, ПолучитьДвоичныеДанныеИзСтроки("ospx"));
	Приватное = ЗеркалоСТокеном("sekret-42");

	Перечень = Источник(Клиент).Перечислить(Приватное, 10);
	Источник(Клиент).Скачать(Приватное, Перечень.Элементы[0]);

	Токены = Клиент.ТокеныЗапросов();
	Ожидаем.Что(Токены.Количество(), "срез и скачивание").Равно(2);
	Для Каждого Токен Из Токены Цикл
		Ожидаем.Что(Токен, "каждый запрос к приватному источнику несёт токен").Равно("sekret-42");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЗеркалоБезТокенаЧитаетИсточникАнонимно() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0"));

	Источник(Клиент).Перечислить(Зеркало(), 10);

	Ожидаем.Что(Клиент.ТокеныЗапросов()[0], "анонимное зеркало токена не несёт").Равно("");

КонецПроцедуры

&Тест
Процедура СкачиваниеИдётПоВерсионномуПути() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.2.0"));
	Клиент.УстановитьОтветДанные(200, ПолучитьДвоичныеДанныеИзСтроки("ospx"));
	Источник_ = Источник(Клиент);

	Перечень = Источник_.Перечислить(Зеркало(), 10);
	Источник_.Скачать(Зеркало(), Перечень.Элементы[0]);

	Ожидаем.Что(Клиент.ПутиЗапросов()[Клиент.ПутиЗапросов().ВГраница()],
		"качается именно версионный артефакт").Равно("alfa/alfa-1.2.0.ospx");
	Ожидаем.Что(Клиент.БазыЗапросов()[Клиент.ПутиЗапросов().ВГраница()],
		"артефакт берётся у самой выдачи").Равно("http://upstream.invalid/download/");

КонецПроцедуры

&Тест
Процедура ПеречислениеОтмечаетсяНаКаждомИмениПорции() Экспорт

	Клиент = КлиентСоСрезом(Срез("alfa:1.0.0|beta:2.0.0|gamma:3.0.0"));
	Отметка = Новый СчётчикОтметок();

	Источник(Клиент).Перечислить(Зеркало(), 10, "", Отметка);

	Ожидаем.Что(Отметка.Шагов(), "отметка на каждом имени порции").Равно(3);
	Ожидаем.Что(СтрСоединить(Отметка.Имена(), ","), "и названы сами имена")
		.Равно("alfa,beta,gamma");

КонецПроцедуры

&Тест
Процедура РежимИсточникаНазванApiV1() Экспорт
	Ожидаем.Что(Источник(Новый ФейкКлиентАпстрима()).Режим()).Равно("api-v1");
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Источник(Знач Клиент)
	Возврат Новый ИсточникАпстримаOpenHub(Клиент, Неопределено, Неопределено, Новый КореньАпстрима(Новый РазборАдреса()), Новый АллоулистИмён());
КонецФункции

Функция КлиентСоСрезом(Знач Тело)
	Клиент = Новый ФейкКлиентАпстрима();
	Клиент.УстановитьОтветТекст(200, Тело);
	Возврат Клиент;
КонецФункции

// Срез изменений источника из компактной записи "имя:версия;версия|имя:версия".
Функция Срез(Знач Состав, Знач Снят = "2026-08-13T00:00:00Z")
	Возврат ТелоСреза(Состав, Снят, ЧислоИмён(Состав), 0, Ложь, "");
КонецФункции

Функция СрезСоШкалой(Знач Состав, Знач ИменВсего, Знач ИменДо, Знач ЕстьЕщё, Знач Курсор)
	Возврат ТелоСреза(Состав, "2026-08-13T00:00:00Z", ИменВсего, ИменДо, ЕстьЕщё, Курсор);
КонецФункции

Функция ТелоСреза(Знач Состав, Знач Снят, Знач ИменВсего, Знач ИменДо, Знач ЕстьЕщё, Знач Курсор)

	Данные = Новый Структура();
	Данные.Вставить("pool", "main");
	Данные.Вставить("as_of", Снят);
	Данные.Вставить("names_total", ИменВсего);
	Данные.Вставить("names_before", ИменДо);
	Данные.Вставить("has_more", ЕстьЕщё);
	Данные.Вставить("next_cursor", Курсор);
	Данные.Вставить("changes", Изменения(Состав));

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Функция Изменения(Знач Состав)

	Результат = Новый Массив();
	Для Каждого Пара Из СтрРазделить(Состав, "|", Ложь) Цикл
		Части = СтрРазделить(Пара, ":", Ложь);
		Для Каждого Версия Из СтрРазделить(Части[1], ";", Ложь) Цикл
			Результат.Добавить(Новый Структура("package, version",
				Части[0], Новый Структура("version, yanked", Версия, Ложь)));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЧислоИмён(Знач Состав)
	Возврат СтрРазделить(Состав, "|", Ложь).Количество();
КонецФункции

Функция Зеркало()
	Возврат ЗеркалоURL("http://upstream.invalid/download/");
КонецФункции

Функция ЗеркалоURL(Знач URL)
	Возврат Новый Структура(
		"АпстримURL, ФильтрJSON, ТокенДоступа, ВычитаноДо, ПрогонСрезС, ПрогонМоментСреза",
		URL, "", "", '00010101000000', '00010101000000', '00010101000000');
КонецФункции

Функция ЗеркалоСФильтром(Знач ФильтрJSON)
	Запись = Зеркало();
	Запись.ФильтрJSON = ФильтрJSON;
	Возврат Запись;
КонецФункции

Функция ЗеркалоСТокеном(Знач Токен)
	Запись = Зеркало();
	Запись.ТокенДоступа = Токен;
	Возврат Запись;
КонецФункции

#КонецОбласти
