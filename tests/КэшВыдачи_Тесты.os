// Выдача популярного пакета без похода в хранилище: HEAD и «не изменилось» отвечают по записи
// версии, повторная выдача берётся из файлового кэша, перезапись версии отдаётся новой сразу.
// Контейнер ОСени с КоннекторInMemory; хранилище — S3 над фейковым клиентом со счётом обращений.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать autumn-cache
#Использовать entity
#Использовать "фикстуры"

Перем Поделка;
Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Засев;         // фикстура ЗасевРеестра — пул службами хаба
Перем КаталогКэша;   // каталог файлового кэша «артефакты»
Перем Стенд;         // фикстура СтендАпстримов — строка источника пула

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендАпстримов");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогМодулей = КаталогМодулей();
	Для Каждого Модуль Из СтрРазделить("данные,настройки,реестр,происшествия,прокси,сеть,события,аудит", ",") Цикл
		ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, Модуль, "Классы"));
	КонецЦикла;
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПодключитьХранилищеБезФабрики(ОбъединитьПути(КаталогМодулей, "хранилище", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "пробы"),
		"ГотовностьХаба");

	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить();
	РеестрФикстур.Подключить("ЖурналАудитаФайлом");
	РеестрФикстур.Подключить("ФейкКлиентS3");
	РеестрФикстур.Подключить("ХранилищеНаФейкеS3");

	КаталогКэша = УникальныеИмена.ВременныйКаталог("oshub-кэш-выдачи");

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.backend", "s3");
	Детальки.Вставить("oshub.upstream.probe.enabled", "false");
	Детальки.Вставить("cache.артефакты.Поставщик", "файлы");
	Детальки.Вставить("cache.артефакты.Каталог", КаталогКэша);
	Детальки.Вставить("cache.артефакты.Предел", ПределКэша());

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "кэш-выдачи-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендАпстримов(Поделка);

	// контроллер выдачи и права собираются руками: подключённые после контейнера, желудями они не станут
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "РезолверФайлаПакета");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "КонтроллерВыдачиAPI");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "права", "Классы"), "СервисПрав");
	РеестрФикстур.Подключить("СборкаКонтроллераВыдачи");
	РеестрФикстур.Подключить("ДопускКПулуЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиОтветаЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");

КонецПроцедуры

&ПослеВсех
Процедура УбратьКаталогКэша() Экспорт
	УникальныеИмена.УбратьВременное(КаталогКэша);
КонецПроцедуры

&Тест
Процедура HEADИНеИзменилосьОтвечаютБезХранилища() Экспорт

	Выпуск = Опубликовать("пакет лежит в хранилище");
	Клиент().ОбнулитьОбращения();

	Голова = Выдать(Выпуск, "HEAD");
	Ожидаем.Что(Голова.Код, "HEAD находит версию").Равно(200);
	Ожидаем.Что(Голова.Заголовок("Content-Length"), "размер — из записи версии")
		.Равно(Формат(Выпуск.Данные.Размер(), "ЧГ=0; ЧН=0"));
	Ожидаем.Что(Голова.Заголовок("X-Checksum-Sha256"), "сумма — из записи версии").Равно(Выпуск.Sha256);
	Ожидаем.Что(ЗначениеЗаполнено(Голова.Заголовок("Last-Modified")), "дата — из записи версии").ЭтоИстина();

	Повтор = Выдать(Выпуск, "GET", Голова.Заголовок("ETag"));
	Ожидаем.Что(Повтор.Код, "совпавшая метка — «не изменилось»").Равно(304);

	Ожидаем.Что(Клиент().Обращений(), "ни HEAD, ни «не изменилось» в хранилище не ходят").Равно(0);

КонецПроцедуры

&Тест
Процедура ПовторнаяВыдачаБерётсяИзКэша() Экспорт

	Выпуск = Опубликовать("популярный пакет");
	Клиент().ОбнулитьОбращения();

	Первая = Выдать(Выпуск);
	Ожидаем.Что(Первая.Код).Равно(200);
	Ожидаем.Что(Клиент().Обращений(), "первая выдача читает хранилище").Равно(1);

	Вторая = Выдать(Выпуск);
	Ожидаем.Что(Вторая.Код).Равно(200);
	Ожидаем.Что(Строка(Вторая.ТелоДвоичныеДанные), "повтор отдаёт то же тело").Равно(Строка(Выпуск.Данные));
	Ожидаем.Что(Вторая.Заголовок("Content-Length"), "длина — по отданному телу")
		.Равно(Формат(Выпуск.Данные.Размер(), "ЧГ=0; ЧН=0"));
	Ожидаем.Что(Клиент().Обращений(), "повтор, пока версия в кэше, в хранилище не ходит").Равно(1);

КонецПроцедуры

&Тест
Процедура ПерезаписьВерсииОтдаётсяНовойСразу() Экспорт

	Выпуск = Опубликовать("первая сборка");
	Выдать(Выпуск);

	Перезаписанный = Перезаписать(Выпуск, "перезаписанная сборка", Истина);
	Ответ = Выдать(Перезаписанный);

	Ожидаем.Что(Ответ.Код).Равно(200);
	Ожидаем.Что(Строка(Ответ.ТелоДвоичныеДанные), "первая же выдача отдаёт новое содержимое")
		.Равно(Строка(Перезаписанный.Данные));
	Ожидаем.Что(Ответ.Заголовок("X-Checksum-Sha256"), "и новую контрольную сумму").Равно(Перезаписанный.Sha256);
	Ожидаем.Что(Перезаписанный.Sha256, "самотест: перезапись сменила сумму").Не_().Равно(Выпуск.Sha256);

КонецПроцедуры

// Окно перезаписи: хранилище уже отдаёт новые байты, а реестр ещё помнит прежнюю сумму.
&Тест
Процедура РасхождениеСуммыВКэшНеПопадает() Экспорт

	Выпуск = Опубликовать("сборка до перезаписи");
	Перезаписанный = Перезаписать(Выпуск, "байты уже новые", Ложь);
	Клиент().ОбнулитьОбращения();

	След = СледВыдачи(Выпуск, УровниЛога.Отладка);
	Первая = След.Ответ;
	Ожидаем.Что(Первая.Код, "выдача не ломается").Равно(200);
	Ожидаем.Что(След.Журнал, "отладка называет обе суммы расхождения")
		.Содержит(СтрШаблон("Мимо кэша артефактов: %1 — сумма не совпала: ждали %2, получили %3",
			Выпуск.Координаты.Представление(), Выпуск.Sha256, Перезаписанный.Sha256));
	Ожидаем.Что(Строка(Первая.ТелоДвоичныеДанные), "клиент получает то, что лежит в хранилище")
		.Равно(Строка(Перезаписанный.Данные));

	Обращений = Клиент().Обращений();
	Выдать(Выпуск);
	Ожидаем.Что(Клиент().Обращений() - Обращений, "повтор снова читает хранилище: несверенное тело в кэш не легло")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ВерсияБезСуммыИдётМимоКэша() Экспорт

	Выпуск = Опубликовать("версия без суммы");
	Выпуск.Версия.Sha256 = "";
	Выпуск.Версия.Сохранить();
	Клиент().ОбнулитьОбращения();

	Для Номер = 1 По 2 Цикл
		След = СледВыдачи(Выпуск, УровниЛога.Отладка);
		Ожидаем.Что(След.Ответ.Код).Равно(200);
		Ожидаем.Что(Строка(След.Ответ.ТелоДвоичныеДанные)).Равно(Строка(Выпуск.Данные));
		Ожидаем.Что(След.Журнал, "отладка называет причину обхода кэша")
			.Содержит(СтрШаблон("Мимо кэша артефактов: %1 — у версии нет контрольной суммы",
				Выпуск.Координаты.Представление()));
	КонецЦикла;

	Ожидаем.Что(Клиент().Обращений(), "каждая выдача версии без суммы читает хранилище").Равно(2);

КонецПроцедуры

&Тест
Процедура КэшАртефактовЛежитФайламиВКаталогеИзНастройки() Экспорт

	Выпуск = Опубликовать("пакет для файлового кэша");
	Было = НайтиФайлы(КаталогКэша, "*.cache").Количество();

	Выдать(Выпуск);

	Файлы = НайтиФайлы(КаталогКэша, "*.cache");
	Ожидаем.Что(Файлы.Количество(), "выданная версия легла файлом в каталог кэша").Равно(Было + 1);

КонецПроцедуры

// Уборка кэша источников не смотрит, включён ли источник: у пула с выключенным источником файл
// может исчезнуть, пока запись версии жива. Такой пул о наличии спрашивает, и HEAD с «не изменилось»
// по записи не отвечают.
&Тест
Процедура ПулСВыключеннымИсточникомСпрашиваетНаличиеФайла() Экспорт

	Выпуск = Опубликовать("вытесненный из кэша источников");
	Стенд.Апстрим(Выпуск.Пул, , , , Ложь);
	Метка = Выдать(Выпуск, "HEAD").Заголовок("ETag");
	Желудь("ХранилищеАртефактов").Удалить(Выпуск.Координаты);

	Ожидаем.Что(Выдать(Выпуск, "HEAD").Код, "HEAD вытесненного файла по записи не отвечает").Равно(404);
	Ожидаем.Что(Выдать(Выпуск, "GET", Метка).Код, "и «не изменилось» тоже").Равно(404);

КонецПроцедуры

// Пул без строк источников: файлы его не вытесняются, и HEAD отвечает по записи версии,
// не спрашивая хранилище даже о наличии.
&Тест
Процедура ПулБезИсточниковОНаличииНеСпрашивает() Экспорт

	Выпуск = Опубликовать("пакет пула без источников");
	Желудь("ХранилищеАртефактов").Удалить(Выпуск.Координаты);
	Клиент().ОбнулитьОбращения();

	Ожидаем.Что(Выдать(Выпуск, "HEAD").Код, "HEAD отвечает по записи версии").Равно(200);
	Ожидаем.Что(Клиент().Обращений(), "о наличии файла хранилище не спрашивают").Равно(0);

КонецПроцедуры

// Между двумя обращениями к постоянно качаемой версии проходит поток разовых скачиваний
// больше ёмкости кэша. Простой LRU вытеснил бы её за этот поток, сегментированный — нет;
// файлы кэша при этом целиком укладываются в предел.
&Тест
Процедура РазовыеСкачиванияНеВытесняютГорячуюВерсию() Экспорт

	Горячая = Опубликовать(СодержимоеЗаписи("горячая версия"));
	Выдать(Горячая);
	Выдать(Горячая);

	Разовых = 25;
	Для Номер = 1 По Разовых Цикл
		Выдать(Опубликовать(СодержимоеЗаписи("разовая версия " + Номер)));
	КонецЦикла;
	Ожидаем.Что(Разовых * СтрДлина(СодержимоеЗаписи("")), "самотест: поток разовых больше ёмкости кэша")
		.Больше(ПределКэша());

	Клиент().ОбнулитьОбращения();
	Ответ = Выдать(Горячая);
	Ожидаем.Что(Ответ.Код).Равно(200);
	Ожидаем.Что(Клиент().Обращений(), "горячая версия пережила поток разовых и отдаётся из кэша").Равно(0);

	Файлы = НайтиФайлы(КаталогКэша, "*.cache");
	Занято = 0;
	Для Каждого Файл Из Файлы Цикл
		Занято = Занято + Файл.Размер();
	КонецЦикла;
	Ожидаем.Что(Занято, "файлы кэша укладываются в предел").МеньшеИлиРавно(ПределКэша());

КонецПроцедуры

// Разбор кэша по одной консоли: у первой выдачи виден промах — строкой библиотеки и строкой хаба
// с адресом и прочитанным размером, у второй — попадание; на INFO кэш выдачи молчит.
&Тест
Процедура ОтладкаПоказываетПромахИПопаданиеКэша() Экспорт

	Ожидаем.Что(СледВыдачи(Опубликовать("пакет под отладкой"), УровниЛога.Информация).Журнал,
		"на INFO кэш выдачи молчит").Равно("");

	Выпуск = Опубликовать("пакет под отладкой, второй");
	Адрес = Выпуск.Координаты.Представление();
	Размер = Формат(Выпуск.Данные.Размер(), "ЧГ=0; ЧН=0");

	Промах = СледВыдачи(Выпуск, УровниЛога.Отладка).Журнал;
	Ожидаем.Что(Промах, "библиотека называет промах по ключу — sha256 версии")
		.Содержит("Кэш ""артефакты"": промах, ключ С64:" + Выпуск.Sha256);
	Ожидаем.Что(Промах, "хаб называет, что прочитал из хранилища, с той же суммой и размером")
		.Содержит(СтрШаблон("Чтение в кэш артефактов: %1 (sha256 %2) прочитан из хранилища, %3 байт",
			Адрес, Выпуск.Sha256, Размер));
	Ожидаем.Что(Промах, "библиотека называет, что положила").Содержит("Кэш ""артефакты"": положено, ключ");
	Ожидаем.Что(Промах, "резолвер называет, откуда тело")
		.Содержит(СтрШаблон("Выдача: тело %1-1.0.0.ospx отдал слой кэша", Выпуск.Пакет.Имя));

	Попадание = СледВыдачи(Выпуск, УровниЛога.Отладка).Журнал;
	Ожидаем.Что(Попадание, "библиотека называет попадание").Содержит("Кэш ""артефакты"": попадание, ключ");
	Ожидаем.Что(СтрНайти(Попадание, "Чтение в кэш артефактов"), "на попадании хранилище не читается").Равно(0);
	Ожидаем.Что(Попадание, "резолвер называет, откуда тело").Содержит("отдал слой кэша");

КонецПроцедуры

#Область Помощники

// Публикует версию 1.0.0 нового пакета в новом публичном пуле без источников.
Функция Опубликовать(Знач Содержимое)

	Пул = Засев.ПулСервисом();
	ИмяПакета = УникальныеИмена.Имя("pkg");

	Пакет = Желудь("СервисПакетов").НайтиИлиЗарегистрировать(Пул.Идентификатор, ИмяПакета);
	Желудь("КаналыПоУмолчанию").Создать(Пакет.Идентификатор);

	Координаты = Новый КоординатыАртефакта(Пул.Имя, Пакет.Имя, "1.0.0");
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Содержимое);
	Сохранено = Желудь("ХранилищеАртефактов").Сохранить(Координаты, Данные);

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0");
	Заявка.Размер = Сохранено.Размер;
	Заявка.Sha256 = Сохранено.Sha256;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", Пул.Имя, Пакет.Имя);
	Версия = Желудь("СервисВерсий").Опубликовать(Заявка);

	Возврат Новый Структура("Пул, Пакет, Координаты, Версия, Данные, Sha256",
		Пул, Пакет, Координаты, Версия, Данные, Сохранено.Sha256);

КонецФункции

// Кладёт новые байты на тот же ключ хранилища; ВРеестре — вслед за ними меняет и запись версии.
Функция Перезаписать(Знач Выпуск, Знач Содержимое, Знач ВРеестре)

	Данные = ПолучитьДвоичныеДанныеИзСтроки(Содержимое);
	Сохранено = Желудь("ХранилищеАртефактов").Сохранить(Выпуск.Координаты, Данные);

	Если ВРеестре Тогда
		Выпуск.Версия.Sha256 = Сохранено.Sha256;
		Выпуск.Версия.Размер = Сохранено.Размер;
		Выпуск.Версия.Сохранить();
	КонецЕсли;

	Возврат Новый Структура("Пул, Пакет, Координаты, Версия, Данные, Sha256",
		Выпуск.Пул, Выпуск.Пакет, Выпуск.Координаты, Выпуск.Версия, Данные, Сохранено.Sha256);

КонецФункции

// Ответ маршрута выдачи на запрос точной версии; Метка — значение If-None-Match.
Функция Выдать(Знач Выпуск, Знач Метод = "GET", Знач Метка = "")

	Заголовки = Новый Соответствие();
	Если ЗначениеЗаполнено(Метка) Тогда
		Заголовки.Вставить("If-None-Match", Метка);
	КонецЕсли;

	Сборка = Новый СборкаКонтроллераВыдачи(Логирование.ПолучитьЛог("тест.oshub.кэшвыдачи"));
	Сборка.Резолвер = Желудь("РезолверВыдачи");
	Сборка.СервисПулов = Желудь("СервисПулов");
	Сборка.Права = Новый СервисПрав(Неопределено, Неопределено, Неопределено, Неопределено);

	Ответ = Новый ОтветСтраницыЗаглушка(Новый КукиОтветаЗаглушка());
	Сборка.Собрать().ФайлПула(Ответ, Выпуск.Пул.Имя, Выпуск.Пакет.Имя, Выпуск.Пакет.Имя + "-1.0.0.ospx",
		Метод, Заголовки, Новый КукиЗаглушка());

	Возврат Ответ;

КонецФункции

// Ответ и журнал одной выдачи на заданном уровне — у хаба (кэш и резолвер) и у библиотеки кэша.
Функция СледВыдачи(Знач Выпуск, Знач Уровень)

	Ловушка = Новый ЛовушкаЛога();
	Логи = Новый Массив();
	Прежние = Новый Массив();
	Для Каждого Имя Из СтрРазделить("КэшАртефактов,РезолверВыдачи,oscript.lib.autumn-cache", ",") Цикл
		Лог = Логирование.ПолучитьЛог(Имя);
		Логи.Добавить(Лог);
		Прежние.Добавить(Лог.Уровень());
		Лог.УстановитьУровень(Уровень);
		Лог.ДобавитьСпособВывода(Ловушка);
	КонецЦикла;

	Попытка
		Ответ = Выдать(Выпуск);
	Исключение
		ВернутьЛоги(Логи, Прежние, Ловушка);
		ВызватьИсключение;
	КонецПопытки;
	ВернутьЛоги(Логи, Прежние, Ловушка);

	Возврат Новый Структура("Ответ, Журнал", Ответ, Ловушка.Всё());

КонецФункции

// Уровень и способы вывода логов — как до теста: логи живут по имени на весь процесс.
Процедура ВернутьЛоги(Знач Логи, Знач Прежние, Знач Ловушка)
	Для Индекс = 0 По Логи.ВГраница() Цикл
		Логи[Индекс].УдалитьСпособВывода(Ловушка);
		Логи[Индекс].УстановитьУровень(Прежние[Индекс]);
	КонецЦикла;
КонецПроцедуры

Функция Клиент()
	Возврат Желудь("КлиентS3Набора");
КонецФункции

Функция ПределКэша()
	Возврат 1048576;
КонецФункции

// Содержимое в десятую долю предела без малого — самая тяжёлая запись, которую кэш ещё примет.
Функция СодержимоеЗаписи(Знач Метка)

	Размер = 100000;
	Части = Новый Массив();
	Части.Добавить(Метка);
	Длина = СтрДлина(Метка);
	Пока Длина < Размер Цикл
		Части.Добавить("0123456789");
		Длина = Длина + 10;
	КонецЦикла;

	Возврат Лев(СтрСоединить(Части), Размер);

КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Хранилище контейнера даёт фабрика набора, поэтому своя фабрика модуля и боевой клиент S3 не подключаются.
Процедура ПодключитьХранилищеБезФабрики(Знач Каталог)

	Для Каждого Файл Из ПоискКлассов.ФайлыКлассов(Каталог) Цикл
		Если Файл.ИмяБезРасширения <> "КонфигурацияХранилища" И Файл.ИмяБезРасширения <> "КлиентS3Oint" Тогда
			ПоискКлассов.ПодключитьФайл(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
