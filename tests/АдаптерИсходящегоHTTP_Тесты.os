// Юнит-тесты хабового адаптера исходящего HTTP (сеть/КлиентHTTP) и транспорта OIDC над ним.
// Сеть не дёргается: подставлены ФейкКоннектораHTTP и ФейкТранспортHTTP.

#Использовать asserts

Перем КаталогПроекта;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Подключить(ОбъединитьПути(Модули, "сеть", "Классы", "КлиентHTTP.os"), "КлиентHTTP");
	Подключить(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкОтветаКоннектора.os"), "ФейкОтветаКоннектора");
	Подключить(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкКоннектораHTTP.os"), "ФейкКоннектораHTTP");
	Подключить(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкТранспортHTTP.os"), "ФейкТранспортHTTP");

КонецПроцедуры

#Область ПредставлениеАгента

&Тест
Процедура АдаптерПредставляетсяUserAgentНаGETиPOST() Экспорт

	Коннектор = Новый ФейкКоннектораHTTP();
	Коннектор.НастроитьОтвет(200, ВДвоичные("{}"));
	Адаптер = Новый КлиентHTTP(Коннектор);

	Адаптер.Получить("https://api.github.com/user");
	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("User-Agent"),
		"GET без User-Agent api.github.com отдаёт 403").Равно(Адаптер.ИмяАгента());

	Адаптер.Отправить("https://github.com/login/oauth/access_token", "code=abc");
	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("User-Agent"),
		"POST на token endpoint — тоже с представлением").Равно(Адаптер.ИмяАгента());

	Ожидаем.Что(ЗначениеЗаполнено(Адаптер.ИмяАгента()), "имя агента не пустое").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СвойUserAgentВызывающегоПобеждаетУмолчание() Экспорт

	Коннектор = Новый ФейкКоннектораHTTP();
	Коннектор.НастроитьОтвет(200, ВДвоичные("{}"));
	Адаптер = Новый КлиентHTTP(Коннектор);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("User-Agent", "OpenHub-Mirror/2.0");
	Адаптер.Получить("https://hub.oscript.io/list.txt", Заголовки);

	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("User-Agent")).Равно("OpenHub-Mirror/2.0");

КонецПроцедуры

#КонецОбласти

#Область АдаптерPOST

&Тест
Процедура ОтправитьКодируетФормуТеломИСтавитIdentity() Экспорт

	Коннектор = Новый ФейкКоннектораHTTP();
	Коннектор.НастроитьОтвет(200, ВДвоичные("{""access_token"":""a""}"));
	Адаптер = Новый КлиентHTTP(Коннектор);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "application/json");
	Тело = "grant_type=authorization_code&code=abc";

	Ответ = Адаптер.Отправить("https://idp.test/token", Тело, Заголовки);

	// метод и тело: форма ушла именно телом POST
	Ожидаем.Что(Коннектор.ПоследнийМетод(), "адаптер вызвал POST").Равно("POST");
	Ожидаем.Что(Коннектор.ПоследнийURL()).Равно("https://idp.test/token");
	Ожидаем.Что(Коннектор.ПоследнееТело(), "форма x-www-form-urlencoded — телом запроса").Равно(Тело);
	// заголовки: identity + переданные вызывающим
	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("Accept-Encoding"), "целостность тела").Равно("identity");
	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("Content-Type")).Равно("application/x-www-form-urlencoded");
	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("Accept")).Равно("application/json");
	// ответ приведён к контракту адаптера {Код, Заголовки, Данные}
	Ожидаем.Что(Ответ.Код).Равно(200);
	Ожидаем.Что(ИзДвоичных(Ответ.Данные)).Равно("{""access_token"":""a""}");

КонецПроцедуры

&Тест
Процедура ОтправитьНеСледуетРедиректамИНеРетраит() Экспорт

	Коннектор = Новый ФейкКоннектораHTTP();
	Коннектор.НастроитьОтвет(302, ВДвоичные(""));
	Адаптер = Новый КлиентHTTP(Коннектор);

	Ответ = Адаптер.Отправить("https://idp.test/token", "grant_type=authorization_code");

	// паритет с нативным HTTPСоединением: без авто-редиректа и без ретраев — код как есть
	Ожидаем.Что(Коннектор.ПоследнийПараметр("РазрешитьПеренаправление"), "POST без авто-редиректа").ЭтоЛожь();
	Ожидаем.Что(Коннектор.ПоследнийПараметр("МаксимальноеКоличествоПовторов"), "без ретраев").Равно(0);
	Ожидаем.Что(Ответ.Код, "код возвращается как есть").Равно(302);

КонецПроцедуры

&Тест
Процедура ОтправитьПробрасываетСетевойСбой() Экспорт

	Коннектор = Новый ФейкКоннектораHTTP();
	Коннектор.ЭмулироватьСбой();
	Адаптер = Новый КлиентHTTP(Коннектор);

	Сбой = Ложь;
	Попытка
		Адаптер.Отправить("https://idp.test/token", "grant_type=authorization_code");
	Исключение
		Сбой = Истина;
	КонецПопытки;
	Ожидаем.Что(Сбой, "сетевой сбой пробрасывается исключением, не гасится").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область АдаптерGET

&Тест
Процедура ПолучитьСтавитIdentityИВозвращаетДвоичныеБезРедиректа() Экспорт

	Коннектор = Новый ФейкКоннектораHTTP();
	Коннектор.НастроитьОтвет(200, ВДвоичные("{""issuer"":""x""}"));
	Адаптер = Новый КлиентHTTP(Коннектор);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept", "application/json");

	Ответ = Адаптер.Получить("https://idp.test/.well-known/openid-configuration", Заголовки);

	Ожидаем.Что(Коннектор.ПоследнийМетод(), "адаптер вызвал GET").Равно("GET");
	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("Accept-Encoding")).Равно("identity");
	Ожидаем.Что(Коннектор.ПоследнийЗаголовок("Accept")).Равно("application/json");
	Ожидаем.Что(Коннектор.ПоследнийПараметр("РазрешитьПеренаправление")).ЭтоЛожь();
	Ожидаем.Что(Коннектор.ПоследнийПараметр("МаксимальноеКоличествоПовторов")).Равно(0);
	Ожидаем.Что(Ответ.Код).Равно(200);
	Ожидаем.Что(ИзДвоичных(Ответ.Данные)).Равно("{""issuer"":""x""}");

КонецПроцедуры

// Редирект отслеживает 1connector — своей ходьбы по Location у хаба нет. Включается он
// поштучно, потому что конечный адрес цепочки SSRF-гейт уже не проверяет.
&Тест
Процедура ПолучитьВключаетРедиректыТолькоПоПросьбе() Экспорт

	Коннектор = Новый ФейкКоннектораHTTP();
	Коннектор.НастроитьОтвет(200, ВДвоичные("тело"));
	Адаптер = Новый КлиентHTTP(Коннектор);

	Адаптер.Получить("https://hub.test/download/pkg/pkg-1.0.0.ospx", , 20, Истина, Истина);
	Ожидаем.Что(Коннектор.ПоследнийПараметр("РазрешитьПеренаправление"),
		"просьба идти по редиректам доезжает до 1connector").ЭтоИстина();

	Адаптер.Получить("https://hub.test/download/pkg/pkg-1.0.0.ospx");
	Ожидаем.Что(Коннектор.ПоследнийПараметр("РазрешитьПеренаправление"),
		"по умолчанию редиректы по-прежнему выключены").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ДелегированиеТранспортаOIDC

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВДвоичные(Знач Текст)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8");
КонецФункции

Функция ИзДвоичных(Знач Двоичные)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Двоичные, "UTF-8");
КонецФункции

Процедура Подключить(Знач ПутьФайла, Знач ИмяКласса)
	Если НЕ ТипЗарегистрирован(ИмяКласса) Тогда
		ПодключитьСценарий(ПутьФайла, ИмяКласса);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти
