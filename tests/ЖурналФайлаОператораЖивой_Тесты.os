// Живой хаб с файлом настроек оператора против фейкового коллектора: уровень, названный логу
// родным узлом logos.logger файла, действует, а порог коллектора WARN пропускает в коллектор
// предупреждения и не пропускает сведений.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем Коллектор;
Перем Разбор;           // РазборOTLP — записи журнала значениями
Перем КаталогОператора; // рабочий каталог хаба с файлом настроек оператора

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");
	РеестрФикстур.Подключить("РазборOTLP");

	Разбор = Новый РазборOTLP();
	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	// оператор поднимает отладку готовности РОДНЫМ ключом logos, а не переменной хаба
	КаталогОператора = УникальныеИмена.ВременныйПуть("openhub-журнал-файл");
	СоздатьКаталог(КаталогОператора);
	Запись = Новый ЗаписьТекста(ОбъединитьПути(КаталогОператора, "autumn-properties.json"), КодировкаТекста.UTF8);
	Запись.Записать("{""logos"": {""logger"": {""" + ЛогИзФайла() + """: ""DEBUG""}}}");
	Запись.Закрыть();

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.РабочийКаталог(КаталогОператора);
	Хаб.ФайловаяБаза("openhub-журнал-файл");
	Хаб.Среда("OTEL_ENABLED", "true");
	Хаб.Среда("OTEL_SERVICE_NAME", Служба());
	Хаб.Среда("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Хаб.Среда("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	// пустой хаб без основного пула предупреждает об этом на старте — это и есть строка WARN
	Хаб.Среда("OSHUB_LOG_OTEL_LEVEL", "WARN");

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;
	Если ЗначениеЗаполнено(КаталогОператора) Тогда
		УдалитьФайлы(КаталогОператора);
	КонецЕсли;

КонецПроцедуры

// Родные ключи logos.logger файла оператора прежде перекрывала связка хаба целиком.
&Тест
Процедура УровеньИзУзлаФайлаОператораДействует() Экспорт

	Ожидаем.Что(СтрокКонсоли("ОТЛАДКА - [" + ЛогИзФайла() + "]") > 0,
		"отладка готовности, поднятая файлом, напечатана").ЭтоИстина();
	Ожидаем.Что(СтрокКонсоли("ОТЛАДКА - [") - СтрокКонсоли("ОТЛАДКА - [" + ЛогИзФайла() + "]"),
		"отладка остальных логов закрыта").Равно(0);

КонецПроцедуры

// Порог коллектора — регулятор нагрузки: WARN пропускает предупреждения и не пропускает
// ни сведений, ни отладки, которые консоль при этом печатает.
&Тест
Процедура ПорогКоллектораWARNПропускаетWARNИНеПропускаетINFO() Экспорт

	Коллектор.ДождатьсяПартии("logs", ПредупреждениеПустогоХаба());

	Ожидаем.Что(СтрокКонсоли(Хаб.МаркерЗавершенияСтарта()) > 0, "сведение в консоли есть").ЭтоИстина();

	Предупреждений = 0;
	НижеПорога = Новый Массив();
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Уровень < УровеньWARN() Тогда
			НижеПорога.Добавить(Запись.Лог + ": " + Запись.Текст);
		ИначеЕсли СтрНайти(Запись.Текст, ПредупреждениеПустогоХаба()) > 0 Тогда
			Предупреждений = Предупреждений + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Предупреждений > 0, "предупреждение уехало в коллектор").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(НижеПорога, Символы.ПС), "ниже WARN в коллекторе ничего").Равно("");

КонецПроцедуры

#Область Обвязка

Функция Служба()
	Возврат "openhub-журнал-файл";
КонецФункции

Функция ПредупреждениеПустогоХаба()
	Возврат "Основной пул хаба не назначен";
КонецФункции

Функция ЛогИзФайла()
	Возврат "ГотовностьХаба";
КонецФункции

// severityNumber OTel для WARN — от 13.
Функция УровеньWARN()
	Возврат 13;
КонецФункции

Функция ЗаписиСлужбы()
	Результат = Новый Массив();
	Для Каждого Запись Из Разбор.ЗаписиЖурнала(Коллектор.Принятое("logs")) Цикл
		Если Запись.Служба = Служба() Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтрокКонсоли(Знач Фрагмент)
	Сколько = 0;
	Для Каждого Строка_ Из СтрРазделить(Хаб.Дамп(), Символы.ПС, Ложь) Цикл
		Если СтрНайти(Строка_, Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;
КонецФункции

#КонецОбласти
