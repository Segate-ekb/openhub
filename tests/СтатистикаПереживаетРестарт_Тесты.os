// HTTP-сторож долговечности счётчика скачиваний: настоящие GET артефакта, остановка хаба
// и повторный старт на той же базе — карточка пакета показывает то же число, что до остановки.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;              // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем КаталогПроекта;
Перем КореньДанных;     // переживает остановку хаба: удаляется только в &ПослеВсех

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	// каталог заводим сами: ФайловаяБаза() фикстуры сносит свой корень в Остановить(),
	// а базу надо передать второму экземпляру хаба
	КореньДанных = ОбъединитьПути(КаталогВременныхФайлов(),
		"openhub-стат-рестарт-" + Лев(Строка(Новый УникальныйИдентификатор()), 8));
	СоздатьКаталог(КаталогБазы());
	СоздатьКаталог(КореньХранилища());

	Хаб = НовыйЭкземпляр();
	ЗапуститьСидер(ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьХаб.os"));

	Хаб.Запустить();
	Порт = Хаб.Порт();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Попытка
		Если ЗначениеЗаполнено(КореньДанных) И Новый Файл(КореньДанных).Существует() Тогда
			УдалитьФайлы(КореньДанных);
		КонецЕсли;
	Исключение
		// временные файлы — не повод ронять набор
	КонецПопытки;

КонецПроцедуры

// Так потерю видит пользователь хаба: скачал пакет, хаб перезапустили, счётчик карточки
// откатился. Со сквозной записью (порог сброса 1) откатываться нечему — агрегат уходит
// в базу внутри самого запроса на выдачу.
&Тест
Процедура СчётчикСкачиванийПереживаетОстановкуХаба() Экспорт

	Было = СкачиванийПоКарточке();

	Для Счёт = 1 По 7 Цикл
		Ожидаем.Что(Новый КлиентХаба(Хаб, 30).GET(ПутьАртефакта()).КодСостояния,
			СтрШаблон("артефакт отдан (скачивание %1)", Счёт)).Равно(200);
	КонецЦикла;

	Набрано = Было + 7;
	Ожидаем.Что(СкачиванийПоКарточке(), "карточка показывает все семь скачиваний").Равно(Набрано);

	ПерезапуститьХаб();

	Ожидаем.Что(СкачиванийПоКарточке(),
		"счётчик пережил остановку хаба: скачивания были в базе, а не только в памяти")
		.Равно(Набрано);

КонецПроцедуры

#Область Инфраструктура

Функция КаталогБазы()
	Возврат ОбъединитьПути(КореньДанных, "db");
КонецФункции

Функция КореньХранилища()
	Возврат ОбъединитьПути(КореньДанных, "storage");
КонецФункции

Функция ПутьАртефакта()
	Возврат "/api/v1/pools/main/download/winow/winow-1.1.0.ospx";
КонецФункции

// Экземпляр на общей базе и со сквозной записью статистики: порог сброса 1 означает,
// что агрегат обновляется до того, как ответ уйдёт клиенту.
Функция НовыйЭкземпляр()

	Экземпляр = Новый ЭкземплярХаба(90, КаталогПроекта);
	Экземпляр.Среда("OSHUB_DB_CONNECTION", КаталогБазы());
	Экземпляр.Среда("OSHUB_STORAGE_ROOT", КореньХранилища());
	Экземпляр.Среда("OSHUB_STATS_FLUSH__THRESHOLD", "1");
	Возврат Экземпляр;

КонецФункции

// Снимает хаб и поднимает новый на той же базе. Фикстура убивает процесс, не давая ему
// проститься, — ровно как рестарт, деплой или OOM в бою.
Процедура ПерезапуститьХаб()

	Хаб.Остановить();
	Хаб = НовыйЭкземпляр();
	Хаб.Запустить();
	Порт = Хаб.Порт();

КонецПроцедуры

Процедура ЗапуститьСидер(Знач Сидер)

	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), КаталогПроекта, Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();

	Если Процесс.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер завершился с кодом %1: %2",
			Процесс.КодВозврата, Процесс.ПолучитьВыводПотокаОшибок());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область HTTPПомощники

// Число скачиваний так, как его читает пользователь: карточка пакета в публичном API.
Функция СкачиванийПоКарточке()

	Ответ = Новый КлиентХаба(Хаб, 30).GET("/api/v1/pools/main/packages/winow");
	Ожидаем.Что(Ответ.КодСостояния, "карточка пакета отдана").Равно(200);

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Тело = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Карточка = Тело.Получить("package");
	Ожидаем.Что(Карточка <> Неопределено, "в ответе есть карточка пакета").ЭтоИстина();

	Возврат Число(Карточка.Получить("downloads"));

КонецФункции

#КонецОбласти
