// Пульт журнала на живом хабе против фейкового коллектора: администратор правит логи формой
// экрана «Логи», как браузер без скрипта, а набор смотрит, куда после правки уходят строки —
// в ленту экрана, в консоль, в коллектор — и что правка оставила в журнале аудита.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент;
Перем Коллектор;
Перем Разбор;     // РазборOTLP — записи журнала значениями
Перем Браузер;    // ФормаСоСтраницы — форма страницы так, как её отправил бы браузер
Перем КукаRoot;
Перем Тронутые;   // Массив из Строка — логи, которые тест правил с экрана
Перем КореньТронут;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьКоллекторИХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоКоллектора");
	РеестрФикстур.Подключить("РазборOTLP");
	РеестрФикстур.Подключить("ФормаСоСтраницы");
	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей(), "наблюдаемость", "Классы"), "ПутиЖурнала");

	Разбор = Новый РазборOTLP();
	Браузер = Новый ФормаСоСтраницы();
	Коллектор = Новый ЭкземплярФейковогоКоллектора();
	Коллектор.Запустить();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 60);
	Хаб.ФайловаяБаза("openhub-пульт-журнала");
	ЗадатьСреду(Хаб, Служба());
	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));

	Хаб.Запустить();

	КукаRoot = Клиент.Войти("root", "RootPassw0rd");
	Тронутые = Новый Массив();
	КореньТронут = Ложь;

КонецПроцедуры

// Среда подопытного хаба; второй хаб набора поднимается с той же средой и строками закрепления.
Процедура ЗадатьСреду(Экземпляр, Знач ИмяСлужбы)

	Экземпляр.Среда("OSHUB_ADMIN_LOGIN", "");
	Экземпляр.Среда("OSHUB_ADMIN_PASSWORD", "");
	Экземпляр.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Экземпляр.Среда("OTEL_ENABLED", "true");
	Экземпляр.Среда("OTEL_SERVICE_NAME", ИмяСлужбы);
	Экземпляр.Среда("OTEL_EXPORTER_OTLP_ENDPOINT", Коллектор.Адрес());
	Экземпляр.Среда("OTEL_EXPORTER_OTLP_PROTOCOL", "http/json");
	// поднят настройкой: планировщик пишет им отладку каждую секунду, мимо коллектора;
	// вход — отладкой с логином: неудачный вход с меткой отмечает конец партии в коллекторе;
	// контроллер настроек — свой уровень, равный корню
	Экземпляр.Среда("OSHUB_LOG_LEVELS", Планировщик() + "=DEBUG," + Вход() + "=DEBUG," + Контроллер() + "=INFO");
	// издатель событий живёт на корне, а порог коллектора INFO ему назван: при корне INFO он ничего не сужает
	Экземпляр.Среда("OSHUB_LOG_OTEL_LEVELS", Планировщик() + "=DISABLE," + Настройки() + "=WARN," + Издатель() + "=INFO");
	Экземпляр.Среда("OSHUB_JOBS_STATS__FLUSH__INTERVAL__SEC", "1");
	// метки — неудачные входы с одного адреса: запирание адреса их бы оборвало
	Экземпляр.Среда("OSHUB_AUTH_LOGIN_MAXATTEMPTS", "100000");
	// непригодный акцент: служба настроек на каждое чтение предупреждает и называет значение
	Экземпляр.Среда("OSHUB_UI_ACCENT", АдресВАкценте());

КонецПроцедуры

&ПослеВсех
Процедура УбратьХабИКоллектор() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	Если Коллектор <> Неопределено Тогда
		Коллектор.Остановить();
	КонецЕсли;

КонецПроцедуры

// Тронутое тестом возвращается к старту кнопкой половины «Строки» и выбором «как при старте»
// у корня: подтверждение «Вернуть всё» соседние наборы экрана стерегут сами.
&ПослеКаждого
Процедура ВернутьТронутоеКСтарту() Экспорт

	Если КореньТронут Тогда
		ЗадатьУровеньКорня("start");
	КонецЕсли;
	Если Тронутые.Количество() > 0 Тогда
		Строки = СтраницаСтрок(Тронутые);
		Если СтрНайти(Строки, "value=""вернуть-логи""") > 0 Тогда
			ОтправитьПоля(Браузер.Поля(Строки, "value=""вернуть-логи"""));
		КонецЕсли;
		Ожидаем.Что(СтрНайти(СтраницаСтрок(Тронутые), "value=""вернуть-логи""") = 0,
			"после теста с экрана ничего не задано").ЭтоИстина();
	КонецЕсли;
	Тронутые = Новый Массив();
	КореньТронут = Ложь;

КонецПроцедуры

#Область Уровень

// Лог, поднятый до DEBUG с экрана, со следующего запроса пишет отладку в ленту и в коллектор;
// отладки логов, которых никто не поднимал, в коллекторе нет.
&Тест
Процедура ПоднятыйСЭкранаЛогПишетОтладкуВЛентуИКоллектор() Экспорт

	ЗадатьУровень(Контроллер(), "DEBUG");
	Запись = ПоследняяПравкаВАудите();
	Ожидаем.Что(Запись["действие"], "правка в журнале аудита").Равно("логи.уровень.изменён");
	Ожидаем.Что(Запись["кто"], "кем").Равно("root");
	Ожидаем.Что(Запись["детали"]["было"][Контроллер()], "с какого").Равно("INFO");
	Ожидаем.Что(Запись["детали"]["стало"], "на какое").Равно("DEBUG");
	Ожидаем.Что(ЗначениеЗаполнено(Запись["ip"]), "и откуда: адрес клиента").ЭтоИстина();

	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Отметить();

	Ожидаем.Что(СтрокЛенты(Контроллер(), "DEBUG", "Настройки хаба API: раздел") > 0,
		"лента экрана показывает отладку поднятого лога").ЭтоИстина();
	Ожидаем.Что(ЗаписейКоллектора(Контроллер(), "Настройки хаба API: раздел") > 0,
		"и коллектор её получил").ЭтоИстина();

	Чужие = Новый Массив();
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Уровень <= УровеньDEBUG() И Запись.Лог <> Контроллер() И Запись.Лог <> Вход() Тогда
			Чужие.Добавить(Запись.Лог + ": " + Запись.Текст);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Чужие, Символы.ПС), "отладки логов, которых не поднимали, в коллекторе нет")
		.Равно("");

КонецПроцедуры

// Отправка в коллектор, выключенная с экрана: строки лога в коллектор больше не приходят,
// а в ленте продолжаются.
&Тест
Процедура ВыключеннаяОтправкаМолчитВКоллектореАЛентаПишет() Экспорт

	ЗадатьУровень(Контроллер(), "DEBUG");
	ВыключитьОтправку(Контроллер());
	Отметить();
	БылоВКоллекторе = ЗаписейКоллектора(Контроллер(), "Настройки хаба API: раздел");
	БылоВКонсоли = СтрокКонсоли("Настройки хаба API: раздел");

	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Отметить();

	Ожидаем.Что(ЗаписейКоллектора(Контроллер(), "Настройки хаба API: раздел"), "в коллектор — ни строки")
		.Равно(БылоВКоллекторе);
	Ожидаем.Что(СтрокКонсоли("Настройки хаба API: раздел") > БылоВКонсоли, "лог пишет дальше").ЭтоИстина();
	Ожидаем.Что(СтрокЛенты(Контроллер(), "DEBUG", "Настройки хаба API: раздел") > 0, "и лента его показывает")
		.ЭтоИстина();

КонецПроцедуры

// Правка корня доходит до логов, живущих на корне, и не трогает лог со своим уровнем.
&Тест
Процедура ПравкаКорняНеТрогаетЛогСоСвоимУровнем() Экспорт

	БылоКонтроллера = СтрокКонсоли("Настройки хаба API: раздел");
	БылоИздателя = СтрокКонсоли("События: ""настройка.изменена""");

	ЗадатьУровеньКорня("DEBUG");
	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Отметить();

	Ожидаем.Что(СтрокКонсоли("События: ""настройка.изменена""") > БылоИздателя,
		"издатель событий живёт на корне — его отладка пошла").ЭтоИстина();
	Ожидаем.Что(СтрокКонсоли("Настройки хаба API: раздел"), "у контроллера свой уровень — отладки нет")
		.Равно(БылоКонтроллера);

КонецПроцедуры

// Явный уровень, равный корневому, закрепляется за логом, и запись аудита говорит, что изменилось:
// своего уровня у лога не было — он жил как корень.
&Тест
Процедура ЯвныйУровеньРавныйКорневомуВАудитеКакУКорня() Экспорт

	ЗадатьУровеньКорня("DEBUG");
	ЗадатьУровень(Настройки(), "DEBUG");

	Запись = ПоследняяПравкаВАудите();
	Ожидаем.Что(Запись["действие"], "правка лога записана").Равно("логи.уровень.изменён");
	Ожидаем.Что(Запись["объект"], "об уровнях логов").Равно("настройка/oshub.log.levels");
	Ожидаем.Что(Запись["детали"]["было"][Настройки()], "было — как у корня").Равно("DEFAULT");
	Ожидаем.Что(Запись["детали"]["стало"], "стало — свой DEBUG").Равно("DEBUG");
	Ожидаем.Что(ПравокПультаОЛоге(Настройки()) > 0, "правка лога находится по его имени в деталях").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Порог

// Уровень лога, поднятый с экрана выше порога коллектора, не оставляет порогу его строки:
// в коллектор не уходит ничего подробнее уровня лога. Возврат к старту возвращает порог.
&Тест
Процедура ПорогКоллектораНеШиреУровняИВозвращаетсяСоСтартом() Экспорт

	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Отметить();
	Было = ЗаписейКоллектора(Настройки(), ФрагментАкцента());
	Ожидаем.Что(Было > 0, "при старте предупреждения службы настроек уходят в коллектор").ЭтоИстина();

	// страница и форма правки сами читают акцент: отсчёт — после правки
	ЗадатьУровень(Настройки(), "ERROR");
	Отметить();
	ПослеПравки = ЗаписейКоллектора(Настройки(), ФрагментАкцента());
	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Отметить();
	Ожидаем.Что(ЗаписейКоллектора(Настройки(), ФрагментАкцента()), "уровень ERROR — WARN в коллектор не идёт")
		.Равно(ПослеПравки);

	ВернутьКСтарту(Настройки());
	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Отметить();
	Ожидаем.Что(ЗаписейКоллектора(Настройки(), ФрагментАкцента()) > Было, "вернули к старту — снова идёт")
		.ЭтоИстина();

КонецПроцедуры

// Порог INFO при уровне INFO ничего не сужает, но задан: издатель событий, поднятый с экрана до
// DEBUG, пишет отладку в консоль и в ленту, а в коллектор — нет.
&Тест
Процедура ПорогINFOНеПускаетОтладкуПоднятогоЛогаВКоллектор() Экспорт

	ЗадатьУровень(Издатель(), "DEBUG");
	// каждая правка пульта публикует событие аудита — издатель пишет о нём отладку
	ЗадатьУровень(Контроллер(), "WARN");
	Отметить();

	Ожидаем.Что(СтрокКонсоли("События: ""настройка.изменена""") > 0, "отладка издателя в консоли").ЭтоИстина();
	Ожидаем.Что(СтрокЛенты(Издатель(), "DEBUG", "настройка.изменена") > 0, "и в ленте").ЭтоИстина();
	Отладка = 0;
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Лог = Издатель() И Запись.Уровень <= УровеньDEBUG() Тогда
			Отладка = Отладка + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Отладка, "в коллекторе отладки издателя нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Возврат

// «Как при старте» возвращает и уровень, и отправку; лог, поднятый настройкой, снова поднят,
// и это видит поток планировщика, а не только поток запроса.
&Тест
Процедура ВозвратКСтартуВозвращаетУровеньИОтправкуИЕгоВидитПланировщик() Экспорт

	ЗадатьУровень(Настройки(), "ERROR");
	ВыключитьОтправку(Настройки());
	ВернутьКСтарту(Настройки());
	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Было = ЗаписейКоллектора(Настройки(), ФрагментАкцента());
	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Отметить();
	Ожидаем.Что(ЗаписейКоллектора(Настройки(), ФрагментАкцента()) > Было,
		"уровень и отправка вернулись: предупреждения снова в коллекторе").ЭтоИстина();

	ЗадатьУровень(Планировщик(), "INFO");
	ПодождатьСекунд(2);
	Затихло = СтрокКонсоли("Фоновая задача ""сброс-статистики"" отработала");
	ПодождатьСекунд(3);
	Ожидаем.Что(СтрокКонсоли("Фоновая задача ""сброс-статистики"" отработала"),
		"планировщик видит правку: его отладка стихла").Равно(Затихло);

	ВернутьКСтарту(Планировщик());
	ПодождатьСекунд(3);
	Ожидаем.Что(СтрокКонсоли("Фоновая задача ""сброс-статистики"" отработала") > Затихло,
		"лог, поднятый настройкой, после возврата снова пишет отладку").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Аудит

// Лог «аудит» с экрана не правится даже подделанной формой: пульт его не меняет, записи аудита о нём
// нет, закрепить нечего; а строки аудита пишутся и при корне, приглушённом до ERROR, — запись о самой
// этой правке в журнале. Отказ пульта log.read_only стережёт набор на контейнере.
&Тест
Процедура ЛогАудитаНеПравитсяАСтрокиАудитаПишутся() Экспорт

	Страница = СтраницаДерева("аудит");
	Поля = Браузер.Поля(Страница, "операция"" value=""дерево");
	// подделка: страница выбора уровня у лога только для чтения не печатает
	Поля.Добавить(Новый Структура("Имя, Значение", "уровень|аудит", "DEBUG"));
	Ответ = Клиент.POSTФормыБезПереходов(Дерево(), Браузер.Тело(Поля), Клиент.СтрокаКукиСессии(КукаRoot));
	Ожидаем.Что(Ответ.КодСостояния < 500, "подделка не роняет экран").ЭтоИстина();

	Ожидаем.Что(ПравокПультаОЛоге("аудит"), "записи аудита о правке лога «аудит» нет").Равно(0);
	Закрепить = СтрокиЗакрепления(СтраницаДерева(""));
	Ожидаем.Что(Закрепить.Получить("OSHUB_LOG_LEVELS") = Неопределено
		ИЛИ СтрНайти(Закрепить.Получить("OSHUB_LOG_LEVELS"), "аудит=") = 0, "уровня «аудит» с экрана нет").ЭтоИстина();

	ЗадатьУровеньКорня("ERROR");
	Запись = ПоследняяПравкаВАудите();
	Ожидаем.Что(Запись["действие"], "запись о правке корня есть").Равно("логи.уровень.изменён");
	Ожидаем.Что(Запись["объект"], "объект — уровень корня").Равно("настройка/oshub.log.level");
	Ожидаем.Что(Запись["детали"]["стало"], "корень приглушён").Равно("ERROR");

КонецПроцедуры

#КонецОбласти

#Область Пути

// Путь оператора называет только логи, которые у живого хаба есть: экран под отбором пути
// печатает выбор уровня каждого из них.
&Тест
Процедура КаждыйЛогПутиЕстьУЖивогоХаба() Экспорт

	Нет = Новый Массив();
	Для Каждого Путь Из Новый ПутиЖурнала().Пути() Цикл
		Страница = Клиент.Тело(Клиент.GETСКукой(Дерево() + "?path=" + Путь.Ключ, КукаRoot));
		Для Каждого Имя Из Путь.Логи Цикл
			Если СтрНайти(Страница, "name=""уровень|" + Имя + """") = 0 Тогда
				Нет.Добавить(Путь.Ключ + ": " + Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нет, ", "), "логи путей, которых у хаба нет").Равно("");

КонецПроцедуры

// Каждый класс хаба, который пишет в журнал, пока идёт вход, назван путём «вход»: участники дела
// видны одной трассой запроса в коллекторе. Корень поднят до DEBUG — пишут все, кто участвует.
&Тест
Процедура УчастникиВходаНазваныПутём() Экспорт

	ЗадатьУровеньКорня("DEBUG");
	Метка = Отметить();

	Трасса = "";
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если СтрНайти(Запись.Текст, Метка) > 0 И ЗначениеЗаполнено(Запись.Трасса) Тогда
			Трасса = Запись.Трасса;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ЗначениеЗаполнено(Трасса), "у запроса входа есть трасса с записью о нём").ЭтоИстина();

	Вход_ = Новый Массив();
	Для Каждого Путь Из Новый ПутиЖурнала().Пути() Цикл
		Если Путь.Ключ = "login" Тогда
			Вход_ = Путь.Логи;
		КонецЕсли;
	КонецЦикла;
	Участники = Новый Массив();
	Неназванные = Новый Массив();
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Трасса <> Трасса ИЛИ НЕ ЭтоКлассХаба(Запись.Лог) ИЛИ Участники.Найти(Запись.Лог) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Участники.Добавить(Запись.Лог);
		Если Вход_.Найти(Запись.Лог) = Неопределено Тогда
			Неназванные.Добавить(Запись.Лог);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Участники.Количество() > 1, "в трассе входа пишут несколько классов: "
		+ СтрСоединить(Участники, ", ")).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Неназванные, ", "), "участники входа, которых путь не называет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Лента

// Строка ленты — та же, что ушла в консоль: адрес почты в ней обезличен.
&Тест
Процедура СтрокаЛентыТаЖеЧтоВКонсолиИПочтаОбезличена() Экспорт

	Клиент.GETСКукой("/api/v1/hub/settings", КукаRoot);
	Лента = Клиент.Тело(Клиент.GETСКукой(Лента(Настройки(), "WARN"), КукаRoot));
	Строка_ = ТекстСтрокиЛенты(Лента, ФрагментАкцента());

	Ожидаем.Что(Строка_, "лента показывает предупреждение").Содержит("a***@example.org");
	Ожидаем.Что(СтрНайти(Лента, АдресВАкценте()), "сырого адреса в ленте нет").Равно(0);
	Ожидаем.Что(СтрНайти(Хаб.Дамп(), АдресВАкценте()), "и в консоли нет").Равно(0);
	Ожидаем.Что(СтрНайти(Хаб.Дамп(), Строка_) > 0, "в консоли — та же строка").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Закрепление

// Хаб, поднятый с прежней средой и строками «Закрепить», которые напечатал экран, пишет так же,
// как хаб после правок с экрана: уровень, отправка в коллектор, выключенная и включённая отправка.
&Тест
Процедура ЗакреплённоеПоднимаетХабВТомЖеСостоянии() Экспорт

	ЗадатьУровень(Контроллер(), "DEBUG");
	ВыключитьОтправку(Настройки());
	ВключитьОтправку(Планировщик());
	Ожидаем.Что(Браузер.Значение(Браузер.Поля(СтраницаДерева(Планировщик()), "операция"" value=""дерево"),
		"было-otel|" + Планировщик()), "на первом хабе отправка планировщика включена").Равно("1");
	Строки = СтрокиЗакрепления(СтраницаДерева(""));
	Ожидаем.Что(Строки.Получить("OSHUB_LOG_LEVELS"), "экран печатает строку уровней").Содержит(Контроллер() + "=DEBUG");
	Ожидаем.Что(Строки.Получить("OSHUB_LOG_LEVELS"), "и названное ею при старте").Содержит(Вход() + "=DEBUG");

	Второй = Новый ЭкземплярХаба(90);
	Попытка
		Второй.ФайловаяБаза("openhub-пульт-журнала-2");
		ЗадатьСреду(Второй, СлужбаВторого());
		Для Каждого Строка_ Из Строки Цикл
			Второй.Среда(Строка_.Ключ, Строка_.Значение);
		КонецЦикла;
		Второй.ЗапуститьСидер(ОбъединитьПути(Второй.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os"));
		Второй.Запустить();
		ПроверитьВторой(Второй);
	Исключение
		Второй.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	Второй.Остановить();

КонецПроцедуры

Процедура ПроверитьВторой(Второй)

	КлиентВторого = Новый КлиентХаба(Второй, 60);
	Кука = КлиентВторого.Войти("root", "RootPassw0rd");
	КлиентВторого.GETСКукой("/api/v1/hub/settings", Кука);
	// метка уходит после первой отладки планировщика: всё, что хаб написал до метки, доезжает с ней
	ДождатьсяВКонсоли(Второй, "Фоновая задача ""сброс-статистики"" отработала");
	Метка = "метка-" + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	КлиентВторого.ЗапросJSON("POST", "/api/v1/login", СтрШаблон("{""логин"":""%1"",""пароль"":""x""}", Метка));
	Коллектор.ДождатьсяПартии("logs", Метка);

	Ожидаем.Что(СтрНайти(Второй.Дамп(), "Настройки хаба API: раздел") > 0, "уровень контроллера закреплён").ЭтоИстина();

	ОтНастроек = 0;
	ОтПланировщика = 0;
	Для Каждого Запись Из Разбор.ЗаписиЖурнала(Коллектор.Принятое("logs")) Цикл
		Если Запись.Служба <> СлужбаВторого() Тогда
			Продолжить;
		ИначеЕсли Запись.Лог = Настройки() Тогда
			ОтНастроек = ОтНастроек + 1;
		ИначеЕсли Запись.Лог = Планировщик() Тогда
			ОтПланировщика = ОтПланировщика + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Второй.Дамп(), ФрагментАкцента()) > 0, "служба настроек пишет").ЭтоИстина();
	Ожидаем.Что(ОтНастроек, "а в коллектор — нет: отправка выключена закреплением").Равно(0);
	Ожидаем.Что(ОтПланировщика > 0, "планировщик, включённый поверх DISABLE, отправляет").ЭтоИстина();

	Страница = КлиентВторого.Тело(КлиентВторого.GETСКукой(Дерево() + "?q=" + КодироватьСтроку(Настройки(),
		СпособКодированияСтроки.КодировкаURL), Кука));
	Поля = Браузер.Поля(Страница, "операция"" value=""дерево");
	Ожидаем.Что(Браузер.Значение(Поля, "было-otel|" + Настройки()), "тумблер не заперт и выключен: выход на месте")
		.Равно("0");

КонецПроцедуры

Процедура ДождатьсяВКонсоли(Экземпляр, Знач Фрагмент)
	Для Попытка_ = 1 По 30 Цикл
		Если СтрНайти(Экземпляр.Дамп(), Фрагмент) > 0 Тогда
			Возврат;
		КонецЕсли;
		ПодождатьСекунд(1);
	КонецЦикла;
	ВызватьИсключение "В консоли хаба за 30 с не появилось: " + Фрагмент;
КонецПроцедуры

// Строки «Закрепить» со страницы дерева — код вида «OSHUB_LOG_…=значение»: имя переменной → значение.
Функция СтрокиЗакрепления(Знач Страница)
	Итог = Новый Соответствие();
	Позиция = 1;
	Пока Истина Цикл
		Начало = СтрНайти(Страница, "<code", , Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Хвост = Сред(Страница, СтрНайти(Страница, ">", , Начало) + 1);
		Код = Лев(Хвост, СтрНайти(Хвост, "</code>") - 1);
		Для Каждого Строка_ Из СтрРазделить(СтрЗаменить(Код, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
			Строка_ = СокрЛП(Строка_);
			Знак = СтрНайти(Строка_, "=");
			Если СтрНачинаетсяС(Строка_, "OSHUB_LOG_") И Знак > 0 Тогда
				Итог.Вставить(Лев(Строка_, Знак - 1), СтрЗаменить(Сред(Строка_, Знак + 1), "&amp;", "&"));
			КонецЕсли;
		КонецЦикла;
		Позиция = Начало + 1;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция СлужбаВторого()
	Возврат "openhub-пульт-журнала-закреплённый";
КонецФункции

#КонецОбласти

#Область Форма

Процедура ЗадатьУровень(Знач ИмяЛога, Знач Уровень)
	Тронут(ИмяЛога);
	Отправить(ИмяЛога, "уровень|" + ИмяЛога, Уровень);
КонецПроцедуры

Процедура ВернутьКСтарту(Знач ИмяЛога)
	Отправить(ИмяЛога, "уровень|" + ИмяЛога, "start");
КонецПроцедуры

Процедура ЗадатьУровеньКорня(Знач Уровень)
	КореньТронут = Истина;
	Отправить("", "уровень-корня", Уровень);
КонецПроцедуры

Процедура ВыключитьОтправку(Знач ИмяЛога)
	Тронут(ИмяЛога);
	Поля = Браузер.Поля(СтраницаДерева(ИмяЛога), "операция"" value=""дерево");
	ОтправитьПоля(Браузер.БезФлажка(Поля, "otel|" + ИмяЛога));
КонецПроцедуры

// Отмеченный флажок браузер шлёт на его месте в форме — перед парным скрытым «0» тумблера.
Процедура ВключитьОтправку(Знач ИмяЛога)
	Тронут(ИмяЛога);
	Поля = Браузер.Поля(СтраницаДерева(ИмяЛога), "операция"" value=""дерево");
	Ожидаем.Что(Браузер.Значение(Поля, "otel|" + ИмяЛога), "тумблер не заперт и выключен").Равно("0");
	Отмеченные = Новый Массив();
	Отмечен = Ложь;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = "otel|" + ИмяЛога И НЕ Отмечен Тогда
			Отмеченные.Добавить(Новый Структура("Имя, Значение", Поле.Имя, "1"));
			Отмечен = Истина;
		КонецЕсли;
		Отмеченные.Добавить(Поле);
	КонецЦикла;
	ОтправитьПоля(Отмеченные);
КонецПроцедуры

// Страница дерева с найденным логом: ветки под поиском раскрыты, поле лога напечатано.
Процедура Отправить(Знач ИмяЛога, Знач Поле, Знач Значение)
	Поля = Браузер.Поля(СтраницаДерева(ИмяЛога), "операция"" value=""дерево");
	ОтправитьПоля(Браузер.СЗаменой(Поля, Поле, Значение));
КонецПроцедуры

Процедура ОтправитьПоля(Знач Поля)
	Ответ = Клиент.POSTФормыБезПереходов(Дерево(), Браузер.Тело(Поля), Клиент.СтрокаКукиСессии(КукаRoot));
	Ожидаем.Что(Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400,
		"правка формой — перенаправление, а не " + Ответ.КодСостояния).ЭтоИстина();
КонецПроцедуры

Процедура Тронут(Знач ИмяЛога)
	Если Тронутые.Найти(ИмяЛога) = Неопределено Тогда
		Тронутые.Добавить(ИмяЛога);
	КонецЕсли;
КонецПроцедуры

// Половина «Строки» названных логов: кнопка возврата к старту — у тех, что заданы с экрана.
Функция СтраницаСтрок(Знач Имена)
	Ответ = Клиент.GETСКукой(Дерево() + "/lines?log=" + КодироватьСтроку(СтрСоединить(Имена, ","),
		СпособКодированияСтроки.КодировкаURL), КукаRoot);
	Ожидаем.Что(Ответ.КодСостояния, "половина «Строки» открывается").Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

Функция СтраницаДерева(Знач Поиск)
	Адрес = Дерево() + ?(ЗначениеЗаполнено(Поиск), "?q=" + КодироватьСтроку(Поиск, СпособКодированияСтроки.КодировкаURL), "");
	Ответ = Клиент.GETСКукой(Адрес, КукаRoot);
	Ожидаем.Что(Ответ.КодСостояния, "дерево открывается").Равно(200);
	Возврат Клиент.Тело(Ответ);
КонецФункции

#КонецОбласти

#Область Наблюдение

// Неудачный вход с меткой пишет отладку входа; когда метка доехала до коллектора, туда доехало
// и всё, что хаб написал раньше неё.
Функция Отметить()
	Метка = "метка-" + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	Клиент.ЗапросJSON("POST", "/api/v1/login", СтрШаблон("{""логин"":""%1"",""пароль"":""x""}", Метка));
	Коллектор.ДождатьсяПартии("logs", Метка);
	Возврат Метка;
КонецФункции

Функция ЗаписиСлужбы()
	Результат = Новый Массив();
	Для Каждого Запись Из Разбор.ЗаписиЖурнала(Коллектор.Принятое("logs")) Цикл
		Если Запись.Служба = Служба() Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗаписейКоллектора(Знач ИмяЛога, Знач Фрагмент)
	Сколько = 0;
	Для Каждого Запись Из ЗаписиСлужбы() Цикл
		Если Запись.Лог = ИмяЛога И СтрНайти(Запись.Текст, Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;
КонецФункции

Функция СтрокКонсоли(Знач Фрагмент)
	Сколько = 0;
	Для Каждого Строка_ Из СтрРазделить(Хаб.Дамп(), Символы.ПС, Ложь) Цикл
		Если СтрНайти(Строка_, Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;
КонецФункции

Функция СтрокЛенты(Знач ИмяЛога, Знач Уровень, Знач Фрагмент)
	Возврат СтрЧислоВхождений(Клиент.Тело(Клиент.GETСКукой(Лента(ИмяЛога, Уровень), КукаRoot)), Фрагмент);
КонецФункции

// Текст строки ленты с фрагментом — как его напечатала лента, без разметки.
Функция ТекстСтрокиЛенты(Знач Страница, Знач Фрагмент)
	Метка = "data-feed-text";
	Позиция = 1;
	Пока Истина Цикл
		Начало = СтрНайти(Страница, Метка, , Позиция);
		Если Начало = 0 Тогда
			Возврат "";
		КонецЕсли;
		Тело = Сред(Страница, СтрНайти(Страница, ">", , Начало) + 1);
		Текст = Лев(Тело, СтрНайти(Тело, "<") - 1);
		Если СтрНайти(Текст, Фрагмент) > 0 Тогда
			Возврат СтрЗаменить(СтрЗаменить(Текст, "&quot;", """"), "&amp;", "&");
		КонецЕсли;
		Позиция = Начало + 1;
	КонецЦикла;
КонецФункции

// Последняя запись пульта в файле журнала аудита: одна операция — одна строка JSON.
// Записи правок пульта в файле аудита, чьи логи называют этот лог.
Функция ПравокПультаОЛоге(Знач ИмяЛога)
	Итог = 0;
	Для Каждого Запись Из ПравкиПультаВАудите() Цикл
		Логи = Запись["детали"]["логи"];
		Если ТипЗнч(Логи) = Тип("Массив") И Логи.Найти(ИмяЛога) <> Неопределено Тогда
			Итог = Итог + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция ПравкиПультаВАудите()
	Итог = Новый Массив();
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Хаб.КореньХранилища(), "аудит.log"), КодировкаТекста.UTF8);
	Для Номер = 1 По Текст.КоличествоСтрок() Цикл
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Текст.ПолучитьСтроку(Номер));
		Запись = ПрочитатьJSON(Чтение, Истина);
		Если СтрНачинаетсяС(Запись["действие"], "логи.") Тогда
			Итог.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция ПоследняяПравкаВАудите()
	Правки = ПравкиПультаВАудите();
	Если Правки.Количество() = 0 Тогда
		ВызватьИсключение "В журнале аудита нет ни одной правки пульта";
	КонецЕсли;
	Возврат Правки[Правки.ВГраница()];
КонецФункции

Процедура ПодождатьСекунд(Знач Секунд)
	Приостановить(Секунд * 1000);
КонецПроцедуры

#КонецОбласти

#Область Обвязка

// Класс хаба пишет в лог своего имени без точек; у библиотек и у логов хаба мимо классов имя с точкой.
Функция ЭтоКлассХаба(Знач ИмяЛога)
	Возврат ЗначениеЗаполнено(ИмяЛога) И СтрНайти(ИмяЛога, ".") = 0 И ИмяЛога <> "аудит";
КонецФункции

Функция Служба()
	Возврат "openhub-пульт-журнала";
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

Функция Контроллер()
	Возврат "КонтроллерНастроекХабаAPI";
КонецФункции

Функция Настройки()
	Возврат "СервисНастроек";
КонецФункции

Функция Планировщик()
	Возврат "ЖурналФоновыхЗадач";
КонецФункции

Функция Вход()
	Возврат "СервисАутентификации";
КонецФункции

Функция Издатель()
	Возврат "ИздательСобытий";
КонецФункции

Функция АдресВАкценте()
	Возврат "admin@example.org";
КонецФункции

// Предупреждение службы настроек о непригодном акценте.
Функция ФрагментАкцента()
	Возврат "setting oshub.ui.accent";
КонецФункции

// severityNumber OTel для DEBUG — от 5 до 8.
Функция УровеньDEBUG()
	Возврат 8;
КонецФункции

Функция Дерево()
	Возврат "/hub/settings/logs";
КонецФункции

Функция Лента(Знач ИмяЛога, Знач Уровень)
	Возврат "/hub/settings/logs/lines?log=" + КодироватьСтроку(ИмяЛога, СпособКодированияСтроки.КодировкаURL)
		+ "&level=" + Уровень;
КонецФункции

#КонецОбласти
