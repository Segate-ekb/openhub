// Сторож правила, которое стреляет молча: перехватчик &МетодЗапроса стоит на декораторе
// СНАРУЖИ объекта, поэтому деривованный метод, вызванный ИЗНУТРИ своего же класса,
// возвращает Неопределено вместо выборки. Пустая выдача вместо строк — это пустой список
// пакетов на экране, а не исключение, и найти её потом не по чему.
//
// Правило одно: класс, несущий &ХранилищеСущностей, не зовёт собственные &МетодЗапроса —
// ни голым именем, ни через ЭтотОбъект: перехватчика нет ни на той, ни на другой ссылке.
// Доменный метод рядом с заготовками запросов жить может — он обязан ходить к репозиторию
// entity через поле &Родитель, а не к соседу по классу.

#Использовать asserts
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогКлассовДанных;

// Репозиториев в модуле десятки; меньше двадцати означает ослепший обход, а не
// похудевшую модель.
Перем МинимумРепозиториев;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовДанных = ОбъединитьПути(КаталогПроекта, "src", "модули",
		ОбъединитьПути("данные", "Классы"));
	МинимумРепозиториев = 20;

КонецПроцедуры

#Область СканПродуктовогоКода

&Тест
Процедура РепозиторийНеЗовётСобственныеДеривованныеМетоды() Экспорт

	Нарушители = Новый Массив();
	Репозиториев = 0;

	Для Каждого Файл Из ФайлыКлассовДанных() Цикл
		Код = ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходники.Текст(Файл));
		Если НЕ ЭтоРепозиторий(Код) Тогда
			Продолжить;
		КонецЕсли;
		Репозиториев = Репозиториев + 1;
		Свои = ДеривованныеМетоды(Код);
		Для Каждого Имя Из СамовызовыДеривованных(Код, Свои) Цикл
			Нарушители.Добавить(Исходники.ОтносительныйПуть(Файл) + ": " + Имя);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Репозиториев >= МинимумРепозиториев,
		"скан ослеп: классов с &ХранилищеСущностей найдено " + Репозиториев
		+ ", а их в src/модули/данные/Классы/ десятки").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"деривованный метод, вызванный изнутри своего же класса, вернёт Неопределено:"
		+ " ходите к репозиторию entity полем &Родитель").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СамотестыДетекторов

&Тест
Процедура ДетекторРепозиторияТребуетТочногоИмениАннотации() Экспорт

	Ожидаем.Что(ЭтоРепозиторий("&ХранилищеСущностей(""Тег"")"),
		"аннотация репозитория").ЭтоИстина();
	Ожидаем.Что(ЭтоРепозиторий("Перем ХранилищеСущностейВебСессия;"),
		"поле с более длинным именем — не аннотация").ЭтоЛожь();
	Ожидаем.Что(ЭтоРепозиторий("&ХранилищеСущностейЧужое(""Тег"")"),
		"аннотация с похожим началом — не она").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторСобираетТолькоДеривованныеМетоды() Экспорт

	Найденные = ДеривованныеМетоды(ОбразецРепозитория());

	Ожидаем.Что(Найденные.Количество(), "деривованных методов в образце").Равно(1);
	Ожидаем.Что(Найденные[0], "имя деривованного метода").Равно("ПолучитьПоПулИдентификаторРавно");

КонецПроцедуры

// Приманка на обе стороны ошибки: самовызов обязан находиться, а вызов у поля &Родитель
// и объявление самого метода — нет.
&Тест
Процедура ДетекторСамовызоваОтличаетСоседаОтРодителя() Экспорт

	Свои = ДеривованныеМетоды(ОбразецРепозитория());

	Ожидаем.Что(СтрСоединить(СамовызовыДеривованных(ОбразецРепозитория(), Свои), ","),
		"чистый образец нарушений не содержит").Равно("");

	Плохой = ОбразецРепозитория() + Символы.ПС
		+ "Функция Обход() Экспорт" + Символы.ПС
		+ "	Возврат ПолучитьПоПулИдентификаторРавно(1);" + Символы.ПС
		+ "КонецФункции";
	Ожидаем.Что(СтрСоединить(СамовызовыДеривованных(Плохой, Свои), ","),
		"самовызов деривованного метода обязан находиться")
		.Равно("ПолучитьПоПулИдентификаторРавно");

	ЧерезЭтотОбъект = ОбразецРепозитория() + Символы.ПС
		+ "Функция Обход() Экспорт" + Символы.ПС
		+ "	Возврат ЭтотОбъект.ПолучитьПоПулИдентификаторРавно(1);" + Символы.ПС
		+ "КонецФункции";
	Ожидаем.Что(СтрСоединить(СамовызовыДеривованных(ЧерезЭтотОбъект, Свои), ","),
		"ЭтотОбъект — та же ссылка на себя: перехватчика на ней тоже нет")
		.Равно("ПолучитьПоПулИдентификаторРавно");

	ЧерезРодителя = ОбразецРепозитория() + Символы.ПС
		+ "Функция Обход() Экспорт" + Символы.ПС
		+ "	Возврат ХранилищеСущностей.ПолучитьПоПулИдентификаторРавно(1);" + Символы.ПС
		+ "КонецФункции";
	Ожидаем.Что(СтрСоединить(СамовызовыДеривованных(ЧерезРодителя, Свои), ","),
		"вызов у поля &Родитель нарушением не является").Равно("");

	ДругимРегистром = ОбразецРепозитория() + Символы.ПС
		+ "Функция Обход() Экспорт" + Символы.ПС
		+ "	Возврат получитьПоПулИдентификаторРавно(1);" + Символы.ПС
		+ "КонецФункции";
	Ожидаем.Что(СтрСоединить(СамовызовыДеривованных(ДругимРегистром, Свои), ","),
		"OneScript регистронезависим: строчная первая буква — тот же самовызов")
		.Равно("ПолучитьПоПулИдентификаторРавно");

	Однофамилец = ОбразецРепозитория() + Символы.ПС
		+ "Функция Обход() Экспорт" + Символы.ПС
		+ "	Возврат СвойПолучитьПоПулИдентификаторРавно(1);" + Символы.ПС
		+ "КонецФункции";
	Ожидаем.Что(СтрСоединить(СамовызовыДеривованных(Однофамилец, Свои), ","),
		"хвост более длинного имени — не вызов деривованного метода").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторНеЧитаетЛитералКакКод() Экспорт

	Свои = ДеривованныеМетоды(ОбразецРепозитория());

	СЛитералом = ОбразецРепозитория() + Символы.ПС
		+ "Функция Подсказка() Экспорт" + Символы.ПС
		+ "	Возврат ""ПолучитьПоПулИдентификаторРавно(1)"";" + Символы.ПС
		+ "КонецФункции";
	Очищенный = ИсходникБезКомментариев.БезКомментариевИЛитералов(СЛитералом);

	Ожидаем.Что(СтрСоединить(СамовызовыДеривованных(Очищенный, Свои), ","),
		"имя метода внутри строкового литерала — не вызов").Равно("");

КонецПроцедуры

&Тест
Процедура КорпусСканаНеПуст() Экспорт

	Ожидаем.Что(ФайлыКлассовДанных().Количество() > 50,
		"корпус src/модули/данные/Классы подозрительно мал — проверьте путь").ЭтоИстина();

	Ожидаем.Что(ЕстьВКорпусе("src/модули/данные/Классы/пакеты/ХранилищеТегов.os"),
		"репозиторий тегов обязан быть в корпусе скана").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Детекторы

Функция ЭтоРепозиторий(Знач Код)
	Возврат ЕстьАннотация(Код, "ХранилищеСущностей");
КонецФункции

Функция ЕстьАннотация(Знач Код, Знач ИмяАннотации)

	Образец = "&" + ИмяАннотации;
	Позиция = 1;

	Пока Истина Цикл
		Найдено = СтрНайти(Код, Образец, , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Следующий = Сред(Код, Найдено + СтрДлина(Образец), 1);
		Если Следующий = "" ИЛИ ЭтоГраницаИдентификатора(Следующий) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

// Имена методов, помеченных &МетодЗапроса: аннотация стоит строкой выше объявления.
Функция ДеривованныеМетоды(Знач Код)

	Имена = Новый Массив();
	Помечен = Ложь;

	Для Каждого Строка_ Из СтрРазделить(Код, Символы.ПС) Цикл
		Голая = СокрЛП(Строка_);
		Если Голая = "&МетодЗапроса" Тогда
			Помечен = Истина;
			Продолжить;
		КонецЕсли;
		Если Помечен И ЗначениеЗаполнено(Голая) Тогда
			Имя = ИмяОбъявленногоМетода(Голая);
			Если ЗначениеЗаполнено(Имя) Тогда
				Имена.Добавить(Имя);
			КонецЕсли;
			Помечен = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

Функция ИмяОбъявленногоМетода(Знач Голая)

	Для Каждого Ключевое Из СтрРазделить("ФУНКЦИЯ ,ПРОЦЕДУРА ", ",") Цикл
		Если СтрНачинаетсяС(ВРег(Голая), Ключевое) Тогда
			Хвост = Сред(Голая, СтрДлина(Ключевое) + 1);
			Скобка = СтрНайти(Хвост, "(");
			Возврат ?(Скобка = 0, "", СокрЛП(Лев(Хвост, Скобка - 1)));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Самовызов — обращение к своему же деривованному методу: и голым именем, и через
// ЭтотОбъект. Обе формы бьют мимо перехватчика, который стоит на декораторе СНАРУЖИ.
// Вызов у поля &Родитель («ХранилищеСущностей.…») самовызовом не является: это
// репозиторий entity, а не сосед по классу.
Функция СамовызовыДеривованных(Знач Код, Знач Деривованные)

	Найденные = Новый Массив();

	Для Каждого Строка_ Из СтрРазделить(Код, Символы.ПС) Цикл
		// OneScript регистронезависим: «получитьПо…» — тот же метод, что «ПолучитьПо…».
		// Сравнение идёт в верхнем регистре; длина строки от него не меняется,
		// поэтому позиции символов остаются теми же.
		Голая = ВРег(СокрЛП(Строка_));
		Если ЭтоОбъявление(Голая) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Имя Из Деривованные Цикл
			Если ЕстьСамовызов(Голая, ВРег(Имя)) И Найденные.Найти(Имя) = Неопределено Тогда
				Найденные.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Строка приходит сюда уже в верхнем регистре.
Функция ЭтоОбъявление(Знач Голая)
	Возврат СтрНачинаетсяС(Голая, "ФУНКЦИЯ ") ИЛИ СтрНачинаетсяС(Голая, "ПРОЦЕДУРА ");
КонецФункции

Функция ЕстьСамовызов(Знач Строка_, Знач Имя)

	Позиция = 1;

	Пока Истина Цикл
		Найдено = СтрНайти(Строка_, Имя + "(", , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЭтоСвоёОбращение(Строка_, Найдено) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

// Голое имя — свой вызов; «ЭтотОбъект.Имя» — тот же свой вызов другой записью;
// «Получатель.Имя» — чужой; хвост более длинного идентификатора — вообще не вызов.
Функция ЭтоСвоёОбращение(Знач Строка_, Знач НачалоИмени)

	Если НачалоИмени = 1 Тогда
		Возврат Истина;
	КонецЕсли;

	Перед = Сред(Строка_, НачалоИмени - 1, 1);

	Если НЕ ЭтоГраницаИдентификатора(Перед) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Перед <> "." Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НРег(ПолучательПередТочкой(Строка_, НачалоИмени - 1)) = "этотобъект";

КонецФункции

// Идентификатор, стоящий вплотную слева от точки.
Функция ПолучательПередТочкой(Знач Строка_, Знач ПозицияТочки)

	Итог = "";
	Позиция = ПозицияТочки - 1;

	Пока Позиция >= 1 И НЕ ЭтоГраницаИдентификатора(Сред(Строка_, Позиция, 1)) Цикл
		Итог = Сред(Строка_, Позиция, 1) + Итог;
		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция ЭтоГраницаИдентификатора(Знач Символ)

	Возврат СтрНайти("QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm"
		+ "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю"
		+ "0123456789_", Символ) = 0;

КонецФункции

#КонецОбласти

#Область Корпус

Функция ОбразецРепозитория()

	Возврат "&Родитель" + Символы.ПС
		+ "Перем ХранилищеСущностей;" + Символы.ПС + Символы.ПС
		+ "&МетодЗапроса" + Символы.ПС
		+ "Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт" + Символы.ПС
		+ "	Возврат Неопределено;" + Символы.ПС
		+ "КонецФункции" + Символы.ПС + Символы.ПС
		+ "&ХранилищеСущностей(""АпстримПула"")" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта()" + Символы.ПС
		+ "КонецПроцедуры";

КонецФункции

Функция ФайлыКлассовДанных()

	Файлы = Новый Массив();

	Если НЕ Новый Файл(КаталогКлассовДанных).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Каталога классов %1 нет: путь переехал либо модуль переименован."
			+ " Пустой корпус — это не «нечего проверять», а ослепший скан.",
			КаталогКлассовДанных);
	КонецЕсли;

	Для Каждого Найденный Из НайтиФайлы(КаталогКлассовДанных, "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

Функция ЕстьВКорпусе(Знач ОжидаемыйПуть)

	Для Каждого Файл Из ФайлыКлассовДанных() Цикл
		Если Исходники.ОтносительныйПуть(Файл) = ОжидаемыйПуть Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
