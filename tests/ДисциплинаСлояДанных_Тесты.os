// Скан-тест дисциплины слоя данных: &ХранилищеСущностей — только в классах Запросы*,
// &Родитель — не в фасадах Хранилище*. Правило рабочее, а не стилевое: перехватчик
// &МетодЗапроса стоит на декораторе снаружи, поэтому вызов такого метода изнутри его же
// класса возвращает Неопределено — доменные методы обязаны жить отдельно от заготовок
// запросов. Детекторы закрыты самотестами.

#Использовать asserts
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогПроекта;

// Фасадов в модуле по одному на сущность, сущностей — десятки; меньше двадцати
// означает ослепший обход, а не похудевшую модель.
Перем МинимумФасадов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	МинимумФасадов = 20;

КонецПроцедуры

#Область СканыПродуктовогоКода

&Тест
Процедура АннотацияХранилищаСущностейТолькоВКлассахЗапросов() Экспорт

	Нарушители = Новый Массив();
	Носителей = 0;

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Если НЕ ЕстьАннотацияХранилищаСущностей(ЧистыйТекст(Исходники.Текст(Файл))) Тогда
			Продолжить;
		КонецЕсли;
		Носителей = Носителей + 1;
		Путь = Исходники.ОтносительныйПуть(Файл);
		Если НЕ ЭтоКлассЗапросов(Путь) Тогда
			Нарушители.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Носителей > 20,
		"скан ослеп: классов с &ХранилищеСущностей найдено " + Носителей
		+ ", а их в src/модули/данные/Классы/ десятки").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"классы с &ХранилищеСущностей вне src/модули/данные/Классы/**/Запросы*.os:"
		+ " репозиторий entity живёт только в классе Запросы*, наружу его отдаёт фасад").Равно("");

КонецПроцедуры

&Тест
Процедура ФасадыХранилищНеНаследуютРепозиторийEntity() Экспорт

	Нарушители = Новый Массив();
	Фасадов = 0;

	Для Каждого Файл Из ФайлыФасадовХранилищ() Цикл
		Фасадов = Фасадов + 1;
		Если ЕстьАннотацияРодителя(ЧистыйТекст(Исходники.Текст(Файл))) Тогда
			Нарушители.Добавить(Исходники.ОтносительныйПуть(Файл));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Фасадов > 20,
		"скан ослеп: файлов Хранилище*.os найдено " + Фасадов
		+ ", проверьте путь src/модули/данные/Классы/").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"фасады Хранилище*.os с &Родитель: наследник ХранилищеСущностей отдаёт наружу"
		+ " Получить(ОпцииПоиска) и остальное API entity — наследование живёт в классе Запросы*")
		.Равно("");

КонецПроцедуры

#КонецОбласти

#Область СамотестыДетекторов

&Тест
Процедура ДетекторАннотацийТребуетТочногоИмени() Экспорт

	Ожидаем.Что(ЕстьАннотацияХранилищаСущностей("&ХранилищеСущностей(""Тег"")"),
		"аннотация репозитория").ЭтоИстина();
	Ожидаем.Что(ЕстьАннотацияХранилищаСущностей("Перем ХранилищеСущностейВебСессия;"),
		"поле с более длинным именем — не аннотация").ЭтоЛожь();
	Ожидаем.Что(ЕстьАннотацияХранилищаСущностей("// класс без &ХранилищеСущностей"),
		"упоминание в комментарии — не аннотация").ЭтоЛожь();

	Ожидаем.Что(ЕстьАннотацияРодителя("&Родитель" + Символы.ПС + "Перем ХранилищеСущностей;"),
		"аннотация наследования").ЭтоИстина();
	Ожидаем.Что(ЕстьАннотацияРодителя("&РодительскийПул" + Символы.ПС + "Перем Пул;"),
		"аннотация с похожим именем не считается за &Родитель").ЭтоЛожь();
	Ожидаем.Что(ЕстьАннотацияРодителя("// было &Родитель, стало внедрение"),
		"упоминание в комментарии — не аннотация").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторПутиОтличаетЗапросыОтХранилищ() Экспорт

	Ожидаем.Что(ЭтоКлассЗапросов("src/модули/данные/Классы/пакеты/ЗапросыПакетов.os"),
		"класс запросов в доменном подкаталоге").ЭтоИстина();
	Ожидаем.Что(ЭтоКлассЗапросов("src/модули/данные/Классы/пакеты/ХранилищеПакетов.os"),
		"фасад — не класс запросов").ЭтоЛожь();
	Ожидаем.Что(ЭтоКлассЗапросов("src/модули/реестр/Классы/ЗапросыЧегоТо.os"),
		"класс запросов вне данные/Классы — не считается").ЭтоЛожь();
	Ожидаем.Что(ЭтоКлассЗапросов("src/модули/данные/КлассыПрочие/ЗапросыПакетов.os"),
		"похожий по началу каталог вне данные/Классы — не считается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КорпусаСкановНеПусты() Экспорт

	Ожидаем.Что(ФайлыИсходников().Количество() > 100,
		"корпус исходников src/ подозрительно мал — проверьте пути").ЭтоИстина();

	Ожидаем.Что(ЕстьВКорпусе(ФайлыИсходников(), "src/модули/данные/Классы/пакеты/ЗапросыПакетов.os"),
		"класс запросов обязан быть в корпусе скана").ЭтоИстина();
	Ожидаем.Что(ЕстьВКорпусе(ФайлыФасадовХранилищ(), "src/модули/данные/Классы/пакеты/ХранилищеПакетов.os"),
		"фасад хранилища обязан быть в корпусе фасадов").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Детекторы

Функция ЕстьАннотацияХранилищаСущностей(Знач Текст)
	Возврат ЕстьАннотацияВТексте(ЧистыйТекст(Текст), "ХранилищеСущностей");
КонецФункции

Функция ЕстьАннотацияРодителя(Знач Текст)
	Возврат ЕстьАннотацияВТексте(ЧистыйТекст(Текст), "Родитель");
КонецФункции

Функция ЕстьАннотацияВТексте(Знач Текст, Знач ИмяАннотации)

	Образец = "&" + ИмяАннотации;
	Позиция = 1;

	Пока Истина Цикл
		Найдено = СтрНайти(Текст, Образец, , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Следующий = Сред(Текст, Найдено + СтрДлина(Образец), 1);
		Если Следующий = "" ИЛИ ЭтоГраницаИдентификатора(Следующий, 1) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

Функция ЭтоГраницаИдентификатора(Знач Текст, Знач Позиция)

	Если Позиция < 1 Тогда
		Возврат Истина;
	КонецЕсли;

	Символ = Сред(Текст, Позиция, 1);
	Возврат СтрНайти("QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm"
		+ "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю"
		+ "0123456789_", Символ) = 0;

КонецФункции

// Классы модуля данные разложены по доменным подкаталогам — считаем по имени файла,
// а не по глубине пути.
Функция ЭтоКлассЗапросов(Знач Путь)

	Префикс = "src/модули/данные/Классы/";
	Если НЕ СтрНачинаетсяС(Путь, Префикс) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНачинаетсяС(ИмяФайла(Путь), "Запросы");

КонецФункции

Функция ИмяФайла(Знач Путь)

	Части = СтрРазделить(Путь, "/", Ложь);

	Возврат ?(Части.Количество() = 0, "", Части[Части.Количество() - 1]);

КонецФункции

#КонецОбласти

#Область Корпус

Функция ФайлыИсходников()

	Файлы = Новый Массив();
	СобратьФайлы(ОбъединитьПути(КаталогПроекта, "src"), Файлы);

	Если Файлы.Количество() < 100 Тогда
		ВызватьИсключение СтрШаблон(
			"Корпус скана слоя данных подозрительно мал (%1 файлов) — проверьте пути",
			Файлы.Количество());
	КонецЕсли;

	Возврат Файлы;

КонецФункции

// Обход рекурсивный: фасады разложены по доменным подкаталогам данные/Классы, и плоский
// поиск нашёл бы ноль файлов — скан позеленел бы на пустом множестве.
Функция ФайлыФасадовХранилищ()

	Каталог = ОбъединитьПути(КаталогПроекта, "src", "модули", ОбъединитьПути("данные", "Классы"));
	Файлы = Новый Массив();

	Для Каждого Найденный Из НайтиФайлы(Каталог, "Хранилище*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Файлы.Количество() < МинимумФасадов Тогда
		ВызватьИсключение СтрШаблон(
			"Фасадов Хранилище*.os найдено %1 при минимуме %2 — проверьте путь"
			+ " src/модули/данные/Классы/ и рекурсию обхода", Файлы.Количество(), МинимумФасадов);
	КонецЕсли;

	Возврат Файлы;

КонецФункции

Процедура СобратьФайлы(Знач Каталог, Файлы)

	Если НЕ Новый Файл(Каталог).Существует() Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьВКорпусе(Знач Файлы, Знач ОжидаемыйПуть)

	Для Каждого Файл Из Файлы Цикл
		Если Исходники.ОтносительныйПуть(Файл) = ОжидаемыйПуть Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЧистыйТекст(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС) Цикл
		Результат.Добавить(ОчиститьСтроку(Строка));
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

Функция ОчиститьСтроку(Знач Строка)

	Итог = "";
	ВЛитерале = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Строка);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Строка, Позиция, 1);

		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если НЕ ВЛитерале И Символ = "/" И Сред(Строка, Позиция + 1, 1) = "/" Тогда
			Прервать;
		КонецЕсли;

		Если НЕ ВЛитерале Тогда
			Итог = Итог + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Если СтрНачинаетсяС(СокрЛП(Итог), "|") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Итог;

КонецФункции

#КонецОбласти
