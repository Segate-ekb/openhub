// Отборы деривованных запросов группы пулов: пулы, участники пулов, апстримы, зеркала хабов,
// вебхуки. В каждой таблице лежат строки, которые отбор ОБЯЗАН отсеять, — иначе
// пропущенный вид сравнения или коллизия имён колонок остались бы незамеченными.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity

Перем Поделка;   // общий контейнер на все тесты набора

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), ОбъединитьПути("данные", "Классы"));

	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассовDb, "*.os", Истина) Цикл
		// без глушения ошибок: синтаксически сломанный класс должен уронить набор
		Если НЕ ТипЗарегистрирован(ФайлКласса.ИмяБезРасширения) Тогда
			ПодключитьСценарий(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;

	Детальки = Новый Соответствие();

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "запросы-группы-пулов");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

// Фасады остаются желудями под прежними именами: прикладной код и сервисы их не искали заново.
&Тест
Процедура ФасадыГруппыПуловОстаютсяЖелудями() Экспорт

	Имена = СтрРазделить(
		"ХранилищеПулов,ХранилищеУчастниковПула,ХранилищеАпстримовПула,"
		+ "ХранилищеЗеркалХабов,ХранилищеВебхуков,"
		+ "ЗапросыПулов,ЗапросыУчастниковПула,ЗапросыАпстримовПула,"
		+ "ЗапросыЗеркалХабов,ЗапросыВебхуков", ",");

	Для Каждого Имя Из Имена Цикл
		// ОСень глушит ошибку сборки желудя и отдаёт Неопределено — проверка именно на это
		Ожидаем.Что(Желудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПулыОтбираютсяПоИмениТипуИИдентификатору() Экспорт

	Хранилище = Желудь("ХранилищеПулов");

	Альфа = ДобавитьПул(Хранилище, "альфа", "custom");
	ДобавитьПул(Хранилище, "бета", "user");
	ДобавитьПул(Хранилище, "гамма", "custom");

	Ожидаем.Что(Хранилище.Все().Количество(), "выборка без отбора отдаёт все пулы").Равно(3);

	Ожидаем.Что(Хранилище.ПолучитьПоТипРавно("custom").Количество(), "пулы типа custom").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоТипРавно("user").Количество(), "пулы типа user").Равно(1);
	Ожидаем.Что(Хранилище.ПолучитьПоТипРавно("default").Количество(), "пулов типа default нет").Равно(0);

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИмяРавно("бета").Тип, "пул по имени").Равно("user");
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИмяРавно("нет-такого"), "имени в таблице нет").Равно(Неопределено);

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Альфа.Идентификатор).Имя,
		"пул по идентификатору").Равно("альфа");
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(999999), "идентификатора в таблице нет")
		.Равно(Неопределено);

КонецПроцедуры

// Три отбора в одном имени: рядом лежат строки, отличающиеся ровно одним из трёх полей.
&Тест
Процедура РолиУчастниковОтбираютсяПоТрёмПолям() Экспорт

	Хранилище = Желудь("ХранилищеУчастниковПула");

	ДобавитьУчастника(Хранилище, 1, "пользователь", 10, "owner");
	ДобавитьУчастника(Хранилище, 1, "пользователь", 11, "reader");
	ДобавитьУчастника(Хранилище, 1, "группа", 10, "publisher");
	ДобавитьУчастника(Хранилище, 2, "пользователь", 10, "reader");

	Ожидаем.Что(Хранилище.НайтиРоль(1, "пользователь", 10).Роль, "роль субъекта на своём пуле").Равно("owner");
	Ожидаем.Что(Хранилище.НайтиРоль(1, "группа", 10).Роль, "тот же идентификатор, другой тип субъекта")
		.Равно("publisher");
	Ожидаем.Что(Хранилище.НайтиРоль(2, "пользователь", 10).Роль, "тот же субъект, другой пул").Равно("reader");
	Ожидаем.Что(Хранилище.НайтиРоль(1, "пользователь", 12), "такого субъекта на пуле нет").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиРоль(2, "группа", 10), "такой группы на пуле нет").Равно(Неопределено);

	Ожидаем.Что(Хранилище.РолиСубъекта("пользователь", 10).Количество(), "роли пользователя 10 на всех пулах")
		.Равно(2);
	Ожидаем.Что(Хранилище.РолиСубъекта("группа", 10).Количество(), "роли группы 10").Равно(1);
	Ожидаем.Что(Хранилище.РолиСубъекта("пользователь", 99).Количество(), "субъекта без прав").Равно(0);

	Ожидаем.Что(Хранилище.ПолучитьПоПулИдентификаторРавно(1).Количество(), "все права на пуле 1").Равно(3);
	Ожидаем.Что(Хранилище.ПолучитьПоПулИдентификаторРавно(2).Количество(), "все права на пуле 2").Равно(1);

	Участник = Хранилище.НайтиРоль(2, "пользователь", 10);
	Хранилище.Удалить(Участник);
	Ожидаем.Что(Хранилище.ПолучитьПоПулИдентификаторРавно(2).Количество(), "после удаления записи").Равно(0);

КонецПроцедуры

// Отбор плюс сортировка: строки заведены в порядке, обратном ожидаемому обходу.
&Тест
Процедура АпстримыПулаОтбираютсяИУпорядочиваются() Экспорт

	Хранилище = Желудь("ХранилищеАпстримовПула");

	ДобавитьАпстрим(Хранилище, 1, 3, "http://третий/");
	ДобавитьАпстрим(Хранилище, 1, 1, "http://первый/");
	ДобавитьАпстрим(Хранилище, 1, 2, "http://второй/");
	ДобавитьАпстрим(Хранилище, 2, 1, "http://чужой/");

	Упорядоченные = Хранилище.АпстримыУпорядоченно(1);
	Ожидаем.Что(Упорядоченные.Количество(), "апстримы только своего пула").Равно(3);
	Ожидаем.Что(СтрокиURL(Упорядоченные), "порядок обхода по колонке Порядок")
		.Равно("http://первый/,http://второй/,http://третий/");

	Ожидаем.Что(СтрокиURL(Хранилище.АпстримыУпорядоченно(2)), "апстримы второго пула")
		.Равно("http://чужой/");
	Ожидаем.Что(Хранилище.АпстримыУпорядоченно(3).Количество(), "у пула без апстримов пусто").Равно(0);

	Ожидаем.Что(Хранилище.ПолучитьПоПулИдентификаторРавно(1).Количество(), "неупорядоченная выборка пула")
		.Равно(3);

КонецПроцедуры

&Тест
Процедура ЗеркалаОтбираютсяПоПулуНазначенияИАпстриму() Экспорт

	Хранилище = Желудь("ХранилищеЗеркалХабов");

	Первое = ДобавитьЗеркало(Хранилище, 5, "http://hub-a/");
	ДобавитьЗеркало(Хранилище, 5, "http://hub-b/");
	Чужое = ДобавитьЗеркало(Хранилище, 6, "http://hub-a/");

	Ожидаем.Что(Хранилище.Все().Количество(), "выборка без отбора отдаёт все зеркала").Равно(3);
	Ожидаем.Что(Хранилище.ПолучитьПоПулНазначенияИдентификаторРавно(5).Количество(), "зеркала пула 5").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоПулНазначенияИдентификаторРавно(7).Количество(), "у пула 7 зеркал нет")
		.Равно(0);

	Ожидаем.Что(Хранилище.НайтиПоПулИАпстриму(5, "http://hub-a/").Идентификатор, "пара пул+апстрим")
		.Равно(Первое.Идентификатор);
	Ожидаем.Что(Хранилище.НайтиПоПулИАпстриму(6, "http://hub-a/").Идентификатор, "тот же апстрим у другого пула")
		.Равно(Чужое.Идентификатор);
	Ожидаем.Что(Хранилище.НайтиПоПулИАпстриму(5, "http://hub-z/"), "апстрима у пула нет").Равно(Неопределено);

	// нормализация аргумента живёт в фасаде: сервис зовёт метод со строковым идентификатором пула
	Ожидаем.Что(Хранилище.НайтиПоПулИАпстриму("5", "http://hub-b/"), "строковый идентификатор пула").Существует();

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Чужое.Идентификатор).ПулНазначенияИдентификатор,
		"зеркало по идентификатору").Равно(6);

	Хранилище.Удалить(Чужое);
	Ожидаем.Что(Хранилище.Все().Количество(), "после удаления зеркала").Равно(2);

КонецПроцедуры

&Тест
Процедура ВебхукиОтбираютсяПоТипуИИдентификаторуОбъекта() Экспорт

	Хранилище = Желудь("ХранилищеВебхуков");

	ДобавитьВебхук(Хранилище, "пул", 7, "https://пул-7/");
	ДобавитьВебхук(Хранилище, "пул", 8, "https://пул-8/");
	ДобавитьВебхук(Хранилище, "пакет", 7, "https://пакет-7/");
	Хабовый = ДобавитьВебхук(Хранилище, "хаб", 0, "https://хаб/");

	Ожидаем.Что(Хранилище.Все().Количество(), "выборка без отбора отдаёт все подписки").Равно(4);

	Ожидаем.Что(СтрокиURL(Хранилище.ПолучитьПоОбъекту("пул", 7)), "подписки пула 7").Равно("https://пул-7/");
	Ожидаем.Что(СтрокиURL(Хранилище.ПолучитьПоОбъекту("пакет", 7)), "тот же идентификатор, другой тип объекта")
		.Равно("https://пакет-7/");
	Ожидаем.Что(СтрокиURL(Хранилище.ПолучитьПоОбъекту("хаб", 0)), "подписки хаба").Равно("https://хаб/");
	Ожидаем.Что(Хранилище.ПолучитьПоОбъекту("пул", 99).Количество(), "у объекта подписок нет").Равно(0);

	// нормализация аргумента живёт в фасаде: контроллер приносит идентификатор строкой
	Ожидаем.Что(СтрокиURL(Хранилище.ПолучитьПоОбъекту("пул", "8")), "строковый идентификатор объекта")
		.Равно("https://пул-8/");

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Хабовый.Идентификатор).URL, "подписка по идентификатору")
		.Равно("https://хаб/");

	Хранилище.Удалить(Хабовый);
	Ожидаем.Что(Хранилище.Все().Количество(), "после удаления подписки").Равно(3);
	Ожидаем.Что(Хранилище.ПолучитьПоОбъекту("хаб", 0).Количество(), "подписок хаба не осталось").Равно(0);

КонецПроцедуры

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция ДобавитьПул(Хранилище, Знач Имя, Знач Тип)

	Пул = Хранилище.СоздатьЭлемент();
	Пул.Имя = Имя;
	Пул.Тип = Тип;
	Пул.Видимость = "public";
	Пул.ПубликацияРазрешена = Истина;
	Пул.Создан = ТекущаяУниверсальнаяДата();
	Пул.Сохранить();
	Возврат Пул;

КонецФункции

Функция ДобавитьУчастника(Хранилище, Знач ПулИдентификатор, Знач ТипСубъекта, Знач СубъектИдентификатор, Знач Роль)

	Участник = Хранилище.СоздатьЭлемент();
	Участник.ПулИдентификатор = ПулИдентификатор;
	Участник.ТипСубъекта = ТипСубъекта;
	Участник.СубъектИдентификатор = СубъектИдентификатор;
	Участник.Роль = Роль;
	Участник.Сохранить();
	Возврат Участник;

КонецФункции

Функция ДобавитьАпстрим(Хранилище, Знач ПулИдентификатор, Знач Порядок, Знач Url)

	Апстрим = Хранилище.СоздатьЭлемент();
	Апстрим.ПулИдентификатор = ПулИдентификатор;
	Апстрим.Порядок = Порядок;
	Апстрим.Url = Url;
	Апстрим.ВремяЖизниСек = 60;
	Апстрим.РазрешитьПриватные = Ложь;
	Апстрим.Сохранить();
	Возврат Апстрим;

КонецФункции

Функция ДобавитьЗеркало(Хранилище, Знач ПулНазначенияИдентификатор, Знач АпстримURL)

	Зеркало = Хранилище.СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = ПулНазначенияИдентификатор;
	Зеркало.АпстримURL = АпстримURL;
	Зеркало.Режим = "opm";
	Зеркало.ИнтервалСинкаСек = 3600;
	Зеркало.Включено = Истина;
	Зеркало.РазрешитьПриватные = Ложь;
	Зеркало.Создан = ТекущаяУниверсальнаяДата();
	Зеркало.Сохранить();
	Возврат Зеркало;

КонецФункции

Функция ДобавитьВебхук(Хранилище, Знач ТипОбъекта, Знач ОбъектИдентификатор, Знач URL)

	Вебхук = Хранилище.СоздатьЭлемент();
	Вебхук.ТипОбъекта = ТипОбъекта;
	Вебхук.ОбъектИдентификатор = ОбъектИдентификатор;
	Вебхук.ПулИдентификатор = 0;
	Вебхук.ТипДействия = "вебхук";
	Вебхук.URL = URL;
	Вебхук.Секрет = "";
	Вебхук.ТипыСобытий = "версия.опубликована";
	Вебхук.Активен = Истина;
	Вебхук.Создан = ТекущаяУниверсальнаяДата();
	Вебхук.Сохранить();
	Возврат Вебхук;

КонецФункции

// Значения колонки URL выборки одной строкой — так виден и состав, и порядок.
Функция СтрокиURL(Знач Записи)

	Значения = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Значения.Добавить(Запись.Url);
	КонецЦикла;
	Возврат СтрСоединить(Значения, ",");

КонецФункции

Функция ТипЗарегистрирован(Знач ИмяТипа)

	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба; // функция не может вызываться как процедура
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти
