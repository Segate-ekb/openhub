// Юнит-тесты онбординга публичного UX: ГвардОнбординга и безголовый админ из деталек
// oshub.admin.* — значением либо файлом; окружение доезжает до них загрузкой настроек.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем КлассыWebUI;
Перем КлассыВхода;
Перем Поиск;        // фикстура КлассыСлоя — файл класса ищется по имени

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подключить() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КлассыWebUI = ОбъединитьПути(Модули, "интерфейс", "Классы");
	// службы входа пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"),
			"СобытиеАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "основа", "Классы", "ТекстJSON.os"),
			"ТекстJSON");
	Исключение
	КонецПопытки;
	// канон записи адреса: его спрашивают вёдра ограничителя входа и журнал аудита
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "основа", "Классы", "КанонIP.os"), "КанонIP");
		ПодключитьСценарий(ОбъединитьПути(Модули, "основа", "Классы", "ТекстОшибки.os"), "ТекстОшибки");
	Исключение
	КонецПопытки;
	КлассыВхода = ОбъединитьПути(Модули, "вход", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();

	РеестрФикстур.Подключить("СервисПользователейЗаглушка");
	РеестрФикстур.Подключить("ОтветЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	Поиск.Подключить(КлассыВхода, "ОнбордингПервогоЗапуска");
	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "СекретИзФайла");
	Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ИменаПеременныхОкружения");
	Поиск.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "РасположениеДанных");
	Поиск.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "ИсточникиНастроек");
	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ПриведениеФлагов");
	Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ОписаниеПриложения");
	Поиск.Подключить(ОбъединитьПути(Модули, "api", "Классы"), "ПаспортОписанияAPI");
	Поиск.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), "ЗагрузкаНастроек");
	Поиск.Подключить(ОбъединитьПути(Модули, "права", "Классы"), "ВердиктГварда");
	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "Вердикт");
	Поиск.Подключить(КлассыWebUI, "ГвардОнбординга");

КонецПроцедуры

&Тест
Процедура ГвардРедиректитНаSetupКогдаНетПользователей() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Сервис.КоличествоПользователей = 0;
	Гвард = Новый ГвардОнбординга(Новый ОнбордингПервогоЗапуска(Сервис, "", "", "", ЛогТестов()));

	Ответ = Новый ОтветЗаглушка();
	Вердикт = Гвард.Проверить(Ответ);

	Ожидаем.Что(Вердикт.Разрешено, "продолжать нельзя — нужен онбординг").ЭтоЛожь();
	Ожидаем.Что(Ответ.БылРедирект, "был редирект").ЭтоИстина();
	Ожидаем.Что(Ответ.ПутьРедиректа).Равно("/setup");

КонецПроцедуры

&Тест
Процедура ГвардПропускаетКогдаЕстьПользователь() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Сервис.КоличествоПользователей = 1;
	Гвард = Новый ГвардОнбординга(Новый ОнбордингПервогоЗапуска(Сервис, "", "", "", ЛогТестов()));

	Ответ = Новый ОтветЗаглушка();
	Вердикт = Гвард.Проверить(Ответ);

	Ожидаем.Что(Вердикт.Разрешено, "инсталляция инициализирована — продолжаем").ЭтоИстина();
	Ожидаем.Что(Ответ.БылРедирект, "редиректа быть не должно (иначе петля/недоступность)").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СоздатьПервогоАдминаОтклоняетсяКогдаПользователиУжеЕсть() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Сервис.КоличествоПользователей = 1;
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "", "", "", ЛогТестов());

	Ошибка = "";
	Попытка
		Онбординг.СоздатьПервогоАдмина("eve", "EveSecret1", Ложь);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Ошибка, "already_initialized") > 0, "отказ с внятной причиной").ЭтоИстина();
	Ожидаем.Что(Сервис.ПоследнийСозданный, "второй администратор НЕ создан").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура БезголовыйСценарийНеСоздаётВторогоАдмина() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Сервис.КоличествоПользователей = 1; // хаб уже инициализирован
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "envadmin", "EnvPass123", "", ЛогТестов());

	Онбординг.ПриЗапускеПриложения();

	Ожидаем.Что(Сервис.ПоследнийСозданный, "рогатка идемпотентна").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура AdminCliСоздаётПервогоАдминаИТребуетForceНаИнициализированномХабе() Экспорт

	КаталогДанных = УникальныеИмена.ВременныйКаталог("oshub-cli");

	Попытка

		Первый = ЗапуститьCli(КаталогДанных, "create-admin --login root --password RootSecret1");
		Ожидаем.Что(Первый.Код, "на пустом хабе админ создаётся: " + Первый.Вывод).Равно(0);
		Ожидаем.Что(СтрНайти(Первый.Вывод, "первый администратор") > 0,
			"путь первого админа, а не восстановления").ЭтоИстина();

		Второй = ЗапуститьCli(КаталогДанных, "create-admin --login alice --password AliceSecret1");
		Ожидаем.Что(Второй.Код <> 0, "без --force команда отказывает").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Второй.Вывод, "--force") > 0, "отказ объясняет, чего не хватает").ЭтоИстина();

		Третий = ЗапуститьCli(КаталогДанных, "create-admin --login root --password NewSecret1 --force");
		Ожидаем.Что(Третий.Код, "с --force восстановление проходит: " + Третий.Вывод).Равно(0);
		Ожидаем.Что(СтрНайти(Третий.Вывод, "[--force]") > 0, "эскалация названа вслух").ЭтоИстина();

	Исключение
		УникальныеИмена.УбратьВременное(КаталогДанных);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(КаталогДанных);

КонецПроцедуры

// «Такого логина нет» и «пользователь существует» — один приказ восстановить доступ, и на
// выключенный парольный вход обе ветки отвечают одинаковым отказом.
&Тест
Процедура AdminCliОтказываетОбеимиВеткамиБезРаботающегоПарольногоВхода() Экспорт

	КаталогДанных = УникальныеИмена.ВременныйКаталог("oshub-cli-nopw");

	БезПароля = Новый Соответствие();
	БезПароля.Вставить("OSHUB_AUTH_PASSWORD_ENABLED", "false");

	Попытка

		Первый = ЗапуститьCli(КаталогДанных, "create-admin --login root --password RootSecret1");
		Ожидаем.Что(Первый.Код, "хаб инициализирован: " + Первый.Вывод).Равно(0);

		Новая = ЗапуститьCli(КаталогДанных,
			"create-admin --login alice --password AliceSecret1 --force", БезПароля);
		Ожидаем.Что(Новая.Код <> 0,
			"ветка «такого логина нет» отказывает: " + Новая.Вывод).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Новая.Вывод, "Вход по логину и паролю на хабе выключен") > 0,
			"отказ называет настоящую причину, а не «ни пароля нет»: " + Новая.Вывод).ЭтоИстина();

		Повышение = ЗапуститьCli(КаталогДанных,
			"create-admin --login root --password NewSecret1 --force", БезПароля);
		Ожидаем.Что(Повышение.Код <> 0,
			"ветка «пользователь существует» отказывает так же: " + Повышение.Вывод).ЭтоИстина();

		// КОНТРОЛЬ: с включённым парольным входом та же команда проходит — и заводит
		// учётку ВПЕРВЫЕ, то есть отказ выше не оставил её полуфабрикатом
		Контроль = ЗапуститьCli(КаталогДанных,
			"create-admin --login alice --password AliceSecret1 --force");
		Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: " + Контроль.Вывод).Равно(0);
		Ожидаем.Что(СтрНайти(Контроль.Вывод, "заведён дополнительным администратором") > 0,
			"учётки alice после отказа не осталось: " + Контроль.Вывод).ЭтоИстина();

	Исключение
		УникальныеИмена.УбратьВременное(КаталогДанных);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(КаталогДанных);

КонецПроцедуры

// Утилита восстановления доступа говорит с оператором выводом процесса: отвергнутое загрузкой
// настроек молча не пропадает.
&Тест
Процедура AdminCliПечатаетЗамечаниеЗагрузкиНастроек() Экспорт

	КаталогДанных = УникальныеИмена.ВременныйКаталог("oshub-cli-remark");

	НечисловойПул = Новый Соответствие();
	НечисловойПул.Вставить("OSHUB_DB_POOL_SIZE", "много");

	Попытка
		Запуск = ЗапуститьCli(КаталогДанных, "create-admin --login root --password RootSecret1", НечисловойПул);
	Исключение
		УникальныеИмена.УбратьВременное(КаталогДанных);
		ВызватьИсключение;
	КонецПопытки;
	УникальныеИмена.УбратьВременное(КаталогДанных);

	Ожидаем.Что(Запуск.Код, "замечание загрузки команду не роняет: " + Запуск.Вывод).Равно(0);
	Ожидаем.Что(СтрНайти(Запуск.Вывод, "ПРЕДУПРЕЖДЕНИЕ - data.ИсточникиДанных.РазмерПула / OSHUB_DB_POOL_SIZE=много не является числом") > 0,
		"отвергнутый размер пула назван в выводе утилиты: " + Запуск.Вывод).ЭтоИстина();

КонецПроцедуры

Функция ЗапуститьCli(Знач КаталогДанных, Знач Команда, Знач ДопОкружение = Неопределено)

	КаталогПроекта = КаталогиПроекта.Корень();
	Утилита = ОбъединитьПути(КаталогПроекта, "scripts", "admin-cli.os");

	// база — рядом с данными: иначе утилита взяла бы узел базы из файла настроек проекта
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB_STORAGE_ROOT", КаталогДанных);
	Окружение.Вставить("OSHUB_DB_CONNECTION", ОбъединитьПути(КаталогДанных, "entities"));
	Если ДопОкружение <> Неопределено Тогда
		Для Каждого КлючЗначение Из ДопОкружение Цикл
			Окружение.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1"" %2", Утилита, Команда),
		КаталогПроекта, Истина, , , Окружение);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();

	Возврат Новый Структура("Код, Вывод", Процесс.КодВозврата,
		Процесс.ПотокВывода.Прочитать() + Процесс.ПотокОшибок.Прочитать());

КонецФункции

&Тест
Процедура АдминИзДеталейПравильныйЛогинИФлагСмены() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "detailadmin", "DetailPass123", "", ЛогТестов());

	Онбординг.ПриЗапускеПриложения();

	Ожидаем.Что(Сервис.ПоследнийСозданный <> Неопределено, "админ создан из детали").ЭтоИстина();
	Ожидаем.Что(Сервис.ПоследнийСозданный.Логин).Равно("detailadmin");
	Ожидаем.Что(Сервис.ПоследнийСозданный.Роль).Равно("admin");
	Ожидаем.Что(Сервис.ПоследнийСозданный.СменаПароля, "флаг «сменить пароль»").ЭтоИстина();

КонецПроцедуры

// Данные подключения из конфигурации печатаются в консоль один раз, при первичной
// инициализации: экрана у этих значений нет.
&Тест
Процедура ДанныеПодключенияПечатаютсяВКонсольПриПервичнойИнициализации() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "detailadmin", "DetailPass123", "", ЛогТестов());

	Онбординг.ПриЗапускеПриложения();

	Напечатано = Онбординг.НапечатанныеДанныеПодключения();
	Ожидаем.Что(СтрНайти(Напечатано, "detailadmin") > 0,
		"логин администратора напечатан: " + Напечатано).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Напечатано, "DetailPass123") > 0,
		"и пароль вместе с ним: " + Напечатано).ЭтоИстина();

КонецПроцедуры

// Консоль — не журнал: журнал уезжает во внешний сборщик, и пароля в нём нет ни строкой,
// но о созданном администраторе и данных подключения он сообщает.
&Тест
Процедура ПароляПервогоАдминистратораВЖурналеНет() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.старт.секрет");
	Лог.УстановитьУровень(УровниЛога.Отладка); // самый подробный: чего нет здесь — нет нигде
	Лог.ДобавитьСпособВывода(Ловушка);

	Сервис = Новый СервисПользователейЗаглушка();
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "detailadmin", "DetailPass123", "", Лог);

	Онбординг.ПриЗапускеПриложения();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "DetailPass123"),
		"пароль администратора в журнале приложения: " + Ловушка.Всё()).Равно(0);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "detailadmin") > 0,
		"а сам факт создания администратора журнал называет: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "напечатаны в консоли") > 0,
		"и говорит, где искать данные подключения: " + Ловушка.Всё()).ЭтоИстина();

	// сам секрет при этом оператору всё-таки показан — но другим каналом
	Ожидаем.Что(СтрНайти(Онбординг.НапечатанныеДанныеПодключения(), "DetailPass123") > 0,
		"пароль напечатан в консоль").ЭтоИстина();

КонецПроцедуры

// «Один раз» — это ровно первичная инициализация: на хабе, где администратор уже есть,
// печатать нечего, и вывалить чужие данные подключения в консоль хаб не имеет права.
&Тест
Процедура НаИнициализированномХабеДанныеПодключенияНеПечатаются() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Сервис.КоличествоПользователей = 1;
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "detailadmin", "DetailPass123", "", ЛогТестов());

	Онбординг.ПриЗапускеПриложения();

	Ожидаем.Что(Онбординг.НапечатанныеДанныеПодключения(),
		"на инициализированном хабе печатать нечего").Равно("");

КонецПроцедуры

// Конфигурация молчит — печатать тоже нечего: администратора заведут через /setup.
&Тест
Процедура БезДанныхВКонфигурацииКонсольМолчит() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "", "", "", ЛогТестов());

	Онбординг.ПриЗапускеПриложения();

	Ожидаем.Что(Онбординг.НапечатанныеДанныеПодключения(),
		"без логина в конфигурации консоль молчит").Равно("");

КонецПроцедуры

&Тест
Процедура ОкружениеПеребиваетФайлНастроек() Экспорт

	Файл = Новый Соответствие();
	Файл.Вставить("oshub", Новый Соответствие());
	Файл["oshub"].Вставить("admin", Новый Соответствие());
	Файл["oshub"]["admin"].Вставить("login", "detailadmin");
	Файл["oshub"]["admin"].Вставить("password", "DetailPass123");
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB.ADMIN.LOGIN", "envadmin");
	Окружение.Вставить("OSHUB.ADMIN.PASSWORD", "EnvPass123");

	Сервис = Новый СервисПользователейЗаглушка();
	ОнбордингИзНастроек(Сервис, Файл, Окружение).ПриЗапускеПриложения();

	Ожидаем.Что(Сервис.ПоследнийСозданный.Логин, "логин из окружения сильнее файла").Равно("envadmin");
	Ожидаем.Что(Сервис.ПоследнийСозданный.Пароль, "и пароль тоже").Равно("EnvPass123");

КонецПроцедуры

&Тест
Процедура ПарольИзФайлаПоПеременнойКонвенции() Экспорт

	// Имя переменной выводится из ключа oshub.admin.password_file конвенцией configor:
	// подчёркивание внутри сегмента удваивается.
	ПутьФайла = УникальныеИмена.ВременныйПуть("oshub-admin-secret", "txt");
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("FilePass123");
	Запись.Закрыть();

	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB.ADMIN.LOGIN", "fileadmin");
	Окружение.Вставить("OSHUB.ADMIN.PASSWORD_FILE", ПутьФайла); // так configor читает OSHUB_ADMIN_PASSWORD__FILE

	Сервис = Новый СервисПользователейЗаглушка();
	ОнбордингИзНастроек(Сервис, Новый Соответствие(), Окружение).ПриЗапускеПриложения();

	Ожидаем.Что(Сервис.ПоследнийСозданный <> Неопределено, "админ создан по файлу пароля").ЭтоИстина();
	Ожидаем.Что(Сервис.ПоследнийСозданный.Пароль).Равно("FilePass123");

	УникальныеИмена.УбратьВременное(ПутьФайла);

КонецПроцедуры

&Тест
Процедура ПутьКНесуществующемуФайлуПароляНазванВЖурнале() Экспорт

	Лог = ЛогТестов();
	Ловушка = Новый ЛовушкаЛога();
	Лог.ДобавитьСпособВывода(Ловушка, УровниЛога.Отладка);

	Попытка
		Сервис = Новый СервисПользователейЗаглушка();
		Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "fileadmin", "", "/нет/такого/файла", Лог);
		Онбординг.ПриЗапускеПриложения();
	Исключение
		Лог.УдалитьСпособВывода(Ловушка);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(Сервис.ПоследнийСозданный, "без пароля админ не создан").Равно(Неопределено);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "/нет/такого/файла") > 0,
		"предупреждение называет путь: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезЛогинаАдминНеСоздаётся() Экспорт

	Сервис = Новый СервисПользователейЗаглушка();
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "", "", "", ЛогТестов());

	Онбординг.ПриЗапускеПриложения();

	Ожидаем.Что(Сервис.ПоследнийСозданный, "без логина безголовый сценарий не срабатывает").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПарольИзФайлаДетали() Экспорт

	ПутьФайла = УникальныеИмена.ВременныйПуть("oshub-admin-secret", "txt");
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("FilePass123" + Символы.ПС); // хвостовой перевод строки — как у docker-secret
	Запись.Закрыть();

	Сервис = Новый СервисПользователейЗаглушка();
	Онбординг = Новый ОнбордингПервогоЗапуска(Сервис, "fileadmin", "", ПутьФайла, ЛогТестов());

	Онбординг.ПриЗапускеПриложения();

	Ожидаем.Что(Сервис.ПоследнийСозданный <> Неопределено, "админ создан из файла-детали").ЭтоИстина();
	Ожидаем.Что(Сервис.ПоследнийСозданный.Пароль, "пароль прочитан из файла и обрезан").Равно("FilePass123");

	УникальныеИмена.УбратьВременное(ПутьФайла);

КонецПроцедуры

// Онбординг с детальками, которые собрала загрузка настроек из файла и окружения.
Функция ОнбордингИзНастроек(Знач Сервис, Знач Файл, Знач Окружение)

	Загрузка = Новый ЗагрузкаНастроек();
	Загрузка.ДеталькиПоверх(Файл, Окружение);

	Возврат Новый ОнбордингПервогоЗапуска(Сервис,
		Загрузка.Значение("oshub.admin.login"),
		Загрузка.Значение("oshub.admin.password"),
		Загрузка.Значение("oshub.admin.password_file"), ЛогТестов());

КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции
