// BSLLS:YoLetterUsage-off
// Фейк ХранилищаПользователей для обходов «все учётки»: список задаёт тест.

Перем Учетки;

// Контракт ХранилищаПользователей: все пользователи хаба.
//
// Возвращаемое значение:
//  Массив из Структура - Идентификатор, Логин, РольХаба, Активен.
//
Функция Все() Экспорт
	Возврат Учетки;
КонецФункции

// Добавляет учётку в выдачу.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//  РольХаба - Строка - "admin" либо "user".
//  Активен - Булево - активна ли учётка (необязательный, по умолчанию Истина).
//
Процедура Добавить(Знач Идентификатор, Знач РольХаба, Знач Активен = Истина) Экспорт

	Учетки.Добавить(Новый Структура("Идентификатор, Логин, РольХаба, Активен",
		Цел(Идентификатор), "user" + Формат(Идентификатор, "ЧГ=0"), РольХаба, Активен));

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Учетки = Новый Массив();
КонецПроцедуры
