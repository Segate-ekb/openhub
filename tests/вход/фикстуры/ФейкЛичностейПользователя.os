// Фейк СервисаЛичностей: привязки «пользователь → издатель» задаёт тест.

Перем Личности; // Соответствие: идентификатор пользователя -> Массив структур личности

// Контракт СервисаЛичностей: личности пользователя.
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Массив из Структура - Издатель, Субъект.
//
Функция ЛичностиПользователя(Знач ПользовательИдентификатор) Экспорт

	Найдено = Личности.Получить(Цел(ПользовательИдентификатор));
	Возврат ?(Найдено = Неопределено, Новый Массив(), Найдено);

КонецФункции

// Привязывает личность издателя к пользователю.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец личности.
//  Издатель - Строка - issuer провайдера.
//
Процедура ДобавитьЛичность(Знач ПользовательИдентификатор, Знач Издатель) Экспорт

	Ключ = Цел(ПользовательИдентификатор);
	Список = Личности.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив();
		Личности.Вставить(Ключ, Список);
	КонецЕсли;
	Список.Добавить(Новый Структура("Издатель, Субъект", Издатель, "sub-" + Формат(Ключ, "ЧГ=0")));

КонецПроцедуры

// Снимает все привязки пользователя — моделирует отвязку между вопросом и ответом.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец личностей.
//
Процедура ОчиститьЛичности(Знач ПользовательИдентификатор) Экспорт
	Личности.Вставить(Цел(ПользовательИдентификатор), Новый Массив());
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Личности = Новый Соответствие();
КонецПроцедуры
