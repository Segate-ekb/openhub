// Фейк ХранилищаПровайдеровВхода: строки таблицы провайдеров задаёт тест, чтобы над
// ними работала НАСТОЯЩАЯ КонфигурацияOIDC (в том числе её отбор по признаку «включён»).

Перем Записи;

// Контракт ХранилищаПровайдеровВхода: все строки таблицы.
//
// Возвращаемое значение:
//  Массив из Структура - поля провайдера входа.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Добавляет строку провайдера.
//
// Параметры:
//  Имя - Строка - имя провайдера (оно же сегмент адреса входа).
//  Издатель - Строка - issuer провайдера.
//  Включён - Булево - участвует ли строка в действующей конфигурации.
//
Процедура Добавить(Знач Имя, Знач Издатель, Знач Включён) Экспорт

	Запись = Новый Структура();
	Запись.Вставить("Имя", Имя);
	Запись.Вставить("Метка", Имя);
	Запись.Вставить("Значок", "");
	Запись.Вставить("ВидПротокола", "oidc");
	Запись.Вставить("Пресет", "");
	Запись.Вставить("Издатель", Издатель);
	Запись.Вставить("ИдентификаторКлиента", "клиент-" + Имя);
	Запись.Вставить("СекретКлиента", "секрет");
	Запись.Вставить("АдресВозврата", "https://hub.example/oidc/callback");
	Запись.Вставить("Область", "openid profile email");
	Запись.Вставить("КонечныеТочки", "");
	Запись.Вставить("МаппингПрофиля", "");
	Запись.Вставить("ИмяКлеймаГрупп", "groups");
	Запись.Вставить("АвтоСоздание", Ложь);
	Запись.Вставить("ПровижинингГрупп", Ложь);
	Запись.Вставить("СвязкаГруппПоИмени", Ложь);
	Запись.Вставить("ПрефиксГрупп", "");
	Запись.Вставить("Включён", Включён);
	Записи.Добавить(Запись);

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
КонецПроцедуры
