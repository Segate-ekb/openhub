// Профиль учётки в кабинете подопытного хаба: адрес в форме профиля и кнопка повтора письма;
// учётка, на которой их проверяют, — администратор стенда, заведённый один раз на набор.

Перем Клиент;       // фикстура КлиентХаба подопытного хаба
Перем ЛогинАдмина;
Перем ПарольАдмина;
Перем КукаАдмина;   // сессия администратора: заводится при первом обращении

// Сессия администратора стенда: первый вызов заводит его через /setup или входит паролем,
// следующие отдают ту же сессию — с адресом вход паролем закрыт до подтверждения.
//
// Возвращаемое значение:
//  Строка - значение куки сессии.
//
Функция СессияАдмина() Экспорт

	Если ЗначениеЗаполнено(КукаАдмина) Тогда
		Возврат КукаАдмина;
	КонецЕсли;

	Учётные = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", ЛогинАдмина, ПарольАдмина);
	Ответ = Клиент.POSTJSON("/setup", Учётные);
	Если Ответ.КодСостояния = 201 Тогда
		КукаАдмина = Клиент.КукаОтвета(Ответ, "oshub_session");
	Иначе
		КукаАдмина = Клиент.КукаОтвета(Клиент.POSTJSON("/api/v1/login", Учётные), "oshub_session");
	КонецЕсли;

	Возврат КукаАдмина;

КонецФункции

// Сессия администратора стенда с адресом root@example.org, вписанным кабинетом.
//
// Возвращаемое значение:
//  Строка - значение куки сессии.
//
Функция СессияАдминаСАдресом() Экспорт

	Кука = СессияАдмина();
	ЗадатьАдрес(Кука, "root@example.org");
	Возврат Кука;

КонецФункции

// Вписывает адрес формой профиля, как это делает человек; запись проверяется по ответу.
//
// Параметры:
//  Кука  - Строка - сессия учётки.
//  Адрес - Строка - новый адрес.
//
Процедура ЗадатьАдрес(Знач Кука, Знач Адрес) Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить("email", Адрес);
	Поля.Вставить("_csrf",
		Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука))));

	Ответ = Клиент.POSTФормы("/me/settings/profile", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 302,
		"адрес учётки записан кабинетом").ЭтоИстина();

КонецПроцедуры

// Адрес, который кабинет показывает в поле профиля.
//
// Параметры:
//  Кука - Строка - сессия учётки.
//
// Возвращаемое значение:
//  Строка - значение поля email.
//
Функция Адрес(Знач Кука) Экспорт
	Профиль = Клиент.Тело(Клиент.GETСКукой("/me/settings/profile", Кука));
	Возврат Клиент.РазобраннаяФормаСо(Профиль, "name=""email""").Поля.Получить("email");
КонецФункции

// Форма повтора письма на странице — та, что несёт операцию «выслать».
//
// Параметры:
//  Разметка - Строка - HTML страницы кабинета.
//
// Возвращаемое значение:
//  Структура, Неопределено - форма как у КлиентХаба.ФормыСтраницы; такой нет — Неопределено.
//
Функция ФормаПовтора(Знач Разметка) Экспорт

	Для Каждого Форма Из Клиент.ФормыСтраницы(Разметка) Цикл
		Если Форма.Поля.Получить("операция") = "выслать" Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Поля нажатия «выслать ещё раз», собранные руками.
//
// Параметры:
//  ТокенCSRF - Строка - токен формы; пустой — поля CSRF нет вовсе.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> значение.
//
Функция ПоляПовтора(Знач ТокенCSRF) Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить("операция", "выслать");
	Если ЗначениеЗаполнено(ТокенCSRF) Тогда
		Поля.Вставить("_csrf", ТокенCSRF);
	КонецЕсли;
	Возврат Поля;

КонецФункции

Процедура ПриСозданииОбъекта(Знач КлиентПодопытного, Знач Логин, Знач Пароль)
	Клиент = КлиентПодопытного;
	ЛогинАдмина = Логин;
	ПарольАдмина = Пароль;
КонецПроцедуры
