// Словарь домена входа: каждый ключ, который спрашивает код модуля, в словаре есть — иначе
// в письме или отказе вместо слова окажется маркер, — и ключей, которых никто не спрашивает, нет.

#Использовать asserts
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем Словарь;      // СловарьВхода (вход) — словарь под проверкой
Перем Исходники;    // фикстура ИсходникиПроекта — текст файла по пути

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ИсходникиПроекта");
	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(КаталогВхода(), "СловарьВхода");
	Поиск.Подключить(КаталогВхода(), "ТекстыВхода");

	Словарь = Новый СловарьВхода();
	Исходники = Новый ИсходникиПроекта();

КонецПроцедуры

&Тест
Процедура КаждыйКлючКодаВходаЕстьВСловаре() Экспорт

	Спрошенные = КлючиИзКодаВхода();

	Отсутствующие = Новый Массив();
	Для Каждого КиЗ Из Спрошенные Цикл
		Если Словарь.НайтиТекст(КиЗ.Ключ) = Неопределено Тогда
			Отсутствующие.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Спрошенные.Количество() > 50, "сборщик вообще находит ключи в коде входа").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Отсутствующие, ", "),
		"ключи, которых нет в словаре входа: вместо слова будет маркер").Равно("");

КонецПроцедуры

&Тест
Процедура ВСловареНетКлючейКоторыеНиктоНеСпрашивает() Экспорт

	Спрошенные = КлючиИзКодаВхода();

	Мёртвые = Новый Массив();
	Для Каждого Ключ Из Словарь.Ключи() Цикл
		Если Спрошенные.Получить(Ключ) = Неопределено Тогда
			Мёртвые.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Мёртвые, ", "), "ключи словаря входа, которых не спрашивает код").Равно("");

КонецПроцедуры

&Тест
Процедура ОтсутствующийКлючДаётМаркерАНеПустоеСлово() Экспорт

	Текст = Новый ТекстыВхода().Текст("providers.такого-ключа-нет");

	Ожидаем.Что(СтрНайти(Текст, "providers.такого-ключа-нет") > 0,
		"маркер называет сам ключ: " + Текст).ЭтоИстина();

КонецПроцедуры

// Вызов в комментарии и вызов внутри строкового литерала — не вызов: иначе мёртвый ключ
// прятался бы за упоминанием, а живой — за закомментированной строкой.
&Тест
Процедура СборщикЧитаетВызовыАНеКомментарииИЛитералы() Экспорт

	Образец = "// Тексты.Текст(""mail.in-comment"")" + Символы.ПС
		+ "Слово = ""Тексты.Текст(""""mail.in-literal"""")"";" + Символы.ПС
		+ "Тема = Тексты.Шаблон(""mail.real"", Логин);";

	Найденные = Новый Соответствие();
	ДобавитьКлючиВызовов(Найденные, Образец, "образец");

	Ожидаем.Что(Найденные.Получить("mail.real"), "настоящий вызов найден").Равно("образец");
	Ожидаем.Что(Найденные.Получить("mail.in-comment"), "вызов в комментарии не в счёт").Равно(Неопределено);
	Ожидаем.Что(Найденные.Количество(), "вызов в литерале не в счёт").Равно(1);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Ключ -> имя файла, где его спросили впервые.
Функция КлючиИзКодаВхода()

	Результат = Новый Соответствие();
	Для Каждого Файл Из НайтиФайлы(КаталогВхода(), "*.os", Истина) Цикл
		ДобавитьКлючиВызовов(Результат, Исходники.Текст(Файл.ПолноеИмя), Файл.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьКлючиВызовов(Результат, Знач Исходник, Знач ИмяФайла)

	Код = ИсходникБезКомментариев.БезКомментариев(Исходник);
	Для Каждого Маркер Из СтрРазделить(".Текст("";.Шаблон(""", ";") Цикл
		Хвост = Код;
		Позиция = СтрНайти(Хвост, Маркер);
		Пока Позиция > 0 Цикл
			Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
			// у вызова внутри литерала кавычка удвоена: ключ пуст, это не вызов
			Конец = СтрНайти(Хвост, """");
			Если Конец > 1 И Результат.Получить(Лев(Хвост, Конец - 1)) = Неопределено Тогда
				Результат.Вставить(Лев(Хвост, Конец - 1), ИмяФайла);
			КонецЕсли;
			Позиция = СтрНайти(Хвост, Маркер);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КаталогВхода()
	Возврат ОбъединитьПути(КаталогиПроекта.Модули(), "вход", "Классы");
КонецФункции

#КонецОбласти
