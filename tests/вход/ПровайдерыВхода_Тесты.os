// Провайдеры входа в контейнере: пресеты, синтетический издатель OAuth2, SSRF-гейт адресов формы,
// изменения с принципалом — и попытки всё это обойти. Резолвер имён — фейк без сети.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать oidc-client
#Использовать oscript-ui
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;           // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;
Перем Сервис_;    // СервисПровайдеровВхода, собранный вручную поверх фейкового резолвера
Перем Админ;      // Пользователь с ролью admin
Перем Принципалы; // фикстура СтендПринципалов — принципал сессии и ключа

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные, реестр, события");
	Слои.ПодключитьТаблицы("уведомления");

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	Слои.Подключить("основа");
	// службы входа пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита");
	Слои.Подключить("вход, права, настройки, интерфейс/общее/настройки, интерфейс/хаб, сеть");
	КаталогПробХаба = ОбъединитьПути(Модули, "наблюдаемость", "Классы/пробы");
	// кит приезжает библиотекой (#Использовать выше), из проекта нужна только поставка статики
	ПоискКлассов.ПодключитьСловарьТекстов(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "гео", "Классы"), "КодыСтран");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "гео", "Классы"), "СправочникСтран");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "СтатикаХаба");
	Слои.Подключить("вход, права");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ФейкЖурналЗамка");
	РеестрФикстур.Подключить("ЛовушкаЛога");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "провайдеры-входа-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = СоветНабора.СДетальками(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Принципалы = Новый СтендПринципалов(Поделка);

	Сервис_ = СобратьСервис();
	Админ = Желудь("СервисПользователей").СоздатьПользователя(
		"root7d", "", "password123", "admin");

КонецПроцедуры

#Область СборкаКонтейнера

&Тест
Процедура ЖелудиПровайдеровЗарегистрированы() Экспорт
	// витрина и пульт живут в интерфейсе/настройки и тянут РендерерКабинета — их сборку проверяют HTTP-тесты дома настроек
	Для Каждого Имя Из СтрРазделить("ХранилищеПровайдеровВхода,ПресетыВхода,"
		+ "ВалидаторАдресаПровайдера,РазборПровайдераВхода,СервисПровайдеровВхода,ФормаПровайдераВхода", ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;
КонецПроцедуры

// Хранилище провайдеров обязано собираться желудём, а не молча отдаваться зависимому классу Неопределено.
&Тест
Процедура ХранилищеПровайдеровСобираетсяИРаботает() Экспорт

	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Ожидаем.Что(Хранилище, "хранилище собрано").Существует();

	Имя = "store" + УникальныеИмена.Хвост();
	Запись = Хранилище.СоздатьЗапись(Имя);
	Запись.Метка = "витрина";
	Запись.ВидПротокола = "oidc";
	Запись.Включён = Истина;
	Хранилище.Записать(Запись, "root7d", ТекущаяУниверсальнаяДата());

	Найденная = Хранилище.НайтиПоИмени(ВРег(Имя));
	Ожидаем.Что(Найденная, "строка читается по имени без учёта регистра").Существует();
	Ожидаем.Что(Строка(Найденная.КемОбновлён)).Равно("root7d");
	Ожидаем.Что(Хранилище.УдалитьПоИмени(Имя), "удаление сообщает, что строка была").ЭтоИстина();
	Ожидаем.Что(Хранилище.УдалитьПоИмени(Имя), "повторное удаление идемпотентно").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПраваМутаций

// Изменение принимает принципала; ключ доступа провайдерами входа не управляет — запрет по способу.
&Тест
Процедура КлючДоступаНеУправляетПровайдерамиВхода() Экспорт

	Данные = ВводПресета("gh" + УникальныеИмена.Хвост(), "github");

	// КОНТРОЛЬ: сессия администратора ту же самую операцию выполняет
	Контроль = Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета("ctl" + УникальныеИмена.Хвост(), "github"));
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: сессия админа заводит провайдера: " + Контроль.Сообщение).ЭтоИстина();

	// ПОЛНЫЙ ключ того же администратора — отказ по способу
	Ключ = Принципалы.Ключ(Админ, "read,write", 0);
	Исход = Сервис_.Завести(Ключ, Данные);

	Ожидаем.Что(Исход.Успех, "полный ключ администратора провайдера НЕ заводит").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(403);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, "только из кабинета") > 0,
		"отказ назван своим именем (текст: " + Исход.Сообщение + ")").ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Данные.Имя), "строка не появилась").Равно(Неопределено);

КонецПроцедуры

// Рамки ключа спрашиваются ДО запрета по способу: узкий ключ — отказ по скоупу, привязанный к пулу — по привязке.
&Тест
Процедура РамкиКлючаПроверяютсяОтдельноОтЗапретаПоСпособу() Экспорт

	ТолькоЧтение = Сервис_.ПроверитьПраво(Принципалы.Ключ(Админ, "read", 0), "создание");
	Ожидаем.Что(ТолькоЧтение.Успех).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ТолькоЧтение.Сообщение, "скоуп") > 0,
		"read-ключ отвергнут по скоупу (текст: " + ТолькоЧтение.Сообщение + ")").ЭтоИстина();

	Привязанный = Сервис_.ПроверитьПраво(Принципалы.Ключ(Админ, "read,write", 42), "создание");
	Ожидаем.Что(Привязанный.Успех).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Привязанный.Сообщение, "привязан к пулу") > 0,
		"ключ пула отвергнут по привязке (текст: " + Привязанный.Сообщение + ")").ЭтоИстина();

	// КОНТРОЛЬ: полный непривязанный ключ проходит гейт и падает уже на способе — ветки различимы
	Полный = Сервис_.ПроверитьПраво(Принципалы.Ключ(Админ, "read,write", 0), "создание");
	Ожидаем.Что(Полный.Успех).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Полный.Сообщение, "только из кабинета") > 0,
		"полный ключ проходит рамки и отвергается способом (текст: " + Полный.Сообщение + ")").ЭтоИстина();

КонецПроцедуры

// Fail-closed: несобранный гейт ключа — отказ запросу С КЛЮЧОМ; рядом контроль — сессия работает как обычно.
&Тест
Процедура БезГейтаКлючаЗапросСКлючомОтвергается() Экспорт

	БезГейта = Новый СервисПровайдеровВхода(
		Желудь("ХранилищеПровайдеровВхода"), Желудь("КонфигурацияOIDC"), СобратьРазбор(),
		Желудь("ПерехватчикАутентификации"), Желудь("СервисПрав"),
		Желудь("ТекстыВхода"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Неопределено, Неопределено);

	СКлючом = БезГейта.ПроверитьПраво(Принципалы.Ключ(Админ, "read,write", 0), "создание");
	Ожидаем.Что(СКлючом.Успех, "ключ без гейта — отказ").ЭтоЛожь();
	Ожидаем.Что(СКлючом.Код).Равно(403);
	Ожидаем.Что(СтрНайти(СКлючом.Сообщение, "гейт ключа доступа не собран") > 0,
		"причина названа (текст: " + СКлючом.Сообщение + ")").ЭтоИстина();

	Сессией = БезГейта.ПроверитьПраво(Принципалы.Сессия(Админ), "создание");
	Ожидаем.Что(Сессией.Успех, "КОНТРОЛЬ: сессия несобранным гейтом не сужается").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеАдминИАнонимПровайдерамиНеУправляют() Экспорт

	Обычный = Желудь("СервисПользователей").СоздатьПользователя(
		"user" + УникальныеИмена.Хвост(), "", "password123", "user");

	НеАдмин = Сервис_.Завести(Принципалы.Сессия(Обычный), ВводПресета("na" + УникальныеИмена.Хвост(), "github"));
	Ожидаем.Что(НеАдмин.Успех).ЭтоЛожь();
	Ожидаем.Что(НеАдмин.Код).Равно(403);

	Аноним = Сервис_.Завести(Принципалы.Сессия(Неопределено), ВводПресета("an" + УникальныеИмена.Хвост(), "github"));
	Ожидаем.Что(Аноним.Успех).ЭтоЛожь();
	Ожидаем.Что(Аноним.Код, "аноним получает 401, а не 403").Равно(401);

	// КОНТРОЛЬ: тот же ввод от администратора проходит — отличие ровно в роли
	Контроль = Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета("ok" + УникальныеИмена.Хвост(), "github"));
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: админ заводит: " + Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлючНеМеняетНеПереключаетИНеУдаляет() Экспорт

	Имя = "key" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	Ключ = Принципалы.Ключ(Админ, "read,write", 0);

	Правка = ВводПресета(Имя, "google");
	Правка.Вставить("Метка", "ключ переписал");
	ИсходПравки = Сервис_.Изменить(Ключ, Имя, Правка);
	Ожидаем.Что(ИсходПравки.Успех, "ключ не правит провайдера").ЭтоЛожь();
	Ожидаем.Что(ИсходПравки.Код).Равно(403);

	ИсходТумблера = Сервис_.Переключить(Ключ, Имя, Ложь);
	Ожидаем.Что(ИсходТумблера.Успех, "ключ не переключает провайдера").ЭтоЛожь();
	Ожидаем.Что(ИсходТумблера.Код).Равно(403);

	ИсходУдаления = Сервис_.Удалить(Ключ, Имя);
	Ожидаем.Что(ИсходУдаления.Успех, "ключ не удаляет провайдера").ЭтоЛожь();
	Ожидаем.Что(ИсходУдаления.Код).Равно(403);

	// строка на месте и в прежнем виде
	Карточка = Сервис_.КарточкаПоИмени(Имя);
	Ожидаем.Что(Карточка, "провайдер не удалён ключом").Существует();
	Ожидаем.Что(Карточка.Включён, "провайдер не выключен ключом").ЭтоИстина();
	Ожидаем.Что(Карточка.Метка = "ключ переписал", "метка не переписана ключом").ЭтоЛожь();

	// КОНТРОЛЬ: ровно те же три вызова сессией администратора проходят
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Правка).Успех,
		"КОНТРОЛЬ: сессия правит").ЭтоИстина();
	Ожидаем.Что(Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Ложь).Успех,
		"КОНТРОЛЬ: сессия переключает").ЭтоИстина();
	Ожидаем.Что(Сервис_.Удалить(Принципалы.Сессия(Админ), Имя).Успех,
		"КОНТРОЛЬ: сессия удаляет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеАдминНеМеняетНеПереключаетИНеУдаляет() Экспорт

	Обычный = Желудь("СервисПользователей").СоздатьПользователя(
		"usr" + УникальныеИмена.Хвост(), "", "password123", "user");

	Имя = "own" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	Чужой = Принципалы.Сессия(Обычный);
	Ожидаем.Что(Сервис_.Изменить(Чужой, Имя, ВводПресета(Имя, "google")).Код,
		"чужой не правит").Равно(403);
	Ожидаем.Что(Сервис_.Переключить(Чужой, Имя, Ложь).Код, "чужой не переключает").Равно(403);
	Ожидаем.Что(Сервис_.Удалить(Чужой, Имя).Код, "чужой не удаляет").Равно(403);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Включён, "провайдер цел").ЭтоИстина();

	// КОНТРОЛЬ: те же вызовы админом проходят
	Ожидаем.Что(Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Ложь).Успех,
		"КОНТРОЛЬ: админ переключает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АдминПулаНеУправляетВходомВХаб() Экспорт

	Владелец = Желудь("СервисПользователей").СоздатьПользователя(
		"pool" + УникальныеИмена.Хвост(), "", "password123", "user");

	Имя = "pl" + УникальныеИмена.Хвост();
	Исход = Сервис_.Завести(Принципалы.Сессия(Владелец), ВводПресета(Имя, "google"));
	Ожидаем.Что(Исход.Успех, "владелец пула не заводит провайдера входа").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(403);

	// КОНТРОЛЬ: тот же ввод от админа хаба проходит
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех,
		"КОНТРОЛЬ: админ хаба заводит").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АнонимНиОдинМетодНеВыполняет() Экспорт

	Имя = "anon" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	Аноним = Принципалы.Сессия(Неопределено);
	Ожидаем.Что(Сервис_.Изменить(Аноним, Имя, ВводПресета(Имя, "google")).Код).Равно(401);
	Ожидаем.Что(Сервис_.Переключить(Аноним, Имя, Ложь).Код).Равно(401);
	Ожидаем.Что(Сервис_.Удалить(Аноним, Имя).Код).Равно(401);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя), "провайдер цел").Существует();

	// принципал вообще отсутствует (не структура) — тоже 401
	Ожидаем.Что(Сервис_.Удалить(Неопределено, Имя).Код, "принципала нет — 401").Равно(401);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя), "и провайдер по-прежнему цел").Существует();

КонецПроцедуры

&Тест
Процедура БезГейтаКлючаВсеМетодыОтбиваютКлюч() Экспорт

	Имя = "ng" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	БезГейта = Новый СервисПровайдеровВхода(
		Желудь("ХранилищеПровайдеровВхода"), Желудь("КонфигурацияOIDC"), СобратьРазбор(),
		Желудь("ПерехватчикАутентификации"), Желудь("СервисПрав"),
		Желудь("ТекстыВхода"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Неопределено, Неопределено);

	Ключ = Принципалы.Ключ(Админ, "read,write", 0);
	Ожидаем.Что(БезГейта.Изменить(Ключ, Имя, ВводПресета(Имя, "google")).Код).Равно(403);
	Ожидаем.Что(БезГейта.Переключить(Ключ, Имя, Ложь).Код).Равно(403);
	Ожидаем.Что(БезГейта.Удалить(Ключ, Имя).Код).Равно(403);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Включён, "провайдер цел и включён").ЭтоИстина();

	// КОНТРОЛЬ: сессия в том же несобранном сервисе удаляет
	Ожидаем.Что(БезГейта.Удалить(Принципалы.Сессия(Админ), Имя).Успех,
		"КОНТРОЛЬ: сессия работает и без гейта").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область НаборПолейПресета

// Пресет знает свой набор полей ДАННЫМИ: экран и разбор читают один и тот же список,
// а не повторяют ветвления по имени пресета.
&Тест
Процедура ПресетОписываетСвойНаборПолейДанными() Экспорт

	Пресеты = Желудь("ПресетыВхода");

	Ожидаем.Что(Пресеты.ПолеРазрешено("", "Издатель"), "свой провайдер задаёт издателя").ЭтоИстина();
	Ожидаем.Что(Пресеты.ПолеРазрешено("", "Метка"), "и подпись кнопки").ЭтоИстина();
	Ожидаем.Что(Пресеты.ПолеРазрешено("", "Значок"), "и значок").ЭтоИстина();
	Ожидаем.Что(Пресеты.ПолеРазрешено("", "БазовыйАдрес"),
		"а вот адрес инсталляции — поле GitLab, у своего его нет").ЭтоЛожь();

	Ожидаем.Что(Пресеты.ПолеРазрешено("github", "Издатель"), "GitHub издателя не отдаёт").ЭтоЛожь();
	Ожидаем.Что(Пресеты.ПолеРазрешено("github", "Метка"), "и подпись кнопки тоже").ЭтоЛожь();

	Ожидаем.Что(Пресеты.ПолеРазрешено("gitlab", "БазовыйАдрес"),
		"GitLab разрешает адрес инсталляции (self-hosted)").ЭтоИстина();
	Ожидаем.Что(Пресеты.УмолчаниеПоля("gitlab", "БазовыйАдрес"),
		"и подставляет gitlab.com").Равно("https://gitlab.com");

	Ожидаем.Что(Пресеты.УмолчаниеПоля("github", "Значок")).Равно("github");
	Ожидаем.Что(Пресеты.УмолчаниеПоля("google", "Значок")).Равно("google");
	Ожидаем.Что(Пресеты.УмолчаниеПоля("", "Значок"),
		"своему провайдеру достаётся обобщённый значок").Равно("key");

КонецПроцедуры

// Поле, которого пресет не показывает, он и не принимает: подделанная форма отбивается.
&Тест
Процедура ЗапрещённоеПресетомПолеНеПринимаетсяДажеПодделаннойФормой() Экспорт

	Данные = ВводПресета("forb" + УникальныеИмена.Хвост(), "github");
	Данные.Вставить("Издатель", "https://evil.example.com");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);

	Ожидаем.Что(Исход.Успех, "издатель в форме пресета — отказ").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Данные.Имя), "строка не появилась").Равно(Неопределено);

	СМеткой = ВводПресета("forb" + УникальныеИмена.Хвост(), "github");
	СМеткой.Вставить("Метка", "Подделанная подпись");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), СМеткой).Успех,
		"подпись кнопки пресету тоже не подсовывается").ЭтоЛожь();

	СБазой = ВводПресета("forb" + УникальныеИмена.Хвост(), "google");
	СБазой.Вставить("БазовыйАдрес", "https://evil.example.com");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), СБазой).Успех,
		"адрес инсталляции разрешён только GitLab").ЭтоЛожь();

	// КОНТРОЛЬ: то же поле у пресета, который его разрешает, принимается
	Контроль = ВводПресета("okbase" + УникальныеИмена.Хвост(), "gitlab");
	Контроль.Вставить("БазовыйАдрес", "https://gitlab.example.com");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Контроль);
	Ожидаем.Что(Исход.Успех, "КОНТРОЛЬ: GitLab адрес инсталляции принимает: " + Исход.Сообщение).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Контроль.Имя).Издатель).Равно("https://gitlab.example.com");

КонецПроцедуры

// Подпись кнопки у пресета — из пресета, и правкой не перебивается: поля на экране нет,
// значит и значения своей жизнью в базе быть не должно.
&Тест
Процедура ПодписьПресетнойКнопкиВсегдаИзПресета() Экспорт

	Имя = "lbl" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Метка).Равно("Google");

	Правка = ВводПресета(Имя, "google");
	Правка.Вставить("Метка", "Руками вписанная подпись");
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Правка).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Метка,
		"правка метки у пресетного провайдера перекрывается пресетом").Равно("Google");

	// КОНТРОЛЬ: у своего провайдера подпись живёт формой
	Свой = "lblown" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную(Свой, "oidc")).Успех).ЭтоИстина();
	ПравкаСвоего = ВводВручную(Свой, "oidc");
	ПравкаСвоего.Вставить("Метка", "Наш вход");
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Свой, ПравкаСвоего).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Свой).Метка).Равно("Наш вход");

КонецПроцедуры

// Поле областей показывают GitLab, Google и свой провайдер с умолчанием пресета. У GitHub поля нет:
// у GitHub App scope игнорируется, у OAuth App области одобряет организация.
&Тест
Процедура ОбластиЗадаютсяТемПресетамКомуЕстьЧтоЗадавать() Экспорт

	Пресеты = Желудь("ПресетыВхода");
	Библиотечные = Новый УмолчанияПресетов();

	Ожидаем.Что(Пресеты.ПолеРазрешено("github", "Область"),
		"GitHub областей не показывает").ЭтоЛожь();

	Для Каждого Ключ Из СтрРазделить("gitlab,google", ",") Цикл
		Ожидаем.Что(Пресеты.ПолеРазрешено(Ключ, "Область"),
			"пресет " + Ключ + " показывает области").ЭтоИстина();
		// сверяемся со ЗНАЧЕНИЕМ библиотеки, а не с литералом: поменяется пресет —
		// поменяется и ожидание, а вот отсебятина хаба поверх пресета покраснеет
		Ожидаем.Что(Пресеты.УмолчаниеПоля(Ключ, "Область"),
			"умолчание формы — это умолчание пресета " + Ключ)
			.Равно(СокрЛП(Строка(Библиотечные.Умолчания(Ключ).Область)));
	КонецЦикла;

	// поле, которого пресет не показывает, он и не принимает — как любое такое поле
	Подделка = ВводПресета("scopegh" + УникальныеИмена.Хвост(), "github");
	Подделка.Вставить("Область", "read:user user:email repo");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Подделка);
	Ожидаем.Что(Исход.Успех, "область в форме GitHub — отказ").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Подделка.Имя), "строка не появилась").Равно(Неопределено);

	// КОНТРОЛЬ: без области тот же ввод заводится, и в записи — области пресета
	ЧистыйGitHub = "scoperh" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ),
		ВводПресета(ЧистыйGitHub, "github")).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(ЧистыйGitHub).Область,
		"GitHub получает ровно то, что просит пресет")
		.Равно(СокрЛП(Строка(Библиотечные.Умолчания("github").Область)));

	// а там, где поле есть, оно и работает: пусто — умолчание, заполнено — своё
	Пустое = "scopegl" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Пустое, "gitlab")).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Пустое).Область,
		"незаполненная графа даёт умолчание пресета")
		.Равно(СокрЛП(Строка(Библиотечные.Умолчания("gitlab").Область)));

	Заданный = "scopeset" + УникальныеИмена.Хвост();
	Данные = ВводПресета(Заданный, "gitlab");
	Данные.Вставить("Область", "openid profile email read_api");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Заданный).Область,
		"заданные администратором области доезжают до записи").Равно("openid profile email read_api");

	// КОНТРОЛЬ: у своего провайдера поле работает так же, а умолчание — своё
	Свой = "scopeown" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную(Свой, "oidc")).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Свой).Область).Равно("openid profile email");

КонецПроцедуры

// Пустая графа областей в форме правки означает «оставить как было»: сохранение без правок
// заданные области не стирает.
&Тест
Процедура ПустаяГрафаОбластейПриПравкеПрежниеНеСтирает() Экспорт

	Имя = "scopeed" + УникальныеИмена.Хвост();
	Данные = ВводПресета(Имя, "gitlab");
	Данные.Вставить("Область", "openid profile email read_api");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех).ЭтоИстина();

	Правка = ВводПресета(Имя, "gitlab");
	Правка.Вставить("Область", "");
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Правка).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Область,
		"пустое поле оставляет прежние области").Равно("openid profile email read_api");

	// КОНТРОЛЬ: непустое поле правкой применяется
	Смена = ВводПресета(Имя, "gitlab");
	Смена.Вставить("Область", "openid profile email");
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Смена).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Область).Равно("openid profile email");

КонецПроцедуры

// Заданные области доезжают до запроса авторизации — их провайдер покажет на экране согласия.
// Провайдер берётся без дискавери, и сеть тесту не нужна.
&Тест
Процедура ЗаданныеОбластиЕдутВЗапросАвторизации() Экспорт

	Имя = "scopeurl" + УникальныеИмена.Хвост();
	Данные = ВводВручную(Имя, "oauth2");
	Данные.Вставить("Область", "openid profile email teams.read");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех).ЭтоИстина();

	Вход = Желудь("КонфигурацияOIDC").Вход(Имя);
	Ожидаем.Что(Вход, "провайдер попал в действующую конфигурацию").Существует();
	Ожидаем.Что(ОбластьЗапросаАвторизации(Вход.Начать().URL),
		"в запросе авторизации ровно то, что задал администратор")
		.Равно("openid profile email teams.read");

	// КОНТРОЛЬ: у GitHub поля нет, и в запрос едут области пресета — без добавок хаба
	Пресетный = "scopegh" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ),
		ВводПресета(Пресетный, "github")).Успех).ЭтоИстина();
	Ожидаем.Что(ОбластьЗапросаАвторизации(Желудь("КонфигурацияOIDC").Вход(Пресетный).Начать().URL),
		"GitHub просит ровно то, что просит пресет")
		.Равно(СокрЛП(Строка(Новый УмолчанияПресетов().Умолчания("github").Область)));

КонецПроцедуры

// Набор полей «своего провайдера» зависит от протокола: при дискавери конечные точки
// берутся из документа издателя, без дискавери издателя назначает хаб.
&Тест
Процедура НаборПолейСвоегоПровайдераЗависитОтПротокола() Экспорт

	Пресеты = Желудь("ПресетыВхода");

	Ожидаем.Что(Пресеты.ПолеРазрешено("", "Издатель", "oidc"),
		"при дискавери издатель задаётся").ЭтоИстина();
	Ожидаем.Что(Пресеты.ПолеОбязательно("", "Издатель", "oidc"),
		"и он обязателен — без него дискавери некуда идти").ЭтоИстина();
	Для Каждого Точка Из СтрРазделить("АдресАвторизации,АдресТокена,АдресПрофиля,АдресEmails", ",") Цикл
		Ожидаем.Что(Пресеты.ПолеРазрешено("", Точка, "oidc"),
			"при дискавери " + Точка + " руками не задаётся").ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Пресеты.ПолеРазрешено("", "Издатель", "oauth2"),
		"без дискавери издателя назначает хаб — поля нет").ЭтоЛожь();
	Для Каждого Точка Из СтрРазделить("АдресАвторизации,АдресТокена,АдресПрофиля", ",") Цикл
		Ожидаем.Что(Пресеты.ПолеОбязательно("", Точка, "oauth2"),
			"без дискавери " + Точка + " обязательна: взять её неоткуда").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(Пресеты.ПолеРазрешено("", "АдресEmails", "oauth2"),
		"адреса почты — необязательная точка, но задаётся").ЭтоИстина();
	Ожидаем.Что(Пресеты.ПолеОбязательно("", "АдресEmails", "oauth2")).ЭтоЛожь();

	// у пресета протокол свой и вводом не переключается
	Ожидаем.Что(Пресеты.ДействующийПротокол("github", "oidc"),
		"пресет GitHub остаётся OAuth2, что бы ни пришло из формы").Равно("oauth2");
	Ожидаем.Что(Пресеты.ДействующийПротокол("", "oauth2")).Равно("oauth2");
	Ожидаем.Что(Пресеты.ДействующийПротокол("", "мусор"),
		"неизвестный протокол — дискавери").Равно("oidc");

КонецПроцедуры

// Пресетные провайдеры: точки и издателя даёт пресет, а не администратор — независимо
// от того, каким протоколом пресет ведётся.
&Тест
Процедура ПресетыНеОтдаютТочкиИИздателяВвода() Экспорт

	Пресеты = Желудь("ПресетыВхода");

	Для Каждого Ключ Из Пресеты.Ключи() Цикл
		Для Каждого Поле Из СтрРазделить("Издатель,АдресАвторизации,АдресТокена,АдресПрофиля,АдресEmails", ",") Цикл
			Ожидаем.Что(Пресеты.ПолеРазрешено(Ключ, Поле),
				СтрШаблон("пресет %1 поле %2 из ввода не берёт", Ключ, Поле)).ЭтоЛожь();
		КонецЦикла;
	КонецЦикла;

	// GitHub ведётся OAuth2 без дискавери — точки обязаны приехать из пресета
	Имя = "ghpts" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "github")).Успех).ЭтоИстина();
	Запись = Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя);
	Ожидаем.Что(Строка(Запись.ВидПротокола)).Равно("oauth2");
	Ожидаем.Что(СтрНайти(Строка(Запись.КонечныеТочки), "github.com") > 0,
		"конечные точки GitHub подставил пресет: " + Строка(Запись.КонечныеТочки)).ЭтоИстина();

КонецПроцедуры

// Сервер первичен: поле чужого протокола отбивается, даже если разметка его не показывала.
&Тест
Процедура ПолеЧужогоПротоколаОтбиваетсяСервером() Экспорт

	// дискавери: конечная точка не принимается
	СТочкой = ВводВручную("dsc" + УникальныеИмена.Хвост(), "oidc");
	СТочкой.Вставить("АдресТокена", "https://idp.example.com/token");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), СТочкой);
	Ожидаем.Что(Исход.Успех, "точка при дискавери — отказ").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, "не относится к протоколу") > 0,
		"отказ назван протоколом, а не пресетом (текст: " + Исход.Сообщение + ")").ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(СТочкой.Имя), "строки не появилось").Равно(Неопределено);

	// без дискавери: издатель не принимается
	СИздателем = ВводВручную("oa" + УникальныеИмена.Хвост(), "oauth2");
	СИздателем.Вставить("Издатель", "https://evil.example.com");
	ИсходИздателя = Сервис_.Завести(Принципалы.Сессия(Админ), СИздателем);
	Ожидаем.Что(ИсходИздателя.Успех, "издатель без дискавери — отказ").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(ИсходИздателя.Сообщение, "не относится к протоколу") > 0,
		"и тоже по протоколу").ЭтоИстина();

	// КОНТРОЛЬ: те же поля в своём протоколе принимаются
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ),
		ВводВручную("okd" + УникальныеИмена.Хвост(), "oidc")).Успех, "КОНТРОЛЬ: дискавери").ЭтоИстина();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ),
		ВводВручную("oko" + УникальныеИмена.Хвост(), "oauth2")).Успех, "КОНТРОЛЬ: oauth2").ЭтоИстина();

КонецПроцедуры

// Издатель при дискавери обязателен: без него провайдер нерабочий, и отказ это называет.
&Тест
Процедура ИздательПриДискавериОбязателен() Экспорт

	Данные = ВводВручную("noiss" + УникальныеИмена.Хвост(), "oidc");
	Данные.Вставить("Издатель", "");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);

	Ожидаем.Что(Исход.Успех, "провайдер без издателя не заводится").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(СтрНайти(НРег(Исход.Сообщение), "издател") > 0,
		"отказ назвал издателя (текст: " + Исход.Сообщение + ")").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Значок

// Ключ значка попадает в разметку адресом картинки: принимается только ключ из списка.
&Тест
Процедура ЗначокПринимаетсяТолькоИзЗакрытогоСписка() Экспорт

	Имя = "ico" + УникальныеИмена.Хвост();
	Данные = ВводВручную(Имя, "oidc");
	Данные.Вставить("Значок", "../../etc/passwd");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);

	Ожидаем.Что(Исход.Успех, "подделанный ключ значка отбивается").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя), "строка не появилась").Равно(Неопределено);

	Чужой = ВводВручную("ico" + УникальныеИмена.Хвост(), "oidc");
	Чужой.Вставить("Значок", "https://evil.example.com/logo.svg");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Чужой).Успех,
		"и произвольный URL — тоже").ЭтоЛожь();

	// КОНТРОЛЬ: ключ из набора принимается и доезжает до карточки
	Хороший = ВводВручную("ico" + УникальныеИмена.Хвост(), "oidc");
	Хороший.Вставить("Значок", "github");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Хороший).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Хороший.Имя).Значок).Равно("github");

КонецПроцедуры

// Значок пресета назначает пресет: поля на экране нет, вводом он не меняется.
&Тест
Процедура ЗначокПресетаБерётсяИзПресета() Экспорт

	Имя = "icop" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "gitlab")).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Значок).Равно("gitlab");

	Подделка = ВводПресета("icop" + УникальныеИмена.Хвост(), "gitlab");
	Подделка.Вставить("Значок", "github");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Подделка).Успех,
		"значок пресету вводом не подсовывается").ЭтоЛожь();

КонецПроцедуры

// Каждому ключу значка соответствует файл, который хаб действительно отдаёт: иначе
// в разметке окажется битая картинка.
&Тест
Процедура УКаждогоКлючаЗначкаЕстьОтдаваемыйФайл() Экспорт

	Активы = Желудь("АктивыСтатики");
	Место = Желудь("РаскладкаСтатики");
	Отдаваемые = Активы.Файлы();

	Пропущенные = Новый Массив();
	Для Каждого Ключ Из Место.КлючиЗначков() Цикл
		Файл = Место.ФайлЗначка(Ключ);
		Если НЕ ЗначениеЗаполнено(Активы.Отпечаток(Файл)) Тогда
			Пропущенные.Добавить(Ключ + ": нет файла на диске");
			Продолжить;
		КонецЕсли;
		Если Отдаваемые.Получить(Активы.ПубличноеИмя(Файл)) = Неопределено Тогда
			Пропущенные.Добавить(Ключ + ": файл не в белом списке отдачи");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "), "ключи значков без файла").Равно("");
	Ожидаем.Что(Активы.Адрес(Место.ФайлЗначка("подделка")),
		"ключ вне списка адреса не даёт").Равно("");
	Ожидаем.Что(СтрНачинаетсяС(Активы.Адрес(Место.ФайлЗначка("github")), "/static/github-"),
		"адрес значка версионирован отпечатком содержимого").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПресетыИСинтетическийИздатель

&Тест
Процедура ПресетGitHubЗаводитсяОднимКликом() Экспорт

	Имя = "github" + УникальныеИмена.Хвост();
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "github"));
	Ожидаем.Что(Исход.Успех, Исход.Сообщение).ЭтоИстина();

	Карточка = Сервис_.КарточкаПоИмени(Имя);
	Ожидаем.Что(Карточка.ВидПротокола, "GitHub ведётся OAuth2-веткой").Равно("oauth2");
	Ожидаем.Что(Карточка.Издатель, "синтетический издатель назначает хаб").Равно("oauth2:github");
	Ожидаем.Что(Карточка.Пресет).Равно("github");
	Ожидаем.Что(СтрНайти(Карточка.Область, "user:email") > 0,
		"области пресета подставлены библиотекой").ЭтоИстина();

	// конфигурация видит провайдера как настоящего — кнопка на /login появится
	Провайдер = Желудь("КонфигурацияOIDC").Провайдер(Имя);
	Ожидаем.Что(Провайдер, "провайдер базы попал в действующую конфигурацию").Существует();
	Ожидаем.Что(Провайдер.Издатель).Равно("oauth2:github");

КонецПроцедуры

// Пресет на пустом client_secret бросает исключение с путями к файлам сервера: администратору
// такой текст не печатается.
&Тест
Процедура ПустойСекретОтвергаетсяБезСлужебногоТекстаБиблиотеки() Экспорт

	Ввод = ВводПресета("github" + УникальныеИмена.Хвост(), "github");
	Ввод.Вставить("СекретКлиента", "");

	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Ввод);
	Ожидаем.Что(Исход.Успех, "пустой client_secret не принимается").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);

	Ожидаем.Что(СтрНайти(Исход.Сообщение, "{Модуль"), "служебной обёртки исключения на экране нет").Равно(0);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, "oscript_modules"), "пути к файлам сервера на экране нет").Равно(0);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, "Error in line"), "координат кадра на экране нет").Равно(0);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, "client_secret") > 0,
		"причина названа словами администратора").ЭтоИстина();

	// КОНТРОЛЬ: тот же ввод с секретом заводится — отличие ровно в пустом секрете
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ),
		ВводПресета("github" + УникальныеИмена.Хвост(), "github")).Успех,
		"КОНТРОЛЬ: с секретом пресет заводится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПресетыGitLabИGoogleИдутOIDCВеткойСНастоящимИздателем() Экспорт

	ИмяGL = "gitlab" + УникальныеИмена.Хвост();
	ИсходGL = Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(ИмяGL, "gitlab"));
	Ожидаем.Что(ИсходGL.Успех, ИсходGL.Сообщение).ЭтоИстина();
	КарточкаGL = Сервис_.КарточкаПоИмени(ИмяGL);
	Ожидаем.Что(КарточкаGL.ВидПротокола).Равно("oidc");
	Ожидаем.Что(КарточкаGL.Издатель).Равно("https://gitlab.com");

	ИмяG = "google" + УникальныеИмена.Хвост();
	ИсходG = Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(ИмяG, "google"));
	Ожидаем.Что(ИсходG.Успех, ИсходG.Сообщение).ЭтоИстина();
	КарточкаG = Сервис_.КарточкаПоИмени(ИмяG);
	Ожидаем.Что(КарточкаG.ВидПротокола).Равно("oidc");
	Ожидаем.Что(КарточкаG.Издатель).Равно("https://accounts.google.com");

КонецПроцедуры

// Пространство синтетических издателей недостижимо из OIDC-ветки: иначе OIDC-провайдер с издателем
// oauth2:github выдавал бы личности, неотличимые от гитхабовских.
&Тест
Процедура OIDCПровайдерНеЗанимаетПространствоСинтетическихИздателей() Экспорт

	Данные = ВводВручную("fake" + УникальныеИмена.Хвост(), "oidc");
	Данные.Вставить("Издатель", "oauth2:github");
	Подделка = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);

	Ожидаем.Что(Подделка.Успех, "издатель из пространства синтетики отвергнут").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Подделка.Сообщение, "oauth2:") > 0,
		"отказ объясняет подделку (текст: " + Подделка.Сообщение + ")").ЭтоИстина();

	Честный = ВводВручную("real" + УникальныеИмена.Хвост(), "oidc");
	Честный.Вставить("Издатель", "https://idp.example.com");
	Контроль = Сервис_.Завести(Принципалы.Сессия(Админ), Честный);
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: настоящий издатель принимается: " + Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

// Ручной OAuth2: издателя назначает хаб по ХОСТУ точки авторизации — переименование провайдера не рвёт привязки.
&Тест
Процедура СинтетическийИздательСтроитсяПоХостуАНеПоИмени() Экспорт

	Первый = ВводВручную("one" + УникальныеИмена.Хвост(), "oauth2");
	Второй = ВводВручную("two" + УникальныеИмена.Хвост(), "oauth2");

	ИсходА = Сервис_.Завести(Принципалы.Сессия(Админ), Первый);
	ИсходБ = Сервис_.Завести(Принципалы.Сессия(Админ), Второй);
	Ожидаем.Что(ИсходА.Успех, ИсходА.Сообщение).ЭтоИстина();
	Ожидаем.Что(ИсходБ.Успех, ИсходБ.Сообщение).ЭтоИстина();

	А = Сервис_.КарточкаПоИмени(Первый.Имя);
	Б = Сервис_.КарточкаПоИмени(Второй.Имя);
	Ожидаем.Что(А.Издатель).Равно("oauth2:idp.example.com");
	Ожидаем.Что(Б.Издатель, "имя строки на издателя не влияет").Равно(А.Издатель);

КонецПроцедуры

&Тест
Процедура OAuth2БезРучныхТочекНеЗаводится() Экспорт

	Данные = ВводВручную("nop" + УникальныеИмена.Хвост(), "oauth2");
	Данные.Вставить("АдресТокена", "");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);

	Ожидаем.Что(Исход.Успех, "у OAuth2 discovery нет — точка токена обязательна").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);

	// КОНТРОЛЬ: тот же ввод с точкой токена принимается
	Контроль = Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную("yes" + УникальныеИмена.Хвост(), "oauth2"));
	Ожидаем.Что(Контроль.Успех, Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СинтетикуНельзяПодсунутьOIDCПровайдеруНиПриЗаведенииНиПриПравке() Экспорт

	Имя = "syn" + УникальныеИмена.Хвост();

	Заведение = ВводВручную(Имя, "oidc");
	Заведение.Вставить("Издатель", "oauth2:github");
	Отказ_ = Сервис_.Завести(Принципалы.Сессия(Админ), Заведение);
	Ожидаем.Что(Отказ_.Успех, "oidc с синтетическим издателем не заводится").ЭтоЛожь();
	Ожидаем.Что(Отказ_.Код).Равно(400);

	// КОНТРОЛЬ: тот же ввод с настоящим https-издателем проходит
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную(Имя, "oidc")).Успех,
		"КОНТРОЛЬ: настоящий издатель принимается").ЭтоИстина();

	// правкой: разбор правки издателя из ввода не читает вовсе, поэтому проверяется результат —
	// запрос проходит, а издатель остаётся прежним
	Правка = ВводВручную(Имя, "oidc");
	Правка.Вставить("Издатель", "oauth2:github");
	Подмена = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Правка);
	Ожидаем.Что(Подмена.Успех, "своя форма правки сохраняется: " + Подмена.Сообщение).ЭтоИстина();
	Ожидаем.Что(Строка(Сервис_.КарточкаПоИмени(Имя).Издатель),
		"издатель не подменён").Равно("https://idp.example.com");
	Ожидаем.Что(Строка(Сервис_.КарточкаПоИмени(Имя).ВидПротокола),
		"и вид протокола не подменён").Равно("oidc");

	// и вариациями регистра/пробелов
	Для Каждого Вариант Из СтрРазделить("OAUTH2:github, oauth2:github ,OAuth2:GitHub", ",") Цикл
		Хитрая = ВводВручную(Имя + "z", "oidc");
		Хитрая.Вставить("Издатель", Вариант);
		Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Хитрая).Успех,
			"вариант <" + Вариант + "> тоже отбивается").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура РучнойOAuth2НеЗанимаетПространствоПресета() Экспорт

	Пресетный = "ghp" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Пресетный, "github")).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Пресетный).Издатель,
		"КОНТРОЛЬ: пресет держит oauth2:github").Равно("oauth2:github");

	Подделка = "fake" + УникальныеИмена.Хвост();
	Данные = ВводВручную(Подделка, "oauth2");
	Данные.Вставить("АдресАвторизации", "https://github/login/oauth/authorize");
	Данные.Вставить("АдресТокена", "https://github/login/oauth/access_token");
	Данные.Вставить("АдресПрофиля", "https://github/user");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);

	Полученный = ?(Исход.Успех, Строка(Сервис_.КарточкаПоИмени(Подделка).Издатель), "<отбито>");
	Ожидаем.Что(Полученный = "oauth2:github",
		"ручной провайдер занял пространство пресета GitHub (издатель: " + Полученный + ")").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДваРучныхOAuth2СОднимХостомДелятИздателя() Экспорт

	Первый = "h1" + УникальныеИмена.Хвост();
	Второй = "h2" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную(Первый, "oauth2")).Успех,
		"первый ручной oauth2 заводится").ЭтоИстина();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную(Второй, "oauth2")).Успех,
		"второй ручной oauth2 с тем же хостом заводится").ЭтоИстина();

	Ожидаем.Что(Строка(Сервис_.КарточкаПоИмени(Первый).Издатель))
		.Равно(Строка(Сервис_.КарточкаПоИмени(Второй).Издатель));

КонецПроцедуры

&Тест
Процедура ИздательПресетаНеЗависитОтИмениСтроки() Экспорт

	Первое = "gh1" + УникальныеИмена.Хвост();
	Второе = "gh2" + УникальныеИмена.Хвост();
	Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Первое, "github"));
	Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Второе, "github"));

	Ожидаем.Что(Строка(Сервис_.КарточкаПоИмени(Первое).Издатель)).Равно("oauth2:github");
	Ожидаем.Что(Строка(Сервис_.КарточкаПоИмени(Второе).Издатель)).Равно("oauth2:github");

КонецПроцедуры

&Тест
Процедура ЗамокПространстваПресетовДержитВсеКлючиМимоГейта() Экспорт

	Пресеты = Желудь("ПресетыВхода");
	Издатели = Желудь("ИздателиOAuth2");

	Провалы = "";
	Для Каждого Ключ Из Пресеты.Ключи() Цикл
		Ошибка = "";
		Попытка
			Полученный = Издатели.ИздательПоАдресуАвторизации(
				"https://" + Ключ + "/authorize", Пресеты.Ключи());
		Исключение
			Ошибка = ОписаниеОшибки();
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(Ошибка) Тогда
			Провалы = Провалы + Символы.ПС + Ключ + " → " + Полученный;
		КонецЕсли;
	КонецЦикла;

	// КОНТРОЛЬ: обычный хост издателя получает, то есть замок не «отказывать всегда»
	Обычный = Издатели.ИздательПоАдресуАвторизации(
		"https://idp.example.com/authorize", Пресеты.Ключи());
	Ожидаем.Что(Обычный, "КОНТРОЛЬ: обычный хост даёт издателя").Равно("oauth2:idp.example.com");

	Ожидаем.Что(Провалы, "ключи пресетов, доступные ручному провайдеру:" + Провалы).Равно("");

КонецПроцедуры

#КонецОбласти

#Область SSRF

&Тест
Процедура АдресПровайдераВоВнутреннейСетиОтвергается() Экспорт

	// адрес сервиса метаданных облака записью, а не именем: имён хаб не разрешает
	Плохой = ВводВручную("bad" + УникальныеИмена.Хвост(), "oauth2");
	Плохой.Вставить("АдресТокена", "https://169.254.169.254/token");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Плохой);

	Ожидаем.Что(Исход.Успех, "точка токена в link-local отвергнута").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);

	// КОНТРОЛЬ: тот же провайдер с публичной точкой токена заводится
	Контроль = Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную("good" + УникальныеИмена.Хвост(), "oauth2"));
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: публичный адрес принимается: " + Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АдресаПровайдераТолькоHTTPS() Экспорт

	Плохой = ВводВручную("http" + УникальныеИмена.Хвост(), "oauth2");
	Плохой.Вставить("АдресПрофиля", "http://idp.example.com/user");
	Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Плохой);
	Ожидаем.Что(Исход.Успех, "http для точки провайдера запрещён").ЭтоЛожь();

	СUserinfo = ВводВручную("ui" + УникальныеИмена.Хвост(), "oauth2");
	СUserinfo.Вставить("АдресПрофиля", "https://user@idp.example.com/user");
	ИсходUI = Сервис_.Завести(Принципалы.Сессия(Админ), СUserinfo);
	Ожидаем.Что(ИсходUI.Успех, "userinfo в адресе запрещён").ЭтоЛожь();

	// КОНТРОЛЬ: отличается ровно схемой и отсутствием userinfo
	Контроль = Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную("https" + УникальныеИмена.Хвост(), "oauth2"));
	Ожидаем.Что(Контроль.Успех, Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АдресВозвратаТолькоHTTPSИлиLocalhost() Экспорт

	Валидатор = СобратьВалидатор();

	Ожидаем.Что(Валидатор.ПроверитьАдресВозврата("https://hub.example.com/oidc/callback").Успех,
		"обычный https принимается").ЭтоИстина();
	Ожидаем.Что(Валидатор.ПроверитьАдресВозврата("http://localhost:8080/oidc/callback").Успех,
		"http на localhost — разработческий сценарий").ЭтоИстина();
	Ожидаем.Что(Валидатор.ПроверитьАдресВозврата("http://hub.example.com/oidc/callback").Успех,
		"http в открытую сеть отдал бы код авторизации соседу").ЭтоЛожь();
	Ожидаем.Что(Валидатор.ПроверитьАдресВозврата("javascript:alert(1)").Успех,
		"чужая схема не проходит").ЭтоЛожь();
	Ожидаем.Что(Валидатор.ПроверитьАдресВозврата("https://a@hub.example.com/cb").Успех,
		"userinfo не проходит").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПриватныеАдресаВоВсехФормахЗаписиОтбиваются() Экспорт

	Формы = Новый Массив();
	Формы.Добавить("https://0.0.0.0/authorize");
	Формы.Добавить("https://[::1]/authorize");
	Формы.Добавить("https://[::ffff:127.0.0.1]/authorize");
	Формы.Добавить("https://2130706433/authorize");     // десятичный 127.0.0.1
	Формы.Добавить("https://0177.0.0.1/authorize");     // восьмеричный 127.0.0.1
	Формы.Добавить("https://127.1/authorize");          // сокращённая форма
	Формы.Добавить("https://localhost/authorize");
	Формы.Добавить("https://[fd00::1]/authorize");      // ULA
	Формы.Добавить("https://169.254.169.254/latest");   // метаданные облака
	Формы.Добавить("https://[fe80::1]/authorize");      // link-local IPv6

	Провалы = "";
	Для Каждого Адрес Из Формы Цикл
		Проверка = СобратьВалидатор().ПроверитьТочку(Адрес, "точка");
		Если Проверка.Успех Тогда
			Провалы = Провалы + Символы.ПС + Адрес;
		КонецЕсли;
	КонецЦикла;

	// КОНТРОЛЬ: публичный адрес проходит — отличие ровно в адресе
	Ожидаем.Что(СобратьВалидатор().ПроверитьТочку("https://idp.example.com/authorize", "точка").Успех,
		"КОНТРОЛЬ: публичный https проходит").ЭтоИстина();

	Ожидаем.Что(Провалы, "приватные адреса, проехавшие гейт:" + Провалы).Равно("");

КонецПроцедуры

// Гейт провайдера входа спрашивает ту же политику «своя сеть», что и издатель конвейера,
// и её вердикт своим не подменяет.
&Тест
Процедура КомпозицияНеОслабилаПолитикуСвоейСети() Экспорт

	Политика = Новый СвояСеть(Желудь("КанонIP"));
	Ожидаем.Что(Политика.ЭтоСвояСеть("127.0.0.1"), "политика узнаёт петлю").ЭтоИстина();
	Ожидаем.Что(Политика.Вердикт("2130706433").Код,
		"нестрогая запись — не адрес, а не «имя»").Равно(Политика.Коды().НеАдрес);
	Ожидаем.Что(Политика.ЭтоСвояСеть("example.com"), "КОНТРОЛЬ: публичное имя не своё").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура АдресВозвратаНеОбходитсяСоседямиLocalhost() Экспорт

	Плохие = Новый Массив();
	Плохие.Добавить("http://localhost.evil.com/cb");
	Плохие.Добавить("http://evil.com#localhost/cb");
	Плохие.Добавить("http://user@localhost/cb");
	Плохие.Добавить("javascript:alert(1)");
	Плохие.Добавить("data://localhost/cb");
	Плохие.Добавить("http://127.1/cb");        // нестрогая запись петли — не адрес
	Плохие.Добавить("http://2130706433/cb");   // она же одним числом
	Плохие.Добавить("http://10.0.0.5/cb");     // своя сеть, но не петля
	Плохие.Добавить("http://169.254.169.254/cb");
	Плохие.Добавить("//localhost/cb");

	Провалы = "";
	Для Каждого Адрес Из Плохие Цикл
		Если СобратьВалидатор().ПроверитьАдресВозврата(Адрес).Успех Тогда
			Провалы = Провалы + Символы.ПС + Адрес;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СобратьВалидатор().ПроверитьАдресВозврата("http://localhost:8080/cb").Успех,
		"КОНТРОЛЬ: http на localhost разрешён").ЭтоИстина();
	Ожидаем.Что(СобратьВалидатор().ПроверитьАдресВозврата("https://hub.example.com/cb").Успех,
		"КОНТРОЛЬ: https разрешён").ЭтоИстина();
	// петлю у адреса возврата судит та же политика, что и остальные двери, а не три литерала
	// «localhost», «127.0.0.1», «::1»
	Ожидаем.Что(СобратьВалидатор().ПроверитьАдресВозврата("http://127.0.0.2:8080/cb").Успех,
		"соседний адрес петли — та же петля").ЭтоИстина();
	Ожидаем.Что(СобратьВалидатор().ПроверитьАдресВозврата("http://[::ffff:127.0.0.1]/cb").Успех,
		"отображённая петля — та же петля").ЭтоИстина();

	Ожидаем.Что(Провалы, "адреса возврата, проехавшие гейт:" + Провалы).Равно("");

КонецПроцедуры

&Тест
Процедура УправляющиеСимволыОтбиваютсяВезде() Экспорт

	Ядовитый = "https://idp.example.com/authorize" + Символы.ВК + Символы.ПС + "X-Inject: 1";
	Ожидаем.Что(СобратьВалидатор().ПроверитьТочку(Ядовитый, "точка").Успех, "точка").ЭтоЛожь();
	Ожидаем.Что(СобратьВалидатор().ПроверитьАдресВозврата(Ядовитый).Успех, "возврат").ЭтоЛожь();
	Ожидаем.Что(СобратьВалидатор().ПроверитьИздателя(Ядовитый, "oidc").Успех, "издатель").ЭтоЛожь();

	// КОНТРОЛЬ: тот же адрес без управляющих символов проходит все три
	Чистый = "https://idp.example.com/authorize";
	Ожидаем.Что(СобратьВалидатор().ПроверитьТочку(Чистый, "точка").Успех, "КОНТРОЛЬ точка").ЭтоИстина();
	Ожидаем.Что(СобратьВалидатор().ПроверитьАдресВозврата(Чистый).Успех, "КОНТРОЛЬ возврат").ЭтоИстина();
	Ожидаем.Что(СобратьВалидатор().ПроверитьИздателя(Чистый, "oidc").Успех, "КОНТРОЛЬ издатель").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаНеПроноситПриватныйАдрес() Экспорт

	Имя = "ssrf" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводВручную(Имя, "oidc")).Успех).ЭтоИстина();

	// Как и с издателем выше: конечные точки правкой не читаются вовсе, поэтому пронести
	// приватный адрес нечем. Проверяем РЕЗУЛЬТАТ — в строке его нет ни при каком исходе.
	Правка = ВводВручную(Имя, "oidc");
	Правка.Вставить("АдресТокена", "https://169.254.169.254/latest/meta-data/");
	Исход = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Правка);

	Запись = Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя);
	Ожидаем.Что(СтрНайти(Строка(Запись.КонечныеТочки), "169.254"),
		"адрес не записался (исход правки: " + ?(Исход.Успех, "успех", Исход.Сообщение) + ")").Равно(0);

	// КОНТРОЛЬ: тот же адрес ПРИ ЗАВЕДЕНИИ отбивается гейтом — то есть проверка адресов
	// жива, а не «в правке нечего проверять, потому что нигде не проверяют»
	Плохой = ВводВручную("ssrf2" + УникальныеИмена.Хвост(), "oidc");
	Плохой.Вставить("АдресТокена", "https://169.254.169.254/latest/meta-data/");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Плохой).Успех,
		"КОНТРОЛЬ: при заведении приватный адрес отбит").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтказПоОдносложномуХостуНеЗадеваетЗаконныеАдреса() Экспорт

	Валидатор = СобратьВалидатор();

	Законные = Новый Массив();
	Законные.Добавить("https://idp.example.com/authorize");
	Законные.Добавить("https://idp.example.com:8443/authorize");
	Законные.Добавить("https://accounts.google.com/o/oauth2/v2/auth");
	Законные.Добавить("https://gitlab.io/oauth/authorize");
	Законные.Добавить("https://a.bc/authorize");

	Отбитые = "";
	Для Каждого Адрес Из Законные Цикл
		Проверка = Валидатор.ПроверитьТочку(Адрес, "точка");
		Если НЕ Проверка.Успех Тогда
			Отбитые = Отбитые + Символы.ПС + Адрес + " → " + Проверка.Сообщение;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Отбитые, "законные адреса, отбитые правилом однословного хоста:" + Отбитые).Равно("");

	// КОНТРОЛЬ: однословный хост по-прежнему отбивается, и отказ назван своим именем
	Однословный = Валидатор.ПроверитьТочку("https://github/login/oauth/authorize", "точка");
	Ожидаем.Что(Однословный.Успех, "однословный хост отбит").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Однословный.Сообщение, "github") > 0,
		"отказ называет хост (текст: " + Однословный.Сообщение + ")").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Секреты

&Тест
Процедура СекретНеВыходитНаружуИНеТеряетсяПриПравке() Экспорт

	Имя = "sec" + УникальныеИмена.Хвост();
	Данные = ВводПресета(Имя, "github");
	Данные.Вставить("СекретКлиента", "s3cr3t-значение");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех).ЭтоИстина();

	Карточка = Сервис_.КарточкаПоИмени(Имя);
	Ожидаем.Что(Карточка.Секрет, "карточка отдаёт маску").Равно(Сервис_.МаскаСекрета());
	Ожидаем.Что(Карточка.СекретЗадан).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрокойВсёПоле(Карточка), "s3cr3t-значение"),
		"настоящего секрета в карточке нет ни в одном поле").Равно(0);

	// правка БЕЗ ввода секрета (в поле формы стояла маска) прежний секрет сохраняет
	Правка = ВводПресета(Имя, "github");
	Правка.Вставить("СекретКлиента", "");
	Правка.Вставить("Область", "openid profile");
	Исход = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Правка);
	Ожидаем.Что(Исход.Успех, Исход.Сообщение).ЭтоИстина();

	Запись = Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя);
	Ожидаем.Что(Строка(Запись.СекретКлиента), "пустое поле оставляет прежний секрет").Равно("s3cr3t-значение");
	Ожидаем.Что(Строка(Запись.Область), "изменяемое поле правкой применилось").Равно("openid profile");

	// а маска, введённая как значение, секретом НЕ становится
	СМаской = ВводПресета(Имя, "github");
	СМаской.Вставить("СекретКлиента", Сервис_.МаскаСекрета());
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, СМаской).Успех).ЭтоИстина();
	Ожидаем.Что(Строка(Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя).СекретКлиента),
		"маска не записывается как секрет").Равно("s3cr3t-значение");

	// а новое непустое значение — записывается (контроль «правка вообще работает»)
	Свежий = ВводПресета(Имя, "github");
	Свежий.Вставить("СекретКлиента", "другой-секрет");
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Свежий).Успех).ЭтоИстина();
	Ожидаем.Что(Строка(Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя).СекретКлиента)).Равно("другой-секрет");

КонецПроцедуры

&Тест
Процедура АудитПишетМаскуАНеСекрет() Экспорт

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПровайдерВходаИзменён(), Слушатель);

	Имя = "aud" + УникальныеИмена.Хвост();
	Данные = ВводПресета(Имя, "github");
	Данные.Вставить("СекретКлиента", "тайна-аудита");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех).ЭтоИстина();

	Событие = Слушатель.Первое(Издатель.ТипПровайдерВходаИзменён());
	Ожидаем.Что(Событие, "заведение провайдера — событие аудита").Существует();
	Ожидаем.Что(Строка(Событие.Данные.Кто)).Равно("root7d");
	Ожидаем.Что(Строка(Событие.Данные.Объект), "объект — провайдер, а не голое имя").Равно("провайдер/" + Имя);
	Ожидаем.Что(СтрНайти(Строка(Событие.Данные.ДеталиJSON), "тайна-аудита"),
		"секрета в журнале нет").Равно(0);
	Ожидаем.Что(СтрНайти(Строка(Событие.Данные.ДеталиJSON), Сервис_.МаскаСекрета()) > 0,
		"вместо секрета — маска").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекретНеВсплываетНиВКарточкахНиВСпискеПровайдеров() Экспорт

	Имя = "leak" + УникальныеИмена.Хвост();
	Данные = ВводПресета(Имя, "github");
	Данные.Вставить("СекретКлиента", "СУПЕР-ТАЙНА-7D");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех).ЭтоИстина();

	Всё = "";
	Для Каждого Карточка Из Сервис_.Карточки() Цикл
		Всё = Всё + "|" + СтрокойВсёПоле(Карточка);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Всё, "СУПЕР-ТАЙНА-7D"), "секрета нет в списке карточек").Равно(0);

	// действующая конфигурация секрет ЗНАЕТ (он нужен token endpoint) — но это не
	// внешняя поверхность; проверяем, что наружу его отдаёт только карточка маской
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Секрет).Равно(Сервис_.МаскаСекрета());

КонецПроцедуры

&Тест
Процедура АудитНеПишетСекретНиНаУспехеНиНаОтказе() Экспорт

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПровайдерВходаИзменён(), Слушатель);

	Имя = "adt" + УникальныеИмена.Хвост();
	Плохие = ВводПресета(Имя, "github");
	Плохие.Вставить("СекретКлиента", "ТАЙНА-ОТКАЗА");
	Плохие.Вставить("АдресВозврата", "http://evil.example.com/cb"); // отказ валидации
	Отказ_ = Сервис_.Завести(Принципалы.Сессия(Админ), Плохие);
	Ожидаем.Что(Отказ_.Успех, "ввод отбит валидацией").ЭтоЛожь();

	// КОНТРОЛЬ: тот же ввод с корректным адресом возврата проходит
	Хорошие = ВводПресета(Имя, "github");
	Хорошие.Вставить("СекретКлиента", "ТАЙНА-УСПЕХА");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Хорошие).Успех,
		"КОНТРОЛЬ: корректный ввод проходит").ЭтоИстина();

	Журнал = "";
	Для Каждого Событие Из Слушатель.События Цикл
		Журнал = Журнал + "|" + Строка(Событие.Данные.ДеталиJSON);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Журнал, "ТАЙНА-ОТКАЗА"), "секрета отказа в журнале нет").Равно(0);
	Ожидаем.Что(СтрНайти(Журнал, "ТАЙНА-УСПЕХА"), "секрета успеха в журнале нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОкружениеПерекрываетБазу

// env — override: строка базы, перекрытая переменными окружения, в действующей конфигурации не участвует.
&Тест
Процедура ОкружениеПерекрываетПровайдераБазы() Экспорт

	Имя = "ovr" + УникальныеИмена.Хвост();
	Данные = ВводПресета(Имя, "gitlab");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех).ЭтоИстина();

	// КОНТРОЛЬ: пока перекрытия нет — действует строка базы
	ДоПерекрытия = Желудь("КонфигурацияOIDC").Провайдер(Имя);
	Ожидаем.Что(ДоПерекрытия.Издатель, "КОНТРОЛЬ: без окружения действует база").Равно("https://gitlab.com");
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Перекрыт).ЭтоЛожь();
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя).Редактируемая).ЭтоИстина();

	// а теперь тот же ключ объявлен «окружением» (программный оверрайд — та же дорога)
	Оверрайд = Новый Структура();
	Оверрайд.Вставить("Имя", Имя);
	Оверрайд.Вставить("Издатель", "https://idp-env.test/realms/main");
	Оверрайд.Вставить("ИдентификаторКлиента", "из-окружения");
	Оверрайд.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Оверрайд);

	Действующий = Желудь("КонфигурацияOIDC").Провайдер(Имя);
	Ожидаем.Что(Действующий.Издатель, "окружение перекрывает базу целиком").Равно("https://idp-env.test/realms/main");
	Ожидаем.Что(Действующий.ИдентификаторКлиента).Равно("из-окружения");

	Карточка = Сервис_.КарточкаПоИмени(Имя);
	Ожидаем.Что(Карточка.Перекрыт, "карточка честно говорит, что строка не действует").ЭтоИстина();
	Ожидаем.Что(Карточка.Редактируемая, "перекрытая строка из UI не правится").ЭтоЛожь();
	Ожидаем.Что(Карточка.Источник).Равно("конфиг");

КонецПроцедуры

&Тест
Процедура ВыключенныйПровайдерИсчезаетСоСтраницыВхода() Экспорт

	Имя = "off" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();
	Ожидаем.Что(Желудь("КонфигурацияOIDC").Провайдер(Имя), "включённый виден").Существует();

	Ожидаем.Что(Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Ложь).Успех).ЭтоИстина();
	Ожидаем.Что(Желудь("КонфигурацияOIDC").Провайдер(Имя),
		"выключенный не показывается и возврат от IdP не принимает").Равно(Неопределено);

	// КОНТРОЛЬ: включение возвращает его на страницу входа
	Ожидаем.Что(Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Истина).Успех).ЭтоИстина();
	Ожидаем.Что(Желудь("КонфигурацияOIDC").Провайдер(Имя)).Существует();

КонецПроцедуры

&Тест
Процедура УдалениеСнимаетПровайдераАПовторноеУдалениеОтвечает404() Экспорт

	Имя = "del" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	Первое = Сервис_.Удалить(Принципалы.Сессия(Админ), Имя);
	Ожидаем.Что(Первое.Успех).ЭтоИстина();
	Ожидаем.Что(Желудь("КонфигурацияOIDC").Провайдер(Имя)).Равно(Неопределено);

	Второе = Сервис_.Удалить(Принципалы.Сессия(Админ), Имя);
	Ожидаем.Что(Второе.Успех).ЭтоЛожь();
	Ожидаем.Что(Второе.Код).Равно(404);

КонецПроцедуры

#КонецОбласти

#Область КэшКонфигурацииИОтказы

// Реестр пересобирается по признаку устаревания, а не на каждом чтении: запись мимо сервиса
// не видна, изменение через сервис действует сразу.
&Тест
Процедура КонфигурацияПересобираетсяПоПризнакуИзменения() Экспорт

	Имя = "кеш" + УникальныеИмена.Хвост();
	Имя = СтрЗаменить(Имя, "кеш", "cache");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();
	Ожидаем.Что(Желудь("КонфигурацияOIDC").Провайдер(Имя),
		"мутация через сервис действует немедленно").Существует();

	// запись МИМО сервиса: конфигурация о ней не знает, пока её не попросили перечитать
	Хранилище = Желудь("ХранилищеПровайдеровВхода");
	Мимо = "bypass" + УникальныеИмена.Хвост();
	Запись = Хранилище.СоздатьЗапись(Мимо);
	Запись.ВидПротокола = "oidc";
	Запись.Издатель = "https://idp.example.com";
	Запись.ИдентификаторКлиента = "cid";
	Запись.АдресВозврата = "https://hub.example.com/cb";
	Запись.Включён = Истина;
	Хранилище.Записать(Запись, "тест", ТекущаяУниверсальнаяДата());

	Ожидаем.Что(Желудь("КонфигурацияOIDC").Провайдер(Мимо),
		"чтение не ходит в таблицу, пока источник не объявил себя изменившимся").Равно(Неопределено);

	Желудь("КонфигурацияOIDC").Перечитать();
	Ожидаем.Что(Желудь("КонфигурацияOIDC").Провайдер(Мимо),
		"после Перечитать строка видна").Существует();

КонецПроцедуры

// Отказ — тоже событие: журнал без попыток входа даёт неверную картину «никто не подбирался».
&Тест
Процедура ОтказВУправленииПровайдерамиПопадаетВАудит() Экспорт

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПровайдерВходаИзменён(), Слушатель);
	ДоОтказа = Слушатель.Количество(Издатель.ТипПровайдерВходаИзменён());

	Ключ = Принципалы.Ключ(Админ, "read,write", 0);
	Исход = Сервис_.Завести(Ключ, ВводПресета("audf" + УникальныеИмена.Хвост(), "google"));
	Ожидаем.Что(Исход.Успех, "КОНТРОЛЬ: ключ отбит").ЭтоЛожь();

	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПровайдерВходаИзменён()) > ДоОтказа,
		"отказ по правам записан в журнал").ЭтоИстина();

	Событие = Слушатель.Первое(Издатель.ТипПровайдерВходаИзменён());
	Ожидаем.Что(Событие, "событие есть").Существует();
	Ожидаем.Что(Строка(Событие.Данные.Действие), "действие названо отказом").Равно("провайдер.отказ");
	Ожидаем.Что(СтрНайти(Строка(Событие.Данные.ДеталиJSON), "ключ") > 0,
		"в деталях назван способ обращения").ЭтоИстина();

КонецПроцедуры

// Перекрытая окружением строка правке и переключению не подлежит, и отказ это ГОВОРИТ; удаление разрешено.
&Тест
Процедура ПерекрытаяОкружениемСтрокаНеПравитсяНоУдаляется() Экспорт

	Имя = "lock" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	// КОНТРОЛЬ: пока перекрытия нет — правка и переключение проходят
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, ВводПресета(Имя, "google")).Успех,
		"КОНТРОЛЬ: без перекрытия правка проходит").ЭтоИстина();
	Ожидаем.Что(Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Ложь).Успех,
		"КОНТРОЛЬ: без перекрытия переключение проходит").ЭтоИстина();

	Оверрайд = Новый Структура();
	Оверрайд.Вставить("Имя", Имя);
	Оверрайд.Вставить("Издатель", "https://idp-env.test/realms/main");
	Оверрайд.Вставить("ИдентификаторКлиента", "из-окружения");
	Оверрайд.Вставить("АдресВозврата", "https://hub.test/oidc/callback");
	Желудь("КонфигурацияOIDC").ДобавитьПровайдер(Оверрайд);

	Правка = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, ВводПресета(Имя, "google"));
	Ожидаем.Что(Правка.Успех, "перекрытая строка не правится").ЭтоЛожь();
	Ожидаем.Что(Правка.Код).Равно(409);

	Тумблер = Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Истина);
	Ожидаем.Что(Тумблер.Успех, "и не переключается").ЭтоЛожь();
	Ожидаем.Что(Тумблер.Код).Равно(409);

	Ожидаем.Что(Сервис_.Удалить(Принципалы.Сессия(Админ), Имя).Успех,
		"а удалить мёртвую строку можно — это уборка, а не изменение входа").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КэшКонфигурацииСтабиленДоМутацииИСвежПосле() Экспорт

	Конфигурация = Желудь("КонфигурацияOIDC");
	Имя = "cache" + УникальныеИмена.Хвост();

	Ожидаем.Что(Конфигурация.Провайдер(Имя), "до заведения провайдера нет").Равно(Неопределено);

	// СТОРОНА «СВЕЖЕСТЬ»: изменение видно следующим же чтением, без рестарта
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();
	Ожидаем.Что(Конфигурация.Провайдер(Имя), "заведение видно сразу").Существует();

	Ожидаем.Что(Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Ложь).Успех).ЭтоИстина();
	Ожидаем.Что(Конфигурация.Провайдер(Имя), "выключение видно сразу").Равно(Неопределено);

	Ожидаем.Что(Сервис_.Переключить(Принципалы.Сессия(Админ), Имя, Истина).Успех).ЭтоИстина();
	Ожидаем.Что(Конфигурация.Провайдер(Имя), "включение видно сразу").Существует();

	// СТОРОНА «СТАБИЛЬНОСТЬ»: без изменений конфигурация не пересобирается, и читатель видит
	// тот же объект — иначе каждый запрос получал бы новый снимок
	Первый = Конфигурация.Вход(Имя);
	Второй = Конфигурация.Вход(Имя);
	Ожидаем.Что(Первый = Второй, "без мутаций вход — тот же объект").ЭтоИстина();

	// а после изменения — ДРУГОЙ объект (подмена ссылки, а не чистка на месте)
	Ожидаем.Что(Сервис_.Удалить(Принципалы.Сессия(Админ), Имя).Успех).ЭтоИстина();
	Ожидаем.Что(Конфигурация.Вход(Имя) = Первый,
		"после мутации конфигурация пересобрана новыми объектами").ЭтоЛожь();
	Ожидаем.Что(Конфигурация.Провайдер(Имя), "удаление видно сразу").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ВалидацияИмени

&Тест
Процедура ИмяПровайдераОграниченоАлфавитомАдреса() Экспорт

	Плохие = Новый Массив();
	Плохие.Добавить("");
	Плохие.Добавить("a");
	Плохие.Добавить("имя");
	Плохие.Добавить("with space");
	Плохие.Добавить("-lead");
	Плохие.Добавить("trail-");
	Плохие.Добавить("sla/sh");

	Для Каждого Плохое Из Плохие Цикл
		Данные = ВводПресета(Плохое, "google");
		Исход = Сервис_.Завести(Принципалы.Сессия(Админ), Данные);
		Ожидаем.Что(Исход.Успех, СтрШаблон("имя ""%1"" принято, а не должно", Плохое)).ЭтоЛожь();
	КонецЦикла;

	// КОНТРОЛЬ: допустимое имя, отличающееся ровно алфавитом, проходит
	Хорошее = "ok-name" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Хорошее, "google")).Успех,
		"КОНТРОЛЬ: допустимое имя принимается").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗанятоеИмяНеЗаводитсяДважды() Экспорт

	Имя = "twice" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	Повтор = Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google"));
	Ожидаем.Что(Повтор.Успех, "имя занято").ЭтоЛожь();
	Ожидаем.Что(Повтор.Код).Равно(400);

	// КОНТРОЛЬ: соседнее имя заводится — отличие ровно в занятости
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя + "b", "google")).Успех).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПереименованиеЧерезПравкуОтбивается() Экспорт

	Имя = "ren" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "google")).Успех).ЭтоИстина();

	Правка = ВводПресета(Имя, "google");
	Правка.Вставить("Имя", Имя + "new");
	Исход = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Правка);
	Ожидаем.Что(Исход.Успех, "переименование отбивается").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(Сервис_.КарточкаПоИмени(Имя + "new"), "новой строки не появилось").Равно(Неопределено);

	// КОНТРОЛЬ: тот же save без смены имени проходит
	Ожидаем.Что(Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, ВводПресета(Имя, "google")).Успех,
		"КОНТРОЛЬ: правка без переименования проходит").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПравкаФормойАдминки

&Тест
Процедура ПравкаФормойАдминкиСохраняетПровайдера() Экспорт

	Имя = "edit" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "github")).Успех,
		"КОНТРОЛЬ: пресет заводится").ЭтоИстина();

	Форма = ВводФормыПравки(Имя);
	Форма.Вставить("Метка", "Подпись из формы");
	Исход = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Форма);

	Ожидаем.Что(Исход.Успех,
		"правка тем ТЕЛОМ, что шлёт форма админки, обязана проходить (код "
		+ Исход.Код + ", ошибка: " + Исход.Сообщение + ")").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаФормойНеМеняетИздателяИПротокол() Экспорт

	Имя = "keep" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "github")).Успех).ЭтоИстина();

	ДоПравки = Сервис_.КарточкаПоИмени(Имя);
	Ожидаем.Что(ДоПравки.Издатель, "КОНТРОЛЬ: заведён с синтетикой").Равно("oauth2:github");

	Форма = ВводФормыПравки(Имя);
	Форма.Вставить("Метка", "Другая подпись");
	Исход = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Форма);
	// без этой проверки тест зелен и тогда, когда правка не состоялась вовсе
	Ожидаем.Что(Исход.Успех, "правка состоялась: " + Исход.Сообщение).ЭтоИстина();

	После = Сервис_.КарточкаПоИмени(Имя);
	Ожидаем.Что(После.Издатель, "издатель пережил правку формой").Равно("oauth2:github");
	Ожидаем.Что(После.ВидПротокола, "протокол пережил правку формой").Равно("oauth2");

КонецПроцедуры

&Тест
Процедура ПравкаФормойНеТеряетКонечныеТочки() Экспорт

	Имя = "ep" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "github")).Успех).ЭтоИстина();

	ДоПравки = Строка(Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя).КонечныеТочки);
	Ожидаем.Что(СтрНайти(ДоПравки, "github.com") > 0, "КОНТРОЛЬ: точки пресета записаны").ЭтоИстина();

	Форма = ВводФормыПравки(Имя);
	Форма.Вставить("Метка", "ещё подпись");
	Исход = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Форма);
	Ожидаем.Что(Исход.Успех, "правка состоялась: " + Исход.Сообщение).ЭтоИстина();

	После = Строка(Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя).КонечныеТочки);
	Ожидаем.Что(СтрНайти(После, "github.com") > 0,
		"конечные точки пережили правку формой (стало: " + После + ")").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаНеЧитаетИзТелаНиОдногоПоляЛичности() Экспорт

	Имя = "ident" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "github")).Успех,
		"КОНТРОЛЬ: пресет github заведён").ЭтоИстина();

	До = Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя);
	ДоИздатель = Строка(До.Издатель);
	ДоПротокол = Строка(До.ВидПротокола);
	ДоПресет = Строка(До.Пресет);
	ДоТочки = Строка(До.КонечныеТочки);
	ДоМаппинг = Строка(До.МаппингПрофиля);
	Ожидаем.Что(ДоИздатель, "КОНТРОЛЬ: издатель пресета на месте").Равно("oauth2:github");

	Ядовитая = ВводФормыПравки(Имя);
	Ядовитая.Вставить("Пресет", "google");
	Ядовитая.Вставить("ВидПротокола", "oidc");
	Ядовитая.Вставить("Издатель", "https://evil.example.com");
	Ядовитая.Вставить("АдресАвторизации", "https://169.254.169.254/authorize");
	Ядовитая.Вставить("АдресТокена", "https://10.0.0.5/token");
	Ядовитая.Вставить("АдресПрофиля", "https://[::1]/user");
	Ядовитая.Вставить("АдресEmails", "https://127.0.0.1/emails");
	Ядовитая.Вставить("БазовыйАдрес", "https://evil.example.com");
	Ядовитая.Вставить("Метка", "правка прошла");
	Ядовитая.Вставить("Область", "user:email read:org");
	Исход = Сервис_.Изменить(Принципалы.Сессия(Админ), Имя, Ядовитая);

	Ожидаем.Что(Исход.Успех, "правка проходит: " + Исход.Сообщение).ЭтоИстина();

	После = Желудь("ХранилищеПровайдеровВхода").НайтиПоИмени(Имя);
	Ожидаем.Что(Строка(После.Издатель), "издатель").Равно(ДоИздатель);
	Ожидаем.Что(Строка(После.ВидПротокола), "вид протокола").Равно(ДоПротокол);
	Ожидаем.Что(Строка(После.Пресет), "пресет").Равно(ДоПресет);
	Ожидаем.Что(Строка(После.КонечныеТочки), "конечные точки").Равно(ДоТочки);
	Ожидаем.Что(Строка(После.МаппингПрофиля), "маппинг профиля").Равно(ДоМаппинг);
	Ожидаем.Что(Строка(После.Метка), "подпись кнопки пресета телом не перебивается").Равно("GitHub");
	Ожидаем.Что(Строка(После.Область), "а изменяемое поле применилось").Равно("user:email read:org");

	// приватных адресов в строке нет ни в каком виде
	Всё = Строка(После.Издатель) + "|" + Строка(После.КонечныеТочки) + "|" + Строка(После.АдресВозврата);
	Для Каждого Ядовитый Из СтрРазделить("169.254,10.0.0.5,::1,127.0.0.1,evil.example.com", ",") Цикл
		Ожидаем.Что(СтрНайти(Всё, Ядовитый), "в строке нет <" + Ядовитый + ">").Равно(0);
	КонецЦикла;

	// КОНТРОЛЬ: те же адреса ПРИ ЗАВЕДЕНИИ гейт отбивает — проверка адресов жива
	Плохой = ВводВручную("ident2" + УникальныеИмена.Хвост(), "oidc");
	Плохой.Вставить("АдресТокена", "https://10.0.0.5/token");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Плохой).Успех,
		"КОНТРОЛЬ: при заведении приватный адрес отбит").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПолеСтран

// Отказ поля стран называет набранное: подделка отбита и правилом не становится. Что разметка
// не выходит на страницу сырой, стережёт живой набор.
&Тест
Процедура ПодделкаВПолеСтранОтбиваетсяИПравиломНеСтановится() Экспорт

	Имя = "xss" + УникальныеИмена.Хвост();
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), ВводПресета(Имя, "github")).Успех)
		.ЭтоИстина();

	Правило = СобратьГеоправило();
	Подделка = "RU""><script>alert(1)</script>";

	Исход = Правило.Сохранить(Принципалы.Сессия(Админ), Имя, Подделка);

	Ожидаем.Что(Исход.Успех, "подделка кодом страны не является").ЭтоЛожь();
	Ожидаем.Что(Исход.Код).Равно(400);
	Ожидаем.Что(СтрНайти(Исход.Сообщение, "script") > 0,
		"отказ называет набранное — экранирует его печать, а не домен").ЭтоИстина();
	Ожидаем.Что(Правило.Правило(Имя).Есть, "правила не появилось").ЭтоЛожь();

	// КОНТРОЛЬ: годный код на том же провайдере правилом становится
	Ожидаем.Что(Правило.Сохранить(Принципалы.Сессия(Админ), Имя, "RU").Успех,
		"КОНТРОЛЬ: отличие ровно в подделке").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СинхронизацияГрупп

&Тест
Процедура ПредикатСинхронизацииЗакрытПоУмолчаниюВоВсехФормах() Экспорт

	Сервис = СобратьСервисВхода();

	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(Новый Структура("Успех", Истина)),
		"поля нет вовсе — пропуск").ЭтоЛожь();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(Новый Структура("ПрофильПолучен", "Истина")),
		"строка вместо булева — пропуск").ЭтоЛожь();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(Новый Структура("ПрофильПолучен", 1)),
		"число вместо булева — пропуск").ЭтоЛожь();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(Неопределено), "не структура — пропуск").ЭтоЛожь();
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима("что-то"), "строка — пропуск").ЭтоЛожь();

	// КОНТРОЛЬ: ровно Истина — синхронизируем
	Ожидаем.Что(Сервис.СинхронизацияГруппДопустима(Новый Структура("ПрофильПолучен", Истина)),
		"КОНТРОЛЬ: профиль получен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустойПрефиксГруппЗаявляетОСебеИИзБазыТоже() Экспорт

	Журнал = Новый ФейкЖурналЗамка();
	Конфигурация = Новый КонфигурацияOIDC(Журнал, Желудь("ПровайдерыИзБазы"));

	// КОНТРОЛЬ: тот же провайдер, объявленный окружением/программно, предупреждение даёт
	Оверрайд = Новый Структура();
	Оверрайд.Вставить("Имя", "envpfx" + УникальныеИмена.Хвост());
	Оверрайд.Вставить("Издатель", "https://idp.example.com");
	Оверрайд.Вставить("ИдентификаторКлиента", "cid");
	Оверрайд.Вставить("АдресВозврата", "https://hub.example.com/cb");
	Оверрайд.Вставить("ПровижинингГрупп", Истина);
	Оверрайд.Вставить("ПрефиксГрупп", "");
	Конфигурация.ДобавитьПровайдер(Оверрайд);
	Ожидаем.Что(Журнал.Предупреждения().Количество(),
		"КОНТРОЛЬ: env-путь о пустом префиксе заявляет").Равно(1);

	// а теперь ровно та же политика, заведённая ФОРМОЙ (строкой базы)
	Имя = "dbpfx" + УникальныеИмена.Хвост();
	Данные = ВводВручную(Имя, "oidc");
	Данные.Вставить("ПровижинингГрупп", Истина);
	Данные.Вставить("СвязкаГруппПоИмени", Истина);
	Данные.Вставить("ПрефиксГрупп", "");
	Ожидаем.Что(Сервис_.Завести(Принципалы.Сессия(Админ), Данные).Успех,
		"провайдер с механизмами групп и пустым префиксом заведён формой").ЭтоИстина();

	Конфигурация.Актуализировать();
	Действующий = Конфигурация.Провайдер(Имя);
	Ожидаем.Что(Конфигурация.ПрефиксГруппНуженНоНеЗадан(Действующий),
		"условие предупреждения выполнено").ЭтоИстина();

	Ожидаем.Что(Журнал.Предупреждения().Количество() > 1,
		"строка базы о пустом префиксе тоже обязана заявить (предупреждений: "
		+ Журнал.Предупреждения().Количество() + ")").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Журнал

// Правки провайдера входа и его правила по стране — вехи уровня хаба: исход словом и тот, кто правил;
// код действия аудита и секрет клиента в строку не идут.
&Тест
Процедура ПравкиПровайдераИПравилаПоСтранеВидныНаИнформации() Экспорт

	Лог = Логирование.ПолучитьЛог("тест.oshub.провайдеры.вехи");
	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(Лог, УровниЛога.Информация);
	Сервис = СобратьСервис(Лог);
	Правило = СобратьГеоправило(Лог);
	Имя = "veha" + УникальныеИмена.Хвост();
	Сессия = Принципалы.Сессия(Админ);

	Попытка
		Ожидаем.Что(Сервис.Завести(Сессия, ВводВручную(Имя, "oidc")).Успех, "провайдер заведён").ЭтоИстина();
		Ожидаем.Что(Правило.Сохранить(Сессия, Имя, "RU").Успех, "правило по стране сохранено").ЭтоИстина();
		Ожидаем.Что(Сервис.Переключить(Сессия, Имя, Ложь).Успех, "провайдер выключен").ЭтоИстина();
		Ожидаем.Что(Сервис.Удалить(Сессия, Имя).Успех, "провайдер удалён").ЭтоИстина();
	Исключение
		Ловушка.Снять();
		ВызватьИсключение;
	КонецПопытки;
	Ловушка.Снять();
	Журнал = Ловушка.Всё();

	Провайдер = "Провайдер входа """ + Имя + """";
	Ожидаем.Что(Журнал, "заведение названо словом: " + Журнал).Содержит(Провайдер + " заведён, кто ""root7d""");
	Ожидаем.Что(Журнал, "правило по стране названо").Содержит(Провайдер + ": правило по стране сменено");
	Ожидаем.Что(Журнал, "выключение названо").Содержит(Провайдер + " выключен");
	Ожидаем.Что(Журнал, "удаление названо").Содержит(Провайдер + " удалён");
	Ожидаем.Что(СтрНайти(Журнал, "провайдер."), "кода действия аудита в строке нет").Равно(0);
	Ожидаем.Что(СтрНайти(Журнал, "client-secret-значение"), "секрета клиента нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Сервис с ФЕЙКОВЫМ резолвером имён: SSRF-гейт проверяется офлайн и детерминированно.
Функция СобратьСервис(Знач Лог = Неопределено)
	Возврат Новый СервисПровайдеровВхода(
		Желудь("ХранилищеПровайдеровВхода"), Желудь("КонфигурацияOIDC"), СобратьРазбор(),
		Желудь("ПерехватчикАутентификации"), Желудь("СервисПрав"),
		Желудь("ТекстыВхода"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"), Желудь("ГейтТокена"),
		Желудь("ИздательСобытий"), Неопределено, Лог);
КонецФункции

Функция СобратьРазбор()
	Возврат Новый РазборПровайдераВхода(
		НовыеПресеты(), Новый ИздателиOAuth2(), СобратьВалидатор(),
		Желудь("РаскладкаСтатики"), Желудь("ТекстыВхода"), Желудь("ТекстОшибки"),
		Логирование.ПолучитьЛог("тест.oshub.провайдеры"));
КонецФункции

Функция СобратьВалидатор()
	Возврат Новый ВалидаторАдресаПровайдера(Новый СвояСеть(Желудь("КанонIP")),
		Новый ИздателиOAuth2(), Желудь("ТекстыВхода"));
КонецФункции

// Пресеты собираются вручную: их желудь в контейнере есть, но набор проверяет и сборку
Функция НовыеПресеты()
	Возврат Новый ПресетыВхода(Желудь("ТекстыВхода"), Новый ИздателиOAuth2());
КонецФункции

// scope из адреса авторизации — то, что провайдер покажет человеку на экране согласия.
Функция ОбластьЗапросаАвторизации(Знач URL)

	Для Каждого Пара Из СтрРазделить(Сред(URL, Найти(URL, "?") + 1), "&", Ложь) Цикл
		Если СтрНачинаетсяС(Пара, "scope=") Тогда
			Возврат РаскодироватьСтроку(Сред(Пара, СтрДлина("scope=") + 1),
				СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Ввод формы «завести по пресету»: администратор внёс только учётные данные.
Функция ВводПресета(Знач Имя, Знач Пресет)
	Данные = Новый Структура();
	Данные.Вставить("Имя", Имя);
	Данные.Вставить("Пресет", Пресет);
	Данные.Вставить("ИдентификаторКлиента", "client-id-значение");
	Данные.Вставить("СекретКлиента", "client-secret-значение");
	Данные.Вставить("АдресВозврата", "https://hub.example.com/oidc/callback");
	Данные.Вставить("Включён", Истина);
	Возврат Данные;
КонецФункции

// Ввод формы «свой провайдер»: при дискавери — издатель, без дискавери — конечные точки.
Функция ВводВручную(Знач Имя, Знач Протокол)

	Данные = Новый Структура();
	Данные.Вставить("Имя", Имя);
	Данные.Вставить("Пресет", "");
	Данные.Вставить("ВидПротокола", Протокол);
	Данные.Вставить("ИдентификаторКлиента", "client-id-значение");
	Данные.Вставить("СекретКлиента", "client-secret-значение");
	Данные.Вставить("АдресВозврата", "https://hub.example.com/oidc/callback");
	Данные.Вставить("Включён", Истина);

	Если НРег(СокрЛП(Строка(Протокол))) = "oauth2" Тогда
		Данные.Вставить("АдресАвторизации", "https://idp.example.com/authorize");
		Данные.Вставить("АдресТокена", "https://idp.example.com/token");
		Данные.Вставить("АдресПрофиля", "https://idp.example.com/userinfo");
	Иначе
		Данные.Вставить("Издатель", "https://idp.example.com");
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Все значения карточки одной строкой — чтобы искать в них утёкший секрет.
Функция СтрокойВсёПоле(Знач Карточка)
	Части = Новый Массив();
	Для Каждого КиЗ Из Карточка Цикл
		Части.Добавить(Строка(КиЗ.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Части, "|");
КонецФункции

// Ввод формы правки, как его собирает ПультПровайдеровВхода.Ввод: непечатаемые поля приходят пустыми строками.
Функция ВводФормыПравки(Знач Имя)
	Данные = Новый Структура();
	Данные.Вставить("Имя", Имя);
	Данные.Вставить("Метка", "Подпись");
	Данные.Вставить("Пресет", "");
	Данные.Вставить("ВидПротокола", "");
	Данные.Вставить("Издатель", "");
	Данные.Вставить("ИдентификаторКлиента", "client-id-значение");
	Данные.Вставить("СекретКлиента", "");
	Данные.Вставить("АдресВозврата", "https://hub.example.com/oidc/callback");
	Данные.Вставить("Область", "");
	Данные.Вставить("БазовыйАдрес", "");
	Данные.Вставить("АдресАвторизации", "");
	Данные.Вставить("АдресТокена", "");
	Данные.Вставить("АдресПрофиля", "");
	Данные.Вставить("АдресEmails", "");
	Данные.Вставить("ИмяКлеймаГрупп", "");
	Данные.Вставить("ПрефиксГрупп", "");
	Данные.Вставить("АвтоСоздание", Ложь);
	Данные.Вставить("ПровижинингГрупп", Ложь);
	Данные.Вставить("СвязкаГруппПоИмени", Ложь);
	Данные.Вставить("Включён", Истина);
	Возврат Данные;
КонецФункции

// Правило без издателя событий: оценка последствий тянет почту и личный канал, которых в контейнере нет.
Функция СобратьГеоправило(Знач Лог = Неопределено)

	Возврат Новый ГеоправилоПровайдера(
		Желудь("ХранилищеГеоправил"), Желудь("СправочникСтран"), Желудь("СписокЧерезЗапятую"),
		Желудь("КонфигурацияOIDC"), Желудь("ПолитикаПарольногоВхода"), Неопределено,
		Желудь("ТекстыВхода"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Неопределено, Неопределено, Лог);

КонецФункции

Функция СобратьСервисВхода()
	Возврат Желудь("СервисВходаOIDC");
КонецФункции

#КонецОбласти

