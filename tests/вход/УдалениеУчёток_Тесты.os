// Удаление учётки: что уходит вместе с человеком (сессии, ключи, личности, заявки, членства, гранты,
// личное пространство), что остаётся жить безымянным и кого удалить нельзя.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;
Перем Засев;         // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба
Перем Стенд;         // фикстура СтендУчёток — учётка, её роль на пуле и ключ доступа

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогПроекта = КаталогиПроекта.Корень();
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	Слои.Подключить("данные");
	// хранилище и публикация — ради уборки пула: она сносит область файлов и входящие заявки,
	// а без них удаление личного пространства падает на пустой ссылке
	Слои.Подключить("хранилище, публикация, реестр, основа, состояние/телеметрия, события");

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"),
			"СобытиеАудита");
	Исключение
	КонецПопытки;

	// почта — ради сборки: на ней стоит цикл подтверждения адреса, а на нём допуск ко входу
	Слои.Подключить("почта");
	// обезличивание журнала почта создаёт «Новым»: получатель в журнале без ящика
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"),
		"ОбезличиваниеЖурнала");
	// личный канал: через него ходят письма входа и исход заявки
	Слои.Подключить("уведомления, вход, права, настройки");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "удаление-учёток-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендУчёток(Поделка);

КонецПроцедуры

#Область ЧтоУходит

&Тест
Процедура УдалениеУноситУчёткуИЕёСессии() Экспорт

	Жертва = ЗавестиУчётку();
	Желудь("СлужбаСессий").Создать(Жертва.Идентификатор);

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.90");

	Ожидаем.Что(Пользователи().НайтиПоЛогину(Жертва.Логин) = Неопределено,
		"учётной записи больше нет").ЭтоИстина();
	Ожидаем.Что(Снято.Сессий, "сессия снята").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеСессий").ПолучитьПоПользовательИдентификаторРавно(
			Жертва.Идентификатор).Количество(), "в хранилище её тоже нет").Равно(0);

КонецПроцедуры

&Тест
Процедура УдалениеУноситКлючиДоступа() Экспорт

	Жертва = ЗавестиУчётку();
	Стенд.Ключ(Жертва, "", 0, "ключ-жертвы");

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.91");

	Ожидаем.Что(Снято.Ключей, "ключ снят").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеТокенов").ПолучитьПоПользовательИдентификаторРавно(
			Жертва.Идентификатор).Количество(), "и в хранилище пусто").Равно(0);

КонецПроцедуры

// Лента адресована учётке: без хозяина её записи стали бы уведомлениями для никого.
&Тест
Процедура УдалениеУноситЛентуУведомленийИНеТрогаетЧужую() Экспорт

	Жертва = ЗавестиУчётку();
	Сосед = ЗавестиУчётку();

	Лента = Желудь("ЛентаУведомлений");
	Поводы = Желудь("ПоводыУведомлений");
	Лента.Записать(Жертва, Поводы.ЗаявкаОдобрена(), "Заявка одобрена", "Подробности");
	Лента.Записать(Жертва, Поводы.ЗаявкаОтклонена(), "Заявка отклонена", "Причина");
	Лента.Записать(Сосед, Поводы.ЗаявкаОдобрена(), "Соседнее событие", "Подробности");

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.92");

	Ожидаем.Что(Снято.Уведомлений, "уведомления жертвы сняты").Равно(2);
	Ожидаем.Что(Желудь("ХранилищеЛичныхУведомлений").ЛентаУчётки(
			Жертва.Идентификатор).Количество(), "и в хранилище их не осталось").Равно(0);
	Ожидаем.Что(Лента.Мои(Сосед).Количество(), "чужая лента не тронута").Равно(1);

КонецПроцедуры

// Личное пространство равно логину и без хозяина не живёт: уходит целиком.
&Тест
Процедура УдалениеУноситЛичноеПространство() Экспорт

	Жертва = ЗавестиУчётку();
	Пользователи().ОбеспечитьЛичныйПул(Жертва);
	Ожидаем.Что(Пулы().НайтиПул(Жертва.Логин), "личный пул заведён").Существует();

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.92");

	Ожидаем.Что(Снято.Пулов, "пул снесён").Равно(1);
	Ожидаем.Что(Пулы().НайтиПул(Жертва.Логин) = Неопределено,
		"личного пространства больше нет").ЭтоИстина();

КонецПроцедуры

// Роль на ЧУЖОМ пуле, выданная так же, как её выдаёт экран «Права доступа», отзывается:
// строки права не остаётся ни у учётки, ни в списке прав пула, и доступа она не даёт.
// Снимается только выдача удаляемого: сосед по пулу и группа с тем же номером, что
// у учётки, свои права сохраняют. Сам пул остаётся цел — он не принадлежит удаляемому.
&Тест
Процедура УдалениеОтзываетГрантыНоЧужойПулНеТрогает() Экспорт

	Жертва = ЗавестиУчётку();
	Сосед = ЗавестиУчётку();
	Чужой = Засев.ПулСервисом(УникальныеИмена.Имя("common"), "private", Цел(Админ().Идентификатор));
	ВыдатьРольНаПул(Чужой, Жертва);
	ВыдатьРольНаПул(Чужой, Сосед);
	ВыдатьРольНаПул(Чужой, Жертва.Идентификатор, Права().ТипСубъектаГруппа());
	Ожидаем.Что(Права().МожетПисать(Жертва, Чужой),
		"КОНТРОЛЬ: до удаления роль открывает запись в пул").ЭтоИстина();

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.93");

	Ожидаем.Что(Снято.Грантов, "отозван ровно выданный грант").Равно(1);
	Ожидаем.Что(Доступ().ГрантыСубъекта(Права().ТипСубъектаПользователь(), Жертва.Идентификатор)
		.Количество(), "строки права за удалённой учёткой не осталось").Равно(0);
	Ожидаем.Что(ГрантовНаПулУ(Чужой, Права().ТипСубъектаПользователь(), Жертва.Идентификатор),
		"и в списке прав пула её нет").Равно(0);
	Ожидаем.Что(Права().МожетЧитать(Жертва, Чужой),
		"право удалённой учётки больше не действует").ЭтоЛожь();

	Ожидаем.Что(ГрантовНаПулУ(Чужой, Права().ТипСубъектаПользователь(), Сосед.Идентификатор),
		"выдача соседа по пулу цела").Равно(1);
	Ожидаем.Что(Права().МожетПисать(Сосед, Чужой), "и сосед по-прежнему пишет в пул").ЭтоИстина();
	Ожидаем.Что(ГрантовНаПулУ(Чужой, Права().ТипСубъектаГруппа(), Жертва.Идентификатор),
		"выдача группы с тем же номером, что у учётки, цела").Равно(1);
	Ожидаем.Что(Пулы().НайтиПул(Чужой.Имя), "а чужой пул на месте").Существует();

КонецПроцедуры

// Роль участия в пуле пишут засевы и прежние версии хаба; модель её читает наравне
// с грантом, поэтому уходит и она — строкой того же типа субъекта, что у модели.
&Тест
Процедура УдалениеСнимаетРольУчастияВПуле() Экспорт

	Жертва = ЗавестиУчётку();
	Чужой = Засев.ПулСервисом(УникальныеИмена.Имя("members"), "private", Цел(Админ().Идентификатор));
	Стенд.РольВПуле(Чужой, Жертва, Права().РольМейнтейнер());
	Ожидаем.Что(Права().РольНаПул(Жертва, Чужой.Идентификатор),
		"КОНТРОЛЬ: до удаления роль участия действует").Равно(Права().РольМейнтейнер());

	Снято = Удаление().Удалить(Админ(), Жертва, "203.0.113.97");

	Ожидаем.Что(Снято.Ролей, "роль участия снята").Равно(1);
	Ожидаем.Что(Права().РольНаПул(Жертва, Чужой.Идентификатор),
		"и больше ничего не даёт").Равно("");

КонецПроцедуры

// Журнал аудита называет настоящее число отозванных грантов и снятых ролей, а не ноль
// при оставшихся правах.
&Тест
Процедура ЖурналУдаленияНазываетЧислоОтозванныхГрантовИРолей() Экспорт

	Жертва = ЗавестиУчётку();
	ВыдатьРольНаПул(Засев.ПулСервисом(УникальныеИмена.Имя("first"), "private",
		Цел(Админ().Идентификатор)), Жертва);
	ВыдатьРольНаПул(Засев.ПулСервисом(УникальныеИмена.Имя("second"), "private",
		Цел(Админ().Идентификатор)), Жертва);
	Стенд.РольВПуле(Засев.ПулСервисом(УникальныеИмена.Имя("third"), "private",
		Цел(Админ().Идентификатор)), Жертва, Права().РольЧитатель());

	Издатель = Желудь("ИздательСобытий");
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПриглашениеУчётки(), Слушатель);

	Удаление().Удалить(Админ(), Жертва, "203.0.113.98");

	Запись = ЗаписьУдаления(Слушатель, Жертва.Логин);
	Ожидаем.Что(Запись, "удаление записано в журнал").Существует();
	Ожидаем.Что(ДетальЗаписи(Запись, "грантов"), "в записи — число отозванных грантов").Равно(2);
	Ожидаем.Что(ДетальЗаписи(Запись, "ролей"), "и число снятых ролей участия").Равно(1);

КонецПроцедуры

// Удаление — одно дело: на ИНФОРМАЦИИ одна строка с числом снятых прав, а не строка на каждый грант.
&Тест
Процедура УдалениеНазваноНаИнформацииОднойСтрокойСЧисломСнятого() Экспорт

	Жертва = ЗавестиУчётку();
	Для Каждого Имя Из СтрРазделить("one,two,three", ",") Цикл
		ВыдатьРольНаПул(Засев.ПулСервисом(УникальныеИмена.Имя(Имя), "private",
			Цел(Админ().Идентификатор)), Жертва);
	КонецЦикла;

	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(Логирование.ПолучитьЛог("УдалениеУчётки"), УровниЛога.Информация);
	Ловушка.Поставить(Логирование.ПолучитьЛог("СервисПравДоступа"), УровниЛога.Информация);
	Ловушка.Поставить(Логирование.ПолучитьЛог("ЛетописьУчёток"), УровниЛога.Информация);
	Попытка
		Удаление().Удалить(Админ(), Жертва, "203.0.113.99");
	Исключение
		Ловушка.Снять();
		ВызватьИсключение;
	КонецПопытки;
	Ловушка.Снять();
	Журнал = Ловушка.Всё();

	Ожидаем.Что(Ловушка.Количество(), "одно дело — одна строка: " + Журнал).Равно(1);
	Ожидаем.Что(Журнал, "строка называет учётку").Содержит("""" + Жертва.Логин + """");
	Ожидаем.Что(Журнал, "и число снятых прав").Содержит("снято прав 3");

КонецПроцедуры

#КонецОбласти

#Область КогоНельзя

// Себя не удаляют. Второй админ в сцене обязателен: без него сработала бы застава
// «последний администратор», и сторож зеленел бы не на той причине.
&Тест
Процедура СебяУдалитьНельзя() Экспорт

	Запасной = ЗавестиАдмина();

	Вердикт = Удаление().ПроверитьУдаление(Админ(), Админ());

	Ожидаем.Что(Вердикт.Успех, "себя не удаляют").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина, "и причина названа").Равно(Удаление().ПричинаСебе());

	Удаление().Удалить(Админ(), Запасной, "203.0.113.96"); // сцена возвращается к одному админу

КонецПроцедуры

&Тест
Процедура НеАдминНеУдаляетНикого() Экспорт

	Жертва = ЗавестиУчётку();
	Проситель = ЗавестиУчётку();

	Вердикт = Удаление().ПроверитьУдаление(Проситель, Жертва);

	Ожидаем.Что(Вердикт.Успех, "обычный пользователь учёток не сносит").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина).Равно(Удаление().ПричинаНеАдмин());

КонецПроцедуры

// Последний администратор неудаляем: без него хаб остаётся без хозяина, а мастер первого
// запуска открывается анониму.
&Тест
Процедура ПоследнегоАдминаУдалитьНельзяАПредпоследнегоМожно() Экспорт

	Первый = Админ();
	Второй = ЗавестиАдмина();

	// пока админов двое, второго удалить можно
	Ожидаем.Что(Удаление().ПроверитьУдаление(Первый, Второй).Успех,
		"второго админа удалить можно").ЭтоИстина();
	Удаление().Удалить(Первый, Второй, "203.0.113.94");

	// остался один — и он неприкосновенен, причём именно по этой причине, а не потому,
	// что «себя нельзя»: хаб без администратора открывает мастер первого запуска анониму
	Вердикт = Удаление().ПроверитьУдаление(Первый, Первый);
	Ожидаем.Что(Вердикт.Успех, "последнего админа не удалить").ЭтоЛожь();
	Ожидаем.Что(Вердикт.Причина, "и отказ называет именно эту заставу")
		.Равно(Удаление().ПричинаПоследнийАдмин());

КонецПроцедуры

&Тест
Процедура УдалениеМимоПорогаПадаетИсключением() Экспорт

	Жертва = ЗавестиУчётку();
	Проситель = ЗавестиУчётку();

	Упало = Ложь;
	Попытка
		Удаление().Удалить(Проситель, Жертва, "203.0.113.95");
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "порог операции держит и прямой вызов").ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Жертва.Логин), "учётка цела").Существует();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Удаление()
	Возврат Желудь("УдалениеУчётки");
КонецФункции

Функция Пользователи()
	Возврат Желудь("СервисПользователей");
КонецФункции

Функция Пулы()
	Возврат Желудь("СервисПулов");
КонецФункции

Функция Права()
	Возврат Желудь("СервисПрав");
КонецФункции

Функция Доступ()
	Возврат Желудь("СервисПравДоступа");
КонецФункции

// Роль мейнтейнера на пуле той же дверью, что и экран «Права доступа»: от имени администратора.
// Субъект — учётка либо номер субъекта названного типа.
Процедура ВыдатьРольНаПул(Знач Пул, Знач Кому, Знач ТипСубъекта = "")
	Тип = ?(ЗначениеЗаполнено(ТипСубъекта), ТипСубъекта, Права().ТипСубъектаПользователь());
	Номер = ?(ТипЗнч(Кому) = Тип("Число"), Кому, Кому.Идентификатор);
	Доступ().ВыдатьРоль(Админ(), Тип, Номер, Права().ОбъектПул(Пул), Права().РольМейнтейнер());
КонецПроцедуры

// Строки списка прав пула за субъектом — по паре «тип и номер», как их различает сам список.
Функция ГрантовНаПулУ(Знач Пул, Знач ТипСубъекта, Знач Номер)

	Грантов = 0;
	Для Каждого Грант Из Доступ().ГрантыНаОбъект(Права().ОбъектПул(Пул)) Цикл
		Если Грант.ТипСубъекта = ТипСубъекта И Цел(Грант.СубъектИдентификатор) = Цел(Номер) Тогда
			Грантов = Грантов + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Грантов;

КонецФункции

Функция ЗаписьУдаления(Знач Слушатель, Знач Логин)

	Для Каждого Событие Из Слушатель.События Цикл
		Если Событие.Данные.Действие = Желудь("ЛетописьУчёток").ДействиеУчёткаУдалена()
			И СтрЗаканчиваетсяНа(Событие.Данные.Субъект, "/" + Логин) Тогда
			Возврат Событие;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ДетальЗаписи(Знач Запись, Знач Ключ)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Запись.Данные.ДеталиJSON);
	Детали = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Детали.Получить(Ключ);

КонецФункции

// Единственный администратор набора: пороги операций судят по нему.
Функция Админ()

	Найденный = Пользователи().НайтиПоЛогину("deladmin");
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;
	Возврат Пользователи().СоздатьПользователя("deladmin", "deladmin@example.com",
		"AdminPassw0rd", "admin");

КонецФункции

Функция ЗавестиАдмина()
	Логин = УникальныеИмена.Имя("adm");
	Возврат Пользователи().СоздатьПользователя(Логин, Логин + "@example.com",
		"AdminPassw0rd", "admin");
КонецФункции

Функция ЗавестиУчётку()
	Возврат Стенд.УчёткаСлужбой("user", УникальныеИмена.Имя("victim"), "Password123!");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

#КонецОбласти
