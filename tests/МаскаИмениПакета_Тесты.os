// Юнит-тесты маски имени пакета (основа): allowlist прокси и фильтр зеркала сличают
// имя целиком, регистрозависимо, а метасимволы маски считают литералами.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогCommon;
Перем КаталогРеестра;   // классы, уехавшие из common к своему хозяину

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогCommon = ОбъединитьПути(КаталогМодулей, "основа", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогРеестра, "МаскаИмениПакета");
КонецПроцедуры

&Тест
Процедура ЗвёздочкаЗакрываетЛюбойФрагмент() Экспорт

	Маска = Новый МаскаИмениПакета("corp-*");

	Ожидаем.Что(Маска.Совпадает("corp-x"), "префикс совпал").ЭтоИстина();
	Ожидаем.Что(Маска.Совпадает("corp-"), "звёздочка допускает пустой фрагмент").ЭтоИстина();
	Ожидаем.Что(Маска.Совпадает("acorp-x"), "маска прибита к началу имени").ЭтоЛожь();
	Ожидаем.Что(Новый МаскаИмениПакета("*-lib").Совпадает("corp-lib"), "суффиксная маска").ЭтоИстина();
	Ожидаем.Что(Новый МаскаИмениПакета("*-lib").Совпадает("corp-lib-x"), "маска прибита к концу").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура МаскаБезЗвёздочкиТребуетТочногоИмени() Экспорт

	Маска = Новый МаскаИмениПакета("corp-x");

	Ожидаем.Что(Маска.Совпадает("corp-x")).ЭтоИстина();
	Ожидаем.Что(Маска.Совпадает("corp-xy"), "имя длиннее маски").ЭтоЛожь();
	Ожидаем.Что(Маска.Совпадает("evil-corp-x"), "имя длиннее маски слева").ЭтоЛожь();

КонецПроцедуры

// Перевод строки внутри имени не должен давать совпадения ни одной своей строкой:
// иначе имя-обёртка «мусор + разрешённое имя» проходит allowlist прокси и фильтр зеркала.
&Тест
Процедура ПереводСтрокиВИмениНеДаётСовпадения() Экспорт

	Маска = Новый МаскаИмениПакета("corp-*");

	Ожидаем.Что(Маска.Совпадает("evil" + Символы.ПС + "corp-x"), "мусор перед именем").ЭтоЛожь();
	Ожидаем.Что(Маска.Совпадает("corp-x" + Символы.ПС + "evil"), "мусор после имени").ЭтоЛожь();
	Ожидаем.Что(Маска.Совпадает("corp-x" + Символы.ПС), "хвостовой перевод строки").ЭтоЛожь();

	Точная = Новый МаскаИмениПакета("corp-x");
	Ожидаем.Что(Точная.Совпадает("evil" + Символы.ПС + "corp-x"), "маска без звёздочки — тоже").ЭтоЛожь();
	Ожидаем.Что(Точная.Совпадает("corp-x" + Символы.ПС), "маска без звёздочки — тоже").ЭтоЛожь();

КонецПроцедуры

// Канонизация имени — забота вызывающего кода (он приводит к нижнему регистру), сама маска
// регистр не сглаживает: иначе «регистронезависимо» тихо расползается на чужие сравнения.
&Тест
Процедура СличениеРегистрозависимо() Экспорт

	Маска = Новый МаскаИмениПакета("corp-*");

	Ожидаем.Что(Маска.Совпадает("CORP-X"), "верхний регистр имени").ЭтоЛожь();
	Ожидаем.Что(Маска.Совпадает("Corp-x"), "смешанный регистр имени").ЭтоЛожь();
	Ожидаем.Что(Новый МаскаИмениПакета("corp-x").Совпадает("CORP-X"), "маска без звёздочки").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура МетасимволыМаскиЛитеральны() Экспорт

	Ожидаем.Что(Новый МаскаИмениПакета("a.c*").Совпадает("abcx"), "точка — не любой символ").ЭтоЛожь();
	Ожидаем.Что(Новый МаскаИмениПакета("a.c*").Совпадает("a.cx"), "точка совпадает с точкой").ЭтоИстина();
	Ожидаем.Что(Новый МаскаИмениПакета("a+*").Совпадает("aaa"), "плюс — не квантификатор").ЭтоЛожь();
	Ожидаем.Что(Новый МаскаИмениПакета("a+*").Совпадает("a+b"), "плюс совпадает с плюсом").ЭтоИстина();
	Ожидаем.Что(Новый МаскаИмениПакета("(a|b)*").Совпадает("a"), "группа — не альтернатива").ЭтоЛожь();
	Ожидаем.Что(Новый МаскаИмениПакета("(a|b)*").Совпадает("(a|b)c"), "группа литеральна").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НераспознаннаяМаскаНеСовпадаетНиСЧем() Экспорт

	Ожидаем.Что(Новый МаскаИмениПакета("").Совпадает(""), "пустая маска — пустое имя").ЭтоИстина();
	Ожидаем.Что(Новый МаскаИмениПакета("").Совпадает("corp-x"), "пустая маска — не всё подряд").ЭтоЛожь();
	Ожидаем.Что(Новый МаскаИмениПакета("*").Совпадает("что угодно"), "одна звёздочка — всё").ЭтоИстина();

КонецПроцедуры
