// Проба базы: отвечает ли база, снимок её пула и тело пробы живости. Главное — проба
// не встаёт в очередь за соединением: исчерпанный пул она называет отказом по снимку.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать autumn-logos
#Использовать entity
#Использовать errors
#Использовать "../фикстуры"

Перем ПоискКлассов;      // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулей;
Перем ВременныеКаталоги;
Перем ЖивойИсточник;     // ИсточникДанных (autumn-data) контейнера на КоннектореJSON
Перем ЖивыеНастройки;    // НастройкиНадХранилищем — таблица прикладных настроек того же контейнера
Перем СчётчикБазы;       // СчётчикЗапросовБазы — чтения и записи по таблицам

// Живая база — контейнер ОСени: он не уживается с контейнером раннера в одном процессе.
&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("СчётчикЗапросовБазы");
	РеестрФикстур.Подключить("ФейкПулСоединений");
	РеестрФикстур.Подключить("ФейкБазыПробы");
	РеестрФикстур.Подключить("ОтветГотовности");
	РеестрФикстур.Подключить("НастройкиНадХранилищем");

	ПоискКлассов = Новый КлассыСлоя();
	ВременныеКаталоги = Новый Массив();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = КаталогиПроекта.Модули();

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(КаталогМодулей, "реестр, настройки");

	КаталогСостояния = ОбъединитьПути(КаталогМодулей, "состояние", "Классы");
	ПоискКлассов.Подключить(КаталогСостояния, "ПробаБазы");
	ПоискКлассов.Подключить(КаталогСостояния, "КонтроллерЗдоровья");
	ПоискКлассов.Подключить(КаталогСостояния, "ЖивостьХаба");
	ПоискКлассов.Подключить(КаталогСостояния, "СостояниеХаба");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "ОписаниеПриложения");

	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	ПоднятьЖивуюБазу();

КонецПроцедуры

&ПослеВсех
Процедура УбратьВременное() Экспорт

	Если ЖивойИсточник <> Неопределено И НЕ ЖивойИсточник.Закрыт() Тогда
		ЖивойИсточник.Закрыть();
	КонецЕсли;

	Для Каждого Каталог Из ВременныеКаталоги Цикл
		УникальныеИмена.УбратьВременное(Каталог);
	КонецЦикла;

КонецПроцедуры

#Область ДорогаДоБазы

// Пул исчерпан, запросы стоят в очереди: пойди проба в базу — ответила бы позже любого
// таймаута оркестратора.
&Тест
Процедура ИсчерпанныйПулОтвечаетНеХодяВБазу() Экспорт

	База = БазаСПулом(10, 0, 3, 10);
	Состояние = ПробаНа(База).Состояние();

	Ожидаем.Что(Состояние["status"], "исчерпанный пул — база не отвечает").Равно("unavailable");
	Ожидаем.Что(Состояние["reason"], "причина названа словами").Содержит("пул соединений исчерпан");
	Ожидаем.Что(База.Обращений(), "в базу проба НЕ пошла").Равно(0);

КонецПроцедуры

// Очередь пуста, но все десять соединений у потоков: следующий заявитель будет ждать.
&Тест
Процедура ЗанятыеСоединенияБезОчередиТожеИсчерпаниеПула() Экспорт

	База = БазаСПулом(10, 0, 0, 10);
	Состояние = ПробаНа(База).Состояние();

	Ожидаем.Что(Состояние["status"], "мест нет, свободных нет — исчерпан").Равно("unavailable");
	Ожидаем.Что(База.Обращений(), "в базу проба НЕ пошла").Равно(0);

КонецПроцедуры

// Свободного соединения нет, но пять мест из десяти не заняты — пул откроет новое без очереди.
&Тест
Процедура СвободныхНетНоПулВправеОткрытьЕщё() Экспорт

	База = БазаСПулом(5, 0, 0, 10);
	Состояние = ПробаНа(База).Состояние();

	Ожидаем.Что(Состояние["status"], "места в пуле есть — идём в базу").Равно("ok");
	Ожидаем.Что(База.Обращений(), "проба сходила в базу ровно раз").Равно(1);

КонецПроцедуры

// Девять соединений у потоков, десятое открывается: место занимает и бронь — мест нет.
&Тест
Процедура БроньПодОткрываемоеСоединениеТожеЗанимаетМесто() Экспорт

	База = БазаСПулом(9, 0, 0, 10, 10);
	Состояние = ПробаНа(База).Состояние();

	Ожидаем.Что(Состояние["status"], "все десять мест заняты — пул исчерпан").Равно("unavailable");
	Ожидаем.Что(Состояние["reason"], "в причине названы занятые места").Содержит("мест занято 10 из 10");
	Ожидаем.Что(База.Обращений(), "в базу проба НЕ пошла").Равно(0);

КонецПроцедуры

// Нулевой размер пула — «без предела»: сотня занятых соединений не исчерпание.
&Тест
Процедура ПулБезПределаИсчерпатьНечем() Экспорт

	База = БазаСПулом(100, 0, 0, 0);
	Состояние = ПробаНа(База).Состояние();

	Ожидаем.Что(Состояние["status"], "без предела пул не исчерпать").Равно("ok");
	Ожидаем.Что(База.Обращений(), "проба сходила в базу").Равно(1);

КонецПроцедуры

&Тест
Процедура СвободноеСоединениеПускаетПробуВБазу() Экспорт

	База = БазаСПулом(9, 1, 0, 10);
	Состояние = ПробаНа(База).Состояние();

	Ожидаем.Что(Состояние["status"], "свободное соединение есть — идём в базу").Равно("ok");
	Ожидаем.Что(Состояние.Свойство("reason"), "у ответа без отказа причины нет").ЭтоЛожь();
	Ожидаем.Что(База.Обращений(), "проба сходила в базу ровно раз").Равно(1);

КонецПроцедуры

&Тест
Процедура ОтказВыборкиНазываетПричинуОтказа() Экспорт

	База = БазаСПулом(0, 5, 0, 10);
	База.ПадатьС("connection reset by peer");

	Состояние = ПробаНа(База).Состояние();

	Ожидаем.Что(Состояние["status"], "запрос упал — база не отвечает").Равно("unavailable");
	Ожидаем.Что(Состояние["reason"], "оператору видно, ЧТО именно ответила база")
		.Содержит("connection reset by peer");

КонецПроцедуры

// Адреса проб открыты всем: путь файла и номер строки в тело не уходят.
&Тест
Процедура ПричинаВТелеНеНесётВнутренностейХаба() Экспорт

	База = БазаСПулом(0, 5, 0, 10);
	База.ПадатьС("FATAL: too many connections for role");

	Причина = ПробаНа(База).Состояние()["reason"];

	Ожидаем.Что(Причина, "существо отказа в теле осталось").Содержит("too many connections");
	Ожидаем.Что(СтрНайти(Причина, ".os"), "путь файла в тело не уходит: " + Причина).Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Причина), "модуль"),
		"служебной обёртки OneScript в теле тоже нет: " + Причина).Равно(0);

КонецПроцедуры

&Тест
Процедура СнимокПулаПриезжаетПятьюЧислами() Экспорт

	Пул = ПробаНа(БазаСПулом(4, 6, 2, 10)).Состояние()["pool"];

	Ожидаем.Что(Пул["busy"], "занято потоками").Равно(4);
	Ожидаем.Что(Пул["free"], "свободных соединений").Равно(6);
	Ожидаем.Что(Пул["waiting"], "стоят в очереди").Равно(2);
	Ожидаем.Что(Пул["created"], "занято мест в пуле").Равно(10);
	Ожидаем.Что(Пул["limit"], "предел пула").Равно(10);

КонецПроцедуры

#КонецОбласти

#Область Журнал

// В журнал попадает смена вердикта — обязательно, — а не каждая проба.
&Тест
Процедура ВЖурналПопадаетСменаВердикта_АНеКаждаяПроба() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	База = БазаСПулом(0, 5, 0, 10);
	Проба = ПробаНа(База, Ловушка);

	Опросить(Проба, 5);
	Ожидаем.Что(Ловушка.Количество(), "пять удачных проб — одна строка: " + Ловушка.Всё()).Равно(1);
	Ожидаем.Что(Ловушка.Сообщение(0), "первая строка — что база отвечает").Содержит("база отвечает");

	База.ПадатьС("server closed the connection unexpectedly");
	Опросить(Проба, 5);
	Ожидаем.Что(Ловушка.Количество(), "отвал базы добавил ровно одну строку: " + Ловушка.Всё()).Равно(2);
	Ожидаем.Что(Ловушка.Сообщение(1), "строка называет причину")
		.Содержит("server closed the connection unexpectedly");

	База.ПадатьС("");
	Опросить(Проба, 5);
	Ожидаем.Что(Ловушка.Количество(), "возврат базы тоже одна строка: " + Ловушка.Всё()).Равно(3);

КонецПроцедуры

#КонецОбласти

#Область ЖиваяФайловаяБаза

// На КоннектореJSON SQL нет: проба работает выборкой, одинаковой на любом бэкенде.
&Тест
Процедура НаКоннектореJSONПробаОтвечаетОк() Экспорт

	Состояние = ЖиваяПроба().Состояние();

	Ожидаем.Что(Состояние["status"], "файловая база отвечает").Равно("ok");
	Ожидаем.Что(Состояние["pool"]["limit"], "предел пула — из источника данных").Равно(10);
	Ожидаем.Что(Состояние["pool"]["created"] <= 10, "занятых мест не больше предела").ЭтоИстина();

КонецПроцедуры

// Проба не оставляет за собой занятого соединения — иначе пул кончился бы за минуту.
&Тест
Процедура ПробаНеОставляетЗаСобойЗанятогоСоединения() Экспорт

	Проба = ЖиваяПроба();
	Опросить(Проба, 3);

	Ожидаем.Что(ЖивойИсточник.ПулСоединений().КоличествоЗанятых(),
		"после проб у потоков не осталось соединений").Равно(0);
	Ожидаем.Что(ЖивойИсточник.ПулСоединений().КоличествоОжидающих(),
		"и в очереди никто не стоит").Равно(0);

КонецПроцедуры

// Проба только читает: запись на каждый вызов — износ диска и мусор в таблице.
&Тест
Процедура ПробаЧитаетИзБазыИНичегоВНеёНеПишет() Экспорт

	СчётчикБазы.Обнулить();
	Опросить(ЖиваяПроба(), 3);

	Ожидаем.Что(СчётчикБазы.Чтений("ПрикладныеНастройки"), "каждая проба читает").Равно(3);
	Ожидаем.Что(СчётчикБазы.Записей("ПрикладныеНастройки"), "и не пишет ничего").Равно(0);

КонецПроцедуры

// Закрытый источник пула не отдаёт: раздела pool в теле нет, а не нули.
&Тест
Процедура ЗакрытыйИсточникДаётОтказБезСнимкаПула() Экспорт

	Источник = ИсточникНаФайлах("проба-закрытие");
	Источник.Закрыть();

	// до строки таблицы проба не доходит: снимок пула закрытого источника падает раньше
	Состояние = ПробаНаБазе(Источник, ЖивыеНастройки).Состояние();

	Ожидаем.Что(Состояние["status"], "закрытый источник — база не отвечает").Равно("unavailable");
	Ожидаем.Что(ЗначениеЗаполнено(Состояние["reason"]), "причина названа").ЭтоИстина();
	Ожидаем.Что(Состояние.Свойство("pool"), "снимка пула нет: снимать нечего").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область АдресЖивости

// /health отвечает 200, пока жив процесс, и называет состояние базы.
&Тест
Процедура ЗдоровьеОтдаёт200СРазделомБазыДажеКогдаБазаНеОтвечает() Экспорт

	База = БазаСПулом(10, 0, 4, 10);
	Ответ = Новый ОтветГотовности();
	ДверьЗдоровья(База).Здоровье(Ответ);

	Ожидаем.Что(Ответ.Код, "процесс жив -> 200 независимо от базы").Равно(200);

	Тело = РазобратьJSON(Ответ.ТелоТекст);
	Ожидаем.Что(Тело["status"], "живость — по процессу").Равно("ok");
	Ожидаем.Что(Тело["database"]["status"], "а база названа своей").Равно("unavailable");
	Ожидаем.Что(Тело["database"]["reason"], "с причиной").Содержит("пул соединений исчерпан");
	Ожидаем.Что(Тело["database"]["pool"]["limit"], "и со снимком пула").Равно(10);

КонецПроцедуры

&Тест
Процедура ЗдоровьеОтвечающейБазыПоказываетОкИСнимок() Экспорт

	Ответ = Новый ОтветГотовности();
	ДверьЗдоровья(БазаСПулом(1, 9, 0, 10)).Здоровье(Ответ);

	Тело = РазобратьJSON(Ответ.ТелоТекст);
	Ожидаем.Что(Ответ.Код).Равно(200);
	Ожидаем.Что(Тело["database"]["status"]).Равно("ok");
	Ожидаем.Что(Тело["database"]["pool"]["busy"], "снимок пула в теле живости").Равно(1);
	Ожидаем.Что(Тело["uptime_seconds"], "прежние поля живости на месте").ИмеетТип("Число");

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Хранилище настроек с деривованным методом собирает только контейнер.
Процедура ПоднятьЖивуюБазу()

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторJSON");
	ИсточникДанных.Вставить("СтрокаСоединения", ВременныйКаталог("проба-базы"));

	Детальки = Новый Соответствие();
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	ЖивойИсточник = Поделка.НайтиЖелудь("ИсточникДанных");
	ЖивыеНастройки = Новый НастройкиНадХранилищем(Поделка.НайтиЖелудь("ХранилищеПрикладныхНастроек"));

	СчётчикБазы = Новый СчётчикЗапросовБазы();
	ЖивойИсточник.ДобавитьНаблюдателя(СчётчикБазы);

КонецПроцедуры

Функция ИсточникНаФайлах(Знач Имя)

	Источник = Новый ИсточникДанных(Имя, Тип("КоннекторJSON"), ВременныйКаталог(Имя));
	// источник переживает поток, в котором собран: иначе его закрыл бы конец теста
	Источник.УстановитьАвтоЗакрытие(Ложь);

	Возврат Источник;

КонецФункции

// Создано по умолчанию — занятые плюс свободные: пул без броней под открываемые соединения.
Функция БазаСПулом(Знач Занято, Знач Свободно, Знач Ожидают, Знач Предел,
	Знач Создано = Неопределено)

	Пул = Новый ФейкПулСоединений(Занято, Свободно, Ожидают, Создано);

	Возврат Новый ФейкБазыПробы(Пул, Предел);

КонецФункции

Функция ВременныйКаталог(Знач Имя)

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-" + Имя);
	ВременныеКаталоги.Добавить(Каталог);

	Возврат Каталог;

КонецФункции

// Фейк отвечает и за снимок пула, и за чтение строки.
Функция ПробаНа(Знач База, Знач Ловушка = Неопределено)
	Возврат ПробаНаБазе(База, База, Ловушка);
КонецФункции

Функция ЖиваяПроба()
	Возврат ПробаНаБазе(ЖивойИсточник, ЖивыеНастройки);
КонецФункции

Функция ПробаНаБазе(Знач Источник, Знач Настройки, Знач Ловушка = Неопределено)

	Лог = Логирование.ПолучитьЛог("тест.oshub.проба." + Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Если Ловушка <> Неопределено Тогда
		Лог.ДобавитьСпособВывода(Ловушка);
	КонецЕсли;

	Возврат Новый ПробаБазы(Источник, Настройки, Лог);

КонецФункции

Функция ДверьЗдоровья(Знач База)

	Живость = Новый ЖивостьХаба(Новый СостояниеХаба(), Новый ОписаниеПриложения(), ПробаНа(База));
	Возврат Новый КонтроллерЗдоровья(Живость, Новый ОтветыAPI(Новый ЗаголовкиHTTP()));

КонецФункции

Процедура Опросить(Знач Проба, Знач Сколько)

	Для Счётчик = 1 По Сколько Цикл
		Проба.Состояние();
	КонецЦикла;

КонецПроцедуры

Функция РазобратьJSON(Знач Текст)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Значение;

КонецФункции

