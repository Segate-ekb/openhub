// Новая версия хаба: порядок semver, событие один раз на версию и после рестарта, выключатель,
// тихий отказ источника, сведения экрану без похода в сеть — на таблице в памяти и фейке транспорта.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать autumn-logos
#Использовать entity
#Использовать "../фикстуры"

Перем Поделка;     // контейнер с таблицей отметок выпуска в памяти
Перем Транспорт;   // ФейкТранспортHTTP — ответ источника
Перем Настройки;   // НастройкиЗаглушка — выключатель и адрес источника
Перем Приложение;  // ОписаниеПриложенияЗаглушка — своя версия хаба
Перем Подписчик;   // ЗаписывающийПодписчик — что разослано
Перем Издатель;    // ИздательСобытий
Перем Выпуски;     // ВыпускиХаба

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("ТаблицыВПамяти");
	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ФейкТранспортHTTP");
	РеестрФикстур.Подключить("ЗаписывающийПодписчик");
	РеестрФикстур.Подключить("ОписаниеПриложенияЗаглушка");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ХранилищеОтметокПадающее");

	Поделка = Новый ТаблицыВПамяти().Поднять("состояние", "выпуски-хаба");

	Поиск = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();
	Поиск.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));
	Поиск.Подключить(ОбъединитьПути(Модули, "сеть", "Классы"), "ТаймаутыHTTP");
	Поиск.Подключить(ОбъединитьПути(Модули, "фоновыеЗадания", "Классы"), "РегистрацииЗадачи");
	Поиск.ПодключитьВсе(ОбъединитьПути(Модули, "состояние", "Классы", "выпуски"));
	Для Каждого Имя Из СтрРазделить("ВидыПроверок,ОбъявленияНастроек,ВалидаторНастроек", ",") Цикл
		Поиск.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), Имя);
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура СобратьВыпуски() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200, Карточка("0.21.0"));
	Настройки = Новый НастройкиЗаглушка();
	Приложение = Новый ОписаниеПриложенияЗаглушка("0.20.6");
	Издатель = Новый ИздательСобытий();
	Подписчик = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипВышлаВерсияХаба(), Подписчик);

	// таблица одна на набор: каждый тест начинает с хаба, который источник ещё не спрашивал
	Отметки().Записать(Новый Структура("Последняя, Проверено, Ошибка, Объявлена", "", '00010101', "", ""));
	Выпуски = НовыеВыпуски();

КонецПроцедуры

#Область ПорядокВерсий

&Тест
Процедура НовееТолькоСтрогоСтаршаяВерсияSemver() Экспорт

	Новизна = Новый НовизнаВыпуска();
	Таблица = Новый Массив();
	Таблица.Добавить(Случай("0.21.0", "0.20.6", Истина, "минор старше"));
	Таблица.Добавить(Случай("0.20.7", "0.20.6", Истина, "патч старше"));
	Таблица.Добавить(Случай("1.0.0", "0.99.99", Истина, "мажор старше"));
	Таблица.Добавить(Случай("0.20.6", "0.20.6", Ложь, "та же версия"));
	Таблица.Добавить(Случай("0.20.5", "0.20.6", Ложь, "младше"));
	Таблица.Добавить(Случай("0.21.0", "0.21.0-ui.9", Истина, "релиз старше своего пре-релиза"));
	Таблица.Добавить(Случай("0.20.6", "0.21.0-ui.9", Ложь, "прошлый релиз младше пре-релиза следующего"));
	Таблица.Добавить(Случай("0.21.0-ui.10", "0.21.0-ui.9", Истина, "пре-релизы — по числу"));
	Таблица.Добавить(Случай("0.21.0-ui.9", "0.21.0", Ложь, "пре-релиз младше своего релиза"));
	Таблица.Добавить(Случай("0.21.0+build.2", "0.21.0", Ложь, "метаданные сборки порядка не меняют"));
	Таблица.Добавить(Случай("0.21.1+build.1", "0.21.0", Истина, "и не мешают старшей версии"));
	Таблица.Добавить(Случай("мусор", "0.20.6", Ложь, "негодная строка новой не бывает"));
	Таблица.Добавить(Случай("", "0.20.6", Ложь, "пустая строка новой не бывает"));
	Таблица.Добавить(Случай("0.21.0", "мусор", Ложь, "с негодной своей версией сравнивать не с чем"));

	Для Каждого Запись Из Таблица Цикл
		Ожидаем.Что(Новизна.Новее(Запись.Кандидат, Запись.Эталон),
			СтрШаблон("%1 против %2: %3", Запись.Кандидат, Запись.Эталон, Запись.Смысл)).Равно(Запись.Новее);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОдинРазНаВерсию

&Тест
Процедура НоваяВерсияОбъявляетсяСобытиемСоСвоейИНовойВерсией() Экспорт

	Выпуски.Проверить();

	Ожидаем.Что(Подписчик.Количество(), "о новой версии разослано событие").Равно(1);
	Данные = Подписчик.Первое(Издатель.ТипВышлаВерсияХаба()).Данные;
	Ожидаем.Что(Данные.Версия, "новая версия").Равно("0.21.0");
	Ожидаем.Что(Данные.Текущая, "своя версия").Равно("0.20.6");
	Ожидаем.Что(Данные.Ссылка, "страница пакета у источника").Равно("https://hub.oscript.io/pools/default/packages/openhub");
	Ожидаем.Что(Транспорт.URLПоследний(), "спрошен источник по умолчанию")
		.Равно("https://hub.oscript.io/api/v1/pools/default/packages/openhub");

КонецПроцедуры

&Тест
Процедура ОТойЖеВерсииВтораяПроверкаНеСообщает() Экспорт

	Выпуски.Проверить();
	Выпуски.Проверить();

	Ожидаем.Что(Транспорт.КоличествоВызовов(), "источник спрошен оба раза").Равно(2);
	Ожидаем.Что(Подписчик.Количество(), "событие одно на версию").Равно(1);

КонецПроцедуры

&Тест
Процедура РестартОТойЖеВерсииНеСообщает() Экспорт

	Выпуски.Проверить();
	ПослеРестарта = НовыеВыпуски();
	ПослеРестарта.Проверить();

	Ожидаем.Что(Подписчик.Количество(), "объявленная версия пережила новый процесс").Равно(1);

КонецПроцедуры

&Тест
Процедура СледующаяВерсияОбъявляетсяСвоимСобытием() Экспорт

	Выпуски.Проверить();
	Транспорт.УстановитьОтвет(200, Карточка("0.22.0"));
	Выпуски.Проверить();

	Ожидаем.Что(Подписчик.Количество(), "о каждой новой версии — своё событие").Равно(2);
	Ожидаем.Что(Подписчик.События[1].Данные.Версия, "второе — о следующей").Равно("0.22.0");

КонецПроцедуры

&Тест
Процедура ВерсияНеНовееСвоейНеОбъявляется() Экспорт

	Транспорт.УстановитьОтвет(200, Карточка("0.20.6"));
	Выпуски.Проверить();
	Ожидаем.Что(Подписчик.Количество(), "своя версия — не новая").Равно(0);

	Приложение.УстановитьВерсию("0.21.0-ui.9");
	Выпуски.Проверить();
	Ожидаем.Что(Подписчик.Количество(), "прошлый релиз не новее пре-релиза следующего").Равно(0);
	Ожидаем.Что(Выпуски.Сведения().Доступна, "и плашки нет").ЭтоЛожь();

	Транспорт.УстановитьОтвет(200, Карточка("0.21.0"));
	Выпуски.Проверить();
	Ожидаем.Что(Подписчик.Количество(), "релиз новее своего пре-релиза").Равно(1);

КонецПроцедуры

&Тест
Процедура ВерсияНеНовееОбъявленнойНеОбъявляется() Экспорт

	Транспорт.УстановитьОтвет(200, Карточка("0.22.0"));
	Выпуски.Проверить();
	// у источника отозвали последнюю: прежняя новее своей, но о ней уже было бы сказано раньше
	Транспорт.УстановитьОтвет(200, Карточка("0.21.0"));
	Выпуски.Проверить();

	Ожидаем.Что(Подписчик.Количество(), "о версии младше объявленной не сообщают").Равно(1);
	Ожидаем.Что(Выпуски.Сведения().Новая, "плашка говорит о том, что источник назвал сейчас").Равно("0.21.0");

КонецПроцедуры

#КонецОбласти

#Область Выключатель

&Тест
Процедура ВыключеннаяПроверкаНаружуНеХодитИНичегоНеГоворит() Экспорт

	Выпуски.Проверить();
	Настройки.Задать(Выпуски.КлючПроверки(), Ложь);
	Транспорт.УстановитьОтвет(200, Карточка("0.22.0"));

	Выпуски.Проверить();

	Ожидаем.Что(Транспорт.КоличествоВызовов(), "выключенная проверка наружу не ходит").Равно(1);
	Ожидаем.Что(Подписчик.Количество(), "и событий не шлёт").Равно(1);
	Ожидаем.Что(Выпуски.Сведения().Доступна, "плашки при выключенной проверке нет, хоть версия и известна")
		.ЭтоЛожь();
	Ожидаем.Что(Выпуски.Сведения().Новая, "отметка выключением не тронута").Равно("0.21.0");

КонецПроцедуры

#КонецОбласти

#Область ОтказИсточника

&Тест
Процедура ОтказСетиТихийЗадачаНеПадаетСобытияНет() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(ЛогТеста(), УровниЛога.Отладка);
	Транспорт.ЭмулироватьОффлайн("connection refused");

	Попытка
		Выпуски.Проверить();
	Исключение
		Ловушка.Снять();
		ВызватьИсключение СтрШаблон("отказ сети вылетел из проверки: %1", ОписаниеОшибки());
	КонецПопытки;
	Ловушка.Снять();

	Ожидаем.Что(Подписчик.Количество(), "событий нет").Равно(0);
	Сведения = Выпуски.Сведения();
	Ожидаем.Что(Сведения.Доступна, "плашки нет").ЭтоЛожь();
	Ожидаем.Что(Сведения.Ошибка, "причина в отметке").Содержит("connection refused");
	Ожидаем.Что(ЗначениеЗаполнено(Сведения.Проверено), "момент проверки записан").ЭтоИстина();
	Ожидаем.Что(Ловушка.Всё(), "строка в журнале").Содержит("Новая версия хаба не проверена");

КонецПроцедуры

&Тест
Процедура ЧужойОтветИсточникаНазываетсяПричиной() Экспорт

	Случаи = Новый Массив();
	Случаи.Добавить(Новый Структура("Код, Тело, Причина", 503, Карточка("0.21.0"), "кодом 503"));
	Случаи.Добавить(Новый Структура("Код, Тело, Причина", 200,
		ПолучитьДвоичныеДанныеИзСтроки("<html>не JSON</html>"), "latest_version"));
	Случаи.Добавить(Новый Структура("Код, Тело, Причина", 200,
		ПолучитьДвоичныеДанныеИзСтроки("{""package"": {""name"": ""openhub""}}"), "latest_version"));
	Случаи.Добавить(Новый Структура("Код, Тело, Причина", 200,
		ПолучитьДвоичныеДанныеИзСтроки("[1, 2]"), "latest_version"));

	Для Каждого Случай Из Случаи Цикл
		Транспорт.УстановитьОтвет(Случай.Код, Случай.Тело);
		Выпуски.Проверить();
		Ожидаем.Что(Выпуски.Сведения().Ошибка, "причина отказа словами").Содержит(Случай.Причина);
	КонецЦикла;
	Ожидаем.Что(Подписчик.Количество(), "ни один чужой ответ события не дал").Равно(0);

КонецПроцедуры

&Тест
Процедура ПослеОтказаПлашкиНетАУдачаВозвращаетЕёБезВторогоСобытия() Экспорт

	Выпуски.Проверить();
	Ожидаем.Что(Выпуски.Сведения().Доступна, "после удачной проверки плашка есть").ЭтоИстина();

	Транспорт.ЭмулироватьОффлайн();
	Выпуски.Проверить();
	Сведения = Выпуски.Сведения();
	Ожидаем.Что(Сведения.Доступна, "последняя проверка не удалась — плашки нет").ЭтоЛожь();
	Ожидаем.Что(Сведения.Новая, "увиденная версия не стёрта").Равно("0.21.0");

	Транспорт.УстановитьОтвет(200, Карточка("0.21.0"));
	Выпуски.Проверить();
	Ожидаем.Что(Выпуски.Сведения().Доступна, "удачная проверка вернула плашку").ЭтоИстина();
	Ожидаем.Что(Подписчик.Количество(), "о той же версии второй раз не сообщено").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область АдресИсточника

// Адрес источника судится до похода: чужая схема, данные пользователя и пробел наружу не уходят,
// причина называет адрес без пароля. Ключ объявлен с проверкой формы — опечатку отбивает сохранение.
&Тест
Процедура НегодныйАдресИсточникаНаружуНеСпрашивается() Экспорт

	Для Каждого Адрес Из СтрРазделить("ftp://hub.example.org/api/v1/pools/main/packages/openhub|"
		+ "https://bot:s3cret@hub.example.org/api/v1/pools/main/packages/openhub|"
		+ "https://hub example.org/api/v1/pools/main/packages/openhub", "|") Цикл
		Настройки.Задать(Выпуски.КлючИсточника(), Адрес);
		Выпуски.Проверить();
		Ошибка = Выпуски.Сведения().Ошибка;
		Ожидаем.Что(Ошибка, "причина названа: " + Адрес).Содержит("адрес источника выпусков негоден");
		Ожидаем.Что(Ошибка, "пароля в причине нет").Не_().Содержит("s3cret");
	КонецЦикла;
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "негодный адрес наружу не спрошен").Равно(0);
	Ожидаем.Что(Выпуски.Сведения().Страница, "и на кнопку он без пароля не просится").Не_().Содержит("s3cret");

	Ключи = Новый КлючиНастроекВыпусков(Новый ВидыПроверок());
	Описание = Неопределено;
	Для Каждого Объявление Из Ключи.Объявления().Ключи() Цикл
		Если Объявление.Ключ = Выпуски.КлючИсточника() Тогда
			Описание = Объявление;
		КонецЕсли;
	КонецЦикла;
	Валидатор = Новый ВалидаторНастроек(Новый КанонIP());
	Отказ = "";
	Попытка
		Валидатор.Проверить("https://bot:s3cret@hub.example.org/api/v1/x", Описание, Неопределено);
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "сохранение адреса с паролем отбито проверкой ключа").Заполнено();
	Попытка
		Валидатор.Проверить(Выпуски.ИсточникПоУмолчанию(), Описание, Неопределено);
	Исключение
		ВызватьИсключение "КОНТРОЛЬ: адрес по умолчанию проверку ключа не прошёл: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Карточке пакета хватает килобайт: ответ больше потолка в память не разбирается и версией не считается.
&Тест
Процедура СлишкомБольшойОтветИсточникаОтвергается() Экспорт

	Транспорт.УстановитьОтвет(200, ПолучитьДвоичныеДанныеИзСтроки(
		СтрШаблон("{""package"": {""latest_version"": ""0.21.0"", ""x"": ""%1""}}", Повтор("x", 1100000))));

	Выпуски.Проверить();

	Ожидаем.Что(Выпуски.Сведения().Ошибка, "причина — потолок").Содержит("больше потолка");
	Ожидаем.Что(Подписчик.Количество(), "события нет").Равно(0);

КонецПроцедуры

// Сбой хранилища отметки — не отказ сети: он перебрасывается, и журнал задач назовёт прогон упавшим.
&Тест
Процедура СбойХранилищаОтметкиНеГлушится() Экспорт

	Падающие = Новый ВыпускиХаба(Новый ИсточникВыпусков(Транспорт, Новый ТаймаутыHTTP()), Новый НовизнаВыпуска(),
		Новый ХранилищеОтметокПадающее(), Настройки, Приложение, Издатель, ЛогТеста());
	Отказ = "";
	Попытка
		Падающие.Проверить();
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "сбой хранилища вышел наружу").Содержит("хранилище отметок недоступно");
	Ожидаем.Что(Подписчик.Количество(), "события без отметки нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Источник

&Тест
Процедура АдресИсточникаБерётсяИзНастройкиАСтраницаИзНегоБезAPI() Экспорт

	Настройки.Задать(Выпуски.КлючИсточника(), "https://hub.example.org/api/v1/pools/main/packages/openhub");

	Выпуски.Проверить();

	Ожидаем.Что(Транспорт.URLПоследний(), "спрошен источник из настройки")
		.Равно("https://hub.example.org/api/v1/pools/main/packages/openhub");
	Ожидаем.Что(Транспорт.РедиректыПоследний(), "по Location проверка не ходит").ЭтоЛожь();
	Ожидаем.Что(Подписчик.Первое(Издатель.ТипВышлаВерсияХаба()).Данные.Ссылка, "страница пакета у этого источника")
		.Равно("https://hub.example.org/pools/main/packages/openhub");
	Ожидаем.Что(Выпуски.Сведения().Страница, "та же страница у экрана")
		.Равно("https://hub.example.org/pools/main/packages/openhub");

КонецПроцедуры

&Тест
Процедура СведенияЭкрануНеХодятВСеть() Экспорт

	Выпуски.Проверить();
	ДоЭкрана = Транспорт.КоличествоВызовов();

	Сведения = Выпуски.Сведения();

	Ожидаем.Что(Транспорт.КоличествоВызовов(), "экран источник не спрашивает").Равно(ДоЭкрана);
	Ожидаем.Что(Сведения.Доступна, "новая версия известна").ЭтоИстина();
	Ожидаем.Что(Сведения.Новая, "какая").Равно("0.21.0");
	Ожидаем.Что(Сведения.Своя, "у этого хаба").Равно("0.20.6");

КонецПроцедуры

&Тест
Процедура ДоПервойПроверкиНовойВерсииНет() Экспорт

	Сведения = Выпуски.Сведения();

	Ожидаем.Что(Сведения.Доступна, "не проверялось — плашки нет").ЭтоЛожь();
	Ожидаем.Что(Сведения.Проверено, "момента проверки нет").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Задача

&Тест
Процедура ЗадачаСпрашиваетВскореПослеСтартаИРазВСутки() Экспорт

	Задача = Новый ЗадачаПроверкиВыпуска(Выпуски);
	Регистрации = Новый РегистрацииЗадачи();
	Задача.Зарегистрировать(Регистрации);

	Состав = Новый Массив();
	Для Каждого Регистрация Из Регистрации.Состав() Цикл
		Состав.Добавить(Регистрация.Имя + " — " + Регистрация.Описание);
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Состав, Символы.ПС), "регистрации задачи").Равно(
		"проверка-выпуска-хаба-при-старте — однократно, через 300 с после старта" + Символы.ПС
		+ "проверка-выпуска-хаба — каждые 86400 с");

	Транспорт.ЭмулироватьОффлайн();
	Задача.Исполнить();
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "задача спросила источник и не упала на отказе").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Обвязка

Функция НовыеВыпуски()
	Возврат Новый ВыпускиХаба(Новый ИсточникВыпусков(Транспорт, Новый ТаймаутыHTTP()), Новый НовизнаВыпуска(),
		Отметки(), Настройки, Приложение, Издатель, ЛогТеста());
КонецФункции

Функция Отметки()
	Возврат Поделка.НайтиЖелудь("ХранилищеОтметокВыпуска");
КонецФункции

// Карточка пакета, как её отдаёт API хаба пакетов: лишние поля проверку не смущают.
Функция Карточка(Знач Версия)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(СтрШаблон("{""package"": {""id"": 229, ""name"": ""openhub"","
		+ " ""pool"": ""default"", ""latest_version"": ""%1"", ""tags"": []}}", Версия));
КонецФункции

Функция Случай(Знач Кандидат, Знач Эталон, Знач Новее, Знач Смысл)
	Возврат Новый Структура("Кандидат, Эталон, Новее, Смысл", Кандидат, Эталон, Новее, Смысл);
КонецФункции

Функция Повтор(Знач Символ, Знач Сколько)
	Части = Новый Массив(Сколько + 1);
	Возврат СтрСоединить(Части, Символ);
КонецФункции

Функция ЛогТеста()
	Возврат Логирование.ПолучитьЛог("тест.oshub.состояние.выпуски");
КонецФункции

#КонецОбласти
