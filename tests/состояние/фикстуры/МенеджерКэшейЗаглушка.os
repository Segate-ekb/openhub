// МенеджерКэшей autumn-cache в объёме, которым пользуются приборы хаба: кэш по имени отдаёт
// заданную статистику и помнит, о каких кэшах спрашивали.

Перем Статистики;   // Соответствие: имя кэша -> Структура(Попадания, Промахи, Вытеснения, Занято)
Перем Спрошено;     // Массив из Строка — имена кэшей в порядке вопросов

// Задаёт статистику кэша.
//
// Параметры:
//  Имя        - Строка - имя кэша.
//  Попадания  - Число  - попадания с начала процесса.
//  Промахи    - Число  - промахи с начала процесса.
//
Процедура Задать(Знач Имя, Знач Попадания, Знач Промахи) Экспорт
	Статистики.Вставить(Имя, Новый Структура("Попадания, Промахи, Вытеснения, Занято", Попадания, Промахи, 0, 0));
КонецПроцедуры

// Кэш по имени — контракт МенеджерКэшей.
//
// Параметры:
//  Имя - Строка - имя кэша.
//
// Возвращаемое значение:
//  МенеджерКэшейЗаглушка - сам менеджер, настроенный отвечать за этот кэш.
//
Функция Кэш(Знач Имя) Экспорт

	Спрошено.Добавить(Имя);
	Если Статистики.Получить(Имя) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("кэш ""%1"" не заводили", Имя);
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Статистика кэша, о котором спросили последним, — контракт Кэш.
//
// Возвращаемое значение:
//  Структура - Попадания, Промахи, Вытеснения, Занято.
//
Функция Статистика() Экспорт
	Возврат Статистики[Спрошено[Спрошено.ВГраница()]];
КонецФункции

// Имена кэшей в порядке вопросов.
//
// Возвращаемое значение:
//  Массив из Строка - имена.
//
Функция Спрошено() Экспорт
	Возврат Спрошено;
КонецФункции

Процедура ПриСозданииОбъекта()
	Статистики = Новый Соответствие();
	Спрошено = Новый Массив();
КонецПроцедуры
