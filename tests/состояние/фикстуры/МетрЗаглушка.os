// Фейковый SDK и метр телеметрии: помнит заведённые приборы и обратные вызовы, а Снять()
// проигрывает срез так же, как его проигрывает настоящий метр — своим набором наблюдений
// на каждую регистрацию. Контракт — в объёме, которым пользуются приборы хаба.

Перем Приборы;         // имя -> ПриборЗаглушка
Перем ОбратныеВызовы;  // Массив из Структура(Действие, Приборы)

#Область КонтрактSdk

// Контракт ОтелSdk: метр области инструментирования. Метр у заглушки один.
//
// Параметры:
//  ИмяОбласти - Строка - имя области инструментирования.
//
// Возвращаемое значение:
//  МетрЗаглушка - этот же объект.
//
Функция ПолучитьМетр(Знач ИмяОбласти) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область КонтрактМетра

// Синхронный счётчик.
//
// Параметры:
//  Имя - Строка - имя прибора.
//  Описание - Строка - описание прибора (необязательный).
//  ЕдиницаИзмерения - Строка - единица измерения (необязательный).
//
// Возвращаемое значение:
//  ПриборЗаглушка.
//
Функция СоздатьСчетчик(Знач Имя, Знач Описание = "", Знач ЕдиницаИзмерения = "") Экспорт
	Возврат Завести(Имя, "Counter", ЕдиницаИзмерения);
КонецФункции

// Наблюдаемый датчик.
//
// Параметры:
//  Имя - Строка - имя прибора.
//  Обратный - Произвольный - обратный вызов одного прибора (необязательный).
//  Описание - Строка - описание прибора (необязательный).
//  ЕдиницаИзмерения - Строка - единица измерения (необязательный).
//
// Возвращаемое значение:
//  ПриборЗаглушка.
//
Функция СоздатьНаблюдаемыйДатчик(Знач Имя, Знач Обратный = Неопределено, Знач Описание = "",
	Знач ЕдиницаИзмерения = "") Экспорт
	Возврат Завести(Имя, "ObservableGauge", ЕдиницаИзмерения);
КонецФункции

// Наблюдаемый счётчик.
//
// Параметры:
//  Имя - Строка - имя прибора.
//  Обратный - Произвольный - обратный вызов одного прибора (необязательный).
//  Описание - Строка - описание прибора (необязательный).
//  ЕдиницаИзмерения - Строка - единица измерения (необязательный).
//
// Возвращаемое значение:
//  ПриборЗаглушка.
//
Функция СоздатьНаблюдаемыйСчетчик(Знач Имя, Знач Обратный = Неопределено, Знач Описание = "",
	Знач ЕдиницаИзмерения = "") Экспорт
	Возврат Завести(Имя, "ObservableCounter", ЕдиницаИзмерения);
КонецФункции

// Мульти-обратный вызов: на срезе метр позовёт его со своим набором наблюдений.
//
// Параметры:
//  Действие - Действие - обратный вызов.
//  НовыеИнструменты - Массив - приборы этой регистрации.
//  Состояние - Произвольный - произвольное состояние регистрации (необязательный).
//
Процедура ЗарегистрироватьОбратныйВызов(Знач Действие, Знач НовыеИнструменты,
	Знач Состояние = Неопределено) Экспорт

	ОбратныеВызовы.Добавить(Новый Структура("Действие, Приборы", Действие, НовыеИнструменты));

КонецПроцедуры

#КонецОбласти

#Область ЧтоУвиделаЗаглушка

// Проигрывает срез: каждой регистрации — свой набор наблюдений, как у настоящего метра.
//
// Возвращаемое значение:
//  Соответствие - имя прибора -> НаблюдениеЗаписью.
//
Функция Снять() Экспорт

	Снятое = Новый Соответствие();

	Для Каждого Регистрация Из ОбратныеВызовы Цикл
		Свои = Новый Соответствие();
		Для Каждого Прибор Из Регистрация.Приборы Цикл
			Приём = Новый НаблюдениеЗаписью();
			Свои.Вставить(Прибор.Имя(), Приём);
			Снятое.Вставить(Прибор.Имя(), Приём);
		КонецЦикла;
		Регистрация.Действие.Выполнить(Свои);
	КонецЦикла;

	Возврат Снятое;

КонецФункции

// Прибор по имени; Неопределено — такого не заводили.
//
// Параметры:
//  Имя - Строка - имя прибора.
//
// Возвращаемое значение:
//  ПриборЗаглушка, Неопределено.
//
Функция Прибор(Знач Имя) Экспорт
	Возврат Приборы.Получить(Имя);
КонецФункции

// Сколько приборов заведено.
//
// Возвращаемое значение:
//  Число.
//
Функция ЗаведеноПриборов() Экспорт
	Возврат Приборы.Количество();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Завести(Знач Имя, Знач Вид, Знач ЕдиницаИзмерения)

	Прибор = Новый ПриборЗаглушка(Имя, Вид, ЕдиницаИзмерения);
	Приборы.Вставить(Имя, Прибор);

	Возврат Прибор;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Приборы = Новый Соответствие();
	ОбратныеВызовы = Новый Массив();
КонецПроцедуры
