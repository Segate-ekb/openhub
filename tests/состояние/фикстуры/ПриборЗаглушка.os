// Прибор фейкового метра: помнит, чем его завели, и что ему насчитали. Контракт
// ОтелСчетчик в объёме, которым пользуются приборы хаба.

Перем ИмяПрибора;
Перем ВидПрибора;
Перем Единица;
Перем Записи;   // Массив из Структура(Значение, Атрибуты)
Перем Срываться;

#Область ПубличныйИнтерфейс

// Контракт синхронного счётчика: прибавить к счётчику.
//
// Параметры:
//  Значение - Число - прибавка.
//  Атрибуты - ОтелАтрибуты - атрибуты точки данных (необязательный).
//
Процедура Добавить(Знач Значение, Знач Атрибуты = Неопределено) Экспорт

	Если Срываться Тогда
		ВызватьИсключение "ПриборЗаглушка: намеренный сбой прибора " + ИмяПрибора;
	КонецЕсли;

	Записи.Добавить(Новый Структура("Значение, Атрибуты", Значение, Атрибуты));

КонецПроцедуры

// Заставляет прибор срываться на каждой прибавке: так проверяется, что сбой телеметрии
// не выносится наружу к тем, кто о приборах не знает.
//
Процедура Сорваться() Экспорт
	Срываться = Истина;
КонецПроцедуры

// Имя прибора — им метр раскладывает наблюдения по приборам.
//
// Возвращаемое значение:
//  Строка.
//
Функция Имя() Экспорт
	Возврат ИмяПрибора;
КонецФункции

// Вид прибора: Counter, ObservableGauge либо ObservableCounter.
//
// Возвращаемое значение:
//  Строка.
//
Функция Вид() Экспорт
	Возврат ВидПрибора;
КонецФункции

// Единица измерения, с которой прибор заведён.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЕдиницаИзмерения() Экспорт
	Возврат Единица;
КонецФункции

// Сколько раз прибору прибавляли.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Записи.Количество();
КонецФункции

// Всё, что прибору насчитали.
//
// Возвращаемое значение:
//  Массив из Структура - Значение (Число), Атрибуты (ОтелАтрибуты).
//
Функция Записи() Экспорт
	Возврат Записи;
КонецФункции

// Значение атрибута последней прибавки; пустая строка — прибавок не было либо атрибута
// в них нет.
//
// Параметры:
//  Ключ - Строка - ключ атрибута.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПоследнийАтрибут(Знач Ключ) Экспорт

	Если Записи.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Атрибуты = Записи[Записи.ВГраница()].Атрибуты;
	Если Атрибуты = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = Атрибуты.Получить(Ключ);

	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач НовоеИмя, Знач НовыйВид = "", Знач НоваяЕдиница = "")

	ИмяПрибора = НовоеИмя;
	ВидПрибора = НовыйВид;
	Единица = НоваяЕдиница;
	Записи = Новый Массив();
	Срываться = Ложь;

КонецПроцедуры
