// HTTP-тесты картинок оформления на настоящем хабе: администратор загружает логотип
// и иконку формой раздела «Брендирование», хаб рисует их в шапке и в <head>, отдаёт
// своим адресом с отпечатком содержимого и возвращает фирменные по кнопке.
// Формы отправляются ровно теми полями, которые печатает сама страница.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем ЛогинАдмина;
Перем ПарольАдмина;
Перем КукаАдмина;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ЛогинАдмина = "root";
	ПарольАдмина = "RootPassw0rd";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);
	Хаб.ФайловаяБаза("openhub-картинки-бренда");
	// администратор заводится онбордингом, а не деталькой: у заведённого конфигом
	// хаб требует смены пароля и уводит с настроек на /me/settings/security
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// инсталляция без почты выбирает одну из двух развилок (ИСТ-ПОЧТ-007); здесь —
	// выключенное подтверждение адреса, иначе регистрация закрыта
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");
	Хаб.Запустить();

	КукаАдмина = ЗавестиАдмина();
	Ожидаем.Что(ЗначениеЗаполнено(КукаАдмина), "администратор вошёл").ЭтоИстина();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

&ПередКаждым
Процедура ВернутьФирменные() Экспорт
	Сбросить("logo");
	Сбросить("favicon");
КонецПроцедуры

#Область Логотип

// Главное обещание волны: положил файл — он и висит в шапке, а по своему адресу
// отдаётся ровно теми байтами, которыми его загрузили.
&Тест
Процедура ЗагруженныйЛоготипРисуетсяВШапкеИОтдаётсяБайтВБайт() Экспорт

	ДоЗагрузки = АдресЗнакаСоСтраницы();
	Ожидаем.Что(СтрНачинаетсяС(ДоЗагрузки, "/static/"), "до загрузки в шапке фирменный знак: "
		+ ДоЗагрузки).ЭтоИстина();

	Картинка = КартинкаPNG();
	Ответ = Загрузить("logo", "лого.png", "image/png", Картинка);
	ПроверитьСохранение(Ответ, "форма принята");

	Адрес = АдресЗнакаСоСтраницы();
	Ожидаем.Что(СтрНачинаетсяС(Адрес, "/brand/logo-"), "в шапке загруженный знак: " + Адрес)
		.ЭтоИстина();

	Отдача = Клиент.GET(Адрес);
	Ожидаем.Что(Отдача.КодСостояния, "картинка отдаётся своим адресом").Равно(200);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Отдача, "Content-Type"), "тип тот, с которым загрузили")
		.Равно("image/png");
	Ожидаем.Что(ПолучитьBase64СтрокуИзДвоичныхДанных(Отдача.ПолучитьТелоКакДвоичныеДанные()),
		"байты дошли до посетителя без единой правки")
		.Равно(ПолучитьBase64СтрокуИзДвоичныхДанных(Картинка));

КонецПроцедуры

// Адрес — функция содержимого: заменил картинку, и прежний адрес перестаёт существовать,
// иначе кэш посетителя вечно показывал бы старый логотип.
&Тест
Процедура НовыйФайлМеняетАдресАСтарыйБольшеНеОтдаётся() Экспорт

	// оба файла ОДНОГО типа и с одним именем: разойтись адресам не на чем, кроме
	// отпечатка содержимого — иначе сторож зеленел бы от смены расширения
	Загрузить("logo", "лого.png", "image/png", КартинкаPNG());
	Первый = АдресЗнакаСоСтраницы();

	Загрузить("logo", "лого.png", "image/png", ДругаяКартинкаPNG());
	Второй = АдресЗнакаСоСтраницы();

	Ожидаем.Что(Второй <> Первый, СтрШаблон("адрес сменился: %1 → %2", Первый, Второй)).ЭтоИстина();
	Ожидаем.Что(Клиент.GET(Второй).КодСостояния, "новая картинка отдаётся").Равно(200);
	Ожидаем.Что(Клиент.GET(Первый).КодСостояния, "прежний адрес больше не отдаёт ничего").Равно(404);

КонецПроцедуры

&Тест
Процедура ВозвратСтандартногоВозвращаетФирменныйЗнак() Экспорт

	Загрузить("logo", "лого.png", "image/png", КартинкаPNG());
	Свой = АдресЗнакаСоСтраницы();
	Ожидаем.Что(СтрНачинаетсяС(Свой, "/brand/"), "предусловие: свой знак висит").ЭтоИстина();

	Ответ = Сбросить("logo");
	ПроверитьСохранение(Ответ, "возврат принят");

	Возвращённый = АдресЗнакаСоСтраницы();
	Ожидаем.Что(СтрНачинаетсяС(Возвращённый, "/static/"),
		"в шапке снова фирменный знак: " + Возвращённый).ЭтоИстина();
	Пропажа = Клиент.GET(Свой);
	Ожидаем.Что(Пропажа.КодСостояния, "снятая картинка не отдаётся").Равно(404);
	// 404 с immutable и ETag осел бы в общем кэше на год, и вернувшаяся картинка
	// не доехала бы до посетителя
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Пропажа, "Cache-Control"), "пропажу кэшировать нельзя")
		.Равно("no-store");
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Пропажа, "ETag"), "и валидатора у пропажи нет").Равно("");

КонецПроцедуры

// Кэш посетителя переспрашивает картинку условным запросом: 304 без тела — то, ради
// чего адрес несёт отпечаток.
&Тест
Процедура ПовторныйЗапросКартинкиОтвечает304() Экспорт

	Загрузить("logo", "лого.png", "image/png", КартинкаPNG());
	Адрес = АдресЗнакаСоСтраницы();

	Первый = Клиент.GET(Адрес);
	Метка = Клиент.ЗаголовокОтвета(Первый, "ETag");
	Ожидаем.Что(ЗначениеЗаполнено(Метка), "ответ несёт ETag").ЭтоИстина();

	Повтор = Клиент.GET(Адрес, Клиент.Заголовок("If-None-Match", Метка));

	Ожидаем.Что(Повтор.КодСостояния, "картинка не перекачивается").Равно(304);
	Ожидаем.Что(Повтор.ПолучитьТелоКакДвоичныеДанные().Размер(), "тела у 304 нет").Равно(0);

	// прокси перед хабом переспрашивает слабым валидатором — правило то же, что у страниц
	Чужая = """nosuchtag"""; // заголовок HTTP только в ASCII: кириллица роняет клиента
	Ожидаем.Что(Клиент.GET(Адрес, Клиент.Заголовок("If-None-Match", "W/" + Метка)).КодСостояния,
		"слабый валидатор той же метки → 304").Равно(304);
	Ожидаем.Что(Клиент.GET(Адрес, Клиент.Заголовок("If-None-Match", Чужая + ", " + Метка)).КодСостояния,
		"метка посреди списка → 304").Равно(304);
	Ожидаем.Что(Клиент.GET(Адрес, Клиент.Заголовок("If-None-Match", Чужая)).КодСостояния,
		"КОНТРОЛЬ: чужая метка отдаёт картинку целиком").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Иконка

// Загруженная иконка вытесняет фирменный набор целиком: из набора объявлений браузер
// выбирает сам, и стоковая .ico рядом со своей картинкой означала бы «иногда чужая».
&Тест
Процедура ЗагруженнаяИконкаВытесняетФирменныйНабор() Экспорт

	Голова = ГоловаСтраницы();
	Ожидаем.Что(СтрНайти(Голова, "/static/favicon") > 0, "до загрузки в голове фирменные значки")
		.ЭтоИстина();

	Ответ = Загрузить("favicon", "значок.svg", "image/svg+xml", КартинкаSVG());
	ПроверитьСохранение(Ответ, "иконка принята");

	Голова = ГоловаСтраницы();
	Ожидаем.Что(СтрНайти(Голова, "/brand/favicon-") > 0, "в голове адрес загруженной иконки: "
		+ Голова).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "/static/favicon"), "фирменных значков рядом не осталось")
		.Равно(0);
	Ожидаем.Что(СтрНайти(Голова, "/static/apple-touch-icon"),
		"и значка домашнего экрана тоже").Равно(0);

КонецПроцедуры

#КонецОбласти

// Без enctype браузер отправляет ОДНИ ИМЕНА файлов вместо содержимого, и загрузка
// молча перестаёт работать у всех, кто пользуется формой, а не curl-ом.
&Тест
Процедура ФормаКартинокОбъявленаСоставной() Экспорт

	Страница = Клиент.Тело(Клиент.GETСКукой("/hub/settings/branding", КукаАдмина));
	Форма = ФормаСПолемФайла(Страница);

	Ожидаем.Что(ЗначениеЗаполнено(Форма), "на странице есть форма с полем файла").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОткрывающийТег(Форма), "multipart/form-data") > 0,
		"форма с файлом объявлена составной: " + ОткрывающийТег(Форма)).ЭтоИстина();

КонецПроцедуры

#Область Отказы

// Потолок бережёт базу и время отклика: файл сверх него не должен ни лечь в базу,
// ни сменить картинку в шапке, а администратор обязан прочитать, что именно не так.
&Тест
Процедура СлишкомБольшойФайлОтвергаетсяИНичегоНеМеняет() Экспорт

	ДоЗагрузки = АдресЗнакаСоСтраницы();

	Ответ = Загрузить("logo", "огромный.png", "image/png", Байты(1100000));

	Ожидаем.Что(Ответ.КодСостояния, "отказ по размеру называет себя своим кодом").Равно(413);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "при допустимых") > 0,
		"отказ называет и вес файла, и потолок: " + Лев(Клиент.Тело(Ответ), 400)).ЭтоИстина();
	Ожидаем.Что(АдресЗнакаСоСтраницы(), "знак в шапке не тронут").Равно(ДоЗагрузки);

КонецПроцедуры

&Тест
Процедура НеКартинкаОтвергаетсяПонятно() Экспорт

	ДоЗагрузки = АдресЗнакаСоСтраницы();

	Ответ = Загрузить("logo", "документ.txt", "text/plain",
		ПолучитьДвоичныеДанныеИзСтроки("это не картинка"));

	Ожидаем.Что(Ответ.КодСостояния, "форму есть что поправить — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "не картинка известного хабу формата") > 0,
		"отказ объясняет, что не так: " + Лев(Клиент.Тело(Ответ), 400)).ЭтоИстина();
	Ожидаем.Что(АдресЗнакаСоСтраницы(), "знак в шапке не тронут").Равно(ДоЗагрузки);

КонецПроцедуры

&Тест
Процедура ФормаБезФайлаНеСчитаетсяСохранением() Экспорт

	Ответ = ЗагрузитьЧасти(Новый Массив(), КукаАдмина);

	Ожидаем.Что(Ответ.КодСостояния, "пустая форма — отказ, а не «сохранено»").Равно(400);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Файл не выбран") > 0,
		"отказ говорит, чего не хватает: " + Лев(Клиент.Тело(Ответ), 400)).ЭтоИстина();

КонецПроцедуры

// Порог раздела — админ хаба. КОНТРОЛЬ рядом: та же форма от админа проходит.
&Тест
Процедура ЧужойБезПравКартинкуНеМеняет() Экспорт

	ДоЗагрузки = АдресЗнакаСоСтраницы();
	КукаЧужого = ЗавестиИВойти("mallory", "MalloryPassw0rd");
	// сессия чужого обязана быть НАСТОЯЩЕЙ: с пустой кукой проверка выродилась бы
	// в «аноним ничего не может» и молчала бы о порогах для вошедшего не-админа
	Ожидаем.Что(ЗначениеЗаполнено(КукаЧужого), "чужой вошёл под своей учёткой").ЭтоИстина();

	Ответ = ЗагрузитьЧасти(ЧастиЛоготипа("лого.png", "image/png", КартинкаPNG()), КукаЧужого);

	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Изменения сохранены"),
		"чужой не получает «сохранено», код " + Ответ.КодСостояния).Равно(0);
	Ожидаем.Что(АдресЗнакаСоСтраницы(), "знак в шапке не тронут").Равно(ДоЗагрузки);

	// контроль: тем же телом от админа картинка встаёт
	ПроверитьСохранение(Загрузить("logo", "лого.png", "image/png", КартинкаPNG()),
		"админ той же формой картинку меняет");
	Ожидаем.Что(СтрНачинаетсяС(АдресЗнакаСоСтраницы(), "/brand/logo-"),
		"и она видна в шапке").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область НазваниеРядомСоЗнаком

// Горизонтальный логотип уже несёт название: тумблер убирает дублирующую подпись,
// но имя ссылки обязано остаться — иначе шапка перестаёт читаться скринридером.
&Тест
Процедура ВыключенноеНазваниеУбираетПодписьНоНеИмяСсылки() Экспорт

	Установить("oshub.ui.show_name", "0");
	Попытка
		Шапка = ШапкаСтраницы();
		Ожидаем.Что(СтрНайти(Шапка, "<span>OpenHub</span>"), "подписи рядом со знаком нет").Равно(0);
		Ожидаем.Что(СтрНайти(Шапка, "alt=""OpenHub""") > 0,
			"название переехало в alt картинки: " + Шапка).ЭтоИстина();
	Исключение
		Установить("oshub.ui.show_name", "1");
		ВызватьИсключение;
	КонецПопытки;

	Установить("oshub.ui.show_name", "1");
	Шапка = ШапкаСтраницы();
	Ожидаем.Что(СтрНайти(Шапка, "<span>OpenHub</span>") > 0, "подпись вернулась").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Удавшаяся операция уводит редиректом (POST-Redirect-GET), и соединение теста ему
// следует: доказательством служит страница раздела с уведомлением «сохранено»,
// которое печатается только по «?saved=1».
Процедура ПроверитьСохранение(Знач Ответ, Знач Пояснение)

	Ожидаем.Что(Ответ.КодСостояния, Пояснение + " (код)").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Изменения сохранены") > 0,
		Пояснение + ": " + Лев(Клиент.Тело(Ответ), 400)).ЭтоИстина();

КонецПроцедуры

// Форма, ВНУТРИ которой стоит поле выбора файла: не «первая на странице» и не «та,
// в которой есть слово», а именно та, чьё содержимое отправляет файл.
Функция ФормаСПолемФайла(Знач Страница)

	Остаток = Страница;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<form");
		Если Начало = 0 Тогда
			Возврат "";
		КонецЕсли;
		Остаток = Сред(Остаток, Начало);
		Конец = СтрНайти(Остаток, "</form>");
		Если Конец = 0 Тогда
			Возврат "";
		КонецЕсли;
		Форма = Лев(Остаток, Конец);
		Если СтрНайти(Форма, "type=""file""") > 0 Тогда
			Возврат Форма;
		КонецЕсли;
		Остаток = Сред(Остаток, Конец);
	КонецЦикла;

КонецФункции

Функция ОткрывающийТег(Знач Форма)
	Конец = СтрНайти(Форма, ">");
	Возврат ?(Конец = 0, Форма, Лев(Форма, Конец));
КонецФункции

Функция АдресЗнакаСоСтраницы()
	Возврат Клиент.ПослеМаркера(ШапкаСтраницы(), "class=""brand__mark"" src=""", """");
КонецФункции

Функция ШапкаСтраницы()

	Разметка = Клиент.Тело(Клиент.GET("/"));
	Начало = СтрНайти(Разметка, "<header");
	Конец = СтрНайти(Разметка, "</header>");
	Возврат ?(Начало = 0 ИЛИ Конец = 0, Разметка, Сред(Разметка, Начало, Конец - Начало));

КонецФункции

Функция ГоловаСтраницы()

	Разметка = Клиент.Тело(Клиент.GET("/"));
	Конец = СтрНайти(Разметка, "</head>");
	Возврат ?(Конец = 0, Разметка, Лев(Разметка, Конец));

КонецФункции

Функция Загрузить(Знач Ключ, Знач ИмяФайла, Знач ТипКонтента, Знач Данные)
	Возврат ЗагрузитьЧасти(ЧастиАктива(Ключ, ИмяФайла, ТипКонтента, Данные), КукаАдмина);
КонецФункции

Функция ЧастиЛоготипа(Знач ИмяФайла, Знач ТипКонтента, Знач Данные)
	Возврат ЧастиАктива("logo", ИмяФайла, ТипКонтента, Данные);
КонецФункции

Функция ЧастиАктива(Знач Ключ, Знач ИмяФайла, Знач ТипКонтента, Знач Данные)

	Части = Новый Массив();
	Части.Добавить(Новый Структура("Имя, ИмяФайла, ТипКонтента, Данные",
		"актив-" + Ключ, ИмяФайла, ТипКонтента, Данные));
	Возврат Части;

КонецФункции

// Форма картинок отправляется ровно теми полями, которые печатает страница: скрытая
// операция, CSRF и файловые части.
Функция ЗагрузитьЧасти(Знач ФайловыеЧасти, Знач Кука)

	Токен = ТокенРаздела(Кука);

	Текстовые = Новый Соответствие();
	Текстовые.Вставить("_csrf", Токен);
	Текстовые.Вставить("операция", "актив-загрузка");

	Возврат Клиент.POSTСоставной("/hub/settings/branding", Текстовые, ФайловыеЧасти, Кука);

КонецФункции

Функция Сбросить(Знач Ключ)

	Текстовые = Новый Соответствие();
	Текстовые.Вставить("_csrf", ТокенРаздела(КукаАдмина));
	Текстовые.Вставить("операция", "актив-загрузка");
	Текстовые.Вставить("сброс-актива", Ключ);

	Возврат Клиент.POSTСоставной("/hub/settings/branding", Текстовые, Новый Массив(), КукаАдмина);

КонецФункции

Функция Установить(Знач Ключ, Знач Значение)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ТокенРаздела(КукаАдмина));
	Поля.Вставить(Ключ, Значение);
	Возврат Клиент.POSTФормы("/hub/settings/branding", Поля, КукаАдмина);

КонецФункции

Функция ТокенРаздела(Знач Кука)

	Страница = Клиент.Тело(Клиент.GETСКукой("/hub/settings/branding", Кука));
	Токен = Клиент.ПослеМаркера(Страница, "name=""_csrf"" value=""", """");
	Возврат ?(ЗначениеЗаполнено(Токен), Токен, "нет-токена");

КонецФункции

Функция КартинкаPNG()
	// однопиксельный прозрачный PNG: заведомо двоичные байты, не переживающие текстовый путь
	Возврат ПолучитьДвоичныеДанныеИзBase64Строки(
		"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk"
		+ "+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==");
КонецФункции

Функция ДругаяКартинкаPNG()
	// тот же формат и то же имя файла, другое содержимое
	Возврат ПолучитьДвоичныеДанныеИзBase64Строки(
		"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8"
		+ "z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==");
КонецФункции

Функция КартинкаSVG()
	Возврат ПолучитьДвоичныеДанныеИзСтроки(
		"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 8 8""><rect width=""8"" height=""8""/></svg>");
КонецФункции

Функция Байты(Знач Сколько)

	Кусок = "";
	Для Счётчик = 1 По 1000 Цикл
		Кусок = Кусок + "x";
	КонецЦикла;

	Текст = "";
	Пока СтрДлина(Текст) < Сколько Цикл
		Текст = Текст + Кусок;
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Лев(Текст, Сколько));

КонецФункции

#КонецОбласти

#Область HTTP

Функция ЗавестиАдмина()

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/setup", Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", ЛогинАдмина, ПарольАдмина),
		КодировкаТекста.UTF8);
	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);

	Кука = Клиент.КукаСессии(Ответ);
	Возврат ?(ЗначениеЗаполнено(Кука), Кука, Клиент.Войти(ЛогинАдмина, ПарольАдмина));

КонецФункции

Функция ЗавестиИВойти(Знач Логин, Знач Пароль)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/api/v1/register", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрШаблон(
		"{""логин"":""%1"",""email"":""%1@example.com"",""пароль"":""%2""}", Логин, Пароль),
		КодировкаТекста.UTF8);
	Клиент.Соединение().ОтправитьДляОбработки(Запрос);

	Возврат Клиент.Войти(Логин, Пароль);

КонецФункции

#КонецОбласти
