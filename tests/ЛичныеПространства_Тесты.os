// Оба перехода настройки «Личные пространства» и полнота каскада удаления пула:
// после удаления пула в базе не остаётся ни одной строки, на него ссылавшейся,
// а в хранилище — ни одного файла его области.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "хранилище", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "аудит", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "основа", "Классы"));

	// SSRF-гейт апстримов: СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО (fail-closed)
	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить();

	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHub");
	ПоискКлассов.Подключить(Модули, "НормализаторУчётки");
	ПоискКлассов.Подключить(Модули, "ПолитикаПароля");
	// СервисПользователей пишет события безопасности учётки через летопись
	ПоискКлассов.Подключить(Модули, "ЛетописьУчёток");
	ПоискКлассов.Подключить(Модули, "АдресУчётки");
	ПоискКлассов.Подключить(Модули, "СервисПользователей");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "кабинет", "Классы", "СлужбаЛичныхПространств.os"));

	КаталогSettings = ОбъединитьПути(Модули, "настройки", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	// observability: издатель событий инъектирует Телеметрию (здесь выключенную),
	// аудит закрывает свой гейт готовности при запуске рогаток
	КаталогNet = ОбъединитьПути(Модули, "сеть", "Классы");
	КаталогТелеметрии = ОбъединитьПути(Модули, "наблюдаемость", "Классы", "телеметрия");
	КаталогПроб = ОбъединитьПути(Модули, "наблюдаемость", "Классы", "пробы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.Подключить(КаталогТелеметрии, "БуферСпанов");
	ПоискКлассов.Подключить(КаталогТелеметрии, "СпанХаба");
	ПоискКлассов.Подключить(КаталогТелеметрии, "Телеметрия");
	ПоискКлассов.Подключить(КаталогПроб, "ГотовностьХаба");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийGitHub.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-личные-пространства-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "личные-пространства-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область ПолнотаКаскада

// Главная гарантия починки: удаление пула с пакетом не оставляет в базе НИ ОДНОЙ строки,
// ссылавшейся на пул, пакет или версию, и ни одного файла в области пула. Каждая сущность
// проверяется поимённо — «сирот нет вообще» не сводится к «сирот нет там, где смотрели».
&Тест
Процедура УдалениеПулаНеОставляетНиОднойСиротскойСтроки() Экспорт

	Стенд = НабитыйПул();

	Желудь("СервисПулов").УдалитьПул(Стенд.ПулИд);

	Осталось = Новый Массив();
	ПроверитьПусто(Осталось, "пул", Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Стенд.ПулИд));
	ПроверитьПусто(Осталось, "пакет", Желудь("ХранилищеПакетов").ПолучитьПоПулИдентификаторРавно(Стенд.ПулИд));
	ПроверитьПусто(Осталось, "версия", Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(Стенд.ПакетИд));
	ПроверитьПусто(Осталось, "зависимость", Желудь("ХранилищеЗависимостей").ПоВерсии(Стенд.ВерсияИд));
	ПроверитьПусто(Осталось, "тег", Желудь("ХранилищеТегов").ПолучитьПоПакетИдентификаторРавно(Стенд.ПакетИд));
	ПроверитьПусто(Осталось, "метка тега", Желудь("ХранилищеМетокТегов").ПолучитьПоТегИдентификаторРавно(Стенд.ТегИд));
	ПроверитьПусто(Осталось, "метка версии", Желудь("ХранилищеМетокВерсий").ПолучитьПоВерсияИдентификаторРавно(Стенд.ВерсияИд));
	ПроверитьПусто(Осталось, "провенанс", Желудь("ХранилищеПроисхожденияВерсий").ПолучитьПоПакетИдентификаторРавно(Стенд.ПакетИд));
	ПроверитьПусто(Осталось, "статистика скачиваний", Желудь("ХранилищеСкачиванийАгрегатов").АгрегатыПакета(Стенд.ПакетИд));
	ПроверитьПусто(Осталось, "грант на пул", Желудь("ХранилищеПравДоступа").ГрантыНаОбъект("пул", Стенд.ПулИд));
	ПроверитьПусто(Осталось, "грант на пакет", Желудь("ХранилищеПравДоступа").ГрантыНаОбъект("пакет", Стенд.ПакетИд));
	ПроверитьПусто(Осталось, "доверие CI", Желудь("ХранилищеДоверияCI").ПолучитьПоПакетИдентификаторРавно(Стенд.ПакетИд));
	ПроверитьПусто(Осталось, "подписка на пул", Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пул", Стенд.ПулИд));
	ПроверитьПусто(Осталось, "подписка на пакет", Желудь("ХранилищеВебхуков").ПолучитьПоОбъекту("пакет", Стенд.ПакетИд));
	ПроверитьПусто(Осталось, "токен пула", Желудь("ХранилищеТокенов").ТокеныПула(Стенд.ПулИд));
	ПроверитьПусто(Осталось, "роль на пуле", Желудь("ХранилищеУчастниковПула").ПолучитьПоПулИдентификаторРавно(Стенд.ПулИд));
	ПроверитьПусто(Осталось, "входящая заявка", Желудь("ХранилищеВходящихПубликаций").ПолучитьПоПулИдентификаторРавно(Стенд.ПулИд));
	ПроверитьПусто(Осталось, "зеркало", Желудь("ХранилищеЗеркалХабов").ПолучитьПоПулНазначенияИдентификаторРавно(Стенд.ПулИд));
	ПроверитьПусто(Осталось, "апстрим", Желудь("ХранилищеАпстримовПула").ПолучитьПоПулИдентификаторРавно(Стенд.ПулИд));

	Ожидаем.Что(СтрСоединить(Осталось, ", "),
		"сущности, оставшиеся сиротами после удаления пула").Равно("");

	Ожидаем.Что(Новый Файл(Стенд.ПутьАртефакта).Существует(),
		"файл артефакта версии снят с диска").ЭтоЛожь();
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Опись(Стенд.ИмяПула).Количество(),
		"в области хранения пула не осталось ни одного файла").Равно(0);

КонецПроцедуры

// Кэш прокси лежит в области пула, но строки версии не имеет: снимать его по строкам
// реестра нечем — область чистится по описи хранилища.
&Тест
Процедура ФайлБезСтрокиВерсииТожеУходитСПулом() Экспорт

	Стенд = НабитыйПул();
	Хранилище = Желудь("ХранилищеАртефактов");
	Осиротевший = Новый КоординатыАртефакта(Стенд.ИмяПула, "кэш-апстрима", "9.9.9");
	Хранилище.Сохранить(Осиротевший, ФайлИсточник("кэш"));

	Ожидаем.Что(Хранилище.Существует(Осиротевший), "файл без строки версии положен").ЭтоИстина();

	Желудь("СервисПулов").УдалитьПул(Стенд.ПулИд);

	Ожидаем.Что(Хранилище.Существует(Осиротевший),
		"файл без строки версии тоже снят вместе с пулом").ЭтоЛожь();

КонецПроцедуры

// Каскад ПАКЕТА самодостаточен: он снимает файлы своих версий сам, не полагаясь на уборку
// пула. Соседний пакет того же пула не тронут — адресация идёт по записанному пути версии.
&Тест
Процедура УборкаПакетаСнимаетФайлыТолькоСвоихВерсий() Экспорт

	Стенд = НабитыйПул();
	Сосед = ДобавитьПакет(Стенд.ПулИд, Стенд.ИмяПула);

	Пакет = Желудь("ХранилищеПакетов").ПолучитьОдноПоИдентификаторРавно(Стенд.ПакетИд);
	Желудь("УборкаПакета").УдалитьПакет(Пакет);

	Ожидаем.Что(Новый Файл(Стенд.ПутьАртефакта).Существует(),
		"файл версии удалённого пакета снят").ЭтоЛожь();
	Ожидаем.Что(Новый Файл(Сосед.ПутьАртефакта).Существует(),
		"файл соседнего пакета того же пула на месте").ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(Сосед.ПакетИд).Количество(),
		"и его версия тоже").Равно(1);

КонецПроцедуры

// Каскад не выходит за границу пула: соседний пул со своим пакетом остаётся нетронутым.
&Тест
Процедура УдалениеПулаНеТрогаетСоседнийПул() Экспорт

	Свой = НабитыйПул();
	Соседний = НабитыйПул();

	Желудь("СервисПулов").УдалитьПул(Свой.ПулИд);

	Ожидаем.Что(Желудь("ХранилищеПакетов").ПолучитьПоПулИдентификаторРавно(Соседний.ПулИд).Количество(),
		"пакет соседнего пула на месте").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеВерсийПакета").ПолучитьПоПакетИдентификаторРавно(Соседний.ПакетИд).Количество(),
		"версия соседнего пула на месте").Равно(1);
	Ожидаем.Что(Новый Файл(Соседний.ПутьАртефакта).Существует(),
		"файл соседнего пула на месте").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПереходыНастройки

// Выключение сносит ВСЕ личные пулы, включая непустые (решение владельца), и не трогает
// обычные пулы: тип — единственный признак отбора.
&Тест
Процедура ВыключениеСноситВсеЛичныеПулыВключаяНепустые() Экспорт

	Пустой = ЛичныйПулПользователя();
	СПакетом = ЛичныйПулСПакетом();
	Обычный = НабитыйПул();

	Служба = Желудь("СлужбаЛичныхПространств");
	Сводка = Служба.СводкаУдаления();

	Ожидаем.Что(Сводка.Пулов >= 2, "в сводке оба личных пула").ЭтоИстина();
	Ожидаем.Что(Сводка.ПуловСПакетами >= 1, "и посчитаны непустые").ЭтоИстина();
	Ожидаем.Что(Сводка.Пакетов >= 1, "и пакеты личных пулов").ЭтоИстина();
	Ожидаем.Что(Сводка.Версий >= 1, "и их версии").ЭтоИстина();

	Итог = Служба.УдалитьВсе("root");

	Ожидаем.Что(Итог.Пулов, "удалено ровно столько, сколько обещала сводка").Равно(Сводка.Пулов);
	Ожидаем.Что(Желудь("СервисПулов").ПулыПоТипу(Желудь("СервисПулов").ТипЛичный()).Количество(),
		"личных пулов не осталось").Равно(0);
	Ожидаем.Что(Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Пустой.Идентификатор) = Неопределено,
		"пустой личный пул снесён").ЭтоИстина();
	Ожидаем.Что(Желудь("ХранилищеПакетов").ПолучитьПоПулИдентификаторРавно(СПакетом.ПулИд).Количество(),
		"пакет непустого личного пула снесён вместе с ним").Равно(0);
	Ожидаем.Что(Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Обычный.ПулИд) <> Неопределено,
		"обычный пул не тронут").ЭтоИстина();

КонецПроцедуры

// Включение раздаёт пространства ВСЕМ существующим учёткам, а не только будущим.
// Повтор идемпотентен, отключённая учётка пространства не получает.
&Тест
Процедура ВключениеРаздаётПространстваВсемКромеОтключённых() Экспорт

	Служба = Желудь("СлужбаЛичныхПространств");

	Живой = СоздатьПользователя();
	Спящий = СоздатьПользователя();
	Отключить(Спящий);

	// снос до раздачи: учётки уже есть, пространств нет — ровно случай «включили настройку»
	Служба.УдалитьВсе("root");
	Первый = Служба.РаздатьВсем("root");

	Ожидаем.Что(Первый.Создано >= 2, "пространства созданы существующим учёткам").ЭтоИстина();
	Ожидаем.Что(Первый.Пропущено >= 1, "отключённая учётка пропущена").ЭтоИстина();
	Ожидаем.Что(Первый.Ошибок, "и ни одной ошибки").Равно(0);

	Ожидаем.Что(Желудь("СервисПулов").НайтиПул(Живой.Логин) <> Неопределено,
		"у активной учётки личный пул появился").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПулов").НайтиПул(Спящий.Логин) = Неопределено,
		"у отключённой — нет").ЭтоИстина();

	БылоПулов = Желудь("СервисПулов").ПулыПоТипу(Желудь("СервисПулов").ТипЛичный()).Количество();

	Второй = Служба.РаздатьВсем("root");

	Ожидаем.Что(Второй.Создано, "повторное включение не создаёт дублей").Равно(0);
	Ожидаем.Что(Второй.Ошибок, "и не падает").Равно(0);
	Ожидаем.Что(Желудь("СервисПулов").ПулыПоТипу(Желудь("СервисПулов").ТипЛичный()).Количество(),
		"число личных пулов не изменилось").Равно(БылоПулов);

КонецПроцедуры

// Личное пространство активной учётки приезжает с ролью мейнтейнера: пул без роли
// владельцу не принадлежит — ни опубликовать, ни настроить.
&Тест
Процедура РозданноеПространствоПриезжаетСРольюВладельца() Экспорт

	Желудь("СлужбаЛичныхПространств").УдалитьВсе("root");
	Хозяин = СоздатьПользователя();
	Желудь("СлужбаЛичныхПространств").РаздатьВсем("root");

	Личный = Желудь("СервисПулов").НайтиПул(Хозяин.Логин);
	Ожидаем.Что(Личный <> Неопределено, "пространство заведено").ЭтоИстина();

	Грант = Желудь("ХранилищеПравДоступа").НайтиГрант("пользователь", Хозяин.Идентификатор,
		"пул", Личный.Идентификатор);
	Ожидаем.Что(Грант <> Неопределено, "и на нём есть грант владельца").ЭтоИстина();
	Ожидаем.Что(Грант.Создание = Истина, "с правом публиковать").ЭтоИстина();

КонецПроцедуры

// Имя логина может носить ЧУЖОЙ пул — например, разжалованный сменой типа. Это не
// «пространство уже есть»: раздача обязана назвать такую учётку ошибкой, а не молча
// отчитаться «было», оставив человека без пространства навсегда.
&Тест
Процедура ИмяЗанятоеЧужимПуломСчитаетсяОшибкойАНеПространством() Экспорт

	Служба = Желудь("СлужбаЛичныхПространств");
	Служба.УдалитьВсе("root");

	Обделённый = СоздатьПользователя();
	Личный = Желудь("СервисПулов").НайтиПул(Обделённый.Логин);
	Ожидаем.Что(Личный <> Неопределено, "регистрация завела пространство").ЭтоИстина();

	// разжалование штатной операцией: запрета на смену типа личного пула нет
	Желудь("СервисПулов").УстановитьТип(Цел(Личный.Идентификатор), "custom");

	Ожидаем.Что(Служба.СводкаУдаления().Пулов, "разжалованный пул личным больше не считается")
		.Равно(0);

	Итог = Служба.РаздатьВсем("root");

	Ожидаем.Что(Итог.Ошибок >= 1, "учётка без пространства названа ошибкой").ЭтоИстина();
	Ожидаем.Что(Итог.Было, "и «уже было» ей не приписано").Равно(0);
	Ожидаем.Что(Желудь("СервисПулов").НайтиПул(Обделённый.Логин).ЭтоЛичный(),
		"имя по-прежнему носит чужой пул — пространства у учётки так и нет").ЭтоЛожь();

	// уборка стенда: возвращаем тип, иначе имя останется занятым для следующих тестов
	Желудь("СервисПулов").УстановитьТип(Цел(Личный.Идентификатор), Желудь("СервисПулов").ТипЛичный());

КонецПроцедуры

// Порядок «записать настройку → раздать» закреплён числом: обеспечение спрашивает
// настройку, и при обратном порядке раздача пропустила бы всех до единого.
&Тест
Процедура РаздачаПриВыключеннойНастройкеНеСоздаётНичего() Экспорт

	Служба = Желудь("СлужбаЛичныхПространств");
	Служба.УдалитьВсе("root");
	СоздатьПользователя();

	Настройки = Желудь("СервисНастроек");
	Настройки.УстановитьМеханизмом("oshub.pools.personal_enabled", Ложь, "ревизия",
		"ПультЛичныхПространств");

	Итог = Служба.РаздатьВсем("root");
	Ожидаем.Что(Итог.Создано, "при выключенной настройке не создаётся ни одного пространства")
		.Равно(0);
	Ожидаем.Что(Итог.Пропущено > 0, "все учётки пропущены").ЭтоИстина();

	Настройки.Сбросить("oshub.pools.personal_enabled", "ревизия");
	Ожидаем.Что(Служба.РаздатьВсем("root").Создано > 0,
		"КОНТРОЛЬ: с включённой настройкой те же учётки пространства получают").ЭтоИстина();

КонецПроцедуры

// Уборка сносит ВСЮ область пула и отчитывается за фактически удалённое. Проверяется
// файлом, лежащим ПРЯМО в pools/{пул}/ — опись его перечисляет, а адресация по
// {пул}/{пакет}/{файл} его не достаёт: рапорт «удалено N» тогда был бы неправдой.
// Заодно закреплён порядок «область → пакеты»: число равно ВСЕМ файлам пула, а не
// остатку после пакетной уборки.
&Тест
Процедура УборкаСноситВсюОбластьПулаИОтчитываетсяЗаУдалённое() Экспорт

	Стенд = НабитыйПул();
	ДобавитьПакет(Стенд.ПулИд, Стенд.ИмяПула);
	Хранилище = Желудь("ХранилищеАртефактов");

	// пишем мимо координат: так в области оказывается всё, что положил не хаб
	Мимо = ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", Стенд.ИмяПула), "прямо.ospx");
	Запись = Новый ЗаписьТекста(Мимо, КодировкаТекста.UTF8);
	Запись.Записать("положено мимо координат");
	Запись.Закрыть();

	Ожидалось = Хранилище.Опись(Стенд.ИмяПула).Количество();
	Ожидаем.Что(Ожидалось, "в области пула три файла, один из них — мимо раскладки").Равно(3);

	Пул = Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Стенд.ПулИд);
	Итог = Желудь("УборкаПула").ОчиститьСодержимое(Пул);

	Ожидаем.Что(Итог.Артефактов, "уборка отчиталась за ВСЕ файлы области").Равно(Ожидалось);
	Ожидаем.Что(Новый Файл(Мимо).Существует(),
		"файл мимо раскладки действительно удалён, а не только перечислен").ЭтоЛожь();
	Ожидаем.Что(Хранилище.Опись(Стенд.ИмяПула).Количество(),
		"и область пуста — рапорт совпал с делом").Равно(0);

КонецПроцедуры

// Обе операции оставляют след в журнале аудита — с числами, а не одним фактом.
&Тест
Процедура ОбеОперацииПишутВАудитСвоиЧисла() Экспорт

	Служба = Желудь("СлужбаЛичныхПространств");
	Аудит = Желудь("СлужбаАудита");

	ЛичныйПулСПакетом();
	Служба.УдалитьВсе("root");

	Снос = ПоследняяЗапись(Аудит, Служба.ДействиеВыключены());
	Ожидаем.Что(Снос <> Неопределено, "снос записан в аудит").ЭтоИстина();
	Ожидаем.Что(Строка(Снос.Кто), "автор операции — из сессии").Равно("root");
	Ожидаем.Что(Строка(Снос.Объект), "объект — сама настройка").Равно("настройка/oshub.pools.personal_enabled");
	Ожидаем.Что(СтрНайти(Строка(Снос.Детали), "Пулов") > 0, "в деталях число пулов").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Снос.Детали), "Версий") > 0, "и число версий").ЭтоИстина();

	СоздатьПользователя();
	Служба.РаздатьВсем("root");

	Раздача = ПоследняяЗапись(Аудит, Служба.ДействиеВключены());
	Ожидаем.Что(Раздача <> Неопределено, "раздача записана в аудит").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Раздача.Детали), "Создано") > 0,
		"в деталях число созданных").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Стенд

// Пул с пакетом, версией и строкой КАЖДОЙ сущности, ссылающейся на пул, пакет или версию.
Функция НабитыйПул()

	Владелец = СоздатьПользователя();
	ИмяПула = УникальноеИмя("cascade");
	Пул = Желудь("СервисПулов").СоздатьПул(ИмяПула, "custom", "public", Владелец.Идентификатор, 0);
	ПулИд = Цел(Пул.Идентификатор);

	ИмяПакета = УникальноеИмя("pkg");
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(ПулИд, ИмяПакета,
		Новый Структура("Описание, Лицензия", "Каскадный пакет", "MIT"));
	ПакетИд = Цел(Пакет.Идентификатор);

	Координаты = Новый КоординатыАртефакта(ИмяПула, ИмяПакета, "1.0.0");
	Желудь("ХранилищеАртефактов").Сохранить(Координаты, ФайлИсточник("артефакт"));

	Заявка = Новый ЗаявкаНаПубликацию(ПакетИд, "1.0.0");
	Заявка.Размер = 8;
	Заявка.Sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
	Заявка.АвторМанифеста = Владелец.Логин;
	Заявка.ОпубликовалИдентификатор = Владелец.Идентификатор;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", ИмяПула, ИмяПакета);
	Версия = Желудь("СервисВерсий").Опубликовать(Заявка);
	ВерсияИд = Цел(Версия.Идентификатор);

	Желудь("ХранилищеЗависимостей").Записать(ВерсияИд, "asserts", "1.0.0");

	Тег = Желудь("ХранилищеТегов").СоздатьЭлемент();
	Тег.ПакетИдентификатор = ПакетИд;
	Тег.Имя = "stable";
	Тег.Режим = "manual";
	Тег.Правило = "";
	Тег.ТипПравила = "";
	Тег.ПоУмолчанию = Ложь;
	Тег.Стиль = "";
	Тег.Значок = "";
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.КемИдентификатор = Владелец.Идентификатор;
	Тег.Сохранить();
	ТегИд = Цел(Тег.Идентификатор);

	МеткаТега = Желудь("ХранилищеМетокТегов").СоздатьЭлемент();
	МеткаТега.ТегИдентификатор = ТегИд;
	МеткаТега.ВерсияИдентификатор = ВерсияИд;
	МеткаТега.Сохранить();

	МеткаВерсии = Желудь("ХранилищеМетокВерсий").СоздатьЭлемент();
	МеткаВерсии.ВерсияИдентификатор = ВерсияИд;
	МеткаВерсии.Метка = "latest";
	МеткаВерсии.Сохранить();

	Провенанс = Желудь("ХранилищеПроисхожденияВерсий").СоздатьЭлемент();
	Провенанс.ПакетИдентификатор = ПакетИд;
	Провенанс.ВерсияИдентификатор = ВерсияИд;
	Провенанс.Источник = "push";
	Провенанс.АпстримИдентификатор = 0;
	Провенанс.Зафиксировано = ТекущаяУниверсальнаяДата();
	Провенанс.Сохранить();

	Желудь("ХранилищеСкачиванийАгрегатов").Накопить(ПакетИд, ВерсияИд, НачалоДня(ТекущаяУниверсальнаяДата()), 3);

	ГрантПула = Желудь("ХранилищеПравДоступа").СоздатьЭлемент();
	ЗаполнитьГрант(ГрантПула, Владелец.Идентификатор, "пул", ПулИд);
	ГрантПакета = Желудь("ХранилищеПравДоступа").СоздатьЭлемент();
	ЗаполнитьГрант(ГрантПакета, Владелец.Идентификатор, "пакет", ПакетИд);

	Доверие = Желудь("ХранилищеДоверияCI").СоздатьЭлемент();
	Доверие.ПакетИдентификатор = ПакетИд;
	Доверие.ПулИдентификатор = ПулИд;
	Доверие.Провайдер = "github";
	Доверие.Издатель = "https://token.actions.githubusercontent.com";
	Доверие.Репозиторий = "org/" + ИмяПакета;
	Доверие.Конвейер = ".github/workflows/publish.yml";
	Доверие.Реф = "refs/heads/main";
	Доверие.Создано = ТекущаяУниверсальнаяДата();
	Доверие.КемСоздано = Владелец.Логин;
	Доверие.Сохранить();

	ЗавестиПодписку("пул", ПулИд, ПулИд);
	ЗавестиПодписку("пакет", ПакетИд, ПулИд);

	Токен = Желудь("ХранилищеТокенов").СоздатьЭлемент();
	Токен.ПользовательИдентификатор = Владелец.Идентификатор;
	Токен.Префикс = Лев(ИмяПула, 8);
	Токен.Имя = "ключ публикации";
	Токен.Хеш = "хеш-" + ИмяПула;
	Токен.Права = "publish";
	Токен.ПулИдентификатор = ПулИд;
	Токен.Истекает = '00010101';
	Токен.Создан = ТекущаяУниверсальнаяДата();
	Токен.Сохранить();

	Участник = Желудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = ПулИд;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Владелец.Идентификатор;
	Участник.Роль = "publisher";
	Участник.Сохранить();

	Входящая = Желудь("ХранилищеВходящихПубликаций").СоздатьЭлемент();
	Входящая.ПулИдентификатор = ПулИд;
	Входящая.ИмяПакета = ИмяПакета;
	Входящая.ИмяНижнийРегистр = НРег(ИмяПакета);
	Входящая.Версия = "2.0.0";
	Входящая.ЗаявительИдентификатор = Владелец.Идентификатор;
	Входящая.Состояние = "ожидает";
	Входящая.Создана = ТекущаяУниверсальнаяДата();
	Входящая.ИмяФайла = ИмяПакета + "-2.0.0.ospx";
	Входящая.Размер = 4;
	Входящая.Sha256 = "";
	Входящая.КлючХранилища = "inbox/" + ИмяПакета;
	Входящая.Сохранить();

	Зеркало = Желудь("ХранилищеЗеркалХабов").СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = ПулИд;
	ЗаполнитьЗеркало(Зеркало, ИмяПула);
	Зеркало.Сохранить();

	Апстрим = Желудь("ХранилищеАпстримовПула").СоздатьЭлемент();
	Апстрим.ПулИдентификатор = ПулИд;
	ЗаполнитьАпстрим(Апстрим);
	Апстрим.Сохранить();

	Возврат Новый Структура("ПулИд, ИмяПула, ПакетИд, ВерсияИд, ТегИд, ПутьАртефакта",
		ПулИд, ИмяПула, ПакетИд, ВерсияИд, ТегИд,
		ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", ИмяПула), ИмяПакета,
			ИмяПакета + "-1.0.0.ospx"));

КонецФункции

Процедура ЗаполнитьГрант(Грант, Знач СубъектИд, Знач ТипОбъекта, Знач ОбъектИд)
	Грант.ТипСубъекта = "пользователь";
	Грант.СубъектИдентификатор = СубъектИд;
	Грант.ТипОбъекта = ТипОбъекта;
	Грант.ОбъектИдентификатор = ОбъектИд;
	Грант.Создание = Истина;
	Грант.Изменение = Истина;
	Грант.Удаление = Ложь;
	Грант.Чтение = Истина;
	Грант.КемВыдано = 0;
	Грант.Выдано = ТекущаяУниверсальнаяДата();
	Грант.Сохранить();
КонецПроцедуры

Процедура ЗавестиПодписку(Знач ТипОбъекта, Знач ОбъектИд, Знач ПулИд)
	Вебхук = Желудь("ХранилищеВебхуков").СоздатьЭлемент();
	Вебхук.ТипОбъекта = ТипОбъекта;
	Вебхук.ОбъектИдентификатор = ОбъектИд;
	Вебхук.ПулИдентификатор = ПулИд;
	Вебхук.ТипДействия = "webhook";
	Вебхук.URL = "https://example.test/hook";
	Вебхук.Секрет = "";
	Вебхук.НастройкиДействия = "";
	Вебхук.ТокенДействия = "";
	Вебхук.ШаблонТекста = "";
	Вебхук.ТипыСобытий = "версия.опубликована";
	Вебхук.Активен = Истина;
	Вебхук.СозданКем = 0;
	Вебхук.Создан = ТекущаяУниверсальнаяДата();
	Вебхук.Обновлён = ТекущаяУниверсальнаяДата();
	Вебхук.Сохранить();
КонецПроцедуры

Процедура ЗаполнитьЗеркало(Зеркало, Знач Ключ)
	Зеркало.АпстримURL = "https://upstream.test/" + Ключ;
	Зеркало.Режим = "pull";
	Зеркало.ФильтрJSON = "";
	Зеркало.ИнтервалСинкаСек = 3600;
	Зеркало.Включено = Ложь;
	Зеркало.РазрешитьПриватные = Ложь;
	Зеркало.ПоследнийСинк = '00010101';
	Зеркало.Статус = "";
	Зеркало.СозданКем = 0;
	Зеркало.Создан = ТекущаяУниверсальнаяДата();
	Зеркало.Обновлён = ТекущаяУниверсальнаяДата();
КонецПроцедуры

Процедура ЗаполнитьАпстрим(Апстрим)
	Апстрим.Url = "https://upstream.test/hub";
	Апстрим.ВремяЖизниСек = 900;
	Апстрим.СписокРазрешенийJSON = "";
	Апстрим.РазрешитьПриватные = Ложь;
	Апстрим.ПоследняяСинхронизация = '00010101';
	Апстрим.Порядок = 1;
КонецПроцедуры

// Ещё один пакет в том же пуле: с версией, записанным путём и файлом в хранилище.
Функция ДобавитьПакет(Знач ПулИд, Знач ИмяПула)

	ИмяПакета = УникальноеИмя("side");
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(ПулИд, ИмяПакета,
		Новый Структура("Описание, Лицензия", "Соседний пакет", "MIT"));

	Желудь("ХранилищеАртефактов").Сохранить(
		Новый КоординатыАртефакта(ИмяПула, ИмяПакета, "1.0.0"), ФайлИсточник("соседний"));

	Заявка = Новый ЗаявкаНаПубликацию(Цел(Пакет.Идентификатор), "1.0.0");
	Заявка.Размер = 1;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", ИмяПула, ИмяПакета);
	Желудь("СервисВерсий").Опубликовать(Заявка);

	Возврат Новый Структура("ПакетИд, ПутьАртефакта", Цел(Пакет.Идентификатор),
		ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", ИмяПула), ИмяПакета,
			ИмяПакета + "-1.0.0.ospx"));

КонецФункции

// Личный пул: заводится СервисПулов'ом, как при регистрации.
Функция ЛичныйПулПользователя()
	Владелец = СоздатьПользователя();
	Существующий = Желудь("СервисПулов").НайтиПул(Владелец.Логин);
	Возврат ?(Существующий = Неопределено,
		Желудь("СервисПулов").СоздатьЛичныйПул(Владелец.Логин, Владелец.Идентификатор),
		Существующий);
КонецФункции

Функция ЛичныйПулСПакетом()

	Личный = ЛичныйПулПользователя();
	ПулИд = Цел(Личный.Идентификатор);
	ИмяПакета = УникальноеИмя("own");

	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(ПулИд, ИмяПакета,
		Новый Структура("Описание, Лицензия", "Пакет личного пространства", "MIT"));

	Заявка = Новый ЗаявкаНаПубликацию(Цел(Пакет.Идентификатор), "1.0.0");
	Заявка.Размер = 1;
	Заявка.Sha256 = "";
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", Личный.Имя, ИмяПакета);
	Желудь("СервисВерсий").Опубликовать(Заявка);

	Возврат Новый Структура("ПулИд, ПакетИд", ПулИд, Цел(Пакет.Идентификатор));

КонецФункции

Процедура ПроверитьПусто(Собранное, Знач Название, Знач Найденное)

	Если Найденное = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Найденное) = Тип("Массив") Тогда
		Если Найденное.Количество() > 0 Тогда
			Собранное.Добавить(СтрШаблон("%1 (%2)", Название, Найденное.Количество()));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Собранное.Добавить(Название);

КонецПроцедуры

Функция ПоследняяЗапись(Знач Аудит, Знач Действие)
	Для Каждого Запись Из Аудит.ЗаписиСтраницей(Неопределено, 1, 200).Записи Цикл
		Если Строка(Запись.Действие) = Действие Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция СоздатьПользователя()
	Логин = УникальноеИмя("u");
	Возврат Желудь("СервисПользователей").СоздатьПользователя(
		Логин, Логин + "@example.test", "TestPassw0rd", "user");
КонецФункции

Процедура Отключить(Пользователь)
	Пользователь.Активен = Ложь;
	Пользователь.Сохранить();
КонецПроцедуры

// Хранилище принимает путь к существующему файлу — так же, как на боевом пути публикации.
Функция ФайлИсточник(Знач Текст)
	Путь = ПолучитьИмяВременногоФайла("ospx");
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
	Возврат Путь;
КонецФункции

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0") + "-"
		+ Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 6);
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

#КонецОбласти
