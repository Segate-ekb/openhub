// Скан-тест дисциплины логирования: лог приходит только инъекцией &Лог — без #Использовать logos
// и без статического Логирование.* вне списка исключений; детекторы закрыты самотестами.

#Использовать asserts

Перем КаталогПроекта;
Перем ФайлыСозданияЛог_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

КонецПроцедуры

#Область СканыПродуктовогоКода

&Тест
Процедура ПродуктовыйКодНеОбъявляетДирективуLogos() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Если ОбъявленаДирективаLogos(ЧистыйТекст(ПрочитатьФайл(Файл))) Тогда
			Нарушители.Добавить(ОтносительныйПуть(Файл));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"файлы src/, tools/ и scripts/ с прямой директивой #Использовать logos"
		+ " (лог берётся инъекцией &Лог, logos — транзитивная зависимость autumn-logos)")
		.Равно("");

КонецПроцедуры

&Тест
Процедура СтатическийДоступКЛогуТолькоПоЯвномуСписку() Экспорт

	Исключения = ИсключенияСтатическогоДоступа();
	Нарушители = Новый Массив();
	Использованные = Новый Соответствие();

	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Если НЕ ЕстьСтатическийДоступКЛогу(ЧистыйТекст(ПрочитатьФайл(Файл))) Тогда
			Продолжить;
		КонецЕсли;
		Путь = ОтносительныйПуть(Файл);
		Если Исключения.Получить(Путь) <> Неопределено Тогда
			Использованные.Вставить(Путь, Истина);
			Продолжить;
		КонецЕсли;
		Нарушители.Добавить(Путь);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"файлы, зовущие глобальный модуль Логирование мимо инъекции ОСени").Равно("");

	Ожидаем.Что(СтрСоединить(НеиспользованныеИсключения(Исключения, Использованные), ", "),
		"исключения статического доступа, которые больше не нужны:"
		+ " файл перестал звать Логирование или исчез").Равно("");

КонецПроцедуры

&Тест
Процедура КаждыйЛогирующийФайлПолучаетЛогИнъекцией() Экспорт

	Исключения = ИсключенияИнъекции();
	БезИнъекции = Новый Массив();
	Использованные = Новый Соответствие();

	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Текст = ЧистыйТекст(ПрочитатьФайл(Файл));
		Если НЕ ЕстьЗаписьВЛог(Текст) Тогда
			Продолжить;
		КонецЕсли;
		Путь = ОтносительныйПуть(Файл);
		Если ОбъявленаИнъекцияЛога(Текст) Тогда
			Продолжить;
		КонецЕсли;
		Если Исключения.Получить(Путь) <> Неопределено Тогда
			Использованные.Вставить(Путь, Истина);
			Продолжить;
		КонецЕсли;
		БезИнъекции.Добавить(Путь);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(БезИнъекции, ", "),
		"файлы, которые пишут в лог, но не объявляют инъекцию &Лог").Равно("");

	Ожидаем.Что(СтрСоединить(НеиспользованныеИсключения(Исключения, Использованные), ", "),
		"исключения инъекции, которые больше не нужны:"
		+ " файл перестал логировать или получил &Лог").Равно("");

КонецПроцедуры

&Тест
Процедура ЛогирующийКлассСоздаваемыйНапрямуюПринимаетЛогПараметром() Экспорт

	Исключения = ИсключенияИнъекции();
	Нарушители = Новый Массив();

	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Текст = ЧистыйТекст(ПрочитатьФайл(Файл));
		Если НЕ ЕстьЗаписьВЛог(Текст) Тогда
			Продолжить;
		КонецЕсли;
		Если ПринимаетЛогПараметром(Текст) Тогда
			Продолжить; // второй вход есть — прямое создание безопасно
		КонецЕсли;
		Путь = ОтносительныйПуть(Файл);
		Если Исключения.Получить(Путь) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ГдеСоздают = ГдеСоздаётсяНапрямую(ИмяКлассаИзПути(Файл));
		Если ГдеСоздают <> "" Тогда
			Нарушители.Добавить(Путь + " (Новый — в " + ГдеСоздают + ")");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"классы, которые пишут в лог и создаются напрямую (`Новый`) в tests/, src/,"
		+ " tools/ или scripts/, но не принимают лог параметром конструктора: при прямом создании"
		+ " поле-лог остаётся Неопределено").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторПрямогоСозданияПроверенНаОбразцах() Экспорт

	Ожидаем.Что(ПринимаетЛогПараметром(
			"Процедура ПриСозданииОбъекта(" + Символы.ПС
			+ "	&Лог _Лог = Неопределено)"),
		"параметр конструктора опознан").ЭтоИстина();

	Ожидаем.Что(ПринимаетЛогПараметром(
			"&Лог" + Символы.ПС + "Перем Лог;" + Символы.ПС
			+ "Процедура ПриСозданииОбъекта()"),
		"поле — это НЕ параметр конструктора").ЭтоЛожь();

	Ожидаем.Что(ГдеСоздаётсяНапрямую("ГотовностьХаба") <> "",
		"ГотовностьХаба создаётся через Новый — иначе детектор ослеп").ЭтоИстина();
	Ожидаем.Что(ГдеСоздаётсяНапрямую("КлассКоторогоНетНигде"),
		"несуществующий класс напрямую не создаётся").Равно("");

	Ожидаем.Что(Лев(ГдеСоздаётсяНапрямую("РазобраннаяВерсия"), 4),
		"детектор видит `Новый` в продуктовом коде: РазобраннаяВерсия создаётся в src/"
		+ " (иначе корпус снова сузился до tests/)").Равно("src/");

	МестаСовета = МестаСозданияНапрямую("СоветДругогоМастера");
	ЕстьСкрипты = Ложь;
	Для Каждого Место Из МестаСовета Цикл
		Если СтрНачинаетсяС(Место, "scripts/") Тогда
			ЕстьСкрипты = Истина;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ЕстьСкрипты,
		"детектор видит `Новый` в scripts/: СоветДругогоМастера создаётся в скриптах"
		+ " сопровождения и сидерах (иначе корпус потерял scripts/). Найдено мест: "
		+ СтрСоединить(МестаСовета, ", ")).ЭтоИстина();

	ТекстСПриманкой = "Фейк = Новый СервисПроксиФейк();" + Символы.ПС
		+ "Прочее = 1;" + Символы.ПС
		+ "Настоящий = Новый СервисПрокси(Пул);";
	Ожидаем.Что(ЕстьСозданиеВТексте(ТекстСПриманкой, "СервисПрокси"),
		"приманка-однофамилец ВЫШЕ настоящего создания не прячет его: перебираются все"
		+ " вхождения, а не первое").ЭтоИстина();
	Ожидаем.Что(ЕстьСозданиеВТексте("Фейк = Новый СервисПроксиФейк();", "СервисПрокси"),
		"одна приманка без настоящего создания — не создание").ЭтоЛожь();
	Ожидаем.Что(ЕстьСозданиеВТексте("Настоящий = Новый СервисПрокси(Пул);", "СервисПрокси"),
		"обычное создание опознано").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТочкаВходаЗагружаетAutumnLogos() Экспорт

	ПутьТочкиВхода = ФайлТочкиВхода();
	Текст = ЧистыйТекст(ПрочитатьФайл(ПутьТочкиВхода));

	Ожидаем.Что(СтрНайти(Текст, "#Использовать autumn-logos") > 0,
		"точка входа " + ПутьТочкиВхода + " обязана загружать autumn-logos —"
		+ " она даёт желудь-фабрику логов").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СамотестыДетекторов

&Тест
Процедура ДетекторДирективыОтличаетLogosОтAutumnLogos() Экспорт

	Ожидаем.Что(ОбъявленаДирективаLogos("#Использовать logos"),
		"прямая директива logos — нарушение").ЭтоИстина();
	Ожидаем.Что(ОбъявленаДирективаLogos("	#Использовать   logos	"),
		"отступы и лишние пробелы не прячут нарушение").ЭтоИстина();
	Ожидаем.Что(ОбъявленаДирективаLogos("#Использовать autumn-logos"),
		"autumn-logos — это НЕ нарушение").ЭтоЛожь();
	Ожидаем.Что(ОбъявленаДирективаLogos("#Использовать asserts" + Символы.ПС + "#Использовать logos"),
		"нарушение не в первой строке тоже ловится").ЭтоИстина();
	Ожидаем.Что(ОбъявленаДирективаLogos("#Использовать logostash"),
		"чужой пакет с похожим именем — не нарушение").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторСтатическогоДоступаЛовитОбращенияКМодулю() Экспорт

	Ожидаем.Что(ЕстьСтатическийДоступКЛогу("	Лог = Логирование.ПолучитьЛог(""oshub.x"");"),
		"классический статический доступ").ЭтоИстина();
	Ожидаем.Что(ЕстьСтатическийДоступКЛогу("	Н = Логирование.ПолучитьНастройки();"),
		"любой вызов модуля Логирование, не только ПолучитьЛог").ЭтоИстина();
	Ожидаем.Что(ЕстьСтатическийДоступКЛогу("	Лог.Информация(""всё хорошо"");"),
		"запись в инъектированный лог — не статика").ЭтоЛожь();
	Ожидаем.Что(ЕстьСтатическийДоступКЛогу("	ЛогированиеВыключено = Истина;"),
		"переменная, чьё имя НАЧИНАЕТСЯ на Логирование, — не обращение к модулю")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторыНеВидятКомментариевИЛитералов() Экспорт

	Ожидаем.Что(ОбъявленаДирективаLogos(ЧистыйТекст("// раньше тут было #Использовать logos")),
		"упоминание в комментарии — не нарушение").ЭтоЛожь();
	Ожидаем.Что(ЕстьСтатическийДоступКЛогу(ЧистыйТекст("// нельзя звать Логирование.ПолучитьЛог")),
		"упоминание в комментарии — не нарушение").ЭтоЛожь();
	Ожидаем.Что(ЕстьСтатическийДоступКЛогу(ЧистыйТекст("	Текст = ""Логирование.ПолучитьЛог"";")),
		"нарушение, спрятанное в строковый литерал, скан НЕ видит — и это честно"
		+ " задокументировано в шапке набора").ЭтоЛожь();
	Ожидаем.Что(ЕстьСтатическийДоступКЛогу(ЧистыйТекст(
			"	Лог = Логирование.ПолучитьЛог(""oshub.x""); // законная точка")),
		"код с хвостовым комментарием остаётся видимым").ЭтоИстина();

	Ожидаем.Что(ЕстьСозданиеВТексте(ЧистыйТекст(
			"	Шаблон = ""Текст = 1;" + Символы.ПС + "	|Новый ГотовностьХаба();"");"),
			"ГотовностьХаба"),
		"продолжение многострочного литерала кодом не считается, хотя флаг литерала"
		+ " сброшен на границе строк").ЭтоЛожь();
	Ожидаем.Что(ЕстьСозданиеВТексте(ЧистыйТекст(
			"	Шаблон = ""многострочный" + Символы.ПС + "	|литерал"");" + Символы.ПС
			+ "	Готовность = Новый ГотовностьХаба();"),
			"ГотовностьХаба"),
		"код ПОСЛЕ многострочного литерала остаётся видимым").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторИнъекцииТребуетИменноАннотацию() Экспорт

	Ожидаем.Что(ОбъявленаИнъекцияЛога(
			"&Лог" + Символы.ПС + "Перем Лог;"),
		"аннотация на поле — инъекция").ЭтоИстина();
	Ожидаем.Что(ОбъявленаИнъекцияЛога(
			"Процедура ПриСозданииОбъекта(&Лог _Лог)"),
		"аннотация на параметре конструктора — тоже инъекция").ЭтоИстина();
	Ожидаем.Что(ОбъявленаИнъекцияЛога("Перем Лог;"),
		"просто поле с именем Лог инъекцией не является").ЭтоЛожь();
	Ожидаем.Что(ОбъявленаИнъекцияЛога("&ЛогВебСервера" + Символы.ПС + "Перем Лог;"),
		"аннотация с похожим именем не считается за &Лог").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторЗаписиВЛогЛовитОбращенияКПеременной() Экспорт

	Ожидаем.Что(ЕстьЗаписьВЛог("	Лог.Информация(""x"");"), "вызов метода лога").ЭтоИстина();
	Ожидаем.Что(ЕстьЗаписьВЛог("	Лог.Предупреждение(""x"");"), "любой уровень").ЭтоИстина();
	Ожидаем.Что(ЕстьЗаписьВЛог("	Итог.Вставить(""x"", 1);"), "посторонний вызов — не лог").ЭтоЛожь();
	Ожидаем.Что(ЕстьЗаписьВЛог("	ЛогикаПула.Проверить();"),
		"переменная, чьё имя НАЧИНАЕТСЯ на Лог, — не лог").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СпискиИсключений

Функция ИсключенияСтатическогоДоступа()

	Исключения = Новый Соответствие();

	Возврат Исключения;

КонецФункции

Функция ИсключенияИнъекции()

	Исключения = Новый Соответствие();

	Исключения.Вставить("src/модули/наблюдаемость/Классы/телеметрия/ТранспортOTLPХаба.os",
		"не желудь: лог передаёт создатель (Телеметрия) параметром конструктора");
	Исключения.Вставить("src/модули/хранилище/Классы/КлиентS3Oint.os",
		"не желудь: лог передаёт создатель (КонфигурацияХранилища) параметром конструктора");
	Исключения.Вставить("src/модули/почта/Классы/ПисьмоЗаданием.os",
		"не желудь: лог передаёт создатель (СлужбаПочты) параметром конструктора");

	Возврат Исключения;

КонецФункции

#КонецОбласти

#Область Детекторы

Функция ОбъявленаДирективаLogos(Знач Текст)

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС) Цикл
		ИмяПакета = ИмяПакетаДирективы(Строка);
		Если НРег(ИмяПакета) = "logos" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ИмяПакетаДирективы(Знач Строка)

	Очищенная = СокрЛП(Строка);
	Если НЕ СтрНачинаетсяС(НРег(Очищенная), "#использовать") Тогда
		Возврат "";
	КонецЕсли;

	Остаток = СокрЛП(Сред(Очищенная, СтрДлина("#Использовать") + 1));
	Возврат СтрЗаменить(Остаток, """", "");

КонецФункции

Функция ЕстьСтатическийДоступКЛогу(Знач Текст)
	Возврат ЕстьОбращениеКИмени(Текст, "Логирование");
КонецФункции

Функция ЕстьЗаписьВЛог(Знач Текст)
	Возврат ЕстьОбращениеКИмени(Текст, "Лог");
КонецФункции

Функция ЕстьОбращениеКИмени(Знач Текст, Знач Имя)

	Позиция = 1;
	Пока Истина Цикл
		Найдено = СтрНайти(Текст, Имя + ".", , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЭтоГраницаИдентификатора(Текст, Найдено - 1) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

Функция ЭтоГраницаИдентификатора(Знач Текст, Знач Позиция)

	Если Позиция < 1 Тогда
		Возврат Истина;
	КонецЕсли;

	Символ = Сред(Текст, Позиция, 1);
	Возврат СтрНайти("QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm"
		+ "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю"
		+ "0123456789_", Символ) = 0;

КонецФункции

// Аннотация пишется без параметров (&Лог) — имя лога равно имени класса. Форма с
// префиксом (&Лог(Значение = "...")) осталась допустимой, но в проекте не используется.
Функция ОбъявленаИнъекцияЛога(Знач Текст)
	Возврат ЕстьАннотацияЛога(Текст);
КонецФункции

// Аннотация &Лог: за именем идёт либо "(", либо любой неидентификаторный символ.
Функция ЕстьАннотацияЛога(Знач Текст)

	Поз = СтрНайти(Текст, "&Лог");
	Пока Поз > 0 Цикл
		Если ЭтоГраницаИдентификатора(Текст, Поз + 4) Тогда
			Возврат Истина;
		КонецЕсли;
		Хвост = Сред(Текст, Поз + 4);
		СледПоз = СтрНайти(Хвост, "&Лог");
		Если СледПоз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = Поз + 3 + СледПоз;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПринимаетЛогПараметром(Знач Текст)

	Позиция = СтрНайти(Текст, "Процедура ПриСозданииОбъекта(");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Текст, Позиция);
	Конец = СтрНайти(Хвост, ")");
	ГраницаТела = СтрНайти(Хвост, "КонецПроцедуры");
	Если ГраницаТела = 0 Тогда
		ГраницаТела = СтрДлина(Хвост);
	КонецЕсли;

	Возврат ЕстьАннотацияЛога(Лев(Хвост, ГраницаТела));

КонецФункции

Функция ГдеСоздаётсяНапрямую(Знач ИмяКласса)

	Места = МестаСозданияНапрямую(ИмяКласса);
	Возврат ?(Места.Количество() = 0, "", Места[0]);

КонецФункции

Функция МестаСозданияНапрямую(Знач ИмяКласса)

	Места = Новый Массив();

	Для Каждого Запись Из КорпусСоздания() Цикл
		Если ЕстьСозданиеВТексте(Запись.Текст, ИмяКласса) Тогда
			Места.Добавить(Запись.Путь);
		КонецЕсли;
	КонецЦикла;

	Возврат Места;

КонецФункции

Функция ЕстьСозданиеВТексте(Знач Текст, Знач ИмяКласса)

	Образец = "Новый " + ИмяКласса;
	Позиция = 1;

	Пока Истина Цикл
		Найдено = СтрНайти(Текст, Образец, , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Следующий = Сред(Текст, Найдено + СтрДлина(Образец), 1);
		Если Следующий = "" ИЛИ ЭтоГраницаИдентификатора(Следующий, 1) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

Функция КорпусСоздания()

	Если ФайлыСозданияЛог_ <> Неопределено Тогда
		Возврат ФайлыСозданияЛог_;
	КонецЕсли;

	Пути = Новый Массив();
	СобратьФайлы(ОбъединитьПути(КаталогПроекта, "tests"), Пути);
	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Пути.Добавить(Файл);
	КонецЦикла;

	ФайлыСозданияЛог_ = Новый Массив();
	Для Каждого Файл Из Пути Цикл
		ФайлыСозданияЛог_.Добавить(Новый Структура("Путь, Текст",
			ОтносительныйПуть(Файл), ЧистыйТекст(ПрочитатьФайл(Файл))));
	КонецЦикла;

	Возврат ФайлыСозданияЛог_;

КонецФункции

Функция ИмяКлассаИзПути(Знач Путь)
	Возврат Новый Файл(Путь).ИмяБезРасширения;
КонецФункции

#КонецОбласти

#Область Корпус

Функция ПродуктовыеФайлы()

	Файлы = Новый Массив();
	СобратьФайлы(ОбъединитьПути(КаталогПроекта, "src"), Файлы);
	СобратьФайлы(ОбъединитьПути(КаталогПроекта, "tools"), Файлы);
	СобратьФайлы(ОбъединитьПути(КаталогПроекта, "scripts"), Файлы);

	Если Файлы.Количество() < 100 Тогда
		ВызватьИсключение СтрШаблон(
			"Корпус скана логирования подозрительно мал (%1 файлов) — проверьте пути",
			Файлы.Количество());
	КонецЕсли;

	Возврат Файлы;

КонецФункции

Процедура СобратьФайлы(Знач Каталог, Файлы)

	Если НЕ Новый Файл(Каталог).Существует() Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ФайлТочкиВхода()

	Найденные = НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Ложь);
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон(
			"В корне src/ ожидался РОВНО один сценарий-точка входа, найдено %1 —"
			+ " опора теста потеряна, поправьте поиск", Найденные.Количество());
	КонецЕсли;

	Возврат Найденные[0].ПолноеИмя;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция ОтносительныйПуть(Знач Путь)

	Относительный = СтрЗаменить(СтрЗаменить(Путь, КаталогПроекта, ""), "\", "/");
	Если СтрНачинаетсяС(Относительный, "/") Тогда
		Относительный = Сред(Относительный, 2);
	КонецЕсли;

	Возврат Относительный;

КонецФункции

Функция ЧистыйТекст(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС) Цикл
		Результат.Добавить(ОчиститьСтроку(Строка));
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

Функция ОчиститьСтроку(Знач Строка)

	Итог = "";
	ВЛитерале = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Строка);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Строка, Позиция, 1);

		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если НЕ ВЛитерале И Символ = "/" И Сред(Строка, Позиция + 1, 1) = "/" Тогда
			Прервать;
		КонецЕсли;

		Если НЕ ВЛитерале Тогда
			Итог = Итог + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Если СтрНачинаетсяС(СокрЛП(Итог), "|") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Итог;

КонецФункции

Функция НеиспользованныеИсключения(Знач Исключения, Знач Использованные)

	Лишние = Новый Массив();

	Для Каждого КиЗ Из Исключения Цикл
		Если Использованные.Получить(КиЗ.Ключ) = Неопределено Тогда
			Лишние.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Возврат Лишние;

КонецФункции

#КонецОбласти
