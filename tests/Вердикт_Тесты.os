// Форма ответа «получилось или нет и почему»: основа/Вердикт для служб и права/ВердиктГварда
// для гвардов. Проверяется ровно то, на чём держатся потребители: имя флага, имя причины,
// сохранность полей нагрузки и то, что нагрузка флаг не перебивает.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Вердикты;
Перем ВердиктыГварда;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(Модули, "ВердиктГварда");

КонецПроцедуры

&ПередКаждым
Процедура СобратьВердикты() Экспорт
	Вердикты = Новый Вердикт();
	ВердиктыГварда = Новый ВердиктГварда();
КонецПроцедуры

&Тест
Процедура УдачаИНеудачаЗовутсяОднимиИТемиЖеСловами() Экспорт

	Удача = Вердикты.Успех();
	Ожидаем.Что(Удача.Успех, "флаг зовётся «Успех»").ЭтоИстина();
	Ожидаем.Что(Удача.Причина, "у удачи причины нет").Равно("");

	Неудача = Вердикты.Отказ("скоуп");
	Ожидаем.Что(Неудача.Успех, "отказ — это Ложь в том же поле").ЭтоЛожь();
	Ожидаем.Что(Неудача.Причина, "причина — машинный код").Равно("скоуп");

КонецПроцедуры

&Тест
Процедура ОтветСКодомНесётКодИСообщение() Экспорт

	Принято = Вердикты.УспехСКодом(202, "Принято");
	Ожидаем.Что(Принято.Успех, "флаг тот же").ЭтоИстина();
	Ожидаем.Что(Принято.Код, "код ответа").Равно(202);
	Ожидаем.Что(Принято.Сообщение, "текст для человека").Равно("Принято");

	Отказано = Вердикты.ОтказСКодом(403, "Нельзя");
	Ожидаем.Что(Отказано.Успех, "отказ").ЭтоЛожь();
	Ожидаем.Что(Отказано.Код, "код отказа").Равно(403);
	Ожидаем.Что(Отказано.Сообщение, "текст отказа").Равно("Нельзя");

КонецПроцедуры

&Тест
Процедура ПолезнаяНагрузкаЕдетПолямиИФлагаНеПеребивает() Экспорт

	СНагрузкой = Вердикты.УспехСКодом(200, "", Новый Структура("Пользователь", "вася"));
	Ожидаем.Что(СНагрузкой.Пользователь, "нагрузка доехала полем").Равно("вася");
	Ожидаем.Что(СНагрузкой.Успех, "и флаг на месте").ЭтоИстина();

	// нагрузка, назвавшая поле флага, его НЕ подменяет: иначе отказ можно было бы
	// превратить в успех, ничего не решив
	Подмена = Вердикты.Отказ("нельзя", Новый Структура("Успех, Причина", Истина, "можно"));
	Ожидаем.Что(Подмена.Успех, "флаг остаётся тем, каким его объявил конструктор").ЭтоЛожь();
	Ожидаем.Что(Подмена.Причина, "и причина тоже").Равно("нельзя");

КонецПроцедуры

&Тест
Процедура ГвардОтвечаетСловомРазрешеноИТойЖеФормойНаОтказе() Экспорт

	Пропуск = ВердиктыГварда.Пропуск(
		ВердиктыГварда.ПоляПринципала("принципал", "учётка", "сессия"));
	Ожидаем.Что(Пропуск.Разрешено, "флаг гварда зовётся «Разрешено»").ЭтоИстина();
	Ожидаем.Что(Пропуск.Пользователь, "нагрузка доехала").Равно("учётка");
	Ожидаем.Что(Пропуск.Принципал, "и принципал тоже").Равно("принципал");
	Ожидаем.Что(Пропуск.Сессия, "и сессия").Равно("сессия");

	// та же форма без значений — она и едет в отказ
	Отказ = ВердиктыГварда.Отказ("нет прав", ВердиктыГварда.ПоляПринципала());
	Ожидаем.Что(Отказ.Разрешено, "отказ").ЭтоЛожь();
	Ожидаем.Что(Отказ.Причина, "причина отказа").Равно("нет прав");
	// читатель отказа спрашивает ТЕ ЖЕ поля: отсутствующее поле упало бы исключением
	Ожидаем.Что(Отказ.Свойство("Пользователь"), "поля формы есть и в отказе").ЭтоИстина();
	Ожидаем.Что(Отказ.Свойство("Сессия"), "все до одного").ЭтоИстина();

КонецПроцедуры
