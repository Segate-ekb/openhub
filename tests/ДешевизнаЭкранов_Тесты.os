// Сторожа дешевизны экранов web-ui: цена экрана в обращениях к базе НЕ РАСТЁТ с числом
// строк. Каждый экран собирается дважды — на маленькой фактуре и на большой, — а обращения
// считают хранилища-фикстуры: секундомер мерил бы машину, счётчик меряет N+1. Там, где
// запрос и так был один, счёт идёт по ПРОЧИТАННЫМ СТРОКАМ: цена росла объёмом выдачи.
// Экраны собраны руками на ките, без контейнера: между витриной и счётчиком не должно
// оказаться ничего лишнего.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;              // СборкаUI — граф компонентов и рендереров web-ui
Перем КаталогМодулей;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("СервисПользователейЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ЧтениеПуловЗаглушка");
	РеестрФикстур.Подключить("СчитающееХранилищеТокенов");
	РеестрФикстур.Подключить("СчитающееХранилищеПривязок");
	РеестрФикстур.Подключить("СчитающийСервисПулов");
	РеестрФикстур.Подключить("СчитающееХранилищеУчёток");
	РеестрФикстур.Подключить("СчитающееХранилищеЛичностей");
	РеестрФикстур.Подключить("СчитающееХранилищеПубликаций");
	РеестрФикстур.Подключить("СчитающееХранилищеАгрегатов");
	РеестрФикстур.Подключить("СчитающееХранилищеГрантов");
	РеестрФикстур.Подключить("СчитающееХранилищеУчастников");
	РеестрФикстур.Подключить("СчитающееХранилищеЛенты");
	РеестрФикстур.Подключить("СчитающийСервисВходящих");
	РеестрФикстур.Подключить("СчитающийСервисГрупп");
	РеестрФикстур.Подключить("СчитающийСервисУчёток");
	РеестрФикстур.Подключить("ГвардКлючаПропускающий");
	РеестрФикстур.Подключить("ГотовностьЗаглушка");
	РеестрФикстур.Подключить("ПровенансВсёСвоё");
	РеестрФикстур.Подключить("ФейкПакетЗапись");
	РеестрФикстур.Подключить("ФейкПакетовДляЛетописи");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	КаталогИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("КаталогРазделов,ЯчейкиТаблицы,ПлашкиПула,ОкноФормы,"
		+ "ДомАккаунта,ДомХаба,ФормаПодбораПулов,ФормаУчётки,"
		+ "ВитринаТокеновКабинета,ВитринаУчёток,ВитринаПакетов,ВитринаМоихПакетов", ",") Цикл
		Поиск.Подключить(КаталогИнтерфейса, Имя);
	КонецЦикла;

	КаталогВхода = ОбъединитьПути(КаталогМодулей, "вход", "Классы");
	Для Каждого Имя Из СтрРазделить("СверкаСекретов,СервисТокенов,ГейтТокена,"
		+ "СервисАктивностиУчёток,СписокУчёток,ПолитикаПарольногоВхода", ",") Цикл
		Поиск.Подключить(КаталогВхода, Имя);
	КонецЦикла;

	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "поиск", "Классы"), "ПоискПоКоллекции");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "СервисВерсий");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "права", "Классы"), "СервисПрав");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "уведомления", "Классы"), "ЛентаУведомлений");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "публикация", "Классы"), "РассмотрениеВходящих");

	КаталогСтатистики = ОбъединитьПути(КаталогМодулей, "статистика", "Классы");
	Для Каждого Имя Из СтрРазделить("СчётчикСкачиванийВПамяти,СлужбаСтатистикиСкачиваний", ",") Цикл
		Поиск.Подключить(КаталогСтатистики, Имя);
	КонецЦикла;

КонецПроцедуры

#Область ТокеныКабинета

// Список ключей кабинета стоит трёх обращений к базе — список, наборы пулов, имена
// пулов — и столько же на двадцати ключах: «набор пулов ключа» и «имя пула привязки»
// спрашиваются разом на весь экран, а не на строку.
&Тест
Процедура ЦенаСпискаТокеновНеРастётСЧисломТокенов() Экспорт

	НаДвух = ЦенаЭкранаТокенов(2);
	НаДвадцати = ЦенаЭкранаТокенов(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать ключей стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Токены, "список ключей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Привязки, "наборы пулов всех ключей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Пулы, "имена пулов — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: строки нарисованы и имена пулов в них есть
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "альфа, бета"),
		"в каждой из двадцати строк названы оба пула ключа").Равно(20);

	// строка старого ключа приезжает тем же разрезом: рамку из колонки записи экран
	// называет пулом, а не «весь хаб»
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "гамма"),
		"старый ключ с одиночной привязкой назван своим пулом").Равно(1);

КонецПроцедуры

Функция ЦенаЭкранаТокенов(Знач ЧислоТокенов)

	Хранилище = Новый СчитающееХранилищеТокенов();
	Привязки = Новый СчитающееХранилищеПривязок();

	Пулы = Новый СчитающийСервисПулов();
	Пулы.ДобавитьПул(1, "альфа");
	Пулы.ДобавитьПул(2, "бета");
	Пулы.ДобавитьПул(3, "гамма");

	Для Номер = 1 По ЧислоТокенов Цикл
		Хранилище.Добавить(Номер, ВладелецКлючей(), СтрШаблон("ключ %1", Формат(Номер, "ЧГ=0")));
		Привязки.Записать(Номер, 1);
		Привязки.Записать(Номер, 2);
	КонецЦикла;

	// ключ, выпущенный до появления набора: рамка колонкой записи, строк привязок нет
	Хранилище.Добавить(НомерСтарогоКлюча(), ВладелецКлючей(), "старый ключ", 3);

	Токены = Новый СервисТокенов(Хранилище, НастройкиТокенов(), Привязки, Новый СверкаСекретов());
	Витрина = Новый ВитринаТокеновКабинета(UI.Кит, Новый ЯчейкиТаблицы(UI.Кит), ДомАккаунта(),
		Токены, Пулы, Новый ЧтениеПуловЗаглушка(), ОкноПодбора(Пулы), Новый ГейтТокена(Токены));

	Разметка = Витрина.Раздел(Вердикт(), "csrf-токен", "", Заявка()).Рендер();

	Итог = Новый Структура();
	Итог.Вставить("Токены", Хранилище.Обращений());
	Итог.Вставить("Привязки", Привязки.Обращений());
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Всего", Хранилище.Обращений() + Привязки.Обращений() + Пулы.Обращений());
	Итог.Вставить("Разметка", Разметка);
	Возврат Итог;

КонецФункции

Функция НастройкиТокенов()

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.token.max_days", 90);
	Настройки.Задать("oshub.auth.token.cli_days", 30);
	Возврат Настройки;

КонецФункции

Функция ОкноПодбора(Знач Пулы)
	Возврат Новый ФормаПодбораПулов(UI.Кит, UI.Формы,
		Новый ПлашкиПула(Пулы, UI.Тексты, UI.ЗначкиМеты));
КонецФункции

Функция ДомАккаунта()
	Возврат Новый ДомАккаунта(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты,
		UI.АдресаКабинета);
КонецФункции

Функция ВладелецКлючей()
	Возврат 7;
КонецФункции

// Номер заведомо больше любого номера современных ключей набора: строки не пересекаются.
Функция НомерСтарогоКлюча()
	Возврат 100;
КонецФункции

Функция Вердикт()
	Возврат Новый Структура("Пользователь, Принципал",
		Новый Структура("Идентификатор", ВладелецКлючей()), Неопределено);
КонецФункции

// Пустая форма выпуска: окно подбора закрыто, набора пулов в ней нет.
Функция Заявка()
	Возврат Новый Структура("Имя, Чтение, Запись, Пулы, Срок, Поиск, Подбор",
		"", Истина, Истина, Новый Массив(), "30", "", Ложь);
КонецФункции

#КонецОбласти

#Область УчёткиХаба

// Список учёток дома «Хаб» стоит двух обращений — список и внешние личности всего
// списка — и столько же на двадцати учётках: «есть ли чем войти» спрашивается разом,
// а не на строку.
&Тест
Процедура ЦенаСпискаУчётокНеРастётСЧисломУчёток() Экспорт

	НаДвух = ЦенаЭкранаУчёток(2);
	НаДвадцати = ЦенаЭкранаУчёток(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать учёток стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Учётки, "список учёток — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Личности, "внешние личности всего списка — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: строки нарисованы, и ответ «чем войти»
	// в них РАЗНЫЙ — половина учёток без пароля и без личности
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "нечем войти"),
		"плашка стоит ровно у учёток без пароля и без личности").Равно(10);

КонецПроцедуры

Функция ЦенаЭкранаУчёток(Знач ЧислоУчёток)

	Учётки = Новый СчитающееХранилищеУчёток();
	Личности = Новый СчитающееХранилищеЛичностей();

	Для Номер = 1 По ЧислоУчёток Цикл
		Учётки.Добавить(Номер, СтрШаблон("user%1", Формат(Номер, "ЧГ=0")));
		// личность у каждой второй: ответ «есть чем войти» обязан быть разным по строкам
		Если Номер % 2 = 0 Тогда
			Личности.Привязать(Номер);
		КонецЕсли;
	КонецЦикла;

	Активность = Новый СервисАктивностиУчёток(Личности, Новый ФейкСервисПрав(),
		Новый ПолитикаПарольногоВхода(НастройкиВхода()), Неопределено);
	Список = Новый СписокУчёток(Учётки, Активность, Новый ПоискПоКоллекции());

	Витрина = Новый ВитринаУчёток(UI.Кит, UI.РендерерНастроек, ФормаЗаведения(), UI.Формы,
		ДомХаба(), Список, Новый СервисПользователейЗаглушка(), Новый ФейкСервисПрав());

	Секции = Витрина.Секции("csrf-токен", Смотрящий(), Состояние());

	Итог = Новый Структура();
	Итог.Вставить("Учётки", Учётки.Обращений());
	Итог.Вставить("Личности", Личности.Обращений());
	Итог.Вставить("Всего", Учётки.Обращений() + Личности.Обращений());
	Итог.Вставить("Разметка", Секции[Секции.ВГраница()].Тело);
	Возврат Итог;

КонецФункции

Функция НастройкиВхода()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.password.enabled", Истина);
	Возврат Настройки;
КонецФункции

Функция ФормаЗаведения()
	Возврат Новый ФормаУчётки(UI.Кит, UI.Формы, Новый СервисПользователейЗаглушка(),
		Новый ОкноФормы(UI.Кит, UI.Тексты), UI.Тексты);
КонецФункции

Функция ДомХаба()
	Возврат Новый ДомХаба(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты);
КонецФункции

// Идентификатор смотрящего чужой ни одной учётке: своя строка действий не получает,
// и число строк не зависело бы от того, кто смотрит.
Функция Смотрящий()
	Возврат Новый Структура("Идентификатор, Логин, Админ", 0, "root", Истина);
КонецФункции

Функция Состояние()
	Возврат Новый Структура("Запрос, Подтверждение, Выпуск, Форма",
		"", Неопределено, Неопределено, Неопределено);
КонецФункции

#КонецОбласти

#Область МоиПакетыКабинета

// Блок «Мои пакеты» показывает шесть карточек, поэтому и читать обязан столько, сколько
// нужно шести карточкам: порядок он берёт из отметки, которую пакет носит в себе, а версии
// и счётчики спрашивает только у показанных. Восемь пакетов в управлении и сорок стоят
// одного и того же — иначе кабинет админа вычитывал бы все версии хаба ради горстки.
&Тест
Процедура ЦенаБлокаМоихПакетовНеРастётСЧисломПакетов() Экспорт

	Малый = ЦенаБлокаМоихПакетов(8, 30);
	Большой = ЦенаБлокаМоихПакетов(40, 30);

	Ожидаем.Что(Большой.Всего, СтрШаблон(
		"сорок пакетов стоят столько же строк, сколько восемь: %1 против %2",
		Формат(Большой.Всего, "ЧГ=0"), Формат(Малый.Всего, "ЧГ=0"))).Равно(Малый.Всего);

	Ожидаем.Что(Большой.СтрокВерсий, "версии спрошены только у показанных пакетов")
		.Равно(6 * 30);
	Ожидаем.Что(Большой.СтрокАгрегатов, "счётчики спрошены только у показанных пакетов")
		.Равно(6);

	// счётчик не должен мерить пустую работу: шесть карточек нарисованы, версии в них есть
	Ожидаем.Что(СтрЧислоВхождений(Большой.Разметка, "visually-hidden"">версия: "),
		"в блоке ровно шесть карточек, и у каждой есть версия").Равно(6);
	Ожидаем.Что(СтрНайти(Большой.Разметка, "пакет-40") > 0,
		"первым стоит пакет со свежайшей публикацией: " + Большой.Разметка).ЭтоИстина();

КонецПроцедуры

// Пакет без единой публикации версий не имеет и в горстку идёт последним — но только
// пока в ней есть место: пустая отметка последней публикации обязана уводить пакет вниз,
// а не наверх, и версия у него не печатается вовсе.
&Тест
Процедура НеизданныйПакетСтоитНижеИзданногоИБезВерсии() Экспорт

	Цена = ЦенаБлокаМоихПакетов(2, 3);

	Ожидаем.Что(СтрНайти(Цена.Разметка, "пакет-2") < СтрНайти(Цена.Разметка, "пакет-без-версий"),
		"изданное стоит выше неизданного: " + Цена.Разметка).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Цена.Разметка, "visually-hidden"">версия: "),
		"версия печатается только у изданных пакетов").Равно(2);

КонецПроцедуры

// Ровно один пакет фактуры остаётся без публикаций: без него сторож не заметил бы, что
// хвост «неизданное по имени» перестал печататься вовсе.
Функция ЦенаБлокаМоихПакетов(Знач ЧислоПакетов, Знач ВерсийНаПакет)

	Публикации = Новый СчитающееХранилищеПубликаций();
	Агрегаты = Новый СчитающееХранилищеАгрегатов();

	Сейчас = ТекущаяУниверсальнаяДата();
	Пакеты = Новый Массив();

	Для Номер = 1 По ЧислоПакетов Цикл

		// чем больше номер, тем свежее последняя публикация: последний пакет встаёт первым
		Свежесть = Сейчас - (ЧислоПакетов - Номер) * 86400;
		Пакеты.Добавить(ЗаписьУправления(Номер, СтрШаблон("пакет-%1", Формат(Номер, "ЧГ=0")),
			Свежесть));
		Агрегаты.Добавить(Номер, Номер * 10);

		Для Выпуск = 1 По ВерсийНаПакет Цикл
			Публикации.Добавить(Номер, СтрШаблон("1.%1.%2", Формат(Номер, "ЧГ=0"),
				Формат(Выпуск, "ЧГ=0")), Свежесть - ВерсийНаПакет + Выпуск);
		КонецЦикла;

	КонецЦикла;

	Пакеты.Добавить(ЗаписьУправления(ЧислоПакетов + 1, "пакет-без-версий", Неопределено));
	Агрегаты.Добавить(ЧислоПакетов + 1, 1);

	Разметка = БлокМоихПакетов(Публикации, Агрегаты).Блок(Пакеты);

	Итог = Новый Структура();
	Итог.Вставить("СтрокВерсий", Публикации.Строк());
	Итог.Вставить("СтрокАгрегатов", Агрегаты.Строк());
	Итог.Вставить("Всего", Публикации.Строк() + Агрегаты.Строк());
	Итог.Вставить("Разметка", Разметка);
	Возврат Итог;

КонецФункции

Функция БлокМоихПакетов(Знач Публикации, Знач Агрегаты)

	// имя «Версии» занято глобальным именем платформы: локальная переменная его не перебьёт.
	// Хранилище пакетов фейковое, а не Неопределено: пишущие пути сервиса правят отметку
	// последней публикации, и следующему, кто позовёт их отсюда, взрываться не на чем
	РеестрВерсий = Новый СервисВерсий(Публикации, Новый ФейкПакетовДляЛетописи(),
		Неопределено, Неопределено, Неопределено);
	Скачивания = Новый СлужбаСтатистикиСкачиваний(Новый СчётчикСкачиванийВПамяти(), Агрегаты,
		Неопределено, Новый НастройкиЗаглушка(), Новый ГотовностьЗаглушка());
	Витрина = Новый ВитринаПакетов(Новый ПровенансВсёСвоё(), Неопределено, UI.Тексты,
		UI.ЗначкиМеты);

	Возврат Новый ВитринаМоихПакетов(UI.Кит, Витрина, UI.КарточкаПакета, РеестрВерсий,
		Скачивания, UI.АдресаКаталога, UI.Тексты);

КонецФункции

Функция ЗаписьУправления(Знач Идентификатор, Знач Имя, Знач ПоследняяПубликация)

	Пакет = Новый Структура("Идентификатор, ПулИдентификатор, Имя, ИмяНижнийРегистр,"
		+ " Описание, Устарел, Скрыт, ПоследняяПубликация",
		Идентификатор, 1, Имя, НРег(Имя), "", Ложь, Ложь, ПоследняяПубликация);
	Возврат Новый Структура("Пул, Пакет", Новый Структура("Имя", "team"), Пакет);

КонецФункции

#КонецОбласти

#Область ВходящиеЗаявкиКабинета

// Сводка «входящих» ведёт все пулы принципала, и её цена держится числом пулов и заявок
// только до тех пор, пока очередь, пулы, заявители и права спрашиваются разрезами.
// Два пула с двумя заявками и двадцать с двадцатью стоят одинаково.
&Тест
Процедура ЦенаСводкиВходящихНеРастётСЧисломЗаявокИПулов() Экспорт

	НаДвух = ЦенаСводкиВходящих(2);
	НаДвадцати = ЦенаСводкиВходящих(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать заявок в двадцати пулах стоят столько же обращений, сколько две в двух:"
			+ " %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Заявки, "очередь всех пулов — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Пулы, "пулы заявок — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Заявители, "заявители всех строк — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Группы, "группы субъекта спрошены один раз на весь обход").Равно(1);

	// счётчик не должен мерить пустую работу: строки собраны и заявители в них названы
	Ожидаем.Что(НаДвадцати.Строк, "показаны все двадцать заявок").Равно(20);
	Ожидаем.Что(НаДвадцати.Заявитель, "заявитель строки назван логином").Равно("заявитель-20");

КонецПроцедуры

Функция ЦенаСводкиВходящих(Знач ЧислоПулов)

	Заявки = Новый СчитающийСервисВходящих();
	Пулы = Новый СчитающийСервисПулов();
	Учётки = Новый СчитающийСервисУчёток();
	Гранты = Новый СчитающееХранилищеГрантов();
	Участники = Новый СчитающееХранилищеУчастников();
	Группы = Новый СчитающийСервисГрупп();

	Для Номер = 1 По ЧислоПулов Цикл
		Пулы.ДобавитьПул(Номер, СтрШаблон("пул-%1", Формат(Номер, "ЧГ=0")));
		Участники.Добавить(Номер, "пользователь", Мейнтейнер().Идентификатор, "мейнтейнер");
		Учётки.Добавить(ЧислоПулов + Номер, СтрШаблон("заявитель-%1", Формат(Номер, "ЧГ=0")));
		Заявки.Добавить(Номер, ЧислоПулов + Номер);
	КонецЦикла;

	Права = Новый СервисПрав(Группы, Участники, Гранты, Неопределено);
	Рассмотрение = Новый РассмотрениеВходящих(Заявки, Неопределено, Пулы, Неопределено,
		Неопределено, Права, Неопределено, Учётки, Неопределено,
		Новый ГвардКлючаПропускающий());

	Строки = Рассмотрение.ОжидающиеПринципала(
		Новый Структура("Пользователь", Мейнтейнер()));

	Итог = Новый Структура();
	Итог.Вставить("Заявки", Заявки.Обращений());
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Заявители", Учётки.Обращений());
	Итог.Вставить("Группы", Группы.Обращений());
	Итог.Вставить("Всего", Заявки.Обращений() + Пулы.Обращений() + Учётки.Обращений()
		+ Гранты.Обращений() + Участники.Обращений() + Группы.Обращений());
	Итог.Вставить("Строк", Строки.Количество());
	Итог.Вставить("Заявитель", ?(Строки.Количество() = 0, "", Строки[0].Заявитель.Логин));
	Возврат Итог;

КонецФункции

// Не админ хаба: суперправо отвечало бы на любой вопрос о правах, не спрашивая базу,
// и сторож перестал бы мерить то, ради чего заведён.
Функция Мейнтейнер()
	Возврат Новый Структура("Идентификатор, Логин, РольХаба", 7, "мейнтейнер", "user");
КонецФункции

#КонецОбласти

#Область ЛентаКабинета

// Виджету ленты нужны и верхние строки, и общее число непрочитанного — это один и тот же
// срез, и стоит он одного чтения независимо от того, сколько записей человек накопил.
&Тест
Процедура ЦенаВиджетаЛентыНеРастётСЧисломУведомлений() Экспорт

	НаДвух = ЦенаВиджетаЛенты(2);
	НаДвадцати = ЦенаВиджетаЛенты(20);

	Ожидаем.Что(НаДвадцати.Обращений, СтрШаблон(
		"двадцать уведомлений стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Обращений, "ЧГ=0"),
		Формат(НаДвух.Обращений, "ЧГ=0"))).Равно(НаДвух.Обращений);

	Ожидаем.Что(НаДвадцати.Обращений, "строки виджета и счёт непрочитанного — одно чтение")
		.Равно(1);

	// счётчик не должен мерить пустую работу: счёт полон, а строк ровно столько, сколько
	// помещается в виджет
	Ожидаем.Что(НаДвадцати.Непрочитано, "счёт называет всё непрочитанное").Равно(20);
	Ожидаем.Что(НаДвадцати.Свежих, "строк ровно по пределу виджета").Равно(3);

КонецПроцедуры

Функция ЦенаВиджетаЛенты(Знач ЧислоУведомлений)

	Хранилище = Новый СчитающееХранилищеЛенты();
	Для Номер = 1 По ЧислоУведомлений Цикл
		Хранилище.Добавить(АдресатЛенты().Идентификатор);
	КонецЦикла;

	Сводка = Новый ЛентаУведомлений(Хранилище).СводкаНепрочитанного(АдресатЛенты(), 3);

	Итог = Новый Структура();
	Итог.Вставить("Обращений", Хранилище.Обращений());
	Итог.Вставить("Непрочитано", Сводка.Непрочитано);
	Итог.Вставить("Свежих", Сводка.Свежие.Количество());
	Возврат Итог;

КонецФункции

Функция АдресатЛенты()
	Возврат Новый Структура("Идентификатор, Логин", 7, "адресат");
КонецФункции

#КонецОбласти
