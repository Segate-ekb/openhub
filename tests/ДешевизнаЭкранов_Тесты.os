// Сторожа дешевизны двух списков web-ui: цена экрана в обращениях к базе НЕ РАСТЁТ
// с числом строк. Каждый экран собирается дважды — на двух строках и на двадцати, —
// а обращения считают хранилища-фикстуры: секундомер мерил бы машину, счётчик меряет N+1.
// Экраны собраны руками на ките, без контейнера: между витриной и счётчиком не должно
// оказаться ничего лишнего.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;              // СборкаUI — граф компонентов и рендереров web-ui
Перем КаталогМодулей;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("СервисПользователейЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ЧтениеПуловЗаглушка");
	РеестрФикстур.Подключить("СчитающееХранилищеТокенов");
	РеестрФикстур.Подключить("СчитающееХранилищеПривязок");
	РеестрФикстур.Подключить("СчитающийСервисПулов");
	РеестрФикстур.Подключить("СчитающееХранилищеУчёток");
	РеестрФикстур.Подключить("СчитающееХранилищеЛичностей");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	КаталогИнтерфейса = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("КаталогРазделов,ЯчейкиТаблицы,ПлашкиПула,ОкноФормы,"
		+ "ДомАккаунта,ДомХаба,ФормаПодбораПулов,ФормаУчётки,"
		+ "ВитринаТокеновКабинета,ВитринаУчёток", ",") Цикл
		Поиск.Подключить(КаталогИнтерфейса, Имя);
	КонецЦикла;

	КаталогВхода = ОбъединитьПути(КаталогМодулей, "вход", "Классы");
	Для Каждого Имя Из СтрРазделить("СервисТокенов,ГейтТокена,"
		+ "СервисАктивностиУчёток,СписокУчёток,ПолитикаПарольногоВхода", ",") Цикл
		Поиск.Подключить(КаталогВхода, Имя);
	КонецЦикла;

	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "поиск", "Классы"), "ПоискПоКоллекции");

КонецПроцедуры

#Область ТокеныКабинета

// Список ключей кабинета стоит трёх обращений к базе — список, наборы пулов, имена
// пулов — и столько же на двадцати ключах: «набор пулов ключа» и «имя пула привязки»
// спрашиваются разом на весь экран, а не на строку.
&Тест
Процедура ЦенаСпискаТокеновНеРастётСЧисломТокенов() Экспорт

	НаДвух = ЦенаЭкранаТокенов(2);
	НаДвадцати = ЦенаЭкранаТокенов(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать ключей стоят столько же обращений, сколько два: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Токены, "список ключей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Привязки, "наборы пулов всех ключей — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Пулы, "имена пулов — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: строки нарисованы и имена пулов в них есть
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "альфа, бета"),
		"в каждой из двадцати строк названы оба пула ключа").Равно(20);

	// строка старого ключа приезжает тем же разрезом: рамку из колонки записи экран
	// называет пулом, а не «весь хаб»
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "гамма"),
		"старый ключ с одиночной привязкой назван своим пулом").Равно(1);

КонецПроцедуры

Функция ЦенаЭкранаТокенов(Знач ЧислоТокенов)

	Хранилище = Новый СчитающееХранилищеТокенов();
	Привязки = Новый СчитающееХранилищеПривязок();

	Пулы = Новый СчитающийСервисПулов();
	Пулы.ДобавитьПул(1, "альфа");
	Пулы.ДобавитьПул(2, "бета");
	Пулы.ДобавитьПул(3, "гамма");

	Для Номер = 1 По ЧислоТокенов Цикл
		Хранилище.Добавить(Номер, ВладелецКлючей(), СтрШаблон("ключ %1", Формат(Номер, "ЧГ=0")));
		Привязки.Записать(Номер, 1);
		Привязки.Записать(Номер, 2);
	КонецЦикла;

	// ключ, выпущенный до появления набора: рамка колонкой записи, строк привязок нет
	Хранилище.Добавить(НомерСтарогоКлюча(), ВладелецКлючей(), "старый ключ", 3);

	Токены = Новый СервисТокенов(Хранилище, НастройкиТокенов(), Привязки);
	Витрина = Новый ВитринаТокеновКабинета(UI.Кит, Новый ЯчейкиТаблицы(UI.Кит), ДомАккаунта(),
		Токены, Пулы, Новый ЧтениеПуловЗаглушка(), ОкноПодбора(Пулы), Новый ГейтТокена(Токены));

	Разметка = Витрина.Раздел(Вердикт(), "csrf-токен", "", Заявка()).Рендер();

	Итог = Новый Структура();
	Итог.Вставить("Токены", Хранилище.Обращений());
	Итог.Вставить("Привязки", Привязки.Обращений());
	Итог.Вставить("Пулы", Пулы.Обращений());
	Итог.Вставить("Всего", Хранилище.Обращений() + Привязки.Обращений() + Пулы.Обращений());
	Итог.Вставить("Разметка", Разметка);
	Возврат Итог;

КонецФункции

Функция НастройкиТокенов()

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.token.max_days", 90);
	Настройки.Задать("oshub.auth.token.cli_days", 30);
	Возврат Настройки;

КонецФункции

Функция ОкноПодбора(Знач Пулы)
	Возврат Новый ФормаПодбораПулов(UI.Кит, UI.Формы,
		Новый ПлашкиПула(Пулы, UI.Тексты, UI.ЗначкиМеты));
КонецФункции

Функция ДомАккаунта()
	Возврат Новый ДомАккаунта(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты,
		UI.АдресаКабинета);
КонецФункции

Функция ВладелецКлючей()
	Возврат 7;
КонецФункции

// Номер заведомо больше любого номера современных ключей набора: строки не пересекаются.
Функция НомерСтарогоКлюча()
	Возврат 100;
КонецФункции

Функция Вердикт()
	Возврат Новый Структура("Пользователь, Принципал",
		Новый Структура("Идентификатор", ВладелецКлючей()), Неопределено);
КонецФункции

// Пустая форма выпуска: окно подбора закрыто, набора пулов в ней нет.
Функция Заявка()
	Возврат Новый Структура("Имя, Чтение, Запись, Пулы, Срок, Поиск, Подбор",
		"", Истина, Истина, Новый Массив(), "30", "", Ложь);
КонецФункции

#КонецОбласти

#Область УчёткиХаба

// Список учёток дома «Хаб» стоит двух обращений — список и внешние личности всего
// списка — и столько же на двадцати учётках: «есть ли чем войти» спрашивается разом,
// а не на строку.
&Тест
Процедура ЦенаСпискаУчётокНеРастётСЧисломУчёток() Экспорт

	НаДвух = ЦенаЭкранаУчёток(2);
	НаДвадцати = ЦенаЭкранаУчёток(20);

	Ожидаем.Что(НаДвадцати.Всего, СтрШаблон(
		"двадцать учёток стоят столько же обращений, сколько две: %1 против %2",
		Формат(НаДвадцати.Всего, "ЧГ=0"), Формат(НаДвух.Всего, "ЧГ=0"))).Равно(НаДвух.Всего);

	Ожидаем.Что(НаДвадцати.Учётки, "список учёток — одно обращение").Равно(1);
	Ожидаем.Что(НаДвадцати.Личности, "внешние личности всего списка — одно обращение").Равно(1);

	// счётчик не должен мерить пустую работу: строки нарисованы, и ответ «чем войти»
	// в них РАЗНЫЙ — половина учёток без пароля и без личности
	Ожидаем.Что(СтрЧислоВхождений(НаДвадцати.Разметка, "нечем войти"),
		"плашка стоит ровно у учёток без пароля и без личности").Равно(10);

КонецПроцедуры

Функция ЦенаЭкранаУчёток(Знач ЧислоУчёток)

	Учётки = Новый СчитающееХранилищеУчёток();
	Личности = Новый СчитающееХранилищеЛичностей();

	Для Номер = 1 По ЧислоУчёток Цикл
		Учётки.Добавить(Номер, СтрШаблон("user%1", Формат(Номер, "ЧГ=0")));
		// личность у каждой второй: ответ «есть чем войти» обязан быть разным по строкам
		Если Номер % 2 = 0 Тогда
			Личности.Привязать(Номер);
		КонецЕсли;
	КонецЦикла;

	Активность = Новый СервисАктивностиУчёток(Личности, Новый ФейкСервисПрав(),
		Новый ПолитикаПарольногоВхода(НастройкиВхода()), Неопределено);
	Список = Новый СписокУчёток(Учётки, Активность, Новый ПоискПоКоллекции());

	Витрина = Новый ВитринаУчёток(UI.Кит, UI.РендерерНастроек, ФормаЗаведения(), UI.Формы,
		ДомХаба(), Список, Новый СервисПользователейЗаглушка(), Новый ФейкСервисПрав());

	Секции = Витрина.Секции("csrf-токен", Смотрящий(), Состояние());

	Итог = Новый Структура();
	Итог.Вставить("Учётки", Учётки.Обращений());
	Итог.Вставить("Личности", Личности.Обращений());
	Итог.Вставить("Всего", Учётки.Обращений() + Личности.Обращений());
	Итог.Вставить("Разметка", Секции[Секции.ВГраница()].Тело);
	Возврат Итог;

КонецФункции

Функция НастройкиВхода()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.password.enabled", Истина);
	Возврат Настройки;
КонецФункции

Функция ФормаЗаведения()
	Возврат Новый ФормаУчётки(UI.Кит, UI.Формы, Новый СервисПользователейЗаглушка(),
		Новый ОкноФормы(UI.Кит, UI.Тексты), UI.Тексты);
КонецФункции

Функция ДомХаба()
	Возврат Новый ДомХаба(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты);
КонецФункции

// Идентификатор смотрящего чужой ни одной учётке: своя строка действий не получает,
// и число строк не зависело бы от того, кто смотрит.
Функция Смотрящий()
	Возврат Новый Структура("Идентификатор, Логин, Админ", 0, "root", Истина);
КонецФункции

Функция Состояние()
	Возврат Новый Структура("Запрос, Подтверждение, Выпуск, Форма",
		"", Неопределено, Неопределено, Неопределено);
КонецФункции

#КонецОбласти
