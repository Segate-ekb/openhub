// Юнит-тесты репозиториев db: регистрация хранилищ желудями (autumn-data) и методы запросов на КоннектореInMemory.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;   // общий контейнер на все тесты набора

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), ОбъединитьПути("данные", "Классы"));

	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассовDb, "*.os", Истина) Цикл
		// без глушения ошибок: синтаксически сломанный класс должен уронить набор
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;

	Детальки = Новый Соответствие();

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "репозитории-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&Тест
Процедура ВсеРепозиторииРегистрируютсяЖелудями() Экспорт

	ИменаРепозиториев = СтрРазделить(
		"ХранилищеПулов,ХранилищеПакетов,ХранилищеВерсийПакета,ХранилищеМетокТегов,ХранилищеТегов,"
		+ "ХранилищеЗависимостей,ХранилищеМетокВерсий,ХранилищеПроисхожденияВерсий,"
		+ "ЗапросыПакетов,ЗапросыВерсийПакета,ЗапросыЗависимостей,"
		+ "ЗапросыТегов,ЗапросыМетокТегов,ЗапросыМетокВерсий,ЗапросыПроисхожденияВерсий", ",");

	Для Каждого ИмяРепозитория Из ИменаРепозиториев Цикл
		Репозиторий = Поделка.НайтиЖелудь(ИмяРепозитория);
		Ожидаем.Что(Репозиторий, СтрШаблон("желудь %1", ИмяРепозитория)).Существует();
	КонецЦикла;

	// для сущностей без собственного репозитория autumn-data регистрирует базовое хранилище
	АвтоХранилище = Поделка.НайтиЖелудь("ХранилищеСущностейВебСессия");
	Ожидаем.Что(АвтоХранилище).ИмеетТип("ХранилищеСущностей");

КонецПроцедуры

// Фасад — не репозиторий: API entity (Получить(ОпцииПоиска) и прочее) на нём отсутствует,
// а тип желудя — сам класс, а не декоратор-наследник ХранилищеСущностей.
&Тест
Процедура ФасадыХранилищНеЯвляютсяРепозиториямиEntity() Экспорт

	ИменаФасадов = СтрРазделить(
		"ХранилищеТегов,ХранилищеМетокТегов,ХранилищеМетокВерсий,ХранилищеПроисхожденияВерсий,"
		+ "ХранилищеПакетов,ХранилищеВерсийПакета,ХранилищеЗависимостей", ",");

	Для Каждого ИмяФасада Из ИменаФасадов Цикл
		Ожидаем.Что(Строка(ТипЗнч(Поделка.НайтиЖелудь(ИмяФасада))),
			СтрШаблон("тип желудя %1 — сам класс, а не декоратор-наследник", ИмяФасада))
			.Равно(ИмяФасада);
		Ожидаем.Что(МетодаНет(Поделка.НайтиЖелудь(ИмяФасада)),
			СтрШаблон("Получить(ОпцииПоиска) на фасаде %1 недоступен", ИмяФасада)).ЭтоИстина();
	КонецЦикла;

	// контроль: у класса запросов Получить ЕСТЬ — иначе проверка выше ничего не доказывает
	Ожидаем.Что(МетодаНет(Поделка.НайтиЖелудь("ЗапросыТегов")),
		"у ЗапросыТегов метод Получить унаследован от ХранилищеСущностей").ЭтоЛожь();

КонецПроцедуры

// Истина, если у объекта нет метода Получить: любое другое падение — метод есть, но вызван неверно.
Функция МетодаНет(Знач Объект)

	Попытка
		Объект.Получить();
	Исключение
		Возврат СтрНайти(НРег(ОписаниеОшибки()), "method not found") > 0;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

&Тест
Процедура ХранилищеПуловИщетПоИмениИТипу() Экспорт

	ХранилищеПулов = Поделка.НайтиЖелудь("ХранилищеПулов");

	Пул = ХранилищеПулов.СоздатьЭлемент();
	Пул.Имя = "main";
	Пул.Тип = "custom";
	Пул.Видимость = "public";
	Пул.Создан = ТекущаяУниверсальнаяДата();
	Пул.Сохранить();

	Найденный = ХранилищеПулов.ПолучитьОдноПоИмяРавно("main");
	Ожидаем.Что(Найденный).Существует();
	Ожидаем.Что(Найденный.Идентификатор).Равно(Пул.Идентификатор);

	Локальные = ХранилищеПулов.ПолучитьПоТипРавно("custom");
	Ожидаем.Что(Локальные.Количество()).Равно(1);

	Ожидаем.Что(ХранилищеПулов.ПолучитьОдноПоИмяРавно("нет-такого")).Равно(Неопределено);
	Ожидаем.Что(ХранилищеПулов.ПолучитьПоТипРавно("user").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ХранилищеПакетовИщетПоКаноническомуИмени() Экспорт

	ХранилищеПакетов = Поделка.НайтиЖелудь("ХранилищеПакетов");

	Пакет = ХранилищеПакетов.СоздатьЭлемент();
	Пакет.ПулИдентификатор = 10;
	Пакет.Имя = "WiNow";
	Пакет.ИмяНижнийРегистр = "winow";
	Пакет.Скрыт = Ложь;
	Пакет.Устарел = Ложь;
	Пакет.Создан = ТекущаяУниверсальнаяДата();
	Пакет.Сохранить();

	Найденный = ХранилищеПакетов.ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(10, "winow");
	Ожидаем.Что(Найденный).Существует();
	Ожидаем.Что(Найденный.Имя).Равно("WiNow");

	Ожидаем.Что(ХранилищеПакетов.НайтиПоИмени(10, "WINOW")).Существует();
	Ожидаем.Что(ХранилищеПакетов.НайтиПоИмени(10, "wInOw").Идентификатор).Равно(Пакет.Идентификатор);

	Ожидаем.Что(ХранилищеПакетов.НайтиПоИмени(11, "winow")).Равно(Неопределено);
	Ожидаем.Что(ХранилищеПакетов.НайтиПоИмени(10, "unknown")).Равно(Неопределено);

	ПакетыПула = ХранилищеПакетов.ПолучитьПоПулИдентификаторРавно(10);
	Ожидаем.Что(ПакетыПула.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ХранилищеВерсийФильтруетОтозванные() Экспорт

	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");

	ДобавитьВерсию(ХранилищеВерсий, 20, "1.0.0", Ложь);
	ДобавитьВерсию(ХранилищеВерсий, 20, "1.1.0", Истина);
	ДобавитьВерсию(ХранилищеВерсий, 21, "2.0.0", Ложь);

	Все = ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавно(20);
	Ожидаем.Что(Все.Количество()).Равно(2);

	Действующие = ХранилищеВерсий.ДействующиеВерсии(20);
	Ожидаем.Что(Действующие.Количество()).Равно(1);
	Ожидаем.Что(Действующие[0].Версия).Равно("1.0.0");

	Конкретная = ХранилищеВерсий.ПолучитьОдноПоПакетИдентификаторРавноИВерсияРавно(20, "1.1.0");
	Ожидаем.Что(Конкретная).Существует();
	Ожидаем.Что(Конкретная.Отозвана).Равно(Истина);

	Ожидаем.Что(ХранилищеВерсий.ПолучитьОдноПоПакетИдентификаторРавноИВерсияРавно(20, "9.9.9")).Равно(Неопределено);

КонецПроцедуры

// Регрессия: метод запроса по ЗависимостьВерсии не был объявлен — страница любого пакета с зависимостями отдавала 500.
&Тест
Процедура ХранилищеВерсийИщетПоИдентификатору() Экспорт

	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");

	ДобавитьВерсию(ХранилищеВерсий, 30, "3.0.0", Ложь);
	Версия = ХранилищеВерсий.ПолучитьОдноПоПакетИдентификаторРавноИВерсияРавно(30, "3.0.0");

	Найденная = ХранилищеВерсий.ПолучитьОдноПоИдентификаторРавно(Версия.Идентификатор);
	Ожидаем.Что(Найденная).Существует();
	Ожидаем.Что(Найденная.Версия).Равно("3.0.0");

	Ожидаем.Что(ХранилищеВерсий.ПолучитьОдноПоИдентификаторРавно(999999)).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ХранилищеТеговИщетПоИмени() Экспорт

	ХранилищеТегов = Поделка.НайтиЖелудь("ХранилищеТегов");

	Тег = ХранилищеТегов.СоздатьЭлемент();
	Тег.ПакетИдентификатор = 40;
	Тег.Имя = "latest";
	Тег.Режим = "правило";
	Тег.ТипПравила = "semver";
	Тег.Правило = "*";
	Тег.ПоУмолчанию = Истина;
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить();

	// состав канала — отдельная таблица МеткиТегов со своим репозиторием, колонки-указателя у тега нет
	ХранилищеМеток = Поделка.НайтиЖелудь("ХранилищеМетокТегов");
	Метка = ХранилищеМеток.СоздатьЭлемент();
	Метка.ТегИдентификатор = Тег.Идентификатор;
	Метка.ВерсияИдентификатор = 100;
	Метка.Сохранить();

	НайденныйТег = ХранилищеТегов.ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(40, "latest");
	Ожидаем.Что(НайденныйТег).Существует();
	Состав = ХранилищеМеток.ПолучитьПоТегИдентификаторРавно(НайденныйТег.Идентификатор);
	Ожидаем.Что(Состав.Количество(), "состав канала читается по тегу").Равно(1);
	Ожидаем.Что(Состав[0].ВерсияИдентификатор, "помеченная версия").Равно(100);
	Ожидаем.Что(НайденныйТег.Режим, "режим тега сохраняется").Равно("правило");
	Ожидаем.Что(НайденныйТег.Правило, "правило тега сохраняется").Равно("*");
	Ожидаем.Что(НайденныйТег.ПоУмолчанию, "флаг «по умолчанию» сохраняется").Равно(Истина);
	Ожидаем.Что(ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(40).Количество()).Равно(1);
	Ожидаем.Что(ХранилищеТегов.ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(40, "lts")).Равно(Неопределено);

КонецПроцедуры

// Отбор по ИмяНижнийРегистр обязан бить именно в ИмяНижнийРегистр: имя колонки Имя — её префикс,
// и при обратном порядке объявления в сущности токенайзер autumn-data молча ушёл бы в Имя.
&Тест
Процедура ОтборПакетаНеПутаетИмяСКаноническимИменем() Экспорт

	ХранилищеПакетов = Поделка.НайтиЖелудь("ХранилищеПакетов");

	Канонический = СоздатьПакет(ХранилищеПакетов, 12, "Beta", "beta");
	Ловушка = СоздатьПакет(ХранилищеПакетов, 12, "beta", "gamma");

	Найденный = ХранилищеПакетов.ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(12, "beta");
	Ожидаем.Что(Найденный, "строка с ИмяНижнийРегистр = beta").Существует();
	Ожидаем.Что(Найденный.Идентификатор, "отбор идёт по ИмяНижнийРегистр, а не по Имя").Равно(Канонический.Идентификатор);
	Ожидаем.Что(Найденный.Идентификатор <> Ловушка.Идентификатор, "ловушка Имя = beta отсеяна").ЭтоИстина();

	Ожидаем.Что(ХранилищеПакетов.НайтиПоИмени(12, "BeTa").Идентификатор,
		"НайтиПоИмени канонизирует регистр").Равно(Канонический.Идентификатор);

КонецПроцедуры

// Отбор по пулу реально отсеивает чужие пулы, а Все() не отсеивает ничего.
&Тест
Процедура ХранилищеПакетовОтбираетПоПулуИОтдаётВсеБезОтбора() Экспорт

	ХранилищеПакетов = Поделка.НайтиЖелудь("ХранилищеПакетов");

	Свой = СоздатьПакет(ХранилищеПакетов, 13, "Delta", "delta");
	Чужой = СоздатьПакет(ХранилищеПакетов, 14, "Delta", "delta");

	ПакетыПула = ХранилищеПакетов.ПолучитьПоПулИдентификаторРавно(13);
	Ожидаем.Что(ПакетыПула.Количество(), "в пуле 13 ровно один пакет").Равно(1);
	Ожидаем.Что(ПакетыПула[0].Идентификатор, "выбран пакет своего пула").Равно(Свой.Идентификатор);

	Все = ХранилищеПакетов.Все();
	Ожидаем.Что(ЕстьВВыборке(Все, Свой.Идентификатор), "Все() содержит пакет пула 13").ЭтоИстина();
	Ожидаем.Что(ЕстьВВыборке(Все, Чужой.Идентификатор), "Все() содержит пакет пула 14").ЭтоИстина();
	Ожидаем.Что(Все.Количество() > ПакетыПула.Количество(), "Все() шире отбора по пулу").ЭтоИстина();

	Ожидаем.Что(ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(Чужой.Идентификатор).ПулИдентификатор,
		"поиск по идентификатору достаёт именно свою строку").Равно(14);

КонецПроцедуры

// Отбор по Версия обязан бить именно в Версия: ВерсияДвижка объявлена раньше и начинается тем же словом.
&Тест
Процедура ОтборВерсииНеПутаетВерсиюСВерсиейДвижка() Экспорт

	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");

	ПоложитьВерсию(ХранилищеВерсий, 22, "1.0.0", Ложь, "2.0.0", 0);
	Перевёрнутая = ПоложитьВерсию(ХранилищеВерсий, 22, "2.0.0", Ложь, "1.0.0", 0);

	Найденная = ХранилищеВерсий.ПолучитьОдноПоПакетИдентификаторРавноИВерсияРавно(22, "2.0.0");
	Ожидаем.Что(Найденная, "версия 2.0.0 пакета 22").Существует();
	Ожидаем.Что(Найденная.Идентификатор, "отбор идёт по Версия, а не по ВерсияДвижка").Равно(Перевёрнутая.Идентификатор);

КонецПроцедуры

// Отбор по публикатору отсеивает версии других публикаторов и других пакетов.
&Тест
Процедура ХранилищеВерсийОтбираетПоПубликатору() Экспорт

	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");

	ПоложитьВерсию(ХранилищеВерсий, 23, "1.0.0", Ложь, "", 777);
	Чужая = ПоложитьВерсию(ХранилищеВерсий, 23, "1.1.0", Ложь, "", 778);
	ПоложитьВерсию(ХранилищеВерсий, 24, "5.0.0", Истина, "", 777);

	// имя «Версии» занято глобальным свойством OneScript — переменная с ним не создаётся
	ЕгоВерсии = ХранилищеВерсий.ПолучитьПоОпубликовалИдентификаторРавно(777);
	Ожидаем.Что(ЕгоВерсии.Количество(), "версии публикатора 777 из разных пакетов").Равно(2);
	Ожидаем.Что(ЕстьВВыборке(ЕгоВерсии, Чужая.Идентификатор), "версия чужого публикатора отсеяна").ЭтоЛожь();

	Ожидаем.Что(ХранилищеВерсий.ПолучитьПоОпубликовалИдентификаторРавно(779).Количество(),
		"публикатор без версий").Равно(0);

КонецПроцедуры

// Признак отзыва — параметр деривованного метода: обе стороны отбора обязаны фильтровать.
&Тест
Процедура ХранилищеВерсийОтбираетПоПризнакуОтзыва() Экспорт

	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");

	ДобавитьВерсию(ХранилищеВерсий, 25, "1.0.0", Ложь);
	Отозванная = ПоложитьВерсию(ХранилищеВерсий, 25, "1.1.0", Истина, "", 0);
	ДобавитьВерсию(ХранилищеВерсий, 26, "1.0.0", Истина);

	Отозванные = ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавноИОтозванаРавно(25, Истина);
	Ожидаем.Что(Отозванные.Количество(), "отозванные версии пакета 25").Равно(1);
	Ожидаем.Что(Отозванные[0].Идентификатор, "отозвана именно 1.1.0").Равно(Отозванная.Идентификатор);

	Ожидаем.Что(ХранилищеВерсий.ДействующиеВерсии(26).Количество(),
		"у пакета 26 все версии отозваны").Равно(0);

КонецПроцедуры

// Зависимости читаются в обе стороны, и обе стороны реально фильтруют.
&Тест
Процедура ХранилищеЗависимостейЧитаетВОбеСтороны() Экспорт

	ХранилищеЗависимостей = Поделка.НайтиЖелудь("ХранилищеЗависимостей");

	ДобавитьЗависимость(ХранилищеЗависимостей, 5001, "winow");
	ДобавитьЗависимость(ХранилищеЗависимостей, 5001, "logos");
	ДобавитьЗависимость(ХранилищеЗависимостей, 5002, "winow");

	Свои = ХранилищеЗависимостей.ПоВерсии(5001);
	Ожидаем.Что(Свои.Количество(), "зависимости версии 5001").Равно(2);
	Ожидаем.Что(ХранилищеЗависимостей.ПоВерсии(5003).Количество(), "версия без зависимостей").Равно(0);

	КтоЗависит = ХранилищеЗависимостей.КтоЗависитОт("winow");
	Ожидаем.Что(КтоЗависит.Количество(), "на winow ссылаются две версии").Равно(2);
	Ожидаем.Что(ХранилищеЗависимостей.КтоЗависитОт("  winow  ").Количество(),
		"фасад обрезает пробелы аргумента").Равно(2);
	Ожидаем.Что(ХранилищеЗависимостей.КтоЗависитОт("logos").Количество(),
		"на logos ссылается одна версия").Равно(1);
	Ожидаем.Что(ХранилищеЗависимостей.КтоЗависитОт("нет-такого").Количество(),
		"имя без ссылок").Равно(0);

КонецПроцедуры

// ИСТ-КАТ-014: в адресе регистр имени не значим, значит и в обратном графе он не значим.
// Хранимое для поиска и показываемое человеку разведены: ищется ключ без регистра,
// показывается имя так, как его написал автор манифеста.
&Тест
Процедура ОбратныйГрафНеЗависитОтРегистраИмени() Экспорт

	ХранилищеЗависимостей = Поделка.НайтиЖелудь("ХранилищеЗависимостей");

	// имя набрано только этим тестом: считать записи соседей по набору нельзя
	ДобавитьЗависимость(ХранилищеЗависимостей, 5101, "RegCase");
	ДобавитьЗависимость(ХранилищеЗависимостей, 5102, "regcase");
	ДобавитьЗависимость(ХранилищеЗависимостей, 5103, "REGCASE");

	Для Каждого Написание Из СтрРазделить("regcase,RegCase,REGCASE,  ReGcAsE  ", ",") Цикл
		Ожидаем.Что(ХранилищеЗависимостей.КтоЗависитОт(Написание).Количество(),
			СтрШаблон("запрос ""%1"" находит всех троих", Написание)).Равно(3);
	КонецЦикла;

	// показывает хаб каноническое имя, но написание автора манифеста хранилище не теряет
	Ожидаем.Что(Строка(ХранилищеЗависимостей.ПоВерсии(5101)[0].ИмяПакета),
		"написание автора сохранено как есть").Равно("RegCase");
	Ожидаем.Что(Строка(ХранилищеЗависимостей.ПоВерсии(5103)[0].ИмяПакета),
		"и у соседа тоже своё написание").Равно("REGCASE");
	Ожидаем.Что(Строка(ХранилищеЗависимостей.ПоВерсии(5103)[0].ИмяПакетаНижнийРегистр),
		"а каноническое имя — то, что печатает вкладка").Равно("regcase");

	// похожее имя — другой пакет
	Ожидаем.Что(ХранилищеЗависимостей.КтоЗависитОт("regcase2").Количество(),
		"имя-префикс в графе не появляется").Равно(0);

КонецПроцедуры

// Метки версий: отбор по версии, по метке и по паре — каждый со строками, которые обязан отсеять.
&Тест
Процедура ХранилищеМетокВерсийОтбираетПоВерсииИМетке() Экспорт

	ХранилищеМеток = Поделка.НайтиЖелудь("ХранилищеМетокВерсий");

	ДобавитьМеткуВерсии(ХранилищеМеток, 6001, "dev");
	ДобавитьМеткуВерсии(ХранилищеМеток, 6001, "beta");
	ДобавитьМеткуВерсии(ХранилищеМеток, 6002, "dev");

	Ожидаем.Что(ХранилищеМеток.ПолучитьПоВерсияИдентификаторРавно(6001).Количество(),
		"метки версии 6001").Равно(2);
	Ожидаем.Что(ХранилищеМеток.ПолучитьПоМеткаРавно("dev").Количество(),
		"метку dev носят две версии").Равно(2);
	Ожидаем.Что(ХранилищеМеток.ПолучитьПоМеткаРавно("beta").Количество(),
		"метку beta носит одна версия").Равно(1);

	Пара = ХранилищеМеток.ПолучитьОдноПоВерсияИдентификаторРавноИМеткаРавно(6002, "dev");
	Ожидаем.Что(Пара, "пара (6002, dev)").Существует();
	Ожидаем.Что(Пара.ВерсияИдентификатор, "выбрана строка своей версии").Равно(6002);
	Ожидаем.Что(ХранилищеМеток.ПолучитьОдноПоВерсияИдентификаторРавноИМеткаРавно(6002, "beta"),
		"пары (6002, beta) нет").Равно(Неопределено);

КонецПроцедуры

// Провенанс: отбор по версии и по пакету — со строками соседних версий и соседних пакетов.
&Тест
Процедура ХранилищеПроисхожденияОтбираетПоВерсииИПакету() Экспорт

	Хранилище = Поделка.НайтиЖелудь("ХранилищеПроисхожденияВерсий");

	ДобавитьПроисхождение(Хранилище, 50, 7001, "свой");
	ДобавитьПроисхождение(Хранилище, 50, 7002, "апстрим");
	ДобавитьПроисхождение(Хранилище, 51, 7003, "свой");

	Запись = Хранилище.ПолучитьОдноПоВерсияИдентификаторРавно(7002);
	Ожидаем.Что(Запись, "провенанс версии 7002").Существует();
	Ожидаем.Что(Запись.Источник, "выбрана строка своей версии").Равно("апстрим");
	Ожидаем.Что(Хранилище.ПолучитьОдноПоВерсияИдентификаторРавно(7009),
		"версия без провенанса").Равно(Неопределено);

	Ожидаем.Что(Хранилище.ПолучитьПоПакетИдентификаторРавно(50).Количество(),
		"провенанс всех версий пакета 50").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоПакетИдентификаторРавно(52).Количество(),
		"пакет без провенанса").Равно(0);

КонецПроцедуры

// Теги и состав каналов: отбор по пакету и по имени тега со строками-соседями.
&Тест
Процедура ХранилищеТеговИМетокОтсеиваетСоседей() Экспорт

	ХранилищеТегов = Поделка.НайтиЖелудь("ХранилищеТегов");
	ХранилищеМеток = Поделка.НайтиЖелудь("ХранилищеМетокТегов");

	Свежий = ДобавитьТег(ХранилищеТегов, 41, "latest");
	Стабильный = ДобавитьТег(ХранилищеТегов, 41, "lts");
	ЧужойТег = ДобавитьТег(ХранилищеТегов, 42, "latest");

	ДобавитьМеткуТега(ХранилищеМеток, Свежий.Идентификатор, 201);
	ДобавитьМеткуТега(ХранилищеМеток, Свежий.Идентификатор, 202);
	ДобавитьМеткуТега(ХранилищеМеток, Стабильный.Идентификатор, 203);

	Ожидаем.Что(ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(41).Количество(),
		"у пакета 41 два тега").Равно(2);

	Найденный = ХранилищеТегов.ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(41, "lts");
	Ожидаем.Что(Найденный, "тег lts пакета 41").Существует();
	Ожидаем.Что(Найденный.Идентификатор, "выбран тег своего пакета и своего имени").Равно(Стабильный.Идентификатор);

	СвойLatest = ХранилищеТегов.ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(41, "latest");
	Ожидаем.Что(СвойLatest.Идентификатор, "тег latest чужого пакета отсеян").Равно(Свежий.Идентификатор);
	Ожидаем.Что(СвойLatest.Идентификатор <> ЧужойТег.Идентификатор, "у пакета 42 свой тег latest").ЭтоИстина();

	Состав = ХранилищеМеток.ПолучитьПоТегИдентификаторРавно(Свежий.Идентификатор);
	Ожидаем.Что(Состав.Количество(), "в канале latest две версии").Равно(2);
	Ожидаем.Что(ХранилищеМеток.ПолучитьПоТегИдентификаторРавно(Стабильный.Идентификатор).Количество(),
		"в канале lts одна версия").Равно(1);

КонецПроцедуры

Функция ПоложитьВерсию(ХранилищеВерсий, Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Отозвана,
	Знач ВерсияДвижка, Знач ОпубликовалИдентификатор)

	ЧастиВерсии = СтрРазделить(СтрокаВерсии, ".");

	Версия = ХранилищеВерсий.СоздатьЭлемент();
	Версия.ПакетИдентификатор = ПакетИдентификатор;
	Версия.Версия = СтрокаВерсии;
	Версия.ВерсияДвижка = ВерсияДвижка;
	Версия.SemverМажор = Число(ЧастиВерсии[0]);
	Версия.SemverМинор = Число(ЧастиВерсии[1]);
	Версия.SemverПатч = Число(ЧастиВерсии[2]);
	Версия.Отозвана = Отозвана;
	Версия.ОпубликовалИдентификатор = ОпубликовалИдентификатор;
	Версия.Опубликована = ТекущаяУниверсальнаяДата();
	Версия.Сохранить();

	Возврат Версия;

КонецФункции

Функция ЕстьВВыборке(Знач Выборка, Знач Идентификатор)

	Для Каждого Строка_ Из Выборка Цикл
		Если Строка_.Идентификатор = Идентификатор Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СоздатьПакет(ХранилищеПакетов, Знач ПулИдентификатор, Знач Имя, Знач ИмяНижнийРегистр)

	Пакет = ХранилищеПакетов.СоздатьЭлемент();
	Пакет.ПулИдентификатор = ПулИдентификатор;
	Пакет.Имя = Имя;
	Пакет.ИмяНижнийРегистр = ИмяНижнийРегистр;
	Пакет.Скрыт = Ложь;
	Пакет.Устарел = Ложь;
	Пакет.Создан = ТекущаяУниверсальнаяДата();
	Пакет.Сохранить();

	Возврат Пакет;

КонецФункции

Функция ДобавитьЗависимость(ХранилищеЗависимостей, Знач ВерсияИдентификатор, Знач ИмяПакета)
	Возврат ХранилищеЗависимостей.Записать(ВерсияИдентификатор, ИмяПакета);
КонецФункции

Функция ДобавитьМеткуВерсии(ХранилищеМеток, Знач ВерсияИдентификатор, Знач Метка)

	Строка_ = ХранилищеМеток.СоздатьЭлемент();
	Строка_.ВерсияИдентификатор = ВерсияИдентификатор;
	Строка_.Метка = Метка;
	Строка_.Сохранить();

	Возврат Строка_;

КонецФункции

Функция ДобавитьПроисхождение(Хранилище, Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач Источник)

	Запись = Хранилище.СоздатьЭлемент();
	Запись.ПакетИдентификатор = ПакетИдентификатор;
	Запись.ВерсияИдентификатор = ВерсияИдентификатор;
	Запись.Источник = Источник;
	Запись.АпстримИдентификатор = 0;
	Запись.Зафиксировано = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Функция ДобавитьТег(ХранилищеТегов, Знач ПакетИдентификатор, Знач Имя)

	Тег = ХранилищеТегов.СоздатьЭлемент();
	Тег.ПакетИдентификатор = ПакетИдентификатор;
	Тег.Имя = Имя;
	Тег.Режим = "ручной";
	Тег.ПоУмолчанию = Ложь;
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.КемИдентификатор = 0;
	Тег.Сохранить();

	Возврат Тег;

КонецФункции

Функция ДобавитьМеткуТега(ХранилищеМеток, Знач ТегИдентификатор, Знач ВерсияИдентификатор)

	Метка = ХранилищеМеток.СоздатьЭлемент();
	Метка.ТегИдентификатор = ТегИдентификатор;
	Метка.ВерсияИдентификатор = ВерсияИдентификатор;
	Метка.Сохранить();

	Возврат Метка;

КонецФункции

Процедура ДобавитьВерсию(ХранилищеВерсий, Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Отозвана)
	ПоложитьВерсию(ХранилищеВерсий, ПакетИдентификатор, СтрокаВерсии, Отозвана, "", 0);
КонецПроцедуры
