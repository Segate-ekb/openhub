// Примитив основа/ОбрезаниеТекста: как длинное становится коротким. Проверяется значение —
// граница «ровно предел» (многоточия быть не должно), «предел плюс один» и число
// в свёрнутом хвосте перечня.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Обрезание;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);

КонецПроцедуры

&ПередКаждым
Процедура СобратьОбрезание() Экспорт
	Обрезание = Новый ОбрезаниеТекста();
КонецПроцедуры

&Тест
Процедура МноготочиеТолькоТамГдеЕстьЧтоОтрезать() Экспорт
	Ожидаем.Что(Обрезание.СМноготочием("abcde", 5), "ровно предел — многоточия нет")
		.Равно("abcde");
	Ожидаем.Что(Обрезание.СМноготочием("abcdef", 5), "предел плюс один — хвост свёрнут")
		.Равно("abcde…");
	Ожидаем.Что(Обрезание.СМноготочием("", 5), "пустой текст остаётся пустым").Равно("");
	Ожидаем.Что(Обрезание.СМноготочием(Неопределено, 5), "Неопределено — пустая строка")
		.Равно("");
КонецПроцедуры

&Тест
Процедура ПереченьКорочеПределаПечатаетсяЦеликом() Экспорт

	Значения = Новый Массив();
	Значения.Добавить("latest");
	Значения.Добавить("stable");

	Ожидаем.Что(Обрезание.ПереченьСОстатком(Значения, 10), "короткий перечень — весь")
		.Равно("latest, stable");
	Ожидаем.Что(Обрезание.ПереченьСОстатком(Значения, 2), "ровно предел — тоже весь")
		.Равно("latest, stable");

КонецПроцедуры

&Тест
Процедура ХвостПеречняНазванЧислом() Экспорт

	Значения = Новый Массив();
	Для Счётчик = 1 По 13 Цикл
		Значения.Добавить("тег-" + Формат(Счётчик, "ЧГ=0; ЧН=0"));
	КонецЦикла;

	Итог = Обрезание.ПереченьСОстатком(Значения, 10);

	Ожидаем.Что(СтрНачинаетсяС(Итог, "тег-1, тег-2,"), "первые названы поимённо: " + Итог)
		.ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(Итог, " и ещё 3"), "остаток назван числом: " + Итог)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итог, "тег-11"), "одиннадцатый в перечень не попал").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустойПереченьДаётПустуюСтроку() Экспорт
	Ожидаем.Что(Обрезание.ПереченьСОстатком(Новый Массив(), 10), "перечислять нечего")
		.Равно("");
КонецПроцедуры
