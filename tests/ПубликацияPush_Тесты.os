// Интеграционные и контрактные тесты публикации (push): поднимает настоящий хаб на КоннекторJSON со случайным
// портом; контрактные проверки кодов и формата ответа — всегда, цикл `opm push` → `opm install` — при наличии opm.
// Здесь же последствия публикации на живом хабе: карточка пакета, отзыв версии с экрана,
// квота пула и тёзки в двух пулах.

#Использовать asserts
#Использовать ospx-tools
#Использовать "фикстуры"

Перем Хаб;              // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;           // фикстура КлиентХаба — запросы к подопытному хабу
Перем Порт;
Перем КореньДанных;
Перем КаталогПроекта;
Перем ТаймаутСек;
Перем ВременныеКаталоги;
Перем КукаАдмина;
Перем ТокенАдмина;
Перем ТокенПубликатора; // PAT НЕ-admin publisher (тесты иммутабельности release)

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 60;
	ВременныеКаталоги = Новый Массив();
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(ТаймаутСек);
	Клиент = Новый КлиентХаба(Хаб, 30);
	КаталогПроекта = Хаб.КаталогПроекта();

	// класс-фикстура сборки .ospx (в контейнер не входит — регистрируем в процессе теста)
	РеестрФикстур.Подключить("ФикстураПакета");

	КореньДанных = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-push-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньДанных);
	ВременныеКаталоги.Добавить(КореньДанных);

	ПутьФикстуры = ОбъединитьПути(КаталогПроекта, "tests", "фикстуры", "spike0c-testpkg-0.1.0.ospx");

	Хаб.Среда("OSHUB_STORAGE_ROOT", КореньДанных);
	Хаб.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньДанных, "jsondb"));
	Хаб.Среда("OSHUB_SEED_FIXTURE", ПутьФикстуры);
	Хаб.Среда("OSHUB_SEED_POOL", "public");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "root");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "RootPassw0rd");
	// НЕ-admin publisher: запрет повторной публикации одинаков для всех ролей, и тесты
	// гоняют его на обычном издателе
	Хаб.Среда("OSHUB_SEED_PUBLISHER", "1");
	// Потолок распаковки поднят, чтобы в квоту пула (минимум — мегабайт) можно было упереться
	// несколькими публикациями: защита от zip-бомбы считает потолок против СЖАТОГО размера
	// с коэффициентом 1032, и при штатных 64 МБ артефакт крупнее 65 КБ не принимается вовсе.
	Хаб.Среда("OSHUB_PUBLISH_MAX__UNPACKED__BYTES", "536870912");

	ЗапуститьЗасев();

	Хаб.Запустить();     // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();

	// логинимся админом (создан рогаткой из OSHUB_ADMIN_*) и выпускаем PAT
	ОтветВхода = ДождатьсяВхода("root", "RootPassw0rd");
	КукаАдмина = Клиент.КукаСессии(ОтветВхода);
	ТокенАдмина = ВыпуститьТокен(КукаАдмина);

	// PAT НЕ-admin publisher (засеян ЗасеятьХаб при OSHUB_SEED_PUBLISHER=1)
	ОтветПуб = ДождатьсяВхода("publisher", "PubPassw0rd");
	ТокенПубликатора = ВыпуститьТокен(Клиент.КукаСессии(ОтветПуб));

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Для Каждого Каталог Из ВременныеКаталоги Цикл
		Попытка
			Если Новый Файл(Каталог).Существует() Тогда
				УдалитьФайлы(Каталог);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура PushGETВозвращает405() Экспорт
	Ответ = ПушЗапрос("GET", "/pools/public/push", Неопределено, "pkg-1.0.0.ospx", "stable", "");
	Ожидаем.Что(Ответ.КодСостояния, "GET на /push → 405").Равно(405);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 405), "тело в формате {КодСостояние,Сообщение}").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура PushНедопустимоеРасширение400() Экспорт
	Ответ = ПушЗапрос("POST", "/pools/public/push", ПолучитьДвоичныеДанныеИзСтроки("x"), "pkg-1.0.0.zip", "stable", "");
	Ожидаем.Что(Ответ.КодСостояния, "не .ospx → 400 (0.C проверка 1)").Равно(400);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 400)).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура PushПустоеТело400() Экспорт
	Ответ = ПушЗапрос("POST", "/pools/public/push", ПолучитьДвоичныеДанныеИзСтроки(""), "pkg-1.0.0.ospx", "stable", "");
	Ожидаем.Что(Ответ.КодСостояния, "пустое тело → 400 (0.C проверка 2)").Равно(400);
КонецПроцедуры

&Тест
Процедура PushБезТокена401() Экспорт
	Данные = ПостроитьOspxДанные("cpush-anon", "1.0.0");
	Ответ = ПушЗапрос("POST", "/pools/public/push", Данные, "cpush-anon-1.0.0.ospx", "stable", "");
	Ожидаем.Что(Ответ.КодСостояния, "аноним без токена → 401 (0.C: старый хаб требовал право отправки)").Равно(401);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 401)).ЭтоИстина();
КонецПроцедуры

// Push СВОБОДНОГО имени в пул, где прав нет, отвечает 202 в том же формате {КодСостояние, Сообщение}: opm печатает
// тело как есть и считает 202 успехом, поэтому очередь работает с немодифицированным клиентом. КОНТРОЛЬ: свой пул — 201.
&Тест
Процедура PushСвободногоИмениБезПравДаёт202() Экспорт

	// пул, где у publisher прав нет: создаём админом через API хаба
	ИмяПула = "inbox" + Формат(Секунда(ТекущаяУниверсальнаяДата()), "ЧГ=0; ЧН=0");
	// PAT, а не сессионная кука: у ключа нет ambient cookie, поэтому API хаба не требует от него CSRF
	ОтветПула = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""тип"":""custom"",""видимость"":""public""}", ИмяПула), ТокенАдмина);
	Ожидаем.Что(ОтветПула.КодСостояния = 201 ИЛИ ОтветПула.КодСостояния = 409,
		"пул для заявки создан: " + ОтветПула.ПолучитьТелоКакСтроку()).ЭтоИстина();

	Имя = "inboxpkg" + Формат(Секунда(ТекущаяУниверсальнаяДата()), "ЧГ=0; ЧН=0");
	Данные = ПостроитьOspxДанные(Имя, "1.0.0");

	Ответ = ПушЗапрос("POST", "/pools/" + ИмяПула + "/push", Данные,
		Имя + "-1.0.0.ospx", "stable", ТокенПубликатора);
	Ожидаем.Что(Ответ.КодСостояния, "свободное имя без прав → 202 (заявка во «входящие»)").Равно(202);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 202), "тело в формате {КодСостояние,Сообщение}").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ.ПолучитьТелоКакСтроку(), "входящие") > 0,
		"сообщение объясняет ситуацию").ЭтоИстина();

	СписокВерсий = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/" + ИмяПула + "/packages/" + Имя + "/versions"));
	Ожидаем.Что(СписокВерсий.Получить("versions") = Неопределено
			ИЛИ СписокВерсий.Получить("versions").Количество() = 0,
		"версия не опубликована — имя только заявлено").ЭтоИстина();

	ИмяВСвоём = "ownpkg" + Формат(Секунда(ТекущаяУниверсальнаяДата()), "ЧГ=0; ЧН=0");
	Контроль = ПушЗапрос("POST", "/pools/public/push", ПостроитьOspxДанные(ИмяВСвоём, "1.0.0"),
		ИмяВСвоём + "-1.0.0.ospx", "stable", ТокенПубликатора);
	Ожидаем.Что(Контроль.КодСостояния, "КОНТРОЛЬ: в своём пуле тот же push публикует").Равно(201);

КонецПроцедуры

// POST .../versions считал published ЛЮБОЙ 2xx и отвечал {"status":"published"} на заявку,
// попавшую в очередь: клиент читал «опубликовано» там, где версии нет вовсе.
&Тест
Процедура ВерсииAPIНеНазываютЗаявкуОпубликованной() Экспорт

	ИмяПула = "apiinbox" + Формат(Секунда(ТекущаяУниверсальнаяДата()), "ЧГ=0; ЧН=0");
	ОтветПула = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""тип"":""custom"",""видимость"":""public""}", ИмяПула), ТокенАдмина);
	Ожидаем.Что(ОтветПула.КодСостояния = 201 ИЛИ ОтветПула.КодСостояния = 409,
		"пул для заявки создан: " + ОтветПула.ПолучитьТелоКакСтроку()).ЭтоИстина();

	Имя = "apiinboxpkg" + Формат(Секунда(ТекущаяУниверсальнаяДата()), "ЧГ=0; ЧН=0");
	Адрес = "/api/v1/pools/" + ИмяПула + "/packages/" + Имя + "/versions";

	Ответ = ПушЗапрос("POST", Адрес, ПостроитьOspxДанные(Имя, "1.0.0"),
		Имя + "-1.0.0.ospx", "stable", ТокенПубликатора);
	Ожидаем.Что(Ответ.КодСостояния, "свободное имя без прав → 202").Равно(202);

	Тело_ = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(Тело_.Получить("status"), "202 — это очередь, а не публикация").Равно("queued");
	Ожидаем.Что(ЗначениеЗаполнено(Тело_.Получить("message")), "пояснение есть").ЭтоИстина();

	// КОНТРОЛЬ: в своём пуле тот же путь действительно публикует и говорит published
	ИмяСвой = "apiownpkg" + Формат(Секунда(ТекущаяУниверсальнаяДата()), "ЧГ=0; ЧН=0");
	Контроль = ПушЗапрос("POST", "/api/v1/pools/public/packages/" + ИмяСвой + "/versions",
		ПостроитьOspxДанные(ИмяСвой, "1.0.0"), ИмяСвой + "-1.0.0.ospx", "stable", ТокенПубликатора);
	Ожидаем.Что(Контроль.КодСостояния, "КОНТРОЛЬ: в своём пуле публикация проходит").Равно(201);
	Ожидаем.Что(Клиент.ТелоJSON(Контроль).Получить("status"), "КОНТРОЛЬ: и называется published").Равно("published");

КонецПроцедуры

&Тест
Процедура PushПоАлиасуПоУмолчаниюДоступен() Экспорт
	Данные = ПостроитьOspxДанные("cpush-alias", "1.0.0");
	Ответ = ПушЗапрос("POST", "/push", Данные, "cpush-alias-1.0.0.ospx", "stable", "");
	Ожидаем.Что(Ответ.КодСостояния, "/push (алиас) достижим, аноним → 401").Равно(401);
КонецПроцедуры

#Область КаноническийАдресПубликации

// Сквозной контракт «как это делает opm»: сырое тело .ospx, имя файла в FILE-NAME,
// канал в CHANNEL, токен в OAUTH-TOKEN — и опубликованное сразу качается тем же opm.
&Тест
Процедура PushНаКаноническийАдресПубликуетИАртефактСкачивается() Экспорт

	Имя = "cpush-v1";
	Ответ = ПушЗапрос("POST", "/api/v1/pools/public/push", ПостроитьOspxДанные(Имя, "1.0.0"),
		Имя + "-1.0.0.ospx", "stable", ТокенАдмина);

	Ожидаем.Что(Ответ.КодСостояния,
		"push на /api/v1/pools/public/push → 201: " + Ответ.ПолучитьТелоКакСтроку()).Равно(201);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 201), "тело в формате {КодСостояние,Сообщение}").ЭтоИстина();

	Файл_ = Клиент.GET("/api/v1/pools/public/download/" + Имя + "/" + Имя + ".ospx");
	Ожидаем.Что(Файл_.КодСостояния, "опубликованное сразу отдаётся выдачей").Равно(200);
	Ожидаем.Что(Файл_.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело .ospx не пустое").ЭтоИстина();

	Список = Клиент.GET("/api/v1/pools/public/download/list.txt");
	Ожидаем.Что(СтрНайти(Список.ПолучитьТелоКакСтроку(), Имя) > 0,
		"имя появилось в list.txt").ЭтоИстина();

КонецПроцедуры

// opm 1.4.x умеет PUT — контракт не сужается.
&Тест
Процедура PushНаКаноническийАдресПринимаетPUT() Экспорт

	Имя = "cpush-v1-put";
	Ответ = ПушЗапрос("PUT", "/api/v1/pools/public/push", ПостроитьOspxДанные(Имя, "1.0.0"),
		Имя + "-1.0.0.ospx", "stable", ТокенАдмина);

	Ожидаем.Что(Ответ.КодСостояния, "PUT на канонический адрес → 201: "
		+ Ответ.ПолучитьТелоКакСтроку()).Равно(201);

КонецПроцедуры

&Тест
Процедура PushНаКаноническийАдресТребуетТокен() Экспорт

	Ответ = ПушЗапрос("POST", "/api/v1/pools/public/push", ПостроитьOspxДанные("cpush-v1-anon", "1.0.0"),
		"cpush-v1-anon-1.0.0.ospx", "stable", "");

	Ожидаем.Что(Ответ.КодСостояния, "аноним на канонический адрес → 401").Равно(401);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 401)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура PushGETНаКаноническийАдрес405() Экспорт
	Ответ = ПушЗапрос("GET", "/api/v1/pools/public/push", Неопределено, "pkg-1.0.0.ospx", "stable", "");
	Ожидаем.Что(Ответ.КодСостояния, "GET на канонический адрес push → 405").Равно(405);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 405)).ЭтоИстина();
КонецПроцедуры

// Алиасы обязаны вести себя ровно как канонический адрес: те же коды на тех же входах.
&Тест
Процедура АлиасыПушаОтвечаютКакКаноническийАдрес() Экспорт

	Адреса = Новый Массив();
	Адреса.Добавить("/api/v1/pools/public/push");
	Адреса.Добавить("/pools/public/push");
	Адреса.Добавить("/push");

	Для Каждого Адрес Из Адреса Цикл

		Имя = УникальныеИмена.Имя("cpush-par");

		Аноним = ПушЗапрос("POST", Адрес, ПостроитьOspxДанные(Имя + "-anon", "1.0.0"),
			Имя + "-anon-1.0.0.ospx", "stable", "");
		Ожидаем.Что(Аноним.КодСостояния, "аноним → 401 на " + Адрес).Равно(401);

		Мусор = ПушЗапрос("POST", Адрес, ПолучитьДвоичныеДанныеИзСтроки("x"),
			Имя + "-1.0.0.zip", "stable", ТокенАдмина);
		Ожидаем.Что(Мусор.КодСостояния, "не .ospx → 400 на " + Адрес).Равно(400);

		Успех = ПушЗапрос("POST", Адрес, ПостроитьOspxДанные(Имя, "1.0.0"),
			Имя + "-1.0.0.ospx", "stable", ТокенАдмина);
		Ожидаем.Что(Успех.КодСостояния, "валидный push → 201 на " + Адрес + ": "
			+ Успех.ПолучитьТелоКакСтроку()).Равно(201);

		// пул по умолчанию для /push — тот же public, поэтому проверка выдачи общая
		Файл_ = Клиент.GET("/api/v1/pools/public/download/" + Имя + "/" + Имя + ".ospx");
		Ожидаем.Что(Файл_.КодСостояния, "опубликованное через " + Адрес + " скачивается").Равно(200);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

&Тест
Процедура PushВалидныйСТокеном201() Экспорт
	// HTTP-контракт успеха: PAT админа + валидный .ospx → 201, формат ответа старого хаба
	Данные = ПостроитьOspxДанные("cpush-ok", "1.0.0");
	Ответ = ПушЗапрос("POST", "/pools/public/push", Данные, "cpush-ok-1.0.0.ospx", "stable", ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "валидный push с PAT → 201: " + Ответ.ПолучитьТелоКакСтроку()).Равно(201);
	Ожидаем.Что(ЭтоФорматОтвета(Ответ, 201)).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура PushReleaseНеПерезаписатьЧерезCHANNEL() Экспорт
	// атака: опубликовать release и затереть его, подменив заголовок CHANNEL; принципал — НЕ-admin publisher
	Данные1 = ПостроитьOspxДанные("cpush-imm", "1.0.0");
	Первый = ПушЗапрос("POST", "/pools/public/push", Данные1, "cpush-imm-1.0.0.ospx", "stable", ТокенПубликатора);
	Ожидаем.Что(Первый.КодСостояния, "release 1.0.0 (stable) → 201").Равно(201);

	Данные2 = ПостроитьOspxДанные("cpush-imm", "1.0.0");
	ЧерезDev = ПушЗапрос("POST", "/pools/public/push", Данные2, "cpush-imm-1.0.0.ospx", "dev", ТокенПубликатора);
	Ожидаем.Что(ЧерезDev.КодСостояния, "перезапись release через CHANNEL=dev → 409").Равно(409);

	Данные3 = ПостроитьOspxДанные("cpush-imm", "1.0.0");
	ПустойCH = ПушЗапрос("POST", "/pools/public/push", Данные3, "cpush-imm-1.0.0.ospx", "", ТокенПубликатора);
	Ожидаем.Что(ПустойCH.КодСостояния, "перезапись release пустым CHANNEL → 409").Равно(409);
КонецПроцедуры

// Единственный обход запрета — «?force=1» в адресе push. Тест сквозной: winow обязан
// доставить именованный параметр запроса в обработчик, иначе форс молча не доедет,
// а сам обход обязан быть УЗКИМ — легаси-opm параметра не шлёт вовсе и обязан попадать
// в обычную ветку с её конфликтом.
&Тест
Процедура ФорсВАдресеЗаменяетНомерАБезНегоКонфликт() Экспорт

	Имя = "cpush-force";
	Файл_ = Имя + "-1.0.0.ospx";
	Выдача = "/api/v1/pools/public/download/" + Имя + "/" + Имя + ".ospx";

	Первый = ПушЗапрос("POST", "/api/v1/pools/public/push",
		ПостроитьOspxДанныеСТекстом(Имя, "1.0.0", "# коротко"), Файл_, "stable", ТокенПубликатора);
	Ожидаем.Что(Первый.КодСостояния, "первая публикация → 201: " + Первый.ПолучитьТелоКакСтроку()).Равно(201);
	РазмерДо = Клиент.GET(Выдача).ПолучитьТелоКакДвоичныеДанные().Размер();

	Тяжёлый = ПостроитьOspxДанныеСТекстом(Имя, "1.0.0", СлучайныйТекст(60000));

	// без параметра — конфликт, и он объясняет оба выхода
	Конфликт = ПушЗапрос("POST", "/api/v1/pools/public/push", Тяжёлый, Файл_, "stable", ТокенПубликатора);
	Ожидаем.Что(Конфликт.КодСостояния, "повтор номера без форса → 409").Равно(409);
	Сообщение = Строка(Клиент.ТелоJSON(Конфликт).Получить("Сообщение"));
	Ожидаем.Что(СтрНайти(Сообщение, "--force") > 0, "назван --force: " + Сообщение).ЭтоИстина();
	// каналов у нового пакета нет, пока их не завели, поэтому выход из запрета ровно один,
	// и отказ говорит об этом прямо, а не называет несуществующий тег
	Ожидаем.Что(СтрНайти(Сообщение, "снимать запрет не с чего") > 0,
		"и объяснено, почему выход один: " + Сообщение).ЭтоИстина();
	Ожидаем.Что(Клиент.GET(Выдача).ПолучитьТелоКакДвоичныеДанные().Размер(),
		"отклонённый push байтов не подменил").Равно(РазмерДо);

	// значение параметра судит хаб: «0» и мусор форсом не считаются
	Для Каждого Значение Из СтрРазделить("0,абракадабра", ",") Цикл
		Ожидаем.Что(ПушЗапрос("POST", "/api/v1/pools/public/push?force=" + Значение,
			Тяжёлый, Файл_, "stable", ТокенПубликатора).КодСостояния,
			СтрШаблон("?force=%1 форсом не считается", Значение)).Равно(409);
	КонецЦикла;

	Форсом = ПушЗапрос("POST", "/api/v1/pools/public/push?force=1", Тяжёлый, Файл_,
		"stable", ТокенПубликатора);
	Ожидаем.Что(Форсом.КодСостояния, "с форсом номер заменён → 200: "
		+ Форсом.ПолучитьТелоКакСтроку()).Равно(200);
	Ожидаем.Что(Клиент.GET(Выдача).ПолучитьТелоКакДвоичныеДанные().Размер() > РазмерДо,
		"и выдача отдаёт НОВЫЕ байты того же номера").ЭтоИстина();

	// вечные алиасы форс понимают так же: адреса push равноправны
	Ожидаем.Что(ПушЗапрос("POST", "/pools/public/push?force=1", ПостроитьOspxДанные(Имя, "1.0.0"),
		Файл_, "stable", ТокенПубликатора).КодСостояния,
		"алиас /pools/{пул}/push с форсом → 200").Равно(200);
	Ожидаем.Что(ПушЗапрос("POST", "/push?force=1", ПостроитьOspxДанные(Имя, "1.0.0"),
		Файл_, "stable", ТокенПубликатора).КодСостояния,
		"беспрефиксный /push с форсом → 200").Равно(200);
	Ожидаем.Что(ПушЗапрос("POST", "/push", ПостроитьOspxДанные(Имя, "1.0.0"),
		Файл_, "stable", ТокенПубликатора).КодСостояния,
		"а без параметра тот же адрес отвечает конфликтом").Равно(409);

КонецПроцедуры

// Метка версии из заголовка CHANNEL контракта opm — контракт с живым opm: тест держит обе двери разом (приём CHANNEL
// публикацией и выдачу метки в API хаба) сквозным путём — снятие любой из них ранее не красило ничего.
&Тест
Процедура PushСЗаголовкомCHANNELСтавитМеткуИОнаВиднаВAPI() Экспорт

	Имя = "cpush-label";
	Данные = ПостроитьOspxДанные(Имя, "1.0.0-dev.1");
	Ответ = ПушЗапрос("POST", "/pools/public/push", Данные, Имя + "-1.0.0-dev.1.ospx",
		"nightly", ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "push с CHANNEL=nightly → 201").Равно(201);

	// дверь 1: CHANNEL принят публикацией и записан меткой версии; дверь 2: метка отдана в API хаба полем labels
	// имя локальной переменной намеренно длинное: короткое «Версии» отбирает глобальное имя (Property is not writable)
	СписокВерсийAPI = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/" + Имя + "/versions")).Получить("versions");
	Ожидаем.Что(СписокВерсийAPI.Количество() > 0, "версия опубликована и видна в API хаба").ЭтоИстина();

	Метки = "";
	Для Каждого Версия Из СписокВерсийAPI Цикл
		Если Версия.Получить("version") = "1.0.0-dev.1" Тогда
			Ожидаем.Что(Версия.Получить("labels") <> Неопределено,
				"поле labels присутствует в ответе API хаба").ЭтоИстина();
			Метки = СтрСоединить(Версия.Получить("labels"), ",");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Метки, "метка из заголовка CHANNEL доехала до API хаба").Равно("nightly");

КонецПроцедуры

// Пустой CHANNEL метки НЕ создаёт: «канал не указан» — это отсутствие метки, а не метка с пустым именем.
&Тест
Процедура PushБезCHANNELМеткиНеСтавит() Экспорт

	Имя = "cpush-nolabel";
	Данные = ПостроитьOspxДанные(Имя, "1.0.0");
	Ответ = ПушЗапрос("POST", "/pools/public/push", Данные, Имя + "-1.0.0.ospx", "", ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "push без CHANNEL → 201").Равно(201);

	СписокВерсийAPI = Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/public/packages/" + Имя + "/versions")).Получить("versions");
	Для Каждого Версия Из СписокВерсийAPI Цикл
		Если Версия.Получить("version") = "1.0.0" Тогда
			Ожидаем.Что(Версия.Получить("labels").Количество(),
				"без CHANNEL меток нет").Равно(0);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура PushНевалидныйТокен401() Экспорт
	// невалидный токен → неудача аутентификации → 401 (0.C), не 403
	Данные = ПостроитьOspxДанные("cpush-badtok", "1.0.0");
	Ответ = ПушЗапрос("POST", "/pools/public/push", Данные, "cpush-badtok-1.0.0.ospx", "stable", "oshub_1_totallybogus");
	Ожидаем.Что(Ответ.КодСостояния, "невалидный токен → 401").Равно(401);
КонецПроцедуры

&Тест
Процедура PushМанифестПротивFileName400() Экспорт
	// наша защита: FILE-NAME не совпадает с манифестом → 400 (старый хаб доверял FILE-NAME)
	Данные = ПостроитьOspxДанные("cpush-mism", "1.0.0");
	Ответ = ПушЗапрос("POST", "/pools/public/push", Данные, "wrongname-9.9.9.ospx", "stable", ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "манифест vs FILE-NAME → 400").Равно(400);
КонецПроцедуры

&Тест
&Тег("смоук")
&ВключенЕсли("() -> ОпмДоступен()", Причина = "в окружении нет исполняемого opm")
Процедура OpmPushЗатемInstall() Экспорт

	ИмяПакета = "openhub-pushdemo";
	Версия = "1.0.0";
	КаталогПуша = ПодготовитьOpmPush();
	ПостроитьOspxФайл(КаталогПуша, ИмяПакета, Версия);
	ИмяФайла = СтрШаблон("%1-%2.ospx", ИмяПакета, Версия);

	// push валидного .ospx с PAT админа (FILE — маска относительно cwd opm, поэтому имя файла)
	Пуш = ЗапуститьOpm(СтрШаблон("push -m openhub -c stable --token %1 %2", ТокенАдмина, ИмяФайла), КаталогПуша);
	Ожидаем.Что(Пуш.КодВозврата, "opm push с валидным PAT → код 0. Вывод: " + Пуш.Вывод).Равно(0);

	// пакет виден в list.txt пула public
	Список = Клиент.GET("/pools/public/download/list.txt").ПолучитьТелоКакСтроку();
	Ожидаем.Что(СтрНайти(Список, ИмяПакета) > 0, "опубликованный пакет в list.txt: " + Список).ЭтоИстина();

	// install тем же opm скачивает пакет обратно (отдельный cfg: install берёт порт из поля Порт)
	КаталогУстановки = ПодготовитьOpmInstall();
	Установка = ЗапуститьOpm("install -l " + ИмяПакета, КаталогУстановки);
	Ожидаем.Что(Установка.КодВозврата, "opm install опубликованного пакета → код 0. Вывод: " + Установка.Вывод).Равно(0);
	Манифест = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КаталогУстановки, "oscript_modules"), ИмяПакета), "opm-metadata.xml");
	Ожидаем.Что(Новый Файл(Манифест).Существует(), "пакет установлен из хаба").ЭтоИстина();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()", Причина = "в окружении нет исполняемого opm")
Процедура OpmPushБезТокенаОтклонён() Экспорт

	КаталогПуша = ПодготовитьOpmPush();
	ПостроитьOspxФайл(КаталогПуша, "openhub-noauth", "1.0.0");

	Пуш = ЗапуститьOpm("push -m openhub -c stable openhub-noauth-1.0.0.ospx", КаталогПуша);
	Ожидаем.Что(Пуш.КодВозврата <> 0, "opm push без токена → отказ (opm exit != 0)").ЭтоИстина();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()", Причина = "в окружении нет исполняемого opm")
Процедура OpmPushReleaseДубляОтклонён() Экспорт

	КаталогПуша = ПодготовитьOpmPush();
	ПостроитьOspxФайл(КаталогПуша, "openhub-dup", "1.0.0");

	// живой opm параметра force не шлёт — и обязан получить конфликт, как любой клиент
	Первый = ЗапуститьOpm(СтрШаблон("push -m openhub -c stable --token %1 openhub-dup-1.0.0.ospx", ТокенПубликатора), КаталогПуша);
	Ожидаем.Что(Первый.КодВозврата, "первый push release → код 0. Вывод: " + Первый.Вывод).Равно(0);

	Второй = ЗапуститьOpm(СтрШаблон("push -m openhub -c stable --token %1 openhub-dup-1.0.0.ospx", ТокенПубликатора), КаталогПуша);
	Ожидаем.Что(Второй.КодВозврата <> 0, "push release-дубля → отказ opm (409)").ЭтоИстина();

КонецПроцедуры

#Область КарточкаВерсииИМесто

// Карточку пакета ведёт человек, а публикация приносит манифест, в котором этих полей
// нет вовсе. Пустое поле манифеста не имеет права затирать написанное руками, а снятый
// с витрины пакет не имеет права возвращаться на неё новой версией.
&Тест
Процедура ПубликацияНеЗатираетКарточкуКоторуюВелиРуками() Экспорт

	Имя = "cardkeep";
	Ожидаем.Что(ПушЗапрос("POST", "/api/v1/pools/public/push", ПостроитьOspxДанные(Имя, "1.0.0"),
		Имя + "-1.0.0.ospx", "stable", ТокенАдмина).КодСостояния, "пакет заведён").Равно(201);

	Раздел = "/public/" + Имя + "/settings/card";
	Поля = Новый Соответствие();
	Поля.Вставить("описание", "Описание, которое дописал мейнтейнер");
	Поля.Вставить("лицензия", "MIT");
	Поля.Вставить("ключевые_слова", "каталог,пример");
	Поля.Вставить("репозиторий", "https://example.org/cardkeep");
	Поля.Вставить("скрыт", "1");
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, КукаАдмина))));

	Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, КукаАдмина).КодСостояния < 400,
		"карточка сохранена с экрана").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/public/" + Имя)), "дописал мейнтейнер") > 0,
		"и написанное видно на странице пакета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/packages?q=" + Имя)), "/public/" + Имя),
		"снятый с витрины пакет в каталоге не показывается").Равно(0);

	Ожидаем.Что(ПушЗапрос("POST", "/api/v1/pools/public/push", ПостроитьOspxДанные(Имя, "1.1.0"),
		Имя + "-1.1.0.ospx", "stable", ТокенАдмина).КодСостояния,
		"опубликована новая версия — манифест без описания, лицензии и ключевых слов").Равно(201);

	Страница = Клиент.Тело(Клиент.GET("/public/" + Имя));
	Ожидаем.Что(СтрНайти(Страница, "дописал мейнтейнер") > 0,
		"описание пережило публикацию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "MIT") > 0, "и лицензия").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/packages?q=" + Имя)), "/public/" + Имя),
		"и пометка «скрыт»: новая версия не вернула пакет на витрину").Равно(0);

	// КОНТРОЛЬ: публикация действительно произошла — иначе карточку «сберегло» бы то,
	// что публиковать было нечего. Спрашиваем дом пакета: снятый с витрины пакет
	// в публичных ответах не показывается вовсе, а мейнтейнеру виден.
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GETСКукой("/public/" + Имя + "/settings/versions", КукаАдмина)),
		"1.1.0") > 0, "КОНТРОЛЬ: новая версия в реестре").ЭтоИстина();

КонецПроцедуры

// Отзыв с экрана мейнтейнера действует на выдачу: безверсионное скачивание уезжает
// на предыдущую версию, а точная координата отозванной по-прежнему отдаётся — чужая
// сборка, прибитая к ней, продолжает собираться. Возврат тем же путём всё возвращает.
&Тест
Процедура ОтзывСЭкранаУводитВерсиюИзВыдачиАВозвратВозвращает() Экспорт

	Имя = "yankscreen";
	Ожидаем.Что(ПушЗапрос("POST", "/api/v1/pools/public/push", ПостроитьOspxДанные(Имя, "1.0.0"),
		Имя + "-1.0.0.ospx", "stable", ТокенАдмина).КодСостояния, "первая версия").Равно(201);
	Ожидаем.Что(ПушЗапрос("POST", "/api/v1/pools/public/push", ПостроитьOspxДанные(Имя, "1.1.0"),
		Имя + "-1.1.0.ospx", "stable", ТокенАдмина).КодСостояния, "вторая версия").Равно(201);

	БезВерсии = "/api/v1/pools/public/download/" + Имя + "/" + Имя + ".ospx";
	Ожидаем.Что(ОтданнаяВерсия(БезВерсии),
		"КОНТРОЛЬ: до отзыва выдача отдаёт старшую").Равно(Имя + "-1.1.0.ospx");

	Ожидаем.Что(ОперацияНадВерсией(Имя, "1.1.0", "yank").КодСостояния < 400,
		"версия отозвана с экрана").ЭтоИстина();

	Ожидаем.Что(ОтданнаяВерсия(БезВерсии),
		"выдача уехала на предыдущую версию").Равно(Имя + "-1.0.0.ospx");
	Ожидаем.Что(Клиент.GET("/api/v1/pools/public/download/" + Имя + "/" + Имя + "-1.1.0.ospx").КодСостояния,
		"а по точной координате отозванная по-прежнему скачивается").Равно(200);

	Ожидаем.Что(ОперацияНадВерсией(Имя, "1.1.0", "unyank").КодСостояния < 400,
		"отзыв снят тем же путём").ЭтоИстина();
	Ожидаем.Что(ОтданнаяВерсия(БезВерсии), "и версия вернулась в выбор").Равно(Имя + "-1.1.0.ospx");

КонецПроцедуры

// Квота — предел пула, а не запроса: пул растёт публикациями, пока не упрётся, и тогда
// отказ приходит ДО записи артефакта, называет числа и говорит, чем вернуть место.
// Повтор того же push бесполезен — это и проверяется вторым разом.
&Тест
Процедура ПубликацияСверхКвотыПулаОтвергаетсяИНичегоЗаСобойНеОставляет() Экспорт

	ИмяПула = "tightpool";
	ОтветПула = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""тип"":""custom"",""видимость"":""public"",""квота_мб"":1}", ИмяПула),
		ТокенАдмина);
	Ожидаем.Что(ОтветПула.КодСостояния, "пул с квотой в мегабайт создан: "
		+ ОтветПула.ПолучитьТелоКакСтроку()).Равно(201);

	Отказ = Неопределено;
	ПоследнееИмя = "";
	Для Номер = 1 По 8 Цикл

		ПоследнееИмя = "quotapkg" + Формат(Номер, "ЧГ=0; ЧН=0");
		Данные = ПостроитьOspxДанныеСТекстом(ПоследнееИмя, "1.0.0", СлучайныйТекст(500000));
		Ответ = ПушЗапрос("POST", "/api/v1/pools/" + ИмяПула + "/push", Данные,
			ПоследнееИмя + "-1.0.0.ospx", "stable", ТокенАдмина);

		Если Ответ.КодСостояния = 507 Тогда
			Отказ = Ответ;
			Прервать;
		КонецЕсли;
		Ожидаем.Что(Ответ.КодСостояния, "пока место есть, публикация проходит: "
			+ Ответ.ПолучитьТелоКакСтроку()).Равно(201);

	КонецЦикла;

	Ожидаем.Что(Отказ <> Неопределено, "пул упёрся в свою квоту").ЭтоИстина();
	Ожидаем.Что(Номер > 1,
		"до отказа хоть одна публикация прошла: пул упёрся в НАКОПЛЕННОЕ, а не в размер"
		+ " одного запроса").ЭтоИстина();
	Ожидаем.Что(ЭтоФорматОтвета(Отказ, 507), "тело в формате {КодСостояние,Сообщение}").ЭтоИстина();

	Сообщение = Отказ.ПолучитьТелоКакСтроку();
	Ожидаем.Что(СтрНайти(Сообщение, "1048576") > 0,
		"названы числа — предел пула в байтах: " + Сообщение).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "занято") > 0, "и занятое").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "удалив ненужные пакеты") > 0,
		"назван способ вернуть место").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "лишние версии"),
		"удаления версии у хаба нет — советовать его нельзя").Равно(0);

	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/api/v1/pools/" + ИмяПула + "/packages/"
		+ ПоследнееИмя + "/versions")), "1.0.0"), "версия не опубликована").Равно(0);
	Ожидаем.Что(Клиент.GET("/api/v1/pools/" + ИмяПула + "/download/" + ПоследнееИмя + "/"
		+ ПоследнееИмя + ".ospx").КодСостояния, "и артефакта за отказом не осталось").Равно(404);

	Повтор = ПушЗапрос("POST", "/api/v1/pools/" + ИмяПула + "/push",
		ПостроитьOspxДанныеСТекстом(ПоследнееИмя, "1.0.0", СлучайныйТекст(500000)),
		ПоследнееИмя + "-1.0.0.ospx", "stable", ТокенАдмина);
	Ожидаем.Что(Повтор.КодСостояния,
		"повторить тот же push без освобождения места бесполезно").Равно(507);

КонецПроцедуры

// Одно имя в двух пулах — два разных пакета со своими версиями и своей выдачей.
// Внутри пула имя одно независимо от регистра: вторая публикация попадает в тот же
// пакет, а не заводит второй.
&Тест
Процедура ОдноИмяВДвухПулахЭтоДваРазныхПакета() Экспорт

	ВторойПул = "twinpool";
	ОтветПула = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""тип"":""custom"",""видимость"":""public""}", ВторойПул), ТокенАдмина);
	Ожидаем.Что(ОтветПула.КодСостояния = 201 ИЛИ ОтветПула.КодСостояния = 409,
		"второй пул есть: " + ОтветПула.ПолучитьТелоКакСтроку()).ЭтоИстина();

	Имя = "twinlib";
	Ожидаем.Что(ОпубликоватьВПул("public", Имя, "1.0.0").КодСостояния, "тёзка в первом пуле").Равно(201);
	Ожидаем.Что(ОпубликоватьВПул(ВторойПул, Имя, "2.0.0").КодСостояния, "тёзка во втором").Равно(201);

	Первый = Клиент.Тело(Клиент.GET("/api/v1/pools/public/packages/" + Имя + "/versions"));
	Второй = Клиент.Тело(Клиент.GET("/api/v1/pools/" + ВторойПул + "/packages/" + Имя + "/versions"));
	Ожидаем.Что(СтрНайти(Первый, "1.0.0") > 0, "у первого своя версия").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Первый, "2.0.0"), "и чужой у него нет").Равно(0);
	Ожидаем.Что(СтрНайти(Второй, "2.0.0") > 0, "у второго своя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Второй, "1.0.0"), "и чужой нет").Равно(0);

	Ожидаем.Что(ОтданнаяВерсия("/api/v1/pools/public/download/" + Имя + "/" + Имя + ".ospx"),
		"выдача первого пула отдаёт его версию").Равно(Имя + "-1.0.0.ospx");
	Ожидаем.Что(ОтданнаяВерсия("/api/v1/pools/" + ВторойПул + "/download/" + Имя + "/" + Имя + ".ospx"),
		"выдача второго — свою").Равно(Имя + "-2.0.0.ospx");

	// регистр внутри пула не различает: TwinLib попадает в тот же пакет
	Ожидаем.Что(ОпубликоватьВПул("public", "TwinLib", "1.1.0").КодСостояния,
		"публикация тем же именем в другом регистре").Равно(201);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET("/api/v1/pools/public/packages/" + Имя + "/versions")),
		"1.1.0") > 0, "версия легла в тот же пакет").ЭтоИстина();
	Ожидаем.Что(СколькоПакетовСИменем("public", Имя), "и второго пакета в пуле не завелось").Равно(1);

КонецПроцедуры

#КонецОбласти

// Каталог для `opm push`: порт стоит ПРЯМО в поле Сервер — opm push поле Порт игнорирует.
Функция ПодготовитьOpmPush()
	Конфиг = СтрШаблон(
	"{
	|    ""СервераПакетов"": [
	|        {
	|            ""Имя"": ""openhub"",
	|            ""Сервер"": ""http://localhost:%1"",
	|            ""РесурсПубликацииПакетов"": ""/api/v1/pools/public/push"",
	|            ""Приоритет"": 0
	|        }
	|    ]
	|}", Формат(Порт, "ЧГ=0; ЧН=0"));
	Возврат СоздатьOpmКаталог(Конфиг);
КонецФункции

// Каталог для `opm install`: порт — ОТДЕЛЬНОЕ поле Порт (install использует Сервер+Порт), Сервер без порта.
Функция ПодготовитьOpmInstall()
	Конфиг = СтрШаблон(
	"{
	|    ""СервераПакетов"": [
	|        {
	|            ""Имя"": ""openhub"",
	|            ""Сервер"": ""http://localhost"",
	|            ""Порт"": %1,
	|            ""ПутьНаСервере"": ""/api/v1/pools/public/download/"",
	|            ""Приоритет"": 0
	|        }
	|    ]
	|}", Формат(Порт, "ЧГ=0; ЧН=0"));
	Возврат СоздатьOpmКаталог(Конфиг);
КонецФункции

Функция СоздатьOpmКаталог(Знач Конфиг)
	РабочийКаталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-opmpush-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(РабочийКаталог);
	ВременныеКаталоги.Добавить(РабочийКаталог);
	Запись = Новый ЗаписьТекста(ОбъединитьПути(РабочийКаталог, "opm.cfg"), КодировкаТекста.UTF8);
	Запись.Записать(Конфиг);
	Запись.Закрыть();
	Возврат РабочийКаталог;
КонецФункции

Функция ПостроитьOspxФайл(Знач Каталог, Знач ИмяПакета, Знач Версия)
	Возврат Новый ФикстураПакета().ПостроитьOspx(Каталог, ИмяПакета, Версия, "# " + ИмяПакета);
КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия)
	Возврат ПостроитьOspxДанныеСТекстом(ИмяПакета, Версия, "# " + ИмяПакета);
КонецФункции

Функция ПостроитьOspxДанныеСТекстом(Знач ИмяПакета, Знач Версия, Знач ТекстReadme)
	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Путь = Новый ФикстураПакета().ПостроитьOspx(Каталог, ИмяПакета, Версия, ТекстReadme);
	Возврат Новый ДвоичныеДанные(Путь);
КонецФункции

// Текст, который не схлопнется при упаковке: случайные шестнадцатеричные строки.
// Осмысленный текст сжался бы в килобайты, и «тяжёлый» артефакт весил бы пустяк.
Функция СлучайныйТекст(Знач ПримерноСимволов)
	Части = Новый Массив();
	Пока Части.Количество() * 37 < ПримерноСимволов Цикл
		Части.Добавить(Строка(Новый УникальныйИдентификатор()));
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");
КонецФункции

Функция ОпубликоватьВПул(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Возврат ПушЗапрос("POST", "/api/v1/pools/" + ИмяПула + "/push",
		ПостроитьOspxДанные(ИмяПакета, Версия),
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", ТокенАдмина);
КонецФункции

// Сколько пакетов пула носят это имя без учёта регистра: два — значит уникальность
// имени в пуле сломана.
Функция СколькоПакетовСИменем(Знач ИмяПула, Знач ИмяПакета)
	Найдено = 0;
	Для Каждого Пакет Из Клиент.ТелоJSON(Клиент.GET("/api/v1/pools/" + ИмяПула + "/packages?pageSize=100"))
		.Получить("items") Цикл
		Если НРег(Строка(Пакет.Получить("name"))) = НРег(ИмяПакета) Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;
КонецФункции

// Имя файла, которое хаб называет в Content-Disposition, — то самое, что получит клиент.
Функция ОтданнаяВерсия(Знач Путь)
	Ответ = Клиент.GET(Путь);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат "код " + Формат(Ответ.КодСостояния, "ЧГ=0; ЧН=0");
	КонецЕсли;
	Расположение = Клиент.ЗаголовокОтвета(Ответ, "Content-Disposition");
	Маркер = "filename=";
	Поз = СтрНайти(Расположение, Маркер);
	Если Поз = 0 Тогда
		Возврат Расположение;
	КонецЕсли;
	Возврат СтрЗаменить(СокрЛП(Сред(Расположение, Поз + СтрДлина(Маркер))), """", "");
КонецФункции

// Отзыв и возврат версии так, как их делает мейнтейнер: формой раздела «Версии» дома пакета.
Функция ОперацияНадВерсией(Знач ИмяПакета, Знач Версия, Знач Операция)
	Раздел = "/public/" + ИмяПакета + "/settings/versions";
	Поля = Новый Соответствие();
	Поля.Вставить("версия", Версия);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("_csrf", ИзвлечьCSRF(Клиент.Тело(Клиент.GETСКукой(Раздел, КукаАдмина))));
	Возврат Клиент.POSTФормы(Раздел, Поля, КукаАдмина);
КонецФункции

Функция ИзвлечьCSRF(Знач ТелоСтраницы)
	Маркер = "name=""_csrf"" value=""";
	Поз = СтрНайти(ТелоСтраницы, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(ТелоСтраницы, Поз + СтрДлина(Маркер));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);
КонецФункции

Функция ЗапуститьOpm(Знач Аргументы, Знач РабочийКаталог)
	Процесс_ = СоздатьПроцесс("opm " + Аргументы, РабочийКаталог, Истина);
	Процесс_.Запустить();
	ДождатьсяПроцесса(Процесс_, "opm " + Аргументы);
	Вывод = "";
	Попытка
		Вывод = СтрЗаменить(Строка(Процесс_.ПотокВывода.ПрочитатьВсе()), Символы.ПС, " | ");
	Исключение
	КонецПопытки;
	Возврат Новый Структура("КодВозврата, Вывод", Процесс_.КодВозврата, Вывод);
КонецФункции

// Проверяет наличие рабочего opm в системе (запускает `opm version`).
//
// Возвращаемое значение:
//  Булево - Истина, если opm запустился с нулевым кодом возврата.
//
Функция ОпмДоступен() Экспорт
	Попытка
		Проба = СоздатьПроцесс("opm version", , Истина);
		Проба.Запустить();
		ДождатьсяПроцесса(Проба, "opm version");
		Возврат Проба.КодВозврата = 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ДождатьсяПроцесса(Знач Процесс_, Знач Пояснение)
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Если Процесс_.Завершен Тогда
			Возврат;
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Процесс ""%1"" не завершился за %2 сек", Пояснение, ТаймаутСек);
КонецПроцедуры

Процедура ЗапуститьЗасев()
	ПутьЗасевщика = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьПакет.os");
	Процесс_ = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ПутьЗасевщика), КаталогПроекта, Истина);
	Процесс_.Запустить();
	ДождатьсяПроцесса(Процесс_, "засев");
	Если Процесс_.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Засев завершился с ошибкой (код %1)", Процесс_.КодВозврата);
	КонецЕсли;
КонецПроцедуры

// Ожидание готовности хаба живёт в фикстуре ЭкземплярХаба (общая для всех HTTP-наборов).

Функция ДождатьсяВхода(Знач Логин, Знач Пароль)
	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30 * 1000;
	Ответ = Неопределено;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Ответ = Клиент.POSTJSON("/api/v1/login", Тело_, "");
		Если Ответ.КодСостояния = 200 Тогда
			Возврат Ответ;
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;
	// журнал хаба обязателен: рогатка безголового админа в журнал не пишет, и отказ был бы немым
	ВызватьИсключение "Админ не смог войти за отведённое время (онбординг из env не завершился)."
		+ Символы.ПС + Хаб.Дамп();
КонецФункции

Функция ВыпуститьТокен(Знач Кука)
	Ответ = Клиент.POSTJSON("/api/v1/tokens", "{""права"":""read,write""}", Кука);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "Не удалось выпустить PAT: код " + Ответ.КодСостояния;
	КонецЕсли;
	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token");
КонецФункции

// Отправляет push-запрос (POST/PUT/GET) с сырым телом и заголовками FILE-NAME/CHANNEL/OAUTH-TOKEN.
Функция ПушЗапрос(Знач Метод, Знач Путь, Знач Данные, Знач ИмяФайла, Знач Канал, Знач Токен)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("CHANNEL", Канал);
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("OAUTH-TOKEN", Токен);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если Данные <> Неопределено Тогда
		Запрос.УстановитьТелоИзДвоичныхДанных(Данные);
	КонецЕсли;

	Соед = Клиент.Соединение();
	Если ВРег(Метод) = "GET" Тогда
		Возврат Соед.Получить(Запрос);
	ИначеЕсли ВРег(Метод) = "PUT" Тогда
		Возврат Соед.Записать(Запрос);
	КонецЕсли;
	Возврат Соед.ОтправитьДляОбработки(Запрос);
КонецФункции

// Проверяет, что тело ответа — JSON старого формата {"КодСостояние":код,"Сообщение":...}.
Функция ЭтоФорматОтвета(Знач Ответ, Знач ОжидаемыйКод)
	Тело = Клиент.ТелоJSON(Ответ);
	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Число(Тело.Получить("КодСостояние")) = ОжидаемыйКод И ЗначениеЗаполнено(Тело.Получить("Сообщение"));
КонецФункции
