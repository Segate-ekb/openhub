		"предпосылка теста: ключа в словаре действительно нет").Равно(Неопределено);

	Текст = UI.Тексты.Текст(Ключ);

	Ожидаем.Что(ЗначениеЗаполнено(Текст), "текст отсутствующего ключа НЕ пустой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, Ключ) > 0,
