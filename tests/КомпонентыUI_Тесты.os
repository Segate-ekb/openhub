#КонецОбласти

#Область Сетка

&Тест
Процедура СеткаРаскладываетЯчейкиИЗнаетТолькоРазрешённыеКолонки() Экспорт

	Ячейки = Новый Массив();
	Ячейки.Добавить("<div>раз</div>");
	Ячейки.Добавить(Новый Структура("HTML", "<div>два</div>"));
	Ячейки.Добавить("");          // пустые ячейки не создают дыр в раскладке
	Ячейки.Добавить(Неопределено);

	HTML = UI.Сетка.Отрисовать(Новый Структура("Ячейки, Заголовок", Ячейки, "Сводка хаба"));

	Ожидаем.Что(СтрНайти(HTML, "class=""grid grid--auto""") > 0, "раскладка по умолчанию — авто").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Сводка хаба""") > 0, "подпись области").ЭтоИстина();
	Ожидаем.Что(ЧислоВхождений(HTML, "class=""grid__cell"""), "пустые ячейки пропущены").Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "<div>раз</div>") > 0, "доверенный HTML ячейки вставлен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div>два</div>") > 0, "ячейка структурой тоже").ЭтоИстина();

	Ожидаем.Что(СтрНайти(UI.Сетка.Отрисовать(Новый Структура("Ячейки, Колонки", Ячейки, 2)),
		"grid--2") > 0, "две колонки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(UI.Сетка.Отрисовать(Новый Структура("Ячейки, Плотная", Ячейки, Истина)),
		"grid--tight") > 0, "плотный вариант").ЭтоИстина();

	Чужие = UI.Сетка.Отрисовать(Новый Структура("Ячейки, Колонки", Ячейки, "99"" onload=""alert(1)"));
	Ожидаем.Что(СтрНайти(Чужие, "class=""grid grid--auto""") > 0, "чужое число сведено к «авто»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужие, """ onload="), "разметка не разорвана").Равно(0);
	Ожидаем.Что(UI.Сетка.НормализованныеКолонки(3)).Равно("3");
	Ожидаем.Что(UI.Сетка.НормализованныеКолонки(7)).Равно("auto");
	// один столбец: перечень (способы входа) читается стопкой, а не панелью действий
	Ожидаем.Что(UI.Сетка.НормализованныеКолонки(1)).Равно("1");
	Ожидаем.Что(СтрНайти(UI.Сетка.Отрисовать(Новый Структура("Ячейки, Колонки", Ячейки, 1)),
		"grid--1") > 0, "одна колонка").ЭтоИстина();

	Ожидаем.Что(UI.Сетка.Отрисовать(Новый Структура("Ячейки", Новый Массив())),
		"сетка без ячеек — пустая строка").Равно("");

КонецПроцедуры

