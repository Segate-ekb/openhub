КонецПроцедуры

&Тест
Процедура ПлашкаЭкранируетИФильтруетСхемуАдреса() Экспорт

	HTML = UI.Плашка.Отрисовать(Новый Структура("Текст, Адрес",
		"<b>тег</b>", "javascript:alert(1)"));

	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасная схема отброшена").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<b>тег</b>"), "сырой тег вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;b&gt;") > 0, "текст сохранён экранированным").ЭтоИстина();

КонецПроцедуры

// Стиль плашки — КЛАСС, а не хранимый цвет: цвет даёт переменная темы, поэтому одна и та
// же строка БД читается в обеих темах. Инлайновых стилей у плашки нет вовсе.
&Тест
Процедура ПлашкаКраситсяКлассомАНеИнлайновымСтилем() Экспорт

	Виды = Новый Соответствие();
	Виды.Вставить("ok", "tag--ok");
	Виды.Вставить("warn", "tag--warn");
	Виды.Вставить("err", "tag--err");
	Виды.Вставить("accent", "tag--accent");

	Для Каждого КиЗ Из Виды Цикл
		HTML = UI.Плашка.Отрисовать(Новый Структура("Текст, Вид", "stable", КиЗ.Ключ));
		Ожидаем.Что(СтрНайти(HTML, КиЗ.Значение) > 0,
			"вид «" + КиЗ.Ключ + "» печатается классом " + КиЗ.Значение).ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "style="),
			"инлайнового стиля у плашки нет: цвет живёт в теме").Равно(0);
	КонецЦикла;

	Обычная = UI.Плашка.Отрисовать(Новый Структура("Текст", "lts"));
	Ожидаем.Что(СтрНайти(Обычная, "tag--"), "у обычной плашки модификатора нет").Равно(0);
	Ожидаем.Что(СтрНайти(Обычная, "style="), "и инлайнового стиля тоже").Равно(0);

	// значок наследует цвет стиля через currentColor — своего цвета у него нет
	СоЗначком = UI.Плашка.Отрисовать(Новый Структура("Текст, Вид, Иконка", "lts", "ok", "замок"));
	Ожидаем.Что(СтрНайти(СоЗначком, "fill=""currentColor""") > 0,
		"значок берёт цвет у плашки, а плашка — у темы").ЭтоИстина();

КонецПроцедуры

// Несколько плашек подряд — ОДИН элемент разметки. Соседними детьми контейнера они
// получали бы его вертикальный ритм (.card__body > * + *), а инлайновому элементу такой
// маргин уходит в высоту строчного бокса: карточка пула с двумя плашками была на 11 px
// выше соседей по ряду, а её пилюли стояли ниже их пилюль.
&Тест
Процедура РядПлашекПечатаетсяОднимЭлементомСГоризонтальнымЗазором() Экспорт

	Модели = Новый Массив();
	Модели.Добавить(Новый Структура("Текст, Вид", "Основной", "accent"));
	Модели.Добавить(Новый Структура("Текст, Вид", "Публичный", "ok"));

	HTML = UI.Плашка.Ряд(Модели);

	Ожидаем.Что(СтрНайти(HTML, "<div class=""tag-row"">") > 0, "ряд — свой элемент").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<div class=""tag-row"">"),
		"ряд ОДИН, а не по элементу на плашку").Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<span class=""tag"), "обе плашки внутри").Равно(2);

	Правило = ОбъявленияПравилаCSS(ТекстCSS(), ".tag-row");
	Ожидаем.Что(Правило.Количество(), "на «.tag-row» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Правило[0], "display: flex") > 0,
		"ряд раскладывается в строку: " + Правило[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Правило[0], "flex-wrap: wrap") > 0, "и переносится целиком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Правило[0], "gap: var(--space-1)") > 0,
		"зазор тот же, что у .objcard__chips и .objhead__chips").ЭтоИстина();

КонецПроцедуры

// «Признака нет — места в ряду нет»: Неопределено внутри списка ряд пропускает так же,
// как одиночная плашка, а пустой ряд не печатает пустой коробки.
&Тест
Процедура РядПлашекПропускаетНеопределеноИНеРисуетПустойРяд() Экспорт

	Модели = Новый Массив();
	Модели.Добавить(Неопределено);
	Модели.Добавить(Новый Структура("Текст", "Публичный"));

	HTML = UI.Плашка.Ряд(Модели);

	Ожидаем.Что(СтрЧислоВхождений(HTML, "<span class=""tag"),
		"напечатана одна плашка из двух").Равно(1);

	Пустые = Новый Массив();
	Пустые.Добавить(Неопределено);
	Ожидаем.Что(UI.Плашка.Ряд(Пустые), "ряд из одних Неопределено — пусто").Равно("");
	Ожидаем.Что(UI.Плашка.Ряд(Новый Массив()), "пустой список — пусто").Равно("");
	Ожидаем.Что(UI.Плашка.Ряд(Неопределено), "не массив — пусто").Равно("");

КонецПроцедуры

#КонецОбласти

