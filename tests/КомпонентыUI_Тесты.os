	Ожидаем.Что(СтрНайти(Основная, "<button type=""submit""") > 0, "по умолчанию — отправка формы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Основная, "class=""button button--primary""") > 0, "вид по умолчанию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Основная, "<svg") > 0, "иконка").ЭтоИстина();

	Ожидаем.Что(СтрНайти(UI.Кнопка.Отрисовать(Новый Структура("Подпись, Вариант", "x", "вторичная")),
		"button--ghost") > 0, "вторичная").ЭтоИстина();
	Ожидаем.Что(СтрНайти(UI.Кнопка.Отрисовать(Новый Структура("Подпись, Вариант", "x", "опасная")),
		"button--danger") > 0, "опасная").ЭтоИстина();
	Ожидаем.Что(СтрНайти(UI.Кнопка.Отрисовать(Новый Структура("Подпись, Вариант", "x", "ссылка")),
		"button--link") > 0, "ссылка-кнопкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(UI.Кнопка.Отрисовать(Новый Структура("Подпись, Размер", "x", "малый")),
		"button--sm") > 0, "малый размер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(UI.Кнопка.Отрисовать(Новый Структура("Подпись, Размер", "x", "большой")),
		"button--lg") > 0, "большой размер").ЭтоИстина();

