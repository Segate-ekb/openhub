	Ожидаем.Что(СтрНайти(HTML, "method=""post"" action=""/main/settings/visibility""") > 0,
		"обычная POST-форма на свой URL").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""_csrf"" value=""деадбиф""") > 0, "скрытое CSRF-поле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-savebar") > 0, "панель сохранения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "type=""submit""") > 0, "страница работает без JS").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекцияСДействиемБезТокенаПадаетНаРендере() Экспорт

	Секция = UI.РендерерНастроек.Секция("Видимость", "", "<p>поля</p>");
	Секция.Действие = "/main/settings/visibility";

	Секции = Новый Массив();
	Секции.Добавить(Секция);
	Модель = Новый Структура("Ключ, Заголовок, Секции", "pool", "Настройки пула", Секции);

	Поймано = Ложь;
	Попытка
		UI.РендерерНастроек.Отрисовать(Модель);
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "CSRF") > 0, "ошибка называет причину").ЭтоИстина();
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Видимость") > 0, "и указывает секцию").ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Поймано, "секция с POST без токена не рендерится").ЭтоИстина();

	Секция.Токен = "деадбиф";
	Ожидаем.Что(СтрНайти(UI.РендерерНастроек.Отрисовать(Модель), "value=""деадбиф""") > 0,
		"с токеном рендер проходит").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СекцияБезДействияНеПечатаетФормуИТокен() Экспорт

	Секция = UI.РендерерНастроек.Секция("Мои права", "Только чтение", "<p>таблица</p>");
	Секции = Новый Массив();
	Секции.Добавить(Секция);

	HTML = UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"account", "Настройки аккаунта", Секции));

	Ожидаем.Что(СтрНайти(HTML, "<form"), "у витрины нет формы").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "_csrf"), "и нет CSRF-поля").Равно(0);

КонецПроцедуры

&Тест
Процедура КаркасЭкранируетПользовательскиеЗначения() Экспорт

	Секции = Новый Массив();
	Секции.Добавить(UI.РендерерНастроек.Секция("<img src=x onerror=alert(1)>", "<b>лид</b>", "<p>доверенное</p>"));

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", "<script>alert(2)</script>", "javascript:alert(3)"));

	HTML = UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Объект, Секции, Хлебные",
		"pool", "Настройки пула", "<script>alert(4)</script>", Секции, Хлебные));

	Ожидаем.Что(СтрНайти(НРег(БезТегаScript(HTML)), "<script"), "скриптов в разметке нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "тег из заголовка не прошёл").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;img") > 0, "он выведен как экранированный текст").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "href=""javascript"), "опасная схема в хлебных крошках отфильтрована").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<p>доверенное</p>") > 0, "доверенное тело секции сохранено").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустойДомПоказываетЧестноеСообщение() Экспорт

	HTML = UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок", "hub", "Настройки хаба"));

	Ожидаем.Что(СтрНайти(HTML, "нечего настраивать") > 0, "пустой раздел объясняет себя").ЭтоИстина();

КонецПроцедуры

// Кат уносит секцию ЦЕЛИКОМ, вместе с её формой: половина формы под закрытой <details>
// ломает валидацию браузера (required в скрытом поле — «not focusable», форма не уходит
// вовсе). Отсюда порядок вложенности: <form> внутри <details>, а не наоборот — обратный
// даёт вложенные формы, и браузер отбрасывает внутреннюю молча.
&Тест
Процедура СвёрнутаяСекцияПрячетПодКатФормуЦеликом() Экспорт

	HTML = ДомСоСвёрнутойСекцией(Ложь);

	Ожидаем.Что(СтрНайти(HTML, "<details class=""section__fold"">") > 0,
		"секция ушла под кат и по умолчанию закрыта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<summary class=""fold__head"">Выдать доступ</summary>") > 0,
		"подпись раскрытия — единственное, что видно закрытым").ЭтоИстина();

	Кат = СтрНайти(HTML, "<details class=""section__fold""");
	КонецКата = СтрНайти(HTML, "</details>");
	Форма = СтрНайти(HTML, "<form");
	КонецФормы = СтрНайти(HTML, "</form>");

	Ожидаем.Что(Кат > 0 И Форма > Кат, "форма открывается ВНУТРИ ката, а не над ним: " + HTML)
		.ЭтоИстина();
	Ожидаем.Что(КонецФормы > 0 И КонецКата > КонецФормы,
		"и закрывается тоже внутри — кат не разрывает форму: " + HTML).ЭтоИстина();

	Ожидаем.Что(ЧислоВхождений(HTML, "<form"), "форма ровно одна, вложенных нет").Равно(1);
	Ожидаем.Что(ЧислоВхождений(HTML, "</form>"), "и закрыта она один раз").Равно(1);
	Ожидаем.Что(СтрНайти(HTML, "name=""_csrf""") > 0, "свой CSRF-токен уехал под кат вместе с формой")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "section__fold"" open"), "нераскрытая секция пометки не несёт").Равно(0);

КонецПроцедуры

// Контроллер, отбивший форму, возвращает её раскрытой: отказ под закрытым катом человек
// не видит и жмёт снова.
&Тест
Процедура РаскрытаяСекцияПечатаетПометкуOpen() Экспорт

	HTML = ДомСоСвёрнутойСекцией(Истина);

	Ожидаем.Что(СтрНайти(HTML, "<details class=""section__fold"" open>") > 0,
		"кат отбитой формы приезжает открытым: " + HTML).ЭтоИстина();

КонецПроцедуры

// Подпись ката — единственное, что видно у закрытой секции, и приходит она из дома
// настроек: имя пула, тег, чужой ввод. Экранируется она ровно так же, как заголовок.
&Тест
Процедура ПодписьРаскрытияЭкранируется() Экспорт

	HTML = ДомСоСвёрнутойСекцией(Ложь, "<img src=x onerror=alert(1)>");

	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "тег из подписи ката в разметку не прошёл").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;img src=x onerror=alert(1)&gt;") > 0,
		"подпись выведена экранированным текстом: " + HTML).ЭтоИстина();

	Кавычки = ДомСоСвёрнутойСекцией(Ложь, """><script>alert(2)</script>");

	Ожидаем.Что(СтрНайти(НРег(БезТегаScript(Кавычки)), "<script"),
		"кавычка подписи из разметки не вырывается").Равно(0);
	Ожидаем.Что(СтрНайти(Кавычки, "<summary class=""fold__head"">&quot;&gt;") > 0,
		"подпись осталась содержимым summary: " + Кавычки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СвёрнутаяСекцияБезПодписиИлиДействияПадаетНаРендере() Экспорт

	Секция = UI.РендерерНастроек.Секция("Доступ", "", "<p>поля</p>");
	Секция.Свёрнута = Истина;

	Секции = Новый Массив();
	Секции.Добавить(Секция);
	Модель = Новый Структура("Ключ, Заголовок, Секции", "pool", "Настройки пула", Секции);

	// без действия: под катом оказалась бы витрина состояния, а её прятать не от кого
	БезДействия = ОтказРендера(Модель);
	Ожидаем.Что(СтрНайти(БезДействия, "Действия") > 0 И СтрНайти(БезДействия, "Доступ") > 0,
		"секция состояния под кат не уходит, отказ называет поле и секцию: " + БезДействия)
		.ЭтоИстина();

	Секция.Действие = "/main/settings/access";
	Секция.Токен = "деадбиф";

	БезПодписи = ОтказРендера(Модель);
	Ожидаем.Что(СтрНайти(БезПодписи, "ПодписьРаскрытия") > 0 И СтрНайти(БезПодписи, "Доступ") > 0,
		"закрытый блок без подписи пользователю не виден вовсе: " + БезПодписи).ЭтоИстина();

	Секция.ПодписьРаскрытия = "Выдать доступ";
	Ожидаем.Что(СтрНайти(UI.РендерерНастроек.Отрисовать(Модель), "section__fold") > 0,
		"с действием и подписью рендер проходит").ЭтоИстина();

КонецПроцедуры

// Текст отказа рендера; пустая строка означает, что рендер прошёл.
Функция ОтказРендера(Знач Модель)

	Попытка
		UI.РендерерНастроек.Отрисовать(Модель);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Возврат "";

КонецФункции

Функция ДомСоСвёрнутойСекцией(Знач Раскрыта, Знач Подпись = "Выдать доступ")

	Секция = UI.РендерерНастроек.Секция("Доступ", "Кому открыт объект", "<p>поля</p>");
	Секция.Действие = "/main/settings/access";
	Секция.Токен = "деадбиф";
	Секция.Свёрнута = Истина;
	Секция.ПодписьРаскрытия = Подпись;
	Секция.Раскрыта = Раскрыта;

	Секции = Новый Массив();
	Секции.Добавить(Секция);

	Возврат UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"pool", "Настройки пула", Секции));

КонецФункции

#КонецОбласти

#Область ТокеныТемы

// Прогрессивное улучшение ломается МОЛЧА: разметку правит один экран, а читает её скрипт,
// и ни один серверный тест этого не заметит. Сторож держит ровно ту связку, которую уже
// один раз порвал переход от радиокнопок к спискам: носитель значения обязан различать
// <select> и брать вариант, а не сам список.
&Тест
Процедура СкриптЖивогоПревьюЧитаетВыбранныйВариантСписка() Экспорт

	Текст = ТекстJS();

	Возчик = ТелоФункцииJS(Текст, "выбранное");
	Ожидаем.Что(ЗначениеЗаполнено(Возчик), "в скрипте есть носитель выбранного значения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Возчик, "SELECT") > 0,
		"носитель различает выпадающий список: " + Возчик).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Возчик, "selectedIndex") > 0 ИЛИ СтрНайти(Возчик, "selectedOptions") > 0,
		"и берёт ВЫБРАННЫЙ вариант, а не сам список: " + Возчик).ЭтоИстина();

	// вид плашки скрипт читает атрибутом варианта — второй копии соответствия
	// «ключ стиля → класс» в нём нет
	Ожидаем.Что(СтрНайти(Текст, "data-chip-view") > 0,
		"вид плашки приходит атрибутом варианта").ЭтоИстина();

	// переключение наборов полей тоже умеет список, а не только ссылку
	Ожидаем.Что(СтрНайти(Текст, "data-sets") > 0, "переключатель наборов на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текст, "'change'") > 0,
		"наборы переключаются и по смене значения списка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТокеныПечатаютОбеТемыИВсеГруппыПеременных() Экспорт

	CSS = UI.Токены.Переменные();

	Ожидаем.Что(СтрНайти(CSS, ":root{") > 0, "тёмная тема в :root").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "html[data-theme=""light""]{") > 0, "светлая тема отдельным селектором").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--color-bg:") > 0, "цвета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--font-body:") > 0, "шрифты").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--space-1:") > 0, "шаг сетки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--radius-md:") > 0, "радиусы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(CSS, "--shadow-sm:") > 0, "тени").ЭтоИстина();
