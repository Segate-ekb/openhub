КонецПроцедуры

#КонецОбласти

#Область ЗначкиВерсии

// ИСТ-ПУБЛ-020: значок называет МЕХАНИЗМ приёма, а не выдаёт версии оценку. Слова оценки
// ищутся по КОРНЮ: «безопасн», «надёжн», «проверен» одинаково запрещены в любой форме.
&Тест
Процедура ЗначокДоверенногоКонвейераНазываетМеханизмАНеОценку() Экспорт

	HTML = UI.ЗначкиВерсии.Отрисовать(Новый Структура("ДоверенныйКонвейер", Истина));

	Ожидаем.Что(СтрНайти(НРег(HTML), "доверенн") > 0,
		"значок называет доверенную публикацию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "конвейер") > 0,
		"и называет конвейер — механизм, а не свойство артефакта").ЭтоИстина();

	Для Каждого Оценка Из СтрРазделить("безопасн,надёжн,надежн,проверен,гарантир,подлинн", ",") Цикл
		Ожидаем.Что(СтрНайти(НРег(HTML), Оценка),
			СтрШаблон("значок не выдаёт оценку «%1»", Оценка)).Равно(0);
	КонецЦикла;

	// вид значка нейтрален: ok/warn/err — это светофор, а доверенная публикация опция
	Ожидаем.Что(СтрНайти(HTML, "tag--"), "вид значка нейтральный").Равно(0);

КонецПроцедуры

// Версия без доверенной публикации значка НЕ получает — и никакого «противоположного»
// значка тоже: обычная публикация не помечается ни плохой, ни непроверенной.
&Тест
Процедура ОбычнаяВерсияНеПолучаетНиЗначкаНиКлейма() Экспорт

	Ожидаем.Что(UI.ЗначкиВерсии.Отрисовать(Новый Структура("ДоверенныйКонвейер", Ложь)),
		"у обычной версии значка нет").Равно("");
	Ожидаем.Что(UI.ЗначкиВерсии.Отрисовать(Новый Структура()),
		"и у версии, про которую ничего не сказано").Равно("");
	Ожидаем.Что(UI.ЗначкиВерсии.МодельДоверенногоКонвейера(Ложь),
		"модели значка тоже нет").ЭтоНеопределено();

КонецПроцедуры

// Порядок значков «откуда — как принята — в каком состоянии»: признаки независимы,
// и ни один не вытесняет соседа.
&Тест
Процедура ЗначкиВерсииНезависимыИСохраняютПорядок() Экспорт

	HTML = UI.ЗначкиВерсии.Отрисовать(Новый Структура("САпстрима, ДоверенныйКонвейер, Отозвана",
		Истина, Истина, Истина));

	Апстрим = СтрНайти(НРег(HTML), "апстрим");
	Доверие = СтрНайти(НРег(HTML), "конвейер");
	Отзыв = СтрНайти(НРег(HTML), "отозвана");

	Ожидаем.Что(Апстрим > 0 И Доверие > 0 И Отзыв > 0, "все три признака напечатаны").ЭтоИстина();
	Ожидаем.Что(Апстрим < Доверие, "происхождение печатается раньше способа приёма").ЭтоИстина();
	Ожидаем.Что(Доверие < Отзыв, "способ приёма раньше состояния").ЭтоИстина();

КонецПроцедуры

// Значок доезжает до шапки объекта: она печатает признаки объекта рядом плашек, и
// дописанный значок обязан оказаться среди них, не затерев уже имевшиеся.
&Тест
Процедура ЗначокДоверияДописываетсяКПлашкамШапки() Экспорт

	Плашки = Новый Массив();
	Плашки.Добавить(Новый Структура("Текст", "приватный"));
	Модель = Новый Структура("Имя, Плашки", "winow", Плашки);

	UI.ЗначкиВерсии.ДополнитьПлашки(Модель, Истина);
	HTML = UI.ШапкаОбъекта.Отрисовать(Модель);

	Ожидаем.Что(СтрНайти(HTML, "приватный") > 0, "прежние плашки шапки на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "конвейер") > 0, "значок доверия в шапке").ЭтоИстина();

	// у обычной версии шапка остаётся прежней
	Обычная = Новый Структура("Имя, Плашки", "winow", Плашки);
	UI.ЗначкиВерсии.ДополнитьПлашки(Обычная, Ложь);
	Ожидаем.Что(СтрНайти(НРег(UI.ШапкаОбъекта.Отрисовать(Обычная)), "конвейер"),
		"у обычной версии шапка значка не получает").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПлашкаТега

&Тест
Процедура РядКаналовСтавитОсновнойПервымИПрячетХвост() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(Тег("lts"));
	Теги.Добавить(Тег("qa"));
	Теги.Добавить(Тег("demo"));
	Теги.Добавить(Тег("rc"));
	Теги.Добавить(ОсновнойТег("stable"));

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "stable") > 0, "основной тег виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "stable") < СтрНайти(HTML, "lts"),
		"основной тег идёт ПЕРВЫМ, а не в порядке прихода").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "ещё 1") > 0, "счётчик скрытых").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<details class=""tag-row__more"">") > 0,
		"раскрытие — <details>, то есть работает без JS").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "rc") > СтрНайти(HTML, "tag-row__rest"),
		"скрытый тег лежит внутри раскрываемой части").ЭтоИстина();

КонецПроцедуры

// Ряд каналов не считает вид сам: он собирает те же плашки, что и экран настроек, —
// иначе один и тот же тег выглядит на разных страницах по-разному.
&Тест
Процедура РядКаналовНесётОформлениеКаждогоТега() Экспорт

	Устаревший = Тег("nightly");
	Устаревший.Стиль = "deprecated";
	Устаревший.Значок = "stop";

	Особый = Тег("enterprise");
	Особый.Стиль = "special";
	Особый.Значок = "key";

	Теги = Новый Массив();
	Теги.Добавить(Устаревший);
	Теги.Добавить(Особый);

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();

	Ожидаем.Что(ПлашкаРяда(HTML, "nightly"), "устаревший канал — красная плашка")
		.Равно(UI.ПлашкаТега.ПоТегу(Устаревший).Рендер());
	Ожидаем.Что(ПлашкаРяда(HTML, "enterprise"), "особый канал — сиреневая плашка")
		.Равно(UI.ПлашкаТега.ПоТегу(Особый).Рендер());

	Ожидаем.Что(СтрНайти(ПлашкаРяда(HTML, "nightly"), "class=""tag tag--err""") > 0,
		"вид взят из стиля тега, а не из места печати").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПлашкаРяда(HTML, "nightly"), "<svg") > 0,
		"значок тега в ряду напечатан").ЭтоИстина();

КонецПроцедуры

// Пометка основного канала — не часть плашки: она стоит рядом с ней и ровно у того тега,
// которым отвечает установка без версии.
&Тест
Процедура ПометкаОсновногоСтоитУОсновногоТегаИТолькоУНего() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(Тег("prerelease"));
	Теги.Добавить(ОсновнойТег("stable"));

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, ПодписьОсновногоКанала()),
		"пометка на ряду ровно одна").Равно(1);
	Ожидаем.Что(СтрНайти(HTML, ">stable</span> <span class=""muted""><svg") > 0,
		"и стоит она за основным тегом: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пометка основного канала рисуется ЗНАЧКОМ: слова растягивали и строку таблицы тегов,
// и ряд каналов у версии. Немым значок не стал — подпись даёт ему имя, и по этому имени
// пометку читает скринридер, а браузер печатает подсказку. Значок без подписи — пометка,
// которую видит только зрячий.
&Тест
Процедура ПометкаОсновногоКаналаЗвучитСловамиПриЗначке() Экспорт

	HTML = UI.ПлашкаТега.Канал(ОсновнойТег("stable")).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "(по умолчанию)"),
		"словами пометка на экране не печатается").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<svg") > 0, "пометка нарисована значком: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "role=""img""") > 0,
		"значок объявлен рисунком, а не украшением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<title>" + ПодписьОсновногоКанала() + "</title>") > 0,
		"и назван словами: " + HTML).ЭтоИстина();

	// у неосновного канала пометки нет вовсе — ни значка, ни подписи
	Обычный = UI.ПлашкаТега.Канал(Тег("prerelease")).Рендер();
	Ожидаем.Что(СтрНайти(Обычный, ПодписьОсновногоКанала()),
		"неосновной канал пометки не получает").Равно(0);

КонецПроцедуры

// Таблица тегов ставит пометку своим столбцом, список версий — рядом с плашкой. Пометка
// при этом ОДНА: её вид считается в одном месте, иначе один и тот же канал выглядел бы
// на двух экранах по-разному.
&Тест
Процедура ПометкаОсновногоОтдельноВыглядитТакЖеКакИРядомСПлашкой() Экспорт

	Основной = ОсновнойТег("stable");
	Отдельная = UI.ПлашкаТега.ПометкаОсновного(Основной).Рендер();

	Ожидаем.Что(Отдельная, "пометка сама по себе не пуста").Заполнено();
	Ожидаем.Что(СтрНайти(UI.ПлашкаТега.Канал(Основной).Рендер(), Отдельная) > 0,
		"и ровно она же стоит рядом с плашкой: " + Отдельная).ЭтоИстина();

	Ожидаем.Что(UI.ПлашкаТега.ПометкаОсновного(Тег("prerelease")).Рендер(),
		"неосновной канал пометки не получает и отдельно").Равно("");

КонецПроцедуры

// Что пометка основного канала говорит человеку и скринридеру.
Функция ПодписьОсновногоКанала()
	Возврат "Канал по умолчанию";
КонецФункции

&Тест
Процедура РядКаналовЭкранируетИмяИТребуетЕго() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(Тег("<img src=x onerror=alert(1)>"));

	HTML = UI.ПлашкаТега.Ряд(Теги).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<img"), "имя тега экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;img") > 0, "и осталось видимым текстом").ЭтоИстина();

	Пустые = Новый Массив();
	Пустые.Добавить(Тег(""));

	Упало = Ложь;
	Попытка
		UI.ПлашкаТега.Ряд(Пустые);
	Исключение
		Упало = Истина;
	КонецПопытки;
	Ожидаем.Что(Упало, "безымянный тег — исключение, а не пустая плашка").ЭтоИстина();

	Ожидаем.Что(UI.ПлашкаТега.Ряд(Новый Массив()).Рендер(), "пустой набор — пусто").Равно("");

КонецПроцедуры

// Подсказка приходит из вызывающего экрана: команду установки знает страница пакета,
// а не плашка.
&Тест
Процедура ПодсказкаКаналаДоезжаетДоКаждойПлашкиРяда() Экспорт

	Теги = Новый Массив();
	Теги.Добавить(ОсновнойТег("stable"));
	Теги.Добавить(Тег("lts"));

	Подсказки = Новый Соответствие();
	Подсказки.Вставить("stable", "Канал обновления: opm install pkg@stable");
	Подсказки.Вставить("lts", "Канал обновления: opm install pkg@lts");

	HTML = UI.ПлашкаТега.Ряд(Теги, Новый Структура("Подсказки", Подсказки)).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "title=""Канал обновления: opm install pkg@stable""") > 0,
		"подсказка основного канала").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""Канал обновления: opm install pkg@lts""") > 0,
		"подсказка небазового канала — такая же, а не пустая").ЭтоИстина();

КонецПроцедуры

Функция Тег(Знач Имя)
	Возврат Новый Структура("Имя, Стиль, Значок, ПоУмолчанию", Имя, "", "", Ложь);
КонецФункции

Функция ОсновнойТег(Знач Имя)
	Возврат Новый Структура("Имя, Стиль, Значок, ПоУмолчанию", Имя, "", "", Истина);
КонецФункции

// Плашка ряда по подписи: <span class="tag…">…имя</span>. Действия внутри плашки в ряду
// нет, поэтому первый же </span> закрывает именно её.
Функция ПлашкаРяда(Знач Разметка, Знач Имя)

	Хвост = Разметка;
	Начало = СтрНайти(Хвост, "<span class=""tag");

	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало);
		Конец = СтрНайти(Хвост, "</span>");
		Фрагмент = ?(Конец = 0, Хвост, Лев(Хвост, Конец + 6));
		Если СтрЗаканчиваетсяНа(Фрагмент, ">" + Имя + "</span>") Тогда
			Возврат Фрагмент;
		КонецЕсли;
		Хвост = Сред(Хвост, 2);
		Начало = СтрНайти(Хвост, "<span class=""tag");
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область КнопкаИконка

&Тест
Процедура КнопкаТолькоИконкаОстаётсяИменованной() Экспорт

	HTML = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Иконка, ТолькоИконка",
		"Переключить тему", "луна", Истина));

	Ожидаем.Что(СтрНайти(HTML, "button--icon") > 0, "модификатор варианта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Переключить тему""") > 0,
		"подпись читает скринридер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Переключить тему</span>"),
		"видимого текста нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<svg") > 0, "иконка на месте").ЭтоИстина();

	Ссылкой = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Иконка, ТолькоИконка, Адрес",
		"Настройки пакета", "шестерёнка", Истина, "/public/alice-pkg/settings"));
	Ожидаем.Что(СтрНайти(Ссылкой, "<a href=""/public/alice-pkg/settings""") > 0,
		"ссылка ведёт по адресу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ссылкой, "aria-label=""Настройки пакета""") > 0,
		"ссылка-иконка названа для скринридера").ЭтоИстина();

	Заблокированная = UI.Кнопка.Отрисовать(Новый Структура(
		"Подпись, Иконка, ТолькоИконка, Адрес, Заблокирована",
		"Настройки пакета", "шестерёнка", Истина, "/public/alice-pkg/settings", Истина));
	Ожидаем.Что(СтрНайти(Заблокированная, "aria-label=""Настройки пакета""") > 0,
		"заблокированная иконка тоже названа").ЭтоИстина();

	Опасная = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Иконка, ТолькоИконка, Адрес",
		"Настройки", "шестерёнка", Истина, "javascript:alert(1)"));
	Ожидаем.Что(СтрНайти(Опасная, "javascript:"), "опасная схема отброшена").Равно(0);
	Ожидаем.Что(СтрНайти(Опасная, "aria-label=""Настройки""") > 0,
		"и без ссылки имя сохраняется").ЭтоИстина();

	Обычная = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Иконка", "Переключить тему", "луна"));
	Ожидаем.Что(СтрНайти(Обычная, "<span>Переключить тему</span>") > 0,
		"без флага подпись видима").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Обычная, "button--icon"), "и модификатора нет").Равно(0);

	Упало = Ложь;
	Попытка
		UI.Кнопка.Отрисовать(Новый Структура("Иконка, ТолькоИконка", "луна", Истина));
	Исключение
		Упало = Истина;
	КонецПопытки;
	Ожидаем.Что(Упало, "кнопка-иконка без подписи — исключение").ЭтоИстина();

КонецПроцедуры

// Кнопка входа несёт значок провайдера картинкой: адрес приходит из закрытого списка
// статики, ключ вне списка адреса не даёт — и тогда <img> не печатается вовсе.
&Тест
Процедура КнопкаПечатаетКартинкуТолькоПоАдресуИзБелогоСпискаЗначков() Экспорт

	Адрес = UI.Адреса.АдресЗначка("github");
	Ожидаем.Что(ЗначениеЗаполнено(Адрес), "КОНТРОЛЬ: у ключа набора есть адрес").ЭтоИстина();

	СКартинкой = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Адрес, Иконка, Картинка",
		"Войти через GitHub", "/login/oidc/github", "ссылка", Адрес));

	Ожидаем.Что(СтрНайти(СКартинкой, "<img class=""button__pic""") > 0,
		"картинка напечатана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СКартинкой, "src=""" + Адрес + """") > 0,
		"по версионированному адресу статики").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СКартинкой, "alt=""""") > 0, "картинка декоративна: подпись рядом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СКартинкой, "<svg"), "иконка набора картинкой вытеснена").Равно(0);
	Ожидаем.Что(СтрНайти(СКартинкой, "<span>Войти через GitHub</span>") > 0,
		"подпись осталась видимой").ЭтоИстина();

	// ключ вне закрытого списка адреса не даёт — кнопка остаётся с дежурной иконкой
	Чужая = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Иконка, Картинка",
		"Войти через своего", "ссылка", UI.Адреса.АдресЗначка("../../openhub.css")));
	Ожидаем.Что(СтрНайти(Чужая, "<img"), "неизвестный ключ картинки не печатает").Равно(0);
	Ожидаем.Что(СтрНайти(Чужая, "<svg") > 0, "и остаётся дежурная иконка набора").ЭтоИстина();

	// адрес чужой схемой не печатается даже если дошёл до компонента
	Опасная = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Картинка",
		"Войти", "javascript:alert(1)"));
	Ожидаем.Что(СтрНайти(Опасная, "<img"), "небезопасная схема картинки отброшена").Равно(0);
	Ожидаем.Что(СтрНайти(Опасная, "javascript:"), "и в разметку не попала").Равно(0);

	БезКартинки = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Иконка", "Войти", "ссылка"));
	Ожидаем.Что(СтрНайти(БезКартинки, "<img"), "без картинки <img> не печатается").Равно(0);

КонецПроцедуры

