		"а доступное имя по-прежнему называет всё").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗапретХардкодаЦветов

&Тест
Процедура ВКомпонентахНетХардкодаЦвета() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыСлояПредставления() Цикл
		Если ИмяФайлаБезПути(Файл.Ключ) = "ТокеныТемы.os" Тогда
			Продолжить;
		КонецЕсли;
		Если СодержитЦвет(Исходники.Текст(Файл.Значение)) Тогда
			Нарушители.Добавить(Файл.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "), "файлы с хардкодом цвета").Равно("");

КонецПроцедуры

