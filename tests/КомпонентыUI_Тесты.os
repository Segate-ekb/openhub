&Тест
Процедура СтраницаСсылаетсяНаСтатикуСКонтентХешем() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));

	ХешСтилей = Лев(UI.Активы.Отпечаток(UI.Поставка.ФайлСтилей()), UI.Отпечатки.ДлинаПрефиксаХеша());
	ХешСкрипта = Лев(UI.Активы.Отпечаток(UI.Поставка.ФайлСкрипта()), UI.Отпечатки.ДлинаПрефиксаХеша());

	Ожидаем.Что(СтрНайти(HTML, СтрШаблон("<link rel=""stylesheet"" href=""%1"">", UI.Адреса.АдресСтилей())) > 0,
		"CSS с контент-хешем подключён").ЭтоИстина();
	Ожидаем.Что(СтрДлина(ХешСтилей), "отпечаток стилей посчитан").Равно(UI.Отпечатки.ДлинаПрефиксаХеша());
	Ожидаем.Что(СтрНайти(HTML, "openhub-" + ХешСтилей + ".css") > 0, "хеш содержимого в имени файла").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "openhub-" + ХешСкрипта + ".js") > 0, "хеш содержимого в имени скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<style") > 0, "в <style> остались только токены темы").ЭтоИстина();

КонецПроцедуры

// Оформление приезжает ДВУМЯ листами, и порядок между ними — это порядок каскада.
// Встань лист хаба первым, его правила перестали бы перебивать китовые, и брендирование
// молча вернулось бы к виду библиотеки.
&Тест
Процедура ЛистХабаПриезжаетПослеБазовогоЛистаКита() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Голова = Лев(HTML, СтрНайти(HTML, "</head>"));

	Базовый = СтрНайти(Голова, СтрШаблон("<link rel=""stylesheet"" href=""%1"">",
		UI.Активы.АдресБазовогоЛиста()));
	Свой = СтрНайти(Голова, СтрШаблон("<link rel=""stylesheet"" href=""%1"">",
		UI.Адреса.АдресСтилей()));

	Ожидаем.Что(Базовый > 0, "базовый лист библиотеки подключён: " + Голова).ЭтоИстина();
	Ожидаем.Что(Свой > 0, "лист хаба подключён: " + Голова).ЭтоИстина();
	Ожидаем.Что(Базовый < Свой, "лист хаба идёт ВТОРЫМ: " + Голова).ЭтоИстина();
	Ожидаем.Что(UI.Активы.АдресБазовогоЛиста() = UI.Адреса.АдресСтилей(),
		"адреса у листов разные").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура АдресСтатикиМеняетсяВместеССодержимым() Экспорт

	ХешА = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
	ХешБ = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210";

	ИмяА = UI.Отпечатки.ИмяСОтпечатком("openhub.css", ХешА);
	ИмяБ = UI.Отпечатки.ИмяСОтпечатком("openhub.css", ХешБ);

	Ожидаем.Что(ИмяА, "хеш подставлен перед расширением").Равно("openhub-0123456789abcdef.css");
	Ожидаем.Что(ИмяА = ИмяБ, "другое содержимое — другой адрес").ЭтоЛожь();

	Ожидаем.Что(UI.Отпечатки.ИмяСОтпечатком("openhub.css", ВРег(ХешА)), "хеш в адресе всегда в нижнем регистре")
		.Равно(ИмяА);

	Ожидаем.Что(UI.Отпечатки.ИмяСОтпечатком("README", ХешА)).Равно("README-0123456789abcdef");
	Ожидаем.Что(UI.Отпечатки.ИмяСОтпечатком("openhub.css", ""), "нет отпечатка — имя как есть")
		.Равно("openhub.css");

КонецПроцедуры

&Тест
Процедура БелыйСписокСтатикиНеПодпускаетКДискуЧужиеИмена() Экспорт

	Чужие = Новый Массив();
	Чужие.Добавить("../../etc/passwd");
	Чужие.Добавить("..%2F..%2Fetc%2Fpasswd");
	Чужие.Добавить("../статика/openhub.css");
	Чужие.Добавить("openhub.css");                          // верное имя БЕЗ хеша
	Чужие.Добавить("openhub-0000000000000000.css");          // верное имя с ЧУЖИМ хешем
	Чужие.Добавить(ВРег(UI.Активы.ПубличноеИмя(UI.Поставка.ФайлСтилей()))); // верный адрес, чужой регистр
	Чужие.Добавить("packagedef");
	Чужие.Добавить("");

	Для Каждого Имя Из Чужие Цикл
		Ожидаем.Что(UI.Активы.ТипКонтента(Имя) = Неопределено,
			"тип контента не выдан для «" + Имя + "»").ЭтоИстина();
		Ожидаем.Что(UI.Активы.ПутьНаДиске(Имя) = Неопределено,
			"путь на диске не выдан для «" + Имя + "»").ЭтоИстина();
		Ожидаем.Что(UI.Активы.ETag(Имя), "ETag не выдан для «" + Имя + "»").Равно("");
	КонецЦикла;

	Верное = UI.Активы.ПубличноеИмя(UI.Поставка.ФайлСтилей());
	Ожидаем.Что(UI.Активы.ТипКонтента(Верное), "верный адрес отдаётся").Равно("text/css; charset=utf-8");
	Ожидаем.Что(UI.Активы.ПутьНаДиске(Верное), "путь ведёт на файл стилей поставки")
		.Равно(ОбъединитьПути(UI.Поставка.Каталог(), UI.Поставка.ФайлСтилей()));
	Ожидаем.Что(Новый Файл(UI.Активы.ПутьНаДиске(Верное)).Существует(),
		"и такой файл есть").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИконкаСайтаОбъявленаИОтдаётся() Экспорт

	Каталог = ОбъединитьПути(КаталогПроекта, "src", UI.Поставка.ИмяКаталога());
	Иконка = Новый Файл(ОбъединитьПути(Каталог,
		UI.Активы.ОтносительныйПуть(UI.Поставка.ФайлИконки())));
	Ожидаем.Что(Иконка.Существует(), "файл иконки есть на диске").ЭтоИстина();

	Адрес = UI.Адреса.АдресИконки();
	Имя = UI.Активы.ПубличноеИмя(UI.Поставка.ФайлИконки());
	Ожидаем.Что(UI.Активы.ТипКонтента(Имя), "иконка в белом списке отдачи").Равно(UI.Поставка.ТипИконки());
	Ожидаем.Что(СтрНайти(Адрес, Лев(Sha256Файла(Иконка.ПолноеИмя), UI.Отпечатки.ДлинаПрефиксаХеша())) > 0,
		"адрес иконки несёт хеш её содержимого: " + Адрес).ЭтоИстина();

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Голова = Лев(HTML, СтрНайти(HTML, "</head>"));
	Ожидаем.Что(СтрНайти(Голова, СтрШаблон("<link rel=""icon"" type=""%1"" href=""%2"">",
		UI.Поставка.ТипИконки(), Адрес)) > 0, "иконка подключена в <head>").ЭтоИстина();

КонецПроцедуры

// Запасной .ico и иконка домашнего экрана бесполезны, если объявлены адресом, которого
// хаб не отдаёт: браузер молча остаётся без значка. Адреса берутся ИЗ РАЗМЕТКИ, тип —
// из белого списка, а содержимое сверяется с фирменным китом: сверка адреса с методом
// активов была бы тавтологией — разметка из этого метода и собрана.
&Тест
Процедура ЗапаснаяИконкаИИконкаЭкранаОбъявленыИОтдаются() Экспорт

	Голова = ГоловаСтраницы();

	Запасная = АдресИзГоловы(Голова, "<link rel=""icon"" sizes=""any"" href=""");
	Экранная = АдресИзГоловы(Голова, "<link rel=""apple-touch-icon"" href=""");

	Ожидаем.Что(UI.Активы.ТипКонтента(ИмяИзАдресаСтатики(Запасная)),
		"запасная иконка в белом списке отдачи").Равно(UI.Поставка.ТипЗапаснойИконки());
	Ожидаем.Что(UI.Активы.ТипКонтента(ИмяИзАдресаСтатики(Экранная)),
		"иконка домашнего экрана в белом списке отдачи").Равно(UI.Поставка.ТипИконкиДомашнегоЭкрана());

	Ожидаем.Что(UI.Поставка.ТипЗапаснойИконки(), "тип .ico").Равно("image/vnd.microsoft.icon");
	Ожидаем.Что(UI.Поставка.ТипИконкиДомашнегоЭкрана(), "тип иконки экрана").Равно("image/png");


	Ожидаем.Что(Запасная = UI.Адреса.АдресИконки(),
		"запасная иконка не подменена основной: .ico и .svg — разные файлы").ЭтоЛожь();

КонецПроцедуры

// Знак бренда рисуется картинкой из статики, а не встроенным глифом кита. Сверять адрес
// из разметки с Активы.АдресЗнака() бессмысленно — разметка из него и собрана; поэтому
// сторож смотрит на то, что доедет до браузера: тип содержимого, белый список отдачи
// и неподмену знака иконкой сайта — это разные файлы.
&Тест
Процедура ЗнакБрендаРисуетсяВШапкеИОтдаётся() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Шапка = МеждуМаркерами(HTML, "<header", "</header>");

	Адрес = АдресИзГоловы(Шапка, "<img class=""brand__mark"" src=""");

	Ожидаем.Что(UI.Активы.ТипКонтента(ИмяИзАдресаСтатики(Адрес)), "знак в белом списке отдачи")
		.Равно(UI.Поставка.ТипИконки());

	Ожидаем.Что(Адрес = UI.Адреса.АдресИконки(),
		"знак шапки и иконка вкладки — разные файлы: знак рисуется крупно, иконка"
			+ " упрощена под 16 px").ЭтоЛожь();

	// текст названия остаётся текстом рядом с картинкой — картинка декоративна
	Ожидаем.Что(СтрНайти(Шапка, СтрШаблон("<span>%1</span>", UI.Бренд.Знак())) > 0,
		"название хаба рядом со знаком осталось текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "alt=""""") > 0, "у декоративной картинки пустой alt").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтраницаПечатаетТокеныТемыИнлайномВHead() Экспорт

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("светлая")));

	Голова = Лев(HTML, СтрНайти(HTML, "</head>"));

	Ожидаем.Что(СтрНайти(Голова, "<style id=""токены-темы"">") > 0, "блок токенов в <head>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "--color-bg:") > 0, "переменные цвета инлайном").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ТегHTML("light")) > 0, "тема из куки попала в <html>").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТемуИзКукДостаётСамРендерер() Экспорт

	Тёмная = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("тёмная")));
	Светлая = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("светлая")));
	БезКук = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));

	Ожидаем.Что(СтрНайти(Тёмная, ТегHTML("dark")) > 0, "куки с тёмной темой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Светлая, ТегHTML("light")) > 0, "куки со светлой темой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезКук, ТегHTML("dark")) > 0, "без кук — оформление инсталляции").ЭтоИстина();

	Мусор = Новый КукиЗаглушка();
	Мусор.Добавить(UI.Оформление.ИмяCookie(), "%%%&тема=&&акцент=</style>");
	Испорченная = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Мусор));

	Ожидаем.Что(СтрНайти(Испорченная, ТегHTML("dark")) > 0, "мусорная кука — тема по умолчанию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Испорченная, "--color-accent:<"), "из куки не вырвался тег").Равно(0);

КонецПроцедуры

&Тест
Процедура ОбъявленнаяСтатикаСуществуетНаДиске() Экспорт

	Каталог = ОбъединитьПути(КаталогПроекта, "src", UI.Поставка.ИмяКаталога());

	Стили = Новый Файл(ОбъединитьПути(Каталог, UI.Поставка.ФайлСтилей()));
	Скрипт = Новый Файл(ОбъединитьПути(Каталог, UI.Поставка.ФайлСкрипта()));

	Ожидаем.Что(Стили.Существует(), "объявленный CSS есть на диске").ЭтоИстина();
	Ожидаем.Что(Скрипт.Существует(), "объявленный JS есть на диске").ЭтоИстина();

	Ожидаем.Что(Скрипт.Размер() < 20480, "скрипт укладывается в бюджет 20 КБ").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтпечатокСтатикиСчитаетсяИзСодержимогоФайла() Экспорт

	Каталог = ОбъединитьПути(КаталогПроекта, "src", UI.Поставка.ИмяКаталога());

	СтилиНаДиске = Sha256Файла(ОбъединитьПути(Каталог, UI.Поставка.ФайлСтилей()));
	СкриптНаДиске = Sha256Файла(ОбъединитьПути(Каталог, UI.Поставка.ФайлСкрипта()));

	Ожидаем.Что(UI.Активы.Отпечаток(UI.Поставка.ФайлСтилей()), "отпечаток стилей — SHA-256 файла стилей")
		.Равно(СтилиНаДиске);
	Ожидаем.Что(UI.Активы.Отпечаток(UI.Поставка.ФайлСкрипта()), "отпечаток скрипта — SHA-256 файла скрипта")
		.Равно(СкриптНаДиске);
	Ожидаем.Что(СтилиНаДиске = СкриптНаДиске, "два файла — два разных отпечатка").ЭтоЛожь();

	Ожидаем.Что(UI.Активы.Отпечаток("такого-файла-нет.css"), "нет файла — нет отпечатка").Равно("");
	Ожидаем.Что(UI.Активы.ПубличноеИмя("такого-файла-нет.css")).Равно("такого-файла-нет.css");

КонецПроцедуры

