&Тест
Процедура ОпаснаяЗонаБезПодтвержденияПадает() Экспорт

	Векторы = Новый Массив();
	Векторы.Добавить(Новый Структура("Заголовок", "Удаление пула"));
	Векторы.Добавить(Новый Структура("Заголовок, Подтверждение", "Удаление пула", "main"));
	Векторы.Добавить(Новый Структура("Заголовок, Подтверждение", "Удаление пула",
		Новый Структура("Образец", "main"))); // структура есть, а имени поля нет

	Для Каждого Модель Из Векторы Цикл
		Поймано = Ложь;
		Попытка
			UI.ОпаснаяЗона.Отрисовать(Модель);
		Исключение
			Поймано = Истина;
			Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Подтверждение") > 0, "ошибка называет причину").ЭтоИстина();
		КонецПопытки;
		Ожидаем.Что(Поймано, "необратимое действие без подтверждения не рендерится").ЭтоИстина();
	КонецЦикла;

