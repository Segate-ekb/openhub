// Иконку кнопки называет секция: не всякое действие секции — «сохранение», и дискета
// на кнопке-действии читается неверно. Дефолты при этом не меняются.
&Тест
Процедура ПанельБерётИконкуУСекцииАИначеСохраняет() Экспорт

	Дискета = UI.НаборИконок.Контур("сохранить");
	Ключ = UI.НаборИконок.Контур("ключ");
	Корзина = UI.НаборИконок.Контур("корзина");

	Своя = UI.ПанельСохранения.Отрисовать(Новый Структура("Подпись, Иконка",
		"Доверить конвейеру", "ключ"));
	Ожидаем.Что(СтрНайти(Своя, Ключ) > 0, "секция назвала иконку — она и нарисована").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Своя, Дискета), "дискеты при этом нет").Равно(0);

	Дефолт = UI.ПанельСохранения.Отрисовать(Новый Структура("Подпись", "Сохранить"));
	Ожидаем.Что(СтрНайти(Дефолт, Дискета) > 0, "без имени иконки — дискета").ЭтоИстина();

	Опасная = UI.ПанельСохранения.Отрисовать(Новый Структура("Подпись, Опасное",
		"Удалить", Истина));
	Ожидаем.Что(СтрНайти(Опасная, Корзина) > 0, "у опасной секции — корзина").ЭтоИстина();

КонецПроцедуры

