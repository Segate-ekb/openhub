Функция ЗначениеМеты(Знач Мета, Знач Подпись)

	Для Каждого Элемент Из Мета Цикл
		Найденная = "";
		Если Элемент.Свойство("Подпись", Найденная) И Найденная = Подпись Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция АдресМеты(Знач Мета, Знач Подпись)

	Для Каждого Элемент Из Мета Цикл
		Найденная = "";
		Адрес = "";
		Если Элемент.Свойство("Подпись", Найденная) И Найденная = Подпись Тогда
			Возврат ?(Элемент.Свойство("Адрес", Адрес) И Адрес <> Неопределено, Адрес, "");
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция МодельШапки()

	Плашки = Новый Массив();
	Плашки.Добавить(Новый Структура("Текст, Вид", "прокси", "accent"));

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "автор", "alice"));
	Мета.Добавить(Новый Структура("Подпись, Адрес", "репозиторий", "https://github.com/x"));

	// значки проставляет реестр хаба — ровно как на живых экранах: сама шапка словаря
	// подписей не знает
	Возврат Новый Структура("Имя, Вид, Иконка, Подпись, Описание, Плашки, Мета, Команда",
		"winow", "package", "пакет", "пакет", "Веб-фреймворк для OneScript", Плашки,
		UI.ЗначкиМеты.Оснастить(Мета), "opm install winow");

КонецФункции

Функция МодельКарточкиПакета()

	Плашки = Новый Массив();
	Плашки.Добавить(Новый Структура("Текст, Вид", "устаревший", "warn"));

	Действия = Новый Массив();
	Действия.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Настройки",
		"/main/winow/settings", "шестерёнка"));

	Возврат Новый Структура("Имя, Адрес, Описание, Пул, АдресПула, Версия, Плашки, Действия",
		"winow", "/main/winow", "Веб-фреймворк для OneScript", "main", "/main", "0.11.3", Плашки,
		Действия);

КонецФункции

Функция СодержитОтдельноеСлово(Знач Текст, Знач Слово)

	Позиция = СтрНайти(Текст, Слово);
	Смещение = 0;

	Пока Позиция > 0 Цикл
		Абсолютная = Смещение + Позиция;
		Перед = ?(Абсолютная = 1, "", Сред(Текст, Абсолютная - 1, 1));
		После = Сред(Текст, Абсолютная + СтрДлина(Слово), 1);
		Если НЕ СимволИдентификатора(Перед) И НЕ СимволИдентификатора(После) Тогда
			Возврат Истина;
		КонецЕсли;
		Смещение = Абсолютная + СтрДлина(Слово) - 1;
		Позиция = СтрНайти(Сред(Текст, Смещение + 1), Слово);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СимволИдентификатора(Знач Символ)
	Возврат ЗначениеЗаполнено(Символ)
		И СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_", Символ) > 0;
КонецФункции

Функция ФайлыВсехМодулей()

	Результат = Новый Массив();
	КореньМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Если НЕ Новый Файл(КореньМодулей).Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(КореньМодулей, "*.os", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КоллизииБазовыхИмён(Знач Пути)

	ПоИмени = Новый Соответствие();

	Для Каждого Путь Из Пути Цикл
		Имя = Новый Файл(Путь).ИмяБезРасширения;
		Список = ПоИмени.Получить(Имя);
		Если Список = Неопределено Тогда
			Список = Новый Массив();
			ПоИмени.Вставить(Имя, Список);
		КонецЕсли;
		Список.Добавить(Путь);
	КонецЦикла;

	Результат = Новый Массив();

	Для Каждого КиЗ Из ПоИмени Цикл
		Если КиЗ.Значение.Количество() > 1 Тогда
			Результат.Добавить(СтрШаблон("%1: %2", КиЗ.Ключ, СтрСоединить(КиЗ.Значение, " | ")));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Корпус слоя представления: "модуль/Файл.os" -> полное имя файла. Пропавший каталог
// модуля роняет сбор (КлассыСлоя.ФайлыКлассов), поредевший корпус — тоже: сканы слоя
// зеленеют на пустоте, и молчаливое сужение корпуса выглядит как «нарушений нет».
Функция ФайлыСлояПредставления()

	Результат = Новый Соответствие();

	Для Каждого Модуль Из МодулиСлоя() Цикл
		Каталог = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), Модуль, "Классы");
		ДобавитьФайлыМодуля(Результат, Модуль, Каталог);
	КонецЦикла;

	ДобавитьФайлыМодуля(Результат, ИмяМодуляКита(), КаталогКлассовКита());

	Если Результат.Количество() < МинимумФайловСлоя() Тогда
		ВызватьИсключение СтрШаблон(
			"Корпус слоя представления — %1 файлов при минимуме %2: скан ослеп."
				+ " Проверьте МодулиСлоя() и раскладку по каталогам.",
			Результат.Количество(), МинимумФайловСлоя());
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДобавитьФайлыМодуля(Результат, Знач Модуль, Знач Каталог)

	Для Каждого Файл Из Поиск.ФайлыКлассов(Каталог) Цикл
		Ключ = Модуль + "/" + Файл.Имя;
		Если Результат.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Два класса с именем %1 в модуле %2 (%3 и %4): имена типов глобальны,"
					+ " подкаталог пространства имён не создаёт.",
				Файл.Имя, Модуль, Результат[Ключ], Файл.ПолноеИмя);
		КонецЕсли;
		Результат.Вставить(Ключ, Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

// Кит уехал библиотекой, но лист стилей и словарь текстов остались общими: правила CSS
// и ключи, которые печатает только кит, обязаны считаться живыми. Поэтому сканы слоя
// читают УСТАНОВЛЕННЫЙ кит — ровно тот код, который исполняет хаб.
Функция КаталогКлассовКита()

	Каталог = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "oscript_modules"),
		"oscript-ui", "src", "Классы");

	Если НЕ Новый Файл(Каталог).Существует() Тогда
		ВызватьИсключение СтрШаблон("Кит не установлен: каталога %1 нет."
			+ " Без него сканы слоя считают мёртвыми правила и ключи, которые печатает он.",
			Каталог);
	КонецЕсли;

	Возврат Каталог;

КонецФункции

Функция ИмяМодуляКита()
	Возврат "кит";
КонецФункции

// Ниже этого числа корпус слоя считается ослепшим. Нижняя граница с запасом вниз от
// факта: дерево растёт, а подкручивать её приходится только при осознанном сносе кода.
Функция МинимумФайловСлоя()
	Возврат 205;
КонецФункции

// Модули ПРОЕКТА в корпусе сканов слоя; кит приезжает библиотекой и добавляется отдельно,
// см. ФайлыСлояПредставления. Разметку хаба сегодня печатает только `интерфейс`, но корпус
// СКАНОВ шире: пять модулей, из которых экраны уехали, остаются под сканами цветов, сырых
// тегов, легаси-классов и строк мимо ключей. Сужать корпус до одного значило бы снять сеть
// с тех самых мест, куда разметка возвращается первой — к доменной службе, у которой
// «надо быстро показать одну строчку».
Функция МодулиСлоя()
	Результат = Новый Массив();
	Результат.Добавить("интерфейс");
	// экраны из этих пяти уехали в web-ui; остались домен и службы, и сканы слоя
	// стерегут, чтобы разметка сюда не вернулась
	Результат.Добавить("кабинет");
	Результат.Добавить("настройки");
	Результат.Добавить("вход");
	Результат.Добавить("права");
	Результат.Добавить("аудит");
	Возврат Результат;
КонецФункции

Функция ИмяФайлаБезПути(Знач Ключ)
	Позиция = СтрНайти(Ключ, "/");
	Возврат ?(Позиция = 0, Ключ, Сред(Ключ, Позиция + 1));
КонецФункции

Функция ПечатаетРазметку(Знач Ключ, Знач Текст)

	Возврат СтрНайти(Текст, """<") > 0;

КонецФункции

Функция СобирающийРазметкуФайл(Знач ИмяФайла, Знач Текст)

	Если НЕ ПечатаетРазметку(ИмяФайла, Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ИмяФайла = "ЭкранированиеHTML.os" ИЛИ ИмяФайла = "ВитринаКита.os" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат КлассыКита().Найти(Лев(ИмяФайла, СтрДлина(ИмяФайла) - 3)) = Неопределено;

КонецФункции

Функция БезСтрокКомментариев(Знач Текст)

	Строки = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если НЕ СтрНачинаетсяС(СокрЛП(Строка_), "//") Тогда
			Строки.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция КлассыКита()

	Результат = Новый Массив();
	Текст = БезСтрокКомментариев(Исходники.Текст(ФайлКлассаСлоя("НаборКомпонентов")));

	Маркер = "&Пластилин(Значение = """;
	Позиция = СтрНайти(Текст, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Имя = Лев(Хвост, Конец - 1);
			Если Результат.Найти(Имя) = Неопределено Тогда
				Результат.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
		Смещение = Позиция + СтрДлина(Маркер);
		Следующая = СтрНайти(Сред(Текст, Смещение), Маркер);
		Позиция = ?(Следующая = 0, 0, Смещение + Следующая - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файл класса слоя по имени: ищется во ВСЕХ модулях слоя, а не в одном зашитом. Класс,
// переехавший из модуля в модуль, обязан находиться там же — иначе всякая перекладка
// требует правки каждого обращения, а забытое обращение падает «класс не найден».
Функция ФайлКлассаСлоя(Знач ИмяКласса)

	Найденные = Новый Массив();
	Корни = Новый Массив();

	Для Каждого Модуль Из МодулиСлоя() Цикл
		Корни.Добавить(ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
			Модуль, "Классы"));
	КонецЦикла;
	Корни.Добавить(КаталогКлассовКита());

	Для Каждого Каталог Из Корни Цикл
		Для Каждого Файл Из НайтиФайлы(Каталог, ИмяКласса + ".os", Истина) Цикл
			Если Файл.ЭтоФайл() Тогда
				Найденные.Добавить(Файл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0];
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Класс %1 в слое представления найден %2 раз: %3",
		ИмяКласса, Найденные.Количество(), СтрСоединить(Найденные, ", "));

КонецФункции

// Экраны, набивающие мету, и подписи, которые они кладут. Кит пропускается: он ряд ПЕЧАТАЕТ,
// а витрина показывает в том числе ветку «значка для подписи нет».
//
// Возвращаемое значение:
//  Соответствие - "модуль/Файл.os" -> Массив из Строка (подписи).
//
Функция ПоставщикиМеты()

	Результат = Новый Соответствие();

	Для Каждого Файл Из ФайлыСлояПредставления() Цикл

		Если СтрНачинаетсяС(Файл.Ключ, ИмяМодуляКита() + "/") Тогда
			Продолжить;
		КонецЕсли;

		Исходник = ИсходникБезКомментариев(Исходники.Текст(Файл.Значение));
		Если СтрНайти(Исходник, "Мета") = 0 Тогда
			Продолжить;
		КонецЕсли;

		Поставщик = Ложь;
		Подписи = Новый Массив();

		Для Каждого Оператор Из СтрРазделить(Исходник, ";", Ложь) Цикл
			Если НЕ ЭтоОператорМеты(Оператор) Тогда
				Продолжить;
			КонецЕсли;
			Поставщик = Истина;
			ДобавитьПодписиОператора(Подписи, Оператор);
		КонецЦикла;

		Если Поставщик Тогда
			Результат.Вставить(Файл.Ключ, Подписи);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Признаки строятся на КОЛЛЕКЦИИ по имени «Мета», а не на слове «мета» в тексте: иначе
// в поставщики попадает словарь со строкой про метаданные.
Функция ЭтоОператорМеты(Знач Оператор)

	Приметы = Новый Массив();
	Приметы.Добавить("""Подпись, Значение");   // элемент ряда собран структурой
	Приметы.Добавить("Мета.Добавить(");        // и положен в коллекцию
	Приметы.Добавить("(Мета,");                // либо отдан помощнику, который его положит
	Приметы.Добавить("Вставить(""Мета""");     // либо коллекция уехала в модель

	Для Каждого Примета Из Приметы Цикл
		Если СтрНайти(Оператор, Примета) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Подпись приходит либо литералом первым полем структуры, либо ключом словаря в том же
// операторе (в том числе на вызове помощника, которому её передают параметром).
Процедура ДобавитьПодписиОператора(Подписи, Знач Оператор)

	Ключи = Новый Соответствие();
	ДобавитьКлючиВызова(Ключи, Оператор, ".Текст(""", "поставщик");
	Для Каждого КиЗ Из Ключи Цикл
		Подписи.Добавить(UI.Тексты.Текст(КиЗ.Ключ));
	КонецЦикла;

	Литерал = ПерваяПодписьСтруктуры(Оператор);
	Если ЗначениеЗаполнено(Литерал) Тогда
		Подписи.Добавить(Литерал);
	КонецЕсли;

КонецПроцедуры

Функция ПерваяПодписьСтруктуры(Знач Оператор)

	Маркер = """Подпись, Значение";
	Позиция = СтрНайти(Оператор, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	// пропускаем остаток списка полей до его закрывающей кавычки
	Хвост = Сред(Оператор, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, """");
	Если Конец = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = СокрЛ(Сред(Хвост, Конец + 1));
	Если НЕ СтрНачинаетсяС(Хвост, ",") Тогда
		Возврат "";
	КонецЕсли;

	Хвост = СокрЛ(Сред(Хвост, 2));
	Если НЕ СтрНачинаетсяС(Хвост, """") Тогда
		Возврат "";   // подпись собрана выражением — её видно на месте вызова, не здесь
	КонецЕсли;

	Хвост = Сред(Хвост, 2);
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

// Экраны, которым позволено поставлять мету. Список ведётся руками: появление нового
// поставщика обязано пройти через человека, который заведёт значки его подписям.
Функция ФайлыПоставщиковМеты()

	Результат = Новый Соответствие();

	// Оснащает — КТО прогоняет элементы этого поставщика через реестр значков: он сам
	// либо компонент, которому он их отдаёт. Поле обязательное: новый поставщик не может
	// появиться, не ответив, откуда его подписи возьмут значки.
	Результат.Вставить("интерфейс/ВитринаПакетов.os", Новый Структура("Почему, Оснащает",
		"мета шапки страницы пакета", "сам"));
	Результат.Вставить("интерфейс/КарточкаПакета.os", Новый Структура("Почему, Оснащает",
		"пул и версия в карточке списка", "сам"));
	Результат.Вставить("интерфейс/ПлашкиПула.os", Новый Структура("Почему, Оснащает",
		"мета шапки страницы пула", "сам"));
	Результат.Вставить("интерфейс/КонтроллерЛендинга.os", Новый Структура("Почему, Оснащает",
		"карточки главной", "КарточкаПакета"));
	Результат.Вставить("интерфейс/ВитринаМоихПакетов.os", Новый Структура("Почему, Оснащает",
		"карточки «Моих пакетов» в кабинете", "КарточкаПакета"));

	Возврат Результат;

КонецФункции

Функция БезРасширения(Знач ИмяФайла)
	Возврат ?(СтрЗаканчиваетсяНа(ИмяФайла, ".os"), Лев(ИмяФайла, СтрДлина(ИмяФайла) - 3), ИмяФайла);
КонецФункции

Функция ПотерянныеКлючиИсключений(Знач Ожидания, Знач Файлы)

	Результат = Новый Массив();

	Для Каждого КиЗ Из Ожидания Цикл
		Если Файлы.Получить(КиЗ.Ключ) = Неопределено Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛитералыСлояПредставления()

	Результат = Новый Соответствие();

	Для Каждого Файл Из ФайлыСлояПредставления() Цикл
		ДобавитьТокеныЛитералов(Результат, Исходники.Текст(Файл.Значение), """");
	КонецЦикла;

	Скрипт = Исходники.Текст(ОбъединитьПути(
		КаталогПроекта, "src", UI.Поставка.ИмяКаталога(), UI.Поставка.ФайлСкрипта()));
	ДобавитьТокеныЛитералов(Результат, Скрипт, "'");

	Возврат Результат;

КонецФункции

Процедура ДобавитьТокеныЛитералов(Результат, Знач Текст, Знач Кавычка)

	Части = СтрРазделить(Текст, Кавычка, Истина);
	Индекс = 1;

	Пока Индекс < Части.Количество() Цикл
		Для Каждого Токен Из СтрРазделить(Части[Индекс], " " + Символы.Таб, Ложь) Цикл
			Очищенный = БезПодстановок(Токен);
			Если ЗначениеЗаполнено(Очищенный) Тогда
				Результат.Вставить(Очищенный, Истина);
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс + 2;
	КонецЦикла;

КонецПроцедуры

Функция БезПодстановок(Знач Текст)
	Результат = Текст;
	Для Цифра = 1 По 9 Цикл
		Результат = СтрЗаменить(Результат, "%" + Формат(Цифра, "ЧН=0; ЧГ=0"), "");
	КонецЦикла;
	Возврат СокрЛП(Результат);
КонецФункции

// Разбирает строку CSS-переменных «--имя:значение;» в соответствие.
Функция ЗначенияПеременных(Знач Текст)

	Результат = Новый Соответствие();
	Для Каждого Пара Из СтрРазделить(Текст, ";", Ложь) Цикл
		Двоеточие = СтрНайти(Пара, ":");
		Если Двоеточие > 0 Тогда
			Результат.Вставить(СокрЛП(Лев(Пара, Двоеточие - 1)), СокрЛП(Сред(Пара, Двоеточие + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлассыРазметкиСлоя()

	Результат = Новый Соответствие();

	Для Каждого Класс Из КлассыИзHTML(UI.Витрина.Отрисовать()) Цикл
		Результат.Вставить(Класс, "витрина кита");
	КонецЦикла;

	Для Каждого Файл Из ФайлыСлояПредставления() Цикл
		Для Каждого Класс Из КлассыИзАтрибутов(Исходники.Текст(Файл.Значение)) Цикл
			Если Результат.Получить(Класс) = Неопределено Тогда
				Результат.Вставить(Класс, Файл.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КлассыИзHTML(Знач HTML)
	Возврат ТокеныКлассов(HTML, "class=""", """");
КонецФункции

Функция КлассыИзАтрибутов(Знач Текст)
	Возврат ТокеныКлассов(Текст, "class=""""", """""");
КонецФункции

Функция ТокеныКлассов(Знач Текст, Знач Начало, Знач Конец)

	Результат = Новый Массив();
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Начало);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Начало));
		Закрытие = СтрНайти(Хвост, Конец);
		Если Закрытие = 0 Тогда
			Прервать;
		КонецЕсли;
		Значение = Лев(Хвост, Закрытие - 1);
		Для Каждого Токен Из СтрРазделить(Значение, " ", Ложь) Цикл
			Если ЗначениеЗаполнено(Токен) И СтрНайти(Токен, "%") = 0 И Результат.Найти(Токен) = Неопределено Тогда
				Результат.Добавить(Токен);
			КонецЕсли;
		КонецЦикла;
		Хвост = Сред(Хвост, Закрытие);
		Позиция = СтрНайти(Хвост, Начало);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Браузер получает ДВА листа: базовый лист кита и лист инсталляции поверх него. Сканы
// правил идут по их СУММЕ — по одному листу правила соседа объявились бы мёртвыми,
// а классы, которые их печатают, — сиротами. Пути спрашиваются у той же раскладки,
// по которой статику отдаёт сервер, поэтому переезд файла тесты не ломает.
Функция ТекстCSS()
	Возврат Исходники.Текст(UI.Место.ПолныйПуть(UI.Место.ФайлБазовогоЛиста()))
		+ Символы.ПС + Исходники.Текст(UI.Место.ПолныйПуть(UI.Поставка.ФайлСтилей()));
КонецФункции

Функция ТекстJS()
	Возврат Исходники.Текст(ОбъединитьПути(
		КаталогПроекта, "src", UI.Поставка.ИмяКаталога(), UI.Поставка.ФайлСкрипта()));
КонецФункции

// Тело функции скрипта по имени: до её закрывающей скобки в начале строки — так
// сторож видит ровно одну функцию, а не весь файл.
Функция ТелоФункцииJS(Знач Текст, Знач Имя)

	Начало = СтрНайти(Текст, "function " + Имя + "(");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Начало);
	Конец = СтрНайти(Хвост, Символы.ПС + "	}");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Процедура ПотребоватьРитм(Знач HTML, Знач Где)

	Нарушения = Новый РитмФорм().Нарушения(HTML, ТекстCSS());

	Ожидаем.Что(Нарушения.Количество(),
		Где + ": интервал между полями не даёт никто — " + СтрСоединить(Нарушения, "; "))
		.Равно(0);

КонецПроцедуры

Функция КлассыРодителейПолей(Знач Родители)

	Результат = Новый Массив();

	Для Каждого Родитель Из Родители Цикл
		Для Каждого Класс Из Родитель.Классы Цикл
			Если Результат.Найти(Класс) = Неопределено Тогда
				Результат.Добавить(Класс);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазметкаДомаНастроек()

	Поле = UI.Поле;
	Тумблер = UI.Тумблер;

	ТелоПароля = Поле.Отрисовать(Новый Структура("Имя, Метка, Тип", "старый", "Текущий пароль", "пароль"))
		+ Поле.Отрисовать(Новый Структура("Имя, Метка, Тип", "новый", "Новый пароль", "пароль"))
		+ Поле.Отрисовать(Новый Структура("Имя, Метка, Тип", "повтор", "Повтор", "пароль"));

	ТелоТумблеров = Тумблер.Отрисовать(Новый Структура("Имя, Метка, Включён", "публичный", "Публичный", Истина))
		+ Тумблер.Отрисовать(Новый Структура("Имя, Метка", "прокси", "Проксировать апстрим"));

	Секции = Новый Массив();

	БезPOST = UI.РендерерНастроек.Секция("Только чтение", "", ТелоПароля);
	Секции.Добавить(БезPOST);

	СPOST = UI.РендерерНастроек.Секция("Пароль", "Смена пароля", ТелоПароля);
	СPOST.Действие = "/me/settings/security";
	СPOST.Токен = "тест-csrf";
	Секции.Добавить(СPOST);

	Тумблеры = UI.РендерерНастроек.Секция("Общие", "", ТелоТумблеров);
	Тумблеры.Действие = "/hub/settings/pools";
	Тумблеры.Токен = "тест-csrf";
	Секции.Добавить(Тумблеры);

	Возврат UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"account", "Настройки аккаунта", Секции));

КонецФункции

Функция ОбъявленияПравилаCSS(Знач Текст, Знач Селектор)

	Результат = Новый Массив();
	Искомый = СокрЛП(Селектор);

	Для Каждого Правило Из РазборСтилей().ПравилаCSS(Текст, Истина) Цикл
		Если СодержитСелектор(Правило.Селектор, Искомый) Тогда
			Результат.Добавить(СокрЛП(Правило.Объявления));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все правила, в селекторе которых встречается имя класса, — включая составные
// («.a .cls», «.cls[open]»): сравнение селекторов целиком такие правила пропускает.
Функция ПравилаССелекторомПро(Знач Текст, Знач ИмяКласса)

	Результат = Новый Массив();
	Для Каждого Правило Из РазборСтилей().ПравилаCSS(Текст, Истина) Цикл
		Если СтрНайти(Правило.Селектор, ИмяКласса) > 0 Тогда
			Результат.Добавить(Новый Структура("Селектор, Объявления",
				СокрЛП(Правило.Селектор), СокрЛП(Правило.Объявления)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазборСтилей()
	Если РазборCSS = Неопределено Тогда
		РазборCSS = Новый РитмФорм();
	КонецЕсли;
	Возврат РазборCSS;
КонецФункции

Функция СодержитСелектор(Знач СписокСелекторов, Знач Искомый)

	Для Каждого Часть Из СтрРазделить(СписокСелекторов, ",", Ложь) Цикл
		Если НормализованныйСелектор(Часть) = НормализованныйСелектор(Искомый) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НормализованныйСелектор(Знач Селектор)

	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(Селектор, Символы.ПС, " "),
		Символы.ВК, " "), Символы.Таб, " ");

	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции

Функция КлассыИзCSS(Знач Текст)

	Результат = Новый Массив();
	Буфер = "";

	Для Поз = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Поз, 1);
		Если Символ = "{" Тогда
			ДобавитьКлассыСелектора(Результат, Буфер);
			Буфер = "";
		ИначеЕсли Символ = "}" Тогда
			Буфер = "";
		Иначе
			Буфер = Буфер + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьКлассыСелектора(Результат, Знач Селектор)

	Очищенный = БезКомментариевCSS(Селектор);
	Если СтрНайти(Очищенный, "@") > 0 Тогда
		Возврат; // @media/@keyframes — не селектор классов
	КонецЕсли;

	Позиция = СтрНайти(Очищенный, ".");
	Смещение = 0;

	Пока Позиция > 0 Цикл
		Абсолютная = Смещение + Позиция;
		Имя = "";
		Индекс = Абсолютная + 1;
		Пока Индекс <= СтрДлина(Очищенный) Цикл
			Символ = Сред(Очищенный, Индекс, 1);
			Если СимволИдентификатора(Символ) Тогда
				Имя = Имя + Символ;
			Иначе
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
		Если ЗначениеЗаполнено(Имя) И Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
		Смещение = Абсолютная;
		Позиция = СтрНайти(Сред(Очищенный, Смещение + 1), ".");
	КонецЦикла;

КонецПроцедуры

Функция БезКомментариевCSS(Знач Текст)
	Возврат РазборСтилей().БезКомментариевCSS(Текст);
КонецФункции

Функция НеобъявленныеИз(Знач Имена, Знач Объявленные)

	Результат = Новый Массив();
	Для Каждого Имя Из Имена Цикл
		Если Объявленные.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объявления ОДНОГО правила темы: склейка палитр прячет тему, из которой цвет пропал.
Функция ОбъявленияТемы(Знач ТокеныCSS, Знач Селектор)

	Разбор = РазборСтилей();
	Результат = Новый Массив();

	Для Каждого Правило Из Разбор.ПравилаCSS(ТокеныCSS, Истина) Цикл
		Если СокрЛП(Правило.Селектор) <> Селектор Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Имя Из Разбор.ОбъявленныеПеременные(Правило.Объявления) Цикл
			Если Результат.Найти(Имя) = Неопределено Тогда
				Результат.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Объединение(Знач Первый, Знач Второй)

	Результат = Новый Массив();
	Наборы = Новый Массив();
	Наборы.Добавить(Первый);
	Наборы.Добавить(Второй);

	Для Каждого Набор Из Наборы Цикл
		Для Каждого Имя Из Набор Цикл
			Если Результат.Найти(Имя) = Неопределено Тогда
				Результат.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Только цвета: шрифты, сетка, радиусы и движение живут в :root одним экземпляром
// на обе темы — их отсутствие в светлом блоке не перекос, а замысел.
Функция Цвета(Знач Имена)

	Результат = Новый Массив();
	Для Каждого Имя Из Имена Цикл
		Если СтрНачинаетсяС(Имя, "--color-") Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТокеныБезПотребителя(Знач Объявленные, Знач ИзСтатики, Знач ИзТокенов)

	Результат = Новый Массив();
	Для Каждого Имя Из Объявленные Цикл
		Если ИзСтатики.Найти(Имя) = Неопределено И ИзТокенов.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Токены, которые сегодня не запрашивает ни одно правило: ступени рамп — публичная
// поверхность кита, --space-7 и --motion-pulse держит концепция. Список ведётся руками,
// поэтому и новый мёртвый груз, и обретённый потребитель видны сразу.
Функция ОжидаемыеТокеныБезПотребителя()

	Результат = Новый Массив();
	Результат.Добавить("--space-7");
	Результат.Добавить("--motion-pulse");
	Для Ступень = 1 По 9 Цикл
		Значение = Формат(Ступень * 100, "ЧН=; ЧГ=0");
		Если Ступень <> 8 Тогда // --color-neutral-800 живёт в базовом листе кита
			Результат.Добавить("--color-neutral-" + Значение);
		КонецЕсли;
		// ступенями 800 и 900 акцента залита выделенная запись таблицы, ступенью 400 —
		// буква в кружке аватара единого меню
		Если Ступень < 8 И Ступень <> 4 Тогда
			Результат.Добавить("--color-accent-" + Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КлассЖивой(Знач Класс, Знач Корпус)

	Если Корпус.Получить(Класс) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Позиция = СтрНайти(Класс, "--");
	Пока Позиция > 0 Цикл
		Префикс = Лев(Класс, Позиция + 1);
		Если Корпус.Получить(Префикс) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Следующая = СтрНайти(Сред(Класс, Позиция + 2), "--");
		Позиция = ?(Следующая = 0, 0, Позиция + 1 + Следующая);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ИсключенияКлассовБезПравила()

	Результат = Новый Соответствие();

	Возврат Результат;

КонецФункции

Функция ЛегасиКлассы()

	Результат = Новый Массив();
	Результат.Добавить("hero");        // → ШапкаОбъекта
	Результат.Добавить("stats");       // → плитки лендинга (З-12)
	Результат.Добавить("stat");
	Результат.Добавить("list");        // → КарточкаПакета.Список
	Результат.Добавить("name");
	Результат.Добавить("desc");
	Результат.Добавить("meta");
	Результат.Добавить("readme");      // → Карточка + рендер README
	Результат.Добавить("search");      // → Поле + Кнопка
	Результат.Добавить("pager");       // → Пагинация
	Результат.Добавить("grid2");
	Результат.Добавить("col");
	Результат.Добавить("office-form"); // → РендерерНастроек/ПолеФормы
	Результат.Добавить("inline");
	Результат.Добавить("badge");       // → Плашка
	Результат.Добавить("chk");
	Результат.Добавить("providers");
	Результат.Добавить("warning");     // → Тост
	Возврат Результат;

КонецФункции

Функция ЛегасиКлассыФайла(Знач Текст)

	Результат = Новый Массив();
	Легаси = ЛегасиКлассы();

	Для Каждого Класс Из КлассыИзАтрибутов(Текст) Цикл
		Если Легаси.Найти(Класс) <> Неопределено И Результат.Найти(Класс) = Неопределено Тогда
			Результат.Добавить(Класс);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛегасиИсключения()

	Результат = Новый Соответствие();

	Возврат Результат;

КонецФункции

Функция ТегиКита()
	Результат = Новый Массив();
	Результат.Добавить("<button"); // → компонент Кнопка
	Результат.Добавить("<table");  // → компонент Таблица
	Результат.Добавить("<input");  // → компоненты СкрытоеПоле / Поле / Тумблер (6.C п.2)
	Результат.Добавить("<h1");     // → компонент ЗаголовокСтраницы (6.C п.3)
	Результат.Добавить("<h2");     // → компонент ЗаголовокСтраницы, Уровень = 2 (6.C п.3)
	Возврат Результат;
КонецФункции

Функция ИсключенияСыройРазметки()

	Результат = Новый Соответствие();

	Результат.Вставить("кит/РендерерНастроек.os", "<h1");
	// таблица уехала в кит раскладочным родом: <table> печатает слой элементов,
	// и брать «компонент Таблица из набора» ему больше не у кого
	Результат.Вставить("кит/РазметкаЭлементов.os", "<table");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебное

Функция Заголовки(Знач Имя, Знач Значение)
