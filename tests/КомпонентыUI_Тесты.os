КонецПроцедуры

&Тест
Процедура ВозвратПослеСменыТемыБерётТолькоПуть() Экспорт

	Оформление = Новый КонтроллерОформления(UI.Оформление, UI.Токены);

	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "https://evil.example/phish")),
		"из чужого адреса берётся только путь").Равно("/phish");
	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "http://localhost:3333/packages?q=a")),
		"путь и query своего адреса сохраняются").Равно("/packages?q=a");
	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "//evil.example/phish")),
		"protocol-relative — не путь, уходим на корень").Равно("/");

	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "http://hub/\evil.example")),
		"«/\host» — тот же чужой хост, а не путь").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "\\evil.example/phish")),
		"«\\host» — тоже").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "http://hub\packages")),
		"обратный слэш — разделитель пути, хост отрезается по нему").Равно("/packages");

	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "/ok" + Символы.ВК + Символы.ПС + "X-Injected: 1")),
		"CR/LF в Referer — возврат на корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Заголовки("Referer", "")),
		"без Referer — корень").Равно("/");
	Ожидаем.Что(Оформление.ПутьВозврата(Неопределено),
		"без заголовков — корень").Равно("/");

КонецПроцедуры

&Тест
Процедура СменаТемыСохраняетОстальноеОформление() Экспорт

	Текущее = КодироватьСтроку("тема=светлая&акцент=%239184d9&плотность=1.2",
		СпособКодированияСтроки.КодировкаURL);

	Новое = РаскодироватьСтроку(UI.Оформление.ЗначениеCookieСТемой(Текущее, "тёмная"),
		СпособКодированияСтроки.КодировкаURL);

	Ожидаем.Что(СтрНайти(Новое, "тема=тёмная") > 0, "тема переключилась").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Новое, "плотность=1.2") > 0, "плотность уцелела").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Новое, "акцент=") > 0, "акцент уцелел").ЭтоИстина();

	Пустая = РаскодироватьСтроку(UI.Оформление.ЗначениеCookieСТемой("", "светлая"),
		СпособКодированияСтроки.КодировкаURL);
	Ожидаем.Что(Пустая, "только тема").Равно("тема=светлая");

КонецПроцедуры

#КонецОбласти

#Область Меню

// Кнопку и её панель связывает идентификатор, который генерирует КИТ: на кнопке
// popovertarget, на панели тот же id и атрибут popover. Из-за popover панель уходит
// в верхний слой браузера — не в потоке, значит строка не растёт и соседние не сдвигаются,
// и обёртка прокрутки таблицы её не обрезает.
&Тест
Процедура МенюСвязываетКнопкуСПанельюВВерхнемСлое() Экспорт

	HTML = UI.Меню.Отрисовать(Новый Структура("Подпись, Пункты",
		"Меню пула main", ПунктыМенюОбразец()));

	Иды = ИдентификаторыПанелейМеню(HTML);
	Ожидаем.Что(Иды.Количество(), "панель ровно одна и она всплывающая: " + HTML).Равно(1);
	Ожидаем.Что(СтрНайти(HTML, "popovertarget=""" + Иды[0] + """") > 0,
		"кнопка открывает ИМЕННО свою панель").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "class=""menu__panel""") > 0, "панель узнаваема стилями").ЭтоИстина();

	// кнопка названа для скринридера и ничего не отправляет: меню открывают, а не сохраняют
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Меню пула main""") > 0,
		"кнопка-шестерёнка названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "type=""button""") > 0,
		"кнопка меню не отправляет форму, внутри которой может стоять").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<svg") > 0, "и несёт значок").ЭтоИстина();

	// состояние «открыто» ведёт движок: прибитое aria-expanded="false" врало бы сразу
	// после открытия — скрипта, который его поправит, у нас нет
	Ожидаем.Что(СтрНайти(HTML, "aria-expanded"),
		"статического состояния раскрытия в разметке нет").Равно(0);

КонецПроцедуры

// Идентификатор связи — порядковый номер кита, и ни один его символ не приходит из данных.
// Возьми кит имя строки — два похожих имени («мой пул» и «мой-пул») дали бы один
// идентификатор, и шестерёнка одной строки открыла бы меню другой.
&Тест
Процедура ИдентификаторыМенюУникальныИНеСобраныИзДанных() Экспорт

	Имена = Новый Массив();
	Имена.Добавить("мой пул");
	Имена.Добавить("мой-пул");
	Имена.Добавить("мой пул");        // ровно то же имя: список вправе нести тёзок
	Имена.Добавить("<b>пул</b>");

	Выданные = Новый Соответствие();

	Для Каждого Имя Из Имена Цикл

		HTML = UI.Меню.Отрисовать(Новый Структура("Подпись, Пункты",
			"Меню пула " + Имя, ПунктыМенюОбразец()));
		Иды = ИдентификаторыПанелейМеню(HTML);
		Ожидаем.Что(Иды.Количество(), "панель выдана: " + HTML).Равно(1);

		Ожидаем.Что(Выданные.Получить(Иды[0]) = Неопределено,
			"идентификатор «" + Иды[0] + "» выдан второй раз: кнопка откроет чужое меню")
			.ЭтоИстина();
		Выданные.Вставить(Иды[0], Истина);

		Ожидаем.Что(ИдентификаторБезДанных(Иды[0]),
			"в идентификаторе «" + Иды[0] + "» есть символы не из порядкового номера:"
			+ " значение из данных в связь не попадает вовсе").ЭтоИстина();

	КонецЦикла;

	Ожидаем.Что(Выданные.Количество(), "четыре меню — четыре разных идентификатора").Равно(4);

КонецПроцедуры

// Тот же инвариант на ЦЕЛОЙ странице: витрина печатает несколько меню подряд, и каждая
// кнопка открывает СВОЮ панель. Страница с двумя одинаковыми id — это меню, открывающее
// соседнее. Единое меню инсталляции считается отдельно: витрина показывает его бургер,
// рейку и панель РАЗНЫМИ образцами, поэтому кнопка образца целится в панель соседнего.
// Их связь стережёт ХолстКита на настоящей странице хаба.
&Тест
Процедура НаСтраницеИдентификаторыМенюНеПовторяютсяИКнопкиСходятся() Экспорт

	HTML = UI.Витрина.Отрисовать();

	Панели = БезЕдиногоМеню(ИдентификаторыПанелейМеню(HTML));
	Ожидаем.Что(Панели.Количество() > 1,
		"на странице витрины меню несколько — иначе уникальность сторожить не на чем").ЭтоИстина();

	Встреченные = Новый Соответствие();
	Для Каждого Ид Из Панели Цикл
		Ожидаем.Что(Встреченные.Получить(Ид) = Неопределено,
			"идентификатор панели «" + Ид + "» на странице не один").ЭтоИстина();
		Встреченные.Вставить(Ид, Истина);
	КонецЦикла;

	Цели = ЦелиКнопокМеню(HTML);
	Ожидаем.Что(Цели.Количество(), "у каждой панели своя кнопка").Равно(Панели.Количество());

	Потерянные = Новый Массив();
	Для Каждого Цель Из Цели Цикл
		Если Встреченные.Получить(Цель) = Неопределено Тогда
			Потерянные.Добавить(Цель);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"кнопка целится в панель, которой на странице нет").Равно("");

КонецПроцедуры

// Пункты приходят МОДЕЛЬЮ: вызывающему остаются подпись, адрес и значок, вид и размер
// задаёт само меню. Готовый фрагмент (форма, примечание) кладётся полем HTML.
&Тест
Процедура ПунктыМенюПриходятМодельюАГотовыйФрагментВставляетсяКакЕсть() Экспорт

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		"Права", "/main/settings/access", "замок"));
	Пункты.Добавить(Новый Структура("HTML", "<form class=""menu__form""></form>"));
	Пункты.Добавить(Новый Структура("Подпись", "Пункт без адреса"));

	HTML = UI.Меню.Отрисовать(Новый Структура("Подпись, Пункты", "Меню строки", Пункты));

	Ожидаем.Что(СтрНайти(HTML, "<a href=""/main/settings/access""") > 0,
		"пункт с адресом — ссылка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Права</span>") > 0, "с видимой подписью").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "button--sm") > 0, "размер пунктов задаёт меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<form class=""menu__form""></form>") > 0,
		"готовый фрагмент вставлен как есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Пункт без адреса"),
		"пункту без адреса и без готового HTML рисовать нечего").Равно(0);

КонецПроцедуры

// Чужой текст не становится разметкой: подпись экранируется, а в идентификатор связи
// не попадает вовсе.
&Тест
Процедура ПодписьМенюЭкранируетсяИНеПротекаетВИдентификатор() Экспорт

	HTML = UI.Меню.Отрисовать(Новый Структура("Подпись, Пункты",
		"""><script>alert(1)</script>", ПунктыМенюОбразец()));

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "разметка из подписи не проросла").Равно(0);

	Иды = ИдентификаторыПанелейМеню(HTML);
	Ожидаем.Что(Иды.Количество(), "панель на месте").Равно(1);
	Ожидаем.Что(ИдентификаторБезДанных(Иды[0]),
		"идентификатор «" + Иды[0] + "» собран не из подписи").ЭтоИстина();

КонецПроцедуры

// Меню без подписи молчит для скринридера, меню без пунктов открывает пустоту:
// и то, и другое — сломанный экран, а не мелочь оформления.
&Тест
Процедура МенюБезПодписиИБезПунктовОтвергается() Экспорт

	БезПодписи = Ложь;
	Попытка
		UI.Меню.Отрисовать(Новый Структура("Пункты", ПунктыМенюОбразец()));
	Исключение
		БезПодписи = Истина;
	КонецПопытки;
	Ожидаем.Что(БезПодписи, "меню без подписи — исключение").ЭтоИстина();

	Пустое = Ложь;
	Попытка
		UI.Меню.Отрисовать(Новый Структура("Подпись, Пункты", "Меню строки", Новый Массив()));
	Исключение
		Пустое = Истина;
	КонецПопытки;
	Ожидаем.Что(Пустое, "меню без пунктов — исключение").ЭтоИстина();

	ТолькоПустышки = Новый Массив();
	ТолькоПустышки.Добавить(Новый Структура("Подпись", "Пункт без адреса"));
	Отсеяно = Ложь;
	Попытка
		UI.Меню.Отрисовать(Новый Структура("Подпись, Пункты", "Меню строки", ТолькоПустышки));
	Исключение
		Отсеяно = Истина;
	КонецПопытки;
	Ожидаем.Что(Отсеяно, "меню, у которого все пункты отсеялись, — тоже исключение").ЭтоИстина();

КонецПроцедуры

Функция ПунктыМенюОбразец()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		"Настройки", "/main/settings", "шестерёнка"));
	Возврат Результат;

КонецФункции

// Идентификаторы панелей: значение id у элемента, за которым стоит атрибут popover.
// Ищется признак верхнего слоя, а не префикс «menu-»: сторожу важно, что панель всплывает
// и что идентификатор у неё свой, а не как именно кит его назвал.
Функция ЦелиКнопокМеню(Знач Текст)
	Возврат БезЕдиногоМеню(ЗначенияПоМаркеру(Текст, "popovertarget="""));
КонецФункции

// Единое меню инсталляции живёт на витрине тремя отдельными образцами (бургер, рейка,
// панель), и связь кнопки с панелью там разорвана нарочно: каждый образец печатает
// СВОЮ часть. Считать их вместе со строчными меню значит сторожить раскладку витрины.
Функция БезЕдиногоМеню(Знач Значения)

	Результат = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Если НЕ СтрНачинаетсяС(Значение, "hubmenu") Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИдентификаторыПанелейМеню(Знач Текст)

	Результат = Новый Массив();
	Для Каждого Найденное Из ЗначенияПоМаркеруСХвостом(Текст, "id=""") Цикл
		Если СтрНачинаетсяС(Найденное.Хвост, " popover") Тогда
			Результат.Добавить(Найденное.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Идентификатор, собранный китом: строчная латиница, цифры и дефис. Кириллица, пробел
// и кавычка в нём означают, что в связь протекло значение из данных.
Функция ИдентификаторБезДанных(Знач Идентификатор)

	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789-";
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Идентификатор) Цикл
		Если СтрНайти(Допустимые, Сред(Идентификатор, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЗначенияПоМаркеру(Знач Текст, Знач Маркер)

	Результат = Новый Массив();
	Для Каждого Найденное Из ЗначенияПоМаркеруСХвостом(Текст, Маркер) Цикл
		Результат.Добавить(Найденное.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Значения атрибута по маркеру вида «имя="» вместе с текстом, идущим за закрывающей
// кавычкой: по нему различаются одноимённые атрибуты разных элементов.
Функция ЗначенияПоМаркеруСХвостом(Знач Текст, Знач Маркер)

	Результат = Новый Массив();
	Позиция = СтрНайти(Текст, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Результат.Добавить(Новый Структура("Значение, Хвост",
				Лев(Хвост, Конец - 1), Лев(Сред(Хвост, Конец + 1), 16)));
		КонецЕсли;
		Смещение = Позиция + СтрДлина(Маркер);
		Следующая = СтрНайти(Сред(Текст, Смещение), Маркер);
		Позиция = ?(Следующая = 0, 0, Смещение + Следующая - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Витрина

// Витрина печатает ВСЕ компоненты кита разом, поэтому она же и самый широкий образец
// его выдачи: скрипта, инлайнового обработчика и инлайнового стиля в ней быть не должно.
// Что в витрине показан весь словарь библиотеки, стережёт набор самой библиотеки
// (oscript-ui: ВитринаКита_Тесты.ВитринаПоказываетВесьСловарьКита) — там же, где словарь
// и объявлен.
&Тест
Процедура ВыдачаКитаРаботаетБезJS() Экспорт

	HTML = UI.Витрина.Отрисовать();
	Ожидаем.Что(СтрНайти(HTML, "UI-кит") > 0, "витрина собирается целиком").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "скриптов в ките нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "onclick"), "инлайн-обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "onchange"), "инлайн-обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "style="), "инлайн-стилей в ките нет").Равно(0);

КонецПроцедуры

// Реестр значков проверяется НА ВЫДАЧЕ, а не на разделе витрины: подписи в реестр
// заводят ради ряда меты, и доказательство — что каждая доезжает до разметки значком.
// Раньше это доказывал раздел витрины «Карточка пакета», но карточка пакета — экран
// хаба, а не компонент кита, и витрине кита её показывать больше нечем.
&Тест
Процедура КаждаяПодписьМетыДоезжаетДоРазметкиЗначком() Экспорт

	Подписи = UI.ЗначкиМеты.Подписи();
	Ожидаем.Что(Подписи.Количество() > 5, "реестр непустой: " + Подписи.Количество()).ЭтоИстина();

	Мета = Новый Массив();
	Для Каждого Подпись Из Подписи Цикл
		Мета.Добавить(Новый Структура("Подпись, Значение", Подпись, "значение"));
	КонецЦикла;
	Мета.Добавить(Новый Структура("Подпись, Значение", "зеркал", "3"));

	HTML = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Непоказанные = Новый Массив();
	Для Каждого Подпись Из Подписи Цикл
		Если СтрНайти(HTML, "title=""" + Подпись + """") = 0 Тогда
			Непоказанные.Добавить(Подпись);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Непоказанные, ", "),
		"подписи реестра, не получившие значка в разметке").Равно("");

	Ожидаем.Что(СтрНайти(HTML, "зеркал: значение") > 0 ИЛИ СтрНайти(HTML, "зеркал: 3") > 0,
		"и случай «значка для подписи нет» печатается текстом").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВитринаВСтраницеУважаетТемуИзКук() Экспорт

	Светлая = UI.Каркас.Страница("Витрина", UI.Витрина.Отрисовать(),
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("светлая")));
	Тёмная = UI.Каркас.Страница("Витрина", UI.Витрина.Отрисовать(),
		UI.Каркас.КонтекстСтраницы(Неопределено, КукиСТемой("тёмная")));

	Ожидаем.Что(СтрНайти(Светлая, ТегHTML("light")) > 0, "светлая тема из куки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тёмная, ТегHTML("dark")) > 0, "тёмная тема из куки").ЭтоИстина();

	БезСкриптов = БезТегаScript(Светлая);
	Ожидаем.Что(СтрНайти(БезСкриптов, "UI-кит") > 0, "кит виден без JS").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "<link rel=""stylesheet""") > 0, "оформление не зависит от JS").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Брендирование

&Тест
Процедура БрендированиеМеняетВидБезПравкиШаблонов() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.ui.brand", "Хаб Ромашка");
	Настройки.Задать("oshub.ui.tagline", "Внутренний хаб пакетов компании");
	Настройки.Задать("oshub.ui.theme", "светлая");
	Настройки.Задать("oshub.ui.accent", "#ff8800");

	Свой = Новый Брендирование(Настройки);
	ОбрамлениеСвоё = Новый ОбрамлениеХаба(Свой, UI.Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), UI.Тексты,
		UI.АдресаКаталога, Новый ВозвратПослеВхода(), UI.АдресаКабинета, UI.Кит, UI.Подсветка);
	РендерерСвой = Новый КаркасСтраницы(UI.Кит, UI.Токены,
		Новый ВыборОформления(Новый ОформлениеХаба(Настройки)), UI.Тексты, UI.Модели,
		UI.Активы, ОбрамлениеСвоё, UI.МенюХаба);

	Наш = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Чужой = РендерерСвой.Страница("Каталог", "<p>тело</p>",
		РендерерСвой.КонтекстСтраницы(Неопределено, Неопределено));

	Ожидаем.Что(СтрНайти(Чужой, "Хаб Ромашка") > 0, "знак инсталляции в разметке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, "<title>Каталог — Хаб Ромашка</title>") > 0, "знак в заголовке вкладки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, "Внутренний хаб пакетов компании") > 0, "подпись подвала").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, "--color-accent:#ff8800") > 0, "акцент инсталляции").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Чужой, ТегHTML("light")) > 0, "тема инсталляции").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Наш, "Хаб Ромашка"), "чужой знак не протёк в инсталляцию по умолчанию").Равно(0);
	Ожидаем.Что(СтрНайти(Наш, UI.Бренд.ЗнакПоУмолчанию()) > 0, "знак по умолчанию на месте").ЭтоИстина();

	Настройки.Задать("oshub.ui.brand", "   ");
	Настройки.Задать("oshub.ui.tagline", "");
	Ожидаем.Что(Свой.Знак()).Равно(UI.Бренд.ЗнакПоУмолчанию());
	Ожидаем.Что(Свой.Подпись()).Равно(UI.Бренд.ПодписьПоУмолчанию());

КонецПроцедуры

&Тест
Процедура ЗнакИнсталляцииНеЗашитВШаблоныСлояКаркаса() Экспорт

	Литералы = Новый Массив();
	Литералы.Добавить(UI.Бренд.ЗнакПоУмолчанию());
	Литералы.Добавить(UI.Бренд.ПодписьПоУмолчанию());

	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыСлояПредставления() Цикл
		Если ИмяФайлаБезПути(Файл.Ключ) = "Брендирование.os" Тогда
			Продолжить;
		КонецЕсли;
		Текст = Исходники.Текст(Файл.Значение);
		Если НЕ ПечатаетРазметку(Файл.Ключ, Текст) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Литерал Из Литералы Цикл
			Если СодержитОтдельноеСлово(Текст, Литерал) Тогда
				Нарушители.Добавить(Файл.Ключ + ": «" + Литерал + "»");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"брендирование зашито в шаблон — оно перестанет меняться деталькой").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СканыСлояПредставления

&Тест
Процедура БазовыеИменаКлассовУникальныВоВсёмКаталогеПриложений() Экспорт

	Файлы = ФайлыВсехМодулей();

	Ожидаем.Что(Файлы.Количество() > 200,
		СтрШаблон("файлов классов в src/модули найдено: %1", Файлы.Количество())).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(КоллизииБазовыхИмён(Файлы), Символы.ПС),
		"одноимённые классы в разных модулях: winow регистрирует их в ОДИН глобальный"
			+ " неймспейс и падает на втором («Type ... already registered»)").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторКоллизииБазовыхИмёнКраснеетНаПриманке() Экспорт

	Приманка = Новый Массив();
	Приманка.Добавить("/src/модули/интерфейс/Классы/общее/Плашка.os");
	Приманка.Добавить("/src/модули/кабинет/Классы/Плашка.os");
	Приманка.Добавить("/src/модули/данные/Классы/Тег.os");

	Коллизии = КоллизииБазовыхИмён(Приманка);

	Ожидаем.Что(Коллизии.Количество(), "коллизия найдена ровно одна").Равно(1);
	Ожидаем.Что(СтрНайти(Коллизии[0], "Плашка") > 0, "названо имя-виновник").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Коллизии[0], "интерфейс") > 0 И СтрНайти(Коллизии[0], "кабинет") > 0,
		"названы ОБА полных пути: без них искать виновника руками").ЭтоИстина();

	Одиночки = Новый Массив();
	Одиночки.Добавить("/src/модули/данные/Классы/Тег.os");
	Ожидаем.Что(КоллизииБазовыхИмён(Одиночки).Количество(), "одиночное имя — не коллизия").Равно(0);

КонецПроцедуры

&Тест
Процедура ВСтатическомCSSНетМёртвыхПравил() Экспорт

	Живые = ЛитералыСлояПредставления();
	Мёртвые = Новый Массив();

	Для Каждого Класс Из КлассыИзCSS(ТекстCSS()) Цикл
		Если НЕ КлассЖивой(Класс, Живые) Тогда
			Мёртвые.Добавить(Класс);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Мёртвые, ", "),
		"правила CSS, которых не печатает ни один .os слоя представления").Равно("");

КонецПроцедуры

// var(--имя) без объявления браузер отбрасывает вместе со всем объявлением: правило
// молча перестаёт работать, а глазами это не видно — в тексте таблицы стилей всё на месте.
&Тест
Процедура КаждаяПеременнаяСтатикиОбъявленаВТокенахТемы() Экспорт

	Разбор = РазборСтилей();
	ТокеныCSS = UI.Токены.Переменные();

	// объявления берутся ПОРОЛЬНО: токен, объявленный внутри чужого правила, глобальным
	// не становится, а склейка обеих палитр прячет тему, из которой цвет пропал
	Тёмная = ОбъявленияТемы(ТокеныCSS, ":root");
	Светлая = ОбъявленияТемы(ТокеныCSS, "html[data-theme=""light""]");
	Объявленные = Объединение(Тёмная, Светлая);

	ИзСтатики = Разбор.ИспользованныеПеременные(ТекстCSS());
	ИзТокенов = Разбор.ИспользованныеПеременные(ТокеныCSS);

	Ожидаем.Что(ИзСтатики.Количество() > 20,
		СтрШаблон("var(--…) в листах страницы найдено: %1 — сканер не ослеп",
			ИзСтатики.Количество())).ЭтоИстина();
	Ожидаем.Что(Тёмная.Количество() > 40,
		СтрШаблон("токенов тёмной темы разобрано: %1 — разбор источника не ослеп",
			Тёмная.Количество())).ЭтоИстина();
	Ожидаем.Что(Светлая.Количество() > 20,
		СтрШаблон("токенов светлой темы разобрано: %1 — разбор источника не ослеп",
			Светлая.Количество())).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(ИзСтатики, Объявленные), ", "),
		"var(--…) в листах страницы, которых не объявляет ТокеныТемы: браузер отбрасывает"
			+ " такое объявление целиком, правило не работает").Равно("");

	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(ИзТокенов, Объявленные), ", "),
		"токен темы ссылается на переменную, которой сам не объявляет (тени и рампы"
			+ " собираются из цветов палитры)").Равно("");

	// Тема по умолчанию — тёмная, и цвет, оставшийся только в светлой палитре, убивает
	// правило ровно у большинства смотрящих; обратный перекос делает светлую тему копией
	// тёмной. Поэтому цветовые наборы палитр обязаны совпадать.
	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(Цвета(Светлая), Тёмная), ", "),
		"цвета, объявленные ТОЛЬКО в светлой палитре: в тёмной теме (она по умолчанию)"
			+ " правила с ними не работают").Равно("");
	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(Цвета(Тёмная), Светлая), ", "),
		"цвета, объявленные ТОЛЬКО в тёмной палитре: светлая тема наследует тёмное"
			+ " значение").Равно("");

	Ничьи = ТокеныБезПотребителя(Объявленные, ИзСтатики, ИзТокенов);
	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(Ничьи, ОжидаемыеТокеныБезПотребителя()), ", "),
		"новые токены темы, которых не запрашивает ни одно правило: мёртвый груз либо"
			+ " забытый потребитель").Равно("");
	Ожидаем.Что(СтрСоединить(НеобъявленныеИз(ОжидаемыеТокеныБезПотребителя(), Ничьи), ", "),
		"токены из списка «без потребителя» обзавелись потребителем — уберите их"
			+ " из списка").Равно("");

КонецПроцедуры

// Разбор переменных ловит формы записи, на которых сканер молча слепнет: запасное
// значение, произвольные пробелы, несколько var() в объявлении, собственный комментарий.
&Тест
Процедура СканПеременныхНеПитаетсяКомментариямиИВидитЗапасныеЗначения() Экспорт

	Разбор = РазборСтилей();

	Приманка = "/* var(--из-комментария) — только текст */" + Символы.ПС
		+ ".a { color: var( --с-пробелом , #fff); border: 1px solid var(--первый) var(--второй); }"
		+ Символы.ПС
		+ ".b { box-shadow: 0 0 0 1px var(--внешний, var(--вложенный)); }" + Символы.ПС
		+ ".c { border: 1px solid/*пояснение*/var(--за-комментарием); }" + Символы.ПС
		+ ".d::before { content: ""var(--из-литерала)""; }" + Символы.ПС
		+ ".button--link:hover { text-decoration: underline; }";

	Имена = Разбор.ИспользованныеПеременные(Приманка);

	Ожидаем.Что(Имена.Найти("--с-пробелом") <> Неопределено,
		"пробелы внутри var() и запасное значение").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--первый") <> Неопределено И Имена.Найти("--второй") <> Неопределено,
		"два var() в одном объявлении").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--вложенный") <> Неопределено,
		"var() внутри запасного значения").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--за-комментарием") <> Неопределено,
		"комментарий вплотную к var(): склейка соседей теряла бы использование молча")
		.ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--из-комментария") = Неопределено,
		"имя из комментария CSS использованием не считается").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--из-литерала") = Неопределено,
		"имя внутри строкового литерала (content) переменной не использует").ЭтоИстина();
	Ожидаем.Что(Имена.Количество(), "лишнего в выборке нет").Равно(6);

	Объявления = Разбор.ОбъявленныеПеременные(
		"--объявленный:#fff;--через-пробел : 4px;--тень:0 0 0 1px var(--объявленный);");

	Ожидаем.Что(Объявления.Найти("--объявленный") <> Неопределено, "простое объявление").ЭтоИстина();
	Ожидаем.Что(Объявления.Найти("--через-пробел") <> Неопределено,
		"пробел перед двоеточием").ЭтоИстина();
	Ожидаем.Что(Объявления.Найти("--тень") <> Неопределено, "объявление со ссылкой внутри").ЭтоИстина();
	Ожидаем.Что(Объявления.Количество(),
		"var(--x) в значении объявлением не считается").Равно(3);

	// область видимости: объявление живёт в своём правиле, а не во всей таблице
	Внутри = ОбъявленияТемы(":root{--свой:1px;}.чужой{--чужой:2px;}", ":root");
	Ожидаем.Что(Внутри.Найти("--свой") <> Неопределено, "объявление своего правила видно").ЭтоИстина();
	Ожидаем.Что(Внутри.Найти("--чужой") = Неопределено,
		"объявление ЧУЖОГО правила глобальным не становится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаждыйКлассРазметкиИмеетПравилоВCSS() Экспорт

	Правила = КлассыИзCSS(ТекстCSS());
	Исключения = ИсключенияКлассовБезПравила();
	Сироты = Новый Массив();
	Использованные = Новый Соответствие();

	Для Каждого КиЗ Из КлассыРазметкиСлоя() Цикл
		Если Правила.Найти(КиЗ.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Исключения.Получить(КиЗ.Ключ) <> Неопределено Тогда
			Использованные.Вставить(КиЗ.Ключ, Истина);
			Продолжить;
		КонецЕсли;
		Сироты.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
	КонецЦикла;

	Неиспользованные = Новый Массив();
	Для Каждого КиЗ Из Исключения Цикл
		Если Использованные.Получить(КиЗ.Ключ) = Неопределено Тогда
			Неиспользованные.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Сироты, ", "),
		"классы разметки, для которых нет правила в статике").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: класс получил правило или исчез из разметки")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ЛегасиКлассыДержатсяТолькоПоЯвномуСписку() Экспорт

	Нарушители = Новый Массив();
	Неиспользованные = Новый Массив();
	Ожидания = ЛегасиИсключения();
	Файлы = ФайлыСлояПредставления();

	ПотерянныеКлючи = ПотерянныеКлючиИсключений(Ожидания, Файлы);

	Для Каждого Файл Из Файлы Цикл

		Разрешённые = Ожидания.Получить(Файл.Ключ);
		Найденные = ЛегасиКлассыФайла(Исходники.Текст(Файл.Значение));

		Для Каждого Класс Из Найденные Цикл
			Если Разрешённые = Неопределено ИЛИ СтрНайти(" " + Разрешённые + " ", " " + Класс + " ") = 0 Тогда
				Нарушители.Добавить(Файл.Ключ + ": " + Класс);
			КонецЕсли;
		КонецЦикла;

		Если Разрешённые <> Неопределено Тогда
			Для Каждого Класс Из СтрРазделить(Разрешённые, " ", Ложь) Цикл
				Если Найденные.Найти(Класс) = Неопределено Тогда
					Неиспользованные.Добавить(Файл.Ключ + ": " + Класс);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"новые легаси-классы в разметке (кит их заменяет — см. НаборКомпонентов)").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: экран переведён, удалите строку из ЛегасиИсключения()")
		.Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКлючи, ", "),
		"исключения для несуществующих файлов: файл переименован или удалён").Равно("");

КонецПроцедуры

&Тест
Процедура КонтроллерыНеРисуютРазметкуМимоКита() Экспорт

	Нарушители = Новый Массив();
	Неиспользованные = Новый Массив();
	Ожидания = ИсключенияСыройРазметки();
	Файлы = ФайлыСлояПредставления();

	ПотерянныеКлючи = ПотерянныеКлючиИсключений(Ожидания, Файлы);

	Для Каждого Файл Из Файлы Цикл

		Текст = Исходники.Текст(Файл.Значение);
		Если НЕ СобирающийРазметкуФайл(ИмяФайлаБезПути(Файл.Ключ), Текст) Тогда
			Продолжить;
		КонецЕсли;

		Найденные = Новый Массив();
		Для Каждого Тег Из ТегиКита() Цикл
			Если СтрНайти(Текст, Тег) > 0 Тогда
				Найденные.Добавить(Тег);
			КонецЕсли;
		КонецЦикла;

		Разрешённые = Ожидания.Получить(Файл.Ключ);

		Для Каждого Тег Из Найденные Цикл
			Если Разрешённые = Неопределено ИЛИ СтрНайти(" " + Разрешённые + " ", " " + Тег + " ") = 0 Тогда
				Нарушители.Добавить(Файл.Ключ + ": " + Тег);
			КонецЕсли;
		КонецЦикла;

		Если Разрешённые <> Неопределено Тогда
			Для Каждого Тег Из СтрРазделить(Разрешённые, " ", Ложь) Цикл
				Если Найденные.Найти(Тег) = Неопределено Тогда
					Неиспользованные.Добавить(Файл.Ключ + ": " + Тег);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"разметка мимо кита (возьмите Кнопку/Таблицу из набора)").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: экран переведён на кит").Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКлючи, ", "),
		"исключения для несуществующих файлов: файл переименован или удалён").Равно("");

КонецПроцедуры

#КонецОбласти

#Область КлючиСтрок

&Тест
Процедура ПользовательскиеСтрокиЖивутВСловареАНеВЭкранах() Экспорт

	Ожидания = ФайлыБезКлючейСтрок();
	Файлы = ФайлыСлояПредставления();
	ФайлСловаря = ФайлСловаряТекстов();

	Нарушители = Новый Массив();
	Неиспользованные = Новый Массив();
	ПотерянныеКлючи = ПотерянныеКлючиИсключений(Ожидания, Файлы);

	Для Каждого Файл Из Файлы Цикл

		Если Файл.Ключ = ФайлСловаря Тогда
			Продолжить;
		КонецЕсли;

		Разрешён = (Ожидания.Получить(Файл.Ключ) <> Неопределено);
		Проза = ПрозаическиеЛитералы(Исходники.Текст(Файл.Значение), ?(Разрешён, 1, 3));

		Если Проза.Количество() > 0 И НЕ Разрешён Тогда
			Нарушители.Добавить(Файл.Ключ + ": «" + СтрСоединить(Проза, "» «") + "»");
		КонецЕсли;
		Если Проза.Количество() = 0 И Разрешён Тогда
			Неиспользованные.Добавить(Файл.Ключ);
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, "; "),
		"пользовательские строки в исходнике (заведите ключ в СловарьТекстов)").Равно("");
	Ожидаем.Что(СтрСоединить(Неиспользованные, ", "),
		"исключения, которые больше не нужны: файл переведён на ключи, удалите строку"
		+ " из ФайлыБезКлючейСтрок()").Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКлючи, ", "),
		"исключения для несуществующих файлов: файл переименован или удалён").Равно("");

КонецПроцедуры

&Тест
Процедура КлючиКодаИСловаряСовпадаютРовно() Экспорт

	Использованные = КлючиИзКода();
	Объявленные = UI.СловарьТекстов.Ключи();

	Известные = Новый Соответствие();
	Для Каждого Ключ Из Объявленные Цикл
		Известные.Вставить(Ключ, Истина);
	КонецЦикла;

	Отсутствующие = Новый Массив();
	Для Каждого КиЗ Из Использованные Цикл
		Если Известные.Получить(КиЗ.Ключ) = Неопределено Тогда
			Отсутствующие.Добавить(КиЗ.Ключ + " (" + КиЗ.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Косвенные = КлючиСпрашиваемыеПеременной();

	Мёртвые = Новый Массив();
	Для Каждого Ключ Из Объявленные Цикл
		Если Использованные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Ключ, 13) = "settings.key." Тогда
			Продолжить;
		КонецЕсли;
		Если Косвенные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Мёртвые.Добавить(Ключ);
	КонецЦикла;

	Ожидаем.Что(Использованные.Количество() > 50,
		"сборщик ключей вообще находит ключи в коде слоя").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Отсутствующие, ", "),
		"ключи, которых нет в словаре: на экране будет маркер вместо текста").Равно("");
	Ожидаем.Что(СтрСоединить(Мёртвые, ", "),
		"мёртвые ключи словаря: их не запрашивает ни один экран").Равно("");
	Ожидаем.Что(СтрСоединить(ПотерянныеКосвенныеКлючи(Косвенные), ", "),
		"исключение для ключа, которого в исходниках слоя больше нет: снимите его"
		+ " из КлючиСпрашиваемыеПеременной()").Равно("");

	Ожидаем.Что(Объявленные.Количество(), "каждый ключ словаря объявлен ровно один раз")
		.Равно(ЧислоОбъявленийСловаря());

КонецПроцедуры

&Тест
Процедура СловарьНеГоворитПользователюСловоГрант() Экспорт

	Найденные = Новый Массив();

	Для Каждого Ключ Из UI.СловарьТекстов.Ключи() Цикл
		Текст = UI.СловарьТекстов.НайтиТекст(Ключ);
		Если Текст <> Неопределено И СтрНайти(НРег(Строка(Текст)), "грант") > 0 Тогда
			Найденные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Найденные, ", "),
		"тексты со словом «грант»: переименуйте на «право доступа» (В-1)").Равно("");

КонецПроцедуры

// Граница сторожа — ТЕКСТ, который читают глазами: через словарь проходит вся выдача
// интерфейса. Имена ключей словаря, поля форм, операции, типы событий, колонки сущностей
// и поля API остаются английскими: они внешние. Описания событий сторожит их же набор
// (tests/КаталогСобытий_Тесты.os).
&Тест
Процедура ПользовательскиеТекстыНеГоворятYank() Экспорт

	Найденные = Новый Массив();

	Для Каждого Ключ Из UI.СловарьТекстов.Ключи() Цикл
		Текст = UI.СловарьТекстов.НайтиТекст(Ключ);
		Если Текст <> Неопределено И СтрНайти(НРег(Строка(Текст)), "yank") > 0 Тогда
			Найденные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Найденные, ", "),
		"тексты со словом «yank»: пользователю пишем «отзыв» и «отозвать»").Равно("");

	// самотест: сканируем наполненный словарь, а не пустой список
	Ожидаем.Что(UI.СловарьТекстов.Ключи().Количество() > 50, "словарь прочитан").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтдающиеHTMLОтветчикиЭкранируютСообщениеСами() Экспорт

	Итог = НовыйИтогОтветчиков();
	ФайлыКлассов = НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Истина);

	Для Каждого Файл Из ФайлыКлассов Цикл
		РазложитьОтветчиков(Исходники.Текст(Файл.ПолноеИмя), Файл.Имя, Итог);
	КонецЦикла;

	Двойные = Новый Массив();
	Для Каждого Файл Из ФайлыКлассов Цикл
		Текст = Исходники.Текст(Файл.ПолноеИмя);
		Для Каждого Вызов Из ВызовыОтветчиков(Текст) Цикл
			Если Итог.Сырые.Найти(Вызов.Имя) <> Неопределено
				И СтрНайти(Вызов.Аргументы, "Экранировать(") > 0 Тогда
				Двойные.Добавить(Файл.Имя + ":" + Вызов.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Итог.Сырые.Количество() > 5,
		"скан вообще находит ответчиков на сыром входе (нашёл "
		+ Итог.Сырые.Количество() + ")").ЭтоИстина();
	// ответчиков НА ДОВЕРЕННОЙ РАЗМЕТКЕ в дереве может не остаться вовсе, и это хороший
	// исход: экран, собранный деревом, отдаёт элемент, а не готовую строку. Умение скана
	// отличать такой контракт от сырого доказывает образец ниже, а не состав продукта
	Ожидаем.Что(СтрСоединить(Итог.БезЭкранирования, ", "),
		"ответчики, не экранирующие Сообщение: контракт слоя — экранирует ПОЛУЧАТЕЛЬ").Равно("");
	Ожидаем.Что(СтрСоединить(Итог.ЛишнееЭкранирование, ", "),
		"СообщениеHTML экранировать нельзя: разметка вызывающего станет «&lt;a»").Равно("");
	Ожидаем.Что(СтрСоединить(Двойные, ", "),
		"вызовы, экранирующие аргумент: получатель экранирует сам, будет «&amp;lt;»").Равно("");

	Проба = НовыйИтогОтветчиков();
	РазложитьОтветчиков(ОбразецОтветчиков(), "образец", Проба);

	Ожидаем.Что(Проба.Сырые.Количество(),
		"в образце два ответчика на сыром входе (забывший и компонентный)").Равно(2);
	Ожидаем.Что(Проба.Доверенные.Количество(), "и один на доверенной разметке").Равно(1);
	Ожидаем.Что(СтрСоединить(Проба.БезЭкранирования, ", "),
		"скан видит ответчика, забывшего экранировать Сообщение, но НЕ компонентную форму")
		.Равно("образец:ОтдатьПробуНеНайдено");
	Ожидаем.Что(СтрСоединить(Проба.ЛишнееЭкранирование, ", "),
		"и ответчика, экранирующего доверенную разметку").Равно("образец:ОтдатьПробуДоверенное");

КонецПроцедуры

