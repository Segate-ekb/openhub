	Ожидаем.Что(СтрНайти(HTML, "<code>opm install winow</code>") > 0, "команда видна текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-copy=""opm install winow""") > 0, "кнопка копирует ту же строку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "скриптов нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "onclick"), "инлайн-обработчиков нет").Равно(0);

	СПояснением = UI.БлокКоманды.Отрисовать(Новый Структура("Команда, Пояснение",
		"opm push mylib-1.0.0.ospx", "Выполните в каталоге пакета:"));
	Ожидаем.Что(СтрНайти(СПояснением, "cmd__note") > 0, "пояснение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СПояснением, "Выполните в каталоге пакета:")
		< СтрНайти(СПояснением, "<div class=""cmd"""), "пояснение печатается перед блоком").ЭтоИстина();

	Без = UI.БлокКоманды.Отрисовать(Новый Структура("Команда, БезКопирования", "opm install winow", Истина));
	Ожидаем.Что(СтрНайти(Без, "data-copy"), "кнопку можно убрать").Равно(0);

