	Ожидаем.Что(СтрНайти(HTML, "title=""автор""") > 0, "метаданные — тем же значком, что и в карточке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""visually-hidden"">автор: </span>alice") > 0,
