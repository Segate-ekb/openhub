Функция ТриШага()
	Шаги = Новый Массив();
	Шаги.Добавить(Новый Структура("Заголовок, Пояснение, Выполнен, Текущий",
		"Создать администратора", "Мастер закрывается после первого пользователя", Истина, Ложь));
	Шаги.Добавить(Новый Структура("Заголовок, Выполнен, Текущий, Адрес, ПодписьСсылки",
		"Выпустить токен публикации", Ложь, Истина, "/me/settings/tokens", "Мои токены"));
	Шаги.Добавить(Новый Структура("Заголовок, Выполнен, Текущий",
		"Опубликовать первую версию", Ложь, Ложь));
	Возврат Шаги;
КонецФункции

Функция Варианты(Знач Первый, Знач Второй)
	Список = Новый Массив();
	Список.Добавить(Новый Структура("Значение, Подпись", Первый, Первый));
	Список.Добавить(Новый Структура("Значение, Подпись", Второй, Второй));
	Возврат Список;
КонецФункции

Функция ЧислоВхождений(Знач Текст, Знач Фрагмент)

	Количество = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Фрагмент);

	Пока Позиция > 0 Цикл
		Количество = Количество + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Фрагмент));
		Позиция = СтрНайти(Хвост, Фрагмент);
	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция ТелоФормыИзРазметки(Знач HTML)

	Части = Новый Массив();
	Позиция = СтрНайти(HTML, "<input");

	Пока Позиция > 0 Цикл

		Хвост = Сред(HTML, Позиция);
		КонецТега = СтрНайти(Хвост, ">");
		Если КонецТега = 0 Тогда
			Прервать;
		КонецЕсли;
		Тег = Лев(Хвост, КонецТега);

		Имя = АтрибутТега(Тег, "name");
		Значение = АтрибутТега(Тег, "value");
		ЭтоФлажок = СтрНайти(Тег, "type=""checkbox""") > 0;
		Отмечен = СтрНайти(Тег, " checked") > 0;
		Заблокирован = СтрНайти(Тег, " disabled") > 0;

		Отправляется = ЗначениеЗаполнено(Имя) И НЕ Заблокирован И (НЕ ЭтоФлажок ИЛИ Отмечен);
		Если Отправляется Тогда
			Части.Добавить(Имя + "=" + Значение);
		КонецЕсли;

		Смещение = Позиция + КонецТега;
		Следующая = СтрНайти(Сред(HTML, Смещение), "<input");
		Позиция = ?(Следующая = 0, 0, Смещение + Следующая - 1);

	КонецЦикла;

	Возврат СтрСоединить(Части, "&");

КонецФункции

Функция АтрибутТега(Знач Тег, Знач Имя)

	Маркер = " " + Имя + "=""";
	Начало = СтрНайти(Тег, Маркер);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Тег, Начало + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

