КонецПроцедуры

#КонецОбласти

#Область Таблица

&Тест
Процедура ТаблицаРисуетШапкуИСтроки() Экспорт

	Колонки = Новый Массив();
	Колонки.Добавить("Версия");
	Колонки.Добавить("Дата");

	Строка1 = Новый Массив();
	Строка1.Добавить("1.0.0");
	Строка1.Добавить("2026-07-27");

	Строки = Новый Массив();
	Строки.Добавить(Строка1);

	HTML = UI.Таблица.Отрисовать(Новый Структура("Колонки, Строки", Колонки, Строки));

	Ожидаем.Что(СтрНайти(HTML, "<th scope=""col"">Версия</th>") > 0, "заголовок колонки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td>1.0.0</td>") > 0, "ячейка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТаблицаЭкранируетЯчейкиИПропускаетДоверенныйHTML() Экспорт

	Строка1 = Новый Массив();
	Строка1.Добавить("<script>alert(1)</script>");
	Строка1.Добавить(Новый Структура("HTML", "<a href=""/x"">ссылка</a>"));

	Строки = Новый Массив();
	Строки.Добавить(Строка1);

	HTML = UI.Таблица.Отрисовать(Новый Структура("Колонки, Строки", Новый Массив(), Строки));

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "текст ячейки экранирован").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<a href=""/x"">ссылка</a>") > 0, "доверенная ячейка вставлена").ЭтоИстина();

КонецПроцедуры

// Довесок строки печатается ОТДЕЛЬНЫМ рядом во всю ширину: ради этого он и заведён —
// в ячейке ряда колонок содержимому достаётся пара пикселей. Ширина считается по шапке,
// а без шапки — по самой длинной строке: colspan="1" съёжил бы разворот в одну колонку.
&Тест
Процедура СтрокаСРазворотомПечатаетсяОтдельнымРядомВоВсюШирину() Экспорт

	Колонки = Новый Массив();
	Колонки.Добавить("Когда");
	Колонки.Добавить("Кто");
	Колонки.Добавить("Что");

	Ячейки = Новый Массив();
	Ячейки.Добавить("вчера");
	Ячейки.Добавить("root");
	Ячейки.Добавить("сделал");

	Обычная = Новый Массив();
	Обычная.Добавить("позавчера");
	Обычная.Добавить("система");
	Обычная.Добавить("сделала");

	Строки = Новый Массив();
	Строки.Добавить(Новый Структура("Ячейки, Разворот", Ячейки,
		"<details><summary>Подробнее</summary><p>разворот</p></details>"));
	Строки.Добавить(Обычная);

	HTML = UI.Таблица.Отрисовать(Новый Структура("Колонки, Строки", Колонки, Строки));

	// Порядок рядов — инвариант: разворот идёт СЛЕДУЮЩИМ рядом за своей записью.
	// Перестановка оставляет обе половины на месте, и раздельные проверки её не видят,
	// а пользователь видит детали НАД своей записью, разделитель между деталями и их же
	// записью и подсветку, уехавшую на соседа. Проверяется соседство РЯДОВ, а не байты
	// между ними: перевод строки между </tr> и <tr> ни браузеру, ни комбинатору «+»
	// не мешает, и краснеть на нём — стеречь форму записи вместо инварианта.
	НачалоЗаписи = СтрНайти(HTML, "<tr class=""table__record"">");
	Ожидаем.Что(НачалоЗаписи > 0, "запись с разворотом помечена: " + HTML).ЭтоИстина();

	ПослеЗаписи = Сред(HTML, НачалоЗаписи + СтрДлина("<tr class=""table__record"">"));
	СледующийРяд = СтрНайти(ПослеЗаписи, "<tr");
	Ожидаем.Что(СледующийРяд > 0, "после записи в таблице есть ещё ряд").ЭтоИстина();
	Ожидаем.Что(Лев(Сред(ПослеЗаписи, СледующийРяд), СтрДлина("<tr class=""table__expand""")),
		"следующий за записью ряд — её разворот, а не что-то ещё: " + HTML)
		.Равно("<tr class=""table__expand""");

	// довесок вставлен доверенно и целиком, во всю ширину таблицы: разорванный между
	// рядами <details> не раскроется, а colspan="1" съёжит разворот в одну колонку
	Ожидаем.Что(СтрНайти(HTML, "<td colspan=""3""><details><summary>Подробнее</summary>"
			+ "<p>разворот</p></details></td>") > 0,
		"разворот занял все колонки и приехал целым: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<tr class=""table__record""><td>вчера</td>") > 0,
		"ячейки записи на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<tr><td>позавчера</td>") > 0,
		"строка-массив осталась обычной строкой").ЭтоИстина();

	// пустой разворот ряда не даёт вовсе: пустая строка таблицы читается как поломка
	Пустой = UI.Таблица.Отрисовать(Новый Структура("Колонки, Строки", Колонки,
		СтрокиТаблицы(Новый Структура("Ячейки, Разворот", Ячейки, ""))));
	Ожидаем.Что(СтрНайти(Пустой, "colspan"), "пустой разворот ряда не печатает").Равно(0);
	Ожидаем.Что(СтрНайти(Пустой, "<tr><td>вчера</td>") > 0,
		"а сама запись остаётся обычной строкой").ЭтоИстина();

	// без шапки ширину считать не по чему, кроме строк
	БезШапки = UI.Таблица.Отрисовать(Новый Структура("Колонки, Строки", Новый Массив(),
		СтрокиТаблицы(Новый Структура("Ячейки, Разворот", Ячейки, "<p>разворот</p>"))));
	Ожидаем.Что(СтрНайти(БезШапки,
			"<tr class=""table__expand""><td colspan=""3""><p>разворот</p></td></tr>") > 0,
		"ширина взята по самой длинной строке: " + БезШапки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПустаяТаблицаДаётСообщение() Экспорт
	HTML = UI.Таблица.Отрисовать(Новый Структура("Колонки, Строки, Пусто",
		Новый Массив(), Новый Массив(), "Версий пока нет"));
	Ожидаем.Что(СтрНайти(HTML, "Версий пока нет") > 0, "текст пустоты").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<table"), "таблицы нет").Равно(0);
КонецПроцедуры

