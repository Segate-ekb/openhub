КонецПроцедуры

&Тест
Процедура ДеревоЭкранируетПодписиИОтбрасываетОпасныйАдрес() Экспорт

	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес", "<script>alert(1)</script>", "javascript:alert(1)"));

	HTML = UI.ДеревоРазделов.Отрисовать(Новый Структура("Разделы", Разделы));

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "подпись экранирована").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасный адрес не стал ссылкой").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "tree__link--plain") > 0, "пункт остался без ссылки").ЭтоИстина();

КонецПроцедуры

