#КонецОбласти

#Область ЭкранированиеАтрибутов

&Тест
Процедура АтрибутОтклоняетОпасноеИмя() Экспорт

	Опасные = Новый Массив();
	Опасные.Добавить("class onmouseover=alert(1)");
	Опасные.Добавить("onclick");           // допустимое по формату, но см. ниже
	Опасные.Добавить("data-x""><script");
	Опасные.Добавить("id=x onfocus=alert(1)");
	Опасные.Добавить("класс");             // кириллица — не имя атрибута HTML
	Опасные.Добавить(" class");
	Опасные.Добавить("2data");

	Для Каждого Имя Из Опасные Цикл
		HTML = UI.Экран.Атрибут(Имя, "значение") + UI.Экран.БулевАтрибут(Имя, Истина);
		Если Имя = "onclick" Тогда
			Продолжить; // формат корректен: запрет обработчиков — забота вызывающего
		КонецЕсли;
		Ожидаем.Что(HTML, СтрШаблон("имя «%1» отвергнуто целиком", Имя)).Равно("");
	КонецЦикла;

	Ожидаем.Что(UI.Экран.Атрибут("class", "card")).Равно(" class=""card""");
	Ожидаем.Что(UI.Экран.Атрибут("data-copy", "opm install winow")).Равно(" data-copy=""opm install winow""");
	Ожидаем.Что(UI.Экран.Атрибут("aria-label", "Разделы")).Равно(" aria-label=""Разделы""");
	Ожидаем.Что(UI.Экран.БулевАтрибут("disabled", Истина)).Равно(" disabled");
	Ожидаем.Что(UI.Экран.БулевАтрибут("disabled", Ложь)).Равно("");

	Ожидаем.Что(СтрНайти(UI.Экран.Атрибут("class", """ onmouseover=""alert(1)"), """ onmouseover="),
		"кавычка значения экранирована").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПередачаКукВРендерер

&Тест
Процедура ВсеВызовыСтраницыПередаютКукиЗапроса() Экспорт

	Нарушители = Новый Массив();

	Для Каждого Модуль Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src", "модули"), "*", Ложь) Цикл

		Каталог = ОбъединитьПути(Модуль.ПолноеИмя, "Классы");
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Файл Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			Текст = Исходники.Текст(Файл.ПолноеИмя);
			Для Каждого Вызов Из ВызовыСтраницы(Текст) Цикл
				Если СтрНайти(Вызов, "Контекст") = 0 И СтрНайти(Вызов, "Куки") = 0 Тогда
					Нарушители.Добавить(Файл.Имя + " (вызов Страница без контекста)");
				КонецЕсли;
			КонецЦикла;
			Для Каждого Вызов Из ВызовыКонтекста(Текст) Цикл
				Если СтрНайти(Вызов, "Куки") = 0 Тогда
					Нарушители.Добавить(Файл.Имя + " (контекст без кук запроса)");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"вызовы Страница()/КонтекстСтраницы() без кук запроса").Равно("");

КонецПроцедуры

