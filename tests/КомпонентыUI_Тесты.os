КонецПроцедуры

&Тест
Процедура ПагинацияБезОсновыИСОпаснойСхемойПадает() Экспорт

	Векторы = Новый Массив();
	Векторы.Добавить(Новый Структура("Причина, Модель", "Основа",
		Новый Структура("Страница, ВсегоСтраниц", 2, 5)));
	Векторы.Добавить(Новый Структура("Причина, Модель", "схема",
		Новый Структура("Страница, ВсегоСтраниц, Основа", 2, 5, "javascript:alert(1)")));
	Векторы.Добавить(Новый Структура("Причина, Модель", "Основа",
		Новый Структура("Страница, ВсегоСтраниц", 1, 1))); // одна страница — гейт всё равно работает

	Для Каждого Вектор Из Векторы Цикл
		Поймано = Ложь;
		Попытка
			UI.Пагинация.Отрисовать(Вектор.Модель);
		Исключение
			Поймано = Истина;
			Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Пагинация") > 0, "ошибка называет компонент").ЭтоИстина();
			Ожидаем.Что(СтрНайти(ОписаниеОшибки(), Вектор.Причина) > 0,
				"ошибка называет ПРИЧИНУ: " + Вектор.Причина).ЭтоИстина();
		КонецПопытки;
		Ожидаем.Что(Поймано, "негодная основа отвергнута: " + Вектор.Причина).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(UI.Пагинация.Отрисовать(
		Новый Структура("Страница, ВсегоСтраниц, Основа", 1, 1, "/packages"))).Равно("");

КонецПроцедуры

