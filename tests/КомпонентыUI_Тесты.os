			"контейнер «" + Селектор + "» задаёт интервал сам: " + Правила[0]).ЭтоИстина();

		Ожидаем.Что(СтрНайти(Правила[0], "display: flex") > 0,
			"интервал через gap требует flex у «" + Селектор + "»: " + Правила[0]).ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

// Владелец увидел на скриншоте «плашку и случайно оказавшуюся рядом кнопку»: кит выдаёт
// крестику полный набор кнопки (рамка, свой акцентный цвет, глиф 18px), а группировку
// съедали её собственные паддинги. Правила ниже — и есть починка, поэтому они под сторожем.
// Стиль тега хранится КЛЮЧОМ, а цвет ему даёт токен темы — значит цвет обязан быть
// читаемым в ОБЕИХ темах. 4.5:1 сразу к обеим недостижим (окно яркости пусто: нижняя
// граница 0.239 выше верхней 0.148), поэтому порог — 3:1, как для нетекстовых элементов.
&Тест
Процедура ЦветаСтилейПлашкиЧитаютсяВОбеихТемах() Экспорт

	Токены = UI.Токены;
	Порог = 3;

	// значения вычитаны из самих палитр, а не продублированы в тесте. Переменные() печатает
	// ОБЕ темы сразу: тёмную в :root, светлую в html[data-theme="light"] — разбираем по частям
	Весь = Токены.Переменные();
	Граница = СтрНайти(Весь, "html[data-theme=""light""]");
	Ожидаем.Что(Граница > 0, "в выдаче есть блок светлой темы").ЭтоИстина();
	Тёмная = ЗначенияПеременных(Лев(Весь, Граница - 1));
	Светлая = ЗначенияПеременных(Сред(Весь, Граница));

	Токен = Новый Массив();
	Токен.Добавить("--color-text-muted");  // стиль «обычный»
	Токен.Добавить("--color-success");     // «стабильный»
	Токен.Добавить("--color-warning");     // «предварительный»
	Токен.Добавить("--color-danger");      // «устаревший»
	Токен.Добавить("--color-accent");      // «особый»

	Плохие = Новый Массив();
	Для Каждого Имя Из Токен Цикл

		ЦветТёмной = Тёмная.Получить(Имя);
		ЦветСветлой = Светлая.Получить(Имя);
		Ожидаем.Что(ЗначениеЗаполнено(ЦветТёмной) И ЗначениеЗаполнено(ЦветСветлой),
			"токен " + Имя + " объявлен в обеих палитрах").ЭтоИстина();

		КТёмной = Токены.КоэффициентКонтраста(ЦветТёмной, Токены.ПоверхностьПлашки(Ложь));
		КСветлой = Токены.КоэффициентКонтраста(ЦветСветлой, Токены.ПоверхностьПлашки(Истина));

		Если КТёмной < Порог ИЛИ КСветлой < Порог Тогда
			Плохие.Добавить(СтрШаблон("%1 (тёмная %2, светлая %3)", Имя,
				Формат(КТёмной, "ЧДЦ=2"), Формат(КСветлой, "ЧДЦ=2")));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Плохие, ", "),
		"стили, чей цвет сливается с плашкой хотя бы в одной теме").Равно("");

	// самотест арифметики: чёрным по тёмной плашке читать нельзя, и проверка это видит
	Ожидаем.Что(Токены.КоэффициентКонтраста("#000000", Токены.ПоверхностьПлашки(Ложь)) < Порог,
		"чёрное на тёмной — заведомо ниже порога").ЭтоИстина();
	Ожидаем.Что(Токены.КоэффициентКонтраста("#ffffff", Токены.ПоверхностьПлашки(Истина)) < Порог,
		"белое на светлой — тоже").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КрестикСнятияЧитаетсяЧастьюПлашкиАНеОтдельнойКнопкой() Экспорт

	Текст = ТекстCSS();

	// ГЛАВНОЕ: крестик печатается ВНУТРИ элемента плашки — перенос строки не может
	// оторвать его от подписи, к которой он относится
	Плашка = UI.Плашка.Отрисовать(Новый Структура("Текст, Вид, Действие",
		"lts", "accent", КрестикПлашки()));

	Ожидаем.Что(СтрНачинаетсяС(Плашка, "<span class=""tag tag--accent""") И СтрЗаканчиваетсяНа(Плашка, "</span>"),
		"плашка осталась ОДНИМ элементом: " + Плашка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Плашка, "lts<span class=""tag__action""><button") > 0,
		"крестик — ребёнок плашки сразу за подписью, а не сосед: " + Плашка).ЭтоИстина();
	// самопроверка: без Действия внутри плашки лишнего узла нет
	Ожидаем.Что(СтрНайти(UI.Плашка.Отрисовать(Новый Структура("Текст", "lts")), "tag__action"),
		"плашка без действия крестика не печатает").Равно(0);

	// плашка-ссылка с крестиком — ошибка сборки экрана: кнопка внутри <a> не нажимается
	Упало = Ложь;
	Попытка
		UI.Плашка.Отрисовать(Новый Структура("Текст, Адрес, Действие",
			"lts", "/main", КрестикПлашки()));
	Исключение
		Упало = СтрНайти(ОписаниеОшибки(), "несовместимо с Адресом") > 0;
	КонецПопытки;
	Ожидаем.Что(Упало, "плашка-ссылка с действием отвергнута с внятной причиной").ЭтоИстина();

	Крестик = ОбъявленияПравилаCSS(Текст, ".tag__action .button");
	Ожидаем.Что(Крестик.Количество(), "на «.tag__action .button» РОВНО одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Крестик[0], "border: 0") > 0,
		"собственной рамки у крестика нет: " + Крестик[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Крестик[0], "background: none") > 0,
		"собственного фона в покое нет: " + Крестик[0]).ЭтоИстина();

	// цвет НАЗНАЧЕН явно и служебный: акцент кита и цвета самого тега сюда не доезжают
	Ожидаем.Что(СтрНайти(Крестик[0], "color: var(--color-text-muted)") > 0,
		"крестик служебного цвета, а не акцентного и не тегового: " + Крестик[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Крестик[0], "currentColor"),
		"currentColor подтянул бы цвет плашки: " + Крестик[0]).Равно(0);

	Глиф = ОбъявленияПравилаCSS(Текст, ".tag__action .button .icon");
	Ожидаем.Что(Глиф.Количество(), "на глиф крестика РОВНО одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Глиф[0], "width: 12px") > 0,
		"глиф мельче кнопочных 18px кита: " + Глиф[0]).ЭтоИстина();
	// сверяемся с китом, а не с числом в тесте: подрастёт кнопка — крестик обязан остаться мельче
	Ожидаем.Что(СтрНайти(ОбъявленияПравилаCSS(Текст, ".button--icon .icon")[0], "width: 18px") > 0,
		"кит по-прежнему рисует кнопочный глиф крупнее").ЭтоИстина();

	// реакция на мышь И на клавиатуру: крестик — кнопка, по ней ходят табом
	Наведение = ОбъявленияПравилаCSS(Текст, ".tag__action .button:hover");
	Ожидаем.Что(Наведение.Количество(), "у крестика есть состояние наведения").Равно(1);
	Фокус = ОбъявленияПравилаCSS(Текст, ".tag__action .button:focus-visible");
	Ожидаем.Что(Фокус.Количество(), "у крестика есть видимый фокус").Равно(1);

КонецПроцедуры

Функция КрестикПлашки()
	Возврат UI.Кнопка.Отрисовать(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, ТолькоИконка",
		"Снять метку lts", "ссылка", "малый", "закрыть", Истина));
КонецФункции

