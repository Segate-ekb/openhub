// Юнит-тесты слоя представления: контракт каждого компонента кита и хабовых экранов,
// регресс на XSS, токены темы, версионированная статика, работоспособность без JS,
// ритм форм и запрет хардкода цветов. Корпус слоя перечисляет МодулиСлоя().

#Использовать asserts
#Использовать html-sanitizer
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем UI;               // Структура компонентов (фикстура СборкаUI)
Перем Поиск;            // КлассыСлоя — resolver файла класса по имени (подкаталоги 6.B)
Перем КаталогПроекта;
Перем КаталогКлассов;
Перем РазборCSS;        // фикстура РитмФорм — единственный разбор таблицы стилей в слое

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

КонецПроцедуры

&ПередВсеми
Процедура СобратьКомпоненты() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "интерфейс", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();

	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("РитмФорм");
	РеестрФикстур.Подключить("РядИнлайнов");
	РеестрФикстур.Подключить("КукиЗаглушка");
	Поиск.Подключить(КаталогКлассов, "РазборФормы");
	Поиск.Подключить(КаталогКлассов, "КонтроллерОформления");
	РеестрФикстур.Подключить("СловарьТекстовЗаглушка");
	Поиск.Подключить(КаталогКлассов, "РендерерКабинета");
	РеестрФикстур.Подключить("ФейкОкруженияВитрины");
	Поиск.Подключить(КаталогКлассов, "ВитринаПакетов");
	Поиск.Подключить(КаталогКлассов, "ОформлениеХаба");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	UI = Новый СборкаUI().Собрать(КаталогКлассов);

КонецПроцедуры

#Область РендерерКабинета

&Тест
Процедура ПримечаниеПропускаетДоверенныйHTMLКакЕсть() Экспорт

	Рендерер = Новый РендерерКабинета(Неопределено, UI.Экран, Неопределено, UI.Набор, UI.Тексты);

	HTML = Рендерер.Примечание("<code>oidc</code>");
	Ожидаем.Что(СтрНайти(HTML, "<code>oidc</code>") > 0,
		"доверенная разметка вставлена без экранирования").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "&lt;code&gt;"),
		"доверенное не экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "class=""muted""") > 0, "обёртка на месте").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Карточка

&Тест
Процедура КарточкаСобираетЗаголовокОписаниеИТело() Экспорт

	HTML = UI.Карточка.Отрисовать(Новый Структура("Заголовок, Описание, Тело, Действия",
		"Пул main", "Основной пул хаба", "<p>тело</p>", "<button>ок</button>"));

	Ожидаем.Что(СтрНайти(HTML, "<section class=""card"">") > 0, "секция карточки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Пул main") > 0, "заголовок").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Основной пул хаба") > 0, "описание").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<p>тело</p>") > 0, "доверенное тело вставлено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "card__actions") > 0, "полоса действий").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КарточкаЭкранируетЗаголовокИОписание() Экспорт

	HTML = UI.Карточка.Отрисовать(Новый Структура("Заголовок, Описание",
		"<script>alert(1)</script>", "<img src=x onerror=alert(2)>"));

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "тег script не просочился").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "тег img с обработчиком не просочился").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0, "заголовок выведен экранированным").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КарточкаБезЗаголовкаНеРисуетПустуюШапку() Экспорт
	HTML = UI.Карточка.Отрисовать(Новый Структура("Тело", "<p>x</p>"));
	Ожидаем.Что(СтрНайти(HTML, "card__title"), "пустого заголовка нет").Равно(0);
КонецПроцедуры

// Якорь делает карточку целью ссылки на той же странице — без него плитка «пулов»
// на главной вести никуда не может.
&Тест
Процедура КарточкаПринимаетЯкорьИНеПечатаетЕгоПустым() Экспорт

	HTML = UI.Карточка.Отрисовать(Новый Структура("Заголовок, Якорь, Тело",
		"Пулы хаба", "pools", "<p>x</p>"));

	Ожидаем.Что(СтрНайти(HTML, "id=""pools""") > 0, "якорь стал атрибутом id").ЭтоИстина();
	Ожидаем.Что(СтрНайти(UI.Карточка.Отрисовать(Новый Структура("Заголовок", "Без якоря")), " id="),
		"без якоря атрибута нет").Равно(0);

КонецПроцедуры

// Ряд карточек читается как ряд: соседи одной высоты, разделитель и кнопки на одной линии
// при описаниях разной длины. Держится это двумя правилами — карточка в ячейке сетки
// колонка на всю высоту, полоса действий прижата к низу; без них ряд разъезжается
// (дом пользователя: описание в три строки опускало кнопку на 23 px ниже соседних).
&Тест
Процедура КарточкаВЯчейкеСеткиТянетсяНаРядИПрижимаетДействияКНизу() Экспорт

	Текст = ТекстCSS();

	ВСетке = ОбъявленияПравилаCSS(Текст, ".grid__cell > .card");
	Ожидаем.Что(ВСетке.Количество(), "на «.grid__cell > .card» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(ВСетке[0], "display: flex") > 0,
		"карточка в сетке — колонка: " + ВСетке[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВСетке[0], "flex-direction: column") > 0, "именно колонка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВСетке[0], "height: 100%") > 0,
		"и занимает ячейку целиком — иначе высоты соседей разные").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ВСетке[0], "margin-bottom: 0") > 0,
		"собственный нижний маргин в сетке снят: интервал рядов держит её gap").ЭтоИстина();

	Действия = ОбъявленияПравилаCSS(Текст, ".grid__cell > .card > .card__actions");
	Ожидаем.Что(Действия.Количество(),
		"на «.grid__cell > .card > .card__actions» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Действия[0], "margin-top: auto") > 0,
		"полоса действий прижата к низу карточки: " + Действия[0]).ЭтоИстина();

	// вне сетки карточка остаётся блоком потока: одиночную растягивать не во что,
	// а margin-top: auto без флекса схлопнулся бы в ноль и убрал зазор над разделителем
	Обычная = ОбъявленияПравилаCSS(Текст, ".card");
	Ожидаем.Что(Обычная.Количество(), "на «.card» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Обычная[0], "display: flex"),
		"обычная карточка не флекс: " + Обычная[0]).Равно(0);
	Ожидаем.Что(СтрНайти(Обычная[0], "height:"), "и высоты себе не назначает").Равно(0);

	Полоса = ОбъявленияПравилаCSS(Текст, ".card__actions");
	Ожидаем.Что(Полоса.Количество(), "на «.card__actions» ровно одно правило").Равно(1);
	Ожидаем.Что(СтрНайти(Полоса[0], "margin-top: var(--space-4)") > 0,
		"вне сетки полоса держит свой отступ, а не auto: " + Полоса[0]).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Поле

&Тест
Процедура ПолеРисуетПодписьЗначениеИПодсказку() Экспорт

	HTML = UI.Поле.Отрисовать(Новый Структура("Имя, Метка, Значение, Подсказка, Обязательное",
		"имя_пула", "Имя пула", "main", "латиница и дефис", Истина));

	Ожидаем.Что(СтрНайти(HTML, "name=""имя_пула""") > 0, "имя поля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Имя пула") > 0, "подпись").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""main""") > 0, "значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "required") > 0, "обязательность").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "латиница и дефис") > 0, "подсказка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолеЭкранируетЗначениеВАтрибуте() Экспорт

	HTML = UI.Поле.Отрисовать(Новый Структура("Имя, Метка, Значение",
		"x", "Метка <b>", """ onfocus=""alert(1)"));

	Ожидаем.Что(СтрНайти(НРег(HTML), """ onfocus="), "атрибут не вырвался наружу").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&quot;") > 0, "кавычка экранирована").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Метка <b>"), "сырой тег в подписи вырезан").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолеПоддерживаетТипыИВарианты() Экспорт

	Флажок = UI.Поле.Отрисовать(Новый Структура("Имя, Тип, Отмечено", "публичный", "флажок", Истина));
	Ожидаем.Что(СтрНайти(Флажок, "type=""checkbox""") > 0, "флажок").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Флажок, "checked") > 0, "отмечен").ЭтоИстина();

	Много = UI.Поле.Отрисовать(Новый Структура("Имя, Тип, Значение", "описание", "многострочное", "текст"));
	Ожидаем.Что(СтрНайти(Много, "<textarea") > 0, "многострочное").ЭтоИстина();

	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("Значение, Подпись", "local", "Локальный"));
	Варианты.Добавить(Новый Структура("Значение, Подпись", "proxy", "Прокси"));
	Выбор = UI.Поле.Отрисовать(Новый Структура("Имя, Тип, Значение, Варианты", "тип", "выбор", "proxy", Варианты));
	Ожидаем.Что(СтрНайти(Выбор, "<select") > 0, "выбор").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Выбор, "<option value=""proxy"" selected>") > 0, "выбранный вариант").ЭтоИстина();

	// вариант «ничего не выбрано» — обычный вариант с ПУСТЫМ значением: без атрибута value
	// браузер отправил бы на сервер подпись, а не ключ
	СПустым = Новый Массив();
	СПустым.Добавить(Новый Структура("Значение, Подпись", "", "Без значка"));
	СПустым.Добавить(Новый Структура("Значение, Подпись", "lock", "Замок"));
	Пустой = UI.Поле.Отрисовать(Новый Структура("Имя, Тип, Значение, Варианты",
		"значок", "выбор", "", СПустым));
	Ожидаем.Что(СтрНайти(Пустой, "<option value="""" selected>Без значка</option>") > 0,
		"пустой вариант печатает value и выбран пустым значением: " + Пустой).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Пустой, "<option value=""lock"">") > 0,
		"остальные варианты не помечены выбранными: " + Пустой).ЭтоИстина();

	// вариант несёт свои data-атрибуты: ими вызывающий объявляет соответствие «значение —
	// его показ», и прогрессивное улучшение читает их с выбранного <option>
	Данные = Новый Соответствие();
	Данные.Вставить("data-chip-view", "ok");
	СДанными = Новый Массив();
	СДанными.Добавить(Новый Структура("Значение, Подпись, Данные", "stable", "Стабильный", Данные));
	Помеченный = UI.Поле.Отрисовать(Новый Структура("Имя, Тип, Значение, Варианты",
		"стиль", "выбор", "stable", СДанными));
	Ожидаем.Что(СтрНайти(Помеченный, "data-chip-view=""ok""") > 0,
		"data-атрибут варианта напечатан: " + Помеченный).ЭтоИстина();

КонецПроцедуры

// У одиночного <select> выбранных вариантов не бывает двух: браузер берёт ПОСЛЕДНИЙ,
// а любой разбор разметки — первый, и одна и та же страница читается по-разному. Флаг
// варианта и совпадение значения поля — два независимых источника пометки, и без этого
// сторожа они складываются молча.
&Тест
Процедура ВыборПомечаетРовноОдинВариант() Экспорт

	// явный флаг и совпадение значения указывают на РАЗНЫЕ варианты
	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("Значение, Подпись", "", "по умолчанию"));
	Варианты.Добавить(Новый Структура("Значение, Подпись, Выбрано", "self", "Свой", Истина));

	Разметка = UI.Поле.Отрисовать(Новый Структура("Имя, Тип, Варианты",
		"издатель", "выбор", Варианты));

	Ожидаем.Что(ЧислоВхождений(Разметка, " selected"), "пометка ровно одна: " + Разметка).Равно(1);
	Ожидаем.Что(СтрНайти(Разметка, "<option value=""self"" selected>") > 0,
		"и она у варианта с явным флагом, а не у пустого: " + Разметка).ЭтоИстина();

	// без явных флагов пустое значение поля по-прежнему предвыбирает пустой вариант
	БезФлагов = Новый Массив();
	БезФлагов.Добавить(Новый Структура("Значение, Подпись", "", "Без значка"));
	БезФлагов.Добавить(Новый Структура("Значение, Подпись", "lock", "Замок"));
	Пустое = UI.Поле.Отрисовать(Новый Структура("Имя, Тип, Значение, Варианты",
		"значок", "выбор", "", БезФлагов));
	Ожидаем.Что(ЧислоВхождений(Пустое, " selected"), "и здесь пометка одна").Равно(1);
	Ожидаем.Что(СтрНайти(Пустое, "<option value="""" selected>") > 0,
		"на пустом варианте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолеБезИмениНеОтрисовывается() Экспорт

	Типы = Новый Массив();
	Типы.Добавить("текст");
	Типы.Добавить("пароль");
	Типы.Добавить("флажок");
	Типы.Добавить("выбор");
	Типы.Добавить("многострочное");

	Для Каждого Тип Из Типы Цикл
		Упало = Ложь;
		Попытка
			UI.Поле.Отрисовать(Новый Структура("Метка, Тип", "Имя пула", Тип));
		Исключение
			Упало = Истина;
			Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Имя пула") > 0,
				"в ошибке видно, какое поле забыли назвать").ЭтоИстина();
		КонецПопытки;
		Ожидаем.Что(Упало, СтрШаблон("поле типа «%1» без имени отвергнуто", Тип)).ЭтоИстина();
	КонецЦикла;

	Витрина = UI.Поле.Отрисовать(Новый Структура("Метка, Значение, Заблокировано",
		"Каталог данных", "/var/lib/openhub", Истина));
	Ожидаем.Что(СтрНайти(Витрина, "disabled") > 0, "витрина рисуется без имени").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаждоеОтрисованноеУправлениеИмеетName() Экспорт

	Проверено = 0;
	Нарушители = Новый Массив();

	Для Каждого Часть Из UI.Витрина.Разделы() Цикл
		Для Каждого Образец Из Часть.Образцы Цикл
			Для Каждого Управление Из УправленияФормы(Образец.Разметка) Цикл
				Если СтрНайти(Управление, " disabled") > 0 Тогда
					Продолжить; // disabled формой не отправляется
				КонецЕсли;
				Проверено = Проверено + 1;
				Если НЕ ЗначениеЗаполнено(АтрибутТега(Управление, "name")) Тогда
					Нарушители.Добавить(Часть.Ключ + " / " + Образец.Подпись + ": " + Управление);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено >= 8,
		"отправляемых управлений в витрине не меньше восьми: " + Проверено).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушители, "; "),
		"управления формы без непустого name").Равно("");

КонецПроцедуры

&Тест
Процедура ПолеСОшибкойПомечаетсяИОзвучивается() Экспорт
	HTML = UI.Поле.Отрисовать(Новый Структура("Имя, Ошибка", "x", "Имя занято"));
	Ожидаем.Что(СтрНайти(HTML, "field--error") > 0, "класс ошибки").ЭтоИстина();
