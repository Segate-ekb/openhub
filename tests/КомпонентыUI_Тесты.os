	Вкладки.Добавить(Новый Структура("Подпись, Адрес, Активна", "Описание", "/main/winow", Истина));
	Вкладки.Добавить(Новый Структура("Подпись, Адрес, Счётчик", "Версии", "/main/winow/versions", 12));
	Вкладки.Добавить(Новый Структура("Подпись, Адрес", "Зависимости", "/main/winow/deps"));
	Возврат Вкладки;
