	Ожидаем.Что(СтрНайти(HTML, "s3cret"), "секрет не выведен").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "OSHUB_ADMIN_PASSWORD") > 0, "имя переменной показано").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолеИзКонфигаЭкранируетЗначениеИДетальку() Экспорт

	HTML = UI.ПолеИзКонфига.Отрисовать(Новый Структура("Метка, Значение, Деталька, Переменная",
		"X", """><script>alert(1)</script>", "<b>деталька</b>", "OSHUB_X"));

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "скрипт не просочился").Равно(0);
