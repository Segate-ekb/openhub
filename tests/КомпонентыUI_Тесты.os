КонецФункции

Функция Полоса(Знач Процент)
	Возврат UI.ПолосаЗаполнения.Отрисовать(
		Новый Структура("Процент, Метка", Процент, "Заполнение пула"));
КонецФункции

// Тег <html> ровно в том виде, как его печатает каркас страницы. Подстрока
// «data-theme="light"» истинной бывает ВСЕГДА: тем же текстом ТокеныТемы печатают
// селектор светлой палитры в <head> каждой страницы, и сторож на ней тождествен.
Функция ТегHTML(Знач Тема)
	Возврат СтрШаблон("<html lang=""ru"" data-theme=""%1"">", Тема);
КонецФункции

Функция КукиСТемой(Знач Тема)
	Куки = Новый КукиЗаглушка();
	Куки.Добавить(UI.Оформление.ИмяCookie(),
		КодироватьСтроку("тема=" + Тема, СпособКодированияСтроки.КодировкаURL));
	Возврат Куки;
КонецФункции

Функция ВызовыСтраницы(Знач Текст)
	Возврат ВызовыВыражения(Текст, "Рендерер.Страница(");
КонецФункции

Функция ВызовыКонтекста(Знач Текст)
	Возврат ВызовыВыражения(Текст, "КонтекстСтраницы(");
КонецФункции

Функция ВызовыВыражения(Знач Текст, Знач Маркер)

	Очищенный = БезКомментариевИЛитералов(Текст);

	Результат = Новый Массив();
	Позиция = СтрНайти(Очищенный, Маркер);

	Пока Позиция > 0 Цикл

		Начало = Позиция + СтрДлина(Маркер) - 1;
		Глубина = 0;
		Индекс = Начало;

		Пока Индекс <= СтрДлина(Очищенный) Цикл
			Символ = Сред(Очищенный, Индекс, 1);
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" Тогда
				Глубина = Глубина - 1;
				Если Глубина = 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;

		Результат.Добавить(Сред(Очищенный, Начало, Индекс - Начало + 1));

		Хвост = Сред(Очищенный, Индекс + 1);
		Смещение = СтрНайти(Хвост, Маркер);
		Если Смещение = 0 Тогда
			Прервать;
		КонецЕсли;
		Очищенный = Хвост;
		Позиция = Смещение;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БезКомментариевИЛитералов(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл

		Очищенная = "";
		ВСтроке = Ложь;
		Позиция = 1;

		Пока Позиция <= СтрДлина(Строка) Цикл

			Символ = Сред(Строка, Позиция, 1);

			Если ВСтроке Тогда
				Если Символ = """" Тогда
					Если Сред(Строка, Позиция + 1, 1) = """" Тогда
						Позиция = Позиция + 2; // удвоенная кавычка внутри литерала
						Продолжить;
					КонецЕсли;
					ВСтроке = Ложь;
				КонецЕсли;
			ИначеЕсли Символ = """" Тогда
				ВСтроке = Истина;
			ИначеЕсли Символ = "/" И Сред(Строка, Позиция + 1, 1) = "/" Тогда
				Прервать; // дальше комментарий до конца строки
			Иначе
				Очищенная = Очищенная + Символ;
			КонецЕсли;

			Позиция = Позиция + 1;

		КонецЦикла;

		Результат.Добавить(Очищенная);

	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

Функция УправленияФормы(Знач HTML)

	Результат = Новый Массив();

	Теги = Новый Массив();
	Теги.Добавить("<input");
	Теги.Добавить("<select");
	Теги.Добавить("<textarea");

	Для Каждого Тег Из Теги Цикл
		Хвост = HTML;
		Позиция = СтрНайти(Хвост, Тег);
		Пока Позиция > 0 Цикл
			Фрагмент = Сред(Хвост, Позиция);
			Конец = СтрНайти(Фрагмент, ">");
			Результат.Добавить(Лев(Фрагмент, ?(Конец = 0, СтрДлина(Фрагмент), Конец)));
			Хвост = Сред(Фрагмент, ?(Конец = 0, СтрДлина(Фрагмент), Конец) + 1);
			Позиция = СтрНайти(Хвост, Тег);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Sha256Файла(Знач Путь)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Новый ДвоичныеДанные(Путь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

Функция ГоловаСтраницы()

	HTML = UI.Каркас.Страница("Каталог", "<p>тело</p>",
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Возврат Лев(HTML, СтрНайти(HTML, "</head>"));

КонецФункции

Функция МеждуМаркерами(Знач Текст, Знач Начало, Знач Конец)

	Первый = СтрНайти(Текст, Начало);
	Если Первый = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Первый);
	Последний = СтрНайти(Хвост, Конец);
	Возврат ?(Последний = 0, Хвост, Лев(Хвост, Последний + СтрДлина(Конец) - 1));

КонецФункции

// Значение атрибута, открытого маркером: маркер несёт и имя тега, и имя атрибута целиком,
// поэтому «icon» и «apple-touch-icon» не путаются друг с другом.
Функция АдресИзГоловы(Знач Текст, Знач Маркер)

	Позиция = СтрНайти(Текст, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
	Кавычка = СтрНайти(Хвост, """");
	Возврат ?(Кавычка = 0, "", Лев(Хвост, Кавычка - 1));

КонецФункции

// Односегментное имя из адреса /static/…: ровно то, с чем контроллер идёт в белый список.
Функция ИмяИзАдресаСтатики(Знач Адрес)

	Префикс = UI.Активы.БазовыйПуть() + "/";
	Возврат ?(СтрНачинаетсяС(Адрес, Префикс), Сред(Адрес, СтрДлина(Префикс) + 1), Адрес);

КонецФункции

Функция НовыйИтогОтветчиков()
	Возврат Новый Структура("Сырые, Доверенные, БезЭкранирования, ЛишнееЭкранирование",
		Новый Массив(), Новый Массив(), Новый Массив(), Новый Массив());
КонецФункции

Процедура РазложитьОтветчиков(Знач Текст, Знач Источник, Итог)

	Для Каждого Ответчик Из ОтветчикиHTML(Текст) Цикл

		Адрес = Источник + ":" + Ответчик.Имя;

		Если Ответчик.Сырое Тогда
			Итог.Сырые.Добавить(Ответчик.Имя);
			ЧерезКомпонент = СтрНайти(Ответчик.Тело, "СтраницаОшибки") > 0
				И СтрНайти(Ответчик.Тело, ", Сообщение)") > 0;
			Если СтрНайти(Ответчик.Тело, "Экранировать(Сообщение)") = 0 И НЕ ЧерезКомпонент Тогда
				Итог.БезЭкранирования.Добавить(Адрес);
			КонецЕсли;
		Иначе
			Итог.Доверенные.Добавить(Ответчик.Имя);
			Если СтрНайти(Ответчик.Тело, "Экранировать(СообщениеHTML)") > 0 Тогда
				Итог.ЛишнееЭкранирование.Добавить(Адрес);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ОбразецОтветчиков()

	Возврат
		"Процедура ОтдатьПробуНеНайдено(Ответ, Знач Сообщение, Знач Пользователь)" + Символы.ПС
		+ "	Ответ.УстановитьТипКонтента(""html"");" + Символы.ПС
		+ "	Ответ.Записать(""<p>"" + Сообщение + ""</p>"");" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "Процедура ОтдатьПробуДоверенное(Ответ, Знач СообщениеHTML, Знач Пользователь)" + Символы.ПС
		+ "	Ответ.УстановитьТипКонтента(""html"");" + Символы.ПС
		+ "	Ответ.Записать(Экранировать(СообщениеHTML));" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "Процедура ОтдатьПробуКомпонентом(Ответ, Знач Сообщение, Знач Пользователь)" + Символы.ПС
		+ "	Ответ.УстановитьТипКонтента(""html"");" + Символы.ПС
		+ "	Ответ.Записать(Набор.СтраницаОшибки().Отрисовать("
		+ "Новый Структура(""Код, Сообщение"", 404, Сообщение)));" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;

КонецФункции

Функция ОтветчикиHTML(Знач Текст)

	Результат = Новый Массив();
	Позиция = СтрНайти(Текст, "Процедура Отдать");

	Пока Позиция > 0 Цикл

		Открывающая = СтрНайти(Текст, "(", НаправлениеПоиска.СНачала, Позиция);
		Конец = СтрНайти(Текст, "КонецПроцедуры", НаправлениеПоиска.СНачала, Позиция);

		Если Открывающая > 0 И Конец > 0
			И СтрНайти(Сред(Текст, Позиция, Конец - Позиция), "УстановитьТипКонтента(""html"")") > 0 Тогда

			Имя = СокрЛП(Сред(Текст, Позиция + СтрДлина("Процедура "),
				Открывающая - Позиция - СтрДлина("Процедура ")));
			Тело = Сред(Текст, Позиция, Конец - Позиция);

			Если ЕстьПараметр(Тело, "Сообщение") Тогда
				Результат.Добавить(Новый Структура("Имя, Тело, Сырое", Имя, Тело, Истина));
			ИначеЕсли ЕстьПараметр(Тело, "СообщениеHTML") Тогда
				Результат.Добавить(Новый Структура("Имя, Тело, Сырое", Имя, Тело, Ложь));
			КонецЕсли;

		КонецЕсли;

		Позиция = СтрНайти(Текст, "Процедура Отдать", НаправлениеПоиска.СНачала, Позиция + 1);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьПараметр(Знач Тело, Знач Имя)

	Искомое = "Знач " + Имя;
	Позиция = СтрНайти(Тело, Искомое);

	Пока Позиция > 0 Цикл
		Следующий = Сред(Тело, Позиция + СтрДлина(Искомое), 1);
		Если СтрНайти(", )=" + Символы.ПС, Следующий) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Тело, Искомое, НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВызовыОтветчиков(Знач Текст)

	Результат = Новый Массив();
	Позиция = СтрНайти(Текст, "Отдать");

	Пока Позиция > 0 Цикл

		ЭтоОбъявление = Сред(Текст, Макс(Позиция - 10, 1), 10) = "Процедура ";

		Открывающая = Позиция;
		Пока Открывающая <= СтрДлина(Текст) И Сред(Текст, Открывающая, 1) <> "(" Цикл
			Если СтрНайти(" ;" + Символы.ПС, Сред(Текст, Открывающая, 1)) > 0 Тогда
				Прервать;   // «Отдать» без вызова — слово в комментарии
			КонецЕсли;
			Открывающая = Открывающая + 1;
		КонецЦикла;

		Если НЕ ЭтоОбъявление И Сред(Текст, Открывающая, 1) = "(" Тогда
			Результат.Добавить(Новый Структура("Имя, Аргументы",
				Сред(Текст, Позиция, Открывающая - Позиция),
				АргументыВызова(Текст, Открывающая)));
		КонецЕсли;

		Позиция = СтрНайти(Текст, "Отдать", НаправлениеПоиска.СНачала, Позиция + 1);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АргументыВызова(Знач Текст, Знач Открывающая)

	Глубина = 0;
	ВКавычках = Ложь;
	Позиция = Открывающая;

	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
		ИначеЕсли НЕ ВКавычках И Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли НЕ ВКавычках И Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Сред(Текст, Открывающая + 1, Позиция - Открывающая - 1);
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Сред(Текст, Открывающая + 1);

КонецФункции

Функция СодержитЦвет(Знач Текст)

	Если СтрНайти(НРег(Текст), "rgb(") > 0 ИЛИ СтрНайти(НРег(Текст), "rgba(") > 0
		ИЛИ СтрНайти(НРег(Текст), "hsl(") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Позиция = СтрНайти(Текст, "#");
	Смещение = 0;

	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Смещение + Позиция + 1, 7);
		Если ЭтоHexЦвет(Хвост) Тогда
			Возврат Истина;
		КонецЕсли;
		Смещение = Смещение + Позиция;
		Позиция = СтрНайти(Сред(Текст, Смещение + 1), "#");
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоHexЦвет(Знач Хвост)

	Если НЕ HexДлиной(Хвост, 6) И НЕ HexДлиной(Хвост, 3) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция HexДлиной(Знач Хвост, Знач Длина)

	Если СтрДлина(Хвост) < Длина Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Поз = 1 По Длина Цикл
		Если НЕ ЭтоHex(Сред(Хвост, Поз, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Следующий = Сред(Хвост, Длина + 1, 1);
	Возврат НЕ ЭтоHex(Следующий);

КонецФункции

Функция ЭтоHex(Знач Символ)
	Возврат ЗначениеЗаполнено(Символ) И СтрНайти("0123456789abcdefABCDEF", Символ) > 0;
КонецФункции

Функция БезТегаScript(Знач HTML)

	Результат = HTML;

	Пока Истина Цикл
		Начало = СтрНайти(Результат, "<script");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Результат, "</script>");
		Если Конец = 0 Тогда
			Конец = СтрНайти(Сред(Результат, Начало), ">") + Начало - 1;
			Результат = Лев(Результат, Начало - 1) + Сред(Результат, Конец + 1);
			Продолжить;
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + Сред(Результат, Конец + 9);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
