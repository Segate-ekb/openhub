&Тест
Процедура ОпасныйАкцентНеПопадаетВStyle() Экспорт

	Опасные = Новый Массив();
	Опасные.Добавить("#fff;}html{display:none}");
	Опасные.Добавить("red;background:url(http://evil/x)");
	Опасные.Добавить("</style><script>alert(1)</script>");
	Опасные.Добавить("expression(alert(1))");
	Опасные.Добавить("#12345");
	Опасные.Добавить("＃ffffff");                       // fullwidth-решётка (обход по виду)
	Опасные.Добавить("#fff fff");                       // пробел внутри значения
	Опасные.Добавить("#fff" + Символы.ПС + "html{display:none}"); // перевод строки
	Опасные.Добавить("#ff/*комментарий*/f");            // CSS-комментарий внутри цвета
	Опасные.Добавить("var(--color-bg);}html{display:none");       // выход из var()

	Для Каждого Значение Из Опасные Цикл
		CSS = UI.Токены.Переменные(Новый Структура("Акцент", Значение));
		Ожидаем.Что(СтрНайти(НРег(CSS), "</style"), "тег style не закрыт извне").Равно(0);
		Ожидаем.Что(СтрНайти(НРег(CSS), "display:none"), "чужое правило не просочилось").Равно(0);
		Ожидаем.Что(СтрНайти(НРег(CSS), "expression("), "выражение не просочилось").Равно(0);
		Ожидаем.Что(СтрНайти(НРег(CSS), "url(http"), "внешняя ссылка не просочилась").Равно(0);
	КонецЦикла;

	Ожидаем.Что(СтрНайти(UI.Токены.Переменные(Новый Структура("Акцент", "#fff" + Символы.ПС + "x")), Символы.ПС),
		"перевода строки в объявлениях нет").Равно(0);

	Ожидаем.Что(UI.Токены.БезопасныйЦвет("#abc")).Равно("#abc");
	Ожидаем.Что(UI.Токены.БезопасныйЦвет("#AABBCC")).Равно("#AABBCC");
	Ожидаем.Что(UI.Токены.БезопасныйЦвет("rgb(1,2,3)")).Равно("");
	Ожидаем.Что(UI.Токены.БезопасныйМножитель("чепуха")).Равно(1);
	Ожидаем.Что(UI.Токены.БезопасныйМножитель(99)).Равно(1);

КонецПроцедуры

