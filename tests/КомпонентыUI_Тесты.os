	Ожидаем.Что(СтрНайти(Обычная, "name=""действие"" value=""отклонить""") > 0,
		"выбор действия формой").ЭтоИстина();

	Занята = UI.Кнопка.Отрисовать(Новый Структура("Подпись, Занята", "Публикуется", Истина));
	Ожидаем.Что(СтрНайти(Занята, "disabled") > 0, "занятая кнопка не нажимается повторно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Занята, "aria-busy=""true""") > 0, "состояние озвучивается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Занята, "button--busy") > 0, "класс состояния").ЭтоИстина();

