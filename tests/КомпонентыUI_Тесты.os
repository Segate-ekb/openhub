&Тест
Процедура ФормаОтбораСобираетНесколькоПолейВПорядкеМодели() Экспорт

	// экран журнала отбирает по четырём разным полям: форма, печатающая только первое,
	// молча теряет три отбора из четырёх
	Поля = Новый Массив();
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Варианты", "type", "Событие", "выбор",
		Варианты("права.выданы", "настройка.изменена")));
	Поля.Добавить(Новый Структура("Имя, Метка, Значение", "who", "Кто", "root"));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение", "from", "С", "date", "2026-08-01"));

	HTML = UI.ФормаОтбора.Отрисовать(Новый Структура(
		"Действие, Кнопка, Поля", "/hub/settings/audit", "Показать", Поля));

	Ожидаем.Что(СтрНайти(HTML, "name=""type""") > 0, "поле выбора события").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""who"" value=""root""") > 0, "поле субъекта со значением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "type=""date""") > 0, "поле даты своим типом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""2026-08-01""") > 0, "и текущим значением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""q"""), "одиночное поле подстроки не печатается").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "name=""type""") < СтрНайти(HTML, "name=""who"""),
		"порядок полей — из модели").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<button") > 0, "кнопка на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФормаОтбораЭкранируетИБезДействияПадает() Экспорт

	HTML = UI.ФормаОтбора.Отрисовать(Новый Структура("Действие, Метка, Значение, Кнопка",
		"/p?a=""><script>alert(1)</script>", "Отбор", """><i>x</i>", "Найти"));
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "адрес экранирован").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<i>"), "значение экранировано").Равно(0);

	Поймано = Ложь;
	Попытка
		UI.ФормаОтбора.Отрисовать(Новый Структура("Метка, Кнопка", "Отбор", "Найти"));
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Форма отбора") > 0, "ошибка называет компонент").ЭтоИстина();
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Действие") > 0, "и причину").ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Поймано, "форма без адреса отправки — дефект вызывающего").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолосаЗаполненияНазываетСебяСкринридеруИЧитаетсяБезЦвета() Экспорт

	HTML = UI.ПолосаЗаполнения.Отрисовать(Новый Структура("Процент, Метка, Подпись",
		42, "Заполнение пула", "430 МБ из 1024 МБ"));

	Ожидаем.Что(СтрНайти(HTML, "role=""progressbar""") > 0, "роль индикатора объявлена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-valuenow=""42""") > 0, "текущее значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-valuemin=""0""") > 0, "минимум").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-valuemax=""100""") > 0, "максимум").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Заполнение пула: 42%, 430 МБ из 1024 МБ""") > 0,
		"доступное имя называет и процент, и абсолютные величины").ЭтоИстина();
	// цвет — вторичный носитель смысла: те же числа напечатаны текстом
	Ожидаем.Что(СтрНайти(HTML, "42%") > 0 И СтрНайти(HTML, "430 МБ из 1024 МБ") > 0,
		"процент и величины видны текстом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "полоса работает без JS").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "style="), "и без инлайновых стилей").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолосаЗаполненияОкругляетСтупеньВнизИНеПреувеличивает() Экспорт

	// ширина берётся классом-ступенью; индикатор предела не вправе показывать
	// меньше занятого — поэтому ступень округляется ВНИЗ
	Ожидаем.Что(СтрНайти(Полоса(42), "meter__fill--40") > 0, "42% → ступень 40").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Полоса(39), "meter__fill--35") > 0, "39% → ступень 35").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Полоса(100), "meter__fill--100") > 0, "полная полоса").ЭтоИстина();

	// переполнение обрезается по ширине, но не по числу
	Переполнено = Полоса(137);
	Ожидаем.Что(СтрНайти(Переполнено, "meter__fill--100") > 0, "заливка не выходит за полосу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Переполнено, "aria-valuenow=""100""") > 0,
		"aria-valuenow не выходит за объявленный aria-valuemax").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Переполнено, "137%") > 0,
		"истинная величина остаётся в доступном имени").ЭтоИстина();

	// у пустого пула заливки нет вовсе: иначе min-width нарисовал бы просвет на нуле
	Ожидаем.Что(СтрНайти(Полоса(0), "meter__fill"), "пустой пул заливки не печатает").Равно(0);
	Ожидаем.Что(СтрНайти(Полоса(3), "meter__fill--0") > 0,
		"малая доля видна просветом, а не пустотой").ЭтоИстина();

КонецПроцедуры

