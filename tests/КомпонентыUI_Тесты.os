КонецПроцедуры

&Тест
Процедура СекцияСДействиемСтановитсяФормойСCSRFиПанелью() Экспорт

	Секция = UI.РендерерНастроек.Секция("Видимость", "", "<p>поля</p>");
	Секция.Действие = "/main/settings/visibility";
	Секция.Токен = "деадбиф";

	Секции = Новый Массив();
	Секции.Добавить(Секция);
	HTML = UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
