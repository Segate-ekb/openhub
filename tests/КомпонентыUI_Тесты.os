КонецПроцедуры

// Каким бывает объект — знание ХАБА. Кит принимает слаг вида как ФОРМУ (латиница,
// цифры, дефис) и ничего не придумывает: раньше он разбирал «пакет|пул|группа» с
// дефолтом «package», и шапка группы, пула и чего угодно молча становилась шапкой пакета.
&Тест
Процедура ШапкаНеПридумываетВидЗначокИПодпись() Экспорт

	Голая = UI.ШапкаОбъекта.Отрисовать(Новый Структура("Имя", "команда-осень"));

	Ожидаем.Что(СтрНайти(Голая, "data-kind"), "вида не задали — атрибута нет").Равно(0);
	Ожидаем.Что(СтрНайти(Голая, "objhead__kind"), "и подписи вида нет").Равно(0);
	Ожидаем.Что(СтрНайти(Голая, "<svg"), "и значка нет").Равно(0);
	Ожидаем.Что(СтрНайти(Голая, "команда-осень") > 0, "а имя на месте").ЭтоИстина();

	// кириллица, пробелы и кавычки видом быть не могут — в атрибут не попадают вовсе,
	// а не подменяются «безопасным» значением из словаря кита
	Для Каждого Мусор Из СтрРазделить("пакет,два слова,x""><script>,ПУЛ", ",") Цикл
		HTML = UI.ШапкаОбъекта.Отрисовать(Новый Структура("Имя, Вид", "x", Мусор));
		Ожидаем.Что(СтрНайти(HTML, "data-kind"), "вид «" + Мусор + "» в разметку не попал").Равно(0);
	КонецЦикла;

	// значок и подпись берутся из модели как есть
	Своя = UI.ШапкаОбъекта.Отрисовать(
		Новый Структура("Имя, Вид, Иконка, Подпись", "команда", "group", "галочка", "группа"));
	Ожидаем.Что(СтрНайти(Своя, "data-kind=""group""") > 0, "слаг из модели").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Своя, UI.НаборИконок.Контур("галочка")) > 0, "значок из модели").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Своя, ">группа<") > 0, "подпись из модели").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ШапкаБезИмениПадаетИЭкранируетВсёОстальное() Экспорт

	Поймано = Ложь;
	Попытка
		UI.ШапкаОбъекта.Отрисовать(Новый Структура("Описание", "без имени"));
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Шапка объекта") > 0, "ошибка называет компонент").ЭтоИстина();
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Имя") > 0, "и причину").ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Поймано, "шапка объекта без имени объекта не рендерится").ЭтоИстина();

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Адрес", "репозиторий", "javascript:alert(3)"));
	Мета.Добавить(Новый Структура("Подпись, Значение", "<b>лицензия</b>", "<i>MIT</i>"));

	HTML = UI.ШапкаОбъекта.Отрисовать(Новый Структура("Имя, Описание, Подпись, Мета",
		"<script>alert(1)</script>", "<img src=x onerror=alert(2)>", "<u>вид</u>", Мета));

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "имя экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "описание экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<u>"), "подпись вида экранирована").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасная ссылка метаданных отброшена").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<b>"), "подпись метаданных на нессылочной ветке экранирована").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<i>"), "значение метаданных экранировано").Равно(0);

КонецПроцедуры

&Тест
Процедура ШапкаЭкранируетЗначениеНаВеткеСоЗначком() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "лицензия", "<img src=x onerror=alert(1)>"));
	Мета.Добавить(Новый Структура("Подпись, Значение, Адрес",
		"автор", "<b>alice</b>", "javascript:alert(2)"));

	HTML = UI.ШапкаОбъекта.Отрисовать(
		Новый Структура("Имя, Мета", "winow", UI.ЗначкиМеты.Оснастить(Мета)));

	Ожидаем.Что(СтрНайти(HTML, "title=""лицензия""") > 0, "ветка со значком действительно взята").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "значение со значком экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<b>"), "и значение-ссылка тоже").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасный адрес отброшен").Равно(0);

КонецПроцедуры

// Шапка и карточка печатают мету одним желудём: расходиться им нельзя — они стоят
// на одной странице пакета друг под другом.
&Тест
Процедура ШапкаИКарточкаПоказываютМетуОдинаково() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "лицензия", "MIT"));

	Шапка = UI.ШапкаОбъекта.Отрисовать(
		Новый Структура("Имя, Мета", "winow", UI.ЗначкиМеты.Оснастить(Мета)));
	Карточка = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Контур = UI.НаборИконок.Контур("весы");
	Ожидаем.Что(СтрНайти(Шапка, Контур) > 0, "значок лицензии в шапке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Карточка, Контур) > 0, "и он же в карточке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<span class=""visually-hidden"">лицензия: </span>MIT") > 0,
		"текстовая пара в шапке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Карточка, "<span class=""visually-hidden"">лицензия: </span>MIT") > 0,
		"и в карточке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "лицензия: MIT"), "видимого «лицензия: MIT» в шапке больше нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область КарточкаПакета

&Тест
Процедура КарточкаПакетаСобираетИмяОписаниеПулИПлашки() Экспорт

	HTML = UI.КарточкаПакета.Карточка(МодельКарточкиПакета()).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<article class=""objcard"">") > 0, "контейнер карточки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/main/winow""") > 0, "имя ведёт на страницу пакета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "objcard__desc") > 0, "описание").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""пул""") > 0, "пул в метаданных").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/main""") > 0, "пул кликабелен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""версия""") > 0, "версия").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "0.11.3") > 0, "и её значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "tag--warn") > 0, "плашка устаревания").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "objcard__actions") > 0, "блок действий (шестерёнка)").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "class=""name"""), "легаси-класс name не вернулся").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "class=""desc"""), "легаси-класс desc не вернулся").Равно(0);

КонецПроцедуры

&Тест
Процедура СписокКарточекСобираетсяКомпонентомАПустойНеРисуется() Экспорт

	Карточки = Новый Массив();
	Карточки.Добавить(МодельКарточкиПакета());
	Карточки.Добавить(Новый Структура("Имя", "oscript-md"));

	HTML = UI.КарточкаПакета.Список(Карточки).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "class=""objcard-list""") > 0, "контейнер списка — тоже часть кита").ЭтоИстина();
	Ожидаем.Что(ЧислоВхождений(HTML, "<article class=""objcard"">"), "обе карточки").Равно(2);

	Ожидаем.Что(UI.КарточкаПакета.Список(Новый Массив()).Рендер(),
		"пустой список — пустая строка").Равно("");
	Ожидаем.Что(UI.КарточкаПакета.Список(Неопределено).Рендер(),
		"не массив — пустая строка").Равно("");

КонецПроцедуры

&Тест
Процедура КарточкаПакетаБезИмениПадаетИЭкранируетОстальное() Экспорт

	Поймано = Ложь;
	Попытка
		UI.КарточкаПакета.Карточка(Новый Структура("Описание", "без имени"));
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Карточка пакета") > 0, "ошибка называет компонент").ЭтоИстина();
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "Имя") > 0, "и причину").ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Поймано, "безымянная строка списка не рендерится").ЭтоИстина();

	HTML = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Описание, Адрес, Пул",
		"<script>alert(1)</script>", "<img src=x onerror=alert(2)>", "javascript:alert(3)",
		"<b>пул</b>")).Рендер();

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "имя экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "описание экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасный адрес отброшен").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<b>"), "имя пула экранировано").Равно(0);

КонецПроцедуры

&Тест
Процедура КарточкаПакетаЭкранируетИмяБезАдресаВерсиюИМета() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "<b>лицензия</b>", "<i>MIT</i>"));

	БезАдреса = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Версия, Мета",
		"""><script>alert(1)</script>", "<img src=x onerror=alert(2)>", Мета)).Рендер();

	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<script"), "имя БЕЗ адреса экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(БезАдреса, "&lt;script&gt;") > 0, "и выведено как текст").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<img"), "версия экранирована").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<b>"), "подпись метаданных экранирована").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезАдреса), "<i>"), "значение метаданных экранировано").Равно(0);

	САдресом = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Адрес",
		"""><script>alert(1)</script>", "/main/x")).Рендер();
	Ожидаем.Что(СтрНайти(НРег(САдресом), "<script"), "имя СО ссылкой экранировано").Равно(0);

КонецПроцедуры

// Ветка со значком печатает значение отдельно от подписи — на ней своя проверка вывода:
// «известная подпись» ведёт мимо старого текстового пути.
&Тест
Процедура КарточкаПакетаЭкранируетЗначениеНаВеткеСоЗначком() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "лицензия", "<img src=x onerror=alert(1)>"));
	Мета.Добавить(Новый Структура("Подпись, Значение, Адрес",
		"автор", "<b>alice</b>", "javascript:alert(2)"));

	HTML = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Пул, АдресПула, Мета",
		"winow", """><script>alert(3)</script>", "javascript:alert(4)", Мета)).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "title=""лицензия""") > 0, "ветка со значком действительно взята").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<img"), "значение со значком экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<b>"), "и значение-ссылка тоже").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "имя пула в ряду экранировано").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript"), "опасные адреса ряда отброшены").Равно(0);

КонецПроцедуры

// Ряд метаданных читается значками, как в каталогах пакетов. Слово-подпись из разметки
// не исчезает: значок декоративен, подпись несёт визуально скрытая текстовая пара —
// её озвучивает скринридер, её же находит поиск по странице и берёт копирование.
&Тест
Процедура КарточкаПакетаМеняетИзвестныеПодписиНаЗначки() Экспорт

	Мета = Новый Массив();
	Для Каждого Подпись Из UI.ЗначкиМеты.Подписи() Цикл
		Мета.Добавить(Новый Структура("Подпись, Значение", Подпись, "знач-" + Подпись));
	КонецЦикла;

	HTML = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Для Каждого Подпись Из UI.ЗначкиМеты.Подписи() Цикл

		Контур = UI.НаборИконок.Контур(UI.ЗначкиМеты.Значок(Подпись));
		Ожидаем.Что(СтрНайти(HTML, Контур) > 0, "«" + Подпись + "»: значок нарисован").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "title=""" + Подпись + """") > 0,
			"«" + Подпись + "»: подсказка на элементе ряда").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML,
			"<span class=""visually-hidden"">" + Подпись + ": </span>знач-" + Подпись) > 0,
			"«" + Подпись + "»: подпись читается скринридером и не пропала из текста").ЭтоИстина();

	КонецЦикла;

	Ожидаем.Что(СтрНайти(HTML, "aria-hidden=""true""") > 0,
		"значок при текстовой паре — декорация").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "role=""img"""),
		"и второго носителя подписи внутри <svg> нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<title>"), "как нет и <title> в значке").Равно(0);

КонецПроцедуры

// Пул и версия — собственные поля модели, а не элементы Меты, но в ряду они такие же.
&Тест
Процедура ПулИВерсияКарточкиТожеПоказаныЗначками() Экспорт

	HTML = UI.КарточкаПакета.Карточка(МодельКарточкиПакета()).Рендер();

	Ожидаем.Что(СтрНайти(HTML, UI.НаборИконок.Контур("стопка")) > 0, "у пула — стопка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, UI.НаборИконок.Контур("закладка")) > 0, "у версии — закладка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""visually-hidden"">пул: </span>") > 0,
		"подпись пула озвучивается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""visually-hidden"">версия: </span>0.11.3") > 0,
		"и подпись версии — вплотную к значению").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/main""") > 0, "пул остался ссылкой").ЭтоИстина();

КонецПроцедуры

// Незнакомая подпись — не повод потерять строку метаданных: значка для неё нет,
// а данные пользователь видит в прежнем виде «подпись: значение».
&Тест
Процедура НезнакомаяПодписьМетыОстаётсяТекстом() Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "зеркал", "3"));
	Мета.Добавить(Новый Структура("Значение", "только-значение"));
	Мета.Добавить(Новый Структура("Подпись", "только-подпись"));

	HTML = UI.КарточкаПакета.Карточка(Новый Структура("Имя, Мета", "winow", Мета)).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "зеркал: 3") > 0, "прежний текстовый вид").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""зеркал"""), "подсказки без значка не бывает").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "только-значение") > 0, "элемент без подписи").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "только-подпись") > 0, "элемент без значения").ЭтоИстина();
	Ожидаем.Что(ЧислоВхождений(HTML, "objcard__meta-item"), "все три строки на месте").Равно(3);

КонецПроцедуры

&Тест
Процедура КарточкаБезМетыНеРисуетРяд() Экспорт

	Ожидаем.Что(СтрНайти(UI.КарточкаПакета.Карточка(
		Новый Структура("Имя", "winow")).Рендер(), "objcard__meta"),
		"метаданных нет — контейнера тоже").Равно(0);

	Пустая = Новый Массив();
	Пустая.Добавить(Новый Структура("Подпись, Значение", "", ""));

	Ожидаем.Что(СтрНайти(UI.КарточкаПакета.Карточка(
		Новый Структура("Имя, Мета", "winow", Пустая)).Рендер(), "objcard__meta"),
		"пустые элементы ряда не создают").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Пагинация

&Тест
Процедура ПагинацияЗнаетГраницыСписка() Экспорт

	Середина = UI.Пагинация.Отрисовать(Новый Структура("Страница, ВсегоСтраниц, Основа",
		3, 7, "/packages"));
	Ожидаем.Что(СтрНайти(Середина, "href=""/packages?page=2""") > 0, "ссылка назад").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Середина, "href=""/packages?page=4""") > 0, "ссылка вперёд").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Середина, "Страница 3 из 7") > 0, "положение в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Середина, "rel=""prev""") > 0, "семантика связи").ЭтоИстина();

	Первая = UI.Пагинация.Отрисовать(Новый Структура("Страница, ВсегоСтраниц, Основа", 1, 7, "/packages"));
	Ожидаем.Что(СтрНайти(Первая, "rel=""prev"""), "«назад» на первой странице не существует").Равно(0);
	Ожидаем.Что(СтрНайти(Первая, "rel=""next""") > 0, "«вперёд» на месте").ЭтоИстина();

	Последняя = UI.Пагинация.Отрисовать(Новый Структура("Страница, ВсегоСтраниц, Основа", 7, 7, "/packages"));
	Ожидаем.Что(СтрНайти(Последняя, "rel=""next"""), "«вперёд» на последней странице нет").Равно(0);

	ЗаКраем = UI.Пагинация.Отрисовать(Новый Структура("Страница, ВсегоСтраниц, Основа", 99, 3, "/packages"));
	Ожидаем.Что(СтрНайти(ЗаКраем, "Страница 3 из 3") > 0, "номер прижат к последней").ЭтоИстина();
	Мусор = UI.Пагинация.Отрисовать(Новый Структура("Страница, ВсегоСтраниц, Основа", "чепуха", 3, "/packages"));
	Ожидаем.Что(СтрНайти(Мусор, "Страница 1 из 3") > 0, "нечисло — первая страница").ЭтоИстина();

	Ожидаем.Что(UI.Пагинация.Отрисовать(Новый Структура("Страница, ВсегоСтраниц, Основа", 1, 1, "/packages")),
		"одна страница — навигация была бы шумом").Равно("");

КонецПроцедуры

&Тест
Процедура ПагинацияБезЧислаСтраницВедётПоПризнакуСледующей() Экспорт

	// у журнала аудита счёта строк нет: номер последней страницы стоил бы материализации
	// всей выборки, поэтому «вперёд» печатается по признаку, а «назад» — по номеру
	Первая = UI.Пагинация.Отрисовать(Новый Структура("Страница, ЕстьСледующая, Основа",
		1, Истина, "/hub/settings/audit"));
	Ожидаем.Что(СтрНайти(Первая, "rel=""next""") > 0, "«вперёд» есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Первая, "href=""/hub/settings/audit?page=2""") > 0, "и ведёт на вторую").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Первая, "rel=""prev"""), "«назад» с первой страницы некуда").Равно(0);
	Ожидаем.Что(СтрНайти(Первая, "Страница 1") > 0, "номер страницы показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Первая, " из "), "числа всех страниц не выдумываем").Равно(0);

	Хвост = UI.Пагинация.Отрисовать(Новый Структура("Страница, ЕстьСледующая, Основа",
		3, Ложь, "/hub/settings/audit"));
	Ожидаем.Что(СтрНайти(Хвост, "rel=""prev""") > 0,
		"с последней страницы есть дорога назад").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Хвост, "href=""/hub/settings/audit?page=2""") > 0, "на предыдущую").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Хвост, "rel=""next"""), "а вперёд идти некуда").Равно(0);
	Ожидаем.Что(СтрНайти(Хвост, "Страница 3") > 0, "номер текущей страницы").ЭтоИстина();

	Ожидаем.Что(UI.Пагинация.Отрисовать(Новый Структура("Страница, ЕстьСледующая, Основа",
		1, Ложь, "/hub/settings/audit")),
		"единственная страница — навигация была бы шумом").Равно("");

	// признак не подменяет собой известное число страниц
	Известное = UI.Пагинация.Отрисовать(Новый Структура(
		"Страница, ВсегоСтраниц, ЕстьСледующая, Основа", 2, 2, Истина, "/packages"));
	Ожидаем.Что(СтрНайти(Известное, "Страница 2 из 2") > 0, "число страниц сильнее признака").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Известное, "rel=""next"""), "и «вперёд» за последней не печатается").Равно(0);

КонецПроцедуры

&Тест
Процедура ПагинацияСохраняетОтборИКодируетЕго() Экспорт

	Отбор = Новый Массив();
	Отбор.Добавить(Новый Структура("Имя, Значение", "q", "имя пакета&page=99"));

	Модель = Новый Структура("Страница, ВсегоСтраниц, Основа, Параметры", 2, 4, "/packages", Отбор);
	Адрес = UI.Пагинация.АдресСтраницы(Модель, 3);

	Ожидаем.Что(СтрНайти(Адрес, "q=") > 0, "отбор пережил переход").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Адрес, " "), "пробел значения закодирован, а не оставлен в URL").Равно(0);
	Ожидаем.Что(ЧислоВхождений(Адрес, "page="),
		"значение отбора не подмешало второй параметр страницы").Равно(1);
	Ожидаем.Что(СтрНайти(Адрес, "page=3") > 0, "номер страницы — свой параметр").ЭтоИстина();

	HTML = UI.Пагинация.Отрисовать(Модель);
	Ожидаем.Что(СтрНайти(HTML, "href=""" + UI.Экран.Экранировать(Адрес) + """") > 0,
		"в разметку попал ровно этот адрес").ЭтоИстина();

	Ожидаем.Что(СтрНайти(UI.Пагинация.АдресСтраницы(
		Новый Структура("Основа, Параметр", "/audit", "стр"), 5), "/audit?%D1%81%D1%82%D1%80=5") > 0,
		"имя параметра настраивается и кодируется").ЭтоИстина();

