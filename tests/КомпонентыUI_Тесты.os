&Тест
Процедура ХвостовойКомментарийНеГлушитСканПрозы() Экспорт

	Хвост = "	x1 = 1; // раньше здесь было ВызватьИсключение" + Символы.ПС
		+ "	x2 = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(Хвост).Количество(),
		"хвостовой комментарий со словом ВызватьИсключение не прикрывает следующий оператор")
		.Равно(1);

	Диагностика = "	ВызватьИсключение СтрШаблон(""Секция «%1» не несёт токен"", Имя);";

	Ожидаем.Что(ПрозаическиеЛитералы(Диагностика).Количество(),
		"текст ВызватьИсключение — техническая диагностика, а не строка интерфейса").Равно(0);

	Полная = "	// когда-то тут было ВызватьИсключение" + Символы.ПС
		+ "	y = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(Полная).Количество(),
		"комментарная строка со словом ВызватьИсключение не прикрывает следующий оператор")
		.Равно(1);

	Кавычка = "	z = 1; // кавычка "" в комментарии" + Символы.ПС
		+ "	w = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(Кавычка).Количество(),
		"нечётная кавычка в комментарии не сбивает разбор литералов").Равно(1);

КонецПроцедуры

// Самотест исключения: вторым аргументом ПравитМеханизм стоит ИМЯ КЛАССА-владельца правки,
// а не текст для человека. Исключение привязано к позиции аргумента, а не к слову: то же
// имя в любом другом месте остаётся прозой, иначе исключение глушило бы целое слово везде.
&Тест
Процедура ИмяКлассаВладельцаМеханизмаНеПользовательскаяСтрока() Экспорт

	НастоящиеВызовы = "	ПравитМеханизм(""oshub.auth.password.enabled"", ""СтражПарольногоВхода"");"
		+ Символы.ПС
		+ "	ПравитМеханизм(""oshub.pools.personal_enabled"", ""ПультЛичныхПространств"");";

	Ожидаем.Что(ПрозаическиеЛитералы(НастоящиеВызовы).Количество(),
		"имя класса-владельца правки — тип, а не строка интерфейса").Равно(0);

	ЧужаяПозиция = "	ПравитМеханизм(""Кто может читать пакеты пула"", ""СтражПарольногоВхода"");";

	Ожидаем.Что(ПрозаическиеЛитералы(ЧужаяПозиция).Количество(),
		"исключение живёт во втором аргументе: проза в первом по-прежнему видна").Равно(1);

	ГолоеИмя = "	Механизм = ""СтражПарольногоВхода"";";

	Ожидаем.Что(ПрозаическиеЛитералы(ГолоеИмя).Количество(),
		"то же имя вне вызова — обычный литерал: исключение не глушит слово везде").Равно(1);

	СтрокаЭкрана = "	Подпись = ""Кто может читать пакеты пула"";";

	Ожидаем.Что(ПрозаическиеЛитералы(СтрокаЭкрана).Количество(),
		"основной сторож жив: пользовательская строка в исходнике видна").Равно(1);

КонецПроцедуры

