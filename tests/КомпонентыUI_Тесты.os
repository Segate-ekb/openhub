		.Равно("политика=исключать");

	Ожидаем.Что(Разбор.Поле(Разбор.Разобрать(ВключеноТелом), "политика"),
		"сервер видит «включено»").Равно("оставлять");
	Ожидаем.Что(Разбор.Поле(Разбор.Разобрать(ВыключеноТелом), "политика"),
		"сервер видит «выключено»").Равно("исключать");

