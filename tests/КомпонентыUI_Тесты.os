КонецФункции

Функция ЧислоОбъявленийСловаря()

	Текст = ИсходникБезКомментариев(Исходники.Текст(
		ФайлКлассаСлоя(БезРасширения(ИмяФайлаБезПути(ФайлСловаряТекстов())))));

	Результат = 0;
	Маркер = "Добавить(""";
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Результат = Результат + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

