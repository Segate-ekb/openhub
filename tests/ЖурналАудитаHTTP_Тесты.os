// HTTP-тесты экрана журнала аудита (/hub/settings/audit): порог админа хаба, метод,
// круг «форма → адрес → форма» и выход со страницы за краем. Запрос собирается из
// выданного HTML: поля, придуманные тестом, проверяли бы тест, а не форму.
//
// Содержимое таблицы приходит из источника-файла (соседний трек) — оно под юнит-тестами
// витрины; здесь проверяется то, что от источника не зависит.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;          // фикстура КлиентХаба — запросы к подопытному хабу
Перем КаталогПроекта;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-журнал-аудита");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ПорогАдминаХаба

&Тест
Процедура ЖурналВидитТолькоАдминХаба() Экспорт

	Ожидаем.Что(Клиент.GETСКукой(Раздел(), Клиент.Войти("alice", "AlicePassw0rd")).КодСостояния,
		"обычный пользователь журнал не видит").Равно(403);

	// владелец своего пула управляет пулом, но не хабом: эскалации «свой пул ⇒ журнал» нет
	Ожидаем.Что(Клиент.GETСКукой(Раздел(), Клиент.Войти("owner1", "Owner1Passw0rd")).КодСостояния,
		"владелец пула журнал тоже не видит").Равно(403);

	// аноним получает страницу входа, а не журнал: гвард обязан отличать «не вошёл»
	Аноним = Клиент.Тело(БезКуки(Раздел()));
	Ожидаем.Что(СтрНайти(Аноним, "Журнал аудита"), "анониму заголовка раздела не видно").Равно(0);
	Ожидаем.Что(СтрНайти(Аноним, "name=""type"""), "и формы отбора тоже").Равно(0);

	Ответ = Клиент.GETСКукой(Раздел(), Клиент.Войти("root", "RootPassw0rd"));
	Ожидаем.Что(Ответ.КодСостояния, "КОНТРОЛЬ: админу хаба журнал открыт").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Журнал аудита") > 0, "заголовок раздела").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЖурналОтвечаетТолькоНаGET() Экспорт

	// winow метод не различает — его разбирает контроллер; журнал только читают
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(РазделНастроек(), КукаАдмина))));

	Ответ = Клиент.POSTФормы(Раздел(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "POST на журнал → 405").Равно(405);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Allow"), "405 несёт заголовок Allow").Равно("GET");
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "name=""type"""),
		"и формы журнала в теле отказа нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область КругФормы

// Круг «форма → адрес → форма»: запрос собирается из полей, которые печатает сама
// страница, и сервер обязан вернуть их значения в те же поля. Разъехались имена формы
// и параметров маршрута — отбор молча перестаёт действовать.
&Тест
Процедура ЗначенияФормыВозвращаютсяВНеёЖеЧерезАдрес() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Разметка = Клиент.Тело(Клиент.GETСКукой(Раздел(), КукаАдмина));

	Значения = Новый Соответствие();
	Значения.Вставить("type", "права.выданы");
	Значения.Вставить("who", "root");
	Значения.Вставить("since", "2026-08-01");
	Значения.Вставить("until", "2026-08-03");
	Значения.Вставить("ip", "10.0.0.0/8");

	Ответ = Клиент.Тело(Клиент.GETСКукой(АдресИзФормы(Разметка, Значения), Клиент.Войти("root", "RootPassw0rd")));

	Ожидаем.Что(СтрНайти(Ответ, "value=""права.выданы"" selected") > 0,
		"тип события вернулся в форму выбранным").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ, "name=""who"" value=""root""") > 0,
		"субъект вернулся в своё поле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ, "value=""2026-08-01""") > 0, "начало периода вернулось").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ, "value=""2026-08-03""") > 0, "конец периода вернулся").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ, "name=""ip"" value=""10.0.0.0/8""") > 0,
		"сеть вернулась в поле адреса").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НепрочитанныйАдресЭкранНазываетАЖурналПоказывает() Экспорт

	// пустая таблица без объяснения читается как «таких операций не было»
	Ответ = Клиент.Тело(Клиент.GETСКукой(Раздел() + "?ip="
		+ КодироватьСтроку("не-адрес-вовсе", СпособКодированияСтроки.URLEncoding), Клиент.Войти("root", "RootPassw0rd")));
	БезОтбора = Клиент.Тело(Клиент.GETСКукой(Раздел(), Клиент.Войти("root", "RootPassw0rd")));

	Ожидаем.Что(СтрНайти(Ответ, "не прочитан") > 0,
		"экран назвал, что адрес не прочитан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ, "не-адрес-вовсе") > 0, "и само значение").ЭтоИстина();
	Ожидаем.Что(ЧислоСтрокЖурнала(Ответ),
		"а журнал показан без отбора по адресу, а не пустым").Равно(ЧислоСтрокЖурнала(БезОтбора));
	Ожидаем.Что(ЧислоСтрокЖурнала(БезОтбора) > 0,
		"на подопытном хабе журнал непуст — иначе сравнение ничего не стережёт").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЭкранНазываетГраницыХвостаИВыходСоСтраницыЗаКраем() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	// экран обязан объяснить, ЧТО он показывает: границы прочитанного хвоста, чтение
	// не целиком либо недоступность источника — три состояния, и любое из них годится.
	// Пустая таблица без объяснения читается как «событий не было»
	Первая = Клиент.Тело(Клиент.GETСКукой(Раздел(), КукаАдмина));
	Пояснено = СтрНайти(Первая, "хвост файла журнала") > 0
		ИЛИ СтрНайти(Первая, "прочитан НЕ ЦЕЛИКОМ") > 0
		ИЛИ СтрНайти(Первая, "Источник журнала недоступен") > 0;
	Ожидаем.Что(Пояснено,
		"экран называет границы хвоста, неполноту чтения либо недоступность источника").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Первая, "UTC") > 0, "и часовой пояс времени").ЭтоИстина();

	ЗаКраем = Клиент.Тело(Клиент.GETСКукой(Раздел() + "?page=999", КукаАдмина));
	Ожидаем.Что(СтрНайти(ЗаКраем, "В начало журнала") > 0,
		"со страницы за краем есть выход в один клик").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ЗаКраем, "Страница 999"), "тупиковой навигации нет").Равно(0);

КонецПроцедуры

// ИСТ-ЭКСП-005: момент в журнале написан ТЕМ ЖЕ способом, что и везде на экране, и назвал
// свою зону. Живой хаб пишет «сейчас», поэтому сверяется не значение, а форма записи —
// но буквально, знак за знаком: «31.12.2026 23:59 UTC». Прежде колонка приходила локальным
// форматом платформы («12/31/2026 11:59:05 PM»), и зоны в ней не было.
&Тест
Процедура ВремяВЖурналеНаписаноКакВездеИПодписаноЗоной() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Разметка = Клиент.Тело(Клиент.GETСКукой(Раздел(), КукаАдмина));

	Ожидаем.Что(ЧислоСтрокЖурнала(Разметка) > 0,
		"на подопытном хабе журнал непуст — иначе сверять нечего").ЭтоИстина();

	Когда = ПервоеВремяЖурнала(Разметка);
	Ожидаем.Что(СтрДлина(Когда), "«" + Когда + "» — длина записи момента как у «31.12.2026 23:59 UTC»")
		.Равно(20);
	Ожидаем.Что(Прав(Когда, 4), "момент подписан зоной").Равно(" UTC");
	Ожидаем.Что(Сред(Когда, 3, 1) + Сред(Когда, 6, 1), "день и месяц отделены точками")
		.Равно("..");
	Ожидаем.Что(Сред(Когда, 11, 1), "дата и время отделены пробелом").Равно(" ");
	Ожидаем.Что(Сред(Когда, 14, 1), "часы и минуты отделены двоеточием").Равно(":");
	Ожидаем.Что(ТолькоЦифры(Когда), "остальные знаки — цифры даты и времени").Равно("311220262359");

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Содержимое первой ячейки первой строки таблицы: колонка «Когда».
Функция ПервоеВремяЖурнала(Знач Разметка)

	Тело = Сред(Разметка, СтрНайти(Разметка, "<tbody"));
	Ячейка = Сред(Тело, СтрНайти(Тело, "<td>") + 4);
	Возврат Лев(Ячейка, СтрНайти(Ячейка, "</td>") - 1);

КонецФункции

// Маска написания: любая цифра становится знаком образца, остальное отбрасывается.
// Так утверждение говорит про ФОРМУ записи, а не про момент, который на живом хабе «сейчас».
Функция ТолькоЦифры(Знач Значение)

	Образец = "311220262359";
	Результат = "";
	Позиция = 1;
	Для Знак = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Знак, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + Сред(Образец, Позиция, 1);
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Раздел()
	Возврат "/hub/settings/audit";
КонецФункции

Функция РазделНастроек()
	Возврат "/hub/settings/login";
КонецФункции

Функция БезКуки(Знач Путь)
	Возврат Клиент.Соединение().Получить(Новый HTTPЗапрос(Путь));
КонецФункции

// Адрес GET-запроса, собранный ИЗ ФОРМЫ ОТБОРА выданной страницы: имена полей берутся
// из разметки, значения — из формы плюс переопределения теста. Переопределение имени,
// которого в форме нет, — ошибка: тест обязан проверять форму, а не себя.
Функция АдресИзФормы(Знач Разметка, Знач Переопределения)

	Форма = БлокФормы(Разметка);
	Действие = ЗначениеАтрибута(Лев(Форма, СтрНайти(Форма, ">")), "action");
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ВызватьИсключение "У формы отбора нет action";
	КонецЕсли;

	Поля = ПоляФормы(Форма);

	Для Каждого КиЗ Из Переопределения Цикл
		Если Поля.Получить(КиЗ.Ключ) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Форма отбора не печатает поле ""%1"" — тест не вправе его выдумывать", КиЗ.Ключ);
		КонецЕсли;
		Поля.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;

	Части = Новый Массив();
	Для Каждого КиЗ Из Поля Цикл
		Части.Добавить(КодироватьСтроку(Строка(КиЗ.Ключ), СпособКодированияСтроки.URLEncoding)
			+ "=" + КодироватьСтроку(Строка(КиЗ.Значение), СпособКодированияСтроки.URLEncoding));
	КонецЦикла;

	Возврат Действие + "?" + СтрСоединить(Части, "&");

КонецФункции

// Первая <form class="filters"> страницы целиком.
Функция БлокФормы(Знач Разметка)

	Начало = СтрНайти(Разметка, "<form class=""filters""");
	Если Начало = 0 Тогда
		ВызватьИсключение "На странице нет формы отбора";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</form>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец));

КонецФункции

// Имена и значения полей формы: <input name value> и <select name> с выбранным вариантом.
Функция ПоляФормы(Знач Форма)

	Результат = Новый Соответствие();
	ИмяВыбора = "";

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл
		Начало = НРег(Кусок);
		Если СтрНачинаетсяС(Начало, "input") Тогда
			Имя = ЗначениеАтрибута(Кусок, "name");
			Если ЗначениеЗаполнено(Имя) Тогда
				Результат.Вставить(Имя, ЗначениеАтрибута(Кусок, "value"));
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Начало, "select") Тогда
			ИмяВыбора = ЗначениеАтрибута(Кусок, "name");
			Если ЗначениеЗаполнено(ИмяВыбора) Тогда
				Результат.Вставить(ИмяВыбора, "");
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Начало, "/select") Тогда
			ИмяВыбора = "";
		ИначеЕсли СтрНачинаетсяС(Начало, "option") И ЗначениеЗаполнено(ИмяВыбора) Тогда
			// браузер отправляет вариант, помеченный selected
			Если СтрНайти(Кусок, "selected") > 0 Тогда
				Результат.Вставить(ИмяВыбора, ЗначениеАтрибута(Кусок, "value"));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Атрибут)
	Маркер = Атрибут + "=""";
	Поз = СтрНайти(Тег, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));
КонецФункции

// Строк в таблице журнала: считаем открывающие теги строк тела, шапка ими не является.
Функция ЧислоСтрокЖурнала(Знач Разметка)

	Тело = Сред(Разметка, СтрНайти(Разметка, "<tbody"));
	Возврат СтрЧислоВхождений(Лев(Тело, ?(СтрНайти(Тело, "</tbody>") = 0,
		СтрДлина(Тело), СтрНайти(Тело, "</tbody>"))), "<tr");

КонецФункции

#КонецОбласти
