// Сбой, до которого не дотянулся ни один обработчик: подмена сырой пятисотки winow,
// две двери (страница и конверт ошибки API), отдельный ответ на недоступную базу,
// код запроса на экране и в журнале, страница без единого чтения прикладных настроек.

#Использовать asserts
#Использовать autumn-logos
#Использовать errors
#Использовать "фикстуры"

Перем Поиск;             // КлассыСлоя
Перем КаталогМодулей_;
Перем КаталогИнтерфейса_;
Перем UI;                // СборкаUI — граф компонентов рендера
Перем Причины;           // ПричинаСбояЗапроса (основа)
Перем Слова;             // СловаОСбоеЗаглушка
Перем Фабрика;           // ФабрикаОтветовЗаглушка
Перем Ловушка;           // ЛовушкаЛога — что шов написал в журнал
Перем ЛогШва;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ОбработчикЗапросовЗаглушка");
	РеестрФикстур.Подключить("ОтветWinowЗаглушка");
	РеестрФикстур.Подключить("ПоделкаИзЖелудей");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("СловарьТекстовЗаглушка");
	РеестрФикстур.Подключить("СловаОСбоеЗаглушка");
	РеестрФикстур.Подключить("ФабрикаОтветовЗаглушка");

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогИнтерфейса_ = ОбъединитьПути(КаталогМодулей_, "интерфейс", "Классы");

	Поиск = Новый КлассыСлоя();
	Поиск.ПодключитьОснову(КаталогМодулей_);
	КаталогВхода = ОбъединитьПути(КаталогМодулей_, "вход", "Классы");
	Поиск.Подключить(КаталогВхода, "ОбработчикСоСбоемСловами");
	Поиск.Подключить(КаталогВхода, "НапильникСбояСловами");

	UI = Новый СборкаUI().Собрать(КаталогИнтерфейса_);
	Поиск.Подключить(КаталогИнтерфейса_, "СтраницаСбояХаба");

	Причины = Новый ПричинаСбояЗапроса();

	Ловушка = Новый ЛовушкаЛога();
	ЛогШва = Логирование.ПолучитьЛог("тест.oshub.сбойсловами.шов");
	ЛогШва.УстановитьУровень(УровниЛога.Ошибка);
	ЛогШва.ДобавитьСпособВывода(Ловушка);

КонецПроцедуры

&ПередКаждым
Процедура СобратьДвойников() Экспорт

	Слова = Новый СловаОСбоеЗаглушка();
	Фабрика = Новый ФабрикаОтветовЗаглушка();
	Ловушка.Очистить();

КонецПроцедуры

#Область СбойСтановитсяОтветомХаба

&Тест
Процедура ИсключениеОбработчикаСтановитсяСтраницейСКодомЗапроса() Экспорт

	Шов = ШовНад(Падающий("Поток исполнения не дождался свободного соединения за 30000 мс"));

	Ответ = Шов.СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Слова.Страницы().Количество(), "человеку собрана страница").Равно(1);
	Ожидаем.Что(Ответ.Заголовок("Content-Type"), "и отдана разметкой")
		.Равно("text/html; charset=utf-8");
	Ожидаем.Что(Ответ.ТелоТекст, "код запроса виден человеку").Содержит(КодЗапроса());
	Ожидаем.Что(Ответ.ИдентификаторЗапроса, "и стоит на самом ответе").Равно(КодЗапроса());
	Ожидаем.Что(Ответ.Заголовок("Cache-Control"), "страница сбоя не кэшируется").Равно("no-store");

КонецПроцедуры

&Тест
Процедура СыраяПятисоткаWinowПодменяетсяСтраницей() Экспорт

	Сырая = Новый ОтветWinowЗаглушка(КодЗапроса()).КакПятисоткаWinow(СбойВладельца());

	Ответ = ШовНад(Отдающий(Сырая)).СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Слова.Страницы().Количество(), "сырая пятисотка подменена страницей").Равно(1);
	Ожидаем.Что(Ответ.СостояниеКод, "и отвечена как недоступность базы").Равно(503);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "Error in line"),
		"служебная обёртка OneScript наружу не ушла").Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "ПулСоединенийСБД"),
		"и имя чужого модуля тоже").Равно(0);

КонецПроцедуры

&Тест
Процедура ПятисоткаСобраннаяХабомОстаётсяКакЕсть() Экспорт

	Своя = Новый ОтветWinowЗаглушка(КодЗапроса());
	Своя.УстановитьСостояние(500);
	Своя.ТелоТекст = "{""error"":{""code"":""publish_failed""}}";

	Ответ = ШовНад(Отдающий(Своя)).СформироватьОтвет(Запрос("POST", "/api/v1/packages"));

	Ожидаем.Что(Слова.Страницы().Количество(), "чужого тела шов не трогает").Равно(0);
	Ожидаем.Что(Слова.Фразы().Количество(), "и слов о сбое не спрашивает").Равно(0);
	Ожидаем.Что(Ответ.ТелоТекст, "тело осталось прежним")
		.Равно("{""error"":{""code"":""publish_failed""}}");

КонецПроцедуры

&Тест
Процедура УспешныйОтветПроходитНетронутым() Экспорт

	Успешный = Новый ОтветWinowЗаглушка(КодЗапроса());
	Успешный.УстановитьСостояниеОК();
	Успешный.ТелоТекст = "<html>каталог</html>";

	Ответ = ШовНад(Отдающий(Успешный)).СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Ответ.СостояниеКод, "код не тронут").Равно(200);
	Ожидаем.Что(Ответ.ТелоТекст, "тело не тронуто").Равно("<html>каталог</html>");
	Ожидаем.Что(Ответ.Заголовок("Retry-After"), "заголовков повтора нет").Равно("");
	Ожидаем.Что(Ловушка.Всё(), "и в журнале тихо").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ДвеДвери

&Тест
Процедура МашиннаяДверьОтвечаетКонвертомОшибки() Экспорт

	Для Каждого Путь Из МашинныеАдреса() Цикл

		СобратьДвойников();
		Ответ = ШовНад(Падающий("что-то пошло не так")).СформироватьОтвет(Запрос("POST", Путь));

		Ожидаем.Что(Слова.Страницы().Количество(),
			"страницу машинной двери не рисуют: " + Путь).Равно(0);
		Ожидаем.Что(Ответ.Заголовок("Content-Type"), "конверт отдан JSON: " + Путь)
			.Равно("application/json; charset=utf-8");

		Ошибка = Конверт(Ответ.ТелоТекст);
		Ожидаем.Что(Ошибка.Получить("code"), "машинный код в конверте: " + Путь)
			.Равно("server.error");
		Ожидаем.Что(Ошибка.Получить("message"), "фраза та же, что на странице: " + Путь)
			.Равно("фраза[server.error]");

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КонвертМашиннойДвериНесётКодОтказаБазы() Экспорт

	Ответ = ШовНад(Падающий(СбойВладельца())).СформироватьОтвет(Запрос("GET", "/api/v1/packages"));

	Ожидаем.Что(Ответ.СостояниеКод, "недоступность базы и на машинной двери — 503").Равно(503);
	Ожидаем.Что(Ответ.Заголовок("Retry-After"), "с приглашением вернуться").Равно("60");
	Ожидаем.Что(Конверт(Ответ.ТелоТекст).Получить("code"), "и своим кодом")
		.Равно("database.unavailable");

КонецПроцедуры

&Тест
Процедура ПросьбаОJSONДелаетДверьМашинной() Экспорт

	Спрошенный = Запрос("GET", "/packages");
	Спрошенный.Заголовки.Вставить("accept", "application/json, text/plain;q=0.9");

	Ответ = ШовНад(Падающий("сбой")).СформироватьОтвет(Спрошенный);

	Ожидаем.Что(Слова.Страницы().Количество(), "попросили JSON — страницы нет").Равно(0);
	Ожидаем.Что(Ответ.Заголовок("Content-Type"), "ответ конвертом")
		.Равно("application/json; charset=utf-8");

КонецПроцедуры

&Тест
Процедура ЧеловеческийАдресОстаётсяСтраницейДажеРядомСМашинным() Экспорт

	Для Каждого Путь Из ЧеловеческиеАдреса() Цикл

		СобратьДвойников();
		Ответ = ШовНад(Падающий("сбой")).СформироватьОтвет(Запрос("GET", Путь));

		Ожидаем.Что(Слова.Страницы().Количество(), "человеку — страница: " + Путь).Равно(1);
		Ожидаем.Что(Ответ.Заголовок("Content-Type"), "и разметкой: " + Путь)
			.Равно("text/html; charset=utf-8");

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура СтраницаНеСобраласьОтветУходитТекстомСФразой() Экспорт

	Слова.ПадаетНаСтранице();

	Ответ = ШовНад(Падающий("сбой")).СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Ответ.Заголовок("Content-Type"), "разметки нет — уходит текст")
		.Равно("text/plain; charset=utf-8");
	Ожидаем.Что(Ответ.ТелоТекст, "но фраза на месте").Содержит("фраза[server.error]");
	Ожидаем.Что(Ответ.ТелоТекст, "и код запроса тоже").Содержит(КодЗапроса());

КонецПроцедуры

#КонецОбласти

#Область ОтказБазыЗвучитИначе

&Тест
Процедура ОтказБазыОтвечает503СПовторомЧерезМинуту() Экспорт

	Ответ = ШовНад(Падающий(СбойВладельца())).СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Ответ.СостояниеКод, "недоступность — это 503, а не 500").Равно(503);
	Ожидаем.Что(Ответ.Заголовок("Retry-After"), "и посетителя зовут вернуться").Равно("60");
	Ожидаем.Что(Слова.Фразы()[0], "фраза спрошена под кодом отказа базы")
		.Равно("database.unavailable");

КонецПроцедуры

&Тест
Процедура ПрочийСбойОтвечает500БезПовтора() Экспорт

	Ответ = ШовНад(Падающий("Индекс находится за границами массива"))
		.СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Ответ.СостояниеКод, "поломка хаба — 500").Равно(500);
	Ожидаем.Что(Ответ.Заголовок("Retry-After"), "звать обратно не через что").Равно("");
	Ожидаем.Что(Слова.Фразы()[0], "и код общий").Равно("server.error");

КонецПроцедуры

// Список сбоев ФИКСИРОВАН здесь, а не берётся у самого класса: список из класса означал бы
// «класс узнаёт свои же строки» и покраснеть не мог бы. Это дословные сообщения, снятые
// с живого PostgreSQL 17 — и при отказе подключения, и при падении базы ПОД работающим
// хабом, когда в пуле остаются мёртвые соединения.
&Тест
Процедура ЖивыеСбоиБазыОтвечаютсяКакНедоступностьБазы() Экспорт

	Для Каждого Текст Из ЖивыеСбоиБазы() Цикл

		Причина = Причины.ПоТексту(Текст);
		Ожидаем.Что(Причина.Код, "отказ базы: " + Текст).Равно("database.unavailable");
		Ожидаем.Что(Причина.Статус, "и статус 503: " + Текст).Равно(503);
		Ожидаем.Что(Причина.ПовторитьЧерез, "и зов вернуться: " + Текст).Равно(60);

		Ожидаем.Что(Причины.ЭтоОтказБазыПоТексту(ВРег(Текст)),
			"регистр сообщению безразличен: " + Текст).ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

// Та же батарея, но сбоем ОБЪЕКТОМ: цепочка причин разбирается иначе, чем голая строка.
&Тест
Процедура ЖивыеСбоиБазыУзнаютсяИСбоемОбъектом() Экспорт

	Для Каждого Текст Из ЖивыеСбоиБазы() Цикл
		Ожидаем.Что(Причины.ЭтоОтказБазы(СбойОбъектом(Текст)),
			"отказ базы цепочкой причин: " + Текст).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЧужойСбойСоСловомСоединениеБазойНеСчитается() Экспорт

	Для Каждого Текст Из ЧужиеСбои() Цикл

		Ожидаем.Что(Причины.ЭтоОтказБазыПоТексту(Текст),
			"базой это не является: " + Текст).ЭтоЛожь();

		Причина = Причины.ПоТексту(Текст);
		Ожидаем.Что(Причина.Код, "и код общий: " + Текст).Равно("server.error");
		Ожидаем.Что(Причина.Статус, "и статус 500: " + Текст).Равно(500);
		Ожидаем.Что(Причина.ПовторитьЧерез, "звать обратно не через что: " + Текст).Равно(0);

	КонецЦикла;

КонецПроцедуры

// Общая примета разрыва звучит одинаково у базы и у похода наружу; разводит их метка.
// Метка приезжает местом возникновения корневой причины — именем модуля entity.
&Тест
Процедура РазрывСоединенияРазводитсяМеткойБазы() Экспорт

	Ожидаем.Что(Причины.ЭтоОтказБазыПоТексту(
			"Соединение сброшено [АбстрактныйКоннекторSQL:214]"),
		"разрыв с модулем entity — отказ базы").ЭтоИстина();

	Ожидаем.Что(Причины.ЭтоОтказБазыПоТексту(
			"Connection refused [ПулСоединенийСБД:702]"),
		"и с пулом соединений тоже").ЭтоИстина();

	Ожидаем.Что(Причины.ЭтоОтказБазыПоТексту(
			"Соединение сброшено [КлиентS3Oint:132]"),
		"тот же разрыв у хранилища базой не считается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СбойСМашиннымКодомБазыУзнанБезЕдинойПриметы() Экспорт

	// текста-приметы здесь нет вовсе: отказ назвал себя машинным кодом
	Инфо = СбойОбъектом(Новый ПостроительОшибки(Причины.КодОтказаБазы(),
		"хранилище не ответило").Построить());

	Ожидаем.Что(Причины.ЭтоОтказБазы(Инфо), "отказ узнан по машинному коду").ЭтоИстина();
	Ожидаем.Что(Причины.ПоСбою(Инфо).Статус, "и отвечен 503").Равно(503);

КонецПроцедуры

&Тест
Процедура СбойБезКодаРазбираетсяПоЦепочкеПричин() Экспорт

	Инфо = СбойОбъектом(СбойВладельца());

	Ожидаем.Что(Причины.ЭтоОтказБазы(Инфо), "отказ узнан по цепочке причин").ЭтоИстина();
	Ожидаем.Что(Причины.ПоСбою(Инфо).Код, "и назван своим кодом")
		.Равно("database.unavailable");

КонецПроцедуры

&Тест
Процедура ЧужойСбойОбъектомБазойНеСчитается() Экспорт

	Инфо = СбойОбъектом(СтандартныеОшибки.ЗависимостьНедоступна("s3",
		"хранилище артефактов не ответило"));

	Ожидаем.Что(Причины.ЭтоОтказБазы(Инфо), "недоступное хранилище — не база").ЭтоЛожь();
	Ожидаем.Что(Причины.ПоСбою(Инфо).Код, "и код у него общий").Равно("server.error");

КонецПроцедуры

#КонецОбласти

#Область ЖурналИКодЗапроса

&Тест
Процедура ОднаСтрокаОшибкиНесётКодЗапросаМетодИПуть() Экспорт

	ШовНад(Падающий(СбойВладельца())).СформироватьОтвет(Запрос("POST", "/api/v1/packages"));

	Ожидаем.Что(Ловушка.Количество(), "строка одна: " + Ловушка.Всё()).Равно(1);

	Запись = Ловушка.Сообщение(0);
	Ожидаем.Что(Запись, "код запроса в строке").Содержит(КодЗапроса());
	Ожидаем.Что(Запись, "метод в строке").Содержит("POST");
	Ожидаем.Что(Запись, "путь в строке").Содержит("/api/v1/packages");
	Ожидаем.Что(Запись, "машинный код отказа в строке").Содержит("database.unavailable");
	Ожидаем.Что(Запись, "и дословная причина").Содержит("не дождался свободного соединения");

КонецПроцедуры

&Тест
Процедура СыраяПятисоткаТожеПопадаетВЖурналСКодомЗапроса() Экспорт

	Сырая = Новый ОтветWinowЗаглушка(КодЗапроса()).КакПятисоткаWinow(СбойВладельца());

	ШовНад(Отдающий(Сырая)).СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Ловушка.Количество(), "строка одна: " + Ловушка.Всё()).Равно(1);
	Ожидаем.Что(Ловушка.Сообщение(0), "код запроса в строке").Содержит(КодЗапроса());
	Ожидаем.Что(Ловушка.Сообщение(0), "и причина").Содержит("не дождался свободного соединения");

КонецПроцедуры

&Тест
Процедура ТекстИсключенияВОтветНеУходит() Экспорт

	Ответ = ШовНад(Падающий("Индекс находится за границами массива"))
		.СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "Индекс находится за границами"),
		"текста исключения в теле нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "Модуль"),
		"и служебной обёртки тоже").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СтраницаОтказа

&Тест
Процедура СтраницаНесётФразуКодЗапросаИОформлениеХаба() Экспорт

	Разметка = СтраницаХаба().Страница("database.unavailable", 503, КодЗапроса(),
		Новый КукиЗаглушка());

	Ожидаем.Что(Разметка, "документ целиком").Содержит("<!DOCTYPE html>");
	Ожидаем.Что(Разметка, "фраза о базе на месте").Содержит("База данных хаба не отвечает");
	Ожидаем.Что(Разметка, "код состояния показан человеку").Содержит("503");
	Ожидаем.Что(Разметка, "код запроса показан человеку").Содержит(КодЗапроса());
	Ожидаем.Что(Разметка, "подпись кода запроса на месте").Содержит("Код запроса");
	Ожидаем.Что(Разметка, "оформление хаба: лист стилей инсталляции").Содержит("stylesheet");
	Ожидаем.Что(Разметка, "и знак в шапке").Содержит("OpenHub");
