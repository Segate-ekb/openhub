КонецПроцедуры

&Тест
Процедура СтраницаНеЧитаетПрикладныеНастройки() Экспорт

	// заглушка настроек пуста: ЛЮБОЕ чтение бросает исключение, а брендирование
	// и оформление на такой отказ отвечают предупреждением в журнал. Журнал молчит —
	// значит, страница в настройки, а с ними в базу, не ходила ни разу
	Настройки = Новый НастройкиЗаглушка();
	СледЗаНастройками = Новый ЛовушкаЛога();
	ЛогНастроек = Логирование.ПолучитьЛог("тест.oshub.сбойсловами.настройки");
	ЛогНастроек.УстановитьУровень(УровниЛога.Предупреждение);
	ЛогНастроек.ДобавитьСпособВывода(СледЗаНастройками);

	Страница = Новый СтраницаСбояХаба(UI.Кит, UI.Токены,
		Новый ВыборОформления(Новый ОформлениеХаба(Настройки, ЛогНастроек)),
		UI.Тексты, UI.Активы, UI.Адреса,
		Новый Брендирование(Настройки, Неопределено, ЛогНастроек),
		Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), Причины);

	Разметка = Страница.Страница("database.unavailable", 503, КодЗапроса(), Новый КукиЗаглушка());

	Ожидаем.Что(ЗначениеЗаполнено(Разметка), "страница собралась").ЭтоИстина();
	Ожидаем.Что(СледЗаНастройками.Всё(),
		"страница сбоя не читала прикладных настроек").Равно("");

КонецПроцедуры

&Тест
Процедура СтраницаБерётТемуИзКукиПосетителя() Экспорт

	Куки = Новый КукиЗаглушка();
	Куки.Добавить("oshub_ui", "тема%3Dсветлая");

	Разметка = СтраницаХаба().Страница("server.error", 500, КодЗапроса(), Куки);

	Ожидаем.Что(Разметка, "выбор посетителя уехал в атрибут темы").Содержит("light");

КонецПроцедуры

&Тест
Процедура ВТелеОтветаНетНиПутейНиНомеровСтрок() Экспорт

	Желуди = Новый ПоделкаИзЖелудей();
	Желуди.Положить("СбойХабаСловами", СтраницаХаба());
	Шов = Новый ОбработчикСоСбоемСловами(Падающий(СбойВладельца()), Причины,
		Новый ОтветыAPI(Новый ЗаголовкиHTTP()), Фабрика, Желуди, ЛогШва);

	Ответ = Шов.СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Ответ.ТелоТекст, "фраза человеку").Содержит("База данных хаба не отвечает");
	Ожидаем.Что(Ответ.ТелоТекст, "код запроса").Содержит(КодЗапроса());
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "oscript_modules"), "путей к модулям нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "Error in line"), "номеров строк нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "ПулСоединенийСБД"), "имён классов нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СборкаНаШве

&Тест
Процедура НапильникСобираетОбёрткуКотораяЛовитСбой() Экспорт

	Желуди = Новый ПоделкаИзЖелудей();
	Желуди.Положить("ПричинаСбояЗапроса", Причины);
	Желуди.Положить("ОтветыAPI", Новый ОтветыAPI(Новый ЗаголовкиHTTP()));
	Желуди.Положить("ФабрикаОтветов", Фабрика);
	Желуди.Положить("СбойХабаСловами", Слова);

	Шов = Новый НапильникСбояСловами(Желуди, ЛогШва)
		.ОбработатьЖелудь(Падающий("сбой соседа по шву"), Неопределено);

	Ответ = Шов.СформироватьОтвет(Запрос("GET", "/packages"));

	Ожидаем.Что(Слова.Страницы().Количество(), "сбой стал страницей").Равно(1);
	Ожидаем.Что(Ответ.СостояниеКод, "и отвечен пятисоткой хаба").Равно(500);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ШовНад(Знач Обработчик)

	Желуди = Новый ПоделкаИзЖелудей();
	Желуди.Положить("СбойХабаСловами", Слова);

	Возврат Новый ОбработчикСоСбоемСловами(Обработчик, Причины,
		Новый ОтветыAPI(Новый ЗаголовкиHTTP()), Фабрика, Желуди, ЛогШва);

КонецФункции

Функция Падающий(Знач Текст)
	Возврат Новый ОбработчикЗапросовЗаглушка(Неопределено).Падает(Текст);
КонецФункции

Функция Отдающий(Знач Ответ)
	Возврат Новый ОбработчикЗапросовЗаглушка(Ответ);
КонецФункции

// Тот самый сбой, с которого требование началось: пятисотка hub.oscript.io со скриншота.
Функция СбойВладельца()
	Возврат "Поток исполнения не дождался свободного соединения за 30000 мс";
КонецФункции

// Дословные сообщения живого PostgreSQL 17 и его драйвера. Первые три — база упала ПОД
// работающим хабом, и в пуле осталось мёртвое соединение: ADO.NET говорит про СОСТОЯНИЕ
// соединения, а не про подключение. Остальные — отказ подключения и исчерпанное ожидание.
Функция ЖивыеСбоиБазы()

	Результат = Новый Массив();
	Результат.Добавить("System.InvalidOperationException: Connection is not open");
	Результат.Добавить("The connection is already in state 'Connecting'");
	// освобождённый объект базой не назовёт себя сам — его выдаёт место возникновения
	Результат.Добавить("System.ObjectDisposedException: Cannot access a disposed object"
		+ " [АбстрактныйКоннекторSQL:52]");
	Результат.Добавить("Npgsql.PostgresException: 57P01: terminating connection"
		+ " due to administrator command");
	Результат.Добавить("Npgsql.NpgsqlException: Failed to connect to 127.0.0.1:15438");
	Результат.Добавить(СбойВладельца());
	Возврат Результат;

КонецФункции

// Сбои соседей, которые звучат похоже, но базой не являются.
Функция ЧужиеСбои()

	Результат = Новый Массив();
	Результат.Добавить("Не удалось установить соединение с апстримом hub.oscript.io");
	Результат.Добавить("Соединение с почтовым сервером закрыто раньше времени");
	Результат.Добавить("Хранилище артефактов недоступно: dependency.unavailable");
	// самое общее исключение .NET: без метки базы оно ни о какой базе не говорит
	Результат.Добавить("Cannot access a disposed object [КлиентS3Oint:132]");
	Результат.Добавить("Cannot access a disposed object, name: ""Stream""");
	Результат.Добавить("Индекс находится за границами массива");
	Результат.Добавить("");
	Возврат Результат;

КонецФункции

// ИнформацияОбОшибке добывается только в кадре обработчика — отсюда и Попытка.
Функция СбойОбъектом(Знач Ошибка)

	Попытка
		ВызватьИсключение Ошибка;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

Функция Запрос(Знач Метод, Знач Путь)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "hub.example");

	Возврат Новый Структура("Идентификатор, Метод, Путь, Заголовки, Куки",
		КодЗапроса(), Метод, Путь, Заголовки, Новый КукиЗаглушка());

КонецФункции

Функция КодЗапроса()
	Возврат "1758620000000:2f0d1c4a-0000-4000-8000-00000000abcd";
КонецФункции

// Конверт разбирается обратно: сторожить надо значение полей, а не форму их записи.
Функция Конверт(Знач Тело)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Разобрано = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Разобрано.Получить("error");

КонецФункции

Функция МашинныеАдреса()

	Результат = Новый Массив();
	Результат.Добавить("/api");
	Результат.Добавить("/api/v1/packages");
	Результат.Добавить("/push");
	Результат.Добавить("/push/oscript-ui");
	Результат.Добавить("/pools/main/download/list.txt");
	Результат.Добавить("/download/list.txt");
	Результат.Добавить("/dev-channel/list.txt");
	Результат.Добавить("/changes");
	// пробы: kubelet Accept не шлёт, а ответ читает машина
	Результат.Добавить("/health");
	Результат.Добавить("/ready");
	Возврат Результат;

КонецФункции

Функция ЧеловеческиеАдреса()

	Результат = Новый Массив();
	Результат.Добавить("/");
	Результат.Добавить("/packages");
	// соседний адрес с тем же началом машинной дверью не становится
	Результат.Добавить("/apidocs");
	Результат.Добавить("/pushkin");
	Результат.Добавить("/readymade");
	Результат.Добавить("/healthcare");
	Результат.Добавить("/downloads-faq");
	Результат.Добавить("/changelog");
	Возврат Результат;

КонецФункции

Функция СтраницаХаба()

	Возврат Новый СтраницаСбояХаба(UI.Кит, UI.Токены, UI.Оформление, UI.Тексты,
		UI.Активы, UI.Адреса, UI.Бренд, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), Причины);

КонецФункции

#КонецОбласти
