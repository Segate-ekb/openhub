&Тест
Процедура ПодпискаХабаПолучаетСобытияЛюбогоПула() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");

	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(), "событие пула 7").Равно(1);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(8, "версия.опубликована").Количество(), "событие пула 8").Равно(1);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.отозвана").Количество(), "неподписанный тип — не доставляется").Равно(0);
КонецПроцедуры

&Тест
Процедура ПодпискаХабаГаснетПриРазжалованииАвтора() Экспорт

	// подписка хаба получает события всех пулов, пока её автор — администратор; роль
	// отозвана — поток прекращается сразу
	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(),
		"пока автор администратор — доставляется").Равно(1);

	// тот же набор подписок, но администраторов в хабе не осталось
	Разжалованный = НовыйСервисСПравами(Новый ФейкСервисПрав(), "");
	Разжалованный.Создать(Обвязка.АдминХаба(), Разжалованный.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");
	Ожидаем.Что(Разжалованный.АктивныеДляСобытия(7, "версия.опубликована").Количество(),
		"автора разжаловали — доставки нет").Равно(0);
	Ожидаем.Что(Разжалованный.Список(Разжалованный.ОбъектХаба()).Количество(),
		"но в списке подписка видна: действующий администратор должен её снять").Равно(1);

КонецПроцедуры

// Подписки хаба на КАЖДОМ событии сверяются с ролью их автора: вопрос на подписку делал
// бы цену события их числом, а событие публикации — это каждый push в хаб.
&Тест
Процедура ЦенаСобытияДляПодписокХабаНеРастётСИхЧислом() Экспорт

	НаДвух = ЦенаСобытияДляПодписокХаба(2);
	НаДесяти = ЦенаСобытияДляПодписокХаба(10);

	Ожидаем.Что(НаДесяти.Чтений, СтрШаблон(
		"десять подписок стоят столько же чтений, сколько две: %1 против %2",
		Формат(НаДесяти.Чтений, "ЧГ=0"), Формат(НаДвух.Чтений, "ЧГ=0"))).Равно(НаДвух.Чтений);

	Ожидаем.Что(НаДесяти.Чтений, "авторы подписок — одно обращение на событие").Равно(1);

	// счётчик не должен мерить пустую работу: адресатов ровно столько, сколько подписок
	Ожидаем.Что(НаДесяти.Доставок, "доставляются все десять").Равно(10);

КонецПроцедуры

// Автор подписок — администратор хаба (100), иначе fail-closed погасил бы их все
// и сторож мерил бы пустую выборку.
Функция ЦенаСобытияДляПодписокХаба(Знач ЧислоПодписок)

	Пользователи = Обвязка.УчёткиСАдминами("100");
	Сервис = НовыйСервисНадУчётками(Пользователи);

	Для Номер = 1 По ЧислоПодписок Цикл
		Сервис.Создать(Обвязка.АдминХаба(), Сервис.ОбъектХаба(),
			СтрШаблон("https://hub-%1.example.com/hook", Формат(Номер, "ЧГ=0")),
			"версия.опубликована");
	КонецЦикла;

	ДоСобытия = Пользователи.Чтений();
	Доставок = Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество();

	Возврат Новый Структура("Чтений, Доставок",
		Пользователи.Чтений() - ДоСобытия, Доставок);

КонецФункции

// Отказ чтения ОДНОЙ учётки не должен гасить чужие подписки: разрез не удался — хаб
// дочитывает авторов поимённо, и молчит только подписка нечитаемого автора.
// Адреса идут порядком заведения: хранилище подписок отдаёт их так же.
&Тест
Процедура НечитаемыйАвторГаситТолькоСвоюПодпискуХаба() Экспорт

	Пользователи = Обвязка.УчёткиСАдминами("100,300");
	Сервис = НовыйСервисНадУчётками(Пользователи);

	Сервис.Создать(Обвязка.АдминХаба(), Сервис.ОбъектХаба(), "https://ok.example.com/hook",
		"версия.опубликована");
	Сервис.Создать(ВторойАдмин(), Сервис.ОбъектХаба(), "https://broken.example.com/hook",
		"версия.опубликована");

	Ожидаем.Что(Адресаты(Сервис), "КОНТРОЛЬ: пока обе учётки читаются — доставка обеим")
		.Равно("https://ok.example.com/hook, https://broken.example.com/hook");

	Пользователи.ПадатьНаУчётке(300);

	Ожидаем.Что(Адресаты(Сервис), "нечитаемый автор потерял свою подписку, чужая ушла")
		.Равно("https://ok.example.com/hook");

КонецПроцедуры

// Без службы учёток подписки хаба проверить некому: служба подписок не собирается, а не молчит.
&Тест
Процедура БезСлужбыУчётокСлужбаПодписокНеСобирается() Экспорт

	Отказ = "";
	Попытка
		НовыйСервисНадУчётками(Неопределено);
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "без службы учёток — громкий отказ").Содержит("нет службы учёток");
	Ожидаем.Что(НовыйСервисНадУчётками(Обвязка.УчёткиСАдминами("100")) <> Неопределено,
		"КОНТРОЛЬ: со службой учёток служба подписок собирается").ЭтоИстина();

КонецПроцедуры

Функция Адресаты(Знач Сервис)

	Адреса = Новый Массив();
	Для Каждого Подписка Из Сервис.АктивныеДляСобытия(7, "версия.опубликована") Цикл
		Адреса.Добавить(Строка(Подписка.URL));
	КонецЦикла;
	Возврат СтрСоединить(Адреса, ", ");

КонецФункции

Функция ВторойАдмин()
	Возврат Новый Структура("Идентификатор, Админ", 300, Истина);
КонецФункции

&Тест
Процедура ПодпискаПулаИПакетаАвторомНеПерепроверяется() Экспорт

	// перепроверка автора — гарантия ПОДПИСКИ ХАБА и только её: у пула и пакета скоуп
	// ограничен объектом, а право на объект отзывается вместе с грантом
	Сервис = НовыйСервисСПравами(Новый ФейкСервисПрав(), ""); // администраторов нет вовсе
	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://pool.example.com/h", "версия.опубликована");
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(),
		"подписка пула доставляется независимо от роли автора").Равно(1);

КонецПроцедуры

&Тест
Процедура ВыключенныйИНеподписанныйНеВыбираются() Экспорт
	Сервис = НовыйСервис();
	Выкл = Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://off.example.com/h", "версия.опубликована");
	Сервис.Переключить(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), Выкл.Идентификатор, Ложь);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(), "выключенный не выбран").Равно(0);

	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://on.example.com/h", "версия.опубликована"); // только публикация
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.отозвана").Количество(), "неподписанный на отзыв не выбран").Равно(0);
	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована").Количество(), "подписанный на публикацию выбран").Равно(1);
КонецПроцедуры

&Тест
Процедура ЧужойОбъектНельзяТронутьПоId() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://iso.example.com/h", "версия.опубликована");
	// подставляем ДРУГОЙ пул с тем же id вебхука — «не найден» в этом объекте
	Ожидаем.Что(Сервис.Удалить(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 8), Вебхук.Идентификатор), "удаление в чужом пуле — no-op").ЭтоЛожь();
	Ожидаем.Что(Сервис.Переключить(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 8), Вебхук.Идентификатор, Ложь), "переключение в чужом пуле — no-op").ЭтоЛожь();
	// и через объект ДРУГОГО ТИПА с совпавшим идентификатором (пакет №7 против пула №7)
	Ожидаем.Что(Сервис.Удалить(Обвязка.АдминХаба(), ОбъектПакета(Сервис, 7, 7), Вебхук.Идентификатор),
		"удаление через объект другого типа — no-op").ЭтоЛожь();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "вебхук пула 7 цел").Равно(1);
КонецПроцедуры

&Тест
Процедура ПодпискаПакетаНеВидныВСпискеПула() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), ОбъектПакета(Сервис, 42, 7), "https://pkg.example.com/h", "версия.опубликована");
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "список пула показывает только подписки пула").Равно(0);
