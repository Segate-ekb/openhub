	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/t3", "скачивание.зафиксировано"),
		"внутреннее событие для подписки недоступно").ЭтоИстина();
КонецПроцедуры

