	Сервис.Создать(Обвязка.АдминХаба(), ОбъектПакета(Сервис, 42, 7), "https://pkg.example.com/hook", "версия.опубликована");

	Ожидаем.Что(Сервис.АктивныеДляСобытия(7, "версия.опубликована", 42).Количество(),
