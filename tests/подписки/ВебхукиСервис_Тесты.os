// СервисПодписок и ПодписчикВебхуков на фейках, без контейнера, базы и сети: права на объект,
// форма адреса, уникальность, приватность адресации доставок.

#Использовать asserts
#Использовать "../фикстуры"
#Использовать autumn-logos

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Обвязка;        // фикстура ОбвязкаПодписок — админ хаба, объект пула, учётки, готовность, имена журнала
Перем КаталогВебхуков;
Перем КаталогРеестра;   // классы, уехавшие из common к своему хозяину
Перем КаталогСобытийПуть;
Перем СобытияХаба;      // фикстура КаталогСобытийХаба — перечень из описаний всех предметов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогПроекта = КаталогиПроекта.Корень();
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогВебхуков = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	КаталогСобытийПуть = ОбъединитьПути(КаталогМодулей, "события", "Классы");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	РеестрФикстур.Подключить("ОбвязкаПодписок");
	Обвязка = Новый ОбвязкаПодписок(ПоискКлассов);
	ПоискКлассов.Подключить(КаталогВебхуков, "СервисПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "ВалидаторАдресаВебхука");
	ПоискКлассов.Подключить(КаталогВебхуков, "СлужбаДоставкиПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "ЧислаДоставки");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОчередьДоставокПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "РеестрДействийПодписок");
	ПоискКлассов.Подключить(КаталогВебхуков, "ПодписчикВебхуков");
	ПоискКлассов.Подключить(КаталогВебхуков, "ТелоСобытия");
	КаталогОбработчикаВебхука = ОбъединитьПути(ОбъединитьПути(КаталогВебхуков, "обработчики"), "вебхук");
	ПоискКлассов.Подключить(КаталогОбработчикаВебхука, "ДоставкаВебхуком");
	ПоискКлассов.Подключить(КаталогОбработчикаВебхука, "ХранениеПодпискиВебхука");
	// примитивы основы служба, подписчик и обработчики берут желудями
	КаталогCommon = ОбъединитьПути(ОбъединитьПути(КаталогВебхуков, "..", ".."), "основа", "Классы");
	ПоискКлассов.ПодключитьВсе(КаталогCommon);
	ПоискКлассов.Подключить(КаталогСобытийПуть, "ИздательСобытий");
	ПоискКлассов.Подключить(КаталогРеестра, "ЗаполнениеПула");
	ПоискКлассов.Подключить(КаталогРеестра, "АдресаСтраниц");
	КаталогАудита = ОбъединитьПути(ОбъединитьПути(КаталогCommon, "..", ".."), "аудит", "Классы");
	ПоискКлассов.Подключить(КаталогАудита, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогРеестра, "ИменаОбъектовРеестра");
	ПоискКлассов.Подключить(ОбъединитьПути(ОбъединитьПути(КаталогCommon, "..", ".."), "настройки", "Классы"),
		"АдресИнстанса");
	ПоискКлассов.Подключить(КаталогАудита, "СобытиеАудита");
	ПоискКлассов.Подключить(КаталогCommon, "ТекстJSON");
	ПоискКлассов.Подключить(КаталогВебхуков, "ПараметрыПодписки");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОтборЗаполненияПула");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОтборПоТегам");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОтборДоставкиПодписок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "данные", "Классы"),
		"СнятиеСтрок");
	РеестрФикстур.Подключить("ФейкХранилищеПоправок");
	РеестрФикстур.Подключить("ФейкХранилищеИсключений");
	РеестрФикстур.Подключить("ФейкПоправкаЗапись");
	РеестрФикстур.Подключить("ФейкИсключениеЗапись");
	РеестрФикстур.Подключить("ФейкКаналыПакетов");
	ПоискКлассов.Подключить(КаталогВебхуков, "АудитПробыПодписки");
	ПоискКлассов.Подключить(КаталогВебхуков, "ОграничительПроб");
	РеестрФикстур.Подключить("ФейкХранилищеВебхуков");
	РеестрФикстур.Подключить("ФейкЗаданиеДоставкиЗапись");
	РеестрФикстур.Подключить("ФейкХранилищеЗаданийДоставки");
	РеестрФикстур.Подключить("ФейкВебхукЗапись");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("СервисПользователейЗаглушка");
	РеестрФикстур.Подключить("ФейкХранилищеСущностей");
	РеестрФикстур.Подключить("ФейкСущностьАудита");
	РеестрФикстур.Подключить("ФейкТранспортHTTP");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ФейкВалидаторВебхука");
	РеестрФикстур.Подключить("РеестрОдногоПакета");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("КаталогСобытийХаба");
	СобытияХаба = Новый КаталогСобытийХаба(ПоискКлассов, ОбъединитьПути(КаталогВебхуков, "..", ".."));
КонецПроцедуры

// --- права ---

&Тест
Процедура ВладелецСоздаётВебхукССекретом() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/hook", "версия.опубликована");
	Ожидаем.Что(ЗначениеЗаполнено(Вебхук.Секрет), "секрет сгенерирован").ЭтоИстина();
	Ожидаем.Что(Вебхук.Активен, "новый вебхук активен").ЭтоИстина();
	Ожидаем.Что(Вебхук.ТипОбъекта, "тип объекта — пул").Равно("пул");
	Ожидаем.Что(Вебхук.ОбъектИдентификатор, "привязан к пулу").Равно(7);
	Ожидаем.Что(Вебхук.ПулИдентификатор, "пул-контейнер заполнен").Равно(7);
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "вебхук сохранён").Равно(1);
КонецПроцедуры

&Тест
Процедура НеВладелецНеМожетСоздать() Экспорт
	Сервис = НовыйСервис();
	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Чужак(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/h", "версия.опубликована"),
		"не-владелец не создаёт вебхук").ЭтоИстина();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "вебхук не создан").Равно(0);
КонецПроцедуры

&Тест
Процедура НеВладелецНеМожетУдалитьИлиПереключить() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/h", "версия.опубликована");
	Ожидаем.Что(ПопыткаМутации(Сервис, "удалить", Чужак(), Обвязка.ОбъектПула(Сервис, 7), Вебхук.Идентификатор),
		"чужак не удаляет").ЭтоИстина();
	Ожидаем.Что(ПопыткаМутации(Сервис, "переключить", Чужак(), Обвязка.ОбъектПула(Сервис, 7), Вебхук.Идентификатор),
		"чужак не переключает").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ЗаданныйСекретСохраняется() Экспорт
	Сервис = НовыйСервис();
	Вебхук = Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/s", "версия.опубликована", "мой-секрет");
	Ожидаем.Что(Вебхук.Секрет, "переданный секрет сохранён как есть").Равно("мой-секрет");
КонецПроцедуры

// --- права по типу объекта ---

&Тест
Процедура ИздательВедётПодпискуПакетаНоНеПула() Экспорт

	// издатель пула: «изменение» есть (наследуется на пакет), «удаления» нет (owner-уровень)
	Сервис = НовыйСервисСПравами(ПраваИздателя());

	Подписка = Сервис.Создать(Издатель_(), ОбъектПакета(Сервис, 42, 7), "https://pkg.example.com/h", "версия.опубликована");
	Ожидаем.Что(Подписка.ТипОбъекта, "подписка пакета создана").Равно("пакет");
	Ожидаем.Что(Подписка.ОбъектИдентификатор, "привязана к пакету").Равно(42);
	Ожидаем.Что(Подписка.ПулИдентификатор, "пул-контейнер — пул пакета").Равно(7);

	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Издатель_(), Обвязка.ОбъектПула(Сервис, 7), "https://pool.example.com/h", "версия.опубликована"),
		"издатель не заводит подписку ПУЛА (нужен owner-уровень)").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧитательНеЗаводитПодпискуПакета() Экспорт

	// подписка уносит поток событий пакета наружу — это право изменения, а не чтения
	Сервис = НовыйСервисСПравами(ПраваЧитателя());

	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Читатель(), ОбъектПакета(Сервис, 42, 7),
		"https://reader.example.com/h", "версия.опубликована"),
		"читатель не заводит подписку пакета").ЭтоИстина();
	Ожидаем.Что(Сервис.МожетУправлять(Читатель(), ОбъектПакета(Сервис, 42, 7)),
		"и по запросу права — нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПодпискуХабаЗаводитТолькоАдминХаба() Экспорт
	Сервис = НовыйСервис();
	Подписка = Сервис.Создать(Обвязка.АдминХаба(), Сервис.ОбъектХаба(), "https://hub.example.com/h", "версия.опубликована");
	Ожидаем.Что(Подписка.ТипОбъекта, "подписка хаба создана").Равно("хаб");
	Ожидаем.Что(Подписка.ПулИдентификатор, "у подписки хаба нет пула-контейнера").Равно(0);

	// издатель пула админом хаба не является
	СервисИздателя = НовыйСервисСПравами(ПраваИздателя());
	Ожидаем.Что(Обвязка.СозданиеОтклонено(СервисИздателя, Издатель_(), СервисИздателя.ОбъектХаба(),
		"https://hub2.example.com/h", "версия.опубликована"),
		"не-админ хаба не заводит подписку хаба").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура МожетУправлятьНеБросаетИСовпадаетСГейтом() Экспорт
	Сервис = НовыйСервис();
	Ожидаем.Что(Сервис.МожетУправлять(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7)), "владелец — да").ЭтоИстина();
	Ожидаем.Что(Сервис.МожетУправлять(Чужак(), Обвязка.ОбъектПула(Сервис, 7)), "чужак — нет").ЭтоЛожь();
	Ожидаем.Что(Сервис.МожетУправлять(Неопределено, Сервис.ОбъектХаба()), "аноним — нет").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура НеизвестныйТипОбъектаОтклонён() Экспорт
	// fail-closed: незнакомый объект не даёт подписку даже администратору
	Сервис = НовыйСервис();
	Чужой = Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор", "группа", 1, 1);
	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Обвязка.АдминХаба(), Чужой, "https://x.example.com/h", "версия.опубликована"),
		"объект неизвестного типа отклонён").ЭтоИстина();
КонецПроцедуры

// --- SSRF на создании ---

&Тест
Процедура НеАдресОтклонёнАСетьНазначенияНеСудится() Экспорт

	// отвергается только то, что адресом не является; приёмник в своей сети — выбор мейнтейнера
	Сервис = НовыйСервис();
	Объект = Обвязка.ОбъектПула(Сервис, 7);

	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Обвязка.АдминХаба(), Объект, "http://example.com/h", "версия.опубликована"),
		"http отклонён (схема, а не сеть)").ЭтоИстина();
	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Обвязка.АдминХаба(), Объект, "example.com/h", "версия.опубликована"),
		"строка без схемы адресом не является").ЭтоИстина();

	Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://127.0.0.1/h", "версия.опубликована");
	Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://169.254.169.254/h", "версия.опубликована");
	Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://hooks.internal.corp/h", "версия.опубликована");

	Ожидаем.Что(СписокПула(Сервис, 7).Количество(),
		"подписки на петлю, метаданные и внутреннее имя заведены").Равно(3);

КонецПроцедуры

// --- уникальность, лимит, типы ---

&Тест
Процедура ДубльURLВОбъектеОтклонён() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/dup", "версия.опубликована");
	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/dup", "версия.опубликована"), "повторный URL отклонён").ЭтоИстина();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "второй не создан").Равно(1);
КонецПроцедуры

&Тест
Процедура ДубльПоРегиструХостаОтклонён() Экспорт
	// https://Example.COM и https://example.com — один и тот же адрес (схема/DNS
	// регистронезависимы): второй не должен обойти инвариант (объект, URL)
	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://Example.COM/dup", "версия.опубликована");
	Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/dup", "версия.опубликована"),
		"дубль по регистру хоста отклонён").ЭтоИстина();
	Ожидаем.Что(СписокПула(Сервис, 7).Количество(), "второй не создан").Равно(1);
КонецПроцедуры

// Запись в базе могла лечь не каноничной («https://хаб» без слеша, «:443», «%7e» вместо «~»):
// канон применяется к обеим сторонам, и второй подписки на тот же адрес не появляется.
&Тест
Процедура ЗаписьПрежнегоКанонаСчитаетсяДублем() Экспорт

	ПрежниеФормы = Новый Массив();
	ПрежниеФормы.Добавить("https://example.com:443/dup");
	ПрежниеФормы.Добавить("https://example.com/pub/../dup");
	ПрежниеФормы.Добавить("https://example.com/%64up");

	Для Каждого Прежняя Из ПрежниеФормы Цикл

		Сервис = НовыйСервис();
		Объект = Обвязка.ОбъектПула(Сервис, 7);
		Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://example.com/dup", "версия.опубликована");
		ПодменитьАдрес(Сервис, Объект, Прежняя);

		Ожидаем.Что(Обвязка.СозданиеОтклонено(Сервис, Обвязка.АдминХаба(), Объект,
			"https://example.com/dup", "версия.опубликована"),
			"«" + Прежняя + "» — тот же адрес, а не второй").ЭтоИстина();
		Ожидаем.Что(СписокПула(Сервис, 7).Количество(),
			"второй подписки не появилось").Равно(1);

	КонецЦикла;

КонецПроцедуры

// Правка сличает адрес соседней подписки тем же каноном.
&Тест
Процедура ПравкаНаАдресПрежнегоКанонаОтклонена() Экспорт

	Сервис = НовыйСервис();
	Объект = Обвязка.ОбъектПула(Сервис, 7);
	Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://example.com/first", "версия.опубликована");
	Вторая = Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://example.com/second", "версия.опубликована");
	ПодменитьАдрес(Сервис, Объект, "https://example.com:443/first");

	// правка на СВОЙ же адрес проходит — иначе «отказано» ничего бы не доказывало
	Ожидаем.Что(ПопыткаПравки(Сервис, Объект, Вторая, "https://example.com/second"),
		"правка на собственный адрес отказом не является").ЭтоЛожь();

	Ожидаем.Что(ПопыткаПравки(Сервис, Объект, Вторая, "https://example.com/first"),
		"правка на адрес соседней подписки отклонена").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТотЖеURLВРазныхОбъектахДопустим() Экспорт
	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://example.com/x", "версия.опубликована");
	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 8), "https://example.com/x", "версия.опубликована");
	// пакет пула 7 и сам пул 7 — РАЗНЫЕ объекты: один адрес у обоих законен
	Сервис.Создать(Обвязка.АдминХаба(), ОбъектПакета(Сервис, 42, 7), "https://example.com/x", "версия.опубликована");
	Ожидаем.Что(СписокПула(Сервис, 8).Количество(), "тот же URL в другом пуле допустим").Равно(1);
	Ожидаем.Что(Сервис.Список(ОбъектПакета(Сервис, 42, 7)).Количество(), "тот же URL у пакета допустим").Равно(1);
КонецПроцедуры

// Число подписок на объект не ограничено.
