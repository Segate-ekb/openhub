КонецПроцедуры

// --- сквозной путь через подписчик ---

&Тест
Процедура ПодписчикСтавитДоставкуТолькоСвоемуПулу() Экспорт

	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://a.example.com/hook", "версия.опубликована");

	Транспорт = Новый ФейкТранспортHTTP();
	Служба = НоваяСлужбаДоставки(Транспорт);
	Подписчик = НовыйПодписчик(Сервис, Служба);

	// событие ЧУЖОГО пула 8 (у него вебхуков нет) — доставок не ставит
	Подписчик.ОбработатьСобытие(СобытиеПубликации(8, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "событие пула 8 без своих вебхуков — 0 доставок").Равно(0);

	// событие СВОЕГО пула 7 — ставит доставку его вебхуку
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "событие пула 7 — 1 доставка").Равно(1);

КонецПроцедуры

&Тест
Процедура ПодписчикДоставляетПодпискеПакетаИХаба() Экспорт

	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), ОбъектПакета(Сервис, 42, 7), "https://pkg.example.com/hook", "версия.опубликована");
	Сервис.Создать(Обвязка.АдминХаба(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");

	Транспорт = Новый ФейкТранспортHTTP();
	Служба = НоваяСлужбаДоставки(Транспорт);
	Подписчик = НовыйПодписчик(Сервис, Служба);

	// событие пакета 43 того же пула: подписка пакета 42 молчит, подписка хаба срабатывает
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 43, "другой", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "только подписка хаба").Равно(1);

	// событие пакета 42: срабатывают обе
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "подписка пакета + подписка хаба").Равно(3);

КонецПроцедуры

&Тест
Процедура СобытиеБезСкоупаНеДоставляетсяДажеПодпискеХаба() Экспорт

	// событие без пула и пакета адресовать некому: подписке хаба оно не доставляется
	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Сервис.ОбъектХаба(), "https://hub.example.com/hook", "версия.опубликована");

	Служба = НоваяСлужбаДоставки(Новый ФейкТранспортHTTP());
	Подписчик = НовыйПодписчик(Сервис, Служба);

	БезСкоупа = Новый Структура("Тип, Когда, Данные", "версия.опубликована",
		Дата(2026, 7, 26, 10, 0, 0), Новый Структура("ИмяПакета, Версия", "пакет", "1.0.0"));
	Подписчик.ОбработатьСобытие(БезСкоупа);
	Ожидаем.Что(Служба.РазмерОчереди(), "событие без пула и пакета — 0 доставок").Равно(0);

	// контроль: то же событие СО скоупом доставляется
	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "со скоупом — доставка есть").Равно(1);

КонецПроцедуры

&Тест
Процедура ПодписчикРазличаетТипСобытия() Экспорт

	Сервис = НовыйСервис();
	Сервис.Создать(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Сервис, 7), "https://a.example.com/hook", "версия.опубликована"); // только публикация

	Транспорт = Новый ФейкТранспортHTTP();
	Служба = НоваяСлужбаДоставки(Транспорт);
	Подписчик = НовыйПодписчик(Сервис, Служба);

	Подписчик.ОбработатьСобытие(СобытиеОтзыва(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "неподписанный тип (отзыв) не ставится").Равно(0);

	Подписчик.ОбработатьСобытие(СобытиеПубликации(7, 42, "пакет", "1.0.0"));
	Ожидаем.Что(Служба.РазмерОчереди(), "подписанный тип (публикация) ставится").Равно(1);

КонецПроцедуры

&Тест
Процедура ТелоДоставкиНесётМетаданныеСобытия() Экспорт

	Подписчик = НовыйПодписчик(НовыйСервис(), НоваяСлужбаДоставки(Новый ФейкТранспортHTTP()));
	Событие = Новый Структура("Тип, Когда, Данные",
		"версия.опубликована", Дата(2026, 7, 26, 10, 0, 0),
		Новый Структура("ПулИдентификатор, ИмяПула, ИмяПакета, Версия", 7, "мойпул", "мойпакет", "1.2.3"));

	Тело = Подписчик.СформироватьТело(Событие);

	Ожидаем.Что(Найти(Тело, """тип"":""версия.опубликована""") > 0, "тип в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, """пул"":""мойпул""") > 0, "пул в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, """пакет"":""мойпакет""") > 0, "пакет в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, """версия"":""1.2.3""") > 0, "версия в теле").ЭтоИстина();
	Ожидаем.Что(Найти(Тело, "2026-07-26T10:00:00Z") > 0, "время ISO в теле").ЭтоИстина();

КонецПроцедуры

// Автора версии и адрес репозитория событие не несёт: тело дочитывает их из реестра
// по пакету и версии события — у публикации и отзыва одинаково.
&Тест
Процедура ТелоДоставкиНесётАвтораВерсииИРепозиторийПакета() Экспорт

	Реестр = Новый РеестрОдногоПакета(42, "https://github.com/vanessa-opensource/vanessa-runner");
	Реестр.ДобавитьВерсию("3.0.2", "Pavel Bogatyrev");
	Тела = ТелаСРеестром(Реестр);

	Для Каждого Событие Из СобытияВерсии(7, 42, "vanessa-runner", "3.0.2") Цикл
		Поля = ПоляТела(Тела.ПоСобытию(Событие));
		Ожидаем.Что(Поля.Получить("автор"), "автор из манифеста версии: " + Событие.Тип)
			.Равно("Pavel Bogatyrev");
		Ожидаем.Что(Поля.Получить("репозиторий"), "адрес репозитория пакета: " + Событие.Тип)
			.Равно("https://github.com/vanessa-opensource/vanessa-runner");
	КонецЦикла;

КонецПроцедуры

// Версии, которой в реестре нет, автора не выдумывают; адрес репозитория — свойство пакета
// и остаётся при любой версии.
&Тест
Процедура ТелоНеВыдумываетАвтораНеизвестнойВерсии() Экспорт

	Реестр = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Тела = ТелаСРеестром(Реестр);

	Поля = ПоляТела(Тела.ПоСобытию(СобытиеПубликации(7, 42, "lib", "9.9.9")));

	Ожидаем.Что(Поля.Получить("автор"), "версии нет — автора нет").Равно("");
	Ожидаем.Что(Поля.Получить("репозиторий"), "репозиторий пакета").Равно("https://github.com/acme/lib");

КонецПроцедуры

// У события без пакета — заполнения пула — нет ни автора, ни репозитория, и реестр о нём
// не спрашивают.
&Тест
Процедура ТелоСобытияБезПакетаНеХодитВРеестр() Экспорт

	Реестр = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Тела = ТелаСРеестром(Реестр);
	Заполнение = Новый Структура("Тип, Когда, Данные", "пул.заполнен", Дата(2026, 7, 26, 10, 0, 0),
		Новый Структура("ПулИдентификатор, ИмяПула, ПакетИдентификатор, Процент", 7, "пул", 0, 91));

	Поля = ПоляТела(Тела.ПоСобытию(Заполнение));

	Ожидаем.Что(Поля.Получить("автор"), "у заполнения пула автора нет").Равно("");
	Ожидаем.Что(Поля.Получить("репозиторий"), "и репозитория нет").Равно("");
	Ожидаем.Что(Поля.Получить("процент"), "процент заполнения на месте").Равно(91);
	Ожидаем.Что(Реестр.Обращений(), "реестр не спрошен").Равно(0);

КонецПроцедуры

// Пакет удалён или идентификатор чужой: автора и репозитория нет, а тело собирается.
&Тест
Процедура ТелоСобытияНенайденногоПакетаБезАвтораИРепозитория() Экспорт

	Реестр = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Реестр.ДобавитьВерсию("1.0.0", "Acme");

	Поля = ПоляТела(ТелаСРеестром(Реестр).ПоСобытию(СобытиеОтзыва(7, 43, "удалённый", "1.0.0")));

	Ожидаем.Что(Поля.Получить("пакет"), "тело собрано").Равно("удалённый");
	Ожидаем.Что(Поля.Получить("автор"), "автора нет").Равно("");
	Ожидаем.Что(Поля.Получить("репозиторий"), "репозитория нет").Равно("");

КонецПроцедуры

// Сбой чтения реестра не срывает доставку подписчикам события: тело уходит с пустыми
// автором и репозиторием, а причина остаётся в журнале.
&Тест
Процедура СбойРеестраНеСрываетТелоСобытия() Экспорт

	Реестр = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Реестр.ДобавитьВерсию("1.0.0", "Acme");
	Реестр.ЭмулироватьСбой("база недоступна: соединение сброшено");
	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.тело-события");
	Лог.ДобавитьСпособВывода(Ловушка);

	Попытка
		Тело = Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено, Неопределено, Неопределено, Реестр, Реестр, Лог)
			.ПоСобытию(СобытиеПубликации(7, 42, "lib", "1.0.0"));
	Исключение
		Лог.УдалитьСпособВывода(Ловушка);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);

	Поля = ПоляТела(Тело);
	Ожидаем.Что(Поля.Получить("пакет"), "тело собрано").Равно("lib");
	Ожидаем.Что(Поля.Получить("автор"), "автор пуст").Равно("");
	Ожидаем.Что(Поля.Получить("репозиторий"), "репозиторий пуст").Равно("");
	Ожидаем.Что(Найти(Ловушка.Всё(), "соединение сброшено") > 0,
		"причина сбоя в журнале: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Ссылка тела ведёт на страницу пакета — туда, где она живёт: /pools/{пул}/packages/{пакет}
// от внешнего адреса инсталляции.
&Тест
Процедура СсылкаТелаСобытияВедётНаСтраницуПакета() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.instance.url", "https://hub.example.test/");
	Событие = СобытиеПубликации(7, 42, "settings", "1.0.0");
	Событие.Данные.ИмяПула = "main";
	Тело = Новый ТелоСобытия(Новый АдресаСтраниц(), Новый АдресИнстанса(Настройки)).ПоСобытию(Событие);

	Ожидаем.Что(ПоляТела(Тело).Получить("ссылка"), "ссылка на страницу пакета")
		.Равно("https://hub.example.test/pools/main/packages/settings");

КонецПроцедуры

// Проба — заведомо ненастоящая: автор «проба», а адресов у неё нет — ни ссылки, ни репозитория.
&Тест
Процедура ТелоПробыНесётНенастоящегоАвтораБезРепозитория() Экспорт

	Реестр = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Поля = ПоляТела(ТелаСРеестром(Реестр).Проба("версия.опубликована", "alice", Дата(2026, 7, 26, 10, 0, 0)));

	Ожидаем.Что(Поля.Получить("автор"), "автор пробы ненастоящий").Равно("проба");
	Ожидаем.Что(Поля.Получить("репозиторий"), "репозитория у пробы нет").Равно("");
	Ожидаем.Что(Поля.Получить("проба"), "признак пробы").ЭтоИстина();
	Ожидаем.Что(Реестр.Обращений(), "проба реестр не спрашивает").Равно(0);
	Ожидаем.Что(Поля.Получить("публикатор"), "публикатора у пробы нет").Равно("");
	Ожидаем.Что(Поля.Получить("как"), "способа у пробы нет").Равно("");
	Ожидаем.Что(Поля.Получить("релиз"), "релиза у пробы нет").Равно("");

КонецПроцедуры

// «Кто» тела — идентификатор журнала, как был; человек и способ публикации — своими полями:
// «Имя (логин)», без имени — логин.
&Тест
Процедура ТелоНазываетПубликатораИСпособПолями() Экспорт

	Событие = СобытиеПубликации(7, 42, "lib", "1.0.0");
	Событие.Данные.Вставить("Кто", "ci:acme/lib");
	Событие.Данные.Вставить("ЛогинПубликатора", "octocat");
	Событие.Данные.Вставить("ИмяПубликатора", "");
	Событие.Данные.Вставить("СпособПубликации", "доверенная публикация");

	Поля = ПоляТела(ТелаСРеестром(Новый РеестрОдногоПакета(42, "")).ПоСобытию(Событие));
	Ожидаем.Что(Поля.Получить("кто"), "кто — идентификатор журнала").Равно("ci:acme/lib");
	Ожидаем.Что(Поля.Получить("публикатор"), "имени нет — логин").Равно("octocat");
	Ожидаем.Что(Поля.Получить("как"), "способ публикации").Равно("доверенная публикация");

	Событие.Данные.Вставить("ИмяПубликатора", "The Octocat");
	Поля = ПоляТела(ТелаСРеестром(Новый РеестрОдногоПакета(42, "")).ПоСобытию(Событие));
	Ожидаем.Что(Поля.Получить("публикатор"), "имя и логин в скобках").Равно("The Octocat (octocat)");

	Событие.Данные.Вставить("ИмяПубликатора", "OctoCat");
	Поля = ПоляТела(ТелаСРеестром(Новый РеестрОдногоПакета(42, "")).ПоСобытию(Событие));
	Ожидаем.Что(Поля.Получить("публикатор"), "имя, равное логину, не повторяется").Равно("octocat");

КонецПроцедуры

// Событие без публикатора — отзыв учёткой, заполнение пула — полей человека и способа
// не выдумывает.
&Тест
Процедура ТелоБезПубликатораНеВыдумываетЧеловека() Экспорт

	Отзыв = СобытиеОтзыва(7, 42, "lib", "1.0.0");
	Отзыв.Данные.Вставить("Кто", "alice");

	Поля = ПоляТела(ТелаСРеестром(Новый РеестрОдногоПакета(42, "")).ПоСобытию(Отзыв));

	Ожидаем.Что(Поля.Получить("кто"), "кто на месте").Равно("alice");
	Ожидаем.Что(Поля.Получить("публикатор"), "публикатора нет").Равно("");
	Ожидаем.Что(Поля.Получить("как"), "способа нет").Равно("");

КонецПроцедуры

// Страница релиза — из запуска конвейера, принявшего версию события: у публикации и отзыва одинаково; версия
// не из релиза и неизвестная версия ссылки не получают.
&Тест
Процедура ТелоНесётСтраницуРелизаИзЗапускаКонвейера() Экспорт

	Адрес = "https://github.com/acme/lib/releases/tag/v1.2.0";
	Реестр = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Реестр.ДобавитьВерсию("1.2.0", "Acme", Адрес);
	Реестр.ДобавитьВерсию("1.1.0", "Acme");
	Тела = ТелаСЗапусками(Реестр);

	Для Каждого Событие Из СобытияВерсии(7, 42, "lib", "1.2.0") Цикл
		Ожидаем.Что(ПоляТела(Тела.ПоСобытию(Событие)).Получить("релиз"), "релиз версии: " + Событие.Тип)
			.Равно(Адрес);
	КонецЦикла;
	Ожидаем.Что(ПоляТела(Тела.ПоСобытию(СобытиеПубликации(7, 42, "lib", "1.1.0"))).Получить("релиз"),
		"версия не из релиза").Равно("");
	Ожидаем.Что(ПоляТела(Тела.ПоСобытию(СобытиеПубликации(7, 42, "lib", "9.9.9"))).Получить("релиз"),
		"неизвестная версия").Равно("");
	Ожидаем.Что(ПоляТела(ТелаСРеестром(Реестр).ПоСобытию(СобытиеПубликации(7, 42, "lib", "1.2.0")))
		.Получить("релиз"), "без запусков в реестре — пусто, а не сбой").Равно("");

КонецПроцедуры

// Имя, дочитанное у GitHub, меняет в теле ровно публикатора: прочие поля и их порядок — те же, иначе
// получатель увидел бы другое тело, чем то, что лежит в очереди.
&Тест
Процедура ИмяПубликатораМеняетВТелеТолькоПубликатора() Экспорт

	Событие = СобытиеПубликации(7, 42, "lib", "1.0.0");
	Событие.Данные.Вставить("Кто", "ci:acme/lib");
	Событие.Данные.Вставить("ЛогинПубликатора", "octocat");
	Событие.Данные.Вставить("СпособПубликации", "доверенная публикация");
	Тела = ТелаСРеестром(Новый РеестрОдногоПакета(42, ""));
	Исходное = Тела.ПоСобытию(Событие);

	СИменем = Тела.СИменемПубликатора(Исходное, "Mona Lisa", "octocat");

	Ожидаем.Что(ПоляТела(СИменем).Получить("публикатор"), "человек назван").Равно("Mona Lisa (octocat)");
	Ожидаем.Что(СтрЗаменить(СИменем, """Mona Lisa (octocat)""", """octocat"""),
		"остальное тело совпадает знак в знак").Равно(Исходное);
	Ожидаем.Что(Тела.СИменемПубликатора("не JSON", "Mona", "octocat"), "неразборчивое — как есть")
		.Равно("не JSON");

КонецПроцедуры

// --- служебные ---

Функция ТелаСРеестром(Знач Реестр)
	Возврат Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено, Неопределено, Неопределено, Реестр, Реестр);
КонецФункции

// Тело с третьей дверью реестра — запуском конвейера версии, откуда берётся страница релиза.
Функция ТелаСЗапусками(Знач Реестр)
	Возврат Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено, Неопределено, Неопределено, Реестр, Реестр,
		, , Реестр);
КонецФункции

Функция СобытияВерсии(Знач ПулИд, Знач ПакетИд, Знач Пакет, Знач Версия)
	Результат = Новый Массив();
	Результат.Добавить(СобытиеПубликации(ПулИд, ПакетИд, Пакет, Версия));
	Результат.Добавить(СобытиеОтзыва(ПулИд, ПакетИд, Пакет, Версия));
	Возврат Результат;
КонецФункции

// Поля тела — разбором JSON, а не поиском подстроки: сторож стережёт значение.
Функция ПоляТела(Знач Тело)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

// Истина, если правка отклонена.
Функция ПопыткаПравки(Знач Сервис, Знач Объект, Знач Подписка, Знач URL)

	Попытка
		Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Подписка.Идентификатор, "вебхук",
			Новый Структура("URL, СекретСвой", URL, Истина), "версия.опубликована", Истина);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

// Кладёт адрес в базу мимо сервиса, не каноничным.
Процедура ПодменитьАдрес(Знач Сервис, Знач Объект, Знач Адрес)

	Первая = Сервис.Список(Объект)[0];
	Первая.URL = Адрес;
	Первая.Сохранить();

КонецПроцедуры

Функция НовыйСервис()
	Возврат НовыйСервисСПравами(Новый ФейкСервисПрав());
КонецФункции

Функция НовыйСервисСПравами(Знач Права, Знач АдминыCSV = "100")
	Возврат НовыйСервисНадУчётками(Обвязка.УчёткиСАдминами(АдминыCSV), Права);
КонецФункции

// (Хранилище, Права, Реестр, Каталог, Параметры, Аудит, Ограничитель, Пользователи)
Функция НовыйСервисНадУчётками(Знач Пользователи, Знач Права = Неопределено)
	Возврат Новый СервисПодписок(
		Новый ФейкХранилищеВебхуков(),
		?(Права = Неопределено, Новый ФейкСервисПрав(), Права),
		РеестрВебхука(),
		НовыйКаталог(),
		НовыеПараметрыПодписки(),
		Новый АудитПробыПодписки(Обвязка.ИменаЖурнала(),
			Новый СобытиеАудита(Обвязка.ИменаЖурнала(), Новый ТекстJSON())),
		Новый ОграничительПроб(НастройкиПодписок()),
		Пользователи,
		Новый ФейкХранилищеПоправок(),
		Новый ФейкХранилищеИсключений(),
		НовыйОтборТегов());
КонецФункции

// Настройки подписок для прямой сборки вне контейнера — умолчаниями реестра.
Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Возврат Настройки;
КонецФункции

Функция НовыйКаталог()
	Возврат СобытияХаба.Каталог(НовыйИздатель());
КонецФункции

Функция НовыеПараметрыПодписки()
	Возврат Новый ПараметрыПодписки(НовыйКаталог());
КонецФункции

// Реестр с единственным типом «вебхук» (SSRF-гейт создания живёт в хранении типа).
Функция РеестрВебхука()
	Валидатор = Новый ВалидаторАдресаВебхука(НастройкиПодписок());
	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(Новый ФейкТранспортHTTP(), Валидатор,
		Новый ЧислаДоставки(НастройкиПодписок()), ЛогТестов()));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения);
КонецФункции

// Ядро-очередь с обработчиком «вебхук» на заданном транспорте (сквозные тесты подписчика).
Функция НоваяСлужбаДоставки(Знач Транспорт)
	Валидатор = Новый ФейкВалидаторВебхука();
	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(Транспорт, Валидатор,
		Новый ЧислаДоставки(НастройкиПодписок()), ЛогТестов()));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Реестр = Новый РеестрДействийПодписок(Доставки, Хранения);
	Очередь = Новый ОчередьДоставокПодписок(Новый ФейкХранилищеЗаданийДоставки(), НастройкиПодписок(),
		ЛогТестов(), Новый ПриведениеЧисел());
	Возврат Новый СлужбаДоставкиПодписок(Реестр, Очередь, Новый ЧислаДоставки(НастройкиПодписок()), ЛогТестов(),
		Новый ТекстОшибки());
КонецФункции

Функция НовыйПодписчик(Знач Сервис, Знач Служба)
	Возврат Новый ПодписчикВебхуков(Сервис, Служба, НовыйИздатель(), Обвязка.Готовность(ЛогТестов()),
		РеестрВебхука(), ЛогТестов(), Новый ТекстОшибки(), Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено),
		НовыйОтборДоставки());
КонецФункции

Функция НовыйОтборДоставки()
	Возврат Новый ОтборДоставкиПодписок(
		Новый ОтборЗаполненияПула(НовыеПараметрыПодписки(), Новый ЗаполнениеПула(), НовыйИздатель()),
		НовыйОтборТегов(), НовыеПараметрыПодписки(), Новый ФейкХранилищеПоправок(),
		Новый ФейкХранилищеИсключений(), Новый ТекстОшибки(), ЛогТестов());
КонецФункции

Функция НовыйОтборТегов()
	Каналы = Новый ФейкКаналыПакетов();
	Возврат Новый ОтборПоТегам(Каналы, Каналы, НовыйИздатель());
КонецФункции

// Набор прав издателя пула: «изменение» есть (наследуется на пакет), «удаления» нет.
Функция ПраваИздателя()
	Возврат Новый ФейкСервисПрав("создание,изменение,чтение");
КонецФункции

// Набор прав читателя: только «чтение».
Функция ПраваЧитателя()
	Возврат Новый ФейкСервисПрав("чтение");
КонецФункции

Функция НовыйИздатель()
	Возврат Новый ИздательСобытий();
КонецФункции

Функция ОбъектПакета(Знач Сервис, Знач Ид, Знач ПулИд)
	Возврат Сервис.ОбъектПакета(Новый Структура("Идентификатор, ПулИдентификатор, Имя",
		Ид, ПулИд, "пакет-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция СписокПула(Знач Сервис, Знач Ид)
	Возврат Сервис.Список(Обвязка.ОбъектПула(Сервис, Ид));
КонецФункции

Функция Чужак()
	Возврат Новый Структура("Идентификатор, Админ", 200, Ложь);
КонецФункции

Функция Издатель_()
	Возврат Новый Структура("Идентификатор, Админ", 300, Ложь);
КонецФункции

Функция Читатель()
	Возврат Новый Структура("Идентификатор, Админ", 400, Ложь);
КонецФункции

Функция СобытиеПубликации(Знач ПулИд, Знач ПакетИд, Знач Пакет, Знач Версия)
	Возврат Новый Структура("Тип, Когда, Данные", "версия.опубликована", Дата(2026, 7, 26, 10, 0, 0),
		Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия",
			ПулИд, ПакетИд, "пул", Пакет, Версия));
КонецФункции

Функция СобытиеОтзыва(Знач ПулИд, Знач ПакетИд, Знач Пакет, Знач Версия)
	Возврат Новый Структура("Тип, Когда, Данные", "версия.отозвана", Дата(2026, 7, 26, 10, 0, 0),
		Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия, Отозвана",
			ПулИд, ПакетИд, "пул", Пакет, Версия, Истина));
КонецФункции

Функция ПопыткаМутации(Знач Сервис, Знач Действие, Знач Кто, Знач Объект, Знач Ид)
	Попытка
		Если Действие = "удалить" Тогда
			Сервис.Удалить(Кто, Объект, Ид);
		Иначе
			Сервис.Переключить(Кто, Объект, Ид, Ложь);
		КонецЕсли;
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Лог для классов, создаваемых Новый: &Лог до них не внедряется.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции
