// Отбор доставки подписки пула по тегу, который пакеты наследуют от пула, вместе с деревом
// получателей — на настоящих службах реестра и подписок в контейнере ОСени на КоннекторInMemory.
// Отдельный процесс — свой контейнер.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "../фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;       // общий контейнер на все тесты набора
Перем Засев;         // фикстура ЗасевРеестра — пул, пакеты и версии службами хаба
Перем Учётки;        // фикстура СтендУчёток — хозяин пула, который заводит подписку

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	Модули = КаталогиПроекта.Модули();
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	ПодключитьСлоиПодписок(Модули);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "теги-пула-в-отборе-подписок");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("теги-пула-в-отборе-подписок-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Учётки = Новый СтендУчёток(Поделка);

КонецПроцедуры

// Реестр целиком — теги пула и их наследование; подписки без фоновой доставки: отбор зовётся
// напрямую тем же событием, какое получил бы подписчик.
Процедура ПодключитьСлоиПодписок(Знач Модули)

	Слои.Подключить("данные");
	Слои.Подключить("хранилище, публикация, реестр, основа, состояние/телеметрия, события");

	РеестрФикстур.Подключить("СоседиРеестра");
	Соседи = Новый СоседиРеестра();
	Соседи.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));

	Слои.Подключить("почта");
	// обезличивание журнала почта создаёт «Новым»: получатель в журнале без ящика
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы"),
		"ОбезличиваниеЖурнала");
	Слои.Подключить("уведомления, вход, права, настройки");

	// исходящий транспорт — из сети поштучно: слой сети целиком поднимает свои стартовые задачи
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "ТаймаутыHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "СессияИсходящегоHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "КлиентHTTP.os"));

	Слои.ПропускатьТакже("Очередь, Доставщик, Подписчик");
	Слои.Подключить("подписки");

КонецПроцедуры

#Область Тесты

// Подписка пула отбирает версии по тегу stable, которого у пакетов нет своего — его дают теги
// пула; пакет, снятый галкой в дереве получателей, событий не получает, хотя версия под тегом.
&Тест
Процедура ПодпискаПулаПоТегуПулаМинуетИсключённыйПакет() Экспорт

	Пул = ПулСГалкой();
	Включённый = ПакетСВерсиями(Пул, "1.0.0,2.0.0-rc.1");
	Исключённый = ПакетСВерсиями(Пул, "1.0.0");
	Ожидаем.Что(Желудь("СервисТегов").СвоиТегиПакета(Включённый.Идентификатор).Количество()
		+ Желудь("СервисТегов").СвоиТегиПакета(Исключённый.Идентификатор).Количество(),
		"КОНТРОЛЬ: своих тегов у пакетов нет — stable только от пула").Равно(0);

	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	Объект = Подписки().ОбъектПула(Пул);
	Подписка = ПодпискаПоТегу(Хозяин, Объект, "stable");
	Ожидаем.Что(Исключения().Отметить(Хозяин, Объект, Подписка.Идентификатор,
		УзелПакета(Исключённый), Новый Массив()), "пакет снят галкой").ЭтоИстина();

	Ожидаем.Что(Получатели(Пул, Включённый, "версия.опубликована", "1.0.0"),
		"релиз включённого пакета — под тегом пула, доставляется").Равно(1);
	Ожидаем.Что(Получатели(Пул, Включённый, "версия.опубликована", "2.0.0-rc.1"),
		"пререлиз вне stable пула — не доставляется").Равно(0);
	Ожидаем.Что(Получатели(Пул, Исключённый, "версия.опубликована", "1.0.0"),
		"релиз исключённого пакета под тем же тегом — не доставляется").Равно(0);

	Исключения().Отметить(Хозяин, Объект, Подписка.Идентификатор, Новый Массив(), УзелПакета(Исключённый));
	Ожидаем.Что(Получатели(Пул, Исключённый, "версия.опубликована", "1.0.0"),
		"галку вернули — пакет снова получает по тегу пула").Равно(1);

КонецПроцедуры

// Тег пула пакет наследует сразу, поэтому отзыв и восстановление судятся так же, как публикация:
// исход не зависит от того, первая ли это версия пакета и завёл ли он что-нибудь у себя.
&Тест
Процедура ТегПулаСудитОтзывИВосстановлениеКакПубликацию() Экспорт

	Пул = ПулСГалкой();
	Пакет = ПакетСВерсиями(Пул, "1.0.0");
	Хозяин = Учётки.УчёткаСРолью(Пул, "owner");
	ПодпискаПоТегу(Хозяин, Подписки().ОбъектПула(Пул), "stable",
		"версия.опубликована,версия.отозвана,версия.восстановлена");

	Ожидаем.Что(Получатели(Пул, Пакет, "версия.отозвана", "1.0.0"), "отзыв под тегом пула").Равно(1);
	Ожидаем.Что(Получатели(Пул, Пакет, "версия.восстановлена", "1.0.0"),
		"восстановление под тегом пула").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Подписки()
	Возврат Желудь("СервисПодписок");
КонецФункции

Функция Исключения()
	Возврат Желудь("СервисИсключенийПодписок");
КонецФункции

// Пул с включённой галкой: первое включение завело ему каналы визарда, stable среди них.
Функция ПулСГалкой()
	Пул = Засев.ПулСервисом();
	Желудь("СервисТеговПула").УстановитьНаследование(Пул.Идентификатор, Истина, "owner");
	Возврат Желудь("СервисПулов").ПулПоИдентификатору(Пул.Идентификатор);
КонецФункции

Функция ПакетСВерсиями(Знач Пул, Знач СписокВерсий)

	Пакет = Засев.ПакетСервисом(Пул);
	Для Каждого Номер Из СтрРазделить(СписокВерсий, ",", Ложь) Цикл
		Засев.ВерсияСервисом(Пакет, СокрЛП(Номер));
	КонецЦикла;
	Возврат Пакет;

КонецФункции

// Подписка пула руками хозяина — как её заводит экран подписок, с отбором по тегам.
Функция ПодпискаПоТегу(Знач Хозяин, Знач Объект, Знач ОтборТегов, Знач Типы = "версия.опубликована")
	Возврат Подписки().СоздатьПодписку(Хозяин, Объект, "вебхук",
		Новый Структура("URL, Секрет", "https://hook.example.com/" + УникальныеИмена.Имя("tags"), ""),
		Типы, Неопределено, Новый Структура("ОтборТегов", ОтборТегов));
КонецФункции

Функция УзелПакета(Знач Пакет)
	Узлы = Новый Массив();
	Узлы.Добавить(Исключения().Узел("пакет", Пакет.Идентификатор));
	Возврат Узлы;
КонецФункции

// Сколько подписок пула получат событие версии — отбор зовётся тем же событием, что и у подписчика.
Функция Получатели(Знач Пул, Знач Пакет, Знач Тип, Знач Версия)

	Событие = Новый Структура("Тип, Когда, Данные", Тип, ТекущаяУниверсальнаяДата(),
		Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия",
			Пул.Идентификатор, Пакет.Идентификатор, Пул.Имя, Пакет.Имя, Версия));
	Кандидаты = Подписки().Список(Подписки().ОбъектПула(Пул));
	Возврат Желудь("ОтборДоставкиПодписок").Отобрать(Кандидаты, Событие).Количество();

КонецФункции

#КонецОбласти
