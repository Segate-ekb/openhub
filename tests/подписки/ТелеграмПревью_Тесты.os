// Превью сообщения Telegram: какой адрес карточки уходит в Bot API по телу события и в какой
// форме. Доставка идёт настоящим обработчиком на фейковом транспорте, тело события собирает
// настоящий сборщик тела доставки над реестром из одного пакета (страница релиза — запуском
// конвейера версии); последний шаг — настоящий транспорт со шпионом тела.

#Использовать asserts
#Использовать autumn-logos
#Использовать oint
#Использовать "../фикстуры"

Перем СобытияХаба;   // фикстура КаталогСобытийХаба — перечень из описаний всех предметов
Перем Транспорт;     // ФейкТранспортTelegram — что ушло бы в Bot API
Перем Гвард;         // ГвардПулаДляГостя — какие пулы прочтёт аноним
Перем Настройки;     // НастройкиЗаглушка — внешний адрес хаба для тела и для превью

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогиПроекта.Корень(), "src"), "модули");
	КаталогПодписок = ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "подписки"), "Классы");
	КаталогТелеграм = ОбъединитьПути(ОбъединитьПути(КаталогПодписок, "обработчики"), "telegram");
	КаталогСобытий = ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "события"), "Классы");
	КаталогРеестра = ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "реестр"), "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ФейкТранспортTelegram");
	РеестрФикстур.Подключить("ГвардПулаДляГостя");
	РеестрФикстур.Подключить("РеестрОдногоПакета");
	РеестрФикстур.Подключить("ШпионТелаСообщенияTelegram");

	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.Подключить(КаталогТелеграм, "ТелоСообщенияTelegram");
	ПоискКлассов.Подключить(КаталогТелеграм, "ПревьюTelegram");
	ПоискКлассов.Подключить(КаталогТелеграм, "ДоставкаTelegram");
	ПоискКлассов.Подключить(КаталогТелеграм, "ПроксиTelegram");
	ПоискКлассов.Подключить(КаталогТелеграм, "ТранспортTelegramOint");
	ПоискКлассов.Подключить(КаталогПодписок, "ШаблонУведомления");
	ПоискКлассов.Подключить(КаталогПодписок, "ТелоСобытия");
	ПоискКлассов.Подключить(КаталогРеестра, "АдресаСтраниц");
	ПоискКлассов.Подключить(КаталогРеестра, "ЗаполнениеПула");
	ПоискКлассов.Подключить(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "настройки"), "Классы"),
		"АдресИнстанса");
	ПоискКлассов.Подключить(КаталогСобытий, "ИздательСобытий");

	РеестрФикстур.Подключить("КаталогСобытийХаба");
	СобытияХаба = Новый КаталогСобытийХаба(ПоискКлассов, КаталогМодулей);

КонецПроцедуры

&ПередКаждым
Процедура СобратьМир() Экспорт
	Транспорт = Новый ФейкТранспортTelegram();
	Гвард = Новый ГвардПулаДляГостя();
	Настройки = Новый НастройкиЗаглушка();
КонецПроцедуры

#Область ПорядокАдресов

// Страница релиза — первая: на ней список изменений, ради которого уведомление и читают.
// Версию принял конвейер релиза GitHub: реестр помнит страницу релиза запуском конвейера,
// тело доставки само кладёт её в поле «релиз», превью берёт её оттуда.
&Тест
Процедура РелизИзРеестраИдётВПревьюРаньшеСтраницыХабаИРепозитория() Экспорт

	Гвард.Открыть("team");
	Тело = ТелоВерсииРелиза("team", АдресХаба(), РепозиторийGitHub(), АдресРелиза());

	Ожидаем.Что(РазобратьJSON(Тело).Получить("релиз"), "тело несёт страницу релиза из реестра")
		.Равно(АдресРелиза());
	Ожидаем.Что(Превью(Тело), "в превью — страница релиза").Равно(АдресРелиза());

КонецПроцедуры

// Релиз уже выбран — видимость пула из базы не читается.
&Тест
Процедура РелизНеЗаставляетЧитатьПул() Экспорт

	Гвард.Открыть("team");
	Превью(ТелоВерсииРелиза("team", АдресХаба(), РепозиторийGitHub(), АдресРелиза()));

	Ожидаем.Что(Гвард.Обращений(), "к пулу не обращались").Равно(0);

КонецПроцедуры

// Без релиза — страница версии в хабе: пул публичный, внешний адрес задан. У каждой версии
// свой адрес: Telegram запоминает карточку по адресу.
&Тест
Процедура СтраницаВерсииПубличногоПулаИдётВПревьюБезРелиза() Экспорт

	Гвард.Открыть("team");
	Тело = ТелоВерсии("team", АдресХаба(), РепозиторийGitHub());

	Ожидаем.Что(РазобратьJSON(Тело).Получить("релиз"), "самотест: версия не из релиза").Равно("");
	Ожидаем.Что(Превью(Тело), "в превью — страница версии в хабе").Равно(СтраницаВерсии());
	Ожидаем.Что(Превью(ТелоВерсии("team", АдресХаба(), РепозиторийGitHub(), "1.2.4")),
		"у следующей версии — свой адрес").Равно(АдресХаба() + "/pools/team/packages/lib?version=1.2.4");

КонецПроцедуры

// Задание, вставшее в очередь до появления поля релиза: адрес выбирается со второго шага,
// а не ломается.
&Тест
Процедура ТелоБезПоляРелизаНачинаетСоСтраницыХаба() Экспорт

	Гвард.Открыть("team");
	Тело = БезПоляРелиза(ТелоВерсииРелиза("team", АдресХаба(), РепозиторийGitHub(), АдресРелиза()));

	Ожидаем.Что(Превью(Тело), "страница версии в хабе").Равно(СтраницаВерсии());

КонецПроцедуры

// Приватную страницу краулер Telegram не получит — он ходит без входа; карточку даёт репозиторий.
&Тест
Процедура ПриватныйПулОтдаётПревьюРепозиторию() Экспорт

	Тело = ТелоВерсии("team", АдресХаба(), РепозиторийGitHub());

	Ожидаем.Что(Превью(Тело), "в превью — репозиторий").Равно(РепозиторийGitHub());

КонецПроцедуры

// Без внешнего адреса хаба абсолютной ссылки на страницу нет — карточку даёт репозиторий.
&Тест
Процедура БезВнешнегоАдресаХабаПревьюВедётВРепозиторий() Экспорт

	Гвард.Открыть("team");
	Тело = ТелоВерсии("team", "", РепозиторийGitHub());

	Ожидаем.Что(Превью(Тело), "в превью — репозиторий").Равно(РепозиторийGitHub());

КонецПроцедуры

// Ни одного адреса — превью выключено явно: иначе Telegram построил бы карточку первой
// ссылки текста.
&Тест
Процедура ПриватныйПулБезРепозиторияУходитБезПревью() Экспорт

	Доставить(ТелоВерсии("team", АдресХаба(), ""));

	Ожидаем.Что(Транспорт.ПоследняяОтправка().АдресПревью, "адреса превью нет").Равно("");
	Ожидаем.Что(Тела().Сообщение("-100", "текст", "").link_preview_options.is_disabled,
		"и в Bot API уходит выключенное превью").ЭтоИстина();

КонецПроцедуры

// Заполнение пула — событие не о версии: карточки о нём нет, даже если пул публичен.
&Тест
Процедура ЗаполнениеПулаУходитБезПревью() Экспорт

	Гвард.Открыть("team");
	Данные = Новый Структура("ПулИдентификатор, ИмяПула, Процент", 7, "team", 90);
	Тело = СборщикТела(АдресХаба(), РепозиторийGitHub()).ПоСобытию(
		Новый Структура("Тип, Когда, Данные", "пул.заполнен", Момент(), Данные));

	Ожидаем.Что(Превью(Тело, "пул.заполнен"), "у заполнения пула превью нет").Равно("");

КонецПроцедуры

// У пробы координаты ненастоящие: страница «проба/проба» не существует.
&Тест
Процедура ПробаУходитБезПревью() Экспорт

	Гвард.Открыть("проба");
	Тело = СборщикТела(АдресХаба(), РепозиторийGitHub()).Проба("версия.опубликована", "root", Момент());

	Ожидаем.Что(Превью(Тело), "у пробы превью нет").Равно("");

КонецПроцедуры

// Адрес репозитория пишет публикующий: адрес клона по ssh карточкой не станет.
&Тест
Процедура АдресБезВебСхемыВПревьюНеИдёт() Экспорт

	Тело = ТелоВерсии("team", "", "git@github.com:acme/lib.git");

	Ожидаем.Что(Превью(Тело), "ssh-адрес в превью не идёт").Равно("");

КонецПроцедуры

// Учётные данные в адресе краулер Telegram предъявил бы чужому серверу: такой шаг пропускается.
&Тест
Процедура АдресСДаннымиПользователяВПревьюНеИдёт() Экспорт

	Релиз = "https://ghp_секрет@github.com/acme/lib/releases/tag/v1.2.3";
	Тело = ТелоВерсииРелиза("team", "", "https://x@github.com/acme/lib", Релиз);

	Ожидаем.Что(Превью(Тело), "ни релиз, ни репозиторий с данными пользователя").Равно("");
	Ожидаем.Что(Превью(ТелоВерсииРелиза("team", "", РепозиторийGitHub(), Релиз)),
		"следующий годный шаг").Равно(РепозиторийGitHub());

КонецПроцедуры

// Пробел или перевод строки внутри адреса делает его негодным для Bot API: шаг пропускается.
&Тест
Процедура АдресСПробеломИлиУправляющимСимволомВПревьюНеИдёт() Экспорт

	Для Каждого Адрес Из СтрРазделить("https://github.com/acme/my lib|https://github.com/acme/lib"
		+ Символы.ПС + "X-Injected: 1|https://github.com/acme/lib" + Символы.Таб + "x", "|") Цикл
		Ожидаем.Что(Превью(ТелоВерсии("team", "", Адрес)), "адрес не идёт: " + Адрес).Равно("");
	КонецЦикла;
	Ожидаем.Что(Превью(ТелоВерсииРелиза("team", "", РепозиторийGitHub(), АдресРелиза() + " x")),
		"негодный релиз уступает репозиторию").Равно(РепозиторийGitHub());

КонецПроцедуры

// Свой текст без {ссылка} карточку не теряет: адрес превью идёт отдельным полем.
&Тест
Процедура ШаблонБезСсылкиКарточкуНеТеряет() Экспорт

	Гвард.Открыть("team");
	Тело = ТелоВерсии("team", АдресХаба(), РепозиторийGitHub());

	Доставить(Тело, "Вышел {пакет} {версия}");

	Отправка = Транспорт.ПоследняяОтправка();
	Ожидаем.Что(Отправка.Текст, "текст — по шаблону, без адресов").Равно("Вышел lib 1.2.3");
	Ожидаем.Что(Отправка.АдресПревью, "а карточка — страница версии").Равно(СтраницаВерсии());

КонецПроцедуры

// Сбой чтения пула не срывает доставку: страница хаба просто не годится в превью.
&Тест
Процедура СбойЧтенияПулаНеСрываетДоставку() Экспорт

	Гвард.ЭмулироватьСбой();
	Тело = ТелоВерсии("team", АдресХаба(), РепозиторийGitHub());

	Ожидаем.Что(Доставить(Тело), "уведомление доставлено").ЭтоИстина();
	Ожидаем.Что(Транспорт.ПоследняяОтправка().АдресПревью, "превью — следующий годный адрес")
		.Равно(РепозиторийGitHub());

КонецПроцедуры

#КонецОбласти

#Область НастоящийТранспорт

// Последний шаг к Bot API: настоящий транспорт отдаёт адрес превью сборщику тела запроса,
// и в теле стоит именно он. Сборщик — шпион: он обрывает отправку до сети.
&Тест
Процедура АдресПревьюДоходитДоТелаЗапросаBotAPI() Экспорт

	Гвард.Открыть("team");
	Шпион = Новый ШпионТелаСообщенияTelegram(Тела());
	Настоящий = Новый ТранспортTelegramOint(Новый ПроксиTelegram(Новый НастройкиЗаглушка(), Новый ТекстОшибки()),
		Шпион, Новый ТекстОшибки());

	Доставлено = ДоставитьЧерез(Настоящий, ТелоВерсии("team", АдресХаба(), РепозиторийGitHub()));

	Ожидаем.Что(Доставлено, "самотест: отправка оборвана шпионом, а не дошла до сети").ЭтоЛожь();
	Собрано = Шпион.Последнее();
	Ожидаем.Что(Собрано, "самотест: транспорт собирал тело").Не_().Равно(Неопределено);
	Ожидаем.Что(Собрано.АдресПревью, "транспорт отдал сборщику адрес превью").Равно(СтраницаВерсии());
	Ожидаем.Что(Собрано.Тело.link_preview_options.url, "и он стоит в теле запроса").Равно(СтраницаВерсии());

КонецПроцедуры

#КонецОбласти

#Область ФормаПолейBotAPI

// Крупная картинка бывает только у превью с явным url; выключателя рядом нет.
&Тест
Процедура ПревьюСАдресомПросуКрупнуюКартинку() Экспорт

	Превью = Тела().Сообщение("-100", "текст", АдресРелиза()).link_preview_options;

	Ожидаем.Что(Превью.url, "адрес карточки").Равно(АдресРелиза());
	Ожидаем.Что(Превью.prefer_large_media, "крупная картинка").ЭтоИстина();
	Ожидаем.Что(Превью.Свойство("is_disabled"), "выключателя нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БезАдресаПревьюВыключеноЯвно() Экспорт

	Превью = Тела().Сообщение("-100", "текст https://example.org/чужая").link_preview_options;

	Ожидаем.Что(Превью.is_disabled, "превью выключено").ЭтоИстина();
	Ожидаем.Что(Превью.Свойство("url"), "адреса нет").ЭтоЛожь();

КонецПроцедуры

// Bot API молча игнорирует link_preview_options строкой: поле обязано уйти объектом JSON —
// тем путём, каким тело запроса собирает транспорт.
&Тест
Процедура ПревьюУходитВЗапросеОбъектомJSON() Экспорт

	Запрос = OPI_ЗапросыHTTP.НовыйЗапрос()
		.Инициализировать("https://api.telegram.org/botТОКЕН/sendMessage")
		.УстановитьJsonТело(Тела().Сообщение("-1001234567890*17", "текст", АдресРелиза()))
		.ОбработатьЗапрос("POST", Ложь)
		.ВернутьЗапрос();
	Отправлено = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

	Превью = Отправлено.Получить("link_preview_options");
	Ожидаем.Что(ТипЗнч(Превью), "превью — объект JSON").Равно(Тип("Соответствие"));
	Ожидаем.Что(Превью.Получить("url"), "с адресом карточки").Равно(АдресРелиза());
	Ожидаем.Что(Превью.Получить("prefer_large_media"), "и логическим признаком крупной картинки")
		.Равно(Истина);
	Ожидаем.Что(Отправлено.Получить("message_thread_id"), "соседние поля целы").Равно(17);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Адрес превью, с которым обработчик отдал сообщение транспорту.
Функция Превью(Знач Тело, Знач ТипСобытия = "версия.опубликована")
	Доставить(Тело, "", ТипСобытия);
	Возврат Транспорт.ПоследняяОтправка().АдресПревью;
КонецФункции

Функция Доставить(Знач Тело, Знач Шаблон = "", Знач ТипСобытия = "версия.опубликована")
	Возврат ДоставитьЧерез(Транспорт, Тело, Шаблон, ТипСобытия);
КонецФункции

Функция ДоставитьЧерез(Знач ЧемОтправить, Знач Тело, Знач Шаблон = "", Знач ТипСобытия = "версия.опубликована")

	Обработчик = Новый ДоставкаTelegram(ЧемОтправить, Новый ШаблонУведомления(СобытияХаба.Каталог()),
		Логирование.ПолучитьЛог("тест.oshub"), Новый ТекстОшибки(),
		Новый ПревьюTelegram(Гвард, Новый АдресИнстанса(Настройки), Новый АдресаСтраниц(),
			Новый РазборАдреса(), Новый ЧтениеПолей(), Новый ТекстОшибки()));
	Задание = Новый Структура("ИдДоставки, ТипДействия, Действие, ТипСобытия, Тело, НомерПопытки",
		"д-1", "telegram", Новый Структура("ЧатИд, Токен, Шаблон", "-1001234567890", "1:AAFukAn-prevju", Шаблон),
		ТипСобытия, Тело, 1);
	Возврат Обработчик.Доставить(Задание);

КонецФункции

// Тело события о версии — настоящим сборщиком: пакет «lib» названной версии в названном пуле.
// Внешний адрес хаба ставится общей настройкой: её же читает и превью.
Функция ТелоВерсии(Знач ИмяПула, Знач ВнешнийАдрес, Знач Репозиторий, Знач Версия = "1.2.3",
	Знач Релиз = "")

	Данные = Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия",
		7, 42, ИмяПула, "lib", Версия);
	Возврат СборщикТела(ВнешнийАдрес, Репозиторий, Версия, Релиз).ПоСобытию(
		Новый Структура("Тип, Когда, Данные", "версия.опубликована", Момент(), Данные));

КонецФункции

// Тело события о версии 1.2.3, которую принял конвейер релиза GitHub: страница релиза лежит
// в реестре запуском конвейера, в поле «релиз» её кладёт сборщик тела.
Функция ТелоВерсииРелиза(Знач ИмяПула, Знач ВнешнийАдрес, Знач Репозиторий, Знач Релиз)
	Возврат ТелоВерсии(ИмяПула, ВнешнийАдрес, Репозиторий, "1.2.3", Релиз);
КонецФункции

// Сборщик тела над реестром из одного пакета: версия, если названа, принята запуском
// конвейера с этой страницей релиза ("" — не из релиза).
Функция СборщикТела(Знач ВнешнийАдрес, Знач Репозиторий, Знач Версия = "", Знач Релиз = "")

	Настройки.Задать("oshub.instance.url", ВнешнийАдрес);
	Пакеты = Новый РеестрОдногоПакета(42, Репозиторий);
	Если ЗначениеЗаполнено(Версия) Тогда
		Пакеты.ДобавитьВерсию(Версия, "", Релиз);
	КонецЕсли;
	Возврат Новый ТелоСобытия(Новый АдресаСтраниц(), Новый АдресИнстанса(Настройки), Неопределено,
		Неопределено, Пакеты, Пакеты, , , Пакеты);

КонецФункции

// Тело задания, вставшего в очередь до появления поля «релиз».
Функция БезПоляРелиза(Знач Тело)
	Данные = РазобратьJSON(Тело);
	Данные.Удалить("релиз");
	Возврат Новый ТекстJSON().ОднойСтрокой(Данные);
КонецФункции

Функция РазобратьJSON(Знач Текст)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция Тела()
	Возврат Новый ТелоСообщенияTelegram();
КонецФункции

Функция Момент()
	Возврат Дата(2026, 10, 2, 12, 0, 0);
КонецФункции

Функция АдресХаба()
	Возврат "https://hub.example.ru";
КонецФункции

Функция СтраницаВерсии()
	Возврат АдресХаба() + "/pools/team/packages/lib?version=1.2.3";
КонецФункции

Функция РепозиторийGitHub()
	Возврат "https://github.com/acme/lib";
КонецФункции

Функция АдресРелиза()
	Возврат "https://github.com/acme/lib/releases/tag/v1.2.3";
КонецФункции

#КонецОбласти
