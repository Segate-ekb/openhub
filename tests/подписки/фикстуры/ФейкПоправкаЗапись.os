// Фейковая запись поправки подписки: колонки сущности «ПоправкаПодписки» + Сохранить() и Удалить().

Перем Хранилище_;

Перем Идентификатор Экспорт;
Перем ПодпискаИдентификатор Экспорт;
Перем ТипОбъекта Экспорт;
Перем ОбъектИдентификатор Экспорт;
Перем ПулИдентификатор Экспорт;
Перем НеПрисылать Экспорт;
Перем СнятыеСобытия Экспорт;
Перем ОтборТегов Экспорт;
Перем КемИдентификатор Экспорт;
Перем Создана Экспорт;
Перем Обновлена Экспорт;

// Передаёт запись фейковому хранилищу (контракт autumn-data).
//
Процедура Сохранить() Экспорт
	Хранилище_.Принять(ЭтотОбъект);
КонецПроцедуры

// Снимает запись из фейкового хранилища (контракт autumn-data).
//
Процедура Удалить() Экспорт
	Хранилище_.Снять(ЭтотОбъект);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Хранилище)
	Хранилище_ = Хранилище;
	Идентификатор = 0;
	ПодпискаИдентификатор = 0;
	ТипОбъекта = "";
	ОбъектИдентификатор = 0;
	ПулИдентификатор = 0;
	НеПрисылать = Ложь;
	СнятыеСобытия = "";
	ОтборТегов = "";
	КемИдентификатор = 0;
КонецПроцедуры
