// Шпион ТелоСообщенияTelegram для настоящего транспорта: запоминает, что транспорт отдал
// сборщику тела, собирает тело настоящим сборщиком и обрывает отправку до сети.

Перем Тела;       // ТелоСообщенияTelegram — настоящий сборщик тела
Перем Собранные;  // Массив из Структура {ЧатИд, Текст, АдресПревью, Тело}

// Контракт ТелоСообщенияTelegram: тело запроса sendMessage. Отправку обрывает исключением —
// в сеть регрессия не ходит.
//
// Параметры:
//  ЧатИд - Строка - идентификатор чата.
//  Текст - Строка - текст сообщения.
//  АдресПревью - Строка - адрес карточки превью (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - не возвращается: вызов всегда бросает исключение.
//
Функция Сообщение(Знач ЧатИд, Знач Текст, Знач АдресПревью = "") Экспорт

	Собранные.Добавить(Новый Структура("ЧатИд, Текст, АдресПревью, Тело",
		ЧатИд, Текст, АдресПревью, Тела.Сообщение(ЧатИд, Текст, АдресПревью)));
	ВызватьИсключение "ШпионТелаСообщенияTelegram: тело собрано, в сеть запрос не уходит";

КонецФункции

// Последнее собранное тело с аргументами сборки.
//
// Возвращаемое значение:
//  Структура, Неопределено - ЧатИд, Текст, АдресПревью, Тело; Неопределено — сборок не было.
//
Функция Последнее() Экспорт
	Возврат ?(Собранные.Количество() = 0, Неопределено, Собранные[Собранные.Количество() - 1]);
КонецФункции

Процедура ПриСозданииОбъекта(Знач НастоящийСборщик)
	Тела = НастоящийСборщик;
	Собранные = Новый Массив();
КонецПроцедуры
