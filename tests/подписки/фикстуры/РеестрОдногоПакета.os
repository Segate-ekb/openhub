// Реестр из одного пакета на три двери, которыми доставка дочитывает автора версии, адрес
// репозитория, страницу релиза и запустившего конвейер: СервисПакетов, СервисВерсий и
// СервисЗапусковКонвейеров. Считает обращения к ним.

Перем Пакет;      // Структура — Идентификатор, АдресРепозитория
Перем Версии;     // Соответствие: строка версии -> Структура (Версия, АвторМанифеста, Релиз, ЗапустившийGitHub)
Перем Обращений_; // Число — обращения к обеим дверям
Перем Сбой;       // Строка — текст исключения, которым падает каждое обращение; "" — не падать

// Добавляет версию пакета.
//
// Параметры:
//  СтрокаВерсии - Строка - версия.
//  Автор - Строка - автор из манифеста версии.
//  Релиз - Строка - страница релиза из запуска конвейера (необязательный, по умолчанию "").
//  ЗапустившийGitHub - Строка - логин запустившего конвейер на github.com
//                      (необязательный, по умолчанию "").
//
Процедура ДобавитьВерсию(Знач СтрокаВерсии, Знач Автор, Знач Релиз = "", Знач ЗапустившийGitHub = "") Экспорт
	Версии.Вставить(СтрокаВерсии, Новый Структура("Версия, АвторМанифеста, Релиз, ЗапустившийGitHub",
		СтрокаВерсии, Автор, Релиз, ЗапустившийGitHub));
КонецПроцедуры

// Переводит реестр в режим сбоя: каждое обращение бросает исключение с этим текстом.
//
// Параметры:
//  Текст - Строка - текст исключения.
//
Процедура ЭмулироватьСбой(Знач Текст) Экспорт
	Сбой = Текст;
КонецПроцедуры

// Сколько раз реестр спросили о пакете или версии.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Обращений_;
КонецФункции

// Контракт СервисаПакетов: пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено - пакет либо Неопределено для чужого идентификатора.
//
Функция ПакетПоИдентификатору(Знач Идентификатор) Экспорт
	Обратиться();
	Возврат ?(Цел(Идентификатор) = Пакет.Идентификатор, Пакет, Неопределено);
КонецФункции

// Контракт СервисаВерсий: версия пакета по точной строке.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  СтрокаВерсии - Строка - версия.
//
// Возвращаемое значение:
//  Структура, Неопределено - версия либо Неопределено, если её нет.
//
Функция НайтиВерсию(Знач ПакетИдентификатор, Знач СтрокаВерсии) Экспорт
	Обратиться();
	Если Цел(ПакетИдентификатор) <> Пакет.Идентификатор Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Версии.Получить(СтрокаВерсии);
КонецФункции

// Контракт СервисаЗапусковКонвейеров: страница релиза версии.
//
// Параметры:
//  Версия - Структура - версия, найденная НайтиВерсию.
//
// Возвращаемое значение:
//  Строка - страница релиза; "" — версия не из релиза.
//
Функция АдресРелиза(Знач Версия) Экспорт
	Обратиться();
	Возврат ?(Версия = Неопределено, "", Версия.Релиз);
КонецФункции

// Контракт СервисаЗапусковКонвейеров: логин запустившего конвейер на github.com. Пул и пакет
// реестр из одного пакета не различает — версия ищется по строке.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  СтрокаВерсии - Строка - версия.
//
// Возвращаемое значение:
//  Строка - логин; "" — версии нет или её принял не конвейер github.com.
//
Функция ЗапустившийGitHub(Знач ИмяПула, Знач ИмяПакета, Знач СтрокаВерсии) Экспорт
	Обратиться();
	Версия = Версии.Получить(СтрокаВерсии);
	Возврат ?(Версия = Неопределено, "", Версия.ЗапустившийGitHub);
КонецФункции

Процедура Обратиться()
	Обращений_ = Обращений_ + 1;
	Если ЗначениеЗаполнено(Сбой) Тогда
		ВызватьИсключение Сбой;
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Идентификатор, Знач АдресРепозитория)
	Пакет = Новый Структура("Идентификатор, АдресРепозитория", Цел(Идентификатор), АдресРепозитория);
	Версии = Новый Соответствие();
	Обращений_ = 0;
	Сбой = "";
КонецПроцедуры
