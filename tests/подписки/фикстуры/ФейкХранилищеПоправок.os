// Фейковое хранилище поправок подписок в памяти: контракт ХранилищаПоправокПодписок без базы.

Перем Записи;
Перем СледИд;

// Контракт репозитория: новая несохранённая запись, привязанная к этому хранилищу.
//
// Возвращаемое значение:
//  ФейкПоправкаЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкПоправкаЗапись(ЭтотОбъект);
КонецФункции

// Приём записи от Запись.Сохранить(): новой присваивает идентификатор, сохранённую не дублирует.
//
// Параметры:
//  Запись - ФейкПоправкаЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт
	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Запись);
	КонецЕсли;
КонецПроцедуры

// Снятие записи от Запись.Удалить(). Отсутствие записи в списке не ошибка.
//
// Параметры:
//  Запись - ФейкПоправкаЗапись - удаляемая запись.
//
Процедура Снять(Знач Запись) Экспорт
	Индекс = Записи.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		Записи.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

// Все записи хранилища.
//
// Возвращаемое значение:
//  Массив из ФейкПоправкаЗапись.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Контракт хранилища: поправки подписки.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ФейкПоправкаЗапись.
//
Функция ПоПодписке(Знач ПодпискаИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПодпискаИдентификатор = Цел(ПодпискаИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт хранилища: поправки нижестоящего объекта.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  Массив из ФейкПоправкаЗапись.
//
Функция ПоОбъекту(Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ТипОбъекта = НРег(СокрЛП(ТипОбъекта))
			И Запись.ОбъектИдентификатор = Цел(ОбъектИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт хранилища: поправка пары «подписка — объект».
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  ФейкПоправкаЗапись, Неопределено.
//
Функция ПоПаре(Знач ПодпискаИдентификатор, Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Для Каждого Запись Из ПоОбъекту(ТипОбъекта, ОбъектИдентификатор) Цикл
		Если Запись.ПодпискаИдентификатор = Цел(ПодпискаИдентификатор) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Контракт хранилища: поправки объектов пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкПоправкаЗапись.
//
Функция ПоПулу(Знач ПулИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПулИдентификатор = Цел(ПулИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
КонецПроцедуры
