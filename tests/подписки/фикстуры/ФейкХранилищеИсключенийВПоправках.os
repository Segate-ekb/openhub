// Фейковое хранилище исключений в поправках в памяти: контракт ХранилищаИсключенийВПоправках без
// базы; считает выборки по пакету — их делает доставка на каждое событие.

Перем Записи;
Перем СледИд;
Перем ВыборокПоПакету;

// Контракт репозитория: новая несохранённая запись, привязанная к этому хранилищу.
//
// Возвращаемое значение:
//  ФейкИсключениеВПоправкеЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкИсключениеВПоправкеЗапись(ЭтотОбъект);
КонецФункции

// Приём записи от Запись.Сохранить(): новой присваивает идентификатор, сохранённую не дублирует.
//
// Параметры:
//  Запись - ФейкИсключениеВПоправкеЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт
	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Запись);
	КонецЕсли;
КонецПроцедуры

// Снятие записи от Запись.Удалить(). Отсутствие записи в списке не ошибка.
//
// Параметры:
//  Запись - ФейкИсключениеВПоправкеЗапись - удаляемая запись.
//
Процедура Снять(Знач Запись) Экспорт
	Индекс = Записи.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		Записи.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

// Все записи хранилища.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеВПоправкеЗапись.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Сколько раз хранилище спросили об исключениях пакета.
//
// Возвращаемое значение:
//  Число.
//
Функция ВыборокПоПакету() Экспорт
	Возврат ВыборокПоПакету;
КонецФункции

// Контракт хранилища: исключения в поправках к подписке.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеВПоправкеЗапись.
//
Функция ПоПодписке(Знач ПодпискаИдентификатор) Экспорт
	Возврат Отобранные("ПодпискаИдентификатор", ПодпискаИдентификатор);
КонецФункции

// Контракт хранилища: исключения в поправке пула к подписке.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеВПоправкеЗапись.
//
Функция ПоПоправке(Знач ПодпискаИдентификатор, Знач ПулИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Отобранные("ПодпискаИдентификатор", ПодпискаИдентификатор) Цикл
		Если Запись.ПулИдентификатор = Цел(ПулИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт хранилища: исключения пакета во всех поправках.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеВПоправкеЗапись.
//
Функция ПоПакету(Знач ПакетИдентификатор) Экспорт
	ВыборокПоПакету = ВыборокПоПакету + 1;
	Возврат Отобранные("ПакетИдентификатор", ПакетИдентификатор);
КонецФункции

// Контракт хранилища: исключения пакетов пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеВПоправкеЗапись.
//
Функция ПоПулу(Знач ПулИдентификатор) Экспорт
	Возврат Отобранные("ПулИдентификатор", ПулИдентификатор);
КонецФункции

Функция Отобранные(Знач Поле, Знач Значение)
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если ЗначениеПоля(Запись, Поле) = Цел(Значение) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗначениеПоля(Знач Запись, Знач Поле)
	Если Поле = "ПодпискаИдентификатор" Тогда
		Возврат Запись.ПодпискаИдентификатор;
	ИначеЕсли Поле = "ПулИдентификатор" Тогда
		Возврат Запись.ПулИдентификатор;
	КонецЕсли;
	Возврат Запись.ПакетИдентификатор;
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
	ВыборокПоПакету = 0;
КонецПроцедуры
