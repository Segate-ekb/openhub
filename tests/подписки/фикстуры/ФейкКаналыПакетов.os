// Фейк двух дверей реестра, которыми отбор по тегам пользуется: каналы, в составе которых версия
// (КаналыПоУмолчанию), и имена тегов пакета и пула, из которых выбирают отбор (СервисТегов).
// Правила — настоящие ПравилоТега, ручной состав — перечнем версий; теги пула — только имена,
// пакетам они не наследуются.

Перем Правила;     // Соответствие: идентификатор пакета -> Соответствие (имя -> ПравилоТега)
Перем Ручные;      // Соответствие: идентификатор пакета -> Соответствие (имя -> Массив версий)
Перем ТегиПулов;   // Соответствие: идентификатор пула -> Массив имён
Перем Обращений_;  // Число — сколько раз спросили каналы версии

// Заводит пакету тег-правило.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  ТипПравила - Строка - semver | regex.
//  Выражение - Строка - выражение правила.
//
Процедура ЗавестиПравило(Знач ПакетИдентификатор, Знач Имя, Знач ТипПравила, Знач Выражение) Экспорт
	ТегиПакета(Правила, ПакетИдентификатор).Вставить(НРег(Имя), Новый ПравилоТега(ТипПравила, Выражение));
КонецПроцедуры

// Заводит пакету ручной тег с составом.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  ВерсииCSV - Строка - помеченные версии через запятую.
//
Процедура ЗавестиРучной(Знач ПакетИдентификатор, Знач Имя, Знач ВерсииCSV) Экспорт
	ТегиПакета(Ручные, ПакетИдентификатор).Вставить(НРег(Имя), СтрРазделить(ВерсииCSV, ",", Ложь));
КонецПроцедуры

// Заводит пулу тег пула — имя в перечне, из которого выбирают отбор подписки пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега.
//
Процедура ЗавестиТегПула(Знач ПулИдентификатор, Знач Имя) Экспорт
	ИменаПула(ПулИдентификатор).Добавить(НРег(Имя));
КонецПроцедуры

// Снимает тег пула — как удаление тега в разделе тегов пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега.
//
Процедура СнятьТегПула(Знач ПулИдентификатор, Знач Имя) Экспорт
	Имена = ИменаПула(ПулИдентификатор);
	Индекс = Имена.Найти(НРег(Имя));
	Если Индекс <> Неопределено Тогда
		Имена.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

// Контракт КаналыПоУмолчанию: каналы пакета, в составе которых версия.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  СтрокаВерсии - Строка - версия.
//
// Возвращаемое значение:
//  Массив из Строка - имена тегов.
//
Функция КаналыВерсии(Знач ПакетИдентификатор, Знач СтрокаВерсии) Экспорт

	Обращений_ = Обращений_ + 1;
	Результат = Новый Массив();
	Для Каждого КиЗ Из ТегиПакета(Правила, ПакетИдентификатор) Цикл
		Если КиЗ.Значение.ПодходитСтрока(СтрокаВерсии) Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КиЗ Из ТегиПакета(Ручные, ПакетИдентификатор) Цикл
		Если КиЗ.Значение.Найти(СтрокаВерсии) <> Неопределено Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контракт СервисТегов: имена тегов пакета — правила и ручные теги.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из Строка - имена тегов.
//
Функция ИменаТеговПакета(Знач ПакетИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого КиЗ Из ТегиПакета(Правила, ПакетИдентификатор) Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Для Каждого КиЗ Из ТегиПакета(Ручные, ПакетИдентификатор) Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт СервисТегов: имена тегов пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из Строка - имена тегов.
//
Функция ИменаТеговПула(Знач ПулИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Имя Из ИменаПула(ПулИдентификатор) Цикл
		Результат.Добавить(Имя);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Сколько раз отбор спросил каналы версии.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Обращений_;
КонецФункции

Функция ТегиПакета(Знач Где, Знач ПакетИдентификатор)
	Теги = Где.Получить(Цел(ПакетИдентификатор));
	Если Теги = Неопределено Тогда
		Теги = Новый Соответствие();
		Где.Вставить(Цел(ПакетИдентификатор), Теги);
	КонецЕсли;
	Возврат Теги;
КонецФункции

Функция ИменаПула(Знач ПулИдентификатор)
	Имена = ТегиПулов.Получить(Цел(ПулИдентификатор));
	Если Имена = Неопределено Тогда
		Имена = Новый Массив();
		ТегиПулов.Вставить(Цел(ПулИдентификатор), Имена);
	КонецЕсли;
	Возврат Имена;
КонецФункции

Процедура ПриСозданииОбъекта()
	Правила = Новый Соответствие();
	Ручные = Новый Соответствие();
	ТегиПулов = Новый Соответствие();
	Обращений_ = 0;
КонецПроцедуры
