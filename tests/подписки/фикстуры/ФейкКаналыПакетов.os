// Фейк двух дверей реестра, которыми отбор по тегам пользуется: каналы, в составе которых версия
// (КаналыПоУмолчанию), и допустимость имени тега (СервисТегов). Правила — настоящие ПравилоТега,
// ручной состав — перечнем версий.

Перем Правила;     // Соответствие: идентификатор пакета -> Соответствие (имя -> ПравилоТега)
Перем Ручные;      // Соответствие: идентификатор пакета -> Соответствие (имя -> Массив версий)
Перем Обращений_;  // Число — сколько раз спросили каналы версии

// Заводит пакету тег-правило.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  ТипПравила - Строка - semver | regex.
//  Выражение - Строка - выражение правила.
//
Процедура ЗавестиПравило(Знач ПакетИдентификатор, Знач Имя, Знач ТипПравила, Знач Выражение) Экспорт
	ТегиПакета(Правила, ПакетИдентификатор).Вставить(НРег(Имя), Новый ПравилоТега(ТипПравила, Выражение));
КонецПроцедуры

// Заводит пакету ручной тег с составом.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  ВерсииCSV - Строка - помеченные версии через запятую.
//
Процедура ЗавестиРучной(Знач ПакетИдентификатор, Знач Имя, Знач ВерсииCSV) Экспорт
	ТегиПакета(Ручные, ПакетИдентификатор).Вставить(НРег(Имя), СтрРазделить(ВерсииCSV, ",", Ложь));
КонецПроцедуры

// Контракт КаналыПоУмолчанию: каналы пакета, в составе которых версия.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  СтрокаВерсии - Строка - версия.
//  Публикуется - Булево - событие — публикация; состав от него не зависит (необязательный,
//                по умолчанию Ложь).
//
// Возвращаемое значение:
//  Массив из Строка - имена тегов.
//
Функция КаналыВерсии(Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Публикуется = Ложь) Экспорт

	Обращений_ = Обращений_ + 1;
	Результат = Новый Массив();
	Для Каждого КиЗ Из ТегиПакета(Правила, ПакетИдентификатор) Цикл
		Если КиЗ.Значение.ПодходитСтрока(СтрокаВерсии) Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КиЗ Из ТегиПакета(Ручные, ПакетИдентификатор) Цикл
		Если КиЗ.Значение.Найти(СтрокаВерсии) <> Неопределено Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контракт СервисТегов: допустимо ли имя тега — латиница, цифры, дефис, подчёркивание, точка.
//
// Параметры:
//  Имя - Строка - имя тега.
//
// Возвращаемое значение:
//  Булево.
//
Функция ИмяДопустимо(Знач Имя) Экспорт
	Возврат Новый РегулярноеВыражение("^[a-z0-9._-]{1,64}$").Совпадает(НРег(СокрЛП(Имя)));
КонецФункции

// Сколько раз отбор спросил каналы версии.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Обращений_;
КонецФункции

Функция ТегиПакета(Знач Где, Знач ПакетИдентификатор)
	Теги = Где.Получить(Цел(ПакетИдентификатор));
	Если Теги = Неопределено Тогда
		Теги = Новый Соответствие();
		Где.Вставить(Цел(ПакетИдентификатор), Теги);
	КонецЕсли;
	Возврат Теги;
КонецФункции

Процедура ПриСозданииОбъекта()
	Правила = Новый Соответствие();
	Ручные = Новый Соответствие();
	Обращений_ = 0;
КонецПроцедуры
