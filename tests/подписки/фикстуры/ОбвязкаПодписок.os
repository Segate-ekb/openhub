// Общее для наборов подписок без контейнера: админ хаба, пул как объект подписки, учётки
// с признаком Админ, готовность хаба и имена объектов для журнала аудита.

Перем ПоискКлассов;  // фикстура КлассыСлоя

// Администратор хаба, от чьего имени заводят подписки.
//
// Возвращаемое значение:
//  Структура - Идентификатор (100), Админ (Истина).
//
Функция АдминХаба() Экспорт
	Возврат Новый Структура("Идентификатор, Админ", 100, Истина);
КонецФункции

// Пул как объект подписки: имя выводится из идентификатора.
//
// Параметры:
//  Сервис - СервисПодписок - служба, описывающая объект.
//  Ид - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Структура - описание объекта в формате СервисаПрав.
//
Функция ОбъектПула(Знач Сервис, Знач Ид) Экспорт
	Возврат Сервис.ОбъектПула(Новый Структура("Идентификатор, Имя", Ид, "пул-" + Формат(Ид, "ЧГ=0")));
КонецФункции

// Отказала ли служба в создании подписки.
//
// Параметры:
//  Сервис - СервисПодписок - служба подписок.
//  Кто - Произвольный - учётка создателя.
//  Объект - Структура - объект подписки.
//  URL - Строка - адрес доставки.
//  Типы - Массив из Строка - типы событий.
//
// Возвращаемое значение:
//  Булево - Истина, если создание бросило исключение.
//
Функция СозданиеОтклонено(Знач Сервис, Знач Кто, Знач Объект, Знач URL, Знач Типы) Экспорт
	Попытка
		Сервис.Создать(Кто, Объект, URL, Типы);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Служба учёток, у которой любой идентификатор — учётка, а названные — администраторы.
//
// Параметры:
//  АдминыCSV - Строка - идентификаторы администраторов через запятую.
//
// Возвращаемое значение:
//  СервисПользователейЗаглушка.
//
Функция УчёткиСАдминами(Знач АдминыCSV) Экспорт
	Учётки = Новый СервисПользователейЗаглушка();
	Учётки.ОтвечатьУчётками(АдминыCSV);
	Возврат Учётки;
КонецФункции

// Готовность хаба для подписчика событий.
//
// Параметры:
//  Лог - Лог - лог готовности.
//
// Возвращаемое значение:
//  ГотовностьХаба.
//
Функция Готовность(Знач Лог) Экспорт
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули", "наблюдаемость"),
		"ГотовностьХаба");
	Возврат Новый ГотовностьХаба(Лог);
КонецФункции

// Имена объектов журнала аудита на фейковых таблицах: пул 7 «public» и пакет 42 «oint» в нём.
//
// Возвращаемое значение:
//  ИмяОбъектаАудита.
//
Функция ИменаЖурнала() Экспорт
	Пулы = Новый ФейкХранилищеСущностей();
	Пулы.Добавить(Новый ФейкСущностьАудита(7, "public"));
	Пакеты = Новый ФейкХранилищеСущностей();
	Пакеты.Добавить(Новый ФейкСущностьАудита(42, "oint", 7));
	Называющие = Новый Массив();
	Называющие.Добавить(Новый ИменаОбъектовРеестра(Пулы, Пакеты));
	Возврат Новый ИмяОбъектаАудита(Называющие);
КонецФункции

Процедура ПриСозданииОбъекта(Знач _ПоискКлассов)
	ПоискКлассов = _ПоискКлассов;
	РеестрФикстур.Подключить("СервисПользователейЗаглушка");
	РеестрФикстур.Подключить("ФейкХранилищеСущностей");
	РеестрФикстур.Подключить("ФейкСущностьАудита");
КонецПроцедуры
