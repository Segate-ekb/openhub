// Фейк СервисаПрав с правами по объектам: администратор хаба (признак Админ) вправе всё,
// остальным действия выдаются на пул или пакет; право на пул наследует каждый его пакет.

Перем Выданные;   // Соответствие: "<пользователь>|<тип>|<ид>|<действие>" -> Истина

// Выдаёт пользователю действия на объект.
//
// Параметры:
//  Пользователь - Структура - субъект с полем Идентификатор.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  Идентификатор - Число - идентификатор объекта.
//  ДействияCSV - Строка - действия модели прав через запятую.
//
Процедура Выдать(Знач Пользователь, Знач ТипОбъекта, Знач Идентификатор, Знач ДействияCSV) Экспорт
	Для Каждого Действие Из СтрРазделить(ДействияCSV, ",", Ложь) Цикл
		Выданные.Вставить(Ключ(Пользователь.Идентификатор, ТипОбъекта, Идентификатор, Действие), Истина);
	КонецЦикла;
КонецПроцедуры

// Контракт СервисаПрав: разрешено ли действие над объектом.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//  Действие - Строка - действие модели прав.
//  Объект - Структура - ТипОбъекта, Идентификатор, ПулИдентификатор.
//
// Возвращаемое значение:
//  Булево.
//
Функция РазрешеноДействие(Знач Пользователь, Знач Действие, Знач Объект) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПользовательАдмин(Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;

	Тип = НРег(СокрЛП(Объект.ТипОбъекта));
	Если Выданные.Получить(Ключ(Пользователь.Идентификатор, Тип, Объект.Идентификатор, Действие)) = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Тип = "пакет"
		И Выданные.Получить(Ключ(Пользователь.Идентификатор, "пул", Объект.ПулИдентификатор, Действие)) = Истина;

КонецФункции

// Контракт СервисаПрав: администратор ли хаба.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПользовательАдмин(Знач Пользователь) Экспорт
	Возврат Пользователь <> Неопределено И Пользователь.Свойство("Админ") И Пользователь.Админ = Истина;
КонецФункции

// Контракт СервисаПрав: нормализованное описание объекта.
//
// Параметры:
//  ТипОбъекта - Строка - тип объекта.
//  Идентификатор - Число - идентификатор объекта.
//  ПулИдентификатор - Число - пул объекта (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Структура - ТипОбъекта, Идентификатор, ПулИдентификатор.
//
Функция ОписаниеОбъекта(Знач ТипОбъекта, Знач Идентификатор, Знач ПулИдентификатор = 0) Экспорт
	Возврат Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор",
		НРег(СокрЛП(Строка(ТипОбъекта))), Цел(Идентификатор), Цел(ПулИдентификатор));
КонецФункции

// Контракт СервисаПрав: описание объекта «хаб».
//
// Возвращаемое значение:
//  Структура.
//
Функция ОбъектХаб() Экспорт
	Возврат ОписаниеОбъекта("хаб", 0, 0);
КонецФункции

// Контракт СервисаПрав: описание объекта «пул».
//
// Параметры:
//  Пул - Структура - пул с полем Идентификатор.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОбъектПул(Знач Пул) Экспорт
	Возврат ОписаниеОбъекта("пул", Пул.Идентификатор, Пул.Идентификатор);
КонецФункции

// Контракт СервисаПрав: описание объекта «пакет».
//
// Параметры:
//  Пакет - Структура - пакет с полями Идентификатор и ПулИдентификатор.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОбъектПакет(Знач Пакет) Экспорт
	Возврат ОписаниеОбъекта("пакет", Пакет.Идентификатор, Пакет.ПулИдентификатор);
КонецФункции

Функция Ключ(Знач Пользователь, Знач Тип, Знач Идентификатор, Знач Действие)
	Возврат СтрШаблон("%1|%2|%3|%4", Формат(Цел(Пользователь), "ЧГ=0; ЧН=0"), НРег(СокрЛП(Тип)),
		Формат(Цел(Идентификатор), "ЧГ=0; ЧН=0"), НРег(СокрЛП(Действие)));
КонецФункции

Процедура ПриСозданииОбъекта()
	Выданные = Новый Соответствие();
КонецПроцедуры
