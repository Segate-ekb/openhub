// Фейковое хранилище исключений подписок в памяти: контракт ХранилищаИсключенийПодписок без базы;
// считает выборки по узлу — их делает доставка на каждое событие.

Перем Счётчик_;  // СчётчикОбращений — обращения и прочитанные строки (цена экранов)
Перем Записи;
Перем СледИд;
Перем ВыборокПоУзлу;
Перем СбойНа;       // Число — на какой по счёту записи или снятии хранилище «падает»; 0 — не падает
Перем Мутаций;      // Число — записей и снятий с последнего Сбоить

// Контракт репозитория: новая несохранённая запись, привязанная к этому хранилищу.
//
// Возвращаемое значение:
//  ФейкИсключениеЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкИсключениеЗапись(ЭтотОбъект);
КонецФункции

// Приём записи от Запись.Сохранить(): новой присваивает идентификатор, сохранённую не дублирует.
//
// Параметры:
//  Запись - ФейкИсключениеЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт
	ПроверитьСбой();
	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Запись);
	КонецЕсли;
КонецПроцедуры

// Снятие записи от Запись.Удалить(). Отсутствие записи в списке не ошибка.
//
// Параметры:
//  Запись - ФейкИсключениеЗапись - удаляемая запись.
//
Процедура Снять(Знач Запись) Экспорт
	ПроверитьСбой();
	Индекс = Записи.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		Записи.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

// Все записи хранилища.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Сколько раз хранилище спросили об исключениях узла.
//
// Возвращаемое значение:
//  Число.
//
Функция ВыборокПоУзлу() Экспорт
	Возврат ВыборокПоУзлу;
КонецФункции

// Контракт хранилища: исключения подписки.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция ПоПодписке(Знач ПодпискаИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПодпискаИдентификатор = Цел(ПодпискаИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик_.Отдать(Результат, "ПоПодписке");
КонецФункции

// Контракт хранилища: исключения узла во всех подписках.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция ПоОбъекту(Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	ВыборокПоУзлу = ВыборокПоУзлу + 1;
	Возврат Счётчик_.Отдать(Отобранные(ТипОбъекта, ОбъектИдентификатор), "ПоОбъекту");
КонецФункции

// Контракт хранилища: исключение пары «подписка — узел».
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  ФейкИсключениеЗапись, Неопределено.
//
Функция ПоПаре(Знач ПодпискаИдентификатор, Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Для Каждого Запись Из Отобранные(ТипОбъекта, ОбъектИдентификатор) Цикл
		Если Запись.ПодпискаИдентификатор = Цел(ПодпискаИдентификатор) Тогда
			Возврат Счётчик_.ОтдатьОдну(Запись, "ПоПаре");
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик_.ОтдатьОдну(Неопределено, "ПоПаре");
КонецФункции

// Контракт хранилища: исключения узлов пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция ПоПулу(Знач ПулИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПулИдентификатор = Цел(ПулИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик_.Отдать(Результат, "ПоПулу");
КонецФункции

// Контракт хранилища: исключения узлов одного типа во всех подписках.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция ПоТипу(Знач ТипОбъекта) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ТипОбъекта = НРег(СокрЛП(ТипОбъекта)) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик_.Отдать(Результат, "ПоТипу");
КонецФункции

// Контракт хранилища: выборка по перечню подписок.
//
// Параметры:
//  ПодпискаИдентификаторы - Массив из Число - идентификаторы подписок.
//
// Возвращаемое значение:
//  Массив.
//
Функция ПоПодпискам(Знач ПодпискаИдентификаторы) Экспорт
	Названные = Новый Соответствие();
	Для Каждого Идентификатор Из ПодпискаИдентификаторы Цикл
		Названные.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;
	Результат = Новый Массив();
	Если Названные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Запись Из Записи Цикл
		Если Названные.Получить(Запись.ПодпискаИдентификатор) <> Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик_.Отдать(Результат, "ПоПодпискам");
КонецФункции

Функция Отобранные(Знач ТипОбъекта, Знач ОбъектИдентификатор)
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ТипОбъекта = НРег(СокрЛП(ТипОбъекта))
			И Запись.ОбъектИдентификатор = Цел(ОбъектИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Обрыв записи посреди работы: хранилище бросает исключение на Номер-й записи или снятии, считая
// с этого вызова, — как база, упавшая по busy посреди перевода. 0 — больше не падать.
//
// Параметры:
//  Номер - Число - номер мутации, на которой бросить; 0 — не бросать.
//
Процедура Сбоить(Знач Номер) Экспорт
	СбойНа = Номер;
	Мутаций = 0;
КонецПроцедуры

Процедура ПроверитьСбой()
	Мутаций = Мутаций + 1;
	Если СбойНа > 0 И Мутаций = СбойНа Тогда
		ВызватьИсключение СтрШаблон("Обрыв записи на %1-й мутации", СбойНа);
	КонецЕсли;
КонецПроцедуры

// Счётчик обращений к хранилищу: сколько выборок и прочитанных строк стоил экран.
//
// Возвращаемое значение:
//  СчётчикОбращений.
//
Функция Счётчик() Экспорт
	Возврат Счётчик_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
	ВыборокПоУзлу = 0;
	СбойНа = 0;
	Мутаций = 0;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик_ = Новый СчётчикОбращений();
КонецПроцедуры
