// Фейковое хранилище исключений подписок в памяти: контракт ХранилищаИсключенийПодписок без базы;
// считает выборки по узлу — их делает доставка на каждое событие.

Перем Записи;
Перем СледИд;
Перем ВыборокПоУзлу;

// Контракт репозитория: новая несохранённая запись, привязанная к этому хранилищу.
//
// Возвращаемое значение:
//  ФейкИсключениеЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкИсключениеЗапись(ЭтотОбъект);
КонецФункции

// Приём записи от Запись.Сохранить(): новой присваивает идентификатор, сохранённую не дублирует.
//
// Параметры:
//  Запись - ФейкИсключениеЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт
	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Запись);
	КонецЕсли;
КонецПроцедуры

// Снятие записи от Запись.Удалить(). Отсутствие записи в списке не ошибка.
//
// Параметры:
//  Запись - ФейкИсключениеЗапись - удаляемая запись.
//
Процедура Снять(Знач Запись) Экспорт
	Индекс = Записи.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		Записи.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

// Все записи хранилища.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Сколько раз хранилище спросили об исключениях узла.
//
// Возвращаемое значение:
//  Число.
//
Функция ВыборокПоУзлу() Экспорт
	Возврат ВыборокПоУзлу;
КонецФункции

// Контракт хранилища: исключения подписки.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция ПоПодписке(Знач ПодпискаИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПодпискаИдентификатор = Цел(ПодпискаИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт хранилища: исключения узла во всех подписках.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция ПоОбъекту(Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	ВыборокПоУзлу = ВыборокПоУзлу + 1;
	Возврат Отобранные(ТипОбъекта, ОбъектИдентификатор);
КонецФункции

// Контракт хранилища: исключение пары «подписка — узел».
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  ФейкИсключениеЗапись, Неопределено.
//
Функция ПоПаре(Знач ПодпискаИдентификатор, Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Для Каждого Запись Из Отобранные(ТипОбъекта, ОбъектИдентификатор) Цикл
		Если Запись.ПодпискаИдентификатор = Цел(ПодпискаИдентификатор) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Контракт хранилища: исключения узлов пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкИсключениеЗапись.
//
Функция ПоПулу(Знач ПулИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПулИдентификатор = Цел(ПулИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Отобранные(Знач ТипОбъекта, Знач ОбъектИдентификатор)
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ТипОбъекта = НРег(СокрЛП(ТипОбъекта))
			И Запись.ОбъектИдентификатор = Цел(ОбъектИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
	ВыборокПоУзлу = 0;
КонецПроцедуры
