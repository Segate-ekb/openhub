// Тестовое описание хранения типа действия «тест.запись»: настройки {Канал} плюс произвольная
// {Метка} в JSON-колонке НастройкиДействия — новых колонок сущности такой тип не требует.

// Контракт описания хранения: тип действия.
//
// Возвращаемое значение:
//  Строка - "тест.запись".
//
Функция ТипДействия() Экспорт
	Возврат "тест.запись";
КонецФункции

// Превращает доменный ввод формы в поля подписки.
//
// Параметры:
//  Ввод - Структура - Канал (обязательный) и произвольная Метка.
//
// Возвращаемое значение:
//  Структура - Адрес, Секрет, НастройкиДействия (JSON с меткой); без канала — исключение.
//
Функция ПодготовитьНастройки(Знач Ввод) Экспорт

	Канал = "";
	Если НЕ (Ввод.Свойство("Канал", Канал) И ЗначениеЗаполнено(Канал)) Тогда
		ВызватьИсключение "Тестовое действие: не задан канал";
	КонецЕсли;

	Метка = "";
	Ввод.Свойство("Метка", Метка);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(Запись, Новый Структура("Метка", Строка(Метка)));

	Возврат Новый Структура("Адрес, Секрет, НастройкиДействия",
		Строка(Канал), "", Запись.Закрыть());

КонецФункции

// Настройки доставки из записи подписки.
//
// Параметры:
//  Подписка - Произвольный - запись подписки.
//
// Возвращаемое значение:
//  Структура - Канал, Метка; при нечитаемом JSON метка пуста.
//
Функция НастройкиДоставки(Знач Подписка) Экспорт

	Метка = "";
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Подписка.НастройкиДействия));
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Данные.Свойство("Метка", Метка);
	Исключение
		Метка = "";
	КонецПопытки;

	Возврат Новый Структура("Канал, Метка", Строка(Подписка.URL), Строка(Метка));

КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры
