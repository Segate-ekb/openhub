&Тест
Процедура ПоправкаПулаДействуетНаВсеЕгоПакетыАПакетСужаетДальше() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^[0-9.]+$");
	Мир.Каналы.ЗавестиПравило(43, "stable", "regex", "^[0-9.]+$");
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована,версия.отозвана", Истина);
	Сузить(Мир, ОбъектПула(Мир, 7), Хаба, Новый Структура("ОтборТегов", Теги("stable")));
	Сузить(Мир, ОбъектПакета(Мир, 43, 7), Хаба, Новый Структура("ОставленныеСобытия", "версия.опубликована"));

	Опубликовать(Мир, 7, 42, "1.0.0-rc1");
	Опубликовать(Мир, 7, 43, "1.0.0-rc1");
	Ожидаем.Что(Доставок(Мир), "пререлизы обоих пакетов пула отсеяны поправкой пула").Равно(0);
	Опубликовать(Мир, 7, 42, "1.0.0");
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "релизы обоих пакетов доставлены").Равно(2);
	Мир.Подписчик.ОбработатьСобытие(СобытиеВерсии("версия.отозвана", 7, 42, "1.0.0"));
	Мир.Подписчик.ОбработатьСобытие(СобытиеВерсии("версия.отозвана", 7, 43, "1.0.0"));
	Ожидаем.Что(Доставок(Мир), "отзыв пакета 43 снят его поправкой, пакета 42 — доставлен").Равно(3);

