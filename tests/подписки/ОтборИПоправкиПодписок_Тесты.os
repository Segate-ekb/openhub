&Тест
Процедура УдалениеПакетаИПулаУноситИхПоправки() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована", Истина);
	Сузить(Мир, ОбъектПула(Мир, 7), Хаба, Новый Структура("НеПрисылать", Истина));
	Сузить(Мир, ОбъектПакета(Мир, 42, 7), Хаба, Новый Структура("НеПрисылать", Истина));
	Сузить(Мир, ОбъектПакета(Мир, 43, 7), Хаба, Новый Структура("НеПрисылать", Истина));
	Сузить(Мир, ОбъектПула(Мир, 8), Хаба, Новый Структура("НеПрисылать", Истина));
	Последствия = Новый ПодпискиНаУдаляемое(Мир.Хранилище, Мир.ХранилищеПоправок,
		Новый ФейкХранилищеИсключений(), Новый СнятиеСтрок());

	Последствия.СнятьСтрокиПакета(Новый Структура("Идентификатор, ПулИдентификатор", 42, 7));
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "ушла поправка пакета 42").Равно(3);
	Итог = Последствия.СнятьСтрокиПула(Новый Структура("Идентификатор", 7));
	Ожидаем.Что(Итог.Строк, "сняты поправки пула 7 и его пакета").Равно(2);
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "осталась поправка пула 8").Равно(1);

