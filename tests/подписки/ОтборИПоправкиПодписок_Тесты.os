&Тест
Процедура ПовторнаяПоправкаПравитПрежнююАНеЗаводитВторую() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована", Истина);
	Пул = ОбъектПула(Мир, 7);
	Первая = Сузить(Мир, Пул, Хаба, Новый Структура("НеПрисылать", Истина)).Поправка;
	Вторая = Сузить(Мир, Пул, Хаба, Новый Структура("ОтборТегов", Теги("stable"))).Поправка;

	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "у пары одна поправка").Равно(1);
	Ожидаем.Что(Вторая.Идентификатор, "правится прежняя запись").Равно(Первая.Идентификатор);
	Ожидаем.Что(Вторая.НеПрисылать, "повтор заменил «не присылать» отбором").ЭтоЛожь();
	Ожидаем.Что(Вторая.ОтборТегов, "отбор лёг").Равно("stable");

