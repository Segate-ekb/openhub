// Отбор доставки по тегам и поправки нижестоящих объектов к подпискам хаба и пула — на фейках,
// без контейнера и базы: событие проходит подписчик, число доставок в очереди — то, что
// увидит адресат.

#Использовать asserts
#Использовать "../фикстуры"
#Использовать autumn-logos

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Обвязка;        // фикстура ОбвязкаПодписок — админ хаба, учётки, готовность, имена журнала
Перем СобытияХаба;    // фикстура КаталогСобытийХаба — перечень из описаний всех предметов
Перем КаталогВебхуков;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогВебхуков = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	КаталогОсновы = ОбъединитьПути(КаталогМодулей, "основа", "Классы");
	КаталогАудита = ОбъединитьПути(КаталогМодулей, "аудит", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	РеестрФикстур.Подключить("ОбвязкаПодписок");
	Обвязка = Новый ОбвязкаПодписок(ПоискКлассов);

	ПоискКлассов.ПодключитьВсе(КаталогОсновы);
	Для Каждого Имя Из СтрРазделить("СервисПодписок,СервисПоправокПодписок,ОтборПоТегам,ОтборДоставкиПодписок,"
		+ "ОтборЗаполненияПула,ПараметрыПодписки,ПодписчикВебхуков,ТелоСобытия,РеестрДействийПодписок,"
		+ "СлужбаДоставкиПодписок,ЧислаДоставки,ОчередьДоставокПодписок,ВалидаторАдресаВебхука,"
		+ "АудитПробыПодписки,ОграничительПроб,ДоставкаВебхуком,ХранениеПодпискиВебхука,"
		+ "ПодпискиНаУдаляемое", ",") Цикл
		ПоискКлассов.Подключить(КаталогВебхуков, Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ЗаполнениеПула,АдресаСтраниц,ИменаОбъектовРеестра,ТипПравилаТега,"
		+ "РазобраннаяВерсия,РазобранныйДиапазон,ПравилоТега", ",") Цикл
		ПоискКлассов.Подключить(КаталогРеестра, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "данные", "Классы"), "СнятиеСтрок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "АдресИнстанса");
	ПоискКлассов.Подключить(КаталогАудита, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогАудита, "СобытиеАудита");

	Для Каждого Имя Из СтрРазделить("ФейкХранилищеВебхуков,ФейкВебхукЗапись,ФейкХранилищеПоправок,"
		+ "ФейкПоправкаЗапись,ФейкХранилищеИсключений,ФейкИсключениеЗапись,ФейкКаналыПакетов,ПраваПоОбъектам,ФейкХранилищеЗаданийДоставки,"
		+ "ФейкЗаданиеДоставкиЗапись,ФейкТранспортHTTP,ФейкВалидаторВебхука,НастройкиЗаглушка,"
		+ "СервисПользователейЗаглушка,ФейкХранилищеСущностей,ФейкСущностьАудита,КаталогСобытийХаба", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;
	СобытияХаба = Новый КаталогСобытийХаба(ПоискКлассов, ОбъединитьПути(КаталогВебхуков, "..", ".."));

КонецПроцедуры

#Область ОтборПоТегам

&Тест
Процедура ПустойОтборДоставляетВсеВерсии() Экспорт

	Мир = НовыйМир();
	Подписка(Мир, ОбъектПула(Мир, 7), "", "версия.опубликована");

	Опубликовать(Мир, 7, 42, "1.0.0-nightly.5");
	Ожидаем.Что(Доставок(Мир), "без отбора доставляется любая версия").Равно(1);

КонецПроцедуры

&Тест
Процедура ВерсияПодПравиломSemverПроходитОтбор() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "lts");
	Мир.Каналы.ЗавестиПравило(42, "lts", "semver", "^1.0");
	Подписка(Мир, ОбъектПула(Мир, 7), "lts", "версия.опубликована");

	Опубликовать(Мир, 7, 42, "1.4.0");
	Ожидаем.Что(Доставок(Мир), "1.4.0 под ^1.0").Равно(1);
	Опубликовать(Мир, 7, 42, "2.0.0");
	Ожидаем.Что(Доставок(Мир), "2.0.0 вне ^1.0 — доставки нет").Равно(1);

КонецПроцедуры

&Тест
Процедура ВерсияПодПравиломRegexПроходитОтбор() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^[0-9]+\.[0-9]+\.[0-9]+$");
	Подписка(Мир, ОбъектПула(Мир, 7), "stable", "версия.опубликована");

	Опубликовать(Мир, 7, 42, "1.0.0-rc1");
	Ожидаем.Что(Доставок(Мир), "пререлиз вне stable").Равно(0);
	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "релиз под stable").Равно(1);

КонецПроцедуры

&Тест
Процедура РучнойТегОтбираетПоСвоемуСоставу() Экспорт

	// у только что опубликованной версии ручного состава нет, а у отзываемой — есть
	Мир = НовыйМир();
	Мир.Каналы.ЗавестиРучной(42, "lts", "1.2.0");
	Подписка(Мир, ОбъектПакета(Мир, 42, 7), "lts", "версия.опубликована,версия.отозвана");

	Опубликовать(Мир, 7, 42, "1.3.0");
	Ожидаем.Что(Доставок(Мир), "новая версия в ручной тег не входит").Равно(0);
	Мир.Подписчик.ОбработатьСобытие(СобытиеВерсии("версия.отозвана", 7, 42, "1.2.0"));
	Ожидаем.Что(Доставок(Мир), "отзыв версии из состава ручного тега доставлен").Равно(1);

КонецПроцедуры

&Тест
Процедура ИмяТегаСверяетсяБезУчётаРегистра() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^[0-9.]+$");
	Запись = Подписка(Мир, ОбъектПула(Мир, 7), " STABLE ,Stable", "версия.опубликована");

	Ожидаем.Что(СтрСоединить(Мир.Параметры.Свойства(Запись).ОтборТегов, ","),
		"перечень хранится в нижнем регистре без повторов").Равно("stable");
	Опубликовать(Мир, 7, 42, "2.1.0");
	Ожидаем.Что(Доставок(Мир), "STABLE совпал со stable").Равно(1);

КонецПроцедуры

&Тест
Процедура БезТегаУПакетаВерсияОтборНеПроходит() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Подписка(Мир, ОбъектПула(Мир, 7), "stable", "версия.опубликована");

	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "у пакета нет stable — версия не проходит").Равно(0);

КонецПроцедуры

&Тест
Процедура КаждыйПакетСверяетсяСоСвоимиТегами() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^1\.");
	Мир.Каналы.ЗавестиПравило(43, "stable", "regex", "^2\.");
	Подписка(Мир, ОбъектПула(Мир, 7), "stable", "версия.опубликована");

	Опубликовать(Мир, 7, 42, "1.0.0");
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "1.0.0 — stable у пакета 42, но не у 43").Равно(1);
	Опубликовать(Мир, 7, 43, "2.0.0");
	Ожидаем.Что(Доставок(Мир), "2.0.0 — stable у пакета 43").Равно(2);

КонецПроцедуры

&Тест
Процедура КаналыВерсииСпрашиваютсяОдинРазНаСобытие() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^[0-9.]+$");
	Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована");
	Подписка(Мир, ОбъектПула(Мир, 7), "stable", "версия.опубликована");
	Подписка(Мир, ОбъектПакета(Мир, 42, 7), "stable", "версия.опубликована");

	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "все три подписки").Равно(3);
	Ожидаем.Что(Мир.Каналы.Обращений(), "реестр спрошен один раз на событие").Равно(1);

КонецПроцедуры

&Тест
Процедура ЗаполнениеПулаОтбораПоТегуНеИмеет() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Подписка(Мир, ОбъектПула(Мир, 7), "stable", "версия.опубликована,пул.заполнен");

	Событие = Новый Структура("Тип, Когда, Данные", "пул.заполнен", ТекущаяУниверсальнаяДата(),
		Новый Структура("ПулИдентификатор, ИмяПула, Процент, ПроцентДо", 7, "пул", 85, 70));
	Мир.Подписчик.ОбработатьСобытие(Событие);
	Ожидаем.Что(Доставок(Мир), "заполнение пула доставлено, отбор по тегу его не судит").Равно(1);

КонецПроцедуры

&Тест
Процедура ПробаДоставкиОтборНеПроходит() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Объект = ОбъектПула(Мир, 7);
	Запись = Подписка(Мир, Объект, "stable", "версия.опубликована");

	Итог = Мир.Сервис.Проверить(Обвязка.АдминХаба(), Объект, Запись.Идентификатор);
	Ожидаем.Что(Итог, "проба отправлена").Не_().Равно(Неопределено);
	Ожидаем.Что(Мир.Транспорт.КоличествоВызовов(), "ушла, хотя ни одна версия под stable не подпадает")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ОтборБезСобытийВерсииОтклоняетсяАНеТеряется() Экспорт

	// теги, которые выбрали, не пропадают молча: у подписки без событий версии отбор отклонён
	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Отклонено = Ложь;
	Попытка
		Подписка(Мир, ОбъектПула(Мир, 7), "stable", "пул.заполнен");
	Исключение
		Отклонено = СтрНайти(ОписаниеОшибки(), "Отбор по тегам действует только на события версии") > 0;
	КонецПопытки;
	Ожидаем.Что(Отклонено, "заведение отклонено с названной причиной").ЭтоИстина();

	Запись = Подписка(Мир, ОбъектПула(Мир, 7), "", "пул.заполнен");
	Ожидаем.Что(Мир.Параметры.Свойства(Запись).ОтборТегов.Количество(), "без тегов заводится").Равно(0);

КонецПроцедуры

&Тест
Процедура ОтборПоправкиКПодпискеБезСобытийВерсииОтклонён() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "пул.заполнен", Истина);
	Отклонено = Ложь;
	Попытка
		Сузить(Мир, ОбъектПула(Мир, 7), Хаба, Новый Структура("ОтборТегов", Теги("stable")));
	Исключение
		Отклонено = СтрНайти(ОписаниеОшибки(), "отбору по тегам судить нечего") > 0;
	КонецПопытки;
	Ожидаем.Что(Отклонено, "поправка с отбором отклонена с названной причиной").ЭтоИстина();
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "и не легла").Равно(0);

КонецПроцедуры

// Галки — только из тегов объекта: у пула — теги пула, у пакета — его теги; иное имя отклоняется
// на сохранении с перечнем, а ввода строкой нет.
&Тест
Процедура ТегНеИзТеговОбъектаОтклонён() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Мир.Каналы.ЗавестиПравило(42, "lts", "semver", "^1.0");

	Ожидаем.Что(ОтказЗаведения(Мир, ОбъектПула(Мир, 7), Теги("stable,lts")),
		"тега пакета у подписки пула нет").Равно("Тега «lts» нет среди тегов пула: выберите из stable");
	Ожидаем.Что(ОтказЗаведения(Мир, ОбъектПакета(Мир, 42, 7), Теги("nightly")),
		"выдуманного имени у пакета нет").Равно("Тега «nightly» нет среди тегов пакета: выберите из lts");
	Ожидаем.Что(ОтказЗаведения(Мир, ОбъектПула(Мир, 8), Теги("stable")),
		"у пула без тегов отбора нет").Равно("Тега «stable» нет: у пула нет тегов для отбора");
	Ожидаем.Что(ОтказЗаведения(Мир, ОбъектПула(Мир, 7), "stable"),
		"ввода строкой нет").Равно("Отбор по тегам — перечень имён из тегов пула или пакета, а не строка");
	Ожидаем.Что(Мир.Хранилище.Все().Количество(), "ни одна подписка не легла").Равно(0);

	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована", Истина);
	Отказ = "";
	Попытка
		Сузить(Мир, ОбъектПакета(Мир, 42, 7), Хаба, Новый Структура("ОтборТегов", Теги("stable")));
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(Отказ, "поправка пакета — тоже из его тегов")
		.Равно("Тега «stable» нет среди тегов пакета: выберите из lts");

КонецПроцедуры

&Тест
Процедура УПодпискиХабаОтбораПоТегамНет() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Ожидаем.Что(ОтказЗаведения(Мир, Мир.Сервис.ОбъектХаба(), Теги("stable")), "отбор у хаба отклонён")
		.Равно("У подписки хаба отбора по тегам нет: её сужают тегами пул и пакет поправкой снизу");

	// сохранённый раньше перечень у подписки хаба не действует: отбора у неё нет
	Запись = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована");
	Запись.ПараметрыСобытийJSON = "{""подписка"":{""теги"":[""stable""]}}";
	Запись.Сохранить();
	Опубликовать(Мир, 7, 42, "1.0.0-rc1");
	Ожидаем.Что(Доставок(Мир), "версия вне stable доставлена подписке хаба").Равно(1);

КонецПроцедуры

// Тег, выбранный в отборе, удалили из пула — он выпадает из отбора; не осталось ни одного —
// доставляются все версии. Правка подписки сохраняет только то, что у пула осталось.
&Тест
Процедура УдалённыйТегВыпадаетИзОтбора() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Мир.Каналы.ЗавестиТегПула(7, "lts");
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^[0-9.]+$");
	Объект = ОбъектПула(Мир, 7);
	Запись = Подписка(Мир, Объект, "stable,lts", "версия.опубликована");

	Опубликовать(Мир, 7, 42, "1.0.0-rc1");
	Ожидаем.Что(Доставок(Мир), "КОНТРОЛЬ: пререлиз вне отбора").Равно(0);

	Мир.Каналы.СнятьТегПула(7, "lts");
	Опубликовать(Мир, 7, 42, "1.0.0");
	Опубликовать(Мир, 7, 42, "1.1.0-rc1");
	Ожидаем.Что(Доставок(Мир), "lts выпал, stable отбирает дальше").Равно(1);

	Мир.Каналы.СнятьТегПула(7, "stable");
	Опубликовать(Мир, 7, 42, "1.2.0-rc1");
	Ожидаем.Что(Доставок(Мир), "галок не осталось — доставляется любая версия").Равно(2);

	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Запись.Идентификатор, "",
		ВводПравки(Запись), "версия.опубликована", Истина);
	Ожидаем.Что(СтрСоединить(Мир.Параметры.Свойства(Запись).ОтборТегов, ","),
		"правка без отбора сохранила только живой тег").Равно("stable");

КонецПроцедуры

&Тест
Процедура ПравкаБезСвойствНеСтираетИхАСПустымОтборомСнимает() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Объект = ОбъектПула(Мир, 7);
	Запись = Подписка(Мир, Объект, "stable", "версия.опубликована", Истина, "релизы");

	Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Запись.Идентификатор, "",
		ВводПравки(Запись), "версия.опубликована", Истина);
	Свойства = Мир.Параметры.Свойства(Запись);
	Ожидаем.Что(Свойства.Название, "название осталось").Равно("релизы");
	Ожидаем.Что(СтрСоединить(Свойства.ОтборТегов, ","), "отбор остался").Равно("stable");
	Ожидаем.Что(Свойства.СужениеРазрешено, "разрешение осталось").ЭтоИстина();

	Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Запись.Идентификатор, "",
		ВводПравки(Запись), "версия.опубликована", Истина, Неопределено,
		Новый Структура("ОтборТегов", Новый Массив()));
	Ожидаем.Что(Мир.Параметры.Свойства(Запись).ОтборТегов.Количество(), "пустой ввод снял отбор").Равно(0);

КонецПроцедуры

&Тест
Процедура ПравкаТолькоОтбораСохраняетПорогЗаполнения() Экспорт

	// так правит API: в теле только tags, параметров событий нет — порог остаётся прежним
	Мир = НовыйМир();
	Мир.Каналы.ЗавестиТегПула(7, "stable");
	Объект = ОбъектПула(Мир, 7);
	Пороги = Новый Соответствие();
	Пороги.Вставить("пул.заполнен", "50");
	Запись = Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "вебхук",
		Новый Структура("URL, Секрет", "https://hook.example.com/threshold", ""),
		"версия.опубликована,пул.заполнен", Пороги);

	Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Запись.Идентификатор, "",
		ВводПравки(Запись), Запись.ТипыСобытий, Истина, Неопределено,
		Новый Структура("ОтборТегов", Теги("stable")));
	Ожидаем.Что(Мир.Параметры.Значение(Запись, "пул.заполнен"), "порог не сброшен к умолчанию").Равно(50);
	Ожидаем.Что(СтрСоединить(Мир.Параметры.Свойства(Запись).ОтборТегов, ","), "отбор лёг").Равно("stable");

	Новые = Новый Соответствие();
	Новые.Вставить("пул.заполнен", "90");
	Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Запись.Идентификатор, "",
		ВводПравки(Запись), Запись.ТипыСобытий, Истина, Новые);
	Ожидаем.Что(Мир.Параметры.Значение(Запись, "пул.заполнен"), "присланный порог заменил прежний").Равно(90);
	Ожидаем.Что(СтрСоединить(Мир.Параметры.Свойства(Запись).ОтборТегов, ","), "а отбор остался").Равно("stable");

