&Тест
Процедура ХозяинВидитКтоСузилПодписку() Экспорт

	Мир = НовыйМир();
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^[0-9.]+$");
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована", Истина);
	Сузить(Мир, ОбъектПула(Мир, 7), Хаба, Новый Структура("НеПрисылать", Истина));
	Сузить(Мир, ОбъектПакета(Мир, 42, 7), Хаба, Новый Структура("ОтборТегов", Теги("stable")));

	Объекты = Новый Массив();
	Для Каждого Поправка Из Мир.Поправки.ПоправкиПодписки(Хаба) Цикл
		Объекты.Добавить(СтрШаблон("%1#%2", Поправка.ТипОбъекта, Формат(Поправка.ОбъектИдентификатор, "ЧГ=0")));
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Объекты, ","), "хозяину видны оба объекта").Равно("пул#7,пакет#42");

