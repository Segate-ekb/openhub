&Тест
Процедура ПодпискаХабаСРазжалованнымАвторомГаснетИСПоправками() Экспорт

	Учётки = Обвязка.УчёткиСАдминами("100");
	Мир = НовыйМир(Учётки);
	Мир.Каналы.ЗавестиПравило(42, "stable", "regex", "^[0-9.]+$");
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована", Истина);
	Сузить(Мир, ОбъектПакета(Мир, 42, 7), Хаба, Новый Структура("ОтборТегов", Теги("stable")));

	Учётки.ОтвечатьУчётками("");
	Опубликовать(Мир, 7, 42, "1.0.0");
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "автор больше не админ — поправки подписку не воскрешают").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПраваПоправки

&Тест
Процедура ПоправкуСтавитРаспорядительСвоегоОбъекта() Экспорт

	Права = Новый ПраваПоОбъектам();
	Владелец = Новый Структура("Идентификатор, Админ", 200, Ложь);
	Издатель = Новый Структура("Идентификатор, Админ", 300, Ложь);
	Читатель = Новый Структура("Идентификатор, Админ", 400, Ложь);
	Права.Выдать(Владелец, "пул", 7, "удаление,изменение,чтение");
	Права.Выдать(Издатель, "пул", 7, "создание,изменение,чтение");
	Права.Выдать(Читатель, "пул", 7, "чтение");
	Мир = НовыйМир(, Права);
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована", Истина);
	Сужение = Новый Структура("НеПрисылать", Истина);

	Ожидаем.Что(Сужено(Мир, Владелец, ОбъектПула(Мир, 7), Хаба, Сужение), "владелец пула сужает для пула").ЭтоИстина();
	Ожидаем.Что(Сужено(Мир, Издатель, ОбъектПула(Мир, 7), Хаба, Сужение), "издатель — не для пула").ЭтоЛожь();
	Ожидаем.Что(Сужено(Мир, Издатель, ОбъектПакета(Мир, 42, 7), Хаба, Сужение),
		"издатель, правящий пакет, сужает для пакета").ЭтоИстина();
	Ожидаем.Что(Сужено(Мир, Читатель, ОбъектПакета(Мир, 42, 7), Хаба, Сужение), "читатель — нет").ЭтоЛожь();
	Ожидаем.Что(Сужено(Мир, Владелец, ОбъектПула(Мир, 8), Хаба, Сужение), "чужой пул — нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПоправкаНеДаётПраваНаСамуПодписку() Экспорт

	Права = Новый ПраваПоОбъектам();
	Владелец = Новый Структура("Идентификатор, Админ", 200, Ложь);
	Права.Выдать(Владелец, "пул", 7, "удаление,изменение,чтение");
	Мир = НовыйМир(, Права);
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "", "версия.опубликована", Истина);
	Пул = ОбъектПула(Мир, 7);
	Сузить(Мир, Пул, Хаба, Новый Структура("НеПрисылать", Истина), Владелец);

	// подмена идентификатора: адрес своего пула с идентификатором подписки хаба
	Ожидаем.Что(Мир.Сервис.Удалить(Владелец, Пул, Хаба.Идентификатор), "удалить нельзя").ЭтоЛожь();
	Ожидаем.Что(Мир.Сервис.Переключить(Владелец, Пул, Хаба.Идентификатор, Ложь), "выключить нельзя").ЭтоЛожь();
	Ожидаем.Что(Мир.Сервис.Проверить(Владелец, Пул, Хаба.Идентификатор), "проверить доставку нельзя")
		.Равно(Неопределено);
	Ожидаем.Что(Мир.Сервис.ОбновитьПодписку(Владелец, Пул, Хаба.Идентификатор, "", ВводПравки(Хаба),
		"версия.опубликована", Ложь), "править нельзя").Равно(Неопределено);
	// а адрес хаба отбивает гейт администратора
	Ожидаем.Что(Отказано(Мир, Владелец, Хаба), "на объекте хаба — отказ по правам").ЭтоИстина();

	Ожидаем.Что(Мир.Хранилище.ПолучитьОдноПоИдентификаторРавно(Хаба.Идентификатор).Активен,
		"подписка хаба жива и включена").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Мир

// Подписки, поправки и доставка на фейках: учётки и права подменяемы, остальное — настоящие классы.
Функция НовыйМир(Знач Учётки = Неопределено, Знач Права = Неопределено)

	Издатель = Новый ИздательСобытий();
	Каталог = СобытияХаба.Каталог(Издатель);
	Параметры = Новый ПараметрыПодписки(Каталог);
	Хранилище = Новый ФейкХранилищеВебхуков();
	ХранилищеПоправок = Новый ФейкХранилищеПоправок();
	ХранилищеИсключений = Новый ФейкХранилищеИсключений();
	Каналы = Новый ФейкКаналыПакетов();
	ОтборТегов = Новый ОтборПоТегам(Каналы, Каналы, Издатель);
	Транспорт = Новый ФейкТранспортHTTP();
	Реестр = РеестрВебхука(Транспорт);

	Сервис = Новый СервисПодписок(Хранилище, ?(Права = Неопределено, Новый ПраваПоОбъектам(), Права),
		Реестр, Каталог, Параметры,
		Новый АудитПробыПодписки(Обвязка.ИменаЖурнала(),
			Новый СобытиеАудита(Обвязка.ИменаЖурнала(), Новый ТекстJSON())),
		Новый ОграничительПроб(НастройкиПодписок()),
		?(Учётки = Неопределено, Обвязка.УчёткиСАдминами("100"), Учётки),
		ХранилищеПоправок, ХранилищеИсключений, ОтборТегов, Неопределено, Издатель,
		Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено));
	Поправки = Новый СервисПоправокПодписок(ХранилищеПоправок, ХранилищеИсключений, Сервис, Параметры, ОтборТегов);

	Отбор = Новый ОтборДоставкиПодписок(Новый ОтборЗаполненияПула(Параметры, Новый ЗаполнениеПула(), Издатель),
		ОтборТегов, Параметры, ХранилищеПоправок, ХранилищеИсключений, Новый ТекстОшибки(), ЛогТестов());
	Служба = НоваяСлужбаДоставки(Реестр);
	Подписчик = Новый ПодписчикВебхуков(Сервис, Служба, Издатель, Обвязка.Готовность(ЛогТестов()),
		Реестр, ЛогТестов(), Новый ТекстОшибки(), Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено), Отбор);

	Мир = Новый Структура();
	Мир.Вставить("Сервис", Сервис);
	Мир.Вставить("Поправки", Поправки);
	Мир.Вставить("Параметры", Параметры);
	Мир.Вставить("Хранилище", Хранилище);
	Мир.Вставить("ХранилищеПоправок", ХранилищеПоправок);
	Мир.Вставить("Каналы", Каналы);
	Мир.Вставить("Служба", Служба);
	Мир.Вставить("Транспорт", Транспорт);
	Мир.Вставить("Подписчик", Подписчик);
	Возврат Мир;

КонецФункции

// Подписка от имени админа хаба; адрес у каждой свой — дубля адреса на объекте нет. Отбор —
// галки: имена через запятую становятся перечнем, как его собирает форма.
Функция Подписка(Знач Мир, Знач Объект, Знач ОтборТегов, Знач Типы, Знач Сужаемая = Ложь, Знач Название = "")
	Возврат ПодпискаСВводом(Мир, Объект, Теги(ОтборТегов), Типы, Сужаемая, Название);
КонецФункции

Функция ПодпискаСВводом(Знач Мир, Знач Объект, Знач ОтборТегов, Знач Типы, Знач Сужаемая = Ложь,
	Знач Название = "")
	Возврат Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "вебхук",
		Новый Структура("URL, Секрет", "https://hook.example.com/" + Строка(Новый УникальныйИдентификатор()), ""),
		Типы, Неопределено,
		Новый Структура("Название, СужениеРазрешено, ОтборТегов", Название, Сужаемая, ОтборТегов));
КонецФункции

// Причина, по которой подписка на события версии с этим отбором не завелась; "" — завелась.
Функция ОтказЗаведения(Знач Мир, Знач Объект, Знач ОтборТегов)
	Попытка
		ПодпискаСВводом(Мир, Объект, ОтборТегов, "версия.опубликована");
	Исключение
		Возврат ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат "";
КонецФункции

Функция Теги(Знач Имена)
	Возврат СтрРазделить(Имена, ",", Ложь);
КонецФункции

Функция Сузить(Знач Мир, Знач Объект, Знач Подписка, Знач Сужение, Знач Кто = Неопределено)
	Возврат Мир.Поправки.Поставить(?(Кто = Неопределено, Обвязка.АдминХаба(), Кто), Объект,
		Подписка.Идентификатор, Сужение);
КонецФункции

Функция Сужено(Знач Мир, Знач Кто, Знач Объект, Знач Подписка, Знач Сужение)
	Попытка
		Возврат Мир.Поправки.Поставить(Кто, Объект, Подписка.Идентификатор, Сужение) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция Отказано(Знач Мир, Знач Кто, Знач Подписка)
	Попытка
		Мир.Сервис.Удалить(Кто, Мир.Сервис.ОбъектХаба(), Подписка.Идентификатор);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Процедура ПравитьРазрешение(Знач Мир, Знач Объект, Знач Подписка, Знач Разрешено)
	Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Подписка.Идентификатор, "",
		ВводПравки(Подписка), Подписка.ТипыСобытий, Истина, Неопределено,
		Новый Структура("СужениеРазрешено", Разрешено));
КонецПроцедуры

// Правка без смены адреса: секрет пустой — остаётся прежний.
Функция ВводПравки(Знач Подписка)
	Возврат Новый Структура("URL, Секрет, СекретСвой", Подписка.URL, "", Истина);
КонецФункции

Процедура Опубликовать(Знач Мир, Знач ПулИд, Знач ПакетИд, Знач Версия)
	Мир.Подписчик.ОбработатьСобытие(СобытиеВерсии("версия.опубликована", ПулИд, ПакетИд, Версия));
КонецПроцедуры

Функция СобытиеВерсии(Знач Тип, Знач ПулИд, Знач ПакетИд, Знач Версия)
	Возврат Новый Структура("Тип, Когда, Данные", Тип, ТекущаяУниверсальнаяДата(),
		Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия",
			ПулИд, ПакетИд, "пул", "пакет", Версия));
КонецФункции

Функция Доставок(Знач Мир)
	Возврат Мир.Служба.РазмерОчереди();
КонецФункции

Функция ОбъектПула(Знач Мир, Знач Ид)
	Возврат Мир.Сервис.ОбъектПула(Новый Структура("Идентификатор, Имя", Ид, "пул-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция ОбъектПакета(Знач Мир, Знач Ид, Знач ПулИд)
	Возврат Мир.Сервис.ОбъектПакета(Новый Структура("Идентификатор, ПулИдентификатор, Имя",
		Ид, ПулИд, "пакет-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция Идентификаторы(Знач Подписки)
	Номера = Новый Массив();
	Для Каждого Подписка Из Подписки Цикл
		Номера.Добавить(Формат(Подписка.Идентификатор, "ЧГ=0"));
	КонецЦикла;
	Возврат СтрСоединить(Номера, ",");
КонецФункции

Функция Повтор(Знач Символ, Знач Сколько)
	Результат = Новый Массив();
	Для Номер = 1 По Сколько Цикл
		Результат.Добавить(Символ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция РеестрВебхука(Знач Транспорт)
	Валидатор = Новый ФейкВалидаторВебхука();
	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(Транспорт, Валидатор,
		Новый ЧислаДоставки(НастройкиПодписок()), СобытияХаба.Каталог(), ЛогТестов()));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения);
КонецФункции

Функция НоваяСлужбаДоставки(Знач Реестр)
	Очередь = Новый ОчередьДоставокПодписок(Новый ФейкХранилищеЗаданийДоставки(), НастройкиПодписок(),
		ЛогТестов(), Новый ПриведениеЧисел());
	Возврат Новый СлужбаДоставкиПодписок(Реестр, Очередь, Новый ЧислаДоставки(НастройкиПодписок()),
		ЛогТестов(), Новый ТекстОшибки());
КонецФункции

Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Возврат Настройки;
КонецФункции

// Лог для классов, создаваемых Новый: &Лог до них не внедряется.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.поправки");
КонецФункции

#КонецОбласти
