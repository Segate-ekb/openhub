&Тест
Процедура ПравкаМеняетНастройкиНоНеТрогаетТокенПриПустомПоле() Экспорт

	Мир = НовыйМир();
	Объект = Обвязка.ОбъектПула(Мир.Сервис, 7);
	Подписка = Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100111", "111111:AAFukAn-pervy-bot", "{пакет}"),
		"версия.опубликована");

	Итог = Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Подписка.Идентификатор, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100222", "", "{пакет} {версия}"),
		"версия.опубликована,версия.отозвана", Ложь);

	Ожидаем.Что(Итог <> Неопределено, "правка состоялась").ЭтоИстина();
	Ожидаем.Что(Итог.Подписка.URL, "адресат изменён").Равно("-100222");
	Ожидаем.Что(Итог.Подписка.ШаблонТекста, "шаблон изменён").Равно("{пакет} {версия}");
	Ожидаем.Что(Итог.Подписка.ТипыСобытий, "набор событий изменён")
		.Равно("версия.опубликована,версия.отозвана");
	Ожидаем.Что(Итог.Подписка.Активен, "подписка выключена правкой").ЭтоЛожь();
	Ожидаем.Что(Итог.Подписка.ТокенДействия,
		"пустое поле токена оставило сохранённый").Равно("111111:AAFukAn-pervy-bot");
	Ожидаем.Что(Итог.Секрет, "показывать нечего: секрет подписи типу не нужен").Равно("");

