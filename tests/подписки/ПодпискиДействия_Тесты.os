&Тест
Процедура ПробаВебхукаОтдаётТолькоКодИПроходитВалидатор() Экспорт

	Мир = НовыйМир();
	Объект = Обвязка.ОбъектПула(Мир.Сервис, 7);
	Мир.HTTP.УстановитьОтвет(503, "секретное тело внутреннего сервиса");
	Подписка = Мир.Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://hook.example.com/a",
		"версия.опубликована");

