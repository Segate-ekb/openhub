		Новый Структура("ЧатИд, Токен, Шаблон", "-100556", "7:AAFukAn-godny",
			"Вышел {пакет} у {пул}"), "версия.опубликована");

КонецПроцедуры

// Свой текст называет автора из манифеста версии и адрес репозитория пакета рядом с тем,
// кто опубликовал: все три значения доезжают до чата одним разворотом шаблона.
&Тест
Процедура ШаблонНазываетАвтораИРепозиторийПакета() Экспорт

	Пакеты = Новый РеестрОдногоПакета(42, "https://github.com/vanessa-opensource/vanessa-runner");
	Пакеты.ДобавитьВерсию("1.2.3", "Pavel Bogatyrev");
	Мир = НовыйМир(, , Пакеты);

	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100777", "8:AAFukAn-avtor",
			"{пакет} {версия}: автор {автор}, репозиторий {репозиторий}, опубликовал {кто}"),
		"версия.опубликована");

	Данные = ДанныеСобытия(7, 42);
	Данные.Вставить("Кто", "github:octocat");
	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), Данные,
		Дата(2026, 7, 30, 12, 0, 0));
	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

	Ожидаем.Что(Итог.Доставлено, "уведомление доставлено").Равно(1);
	Ожидаем.Что(Мир.Телеграм.ПоследняяОтправка().Текст, "шаблон развёрнут значениями реестра")
		.Равно("пакет-42 1.2.3: автор Pavel Bogatyrev, репозиторий"
			+ " https://github.com/vanessa-opensource/vanessa-runner, опубликовал github:octocat");

КонецПроцедуры

// Превью — забота сообщения Telegram: одно и то же событие уходит в чат с карточкой,
// а вебхуку — тем же машинным телом, без полей Bot API.
&Тест
Процедура ПревьюTelegramНеМеняетТелоВебхука() Экспорт

	Пакеты = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Мир = НовыйМир(, , Пакеты);
	Объект = Обвязка.ОбъектПула(Мир.Сервис, 7);
	Мир.Сервис.Создать(Обвязка.АдминХаба(), Объект, "https://hook.example.com/preview", "версия.опубликована");
	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100779", "10:AAFukAn-prevju", "{пакет}: {репозиторий}"),
		"версия.опубликована");

	Момент = Дата(2026, 7, 30, 12, 0, 0);
	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), ДанныеСобытия(7, 42), Момент);
	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

	Ожидаем.Что(Итог.Доставлено, "обе доставки состоялись").Равно(2);
	Ожидаем.Что(Мир.Телеграм.ПоследняяОтправка().АдресПревью, "самотест: сообщение ушло с карточкой")
		.Равно("https://github.com/acme/lib");

	ТелоСобытия = Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено, Неопределено, Неопределено,
		Пакеты, Пакеты).ПоСобытию(Новый Структура("Тип, Когда, Данные",
			Мир.Издатель.ТипВерсияОпубликована(), Момент, ДанныеСобытия(7, 42)));
	Ожидаем.Что(Мир.HTTP.ТелоПоследнее(), "вебхук получил ровно тело события").Равно(ТелоСобытия);

КонецПроцедуры

// Новые имена — часть закрытого перечня: шаблон с ними сохраняется, а отказ по опечатке
// называет их среди допустимых.
&Тест
Процедура АвторИРепозиторийВходятВПереченьДопустимых() Экспорт

	Мир = НовыйМир();

	Ожидаем.Что(ПопыткаСоздатьПодписку(Мир.Сервис, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100778", "9:AAFukAn-shablon",
			"{автор} — {репозиторий}")), "шаблон с автором и репозиторием отклонён").ЭтоЛожь();

	Ошибка = ОшибкаСоздания(Мир.Сервис, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100779", "10:AAFukAn-opechatka", "{авторр}"));
	Ожидаем.Что(Найти(Ошибка, "{авторр}") > 0, "опечатка названа: " + Ошибка).ЭтоИстина();
	Ожидаем.Что(Найти(Ошибка, "{автор}") > 0, "автор среди допустимых: " + Ошибка).ЭтоИстина();
	Ожидаем.Что(Найти(Ошибка, "{репозиторий}") > 0, "репозиторий среди допустимых: " + Ошибка)
		.ЭтоИстина();

КонецПроцедуры

// {как} и {релиз} — часть закрытого перечня: шаблон с ними сохраняется, опечатка называет их.
&Тест
Процедура КакИРелизВходятВПереченьДопустимых() Экспорт

	Мир = НовыйМир();

	Ожидаем.Что(ПопыткаСоздатьПодписку(Мир.Сервис, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100780", "11:AAFukAn-kak",
			"{кто} — {как} — {релиз}")), "шаблон со способом и релизом отклонён").ЭтоЛожь();

	Ошибка = ОшибкаСоздания(Мир.Сервис, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100781", "12:AAFukAn-kaak", "{каак}"));
	Ожидаем.Что(Найти(Ошибка, "{как}") > 0, "способ среди допустимых: " + Ошибка).ЭтоИстина();
	Ожидаем.Что(Найти(Ошибка, "{релиз}") > 0, "релиз среди допустимых: " + Ошибка).ЭтоИстина();

КонецПроцедуры

// Имя публикатора GitHub дочитывается в фоне доставки, а не на публикации: событие уходит
// подписчику без единого вопроса к GitHub, а приёмник вебхука получает уже дочитанное тело,
// подписанное ровно в том виде, в каком ушло.
&Тест
Процедура ВебхукПолучаетИмяПубликатораДочитаннымИПодписанным() Экспорт

	Опознание = Новый ФейкОпознанияGitHub();
	Опознание.Назвать("octocat", "Mona Lisa");
	Мир = НовыйМир(, , РеестрЗапускаGitHub(""), Опознание);
	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "вебхук",
		Новый Структура("URL, Секрет", "https://hook.example.com/name", "секрет-вебхука"), "версия.опубликована");

	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), ДанныеКонвейераGitHub(7, 42),
		Дата(2026, 7, 30, 12, 0, 0));
	Ожидаем.Что(Опознание.Вопросов(), "на публикации GitHub не спрошен").Равно(0);

	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

	Ожидаем.Что(Итог.Доставлено, "вебхук доставлен").Равно(1);
	Ожидаем.Что(Опознание.Вопросов(), "имя спрошено в фоне доставки").Равно(1);
	Тело = Мир.HTTP.ТелоПоследнее();
	Поля = РазобратьДетали(Тело);
	Ожидаем.Что(Поля.Получить("публикатор"), "человек назван именем").Равно("Mona Lisa (octocat)");
	Ожидаем.Что(Поля.Получить("кто"), "кто — идентификатор журнала").Равно("ci:acme/lib");
	Ожидаем.Что(Поля.Получить("как"), "способ").Равно("доверенная публикация");
	Ожидаем.Что(Мир.HTTP.ЗаголовокПоследний("X-OpenHub-Signature"), "подписано то тело, что ушло")
		.Равно(Мир.Реестр.Обработчик("вебхук").Подпись("секрет-вебхука", Тело));

КонецПроцедуры

// GitHub не ответил или имени в профиле нет — публикатор назван логином, доставка не срывается.
&Тест
Процедура GitHubНеОтветилПубликаторНазванЛогином() Экспорт

	Для Каждого Молчит Из СтрРазделить("да,нет", ",") Цикл
		Опознание = Новый ФейкОпознанияGitHub();
		Если Молчит = "да" Тогда
			Опознание.Замолчать();
		КонецЕсли;
		Мир = НовыйМир(, , РеестрЗапускаGitHub(""), Опознание);
		Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "вебхук",
			Новый Структура("URL", "https://hook.example.com/silent"), "версия.опубликована");
		Мир.Подписчик.ПриЗапускеПриложения();
		Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), ДанныеКонвейераGitHub(7, 42),
			Дата(2026, 7, 30, 12, 0, 0));

		Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

		Ожидаем.Что(Итог.Доставлено, "доставлено, GitHub молчит: " + Молчит).Равно(1);
		Ожидаем.Что(РазобратьДетали(Мир.HTTP.ТелоПоследнее()).Получить("публикатор"),
			"логин вместо имени, GitHub молчит: " + Молчит).Равно("octocat");
	КонецЦикла;

КонецПроцедуры

// Имя ищут только у того, кто запустил конвейер github.com и записан запуском версии: версию
// принял конвейер GitHub Enterprise или GitLab (запустившего на github.com нет) либо её с тех
// пор принял запуск другого человека — к GitHub не ходят, публикатор назван тем, что в теле.
&Тест
Процедура ИмяНеИщутБезЗапускаНаGitHubCom() Экспорт

	Для Каждого Запустивший Из СтрРазделить("|hubot", "|") Цикл
		Опознание = Новый ФейкОпознанияGitHub();
		Опознание.Назвать("octocat", "Mona Lisa");
		Опознание.Назвать("hubot", "Hubot");
		Пакеты = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
		Пакеты.ДобавитьВерсию("1.2.3", "Acme", "", Запустивший);
		Мир = НовыйМир(, , Пакеты, Опознание);
		Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "вебхук",
			Новый Структура("URL", "https://hook.example.com/ghe"), "версия.опубликована");
		Мир.Подписчик.ПриЗапускеПриложения();
		Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), ДанныеКонвейераGitHub(7, 42),
			Дата(2026, 7, 30, 12, 0, 0));

		Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

		Ожидаем.Что(Итог.Доставлено, "доставлено, запустивший: " + Запустивший).Равно(1);
		Ожидаем.Что(Опознание.Вопросов(), "GitHub не спрошен, запустивший: " + Запустивший).Равно(0);
		Ожидаем.Что(РазобратьДетали(Мир.HTTP.ТелоПоследнее()).Получить("публикатор"),
			"публикатор — логин из тела, запустивший: " + Запустивший).Равно("octocat");
	КонецЦикла;

КонецПроцедуры

// Публикацию учёткой хаба octocat (или легаси-токеном) ту же версию перезаписал конвейер
// github.com, запущенный GitHub-пользователем octocat: логины совпали, а люди разные. Уведомление
// о публикации учёткой имени постороннего не получает — дочитывают только доверенную публикацию.
&Тест
Процедура ИмяНеДочитываетсяНеДоверенномуПубликатору() Экспорт

	Для Каждого Способ Из СтрРазделить("учётка хаба|токен GitHub", "|") Цикл
		Опознание = Новый ФейкОпознанияGitHub();
		Опознание.Назвать("octocat", "Mona Lisa");
		Мир = НовыйМир(, , РеестрЗапускаGitHub(""), Опознание);
		Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "вебхук",
			Новый Структура("URL", "https://hook.example.com/hub"), "версия.опубликована");
		Данные = ДанныеСобытия(7, 42);
		Данные.Вставить("Кто", ?(Способ = "учётка хаба", "octocat", "github:octocat"));
		Данные.Вставить("ЛогинПубликатора", "octocat");
		Данные.Вставить("ИмяПубликатора", "");
		Данные.Вставить("СпособПубликации", Способ);
		Мир.Подписчик.ПриЗапускеПриложения();
		Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), Данные, Дата(2026, 7, 30, 12, 0, 0));

		Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

		Ожидаем.Что(Итог.Доставлено, "доставлено: " + Способ).Равно(1);
		Ожидаем.Что(Опознание.Вопросов(), "GitHub не спрошен: " + Способ).Равно(0);
		Ожидаем.Что(РазобратьДетали(Мир.HTTP.ТелоПоследнее()).Получить("публикатор"),
			"имени постороннего нет: " + Способ).Равно("octocat");
	КонецЦикла;

КонецПроцедуры

// {кто}, {как} и {релиз} в тексте Telegram — те же значения, что поля тела вебхука того же
// события: человек, способ и страница релиза одни на все каналы.
&Тест
Процедура КтоКакИРелизОдниВТекстеИВТелеВебхука() Экспорт

	Адрес = "https://github.com/acme/lib/releases/tag/v1.2.3";
	Пакеты = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Пакеты.ДобавитьВерсию("1.2.3", "Acme", Адрес, "octocat");
	Опознание = Новый ФейкОпознанияGitHub();
	Опознание.Назвать("octocat", "Mona Lisa");
	Мир = НовыйМир(, , Пакеты, Опознание);
	Объект = Обвязка.ОбъектПула(Мир.Сервис, 7);
	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен, Шаблон", "-100782", "13:AAFukAn-odno", "{кто}|{как}|{релиз}"),
		"версия.опубликована");
	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "вебхук",
		Новый Структура("URL", "https://hook.example.com/same"), "версия.опубликована");

	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), ДанныеКонвейераGitHub(7, 42),
		Дата(2026, 7, 30, 12, 0, 0));
	Итог = Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

	Ожидаем.Что(Итог.Доставлено, "оба канала доставлены").Равно(2);
	Поля = РазобратьДетали(Мир.HTTP.ТелоПоследнее());
	Ожидаем.Что(Мир.Телеграм.ПоследняяОтправка().Текст, "текст Telegram — значения тела вебхука")
		.Равно(СтрШаблон("%1|%2|%3", Поля.Получить("публикатор"), Поля.Получить("как"), Поля.Получить("релиз")));
	Ожидаем.Что(Поля.Получить("релиз"), "страница релиза из запуска конвейера").Равно(Адрес);
	Ожидаем.Что(Поля.Получить("публикатор"), "человек назван").Равно("Mona Lisa (octocat)");

КонецПроцедуры

// Текст по умолчанию называет публикатора и способ, а страницу релиза — отдельной строкой.
&Тест
Процедура СтандартныйТекстНазываетПубликатораСпособИРелиз() Экспорт

	Адрес = "https://github.com/acme/lib/releases/tag/v1.2.3";
	Пакеты = Новый РеестрОдногоПакета(42, "https://github.com/acme/lib");
	Пакеты.ДобавитьВерсию("1.2.3", "Acme", Адрес, "octocat");
	Опознание = Новый ФейкОпознанияGitHub();
	Опознание.Назвать("octocat", "Mona Lisa");
	Мир = НовыйМир(, , Пакеты, Опознание);
	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "telegram",
		Новый Структура("ЧатИд, Токен", "-100783", "14:AAFukAn-standart"), "версия.опубликована");

	Мир.Подписчик.ПриЗапускеПриложения();
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОпубликована(), ДанныеКонвейераGitHub(7, 42),
		Дата(2026, 7, 30, 12, 0, 0));
	Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 1));

	Строки = СтрРазделить(Мир.Телеграм.ПоследняяОтправка().Текст, Символы.ПС);
	Ожидаем.Что(Строки.Найти("Опубликовал: Mona Lisa (octocat), доверенная публикация"),
		"строка о публикаторе и способе").Не_().Равно(Неопределено);
	Ожидаем.Что(Строки.Найти("Релиз: " + Адрес), "строка о релизе").Не_().Равно(Неопределено);

	// отзыв способа публикации не называет — и строки «Опубликовал» в нём нет
	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "telegram",
		Новый Структура("ЧатИд, Токен", "-100784", "15:AAFukAn-otzyv"), "версия.отозвана");
	Мир.Издатель.Опубликовать(Мир.Издатель.ТипВерсияОтозвана(), ДанныеСобытия(7, 42),
		Дата(2026, 7, 30, 12, 0, 3));
	Мир.Служба.ОбработатьПартию(Дата(2026, 7, 30, 12, 0, 4));
	Ожидаем.Что(СтрНайти(Мир.Телеграм.ПоследняяОтправка().Текст, "Опубликовал"), "у отзыва строки нет")
		.Равно(0);

КонецПроцедуры

// Текст по умолчанию — шаблон по умолчанию той же дверью: на любом теле пустой шаблон и он же,
// набранный руками, дают один текст.
&Тест
Процедура ТекстПоУмолчаниюВыраженШаблономПоУмолчанию() Экспорт

	Мир = НовыйМир();
	Шаблоны = Новый ШаблонУведомления(Мир.Каталог);
	ПоУмолчанию = Шаблоны.ПоУмолчанию();

	Тела = Новый Соответствие();
	Тела.Вставить("версия.опубликована", "{""пул"":""main"",""пакет"":""lib"",""версия"":""1.2.0"","
		+ """время"":""2026-10-05T12:00:00Z"",""кто"":""root"",""публикатор"":""Ann (ann)"",""как"":""токен GitHub"","
		+ """ссылка"":""https://hub.example.ru/pools/main/packages/lib"","
		+ """релиз"":""https://github.com/acme/lib/releases/tag/v1.2.0""}");
	Тела.Вставить("версия.отозвана", "{""пул"":""main"",""пакет"":""lib"",""версия"":""1.2.0"","
		+ """время"":""2026-10-05T12:00:00Z"",""кто"":""root""}");
	Тела.Вставить("пул.заполнен", "{""пул"":""main"",""время"":""2026-10-05T12:00:00Z"",""процент"":85}");

	Для Каждого КиЗ Из Тела Цикл
		Ожидаем.Что(Шаблоны.Текст(ПоУмолчанию, КиЗ.Ключ, КиЗ.Значение), "тот же текст: " + КиЗ.Ключ)
			.Равно(Шаблоны.Текст("", КиЗ.Ключ, КиЗ.Значение));
	КонецЦикла;

	Ожидаем.Что(Шаблоны.Текст("", "версия.опубликована", Тела.Получить("версия.опубликована")),
		"текст по умолчанию — все строки шаблона")
		.Равно("OpenHub: " + ПодписьСобытия(Мир, "версия.опубликована") + Символы.ПС + "main/lib 1.2.0" + Символы.ПС
			+ "Опубликовал: Ann (ann), токен GitHub" + Символы.ПС + "2026-10-05T12:00:00Z" + Символы.ПС
			+ "https://hub.example.ru/pools/main/packages/lib" + Символы.ПС
			+ "Релиз: https://github.com/acme/lib/releases/tag/v1.2.0");
	Ожидаем.Что(Шаблоны.Текст("", "пул.заполнен", Тела.Получить("пул.заполнен")),
		"у заполнения пула строк о пакете, публикаторе, ссылке и релизе нет")
		.Равно("OpenHub: " + ПодписьСобытия(Мир, "пул.заполнен") + Символы.ПС + "2026-10-05T12:00:00Z");

КонецПроцедуры

// Каждая вставка перечня разворачивается значением: объявленное имя без значения прошло бы
// проверку сохранения и осталось бы в чате «{имя}».
&Тест
Процедура КаждаяВставкаПеречняРазворачивается() Экспорт

	Шаблоны = Новый ШаблонУведомления(НовыйМир().Каталог);
	Тело = "{""тип"":""версия.опубликована"",""пул"":""main"",""пакет"":""lib"",""версия"":""1.2.0"","
		+ """время"":""2026-10-05T12:00:00Z"",""кто"":""root"",""публикатор"":""Ann (ann)"",""как"":""токен GitHub"","
		+ """автор"":""Ann"",""репозиторий"":""https://github.com/acme/lib"","
		+ """ссылка"":""https://hub.example.ru/pools/main/packages/lib"","
		+ """релиз"":""https://github.com/acme/lib/releases/tag/v1.2.0"",""процент"":85}";

	Для Каждого Имя Из Шаблоны.ИменаВставок() Цикл
		Текст = Шаблоны.Текст("<{" + Имя + "}>", "версия.опубликована", Тело);
		Ожидаем.Что(СтрНайти(Текст, "{" + Имя + "}"), "вставка развёрнута: " + Текст).Равно(0);
		Ожидаем.Что(СтрДлина(Текст) > 2, "и не пуста: " + Имя).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// В многострочном шаблоне строки, которой нечего подставить, нет; однострочный приходит целиком;
// многострочный, от которого не осталось ни строки, — текст по умолчанию: пустого сообщения
// Bot API не примет.
&Тест
Процедура МногострочныйШаблонНеПечатаетСтрокБезЗначений() Экспорт

	Шаблоны = Новый ШаблонУведомления(НовыйМир().Каталог);
	Тело = "{""пул"":""main"",""пакет"":""lib"",""версия"":""1.2.0"",""автор"":""Ann"",""время"":""2026-10-05T12:00:00Z""}";

	Ожидаем.Что(Шаблоны.Текст("{пакет} {версия}" + Символы.ПС + "Релиз: {релиз}" + Символы.ПС + Символы.ПС
		+ "Автор: {автор}, {неизвестное}", "версия.опубликована", Тело),
		"строки без релиза нет, пустая строка и неизвестное имя остались текстом")
		.Равно("lib 1.2.0" + Символы.ПС + Символы.ПС + "Автор: Ann, {неизвестное}");
	Ожидаем.Что(Шаблоны.Текст("{пакет} {версия} {релиз}", "версия.опубликована", Тело),
		"однострочный — целиком").Равно("lib 1.2.0 ");
	Ожидаем.Что(Шаблоны.Текст("Релиз: {релиз}" + Символы.ПС + "{репозиторий}", "версия.опубликована", Тело),
		"не осталось ни строки — текст по умолчанию")
		.Равно(Шаблоны.Текст("", "версия.опубликована", Тело));

КонецПроцедуры

&Тест
Процедура ОтказBotApiИСетевойСбойУходятВРетрайЯдра() Экспорт

	Мир = НовыйМир();
	Момент = Дата(2026, 7, 30, 12, 0, 0);

	Мир.Телеграм.УстановитьОтказ("chat not found");
	Мир.Служба.Поставить("telegram", Новый Структура("ЧатИд, Токен", "42", "1:AAFukAn-otkaz"),
		"версия.опубликована", "{}", Момент);
	Итог = Мир.Служба.ОбработатьПартию(Момент);
	Ожидаем.Что(Итог.Повторно, "отказ Bot API → ретрай с бэкоффом").Равно(1);

	Мир2 = НовыйМир();
	Мир2.Телеграм.ЭмулироватьОффлайн();
	Мир2.Служба.Поставить("telegram", Новый Структура("ЧатИд, Токен", "42", "2:AAFukAn-offline"),
		"версия.опубликована", "{}", Момент);
	Итог2 = Мир2.Служба.ОбработатьПартию(Момент); // изолировано, партия не падает
	Ожидаем.Что(Итог2.Повторно, "сетевой сбой изолирован и ретраится").Равно(1);

КонецПроцедуры

&Тест
Процедура НедопустимыйЧатИдОтклонёнНаСоздании() Экспорт

	Мир = НовыйМир();
	Плохие = Новый Массив();
	Плохие.Добавить("");                       // пусто
	Плохие.Добавить("abc");                    // не число
	Плохие.Добавить("12a3");                   // мусор в числе
	Плохие.Добавить("@bad");                   // имя канала короче 5
	Плохие.Добавить("@канал_кириллицей");      // недопустимые символы имени
	Плохие.Добавить("1*2*3");                  // больше одной темы
	Плохие.Добавить("--5");                    // двойной минус
	Для Каждого ЧатИд Из Плохие Цикл
		Ожидаем.Что(ПопыткаСоздатьПодписку(Мир.Сервис, "telegram",
			Новый Структура("ЧатИд, Токен", ЧатИд, "424242:AAFukAn-token-proby")),
			СтрШаблон("chat_id «%1» отклонён", ЧатИд)).ЭтоИстина();
	КонецЦикла;

	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "telegram",
		Новый Структура("ЧатИд, Токен", "@channel_name", "1:AAFukAn-kanal"), "версия.опубликована");
	Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 7), "telegram",
		Новый Структура("ЧатИд, Токен", "123456789*42", "2:AAFukAn-tema"), "версия.опубликована");

