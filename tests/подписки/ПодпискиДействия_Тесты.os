&Тест
Процедура ПравкаНеМеняетТипДействияИНеВидитЧужуюПодписку() Экспорт

	Мир = НовыйМир();
	Объект = Обвязка.ОбъектПула(Мир.Сервис, 7);
	Подписка = Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "telegram",
		Новый Структура("ЧатИд, Токен", "-100111", "111111:AAFukAn-pervy-bot"), "версия.опубликована");

	Подмена = "";
	Попытка
		Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Подписка.Идентификатор, "вебхук",
			Новый Структура("URL", "https://hook.example.com/a"), "версия.опубликована", Истина);
	Исключение
		Подмена = ОписаниеОшибки();
	КонецПопытки;

	// объект берётся из адреса, а не из формы: подписка чужого объекта просто не находится
	Чужой = Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Обвязка.ОбъектПула(Мир.Сервис, 8),
		Подписка.Идентификатор, "telegram", Новый Структура("ЧатИд, Токен", "-100999", ""),
		"версия.опубликована", Истина);

	Ожидаем.Что(Найти(Подмена, "не меняется") > 0,
		"подмена типа в теле формы отбита: " + Подмена).ЭтоИстина();
	Ожидаем.Что(Чужой = Неопределено, "подписка чужого объекта недоступна по идентификатору").ЭтоИстина();
	Ожидаем.Что(Мир.Сервис.Список(Объект)[0].URL, "и она не изменилась").Равно("-100111");

КонецПроцедуры

&Тест
Процедура ПустойСекретВебхукаНеЗатираетСохранённыйАСнятыйФлажокВыпускаетНовый() Экспорт

