// Дерево получателей подписки хаба и пула и исключения из него, дерево пакетов в поправке пула
// к подписке хаба — на фейках, без контейнера и базы: событие проходит подписчик, число доставок
// в очереди — то, что увидит адресат.

#Использовать asserts
#Использовать "../фикстуры"
#Использовать autumn-logos

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Обвязка;        // фикстура ОбвязкаПодписок — админ хаба, учётки, готовность, имена журнала
Перем СобытияХаба;    // фикстура КаталогСобытийХаба — перечень из описаний всех предметов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КаталогПодписок = ОбъединитьПути(КаталогМодулей, "подписки", "Классы");
	КаталогРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	КаталогАудита = ОбъединитьПути(КаталогМодулей, "аудит", "Классы");

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	РеестрФикстур.Подключить("ОбвязкаПодписок");
	Обвязка = Новый ОбвязкаПодписок(ПоискКлассов);

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "основа", "Классы"));
	Для Каждого Имя Из СтрРазделить("СервисПодписок,СервисПоправокПодписок,СервисИсключенийПодписок,"
		+ "ВеткиДереваПолучателей,"
		+ "ОтборПоТегам,ОтборДоставкиПодписок,ОтборЗаполненияПула,ПараметрыПодписки,ПодписчикВебхуков,"
		+ "ТелоСобытия,РеестрДействийПодписок,СлужбаДоставкиПодписок,ЧислаДоставки,ОчередьДоставокПодписок,"
		+ "ВалидаторАдресаВебхука,АудитПробыПодписки,ОграничительПроб,ДоставкаВебхуком,"
		+ "ХранениеПодпискиВебхука,ПодпискиНаУдаляемое", ",") Цикл
		ПоискКлассов.Подключить(КаталогПодписок, Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ЗаполнениеПула,АдресаСтраниц,ИменаОбъектовРеестра", ",") Цикл
		ПоискКлассов.Подключить(КаталогРеестра, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "события", "Классы"), "ИздательСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "данные", "Классы"), "СнятиеСтрок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "АдресИнстанса");
	ПоискКлассов.Подключить(КаталогАудита, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КаталогАудита, "СобытиеАудита");

	Для Каждого Имя Из СтрРазделить("ФейкХранилищеВебхуков,ФейкВебхукЗапись,ФейкХранилищеПоправок,"
		+ "ФейкПоправкаЗапись,ФейкХранилищеИсключений,ФейкИсключениеЗапись,ФейкХранилищеИсключенийВПоправках,"
		+ "ФейкИсключениеВПоправкеЗапись,ФейкКаналыПакетов,ПраваПоОбъектам,"
		+ "ФейкХранилищеЗаданийДоставки,ФейкЗаданиеДоставкиЗапись,ФейкТранспортHTTP,ФейкВалидаторВебхука,"
		+ "НастройкиЗаглушка,СервисПользователейЗаглушка,ФейкХранилищеСущностей,ФейкСущностьАудита,"
		+ "КаталогСобытийХаба,ФейкСервисПулов,РазрезСервисПакетов", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;
	СобытияХаба = Новый КаталогСобытийХаба(ПоискКлассов, ОбъединитьПути(КаталогПодписок, "..", ".."));

КонецПроцедуры

#Область Дерево

&Тест
Процедура ДеревоХабаСобираетсяИзВсехПуловИИхПакетов() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба());

	Дерево = Мир.Исключения.ДеревоПолучателей(Обвязка.АдминХаба(), Мир.Сервис.ОбъектХаба(), Хаба.Идентификатор);

	Ожидаем.Что(Дерево.ГалкиПулов, "у подписки хаба пул снимается галкой").ЭтоИстина();
	Ожидаем.Что(Состав(Дерево), "все пулы по имени, приватный тоже, и пакеты каждого вторым уровнем")
		.Равно("alpha[jlib,web];beta(приватный)[secret]");

КонецПроцедуры

&Тест
Процедура ДеревоПодпискиПулаСобираетсяИзЕгоПакетовАУПодпискиПакетаДереваНет() Экспорт

	Мир = НовыйМир();
	Пула = Подписка(Мир, ОбъектПула(Мир, 7));
	Пакета = Подписка(Мир, ОбъектПакета(Мир, 42, 7));

	Дерево = Мир.Исключения.ДеревоПолучателей(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Пула.Идентификатор);
	Ожидаем.Что(Дерево.ГалкиПулов, "свой пул подписка пула не исключает").ЭтоЛожь();
	Ожидаем.Что(Состав(Дерево), "только пакеты своего пула").Равно("alpha[jlib,web]");

	Ожидаем.Что(Мир.Исключения.ДеревоПолучателей(Обвязка.АдминХаба(), ОбъектПакета(Мир, 42, 7),
		Пакета.Идентификатор), "у подписки пакета дерева нет").Равно(Неопределено);
	Ожидаем.Что(Мир.Исключения.Отметить(Обвязка.АдминХаба(), ОбъектПакета(Мир, 42, 7), Пакета.Идентификатор,
		Узлы(Мир, "пакет", 42), Новый Массив()), "и исключать в ней нечего").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДеревоСчитаетИсключённыеПакетыПула() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Исключить(Мир, Хаба, "пакет", 42);
	Исключить(Мир, Хаба, "пул", 8);

	Дерево = Мир.Исключения.ДеревоПолучателей(Обвязка.АдминХаба(), Мир.Сервис.ОбъектХаба(), Хаба.Идентификатор);
	Ожидаем.Что(Дерево.Пулы[0].ИсключеноПакетов, "в alpha исключён один пакет").Равно(1);
	Ожидаем.Что(Дерево.Пулы[0].Пакеты[0].Исключён, "jlib по имени первый и включён").ЭтоЛожь();
	Ожидаем.Что(Дерево.Пулы[0].Пакеты[1].Исключён, "web исключён").ЭтоИстина();
	Ожидаем.Что(Дерево.Пулы[1].Исключён, "beta исключён целиком").ЭтоИстина();
	Ожидаем.Что(Дерево.Пулы[1].ИсключеноПакетов, "его пакеты своей галки не теряли").Равно(0);

	Сводка = Мир.Исключения.СводкаИсключений(Обвязка.АдминХаба(), Мир.Сервис.ОбъектХаба(), Хаба.Идентификатор);
	Ожидаем.Что(СтрШаблон("%1/%2", Сводка.Пулов, Сводка.Пакетов), "сводка считает пулы и пакеты").Равно("1/1");

КонецПроцедуры

&Тест
Процедура НовыеПулИПакетПопадаютВДеревоВключёнными() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Исключить(Мир, Хаба, "пакет", 42);

	Мир.Пулы.ДобавитьПул(9, "gamma");
	Мир.Пакеты.ДобавитьПакет(44, 7, "fresh");
	Мир.Пакеты.ДобавитьПакет(90, 9, "newcomer");

	Дерево = Мир.Исключения.ДеревоПолучателей(Обвязка.АдминХаба(), Мир.Сервис.ОбъектХаба(), Хаба.Идентификатор);
	Ожидаем.Что(Состав(Дерево, Истина), "новые узлы без отметки, исключённый остался исключённым")
		.Равно("alpha[fresh,jlib,-web];beta(приватный)[secret];gamma[newcomer]");
	Опубликовать(Мир, 7, 44, "1.0.0");
	Опубликовать(Мир, 9, 90, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "события новых пакета и пула доставлены").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область Доставка

&Тест
Процедура ИсключённыйПакетНеПолучаетСобытийОстальныеПолучают() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Исключить(Мир, Хаба, "пакет", 42);

	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "событие исключённого пакета не доставлено").Равно(0);
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "соседний пакет того же пула получает").Равно(1);

КонецПроцедуры

&Тест
Процедура ИсключённыйПулГаситСобытияСвоихПакетовИСвоиСобытия() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована,пул.заполнен");
	Исключить(Мир, Хаба, "пул", 7);

	Опубликовать(Мир, 7, 42, "1.0.0");
	Опубликовать(Мир, 7, 43, "1.0.0");
	Мир.Подписчик.ОбработатьСобытие(СобытиеЗаполнения(7));
	Ожидаем.Что(Доставок(Мир), "ни пакеты исключённого пула, ни его заполнение").Равно(0);
	Опубликовать(Мир, 8, 50, "1.0.0");
	Мир.Подписчик.ОбработатьСобытие(СобытиеЗаполнения(8));
	Ожидаем.Что(Доставок(Мир), "другой пул получает всё").Равно(2);

КонецПроцедуры

&Тест
Процедура ПодпискаПулаИсключаетСвоиПакетыАЧужойИНесуществующийПропускаетОдинаково() Экспорт

	Мир = НовыйМир();
	Объект = ОбъектПула(Мир, 7);
	Пула = Подписка(Мир, Объект);
	Исключить(Мир, Пула, "пакет", 42, Объект);

	Опубликовать(Мир, 7, 42, "1.0.0");
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "исключённый пакет отсеян, соседний доставлен").Равно(1);

	Ожидаем.Что(Отказ(Мир, Объект, Пула, "пул", 7), "свой пул подписка пула не исключает")
		.Содержит("не входит");

	// пакет 50 — в приватном пуле beta, пакета 999 нет вовсе: исход один и тот же, без имени
	Для Каждого Чужой Из СтрРазделить("50,999", ",") Цикл
		Исключаемые = Узлы(Мир, "пакет", Число(Чужой));
		Исключаемые.Добавить(Мир.Исключения.Узел("пакет", 43));
		Ожидаем.Что(Мир.Исключения.Отметить(Обвязка.АдминХаба(), Объект, Пула.Идентификатор, Исключаемые,
			Новый Массив()), "пакет " + Чужой + " вне дерева пропущен, отказа нет").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(Состав(Мир.Исключения.ДеревоПолучателей(Обвязка.АдминХаба(), Объект, Пула.Идентификатор), Истина),
		"легли галки своих пакетов").Равно("alpha[-jlib,-web]");
	Ожидаем.Что(Мир.ХранилищеИсключений.Все().Количество(), "чужой и несуществующий не записаны").Равно(2);

КонецПроцедуры

&Тест
Процедура ИсчезнувшийУзелПропускаетсяОстальныеГалкиЛожатся() Экспорт

	// форма показала пакет 404 и пул 9, а до сохранения их удалили: снятые галки исчезнувших
	// узлов не роняют сохранение остальных
	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Подписка(Мир, Объект);
	Исключить(Мир, Хаба, "пакет", 43);

	Исключаемые = Узлы(Мир, "пакет", 42);
	Исключаемые.Добавить(Мир.Исключения.Узел("пакет", 404));
	Исключаемые.Добавить(Мир.Исключения.Узел("пул", 9));
	Исключаемые.Добавить(Мир.Исключения.Узел("пул", 8));

	Ожидаем.Что(Мир.Исключения.Отметить(Обвязка.АдминХаба(), Объект, Хаба.Идентификатор, Исключаемые,
		Узлы(Мир, "пакет", 43)), "сохранение прошло").ЭтоИстина();
	Дерево = Мир.Исключения.ДеревоПолучателей(Обвязка.АдминХаба(), Объект, Хаба.Идентификатор);
	Ожидаем.Что(Состав(Дерево, Истина), "легли галки существующих узлов, исчезнувшие пропущены")
		.Равно("alpha[jlib,-web];-beta(приватный)[secret]");
	Ожидаем.Что(Мир.ХранилищеИсключений.Все().Количество(), "исключений ровно два").Равно(2);

КонецПроцедуры

&Тест
Процедура ПовторноеИсключениеНеЗаводитДубля() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Исключить(Мир, Хаба, "пакет", 42);
	Исключить(Мир, Хаба, "пакет", 42);
	Мир.Исключения.Заменить(Обвязка.АдминХаба(), Мир.Сервис.ОбъектХаба(), Хаба.Идентификатор, Узлы(Мир, "пакет", 42));

	Ожидаем.Что(Мир.ХранилищеИсключений.Все().Количество(), "у пары «подписка — узел» одно исключение")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура СнятоеИсключениеВозвращаетДоставку() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Подписка(Мир, Объект);
	Исключить(Мир, Хаба, "пакет", 42);
	Исключить(Мир, Хаба, "пул", 8);

	Мир.Исключения.Отметить(Обвязка.АдминХаба(), Объект, Хаба.Идентификатор, Новый Массив(),
		Узлы(Мир, "пакет", 42));
	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "галку вернули — пакет снова получает").Равно(1);
	Опубликовать(Мир, 8, 50, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "исключение пула 8 не тронуто").Равно(1);

	Мир.Исключения.Заменить(Обвязка.АдминХаба(), Объект, Хаба.Идентификатор, Новый Массив());
	Опубликовать(Мир, 8, 50, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "пустой перечень вернул и пул").Равно(2);
	Ожидаем.Что(Мир.ХранилищеИсключений.Все().Количество(), "исключений не осталось").Равно(0);

КонецПроцедуры

&Тест
Процедура ИсключениеСверхуИПоправкаСнизуДействуютВместе() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Исключить(Мир, Хаба, "пакет", 42);
	Мир.Поправки.Поставить(Обвязка.АдминХаба(), ОбъектПакета(Мир, 43, 7), Хаба.Идентификатор,
		Новый Структура("НеПрисылать", Истина));

	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "исключён сверху").Равно(0);
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "отключён снизу").Равно(0);
	Опубликовать(Мир, 7, 44, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "ни то ни другое — доставлено").Равно(1);

КонецПроцедуры

// Исключённый узел подписку сверху не видит: исключённый пул — ни сам, ни его пакеты, исключённый
// пакет — только он; поправку к невидимой подписке не поставить. Вернули узел — подписка видна,
// прежняя поправка снова действует.
&Тест
Процедура ИсключённыйУзелПодпискуСверхуНеВидит() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Пула = Подписка(Мир, ОбъектПула(Мир, 7), "версия.опубликована", Истина);
	Мир.Поправки.Поставить(Обвязка.АдминХаба(), ОбъектПакета(Мир, 42, 7), Хаба.Идентификатор,
		Новый Структура("НеПрисылать", Истина));

	Исключить(Мир, Хаба, "пул", 7);
	Исключить(Мир, Пула, "пакет", 43, ОбъектПула(Мир, 7));

	Ожидаем.Что(Видимые(Мир, ОбъектПула(Мир, 7)), "исключённый пул подписку хаба не видит").Равно("");
	Ожидаем.Что(Видимые(Мир, ОбъектПакета(Мир, 42, 7)), "его пакет — тоже, а подписку своего пула видит")
		.Равно(Формат(Пула.Идентификатор, "ЧГ=0"));
	Ожидаем.Что(Видимые(Мир, ОбъектПакета(Мир, 43, 7)), "исключённый из подписки пула пакет не видит ни одной")
		.Равно("");
	Ожидаем.Что(Видимые(Мир, ОбъектПакета(Мир, 50, 8)), "пакет неисключённого пула видит подписку хаба")
		.Равно(Формат(Хаба.Идентификатор, "ЧГ=0"));
	Ожидаем.Что(Мир.Поправки.Поставить(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор,
		Новый Структура("НеПрисылать", Истина)), "поправку к невидимой подписке не поставить")
		.Равно(Неопределено);
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "прежняя поправка пакета хранится").Равно(1);

	Мир.Исключения.Отметить(Обвязка.АдминХаба(), Мир.Сервис.ОбъектХаба(), Хаба.Идентификатор, Новый Массив(),
		Узлы(Мир, "пул", 7));
	Ожидаем.Что(Видимые(Мир, ОбъектПакета(Мир, 42, 7)), "узел вернули — подписка хаба снова видна")
		.Равно(Формат(Хаба.Идентификатор, "ЧГ=0") + "," + Формат(Пула.Идентификатор, "ЧГ=0"));
	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "поправка «не присылать» снова гасит подписку хаба, подписка пула доставлена")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ПодпискаХабаСРазжалованнымАвторомГаснетКакРаньше() Экспорт

	Учётки = Обвязка.УчёткиСАдминами("100");
	Мир = НовыйМир(Учётки);
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Исключить(Мир, Хаба, "пакет", 42);

	Учётки.ОтвечатьУчётками("");
	Опубликовать(Мир, 7, 43, "1.0.0");
	Опубликовать(Мир, 8, 50, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "автор больше не админ — невключённые узлы не воскрешают подписку").Равно(0);

КонецПроцедуры

&Тест
Процедура ИсключенияЧитаютсяОдинРазНаСобытиеИНеЧитаютсяПодпискеПакета() Экспорт

	Мир = НовыйМир();
	Подписка(Мир, ОбъектПакета(Мир, 42, 7));
	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Мир.ХранилищеИсключений.ВыборокПоУзлу(), "подписке пакета исключения не читаются").Равно(0);

	Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Подписка(Мир, ОбъектПула(Мир, 7));
	Опубликовать(Мир, 7, 42, "1.1.0");
	Ожидаем.Что(Доставок(Мир), "все пять доставок").Равно(5);
	Ожидаем.Что(Мир.ХранилищеИсключений.ВыборокПоУзлу(), "одна выборка на пул и одна на пакет события")
		.Равно(2);

КонецПроцедуры

#КонецОбласти

#Область Удаление

&Тест
Процедура УдалениеПодпискиУноситЕёИсключения() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Подписка(Мир, Объект);
	Другая = Подписка(Мир, Объект);
	Исключить(Мир, Хаба, "пакет", 42);
	Исключить(Мир, Другая, "пакет", 42);

	Ожидаем.Что(Мир.Сервис.Удалить(Обвязка.АдминХаба(), Объект, Хаба.Идентификатор), "подписка удалена").ЭтоИстина();
	Ожидаем.Что(Мир.ХранилищеИсключений.ПоПодписке(Хаба.Идентификатор).Количество(), "её исключения ушли").Равно(0);
	Ожидаем.Что(Мир.ХранилищеИсключений.ПоПодписке(Другая.Идентификатор).Количество(),
		"исключение соседней подписки осталось").Равно(1);

КонецПроцедуры

&Тест
Процедура УдалениеПакетаИПулаУноситИхИсключения() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Пула = Подписка(Мир, ОбъектПула(Мир, 7));
	Исключить(Мир, Хаба, "пакет", 42);
	Исключить(Мир, Хаба, "пакет", 43);
	Исключить(Мир, Хаба, "пул", 7);
	Исключить(Мир, Хаба, "пул", 8);
	Исключить(Мир, Пула, "пакет", 43, ОбъектПула(Мир, 7));
	Последствия = Новый ПодпискиНаУдаляемое(Мир.Хранилище, Мир.ХранилищеПоправок, Мир.ХранилищеИсключений,
		Мир.ИсключенияВПоправках, Новый СнятиеСтрок());

	Последствия.СнятьСтрокиПакета(Новый Структура("Идентификатор, ПулИдентификатор", 43, 7));
	Ожидаем.Что(Мир.ХранилищеИсключений.Все().Количество(), "ушли оба исключения пакета 43").Равно(3);
	Последствия.СнятьСтрокиПула(Новый Структура("Идентификатор", 7));
	Ожидаем.Что(Мир.ХранилищеИсключений.Все().Количество(), "осталось исключение пула 8").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Права

&Тест
Процедура ДеревоВидитИПравитТолькоХозяинПодписки() Экспорт

	Права = Новый ПраваПоОбъектам();
	Владелец = Новый Структура("Идентификатор, Админ", 200, Ложь);
	Издатель = Новый Структура("Идентификатор, Админ", 300, Ложь);
	Права.Выдать(Владелец, "пул", 7, "удаление,изменение,чтение");
	Права.Выдать(Издатель, "пул", 7, "создание,изменение,чтение");
	Мир = НовыйМир(, Права);
	Пул = ОбъектПула(Мир, 7);
	Пула = Подписка(Мир, Пул);
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);

	Ожидаем.Что(Мир.Исключения.ДеревоПолучателей(Владелец, Пул, Пула.Идентификатор),
		"владелец пула видит дерево своей подписки").Не_().Равно(Неопределено);
	Ожидаем.Что(Мир.Исключения.Отметить(Владелец, Пул, Пула.Идентификатор, Узлы(Мир, "пакет", 42),
		Новый Массив()), "и правит его").ЭтоИстина();

	Ожидаем.Что(ОтказаноВДереве(Мир, Издатель, Пул, Пула), "издатель пула — нет").ЭтоИстина();
	Ожидаем.Что(ОтказаноВСводке(Мир, Издатель, Пул, Пула), "и сводки не видит").ЭтоИстина();
	Ожидаем.Что(ОтказаноВДереве(Мир, Владелец, Мир.Сервис.ОбъектХаба(), Хаба),
		"владелец пула у подписки хаба — нет").ЭтоИстина();
	// подмена идентификатора: адрес своего пула, подписка хаба — её исключений пулу не видно
	Ожидаем.Что(Мир.Исключения.ДеревоПолучателей(Владелец, Пул, Хаба.Идентификатор),
		"подписка сверху под адресом своего пула дерева не отдаёт").Равно(Неопределено);
	Ожидаем.Что(Мир.Исключения.Отметить(Владелец, Пул, Хаба.Идентификатор, Узлы(Мир, "пакет", 43),
		Новый Массив()), "и править его не даёт").ЭтоЛожь();
	Ожидаем.Что(Мир.ХранилищеИсключений.ПоПодписке(Хаба.Идентификатор).Количество(),
		"у подписки хаба исключений не появилось").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПоправкаПула

// Пул сужает подписку хаба деревом своих пакетов: тот же вид, что дерево подписки пула; пакет,
// снятый хозяином подписки, виден снятым и закрытым; новый пакет — включённым.
&Тест
Процедура ДеревоПоправкиПулаНесётЕгоПакетыАСнятыеСверхуЗакрыты() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Исключить(Мир, Хаба, "пакет", 42);
	Мир.Пакеты.ДобавитьПакет(44, 7, "fresh");

	Дерево = Мир.Поправки.ДеревоПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор);
	Ожидаем.Что(Дерево.ГалкиПулов, "галки только у пакетов пула").ЭтоЛожь();
	Ожидаем.Что(Состав(Дерево, Истина), "пакеты пула; новый включён, снятый сверху — снят")
		.Равно("alpha[fresh,jlib,-web]");
	Ожидаем.Что(Дерево.Пулы[0].Пакеты[2].ИсключёнСверху, "web закрыт для правки").ЭтоИстина();
	Ожидаем.Что(Дерево.Пулы[0].Пакеты[1].ИсключёнСверху, "jlib открыт").ЭтоЛожь();
	Ожидаем.Что(Дерево.Пулы[0].ИсключеноПакетов, "снятых пакетов один").Равно(1);
	Сводка = Мир.Поправки.СводкаПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор);
	Ожидаем.Что(СтрШаблон("%1/%2", Сводка.СнялПул, Сводка.СнялХозяин), "сводка без дерева: пул не снимал, хозяин снял один")
		.Равно("0/1");
	СнятьПулом(Мир, 7, Хаба, 43);
	Сводка = Мир.Поправки.СводкаПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор);
	Ожидаем.Что(СтрШаблон("%1/%2", Сводка.СнялПул, Сводка.СнялХозяин), "снял пул — его счёт").Равно("1/1");

	Ожидаем.Что(Мир.Поправки.ДеревоПоправки(Обвязка.АдминХаба(), ОбъектПакета(Мир, 43, 7), Хаба.Идентификатор),
		"у поправки пакета дерева нет").Равно(Неопределено);
	Закрытая = Подписка(Мир, Мир.Сервис.ОбъектХаба());
	Ожидаем.Что(Мир.Поправки.ДеревоПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Закрытая.Идентификатор),
		"подписки без разрешения сужать для пула нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПакетСнятыйПуломНеПолучаетСобытийОстальныеПолучают() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Ожидаем.Что(СнятьПулом(Мир, 7, Хаба, 43), "галка легла").ЭтоИстина();

	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "снятый пулом пакет не получает").Равно(0);
	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "соседний пакет пула получает").Равно(1);
	Опубликовать(Мир, 8, 50, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "пакет другого пула получает").Равно(2);

	Подписка(Мир, ОбъектПула(Мир, 7));
	Опубликовать(Мир, 7, 43, "1.1.0");
	Ожидаем.Что(Доставок(Мир), "подписка самого пула о пакете сообщает: снят он только из подписки хаба").Равно(3);

КонецПроцедуры

// Пакет, снятый хозяином подписки хаба, снизу не вернуть и не снять: галка игнорируется без отказа
// и ничего не пишет.
&Тест
Процедура ГалкаНаСнятыйСверхуПакетНеЛожится() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Исключить(Мир, Хаба, "пакет", 42);

	Ожидаем.Что(ВернутьПулом(Мир, 7, Хаба, 42), "возврат закрытого пакета без отказа").ЭтоИстина();
	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "пакет так и не получает").Равно(0);

	Ожидаем.Что(СнятьПулом(Мир, 7, Хаба, 42), "снятие закрытого пакета без отказа").ЭтоИстина();
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "исключение пула не записано").Равно(0);
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "и поправка не заведена").Равно(0);

КонецПроцедуры

&Тест
Процедура ЧужойИНесуществующийПакетВПоправкеПропускаютсяОдинаково() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);

	// пакет 50 — в приватном пуле beta, пакета 999 нет вовсе: исход один и тот же
	Для Каждого Чужой Из СтрРазделить("50,999", ",") Цикл
		Ожидаем.Что(СнятьПулом(Мир, 7, Хаба, Число(Чужой), 43), "пакет " + Чужой + " пропущен, отказа нет")
			.ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(Состав(Мир.Поправки.ДеревоПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор),
		Истина), "легла галка своего пакета").Равно("alpha[-jlib,web]");
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "чужой и несуществующий не записаны").Равно(1);
	Опубликовать(Мир, 8, 50, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "пакет чужого пула получает").Равно(1);

КонецПроцедуры

&Тест
Процедура ПовторноеИсключениеПакетаВПоправкеНеЗаводитДубля() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	СнятьПулом(Мир, 7, Хаба, 43);
	СнятьПулом(Мир, 7, Хаба, 43, 43);
	Мир.Поправки.ЗаменитьПакеты(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор, Пакеты(43, 43));
	Мир.Поправки.ЗаменитьПакеты(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор, Пакеты(43));

	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "у пары «подписка — пакет» исключение одно")
		.Равно(1);
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "и поправка пула одна").Равно(1);

КонецПроцедуры

// Исключения пакетов — часть поправки пула: поправка с одними исключениями не «ничего не сужает»,
// правка событий их не трогает, сброс снимает вместе с ней, последний возвращённый пакет снимает
// поправку, которой больше нечего сужать.
&Тест
Процедура ИсключенияПакетовЖивутИУходятВместеСПоправкойПула() Экспорт

	Мир = НовыйМир();
	Пул = ОбъектПула(Мир, 7);
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована,версия.отозвана", Истина);

	СнятьПулом(Мир, 7, Хаба, 43);
	Поправка = Мир.Поправки.ПоправкаОбъекта(Пул, Хаба);
	Ожидаем.Что(Поправка, "первая галка завела поправку пула").Не_().Равно(Неопределено);
	Ожидаем.Что(Мир.Поправки.ИсключённыеПакеты(Поправка).Количество(), "в ней исключён один пакет").Равно(1);

	Итог = Мир.Поправки.Поставить(Обвязка.АдминХаба(), Пул, Хаба.Идентификатор, Новый Структура());
	Ожидаем.Что(Итог.Поправка, "поправка с одними исключениями пакетов не снимается").Не_().Равно(Неопределено);
	Мир.Поправки.Поставить(Обвязка.АдминХаба(), Пул, Хаба.Идентификатор,
		Новый Структура("ОставленныеСобытия", "версия.опубликована"));
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "правка событий исключений не тронула").Равно(0);

	Ожидаем.Что(Мир.Поправки.Снять(Обвязка.АдминХаба(), Пул, Хаба.Идентификатор), "поправка сброшена").ЭтоИстина();
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "сброс снял и исключения").Равно(0);
	Опубликовать(Мир, 7, 43, "1.1.0");
	Ожидаем.Что(Доставок(Мир), "пакет снова получает").Равно(1);

	СнятьПулом(Мир, 7, Хаба, 43);
	ВернутьПулом(Мир, 7, Хаба, 43);
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "вернули последний пакет — поправка снята").Равно(0);

	Мир.Поправки.Поставить(Обвязка.АдминХаба(), Пул, Хаба.Идентификатор, Новый Структура("НеПрисылать", Истина));
	СнятьПулом(Мир, 7, Хаба, 43);
	ВернутьПулом(Мир, 7, Хаба, 43);
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "поправку, которой есть что сужать, возврат не снял")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура СнятыйФлажокГаситИсключенияПулаИХранитИх() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Подписка(Мир, Объект, "версия.опубликована", Истина);
	СнятьПулом(Мир, 7, Хаба, 43);

	ПравитьРазрешение(Мир, Объект, Хаба, Ложь);
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "флажок снят — исключение пула не действует").Равно(1);
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "но хранится").Равно(1);

	ПравитьРазрешение(Мир, Объект, Хаба, Истина);
	Опубликовать(Мир, 7, 43, "1.1.0");
	Ожидаем.Что(Доставок(Мир), "флажок вернули — пакет снова снят").Равно(1);

КонецПроцедуры

// Пакет, снятый пулом, подписку хаба не видит и поправку к ней не ставит; вернули — видит,
// и его прежняя поправка снова действует.
&Тест
Процедура СнятыйПуломПакетПодпискуХабаНеВидит() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Пула = Подписка(Мир, ОбъектПула(Мир, 7), "версия.опубликована", Истина);
	Мир.Поправки.Поставить(Обвязка.АдминХаба(), ОбъектПакета(Мир, 43, 7), Хаба.Идентификатор,
		Новый Структура("НеПрисылать", Истина));

	СнятьПулом(Мир, 7, Хаба, 43);
	Ожидаем.Что(Видимые(Мир, ОбъектПакета(Мир, 43, 7)), "снятый пакет видит только подписку своего пула")
		.Равно(Формат(Пула.Идентификатор, "ЧГ=0"));
	Ожидаем.Что(Видимые(Мир, ОбъектПакета(Мир, 42, 7)), "соседний пакет видит обе")
		.Равно(Формат(Хаба.Идентификатор, "ЧГ=0") + "," + Формат(Пула.Идентификатор, "ЧГ=0"));
	Ожидаем.Что(Мир.Поправки.Поставить(Обвязка.АдминХаба(), ОбъектПакета(Мир, 43, 7), Хаба.Идентификатор,
		Новый Структура("НеПрисылать", Ложь)), "поправку к невидимой подписке не поставить").Равно(Неопределено);

	ВернутьПулом(Мир, 7, Хаба, 43);
	Ожидаем.Что(Видимые(Мир, ОбъектПакета(Мир, 43, 7)), "пакет вернули — подписка хаба снова видна")
		.Равно(Формат(Хаба.Идентификатор, "ЧГ=0") + "," + Формат(Пула.Идентификатор, "ЧГ=0"));
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "прежняя поправка пакета снова гасит подписку хаба, подписка пула доставлена")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ПакетыИсключаетТолькоПоправкаПула() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Пакет = ОбъектПакета(Мир, 42, 7);

	Ожидаем.Что(Мир.Поправки.ОтметитьПакеты(Обвязка.АдминХаба(), Пакет, Хаба.Идентификатор, Пакеты(43),
		Новый Массив()), "у поправки пакета галок пакетов нет").ЭтоЛожь();
	Ожидаем.Что(Мир.Поправки.ЗаменитьПакеты(Обвязка.АдминХаба(), Пакет, Хаба.Идентификатор, Пакеты(43)),
		"и замены нет").ЭтоЛожь();
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "ничего не записано").Равно(0);
	Ожидаем.Что(Мир.ХранилищеПоправок.Все().Количество(), "и поправка не заведена").Равно(0);

КонецПроцедуры

// Пул снял пакет сам, потом хозяин подписки закрыл его сверху: замена без него исключение пула
// не трогает, и когда хозяин пакет вернёт, тот остаётся снятым пулом.
&Тест
Процедура ЗакрытыйСверхуПакетХранитИсключениеПулаПриЗамене() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	СнятьПулом(Мир, 7, Хаба, 43);
	Исключить(Мир, Хаба, "пакет", 43);

	Мир.Поправки.ЗаменитьПакеты(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор, Новый Массив());
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "исключение пула закрытого пакета осталось").Равно(1);
	Сводка = Мир.Поправки.СводкаПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор);
	Ожидаем.Что(СтрШаблон("%1/%2", Сводка.СнялПул, Сводка.СнялХозяин),
		"снятый и пулом, и сверху пакет считается один раз — у хозяина").Равно("0/1");

	Мир.Исключения.Отметить(Обвязка.АдминХаба(), Мир.Сервис.ОбъектХаба(), Хаба.Идентификатор, Новый Массив(),
		Узлы(Мир, "пакет", 43));
	Ожидаем.Что(Состав(Мир.Поправки.ДеревоПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор),
		Истина), "хозяин вернул — пакет снят пулом и открыт").Равно("alpha[-jlib,web]");
	Опубликовать(Мир, 7, 43, "1.0.0");
	Ожидаем.Что(Доставок(Мир), "и событий не получает").Равно(0);

КонецПроцедуры

// Пул, исключённый хозяином подписки целиком, подписку не видит — и дерева поправки у него нет.
&Тест
Процедура ПулСнятыйСверхуДереваПоправкиНеВидит() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	Исключить(Мир, Хаба, "пул", 7);

	Ожидаем.Что(Мир.Поправки.ДеревоПоправки(Обвязка.АдминХаба(), ОбъектПула(Мир, 7), Хаба.Идентификатор),
		"дерева нет").Равно(Неопределено);
	Ожидаем.Что(СнятьПулом(Мир, 7, Хаба, 43), "и галки не ложатся").ЭтоЛожь();
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "ничего не записано").Равно(0);

КонецПроцедуры

&Тест
Процедура ХозяинВидитСколькоПакетовИсключилПул() Экспорт

	Мир = НовыйМир();
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	СнятьПулом(Мир, 7, Хаба, 43, 42);
	Мир.Поправки.Поставить(Обвязка.АдминХаба(), ОбъектПакета(Мир, 50, 8), Хаба.Идентификатор,
		Новый Структура("НеПрисылать", Истина));

	Исключено = Новый Массив();
	Для Каждого Поправка Из Мир.Поправки.ПоправкиПодписки(Хаба) Цикл
		Исключено.Добавить(Поправка.ТипОбъекта + ":" + Мир.Поправки.ИсключённыеПакеты(Поправка).Количество());
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Исключено, ","), "пул исключил два пакета, у поправки пакета исключений нет")
		.Равно("пул:2,пакет:0");

КонецПроцедуры

&Тест
Процедура ИсключенияВПоправкахЧитаютсяОдинРазНаСобытиеИТолькоПодпискеХаба() Экспорт

	Мир = НовыйМир();
	Подписка(Мир, ОбъектПула(Мир, 7), "версия.опубликована,пул.заполнен", Истина);
	Подписка(Мир, ОбъектПакета(Мир, 42, 7));
	Опубликовать(Мир, 7, 42, "1.0.0");
	Ожидаем.Что(Мир.ИсключенияВПоправках.ВыборокПоПакету(), "без подписки хаба не читаются").Равно(0);

	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована,пул.заполнен", Истина);
	Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);
	СнятьПулом(Мир, 7, Хаба, 43);
	Опубликовать(Мир, 7, 42, "1.1.0");
	Ожидаем.Что(Мир.ИсключенияВПоправках.ВыборокПоПакету(), "одна выборка на событие для двух подписок хаба")
		.Равно(1);
	Мир.Подписчик.ОбработатьСобытие(СобытиеЗаполнения(7));
	Ожидаем.Что(Мир.ИсключенияВПоправках.ВыборокПоПакету(), "у события без пакета — ни одной").Равно(1);

КонецПроцедуры

&Тест
Процедура УдалениеПодпискиПулаИПакетаУноситИсключенияВПоправках() Экспорт

	Мир = НовыйМир();
	Объект = Мир.Сервис.ОбъектХаба();
	Хаба = Подписка(Мир, Объект, "версия.опубликована", Истина);
	Другая = Подписка(Мир, Объект, "версия.опубликована", Истина);
	СнятьПулом(Мир, 7, Хаба, 42, 43);
	СнятьПулом(Мир, 8, Хаба, 50);
	СнятьПулом(Мир, 7, Другая, 43);
	Последствия = Новый ПодпискиНаУдаляемое(Мир.Хранилище, Мир.ХранилищеПоправок, Мир.ХранилищеИсключений,
		Мир.ИсключенияВПоправках, Новый СнятиеСтрок());

	Последствия.СнятьСтрокиПакета(Новый Структура("Идентификатор, ПулИдентификатор", 43, 7));
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "ушли оба исключения пакета 43").Равно(2);
	Последствия.СнятьСтрокиПула(Новый Структура("Идентификатор", 8));
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "ушло исключение пакета пула 8").Равно(1);
	Ожидаем.Что(Мир.Сервис.Удалить(Обвязка.АдминХаба(), Объект, Хаба.Идентификатор), "подписка удалена").ЭтоИстина();
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "её исключения в поправках ушли").Равно(0);

КонецПроцедуры

&Тест
Процедура ДеревоПоправкиВидитИПравитРаспорядительПула() Экспорт

	Права = Новый ПраваПоОбъектам();
	Владелец = Новый Структура("Идентификатор, Админ", 200, Ложь);
	Издатель = Новый Структура("Идентификатор, Админ", 300, Ложь);
	Права.Выдать(Владелец, "пул", 7, "удаление,изменение,чтение");
	Права.Выдать(Издатель, "пул", 7, "создание,изменение,чтение");
	Мир = НовыйМир(, Права);
	Пул = ОбъектПула(Мир, 7);
	Хаба = Подписка(Мир, Мир.Сервис.ОбъектХаба(), "версия.опубликована", Истина);

	Ожидаем.Что(Мир.Поправки.ДеревоПоправки(Владелец, Пул, Хаба.Идентификатор),
		"владелец пула видит дерево поправки").Не_().Равно(Неопределено);
	Ожидаем.Что(Мир.Поправки.ОтметитьПакеты(Владелец, Пул, Хаба.Идентификатор, Пакеты(43), Новый Массив()),
		"и снимает галку").ЭтоИстина();

	Ожидаем.Что(ОтказаноВДеревеПоправки(Мир, Издатель, Пул, Хаба), "издатель пула — нет").ЭтоИстина();
	Ожидаем.Что(ОтказаноВГалкахПоправки(Мир, Издатель, Пул, Хаба), "и галок не ставит").ЭтоИстина();
	Ожидаем.Что(ОтказаноВДеревеПоправки(Мир, Владелец, ОбъектПула(Мир, 8), Хаба), "владелец чужого пула — нет")
		.ЭтоИстина();
	Ожидаем.Что(Мир.ИсключенияВПоправках.Все().Количество(), "легла только галка владельца").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Мир

// Хаб из пулов alpha (7: jlib 43, web 42) и приватного beta (8: secret 50); подписки, поправки,
// исключения и доставка — настоящие классы на фейках хранилищ.
Функция НовыйМир(Знач Учётки = Неопределено, Знач Права = Неопределено)

	Издатель = Новый ИздательСобытий();
	Каталог = СобытияХаба.Каталог(Издатель);
	Параметры = Новый ПараметрыПодписки(Каталог);
	Хранилище = Новый ФейкХранилищеВебхуков();
	ХранилищеПоправок = Новый ФейкХранилищеПоправок();
	ХранилищеИсключений = Новый ФейкХранилищеИсключений();
	ИсключенияВПоправках = Новый ФейкХранилищеИсключенийВПоправках();
	Каналы = Новый ФейкКаналыПакетов();
	ОтборТегов = Новый ОтборПоТегам(Каналы, Каналы, Издатель);
	Реестр = РеестрВебхука();

	Пулы = Новый ФейкСервисПулов();
	Пулы.ДобавитьПул(7, "alpha");
	Пулы.ДобавитьПул(8, "beta", "private");
	Пакеты = Новый РазрезСервисПакетов();
	Пакеты.ДобавитьПакет(42, 7, "web");
	Пакеты.ДобавитьПакет(43, 7, "jlib");
	Пакеты.ДобавитьПакет(50, 8, "secret");

	Сервис = Новый СервисПодписок(Хранилище, ?(Права = Неопределено, Новый ПраваПоОбъектам(), Права),
		Реестр, Каталог, Параметры,
		Новый АудитПробыПодписки(Обвязка.ИменаЖурнала(),
			Новый СобытиеАудита(Обвязка.ИменаЖурнала(), Новый ТекстJSON())),
		Новый ОграничительПроб(НастройкиПодписок()),
		?(Учётки = Неопределено, Обвязка.УчёткиСАдминами("100"), Учётки),
		ХранилищеПоправок, ХранилищеИсключений, ИсключенияВПоправках, ОтборТегов, Неопределено, Издатель,
		Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено));

	Отбор = Новый ОтборДоставкиПодписок(Новый ОтборЗаполненияПула(Параметры, Новый ЗаполнениеПула(), Издатель),
		ОтборТегов, Параметры, ХранилищеПоправок, ХранилищеИсключений, ИсключенияВПоправках, Новый ТекстОшибки(),
		ЛогТестов());
	Служба = НоваяСлужбаДоставки(Реестр);

	Мир = Новый Структура();
	Мир.Вставить("Сервис", Сервис);
	Ветки = Новый ВеткиДереваПолучателей(Пулы, Пакеты);
	Мир.Вставить("Поправки", Новый СервисПоправокПодписок(ХранилищеПоправок, ХранилищеИсключений, Сервис, Параметры,
		ОтборТегов, ИсключенияВПоправках, Ветки, Пакеты));
	Мир.Вставить("Исключения", Новый СервисИсключенийПодписок(ХранилищеИсключений, Сервис, Пулы, Пакеты, Ветки));
	Мир.Вставить("ИсключенияВПоправках", ИсключенияВПоправках);
	Мир.Вставить("Хранилище", Хранилище);
	Мир.Вставить("ХранилищеПоправок", ХранилищеПоправок);
	Мир.Вставить("ХранилищеИсключений", ХранилищеИсключений);
	Мир.Вставить("Пулы", Пулы);
	Мир.Вставить("Пакеты", Пакеты);
	Мир.Вставить("Служба", Служба);
	Мир.Вставить("Подписчик", Новый ПодписчикВебхуков(Сервис, Служба, Издатель, Обвязка.Готовность(ЛогТестов()),
		Реестр, ЛогТестов(), Новый ТекстОшибки(), Новый ТелоСобытия(Новый АдресаСтраниц(), Неопределено), Отбор));
	Возврат Мир;

КонецФункции

// Подписка от имени админа хаба; адрес у каждой свой — дубля адреса на объекте нет.
Функция Подписка(Знач Мир, Знач Объект, Знач Типы = "версия.опубликована", Знач Сужаемая = Ложь)
	Возврат Мир.Сервис.СоздатьПодписку(Обвязка.АдминХаба(), Объект, "вебхук",
		Новый Структура("URL, Секрет", "https://hook.example.com/" + Строка(Новый УникальныйИдентификатор()), ""),
		Типы, Неопределено, Новый Структура("СужениеРазрешено", Сужаемая));
КонецФункции

// Снимает галку узла от имени админа хаба; объект подписки — хаб, если не назван.
Процедура Исключить(Знач Мир, Знач Подписка, Знач ТипУзла, Знач Ид, Знач Объект = Неопределено)
	Мир.Исключения.Отметить(Обвязка.АдминХаба(), ?(Объект = Неопределено, Мир.Сервис.ОбъектХаба(), Объект),
		Подписка.Идентификатор, Узлы(Мир, ТипУзла, Ид), Новый Массив());
КонецПроцедуры

// Идентификаторы подписок сверху, которые объект видит, через запятую.
Функция Видимые(Знач Мир, Знач Объект)
	Номера = Новый Массив();
	Для Каждого Подписка Из Мир.Поправки.ПодпискиСверху(Объект) Цикл
		Номера.Добавить(Формат(Подписка.Идентификатор, "ЧГ=0"));
	КонецЦикла;
	Возврат СтрСоединить(Номера, ",");
КонецФункции

Функция Узлы(Знач Мир, Знач ТипУзла, Знач Ид)
	Результат = Новый Массив();
	Результат.Добавить(Мир.Исключения.Узел(ТипУзла, Ид));
	Возврат Результат;
КонецФункции

Функция Отказ(Знач Мир, Знач Объект, Знач Подписка, Знач ТипУзла, Знач Ид)
	Попытка
		Мир.Исключения.Отметить(Обвязка.АдминХаба(), Объект, Подписка.Идентификатор, Узлы(Мир, ТипУзла, Ид),
			Новый Массив());
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ОтказаноВДереве(Знач Мир, Знач Кто, Знач Объект, Знач Подписка)
	Попытка
		Мир.Исключения.ДеревоПолучателей(Кто, Объект, Подписка.Идентификатор);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ОтказаноВСводке(Знач Мир, Знач Кто, Знач Объект, Знач Подписка)
	Попытка
		Мир.Исключения.СводкаИсключений(Кто, Объект, Подписка.Идентификатор);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Пул снимает в своей поправке к подписке галки пакетов от имени админа хаба.
Функция СнятьПулом(Знач Мир, Знач ПулИд, Знач Подписка, Знач Ид1, Знач Ид2 = Неопределено)
	Возврат Мир.Поправки.ОтметитьПакеты(Обвязка.АдминХаба(), ОбъектПула(Мир, ПулИд), Подписка.Идентификатор,
		Пакеты(Ид1, Ид2), Новый Массив());
КонецФункции

Функция ВернутьПулом(Знач Мир, Знач ПулИд, Знач Подписка, Знач Ид)
	Возврат Мир.Поправки.ОтметитьПакеты(Обвязка.АдминХаба(), ОбъектПула(Мир, ПулИд), Подписка.Идентификатор,
		Новый Массив(), Пакеты(Ид));
КонецФункции

Функция Пакеты(Знач Ид1, Знач Ид2 = Неопределено)
	Результат = Новый Массив();
	Результат.Добавить(Ид1);
	Если Ид2 <> Неопределено Тогда
		Результат.Добавить(Ид2);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ПравитьРазрешение(Знач Мир, Знач Объект, Знач Подписка, Знач Разрешено)
	Мир.Сервис.ОбновитьПодписку(Обвязка.АдминХаба(), Объект, Подписка.Идентификатор, "",
		Новый Структура("URL, Секрет, СекретСвой", Подписка.URL, "", Истина), Подписка.ТипыСобытий, Истина,
		Неопределено, Новый Структура("СужениеРазрешено", Разрешено));
КонецПроцедуры

Функция ОтказаноВДеревеПоправки(Знач Мир, Знач Кто, Знач Пул, Знач Подписка)
	Попытка
		Мир.Поправки.ДеревоПоправки(Кто, Пул, Подписка.Идентификатор);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ОтказаноВГалкахПоправки(Знач Мир, Знач Кто, Знач Пул, Знач Подписка)
	Попытка
		Мир.Поправки.ОтметитьПакеты(Кто, Пул, Подписка.Идентификатор, Пакеты(42), Новый Массив());
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Дерево строкой: «пул(приватный)[пакет,…];…»; с отметками исключённый узел — с минусом.
Функция Состав(Знач Дерево, Знач СОтметками = Ложь)

	Пулы = Новый Массив();
	Для Каждого Пул Из Дерево.Пулы Цикл
		Пакеты = Новый Массив();
		Для Каждого Пакет Из Пул.Пакеты Цикл
			Пакеты.Добавить(?(СОтметками И Пакет.Исключён, "-", "") + Пакет.Имя);
		КонецЦикла;
		Пулы.Добавить(?(СОтметками И Пул.Исключён, "-", "") + Пул.Имя + ?(Пул.Приватный, "(приватный)", "")
			+ "[" + СтрСоединить(Пакеты, ",") + "]");
	КонецЦикла;
	Возврат СтрСоединить(Пулы, ";");

КонецФункции

Процедура Опубликовать(Знач Мир, Знач ПулИд, Знач ПакетИд, Знач Версия)
	Мир.Подписчик.ОбработатьСобытие(Новый Структура("Тип, Когда, Данные", "версия.опубликована",
		ТекущаяУниверсальнаяДата(), Новый Структура("ПулИдентификатор, ПакетИдентификатор, ИмяПула, ИмяПакета, Версия",
			ПулИд, ПакетИд, "пул", "пакет", Версия)));
КонецПроцедуры

Функция СобытиеЗаполнения(Знач ПулИд)
	Возврат Новый Структура("Тип, Когда, Данные", "пул.заполнен", ТекущаяУниверсальнаяДата(),
		Новый Структура("ПулИдентификатор, ИмяПула, Процент, ПроцентДо", ПулИд, "пул", 85, 70));
КонецФункции

Функция Доставок(Знач Мир)
	Возврат Мир.Служба.РазмерОчереди();
КонецФункции

Функция ОбъектПула(Знач Мир, Знач Ид)
	Возврат Мир.Сервис.ОбъектПула(Новый Структура("Идентификатор, Имя", Ид, "пул-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция ОбъектПакета(Знач Мир, Знач Ид, Знач ПулИд)
	Возврат Мир.Сервис.ОбъектПакета(Новый Структура("Идентификатор, ПулИдентификатор, Имя",
		Ид, ПулИд, "пакет-" + Формат(Ид, "ЧГ=0")));
КонецФункции

Функция РеестрВебхука()
	Валидатор = Новый ФейкВалидаторВебхука();
	Доставки = Новый Массив();
	Доставки.Добавить(Новый ДоставкаВебхуком(Новый ФейкТранспортHTTP(), Валидатор,
		Новый ЧислаДоставки(НастройкиПодписок()), СобытияХаба.Каталог(), ЛогТестов()));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения);
КонецФункции

Функция НоваяСлужбаДоставки(Знач Реестр)
	Очередь = Новый ОчередьДоставокПодписок(Новый ФейкХранилищеЗаданийДоставки(), НастройкиПодписок(),
		ЛогТестов(), Новый ПриведениеЧисел());
	Возврат Новый СлужбаДоставкиПодписок(Реестр, Очередь, Новый ЧислаДоставки(НастройкиПодписок()),
		ЛогТестов(), Новый ТекстОшибки());
КонецФункции

Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Возврат Настройки;
КонецФункции

// Лог для классов, создаваемых Новый: &Лог до них не внедряется.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.дерево");
КонецФункции

#КонецОбласти
