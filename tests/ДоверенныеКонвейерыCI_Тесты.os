// Публикация доверенным конвейером НАСКВОЗЬ: точка маршрута push вызывается с id-token в
// заголовке OAUTH-TOKEN, подпись RS256 проверяется по-настоящему, JWKS отдаёт фейковый
// транспорт — в сеть набор не ходит. Ключи и токены лежат в tests/фикстуры/ci-токены.json
// (генератор — tests/фикстуры/сгенерировать-ci-токены.py).
// У каждого «должно быть отказано» рядом стоит запрос, который проходит.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать autumn-logos
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Контроллер;
Перем Фикстура;
Перем КореньХранилища;
Перем КаталогСборки;
Перем Публикация;    // фикстура СтендПубликации — пул с мейнтейнером
                     // и имя пакета, заведённое публикацией .ospx

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендПубликации");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");

	Фикстура = ПрочитатьФикстуру(ОбъединитьПути(Фикстуры, "ci-токены.json"));

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	// SSRF-гейт адресов: его же судьёй пользуется СтражИздателейCI
	// системный разрешитель имён НЕ подключается: его прозвище занимает шпион, и любое
	// обращение к нему на пути доверенных конвейеров становится видимым числом
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ШпионРазрешителяИмён.os"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ВалидаторАдресаАпстрима");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "СвояСеть");
	// правило токена доступа к источнику: СервисПулов спрашивает его на каждом апстриме
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "СекретИсточника");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "ЗаведениеИсточника");

	КаталогВхода = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("вход", "Классы"));
	Для Каждого Имя Из СтрРазделить("СверкаСекретов,"
		+ "УчёткаПринципала,ВердиктГварда,СервисПрав,СервисГрупп,СервисПравДоступа,ПроверяющийGitHub,"
		+ "СервисТокенов,ГейтТокена,ГвардКлюча,ДопускПринципала,НормализаторУчётки,ПолитикаПароля,"
		+ "СервисПользователей,ХранилищеСессийБД,СлужбаСессий,ПерехватчикАутентификации", ",") Цикл
		ПоискКлассов.Подключить(КаталогМодулей, Имя);
	КонецЦикла;

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	// сеть/КлиентHTTP НЕ подключаем: прозвище ТранспортHTTP занимает фейк, и через него
	// ходит боевой ТранспортJWKSХаба со своим гейтом адресов; ожидание похода наружу
	// он всё равно спрашивает у владельца
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПроб = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПроб, "ГотовностьХаба.os"));

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей,
		ОбъединитьПути("api", ОбъединитьПути("Классы", "РезолверФайлаПакета.os"))));

	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(
		Новый Файл(ОбъединитьПути(КаталогSettings, "..", "..")).ПолноеИмя,
		"основа", "Классы", "ПриведениеФлагов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	// publish целиком, кроме контроллера: он подключается ТИПОМ после сборки контейнера
	КаталогPublish = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("публикация", "Классы"));
	Для Каждого Имя Из СтрРазделить("СервисВходящих,СтражИздателейCI,МаскаРефа,КороткаяФормаДоверия,ИмяЗаписиДоверия,"
		+ "ВидРефаДоверия,СрокТокенаCI,АудиторияТокенаCI,ТранспортJWKSХаба,"
		+ "КэшиКлючейCI,ПроверяющийПодписиJWKS,СервисДоверияCI,МестоВПуле,СервисПубликации,"
		+ "РассмотрениеВходящих,СервисРезервированияИмён", ",") Цикл
		ПоискКлассов.Подключить(КаталогPublish, Имя);
	КонецЦикла;

	// исход заявки заявителю уходит личным каналом; здесь проверяется домен, а не канал,
	// поэтому дверь подменена фейком — перечень поводов при этом настоящий
	ПоискКлассов.Подключить(КаталогМодулей, "ПоводыУведомлений");
	РеестрФикстур.Подключить("ФейкКаналаУведомлений");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийGitHub.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкТранспортHTTPПоАдресам.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФикстураПакета.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "КукиЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ОтветПушаЗаглушка.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-ci-trust-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "доверенные-конвейеры-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Публикация = Новый СтендПубликации(Поделка, КаталогСборки);

	НаполнитьТранспорт();
	// аудитория задаётся ЗНАЧЕНИЕМ, а не деталькой: форсированную конфигом настройку
	// доменный API править не даёт, а один тест снимает её и возвращает
	ЗадатьАудиторию(Фикстура["аудитория"]);

	// контроллер регистрируется ТИПОМ после сборки: ОСень не должна видеть &Контроллер,
	// а winow в этом контейнере нет вовсе
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		ОбъединитьПути("журнал", "ОбезличиваниеЖурнала.os")));
	ПоискКлассов.Подключить(КаталогPublish, "КонтроллерПубликации");
	Контроллер = Новый КонтроллерПубликации(Желудь("СервисПубликации"),
		Желудь("ПерехватчикАутентификации"), Новый КукиЗаглушка(), Желудь("СервисПулов"),
		ЛогТестов(), Желудь("ЗаголовкиHTTP"));

	// то же и с фейком проверяющего: у него прозвище боевого, и до сборки контейнера
	// ОСень нашла бы два желудя с одним прозвищем
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "КодировкаТестов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийПодписиCI.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкВалидатораАдресаCI.os"));

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область СквознойПуть

// ГЛАВНЫЙ ТЕСТ ТРЕКА: маршрут push с настоящим id-token в OAUTH-TOKEN публикует версию.
// Подпись проверяется по-настоящему: ключ приезжает из JWKS через боевой ТранспортJWKSХаба.
&Тест
Процедура PushIdTokenомПубликуетВерсию() Экспорт

	Стенд = ЗавестиСтенд("cifull");

	Ответ = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Ответ.Код, "маршрут push принял id-token: " + Ответ.ТелоТекст).Равно(201);
	Ожидаем.Что(Ответ.Заголовок("Content-Type"), "ответ opm-формата").Содержит("application/json");
	Ожидаем.Что(Ответ.ТелоТекст, "тело содержит код состояния").Содержит("КодСостояние");
	Ожидаем.Что(ВерсияЕсть(Стенд, "1.1.0"), "версия опубликована").ЭтоИстина();

КонецПроцедуры

// Токен, подписанный ЧУЖИМ ключом с тем же kid: ключ найден, подпись не сходится.
&Тест
Процедура ЧужаяПодписьНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("cisig");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужая_подпись"));
	Ожидаем.Что(Атака.Код, "чужая подпись → 403").Равно(403);
	Ожидаем.Что(Атака.ТелоТекст, "причина названа").Содержит("подпись");
	Ожидаем.Что(ВерсияЕсть(Стенд, "1.1.0"), "версии нет").ЭтоЛожь();

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: те же клеймы, своя подпись — 201").Равно(201);

КонецПроцедуры

// kid, которого в JWKS нет: ключ не подбирается перебором.
&Тест
Процедура НеизвестныйKidНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("cikid");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("неизвестный_kid"));
	Ожидаем.Что(Атака.Код, "неизвестный kid → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: известный kid публикует").Равно(201);

КонецПроцедуры

// alg: none — классическая подмена алгоритма.
&Тест
Процедура ТокенБезАлгоритмаНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("cialg");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("alg_none"));
	Ожидаем.Что(Атака.Код, "alg none → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: RS256 публикует").Равно(201);

КонецПроцедуры

&Тест
Процедура ИстёкшийТокенНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("ciexp");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("истёкший"));
	Ожидаем.Что(Атака.Код, "истёкший id-token → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: живой срок публикует").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область Аудитория

// У-21: id-token, выпущенный доверенным репозиторием ДЛЯ ДРУГОГО СЕРВИСА, этот хаб не принимает.
&Тест
Процедура ТокенЧужогоСервисаНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("ciaud");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужая_аудитория"));
	Ожидаем.Что(Атака.Код, "aud чужого сервиса → 403").Равно(403);
	Ожидаем.Что(Атака.ТелоТекст, "причина названа").Содержит("другого сервиса");

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: тот же токен с нашим aud публикует").Равно(201);

КонецПроцедуры

// aud обязателен: токен вовсе без клейма — отказ, а не «проверять нечего».
&Тест
Процедура ТокенБезAudНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("cinoaud");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("без_аудитории"));
	Ожидаем.Что(Атака.Код, "нет aud → 403").Равно(403);
	Ожидаем.Что(Атака.ТелоТекст, "причина названа").Содержит("aud");

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: с aud публикует").Равно(201);

КонецПроцедуры

// aud по RFC 7519 бывает массивом — наш адрес в списке принимается.
&Тест
Процедура AudМассивомСНашимАдресомПубликует() Экспорт

	Стенд = ЗавестиСтенд("ciaudarr");

	Ответ = ПушТокеном(Стенд, "1.1.0", Токен("аудитория_массивом"));
	Ожидаем.Что(Ответ.Код, "aud-массив с нашим адресом: " + Ответ.ТелоТекст).Равно(201);

КонецПроцедуры

// Хаб, не знающий своего адреса, доверенные конвейеры НЕ обслуживает: сверять aud не с чем.
&Тест
Процедура БезНастроеннойАудиторииКонвейерНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("ciaudoff");

	Желудь("СервисНастроек").Сбросить("oshub.publish.ci.audience", "тест");
	Попытка
		Атака = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Исключение
		ЗадатьАудиторию(Фикстура["аудитория"]);
		ВызватьИсключение;
	КонецПопытки;
	ЗадатьАудиторию(Фикстура["аудитория"]);

	Ожидаем.Что(Атака.Код, "аудитория не задана → 403").Равно(403);
	Ожидаем.Что(Атака.ТелоТекст, "администратору названо, что задать").Содержит("oshub.instance.url");

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: с заданной аудиторией тот же токен публикует").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область КлеймыЗаписи

&Тест
Процедура ЧужойРепозиторийНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("cirepo");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужой_репозиторий"));
	Ожидаем.Что(Атака.Код, "чужой repository → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: свой репозиторий публикует").Равно(201);

КонецПроцедуры

&Тест
Процедура ЧужойРефНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("ciref");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужой_реф"));
	Ожидаем.Что(Атака.Код, "чужая ветка доверенного репозитория → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: доверенная ветка публикует").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область МаскаРефа

// Маска ветки работает НАСКВОЗЬ: «ma*» пускает refs/heads/main и не пускает
// refs/heads/attacker. Отличие атаки от контроля ровно одно — ветка в клейме.
&Тест
Процедура МаскаВеткиПускаетСвоюВеткуИНеПускаетЧужую() Экспорт

	Стенд = ЗавестиСтендСРефом("cimask", "release.yml", "ma*", "");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужой_реф"));
	Ожидаем.Что(Атака.Код, "ветка вне маски → 403").Равно(403);
	Ожидаем.Что(ВерсияЕсть(Стенд, "1.1.0"), "версии нет").ЭтоЛожь();

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: ветка по маске публикует: " + Контроль.ТелоТекст).Равно(201);

КонецПроцедуры

// «**» — осознанно написанное «всё»: приставкой его не сужают, и публикует ЛЮБАЯ ветка.
// Это и есть та самая атака, о которой предупреждает форма, — здесь она видна целиком.
&Тест
Процедура МаскаВсегоПускаетЛюбуюВетку() Экспорт

	Стенд = ЗавестиСтендСРефом("ciall", "release.yml", "**", "");

	Ожидаем.Что(Стенд.Реф, "«**» в записи осталось «всем», а не «refs/heads/**»").Равно("**");
	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("чужой_реф")).Код,
		"чужая ветка проходит: маска не ограничивает имя").Равно(201);
	Ожидаем.Что(ПушТокеном(Стенд, "1.2.0", Токен("годный")).Код,
		"и своя тоже").Равно(201);

КонецПроцедуры

// Маска тега достраивается тегом, а не веткой: «v*» видом «тег» — это refs/tags/v*.
&Тест
Процедура МаскаТегаДостраиваетсяТегом() Экспорт

	Стенд = ЗавестиСтендСРефом("citag", "release.yml", "v*", "тег");

	Ожидаем.Что(Стенд.Реф, "маска достроена ТЕГОМ").Равно("refs/tags/v*");
	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("годный")).Код,
		"а ветка refs/heads/main под неё не подходит → 403").Равно(403);

КонецПроцедуры

// Границы языка масок: маска покрывает реф ЦЕЛИКОМ и ничего сверх того — мусор не проходит
// ни спереди, ни сзади, ни в середине; «*» не переходит через «/», «**» переходит;
// спецсимволы регулярных выражений остаются обычными символами.
&Тест
Процедура МаскаСовпадаетТолькоЦеликом() Экспорт

	Маски = Желудь("МаскаРефа");

	Ожидаем.Что(Маски.Совпадает("refs/tags/v*", "refs/tags/v1.2.3"),
		"«*» покрывает имя тега").ЭтоИстина();
	Ожидаем.Что(Маски.Совпадает("refs/tags/v*", "refs/tags/v1/hotfix"),
		"но через «/» не переходит").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/**", "refs/heads/feature/deep/branch"),
		"«**» переходит").ЭтоИстина();

	// мусор с любой стороны и внутри: совпадение только по всей строке
	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "evil/refs/heads/main"),
		"мусор СПЕРЕДИ не проходит").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "refs/heads/main/evil"),
		"мусор СЗАДИ не проходит").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "refs/heads/mXain"),
		"мусор В СЕРЕДИНЕ не проходит").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "refs/heads/main"),
		"КОНТРОЛЬ: ровное значение проходит").ЭтоИстина();

	// перевод строки и прочие управляющие символы клеймом ref не бывают: отказ на входе,
	// иначе «мусор спереди» въезжал бы отдельной строкой
	Ожидаем.Что(Маски.Совпадает("refs/heads/main",
			"refs/heads/main" + Символы.ПС + "refs/heads/evil"),
		"хвост за переводом строки не проходит").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/main",
			"refs/heads/evil" + Символы.ПС + "refs/heads/main"),
		"и голова перед ним тоже").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/*", "refs/heads/a" + Символы.ПС + "b"),
		"звезда управляющих символов не покрывает").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("**", "refs/heads/a" + Символы.Таб + "b"),
		"и «всё» тоже не покрывает").ЭтоЛожь();

	Ожидаем.Что(Маски.Совпадает("refs/heads/a?b", "refs/heads/a.b"),
		"«?» — обычный символ, а не «любой символ» регулярки").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/a.b", "refs/heads/aXb"),
		"точка — обычный символ").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/a.b", "refs/heads/a.b"),
		"КОНТРОЛЬ: она же совпадает сама с собой").ЭтоИстина();
	Ожидаем.Что(Маски.Совпадает("refs/heads/x+", "refs/heads/xxx"),
		"«+» — обычный символ").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/[a]", "refs/heads/a"),
		"скобки класса — обычные символы").ЭтоЛожь();

	// расти обязана бывает РАННЯЯ звезда: язык не разбирается одной точкой отката
	Ожидаем.Что(Маски.Совпадает("**x*y", "x/ab/xcy"),
		"ранняя звезда растёт, поздняя «/» не переходит").ЭтоИстина();

	Ожидаем.Что(Маски.СлишкомШирокая("refs/heads/*"),
		"маска без ограничения имени — широкая").ЭтоИстина();
	Ожидаем.Что(Маски.СлишкомШирокая("refs/tags/v*"),
		"а маска с именем — нет").ЭтоЛожь();

КонецПроцедуры

// РЕГИСТР. Ветка «Main» — не ветка «main»: защищена одна, а пушит контрибьютор другую,
// и совпадение по регистру отдало бы ему право публиковать пакет. Сверка клейма
// регистрозависима, и обычное сравнение строк в OneScript тоже.
&Тест
Процедура СверкаРефаРегистрозависима() Экспорт

	Маски = Желудь("МаскаРефа");

	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "refs/heads/MAIN"),
		"верхний регистр имени ветки не проходит").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "refs/heads/Main"),
		"и заглавная первая буква тоже").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "refs/heads/MAIN/x"),
		"и она же с хвостом").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/tags/v1.0", "refs/tags/V1.0"),
		"тег другого регистра — тоже не тот тег").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает("refs/heads/ma*", "refs/heads/MAIN"),
		"регистр значим и в литеральной части маски").ЭтоЛожь();

	Ожидаем.Что(Маски.Совпадает("refs/heads/main", "refs/heads/main"),
		"КОНТРОЛЬ: свой регистр проходит").ЭтоИстина();
	Ожидаем.Что(Маски.Совпадает("refs/heads/*", "refs/heads/MAIN"),
		"КОНТРОЛЬ: звезда покрывает имя любого регистра").ЭтоИстина();

КонецПроцедуры

// Маску пишет мейнтейнер, а сверка идёт на КАЖДОЙ попытке публикации, поэтому враждебная
// маска не должна стоить больше обычной. Числа — из отчёта ревью: на регулярном выражении
// первая уходила в 4530 мс, вторая не завершалась за минуты.
&Тест
Процедура ВраждебнаяМаскаНеВешаетСверку() Экспорт

	Маски = Желудь("МаскаРефа");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ожидаем.Что(Маски.Совпадает(Повторить("**a", 6) + "**b", Повторить("a", 60)),
		"совпадения нет — искать его пришлось честно").ЭтоЛожь();
	Ожидаем.Что(Маски.Совпадает(Повторить("**a", 20) + "**b", Повторить("a", 200)),
		"и на двадцати группах тоже").ЭтоЛожь();
	Потрачено = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем.Что(Потрачено < 1000,
		"обе враждебные маски вместе укладываются в 1000 мс, потрачено "
		+ Формат(Потрачено, "ЧГ=0; ЧН=0")).ЭтоИстина();

КонецПроцедуры

// Пустой реф отвергает СЕРВИС: форму обойти можно, его — нет.
&Тест
Процедура ПустойРефЗаписьНеСоздаёт() Экспорт

	Стенд = Публикация.ЗаведённоеИмя("ciempty");

	Пустой = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		"", Фикстура["репозиторий"], "release.yml", "");
	Ожидаем.Что(Пустой.Успех, "запись без рефа не создаётся").ЭтоЛожь();
	Ожидаем.Что(Пустой.Код, "и это 400 с объяснением").Равно(400);
	Ожидаем.Что(Пустой.Сообщение, "названа и причина").Содержит("любая ветка");
	Ожидаем.Что(Доверие().КонвейерыПакета(Стенд.Пакет).Количество(), "записей нет").Равно(0);

	Пробельный = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		"", Фикстура["репозиторий"], "release.yml", "   ");
	Ожидаем.Что(Пробельный.Успех, "пробелы рефом не считаются").ЭтоЛожь();

	Контроль = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		"", Фикстура["репозиторий"], "release.yml", "main");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: та же запись с веткой создаётся").ЭтоИстина();

КонецПроцедуры

// FAIL-CLOSED: запись с пустым рефом, откуда бы она ни взялась, публикацию НЕ открывает.
// Пишем её мимо сервиса — так она могла бы остаться от прежнего правила «пусто = любой».
&Тест
Процедура ПустойРефВЗаписиДаётНесовпадение() Экспорт

	Стенд = Публикация.ЗаведённоеИмя("cifailclosed");
	ЗаписатьДовериеМимоСервиса(Стенд.Пакет, "");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Атака.Код, "пустой реф записи → 403, а не «любой реф»").Равно(403);
	Ожидаем.Что(ВерсияЕсть(Стенд, "1.1.0"), "версии нет").ЭтоЛожь();

	// КОНТРОЛЬ: та же запись с заполненным рефом публикует — отличие ровно одно
	ЗаписатьДовериеМимоСервиса(Стенд.Пакет, Фикстура["реф"]);
	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("годный")).Код,
		"КОНТРОЛЬ: реф на месте — публикует").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область КороткаяФорма

// Форма спрашивает имя файла и имя ветки, а в записи живёт то, что приезжает в клеймах.
&Тест
Процедура КороткиеЗначенияДостраиваютсяДоКлеймов() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Ожидаем.Что(Короткая.Конвейер("github", ИздательGitHubТест(), "acme/lib", "e2e.yml"),
		"у GitHub каталог всегда .github/workflows").Равно("acme/lib/.github/workflows/e2e.yml");
	Ожидаем.Что(Короткая.Реф("develop"), "короткая ветка").Равно("refs/heads/develop");
	Ожидаем.Что(Короткая.Реф("v1.2.3", Истина), "короткий тег").Равно("refs/tags/v1.2.3");

	// значение с refs/ принимается как есть, вид рефа его не трогает
	Ожидаем.Что(Короткая.Реф("refs/tags/v1.2.3"), "полный реф").Равно("refs/tags/v1.2.3");
	Ожидаем.Что(Короткая.Реф("refs/tags/v1.2.3", Ложь),
		"полный реф не переписывается видом").Равно("refs/tags/v1.2.3");

	// приставка сверяется РЕГИСТРОЗАВИСИМО, как и сам клейм: «REFS/» рефом не является,
	// и пропустить его значило бы завести запись, которая не совпадёт никогда
	Ожидаем.Что(Короткая.Реф("REFS/heads/main"),
		"REFS/ — не приставка рефа, значение достраивается веткой")
		.Равно("refs/heads/REFS/heads/main");

	// маска достраивается так же, как имя, — кроме «**»: приставка не расширила бы её,
	// а сузила до одного пространства имён
	Ожидаем.Что(Короткая.Реф("v*", Истина), "маска тега").Равно("refs/tags/v*");
	Ожидаем.Что(Короткая.Реф("release/*"), "маска ветки").Равно("refs/heads/release/*");
	Ожидаем.Что(Короткая.Реф("**"), "«всё» остаётся «всем»").Равно("**");
	Ожидаем.Что(Короткая.Реф("**", Истина), "и вид рефа его не трогает").Равно("**");

	// пусто остаётся пустым: достройка не вправе назначать значение, а обязательность
	// поля держит сервис
	Ожидаем.Что(Короткая.Реф(""), "пустой реф").Равно("");
	Ожидаем.Что(Короткая.Конвейер("github", ИздательGitHubТест(), "acme/lib", ""),
		"пустой конвейер").Равно("");

	// косая черта у GitHub означает уже полный путь: так вводится workflow чужого репозитория
	Ожидаем.Что(Короткая.Конвейер("github", ИздательGitHubТест(), "acme/lib",
			"octo/shared/.github/workflows/publish.yml"),
		"полная форма проходит без изменений").Равно("octo/shared/.github/workflows/publish.yml");

КонецПроцедуры

// У GitLab клейм несёт хост и разделитель «//», а путь к конфигу задаёт настройка проекта.
&Тест
Процедура КонвейерGitLabСобираетсяСХостомИРазделителем() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Ожидаем.Что(Короткая.Конвейер("gitlab", "https://gitlab.com", "acme/team/lib", ".gitlab-ci.yml"),
		"хост из издателя, проект, «//», путь").Равно("gitlab.com/acme/team/lib//.gitlab-ci.yml");
	Ожидаем.Что(Короткая.Конвейер("gitlab", "https://gitlab.example.test", "acme/lib", "my/path/.ci.yml"),
		"вложенный путь у GitLab — обычное значение, а не готовый клейм")
		.Равно("gitlab.example.test/acme/lib//my/path/.ci.yml");
	Ожидаем.Что(Короткая.Конвейер("gitlab", "https://gitlab.com", "acme/lib",
			"gitlab.com/acme/lib//.gitlab-ci.yml"),
		"готовое значение с «//» не переписывается").Равно("gitlab.com/acme/lib//.gitlab-ci.yml");

КонецПроцедуры

&Тест
Процедура СсылкаGitHubРазбираетсяВПоляФормы() Экспорт

	Разбор = Желудь("КороткаяФормаДоверия").РазобратьСсылку(
		"https://github.com/vanessa-opensource/vanessa-runner/blob/develop/.github/workflows/e2e.yml");

	Ожидаем.Что(Разбор.Успех, "ссылка разобрана").ЭтоИстина();
	Ожидаем.Что(Разбор.Провайдер, "тип репозитория").Равно("github");
	Ожидаем.Что(Разбор.Репозиторий, "репозиторий").Равно("vanessa-opensource/vanessa-runner");
	Ожидаем.Что(Разбор.Реф, "ветка").Равно("develop");
	Ожидаем.Что(Разбор.Конвейер, "путь файла").Равно(".github/workflows/e2e.yml");
	Ожидаем.Что(Желудь("КороткаяФормаДоверия").ЗначениеДляФормы("github", Разбор.Конвейер),
		"в форму уезжает имя файла: каталог у GitHub один").Равно("e2e.yml");

КонецПроцедуры

// Тег из ссылки неотличим от ветки — разбор кладёт значение как есть, вид рефа выбирает
// человек. Проверяем, что тег доезжает до поля, а не теряется.
&Тест
Процедура СсылкаНаТегРазбираетсяКакРеф() Экспорт

	Разбор = Желудь("КороткаяФормаДоверия").РазобратьСсылку(
		"https://github.com/acme/lib/blob/v1.2.0/.github/workflows/release.yml");

	Ожидаем.Что(Разбор.Успех, "ссылка разобрана").ЭтоИстина();
	Ожидаем.Что(Разбор.Реф, "координата попала в реф как есть").Равно("v1.2.0");

КонецПроцедуры

// Аудиторию спрашивают двое — сверка клеймов и готовый конвейер на экране, — и правило
// у них ОДНО. Копия этого условия в витрине разошлась бы с оригиналом, и хаб отдавал бы
// пайплайн, который сам же и отвергнет.
&Тест
Процедура ОжидаемаяАудиторияСледуетНастройкеИОткатываетсяНаАдресИнстанса() Экспорт

	Настройки = Желудь("СервисНастроек");
	Прежняя = Фикстура["аудитория"];

	Настройки.Установить("oshub.instance.url", "https://hub.example.test", "тест");
	Попытка

		ЗадатьАудиторию("openhub-prod");
		Ожидаем.Что(Доверие().ОжидаемаяАудитория(), "настройка сильнее адреса инстанса")
			.Равно("openhub-prod");

		// пустая настройка — откат на адрес инсталляции, так написано и в её подсказке
		ЗадатьАудиторию("");
		Ожидаем.Что(Доверие().ОжидаемаяАудитория(), "без настройки — URL инстанса")
			.Равно("https://hub.example.test");

	Исключение
		Настройки.Сбросить("oshub.instance.url", "тест");
		ЗадатьАудиторию(Прежняя);
		ВызватьИсключение;
	КонецПопытки;

	Настройки.Сбросить("oshub.instance.url", "тест");
	ЗадатьАудиторию(Прежняя);

КонецПроцедуры

// Та же функция решает и судьбу токена: аудитория из настройки публикует, адрес
// инсталляции при заданной настройке — нет.
&Тест
Процедура ТокенСверяетсяСТойЖеАудиториейЧтоОтдаётсяВСниппет() Экспорт

	Стенд = ЗавестиСтенд("ciaudsnip");
	Прежняя = Фикстура["аудитория"];

	Ожидаем.Что(Доверие().ОжидаемаяАудитория(), "хаб ждёт аудиторию фикстуры")
		.Равно(Желудь("СтражИздателейCI").Нормализовать(Прежняя));

	ЗадатьАудиторию("openhub-другая");
	Попытка
		Ожидаем.Что(Доверие().ОжидаемаяАудитория(), "аудитория сменилась")
			.Равно("openhub-другая");
		Отказ = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
		Ожидаем.Что(Отказ.Код, "токен на прежнюю аудиторию больше не публикует").Равно(403);
		Ожидаем.Что(Отказ.ТелоТекст, "причина названа").Содержит("aud");
	Исключение
		ЗадатьАудиторию(Прежняя);
		ВызватьИсключение;
	КонецПопытки;
	ЗадатьАудиторию(Прежняя);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: с прежней аудиторией публикует").Равно(201);

КонецПроцедуры

// Разбор ссылки и сборка адреса — две стороны одного знания: что разобрано в запись,
// то из записи и собирается обратно. Владелец пакета видит в списке ту же ссылку,
// которой он это доверие завёл.
&Тест
Процедура АдресЗаписиСобираетсяВТуЖеСсылкуЧтоБылаРазобрана() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Для Каждого Ссылка Из СсылкиДляКругаРазбора() Цикл

		Разбор = Короткая.РазобратьСсылку(Ссылка);
		Ожидаем.Что(Разбор.Успех, "ссылка разобрана: " + Ссылка).ЭтоИстина();

		// в записи живёт КАНОНИЧЕСКАЯ форма — ровно то, что пишет сервис доверия
		Конвейер = Короткая.Конвейер(Разбор.Провайдер, Разбор.Издатель, Разбор.Репозиторий,
			Короткая.ЗначениеДляФормы(Разбор.Провайдер, Разбор.Конвейер));
		Адреса = Короткая.АдресаЗаписи(Разбор.Провайдер, Разбор.Издатель, Разбор.Репозиторий,
			Конвейер, Короткая.Реф(Разбор.Реф));

		Ожидаем.Что(Адреса.Конвейер, "круг разбор → запись → адрес сошёлся").Равно(Ссылка);

	КонецЦикла;

КонецПроцедуры

// Издатель GitHub Actions репозиториями не владеет: подстановка его хоста в адрес увела бы
// на несуществующий token.actions.githubusercontent.com/acme/lib.
&Тест
Процедура АдресРепозиторияGitHubИдётНаGithubComАНеНаИздателя() Экспорт

	Адреса = Желудь("КороткаяФормаДоверия").АдресаЗаписи("github", ИздательGitHubТест(),
		"acme/lib", "acme/lib/.github/workflows/e2e.yml", "refs/heads/main");

	Ожидаем.Что(Адреса.Репозиторий, "репозиторий на github.com")
		.Равно("https://github.com/acme/lib");
	Ожидаем.Что(Адреса.Конвейер, "файл конвейера там же")
		.Равно("https://github.com/acme/lib/blob/main/.github/workflows/e2e.yml");
	Ожидаем.Что(Адреса.Имя, "в списке показывается имя файла").Равно("e2e.yml");

КонецПроцедуры

// Reusable из ЧУЖОГО репозитория — вторая сторона одного правила: место файла отличается
// от репозитория записи, и в имени оно называется, а адрес ведёт туда, где файл лежит.
// Правило общее с GitLab, поэтому доказано быть обязано с ОБЕИХ сторон: краснота только
// у одной вернула бы дефект по второй оси незамеченным.
&Тест
Процедура ReusableИзЧужогоРепозиторияНазванВместеСНимИАдресуетсяТуда() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Своё = Короткая.АдресаЗаписи("github", ИздательGitHubТест(), "acme/lib",
		"acme/lib/.github/workflows/e2e.yml", "refs/heads/main");
	Чужое = Короткая.АдресаЗаписи("github", ИздательGitHubТест(), "acme/lib",
		"other/repo/.github/workflows/e2e.yml", "refs/heads/main");

	Ожидаем.Что(Своё.Имя, "свой workflow назван одним именем файла").Равно("e2e.yml");
	Ожидаем.Что(Чужое.Имя, "чужой — вместе со своим репозиторием").Равно("other/repo/e2e.yml");
	Ожидаем.Что(Чужое.Конвейер, "и адрес ведёт в тот репозиторий, где файл лежит")
		.Равно("https://github.com/other/repo/blob/main/.github/workflows/e2e.yml");

КонецПроцедуры

// Маска рефа совпадает со многими рефами: одного файла за ней нет, и выдумывать адрес
// нельзя — он открыл бы 404. Репозиторий при этом остаётся достижим.
&Тест
Процедура МаскаРефаАдресаФайлаНеДаёт() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Для Каждого Маска Из СтрРазделить("refs/heads/release/*,refs/tags/v*,**", ",") Цикл
		Адреса = Короткая.АдресаЗаписи("github", ИздательGitHubТест(), "acme/lib",
			"acme/lib/.github/workflows/e2e.yml", Маска);
		Ожидаем.Что(Адреса.Конвейер, "маска " + Маска + " адреса файла не даёт").Равно("");
		Ожидаем.Что(Адреса.Репозиторий, "но репозиторий достижим")
			.Равно("https://github.com/acme/lib");
	КонецЦикла;

	// КОНТРОЛЬ: та же запись с точным рефом адрес файла даёт
	Точная = Короткая.АдресаЗаписи("github", ИздательGitHubТест(), "acme/lib",
		"acme/lib/.github/workflows/e2e.yml", "refs/heads/main");
	Ожидаем.Что(Точная.Конвейер, "КОНТРОЛЬ: точный реф даёт адрес файла")
		.Равно("https://github.com/acme/lib/blob/main/.github/workflows/e2e.yml");

КонецПроцедуры

// Издатель self-hosted GitLab — это и есть адрес инсталляции, и хост репозитория берётся
// из него. Список издателей задаёт настройка хаба, поэтому тест её и ставит.
&Тест
Процедура АдресаSelfHostedБерутХостИзИздателя() Экспорт

	Настройки = Желудь("СервисНастроек");
	Настройки.Установить("oshub.publish.ci.issuers", "https://git.example.test", "тест");
	Попытка
		Адреса = Желудь("КороткаяФормаДоверия").АдресаЗаписи("gitlab",
			"https://git.example.test", "team/lib", "git.example.test/team/lib//.gitlab-ci.yml",
			"refs/heads/release");
		Ожидаем.Что(Адреса.Репозиторий, "репозиторий на своей инсталляции")
			.Равно("https://git.example.test/team/lib");
		Ожидаем.Что(Адреса.Конвейер, "файл конвейера через «/-/blob/»")
			.Равно("https://git.example.test/team/lib/-/blob/release/.gitlab-ci.yml");
	Исключение
		Настройки.Сбросить("oshub.publish.ci.issuers", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.publish.ci.issuers", "тест");

КонецПроцедуры

// Ссылку мейнтейнер копирует ИЗ БРАУЗЕРА, а браузер приносит её со своими хвостами
// и в процентном кодировании. Всё это — часть ссылки, а не имени файла и не имени ветки.
&Тест
Процедура ХвостыБраузераВЗаписьНеПопадают() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	СЗапросом = Короткая.РазобратьСсылку(
		"https://github.com/acme/lib/blob/main/.github/workflows/e2e.yml?plain=1");
	Ожидаем.Что(СЗапросом.Конвейер, "«?plain=1» — хвост браузера")
		.Равно(".github/workflows/e2e.yml");

	СЯкорем = Короткая.РазобратьСсылку(
		"https://github.com/acme/lib/blob/main/.github/workflows/e2e.yml#L10");
	Ожидаем.Что(СЯкорем.Конвейер, "«#L10» — место внутри страницы")
		.Равно(".github/workflows/e2e.yml");

	СЗапросомВРефе = Короткая.РазобратьСсылку(
		"https://github.com/acme/lib/blob/main?tab=readme");
	Ожидаем.Что(СЗапросомВРефе.Успех, "за рефом без файла записи нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПроцентноеКодированиеСсылкиРаскрывается() Экспорт

	Разбор = Желудь("КороткаяФормаДоверия").РазобратьСсылку(
		"https://github.com/acme/lib/blob/release%2F1.0/.github/workflows/e2e.yml");

	Ожидаем.Что(Разбор.Успех, "ветка с косой в имени — законная ветка").ЭтоИстина();
	Ожидаем.Что(Разбор.Реф, "«%2F» это косая внутри имени ветки, а не разделитель сегментов")
		.Равно("release/1.0");

КонецПроцедуры

// Ветка со слешем в имени — обычное дело («release/1.0»), и обратная ссылка обязана
// вести туда же, а не разваливаться на сегменты чужого смысла.
&Тест
Процедура ИмяВеткиУезжаетВАдресЗакодированным() Экспорт

	Адреса = Желудь("КороткаяФормаДоверия").АдресаЗаписи("github", ИздательGitHubТест(),
		"acme/lib", "acme/lib/.github/workflows/e2e.yml", "refs/heads/release 1.0");

	Ожидаем.Что(Адреса.Конвейер, "пробел в имени ветки в адресе закодирован")
		.Равно("https://github.com/acme/lib/blob/release%201.0/.github/workflows/e2e.yml");

КонецПроцедуры

// Инсталляция GitLab живёт и на адресе, а не только на имени: литерал IPv6 в ссылке
// это законный хост, и запись доверия обязана дать по нему обратный адрес.
&Тест
Процедура ЛитералIPv6ХостомБытьВправе() Экспорт

	Ожидаем.Что(Желудь("КороткаяФормаДоверия").АдресаЗаписи("gitlab",
		"https://[2001:db8::1]:8443", "group/project", "", "refs/heads/main").Репозиторий,
		"адрес инсталляции остаётся литералом ссылки")
		.Равно("https://[2001:db8::1]:8443/group/project");

КонецПроцедуры

// Адрес собирается из значений, которые ввёл мейнтейнер: негодные адреса не собираются
// вовсе, а не превращаются в ссылку куда попало.
&Тест
Процедура НегодныеЗначенияАдресаНеДают() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Чужая = Короткая.АдресаЗаписи("gitlab", "javascript:alert(1)", "acme/lib", "", "refs/heads/main");
	Ожидаем.Что(Чужая.Репозиторий, "издатель не по адресу — ссылки нет").Равно("");

	Выход = Короткая.АдресаЗаписи("github", ИздательGitHubТест(), "acme/../../etc/passwd",
		"", "refs/heads/main");
	Ожидаем.Что(Выход.Репозиторий, "выход из пути — ссылки нет").Равно("");

	Пробел = Короткая.АдресаЗаписи("github", ИздательGitHubТест(), "acme/li b",
		"", "refs/heads/main");
	Ожидаем.Что(Пробел.Репозиторий, "пробел в имени — ссылки нет").Равно("");

КонецПроцедуры

&Тест
Процедура СсылкаGitLabРазбираетсяВместеСПодгруппами() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Разбор = Короткая.РазобратьСсылку(
		"https://gitlab.com/group/subgroup/project/-/blob/main/ci/pipeline.yml");
	Ожидаем.Что(Разбор.Успех, "ссылка разобрана").ЭтоИстина();
	Ожидаем.Что(Разбор.Провайдер, "разделитель «-» опознаёт GitLab").Равно("gitlab");
	Ожидаем.Что(Разбор.Репозиторий, "подгруппы входят в путь проекта")
		.Равно("group/subgroup/project");
	Ожидаем.Что(Разбор.Реф, "ветка").Равно("main");
	Ожидаем.Что(Короткая.ЗначениеДляФормы("gitlab", Разбор.Конвейер),
		"у GitLab в форму уезжает весь путь").Равно("ci/pipeline.yml");

	// self-hosted: разбирается ТОЛЬКО когда хаб доверяет этому издателю
	Настройки = Желудь("СервисНастроек");
	Настройки.Установить("oshub.publish.ci.issuers", "https://git.example.test", "тест");
	Попытка
		Свой = Короткая.РазобратьСсылку(
			"https://git.example.test/team/lib/-/blob/release/.gitlab-ci.yml");
		Ожидаем.Что(Свой.Провайдер, "self-hosted GitLab разобран").Равно("gitlab");
		Ожидаем.Что(Свой.Издатель, "издателем стал хост ссылки, а не gitlab.com")
			.Равно("https://git.example.test");
		Ожидаем.Что(Свой.Репозиторий, "репозиторий").Равно("team/lib");
	Исключение
		Настройки.Сбросить("oshub.publish.ci.issuers", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.publish.ci.issuers", "тест");

КонецПроцедуры

// ЭКСПЛОЙТ: ссылка на инсталляцию, издателя которой хаб не знает. Догадка «раз не gitlab,
// значит github.com» перенацелила бы доверие на ПУБЛИЧНЫЙ github.com с тем же именем
// репозитория — и любой, кто занял бы это имя, публиковал бы в чужой пакет.
&Тест
Процедура СсылкаНаНеизвестнуюИнсталляциюНеРазбирается() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Корпоративный = Короткая.РазобратьСсылку(
		"https://github.acme.corp/team/lib/blob/main/.github/workflows/release.yml");
	Ожидаем.Что(Корпоративный.Успех, "чужая инсталляция не разбирается").ЭтоЛожь();
	Ожидаем.Что(Корпоративный.Провайдер, "и типа репозитория не выдумывает").Равно("");
	Ожидаем.Что(Корпоративный.Репозиторий, "и репозитория тоже").Равно("");

	Чужой = Короткая.РазобратьСсылку(
		"https://gitlab.acme.corp/team/lib/-/blob/main/.gitlab-ci.yml");
	Ожидаем.Что(Чужой.Успех,
		"и GitLab вне списка хаба — тоже: издателем стал бы gitlab.com").ЭтоЛожь();

	// КОНТРОЛЬ: та же форма ссылки на известной инсталляции разбирается
	Ожидаем.Что(Короткая.РазобратьСсылку(
			"https://github.com/team/lib/blob/main/.github/workflows/release.yml").Успех,
		"КОНТРОЛЬ: github.com разбирается").ЭтоИстина();

КонецПроцедуры

// Естественный ввод «.github/workflows/e2e.yml» достраивается, а путь, не похожий
// на workflow, отбивается с объяснением — а не заводит запись, которая не совпадёт никогда.
&Тест
Процедура ПутьВнеКаталогаWorkflowОтбивается() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Ожидаем.Что(Короткая.ПричинаОтказаКонвейера("github", ".github/workflows/e2e.yml"),
		"путь от корня репозитория принимается").Равно("");
	Ожидаем.Что(Короткая.Конвейер("github", ИздательGitHubТест(), "acme/lib",
			".github/workflows/e2e.yml"),
		"и достраивается приставкой репозитория").Равно("acme/lib/.github/workflows/e2e.yml");

	Ожидаем.Что(ЗначениеЗаполнено(Короткая.ПричинаОтказаКонвейера("github", "ci/build.yml")),
		"путь вне .github/workflows отбивается").ЭтоИстина();
	Ожидаем.Что(Короткая.ПричинаОтказаКонвейера("gitlab", "ci/build.yml"),
		"у GitLab такой путь законен: он задаётся настройкой проекта").Равно("");

	// и ЗАВЕДЕНИЕ обязано отказать, а не молча создать запись, которая не совпадёт никогда
	Стенд = Публикация.ЗаведённоеИмя("cipath");
	Мейнтейнер = Стенд.Мейнтейнер;
	Пакет = Стенд.Пакет;

	Кривой = Доверие().Доверить(СессияПринципал(Мейнтейнер), Пакет, "github",
		"", Фикстура["репозиторий"], "ci/build.yml", "main");
	Ожидаем.Что(Кривой.Успех, "запись с таким конвейером не создаётся").ЭтоЛожь();
	Ожидаем.Что(Кривой.Код, "и это 400 с объяснением").Равно(400);
	Ожидаем.Что(Доверие().КонвейерыПакета(Пакет).Количество(), "записей нет").Равно(0);

	Контроль = Доверие().Доверить(СессияПринципал(Мейнтейнер), Пакет, "github",
		"", Фикстура["репозиторий"], ".github/workflows/build.yml", "main");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: путь от корня репозитория принимается").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура МусорВСсылкеНичегоНеЗаполняет() Экспорт

	Короткая = Желудь("КороткаяФормаДоверия");

	Для Каждого Значение Из СтрРазделить("|не ссылка|https://github.com|"
		+ "https://github.com/acme/lib|ftp:/x|https://github.com/acme/lib/blob/main", "|") Цикл
		Разбор = Короткая.РазобратьСсылку(Значение);
		Ожидаем.Что(Разбор.Успех, "мусор не разбирается: «" + Значение + "»").ЭтоЛожь();
		Ожидаем.Что(Разбор.Репозиторий, "и полей не заполняет").Равно("");
	КонецЦикла;

КонецПроцедуры

Функция ИздательGitHubТест()
	Возврат "https://token.actions.githubusercontent.com";
КонецФункции

// Ссылки публичных инсталляций: их разбирает и собирает обратно один и тот же класс.
Функция СсылкиДляКругаРазбора()

	Результат = Новый Массив();
	Результат.Добавить("https://github.com/acme/lib/blob/main/.github/workflows/e2e.yml");
	Результат.Добавить("https://github.com/acme/lib/blob/v1.2.0/.github/workflows/release.yml");
	Результат.Добавить("https://gitlab.com/group/subgroup/project/-/blob/main/ci/pipeline.yml");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СверкаКлеймовWorkflow

// Клеймов про workflow у GitHub два, и сверяется ВЕРХНЕУРОВНЕВЫЙ — тот, что запустился
// в самом репозитории. Обычный запуск: оба клейма про один файл.
&Тест
Процедура ОбычныйЗапускПубликует() Экспорт

	Стенд = ЗавестиСтендКороткойФормой("ciplain", "release.yml", "main");

	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("годный")).Код,
		"запись, заведённая коротким именем файла и веткой, публикует").Равно(201);

КонецПроцедуры

// Reusable: верхнеуровневый workflow свой, а job определён в ЧУЖОМ репозитории. Доверие
// означает «публикация разрешена из вот этого файла в вот этом моём репозитории», поэтому
// клейм про чужой репозиторий сверке не мешает.
&Тест
Процедура ВызовReusableИзЧужогоРепозиторияПубликует() Экспорт

	Стенд = ЗавестиСтендКороткойФормой("cireuse", "release.yml", "main");

	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("reusable")).Код,
		"workflow своего репозитория публикует, даже вызвав чужой reusable").Равно(201);

КонецПроцедуры

// Меняется РОВНО один клейм — верхнеуровневый файл: так проверка файла нагружена,
// а не сравнивает значение сама с собой.
&Тест
Процедура ЧужойФайлWorkflowНеПубликует() Экспорт

	Стенд = ЗавестиСтендКороткойФормой("ciwf", "release.yml", "main");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужой_конвейер"));
	Ожидаем.Что(Атака.Код, "другой workflow того же репозитория → 403").Равно(403);

	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("годный")).Код,
		"КОНТРОЛЬ: доверенный файл публикует").Равно(201);

КонецПроцедуры

// GitLab СКВОЗЬ весь путь: свой издатель, project_path вместо repository и клейм
// ci_config_ref_uri формы «host/project//путь». Без этого теста канон GitLab держался бы
// юнит-утверждением о самом себе.
&Тест
Процедура GitLabПубликуетПоКонфигуПроекта() Экспорт

	Стенд = ЗавестиСтендGitLab("cigl", ".gitlab-ci.yml", "main");

	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("gitlab_годный")).Код,
		"запись, заведённая коротким путём конфига, публикует").Равно(201);

КонецПроцедуры

&Тест
Процедура GitLabСЧужимКонфигомНеПубликует() Экспорт

	Стенд = ЗавестиСтендGitLab("ciglbad", ".gitlab-ci.yml", "main");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("gitlab_чужой_конфиг"));
	Ожидаем.Что(Атака.Код, "другой путь конфига того же проекта → 403").Равно(403);

	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("gitlab_годный")).Код,
		"КОНТРОЛЬ: доверенный путь публикует").Равно(201);

КонецПроцедуры

// Издатель вне списка хаба: за ключами по такому адресу не ходят вовсе. Транспорт при этом
// ГОТОВ отдать по нему годный JWKS — отличие от контроля ровно в списке, а не в доступности.
&Тест
Процедура ИздательВнеСпискаНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("ciiss");
	Транспорт = Желудь("ТранспортHTTP");
	Проверяющий = Желудь("ПроверяющийПодписиCI");
	ДоЗапросов = Транспорт.Запросов(АдресДискавери("https://evil.example.test"));

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужой_издатель"));
	Ожидаем.Что(Атака.Код, "издатель вне списка → 403").Равно(403);
	Ожидаем.Что(Проверяющий.ПроверитьТокен(Токен("чужой_издатель"), "https://evil.example.test").Достоверна,
		"подпись верна, но издателя нет в списке — не достоверна").ЭтоЛожь();
	Ожидаем.Что(Транспорт.Запросов(АдресДискавери("https://evil.example.test")) - ДоЗапросов,
		"за ключами по такому адресу хаб не ходил").Равно(0);

	Ожидаем.Что(Проверяющий.ПроверитьТокен(Токен("издатель_gitlab"), "https://gitlab.com").Достоверна,
		"КОНТРОЛЬ: издатель из списка — та же подпись достоверна").ЭтоИстина();
	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: издатель записи публикует").Равно(201);

КонецПроцедуры

// Издатель из списка хаба, но НЕ ТОТ, что в записи доверия: подпись верна, а права нет.
&Тест
Процедура ДругойРазрешённыйИздательНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("cigitlab");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("издатель_gitlab"));
	Ожидаем.Что(Атака.Код, "подпись верна, но издатель не тот, что в записи → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: издатель записи публикует").Равно(201);

КонецПроцедуры

// У пакета доверены конвейеры И GitHub, И GitLab. Ключи берутся у каждого издателя записей,
// поэтому конвейер второго публикует наравне с первым — иначе доверие второму молча мертво.
&Тест
Процедура ВторойИздательПакетаТожеПубликует() Экспорт

	Стенд = ЗавестиСтенд("cidual");
	ДобавитьДовериеGitLab(Стенд, ".gitlab-ci.yml", "main");

	Ответ = ПушТокеном(Стенд, "1.1.0", Токен("gitlab_годный"));
	Ожидаем.Что(Ответ.Код, "конвейер второго издателя публикует: " + Ответ.ТелоТекст).Равно(201);
	Ожидаем.Что(ВерсияЕсть(Стенд, "1.1.0"), "версия опубликована").ЭтоИстина();

	Чужой = ПушТокеном(Стенд, "1.2.0", Токен("чужой_издатель"));
	Ожидаем.Что(Чужой.Код, "КОНТРОЛЬ: издателя вне записей пакета второе доверие не открыло")
		.Равно(403);

КонецПроцедуры

#КонецОбласти

#Область СписокИздателейИSSRF

// Издателя вне списка хаба запись доверия не принимает вовсе — default-closed.
&Тест
Процедура ЗаписьДоверияНеПринимаетИздателяВнеСписка() Экспорт

	Стенд = ЗавестиСтенд("cilist");

	Атака = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		"https://evil.example.test", Фикстура["репозиторий"], "", "main");
	Ожидаем.Что(Атака.Успех, "чужой издатель не принят").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "отказ формы → 400").Равно(400);
	Ожидаем.Что(Атака.Сообщение, "названа причина").Содержит("не в списке доверенных");

	Контроль = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		"https://gitlab.com", Фикстура["репозиторий"], "", "main");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: встроенный издатель принят").ЭтоИстина();

КонецПроцедуры

// Настройка self-hosted не открывает дорогу в интранет и к сервису метаданных облака.
&Тест
Процедура ПриватныйИздательИзНастройкиНеПринимается() Экспорт

	Стенд = ЗавестиСтенд("cissrf");
	Настройки = Желудь("СервисНастроек");
	Отказы = Новый Массив();

	Попытка
		Для Каждого Адрес Из СтрРазделить(
			"https://169.254.169.254,https://127.0.0.1,https://192.168.10.5,https://10.1.2.3", ",") Цикл
			Настройки.Установить("oshub.publish.ci.issuers", Адрес, "тест");
			Итог = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "gitlab",
				Адрес, Фикстура["репозиторий"], "", "main");
			Если НЕ Итог.Успех Тогда
				Отказы.Добавить(Адрес);
			КонецЕсли;
		КонецЦикла;

		// КОНТРОЛЬ: тот же путь настройки с публичным адресом запись создаёт
		Настройки.Установить("oshub.publish.ci.issuers", "https://93.184.216.34", "тест");
		Контроль = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "gitlab",
			"https://93.184.216.34", Фикстура["репозиторий"], "", "main");
	Исключение
		Настройки.Сбросить("oshub.publish.ci.issuers", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.publish.ci.issuers", "тест");

	Ожидаем.Что(Отказы.Количество(), "все четыре приватные формы отбиты").Равно(4);
	Ожидаем.Что(Контроль.Успех,
		"КОНТРОЛЬ: публичный self-hosted издатель принимается: " + Контроль.Сообщение).ЭтоИстина();

КонецПроцедуры

// Издатель по http не принимается, даже будучи в списке: ключи по открытому каналу не читаем.
&Тест
Процедура ИздательБезHTTPSНеПринимается() Экспорт

	Стенд = ЗавестиСтенд("cischeme");
	Настройки = Желудь("СервисНастроек");

	Попытка
		Настройки.Установить("oshub.publish.ci.issuers", "http://gitlab.example.test", "тест");
		Атака = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "gitlab",
			"http://gitlab.example.test", Фикстура["репозиторий"], "", "main");

		Настройки.Установить("oshub.publish.ci.issuers", "https://gitlab.example.test", "тест");
		Контроль = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "gitlab",
			"https://gitlab.example.test", Фикстура["репозиторий"], "", "main");
	Исключение
		Настройки.Сбросить("oshub.publish.ci.issuers", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.publish.ci.issuers", "тест");

	Ожидаем.Что(Атака.Успех, "издатель по http не принят").ЭтоЛожь();
	Ожидаем.Что(Атака.Сообщение, "названа причина").Содержит("https");
	Ожидаем.Что(Контроль.Успех, "КОНТРОЛЬ: тот же хост по https принят").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ТранспортКлючей

// Конец цепочки перенаправлений не проверяет никто, поэтому по ней не идём вовсе.
&Тест
Процедура ТранспортКлючейНеИдётПоПеренаправлению() Экспорт

	Клиент = Новый ФейкТранспортHTTPПоАдресам();
	Клиент.ПриАдресе("https://gitlab.com/keys", 302, "");
	Транспорт = Новый ТранспортJWKSХаба(Клиент, Желудь("СтражИздателейCI"), ЛогТестов());

	Ожидаем.Что(ОшибкаЗапроса(Транспорт, "https://gitlab.com/keys"),
		"перенаправление — отказ").Содержит("перенаправлением");
	Ожидаем.Что(Клиент.РедиректыРазрешалисьХотяБыРаз(),
		"по Location транспорт ходить не просил").ЭтоЛожь();

	Клиент.ПриАдресе("https://gitlab.com/keys", 200, "{""keys"":[]}");
	Ожидаем.Что(Транспорт.Получить("https://gitlab.com/keys").Тело,
		"КОНТРОЛЬ: тот же адрес с кодом 200 читается").Равно("{""keys"":[]}");

КонецПроцедуры

// Имя заголовка регистронезависимо: вызывающий, приславший «accept», просит того же
// самого, и второй Accept с другим значением уехал бы к серверу ключей вместе с первым.
&Тест
Процедура ТранспортКлючейНеДублируетAcceptВызывающего() Экспорт

	Клиент = Новый ФейкТранспортHTTPПоАдресам();
	Клиент.ПриАдресе("https://gitlab.com/keys", 200, "{""keys"":[]}");
	Транспорт = Новый ТранспортJWKSХаба(Клиент, Желудь("СтражИздателейCI"), ЛогТестов());

	Свои = Новый Соответствие();
	Свои.Вставить("accept", "application/jwk-set+json");
	Транспорт.Получить("https://gitlab.com/keys", Свои);

	Ушедшие = Клиент.ЗаголовкиПоследнегоЗапроса();
	Ожидаем.Что(Ушедшие.Количество(), "заголовок Accept ровно один: " + СтрокаЗаголовков(Ушедшие))
		.Равно(1);
	Ожидаем.Что(Ушедшие.Получить("accept"), "и это значение вызывающего")
		.Равно("application/jwk-set+json");

	Транспорт.Получить("https://gitlab.com/keys");
	Ожидаем.Что(Клиент.ЗаголовкиПоследнегоЗапроса().Получить("Accept"),
		"КОНТРОЛЬ: без своего заголовка транспорт ставит собственный").Равно("application/json");

КонецПроцедуры

// jwks_uri называет чужой документ discovery — значит судить его обязан транспорт.
&Тест
Процедура ТранспортКлючейНеХодитПоПриватномуJwksUri() Экспорт

	Клиент = Новый ФейкТранспортHTTPПоАдресам();
	Клиент.ПриАдресе("https://169.254.169.254/keys", 200, "{""keys"":[]}");
	Клиент.ПриАдресе("http://gitlab.com/keys", 200, "{""keys"":[]}");
	Клиент.ПриАдресе("https://gitlab.com/keys", 200, "{""keys"":[]}");
	Транспорт = Новый ТранспортJWKSХаба(Клиент, Желудь("СтражИздателейCI"), ЛогТестов());

	Ожидаем.Что(ОшибкаЗапроса(Транспорт, "https://169.254.169.254/keys"),
		"link-local отбит").Содержит("недопустим");
	Ожидаем.Что(ОшибкаЗапроса(Транспорт, "http://gitlab.com/keys"),
		"http отбит").Содержит("недопустим");
	Ожидаем.Что(Клиент.ВсегоЗапросов(), "до сети такие адреса не доходят").Равно(0);

	Ожидаем.Что(Транспорт.Получить("https://gitlab.com/keys").Код,
		"КОНТРОЛЬ: допустимый адрес читается").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область КэшКлючей

// Кэш ключей — один на процесс: иначе каждый push тянул бы JWKS заново.
&Тест
Процедура КлючиЧитаютсяОдинРазНаПроцесс() Экспорт

	Стенд = ЗавестиСтенд("cicache");
	Транспорт = Желудь("ТранспортHTTP");

	// первый push мог случиться в соседнем тесте — считаем ПРИРОСТ
	ДоДискавери = Транспорт.Запросов(Фикстура["адрес_дискавери"]);
	ДоКлючей = Транспорт.Запросов(Фикстура["адрес_ключей"]);

	Для Счёт = 1 По 3 Цикл
		Версия = "1." + Формат(Счёт, "ЧГ=0; ЧН=0") + ".0";
		Ответ = ПушТокеном(Стенд, Версия, Токен("годный"));
		Ожидаем.Что(Ответ.Код, "push " + Версия + ": " + Ответ.ТелоТекст).Равно(201);
	КонецЦикла;

	Ожидаем.Что(Транспорт.Запросов(Фикстура["адрес_дискавери"]) - ДоДискавери,
		"три push — ни одного лишнего discovery").Равно(0);
	Ожидаем.Что(Транспорт.Запросов(Фикстура["адрес_ключей"]) - ДоКлючей,
		"три push — ни одного лишнего чтения JWKS").Равно(0);

КонецПроцедуры

// Ключи выбирают по iss из НЕПРОВЕРЕННОЙ нагрузки, поэтому после проверки iss сверяется
// ещё раз — по подписанной. Расхождение двух разборов одного токена = подмена издателя.
&Тест
Процедура ПодписанныйIssСверяетсяСВладельцемКлючей() Экспорт

	Проверяющий = Желудь("ПроверяющийПодписиCI");

	Ожидаем.Что(Проверяющий.ПроверитьТокен(Токен("издатель_gitlab"), Фикстура["издатель"]).Достоверна,
		"токен gitlab, проверенный ключами GitHub, не достоверен").ЭтоЛожь();
	Ожидаем.Что(Проверяющий.ПроверитьТокен(Токен("издатель_gitlab"), "https://gitlab.com").Достоверна,
		"КОНТРОЛЬ: тот же токен у своего издателя достоверен").ЭтоИстина();

КонецПроцедуры

// Клеймы, по которым принимается решение, приходят ПРОВЕРЕННЫМИ вместе с подписью, а не
// из второго разбора того же токена вызывающим.
&Тест
Процедура ПроверенныеКлеймыОтдаютсяТолькоСПодписью() Экспорт

	Проверяющий = Желудь("ПроверяющийПодписиCI");

	Годная = Проверяющий.ПроверитьТокен(Токен("годный"), Фикстура["издатель"]);
	Ожидаем.Что(Годная.Достоверна, "подпись подтверждена").ЭтоИстина();
	Ожидаем.Что(Годная.Клеймы.Получить("repository"),
		"клеймы отданы вызывающему").Равно(Фикстура["репозиторий"]);

	Плохая = Проверяющий.ПроверитьТокен(Токен("чужая_подпись"), Фикстура["издатель"]);
	Ожидаем.Что(Плохая.Достоверна, "чужая подпись не подтверждена").ЭтоЛожь();
	Ожидаем.Что(Плохая.Клеймы = Неопределено,
		"и непроверенная нагрузка наружу не отдана").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Плохая.Причина), "причина названа").ЭтоИстина();

КонецПроцедуры

// Fail-closed на недоступном JWKS: без ключей подпись недостоверна.
// Отличие от контроля ровно одно — источник ключей, у которого ответов нет.
&Тест
Процедура НедоступныйJWKSНеОткрываетПубликацию() Экспорт

	Пустой = Новый ПроверяющийПодписиJWKS(Желудь("СтражИздателейCI"),
		Новый КэшиКлючейCI(Новый ФейкТранспортHTTPПоАдресам()), ЛогТестов());

	Проверка = Пустой.ПроверитьТокен(Токен("годный"), Фикстура["издатель"]);
	Ожидаем.Что(Проверка.Достоверна, "JWKS недоступен → подпись недостоверна").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Проверка.Причина, "не собрана"),
		"зависимости на месте, значит отказ не по «не собрано»").Равно(0);

	Ожидаем.Что(Желудь("ПроверяющийПодписиCI").ПроверитьТокен(
			Токен("годный"), Фикстура["издатель"]).Достоверна,
		"КОНТРОЛЬ: тот же токен с доступным JWKS достоверен").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ГраницыДомена

// Адрес судится ПЕРЕД КАЖДЫМ запросом: имя, ставшее приватным, обязано закрыть путь
// немедленно. Кэш вердикта превращал бы проверку «перед запросом» в «когда-то раньше».
&Тест
Процедура АдресСудитсяПередКаждымЗапросом() Экспорт

	Судья = Новый ФейкВалидатораАдресаCI();
	Страж = Новый СтражИздателейCI(Судья, Желудь("СвояСеть"), Неопределено, ЛогТестов());

	Ожидаем.Что(Страж.ДопустимАдрес("https://gitlab.com/keys").Успех,
		"публичный адрес разрешён").ЭтоИстина();

	Судья.Отвечать(Ложь, "хост резолвится в приватный адрес");
	Ожидаем.Что(Страж.ДопустимАдрес("https://gitlab.com/keys").Успех,
		"тот же адрес стал приватным — отказ немедленно, а не после TTL").ЭтоЛожь();
	Ожидаем.Что(Судья.Вызовов(), "судью спросили оба раза").Равно(2);

КонецПроцедуры

// Схему судит и дешёвая ветка: издателя по http не спасает даже присутствие в списке —
// иначе на горячем пути ключи читались бы по открытому каналу. Отличие от контроля — схема.
&Тест
Процедура ИздательПоHTTPНеПроходитДажеБудучиВСписке() Экспорт

	Настройки = Желудь("СервисНастроек");
	Страж = Желудь("СтражИздателейCI");

	Попытка
		Настройки.Установить("oshub.publish.ci.issuers",
			"http://gitlab.example.test,https://gitlab.example.test", "тест");
		ПоHTTP = Страж.ДопустимИздатель("http://gitlab.example.test");
		ПоHTTPS = Страж.ДопустимИздатель("https://gitlab.example.test");
	Исключение
		Настройки.Сбросить("oshub.publish.ci.issuers", "тест");
		ВызватьИсключение;
	КонецПопытки;
	Настройки.Сбросить("oshub.publish.ci.issuers", "тест");

	Ожидаем.Что(ПоHTTP.Успех, "издатель по http не принимается и списком").ЭтоЛожь();
	Ожидаем.Что(ПоHTTP.Сообщение, "названа причина").Содержит("https");
	Ожидаем.Что(ПоHTTPS.Успех, "КОНТРОЛЬ: тот же хост по https принимается").ЭтоИстина();

КонецПроцедуры

// У-22: путь доверенных конвейеров имён НЕ резолвит — ни при заведении записи, ни на
// холодном кэше, ни на тёплом. Резолв стоит подпроцесса, а гарантии не даёт: соединяется
// процесс по адресу, который резолвит ОС, и между двумя резолвами ответ успевает измениться.
&Тест
Процедура ПутьКонвейеровНеОбращаетсяКРазрешителюИмён() Экспорт

	Шпион = Желудь("РазрешительImён");
	Стенд = Публикация.ЗаведённоеИмя("dnspkg");
	Мейнтейнер = Стенд.Мейнтейнер;
	Пакет = Стенд.Пакет;

	Шпион.Забыть();

	Доверие_ = Доверие().Доверить(СессияПринципал(Мейнтейнер), Пакет, "github",
		Фикстура["издатель"], Фикстура["репозиторий"], Фикстура["конвейер"], Фикстура["реф"]);
	Ожидаем.Что(Доверие_.Успех, "запись доверия заведена: " + Доверие_.Сообщение).ЭтоИстина();
	Ожидаем.Что(Шпион.Обращений(),
		"заведение записи доверия имён не резолвит: " + Шпион.Имена()).Равно(0);

	// холодный кэш: за ключами идут наружу — и всё равно без резолва
	Свой = Новый ФейкТранспортHTTPПоАдресам();
	ОтдаватьКлючи(Свой, Фикстура["издатель"]);
	Проверяющий = Новый ПроверяющийПодписиJWKS(Желудь("СтражИздателейCI"),
		Новый КэшиКлючейCI(Новый ТранспортJWKSХаба(Свой, Желудь("СтражИздателейCI"), ЛогТестов())),
		ЛогТестов());
	Ожидаем.Что(Проверяющий.ПроверитьТокен(Токен("годный"), Фикстура["издатель"]).Достоверна,
		"холодный кэш: ключи прочитаны").ЭтоИстина();
	Ожидаем.Что(Шпион.Обращений(),
		"поход за ключами имён не резолвит: " + Шпион.Имена()).Равно(0);

	// и публикация целиком, тёплым кэшем, через реальный маршрут push
	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("годный")).Код, "версия опубликована").Равно(201);
	Ожидаем.Что(Шпион.Обращений(),
		"публикация доверенным конвейером имён не резолвит: " + Шпион.Имена()).Равно(0);

	// КОНТРОЛЬ: шпион жив и считает — судейство ИМЕНИ его спрашивает.
	// Адрес источника имён больше не резолвит вовсе, поэтому контроль спрашивает политику напрямую.
	Желудь("СвояСеть").ВердиктСРезолвом("gitlab.example.test");
	Ожидаем.Что(Шпион.Обращений() > 0,
		"КОНТРОЛЬ: полное судейство имени разрешитель спрашивает").ЭтоИстина();

КонецПроцедуры

// Срок жизни токена хаб проверяет САМ, все три её части: контейнер с проверяющим, который
// срока не смотрит, обязан отбить истёкший токен, токен без exp и токен с nbf в будущем.
// Отличие каждого от контроля ровно одно — клеймо срока.
&Тест
Процедура ХабДержитСрокСамПриПроверяющемБезСрока() Экспорт

	Стенд = ЗавестиСтенд("cisrok");
	Фейк = Новый ФейкПроверяющийПодписиCI();
	Фейк.Разрешить();
	Доверие_ = ДовериеСПроверяющим(Фейк);

	Истёкший = Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("истёкший"));
	Ожидаем.Что(Истёкший.Разрешено, "истёкший токен не публикует").ЭтоЛожь();
	Ожидаем.Что(Истёкший.Причина, "названа причина").Содержит("истёк");

	БезСрока = Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("без_срока"));
	Ожидаем.Что(БезСрока.Разрешено,
		"токен без exp — долгоживущий ключ, ровно то, от чего уходим").ЭтоЛожь();
	Ожидаем.Что(БезСрока.Причина, "названа причина").Содержит("exp");

	Ранний = Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("срок_ещё_не_начался"));
	Ожидаем.Что(Ранний.Разрешено, "токен с nbf в будущем не публикует").ЭтоЛожь();
	Ожидаем.Что(Ранний.Причина, "названа причина").Содержит("nbf");

	Ожидаем.Что(Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено,
		"КОНТРОЛЬ: тот же путь с живым сроком разрешает").ЭтоИстина();

КонецПроцедуры

// ДОПУСК на расхождение часов меряется МИНУТАМИ. Имя функции однажды говорило о часах,
// а значение стояло в секундах; после переименования величину не держало ничто — суточный
// допуск оставлял набор зелёным, а вчерашний токен публиковал бы.
&Тест
Процедура ДопускРасхожденияЧасовМеряетсяМинутами() Экспорт

	Срок = Желудь("СрокТокенаCI");
	Сейчас = ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1);

	// граница «истекает ровно сейчас»: допуск на расхождение часов её ещё покрывает
	Ожидаем.Что(Срок.ПричинаОтказа(КлеймыСрока(Сейчас, 0)),
		"токен, истекающий ровно сейчас, принимается допуском").Равно("");
	Ожидаем.Что(Срок.ПричинаОтказа(КлеймыСрока(Сейчас - 30, 0)),
		"истёкший полминуты назад — тоже").Равно("");

	// а вот эти три — уже нет: допуск в минутах, а не в часах и не в сутках
	Просрочки = Новый Массив();
	Для Каждого Отступ Из СтрРазделить("600,3600,86400", ",") Цикл
		Причина = Срок.ПричинаОтказа(КлеймыСрока(Сейчас - Число(Отступ), 0));
		Если СтрНайти(Причина, "истёк") > 0 Тогда
			Просрочки.Добавить(Отступ);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Просрочки, ", "),
		"истёкшие 10 минут, час и сутки назад отбиты").Равно("600, 3600, 86400");

	// вторая сторона того же допуска: nbf в будущем дальше минут
	Ожидаем.Что(Срок.ПричинаОтказа(КлеймыСрока(Сейчас + 3600, Сейчас + 30)),
		"nbf на полминуты вперёд — в пределах допуска").Равно("");
	Ожидаем.Что(Срок.ПричинаОтказа(КлеймыСрока(Сейчас + 3600, Сейчас + 600)),
		"а на десять минут — нет").Содержит("nbf");

КонецПроцедуры

// Без стража издателей доверие закрыто целиком: канонизация отдаёт пустую строку, и
// сверять становится нечего. Отличие от контроля ровно одно — собранный страж.
&Тест
Процедура БезСтражаИздателейДовериеЗакрыто() Экспорт

	Стенд = ЗавестиСтенд("cinoguard");
	Фейк = Новый ФейкПроверяющийПодписиCI();
	Фейк.Разрешить();

	Безстражный = Новый СервисДоверияCI(Желудь("ХранилищеДоверияCI"),
		Желудь("ХранилищеПользователей"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Желудь("СервисПакетов"),
		Желудь("СервисПрав"), Фейк, Желудь("ДопускПринципала"), Желудь("ИздательСобытий"),
		Желудь("АудиторияТокенаCI"), Неопределено, Желудь("КороткаяФормаДоверия"),
		Желудь("ИмяЗаписиДоверия"), Желудь("МаскаРефа"), Желудь("ВидРефаДоверия"),
		Желудь("СрокТокенаCI"), ЛогТестов());

	Ожидаем.Что(Безстражный.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено,
		"без стража издателей публикации нет").ЭтоЛожь();
	Ожидаем.Что(ДовериеСПроверяющим(Фейк).РазрешаетПубликацию(
			Стенд.Пакет, Токен("годный")).Разрешено,
		"КОНТРОЛЬ: тот же вызов с собранным стражем разрешает").ЭтоИстина();

КонецПроцедуры

// Предел размера документа ключей срабатывает ДО материализации тела в строку.
&Тест
Процедура ТранспортОтсекаетСлишкомБольшойДокументКлючей() Экспорт

	Клиент = Новый ФейкТранспортHTTPПоАдресам();
	Клиент.ПриАдресе("https://gitlab.com/keys", 200, Повторить("к", 262145));
	Транспорт = Новый ТранспортJWKSХаба(Клиент, Желудь("СтражИздателейCI"), ЛогТестов());

	Ожидаем.Что(ОшибкаЗапроса(Транспорт, "https://gitlab.com/keys"),
		"документ сверх предела не принимается").Содержит("больше допустимых");

	Клиент.ПриАдресе("https://gitlab.com/keys", 200, "{""keys"":[]}");
	Ожидаем.Что(Транспорт.Получить("https://gitlab.com/keys").Код,
		"КОНТРОЛЬ: документ в пределах читается").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область ЗначокДоверия

// ИСТ-ПУБЛ-020: признак «приехало доверенной публикацией» берётся из ТОГО, КАК версия
// принята. Публикует один и тот же человек-мейнтейнер и один и тот же конвейер в один
// и тот же пакет — расходятся только версии, и только у той, что пришла с id-token,
// стоит признак.
&Тест
Процедура ПризнакДоверияСтавитПриёмКонвейеромАНеЧеловеком() Экспорт

	Стенд = ЗавестиСтенд("cimark");
	Провенанс = Желудь("СервисПроисхождения");

	Ожидаем.Что(Провенанс.ЭтоДоверенныйКонвейер(Версия(Стенд, "1.0.0")),
		"версия, выложенная человеком, доверенной публикацией не считается").ЭтоЛожь();

	Ответ = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Ответ.Код, "конвейер опубликовал: " + Ответ.ТелоТекст).Равно(201);
	Ожидаем.Что(Провенанс.ЭтоДоверенныйКонвейер(Версия(Стенд, "1.1.0")),
		"версия конвейера помечена").ЭтоИстина();

	// тот же пакет, следующая версия руками — признак не «прилипает» к пакету
	Руками = Публикация.Опубликовать(Стенд.Пул, Стенд.Мейнтейнер, Стенд.ИмяПакета, "1.2.0");
	Ожидаем.Что(Руками.Успех, "человек опубликовал: " + Руками.Сообщение).ЭтоИстина();
	Ожидаем.Что(Провенанс.ЭтоДоверенныйКонвейер(Версия(Стенд, "1.2.0")),
		"следующая ручная версия признака не наследует").ЭтоЛожь();

КонецПроцедуры

// Перезапись пререлиза руками СНИМАЕТ признак: иначе значок остался бы от прошлой
// публикации и врал про то, чем набитый заново артефакт на самом деле приехал.
&Тест
Процедура ПерезаписьРукамиСнимаетПризнакДоверия() Экспорт

	Стенд = ЗавестиСтенд("cirewrite");

	Ответ = ПушТокеном(Стенд, "2.0.0-rc.1", Токен("годный"));
	Ожидаем.Что(Ответ.Код, "конвейер опубликовал пререлиз: " + Ответ.ТелоТекст).Равно(201);
	Ожидаем.Что(Желудь("СервисПроисхождения").ЭтоДоверенныйКонвейер(Версия(Стенд, "2.0.0-rc.1")),
		"пререлиз конвейера помечен").ЭтоИстина();

	// опубликованный номер заменяют форсом — руками, а не конвейером
	Перезапись = Публикация.Опубликовать(Стенд.Пул, Стенд.Мейнтейнер, Стенд.ИмяПакета, "2.0.0-rc.1", Истина);
	Ожидаем.Что(Перезапись.Успех, "пререлиз перезаписан руками: " + Перезапись.Сообщение).ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПроисхождения").ЭтоДоверенныйКонвейер(Версия(Стенд, "2.0.0-rc.1")),
		"после ручной перезаписи признака нет").ЭтоЛожь();

КонецПроцедуры

// Отказ конвейера версии не создаёт, а раз версии нет — метить нечего: набор доверенных
// версий пакета пуст, и в списке версий значок не появляется ни у одной строки.
&Тест
Процедура ОтклонённыйКонвейерНеОставляетПомеченныхВерсий() Экспорт

	Стенд = ЗавестиСтенд("cireject");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужая_подпись"));
	Ожидаем.Что(Атака.Код, "чужая подпись → 403").Равно(403);
	Ожидаем.Что(Желудь("СервисПроисхождения").ДоверенныеВерсииПакета(
			Стенд.Пакет.Идентификатор).Количество(),
		"помеченных версий у пакета нет").Равно(0);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: годный токен публикует").Равно(201);
	Ожидаем.Что(Желудь("СервисПроисхождения").ДоверенныеВерсииПакета(
			Стенд.Пакет.Идентификатор).Количество(),
		"и помеченная версия ровно одна").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// СервисДоверияCI с подменённым проверяющим подписи; прочие зависимости — из контейнера.
Функция ДовериеСПроверяющим(Знач Проверяющий)
	Возврат Новый СервисДоверияCI(Желудь("ХранилищеДоверияCI"),
		Желудь("ХранилищеПользователей"), Желудь("ИмяОбъектаАудита"), Желудь("СобытиеАудита"),
		Желудь("СервисПакетов"),
		Желудь("СервисПрав"), Проверяющий, Желудь("ДопускПринципала"), Желудь("ИздательСобытий"),
		Желудь("АудиторияТокенаCI"), Желудь("СтражИздателейCI"), Желудь("КороткаяФормаДоверия"),
		Желудь("ИмяЗаписиДоверия"), Желудь("МаскаРефа"), Желудь("ВидРефаДоверия"),
		Желудь("СрокТокенаCI"), ЛогТестов());
КонецФункции

Функция Повторить(Знач Символ, Знач Сколько)
	Части = Новый Массив();
	Для Счёт = 1 По Сколько Цикл
		Части.Добавить(Символ);
	КонецЦикла;
	Возврат СтрСоединить(Части, "");
КонецФункции

// Заводит пул, мейнтейнера, пакет с версией 1.0.0 и запись доверия из фикстуры.
Функция ЗавестиСтенд(Знач Префикс)

	Стенд = Публикация.ЗаведённоеИмя(Префикс);

	Доверие_ = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		Фикстура["издатель"], Фикстура["репозиторий"], Фикстура["конвейер"], Фикстура["реф"]);
	Если НЕ Доверие_.Успех Тогда
		ВызватьИсключение "Доверие не настроено: " + Доверие_.Сообщение;
	КонецЕсли;

	Возврат Стенд;

КонецФункции

// Тот же стенд, но запись заводится КОРОТКИМИ значениями формы: имя файла и имя ветки.
// Достройку делает домен, и совпасть с клеймом обязана именно она.
Функция ЗавестиСтендКороткойФормой(Знач Префикс, Знач ИмяФайла, Знач Ветка)

	Стенд = Публикация.ЗаведённоеИмя(Префикс);

	// издатель НЕ передаётся: он выводится из типа репозитория
	Доверие_ = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		"", Фикстура["репозиторий"], ИмяФайла, Ветка);
	Если НЕ Доверие_.Успех Тогда
		ВызватьИсключение "Доверие не настроено: " + Доверие_.Сообщение;
	КонецЕсли;
	Если Строка(Доверие_.Доверие.Конвейер) <> Фикстура["репозиторий"] + "/.github/workflows/" + ИмяФайла Тогда
		ВызватьИсключение "Конвейер достроен не канонически: " + Доверие_.Доверие.Конвейер;
	КонецЕсли;

	Возврат Стенд;

КонецФункции

// Стенд с ЗАДАННЫМ рефом или маской: остальное — как у короткой формы.
Функция ЗавестиСтендСРефом(Знач Префикс, Знач ИмяФайла, Знач Реф, Знач ВидРефа)

	Стенд = Публикация.ЗаведённоеИмя(Префикс);

	Доверие_ = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		"", Фикстура["репозиторий"], ИмяФайла, Реф, ВидРефа);
	Если НЕ Доверие_.Успех Тогда
		ВызватьИсключение "Доверие не настроено: " + Доверие_.Сообщение;
	КонецЕсли;

	Стенд.Вставить("Реф", Строка(Доверие_.Доверие.Реф));
	Возврат Стенд;

КонецФункции

// Запись доверия МИМО сервиса: так проверяется, что сверка не полагается на его валидацию.
Процедура ЗаписатьДовериеМимоСервиса(Знач Пакет, Знач Реф)

	Хранилище = Желудь("ХранилищеДоверияCI");
	Для Каждого Прежняя Из Хранилище.ПолучитьПоПакетИдентификаторРавно(Цел(Пакет.Идентификатор)) Цикл
		Хранилище.Удалить(Прежняя);
	КонецЦикла;

	Запись = Хранилище.СоздатьЭлемент();
	Запись.ПакетИдентификатор = Цел(Пакет.Идентификатор);
	Запись.ПулИдентификатор = Цел(Пакет.ПулИдентификатор);
	Запись.Провайдер = "github";
	Запись.Издатель = Фикстура["издатель"];
	Запись.Репозиторий = Фикстура["репозиторий"];
	Запись.Конвейер = "";
	Запись.Реф = Реф;
	Запись.Создано = ТекущаяУниверсальнаяДата();
	Запись.КемСоздано = 0;
	Запись.Сохранить();

КонецПроцедуры

// Стенд GitLab: издателем записи служит gitlab.com, конвейер вводится путём конфига.
// Второе доверие тому же пакету: другой провайдер — значит и другой издатель записи.
Процедура ДобавитьДовериеGitLab(Знач Стенд, Знач ПутьКонфига, Знач Ветка)

	Доверие_ = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "gitlab",
		"", Фикстура["репозиторий"], ПутьКонфига, Ветка);
	Если НЕ Доверие_.Успех Тогда
		ВызватьИсключение "Второе доверие не настроено: " + Доверие_.Сообщение;
	КонецЕсли;

КонецПроцедуры

Функция ЗавестиСтендGitLab(Знач Префикс, Знач ПутьКонфига, Знач Ветка)

	Стенд = Публикация.ЗаведённоеИмя(Префикс);

	Доверие_ = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "gitlab",
		"", Фикстура["репозиторий"], ПутьКонфига, Ветка);
	Если НЕ Доверие_.Успех Тогда
		ВызватьИсключение "Доверие не настроено: " + Доверие_.Сообщение;
	КонецЕсли;
	Ожидаемый = "gitlab.com/" + Фикстура["репозиторий"] + "//" + ПутьКонфига;
	Если Строка(Доверие_.Доверие.Конвейер) <> Ожидаемый Тогда
		ВызватьИсключение "Конфиг GitLab достроен не канонически: " + Доверие_.Доверие.Конвейер;
	КонецЕсли;

	Возврат Стенд;

КонецФункции

// Вызывает точку маршрута push так, как её вызвал бы winow: заголовки, сырое тело, токен.
Функция ПушТокеном(Знач Стенд, Знач Версия, Знач Токен_)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", Стенд.ИмяПакета, Версия));
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("OAUTH-TOKEN", Токен_);

	Ответ = Новый ОтветПушаЗаглушка();
	Контроллер.ПушВПул(Ответ, Стенд.Пул.Имя, "POST", Заголовки,
		Публикация.ДанныеOspx(Стенд.ИмяПакета, Версия));
	Возврат Ответ;

КонецФункции

Функция Версия(Знач Стенд, Знач СтрокаВерсии)
	Возврат Желудь("СервисВерсий").НайтиВерсию(Стенд.Пакет.Идентификатор, СтрокаВерсии);
КонецФункции

Функция ВерсияЕсть(Знач Стенд, Знач Версия)
	Возврат Желудь("СервисВерсий").НайтиВерсию(Стенд.Пакет.Идентификатор, Версия) <> Неопределено;
КонецФункции

// Клеймы срока: exp обязателен, nbf едет только заполненным.
Функция КлеймыСрока(Знач Истекает, Знач Начало)

	Результат = Новый Соответствие();
	Результат.Вставить("exp", Истекает);
	Если Начало > 0 Тогда
		Результат.Вставить("nbf", Начало);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Токен(Знач Имя)
	Возврат Фикстура["токены"][Имя];
КонецФункции

Функция СтрокаЗаголовков(Знач Заголовки)
	Части = Новый Массив();
	Для Каждого КиЗ Из Заголовки Цикл
		Части.Добавить(Строка(КиЗ.Ключ) + "=" + Строка(КиЗ.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");
КонецФункции

Функция ОшибкаЗапроса(Знач Транспорт, Знач URL)
	Попытка
		Транспорт.Получить(URL);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Процедура ЗадатьАудиторию(Знач Значение)
	Желудь("СервисНастроек").Установить("oshub.publish.ci.audience", Значение, "тест");
КонецПроцедуры

Процедура НаполнитьТранспорт()
	Транспорт = Желудь("ТранспортHTTP");
	Транспорт.ПриАдресе(Фикстура["адрес_дискавери"], 200, Фикстура["дискавери"]);
	Транспорт.ПриАдресе(Фикстура["адрес_ключей"], 200, Фикстура["жвк"]);
	// GitLab отдаёт ТОТ ЖЕ ключ: тест «другой разрешённый издатель» должен отличаться от
	// контроля ровно издателем, а не тем, что подпись негде проверить
	ОтдаватьКлючи(Транспорт, "https://gitlab.com");
	// издатель вне списка тоже готов отдать годный JWKS: тест списка обязан отличаться от
	// контроля списком, а не тем, что ключи негде взять
	ОтдаватьКлючи(Транспорт, "https://evil.example.test");
КонецПроцедуры

Процедура ОтдаватьКлючи(Знач Транспорт, Знач Издатель)
	Транспорт.ПриАдресе(АдресДискавери(Издатель), 200, СтрШаблон(
		"{""issuer"":""%1"",""jwks_uri"":""%1/.well-known/jwks""}", Издатель));
	Транспорт.ПриАдресе(Издатель + "/.well-known/jwks", 200, Фикстура["жвк"]);
КонецПроцедуры

Функция АдресДискавери(Знач Издатель)
	Возврат Издатель + "/.well-known/openid-configuration";
КонецФункции

Функция ПрочитатьФикстуру(Знач Путь)
	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Доверие()
	Возврат Желудь("СервисДоверияCI");
КонецФункции

Функция СессияПринципал(Знач Пользователь)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, "session", "", 0, Неопределено);
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.конвейеры");
КонецФункции

#КонецОбласти
