# зависимости opm (ставятся `opm install -l`)
oscript_modules/

# данные локального запуска хаба
/data/

# демо-стенд (tools/demo.sh): данные, собранные пакеты и памятка — пересоздаётся скриптом
/demo/

# артефакты сборки
/*.ospx

# рабочая кухня разработки: черновики ишузов в чужие репозитории, спайки-исследования
# и разборы. Живут на машине разработчика, в поставку хаба не входят
/issues/
/spikes/
/АНАЛИЗ-*.md

# внутренние документы разработки: каталог требований и процесс.
# В docs/ публикуются только пользовательские статьи
/docs/требования/
/docs/процесс/

# исходники фирменного стиля (svg, превью, аватар): работа дизайнера, а не поставка.
# То, что хаб реально отдаёт браузеру, лежит в src/статика/бренд
/бренд/

# системное
.DS_Store

# журналы локальных прогонов тестов (oneunit execute > прогон*.log)
прогон*.log
