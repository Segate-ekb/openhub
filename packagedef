// Описание пакета OpenHub — открытого хаба пакетов OneScript.
//
// Объявляем только то, что OpenHub использует САМ (`#Использовать` в src и tests):
// чем питаются наши зависимости — дело их собственных packagedef. Два исключения
// названы ниже поимённо: без них хаб не поднимается, и лечатся они в апстриме,
// а не здесь. Пины «за соседа», которые уже не нужны, сняты — проверено чистой
// установкой: `configor` и `fs` разрешаются в те же версии сами.

Описание.Имя("openhub")
	.Версия("0.4.0")
	.Автор("e.ivanov")
	.Описание("Открытый хаб пакетов OneScript")
	.ВерсияСреды("2.0")

	// Что использует сам хаб.
	.ЗависитОт("semver", "1.1.1")
	.ЗависитОт("entity", "3.4.3.1")
	.ЗависитОт("autumn", "4.3.13")
	.ЗависитОт("autumn-logos", "1.3.3")
	.ЗависитОт("autumn-data", "1.0.0")
	.ЗависитОт("winow", "0.11.3")
	.ЗависитОт("1connector", "2.3.3")
	.ЗависитОт("oint", "2.3.0")
	.ЗависитОт("fzy", "1.0.3")
	.ЗависитОт("opentelemetry", "1.0.1")
	// Отправка почты: стандартные объекты ИнтернетПочта поверх MailKit. Своего SMTP-клиента
	// не пишем — библиотека опубликована в хабе и собрана под OneScript 2.x.
	.ЗависитОт("InternetMail", "1.0.10")

	// Библиотеки-сателлиты проекта — с hub.oscript.io, как и всё остальное.
	.ЗависитОт("ospx-tools", "0.2.0")
	.ЗависитОт("pwhash", "0.3.0")
	.ЗависитОт("os-scheduler", "0.1.0")
	.ЗависитОт("oidc-client", "0.6.0")
	.ЗависитОт("jwt-verify", "0.2.0")
	.ЗависитОт("oscript-md", "0.2.1")
	.ЗависитОт("oscript-ui", "0.1.0")

	// ЧУЖАЯ ЗАВИСИМОСТЬ, И ЭТО ОСОЗНАННО. Сами lambdas мы не используем; её тянут
	// atomic, opentelemetry и resilience, объявляя 0.3.3. На 0.3.3 вычисление лямбды
	// из строки падает «Value is not of object type», ОСень не собирает условные желуди,
	// и смоук краснеет на УстановкаПоИмениLatestЧерезКаноническийПуть и OpmPushЗатемInstall
	// (проверено снятием этой строки). Чинится в апстриме: поднять требование до 0.3.4
	// у тех, кто её объявляет. До тех пор — здесь.
	.ЗависитОт("lambdas", "0.3.4")
	// Вторая такая же. json тянут fluent и entity, объявляя 1.1.1; на ней
	// ПроцессорКоллекций падает «Iterator is not defined», и хаб не поднимается вовсе
	// на КоннектореJSON — то есть на дефолтной базе (проверено снятием этой строки).
	.ЗависитОт("json", "1.1.2")

	// Что нужно только наборам: в поставку хаба не входит.
	.РазработкаЗависитОт("asserts", "1.6.2")
	.РазработкаЗависитОт("tempfiles", "1.1.1")
	.РазработкаЗависитОт("html-sanitizer", "0.2.0")

	.ВключитьФайл("src")
	.ВключитьФайл("README.md")
	.ВключитьФайл("autumn-properties.json")
	.ВключитьФайл("oscript_modules")

	// Команда `openhub` в PATH после `opm install openhub`.
	.ИсполняемыйФайл("src/main.os")
