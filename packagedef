// Описание пакета OpenHub — открытого хаба пакетов OneScript.
//
// Порядок объявлений значим. opm ставит объявленную версию как есть и уже установленный
// пакет не трогает, поэтому пины идут ПЕРВЫМИ: транзитивные объявления тех же пакетов
// (без версии или с более низкой) их не перебьют.

Описание.Имя("openhub")
	.Версия("0.4.0")
	.Автор("e.ivanov")
	.Описание("Открытый хаб пакетов OneScript")
	.ВерсияСреды("2.0")

	// Пины детерминизма — до всего, что тянет их транзитивно.
	.ЗависитОт("semver", "1.1.1")
	.ЗависитОт("tempfiles", "1.1.1")
	// winow объявляет fs без версии, а построителю точки входа OneUnit нужен
	// ФС.НормализоватьПуть — он появился в 1.2.0.
	.ЗависитОт("fs", "1.2.0")
	// КоннекторJSON из entity требует json >= 1.1.2: на 1.1.1 падает «Iterator is not defined»,
	// а entity объявляет ровно 1.1.1.
	.ЗависитОт("json", "1.1.2")
	// Потолок, а не минимум: в configor 0.12.0 у МенеджерПараметров нет
	// НастройкаПоискаФайла(), которую зовёт autumn 4.3.x, и контейнер ОСени не собирается.
	.ЗависитОт("configor", "0.11.1")
	// Библиотека утверждений тестов. Объявлена рантайм-зависимостью, потому что ею её
	// объявляет autumn (4.3.13 фиксирует 1.4.0) — без пина в наборы приезжает та версия.
	.ЗависитОт("asserts", "1.6.2")
	// На 0.3.3 (её объявляют atomic, opentelemetry, resilience) вычисление лямбды из
	// строки падает «Value is not of object type», и OneUnit не может разобрать
	// &ВключенЕсли — набор краснеет ещё до первого утверждения.
	.ЗависитОт("lambdas", "0.3.4")

	.ЗависитОт("autumn", "4.3.13")
	.ЗависитОт("autumn-logos", "1.3.3")
	.ЗависитОт("autumn-data", "1.0.0")
	.ЗависитОт("winow", "0.11.3")
	.ЗависитОт("1connector", "2.3.3")
	.ЗависитОт("oint", "2.3.0")
	.ЗависитОт("fzy", "1.0.3")
	.ЗависитОт("opentelemetry", "1.0.1")
	// Отправка почты: стандартные объекты ИнтернетПочта поверх MailKit. Своего SMTP-клиента
	// не пишем — библиотека опубликована в хабе и собрана под OneScript 2.x.
	.ЗависитОт("InternetMail", "1.0.10")

	// Библиотеки-сателлиты проекта — с hub.oscript.io, как и всё остальное.
	.ЗависитОт("ospx-tools", "0.2.0")
	.ЗависитОт("pwhash", "0.3.0")
	.ЗависитОт("html-sanitizer", "0.2.0")
	.ЗависитОт("os-scheduler", "0.1.0")
	.ЗависитОт("oidc-client", "0.6.0")
	.ЗависитОт("jwt-verify", "0.2.0")
	.ЗависитОт("oscript-md", "0.2.1")
	.ЗависитОт("oscript-ui", "0.1.0")

	.ВключитьФайл("src")
	.ВключитьФайл("README.md")
	.ВключитьФайл("autumn-properties.json")
	.ВключитьФайл("oscript_modules")

	// Команда `openhub` в PATH после `opm install openhub`.
	.ИсполняемыйФайл("src/main.os")
