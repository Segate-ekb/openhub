{
    "winow": {
        "Порт": 3333
    },
    "logos": {
        "logger": {
            "rootLogger": "INFO"
        }
    },
    "data": {
        "ИсточникиДанных": {
            "ТипКоннектора": "КоннекторJSON",
            "СтрокаСоединения": "./data/entities"
        }
    },
    "oshub": {
        "storage": {
            "root": "./data"
        },
        "pools": {
            "default": "public"
        },
        "otel": {
            "enabled": false,
            "endpoint": "http://localhost:4318",
            "protocol": "http/json",
            "service_name": "openhub",
            "sampling_ratio": 1.0,
            "export_interval_sec": 5,
            "max_queue": 2048,
            "timeout_sec": 10,
            "insecure_skip_verify": false
        },
        "jobs": {
            "enabled": true,
            "tick_interval_ms": 1000,
            "stats_flush_interval_sec": 60,
            "proxy_gc_interval_sec": 3600,
            "readme_reindex_hour": 3,
            "mirror_sync_interval_sec": 3600,
            "cli_device_gc_interval_sec": 300
        },
        "webhooks": {
            "resolve_enabled": true,
            "resolve_timeout_sec": 3
        },
        "publish": {
            "github": {
                "api": "api.github.com"
            }
        }
    }
}
