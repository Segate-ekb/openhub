{
    "winow": {
        "Порт": 3333
    },
    "otel": {
        "enabled": false,
        "service": {
            "name": "openhub"
        }
    },
    "logos": {
        "logger": {
            "rootLogger": "INFO"
        }
    },
    "data": {
        "ИсточникиДанных": {
            "ТипКоннектора": "КоннекторJSON",
            "СтрокаСоединения": "./data/entities"
        }
    },
    "oshub": {
        "storage": {
            "root": "./data"
        },
        "pools": {
            "default": "public"
        },
        "jobs": {
            "enabled": true,
            "tick_interval_ms": 1000,
            "readme_reindex_hour": 3,
            "stats_flush_interval_sec": 60,
            "proxy_gc_interval_sec": 3600,
            "mirror_sync_interval_sec": 3600,
            "cli_device_gc_interval_sec": 300
        },
        "webhooks": {
            "resolve_enabled": true,
            "resolve_timeout_sec": 3
        },
        "publish": {
            "github": {
                "api": "api.github.com"
            }
        }
    }
}
